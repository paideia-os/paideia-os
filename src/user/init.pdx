// src/user/init.pdx — R17-m2-004 (#619) — init parent wait loop + shutdown
//   + R17-M0-730 D10 (#730): exec /bin/child_hello + WAIT: on reap.
//   + R17-M2-736 D12 (#736): runtime u32→decimal via print_u64_dec so the
//     WAIT: line's digits are the *real* reaped pid + wait_status[0] read
//     from memory, not a rodata literal. Design:
//     design/kernel/r17-m2-736-d12-runtime-u32-decimal.md
// Extends R17-m2-003 (#618) with wait loop: parent calls sys_wait4, logs
// "WAIT: pid=<N> status=<M>\n" via three fragments interleaved with two
// print_u64_dec calls, then "REAPED\n", then enters init_shutdown.

module Init = structure {
  pub let dev_tty0_path : [u8; 10] = "/dev/tty0\0"
  // D10a: was "/bin/sh\0" (never seeded); replaced with /bin/child_hello
  // (seeded by kernel_main's bin_child_hello_seed block). Path is exactly
  // 16 chars + NUL = 17 bytes, well under sys_execve_shim's PATH_MAX (256).
  pub let bin_child_hello_path : [u8; 17] = "/bin/child_hello\0"
  // R17-M5-749 (paideia-os #749): /bin/sh execve path — reachable now that
  // #636 partial (befaa1b) seeded shell.elf into tmpfs at /bin/sh. Init's
  // second fork+exec cycle targets this path AFTER the child_hello cycle
  // has emitted the #723 AC lines. See design/kernel/r17-m5-749-init-shell-path.md.
  pub let bin_sh_path : [u8; 8] = "/bin/sh\0"
  pub let init_msg : [u8; 9] = "INIT OK\n\0"
  pub let init_len : u64 = 8
  pub let reaped_msg : [u8; 8] = "REAPED\n\0"
  pub let reaped_len : u64 = 7
  // R17-M5-749 (paideia-os #749): witness marker emitted by init just
  // before the sys_fork for /bin/sh. Its presence between the first
  // "REAPED" and any "SHELL START" proves control reached the second
  // fork+exec cycle. sys_debug_puts is length-bounded (16 bytes below
  // exclude the trailing NUL from wire).
  pub let init_fork_sh_msg : [u8; 17] = "INIT FORK SH OK\n\0"
  pub let init_fork_sh_len : u64 = 16
  // R17-M5-749: fail marker emitted by the CHILD path only if
  // sys_execve("/bin/sh", ...) returns (which normally never happens —
  // execve either doesn't return or returns a negative error). If it
  // fires, either the tmpfs seed is missing or shell.elf is malformed.
  pub let init_fork_sh_fail_msg : [u8; 19] = "INIT FORK SH FAIL\n\0"
  pub let init_fork_sh_fail_len : u64 = 18
  // R48-PREP-005.M2 (design/services/svc-elevate-broker-registration.md
  // §4.M2): third fork+exec cycle — /bin/elevate_broker_daemon execve path.
  // Seeded into tmpfs by the kernel's bin_elevate_broker_daemon_seed block
  // (src/kernel/boot/witness/bin_seeds.pdx), mirroring how /bin/sh and
  // /bin/child_hello are seeded. Path is 26 chars + NUL = 27 bytes.
  pub let bin_elevate_broker_daemon_path : [u8; 27] = "/bin/elevate_broker_daemon\0"
  // Witness marker emitted by init just before the sys_fork for the
  // elevate broker daemon. Its presence proves control reached the third
  // fork+exec cycle. The daemon is a long-lived server: unlike the
  // child_hello and /bin/sh cycles, init does NOT wait4 on it — it forks,
  // execs, and falls straight through into the pre-existing /bin/sh
  // wait4 below (see init_fork_elevate_after).
  pub let init_fork_elevate_msg : [u8; 22] = "INIT FORK ELEVATE OK\n\0"
  pub let init_fork_elevate_len : u64 = 21
  // Fail marker emitted by the CHILD path only if
  // sys_execve("/bin/elevate_broker_daemon", ...) returns (normally never
  // happens). If it fires, either the tmpfs seed is missing or the ELF is
  // malformed.
  pub let init_fork_elevate_fail_msg : [u8; 24] = "INIT FORK ELEVATE FAIL\n\0"
  pub let init_fork_elevate_fail_len : u64 = 23
  // D12 (#736): wait_msg split into three rodata fragments so runtime
  // decimal values (child pid + exit status) can be interleaved. NUL is
  // stored for strlen-safety symmetry with init_msg/reaped_msg but never
  // sent on the wire — sys_debug_puts is length-bounded.
  //   wait_prefix  : "WAIT: pid="  10 chars + NUL = 11 bytes  (emit 10)
  //   wait_sep     : " status="     8 chars + NUL =  9 bytes  (emit  8)
  //   wait_newline : "\n"           1 char  + NUL =  2 bytes  (emit  1)
  // Emission sequence (D12 §2.5):
  //   [wait_prefix, 10] print_u64_dec(rax) [wait_sep, 8]
  //     print_u64_dec(wait_status[0]) [wait_newline, 1]
  pub let wait_prefix  : [u8; 11] = "WAIT: pid=\0"
  pub let wait_sep     : [u8; 9]  = " status=\0"
  pub let wait_newline : [u8; 2]  = "\n\0"
  // #723 blocker #2 (revert of #678): proof-of-ring-3 marker. Emitted as the
  // very first thing init does in _start, via sys_debug_puts which requires
  // no fs/tty/vfs state — just the SYSCALL entry path. Its presence on the
  // serial log confirms init actually reached ring-3 (as distinct from just
  // being loaded structurally, which "R17 INIT LOAD OK" proved before).
  pub let entered_msg : [u8; 20] = "INIT ENTERED RING3\n\0"
  pub let entered_len : u64 = 19
  pub let mut wait_status : [u64; 1] = uninit @align(8)

  // print_u64_dec(value: u64) -> () — R17-M2-736 D12 (#736)
  // Formats value as unsigned decimal ASCII on a 24-byte stack scratch and
  // emits it via sys_debug_puts. Zero prints as "0". Max width 20 bytes
  // (u64::MAX = "18446744073709551615"). See design doc §2.3 for the
  // divide-by-10 loop invariants and the on-paper test-vector table.
  //
  // SysV register discipline:
  //   Reads    : rdi (value)
  //   Preserves: rbx, rbp, r12–r15 (callee-save)
  //   Clobbers : rax, rcx, rdx, rsi, rdi, r8, r9, r10, r11
  //   Stack    : 24 bytes (20 needed + 4 for 16-byte-align of subsequent call)
  //
  // The kernel's u64_to_dec (src/kernel/core/klog/hex.pdx:77) uses the same
  // `div rcx` divmod loop; the paideia-as codegen for that instruction pair
  // is exercised at boot and known-good. This user-space version skips the
  // staging→caller copy step because it emits directly from the staging buf.
  pub let print_u64_dec : (u64) -> () !{mem, sysreg} @{} =
    fn (value: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "R17-M2-736 D12 (#736): runtime u32→decimal for init's WAIT: line so the printed digits reflect the wire values of sys_wait4's return rax (child pid) and wait_status[0] (exit status) rather than a rodata literal. Algorithm: divide-by-10 loop stashes digits right-to-left in a 24-byte stack buffer, then a single sys_debug_puts emits the [first_digit, length] slice. Zero handled as a special case (writes single '0'). u64-wide (matches kernel u64_to_dec at hex.pdx:77) even though callers only pass u32-range values at R17.M0. Effect union: {mem} for stack writes + sys_debug_puts read; {sysreg} for the syscall. No caps (sys_debug_puts declares @{}). Callee-save regs (r12–r15) untouched so callers can hold state across the call.",
      block: {
        // 24-byte stack scratch (20 digits max + 4-byte 16-byte-align slop).
        sub rsp, 24;

        // Zero special case
        cmp rdi, 0;
        jne pud_divide_setup;
          // value == 0 → single '0' digit, emit and return
          mov al, 0x30;                   // ASCII '0'
          mov [rsp], al;
          mov rdi, rsp;                   // buf = &staging[0]
          mov rsi, 1;                     // len = 1
          call sys_debug_puts;
          add rsp, 24;
          ret;

        pud_divide_setup:
          mov r9, rdi;                    // r9  = remaining value
          mov r10, rsp;
          add r10, 19;                    // r10 = cursor at last staging byte

        pud_loop_top:
          mov rax, r9;
          mov rcx, 10;
          xor rdx, rdx;                   // zero-extend rdx:rax for div
          div rcx;                        // rax = quotient, rdx = remainder
          add rdx, 0x30;                  // digit → ASCII '0'..'9'
          mov [r10], dl;                  // store at cursor
          mov r9, rax;                    // r9 = quotient
          cmp r9, 0;
          je pud_loop_done;
          sub r10, 1;                     // advance cursor left
          jmp pud_loop_top;

        pud_loop_done:
          // r10 points at first (MSB) digit. Length = (rsp + 20) - r10.
          mov rax, rsp;
          add rax, 20;
          sub rax, r10;                   // rax = digit count
          mov rsi, rax;                   // sys_debug_puts arg 2 (count)
          mov rdi, r10;                   // sys_debug_puts arg 1 (buf)
          call sys_debug_puts;

          add rsp, 24;
          ret
      }
    } @no_frame

  // _start — user program entry point. Never returns (infinite hlt loop).
  pub let _start : () -> () !{sysreg} @{fs} =
    fn () -> unsafe {
      effects: {sysreg}, capabilities: {fs},
      justification: "R17-m2-002 (#617) + #723 revert of #678 + R17-m5-749 (paideia-os #749): init _start with TTY fd initialization + two-cycle fork+exec. First emits 'INIT ENTERED RING3\\n' via sys_debug_puts as a ring-3 proof-of-life marker (independent of fs/tty/vfs state — only depends on the SYSCALL entry path); this replaces the kernel-side 'SHELL BOOT OK' fingerprint marker from the #678 shortcut with an honest 'init actually ran in ring-3' marker. Then opens /dev/tty0, dups to 0/1/2, prints 'INIT OK\\n' via sys_debug_puts (8 bytes), forks + execve /bin/child_hello (pid=2), wait4 (emits WAIT: pid=2 status=42, REAPED — the #723 AC on wire), then falls through into the R17-M5-749 second cycle: emits 'INIT FORK SH OK\\n' witness marker, forks + execve /bin/sh (pid=3), wait4 (may block indefinitely if shell never exits — expected under boot_r17_init which injects no stdin), then sys_exit. Design: design/kernel/r17-m5-749-init-shell-path.md.",
      block: {
        // #723 blocker #2 — first ring-3 syscall: emit proof-of-life marker.
        // sys_debug_puts needs no fs/tty state — only the SYSCALL entry path.
        lea rdi, [rip + entered_msg];
        mov rsi, 19;
        call sys_debug_puts;

        // Open /dev/tty0
        lea rdi, [rip + dev_tty0_path];
        xor rsi, rsi;                   // flags = 0 (O_RDONLY)
        xor rdx, rdx;                   // mode = 0
        call sys_open;
        // rax = fd (should be 3 since 0/1/2 not yet used)
        mov r12, rax;                   // save fd in r12

        // dup2(fd, 0)
        mov rdi, r12;
        xor rsi, rsi;                   // newfd = 0
        call sys_dup2;

        // dup2(fd, 1)
        mov rdi, r12;
        mov rsi, 1;                     // newfd = 1
        call sys_dup2;

        // dup2(fd, 2)
        mov rdi, r12;
        mov rsi, 2;                     // newfd = 2
        call sys_dup2;

        // close original fd
        mov rdi, r12;
        call sys_close;

        // R57.M4-006 (paideia-os #1802): init-time rootfs seed loop.
        // Runs AFTER tty0 setup so fd 0/1/2 are already claimed by
        // tty0 and per-file sys_open in rootfs_seed_run returns fd
        // >= 3 (avoiding dispatch_write's fd in {1,2} -> UART
        // fast-path that would route seed payload bytes onto the
        // serial line). Runs BEFORE the first fork so /bin/child_hello
        // and /bin/sh are guaranteed present when init execs them.
        // Emits "rootfs seed ok [legacy: ROOTFS SEED OK] files=<N>\n"
        // on the wire via sys_debug_puts. See
        // design/user/rootfs-seed-inventory.md.
        call rootfs_seed_run;

        // Fork: sys_fork() -> rax = 0 (child), child_pid (parent), or negative error
        call sys_fork;
        mov r12, rax;                   // save return value (0 or child_pid)
        cmp rax, 0;                     // check if child (rax == 0)
        je init_child;                  // branch to child path if zero

        // Parent path: print "INIT OK\n" and enter wait loop
        lea rdi, [rip + init_msg];
        mov rsi, 8;
        call sys_debug_puts;

        // Parent wait loop
        jmp init_parent;

        // Child path: execve /bin/child_hello (should NOT return on success —
        // D10b's return-frame rewrite in sys_execve_shim makes sysret land
        // in child_hello._start's entry_rip). Fall-through to init_error
        // reached only on execve failure (-ENOENT if /bin/child_hello
        // missing, -ENOEXEC if malformed ELF, -ENOMEM if user_stack_alloc
        // OOM'd in the shim).
        init_child:
          lea rdi, [rip + bin_child_hello_path]; // "/bin/child_hello\0"
          xor rsi, rsi;                 // argv = NULL (ignored at R17.M0)
          xor rdx, rdx;                 // envp = NULL (ignored at R17.M0)
          call sys_execve;
          // Reached only on execve failure. Fall through to init_error.
          jmp init_error;

        // Error handler (reached only if execve returns)
        // #724 D1 fix: must jump to init_shutdown; without it the CHILD
        // fell through into the PARENT's wait4 loop, creating a spurious
        // wait4-in-child that never resolves (parent's PID is not child's
        // child) and hides the failed execve.
        init_error:
          lea rdi, [rip + init_msg];    // print error marker (same msg for now)
          mov rsi, 8;
          call sys_debug_puts;
          jmp init_shutdown;

        init_parent:
          // sys_wait4(pid=-1, wstatus, options=0, rusage=NULL)
          // -1 means wait for any child
          xor rdi, rdi;
          dec rdi;                        // rdi = -1 (0xFFFFFFFFFFFFFFFF)
          lea rsi, [rip + wait_status];   // wstatus ptr
          xor rdx, rdx;                   // options = 0
          xor rcx, rcx;                   // rusage = NULL
          call sys_wait4;
          // rax = child pid or error
          cmp rax, 0;
          jl init_shutdown;               // error → shutdown

          // D12 (#736): runtime-formatted WAIT: line. r13 (callee-save) holds
          // the child pid across the intervening sys_debug_puts + print_u64_dec
          // calls; wait_status[0] is re-loaded from memory rather than saved.
          mov r13, rax;                   // save child pid

          // Emit "WAIT: pid="
          lea rdi, [rip + wait_prefix];
          mov rsi, 10;
          call sys_debug_puts;

          // Emit child pid as decimal
          mov rdi, r13;
          call print_u64_dec;

          // Emit " status="
          lea rdi, [rip + wait_sep];
          mov rsi, 8;
          call sys_debug_puts;

          // Emit wait_status[0] as decimal
          lea rdi, [rip + wait_status];
          mov rdi, [rdi];                 // rdi = wait_status[0]
          call print_u64_dec;

          // Emit newline
          lea rdi, [rip + wait_newline];
          mov rsi, 1;
          call sys_debug_puts;

          // Log "REAPED\n" (legacy marker; retained for continuity with
          // pre-D10 boot logs and #724 D9's own witness fingerprint).
          //
          // R17-M5-749 (paideia-os #749): #723 AC ends here. Everything up
          // to and including this REAPED emission is byte-identical to
          // pre-landing. Fall through into init_fork_sh (below) to start
          // the /bin/sh fork+exec+wait cycle. init_shutdown is now reached
          // only via the fork_sh path or via wait4 error branches.
          lea rdi, [rip + reaped_msg];
          mov rsi, 7;
          call sys_debug_puts;

          // Fall through to init_fork_sh (R17-M5-749 second cycle).

        // R17-M5-749 (paideia-os #749): second fork+exec+wait cycle for
        // /bin/sh. Reachable only after the child_hello cycle above
        // completes and emits the #723 AC lines. See
        // design/kernel/r17-m5-749-init-shell-path.md §4.3.
        init_fork_sh:
          // Emit "INIT FORK SH OK\n" — proves control reached the second
          // cycle, distinguishes this landing's wire signature from the
          // #723-only trace.
          lea rdi, [rip + init_fork_sh_msg];
          mov rsi, 16;                    // len excludes trailing NUL
          call sys_debug_puts;

          // Fork for /bin/sh
          call sys_fork;
          cmp rax, 0;                     // check if child (rax == 0)
          je init_fork_sh_child;
          // Parent path: fall through to init_fork_sh_parent

          jmp init_fork_sh_parent;

        // Child path: execve /bin/sh. Should not return on success —
        // sys_execve_shim rewrites the return frame so sysret lands in
        // shell's _start (which then emits its own "SHELL START\n"
        // witness marker per src/user/shell.pdx). If execve returns,
        // shell.elf is either not seeded (befaa1b failed) or malformed;
        // emit fail marker + sys_exit(1) so parent's wait4 reaps and
        // boot_r17_init exits cleanly instead of hanging past timeout.
        init_fork_sh_child:
          lea rdi, [rip + bin_sh_path];   // "/bin/sh\0"
          xor rsi, rsi;                   // argv = NULL (ignored at R17.M0)
          xor rdx, rdx;                   // envp = NULL (ignored at R17.M0)
          call sys_execve;
          // Reached only on execve failure.
          lea rdi, [rip + init_fork_sh_fail_msg];
          mov rsi, 18;
          call sys_debug_puts;
          mov rdi, 1;                     // exit status = 1 (nonzero → failure)
          call sys_exit;
          // Unreachable; belt-and-suspenders hlt for the impossible fallthrough.
          hlt;

        // Parent path: fork+exec the elevate broker daemon (R48-PREP-005.M2
        // third cycle), THEN wait for /bin/sh child.
        //
        // Placement rationale: this cycle is placed here — right after the
        // /bin/sh fork, before the /bin/sh wait4 below — rather than after
        // the /bin/sh wait4 cycle completes. In boot_r17_init (and
        // boot_r16_uart_rx as of R17.M4+) no stdin is injected, so shell
        // blocks on sys_read forever and the /bin/sh wait4 below never
        // returns; any code placed strictly after that wait4 would never
        // run under this harness. Placing the daemon's fork+exec here
        // guarantees control reaches it regardless of whether /bin/sh
        // ever exits. The scheduler keeps running already-spawned tasks
        // while init blocks in the /bin/sh wait4, so the daemon still
        // gets CPU time once this cycle hands control to
        // elevate_broker_daemon's own _start via sys_execve.
        //
        // Design: design/services/svc-elevate-broker-registration.md §4.M2.
        init_fork_sh_parent:
          // Emit "INIT FORK ELEVATE OK\n" — proves control reached the
          // third fork+exec cycle.
          lea rdi, [rip + init_fork_elevate_msg];
          mov rsi, 21;                    // len excludes trailing NUL
          call sys_debug_puts;

          // Fork for /bin/elevate_broker_daemon
          call sys_fork;
          cmp rax, 0;                     // check if child (rax == 0)
          je init_fork_elevate_child;
          jmp init_fork_elevate_after;    // parent: no wait4 (long-lived server)

        // Child path: execve /bin/elevate_broker_daemon. Should not
        // return on success. If it does return, the tmpfs seed is
        // missing or the ELF is malformed; emit fail marker + sys_exit(1)
        // so this orphaned child does not fall through into unrelated
        // init logic.
        init_fork_elevate_child:
          lea rdi, [rip + bin_elevate_broker_daemon_path]; // "/bin/elevate_broker_daemon\0"
          xor rsi, rsi;                   // argv = NULL (ignored at R17.M0)
          xor rdx, rdx;                   // envp = NULL (ignored at R17.M0)
          call sys_execve;
          // Reached only on execve failure.
          lea rdi, [rip + init_fork_elevate_fail_msg];
          mov rsi, 23;
          call sys_debug_puts;
          mov rdi, 1;                     // exit status = 1 (nonzero → failure)
          call sys_exit;
          // Unreachable; belt-and-suspenders hlt for the impossible fallthrough.
          hlt;

        // Parent path (no wait4 on the daemon — it is long-lived): fall
        // through into the pre-existing /bin/sh wait4 cycle unchanged.
        //
        // In boot_r17_init (and boot_r16_uart_rx as of R17.M4+), no stdin
        // is injected. Shell blocks on sys_read; parent blocks here in
        // sys_wait4. QEMU times out at 8s. The two witness markers
        // ("INIT FORK SH OK\n" from init above + "SHELL START\n" from
        // shell._start) land on the wire before shell blocks, so the
        // fingerprint check passes on the timeout exit (rc=124 accepted
        // by tools/run-smoke.sh).
        //
        // In future boot_r17_shell_echo_hello (paideia-os prereq #7 of
        // #636), shell will exit and this wait4 will return, emitting
        // "WAIT: pid=3 status=<M>\nREAPED\n" onto the wire. Same code
        // path — only stdin injection differs.
        init_fork_elevate_after:
          xor rdi, rdi;
          dec rdi;                        // rdi = -1 (any child)
          lea rsi, [rip + wait_status];   // wstatus ptr (reused from cycle 1)
          xor rdx, rdx;                   // options = 0
          xor rcx, rcx;                   // rusage = NULL
          call sys_wait4;
          cmp rax, 0;
          jl init_shutdown;               // wait4 error → shutdown

          // Save shell pid in r13 (callee-save; survives print_u64_dec).
          mov r13, rax;

          // Emit "WAIT: pid="
          lea rdi, [rip + wait_prefix];
          mov rsi, 10;
          call sys_debug_puts;

          // Emit shell pid as decimal
          mov rdi, r13;
          call print_u64_dec;

          // Emit " status="
          lea rdi, [rip + wait_sep];
          mov rsi, 8;
          call sys_debug_puts;

          // Emit wait_status[0] as decimal (re-loaded — kernel wrote it
          // for the shell reap, replacing the child_hello status value).
          lea rdi, [rip + wait_status];
          mov rdi, [rdi];                 // rdi = wait_status[0]
          call print_u64_dec;

          // Emit newline
          lea rdi, [rip + wait_newline];
          mov rsi, 1;
          call sys_debug_puts;

          // Emit "REAPED\n" (second cycle — matches first cycle's shape)
          lea rdi, [rip + reaped_msg];
          mov rsi, 7;
          call sys_debug_puts;

          jmp init_shutdown;

        init_shutdown:
          // sys_exit(0)
          xor rdi, rdi;                   // status = 0
          call sys_exit;
          // (unreachable, but fallback hlt loop for safety)
          hlt;
          jmp init_shutdown
      }
    } @no_frame
}
