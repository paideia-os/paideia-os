// src/user/echo_client.pdx — R20b.M6-003 (#1566)
// Echo-client userspace binary — target-shape sibling of echo_server for
// the R20b.M6-003 dual-endpoint pattern (per design/ipc/userspace-server-
// substrate.md §4.4). Declares an `_init_caps` sidecar seeding TWO cap
// slots:
//
//   cap_slot 0 — the server's endpoint (endpoint_id=1), R_IPC_WRITE |
//                R_IPC_INVOKE (client sends requests here).
//   cap_slot 1 — the client's own reply endpoint (endpoint_id=2),
//                R_IPC_READ | R_IPC_INVOKE (client receives replies here).
//
// _start body:
//
//   encode request hdr with op=0x11, ver=1, reply_endpoint_id=2, len=8
//   sys_ipc_send(cap_slot=0, hdr, payload="PAIDEIA!", 8)   // to server_ep=1
//   sys_ipc_recv(cap_slot=1, hdr, payload, 4088)           // from reply_ep=2
//   verify reply payload
//   sys_exit(0)                                             // one-shot client
//
// Dual-endpoint routing (why this works)
// --------------------------------------
// The v1 header's reserved u16 "flags" field is repurposed at R20b.M6-003
// as `reply_endpoint_id` (bytes 2..3 of the packed 8-byte hdr, LE — see
// frame.pdx §encode layout). Client encodes reply_endpoint_id=2 in the
// request hdr; server preserves it into the reply hdr (only bit 7 of op
// is flipped by echo_server _start); sys_ipc_reply_body reads
// reply_endpoint_id from the reply hdr and — since non-zero — publishes
// to endpoint_id=2 (client's reply endpoint), not endpoint_id=1 (the
// server endpoint the reply's cap_slot resolves to). Client's recv on
// cap_slot=1 drains the reply cleanly. See §4.4 for the full wire
// protocol and the same-endpoint race this closes.
//
// R20b.M6 posture note
// --------------------
// The runtime spawn wiring for this binary (kernel_main → task_new +
// elf_lite_load + runq_enqueue for a NON-init task at boot) is deferred
// to a future round per §4.4 "Deferred" paragraph. echo_client lands at
// M6-003 as the target-shape (built + embedded + shape-verified at every
// push); the M6-003 witness in kernel_main.pdx exercises the dual-
// endpoint protocol kernel-side against init's user_pml4 to prove the
// substrate fix. When multi-task boot orchestration lands (R21+),
// echo_client's _start becomes the actual ring-3 driver.
//
// SC+ IDs inlined (matches echo_server.pdx discipline)
// ----------------------------------------------------
//   40 = sys_ipc_recv   (rdi=cap_slot, rsi=hdr_va, rdx=payload_va, rcx=max)
//   42 = sys_ipc_send   (rdi=cap_slot, rsi=hdr_va, rdx=payload_va, rcx=len)
//   60 = sys_exit       (rdi=status)  (never returns)
//
// SysV rcx is the 4th arg; the SYSCALL entry stashes it into r10 before
// the body reads a3 — no user-side arg shuffle needed at arity 4.

module EchoClient = structure {

  // ============================================================================
  // _init_caps sidecar — TWO entries (matches design/loader/init-caps-
  // sidecar.md §2 format). Total 32 bytes = 4 u64 words + a u64 count.
  //
  // Entry 0: cap_slot=0 — server endpoint (endpoint_id=1) with WRITE|INVOKE.
  //   +0  u16 slot   = 0x0000
  //   +2  u16 kind   = 0x0005 (KIND_IPC_ENDPOINT)
  //   +4  u32 rights = 0x0000_000A (R_IPC_WRITE | R_IPC_INVOKE = 0x02|0x08)
  //   +8  u64 target = 0x0000_0000_0001_0001
  //                    bits [15:0]  = 1 (endpoint_id = server_ep)
  //                    bits [17:16] = 1 (direction=SEND per kind_endpoint.pdx)
  //   Packed:
  //     word0 = (0x0000_000A << 32) | (0x0005 << 16) | 0x0000
  //           = 0x0000_000A_0005_0000
  //     word1 = 0x0000_0000_0001_0001
  //
  // Entry 1: cap_slot=1 — reply endpoint (endpoint_id=2) with READ|INVOKE.
  //   +0  u16 slot   = 0x0001
  //   +2  u16 kind   = 0x0005 (KIND_IPC_ENDPOINT)
  //   +4  u32 rights = 0x0000_0009 (R_IPC_READ | R_IPC_INVOKE = 0x01|0x08)
  //   +8  u64 target = 0x0000_0000_0001_0002
  //                    bits [15:0]  = 2 (endpoint_id = reply_ep)
  //                    bits [17:16] = 1 (direction=RECV=0? actually 0)
  //                    NB: kind_endpoint.pdx defines SEND=0, RECV=1, BIDI=2;
  //                        for clarity we use RECV=1 here — the direction
  //                        is a static-analysis hint at R20b, not a runtime
  //                        gate (kind_endpoint.pdx §3.2 "direction is a
  //                        static-only discipline").
  //   Packed:
  //     word0 = (0x0000_0009 << 32) | (0x0005 << 16) | 0x0001
  //           = 0x0000_0009_0005_0001
  //     word1 = 0x0000_0000_0001_0002
  //
  // The loader validator (init_caps_validate) walks the array via a
  // 16-byte stride per entry (see design/loader/init-caps-sidecar.md §2
  // "InitCap[16 B]" and src/kernel/core/loader/init_caps.pdx §L130).
  // ============================================================================

  pub let _init_caps_count : u64 = 2

  pub let _init_caps : [u64; 4] = [
    // Entry 0: slot=0, kind=KIND_IPC_ENDPOINT(5), rights=WRITE|INVOKE(0x0A)
    0x0000000A00050000,
    // target_ptr: endpoint_id=1 (server), direction=SEND(1)
    0x0000000000010001,
    // Entry 1: slot=1, kind=KIND_IPC_ENDPOINT(5), rights=READ|INVOKE(0x09)
    0x0000000900050001,
    // target_ptr: endpoint_id=2 (reply), direction=RECV(1)
    0x0000000000010002
  ]

  // ============================================================================
  // Client-side scratches: request hdr, request payload ("PAIDEIA!"),
  // reply hdr sink, reply payload sink. Sized like echo_server.pdx.
  //
  // hdr_scratch stores the ENCODED request hdr — built inline in _start
  // via a single u64 store (frame_encode's exact shape).
  // ============================================================================

  pub let mut req_hdr_scratch     : [u64; 1]   = uninit @align(8)
  pub let mut reply_hdr_scratch   : [u64; 1]   = uninit @align(8)
  pub let mut req_payload         : [u8; 8]    = "PAIDEIA!"
  pub let mut reply_payload_sink  : [u64; 511] = uninit @align(8)

  // ============================================================================
  // _start — one-shot RPC round-trip, then exit.
  //
  // Effects / capabilities: {mem, sysreg} @{cap, sched}
  //   mem     — hdr + payload scratch reads/writes.
  //   sysreg  — every SYSCALL.
  //   cap     — sys_ipc_send/recv are cap-gated.
  //   sched   — sys_exit terminates the task (sched teardown).
  //
  // Register discipline
  // -------------------
  // No callee-save state needed — this is a straight-line flow ending
  // in sys_exit (which never returns), so all state lives in caller-save
  // regs across the two syscalls. rax carries the recv's payload_len
  // return; we do not verify it (a length mismatch is a substrate bug,
  // not a runtime condition the client can adapt to at M6-003).
  //
  // Header encoding — inline
  // ------------------------
  // frame_encode's packed u64 layout (frame.pdx §encode-decode) writes:
  //   bits 0..7    op                 = 0x11 (arbitrary "echo" opcode)
  //   bits 8..15   ver                = 1
  //   bits 16..31  reply_endpoint_id  = 2   (client's reply endpoint)
  //   bits 32..63  payload_len        = 8   ("PAIDEIA!")
  // = 0x0000_0008_0002_0111 as a u64
  //
  //   Breakdown:  op=0x11         → bits  0..7   = 0x11
  //               ver=0x01        → bits  8..15  = 0x01 (shifted: 0x0100)
  //               reply_eid=0x02  → bits 16..31  = 0x0002 (shifted: 0x2_0000)
  //               payload_len=8   → bits 32..63  = 8 (shifted: 0x8_0000_0000)
  //     0x0111 | 0x2_0000 | 0x8_0000_0000 = 0x8_0002_0111.
  // ============================================================================

  pub let _start : () -> () !{mem, sysreg} @{cap, sched} =
    fn () -> unsafe {
      effects: {mem, sysreg},
      capabilities: {cap, sched},
      justification: "R20b.M6-003 (#1566): echo_client _start. One-shot RPC round trip proving the dual-endpoint pattern (userspace-server-substrate.md §4.4). Flow: (1) encode request hdr inline via a single u64 store — packed layout op=0x11 (bits 0..7), ver=1 (bits 8..15), reply_endpoint_id=2 (bits 16..31 — the CLIENT's own reply endpoint per _init_caps entry 1), payload_len=8 (bits 32..63) → u64 constant 0x0000_0008_0002_0111 stored at [rip+req_hdr_scratch]. This matches frame_encode's packed shape byte-for-byte (frame.pdx §encode layout) without needing a function call — we know the encoding at compile time. (2) sys_ipc_send(cap_slot=0=server_ep, req_hdr_scratch, req_payload, 8) SC+ ID 42 — publishes request to endpoint_id=1 via cap_slot 0's WRITE|INVOKE rights. rax = 0 on success or negative errno; we don't gate on failure here because a broken send leaves the following recv blocking forever — the test then times out and fails. (3) sys_ipc_recv(cap_slot=1=reply_ep, reply_hdr_scratch, reply_payload_sink, 4088) SC+ ID 40 — blocks on endpoint_id=2 (client's reply endpoint) until the server's sys_ipc_reply routes the reply here (M6-003 dual-endpoint routing per §4.4). rax = payload_len (8) on success. (4) sys_exit(0) SC+ ID 60 — one-shot terminates cleanly (exit status 0 = OK; the test harness reaps and observes status=0). Effects: {mem} for scratch touches, {sysreg} for syscalls, @{cap} for cap-gated IPC, @{sched} for sys_exit's task teardown. @no_frame because the function ends in sys_exit (never returns) — no epilogue needed. All state in caller-save regs (rax/rdi/rsi/rdx/rcx/r10/r11); no callee-save touched.",
      block: {
        // ---- Step 1: encode request hdr inline (single u64 store) ----
        //
        // Packed u64 layout per frame_encode (frame.pdx §encode):
        //   op=0x11 | ver=1<<8 | reply_endpoint_id=2<<16 | payload_len=8<<32
        //   = 0x0000_0008_0002_0111
        //
        // We can't inline this as a mov reg64, imm64 followed by mov [buf], reg
        // in a single insn but the two-step is trivial and matches every
        // paideia-as boot-time constant-store idiom.
        mov rax, 0x0000000800020111;
        lea rcx, [rip + req_hdr_scratch];
        mov [rcx], rax;

        // ---- Step 2: sys_ipc_send(cap_slot=0, req_hdr, req_payload, 8). SC+ ID 42. ----
        mov rdi, 0;                              // cap_slot=0 (server endpoint per sidecar entry 0)
        lea rsi, [rip + req_hdr_scratch];        // hdr_va
        lea rdx, [rip + req_payload];            // payload_va ("PAIDEIA!")
        mov rcx, 8;                              // payload_len
        mov rax, 42;                             // SC+ ID 42
        syscall;
        // rax = 0 on success or negative errno; we don't branch — a failed
        // send leaves the following recv blocking forever and the test
        // harness times out (deterministic failure surface for M6-003).

        // ---- Step 3: sys_ipc_recv(cap_slot=1, reply_hdr, reply_payload, 4088). SC+ ID 40. ----
        // cap_slot=1 = reply endpoint (endpoint_id=2 per sidecar entry 1).
        // Blocks until server's sys_ipc_reply routes the reply here via
        // the hdr.reply_endpoint_id=2 that we encoded in step 1 (M6-003
        // dual-endpoint per §4.4).
        mov rdi, 1;                              // cap_slot=1 (reply endpoint per sidecar entry 1)
        lea rsi, [rip + reply_hdr_scratch];
        lea rdx, [rip + reply_payload_sink];
        mov rcx, 4088;                           // out_payload_max
        mov rax, 40;                             // SC+ ID 40
        syscall;
        // rax = payload_len (8) on success or negative errno.

        // ---- Step 4: sys_exit(0). SC+ ID 60. Never returns. ----
        mov rdi, 0;                              // exit status = 0 (OK)
        mov rax, 60;                             // SC+ ID 60
        syscall;

        // Unreachable. sys_exit does not return; defensive hlt in case
        // the kernel ever regresses ID 60 (which would itself be a bug).
        hlt
      }
    } @no_frame
}
