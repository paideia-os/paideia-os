// src/user/elevate_broker_daemon.pdx — R48-PREP-005.M2/M3/M4
//   (design/services/svc-elevate-broker-registration.md §4.M2;
//    M3/M4 real dispatch + policy engine per paideia-os #2448)
//
// Userspace elevate-broker daemon — the drainer that finally sits behind
// the well-known name "svc.elevate-broker". The kernel-side M1 bringup
// (src/kernel/core/ipc/elevate_broker.pdx's elevate_broker_bringup, called
// from kernel_main.pdx before witness_r30_platform runs) already claims
// ELEVATE_BROKER_ENDPOINT_ID = 16 via endpoint_alloc_at and publishes the
// name against it — but until THIS binary is spawned and recv-loops on
// that endpoint, anything sent to it queues with no reader. This is that
// reader.
//
// Declares an `_init_caps` sidecar per design/loader/init-caps-sidecar.md
// §2 seeding cap-table slot 16 with a KIND_IPC_ENDPOINT capability
// targeting endpoint_id=16 (direction=BIDI, rights=R_IPC_ALL).
//
// Slot choice (design-doc gap note): design/services/svc-elevate-broker-
// registration.md §4.M2 drafted "cap slot 8" for this sidecar. Slot 8 is
// NOT free — it is acpi_supervisor's live RPC-endpoint slot (src/user/
// acpi_supervisor.pdx entry 0; see design/capabilities/loader-seeded-
// slot-allocation.md §3). Landing this image at slot 8 would fail
// tools/verify-user-cap-sidecars.sh's SLOT-COLLISION gate at build time
// (and LOADER_SEED_SLOT_TAKEN at boot, per #1596). The allocation table's
// own "14+ free" note is itself one slot stale (audio_supervisor already
// claims 14 AND 15). This build uses slot 16 — the next actually-free
// absolute slot given the live table (0-1 echo_client, 2 echo_server,
// 5 kernel boot witness, 8-9 acpi_supervisor, 12-13 pci_enumerator,
// 14-15 audio_supervisor) — and the design doc should be corrected
// alongside a follow-up edit to loader-seeded-slot-allocation.md §3's
// table (out of scope for this M2 landing; noted for the tracking issue).
//
// Body is an infinite request/dispatch/reply loop mirroring
// acpi_supervisor.pdx / pci_enumerator.pdx / audio_supervisor.pdx:
//
//   loop:
//     sys_ipc_recv(cap_slot=16, hdr, payload, 4088)   // blocks on empty
//     op = hdr.op & 0xFF                              // full op byte
//     dispatch:
//       op == 1 (ELV_OP_REQ per
//         src/kernel/core/ipc/elevate_channel.pdx §1)  -> 8-byte payload,
//         first u64 = ELVJ_APR (0xFFFFEBA1) or ELVJ_DENY (0xFFFFEBA0),
//         decided by scanning the fixed 8-slot `_elvbd_policy_table`
//         against payload[0] (the requested capability "kind") — the
//         M3/M4 real policy engine (#2448; see file-header section
//         below). Fail-closed on no match.
//       op in {2,3} (ELV_OP_APR/EXP)                  -> 8-byte payload,
//         first u64 = ELVB_DISPATCH_STUB (0xFFFFEBFB per
//         src/kernel/core/ipc/elevate_broker.pdx) — unchanged M2 stub;
//         no policy semantics defined yet for approve/expire frames.
//       default                                        -> 8-byte payload,
//         first u64 = ELVB_DISPATCH_BAD_OP (0xFFFFEBFA)
//     hdr.op |= 0x80                                   // FRAME_OP_REPLY_BIT
//     hdr.payload_len = 8
//     sys_ipc_reply(cap_slot=16, hdr, payload, 8)      // dual-endpoint via
//                                                       // hdr.reply_endpoint_id
//     goto loop
//
// M2 scope note (design doc §4.M2 "Non-goals"): no policy evaluation, no
// request-queue management, no timer-driven expiry, no per-op payload
// shape beyond the 8-byte stub u64. Every recognised op gets the same
// stub reply; that is the wire-level target the (separate, not-this-
// issue) M3 roundtrip witness checks for. Real approve/deny policy is
// R48-PREP-005.M4+.
//
// =============================================================================
// M3/M4 (paideia-os #2448): real ELV_OP_REQ dispatch + fixed policy table
// =============================================================================
//
// M4 policy engine. `_elvbd_policy_table` is a fixed 8-slot (kind,
// action) table -- 16 u64 words, slot i = words[2i]=kind,
// words[2i+1]=action (0=DENY, 1=ALLOW) -- seeded at load time (a `pub
// let` literal, exactly like `_init_caps` above; no runtime
// initialisation code needed). Four slots carry the default policies
// named in the issue; the remaining four are free (kind =
// ELVBD_POLICY_SLOT_FREE, the all-ones sentinel) so the scan has a
// well-defined "no match" terminator distinct from a real kind value of
// 0. This table is PRIVATE to this daemon -- it is a userspace-side
// mirror of the intent the kernel-side `/system/policy` file (design/
// security/elevate-policy-format.md) encodes for the KIND_ELEVATE_
// CHANNEL cap-mint flow; the two are deliberately independent because
// this daemon answers the DIFFERENT wire protocol (raw ELV_OP_REQ/APR/
// EXP frames over endpoint 16, per ipc/elevate_channel.pdx §1) that a
// libpdx-elevate client speaks directly, not the cap-mint row flow
// `elevate_broker_serve_one` (src/kernel/core/ipc/elevate_broker.pdx)
// already serves kernel-side. Widening this table to consult the same
// on-disk `/system/policy` file (rather than a fixed in-.bss table) is
// the natural v2 step once this daemon gains filesystem capabilities
// (@{fs}), tracked as follow-up.
//
// M3 real dispatch. Only ELV_OP_REQ (op=1) gets the real treatment: the
// request payload's first u64 (payload_scratch[0]) names the
// capability-class "kind" being requested (one of the R_* constants
// below, or any other u64 -- an unrecognised kind fails closed to
// ELVJ_DENY exactly like an empty policy-table scan). The daemon looks
// the kind up in `_elvbd_policy_table` and replies with `ELVJ_APR` or
// `ELVJ_DENY` via the SAME sys_ipc_reply(cap_slot=16, ...) call the M2
// stub already used -- any real sender (a spawned libpdx-elevate
// client) that transmits a REQ frame to endpoint 16 gets a genuine
// policy verdict today, not a stub. ELV_OP_APR (2) and ELV_OP_EXP (3)
// keep the M2 stub behaviour unchanged -- this issue's scope names only
// the REQ->verdict roundtrip; approve/expire semantics for a granted
// elevation are a separate, not-yet-designed follow-up.
//
// M3 roundtrip witness -- scope decision. The issue text asks for "a
// real elevate request from libpdx-elevate client" to be answered
// end-to-end. That requires a SECOND real ring-3 task (a libpdx-elevate
// client binary) sending a real IPC frame to this already-spawned
// daemon and a scheduler pass between the send and this daemon's next
// recv -- init does not fork+exec any such client today, and adding one
// is its own cross-cutting change (new binary, new .ld script, new
// init.pdx fork+exec cycle, new tools/build-user.sh wiring, new
// tools/userbin_embed.S entry) that collides with the exact build-order
// hazard class documented in design/tooling/satellite-elf-embed-
// ordering.md for this same cohort's #2440/#2443. Landing that alongside a
// hand-written, unbuildable-until-verified assembly change here would
// multiply risk for a single-issue pass with no build access. This
// landing therefore lands the REAL dispatch body (above) -- which is
// what makes ANY future real client's roundtrip work correctly the
// moment one exists -- and defers the dedicated client+witness pair as
// explicit follow-up scope. See also src/kernel/boot/witness/
// r20b_echo_rpc.pdx for the shape such a witness would take once a
// client binary exists.
//
// SC+ IDs inlined (matches echo_server.pdx / acpi_supervisor.pdx
// discipline — self-contained, one-file-one-ELF, no syscall_shim.pdx
// pull-in):
//   12 = sys_debug_puts  (rdi=buf_va, rsi=len)
//   40 = sys_ipc_recv    (rdi=cap_slot, rsi=hdr_va, rdx=payload_va, rcx=max)
//   41 = sys_ipc_reply   (rdi=cap_slot, rsi=hdr_va, rdx=payload_va, rcx=len)
//
// SysV rcx is the 4th arg; the SYSCALL entry stashes it into r10 before
// the body reads a3 — no user-side arg shuffle needed at arity 4.

module ElevateBrokerDaemon = structure {

  // ============================================================================
  // _init_caps sidecar — ONE entry (matches echo_server.pdx §2 format).
  //
  //   +0  u16 slot   = 0x0010 (16 — see slot-choice note in the file header)
  //   +2  u16 kind   = 0x0005 (KIND_IPC_ENDPOINT — base per cap/kind.pdx)
  //   +4  u32 rights = 0x0000_000B (R_IPC_ALL = READ|WRITE|INVOKE)
  //   +8  u64 target = 0x0000_0000_0002_0010
  //                    bits [15:0]  = 16 (endpoint_id = ELEVATE_BROKER_ENDPOINT_ID
  //                                  per src/kernel/core/ipc/elevate_broker.pdx)
  //                    bits [17:16] = 2  (direction=BIDI per kind_endpoint.pdx)
  //
  // Packed as two u64 words (LE):
  //   word0 = (0x0000_000B << 32) | (0x0005 << 16) | 0x0010
  //         = 0x0000_000B_0005_0010
  //   word1 = 0x0000_0000_0002_0010
  //
  // R31.M2-1596 (#1596): slot numbers are GLOBAL cap-table indices, not
  // local to this image — see the allocation-collision rationale
  // repeated in every sibling sidecar (echo_server.pdx / acpi_supervisor.
  // pdx / pci_enumerator.pdx / audio_supervisor.pdx). Enforced at build
  // time by tools/verify-user-cap-sidecars.sh.
  // ============================================================================

  pub let _init_caps_count : u64 = 1

  pub let _init_caps : [u64; 2] = [
    // slot=16, kind=KIND_IPC_ENDPOINT(5), rights=R_IPC_ALL(0x0B)
    0x0000000B00050010,
    // target_ptr: endpoint_id=16 (ELEVATE_BROKER_ENDPOINT_ID), direction=BIDI(2)
    0x0000000000020010
  ]

  // ============================================================================
  // Server-side hdr + payload scratch buffers (.bss @align(8)). Same shape
  // as every R20b-substrate userspace server sidecar.
  // ============================================================================

  pub let mut hdr_scratch     : [u64; 1]   = uninit @align(8)
  pub let mut payload_scratch : [u64; 511] = uninit @align(8)

  // ============================================================================
  // R48-PREP-005.M3/M4 (#2448): real dispatch reply sentinels + policy
  // engine. See the file-header M3/M4 section above for the full
  // rationale; this block is the storage + constants the dispatch code
  // in _start reads.
  // ============================================================================

  // Reply sentinels for a real ELV_OP_REQ verdict. Distinct nibble
  // bucket (0xFFFFEBAx) from the M2 stub's 0xFFFFEBFx band so a boot-log
  // hex dump trivially distinguishes "M2 stub reply" from "M3 real
  // policy verdict" during the transition.
  pub let ELVJ_APR  : u64 = 0xFFFFEBA1
  pub let ELVJ_DENY : u64 = 0xFFFFEBA0

  // Policy "kind" identifiers -- the value a real client places in
  // payload_scratch[0] of an ELV_OP_REQ frame to name the capability
  // class it wants elevated. R_NET_PRIVILEGED_PROTOCOL reuses the live
  // kernel-side cap bit value (src/kernel/core/cap/cap_net_privileged.
  // pdx's R_NET_PRIVILEGED_PROTOCOL = 0x1000) so a client encoding that
  // real cap bit as its request kind is answered consistently; the
  // other three are new identifiers minted at this seam (no matching
  // kernel-side cap_* module exists yet for R_ELEVATE_BROKER /
  // R_MOUNT_ROOT / R_PDXFS_ADMIN -- promoting them to real kernel cap
  // bits is v2 follow-up, tracked alongside the policy-table widening
  // noted in the file header).
  pub let R_NET_PRIVILEGED_PROTOCOL : u64 = 0x1000
  pub let R_ELEVATE_BROKER          : u64 = 0x1001
  pub let R_MOUNT_ROOT              : u64 = 0x1002
  pub let R_PDXFS_ADMIN             : u64 = 0x1003

  pub let ELVBD_POLICY_ACTION_DENY  : u64 = 0
  pub let ELVBD_POLICY_ACTION_ALLOW : u64 = 1

  // All-ones sentinel marking an unused policy-table slot. Chosen so it
  // can never collide with a real kind value (every R_* constant above
  // fits comfortably under 2^16).
  pub let ELVBD_POLICY_SLOT_FREE : u64 = 0xFFFFFFFFFFFFFFFF

  // Fixed 8-slot (kind, action) policy table, packed as 16 u64 words
  // (slot i = words[2i]=kind, words[2i+1]=action). Immutable rodata --
  // exactly like `_init_caps` above, a literal initializer needs no
  // runtime seeding code. Four default policies (issue #2448):
  //   R_NET_PRIVILEGED_PROTOCOL -> DENY
  //   R_ELEVATE_BROKER          -> ALLOW
  //   R_MOUNT_ROOT              -> DENY
  //   R_PDXFS_ADMIN             -> DENY
  // Slots 4..7 are free (fail-closed: an unmatched kind falls through
  // every slot including the free ones, since ELVBD_POLICY_SLOT_FREE
  // never equals a real request kind, and the scan's own exhausted-scan
  // path is DENY -- see elvbd_policy_deny's "jae" entry in _start below).
  pub let _elvbd_policy_table : [u64; 16] = [
    0x1000, 0,                              // R_NET_PRIVILEGED_PROTOCOL -> DENY
    0x1001, 1,                              // R_ELEVATE_BROKER -> ALLOW
    0x1002, 0,                              // R_MOUNT_ROOT -> DENY
    0x1003, 0,                              // R_PDXFS_ADMIN -> DENY
    0xFFFFFFFFFFFFFFFF, 0,                  // free slot 4
    0xFFFFFFFFFFFFFFFF, 0,                  // free slot 5
    0xFFFFFFFFFFFFFFFF, 0,                  // free slot 6
    0xFFFFFFFFFFFFFFFF, 0                   // free slot 7
  ]

  // ============================================================================
  // Ring-3 proof-of-life marker (mirrors echo_server.pdx / R31.M2-1590):
  // this binary is spawned as a real ring-3 task by init's fork+exec cycle
  // (src/user/init.pdx's third cycle), not driven kernel-side against
  // init's user_pml4 the way acpi_supervisor / pci_enumerator /
  // audio_supervisor still are at M2. Emitted once, before the first
  // sys_ipc_recv, via sys_debug_puts (SC+ ID 12 — depends on nothing but
  // the SYSCALL entry path).
  // ============================================================================
  pub let ring3_msg : [u8; 26] = "ELEVATE BROKER DAEMON OK\n\0"
  pub let ring3_len : u64 = 25

  // ============================================================================
  // _start — user program entry point. Infinite dispatch loop; never returns.
  //
  // Effects / capabilities
  // ----------------------
  // {mem, sysreg} @{cap}:
  //   mem     — hdr_scratch + payload_scratch reads/writes.
  //   sysreg  — every SYSCALL instruction touches IA32_LSTAR/IA32_CSTAR/
  //             IA32_FMASK indirectly via the CPU's fast-syscall path.
  //   cap     — the two IPC syscalls are cap-gated at the dispatch shim
  //             (cap_slot 16 = daemon endpoint per sidecar).
  //
  // Register discipline
  // -------------------
  // r12 stashes the raw recv'd hdr u64 across the dispatch arms so the
  // reply hdr rebuild can recompute op|ver|reply_eid from it.
  // r13 stashes the reply payload_len (always 8 at M2) across the
  // sys_ipc_reply call. Both callee-save; SYSCALL preserves them per
  // amd64 fast-syscall rules, and _start never returns so no caller
  // needs them restored.
  // ============================================================================

  pub let _start : () -> () !{mem, sysreg} @{cap} =
    fn () -> unsafe {
      effects: {mem, sysreg},
      capabilities: {cap},
      justification: "R48-PREP-005.M2/M3/M4 (design/services/svc-elevate-broker-registration.md; #2448 for M3/M4): elevate_broker_daemon _start. Infinite request/dispatch/reply loop over cap_slot=16 (seeded by _init_caps sidecar to endpoint_id=16 = ELEVATE_BROKER_ENDPOINT_ID with R_IPC_ALL). Step 0: emit 'ELEVATE BROKER DAEMON OK\\n' via sys_debug_puts (SC+ ID 12) as a ring-3 proof-of-life marker, mirroring echo_server's R31.M2-1590 posture — this binary is a real spawned ring-3 task, not a kernel-driven witness fixture. Sequence per loop iteration: (1) sys_ipc_recv(rdi=16, rsi=&hdr_scratch, rdx=&payload_scratch, rcx=4088) SC+ ID 40. rax = payload_len on success or negative errno; on negative, defensively branch back to elvbd_server_loop (same retry posture as every R20b-substrate server sibling — the failure modes are structural: bad cap slot or walker VA rejection against our own .bss, both of which are impossible in practice, so the tight retry keeps behaviour deterministic without a userspace error-handling policy). (2) Load hdr u64 via `mov rax, [hdr_scratch]`; stash raw hdr in r12; extract op = rax & 0xFF (full-byte mask, no byte-granularity load). (3) Dispatch: op==1 (ELV_OP_REQ) routes to the M3/M4 real policy path (elvbd_dispatch_req): reads payload_scratch[0] as the requested capability-class 'kind', linear-scans the 8-slot `_elvbd_policy_table` (16 u64 words, kind/action pairs) for a match, and writes ELVJ_APR (0xFFFFEBA1, match with action=ALLOW) or ELVJ_DENY (0xFFFFEBA0, match with action=DENY OR scan exhausted with no match — fail-closed) as the payload's first u64, sets r13=8. op in {2,3} (ELV_OP_APR/EXP) keep the unchanged M2 stub (elvbd_dispatch_stub): writes ELVB_DISPATCH_STUB (0xFFFFEBFB per ipc/elevate_broker.pdx) and sets r13=8 — no policy semantics defined yet for APR/EXP frames, out of #2448's scope. Any other op writes ELVB_DISPATCH_BAD_OP (0xFFFFEBFA) and sets r13=8. (4) Rebuild reply hdr: reload r12, mask to low 32 bits (op|ver|reply_endpoint_id), OR in FRAME_OP_REPLY_BIT (0x80), OR in (r13 << 32) for payload_len, store back to hdr_scratch. This preserves the reply_endpoint_id the requester encoded (dual-endpoint routing per userspace-server-substrate.md §4.4) exactly like acpi_supervisor's reply-hdr rebuild. (5) sys_ipc_reply(rdi=16, rsi=&hdr_scratch, rdx=&payload_scratch, rcx=r13) SC+ ID 41; rax = 0 or pass-through error, not gated — the loop's next recv absorbs any anomaly. (6) jmp elvbd_server_loop. Never returns. Policy-scan register discipline: rax/rcx/rdx/r10/r11 are scratch for elvbd_dispatch_req/elvbd_policy_scan/elvbd_policy_hit (none are live across the scan from the recv/hdr-extract steps above); r12 (raw hdr) and the not-yet-set r13 are left untouched by the scan so the existing reply-hdr-rebuild step's r12 read stays valid. Encoder-conservative: cmp/je/jae/mov/lea/xor/shl/add only, every immediate an imm8/imm32; `shl rcx, 1` + scale-8 addressing `[r10 + rcx*8]` computes slot*16 byte offsets without an illegal scale-16 SIB (mirrors src/kernel/core/ipc/elevate_broker.pdx's own `[r10 + rcx*8]` idiom). No test rN,rN; no `and`/2-op `imul` anywhere in the new code; `add r11, 1` is register+imm8, not an imm64 form. Effects union: {mem} for hdr/payload/policy-table reads and hdr/payload scratch writes; {sysreg} for every SYSCALL. @{cap} because sys_ipc_recv/sys_ipc_reply are cap-gated. @no_frame because the loop is a tail-call replacement of the entire function body. All internal labels are elvbd_-prefixed per this tree's reserved-label convention.",
      block: {
        // ---- Step 0: ring-3 proof of life. ----
        lea rdi, [rip + ring3_msg];
        mov rsi, 25;                       // ring3_len (excludes trailing NUL)
        mov rax, 12;                       // SC+ ID 12 = sys_debug_puts
        syscall;

        elvbd_server_loop:
          // ---- Step 1: sys_ipc_recv(cap_slot=16, hdr, payload, 4088). SC+ ID 40. ----
          mov rdi, 16;                       // cap_slot=16 (daemon endpoint per _init_caps)
          lea rsi, [rip + hdr_scratch];      // out_hdr_va (user VA — our .bss)
          lea rdx, [rip + payload_scratch];  // out_payload_va (user VA — our .bss)
          mov rcx, 4088;                     // out_payload_max = FRAME_MAX_PAYLOAD
          mov rax, 40;                       // SC+ ID 40
          syscall;
          // rax = payload_len [0..4088] or negative errno.
          cmp rax, 0;
          jl elvbd_server_loop;               // defensive retry

          // ---- Step 2: extract op byte + dispatch ----
          lea rax, [rip + hdr_scratch];
          mov rax, [rax];                     // rax = packed hdr u64
          mov r12, rax;                        // stash raw hdr in r12
          and rax, 0xFF;                       // rax = op byte

          cmp rax, 1;
          je  elvbd_dispatch_req;              // ELV_OP_REQ -> M3/M4 real policy dispatch
          cmp rax, 2;
          je  elvbd_dispatch_stub;             // ELV_OP_APR (M2 stub unchanged)
          cmp rax, 3;
          je  elvbd_dispatch_stub;             // ELV_OP_EXP (M2 stub unchanged)
          jmp elvbd_dispatch_bad_op;

        elvbd_dispatch_req:
          // R48-PREP-005.M3/M4 (#2448): real policy-table dispatch for
          // ELV_OP_REQ. payload_scratch[0] (client-encoded) names the
          // requested capability-class "kind"; scan the 8-slot policy
          // table (16 u64 words: kind,action pairs) and reply with
          // ELVJ_APR / ELVJ_DENY. Fail-closed: an unmatched kind (table
          // exhausted) denies.
          lea rcx, [rip + payload_scratch];
          mov rax, [rcx];                      // rax = requested kind
          lea r10, [rip + _elvbd_policy_table]; // r10 = table base
          xor r11, r11;                        // r11 = slot index (0..7)

        elvbd_policy_scan:
          cmp r11, 8;
          jae elvbd_policy_deny;               // exhausted -> fail-closed DENY
          mov rcx, r11;
          shl rcx, 1;                          // rcx = slot*2 (kind word index)
          mov rdx, [r10 + rcx * 8];            // rdx = table[slot].kind
          cmp rdx, rax;
          je  elvbd_policy_hit;
          add r11, 1;
          jmp elvbd_policy_scan;

        elvbd_policy_hit:
          mov rcx, r11;
          shl rcx, 1;
          add rcx, 1;                          // rcx = slot*2+1 (action word index)
          mov rdx, [r10 + rcx * 8];            // rdx = action (0=DENY, 1=ALLOW)
          cmp rdx, 1;
          je  elvbd_policy_allow;
          jmp elvbd_policy_deny;

        elvbd_policy_allow:
          mov rax, 0xFFFFEBA1;                 // ELVJ_APR
          jmp elvbd_policy_reply;

        elvbd_policy_deny:
          mov rax, 0xFFFFEBA0;                 // ELVJ_DENY

        elvbd_policy_reply:
          lea rcx, [rip + payload_scratch];
          mov [rcx], rax;                      // payload[0..7] = ELVJ_APR | ELVJ_DENY
          mov r13, 8;                          // reply payload_len
          jmp elvbd_reply_hdr_rebuild;

        elvbd_dispatch_stub:
          // ELVB_DISPATCH_STUB = 0xFFFFEBFB (ipc/elevate_broker.pdx).
          mov rax, 0xFFFFEBFB;
          lea rcx, [rip + payload_scratch];
          mov [rcx], rax;                      // payload[0..7] = ELVB_DISPATCH_STUB
          mov r13, 8;                          // reply payload_len
          jmp elvbd_reply_hdr_rebuild;

        elvbd_dispatch_bad_op:
          // ELVB_DISPATCH_BAD_OP = 0xFFFFEBFA (ipc/elevate_broker.pdx).
          mov rax, 0xFFFFEBFA;
          lea rcx, [rip + payload_scratch];
          mov [rcx], rax;                      // payload[0..7] = ELVB_DISPATCH_BAD_OP
          mov r13, 8;
          // Fall through to elvbd_reply_hdr_rebuild.

        elvbd_reply_hdr_rebuild:
          // Rebuild reply hdr: keep op|ver|reply_eid (low 32 bits of r12),
          // set FRAME_OP_REPLY_BIT (bit 7 of byte 0), write payload_len_rep
          // into bits 32..63.
          mov rax, r12;
          mov rcx, 0xFFFFFFFF;
          and rax, rcx;                        // rax = low 32 bits (op|ver|reply_eid)
          or  rax, 0x80;                       // set FRAME_OP_REPLY_BIT
          mov rcx, r13;
          shl rcx, 32;                         // payload_len << 32
          or  rax, rcx;
          lea rcx, [rip + hdr_scratch];
          mov [rcx], rax;                       // store rebuilt hdr

          // ---- Step 3: sys_ipc_reply(cap_slot=16, hdr, payload, r13). SC+ ID 41. ----
          mov rdi, 16;                          // cap_slot=16 (daemon endpoint)
          lea rsi, [rip + hdr_scratch];        // hdr_va (bit-7 set; reply_eid preserved)
          lea rdx, [rip + payload_scratch];    // payload_va (stub-filled)
          mov rcx, r13;                         // payload_len_rep (= 8)
          mov rax, 41;                          // SC+ ID 41
          syscall;
          // rax = 0 (OK) or pass-through error; don't branch.

          jmp elvbd_server_loop
      }
    } @no_frame
}
