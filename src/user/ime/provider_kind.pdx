        shl rax, 32;
        shr rax, 32;

        // r10 = lang & 0xFF placed at bits [39:32]
        mov r10, rsi;
        shl r10, 56;                    // isolate low byte at top
        shr r10, 24;                    // move to bits [39:32] (56-24=32)

        or  rax, r10;
        ret
      }
    }

  // provider_kind_locale_active_pack(locale_offset, active_session_count)
  //   -> active_session_count[63:32] | locale_offset[31:0].
