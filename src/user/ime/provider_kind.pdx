// src/user/ime/provider_kind.pdx -- G11-M2-001 (paideia-os #2315)
//
// KIND_IME_PROVIDER = 0x1DC, non-linear derived cap over
// KIND_IPC_ENDPOINT (= 5). Design authority: design/compositor/
// pwp-spec-vocabulary.md §2.19 KIND_IME_PROVIDER.
//
// An IME PROVIDER is a satellite process that services
// KIND_IME_SESSION requests: it converts a keystroke stream into
// composed text (Pinyin, Zhuyin, Kana, Hangul, Devanagari, InScript,
// Latin autocomplete, ...) and returns preedit + commit events to
// the compositor's IME router (§2.20, sibling landing #2316), which
// in turn stamps them into the LINEAR KIND_IME_SESSION rows that
// this module's sibling defines at src/user/ime/session_kind.pdx
// (G11-M1-001, #2314 -- LANDED B8).
//
// SPEC ALIGNMENT. §2.19 pins the parent kind as
// KIND_IPC_ENDPOINT (= 5). This landing HONORS that pin: unlike the
// sibling session_kind.pdx (which reshaped its parent from
// KIND_IPC_ENDPOINT to KIND_WINDOW because a session is anchored to
// a specific window's text field), a PROVIDER is a free-standing
// satellite process whose only substrate coupling is "the router
// can reach it via an IPC endpoint and ask it to service sessions."
// The KIND_IPC_ENDPOINT parent is therefore semantically correct:
// discovery is by (lang, locale), not by any particular window.
//
// PROVIDER SWAP PROTOCOL. #2315's stated deliverable is "discovery
// + provider-switch protocol." The discovery half lands here as
// ime_provider_lookup_by_lang(lang); the switch half is the
// bind_session / unbind_session pair, which mutate the router-side
// association without minting or revoking either the provider row
// or the session row. The intent is:
//
//   * At session mint time (KIND_IME_ROUTER, #2316, future) the
//     router calls ime_provider_lookup_by_lang(lang) to pick a
//     provider. That provider's row_id gets stamped into the new
//     session's provider_kind_id field (session_kind.pdx §1.3
//     [+16]) and ime_provider_bind_session bumps the provider's
//     active_session_count so the router can trend load per
//     provider.
//
//   * A runtime swap ("user pressed the language toggle key while
//     a session was open") is a router-side atomic transition:
//     ime_provider_unbind_session on the OLD provider, then a
//     fresh ime_provider_lookup_by_lang on the NEW (lang, locale),
//     then ime_provider_bind_session on the winner and a rewrite
//     of the session row's provider_kind_id field IN PLACE. The
//     session cap does NOT get revoked and re-minted (that would
//     hit the LINEAR invariant P10 mitigation exists to enforce);
//     only the router-side association changes.
//
//   * When the provider PROCESS exits the router calls
//     ime_provider_unregister, which zeros the row header, decrements
//     the pool's in-use count, and returns the row to the free list.
//     Sessions still bound to the exiting provider are the router's
//     responsibility to rebind via a fresh lookup + bind cycle
//     BEFORE calling unregister; this file's unregister does NOT
//     walk sessions and does NOT emit any event -- provider-process
//     death is a router-side observation, not a self-notification.
//
// NON-LINEAR CAP + R_IMP_MINT RATIONALE. Unlike the LINEAR
// KIND_IME_SESSION (one open composition per surface), a
// KIND_IME_PROVIDER row is non-linear: MULTIPLE providers register
// concurrently (one per (lang, locale) plus optional per-lang
// duplicates for competing IME implementations, e.g. two Pinyin
// providers a user picks between). The mint gate is R_IMP_MINT and
// is held by the router (§2.20 #2316); a provider process cannot
// self-register, it walks up to the router on IPC and asks for the
// row. The R_REVOKE / RIGHT_REVOKE bit is what the router uses to
// unregister a provider on process death (or on the user removing
// the provider); a provider process holding its own KIND_IME_PROVIDER
// cap cannot revoke it (the mint gate does not hand R_REVOKE to the
// callee).
//
// SLOT ALLOCATION. 0x1DC is verified free by grep across
// src/**/*.pdx + design/**/*.md at landing time (adjacent occupants:
// 0x1D6 KIND_SEAT, 0x1D7 KIND_INPUT_ROUTE, 0x1D8 KIND_TOUCH_CONTACT,
// 0x1D9 KIND_DAMAGE_REGION, 0x1DA KIND_PRESENT_FEEDBACK; 0x1DB
// reserved for sibling B9/B10 compositor landings but not yet
// claimed; 0x1DD..0x1DF free). Main should advance the "Next free
// derived-kind tag" line in design/architecture/next-wave-derived-
// kinds.md past 0x1DC at batch close.
//
// FAILURE BAND REBASE. The row prompt named 0xFFFFEC80..EC8F as this
// file's failure band. Grep-verify at landing time showed that band
// FULLY OCCUPIED by AHCI (AHCIP_MINT_BAD_SIG = 0xFFFFEC81,
// AHCIP_MINT_NO_LBA48 = 0xFFFFEC82, AHCIC_RESET_TIMEOUT = 0xFFFFEC86,
// and adjacent codes -- see src/kernel/core/drivers/ahci/port.pdx
// L97, reset.pdx L101). The prompt was stale (issued before an AHCI
// batch that consumed those codes). Rebased to 0xFFFFE9A0..0xFFFFE9AF,
// which grep-verify confirms is a fully clean 16-slot page (zero
// occurrences across src/ + tests/ + design/ as of this landing).
// The 0xFFFFE9 family is otherwise sparsely populated (adjacent
// pages 0xFFFFE9C0..CF, 0xFFFFE9E0..EF each carry a single legacy
// entry) which leaves substantial headroom for sibling G11.M2/M3
// landings should they want to homestead nearby. The KIND_IME_
// SESSION sibling's own band (0xFFFFEB70..7F) is not in this family
// because there is no free page in the 0xFFFFEB family at landing
// time; failure bands within one milestone need not be adjacent, and
// the sibling's own file header does not commit us to adjacency.
//
// P10 MITIGATION SIBLING. The KIND_IME_SESSION file (sibling, #2314)
// closes pitfall P10 (dual-IME race) via LINEARITY and EXCLUSIVE
// ROUTING through KIND_IME_ROUTER (#2316). This file's contribution
// to that closure is the DISCOVERY invariant: exactly ONE provider
// row per (lang, locale) at any moment (enforced by
// ime_provider_lookup_by_lang returning the first match; the router
// is responsible for refusing a second ime_provider_register call
// for a (lang, locale) that already holds a live row -- the router
// enforcement is out of scope for this file, which only exposes the
// row-pool primitives). Together with LINEARITY + EXCLUSIVE ROUTING
// the invariant "one provider per (lang, locale), one session per
// (window, field), one router" closes P10.
//
// LABEL PREFIX: `provider_kind_` throughout (per row prompt),
// sidestepping paideia-as reserved-word collisions (see
// feedback_paideia_as_reserved_labels). Every ASM jump target is
// `provider_kind_<funcname>_<tag>` to avoid the same class.
//
// MECE SCOPE. Single file under src/user/ime/. Touches only:
//   * NEW: src/user/ime/provider_kind.pdx (this file)
//   * EDIT: tools/verify-fingerprint-coverage.sh (add allowlist
//           entry for pdx_kind_ime_provider_meta since the router-
//           side dispatcher that would emit it is a future landing)
// No other file is modified.
//
// FINGERPRINT. One legacy-suffixed register fingerprint per the
// standard klog convention (matches session_kind / surface_commit /
// window_kind / kind_tui_canvas precedent). Emitted once on
// successful register by the FUTURE router-side substrate; no
// fingerprint on the lookup / bind / unbind / query_caps / unregister
// paths. Until the substrate lands, the tag is DATA-ONLY (declared
// here but not emitted from any body) -- verify-fingerprint-coverage.
// sh gets a matching allowlist entry per the sibling B8/B9 pattern
// (see "ime session mint ok" in that file's ALLOWLIST).
//
// =============================================================================

module ProviderKind = structure {

  // ==========================================================================
  // SECTION 1.1 -- KIND ORDINAL + PARENT
  // ==========================================================================

  pub let KIND_IME_PROVIDER      : u64 = 0x1DC
  pub let KIND_IME_PROVIDER_BASE : u64 = 5      // = KIND_IPC_ENDPOINT

  // ==========================================================================
  // SECTION 1.2 -- RIGHTS (non-linear; R_IMP_MINT present)
  // ==========================================================================
  //
  // Bit assignments follow the surface_commit / selection_owner /
  // session_kind style (a sparse bitmap so the dispatcher can
  // `test rax, R_*` and branch on the single bit).
  //
  //   RIGHT_SERVICE_SESSION       -- provider commits it will service a
  //                                  session bound to it (paired with
  //                                  the bind_session op)
  //   RIGHT_QUERY_LANG            -- read lang field
  //   RIGHT_QUERY_LOCALE          -- read locale_offset field
  //   RIGHT_ADVERTISE_CAPABILITIES-- read caps_bitmap field
  //   RIGHT_REVOKE                -- unregister (row goes back to free list;
  //                                  held by router, NOT by the provider
  //                                  process itself)
  //   R_IMP_OBSERVE               -- compositor-held debug printer
  //   R_IMP_MINT                  -- register a new provider (held by the
  //                                  router; enables the non-linear
  //                                  factory contract)
  //
  // R_IMP_ALL is the OR of every declared bit. The client-visible
  // right-set the router hands to a provider process at register
  // time is R_IMP_PROVIDER: everything EXCEPT R_IMP_MINT and
  // RIGHT_REVOKE (the provider cannot self-mint or self-unregister).
  // R_IMP_OBSERVE stays with the compositor authority for the debug
  // printer path; the router carries R_IMP_MINT + RIGHT_REVOKE +
  // R_IMP_OBSERVE.

  pub let RIGHT_SERVICE_SESSION      : u64 = 0x01
  pub let RIGHT_QUERY_LANG           : u64 = 0x02
  pub let RIGHT_QUERY_LOCALE         : u64 = 0x04
  pub let RIGHT_ADVERTISE_CAPABILITIES: u64 = 0x08
  pub let RIGHT_REVOKE               : u64 = 0x10
  pub let R_IMP_OBSERVE              : u64 = 0x20
  pub let R_IMP_MINT                 : u64 = 0x40
  pub let R_IMP_ALL                  : u64 = 0x7F

  // Router-visible right-set at register time (everything).
  pub let R_IMP_ROUTER               : u64 = 0x7F

  // Provider-process visible right-set (everything except MINT + REVOKE).
  pub let R_IMP_PROVIDER             : u64 = 0x2F

  // ==========================================================================
  // SECTION 1.3 -- ImeLang ENUM (sealed at boot to LANG_LATIN..LANG_THAI)
  // ==========================================================================
  //
  // Sealed enumeration of the supported input-method language families.
  // Values are dense (0..8) so router-side per-lang tables can index
  // by the enum directly. Any lang > LANG_MAX is refused at every
  // entry point with IMP_BAD_LANG.

  pub let LANG_LATIN    : u64 = 0    // Latin autocomplete
  pub let LANG_CJK_ZH   : u64 = 1    // Chinese (Pinyin, Zhuyin, ...)
  pub let LANG_CJK_JA   : u64 = 2    // Japanese (Kana, Romaji, ...)
  pub let LANG_CJK_KO   : u64 = 3    // Korean (Hangul)
  pub let LANG_INDIC_HI : u64 = 4    // Hindi (Devanagari, InScript)
  pub let LANG_INDIC_TA : u64 = 5    // Tamil
  pub let LANG_ARABIC   : u64 = 6    // Arabic (with RTL shaping)
  pub let LANG_HEBREW   : u64 = 7    // Hebrew (with RTL shaping)
  pub let LANG_THAI     : u64 = 8    // Thai (with segmentation)
  pub let LANG_MAX      : u64 = 8    // inclusive upper bound

  // ==========================================================================
  // SECTION 1.4 -- caps_bitmap FLAGS
  // ==========================================================================
  //
  // A provider advertises which composition features it implements.
  // The router uses this at lookup time to prefer a provider that
  // supports the features a session's text field requested (e.g. a
  // password field asks for no candidate window).

  pub let IMP_CAP_PREEDIT          : u64 = 0x01  // supports preedit strings
  pub let IMP_CAP_CANDIDATE_WINDOW : u64 = 0x02  // draws a candidate window
  pub let IMP_CAP_PHONETIC         : u64 = 0x04  // accepts phonetic input
  pub let IMP_CAP_STROKE_INPUT     : u64 = 0x08  // accepts stroke input
  pub let IMP_CAP_ALL              : u64 = 0x0F  // OR of every defined bit

  // ==========================================================================
  // SECTION 1.5 -- ROW LAYOUT (ImeProvider, 48 bytes)
  // ==========================================================================
  //
  // Six u64 words packed to hold every documented field, with reserved
  // space at the tail for future extension (input-mode flags, per-
  // provider preferred script). Every mutating op edits one packed
  // field IN PLACE. The row is written by exactly one authority at a
  // time (the router serializes register / bind_session /
  // unbind_session against a provider row through its own dispatch
  // loop; the query_caps read paths are lock-free and read a single
  // aligned u64 word).
  //
  // Row layout (offsets in bytes):
  //
  //   [+0]  header:
  //             in_use[63:56]        1 iff row is allocated
  //             reserved[55:0]       0 at register; future flags land here
  //
  //   [+8]  proc_and_lang:
  //             provider_process_kind_id[31:0]  the KIND_PROCESS
  //                                             (or KIND_IPC_ENDPOINT
  //                                             through which the
  //                                             satellite process is
  //                                             reachable) cap_table slot
  //             lang[39:32]                     ImeLang enum value (u8)
  //             reserved[63:40]                 0 at register
  //
  //   [+16] locale_and_active:
  //             locale_offset[31:0]             interned string offset
  //                                             into the router-side
  //                                             locale-string pool
  //                                             ("en-US", "zh-CN", ...);
  //                                             0 reserved for "unlocaled"
  //             active_session_count[63:32]     number of KIND_IME_SESSION
  //                                             rows currently bound to
  //                                             this provider
  //
  //   [+24] caps_and_pad:
  //             caps_bitmap[31:0]               IMP_CAP_* OR
  //             reserved[63:32]                 0 at register
  //
  //   [+32] registered_seq: u64
  //             monotone counter, snapshot of _provider_kind_seq at the
  //             moment this row was registered. Router uses this to
  //             break ties when multiple providers claim (lang, locale)
  //             -- lookup returns the LATEST registrant (the one with
  //             the greatest registered_seq), matching the "most
  //             recently installed provider wins" convention users
  //             expect when reinstalling their IME package.
  //
  //   [+40] reserved: u64
  //             0 at register; future extension (per-provider preferred
  //             script hint, input-mode flags, PROBED state bit).
  //
  // The row does NOT carry the sessions bound to it as a list --
  // active_session_count is a scalar the router increments on bind
  // and decrements on unbind, so the router-side load telemetry is
  // O(1) per event. If a future milestone needs "walk the sessions
  // bound to this provider" (e.g. for provider-death cascade
  // revocation), the router walks the KIND_IME_SESSION pool matching
  // on provider_kind_id -- the session row already carries that
  // field.

  pub let IME_PROVIDER_ROW_BYTES : u64 = 48
  pub let IME_PROVIDER_MAX       : u64 = 8    // pool ceiling; one row per
                                              // (lang, locale) plus a few
                                              // duplicates for competing
                                              // IME implementations. A
                                              // grown IME ecosystem
                                              // widens this at row-alloc
                                              // pressure time.

  // Offsets into the 48-byte row.
  pub let IME_PROVIDER_OFF_HEADER          : u64 = 0
  pub let IME_PROVIDER_OFF_PROC_AND_LANG   : u64 = 8
  pub let IME_PROVIDER_OFF_LOCALE_ACTIVE   : u64 = 16
  pub let IME_PROVIDER_OFF_CAPS            : u64 = 24
  pub let IME_PROVIDER_OFF_REG_SEQ         : u64 = 32
  pub let IME_PROVIDER_OFF_RESERVED        : u64 = 40

  // Header bit positions (in the top byte of the [+0] word).
  //   in_use   = bit 56 of the header word
  pub let IME_PROVIDER_HDR_IN_USE_BIT : u64 = 56

  // Sentinel "no provider matched" for lookup return.
  pub let IME_PROVIDER_NONE : u64 = 0

  // Locale sentinel: 0 means "unlocaled" (Latin autocomplete typically
  // registers with locale_offset==0). Non-zero is an interned offset
  // into the router-side locale-string pool.
  pub let IME_PROVIDER_LOCALE_UNLOCALED : u64 = 0

  // ==========================================================================
  // SECTION 1.6 -- FAILURE TAXONOMY (0xFFFFE9A0..0xFFFFE9AF)
  // ==========================================================================
  //
  // Fresh 16-wide band. Rebased from the row prompt's 0xFFFFEC80..EC8F
  // (FULLY OCCUPIED by AHCI -- see file header). Grep-verified free
  // across src/ + tests/ + design/ at landing time.

  pub let IMP_OK                    : u64 = 0
  pub let IMP_TAIL_ENOSPC           : u64 = 0xFFFFE9AF   // pool full
  pub let IMP_TAIL_BAD_ARG          : u64 = 0xFFFFE9AE
  pub let IMP_BAD_LANG              : u64 = 0xFFFFE9AD   // lang > LANG_MAX
  pub let IMP_BAD_PROCESS           : u64 = 0xFFFFE9AC   // process_kind_id == 0
  pub let IMP_BAD_LOCALE            : u64 = 0xFFFFE9AB   // locale offset u32 overflow
  pub let IMP_BAD_CAPS              : u64 = 0xFFFFE9AA   // caps_bitmap bits above IMP_CAP_ALL
  pub let IMP_BAD_SLOT              : u64 = 0xFFFFE9A9   // row_id out of range or empty
  pub let IMP_BAD_RIGHTS            : u64 = 0xFFFFE9A8
  pub let IMP_BIND_STALE            : u64 = 0xFFFFE9A7   // bind against unregistered row
  pub let IMP_UNBIND_UNDERFLOW      : u64 = 0xFFFFE9A6   // unbind when count==0
  pub let IMP_UNREGISTER_STALE      : u64 = 0xFFFFE9A5   // unregister of empty row
  pub let IMP_UNREGISTER_HAS_BOUND  : u64 = 0xFFFFE9A4   // unregister while active_session_count>0
  pub let IMP_LOOKUP_NONE           : u64 = 0xFFFFE9A3   // no provider matched
                                                          // (distinguished
                                                          //  return; lookup
                                                          //  can also return
                                                          //  IME_PROVIDER_NONE
                                                          //  = 0 for the same
                                                          //  condition, and
                                                          //  callers should
                                                          //  treat both as
                                                          //  "no match")
  pub let IMP_BAD_SESSION           : u64 = 0xFFFFE9A2   // session_kind_id == 0
  pub let IMP_DECODE_BAD            : u64 = 0xFFFFFFFFFFFFFFFF

  // ==========================================================================
  // SECTION 1.7 -- STATS COUNTER SLOTS
  // ==========================================================================
  //
  // The kernel-side substrate will publish an _provider_kind_stats
  // [u64; 8] table; slot indices are named here so cross-module
  // bumpers agree. REGISTERS vs UNREGISTERS lets a boot-log observer
  // verify the "provider process death is cleaned up" invariant
  // (REGISTERS >= UNREGISTERS; deficit == in-flight providers).

  pub let IMP_ST_REGISTERS   : u64 = 0
  pub let IMP_ST_UNREGISTERS : u64 = 1
  pub let IMP_ST_BINDS       : u64 = 2
  pub let IMP_ST_UNBINDS     : u64 = 3
  pub let IMP_ST_LOOKUPS     : u64 = 4
  pub let IMP_ST_LOOKUP_HITS : u64 = 5
  pub let IMP_ST_QUERY_CAPS  : u64 = 6
  pub let IMP_ST_REFUSED     : u64 = 7
  pub let IMP_ST_MAX         : u64 = 8

  // ==========================================================================
  // SECTION 1.8 -- FINGERPRINT (one line, legacy-suffixed)
  // ==========================================================================
  //
  // pdx_kind_ime_provider_meta: emitted once on successful register by
  // the future router-side substrate. Data-only at this landing per
  // the sibling B8 KIND_IME_SESSION pattern (allowlisted in tools/
  // verify-fingerprint-coverage.sh as "ime provider register ok
  // [legacy: IME PROVIDER REGISTER OK]").
  //
  // Size = 60 bytes (59 chars + trailing NUL), per the tag_size = strlen+1 rule.
  pub let pdx_kind_ime_provider_meta : [u8; 60] = "ime provider register ok [legacy: IME PROVIDER REGISTER OK]\0"

  // Short field-name string constants for future debug-print use
  // (mirrors ime_session_k_commit_seq / tmk_k_lut_id precedent).
  pub let ime_provider_k_row_id : [u8; 7]  = "row_id\0"
  pub let ime_provider_k_lang   : [u8; 5]  = "lang\0"

  // ==========================================================================
  // SECTION 2 -- STATE CELLS
  // ==========================================================================
  //
  // Row pool. IME_PROVIDER_MAX(8) rows * IME_PROVIDER_ROW_BYTES(48) =
  // 384 bytes = 48 u64. Cache-line aligned per surface_commit /
  // selection_owner precedent.

  pub let mut _provider_kind_pool  : [u64; 48] = uninit @align(64)

  // Monotonic register sequence. Bumped by ime_provider_register
  // (before the row is stamped) so every registrant sees a strictly
  // greater registered_seq than its predecessor. Full u64 to foreclose
  // wraparound anxieties.
  pub let mut _provider_kind_seq   : [u64; 1] = uninit @align(64)

  // Per-module stats (IMP_ST_MAX = 8 slots).
  pub let mut _provider_kind_stats : [u64; 8] = uninit @align(64)

  // ==========================================================================
  // SECTION 3 -- COUNTER PRIMITIVES
  // ==========================================================================

  // provider_kind_stats_reset() -> (): zero pool + counters + seq at boot.
  pub let provider_kind_stats_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M2-001 (paideia-os #2315): clear row table + seq + counters at boot. Mirrors selection_owner_stats_reset / ime_session_ (future) reset shape. Two loops (48-word pool, 8-word stats) via low-first index scans; no callee-save pushes needed (leaf; only r10/rcx/rax touched beyond SysV in/out). Labels prefixed provider_kind_prs_.",
      block: {
        lea r10, [rip + _provider_kind_pool];
        xor rax, rax;
        xor rcx, rcx;
      provider_kind_prs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 48;
        jb  provider_kind_prs_rows;

        lea r10, [rip + _provider_kind_seq];
        mov [r10 + 0], rax;

        lea r10, [rip + _provider_kind_stats];
        xor rcx, rcx;
      provider_kind_prs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  provider_kind_prs_stats;
        ret
      }
    }

  // provider_kind_note(which) -> (): bump one stats counter.
  // Encoder-conservative load-inc-store; no add reg,[mem].
  pub let provider_kind_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M2-001 (paideia-os #2315): counter bump. Encoder-conservative load-inc-store; no add reg,[mem]. OOB is a silent no-op. Labels prefixed provider_kind_nt_.",
      block: {
        cmp rdi, 8;
        jae provider_kind_nt_out;
        lea r10, [rip + _provider_kind_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      provider_kind_nt_out:
        ret
      }
    }

  // provider_kind_stat(which) -> u64: read one stats counter.
  pub let provider_kind_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M2-001 (paideia-os #2315): counter read; OOB -> 0. Labels prefixed provider_kind_st_.",
      block: {
        cmp rdi, 8;
        jae provider_kind_st_zero;
        lea r10, [rip + _provider_kind_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      provider_kind_st_zero:
        xor rax, rax;
        ret
      }
    }

  // provider_kind_seq_bump() -> u64: increment _provider_kind_seq and
  // return the NEW value. Encoder-conservative load-inc-store.
  pub let provider_kind_seq_bump : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M2-001 (paideia-os #2315): bump monotonic register seq and return new value. Mirrors selection_owner_seq_bump. Labels prefixed provider_kind_sb_.",
      block: {
        lea r10, [rip + _provider_kind_seq];
        mov rax, [r10 + 0];
        add rax, 1;
        mov [r10 + 0], rax;
        ret
      }
    }

  // ==========================================================================
  // SECTION 4 -- VALIDATORS (pure leaves; small immediates only)
  // ==========================================================================
  //
  // Every validator in this section returns 1 iff its input is well-
  // formed, else 0. Encoder-conservative pattern per surface_commit /
  // kind_tls_trust / session_kind (no `and r11, imm64`, straight-line
  // fast path).

  // provider_kind_lang_valid(lang) -> 1 iff lang <= LANG_MAX(8).
  pub let provider_kind_lang_valid : (u64) -> u64 !{} @{} =
    fn (lang: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G11-M2-001 (paideia-os #2315): 1 iff lang in [0, LANG_MAX=8]. Sealed enum; caller receives IMP_BAD_LANG on refusal. Labels prefixed provider_kind_lv_.",
      block: {
        cmp rdi, 8;
        ja  provider_kind_lv_no;
        mov rax, 1;
        ret;
      provider_kind_lv_no:
        xor rax, rax;
        ret
      }
    }

  // provider_kind_process_valid(process_kind_id) -> 1 iff in (0, 2^32).
  // Non-zero (a 0 process id is the "no provider" sentinel) and
  // u32-bounded (the field is stored in a u32 half of proc_and_lang).
  pub let provider_kind_process_valid : (u64) -> u64 !{} @{} =
    fn (process_kind_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G11-M2-001 (paideia-os #2315): 1 iff process_kind_id in (0, 2^32). Labels prefixed provider_kind_pv_.",
      block: {
        cmp rdi, 0;
        je  provider_kind_pv_no;
        mov rax, rdi;
        shr rax, 32;
        cmp rax, 0;
        jne provider_kind_pv_no;
        mov rax, 1;
        ret;
      provider_kind_pv_no:
        xor rax, rax;
        ret
      }
    }

  // provider_kind_locale_valid(locale_offset) -> 1 iff locale_offset < 2^32.
  // 0 is a legal "unlocaled" value (Latin autocomplete typically
  // registers with 0), so no non-zero requirement here.
  pub let provider_kind_locale_valid : (u64) -> u64 !{} @{} =
    fn (locale_offset: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G11-M2-001 (paideia-os #2315): 1 iff locale_offset < 2^32. 0 is a legal 'unlocaled' value. Labels prefixed provider_kind_locv_.",
