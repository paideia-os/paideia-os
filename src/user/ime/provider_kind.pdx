    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M2-001 (paideia-os #2315): read process_kind_id at row+8[31:0]. OOB / empty row -> 0. One callee-save push (rbx) + retaddr (8) + one nested call (provider_kind_row_valid) = 16 bytes total on entry, rsp%16==0 for the nested call. Labels prefixed provider_kind_qp_.",
