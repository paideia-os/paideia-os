  // ==========================================================================
  // SECTION 8 -- FACTORY + OPS
  // ==========================================================================

  // ime_provider_register(process, lang, locale, caps) -> row_id | IMP_*.
  //
  // The register factory: validate, allocate a row from the pool,
  // stamp header + fields, bump _provider_kind_seq for the row's
  // registered_seq, bump IMP_ST_REGISTERS, return the row_id.
  //
  // Gate order:
  //   (1) process valid    -> IMP_BAD_PROCESS
  //   (2) lang valid       -> IMP_BAD_LANG
  //   (3) locale valid     -> IMP_BAD_LOCALE
  //   (4) caps valid       -> IMP_BAD_CAPS
  //   (5) scan pool for first free row -> IMP_TAIL_ENOSPC
  //   (6) stamp header (in_use=1), proc_and_lang, locale/active=0,
  //       caps, registered_seq (from seq_bump), reserved=0
  //   (7) bump IMP_ST_REGISTERS
  //   (8) return row_id
  //
  // Refusal funnel bumps IMP_ST_REFUSED once at provider_kind_reg_refused.
  //
  // Register plan (six callee-save pushes + sub rsp,8 = 56; entry
  // rsp%16==8 -> 56+8=64 %16==0):
  //   rbx = process_kind_id
  //   r12 = lang
  //   r13 = locale_offset
  //   r14 = caps_bitmap
  //   r15 = row_id (scanned + written)
  //   rbp = registered_seq (from seq_bump; snapshotted before the
  //         final row stamp so a nested note call cannot smear it)
  pub let ime_provider_register : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (process: u64) (lang: u64) (locale: u64) (caps: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M2-001 (paideia-os #2315): register factory. Six callee-save pushes + sub rsp,8 = 56 bytes: entry rsp%16==8, +48+8=56, rsp%16==0 for every nested call (all validators and note are leaves per SysV rbx/r12-r15/rbp preservation). Args stashed BEFORE any nested call: rbx=process, r12=lang, r13=locale, r14=caps, r15 scans / holds row_id, rbp holds registered_seq across the final stamp. Every validator is a leaf using only r10/r11 scratch beyond the SysV in/out contract. Refusal funnel bumps IMP_ST_REFUSED once at provider_kind_reg_refused. Row stamp writes six u64 words directly with `mov [r10+off], rN` (encoder-conservative). Labels prefixed provider_kind_reg_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;
        sub rsp, 8;

        mov rbx, rdi;                       // process
        mov r12, rsi;                       // lang
        mov r13, rdx;                       // locale
        mov r14, rcx;                       // caps

        // (1) process valid
        mov rdi, rbx;
        call provider_kind_process_valid;
        cmp rax, 0;
        je  provider_kind_reg_bad_process;

        // (2) lang valid
        mov rdi, r12;
        call provider_kind_lang_valid;
        cmp rax, 0;
        je  provider_kind_reg_bad_lang;

        // (3) locale valid
        mov rdi, r13;
        call provider_kind_locale_valid;
        cmp rax, 0;
        je  provider_kind_reg_bad_locale;

        // (4) caps valid
        mov rdi, r14;
        call provider_kind_caps_valid;
        cmp rax, 0;
        je  provider_kind_reg_bad_caps;

        // (5) scan pool for first free row (low-first).
        xor r15, r15;                       // idx = 0
      provider_kind_reg_scan:
        cmp r15, 8;
        jae provider_kind_reg_enospc;
        lea r10, [rip + _provider_kind_pool];
        mov r11, r15;
        imul r11, r11, 48;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  provider_kind_reg_claim;
        add r15, 1;
        jmp provider_kind_reg_scan;

      provider_kind_reg_claim:
        // r10 already points at the target row base.
        // Snapshot registered_seq before any nested call that could
        // touch memory ordering.
        call provider_kind_seq_bump;        // preserves rbx/r12-r15/rbp
        mov rbp, rax;                       // rbp = new seq

        // Re-resolve row base (seq_bump did not touch r10 per SysV,
        // but we defensively recompute to keep the stamp code straight).
        lea r10, [rip + _provider_kind_pool];
        mov r11, r15;
        imul r11, r11, 48;
        add r10, r11;

        // Header: in_use = 1 at bit 56.
        mov rax, 1;
        shl rax, 56;
        mov [r10 + 0], rax;

        // proc_and_lang: lang[39:32] | process_kind_id[31:0].
        // Inline the pack instead of a nested call to keep this arm
        // straight-line and avoid a second stash of r10.
        mov rax, rbx;
        shl rax, 32;
        shr rax, 32;                        // rax = process & 0xFFFFFFFF
        mov r11, r12;
        shl r11, 56;
        shr r11, 24;                        // r11 = (lang & 0xFF) << 32
        or  rax, r11;
        mov [r10 + 8], rax;

        // locale_and_active: active_session_count=0 | locale_offset[31:0].
        mov rax, r13;
        shl rax, 32;
        shr rax, 32;
        mov [r10 + 16], rax;

        // caps_and_pad: caps_bitmap[31:0] | 0.
        mov rax, r14;
        shl rax, 32;
        shr rax, 32;
        mov [r10 + 24], rax;

        // registered_seq (full u64).
        mov [r10 + 32], rbp;

        // reserved.
        xor rax, rax;
        mov [r10 + 40], rax;

        // Bump IMP_ST_REGISTERS.
        mov rdi, 0;                         // IMP_ST_REGISTERS
        call provider_kind_note;

        // Return row_id.
        mov rax, r15;
        jmp provider_kind_reg_out;

      provider_kind_reg_bad_process:
        mov rax, 0xFFFFE9AC;                // IMP_BAD_PROCESS
        jmp provider_kind_reg_refused;
      provider_kind_reg_bad_lang:
        mov rax, 0xFFFFE9AD;                // IMP_BAD_LANG
        jmp provider_kind_reg_refused;
      provider_kind_reg_bad_locale:
        mov rax, 0xFFFFE9AB;                // IMP_BAD_LOCALE
        jmp provider_kind_reg_refused;
      provider_kind_reg_bad_caps:
        mov rax, 0xFFFFE9AA;                // IMP_BAD_CAPS
        jmp provider_kind_reg_refused;
      provider_kind_reg_enospc:
        mov rax, 0xFFFFE9AF;                // IMP_TAIL_ENOSPC
        jmp provider_kind_reg_refused;

      provider_kind_reg_refused:
        // Stash refusal code across the note call.
        mov rbp, rax;
        mov rdi, 7;                         // IMP_ST_REFUSED
        call provider_kind_note;
        mov rax, rbp;
        jmp provider_kind_reg_out;

      provider_kind_reg_out:
        add rsp, 8;
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ime_provider_lookup_by_lang(lang) -> row_id | IME_PROVIDER_NONE.
  //
  // Discovery: scan the pool for a row whose in_use bit is set AND
  // whose lang byte matches the requested lang. Returns the FIRST
  // match's row_id (idx into the pool). If multiple providers claim
  // the same lang, the router is expected to disambiguate by
  // registered_seq via a follow-up provider_kind_query_reg_seq call
  // (the "most recently installed provider wins" convention -- see
  // file header for rationale).
  //
  // On miss (or on IMP_BAD_LANG) returns IME_PROVIDER_NONE (= 0).
  // IMP_LOOKUP_NONE (0xFFFFE9A3) is defined for callers that need to
  // distinguish "no match" from "row_id 0" semantically -- both
  // returns mean the same thing today (row_id 0 is a legal row too,
  // but the pool never places a live row at idx 0 unless the router
  // has actually registered one; the caller must NOT interpret a 0
  // return as "provider at slot 0 matched" without a follow-up
  // provider_kind_row_valid(0) check). Router-side callers that
  // want the richer sentinel invoke ime_provider_lookup_by_lang_ex
  // in a future landing.
  //
  // Register plan (two callee-save pushes = 16 bytes; entry rsp%16==8
  // -> 16+8=24, add sub rsp,8 to reach 32 for the nested note call):
  //   rbx = lang
  //   r12 = scan idx
  pub let ime_provider_lookup_by_lang : (u64) -> u64 !{mem} @{} =
    fn (lang: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M2-001 (paideia-os #2315): lookup by lang. Two callee-save pushes + sub rsp,8 = 24 bytes; entry rsp%16==8 -> 24+8=32, %16==0 for every nested call. rbx stashes lang across the note call at the tail; r12 stashes the scan idx. Every gate is a leaf. On miss returns IME_PROVIDER_NONE (=0); IMP_LOOKUP_NONE is the alternative sentinel documented for future callers. Labels prefixed provider_kind_lb_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        mov rbx, rdi;                       // lang

        // Validate lang (silent miss on OOB rather than a distinct
        // sentinel, to keep the caller's fast path a single cmp against 0).
        mov rdi, rbx;
        call provider_kind_lang_valid;
        cmp rax, 0;
        je  provider_kind_lb_miss;

        // Bump IMP_ST_LOOKUPS at entry (both miss and hit paths count).
        mov rdi, 4;                         // IMP_ST_LOOKUPS
        call provider_kind_note;

        // Scan the pool.
        xor r12, r12;
      provider_kind_lb_scan:
        cmp r12, 8;
        jae provider_kind_lb_miss;

        lea r10, [rip + _provider_kind_pool];
        mov r11, r12;
        imul r11, r11, 48;
        add r10, r11;

        // in_use check.
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  provider_kind_lb_next;

        // lang check.
        mov rax, [r10 + 8];
        shr rax, 32;
        and rax, 0xFF;
        cmp rax, rbx;
        je  provider_kind_lb_hit;

      provider_kind_lb_next:
        add r12, 1;
        jmp provider_kind_lb_scan;

      provider_kind_lb_hit:
        // Bump IMP_ST_LOOKUP_HITS.
        mov rdi, 5;                         // IMP_ST_LOOKUP_HITS
        call provider_kind_note;
        mov rax, r12;
        jmp provider_kind_lb_out;

      provider_kind_lb_miss:
        xor rax, rax;                       // IME_PROVIDER_NONE

      provider_kind_lb_out:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ime_provider_bind_session(row_id, session_kind_id) -> IMP_OK | IMP_*.
  //
  // Increment active_session_count on the provider row when the router
  // has just minted a new KIND_IME_SESSION whose provider_kind_id
  // names this row. The session_kind_id argument is NOT stored on the
  // provider row (see file header: active_session_count is a scalar,
  // not a list; the reverse index lives in the session row's
  // provider_kind_id field). It IS validated (nonzero) so the router
  // cannot silently double-count a stale mint.
  //
  // Register plan (three callee-save pushes + sub rsp,8 = 32; entry
  // rsp%16==8 -> 32+8=40 %16==0):
  //   rbx = row_id
  //   r12 = session_kind_id (kept live for future-extension logging;
  //         validated then discarded from the row-write path today)
  //   r13 = row base pointer
  pub let ime_provider_bind_session : (u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64) (session_kind_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M2-001 (paideia-os #2315): increment active_session_count on the provider row. Three callee-save pushes = 24 bytes on top of the entry retaddr; entry rsp%16==8 -> after three pushes rsp%16 == (8-24) mod 16 == 0, no padding sub needed for nested calls (odd-push-count keeps SysV alignment on its own). Refusal funnel at provider_kind_bind_refused. Row bump is a 32-bit RMW on the top half of the [+16] word: load full u64, extract count, add 1, repack, store. Labels prefixed provider_kind_bind_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                       // row_id
        mov r12, rsi;                       // session_kind_id

        // (1) session_kind_id valid.
        mov rdi, r12;
        call provider_kind_session_valid;
        cmp rax, 0;
        je  provider_kind_bind_bad_session;

        // (2) row_id valid + in_use.
        mov rdi, rbx;
        call provider_kind_row_valid;
        cmp rax, 0;
        je  provider_kind_bind_stale;

        // Row base -> r13.
        mov rdi, rbx;
        call provider_kind_slot;
        mov r13, rax;

        // Increment active_session_count (top half of [+16] word).
        mov rax, [r13 + 16];
        mov r10, rax;                       // r10 keeps the full word
        shr rax, 32;                        // rax = count
        add rax, 1;
        shl rax, 32;                        // rax = new count << 32
        // r10 low 32 bits carry locale_offset.
        mov r11, r10;
        shl r11, 32;
        shr r11, 32;                        // r11 = locale_offset
        or  rax, r11;
        mov [r13 + 16], rax;

        // Bump IMP_ST_BINDS.
        mov rdi, 2;                         // IMP_ST_BINDS
        call provider_kind_note;

        xor rax, rax;                       // IMP_OK
        jmp provider_kind_bind_out;

      provider_kind_bind_bad_session:
        mov rax, 0xFFFFE9A2;                // IMP_BAD_SESSION
        jmp provider_kind_bind_refused;
      provider_kind_bind_stale:
        mov rax, 0xFFFFE9A7;                // IMP_BIND_STALE
        jmp provider_kind_bind_refused;

      provider_kind_bind_refused:
        mov r13, rax;                       // stash code
        mov rdi, 7;                         // IMP_ST_REFUSED
        call provider_kind_note;
        mov rax, r13;

      provider_kind_bind_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ime_provider_unbind_session(row_id, session_kind_id) -> IMP_OK | IMP_*.
  //
  // Decrement active_session_count. Refuses to underflow: if the
  // count is already 0, returns IMP_UNBIND_UNDERFLOW (a router bug --
  // an unbind was called for a session that was never bound).
  pub let ime_provider_unbind_session : (u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64) (session_kind_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M2-001 (paideia-os #2315): decrement active_session_count with underflow guard. Same three-push prologue as bind (24 bytes total; entry rsp%16==8 -> after rsp%16==0, odd-push-count keeps SysV alignment without a padding sub). Refusal funnel at provider_kind_unbind_refused. Labels prefixed provider_kind_unbind_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                       // row_id
        mov r12, rsi;                       // session_kind_id

        // (1) session valid.
        mov rdi, r12;
        call provider_kind_session_valid;
        cmp rax, 0;
        je  provider_kind_unbind_bad_session;

        // (2) row valid.
        mov rdi, rbx;
        call provider_kind_row_valid;
        cmp rax, 0;
        je  provider_kind_unbind_stale;

        // Row base -> r13.
        mov rdi, rbx;
        call provider_kind_slot;
        mov r13, rax;

        // Load current word, extract count, refuse underflow.
        mov rax, [r13 + 16];
        mov r10, rax;
        shr rax, 32;                        // rax = count
        cmp rax, 0;
        je  provider_kind_unbind_underflow;
        sub rax, 1;
        shl rax, 32;                        // rax = new count << 32
        mov r11, r10;
        shl r11, 32;
        shr r11, 32;                        // r11 = locale_offset
        or  rax, r11;
        mov [r13 + 16], rax;

        // Bump IMP_ST_UNBINDS.
        mov rdi, 3;                         // IMP_ST_UNBINDS
        call provider_kind_note;

        xor rax, rax;                       // IMP_OK
        jmp provider_kind_unbind_out;

      provider_kind_unbind_bad_session:
        mov rax, 0xFFFFE9A2;                // IMP_BAD_SESSION
        jmp provider_kind_unbind_refused;
      provider_kind_unbind_stale:
        mov rax, 0xFFFFE9A7;                // IMP_BIND_STALE
        jmp provider_kind_unbind_refused;
      provider_kind_unbind_underflow:
        mov rax, 0xFFFFE9A6;                // IMP_UNBIND_UNDERFLOW
        jmp provider_kind_unbind_refused;

      provider_kind_unbind_refused:
        mov r13, rax;
        mov rdi, 7;                         // IMP_ST_REFUSED
        call provider_kind_note;
        mov rax, r13;

      provider_kind_unbind_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ime_provider_query_caps(row_id) -> caps_bitmap | 0.
  //
  // OOB or empty row -> 0 (an empty row has zero caps; a valid row
  // typically advertises at least IMP_CAP_PREEDIT). Callers that
  // need to disambiguate "empty row" from "provider advertises 0
  // caps" call provider_kind_row_valid first.
  pub let ime_provider_query_caps : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M2-001 (paideia-os #2315): read caps_bitmap at row+24[31:0]. Bumps IMP_ST_QUERY_CAPS on any call (hit or miss). One callee-save push = 8 bytes; entry rsp%16==8 -> after push rsp%16==0, no padding sub needed for nested calls (odd-push-count keeps SysV alignment on its own). Labels prefixed provider_kind_qc_.",
      block: {
        push rbx;

        mov rbx, rdi;

        // Bump IMP_ST_QUERY_CAPS regardless of outcome.
        mov rdi, 6;                         // IMP_ST_QUERY_CAPS
        call provider_kind_note;

        mov rdi, rbx;
        call provider_kind_row_valid;
        cmp rax, 0;
        je  provider_kind_qc_zero;
        mov rdi, rbx;
        call provider_kind_slot;
        mov rax, [rax + 24];
        and rax, 0xFFFFFFFF;
        jmp provider_kind_qc_out;
      provider_kind_qc_zero:
        xor rax, rax;
      provider_kind_qc_out:
        pop rbx;
        ret
      }
    }

  // ime_provider_unregister(row_id) -> IMP_OK | IMP_*.
  //
  // Return the row to the free list. Refuses to unregister a row
  // that still has bound sessions (active_session_count > 0) --
  // the router must rebind or revoke all bound sessions BEFORE
  // calling unregister (see file header for the provider-death
  // cascade rationale).
  //
  // Contract: on OK, header is zeroed (in_use cleared, revoked bit
  // stays at 0 for the "not linear cap" family), and all six row
  // words are zeroed so a later register into the same slot starts
  // from a clean state.
  pub let ime_provider_unregister : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M2-001 (paideia-os #2315): row-free with bound-session guard. Two callee-save pushes + sub rsp,8 = 24 bytes; entry rsp%16==8 -> 24+8=32 %16==0 for nested calls. Refuses IMP_UNREGISTER_STALE on empty row; IMP_UNREGISTER_HAS_BOUND if active_session_count > 0. On OK, zeroes all six u64 words of the row and bumps IMP_ST_UNREGISTERS. Labels prefixed provider_kind_unreg_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        mov rbx, rdi;                       // row_id

        // (1) row valid + in_use.
        mov rdi, rbx;
        call provider_kind_row_valid;
        cmp rax, 0;
        je  provider_kind_unreg_stale;

        // Row base -> r12.
        mov rdi, rbx;
        call provider_kind_slot;
        mov r12, rax;

        // (2) refuse if active_session_count > 0.
        mov rax, [r12 + 16];
        shr rax, 32;
        cmp rax, 0;
        jne provider_kind_unreg_has_bound;

        // Zero all six words.
        xor rax, rax;
        mov [r12 + 0],  rax;
        mov [r12 + 8],  rax;
        mov [r12 + 16], rax;
        mov [r12 + 24], rax;
        mov [r12 + 32], rax;
        mov [r12 + 40], rax;

        // Bump IMP_ST_UNREGISTERS.
        mov rdi, 1;                         // IMP_ST_UNREGISTERS
        call provider_kind_note;

        xor rax, rax;                       // IMP_OK
        jmp provider_kind_unreg_out;

      provider_kind_unreg_stale:
        mov rax, 0xFFFFE9A5;                // IMP_UNREGISTER_STALE
        jmp provider_kind_unreg_refused;
      provider_kind_unreg_has_bound:
        mov rax, 0xFFFFE9A4;                // IMP_UNREGISTER_HAS_BOUND
        jmp provider_kind_unreg_refused;

      provider_kind_unreg_refused:
        mov r12, rax;
        mov rdi, 7;                         // IMP_ST_REFUSED
        call provider_kind_note;
        mov rax, r12;

      provider_kind_unreg_out:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }
}
