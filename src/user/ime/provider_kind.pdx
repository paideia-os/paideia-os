    fn (caps_bitmap: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G11-M2-001 (paideia-os #2315): subset test against IMP_CAP_ALL (0x0F). Small immediate. Labels prefixed provider_kind_cv_.",
