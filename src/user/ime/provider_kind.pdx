        call provider_kind_slot;
        mov rax, [rax + 8];
        and rax, 0xFFFFFFFF;
        jmp provider_kind_qp_out;
      provider_kind_qp_zero:
        xor rax, rax;
      provider_kind_qp_out:
        pop rbx;
        ret
      }
    }

