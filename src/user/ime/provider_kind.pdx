    fn (locale_offset: u64) (active_session_count: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G11-M2-001 (paideia-os #2315): pack active_session_count[63:32] | locale_offset[31:0] per row layout at [+16]. Encoder-conservative build of 32-bit mask via shl+shr. Straight-line.",
      block: {
        mov rax, rdi;
        shl rax, 32;
        shr rax, 32;

        mov r10, rsi;
        shl r10, 32;

        or  rax, r10;
        ret
      }
    }

  // provider_kind_caps_pack(caps_bitmap)
  //   -> caps_bitmap[31:0] | reserved[63:32]=0. Row-write helper for [+24].
  pub let provider_kind_caps_pack : (u64) -> u64 !{} @{} =
    fn (caps_bitmap: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G11-M2-001 (paideia-os #2315): pack caps_bitmap[31:0] with reserved[63:32]=0 per row layout at [+24]. Encoder-conservative 32-bit mask via shl+shr.",
      block: {
        mov rax, rdi;
        shl rax, 32;
        shr rax, 32;
        ret
      }
    }

  // ==========================================================================
  // SECTION 7 -- ROW-FIELD QUERY HELPERS
  // ==========================================================================
  //
  // Every read-side accessor validates row idx first via
  // provider_kind_row_valid, then extracts the field. An accessor on
  // an empty / OOB row returns 0.

  // provider_kind_query_process(row_id) -> process_kind_id | 0.
