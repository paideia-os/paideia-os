  // ==========================================================================
  // SECTION 5 -- ROW-POOL ADDRESSING
  // ==========================================================================

  // provider_kind_slot(idx) -> &_provider_kind_pool[idx*48].
  // No bounds check by policy -- mirrors vnode_pool.pdx vnode_slot,
  // caller validates idx first via provider_kind_row_valid or
  // register's own bounded scan. Uses imul r,r,48 per the encoder-
  // OK three-operand shape (imm8 fits sign-extended; clipboard.pdx
  // uses the same idiom with 40).
  pub let provider_kind_slot : (u64) -> u64 !{} @{} =
    fn (idx: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G11-M2-001 (paideia-os #2315): &_provider_kind_pool[idx*48]. imul r,r,imm8 form (mirrors clipboard.pdx's imul r11,r11,40). No bounds check by policy. Labels prefixed provider_kind_ps_.",
      block: {
        lea rax, [rip + _provider_kind_pool];
        imul rdi, rdi, 48;
        add rax, rdi;
        ret
      }
    }

  // provider_kind_row_valid(idx) -> 1 iff idx < IME_PROVIDER_MAX and
  // in_use byte is set. Inlined address compute (no nested call);
  // mirrors tui_canvas_row_valid.
  pub let provider_kind_row_valid : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M2-001 (paideia-os #2315): 1 iff idx < IME_PROVIDER_MAX(8) and in_use set. Inlined address compute (idx*48 via imul r,r,imm8) rather than nested call to provider_kind_slot, keeping this a pure leaf. Labels prefixed provider_kind_rv2_.",
      block: {
        cmp rdi, 8;
        jae provider_kind_rv2_no;
        lea r10, [rip + _provider_kind_pool];
        mov r11, rdi;
        imul r11, r11, 48;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  provider_kind_rv2_no;
        mov rax, 1;
        ret;
      provider_kind_rv2_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // SECTION 6 -- PACKERS (row-write helpers)
  // ==========================================================================

  // provider_kind_hdr_pack() -> canonical header at register time.
  // Only tail_alloc sets in_use (bit 56); everything else stays 0.
  pub let provider_kind_hdr_pack : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "G11-M2-001 (paideia-os #2315): canonical row header (in_use = 1 stamped by register's own tail claim; this helper returns the pre-stamp shape = 0). Mirror of session_kind's ime_session_hdr_pack.",
      block: {
        xor rax, rax;
        ret
      }
    }

  // provider_kind_proc_lang_pack(process_kind_id, lang)
  //   -> lang[39:32] | process_kind_id[31:0]. Both halves masked.
  // Row-write helper for proc_and_lang at [+8].
  pub let provider_kind_proc_lang_pack : (u64, u64) -> u64 !{} @{} =
    fn (process_kind_id: u64) (lang: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G11-M2-001 (paideia-os #2315): pack lang[39:32] | process_kind_id[31:0] per row layout at [+8]. Encoder-conservative build of 32-bit mask via shl+shr; lang byte masked via shl 56 / shr 24. Straight-line, no labels needed.",
      block: {
