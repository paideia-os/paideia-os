// src/user/ime/latin_autocomplete.pdx -- G11-M4-001 (paideia-os #2317)
//
// LATIN AUTOCOMPLETE IME PROVIDER SATELLITE.
//
// A userspace IME provider process that registers with the KIND_IME_
// PROVIDER substrate (§2.19, sibling landing #2315, LANDED B10) under
// LANG_LATIN and services Latin-script autocomplete: the user types a
// prefix (keystroke-by-keystroke), an n-gram frequency table returns
// the top candidates for that prefix, a candidate window (drawn by the
// compositor when the router forwards the preedit state to the bound
// KIND_IME_SESSION -- §2.18, sibling landing #2314) lets the user
// pick one with the arrow keys or the space bar, and a commit event
// finalizes the selected candidate into the target text field via the
// session's COMMIT_TEXT op.
//
// This module owns the ENGINE-SIDE state (prefix + candidate list +
// n-gram table pointer + statistics) and the four keyboard-facing
// operations (on_key, commit_selected, cycle_candidate, cancel). It
// registers itself as a provider at init time and stores the resulting
// KIND_IME_PROVIDER row_id in its own state cell so future ops can
// name the row when the router asks "which provider is servicing this
// session?" (router-side bind/unbind is out of scope for THIS landing;
// #2316 KIND_IME_ROUTER wires the bind cycle).
//
// Design authority:
//   * design/compositor/pwp-spec-vocabulary.md §2.19 KIND_IME_PROVIDER
//     -- names Latin autocomplete as one of the seven canonical
//     provider families (Latin, Pinyin, Zhuyin, Kana, Hangul,
//     Devanagari, InScript). This landing implements the first of the
//     seven; the CJK/Indic siblings land in later G11.M4 rows.
//   * src/user/ime/provider_kind.pdx §1.3 (LANG_LATIN = 0) -- the
//     enum slot this file's registration uses.
//   * src/user/ime/session_kind.pdx §1.3 (COMMIT_TEXT op semantics) --
//     the router-side commit path this file's commit_selected feeds.
//
// LATIN-SPECIFIC RATIONALE. Latin script is the simplest of the IME
// families this module lives among: no phonetic-to-glyph mapping, no
// stroke decomposition, no RTL shaping, no segmentation. The engine's
// only job is prefix->completion prediction, which is a straight
// n-gram lookup over a frequency-sorted word table. That simplicity
// is why Latin lands FIRST in G11.M4 -- the schema this file
// establishes (engine cell + factory + four keystroke ops) becomes
// the template that the CJK/Indic siblings extend with their own
// script-specific state (Pinyin adds a syllable buffer; Kana adds a
// romaji-to-kana table; Hangul adds a jamo-to-syllable composer; ...).
//
// SCHEMA-ONLY N-GRAM LOOKUP. The n-gram frequency table is passed in
// as an opaque pointer at init time; its layout is defined by the
// caller (the satellite process's own dictionary provisioner) and is
// NOT interpreted by this file's assembly. The on_key body bumps the
// key-event stats counter and updates the prefix field IN PLACE; the
// actual n-gram scan that populates candidates_offset lands with a
// future substrate milestone that wires the interned string pool
// (the router-side preedit pool named at session_kind.pdx §1.3 line
// [+24]). Until that substrate lands, candidates_offset stays 0 and
// candidate_count stays 0 -- the engine cell truthfully reflects
// "no predictions available yet" rather than fabricating a candidate
// list from thin air. The commit_selected / cycle_candidate bodies
// are structurally correct (they update the row honestly and bump
// stats) but only bite once the n-gram scan populates the candidate
// list.
//
// PER-PROCESS SATELLITE. One instance of this engine per satellite
// process (a paideia-os machine typically runs one Latin autocomplete
// process; multi-process is legal but unusual -- e.g. a user with two
// keyboard layouts might run two Latin engines with different
// dictionaries). The engine cell is CALLER-OWNED (the satellite
// process allocates it on its stack or in .bss and passes the
// pointer into every op); this file does NOT hold a module singleton
// because that would foreclose the multi-engine case without
// substantive benefit. Same pattern as focus_router.pdx's
// FocusRouterState (per-seat cell, caller-owned).
//
// LATIN AUTOCOMPLETE ENGINE STRUCT. The natural typing is
//
//   struct LatinAutocompleteEngine {
//     provider_kind_id: u32,       // row_id returned by ime_provider_register
//     ngram_count: u32,             // number of rows in the n-gram table
//     ngram_table_ptr: u64,         // opaque pointer, caller-defined layout
//     current_prefix_offset: u32,   // interned string; user's typed prefix
//     candidates_offset: u32,       // interned array of top candidates (u32[])
//     candidate_count: u8,          // 0..LA_CANDIDATE_MAX (8)
//     selected_candidate: u8,       // 0..candidate_count-1
//     reserved: [u8; 6]
//   }
//
// but paideia-as does not currently return structs by value from asm
// bodies (mirrors sig-compat note at src/user/input_server/main.pdx
// §456 and src/user/input_server/focus_router.pdx §254), so the
// wire-level shape is a 32-byte caller-owned cell that this file
// populates in place via fixed-offset word writes. Callers read fields
// via the getters below once LA_OK is returned. The struct declaration
// below is DOCUMENTATION ONLY (mirrors FocusRouterState /
// InputServerFields precedent).
//
// LABEL PREFIX. `latin_autocomplete_` throughout, sidestepping
// paideia-as reserved-word collisions (see
// feedback_paideia_as_reserved_labels). Every ASM jump target is
// `latin_autocomplete_<funcname>_<tag>` to avoid the same class.
//
// MECE SCOPE. Single file under src/user/ime/. Touches only:
//   * NEW: src/user/ime/latin_autocomplete.pdx (this file)
//   * EDIT: tools/verify-fingerprint-coverage.sh (add allowlist entry
//           for pdx_kind_latin_autocomplete_meta since the router-
//           side dispatcher that would emit it is a future landing)
// No other file is modified.
//
// FAILURE BAND REBASE. The row prompt named 0xFFFFEDC0..0xFFFFEDCF as
// this file's failure band. Grep-verify at landing time showed that
// band FULLY OCCUPIED by src/kernel/core/drivers/vk/swapchain.pdx's
// VSWC_ERR_* codes (VSWC_ERR_BAD_SURFACE = 0xFFFFEDCF,
// VSWC_ERR_BAD_MODE = 0xFFFFEDCE, VSWC_ERR_BAD_COUNT = 0xFFFFEDCD,
// down through VSWC_ERR_RESIZE = 0xFFFFEDC5; the whole 16-slot page is
// claimed). Rebased to 0xFFFFE7A0..0xFFFFE7AF, which grep-verify
// confirms is a fully clean 16-slot page (zero occurrences across
// src/ + tests/ + design/ as of this landing). The 0xFFFFE7 family is
// otherwise completely empty at this landing (0xFFFFE7B0..0xFFFFE7FF
// also clean), which leaves substantial headroom for the sibling
// G11.M4 provider landings (CJK Zh, CJK Ja, CJK Ko, Indic Hi, ...)
// that will homestead nearby pages.
//
// FINGERPRINT. One legacy-suffixed init fingerprint per the standard
// klog convention (matches session_kind / provider_kind precedent).
// Emitted once on successful engine init by the future satellite-side
// substrate that wires the engine into a satellite-process main loop;
// no fingerprint on the on_key / commit / cycle / cancel paths (those
// fire per keystroke in an interactive session and would flood the
// ring, same rationale as tag_tty_read_ok / tag_sys_taskinfo_ok in
// keys.pdx). Until the substrate lands, the tag is DATA-ONLY (declared
// here but not emitted from any body) -- verify-fingerprint-coverage.
// sh gets a matching allowlist entry per the sibling B8/B10 pattern.
//
// Encoder-conservative pattern per session_kind / provider_kind:
// no `and reg, imm64`, no MOVABS r64,imm64, no `test`, no `add reg,
// [mem]`, no `mov_bzx`/`mov_wzx`; 32-bit zero-extension via shl+shr.
// Small immediates only.
//
// =============================================================================

module LatinAutocomplete = structure {

  // ==========================================================================
  // SECTION 1.1 -- PROVIDER-FAMILY PINS (mirror of ProviderKind)
  // ==========================================================================
  //
  // Named locally so the assembly bodies can use small immediates
  // rather than cross-module symbol references. Each pin is asserted
  // in a comment against its source of truth so a future edit to the
  // sibling module cannot silently drift.

  // Mirror of ProviderKind.LANG_LATIN (= 0). Latin autocomplete's
  // sealed-enum slot; provider_kind_lang_valid admits 0..LANG_MAX=8.
  pub let LA_LANG_LATIN            : u64 = 0

  // Mirror of ProviderKind.IME_PROVIDER_LOCALE_UNLOCALED (= 0).
  // Latin autocomplete registers unlocaled: the same engine services
  // en-US, en-GB, fr-FR, de-DE, ... (locale-specific dictionaries
  // are the responsibility of the ngram_table_ptr the caller passes
  // at init time, not of the provider registration itself).
  pub let LA_LOCALE_UNLOCALED      : u64 = 0

  // Mirror of ProviderKind.IMP_CAP_PREEDIT (0x01) | IMP_CAP_CANDIDATE_
  // WINDOW (0x02). Latin autocomplete supports preedit strings (the
  // user sees ghost text as they type) and draws a candidate window
  // (the top-N completions the user can cycle through). Does NOT
  // advertise IMP_CAP_PHONETIC or IMP_CAP_STROKE_INPUT (those are
  // for CJK/Indic siblings).
  pub let LA_CAPS_DEFAULT          : u64 = 0x03

  // ==========================================================================
  // SECTION 1.2 -- ENGINE CELL LAYOUT (LatinAutocompleteEngine, 32 bytes)
  // ==========================================================================
  //
  // Four u64 words holding the engine's per-instance state. Every
  // mutating op edits one packed field IN PLACE; the row is written
  // by exactly one thread at a time (the satellite process's own
  // event loop is single-threaded per engine instance, mirroring the
  // per-seat single-thread invariant of focus_router).
  //
  // Cell layout (offsets in bytes):
  //
  //   [+0]  provider_and_ngram_count:
  //             provider_kind_id[31:0]  row_id returned by
  //                                     ime_provider_register at init
  //                                     time. Nonzero after successful
  //                                     init; 0 before init or after
  //                                     a future unregister (out of
  //                                     scope for this landing).
  //             ngram_count[63:32]      number of rows in the n-gram
  //                                     table. Layout of a row is
  //                                     caller-defined; typically a
  //                                     packed (word_offset:u32,
  //                                     freq:u32) tuple but this file
  //                                     does not depend on that.
  //
  //   [+8]  ngram_table_ptr: u64
  //             pointer to the n-gram frequency table. Full u64 (the
  //             table typically lives in the satellite process's own
  //             .data or in a shared read-only mapping). Nonzero after
  //             successful init.
  //
  //   [+16] prefix_and_candidates:
  //             current_prefix_offset[31:0]  interned string offset
  //                                          into the satellite-side
  //                                          preedit pool; the prefix
  //                                          the user has typed so far.
  //                                          0 = empty prefix (no
  //                                          composition in flight).
  //             candidates_offset[63:32]     interned-array offset into
  //                                          the satellite-side
  //                                          candidate pool; base of a
  //                                          u32[candidate_count] array
  //                                          each entry of which is the
  //                                          interned string offset of
  //                                          one completion. 0 = no
  //                                          candidates yet (the
  //                                          n-gram scan has not run
  //                                          this composition round).
  //
  //   [+24] counts_and_reserved:
  //             candidate_count[7:0]         0..LA_CANDIDATE_MAX (8)
  //             selected_candidate[15:8]     0..candidate_count-1;
  //                                          undefined when count == 0
  //             reserved[63:16]              0 at init; future flags
  //                                          (input-mode, script-shape
  //                                          hint) land here
  //
  // Cell is 32 bytes = one half of a 64-byte cache line. Cache-line
  // alignment is CALLER'S responsibility (allocate the cell at a
  // 32-byte-aligned address); this file's getters/setters use only
  // byte offsets and do not depend on the alignment.
  //
  // Documentation-only struct declaration (mirrors FocusRouterState).

  // NOTE. The struct below omits the six trailing reserved bytes of
  // the counts word ([63:16] of cell[+24]); paideia-as struct-field
  // syntax accepts u8 / u32 / u64 scalars but not `[u8; N]` arrays
  // (verified across every struct declared in src/user/**; see the
  // FocusRouterState / InputServerFields / ImplicitGrab / TakeoverEvent
  // / RecoveryConsoleState precedent). The reserved bytes are covered
  // by the cell layout comment above and by the `reserved[63:16]`
  // sub-field notation there, not by a struct member.
  struct LatinAutocompleteEngine {
    provider_kind_id: u32,
    ngram_count: u32,
    ngram_table_ptr: u64,
    current_prefix_offset: u32,
    candidates_offset: u32,
    candidate_count: u8,
    selected_candidate: u8
  }

  pub let LA_CELL_BYTES            : u64 = 32
  pub let LA_CELL_OFF_PROVIDER_NG  : u64 = 0
  pub let LA_CELL_OFF_NGRAM_PTR    : u64 = 8
  pub let LA_CELL_OFF_PREFIX_CAND  : u64 = 16
  pub let LA_CELL_OFF_COUNTS       : u64 = 24

  // Sub-word bit positions for LA_CELL_OFF_COUNTS:
  //   candidate_count     bits [7:0]
  //   selected_candidate  bits [15:8]
  pub let LA_COUNTS_SEL_SHIFT      : u64 = 8

  // Ceiling on the candidate list. Eight completions is a conventional
  // IME candidate-window depth (matches ibus/fcitx defaults and the
  // Windows Latin autocomplete popover). A larger list rarely helps
  // the user (past 8 the eye scans slower than typing the whole word)
  // and would grow the row past the 32-byte cell budget if the list
  // were stored inline (it is stored via candidates_offset, so the
  // ceiling is a stats-side constraint, not a layout one).
  pub let LA_CANDIDATE_MAX         : u64 = 8

  // Empty-prefix / empty-candidates sentinel (mirrors
  // IME_SESSION_PREEDIT_EMPTY): offset 0 in the satellite-side pool
  // is reserved for the empty string.
  pub let LA_PREFIX_EMPTY          : u64 = 0
  pub let LA_CANDIDATES_EMPTY      : u64 = 0

  // ==========================================================================
  // SECTION 1.3 -- FAILURE TAXONOMY (0xFFFFE7A0..0xFFFFE7AF)
  // ==========================================================================
  //
  // Fresh 16-wide band. Rebased from the row prompt's 0xFFFFEDC0..EDCF
  // (FULLY OCCUPIED by src/kernel/core/drivers/vk/swapchain.pdx's
  // VSWC_ERR_* codes -- see file header). Grep-verified free across
  // src/ + tests/ + design/ at landing time.

  pub let LA_OK                    : u64 = 0
  pub let LA_ENGINE_NULL           : u64 = 0xFFFFE7AF  // engine_ptr == 0
  pub let LA_PROCESS_NULL          : u64 = 0xFFFFE7AE  // process_kind_id == 0
  pub let LA_NGRAM_NULL            : u64 = 0xFFFFE7AD  // ngram_table_ptr == 0
  pub let LA_NGRAM_EMPTY           : u64 = 0xFFFFE7AC  // ngram_count == 0
  pub let LA_ALREADY_INIT          : u64 = 0xFFFFE7AB  // engine already initialized
  pub let LA_NOT_INIT              : u64 = 0xFFFFE7AA  // op before init succeeded
  pub let LA_REGISTER_REFUSED      : u64 = 0xFFFFE7A9  // ime_provider_register
                                                        // returned refusal sentinel;
                                                        // the specific reason is on
                                                        // the wire from that call
  pub let LA_NO_CANDIDATES         : u64 = 0xFFFFE7A8  // commit/cycle with count==0
  pub let LA_BAD_SELECTED          : u64 = 0xFFFFE7A7  // selected_candidate >= count
  pub let LA_BAD_KEYCODE           : u64 = 0xFFFFE7A6  // keycode outside u32 range
                                                        // (upper 32 bits set); future
                                                        // key-domain validators may
                                                        // narrow this further
  // Slots 0xFFFFE7A5..0xFFFFE7A0 are RESERVED within this file's band
  // for future extension (n-gram-table validators, interned-pool
  // failures once the substrate lands).

  // ==========================================================================
  // SECTION 1.4 -- STATS COUNTER SLOTS
  // ==========================================================================
  //
  // Six named slots in the _latin_autocomplete_stats [u64; 8] cell.
  // A boot-log observer can verify KEY_EVENTS >= COMMITS + CANCELS
  // (each commit and each cancel consumes at least one prior key
  // event, so this deficit is always non-negative in a healthy run).

  pub let LA_ST_KEY_EVENTS         : u64 = 0
  pub let LA_ST_COMMITS            : u64 = 1
  pub let LA_ST_CYCLES             : u64 = 2
  pub let LA_ST_CANCELS            : u64 = 3
  pub let LA_ST_INITS              : u64 = 4
  pub let LA_ST_REFUSED            : u64 = 5
  pub let LA_ST_MAX                : u64 = 6

  // ==========================================================================
  // SECTION 1.5 -- FINGERPRINT (one line, legacy-suffixed)
  // ==========================================================================
  //
  // pdx_kind_latin_autocomplete_meta: emitted once on successful engine
  // init by the future satellite-side substrate. Data-only at this
  // landing per the sibling B8 KIND_IME_SESSION / B10 KIND_IME_PROVIDER
  // pattern (allowlisted in tools/verify-fingerprint-coverage.sh as
  // "latin autocomplete init ok [legacy: LATIN AUTOCOMPLETE INIT OK]").
  //
  // Byte count: 63 content chars + 1 NUL = 64.
  pub let pdx_kind_latin_autocomplete_meta : [u8; 64] = "latin autocomplete init ok [legacy: LATIN AUTOCOMPLETE INIT OK]\0"

  // Short field-name string constants for future debug-print use
  // (mirror ime_provider_k_row_id / ime_session_k_commit_seq precedent).
  pub let latin_autocomplete_k_provider_id : [u8; 12] = "provider_id\0"
  pub let latin_autocomplete_k_prefix      : [u8; 7]  = "prefix\0"

  // ==========================================================================
  // SECTION 2 -- STATS CELL
  // ==========================================================================
  //
  // Module-level counters shared across every engine instance in this
  // process (typically one, occasionally two -- see file header).
  // Mirrors _provider_kind_stats layout.

  pub let mut _latin_autocomplete_stats : [u64; 8] = uninit @align(64)

  // ==========================================================================
  // SECTION 3 -- COUNTER PRIMITIVES
  // ==========================================================================

  // latin_autocomplete_stats_reset() -> (): zero counters at boot.
  pub let latin_autocomplete_stats_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-001 (paideia-os #2317): clear per-module counters at boot. Mirrors provider_kind_stats_reset. Single low-first index scan over 8 u64 slots via load-inc-store; no callee-save pushes (leaf; only r10/rcx/rax touched beyond SysV in/out). Labels prefixed latin_autocomplete_srs_.",
      block: {
        lea r10, [rip + _latin_autocomplete_stats];
        xor rax, rax;
        xor rcx, rcx;
      latin_autocomplete_srs_loop:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  latin_autocomplete_srs_loop;
        ret
      }
    }

  // latin_autocomplete_note(which) -> (): bump one stats counter.
  // Encoder-conservative load-inc-store; OOB is a silent no-op.
  pub let latin_autocomplete_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-001 (paideia-os #2317): counter bump. Encoder-conservative load-inc-store; no add reg,[mem]. OOB is a silent no-op. Mirrors provider_kind_note. Labels prefixed latin_autocomplete_nt_.",
      block: {
        cmp rdi, 8;
        jae latin_autocomplete_nt_out;
        lea r10, [rip + _latin_autocomplete_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      latin_autocomplete_nt_out:
        ret
      }
    }

  // latin_autocomplete_stat(which) -> u64: read one stats counter.
  pub let latin_autocomplete_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-001 (paideia-os #2317): counter read; OOB -> 0. Labels prefixed latin_autocomplete_st_.",
      block: {
        cmp rdi, 8;
        jae latin_autocomplete_st_zero;
        lea r10, [rip + _latin_autocomplete_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      latin_autocomplete_st_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // SECTION 4 -- VALIDATORS (pure leaves)
  // ==========================================================================

  // latin_autocomplete_keycode_valid(keycode) -> 1 iff keycode < 2^32.
  // Widened later when a HID keymap validator lands; today the only
  // gate is "fits in the u32 half of a future packed word".
  pub let latin_autocomplete_keycode_valid : (u64) -> u64 !{} @{} =
    fn (keycode: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G11-M4-001 (paideia-os #2317): 1 iff keycode < 2^32. Encoder-conservative 32-bit range test via shl+shr. Labels prefixed latin_autocomplete_kv_.",
      block: {
        mov rax, rdi;
        shr rax, 32;
        cmp rax, 0;
        jne latin_autocomplete_kv_no;
        mov rax, 1;
        ret;
      latin_autocomplete_kv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // SECTION 5 -- CELL-FIELD GETTERS (RIGHT_QUERY_STATE-shaped surface)
  // ==========================================================================
  //
  // Every getter takes the engine_ptr in rdi and returns the requested
  // field in rax. A null engine_ptr is undefined behavior at the getter
  // level (callers that need the safe form check engine_ptr != 0 first);
  // this matches focus_router_get_* / input_server_get_* precedent.

  pub let latin_autocomplete_get_provider_id : (u64) -> u64 !{mem} @{} =
    fn (engine_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-001 (paideia-os #2317): read provider_kind_id from cell[+0][31:0]. Zero-extension via shl+shr. Labels prefixed latin_autocomplete_gpi_.",
      block: {
        mov rax, [rdi + 0];
        shl rax, 32;
        shr rax, 32;
        ret
      }
    }

  pub let latin_autocomplete_get_ngram_count : (u64) -> u64 !{mem} @{} =
    fn (engine_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-001 (paideia-os #2317): read ngram_count from cell[+0][63:32]. Labels prefixed latin_autocomplete_gnc_.",
      block: {
        mov rax, [rdi + 0];
        shr rax, 32;
        ret
      }
    }

  pub let latin_autocomplete_get_ngram_ptr : (u64) -> u64 !{mem} @{} =
    fn (engine_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-001 (paideia-os #2317): read ngram_table_ptr from cell[+8] (full u64). Labels prefixed latin_autocomplete_gnp_.",
      block: {
        mov rax, [rdi + 8];
        ret
      }
    }

  pub let latin_autocomplete_get_prefix : (u64) -> u64 !{mem} @{} =
    fn (engine_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-001 (paideia-os #2317): read current_prefix_offset from cell[+16][31:0]. Zero-extension via shl+shr. Labels prefixed latin_autocomplete_gpx_.",
      block: {
        mov rax, [rdi + 16];
        shl rax, 32;
        shr rax, 32;
        ret
      }
    }

  pub let latin_autocomplete_get_candidates_offset : (u64) -> u64 !{mem} @{} =
    fn (engine_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-001 (paideia-os #2317): read candidates_offset from cell[+16][63:32]. Labels prefixed latin_autocomplete_gco_.",
      block: {
        mov rax, [rdi + 16];
        shr rax, 32;
        ret
      }
    }

  pub let latin_autocomplete_get_candidate_count : (u64) -> u64 !{mem} @{} =
    fn (engine_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-001 (paideia-os #2317): read candidate_count from cell[+24][7:0]. Encoder-conservative low-byte extract via shl 56 / shr 56. Labels prefixed latin_autocomplete_gcc_.",
      block: {
        mov rax, [rdi + 24];
        shl rax, 56;
        shr rax, 56;
        ret
      }
    }

  pub let latin_autocomplete_get_selected : (u64) -> u64 !{mem} @{} =
    fn (engine_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-001 (paideia-os #2317): read selected_candidate from cell[+24][15:8]. Encoder-conservative byte extract via shr 8 then shl 56 / shr 56. Labels prefixed latin_autocomplete_gsc_.",
      block: {
        mov rax, [rdi + 24];
        shr rax, 8;
        shl rax, 56;
        shr rax, 56;
        ret
      }
    }

  // ==========================================================================
  // SECTION 6 -- INIT FACTORY
  // ==========================================================================
  //
  // latin_autocomplete_init(engine_ptr, process_kind_id, ngram_table_ptr,
  //                         ngram_count) -> u64
  //
  //   Populate a caller-owned 32-byte engine cell AND register this
  //   engine with the KIND_IME_PROVIDER substrate as a LANG_LATIN
  //   provider. Contract:
  //
  //     (1) engine_ptr == 0                     -> LA_ENGINE_NULL
  //     (2) process_kind_id == 0                -> LA_PROCESS_NULL
  //     (3) ngram_table_ptr == 0                -> LA_NGRAM_NULL
  //     (4) ngram_count == 0                    -> LA_NGRAM_EMPTY
  //     (5) engine already initialized (cell[+0][31:0] != 0)
  //                                             -> LA_ALREADY_INIT
  //     (6) call ime_provider_register(process_kind_id, LA_LANG_LATIN,
  //                                    LA_LOCALE_UNLOCALED, LA_CAPS_DEFAULT);
  //         on refusal sentinel (upper 32 bits non-zero, i.e. any
  //         0xFFFFE9A* IMP_* code) return                -> LA_REGISTER_REFUSED
  //         The refusal-specific reason (IMP_BAD_PROCESS / IMP_BAD_LANG /
  //         IMP_BAD_LOCALE / IMP_BAD_CAPS / IMP_TAIL_ENOSPC) is visible
  //         to the caller only via ProviderKind's own stats counters --
  //         this file collapses the taxonomy to one code because the
  //         satellite process cannot recover distinct actions from the
  //         individual failures (all five require operator intervention
  //         to fix the pool or the argument shape).
  //     (7) success: stamp the cell:
  //           cell[+0]   = provider_kind_id[31:0] | ngram_count[63:32]
  //           cell[+8]   = ngram_table_ptr (full u64)
  //           cell[+16]  = 0 (empty prefix, no candidates)
  //           cell[+24]  = 0 (candidate_count=0, selected=0, reserved=0)
  //         bump LA_ST_INITS; return LA_OK.
  //
  //   Refusal funnel bumps LA_ST_REFUSED once at
  //   latin_autocomplete_init_refused.
  //
  //   Register plan (five callee-save pushes + sub rsp,8 = 48 bytes;
  //   entry rsp%16==8 -> 48+8=56 %16==8 -- WAIT, need alignment
  //   correction. Five pushes = 40; +8 for retaddr entry = 48;
  //   48 % 16 == 0. So NO padding sub needed. Correction: with FIVE
  //   pushes (rbx, r12, r13, r14, r15), entry rsp%16==8 -> after five
  //   pushes rsp%16 == (8 - 40) mod 16 == 0, aligned for the nested
  //   ime_provider_register call and the note calls. Odd-push-count
  //   keeps SysV alignment on its own):
  //     rbx = engine_ptr
  //     r12 = process_kind_id
  //     r13 = ngram_table_ptr
  //     r14 = ngram_count
  //     r15 = provider_kind_id (from ime_provider_register)
  pub let latin_autocomplete_init : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (engine_ptr: u64) (process_kind_id: u64) (ngram_table_ptr: u64) (ngram_count: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-001 (paideia-os #2317): register + engine-cell init factory. Five callee-save pushes = 40 bytes; entry rsp%16==8 -> after five pushes rsp%16 == (8-40) mod 16 == 0, aligned for nested calls (ime_provider_register + latin_autocomplete_note). No padding sub needed (odd-push-count keeps SysV alignment on its own). Args stashed BEFORE any nested call: rbx=engine_ptr, r12=process_kind_id, r13=ngram_table_ptr, r14=ngram_count, r15 receives provider_kind_id from ime_provider_register. Refusal-sentinel detection on ime_provider_register uses shr r10,32 / cmp r10,0 (mirrors focus_router_change_focus). Cell stamp writes four u64 words directly with `mov [rbx+off], rN` (encoder-conservative). No `test`, no `add reg,[mem]`, no MOVABS. Labels prefixed latin_autocomplete_init_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                       // engine_ptr
        mov r12, rsi;                       // process_kind_id
        mov r13, rdx;                       // ngram_table_ptr
        mov r14, rcx;                       // ngram_count

        // (1) engine_ptr null
        cmp rbx, 0;
        je  latin_autocomplete_init_null_engine;

        // (2) process_kind_id null
        cmp r12, 0;
        je  latin_autocomplete_init_null_process;

        // (3) ngram_table_ptr null
        cmp r13, 0;
        je  latin_autocomplete_init_null_ngram;

        // (4) ngram_count zero
        cmp r14, 0;
        je  latin_autocomplete_init_empty_ngram;

        // (5) already-init check: cell[+0][31:0] (provider_kind_id) != 0
        mov rax, [rbx + 0];
        shl rax, 32;
        shr rax, 32;
        cmp rax, 0;
        jne latin_autocomplete_init_already;

        // (6) register with ProviderKind substrate as LANG_LATIN.
        //     ime_provider_register(process, lang, locale, caps)
        //       rdi = process_kind_id
        //       rsi = LA_LANG_LATIN (0)
        //       rdx = LA_LOCALE_UNLOCALED (0)
        //       rcx = LA_CAPS_DEFAULT (0x03)
        mov rdi, r12;
        xor rsi, rsi;                       // LA_LANG_LATIN = 0
        xor rdx, rdx;                       // LA_LOCALE_UNLOCALED = 0
        mov rcx, 0x03;                      // LA_CAPS_DEFAULT
        call ime_provider_register;

        // Refusal detection: IMP_* sentinels are 0xFFFFE9A0..AF, upper
        // 32 bits non-zero. A legal row_id is 0..7, upper 32 bits zero.
        mov r10, rax;
        shr r10, 32;
        cmp r10, 0;
        jne latin_autocomplete_init_reg_refused;

        mov r15, rax;                       // r15 = provider_kind_id

        // (7) stamp the cell.

        // cell[+0]: provider_kind_id[31:0] | ngram_count[63:32]
        mov rax, r15;
        shl rax, 32;
        shr rax, 32;                        // rax = provider_id & 0xFFFFFFFF
        mov r10, r14;
        shl r10, 32;                        // r10 = ngram_count << 32
        or  rax, r10;
        mov [rbx + 0], rax;

        // cell[+8]: ngram_table_ptr (full u64)
        mov [rbx + 8], r13;

        // cell[+16]: 0 (empty prefix, no candidates)
        xor rax, rax;
        mov [rbx + 16], rax;

        // cell[+24]: 0 (candidate_count=0, selected=0, reserved=0)
        mov [rbx + 24], rax;

        // Bump LA_ST_INITS.
        mov rdi, 4;                         // LA_ST_INITS
        call latin_autocomplete_note;

        xor rax, rax;                       // LA_OK
        jmp latin_autocomplete_init_out;

      latin_autocomplete_init_null_engine:
        mov rax, 0xFFFFE7AF;                // LA_ENGINE_NULL
        jmp latin_autocomplete_init_refused;
      latin_autocomplete_init_null_process:
        mov rax, 0xFFFFE7AE;                // LA_PROCESS_NULL
        jmp latin_autocomplete_init_refused;
      latin_autocomplete_init_null_ngram:
        mov rax, 0xFFFFE7AD;                // LA_NGRAM_NULL
        jmp latin_autocomplete_init_refused;
      latin_autocomplete_init_empty_ngram:
        mov rax, 0xFFFFE7AC;                // LA_NGRAM_EMPTY
        jmp latin_autocomplete_init_refused;
      latin_autocomplete_init_already:
        mov rax, 0xFFFFE7AB;                // LA_ALREADY_INIT
        jmp latin_autocomplete_init_refused;
      latin_autocomplete_init_reg_refused:
        mov rax, 0xFFFFE7A9;                // LA_REGISTER_REFUSED
        jmp latin_autocomplete_init_refused;

      latin_autocomplete_init_refused:
        // Stash refusal code across the note call.
        mov r15, rax;
        mov rdi, 5;                         // LA_ST_REFUSED
        call latin_autocomplete_note;
        mov rax, r15;

      latin_autocomplete_init_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION 7 -- KEYSTROKE OPS
  // ==========================================================================
  //
  // Every keystroke op takes the engine_ptr in rdi and refuses a
  // null pointer (LA_ENGINE_NULL) or an uninitialized cell
  // (provider_kind_id == 0 -> LA_NOT_INIT). The four ops correspond
  // to the four events the router forwards to the engine during a
  // composition round:
  //
  //   on_key           user typed a character -- extend prefix, refresh
  //                    candidates (n-gram scan; deferred to future
  //                    substrate).
  //   commit_selected  user pressed Enter / Space / selected candidate --
  //                    return the interned string offset of the selected
  //                    candidate so the router can call
  //                    ime_session_commit_text on the bound session.
  //                    Clears prefix + candidates as side effect.
  //   cycle_candidate  user pressed Tab / Arrow -- advance
  //                    selected_candidate mod candidate_count.
  //   cancel           user pressed Escape -- clear prefix + candidates
  //                    without committing (no COMMIT_TEXT fires).
  //
  // The engine STAYS REGISTERED across composition rounds -- these ops
  // never touch cell[+0] / cell[+8] (the register-time fields);
  // only cell[+16] and cell[+24] mutate.

  // latin_autocomplete_on_key(engine_ptr, keycode) -> u64
  //
  //   Register plan (two callee-save pushes = 16; entry rsp%16==8 ->
  //   16+8=24 %16==8, add sub rsp,8 to reach 32 %16==0 for nested calls):
  //     rbx = engine_ptr
  //     r12 = keycode (validated then held live for future prefix-append
  //           substrate; today the body only bumps the stats counter)
  pub let latin_autocomplete_on_key : (u64, u64) -> u64 !{mem} @{} =
    fn (engine_ptr: u64) (keycode: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-001 (paideia-os #2317): keystroke accumulator entry point. Two callee-save pushes + sub rsp,8 = 24 bytes; entry rsp%16==8 -> 24+8=32 %16==0 for every nested call. Order: (1) engine_ptr != 0 else LA_ENGINE_NULL. (2) init check: cell[+0][31:0] != 0 else LA_NOT_INIT. (3) keycode < 2^32 else LA_BAD_KEYCODE. (4) bump LA_ST_KEY_EVENTS. (5) return LA_OK. Real prefix-append + n-gram lookup deferred to future substrate landing (n-gram table layout + interned string pool primitives out of scope for this row). Labels prefixed latin_autocomplete_ok_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        mov rbx, rdi;
        mov r12, rsi;

        // (1) engine_ptr null
        cmp rbx, 0;
        je  latin_autocomplete_ok_null_engine;

        // (2) init check
        mov rax, [rbx + 0];
        shl rax, 32;
        shr rax, 32;
        cmp rax, 0;
        je  latin_autocomplete_ok_not_init;

        // (3) keycode validity
        mov rdi, r12;
        call latin_autocomplete_keycode_valid;
        cmp rax, 0;
        je  latin_autocomplete_ok_bad_key;

        // (4) bump LA_ST_KEY_EVENTS
        mov rdi, 0;                         // LA_ST_KEY_EVENTS
        call latin_autocomplete_note;

        // (5) return LA_OK. Prefix append + n-gram scan land with the
        //     future interned-pool substrate; today the cell's prefix
        //     and candidates fields remain unchanged so the engine
        //     truthfully reports "no completions available".
        xor rax, rax;
        jmp latin_autocomplete_ok_out;

      latin_autocomplete_ok_null_engine:
        mov rax, 0xFFFFE7AF;                // LA_ENGINE_NULL
        jmp latin_autocomplete_ok_refused;
      latin_autocomplete_ok_not_init:
        mov rax, 0xFFFFE7AA;                // LA_NOT_INIT
        jmp latin_autocomplete_ok_refused;
      latin_autocomplete_ok_bad_key:
        mov rax, 0xFFFFE7A6;                // LA_BAD_KEYCODE
        // fallthrough

      latin_autocomplete_ok_refused:
        mov r12, rax;
        mov rdi, 5;                         // LA_ST_REFUSED
        call latin_autocomplete_note;
        mov rax, r12;

      latin_autocomplete_ok_out:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }

  // latin_autocomplete_commit_selected(engine_ptr) -> committed_text_offset
  //
  //   Return the interned-string offset of the currently-selected
  //   candidate, and clear the prefix + candidate list as a side effect
  //   (the composition round is over -- the next on_key starts a fresh
  //   round). On success returns a u64 whose LOW 32 bits are the
  //   candidates_offset base and whose caller resolves the specific
  //   candidate string via `candidates_offset + selected_candidate*4`
  //   (each candidate slot is a u32 interned offset). On error returns
  //   a refusal sentinel (upper 32 bits non-zero).
  //
  //   Contract:
  //     (1) engine_ptr == 0            -> LA_ENGINE_NULL
  //     (2) provider_kind_id == 0      -> LA_NOT_INIT
  //     (3) candidate_count == 0       -> LA_NO_CANDIDATES
  //     (4) selected_candidate >= count-> LA_BAD_SELECTED (defence-in-
  //                                       depth; cycle keeps selected
  //                                       in range, but a corrupt
  //                                       write could break the
  //                                       invariant)
  //     (5) success: read candidates_offset from cell[+16][63:32];
  //         clear cell[+16] (prefix + candidates both zero); clear
  //         cell[+24] (count + selected + reserved all zero); bump
  //         LA_ST_COMMITS; return candidates_offset.
  //
  //   Register plan (two callee-save pushes + sub rsp,8 = 24; entry
  //   rsp%16==8 -> 24+8=32 %16==0):
  //     rbx = engine_ptr
  //     r12 = candidates_offset (held live across the note call so the
  //           return value is not clobbered)
  pub let latin_autocomplete_commit_selected : (u64) -> u64 !{mem} @{} =
    fn (engine_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-001 (paideia-os #2317): commit the selected candidate; clear the composition state. Two callee-save pushes + sub rsp,8 = 24; entry rsp%16==8 -> 32 %16==0 for the note call. Order: null / init / count / selected gates, then read candidates_offset, clear cells [+16] and [+24], bump LA_ST_COMMITS, return offset. r12 stashes candidates_offset across the note call. Labels prefixed latin_autocomplete_cs_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        mov rbx, rdi;

        // (1) engine_ptr null
        cmp rbx, 0;
        je  latin_autocomplete_cs_null_engine;

        // (2) init check
        mov rax, [rbx + 0];
        shl rax, 32;
        shr rax, 32;
        cmp rax, 0;
        je  latin_autocomplete_cs_not_init;

        // Load counts word (candidate_count + selected_candidate).
        mov rax, [rbx + 24];

        // Extract candidate_count [7:0]
        mov r10, rax;
        shl r10, 56;
        shr r10, 56;                        // r10 = count
        cmp r10, 0;
        je  latin_autocomplete_cs_no_cands;

        // Extract selected_candidate [15:8]
        mov r11, rax;
        shr r11, 8;
        shl r11, 56;
        shr r11, 56;                        // r11 = selected
        cmp r11, r10;
        jae latin_autocomplete_cs_bad_sel;

        // (5) success. Read candidates_offset from cell[+16][63:32].
        mov r12, [rbx + 16];
        shr r12, 32;                        // r12 = candidates_offset

        // Clear cell[+16] (prefix + candidates) and cell[+24] (counts).
        xor rax, rax;
        mov [rbx + 16], rax;
        mov [rbx + 24], rax;

        // Bump LA_ST_COMMITS.
        mov rdi, 1;                         // LA_ST_COMMITS
        call latin_autocomplete_note;

        mov rax, r12;                       // committed_text_offset
        jmp latin_autocomplete_cs_out;

      latin_autocomplete_cs_null_engine:
        mov rax, 0xFFFFE7AF;                // LA_ENGINE_NULL
        jmp latin_autocomplete_cs_refused;
      latin_autocomplete_cs_not_init:
        mov rax, 0xFFFFE7AA;                // LA_NOT_INIT
        jmp latin_autocomplete_cs_refused;
      latin_autocomplete_cs_no_cands:
        mov rax, 0xFFFFE7A8;                // LA_NO_CANDIDATES
        jmp latin_autocomplete_cs_refused;
      latin_autocomplete_cs_bad_sel:
        mov rax, 0xFFFFE7A7;                // LA_BAD_SELECTED
        // fallthrough

      latin_autocomplete_cs_refused:
        mov r12, rax;
        mov rdi, 5;                         // LA_ST_REFUSED
        call latin_autocomplete_note;
        mov rax, r12;

      latin_autocomplete_cs_out:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }

  // latin_autocomplete_cycle_candidate(engine_ptr) -> new_selected | LA_*
  //
  //   Advance selected_candidate by one, wrapping modulo
  //   candidate_count. Returns the new selected_candidate value on
  //   success (0..count-1); refusal sentinel on failure. Does NOT
  //   commit; the caller invokes commit_selected separately when the
  //   user actually picks the current selection.
  //
  //   Contract:
  //     (1) engine_ptr == 0            -> LA_ENGINE_NULL
  //     (2) provider_kind_id == 0      -> LA_NOT_INIT
  //     (3) candidate_count == 0       -> LA_NO_CANDIDATES
  //     (4) success: new_sel = (old_sel + 1) mod count; rewrite
  //         cell[+24] preserving count[7:0] and reserved[63:16];
  //         bump LA_ST_CYCLES; return new_sel.
  //
  //   Register plan (two callee-save pushes + sub rsp,8 = 24; entry
  //   rsp%16==8 -> 32 %16==0):
  //     rbx = engine_ptr
  //     r12 = new_sel (held across note call)
  pub let latin_autocomplete_cycle_candidate : (u64) -> u64 !{mem} @{} =
    fn (engine_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-001 (paideia-os #2317): advance selected_candidate mod count. Two callee-save pushes + sub rsp,8 = 24; entry rsp%16==8 -> 32 %16==0. Order: null / init / count gates, then compute new_sel via `add rax,1; cmp rax,count; jb keep; xor rax,rax`, rewrite cell[+24] preserving count[7:0] and reserved[63:16], bump LA_ST_CYCLES, return new_sel. Wraparound uses branch-and-clear rather than DIV to avoid the DIV rax:rdx side effects and to keep the body encoder-conservative. Labels prefixed latin_autocomplete_cc_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        mov rbx, rdi;

        // (1) engine_ptr null
        cmp rbx, 0;
        je  latin_autocomplete_cc_null_engine;

        // (2) init check
        mov rax, [rbx + 0];
        shl rax, 32;
        shr rax, 32;
        cmp rax, 0;
        je  latin_autocomplete_cc_not_init;

        // Load counts word.
        mov rax, [rbx + 24];

        // Extract candidate_count [7:0]
        mov r10, rax;
        shl r10, 56;
        shr r10, 56;                        // r10 = count
        cmp r10, 0;
        je  latin_autocomplete_cc_no_cands;

        // Extract selected_candidate [15:8]
        mov r11, rax;
        shr r11, 8;
        shl r11, 56;
        shr r11, 56;                        // r11 = old_sel

        // new_sel = old_sel + 1
        add r11, 1;
        // if new_sel >= count, wrap to 0
        cmp r11, r10;
        jb  latin_autocomplete_cc_no_wrap;
        xor r11, r11;
      latin_autocomplete_cc_no_wrap:

        // r12 keeps new_sel across the note call.
        mov r12, r11;

        // Rebuild cell[+24]: preserve reserved[63:16], set
        // selected[15:8] = new_sel, keep count[7:0] from r10.
        //   reserved = rax >> 16, shifted back into [63:16]
        mov r11, rax;
        shr r11, 16;
        shl r11, 16;                        // r11 = reserved | 0

        // selected: r12 & 0xFF placed at [15:8]
        mov rdx, r12;
        shl rdx, 56;
        shr rdx, 48;                        // rdx = (new_sel & 0xFF) << 8
        or  r11, rdx;

        // count: r10 & 0xFF at [7:0]
        mov rdx, r10;
        shl rdx, 56;
        shr rdx, 56;                        // rdx = count & 0xFF
        or  r11, rdx;

        mov [rbx + 24], r11;

        // Bump LA_ST_CYCLES.
        mov rdi, 2;                         // LA_ST_CYCLES
        call latin_autocomplete_note;

        mov rax, r12;                       // return new_sel
        jmp latin_autocomplete_cc_out;

      latin_autocomplete_cc_null_engine:
        mov rax, 0xFFFFE7AF;                // LA_ENGINE_NULL
        jmp latin_autocomplete_cc_refused;
      latin_autocomplete_cc_not_init:
        mov rax, 0xFFFFE7AA;                // LA_NOT_INIT
        jmp latin_autocomplete_cc_refused;
      latin_autocomplete_cc_no_cands:
        mov rax, 0xFFFFE7A8;                // LA_NO_CANDIDATES
        // fallthrough

      latin_autocomplete_cc_refused:
        mov r12, rax;
        mov rdi, 5;                         // LA_ST_REFUSED
        call latin_autocomplete_note;
        mov rax, r12;

      latin_autocomplete_cc_out:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }

  // latin_autocomplete_cancel(engine_ptr) -> u64
  //
  //   Discard the current composition without committing: clear the
  //   prefix, clear the candidates, clear the selected index. The
  //   engine stays registered; the next on_key starts a fresh round.
  //
  //   Contract:
  //     (1) engine_ptr == 0            -> LA_ENGINE_NULL
  //     (2) provider_kind_id == 0      -> LA_NOT_INIT
  //     (3) success: cell[+16] := 0; cell[+24] := 0; bump LA_ST_CANCELS;
  //         return LA_OK.
  //
  //   A cancel on an empty composition (no prefix, no candidates) is
  //   still counted -- an Escape keypress with no in-flight
  //   composition is a legitimate no-op the user may issue, and the
  //   telemetry records it faithfully.
  //
  //   Register plan (one callee-save push = 8; entry rsp%16==8 ->
  //   8+8=16 %16==0 for the note call; odd-push-count keeps SysV
  //   alignment on its own):
  //     rbx = engine_ptr
  pub let latin_autocomplete_cancel : (u64) -> u64 !{mem} @{} =
    fn (engine_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-001 (paideia-os #2317): clear prefix + candidates without committing. One callee-save push = 8 bytes; entry rsp%16==8 -> after push rsp%16==0, aligned for the note call. Order: null / init gates, clear cell[+16] and cell[+24], bump LA_ST_CANCELS, return LA_OK. Labels prefixed latin_autocomplete_cx_.",
      block: {
        push rbx;

        mov rbx, rdi;

        // (1) engine_ptr null
        cmp rbx, 0;
        je  latin_autocomplete_cx_null_engine;

        // (2) init check
        mov rax, [rbx + 0];
        shl rax, 32;
        shr rax, 32;
        cmp rax, 0;
        je  latin_autocomplete_cx_not_init;

        // Clear cell[+16] and cell[+24].
        xor rax, rax;
        mov [rbx + 16], rax;
        mov [rbx + 24], rax;

        // Bump LA_ST_CANCELS.
        mov rdi, 3;                         // LA_ST_CANCELS
        call latin_autocomplete_note;

        xor rax, rax;                       // LA_OK
        jmp latin_autocomplete_cx_out;

      latin_autocomplete_cx_null_engine:
        mov rax, 0xFFFFE7AF;                // LA_ENGINE_NULL
        jmp latin_autocomplete_cx_refused;
      latin_autocomplete_cx_not_init:
        mov rax, 0xFFFFE7AA;                // LA_NOT_INIT
        // fallthrough

      latin_autocomplete_cx_refused:
        mov rdi, 5;                         // LA_ST_REFUSED
        // rax carries the refusal code; the note primitive does not
        // clobber rax on the OOB path, but it DOES clobber rax on the
        // normal path (load-inc-store on the counter slot). Stash and
        // restore via rbx (rbx no longer needs to hold the engine_ptr
        // past this point -- we are on the refusal exit).
        mov rbx, rax;
        call latin_autocomplete_note;
        mov rax, rbx;

      latin_autocomplete_cx_out:
        pop rbx;
        ret
      }
    }
}
