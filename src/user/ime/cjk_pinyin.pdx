// src/user/ime/cjk_pinyin.pdx -- G11-M4-003 (paideia-os #2319)
//
// CJK PINYIN + ZHUYIN PHONETIC IME PROVIDER SATELLITE.
//
// A userspace IME provider process that registers with the KIND_IME_
// PROVIDER substrate (§2.19, sibling landing #2315, LANDED B10) under
// LANG_CJK_ZH and services Chinese phonetic input in either variant:
//
//   * PINYIN_HANYU  (Hanyu Pinyin, zh-CN). The user types a Latin-
//     romanised syllable ("zhong", "guo", "wo", ...) plus an optional
//     tone mark (1..5), and the engine looks up the syllable in a
//     syllable->hanzi table to produce a candidate list of Chinese
//     characters that share that reading. Example: "zhong1" -> {中,
//     忠, 钟, ...}; the user cycles the candidate window and commits
//     the chosen glyph via COMMIT_TEXT.
//
//   * PINYIN_ZHUYIN  (Bopomofo / Zhuyin Fuhao, zh-TW). The user
//     types Zhuyin symbols (ㄓ ㄨ ㄥ) directly rather than their
//     romanised form; the tone marks and the candidate-selection
//     flow are identical. The lookup table's key format differs
//     (Zhuyin U+3105..U+312F sequences vs romanised strings) but
//     the engine cell layout does NOT: the variant field just names
//     which lookup format the caller's candidate_hanzi_table_ptr
//     uses. Same state machine, different input alphabet.
//
// The two variants live in ONE module because they share EVERYTHING
// except the input alphabet: same syllable buffer, same candidate-
// window schema, same commit path, same failure taxonomy. Splitting
// them into two modules would push identical machinery into two
// files for zero benefit -- the caller picks the variant at init
// time (a satellite-process launcher reads user locale preference
// and calls cjk_pinyin_init with the right variant byte) and the
// engine treats the input alphabet as an opaque wire format that
// the syllable-parser substrate (future landing) reads.
//
// Design authority:
//   * design/compositor/pwp-spec-vocabulary.md §2.19 KIND_IME_PROVIDER
//     -- names Pinyin and Zhuyin as two of the seven canonical
//     provider families. This landing implements both under one
//     module because their engine schemas coincide; the CJK Ja /
//     Ko / Indic Hi siblings land in separate rows within G11.M4.
//   * src/user/ime/provider_kind.pdx §1.3 (LANG_CJK_ZH = 1) -- the
//     enum slot this file's registration uses. Both variants
//     register as LANG_CJK_ZH; the locale (zh-CN vs zh-TW) is
//     stored on the router side via ime_provider_register's
//     locale_offset argument, not on the engine cell.
//   * src/user/ime/session_kind.pdx §1.3 (COMMIT_TEXT op semantics)
//     -- the router-side commit path this file's commit_selected
//     feeds when a phonetic sequence resolves.
//   * src/user/ime/latin_autocomplete.pdx (#2317, LANDED B11) --
//     schema-parallel Latin sibling. This file mirrors its
//     factory / on_key / commit / cycle / cancel shape and its
//     32-byte caller-owned engine cell convention. The DIFFERENCES
//     are called out in-place with a `// vs. latin_autocomplete:`
//     comment.
//
// CJK-SPECIFIC RATIONALE. Pinyin/Zhuyin phonetic input is the
// canonical CJK-family IME shape: the user types a PHONETIC
// representation (romanisation for Hanyu Pinyin, native symbols
// for Zhuyin) and the engine returns a CANDIDATE LIST of hanzi
// that share that reading. The Chinese writing system has ~50k
// glyphs mapped to ~400 unique syllable readings, so multiple
// hanzi share every syllable and the user MUST choose from a
// candidate window (unlike Latin autocomplete, where the user's
// prefix converges to ONE completion). The engine cell therefore
// mirrors autocomplete's shape (prefix + candidates + selected)
// but with different field names: `syllable_buffer_offset`
// replaces `current_prefix_offset` (the buffer holds the
// romanisation or Zhuyin sequence rather than a partial word),
// and `candidate_hanzi_table_ptr` replaces `ngram_table_ptr`
// (the table maps syllable->hanzi_list rather than prefix->
// completions).
//
// SCHEMA-ONLY LOOKUP. The candidate_hanzi_table_ptr is passed in
// as an opaque pointer at init time; its layout is defined by the
// caller (the satellite process's own dictionary provisioner)
// and is NOT interpreted by this file's assembly beyond a null
// check. The on_key body's syllable accumulator + tone-mark
// handler + hanzi lookup is a FUTURE substrate landing (the
// syllable-parser format is variant-specific and lands with the
// satellite-side substrate that wires the Hanyu-Pinyin BNF vs
// the Zhuyin U+3105 alphabet). Until that substrate lands, the
// on_key body validates the keycode, bumps CP_ST_KEY_EVENTS and
// returns CP_OK -- the cell's syllable and candidates fields
// stay untouched so the engine truthfully reports "no candidates
// yet" rather than fabricating one. The commit_selected /
// cycle_candidate bodies are STRUCTURALLY CORRECT (they update
// the cell honestly and bump stats) but only bite once the
// syllable-parser substrate populates the candidate list.
//
// PER-PROCESS SATELLITE. One engine instance per satellite
// process (typically one per session; a user with both a
// zh-CN and a zh-TW keyboard layout might run two engine
// instances with different variants and different candidate
// tables). The engine cell is CALLER-OWNED (mirrors latin_
// autocomplete + latin_deadkey + focus_router precedent); this
// file does NOT hold a module singleton.
//
// CJK PINYIN ENGINE STRUCT. The natural typing is
//
//   struct CjkPinyinEngine {
//     provider_kind_id: u32,       // row_id from ime_provider_register
//     variant: u8,                  // PINYIN_HANYU / PINYIN_ZHUYIN
//     session_kind_id: u32,         // bound session (0 = not bound;
//                                   //   router-updated via bind/unbind,
//                                   //   out of scope for this landing)
//     syllable_buffer_offset: u32,  // interned string offset for the
//                                   //   accumulated romanisation /
//                                   //   Zhuyin sequence; 0 = empty
//                                   //   (no composition in flight)
//     candidate_hanzi_table_ptr: u64, // opaque pointer to
//                                   //   syllable->hanzi list table;
//                                   //   caller-defined layout
//     candidate_count: u8,          // 0..CP_CANDIDATE_MAX (16;
//                                   //   Chinese candidate windows
//                                   //   run deeper than Latin's 8
//                                   //   because syllable collisions
//                                   //   are common)
//     selected_candidate: u8        // 0..candidate_count-1
//   }
//
// but paideia-as does not currently return structs by value from
// asm bodies (mirrors the note in latin_autocomplete.pdx / latin_
// deadkey.pdx / focus_router.pdx / input_server precedent), so
// the wire-level shape is a 32-byte caller-owned cell populated
// in place via fixed-offset word writes. Callers read fields via
// the getters below once CP_OK is returned. The struct declaration
// below is DOCUMENTATION ONLY (mirrors FocusRouterState /
// LatinAutocompleteEngine / DeadkeyEngine precedent).
//
// vs. latin_autocomplete: autocomplete's cell packs an n-gram-
// table pointer + a prefix + candidate list; this cell packs a
// hanzi-table pointer + a syllable buffer + candidate list, plus
// TWO extra fields autocomplete does not carry: `variant` (which
// of the two phonetic alphabets the caller uses) and
// `session_kind_id` (autocomplete does not track the bound
// session on-cell; this engine does because a CJK composition
// round can span multiple keystrokes and the router may need to
// tear down the composition on a session unbind before the user
// commits). All four fields fit into the same 32-byte cell
// budget via denser packing (see cell layout below).
//
// vs. latin_autocomplete caps: autocomplete advertises IMP_CAP_
// PREEDIT (0x01) | IMP_CAP_CANDIDATE_WINDOW (0x02) = 0x03. This
// engine advertises PREEDIT + CANDIDATE_WINDOW + IMP_CAP_PHONETIC
// (0x04) = 0x07 -- the phonetic bit tells the router this
// engine is a PHONETIC input method, so the router's session
// binding can honor a session's IMP_CAP_PHONETIC preference bit
// (a session that wants a phonetic IME picks this provider over
// a stroke-input Ja/Ko sibling).
//
// LABEL PREFIX. `cjk_pinyin_` throughout, sidestepping paideia-as
// reserved-word collisions (see feedback_paideia_as_reserved_labels).
// Every ASM jump target is `cjk_pinyin_<funcname>_<tag>`.
//
// MECE SCOPE. Single file under src/user/ime/. Touches only:
//   * NEW: src/user/ime/cjk_pinyin.pdx (this file)
//   * EDIT: tools/verify-fingerprint-coverage.sh (add allowlist
//           entry for pdx_kind_cjk_pinyin_meta since the satellite-
//           side dispatcher that would emit it is a future landing)
// No other file is modified.
//
// FAILURE BAND. 0xFFFFE7C0..0xFFFFE7CF -- adjacent to the sibling
// LANG_LATIN autocomplete provider's 0xFFFFE7A0..0xFFFFE7AF band
// (latin_autocomplete.pdx #2317) and to latin_deadkey's
// 0xFFFFE7B0..0xFFFFE7BF band (latin_deadkey.pdx #2318). Grep-
// verified free across src/ + tests/ + design/ at landing time
// (only occurrence is latin_deadkey's own comment declaring the
// contiguous G11.M4 headroom in 0xFFFFE7C0..0xFFFFE7FF). Keeping
// the G11.M4 provider family clustered in the 0xFFFFE7A0..FF
// page leaves the remaining CJK/Indic siblings (Kana, Hangul,
// Devanagari, InScript) contiguous headroom in 0xFFFFE7D0..
// 0xFFFFE7FF.
//
// FINGERPRINT. One legacy-suffixed init fingerprint per the
// standard klog convention (matches session_kind / provider_kind /
// latin_autocomplete / latin_deadkey precedent). Emitted once on
// successful engine init by the future satellite-side substrate
// that wires the engine into a satellite-process main loop; no
// fingerprint on the per-keystroke on_key / commit / cycle /
// cancel paths (those fire per keystroke in an interactive session
// and would flood the ring, same rationale as tag_tty_read_ok in
// keys.pdx). Until the satellite substrate lands, the tag is
// DATA-ONLY (declared here but not emitted from any body) --
// verify-fingerprint-coverage.sh gets a matching allowlist entry
// per the sibling B8 / B10 / B11 / B12 pattern.
//
// Encoder-conservative pattern per session_kind / provider_kind /
// latin_autocomplete / latin_deadkey: no `and reg, imm64`, no
// MOVABS r64,imm64, no `test`, no `add reg,[mem]`, no `mov_bzx`/
// `mov_wzx`, no `neg`, no `cqo`, no `idiv`, no 2-op `imul`;
// 32-bit zero-extension via shl+shr; u8 extraction via shl 56 /
// shr 56; small immediates only. Refusal sentinels 0xFFFFE7C*
// fit in 32-bit immediates (encoder emits `mov r32, imm32` which
// zero-extends to r64).
//
// =============================================================================

module CjkPinyin = structure {

  // ==========================================================================
  // SECTION 1.1 -- PROVIDER-FAMILY PINS (mirror of ProviderKind)
  // ==========================================================================
  //
  // Named locally so assembly bodies can use small immediates
  // rather than cross-module symbol references. Each pin is
  // asserted in a comment against its source of truth so a future
  // edit to the sibling module cannot silently drift.

  // Mirror of ProviderKind.LANG_CJK_ZH (= 1). Both PINYIN_HANYU
  // and PINYIN_ZHUYIN variants register with this same lang slot
  // (multiple providers per lang is legal per the LANG-ENUM
  // contract). The router disambiguates via caps + locale.
  pub let CP_LANG_CJK_ZH           : u64 = 1

  // Mirror of ProviderKind.IME_PROVIDER_LOCALE_UNLOCALED (= 0).
  // The engine itself is locale-agnostic (both variants share
  // one engine schema); the caller's locale preference (zh-CN
  // for Hanyu, zh-TW for Zhuyin) is not on the engine cell.
  // The router-side registration uses this sentinel; a
  // future landing that adds per-locale routing will pass a
  // non-zero interned locale offset here.
  pub let CP_LOCALE_UNLOCALED      : u64 = 0

  // vs. latin_autocomplete: autocomplete = 0x03 (PREEDIT +
  // CANDIDATE_WINDOW). This engine = 0x07 (adds IMP_CAP_PHONETIC
  // = 0x04). The phonetic bit tells the router this provider
  // services PHONETIC input (Pinyin/Zhuyin), distinguishing it
  // from a future STROKE-input CJK provider (Wubi, Cangjie)
  // that will advertise IMP_CAP_STROKE_INPUT (0x08) instead.
  pub let CP_CAPS_DEFAULT          : u64 = 0x07

  // ==========================================================================
  // SECTION 1.2 -- PinyinVariant ENUM
  // ==========================================================================
  //
  // Two variants share the engine cell; the byte tells the
  // syllable-parser substrate which input alphabet to expect on
  // the wire. Sealed at 0..1; anything above CP_VARIANT_MAX is
  // refused at init with CP_BAD_VARIANT.

  pub let PINYIN_HANYU             : u64 = 0   // Hanyu Pinyin (zh-CN,
                                                // romanised syllables)
  pub let PINYIN_ZHUYIN            : u64 = 1   // Zhuyin / Bopomofo
                                                // (zh-TW, U+3105..U+312F
                                                // native symbols)
  pub let CP_VARIANT_MAX           : u64 = 1   // inclusive upper bound

  // ==========================================================================
  // SECTION 1.3 -- ENGINE CELL LAYOUT (CjkPinyinEngine, 32 bytes)
  // ==========================================================================
  //
  // Four u64 words holding the engine's per-instance state. Every
  // mutating op edits one packed field IN PLACE; the row is
  // written by exactly one thread at a time (the satellite
  // process's own event loop is single-threaded per engine
  // instance, mirroring the per-engine invariant of latin_
  // autocomplete + latin_deadkey).
  //
  // Cell layout (offsets in bytes):
  //
  //   [+0]  provider_and_session:
  //             provider_kind_id[31:0]   row_id from ime_provider_
  //                                      register at init time.
  //                                      Nonzero after successful
  //                                      init; 0 before init.
  //             session_kind_id[63:32]   currently-bound session
  //                                      (router-updated via bind/
  //                                      unbind, out of scope for
  //                                      THIS landing). 0 = not
  //                                      bound (the engine still
  //                                      processes keys and updates
  //                                      state, but a completed
  //                                      composition emits no
  //                                      COMMIT_TEXT event because
  //                                      no session is listening).
  //
  //   [+8]  candidate_hanzi_table_ptr: u64
  //             pointer to the syllable->hanzi_list lookup table.
  //             Full u64 (the table typically lives in the
  //             satellite process's own .data or in a shared
  //             read-only mapping). Nonzero after successful init.
  //             Layout is caller-defined; the on_key body treats
  //             it as opaque and delegates to a future substrate.
  //
  //   [+16] syllable_and_variant:
  //             syllable_buffer_offset[31:0]  interned string offset
  //                                          into the satellite-side
  //                                          preedit pool; the
  //                                          accumulated romanisation
  //                                          (Hanyu) or Zhuyin
  //                                          sequence the user has
  //                                          typed so far. 0 = empty
  //                                          buffer (no composition
  //                                          in flight).
  //             variant[39:32]                PinyinVariant enum
  //                                          value (u8); PINYIN_HANYU
  //                                          (0) or PINYIN_ZHUYIN (1).
  //                                          Stamped at init, never
  //                                          rewritten (the variant
  //                                          is a per-engine
  //                                          property; a caller that
  //                                          wants to switch variants
  //                                          re-inits a fresh cell).
  //             reserved[63:40]               0 at init; future
  //                                          extensions (input-mode
  //                                          flags, tone-mark hint)
  //                                          land here.
  //
  //   [+24] counts_and_reserved:
  //             candidate_count[7:0]         0..CP_CANDIDATE_MAX (16)
  //             selected_candidate[15:8]     0..candidate_count-1;
  //                                          undefined when count == 0
  //             reserved[63:16]              0 at init; future flags
  //
  // Cell is 32 bytes = one half of a 64-byte cache line. Cache-
  // line alignment is CALLER'S responsibility (mirrors sibling
  // latin_autocomplete / latin_deadkey).
  //
  // Documentation-only struct declaration (mirrors FocusRouterState
  // / LatinAutocompleteEngine / DeadkeyEngine precedent). The
  // struct field ordering below MATCHES the row prompt's stated
  // typing (provider_kind_id, variant, session_kind_id, ...) even
  // though the wire-level packing groups provider_kind_id and
  // session_kind_id into cell[+0] and hoists variant to cell[+16]
  // for denser packing -- the struct is documentation-only and
  // the caller reads via the getters below regardless.

  struct CjkPinyinEngine {
    provider_kind_id: u32,
    variant: u8,
    session_kind_id: u32,
    syllable_buffer_offset: u32,
    candidate_hanzi_table_ptr: u64,
    candidate_count: u8,
    selected_candidate: u8
  }

  pub let CP_CELL_BYTES                : u64 = 32
  pub let CP_CELL_OFF_PROVIDER_SESSION : u64 = 0
  pub let CP_CELL_OFF_HANZI_PTR        : u64 = 8
  pub let CP_CELL_OFF_SYLL_VARIANT     : u64 = 16
  pub let CP_CELL_OFF_COUNTS           : u64 = 24

  // Sub-word bit positions for CP_CELL_OFF_SYLL_VARIANT:
  //   syllable_buffer_offset  bits [31:0]
  //   variant                 bits [39:32]
  pub let CP_SYLL_VARIANT_SHIFT        : u64 = 32

  // Sub-word bit positions for CP_CELL_OFF_COUNTS:
  //   candidate_count     bits [7:0]
  //   selected_candidate  bits [15:8]
  pub let CP_COUNTS_SEL_SHIFT          : u64 = 8

  // Ceiling on the candidate list. Sixteen candidates is a
  // conventional Chinese IME candidate-window depth (matches ibus/
  // fcitx-chinese defaults and Windows IME); Latin autocomplete
  // caps at eight (LA_CANDIDATE_MAX in latin_autocomplete.pdx)
  // because English prefix-completion converges much faster than
  // Chinese syllable-collision. A larger list rarely helps: past
  // 16 the user usually re-types the syllable more precisely
  // rather than scan a deeper list. The candidate list is stored
  // via candidate_hanzi_table_ptr, not inline, so the ceiling is
  // a stats-side constraint rather than a layout constraint.
  pub let CP_CANDIDATE_MAX             : u64 = 16

  // Empty-syllable / empty-candidates sentinel (mirrors
  // LA_PREFIX_EMPTY / LA_CANDIDATES_EMPTY): offset 0 in the
  // satellite-side pool is reserved for the empty string.
  pub let CP_SYLLABLE_EMPTY            : u64 = 0
  pub let CP_CANDIDATES_EMPTY          : u64 = 0

  // ==========================================================================
  // SECTION 1.4 -- FAILURE TAXONOMY (0xFFFFE7C0..0xFFFFE7CF)
  // ==========================================================================
  //
  // Fresh 16-wide band, adjacent to latin_autocomplete's
  // 0xFFFFE7A0..0xFFFFE7AF and latin_deadkey's 0xFFFFE7B0..0xFFFFE7BF.
  // Grep-verified free across src/ + tests/ + design/ at landing
  // time (only occurrence is latin_deadkey's own comment
  // declaring the contiguous G11.M4 headroom in 0xFFFFE7C0..
  // 0xFFFFE7FF).

  pub let CP_OK                    : u64 = 0
  pub let CP_ENGINE_NULL           : u64 = 0xFFFFE7CF  // engine_ptr == 0
  pub let CP_PROCESS_NULL          : u64 = 0xFFFFE7CE  // process_kind_id == 0
  pub let CP_TABLE_NULL            : u64 = 0xFFFFE7CD  // candidate_hanzi_table_ptr == 0
  pub let CP_BAD_VARIANT           : u64 = 0xFFFFE7CC  // variant > CP_VARIANT_MAX
  pub let CP_ALREADY_INIT          : u64 = 0xFFFFE7CB  // engine already initialized
  pub let CP_NOT_INIT              : u64 = 0xFFFFE7CA  // op before init succeeded
  pub let CP_REGISTER_REFUSED      : u64 = 0xFFFFE7C9  // ime_provider_register
                                                        // returned refusal sentinel
                                                        // (upper 32 bits set); the
                                                        // specific reason is on
                                                        // the wire from that call
                                                        // via ProviderKind stats
  pub let CP_NO_CANDIDATES         : u64 = 0xFFFFE7C8  // commit/cycle with count==0
  pub let CP_BAD_SELECTED          : u64 = 0xFFFFE7C7  // selected_candidate >= count
  pub let CP_BAD_KEYCODE           : u64 = 0xFFFFE7C6  // keycode outside u32 range
                                                        // (upper 32 bits set); future
                                                        // key-domain validators may
                                                        // narrow this further
  // Slots 0xFFFFE7C5..0xFFFFE7C0 are RESERVED within this file's
  // band for future extension (syllable-parser refusals, tone-
  // mark validators, hanzi-table checksum failures once the
  // substrate lands).

  // ==========================================================================
  // SECTION 1.5 -- STATS COUNTER SLOTS
  // ==========================================================================
  //
  // Six named slots in the _cjk_pinyin_stats [u64; 8] cell. A
  // boot-log observer can verify KEY_EVENTS >= COMMITS + CANCELS
  // (each commit and each cancel consumes at least one prior key
  // event, so this deficit is always non-negative in a healthy
  // run).

  pub let CP_ST_KEY_EVENTS         : u64 = 0
  pub let CP_ST_COMMITS            : u64 = 1
  pub let CP_ST_CYCLES             : u64 = 2
  pub let CP_ST_CANCELS            : u64 = 3
  pub let CP_ST_INITS              : u64 = 4
  pub let CP_ST_REFUSED            : u64 = 5
  pub let CP_ST_MAX                : u64 = 6

  // ==========================================================================
  // SECTION 1.6 -- FINGERPRINT (one line, legacy-suffixed)
  // ==========================================================================
  //
  // pdx_kind_cjk_pinyin_meta: emitted once on successful engine
  // init by the future satellite-side substrate. Data-only at this
  // landing per the sibling B8 KIND_IME_SESSION / B10 KIND_IME_
  // PROVIDER / B11 latin_autocomplete / B12 latin_deadkey pattern
  // (allowlisted in tools/verify-fingerprint-coverage.sh as
  // "cjk pinyin init ok [legacy: CJK PINYIN INIT OK]").
  //
  // Byte count: 47 content chars + 1 NUL = 48.
  pub let pdx_kind_cjk_pinyin_meta : [u8; 48] = "cjk pinyin init ok [legacy: CJK PINYIN INIT OK]\0"

  // Short field-name string constants for future debug-print use
  // (mirror ime_provider_k_row_id / ime_session_k_commit_seq /
  // latin_autocomplete_k_provider_id / latin_deadkey_k_state
  // precedent).
  pub let cjk_pinyin_k_provider_id : [u8; 12] = "provider_id\0"
  pub let cjk_pinyin_k_variant     : [u8; 8]  = "variant\0"
  pub let cjk_pinyin_k_syllable    : [u8; 9]  = "syllable\0"

  // ==========================================================================
  // SECTION 2 -- STATS CELL
  // ==========================================================================
  //
  // Module-level counters shared across every engine instance in
  // this process (typically one). Mirrors _latin_autocomplete_stats
  // / _latin_deadkey_stats layout.

  pub let mut _cjk_pinyin_stats : [u64; 8] = uninit @align(64)

  // ==========================================================================
  // SECTION 3 -- COUNTER PRIMITIVES
  // ==========================================================================

  // cjk_pinyin_stats_reset() -> (): zero counters at boot.
  pub let cjk_pinyin_stats_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-003 (paideia-os #2319): clear per-module counters at boot. Mirrors latin_autocomplete_stats_reset / latin_deadkey_stats_reset. Single low-first index scan over 8 u64 slots via load-inc-store; no callee-save pushes (leaf; only r10/rcx/rax touched beyond SysV in/out). Labels prefixed cjk_pinyin_srs_.",
      block: {
        lea r10, [rip + _cjk_pinyin_stats];
        xor rax, rax;
        xor rcx, rcx;
      cjk_pinyin_srs_loop:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  cjk_pinyin_srs_loop;
        ret
      }
    }

  // cjk_pinyin_note(which) -> (): bump one stats counter.
  // Encoder-conservative load-inc-store; OOB is a silent no-op.
  pub let cjk_pinyin_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-003 (paideia-os #2319): counter bump. Encoder-conservative load-inc-store; no add reg,[mem]. OOB is a silent no-op. Mirrors latin_autocomplete_note. Labels prefixed cjk_pinyin_nt_.",
      block: {
        cmp rdi, 8;
        jae cjk_pinyin_nt_out;
        lea r10, [rip + _cjk_pinyin_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      cjk_pinyin_nt_out:
        ret
      }
    }

  // cjk_pinyin_stat(which) -> u64: read one stats counter.
  pub let cjk_pinyin_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-003 (paideia-os #2319): counter read; OOB -> 0. Labels prefixed cjk_pinyin_st_.",
      block: {
        cmp rdi, 8;
        jae cjk_pinyin_st_zero;
        lea r10, [rip + _cjk_pinyin_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      cjk_pinyin_st_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // SECTION 4 -- VALIDATORS (pure leaves)
  // ==========================================================================

  // cjk_pinyin_keycode_valid(keycode) -> 1 iff keycode < 2^32.
  // Widened later when a HID keymap / Zhuyin U+3105..U+312F range
  // validator lands; today the only gate is "fits in the u32 half
  // of a future packed word".
  pub let cjk_pinyin_keycode_valid : (u64) -> u64 !{} @{} =
    fn (keycode: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G11-M4-003 (paideia-os #2319): 1 iff keycode < 2^32. Encoder-conservative 32-bit range test via shr+cmp (mirrors latin_autocomplete_keycode_valid). Labels prefixed cjk_pinyin_kv_.",
      block: {
        mov rax, rdi;
        shr rax, 32;
        cmp rax, 0;
        jne cjk_pinyin_kv_no;
        mov rax, 1;
        ret;
      cjk_pinyin_kv_no:
        xor rax, rax;
        ret
      }
    }

  // cjk_pinyin_variant_valid(variant) -> 1 iff variant <= CP_VARIANT_MAX(1).
  pub let cjk_pinyin_variant_valid : (u64) -> u64 !{} @{} =
    fn (variant: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G11-M4-003 (paideia-os #2319): 1 iff variant in {0,1}. Sealed enum; caller receives CP_BAD_VARIANT on refusal. Small-immediate cmp. Labels prefixed cjk_pinyin_vv_.",
      block: {
        cmp rdi, 1;
        ja  cjk_pinyin_vv_no;
        mov rax, 1;
        ret;
      cjk_pinyin_vv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // SECTION 5 -- CELL-FIELD GETTERS
  // ==========================================================================
  //
  // Every getter takes the engine_ptr in rdi and returns the
  // requested field in rax. A null engine_ptr is undefined
  // behavior at the getter level (callers that need the safe form
  // check engine_ptr != 0 first); this matches focus_router_get_*
  // / input_server_get_* / latin_autocomplete_get_* / latin_
  // deadkey_get_* precedent.

  pub let cjk_pinyin_get_provider_id : (u64) -> u64 !{mem} @{} =
    fn (engine_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-003 (paideia-os #2319): read provider_kind_id from cell[+0][31:0]. Zero-extension via shl+shr. Labels prefixed cjk_pinyin_gpi_.",
      block: {
        mov rax, [rdi + 0];
        shl rax, 32;
        shr rax, 32;
        ret
      }
    }

  pub let cjk_pinyin_get_session_id : (u64) -> u64 !{mem} @{} =
    fn (engine_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-003 (paideia-os #2319): read session_kind_id from cell[+0][63:32]. Labels prefixed cjk_pinyin_gsi_.",
      block: {
        mov rax, [rdi + 0];
        shr rax, 32;
        ret
      }
    }

  pub let cjk_pinyin_get_hanzi_ptr : (u64) -> u64 !{mem} @{} =
    fn (engine_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-003 (paideia-os #2319): read candidate_hanzi_table_ptr from cell[+8] (full u64). Labels prefixed cjk_pinyin_ghp_.",
      block: {
        mov rax, [rdi + 8];
        ret
      }
    }

  pub let cjk_pinyin_get_syllable_offset : (u64) -> u64 !{mem} @{} =
    fn (engine_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-003 (paideia-os #2319): read syllable_buffer_offset from cell[+16][31:0]. Zero-extension via shl+shr. Labels prefixed cjk_pinyin_gso_.",
      block: {
        mov rax, [rdi + 16];
        shl rax, 32;
        shr rax, 32;
        ret
      }
    }

  pub let cjk_pinyin_get_variant : (u64) -> u64 !{mem} @{} =
    fn (engine_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-003 (paideia-os #2319): read variant from cell[+16][39:32]. u8 extraction via shr 32 / shl 56 / shr 56. Labels prefixed cjk_pinyin_gv_.",
      block: {
        mov rax, [rdi + 16];
        shr rax, 32;
        shl rax, 56;
        shr rax, 56;
        ret
      }
    }

  pub let cjk_pinyin_get_candidate_count : (u64) -> u64 !{mem} @{} =
    fn (engine_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-003 (paideia-os #2319): read candidate_count from cell[+24][7:0]. Encoder-conservative low-byte extract via shl 56 / shr 56. Labels prefixed cjk_pinyin_gcc_.",
      block: {
        mov rax, [rdi + 24];
        shl rax, 56;
        shr rax, 56;
        ret
      }
    }

  pub let cjk_pinyin_get_selected : (u64) -> u64 !{mem} @{} =
    fn (engine_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-003 (paideia-os #2319): read selected_candidate from cell[+24][15:8]. Encoder-conservative byte extract via shr 8 / shl 56 / shr 56. Labels prefixed cjk_pinyin_gsc_.",
      block: {
        mov rax, [rdi + 24];
        shr rax, 8;
        shl rax, 56;
        shr rax, 56;
        ret
      }
    }

  // ==========================================================================
  // SECTION 6 -- INIT FACTORY
  // ==========================================================================
  //
  // cjk_pinyin_init(engine_ptr, process_kind_id, variant,
  //                 candidate_hanzi_table_ptr) -> u64
  //
  //   Populate a caller-owned 32-byte engine cell AND register
  //   this engine with the KIND_IME_PROVIDER substrate as a
  //   LANG_CJK_ZH provider. Contract:
  //
  //     (1) engine_ptr == 0                     -> CP_ENGINE_NULL
  //     (2) process_kind_id == 0                -> CP_PROCESS_NULL
  //     (3) variant > CP_VARIANT_MAX            -> CP_BAD_VARIANT
  //     (4) candidate_hanzi_table_ptr == 0      -> CP_TABLE_NULL
  //     (5) engine already initialized (cell[+0][31:0] != 0)
  //                                             -> CP_ALREADY_INIT
  //     (6) call ime_provider_register(process_kind_id, CP_LANG_CJK_ZH,
  //                                    CP_LOCALE_UNLOCALED, CP_CAPS_DEFAULT);
  //         on refusal sentinel (upper 32 bits non-zero, i.e.
  //         any 0xFFFFE9A* IMP_* code) return   -> CP_REGISTER_REFUSED
  //         The refusal-specific reason is visible to the caller
  //         only via ProviderKind's own stats counters -- this
  //         file collapses the taxonomy to one code because the
  //         satellite process cannot recover distinct actions
  //         from the individual failures.
  //     (7) success: stamp the cell:
  //           cell[+0]   = provider_kind_id[31:0] | 0 (session not bound)
  //           cell[+8]   = candidate_hanzi_table_ptr (full u64)
  //           cell[+16]  = 0 syllable | variant[39:32]
  //           cell[+24]  = 0 (candidate_count=0, selected=0, reserved=0)
  //         bump CP_ST_INITS; return CP_OK.
  //
  //   Refusal funnel bumps CP_ST_REFUSED once at
  //   cjk_pinyin_init_refused.
  //
  //   Register plan (five callee-save pushes = 40 bytes; entry
  //   rsp%16==8 -> after five pushes rsp%16 == (8-40) mod 16 ==
  //   0, aligned for nested calls (ime_provider_register +
  //   cjk_pinyin_note). Odd-push-count keeps SysV alignment on
  //   its own -- no padding sub needed):
  //     rbx = engine_ptr
  //     r12 = process_kind_id
  //     r13 = variant
  //     r14 = candidate_hanzi_table_ptr
  //     r15 = provider_kind_id (from ime_provider_register)
  pub let cjk_pinyin_init : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (engine_ptr: u64) (process_kind_id: u64) (variant: u64) (candidate_table_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-003 (paideia-os #2319): register + engine-cell init factory. Five callee-save pushes = 40 bytes; entry rsp%16==8 -> after five pushes rsp%16 == (8-40) mod 16 == 0, aligned for nested calls (ime_provider_register + cjk_pinyin_note). No padding sub needed (odd-push-count keeps SysV alignment on its own; mirrors latin_autocomplete_init). Args stashed BEFORE any nested call: rbx=engine_ptr, r12=process_kind_id, r13=variant, r14=candidate_table_ptr, r15 receives provider_kind_id from ime_provider_register. Refusal-sentinel detection on ime_provider_register uses shr r10,32 / cmp r10,0 (mirrors focus_router_change_focus / latin_autocomplete_init / latin_deadkey_init). Cell stamp writes four u64 words directly with `mov [rbx+off], rN` (encoder-conservative). No `test`, no `add reg,[mem]`, no MOVABS, no 2-op imul. Labels prefixed cjk_pinyin_init_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                       // engine_ptr
        mov r12, rsi;                       // process_kind_id
        mov r13, rdx;                       // variant
        mov r14, rcx;                       // candidate_hanzi_table_ptr

        // (1) engine_ptr null
        cmp rbx, 0;
        je  cjk_pinyin_init_null_engine;

        // (2) process_kind_id null
        cmp r12, 0;
        je  cjk_pinyin_init_null_process;

        // (3) variant range
        mov rdi, r13;
        call cjk_pinyin_variant_valid;
        cmp rax, 0;
        je  cjk_pinyin_init_bad_variant;

        // (4) candidate_hanzi_table_ptr null
        cmp r14, 0;
        je  cjk_pinyin_init_null_table;

        // (5) already-init check: cell[+0][31:0] (provider_kind_id) != 0
        mov rax, [rbx + 0];
        shl rax, 32;
        shr rax, 32;
        cmp rax, 0;
        jne cjk_pinyin_init_already;

        // (6) register with ProviderKind substrate as LANG_CJK_ZH.
        //     ime_provider_register(process, lang, locale, caps)
        //       rdi = process_kind_id
        //       rsi = CP_LANG_CJK_ZH (1)
        //       rdx = CP_LOCALE_UNLOCALED (0)
        //       rcx = CP_CAPS_DEFAULT (0x07)
        mov rdi, r12;
        mov rsi, 1;                         // CP_LANG_CJK_ZH
        xor rdx, rdx;                       // CP_LOCALE_UNLOCALED = 0
        mov rcx, 0x07;                      // CP_CAPS_DEFAULT (PREEDIT+CW+PHONETIC)
        call ime_provider_register;

        // Refusal detection: IMP_* sentinels are 0xFFFFE9A0..AF, upper
        // 32 bits non-zero. A legal row_id is 0..7, upper 32 bits zero.
        mov r10, rax;
        shr r10, 32;
        cmp r10, 0;
        jne cjk_pinyin_init_reg_refused;

        mov r15, rax;                       // r15 = provider_kind_id

        // (7) stamp the cell.

        // cell[+0]: provider_kind_id[31:0] | 0 (session_kind_id=0)
        mov rax, r15;
        shl rax, 32;
        shr rax, 32;                        // rax = provider_id & 0xFFFFFFFF
        mov [rbx + 0], rax;

        // cell[+8]: candidate_hanzi_table_ptr (full u64)
        mov [rbx + 8], r14;

        // cell[+16]: syllable_buffer_offset=0 | variant[39:32]
        //   Build as: rax = 0 | ((variant & 0xFF) << 32)
        mov rax, r13;
        shl rax, 56;
        shr rax, 24;                        // rax = (variant & 0xFF) << 32
        mov [rbx + 16], rax;

        // cell[+24]: 0 (candidate_count=0, selected=0, reserved=0)
        xor rax, rax;
        mov [rbx + 24], rax;

        // Bump CP_ST_INITS.
        mov rdi, 4;                         // CP_ST_INITS
        call cjk_pinyin_note;

        xor rax, rax;                       // CP_OK
        jmp cjk_pinyin_init_out;

      cjk_pinyin_init_null_engine:
        mov rax, 0xFFFFE7CF;                // CP_ENGINE_NULL
        jmp cjk_pinyin_init_refused;
      cjk_pinyin_init_null_process:
        mov rax, 0xFFFFE7CE;                // CP_PROCESS_NULL
        jmp cjk_pinyin_init_refused;
      cjk_pinyin_init_bad_variant:
        mov rax, 0xFFFFE7CC;                // CP_BAD_VARIANT
        jmp cjk_pinyin_init_refused;
      cjk_pinyin_init_null_table:
        mov rax, 0xFFFFE7CD;                // CP_TABLE_NULL
        jmp cjk_pinyin_init_refused;
      cjk_pinyin_init_already:
        mov rax, 0xFFFFE7CB;                // CP_ALREADY_INIT
        jmp cjk_pinyin_init_refused;
      cjk_pinyin_init_reg_refused:
        mov rax, 0xFFFFE7C9;                // CP_REGISTER_REFUSED
        // fallthrough

      cjk_pinyin_init_refused:
        // Stash refusal code across the note call.
        mov r15, rax;
        mov rdi, 5;                         // CP_ST_REFUSED
        call cjk_pinyin_note;
        mov rax, r15;

      cjk_pinyin_init_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION 7 -- KEYSTROKE OPS
  // ==========================================================================
  //
  // Every keystroke op takes the engine_ptr in rdi and refuses a
  // null pointer (CP_ENGINE_NULL) or an uninitialized cell
  // (provider_kind_id == 0 -> CP_NOT_INIT). The four ops
  // correspond to the four events the router forwards to the
  // engine during a composition round:
  //
  //   on_key           user typed a character -- extend the
  //                    syllable buffer, refresh candidates
  //                    (syllable parser + hanzi lookup; deferred
  //                    to future substrate).
  //   commit_selected  user pressed Enter / Space / candidate --
  //                    return the interned string offset of the
  //                    selected hanzi so the router can call
  //                    ime_session_commit_text on the bound
  //                    session. Clears syllable + candidates as
  //                    side effect.
  //   cycle_candidate  user pressed Tab / Arrow -- advance
  //                    selected_candidate mod candidate_count.
  //   cancel           user pressed Escape -- clear syllable +
  //                    candidates without committing.
  //
  // The engine STAYS REGISTERED across composition rounds -- these
  // ops never touch cell[+0][31:0] (provider_kind_id) or cell[+8]
  // (candidate_hanzi_table_ptr) or cell[+16][39:32] (variant);
  // only the syllable_buffer_offset (cell[+16][31:0]) and
  // cell[+24] (counts) mutate.

  // cjk_pinyin_on_key(engine_ptr, keycode) -> u64
  //
  //   Register plan (two callee-save pushes + sub rsp,8 = 24;
  //   entry rsp%16==8 -> 24+8=32 %16==0 for nested calls):
  //     rbx = engine_ptr
  //     r12 = keycode (validated then held live for future
  //           syllable-append substrate; today the body only
  //           bumps the stats counter)
  pub let cjk_pinyin_on_key : (u64, u64) -> u64 !{mem} @{} =
    fn (engine_ptr: u64) (keycode: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-003 (paideia-os #2319): keystroke accumulator entry point. Two callee-save pushes + sub rsp,8 = 24 bytes; entry rsp%16==8 -> 24+8=32 %16==0 for every nested call. Order: (1) engine_ptr != 0 else CP_ENGINE_NULL. (2) init check: cell[+0][31:0] != 0 else CP_NOT_INIT. (3) keycode < 2^32 else CP_BAD_KEYCODE. (4) bump CP_ST_KEY_EVENTS. (5) return CP_OK. Real syllable-append + hanzi lookup deferred to future substrate landing (syllable-parser format is variant-specific and lands with the satellite-side substrate that wires the Hanyu-Pinyin BNF vs Zhuyin U+3105 alphabet). Labels prefixed cjk_pinyin_ok_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        mov rbx, rdi;
        mov r12, rsi;

        // (1) engine_ptr null
        cmp rbx, 0;
        je  cjk_pinyin_ok_null_engine;

        // (2) init check
        mov rax, [rbx + 0];
        shl rax, 32;
        shr rax, 32;
        cmp rax, 0;
        je  cjk_pinyin_ok_not_init;

        // (3) keycode validity
        mov rdi, r12;
        call cjk_pinyin_keycode_valid;
        cmp rax, 0;
        je  cjk_pinyin_ok_bad_key;

        // (4) bump CP_ST_KEY_EVENTS
        mov rdi, 0;                         // CP_ST_KEY_EVENTS
        call cjk_pinyin_note;

        // (5) return CP_OK. Syllable append + hanzi scan land
        //     with the future substrate; today the cell's syllable
        //     and candidates fields remain unchanged so the engine
        //     truthfully reports "no completions available".
        xor rax, rax;
        jmp cjk_pinyin_ok_out;

      cjk_pinyin_ok_null_engine:
        mov rax, 0xFFFFE7CF;                // CP_ENGINE_NULL
        jmp cjk_pinyin_ok_refused;
      cjk_pinyin_ok_not_init:
        mov rax, 0xFFFFE7CA;                // CP_NOT_INIT
        jmp cjk_pinyin_ok_refused;
      cjk_pinyin_ok_bad_key:
        mov rax, 0xFFFFE7C6;                // CP_BAD_KEYCODE
        // fallthrough

      cjk_pinyin_ok_refused:
        mov r12, rax;
        mov rdi, 5;                         // CP_ST_REFUSED
        call cjk_pinyin_note;
        mov rax, r12;

      cjk_pinyin_ok_out:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }

  // cjk_pinyin_commit_selected(engine_ptr) -> committed_hanzi_offset
  //
  //   Return the interned-string offset of the currently-selected
  //   hanzi, and clear the syllable + candidate list as a side
  //   effect (the composition round is over -- the next on_key
  //   starts a fresh round). On success returns a u64 whose LOW
  //   32 bits are the caller-computed hanzi interned-offset (the
  //   candidate table's per-slot resolution rule is caller-
  //   defined; today the body returns the raw candidates_offset
  //   equivalent by reading cell[+16][31:0] BEFORE clearing it,
  //   which under the current schema is the syllable_buffer_
  //   offset -- the future substrate will replace this with a
  //   proper hanzi-list resolution once candidate storage lands).
  //   On error returns a refusal sentinel (upper 32 bits non-zero).
  //
  //   Contract:
  //     (1) engine_ptr == 0            -> CP_ENGINE_NULL
  //     (2) provider_kind_id == 0      -> CP_NOT_INIT
  //     (3) candidate_count == 0       -> CP_NO_CANDIDATES
  //     (4) selected_candidate >= count-> CP_BAD_SELECTED
  //     (5) success: snapshot syllable_buffer_offset from cell[+16]
  //         [31:0] (this stands in for the hanzi resolution until
  //         the substrate replaces it); clear cell[+16][31:0]
  //         (syllable) preserving variant[39:32] and reserved
  //         [63:40]; clear cell[+24] (counts); bump CP_ST_COMMITS;
  //         return the snapshot.
  //
  //   Register plan (two callee-save pushes + sub rsp,8 = 24;
  //   entry rsp%16==8 -> 24+8=32 %16==0):
  //     rbx = engine_ptr
  //     r12 = committed_offset (held live across the note call so
  //           the return value is not clobbered)
  pub let cjk_pinyin_commit_selected : (u64) -> u64 !{mem} @{} =
    fn (engine_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-003 (paideia-os #2319): commit the selected candidate; clear composition state. Two callee-save pushes + sub rsp,8 = 24; entry rsp%16==8 -> 32 %16==0 for the note call. Order: null / init / count / selected gates, then snapshot syllable_buffer_offset (stands in for the hanzi resolution until the substrate lands), clear cell[+16][31:0] preserving variant[39:32], clear cell[+24], bump CP_ST_COMMITS, return snapshot. r12 stashes the committed offset across the note call. Preserve-variant repack uses shr 32 / shl 32 to zero the low half while keeping the top half intact. Labels prefixed cjk_pinyin_cs_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        mov rbx, rdi;

        // (1) engine_ptr null
        cmp rbx, 0;
        je  cjk_pinyin_cs_null_engine;

        // (2) init check
        mov rax, [rbx + 0];
        shl rax, 32;
        shr rax, 32;
        cmp rax, 0;
        je  cjk_pinyin_cs_not_init;

        // Load counts word (candidate_count + selected_candidate).
        mov rax, [rbx + 24];

        // Extract candidate_count [7:0]
        mov r10, rax;
        shl r10, 56;
        shr r10, 56;                        // r10 = count
        cmp r10, 0;
        je  cjk_pinyin_cs_no_cands;

        // Extract selected_candidate [15:8]
        mov r11, rax;
        shr r11, 8;
        shl r11, 56;
        shr r11, 56;                        // r11 = selected
        cmp r11, r10;
        jae cjk_pinyin_cs_bad_sel;

        // (5) success. Snapshot syllable_buffer_offset from
        //     cell[+16][31:0]. This stands in for the hanzi
        //     resolution until the substrate lands; the future
        //     substrate will replace this snapshot with a
        //     candidate-table walk that resolves the selected
        //     index to a hanzi interned offset.
        mov r12, [rbx + 16];
        shl r12, 32;
        shr r12, 32;                        // r12 = syllable_offset

        // Clear cell[+16][31:0] preserving variant[39:32] and
        // reserved[63:40]. Load full word, shr 32 to drop the
        // low half, shl 32 to move it back, store.
        mov rax, [rbx + 16];
        shr rax, 32;
        shl rax, 32;
        mov [rbx + 16], rax;

        // Clear cell[+24] (counts + selected + reserved).
        xor rax, rax;
        mov [rbx + 24], rax;

        // Bump CP_ST_COMMITS.
        mov rdi, 1;                         // CP_ST_COMMITS
        call cjk_pinyin_note;

        mov rax, r12;                       // committed_hanzi_offset
        jmp cjk_pinyin_cs_out;

      cjk_pinyin_cs_null_engine:
        mov rax, 0xFFFFE7CF;                // CP_ENGINE_NULL
        jmp cjk_pinyin_cs_refused;
      cjk_pinyin_cs_not_init:
        mov rax, 0xFFFFE7CA;                // CP_NOT_INIT
        jmp cjk_pinyin_cs_refused;
      cjk_pinyin_cs_no_cands:
        mov rax, 0xFFFFE7C8;                // CP_NO_CANDIDATES
        jmp cjk_pinyin_cs_refused;
      cjk_pinyin_cs_bad_sel:
        mov rax, 0xFFFFE7C7;                // CP_BAD_SELECTED
        // fallthrough

      cjk_pinyin_cs_refused:
        mov r12, rax;
        mov rdi, 5;                         // CP_ST_REFUSED
        call cjk_pinyin_note;
        mov rax, r12;

      cjk_pinyin_cs_out:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }

  // cjk_pinyin_cycle_candidate(engine_ptr) -> new_selected | CP_*
  //
  //   Advance selected_candidate by one, wrapping modulo
  //   candidate_count. Returns the new selected_candidate value
  //   on success (0..count-1); refusal sentinel on failure. Does
  //   NOT commit; the caller invokes commit_selected separately
  //   when the user actually picks the current selection.
  //
  //   Contract:
  //     (1) engine_ptr == 0            -> CP_ENGINE_NULL
  //     (2) provider_kind_id == 0      -> CP_NOT_INIT
  //     (3) candidate_count == 0       -> CP_NO_CANDIDATES
  //     (4) success: new_sel = (old_sel + 1) mod count; rewrite
  //         cell[+24] preserving count[7:0] and reserved[63:16];
  //         bump CP_ST_CYCLES; return new_sel.
  //
  //   Register plan (two callee-save pushes + sub rsp,8 = 24;
  //   entry rsp%16==8 -> 32 %16==0):
  //     rbx = engine_ptr
  //     r12 = new_sel (held across note call)
  pub let cjk_pinyin_cycle_candidate : (u64) -> u64 !{mem} @{} =
    fn (engine_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-003 (paideia-os #2319): advance selected_candidate mod count. Two callee-save pushes + sub rsp,8 = 24; entry rsp%16==8 -> 32 %16==0. Order: null / init / count gates, then compute new_sel via `add r11,1; cmp r11,count; jb keep; xor r11,r11`, rewrite cell[+24] preserving count[7:0] and reserved[63:16], bump CP_ST_CYCLES, return new_sel. Wraparound uses branch-and-clear rather than DIV (no `neg` / no `cqo` / no `idiv` per encoder rules; matches latin_autocomplete_cycle_candidate). Labels prefixed cjk_pinyin_cc_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        mov rbx, rdi;

        // (1) engine_ptr null
        cmp rbx, 0;
        je  cjk_pinyin_cc_null_engine;

        // (2) init check
        mov rax, [rbx + 0];
        shl rax, 32;
        shr rax, 32;
        cmp rax, 0;
        je  cjk_pinyin_cc_not_init;

        // Load counts word.
        mov rax, [rbx + 24];

        // Extract candidate_count [7:0]
        mov r10, rax;
        shl r10, 56;
        shr r10, 56;                        // r10 = count
        cmp r10, 0;
        je  cjk_pinyin_cc_no_cands;

        // Extract selected_candidate [15:8]
        mov r11, rax;
        shr r11, 8;
        shl r11, 56;
        shr r11, 56;                        // r11 = old_sel

        // new_sel = old_sel + 1
        add r11, 1;
        // if new_sel >= count, wrap to 0
        cmp r11, r10;
        jb  cjk_pinyin_cc_no_wrap;
        xor r11, r11;
      cjk_pinyin_cc_no_wrap:

        // r12 keeps new_sel across the note call.
        mov r12, r11;

        // Rebuild cell[+24]: preserve reserved[63:16], set
        // selected[15:8] = new_sel, keep count[7:0] from r10.
        //   reserved = rax >> 16, shifted back into [63:16]
        mov r11, rax;
        shr r11, 16;
        shl r11, 16;                        // r11 = reserved | 0

        // selected: r12 & 0xFF placed at [15:8]
        mov rdx, r12;
        shl rdx, 56;
        shr rdx, 48;                        // rdx = (new_sel & 0xFF) << 8
        or  r11, rdx;

        // count: r10 & 0xFF at [7:0]
        mov rdx, r10;
        shl rdx, 56;
        shr rdx, 56;                        // rdx = count & 0xFF
        or  r11, rdx;

        mov [rbx + 24], r11;

        // Bump CP_ST_CYCLES.
        mov rdi, 2;                         // CP_ST_CYCLES
        call cjk_pinyin_note;

        mov rax, r12;                       // return new_sel
        jmp cjk_pinyin_cc_out;

      cjk_pinyin_cc_null_engine:
        mov rax, 0xFFFFE7CF;                // CP_ENGINE_NULL
        jmp cjk_pinyin_cc_refused;
      cjk_pinyin_cc_not_init:
        mov rax, 0xFFFFE7CA;                // CP_NOT_INIT
        jmp cjk_pinyin_cc_refused;
      cjk_pinyin_cc_no_cands:
        mov rax, 0xFFFFE7C8;                // CP_NO_CANDIDATES
        // fallthrough

      cjk_pinyin_cc_refused:
        mov r12, rax;
        mov rdi, 5;                         // CP_ST_REFUSED
        call cjk_pinyin_note;
        mov rax, r12;

      cjk_pinyin_cc_out:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }

  // cjk_pinyin_cancel(engine_ptr) -> u64
  //
  //   Discard the current composition without committing: clear
  //   the syllable buffer (cell[+16][31:0]) preserving variant
  //   (cell[+16][39:32]), clear the candidates and selected index
  //   (cell[+24]). The engine stays registered; the next on_key
  //   starts a fresh round.
  //
  //   Contract:
  //     (1) engine_ptr == 0            -> CP_ENGINE_NULL
  //     (2) provider_kind_id == 0      -> CP_NOT_INIT
  //     (3) success: cell[+16][31:0] := 0 (preserving variant);
  //         cell[+24] := 0; bump CP_ST_CANCELS; return CP_OK.
  //
  //   A cancel on an empty composition is still counted -- an
  //   Escape keypress with no in-flight composition is a
  //   legitimate no-op the user may issue, and the telemetry
  //   records it faithfully.
  //
  //   Register plan (one callee-save push = 8; entry rsp%16==8
  //   -> after push rsp%16==0, aligned for the note call; odd-
  //   push-count keeps SysV alignment on its own):
  //     rbx = engine_ptr
  pub let cjk_pinyin_cancel : (u64) -> u64 !{mem} @{} =
    fn (engine_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-003 (paideia-os #2319): clear syllable + candidates without committing. One callee-save push = 8 bytes; entry rsp%16==8 -> after push rsp%16==0, aligned for the note call. Order: null / init gates, clear cell[+16][31:0] preserving variant[39:32] via shr 32 / shl 32, clear cell[+24], bump CP_ST_CANCELS, return CP_OK. Labels prefixed cjk_pinyin_cx_.",
      block: {
        push rbx;

        mov rbx, rdi;

        // (1) engine_ptr null
        cmp rbx, 0;
        je  cjk_pinyin_cx_null_engine;

        // (2) init check
        mov rax, [rbx + 0];
        shl rax, 32;
        shr rax, 32;
        cmp rax, 0;
        je  cjk_pinyin_cx_not_init;

        // Clear cell[+16][31:0] preserving variant[39:32] and
        // reserved[63:40]: load full word, shr 32 to drop the
        // low half, shl 32 to move it back, store.
        mov rax, [rbx + 16];
        shr rax, 32;
        shl rax, 32;
        mov [rbx + 16], rax;

        // Clear cell[+24].
        xor rax, rax;
        mov [rbx + 24], rax;

        // Bump CP_ST_CANCELS.
        mov rdi, 3;                         // CP_ST_CANCELS
        call cjk_pinyin_note;

        xor rax, rax;                       // CP_OK
        jmp cjk_pinyin_cx_out;

      cjk_pinyin_cx_null_engine:
        mov rax, 0xFFFFE7CF;                // CP_ENGINE_NULL
        jmp cjk_pinyin_cx_refused;
      cjk_pinyin_cx_not_init:
        mov rax, 0xFFFFE7CA;                // CP_NOT_INIT
        // fallthrough

      cjk_pinyin_cx_refused:
        // Stash refusal code in rbx (rbx no longer needs to hold
        // the engine_ptr past this point -- we are on the refusal
        // exit).
        mov rbx, rax;
        mov rdi, 5;                         // CP_ST_REFUSED
        call cjk_pinyin_note;
        mov rax, rbx;

      cjk_pinyin_cx_out:
        pop rbx;
        ret
      }
    }
}
