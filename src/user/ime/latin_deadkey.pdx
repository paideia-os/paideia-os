// src/user/ime/latin_deadkey.pdx -- G11-M4-002 (paideia-os #2318)
//
// LATIN DEAD-KEY + COMPOSE-KEY IME PROVIDER SATELLITE.
//
// A userspace IME provider process that registers with the KIND_IME_
// PROVIDER substrate (§2.19, sibling landing #2315, LANDED B10) as a
// SECOND LANG_LATIN provider -- distinct from the autocomplete
// provider (#2317, LANDED B11). This one owns Latin diacritic input:
//
//   * Dead-key sequences.   The user presses a "dead key" (a key that
//     produces NO output on its own, but arms the engine to combine
//     with the NEXT keystroke): e.g. `acute` then `e` -> `é`,
//     `grave` then `a` -> `à`, `circumflex` then `o` -> `ô`,
//     `diaeresis` then `u` -> `ü`. The dead key does not commit a
//     glyph on its own; it stashes a code point (the "combiner") and
//     awaits a base character. If the next keystroke is a valid base
//     for the combiner, the engine emits the composed code point; if
//     it is invalid (e.g. `acute` then `q`, no `q-acute` exists in
//     Latin-1 Supplement), the engine emits the combiner AS a spacing
//     character (U+00B4 for acute, U+0060 for grave, ...) followed by
//     the base -- the user's keystrokes are never lost, just committed
//     as literal characters when the compose fails.
//
//   * Compose-key sequences. A three-key sequence: `Compose` then
//     char1 then char2 -> composed glyph. Compose is a modal
//     activator: pressing it puts the engine in DK_COMPOSE_1 (waiting
//     for the first character of a compose sequence); the first
//     character transitions to DK_COMPOSE_2 (waiting for the second);
//     the second character triggers a lookup and either commits the
//     composed glyph or, on a miss, commits the two characters
//     literally. Canonical examples: `Compose` `-` `>` -> `->` (a
//     literal arrow, U+2192 RIGHTWARDS ARROW), `Compose` `<` `3` ->
//     `♥` (U+2665 BLACK HEART SUIT), `Compose` `o` `c` -> `©`
//     (U+00A9 COPYRIGHT SIGN).
//
// The Escape key at ANY state resets to DK_IDLE without emitting
// anything -- the user has changed their mind about the composition
// they started.
//
// Design authority:
//   * design/compositor/pwp-spec-vocabulary.md §2.19 KIND_IME_PROVIDER
//     -- names dead-key + compose as the SECOND Latin family (the
//     first being autocomplete, #2317). The KIND_IME_PROVIDER
//     substrate admits multiple providers per LANG_LATIN slot; the
//     router picks between them based on user preference.
//   * src/user/ime/provider_kind.pdx §1.3 (LANG_LATIN = 0) -- the
//     enum slot this file's registration uses (same slot as
//     autocomplete; multiple providers per lang is legal per the
//     LANG-ENUM contract).
//   * src/user/ime/session_kind.pdx §1.3 (COMMIT_TEXT op semantics)
//     -- the router-side commit path this file's on_key feeds when a
//     dead-key or compose sequence resolves.
//   * X.Org's Compose(5) sequence syntax (~1978, XKB "compose" table)
//     is the canonical prior art for compose sequences; this file's
//     three-state (IDLE / COMPOSE_1 / COMPOSE_2) machine matches
//     libX11's XwcLookupString behavior. Dead-key state
//     (DK_AWAITING_BASE) matches XKB's "dead_*" keysym family.
//
// TWO-PROVIDER RATIONALE (why not one Latin provider?). Autocomplete
// and dead-key + compose are ORTHOGONAL text-entry disciplines that
// share only the target script:
//
//   * Autocomplete listens for LETTERS (a, b, c, ...) and suggests
//     COMPLETIONS from a dictionary. It emits candidates the user
//     picks with arrow keys + space.
//   * Dead-key listens for DIACRITIC combiners (dead_acute,
//     dead_grave, ...) and Compose sequences (Compose - >), and
//     emits ONE composed glyph per completed sequence.
//
// A user typing an English essay wants autocomplete (dictionary
// completions of prefix-typed words). A user typing French, German,
// Spanish, or Polish wants dead-key (e/E to é/É via `acute`+e).
// A user typing mathematical notes in ANY Latin locale wants Compose
// (Compose + - + > for ->, Compose + < + = for ≤, etc). The three
// audiences OVERLAP but each engine's per-keystroke state machine is
// completely disjoint, so combining them into one module would push
// two independent conditionals into every on_key call site for zero
// benefit. Splitting them keeps each state machine minimal, keeps
// each engine's failure taxonomy narrow, and lets a user disable
// EITHER without losing the OTHER (a common configuration: "give me
// autocomplete but no dead keys" or "give me Compose but no
// autocomplete"). The router-side selection substrate (#2316
// KIND_IME_ROUTER, out of scope for this landing) decides which
// providers are active for a given session; each provider registers
// independently with ime_provider_register.
//
// LATIN AUTOCOMPLETE PRECEDENT. This file is a schema-parallel of
// src/user/ime/latin_autocomplete.pdx (#2317, LANDED B11): same
// registration flow, same failure-band shape, same caller-owned
// engine cell, same encoder-conservative pattern (no `and reg,
// imm64`, no MOVABS r64,imm64, no `test`, no `add reg,[mem]`, no
// `mov_bzx`/`mov_wzx`; small immediates only; 32-bit zero-extension
// via shl+shr). Where the schemas DIFFER, the difference is called
// out in-place with a `// vs. autocomplete:` comment.
//
// SCHEMA-ONLY COMPOSE-TABLE LOOKUP. The compose table is passed in
// as an opaque pointer at init time. Its layout is defined by the
// caller (the satellite process's own compose-table provisioner) and
// is NOT interpreted by this file's assembly beyond a null check.
// latin_deadkey_lookup takes (dead, base) and returns the composed
// unicode code point OR 0 on miss; the body is currently a
// short-circuit that returns 0 unconditionally (the full n-entry
// hash-or-perfect-hash scan lands with the satellite-side substrate
// that wires the compose-table format -- design decision on the
// exact table format deferred to that landing). The on_key body's
// state transitions are FULLY IMPLEMENTED against the currently-
// stubbed lookup (state advances, sequences complete, refusals
// funnel), so the state machine is exercisable even before the
// table format lands.
//
// PER-PROCESS SATELLITE. One engine instance per satellite process
// (typically one per session). The engine cell is CALLER-OWNED
// (mirrors latin_autocomplete + focus_router precedent); this file
// does not hold a module singleton. Multiple engines per process is
// legal but unusual (a user with two keyboard layouts running two
// dead-key engines with different compose tables); the caller
// allocates a distinct cell for each.
//
// LATIN DEAD-KEY ENGINE STRUCT. The natural typing is
//
//   struct DeadkeyEngine {
//     provider_kind_id: u32,      // row_id from ime_provider_register
//     state: u8,                   // DK_IDLE / DK_AWAITING_BASE /
//                                  // DK_COMPOSE_1 / DK_COMPOSE_2
//     pending_deadkey: u16,        // the dead combiner (acute=0xB4,
//                                  // grave=0x60, ...) waiting for its
//                                  // base; only valid in
//                                  // DK_AWAITING_BASE
//     compose_char1: u16,          // first char of a compose sequence;
//                                  // only valid in DK_COMPOSE_2
//     session_kind_id: u32,        // currently-bound session (0 = not
//                                  // bound); the router updates this
//                                  // via bind/unbind
//     compose_table_ptr: u64       // opaque pointer, caller-defined
//                                  // layout
//   }
//
// but paideia-as does not currently return structs by value from asm
// bodies (mirrors the note in latin_autocomplete.pdx / focus_router.
// pdx / input_server precedent), so the wire-level shape is a
// 32-byte caller-owned cell populated in place via fixed-offset
// word writes. Struct declaration is DOCUMENTATION ONLY.
//
// vs. autocomplete: autocomplete's cell holds an n-gram-table
// pointer + a prefix + candidate list; deadkey's cell holds a
// compose-table pointer + a state-machine snapshot (state + two
// pending u16 characters). Both cells are 32 bytes; both provider
// registrations succeed via the same ime_provider_register(lang=0,
// locale=0, caps) call with the caps bitmap DIFFERENT: deadkey does
// NOT advertise IMP_CAP_PREEDIT (dead keys do not draw a ghost
// preedit -- the state is invisible to the user until the next
// keystroke commits or resets) and does NOT advertise IMP_CAP_
// CANDIDATE_WINDOW (there is no candidate list; each sequence has
// exactly one composed output).
//
// LABEL PREFIX. `latin_deadkey_` throughout, sidestepping paideia-as
// reserved-word collisions (see feedback_paideia_as_reserved_labels).
// Every ASM jump target is `latin_deadkey_<funcname>_<tag>`.
//
// MECE SCOPE. Single file under src/user/ime/. Touches only:
//   * NEW: src/user/ime/latin_deadkey.pdx (this file)
//   * EDIT: tools/verify-fingerprint-coverage.sh (add allowlist entry
//           for pdx_kind_latin_deadkey_meta since the satellite-side
//           dispatcher that would emit it is a future landing)
// No other file is modified.
//
// FAILURE BAND REBASE. The row prompt named 0xFFFFEB70..0xFFFFEB7F as
// this file's failure band. Grep-verify at landing time showed that
// band FULLY OCCUPIED by src/user/compositor/workspace_kind.pdx's
// WKSP_* codes (WKSP_TAIL_ENOSPC = 0xFFFFEB7F, WKSP_TAIL_BAD_ARG =
// 0xFFFFEB7E, WKSP_MINT_BAD_ID = 0xFFFFEB7D, WKSP_MINT_ID_IN_USE =
// 0xFFFFEB7C, WKSP_MINT_BAD_LAYOUT = 0xFFFFEB7B, WKSP_MINT_BAD_NAME =
// 0xFFFFEB7A, WKSP_BAD_SLOT = 0xFFFFEB79, WKSP_REVOKE_ALREADY =
// 0xFFFFEB78, ..., down through the whole 16-slot page). Rebased to
// 0xFFFFE7B0..0xFFFFE7BF, adjacent to the sibling LANG_LATIN
// autocomplete provider's 0xFFFFE7A0..0xFFFFE7AF band (latin_
// autocomplete.pdx #2317) and grep-verified free across src/ +
// tests/ + design/ at landing time. Keeping the G11.M4 provider
// family clustered in the 0xFFFFE7A0..0xFFFFE7FF page leaves the
// CJK/Indic siblings (Pinyin, Zhuyin, Kana, Hangul, Devanagari,
// InScript -- the remaining five of the seven canonical provider
// families) contiguous headroom in 0xFFFFE7C0..0xFFFFE7FF.
//
// FINGERPRINT. One legacy-suffixed init fingerprint per the standard
// klog convention (matches session_kind / provider_kind / latin_
// autocomplete precedent). Emitted once on successful engine init by
// the future satellite-side substrate; no fingerprint on the
// per-keystroke on_key / reset / lookup paths (those fire many
// times per second in an interactive session and would flood the
// ring, same rationale as tag_tty_read_ok in keys.pdx). Until the
// satellite substrate lands, the tag is DATA-ONLY (declared here but
// not emitted from any body) -- verify-fingerprint-coverage.sh gets
// a matching allowlist entry per the B8 KIND_IME_SESSION / B10
// KIND_IME_PROVIDER / B11 latin_autocomplete pattern.
//
// Encoder-conservative pattern per session_kind / provider_kind /
// latin_autocomplete: no `and reg, imm64`, no MOVABS r64,imm64, no
// `test`, no `add reg,[mem]`, no `mov_bzx`/`mov_wzx`; 32-bit
// zero-extension via shl+shr; small immediates only. u16 field
// extraction uses shl 48 / shr 48 (the u16 sibling of the u32
// shl 32 / shr 32 idiom). u8 field extraction uses shl 56 / shr 56
// (matches sibling latin_autocomplete's count-field extraction).
//
// =============================================================================

module LatinDeadkey = structure {

  // ==========================================================================
  // SECTION 1.1 -- PROVIDER-FAMILY PINS (mirror of ProviderKind)
  // ==========================================================================
  //
  // Named locally so assembly bodies can use small immediates rather
  // than cross-module symbol references. Each pin is asserted in a
  // comment against its source of truth so a future edit to the
  // sibling module cannot silently drift.

  // Mirror of ProviderKind.LANG_LATIN (= 0). Same slot as the
  // sibling autocomplete provider (multiple providers per lang is
  // legal per the LANG-ENUM contract).
  pub let LD_LANG_LATIN            : u64 = 0

  // Mirror of ProviderKind.IME_PROVIDER_LOCALE_UNLOCALED (= 0).
  // Dead-key sequences work identically across en/fr/de/es/pl/... --
  // acute + e -> é regardless of locale. Compose sequences are also
  // locale-agnostic (Compose + - + > -> RIGHTWARDS ARROW in every
  // Latin locale). Locale-specific compose entries (rare but they
  // exist: fr-FR wants Compose + ' + e -> é, en-US does not bind
  // apostrophe as a dead key) are the responsibility of the
  // compose_table_ptr the caller passes at init time, not of the
  // provider registration itself.
  pub let LD_LOCALE_UNLOCALED      : u64 = 0

  // vs. autocomplete: autocomplete advertises IMP_CAP_PREEDIT (0x01)
  // | IMP_CAP_CANDIDATE_WINDOW (0x02) = 0x03. Deadkey advertises
  // NEITHER (0x00): dead-key state is invisible to the user (no
  // ghost text between keystrokes), and there is no candidate list
  // (each sequence has exactly one composed output; there is nothing
  // to choose between). The caps bitmap is 0.
  //
  // provider_kind's IMP_BAD_CAPS validator refuses ONLY bits ABOVE
  // IMP_CAP_ALL (0x0F); a zero bitmap is legal (a provider that
  // advertises no capabilities is valid, per §1.4 caps validator).
  pub let LD_CAPS_DEFAULT          : u64 = 0

  // ==========================================================================
  // SECTION 1.2 -- ENGINE CELL LAYOUT (DeadkeyEngine, 32 bytes)
  // ==========================================================================
  //
  // Four u64 words holding the engine's per-instance state. Every
  // mutating op edits one packed field IN PLACE; the row is written
  // by exactly one thread at a time (the satellite process's own
  // event loop is single-threaded per engine instance, mirroring
  // the per-seat single-thread invariant of focus_router / the
  // per-engine single-thread invariant of latin_autocomplete).
  //
  // Cell layout (offsets in bytes):
  //
  //   [+0]  provider_and_session:
  //             provider_kind_id[31:0]   row_id from ime_provider_
  //                                      register at init time.
  //                                      Nonzero after successful
  //                                      init; 0 before init.
  //             session_kind_id[63:32]   currently-bound session
  //                                      (router-updated via bind/
  //                                      unbind, out of scope for
  //                                      THIS landing). 0 = not
  //                                      bound (the engine still
  //                                      processes keys and updates
  //                                      state, but a completed
  //                                      composition emits no
  //                                      COMMIT_TEXT event because
  //                                      no session is listening).
  //
  //   [+8]  compose_table_ptr: u64
  //             pointer to the compose-sequence table. Full u64
  //             (the table typically lives in the satellite
  //             process's own .data or in a shared read-only
  //             mapping). Nonzero after successful init. Layout
  //             is caller-defined; latin_deadkey_lookup treats it
  //             as opaque and delegates to a future substrate.
  //
  //   [+16] state_pending_compose:
  //             state[7:0]                 DK_IDLE(0) / DK_AWAITING_
  //                                        BASE(1) / DK_COMPOSE_1(2)
  //                                        / DK_COMPOSE_2(3)
  //             pending_deadkey[23:8]      u16 combiner (only valid
  //                                        in DK_AWAITING_BASE);
  //                                        0 in every other state
  //             compose_char1[39:24]       u16 first compose char
  //                                        (only valid in DK_COMPOSE_
  //                                        2); 0 in every other
  //                                        state
  //             reserved[63:40]            0 at init; future
  //                                        extensions (locale-aware
  //                                        variant flags, etc.)
  //                                        land here
  //
  //   [+24] counters_and_reserved:
  //             session_bind_seq[31:0]     bumped by the router when
  //                                        session_kind_id changes,
  //                                        so a stale composition
  //                                        from a previous binding
  //                                        cannot commit against a
  //                                        new session. 0 at init;
  //                                        the router increments on
  //                                        each bind.
  //             reserved[63:32]            0 at init; future flags
  //
  // Cell is 32 bytes = one half of a 64-byte cache line. Cache-line
  // alignment is CALLER'S responsibility (mirrors sibling latin_
  // autocomplete).
  //
  // Documentation-only struct declaration (mirrors FocusRouterState /
  // LatinAutocompleteEngine precedent).

  struct DeadkeyEngine {
    provider_kind_id: u32,
    state: u8,
    pending_deadkey: u16,
    compose_char1: u16,
    session_kind_id: u32,
    compose_table_ptr: u64
  }

  pub let LD_CELL_BYTES                : u64 = 32
  pub let LD_CELL_OFF_PROVIDER_SESSION : u64 = 0
  pub let LD_CELL_OFF_COMPOSE_PTR      : u64 = 8
  pub let LD_CELL_OFF_STATE_PENDING    : u64 = 16
  pub let LD_CELL_OFF_COUNTERS         : u64 = 24

  // Sub-word bit positions for LD_CELL_OFF_STATE_PENDING:
  //   state              bits [7:0]
  //   pending_deadkey    bits [23:8]
  //   compose_char1      bits [39:24]
  pub let LD_STATE_PENDING_DK_SHIFT    : u64 = 8
  pub let LD_STATE_PENDING_C1_SHIFT    : u64 = 24

  // ==========================================================================
  // SECTION 1.3 -- DEADKEY STATE ENUM
  // ==========================================================================
  //
  // Four states form the compose-sequence state machine:
  //
  //   DK_IDLE          Awaiting any keystroke. Non-dead keys pass
  //                    through (return LD_TAG_PASSTHROUGH); dead
  //                    keys transition to DK_AWAITING_BASE stashing
  //                    the combiner; Compose transitions to
  //                    DK_COMPOSE_1.
  //
  //   DK_AWAITING_BASE Dead key was pressed; awaiting a base
  //                    character. A valid base commits the composed
  //                    glyph (LD_TAG_COMMITTED with the composed
  //                    codepoint); an invalid base commits the
  //                    combiner as a spacing character followed by
  //                    the base (two commits in sequence). ESC
  //                    resets to DK_IDLE without emitting.
  //
  //   DK_COMPOSE_1     Compose was pressed; awaiting the first
  //                    character of a compose sequence. Any
  //                    character stashes as compose_char1 and
  //                    transitions to DK_COMPOSE_2. ESC resets.
  //
  //   DK_COMPOSE_2     Two characters have been stashed; awaiting
  //                    the third (final) character. A lookup on
  //                    (compose_char1, this_char) commits the
  //                    composed glyph on a hit or commits all three
  //                    literal characters on a miss. Resets to
  //                    DK_IDLE either way.

  pub let DK_IDLE          : u64 = 0
  pub let DK_AWAITING_BASE : u64 = 1
  pub let DK_COMPOSE_1     : u64 = 2
  pub let DK_COMPOSE_2     : u64 = 3

  // Sentinel keycodes named by the state machine. The kernel-side
  // HID keymap uses these u16 code points as the wire values for
  // dead-key / Compose keysyms; the router forwards raw keysyms
  // untranslated. Values match the XKB "dead_*" family (which
  // encodes the combining diacritic's SPACING form as the keysym):
  //
  //   acute      U+00B4 ACUTE ACCENT
  //   grave      U+0060 GRAVE ACCENT
  //   circumflex U+005E CIRCUMFLEX ACCENT
  //   tilde      U+007E TILDE
  //   diaeresis  U+00A8 DIAERESIS
  //   Compose    U+FF20 (XKB-private range; the KIND_IME_ROUTER
  //              picks this or another sentinel at bind time --
  //              this file names one canonical value for the
  //              state-machine tests; the actual sentinel is a
  //              router-side configuration item and can be
  //              overridden by user preference at that layer)
  //
  // The is_deadkey flag on the on_key entry point disambiguates
  // "dead key pressed" from "spacing-form character pressed": the
  // same u16 value (0xB4 for acute) means DIFFERENT things when
  // is_deadkey==1 vs is_deadkey==0.
  pub let LD_KEYSYM_ACUTE          : u64 = 0x00B4
  pub let LD_KEYSYM_GRAVE          : u64 = 0x0060
  pub let LD_KEYSYM_CIRCUMFLEX     : u64 = 0x005E
  pub let LD_KEYSYM_TILDE          : u64 = 0x007E
  pub let LD_KEYSYM_DIAERESIS      : u64 = 0x00A8
  pub let LD_KEYSYM_COMPOSE        : u64 = 0xFF20

  // ==========================================================================
  // SECTION 1.4 -- FAILURE TAXONOMY (0xFFFFE7B0..0xFFFFE7BF)
  // ==========================================================================
  //
  // Fresh 16-wide band. Rebased from the row prompt's
  // 0xFFFFEB70..EB7F (FULLY OCCUPIED by src/user/compositor/
  // workspace_kind.pdx's WKSP_* codes -- see file header). Grep-
  // verified free across src/ + tests/ + design/ at landing time.

  pub let LD_OK                    : u64 = 0
  pub let LD_ENGINE_NULL           : u64 = 0xFFFFE7BF  // engine_ptr == 0
  pub let LD_PROCESS_NULL          : u64 = 0xFFFFE7BE  // process_kind_id == 0
  pub let LD_TABLE_NULL            : u64 = 0xFFFFE7BD  // compose_table_ptr == 0
  pub let LD_ALREADY_INIT          : u64 = 0xFFFFE7BC  // engine already initialized
  pub let LD_NOT_INIT              : u64 = 0xFFFFE7BB  // op before init succeeded
  pub let LD_REGISTER_REFUSED      : u64 = 0xFFFFE7BA  // ime_provider_register
                                                        // returned refusal sentinel
                                                        // (upper 32 bits set)
  pub let LD_BAD_KEYCODE           : u64 = 0xFFFFE7B9  // keycode outside u16 range
                                                        // (upper 48 bits set)
  pub let LD_BAD_STATE             : u64 = 0xFFFFE7B8  // cell state field > DK_
                                                        // COMPOSE_2 (corruption
                                                        // detection; defence-in-
                                                        // depth against a rogue
                                                        // writer to cell[+16])
  // Slots 0xFFFFE7B7..0xFFFFE7B0 are RESERVED within this file's
  // band for future extension (locale-aware variant validators,
  // compose-table checksum failures once the substrate lands).

  // ==========================================================================
  // SECTION 1.5 -- ON-KEY RETURN-CODE TAGS
  // ==========================================================================
  //
  // The on_key body returns a u64 whose upper 32 bits are ZERO on
  // success (distinguishable from refusals, whose upper 32 bits are
  // set per the sibling latin_autocomplete convention). The success
  // encoding packs a small tag in the low byte and, for the
  // COMMITTED path, the composed u16 code point in bits [23:8]:
  //
  //   bits [7:0]     tag (LD_TAG_PASSTHROUGH / LD_TAG_PENDING /
  //                  LD_TAG_COMMITTED)
  //   bits [23:8]    composed code point (u16); meaningful only when
  //                  tag == LD_TAG_COMMITTED, zero otherwise
  //   bits [63:24]   0
  //
  // Callers demux via the low byte and, on COMMITTED, extract the
  // code point via shr 8 / and 0xFFFF (or shl 40 / shr 48).
  //
  // vs. autocomplete: autocomplete's commit_selected returns an
  // interned-string offset. Deadkey's on_key returns a raw u16
  // code point -- a single-character commit does not need to go
  // through the interned-string pool because a Unicode BMP code
  // point IS already the smallest wire form (a 16-bit value packed
  // in the return register). Multi-character commits (the fallback-
  // to-literal path when a dead-key sequence misses) are emitted as
  // TWO on_key calls' worth of return values; the caller drives the
  // second commit by re-invoking on_key with the base character
  // once the combiner has been committed (see LD_TAG_PASSTHROUGH_
  // WITH_COMBINER in the on_key body's fallback path).

  pub let LD_TAG_PASSTHROUGH               : u64 = 0
  pub let LD_TAG_PENDING                   : u64 = 1
  pub let LD_TAG_COMMITTED                 : u64 = 2

  // vs. autocomplete: LD_TAG_PASSTHROUGH_WITH_COMBINER signals a
  // fallback-to-literal event: the dead-key sequence missed, so
  // this on_key event commits the combiner as a spacing character
  // AND lets the current keystroke pass through as-is. The caller
  // is expected to consume TWO commits: first the combiner (bits
  // [23:8]), then the base (which the caller already has from its
  // own event source). Encoded as tag 3 to keep the low byte
  // distinct from the three pure-status tags above.
  pub let LD_TAG_PASSTHROUGH_WITH_COMBINER : u64 = 3

  // ==========================================================================
  // SECTION 1.6 -- FINGERPRINT (one line, legacy-suffixed)
  // ==========================================================================
  //
  // pdx_kind_latin_deadkey_meta: emitted once on successful engine
  // init by the future satellite-side substrate. Data-only at this
  // landing per the sibling B8 / B10 / B11 pattern (allowlisted in
  // tools/verify-fingerprint-coverage.sh as "latin deadkey init ok
  // [legacy: LATIN DEADKEY INIT OK]").
  //
  // Byte count: 53 content chars + 1 NUL = 54.
  pub let pdx_kind_latin_deadkey_meta : [u8; 54] = "latin deadkey init ok [legacy: LATIN DEADKEY INIT OK]\0"

  // Short field-name string constants for future debug-print use
  // (mirror ime_provider_k_row_id / ime_session_k_commit_seq /
  // latin_autocomplete_k_provider_id precedent).
  pub let latin_deadkey_k_provider_id : [u8; 12] = "provider_id\0"
  pub let latin_deadkey_k_state       : [u8; 6]  = "state\0"

  // ==========================================================================
  // SECTION 2 -- STATS CELL
  // ==========================================================================
  //
  // Module-level counters shared across every engine instance in
  // this process (typically one). Mirrors _latin_autocomplete_stats
  // / _provider_kind_stats layout.

  pub let mut _latin_deadkey_stats : [u64; 8] = uninit @align(64)

  // ==========================================================================
  // SECTION 3 -- STATS COUNTER SLOTS
  // ==========================================================================
  //
  // Seven named slots. A boot-log observer can verify KEY_EVENTS >=
  // COMMITS + RESETS (each commit and each explicit reset consumes
  // at least one prior key event).

  pub let LD_ST_KEY_EVENTS         : u64 = 0
  pub let LD_ST_COMMITS            : u64 = 1  // successful compose (dead+base
                                              // or Compose+c1+c2)
  pub let LD_ST_PENDINGS           : u64 = 2  // dead-key or Compose armed
  pub let LD_ST_RESETS             : u64 = 3  // ESC or state-machine reset
                                              // after a commit
  pub let LD_ST_LOOKUPS            : u64 = 4  // compose-table probes
  pub let LD_ST_INITS              : u64 = 5
  pub let LD_ST_REFUSED            : u64 = 6
  pub let LD_ST_MAX                : u64 = 7

  // ==========================================================================
  // SECTION 4 -- COUNTER PRIMITIVES
  // ==========================================================================

  // latin_deadkey_stats_reset() -> (): zero counters at boot.
  pub let latin_deadkey_stats_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-002 (paideia-os #2318): clear per-module counters at boot. Mirrors latin_autocomplete_stats_reset. Single low-first index scan over 8 u64 slots via load-inc-store; no callee-save pushes (leaf; only r10/rcx/rax touched beyond SysV in/out). Labels prefixed latin_deadkey_srs_.",
      block: {
        lea r10, [rip + _latin_deadkey_stats];
        xor rax, rax;
        xor rcx, rcx;
      latin_deadkey_srs_loop:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  latin_deadkey_srs_loop;
        ret
      }
    }

  // latin_deadkey_note(which) -> (): bump one stats counter.
  // Encoder-conservative load-inc-store; OOB is a silent no-op.
  pub let latin_deadkey_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-002 (paideia-os #2318): counter bump. Encoder-conservative load-inc-store; no add reg,[mem]. OOB is a silent no-op. Mirrors latin_autocomplete_note. Labels prefixed latin_deadkey_nt_.",
      block: {
        cmp rdi, 8;
        jae latin_deadkey_nt_out;
        lea r10, [rip + _latin_deadkey_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      latin_deadkey_nt_out:
        ret
      }
    }

  // latin_deadkey_stat(which) -> u64: read one stats counter.
  pub let latin_deadkey_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-002 (paideia-os #2318): counter read; OOB -> 0. Labels prefixed latin_deadkey_st_.",
      block: {
        cmp rdi, 8;
        jae latin_deadkey_st_zero;
        lea r10, [rip + _latin_deadkey_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      latin_deadkey_st_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // SECTION 5 -- VALIDATORS (pure leaves)
  // ==========================================================================

  // latin_deadkey_keycode_valid(keycode) -> 1 iff keycode < 2^16.
  // Keysyms are u16 on the wire; anything with upper 48 bits set is
  // corruption. Widened later if a future keysym extension pushes
  // the value space beyond u16.
  pub let latin_deadkey_keycode_valid : (u64) -> u64 !{} @{} =
    fn (keycode: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G11-M4-002 (paideia-os #2318): 1 iff keycode < 2^16. Encoder-conservative 16-bit range test via shr 16 / cmp 0. Labels prefixed latin_deadkey_kv_.",
      block: {
        mov rax, rdi;
        shr rax, 16;
        cmp rax, 0;
        jne latin_deadkey_kv_no;
        mov rax, 1;
        ret;
      latin_deadkey_kv_no:
        xor rax, rax;
        ret
      }
    }

  // latin_deadkey_state_valid(state) -> 1 iff state <= DK_COMPOSE_2.
  pub let latin_deadkey_state_valid : (u64) -> u64 !{} @{} =
    fn (state: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G11-M4-002 (paideia-os #2318): 1 iff state in {0,1,2,3}. Small-immediate cmp; encoder-conservative. Labels prefixed latin_deadkey_sv_.",
      block: {
        cmp rdi, 3;
        ja  latin_deadkey_sv_no;
        mov rax, 1;
        ret;
      latin_deadkey_sv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // SECTION 6 -- CELL-FIELD GETTERS
  // ==========================================================================
  //
  // Every getter takes the engine_ptr in rdi and returns the
  // requested field in rax. A null engine_ptr is undefined behavior
  // at the getter level (mirrors focus_router_get_* / input_server_
  // get_* / latin_autocomplete_get_* precedent).

  pub let latin_deadkey_get_provider_id : (u64) -> u64 !{mem} @{} =
    fn (engine_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-002 (paideia-os #2318): read provider_kind_id from cell[+0][31:0]. Zero-extension via shl+shr. Labels prefixed latin_deadkey_gpi_.",
      block: {
        mov rax, [rdi + 0];
        shl rax, 32;
        shr rax, 32;
        ret
      }
    }

  pub let latin_deadkey_get_session_id : (u64) -> u64 !{mem} @{} =
    fn (engine_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-002 (paideia-os #2318): read session_kind_id from cell[+0][63:32]. Labels prefixed latin_deadkey_gsi_.",
      block: {
        mov rax, [rdi + 0];
        shr rax, 32;
        ret
      }
    }

  pub let latin_deadkey_get_compose_ptr : (u64) -> u64 !{mem} @{} =
    fn (engine_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-002 (paideia-os #2318): read compose_table_ptr from cell[+8] (full u64). Labels prefixed latin_deadkey_gcp_.",
      block: {
        mov rax, [rdi + 8];
        ret
      }
    }

  pub let latin_deadkey_get_state : (u64) -> u64 !{mem} @{} =
    fn (engine_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-002 (paideia-os #2318): read state from cell[+16][7:0]. u8 extraction via shl 56 / shr 56. Labels prefixed latin_deadkey_gs_.",
      block: {
        mov rax, [rdi + 16];
        shl rax, 56;
        shr rax, 56;
        ret
      }
    }

  pub let latin_deadkey_get_pending_deadkey : (u64) -> u64 !{mem} @{} =
    fn (engine_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-002 (paideia-os #2318): read pending_deadkey from cell[+16][23:8]. u16 extraction via shr 8 / shl 48 / shr 48. Labels prefixed latin_deadkey_gpd_.",
      block: {
        mov rax, [rdi + 16];
        shr rax, 8;
        shl rax, 48;
        shr rax, 48;
        ret
      }
    }

  pub let latin_deadkey_get_compose_char1 : (u64) -> u64 !{mem} @{} =
    fn (engine_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-002 (paideia-os #2318): read compose_char1 from cell[+16][39:24]. u16 extraction via shr 24 / shl 48 / shr 48. Labels prefixed latin_deadkey_gcc_.",
      block: {
        mov rax, [rdi + 16];
        shr rax, 24;
        shl rax, 48;
        shr rax, 48;
        ret
      }
    }

  // ==========================================================================
  // SECTION 7 -- INIT FACTORY
  // ==========================================================================
  //
  // latin_deadkey_init(engine_ptr, process_kind_id, compose_table_ptr)
  //   -> u64
  //
  //   Populate a caller-owned 32-byte engine cell AND register this
  //   engine with the KIND_IME_PROVIDER substrate as a second
  //   LANG_LATIN provider (alongside the autocomplete provider
  //   #2317). Contract:
  //
  //     (1) engine_ptr == 0                     -> LD_ENGINE_NULL
  //     (2) process_kind_id == 0                -> LD_PROCESS_NULL
  //     (3) compose_table_ptr == 0              -> LD_TABLE_NULL
  //     (4) engine already initialized (cell[+0][31:0] != 0)
  //                                             -> LD_ALREADY_INIT
  //     (5) call ime_provider_register(process_kind_id, LD_LANG_LATIN,
  //                                    LD_LOCALE_UNLOCALED,
  //                                    LD_CAPS_DEFAULT);
  //         on refusal sentinel (upper 32 bits non-zero, i.e. any
  //         0xFFFFE9A* IMP_* code) return       -> LD_REGISTER_REFUSED
  //     (6) success: stamp the cell:
  //           cell[+0]   = provider_kind_id[31:0] | 0 (session not bound)
  //           cell[+8]   = compose_table_ptr (full u64)
  //           cell[+16]  = 0 (DK_IDLE, no pending, no compose_char1)
  //           cell[+24]  = 0 (session_bind_seq=0, reserved=0)
  //         bump LD_ST_INITS; return LD_OK.
  //
  //   Refusal funnel bumps LD_ST_REFUSED once at
  //   latin_deadkey_init_refused.
  //
  //   Register plan (four callee-save pushes + sub rsp,8 = 40 bytes;
  //   entry rsp%16==8 -> 40+8=48 %16==0 for nested calls
  //   (ime_provider_register + latin_deadkey_note)):
  //     rbx = engine_ptr
  //     r12 = process_kind_id
  //     r13 = compose_table_ptr
  //     r14 = provider_kind_id (from ime_provider_register)
  pub let latin_deadkey_init : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (engine_ptr: u64) (process_kind_id: u64) (compose_table_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-002 (paideia-os #2318): register + engine-cell init factory. Four callee-save pushes + sub rsp,8 = 40 bytes; entry rsp%16==8 -> 40+8=48 %16==0 for nested calls (ime_provider_register + latin_deadkey_note). Args stashed BEFORE any nested call: rbx=engine_ptr, r12=process_kind_id, r13=compose_table_ptr, r14 receives provider_kind_id. Refusal-sentinel detection on ime_provider_register uses shr r10,32 / cmp r10,0 (mirrors focus_router_change_focus / latin_autocomplete_init). Cell stamp writes four u64 words directly with `mov [rbx+off], rN` (encoder-conservative). No `test`, no `add reg,[mem]`, no MOVABS. Labels prefixed latin_deadkey_init_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        sub rsp, 8;

        mov rbx, rdi;                       // engine_ptr
        mov r12, rsi;                       // process_kind_id
        mov r13, rdx;                       // compose_table_ptr

        // (1) engine_ptr null
        cmp rbx, 0;
        je  latin_deadkey_init_null_engine;

        // (2) process_kind_id null
        cmp r12, 0;
        je  latin_deadkey_init_null_process;

        // (3) compose_table_ptr null
        cmp r13, 0;
        je  latin_deadkey_init_null_table;

        // (4) already-init check: cell[+0][31:0] (provider_kind_id) != 0
        mov rax, [rbx + 0];
        shl rax, 32;
        shr rax, 32;
        cmp rax, 0;
        jne latin_deadkey_init_already;

        // (5) register with ProviderKind substrate as LANG_LATIN.
        //     ime_provider_register(process, lang, locale, caps)
        //       rdi = process_kind_id
        //       rsi = LD_LANG_LATIN (0)
        //       rdx = LD_LOCALE_UNLOCALED (0)
        //       rcx = LD_CAPS_DEFAULT (0x00) -- vs. autocomplete's 0x03
        mov rdi, r12;
        xor rsi, rsi;                       // LD_LANG_LATIN = 0
        xor rdx, rdx;                       // LD_LOCALE_UNLOCALED = 0
        xor rcx, rcx;                       // LD_CAPS_DEFAULT = 0
        call ime_provider_register;

        // Refusal detection: IMP_* sentinels are 0xFFFFE9A0..AF, upper
        // 32 bits non-zero. A legal row_id is 0..7, upper 32 bits zero.
        mov r10, rax;
        shr r10, 32;
        cmp r10, 0;
        jne latin_deadkey_init_reg_refused;

        mov r14, rax;                       // r14 = provider_kind_id

        // (6) stamp the cell.

        // cell[+0]: provider_kind_id[31:0] | session_kind_id[63:32]=0
        mov rax, r14;
        shl rax, 32;
        shr rax, 32;                        // rax = provider_id & 0xFFFFFFFF
        mov [rbx + 0], rax;

        // cell[+8]: compose_table_ptr (full u64)
        mov [rbx + 8], r13;

        // cell[+16]: 0 (DK_IDLE, no pending, no compose_char1, reserved=0)
        xor rax, rax;
        mov [rbx + 16], rax;

        // cell[+24]: 0 (session_bind_seq=0, reserved=0)
        mov [rbx + 24], rax;

        // Bump LD_ST_INITS.
        mov rdi, 5;                         // LD_ST_INITS
        call latin_deadkey_note;

        xor rax, rax;                       // LD_OK
        jmp latin_deadkey_init_out;

      latin_deadkey_init_null_engine:
        mov rax, 0xFFFFE7BF;                // LD_ENGINE_NULL
        jmp latin_deadkey_init_refused;
      latin_deadkey_init_null_process:
        mov rax, 0xFFFFE7BE;                // LD_PROCESS_NULL
        jmp latin_deadkey_init_refused;
      latin_deadkey_init_null_table:
        mov rax, 0xFFFFE7BD;                // LD_TABLE_NULL
        jmp latin_deadkey_init_refused;
      latin_deadkey_init_already:
        mov rax, 0xFFFFE7BC;                // LD_ALREADY_INIT
        jmp latin_deadkey_init_refused;
      latin_deadkey_init_reg_refused:
        mov rax, 0xFFFFE7BA;                // LD_REGISTER_REFUSED
        // fallthrough

      latin_deadkey_init_refused:
        // Stash refusal code across the note call.
        mov r14, rax;
        mov rdi, 6;                         // LD_ST_REFUSED
        call latin_deadkey_note;
        mov rax, r14;

      latin_deadkey_init_out:
        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION 8 -- COMPOSE-TABLE LOOKUP
  // ==========================================================================
  //
  // latin_deadkey_lookup(engine_ptr, dead, base) -> composed | 0
  //
  //   Probe the compose table for a composition of (dead, base).
  //   Returns the composed unicode code point on hit (a u16 value
  //   in the low bits of the u64 return; upper 48 bits zero), or 0
  //   on miss. Refuses to run against an unregistered engine
  //   (LD_ENGINE_NULL / LD_NOT_INIT) but does not gate the (dead,
  //   base) keycode range at this layer -- the caller is expected
  //   to have already validated via keycode_valid on the on_key
  //   path.
  //
  //   Body is CURRENTLY a stub: bumps LD_ST_LOOKUPS and returns 0.
  //   The real lookup implementation is deferred to the satellite-
  //   side substrate that wires the compose-table format (a
  //   perfect-hash or simple hash table over (dead, base) pairs
  //   with u16 composed values as leaves). The state machine's
  //   correctness does not depend on the lookup body: a stubbed
  //   lookup makes every on_key sequence take the "fallback to
  //   literal" arm, which is one of the two legitimate outcomes
  //   the state machine handles. Once the real lookup lands, hits
  //   take the composed-glyph arm instead.
  //
  //   Register plan (one callee-save push = 8 bytes; entry rsp%16==8
  //   -> after push rsp%16==0 for the note call; odd-push-count
  //   keeps SysV alignment on its own):
  //     rbx = holds return value 0 across the note call
  pub let latin_deadkey_lookup : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (engine_ptr: u64) (dead: u64) (base: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-002 (paideia-os #2318): compose-table probe (currently a stub that returns 0; real lookup deferred to satellite substrate). One callee-save push = 8 bytes; entry rsp%16==8 -> after push rsp%16==0 for the note call. Order: null / init gates, then bump LD_ST_LOOKUPS, return 0. Labels prefixed latin_deadkey_lu_.",
      block: {
        push rbx;

        // (1) engine_ptr null
        cmp rdi, 0;
        je  latin_deadkey_lu_null_engine;

        // (2) init check
        mov rax, [rdi + 0];
        shl rax, 32;
        shr rax, 32;
        cmp rax, 0;
        je  latin_deadkey_lu_not_init;

        // Stub: real lookup pending satellite substrate. Return 0
        // (miss) unconditionally. Bump LD_ST_LOOKUPS to record the
        // probe attempt so the state machine's compose-attempt count
        // is visible in the stats cell even before the real lookup
        // lands.
        xor rbx, rbx;
        mov rdi, 4;                         // LD_ST_LOOKUPS
        call latin_deadkey_note;
        mov rax, rbx;                       // 0 = miss
        jmp latin_deadkey_lu_out;

      latin_deadkey_lu_null_engine:
        mov rax, 0xFFFFE7BF;                // LD_ENGINE_NULL
        jmp latin_deadkey_lu_refused;
      latin_deadkey_lu_not_init:
        mov rax, 0xFFFFE7BB;                // LD_NOT_INIT
        // fallthrough

      latin_deadkey_lu_refused:
        mov rbx, rax;
        mov rdi, 6;                         // LD_ST_REFUSED
        call latin_deadkey_note;
        mov rax, rbx;

      latin_deadkey_lu_out:
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION 9 -- STATE-MACHINE ENTRY POINT
  // ==========================================================================
  //
  // latin_deadkey_on_key(engine_ptr, keycode, is_deadkey) -> u64
  //
  //   Dispatch a single key event through the state machine. The
  //   is_deadkey flag disambiguates:
  //
  //     is_deadkey == 1  This key is a dead-key or Compose keysym.
  //                      In DK_IDLE, transitions to DK_AWAITING_BASE
  //                      (dead) or DK_COMPOSE_1 (Compose). In any
  //                      other state, treats as a reset then arm.
  //
  //     is_deadkey == 0  This key is a normal character. In DK_IDLE,
  //                      passes through unchanged. In DK_AWAITING_
  //                      BASE, probes the compose table with
  //                      (pending_deadkey, keycode); on hit, commits
  //                      the composed glyph; on miss, commits the
  //                      combiner as a spacing character (fallback
  //                      to literal). In DK_COMPOSE_1, stashes as
  //                      compose_char1 and transitions to DK_COMPOSE_
  //                      2. In DK_COMPOSE_2, probes with (compose_
  //                      char1, keycode); on hit, commits the
  //                      composed glyph; on miss, commits compose_
  //                      char1 literal and lets keycode passthrough.
  //
  //   Returns (per §1.5 return encoding):
  //     LD_TAG_PASSTHROUGH             (0) low byte -- pass the
  //                                        keycode through untouched
  //     LD_TAG_PENDING                 (1) low byte -- state armed,
  //                                        no output yet
  //     LD_TAG_COMMITTED               (2) low byte, composed char
  //                                        in bits [23:8]
  //     LD_TAG_PASSTHROUGH_WITH_COMBINER  (3) low byte, spacing
  //                                        combiner in bits [23:8]
  //                                        (caller commits that,
  //                                        then re-issues the
  //                                        original keycode as
  //                                        passthrough)
  //
  //   Refusal sentinels (upper 32 bits set):
  //     LD_ENGINE_NULL / LD_NOT_INIT / LD_BAD_KEYCODE / LD_BAD_STATE
  //
  //   Register plan (three callee-save pushes = 24 bytes; entry
  //   rsp%16==8 -> after three pushes rsp%16 == (8-24) mod 16 == 0,
  //   aligned for nested calls; no padding sub needed as three
  //   pushes give SysV alignment on their own):
  //     rbx = engine_ptr
  //     r12 = keycode
  //     r13 = is_deadkey (0 or 1)
  pub let latin_deadkey_on_key : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (engine_ptr: u64) (keycode: u64) (is_deadkey: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-002 (paideia-os #2318): state-machine entry point. Three callee-save pushes = 24 bytes; entry rsp%16==8 -> (8-24) mod 16 == 0, aligned for nested calls (latin_deadkey_keycode_valid + latin_deadkey_lookup + latin_deadkey_note). Order: (1) null gate. (2) init gate. (3) keycode range gate. (4) load state from cell[+16][7:0]. (5) branch on state x is_deadkey matrix (nine cases; state 3 x deadkey==1 collapses onto reset-and-arm to match ESC semantics). (6) rewrite cell[+16] with new state + pending fields. (7) bump LD_ST_KEY_EVENTS + one of LD_ST_COMMITS / LD_ST_PENDINGS / LD_ST_RESETS depending on outcome. (8) return packed status word per §1.5. r12 keeps keycode live across nested calls; r13 keeps is_deadkey. No `test`, no `add reg,[mem]`, no MOVABS. Small immediates only. Labels prefixed latin_deadkey_ok_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;
        mov r12, rsi;
        mov r13, rdx;

        // (1) engine_ptr null
        cmp rbx, 0;
        je  latin_deadkey_ok_null_engine;

        // (2) init check
        mov rax, [rbx + 0];
        shl rax, 32;
        shr rax, 32;
        cmp rax, 0;
        je  latin_deadkey_ok_not_init;

        // (3) keycode validity (must fit in u16)
        mov rdi, r12;
        call latin_deadkey_keycode_valid;
        cmp rax, 0;
        je  latin_deadkey_ok_bad_key;

        // (4) load state from cell[+16][7:0]
        mov rax, [rbx + 16];
        shl rax, 56;
        shr rax, 56;                        // rax = state

        // (5) validate state (defence-in-depth against corrupt cell)
        cmp rax, 3;
        ja  latin_deadkey_ok_bad_state;

        // (6) key-event stats bump (all paths). This happens BEFORE
        //     the branch so refusal-vs-success accounting is uniform.
        mov r10, rax;                       // preserve state across note call
        mov rdi, 0;                         // LD_ST_KEY_EVENTS
        call latin_deadkey_note;
        mov rax, r10;                       // restore state

        // (7) state x is_deadkey dispatch. is_deadkey in r13.
        cmp r13, 0;
        jne latin_deadkey_ok_deadkey_path;

        // ------ is_deadkey == 0 (normal character) ------
        cmp rax, 0;
        je  latin_deadkey_ok_idle_pass;     // DK_IDLE + char -> passthrough
        cmp rax, 1;
        je  latin_deadkey_ok_await_base;    // DK_AWAITING_BASE + char -> compose
        cmp rax, 2;
        je  latin_deadkey_ok_stash_c1;      // DK_COMPOSE_1 + char -> stash + wait
        // rax == 3 (DK_COMPOSE_2)
        jmp latin_deadkey_ok_compose_c2;    // DK_COMPOSE_2 + char -> lookup + commit

        // ------ is_deadkey == 1 (dead-key or Compose keysym) ------
      latin_deadkey_ok_deadkey_path:
        // Determine whether this is Compose (LD_KEYSYM_COMPOSE=0xFF20)
        // or a dead-key combiner. r12 has the keycode (u16-clean by
        // the range gate above).
        //
        // We short-circuit any current state: pressing a fresh dead-
        // key or Compose while a composition is already in flight
        // starts a NEW composition (the old one is silently
        // abandoned, mirroring XKB's dead-key semantics).
        cmp r12, 0xFF20;                    // LD_KEYSYM_COMPOSE
        je  latin_deadkey_ok_arm_compose;
        // else: dead-key combiner
        jmp latin_deadkey_ok_arm_dead;

        // ==============================================================
        // Arm dead-key: state <- DK_AWAITING_BASE, pending_deadkey <- r12
        // ==============================================================
      latin_deadkey_ok_arm_dead:
        // Rewrite cell[+16] with state=1 and pending_deadkey=r12 &
        // 0xFFFF; compose_char1 cleared; reserved preserved-as-zero
        // (this file never writes reserved bits; caller must not
        // either, but we zero them here to normalize on the
        // fresh-composition entry).
        //
        // Pack: state=1 | (r12 & 0xFFFF) << 8
        mov rax, r12;
        shl rax, 48;
        shr rax, 48;                        // rax = keycode & 0xFFFF
        shl rax, 8;                         // rax = keycode << 8
        or  rax, 1;                         // rax |= DK_AWAITING_BASE
        mov [rbx + 16], rax;

        // Bump LD_ST_PENDINGS
        mov rdi, 2;                         // LD_ST_PENDINGS
        call latin_deadkey_note;

        // Return LD_TAG_PENDING (1)
        mov rax, 1;
        jmp latin_deadkey_ok_out;

        // ==============================================================
        // Arm Compose: state <- DK_COMPOSE_1
        // ==============================================================
      latin_deadkey_ok_arm_compose:
        // Rewrite cell[+16] with state=2 (DK_COMPOSE_1); pending
        // and compose_char1 both cleared.
        mov rax, 2;                         // DK_COMPOSE_1
        mov [rbx + 16], rax;

        mov rdi, 2;                         // LD_ST_PENDINGS
        call latin_deadkey_note;

        mov rax, 1;                         // LD_TAG_PENDING
        jmp latin_deadkey_ok_out;

        // ==============================================================
        // DK_IDLE + normal char -> passthrough
        // ==============================================================
      latin_deadkey_ok_idle_pass:
        xor rax, rax;                       // LD_TAG_PASSTHROUGH (0)
        jmp latin_deadkey_ok_out;

        // ==============================================================
        // DK_AWAITING_BASE + normal char -> lookup (pending, char)
        // On hit: commit composed glyph, reset to DK_IDLE.
        // On miss: commit combiner as spacing char, reset to DK_IDLE,
        //          signal PASSTHROUGH_WITH_COMBINER so caller handles
        //          the base character separately.
        // ==============================================================
      latin_deadkey_ok_await_base:
        // Extract pending_deadkey from cell[+16][23:8] into r10.
        mov r10, [rbx + 16];
        shr r10, 8;
        shl r10, 48;
        shr r10, 48;                        // r10 = pending_deadkey (u16)

        // Reset cell[+16] to DK_IDLE eagerly (both outcomes end there,
        // and doing the reset before the lookup call keeps the note
        // primitives from having to re-lift state).
        xor rax, rax;
        mov [rbx + 16], rax;

        // Call lookup(engine_ptr=rbx, dead=r10, base=r12).
        // r10 must be moved into rsi (dead), r12 into rdx (base),
        // rbx into rdi (engine_ptr). r10 dies across the call, so
        // stash into r13 first (we no longer need r13's is_deadkey
        // beyond this point -- we're already on the is_deadkey==0
        // arm and the value is redundant).
        mov r13, r10;                       // r13 = pending_deadkey (survives call)
        mov rdi, rbx;
        mov rsi, r10;
        mov rdx, r12;
        call latin_deadkey_lookup;

        // rax = composed | 0. Check for hit.
        cmp rax, 0;
        je  latin_deadkey_ok_await_miss;

        // Hit: pack composed char into return. rax already holds the
        // u16 composed value (upper bits zero per lookup contract).
        shl rax, 8;                         // composed << 8
        or  rax, 2;                         // | LD_TAG_COMMITTED
        // Bump LD_ST_COMMITS + LD_ST_RESETS (compose ended).
        mov r10, rax;                       // preserve return across notes
        mov rdi, 1;                         // LD_ST_COMMITS
        call latin_deadkey_note;
        mov rdi, 3;                         // LD_ST_RESETS
        call latin_deadkey_note;
        mov rax, r10;
        jmp latin_deadkey_ok_out;

      latin_deadkey_ok_await_miss:
        // Miss: emit the combiner (r13 = pending_deadkey) as a
        // spacing character. Pack into LD_TAG_PASSTHROUGH_WITH_
        // COMBINER (3): bits [23:8] = combiner, low byte = 3.
        mov rax, r13;
        shl rax, 8;
        or  rax, 3;                         // LD_TAG_PASSTHROUGH_WITH_COMBINER
        // Bump LD_ST_RESETS (composition ended without a commit).
        mov r10, rax;
        mov rdi, 3;                         // LD_ST_RESETS
        call latin_deadkey_note;
        mov rax, r10;
        jmp latin_deadkey_ok_out;

        // ==============================================================
        // DK_COMPOSE_1 + normal char -> stash char, transition to
        // DK_COMPOSE_2, return PENDING.
        // ==============================================================
      latin_deadkey_ok_stash_c1:
        // Pack: state=3 (DK_COMPOSE_2) | 0 (pending) | (keycode & 0xFFFF)
        // in bits [39:24].
        mov rax, r12;
        shl rax, 48;
        shr rax, 48;                        // rax = keycode & 0xFFFF
        shl rax, 24;                        // rax = keycode << 24 (compose_char1)
        or  rax, 3;                         // rax |= DK_COMPOSE_2
        mov [rbx + 16], rax;

        mov rdi, 2;                         // LD_ST_PENDINGS
        call latin_deadkey_note;

        mov rax, 1;                         // LD_TAG_PENDING
        jmp latin_deadkey_ok_out;

        // ==============================================================
        // DK_COMPOSE_2 + normal char -> lookup (compose_char1, char)
        // On hit: commit composed glyph, reset to DK_IDLE.
        // On miss: emit compose_char1 as literal (fallback), reset,
        //          signal PASSTHROUGH_WITH_COMBINER (caller emits
        //          keycode as its own passthrough on a subsequent
        //          re-issue).
        // ==============================================================
      latin_deadkey_ok_compose_c2:
        // Extract compose_char1 from cell[+16][39:24] into r10.
        mov r10, [rbx + 16];
        shr r10, 24;
        shl r10, 48;
        shr r10, 48;                        // r10 = compose_char1 (u16)

        // Reset cell[+16] to DK_IDLE eagerly (both outcomes end there).
        xor rax, rax;
        mov [rbx + 16], rax;

        mov r13, r10;                       // r13 = compose_char1 (survives call)
        mov rdi, rbx;
        mov rsi, r10;
        mov rdx, r12;
        call latin_deadkey_lookup;

        cmp rax, 0;
        je  latin_deadkey_ok_compose_miss;

        // Hit: pack composed char into return.
        shl rax, 8;
        or  rax, 2;                         // LD_TAG_COMMITTED
        mov r10, rax;
        mov rdi, 1;                         // LD_ST_COMMITS
        call latin_deadkey_note;
        mov rdi, 3;                         // LD_ST_RESETS
        call latin_deadkey_note;
        mov rax, r10;
        jmp latin_deadkey_ok_out;

      latin_deadkey_ok_compose_miss:
        // Miss: emit compose_char1 (r13) as literal. The caller is
        // responsible for the second character (r12); the state
        // machine has reset to IDLE so the caller can re-issue r12
        // as a fresh on_key call which will fall to the passthrough
        // arm (or, if r12 happens to be a dead-key, re-arm the
        // machine). We do not emit two commits from a single on_key
        // call -- the return-value shape is one commit per call.
        mov rax, r13;
        shl rax, 8;
        or  rax, 3;                         // LD_TAG_PASSTHROUGH_WITH_COMBINER
        mov r10, rax;
        mov rdi, 3;                         // LD_ST_RESETS
        call latin_deadkey_note;
        mov rax, r10;
        jmp latin_deadkey_ok_out;

        // ==============================================================
        // Refusal exits
        // ==============================================================
      latin_deadkey_ok_null_engine:
        mov rax, 0xFFFFE7BF;                // LD_ENGINE_NULL
        jmp latin_deadkey_ok_refused;
      latin_deadkey_ok_not_init:
        mov rax, 0xFFFFE7BB;                // LD_NOT_INIT
        jmp latin_deadkey_ok_refused;
      latin_deadkey_ok_bad_key:
        mov rax, 0xFFFFE7B9;                // LD_BAD_KEYCODE
        jmp latin_deadkey_ok_refused;
      latin_deadkey_ok_bad_state:
        mov rax, 0xFFFFE7B8;                // LD_BAD_STATE
        // fallthrough

      latin_deadkey_ok_refused:
        mov r13, rax;
        mov rdi, 6;                         // LD_ST_REFUSED
        call latin_deadkey_note;
        mov rax, r13;

      latin_deadkey_ok_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION 10 -- RESET (ESC)
  // ==========================================================================
  //
  // latin_deadkey_reset(engine_ptr) -> u64
  //
  //   Discard any in-flight composition without committing: clear
  //   state, pending_deadkey, compose_char1. The engine stays
  //   registered; the next on_key starts fresh.
  //
  //   Contract:
  //     (1) engine_ptr == 0            -> LD_ENGINE_NULL
  //     (2) provider_kind_id == 0      -> LD_NOT_INIT
  //     (3) success: cell[+16] := 0; bump LD_ST_RESETS; return LD_OK.
  //
  //   A reset on an already-idle engine is still counted -- an
  //   Escape keypress with no in-flight composition is a legitimate
  //   no-op the user may issue, and the telemetry records it
  //   faithfully (mirrors latin_autocomplete_cancel).
  //
  //   Register plan (one callee-save push = 8 bytes; entry rsp%16==8
  //   -> after push rsp%16 == 0, aligned for the note call;
  //   odd-push-count keeps SysV alignment):
  //     rbx = engine_ptr / refusal code holder on the refusal exit
  pub let latin_deadkey_reset : (u64) -> u64 !{mem} @{} =
    fn (engine_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-002 (paideia-os #2318): clear in-flight composition state. One callee-save push = 8 bytes; entry rsp%16==8 -> after push rsp%16==0, aligned for the note call. Order: null / init gates, clear cell[+16], bump LD_ST_RESETS, return LD_OK. Mirrors latin_autocomplete_cancel. Labels prefixed latin_deadkey_rx_.",
      block: {
        push rbx;

        mov rbx, rdi;

        // (1) engine_ptr null
        cmp rbx, 0;
        je  latin_deadkey_rx_null_engine;

        // (2) init check
        mov rax, [rbx + 0];
        shl rax, 32;
        shr rax, 32;
        cmp rax, 0;
        je  latin_deadkey_rx_not_init;

        // Clear cell[+16] (state / pending / compose_char1).
        xor rax, rax;
        mov [rbx + 16], rax;

        // Bump LD_ST_RESETS.
        mov rdi, 3;                         // LD_ST_RESETS
        call latin_deadkey_note;

        xor rax, rax;                       // LD_OK
        jmp latin_deadkey_rx_out;

      latin_deadkey_rx_null_engine:
        mov rax, 0xFFFFE7BF;                // LD_ENGINE_NULL
        jmp latin_deadkey_rx_refused;
      latin_deadkey_rx_not_init:
        mov rax, 0xFFFFE7BB;                // LD_NOT_INIT
        // fallthrough

      latin_deadkey_rx_refused:
        // Stash refusal across the note call (rbx no longer needs to
        // hold engine_ptr past this point -- we're on the refusal
        // exit; mirrors latin_autocomplete_cancel's identical idiom).
        mov rbx, rax;
        mov rdi, 6;                         // LD_ST_REFUSED
        call latin_deadkey_note;
        mov rax, rbx;

      latin_deadkey_rx_out:
        pop rbx;
        ret
      }
    }
}
