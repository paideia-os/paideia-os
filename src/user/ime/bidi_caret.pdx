// src/user/ime/bidi_caret.pdx -- G11-M5-001 (paideia-os #2324)
//
// BIDIRECTIONAL CARET NAVIGATION + SELECTION ANCHOR MIRRORING.
//
// A userspace text-editing primitive that tracks TWO parallel caret
// coordinates over a paragraph of bidirectional text:
//
//   * LOGICAL offset  -- position in the SOURCE character stream
//                        (the order the user typed characters). This
//                        is what downstream text operations (insert,
//                        delete, save-to-file, feed-to-parser) index
//                        against.
//
//   * VISUAL column   -- position in the RENDERED display order (the
//                        left-to-right order the glyphs appear on the
//                        screen after the Unicode Bidirectional
//                        Algorithm has resolved the mixed-direction
//                        runs). This is what the user's spatial
//                        expectation ("the arrow keys go left/right
//                        on the screen") reads against.
//
// A single caret carries BOTH, kept in sync at every keystroke, so the
// user sees the caret move visually (matching their expectation for
// left-arrow / right-arrow keys) while every editing op indexes the
// text logically (matching the byte-order the file was written in).
// This is the ONLY correct arrangement for bidi text editing; a
// logical-only caret jumps discontinuously on the screen inside RTL
// runs (right-arrow moves LEFT in an RTL word), and a visual-only
// caret cannot locate the edit point in the source buffer.
//
// The direction_hint disambiguates BOUNDARY carets -- a caret at the
// boundary between an LTR run and an RTL run has TWO valid visual
// positions (the right edge of the LTR run == the right edge of the
// RTL run when a right-to-left run follows a left-to-right run). The
// hint records which side the caret entered from, so a subsequent
// arrow-key movement stays coherent with the run the user was just
// editing in. This mirrors the "strong left" / "strong right" caret
// bias used by CoreText (macOS/iOS) and DirectWrite (Windows) since
// ~2010.
//
// Design authority:
//   * design/compositor/pwp-spec-vocabulary.md §2.20 KIND_IME_ROUTER
//     -- names bidi-aware caret navigation as part of the router-side
//     text-editing substrate. The router owns caret state for the
//     currently focused editable surface; this file's BidiCaret cell
//     is the caller-owned state the router allocates per focus.
//   * src/user/ime/session_kind.pdx §1.3 (COMMIT_TEXT op semantics)
//     -- describes the point in the input flow where a caret update
//     is broadcast to observers; the caret's logical_offset drives
//     the cursor position the session reports on commit.
//   * Unicode Standard Annex #9 "Unicode Bidirectional Algorithm"
//     (UBA), revision matched by the sibling bidi_uba.pdx substrate
//     (G11-M4-007, Wave-0 B13-05, in-flight in parallel), which owns
//     the paragraph analysis this file's helpers consume. The
//     paragraph_ptr passed at init time addresses a BidiParagraph
//     structure owned by that substrate.
//   * design/kernel/kind-ime-router.md §3 caret bias (draft) -- the
//     "boundary caret with direction hint" scheme; this file's
//     direction_hint field is the wire form.
//
// CALLER-OWNED CELL. One 32-byte cell per caret, allocated by the
// caller (typically the KIND_IME_ROUTER's per-session cursor cell, or
// a text-editor's own per-textfield state). Mirrors the caller-owned
// cell convention of focus_router / input_server / latin_
// autocomplete / latin_deadkey. Multiple carets per paragraph is
// legal (a text editor with rectangular / multi-cursor selection
// allocates one BidiCaret per cursor).
//
// LTR-STUB HELPERS. bidi_caret_logical_to_visual and bidi_caret_
// visual_to_logical are currently STUBBED: they return the input
// unchanged (visual == logical), which is CORRECT for a pure-LTR
// paragraph. The real bidi-aware conversion is deferred to the
// integration landing that wires this file against the bidi_uba
// substrate (paragraph analysis, run resolution). The state machine
// exercised by the movement primitives (move_left / move_right /
// extend_selection) is FULLY IMPLEMENTED against the stub: cursor
// movement, boundary clamping, anchor mirroring, and stats bumping
// all work end-to-end. Once the bidi_uba integration lands, the
// helpers switch from LTR-only to full UBA-driven conversion without
// any change to the movement primitives -- the movement code calls
// the helpers via label, so replacing the helper body is a local
// edit.
//
// Rationale (why stub-then-integrate rather than external calls now):
// bidi_uba.pdx is being written in parallel (B13-05 companion row).
// Its exact export surface (function names, register conventions) is
// not yet frozen. A parallel-batch dependency across two files being
// authored simultaneously has a well-documented failure mode -- one
// side pins an interface that the other side has not yet exported,
// and both fail to link. Following the latin_deadkey_lookup precedent
// (the compose-table lookup is stubbed pending the compose-table
// format), this file compiles + links standalone; the integration
// wires the two together in a later landing.
//
// LABEL PREFIX. `bidi_caret_` throughout, sidestepping paideia-as
// reserved-word collisions (see feedback_paideia_as_reserved_labels).
// Every ASM jump target is `bidi_caret_<funcname>_<tag>`.
//
// MECE SCOPE. Single file under src/user/ime/. Touches only:
//   * NEW: src/user/ime/bidi_caret.pdx (this file)
//   * EDIT: tools/verify-fingerprint-coverage.sh (add allowlist entry
//           for pdx_kind_bidi_caret_meta since the substrate-side
//           dispatcher that would emit it is a future landing)
// No other file is modified.
//
// FAILURE BAND. 0xFFFFE810..0xFFFFE81F -- fresh 16-wide band assigned
// by the row prompt; grep-verified free across src/ + tests/ +
// design/ at landing time. Adjacent to nothing yet allocated in the
// 0xFFFFE800..0xFFFFE8FF page, leaving contiguous headroom for the
// sibling G11.M5 text-editing rows (visual-mode selection, drag-
// gesture selection, word/paragraph movement).
//
// FINGERPRINT. One legacy-suffixed init fingerprint per the standard
// klog convention (matches session_kind / provider_kind / latin_
// autocomplete / latin_deadkey precedent). Emitted once on successful
// caret init by the future KIND_IME_ROUTER-side substrate; no
// fingerprint on per-movement paths (arrow keys fire many times per
// second in typing and would flood the ring, same rationale as
// latin_deadkey's per-keystroke silence). Until the router substrate
// lands, the tag is DATA-ONLY (declared here but not emitted from any
// body) -- verify-fingerprint-coverage.sh gets a matching allowlist
// entry per the sibling B11/B12 pattern.
//
// Encoder-conservative pattern per latin_deadkey / latin_autocomplete
// / session_kind / provider_kind: no `and reg, imm64`, no MOVABS
// r64,imm64, no `test`, no `add reg,[mem]`, no `mov_bzx`/`mov_wzx`;
// 32-bit zero-extension via shl+shr; small immediates only. u32 field
// extraction from a packed u64 uses shl 32 / shr 32 (low half) or
// shr 32 (upper half). u8 field extraction uses shl 56 / shr 56.
//
// =============================================================================

module BidiCaret = structure {

  // ==========================================================================
  // SECTION 1.1 -- DIRECTION-HINT ENUM
  // ==========================================================================
  //
  // Two-valued: which side of a run boundary did the caret enter
  // from. Meaningful ONLY when logical_offset lands exactly on a
  // boundary between an LTR run and an RTL run (or vice versa); at
  // any interior position the hint is IGNORED (the run's own
  // direction determines the visual position).
  //
  //   BDC_DIR_HINT_AFTER_LTR (0)  Caret entered from the LTR side --
  //                               the previous character (in logical
  //                               order) was in an LTR run. Visual
  //                               position sits at the END of that
  //                               LTR run (its rightmost visual x).
  //
  //   BDC_DIR_HINT_AFTER_RTL (1)  Caret entered from the RTL side --
  //                               the previous character (in logical
  //                               order) was in an RTL run. Visual
  //                               position sits at the END of that
  //                               RTL run (its leftmost visual x,
  //                               since RTL runs render right-to-
  //                               left).
  //
  // The router's on_arrow_key body (out of scope for THIS landing)
  // updates the hint on every boundary-crossing move so a subsequent
  // arrow keeps moving in the "spatial" direction the user pressed,
  // not in the "logical" direction that would jump discontinuously.

  pub let BDC_DIR_HINT_AFTER_LTR   : u64 = 0
  pub let BDC_DIR_HINT_AFTER_RTL   : u64 = 1

  // ==========================================================================
  // SECTION 1.2 -- CARET CELL LAYOUT (BidiCaret, 32 bytes)
  // ==========================================================================
  //
  // Four u64 words holding the caret's per-instance state. Every
  // mutating op edits one or two packed fields IN PLACE; the row is
  // written by exactly one thread at a time (the router's per-focus
  // event loop is single-threaded per caret cell, mirroring the
  // per-seat single-thread invariant of focus_router).
  //
  // Cell layout (offsets in bytes):
  //
  //   [+0]  paragraph_ptr: u64
  //             pointer to the BidiParagraph analysis structure owned
  //             by the bidi_uba substrate (B13-05, in-flight in
  //             parallel). Nonzero after successful init; opaque to
  //             this file (helper bodies delegate paragraph
  //             interpretation to bidi_uba once integrated; currently
  //             LTR-stubbed).
  //
  //   [+8]  positions:
  //             logical_offset[31:0]     position in source text
  //                                      (character units, 0-based).
  //             visual_x[63:32]          position in rendered display
  //                                      order (visual column units,
  //                                      0-based). Equal to
  //                                      logical_offset under the LTR
  //                                      stub; diverges once bidi_uba
  //                                      integrates.
  //
  //   [+16] anchors:
  //             anchor_logical[31:0]     selection anchor in source
  //                                      text (the OTHER endpoint of
  //                                      the current selection). Equal
  //                                      to logical_offset when there
  //                                      is no active selection (i.e.
  //                                      caret is a point, not a
  //                                      range).
  //             anchor_visual[63:32]     selection anchor in rendered
  //                                      display order. Mirrored from
  //                                      anchor_logical via the same
  //                                      helper the caret uses.
  //
  //   [+24] flags_and_reserved:
  //             direction_hint[7:0]      BDC_DIR_HINT_AFTER_LTR (0) /
  //                                      BDC_DIR_HINT_AFTER_RTL (1).
  //                                      Zeroed at init; the future
  //                                      router substrate updates it
  //                                      on boundary-crossing moves.
  //             reserved[63:8]           0 at init; future flags
  //                                      (visual-selection-mode,
  //                                      overwrite-vs-insert, ...)
  //                                      land here.
  //
  // Cell is 32 bytes = one half of a 64-byte cache line. Cache-line
  // alignment is CALLER'S responsibility (mirrors sibling latin_
  // deadkey / latin_autocomplete).
  //
  // Documentation-only struct declaration (mirrors DeadkeyEngine /
  // LatinAutocompleteEngine / FocusRouterState precedent).

  struct BidiCaret {
    paragraph_ptr: u64,
    logical_offset: u32,
    visual_x: u32,
    anchor_logical: u32,
    anchor_visual: u32,
    direction_hint: u8
  }

  pub let BDC_CELL_BYTES               : u64 = 32
  pub let BDC_CELL_OFF_PARAGRAPH       : u64 = 0
  pub let BDC_CELL_OFF_POSITIONS       : u64 = 8
  pub let BDC_CELL_OFF_ANCHORS         : u64 = 16
  pub let BDC_CELL_OFF_FLAGS           : u64 = 24

  // ==========================================================================
  // SECTION 1.3 -- FAILURE TAXONOMY (0xFFFFE810..0xFFFFE81F)
  // ==========================================================================
  //
  // Fresh 16-wide band assigned by the row prompt (paideia-os #2324);
  // grep-verified free across src/ + tests/ + design/ at landing
  // time. Refusal sentinels have upper 32 bits set; a legitimate
  // return value has upper 32 bits zero (mirrors sibling latin_
  // deadkey / latin_autocomplete refusal-vs-success discrimination).

  pub let BDC_OK                       : u64 = 0
  pub let BDC_CARET_NULL               : u64 = 0xFFFFE81F  // caret_ptr == 0
  pub let BDC_PARAGRAPH_NULL           : u64 = 0xFFFFE81E  // paragraph_ptr == 0
  pub let BDC_ALREADY_INIT             : u64 = 0xFFFFE81D  // caret already initialized
  pub let BDC_NOT_INIT                 : u64 = 0xFFFFE81C  // op before init succeeded
  pub let BDC_BAD_OFFSET               : u64 = 0xFFFFE81B  // logical offset outside
                                                            // u32 range (upper 32 bits
                                                            // set)
  pub let BDC_BAD_VISUAL               : u64 = 0xFFFFE81A  // visual column outside u32
                                                            // range (upper 32 bits set)
  pub let BDC_BAD_DIRECTION_HINT       : u64 = 0xFFFFE819  // direction_hint > 1
  // Slots 0xFFFFE818..0xFFFFE810 are RESERVED within this file's
  // band for future extension (paragraph-length validators once the
  // bidi_uba integration lands, boundary-crossing sentinels for the
  // router's boundary-hint update path).

  // ==========================================================================
  // SECTION 1.4 -- FINGERPRINT (one line, legacy-suffixed)
  // ==========================================================================
  //
  // pdx_kind_bidi_caret_meta: emitted once on successful caret init
  // by the future KIND_IME_ROUTER-side substrate. Data-only at this
  // landing per the sibling B8 / B10 / B11 / B12 pattern (allowlisted
  // in tools/verify-fingerprint-coverage.sh as "bidi caret init ok
  // [legacy: BIDI CARET INIT OK]").
  //
  // Byte count: 47 content chars + 1 NUL = 48.
  pub let pdx_kind_bidi_caret_meta : [u8; 48] = "bidi caret init ok [legacy: BIDI CARET INIT OK]\0"

  // Short field-name string constants for future debug-print use
  // (mirror latin_deadkey_k_provider_id / latin_autocomplete_k_
  // provider_id precedent).
  pub let bidi_caret_k_paragraph   : [u8; 10] = "paragraph\0"
  pub let bidi_caret_k_logical     : [u8; 8]  = "logical\0"
  pub let bidi_caret_k_visual      : [u8; 7]  = "visual\0"

  // ==========================================================================
  // SECTION 2 -- STATS CELL
  // ==========================================================================
  //
  // Module-level counters shared across every caret instance in this
  // process. Mirrors _latin_deadkey_stats / _latin_autocomplete_stats
  // / _provider_kind_stats layout.

  pub let mut _bidi_caret_stats : [u64; 8] = uninit @align(64)

  // ==========================================================================
  // SECTION 3 -- STATS COUNTER SLOTS
  // ==========================================================================
  //
  // Seven named slots. A boot-log observer can verify MOVES >=
  // BOUNDARY_JUMPS (every boundary jump is a move); L2V + V2L >=
  // MOVES + EXTENDS (each mutation triggers at least one conversion
  // once the bidi_uba integration lands; under the LTR stub the
  // helpers are still called to maintain the accounting invariant).

  pub let BDC_ST_INITS             : u64 = 0
  pub let BDC_ST_MOVES             : u64 = 1  // move_left + move_right
  pub let BDC_ST_EXTENDS           : u64 = 2  // extend_selection
  pub let BDC_ST_L2V               : u64 = 3  // logical_to_visual probes
  pub let BDC_ST_V2L               : u64 = 4  // visual_to_logical probes
  pub let BDC_ST_BOUNDARY_JUMPS    : u64 = 5  // a move that crossed an
                                              // LTR/RTL boundary (once
                                              // bidi_uba integrates;
                                              // never incremented under
                                              // the LTR stub)
  pub let BDC_ST_REFUSED           : u64 = 6
  pub let BDC_ST_MAX               : u64 = 7

  // ==========================================================================
  // SECTION 4 -- COUNTER PRIMITIVES
  // ==========================================================================

  // bidi_caret_stats_reset() -> (): zero counters at boot.
  pub let bidi_caret_stats_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M5-001 (paideia-os #2324): clear per-module counters at boot. Mirrors latin_deadkey_stats_reset. Single low-first index scan over 8 u64 slots via load-inc-store; no callee-save pushes (leaf; only r10/rcx/rax touched beyond SysV in/out). Labels prefixed bidi_caret_srs_.",
      block: {
        lea r10, [rip + _bidi_caret_stats];
        xor rax, rax;
        xor rcx, rcx;
      bidi_caret_srs_loop:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  bidi_caret_srs_loop;
        ret
      }
    }

  // bidi_caret_note(which) -> (): bump one stats counter.
  // Encoder-conservative load-inc-store; OOB is a silent no-op.
  pub let bidi_caret_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M5-001 (paideia-os #2324): counter bump. Encoder-conservative load-inc-store; no add reg,[mem]. OOB is a silent no-op. Mirrors latin_deadkey_note. Labels prefixed bidi_caret_nt_.",
      block: {
        cmp rdi, 8;
        jae bidi_caret_nt_out;
        lea r10, [rip + _bidi_caret_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      bidi_caret_nt_out:
        ret
      }
    }

  // bidi_caret_stat(which) -> u64: read one stats counter.
  pub let bidi_caret_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M5-001 (paideia-os #2324): counter read; OOB -> 0. Labels prefixed bidi_caret_st_.",
      block: {
        cmp rdi, 8;
        jae bidi_caret_st_zero;
        lea r10, [rip + _bidi_caret_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      bidi_caret_st_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // SECTION 5 -- VALIDATORS (pure leaves)
  // ==========================================================================

  // bidi_caret_offset_valid(off) -> 1 iff off < 2^32.
  // A caret offset must fit in u32 (a paragraph exceeding 4G characters
  // is not representable at this layer).
  pub let bidi_caret_offset_valid : (u64) -> u64 !{} @{} =
    fn (off: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G11-M5-001 (paideia-os #2324): 1 iff off < 2^32. Encoder-conservative 32-bit range test via shr 32 / cmp 0. Labels prefixed bidi_caret_ov_.",
      block: {
        mov rax, rdi;
        shr rax, 32;
        cmp rax, 0;
        jne bidi_caret_ov_no;
        mov rax, 1;
        ret;
      bidi_caret_ov_no:
        xor rax, rax;
        ret
      }
    }

  // bidi_caret_hint_valid(hint) -> 1 iff hint in {0, 1}.
  pub let bidi_caret_hint_valid : (u64) -> u64 !{} @{} =
    fn (hint: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G11-M5-001 (paideia-os #2324): 1 iff hint in {0,1}. Small-immediate cmp; encoder-conservative. Labels prefixed bidi_caret_hv_.",
      block: {
        cmp rdi, 1;
        ja  bidi_caret_hv_no;
        mov rax, 1;
        ret;
      bidi_caret_hv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // SECTION 6 -- CELL-FIELD GETTERS
  // ==========================================================================
  //
  // Every getter takes the caret_ptr in rdi and returns the requested
  // field in rax. A null caret_ptr is undefined behavior at the
  // getter level (mirrors focus_router_get_* / latin_deadkey_get_*
  // precedent).

  pub let bidi_caret_get_paragraph_ptr : (u64) -> u64 !{mem} @{} =
    fn (caret_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M5-001 (paideia-os #2324): read paragraph_ptr from cell[+0] (full u64). Labels prefixed bidi_caret_gpp_.",
      block: {
        mov rax, [rdi + 0];
        ret
      }
    }

  pub let bidi_caret_get_logical_offset : (u64) -> u64 !{mem} @{} =
    fn (caret_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M5-001 (paideia-os #2324): read logical_offset from cell[+8][31:0]. Zero-extension via shl+shr. Labels prefixed bidi_caret_glo_.",
      block: {
        mov rax, [rdi + 8];
        shl rax, 32;
        shr rax, 32;
        ret
      }
    }

  pub let bidi_caret_get_visual_x : (u64) -> u64 !{mem} @{} =
    fn (caret_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M5-001 (paideia-os #2324): read visual_x from cell[+8][63:32]. Labels prefixed bidi_caret_gvx_.",
      block: {
        mov rax, [rdi + 8];
        shr rax, 32;
        ret
      }
    }

  pub let bidi_caret_get_anchor_logical : (u64) -> u64 !{mem} @{} =
    fn (caret_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M5-001 (paideia-os #2324): read anchor_logical from cell[+16][31:0]. Labels prefixed bidi_caret_gal_.",
      block: {
        mov rax, [rdi + 16];
        shl rax, 32;
        shr rax, 32;
        ret
      }
    }

  pub let bidi_caret_get_anchor_visual : (u64) -> u64 !{mem} @{} =
    fn (caret_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M5-001 (paideia-os #2324): read anchor_visual from cell[+16][63:32]. Labels prefixed bidi_caret_gav_.",
      block: {
        mov rax, [rdi + 16];
        shr rax, 32;
        ret
      }
    }

  pub let bidi_caret_get_direction_hint : (u64) -> u64 !{mem} @{} =
    fn (caret_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M5-001 (paideia-os #2324): read direction_hint from cell[+24][7:0]. u8 extraction via shl 56 / shr 56. Labels prefixed bidi_caret_gdh_.",
      block: {
        mov rax, [rdi + 24];
        shl rax, 56;
        shr rax, 56;
        ret
      }
    }

  // ==========================================================================
  // SECTION 7 -- STUB HELPERS: LOGICAL <-> VISUAL CONVERSION
  // ==========================================================================
  //
  // bidi_caret_logical_to_visual(paragraph_ptr, logical) -> visual
  // bidi_caret_visual_to_logical(paragraph_ptr, visual)  -> logical
  //
  //   Convert between the two caret coordinates using the paragraph's
  //   BiDi analysis. The paragraph_ptr is OPAQUE to this file; the
  //   real interpretation is delegated to the bidi_uba substrate
  //   (B13-05, in-flight in parallel) once integrated.
  //
  //   BODY IS CURRENTLY A STUB: returns the input unchanged (visual
  //   == logical), which is CORRECT for a pure-LTR paragraph. This
  //   makes the movement primitives fully exercisable end-to-end: a
  //   left-arrow decrements both logical_offset and visual_x by 1,
  //   the anchor mirrors identically, and every LTR-only test passes.
  //   Once bidi_uba integrates, the helper body switches to a real
  //   UBA-driven conversion (walk the paragraph's resolved run list;
  //   locate the run containing the offset; compute the run-relative
  //   position and add the run's visual origin), and the movement
  //   primitives inherit the new behavior without change (they call
  //   these helpers via label).
  //
  //   Refuses on null paragraph_ptr (BDC_PARAGRAPH_NULL). No refusal
  //   on out-of-range offset: the caller is expected to have already
  //   validated via bidi_caret_offset_valid; if not, the stub returns
  //   the offset unchanged and the caller sees a nonsensical visual
  //   (which is the same failure mode a real UBA lookup would
  //   surface, minus a defensive gate at the helper layer that would
  //   only duplicate the caller's own validation).
  //
  //   Register plan (one callee-save push = 8 bytes; entry rsp%16==8
  //   -> after push rsp%16==0 for the note call):
  //     rbx = holds return value across the note call
  pub let bidi_caret_logical_to_visual : (u64, u64) -> u64 !{mem} @{} =
    fn (paragraph_ptr: u64) (logical: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M5-001 (paideia-os #2324): logical-to-visual conversion (currently a stub that returns logical unchanged; real UBA-driven conversion deferred to bidi_uba integration). One callee-save push = 8 bytes; entry rsp%16==8 -> after push rsp%16==0 for the note call. Order: null gate, bump BDC_ST_L2V, return logical unchanged. Labels prefixed bidi_caret_l2v_.",
      block: {
        push rbx;

        // Null paragraph gate.
        cmp rdi, 0;
        je  bidi_caret_l2v_null;

        // Stub: visual = logical. Stash across the note call.
        mov rbx, rsi;

        mov rdi, 3;                         // BDC_ST_L2V
        call bidi_caret_note;

        mov rax, rbx;
        jmp bidi_caret_l2v_out;

      bidi_caret_l2v_null:
        mov rax, 0xFFFFE81E;                // BDC_PARAGRAPH_NULL
        mov rbx, rax;
        mov rdi, 6;                         // BDC_ST_REFUSED
        call bidi_caret_note;
        mov rax, rbx;

      bidi_caret_l2v_out:
        pop rbx;
        ret
      }
    }

  pub let bidi_caret_visual_to_logical : (u64, u64) -> u64 !{mem} @{} =
    fn (paragraph_ptr: u64) (visual: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M5-001 (paideia-os #2324): visual-to-logical conversion (currently a stub that returns visual unchanged; real UBA-driven conversion deferred to bidi_uba integration). Symmetric to logical_to_visual. Labels prefixed bidi_caret_v2l_.",
      block: {
        push rbx;

        cmp rdi, 0;
        je  bidi_caret_v2l_null;

        mov rbx, rsi;

        mov rdi, 4;                         // BDC_ST_V2L
        call bidi_caret_note;

        mov rax, rbx;
        jmp bidi_caret_v2l_out;

      bidi_caret_v2l_null:
        mov rax, 0xFFFFE81E;                // BDC_PARAGRAPH_NULL
        mov rbx, rax;
        mov rdi, 6;                         // BDC_ST_REFUSED
        call bidi_caret_note;
        mov rax, rbx;

      bidi_caret_v2l_out:
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION 8 -- INIT FACTORY
  // ==========================================================================
  //
  // bidi_caret_init(caret_ptr, paragraph_ptr, logical_offset) -> u64
  //
  //   Populate a caller-owned 32-byte caret cell. Contract:
  //
  //     (1) caret_ptr == 0                      -> BDC_CARET_NULL
  //     (2) paragraph_ptr == 0                  -> BDC_PARAGRAPH_NULL
  //     (3) logical_offset >= 2^32              -> BDC_BAD_OFFSET
  //     (4) caret already initialized
  //         (cell[+0] != 0)                     -> BDC_ALREADY_INIT
  //     (5) success: stamp the cell:
  //           cell[+0]   = paragraph_ptr
  //           cell[+8]   = logical_offset | (visual<<32)
  //                        where visual = logical_to_visual(paragraph,
  //                                                         logical)
  //           cell[+16]  = logical_offset | (visual<<32)
  //                        (anchor == caret at init: empty selection)
  //           cell[+24]  = 0 (direction_hint=AFTER_LTR, reserved=0)
  //         bump BDC_ST_INITS; return BDC_OK.
  //
  //   The initial anchor is COINCIDENT with the caret (no selection
  //   yet); a text-editor UX click-then-drag sequence would
  //   subsequently call extend_selection to move the caret while
  //   keeping the anchor in place, forming a range.
  //
  //   Refusal funnel bumps BDC_ST_REFUSED once at bidi_caret_init_
  //   refused.
  //
  //   Register plan (four callee-save pushes + sub rsp,8 = 40 bytes;
  //   entry rsp%16==8 -> 40+8=48 %16==0 for nested calls (bidi_caret_
  //   offset_valid + bidi_caret_logical_to_visual + bidi_caret_note)):
  //     rbx = caret_ptr
  //     r12 = paragraph_ptr
  //     r13 = logical_offset
  //     r14 = visual (from logical_to_visual)
  pub let bidi_caret_init : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (caret_ptr: u64) (paragraph_ptr: u64) (logical_offset: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M5-001 (paideia-os #2324): caret cell init factory. Four callee-save pushes + sub rsp,8 = 40 bytes; entry rsp%16==8 -> 40+8=48 %16==0 for nested calls (bidi_caret_offset_valid + bidi_caret_logical_to_visual + bidi_caret_note). Args stashed BEFORE any nested call: rbx=caret_ptr, r12=paragraph_ptr, r13=logical_offset, r14 receives visual from logical_to_visual. Cell stamp writes four u64 words directly with `mov [rbx+off], rN` (encoder-conservative). No `test`, no `add reg,[mem]`, no MOVABS. Labels prefixed bidi_caret_init_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        sub rsp, 8;

        mov rbx, rdi;                       // caret_ptr
        mov r12, rsi;                       // paragraph_ptr
        mov r13, rdx;                       // logical_offset

        // (1) caret_ptr null
        cmp rbx, 0;
        je  bidi_caret_init_null_caret;

        // (2) paragraph_ptr null
        cmp r12, 0;
        je  bidi_caret_init_null_paragraph;

        // (3) offset range check
        mov rdi, r13;
        call bidi_caret_offset_valid;
        cmp rax, 0;
        je  bidi_caret_init_bad_offset;

        // (4) already-init: cell[+0] (paragraph_ptr) != 0
        mov rax, [rbx + 0];
        cmp rax, 0;
        jne bidi_caret_init_already;

        // Compute visual from logical via the helper (stubbed to
        // return logical unchanged under the LTR-only stub).
        mov rdi, r12;                       // paragraph_ptr
        mov rsi, r13;                       // logical
        call bidi_caret_logical_to_visual;

        // Refusal detection on the helper: upper 32 bits non-zero
        // means BDC_PARAGRAPH_NULL (which we already filtered above,
        // but defence-in-depth against a future helper implementation
        // that surfaces new refusals).
        mov r10, rax;
        shr r10, 32;
        cmp r10, 0;
        jne bidi_caret_init_helper_refused;

        mov r14, rax;                       // r14 = visual (u32-clean)

        // (5a) cell[+0]: paragraph_ptr
        mov [rbx + 0], r12;

        // (5b) cell[+8]: logical_offset[31:0] | visual[63:32]
        //      Both r13 and r14 are u32-clean at this point (r13 by
        //      the offset_valid check, r14 by the helper's stub
        //      contract). Pack via shift-or.
        mov rax, r14;
        shl rax, 32;                        // rax = visual << 32
        mov r10, r13;
        shl r10, 32;
        shr r10, 32;                        // r10 = logical & 0xFFFFFFFF
        or  rax, r10;                       // rax = (visual<<32) | logical
        mov [rbx + 8], rax;

        // (5c) cell[+16]: anchor == caret at init (empty selection)
        mov [rbx + 16], rax;

        // (5d) cell[+24]: direction_hint=0 (AFTER_LTR default),
        //      reserved=0
        xor rax, rax;
        mov [rbx + 24], rax;

        // Bump BDC_ST_INITS
        mov rdi, 0;                         // BDC_ST_INITS
        call bidi_caret_note;

        xor rax, rax;                       // BDC_OK
        jmp bidi_caret_init_out;

      bidi_caret_init_null_caret:
        mov rax, 0xFFFFE81F;                // BDC_CARET_NULL
        jmp bidi_caret_init_refused;
      bidi_caret_init_null_paragraph:
        mov rax, 0xFFFFE81E;                // BDC_PARAGRAPH_NULL
        jmp bidi_caret_init_refused;
      bidi_caret_init_bad_offset:
        mov rax, 0xFFFFE81B;                // BDC_BAD_OFFSET
        jmp bidi_caret_init_refused;
      bidi_caret_init_already:
        mov rax, 0xFFFFE81D;                // BDC_ALREADY_INIT
        jmp bidi_caret_init_refused;
      bidi_caret_init_helper_refused:
        mov rax, 0xFFFFE81E;                // BDC_PARAGRAPH_NULL (surfaced
                                            // by helper)
        // fallthrough

      bidi_caret_init_refused:
        mov r14, rax;
        mov rdi, 6;                         // BDC_ST_REFUSED
        call bidi_caret_note;
        mov rax, r14;

      bidi_caret_init_out:
        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION 9 -- MOVEMENT PRIMITIVES
  // ==========================================================================
  //
  // bidi_caret_move_left(caret_ptr) -> u64
  //   Move the caret VISUALLY one column to the left. Under the LTR
  //   stub, this decrements both logical_offset and visual_x by 1;
  //   the anchor is LEFT UNTOUCHED (this primitive is orthogonal to
  //   extend_selection: unshifted arrows and Shift+arrows are
  //   composed at the router layer by CHOOSING whether to follow the
  //   move with extend_selection(caret_logical) to collapse, or NOT
  //   to leave the anchor as a range endpoint. Novel-clean over the
  //   inherited-from-Emacs convention of overloading the move
  //   primitive with a "shift flag" argument -- the two orthogonal
  //   ops compose without conflict at any higher layer).
  //
  //   Clamping: if the caret is already at the paragraph start
  //   (visual_x == 0 under the LTR stub; the real bidi-aware
  //   implementation clamps against the visual leftmost column of
  //   the paragraph), the call is a no-op that returns the current
  //   visual_x unchanged.
  //
  //   Under the LTR stub, "visually left" == "logically left" and no
  //   boundary jumps occur. Once bidi_uba integrates, a move that
  //   crosses an LTR/RTL boundary jumps discontinuously in logical
  //   space (visual_x - 1, but logical_offset may LEAP forward or
  //   backward across the boundary), and the direction_hint is
  //   updated to reflect which run the caret has entered.
  //
  //   Returns new visual_x in the low 32 bits on success (upper 32
  //   bits zero); refusal sentinels have upper 32 bits set.
  //
  //   Register plan (three callee-save pushes = 24 bytes; entry
  //   rsp%16==8 -> (8-24) mod 16 == 0, aligned for nested calls;
  //   odd-push-count keeps SysV alignment):
  //     rbx = caret_ptr
  //     r12 = logical_offset (loaded from cell)
  //     r13 = visual_x (loaded from cell)
  pub let bidi_caret_move_left : (u64) -> u64 !{mem} @{} =
    fn (caret_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M5-001 (paideia-os #2324): visual-left caret movement. Three callee-save pushes = 24 bytes; entry rsp%16==8 -> (8-24) mod 16 == 0 for nested note call. Order: null / init gates, load positions, clamp on visual==0, decrement both fields (LTR stub: visual and logical mirror), write back to cell[+8] leaving cell[+16] anchor UNTOUCHED (orthogonal to extend_selection), bump BDC_ST_MOVES, return new visual_x. No `test`, no `add reg,[mem]`, no MOVABS. Labels prefixed bidi_caret_ml_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;

        // Null gate
        cmp rbx, 0;
        je  bidi_caret_ml_null;

        // Init gate: paragraph_ptr != 0
        mov rax, [rbx + 0];
        cmp rax, 0;
        je  bidi_caret_ml_not_init;

        // Load positions: cell[+8] packs logical[31:0] | visual[63:32]
        mov rax, [rbx + 8];
        mov r12, rax;
        shl r12, 32;
        shr r12, 32;                        // r12 = logical_offset
        mov r13, rax;
        shr r13, 32;                        // r13 = visual_x

        // Clamp on visual_x == 0
        cmp r13, 0;
        je  bidi_caret_ml_clamped;

        // Decrement both (LTR stub: logical and visual mirror)
        sub r12, 1;
        sub r13, 1;

        // Pack and store cell[+8]. Anchor at cell[+16] is left
        // untouched -- this primitive is orthogonal to
        // extend_selection.
        mov rax, r13;
        shl rax, 32;                        // rax = visual << 32
        mov r10, r12;
        shl r10, 32;
        shr r10, 32;                        // r10 = logical & 0xFFFFFFFF
        or  rax, r10;
        mov [rbx + 8], rax;

        // Bump BDC_ST_MOVES (r13 must survive the note call)
        mov rdi, 1;                         // BDC_ST_MOVES
        call bidi_caret_note;

        // Return new visual_x
        mov rax, r13;
        jmp bidi_caret_ml_out;

      bidi_caret_ml_clamped:
        // Already at visual leftmost; return current visual_x (0)
        // without bumping moves counter (no movement occurred).
        mov rax, r13;
        jmp bidi_caret_ml_out;

      bidi_caret_ml_null:
        mov rax, 0xFFFFE81F;                // BDC_CARET_NULL
        jmp bidi_caret_ml_refused;
      bidi_caret_ml_not_init:
        mov rax, 0xFFFFE81C;                // BDC_NOT_INIT
        // fallthrough

      bidi_caret_ml_refused:
        mov r13, rax;
        mov rdi, 6;                         // BDC_ST_REFUSED
        call bidi_caret_note;
        mov rax, r13;

      bidi_caret_ml_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // bidi_caret_move_right(caret_ptr) -> u64
  //   Mirror of move_left. Increments both logical_offset and
  //   visual_x by 1 under the LTR stub. Anchor UNTOUCHED (same
  //   orthogonality rationale as move_left). No paragraph-end clamp
  //   at this layer (the LTR stub has no notion of paragraph length;
  //   the real bidi_uba integration surfaces the visual rightmost
  //   column via a bounds query); a caller-side length check is the
  //   current contract until integration lands.
  //
  //   Returns new visual_x in the low 32 bits on success.
  pub let bidi_caret_move_right : (u64) -> u64 !{mem} @{} =
    fn (caret_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M5-001 (paideia-os #2324): visual-right caret movement. Symmetric to move_left; anchor at cell[+16] left untouched (orthogonal to extend_selection); no upper-bound clamp under LTR stub (paragraph length not surfaced until bidi_uba integrates). Three callee-save pushes = 24 bytes; nested note call aligned. Labels prefixed bidi_caret_mr_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;

        cmp rbx, 0;
        je  bidi_caret_mr_null;

        mov rax, [rbx + 0];
        cmp rax, 0;
        je  bidi_caret_mr_not_init;

        // Load positions
        mov rax, [rbx + 8];
        mov r12, rax;
        shl r12, 32;
        shr r12, 32;                        // r12 = logical
        mov r13, rax;
        shr r13, 32;                        // r13 = visual

        // Increment both (LTR stub: mirror)
        add r12, 1;
        add r13, 1;

        // Check that we did not overflow u32 (visual == 2^32 would
        // corrupt the pack). If so, refuse with BDC_BAD_VISUAL and
        // do NOT commit the increment.
        mov r10, r13;
        shr r10, 32;
        cmp r10, 0;
        jne bidi_caret_mr_visual_overflow;

        mov r10, r12;
        shr r10, 32;
        cmp r10, 0;
        jne bidi_caret_mr_offset_overflow;

        // Pack and store cell[+8]; anchor at cell[+16] untouched.
        mov rax, r13;
        shl rax, 32;
        mov r10, r12;
        shl r10, 32;
        shr r10, 32;
        or  rax, r10;
        mov [rbx + 8], rax;

        mov rdi, 1;                         // BDC_ST_MOVES
        call bidi_caret_note;

        mov rax, r13;
        jmp bidi_caret_mr_out;

      bidi_caret_mr_null:
        mov rax, 0xFFFFE81F;                // BDC_CARET_NULL
        jmp bidi_caret_mr_refused;
      bidi_caret_mr_not_init:
        mov rax, 0xFFFFE81C;                // BDC_NOT_INIT
        jmp bidi_caret_mr_refused;
      bidi_caret_mr_visual_overflow:
        mov rax, 0xFFFFE81A;                // BDC_BAD_VISUAL
        jmp bidi_caret_mr_refused;
      bidi_caret_mr_offset_overflow:
        mov rax, 0xFFFFE81B;                // BDC_BAD_OFFSET
        // fallthrough

      bidi_caret_mr_refused:
        mov r13, rax;
        mov rdi, 6;                         // BDC_ST_REFUSED
        call bidi_caret_note;
        mov rax, r13;

      bidi_caret_mr_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION 10 -- SELECTION EXTENSION
  // ==========================================================================
  //
  // bidi_caret_extend_selection(caret_ptr, new_logical) -> u64
  //
  //   Update the selection ANCHOR to a new logical position, leaving
  //   the caret's own position UNCHANGED. This is the caller-driven
  //   anchor-placement operation used by:
  //
  //     * Mouse click-to-place: on mousedown, the client calls
  //       extend_selection with the click's logical position to plant
  //       a fresh anchor; on mousemove-during-drag, the client moves
  //       the caret (via a future set_caret op or arrow-key
  //       simulation) while the anchor stays put, forming a range.
  //
  //     * Programmatic selection: an editor script that says "select
  //       from character 10 to character 20" plants the anchor at 10
  //       via extend_selection, then moves the caret to 20 via
  //       repeated move_right calls (or a future set_caret).
  //
  //   The anchor_visual is computed from new_logical via the
  //   logical_to_visual helper (stubbed to visual == logical under
  //   the LTR-only stub); both anchor fields are written atomically
  //   in one 64-bit store to cell[+16].
  //
  //   Contract:
  //     (1) caret_ptr == 0                      -> BDC_CARET_NULL
  //     (2) paragraph_ptr == 0 (not init)       -> BDC_NOT_INIT
  //     (3) new_logical >= 2^32                 -> BDC_BAD_OFFSET
  //     (4) success: cell[+16] := new_logical |
  //                               (visual << 32); caret at cell[+8]
  //                               left untouched. Bump BDC_ST_EXTENDS.
  //                               Return BDC_OK.
  //
  //   Register plan (three callee-save pushes = 24 bytes; entry
  //   rsp%16==8 -> aligned for nested calls (bidi_caret_offset_valid
  //   + bidi_caret_logical_to_visual + bidi_caret_note)):
  //     rbx = caret_ptr
  //     r12 = new_logical
  //     r13 = anchor_visual (from logical_to_visual)
  pub let bidi_caret_extend_selection : (u64, u64) -> u64 !{mem} @{} =
    fn (caret_ptr: u64) (new_logical: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M5-001 (paideia-os #2324): update selection anchor to a new logical position, leaving the caret untouched. Three callee-save pushes = 24 bytes; nested-call aligned. Order: null / init / offset gates, compute anchor_visual via logical_to_visual helper (LTR stub returns logical unchanged), pack and store cell[+16], bump BDC_ST_EXTENDS. Labels prefixed bidi_caret_es_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;
        mov r12, rsi;                       // new_logical

        // (1) null caret
        cmp rbx, 0;
        je  bidi_caret_es_null;

        // (2) init check via cell[+0] (paragraph_ptr)
        mov rax, [rbx + 0];
        cmp rax, 0;
        je  bidi_caret_es_not_init;

        // (3) offset range
        mov rdi, r12;
        call bidi_caret_offset_valid;
        cmp rax, 0;
        je  bidi_caret_es_bad_offset;

        // Compute anchor_visual via helper. rdi = paragraph_ptr from
        // cell[+0]; rsi = new_logical.
        mov rdi, [rbx + 0];
        mov rsi, r12;
        call bidi_caret_logical_to_visual;

        // Refusal detection on the helper (defence-in-depth).
        mov r10, rax;
        shr r10, 32;
        cmp r10, 0;
        jne bidi_caret_es_helper_refused;

        mov r13, rax;                       // r13 = anchor_visual

        // Pack and store cell[+16]: new_logical[31:0] | anchor_visual[63:32]
        mov rax, r13;
        shl rax, 32;
        mov r10, r12;
        shl r10, 32;
        shr r10, 32;
        or  rax, r10;
        mov [rbx + 16], rax;

        // Bump BDC_ST_EXTENDS
        mov rdi, 2;                         // BDC_ST_EXTENDS
        call bidi_caret_note;

        xor rax, rax;                       // BDC_OK
        jmp bidi_caret_es_out;

      bidi_caret_es_null:
        mov rax, 0xFFFFE81F;                // BDC_CARET_NULL
        jmp bidi_caret_es_refused;
      bidi_caret_es_not_init:
        mov rax, 0xFFFFE81C;                // BDC_NOT_INIT
        jmp bidi_caret_es_refused;
      bidi_caret_es_bad_offset:
        mov rax, 0xFFFFE81B;                // BDC_BAD_OFFSET
        jmp bidi_caret_es_refused;
      bidi_caret_es_helper_refused:
        mov rax, 0xFFFFE81E;                // BDC_PARAGRAPH_NULL (surfaced
                                            // by helper)
        // fallthrough

      bidi_caret_es_refused:
        mov r13, rax;
        mov rdi, 6;                         // BDC_ST_REFUSED
        call bidi_caret_note;
        mov rax, r13;

      bidi_caret_es_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
