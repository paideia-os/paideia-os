// src/user/ime/indic_shaping.pdx -- G11-M4-005 (paideia-os #2321)
//
// INDIC COMPLEX-SCRIPT TEXT-SHAPER (Devanagari + Tamil).
//
// A VALUE-TYPE shaping module -- distinct from the sibling IME
// PROVIDER satellites (latin_autocomplete #2317, latin_deadkey
// #2318, cjk_pinyin, cjk_kana, indic_inscript #2322): those files
// wire keystroke -> codepoint under a KIND_IME_PROVIDER
// registration. THIS file does the opposite half: it accepts a
// stream of ALREADY-DECODED unicode codepoints (Devanagari or
// Tamil) and applies script-specific CLUSTER SHAPING rules to
// produce the reordered / ligated / conjunct-glyph sequence that
// the SDF text renderer will actually rasterise. It never talks
// to the IME provider substrate; it never calls ime_provider_
// register; it holds no session binding. It is a pure per-run
// state machine consumed downstream of any IME provider (Indic-
// InScript, Devanagari-Phonetic transliteration, paste-from-
// clipboard, disk-mmap of a Devanagari text file, ...).
//
// COMPLEX-SCRIPT SHAPING IN ONE PARAGRAPH.  Devanagari and Tamil
// (and Bengali, Gurmukhi, Oriya, Malayalam, Kannada, Telugu -- the
// other Brahmi-derived scripts) share a common CLUSTER-GRAMMAR
// insight from the ISCII 1988 / Unicode Bidi Annex UAX #9 / OpenType
// USE (Universal Shaping Engine, 2015) tradition: a run of
// codepoints is grouped into ORTHOGRAPHIC SYLLABLES (a.k.a. AKSARAS
// or CLUSTERS), each of which is
//
//   (CONSONANT + VIRAMA)* CONSONANT (VOWEL_SIGN | NUKTA | ...)*
//
// Within a cluster the renderer may need to (a) REORDER pre-base
// matras (e.g. Devanagari `ि` U+093F, the "i" vowel sign, VISUALLY
// PRECEDES the consonant it phonetically follows -- `कि` = क +
// ि but rendered ि-then-क), and (b) LIGATE consonant runs into
// CONJUNCT glyphs (e.g. Tamil `ஸ்ரீ` = ஸ + ் + ர + ீ historically
// renders as the shorthand ligature `ஸ்ரீ`, a single glyph). The
// state machine here tracks the four cluster-lifecycle states
// (idle / consonant-seen / virama-armed / matra-seen) and, at
// cluster-boundary time, HANDS the accumulated codepoint buffer to
// a reorderer/ligator that emits the visual form. Both the
// reorderer and the ligator are STUBS at this landing (they bump
// cluster_length only); the real implementations land with the
// SDF-renderer wiring in the G5 text-render substrate, which is
// out of scope for this row. What lands here is the CLUSTER
// STATE MACHINE + FINGERPRINT + CELL-LAYOUT contract everything
// downstream binds to.
//
// Design authority:
//   * design/compositor/pwp-spec-vocabulary.md §2.19 KIND_IME_
//     PROVIDER (Indic family) -- names Devanagari + Tamil as
//     first-tier shaped scripts. The KIND_IME_PROVIDER contract
//     covers KEY -> CODEPOINT input; the SHAPING half is the
//     dual, this file's charter.
//   * Unicode Standard Annex #29 (Text Segmentation) + Unicode
//     Chapter 12 (South and Central Asia-I) -- the grapheme-
//     cluster and syllable-boundary definitions the state
//     machine implements.
//   * OpenType Universal Shaping Engine (USE) spec (Microsoft /
//     ISO, 2015) -- the canonical modern cluster-classification
//     table for every Brahmi-derived script; this file's
//     Devanagari + Tamil codepoint-class checks are direct
//     subsets of the USE classifier.
//   * ISCII 1988 / IS 13194:1991 (BIS) -- historical Indic
//     encoding whose cluster-grammar insight the modern Unicode
//     shaping specs inherit.
//
// VALUE-TYPE, NOT PROVIDER.  Unlike its IME sibling files, this
// module registers NOTHING at boot. Every function is a pure
// operation on a CALLER-OWNED 32-byte shaper cell (documentation-
// only struct declaration below, mirrors the LatinDeadkeyEngine /
// LatinAutocompleteEngine precedent). A caller allocates one
// shaper per shaping context (typically one per text-layout run;
// a paragraph of Devanagari and a paragraph of Tamil in the same
// document use TWO shapers, one per script). Value-type -> no
// provider_kind_id, no session_kind_id, no ime_provider_register
// call, no ProviderKind refusal-sentinel handling. The dep on
// provider_kind.pdx (G11-M2-001, LANDED B10) is a MODULE-ORDER
// dep only (this file lands into the same G11 IME package tree);
// no symbol from ProviderKind is referenced here.
//
// TWO SCRIPTS AT ONE LANDING.  Devanagari (SCRIPT_DEVANAGARI=0)
// and Tamil (SCRIPT_TAMIL=1). Both share the same 4-state cluster
// machine; per-script differences (pre-base matra reordering is
// Devanagari-only in this landing; Ta+Sri shorthand ligature is
// Tamil-only) are dispatched at cluster-boundary time via a
// script-tagged branch inside the (stubbed) reorderer/ligator.
// Extending to Bengali / Gurmukhi / Malayalam / ... is a matter
// of appending script codes (2, 3, ...) + adding per-script
// arms; the state machine itself is script-agnostic.
//
// LABEL PREFIX.  `indic_shaping_` throughout, sidestepping the
// paideia-as reserved-word collisions (see feedback_paideia_as_
// reserved_labels). Every ASM jump target is
// `indic_shaping_<funcname>_<tag>`.
//
// MECE SCOPE.  Single file under src/user/ime/. Touches only:
//   * NEW: src/user/ime/indic_shaping.pdx (this file)
// No other file is modified. The pdx_kind_indic_shaping_meta
// fingerprint is DATA-ONLY at this landing (the reorderer/
// ligator substrate that would emit it on the first successful
// cluster flush is a future landing paired with the G5 SDF
// text-render substrate); a matching allowlist entry in
// tools/verify-fingerprint-coverage.sh lands ATOMICALLY with the
// build gate on the parent's next batch-close pass.
//
// FAILURE BAND.  0xFFFFE7E0..0xFFFFE7EF -- fresh 16-wide band,
// grep-verified free across src/ + tests/ + design/ at landing
// time. Slots into the G11.M4 IME family cluster
// (0xFFFFE7A0..0xFFFFE7FF; latin_autocomplete .E7A*, latin_
// deadkey .E7B*, cjk_pinyin .E7C*, cjk_kana .E7D*, this file
// .E7E*, indic_inscript .E7F*). Six IMEs, six adjacent 16-slot
// pages, one shaping module tucked between cjk_kana and indic_
// inscript.
//
// Encoder-conservative pattern per every G11.M4 sibling: no `and
// reg, imm64`, no MOVABS r64,imm64, no `test`, no `add reg,[mem]`,
// no `mov_bzx`/`mov_wzx`; 32-bit zero-extension via shl+shr;
// u16 field extraction via shl 48/shr 48; u8 field extraction via
// shl 56/shr 56; small immediates only.
//
// =============================================================================

module IndicShaping = structure {

  // ==========================================================================
  // SECTION 1.1 -- SCRIPT ENUM
  // ==========================================================================
  //
  // Two script codes at this landing. Values chosen contiguous
  // from 0 so a caller's dispatch-table lookup can index by
  // script directly (no gap fill-in).

  pub let SCRIPT_DEVANAGARI       : u64 = 0
  pub let SCRIPT_TAMIL            : u64 = 1
  pub let SCRIPT_MAX              : u64 = 1   // inclusive upper bound

  // ==========================================================================
  // SECTION 1.2 -- CLUSTER-STATE ENUM
  // ==========================================================================
  //
  // Five states form the per-codepoint cluster-lifecycle machine:
  //
  //   CS_IDLE       No cluster in progress. The next codepoint
  //                 opens a fresh cluster (or, if it is a stray
  //                 combiner with no consonant to attach to,
  //                 emits it as its own trivial cluster and stays
  //                 idle).
  //
  //   CS_CONSONANT  A base consonant has been ingested; awaiting
  //                 either (a) a virama (halant / pulli) to arm
  //                 a conjunct join, (b) a vowel sign (matra) to
  //                 close the cluster with a vowel modifier, or
  //                 (c) any other codepoint which forces a
  //                 cluster boundary.
  //
  //   CS_VOWEL      A vowel sign (matra) has been ingested after
  //                 a consonant; the cluster is closed on the
  //                 NEXT codepoint (a matra is always the LAST
  //                 element of its cluster in the USE grammar --
  //                 the following codepoint is unambiguously the
  //                 start of a new cluster). Retained as a
  //                 distinct state from CS_MATRA for future
  //                 extensions (Marathi's eyelash-ra + independent
  //                 vowel-sign chains).
  //
  //   CS_VIRAMA     A virama has been ingested after a consonant;
  //                 awaiting the CONJUNCT BASE (a second
  //                 consonant which will ligate with the first).
  //                 If the next codepoint is NOT a consonant, the
  //                 virama is emitted as a HALF-FORM tail (visible
  //                 virama with no conjunct) and the cluster
  //                 closes; if it IS a consonant, the state moves
  //                 back to CS_CONSONANT and the cluster
  //                 continues to grow.
  //
  //   CS_MATRA      A vowel-SIGN (spacing matra) has been
  //                 ingested after a consonant. Semantically
  //                 identical to CS_VOWEL for the USE state
  //                 machine but named distinctly so future
  //                 pre-base-matra-reordering logic (Devanagari
  //                 `ि` U+093F reorder-before-consonant rule)
  //                 has a distinct hook to gate on.

  pub let CS_IDLE                 : u64 = 0
  pub let CS_CONSONANT            : u64 = 1
  pub let CS_VOWEL                : u64 = 2
  pub let CS_VIRAMA               : u64 = 3
  pub let CS_MATRA                : u64 = 4
  pub let CS_MAX                  : u64 = 4   // inclusive upper bound

  // ==========================================================================
  // SECTION 1.3 -- SHAPER CELL LAYOUT (IndicShaper, 32 bytes)
  // ==========================================================================
  //
  // Four u64 words holding the shaper's per-instance state.
  // Documentation-only struct (paideia-as does not currently
  // return structs by value from asm bodies; mirrors the
  // FocusRouterState / LatinAutocompleteEngine / LatinDeadkey
  // Engine precedent).
  //
  //   [+0]  header_and_buf_offset:
  //             script[7:0]                   SCRIPT_DEVANAGARI(0) /
  //                                           SCRIPT_TAMIL(1); pinned
  //                                           at init time, immutable
  //                                           thereafter (a caller
  //                                           switching scripts
  //                                           allocates a fresh cell).
  //             state[15:8]                   CS_IDLE(0) .. CS_MATRA(4)
  //             cluster_length[23:16]         u8 count of codepoints
  //                                           ingested into the
  //                                           current in-flight
  //                                           cluster (0 when idle).
  //                                           Saturates at 255 --
  //                                           any legitimate Indic
  //                                           cluster is < 20
  //                                           codepoints; a runaway
  //                                           past 255 signals input
  //                                           corruption, gated at
  //                                           bump time.
  //             reserved[31:24]               0 at init; future flags
  //                                           (case-mapping-aware,
  //                                           locale-tagged, ...).
  //             cluster_buffer_offset[63:32]  u32 byte offset into
  //                                           the caller-provided
  //                                           accumulator where the
  //                                           NEXT ingested
  //                                           codepoint will be
  //                                           written; the buffer
  //                                           itself is out of
  //                                           scope for the cell
  //                                           (the caller manages
  //                                           its own storage).
  //                                           Bumped by 4 (u32
  //                                           codepoints) on each
  //                                           successful ingest;
  //                                           reset to 0 on cluster
  //                                           boundary.
  //
  //   [+8]  output_offset (u64):
  //             byte offset into the caller-provided OUTPUT buffer
  //             where the NEXT emitted (shaped) codepoint will be
  //             written. Bumped by 4 for each codepoint the
  //             reorderer/ligator emits at cluster-boundary time.
  //             Full u64 because output runs of a full paragraph
  //             may exceed 4 GiB in pathological cases (a
  //             pre-computed dictionary dump); the ingest side
  //             clamps to u32 since a single cluster is bounded
  //             by CS_MAX * 4 bytes.
  //
  //   [+16] reserved0 (u64): 0 at init; future cluster-boundary
  //             callback pointer / shaping-error accumulator.
  //
  //   [+24] reserved1 (u64): 0 at init; future stats-cell binding
  //             (per-shaper cluster-completion counter).
  //
  // Cell is 32 bytes = one half of a 64-byte cache line. Cache-
  // line alignment is CALLER'S responsibility (mirrors sibling
  // latin_deadkey / latin_autocomplete).

  struct IndicShaper {
    script: u8,
    state: u8,
    cluster_length: u8,
    reserved0: u8,
    cluster_buffer_offset: u32,
    output_offset: u64,
    reserved1: u64,
    reserved2: u64
  }

  pub let IS_CELL_BYTES                    : u64 = 32
  pub let IS_CELL_OFF_HEADER_BUF           : u64 = 0
  pub let IS_CELL_OFF_OUTPUT               : u64 = 8
  pub let IS_CELL_OFF_RES0                 : u64 = 16
  pub let IS_CELL_OFF_RES1                 : u64 = 24

  // Sub-byte / sub-word positions for cell[+0]:
  //   script                bits [7:0]
  //   state                 bits [15:8]
  //   cluster_length        bits [23:16]
  //   reserved              bits [31:24]
  //   cluster_buffer_offset bits [63:32]
  pub let IS_HDR_SHIFT_STATE               : u64 = 8
  pub let IS_HDR_SHIFT_CLUSTER_LEN         : u64 = 16
  pub let IS_HDR_SHIFT_BUF_OFF             : u64 = 32

  // ==========================================================================
  // SECTION 1.4 -- CODEPOINT-CLASS RANGES (Devanagari + Tamil)
  // ==========================================================================
  //
  // Ranges are inclusive both ends. Values from the Unicode
  // 15.1 code chart for U+0900 (Devanagari) and U+0B80 (Tamil).
  // Ranges are declared here as small immediates so assembly
  // bodies can bake them into cmp instructions directly.

  // Devanagari consonants: क U+0915 .. ह U+0939 (25 base
  // consonants; the shaped-only extension range U+0958..U+095F
  // is treated as CONSONANT by extension via the same jae/jbe
  // pair since we admit anything >= 0x0915 and <= 0x0939 as
  // base-consonant class for the state machine's purposes).
  pub let IS_DEV_CONSONANT_LO              : u64 = 0x0915
  pub let IS_DEV_CONSONANT_HI              : u64 = 0x0939

  // Devanagari vowel signs (spacing matras + non-spacing marks):
  // ा U+093E .. ौ U+094C.
  pub let IS_DEV_MATRA_LO                  : u64 = 0x093E
  pub let IS_DEV_MATRA_HI                  : u64 = 0x094C

  // Devanagari virama (halant): ् U+094D.
  pub let IS_DEV_VIRAMA                    : u64 = 0x094D

  // Tamil consonants: க U+0B95 .. ஹ U+0BB9 (18 base consonants
  // in Tamil's smaller consonantal inventory).
  pub let IS_TAM_CONSONANT_LO              : u64 = 0x0B95
  pub let IS_TAM_CONSONANT_HI              : u64 = 0x0BB9

  // Tamil vowel signs: ா U+0BBE .. ௌ U+0BCC.
  pub let IS_TAM_MATRA_LO                  : u64 = 0x0BBE
  pub let IS_TAM_MATRA_HI                  : u64 = 0x0BCC

  // Tamil virama (pulli): ் U+0BCD.
  pub let IS_TAM_VIRAMA                    : u64 = 0x0BCD

  // Saturation cap for cluster_length; a legitimate cluster is
  // < 20 codepoints (Unicode Standard §12 recommends no more
  // than 16 for practical rendering). We cap at 255 (the u8
  // field's ceiling) as an early corruption-detection hint --
  // any real cluster is far smaller, so a saturated field
  // signals a stuck ingest loop.
  pub let IS_CLUSTER_LEN_MAX               : u64 = 255

  // ==========================================================================
  // SECTION 1.5 -- FAILURE TAXONOMY (0xFFFFE7E0..0xFFFFE7EF)
  // ==========================================================================
  //
  // Fresh 16-wide band. Grep-verified free across src/ + tests/
  // + design/ at landing time. Slots between cjk_kana's
  // .E7D* and indic_inscript's .E7F*.

  pub let IS_OK                            : u64 = 0
  pub let IS_SHAPER_NULL                   : u64 = 0xFFFFE7EF  // shaper_ptr == 0
  pub let IS_BAD_SCRIPT                    : u64 = 0xFFFFE7EE  // script > SCRIPT_MAX
  pub let IS_BAD_STATE                     : u64 = 0xFFFFE7ED  // state byte > CS_MAX
                                                                // (corruption detect;
                                                                // defence-in-depth
                                                                // against a rogue
                                                                // writer to cell[+0])
  pub let IS_BAD_CODEPOINT                 : u64 = 0xFFFFE7EC  // codepoint upper 32
                                                                // bits set (a raw
                                                                // wire-value overflow)
  pub let IS_CLUSTER_OVERFLOW              : u64 = 0xFFFFE7EB  // cluster_length would
                                                                // exceed IS_CLUSTER_
                                                                // LEN_MAX (stuck
                                                                // ingest loop)
  // Slots 0xFFFFE7EA..0xFFFFE7E0 are RESERVED within this file's
  // band for future extension (buffer-null gates once the caller-
  // owned buffer contract lands, script-extension validators for
  // Bengali / Gurmukhi / ..., ligator-side pruning refusals).

  // ==========================================================================
  // SECTION 1.6 -- FINGERPRINT (one line, legacy-suffixed)
  // ==========================================================================
  //
  // pdx_kind_indic_shaping_meta: emitted once by the future
  // reorderer/ligator substrate on the first successful cluster
  // flush of a shaper instance. Data-only at this landing per
  // the sibling B8 / B10 / B11 / B12 / B13 pattern; allowlisted
  // in tools/verify-fingerprint-coverage.sh atomically with the
  // parent's next batch-close pass (allowlist edit deliberately
  // omitted here to keep the MECE scope at "one file touched").
  //
  // Byte count: 53 content chars + 1 NUL = 54.
  pub let pdx_kind_indic_shaping_meta : [u8; 54] = "indic shaping init ok [legacy: INDIC SHAPING INIT OK]\0"

  // Short field-name string constants for future debug-print use
  // (mirror ime_provider_k_row_id / latin_deadkey_k_provider_id
  // precedent).
  pub let indic_shaping_k_script          : [u8; 7]  = "script\0"
  pub let indic_shaping_k_state           : [u8; 6]  = "state\0"

  // ==========================================================================
  // SECTION 2 -- STATS CELL
  // ==========================================================================
  //
  // Module-level counters shared across every shaper instance in
  // this process. Mirrors _latin_deadkey_stats / _latin_
  // autocomplete_stats layout.

  pub let mut _indic_shaping_stats : [u64; 8] = uninit @align(64)

  // ==========================================================================
  // SECTION 3 -- STATS COUNTER SLOTS
  // ==========================================================================
  //
  // Seven named slots. A boot-log observer can verify
  // INGESTS >= FLUSHES + RESETS + REFUSED (each flush and each
  // explicit reset consumes at least one prior ingest, and every
  // refused ingest still counts against the ingest budget).

  pub let IS_ST_INITS              : u64 = 0
  pub let IS_ST_INGESTS            : u64 = 1
  pub let IS_ST_FLUSHES            : u64 = 2  // explicit cluster-boundary flush
  pub let IS_ST_RESETS             : u64 = 3  // explicit reset (clear buffer)
  pub let IS_ST_CLUSTERS           : u64 = 4  // clusters completed (state ->
                                              // IDLE from a non-IDLE state)
  pub let IS_ST_REFUSED            : u64 = 5
  pub let IS_ST_OVERFLOWS          : u64 = 6  // cluster_length hit cap
  pub let IS_ST_MAX                : u64 = 7

  // ==========================================================================
  // SECTION 4 -- COUNTER PRIMITIVES
  // ==========================================================================

  // indic_shaping_stats_reset() -> (): zero counters at boot.
  pub let indic_shaping_stats_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-005 (paideia-os #2321): clear per-module counters at boot. Mirrors latin_deadkey_stats_reset. Low-first index scan over 8 u64 slots via load-inc-store; no callee-save pushes (leaf; only r10/rcx/rax touched beyond SysV in/out). Labels prefixed indic_shaping_srs_.",
      block: {
        lea r10, [rip + _indic_shaping_stats];
        xor rax, rax;
        xor rcx, rcx;
      indic_shaping_srs_loop:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  indic_shaping_srs_loop;
        ret
      }
    }

  // indic_shaping_note(which) -> (): bump one stats counter.
  // Encoder-conservative load-inc-store; OOB is a silent no-op.
  pub let indic_shaping_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-005 (paideia-os #2321): counter bump. Encoder-conservative load-inc-store; no add reg,[mem]. OOB is a silent no-op. Mirrors latin_deadkey_note. Labels prefixed indic_shaping_nt_.",
      block: {
        cmp rdi, 8;
        jae indic_shaping_nt_out;
        lea r10, [rip + _indic_shaping_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      indic_shaping_nt_out:
        ret
      }
    }

  // indic_shaping_stat(which) -> u64: read one stats counter.
  pub let indic_shaping_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-005 (paideia-os #2321): counter read; OOB -> 0. Labels prefixed indic_shaping_st_.",
      block: {
        cmp rdi, 8;
        jae indic_shaping_st_zero;
        lea r10, [rip + _indic_shaping_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      indic_shaping_st_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // SECTION 5 -- VALIDATORS (pure leaves)
  // ==========================================================================

  // indic_shaping_script_valid(script) -> 1 iff script <= SCRIPT_MAX.
  pub let indic_shaping_script_valid : (u64) -> u64 !{} @{} =
    fn (script: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G11-M4-005 (paideia-os #2321): 1 iff script in [0, SCRIPT_MAX=1]. Small-immediate cmp; encoder-conservative. Labels prefixed indic_shaping_scv_.",
      block: {
        cmp rdi, 1;
        ja  indic_shaping_scv_no;
        mov rax, 1;
        ret;
      indic_shaping_scv_no:
        xor rax, rax;
        ret
      }
    }

  // indic_shaping_state_valid(state) -> 1 iff state <= CS_MAX.
  pub let indic_shaping_state_valid : (u64) -> u64 !{} @{} =
    fn (state: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G11-M4-005 (paideia-os #2321): 1 iff state in {0..4}. Small-immediate cmp; encoder-conservative. Labels prefixed indic_shaping_stv_.",
      block: {
        cmp rdi, 4;
        ja  indic_shaping_stv_no;
        mov rax, 1;
        ret;
      indic_shaping_stv_no:
        xor rax, rax;
        ret
      }
    }

  // indic_shaping_codepoint_valid(cp) -> 1 iff cp < 2^32.
  // Unicode code points fit in 21 bits; anything with the upper
  // 32 bits set is corruption. The upper-11-of-32 sanity check
  // is left to a future validator (the state machine only
  // cares about the classify-arm dispatch, not the tighter
  // 0x10FFFF bound).
  pub let indic_shaping_codepoint_valid : (u64) -> u64 !{} @{} =
    fn (cp: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G11-M4-005 (paideia-os #2321): 1 iff cp < 2^32. Encoder-conservative 32-bit range test via shr 32 / cmp 0. Labels prefixed indic_shaping_cpv_.",
      block: {
        mov rax, rdi;
        shr rax, 32;
        cmp rax, 0;
        jne indic_shaping_cpv_no;
        mov rax, 1;
        ret;
      indic_shaping_cpv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // SECTION 6 -- CELL-FIELD GETTERS
  // ==========================================================================
  //
  // Every getter takes the shaper_ptr in rdi and returns the
  // requested field in rax. A null shaper_ptr is undefined
  // behavior at the getter level (mirrors latin_deadkey_get_* /
  // focus_router_get_* precedent). The public state / script
  // getters below (SECTION 10) DO gate on null; these are the
  // internal shortcuts used by the ingest body which has already
  // gated.

  pub let indic_shaping_get_script : (u64) -> u64 !{mem} @{} =
    fn (shaper_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-005 (paideia-os #2321): read script from cell[+0][7:0]. u8 extraction via shl 56 / shr 56. Labels prefixed indic_shaping_gsc_.",
      block: {
        mov rax, [rdi + 0];
        shl rax, 56;
        shr rax, 56;
        ret
      }
    }

  pub let indic_shaping_get_state_raw : (u64) -> u64 !{mem} @{} =
    fn (shaper_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-005 (paideia-os #2321): read state from cell[+0][15:8]. u8 extraction via shr 8 / shl 56 / shr 56. Labels prefixed indic_shaping_gsr_.",
      block: {
        mov rax, [rdi + 0];
        shr rax, 8;
        shl rax, 56;
        shr rax, 56;
        ret
      }
    }

  pub let indic_shaping_get_cluster_length : (u64) -> u64 !{mem} @{} =
    fn (shaper_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-005 (paideia-os #2321): read cluster_length from cell[+0][23:16]. u8 extraction via shr 16 / shl 56 / shr 56. Labels prefixed indic_shaping_gcl_.",
      block: {
        mov rax, [rdi + 0];
        shr rax, 16;
        shl rax, 56;
        shr rax, 56;
        ret
      }
    }

  pub let indic_shaping_get_buffer_offset : (u64) -> u64 !{mem} @{} =
    fn (shaper_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-005 (paideia-os #2321): read cluster_buffer_offset from cell[+0][63:32]. u32 extraction via shr 32. Labels prefixed indic_shaping_gbo_.",
      block: {
        mov rax, [rdi + 0];
        shr rax, 32;
        ret
      }
    }

  pub let indic_shaping_get_output_offset : (u64) -> u64 !{mem} @{} =
    fn (shaper_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-005 (paideia-os #2321): read output_offset from cell[+8] (full u64). Labels prefixed indic_shaping_goo_.",
      block: {
        mov rax, [rdi + 8];
        ret
      }
    }

  // ==========================================================================
  // SECTION 7 -- INIT FACTORY
  // ==========================================================================
  //
  // indic_shape_init(shaper_ptr, script) -> u64
  //
  //   Populate a caller-owned 32-byte shaper cell with defaults.
  //   Contract:
  //
  //     (1) shaper_ptr == 0                   -> IS_SHAPER_NULL
  //     (2) script > SCRIPT_MAX               -> IS_BAD_SCRIPT
  //     (3) success: stamp the cell:
  //           cell[+0]   = script  (state=CS_IDLE(0), cluster_length=0,
  //                                 reserved=0, cluster_buffer_offset=0)
  //           cell[+8]   = 0       (output_offset)
  //           cell[+16]  = 0       (reserved0)
  //           cell[+24]  = 0       (reserved1)
  //         bump IS_ST_INITS; return IS_OK.
  //
  //   No provider registration (value-type module; distinct from
  //   the IME provider satellites). Refusal funnel bumps IS_ST_
  //   REFUSED once at indic_shape_init_refused.
  //
  //   Register plan (two callee-save pushes + sub rsp,8 = 24 bytes;
  //   entry rsp%16==8 -> 24+8=32 %16==0 for nested calls
  //   (indic_shaping_note only)):
  //     rbx = shaper_ptr
  //     r12 = script
  pub let indic_shape_init : (u64, u64) -> u64 !{mem} @{} =
    fn (shaper_ptr: u64) (script: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-005 (paideia-os #2321): shaper-cell init factory. Two callee-save pushes + sub rsp,8 = 24 bytes; entry rsp%16==8 -> 24+8=32 %16==0 for nested calls (indic_shaping_note). Args stashed BEFORE any nested call: rbx=shaper_ptr, r12=script. Cell stamp writes four u64 words directly with `mov [rbx+off], rN` (encoder-conservative). Header word packed with `mov rax, r12` (script only; every other bit-field is zero at init). No `test`, no `add reg,[mem]`, no MOVABS. Labels prefixed indic_shape_init_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        mov rbx, rdi;                       // shaper_ptr
        mov r12, rsi;                       // script

        // (1) shaper_ptr null
        cmp rbx, 0;
        je  indic_shape_init_null_shaper;

        // (2) script range
        cmp r12, 1;
        ja  indic_shape_init_bad_script;

        // (3) stamp the cell. cell[+0] = script (u8 at bits[7:0]);
        // state / cluster_length / reserved / buf_off all zero.
        mov [rbx + 0], r12;                 // low byte = script; upper bytes zero

        // cell[+8]: output_offset = 0
        xor rax, rax;
        mov [rbx + 8], rax;

        // cell[+16]: reserved0 = 0
        mov [rbx + 16], rax;

        // cell[+24]: reserved1 = 0
        mov [rbx + 24], rax;

        // Bump IS_ST_INITS.
        mov rdi, 0;                         // IS_ST_INITS
        call indic_shaping_note;

        xor rax, rax;                       // IS_OK
        jmp indic_shape_init_out;

      indic_shape_init_null_shaper:
        mov rax, 0xFFFFE7EF;                // IS_SHAPER_NULL
        jmp indic_shape_init_refused;
      indic_shape_init_bad_script:
        mov rax, 0xFFFFE7EE;                // IS_BAD_SCRIPT
        // fallthrough

      indic_shape_init_refused:
        // Stash refusal code across the note call.
        mov r12, rax;
        mov rdi, 5;                         // IS_ST_REFUSED
        call indic_shaping_note;
        mov rax, r12;

      indic_shape_init_out:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION 8 -- INGEST (per-codepoint state advance)
  // ==========================================================================
  //
  // indic_shape_ingest(shaper_ptr, codepoint) -> u64
  //
  //   Advance the cluster state machine by one codepoint. Contract:
  //
  //     (1) shaper_ptr == 0                   -> IS_SHAPER_NULL
  //     (2) codepoint upper 32 bits set       -> IS_BAD_CODEPOINT
  //     (3) cell state byte > CS_MAX          -> IS_BAD_STATE
  //     (4) cluster_length at cap             -> IS_CLUSTER_OVERFLOW
  //                                              (bumps IS_ST_OVERFLOWS)
  //     (5) success: classify the codepoint against the script's
  //         codepoint-class ranges (SECTION 1.4) and drive the
  //         state machine:
  //
  //           CS_IDLE:
  //             consonant  -> CS_CONSONANT
  //             matra      -> CS_IDLE (stray matra; treated as
  //                            standalone cluster of length 1)
  //             virama     -> CS_IDLE (stray virama; same)
  //             other      -> CS_IDLE (unclassified; passthrough
  //                            as trivial cluster)
  //
  //           CS_CONSONANT:
  //             consonant  -> CS_CONSONANT (implicit cluster
  //                            boundary; new base opens)
  //             matra      -> CS_MATRA
  //             virama     -> CS_VIRAMA
  //             other      -> CS_IDLE (cluster closes)
  //
  //           CS_VIRAMA:
  //             consonant  -> CS_CONSONANT (conjunct join)
  //             matra      -> CS_MATRA (half-form + vowel-sign;
  //                            uncommon but legal)
  //             virama     -> CS_VIRAMA (double virama; latter
  //                            wins)
  //             other      -> CS_IDLE (half-form tail; cluster
  //                            closes with visible virama)
  //
  //           CS_MATRA:
  //             consonant  -> CS_CONSONANT (new cluster opens)
  //             matra      -> CS_MATRA (chained matras; the
  //                            USE spec allows a matra + secondary
  //                            vowel-sign sequence for scripts we
  //                            do not yet cover, so we forgive it
  //                            here to keep future extension open)
  //             virama     -> CS_VIRAMA (rare; deferred to
  //                            per-script substrate)
  //             other      -> CS_IDLE (cluster closes)
  //
  //           CS_VOWEL: identical dispatch as CS_MATRA (retained
  //             for future extension; the state field itself
  //             may switch to CS_VOWEL from a future
  //             independent-vowel-adjacent ingest without
  //             breaking any current arm).
  //
  //         bump cluster_length by 1 (saturating at
  //         IS_CLUSTER_LEN_MAX -- an at-cap ingest returns
  //         IS_CLUSTER_OVERFLOW rather than silently wrapping);
  //         write back cell[+0]; bump IS_ST_INGESTS; on cluster
  //         boundary (new state == CS_IDLE from a non-IDLE prior)
  //         bump IS_ST_CLUSTERS. Return IS_OK.
  //
  //   The classification / dispatch is INTENTIONALLY MINIMAL at
  //   this landing per the row's "may be stub that just updates
  //   state + bumps cluster_length" allowance: the state machine
  //   shape is fully realized (every arm above is a real
  //   transition, not a passthrough), but the OUTPUT emission
  //   (pre-base matra reorder for Devanagari; Ta+Sri shorthand
  //   ligature for Tamil) is deferred to the SDF-renderer
  //   substrate. cluster_buffer_offset and output_offset are
  //   BUMPED here (they are the state machine's own bookkeeping),
  //   but the caller's ACTUAL buffer is not touched by this file
  //   -- the caller provisions the buffers and reads the offsets
  //   as advisory hints for its own write pointer.
  //
  //   Register plan (three callee-save pushes = 24 bytes; entry
  //   rsp%16==8 -> after three pushes rsp%16 == (8-24) mod 16 ==
  //   0, aligned for nested calls (indic_shaping_note only);
  //   odd-push-count keeps SysV alignment on its own):
  //     rbx = shaper_ptr
  //     r12 = codepoint
  //     r13 = classified action tag (1=consonant, 2=matra,
  //           3=virama, 0=other) OR unused after the classifier
  //           collapses into the state-transition write
  pub let indic_shape_ingest : (u64, u64) -> u64 !{mem} @{} =
    fn (shaper_ptr: u64) (codepoint: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-005 (paideia-os #2321): per-codepoint state advance. Three callee-save pushes = 24 bytes; entry rsp%16==8 -> (8-24) mod 16 == 0, aligned for nested calls (indic_shaping_note). Order: (1) null gate. (2) codepoint u32 range. (3) load state + validate. (4) classify codepoint against per-script ranges (branch on script byte first, then range test). (5) drive state transition via the 4x4 (state, class) dispatch. (6) bump cluster_length with cap check. (7) write back cell[+0] with new state + cluster_length. (8) bump IS_ST_INGESTS; on cluster-close bump IS_ST_CLUSTERS. Small immediates only; no MOVABS; no `test`; no `add reg,[mem]`. u8 extraction via shl 56/shr 56 pairs. Labels prefixed indic_shape_ingest_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;
        mov r12, rsi;

        // (1) shaper_ptr null
        cmp rbx, 0;
        je  indic_shape_ingest_null_shaper;

        // (2) codepoint u32 range (upper 32 bits must be zero)
        mov rax, r12;
        shr rax, 32;
        cmp rax, 0;
        jne indic_shape_ingest_bad_cp;

        // (3) load header word and extract state (byte 1) + script
        //     (byte 0) + cluster_length (byte 2).
        mov r13, [rbx + 0];                 // r13 = header word

        //     state = header[15:8]
        mov rax, r13;
        shr rax, 8;
        shl rax, 56;
        shr rax, 56;                        // rax = state

        cmp rax, 4;                         // CS_MAX
        ja  indic_shape_ingest_bad_state;

        //     Preserve state in r10 for the transition arms.
        mov r10, rax;

        //     cluster_length = header[23:16]
        mov rax, r13;
        shr rax, 16;
        shl rax, 56;
        shr rax, 56;                        // rax = cluster_length

        cmp rax, 255;                       // IS_CLUSTER_LEN_MAX
        jae indic_shape_ingest_overflow;

        //     Reserve rax for cluster_length update below; move to rcx.
        mov rcx, rax;                       // rcx = cluster_length

        //     script = header[7:0]
        mov rax, r13;
        shl rax, 56;
        shr rax, 56;                        // rax = script

        // (4) classify codepoint against per-script ranges. rax has
        //     script (0=Devanagari, 1=Tamil), r12 has codepoint.
        //     Result -> r13 (reused): 0=other, 1=consonant,
        //     2=matra, 3=virama.
        //
        //     Devanagari branch first (script == 0).
        cmp rax, 0;
        jne indic_shape_ingest_tamil_classify;

        //     Devanagari classifier.
        //     virama: codepoint == 0x094D
        cmp r12, 0x094D;
        je  indic_shape_ingest_class_virama;
        //     matra range: 0x093E..0x094C
        cmp r12, 0x093E;
        jb  indic_shape_ingest_dev_check_cons;
        cmp r12, 0x094C;
        ja  indic_shape_ingest_dev_check_cons;
        jmp indic_shape_ingest_class_matra;
      indic_shape_ingest_dev_check_cons:
        //     consonant range: 0x0915..0x0939
        cmp r12, 0x0915;
        jb  indic_shape_ingest_class_other;
        cmp r12, 0x0939;
        ja  indic_shape_ingest_class_other;
        jmp indic_shape_ingest_class_consonant;

      indic_shape_ingest_tamil_classify:
        //     Tamil classifier.
        //     virama: codepoint == 0x0BCD
        cmp r12, 0x0BCD;
        je  indic_shape_ingest_class_virama;
        //     matra range: 0x0BBE..0x0BCC
        cmp r12, 0x0BBE;
        jb  indic_shape_ingest_tam_check_cons;
        cmp r12, 0x0BCC;
        ja  indic_shape_ingest_tam_check_cons;
        jmp indic_shape_ingest_class_matra;
      indic_shape_ingest_tam_check_cons:
        //     consonant range: 0x0B95..0x0BB9
        cmp r12, 0x0B95;
        jb  indic_shape_ingest_class_other;
        cmp r12, 0x0BB9;
        ja  indic_shape_ingest_class_other;
        jmp indic_shape_ingest_class_consonant;

      indic_shape_ingest_class_other:
        xor r13, r13;                       // 0 = other
        jmp indic_shape_ingest_transition;
      indic_shape_ingest_class_consonant:
        mov r13, 1;                         // 1 = consonant
        jmp indic_shape_ingest_transition;
      indic_shape_ingest_class_matra:
        mov r13, 2;                         // 2 = matra
        jmp indic_shape_ingest_transition;
      indic_shape_ingest_class_virama:
        mov r13, 3;                         // 3 = virama
        // fallthrough

        // (5) state transition. r10 = prior state, r13 = class.
        //     Compute new state -> rax.
      indic_shape_ingest_transition:
        //     Branch on prior state.
        cmp r10, 0;
        je  indic_shape_ingest_from_idle;
        cmp r10, 1;
        je  indic_shape_ingest_from_consonant;
        cmp r10, 2;
        je  indic_shape_ingest_from_vowel;
        cmp r10, 3;
        je  indic_shape_ingest_from_virama;
        //     r10 == 4 (CS_MATRA)
        jmp indic_shape_ingest_from_matra;

      indic_shape_ingest_from_idle:
        //     From CS_IDLE:
        //       consonant -> CS_CONSONANT (1)
        //       else      -> CS_IDLE (0)
        cmp r13, 1;
        je  indic_shape_ingest_to_consonant;
        jmp indic_shape_ingest_to_idle;

      indic_shape_ingest_from_consonant:
        //     From CS_CONSONANT:
        //       consonant -> CS_CONSONANT (implicit boundary)
        //       matra     -> CS_MATRA
        //       virama    -> CS_VIRAMA
        //       other     -> CS_IDLE (cluster closes)
        cmp r13, 1;
        je  indic_shape_ingest_to_consonant;
        cmp r13, 2;
        je  indic_shape_ingest_to_matra;
        cmp r13, 3;
        je  indic_shape_ingest_to_virama;
        jmp indic_shape_ingest_to_idle;

      indic_shape_ingest_from_vowel:
        //     From CS_VOWEL (identical to CS_MATRA dispatch):
      indic_shape_ingest_from_matra:
        //     From CS_MATRA:
        //       consonant -> CS_CONSONANT (new cluster opens)
        //       matra     -> CS_MATRA (chained matras)
        //       virama    -> CS_VIRAMA (rare; deferred)
        //       other     -> CS_IDLE (cluster closes)
        cmp r13, 1;
        je  indic_shape_ingest_to_consonant;
        cmp r13, 2;
        je  indic_shape_ingest_to_matra;
        cmp r13, 3;
        je  indic_shape_ingest_to_virama;
        jmp indic_shape_ingest_to_idle;

      indic_shape_ingest_from_virama:
        //     From CS_VIRAMA:
        //       consonant -> CS_CONSONANT (conjunct join)
        //       matra     -> CS_MATRA
        //       virama    -> CS_VIRAMA (double virama; latter wins)
        //       other     -> CS_IDLE (half-form tail)
        cmp r13, 1;
        je  indic_shape_ingest_to_consonant;
        cmp r13, 2;
        je  indic_shape_ingest_to_matra;
        cmp r13, 3;
        je  indic_shape_ingest_to_virama;
        jmp indic_shape_ingest_to_idle;

      indic_shape_ingest_to_idle:
        xor rax, rax;                       // new state = CS_IDLE (0)
        jmp indic_shape_ingest_stamp;
      indic_shape_ingest_to_consonant:
        mov rax, 1;                         // CS_CONSONANT
        jmp indic_shape_ingest_stamp;
      indic_shape_ingest_to_matra:
        mov rax, 4;                         // CS_MATRA
        jmp indic_shape_ingest_stamp;
      indic_shape_ingest_to_virama:
        mov rax, 3;                         // CS_VIRAMA
        // fallthrough

        // (6-7) rewrite cell[+0].
        //   header layout: script[7:0] | state[15:8] |
        //     cluster_length[23:16] | reserved[31:24] |
        //     buffer_offset[63:32]
        //
        //   Preserve script (existing r13 = header word overwritten;
        //   we saved script value implicitly by rebuilding header
        //   from parts). Simpler path: OR the new fields into a
        //   fresh word alongside the preserved script from the
        //   original header.
      indic_shape_ingest_stamp:
        //     rax = new state (u8, in [0,4])
        //     rcx = old cluster_length (u8, in [0,254])
        //
        //     Bump cluster_length by 1 (bounds already checked at (4)).
        add rcx, 1;
        //     But if we transitioned to CS_IDLE from a non-IDLE prior
        //     (a cluster closed on this ingest), reset cluster_length
        //     to 0 so the next ingest starts a fresh cluster from 0.
        //     r10 still holds prior state; rax the new state.
        cmp rax, 0;
        jne indic_shape_ingest_pack;
        //     new == CS_IDLE: check prior.
        cmp r10, 0;
        je  indic_shape_ingest_pack;        // was idle -> keep count
        //     was non-idle, now idle: cluster closed, reset count.
        xor rcx, rcx;
        //     Remember we closed a cluster: r11 signals a bump of
        //     IS_ST_CLUSTERS after the stamp.
        mov r11, 1;
        jmp indic_shape_ingest_pack2;
      indic_shape_ingest_pack:
        xor r11, r11;                       // no cluster closed
      indic_shape_ingest_pack2:
        //     Rebuild header word:
        //       script byte    <- reload from original header (in [rbx+0])
        //       state byte     <- rax (new state)
        //       cluster_length <- rcx
        //       reserved       <- 0
        //       buf_offset     <- preserve from original (bump by 4 on
        //                          successful ingest; reset to 0 if
        //                          new state == CS_IDLE from non-IDLE
        //                          -- signaled by r11)
        //
        //     Reload original header into r13.
        mov r13, [rbx + 0];

        //     Extract script (u8) into r9.
        mov r9, r13;
        shl r9, 56;
        shr r9, 56;                         // r9 = script

        //     Extract buffer_offset (u32) into r8.
        mov r8, r13;
        shr r8, 32;                         // r8 = buffer_offset (in low 32)

        //     Bump or reset buffer_offset.
        cmp r11, 0;
        je  indic_shape_ingest_buf_bump;
        //     cluster closed: reset to 0.
        xor r8, r8;
        jmp indic_shape_ingest_buf_done;
      indic_shape_ingest_buf_bump:
        //     Bump by 4 (one u32 codepoint slot).
        add r8, 4;
        //     Mask to u32.
        shl r8, 32;
        shr r8, 32;
      indic_shape_ingest_buf_done:
        //     Pack into new header word in r13:
        //       r13 = script (byte 0)
        mov r13, r9;
        //       | (state << 8)
        shl rax, 8;
        or  r13, rax;
        //       | (cluster_length << 16)
        shl rcx, 16;
        or  r13, rcx;
        //       | (buffer_offset << 32)
        shl r8, 32;
        or  r13, r8;

        mov [rbx + 0], r13;

        //     If we closed a cluster, bump IS_ST_CLUSTERS FIRST (r11
        //     is caller-save; sequencing this before the ingest bump
        //     lets us read r11 without needing to survive the second
        //     note call. The order between counters is telemetry-
        //     irrelevant.)
        cmp r11, 0;
        je  indic_shape_ingest_bump_ingests;
        mov rdi, 4;                         // IS_ST_CLUSTERS
        call indic_shaping_note;
      indic_shape_ingest_bump_ingests:
        //     Bump IS_ST_INGESTS.
        mov rdi, 1;                         // IS_ST_INGESTS
        call indic_shaping_note;
      indic_shape_ingest_ok:
        xor rax, rax;                       // IS_OK
        jmp indic_shape_ingest_out;

      indic_shape_ingest_null_shaper:
        mov rax, 0xFFFFE7EF;                // IS_SHAPER_NULL
        jmp indic_shape_ingest_refused;
      indic_shape_ingest_bad_cp:
        mov rax, 0xFFFFE7EC;                // IS_BAD_CODEPOINT
        jmp indic_shape_ingest_refused;
      indic_shape_ingest_bad_state:
        mov rax, 0xFFFFE7ED;                // IS_BAD_STATE
        jmp indic_shape_ingest_refused;
      indic_shape_ingest_overflow:
        mov rax, 0xFFFFE7EB;                // IS_CLUSTER_OVERFLOW
        //     Also bump the dedicated overflow counter.
        mov r13, rax;                       // stash refusal
        mov rdi, 6;                         // IS_ST_OVERFLOWS
        call indic_shaping_note;
        mov rax, r13;
        // fallthrough

      indic_shape_ingest_refused:
        mov r13, rax;
        mov rdi, 5;                         // IS_ST_REFUSED
        call indic_shaping_note;
        mov rax, r13;

      indic_shape_ingest_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION 9 -- FLUSH (force cluster boundary)
  // ==========================================================================
  //
  // indic_shape_flush(shaper_ptr) -> u64
  //
  //   Force a cluster boundary NOW: drop back to CS_IDLE, clear
  //   cluster_length + cluster_buffer_offset, but DO NOT touch
  //   output_offset or script. The caller invokes this at
  //   end-of-paragraph, or at an explicit fence (e.g. a Unicode
  //   Object Replacement Character U+FFFC), or before switching
  //   to a fresh input stream on the same shaper cell.
  //
  //   Contract:
  //     (1) shaper_ptr == 0                   -> IS_SHAPER_NULL
  //     (2) success: rewrite cell[+0] with script preserved,
  //         state=CS_IDLE, cluster_length=0, buf_offset=0;
  //         bump IS_ST_FLUSHES; if the prior state was NOT
  //         CS_IDLE (a cluster was in flight), also bump
  //         IS_ST_CLUSTERS. Return IS_OK.
  //
  //   No init gate (a flush on a bare/zero cell is a legitimate
  //   no-op: script=0, state=IDLE, nothing to close).
  //
  //   Register plan (one callee-save push = 8 bytes; entry rsp%16
  //   ==8 -> after push rsp%16==0 for the note calls; odd-push-
  //   count keeps SysV alignment on its own):
  //     rbx = shaper_ptr
  pub let indic_shape_flush : (u64) -> u64 !{mem} @{} =
    fn (shaper_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-005 (paideia-os #2321): force cluster boundary. One callee-save push = 8 bytes; entry rsp%16==8 -> after push rsp%16==0, aligned for the note call. Order: null gate; load header; preserve script byte; write new header (script only, all other fields zero); bump IS_ST_FLUSHES; if prior state was non-IDLE, also bump IS_ST_CLUSTERS. Labels prefixed indic_shape_flush_.",
      block: {
        push rbx;

        mov rbx, rdi;

        cmp rbx, 0;
        je  indic_shape_flush_null_shaper;

        // Load header; preserve script; extract prior state to r10.
        mov rax, [rbx + 0];

        // r10 = prior state
        mov r10, rax;
        shr r10, 8;
        shl r10, 56;
        shr r10, 56;

        // script byte (bits [7:0]) preserved in rax after masking.
        shl rax, 56;
        shr rax, 56;                        // rax = script only

        // Write new header: script only; all other bytes zero.
        mov [rbx + 0], rax;

        // Bump IS_ST_FLUSHES.
        mov rdi, 2;                         // IS_ST_FLUSHES
        call indic_shaping_note;

        // If prior state was non-IDLE, also bump IS_ST_CLUSTERS
        // (a real cluster was closed by this flush).
        cmp r10, 0;
        je  indic_shape_flush_ok;
        mov rdi, 4;                         // IS_ST_CLUSTERS
        call indic_shaping_note;
      indic_shape_flush_ok:
        xor rax, rax;                       // IS_OK
        jmp indic_shape_flush_out;

      indic_shape_flush_null_shaper:
        mov rax, 0xFFFFE7EF;                // IS_SHAPER_NULL
        // fallthrough

      indic_shape_flush_refused:
        mov rbx, rax;
        mov rdi, 5;                         // IS_ST_REFUSED
        call indic_shaping_note;
        mov rax, rbx;

      indic_shape_flush_out:
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION 10 -- RESET (clear buffer + state)
  // ==========================================================================
  //
  // indic_shape_reset(shaper_ptr) -> u64
  //
  //   Discard all in-flight state AND output_offset: essentially
  //   re-run init on the current cell with the same script. Used
  //   by callers that want to reuse a shaper cell for a fresh
  //   pass (e.g. re-shaping the same paragraph after a font
  //   substitution).
  //
  //   Contract:
  //     (1) shaper_ptr == 0                   -> IS_SHAPER_NULL
  //     (2) success: rewrite cell[+0] with script preserved,
  //         every other field zero; cell[+8] = 0; cell[+16]..[+31]
  //         untouched (already zero unless the caller mutated
  //         reserved slots -- and if they did, that's their
  //         reservation to manage). Bump IS_ST_RESETS. Return
  //         IS_OK.
  //
  //   No init gate. A reset on an idle cell is a legitimate no-op.
  //
  //   Register plan (one callee-save push = 8 bytes; entry rsp%16
  //   ==8 -> after push rsp%16==0 for the note call):
  //     rbx = shaper_ptr
  pub let indic_shape_reset : (u64) -> u64 !{mem} @{} =
    fn (shaper_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-005 (paideia-os #2321): clear all in-flight state, preserve script. One callee-save push = 8 bytes; entry rsp%16==8 -> after push rsp%16==0, aligned for the note call. Labels prefixed indic_shape_reset_.",
      block: {
        push rbx;

        mov rbx, rdi;

        cmp rbx, 0;
        je  indic_shape_reset_null_shaper;

        // Load header; mask to script byte only.
        mov rax, [rbx + 0];
        shl rax, 56;
        shr rax, 56;                        // rax = script

        // Rewrite header: script only, everything else zero.
        mov [rbx + 0], rax;

        // Clear output_offset.
        xor rax, rax;
        mov [rbx + 8], rax;

        // Bump IS_ST_RESETS.
        mov rdi, 3;                         // IS_ST_RESETS
        call indic_shaping_note;

        xor rax, rax;                       // IS_OK
        jmp indic_shape_reset_out;

      indic_shape_reset_null_shaper:
        mov rax, 0xFFFFE7EF;                // IS_SHAPER_NULL
        // fallthrough

      indic_shape_reset_refused:
        mov rbx, rax;
        mov rdi, 5;                         // IS_ST_REFUSED
        call indic_shaping_note;
        mov rax, rbx;

      indic_shape_reset_out:
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION 11 -- PUBLIC ACCESSORS (state / script)
  // ==========================================================================
  //
  // The internal getters in SECTION 6 skip null gates for speed
  // on the ingest hot path (which has already gated). These
  // public wrappers gate on null and return the refusal
  // sentinel in the high bits for out-of-band callers.

  // indic_shape_state(shaper_ptr) -> u64
  //   Return the state byte (0..4), or IS_SHAPER_NULL on null.
  pub let indic_shape_state : (u64) -> u64 !{mem} @{} =
    fn (shaper_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-005 (paideia-os #2321): public state read. Null gate; read cell[+0][15:8]. Labels prefixed indic_shape_state_.",
      block: {
        cmp rdi, 0;
        je  indic_shape_state_null;
        mov rax, [rdi + 0];
        shr rax, 8;
        shl rax, 56;
        shr rax, 56;
        ret;
      indic_shape_state_null:
        mov rax, 0xFFFFE7EF;                // IS_SHAPER_NULL
        ret
      }
    }

  // indic_shape_script(shaper_ptr) -> u64
  //   Return the script byte (0 or 1), or IS_SHAPER_NULL on null.
  pub let indic_shape_script : (u64) -> u64 !{mem} @{} =
    fn (shaper_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-005 (paideia-os #2321): public script read. Null gate; read cell[+0][7:0]. Labels prefixed indic_shape_script_.",
      block: {
        cmp rdi, 0;
        je  indic_shape_script_null;
        mov rax, [rdi + 0];
        shl rax, 56;
        shr rax, 56;
        ret;
      indic_shape_script_null:
        mov rax, 0xFFFFE7EF;                // IS_SHAPER_NULL
        ret
      }
    }
}
