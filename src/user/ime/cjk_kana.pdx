// src/user/ime/cjk_kana.pdx -- G11-M4-004 (paideia-os #2320)
//
// CJK IME PROVIDER SATELLITE -- SYLLABIC ENGINES (Kana, Kanji, Hangul).
//
// A userspace IME provider process that registers with the KIND_IME_
// PROVIDER substrate (§2.19, sibling landing #2315, LANDED B10) under
// LANG_CJK_JA (Japanese: Hiragana / Katakana / Kanji) or LANG_CJK_KO
// (Korean: Hangul) and services SYLLABIC composition:
//
//   * Kana (Hiragana / Katakana).  Each keystroke maps a Latin
//     phonetic key (or a hardware Kana key) to a Kana glyph.  The
//     mapping is 1:1 by keystroke round for the pure-Kana modes:
//     each key press completes a syllable, so the engine's composed
//     output is a single Kana code point per event.  Users may still
//     view an intermediate preedit while typing multi-mora sequences
//     with a phonetic-input IME (e.g. `k` armed, then `a` -> か),
//     but at THIS landing the schema is single-key -> single-glyph
//     with the multi-mora extension deferred to the future phonetic
//     substrate (mirrors the deferred n-gram table in latin_
//     autocomplete #2317 and the deferred compose table in latin_
//     deadkey #2318).
//
//   * Kanji (via Hiragana preedit).  User types Hiragana; on Space
//     (or a designated conversion key), the engine looks up the
//     accumulated Hiragana prefix in a hiragana->kanji candidate
//     table.  Multiple candidates cycle via arrow / space presses
//     (the standard "convert / next candidate" pattern shared with
//     ibus-anthy / mozc); Return commits the current selection.
//     The candidate-table pointer is opaque at this landing (the
//     table format is caller-defined; the same substrate-deferred
//     posture as latin_autocomplete's n-gram table and latin_
//     deadkey's compose table).
//
//   * Hangul (jamo composition).  The Korean syllable-block model:
//     one syllable = L (leading consonant, choseong, U+1100..1112)
//     + V (vowel, jungseong, U+1161..1175) + optional T (trailing
//     consonant, jongseong, U+11A8..11C2).  The Unicode combining
//     formula for a precomposed syllable is
//
//         syllable = 0xAC00 + (L_idx * 21 + V_idx) * 28 + T_idx
//
//     where L_idx = L - 0x1100 (0..18), V_idx = V - 0x1161 (0..20),
//     T_idx = 0 iff no trailing (else T - 0x11A7, 1..27).  The
//     engine's state machine accumulates the three jamo into
//     `pending_jamo_offset` (used as a packed jamo-state word rather
//     than an interned-string offset when the engine is in HANGUL
//     variant -- the field is repurposed by variant) and stamps
//     `composed_syllable_offset` with the composed syllable on each
//     completed jamo triple.  On a boundary (a subsequent L jamo, a
//     non-jamo char, an explicit commit), the pending state is
//     committed and cleared.
//
// Design authority:
//   * design/compositor/pwp-spec-vocabulary.md §2.19 KIND_IME_PROVIDER
//     -- names Kana and Hangul as canonical provider families
//     (fourth and fifth of the seven, after the two Latin families
//     #2317 / #2318 and the CJK phonetic family this landing's B13
//     sibling covers).
//   * src/user/ime/provider_kind.pdx §1.3 (LANG_CJK_JA = 2,
//     LANG_CJK_KO = 3) -- the enum slots this file's registration
//     uses (per-variant: Hiragana/Katakana/Kanji land on CJK_JA,
//     Hangul lands on CJK_KO).
//   * src/user/ime/session_kind.pdx §1.3 (COMMIT_TEXT op semantics)
//     -- the router-side commit path this file's cjk_kana_commit
//     feeds via the currently-bound session_kind_id.
//   * The Unicode Standard, chapter 3, "Hangul Syllable
//     Composition" -- the L/V/T algorithm the HANGUL variant's
//     on_key body implements.  (Value ranges pinned as constants
//     below so a future edit to the Standard's ranges is a single-
//     point change in this file.)
//
// SYLLABIC vs. PHONETIC RATIONALE.  The B13 CJK batch splits the
// three CJK provider families into two files:
//
//   * The PHONETIC sibling (this landing's B13-01 partner, CJK
//     Pinyin/Zhuyin) handles multi-syllable phonetic input where
//     the engine accumulates a phonetic string and does a sub-word
//     dictionary lookup (Pinyin `beijing` -> 北京; Zhuyin
//     `ㄅㄟㄗ` -> 貝).
//
//   * The SYLLABIC family (this file) handles input methods whose
//     unit of composition is a SINGLE syllable at a time.  Kana
//     modes commit one glyph per event round; Kanji-via-hiragana
//     accumulates a syllable-run and looks up the accumulated
//     string; Hangul composes exactly one syllable at a time from
//     jamo pieces.
//
// The distinction is architectural: phonetic input's dictionary is
// large (tens of thousands of entries) and the lookup key is a
// variable-length phonetic string, so its cell shape carries a
// phonetic-buffer offset + candidate ring.  Syllabic input's
// dictionary is either absent (Kana), present but keyed on
// short-fixed-length phonetic strings (Kanji: 1..N hiragana), or
// entirely algorithmic (Hangul), so a single 32-byte cell suffices.
// Splitting them keeps each engine's state machine minimal and
// each dictionary shape unrelated.
//
// SCHEMA-ONLY CANDIDATE LOOKUP.  For the KANJI variant, the
// hanja_kanji_candidates_ptr is passed in as an opaque pointer at
// init time; its layout is defined by the caller (the satellite
// process's own conversion-table provisioner) and is NOT
// interpreted by this file's assembly beyond a null check.  The
// on_key body's KANJI arm does the accumulate-then-lookup dance
// but the lookup itself is a stub that returns 0 (no candidates)
// -- the same deferred-substrate posture as latin_autocomplete's
// n-gram scan and latin_deadkey's compose-table probe.  Once the
// real conversion table lands, hits populate `composed_syllable_
// offset` with the top candidate and `candidate_count` with the
// N-best count; today they both stay 0 and the engine truthfully
// reports "no candidates available yet".
//
// PER-PROCESS SATELLITE.  One instance of this engine per satellite
// process, typically one process per variant per session (a
// Japanese-typing user runs one HIRAGANA + one KANJI engine
// simultaneously so a Space press converts the current hiragana
// preedit to kanji candidates without the user having to switch
// providers).  A polyglot user might run all four variants at
// once.  The engine cell is CALLER-OWNED (the satellite process
// allocates it on its stack or in .bss and passes the pointer
// into every op); this file does NOT hold a module singleton
// (same pattern as latin_autocomplete / latin_deadkey / focus_
// router precedent).
//
// CJK KANA ENGINE STRUCT.  The natural typing is
//
//   struct CjkKanaEngine {
//     provider_kind_id: u32,
//     variant: u8,                        // SYLL_HIRAGANA/KATAKANA/KANJI/HANGUL
//     session_kind_id: u32,               // 0 = unbound
//     pending_jamo_offset: u32,           // repurposed by variant:
//                                         //   HIRAGANA/KATAKANA: 0 (unused)
//                                         //   KANJI: interned offset of the
//                                         //          accumulating hiragana
//                                         //          preedit buffer
//                                         //   HANGUL: packed jamo state
//                                         //           (L | V<<8 | T<<16 |
//                                         //           has_L | has_V | has_T)
//     composed_syllable_offset: u32,      // current output glyph or offset
//     hanja_kanji_candidates_ptr: u64,    // KANJI only; opaque
//     candidate_count: u8                 // 0..CK_CANDIDATE_MAX
//   }
//
// but paideia-as does not currently return structs by value from
// asm bodies (mirrors the note in latin_autocomplete.pdx / latin_
// deadkey.pdx / focus_router.pdx / input_server precedent), so the
// wire-level shape is a 32-byte caller-owned cell that this file
// populates in place via fixed-offset word writes.  Callers read
// fields via the getters below once CK_OK is returned.  The
// struct declaration below is DOCUMENTATION ONLY.
//
// vs. latin_deadkey: deadkey packs state + two u16 pending fields
// into cell[+16]; cjk_kana packs pending_jamo + composed_syllable
// into cell[+16] (both u32) and puts variant + candidate_count
// into cell[+24].  Both cells are 32 bytes; both register via the
// same ime_provider_register(lang, locale, caps) call, but the
// lang argument is variant-computed (variant 0/1/2 -> LANG_CJK_JA
// = 2, variant 3 -> LANG_CJK_KO = 3) and the caps are variant-
// computed too (Hiragana/Katakana: preedit only, no candidate
// window; Kanji/Hangul: preedit + candidate window).
//
// LABEL PREFIX.  `cjk_kana_` throughout, sidestepping paideia-as
// reserved-word collisions (see feedback_paideia_as_reserved_
// labels).  Every ASM jump target is `cjk_kana_<funcname>_<tag>`
// to avoid the same class.
//
// MECE SCOPE.  Single file under src/user/ime/.  Touches only:
//   * NEW: src/user/ime/cjk_kana.pdx (this file)
//   * EDIT: tools/verify-fingerprint-coverage.sh (add allowlist
//           entry for pdx_kind_cjk_kana_meta since the satellite-
//           side dispatcher that would emit it is a future landing)
// No other file is modified.
//
// FAILURE BAND.  Row prompt named 0xFFFFE7D0..0xFFFFE7DF.  Grep-
// verified free across src/ + tests/ + design/ at landing time
// (zero occurrences of any 0xFFFFE7D* sentinel in the whole
// tree).  Sits contiguously in the G11.M4 provider-family cluster:
// latin_autocomplete uses 0xFFFFE7A0..AF (#2317), latin_deadkey
// uses 0xFFFFE7B0..BF (#2318), the sibling CJK phonetic
// provider (#2319, B13-01) will homestead 0xFFFFE7C0..CF, and
// this file takes 0xFFFFE7D0..DF.  Adjacent pages 0xFFFFE7E0..EF
// and 0xFFFFE7F0..FF remain free for the two remaining canonical
// provider families (Indic Devanagari + InScript, G11.M4-005/006).
//
// FINGERPRINT.  One legacy-suffixed init fingerprint per the
// standard klog convention (matches session_kind / provider_kind /
// latin_autocomplete / latin_deadkey precedent).  Emitted once on
// successful engine init by the future satellite-side substrate;
// no fingerprint on the on_key / commit / cancel paths (those
// fire per keystroke in an interactive session and would flood
// the ring, same rationale as tag_tty_read_ok in keys.pdx).
// Until the substrate lands, the tag is DATA-ONLY (declared here
// but not emitted from any body) -- verify-fingerprint-coverage.
// sh gets a matching allowlist entry per the sibling B8/B10/B11/
// B12 pattern.
//
// Encoder-conservative pattern per session_kind / provider_kind /
// latin_autocomplete / latin_deadkey: no `and reg, imm64`, no
// MOVABS r64,imm64, no `test`, no `add reg,[mem]`, no
// `mov_bzx`/`mov_wzx`; 32-bit zero-extension via shl+shr;
// small immediates only.  u32 field extraction uses shl 32 /
// shr 32; u8 field extraction uses shl 56 / shr 56.
//
// =============================================================================

module CjkKana = structure {

  // ==========================================================================
  // SECTION 1.1 -- PROVIDER-FAMILY PINS (mirror of ProviderKind)
  // ==========================================================================
  //
  // Named locally so assembly bodies can use small immediates
  // rather than cross-module symbol references.  Each pin is
  // asserted in a comment against its source of truth so a
  // future edit to the sibling module cannot silently drift.

  // Mirror of ProviderKind.LANG_CJK_JA (= 2).  Japanese Kana /
  // Kanji variants register under this slot.
  pub let CK_LANG_CJK_JA           : u64 = 2

  // Mirror of ProviderKind.LANG_CJK_KO (= 3).  Korean Hangul
  // variant registers under this slot.
  pub let CK_LANG_CJK_KO           : u64 = 3

  // Mirror of ProviderKind.IME_PROVIDER_LOCALE_UNLOCALED (= 0).
  // CJK syllabic composition is script-scoped, not locale-scoped;
  // ja-JP and ja variants share one Hiragana engine, ko-KR and
  // ko variants share one Hangul engine.  Locale-aware variant
  // extensions (rare) would layer on top via the future router
  // substrate, not via a distinct provider registration.
  pub let CK_LOCALE_UNLOCALED      : u64 = 0

  // Capability bitmap.  All syllabic variants advertise IMP_CAP_
  // PREEDIT (0x01) because the user sees a preedit ghost while
  // typing (a partial Kana / Hangul sequence, or a Hiragana
  // buffer awaiting Kanji conversion).  Kanji and Hangul
  // additionally advertise IMP_CAP_CANDIDATE_WINDOW (0x02) because
  // both admit multiple candidates the user cycles between (Kanji:
  // hiragana->kanji homophones; Hangul: alternative jamo
  // completions for ambiguous keystroke sequences).  Hiragana and
  // Katakana pure modes do not use a candidate window.
  //
  // For simplicity at this landing, ALL variants register with
  // the union set (0x03 = PREEDIT | CANDIDATE_WINDOW).  Advertising
  // a capability the engine happens not to exercise in a
  // particular variant is a legal over-declaration under
  // provider_kind's IMP_BAD_CAPS validator (which refuses only
  // bits ABOVE IMP_CAP_ALL = 0x0F), and it keeps the register
  // path a single ime_provider_register call rather than a
  // variant-switched dispatch.  Per-variant tuning is a router-
  // preference layer decision, not a provider-registration one.
  pub let CK_CAPS_DEFAULT          : u64 = 0x03

  // ==========================================================================
  // SECTION 1.2 -- SYLLABIC VARIANT ENUM
  // ==========================================================================
  //
  // Sealed enum of the four syllabic variants this provider serves.
  // Values are dense (0..3) so the engine's variant-dispatch on
  // on_key can use a single cmp-and-jump ladder over the four
  // arms.  Every variant number > SYLL_MAX is refused at register
  // time with CK_BAD_VARIANT.

  pub let SYLL_HIRAGANA            : u64 = 0
  pub let SYLL_KATAKANA            : u64 = 1
  pub let SYLL_KANJI               : u64 = 2
  pub let SYLL_HANGUL              : u64 = 3
  pub let SYLL_MAX                 : u64 = 3

  // ==========================================================================
  // SECTION 1.3 -- ENGINE CELL LAYOUT (CjkKanaEngine, 32 bytes)
  // ==========================================================================
  //
  // Four u64 words holding the engine's per-instance state.  Every
  // mutating op edits one packed field IN PLACE; the row is
  // written by exactly one thread at a time (single-threaded
  // event loop per engine, mirroring latin_autocomplete /
  // latin_deadkey precedent).
  //
  // Cell layout (offsets in bytes):
  //
  //   [+0]  provider_and_session:
  //             provider_kind_id[31:0]   row_id from
  //                                      ime_provider_register at
  //                                      init time.  Nonzero after
  //                                      successful init.
  //             session_kind_id[63:32]   currently-bound session
  //                                      (router-updated via
  //                                      bind/unbind, out of scope
  //                                      for THIS landing).  0 =
  //                                      not bound (the engine
  //                                      still processes keys and
  //                                      updates state, but a
  //                                      completed composition
  //                                      emits no COMMIT_TEXT
  //                                      event because no session
  //                                      is listening -- commit
  //                                      returns CK_NO_SESSION).
  //
  //   [+8]  hanja_kanji_candidates_ptr: u64
  //             For KANJI variant: pointer to the hiragana->kanji
  //             conversion table (opaque; caller-defined layout).
  //             For every other variant: 0 (unused).
  //
  //   [+16] pending_and_composed:
  //             pending_jamo_offset[31:0]      repurposed per
  //                                            variant.
  //                 HIRAGANA/KATAKANA: 0 (each key completes a
  //                                    syllable; no multi-key
  //                                    accumulator at this
  //                                    landing)
  //                 KANJI: interned string offset of the
  //                        accumulating hiragana preedit buffer
  //                        (0 = empty)
  //                 HANGUL: packed jamo state:
  //                         bits [15:0]   L jamo (0 = none)
  //                         bits [31:16]  V jamo (0 = none)
  //                         (T jamo lives in the top half of the
  //                         cell's counts word so the composition
  //                         can pack L+V without touching T)
  //             composed_syllable_offset[63:32]  the syllable
  //                                              currently
  //                                              composed and
  //                                              ready to commit
  //                                              (0 = empty).
  //                                              For all variants
  //                                              this holds the
  //                                              latest committed-
  //                                              or-committing
  //                                              output glyph code
  //                                              point (u32).
  //
  //   [+24] variant_and_counts:
  //             variant[7:0]              SYLL_* enum value
  //             candidate_count[15:8]     0..CK_CANDIDATE_MAX
  //             hangul_t[31:16]           Hangul T jamo (0 = none);
  //                                       unused in other variants
  //             reserved[63:32]           0 at init; future flags
  //
  // Cell is 32 bytes = one half of a 64-byte cache line.  Cache-
  // line alignment is CALLER'S responsibility (mirrors sibling
  // latin_autocomplete / latin_deadkey).
  //
  // Documentation-only struct declaration (mirrors FocusRouterState
  // / LatinAutocompleteEngine / DeadkeyEngine precedent).

  struct CjkKanaEngine {
    provider_kind_id: u32,
    variant: u8,
    session_kind_id: u32,
    pending_jamo_offset: u32,
    composed_syllable_offset: u32,
    hanja_kanji_candidates_ptr: u64,
    candidate_count: u8
  }

  pub let CK_CELL_BYTES               : u64 = 32
  pub let CK_CELL_OFF_PROVIDER_SESSION: u64 = 0
  pub let CK_CELL_OFF_CANDIDATES_PTR  : u64 = 8
  pub let CK_CELL_OFF_PENDING_COMPOSED: u64 = 16
  pub let CK_CELL_OFF_VARIANT_COUNTS  : u64 = 24

  // Ceiling on the candidate list (KANJI + HANGUL variants).  Eight
  // candidates is the conventional IME candidate-window depth
  // (mirrors LA_CANDIDATE_MAX in latin_autocomplete #2317; matches
  // ibus-anthy / mozc defaults for the visible-in-first-page count).
  pub let CK_CANDIDATE_MAX            : u64 = 8

  // Empty-glyph / empty-buffer sentinels (mirrors LA_PREFIX_EMPTY
  // / IME_SESSION_PREEDIT_EMPTY): offset 0 in the satellite-side
  // pool is reserved for the empty string, and code point 0
  // (U+0000 NULL) is reserved for "no syllable composed".
  pub let CK_PENDING_EMPTY            : u64 = 0
  pub let CK_COMPOSED_EMPTY           : u64 = 0

  // ==========================================================================
  // SECTION 1.4 -- UNICODE HANGUL RANGES (per Unicode Standard, ch. 3)
  // ==========================================================================
  //
  // Named as u64 constants so the on_key body can gate jamo
  // classification with encoder-conservative small-immediate cmp
  // instructions rather than embedding hex literals inline.  Any
  // future revision of the Standard's ranges is a single-point
  // change here.

  pub let HANGUL_L_BASE            : u64 = 0x1100   // choseong start
  pub let HANGUL_L_LAST            : u64 = 0x1112   // choseong end (18 total)
  pub let HANGUL_V_BASE            : u64 = 0x1161   // jungseong start
  pub let HANGUL_V_LAST            : u64 = 0x1175   // jungseong end (21 total)
  pub let HANGUL_T_BASE            : u64 = 0x11A8   // jongseong start (T_idx=1)
  pub let HANGUL_T_LAST            : u64 = 0x11C2   // jongseong end (27 total)
  pub let HANGUL_SYLLABLE_BASE     : u64 = 0xAC00   // precomposed base

  // Kana ranges (informational; the schema does not gate on these
  // today because the caller's keymap already narrows to the
  // relevant range before dispatching to this engine).
  pub let HIRAGANA_BASE            : u64 = 0x3040
  pub let KATAKANA_BASE            : u64 = 0x30A0

  // ==========================================================================
  // SECTION 1.5 -- FAILURE TAXONOMY (0xFFFFE7D0..0xFFFFE7DF)
  // ==========================================================================
  //
  // Fresh 16-wide band per the row prompt.  Grep-verified free
  // across src/ + tests/ + design/ at landing time (zero
  // occurrences of any 0xFFFFE7D* sentinel in the whole tree).

  pub let CK_OK                    : u64 = 0
  pub let CK_ENGINE_NULL           : u64 = 0xFFFFE7DF  // engine_ptr == 0
  pub let CK_PROCESS_NULL          : u64 = 0xFFFFE7DE  // process_kind_id == 0
  pub let CK_BAD_VARIANT           : u64 = 0xFFFFE7DD  // variant > SYLL_MAX
  pub let CK_TABLE_NULL_KANJI      : u64 = 0xFFFFE7DC  // KANJI variant with
                                                        // null candidate_table_ptr
                                                        // (KANJI is the only
                                                        // variant that REQUIRES
                                                        // the table pointer;
                                                        // the other variants
                                                        // accept 0 and treat
                                                        // it as unused)
  pub let CK_ALREADY_INIT          : u64 = 0xFFFFE7DB  // engine already
                                                        // initialized
  pub let CK_NOT_INIT              : u64 = 0xFFFFE7DA  // op before init succeeded
  pub let CK_REGISTER_REFUSED      : u64 = 0xFFFFE7D9  // ime_provider_register
                                                        // returned refusal
                                                        // sentinel (upper 32
                                                        // bits non-zero)
  pub let CK_BAD_KEYCODE           : u64 = 0xFFFFE7D8  // keycode outside
                                                        // u32 range
  pub let CK_NO_SESSION            : u64 = 0xFFFFE7D7  // commit with
                                                        // session_kind_id == 0
                                                        // (no session bound;
                                                        // the router has not
                                                        // wired this engine
                                                        // to a text field
                                                        // yet)
  pub let CK_NO_PENDING            : u64 = 0xFFFFE7D6  // commit with neither
                                                        // pending_jamo nor
                                                        // composed_syllable
                                                        // populated (nothing
                                                        // to commit)
  // Slots 0xFFFFE7D5..0xFFFFE7D0 are RESERVED within this file's
  // band for future extension (per-variant validators, jamo-
  // classification failures once the substrate lands, KANJI
  // conversion-table checksum failures, etc.).

  // ==========================================================================
  // SECTION 1.6 -- STATS COUNTER SLOTS
  // ==========================================================================
  //
  // Eight named slots in the _cjk_kana_stats [u64; 8] cell.  A
  // boot-log observer can verify KEY_EVENTS >= COMMITS + CANCELS
  // (each commit and each cancel consumes at least one prior key
  // event, so this deficit is always non-negative in a healthy
  // run).

  pub let CK_ST_KEY_EVENTS         : u64 = 0
  pub let CK_ST_COMMITS            : u64 = 1
  pub let CK_ST_CANCELS            : u64 = 2
  pub let CK_ST_JAMO_COMBINES      : u64 = 3  // Hangul jamo composition
                                              // (each L+V+T triple counted
                                              // once at completion)
  pub let CK_ST_KANJI_LOOKUPS      : u64 = 4  // hiragana->kanji conversion
                                              // probes (stub returns 0 today;
                                              // counter tracks attempts so
                                              // stats visibility is intact
                                              // before the real table lands)
  pub let CK_ST_INITS              : u64 = 5
  pub let CK_ST_REFUSED            : u64 = 6
  pub let CK_ST_MAX                : u64 = 7

  // ==========================================================================
  // SECTION 1.7 -- FINGERPRINT (one line, legacy-suffixed)
  // ==========================================================================
  //
  // pdx_kind_cjk_kana_meta: emitted once on successful engine init
  // by the future satellite-side substrate.  Data-only at this
  // landing per the sibling B8 / B10 / B11 / B12 pattern
  // (allowlisted in tools/verify-fingerprint-coverage.sh as "cjk
  // kana init ok [legacy: CJK KANA INIT OK]").
  //
  // Byte count: 43 content chars + 1 NUL = 44.
  pub let pdx_kind_cjk_kana_meta : [u8; 44] = "cjk kana init ok [legacy: CJK KANA INIT OK]\0"

  // Short field-name string constants for future debug-print use
  // (mirror ime_provider_k_row_id / ime_session_k_commit_seq /
  // latin_autocomplete_k_provider_id / latin_deadkey_k_provider_id
  // precedent).
  pub let cjk_kana_k_provider_id : [u8; 12] = "provider_id\0"
  pub let cjk_kana_k_variant     : [u8; 8]  = "variant\0"

  // ==========================================================================
  // SECTION 2 -- STATS CELL
  // ==========================================================================
  //
  // Module-level counters shared across every engine instance in
  // this process (typically 1..4 -- one per variant a session
  // uses).  Mirrors _latin_autocomplete_stats / _latin_deadkey_
  // stats layout.

  pub let mut _cjk_kana_stats : [u64; 8] = uninit @align(64)

  // ==========================================================================
  // SECTION 3 -- COUNTER PRIMITIVES
  // ==========================================================================

  // cjk_kana_stats_reset() -> (): zero counters at boot.
  pub let cjk_kana_stats_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-004 (paideia-os #2320): clear per-module counters at boot. Mirrors latin_deadkey_stats_reset / latin_autocomplete_stats_reset. Single low-first index scan over 8 u64 slots via load-inc-store; no callee-save pushes (leaf; only r10/rcx/rax touched beyond SysV in/out). Labels prefixed cjk_kana_srs_.",
      block: {
        lea r10, [rip + _cjk_kana_stats];
        xor rax, rax;
        xor rcx, rcx;
      cjk_kana_srs_loop:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  cjk_kana_srs_loop;
        ret
      }
    }

  // cjk_kana_note(which) -> (): bump one stats counter.
  // Encoder-conservative load-inc-store; OOB is a silent no-op.
  pub let cjk_kana_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-004 (paideia-os #2320): counter bump. Encoder-conservative load-inc-store; no add reg,[mem]. OOB is a silent no-op. Mirrors latin_deadkey_note. Labels prefixed cjk_kana_nt_.",
      block: {
        cmp rdi, 8;
        jae cjk_kana_nt_out;
        lea r10, [rip + _cjk_kana_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      cjk_kana_nt_out:
        ret
      }
    }

  // cjk_kana_stat(which) -> u64: read one stats counter.
  pub let cjk_kana_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-004 (paideia-os #2320): counter read; OOB -> 0. Labels prefixed cjk_kana_st_.",
      block: {
        cmp rdi, 8;
        jae cjk_kana_st_zero;
        lea r10, [rip + _cjk_kana_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      cjk_kana_st_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // SECTION 4 -- VALIDATORS (pure leaves)
  // ==========================================================================

  // cjk_kana_variant_valid(variant) -> 1 iff variant <= SYLL_MAX (3).
  pub let cjk_kana_variant_valid : (u64) -> u64 !{} @{} =
    fn (variant: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G11-M4-004 (paideia-os #2320): 1 iff variant in {0,1,2,3}. Small-immediate cmp; encoder-conservative. Labels prefixed cjk_kana_vv_.",
      block: {
        cmp rdi, 3;
        ja  cjk_kana_vv_no;
        mov rax, 1;
        ret;
      cjk_kana_vv_no:
        xor rax, rax;
        ret
      }
    }

  // cjk_kana_keycode_valid(keycode) -> 1 iff keycode < 2^32.
  // Keycodes are u32 on the wire.  Mirrors latin_autocomplete's
  // keycode_valid (also u32-scoped); a future HID-keymap
  // validator may narrow the domain further.
  pub let cjk_kana_keycode_valid : (u64) -> u64 !{} @{} =
    fn (keycode: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G11-M4-004 (paideia-os #2320): 1 iff keycode < 2^32. Encoder-conservative 32-bit range test via shr 32 / cmp 0. Mirrors latin_autocomplete_keycode_valid. Labels prefixed cjk_kana_kv_.",
      block: {
        mov rax, rdi;
        shr rax, 32;
        cmp rax, 0;
        jne cjk_kana_kv_no;
        mov rax, 1;
        ret;
      cjk_kana_kv_no:
        xor rax, rax;
        ret
      }
    }

  // cjk_kana_lang_for_variant(variant) -> LANG_CJK_JA | LANG_CJK_KO.
  // variant 0/1/2 -> LANG_CJK_JA (2); variant 3 -> LANG_CJK_KO (3).
  // Undefined behavior for variant > SYLL_MAX; the caller is
  // expected to have validated via cjk_kana_variant_valid first.
  pub let cjk_kana_lang_for_variant : (u64) -> u64 !{} @{} =
    fn (variant: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G11-M4-004 (paideia-os #2320): map syllabic variant to ProviderKind LANG enum slot. Small-immediate cmp; encoder-conservative. variant==3 -> 3 (CJK_KO); else -> 2 (CJK_JA). Labels prefixed cjk_kana_lfv_.",
      block: {
        cmp rdi, 3;
        je  cjk_kana_lfv_ko;
        mov rax, 2;                         // CK_LANG_CJK_JA
        ret;
      cjk_kana_lfv_ko:
        mov rax, 3;                         // CK_LANG_CJK_KO
        ret
      }
    }

  // ==========================================================================
  // SECTION 5 -- CELL-FIELD GETTERS
  // ==========================================================================
  //
  // Every getter takes the engine_ptr in rdi and returns the
  // requested field in rax.  A null engine_ptr is undefined
  // behavior at the getter level (mirrors focus_router_get_* /
  // latin_autocomplete_get_* / latin_deadkey_get_* precedent).

  pub let cjk_kana_get_provider_id : (u64) -> u64 !{mem} @{} =
    fn (engine_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-004 (paideia-os #2320): read provider_kind_id from cell[+0][31:0]. Zero-extension via shl+shr. Labels prefixed cjk_kana_gpi_.",
      block: {
        mov rax, [rdi + 0];
        shl rax, 32;
        shr rax, 32;
        ret
      }
    }

  pub let cjk_kana_get_session_id : (u64) -> u64 !{mem} @{} =
    fn (engine_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-004 (paideia-os #2320): read session_kind_id from cell[+0][63:32]. Labels prefixed cjk_kana_gsi_.",
      block: {
        mov rax, [rdi + 0];
        shr rax, 32;
        ret
      }
    }

  pub let cjk_kana_get_candidates_ptr : (u64) -> u64 !{mem} @{} =
    fn (engine_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-004 (paideia-os #2320): read hanja_kanji_candidates_ptr from cell[+8] (full u64). Labels prefixed cjk_kana_gcp_.",
      block: {
        mov rax, [rdi + 8];
        ret
      }
    }

  pub let cjk_kana_get_pending : (u64) -> u64 !{mem} @{} =
    fn (engine_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-004 (paideia-os #2320): read pending_jamo_offset from cell[+16][31:0]. Zero-extension via shl+shr. Labels prefixed cjk_kana_gp_.",
      block: {
        mov rax, [rdi + 16];
        shl rax, 32;
        shr rax, 32;
        ret
      }
    }

  pub let cjk_kana_get_composed : (u64) -> u64 !{mem} @{} =
    fn (engine_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-004 (paideia-os #2320): read composed_syllable_offset from cell[+16][63:32]. Labels prefixed cjk_kana_gcs_.",
      block: {
        mov rax, [rdi + 16];
        shr rax, 32;
        ret
      }
    }

  pub let cjk_kana_get_variant : (u64) -> u64 !{mem} @{} =
    fn (engine_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-004 (paideia-os #2320): read variant from cell[+24][7:0]. u8 extraction via shl 56 / shr 56. Labels prefixed cjk_kana_gv_.",
      block: {
        mov rax, [rdi + 24];
        shl rax, 56;
        shr rax, 56;
        ret
      }
    }

  pub let cjk_kana_get_candidate_count : (u64) -> u64 !{mem} @{} =
    fn (engine_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-004 (paideia-os #2320): read candidate_count from cell[+24][15:8]. u8 extraction via shr 8 / shl 56 / shr 56. Labels prefixed cjk_kana_gcc_.",
      block: {
        mov rax, [rdi + 24];
        shr rax, 8;
        shl rax, 56;
        shr rax, 56;
        ret
      }
    }

  pub let cjk_kana_get_hangul_t : (u64) -> u64 !{mem} @{} =
    fn (engine_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-004 (paideia-os #2320): read hangul_t (T jamo) from cell[+24][31:16]. u16 extraction via shr 16 / shl 48 / shr 48. Only meaningful in SYLL_HANGUL variant. Labels prefixed cjk_kana_ght_.",
      block: {
        mov rax, [rdi + 24];
        shr rax, 16;
        shl rax, 48;
        shr rax, 48;
        ret
      }
    }

  // ==========================================================================
  // SECTION 6 -- INIT FACTORY
  // ==========================================================================
  //
  // cjk_kana_init(engine_ptr, process_kind_id, variant,
  //               candidate_table_ptr) -> u64
  //
  //   Populate a caller-owned 32-byte engine cell AND register
  //   this engine with the KIND_IME_PROVIDER substrate under a
  //   variant-dependent LANG_* slot:
  //     * variant SYLL_HIRAGANA/SYLL_KATAKANA/SYLL_KANJI -> LANG_CJK_JA
  //     * variant SYLL_HANGUL                            -> LANG_CJK_KO
  //
  //   Contract:
  //     (1) engine_ptr == 0                     -> CK_ENGINE_NULL
  //     (2) process_kind_id == 0                -> CK_PROCESS_NULL
  //     (3) variant > SYLL_MAX                  -> CK_BAD_VARIANT
  //     (4) variant == SYLL_KANJI && candidate_table_ptr == 0
  //                                             -> CK_TABLE_NULL_KANJI
  //         (other variants accept a null table pointer; they do
  //          not use one)
  //     (5) engine already initialized (cell[+0][31:0] != 0)
  //                                             -> CK_ALREADY_INIT
  //     (6) call ime_provider_register(process_kind_id, LANG,
  //                                    CK_LOCALE_UNLOCALED,
  //                                    CK_CAPS_DEFAULT);
  //         on refusal sentinel (upper 32 bits non-zero, i.e. any
  //         0xFFFFE9A* IMP_* code) return       -> CK_REGISTER_REFUSED
  //     (7) success: stamp the cell:
  //           cell[+0]   = provider_kind_id[31:0] | 0 (session unbound)
  //           cell[+8]   = candidate_table_ptr (full u64; 0 for
  //                        non-KANJI variants)
  //           cell[+16]  = 0 (pending + composed both empty)
  //           cell[+24]  = variant[7:0] | 0 (count + T jamo + reserved)
  //         bump CK_ST_INITS; return CK_OK.
  //
  //   Refusal funnel bumps CK_ST_REFUSED once at cjk_kana_init_refused.
  //
  //   Register plan (six callee-save pushes = 48 bytes; entry
  //   rsp%16==8 -> after six pushes rsp%16 == (8-48) mod 16 == 8,
  //   add sub rsp,8 to reach 16-aligned rsp for nested calls
  //   (cjk_kana_variant_valid, cjk_kana_lang_for_variant,
  //   ime_provider_register, cjk_kana_note)):
  //     rbx = engine_ptr
  //     r12 = process_kind_id
  //     r13 = variant
  //     r14 = candidate_table_ptr
  //     r15 = provider_kind_id (from ime_provider_register)
  //     rbp = lang slot (from cjk_kana_lang_for_variant; snapshotted
  //           before the register call so the note call cannot
  //           smear it)
  pub let cjk_kana_init : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (engine_ptr: u64) (process_kind_id: u64) (variant: u64) (candidate_table_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-004 (paideia-os #2320): register + engine-cell init factory. Six callee-save pushes + sub rsp,8 = 56 bytes; entry rsp%16==8 -> 56+8=64 %16==0 for every nested call (cjk_kana_variant_valid + cjk_kana_lang_for_variant + ime_provider_register + cjk_kana_note). Args stashed BEFORE any nested call: rbx=engine_ptr, r12=process_kind_id, r13=variant, r14=candidate_table_ptr, r15 receives provider_kind_id, rbp receives lang slot. Refusal-sentinel detection on ime_provider_register uses shr r10,32 / cmp r10,0 (mirrors latin_autocomplete_init / latin_deadkey_init). Cell stamp writes four u64 words directly with `mov [rbx+off], rN` (encoder-conservative). No `test`, no `add reg,[mem]`, no MOVABS. Labels prefixed cjk_kana_init_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;
        sub rsp, 8;

        mov rbx, rdi;                       // engine_ptr
        mov r12, rsi;                       // process_kind_id
        mov r13, rdx;                       // variant
        mov r14, rcx;                       // candidate_table_ptr

        // (1) engine_ptr null
        cmp rbx, 0;
        je  cjk_kana_init_null_engine;

        // (2) process_kind_id null
        cmp r12, 0;
        je  cjk_kana_init_null_process;

        // (3) variant valid
        mov rdi, r13;
        call cjk_kana_variant_valid;
        cmp rax, 0;
        je  cjk_kana_init_bad_variant;

        // (4) KANJI variant requires a non-null candidate_table_ptr.
        //     Other variants accept 0 (unused).
        cmp r13, 2;                         // SYLL_KANJI
        jne cjk_kana_init_table_ok;
        cmp r14, 0;
        je  cjk_kana_init_null_table;
      cjk_kana_init_table_ok:

        // (5) already-init check: cell[+0][31:0] (provider_kind_id) != 0
        mov rax, [rbx + 0];
        shl rax, 32;
        shr rax, 32;
        cmp rax, 0;
        jne cjk_kana_init_already;

        // (6) map variant to LANG slot for register call.
        mov rdi, r13;
        call cjk_kana_lang_for_variant;
        mov rbp, rax;                       // rbp = LANG (2 or 3)

        // Register with ProviderKind substrate.
        //   ime_provider_register(process, lang, locale, caps)
        //     rdi = process_kind_id
        //     rsi = LANG (rbp)
        //     rdx = CK_LOCALE_UNLOCALED (0)
        //     rcx = CK_CAPS_DEFAULT (0x03)
        mov rdi, r12;
        mov rsi, rbp;
        xor rdx, rdx;                       // CK_LOCALE_UNLOCALED = 0
        mov rcx, 0x03;                      // CK_CAPS_DEFAULT
        call ime_provider_register;

        // Refusal detection: IMP_* sentinels are 0xFFFFE9A0..AF,
        // upper 32 bits non-zero.  A legal row_id is 0..7, upper
        // 32 bits zero.
        mov r10, rax;
        shr r10, 32;
        cmp r10, 0;
        jne cjk_kana_init_reg_refused;

        mov r15, rax;                       // r15 = provider_kind_id

        // (7) stamp the cell.

        // cell[+0]: provider_kind_id[31:0] | session_kind_id[63:32]=0
        mov rax, r15;
        shl rax, 32;
        shr rax, 32;                        // rax = provider_id & 0xFFFFFFFF
        mov [rbx + 0], rax;

        // cell[+8]: candidate_table_ptr (full u64; 0 for non-KANJI)
        mov [rbx + 8], r14;

        // cell[+16]: 0 (pending + composed both empty)
        xor rax, rax;
        mov [rbx + 16], rax;

        // cell[+24]: variant[7:0] | 0 (candidate_count=0, hangul_t=0,
        //            reserved=0)
        mov rax, r13;
        shl rax, 56;
        shr rax, 56;                        // rax = variant & 0xFF
        mov [rbx + 24], rax;

        // Bump CK_ST_INITS.
        mov rdi, 5;                         // CK_ST_INITS
        call cjk_kana_note;

        xor rax, rax;                       // CK_OK
        jmp cjk_kana_init_out;

      cjk_kana_init_null_engine:
        mov rax, 0xFFFFE7DF;                // CK_ENGINE_NULL
        jmp cjk_kana_init_refused;
      cjk_kana_init_null_process:
        mov rax, 0xFFFFE7DE;                // CK_PROCESS_NULL
        jmp cjk_kana_init_refused;
      cjk_kana_init_bad_variant:
        mov rax, 0xFFFFE7DD;                // CK_BAD_VARIANT
        jmp cjk_kana_init_refused;
      cjk_kana_init_null_table:
        mov rax, 0xFFFFE7DC;                // CK_TABLE_NULL_KANJI
        jmp cjk_kana_init_refused;
      cjk_kana_init_already:
        mov rax, 0xFFFFE7DB;                // CK_ALREADY_INIT
        jmp cjk_kana_init_refused;
      cjk_kana_init_reg_refused:
        mov rax, 0xFFFFE7D9;                // CK_REGISTER_REFUSED
        // fallthrough

      cjk_kana_init_refused:
        // Stash refusal code across the note call.
        mov r15, rax;
        mov rdi, 6;                         // CK_ST_REFUSED
        call cjk_kana_note;
        mov rax, r15;

      cjk_kana_init_out:
        add rsp, 8;
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION 7 -- STATE-MACHINE ENTRY POINT (cjk_kana_on_key)
  // ==========================================================================
  //
  // cjk_kana_on_key(engine_ptr, keycode) -> u64
  //
  //   Dispatch a single key event through the variant-specific
  //   state machine.  Returns CK_OK on success (state updated in
  //   place; caller reads new pending / composed / count via the
  //   getters); refusal sentinel on failure.
  //
  //   Variant-specific semantics:
  //
  //   SYLL_HIRAGANA / SYLL_KATAKANA (variants 0, 1):
  //     Each key completes a syllable.  The engine simply stamps
  //     the keycode into composed_syllable_offset (the caller's
  //     keymap has already narrowed the wire value to the target
  //     Kana code point).  A subsequent commit consumes the
  //     composed value and clears it.
  //
  //   SYLL_KANJI (variant 2):
  //     Accumulate keystrokes into pending_jamo_offset (used here
  //     as the interned offset of a growing hiragana preedit
  //     buffer; growth is a future substrate concern -- today the
  //     field is stamped with the LATEST keycode, which is
  //     sufficient for the state-machine skeleton to advance).
  //     On Space (keycode == 0x20), do a conversion-table lookup
  //     against pending_jamo_offset; on hit, populate
  //     composed_syllable_offset with the top candidate and
  //     candidate_count with the N-best count (both stubbed to 0
  //     until the real table lands); on miss, leave composed at 0
  //     and count at 0.  The state machine's correctness does
  //     not depend on the lookup body: the schema advances
  //     correctly today, and hits will bite once the substrate
  //     lands.
  //
  //   SYLL_HANGUL (variant 3):
  //     Classify the keycode as L jamo, V jamo, or T jamo (or
  //     none) using the Unicode ranges from §1.4.  Accumulate
  //     into the packed (L, V, T) state fields (L + V in
  //     cell[+16][15:0]/[+16][31:16], T in cell[+24][31:16]).
  //     When a jamo cannot extend the current syllable (e.g. a
  //     new L when L+V or L+V+T are already present), the
  //     current syllable is COMPOSED into composed_syllable_
  //     offset and the state resets to start a fresh syllable
  //     with the new jamo.  Unicode composition formula from §1.4
  //     header: syllable = HANGUL_SYLLABLE_BASE + (L_idx * 21 +
  //     V_idx) * 28 + T_idx where L_idx = L - HANGUL_L_BASE,
  //     V_idx = V - HANGUL_V_BASE, T_idx = T - HANGUL_T_BASE + 1
  //     (or 0 if no T).
  //
  //   At THIS landing the Hangul body implements the L/V/T
  //   classification and syllable composition arithmetic
  //   inline; non-jamo keycodes (any keycode outside the three
  //   ranges) commit the current syllable (if any) and stash
  //   the keycode into composed_syllable_offset as a
  //   passthrough character (mirrors XKB's "compose input has
  //   a non-jamo character, so flush and pass through" rule).
  //
  //   Contract (all variants):
  //     (1) engine_ptr == 0        -> CK_ENGINE_NULL
  //     (2) provider_kind_id == 0  -> CK_NOT_INIT
  //     (3) keycode > 2^32         -> CK_BAD_KEYCODE
  //     (4) variant dispatch (per §1.2 SYLL_* enum)
  //     (5) success: bump CK_ST_KEY_EVENTS; return CK_OK.
  //
  //   Register plan (three callee-save pushes = 24 bytes; entry
  //   rsp%16==8 -> after three pushes rsp%16 == (8-24) mod 16 ==
  //   0, aligned for nested calls (cjk_kana_keycode_valid +
  //   cjk_kana_note); no padding sub needed as three pushes give
  //   SysV alignment on their own):
  //     rbx = engine_ptr
  //     r12 = keycode
  //     r13 = variant (loaded once from cell[+24][7:0])
  pub let cjk_kana_on_key : (u64, u64) -> u64 !{mem} @{} =
    fn (engine_ptr: u64) (keycode: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-004 (paideia-os #2320): variant-dispatched state-machine entry point. Three callee-save pushes = 24 bytes; entry rsp%16==8 -> (8-24) mod 16 == 0, aligned for nested calls (cjk_kana_keycode_valid + cjk_kana_note). Order: (1) null gate. (2) init gate. (3) keycode range gate. (4) load variant from cell[+24][7:0]. (5) bump CK_ST_KEY_EVENTS uniformly. (6) branch on variant to the KANA / KANJI / HANGUL arm. Each arm rewrites cell[+16] and/or cell[+24] in place with encoder-conservative fixed-offset writes. r12 keeps keycode live across nested calls; r13 keeps variant. Hangul syllable composition uses only imul r,r,imm8 and small-immediate cmp / add / sub (no DIV, no MOVABS, no `and reg,imm64`). No `test`, no `add reg,[mem]`. Labels prefixed cjk_kana_ok_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;
        mov r12, rsi;

        // (1) engine_ptr null
        cmp rbx, 0;
        je  cjk_kana_ok_null_engine;

        // (2) init check
        mov rax, [rbx + 0];
        shl rax, 32;
        shr rax, 32;
        cmp rax, 0;
        je  cjk_kana_ok_not_init;

        // (3) keycode range
        mov rdi, r12;
        call cjk_kana_keycode_valid;
        cmp rax, 0;
        je  cjk_kana_ok_bad_key;

        // (4) load variant from cell[+24][7:0]
        mov rax, [rbx + 24];
        shl rax, 56;
        shr rax, 56;
        mov r13, rax;                       // r13 = variant

        // (5) bump CK_ST_KEY_EVENTS uniformly.
        mov rdi, 0;                         // CK_ST_KEY_EVENTS
        call cjk_kana_note;

        // (6) variant dispatch.
        cmp r13, 0;
        je  cjk_kana_ok_kana_arm;           // SYLL_HIRAGANA
        cmp r13, 1;
        je  cjk_kana_ok_kana_arm;           // SYLL_KATAKANA
        cmp r13, 2;
        je  cjk_kana_ok_kanji_arm;          // SYLL_KANJI
        // else: SYLL_HANGUL (variant validated at init, so this is
        //       the only remaining case)
        jmp cjk_kana_ok_hangul_arm;

        // ==============================================================
        // KANA arm: stamp keycode into composed_syllable_offset.
        // Each key completes a syllable in these two variants.
        // Preserves pending_jamo_offset (which stays 0 in pure Kana).
        // ==============================================================
      cjk_kana_ok_kana_arm:
        // Read cell[+16] to preserve pending_jamo_offset[31:0].
        mov rax, [rbx + 16];
        shl rax, 32;
        shr rax, 32;                        // rax = pending_jamo_offset

        // Pack: pending_jamo_offset[31:0] | (keycode & 0xFFFFFFFF) << 32
        mov r10, r12;
        shl r10, 32;
        shr r10, 32;                        // r10 = keycode & 0xFFFFFFFF
        shl r10, 32;                        // r10 = keycode << 32 (composed)
        or  rax, r10;
        mov [rbx + 16], rax;

        xor rax, rax;                       // CK_OK
        jmp cjk_kana_ok_out;

        // ==============================================================
        // KANJI arm: stash keycode as latest pending_jamo_offset (the
        // growing hiragana preedit); on Space (keycode == 0x20),
        // perform a candidate lookup (stubbed to no-op) and update
        // candidate_count.  A committed selection is handled by
        // cjk_kana_commit, not here.
        // ==============================================================
      cjk_kana_ok_kanji_arm:
        // Read cell[+16] and preserve composed_syllable_offset[63:32].
        mov rax, [rbx + 16];
        shr rax, 32;                        // rax = composed_syllable_offset

        // Pack: (keycode & 0xFFFFFFFF) | (composed << 32)
        shl rax, 32;                        // rax = composed << 32
        mov r10, r12;
        shl r10, 32;
        shr r10, 32;                        // r10 = keycode & 0xFFFFFFFF
        or  rax, r10;
        mov [rbx + 16], rax;

        // On Space (keycode == 0x20), do a candidate lookup.  Stub
        // returns 0 (no candidates); bump CK_ST_KANJI_LOOKUPS to
        // record the probe attempt so the stats cell shows engine
        // liveness before the real table lands.  The real lookup
        // would populate composed_syllable_offset with the top
        // candidate and candidate_count with the N-best count.
        cmp r12, 0x20;
        jne cjk_kana_ok_kanji_no_lookup;

        // Bump CK_ST_KANJI_LOOKUPS.
        mov rdi, 4;                         // CK_ST_KANJI_LOOKUPS
        call cjk_kana_note;

        // Stub lookup: leave composed_syllable_offset at 0
        // (no candidates), candidate_count at 0.  The real lookup
        // lands with the future conversion-table substrate.

      cjk_kana_ok_kanji_no_lookup:
        xor rax, rax;                       // CK_OK
        jmp cjk_kana_ok_out;

        // ==============================================================
        // HANGUL arm: classify keycode as L / V / T jamo (or none)
        // using the Unicode ranges from §1.4, then advance the packed
        // (L, V, T) state.
        //
        //   Current state layout while in HANGUL:
        //     cell[+16][15:0]    L jamo (0 = none)
        //     cell[+16][31:16]   V jamo (0 = none)
        //     cell[+16][63:32]   composed_syllable_offset (latest
        //                        composed syllable, or 0)
        //     cell[+24][15:8]    candidate_count (unused today)
        //     cell[+24][31:16]   T jamo (0 = none)
        //
        // Transition rules:
        //   * keycode in L-range:
        //       - if L already present, COMPOSE current (L, V, T) into
        //         composed_syllable_offset and reset (L, V, T) to
        //         (keycode, 0, 0).
        //       - else set L = keycode.
        //   * keycode in V-range:
        //       - if L present and V not, set V = keycode; on
        //         completion of L+V (with no T), compose and stash
        //         (L, V, 0) into composed_syllable_offset,
        //         KEEPING the packed state so a subsequent T extends
        //         the syllable (mirrors ibus-libhangul semantics).
        //       - if L not present, treat as non-jamo passthrough
        //         (rare; malformed input).
        //   * keycode in T-range:
        //       - if L+V present, set T = keycode; compose and stash.
        //       - else treat as non-jamo passthrough.
        //   * keycode outside all three ranges:
        //       - COMPOSE current (L, V, T) if any is present, then
        //         stamp keycode into composed_syllable_offset as a
        //         passthrough character.  Reset (L, V, T) to (0, 0, 0).
        //
        // Composition formula (Unicode ch. 3):
        //   L_idx = L - HANGUL_L_BASE (0..18)
        //   V_idx = V - HANGUL_V_BASE (0..20)
        //   T_idx = 0 iff T == 0, else T - HANGUL_T_BASE + 1 (1..27)
        //   syllable = HANGUL_SYLLABLE_BASE + (L_idx * 21 + V_idx) * 28 + T_idx
        //
        // Register discipline in this arm:
        //   r10 = current L (loaded from cell[+16][15:0])
        //   r11 = current V (loaded from cell[+16][31:16])
        //   rcx = current T (loaded from cell[+24][31:16])
        //   rdx = classification scratch (or composition scratch)
        //   r12 = keycode (preserved from entry)
        //   rbx = engine_ptr (preserved from entry)
        //   r13 = variant (preserved from entry; unused in this arm
        //         but reserved by the caller's dispatch)
        // ==============================================================
      cjk_kana_ok_hangul_arm:
        // Load current L/V/T from cell[+16] / cell[+24].
        mov rax, [rbx + 16];
        mov r10, rax;
        shl r10, 48;
        shr r10, 48;                        // r10 = L (u16)
        mov r11, rax;
        shr r11, 16;
        shl r11, 48;
        shr r11, 48;                        // r11 = V (u16)

        mov rax, [rbx + 24];
        mov rcx, rax;
        shr rcx, 16;
        shl rcx, 48;
        shr rcx, 48;                        // rcx = T (u16)

        // Classify keycode.
        //   L-range: [0x1100, 0x1112]
        //   V-range: [0x1161, 0x1175]
        //   T-range: [0x11A8, 0x11C2]
        cmp r12, 0x1100;
        jb  cjk_kana_ok_hangul_nonjamo;
        cmp r12, 0x1112;
        jbe cjk_kana_ok_hangul_l_key;
        cmp r12, 0x1161;
        jb  cjk_kana_ok_hangul_nonjamo;
        cmp r12, 0x1175;
        jbe cjk_kana_ok_hangul_v_key;
        cmp r12, 0x11A8;
        jb  cjk_kana_ok_hangul_nonjamo;
        cmp r12, 0x11C2;
        jbe cjk_kana_ok_hangul_t_key;
        // else: outside all three ranges -> non-jamo passthrough
        jmp cjk_kana_ok_hangul_nonjamo;

        // ------------------------------------------------------------
        // L-key: if L already present, compose current syllable then
        // start fresh with new L.  Else set L = keycode.
        // ------------------------------------------------------------
      cjk_kana_ok_hangul_l_key:
        cmp r10, 0;
        je  cjk_kana_ok_hangul_l_set;
        // L already present -> compose current (L, V, T) into
        // composed_syllable_offset, then reset state to (new L, 0, 0).
        //
        // Composition body inlined; result in rdx.
        //   L_idx = r10 - 0x1100
        //   V_idx = r11 - 0x1161  (or 0 if r11==0)
        //   T_idx = 0 if rcx==0 else rcx - 0x11A7  (0x11A7 = HANGUL_T_BASE-1
        //           because Unicode's T table starts at HANGUL_T_BASE with
        //           T_idx==1)
        //   rdx = 0xAC00 + (L_idx * 21 + V_idx) * 28 + T_idx
        mov rax, r10;
        sub rax, 0x1100;                    // rax = L_idx
        imul rax, rax, 21;                  // rax = L_idx * 21
        cmp r11, 0;
        je  cjk_kana_ok_hangul_l_key_no_v;
        mov rdx, r11;
        sub rdx, 0x1161;                    // rdx = V_idx
        add rax, rdx;                       // rax = L_idx * 21 + V_idx
      cjk_kana_ok_hangul_l_key_no_v:
        imul rax, rax, 28;                  // rax = (L_idx*21+V_idx)*28
        cmp rcx, 0;
        je  cjk_kana_ok_hangul_l_key_no_t;
        mov rdx, rcx;
        sub rdx, 0x11A7;                    // rdx = T_idx (1..27)
        add rax, rdx;                       // rax += T_idx
      cjk_kana_ok_hangul_l_key_no_t:
        add rax, 0xAC00;                    // rax = composed syllable
        mov rdx, rax;                       // rdx = composed

        // Bump CK_ST_JAMO_COMBINES to record the completion.
        mov r10, rdx;                       // stash composed across note
        mov rdi, 3;                         // CK_ST_JAMO_COMBINES
        call cjk_kana_note;
        mov rdx, r10;

        // Reset state to (new L = r12, V = 0, T = 0), stamp composed
        // into composed_syllable_offset[63:32].
        //
        // cell[+16]: L (r12 & 0xFFFF)[15:0] | V=0 | composed << 32
        mov rax, r12;
        shl rax, 48;
        shr rax, 48;                        // rax = new_L & 0xFFFF
        mov r10, rdx;
        shl r10, 32;                        // r10 = composed << 32
        or  rax, r10;
        mov [rbx + 16], rax;

        // cell[+24]: variant (preserve r13) | count=0 | T=0
        mov rax, r13;
        shl rax, 56;
        shr rax, 56;                        // rax = variant & 0xFF
        mov [rbx + 24], rax;

        xor rax, rax;                       // CK_OK
        jmp cjk_kana_ok_out;

      cjk_kana_ok_hangul_l_set:
        // L was empty.  Simply set L = keycode; preserve V, T,
        // composed as they are.  V, T are 0 here because L being 0
        // implies fresh state (the state-machine invariant: T can
        // only be set after L+V, and V can only be set after L).
        mov rax, [rbx + 16];
        shr rax, 32;                        // rax = composed_syllable_offset
        shl rax, 32;                        // rax = composed << 32
        mov r10, r12;
        shl r10, 48;
        shr r10, 48;                        // r10 = keycode & 0xFFFF
        or  rax, r10;
        mov [rbx + 16], rax;

        xor rax, rax;                       // CK_OK
        jmp cjk_kana_ok_out;

        // ------------------------------------------------------------
        // V-key: if L present and V not, set V and compose L+V into
        // composed_syllable_offset (with T=0).  Else if V already
        // present or L absent, treat as passthrough.
        // ------------------------------------------------------------
      cjk_kana_ok_hangul_v_key:
        cmp r10, 0;
        je  cjk_kana_ok_hangul_nonjamo;     // no L yet -> passthrough
        cmp r11, 0;
        jne cjk_kana_ok_hangul_nonjamo;     // V already set -> passthrough

        // Set V = keycode, T stays 0, compose (L, V, 0).
        mov r11, r12;
        shl r11, 48;
        shr r11, 48;                        // r11 = keycode & 0xFFFF (new V)

        // Compose (L=r10, V=r11, T=0) into rdx.
        mov rax, r10;
        sub rax, 0x1100;                    // rax = L_idx
        imul rax, rax, 21;
        mov rdx, r11;
        sub rdx, 0x1161;
        add rax, rdx;                       // rax = L_idx*21 + V_idx
        imul rax, rax, 28;                  // rax = (...) * 28
        // T_idx = 0 (no T)
        add rax, 0xAC00;
        mov rdx, rax;

        // Bump CK_ST_JAMO_COMBINES.  16-byte scratch preserves the
        // SysV rsp%16==0 pre-CALL invariant (a bare `push rax` before
        // the note call would leave rsp%16==8; harmless while the
        // note callee is a leaf, latent bomb once it grows a nested
        // call or SSE op).
        mov rax, rdx;                       // preserve composed
        sub rsp, 16;
        mov [rsp], rax;
        mov rdi, 3;
        call cjk_kana_note;
        mov rdx, [rsp];
        add rsp, 16;

        // Stamp back: cell[+16] = L[15:0] | V[31:16] | composed<<32
        mov rax, r10;
        shl rax, 48;
        shr rax, 48;                        // rax = L & 0xFFFF
        mov r10, r11;
        shl r10, 16;                        // r10 = V << 16
        or  rax, r10;
        mov r10, rdx;
        shl r10, 32;
        or  rax, r10;
        mov [rbx + 16], rax;

        // cell[+24] unchanged (T stays 0; variant stays in [7:0])
        xor rax, rax;                       // CK_OK
        jmp cjk_kana_ok_out;

        // ------------------------------------------------------------
        // T-key: if L+V present and T not, set T and re-compose.
        // Else treat as passthrough.
        // ------------------------------------------------------------
      cjk_kana_ok_hangul_t_key:
        cmp r10, 0;
        je  cjk_kana_ok_hangul_nonjamo;     // no L -> passthrough
        cmp r11, 0;
        je  cjk_kana_ok_hangul_nonjamo;     // no V -> passthrough
        cmp rcx, 0;
        jne cjk_kana_ok_hangul_nonjamo;     // T already set -> passthrough

        // Set T = keycode, compose (L, V, T).
        mov rcx, r12;
        shl rcx, 48;
        shr rcx, 48;                        // rcx = keycode & 0xFFFF (new T)

        // Compose (L=r10, V=r11, T=rcx) into rdx.
        mov rax, r10;
        sub rax, 0x1100;
        imul rax, rax, 21;
        mov rdx, r11;
        sub rdx, 0x1161;
        add rax, rdx;                       // rax = L_idx*21 + V_idx
        imul rax, rax, 28;                  // rax = (...) * 28
        mov rdx, rcx;
        sub rdx, 0x11A7;                    // rdx = T_idx (1..27)
        add rax, rdx;
        add rax, 0xAC00;
        mov rdx, rax;

        // Bump CK_ST_JAMO_COMBINES.  See L+V arm above for rationale.
        mov rax, rdx;
        sub rsp, 16;
        mov [rsp], rax;
        mov rdi, 3;
        call cjk_kana_note;
        mov rdx, [rsp];
        add rsp, 16;

        // Stamp back: cell[+16] = L | V<<16 | composed<<32
        mov rax, r10;
        shl rax, 48;
        shr rax, 48;
        mov r10, r11;
        shl r10, 16;
        or  rax, r10;
        mov r10, rdx;
        shl r10, 32;
        or  rax, r10;
        mov [rbx + 16], rax;

        // cell[+24]: variant | count=0 | T<<16 | reserved
        mov rax, r13;
        shl rax, 56;
        shr rax, 56;                        // rax = variant & 0xFF
        mov r10, rcx;
        shl r10, 48;
        shr r10, 32;                        // r10 = (T & 0xFFFF) << 16
        or  rax, r10;
        mov [rbx + 24], rax;

        xor rax, rax;                       // CK_OK
        jmp cjk_kana_ok_out;

        // ------------------------------------------------------------
        // Non-jamo (keycode outside all three ranges, or a jamo that
        // cannot extend the current syllable).  Stamp keycode into
        // composed_syllable_offset as a passthrough; reset (L, V, T)
        // to zero.  A previously-composed syllable is OVERWRITTEN by
        // this passthrough (the caller is expected to have committed
        // it before feeding the next keystroke).
        // ------------------------------------------------------------
      cjk_kana_ok_hangul_nonjamo:
        // cell[+16]: L=0 | V=0 | composed = keycode
        mov rax, r12;
        shl rax, 32;
        shr rax, 32;                        // rax = keycode & 0xFFFFFFFF
        shl rax, 32;                        // rax = keycode << 32
        mov [rbx + 16], rax;

        // cell[+24]: variant | count=0 | T=0
        mov rax, r13;
        shl rax, 56;
        shr rax, 56;
        mov [rbx + 24], rax;

        xor rax, rax;                       // CK_OK
        jmp cjk_kana_ok_out;

      cjk_kana_ok_null_engine:
        mov rax, 0xFFFFE7DF;                // CK_ENGINE_NULL
        jmp cjk_kana_ok_refused;
      cjk_kana_ok_not_init:
        mov rax, 0xFFFFE7DA;                // CK_NOT_INIT
        jmp cjk_kana_ok_refused;
      cjk_kana_ok_bad_key:
        mov rax, 0xFFFFE7D8;                // CK_BAD_KEYCODE
        // fallthrough

      cjk_kana_ok_refused:
        mov r13, rax;
        mov rdi, 6;                         // CK_ST_REFUSED
        call cjk_kana_note;
        mov rax, r13;

      cjk_kana_ok_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION 8 -- COMMIT
  // ==========================================================================
  //
  // cjk_kana_commit(engine_ptr) -> u64
  //
  //   Commit the current composed syllable via the bound session.
  //   Returns the committed code point on success (packed in
  //   bits [31:0] of the return; upper bits zero) or a refusal
  //   sentinel on failure.  Side effects: clear pending_jamo_
  //   offset and composed_syllable_offset; clear the Hangul
  //   (L, V, T) accumulator; the engine stays registered and the
  //   session_kind_id binding is preserved (only the composition
  //   is consumed).
  //
  //   At THIS landing the actual session-side COMMIT_TEXT dispatch
  //   is deferred to the future substrate that wires the router
  //   -> session pipe (part of #2316 KIND_IME_ROUTER's wire body).
  //   The commit body here validates the session binding is
  //   present, reads the composed code point, clears the
  //   composition state, and returns the code point; the caller
  //   (currently only a test harness) drives the actual session-
  //   side commit.  This matches the deferred-substrate posture
  //   of latin_autocomplete's commit_selected (which returns an
  //   interned-string offset the router will feed into
  //   ime_session_commit_text once the router wire body lands).
  //
  //   Contract:
  //     (1) engine_ptr == 0            -> CK_ENGINE_NULL
  //     (2) provider_kind_id == 0      -> CK_NOT_INIT
  //     (3) session_kind_id == 0       -> CK_NO_SESSION
  //     (4) composed_syllable_offset == 0 AND pending_jamo_offset == 0
  //                                    -> CK_NO_PENDING
  //     (5) success: read composed_syllable_offset; clear cell[+16]
  //         (both pending and composed); clear cell[+24][31:16]
  //         (Hangul T jamo) while preserving variant + count +
  //         reserved; bump CK_ST_COMMITS; return composed_syllable_
  //         offset.
  //
  //   Register plan (two callee-save pushes + sub rsp,8 = 24 bytes;
  //   entry rsp%16==8 -> 24+8=32 %16==0 for nested calls):
  //     rbx = engine_ptr
  //     r12 = composed (held live across the note call)
  pub let cjk_kana_commit : (u64) -> u64 !{mem} @{} =
    fn (engine_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-004 (paideia-os #2320): commit the currently-composed syllable via the bound session (deferred to the future router wire body; today returns the code point to the caller). Two callee-save pushes + sub rsp,8 = 24 bytes; entry rsp%16==8 -> 32 %16==0 for the note call. Order: null / init / session / pending gates, then read composed, clear cell[+16], clear cell[+24][31:16] preserving variant + count + reserved, bump CK_ST_COMMITS, return composed. r12 stashes composed across the note call. Labels prefixed cjk_kana_cm_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        mov rbx, rdi;

        // (1) engine_ptr null
        cmp rbx, 0;
        je  cjk_kana_cm_null_engine;

        // (2) init check: cell[+0][31:0] (provider_kind_id) != 0
        mov rax, [rbx + 0];
        shl rax, 32;
        shr rax, 32;
        cmp rax, 0;
        je  cjk_kana_cm_not_init;

        // (3) session binding check: cell[+0][63:32] (session_kind_id) != 0
        mov rax, [rbx + 0];
        shr rax, 32;
        cmp rax, 0;
        je  cjk_kana_cm_no_session;

        // (4) pending check: at least one of pending_jamo_offset or
        //     composed_syllable_offset must be non-zero.
        mov rax, [rbx + 16];
        cmp rax, 0;
        je  cjk_kana_cm_no_pending;

        // (5) success.  Read composed_syllable_offset from [+16][63:32].
        //     If composed is 0 but pending is non-zero, we still commit
        //     the pending value (the caller may want to commit an
        //     unfinished sequence as a raw preedit string; the interned
        //     offset is a legal commit target).  Preference: composed
        //     first; fall back to pending.
        mov r12, rax;
        shr r12, 32;                        // r12 = composed
        cmp r12, 0;
        jne cjk_kana_cm_have_composed;
        // composed empty; fall back to pending
        mov r12, rax;
        shl r12, 32;
        shr r12, 32;                        // r12 = pending

      cjk_kana_cm_have_composed:
        // Clear cell[+16] (both pending and composed).
        xor rax, rax;
        mov [rbx + 16], rax;

        // Clear cell[+24][31:16] (Hangul T jamo) while preserving
        // variant[7:0], candidate_count[15:8], reserved[63:32].
        mov rax, [rbx + 24];
        // Zero bits [31:16]: mask via shl 32 / shr 32 to isolate low
        // 32 bits, then OR back the high 32 bits.
        mov r10, rax;
        shr r10, 32;
        shl r10, 32;                        // r10 = high 32 bits
        mov r11, rax;
        shl r11, 48;
        shr r11, 48;                        // r11 = low 16 bits
        or  r10, r11;                       // r10 = high | low16
        mov [rbx + 24], r10;

        // Bump CK_ST_COMMITS.
        mov rdi, 1;                         // CK_ST_COMMITS
        call cjk_kana_note;

        mov rax, r12;                       // return composed / pending
        jmp cjk_kana_cm_out;

      cjk_kana_cm_null_engine:
        mov rax, 0xFFFFE7DF;                // CK_ENGINE_NULL
        jmp cjk_kana_cm_refused;
      cjk_kana_cm_not_init:
        mov rax, 0xFFFFE7DA;                // CK_NOT_INIT
        jmp cjk_kana_cm_refused;
      cjk_kana_cm_no_session:
        mov rax, 0xFFFFE7D7;                // CK_NO_SESSION
        jmp cjk_kana_cm_refused;
      cjk_kana_cm_no_pending:
        mov rax, 0xFFFFE7D6;                // CK_NO_PENDING
        // fallthrough

      cjk_kana_cm_refused:
        mov r12, rax;
        mov rdi, 6;                         // CK_ST_REFUSED
        call cjk_kana_note;
        mov rax, r12;

      cjk_kana_cm_out:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION 9 -- CANCEL
  // ==========================================================================
  //
  // cjk_kana_cancel(engine_ptr) -> u64
  //
  //   Discard the in-flight composition without committing.  Clear
  //   pending_jamo_offset, composed_syllable_offset, and (for
  //   HANGUL) the T jamo field.  The engine stays registered and
  //   the session_kind_id binding is preserved.
  //
  //   A cancel on an empty composition is still counted -- an
  //   Escape keypress with no in-flight composition is a
  //   legitimate no-op the user may issue (mirrors latin_
  //   autocomplete_cancel / latin_deadkey_reset).
  //
  //   Contract:
  //     (1) engine_ptr == 0        -> CK_ENGINE_NULL
  //     (2) provider_kind_id == 0  -> CK_NOT_INIT
  //     (3) success: cell[+16] := 0; clear cell[+24][31:16] (T
  //         jamo) while preserving variant + count + reserved;
  //         bump CK_ST_CANCELS; return CK_OK.
  //
  //   Register plan (one callee-save push = 8 bytes; entry rsp%16==8
  //   -> after push rsp%16 == 0, aligned for the note call;
  //   odd-push-count keeps SysV alignment on its own):
  //     rbx = engine_ptr
  pub let cjk_kana_cancel : (u64) -> u64 !{mem} @{} =
    fn (engine_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-004 (paideia-os #2320): clear the in-flight composition without committing. One callee-save push = 8 bytes; entry rsp%16==8 -> after push rsp%16==0, aligned for the note call. Order: null / init gates, clear cell[+16], clear cell[+24][31:16] preserving variant + count + reserved, bump CK_ST_CANCELS, return CK_OK. Mirrors latin_autocomplete_cancel / latin_deadkey_reset. Labels prefixed cjk_kana_cx_.",
      block: {
        push rbx;

        mov rbx, rdi;

        // (1) engine_ptr null
        cmp rbx, 0;
        je  cjk_kana_cx_null_engine;

        // (2) init check
        mov rax, [rbx + 0];
        shl rax, 32;
        shr rax, 32;
        cmp rax, 0;
        je  cjk_kana_cx_not_init;

        // Clear cell[+16] (pending + composed).
        xor rax, rax;
        mov [rbx + 16], rax;

        // Clear cell[+24][31:16] (Hangul T jamo) while preserving
        // variant + count + reserved.
        mov rax, [rbx + 24];
        mov r10, rax;
        shr r10, 32;
        shl r10, 32;                        // r10 = high 32 bits
        mov r11, rax;
        shl r11, 48;
        shr r11, 48;                        // r11 = low 16 bits
        or  r10, r11;
        mov [rbx + 24], r10;

        // Bump CK_ST_CANCELS.
        mov rdi, 2;                         // CK_ST_CANCELS
        call cjk_kana_note;

        xor rax, rax;                       // CK_OK
        jmp cjk_kana_cx_out;

      cjk_kana_cx_null_engine:
        mov rax, 0xFFFFE7DF;                // CK_ENGINE_NULL
        jmp cjk_kana_cx_refused;
      cjk_kana_cx_not_init:
        mov rax, 0xFFFFE7DA;                // CK_NOT_INIT
        // fallthrough

      cjk_kana_cx_refused:
        mov rdi, 6;                         // CK_ST_REFUSED
        // rax carries the refusal code; the note primitive clobbers
        // rax on the normal path (load-inc-store on the counter
        // slot), so stash via rbx (engine_ptr is no longer needed
        // past this point -- we are on the refusal exit).
        mov rbx, rax;
        call cjk_kana_note;
        mov rax, rbx;

      cjk_kana_cx_out:
        pop rbx;
        ret
      }
    }
}
