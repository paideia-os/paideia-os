// src/user/ime/bidi_uba.pdx -- G11-M4-007 (paideia-os #2323)
//
// UNICODE BIDIRECTIONAL ALGORITHM (UBA) FOR G5 SDF TEXT.
//
// Paragraph-level level-run analyzer for mixed left-to-right / right-
// to-left text (Latin + Arabic + Hebrew + European/Arabic numerals),
// producing the per-paragraph LEVEL RUNS that the G5 SDF text renderer
// (design/kernel/g5-sdf-text.md, land pending) consumes when it walks
// glyphs from logical order to visual order for rasterization. The
// algorithm follows the Unicode Consortium's UAX #9 (Unicode
// Bidirectional Algorithm, "UBA") rule cascade:
//
//   * P2/P3     -- paragraph auto-direction: scan the paragraph text
//                  in logical order for the FIRST strong character (L
//                  or R/AL); its class fixes the paragraph's base
//                  level (0 for L, 1 for R/AL). A paragraph with no
//                  strong characters (all-neutral text) defaults to
//                  base level 0 (LTR).
//
//   * W1..W7    -- weak-type resolution: European Number (EN) adjacent
//                  to an Arabic Letter (AL) becomes Arabic Number
//                  (AN); a NonSpacingMark (NSM) inherits the class of
//                  the preceding character; a European Terminator (ET)
//                  adjacent to an EN becomes EN; ...
//
//   * N1..N2    -- neutral resolution: a run of Other Neutrals (ON) /
//                  Whitespace (WS) / European Separator (ES) between
//                  two strong characters of THE SAME direction takes
//                  that direction; a run between different strong
//                  characters takes the paragraph base direction.
//
//   * I1..I2    -- implicit-level resolution: bump the level of each
//                  character based on its final class and its
//                  enclosing paragraph base level (even = LTR, odd =
//                  RTL; 0..125 per UBA's UBA_MAX_DEPTH constant).
//
//   * L1..L4    -- reordering: coalesce consecutive same-level
//                  characters into RUNS, then reverse odd-level runs
//                  for visual order (a chain of nested reversals
//                  handles nested bidi override sequences).
//
// This file establishes the SCHEMA: per-run + per-paragraph struct
// declarations, the failure taxonomy the UBA rule cascade signals
// through, the validators (class/level/direction), the packers (row
// writes), and the three top-level entry points (analyze / get_run /
// visual_reorder). The rule cascade's rich inner state (the
// intermediate character-class arrays, the resolved-class arrays, the
// bracket-pair-matching stack from UBA rule BD16) is caller-invisible
// working state that a future substrate (bidi_uba_substrate, out of
// scope for this schema-only landing) will hold; the entry points
// here return BUBA_OK and produce a baseline single-run paragraph
// (all LTR, level 0, one run spanning the entire text) until that
// substrate lands, so downstream harnesses observe a well-formed
// paragraph rather than a fabricated multi-run cascade.
//
// SCHEMA-ONLY RULE CASCADE (why a stub). Doing the full UBA rule
// cascade in encoder-conservative asm bodies would require: (a)
// walking every code point in the paragraph to look up its BidiClass
// (a table lookup against a compressed Unicode property database),
// (b) a mutable per-character resolved-class array sized to the
// paragraph length (allocated somewhere -- but the satellite-side
// scratch pool this file's future substrate will use hasn't landed
// yet), and (c) the BD16 bracket-pair stack for the paired-bracket
// resolution added in UBA rev 25. Every one of those is a substrate
// landing, not a schema-only one. The state machine's correctness at
// this layer does not depend on the cascade body: a stubbed cascade
// makes every paragraph resolve to a single LTR run, which is one
// legitimate outcome of the full cascade (all-LTR text, no RTL
// characters present) and which the get_run / visual_reorder
// downstream ops handle identically to a multi-run resolution. Once
// the real cascade lands, mixed-script paragraphs produce their true
// multi-run resolution instead. Downstream code that queries the run
// count and the run classes gets HONEST data at both landings; the
// only observable change is that mixed-script paragraphs stop
// collapsing to one run.
//
// Design authority:
//   * UAX #9 (Unicode Bidirectional Algorithm) revision 46 is the
//     canonical prior art. This file uses UAX #9's own class
//     abbreviations (L / R / AL / EN / AN / ON) as the enum labels.
//   * design/g5-sdf-text.md §BIDI (land pending) is the paideia-os-
//     side consumer contract that names paragraph-level level runs as
//     the interface the SDF renderer expects.
//   * src/user/ime/session_kind.pdx (G11-M1-001, LANDED B8) names
//     KIND_IME_SESSION as the endpoint that carries committed text
//     into text fields. This file is the render-side counterpart:
//     once text lands in a field, the field's paragraph rendering
//     runs it through bidi_uba_analyze to compute the level runs
//     the SDF glyph walker uses.
//
// SEVEN-CLASS SUBSET (why BC_MAX=10 with gap). The full UAX #9 class
// table has ~23 entries (adding LRE/RLE/PDF/LRO/RLO/PDI/LRI/RLI/FSI/
// BN/S/B/CS/ET/ES/WS/NSM/... to the six here). The task pins the six
// CANONICAL DIRECTIONAL classes plus ON (Other Neutral) as the
// SUBSET this landing implements; the 4-slot gap up to BC_MAX=10
// reserves headroom for the WS/ET/ES/NSM neutrals the full W-rules
// cascade admits (adding those four to reach the full W1..W7 rule
// set without renumbering L/R/AL/EN/AN/ON is the substrate landing's
// job). The class_valid validator admits 0..BC_MAX-1 = 0..9, so a
// future extension that adds four more classes at slots 6..9 does
// not trigger BUBA_BAD_CLASS refusals from THIS landing's schema.
//
// PARAGRAPH + RUN STRUCT LAYOUT. Two documentation-only structs (the
// paideia-as struct-field syntax admits u8 / u32 / u64 but not
// [u8; N] reserved arrays, per the LatinAutocompleteEngine /
// FocusRouterState / DeadkeyEngine precedent -- see the note above
// each struct declaration for the omitted reserved bytes).
//
//   BidiRun (16 bytes, packed into 2 u64 words):
//     [+0]  start_offset[31:0] | length[63:32]
//     [+8]  level[7:0] | direction[15:8] | reserved[63:16]
//
//   BidiParagraph (24 bytes, packed into 3 u64 words):
//     [+0]  text_offset[31:0] | text_length[63:32]
//     [+8]  base_direction[7:0] | run_count[23:8] | reserved[63:24]
//     [+16] runs_ptr (full u64, caller-allocated buffer of
//           BidiRun[run_count] cells; 0 == no runs buffer, run_count
//           will be zero after analyze)
//
// Both structs are CALLER-OWNED. Analyze writes into the caller-
// prepped paragraph cell (and, if the caller set runs_ptr, into the
// caller-prepped runs buffer); get_run reads from the runs buffer;
// visual_reorder writes a u32[run_count] permutation of run indices
// into a caller-prepped visual buffer. No allocator visible from
// this file; the satellite / renderer that drives this module holds
// the arena.
//
// LABEL PREFIX. `bidi_uba_` throughout, sidestepping paideia-as
// reserved-word collisions (see feedback_paideia_as_reserved_labels).
// Every ASM jump target is `bidi_uba_<funcname>_<tag>`.
//
// MECE SCOPE. Single file under src/user/ime/. Touches only:
//   * NEW: src/user/ime/bidi_uba.pdx (this file)
//   * EDIT: tools/verify-fingerprint-coverage.sh (add allowlist entry
//           for pdx_kind_bidi_uba_meta since the substrate-side
//           dispatcher that would emit it is a future landing)
// No other file is modified.
//
// FAILURE BAND. 0xFFFFE800..0xFFFFE80F (per row prompt). Grep-verified
// free across src/ + tests/ + design/ at landing time (nearest
// occupied neighbors: latin_deadkey.pdx 0xFFFFE7B0..0xFFFFE7BF at
// distance +0x40, workspace_session.pdx 0xFFFFE9F0..0xFFFFE9FF at
// distance +0x1F0). This landing takes the first fresh 16-slot page
// past the G11.M4 IME provider family (0xFFFFE7A0..0xFFFFE7FF).
//
// FINGERPRINT. One legacy-suffixed meta fingerprint per the standard
// klog convention (matches session_kind / provider_kind / latin_
// deadkey precedent). Emitted once by the future substrate-side
// dispatcher on successful cascade completion (i.e. when the real
// cascade lands and produces the first multi-run resolution); no
// fingerprint on the per-analyze / per-get_run / per-visual_reorder
// paths (those fire per rendered paragraph and would flood the ring,
// same rationale as tag_tty_read_ok in keys.pdx). Until the substrate
// lands, the tag is DATA-ONLY (declared here but not emitted from
// any body) -- verify-fingerprint-coverage.sh gets a matching
// allowlist entry per the B8 KIND_IME_SESSION / B10 KIND_IME_
// PROVIDER / B11 latin_autocomplete / B12 latin_deadkey pattern.
//
// Encoder-conservative pattern per session_kind / provider_kind /
// latin_autocomplete / latin_deadkey: no `and reg, imm64`, no MOVABS
// r64,imm64, no `test`, no `add reg,[mem]`, no `mov_bzx`/`mov_wzx`;
// 32-bit zero-extension via shl+shr; 16-bit via shl 48/shr 48; 8-bit
// via shl 56/shr 56. Small immediates only (every immediate in this
// file fits in imm32 sign-extended, most in imm8).
//
// =============================================================================

module BidiUba = structure {

  // ==========================================================================
  // SECTION 1.1 -- BIDI CLASS ENUM
  // ==========================================================================
  //
  // Seven canonical classes (per row prompt). Numbering matches UAX
  // #9 grouping order (strong LTR, strong RTL, strong Arabic letter,
  // then the two numeric families, then Other Neutral). The 4-slot
  // gap from 6 to BC_MAX=10 reserves headroom for the WS/ET/ES/NSM
  // neutrals the full W-rules cascade will admit in a future
  // substrate landing.

  pub let BC_L                     : u64 = 0    // Left-to-Right
                                                // (Latin / Cyrillic /
                                                // Greek / CJK / ...
                                                // any strong-LTR
                                                // script character)
  pub let BC_R                     : u64 = 1    // Right-to-Left
                                                // (Hebrew, plus a few
                                                // strong-RTL blocks;
                                                // distinct from AL
                                                // because Hebrew does
                                                // NOT trigger the W2
                                                // EN->AN reclassing
                                                // that Arabic does)
  pub let BC_AL                    : u64 = 2    // Arabic Letter
                                                // (strong RTL that
                                                // additionally
                                                // reclasses adjacent
                                                // EN as AN per W2)
  pub let BC_EN                    : u64 = 3    // European Number
                                                // (ASCII digits +
                                                // European locale
                                                // digit forms)
  pub let BC_AN                    : u64 = 4    // Arabic Number
                                                // (Arabic-Indic
                                                // digits; the W2
                                                // reclass output of
                                                // EN when adjacent
                                                // to AL)
  pub let BC_ON                    : u64 = 5    // Other Neutral
                                                // (punctuation,
                                                // symbols, anything
                                                // that takes its
                                                // direction from
                                                // enclosing context)
  pub let BC_MAX                   : u64 = 10   // Enum ceiling; slots
                                                // 6..9 reserved for
                                                // WS/ET/ES/NSM in
                                                // future substrate

  // ==========================================================================
  // SECTION 1.2 -- DIRECTION + LEVEL DOMAINS
  // ==========================================================================
  //
  // Direction is a 1-bit value (0 = LTR, 1 = RTL). Level is a UBA
  // depth in 0..125 (UBA constant UBA_MAX_DEPTH = 125, per UAX #9
  // section 3.3.2). The parity of the level determines direction:
  // even level = LTR, odd level = RTL, so the direction field of
  // BidiRun is REDUNDANT with the level field's low bit but is
  // stored explicitly so a downstream consumer (the SDF glyph
  // walker) does not have to reparse the level on every glyph.

  pub let BUBA_DIR_LTR             : u64 = 0
  pub let BUBA_DIR_RTL             : u64 = 1
  pub let BUBA_DIR_MAX             : u64 = 1
  pub let BUBA_LEVEL_MAX           : u64 = 125  // UAX #9 UBA_MAX_DEPTH

  // ==========================================================================
  // SECTION 1.3 -- BidiRun STRUCT (16 bytes)
  // ==========================================================================
  //
  // One run per contiguous span of same-level characters. The runs
  // array is a caller-allocated BidiRun[N] buffer; analyze writes
  // into it, get_run reads from it, visual_reorder computes a
  // permutation of indices into it.
  //
  // Cell layout (offsets in bytes):
  //
  //   [+0]  extent:
  //             start_offset[31:0]  index into paragraph text where
  //                                 this run begins (paragraph-relative,
  //                                 not text_offset-relative)
  //             length[63:32]       number of code units this run
  //                                 covers; sum of all runs equals
  //                                 paragraph.text_length
  //
  //   [+8]  meta:
  //             level[7:0]          UBA embedding level, 0..125;
  //                                 even = LTR, odd = RTL
  //             direction[15:8]     0 = LTR, 1 = RTL; MUST equal
  //                                 level & 1 (invariant checked by
  //                                 bidi_uba_run_pack_meta at pack
  //                                 time; a mismatch is caller error
  //                                 and is refused as BUBA_BAD_LEVEL
  //                                 to avoid silent corruption of the
  //                                 renderer's per-glyph shaping)
  //             reserved[63:16]     0 at analyze time; future
  //                                 extensions (font-shaping hint,
  //                                 script code from ISO 15924, ...)
  //                                 land here
  //
  // Cell is 16 bytes = one quarter of a 64-byte cache line. Cache-
  // line alignment is CALLER'S responsibility (the runs buffer's
  // base address matters for prefetch, not for correctness).
  //
  // Documentation-only struct declaration (mirrors LatinAutocomplete-
  // Engine / DeadkeyEngine precedent). The struct below omits the
  // six trailing reserved bytes of the meta word ([63:16] of run
  // [+8]); paideia-as struct-field syntax accepts u8/u32/u64 scalars
  // but not [u8; N] arrays. The reserved bytes are covered by the
  // cell layout comment above and by the `reserved[63:16]` sub-field
  // notation there, not by a struct member.
  struct BidiRun {
    start_offset: u32,
    length: u32,
    level: u8,
    direction: u8
  }

  pub let BUBA_RUN_BYTES              : u64 = 16
  pub let BUBA_RUN_OFF_EXTENT         : u64 = 0
  pub let BUBA_RUN_OFF_META           : u64 = 8

  // Sub-word bit positions for BUBA_RUN_OFF_META:
  //   level      bits [7:0]
  //   direction  bits [15:8]
  pub let BUBA_RUN_META_DIR_SHIFT     : u64 = 8

  // ==========================================================================
  // SECTION 1.4 -- BidiParagraph STRUCT (24 bytes)
  // ==========================================================================
  //
  // One BidiParagraph per paragraph of text (a paragraph is a run of
  // text terminated by a hard line-break or by end-of-text; a text
  // field with N paragraphs runs analyze N times, each with its own
  // paragraph cell). The paragraph cell is CALLER-OWNED; the caller
  // pre-allocates it and, if it wants the runs populated, pre-sets
  // runs_ptr to a suitably-sized BidiRun[N] buffer (worst case N ==
  // text_length, one run per character; typical N is single digits).
  //
  // Cell layout (offsets in bytes):
  //
  //   [+0]  extent:
  //             text_offset[31:0]   index of the paragraph's first
  //                                 code unit in the source text
  //                                 (interned string pool offset, or
  //                                 whatever the caller's addressing
  //                                 scheme is; opaque to this file)
  //             text_length[63:32]  number of code units in the
  //                                 paragraph. 0 = empty paragraph
  //                                 (rare but legal: two adjacent
  //                                 hard line breaks); analyze
  //                                 accepts and produces run_count=0.
  //
  //   [+8]  meta:
  //             base_direction[7:0] 0 = LTR, 1 = RTL. Auto-detected
  //                                 by analyze from the first strong
  //                                 character (P2/P3 of UBA); a
  //                                 paragraph with no strong
  //                                 characters defaults to LTR.
  //             run_count[23:8]     number of resolved level runs;
  //                                 0..text_length. 0 means either
  //                                 empty paragraph OR runs_ptr was
  //                                 0 (caller opted out of run
  //                                 population; analyze does no work
  //                                 in the runs buffer in that case).
  //             reserved[63:24]     0 at analyze time; future
  //                                 extensions (paragraph-embedding-
  //                                 level override, mirror-pair
  //                                 count, ...) land here
  //
  //   [+16] runs_ptr: u64
  //             pointer to a caller-allocated BidiRun[run_count]
  //             buffer. Full u64 (satellite processes may hold this
  //             buffer in .data, .bss, or a shared read-only mapping).
  //             MAY be 0: analyze respects it and skips run-buffer
  //             writes if so, still filling extent + meta. get_run /
  //             visual_reorder refuse with BUBA_NO_RUNS if it is 0.
  //
  // Cell is 24 bytes = 3/8 of a 64-byte cache line. Alignment is
  // CALLER'S responsibility.
  //
  // Documentation-only struct declaration (mirrors LatinAutocomplete-
  // Engine / DeadkeyEngine precedent). The struct below omits the
  // five trailing reserved bytes of the meta word ([63:24] of
  // paragraph [+8]); same rationale as BidiRun above.
  struct BidiParagraph {
    text_offset: u32,
    text_length: u32,
    base_direction: u8,
    run_count: u16,
    runs_ptr: u64
  }

  pub let BUBA_PARA_BYTES             : u64 = 24
  pub let BUBA_PARA_OFF_EXTENT        : u64 = 0
  pub let BUBA_PARA_OFF_META          : u64 = 8
  pub let BUBA_PARA_OFF_RUNS_PTR      : u64 = 16

  // Sub-word bit positions for BUBA_PARA_OFF_META:
  //   base_direction  bits [7:0]
  //   run_count       bits [23:8]
  pub let BUBA_PARA_META_COUNT_SHIFT  : u64 = 8

  // ==========================================================================
  // SECTION 1.5 -- FAILURE TAXONOMY (0xFFFFE800..0xFFFFE80F)
  // ==========================================================================
  //
  // Fresh 16-wide band per row prompt. Grep-verified free across
  // src/ + tests/ + design/ at landing time (nearest occupied
  // neighbors listed in file header). No rebase required.

  pub let BUBA_OK                     : u64 = 0
  pub let BUBA_BAD_PARAGRAPH_PTR      : u64 = 0xFFFFE80F  // out_paragraph_ptr == 0
  pub let BUBA_BAD_TEXT_OFFSET        : u64 = 0xFFFFE80E  // text_offset outside u32
  pub let BUBA_BAD_TEXT_LENGTH        : u64 = 0xFFFFE80D  // length outside u32
  pub let BUBA_BAD_RUN_INDEX          : u64 = 0xFFFFE80C  // run_index >= run_count
  pub let BUBA_BAD_RUN_PTR            : u64 = 0xFFFFE80B  // out_run_ptr == 0
                                                          // (get_run's third arg)
  pub let BUBA_BAD_LEVEL              : u64 = 0xFFFFE80A  // level > 125, or
                                                          // level.parity !=
                                                          // direction (packer
                                                          // consistency check)
  pub let BUBA_BAD_CLASS              : u64 = 0xFFFFE809  // class >= BC_MAX
  pub let BUBA_BAD_DIRECTION          : u64 = 0xFFFFE808  // direction > 1
  pub let BUBA_BAD_VISUAL_PTR         : u64 = 0xFFFFE807  // out_visual_ptr == 0
                                                          // (visual_reorder's
                                                          // second arg)
  pub let BUBA_NO_RUNS                : u64 = 0xFFFFE806  // runs_ptr == 0 in
                                                          // paragraph (get_run
                                                          // / visual_reorder
                                                          // require it)
  pub let BUBA_STALE                  : u64 = 0xFFFFE805  // op before analyze
                                                          // (paragraph run_count
                                                          // 0 AND extent 0)
  pub let BUBA_EMPTY                  : u64 = 0xFFFFE804  // reserved: analyze on
                                                          // 0-length paragraph
                                                          // returns OK with
                                                          // run_count 0 rather
                                                          // than this sentinel;
                                                          // reserved for a
                                                          // future strict-mode
                                                          // caller
  // Slots 0xFFFFE803..0xFFFFE800 are RESERVED within this file's band
  // for future extension (bracket-pair stack overflow at BD16, LRE/
  // RLE override-depth overflow, ...).

  // ==========================================================================
  // SECTION 1.6 -- STATS COUNTER SLOTS
  // ==========================================================================
  //
  // Six named slots in the _bidi_uba_stats [u64; 8] cell. A boot-log
  // observer can verify ANALYZES >= (GETS + REORDERS) / (avg-ops-per-
  // paragraph) roughly (each get_run and visual_reorder needs a prior
  // analyze; the ratio is workload-dependent).

  pub let BUBA_ST_ANALYZES            : u64 = 0
  pub let BUBA_ST_GETS                : u64 = 1
  pub let BUBA_ST_REORDERS            : u64 = 2
  pub let BUBA_ST_RUNS_EMITTED        : u64 = 3  // total runs written across
                                                 // all analyze calls; a
                                                 // multi-run resolution bumps
                                                 // this by run_count
  pub let BUBA_ST_REFUSED             : u64 = 4
  pub let BUBA_ST_MAX                 : u64 = 5

  // ==========================================================================
  // SECTION 1.7 -- FINGERPRINT (one line, legacy-suffixed)
  // ==========================================================================
  //
  // pdx_kind_bidi_uba_meta: emitted once by the future substrate-side
  // dispatcher on successful multi-run cascade completion. Data-only
  // at this landing per the sibling B8 / B10 / B11 / B12 pattern
  // (allowlisted in tools/verify-fingerprint-coverage.sh as
  // "pdx kind bidi uba meta [legacy: BIDI UBA META OK]").
  //
  // Byte count: 49 content chars + 1 NUL = 50.
  pub let pdx_kind_bidi_uba_meta : [u8; 50] = "pdx kind bidi uba meta [legacy: BIDI UBA META OK]\0"

  // Short field-name string constants for future debug-print use
  // (mirror ime_session_k_commit_seq / latin_deadkey_k_state precedent).
  pub let bidi_uba_k_base_dir    : [u8; 15] = "base_direction\0"
  pub let bidi_uba_k_run_count   : [u8; 10] = "run_count\0"

  // ==========================================================================
  // SECTION 2 -- STATS CELL
  // ==========================================================================
  //
  // Module-level counters shared across every paragraph analyzed in
  // this process. Mirrors _latin_deadkey_stats / _latin_autocomplete_
  // stats layout.

  pub let mut _bidi_uba_stats : [u64; 8] = uninit @align(64)

  // ==========================================================================
  // SECTION 3 -- COUNTER PRIMITIVES
  // ==========================================================================

  // bidi_uba_stats_reset() -> (): zero counters at boot.
  pub let bidi_uba_stats_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-007 (paideia-os #2323): clear per-module counters at boot. Mirrors latin_deadkey_stats_reset. Single low-first index scan over 8 u64 slots via load-inc-store; no callee-save pushes (leaf; only r10/rcx/rax touched beyond SysV in/out). Labels prefixed bidi_uba_srs_.",
      block: {
        lea r10, [rip + _bidi_uba_stats];
        xor rax, rax;
        xor rcx, rcx;
      bidi_uba_srs_loop:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  bidi_uba_srs_loop;
        ret
      }
    }

  // bidi_uba_note(which) -> (): bump one stats counter.
  // Encoder-conservative load-inc-store; OOB is a silent no-op.
  pub let bidi_uba_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-007 (paideia-os #2323): counter bump. Encoder-conservative load-inc-store; no add reg,[mem]. OOB is a silent no-op. Mirrors latin_deadkey_note. Labels prefixed bidi_uba_nt_.",
      block: {
        cmp rdi, 8;
        jae bidi_uba_nt_out;
        lea r10, [rip + _bidi_uba_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      bidi_uba_nt_out:
        ret
      }
    }

  // bidi_uba_stat(which) -> u64: read one stats counter.
  pub let bidi_uba_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-007 (paideia-os #2323): counter read; OOB -> 0. Labels prefixed bidi_uba_st_.",
      block: {
        cmp rdi, 8;
        jae bidi_uba_st_zero;
        lea r10, [rip + _bidi_uba_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      bidi_uba_st_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // SECTION 4 -- VALIDATORS (pure leaves)
  // ==========================================================================

  // bidi_uba_class_valid(class) -> 1 iff class < BC_MAX (10).
  // Admits 0..9; the current schema uses only 0..5 but slots 6..9 are
  // reserved for the WS/ET/ES/NSM neutrals a future substrate lands.
  pub let bidi_uba_class_valid : (u64) -> u64 !{} @{} =
    fn (class: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G11-M4-007 (paideia-os #2323): 1 iff class < BC_MAX=10. Small-immediate cmp. Labels prefixed bidi_uba_cv_.",
      block: {
        cmp rdi, 9;
        ja  bidi_uba_cv_no;
        mov rax, 1;
        ret;
      bidi_uba_cv_no:
        xor rax, rax;
        ret
      }
    }

  // bidi_uba_direction_valid(dir) -> 1 iff dir <= BUBA_DIR_MAX (1).
  pub let bidi_uba_direction_valid : (u64) -> u64 !{} @{} =
    fn (dir: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G11-M4-007 (paideia-os #2323): 1 iff dir in {0,1}. Small-immediate cmp. Labels prefixed bidi_uba_dv_.",
      block: {
        cmp rdi, 1;
        ja  bidi_uba_dv_no;
        mov rax, 1;
        ret;
      bidi_uba_dv_no:
        xor rax, rax;
        ret
      }
    }

  // bidi_uba_level_valid(level) -> 1 iff level <= BUBA_LEVEL_MAX (125).
  // The UBA_MAX_DEPTH ceiling per UAX #9 section 3.3.2.
  pub let bidi_uba_level_valid : (u64) -> u64 !{} @{} =
    fn (level: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G11-M4-007 (paideia-os #2323): 1 iff level <= BUBA_LEVEL_MAX=125. Small-immediate cmp (imm8 sign-extends). Labels prefixed bidi_uba_lv_.",
      block: {
        cmp rdi, 125;
        ja  bidi_uba_lv_no;
        mov rax, 1;
        ret;
      bidi_uba_lv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // SECTION 5 -- PACKERS (pure leaves)
  // ==========================================================================
  //
  // Row-write helpers. Each packer masks its inputs to the field's
  // wire width so an out-of-range argument cannot smear into a
  // neighbor field.

  // bidi_uba_paragraph_pack_extent(text_offset, text_length)
  //   -> text_offset[31:0] | text_length[63:32].
  // Both halves masked to 32 bits via shl 32 / shr 32. Row-write
  // helper for paragraph [+0].
  pub let bidi_uba_paragraph_pack_extent : (u64, u64) -> u64 !{} @{} =
    fn (text_offset: u64) (text_length: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G11-M4-007 (paideia-os #2323): pack text_offset[31:0] | text_length[63:32] per paragraph layout at [+0]. Encoder-conservative 32-bit mask via shl+shr to avoid MOVABS r64, 0xFFFFFFFF. Straight-line, no labels needed.",
      block: {
        mov rax, rdi;
        shl rax, 32;
        shr rax, 32;                        // rax = text_offset & 0xFFFFFFFF
        mov r10, rsi;
        shl r10, 32;                        // r10 = text_length << 32
        or  rax, r10;
        ret
      }
    }

  // bidi_uba_paragraph_pack_meta(base_direction, run_count)
  //   -> base_direction[7:0] | run_count[23:8] | reserved[63:24].
  // Row-write helper for paragraph [+8].
  pub let bidi_uba_paragraph_pack_meta : (u64, u64) -> u64 !{} @{} =
    fn (base_direction: u64) (run_count: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G11-M4-007 (paideia-os #2323): pack base_direction[7:0] | run_count[23:8] per paragraph layout at [+8]. u8 mask via shl 56/shr 56; u16 mask via shl 48/shr 48 then shl 8. Straight-line.",
      block: {
        mov rax, rdi;
        shl rax, 56;
        shr rax, 56;                        // rax = base_direction & 0xFF
        mov r10, rsi;
        shl r10, 48;
        shr r10, 48;                        // r10 = run_count & 0xFFFF
        shl r10, 8;                         // r10 = run_count << 8
        or  rax, r10;
        ret
      }
    }

  // bidi_uba_run_pack_extent(start_offset, length)
  //   -> start_offset[31:0] | length[63:32].
  // Mirror of paragraph_pack_extent. Row-write helper for run [+0].
  pub let bidi_uba_run_pack_extent : (u64, u64) -> u64 !{} @{} =
    fn (start_offset: u64) (length: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G11-M4-007 (paideia-os #2323): pack start_offset[31:0] | length[63:32] per run layout at [+0]. Mirror of paragraph_pack_extent. Straight-line.",
      block: {
        mov rax, rdi;
        shl rax, 32;
        shr rax, 32;
        mov r10, rsi;
        shl r10, 32;
        or  rax, r10;
        ret
      }
    }

  // bidi_uba_run_pack_meta(level, direction)
  //   -> level[7:0] | direction[15:8] | reserved[63:16].
  // Row-write helper for run [+8]. Consistency check: direction MUST
  // equal level & 1 (UBA invariant); mismatch is caller error and is
  // refused as BUBA_BAD_LEVEL to prevent silent corruption of the
  // renderer's per-glyph shaping.
  pub let bidi_uba_run_pack_meta : (u64, u64) -> u64 !{} @{} =
    fn (level: u64) (direction: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G11-M4-007 (paideia-os #2323): pack level[7:0] | direction[15:8] per run layout at [+8]. Enforces UBA invariant direction == level.parity; mismatch returns BUBA_BAD_LEVEL. Level bounds check via cmp 125. Direction bounds check via cmp 1. Parity check via mov+shl 63+shr 63 (extracts level's low bit as a 0/1 value; cmp against direction). Labels prefixed bidi_uba_rpm_.",
      block: {
        // (1) level bounds
        cmp rdi, 125;
        ja  bidi_uba_rpm_bad_level;

        // (2) direction bounds
        cmp rsi, 1;
        ja  bidi_uba_rpm_bad_level;

        // (3) parity invariant: direction must equal level & 1.
        // Extract level's low bit into r10 (r10 = level << 63 >> 63,
        // yields the sign bit which for a value with only the LSB
        // possibly set means 0 or 1 -- but shl 63 on any u64 leaves
        // only the low bit at position 63; shr 63 unsigned brings
        // it back to position 0 as 0 or 1).
        mov r10, rdi;
        shl r10, 63;
        shr r10, 63;                        // r10 = level & 1
        cmp r10, rsi;
        jne bidi_uba_rpm_bad_level;

        // (4) pack: rax = level & 0xFF; r10 = (direction & 0xFF) << 8; or
        mov rax, rdi;
        shl rax, 56;
        shr rax, 56;                        // rax = level & 0xFF
        mov r10, rsi;
        shl r10, 56;
        shr r10, 56;                        // r10 = direction & 0xFF
        shl r10, 8;                         // r10 = direction << 8
        or  rax, r10;
        ret;

      bidi_uba_rpm_bad_level:
        mov rax, 0xFFFFE80A;                // BUBA_BAD_LEVEL
        ret
      }
    }

  // ==========================================================================
  // SECTION 6 -- PARAGRAPH-FIELD GETTERS
  // ==========================================================================
  //
  // Every getter takes the paragraph_ptr in rdi and returns the
  // requested field in rax. A null paragraph_ptr is undefined behavior
  // at the getter level (mirrors latin_deadkey_get_* / latin_
  // autocomplete_get_* precedent).

  pub let bidi_uba_get_text_offset : (u64) -> u64 !{mem} @{} =
    fn (paragraph_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-007 (paideia-os #2323): read text_offset from para[+0][31:0]. Zero-extension via shl+shr. Labels prefixed bidi_uba_gto_.",
      block: {
        mov rax, [rdi + 0];
        shl rax, 32;
        shr rax, 32;
        ret
      }
    }

  pub let bidi_uba_get_text_length : (u64) -> u64 !{mem} @{} =
    fn (paragraph_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-007 (paideia-os #2323): read text_length from para[+0][63:32]. Labels prefixed bidi_uba_gtl_.",
      block: {
        mov rax, [rdi + 0];
        shr rax, 32;
        ret
      }
    }

  pub let bidi_uba_get_base_direction : (u64) -> u64 !{mem} @{} =
    fn (paragraph_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-007 (paideia-os #2323): read base_direction from para[+8][7:0]. u8 extraction via shl 56/shr 56. Labels prefixed bidi_uba_gbd_.",
      block: {
        mov rax, [rdi + 8];
        shl rax, 56;
        shr rax, 56;
        ret
      }
    }

  pub let bidi_uba_get_run_count : (u64) -> u64 !{mem} @{} =
    fn (paragraph_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-007 (paideia-os #2323): read run_count from para[+8][23:8]. u16 extraction via shr 8/shl 48/shr 48. Labels prefixed bidi_uba_grc_.",
      block: {
        mov rax, [rdi + 8];
        shr rax, 8;
        shl rax, 48;
        shr rax, 48;
        ret
      }
    }

  pub let bidi_uba_get_runs_ptr : (u64) -> u64 !{mem} @{} =
    fn (paragraph_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-007 (paideia-os #2323): read runs_ptr from para[+16] (full u64). Labels prefixed bidi_uba_grp_.",
      block: {
        mov rax, [rdi + 16];
        ret
      }
    }

  // ==========================================================================
  // SECTION 7 -- RUN-FIELD GETTERS (from a BidiRun by pointer)
  // ==========================================================================

  pub let bidi_uba_run_get_start_offset : (u64) -> u64 !{mem} @{} =
    fn (run_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-007 (paideia-os #2323): read start_offset from run[+0][31:0]. Labels prefixed bidi_uba_rgso_.",
      block: {
        mov rax, [rdi + 0];
        shl rax, 32;
        shr rax, 32;
        ret
      }
    }

  pub let bidi_uba_run_get_length : (u64) -> u64 !{mem} @{} =
    fn (run_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-007 (paideia-os #2323): read length from run[+0][63:32]. Labels prefixed bidi_uba_rgl_.",
      block: {
        mov rax, [rdi + 0];
        shr rax, 32;
        ret
      }
    }

  pub let bidi_uba_run_get_level : (u64) -> u64 !{mem} @{} =
    fn (run_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-007 (paideia-os #2323): read level from run[+8][7:0]. u8 extraction via shl 56/shr 56. Labels prefixed bidi_uba_rglv_.",
      block: {
        mov rax, [rdi + 8];
        shl rax, 56;
        shr rax, 56;
        ret
      }
    }

  pub let bidi_uba_run_get_direction : (u64) -> u64 !{mem} @{} =
    fn (run_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-007 (paideia-os #2323): read direction from run[+8][15:8]. u8 extraction via shr 8/shl 56/shr 56. Labels prefixed bidi_uba_rgd_.",
      block: {
        mov rax, [rdi + 8];
        shr rax, 8;
        shl rax, 56;
        shr rax, 56;
        ret
      }
    }

  // ==========================================================================
  // SECTION 8 -- TOP-LEVEL: ANALYZE
  // ==========================================================================
  //
  // bidi_uba_analyze(text_offset, length, out_paragraph_ptr) -> u64
  //
  //   Run the full UBA rule cascade (P2/P3 auto-direction; W1-W7
  //   weak types; N1-N2 neutrals; I1-I2 implicit levels) over the
  //   text at [text_offset, text_offset+length) and populate the
  //   caller-prepped BidiParagraph cell at out_paragraph_ptr.
  //
  //   Contract:
  //     (1) out_paragraph_ptr == 0                 -> BUBA_BAD_PARAGRAPH_PTR
  //     (2) text_offset outside u32                -> BUBA_BAD_TEXT_OFFSET
  //     (3) length outside u32                     -> BUBA_BAD_TEXT_LENGTH
  //     (4) success:
  //           para[+0]  = pack_extent(text_offset, length)
  //           para[+8]  = pack_meta(base_direction, run_count)
  //           (para[+16] runs_ptr LEFT UNTOUCHED -- caller-owned)
  //           if para.runs_ptr != 0, write run_count BidiRun cells
  //           into that buffer.
  //         Return BUBA_OK.
  //
  //   The caller MUST pre-set para[+16] runs_ptr to a suitable buffer
  //   (BidiRun[N] where N >= worst-case run count) BEFORE calling; a
  //   null runs_ptr is legal (analyze produces run_count=0 in that
  //   case and downstream get_run / visual_reorder refuse with
  //   BUBA_NO_RUNS).
  //
  //   SCHEMA-ONLY CASCADE BODY. The body currently:
  //     * validates inputs
  //     * loads runs_ptr from para[+16]
  //     * writes para[+0] via pack_extent
  //     * if length > 0 and runs_ptr != 0:
  //         writes a single BidiRun at runs[0] (start=0, length=length,
  //         level=0, direction=0)
  //         sets run_count=1
  //       else:
  //         sets run_count=0
  //     * writes para[+8] via pack_meta (base_direction always 0=LTR
  //       until the P2/P3 text-scanner substrate lands)
  //     * bumps BUBA_ST_ANALYZES + (run_count) BUBA_ST_RUNS_EMITTED
  //     * returns BUBA_OK
  //
  //   Once the real cascade substrate lands, mixed-script paragraphs
  //   produce their true multi-run resolution (Latin+Arabic+Hebrew
  //   with EN/AN reclassing under W2/W4, neutral resolution under
  //   N1/N2, implicit levels under I1/I2, L1/L4 coalescing). The
  //   entry-point signature, the failure taxonomy, and the paragraph
  //   struct layout are STABLE across that landing -- callers written
  //   against this schema keep working; only the run resolution's
  //   fidelity improves.
  //
  //   Register plan (three callee-save pushes = 24 bytes; entry
  //   rsp%16==8 -> after three pushes rsp%16 == (8-24) mod 16 == 0,
  //   aligned for nested calls to bidi_uba_note):
  //     rbx = out_paragraph_ptr
  //     r12 = text_offset (u32-clean after gate)
  //     r13 = length (u32-clean after gate)
  pub let bidi_uba_analyze : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (text_offset: u64) (length: u64) (out_paragraph_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-007 (paideia-os #2323): UBA cascade entry point (schema-only stub). Three callee-save pushes = 24 bytes; entry rsp%16==8 -> (8-24) mod 16 == 0, aligned for nested calls. Order: (1) null-ptr gate. (2) text_offset u32 gate via shr 32 / cmp 0. (3) length u32 gate. (4) write para[+0] via pack_extent (inlined shl+shr+or, since function calls are unaligned here). (5) load runs_ptr from para[+16]. (6) if length > 0 AND runs_ptr != 0, write BidiRun at runs[0] with start=0, length=length, level=0, direction=0; set run_count=1. Else run_count=0. (7) write para[+8] via inlined pack_meta (base_direction=0). (8) bump ANALYZES + RUNS_EMITTED, return BUBA_OK. Refusal funnel bumps REFUSED once. No test, no add reg,[mem], no MOVABS. Labels prefixed bidi_uba_an_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdx;                       // out_paragraph_ptr
        mov r12, rdi;                       // text_offset
        mov r13, rsi;                       // length

        // (1) null-ptr gate
        cmp rbx, 0;
        je  bidi_uba_an_bad_para;

        // (2) text_offset must fit in u32
        mov rax, r12;
        shr rax, 32;
        cmp rax, 0;
        jne bidi_uba_an_bad_off;

        // (3) length must fit in u32
        mov rax, r13;
        shr rax, 32;
        cmp rax, 0;
        jne bidi_uba_an_bad_len;

        // (4) write para[+0] = text_offset[31:0] | length[63:32].
        // Inlined pack_extent (both halves already u32-clean from the
        // gates above, but re-mask defensively via shl 32/shr 32 on
        // text_offset since a compiler-lookahead reader might not see
        // the gate as evidence).
        mov rax, r12;
        shl rax, 32;
        shr rax, 32;                        // rax = text_offset & 0xFFFFFFFF
        mov r10, r13;
        shl r10, 32;                        // r10 = length << 32
        or  rax, r10;
        mov [rbx + 0], rax;

        // (5) load runs_ptr from para[+16].
        mov r10, [rbx + 16];                // r10 = runs_ptr

        // (6) branch on length > 0 AND runs_ptr != 0.
        cmp r13, 0;
        je  bidi_uba_an_empty;              // empty paragraph -> run_count=0
        cmp r10, 0;
        je  bidi_uba_an_no_buffer;          // no runs buffer -> run_count=0

        // Write BidiRun at runs[0]:
        //   [+0] = start_offset(0) | length(r13 << 32)
        //   [+8] = level(0) | direction(0) = 0
        mov rax, r13;
        shl rax, 32;                        // rax = length << 32; start=0
        mov [r10 + 0], rax;
        xor rax, rax;
        mov [r10 + 8], rax;

        // Write para[+8] = base_direction(0) | run_count(1 << 8) = 0x0100.
        mov rax, 0x0100;
        mov [rbx + 8], rax;

        // Bump BUBA_ST_ANALYZES.
        mov rdi, 0;                         // BUBA_ST_ANALYZES
        call bidi_uba_note;
        // Bump BUBA_ST_RUNS_EMITTED (one run).
        mov rdi, 3;                         // BUBA_ST_RUNS_EMITTED
        call bidi_uba_note;

        xor rax, rax;                       // BUBA_OK
        jmp bidi_uba_an_out;

      bidi_uba_an_empty:
      bidi_uba_an_no_buffer:
        // Write para[+8] = 0 (base_direction=0, run_count=0).
        xor rax, rax;
        mov [rbx + 8], rax;

        // Bump BUBA_ST_ANALYZES (still an analyze; no runs emitted).
        mov rdi, 0;                         // BUBA_ST_ANALYZES
        call bidi_uba_note;

        xor rax, rax;                       // BUBA_OK
        jmp bidi_uba_an_out;

      bidi_uba_an_bad_para:
        mov rax, 0xFFFFE80F;                // BUBA_BAD_PARAGRAPH_PTR
        jmp bidi_uba_an_refused;
      bidi_uba_an_bad_off:
        mov rax, 0xFFFFE80E;                // BUBA_BAD_TEXT_OFFSET
        jmp bidi_uba_an_refused;
      bidi_uba_an_bad_len:
        mov rax, 0xFFFFE80D;                // BUBA_BAD_TEXT_LENGTH
        // fallthrough

      bidi_uba_an_refused:
        mov r13, rax;                       // stash refusal across note
        mov rdi, 4;                         // BUBA_ST_REFUSED
        call bidi_uba_note;
        mov rax, r13;

      bidi_uba_an_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION 9 -- TOP-LEVEL: GET_RUN
  // ==========================================================================
  //
  // bidi_uba_get_run(paragraph_ptr, run_index, out_run_ptr) -> u64
  //
  //   Copy the BidiRun at index `run_index` into the caller's
  //   BidiRun-sized buffer at out_run_ptr. paideia-as does not
  //   currently return structs by value from asm bodies (mirrors the
  //   sig-compat note in latin_autocomplete / focus_router precedent);
  //   the task's docstring reads `-> BidiRun` but the wire signature
  //   is (paragraph_ptr, run_index, out_run_ptr) -> u64 with the
  //   caller providing the destination buffer and receiving OK / a
  //   refusal sentinel in rax.
  //
  //   Contract:
  //     (1) paragraph_ptr == 0            -> BUBA_BAD_PARAGRAPH_PTR
  //     (2) out_run_ptr == 0              -> BUBA_BAD_RUN_PTR
  //     (3) paragraph.runs_ptr == 0       -> BUBA_NO_RUNS
  //     (4) run_index >= run_count        -> BUBA_BAD_RUN_INDEX
  //     (5) success: copy 16 bytes from
  //         runs_ptr + run_index * 16 to
  //         out_run_ptr; bump BUBA_ST_GETS; return BUBA_OK.
  //
  //   Register plan (three callee-save pushes = 24 bytes; entry
  //   rsp%16==8 -> after three pushes rsp%16 == 0, aligned for
  //   nested calls to bidi_uba_note):
  //     rbx = paragraph_ptr
  //     r12 = run_index
  //     r13 = out_run_ptr
  pub let bidi_uba_get_run : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (paragraph_ptr: u64) (run_index: u64) (out_run_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-007 (paideia-os #2323): copy one BidiRun (16 bytes = 2 u64 words) from paragraph's runs buffer to caller's out_run buffer. Three callee-save pushes = 24 bytes; entry rsp%16==8 -> (8-24) mod 16 == 0, aligned for nested note calls. Order: (1) para-null gate. (2) out-null gate. (3) runs_ptr-null gate (read from para[+16]). (4) run_count gate (read from para[+8][23:8], cmp run_index >= count). (5) compute src = runs_ptr + run_index * 16 via lea and shl; copy 2 u64 words. (6) bump GETS; return BUBA_OK. No test, no add reg,[mem], no MOVABS. Labels prefixed bidi_uba_gr_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                       // paragraph_ptr
        mov r12, rsi;                       // run_index
        mov r13, rdx;                       // out_run_ptr

        // (1) para-null gate
        cmp rbx, 0;
        je  bidi_uba_gr_bad_para;

        // (2) out-null gate
        cmp r13, 0;
        je  bidi_uba_gr_bad_out;

        // (3) load runs_ptr from para[+16]; null -> NO_RUNS.
        mov r10, [rbx + 16];                // r10 = runs_ptr
        cmp r10, 0;
        je  bidi_uba_gr_no_runs;

        // (4) load run_count from para[+8][23:8]; refuse if
        //     run_index >= run_count.
        mov rax, [rbx + 8];
        shr rax, 8;
        shl rax, 48;
        shr rax, 48;                        // rax = run_count (u16)
        cmp r12, rax;
        jae bidi_uba_gr_bad_index;

        // (5) compute src = runs_ptr + run_index * 16.
        //     16 = 2^4, so shl r12, 4 gives byte-offset.
        //     But r12 must not be clobbered further; use rcx as scratch.
        mov rcx, r12;
        shl rcx, 4;                         // rcx = run_index * 16
        // Copy 2 u64 words from [r10 + rcx] to [r13].
        mov rax, [r10 + rcx + 0];
        mov [r13 + 0], rax;
        mov rax, [r10 + rcx + 8];
        mov [r13 + 8], rax;

        // (6) bump BUBA_ST_GETS.
        mov rdi, 1;                         // BUBA_ST_GETS
        call bidi_uba_note;

        xor rax, rax;                       // BUBA_OK
        jmp bidi_uba_gr_out;

      bidi_uba_gr_bad_para:
        mov rax, 0xFFFFE80F;                // BUBA_BAD_PARAGRAPH_PTR
        jmp bidi_uba_gr_refused;
      bidi_uba_gr_bad_out:
        mov rax, 0xFFFFE80B;                // BUBA_BAD_RUN_PTR
        jmp bidi_uba_gr_refused;
      bidi_uba_gr_no_runs:
        mov rax, 0xFFFFE806;                // BUBA_NO_RUNS
        jmp bidi_uba_gr_refused;
      bidi_uba_gr_bad_index:
        mov rax, 0xFFFFE80C;                // BUBA_BAD_RUN_INDEX
        // fallthrough

      bidi_uba_gr_refused:
        mov r13, rax;                       // stash refusal across note
        mov rdi, 4;                         // BUBA_ST_REFUSED
        call bidi_uba_note;
        mov rax, r13;

      bidi_uba_gr_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION 10 -- TOP-LEVEL: VISUAL_REORDER
  // ==========================================================================
  //
  // bidi_uba_visual_reorder(paragraph_ptr, out_visual_ptr) -> u64
  //
  //   Compute the visual-order permutation of runs per UBA rules
  //   L1..L4 and write it into the caller's u32[run_count] buffer at
  //   out_visual_ptr. The output is a permutation of run indices:
  //   out_visual_ptr[k] = j means "the k'th run in VISUAL order is
  //   the j'th run in LOGICAL order". A downstream glyph walker
  //   iterates k=0..run_count-1 and, for each k, walks the run at
  //   index out_visual_ptr[k] in the direction dictated by that run's
  //   `direction` field (LTR runs walked left-to-right, RTL runs
  //   walked right-to-left, per UBA rule L4 with mirroring).
  //
  //   Contract:
  //     (1) paragraph_ptr == 0            -> BUBA_BAD_PARAGRAPH_PTR
  //     (2) out_visual_ptr == 0           -> BUBA_BAD_VISUAL_PTR
  //     (3) run_count == 0                -> OK, no-op (empty
  //                                          paragraph or opt-out;
  //                                          the visual buffer is
  //                                          untouched)
  //     (4) paragraph.runs_ptr == 0 AND run_count > 0
  //                                        -> BUBA_NO_RUNS (invariant
  //                                          violation: run_count>0
  //                                          requires runs_ptr!=0)
  //     (5) success: write the visual-order permutation into
  //         out_visual_ptr; bump BUBA_ST_REORDERS; return BUBA_OK.
  //
  //   SCHEMA-ONLY REORDER BODY. The body currently writes the
  //   IDENTITY permutation (out_visual_ptr[k] = k for k=0..run_count-1).
  //   This is the correct L1..L4 output for a paragraph with
  //   ALL-EVEN-LEVEL RUNS (i.e. all-LTR), which is the schema-only
  //   analyze cascade's only current output. Once the real analyze
  //   cascade emits mixed-level runs, this reorder body will need to
  //   implement the nested-reversal walk from UBA L2 (find the
  //   highest level H, reverse all runs at H..H, then at H-1..H,
  //   etc., collapsing to L level runs from the top of the level
  //   stack downward). That walk is a substrate landing; the
  //   identity permutation is the correct schema-only stub because
  //   it produces the same downstream rendering as the current
  //   analyze output.
  //
  //   Register plan (three callee-save pushes = 24 bytes; entry
  //   rsp%16==8 -> after three pushes rsp%16 == 0, aligned for
  //   nested call to bidi_uba_note):
  //     rbx = paragraph_ptr
  //     r12 = out_visual_ptr
  //     r13 = run_count (u32-clean)
  pub let bidi_uba_visual_reorder : (u64, u64) -> u64 !{mem} @{} =
    fn (paragraph_ptr: u64) (out_visual_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M4-007 (paideia-os #2323): L1..L4 visual-order reordering (schema-only identity permutation). Three callee-save pushes = 24 bytes; entry rsp%16==8 -> (8-24) mod 16 == 0, aligned for nested note call. Order: (1) para-null gate. (2) out-null gate. (3) read run_count from para[+8][23:8]. (4) if run_count==0 return OK (no-op). (5) read runs_ptr from para[+16]; if 0 and run_count>0 refuse NO_RUNS. (6) loop k=0..run_count-1 writing out_visual_ptr[k*4] = k as u32 (identity permutation). (7) bump REORDERS; return BUBA_OK. Loop uses rcx as counter; 32-bit store via mov_d [reg+rcx*4], rax (the encoder-safe form documented in seed_caps.pdx / aml_arena.pdx / madt.pdx that avoids REX.W widening the store into the adjacent slot; bare `mov [mem], eax` widens on some encoder versions per the madt.pdx warning). No test, no add reg,[mem], no MOVABS. Labels prefixed bidi_uba_vr_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                       // paragraph_ptr
        mov r12, rsi;                       // out_visual_ptr

        // (1) para-null gate
        cmp rbx, 0;
        je  bidi_uba_vr_bad_para;

        // (2) out-null gate
        cmp r12, 0;
        je  bidi_uba_vr_bad_out;

        // (3) read run_count.
        mov rax, [rbx + 8];
        shr rax, 8;
        shl rax, 48;
        shr rax, 48;                        // rax = run_count (u16)
        mov r13, rax;                       // r13 = run_count

        // (4) run_count == 0 -> OK, no-op.
        cmp r13, 0;
        je  bidi_uba_vr_ok_noop;

        // (5) read runs_ptr; null with run_count > 0 is invariant break.
        mov r10, [rbx + 16];
        cmp r10, 0;
        je  bidi_uba_vr_no_runs;

        // (6) identity-permutation loop: k = 0..run_count-1;
        //     out_visual_ptr[k*4] = k as u32.
        xor rcx, rcx;                       // k = 0
      bidi_uba_vr_loop:
        cmp rcx, r13;
        jae bidi_uba_vr_done;
        // Write rcx (u32-safe: r13 <= 65535 since run_count is u16)
        // as a u32 at [r12 + rcx*4]. Use eax to get 32-bit store.
        mov rax, rcx;
        mov_d [r12 + rcx * 4], rax;
        add rcx, 1;
        jmp bidi_uba_vr_loop;

      bidi_uba_vr_done:
        // (7) bump BUBA_ST_REORDERS.
        mov rdi, 2;                         // BUBA_ST_REORDERS
        call bidi_uba_note;

        xor rax, rax;                       // BUBA_OK
        jmp bidi_uba_vr_out;

      bidi_uba_vr_ok_noop:
        // Empty paragraph or opt-out: bump REORDERS, return OK.
        mov rdi, 2;                         // BUBA_ST_REORDERS
        call bidi_uba_note;
        xor rax, rax;                       // BUBA_OK
        jmp bidi_uba_vr_out;

      bidi_uba_vr_bad_para:
        mov rax, 0xFFFFE80F;                // BUBA_BAD_PARAGRAPH_PTR
        jmp bidi_uba_vr_refused;
      bidi_uba_vr_bad_out:
        mov rax, 0xFFFFE807;                // BUBA_BAD_VISUAL_PTR
        jmp bidi_uba_vr_refused;
      bidi_uba_vr_no_runs:
        mov rax, 0xFFFFE806;                // BUBA_NO_RUNS
        // fallthrough

      bidi_uba_vr_refused:
        mov r13, rax;                       // stash refusal across note
        mov rdi, 4;                         // BUBA_ST_REFUSED
        call bidi_uba_note;
        mov rax, r13;

      bidi_uba_vr_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
