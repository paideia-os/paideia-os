// src/user/rootfs_seed.pdx — R57.M4-006 (paideia-os #1802)
//                            + R106.M1 (paideia-os #2228)
// Init-time /bin + /etc/motd + /home seed loop.
//
// See design/user/rootfs-seed-inventory.md for the manifest, payload
// strategy, fingerprint shape, and ordering rationale.
//
// R106.M1 addendum: the seed now also creates `/home` (0755) and
// `/home/<placeholder_fp>/` (0700) so the R108.M2 identity substrate
// can inhabit an already-shaped tree without re-touching every consumer
// of the home path. The placeholder fingerprint lives in
// src/user/founder_constants.pdx (module FounderConstants); this module
// references its rodata symbols by name. See
// design/roadmap/persistent-home-wave.md §R106.M1 and
// design/user/content-addressed-identity.md §4.
//
// This module is init-only. `build-user.sh` classifies rootfs_seed.o
// AND founder_constants.o into the INIT_OBJECTS set (the same slot
// syscall_shim / errno / string occupy for cross-cutting init/shell
// libraries — both are init-only at R106, so only INIT_OBJECTS grows).
// Inline `syscall` opcodes keep the module self-contained; no dependency
// on syscall_shim.pdx (matches the shape of `true.pdx` and
// `child_hello.pdx`). The founder_constants dependency is data-only
// (rodata symbols) — no callable surface is pulled in.
//
// SC+ IDs used (see src/kernel/core/syscall/dispatch.pdx):
//   1  = sys_write(fd, buf, count)
//   2  = sys_open(path, flags, mode)
//   3  = sys_close(fd)
//   12 = sys_debug_puts(buf, count)
//   77 = sys_stat(path_va, path_len, stat_buf_va)   -- R56.M3-002 (#1791)
//   79 = sys_mkdir(path_va, path_len, mode)         -- R56.M3-004 (#1793)
//
// Fingerprint (em-dash intentionally dropped so the line is 7-bit ASCII):
//   Work path: "rootfs seed ok [legacy: ROOTFS SEED OK] files=7\n"
//   Skip path: "rootfs seed ok [legacy: ROOTFS SEED OK] files=0\n"
//
// The `files=N` count is the FILE-manifest size (unchanged at R106.M1:
// the 7 /bin/* + /etc/motd entries are the only rows in the file table).
// The DIRECTORY inventory grew from 3 (/bin, /etc, /tmp) to 5 (adds
// /home, /home/<placeholder_fp>) at R106.M1, but the fingerprint's
// `files=` field is a file-count, not a total-entry count — matching
// the pre-R106.M1 convention documented in the inventory doc so the
// existing tests/r17/expected-boot-r17-init.txt golden line does not
// need to move. See design/user/rootfs-seed-inventory.md §Fingerprint
// for the rationale.
//
// Labels are prefixed `rs_` to avoid any reserved-keyword collision
// (`loop`, `if`, ...) per paideia-as label rules.

module RootfsSeed = structure {

  // ==========================================================================
  // Payload data
  // ==========================================================================

  // 9-byte ASCII stub used for every /bin/* file at R57.M0.
  // Real ELF payloads land in R57.M4-007+ once source .pdx exists for
  // ls/cat/ps/mount and build-user.sh embeds them into init.elf.
  pub let rs_stub_bin     : [u8; 10] = "R57 stub\n\0"
  pub let rs_stub_bin_len : u64      = 9

  // /etc/motd banner. 34 bytes on wire (excludes trailing NUL).
  pub let rs_motd_banner     : [u8; 35] = "PaideiaOS R57 -- init rootfs seed\n\0"
  pub let rs_motd_banner_len : u64      = 34

  // Directory paths (NUL-terminated for sys_stat / sys_mkdir).
  pub let rs_path_bin : [u8; 5] = "/bin\0"
  pub let rs_path_etc : [u8; 5] = "/etc\0"
  pub let rs_path_tmp : [u8; 5] = "/tmp\0"

  // File paths (NUL-terminated for sys_stat / sys_open).
  pub let rs_path_ls    : [u8; 8]  = "/bin/ls\0"
  pub let rs_path_cat   : [u8; 9]  = "/bin/cat\0"
  pub let rs_path_ps    : [u8; 8]  = "/bin/ps\0"
  pub let rs_path_mount : [u8; 11] = "/bin/mount\0"
  pub let rs_path_true  : [u8; 10] = "/bin/true\0"
  pub let rs_path_sh    : [u8; 8]  = "/bin/sh\0"
  pub let rs_path_motd  : [u8; 10] = "/etc/motd\0"

  // 64-byte stat scratch. sys_stat_body copies its filled struct back
  // through user_write_bytes_via_walk into whatever user VA we pass;
  // this .bss slot is a valid user-side destination. Single-threaded
  // caller (init _start runs before any fork), so no per-caller slotting
  // is required.
  pub let mut _rs_stat_scratch : [u64; 8] = uninit @align(8)

  // Fingerprint strings. Storage is emit_len + 1 (trailing NUL is not
  // written to the wire; sys_debug_puts is length-bounded).
  pub let rs_fp_ok        : [u8; 49] = "rootfs seed ok [legacy: ROOTFS SEED OK] files=7\n\0"
  pub let rs_fp_ok_len    : u64      = 48

  pub let rs_fp_skip      : [u8; 49] = "rootfs seed ok [legacy: ROOTFS SEED OK] files=0\n\0"
  pub let rs_fp_skip_len  : u64      = 48

  // ==========================================================================
  // rootfs_seed_run() -> ()  — main entry
  //
  // Sequence:
  //   (1) sys_stat("/etc", 255, &scratch). rax == 0 -> /etc exists -> skip
  //       the work path, emit rs_fp_skip, return. Any negative -> proceed.
  //   (2) mkdir /bin, /etc, /tmp (return codes ignored -- /bin already
  //       exists under kernel bin_seeds, and the intent is best-effort;
  //       any error from the subsequent per-file open bubbles up in the
  //       per-file skip logic anyway).
  //   (3) For each of the 7 manifest entries:
  //         - sys_stat(path, 255, &scratch). rax == 0 -> file already
  //           exists (kernel-seeded /bin/sh, /bin/true, or a prior init
  //           run under a persistent mount); skip open+write+close so we
  //           do not truncate a live ELF with our 9-byte stub.
  //         - Otherwise: sys_open(path, O_CREAT|O_WRONLY, 0644). fd
  //           saved in r12 (callee-save; survives sysret). If fd < 0,
  //           skip write+close for this entry.
  //         - sys_write(r12, data, data_len).
  //         - sys_close(r12).
  //   (4) Emit rs_fp_ok via sys_debug_puts. Return.
  //
  // Register discipline: entry rsp%16==8 (single call from Init._start,
  // whose own entry is at %16==0). Push r12 at entry to preserve for the
  // caller (SysV callee-save) and to hold fd across the sys_open ->
  // sys_write -> sys_close triple in each per-file block; pop before ret.
  // No nested SysV `call` -- only `syscall` -- so no per-call alignment
  // pad is needed. rsp%16 stays at 0 throughout the body between push
  // and pop; ret pops the retaddr and returns to Init._start.
  //
  // O_CREAT|O_WRONLY = 0x40 | 0x01 = 0x41 (65). Fits imm8; encoder-safe.
  // mode 0644                       = 0x1A4 (420). Fits imm16; encoder-safe.
  // mode 0777                       = 0x1FF (511). Fits imm16; encoder-safe.
  // path length cap 255             = imm8; encoder-safe.
  // (sys_open ignores mode at R16.M1; sys_mkdir's tmpfs adapter drops
  // the caller mode and forces VNODE_TYPE_DIR. Modes are supplied for
  // POSIX conformance even though the current backend does not consume
  // them; see design/kernel/r16-m3-001-sys-open.md.)
  //
  // All immediates are small positive integers (<= 0x1FF, always <= 4095)
  // so `mov r64, imm32` sign-extends correctly to positive u64 and no
  // MOVABS r64, imm64 verbatim-load hazard (see errno.pdx §613) applies.
  // ==========================================================================
  pub let rootfs_seed_run : () -> () !{mem, sysreg} @{fs} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {fs},
      justification: "R57.M4-006 (paideia-os #1802) + R106.M1 (paideia-os #2228): init-time rootfs seed loop. Runs once from Init._start after tty0 setup (so fd 0/1/2 are already claimed by tty0 and per-file sys_open returns fd >= 3, avoiding dispatch_write's fd in {1,2} -> UART fast-path that would otherwise route seed payload bytes onto the serial line). Sequence: (1) sys_stat(/etc, 255, &_rs_stat_scratch) via inline `mov rax, 77; syscall`; rax == 0 -> emit rs_fp_skip and return (this short-circuit also carries the /home + /home/<placeholder_fp> idempotency at R106.M1 — a persistent-FS reboot skips their mkdirs alongside the /bin/*/etc rows). (2) sys_mkdir(/bin 0x1FF, /etc 0x1FF, /tmp 0x1FF, /home 0x1ED = 0755, /home/<placeholder_fp> 0x1C0 = 0700) via inline `mov rax, 79; syscall`; return codes ignored (/bin may pre-exist via kernel bin_seeds; sys_mkdir returns -EIO on collision at R56, which we tolerate; the /home per-user mode 0700 encodes owner-only intent for the future POSIX-shaped consumer while the authoritative access gate is the KIND_HOME_ROOT cap per content-addressed-identity.md §5). (3) For each of 7 manifest entries (/bin/ls, /bin/cat, /bin/ps, /bin/mount, /bin/true, /bin/sh, /etc/motd): probe sys_stat first (skip if exists to preserve kernel-seeded /bin/sh + /bin/true); otherwise sys_open(path, 0x41 = O_CREAT|O_WRONLY, 0x1A4 = 0644); on fd < 0 skip; sys_write(fd, data, data_len); sys_close(fd). (4) Emit rs_fp_ok via `mov rax, 12; syscall`. R106.M1: rs_fp_ok's `files=7` count is unchanged (the /home rows are DIRECTORIES not files, and the fingerprint field is a file-manifest-size, not a total-entry count; see design/user/rootfs-seed-inventory.md §Fingerprint). Callee-save discipline: single `push r12` at entry to preserve for Init._start (which reuses r12 as fd holder AFTER this call returns) and to hold fd across the open/write/close triple in each per-file block; single `pop r12` before ret. No nested SysV `call` in the body -- only `syscall` opcodes -- so no alignment pad is needed anywhere. rsp%16 stays at 0 throughout the body between push and pop; ret pops the retaddr and returns cleanly. Immediates: all small positive integers (<= 0x1FF, always <= 4095) so mov r64, imm32 sign-extends correctly to positive u64 and the errno.pdx §613 MOVABS-verbatim-load hazard does not apply. Signed cmp+jl on rax < 0 correctly branches on any -errno sentinel (kernel returns 0xFFFF... which is negative signed) and correctly falls through for valid fds (positive). Effects {mem, sysreg} cover the rodata reads (paths, payloads, fingerprint, and the R106.M1 fc_home_root_path + fc_placeholder_home_path externals from src/user/founder_constants.pdx), scratch writes (_rs_stat_scratch), and syscall register state. Capabilities {fs} covers the sys_open / sys_write / sys_close / sys_stat / sys_mkdir surface (see syscall_shim.pdx sys_open which declares @{fs} for the same access). Labels are prefixed rs_ to avoid reserved-keyword collision (loop / if per feedback_paideia_as_reserved_labels); the R106.M1 additions reference founder_constants.pdx symbols by their fc_ prefix so no label crosses the module boundary.",
      block: {
        // Preserve r12 for SysV callee-save discipline. Init._start
        // reuses r12 as a scratch AFTER this call returns; the current
        // caller has not stored anything callee-save-relevant in r12
        // before this call, but the push future-proofs the contract.
        push r12;

        // ============================================================
        // Phase 1: sys_stat("/etc", 255, &_rs_stat_scratch)
        //   rax == 0 (SYS_STAT_OK)         -> /etc exists -> skip path
        //   rax != 0 (-ENOENT / -EFAULT)   -> proceed to seed path
        // ============================================================
        lea rdi, [rip + rs_path_etc];
        mov rsi, 255;
        lea rdx, [rip + _rs_stat_scratch];
        mov rax, 77;
        syscall;
        cmp rax, 0;
        jne rs_do_seed;

        // /etc exists: emit skip fingerprint, restore r12, return.
        lea rdi, [rip + rs_fp_skip];
        mov rsi, 48;
        mov rax, 12;
        syscall;
        pop r12;
        ret;

        rs_do_seed:
        // ============================================================
        // Phase 2: mkdir /bin, /etc, /tmp, /home, /home/<placeholder_fp>
        //
        // Return codes ignored throughout. /bin may already exist from
        // kernel bin_seeds (sys_mkdir returns -EIO on collision at R56;
        // per-file open below will still succeed since /bin as a
        // directory is what matters, not this particular mkdir call's
        // success). /etc + /tmp are new on first boot.
        //
        // R106.M1 (paideia-os #2228): the two /home entries are added
        // here so the persistent-home tree adopts its R108 shape now
        // (`/home/<64-hex-fp>/` per content-addressed-identity.md §4)
        // without waiting for real crypto. Modes 0755 (world-traversable
        // /home root) and 0700 (owner-only per-user home) encode intent
        // for the future POSIX-shaped consumer; the authoritative access
        // gate on the per-user subtree is the KIND_HOME_ROOT cap, not
        // the mode word (see content-addressed-identity.md §5).
        // Idempotency on the /home entries is inherited from the
        // top-of-body /etc-stat short-circuit (Phase 1): on any second
        // boot where /etc persists, the whole seed loop skips and both
        // /home mkdirs are bypassed with the same fingerprint (files=0)
        // that already covers the file rows.
        // ============================================================
        lea rdi, [rip + rs_path_bin];
        mov rsi, 255;
        mov rdx, 0x1FF;
        mov rax, 79;
        syscall;

        lea rdi, [rip + rs_path_etc];
        mov rsi, 255;
        mov rdx, 0x1FF;
        mov rax, 79;
        syscall;

        lea rdi, [rip + rs_path_tmp];
        mov rsi, 255;
        mov rdx, 0x1FF;
        mov rax, 79;
        syscall;

        // /home (mode 0755 = 0x1ED; fits imm16, encoder-safe).
        lea rdi, [rip + fc_home_root_path];
        mov rsi, 255;
        mov rdx, 0x1ED;
        mov rax, 79;
        syscall;

        // /home/<placeholder_fp> (mode 0700 = 0x1C0; fits imm16,
        // encoder-safe). Path composed at compile time in
        // src/user/founder_constants.pdx from fc_placeholder_fp_hex.
        lea rdi, [rip + fc_placeholder_home_path];
        mov rsi, 255;
        mov rdx, 0x1C0;
        mov rax, 79;
        syscall;

        // ============================================================
        // Phase 3: Per-file seed. Unrolled 7 times. Each block:
        //   stat -> if exists, skip
        //   open -> if fd < 0, skip
        //   write -> close
        // r12 holds fd across the open/write/close triple.
        // ============================================================

        // -------- 1. /bin/ls --------
        lea rdi, [rip + rs_path_ls];
        mov rsi, 255;
        lea rdx, [rip + _rs_stat_scratch];
        mov rax, 77;
        syscall;
        cmp rax, 0;
        je rs_after_ls;
        lea rdi, [rip + rs_path_ls];
        mov rsi, 0x41;
        mov rdx, 0x1A4;
        mov rax, 2;
        syscall;
        mov r12, rax;
        cmp rax, 0;
        jl rs_after_ls;
        mov rdi, r12;
        lea rsi, [rip + rs_stub_bin];
        mov rdx, 9;
        mov rax, 1;
        syscall;
        mov rdi, r12;
        mov rax, 3;
        syscall;
        rs_after_ls:

        // -------- 2. /bin/cat --------
        lea rdi, [rip + rs_path_cat];
        mov rsi, 255;
        lea rdx, [rip + _rs_stat_scratch];
        mov rax, 77;
        syscall;
        cmp rax, 0;
        je rs_after_cat;
        lea rdi, [rip + rs_path_cat];
        mov rsi, 0x41;
        mov rdx, 0x1A4;
        mov rax, 2;
        syscall;
        mov r12, rax;
        cmp rax, 0;
        jl rs_after_cat;
        mov rdi, r12;
        lea rsi, [rip + rs_stub_bin];
        mov rdx, 9;
        mov rax, 1;
        syscall;
        mov rdi, r12;
        mov rax, 3;
        syscall;
        rs_after_cat:

        // -------- 3. /bin/ps --------
        lea rdi, [rip + rs_path_ps];
        mov rsi, 255;
        lea rdx, [rip + _rs_stat_scratch];
        mov rax, 77;
        syscall;
        cmp rax, 0;
        je rs_after_ps;
        lea rdi, [rip + rs_path_ps];
        mov rsi, 0x41;
        mov rdx, 0x1A4;
        mov rax, 2;
        syscall;
        mov r12, rax;
        cmp rax, 0;
        jl rs_after_ps;
        mov rdi, r12;
        lea rsi, [rip + rs_stub_bin];
        mov rdx, 9;
        mov rax, 1;
        syscall;
        mov rdi, r12;
        mov rax, 3;
        syscall;
        rs_after_ps:

        // -------- 4. /bin/mount --------
        lea rdi, [rip + rs_path_mount];
        mov rsi, 255;
        lea rdx, [rip + _rs_stat_scratch];
        mov rax, 77;
        syscall;
        cmp rax, 0;
        je rs_after_mount;
        lea rdi, [rip + rs_path_mount];
        mov rsi, 0x41;
        mov rdx, 0x1A4;
        mov rax, 2;
        syscall;
        mov r12, rax;
        cmp rax, 0;
        jl rs_after_mount;
        mov rdi, r12;
        lea rsi, [rip + rs_stub_bin];
        mov rdx, 9;
        mov rax, 1;
        syscall;
        mov rdi, r12;
        mov rax, 3;
        syscall;
        rs_after_mount:

        // -------- 5. /bin/true --------
        // Kernel bin_seeds writes the real true.elf; this block should
        // stat-hit and skip so the exec path stays intact.
        lea rdi, [rip + rs_path_true];
        mov rsi, 255;
        lea rdx, [rip + _rs_stat_scratch];
        mov rax, 77;
        syscall;
        cmp rax, 0;
        je rs_after_true;
        lea rdi, [rip + rs_path_true];
        mov rsi, 0x41;
        mov rdx, 0x1A4;
        mov rax, 2;
        syscall;
        mov r12, rax;
        cmp rax, 0;
        jl rs_after_true;
        mov rdi, r12;
        lea rsi, [rip + rs_stub_bin];
        mov rdx, 9;
        mov rax, 1;
        syscall;
        mov rdi, r12;
        mov rax, 3;
        syscall;
        rs_after_true:

        // -------- 6. /bin/sh --------
        // Kernel bin_seeds writes the real shell.elf; this block should
        // stat-hit and skip so init's subsequent fork+exec succeeds.
        lea rdi, [rip + rs_path_sh];
        mov rsi, 255;
        lea rdx, [rip + _rs_stat_scratch];
        mov rax, 77;
        syscall;
        cmp rax, 0;
        je rs_after_sh;
        lea rdi, [rip + rs_path_sh];
        mov rsi, 0x41;
        mov rdx, 0x1A4;
        mov rax, 2;
        syscall;
        mov r12, rax;
        cmp rax, 0;
        jl rs_after_sh;
        mov rdi, r12;
        lea rsi, [rip + rs_stub_bin];
        mov rdx, 9;
        mov rax, 1;
        syscall;
        mov rdi, r12;
        mov rax, 3;
        syscall;
        rs_after_sh:

        // -------- 7. /etc/motd --------
        // The seeded-marker file. Payload is the real 34-byte banner
        // (not the stub) so a user peek at /etc/motd sees content.
        lea rdi, [rip + rs_path_motd];
        mov rsi, 255;
        lea rdx, [rip + _rs_stat_scratch];
        mov rax, 77;
        syscall;
        cmp rax, 0;
        je rs_after_motd;
        lea rdi, [rip + rs_path_motd];
        mov rsi, 0x41;
        mov rdx, 0x1A4;
        mov rax, 2;
        syscall;
        mov r12, rax;
        cmp rax, 0;
        jl rs_after_motd;
        mov rdi, r12;
        lea rsi, [rip + rs_motd_banner];
        mov rdx, 34;
        mov rax, 1;
        syscall;
        mov rdi, r12;
        mov rax, 3;
        syscall;
        rs_after_motd:

        // ============================================================
        // Phase 4: Emit fingerprint (work path). Fixed "files=7"
        // reflects the manifest size, not the per-boot write count --
        // see design/user/rootfs-seed-inventory.md §Fingerprint.
        // ============================================================
        lea rdi, [rip + rs_fp_ok];
        mov rsi, 48;
        mov rax, 12;
        syscall;

        pop r12;
        ret
      }
    } @no_frame
}
