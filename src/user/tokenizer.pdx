// src/user/tokenizer.pdx — R17-M3-003 (#623) + R58.M5-001 (#1805)
// Shell tokenizer: in-place null-terminate on whitespace runs, build argv[16] pointers to tokens.
// Acceptance: builds; disassembly contains arg_buf, argc, cmp against whitespace bytes, indexed stores.
// See design/kernel/r17-m3-003-shell-tokenizer.md and design/user/shell-io-redirection.md.
//
// R58.M5-001 (#1805): '>', '>>', '<' are now hard delimiters, exactly like
// whitespace — they end whatever token is being scanned, and become their
// own token in argv_buf. Unlike ordinary tokens, a redirect token's
// argv_buf slot does NOT point into the line buffer: it points at one of
// the three rodata constants below (redirect_gt / redirect_gtgt /
// redirect_lt). This sidesteps the in-place NUL-termination problem an
// operator adjacent to its filename would otherwise create (e.g. ">file"
// has no spare byte between '>' and 'f' to write a terminating NUL into),
// and lets exec_child (dispatch.pdx) recognize operators via strlen+memcmp
// against those same constants.
//
// -----------------------------------------------------------------------------
// R106.M4-USER (paideia-os #2342): TOK_TILDE_ALIAS
// -----------------------------------------------------------------------------
//
// A leading '~' at a token START position (never mid-token -- unlike the
// '>'/'>>'/'<' redirect class above, which IS recognized mid-token) now
// scans the following identifier run (ASCII '0'-'9'/'A'-'Z'/'a'-'z'/'_')
// as an alias name and emits its own token kind, TOK_TILDE_ALIAS, instead
// of an ordinary raw-text token. Bare '~' (no name -- immediately
// followed by whitespace, a redirect operator, or end-of-line) is still
// TOK_TILDE_ALIAS, with an empty-string payload.
//
// Token-kind tagging is new to this file: argv_types[i] parallels
// argv_buf[i] and holds TOK_WORD (0 -- the default, covering both
// ordinary tokens and the pre-existing redirect-operator tokens) or
// TOK_TILDE_ALIAS (1). Every token-producing path -- the ordinary
// "token start" fallthrough, tk_rd_gt_single, tk_rd_gt_double, tk_rd_lt,
// and the new tk_tilde_start -- writes its argv_types slot explicitly;
// relying on argv_types' .bss zero-fill alone would leak a stale
// TOK_TILDE_ALIAS tag across separate tokenize() calls (separate shell
// lines) at whichever argv index a tilde-alias token last occupied.
//
// argv_buf's entry for a TOK_TILDE_ALIAS token points at the alias name
// substring -- the byte(s) after '~', NUL-terminated in place exactly
// like an ordinary token -- NOT at the '~' character itself, and NOT at
// rodata (unlike the redirect class). If a non-identifier, non-delimiter
// byte follows the name run (e.g. the '/' in "~docs/foo"), the name
// capture ends there without consuming that byte, and the byte is left
// for skip_ws to pick back up as the start of a brand-new ordinary
// token -- i.e. "~docs/foo" tokenizes today as TOK_TILDE_ALIAS "docs"
// followed by TOK_WORD "/foo", not a single composed path. Real
// same-token path composition is dispatch-time work, tracked with the
// resolver below.
//
// Resolution -- '~' -> $HOME, '~docs' -> $HOME/docs, '~alice' -> an
// alias-table lookup -- is itself a dispatch-time concern. The stub
// tokenizer_resolve_alias below only distinguishes "empty name" (returns
// HOME_MARKER) from "any other name" (returns E_ALIAS_UNRESOLVED). Real
// resolution (walking envp for HOME, consulting a KIND_USER_ALIAS
// registry) lands through dispatch.pdx once #2231 / R108.M4 are ready --
// see design/roadmap/persistent-home-wave.md R106.M4 and R108.M4.
//
// FAILURE TAXONOMY 0xFFFFE930..0xFFFFE93F (pre-assigned to this task).
// Only TTA_ALIAS_UNRESOLVED (== E_ALIAS_UNRESOLVED) is reachable today;
// the rest are reserved for follow-up landings (a name-length cap, an
// argv-overflow-mid-scan guard, a defensive dense-payload refusal, and
// an uninitialized-resolver guard) so none of them has to re-open this
// band later.

module Tokenizer = structure {
  pub let argv_buf : [u64; 17] = uninit @align(8)  // +1 slot reserved for execve NULL terminator (used by exec_child in dispatch.pdx)
  pub let argc : u64 = uninit @align(8)

  // R58.M5-001 (#1805): redirect operator rodata. argv_buf entries for a
  // redirect token point here (not into the line buffer) — see header note.
  pub let redirect_gt : [u8; 2] = ">\0"
  pub let redirect_gt_len : u64 = 1
  pub let redirect_gtgt : [u8; 3] = ">>\0"
  pub let redirect_gtgt_len : u64 = 2
  pub let redirect_lt : [u8; 2] = "<\0"
  pub let redirect_lt_len : u64 = 1

  // R106.M4-USER (#2342): token-kind tags. See module header note above
  // for the full argv_types design.
  pub let TOK_WORD         : u64 = 0   // ordinary raw-text token OR redirect-operator token (default; matches argv_types' .bss zero-fill, but every token-producing path writes it explicitly -- see header note)
  pub let TOK_TILDE_ALIAS  : u64 = 1   // '~' or '~<name>' token; argv_buf's entry points at the NUL-terminated name substring (empty for bare '~')

  // argv_types[i] tags argv_buf[i]'s token kind (TOK_WORD / TOK_TILDE_ALIAS).
  // Parallel array to argv_buf: same argc bound, same per-call lifetime.
  // Indices >= argc are stale from a prior tokenize() call, exactly like
  // argv_buf's own tail -- consumers must never read past argc for
  // either array.
  pub let argv_types : [u64; 17] = uninit @align(8)

  // Sentinel tokenizer_resolve_alias returns for a bare '~' (empty
  // name): "the alias is the home directory itself". Not a pointer and
  // not a member of the 0xFFFFE930..93F failure band below --
  // dispatch.pdx (#2231) is expected to special-case this value into an
  // actual $HOME substitution once it consumes argv_types/argv_buf
  // together. 'HOME' ASCII, MSB-first (matches DHCP_XID_SENTINEL's
  // 'PAID'-style tag convention -- src/kernel/core/net/dhcp.pdx).
  pub let HOME_MARKER : u64 = 0x484F4D45

  // FAILURE TAXONOMY 0xFFFFE930..0xFFFFE93F (pre-assigned, R106.M4-USER
  // task brief). Only TTA_ALIAS_UNRESOLVED is wired today (returned by
  // tokenizer_resolve_alias below); the rest are reserved so a future
  // landing (name-length cap, argv-overflow mid tilde-alias scan, a
  // defensive dense-payload refusal, an uninitialized-resolver guard)
  // can claim a code without reopening this band.
  pub let TTA_NULL             : u64 = 0xFFFFE93F   // reserved: name_ptr == 0 with name_len != 0 (defensive; unreachable from tokenize() today)
  pub let TTA_NAME_TOO_LONG    : u64 = 0xFFFFE93E   // reserved: alias name exceeds a future max-length cap
  pub let TTA_ALIAS_UNRESOLVED : u64 = 0xFFFFE93D   // alias name has no known mapping; == E_ALIAS_UNRESOLVED below
  pub let TTA_TOKEN_OVERFLOW   : u64 = 0xFFFFE93C   // reserved: argv full mid tilde-alias scan
  pub let TTA_REFUSED_DENSE    : u64 = 0xFFFFE93B   // reserved: defensive refusal for a maliciously dense/packed alias payload
  pub let TTA_NOT_INIT         : u64 = 0xFFFFE93A   // reserved: resolver invoked before tokenizer state is initialized
  // 0xFFFFE930..0xFFFFE939 reserved for future TTA_* codes.

  // Exported under the task-brief's own name; same value as
  // TTA_ALIAS_UNRESOLVED above (duplicated literal rather than a
  // cross-reference -- this file's convention for related sentinels,
  // see e.g. net/dhcp.pdx's DHCP_XID_SENTINEL comment cross-references).
  pub let E_ALIAS_UNRESOLVED : u64 = 0xFFFFE93D

  // tokenize(buf, byte_count) -> argc (stored in argc slot and returned in rax).
  // In-place null-terminate whitespace, build argv_buf pointers.
  // Whitespace class: 0x20 (space), 0x09 (tab), 0x0A (newline).
  // Hard-delimiter class (R58.M5-001, #1805): 0x3E ('>', possibly doubled
  // into ">>"), 0x3C ('<'). Each becomes its own argv_buf token (pointing
  // at rodata, not the line buffer) — see module header note.
  // NUL (0x00) treated as early terminator.
  // Stops when: byte_count exhausted, NUL encountered, or argv full (16).
  pub let tokenize : (u64, u64) -> u64 !{mem} @{} =
    fn (buf: u64) (byte_count: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R17-m3-003 (#623): in-place shell tokenizer. Iterate over line_buf in-place, null-terminate on whitespace runs, build argv[16] array. rdi=buf, rsi=byte_count. Loop: cursor at r8, end at r9 (buf+n), argc counter in r10. On non-ws byte: store pointer to argv, increment argc. On ws byte: write NUL, consume run. Store count in argc slot, return in rax. Mitigation paideia-as #1248: xor rax,rax; mov_b pattern before cmp instructions. R58.M5-001 (#1805) adds '>'/'>>'/'<' as a third hard-delimiter class alongside whitespace and NUL: tk_rd_gt_check/tk_rd_gt_single/tk_rd_gt_double/tk_rd_lt build a token whose argv_buf slot points at the redirect_gt/redirect_gtgt/redirect_lt rodata constants (not the line buffer), then resume the normal skip_ws scan past the consumed operator byte(s). in_token additionally treats 0x3E/0x3C as delimiters: it NULs the in-progress buffer token at the operator's position (safe — the operator's own token content comes from rodata, not this buffer byte) without consuming the byte, then falls into the same tk_rd_gt_check/tk_rd_lt path so a double '>' can still be recognized via the still-intact byte at cursor+1. Reserved-label discipline: all new labels are tk_rd_-prefixed. R106.M4-USER (#2342) adds a fourth token-start class alongside whitespace/NUL/redirect: 0x7E ('~') at skip_ws enters tk_tilde_start, which writes TOK_TILDE_ALIAS into argv_types[argc], sets argv_buf[argc] to cursor+1 (the byte after '~'), then tk_tilde_scan consumes an identifier run (0-9/A-Z/a-z/_). A whitespace boundary reuses terminate_token; a redirect-operator boundary reuses tk_rd_in_gt/tk_rd_in_lt (exactly as the pre-existing in_token loop does for both); any other non-identifier byte NULs the name in place without consuming that byte and resumes skip_ws so the boundary byte starts a fresh token there. Every OTHER token-producing path (plain token start, tk_rd_gt_single/double, tk_rd_lt) now also writes argv_types[argc] = TOK_WORD (0) explicitly, since argv_types' .bss zero-fill alone only holds across the FIRST tokenize() call at a given slot. New labels are tk_tilde_-prefixed.",
      block: {
        mov r8, rdi;            // r8 = cursor = buf
        mov r9, rdi;            // r9 = end = buf
        add r9, rsi;            // r9 = buf + byte_count
        xor r10, r10;           // r10 = argc = 0

      skip_ws:
        cmp r8, r9;             // if cursor >= end: done
        jge done;
        cmp r10, 16;            // if argc >= 16: done (argv full)
        jge done;

        xor rax, rax;           // clear rax before narrow load (paideia-as #1248 mitigation)
        mov_b rax, [r8];        // rax = [cursor] (byte load, zero-extended)
        cmp rax, 0;             // if byte == NUL: done (early terminator)
        je done;

        cmp rax, 0x20;          // if byte == space: consume_ws
        je consume_ws;
        cmp rax, 0x09;          // if byte == tab: consume_ws
        je consume_ws;
        cmp rax, 0x0A;          // if byte == newline: consume_ws
        je consume_ws;

        cmp rax, 0x3E;          // if byte == '>': redirect operator (R58.M5-001, #1805)
        je tk_rd_gt_check;
        cmp rax, 0x3C;          // if byte == '<': redirect operator (R58.M5-001, #1805)
        je tk_rd_lt;

        cmp rax, 0x7E;          // if byte == '~': tilde-alias token start (R106.M4-USER, #2342)
        je tk_tilde_start;

        // token start: store pointer to argv_buf[argc]
        lea r11, [rip + argv_types];
        mov [r11 + r10*8], 0;   // argv_types[argc] = TOK_WORD (0); explicit so a stale TOK_TILDE_ALIAS tag from a prior tokenize() call cannot leak through this slot (R106.M4-USER, #2342)
        lea r11, [rip + argv_buf];
        mov [r11 + r10*8], r8;  // argv_buf[argc] = cursor
        add r10, 1;             // argc++

      in_token:
        add r8, 1;              // cursor++
        cmp r8, r9;             // if cursor >= end: done
        jge done;

        xor rax, rax;           // clear rax before narrow load (paideia-as #1248 mitigation)
        mov_b rax, [r8];        // rax = [cursor]
        cmp rax, 0;             // if byte == NUL: done
        je done;

        cmp rax, 0x20;          // if byte == space: terminate_token
        je terminate_token;
        cmp rax, 0x09;          // if byte == tab: terminate_token
        je terminate_token;
        cmp rax, 0x0A;          // if byte == newline: terminate_token
        je terminate_token;

        cmp rax, 0x3E;          // if byte == '>': terminate token, don't consume (R58.M5-001, #1805)
        je tk_rd_in_gt;
        cmp rax, 0x3C;          // if byte == '<': terminate token, don't consume (R58.M5-001, #1805)
        je tk_rd_in_lt;

        jmp in_token;           // continue in token

      terminate_token:
        xor rcx, rcx;           // rcx = 0 (value to store)
        mov_b [r8], rcx;        // [cursor] = 0 (in-place null-terminate)
        add r8, 1;              // cursor++
        jmp skip_ws;            // skip to next token

      consume_ws:
        add r8, 1;              // cursor++
        jmp skip_ws;            // check next byte

      // R58.M5-001 (#1805): mid-token redirect operator (e.g. "file>out",
      // no whitespace between the previous token and the operator).
      // NUL-terminate the in-progress buffer token at the operator's
      // position (safe: the operator's own argv_buf entry will point at
      // rodata below, never at this buffer byte) but do NOT advance the
      // cursor — tk_rd_gt_check/tk_rd_lt re-inspect cursor+1 to detect a
      // doubled '>' and then consume the operator's own byte(s).
      tk_rd_in_gt:
        xor rcx, rcx;
        mov_b [r8], rcx;
        jmp tk_rd_gt_check;

      tk_rd_in_lt:
        xor rcx, rcx;
        mov_b [r8], rcx;
        jmp tk_rd_lt;

      // R58.M5-001 (#1805): '>' seen at skip_ws (fresh operator, nothing
      // to terminate) or reached via tk_rd_in_gt (previous token just
      // NUL-terminated in place). Peek cursor+1 for a second '>' to decide
      // between the single- and double-char operator, without disturbing
      // cursor+1's byte (needed for the double case's own token content —
      // moot here since both point at rodata, but consistent with the
      // "don't touch anything but what you own" discipline elsewhere in
      // this loop).
      tk_rd_gt_check:
        cmp r10, 16;             // argv full guard (mirrors skip_ws's own check)
        jge done;
        mov rcx, r8;
        add rcx, 1;              // rcx = candidate second '>' position
        cmp rcx, r9;             // out of bounds (end of buffer)?
        jge tk_rd_gt_single;
        xor rax, rax;
        mov_b rax, [rcx];
        cmp rax, 0x3E;
        je tk_rd_gt_double;

      tk_rd_gt_single:
        lea r11, [rip + argv_types];
        mov [r11 + r10*8], 0;    // argv_types[argc] = TOK_WORD (0); redirect operators are TOK_WORD too (R106.M4-USER, #2342)
        lea r11, [rip + argv_buf];
        lea rax, [rip + redirect_gt];
        mov [r11 + r10*8], rax;  // argv_buf[argc] = &redirect_gt (">")
        add r10, 1;              // argc++
        add r8, 1;               // consume the single '>' byte
        jmp skip_ws;

      tk_rd_gt_double:
        lea r11, [rip + argv_types];
        mov [r11 + r10*8], 0;    // argv_types[argc] = TOK_WORD (0) (R106.M4-USER, #2342)
        lea r11, [rip + argv_buf];
        lea rax, [rip + redirect_gtgt];
        mov [r11 + r10*8], rax;  // argv_buf[argc] = &redirect_gtgt (">>")
        add r10, 1;              // argc++
        add r8, 2;               // consume both '>' bytes
        jmp skip_ws;

      tk_rd_lt:
        cmp r10, 16;             // argv full guard
        jge done;
        lea r11, [rip + argv_types];
        mov [r11 + r10*8], 0;    // argv_types[argc] = TOK_WORD (0) (R106.M4-USER, #2342)
        lea r11, [rip + argv_buf];
        lea rax, [rip + redirect_lt];
        mov [r11 + r10*8], rax;  // argv_buf[argc] = &redirect_lt ("<")
        add r10, 1;              // argc++
        add r8, 1;               // consume the '<' byte
        jmp skip_ws;

      // R106.M4-USER (paideia-os #2342): tilde-alias token. Entered only
      // from skip_ws (never from in_token -- '~' mid-token is ordinary
      // text, matching the module header note's "token START position
      // only" scope), so argc < 16 is already guaranteed by skip_ws's
      // own guard and does not need re-checking here.
      tk_tilde_start:
        lea r11, [rip + argv_types];
        mov [r11 + r10*8], 1;    // argv_types[argc] = TOK_TILDE_ALIAS (1)
        lea r11, [rip + argv_buf];
        lea rax, [r8 + 1];       // name starts one byte past '~' (empty string if that byte is itself a delimiter)
        mov [r11 + r10*8], rax;  // argv_buf[argc] = &name
        add r10, 1;              // argc++
        add r8, 1;               // cursor++ (consume the '~' byte itself)
        jmp tk_tilde_scan;

      // Scans the alias-name identifier run byte by byte. Delimiter
      // classes (whitespace, redirect operators, NUL, end-of-buffer)
      // are handled identically to in_token by reusing its own labels;
      // a non-identifier/non-delimiter byte ends the name in place
      // without consuming it (tk_tilde_boundary).
      tk_tilde_scan:
        cmp r8, r9;             // if cursor >= end: done
        jge done;

        xor rax, rax;           // clear rax before narrow load (paideia-as #1248 mitigation)
        mov_b rax, [r8];        // rax = [cursor]
        cmp rax, 0;             // if byte == NUL: done
        je done;

        cmp rax, 0x20;          // if byte == space: terminate_token
        je terminate_token;
        cmp rax, 0x09;          // if byte == tab: terminate_token
        je terminate_token;
        cmp rax, 0x0A;          // if byte == newline: terminate_token
        je terminate_token;

        cmp rax, 0x3E;          // if byte == '>': terminate token, don't consume
        je tk_rd_in_gt;
        cmp rax, 0x3C;          // if byte == '<': terminate token, don't consume
        je tk_rd_in_lt;

        // Identifier class: '0'-'9' | 'A'-'Z' | 'a'-'z' | '_'.
        cmp rax, 0x30;
        jl tk_tilde_not_digit;
        cmp rax, 0x39;
        jg tk_tilde_not_digit;
        jmp tk_tilde_cont;

      tk_tilde_not_digit:
        cmp rax, 0x41;
        jl tk_tilde_not_upper;
        cmp rax, 0x5A;
        jg tk_tilde_not_upper;
        jmp tk_tilde_cont;

      tk_tilde_not_upper:
        cmp rax, 0x61;
        jl tk_tilde_not_lower;
        cmp rax, 0x7A;
        jg tk_tilde_not_lower;
        jmp tk_tilde_cont;

      tk_tilde_not_lower:
        cmp rax, 0x5F;          // '_'
        je tk_tilde_cont;
        jmp tk_tilde_boundary;  // non-identifier, non-delimiter byte: end the name here

      tk_tilde_cont:
        add r8, 1;              // cursor++
        jmp tk_tilde_scan;

      tk_tilde_boundary:
        xor rcx, rcx;           // rcx = 0 (value to store)
        mov_b [r8], rcx;        // [cursor] = 0 (NUL-terminate the name; do NOT consume this byte)
        jmp skip_ws;            // resume scanning; boundary byte starts a fresh token

      done:
        lea r11, [rip + argc];  // r11 = &argc
        mov [r11], r10;         // argc = r10 (store count)
        mov rax, r10;           // rax = r10 (return count)
        ret
      }
    }

  // tokenizer_resolve_alias(name_ptr, name_len) -> u64
  //
  // R106.M4-USER (paideia-os #2342) stub. Two hardcoded cases only:
  //   name_len == 0 (bare '~')       -> HOME_MARKER
  //   name_len != 0 (any other name) -> E_ALIAS_UNRESOLVED
  // name_ptr is accepted -- frozen into the signature dispatch.pdx will
  // call once #2231 wires the dispatch-time path -- but this stub does
  // not read it: distinguishing among non-empty names needs an actual
  // HOME env-var walk / KIND_USER_ALIAS lookup, which is future work
  // (R108.M4). Deliberately effects{}/capabilities{} -- this stub
  // touches no memory and no capability.
  pub let tokenizer_resolve_alias : (u64, u64) -> u64 !{} @{} =
    fn (name_ptr: u64) (name_len: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R106.M4-USER (paideia-os #2342): tokenizer_resolve_alias(name_ptr:rdi, name_len:rsi) -> u64 (rax). Stub resolver for TOK_TILDE_ALIAS tokens. Body: cmp rsi, 0; je tra_home -- bare '~' (empty name) resolves to HOME_MARKER, a sentinel dispatch.pdx substitutes for $HOME once wired (#2231). Any nonzero name_len (an actual alias name, e.g. '~docs' or '~alice') is unresolvable by this stub and returns E_ALIAS_UNRESOLVED (== TTA_ALIAS_UNRESOLVED, 0xFFFFE93D) -- exercising the failure path now so the real KIND_USER_ALIAS-backed resolver (R108.M4) only has to replace this one branch. name_ptr (rdi) is accepted per the frozen signature but deliberately unread -- distinguishing among nonzero-length names needs an actual lookup this landing does not implement. Leaf, no memory access, no capability: effects{} @{}. Label tra_home is function-prefixed per the reserved-label discipline.",
      block: {
        cmp rsi, 0;
        je tra_home;
        mov rax, 0xFFFFE93D;    // E_ALIAS_UNRESOLVED (== TTA_ALIAS_UNRESOLVED)
        ret;
      tra_home:
        mov rax, 0x484F4D45;    // HOME_MARKER
        ret
      }
    }

  // ==========================================================================
  // Fingerprint tag.
  // ==========================================================================
  //
  // Data-only constant, matching the "Wave0-B14/B15" sample posture: no
  // dispatcher or boot witness calls tokenizer_resolve_alias or emits
  // this marker yet -- that lands with #2231's dispatch.pdx wiring.
  // Needs an allowlist entry in tools/verify-fingerprint-coverage.sh;
  // added alongside this file per this landing's own scope.
  //
  // Length: "tokenizer tilde alias ok [legacy: TOKENIZER TILDE ALIAS OK]\0"
  //   = 59 characters + NUL = 60 bytes (strlen+1 rule).
  pub let tokenizer_tilde_alias_meta : [u8; 60] = "tokenizer tilde alias ok [legacy: TOKENIZER TILDE ALIAS OK]\0"
}
