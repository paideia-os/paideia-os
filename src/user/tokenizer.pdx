// src/user/tokenizer.pdx — R17-M3-003 (#623) + R58.M5-001 (#1805)
// Shell tokenizer: in-place null-terminate on whitespace runs, build argv[16] pointers to tokens.
// Acceptance: builds; disassembly contains arg_buf, argc, cmp against whitespace bytes, indexed stores.
// See design/kernel/r17-m3-003-shell-tokenizer.md and design/user/shell-io-redirection.md.
//
// R58.M5-001 (#1805): '>', '>>', '<' are now hard delimiters, exactly like
// whitespace — they end whatever token is being scanned, and become their
// own token in argv_buf. Unlike ordinary tokens, a redirect token's
// argv_buf slot does NOT point into the line buffer: it points at one of
// the three rodata constants below (redirect_gt / redirect_gtgt /
// redirect_lt). This sidesteps the in-place NUL-termination problem an
// operator adjacent to its filename would otherwise create (e.g. ">file"
// has no spare byte between '>' and 'f' to write a terminating NUL into),
// and lets exec_child (dispatch.pdx) recognize operators via strlen+memcmp
// against those same constants.

module Tokenizer = structure {
  pub let argv_buf : [u64; 17] = uninit @align(8)  // +1 slot reserved for execve NULL terminator (used by exec_child in dispatch.pdx)
  pub let argc : u64 = uninit @align(8)

  // R58.M5-001 (#1805): redirect operator rodata. argv_buf entries for a
  // redirect token point here (not into the line buffer) — see header note.
  pub let redirect_gt : [u8; 2] = ">\0"
  pub let redirect_gt_len : u64 = 1
  pub let redirect_gtgt : [u8; 3] = ">>\0"
  pub let redirect_gtgt_len : u64 = 2
  pub let redirect_lt : [u8; 2] = "<\0"
  pub let redirect_lt_len : u64 = 1

  // tokenize(buf, byte_count) -> argc (stored in argc slot and returned in rax).
  // In-place null-terminate whitespace, build argv_buf pointers.
  // Whitespace class: 0x20 (space), 0x09 (tab), 0x0A (newline).
  // Hard-delimiter class (R58.M5-001, #1805): 0x3E ('>', possibly doubled
  // into ">>"), 0x3C ('<'). Each becomes its own argv_buf token (pointing
  // at rodata, not the line buffer) — see module header note.
  // NUL (0x00) treated as early terminator.
  // Stops when: byte_count exhausted, NUL encountered, or argv full (16).
  pub let tokenize : (u64, u64) -> u64 !{mem} @{} =
    fn (buf: u64) (byte_count: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R17-m3-003 (#623): in-place shell tokenizer. Iterate over line_buf in-place, null-terminate on whitespace runs, build argv[16] array. rdi=buf, rsi=byte_count. Loop: cursor at r8, end at r9 (buf+n), argc counter in r10. On non-ws byte: store pointer to argv, increment argc. On ws byte: write NUL, consume run. Store count in argc slot, return in rax. Mitigation paideia-as #1248: xor rax,rax; mov_b pattern before cmp instructions. R58.M5-001 (#1805) adds '>'/'>>'/'<' as a third hard-delimiter class alongside whitespace and NUL: tk_rd_gt_check/tk_rd_gt_single/tk_rd_gt_double/tk_rd_lt build a token whose argv_buf slot points at the redirect_gt/redirect_gtgt/redirect_lt rodata constants (not the line buffer), then resume the normal skip_ws scan past the consumed operator byte(s). in_token additionally treats 0x3E/0x3C as delimiters: it NULs the in-progress buffer token at the operator's position (safe — the operator's own token content comes from rodata, not this buffer byte) without consuming the byte, then falls into the same tk_rd_gt_check/tk_rd_lt path so a double '>' can still be recognized via the still-intact byte at cursor+1. Reserved-label discipline: all new labels are tk_rd_-prefixed.",
      block: {
        mov r8, rdi;            // r8 = cursor = buf
        mov r9, rdi;            // r9 = end = buf
        add r9, rsi;            // r9 = buf + byte_count
        xor r10, r10;           // r10 = argc = 0

      skip_ws:
        cmp r8, r9;             // if cursor >= end: done
        jge done;
        cmp r10, 16;            // if argc >= 16: done (argv full)
        jge done;

        xor rax, rax;           // clear rax before narrow load (paideia-as #1248 mitigation)
        mov_b rax, [r8];        // rax = [cursor] (byte load, zero-extended)
        cmp rax, 0;             // if byte == NUL: done (early terminator)
        je done;

        cmp rax, 0x20;          // if byte == space: consume_ws
        je consume_ws;
        cmp rax, 0x09;          // if byte == tab: consume_ws
        je consume_ws;
        cmp rax, 0x0A;          // if byte == newline: consume_ws
        je consume_ws;

        cmp rax, 0x3E;          // if byte == '>': redirect operator (R58.M5-001, #1805)
        je tk_rd_gt_check;
        cmp rax, 0x3C;          // if byte == '<': redirect operator (R58.M5-001, #1805)
        je tk_rd_lt;

        // token start: store pointer to argv_buf[argc]
        lea r11, [rip + argv_buf];
        mov [r11 + r10*8], r8;  // argv_buf[argc] = cursor
        add r10, 1;             // argc++

      in_token:
        add r8, 1;              // cursor++
        cmp r8, r9;             // if cursor >= end: done
        jge done;

        xor rax, rax;           // clear rax before narrow load (paideia-as #1248 mitigation)
        mov_b rax, [r8];        // rax = [cursor]
        cmp rax, 0;             // if byte == NUL: done
        je done;

        cmp rax, 0x20;          // if byte == space: terminate_token
        je terminate_token;
        cmp rax, 0x09;          // if byte == tab: terminate_token
        je terminate_token;
        cmp rax, 0x0A;          // if byte == newline: terminate_token
        je terminate_token;

        cmp rax, 0x3E;          // if byte == '>': terminate token, don't consume (R58.M5-001, #1805)
        je tk_rd_in_gt;
        cmp rax, 0x3C;          // if byte == '<': terminate token, don't consume (R58.M5-001, #1805)
        je tk_rd_in_lt;

        jmp in_token;           // continue in token

      terminate_token:
        xor rcx, rcx;           // rcx = 0 (value to store)
        mov_b [r8], rcx;        // [cursor] = 0 (in-place null-terminate)
        add r8, 1;              // cursor++
        jmp skip_ws;            // skip to next token

      consume_ws:
        add r8, 1;              // cursor++
        jmp skip_ws;            // check next byte

      // R58.M5-001 (#1805): mid-token redirect operator (e.g. "file>out",
      // no whitespace between the previous token and the operator).
      // NUL-terminate the in-progress buffer token at the operator's
      // position (safe: the operator's own argv_buf entry will point at
      // rodata below, never at this buffer byte) but do NOT advance the
      // cursor — tk_rd_gt_check/tk_rd_lt re-inspect cursor+1 to detect a
      // doubled '>' and then consume the operator's own byte(s).
      tk_rd_in_gt:
        xor rcx, rcx;
        mov_b [r8], rcx;
        jmp tk_rd_gt_check;

      tk_rd_in_lt:
        xor rcx, rcx;
        mov_b [r8], rcx;
        jmp tk_rd_lt;

      // R58.M5-001 (#1805): '>' seen at skip_ws (fresh operator, nothing
      // to terminate) or reached via tk_rd_in_gt (previous token just
      // NUL-terminated in place). Peek cursor+1 for a second '>' to decide
      // between the single- and double-char operator, without disturbing
      // cursor+1's byte (needed for the double case's own token content —
      // moot here since both point at rodata, but consistent with the
      // "don't touch anything but what you own" discipline elsewhere in
      // this loop).
      tk_rd_gt_check:
        cmp r10, 16;             // argv full guard (mirrors skip_ws's own check)
        jge done;
        mov rcx, r8;
        add rcx, 1;              // rcx = candidate second '>' position
        cmp rcx, r9;             // out of bounds (end of buffer)?
        jge tk_rd_gt_single;
        xor rax, rax;
        mov_b rax, [rcx];
        cmp rax, 0x3E;
        je tk_rd_gt_double;

      tk_rd_gt_single:
        lea r11, [rip + argv_buf];
        lea rax, [rip + redirect_gt];
        mov [r11 + r10*8], rax;  // argv_buf[argc] = &redirect_gt (">")
        add r10, 1;              // argc++
        add r8, 1;               // consume the single '>' byte
        jmp skip_ws;

      tk_rd_gt_double:
        lea r11, [rip + argv_buf];
        lea rax, [rip + redirect_gtgt];
        mov [r11 + r10*8], rax;  // argv_buf[argc] = &redirect_gtgt (">>")
        add r10, 1;              // argc++
        add r8, 2;               // consume both '>' bytes
        jmp skip_ws;

      tk_rd_lt:
        cmp r10, 16;             // argv full guard
        jge done;
        lea r11, [rip + argv_buf];
        lea rax, [rip + redirect_lt];
        mov [r11 + r10*8], rax;  // argv_buf[argc] = &redirect_lt ("<")
        add r10, 1;              // argc++
        add r8, 1;               // consume the '<' byte
        jmp skip_ws;

      done:
        lea r11, [rip + argc];  // r11 = &argc
        mov [r11], r10;         // argc = r10 (store count)
        mov rax, r10;           // rax = r10 (return count)
        ret
      }
    }
}
