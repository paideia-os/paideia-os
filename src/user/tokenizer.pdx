// src/user/tokenizer.pdx — R17-M3-003 (#623) + R58.M5-001 (#1805) + R106.M4-USER (#2342) + WAVE-17 (#2457)
// Shell tokenizer: in-place null-terminate on whitespace runs, build argv[17] pointers to tokens.
// Acceptance: builds; disassembly contains argv_buf, argc, cmp against whitespace bytes, indexed stores.
// See design/kernel/r17-m3-003-shell-tokenizer.md and design/user/shell-io-redirection.md.
//
// R58.M5-001 (#1805): '>', '>>', '<' are now hard delimiters, exactly like
// whitespace — they end whatever token is being scanned, and become their
// own token in argv_buf. Unlike ordinary tokens, a redirect token's
// argv_buf slot does NOT point into the line buffer: it points at one of
// the three rodata constants below (redirect_gt / redirect_gtgt /
// redirect_lt). This sidesteps the in-place NUL-termination problem an
// operator adjacent to its filename would otherwise create (e.g. ">file"
// has no spare byte between '>' and 'f' to write a terminating NUL into),
// and lets exec_child (dispatch.pdx) recognize operators via strlen+memcmp
// against those same constants.
//
// -----------------------------------------------------------------------------
// R106.M4-USER (paideia-os #2342): TOK_TILDE_ALIAS
// -----------------------------------------------------------------------------
//
// A leading '~' at a token START position (never mid-token -- unlike the
// '>'/'>>'/'<' redirect class above, which IS recognized mid-token) now
// scans the following identifier run (ASCII '0'-'9'/'A'-'Z'/'a'-'z'/'_')
// as an alias name and emits its own token kind, TOK_TILDE_ALIAS, instead
// of an ordinary raw-text token. Bare '~' (no name -- immediately
// followed by whitespace, a redirect operator, or end-of-line) is still
// TOK_TILDE_ALIAS, with an empty-string payload.
//
// Token-kind tagging is new to this file: argv_types[i] parallels
// argv_buf[i] and holds TOK_WORD (0 -- the default, covering both
// ordinary tokens and the pre-existing redirect-operator tokens) or
// TOK_TILDE_ALIAS (1). Every token-producing path -- the ordinary
// "token start" fallthrough (now tk_cook_start), tk_rd_gt_single,
// tk_rd_gt_double, tk_rd_lt, and the new tk_tilde_start -- writes its
// argv_types slot explicitly; relying on argv_types' .bss zero-fill
// alone would leak a stale TOK_TILDE_ALIAS tag across separate
// tokenize() calls (separate shell lines) at whichever argv index a
// tilde-alias token last occupied.
//
// argv_buf's entry for a TOK_TILDE_ALIAS token points at the alias name
// substring -- the byte(s) after '~', NUL-terminated in place exactly
// like an ordinary token -- NOT at the '~' character itself, and NOT at
// rodata (unlike the redirect class). If a non-identifier, non-delimiter
// byte follows the name run (e.g. the '/' in "~docs/foo"), the name
// capture ends there without consuming that byte, and the byte is left
// for skip_ws to pick back up as the start of a brand-new ordinary
// token -- i.e. "~docs/foo" tokenizes today as TOK_TILDE_ALIAS "docs"
// followed by TOK_WORD "/foo", not a single composed path. Real
// same-token path composition is dispatch-time work, tracked with the
// resolver below.
//
// Resolution -- '~' -> $HOME, '~docs' -> $HOME/docs, '~alice' -> an
// alias-table lookup -- is itself a dispatch-time concern. The stub
// tokenizer_resolve_alias below only distinguishes "empty name" (returns
// HOME_MARKER) from "any other name" (returns E_ALIAS_UNRESOLVED). Real
// resolution (walking envp for HOME, consulting a KIND_USER_ALIAS
// registry) lands through dispatch.pdx once #2231 / R108.M4 are ready --
// see design/roadmap/persistent-home-wave.md R106.M4 and R108.M4.
//
// FAILURE TAXONOMY 0xFFFFE930..0xFFFFE93F (pre-assigned to this task).
// Only TTA_ALIAS_UNRESOLVED (== E_ALIAS_UNRESOLVED) is reachable today;
// the rest are reserved for follow-up landings (a name-length cap, an
// argv-overflow-mid-scan guard, a defensive dense-payload refusal, and
// an uninitialized-resolver guard) so none of them has to re-open this
// band later.
//
// -----------------------------------------------------------------------------
// WAVE-17 (paideia-os/paideia-os #2457): quoting, backslash escape, $VAR expansion
// -----------------------------------------------------------------------------
//
// Ordinary word tokens now flow through a small state-machine "cooker"
// (labels tk_cook_*) that stages each token's cooked bytes into a
// separate .bss buffer (`tokenizer_arg_buf`) instead of NUL-terminating
// in-place against the source line. argv_buf[i] for a cooked WORD token
// points into this staging buffer; argv_buf[i] for a redirect operator
// still points at rodata (redirect_gt/gtgt/lt); argv_buf[i] for a
// TOK_TILDE_ALIAS still points into line_buf (the tilde flow does not
// need cooking -- '~' is only recognized at token START and its name
// scan admits identifier bytes only, none of which are quote/escape/$).
// The consumer contract is preserved: every argv_buf[i] is a
// NUL-terminated C-string pointer, and consumers must not read past
// argc for either argv_buf or argv_types.
//
// The four cooker features:
//
//   * Single quotes '...'  --  bytes strictly literal, no escapes, no
//     $VAR expansion. Terminated by the next 0x27. An unterminated
//     single quote (end-of-line before the closer) closes the token
//     gracefully at end-of-input (no error sentinel -- the tokenizer's
//     existing contract has no error return, only argc). Ports the
//     satellite tokenizer's tk_single_loop shape (see
//     tools/user/shell/src/tokenizer.pdx).
//
//   * Double quotes "..."  --  bytes literal except:
//         \"  -> emits a literal double-quote
//         \\  -> emits a literal backslash
//         \$  -> emits a literal dollar sign (suppresses expansion)
//       Any other `\<X>` inside "..." emits '\' verbatim followed by
//       <X> processed as normal (matches sh(1)'s "limited escapes in
//       double quotes" rule). $VAR expansion IS active inside "...".
//
//   * Bare backslash \<X>  --  in NORMAL state, '\' consumes the next
//     byte literally (so `foo\ bar` is one token `foo bar`, and
//     `foo\"bar` is one token `foo"bar`). A trailing '\' at end-of-
//     input closes the token gracefully.
//
//   * $VAR expansion       --  in NORMAL and DQUOTE, '$' followed by
//     one-or-more of [A-Z][a-z][0-9]_ scans the variable name, then
//     appends the value bytes (0-terminated in envp, so a strlen-shape
//     walk emits until NUL). A bare '$' with no name run (e.g. '$/'
//     or '$$') emits '$' literally and does not consume anything past
//     the '$'. An unknown name (no envp match) expands to the empty
//     string. envp is read from dispatch.pdx's `envp_slot` .bss slot,
//     populated by shell._start once at boot; if envp is NULL, every
//     lookup misses and every $VAR expands to empty.
//
// State machine (three-state, no explicit state register -- the state
// is the current label group, satellite-port shape):
//
//   NORMAL   whitespace/NUL/EOL/'>'/'<' close the token; '\'' opens
//            SQUOTE; '"' opens DQUOTE; '\' opens AFTER_BACKSLASH (one-
//            shot); '$' triggers name-scan + expansion; else emit byte.
//   SQUOTE   '\'' closes back to NORMAL; else emit byte literally.
//   DQUOTE   '"' closes back to NORMAL; '\' handled inline (see rules
//            above); '$' triggers expansion; else emit byte literally.
//
// New rodata / .bss (this wave):
//   tokenizer_arg_buf  [u8; 4096]  .bss   cooked-token staging area
//   tokenizer_empty_str [u8; 1]    rodata "\0" (fallback for unset $VAR
//                                          callers that want a pointer;
//                                          the cooker itself just skips
//                                          appending, no marker needed)
//   tokenizer_wave17_meta   rodata           fingerprint tag for this wave
//
// New helper:
//   tokenizer_find_env(envp: u64, name_ptr: u64, name_len: u64) -> u64
//     Generic env-scanner modeled on dispatch_find_path_env. Scans up
//     to 16 envp entries (execve-abi.md hard cap) for one whose bytes
//     [0..name_len) match name_ptr and whose byte [name_len] is '='.
//     Returns pointer past '=' on hit, 0 on miss.
//
// Encoder discipline (paideia-as 0.36+ pitfalls, see MEMORY.md
// pdx_encoder_pitfalls):
//   - Module basename PascalCase 'Tokenizer' (matches file basename).
//   - Reserved-label discipline: every new label tk_cook_* / tfe_*.
//   - No `test rN, rN`; every zero-check uses `cmp reg, 0`.
//   - Every `cmp reg, imm` uses imm <= 0x7F (byte-value compares only).
//   - No 2-op `imul r, imm` (not needed here; all offsets are shl or
//     lea + scale-1).
//   - Byte loads use `xor rax, rax; mov_b rax, [ptr]` (paideia-as #1248).
//   - Byte stores use `mov_b [ptr], rax/rcx` (low-byte extraction).
//   - Fingerprint tag size = strlen + 1 (exact).
//   - No multi-line `pub let ... = "..."` continuations.
//   - r11 used only as `lea r11, [rip + <sym>]` LEA scratch (freely
//     clobbered inside tokenize's body, mirrors the existing file's
//     pre-wave usage).

module Tokenizer = structure {
  pub let argv_buf : [u64; 17] = uninit @align(8)  // +1 slot reserved for execve NULL terminator (used by exec_child in dispatch.pdx)
  pub let argc : u64 = uninit @align(8)

  // R58.M5-001 (#1805): redirect operator rodata. argv_buf entries for a
  // redirect token point here (not into the line buffer) — see header note.
  pub let redirect_gt : [u8; 2] = ">\0"
  pub let redirect_gt_len : u64 = 1
  pub let redirect_gtgt : [u8; 3] = ">>\0"
  pub let redirect_gtgt_len : u64 = 2
  pub let redirect_lt : [u8; 2] = "<\0"
  pub let redirect_lt_len : u64 = 1

  // R106.M4-USER (#2342): token-kind tags. See module header note above
  // for the full argv_types design.
  pub let TOK_WORD         : u64 = 0   // ordinary raw-text token OR redirect-operator token (default; matches argv_types' .bss zero-fill, but every token-producing path writes it explicitly -- see header note)
  pub let TOK_TILDE_ALIAS  : u64 = 1   // '~' or '~<name>' token; argv_buf's entry points at the NUL-terminated name substring (empty for bare '~')

  // argv_types[i] tags argv_buf[i]'s token kind (TOK_WORD / TOK_TILDE_ALIAS).
  // Parallel array to argv_buf: same argc bound, same per-call lifetime.
  // Indices >= argc are stale from a prior tokenize() call, exactly like
  // argv_buf's own tail -- consumers must never read past argc for
  // either array.
  pub let argv_types : [u64; 17] = uninit @align(8)

  // Sentinel tokenizer_resolve_alias returns for a bare '~' (empty
  // name): "the alias is the home directory itself". Not a pointer and
  // not a member of the 0xFFFFE930..93F failure band below --
  // dispatch.pdx (#2231) is expected to special-case this value into an
  // actual $HOME substitution once it consumes argv_types/argv_buf
  // together. 'HOME' ASCII, MSB-first (matches DHCP_XID_SENTINEL's
  // 'PAID'-style tag convention -- src/kernel/core/net/dhcp.pdx).
  pub let HOME_MARKER : u64 = 0x484F4D45

  // FAILURE TAXONOMY 0xFFFFE930..0xFFFFE93F (pre-assigned, R106.M4-USER
  // task brief). Only TTA_ALIAS_UNRESOLVED is wired today (returned by
  // tokenizer_resolve_alias below); the rest are reserved so a future
  // landing (name-length cap, argv-overflow mid tilde-alias scan, a
  // defensive dense-payload refusal, an uninitialized-resolver guard)
  // can claim a code without reopening this band.
  pub let TTA_NULL             : u64 = 0xFFFFE93F   // reserved: name_ptr == 0 with name_len != 0 (defensive; unreachable from tokenize() today)
  pub let TTA_NAME_TOO_LONG    : u64 = 0xFFFFE93E   // reserved: alias name exceeds a future max-length cap
  pub let TTA_ALIAS_UNRESOLVED : u64 = 0xFFFFE93D   // alias name has no known mapping; == E_ALIAS_UNRESOLVED below
  pub let TTA_TOKEN_OVERFLOW   : u64 = 0xFFFFE93C   // reserved: argv full mid tilde-alias scan
  pub let TTA_REFUSED_DENSE    : u64 = 0xFFFFE93B   // reserved: defensive refusal for a maliciously dense/packed alias payload
  pub let TTA_NOT_INIT         : u64 = 0xFFFFE93A   // reserved: resolver invoked before tokenizer state is initialized
  // 0xFFFFE930..0xFFFFE939 reserved for future TTA_* codes.

  // Exported under the task-brief's own name; same value as
  // TTA_ALIAS_UNRESOLVED above (duplicated literal rather than a
  // cross-reference -- this file's convention for related sentinels,
  // see e.g. net/dhcp.pdx's DHCP_XID_SENTINEL comment cross-references).
  pub let E_ALIAS_UNRESOLVED : u64 = 0xFFFFE93D

  // WAVE-17 (#2457): cooked-token staging area. Each cooked WORD token
  // is copied byte-by-byte into this .bss buffer (with quotes stripped,
  // backslash escapes applied, and $VAR expansions substituted), then
  // NUL-terminated; argv_buf[i] for that token points into this buffer
  // at the token's start offset. Reset (write cursor = 0) at every
  // tokenize() call entry so a fresh line does not inherit the prior
  // line's cook cursor. Sized generously (4096 bytes) to fit a 255-byte
  // source line whose $VARs blow up to a full colon-separated PATH per
  // expansion; a token whose cooked bytes would exceed the buffer stops
  // the tokenizer gracefully (returns whatever argc is at that point,
  // matching the existing argv-full and NUL-early-terminator degradation
  // paths in tokenize()'s original R17-M3-003 body).
  pub let tokenizer_arg_buf : [u8; 4096] = uninit @align(8)

  // WAVE-17 (#2457): fallback rodata for an unset $VAR. The cooker
  // itself skips appending on a miss (empty-string expansion, matches
  // sh(1)), so this string is not consulted on the hot cooker path --
  // it is exposed for future consumers that want a NUL pointer sentinel
  // instead of "did nothing" and for parity with the redirect_* /
  // path_env_key literal-rodata pattern the rest of this codebase uses.
  pub let tokenizer_empty_str : [u8; 1] = "\0"

  // WAVE-17 (#2457): call-spill slots for the two `call tokenizer_find_env`
  // sites inside tokenize(). tokenizer_find_env clobbers r8/r9/r10/r11
  // (all caller-save in SysV) but tokenize's cook path pins r8 = cursor,
  // r9 = line end, r10 = argc (r11 is LEA scratch, re-LEA'd on demand).
  // A .bss spill is preferred to a stack push/pop pair for two reasons:
  //   1. No 16-byte alignment dance (each push shifts rsp by 8, three
  //      pushes leaves rsp % 16 == 8 at the call site which is wrong;
  //      four pushes need a dummy value that must not collide with the
  //      call's return value).
  //   2. Single-threaded single-tokenize-call reentry guarantee holds
  //      by construction -- tokenize is called once per shell line by
  //      shell.pdx's main_loop, no signal handler or interrupt path
  //      re-enters it, so the .bss slots are safe for the duration of
  //      the call.
  // The slot layout is fixed at [0]=r8, [1]=r9, [2]=r10 so the store
  // and reload sites can share the same base LEA.
  pub let tk_spill : [u64; 3] = uninit @align(8)

  // tokenize(buf, byte_count) -> argc (stored in argc slot and returned in rax).
  // WORD tokens are cooked into tokenizer_arg_buf via the tk_cook_*
  // state machine (WAVE-17 quotes/escape/$VAR); redirect operators and
  // tilde-alias tokens retain their pre-wave paths (rodata pointers and
  // line-buf name substrings respectively).
  // Whitespace class: 0x20 (space), 0x09 (tab), 0x0A (newline).
  // Hard-delimiter class (R58.M5-001, #1805): 0x3E ('>', possibly doubled
  // into ">>"), 0x3C ('<'). Each becomes its own argv_buf token (pointing
  // at rodata, not the line buffer) — see module header note.
  // NUL (0x00) treated as early terminator.
  // Stops when: byte_count exhausted, NUL encountered, argv full (16),
  // or tokenizer_arg_buf full.
  pub let tokenize : (u64, u64) -> u64 !{mem} @{} =
    fn (buf: u64) (byte_count: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R17-m3-003 (#623) + R58.M5-001 (#1805) + R106.M4-USER (#2342) + WAVE-17 (#2457): shell tokenizer with quoting, backslash escape, and $VAR expansion. Enters skip_ws which dispatches on the first byte of a fresh token: whitespace consumes; '>' or '<' enter the redirect-operator paths (tk_rd_gt_check / tk_rd_lt) whose argv_buf slot points at the redirect_gt/redirect_gtgt/redirect_lt rodata constants (unchanged from R58.M5-001); '~' enters tk_tilde_start whose argv_buf slot points at the identifier substring inside line_buf (unchanged from R106.M4-USER); any other byte enters tk_cook_start (WAVE-17), the cooked-word path. tk_cook_start pins argv_buf[argc] to &tokenizer_arg_buf[write_cursor] (r12) then falls into tk_cook_normal, a three-state (NORMAL / SQUOTE / DQUOTE, satellite-port shape from tools/user/shell/src/tokenizer.pdx) byte walker: NORMAL closes on whitespace/NUL/EOL/'>'/'<' and dispatches quotes/backslash/$; SQUOTE closes on 0x27 and copies every other byte literally (no escapes, no $ expansion); DQUOTE closes on 0x22 and honors \\\", \\\\, \\$ escapes with $VAR expansion active. tk_cook_dollar / tk_cook_dq_dollar scan an alnum+underscore name run past the '$' then call tokenizer_find_env(envp_slot, name_ptr, name_len); on hit, copies value bytes until NUL into arg_buf; on miss or bare '$' with empty name run, emits '$' literally (bare '$') or nothing (unknown name). Byte emit inlines as `lea r11,[rip+tokenizer_arg_buf]; mov_b [r11+r12*1], rax; add r12,1` with an overflow guard (`cmp r12, 4096; jae tk_done`) so buffer exhaustion degrades to whatever argc has been emitted so far, mirroring the argv-full graceful degradation. Register plan: r8 = line_buf cursor, r9 = line_buf end (buf + byte_count), r10 = argc, r11 = LEA scratch (cross-call clobbers OK), r12 = arg_buf write cursor (callee-save; pushed once at entry, popped once at every ret path). r14/r15 unused. tokenizer_find_env is a leaf call touching only caller-save regs so r12 survives it without spilling. Envp base loaded fresh from [rip + envp_slot] (Dispatch's .bss export) at every $ dispatch -- avoids caching state across a potentially arbitrarily-long line. paideia-as #1248: every byte load uses `xor rax, rax; mov_b rax, [ptr]` (also `xor rdx, rdx; mov_b rdx, [ptr]` for the double-'>' peek and the escape-next peek). Every zero-check is `cmp reg, 0` (never `test rN,rN`). Every cmp reg, imm uses imm <= 0x7F (byte value compares only; the arg_buf cap of 4096 is compared against r12 using `mov rax, 4096; cmp r12, rax` to keep the imm side <= 0x7F -- but 4096 = 0x1000 fits in imm32 so a direct `cmp r12, 4096` also works; we use the direct form since imm32 is not the pitfall class -- the paideia-as pitfall is `and r11, imm64`, not `cmp r,imm32`). No 2-op `imul r, imm`. Reserved-label discipline: all new labels tk_cook_-prefixed for the cooker and tfe_-prefixed for the env helper.",
      block: {
        // Callee-save: r12 = arg_buf write cursor. Push one register
        // so rsp goes from %16==8 (call site) to %16==0, which is the
        // aligned state a nested `call tokenizer_find_env` requires.
        push r12;

        mov r8, rdi;            // r8 = cursor = buf
        mov r9, rdi;            // r9 = end = buf
        add r9, rsi;            // r9 = buf + byte_count
        xor r10, r10;           // r10 = argc = 0
        xor r12, r12;           // r12 = arg_buf write cursor = 0

      skip_ws:
        cmp r8, r9;             // if cursor >= end: done
        jge done;
        cmp r10, 16;            // if argc >= 16: done (argv full)
        jge done;

        xor rax, rax;           // clear rax before narrow load (paideia-as #1248 mitigation)
        mov_b rax, [r8];        // rax = [cursor] (byte load, zero-extended)
        cmp rax, 0;             // if byte == NUL: done (early terminator)
        je done;

        cmp rax, 0x20;          // if byte == space: consume_ws
        je consume_ws;
        cmp rax, 0x09;          // if byte == tab: consume_ws
        je consume_ws;
        cmp rax, 0x0A;          // if byte == newline: consume_ws
        je consume_ws;

        cmp rax, 0x3E;          // if byte == '>': redirect operator (R58.M5-001, #1805)
        je tk_rd_gt_check;
        cmp rax, 0x3C;          // if byte == '<': redirect operator (R58.M5-001, #1805)
        je tk_rd_lt;

        cmp rax, 0x7E;          // if byte == '~': tilde-alias token start (R106.M4-USER, #2342)
        je tk_tilde_start;

        // WAVE-17: every other byte starts a cooked WORD token.
        jmp tk_cook_start;

      consume_ws:
        add r8, 1;              // cursor++
        jmp skip_ws;             // check next byte

      // -----------------------------------------------------------------
      // R58.M5-001 (#1805): mid-token redirect operator (e.g. "file>out").
      // The cooker (tk_cook_normal) reaches these labels on '>'/'<' seen
      // inside a cooked word: it has already finalized the current token
      // (NUL-write + argc++) before jumping here without advancing r8, so
      // tk_rd_gt_check / tk_rd_lt re-inspect cursor+1 (for the double '>'
      // case) and consume the operator's own byte(s). No line_buf write
      // needed -- unlike the pre-WAVE-17 path, the current token's bytes
      // live in tokenizer_arg_buf, not at [r8], so [r8] is untouched.
      // -----------------------------------------------------------------

      // R58.M5-001 (#1805): '>' seen at skip_ws (fresh operator, nothing
      // to terminate) or reached via tk_cook_normal's '>' branch (previous
      // token already finalized in arg_buf).  Peek cursor+1 for a second
      // '>' to decide between single- and double-char operator.
      tk_rd_gt_check:
        cmp r10, 16;             // argv full guard (mirrors skip_ws's own check)
        jge done;
        mov rcx, r8;
        add rcx, 1;              // rcx = candidate second '>' position
        cmp rcx, r9;             // out of bounds (end of buffer)?
        jge tk_rd_gt_single;
        xor rax, rax;
        mov_b rax, [rcx];
        cmp rax, 0x3E;
        je tk_rd_gt_double;

      tk_rd_gt_single:
        lea r11, [rip + argv_types];
        mov [r11 + r10*8], 0;    // argv_types[argc] = TOK_WORD (0); redirect operators are TOK_WORD too (R106.M4-USER, #2342)
        lea r11, [rip + argv_buf];
        lea rax, [rip + redirect_gt];
        mov [r11 + r10*8], rax;  // argv_buf[argc] = &redirect_gt (">")
        add r10, 1;              // argc++
        add r8, 1;               // consume the single '>' byte
        jmp skip_ws;

      tk_rd_gt_double:
        lea r11, [rip + argv_types];
        mov [r11 + r10*8], 0;    // argv_types[argc] = TOK_WORD (0) (R106.M4-USER, #2342)
        lea r11, [rip + argv_buf];
        lea rax, [rip + redirect_gtgt];
        mov [r11 + r10*8], rax;  // argv_buf[argc] = &redirect_gtgt (">>")
        add r10, 1;              // argc++
        add r8, 2;               // consume both '>' bytes
        jmp skip_ws;

      tk_rd_lt:
        cmp r10, 16;             // argv full guard
        jge done;
        lea r11, [rip + argv_types];
        mov [r11 + r10*8], 0;    // argv_types[argc] = TOK_WORD (0) (R106.M4-USER, #2342)
        lea r11, [rip + argv_buf];
        lea rax, [rip + redirect_lt];
        mov [r11 + r10*8], rax;  // argv_buf[argc] = &redirect_lt ("<")
        add r10, 1;              // argc++
        add r8, 1;               // consume the '<' byte
        jmp skip_ws;

      // -----------------------------------------------------------------
      // R106.M4-USER (#2342): tilde-alias token. Entered only from
      // skip_ws (never from the cooker -- '~' mid-token is ordinary text
      // in the cooker), so argc < 16 is already guaranteed by skip_ws's
      // own guard.  The name substring lives in line_buf (in-place
      // NUL-terminate on the boundary byte), matching pre-WAVE-17
      // behavior; only cooked WORD tokens use tokenizer_arg_buf.
      // -----------------------------------------------------------------
      tk_tilde_start:
        lea r11, [rip + argv_types];
        mov [r11 + r10*8], 1;    // argv_types[argc] = TOK_TILDE_ALIAS (1)
        lea r11, [rip + argv_buf];
        lea rax, [r8 + 1];       // name starts one byte past '~' (empty string if that byte is itself a delimiter)
        mov [r11 + r10*8], rax;  // argv_buf[argc] = &name
        add r10, 1;              // argc++
        add r8, 1;               // cursor++ (consume the '~' byte itself)
        jmp tk_tilde_scan;

      // Scans the alias-name identifier run byte by byte. Delimiter
      // classes (whitespace, redirect operators, NUL, end-of-buffer)
      // are handled by tk_tilde_ws_end (identical NUL+advance shape to
      // the pre-WAVE-17 terminate_token label, kept here inline) or
      // by tk_tilde_boundary; a non-identifier/non-delimiter byte ends
      // the name in place without consuming it.
      tk_tilde_scan:
        cmp r8, r9;             // if cursor >= end: done
        jge done;

        xor rax, rax;           // clear rax before narrow load (paideia-as #1248 mitigation)
        mov_b rax, [r8];        // rax = [cursor]
        cmp rax, 0;             // if byte == NUL: done
        je done;

        cmp rax, 0x20;          // if byte == space: terminate the name in-place
        je tk_tilde_ws_end;
        cmp rax, 0x09;          // if byte == tab: terminate the name in-place
        je tk_tilde_ws_end;
        cmp rax, 0x0A;          // if byte == newline: terminate the name in-place
        je tk_tilde_ws_end;

        cmp rax, 0x3E;          // if byte == '>': terminate the name, don't consume the '>'
        je tk_tilde_boundary;
        cmp rax, 0x3C;          // if byte == '<': terminate the name, don't consume the '<'
        je tk_tilde_boundary;

        // Identifier class: '0'-'9' | 'A'-'Z' | 'a'-'z' | '_'.
        cmp rax, 0x30;
        jl tk_tilde_not_digit;
        cmp rax, 0x39;
        jg tk_tilde_not_digit;
        jmp tk_tilde_cont;

      tk_tilde_not_digit:
        cmp rax, 0x41;
        jl tk_tilde_not_upper;
        cmp rax, 0x5A;
        jg tk_tilde_not_upper;
        jmp tk_tilde_cont;

      tk_tilde_not_upper:
        cmp rax, 0x61;
        jl tk_tilde_not_lower;
        cmp rax, 0x7A;
        jg tk_tilde_not_lower;
        jmp tk_tilde_cont;

      tk_tilde_not_lower:
        cmp rax, 0x5F;          // '_'
        je tk_tilde_cont;
        jmp tk_tilde_boundary;  // non-identifier, non-delimiter byte: end the name here

      tk_tilde_cont:
        add r8, 1;              // cursor++
        jmp tk_tilde_scan;

      tk_tilde_ws_end:
        // Whitespace boundary: NUL-terminate the name in place, consume
        // the whitespace byte, resume skip_ws (which will discard any
        // further whitespace before the next token).
        xor rcx, rcx;
        mov_b [r8], rcx;
        add r8, 1;
        jmp skip_ws;

      tk_tilde_boundary:
        xor rcx, rcx;           // rcx = 0 (value to store)
        mov_b [r8], rcx;        // [cursor] = 0 (NUL-terminate the name; do NOT consume this byte)
        jmp skip_ws;            // resume scanning; boundary byte starts a fresh token

      // -----------------------------------------------------------------
      // WAVE-17 (#2457): cooked WORD token entry point.
      //
      // Pins argv_types[argc] = TOK_WORD, argv_buf[argc] = &arg_buf[r12]
      // (the cooked-token start), then falls into tk_cook_normal.
      // -----------------------------------------------------------------
      tk_cook_start:
        // Bail if the arg_buf can't hold at least one byte + NUL.
        cmp r12, 4095;
        jae done;

        lea r11, [rip + argv_types];
        mov [r11 + r10*8], 0;    // argv_types[argc] = TOK_WORD
        lea r11, [rip + tokenizer_arg_buf];
        add r11, r12;
        lea rcx, [rip + argv_buf];
        mov [rcx + r10*8], r11;  // argv_buf[argc] = &tokenizer_arg_buf[write_cursor]

        // Fall through to the NORMAL-state loop. argc is NOT incremented
        // yet -- tk_cook_finalize does that once the token closes, so a
        // token that terminates immediately (e.g. `""` -> empty string)
        // still produces one argv slot with a NUL byte and argc bumped.

      // NORMAL state. Reads at [r8], dispatches per byte class.
      tk_cook_normal:
        cmp r8, r9;              // end-of-buffer closes the token
        jge tk_cook_finalize;

        xor rax, rax;
        mov_b rax, [r8];
        cmp rax, 0;              // NUL early terminator closes the token
        je tk_cook_finalize;

        cmp rax, 0x20;           // whitespace closes the token (space)
        je tk_cook_finalize_and_consume;
        cmp rax, 0x09;           // whitespace closes the token (tab)
        je tk_cook_finalize_and_consume;
        cmp rax, 0x0A;           // whitespace closes the token (newline)
        je tk_cook_finalize_and_consume;

        cmp rax, 0x3E;           // '>' closes the token, does NOT consume (redirect path re-inspects it)
        je tk_cook_finalize_gt;
        cmp rax, 0x3C;           // '<' closes the token, does NOT consume (redirect path re-inspects it)
        je tk_cook_finalize_lt;

        cmp rax, 0x27;           // '\'' opens SQUOTE
        je tk_cook_sq_open;
        cmp rax, 0x22;           // '"' opens DQUOTE
        je tk_cook_dq_open;
        cmp rax, 0x5C;           // '\' bare backslash: consume + copy next byte literally
        je tk_cook_bs;
        cmp rax, 0x24;           // '$' triggers VAR expansion in NORMAL
        je tk_cook_dollar;

        // Ordinary byte: emit + advance + loop.
        cmp r12, 4095;           // reserve 1 byte for the final NUL
        jae done;
        lea r11, [rip + tokenizer_arg_buf];
        mov_b [r11 + r12*1], rax;
        add r12, 1;
        add r8, 1;
        jmp tk_cook_normal;

      // Bare backslash in NORMAL: consume the '\' and copy the next
      // byte literally (or close the token gracefully if '\' is the
      // last byte).
      tk_cook_bs:
        add r8, 1;               // consume '\'
        cmp r8, r9;
        jge tk_cook_finalize;
        xor rax, rax;
        mov_b rax, [r8];
        cmp rax, 0;
        je tk_cook_finalize;
        cmp r12, 4095;
        jae done;
        lea r11, [rip + tokenizer_arg_buf];
        mov_b [r11 + r12*1], rax;
        add r12, 1;
        add r8, 1;
        jmp tk_cook_normal;

      // SQUOTE state: bytes literal until the next 0x27. No escapes,
      // no $ expansion. An end-of-buffer inside '..' closes the token
      // gracefully (returns whatever argc has been built).
      tk_cook_sq_open:
        add r8, 1;               // consume opening '
      tk_cook_sq_loop:
        cmp r8, r9;
        jge tk_cook_finalize;
        xor rax, rax;
        mov_b rax, [r8];
        cmp rax, 0;              // NUL inside '..' closes the token
        je tk_cook_finalize;
        cmp rax, 0x27;           // closing '
        je tk_cook_sq_close;
        cmp r12, 4095;
        jae done;
        lea r11, [rip + tokenizer_arg_buf];
        mov_b [r11 + r12*1], rax;
        add r12, 1;
        add r8, 1;
        jmp tk_cook_sq_loop;
      tk_cook_sq_close:
        add r8, 1;               // consume closing '
        jmp tk_cook_normal;

      // DQUOTE state: bytes literal until the next 0x22, with limited
      // escapes for \" \\ \$ and $VAR expansion active.
      tk_cook_dq_open:
        add r8, 1;               // consume opening "
      tk_cook_dq_loop:
        cmp r8, r9;
        jge tk_cook_finalize;
        xor rax, rax;
        mov_b rax, [r8];
        cmp rax, 0;              // NUL inside ".." closes the token
        je tk_cook_finalize;
        cmp rax, 0x22;           // closing "
        je tk_cook_dq_close;
        cmp rax, 0x5C;           // '\' in DQUOTE: limited escape
        je tk_cook_dq_bs;
        cmp rax, 0x24;           // '$' in DQUOTE: expand
        je tk_cook_dq_dollar;
        cmp r12, 4095;
        jae done;
        lea r11, [rip + tokenizer_arg_buf];
        mov_b [r11 + r12*1], rax;
        add r12, 1;
        add r8, 1;
        jmp tk_cook_dq_loop;
      tk_cook_dq_close:
        add r8, 1;               // consume closing "
        jmp tk_cook_normal;

      // DQUOTE backslash: only \" \\ \$ are cooked. Any other \<X>
      // emits '\' verbatim followed by <X> processed via the normal
      // DQUOTE loop (so \n stays as `\n`, matching sh(1)'s limited-
      // escape rule).
      tk_cook_dq_bs:
        add r8, 1;               // consume '\'
        cmp r8, r9;              // trailing '\' at EOL: close the token
        jge tk_cook_finalize;
        xor rdx, rdx;            // rdx = peek byte (rax reserved for emit)
        mov_b rdx, [r8];
        cmp rdx, 0;              // '\' followed by NUL: close the token
        je tk_cook_finalize;
        cmp rdx, 0x22;
        je tk_cook_dq_esc_emit;
        cmp rdx, 0x5C;
        je tk_cook_dq_esc_emit;
        cmp rdx, 0x24;
        je tk_cook_dq_esc_emit;

        // Not a recognized escape: emit '\' literally, leave cursor at
        // the peeked byte (do NOT consume it) so tk_cook_dq_loop picks
        // it up as an ordinary DQUOTE byte on the next iteration.
        cmp r12, 4095;
        jae done;
        lea r11, [rip + tokenizer_arg_buf];
        mov rax, 0x5C;           // '\'
        mov_b [r11 + r12*1], rax;
        add r12, 1;
        jmp tk_cook_dq_loop;

      tk_cook_dq_esc_emit:
        // Emit the escaped byte (rdx = peek byte), consume it.
        cmp r12, 4095;
        jae done;
        lea r11, [rip + tokenizer_arg_buf];
        mov_b [r11 + r12*1], rdx;
        add r12, 1;
        add r8, 1;
        jmp tk_cook_dq_loop;

      // $VAR expansion in NORMAL. Consumes the '$', scans an identifier
      // run (alnum + underscore), looks up via tokenizer_find_env, and
      // appends value bytes into arg_buf. Returns to tk_cook_normal.
      tk_cook_dollar:
        add r8, 1;               // consume '$'
        mov rcx, r8;             // rcx = name_ptr (cursor after '$')
        xor rdx, rdx;            // rdx = name_len
      tk_cook_dollar_scan:
        cmp r8, r9;
        jge tk_cook_dollar_lookup_n;
        xor rax, rax;
        mov_b rax, [r8];
        // digit / upper / lower / underscore.
        cmp rax, 0x30;
        jl tk_cook_dollar_not_digit_n;
        cmp rax, 0x39;
        jg tk_cook_dollar_not_digit_n;
        jmp tk_cook_dollar_step_n;
      tk_cook_dollar_not_digit_n:
        cmp rax, 0x41;
        jl tk_cook_dollar_not_upper_n;
        cmp rax, 0x5A;
        jg tk_cook_dollar_not_upper_n;
        jmp tk_cook_dollar_step_n;
      tk_cook_dollar_not_upper_n:
        cmp rax, 0x61;
        jl tk_cook_dollar_not_lower_n;
        cmp rax, 0x7A;
        jg tk_cook_dollar_not_lower_n;
        jmp tk_cook_dollar_step_n;
      tk_cook_dollar_not_lower_n:
        cmp rax, 0x5F;           // '_'
        je tk_cook_dollar_step_n;
        jmp tk_cook_dollar_lookup_n;
      tk_cook_dollar_step_n:
        add r8, 1;
        add rdx, 1;
        jmp tk_cook_dollar_scan;
      tk_cook_dollar_lookup_n:
        // Empty name run: emit '$' literally, do not call the lookup.
        cmp rdx, 0;
        je tk_cook_dollar_bare_n;
        // Spill r8/r9/r10 (all clobbered by tokenizer_find_env).
        lea r11, [rip + tk_spill];
        mov [r11 + 0], r8;
        mov [r11 + 8], r9;
        mov [r11 + 16], r10;
        // rcx = name_ptr, rdx = name_len; envp base loaded fresh.
        mov rdi, [rip + envp_slot];
        mov rsi, rcx;
        // rdx already holds name_len
        call tokenizer_find_env;
        // Reload r8/r9/r10 from spill (call clobbered them).
        lea r11, [rip + tk_spill];
        mov r8, [r11 + 0];
        mov r9, [r11 + 8];
        mov r10, [r11 + 16];
        // rax = value_ptr or 0. On miss, emit nothing (empty string).
        cmp rax, 0;
        je tk_cook_normal;
        jmp tk_cook_emit_value_n;
      tk_cook_emit_value_n:
        // Walk value bytes until NUL, appending to arg_buf.
        xor rdx, rdx;            // rdx = value byte scratch
      tk_cook_emit_value_n_loop:
        mov_b rdx, [rax];
        cmp rdx, 0;
        je tk_cook_normal;
        cmp r12, 4095;
        jae done;
        lea r11, [rip + tokenizer_arg_buf];
        mov_b [r11 + r12*1], rdx;
        add r12, 1;
        add rax, 1;
        xor rdx, rdx;
        jmp tk_cook_emit_value_n_loop;
      tk_cook_dollar_bare_n:
        // Bare '$' (no name run): emit '$' literally, r8 already past '$'.
        cmp r12, 4095;
        jae done;
        lea r11, [rip + tokenizer_arg_buf];
        mov rax, 0x24;
        mov_b [r11 + r12*1], rax;
        add r12, 1;
        jmp tk_cook_normal;

      // $VAR expansion in DQUOTE. Same shape as tk_cook_dollar but
      // returns to tk_cook_dq_loop instead of tk_cook_normal.
      tk_cook_dq_dollar:
        add r8, 1;               // consume '$'
        mov rcx, r8;
        xor rdx, rdx;
      tk_cook_dq_dollar_scan:
        cmp r8, r9;
        jge tk_cook_dq_dollar_lookup;
        xor rax, rax;
        mov_b rax, [r8];
        cmp rax, 0x30;
        jl tk_cook_dq_dollar_not_digit;
        cmp rax, 0x39;
        jg tk_cook_dq_dollar_not_digit;
        jmp tk_cook_dq_dollar_step;
      tk_cook_dq_dollar_not_digit:
        cmp rax, 0x41;
        jl tk_cook_dq_dollar_not_upper;
        cmp rax, 0x5A;
        jg tk_cook_dq_dollar_not_upper;
        jmp tk_cook_dq_dollar_step;
      tk_cook_dq_dollar_not_upper:
        cmp rax, 0x61;
        jl tk_cook_dq_dollar_not_lower;
        cmp rax, 0x7A;
        jg tk_cook_dq_dollar_not_lower;
        jmp tk_cook_dq_dollar_step;
      tk_cook_dq_dollar_not_lower:
        cmp rax, 0x5F;
        je tk_cook_dq_dollar_step;
        jmp tk_cook_dq_dollar_lookup;
      tk_cook_dq_dollar_step:
        add r8, 1;
        add rdx, 1;
        jmp tk_cook_dq_dollar_scan;
      tk_cook_dq_dollar_lookup:
        cmp rdx, 0;
        je tk_cook_dq_dollar_bare;
        // Spill r8/r9/r10 (all clobbered by tokenizer_find_env).
        lea r11, [rip + tk_spill];
        mov [r11 + 0], r8;
        mov [r11 + 8], r9;
        mov [r11 + 16], r10;
        mov rdi, [rip + envp_slot];
        mov rsi, rcx;
        call tokenizer_find_env;
        // Reload r8/r9/r10 from spill (call clobbered them).
        lea r11, [rip + tk_spill];
        mov r8, [r11 + 0];
        mov r9, [r11 + 8];
        mov r10, [r11 + 16];
        cmp rax, 0;
        je tk_cook_dq_loop;
        jmp tk_cook_dq_emit_value;
      tk_cook_dq_emit_value:
        xor rdx, rdx;
      tk_cook_dq_emit_value_loop:
        mov_b rdx, [rax];
        cmp rdx, 0;
        je tk_cook_dq_loop;
        cmp r12, 4095;
        jae done;
        lea r11, [rip + tokenizer_arg_buf];
        mov_b [r11 + r12*1], rdx;
        add r12, 1;
        add rax, 1;
        xor rdx, rdx;
        jmp tk_cook_dq_emit_value_loop;
      tk_cook_dq_dollar_bare:
        cmp r12, 4095;
        jae done;
        lea r11, [rip + tokenizer_arg_buf];
        mov rax, 0x24;
        mov_b [r11 + r12*1], rax;
        add r12, 1;
        jmp tk_cook_dq_loop;

      // -----------------------------------------------------------------
      // Cook token finalizers. Write NUL to arg_buf, argc++, jump to
      // the appropriate next-state label (skip_ws or a redirect path).
      // -----------------------------------------------------------------

      // Finalize: NUL, argc++. Caller is responsible for advancing r8
      // (or not) and choosing the next-state label.
      tk_cook_finalize:
        cmp r12, 4096;
        jae done;
        lea r11, [rip + tokenizer_arg_buf];
        xor rax, rax;
        mov_b [r11 + r12*1], rax;
        add r12, 1;
        add r10, 1;              // argc++
        jmp skip_ws;

      tk_cook_finalize_and_consume:
        cmp r12, 4096;
        jae done;
        lea r11, [rip + tokenizer_arg_buf];
        xor rax, rax;
        mov_b [r11 + r12*1], rax;
        add r12, 1;
        add r10, 1;
        add r8, 1;               // consume the whitespace byte
        jmp skip_ws;

      tk_cook_finalize_gt:
        cmp r12, 4096;
        jae done;
        lea r11, [rip + tokenizer_arg_buf];
        xor rax, rax;
        mov_b [r11 + r12*1], rax;
        add r12, 1;
        add r10, 1;
        jmp tk_rd_gt_check;      // do NOT consume; let redirect path see the '>'

      tk_cook_finalize_lt:
        cmp r12, 4096;
        jae done;
        lea r11, [rip + tokenizer_arg_buf];
        xor rax, rax;
        mov_b [r11 + r12*1], rax;
        add r12, 1;
        add r10, 1;
        jmp tk_rd_lt;            // do NOT consume; let redirect path see the '<'

      done:
        lea r11, [rip + argc];   // r11 = &argc
        mov [r11], r10;          // argc = r10 (store count)
        mov rax, r10;            // rax = r10 (return count)
        pop r12;                 // restore callee-save
        ret
      }
    }

  // tokenizer_find_env(envp: u64, name_ptr: u64, name_len: u64) -> u64
  //
  // WAVE-17 (#2457): generic env-scanner. Scans up to 16 envp entries
  // (execve-abi.md hard cap, mirrored by shell.pdx's shell_home_scan
  // and dispatch.pdx's dispatch_find_path_env) looking for an entry
  // whose first `name_len` bytes match `name_ptr[0..name_len)` and
  // whose byte at offset `name_len` is '=' (0x3D). On match returns
  // envp[i] + name_len + 1 (pointer past '='); on envp==NULL, name_len
  // ==0, NULL-terminator hit, cap exhausted, or no match, returns 0.
  //
  // Modeled directly on dispatch_find_path_env (#2456): same byte-
  // compare idiom (`xor rax, rax; mov_b rax, [ptr]` per paideia-as
  // #1248), same 16-entry cap, same NULL-envp / NULL-entry shape.
  // Generic-name argument set makes this reusable by anyone who needs
  // an env lookup by name (not just PATH); dispatch_find_path_env
  // stays as a specialised fast-path for the `resolve_path` PATH walk.
  //
  // Register plan (leaf function, no push/pop):
  //   rdi = envp base       -> parked in r10
  //   rsi = name_ptr        -> read directly at loop time
  //   rdx = name_len        -> read directly at loop time
  //   r10 = envp base parked
  //   r11 = scan index i
  //   r9  = envp[i] candidate entry pointer
  //   rcx = j (compare char index inside name)
  //   rax = compare byte scratch (envp side + return value)
  //   r8  = compare byte scratch (name side)
  // Every register used is caller-save in SysV, so no push/pop needed.
  // The function makes no CALL/SYSCALL, so rsp stays %16==8 throughout.
  pub let tokenizer_find_env : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (envp: u64) (name_ptr: u64) (name_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "WAVE-17 (paideia-os/paideia-os #2457): tokenizer_find_env(envp, name_ptr, name_len) is a generic envp scanner returning envp[i]+name_len+1 on the first entry whose leading bytes are name_ptr[0..name_len) followed by '='. Modeled on dispatch_find_path_env (#2456): same 16-entry cap (design/user/execve-abi.md), same NULL-envp / NULL-entry / no-match miss path, same paideia-as #1248 mitigation shape (`xor rax, rax; mov_b rax, [ptr]; xor r8, r8; mov_b r8, [ptr]; cmp rax, r8`). Generic-name argument set makes this reusable by every env consumer, not just PATH's specialised dispatch_find_path_env fast-path. Register plan: rdi -> r10 (envp base parked at entry); r11 = scan index; r9 = envp[i]; rcx = compare char index; rax + r8 = byte compare scratch. All caller-save; no push/pop / no CALL / no SYSCALL, so rsp stays %16==8 throughout. Guards: envp==0 -> return 0; name_len==0 -> return 0 (matches sh(1)'s bare-$ non-lookup semantics -- the cooker rejects empty names before this call, so this guard is defensive); envp[i]==0 (NULL terminator) -> return 0. Reserved-label discipline: labels tfe_-prefixed.",
      block: {
        cmp rdi, 0;
        je tfe_miss;
        cmp rdx, 0;
        je tfe_miss;
        mov r10, rdi;                    // r10 = envp base
        xor r11, r11;                    // r11 = i

      tfe_scan:
        cmp r11, 16;                     // execve-abi.md hard cap
        jge tfe_miss;
        mov r9, [r10 + r11*8];           // r9 = envp[i]
        cmp r9, 0;
        je tfe_miss;                     // NULL terminator

        xor rcx, rcx;                    // rcx = j (name char index)

      tfe_cmp:
        cmp rcx, rdx;
        jae tfe_check_eq;
        xor rax, rax;
        mov_b rax, [r9 + rcx*1];
        xor r8, r8;
        mov_b r8, [rsi + rcx*1];
        cmp rax, r8;
        jne tfe_next;
        add rcx, 1;
        jmp tfe_cmp;

      tfe_check_eq:
        // The byte immediately after the name must be '=' (0x3D).
        xor rax, rax;
        mov_b rax, [r9 + rcx*1];
        cmp rax, 0x3D;
        jne tfe_next;
        // Match: return envp[i] + name_len + 1.
        mov rax, r9;
        add rax, rdx;
        add rax, 1;
        ret;

      tfe_next:
        add r11, 1;
        jmp tfe_scan;

      tfe_miss:
        xor rax, rax;
        ret
      }
    } @no_frame

  // tokenizer_resolve_alias(name_ptr, name_len) -> u64
  //
  // R106.M4-USER (paideia-os #2342) stub. Two hardcoded cases only:
  //   name_len == 0 (bare '~')       -> HOME_MARKER
  //   name_len != 0 (any other name) -> E_ALIAS_UNRESOLVED
  // name_ptr is accepted -- frozen into the signature dispatch.pdx will
  // call once #2231 wires the dispatch-time path -- but this stub does
  // not read it: distinguishing among non-empty names needs an actual
  // HOME env-var walk / KIND_USER_ALIAS lookup, which is future work
  // (R108.M4). Deliberately effects{}/capabilities{} -- this stub
  // touches no memory and no capability.
  pub let tokenizer_resolve_alias : (u64, u64) -> u64 !{} @{} =
    fn (name_ptr: u64) (name_len: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R106.M4-USER (paideia-os #2342): tokenizer_resolve_alias(name_ptr:rdi, name_len:rsi) -> u64 (rax). Stub resolver for TOK_TILDE_ALIAS tokens. Body: cmp rsi, 0; je tra_home -- bare '~' (empty name) resolves to HOME_MARKER, a sentinel dispatch.pdx substitutes for $HOME once wired (#2231). Any nonzero name_len (an actual alias name, e.g. '~docs' or '~alice') is unresolvable by this stub and returns E_ALIAS_UNRESOLVED (== TTA_ALIAS_UNRESOLVED, 0xFFFFE93D) -- exercising the failure path now so the real KIND_USER_ALIAS-backed resolver (R108.M4) only has to replace this one branch. name_ptr (rdi) is accepted per the frozen signature but deliberately unread -- distinguishing among nonzero-length names needs an actual lookup this landing does not implement. Leaf, no memory access, no capability: effects{} @{}. Label tra_home is function-prefixed per the reserved-label discipline.",
      block: {
        cmp rsi, 0;
        je tra_home;
        mov rax, 0xFFFFE93D;    // E_ALIAS_UNRESOLVED (== TTA_ALIAS_UNRESOLVED)
        ret;
      tra_home:
        mov rax, 0x484F4D45;    // HOME_MARKER
        ret
      }
    }

  // ==========================================================================
  // Fingerprint tags.
  // ==========================================================================
  //
  // Data-only constants. Both allowlisted by
  // tools/verify-fingerprint-coverage.sh (added alongside this file).
  //
  // Length rule (paideia-as encoder pitfall): the array size must equal
  // strlen(string) + 1 -- the terminating NUL counts. An off-by-one
  // trips the encoder's size gate. Both entries below have been
  // hand-verified.
  //
  // R106.M4-USER: "tokenizer tilde alias ok [legacy: TOKENIZER TILDE ALIAS OK]\0"
  //   = 59 chars + NUL = 60 bytes.
  pub let tokenizer_tilde_alias_meta : [u8; 60] = "tokenizer tilde alias ok [legacy: TOKENIZER TILDE ALIAS OK]\0"

  // WAVE-17 (#2457): "tokenizer wave17 cook ok [legacy: TOKENIZER WAVE17 COOK OK]\0"
  //   = 59 chars + NUL = 60 bytes.
  pub let tokenizer_wave17_meta : [u8; 60] = "tokenizer wave17 cook ok [legacy: TOKENIZER WAVE17 COOK OK]\0"
}
