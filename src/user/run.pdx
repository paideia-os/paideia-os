// src/user/run.pdx -- Wave UMB-W13 R125.M5 (paideia-os #2595)
//
// /bin/run -- CAPABILITY-GRANT SHELL SURFACE
// =============================================================================
//
// Shell-facing tool that wraps a child invocation with a one-shot capability
// grant override.  CLI shape:
//
//   run [--grant <cap-spec>] <command> [args...]
//
//   <cap-spec> := entry ("," entry)*                 (max 6 entries)
//   entry      := <name> ":" <rights>
//   <name>     := [a-zA-Z0-9._-]+                   (max 64 bytes)
//   <rights>   := "0x" [0-9a-fA-F]{1,16}
//
// Example:
//   run --grant fs.read:0x1,fs.write:0x2 /bin/cat /etc/motd
//
// At M5 (THIS landing) only the USER-SPACE half lands.  The kernel-side
// override syscall (sys_caps_grant_override at SC+ ID 138) and the splice
// into caps_decl_apply are a separate M5-cont ticket.  Until it lands, SC+
// 138 returns -ENOSYS (0xFFFFFFFFFFFFFFDA) via dispatch_enosys; this binary
// detects that specific error, emits a one-line warning to stderr, and
// falls through to a plain execve so --grant becomes a no-op on an old
// kernel without failing the invocation.  Once M5-cont lands, SC+ 138
// starts applying the override transparently and the warning branch stops
// firing.  Same soft-fail progression as R125.M3's own ELF-caps.decl
// loader (see src/kernel/core/elf/caps_decl_loader.pdx §SECTION 3).
//
// =============================================================================
// SECTION 0  BLOB FORMAT -- MATCHES caps_decl_loader.pdx §SECTION 18
// =============================================================================
//
// Byte layout (little-endian; 16 B header + 24 B per request).  Identical
// to the ELF `.caps.decl` section the kernel already consumes, so the same
// caps_decl_parse body in src/kernel/core/elf/caps_decl_loader.pdx can
// read it unchanged on the M5-cont kernel side.
//
//   offset  type   name
//   ------  -----  --------------------------------------------------
//   0x00    u32    version                                     ; MUST be 1
//   0x04    u32    n_requests                                  ; 1..6
//   0x08    u64    reserved0                                   ; MBZ
//   0x10    CapRequest[n_requests]
//
//   CapRequest (24 B):
//     0x00  u64  parent_cap_name_hash   ; FNV-1a 64 of <name>
//     0x08  u64  requested_rights       ; AND-mask over parent rights
//     0x10  u32  slot_binding           ; dest slot in child cap-env
//     0x14  u32  reserved               ; MBZ
//
// slot_binding is assigned as the entry's 0-indexed position in the spec
// (first entry -> slot 0, second -> slot 1, ...).  Max 6 slots match
// CAP_ENV_ROW_WIDTH in src/kernel/core/cap/kind_cap_env.pdx.
//
// =============================================================================
// SECTION 1  SC+ IDS USED
// =============================================================================
//
// Inlined at every syscall site -- same one-file-one-ELF discipline as
// cat.pdx / touch.pdx / ps.pdx (no syscall_shim link dependency).
//
//    1  = sys_write(fd, buf, count)       -> count written or -errno
//   12  = sys_debug_puts(buf, count)      -- fingerprint emit
//   59  = sys_execve(path, argv, envp)    -> never returns, or -errno
//   60  = sys_exit(status)                -- never returns
//  138  = sys_caps_grant_override(blob,
//                                 blob_len) -> 0 | CDL_ERR_* | -ENOSYS
//
// SC+ 138 is NEW at R125.M5 and currently unwired at the dispatch cascade;
// it returns -ENOSYS until the M5-cont kernel-side landing.
//
// =============================================================================
// SECTION 2  ENCODER DISCIPLINE
// =============================================================================
//
// Per feedback_pdx_encoder_pitfalls:
//   * cmp rN, 0           never `test rN, rN`
//   * mov r10, imm64      staging; never `and r11, imm64`
//   * shl rN, 3 / 4       stride multiplies; never 2-op `imul r, imm`
//   * single-line         `pub let name = "..."`
//   * module basename     Run matches run.pdx
//   * fingerprint tags    N = len(string) + 1 (NUL counted)
//   * labels              prefixed `run_` (no reserved words)
//   * byte loads          `xor rax, rax; mov_b rax, [ptr]` + `cmp rax, imm`
//                         (paideia-as #1248 mitigation)
//
// =============================================================================

module Run = structure {

  // ==========================================================================
  // RETURN CODES (user-space; see §SECTION 1 of header)
  // ==========================================================================
  pub let RUN_OK           : u64 = 0
  pub let RUN_ERR_PARSE    : u64 = 0x1200
  pub let RUN_ERR_WIDEN    : u64 = 0x1201
  pub let RUN_ERR_EXEC     : u64 = 0x1202

  // ==========================================================================
  // BLOB FORMAT CONSTANTS (mirror caps_decl_loader.pdx)
  // ==========================================================================
  pub let RUN_BLOB_VERSION   : u64 = 1
  pub let RUN_HEADER_SIZE    : u64 = 16
  pub let RUN_RECORD_SIZE    : u64 = 24
  pub let RUN_MAX_REQUESTS   : u64 = 6
  pub let RUN_MAX_NAME_BYTES : u64 = 64

  // Blob scratch sized for the max shape: 16 + 6*24 = 160 B.
  pub let mut run_blob : [u8; 160] = uninit @align(8)

  // ENOSYS sentinel the kernel's dispatch_enosys returns for SC+ 138
  // until the M5-cont landing wires its body.  Matches
  // src/kernel/core/syscall/dispatch.pdx:4111 verbatim.
  pub let RUN_ENOSYS         : u64 = 0xFFFFFFFFFFFFFFDA

  // FNV-1a 64 primitives.  Must match cdl_fnv1a64_bounded in
  // src/kernel/core/elf/caps_decl_loader.pdx byte-for-byte so the kernel's
  // M3 bridge posture (which masks low 8 bits of the hash to parent slot)
  // observes the same hash this tool emits.
  pub let RUN_FNV_OFFSET     : u64 = 0xCBF29CE484222325
  pub let RUN_FNV_PRIME      : u64 = 0x00000100000001B3

  // ==========================================================================
  // USAGE / ERROR MESSAGES
  // ==========================================================================
  pub let run_usage_msg      : [u8; 46] = "usage: run [--grant <cap-spec>] <cmd> [args]\n\0"
  pub let run_usage_len      : u64 = 45

  pub let run_err_parse_msg  : [u8; 27] = "run: bad --grant cap-spec\n\0"
  pub let run_err_parse_len  : u64 = 26

  pub let run_err_widen_msg  : [u8; 33] = "run: grant widens parent rights\n\0"
  pub let run_err_widen_len  : u64 = 32

  pub let run_err_enosys_msg : [u8; 53] = "run: --grant ignored (kernel SC+ 138 not yet wired)\n\0"
  pub let run_err_enosys_len : u64 = 52

  pub let run_err_exec_msg   : [u8; 30] = "run: execve of target failed\n\0"
  pub let run_err_exec_len   : u64 = 29

  pub let run_tag_blob_ok    : [u8; 20] = "run: grant blob ok\n\0"
  pub let run_tag_blob_ok_len : u64 = 19

  // ==========================================================================
  // --grant flag literal.  Byte compare driver below checks these 7 bytes
  // (hyphen hyphen g r a n t NUL) against argv[1].
  // ==========================================================================
  pub let run_grant_flag     : [u8; 8] = "--grant\0"
  pub let run_grant_flag_len : u64 = 7

  // ==========================================================================
  // run_fnv1a64_bounded(ptr, max_len) -> u64
  //
  // Byte-for-byte copy of cdl_fnv1a64_bounded.  Early-stops at NUL or at
  // max_len bytes.  Pure leaf: no CALL, no SYSCALL, rsp undisturbed.
  // ==========================================================================
  pub let run_fnv1a64_bounded : (u64, u64) -> u64 !{mem} @{} =
    fn (ptr: u64) (max_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R125.M5 (paideia-os #2595): FNV-1a 64 of up to max_len bytes starting at ptr, early-stopping at NUL. Byte-for-byte copy of cdl_fnv1a64_bounded in src/kernel/core/elf/caps_decl_loader.pdx §cdl_fnv_step so the kernel's M3 bridge posture (which masks low 8 bits to parent slot) observes the same hash. Pure leaf: no CALL/SYSCALL/pushes. Byte reads via full u64 load + and rN,0xFF mask (no movzx, no byte ptr). Multiplier staged via mov r9,imm64 to avoid imul rax,imm64 (not supported). Loop label run_fnv_step; done label run_fnv_done. No reserved words.",
      block: {
        mov r10, rdi;
        mov r11, rsi;
        mov rax, RUN_FNV_OFFSET;
        xor rcx, rcx;
        mov r9,  RUN_FNV_PRIME;

      run_fnv_step:
        cmp rcx, r11;
        jae run_fnv_done;

        mov r8, r10;
        add r8, rcx;
        mov r8, [r8 + 0];
        and r8, 0xFF;
        cmp r8, 0;
        je  run_fnv_done;

        xor rax, r8;
        mul r9;

        add rcx, 1;
        jmp run_fnv_step;

      run_fnv_done:
        ret
      }
    }

  // ==========================================================================
  // run_streq(a, b, n) -> u64 (0 if equal over n bytes OR until NUL
  //                            in both; 1 otherwise)
  //
  // Used to probe argv[1] == "--grant\0".  Pure leaf.
  // ==========================================================================
  pub let run_streq : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (a: u64) (b: u64) (n: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R125.M5 (paideia-os #2595): equality check over up to n bytes, treating NUL in BOTH operands as end-of-string. Pure leaf: no CALL/SYSCALL. Byte reads via xor+mov_b+cmp (paideia-as #1248 mitigation). Returns 0 on equal, 1 on diverged. Labels prefixed run_eq_.",
      block: {
        xor rcx, rcx;

      run_eq_top:
        cmp rcx, rdx;
        jae run_eq_match;

        xor rax, rax;
        mov_b rax, [rdi + rcx * 1];
        xor r8,  r8;
        mov_b r8,  [rsi + rcx * 1];

        cmp rax, r8;
        jne run_eq_mismatch;

        // Both equal and both zero -> matched up to a shared NUL.
        cmp rax, 0;
        je  run_eq_match;

        add rcx, 1;
        jmp run_eq_top;

      run_eq_match:
        xor rax, rax;
        ret;

      run_eq_mismatch:
        mov rax, 1;
        ret
      }
    }

  // ==========================================================================
  // run_hex_u64(ptr, max_chars, out_consumed_ptr) -> u64
  //
  // Parse a hex literal "0x[0-9a-fA-F]+" starting at ptr, consuming at
  // most max_chars bytes.  Stops at the first non-hex byte.  On success
  // writes to [out_consumed_ptr] the number of bytes consumed INCLUDING
  // the "0x" prefix (always >= 3).  On failure writes 0.  Returns the
  // parsed u64 (undefined on failure).  Callers MUST zero
  // *out_consumed_ptr before the call and inspect it after to tell
  // success from failure -- rax itself cannot carry the error signal
  // because 0xFFFFFFFFFFFFFFFF is a legitimate rights mask.
  // ==========================================================================
  pub let run_hex_u64 : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (ptr: u64) (max_chars: u64) (out_consumed_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R125.M5 (paideia-os #2595): parse 0x-prefixed hex literal into u64, bounded at max_chars bytes. Lower/upper case accepted. Signals success/failure via *out_consumed_ptr: writes bytes-consumed (>= 3) on success, 0 on failure. rax carries the parsed value (undefined on failure). Callers zero the out slot pre-call, read it post-call. Pure leaf. Byte peek via xor+mov_b (paideia-as #1248 mitigation). Digit folding uses `shl rax,4; add rax, digit`. Labels prefixed run_hex_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;          // rbx = ptr
        mov r12, rsi;          // r12 = max_chars
        mov r13, rdx;          // r13 = out_consumed_ptr
        xor r14, r14;          // r14 = i (byte cursor)
        xor r15, r15;          // r15 = accumulator

        // Require length >= 2.
        cmp r12, 2;
        jb  run_hex_bad;

        // Byte 0 must be '0'.
        xor rax, rax;
        mov_b rax, [rbx + 0];
        cmp rax, 0x30;
        jne run_hex_bad;

        // Byte 1 must be 'x' or 'X'.
        xor rax, rax;
        mov_b rax, [rbx + 1];
        cmp rax, 0x78;
        je  run_hex_prefix_ok;
        cmp rax, 0x58;
        jne run_hex_bad;

      run_hex_prefix_ok:
        mov r14, 2;            // advance past "0x"

      run_hex_digit:
        cmp r14, r12;
        jae run_hex_done;

        xor rax, rax;
        mov_b rax, [rbx + r14 * 1];

        // Separator or NUL ends the number.
        cmp rax, 0;
        je  run_hex_done;
        cmp rax, 0x2C;         // ','
        je  run_hex_done;
        cmp rax, 0x20;         // ' '
        je  run_hex_done;

        // Fold byte -> nibble.
        cmp rax, 0x30;         // '0'
        jb  run_hex_bad;
        cmp rax, 0x39;         // '9'
        ja  run_hex_check_af;
        sub rax, 0x30;
        jmp run_hex_accept;

      run_hex_check_af:
        cmp rax, 0x41;         // 'A'
        jb  run_hex_bad;
        cmp rax, 0x46;         // 'F'
        jbe run_hex_upper;
        cmp rax, 0x61;         // 'a'
        jb  run_hex_bad;
        cmp rax, 0x66;         // 'f'
        ja  run_hex_bad;
        sub rax, 0x61;
        add rax, 10;
        jmp run_hex_accept;

      run_hex_upper:
        sub rax, 0x41;
        add rax, 10;

      run_hex_accept:
        shl r15, 4;
        add r15, rax;
        add r14, 1;
        // Hard cap: 2 (prefix) + 16 hex digits = 18 bytes total.
        mov rax, 18;
        cmp r14, rax;
        ja  run_hex_bad;
        jmp run_hex_digit;

      run_hex_done:
        // Must have consumed at least one digit beyond "0x".
        cmp r14, 2;
        jbe run_hex_bad;

        mov [r13 + 0], r14;    // *out_consumed = i (>= 3)
        mov rax, r15;
        jmp run_hex_out;

      run_hex_bad:
        xor rax, rax;
        mov [r13 + 0], rax;    // *out_consumed = 0 (fail signal)
        xor rax, rax;          // value is undefined; return 0

      run_hex_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // run_parse_spec(spec_ptr, blob_ptr) -> u64 (RUN_OK | RUN_ERR_PARSE)
  //
  // Walks the NUL-terminated cap-spec string at `spec_ptr`, builds the
  // CapRequest records into the 16-B-offset body of `blob_ptr`, writes
  // the (version,n_requests,reserved0) header into bytes [0..16), and
  // returns RUN_OK.  On any malformed input returns RUN_ERR_PARSE and
  // leaves the blob partially initialised (caller must not consume it).
  //
  // Spec grammar (header §SECTION 0): entry ("," entry)*,
  //   entry := name ":" "0x" hex
  // ==========================================================================
  pub let run_parse_spec : (u64, u64) -> u64 !{mem} @{} =
    fn (spec_ptr: u64) (blob_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R125.M5 (paideia-os #2595): parse comma-separated entries of the shape name:0xHEX from spec_ptr and emit matching CapRequest records at blob_ptr+16 with slot_binding=entry index. Walks the string byte-by-byte, locating ':' as name/rights separator and ',' as entry separator. Each name is hashed via run_fnv1a64_bounded and stored verbatim in parent_cap_name_hash (the kernel's M3 bridge masks the low 8 bits to a parent slot; see src/kernel/core/elf/caps_decl_loader.pdx §SECTION 1). Each rights value is parsed via run_hex_u64. On ANY malformed input returns RUN_ERR_PARSE (0x1200). After the final entry writes the 16-byte header (version=1, n_requests, reserved0=0) into blob_ptr[0..16). Register plan: 5 callee-save pushes + sub rsp,32 for strlen-cache + out_consumed slot + per-entry name/rights spill. Entry rsp%16==0 (per PVH loader) -> +5 pushes +sub32 = +72 -> %16==8 at every nested CALL (run_fnv1a64_bounded, run_hex_u64) which is SysV correct. Labels prefixed run_ps_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 32;

        mov rbx, rdi;              // rbx = spec_ptr
        mov r12, rsi;              // r12 = blob_ptr
        xor r13, r13;              // r13 = cursor into spec
        xor r14, r14;              // r14 = n_requests (entry index)

        // Reject empty spec outright.
        xor rax, rax;
        mov_b rax, [rbx + 0];
        cmp rax, 0;
        je  run_ps_bad;

      run_ps_entry:
        // Locate ':' separating name from rights.  Scan up to
        // RUN_MAX_NAME_BYTES bytes; a NUL or ',' before ':' is parse err.
        mov r15, r13;              // r15 = name_start

      run_ps_scan_colon:
        xor rax, rax;
        mov rcx, r13;
        sub rcx, r15;              // rcx = name length so far
        mov rdx, 64;               // RUN_MAX_NAME_BYTES
        cmp rcx, rdx;
        jae run_ps_bad;

        mov_b rax, [rbx + r13 * 1];
        cmp rax, 0;
        je  run_ps_bad;
        cmp rax, 0x2C;             // ','
        je  run_ps_bad;
        cmp rax, 0x3A;             // ':'
        je  run_ps_colon_found;
        add r13, 1;
        jmp run_ps_scan_colon;

      run_ps_colon_found:
        // name_len = r13 - r15.  Reject zero-length.
        mov rcx, r13;
        sub rcx, r15;
        cmp rcx, 0;
        je  run_ps_bad;

        // Hash the name via run_fnv1a64_bounded(name_start, name_len).
        mov rdi, r15;
        mov rsi, rcx;
        call run_fnv1a64_bounded;
        mov [rsp + 0], rax;        // stash parent_cap_name_hash

        // Advance past ':' into the rights token.
        add r13, 1;

        // Parse the 0x-prefixed hex.  Pass a conservative max_chars = 18
        // (prefix + 16 digits) so run_hex_u64 cannot read past the
        // stated per-token ceiling.  Zero the consumed slot first so the
        // post-call non-zero check cleanly distinguishes success from
        // failure (rax carries the value, which could legitimately be
        // any u64 including 0xFFFFFFFFFFFFFFFF).
        xor rax, rax;
        mov [rsp + 16], rax;       // zero consumed slot
        mov rdi, rbx;
        add rdi, r13;              // rdi = &spec[cursor]
        mov rsi, 18;
        lea rdx, [rsp + 16];       // out_consumed slot
        call run_hex_u64;

        mov r11, [rsp + 16];
        cmp r11, 0;
        je  run_ps_bad;            // consumed==0 => parse failure

        mov [rsp + 8], rax;        // stash requested_rights (value)

        // Advance cursor by the consumed-count written by run_hex_u64.
        add r13, r11;

        // Compute &record[r14] = blob_ptr + 16 + r14*24.
        // r14 * 24 = (r14 << 3) + (r14 << 4) via two shl + add (no imul).
        mov rax, r14;
        shl rax, 3;
        mov r11, r14;
        shl r11, 4;
        add rax, r11;
        add rax, 16;
        add rax, r12;              // rax = &record[r14]

        // Store: parent_cap_name_hash @+0, requested_rights @+8,
        //        slot_binding @+16 (= r14), reserved @+20 (= 0).
        mov r11, [rsp + 0];
        mov [rax + 0], r11;
        mov r11, [rsp + 8];
        mov [rax + 8], r11;
        // slot_binding (u32).  Store u64 then zero-truncate via two u32
        // writes: u32 slot_binding, u32 reserved=0.  Simpler: 8-byte
        // store of r14 (slot_binding) followed by 4-byte write of 0 at
        // offset 20 is NOT possible via the dialect; use two full-u64
        // stores instead, overlapping the second with the reserved=0
        // slot across +20..+28.  Only +16..+24 of the record are
        // meaningful; +24 falls outside the 24-byte record stride.
        //
        // The safe pattern is: mov qword [rax+16], r14_truncated AND
        // write 0 to the high 4 bytes.  Since caps_decl_parse only
        // reads [rax+16..+20] with a shl/shr lo32 mask, writing a full
        // u64 of r14 (which is <= 5) at +16 leaves the kernel's masked
        // read observing r14 verbatim.  reserved @+20 is read-nowhere.
        mov [rax + 16], r14;

        // Advance to next entry or end.
        xor rdx, rdx;
        mov_b rdx, [rbx + r13 * 1];
        cmp rdx, 0;
        je  run_ps_finish;
        cmp rdx, 0x2C;
        jne run_ps_bad;

        // Comma consumed; expect another entry.
        add r13, 1;
        add r14, 1;
        mov rax, 6;                // RUN_MAX_REQUESTS
        cmp r14, rax;
        jae run_ps_bad;
        jmp run_ps_entry;

      run_ps_finish:
        add r14, 1;                // n_requests = entry index + 1

        // Write header: version=1 @+0 (u32 as low 4 bytes), n_requests
        // @+4 (u32 as next 4 bytes), reserved0=0 @+8 (u64).  Emit as
        // one u64 at +0 (version|n_requests<<32) and one u64 zero at +8.
        mov rax, 1;                // version
        mov r9,  r14;
        shl r9,  32;
        or  rax, r9;
        mov [r12 + 0], rax;
        xor rax, rax;
        mov [r12 + 8], rax;

        xor rax, rax;              // RUN_OK = 0
        jmp run_ps_out;

      run_ps_bad:
        mov rax, 0x1200;           // RUN_ERR_PARSE

      run_ps_out:
        add rsp, 32;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // _start -- /bin/run entry point.
  //
  // argv ABI (design/user/execve-abi.md):
  //   rdi = argc
  //   rsi = argv (NULL-terminated array of char*)
  //   rdx = envp (NULL-terminated array of char*)
  //
  // Flow:
  //   (1) argv guard (NULL and argc < 2 both fall through to usage emit).
  //   (2) If argv[1] == "--grant": argc < 4 is a parse error; parse argv[2]
  //       into run_blob; call sys_caps_grant_override(blob, len); on
  //       -ENOSYS warn to stderr and continue; on CDL_ERR_RIGHTS_WIDEN
  //       (0x0F32) exit RUN_ERR_WIDEN; on any other non-zero also exit
  //       RUN_ERR_WIDEN (conservative).  target_path = argv[3],
  //       target_argv = &argv[3].
  //   (3) Else: target_path = argv[1], target_argv = &argv[1] (no grant).
  //   (4) sys_execve(target_path, target_argv, envp).  On return (which
  //       only happens on error since execve replaces the image), emit
  //       the error line and exit RUN_ERR_EXEC.
  //
  // The function never returns on the success path (execve replaces the
  // image); every error path tails into sys_exit, so @no_frame is
  // legitimate.  Entry rsp%16==0 per PVH loader contract.
  // ==========================================================================
  pub let _start : () -> () !{mem, sysreg} @{fs, sched, cap} =
    fn () -> unsafe {
      effects: {mem, sysreg},
      capabilities: {fs, sched, cap},
      justification: "R125.M5 (paideia-os #2595): /bin/run _start. Parses argv per design/user/execve-abi.md (rdi=argc, rsi=argv, rdx=envp), optionally extracts a --grant cap-spec from argv[1..2], builds a .caps.decl-shaped blob into run_blob via run_parse_spec, posts it to the kernel via SC+ ID 138 (sys_caps_grant_override; unwired at M5 -- returns -ENOSYS until M5-cont lands src/kernel/core/svc/caps_grant_override.pdx), then execves the target (argv[1] if no --grant, argv[3] otherwise). envp is captured from rdx into a callee-save register BEFORE any syscall (which clobbers caller-save rdx) and threaded verbatim into sys_execve. @no_frame because every terminal path ends in sys_exit (never returns) or in a successful execve (replaces the image). SC+ ID set is inlined via `mov rax,N; syscall; ret` -- same self-contained discipline as cat.pdx / touch.pdx. Error codes: RUN_ERR_PARSE (0x1200) on bad argv / bad cap-spec; RUN_ERR_WIDEN (0x1201) on CDL_ERR_RIGHTS_WIDEN from the kernel; RUN_ERR_EXEC (0x1202) when sys_execve returns at all. ENOSYS from SC+ 138 is NOT fatal: emits a one-line warning to stderr and proceeds with the plain execve (soft-fail at user-space, matching the M3 kernel-side soft-fail documented in caps_decl_loader.pdx §SECTION 3). Register plan: rbx = argc, r12 = argv base, r13 = envp (captured BEFORE first syscall), r14 = target_path, r15 = target_argv_base. Entry rsp%16==0 per PVH; the function emits no prologue pushes (we use rbx-r15 but never return, so SysV callee-save contract is moot). Encoder-gap discipline matches cat.pdx: no `test rN,rN` (uses `cmp rN,0`); no `and r11,imm64`; no `imul r,imm`; byte peeks via xor+mov_b+cmp. Reserved-label discipline: every label prefixed run_.",
      block: {
        // ---- Phase 0: capture argc/argv/envp into callee-save regs
        // before anything touches caller-save rdi/rsi/rdx.
        mov rbx, rdi;              // rbx = argc
        mov r12, rsi;              // r12 = argv base
        mov r13, rdx;              // r13 = envp (threaded to execve)

        // argv == NULL defensive guard (mirrors cat.pdx / touch.pdx).
        cmp r12, 0;
        jne run_argv_ok;
        xor rbx, rbx;
      run_argv_ok:

        // argc < 2 -> usage; exit RUN_ERR_PARSE.
        cmp rbx, 2;
        jl  run_usage_emit;

        // ---- Phase 1: argv[1] == "--grant" ?
        mov rdi, [r12 + 8];        // rdi = argv[1]
        lea rsi, [rip + run_grant_flag];
        mov rdx, 8;                // compare 7 chars + NUL
        call run_streq;

        cmp rax, 0;
        je  run_have_grant;

        // No --grant: target_path = argv[1]; target_argv_base = &argv[1].
        mov r14, [r12 + 8];        // r14 = target_path
        mov r15, r12;
        add r15, 8;                // r15 = &argv[1]
        jmp run_do_execve;

      run_have_grant:
        // argc < 4 (program, --grant, spec, target) -> parse error.
        cmp rbx, 4;
        jl  run_parse_err;

        // Parse argv[2] into run_blob.
        mov rdi, [r12 + 16];       // argv[2] = cap-spec
        lea rsi, [rip + run_blob];
        call run_parse_spec;

        mov r11, 0x1200;           // RUN_ERR_PARSE
        cmp rax, r11;
        je  run_parse_err;
        cmp rax, 0;
        jne run_parse_err;

        // Compute blob_len = 16 + n_requests * 24.
        // n_requests is at run_blob+4 (low u32).
        lea rax, [rip + run_blob];
        mov r11, [rax + 0];        // u64 containing version|n_req<<32
        shr r11, 32;               // r11 = n_requests (zero-ext u32)

        mov r9, r11;
        shl r9, 3;                 // n*8
        mov r8, r11;
        shl r8, 4;                 // n*16
        add r9, r8;                // n*24
        add r9, 16;                // + header
        // r9 = blob_len

        // ---- Call sys_caps_grant_override (SC+ 138).
        //   rdi = blob_ptr, rsi = blob_len, rax = 138, syscall.
        lea rdi, [rip + run_blob];
        mov rsi, r9;
        mov rax, 138;
        syscall;

        // rax: 0 = applied, -ENOSYS = kernel pre-M5-cont, other = error.
        cmp rax, 0;
        je  run_grant_applied;

        mov r11, RUN_ENOSYS;
        cmp rax, r11;
        je  run_grant_enosys;

        // Any other error -> widen (conservative taxonomy at M5).
        jmp run_widen_err;

      run_grant_enosys:
        // Soft-fail: emit warning to stderr, proceed with plain execve.
        mov rdi, 2;                // fd = stderr
        lea rsi, [rip + run_err_enosys_msg];
        mov rdx, 52;               // run_err_enosys_len
        mov rax, 1;                // sys_write
        syscall;
        jmp run_grant_ready;

      run_grant_applied:
        // Fingerprint: "run: grant blob ok\n" via sys_debug_puts.
        lea rdi, [rip + run_tag_blob_ok];
        mov rsi, 19;               // run_tag_blob_ok_len
        mov rax, 12;               // sys_debug_puts
        syscall;

      run_grant_ready:
        // target_path = argv[3]; target_argv_base = &argv[3].
        mov r14, [r12 + 24];       // r14 = argv[3]
        mov r15, r12;
        add r15, 24;               // r15 = &argv[3]

      run_do_execve:
        // sys_execve(path = r14, argv = r15, envp = r13).  SC+ 59.
        mov rdi, r14;
        mov rsi, r15;
        mov rdx, r13;
        mov rax, 59;
        syscall;

        // execve returned -> error path.
        mov rdi, 2;
        lea rsi, [rip + run_err_exec_msg];
        mov rdx, 29;               // run_err_exec_len
        mov rax, 1;
        syscall;

        mov rdi, RUN_ERR_EXEC;
        mov rax, 60;
        syscall;
        hlt;

      run_usage_emit:
        mov rdi, 2;
        lea rsi, [rip + run_usage_msg];
        mov rdx, 45;               // run_usage_len
        mov rax, 1;
        syscall;

        mov rdi, RUN_ERR_PARSE;
        mov rax, 60;
        syscall;
        hlt;

      run_parse_err:
        mov rdi, 2;
        lea rsi, [rip + run_err_parse_msg];
        mov rdx, 26;               // run_err_parse_len
        mov rax, 1;
        syscall;

        mov rdi, RUN_ERR_PARSE;
        mov rax, 60;
        syscall;
        hlt;

      run_widen_err:
        mov rdi, 2;
        lea rsi, [rip + run_err_widen_msg];
        mov rdx, 32;               // run_err_widen_len
        mov rax, 1;
        syscall;

        mov rdi, RUN_ERR_WIDEN;
        mov rax, 60;
        syscall;
        hlt
      }
    } @no_frame
}
