// src/user/cp.pdx -- R58.M5 (paideia-os #1808) -- /bin/cp user binary
//
// Minimal self-contained /bin/cp: copy one hardcoded (src, dst) pair via a
// bounded 4 KiB read/write loop over sys_open/sys_read/sys_write/sys_close,
// then report success (with byte count) or the failing phase and exit.
//
// -----------------------------------------------------------------------------
// argv[1] / argv[2] -- M0 hardcoded paths (per sys_execve_shim.pdx §Non-Scope)
// -----------------------------------------------------------------------------
//
// Per src/user/ls.pdx §argv/envp note: execve does NOT populate argc/argv
// onto the user stack at M0 (see sys_execve_shim.pdx §Non-Scope), so
// argv[1]/argv[2] are not reachable from _start. This binary hardcodes the
// source to "/tmp/a" and the destination to "/tmp/b" pending execve argv
// wire-up (see sys_execve_shim.pdx §Non-Scope). Once argv-passing lands,
// cp's src/dst collapse to the real argv[1]/argv[2] with no change to the
// syscall sequence below.
//
// -----------------------------------------------------------------------------
// Design choice -- self-contained, no syscall_shim link dependency
// -----------------------------------------------------------------------------
//
// Mirrors true.pdx / cat.pdx / ps.pdx / rm.pdx / mv.pdx / mkdir.pdx /
// touch.pdx: inlines every syscall it needs directly at their call sites.
// One .pdx file, one .elf. build-user.sh classifies cp into its own
// object set (no library pull-in). The one internal `call` in this file
// (cp_print_u64_dec) is a local helper defined in the same module, not a
// pull from syscall_shim or libc/, so the self-contained posture holds.
//
// -----------------------------------------------------------------------------
// SC+ IDs used (src/user/syscall_shim.pdx §2.1)
// -----------------------------------------------------------------------------
//   0  = sys_read(fd, buf, count)    -> count read, 0 (EOF), or -errno
//   1  = sys_write(fd, buf, count)   -> count written or -errno
//   2  = sys_open(path, flags, mode) -> fd or -errno
//   3  = sys_close(fd)               -> 0 or -errno
//   12 = sys_debug_puts(buf, count)  -- fingerprint + fail-marker emit
//   60 = sys_exit(status)            -- never returns
//
// -----------------------------------------------------------------------------
// Open-flags verification (task hint corrected against the kernel source)
// -----------------------------------------------------------------------------
//
// The dst open must set O_CREAT|O_WRONLY|O_TRUNC. src/kernel/core/fs/
// vfs_open.pdx §Flags (frozen since R16-M1-006 / #575) defines:
//   O_CREAT  = 0x40  (bit 6)
//   O_TRUNC  = 0x80  (bit 7, deferred implementation but the flag value is
//                      frozen: "for R16.M1, witness is REACHED-but-returns-0
//                      stub" applies to the CREATE body, not the bit
//                      position)
//   O_APPEND = 0x200 (bit 9)
// i.e. O_TRUNC is 0x80, NOT 0x200 -- 0x200 is O_APPEND. The combined dst
// flags are therefore O_CREAT|O_WRONLY|O_TRUNC = 0x40|0x01|0x80 = 0xC1,
// not 0x241 (0x241 would be O_CREAT|O_WRONLY|O_APPEND). This was checked
// against src/kernel/core/fs/vfs_open.pdx directly (not just rootfs_seed.pdx,
// which only ever passes O_CREAT|O_WRONLY = 0x41 with no truncate/append
// bit) before picking 0xC1.
//
// -----------------------------------------------------------------------------
// Register discipline
// -----------------------------------------------------------------------------
//
//   rbx = src fd (set once by sys_open, live across the whole read loop)
//   r12 = dst fd (set once by sys_open, live across the whole read loop)
//   r13 = running total bytes copied (accumulated register-arithmetic only)
//   r14 = bytes read this iteration (reloaded from rax before rax is
//         clobbered by the following sys_write's own return value)
//   r15 = &cp_buf (lea'd once, constant for the rest of _start)
//
// All five are used directly without a push/pop prologue: SYSCALL
// preserves callee-save registers per amd64 fast-syscall rules, and the
// one `call cp_print_u64_dec` is into a callee that follows SysV
// callee-save (matches ls.pdx's `call sys_getdents` posture). No
// alignment pad is placed before that call -- src/user/ps.pdx's own
// `call print_u64_dec` / `call write_bytes` sites carry no such pad
// either, so this file mirrors the tree's existing precedent rather than
// introducing a new convention.
//
// -----------------------------------------------------------------------------
// Encoder-gap discipline
// -----------------------------------------------------------------------------
//
// No `add reg, [mem]` / `sub reg, [mem]` anywhere. `add r13, r14` (running
// total) and `add r10, ...` (decimal-digit cursor inside
// cp_print_u64_dec) are register-register / register-immediate only.
//
// -----------------------------------------------------------------------------
// Reserved-label discipline
// -----------------------------------------------------------------------------
//
// Every _start label is prefixed `cp_`; every cp_print_u64_dec label is
// prefixed `cp_pud_` (bare `loop`/`done`/`top` are paideia-as keywords).

module Cp = structure {

  // Hardcoded M0 source/destination paths. Absolute + NUL-terminated.
  pub let cp_src_path : [u8; 7] = "/tmp/a\0"
  pub let cp_dst_path : [u8; 7] = "/tmp/b\0"

  // 4 KiB copy scratch. .bss (uninit) so p_filesz stays small; the loader
  // zero-fills bss pages (matches ls.pdx's _ls_buf rationale).
  pub let mut cp_buf : [u8; 4096] = uninit @align(8)

  // Fingerprint prefix -- everything up to and including "bytes=". The
  // variable byte count is appended by cp_print_u64_dec, and the
  // trailing newline is a separate one-byte sys_debug_puts. Storage
  // carries the trailing NUL; wire length excludes it. ASCII "--" in
  // place of an em-dash keeps the line 7-bit ASCII.
  pub let cp_msg_prefix    : [u8; 38] = "cp ok -- from=/tmp/a to=/tmp/b bytes=\0"
  pub let cp_msg_prefix_len : u64 = 37

  pub let cp_msg_nl    : [u8; 2] = "\n\0"
  pub let cp_msg_nl_len : u64 = 1

  // Per-phase fail markers.
  pub let cp_err_open_src    : [u8; 18] = "CP OPEN SRC FAIL\n\0"
  pub let cp_err_open_src_len : u64 = 17

  pub let cp_err_open_dst    : [u8; 18] = "CP OPEN DST FAIL\n\0"
  pub let cp_err_open_dst_len : u64 = 17

  pub let cp_err_read    : [u8; 14] = "CP READ FAIL\n\0"
  pub let cp_err_read_len : u64 = 13

  pub let cp_err_write    : [u8; 15] = "CP WRITE FAIL\n\0"
  pub let cp_err_write_len : u64 = 14

  // ==========================================================================
  // cp_print_u64_dec(value: u64) -> ()
  //
  // u64 -> decimal ASCII, emitted via sys_debug_puts (SC+ ID 12) rather
  // than sys_write, so the byte count rides the same fail-safe fingerprint
  // channel as the rest of cp's output. Shape is a verbatim adaptation of
  // src/user/ps.pdx's print_u64_dec (itself a copy of init.pdx's
  // print_u64_dec, R17-M2-736 D12 / #736): divide-by-10 loop stashes
  // digits right-to-left in a 24-byte stack scratch, then one
  // sys_debug_puts emits the [first_digit, len] slice. Zero fast-paths to
  // a single '0' digit.
  //
  // SysV register discipline:
  //   Reads    : rdi (value)
  //   Preserves: rbx, rbp, r12-r15 (callee-save; untouched by this body)
  //   Clobbers : rax, rcx, rdx, rsi, rdi, r9, r10, r11
  //   Stack    : 24 bytes (20 digits max for u64::MAX + 4 for 16-B align)
  // ==========================================================================
  pub let cp_print_u64_dec : (u64) -> () !{mem, sysreg} @{fs} =
    fn (value: u64) -> unsafe {
      effects: {mem, sysreg},
      capabilities: {fs},
      justification: "R58.M5 (#1808): u64 -> decimal ASCII for cp's 'bytes=<N>' fingerprint suffix, emitted via sys_debug_puts (SC+ ID 12) instead of ps.pdx's print_u64_dec sys_write(fd=1) so the digits ride the same tty-bypassing channel as cp's fingerprint/fail markers. Verbatim divide-by-10 loop shape (src/user/ps.pdx §print_u64_dec, itself a copy of init.pdx's reference implementation, R17-M2-736 D12 / #736): (1) zero fast-path writes a single '0' digit and returns. (2) Otherwise r9 holds the remaining value and r10 is a right-to-left cursor into a 24-byte stack scratch starting at offset 19; each iteration divides r9 by 10 (rax:rdx = r9/10 via `xor rdx,rdx; div rcx`), converts the remainder to ASCII, stores it at the cursor, decrements the cursor, and loops until the quotient reaches zero. (3) The final cursor position plus (rsp+20 - cursor) gives the [buf, len] slice, emitted as sys_debug_puts(buf, len) -- rdi=buf, rsi=len, rax=12, syscall (SC+ ID 12's own (buf, count) shape, no fd argument, per ls.pdx's fail-path emit). @no_frame: the body manages its own 24-byte frame via `sub rsp, 24` / `add rsp, 24` rather than an auto rbp prologue, matching ps.pdx's print_u64_dec posture verbatim. Encoder-gap discipline: no `add reg, [mem]` / `sub reg, [mem]` -- the cursor arithmetic is register-only.",
      block: {
        // 24-byte stack scratch (20 digits max + 4-byte 16-B-align slop).
        sub rsp, 24;

        // Zero special case.
        cmp rdi, 0;
        jne cp_pud_divide_setup;
          mov al, 0x30;                   // ASCII '0'
          mov [rsp], al;
          mov rdi, rsp;                   // buf = &scratch
          mov rsi, 1;                     // count = 1
          mov rax, 12;                    // SC+ ID 12 = sys_debug_puts
          syscall;
          add rsp, 24;
          ret;

        cp_pud_divide_setup:
          mov r9, rdi;                    // r9  = remaining value
          mov r10, rsp;
          add r10, 19;                    // r10 = cursor at last staging byte

        cp_pud_loop_top:
          mov rax, r9;
          mov rcx, 10;
          xor rdx, rdx;                   // zero-extend rdx:rax for div
          div rcx;                        // rax = quotient, rdx = remainder
          add rdx, 0x30;                  // digit -> ASCII '0'..'9'
          mov [r10], dl;                  // store at cursor
          mov r9, rax;                    // r9 = quotient
          cmp r9, 0;
          je cp_pud_loop_done;
          sub r10, 1;                     // advance cursor left
          jmp cp_pud_loop_top;

        cp_pud_loop_done:
          // r10 points at first (MSB) digit. Length = (rsp + 20) - r10.
          mov rax, rsp;
          add rax, 20;
          sub rax, r10;                   // rax = digit count
          mov rsi, rax;                   // count
          mov rdi, r10;                   // buf
          mov rax, 12;                    // SC+ ID 12 = sys_debug_puts
          syscall;
          add rsp, 24;
          ret
      }
    } @no_frame

  // -------------------------------------------------------------------------
  // _start -- user program entry point. Never returns.
  //
  // Effects/caps:
  //   mem     -- reads cp_src_path/cp_dst_path/cp_msg_*/cp_err_* rodata,
  //              reads+writes cp_buf.
  //   sysreg  -- every SYSCALL clobbers rcx (RIP)/r11 (rflags).
  //   fs      -- sys_open / sys_read / sys_write / sys_close.
  //   sched   -- sys_exit terminates the task.
  //
  // @no_frame because the function ends in sys_exit on every terminal
  // path (never returns).
  // -------------------------------------------------------------------------
  pub let _start : () -> () !{mem, sysreg} @{fs, sched} =
    fn () -> unsafe {
      effects: {mem, sysreg},
      capabilities: {fs, sched},
      justification: "R58.M5 (#1808): /bin/cp _start. Inlines sys_open (SC+ ID 2), sys_read (SC+ ID 0), sys_write (SC+ ID 1), sys_close (SC+ ID 3), sys_debug_puts (SC+ ID 12) and sys_exit (SC+ ID 60), plus one same-module `call cp_print_u64_dec` for the byte-count suffix -- same one-file-one-ELF pattern as true.pdx / cat.pdx / rm.pdx / mv.pdx / mkdir.pdx / touch.pdx. Sequence: (1) sys_open(cp_src_path, O_RDONLY=0, mode=0) -- rax < 0 -> cp_fail_open_src (emit CP OPEN SRC FAIL, sys_exit(1), no fd to close). Else rbx = src fd. (2) sys_open(cp_dst_path, O_CREAT|O_WRONLY|O_TRUNC=0xC1, mode=0x1A4) -- flags verified against src/kernel/core/fs/vfs_open.pdx §Flags (O_CREAT=0x40, O_TRUNC=0x80, NOT 0x200 -- 0x200 is O_APPEND) rather than trusting the task brief's 0x241 guess. rax < 0 -> cp_fail_open_dst (close src fd first since it is already open, emit CP OPEN DST FAIL, sys_exit(2)). Else r12 = dst fd. (3) r13 := 0 (running byte total); r15 = &cp_buf (lea'd once). (4) cp_copy_loop: sys_read(rbx, r15, 4096). rax < 0 -> cp_fail_read (close both fds, emit CP READ FAIL, sys_exit(3)). rax == 0 -> cp_copy_done (EOF, drained cleanly). Else r14 := rax (bytes read this iteration -- must be saved before the next syscall clobbers rax); sys_write(r12, r15, r14); rax < 0 -> cp_fail_write (close both fds, emit CP WRITE FAIL, sys_exit(4)); else `add r13, r14` (register-only running total, no add-reg-mem) and loop. (5) cp_copy_done: sys_close(rbx); sys_close(r12) (both return values ignored, matches ls.pdx's fd_close-of-live-fd posture); emit cp_msg_prefix ('cp ok -- from=/tmp/a to=/tmp/b bytes='), `call cp_print_u64_dec` with rdi = r13 (total bytes), emit cp_msg_nl ('\\n'); sys_exit(0). Two consecutive `cmp rax, 0` blocks (one `jl`, one separate `je`) gate the read result rather than a single `jl X; je Y` pair off one flags snapshot -- chosen to mirror the tree's existing one-cmp-per-branch precedent (see cat.pdx / shell.pdx) even though EFLAGS would have stayed valid across the shared form. Register plan: rbx = src fd, r12 = dst fd, r13 = running total (survives every syscall + the `call cp_print_u64_dec`, callee-save, untouched by that callee per its own documented preserve-set), r14 = this-iteration byte count (reloaded from rax before the following sys_write clobbers rax), r15 = &cp_buf (constant for the whole function). None are pushed: SYSCALL preserves callee-save regs per amd64 fast-syscall rules, and cp_print_u64_dec is a SysV callee-save-respecting function (matches ls.pdx's `call sys_getdents` posture). @no_frame because every terminal path ends in sys_exit; entry rsp%16==0 per the PVH loader contract. Encoder-gap discipline: no `add reg, [mem]` / `sub reg, [mem]` anywhere -- `add r13, r14` is register-only. Reserved-label discipline: every label prefixed `cp_`. argv[1]/argv[2] are IGNORED at R17.M0 per sys_execve_shim.pdx §Non-Scope, so src/dst are hardcoded to /tmp/a and /tmp/b pending the execve argv wire-up.",
      block: {
        // ============================================================
        // Phase 1 -- sys_open(cp_src_path, O_RDONLY=0, mode=0) -> fd
        // ============================================================
        lea rdi, [rip + cp_src_path];
        xor rsi, rsi;                        // flags = O_RDONLY (0)
        xor rdx, rdx;                        // mode = 0 (ignored by sys_open)
        mov rax, 2;                          // SC+ ID 2 = sys_open
        syscall;

        cmp rax, 0;
        jl cp_fail_open_src;
        mov rbx, rax;                        // rbx = src fd

        // ============================================================
        // Phase 2 -- sys_open(cp_dst_path, O_CREAT|O_WRONLY|O_TRUNC=0xC1,
        //                      mode=0x1A4) -> fd
        // ============================================================
        lea rdi, [rip + cp_dst_path];
        mov rsi, 0xC1;                       // O_CREAT|O_WRONLY|O_TRUNC
        mov rdx, 0x1A4;                      // mode 0644
        mov rax, 2;                          // SC+ ID 2 = sys_open
        syscall;

        cmp rax, 0;
        jl cp_fail_open_dst;
        mov r12, rax;                        // r12 = dst fd

        xor r13, r13;                        // r13 = total bytes copied
        lea r15, [rip + cp_buf];             // r15 = &cp_buf (constant)

      cp_copy_loop:
        // ============================================================
        // Phase 3 -- sys_read(src_fd, cp_buf, 4096)
        // ============================================================
        mov rdi, rbx;                        // fd = src
        mov rsi, r15;                         // buf
        mov rdx, 4096;                        // count
        mov rax, 0;                           // SC+ ID 0 = sys_read
        syscall;

        cmp rax, 0;
        jl cp_fail_read;
        cmp rax, 0;
        je cp_copy_done;                     // EOF

        mov r14, rax;                         // r14 = bytes read this iter

        // ============================================================
        // Phase 4 -- sys_write(dst_fd, cp_buf, r14)
        // ============================================================
        mov rdi, r12;                         // fd = dst
        mov rsi, r15;                         // buf
        mov rdx, r14;                         // count
        mov rax, 1;                           // SC+ ID 1 = sys_write
        syscall;

        cmp rax, 0;
        jl cp_fail_write;

        add r13, r14;                         // running total (register-only)
        jmp cp_copy_loop;

      cp_copy_done:
        // ============================================================
        // Phase 5 -- close both fds; emit success fingerprint; sys_exit(0)
        // ============================================================
        mov rdi, rbx;                         // src fd
        mov rax, 3;                           // SC+ ID 3 = sys_close
        syscall;

        mov rdi, r12;                         // dst fd
        mov rax, 3;                           // SC+ ID 3 = sys_close
        syscall;

        lea rdi, [rip + cp_msg_prefix];
        mov rsi, 37;                          // cp_msg_prefix_len
        mov rax, 12;                          // SC+ ID 12 = sys_debug_puts
        syscall;

        mov rdi, r13;                          // value = total bytes copied
        call cp_print_u64_dec;

        lea rdi, [rip + cp_msg_nl];
        mov rsi, 1;                           // cp_msg_nl_len
        mov rax, 12;                          // SC+ ID 12 = sys_debug_puts
        syscall;

        xor rdi, rdi;                          // status = 0 (OK)
        mov rax, 60;                           // SC+ ID 60 = sys_exit
        syscall;
        hlt;

      cp_fail_open_src:
        // ============================================================
        // Phase 6a -- open(src) failed; no fd to close.
        // ============================================================
        lea rdi, [rip + cp_err_open_src];
        mov rsi, 17;                           // cp_err_open_src_len
        mov rax, 12;                           // SC+ ID 12 = sys_debug_puts
        syscall;

        mov rdi, 1;                            // status = 1
        mov rax, 60;                           // SC+ ID 60 = sys_exit
        syscall;
        hlt;

      cp_fail_open_dst:
        // ============================================================
        // Phase 6b -- open(dst) failed; src fd is already open, close it.
        // ============================================================
        mov rdi, rbx;                          // src fd
        mov rax, 3;                            // SC+ ID 3 = sys_close
        syscall;

        lea rdi, [rip + cp_err_open_dst];
        mov rsi, 17;                           // cp_err_open_dst_len
        mov rax, 12;                           // SC+ ID 12 = sys_debug_puts
        syscall;

        mov rdi, 2;                            // status = 2
        mov rax, 60;                           // SC+ ID 60 = sys_exit
        syscall;
        hlt;

      cp_fail_read:
        // ============================================================
        // Phase 6c -- read(src) failed; both fds are open, close both.
        // ============================================================
        mov rdi, rbx;                          // src fd
        mov rax, 3;                            // SC+ ID 3 = sys_close
        syscall;

        mov rdi, r12;                          // dst fd
        mov rax, 3;                            // SC+ ID 3 = sys_close
        syscall;

        lea rdi, [rip + cp_err_read];
        mov rsi, 13;                           // cp_err_read_len
        mov rax, 12;                           // SC+ ID 12 = sys_debug_puts
        syscall;

        mov rdi, 3;                            // status = 3
        mov rax, 60;                           // SC+ ID 60 = sys_exit
        syscall;
        hlt;

      cp_fail_write:
        // ============================================================
        // Phase 6d -- write(dst) failed; both fds are open, close both.
        // ============================================================
        mov rdi, rbx;                          // src fd
        mov rax, 3;                            // SC+ ID 3 = sys_close
        syscall;

        mov rdi, r12;                          // dst fd
        mov rax, 3;                            // SC+ ID 3 = sys_close
        syscall;

        lea rdi, [rip + cp_err_write];
        mov rsi, 14;                           // cp_err_write_len
        mov rax, 12;                           // SC+ ID 12 = sys_debug_puts
        syscall;

        mov rdi, 4;                            // status = 4
        mov rax, 60;                           // SC+ ID 60 = sys_exit
        syscall;
        hlt
      }
    } @no_frame
}
