// src/user/true.pdx — R17.M5 #638 — /bin/true user binary.
//
// Minimal self-contained user program used by the shell child-process
// smoke: prints "TRUE OK\n" via sys_write(1, msg, 8), then exits with
// status 0 via sys_exit(0). The "TRUE OK" line is the on-wire witness
// that boot_r17_shell_child_process's chain closed end-to-end:
//   shell tokenizes "true\n" → dispatch miss → exec_child forks +
//   execves resolve_path("true") == "/bin/true" → kernel elf-loads the
//   embedded true.elf out of tmpfs → ring-3 entry into _start below →
//   sys_write reaches _tty0's TX path → sys_exit(0) → parent shell's
//   wait4 unblocks → shell reprompts.
//
// Design choice — self-contained, no syscall_shim link dependency:
//   Mirrors child_hello.pdx exactly: inlines the two syscalls it needs
//   (write, exit) directly inside _start. This keeps the ELF tiny (well
//   under the tmpfs 64 KiB per-file cap), removes any linker collision
//   with the shared syscall_shim.o consumed by init.elf and shell.elf,
//   and matches the "one .pdx file, one .elf" pattern used by every
//   trivial fixture in this tree. build-user.sh classifies true into
//   its own object set for the same reason.
//
// The name is `true` per the R14B tactical plan §Subsystem 20 issue 4;
// unlike POSIX `true` (which emits nothing) this variant emits a single
// "TRUE OK\n" line so the smoke fingerprint can positively distinguish
// a working child-process chain from any silent-early-exit failure mode.
// If a future issue needs a strict POSIX `true` semantics, that binary
// belongs at a different path (e.g. /bin/postrue).
//
// SC+ ID discipline (frozen per R17-M1-001 / #610):
//   1  = sys_write(fd, buf, count)
//   60 = sys_exit(status)  (never returns)
//
// Fingerprint contribution (R17.M5 #638 acceptance criteria):
//   TRUE OK
// followed downstream (from init reaping the shell that reaped this
// child) by the standard REAPED line for the shell PID.

module True = structure {
  // "TRUE OK\n" — 8 bytes payload + NUL terminator = 9 bytes storage.
  // NUL is not written to the wire; sys_write is length-bounded to 8.
  pub let msg : [u8; 9] = "TRUE OK\n\0"
  pub let msg_len : u64 = 8

  // _start — user program entry point. Two syscalls, then unreachable hlt.
  pub let _start : () -> () !{mem, sysreg} @{fs, sched} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {fs, sched},
      justification: "R17.M5 #638: /bin/true _start. Inlines the two SC+ syscalls it needs so the binary is self-contained (no syscall_shim link dependency, no collision with init.elf / shell.elf object sets — same pattern as child_hello.pdx per R15-M6-009 / #560). Sequence: (1) sys_write(1, msg, 8) — SC+ ID 1, SysV args rdi=fd, rsi=buf, rdx=count, no arg shuffle (arity 3 < 4). (2) sys_exit(0) — SC+ ID 60, SysV arg rdi=status. sys_exit never returns; the trailing hlt is defensive belt-and-suspenders for the impossible fallthrough. Effects/caps chosen as the union of sys_write ({mem, sysreg} @ {fs}) and sys_exit ({sysreg} @ {sched}) per the SC+ shim declarations in src/user/syscall_shim.pdx.",
      block: {
        // --- sys_write(1, msg, 8) ---
        mov rdi, 1;                     // fd = stdout
        lea rsi, [rip + msg];           // buf = &msg
        mov rdx, 8;                     // count = 8 (excludes trailing NUL)
        mov rax, 1;                     // SC+ ID 1
        syscall;

        // --- sys_exit(0) ---
        mov rdi, 0;                     // status = 0
        mov rax, 60;                    // SC+ ID 60
        syscall;

        // Unreachable. sys_exit does not return; leaving a hlt here is a
        // defensive stop in case the kernel side ever returns from ID 60
        // (which would itself be a bug, but we don't want to fall through
        // into whatever bytes the linker places next).
        hlt
      }
    }
}
