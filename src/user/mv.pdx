// src/user/mv.pdx -- R58.M5 (paideia-os #1807) -- /bin/mv user binary
//
// Minimal self-contained /bin/mv: rename one hardcoded (src, dst) pair via
// the R56.M3-005 sys_rename syscall body (sysno 82,
// src/kernel/core/syscall/sys_rename.pdx), then report success/failure and
// exit.
//
// -----------------------------------------------------------------------------
// argv[1] / argv[2] -- real since R62.M1-005 (#1836), falls back to
// /tmp/a -> /tmp/b
// -----------------------------------------------------------------------------
//
// argc/argv arrive in rdi/rsi at _start per the frozen execve ABI
// (design/user/execve-abi.md). When argc >= 3, argv[1]/argv[2] (pointers
// directly into this process's own address space) are the rename
// source/destination, each length taken via an inline strlen scan capped
// at 255 (sys_rename's old_len/new_len are explicit walker-CAP
// arguments). When argc < 3, BOTH paths fall back to the original M0
// hardcoded "/tmp/a" -> "/tmp/b" (all-or-nothing: a partial argv is
// treated the same as none, matching cp.pdx's posture).
//
// -----------------------------------------------------------------------------
// Design choice -- self-contained, no syscall_shim link dependency
// -----------------------------------------------------------------------------
//
// Mirrors true.pdx / cat.pdx / ps.pdx / rm.pdx: inlines the syscalls it
// needs (sys_rename=82, sys_debug_puts=12, sys_exit=60) directly at their
// call sites. One .pdx file, one .elf. build-user.sh classifies mv into
// its own object set (no library pull-in).
//
// -----------------------------------------------------------------------------
// SC+ IDs used (src/user/syscall_shim.pdx §2.1 + R56.M3 addition)
// -----------------------------------------------------------------------------
//   12 = sys_debug_puts(buf, count)   -- fingerprint emit
//   60 = sys_exit(status)             -- never returns
//   82 = sys_rename(old_va, old_len, new_va, new_len) -- R56.M3-005 (#1794).
//        rax = 0 on success, negative errno otherwise (see sys_rename.pdx
//        §Failure taxonomy, including -EXDEV for a cross-directory rename
//        -- not reachable here since both hardcoded paths share the /tmp
//        parent). old_len/new_len are walker CAPs, not exact strlens --
//        mirrors rootfs_seed.pdx's `mov rsi, 255` usage ahead of sys_mkdir.
//
// -----------------------------------------------------------------------------
// Register discipline
// -----------------------------------------------------------------------------
//
// sys_rename is dispatch.pdx's one four-argument SC+ call reachable from
// this binary. Per the raw SYSCALL ABI (rdi=arg0, rsi=arg1, rdx=arg2,
// r10=arg3 -- rcx/r11 are clobbered by the SYSCALL instruction itself to
// hold return RIP/RFLAGS, so the 4th arg travels in r10, never rcx; see
// src/user/syscall_shim.pdx §2.1 row 12's own `mov r10, rcx` shuffle
// comment and src/kernel/core/syscall/entry.pdx §12/13 shuffle) the
// fourth argument (new_len) is loaded into r10 directly, not rcx.
//
// R62.M1-005 (#1836) addition: rbx/r12 hold the resolved src path pointer
// and length, r13/r14 the resolved dst path pointer and length, across
// Phase 0's argv resolution into Phase 1's sys_rename call -- all four
// are SysV callee-save and SYSCALL preserves them.  No prologue push;
// entry rsp%16==0 per the PVH loader contract, and every terminal path
// ends in sys_exit, so no epilogue is needed.
//
// -----------------------------------------------------------------------------
// Encoder-gap discipline
// -----------------------------------------------------------------------------
//
// No `add reg, [mem]` / `sub reg, [mem]` anywhere in this file. The
// inline argv strlen scans use `mov_b rax, [reg + rcx*1]` (proven
// throughout the tree) with the standard `xor rax, rax` pre-zero
// (paideia-as #1248).
//
// -----------------------------------------------------------------------------
// Reserved-label discipline
// -----------------------------------------------------------------------------
//
// Every label is prefixed `mv_` per the paideia-as reserved-word
// convention.

module Mv = structure {

  // Hardcoded M0 source/destination paths. Absolute + NUL-terminated.
  pub let mv_src_path : [u8; 7] = "/tmp/a\0"
  pub let mv_dst_path : [u8; 7] = "/tmp/b\0"

  // Fingerprint strings -- routed through sys_debug_puts (SC+ ID 12).
  // Storage carries the trailing NUL; wire length excludes it. ASCII
  // "--" in place of an em-dash keeps the line 7-bit ASCII.
  pub let mv_msg_ok    : [u8; 32] = "mv ok -- from=/tmp/a to=/tmp/b\n\0"
  pub let mv_msg_ok_len : u64 = 31

  pub let mv_msg_fail    : [u8; 16] = "MV RENAME FAIL\n\0"
  pub let mv_msg_fail_len : u64 = 15

  // -------------------------------------------------------------------------
  // _start -- user program entry point. Never returns.
  //
  // Effects/caps:
  //   mem     -- reads mv_src_path / mv_dst_path / mv_msg_* rodata.
  //   sysreg  -- every SYSCALL clobbers rcx (RIP)/r11 (rflags).
  //   fs      -- sys_rename.
  //   sched   -- sys_exit terminates the task.
  //
  // @no_frame because the function ends in sys_exit on every terminal
  // path (never returns).
  // -------------------------------------------------------------------------
  pub let _start : () -> () !{mem, sysreg} @{fs, sched} =
    fn () -> unsafe {
      effects: {mem, sysreg},
      capabilities: {fs, sched},
      justification: "R58.M5 (#1807) + R62.M1-005 (#1836): /bin/mv _start. Inlines sys_rename (SC+ ID 82, R56.M3-005 kernel body at src/kernel/core/syscall/sys_rename.pdx), sys_debug_puts (SC+ ID 12) and sys_exit (SC+ ID 60) -- same one-file-one-ELF pattern as true.pdx / cat.pdx / rm.pdx. #1836: Phase 0 reads argc (rdi) per the frozen execve ABI (design/user/execve-abi.md); when argc >= 3, rbx = argv[1] (`[rsi + 8]`) and r13 = argv[2] (`[rsi + 16]`), each own-aspace pointers, with r12/r14 their respective inline byte-scan strlens (same mv_strlen_loop shape as rm.pdx's rm_strlen_loop, run twice) capped at 255; when argc < 3, rbx = &mv_src_path, r13 = &mv_dst_path, r12 = r14 = 255 (the original walker-cap defaults) -- all-or-nothing fallback, matching cp.pdx's posture. Sequence: (1) sys_rename(rbx, r12, r13, r14) -- rdi = rbx, rsi = r12 (old_len), rdx = r13, r10 = r14 (new_len -- loaded into r10 per the raw SYSCALL ABI's 4th-arg slot, NOT rcx, since rcx/r11 are clobbered by the SYSCALL instruction to hold return RIP/RFLAGS; confirmed against src/user/syscall_shim.pdx's own `mov r10, rcx` shuffle comment for a 4-arg SC+ row and src/kernel/core/syscall/entry.pdx's r10-in/r10-out shuffle), rax = 82, syscall. rax == 0 -> success: emit 'mv ok -- from=/tmp/a to=/tmp/b\\n' via sys_debug_puts (unchanged literal text regardless of the real target -- see design/user/execve-abi.md §Migrated tools), sys_exit(0). rax != 0 (any negative errno per sys_rename.pdx §Failure taxonomy -- -EFAULT/-EINVAL/-EXDEV/-ENOENT) -> emit 'MV RENAME FAIL\\n' via sys_debug_puts, sys_exit(1). rbx/r12/r13/r14 are SysV callee-save and survive the syscall. @no_frame because every terminal path ends in sys_exit; entry rsp%16==0 per the PVH loader contract. Encoder-gap discipline: no `add reg, [mem]` / `sub reg, [mem]` anywhere. Reserved-label discipline: every label is prefixed `mv_`.",
      block: {
        // ============================================================
        // Phase 0 (#1836) -- resolve src/dst from argv, or fall back to
        // the M0 hardcoded /tmp/a -> /tmp/b defaults (all-or-nothing).
        // ============================================================
        cmp rdi, 3;                          // need argc >= 3: argv[0],[1],[2]
        jl  mv_use_default_paths;

        mov rbx, [rsi + 8];                  // rbx = argv[1] (src)
        xor rcx, rcx;
      mv_src_strlen_loop:
        xor rax, rax;
        mov_b rax, [rbx + rcx*1];
        cmp rax, 0;
        je  mv_src_strlen_done;
        add rcx, 1;
        cmp rcx, 255;
        jae mv_src_strlen_done;
        jmp mv_src_strlen_loop;
      mv_src_strlen_done:
        mov r12, rcx;                        // r12 = src path_len

        mov r13, [rsi + 16];                 // r13 = argv[2] (dst)
        xor rcx, rcx;
      mv_dst_strlen_loop:
        xor rax, rax;
        mov_b rax, [r13 + rcx*1];
        cmp rax, 0;
        je  mv_dst_strlen_done;
        add rcx, 1;
        cmp rcx, 255;
        jae mv_dst_strlen_done;
        jmp mv_dst_strlen_loop;
      mv_dst_strlen_done:
        mov r14, rcx;                        // r14 = dst path_len
        jmp mv_paths_ready;

      mv_use_default_paths:
        lea rbx, [rip + mv_src_path];
        mov r12, 255;                        // src path_len cap (walker hint)
        lea r13, [rip + mv_dst_path];
        mov r14, 255;                        // dst path_len cap (walker hint)

      mv_paths_ready:
        // ============================================================
        // Phase 1 -- sys_rename(rbx, r12, r13, r14)
        // ============================================================
        mov rdi, rbx;
        mov rsi, r12;                        // old_len
        mov rdx, r13;
        mov r10, r14;                        // new_len; 4th SYSCALL arg
                                              // travels in r10, not rcx.
        mov rax, 82;                         // SC+ ID 82 = sys_rename
        syscall;

        cmp rax, 0;
        jne mv_fail;

        // ============================================================
        // Phase 2 -- success: sys_debug_puts(mv_msg_ok, 31); sys_exit(0)
        // ============================================================
        lea rdi, [rip + mv_msg_ok];
        mov rsi, 31;                         // mv_msg_ok_len
        mov rax, 12;                         // SC+ ID 12 = sys_debug_puts
        syscall;

        xor rdi, rdi;                        // status = 0 (OK)
        mov rax, 60;                         // SC+ ID 60 = sys_exit
        syscall;
        hlt;

      mv_fail:
        // ============================================================
        // Phase 3 -- fail: sys_debug_puts(mv_msg_fail, 15); sys_exit(1)
        // ============================================================
        lea rdi, [rip + mv_msg_fail];
        mov rsi, 15;                         // mv_msg_fail_len
        mov rax, 12;                         // SC+ ID 12 = sys_debug_puts
        syscall;

        mov rdi, 1;                          // status = 1 (rename failed)
        mov rax, 60;                         // SC+ ID 60 = sys_exit
        syscall;
        hlt
      }
    } @no_frame
}
