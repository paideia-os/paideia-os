// src/user/audio_supervisor.pdx -- R33.M5-001 (#1157)
//
// The audio supervisor userspace binary -- target-shape sibling of
// acpi_supervisor for the R33.M5 audio-routing substrate. Declares an
// `_init_caps` sidecar seeding TWO cap slots:
//
//   cap_slot 14 -- KIND_IPC_ENDPOINT for the RPC endpoint (endpoint_id=5,
//                  R_IPC_ALL for dispatch-loop request/reply). Distinct
//                  from every other sidecar-carrying image's endpoint id
//                  (echo_server=1, echo_client reply_ep=2, acpi_supervisor=3,
//                  pci_enumerator=4) so a witness can hold all sidecars
//                  concurrently without collision.
//   cap_slot 15 -- KIND_IPC_ENDPOINT (endpoint_id=6, R_IPC_ALL) reserved
//                  for a future compositor-side reply channel.
//
// _start body -- infinite dispatch loop matching the acpi_supervisor
// pattern. Four ops (CREATE_ROUTE, DESTROY_ROUTE, SET_GAIN, SET_MUTE) plus
// an error sentinel; stub replies at R33.M5 (the KIND_AUDIO_ROUTE mint
// path is kernel-side, and R33.M5 lands the schema + this endpoint;
// runtime spawn wires the caller-side through post-R33).
//
// SC+ IDs inlined:
//   40 = sys_ipc_recv    (rdi=cap_slot, rsi=hdr_va, rdx=payload_va, rcx=max)
//   41 = sys_ipc_reply   (rdi=cap_slot, rsi=hdr_va, rdx=payload_va, rcx=len)

module AudioSupervisor = structure {

  // ============================================================================
  // _init_caps sidecar -- TWO entries (16 bytes each; total 32 bytes).
  //
  // Entry 0: cap_slot=14 -- RPC endpoint (endpoint_id=5, R_IPC_ALL).
  //   +0  u16 slot   = 0x000E
  //   +2  u16 kind   = 0x0005 (KIND_IPC_ENDPOINT)
  //   +4  u32 rights = 0x0000_000B (R_IPC_READ | R_IPC_WRITE | R_IPC_INVOKE)
  //   +8  u64 target = 0x0000_0000_0002_0005
  //                    bits [15:0]  = 5 (endpoint_id -- svc.audio_routing)
  //                    bits [17:16] = 2 (direction=BIDI)
  //
  // Entry 1: cap_slot=15 -- reserved endpoint (endpoint_id=6).
  //   +0  u16 slot   = 0x000F
  //   +2  u16 kind   = 0x0005 (KIND_IPC_ENDPOINT)
  //   +4  u32 rights = 0x0000_000B
  //   +8  u64 target = 0x0000_0000_0002_0006
  //                    bits [15:0]  = 6 (endpoint_id -- reserved)
  //                    bits [17:16] = 2 (BIDI)
  //
  // Slots 14-15 are the next free slice per
  // design/capabilities/loader-seeded-slot-allocation.md §3.
  // ============================================================================

  pub let _init_caps_count : u64 = 2

  pub let _init_caps : [u64; 4] = [
    // Entry 0: slot=14, kind=KIND_IPC_ENDPOINT, rights=R_IPC_ALL
    0x0000000B0005000E,
    // target_ptr: endpoint_id=5 (svc.audio_routing), direction=BIDI
    0x0000000000020005,
    // Entry 1: slot=15, kind=KIND_IPC_ENDPOINT, rights=R_IPC_ALL
    0x0000000B0005000F,
    // target_ptr: endpoint_id=6 (reserved), direction=BIDI
    0x0000000000020006
  ]

  // ============================================================================
  // Server-side hdr + payload scratch buffers (.bss @align(8)). Same
  // shape as acpi_supervisor.
  // ============================================================================

  pub let mut hdr_scratch     : [u64; 1]   = uninit @align(8)
  pub let mut payload_scratch : [u64; 511] = uninit @align(8)

  // ============================================================================
  // _start -- user program entry point. Infinite dispatch loop.
  // ============================================================================

  pub let _start : () -> () !{mem, sysreg} @{cap} =
    fn () -> unsafe {
      effects: {mem, sysreg},
      capabilities: {cap},
      justification: "R33.M5-001 (#1157): audio_supervisor _start. Infinite request/dispatch/reply loop over cap_slot=14 (seeded by _init_caps sidecar to endpoint_id=5 with R_IPC_ALL). Sequence per iteration: (1) sys_ipc_recv(rdi=14, rsi=&hdr_scratch, rdx=&payload_scratch, rcx=4088) SC+ ID 40. rax = payload_len on success or negative errno; on negative, defensively branch back to server_loop. (2) Load hdr u64 via `mov rax, [hdr_scratch]`; extract op = rax & 0xFF; dispatch on op via a chain of cmp/je against 0x20/0x21/0x22/0x23/default. (3) Each dispatch arm writes a stub 8-byte ACK response into payload_scratch and sets r13 = 8. (4) Rebuild hdr: reload the u64 hdr, mask keeps bits 0..31 (op|ver|reply_eid), OR bit 7 into byte 0 (FRAME_OP_REPLY_BIT), OR (r13 << 32) into bits 32..63 (payload_len_rep). Store back. (5) sys_ipc_reply(rdi=14, rsi=&hdr_scratch, rdx=&payload_scratch, rcx=r13) SC+ ID 41. (6) jmp server_loop. Never returns. Register discipline: r12 = raw hdr (stashed across dispatch), r13 = reply payload_len (stashed across the syscall). Both callee-save; SYSCALL preserves them per amd64 fast-syscall rules.",
      block: {
        server_loop:
          // ---- Step 1: sys_ipc_recv(cap_slot=14, hdr, payload, 4088). ----
          mov rdi, 14;                       // cap_slot=14 (audio_supervisor RPC endpoint)
          lea rsi, [rip + hdr_scratch];
          lea rdx, [rip + payload_scratch];
          mov rcx, 4088;
          mov rax, 40;                       // SC+ ID 40
          syscall;
          cmp rax, 0;
          jl server_loop;                    // defensive retry

          // ---- Step 2: extract op byte + dispatch ----
          lea rax, [rip + hdr_scratch];
          mov rax, [rax];
          mov r12, rax;
          and rax, 0xFF;                     // op

          cmp rax, 0x20;
          je  audio_dispatch_create;
          cmp rax, 0x21;
          je  audio_dispatch_destroy;
          cmp rax, 0x22;
          je  audio_dispatch_set_gain;
          cmp rax, 0x23;
          je  audio_dispatch_set_mute;
          jmp audio_dispatch_default;

        audio_dispatch_create:
          // Stub: 8-byte zeroed CREATE_ACK payload.
          xor rax, rax;
          lea rcx, [rip + payload_scratch];
          mov [rcx + 0], rax;
          mov r13, 8;
          jmp audio_reply_hdr_rebuild;

        audio_dispatch_destroy:
          xor rax, rax;
          lea rcx, [rip + payload_scratch];
          mov [rcx + 0], rax;
          mov r13, 8;
          jmp audio_reply_hdr_rebuild;

        audio_dispatch_set_gain:
          xor rax, rax;
          lea rcx, [rip + payload_scratch];
          mov [rcx + 0], rax;
          mov r13, 8;
          jmp audio_reply_hdr_rebuild;

        audio_dispatch_set_mute:
          xor rax, rax;
          lea rcx, [rip + payload_scratch];
          mov [rcx + 0], rax;
          mov r13, 8;
          jmp audio_reply_hdr_rebuild;

        audio_dispatch_default:
          xor rax, rax;
          lea rcx, [rip + payload_scratch];
          mov [rcx], rax;
          mov r13, 8;
          // Fall through.

        audio_reply_hdr_rebuild:
          mov rax, r12;
          mov rcx, 0xFFFFFFFF;
          and rax, rcx;
          or  rax, 0x80;                     // FRAME_OP_REPLY_BIT
          mov rcx, r13;
          shl rcx, 32;
          or  rax, rcx;
          lea rcx, [rip + hdr_scratch];
          mov [rcx], rax;

          // ---- Step 3: sys_ipc_reply(cap_slot=14, hdr, payload, r13). ----
          mov rdi, 14;
          lea rsi, [rip + hdr_scratch];
          lea rdx, [rip + payload_scratch];
          mov rcx, r13;
          mov rax, 41;                       // SC+ ID 41
          syscall;

          jmp server_loop
      }
    } @no_frame
}
