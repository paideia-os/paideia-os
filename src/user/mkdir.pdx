// src/user/mkdir.pdx -- R58.M5 (paideia-os #1809) -- /bin/mkdir user binary
//
// Minimal self-contained /bin/mkdir: create one hardcoded directory via the
// R56.M3-004 sys_mkdir syscall body (sysno 79,
// src/kernel/core/syscall/sys_mkdir.pdx), then report success/failure and
// exit.
//
// -----------------------------------------------------------------------------
// argv[1] -- M0 hardcoded path (per sys_execve_shim.pdx §Non-Scope)
// -----------------------------------------------------------------------------
//
// Per src/user/ls.pdx §argv/envp note: execve does NOT populate argc/argv
// onto the user stack at M0 (see sys_execve_shim.pdx §Non-Scope), so
// argv[1] is not reachable from _start. This binary hardcodes the target
// path to "/tmp/newdir" pending execve argv wire-up (see
// sys_execve_shim.pdx §Non-Scope). Once argv-passing lands, mkdir's target
// collapses to the real argv[1] with no change to the syscall sequence
// below.
//
// -----------------------------------------------------------------------------
// Design choice -- self-contained, no syscall_shim link dependency
// -----------------------------------------------------------------------------
//
// Mirrors true.pdx / cat.pdx / ps.pdx / rm.pdx / mv.pdx: inlines the
// syscalls it needs (sys_mkdir=79, sys_debug_puts=12, sys_exit=60)
// directly at their call sites. One .pdx file, one .elf. build-user.sh
// classifies mkdir into its own object set (no library pull-in).
//
// -----------------------------------------------------------------------------
// SC+ IDs used (src/user/syscall_shim.pdx §2.1 + R56.M3 addition)
// -----------------------------------------------------------------------------
//   12 = sys_debug_puts(buf, count)   -- fingerprint emit
//   60 = sys_exit(status)             -- never returns
//   79 = sys_mkdir(path_va, path_len, mode) -- R56.M3-004 (#1793); rax = 0
//        on success, negative errno otherwise (see sys_mkdir.pdx §Failure
//        taxonomy). path_len is a walker CAP, not an exact strlen, and
//        mode 0x1FF (0777) matches rootfs_seed.pdx's own mkdir calls
//        verbatim -- the tmpfs adapter ignores the caller mode at R56 but
//        the syscall shape stays POSIX-conformant (see rootfs_seed.pdx
//        §111 note).
//
// -----------------------------------------------------------------------------
// Register discipline
// -----------------------------------------------------------------------------
//
// Straight-line: rdi/rsi/rdx/rax carry syscall args, nothing survives
// across a syscall that a later instruction needs, so no callee-save
// register is used at all. No prologue push; entry rsp%16==0 per the
// PVH loader contract, and every terminal path ends in sys_exit.
//
// -----------------------------------------------------------------------------
// Encoder-gap discipline
// -----------------------------------------------------------------------------
//
// No `add reg, [mem]` / `sub reg, [mem]` anywhere in this file.
//
// -----------------------------------------------------------------------------
// Reserved-label discipline
// -----------------------------------------------------------------------------
//
// The one internal label is prefixed `mkdir_` per the paideia-as
// reserved-word convention.

module Mkdir = structure {

  // Hardcoded M0 target path. Absolute + NUL-terminated.
  pub let mkdir_path : [u8; 12] = "/tmp/newdir\0"

  // Fingerprint strings -- routed through sys_debug_puts (SC+ ID 12).
  // Storage carries the trailing NUL; wire length excludes it. ASCII
  // "--" in place of an em-dash keeps the line 7-bit ASCII.
  pub let mkdir_msg_ok    : [u8; 30] = "mkdir ok -- path=/tmp/newdir\n\0"
  pub let mkdir_msg_ok_len : u64 = 29

  pub let mkdir_msg_fail    : [u8; 12] = "MKDIR FAIL\n\0"
  pub let mkdir_msg_fail_len : u64 = 11

  // -------------------------------------------------------------------------
  // _start -- user program entry point. Never returns.
  //
  // Effects/caps:
  //   mem     -- reads mkdir_path / mkdir_msg_* rodata.
  //   sysreg  -- every SYSCALL clobbers rcx (RIP)/r11 (rflags).
  //   fs      -- sys_mkdir.
  //   sched   -- sys_exit terminates the task.
  //
  // @no_frame because the function ends in sys_exit on every terminal
  // path (never returns).
  // -------------------------------------------------------------------------
  pub let _start : () -> () !{mem, sysreg} @{fs, sched} =
    fn () -> unsafe {
      effects: {mem, sysreg},
      capabilities: {fs, sched},
      justification: "R58.M5 (#1809): /bin/mkdir _start. Inlines sys_mkdir (SC+ ID 79, R56.M3-004 kernel body at src/kernel/core/syscall/sys_mkdir.pdx), sys_debug_puts (SC+ ID 12) and sys_exit (SC+ ID 60) -- same one-file-one-ELF pattern as true.pdx / cat.pdx / rm.pdx / mv.pdx. Sequence: (1) sys_mkdir(mkdir_path, 255, 0x1FF) -- rdi = path VA (rip-relative lea), rsi = 255 (walker cap, not strlen -- mirrors rootfs_seed.pdx's own `mov rsi, 255` ahead of its three mkdir calls), rdx = 0x1FF (0777 -- verbatim value rootfs_seed.pdx passes to the same syscall; the tmpfs adapter ignores the caller mode at R56 and forces VNODE_TYPE_DIR, but the syscall shape stays POSIX-conformant per rootfs_seed.pdx §111), rax = 79, syscall. rax == 0 -> success: emit 'mkdir ok -- path=/tmp/newdir\\n' via sys_debug_puts, sys_exit(0). rax != 0 (any negative errno per sys_mkdir.pdx §Failure taxonomy -- -EFAULT/-ENOENT/-EIO) -> emit 'MKDIR FAIL\\n' via sys_debug_puts, sys_exit(1). No callee-save register is used: nothing needs to survive across a syscall boundary that a later instruction reads. @no_frame because every terminal path ends in sys_exit; entry rsp%16==0 per the PVH loader contract. Encoder-gap discipline: no `add reg, [mem]` / `sub reg, [mem]` anywhere. Reserved-label discipline: the one internal label is prefixed `mkdir_`. argv[1] is IGNORED at R17.M0 per sys_execve_shim.pdx §Non-Scope, so the target path is hardcoded to /tmp/newdir pending the execve argv wire-up.",
      block: {
        // ============================================================
        // Phase 1 -- sys_mkdir(mkdir_path, path_len=255, mode=0x1FF)
        // ============================================================
        lea rdi, [rip + mkdir_path];
        mov rsi, 255;                        // path_len cap (walker hint)
        mov rdx, 0x1FF;                       // mode = 0777
        mov rax, 79;                          // SC+ ID 79 = sys_mkdir
        syscall;

        cmp rax, 0;
        jne mkdir_fail;

        // ============================================================
        // Phase 2 -- success: sys_debug_puts(mkdir_msg_ok, 29); sys_exit(0)
        // ============================================================
        lea rdi, [rip + mkdir_msg_ok];
        mov rsi, 29;                          // mkdir_msg_ok_len
        mov rax, 12;                          // SC+ ID 12 = sys_debug_puts
        syscall;

        xor rdi, rdi;                         // status = 0 (OK)
        mov rax, 60;                          // SC+ ID 60 = sys_exit
        syscall;
        hlt;

      mkdir_fail:
        // ============================================================
        // Phase 3 -- fail: sys_debug_puts(mkdir_msg_fail, 11); sys_exit(1)
        // ============================================================
        lea rdi, [rip + mkdir_msg_fail];
        mov rsi, 11;                          // mkdir_msg_fail_len
        mov rax, 12;                          // SC+ ID 12 = sys_debug_puts
        syscall;

        mov rdi, 1;                           // status = 1 (mkdir failed)
        mov rax, 60;                          // SC+ ID 60 = sys_exit
        syscall;
        hlt
      }
    } @no_frame
}
