// src/user/libc/getdents.pdx -- R57.M4-001 (#1797)
//
// Thin sys_getdents syscall wrapper (SC+ ID 78) -- first inhabitant of
// src/user/libc/, the userspace runtime library that will grow alongside
// R57's userland surface (ls, cat, mkdir, ...). Follows the same
// straight-line trampoline shape as every wrapper in
// src/user/syscall_shim.pdx: `mov rax, N; syscall; ret` (10 bytes) at
// arity < 4.
//
// -----------------------------------------------------------------------------
// Contract (mirrors sys_getdents_body at src/kernel/core/syscall/sys_getdents.pdx)
// -----------------------------------------------------------------------------
//
//   sys_getdents(fd, buf, nbytes) -> u64
//     rdi = fd      (validated kernel-side to be in [3, 32))
//     rsi = buf     (user VA, gated by user_ptr_ok + KPTI walker)
//     rdx = nbytes  (byte cap on the returned record stream; capped kernel-side
//                    at GETDENTS_IO_MAX = 4096)
//
//     rax = bytes-written on success (may be < nbytes; includes the trailing
//           zero-name-len terminator record when the directory ended in this
//           call), or negative-errno on failure:
//             -EBADF   (0xFFFFFFFFFFFFFFF7)
//             -EFAULT  (0xFFFFFFFFFFFFFFF2)
//             -EIO     (0xFFFFFFFFFFFFFFFB)
//
// -----------------------------------------------------------------------------
// Record layout (frozen at R56.M3 -- kernel side owns the shape)
// -----------------------------------------------------------------------------
//
//   +0   ino:      u64
//   +8   name_len: u16  (0 marks the terminator record; else 1..255)
//   +10  type:     u8   (VNODE_TYPE_REG=1, VNODE_TYPE_DIR=2, ...)
//   +11  reserved: u8   (always 0; padding)
//   +12  name[name_len]  (no NUL terminator)
//
// -----------------------------------------------------------------------------
// Why this wrapper lives here rather than in syscall_shim.pdx
// -----------------------------------------------------------------------------
//
// syscall_shim.pdx is the FROZEN set of 12 SC+ wrappers + 1 R13 legacy
// alias per R17-m1-001 (#610) -- its enumeration is a contract shell.elf
// and init.elf both consume, and every change to it re-links two ELFs.
// R57.M4's userland surface (ls, cat, ...) needs a growing family of
// syscall wrappers that no ring-2 binary (shell, init) has any interest
// in. Splitting them into src/user/libc/ gives each new binary its own
// composable library set: build-user.sh routes libc/*.pdx into
// LIBC_OBJECTS which the ls.elf link consumes, without dragging the
// wrapper into shell.elf / init.elf.
//
// Post-R57.M4, syscall_shim.pdx retains its role as the substrate for
// the ring-2 shell + init; libc/ grows with the ring-3 user surface. A
// future round may consolidate the two by moving the shim wrappers into
// libc/ and letting shell.elf / init.elf link a subset, but that is a
// separate refactor and is not part of R57.M4-001.

module Getdents = structure {

  // sys_getdents(fd, buf, nbytes) -> bytes-written or negative errno.
  //
  // Effect + capability row mirrors sys_read / sys_open in
  // syscall_shim.pdx: {mem, sysreg} @{fs}. mem covers the kernel's
  // KPTI-walk copy into the user buffer; sysreg covers the SYSCALL; fs
  // covers the vnode + directory read.
  pub let sys_getdents : (u64, u64, u64) -> u64 !{mem, sysreg} @{fs} =
    fn (fd: u64) (buf: u64) (nbytes: u64) -> unsafe {
      effects: {mem, sysreg},
      capabilities: {fs},
      justification: "R57.M4-001 (#1797): thin sys_getdents wrapper (SC+ ID 78). Matches the arity-3 template in syscall_shim.pdx §3.2 byte-for-byte: mov rax, 78; syscall; ret. SysV args rdi=fd, rsi=buf, rdx=nbytes map directly to SYSCALL args (kernel entry.pdx does no shuffle at arity 3 < 4 -- rcx-to-r10 is arity-4+ only). Kernel body live at R56.M3-003 (#1792) in src/kernel/core/syscall/sys_getdents.pdx: dispatch_getdents shim loads _current_tcb into rdi and calls sys_getdents_body(current, fd, buf, nbytes), which caps nbytes at 4096, gates buf via user_ptr_ok, dispatches through vops_readdir, walks the returned scratch, advances the fd cursor via fd_set, and copies the scratch into the user buffer via user_write_bytes_via_walk. Effects/caps chosen as the SC+ shim declaration of sys_read (its nearest arity-3 read-shape sibling): {mem, sysreg} @{fs}. First inhabitant of src/user/libc/ per the file header rationale; build-user.sh routes libc/*.pdx into LIBC_OBJECTS pulled into the ls.elf link only, so this wrapper does NOT re-link shell.elf / init.elf. Reserved labels: none (leaf function, no branches).",
      block: {
        mov rax, 78;
        syscall;
        ret
      }
    }
}
