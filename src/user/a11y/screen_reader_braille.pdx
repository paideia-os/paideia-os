// src/user/a11y/screen_reader_braille.pdx -- Wave0-B11-05 (paideia-os #2310)
//
// SCREEN-READER BRAILLE OUTPUT CLIENT  (LOGIC MODULE).
//
// Companion / precedent:
//   * src/user/a11y/screen_reader_protocol.pdx (Wave0-B9-09,
//     paideia-os #2308) defines the subscribe/push/pop/unsubscribe
//     protocol between the compositor's KIND_A11Y_TREE mutation site
//     and a screen-reader client's read loop, including the
//     ScreenReaderEvent enum (SR_TREE_UPDATED=0, SR_FOCUS_CHANGED=1,
//     SR_NODE_DESTROYED=2, SR_TREE_DESTROYED=3) that THIS module
//     dispatches on in braille_client_on_a11y_event.
//   * src/user/a11y/screen_reader_tts.pdx (Wave0-B10-07,
//     paideia-os #2309) is this module's TWIN.  Both are output-side
//     glue clients hanging off the same screen_reader_protocol
//     subscription: the TTS client dispatches focused-node updates
//     into a satellite speech engine, while THIS client dispatches
//     them into a physical braille display device.  The two clients
//     coexist by design -- a user with a braille display + speech
//     out simultaneously runs both, each holding its own state row
//     over the same sr_sub_id.
//   * src/user/a11y/tree_kind.pdx (Wave0-B8-03, paideia-os #2302)
//     defines KIND_A11Y_TREE = 0x1D3 and its subscribe binding; the
//     screen_reader_sub_id this client stores is a row_id in the
//     screen_reader_protocol pool that was in turn allocated over a
//     KIND_A11Y_TREE row the client already held RIGHT_A11Y_SUBSCRIBE
//     on.
//
// =============================================================================
// SECTION 0  WHY THIS MODULE EXISTS
// =============================================================================
//
// The BRLTTY / Orca lineage puts the braille dispatch in the same
// process as the screen reader: brltty runs as a system daemon that
// opens the physical braille device (USB HID, serial, or Bluetooth
// RFCOMM) and dispatches text through a per-model translator table
// loaded at daemon startup.  Orca then talks to brltty over a UNIX
// socket, and brltty holds BOTH the physical-device handle AND the
// six-dot-to-eight-dot translator tables in its heap.  That posture
// bakes two ambient-authority concessions into the a11y story:
//
//   * Whoever compromises the brltty daemon ALSO gains the physical
//     braille device (a Bluetooth HID that can, on some models, act
//     as a keyboard AND read the surrounding textual context the
//     user was proofreading).  A braille display with keystroke-
//     round-trip capability, held by a service that also proxies for
//     other assistive-tech clients, has enough surface to leak the
//     user's typed passwords by displaying them briefly to any
//     onlooker or by exfiltrating them over the display's bidirectional
//     channel.  PaideiaOS refuses that shape: the physical braille
//     device is held by a SATELLITE DRIVER PROCESS (future landing at
//     KIND_BRAILLE_DEVICE = 0x1E1 forward-reserved below); the screen
//     reader (and this client-side glue) holds ONLY a send-cells cap
//     on that driver.  The driver can be revoked independently of
//     the screen reader, and vice versa.
//
//   * The per-model translator table is a large, read-only, per-locale
//     mapping (English Grade 1 is 96 entries * 8 bytes = 768 bytes;
//     Grade 2 with contractions is 5000+ entries; Unicode 8-dot
//     tables span the full BMP).  Loading it into the screen-reader
//     process at startup burns per-page write faults, and sharing it
//     across multiple assistive-tech clients (a braille display in
//     the settings preview UI, a braille-preview mode in a text
//     editor, this main output client) requires a marshalling shim
//     over IPC.  A future PaideiaOS landing models the table as an
//     IMMUTABLE KIND_MEMORY capability minted once at boot from the
//     pdxfs read-only volume that ships the locale-specific braille
//     table; every a11y client receives a read-only handle to the
//     SAME physical pages via cap-share, no copy and no per-client
//     fault-in cost.  THIS landing does not yet store the translator-
//     table cap in the state row (the reserved word in the row's
//     last u64 leaves headroom for that promotion without a shape
//     break); the current fidelity only records the device format
//     enum (6-dot vs 8-dot) so the future dispatch knows which table
//     to consult.
//
// This is the NOVEL-CLEAN DESIGN choice: braille driver as satellite
// process (revocable independently of the screen reader), translator
// table as immutable KIND_MEMORY cap (shared across all a11y
// clients zero-copy, future landing).  The client-side glue in THIS
// module is a small state cell holding the sub-id + device cap
// ordinal + display configuration; it exposes a display/scroll/reset
// API to the screen reader and a dispatch shim from ScreenReaderEvent
// -> display call.
//
// LOGIC MODULE, NOT A KIND-CAP.  Like screen_reader_protocol.pdx
// (paideia-os #2308) and screen_reader_tts.pdx (paideia-os #2309),
// this file lives entirely on the userland supervisor side of the
// ring boundary.  It exposes no cap-substrate mint gate, no rights
// word, and is not wired into cap_table.  The authorities it composes
// over -- KIND_A11Y_TREE (0x1D3) for the subscription, KIND_BRAILLE_DEVICE
// (forward-reserved at 0x1E1) for the device send-cap -- are each
// gated on their own capability check at their own dispatch sites;
// this module holds the ordinal IDs and does no minting.
//
// FUTURE PROMOTION PATHS.  Three plausible landings would move
// pieces of this module into the kernel:
//
//   (a) KIND_BRAILLE_DEVICE (0x1E1) mint gate lands as
//       src/kernel/core/cap/kind_braille_device.pdx; the
//       braille_device_kind_id stored here becomes a live
//       KIND_BRAILLE_DEVICE row rather than a forward-reserved integer.
//   (b) A KIND_BRAILLE_TABLE derivation over KIND_MEMORY lands as
//       src/kernel/core/cap/kind_braille_table.pdx; the reserved word
//       in the state row is repurposed as the table cap ordinal, and
//       the display_text path promotes from "returns a seq and stops"
//       to a kernel-side dispatch that walks the translator + emits
//       cells to the device.
//   (c) The scroll cursor becomes crash-survivable via the recovery
//       plane (KIND_RECOVERY_PLANE = 0x1C8), so a screen-reader crash
//       mid-scroll resumes at the correct offset rather than jumping
//       back to the head of the buffer.
//
// Nothing in this landing prevents any of those promotions; the
// state cell's layout has a reserved u64 in each row for (b), and
// the last_output_seq is already a u64 so (c) can persist it as-is.
//
// =============================================================================
// SECTION 1  MODULE POSTURE
// =============================================================================
//
// No KIND_* slot is allocated for this module (§0 rationale).  No
// parent kind, no rights word.  The state_id returned by
// braille_client_new is a row_id in this module's pool
// (0..SRB_MAX_STATES-1) rather than a KIND-cap ordinal, and the
// caller stores it in its per-client bookkeeping and passes it back
// on every display_text / scroll / reset / on_a11y_event / free
// call.
//
// SRB_MAX_STATES = 1 at Wave 0 fidelity: exactly one braille client
// per session (parallels screen_reader_tts.pdx's SRTC_MAX_STATES = 1
// and reflects the empirical "one physical braille display per
// user" ground truth).  The pool shape is kept so a future landing
// that supports multiple concurrent braille outputs (a physical
// display + a settings-panel preview + a hex-editor's byte view
// tapping the same subscription) can bump SRB_MAX_STATES without a
// row-shape break.
//
// =============================================================================
// SECTION 2  ROW LAYOUT  (32 BYTES = HALF CACHE LINE)
// =============================================================================
//
// One row per live braille client.  32 bytes leaves headroom for a
// future landing that adds e.g. a translator-table cap ordinal or a
// per-client locale hint without a row-shape break.
//
//   [+0]  hdr:      screen_reader_sub_id[31:0]
//                                       | braille_device_kind_id[63:32]
//                         -- sub_id: row_id in the screen_reader_protocol
//                            pool (§0 companion note).  device: cap-slot
//                            ordinal for the KIND_BRAILLE_DEVICE row the
//                            client will send display requests to.
//   [+8]  cursor:   current_text_offset[31:0]
//                                       | scroll_position[63:32]
//                         -- text_offset: interned-string id of the
//                            most-recently displayed line (0 = "no
//                            text displayed"; reset by
//                            braille_client_reset).  scroll_position:
//                            byte offset within the current text
//                            where the physical display's first cell
//                            currently reads; bumped by
//                            _scroll_forward, reduced by _scroll_back.
//   [+16] meta:     format[7:0] | cell_count[23:8] | reserved[55:24]
//                                       | in_use[63:56]
//                         -- format: BrailleCellFormat enum ordinal
//                            (BC_6DOT=0, BC_8DOT=1); u8-wide.
//                            cell_count: u16-wide physical-display
//                            cell count (typically 20/40/80; bounded
//                            SRB_CELL_MAX=256 to fit any commercially
//                            shipped device).  in_use: 0 = row free,
//                            1 = row live (mirrors the shape used by
//                            screen_reader_protocol / screen_reader_tts
//                            for the in_use bit position at cfg[63:56]).
//   [+24] last_seq: last_output_seq (u64, monotone)
//                         -- bumped on every braille_client_display_text
//                            call; the returned seq is the value AFTER
//                            the bump.  Wraparound at u64 max is
//                            2^64 displays, ~584 million years at one
//                            display per nanosecond -- for practical
//                            purposes the counter is un-wrappable, so
//                            a subsequent landing that keys audit
//                            records off this seq is safe against a
//                            silent aliasing bug.
//
// SRB_MAX_STATES = 1 rows * 32 bytes = 32 bytes = 4 u64.
//
// =============================================================================
// SECTION 3  ENUMS
// =============================================================================
//
// BrailleCellFormat (u8):
//
//   BC_6DOT = 0  -- traditional 6-dot Grade 1 (English uncontracted
//                   is the near-universal factory default; Grade 2
//                   with contractions is a future landing).  Cells
//                   are 6-bit bitmasks per position, packed 1 byte
//                   per cell in the send buffer to the device.
//   BC_8DOT = 1  -- Unicode Braille 8-dot (U+2800..U+28FF), where
//                   the extra two dots (7, 8) encode capitalization
//                   marks, math extensions, and (in some notation
//                   systems) computer-specific glyphs.  Cells are
//                   the full 8-bit codepoint value.
//
// SRB_FORMAT_MAX = 1 gates braille_client_new's format argument.
//
// Cell counts (physical-display sizing):
//
//   Typical hardware: 20 (portable Braille pocket displays),
//                     40 (mid-range desktop / notetaker),
//                     80 (proofreading / assistive workstation).
//
//   SRB_CELL_MAX = 256 gates braille_client_new's cell_count
//                       argument.  Well above any commercially
//                       shipped device (Handy Tech Modular Evolution
//                       88 is the largest at 88 cells + status), so
//                       any real device fits; garbage values that
//                       would exhaust the (future) device send
//                       buffer are refused.
//
// =============================================================================
// SECTION 4  FAILURE TAXONOMY  0xFFFFEE51..0xFFFFEE5A
// =============================================================================
//
// The task-row hint was 0xFFFFEDA0..0xFFFFEDAF but a repo-wide grep at
// landing time (`grep -rhoE '0xFFFFEDA[0-9A-Fa-f]' src/`) shows the
// hint band FULLY claimed:
//   0xFFFFEDA0..EDA0, EDA3..EDAF (14 slots) live under
//     src/kernel/core/cap/kind_vello_renderer.pdx (VELLO_ERR_* band)
//     plus adjacent EDA-page kernel drivers.
// Only EDA1..EDA2 (2 slots) remain, which is insufficient for the 8-
// slot failure surface this module needs.  Following the
// screen_reader_protocol.pdx §5 and screen_reader_tts.pdx §4
// precedents -- both of which deviated from their hint bands when
// those bands were already claimed and documented the grep-verify
// note authorizing selection of a free sub-band -- this landing
// selects the free sub-band 0xFFFFEE51..0xFFFFEE5A (10 slots),
// verified free at landing time by
// `grep -rhoE '0xFFFFEE5[1-9Aa]' src/` returning empty
// (EE50 and EE5B..EE5F are claimed; EE51..EE5A form the entire free
// window inside the EE5x sub-page).  The band remains in the EE page
// adjacent to the a11y-family neighborhood so the wider a11y row
// stays contiguous in the low failure-code address space.
//
//   SRB_OK              = 0                (canonical success)
//   SRB_TAIL_ENOSPC     = 0xFFFFEE5A       (braille_client_new pool full)
//   SRB_BAD_SUB         = 0xFFFFEE59       (sr_sub_id == 0 or > u32-max)
//   SRB_BAD_DEVICE      = 0xFFFFEE58       (braille_device_kind_id == 0
//                                            or > u32-max)
//   SRB_BAD_FORMAT      = 0xFFFFEE57       (format > SRB_FORMAT_MAX(1))
//   SRB_BAD_CELL_COUNT  = 0xFFFFEE56       (cell_count == 0 or
//                                            > SRB_CELL_MAX(256))
//   SRB_BAD_STATE       = 0xFFFFEE55       (state_id >= SRB_MAX_STATES
//                                            or row not in_use)
//   SRB_BAD_TEXT        = 0xFFFFEE54       (text_len == 0 or text_len
//                                            > SRB_TEXT_MAX)
//   SRB_BAD_EVENT       = 0xFFFFEE53       (event_kind >
//                                            SR_EVENT_MAX(3); mirrors
//                                            screen_reader_protocol's
//                                            SR_BAD_EVENT gate)
//
// Reserved for future landings: 0xFFFFEE51..0xFFFFEE52 (2 slots
// headroom for a KIND_BRAILLE_TABLE-cap bind refusal and a
// scroll-during-empty-buffer refusal, both of which land with the
// future dispatch wire-body).
//
// SCROLL SEMANTICS.  braille_client_scroll_{forward,back} return a
// u8 status (0 == at boundary / no advance, 1 == advanced), NOT a
// failure sentinel.  A caller of _scroll_forward that receives 0
// treats it as "no more content to display" (the display remains
// at the current scroll_position, unchanged); a caller of
// _scroll_back that receives 0 treats it as "already at the head
// of the buffer" (scroll_position stays at 0).  Neither is an
// error.  Bad state_id folds to 0 (safe fallback: a client with a
// stale state_id sees "at boundary" everywhere and eventually
// notices via its own bookkeeping).
//
// =============================================================================
// SECTION 5  FUNCTION CATALOGUE
// =============================================================================
//
//   braille_client_new(sr_sub_id, braille_device_kind_id, format,
//                      cell_count) -> state_id | error
//     -- Allocates a row bound to (sr_sub_id, braille_device_kind_id)
//        with the given (format, cell_count).  current_text_offset,
//        scroll_position, last_output_seq all start at 0.  The four-
//        argument shape is load-bearing: cell_count is a physical
//        property of the display and MUST be known at new time (a
//        subsequent landing that reads it back into a re-scroll
//        calculation would break if it defaulted to zero).
//
//   braille_client_display_text(state_id, text_offset, text_len)
//                                       -> output_seq | error
//     -- Records (text_offset, text_len) as the current display line
//        (writes text_offset to cursor[31:0]), resets scroll_position
//        to 0, bumps last_output_seq and returns the post-bump value.
//        AT THIS LANDING the device send-path is NOT wired: the
//        return value is the seq the future device-send landing will
//        use as the audit-record key; the text bytes at
//        (text_offset, text_len) are validated for nonzero length
//        and bounded length but are NOT copied out.  text_len is
//        preserved in r13 across the stats bump so a future landing
//        that stores the length in the reserved-header window can
//        pick it up without a signature change.
//
//   braille_client_scroll_forward(state_id) -> u8 (0 or 1)
//     -- Bumps scroll_position by cell_count.  Returns 0 iff at end
//        (scroll_position + cell_count would overflow u32-max, which
//        this landing treats as the sole "at end" signal in the
//        absence of a stored text_len; a future landing that stores
//        text_len can tighten the check to (scroll_position +
//        cell_count > text_len)).  Returns 1 on advance.  Bad
//        state_id folds to 0 (safe fallback -- see §4 SCROLL
//        SEMANTICS).
//
//   braille_client_scroll_back(state_id) -> u8 (0 or 1)
//     -- Reduces scroll_position by cell_count, clamping to 0.
//        Returns 0 iff already at start (scroll_position == 0 on
//        entry).  Returns 1 on retreat.  Bad state_id folds to 0
//        (safe fallback).
//
//   braille_client_on_a11y_event(state_id, event_kind, node_id)
//                                       -> SRB_OK | SRB_BAD_STATE
//                                        | SRB_BAD_EVENT
//     -- Dispatches on ScreenReaderEvent (from screen_reader_protocol
//        §4):
//          SR_FOCUS_CHANGED(1)  -> display the focused node's label
//                                  (label lookup requires walking
//                                  KIND_A11Y_TREE; not wired at this
//                                  landing, so the function bumps
//                                  SRB_ST_A11Y_EVENTS and returns).
//          SR_TREE_UPDATED(0)   -> potentially refresh the current
//                                  display (heuristic: only if the
//                                  focused node's subtree changed;
//                                  also not wired at this landing,
//                                  same stats bump).
//          SR_NODE_DESTROYED(2) -> silent (the focused-node path
//                                  is the only user-facing signal
//                                  for the braille client; a
//                                  destroyed node is only redisplayed
//                                  if it WAS the focused node, which
//                                  the focus-tracker in the screen
//                                  reader will re-emit as a
//                                  SR_FOCUS_CHANGED to a sibling).
//          SR_TREE_DESTROYED(3) -> silent (the client teardown is
//                                  the screen reader's job; this
//                                  glue does not display "window
//                                  closed" -- the braille display's
//                                  cells go blank via the caller's
//                                  reset call, not via a per-teardown
//                                  automatic message).
//        event_kind > 3 refuses with SRB_BAD_EVENT (mirrors
//        screen_reader_protocol_event_valid's gate).
//
//   braille_client_reset(state_id) -> SRB_OK | SRB_BAD_STATE
//     -- Clears current_text_offset (writes 0), clears scroll_position
//        (writes 0), bumps SRB_ST_RESETS.  Does NOT free the row
//        (linear consume is braille_client_free's job) and does NOT
//        touch the (device, format, cell_count) binding (a reset is
//        a display-content clear, not a re-bind).
//
//   braille_client_free(state_id) -> SRB_OK | SRB_BAD_STATE
//     -- LINEAR consume: frees the row.  The caller MUST NOT reuse
//        state_id after this call.
//
// =============================================================================
// SECTION 6  FINGERPRINT
// =============================================================================
//
// One tag ending `[legacy: SCREEN READER BRAILLE META OK]` per softarch
// discipline (see feedback_paideia_as_reserved_labels-adjacent
// convention used by kind_tls_trust / kind_tui_canvas / kind_layer_tree /
// a11y/tree_kind / a11y/screen_reader_protocol / a11y/screen_reader_tts).
// Data-only at this landing; needs allowlisting in
// tools/verify-fingerprint-coverage.sh with reason
// "screen_reader_braille meta emit body not yet landed (Wave0-B11-05
// #2310)" until a future landing wires an emit site into
// braille_client_new's success tail via klog_s1_x1.  Allowlist wire-up
// is a separate landing per the batch's file-touch discipline (this
// landing is ONE file only).
//
// LABEL PREFIX: `screen_reader_braille_` throughout -- avoids paideia-as
// reserved-keyword collisions per feedback_paideia_as_reserved_labels;
// all ASM jump targets are `screen_reader_braille_<tag>`.

module ScreenReaderBraille = structure {

  // ==========================================================================
  // SECTION A  Identity + enums + sizing + failure taxonomy.
  // ==========================================================================

  // Row-pool sizing.
  pub let SRB_MAX_STATES     : u64 = 1      // one braille client.
  pub let SRB_ROW_BYTES      : u64 = 32     // half cache line.

  // Row byte offsets (within a 32-byte row).
  pub let SRB_ROW_OFF_HDR       : u64 = 0     // sr_sub | device
  pub let SRB_ROW_OFF_CURSOR    : u64 = 8     // text_offset | scroll_position
  pub let SRB_ROW_OFF_META      : u64 = 16    // format | cell_count | in_use
  pub let SRB_ROW_OFF_LAST_SEQ  : u64 = 24    // last_output_seq

  // BrailleCellFormat enum.
  pub let BC_6DOT             : u64 = 0
  pub let BC_8DOT             : u64 = 1
  pub let SRB_FORMAT_MAX      : u64 = 1

  // Physical-display cell-count bound.
  pub let SRB_CELL_MAX        : u64 = 256

  // Text bound (validator; keep the client from being asked to display
  // arbitrarily-long buffers at this fidelity).
  pub let SRB_TEXT_MAX        : u64 = 65536     // 64 KiB per display call.

  // Forward-reserved KIND ordinal for KIND_BRAILLE_DEVICE.  When a
  // future landing mints kind_braille_device.pdx the ordinal here
  // becomes a live KIND_BRAILLE_DEVICE cap slot; until then it is a
  // client-side hint constant only.  See §0 future-promotion path (a).
  pub let KIND_BRAILLE_DEVICE : u64 = 0x1E1

  // Failure taxonomy -- 0xFFFFEE51..0xFFFFEE5A (see file header §4).
  pub let SRB_OK              : u64 = 0
  pub let SRB_TAIL_ENOSPC     : u64 = 0xFFFFEE5A
  pub let SRB_BAD_SUB         : u64 = 0xFFFFEE59
  pub let SRB_BAD_DEVICE      : u64 = 0xFFFFEE58
  pub let SRB_BAD_FORMAT      : u64 = 0xFFFFEE57
  pub let SRB_BAD_CELL_COUNT  : u64 = 0xFFFFEE56
  pub let SRB_BAD_STATE       : u64 = 0xFFFFEE55
  pub let SRB_BAD_TEXT        : u64 = 0xFFFFEE54
  pub let SRB_BAD_EVENT       : u64 = 0xFFFFEE53

  // Screen-reader event ordinals -- MUST agree with
  // screen_reader_protocol.pdx §4 (SR_TREE_UPDATED..SR_TREE_DESTROYED).
  // Named locally so a future extension in screen_reader_protocol
  // (SR_EVENT_MAX bump) forces a synchronised landing here.
  pub let SRB_EV_TREE_UPDATED    : u64 = 0
  pub let SRB_EV_FOCUS_CHANGED   : u64 = 1
  pub let SRB_EV_NODE_DESTROYED  : u64 = 2
  pub let SRB_EV_TREE_DESTROYED  : u64 = 3
  pub let SRB_EV_MAX             : u64 = 3

  // Stats channels (six u64s of counters, bounds-checked against 6).
  pub let SRB_ST_DISPLAYS         : u64 = 0
  pub let SRB_ST_SCROLLS_FWD      : u64 = 1
  pub let SRB_ST_SCROLLS_BACK     : u64 = 2
  pub let SRB_ST_A11Y_EVENTS      : u64 = 3
  pub let SRB_ST_RESETS           : u64 = 4
  pub let SRB_ST_REFUSED          : u64 = 5

  // ==========================================================================
  // SECTION B  State cells.
  // ==========================================================================

  // Braille-client state-row pool.  SRB_MAX_STATES rows * 32 bytes =
  // 32 bytes = 4 u64.  Aligned to 64 so the (future) SRB_MAX_STATES
  // > 1 landing does not straddle a cache line for row 0.
  pub let mut _screen_reader_braille_rows  : [u64; 4]  = uninit @align(64)

  // Global stats.  Bounds-checked against 6 in _stats_bump / _stats_read.
  pub let mut _screen_reader_braille_stats : [u64; 6]  = uninit @align(64)

  // Fingerprint tag.  Data-only at this landing; needs allowlisting in
  // tools/verify-fingerprint-coverage.sh with reason
  // "screen_reader_braille meta emit body not yet landed (Wave0-B11-05
  // #2310)" until a future landing wires an emit site into
  // braille_client_new's success tail via klog_s1_x1.
  //
  // "pdx kind screen reader braille meta [legacy: SCREEN READER
  //  BRAILLE META OK]\0" = 75 bytes of payload + 1 NUL = 76 bytes.
  pub let pdx_kind_screen_reader_braille_meta : [u8; 76] = "pdx kind screen reader braille meta [legacy: SCREEN READER BRAILLE META OK]\0"

  // ==========================================================================
  // SECTION C  Validators (new-time / event-time).
  // ==========================================================================

  // screen_reader_braille_sub_valid(id) -> 1 iff id in (0, 2^32).
  // Mirrors screen_reader_tts_sub_valid's shape.
  pub let screen_reader_braille_sub_valid : (u64) -> u64 !{} @{} =
    fn (id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B11-05 (paideia-os #2310): 1 iff sr_sub_id in (0, 2^32). Zero refuses a free-floating braille client (there must be an active screen-reader subscription); >u32 refuses garbage. Labels prefixed screen_reader_braille_sv_.",
      block: {
        cmp rdi, 0;
        je  screen_reader_braille_sv_no;
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  screen_reader_braille_sv_no;
        mov rax, 1;
        ret;
      screen_reader_braille_sv_no:
        xor rax, rax;
        ret
      }
    }

  // screen_reader_braille_device_valid(id) -> 1 iff id in (0, 2^32).
  pub let screen_reader_braille_device_valid : (u64) -> u64 !{} @{} =
    fn (id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B11-05 (paideia-os #2310): 1 iff braille_device_kind_id in (0, 2^32). Zero refuses a free-floating client (a client MUST be bound to a KIND_BRAILLE_DEVICE cap slot to send cells); >u32 refuses garbage. Labels prefixed screen_reader_braille_dv_.",
      block: {
        cmp rdi, 0;
        je  screen_reader_braille_dv_no;
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  screen_reader_braille_dv_no;
        mov rax, 1;
        ret;
      screen_reader_braille_dv_no:
        xor rax, rax;
        ret
      }
    }

  // screen_reader_braille_format_valid(format) -> 1 iff format in
  // [0, SRB_FORMAT_MAX(1)].  Rejects garbage that would corrupt the
  // [7:0] byte of the meta word, or (worse) mislead the future
  // dispatch after a further enum extension shifts the ordinals.
  pub let screen_reader_braille_format_valid : (u64) -> u64 !{} @{} =
    fn (format: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B11-05 (paideia-os #2310): 1 iff format in [0, SRB_FORMAT_MAX(1)]. Labels prefixed screen_reader_braille_fv_.",
      block: {
        mov r10, 1;
        cmp rdi, r10;
        ja  screen_reader_braille_fv_no;
        mov rax, 1;
        ret;
      screen_reader_braille_fv_no:
        xor rax, rax;
        ret
      }
    }

  // screen_reader_braille_cell_count_valid(cell_count) -> 1 iff
  // cell_count in (0, SRB_CELL_MAX(256)].  Zero refuses a nonsense
  // display; >256 refuses garbage that would exceed the (future)
  // per-device send buffer's upper bound.
  pub let screen_reader_braille_cell_count_valid : (u64) -> u64 !{} @{} =
    fn (cell_count: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B11-05 (paideia-os #2310): 1 iff cell_count in (0, SRB_CELL_MAX(256)]. Zero refuses a nonsense display (a zero-cell display cannot render anything); >256 refuses garbage that exceeds the largest commercially shipped device (88 cells + status). Labels prefixed screen_reader_braille_cv_.",
      block: {
        cmp rdi, 0;
        je  screen_reader_braille_cv_no;
        mov r10, 256;
        cmp rdi, r10;
        ja  screen_reader_braille_cv_no;
        mov rax, 1;
        ret;
      screen_reader_braille_cv_no:
        xor rax, rax;
        ret
      }
    }

  // screen_reader_braille_text_valid(len) -> 1 iff len in
  // (0, SRB_TEXT_MAX].
  pub let screen_reader_braille_text_valid : (u64) -> u64 !{} @{} =
    fn (len: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B11-05 (paideia-os #2310): 1 iff text_len in (0, SRB_TEXT_MAX(65536)]. Zero refuses an empty display call (nothing to render); >SRB_TEXT_MAX refuses garbage-length that would exhaust the (future) device send buffer. Labels prefixed screen_reader_braille_tv_.",
      block: {
        cmp rdi, 0;
        je  screen_reader_braille_tv_no;
        mov r10, 65536;
        cmp rdi, r10;
        ja  screen_reader_braille_tv_no;
        mov rax, 1;
        ret;
      screen_reader_braille_tv_no:
        xor rax, rax;
        ret
      }
    }

  // screen_reader_braille_event_valid(ev) -> 1 iff ev <= SRB_EV_MAX(3).
  // MUST agree with screen_reader_protocol_event_valid at
  // screen_reader_protocol.pdx §C; a divergence here would let a
  // valid pushed event become an SRB_BAD_EVENT here (or worse, a
  // garbage event smuggled through here).
  pub let screen_reader_braille_event_valid : (u64) -> u64 !{} @{} =
    fn (ev: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B11-05 (paideia-os #2310): 1 iff ev in [0, SRB_EV_MAX(3)]. MUST agree with screen_reader_protocol_event_valid; a divergence here would let a valid pushed event become SRB_BAD_EVENT (or a garbage event pass through). Labels prefixed screen_reader_braille_evv_.",
      block: {
        mov r10, 3;
        cmp rdi, r10;
        ja  screen_reader_braille_evv_no;
        mov rax, 1;
        ret;
      screen_reader_braille_evv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // SECTION D  Packers (row header + cursor + meta encoders).
  // ==========================================================================

  // screen_reader_braille_pack_hdr(sr_sub_id, device_kind_id) ->
  //     sr_sub_id[31:0] | device_kind_id[63:32].
  pub let screen_reader_braille_pack_hdr : (u64, u64) -> u64 !{} @{} =
    fn (sr_sub_id: u64) (device_kind_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B11-05 (paideia-os #2310): pack row hdr word. sr_sub_id at [31:0] (u32 masked); device_kind_id at [63:32] (u32 masked then shifted). Labels prefixed screen_reader_braille_ph_.",
      block: {
        mov rax, rdi;
        and rax, 0xFFFFFFFF;
        mov r10, rsi;
        and r10, 0xFFFFFFFF;
        shl r10, 32;
        or  rax, r10;
        ret
      }
    }

  // screen_reader_braille_pack_cursor(text_offset, scroll_position) ->
  //     text_offset[31:0] | scroll_position[63:32].
  pub let screen_reader_braille_pack_cursor : (u64, u64) -> u64 !{} @{} =
    fn (text_offset: u64) (scroll_position: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B11-05 (paideia-os #2310): pack cursor word. text_offset at [31:0] (u32 masked); scroll_position at [63:32] (u32 masked then shifted). Labels prefixed screen_reader_braille_pcu_.",
      block: {
        mov rax, rdi;
        and rax, 0xFFFFFFFF;
        mov r10, rsi;
        and r10, 0xFFFFFFFF;
        shl r10, 32;
        or  rax, r10;
        ret
      }
    }

  // screen_reader_braille_pack_meta(format, cell_count) ->
  //     format[7:0] | cell_count[23:8] | reserved[55:24] | in_use[63:56]=0.
  // in_use bit is stamped by _row_alloc's success tail.
  pub let screen_reader_braille_pack_meta : (u64, u64) -> u64 !{} @{} =
    fn (format: u64) (cell_count: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B11-05 (paideia-os #2310): pack meta word. format at [7:0] (u8 masked); cell_count at [23:8] (u16 masked then shifted). Reserved bits [55:24] remain zero. in_use bit at [63:56] stamped by _row_alloc's success tail (left zero here). Labels prefixed screen_reader_braille_pm_.",
      block: {
        mov rax, rdi;
        and rax, 0xFF;
        mov r10, rsi;
        and r10, 0xFFFF;
        shl r10, 8;
        or  rax, r10;
        ret
      }
    }

  // ==========================================================================
  // SECTION E  Row address arithmetic + accessors.
  //
  // Row base = _screen_reader_braille_rows + row_id * 32 (shl 5).
  // Stride is power-of-two so no imul is emitted; the offset multiply
  // folds to a single shl.  Encoder-conservative per the file's no-imul-
  // when-shl-suffices convention.
  // ==========================================================================

  // screen_reader_braille_row_base(row_id) -> ptr | 0.
  pub let screen_reader_braille_row_base : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-05 (paideia-os #2310): row base pointer = _screen_reader_braille_rows + row_id * 32. Bounds-checked against SRB_MAX_STATES(1); OOB returns 0 (caller compares against zero before dereferencing). Labels prefixed screen_reader_braille_rb_.",
      block: {
        mov r10, 1;
        cmp rdi, r10;
        jae screen_reader_braille_rb_no;
        lea r10, [rip + _screen_reader_braille_rows];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, r10;
        ret;
      screen_reader_braille_rb_no:
        xor rax, rax;
        ret
      }
    }

  // screen_reader_braille_row_sub_id(row_base) -> sr_sub_id at hdr[31:0].
  pub let screen_reader_braille_row_sub_id : (u64) -> u64 !{mem} @{} =
    fn (row_base: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-05 (paideia-os #2310): read sr_sub_id from hdr[31:0]. Labels prefixed screen_reader_braille_rs_.",
      block: {
        mov rax, [rdi + 0];
        and rax, 0xFFFFFFFF;
        ret
      }
    }

  // screen_reader_braille_row_device(row_base) -> device_kind_id at
  // hdr[63:32].
  pub let screen_reader_braille_row_device : (u64) -> u64 !{mem} @{} =
    fn (row_base: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-05 (paideia-os #2310): read braille_device_kind_id from hdr[63:32]. Labels prefixed screen_reader_braille_rd_.",
      block: {
        mov rax, [rdi + 0];
        shr rax, 32;
        ret
      }
    }

  // screen_reader_braille_row_text_offset(row_base) -> text_offset at
  // cursor[31:0].
  pub let screen_reader_braille_row_text_offset : (u64) -> u64 !{mem} @{} =
    fn (row_base: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-05 (paideia-os #2310): read current_text_offset from cursor[31:0]. Labels prefixed screen_reader_braille_rto_.",
      block: {
        mov rax, [rdi + 8];
        and rax, 0xFFFFFFFF;
        ret
      }
    }

  // screen_reader_braille_row_scroll(row_base) -> scroll_position at
  // cursor[63:32].
  pub let screen_reader_braille_row_scroll : (u64) -> u64 !{mem} @{} =
    fn (row_base: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-05 (paideia-os #2310): read scroll_position from cursor[63:32]. Labels prefixed screen_reader_braille_rsc_.",
      block: {
        mov rax, [rdi + 8];
        shr rax, 32;
        ret
      }
    }

  // screen_reader_braille_row_format(row_base) -> format at meta[7:0].
  pub let screen_reader_braille_row_format : (u64) -> u64 !{mem} @{} =
    fn (row_base: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-05 (paideia-os #2310): read format (u8) from meta[7:0]. Labels prefixed screen_reader_braille_rf_.",
      block: {
        mov rax, [rdi + 16];
        and rax, 0xFF;
        ret
      }
    }

  // screen_reader_braille_row_cell_count(row_base) -> cell_count at
  // meta[23:8].
  pub let screen_reader_braille_row_cell_count : (u64) -> u64 !{mem} @{} =
    fn (row_base: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-05 (paideia-os #2310): read cell_count (u16) from meta[23:8]. Labels prefixed screen_reader_braille_rcc_.",
      block: {
        mov rax, [rdi + 16];
        shr rax, 8;
        and rax, 0xFFFF;
        ret
      }
    }

  // screen_reader_braille_row_last_seq(row_base) -> last_output_seq (u64).
  pub let screen_reader_braille_row_last_seq : (u64) -> u64 !{mem} @{} =
    fn (row_base: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-05 (paideia-os #2310): read last_output_seq (full u64) from row+24. Labels prefixed screen_reader_braille_rls_.",
      block: {
        mov rax, [rdi + 24];
        ret
      }
    }

  // ==========================================================================
  // SECTION F  Row-pool primitives (valid / alloc / free).
  // ==========================================================================

  // screen_reader_braille_row_valid(row_id) -> 1 iff row_id <
  // SRB_MAX_STATES AND in_use bit set (meta[63:56]).
  pub let screen_reader_braille_row_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-05 (paideia-os #2310): 1 iff row_id < SRB_MAX_STATES(1) AND in_use (meta[63:56] != 0). Row address = _screen_reader_braille_rows + row_id * 32; *32 uses shl 5. Labels prefixed screen_reader_braille_rvl_.",
      block: {
        mov r10, 1;
        cmp rdi, r10;
        jae screen_reader_braille_rvl_no;
        lea r10, [rip + _screen_reader_braille_rows];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 56;
        cmp rax, 0;
        je  screen_reader_braille_rvl_no;
        mov rax, 1;
        ret;
      screen_reader_braille_rvl_no:
        xor rax, rax;
        ret
      }
    }

  // screen_reader_braille_row_alloc(hdr, meta) -> row_id | SRB_TAIL_ENOSPC.
  //
  // hdr:  _pack_hdr output  (sr_sub_id at [31:0], device at [63:32]).
  // meta: _pack_meta output (format at [7:0], cell_count at [23:8],
  //                          in_use=0).
  //
  // Low-first scan; the found row's in_use bit is stamped by ORing
  // 1<<56 into meta on the claim path.  cursor starts at 0 (both
  // text_offset and scroll_position zero), last_output_seq starts at 0.
  //
  // Three callee-save pushes (rbx=idx, r12=hdr, r13=meta) + sub rsp,8
  // = 32 B => entry rsp%16==8, +32 = %16==8 (no nested call in the
  // scan body, so this is the correct alignment for the ret).
  pub let screen_reader_braille_row_alloc : (u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (meta: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-05 (paideia-os #2310): claim one braille-client state row. Low-first scan (rbx=idx) over SRB_MAX_STATES(1) rows of 32 bytes. Three callee-save pushes (rbx=idx, r12=hdr, r13=meta) + sub rsp,8 = 32 B => entry rsp%16==8, +32 = %16==8 which suits the no-nested-call scan. Labels prefixed screen_reader_braille_ra_.",
      block: {
        push rbx;
        push r12;
        push r13;
        sub  rsp, 8;

        mov  r12, rdi;                       // hdr
        mov  r13, rsi;                       // meta

        xor  rbx, rbx;
      screen_reader_braille_ra_scan:
        cmp  rbx, 1;
        jae  screen_reader_braille_ra_enospc;

        lea  r10, [rip + _screen_reader_braille_rows];
        mov  r11, rbx;
        shl  r11, 5;
        add  r10, r11;

        // Check in_use at meta[63:56] (row+16, top byte).
        mov  rax, [r10 + 16];
        shr  rax, 56;
        cmp  rax, 0;
        je   screen_reader_braille_ra_claim;

        add  rbx, 1;
        jmp  screen_reader_braille_ra_scan;

      screen_reader_braille_ra_claim:
        // Write hdr (row+0) as-is.
        mov  [r10 + 0], r12;

        // cursor = (text_offset=0, scroll_position=0).
        xor  rax, rax;
        mov  [r10 + 8], rax;

        // Stamp in_use bit into meta, write row+16.
        mov  rax, r13;
        mov  r11, 1;
        shl  r11, 56;
        or   rax, r11;
        mov  [r10 + 16], rax;

        // last_output_seq = 0.
        xor  rax, rax;
        mov  [r10 + 24], rax;

        mov  rax, rbx;                       // row_id
        jmp  screen_reader_braille_ra_out;

      screen_reader_braille_ra_enospc:
        mov  rax, 0xFFFFEE5A;                // SRB_TAIL_ENOSPC

      screen_reader_braille_ra_out:
        add  rsp, 8;
        pop  r13;
        pop  r12;
        pop  rbx;
        ret
      }
    }

  // screen_reader_braille_row_free(row_id): scrub row (all 4 words).
  // Bounds-checked.
  pub let screen_reader_braille_row_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-05 (paideia-os #2310): scrub one braille-client row (all 4 u64 words). Bounds-checked against SRB_MAX_STATES(1). Labels prefixed screen_reader_braille_rfr_.",
      block: {
        mov  r10, 1;
        cmp  rdi, r10;
        jae  screen_reader_braille_rfr_out;
        lea  r10, [rip + _screen_reader_braille_rows];
        mov  r11, rdi;
        shl  r11, 5;
        add  r10, r11;
        xor  rax, rax;
        mov  [r10 + 0],  rax;
        mov  [r10 + 8],  rax;
        mov  [r10 + 16], rax;
        mov  [r10 + 24], rax;
      screen_reader_braille_rfr_out:
        ret
      }
    }

  // ==========================================================================
  // SECTION G  braille_client_new
  //
  // braille_client_new(sr_sub_id, braille_device_kind_id, format,
  //                    cell_count) -> state_id
  //      | SRB_BAD_SUB | SRB_BAD_DEVICE | SRB_BAD_FORMAT
  //      | SRB_BAD_CELL_COUNT | SRB_TAIL_ENOSPC.
  //
  // Four inputs so we go straight to five callee-save pushes
  // (rbx=sub, r12=device, r13=format, r14=cell_count, r15=packed).
  // Five 8-byte pushes flip entry rsp%16==8 to rsp%16==0 -- every
  // nested `call` sees the aligned slot every SysV callee needs.
  // No further pad required.
  //
  // Refusal path funnels through screen_reader_braille_new_refused
  // and bumps SRB_ST_REFUSED once.
  // ==========================================================================

  pub let braille_client_new : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (sr_sub_id: u64) (braille_device_kind_id: u64) (format: u64) (cell_count: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-05 (paideia-os #2310): claim one braille-client state row bound to (sr_sub, device) with (format, cell_count). Five callee-save pushes (rbx=sub, r12=device, r13=format, r14=cell_count, r15=packed-word slot) preserve SysV alignment: entry rsp%16==8, five 8-byte pushes give rsp%16==0 which every nested `call` needs at the callsite. Refusal funnel bumps SRB_ST_REFUSED once. Labels prefixed screen_reader_braille_new_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov  rbx, rdi;                       // sr_sub_id
        mov  r12, rsi;                       // braille_device_kind_id
        mov  r13, rdx;                       // format
        mov  r14, rcx;                       // cell_count

        // (1) sr_sub_id valid?
        mov  rdi, rbx;
        call screen_reader_braille_sub_valid;
        cmp  rax, 0;
        je   screen_reader_braille_new_bad_sub;

        // (2) braille_device_kind_id valid?
        mov  rdi, r12;
        call screen_reader_braille_device_valid;
        cmp  rax, 0;
        je   screen_reader_braille_new_bad_device;

        // (3) format valid?
        mov  rdi, r13;
        call screen_reader_braille_format_valid;
        cmp  rax, 0;
        je   screen_reader_braille_new_bad_format;

        // (4) cell_count valid?
        mov  rdi, r14;
        call screen_reader_braille_cell_count_valid;
        cmp  rax, 0;
        je   screen_reader_braille_new_bad_cell_count;

        // (5) pack hdr.
        mov  rdi, rbx;
        mov  rsi, r12;
        call screen_reader_braille_pack_hdr;
        mov  r15, rax;                       // hdr

        // (6) pack meta (format, cell_count; in_use=0).
        mov  rdi, r13;
        mov  rsi, r14;
        call screen_reader_braille_pack_meta;
        //     rax = meta

        // (7) claim a row.
        mov  rdi, r15;                       // hdr
        mov  rsi, rax;                       // meta
        call screen_reader_braille_row_alloc;

        // If _row_alloc returned SRB_TAIL_ENOSPC (>= SRB_MAX_STATES),
        // fail through the refusal funnel.
        mov  r10, 1;
        cmp  rax, r10;
        jae  screen_reader_braille_new_enospc;

        // Success: return row_id.
        jmp  screen_reader_braille_new_out;

      screen_reader_braille_new_bad_sub:
        mov  rax, 0xFFFFEE59;                // SRB_BAD_SUB
        jmp  screen_reader_braille_new_refused;
      screen_reader_braille_new_bad_device:
        mov  rax, 0xFFFFEE58;                // SRB_BAD_DEVICE
        jmp  screen_reader_braille_new_refused;
      screen_reader_braille_new_bad_format:
        mov  rax, 0xFFFFEE57;                // SRB_BAD_FORMAT
        jmp  screen_reader_braille_new_refused;
      screen_reader_braille_new_bad_cell_count:
        mov  rax, 0xFFFFEE56;                // SRB_BAD_CELL_COUNT
        jmp  screen_reader_braille_new_refused;
      screen_reader_braille_new_enospc:
        // rax already holds SRB_TAIL_ENOSPC from _row_alloc.

      screen_reader_braille_new_refused:
        // Bump SRB_ST_REFUSED, preserve sentinel across the note call.
        mov  rbx, rax;
        mov  rdi, 5;                         // SRB_ST_REFUSED
        call screen_reader_braille_stats_bump;
        mov  rax, rbx;

      screen_reader_braille_new_out:
        pop  r15;
        pop  r14;
        pop  r13;
        pop  r12;
        pop  rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION H  braille_client_display_text
  //
  // braille_client_display_text(state_id, text_offset, text_len)
  //     -> output_seq | SRB_BAD_STATE | SRB_BAD_TEXT.
  //
  // Records (text_offset, text_len) as the current display line
  // (writes text_offset to cursor[31:0]), resets scroll_position
  // to 0 (writes cursor[63:32] = 0), bumps last_output_seq and
  // returns the post-bump value.  AT THIS LANDING the device
  // send-path is NOT wired: the return value is the seq the future
  // device-send landing will use as the audit-record key.
  //
  // Four callee-save pushes (rbx=state_id, r12=text_offset,
  // r13=text_len, r14=row_base) leave rsp%16==8 -- every nested
  // call site is wrapped with sub rsp,8 / add rsp,8 to pad to
  // %16==0.
  // ==========================================================================

  pub let braille_client_display_text : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (state_id: u64) (text_offset: u64) (text_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-05 (paideia-os #2310): record (text_offset, text_len), reset scroll_position to 0, bump last_output_seq and return the post-bump value; the device send-path is not wired at this landing (the seq is the audit-record key a future landing will attach the device dispatch to). text_len is preserved in r13 across the stats bump so a future landing that stores the length in the reserved-header window can pick it up without a signature change. Four callee-save pushes (rbx=state_id, r12=text_offset, r13=text_len, r14=row_base) leave rsp%16==8; every nested call site gets a sub rsp,8 pad so the callee sees rsp%16==0. Labels prefixed screen_reader_braille_dt_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov  rbx, rdi;                       // state_id
        mov  r12, rsi;                       // text_offset
        mov  r13, rdx;                       // text_len (validated only for bounds; length preserved for the future dispatch)

        // (1) state row valid?
        sub  rsp, 8;
        mov  rdi, rbx;
        call screen_reader_braille_row_valid;
        add  rsp, 8;
        cmp  rax, 0;
        je   screen_reader_braille_dt_bad_state;

        // (2) text_len valid?
        sub  rsp, 8;
        mov  rdi, r13;
        call screen_reader_braille_text_valid;
        add  rsp, 8;
        cmp  rax, 0;
        je   screen_reader_braille_dt_bad_text;

        // (3) row_base.
        sub  rsp, 8;
        mov  rdi, rbx;
        call screen_reader_braille_row_base;
        add  rsp, 8;
        cmp  rax, 0;
        je   screen_reader_braille_dt_bad_state;
        mov  r14, rax;                       // row_base

        // (4) write cursor = (text_offset, scroll_position=0).
        //     text_offset masked to u32 at [31:0]; scroll_position = 0 at
        //     [63:32].  (Reset-on-new-line semantics -- the caller who
        //     wants scroll preserved MUST reissue the previous display
        //     with the desired offset.)
        mov  rax, r12;
        and  rax, 0xFFFFFFFF;
        mov  [r14 + 8], rax;

        // (5) bump last_output_seq (load-inc-store on row+24, u64-wide).
        mov  rax, [r14 + 24];
        add  rax, 1;
        mov  [r14 + 24], rax;

        // (6) bump SRB_ST_DISPLAYS, preserve output_seq across the call.
        mov  rbx, rax;                       // save seq
        sub  rsp, 8;
        mov  rdi, 0;                         // SRB_ST_DISPLAYS
        call screen_reader_braille_stats_bump;
        add  rsp, 8;
        mov  rax, rbx;                       // return seq
        jmp  screen_reader_braille_dt_out;

      screen_reader_braille_dt_bad_state:
        mov  rax, 0xFFFFEE55;                // SRB_BAD_STATE
        jmp  screen_reader_braille_dt_out;
      screen_reader_braille_dt_bad_text:
        mov  rax, 0xFFFFEE54;                // SRB_BAD_TEXT

      screen_reader_braille_dt_out:
        pop  r14;
        pop  r13;
        pop  r12;
        pop  rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION I  braille_client_scroll_forward / _back
  //
  // Both return u8 (0 or 1): 0 == at boundary / no advance, 1 == advanced.
  // Bad state_id folds to 0 (safe fallback -- see file header §4
  // SCROLL SEMANTICS).
  //
  // _scroll_forward: scroll_position += cell_count; returns 0 if the
  // advance would overflow u32-max (this landing's sole "at end"
  // signal in the absence of a stored text_len), else 1.
  //
  // _scroll_back:    scroll_position -= cell_count (clamped to 0);
  //                  returns 0 if scroll_position == 0 on entry
  //                  ("already at start"), else 1.
  //
  // Two callee-save pushes (rbx=state_id, r12=row_base) leave
  // rsp%16==8; every nested call site is wrapped with sub rsp,8 /
  // add rsp,8 to pad to %16==0.
  // ==========================================================================

  pub let braille_client_scroll_forward : (u64) -> u64 !{mem} @{} =
    fn (state_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-05 (paideia-os #2310): advance scroll_position by cell_count. Returns 0 iff at end (scroll_position + cell_count > u32-max at this landing's fidelity; a future landing that stores text_len tightens this to (scroll_position + cell_count > text_len)). Returns 1 on advance. Bad state_id folds to 0 (safe fallback). Two callee-save pushes leave rsp%16==8; nested call sites pad with sub rsp,8 / add rsp,8. Labels prefixed screen_reader_braille_sf_.",
      block: {
        push rbx;
        push r12;

        mov  rbx, rdi;                       // state_id

        // (1) state row valid? Bad state_id folds to 0.
        sub  rsp, 8;
        mov  rdi, rbx;
        call screen_reader_braille_row_valid;
        add  rsp, 8;
        cmp  rax, 0;
        je   screen_reader_braille_sf_zero;

        // (2) row_base.
        sub  rsp, 8;
        mov  rdi, rbx;
        call screen_reader_braille_row_base;
        add  rsp, 8;
        cmp  rax, 0;
        je   screen_reader_braille_sf_zero;
        mov  r12, rax;                       // row_base

        // (3) read scroll_position (u32 at cursor[63:32]) and
        //     cell_count (u16 at meta[23:8]).
        mov  rax, [r12 + 8];
        shr  rax, 32;
        and  rax, 0xFFFFFFFF;                // scroll_position (u32)
        mov  r10, rax;                       // r10 = scroll_position

        mov  rax, [r12 + 16];
        shr  rax, 8;
        and  rax, 0xFFFF;                    // cell_count (u16)
        mov  r11, rax;                       // r11 = cell_count

        // (4) new_scroll = scroll_position + cell_count.
        //     If new_scroll > u32-max -> at end, return 0 (no advance).
        mov  rax, r10;
        add  rax, r11;
        mov  r10, 0xFFFFFFFF;
        cmp  rax, r10;
        ja   screen_reader_braille_sf_at_end;

        // (5) write new scroll_position back into cursor[63:32],
        //     preserving text_offset at cursor[31:0].
        //     mask = ~(0xFFFFFFFF << 32) = 0x00000000FFFFFFFF.
        mov  r10, [r12 + 8];
        and  r10, 0xFFFFFFFF;                // keep text_offset
        mov  r11, rax;                       // new scroll_position
        shl  r11, 32;
        or   r10, r11;
        mov  [r12 + 8], r10;

        // (6) bump SRB_ST_SCROLLS_FWD.
        sub  rsp, 8;
        mov  rdi, 1;                         // SRB_ST_SCROLLS_FWD
        call screen_reader_braille_stats_bump;
        add  rsp, 8;

        mov  rax, 1;                         // advanced
        jmp  screen_reader_braille_sf_out;

      screen_reader_braille_sf_at_end:
        // No-advance path: still bump the stats counter so the future
        // landing observes at-end pressure (the counter is scroll-CALLS,
        // not scroll-BYTES).  Row state is unchanged.
        sub  rsp, 8;
        mov  rdi, 1;                         // SRB_ST_SCROLLS_FWD
        call screen_reader_braille_stats_bump;
        add  rsp, 8;
        xor  rax, rax;                       // at end -> 0
        jmp  screen_reader_braille_sf_out;

      screen_reader_braille_sf_zero:
        xor  rax, rax;                       // bad state -> 0 (safe fallback)

      screen_reader_braille_sf_out:
        pop  r12;
        pop  rbx;
        ret
      }
    }

  pub let braille_client_scroll_back : (u64) -> u64 !{mem} @{} =
    fn (state_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-05 (paideia-os #2310): reduce scroll_position by cell_count, clamped to 0. Returns 0 iff already at start (scroll_position == 0 on entry). Returns 1 on retreat. Bad state_id folds to 0 (safe fallback). Two callee-save pushes leave rsp%16==8; nested call sites pad with sub rsp,8 / add rsp,8. Labels prefixed screen_reader_braille_sb_.",
      block: {
        push rbx;
        push r12;

        mov  rbx, rdi;                       // state_id

        // (1) state row valid? Bad state_id folds to 0.
        sub  rsp, 8;
        mov  rdi, rbx;
        call screen_reader_braille_row_valid;
        add  rsp, 8;
        cmp  rax, 0;
        je   screen_reader_braille_sb_zero;

        // (2) row_base.
        sub  rsp, 8;
        mov  rdi, rbx;
        call screen_reader_braille_row_base;
        add  rsp, 8;
        cmp  rax, 0;
        je   screen_reader_braille_sb_zero;
        mov  r12, rax;                       // row_base

        // (3) read scroll_position (u32 at cursor[63:32]) and
        //     cell_count (u16 at meta[23:8]).
        mov  rax, [r12 + 8];
        shr  rax, 32;
        and  rax, 0xFFFFFFFF;                // scroll_position (u32)
        mov  r10, rax;                       // r10 = scroll_position

        // (4) if scroll_position == 0 -> already at start, return 0.
        cmp  r10, 0;
        je   screen_reader_braille_sb_at_start;

        mov  rax, [r12 + 16];
        shr  rax, 8;
        and  rax, 0xFFFF;                    // cell_count (u16)
        mov  r11, rax;                       // r11 = cell_count

        // (5) new_scroll = scroll_position - cell_count, clamped to 0.
        //     If cell_count >= scroll_position -> new_scroll = 0.
        cmp  r11, r10;
        jae  screen_reader_braille_sb_clamp;
        // scroll_position > cell_count: subtract normally.
        mov  rax, r10;
        sub  rax, r11;
        jmp  screen_reader_braille_sb_store;

      screen_reader_braille_sb_clamp:
        xor  rax, rax;                       // clamp to 0

      screen_reader_braille_sb_store:
        // (6) write new scroll_position back into cursor[63:32],
        //     preserving text_offset at cursor[31:0].
        mov  r10, [r12 + 8];
        and  r10, 0xFFFFFFFF;                // keep text_offset
        mov  r11, rax;                       // new scroll_position
        shl  r11, 32;
        or   r10, r11;
        mov  [r12 + 8], r10;

        // (7) bump SRB_ST_SCROLLS_BACK.
        sub  rsp, 8;
        mov  rdi, 2;                         // SRB_ST_SCROLLS_BACK
        call screen_reader_braille_stats_bump;
        add  rsp, 8;

        mov  rax, 1;                         // retreated
        jmp  screen_reader_braille_sb_out;

      screen_reader_braille_sb_at_start:
        // No-retreat path: still bump the stats counter so the future
        // landing observes at-start pressure.  Row state is unchanged.
        sub  rsp, 8;
        mov  rdi, 2;                         // SRB_ST_SCROLLS_BACK
        call screen_reader_braille_stats_bump;
        add  rsp, 8;
        xor  rax, rax;                       // at start -> 0
        jmp  screen_reader_braille_sb_out;

      screen_reader_braille_sb_zero:
        xor  rax, rax;                       // bad state -> 0 (safe fallback)

      screen_reader_braille_sb_out:
        pop  r12;
        pop  rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION J  braille_client_on_a11y_event
  //
  // braille_client_on_a11y_event(state_id, event_kind, node_id)
  //     -> SRB_OK | SRB_BAD_STATE | SRB_BAD_EVENT.
  //
  // Dispatches on ScreenReaderEvent (see file header §5 catalogue).
  //
  // FOCUS_CHANGED / TREE_UPDATED bump the a11y-events counter (the
  // actual display call routes through a future KIND_A11Y_TREE walk
  // that is not landed at this fidelity); NODE_DESTROYED and
  // TREE_DESTROYED are silent by UX design (see §5).  node_id is
  // preserved as a stats-bump argument the future landing will pass
  // into the label lookup.
  //
  // Three callee-save pushes (rbx=state_id, r12=event_kind,
  // r13=node_id) leave rsp%16==0 -- every nested `call` sees the
  // aligned slot every SysV callee needs.
  // ==========================================================================

  pub let braille_client_on_a11y_event : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (state_id: u64) (event_kind: u64) (node_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-05 (paideia-os #2310): dispatch on ScreenReaderEvent. FOCUS_CHANGED(1) and TREE_UPDATED(0) bump SRB_ST_A11Y_EVENTS (the actual display call routes through a KIND_A11Y_TREE walk that is not landed at this fidelity); NODE_DESTROYED(2) and TREE_DESTROYED(3) are silent by UX design (see file header §5). event_kind > SRB_EV_MAX(3) refuses with SRB_BAD_EVENT (mirrors screen_reader_protocol_event_valid's gate; a divergence would let a valid pushed event fail here). node_id is preserved in r13 as the stats-bump argument the future landing will pass into the label lookup. Three callee-save pushes leave rsp%16==0. Labels prefixed screen_reader_braille_ev_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov  rbx, rdi;                       // state_id
        mov  r12, rsi;                       // event_kind
        mov  r13, rdx;                       // node_id

        // (1) state row valid?
        mov  rdi, rbx;
        call screen_reader_braille_row_valid;
        cmp  rax, 0;
        je   screen_reader_braille_ev_bad_state;

        // (2) event_kind valid?
        mov  rdi, r12;
        call screen_reader_braille_event_valid;
        cmp  rax, 0;
        je   screen_reader_braille_ev_bad_event;

        // (3) Dispatch.
        //     0 (SRB_EV_TREE_UPDATED) / 1 (SRB_EV_FOCUS_CHANGED)
        //     bump the events counter; 2 / 3 are silent.
        mov  r10, 1;
        cmp  r12, r10;                       // ev <= 1 ?
        ja   screen_reader_braille_ev_silent;

        mov  rdi, 3;                         // SRB_ST_A11Y_EVENTS
        call screen_reader_braille_stats_bump;

      screen_reader_braille_ev_silent:
        xor  rax, rax;                       // SRB_OK
        jmp  screen_reader_braille_ev_out;

      screen_reader_braille_ev_bad_state:
        mov  rax, 0xFFFFEE55;                // SRB_BAD_STATE
        jmp  screen_reader_braille_ev_out;
      screen_reader_braille_ev_bad_event:
        mov  rax, 0xFFFFEE53;                // SRB_BAD_EVENT

      screen_reader_braille_ev_out:
        pop  r13;
        pop  r12;
        pop  rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION K  braille_client_reset
  //
  // braille_client_reset(state_id) -> SRB_OK | SRB_BAD_STATE.
  //
  // Clears current_text_offset (writes 0), clears scroll_position
  // (writes 0), bumps SRB_ST_RESETS.  Does NOT free the row (linear
  // consume is _free's job) and does NOT touch the (device, format,
  // cell_count) binding (a reset is a display-content clear, not a
  // re-bind).
  //
  // Two callee-save pushes (rbx=state_id, r12=row_base) leave
  // rsp%16==8; nested call sites are wrapped with sub rsp,8 /
  // add rsp,8 to pad to %16==0.
  // ==========================================================================

  pub let braille_client_reset : (u64) -> u64 !{mem} @{} =
    fn (state_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-05 (paideia-os #2310): clear cursor (text_offset=0, scroll_position=0), bump SRB_ST_RESETS. Does NOT free the row and does NOT touch the (device, format, cell_count) binding. Two callee-save pushes leave rsp%16==8; nested call sites pad with sub rsp,8 / add rsp,8. Labels prefixed screen_reader_braille_rst_.",
      block: {
        push rbx;
        push r12;

        mov  rbx, rdi;                       // state_id

        // (1) state row valid?
        sub  rsp, 8;
        mov  rdi, rbx;
        call screen_reader_braille_row_valid;
        add  rsp, 8;
        cmp  rax, 0;
        je   screen_reader_braille_rst_bad_state;

        // (2) row_base.
        sub  rsp, 8;
        mov  rdi, rbx;
        call screen_reader_braille_row_base;
        add  rsp, 8;
        cmp  rax, 0;
        je   screen_reader_braille_rst_bad_state;
        mov  r12, rax;                       // row_base

        // (3) clear cursor (both text_offset and scroll_position).
        xor  rax, rax;
        mov  [r12 + 8], rax;

        // (4) bump SRB_ST_RESETS.
        sub  rsp, 8;
        mov  rdi, 4;                         // SRB_ST_RESETS
        call screen_reader_braille_stats_bump;
        add  rsp, 8;

        xor  rax, rax;                       // SRB_OK
        jmp  screen_reader_braille_rst_out;

      screen_reader_braille_rst_bad_state:
        mov  rax, 0xFFFFEE55;                // SRB_BAD_STATE

      screen_reader_braille_rst_out:
        pop  r12;
        pop  rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION L  braille_client_free  (LINEAR consume)
  //
  // braille_client_free(state_id) -> SRB_OK | SRB_BAD_STATE.
  //
  // LINEAR consume: the caller MUST NOT reuse state_id after this
  // call.  A second free on the same id returns SRB_BAD_STATE (the
  // row is no longer in_use, so _row_valid returns 0).
  //
  // One callee-save push (rbx=state_id): entry rsp%16==8, one 8-byte
  // push gives rsp%16==0 -- the value every nested `call` needs at
  // the callsite.  No further pad required.
  // ==========================================================================

  pub let braille_client_free : (u64) -> u64 !{mem} @{} =
    fn (state_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-05 (paideia-os #2310): LINEAR-consume one braille-client state row. state_id >= SRB_MAX_STATES(1) OR row not in_use -> SRB_BAD_STATE; else free + return SRB_OK. One callee-save push leaves rsp%16==0 which matches SysV call alignment; no further pad needed. Labels prefixed screen_reader_braille_fr_.",
      block: {
        push rbx;
        mov  rbx, rdi;                       // state_id

        // OOB or already-freed row?
        mov  rdi, rbx;
        call screen_reader_braille_row_valid;
        cmp  rax, 0;
        je   screen_reader_braille_fr_bad_state;

        // Free the row.
        mov  rdi, rbx;
        call screen_reader_braille_row_free;

        xor  rax, rax;                       // SRB_OK
        jmp  screen_reader_braille_fr_out;

      screen_reader_braille_fr_bad_state:
        mov  rax, 0xFFFFEE55;                // SRB_BAD_STATE

      screen_reader_braille_fr_out:
        pop  rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION M  Stats + init.
  // ==========================================================================

  pub let screen_reader_braille_stats_bump : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-05 (paideia-os #2310): bounds-checked counter bump against SRB_ST_REFUSED+1=6. Load-inc-store idiom (no `add reg, [mem]`). Labels prefixed screen_reader_braille_sb_.",
      block: {
        cmp rdi, 6;
        jae screen_reader_braille_sb_out;
        lea r10, [rip + _screen_reader_braille_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      screen_reader_braille_sb_out:
        ret
      }
    }

  pub let screen_reader_braille_stats_read : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-05 (paideia-os #2310): bounds-checked counter read; OOB -> 0. Labels prefixed screen_reader_braille_st_.",
      block: {
        cmp rdi, 6;
        jae screen_reader_braille_st_zero;
        lea r10, [rip + _screen_reader_braille_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      screen_reader_braille_st_zero:
        xor rax, rax;
        ret
      }
    }

  // screen_reader_braille_init(): zero row pool + stats.  Defensive
  // re-scrub; .bss is already zero at real boot.  Mirrors
  // screen_reader_tts_init's shape.
  pub let screen_reader_braille_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-05 (paideia-os #2310): zero _screen_reader_braille_rows (4 u64) + _screen_reader_braille_stats (6 u64). Defensive; .bss is already zero at real boot. Labels prefixed screen_reader_braille_ini_.",
      block: {
        lea r10, [rip + _screen_reader_braille_rows];
        xor rax, rax;
        xor rcx, rcx;
      screen_reader_braille_ini_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  screen_reader_braille_ini_rows;

        lea r10, [rip + _screen_reader_braille_stats];
        xor rcx, rcx;
      screen_reader_braille_ini_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 6;
        jb  screen_reader_braille_ini_stats;
        ret
      }
    }
}
