// src/user/a11y/elaboration_gate.pdx -- Wave0-B14 G10-M3-001 (paideia-os #2307)
//
// COMPOSITOR-SIDE ELABORATION GATE FOR THE P4 A11Y INVARIANT.
//
// Companion / precedent:
//   * src/user/compositor/window_kind.pdx (Wave0-B6-05, paideia-os
//     #2254) already carries an UNCONDITIONAL structural gate at
//     window_mint: WIN_MINT_NO_A11Y (0xFFFFEAA9) fires whenever
//     a11y_tree_kind_id == 0, with no escape hatch of any kind. That
//     landing is the "P4 STRUCTURAL GATE" the design doc calls
//     mandatory per #2305.
//   * src/user/compositor/a11y_bind_at_mint.pdx (Wave0-B9-08,
//     paideia-os #2305) is the FRIENDLY WRAPPER around that gate: it
//     autobinds a fresh KIND_A11Y_TREE when a caller does not supply
//     one, turning "callers must remember" into "callers cannot
//     avoid it". Neither file has a mode concept -- the refusal is
//     unconditional in both directions.
//   * src/user/a11y/tree_kind.pdx (Wave0-B8-03, paideia-os #2302)
//     defines KIND_A11Y_TREE = 0x1D3, the cap this gate checks for.
//
// THIS landing does NOT replace either precedent's runtime refusal.
// It adds the layer those two files cannot provide on their own: a
// POLICY-CONFIGURABLE gate with an auditable, self-latching bootstrap
// escape. design/compositor/pwp-spec-vocabulary.md §2.21 cites BOTH
// issues for a reason -- "mandatory per #2305" is the hard rule,
// "elaboration fails without a subtree per #2307" is the term this
// codebase uses elsewhere (pwp-spec-vocabulary.md §"Every buffer that
// carries an image has Cap<KIND_COLOR_PROFILE> ... the surface commit
// fails elaboration without it"; also "a driver claiming !{mmio_read}
// without holding an MmioMemCap fails elaboration") for a STRUCTURAL,
// compiler-adjacent check on a required capability pairing. paideia-as
// does not yet expose an arbitrary "this cap requires that other cap
// at the same mint site" elaboration primitive as a language feature,
// so this file is the RUNTIME STAND-IN: the same invariant, enforced
// as a callable gate rather than a static witness, with the mode
// toggle window_kind.pdx's own inline check cannot offer.
//
// WHY A SEPARATE MODE-AWARE LAYER, GIVEN #2254 ALREADY REFUSES
// UNCONDITIONALLY: the compositor's own bootstrap sequence has a
// chicken-and-egg problem window_kind.pdx's hard refusal cannot solve
// by itself -- the very first windows minted while the a11y subsystem
// is still coming up have nowhere to get a MEANINGFUL subtree from.
// a11y_bind_at_mint.pdx's autobind covers the common case (mint an
// empty-but-real tree), but a bring-up ordering where the tree
// substrate itself is not yet live needs an explicit, narrow, AUDITED
// escape -- not a silent hole. PERMISSIVE mode (§3) is that escape.
//
// NOVEL-CLEAN DESIGN COMMITMENT. A11Y IS NOT OPTIONAL: every window
// ships with a real (even minimal) accessibility subtree, and there
// is no "add later" or bolt-on path (the codebase already documents
// this convention as the "P4" gate). What this file adds is not an
// exception to that commitment but its BOOTSTRAP-SAFE ENFORCEMENT
// MECHANISM: PERMISSIVE mode exists ONLY to unblock a narrow, self-
// auditing early-boot window, is off (STRICT) by default, and once
// the boot sequence explicitly re-commits to STRICT it can NEVER be
// switched back to PERMISSIVE for the remainder of the boot session
// (§3's one-way latch). A caller cannot silently regress a11y
// enforcement after declaring itself production-ready. §3's DENSITY
// escalation closes the remaining gap: even while PERMISSIVE is
// still unlatched, more than EGATE_DENSE_THRESHOLD consecutive misses
// in a row is treated as a systemic bug rather than transient
// bootstrap noise, and is hard-refused regardless of mode.
//
// GATE CONSUMER PATH IS A STUB AT THIS LANDING. elaboration_gate_check
// is a complete, callable, independently-testable function, but
// window_kind.pdx's window_mint body is NOT touched by this landing
// (out of scope; see the task's own file-touch discipline) and so
// does not yet call it. The actual wire-in -- swapping (or layering)
// window_kind.pdx's inline WIN_MINT_NO_A11Y check for a call into
// elaboration_gate_check -- is G10-M3-002. Until that lands, this
// module is reachable only from a future test/witness driver; the
// P4 invariant in production boots continues to be enforced by
// window_kind.pdx's own unconditional inline check exactly as today.
//
// =============================================================================
// SECTION 0  ORDINAL CHOICE  --  0x1E3 (renumbered from 0x1E2 post-batch
// to resolve the parallel grep-race with kind_a11y_node.pdx #2303, which
// landed with 0x1E2 first. The narrative below documents the pre-race
// view; the actual claim is 0x1E3 -- one past kind_a11y_node, and the
// slot the sibling mutation_log.pdx #2304 header had already forward-
// reserved for this file by name.)
// =============================================================================
//
// The task's primary hint band (0x1B8..0x1DE, per design/graphics/
// r101-kernel-plan.md's G7+ tail summary) is densely claimed by the
// compositor/color/input_server/ime wave (KIND_SURFACE 0x1B8 through
// KIND_IME_ROUTER 0x1DE; verified via `grep -rhoE
// "0x1[BCD][0-9A-Fa-f]" src/kernel src/user` at landing time). Per the
// task's own fallback instruction, this landing extends into the
// second band (0x1E0..0x1FF) instead of hunting for a gap in the
// first -- and that band already has a live precedent to extend:
//
//   0x1E0  KIND_TTS_ENGINE      (Wave0-B10-07 #2309, forward-reserved
//                                 in src/user/a11y/screen_reader_tts.pdx)
//   0x1E1  KIND_BRAILLE_DEVICE  (Wave0-B11-05 #2310, forward-reserved
//                                 in src/user/a11y/screen_reader_braille.pdx)
//   0x1E2  KIND_A11Y_ELABORATION_GATE  (this landing) -- first free,
//                                 verified via `grep -rhoE "0x1E[0-9A-Fa-f]"
//                                 src/` returning only 0x1E0/0x1E1/0x1ED
//                                 at landing time.
//
// FORWARD RESERVATION for the two named siblings this task warns
// against colliding with (neither exists in the tree yet as of this
// landing -- confirmed by `grep -rln "kind_a11y_node\|mutation_log"
// src/` returning nothing):
//
//   0x1E3  KIND_A11Y_NODE        (B14-06, kind_a11y_node.pdx) --
//                                 r10-kickoff.md §"KIND_A11Y_NODE --
//                                 derived over KIND_MEMORY".
//   0x1E4  KIND_A11Y_MUTATION_LOG (B14-07, mutation_log.pdx) -- the
//                                 per-tree mutation-commit log named
//                                 in pwp-spec-vocabulary.md's linearity
//                                 table ("KIND_A11Y_TREE mutation log
//                                 commits linearly at the boundary").
//
// These two reservations are advisory only (this file has no
// authority over what B14-06/07 actually land at); the mechanism that
// makes the reservation load-bearing is the grep step every sibling
// landing in this wave is instructed to run before it picks a slot.
// If a sibling lands first and takes a different slot, that landing's
// own ORDINAL CHOICE section is authoritative -- update this comment,
// not the other way around.
//
// =============================================================================
// SECTION 1  MODULE POSTURE
// =============================================================================
//
// LOGIC MODULE, NOT A LIVE CAP. Like screen_reader_tts.pdx /
// screen_reader_braille.pdx, KIND_A11Y_ELABORATION_GATE is a
// forward-reserved ordinal at this landing -- there is no row pool,
// no rights bitmask, no op catalog, no cap_handler routing, and the
// constant is not wired into cap_table. A future promotion that mints
// this as a real cap (one per compositor instance, or one per
// window -- undecided; see the OPEN QUESTION below) would give
// elaboration_gate_check a live substrate identity in place of the
// bare ordinal.
//
// SINGLETON STATE, NOT A ROW POOL. Unlike a per-window or per-client
// module (TTS/braille each pool one row per assistive-tech client),
// this gate has exactly ONE state cell for the whole compositor: mode
// and the consecutive-fires streak are process-wide policy, not
// per-window data. There is therefore no row_id argument anywhere in
// this file's API, no row_alloc/row_free, and no bounds-checked row
// address arithmetic -- every accessor reads/writes the single
// _egate_state cell directly by fixed offset.
//
// OPEN QUESTION for G10-M3-002 (explicitly NOT resolved here): should
// elaboration_gate_check's signature stay (window_id, a11y_tree_cap_id)
// as a pure function of its two arguments (this landing's choice,
// which keeps the gate stateless with respect to the CALLER's
// identity and trivially unit-testable), or should a promoted
// KIND_A11Y_ELABORATION_GATE cap carry per-caller-process policy
// (e.g. a driver process explicitly opted into PERMISSIVE for its own
// mints only, without touching the compositor-global mode)? This
// landing takes the simpler global-singleton shape because it is the
// one G10-M3-002 can wire in without any additional design decisions;
// a per-caller variant is a strictly bigger interface a future
// landing can grow into without breaking this one (the two functions
// below would gain, not lose, arguments).
//
// =============================================================================
// SECTION 2  STATE LAYOUT
// =============================================================================
//
// _egate_state -- ONE row, 32 bytes (4 u64 words, half a cache line).
// Every field is stored as a FULL u64 word rather than packed into
// sub-word bit ranges: this is a singleton, not a scaled row pool, so
// there is no memory-density pressure to justify byte-packing, and
// full-width fields let every accessor below skip AND-masking
// entirely (no `and reg, imm64` anywhere in this file; see §6).
//
//   [+0]  mode:              EGATE_MODE_STRICT(0) | EGATE_MODE_PERMISSIVE(1).
//                             Semantically a u8 (only two legal
//                             values; see the schema note below);
//                             stored full-width for the reason above.
//   [+8]  init_flag:         0 = elaboration_gate_init() has not run;
//                             1 = it has. NEEDED because mode's own
//                             default value (0 = STRICT) is ALSO a
//                             legal, meaningful configured value --
//                             unlike every sibling a11y module, where
//                             .bss-zero-at-boot is already the safe
//                             default and no separate "was this ever
//                             initialized" bit is required, THIS
//                             module's zero value is ambiguous between
//                             "never configured" and "explicitly
//                             STRICT". init_flag disambiguates the two
//                             so EGATE_NOT_INIT is a reachable,
//                             meaningful refusal rather than dead code.
//   [+16] locked_flag:       0 = unlocked (a PERMISSIVE request is
//                             still honoured); 1 = latched (see §3's
//                             one-way commitment device). Reset to 0
//                             by elaboration_gate_init() only -- i.e.
//                             once per boot.
//   [+24] consecutive_fires: u64, monotone within a "miss streak".
//                             Bumped on every FAIL check, reset to 0
//                             on every PASS check. Feeds the density
//                             escalation in §3.
//
// _egate_stats -- 48 bytes (6 u64 counters), indices EGATE_ST_*:
//
//   [0] PASSES              -- check found a nonzero companion cap.
//   [1] FIRES               -- check found NO companion cap (any mode).
//   [2] STRICT_REFUSED      -- FIRES that resulted in a hard refusal
//                               (mode == STRICT, streak still within
//                               the density budget).
//   [3] PERMISSIVE_ALLOWED  -- FIRES that were let through under the
//                               debug-bootstrap escape (mode ==
//                               PERMISSIVE, streak still within
//                               budget). THIS is "the stats counter
//                               for gate-fires" the task calls out
//                               specifically -- every permissive
//                               escape is individually auditable.
//   [4] DENSE_REFUSED       -- FIRES that were hard-refused by the
//                               density escalation regardless of mode.
//   [5] reserved            -- headroom; not written by this landing.
//
// =============================================================================
// SECTION 3  MODE SCHEMA + THE ONE-WAY COMMITMENT DEVICE
// =============================================================================
//
// EGATE_MODE_STRICT (0)     -- production default. elaboration_gate_
//                              check hard-refuses (EGATE_WIN_NO_SUBTREE)
//                              any mint with no companion a11y subtree.
// EGATE_MODE_PERMISSIVE (1) -- debug-bootstrap ONLY. A missing subtree
//                              is counted (PERMISSIVE_ALLOWED) but the
//                              check still returns EGATE_OK, letting
//                              the caller's mint proceed.
//
// elaboration_gate_init() always resets mode to STRICT(0) and
// locked_flag to 0 (unlocked). This is deliberate: a bootstrap script
// that legitimately needs the escape hatch must ASK for it explicitly
// via one elaboration_gate_mode_set(EGATE_MODE_PERMISSIVE) call after
// init; PERMISSIVE is never the silent starting posture.
//
// THE LATCH. elaboration_gate_mode_set(EGATE_MODE_STRICT) sets
// locked_flag = 1 as a side effect, EVERY time it is called (including
// the very first call, even if mode was already STRICT). From that
// point until the next elaboration_gate_init(), any further
// elaboration_gate_mode_set(EGATE_MODE_PERMISSIVE) call is refused
// with EGATE_STRICT_REFUSED -- the mode cannot be relaxed again. A
// bootstrap sequence therefore gets exactly one escape window: mint
// whatever it needs under PERMISSIVE, then call mode_set(STRICT) to
// declare "bootstrap is over" -- a declaration that cannot be walked
// back for the rest of the boot session. This is the "no add-later or
// bolt-on path" commitment made mechanical rather than aspirational.
//
// THE DENSITY ESCALATION. EGATE_DENSE_THRESHOLD (3) tolerates up to
// three consecutive misses (bootstrap noise: three windows minted in
// a burst before the tree substrate catches up, say) before the
// FOURTH consecutive miss is treated as a systemic bug rather than
// transient noise -- EGATE_REFUSED_DENSE fires unconditionally, in
// EITHER mode, even if locked_flag is still 0 and PERMISSIVE is still
// nominally in effect. This closes the one gap the latch alone does
// not: an unbounded run of PERMISSIVE misses BEFORE the bootstrap
// script ever gets around to calling mode_set(STRICT) is not, in
// fact, unbounded.
//
// =============================================================================
// SECTION 4  FAILURE TAXONOMY  --  0xFFFFE880..0xFFFFE88F
// =============================================================================
//
// Pre-assigned band per the task; verified free via
// `grep -rhoE "0xFFFFE88[0-9A-Fa-f]" src/` returning empty at landing
// time. Seven values used; 0xFFFFE887..0xFFFFE88F (9 slots) reserved
// for a future landing.
//
//   EGATE_OK              = 0            (canonical success)
//   EGATE_NULL             0xFFFFE880    window_id == 0 (nothing to gate)
//   EGATE_NOT_INIT         0xFFFFE881    elaboration_gate_init() has
//                                        not run yet (§2's init_flag)
//   EGATE_MODE_INVALID     0xFFFFE882    mode_set argument > 1
//   EGATE_STRICT_REFUSED   0xFFFFE883    mode_set(PERMISSIVE) refused
//                                        by the §3 one-way latch
//   EGATE_WIN_NO_SUBTREE   0xFFFFE884    check() hard refusal: mode ==
//                                        STRICT, no companion cap,
//                                        streak within budget. THIS is
//                                        the value the task's scope
//                                        text names -- "mint FAILS
//                                        with WIN_NO_A11Y_SUBTREE" --
//                                        under this module's own
//                                        EGATE_ prefix; G10-M3-002
//                                        decides how window_kind.pdx
//                                        surfaces it to its own caller.
//   EGATE_REFUSED_DENSE    0xFFFFE885    check() hard refusal: the §3
//                                        density escalation, any mode
//   EGATE_STATS_OVERFLOW   0xFFFFE886    a stats counter was already
//                                        at u64::MAX; the bump (and
//                                        the caller's whole check())
//                                        is refused rather than
//                                        silently wrapping the audit
//                                        trail (see §5 stats_bump)
//
// =============================================================================
// SECTION 5  FUNCTION CATALOGUE
// =============================================================================
//
//   elaboration_gate_init() -> ()
//     -- Zero _egate_state and _egate_stats; mode = STRICT(0),
//        init_flag = 1, locked_flag = 0, consecutive_fires = 0.
//        Defensive re-scrub (.bss is already zero at real boot);
//        mirrors screen_reader_tts_init's shape. MUST be called
//        before the first elaboration_gate_check or
//        elaboration_gate_mode_set call, or both refuse with
//        EGATE_NOT_INIT.
//
//   elaboration_gate_mode_set(new_mode) -> EGATE_OK | EGATE_NOT_INIT
//                                         | EGATE_MODE_INVALID
//                                         | EGATE_STRICT_REFUSED
//     -- Validates new_mode in {0, 1}. Refuses a PERMISSIVE request
//        once the §3 latch is set. Setting STRICT always succeeds and
//        always sets the latch (idempotent -- setting STRICT twice in
//        a row is not an error).
//
//   elaboration_gate_check(window_id, a11y_tree_cap_id)
//                                         -> EGATE_OK | EGATE_NULL
//                                          | EGATE_NOT_INIT
//                                          | EGATE_WIN_NO_SUBTREE
//                                          | EGATE_REFUSED_DENSE
//                                          | EGATE_STATS_OVERFLOW
//     -- THE gate. a11y_tree_cap_id != 0 is treated as "the mint
//        request carries a companion KIND_A11Y_TREE cap" and always
//        passes (resets the miss streak, bumps PASSES). a11y_tree_
//        cap_id == 0 is a miss: bumps FIRES, bumps the miss streak,
//        and then resolves to EGATE_REFUSED_DENSE / EGATE_WIN_NO_
//        SUBTREE / EGATE_OK per §3's mode + density rules. A stats-
//        counter overflow at any bump point short-circuits the WHOLE
//        check with EGATE_STATS_OVERFLOW before the mode/density
//        decision is made -- see stats_bump's own note on why this
//        is a hard stop rather than a best-effort counter.
//
//   elaboration_gate_stats_bump(which) -> EGATE_OK | EGATE_STATS_OVERFLOW
//     -- Bounds-checked (OOB `which` is a silent EGATE_OK no-op; the
//        five call sites in elaboration_gate_check all pass a literal
//        in-range index, so OOB is defensive-only and should never be
//        reached in practice). Refuses to bump a counter already at
//        u64::MAX rather than silently wrapping it back to zero --
//        wrapping an audit counter is worse than refusing the
//        operation it would have recorded, because a wrapped counter
//        LIES about how many times the gate has fired. At one
//        increment per gate check, reaching u64::MAX is not a
//        practical concern; the guard exists so the failure mode, if
//        the underlying assumption is ever wrong, is a loud refusal
//        instead of a silently corrupted telemetry stream.
//
//   elaboration_gate_stats_read(which) -> counter value | 0 (OOB)
//     -- Plain bounds-checked read; mirrors every sibling module's
//        own *_stats_read.
//
// =============================================================================
// SECTION 6  FINGERPRINT + ENCODER DISCIPLINE
// =============================================================================
//
// One tag ending `[legacy: A11Y ELABORATION GATE INIT OK]` per
// softarch discipline. Data-only at this landing -- no emit site
// calls klog with it yet (the gate consumer path is a stub per the
// file header; a real emit site is a G10-M3-002 concern, once there
// is a real caller whose success tail can carry it). Needs
// allowlisting in tools/verify-fingerprint-coverage.sh with reason
// "Wave0-B14 G10-M3-001 (#2307): elaboration_gate stub landing; gate
// consumer path (window_kind mint) not yet wired" until that lands.
//
// Every field in _egate_state is a full u64 word (§2), so this file
// contains NO bit-masking AND at all -- the `and r11, imm64` pitfall
// (AND has no imm64-immediate encoding) simply does not arise. No
// `test rN,rN` (every zero-check is `cmp rN, 0`). No 2-op `imul`
// (this file never multiplies). No `neg`/`cqo`/`idiv` (no signed
// division anywhere). No `add reg, [mem]` (every memory update is the
// load-into-register / add / store-back idiom, e.g. stats_bump's
// `mov rax, [r10+rdi*8]; add rax, 1; mov [r10+rdi*8], rax`). The one
// overflow check needing a value that does not fit an imm32 sign-
// extension (u64::MAX) uses `not r11; cmp r11, 0` instead of a 64-bit
// immediate compare (CMP has no imm64 form either) -- `not` on the
// loaded counter is zero only when every bit was already 1.
//
// elaboration_gate_check is the only function in this file that
// issues a `call` (five call sites, all into elaboration_gate_stats_
// bump). It carries ZERO callee-save pushes: every value needed after
// a call is re-derived from memory (`lea r10, [rip + _egate_state]`)
// rather than kept live across the call in a register, so there is
// nothing to save. Entry rsp%16==8 (the SysV callee convention this
// whole tree assumes); each call site is individually wrapped with
// `sub rsp, 8` / `call` / `add rsp, 8` to present the callee rsp%16==0
// exactly as SysV requires -- never a bare `push reg; call; pop reg`.
// Every other function in this file (init/mode_set/stats_bump/
// stats_read) makes no nested call at all, so their entry rsp%16==8
// is simply never touched.
//
// LABEL PREFIX: `egate_` throughout -- avoids paideia-as reserved-
// keyword collisions per feedback_paideia_as_reserved_labels; every
// jump target is `egate_<fn-abbrev>_<tag>`.

module ElaborationGate = structure {

  // ==========================================================================
  // SECTION A  Identity + schema + failure taxonomy.
  // ==========================================================================

  // Forward-reserved KIND ordinal (§0/§1). Not wired into cap_table at
  // this landing.
  pub let KIND_A11Y_ELABORATION_GATE : u64 = 0x1E3

  // _egate_state field offsets (§2).
  pub let EGATE_STATE_OFF_MODE   : u64 = 0
  pub let EGATE_STATE_OFF_INIT   : u64 = 8
  pub let EGATE_STATE_OFF_LOCKED : u64 = 16
  pub let EGATE_STATE_OFF_STREAK : u64 = 24

  // Mode schema (§3). Semantically u8; stored full-width (§2).
  pub let EGATE_MODE_STRICT     : u64 = 0
  pub let EGATE_MODE_PERMISSIVE : u64 = 1

  // Density escalation threshold (§3): the 4th consecutive miss (i.e.
  // streak > 3) hard-refuses regardless of mode.
  pub let EGATE_DENSE_THRESHOLD : u64 = 3

  // _egate_stats channel indices (§2).
  pub let EGATE_ST_PASSES             : u64 = 0
  pub let EGATE_ST_FIRES              : u64 = 1
  pub let EGATE_ST_STRICT_REFUSED     : u64 = 2
  pub let EGATE_ST_PERMISSIVE_ALLOWED : u64 = 3
  pub let EGATE_ST_DENSE_REFUSED      : u64 = 4
  pub let EGATE_STATS_COUNT           : u64 = 6

  // Failure taxonomy -- 0xFFFFE880..0xFFFFE88F (see file header §4).
  pub let EGATE_OK              : u64 = 0
  pub let EGATE_NULL            : u64 = 0xFFFFE880
  pub let EGATE_NOT_INIT        : u64 = 0xFFFFE881
  pub let EGATE_MODE_INVALID    : u64 = 0xFFFFE882
  pub let EGATE_STRICT_REFUSED  : u64 = 0xFFFFE883
  pub let EGATE_WIN_NO_SUBTREE  : u64 = 0xFFFFE884
  pub let EGATE_REFUSED_DENSE   : u64 = 0xFFFFE885
  pub let EGATE_STATS_OVERFLOW  : u64 = 0xFFFFE886

  // ==========================================================================
  // SECTION B  State cells.
  // ==========================================================================

  // Singleton gate state, 32 bytes (4 u64 words). See §2 for the
  // per-field rationale (esp. why init_flag exists alongside mode).
  pub let mut _egate_state : [u64; 4] = uninit @align(64)

  // Global stats, 48 bytes (6 u64 counters). See §2 / §5.
  pub let mut _egate_stats : [u64; 6] = uninit @align(64)

  // Fingerprint tag. Data-only at this landing; needs allowlisting in
  // tools/verify-fingerprint-coverage.sh (see file header §6) until a
  // future landing wires an emit site into the gate's consumer path.
  //
  // "a11y elaboration gate init ok [legacy: A11Y ELABORATION GATE
  //  INIT OK]\0" = 69 bytes of payload + 1 NUL = 70 bytes.
  pub let pdx_kind_a11y_elaboration_gate_meta : [u8; 70] = "a11y elaboration gate init ok [legacy: A11Y ELABORATION GATE INIT OK]\0"

  // ==========================================================================
  // SECTION C  elaboration_gate_init
  //
  // Zero _egate_state + _egate_stats; mode = STRICT(0), init_flag = 1,
  // locked_flag = 0, consecutive_fires = 0. No calls, no push/pop --
  // leaf function, entry alignment is never exercised.
  // ==========================================================================

  pub let elaboration_gate_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B14 G10-M3-001 (paideia-os #2307): zero the singleton gate state (mode=STRICT, init_flag=1, locked_flag=0, consecutive_fires=0) and the 6-counter stats row. Defensive re-scrub; .bss is already zero at real boot except init_flag, which this call is what actually sets to 1 (see file header §2 on why init_flag cannot just default via .bss zero — mode's own zero value is a legal configured state, not an absence marker). Leaf, no calls, no push/pop. Labels prefixed egate_ini_.",
      block: {
        lea r10, [rip + _egate_state];
        xor rax, rax;
        mov [r10 + 0], rax;             // mode = STRICT
        mov r11, 1;
        mov [r10 + 8], r11;             // init_flag = 1
        mov [r10 + 16], rax;            // locked_flag = 0
        mov [r10 + 24], rax;            // consecutive_fires = 0

        lea r10, [rip + _egate_stats];
        xor rcx, rcx;
      egate_ini_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 6;
        jb  egate_ini_stats;
        ret
      }
    }

  // ==========================================================================
  // SECTION D  elaboration_gate_stats_bump / elaboration_gate_stats_read
  //
  // Both leaf, bounds-checked against EGATE_STATS_COUNT(6), no calls.
  // stats_bump additionally guards against wrapping a counter already
  // at u64::MAX (see file header §5/§6 for why: refuse rather than
  // silently corrupt the audit trail). The overflow test uses `not`
  // + `cmp reg, 0` rather than a 64-bit immediate compare (CMP has no
  // imm64 form).
  // ==========================================================================

  pub let elaboration_gate_stats_bump : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B14 G10-M3-001 (paideia-os #2307): bounds-checked counter bump against EGATE_STATS_COUNT(6); OOB which is a silent EGATE_OK no-op (defensive only -- every call site in this file passes a literal in-range index). Refuses (EGATE_STATS_OVERFLOW) rather than wraps a counter already at u64::MAX: overflow test is `mov r11, rax; not r11; cmp r11, 0; je overflow` (r11 is all-zero iff rax was all-ones), avoiding a 64-bit immediate CMP (no imm64 encoding for CMP). Load-inc-store idiom, no `add reg, [mem]`. Leaf, no calls. Labels prefixed egate_sb_.",
      block: {
        cmp rdi, 6;
        jae egate_sb_noop;
        lea r10, [rip + _egate_stats];
        mov rax, [r10 + rdi * 8];
        mov r11, rax;
        not r11;
        cmp r11, 0;
        je  egate_sb_overflow;
        add rax, 1;
        mov [r10 + rdi * 8], rax;
        xor rax, rax;                   // EGATE_OK
        ret;
      egate_sb_overflow:
        mov rax, 0xFFFFE886;            // EGATE_STATS_OVERFLOW
        ret;
      egate_sb_noop:
        xor rax, rax;                   // EGATE_OK (OOB, defensive)
        ret
      }
    }

  pub let elaboration_gate_stats_read : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B14 G10-M3-001 (paideia-os #2307): bounds-checked counter read against EGATE_STATS_COUNT(6); OOB -> 0. Leaf, no calls. Labels prefixed egate_st_.",
      block: {
        cmp rdi, 6;
        jae egate_st_zero;
        lea r10, [rip + _egate_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      egate_st_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // SECTION E  elaboration_gate_mode_set
  //
  // elaboration_gate_mode_set(new_mode) -> EGATE_OK | EGATE_NOT_INIT
  //                                       | EGATE_MODE_INVALID
  //                                       | EGATE_STRICT_REFUSED
  //
  // Validates new_mode in {0, 1}. Setting STRICT(0) always succeeds
  // and sets locked_flag = 1 (the §3 one-way latch), even if already
  // STRICT (idempotent). Setting PERMISSIVE(1) succeeds only while
  // locked_flag == 0. Leaf, no calls, no push/pop needed.
  // ==========================================================================

  pub let elaboration_gate_mode_set : (u64) -> u64 !{mem} @{} =
    fn (new_mode: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B14 G10-M3-001 (paideia-os #2307): validate new_mode in {0,1} (EGATE_MODE_INVALID otherwise, via `mov r11,1; cmp rdi,r11; ja bad` -- rdi>1 is the only invalid case since rdi is unsigned). Requesting PERMISSIVE(1) while locked_flag is set refuses with EGATE_STRICT_REFUSED (file header §3's one-way commitment device). Requesting STRICT(0) always succeeds and (re-)sets locked_flag = 1, latching out any future PERMISSIVE request until the next elaboration_gate_init(). Refuses EGATE_NOT_INIT before elaboration_gate_init() has run. Leaf, no calls. Labels prefixed egate_ms_.",
      block: {
        lea r10, [rip + _egate_state];
        mov rax, [r10 + 8];              // init_flag
        cmp rax, 0;
        je  egate_ms_not_init;

        mov r11, 1;
        cmp rdi, r11;
        ja  egate_ms_bad_mode;

        cmp rdi, 1;
        jne egate_ms_store;

        mov rax, [r10 + 16];             // locked_flag
        cmp rax, 0;
        je  egate_ms_store;

        mov rax, 0xFFFFE883;             // EGATE_STRICT_REFUSED
        ret;

      egate_ms_store:
        mov [r10 + 0], rdi;              // mode = new_mode
        cmp rdi, 0;
        jne egate_ms_ok;
        mov r11, 1;
        mov [r10 + 16], r11;             // locked_flag = 1 (latch on STRICT)
      egate_ms_ok:
        xor rax, rax;                    // EGATE_OK
        ret;

      egate_ms_bad_mode:
        mov rax, 0xFFFFE882;             // EGATE_MODE_INVALID
        ret;

      egate_ms_not_init:
        mov rax, 0xFFFFE881;             // EGATE_NOT_INIT
        ret
      }
    }

  // ==========================================================================
  // SECTION F  elaboration_gate_check
  //
  // elaboration_gate_check(window_id, a11y_tree_cap_id)
  //     -> EGATE_OK | EGATE_NULL | EGATE_NOT_INIT | EGATE_WIN_NO_SUBTREE
  //      | EGATE_REFUSED_DENSE | EGATE_STATS_OVERFLOW.
  //
  // THE gate (file header §5). ZERO callee-save pushes: every value
  // needed after a `call elaboration_gate_stats_bump` is re-derived
  // from memory rather than kept live in a register, so entry
  // rsp%16==8 is preserved between calls and each of the five call
  // sites is individually padded with `sub rsp,8` / `add rsp,8` to
  // present rsp%16==0 to the callee, per SysV (file header §6).
  // ==========================================================================

  pub let elaboration_gate_check : (u64, u64) -> u64 !{mem} @{} =
    fn (window_id: u64) (a11y_tree_cap_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B14 G10-M3-001 (paideia-os #2307): the P4 elaboration gate. window_id==0 -> EGATE_NULL. Uninitialized module -> EGATE_NOT_INIT. a11y_tree_cap_id!=0 -> PASS: reset the miss streak, bump PASSES, return EGATE_OK. a11y_tree_cap_id==0 -> FAIL: bump FIRES (propagating EGATE_STATS_OVERFLOW immediately if the counter was saturated, before any mode/density decision -- file header §5's 'hard stop, not best-effort' rule), bump the miss streak, then resolve via file header §3: streak > EGATE_DENSE_THRESHOLD(3) -> EGATE_REFUSED_DENSE regardless of mode; else mode==STRICT -> EGATE_WIN_NO_SUBTREE; else (PERMISSIVE) -> EGATE_OK with PERMISSIVE_ALLOWED bumped. Zero callee-save pushes: every post-call value is re-derived via a fresh `lea r10, [rip + _egate_state]` rather than kept live across a `call`, so each of the five call sites is individually wrapped `sub rsp,8` / `call` / `add rsp,8` to present the callee rsp%16==0 from the unmodified entry rsp%16==8 -- never a bare push/call/pop. Labels prefixed egate_ck_.",
      block: {
        // (1) init guard.
        lea r10, [rip + _egate_state];
        mov rax, [r10 + 8];              // init_flag
        cmp rax, 0;
        je  egate_ck_not_init;

        // (2) null window_id guard.
        cmp rdi, 0;
        je  egate_ck_null;

        // (3) branch on presence of the companion a11y subtree cap.
        cmp rsi, 0;
        jne egate_ck_pass;

        // ------------------------------------------------------------
        // FAIL: no companion KIND_A11Y_TREE cap in this mint request.
        // ------------------------------------------------------------
        sub rsp, 8;
        mov rdi, 1;                      // EGATE_ST_FIRES
        call elaboration_gate_stats_bump;
        add rsp, 8;
        cmp rax, 0;
        jne egate_ck_out;                // propagate EGATE_STATS_OVERFLOW

        lea r10, [rip + _egate_state];
        mov rax, [r10 + 24];             // consecutive_fires
        add rax, 1;
        mov [r10 + 24], rax;

        mov r11, 3;                      // EGATE_DENSE_THRESHOLD
        cmp rax, r11;
        jbe egate_ck_mode_check;

        sub rsp, 8;
        mov rdi, 4;                      // EGATE_ST_DENSE_REFUSED
        call elaboration_gate_stats_bump;
        add rsp, 8;
        cmp rax, 0;
        jne egate_ck_out;
        mov rax, 0xFFFFE885;             // EGATE_REFUSED_DENSE
        jmp egate_ck_out;

      egate_ck_mode_check:
        lea r10, [rip + _egate_state];
        mov rax, [r10 + 0];              // mode
        cmp rax, 0;
        jne egate_ck_permissive;

        sub rsp, 8;
        mov rdi, 2;                      // EGATE_ST_STRICT_REFUSED
        call elaboration_gate_stats_bump;
        add rsp, 8;
        cmp rax, 0;
        jne egate_ck_out;
        mov rax, 0xFFFFE884;             // EGATE_WIN_NO_SUBTREE
        jmp egate_ck_out;

      egate_ck_permissive:
        sub rsp, 8;
        mov rdi, 3;                      // EGATE_ST_PERMISSIVE_ALLOWED
        call elaboration_gate_stats_bump;
        add rsp, 8;
        jmp egate_ck_out;                // rax already EGATE_OK or overflow sentinel

      egate_ck_pass:
        lea r10, [rip + _egate_state];
        xor rax, rax;
        mov [r10 + 24], rax;             // reset consecutive_fires

        sub rsp, 8;
        mov rdi, 0;                      // EGATE_ST_PASSES
        call elaboration_gate_stats_bump;
        add rsp, 8;
        jmp egate_ck_out;                // rax already EGATE_OK or overflow sentinel

      egate_ck_null:
        mov rax, 0xFFFFE880;             // EGATE_NULL
        jmp egate_ck_out;

      egate_ck_not_init:
        mov rax, 0xFFFFE881;             // EGATE_NOT_INIT

      egate_ck_out:
        ret
      }
    }
}
