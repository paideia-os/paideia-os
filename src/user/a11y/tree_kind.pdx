// src/user/a11y/tree_kind.pdx -- Wave0-B8-03 (paideia-os #2302)
//
// KIND_A11Y_TREE = 0x1D3, derived cap over KIND_MEMORY (= slot 4).
// Design authority: design/compositor/pwp-spec-vocabulary.md §2.21
// (KIND_A11Y_TREE -- AccessKit-shape: nodes with role/state/value/edges).
//
// Companion / precedent:
//   * src/user/compositor/window_kind.pdx (Wave0-B6-05, paideia-os #2254)
//     defines KIND_WINDOW = 0x1C1 and the P4 STRUCTURAL GATE that refuses
//     any KIND_WINDOW mint whose a11y_tree_kind_id is zero. This file
//     supplies the KIND that populates that field: every live KIND_WINDOW
//     was minted after a KIND_A11Y_TREE (this KIND) had already been
//     minted for it. There is NO codepath that grows a window without
//     an a11y tree binding.
//   * src/user/compositor/layer_tree.pdx (Wave0-B6-06, paideia-os #2256)
//     is the sealed tree-shape cap this file mirrors: identical row-pool
//     + arena-pool + validator + packer + accessor shape, adapted for
//     the a11y semantic domain (roles/states/edges instead of layers/
//     damage-bboxes/subtree-seq).
//
// =============================================================================
// SECTION 0  WHY THIS KIND EXISTS
// =============================================================================
//
// A11Y IS A FIRST-CLASS PROTOCOL PARTICIPANT, NOT A SIDECAR.  The novel-
// clean posture of the PaideiaOS compositor vocabulary (see spec §2.6 +
// §2.21 and the P4 mitigation register row) makes accessibility part of
// the mint contract: a window that cannot be described in an a11y tree
// cannot exist. This file is the substrate that makes that contract
// buildable -- until a KIND_A11Y_TREE row is minted for a window, no
// KIND_WINDOW row can be populated pointing at it. The chicken/egg is
// resolved by minting the a11y tree FIRST (with the window_kind_id it
// will later be bound to) and then minting the window with that a11y-
// tree slot.
//
// AccessKit-SHAPE.  AccessKit (Bevy/Chromium/Firefox lineage) treats
// an a11y tree as a rooted DAG of typed nodes with (role, state, value,
// label, description, edges). This file lands the ROLE + STATE + NODE
// STRUCT + TREE HEADER at Wave 0 fidelity: the sixteen roles enumerated
// in §A cover the essential UI vocabulary (window, button, label,
// textbox, checkbox, list/list-item, link, menu/menu-item, heading,
// paragraph, image, table/cell) and the eight state bits cover the
// mandatory AccessKit state channels (focused, disabled, hidden,
// selected, checked, expanded, readonly, required). The `value` field
// (a numeric or textual value distinct from `label`) lands as a u32
// intern offset alongside `label` in the node's fourth word so a slider
// or a spinbox row carries both name and quantity. Further AccessKit
// state channels (busy, invalid, live-region, ...) can extend the state
// mask upward (bits 8..63 are reserved in the packed word) without a
// row-shape break.
//
// SEALED SUBTREE.  Like KIND_LAYER_TREE (§2.6), this cap is SEALED:
// external actors never hold RIGHT_MINT on this KIND. The compositor is
// the only mint-authorised holder; screen readers subscribe (via
// RIGHT_SUBSCRIBE) but never mutate. Cross-window a11y observability
// is a distinct capability (a subscriber can hold OBSERVE on multiple
// tree caps; the tree never exposes a foreign window's tree through
// its own edges).
//
// REVOCATION.  Bound at window mint; revoked when the window is
// destroyed. window_kind.pdx §Section 10 (window_revoke) is the caller
// that triggers a11y_tree_revoke on the row this file allocates. A tree
// whose window has been revoked is unreachable (no live cap points at
// it) and its row is freed for reuse.
//
// =============================================================================
// SECTION 1  KIND_* SLOT ALLOCATION
// =============================================================================
//
// Consulted `design/architecture/next-wave-derived-kinds.md` §"Summary
// counts and free bands" at landing plus a repo-wide grep over
// src/**/*.pdx for `0x1D[0-9A-Fa-f]` at landing time:
//
//   0x1D0  RESERVATION_HOLDER_KIND       (recovery_plane_reserve.pdx)
//   0x1D1  RP_COMPOSITOR_KIND_FORWARD    (recovery_plane_reserve.pdx)
//   0x1D2  (reserved for KIND_WORKSPACE  -- next-wave slot, not yet
//           landed; grep shows no live claim in src/, but the task
//           row for this landing pins it as reserved and this file
//           MUST NOT collide with it).
//   0x1D3  KIND_A11Y_TREE                (this file)
//
// 0x1D3 is free at landing time (verified: no other src/ file names it
// as a KIND identifier). Downstream siblings that share the 0x1Dxx band
// -- KIND_A11Y_NODE (§2.22 of the spec, follow-on landing) will take
// 0x1D4 by the same allocation-monotone rule the layer_tree/window/
// workspace neighbourhood already follows.
//
// =============================================================================
// SECTION 2  DERIVATION OVER KIND_MEMORY  (SEALED TREE)
// =============================================================================
//
// KIND_MEMORY (= slot 4) is the parent kind: an a11y tree is a body of
// bytes with a schema tag on top -- structurally the same shape
// KIND_TONEMAP_LUT / KIND_HDR_METADATA / KIND_COLOR_PROFILE / KIND_VOLUME
// all take when their content is opaque-to-the-kernel but authorized by
// possession of the derived cap. The tree's node array lives inside a
// per-cap arena block (§4) whose byte range is a subrange of a bound
// KIND_MEMORY authority.
//
// The mint gate demands:
//
//   (a) parent kind == KIND_MEMORY(4) AND parent carries RIGHT_MINT.
//       (Enforced by the cap-substrate mint dispatch; NOT re-checked in
//        this file since the row-pool primitive assumes the substrate
//        has already validated the parent.)
//   (b) window_kind_id != 0 AND fits in u32 (a11y trees exist only
//       to describe some window; a "free-floating" tree is refused with
//       A11Y_MINT_BAD_WINDOW).
//   (c) rights subset of R_A11Y_ALL (§A).
//   (d) row-pool has a free slot (A11Y_MAX = 4 rows at Wave 0 fidelity).
//   (e) arena-pool has a matching free slot (row_id == arena_slot
//       under the same 1-to-1 rule KIND_LAYER_TREE uses).
//
// Sealed discipline (mirrors KIND_LAYER_TREE §2):
//   * RIGHT_APPEND_NODE, RIGHT_UPDATE_NODE are COMPOSITOR-INTERNAL. A
//     screen reader never mutates a tree; the compositor materialises
//     the tree from toolkit hints and screen readers RIGHT_SUBSCRIBE +
//     RIGHT_OBSERVE.
//   * R_A11Y_MINT is NEVER handed out. The set of mint-authorised
//     holders is {svc-compositor} at Wave 0.
//   * The subscribe path installs ONE subscriber slot (subscriber_kind_id
//     at row +32); an a11y tree with multiple subscribers is a future
//     extension that lands as a KIND_A11Y_SUBSCRIBER_SET derivation --
//     not a flag on this row.
//
// =============================================================================
// SECTION 3  KIND-CAP ROW LAYOUT  (64 BYTES = ONE CACHE LINE)
// =============================================================================
//
// One row per live KIND_A11Y_TREE cap. The tree data (header + nodes)
// lives in a per-cap arena block (§4).
//
//   [+0]  header:            in_use[63:56] | window_kind_slot[47:16]
//                          | sealed[8:8]   | reserved
//   [+8]  arena_ref:         arena_slot[7:0] | reserved
//   [+16] stats0 (mints):    monotonic u64
//   [+24] stats1 (updates):  monotonic u64
//   [+32] subscriber_ref:    subscriber_kind_id[31:0] | reserved
//                          -- 0 == no subscriber; nonzero == the
//                             screen-reader cap that will be woken on
//                             tree_version_seq bumps (subscription
//                             wakeup path lands in the follow-on
//                             kind_a11y_tree.pdx dispatcher).
//   [+40] reserved
//   [+48] reserved
//   [+56] reserved
//
// A11Y_MAX = 4 rows * 64 bytes = 256 bytes = 32 u64.
//
// =============================================================================
// SECTION 4  ARENA LAYOUT  (PER-ROW TREE STORAGE)
// =============================================================================
//
// One arena backs one KIND_A11Y_TREE row. Each arena is
// A11Y_HEADER_BYTES + A11Y_MAX_NODES * A11Y_NODE_BYTES bytes:
//
//     header:           32 bytes  (§4.1  struct A11yTreeHeader)
//     nodes[A11Y_MAX_NODES]: 32 * 32 = 1024 bytes  (§4.2  struct A11yNode)
//     ----
//     total per arena:  1056 bytes
//
// A11Y_MAX arenas * 1056 bytes = 4224 bytes of arena .bss (= 528 u64).
//
// -----------------------------------------------------------------------------
// 4.1  struct A11yTreeHeader  (32 bytes at offset 0 within an arena)
// -----------------------------------------------------------------------------
//
//   [+0]  hdr_words0:  window_kind_id[31:0] | node_count[63:32]
//   [+8]  hdr_words1:  root_node_id[31:0]   | subscriber_count[63:32]
//   [+16] tree_seq:    tree_version_seq[63:0]
//   [+24] reserved:    0
//
// Fields:
//   window_kind_id: u32      -- kernel-side kind_id of the KIND_WINDOW
//                                this tree describes. Populated at mint;
//                                never mutated.
//   node_count: u32          -- number of valid nodes; 1..A11Y_MAX_NODES.
//                                Fresh tree has node_count = 1 (root).
//   root_node_id: u32        -- root node ordinal; conventionally 0.
//   subscriber_count: u32    -- number of live subscriber bindings; 0
//                                or 1 at Wave 0.
//   tree_version_seq: u64    -- monotone; bumped on EVERY mutation
//                                (append_node or update_state). Screen
//                                readers compare against a stashed
//                                last-observed value to detect "has the
//                                tree changed since I last walked it".
//
// -----------------------------------------------------------------------------
// 4.2  struct A11yNode  (32 bytes / 4 u64 words)
// -----------------------------------------------------------------------------
//
//   [+0]  node_words0:  node_id[31:0]        | role[39:32]        | reserved[63:40]
//   [+8]  node_words1:  parent_node_id[31:0] | first_child_id[63:32]
//   [+16] node_words2:  next_sibling_id[31:0]| state[39:32]       | reserved[63:40]
//   [+24] node_words3:  label_offset[31:0]   | value_offset[63:32]
//
// Fields:
//   node_id: u32             -- own ordinal (index within the arena's
//                                node array; == the array index).
//   role: u8                 -- A11yRole enum ordinal (§A).
//   parent_node_id: u32      -- A11Y_INDEX_NONE (=0xFFFFFFFF) at root.
//   first_child_id: u32      -- A11Y_INDEX_NONE if leaf.
//   next_sibling_id: u32     -- A11Y_INDEX_NONE terminates sibling
//                                chain.
//   state: u8                -- A11yState bitmask (§A). Bits 0..7 are
//                                the mandatory AccessKit channels; bits
//                                8..63 in the packed word are reserved
//                                for future state channels (busy,
//                                invalid, live-region priority, ...).
//   label_offset: u32        -- interned string offset for the display
//                                label (button text, heading text, ...).
//                                0 == no label.
//   value_offset: u32        -- interned string offset for the value
//                                (spinbox reading, slider position,
//                                textbox contents). 0 == no value.
//
// TOPOLOGICAL INVARIANT (mint + append enforce; walk assumes):
//     for i in 1..node_count where nodes[i].parent_node_id != A11Y_INDEX_NONE:
//         nodes[i].parent_node_id < i
//
// (The root is at index 0 with parent_node_id == A11Y_INDEX_NONE.)
//
// The invariant is preserved by construction: a11y_tree_append_node
// only appends at index node_count (== new node's id) and refuses any
// parent_id >= node_count, so a child always appears at a strictly
// larger index than its parent.
//
// CHILD-CHAIN ORDER.  a11y_tree_append_node PREPENDS to the parent's
// first_child list (O(1)). The resulting sibling chain is in reverse
// insertion order at the tree-view API level -- screen readers that
// require presentation order re-sort at the walk boundary. A future
// landing MAY switch to append-at-end (walk the sibling chain to the
// tail) if profiling shows the re-sort cost outweighs the O(depth)
// walk cost; the row/node layout does not need to change for that
// switch.
//
// =============================================================================
// SECTION 5  FAILURE TAXONOMY  0xFFFFEB70..0xFFFFEB7F
// =============================================================================
//
// A repo-wide grep at landing time (`grep -rhoE '0xFFFFEB[0-9A-Fa-f]{2}'
// src/`) showed 0xFFFFEB70..0xFFFFEB7F unclaimed. The task-row hinted at
// 0xFFFFEB20..0xFFFFEB2F but that band was already claimed by
// KIND_TLS_TRUST (0xFFFFEB20..27) + KIND_NIC (0xFFFFEB28..2F) at earlier
// landings; the grep-verify note in the task authorized selecting the
// next free 16-slot band. Adjacent to KIND_TUI_CANVAS (0xFFFFEB10..1F)
// and the KIND_NIC neighbourhood so the wider "user-space kind row"
// remains contiguous in the EBxx page.
//
// =============================================================================
// SECTION 6  CAPABILITY OP CATALOG
// =============================================================================
//
// Every op is arity ONE (row_id in target_ptr, sub-op / arg in
// op_arg[7:0]); op_arg[63:8] MUST be zero (the future dispatcher
// refuses a smuggled second value with A11Y_TAIL_BAD_ARG).
//
//   A11Y_OP_QUERY_NODE_COUNT   (op_arg IGNORED)  -> node_count (u32)
//   A11Y_OP_QUERY_ROOT         (op_arg IGNORED)  -> root_node_id (u32)
//   A11Y_OP_QUERY_TREE_SEQ     (op_arg IGNORED)  -> tree_version_seq (u64)
//   A11Y_OP_QUERY_SUBSCRIBER   (op_arg IGNORED)  -> subscriber_kind_id (u32)
//   A11Y_OP_QUERY_WINDOW_KIND  (op_arg IGNORED)  -> window_kind_id (u32)
//   A11Y_OP_DEBUG_PRINT        (op_arg IGNORED)  -> A11Y_OK; klog emit.
//
// APPEND_NODE / UPDATE_STATE / SUBSCRIBE are NOT arity-one ops -- each
// takes multiple field words and lands as a compositor-internal helper
// (a11y_tree_append_node / a11y_tree_update_state / a11y_tree_subscribe
// below). External clients can only query the derived state; the
// compositor drives mutations directly through the arena.
//
// =============================================================================
// SECTION 7  FINGERPRINT
// =============================================================================
//
// One tag ending `[legacy: A11Y TREE META OK]` per softarch discipline
// (see feedback_paideia_as_reserved_labels-adjacent convention used by
// kind_tls_trust / kind_tui_canvas / kind_layer_tree). Data-only at
// this landing; needs allowlisting in tools/verify-fingerprint-coverage.
// sh with reason "kind_a11y_tree meta emit body not yet landed (Wave0-
// B8-03)" until the sibling kind_a11y_tree.pdx dispatcher lands and
// emits it via klog_s1_x1 on every successful mint.  Allowlist wire-up
// is a separate landing per the batch's file-touch discipline (this
// landing is ONE file only).
//
// LABEL PREFIX: `a11y_tree_` throughout -- avoids paideia-as reserved-
// keyword collisions per feedback_paideia_as_reserved_labels; all ASM
// jump targets are `a11y_tree_<funcname>_<tag>`.

module TreeKind = structure {

  // ==========================================================================
  // SECTION A  Identity + rights + roles + states + op catalog + failure
  //            taxonomy.
  // ==========================================================================

  pub let KIND_A11Y_TREE           : u64 = 0x1D3
  pub let A11Y_PARENT_KIND_MEMORY  : u64 = 4          // KIND_MEMORY slot.

  // Rights. The two "internal" bits (APPEND_NODE, UPDATE_NODE) belong
  // to the compositor's own service cap on this row; a screen-reader
  // cap holds SUBSCRIBE + OBSERVE + QUERY_TREE + READ + INVOKE only.
  pub let R_A11Y_READ           : u64 = 0x001
  pub let R_A11Y_INVOKE         : u64 = 0x008
  pub let R_A11Y_REVOKE         : u64 = 0x010
  pub let R_A11Y_APPEND_NODE    : u64 = 0x100        // compositor-internal.
  pub let R_A11Y_MINT           : u64 = 0x200        // never handed out.
  pub let R_A11Y_OBSERVE        : u64 = 0x400
  pub let R_A11Y_UPDATE_NODE    : u64 = 0x800        // compositor-internal.
  pub let R_A11Y_QUERY_TREE     : u64 = 0x1000
  pub let R_A11Y_SUBSCRIBE      : u64 = 0x2000
  pub let R_A11Y_ALL            : u64 = 0x3F19       // 0x1|0x8|0x10|0x100|0x200|0x400|0x800|0x1000|0x2000

  // A11yRole -- AccessKit-parity subset. ROLE_MAX is the last valid
  // ordinal (inclusive); validators use `ja ROLE_MAX` to reject out-
  // of-range values. Extending the enum bumps ROLE_MAX and stays
  // within the u8 field.
  pub let ROLE_UNKNOWN     : u64 = 0
  pub let ROLE_WINDOW      : u64 = 1
  pub let ROLE_BUTTON      : u64 = 2
  pub let ROLE_LABEL       : u64 = 3
  pub let ROLE_TEXTBOX     : u64 = 4
  pub let ROLE_CHECKBOX    : u64 = 5
  pub let ROLE_LIST        : u64 = 6
  pub let ROLE_LIST_ITEM   : u64 = 7
  pub let ROLE_LINK        : u64 = 8
  pub let ROLE_MENU        : u64 = 9
  pub let ROLE_MENU_ITEM   : u64 = 10
  pub let ROLE_HEADING     : u64 = 11
  pub let ROLE_PARAGRAPH   : u64 = 12
  pub let ROLE_IMAGE       : u64 = 13
  pub let ROLE_TABLE       : u64 = 14
  pub let ROLE_CELL        : u64 = 15
  pub let ROLE_MAX         : u64 = 15

  // A11yState bitmask (bits 0..7 mandatory AccessKit channels).
  pub let STATE_FOCUSED    : u64 = 0x01
  pub let STATE_DISABLED   : u64 = 0x02
  pub let STATE_HIDDEN     : u64 = 0x04
  pub let STATE_SELECTED   : u64 = 0x08
  pub let STATE_CHECKED    : u64 = 0x10
  pub let STATE_EXPANDED   : u64 = 0x20
  pub let STATE_READONLY   : u64 = 0x40
  pub let STATE_REQUIRED   : u64 = 0x80
  pub let STATE_MASK_ALL   : u64 = 0xFF

  // Row-pool + arena sizing.
  pub let A11Y_MAX             : u64 = 4              // KIND-cap rows.
  pub let A11Y_ROW_BYTES       : u64 = 64             // one cache line.
  pub let A11Y_HEADER_BYTES    : u64 = 32             // per-arena tree header.
  pub let A11Y_NODE_BYTES      : u64 = 32             // per-node record.
  pub let A11Y_MAX_NODES       : u64 = 32             // per tree.
  pub let A11Y_ARENA_BYTES     : u64 = 1056           // 32 + 32*32.

  // Header offset constants (byte offsets within an arena).
  pub let A11Y_HDR_OFF_WKID_COUNT    : u64 = 0    // window_kind_id[31:0] | node_count[63:32]
  pub let A11Y_HDR_OFF_ROOT_SUBS     : u64 = 8    // root_node_id[31:0]   | subscriber_count[63:32]
  pub let A11Y_HDR_OFF_TREE_SEQ      : u64 = 16   // tree_version_seq (u64)
  pub let A11Y_HDR_OFF_RESERVED      : u64 = 24

  // Node offset constants (byte offsets within a node).
  pub let A11Y_NODE_OFF_ID_ROLE      : u64 = 0    // node_id[31:0] | role[39:32] | reserved[63:40]
  pub let A11Y_NODE_OFF_PAR_CHILD    : u64 = 8    // parent[31:0]  | first_child[63:32]
  pub let A11Y_NODE_OFF_SIB_STATE    : u64 = 16   // next_sibling[31:0] | state[39:32] | reserved[63:40]
  pub let A11Y_NODE_OFF_LBL_VAL      : u64 = 24   // label_offset[31:0] | value_offset[63:32]

  // Sentinel indices.
  pub let A11Y_INDEX_NONE      : u64 = 0xFFFFFFFF     // u32 max = "no such node".

  // Ops (arity 1).
  pub let A11Y_OP_QUERY_NODE_COUNT   : u64 = 0
  pub let A11Y_OP_QUERY_ROOT         : u64 = 1
  pub let A11Y_OP_QUERY_TREE_SEQ     : u64 = 2
  pub let A11Y_OP_QUERY_SUBSCRIBER   : u64 = 3
  pub let A11Y_OP_QUERY_WINDOW_KIND  : u64 = 4
  pub let A11Y_OP_DEBUG_PRINT        : u64 = 5
  pub let A11Y_OP_MAX                : u64 = 5

  // Failure taxonomy -- 0xFFFFEB70..0xFFFFEB7F (see file header §5).
  pub let A11Y_OK                    : u64 = 0
  pub let A11Y_TAIL_ENOSPC           : u64 = 0xFFFFEB7F
  pub let A11Y_TAIL_BAD_ARG          : u64 = 0xFFFFEB7E
  pub let A11Y_MINT_BAD_PARENT       : u64 = 0xFFFFEB7D
  pub let A11Y_MINT_BAD_RIGHTS       : u64 = 0xFFFFEB7C
  pub let A11Y_MINT_BAD_WINDOW       : u64 = 0xFFFFEB7B
  pub let A11Y_MINT_NO_ARENA         : u64 = 0xFFFFEB7A
  pub let A11Y_BAD_SLOT              : u64 = 0xFFFFEB79
  pub let A11Y_BAD_NODE_ID           : u64 = 0xFFFFEB78
  pub let A11Y_BAD_ROLE              : u64 = 0xFFFFEB77
  pub let A11Y_BAD_STATE             : u64 = 0xFFFFEB76
  pub let A11Y_REVOKE_ALREADY        : u64 = 0xFFFFEB75
  pub let A11Y_NODES_FULL            : u64 = 0xFFFFEB74
  pub let A11Y_BAD_PARENT_NODE       : u64 = 0xFFFFEB73
  pub let A11Y_NO_SUBSCRIBER         : u64 = 0xFFFFEB72
  pub let A11Y_UNSUP_OP              : u64 = 0xFFFFEB71
  pub let A11Y_WRONG_KIND            : u64 = 0xFFFFEB70
  pub let A11Y_DECODE_BAD            : u64 = 0xFFFFFFFFFFFFFFFF

  // ==========================================================================
  // SECTION B  State cells.
  // ==========================================================================

  // KIND-cap row pool. A11Y_MAX rows * 64 bytes = 256 bytes = 32 u64.
  pub let mut _a11y_tree_rows   : [u64; 32]  = uninit @align(64)

  // Per-row arena pool. A11Y_MAX arenas * 1056 bytes = 4224 bytes = 528 u64.
  pub let mut _a11y_tree_arenas : [u64; 528] = uninit @align(64)

  // Per-row stats (mints/updates/revokes/refused). Bounds-checked
  // against 4 in a11y_tree_stats_bump / a11y_tree_stats_read.
  pub let mut _a11y_tree_stats  : [u64; 4]   = uninit @align(64)

  pub let A11Y_ST_MINTS     : u64 = 0
  pub let A11Y_ST_UPDATES   : u64 = 1
  pub let A11Y_ST_REVOKES   : u64 = 2
  pub let A11Y_ST_REFUSED   : u64 = 3

  // Fingerprint tag. Data-only at this landing; needs allowlisting in
  // tools/verify-fingerprint-coverage.sh with reason
  // "kind_a11y_tree meta emit body not yet landed (Wave0-B8-03)" until
  // the sibling kind_a11y_tree.pdx dispatcher lands and emits it via
  // klog_s1_x1 on every successful mint.
  //
  // "pdx kind a11y tree meta [legacy: A11Y TREE META OK]\0" = 51 bytes
  // of payload + 1 NUL terminator = 52 bytes total.
  pub let pdx_kind_a11y_tree_meta : [u8; 52] = "pdx kind a11y tree meta [legacy: A11Y TREE META OK]\0"

  // ==========================================================================
  // SECTION C  Validators (mint-time / append-time).
  // ==========================================================================

  // a11y_tree_rights_valid(r) -> 1 iff r subset of R_A11Y_ALL (0x3F19).
  pub let a11y_tree_rights_valid : (u64) -> u64 !{} @{} =
    fn (r: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B8-03 (paideia-os #2302): subset test against R_A11Y_ALL = 0x3F19. Labels prefixed a11y_tree_rv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x3F19;
        and rax, r10;
        cmp rax, rdi;
        jne a11y_tree_rv_no;
        mov rax, 1;
        ret;
      a11y_tree_rv_no:
        xor rax, rax;
        ret
      }
    }

  // a11y_tree_window_valid(wkid) -> 1 iff wkid in (0, 2^32). Mirrors
  // window_a11y_valid in window_kind.pdx -- the same nonzero-plus-u32-
  // fit shape, applied from the other end of the binding.
  pub let a11y_tree_window_valid : (u64) -> u64 !{} @{} =
    fn (wkid: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B8-03 (paideia-os #2302): 1 iff window_kind_id in (0, 2^32). Zero refuses free-floating trees; the mint gate feeds A11Y_MINT_BAD_WINDOW into the refusal funnel on failure. Labels prefixed a11y_tree_wv_.",
      block: {
        cmp rdi, 0;
        je  a11y_tree_wv_no;
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  a11y_tree_wv_no;
        mov rax, 1;
        ret;
      a11y_tree_wv_no:
        xor rax, rax;
        ret
      }
    }

  // a11y_tree_role_valid(role) -> 1 iff role <= ROLE_MAX (15).
  pub let a11y_tree_role_valid : (u64) -> u64 !{} @{} =
    fn (role: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B8-03 (paideia-os #2302): 1 iff role in [0, ROLE_MAX(15)]. Rejects garbage values that would corrupt the [39:32] byte of the packed node_words0. Labels prefixed a11y_tree_rov_.",
      block: {
        mov r10, 15;
        cmp rdi, r10;
        ja  a11y_tree_rov_no;
        mov rax, 1;
        ret;
      a11y_tree_rov_no:
        xor rax, rax;
        ret
      }
    }

  // a11y_tree_state_valid(state) -> 1 iff state subset of STATE_MASK_ALL
  // (0xFF). Bits 8..63 are reserved for future state channels; a caller
  // that smuggles them in is refused so a later widening doesn't silently
  // observe stale bits.
  pub let a11y_tree_state_valid : (u64) -> u64 !{} @{} =
    fn (state: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B8-03 (paideia-os #2302): 1 iff state subset of STATE_MASK_ALL(0xFF). Reserved bits 8..63 are refused so a future widening never observes stale bit patterns. Labels prefixed a11y_tree_sv_.",
      block: {
        mov rax, rdi;
        mov r10, 0xFF;
        and rax, r10;
        cmp rax, rdi;
        jne a11y_tree_sv_no;
        mov rax, 1;
