  // ==========================================================================
  // SECTION E  Arena address arithmetic.
  //
  // Arena base pointer = _a11y_tree_arenas + arena_slot * A11Y_ARENA_BYTES
  //                    = _a11y_tree_arenas + arena_slot * 1056.
  //
  // 1056 fits in a 3-operand imul immediate (imul reg, reg, imm32),
  // encoder-legal per the file's imul convention (no 2-op imul-with-imm).
  // ==========================================================================

  // a11y_tree_arena_base(arena_slot) -> ptr | 0.
  pub let a11y_tree_arena_base : (u64) -> u64 !{mem} @{} =
    fn (arena_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B8-03 (paideia-os #2302): arena base pointer = _a11y_tree_arenas + arena_slot * A11Y_ARENA_BYTES(1056). Bounds-checked against A11Y_MAX(4); OOB returns 0 (caller compares against zero before dereferencing). Labels prefixed a11y_tree_ab_.",
      block: {
        mov r10, 4;
        cmp rdi, r10;
        jae a11y_tree_ab_no;
        lea r10, [rip + _a11y_tree_arenas];
        mov r11, rdi;
        imul r11, r11, 1056;
        add r10, r11;
        mov rax, r10;
        ret;
      a11y_tree_ab_no:
        xor rax, rax;
        ret
      }
    }

  // a11y_tree_node_addr(arena_base, node_index) -> ptr (no bounds check;
  // caller MUST have validated node_index < node_count first).
  pub let a11y_tree_node_addr : (u64, u64) -> u64 !{} @{} =
    fn (arena_base: u64) (node_index: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B8-03 (paideia-os #2302): node address = arena_base + A11Y_HEADER_BYTES(32) + node_index * A11Y_NODE_BYTES(32). Precondition: caller validated node_index via a11y_tree_index_valid. Uses shl 5 for the *32 (encoder-conservative; equivalent to imul reg,reg,32). Labels prefixed a11y_tree_na_.",
      block: {
        mov rax, rdi;
        add rax, 32;                     // skip header
        mov r10, rsi;
        shl r10, 5;                      // *32 (node stride)
        add rax, r10;
        ret
      }
    }

  // ==========================================================================
  // SECTION F  Header + node field accessors (read-side).
  //
  // Field extraction from the packed u64 words. Every accessor takes
  // an arena_base (or node_base) pointer and returns the low-32-bit
  // (or full-64-bit) field zero-extended into rax. All accessors are
  // pure -- no writes -- and safe from any observer with QUERY_TREE.
  // ==========================================================================

