  // ==========================================================================
  // SECTION G  KIND-cap row-pool primitives (valid / alloc / free).
  //
  // A KIND_A11Y_TREE row lives in _a11y_tree_rows and points at an arena
  // slot in _a11y_tree_arenas. Rows and arenas share the same slot index
  // at Wave 0 (row i owns arena i); the arena_ref field is present so a
  // future landing can decouple them.
  // ==========================================================================

  pub let a11y_tree_row_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B8-03 (paideia-os #2302): 1 iff row_id < A11Y_MAX(4) AND in_use. Row address = _a11y_tree_rows + row_id * 64; the *64 uses shl 6. Labels prefixed a11y_tree_rv2_.",
      block: {
        mov r10, 4;
        cmp rdi, r10;
        jae a11y_tree_rv2_no;
        lea r10, [rip + _a11y_tree_rows];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  a11y_tree_rv2_no;
        mov rax, 1;
        ret;
      a11y_tree_rv2_no:
        xor rax, rax;
        ret
      }
    }

  // a11y_tree_row_alloc(hdr, arena_ref) -> row_id | A11Y_TAIL_ENOSPC.
  //
  // hdr:       a11y_tree_pack_hdr_row output (in_use=0, wkid at [47:16],
  //            sealed at [8:8]).
  // arena_ref: a11y_tree_pack_arena_ref output (arena_slot at [7:0]).
  //
  // Low-first scan; the found row's in_use bit is stamped by ORing
  // 1<<56 into hdr on the claim path. Stats0 (mints) is pre-initialised
  // to 1; stats1 (updates) starts at 0; subscriber_ref starts at 0.
  pub let a11y_tree_row_alloc : (u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (arena_ref: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B8-03 (paideia-os #2302): claim one KIND_A11Y_TREE row. Low-first scan (rbx=idx) over A11Y_MAX(4) rows of 64 bytes. Three callee-save pushes (rbx=idx, r12=hdr, r13=arena_ref) + sub rsp,8 = 32 B => entry rsp%16==8, +32 = %16==8 which suits the no-nested-call scan (any indirect call here would need one further pad). Labels prefixed a11y_tree_ra_.",
      block: {
        push rbx;
        push r12;
        push r13;
        sub  rsp, 8;

        mov  r12, rdi;
        mov  r13, rsi;

        xor  rbx, rbx;
      a11y_tree_ra_scan:
        cmp  rbx, 4;
        jae  a11y_tree_ra_enospc;

        lea  r10, [rip + _a11y_tree_rows];
        mov  r11, rbx;
        shl  r11, 6;
        add  r10, r11;

        mov  rax, [r10 + 0];
        shr  rax, 56;
        cmp  rax, 0;
        je   a11y_tree_ra_claim;

        add  rbx, 1;
        jmp  a11y_tree_ra_scan;

      a11y_tree_ra_claim:
        mov  rax, r12;
        mov  r11, 1;
        shl  r11, 56;
        or   rax, r11;
        mov  [r10 + 0],  rax;                // header (with in_use=1)
        mov  [r10 + 8],  r13;                // arena_ref
        mov  rax, 1;
        mov  [r10 + 16], rax;                // stats0 mints = 1
        xor  rax, rax;
        mov  [r10 + 24], rax;                // stats1 updates = 0
        mov  [r10 + 32], rax;                // subscriber_ref = 0
        mov  [r10 + 40], rax;                // reserved
        mov  [r10 + 48], rax;
        mov  [r10 + 56], rax;
        mov  rax, rbx;                       // row_id
        jmp  a11y_tree_ra_out;

      a11y_tree_ra_enospc:
        mov  rax, 0xFFFFEB7F;                // A11Y_TAIL_ENOSPC

      a11y_tree_ra_out:
        add  rsp, 8;
        pop  r13;
        pop  r12;
        pop  rbx;
        ret
      }
    }

  pub let a11y_tree_row_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B8-03 (paideia-os #2302): scrub one row (all eight u64 words). Bounds-checked against A11Y_MAX(4). Does NOT scrub the backing arena; that is a separate op the compositor may skip when re-minting into the same arena. Labels prefixed a11y_tree_rf_.",
      block: {
        mov  r10, 4;
        cmp  rdi, r10;
        jae  a11y_tree_rf_out;
        lea  r10, [rip + _a11y_tree_rows];
        mov  r11, rdi;
        shl  r11, 6;
        add  r10, r11;
        xor  rax, rax;
        mov  [r10 + 0],  rax;
        mov  [r10 + 8],  rax;
        mov  [r10 + 16], rax;
        mov  [r10 + 24], rax;
        mov  [r10 + 32], rax;
        mov  [r10 + 40], rax;
        mov  [r10 + 48], rax;
        mov  [r10 + 56], rax;
      a11y_tree_rf_out:
        ret
      }
    }

  // a11y_tree_row_arena_slot(row_id) -> arena_slot | A11Y_INDEX_NONE on OOB.
  pub let a11y_tree_row_arena_slot : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B8-03 (paideia-os #2302): read arena_ref[7:0] from row. OOB -> A11Y_INDEX_NONE so the arena_base call fails downstream via its own bounds check. Labels prefixed a11y_tree_ras_.",
      block: {
        mov  r10, 4;
        cmp  rdi, r10;
        jae  a11y_tree_ras_no;
        lea  r10, [rip + _a11y_tree_rows];
        mov  r11, rdi;
        shl  r11, 6;
        add  r10, r11;
        mov  rax, [r10 + 8];
        and  rax, 0xFF;
        ret;
      a11y_tree_ras_no:
        mov  rax, 0xFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // SECTION H  Factory  --  a11y_tree_mint(window_kind_id) -> tree_ref.
  //
  // Creates a fresh KIND_A11Y_TREE row + arena for the given window kind
  // id. The arena is initialised with:
  //   header:   window_kind_id, node_count=1, root=0, subscriber=0,
  //             tree_version_seq=1
  //   nodes[0]: node_id=0, role=ROLE_WINDOW(1), parent=NONE,
  //             first_child=NONE, next_sibling=NONE, state=0,
  //             label_off=0, value_off=0
  //
  // Returns the row_id (== tree_ref) on success, or an A11Y_MINT_* /
  // A11Y_TAIL_ENOSPC sentinel on failure.
  //
  // Gate order:
  //   (1) window_kind_id valid    (a11y_tree_window_valid)
  //   (2) row pool has a free slot
  //   (3) initialise header + root node in-arena
  //
  // Five callee-save pushes leave rsp%16==0 (odd push count flips
  // entry %16=8 to 0), which is the value every nested `call` needs
  // at the callsite. No further pad required.
  // ==========================================================================

  pub let a11y_tree_mint : (u64) -> u64 !{mem} @{} =
    fn (window_kind_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B8-03 (paideia-os #2302): allocate one KIND_A11Y_TREE row + arena bound to window_kind_id. Five callee-save pushes (rbx=window_kind_id, r12=row_id/hdr, r13=arena_ref, r14=arena_base, r15=scratch) preserve SysV alignment: entry rsp%16==8, five 8-byte pushes give rsp%16==0 which is the value every nested `call` needs at the callsite. No further pad required. Refusal path funnels through a11y_tree_mint_refused and bumps A11Y_ST_REFUSED once. Labels prefixed a11y_tree_mint_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov  rbx, rdi;                       // window_kind_id

        // (1) window_kind_id valid?
        mov  rdi, rbx;
        call a11y_tree_window_valid;
        cmp  rax, 0;
        je   a11y_tree_mint_bad_window;

        // (2) pack row header (window_kind_slot = window_kind_id,
        //     sealed = 1) and claim a row.
        mov  rdi, rbx;
        mov  rsi, 1;
        call a11y_tree_pack_hdr_row;
        mov  r12, rax;                       // hdr

        // arena_slot == row_id under the 1-to-1 rule; we synthesise
        // arena_ref from the scan index the row_alloc returns. To keep
        // the initial row's arena_ref aligned with the row_id, we call
        // row_alloc with a placeholder arena_ref of 0 and rewrite it
        // after the scan returns the row_id.  (Simpler than pre-
        // scanning: row_alloc does the low-first scan for us.)
        mov  rdi, 0;
        call a11y_tree_pack_arena_ref;
        mov  r13, rax;                       // arena_ref (arena_slot=0)

        mov  rdi, r12;
        mov  rsi, r13;
        call a11y_tree_row_alloc;
        mov  r12, rax;                       // row_id (or sentinel)

        // If row_alloc returned the ENOSPC sentinel (>= A11Y_MAX), fail.
        mov  r10, 4;
        cmp  r12, r10;
        jae  a11y_tree_mint_enospc;

        // Rewrite the row's arena_ref word so arena_slot == row_id.
        // (Row layout: [+8] = arena_ref.)
        lea  r10, [rip + _a11y_tree_rows];
        mov  r11, r12;
        shl  r11, 6;
        add  r10, r11;
        mov  rax, r12;
        and  rax, 0xFF;
        mov  [r10 + 8], rax;

        // (3) initialise arena.
        mov  rdi, r12;
        call a11y_tree_arena_base;
        cmp  rax, 0;
        je   a11y_tree_mint_no_arena;
        mov  r14, rax;                       // arena_base

        // Header: word 0 = (window_kind_id, node_count=1).
        mov  rdi, rbx;
        mov  rsi, 1;
        call a11y_tree_pack_u32_pair;
        mov  [r14 + 0], rax;

        // Header: word 1 = (root_node_id=0, subscriber_count=0).
        xor  rax, rax;
        mov  [r14 + 8], rax;

        // Header: word 2 = tree_version_seq = 1.
        mov  rax, 1;
        mov  [r14 + 16], rax;

        // Header: word 3 = reserved.
        xor  rax, rax;
        mov  [r14 + 24], rax;

        // Root node at index 0: node_base = arena_base + 32.
        mov  r15, r14;
        add  r15, 32;

        // node_words0 = (node_id=0, role=ROLE_WINDOW(1)).
        mov  rdi, 0;
        mov  rsi, 1;
        call a11y_tree_pack_id_role;
        mov  [r15 + 0], rax;

        // node_words1 = (parent=NONE, first_child=NONE).
        mov  rdi, 0xFFFFFFFF;
        mov  rsi, 0xFFFFFFFF;
        call a11y_tree_pack_u32_pair;
        mov  [r15 + 8], rax;

        // node_words2 = (next_sibling=NONE, state=0).
        mov  rdi, 0xFFFFFFFF;
        mov  rsi, 0;
        call a11y_tree_pack_sib_state;
        mov  [r15 + 16], rax;

        // node_words3 = (label_offset=0, value_offset=0).
        xor  rax, rax;
        mov  [r15 + 24], rax;

        // Success: return row_id.
        mov  rax, r12;
        jmp  a11y_tree_mint_out;

      a11y_tree_mint_bad_window:
        mov  rax, 0xFFFFEB7B;                // A11Y_MINT_BAD_WINDOW
        jmp  a11y_tree_mint_refused;
      a11y_tree_mint_enospc:
        // r12 already holds the ENOSPC sentinel from row_alloc.
        mov  rax, r12;
        jmp  a11y_tree_mint_refused;
      a11y_tree_mint_no_arena:
        // Roll back the row claim before reporting the failure so a
        // subsequent mint retry can succeed against the same slot.
        mov  rdi, r12;
        call a11y_tree_row_free;
        mov  rax, 0xFFFFEB7A;                // A11Y_MINT_NO_ARENA

      a11y_tree_mint_refused:
        // Bump A11Y_ST_REFUSED, preserve sentinel across the note call.
        mov  rbx, rax;
        mov  rdi, 3;                         // A11Y_ST_REFUSED
        call a11y_tree_stats_bump;
        mov  rax, rbx;

      a11y_tree_mint_out:
        pop  r15;
        pop  r14;
        pop  r13;
        pop  r12;
        pop  rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION I  a11y_tree_append_node
  //
  // a11y_tree_append_node(row_id, parent_id, role, label_off) -> new_node_id
  //                                                              | A11Y_* sentinel
  //
  // Preconditions:
  //   * row_id names a live row.
  //   * parent_id < node_count (a11y_tree_index_valid).
  //   * role <= ROLE_MAX.
  //   * node_count < A11Y_MAX_NODES.
  //
  // Effects:
  //   * writes nodes[node_count] with:
  //       node_id=node_count, role=role, parent=parent_id,
  //       first_child=NONE, next_sibling=parent.first_child, state=0,
  //       label_off=label_off, value_off=0
  //   * sets parent.first_child = node_count       (O(1) prepend)
  //   * bumps node_count and tree_version_seq
  //
  // The child-chain prepend preserves the topological invariant
  // (child_index > parent_index) because parent_id has already been
  // validated < node_count, and the new node lives at index node_count
  // which is strictly larger. See §4.2 CHILD-CHAIN ORDER for the
  // rationale.
  //
  // Six callee-save pushes (rbx=row_id, r12=parent_id, r13=role,
  // r14=label_off, r15=arena_base, rbp=new_node_id) + entry rsp%16==8
  // leaves rsp%16==8 after the pushes (even parity); every gate call
  // gets a sub rsp,8 pad so the callee sees rsp%16==0. The commit body
  // (§6) inlines the pack ops so there is no further stack orchestration
  // after the gate calls -- straight memory writes with masked shifts.
  // ==========================================================================

  pub let a11y_tree_append_node : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64) (parent_id: u64) (role: u64) (label_off: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B8-03 (paideia-os #2302): append one A11yNode to a tree, O(1) via first-child prepend. Six callee-save pushes leave rsp%16==8 (six 8-byte pushes preserve entry parity); a sub rsp,8 pad wraps each gate call site so the callee sees rsp%16==0. Commit body inlines pack ops (all trivial shifts/masks) to avoid nested-call orchestration for the four node-word writes + the parent.first_child rewrite. Gate order: row_valid -> role_valid -> arena_base -> node_count < A11Y_MAX_NODES -> parent_id < node_count -> commit. Labels prefixed a11y_tree_ap_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov  rbx, rdi;                       // row_id
        mov  r12, rsi;                       // parent_id
        mov  r13, rdx;                       // role
        mov  r14, rcx;                       // label_off

        // (1) row_valid?
        sub  rsp, 8;
        mov  rdi, rbx;
        call a11y_tree_row_valid;
        add  rsp, 8;
        cmp  rax, 0;
        je   a11y_tree_ap_bad_slot;

        // (2) role_valid?
        sub  rsp, 8;
        mov  rdi, r13;
        call a11y_tree_role_valid;
        add  rsp, 8;
        cmp  rax, 0;
        je   a11y_tree_ap_bad_role;

        // (3) arena_base.
        sub  rsp, 8;
        mov  rdi, rbx;
        call a11y_tree_arena_base;
        add  rsp, 8;
        cmp  rax, 0;
        je   a11y_tree_ap_bad_slot;
        mov  r15, rax;                       // arena_base

        // (4) node_count < A11Y_MAX_NODES(32)?
        sub  rsp, 8;
        mov  rdi, r15;
        call a11y_tree_hdr_node_count;
        add  rsp, 8;
        mov  r10, 32;
        cmp  rax, r10;
        jae  a11y_tree_ap_full;
        mov  rbp, rax;                       // new_node_id = node_count

        // (5) parent_id < node_count?
        sub  rsp, 8;
        mov  rdi, r12;
        mov  rsi, rbp;
        call a11y_tree_index_valid;
        add  rsp, 8;
        cmp  rax, 0;
        je   a11y_tree_ap_bad_parent;

        // (6) Commit -- inlined pack ops, no nested calls, no stack
        //               spills. r15 (arena_base) + r12/r13/r14/rbp
        //               (parent_id/role/label_off/new_node_id) remain
        //               live across every write; r8..r11 + rax + rcx
        //               are the scratch pool.
        //
        //   parent_base   = arena_base + 32 + parent_id  * 32
        //   new_node_base = arena_base + 32 + new_id     * 32
        //
        // The *32 folds to shl 5. No imul, no encoder surprises.

        mov  r8, r15;                        // r8 = arena_base + 32 (nodes[])
        add  r8, 32;

        mov  r9, r12;                        // r9 = parent_id * 32
        shl  r9, 5;
        add  r9, r8;                         // r9 = parent_base

        mov  r10, rbp;                       // r10 = new_id * 32
        shl  r10, 5;
        add  r10, r8;                        // r10 = new_node_base

        // r11 = parent.first_child = (parent_words1 >> 32).
        mov  r11, [r9 + 8];
        shr  r11, 32;                        // r11 = old_first_child

        // Write new_node_base[+0]: (new_node_id | role<<32).
        mov  rax, rbp;
        and  rax, 0xFFFFFFFF;
        mov  rcx, r13;
        and  rcx, 0xFF;
        shl  rcx, 32;
        or   rax, rcx;
        mov  [r10 + 0], rax;

        // Write new_node_base[+8]: (parent_id | 0xFFFFFFFF<<32).
        mov  rax, r12;
        and  rax, 0xFFFFFFFF;
        mov  rcx, 0xFFFFFFFF;
        shl  rcx, 32;
        or   rax, rcx;
        mov  [r10 + 8], rax;

        // Write new_node_base[+16]: (old_first_child | state=0<<32).
        mov  rax, r11;
        and  rax, 0xFFFFFFFF;
        mov  [r10 + 16], rax;

        // Write new_node_base[+24]: (label_off | value_off=0<<32).
        mov  rax, r14;
        and  rax, 0xFFFFFFFF;
        mov  [r10 + 24], rax;

        // Update parent.first_child = new_id. parent_words1 layout:
        //   parent_of_parent[31:0] | first_child[63:32].
        // Preserve low 32, overwrite high 32.
        mov  rax, [r9 + 8];
        and  rax, 0xFFFFFFFF;                // parent_of_parent
        mov  rcx, rbp;
        and  rcx, 0xFFFFFFFF;
        shl  rcx, 32;
        or   rax, rcx;
        mov  [r9 + 8], rax;

        // Bump node_count in header.  hdr_words0 layout:
        //   window_kind_id[31:0] | node_count[63:32]
        mov  rax, [r15 + 0];
        mov  rcx, rax;
        and  rcx, 0xFFFFFFFF;                // window_kind_id
        shr  rax, 32;                        // node_count
        add  rax, 1;
        shl  rax, 32;
        or   rax, rcx;
        mov  [r15 + 0], rax;

        // Bump tree_version_seq (full u64 at +16).
        mov  rax, [r15 + 16];
        add  rax, 1;
        mov  [r15 + 16], rax;

        // Bump per-row updates counter.
        sub  rsp, 8;
        mov  rdi, 1;                         // A11Y_ST_UPDATES
        call a11y_tree_stats_bump;
        add  rsp, 8;

        // Success: return new_node_id.
        mov  rax, rbp;
        jmp  a11y_tree_ap_out;

      a11y_tree_ap_bad_slot:
        mov  rax, 0xFFFFEB79;                // A11Y_BAD_SLOT
        jmp  a11y_tree_ap_out;
      a11y_tree_ap_bad_role:
        mov  rax, 0xFFFFEB77;                // A11Y_BAD_ROLE
        jmp  a11y_tree_ap_out;
      a11y_tree_ap_full:
        mov  rax, 0xFFFFEB74;                // A11Y_NODES_FULL
        jmp  a11y_tree_ap_out;
      a11y_tree_ap_bad_parent:
        mov  rax, 0xFFFFEB73;                // A11Y_BAD_PARENT_NODE

      a11y_tree_ap_out:
        pop  rbp;
        pop  r15;
        pop  r14;
        pop  r13;
        pop  r12;
        pop  rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION J  a11y_tree_update_state
  //
  // a11y_tree_update_state(row_id, node_id, state_mask) -> A11Y_OK
  //                                                       | A11Y_* sentinel
  //
  // Overwrites the target node's state bitmask AND bumps the tree
  // version_seq. Screen readers waiting on the version bump wake up
  // via the subscribe path (§L) and re-read the tree.
  //
  // Gate order:
  //   (1) row_valid
  //   (2) state fits in STATE_MASK_ALL (0xFF)
  //   (3) arena_base
  //   (4) node_id < node_count
  //   (5) rewrite node_words2 preserving next_sibling
  //   (6) bump tree_version_seq + updates counter
  // ==========================================================================

  pub let a11y_tree_update_state : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64) (node_id: u64) (state_mask: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B8-03 (paideia-os #2302): overwrite node.state and bump tree_version_seq. Five callee-save pushes (rbx=row_id, r12=node_id, r13=state, r14=arena_base, r15=node_base) leave rsp%16==0 after prologue; every nested call site is naturally aligned. Preserves next_sibling by reading node_words2 first, then rewriting with (old_sibling, new_state). Labels prefixed a11y_tree_us_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov  rbx, rdi;                       // row_id
        mov  r12, rsi;                       // node_id
        mov  r13, rdx;                       // state_mask

        // (1) row_valid?
        mov  rdi, rbx;
        call a11y_tree_row_valid;
        cmp  rax, 0;
        je   a11y_tree_us_bad_slot;

        // (2) state fits in STATE_MASK_ALL?
        mov  rdi, r13;
        call a11y_tree_state_valid;
        cmp  rax, 0;
        je   a11y_tree_us_bad_state;

        // (3) arena_base.
        mov  rdi, rbx;
        call a11y_tree_arena_base;
        cmp  rax, 0;
        je   a11y_tree_us_bad_slot;
        mov  r14, rax;

        // (4) node_id < node_count?
        mov  rdi, r14;
        call a11y_tree_hdr_node_count;
        mov  rdi, r12;
        mov  rsi, rax;
        call a11y_tree_index_valid;
        cmp  rax, 0;
        je   a11y_tree_us_bad_node;

        // (5) rewrite node_words2 preserving next_sibling.
        mov  rdi, r14;
        mov  rsi, r12;
        call a11y_tree_node_addr;
        mov  r15, rax;

        // Read current next_sibling (low32 of node_words2).
        mov  rax, [r15 + 16];
        and  rax, 0xFFFFFFFF;
        // Pack (next_sibling, new_state) into rax and write back.
        mov  rdi, rax;
        mov  rsi, r13;
        call a11y_tree_pack_sib_state;
        mov  [r15 + 16], rax;

        // (6) Bump tree_version_seq (full u64 at hdr+16).
        mov  rax, [r14 + 16];
        add  rax, 1;
        mov  [r14 + 16], rax;

        // Bump updates counter.
        mov  rdi, 1;                         // A11Y_ST_UPDATES
        call a11y_tree_stats_bump;

        xor  rax, rax;                       // A11Y_OK
        jmp  a11y_tree_us_out;

      a11y_tree_us_bad_slot:
        mov  rax, 0xFFFFEB79;                // A11Y_BAD_SLOT
        jmp  a11y_tree_us_out;
      a11y_tree_us_bad_state:
        mov  rax, 0xFFFFEB76;                // A11Y_BAD_STATE
        jmp  a11y_tree_us_out;
      a11y_tree_us_bad_node:
        mov  rax, 0xFFFFEB78;                // A11Y_BAD_NODE_ID

      a11y_tree_us_out:
        pop  r15;
        pop  r14;
        pop  r13;
        pop  r12;
        pop  rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION K  a11y_tree_query_root
  //
  // a11y_tree_query_root(row_id) -> root_node_id
  //                               | A11Y_BAD_SLOT.
  //
  // Convenience wrapper over the header accessor for callers that hold
  // only a row_id (not the arena_base). Read-only; no version bump.
  // ==========================================================================

  pub let a11y_tree_query_root : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B8-03 (paideia-os #2302): row_id -> root_node_id via arena_base + hdr_root_node_id. One callee-save push (rbx=row_id): entry rsp%16==8, one 8-byte push gives rsp%16==0 -- the value every nested `call` needs at the callsite. No further pad required. Labels prefixed a11y_tree_qr_.",
      block: {
        push rbx;
        mov  rbx, rdi;

        mov  rdi, rbx;
        call a11y_tree_row_valid;
        cmp  rax, 0;
        je   a11y_tree_qr_bad_slot;

        mov  rdi, rbx;
        call a11y_tree_arena_base;
        cmp  rax, 0;
        je   a11y_tree_qr_bad_slot;

        mov  rdi, rax;
        call a11y_tree_hdr_root_node_id;
        jmp  a11y_tree_qr_out;

      a11y_tree_qr_bad_slot:
        mov  rax, 0xFFFFEB79;                // A11Y_BAD_SLOT

      a11y_tree_qr_out:
        pop  rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION L  a11y_tree_subscribe
  //
  // a11y_tree_subscribe(row_id, subscriber_kind_id) -> A11Y_OK
  //                                                  | A11Y_BAD_SLOT
  //                                                  | A11Y_MINT_BAD_WINDOW.
  //
  // A screen-reader cap binds itself as the tree's subscriber. At Wave
  // 0 fidelity, at most one subscriber is stored (subscriber_kind_id at
  // row +32); a subsequent subscribe REPLACES the existing subscriber
  // (multi-subscriber trees are a distinct future KIND per §2 discipline).
  // The header's subscriber_count is bumped to reflect the single live
  // binding (idempotent: repeated subscribes leave count at 1).
  //
  // The subscriber_kind_id is reused as a "wake this cap on version_seq
  // bump" hint. The wakeup mechanism lands in the follow-on dispatcher.
  //
  // Three callee-save pushes (rbx=row_id, r12=subscriber_id, r13=arena_
  // base): entry rsp%16==8, three 8-byte pushes leave rsp%16==0 which
  // is exactly what every nested `call` needs at the callsite. No
  // further pad required.
  // ==========================================================================

  pub let a11y_tree_subscribe : (u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64) (subscriber_kind_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B8-03 (paideia-os #2302): screen-reader subscribe binding. Writes subscriber_kind_id (u32) to row+32 and sets subscriber_count = 1 in hdr_words1[63:32] (idempotent). Rejects subscriber_kind_id == 0 with A11Y_NO_SUBSCRIBER (same nonzero-u32 shape as a11y_tree_window_valid). Three callee-save pushes leave rsp%16==0 which matches SysV call alignment; no further pad needed. Labels prefixed a11y_tree_sub_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov  rbx, rdi;                       // row_id
        mov  r12, rsi;                       // subscriber_kind_id

        // Validate row.
        mov  rdi, rbx;
        call a11y_tree_row_valid;
        cmp  rax, 0;
        je   a11y_tree_sub_bad_slot;

        // Validate subscriber_kind_id (reuse window_valid: nonzero + u32).
        mov  rdi, r12;
        call a11y_tree_window_valid;
        cmp  rax, 0;
        je   a11y_tree_sub_no_sub;

        // Get arena_base.
        mov  rdi, rbx;
        call a11y_tree_arena_base;
        cmp  rax, 0;
        je   a11y_tree_sub_bad_slot;
        mov  r13, rax;                       // arena_base

        // Write subscriber_kind_id to row+32.
        lea  r10, [rip + _a11y_tree_rows];
        mov  r11, rbx;
        shl  r11, 6;
        add  r10, r11;
        mov  rax, r12;
        and  rax, 0xFFFFFFFF;
        mov  [r10 + 32], rax;

        // Set subscriber_count = 1 in hdr_words1 preserving root_node_id.
        // hdr_words1 layout: root_node_id[31:0] | subscriber_count[63:32].
        mov  rax, [r13 + 8];
        and  rax, 0xFFFFFFFF;                // root_node_id low32
        mov  r11, 1;
        shl  r11, 32;
        or   rax, r11;
        mov  [r13 + 8], rax;

        // Bump tree_version_seq so any pre-existing observer notices
        // the subscription change on its next poll.
        mov  rax, [r13 + 16];
        add  rax, 1;
        mov  [r13 + 16], rax;

        xor  rax, rax;                       // A11Y_OK
        jmp  a11y_tree_sub_out;

      a11y_tree_sub_bad_slot:
        mov  rax, 0xFFFFEB79;                // A11Y_BAD_SLOT
        jmp  a11y_tree_sub_out;
      a11y_tree_sub_no_sub:
        mov  rax, 0xFFFFEB72;                // A11Y_NO_SUBSCRIBER

      a11y_tree_sub_out:
        pop  r13;
        pop  r12;
        pop  rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION M  a11y_tree_revoke  (window destroy path)
  //
  // a11y_tree_revoke(row_id) -> A11Y_OK | A11Y_BAD_SLOT | A11Y_REVOKE_ALREADY.
  //
  // Called by window_kind.pdx window_revoke when a KIND_WINDOW is
  // destroyed. Zeroes the row (arena bytes are left in place; the
  // arena is reclaimed on the next mint that reuses the slot).
  // ==========================================================================

  pub let a11y_tree_revoke : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B8-03 (paideia-os #2302): revoke one row. row_id >= A11Y_MAX(4) -> A11Y_BAD_SLOT; not in_use -> A11Y_REVOKE_ALREADY; else free + bump revokes + return A11Y_OK. Labels prefixed a11y_tree_rev_.",
      block: {
        push r12;
        mov  r12, rdi;

        mov  r10, 4;
        cmp  r12, r10;
        jae  a11y_tree_rev_bad_slot;

        mov  rdi, r12;
        call a11y_tree_row_valid;
        cmp  rax, 0;
        je   a11y_tree_rev_already;

        mov  rdi, r12;
        call a11y_tree_row_free;
        mov  rdi, 2;                         // A11Y_ST_REVOKES
        call a11y_tree_stats_bump;
        xor  rax, rax;
        jmp  a11y_tree_rev_out;

      a11y_tree_rev_bad_slot:
        mov  rax, 0xFFFFEB79;                // A11Y_BAD_SLOT
        jmp  a11y_tree_rev_out;
      a11y_tree_rev_already:
        mov  rax, 0xFFFFEB75;                // A11Y_REVOKE_ALREADY

      a11y_tree_rev_out:
        pop  r12;
        ret
      }
    }

  // ==========================================================================
  // SECTION N  Stats + init.
  // ==========================================================================

  pub let a11y_tree_stats_bump : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B8-03 (paideia-os #2302): bounds-checked counter bump against A11Y_ST_REFUSED+1=4. Load-inc-store idiom (no `add reg, [mem]`). Labels prefixed a11y_tree_sb_.",
      block: {
        cmp rdi, 4;
        jae a11y_tree_sb_out;
        lea r10, [rip + _a11y_tree_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      a11y_tree_sb_out:
        ret
      }
    }

  pub let a11y_tree_stats_read : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B8-03 (paideia-os #2302): bounds-checked counter read; OOB -> 0. Labels prefixed a11y_tree_sr_.",
      block: {
        cmp rdi, 4;
        jae a11y_tree_sr_zero;
        lea r10, [rip + _a11y_tree_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      a11y_tree_sr_zero:
        xor rax, rax;
        ret
      }
    }

  // a11y_tree_init(): zero row pool, arena pool, stats. Defensive re-
  // scrub; .bss is already zero at real boot. Mirrors lt_init / hmk_init.
  pub let a11y_tree_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B8-03 (paideia-os #2302): zero _a11y_tree_rows (32 u64), _a11y_tree_arenas (528 u64), _a11y_tree_stats (4 u64). Defensive; .bss is already zero at real boot. Labels prefixed a11y_tree_ini_.",
      block: {
        lea r10, [rip + _a11y_tree_rows];
        xor rax, rax;
        xor rcx, rcx;
      a11y_tree_ini_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  a11y_tree_ini_rows;

        lea r10, [rip + _a11y_tree_arenas];
        xor rcx, rcx;
      a11y_tree_ini_arenas:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 528;
        jb  a11y_tree_ini_arenas;

        lea r10, [rip + _a11y_tree_stats];
        xor rcx, rcx;
      a11y_tree_ini_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  a11y_tree_ini_stats;
        ret
      }
    }
}
