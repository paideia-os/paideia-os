    }

  // ==========================================================================
  // SECTION D  Packers (row + node/header word encoders).
  // ==========================================================================

  // a11y_tree_pack_hdr_row(window_kind_slot, sealed) -> row header word.
  // in_use[63:56] is left zero; the alloc path sets it. sealed bit sits
  // at [8:8]; window_kind_slot at [47:16] (u32 slot ordinal).
  pub let a11y_tree_pack_hdr_row : (u64, u64) -> u64 !{} @{} =
    fn (window_kind_slot: u64) (sealed: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B8-03 (paideia-os #2302): pack KIND-cap row header. window_kind_slot at [47:16] (u32 masked), sealed at [8:8]. in_use bit is stamped by a11y_tree_row_alloc's success tail. Labels prefixed a11y_tree_phr_.",
      block: {
        mov rax, rdi;
        and rax, 0xFFFFFFFF;
        shl rax, 16;
        mov r10, rsi;
        and r10, 0x1;
        shl r10, 8;
        or  rax, r10;
        ret
      }
    }

  // a11y_tree_pack_u32_pair(lo, hi) -> lo[31:0] | hi[63:32]. Reused for
  // every (u32, u32) header/node word.
  pub let a11y_tree_pack_u32_pair : (u64, u64) -> u64 !{} @{} =
    fn (lo: u64) (hi: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B8-03 (paideia-os #2302): pack (u32, u32) -> u64 with lo at [31:0] and hi at [63:32]. Reused for header (wkid|count), (root|subs), and node (parent|child), (sibling|state-packed-below), (label|value) pairs. Labels prefixed a11y_tree_pup_.",
      block: {
        mov rax, rdi;
        and rax, 0xFFFFFFFF;
        mov r10, rsi;
        and r10, 0xFFFFFFFF;
        shl r10, 32;
        or  rax, r10;
        ret
      }
    }

  // a11y_tree_pack_id_role(node_id, role) -> node_id[31:0] | role[39:32].
  pub let a11y_tree_pack_id_role : (u64, u64) -> u64 !{} @{} =
    fn (node_id: u64) (role: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B8-03 (paideia-os #2302): pack node_words0 (id|role). node_id masked to u32; role masked to u8 then shifted to [39:32]. Reserved bits 40..63 remain zero. Labels prefixed a11y_tree_pir_.",
      block: {
        mov rax, rdi;
        and rax, 0xFFFFFFFF;
        mov r10, rsi;
        and r10, 0xFF;
        shl r10, 32;
        or  rax, r10;
        ret
