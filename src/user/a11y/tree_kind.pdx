    }

  // a11y_tree_pack_sib_state(next_sibling, state) -> sibling[31:0] | state[39:32].
  pub let a11y_tree_pack_sib_state : (u64, u64) -> u64 !{} @{} =
    fn (next_sibling: u64) (state: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B8-03 (paideia-os #2302): pack node_words2 (sibling|state). next_sibling masked to u32; state masked to u8 then shifted to [39:32]. Reserved bits 40..63 remain zero for future state widening. Labels prefixed a11y_tree_pss_.",
      block: {
        mov rax, rdi;
        and rax, 0xFFFFFFFF;
        mov r10, rsi;
        and r10, 0xFF;
        shl r10, 32;
        or  rax, r10;
        ret
      }
    }

  // a11y_tree_pack_arena_ref(arena_slot) -> arena_slot[7:0] | reserved.
  pub let a11y_tree_pack_arena_ref : (u64) -> u64 !{} @{} =
    fn (arena_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B8-03 (paideia-os #2302): pack the arena_ref word (arena_slot at low 8 bits). Labels prefixed a11y_tree_par_.",
      block: {
        mov rax, rdi;
        and rax, 0xFF;
        ret
