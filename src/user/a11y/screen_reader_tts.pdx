// src/user/a11y/screen_reader_tts.pdx -- Wave0-B10-07 (paideia-os #2309)
//
// SCREEN-READER TTS OUTPUT CLIENT + PHONEME CACHE  (LOGIC MODULE).
//
// Companion / precedent:
//   * src/user/a11y/screen_reader_protocol.pdx (Wave0-B9-09,
//     paideia-os #2308) defines the subscribe/push/pop/unsubscribe
//     protocol between the compositor's KIND_A11Y_TREE mutation site
//     and a screen-reader client's read loop, including the
//     ScreenReaderEvent enum (SR_TREE_UPDATED=0, SR_FOCUS_CHANGED=1,
//     SR_NODE_DESTROYED=2, SR_TREE_DESTROYED=3) that THIS module
//     dispatches on in tts_client_on_a11y_event.
//   * src/user/a11y/tree_kind.pdx (Wave0-B8-03, paideia-os #2302)
//     defines KIND_A11Y_TREE = 0x1D3 and its subscribe binding; the
//     screen_reader_sub_id this client stores is a row_id in the
//     screen_reader_protocol pool that was in turn allocated over a
//     KIND_A11Y_TREE row the client already held RIGHT_A11Y_SUBSCRIBE on.
//
// =============================================================================
// SECTION 0  WHY THIS MODULE EXISTS
// =============================================================================
//
// The AT-SPI / Orca lineage puts speech synthesis in the same process
// as the screen reader (Orca <-> speech-dispatcher <-> espeak, all
// linked into or spawned by the screen-reader daemon; the daemon holds
// the pronunciation dictionary in-heap and the speak-utterance queue
// as an in-process std::deque). That posture bakes two ambient-authority
// concessions into the a11y story:
//
//   * Whoever compromises the screen-reader process ALSO gains the
//     TTS engine's private state -- the pronunciation dictionary,
//     the utterance queue, the audio-device handle. A screen reader
//     with keystroke visibility, a synthesised-voice output channel,
//     AND a compromised TTS engine has enough surface to leak the
//     user's typed passwords via inaudible ultrasound modulation.
//     PaideiaOS refuses that shape: the TTS engine is a SATELLITE
//     PROCESS holding the audio-device cap and the phoneme-cache
//     KIND_MEMORY cap; the screen reader (and this client-side glue)
//     holds ONLY a send-audio cap on the engine. The engine can be
//     revoked independently of the screen reader, and vice versa.
//
//   * The pronunciation dictionary is a large, read-only, per-locale
//     table (English CMUdict is 130k entries * ~20 bytes = 2.6 MB;
//     a Japanese kanji dictionary is larger still). Loading it into
//     the screen-reader process at startup is a 2.6 MB allocation
//     that participates in that process's per-page write faults;
//     sharing it across multiple assistive-tech clients (screen
//     magnifier, braille output, TTS voice preview in a settings UI)
//     requires a marshalling shim over IPC. PaideiaOS models the
//     dictionary as an IMMUTABLE KIND_MEMORY capability minted once
//     at boot from the pdxfs read-only volume that ships the
//     locale-specific phoneme table; every a11y client receives a
//     read-only handle to the SAME physical pages via cap-share, no
//     copy and no per-client fault-in cost.
//
// This is the NOVEL-CLEAN DESIGN choice: TTS engine as satellite
// process (revocable independently of the screen reader), phoneme
// cache as immutable KIND_MEMORY cap (shared across all a11y
// clients zero-copy). The client-side glue in THIS module is a
// small state cell holding those three caps plus the voice
// configuration; it exposes a speak/cancel API to the screen
// reader and a dispatch shim from ScreenReaderEvent -> speak call.
//
// LOGIC MODULE, NOT A KIND-CAP.  Like screen_reader_protocol.pdx
// (paideia-os #2308), this file lives entirely on the userland
// supervisor side of the ring boundary. It exposes no cap-substrate
// mint gate, no rights word, and is not wired into cap_table. The
// authorities it composes over -- KIND_A11Y_TREE (0x1D3) for the
// subscription, KIND_TTS_ENGINE (forward-reserved at 0x1E0) for the
// engine send-cap, KIND_MEMORY (0x004) for the phoneme cache -- are
// each gated on their own capability check at their own dispatch
// sites; this module holds the ordinal IDs and does no minting.
//
// FUTURE PROMOTION PATHS.  Three plausible landings would move
// pieces of this module into the kernel:
//
//   (a) KIND_TTS_ENGINE (0x1E0) mint gate lands as
//       src/kernel/core/cap/kind_tts_engine.pdx; the tts_engine_kind_id
//       stored here becomes a live KIND_TTS_ENGINE row rather than a
//       forward-reserved integer.
//   (b) A KIND_PHONEME_CACHE derivation over KIND_MEMORY lands as
//       src/kernel/core/cap/kind_phoneme_cache.pdx; the cache
//       lookup below promotes from "returns 0 == miss unconditionally"
//       to a kernel-side cap dispatch that walks the hash table and
//       returns a phoneme_offset into the shared read-only pages.
//   (c) The utterance queue becomes crash-survivable via the
//       recovery plane (KIND_RECOVERY_PLANE = 0x1C8), so a screen-
//       reader crash mid-utterance resumes speech rather than
//       dropping the current sentence.
//
// Nothing in this landing prevents any of those promotions; the
// state cell's layout has a reserved u64 in each row for the
// KIND_PHONEME_CACHE ordinal that (b) would need, and the
// utterance_seq is already a u64 so (c) can persist it as-is.
//
// =============================================================================
// SECTION 1  MODULE POSTURE
// =============================================================================
//
// No KIND_* slot is allocated for this module (§0 rationale). No
// parent kind, no rights word. The state_id returned by tts_client_new
// is a row_id in this module's pool (0..SRTC_MAX_STATES-1) rather
// than a KIND-cap ordinal, and the caller stores it in its per-
// client bookkeeping and passes it back on every speak / cancel /
// on_a11y_event / lookup_phonemes call.
//
// SRTC_MAX_STATES = 1 at Wave 0 fidelity: exactly one screen-reader
// client (Orca-equivalent) per session. The pool shape is kept so a
// future landing that supports multiple concurrent a11y clients
// (screen magnifier + braille output + TTS voice preview in a
// settings UI, all live at once) can bump SRTC_MAX_STATES without
// a row-shape break.
//
// =============================================================================
// SECTION 2  ROW LAYOUT  (32 BYTES = HALF CACHE LINE)
// =============================================================================
//
// One row per live TTS client. 32 bytes leaves headroom for a future
// landing that adds e.g. a locale-tag word or a per-client audio-
// output-device cap without a row-shape break.
//
//   [+0]  hdr:            screen_reader_sub_id[31:0]
//                                       | tts_engine_kind_id[63:32]
//                         -- sub_id: row_id in the screen_reader_protocol
//                            pool (§0 companion note).  engine: cap-slot
//                            ordinal for the KIND_TTS_ENGINE row the
//                            client will send speak requests to.
//   [+8]  cfg:             phoneme_cache_kind_id[31:0]
//                                       | voice_rate[47:32]
//                                       | punctuation_mode[55:48]
//                                       | in_use[63:56]
//                         -- cache: cap-slot ordinal for the KIND_MEMORY
//                            row backing the pronunciation dictionary.
//                            voice_rate: words per minute (u16-wide;
//                            enum values 50/100/180/300 fit u16 with
//                            headroom to 65535).  punctuation_mode:
//                            TtsPunctuationMode enum ordinal (u8).
//                            in_use: 0 = row free, 1 = row live
//                            (mirrors screen_reader_protocol's in_use
//                            bit position at [63:56] of the row_hdr).
//   [+16] utter_seq:       current_utterance_seq (u64, monotone)
//                         -- bumped on every tts_client_speak_text
//                            call; the returned seq is the value AFTER
//                            the bump.  Wraparound at u64 max is
//                            2^64 utterances, ~584 million years at
//                            one utterance per nanosecond -- for
//                            practical purposes the counter is
//                            un-wrappable, so a cancel(seq) with a
//                            stale seq safely fails the seq-match
//                            gate without ambiguity.
//   [+24] reserved:        u64  (headroom for a future landing that
//                                adds e.g. a locale-tag word or a
//                                per-client audio-device cap without
//                                a row-shape break).
//
// SRTC_MAX_STATES = 1 rows * 32 bytes = 32 bytes = 4 u64.
//
// =============================================================================
// SECTION 3  ENUMS
// =============================================================================
//
// TtsVoiceRate  (words per minute; u16 range but semantically enum):
//
//   RATE_SLOW      = 50    -- lower comprehension bound for a listener
//                             new to synthetic speech.
//   RATE_NORMAL    = 100   -- typical "natural read-aloud" pace;
//                             the tts_client_new default.
//   RATE_FAST      = 180   -- experienced screen-reader user pace;
//                             Orca's default is in this neighborhood.
//   RATE_VERY_FAST = 300   -- power-user pace; only intelligible to
//                             listeners with substantial synthetic-
//                             speech acclimation.
//
// TtsPunctuationMode  (u8):
//
//   PUNCT_NONE = 0  -- punctuation is not spoken (only pauses
//                      inferred from sentence boundaries).
//   PUNCT_MOST = 1  -- period/comma/question/exclamation are spoken;
//                      other punctuation is inferred as a pause.
//                      This is the tts_client_new default (matches
//                      Orca's out-of-box behavior).
//   PUNCT_ALL  = 2  -- every punctuation character is spoken by
//                      name ("open paren", "semicolon", ...);
//                      valuable when the listener is proofreading
//                      code or a legal contract.
//
// SRTC_RATE_MAX  = 300  gates tts_client_new's rate argument.
// SRTC_PUNCT_MAX = 2    gates tts_client_new's punct-mode argument.
//
// =============================================================================
// SECTION 4  FAILURE TAXONOMY  0xFFFFECD3..0xFFFFECDE
// =============================================================================
//
// The task-row hint was 0xFFFFEC70..0xFFFFEC7F but a repo-wide grep at
// landing time (`grep -rhoE '0xFFFFEC7[0-9A-Fa-f]' src/`) shows
// 0xFFFFEC70..0xFFFFEC7F fully claimed by src/kernel/core/cap/
// {cap_handler_blkdev,nvme_recovery,nvme_admin_events,nvme_reliability,
// kind_ahci_controller}.pdx. Following the screen_reader_protocol.pdx §5
// precedent -- which itself deviated from its hint band when the band
// was already claimed -- this landing selects the free sub-band
// 0xFFFFECD3..0xFFFFECDE (12 slots), verified free by
// `grep -rhoE '0xFFFFECD[3-9A-Ea-e]' src/` returning empty at landing
// time. The band remains in the EC page adjacent to a11y neighbors
// so the wider a11y row stays contiguous in the ECxx page.
//
//   SRTC_OK              = 0                (canonical success)
//   SRTC_TAIL_ENOSPC     = 0xFFFFECDE       (tts_client_new pool full)
//   SRTC_BAD_SUB         = 0xFFFFECDD       (sr_sub_id == 0 or > u32-max)
//   SRTC_BAD_ENGINE      = 0xFFFFECDC       (tts_engine_kind_id == 0
//                                            or > u32-max)
//   SRTC_BAD_CACHE       = 0xFFFFECDB       (phoneme_cache_kind_id == 0
//                                            or > u32-max)
//   SRTC_BAD_RATE        = 0xFFFFECDA       (voice_rate > SRTC_RATE_MAX
//                                            (300); also refuses 0)
//   SRTC_BAD_PUNCT       = 0xFFFFECD9       (punctuation_mode >
//                                            SRTC_PUNCT_MAX(2))
//   SRTC_BAD_STATE       = 0xFFFFECD8       (state_id >= SRTC_MAX_STATES
//                                            or row not in_use)
//   SRTC_BAD_TEXT        = 0xFFFFECD7       (text_len == 0 or text_len
//                                            > SRTC_TEXT_MAX)
//   SRTC_BAD_WORD        = 0xFFFFECD6       (word_len == 0 or word_len
//                                            > SRTC_WORD_MAX)
//   SRTC_BAD_EVENT       = 0xFFFFECD5       (event_kind >
//                                            SR_EVENT_MAX(3); mirrors
//                                            screen_reader_protocol's
//                                            SR_BAD_EVENT gate)
//   SRTC_UTTER_STALE     = 0xFFFFECD4       (cancel(seq) with a seq
//                                            that is not the current
//                                            utterance and not 0; not
//                                            an error strictly -- the
//                                            utterance already
//                                            completed or was
//                                            superseded; caller can
//                                            treat as SRTC_OK.  The
//                                            sentinel exists so a
//                                            client can distinguish
//                                            "cancel raced completion"
//                                            from "cancel took effect".)
//   SRTC_PHONEME_MISS    = 0                (cache lookup miss; NOT a
//                                            failure -- callers of
//                                            tts_client_lookup_phonemes
//                                            treat a zero return as
//                                            "not in cache, ask the
//                                            engine to synthesize".
//                                            Aliased with SRTC_OK
//                                            intentionally: both are
//                                            zero, both mean "nothing
//                                            further to say".)
//
// =============================================================================
// SECTION 5  FUNCTION CATALOGUE
// =============================================================================
//
//   tts_client_new(sr_sub_id, tts_engine_kind_id, phoneme_cache_kind_id)
//                                       -> state_id | error
//     -- Allocates a row bound to the three cap ordinals with
//        voice_rate = RATE_NORMAL(100) and punctuation_mode =
//        PUNCT_MOST(1) as defaults (a caller wanting a different
//        rate or punct-mode calls the setter after new; keeping
//        the factory arg-count small avoids a wide argument
//        prefix on every construction site).
//
//   tts_client_speak_text(state_id, text_offset, text_len)
//                                       -> utter_seq | error
//     -- Bumps current_utterance_seq and returns the post-bump
//        value. AT THIS LANDING the engine send-path is NOT wired:
//        the return value is the seq the future engine-send landing
//        will use as the audit-record key; the text bytes at
//        (text_offset, text_len) are validated for nonzero length
//        and bounded length but are NOT copied out. A caller can
//        thread the seq into a subsequent cancel call and observe
//        the correct sequence-match behavior.
//
//   tts_client_cancel(state_id, utter_seq) -> SRTC_OK | SRTC_UTTER_STALE
//                                            | SRTC_BAD_STATE
//     -- utter_seq == 0 cancels ALL in-flight utterances (semantically
//        equivalent to a global stop). utter_seq > 0 cancels only the
//        matching utterance and returns SRTC_UTTER_STALE if the current
//        utterance seq no longer matches (i.e. the utterance completed
//        or was superseded before the cancel arrived). AT THIS LANDING
//        the engine-side cancel dispatch is not wired; the function
//        performs the seq-match gate and bumps stats, so a caller can
//        already observe the correct control flow.
//
//   tts_client_on_a11y_event(state_id, event_kind, node_id)
//                                       -> SRTC_OK | SRTC_BAD_STATE
//                                        | SRTC_BAD_EVENT
//     -- Dispatches on ScreenReaderEvent (from screen_reader_protocol
//        §4):
//          SR_FOCUS_CHANGED(1)  -> speak the focused node's label
//                                  (label lookup requires walking
//                                  KIND_A11Y_TREE; not wired at this
//                                  landing, so the function bumps
//                                  SRTC_ST_A11Y_EVENTS and returns).
//          SR_TREE_UPDATED(0)   -> speak the update if applicable
//                                  (heuristic: only if the changed
//                                  subtree contains the focused
//                                  node; also not wired at this
//                                  landing, same stats bump).
//          SR_NODE_DESTROYED(2) -> silent (the focused-node path
//                                  is the only user-facing signal;
//                                  a destroyed node is only spoken
//                                  if it WAS the focused node,
//                                  which the focus-tracker in the
//                                  screen reader will re-emit as
//                                  a SR_FOCUS_CHANGED to a sibling).
//          SR_TREE_DESTROYED(3) -> silent (the client teardown is
//                                  the screen reader's job; this
//                                  glue does not speak "window
//                                  closed" -- a UX choice that
//                                  keeps the audio channel from
//                                  becoming noisy on every alt-tab).
//        event_kind > 3 refuses with SRTC_BAD_EVENT (mirrors
//        screen_reader_protocol_event_valid's gate).
//
//   tts_client_lookup_phonemes(state_id, word_offset, word_len)
//                                       -> phoneme_offset | 0
//     -- Zero return means "not in cache". AT THIS LANDING the cache
//        walker is not landed (see §0 future-promotion path (b));
//        this function returns 0 (miss) unconditionally after
//        validating state_id and word_len. Every call bumps
//        SRTC_ST_PHONEME_MISSES. A future landing that wires the
//        cache walk will bump SRTC_ST_PHONEME_HITS instead on the
//        found path and return the offset into the KIND_MEMORY
//        cache pages.
//
//   tts_client_set_rate(state_id, rate) -> SRTC_OK | SRTC_BAD_STATE
//                                        | SRTC_BAD_RATE
//     -- Setter for voice_rate. Validates rate in (0, SRTC_RATE_MAX(300)].
//
//   tts_client_set_punct(state_id, mode) -> SRTC_OK | SRTC_BAD_STATE
//                                         | SRTC_BAD_PUNCT
//     -- Setter for punctuation_mode. Validates mode in
//        [0, SRTC_PUNCT_MAX(2)].
//
//   tts_client_free(state_id) -> SRTC_OK | SRTC_BAD_STATE
//     -- LINEAR consume: frees the row. The caller MUST NOT reuse
//        state_id after this call.
//
// =============================================================================
// SECTION 6  FINGERPRINT
// =============================================================================
//
// One tag ending `[legacy: SCREEN READER TTS META OK]` per softarch
// discipline (see feedback_paideia_as_reserved_labels-adjacent
// convention used by kind_tls_trust / kind_tui_canvas / kind_layer_tree /
// a11y/tree_kind / a11y/screen_reader_protocol). Data-only at this
// landing; needs allowlisting in tools/verify-fingerprint-coverage.sh
// with reason "screen_reader_tts meta emit body not yet landed
// (Wave0-B10-07 #2309)" until a future landing wires an emit site
// into tts_client_new's success tail via klog_s1_x1. Allowlist wire-up
// is a separate landing per the batch's file-touch discipline (this
// landing is ONE file only).
//
// LABEL PREFIX: `screen_reader_tts_` throughout -- avoids paideia-as
// reserved-keyword collisions per feedback_paideia_as_reserved_labels;
// all ASM jump targets are `screen_reader_tts_<tag>`.

module ScreenReaderTts = structure {

  // ==========================================================================
  // SECTION A  Identity + enums + sizing + failure taxonomy.
  // ==========================================================================

  // Row-pool sizing.
  pub let SRTC_MAX_STATES     : u64 = 1      // one screen-reader client.
  pub let SRTC_ROW_BYTES      : u64 = 32     // half cache line.

  // Row byte offsets (within a 32-byte row).
  pub let SRTC_ROW_OFF_HDR        : u64 = 0     // sr_sub | engine
  pub let SRTC_ROW_OFF_CFG        : u64 = 8     // cache | rate | punct | in_use
  pub let SRTC_ROW_OFF_UTTER      : u64 = 16    // current_utterance_seq
  pub let SRTC_ROW_OFF_RESERVED   : u64 = 24    // headroom

  // TtsVoiceRate enum (words per minute).
  pub let RATE_SLOW           : u64 = 50
  pub let RATE_NORMAL         : u64 = 100
  pub let RATE_FAST           : u64 = 180
  pub let RATE_VERY_FAST      : u64 = 300
  pub let SRTC_RATE_MAX       : u64 = 300

  // TtsPunctuationMode enum.
  pub let PUNCT_NONE          : u64 = 0
  pub let PUNCT_MOST          : u64 = 1
  pub let PUNCT_ALL           : u64 = 2
  pub let SRTC_PUNCT_MAX      : u64 = 2

  // Text / word bounds (validators; keep the client from being asked
  // to speak arbitrarily-long buffers at this fidelity).
  pub let SRTC_TEXT_MAX       : u64 = 65536     // 64 KiB per utterance.
  pub let SRTC_WORD_MAX       : u64 = 256       // 256 bytes per lookup key.

  // Forward-reserved KIND ordinal for KIND_TTS_ENGINE. When a future
  // landing mints kind_tts_engine.pdx the ordinal here becomes a live
  // KIND_TTS_ENGINE cap slot; until then it is a client-side hint
  // constant only. See §0 future-promotion path (a).
  pub let KIND_TTS_ENGINE     : u64 = 0x1E0

  // Failure taxonomy -- 0xFFFFECD3..0xFFFFECDE (see file header §4).
  pub let SRTC_OK             : u64 = 0
  pub let SRTC_TAIL_ENOSPC    : u64 = 0xFFFFECDE
  pub let SRTC_BAD_SUB        : u64 = 0xFFFFECDD
  pub let SRTC_BAD_ENGINE     : u64 = 0xFFFFECDC
  pub let SRTC_BAD_CACHE      : u64 = 0xFFFFECDB
  pub let SRTC_BAD_RATE       : u64 = 0xFFFFECDA
  pub let SRTC_BAD_PUNCT      : u64 = 0xFFFFECD9
  pub let SRTC_BAD_STATE      : u64 = 0xFFFFECD8
  pub let SRTC_BAD_TEXT       : u64 = 0xFFFFECD7
  pub let SRTC_BAD_WORD       : u64 = 0xFFFFECD6
  pub let SRTC_BAD_EVENT      : u64 = 0xFFFFECD5
  pub let SRTC_UTTER_STALE    : u64 = 0xFFFFECD4

  // SRTC_PHONEME_MISS aliases SRTC_OK: both are 0, both mean "nothing
  // further to say" (see §4).
  pub let SRTC_PHONEME_MISS   : u64 = 0

  // Screen-reader event ordinals -- MUST agree with
  // screen_reader_protocol.pdx §4 (SR_TREE_UPDATED..SR_TREE_DESTROYED).
  // Named locally so a future extension in screen_reader_protocol
  // (SR_EVENT_MAX bump) forces a synchronised landing here.
  pub let SRTC_EV_TREE_UPDATED    : u64 = 0
  pub let SRTC_EV_FOCUS_CHANGED   : u64 = 1
  pub let SRTC_EV_NODE_DESTROYED  : u64 = 2
  pub let SRTC_EV_TREE_DESTROYED  : u64 = 3
  pub let SRTC_EV_MAX             : u64 = 3

  // Stats channels (six u64s of counters, bounds-checked against 6).
  pub let SRTC_ST_SPOKEN          : u64 = 0
  pub let SRTC_ST_CANCELLED       : u64 = 1
  pub let SRTC_ST_A11Y_EVENTS     : u64 = 2
  pub let SRTC_ST_PHONEME_HITS    : u64 = 3
  pub let SRTC_ST_PHONEME_MISSES  : u64 = 4
  pub let SRTC_ST_REFUSED         : u64 = 5

  // ==========================================================================
  // SECTION B  State cells.
  // ==========================================================================

  // TTS-client state-row pool. SRTC_MAX_STATES rows * 32 bytes =
  // 32 bytes = 4 u64. Aligned to 64 so the (future) SRTC_MAX_STATES
  // > 1 landing does not straddle a cache line for row 0.
  pub let mut _screen_reader_tts_rows  : [u64; 4]  = uninit @align(64)

  // Global stats. Bounds-checked against 6 in _stats_bump / _stats_read.
  pub let mut _screen_reader_tts_stats : [u64; 6]  = uninit @align(64)

  // Fingerprint tag. Data-only at this landing; needs allowlisting in
  // tools/verify-fingerprint-coverage.sh with reason
  // "screen_reader_tts meta emit body not yet landed (Wave0-B10-07
  // #2309)" until a future landing wires an emit site into
  // tts_client_new's success tail via klog_s1_x1.
  //
  // "pdx kind screen reader tts meta [legacy: SCREEN READER TTS
  //  META OK]\0" = 67 bytes of payload + 1 NUL = 68 bytes.
  pub let pdx_kind_screen_reader_tts_meta : [u8; 68] = "pdx kind screen reader tts meta [legacy: SCREEN READER TTS META OK]\0"

  // ==========================================================================
  // SECTION C  Validators (new-time / setter / event-time).
  // ==========================================================================

  // screen_reader_tts_sub_valid(id) -> 1 iff id in (0, 2^32).
  // Mirrors screen_reader_protocol_subscriber_valid's shape.
  pub let screen_reader_tts_sub_valid : (u64) -> u64 !{} @{} =
    fn (id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B10-07 (paideia-os #2309): 1 iff sr_sub_id in (0, 2^32). Zero refuses a free-floating TTS client (there must be an active screen-reader subscription); >u32 refuses garbage. Labels prefixed screen_reader_tts_sv_.",
      block: {
        cmp rdi, 0;
        je  screen_reader_tts_sv_no;
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  screen_reader_tts_sv_no;
        mov rax, 1;
        ret;
      screen_reader_tts_sv_no:
        xor rax, rax;
        ret
      }
    }

  // screen_reader_tts_engine_valid(id) -> 1 iff id in (0, 2^32).
  pub let screen_reader_tts_engine_valid : (u64) -> u64 !{} @{} =
    fn (id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B10-07 (paideia-os #2309): 1 iff tts_engine_kind_id in (0, 2^32). Zero refuses a free-floating client (a client MUST be bound to a KIND_TTS_ENGINE cap slot to speak); >u32 refuses garbage. Labels prefixed screen_reader_tts_ev_.",
      block: {
        cmp rdi, 0;
        je  screen_reader_tts_ev_no;
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  screen_reader_tts_ev_no;
        mov rax, 1;
        ret;
      screen_reader_tts_ev_no:
        xor rax, rax;
        ret
      }
    }

  // screen_reader_tts_cache_valid(id) -> 1 iff id in (0, 2^32).
  pub let screen_reader_tts_cache_valid : (u64) -> u64 !{} @{} =
    fn (id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B10-07 (paideia-os #2309): 1 iff phoneme_cache_kind_id in (0, 2^32). Zero refuses a client with no cache (a lookup-miss client is fine, but the CAP must exist so a future landing can bind the walker); >u32 refuses garbage. Labels prefixed screen_reader_tts_cv_.",
      block: {
