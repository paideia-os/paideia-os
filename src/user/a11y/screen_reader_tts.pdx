  // ==========================================================================
  // SECTION D  Packers (row header + cfg encoders).
  // ==========================================================================

  // screen_reader_tts_pack_hdr(sr_sub_id, engine_kind_id) ->
  //     sr_sub_id[31:0] | engine_kind_id[63:32].
  pub let screen_reader_tts_pack_hdr : (u64, u64) -> u64 !{} @{} =
    fn (sr_sub_id: u64) (engine_kind_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B10-07 (paideia-os #2309): pack row hdr word. sr_sub_id at [31:0] (u32 masked); engine_kind_id at [63:32] (u32 masked then shifted). Labels prefixed screen_reader_tts_ph_.",
      block: {
        mov rax, rdi;
        and rax, 0xFFFFFFFF;
        mov r10, rsi;
        and r10, 0xFFFFFFFF;
        shl r10, 32;
        or  rax, r10;
        ret
      }
    }

  // screen_reader_tts_pack_cfg(cache_kind_id, rate, punct) ->
  //     cache[31:0] | rate[47:32] | punct[55:48] | in_use[63:56].
  // in_use bit is stamped by _row_alloc's success tail.
  pub let screen_reader_tts_pack_cfg : (u64, u64, u64) -> u64 !{} @{} =
    fn (cache_kind_id: u64) (rate: u64) (punct: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B10-07 (paideia-os #2309): pack cfg word. cache_kind_id at [31:0] (u32 masked); rate at [47:32] (u16 masked); punct at [55:48] (u8 masked); in_use bit at [63:56] stamped by _row_alloc's success tail (left zero here). Labels prefixed screen_reader_tts_pc_.",
      block: {
        mov rax, rdi;
        and rax, 0xFFFFFFFF;
        mov r10, rsi;
        and r10, 0xFFFF;
        shl r10, 32;
        or  rax, r10;
        mov r10, rdx;
        and r10, 0xFF;
        shl r10, 48;
        or  rax, r10;
        ret
      }
    }

  // ==========================================================================
  // SECTION E  Row address arithmetic + accessors.
  //
  // Row base = _screen_reader_tts_rows + row_id * 32 (shl 5).
  // Stride is power-of-two so no imul is emitted; the offset multiply
  // folds to a single shl. Encoder-conservative per the file's no-imul-
  // when-shl-suffices convention.
  // ==========================================================================

  // screen_reader_tts_row_base(row_id) -> ptr | 0.
  pub let screen_reader_tts_row_base : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-07 (paideia-os #2309): row base pointer = _screen_reader_tts_rows + row_id * 32. Bounds-checked against SRTC_MAX_STATES(1); OOB returns 0 (caller compares against zero before dereferencing). Labels prefixed screen_reader_tts_rb_.",
      block: {
        mov r10, 1;
        cmp rdi, r10;
        jae screen_reader_tts_rb_no;
        lea r10, [rip + _screen_reader_tts_rows];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, r10;
        ret;
      screen_reader_tts_rb_no:
        xor rax, rax;
        ret
      }
    }

  // screen_reader_tts_row_sub_id(row_base) -> sr_sub_id at hdr[31:0].
  pub let screen_reader_tts_row_sub_id : (u64) -> u64 !{mem} @{} =
    fn (row_base: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-07 (paideia-os #2309): read sr_sub_id from hdr[31:0]. Labels prefixed screen_reader_tts_rs_.",
      block: {
        mov rax, [rdi + 0];
        and rax, 0xFFFFFFFF;
        ret
      }
    }

  // screen_reader_tts_row_engine(row_base) -> engine_kind_id at hdr[63:32].
  pub let screen_reader_tts_row_engine : (u64) -> u64 !{mem} @{} =
    fn (row_base: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-07 (paideia-os #2309): read tts_engine_kind_id from hdr[63:32]. Labels prefixed screen_reader_tts_re_.",
      block: {
        mov rax, [rdi + 0];
        shr rax, 32;
        ret
      }
    }

  // screen_reader_tts_row_cache(row_base) -> cache_kind_id at cfg[31:0].
  pub let screen_reader_tts_row_cache : (u64) -> u64 !{mem} @{} =
    fn (row_base: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-07 (paideia-os #2309): read phoneme_cache_kind_id from cfg[31:0]. Labels prefixed screen_reader_tts_rc_.",
      block: {
        mov rax, [rdi + 8];
        and rax, 0xFFFFFFFF;
        ret
      }
    }

  // screen_reader_tts_row_rate(row_base) -> voice_rate at cfg[47:32].
  pub let screen_reader_tts_row_rate : (u64) -> u64 !{mem} @{} =
    fn (row_base: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-07 (paideia-os #2309): read voice_rate (u16) from cfg[47:32]. Labels prefixed screen_reader_tts_rr_.",
      block: {
        mov rax, [rdi + 8];
        shr rax, 32;
        and rax, 0xFFFF;
        ret
      }
    }

  // screen_reader_tts_row_punct(row_base) -> punct_mode at cfg[55:48].
  pub let screen_reader_tts_row_punct : (u64) -> u64 !{mem} @{} =
    fn (row_base: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-07 (paideia-os #2309): read punctuation_mode (u8) from cfg[55:48]. Labels prefixed screen_reader_tts_rp_.",
      block: {
        mov rax, [rdi + 8];
        shr rax, 48;
        and rax, 0xFF;
        ret
      }
    }

  // screen_reader_tts_row_utter_seq(row_base) -> current_utterance_seq (u64).
  pub let screen_reader_tts_row_utter_seq : (u64) -> u64 !{mem} @{} =
    fn (row_base: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-07 (paideia-os #2309): read current_utterance_seq (full u64) from row+16. Labels prefixed screen_reader_tts_ru_.",
      block: {
        mov rax, [rdi + 16];
        ret
      }
    }

  // ==========================================================================
  // SECTION F  Row-pool primitives (valid / alloc / free).
  // ==========================================================================

  // screen_reader_tts_row_valid(row_id) -> 1 iff row_id <
  // SRTC_MAX_STATES AND in_use bit set (cfg[63:56]).
  pub let screen_reader_tts_row_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-07 (paideia-os #2309): 1 iff row_id < SRTC_MAX_STATES(1) AND in_use (cfg[63:56] != 0). Row address = _screen_reader_tts_rows + row_id * 32; *32 uses shl 5. Labels prefixed screen_reader_tts_rv_.",
      block: {
        mov r10, 1;
        cmp rdi, r10;
        jae screen_reader_tts_rv_no;
        lea r10, [rip + _screen_reader_tts_rows];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 8];
        shr rax, 56;
        cmp rax, 0;
        je  screen_reader_tts_rv_no;
        mov rax, 1;
        ret;
      screen_reader_tts_rv_no:
        xor rax, rax;
        ret
      }
    }

  // screen_reader_tts_row_alloc(hdr, cfg) -> row_id | SRTC_TAIL_ENOSPC.
  //
  // hdr: _pack_hdr output (sr_sub_id at [31:0], engine at [63:32]).
  // cfg: _pack_cfg output (cache at [31:0], rate at [47:32], punct at
  //      [55:48], in_use=0).
  //
  // Low-first scan; the found row's in_use bit is stamped by ORing
  // 1<<56 into cfg on the claim path. utterance_seq starts at 0,
  // reserved starts at 0.
  //
  // Three callee-save pushes (rbx=idx, r12=hdr, r13=cfg) + sub rsp,8
  // = 32 B => entry rsp%16==8, +32 = %16==8 (no nested call in the
  // scan body, so this is the correct alignment for the ret).
  pub let screen_reader_tts_row_alloc : (u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (cfg: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-07 (paideia-os #2309): claim one TTS-client state row. Low-first scan (rbx=idx) over SRTC_MAX_STATES(1) rows of 32 bytes. Three callee-save pushes (rbx=idx, r12=hdr, r13=cfg) + sub rsp,8 = 32 B => entry rsp%16==8, +32 = %16==8 which suits the no-nested-call scan. Labels prefixed screen_reader_tts_ra_.",
      block: {
        push rbx;
        push r12;
        push r13;
        sub  rsp, 8;

        mov  r12, rdi;                       // hdr
        mov  r13, rsi;                       // cfg

        xor  rbx, rbx;
      screen_reader_tts_ra_scan:
        cmp  rbx, 1;
        jae  screen_reader_tts_ra_enospc;

        lea  r10, [rip + _screen_reader_tts_rows];
        mov  r11, rbx;
        shl  r11, 5;
        add  r10, r11;

        // Check in_use at cfg[63:56] (row+8, top byte).
        mov  rax, [r10 + 8];
        shr  rax, 56;
        cmp  rax, 0;
        je   screen_reader_tts_ra_claim;

        add  rbx, 1;
        jmp  screen_reader_tts_ra_scan;

      screen_reader_tts_ra_claim:
        // Write hdr (row+0) as-is.
        mov  [r10 + 0], r12;

        // Stamp in_use bit into cfg, write row+8.
        mov  rax, r13;
        mov  r11, 1;
        shl  r11, 56;
        or   rax, r11;
        mov  [r10 + 8], rax;

        // utterance_seq = 0, reserved = 0.
        xor  rax, rax;
        mov  [r10 + 16], rax;
        mov  [r10 + 24], rax;

        mov  rax, rbx;                       // row_id
        jmp  screen_reader_tts_ra_out;

      screen_reader_tts_ra_enospc:
        mov  rax, 0xFFFFECDE;                // SRTC_TAIL_ENOSPC

      screen_reader_tts_ra_out:
        add  rsp, 8;
        pop  r13;
        pop  r12;
        pop  rbx;
        ret
      }
    }

  // screen_reader_tts_row_free(row_id): scrub row (all 4 words).
  // Bounds-checked.
  pub let screen_reader_tts_row_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-07 (paideia-os #2309): scrub one TTS-client row (all 4 u64 words). Bounds-checked against SRTC_MAX_STATES(1). Labels prefixed screen_reader_tts_rf_.",
      block: {
        mov  r10, 1;
        cmp  rdi, r10;
        jae  screen_reader_tts_rf_out;
        lea  r10, [rip + _screen_reader_tts_rows];
        mov  r11, rdi;
        shl  r11, 5;
        add  r10, r11;
        xor  rax, rax;
        mov  [r10 + 0],  rax;
        mov  [r10 + 8],  rax;
        mov  [r10 + 16], rax;
        mov  [r10 + 24], rax;
      screen_reader_tts_rf_out:
        ret
      }
    }

  // ==========================================================================
  // SECTION G  tts_client_new
  //
  // tts_client_new(sr_sub_id, tts_engine_kind_id, phoneme_cache_kind_id)
  //     -> state_id
  //      | SRTC_BAD_SUB | SRTC_BAD_ENGINE | SRTC_BAD_CACHE
  //      | SRTC_TAIL_ENOSPC.
  //
  // Defaults: voice_rate = RATE_NORMAL(100), punctuation_mode =
  // PUNCT_MOST(1). A caller wanting a different rate or punct-mode
  // calls tts_client_set_rate / tts_client_set_punct after new.
  //
  // Five callee-save pushes (rbx=sub, r12=engine, r13=cache, r14=hdr,
  // r15=cfg) leave rsp%16==0 -- every nested `call` sees the aligned
  // slot every SysV callee needs. No further pad required.
  //
  // Refusal path funnels through screen_reader_tts_new_refused and
  // bumps SRTC_ST_REFUSED once.
  // ==========================================================================

  pub let tts_client_new : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (sr_sub_id: u64) (tts_engine_kind_id: u64) (phoneme_cache_kind_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-07 (paideia-os #2309): claim one TTS-client state row bound to (sr_sub, engine, cache) with defaults voice_rate=RATE_NORMAL(100) and punct_mode=PUNCT_MOST(1). Five callee-save pushes (rbx=sub, r12=engine, r13=cache, r14=hdr, r15=cfg) preserve SysV alignment: entry rsp%16==8, five 8-byte pushes give rsp%16==0 which every nested `call` needs at the callsite. Refusal funnel bumps SRTC_ST_REFUSED once. Labels prefixed screen_reader_tts_new_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov  rbx, rdi;                       // sr_sub_id
        mov  r12, rsi;                       // tts_engine_kind_id
        mov  r13, rdx;                       // phoneme_cache_kind_id

        // (1) sr_sub_id valid?
        mov  rdi, rbx;
        call screen_reader_tts_sub_valid;
        cmp  rax, 0;
        je   screen_reader_tts_new_bad_sub;

        // (2) tts_engine_kind_id valid?
        mov  rdi, r12;
        call screen_reader_tts_engine_valid;
        cmp  rax, 0;
        je   screen_reader_tts_new_bad_engine;

        // (3) phoneme_cache_kind_id valid?
        mov  rdi, r13;
        call screen_reader_tts_cache_valid;
        cmp  rax, 0;
        je   screen_reader_tts_new_bad_cache;

        // (4) pack hdr.
        mov  rdi, rbx;
        mov  rsi, r12;
        call screen_reader_tts_pack_hdr;
        mov  r14, rax;                       // hdr

        // (5) pack cfg with defaults (rate=100, punct=1).
        mov  rdi, r13;
        mov  rsi, 100;                       // RATE_NORMAL
        mov  rdx, 1;                         // PUNCT_MOST
        call screen_reader_tts_pack_cfg;
        mov  r15, rax;                       // cfg

        // (6) claim a row.
        mov  rdi, r14;
        mov  rsi, r15;
        call screen_reader_tts_row_alloc;

        // If _row_alloc returned SRTC_TAIL_ENOSPC (>= SRTC_MAX_STATES),
        // fail through the refusal funnel.
        mov  r10, 1;
        cmp  rax, r10;
        jae  screen_reader_tts_new_enospc;

        // Success: return row_id.
        jmp  screen_reader_tts_new_out;

      screen_reader_tts_new_bad_sub:
        mov  rax, 0xFFFFECDD;                // SRTC_BAD_SUB
        jmp  screen_reader_tts_new_refused;
      screen_reader_tts_new_bad_engine:
        mov  rax, 0xFFFFECDC;                // SRTC_BAD_ENGINE
        jmp  screen_reader_tts_new_refused;
      screen_reader_tts_new_bad_cache:
        mov  rax, 0xFFFFECDB;                // SRTC_BAD_CACHE
        jmp  screen_reader_tts_new_refused;
      screen_reader_tts_new_enospc:
        // rax already holds SRTC_TAIL_ENOSPC from _row_alloc.

      screen_reader_tts_new_refused:
        // Bump SRTC_ST_REFUSED, preserve sentinel across the note call.
        mov  rbx, rax;
        mov  rdi, 5;                         // SRTC_ST_REFUSED
        call screen_reader_tts_stats_bump;
        mov  rax, rbx;

      screen_reader_tts_new_out:
        pop  r15;
        pop  r14;
        pop  r13;
        pop  r12;
        pop  rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION H  tts_client_speak_text
  //
  // tts_client_speak_text(state_id, text_offset, text_len)
  //     -> utter_seq | SRTC_BAD_STATE | SRTC_BAD_TEXT.
  //
  // Bumps current_utterance_seq and returns the post-bump value.
  // AT THIS LANDING the engine send-path is NOT wired: the return
  // value is the seq the future engine-send landing will use as the
  // audit-record key.
  //
  // Four callee-save pushes (rbx=state_id, r12=text_offset,
  // r13=text_len, r14=row_base) leave rsp%16==8 -- every nested
  // call site is wrapped with sub rsp,8 / add rsp,8 to pad to %16==0.
  // ==========================================================================

  pub let tts_client_speak_text : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (state_id: u64) (text_offset: u64) (text_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-07 (paideia-os #2309): bump current_utterance_seq and return the post-bump value; the engine send-path is not wired at this landing (the seq is the audit-record key a future landing will attach the engine dispatch to). Four callee-save pushes (rbx=state_id, r12=text_offset, r13=text_len, r14=row_base) leave rsp%16==8; every nested call site gets a sub rsp,8 pad so the callee sees rsp%16==0. Labels prefixed screen_reader_tts_sp_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov  rbx, rdi;                       // state_id
        mov  r12, rsi;                       // text_offset (validated only for bounds; not dereferenced here)
        mov  r13, rdx;                       // text_len

        // (1) state row valid?
        sub  rsp, 8;
        mov  rdi, rbx;
        call screen_reader_tts_row_valid;
        add  rsp, 8;
        cmp  rax, 0;
        je   screen_reader_tts_sp_bad_state;

        // (2) text_len valid?
        sub  rsp, 8;
        mov  rdi, r13;
        call screen_reader_tts_text_valid;
        add  rsp, 8;
        cmp  rax, 0;
        je   screen_reader_tts_sp_bad_text;

        // (3) row_base.
        sub  rsp, 8;
        mov  rdi, rbx;
        call screen_reader_tts_row_base;
        add  rsp, 8;
        cmp  rax, 0;
        je   screen_reader_tts_sp_bad_state;
        mov  r14, rax;                       // row_base

        // (4) bump utterance_seq (load-inc-store on row+16, u64-wide).
        mov  rax, [r14 + 16];
        add  rax, 1;
        mov  [r14 + 16], rax;

        // (5) bump SRTC_ST_SPOKEN, preserve utter_seq across the call.
        mov  rbx, rax;                       // save seq
        sub  rsp, 8;
        mov  rdi, 0;                         // SRTC_ST_SPOKEN
        call screen_reader_tts_stats_bump;
        add  rsp, 8;
        mov  rax, rbx;                       // return seq

        // (Suppress-unused: text_offset r12 is validated by bounds only
        // at this landing; a future landing walks the caller's buffer
        // via a KIND_MEMORY reader over (text_offset, text_len).)
        jmp  screen_reader_tts_sp_out;

      screen_reader_tts_sp_bad_state:
        mov  rax, 0xFFFFECD8;                // SRTC_BAD_STATE
        jmp  screen_reader_tts_sp_out;
      screen_reader_tts_sp_bad_text:
        mov  rax, 0xFFFFECD7;                // SRTC_BAD_TEXT

      screen_reader_tts_sp_out:
        pop  r14;
        pop  r13;
        pop  r12;
        pop  rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION I  tts_client_cancel
  //
  // tts_client_cancel(state_id, utter_seq)
  //     -> SRTC_OK | SRTC_UTTER_STALE | SRTC_BAD_STATE.
  //
  // utter_seq == 0 cancels ALL in-flight utterances (a global stop).
  // utter_seq > 0 cancels only the matching utterance and returns
  // SRTC_UTTER_STALE if the current utterance_seq no longer matches
  // (i.e. the utterance completed or was superseded before cancel).
  //
  // Three callee-save pushes (rbx=state_id, r12=utter_seq,
  // r13=row_base) leave rsp%16==0 (three 8-byte pushes flip entry
  // %16==8 to %16==0), matching every nested `call`'s alignment
  // requirement. No further pad required.
  // ==========================================================================

  pub let tts_client_cancel : (u64, u64) -> u64 !{mem} @{} =
    fn (state_id: u64) (utter_seq: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-07 (paideia-os #2309): cancel one utterance (utter_seq > 0) or all (utter_seq == 0). Seq-match gate: utter_seq > 0 AND != current_utterance_seq -> SRTC_UTTER_STALE (the utterance completed/was superseded before cancel arrived; not strictly an error but distinguishable). Three callee-save pushes leave rsp%16==0 which every nested `call` needs. Engine-side cancel dispatch is not wired at this landing; the seq-match gate and stats bump land now so a caller can already observe the correct control flow. Labels prefixed screen_reader_tts_ca_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov  rbx, rdi;                       // state_id
        mov  r12, rsi;                       // utter_seq

        // (1) state row valid?
        mov  rdi, rbx;
        call screen_reader_tts_row_valid;
        cmp  rax, 0;
        je   screen_reader_tts_ca_bad_state;

        // (2) row_base.
        mov  rdi, rbx;
        call screen_reader_tts_row_base;
        cmp  rax, 0;
        je   screen_reader_tts_ca_bad_state;
        mov  r13, rax;                       // row_base

        // (3) seq-match gate.
        //     If utter_seq == 0 -> global cancel; skip the match check.
        cmp  r12, 0;
        je   screen_reader_tts_ca_ok;

        //     Otherwise: current == utter_seq ?
        mov  rax, [r13 + 16];                // current_utterance_seq
        cmp  rax, r12;
        jne  screen_reader_tts_ca_stale;

      screen_reader_tts_ca_ok:
        // Bump SRTC_ST_CANCELLED, return SRTC_OK.
        mov  rdi, 1;                         // SRTC_ST_CANCELLED
        call screen_reader_tts_stats_bump;
        xor  rax, rax;                       // SRTC_OK
        jmp  screen_reader_tts_ca_out;

      screen_reader_tts_ca_stale:
        mov  rax, 0xFFFFECD4;                // SRTC_UTTER_STALE
        jmp  screen_reader_tts_ca_out;
      screen_reader_tts_ca_bad_state:
        mov  rax, 0xFFFFECD8;                // SRTC_BAD_STATE

      screen_reader_tts_ca_out:
        pop  r13;
        pop  r12;
        pop  rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION J  tts_client_on_a11y_event
  //
  // tts_client_on_a11y_event(state_id, event_kind, node_id)
  //     -> SRTC_OK | SRTC_BAD_STATE | SRTC_BAD_EVENT.
  //
  // Dispatches on ScreenReaderEvent (see file header §5 catalogue).
  //
  // FOCUS_CHANGED / TREE_UPDATED bump the a11y-events counter (the
  // actual speak call routes through a future KIND_A11Y_TREE walk
  // that is not landed at this fidelity); NODE_DESTROYED and
  // TREE_DESTROYED are silent by UX design (see §5). node_id is
  // preserved as a stats-bump argument the future landing will
  // pass into the label lookup.
  //
  // Three callee-save pushes (rbx=state_id, r12=event_kind,
  // r13=node_id) leave rsp%16==0 -- every nested `call` sees the
  // aligned slot every SysV callee needs.
  // ==========================================================================

  pub let tts_client_on_a11y_event : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (state_id: u64) (event_kind: u64) (node_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-07 (paideia-os #2309): dispatch on ScreenReaderEvent. FOCUS_CHANGED(1) and TREE_UPDATED(0) bump SRTC_ST_A11Y_EVENTS (the actual speak call routes through a KIND_A11Y_TREE walk that is not landed at this fidelity); NODE_DESTROYED(2) and TREE_DESTROYED(3) are silent by UX design (see file header §5). event_kind > SRTC_EV_MAX(3) refuses with SRTC_BAD_EVENT (mirrors screen_reader_protocol_event_valid's gate; a divergence would let a valid pushed event fail here). node_id is preserved in r13 as the stats-bump argument the future landing will pass into the label lookup. Three callee-save pushes leave rsp%16==0. Labels prefixed screen_reader_tts_ev_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov  rbx, rdi;                       // state_id
        mov  r12, rsi;                       // event_kind
        mov  r13, rdx;                       // node_id

        // (1) state row valid?
        mov  rdi, rbx;
        call screen_reader_tts_row_valid;
        cmp  rax, 0;
        je   screen_reader_tts_ev_bad_state;

        // (2) event_kind valid?
        mov  rdi, r12;
        call screen_reader_tts_event_valid;
        cmp  rax, 0;
        je   screen_reader_tts_ev_bad_event;

        // (3) Dispatch.
        //     0 (SRTC_EV_TREE_UPDATED) / 1 (SRTC_EV_FOCUS_CHANGED)
        //     bump the events counter; 2 / 3 are silent.
        mov  r10, 1;
        cmp  r12, r10;                       // ev <= 1 ?
        ja   screen_reader_tts_ev_silent;

        mov  rdi, 2;                         // SRTC_ST_A11Y_EVENTS
        call screen_reader_tts_stats_bump;

      screen_reader_tts_ev_silent:
        xor  rax, rax;                       // SRTC_OK
        jmp  screen_reader_tts_ev_out;

      screen_reader_tts_ev_bad_state:
        mov  rax, 0xFFFFECD8;                // SRTC_BAD_STATE
        jmp  screen_reader_tts_ev_out;
      screen_reader_tts_ev_bad_event:
        mov  rax, 0xFFFFECD5;                // SRTC_BAD_EVENT

      screen_reader_tts_ev_out:
        pop  r13;
        pop  r12;
        pop  rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION K  tts_client_lookup_phonemes
  //
  // tts_client_lookup_phonemes(state_id, word_offset, word_len)
  //     -> phoneme_offset | 0.
  //
  // Zero return means "not in cache". AT THIS LANDING the cache
  // walker is not landed (see file header §0 future-promotion path
  // (b)); this function returns 0 (miss) unconditionally after
  // validating state_id and word_len. Every call bumps
  // SRTC_ST_PHONEME_MISSES so the future walker landing can
  // observe hit/miss ratio in production traces from day one.
  //
  // Three callee-save pushes (rbx=state_id, r12=word_offset,
  // r13=word_len) leave rsp%16==0 -- every nested `call` sees the
  // aligned slot every SysV callee needs.
  // ==========================================================================

  pub let tts_client_lookup_phonemes : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (state_id: u64) (word_offset: u64) (word_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-07 (paideia-os #2309): validate state_id and word_len; return 0 (cache miss = SRTC_PHONEME_MISS, aliased with SRTC_OK by design). The cache walker is not landed at this fidelity (see file header §0 future-promotion path (b)); every call bumps SRTC_ST_PHONEME_MISSES so the future walker landing can observe hit/miss ratio in production traces from day one. Three callee-save pushes leave rsp%16==0. Labels prefixed screen_reader_tts_lp_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov  rbx, rdi;                       // state_id
        mov  r12, rsi;                       // word_offset (unused at this landing; preserved for the future walker)
        mov  r13, rdx;                       // word_len

        // (1) state row valid?
        mov  rdi, rbx;
        call screen_reader_tts_row_valid;
        cmp  rax, 0;
        je   screen_reader_tts_lp_miss;

        // (2) word_len valid?
        mov  rdi, r13;
        call screen_reader_tts_word_valid;
        cmp  rax, 0;
        je   screen_reader_tts_lp_miss;

        // (3) At this fidelity: always miss. Bump miss counter.
        mov  rdi, 4;                         // SRTC_ST_PHONEME_MISSES
        call screen_reader_tts_stats_bump;

      screen_reader_tts_lp_miss:
        xor  rax, rax;                       // SRTC_PHONEME_MISS
        pop  r13;
        pop  r12;
        pop  rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION L  Setters (rate / punct).
  // ==========================================================================

  pub let tts_client_set_rate : (u64, u64) -> u64 !{mem} @{} =
    fn (state_id: u64) (rate: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-07 (paideia-os #2309): update voice_rate at cfg[47:32]. Validates state_id and rate in (0, SRTC_RATE_MAX(300)]. Read-modify-write on the cfg word (row+8) preserves cache[31:0], punct[55:48], in_use[63:56]. Three callee-save pushes leave rsp%16==0. Labels prefixed screen_reader_tts_sr_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov  rbx, rdi;                       // state_id
        mov  r12, rsi;                       // rate

        // (1) state row valid?
        mov  rdi, rbx;
        call screen_reader_tts_row_valid;
        cmp  rax, 0;
        je   screen_reader_tts_sr_bad_state;

        // (2) rate valid?
        mov  rdi, r12;
        call screen_reader_tts_rate_valid;
        cmp  rax, 0;
        je   screen_reader_tts_sr_bad_rate;

        // (3) row_base.
        mov  rdi, rbx;
        call screen_reader_tts_row_base;
        cmp  rax, 0;
        je   screen_reader_tts_sr_bad_state;
        mov  r13, rax;                       // row_base

        // (4) RMW cfg word: clear [47:32], OR in (rate & 0xFFFF) << 32.
        //     mask = ~(0xFFFF << 32) = 0xFFFF0000FFFFFFFF.
        mov  rax, [r13 + 8];
        mov  r10, 0xFFFF0000FFFFFFFF;
        and  rax, r10;
        mov  r10, r12;
        and  r10, 0xFFFF;
        shl  r10, 32;
        or   rax, r10;
        mov  [r13 + 8], rax;

        xor  rax, rax;                       // SRTC_OK
        jmp  screen_reader_tts_sr_out;

      screen_reader_tts_sr_bad_state:
        mov  rax, 0xFFFFECD8;                // SRTC_BAD_STATE
        jmp  screen_reader_tts_sr_out;
      screen_reader_tts_sr_bad_rate:
        mov  rax, 0xFFFFECDA;                // SRTC_BAD_RATE

      screen_reader_tts_sr_out:
        pop  r13;
        pop  r12;
        pop  rbx;
        ret
      }
    }

  pub let tts_client_set_punct : (u64, u64) -> u64 !{mem} @{} =
    fn (state_id: u64) (mode: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-07 (paideia-os #2309): update punctuation_mode at cfg[55:48]. Validates state_id and mode in [0, SRTC_PUNCT_MAX(2)]. Read-modify-write on the cfg word (row+8) preserves cache[31:0], rate[47:32], in_use[63:56]. Three callee-save pushes leave rsp%16==0. Labels prefixed screen_reader_tts_sm_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov  rbx, rdi;                       // state_id
        mov  r12, rsi;                       // mode

        // (1) state row valid?
        mov  rdi, rbx;
        call screen_reader_tts_row_valid;
        cmp  rax, 0;
        je   screen_reader_tts_sm_bad_state;

        // (2) mode valid?
        mov  rdi, r12;
        call screen_reader_tts_punct_valid;
        cmp  rax, 0;
        je   screen_reader_tts_sm_bad_punct;

        // (3) row_base.
        mov  rdi, rbx;
        call screen_reader_tts_row_base;
        cmp  rax, 0;
        je   screen_reader_tts_sm_bad_state;
        mov  r13, rax;                       // row_base

        // (4) RMW cfg word: clear [55:48], OR in (mode & 0xFF) << 48.
        //     mask = ~(0xFF << 48) = 0xFF00FFFFFFFFFFFF.
        mov  rax, [r13 + 8];
        mov  r10, 0xFF00FFFFFFFFFFFF;
        and  rax, r10;
        mov  r10, r12;
        and  r10, 0xFF;
        shl  r10, 48;
        or   rax, r10;
        mov  [r13 + 8], rax;

        xor  rax, rax;                       // SRTC_OK
        jmp  screen_reader_tts_sm_out;

      screen_reader_tts_sm_bad_state:
        mov  rax, 0xFFFFECD8;                // SRTC_BAD_STATE
        jmp  screen_reader_tts_sm_out;
      screen_reader_tts_sm_bad_punct:
        mov  rax, 0xFFFFECD9;                // SRTC_BAD_PUNCT

      screen_reader_tts_sm_out:
        pop  r13;
        pop  r12;
        pop  rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION M  tts_client_free  (LINEAR consume)
  //
  // tts_client_free(state_id) -> SRTC_OK | SRTC_BAD_STATE.
  //
  // LINEAR consume: the caller MUST NOT reuse state_id after this
  // call.  A second free on the same id returns SRTC_BAD_STATE
  // (the row is no longer in_use, so _row_valid returns 0).
  //
  // One callee-save push (rbx=state_id): entry rsp%16==8, one 8-byte
  // push gives rsp%16==0 -- the value every nested `call` needs at
  // the callsite. No further pad required.
  // ==========================================================================

  pub let tts_client_free : (u64) -> u64 !{mem} @{} =
    fn (state_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-07 (paideia-os #2309): LINEAR-consume one TTS-client state row. state_id >= SRTC_MAX_STATES(1) OR row not in_use -> SRTC_BAD_STATE; else free + return SRTC_OK. One callee-save push leaves rsp%16==0 which matches SysV call alignment; no further pad needed. Labels prefixed screen_reader_tts_fr_.",
      block: {
        push rbx;
        mov  rbx, rdi;                       // state_id

        // OOB or already-freed row?
        mov  rdi, rbx;
        call screen_reader_tts_row_valid;
        cmp  rax, 0;
        je   screen_reader_tts_fr_bad_state;

        // Free the row.
        mov  rdi, rbx;
        call screen_reader_tts_row_free;

        xor  rax, rax;                       // SRTC_OK
        jmp  screen_reader_tts_fr_out;

      screen_reader_tts_fr_bad_state:
        mov  rax, 0xFFFFECD8;                // SRTC_BAD_STATE

      screen_reader_tts_fr_out:
        pop  rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION N  Stats + init.
  // ==========================================================================

  pub let screen_reader_tts_stats_bump : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-07 (paideia-os #2309): bounds-checked counter bump against SRTC_ST_REFUSED+1=6. Load-inc-store idiom (no `add reg, [mem]`). Labels prefixed screen_reader_tts_sb_.",
      block: {
        cmp rdi, 6;
        jae screen_reader_tts_sb_out;
        lea r10, [rip + _screen_reader_tts_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      screen_reader_tts_sb_out:
        ret
      }
    }

  pub let screen_reader_tts_stats_read : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-07 (paideia-os #2309): bounds-checked counter read; OOB -> 0. Labels prefixed screen_reader_tts_st_.",
      block: {
        cmp rdi, 6;
        jae screen_reader_tts_st_zero;
        lea r10, [rip + _screen_reader_tts_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      screen_reader_tts_st_zero:
        xor rax, rax;
        ret
      }
    }

  // screen_reader_tts_init(): zero row pool + stats. Defensive
  // re-scrub; .bss is already zero at real boot. Mirrors
  // screen_reader_protocol_init's shape.
  pub let screen_reader_tts_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-07 (paideia-os #2309): zero _screen_reader_tts_rows (4 u64) + _screen_reader_tts_stats (6 u64). Defensive; .bss is already zero at real boot. Labels prefixed screen_reader_tts_ini_.",
      block: {
        lea r10, [rip + _screen_reader_tts_rows];
        xor rax, rax;
        xor rcx, rcx;
      screen_reader_tts_ini_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  screen_reader_tts_ini_rows;

        lea r10, [rip + _screen_reader_tts_stats];
        xor rcx, rcx;
      screen_reader_tts_ini_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 6;
        jb  screen_reader_tts_ini_stats;
        ret
      }
    }
}
