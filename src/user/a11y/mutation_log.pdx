// src/user/a11y/mutation_log.pdx -- Wave0-B14 G10-M2-001 (paideia-os #2304)
//
// KIND_A11Y_MUTATION_LOG = 0x1E4, derived over KIND_A11Y_TREE (0x1D3,
// tree_kind.pdx, Wave0-B8 G10-M1-001 #2302). LINEAR cap: a per-frame
// ordered log of a11y-subtree mutations that buffers writer-side edits
// (node_add / node_remove / node_state_change / node_value_change /
// node_reparent) and exposes them to a reader (the compositor's a11y
// dispatch, and downstream assistive-tech clients through it) only as
// an atomically-committed, whole-frame batch.
//
// TRACKER NOTE. paideia-os issue #2304's own body/title ("A11y tree
// mutation log with linear commit boundary", slug G10-M1-003, files-
// touched src/user/a11y/tree_mutation.pdx) predates this dispatch's
// Wave-0 batch numbering, which assigns this row G10-M2-001 / Wave0-
// B14 and this filename (mutation_log.pdx). Both name the same design
// (a11y mutation log, linear commit boundary); this landing follows
// the live dispatch's filename and slug, since the Wave-0 fan-out
// dispatch is the authoritative batch plan for this round. #2304 is
// cited throughout as the tracking issue regardless of which slug wins
// at batch close.
//
// NOVEL-CLEAN DESIGN RATIONALE (over the ARIA live-region precedent).
//
// ARIA's live-region model fires DOM mutation events eagerly, one at a
// time, as soon as the underlying tree changes. A screen reader
// observing a live region races the renderer: it can walk a subtree
// mid-edit (a node removed but its parent's child-list not yet
// updated, a value changed but the surrounding state bits not yet
// committed) and read a torn, transiently-inconsistent snapshot. This
// is a well-known AT-interop pain point -- eager per-mutation delivery
// has no notion of "this frame's edits are done."
//
// This design instead treats one frame's worth of a11y-subtree edits
// as a single write-then-commit unit, mirroring the compositor's own
// double-buffered present discipline (KIND_SURFACE_COMMIT,
// src/user/compositor/surface_commit.pdx) rather than the DOM-events
// discipline: mutation_log_append(...) buffers edits into a private
// ring (invisible to any reader) through the frame; mutation_log_
// commit(...) is the single atomic-batch boundary that publishes the
// whole buffered set at once, stamped with a fresh monotonic epoch;
// mutation_log_consume(...) is the reader's one-shot drain of exactly
// that committed batch, gated on the reader presenting the epoch it
// expects (MLOG_EPOCH_STALE otherwise) so a consumer can never read a
// mixture of two frames' edits. Assistive tech gets a coherent
// per-frame snapshot, never a race with rendering.
//
// SLOT ALLOCATION.
//
// The band 0x1B8..0x1DE (compositor + input-server + a11y + IME
// derived-kind row, Wave-0 Batches 1/6/7/8/9/10/11) is densely claimed
// by the time this landing runs. Per the dispatch's own fallback
// instruction, this file opens the second band (0x1E0..0x1FF) instead
// of hunting for a gap in the first. A grep re-run partway through
// this landing (`grep -rhoE ": u64 = 0x1[E-F][0-9A-Fa-f]\b"
// --include=*.pdx src/`) found the second band had filled in further
// than expected while this file was being written: 0x1E0 (KIND_TTS_
// ENGINE, screen_reader_tts.pdx) and 0x1E1 (KIND_BRAILLE_DEVICE,
// screen_reader_braille.pdx) were already-known claims, but two
// sibling Wave0-B14 landings had ALSO independently raced onto 0x1E2
// -- src/user/a11y/kind_a11y_node.pdx (KIND_A11Y_NODE, paideia-os
// #2303) and src/user/a11y/elaboration_gate.pdx (KIND_A11Y_
// ELABORATION_GATE, paideia-os #2307) both landed with `: u64 = 0x1E2`
// concurrently, neither able to see the other's still-unwritten file
// at the moment each ran its own "next free slot" grep. That specific
// collision is between those two files, not this one, and is left for
// main to reconcile at batch close (do not fix it here -- out of this
// file's touch scope). elaboration_gate.pdx's own ORDINAL CHOICE
// section additionally left an ADVISORY forward-reservation of 0x1E4
// for "B14-07, mutation_log.pdx" (this file, by name) -- verified
// still genuinely free of any competing `: u64 =` claim by the same
// grep. This file honors that reservation and claims 0x1E4.
//
// PARENT DERIVATION. KIND_A11Y_TREE (tree_kind.pdx) stores its rows in
// a private `_a11y_tree_rows` array, NOT in `cap_table` -- it is (per
// its own file header) a data-only decl with no kernel dispatcher
// wired yet, exactly like this file. The parent-row argument this file
// takes (`tree_row_id`) is therefore a row index into that private
// array, validated by calling TreeKind's own exported validator
// (`a11y_tree_row_valid`, tree_kind.pdx line 823) by bare symbol name
// -- this codebase's cross-module call convention has no `use`/
// `import` keyword; a `pub let` function is a global link-time symbol
// any other .pdx file may `call` directly (kind_tui_canvas.pdx calling
// kind_tty.pdx's `tty_tail_valid` is the precedent this mirrors).
//
// LINEARITY DISCIPLINE (mirrors surface_commit.pdx's LINEAR-cap shape,
// re-cast around a commit/consume pair rather than a single flush).
//
//   * ONE buffered batch in flight per row at a time. mutation_log_
//     commit refuses a second commit against a row whose previous
//     committed batch has not yet been drained (MLOG_ALREADY_
//     COMMITTED) -- the row is not a queue of frames, it is a single
//     write-buffer/read-buffer pair the writer and the one reader
//     trade custody of every frame.
//   * mutation_log_consume is the one-shot drain: it requires the
//     caller's `expected_epoch` to equal the row's actually-committed
//     epoch (MLOG_EPOCH_STALE otherwise -- the caller's idea of "the
//     current frame" is wrong), and it clears the committed bit +
//     resets the write cursor on success, handing the row back to the
//     writer for the next frame's accumulation. A consume attempted
//     before any commit has ever happened is NOT an error -- it
//     returns 0 (benign "nothing new yet"), since there is no epoch to
//     be stale against.
//   * mutation_log_append is refused outright once a row overflows its
//     256-entry ring for the CURRENT (uncommitted) frame (MLOG_FULL).
//     There is no wraparound within a frame -- a writer that produces
//     more than 256 edits between commits must force an early commit
//     rather than silently drop or overwrite earlier edits in the same
//     batch (either would itself reintroduce the torn-read problem
//     this design exists to avoid).
//
// ROW POOL. MLOG_MAX = 4, matching KIND_A11Y_TREE's own A11Y_MAX(4)
// row pool 1:1 -- at most one mutation log per live accessibility tree.
// No revoke/free path exists in this landing (out of scope per the
// dispatch's deliverable list); a row is claimed once by mutation_log_
// mint and lives for the life of the boot image, matching kind_tui_
// canvas.pdx's posture before its own future revoke-adjacent milestone.
//
// MLOG_NODE_NOT_FOUND FORMALITY NOTE (mirrors kind_tui_canvas.pdx's
// documented deviation (3)). tree_kind.pdx's node arena is a private,
// generational-index-shaped structure with no exported "does node N
// exist" query this file can call without duplicating that arena's
// internal layout. mlog_node_id_valid is therefore a ceiling check --
// `node_id < A11Y_INDEX_NONE (0xFFFFFFFF)` -- not a real membership
// test, the same "formality ceiling, not a backing-store cross-check"
// posture kind_tui_canvas.pdx's tui_size_valid documents. A genuine
// lookup needs tree_kind.pdx to export a node-existence primitive,
// out of this single file's scope.
//
// OPCODE ENUM WIDTH NOTE. The issue's schema names the entry opcode a
// u16 field. Every enumerated-value constant in this codebase's
// KIND_*.pdx family (ROLE_*/STATE_*, TUI_OP_*, SURFACE_COMMIT_
// TRANSFORM_*, ...) is declared `pub let NAME : u64 = N` regardless of
// the field's documented bit-width in its packed row; there is no
// precedent anywhere in src/**/*.pdx for a `u16`-typed `pub let`
// constant. MLOG_OP_* follows that same convention: the row layout
// documents the opcode slot as logically 16-bit (values 0..4), the
// constants stay u64.
//
// ENCODER DISCIPLINE. No `test rN,rN` (uses `cmp rN,0`); no `and rN,
// imm64` (every AND immediate here is a small imm8: 1); no 2-op `imul
// r,imm` (every multiply is a power-of-two `shl`: *64=shl 6, *8192=
// shl 13, *32=shl 5, *8=shl 3); no `neg`/`cqo`/`idiv`; no `add reg,
// [mem]` (load, add-immediate, store-back throughout); every unsafe
// lambda takes at most 5 arguments; every `call` site sits at a
// push-count parity landing rsp%16==0 (each function's justification
// states the count). The consume-path committed-bit reset uses
// subtraction of a known-set bit rather than `and`-with-complement,
// sidestepping the `and rN, imm64` restriction for that operation.
//
// LABEL PREFIX: `mlog_` throughout plus a per-function tag suffix
// (mlog_mint_, mlog_append_, mlog_commit_, mlog_consume_, mlog_ta_,
// mlog_rv_, mlog_ov_, mlog_nv_, mlog_init_), sidestepping the
// paideia-as reserved-keyword set (`loop`, `if`, `for`, `match`, ...).
//
// FINGERPRINT. One legacy-suffixed mint fingerprint, matching the
// kind_tui_canvas / surface_commit / tree_kind precedent: emitted once
// on successful mint only, never on append/commit/consume. tools/
// verify-fingerprint-coverage.sh gets a matching allowlist entry
// (Wave0-B14 posture: data-only decl, dispatcher not yet wired).
//
// MECE SCOPE. Single file under src/user/a11y/. Touches no other
// file. Cross-module reference: TreeKind.a11y_tree_row_valid (bare
// symbol call, read-only). No cap_table / cap_invoke_dispatch wiring
// -- schema + row-pool + real (non-stubbed) append/commit/consume/
// mint bodies over this file's own private pool, the same posture
// window_kind.pdx and tree_kind.pdx (its own parent kind) document
// for their own dispatcherless landings.

module MutationLog = structure {

  // ==========================================================================
  // SECTION 1 -- KIND ORDINAL + PARENT + RIGHTS
  // ==========================================================================

  pub let KIND_A11Y_MUTATION_LOG      : u64 = 0x1E4
  pub let KIND_A11Y_MUTATION_LOG_BASE : u64 = 0x1D3   // = KIND_A11Y_TREE (tree_kind.pdx)

  // Rights. No R_MINT bit is client-visible in the eventual dispatcher
  // shape -- mint is driven by whatever authority owns the bound
  // KIND_A11Y_TREE row (the compositor's a11y substrate), mirroring
  // surface_commit.pdx's "no R_MINT bit" LINEAR-cap posture. Declared
  // here as inert data (no dispatcher consumes these bits yet) purely
  // for cross-module conformance with every sibling KIND_* module.
  pub let R_MLOG_APPEND   : u64 = 0x001
  pub let R_MLOG_COMMIT   : u64 = 0x002
  pub let R_MLOG_CONSUME  : u64 = 0x004
  pub let R_MLOG_OBSERVE  : u64 = 0x008
  pub let R_MLOG_MINT     : u64 = 0x200   // compositor-internal; never handed to a client.
  pub let R_MLOG_ALL      : u64 = 0x20F

  // ==========================================================================
  // SECTION 2 -- MUTATION OPCODE ENUM (5-way, u16 field width -- see
  //              file header "OPCODE ENUM WIDTH NOTE")
  // ==========================================================================
  //
  // One opcode per AccessKit-shape a11y-subtree edit kind this log can
  // buffer. node_reparent (bit 4) is the only structural edit that
  // changes an edge rather than a node's own fields -- its payload_lo/
  // payload_hi (below) carry (old_parent, new_parent) rather than
  // (old_value, new_value) or a state bitmap delta.

  pub let MLOG_OP_NODE_ADD           : u64 = 0
  pub let MLOG_OP_NODE_REMOVE        : u64 = 1
  pub let MLOG_OP_NODE_STATE_CHANGE  : u64 = 2
  pub let MLOG_OP_NODE_VALUE_CHANGE  : u64 = 3
  pub let MLOG_OP_NODE_REPARENT      : u64 = 4
  pub let MLOG_OP_MAX                : u64 = 4

  // ==========================================================================
  // SECTION 3 -- RING-BUFFER ENTRY SCHEMA (32 bytes, fixed 256 per log)
  // ==========================================================================
  //
  // One entry per buffered mutation. All four fields are stored as
  // full qwords (no sub-word packing) so every append/consume access
  // is a plain 8-byte load/store -- the opcode field's true width is
  // u16 (0..4 fits in the low 3 bits of that qword; the remaining 61
  // bits stay 0, exactly like every other "logically narrow, stored
  // as a full qword" field in this codebase, e.g. kind_tui_canvas.pdx's
  // header word or surface_commit.pdx's commit_id).
  //
  //   [+0]  opcode      MLOG_OP_* (0..4); low bits meaningful, rest 0.
  //   [+8]  node_id     u32-range a11y node id the edit targets
  //                     (KIND_A11Y_TREE arena node index).
  //   [+16] payload_lo  edit-kind-specific: new state bitmap / new
  //                     value-blob offset / old_parent node_id.
  //   [+24] payload_hi  edit-kind-specific: old state bitmap / old
  //                     value-blob offset / new_parent node_id.
  //                     Unused halves stay 0 (e.g. node_add has no
  //                     "old" half, node_remove has no "new" half).

  pub let MLOG_ENTRY_BYTES         : u64 = 32
  pub let MLOG_ENTRY_OFF_OPCODE     : u64 = 0
  pub let MLOG_ENTRY_OFF_NODE_ID    : u64 = 8
  pub let MLOG_ENTRY_OFF_PAYLOAD_LO : u64 = 16
  pub let MLOG_ENTRY_OFF_PAYLOAD_HI : u64 = 24

  pub let MLOG_RING_CAP   : u64 = 256                 // entries per log.
  pub let MLOG_RING_BYTES : u64 = 8192                // 256 * 32.

  // ==========================================================================
  // SECTION 4 -- PER-LOG ROW LAYOUT (64 bytes, one cache line)
  // ==========================================================================
  //
  //   [+0]  header:
  //             in_use[63:56]     1 iff row is allocated (mint_body).
  //             committed[55:55]  1 iff a commit()'d batch is waiting
  //                               to be drained by consume().
  //             reserved[54:0]    0 at mint; future flags land here.
  //
  //   [+8]  tree_row_id      u64, KIND_A11Y_TREE row index (tree_kind.
  //                          pdx's private `_a11y_tree_rows` array)
  //                          this log is bound to; never rebound.
  //
  //   [+16] write_cursor     u64, next free ring-buffer slot for THIS
  //                          frame's accumulation, 0..MLOG_RING_CAP.
  //                          Reset to 0 by consume() on success.
  //
  //   [+24] commit_epoch     u64, the monotonic epoch stamped by the
  //                          last successful commit(); 0 = never
  //                          committed. Sourced from the single
  //                          kernel-wide `_mlog_next_epoch` clock
  //                          (pre-incremented, first value 1 -- never
  //                          0, matching this codebase's universal
  //                          "id counters never return the zero
  //                          sentinel" convention).
  //
  //   [+32] committed_count  u64, # of entries visible in the most
  //                          recent committed snapshot (== write_
  //                          cursor's value at commit time). Stays at
  //                          its last value after a successful
  //                          consume (historical/observability only --
  //                          the committed bit, not this field, is
  //                          the "is there anything new" gate).
  //
  //   [+40..56] reserved     0; future growth.

  pub let MLOG_ROW_BYTES : u64 = 64
  pub let MLOG_MAX        : u64 = 4     // 1:1 with TreeKind.A11Y_MAX.

  pub let MLOG_OFF_HEADER          : u64 = 0
  pub let MLOG_OFF_TREE_ROW_ID      : u64 = 8
  pub let MLOG_OFF_WRITE_CURSOR     : u64 = 16
  pub let MLOG_OFF_COMMIT_EPOCH     : u64 = 24
  pub let MLOG_OFF_COMMITTED_COUNT  : u64 = 32

  pub let MLOG_HDR_IN_USE_BIT   : u64 = 56
  pub let MLOG_HDR_COMMITTED_BIT : u64 = 55

  // ==========================================================================
  // SECTION 5 -- DISPATCH OP CATALOG (data-only; no cap_invoke_dispatch
  //              wiring in this landing -- see file header MECE SCOPE)
  // ==========================================================================

  pub let MLOG_DOP_APPEND       : u64 = 0
  pub let MLOG_DOP_COMMIT       : u64 = 1
  pub let MLOG_DOP_CONSUME      : u64 = 2
  pub let MLOG_DOP_QUERY_EPOCH  : u64 = 3
  pub let MLOG_DOP_DEBUG_PRINT  : u64 = 4
  pub let MLOG_DOP_MAX          : u64 = 4

  // ==========================================================================
  // SECTION 6 -- FAILURE TAXONOMY -- 0xFFFFE860..0xFFFFE87F
  // ==========================================================================
  //
  // Pre-assigned band (dispatch manifest, Wave0-B14). Verified free by
  // `grep -rn "0xFFFFE86[0-9A-Fa-f]\|0xFFFFE87[0-9A-Fa-f]"` over
  // src/**/*.pdx and tests/**/*.pdx as of this landing: zero hits.
  // Eight named codes per the dispatch's reservation list, descending
  // from the top of the band per this codebase's universal convention
  // (TAIL_ENOSPC / MINT_BAD_* / etc. always occupy the high end).

  pub let MLOG_OK                  : u64 = 0
  pub let MLOG_REFUSED_DENSE       : u64 = 0xFFFFE87F   // mint: row pool fully allocated.
  pub let MLOG_NULL                : u64 = 0xFFFFE87E   // mint: tree_row_id fails a11y_tree_row_valid.
  pub let MLOG_NOT_INIT             : u64 = 0xFFFFE87D  // append/commit/consume: row not minted.
  pub let MLOG_OPCODE_INVALID      : u64 = 0xFFFFE87C   // append: opcode > MLOG_OP_MAX.
  pub let MLOG_NODE_NOT_FOUND      : u64 = 0xFFFFE87B   // append: node_id fails ceiling check.
  pub let MLOG_FULL                : u64 = 0xFFFFE87A   // append: write_cursor >= MLOG_RING_CAP.
  pub let MLOG_EPOCH_STALE         : u64 = 0xFFFFE879   // consume: expected_epoch != commit_epoch.
  pub let MLOG_ALREADY_COMMITTED   : u64 = 0xFFFFE878   // commit: previous batch not yet consumed.
  pub let MLOG_DECODE_BAD          : u64 = 0xFFFFFFFFFFFFFFFF

  // ==========================================================================
  // SECTION 7 -- STATS COUNTER SLOTS
  // ==========================================================================
  //
  // _mlog_stats [u64; 8], one cache line. Only ST_REFUSED is bumped
  // from mint's shared refusal funnel (MLOG_NULL or MLOG_REFUSED_
  // DENSE) -- append/commit/consume failures do NOT bump it, mirroring
  // kind_tty.pdx / kind_tui_canvas.pdx's narrow "refused" convention
  // (revoke-adjacent failures never count toward it either).

  pub let MLOG_ST_MINTS    : u64 = 0
  pub let MLOG_ST_APPENDS  : u64 = 1
  pub let MLOG_ST_COMMITS  : u64 = 2
  pub let MLOG_ST_CONSUMES : u64 = 3
  pub let MLOG_ST_REFUSED  : u64 = 4
  pub let MLOG_ST_MAX      : u64 = 8

  // ==========================================================================
  // SECTION 8 -- FINGERPRINT (one line, legacy-suffixed)
  // ==========================================================================

  pub let pdx_kind_a11y_mutation_log_meta : [u8; 62] = "a11y mutation log init ok [legacy: A11Y MUTATION LOG INIT OK]\0"

  // Short field-name string for the mint-success klog_s1_x1 call
  // (mirrors tui_k_canvas_id / surface_commit_k_commit_id precedent).
  pub let mlog_k_row_id : [u8; 7] = "row_id\0"

  // ==========================================================================
  // SECTION 9 -- STATE CELLS
  // ==========================================================================

  pub let mut _mlog_row_pool   : [u8; 256]   = uninit @align(8)    // MLOG_MAX * MLOG_ROW_BYTES.
  pub let mut _mlog_ring_pool  : [u8; 32768] = uninit @align(8)    // MLOG_MAX * MLOG_RING_BYTES.
  pub let mut _mlog_next_epoch : u64         = uninit @align(8)    // kernel-wide present/commit clock.
  pub let mut _mlog_stats      : [u64; 8]    = uninit @align(64)

  // ==========================================================================
  // SECTION 10 -- VALIDATORS (pure leaves, no nested calls)
  // ==========================================================================

  // mlog_opcode_valid(op) -> 1 iff op in [0, MLOG_OP_MAX=4].
  pub let mlog_opcode_valid : (u64) -> u64 !{} @{} =
    fn (op: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B14 G10-M2-001 (paideia-os #2304): 1 iff op in [0, MLOG_OP_MAX=4] (NODE_ADD..NODE_REPARENT). Small immediate. Labels prefixed mlog_ov_.",
      block: {
        cmp rdi, 4;
        ja  mlog_ov_no;
        mov rax, 1;
        ret;
      mlog_ov_no:
        xor rax, rax;
        ret
      }
    }

  // mlog_node_id_valid(node_id) -> 1 iff node_id < 0xFFFFFFFF
  // (A11Y_INDEX_NONE, tree_kind.pdx's "no such node" sentinel). Ceiling
  // check, not a real membership test -- see file header "MLOG_NODE_
  // NOT_FOUND FORMALITY NOTE".
  pub let mlog_node_id_valid : (u64) -> u64 !{} @{} =
    fn (node_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B14 G10-M2-001 (paideia-os #2304): 1 iff node_id < 0xFFFFFFFF (rejects tree_kind.pdx's A11Y_INDEX_NONE sentinel and anything above u32 range). Formality ceiling -- see file header note; a real cross-check needs a tree_kind.pdx node-existence export. Labels prefixed mlog_nv_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        jae mlog_nv_no;
        mov rax, 1;
        ret;
      mlog_nv_no:
        xor rax, rax;
        ret
      }
    }

  // mlog_row_valid(idx) -> 1 iff idx < MLOG_MAX(4) and the row's
  // in_use bit is set. Inlined address compute (idx*64 via shl 6), no
  // nested call -- mirrors kind_tui_canvas.pdx tui_canvas_row_valid /
  // kind_tty.pdx tty_tail_valid exactly.
  pub let mlog_row_valid : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B14 G10-M2-001 (paideia-os #2304): 1 iff idx < MLOG_MAX(4) and in_use bit (bit 56) set. Inlined address compute, no nested call -- mirrors kind_tui_canvas.pdx tui_canvas_row_valid. Labels prefixed mlog_rv_.",
      block: {
        mov r10, 4;
        cmp rdi, r10;
        jae mlog_rv_no;
        lea r10, [rip + _mlog_row_pool];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  mlog_rv_no;
        mov rax, 1;
        ret;
      mlog_rv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // SECTION 11 -- PACKERS + ROW-POOL HELPERS
  // ==========================================================================

  // mlog_hdr_pack() -> canonical zero header. Only in_use is ever set,
  // by mlog_tail_alloc; committed and reserved stay 0 at mint. Mirror
  // of kind_tui_canvas.pdx tui_hdr_pack / surface_commit.pdx surface_
  // commit_hdr_pack.
  pub let mlog_hdr_pack : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B14 G10-M2-001 (paideia-os #2304): canonical header encoder; only in_use is ever written (by mlog_tail_alloc). Labels prefixed mlog_hp_ (none needed, straight-line).",
      block: {
        xor rax, rax;
        ret
      }
    }

  // mlog_row_slot(idx) -> &_mlog_row_pool[idx*64]. No bounds check by
  // policy -- mirrors vnode_pool.pdx vnode_slot / kind_tui_canvas.pdx
  // tui_canvas_slot (caller validates idx first). Provided as a
  // reusable address helper for a future debug-print / dispatcher
  // consumer; the body functions below inline this same math directly
  // rather than calling it, avoiding an extra nested-call alignment
  // dependency in their own control flow.
  pub let mlog_row_slot : (u64) -> u64 !{} @{} =
    fn (idx: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B14 G10-M2-001 (paideia-os #2304): &_mlog_row_pool[idx*64]. SIB scale limited to 1/2/4/8 so *64 is shl 6 + add. No bounds check by policy. Labels prefixed mlog_rs_ (none needed, straight-line).",
      block: {
        lea rax, [rip + _mlog_row_pool];
        shl rdi, 6;
        add rax, rdi;
        ret
      }
    }

  // mlog_entry_slot(row_idx, entry_idx) ->
  // &_mlog_ring_pool[row_idx*8192 + entry_idx*32]. No bounds check by
  // policy, same posture as mlog_row_slot.
  pub let mlog_entry_slot : (u64, u64) -> u64 !{} @{} =
    fn (row_idx: u64) (entry_idx: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B14 G10-M2-001 (paideia-os #2304): &_mlog_ring_pool[row_idx*MLOG_RING_BYTES(8192) + entry_idx*MLOG_ENTRY_BYTES(32)]. Both multiplies are power-of-two shl (13, 5). No bounds check by policy. Labels prefixed mlog_es_ (none needed, straight-line).",
      block: {
        lea rax, [rip + _mlog_ring_pool];
        mov r10, rdi;
        shl r10, 13;
        add rax, r10;
        mov r10, rsi;
        shl r10, 5;
        add rax, r10;
        ret
      }
    }

  // mlog_next_epoch() -> pre-increment monotonic commit-epoch counter;
  // first value is 1 (never 0), matching this codebase's universal
  // "id counters never return the zero sentinel" convention (mirrors
  // kind_tui_canvas.pdx tui_next_canvas_id).
  pub let mlog_next_epoch : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B14 G10-M2-001 (paideia-os #2304): pre-increment monotonic commit-epoch counter, kernel-wide across every row (the shared 'present time' clock the file header's LINEARITY DISCIPLINE section describes). First value 1, never 0. Labels prefixed mlog_ne_.",
      block: {
        lea r10, [rip + _mlog_next_epoch];
        mov rax, [r10 + 0];
        add rax, 1;
        mov [r10 + 0], rax;
        ret
      }
    }

  // mlog_tail_alloc(hdr, tree_row_id) -> row_id | MLOG_REFUSED_DENSE.
  // THE ONLY WRITER of _mlog_row_pool on the allocate path. Low-first
  // scan over MLOG_MAX(4) rows. One callee-save push (rbx) -- odd
  // push-count from entry rsp%16==8 lands rsp%16==0, though this
  // function makes no nested call so alignment is moot here; kept for
  // symmetry with every other tail_alloc in this tree.
  pub let mlog_tail_alloc : (u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (tree_row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B14 G10-M2-001 (paideia-os #2304): claim one mutation-log row. THE ONLY WRITER of _mlog_row_pool. Low-first free scan over MLOG_MAX(4) rows of 64 bytes (idx*64 via shl 6). Populates tree_row_id, write_cursor=0, commit_epoch=0, committed_count=0 per row layout. One callee-save push (rbx) holds tree_row_id across the scan. Labels prefixed mlog_ta_.",
      block: {
        push rbx;
        mov rbx, rsi;                    // tree_row_id

        xor rcx, rcx;                    // idx = 0
      mlog_ta_scan:
        cmp rcx, 4;
        jae mlog_ta_dense;

        lea r10, [rip + _mlog_row_pool];
        mov r11, rcx;
        shl r11, 6;                      // idx * 64
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  mlog_ta_claim;

        add rcx, 1;
        jmp mlog_ta_scan;

      mlog_ta_claim:
        mov rax, rdi;                    // hdr (== 0, but generic)
        mov r9, 1;
        shl r9, 56;
        or  rax, r9;
        mov [r10 + 0],  rax;             // header: in_use = 1
        mov [r10 + 8],  rbx;             // tree_row_id
        xor rax, rax;
        mov [r10 + 16], rax;             // write_cursor = 0
        mov [r10 + 24], rax;             // commit_epoch = 0
        mov [r10 + 32], rax;             // committed_count = 0
        mov rax, rcx;                    // row_id
        jmp mlog_ta_out;

      mlog_ta_dense:
        mov rax, 0xFFFFE87F;             // MLOG_REFUSED_DENSE

      mlog_ta_out:
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION 12 -- BODY FUNCTIONS: mint / append / commit / consume
  // ==========================================================================

  // mutation_log_mint(tree_row_id) -> row_id | MLOG_NULL |
  // MLOG_REFUSED_DENSE.
  //
  // Gate order: (1) tree_row_id validated against the parent KIND_
  // A11Y_TREE row pool via TreeKind's exported a11y_tree_row_valid
  // (cross-module bare-symbol call); (2) mlog_tail_alloc. On success
  // emits the file's one fingerprint via klog_s1_x1 and bumps
  // MLOG_ST_MINTS; on either refusal bumps MLOG_ST_REFUSED once
  // through the shared funnel. One callee-save push (r12) holds
  // tree_row_id, then the freshly-minted row_id, across every nested
  // call in this function -- entry rsp%16==8, one push -> rsp%16==0
  // for all four calls (a11y_tree_row_valid, mlog_hdr_pack, mlog_tail_
  // alloc, klog_s1_x1).
  pub let mutation_log_mint : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (tree_row_id: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "Wave0-B14 G10-M2-001 (paideia-os #2304): mint KIND_A11Y_MUTATION_LOG over the caller's KIND_A11Y_TREE row. Gate order: (1) tree_row_id via TreeKind.a11y_tree_row_valid (parent-tree binding check, cross-module bare-symbol call per this codebase's link-time convention); (2) mlog_tail_alloc. On success emits pdx_kind_a11y_mutation_log_meta via klog_s1_x1(LEVEL_INFO, SUBSYS_CAP_, meta, mlog_k_row_id, row_id) and bumps _mlog_stats[MLOG_ST_MINTS]; both refusal arms (MLOG_NULL, MLOG_REFUSED_DENSE) funnel through mlog_mint_refused which bumps _mlog_stats[MLOG_ST_REFUSED] exactly once, mirroring kind_tty.pdx / kind_tui_canvas.pdx's narrow refused-counter convention. One callee-save push (r12): entry rsp%16==8, +8=16 -> rsp%16==0, valid for every nested call in this body (odd push count). Labels prefixed mlog_mint_.",
      block: {
        push r12;
        mov r12, rdi;                    // tree_row_id

        mov rdi, r12;
        call a11y_tree_row_valid;
        cmp rax, 0;
        je  mlog_mint_null;

        call mlog_hdr_pack;
        mov rsi, r12;                    // tree_row_id (2nd arg)
        mov rdi, rax;                    // hdr (1st arg)
        call mlog_tail_alloc;

        mov r10, 4;
        cmp rax, r10;
        jae mlog_mint_refused;           // rax already holds MLOG_REFUSED_DENSE

        mov r12, rax;                    // row_id

        lea r10, [rip + _mlog_stats];
        mov rax, [r10 + 0];
        add rax, 1;
        mov [r10 + 0], rax;              // MLOG_ST_MINTS

        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + pdx_kind_a11y_mutation_log_meta];
        lea rcx, [rip + mlog_k_row_id];
        mov r8,  r12;                    // row_id
        call klog_s1_x1;

        mov rax, r12;
        jmp mlog_mint_out;

      mlog_mint_null:
        mov rax, 0xFFFFE87E;             // MLOG_NULL

      mlog_mint_refused:
        lea r10, [rip + _mlog_stats];
        mov r11, [r10 + 32];             // MLOG_ST_REFUSED (idx 4 * 8)
        add r11, 1;
        mov [r10 + 32], r11;

      mlog_mint_out:
        pop r12;
        ret
      }
    }

  // mutation_log_append(row_id, opcode, node_id, payload_lo,
  // payload_hi) -> MLOG_OK(0) | MLOG_NOT_INIT | MLOG_OPCODE_INVALID |
  // MLOG_NODE_NOT_FOUND | MLOG_FULL.
  //
  // Gate order: row -> opcode -> node_id -> ring capacity. On success
  // writes the four-qword entry at [row_id, write_cursor], increments
  // write_cursor, bumps MLOG_ST_APPENDS. Five callee-save pushes
  // (rbx, r12-r15) hold the five arguments across the three validator
  // calls -- entry rsp%16==8, +40=48 -> rsp%16==0 (odd push count).
  pub let mutation_log_append : (u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (row_id: u64) (opcode: u64) (node_id: u64) (payload_lo: u64) (payload_hi: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "Wave0-B14 G10-M2-001 (paideia-os #2304): buffer one mutation into row_id's ring for the current (uncommitted) frame. Gate order: (1) mlog_row_valid; (2) mlog_opcode_valid; (3) mlog_node_id_valid (formality ceiling, see file header note); (4) write_cursor < MLOG_RING_CAP(256). Entry address computed inline (row_id*8192 + write_cursor*32 via shl 13 / shl 5) rather than calling mlog_entry_slot, avoiding a fifth nested call once the three validators have already run. Five callee-save pushes (rbx=payload_hi, r12=row_id, r13=opcode, r14=node_id, r15=payload_lo): entry rsp%16==8, +40=48 -> rsp%16==0 (odd count), valid for the three validator calls. Labels prefixed mlog_append_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // row_id
        mov r13, rsi;                    // opcode
        mov r14, rdx;                    // node_id
        mov r15, rcx;                    // payload_lo
        mov rbx, r8;                     // payload_hi

        mov rdi, r12;
        call mlog_row_valid;
        cmp rax, 0;
        je  mlog_append_not_init;

        mov rdi, r13;
        call mlog_opcode_valid;
        cmp rax, 0;
        je  mlog_append_bad_opcode;

        mov rdi, r14;
        call mlog_node_id_valid;
        cmp rax, 0;
        je  mlog_append_bad_node;

        lea r10, [rip + _mlog_row_pool];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;                    // r10 = row addr

        mov rax, [r10 + 16];             // write_cursor
        mov r9, 256;
        cmp rax, r9;
        jae mlog_append_full;

        lea rcx, [rip + _mlog_ring_pool];
        mov rdx, r12;
        shl rdx, 13;                     // row_id * 8192
        add rcx, rdx;
        mov rdx, rax;                    // write_cursor
        shl rdx, 5;                      // * 32
        add rcx, rdx;                    // rcx = entry addr

        mov [rcx + 0],  r13;             // opcode
        mov [rcx + 8],  r14;             // node_id
        mov [rcx + 16], r15;             // payload_lo
        mov [rcx + 24], rbx;             // payload_hi

        add rax, 1;
        mov [r10 + 16], rax;             // write_cursor++

        lea r10, [rip + _mlog_stats];
        mov rax, [r10 + 8];
        add rax, 1;
        mov [r10 + 8], rax;              // MLOG_ST_APPENDS

        xor rax, rax;                    // MLOG_OK
        jmp mlog_append_out;

      mlog_append_not_init:
        mov rax, 0xFFFFE87D;             // MLOG_NOT_INIT
        jmp mlog_append_out;
      mlog_append_bad_opcode:
        mov rax, 0xFFFFE87C;             // MLOG_OPCODE_INVALID
        jmp mlog_append_out;
      mlog_append_bad_node:
        mov rax, 0xFFFFE87B;             // MLOG_NODE_NOT_FOUND
        jmp mlog_append_out;
      mlog_append_full:
        mov rax, 0xFFFFE87A;             // MLOG_FULL

      mlog_append_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // mutation_log_commit(row_id) -> epoch | MLOG_NOT_INIT |
  // MLOG_ALREADY_COMMITTED.
  //
  // The atomic per-frame publish boundary the file header's LINEARITY
  // DISCIPLINE section describes: stamps a fresh epoch from the
  // shared _mlog_next_epoch clock, snapshots write_cursor into
  // committed_count, and sets the committed bit. One callee-save push
  // (r12) holds row_id across mlog_row_valid and mlog_next_epoch --
  // entry rsp%16==8, +8=16 -> rsp%16==0 (odd count).
  pub let mutation_log_commit : (u64) -> u64 !{mem} @{cap} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "Wave0-B14 G10-M2-001 (paideia-os #2304): atomic-batch commit boundary. Gate: (1) mlog_row_valid; (2) header's committed bit (bit 55) must be 0 -- else MLOG_ALREADY_COMMITTED (the LINEAR one-batch-in-flight invariant: a prior commit must be drained by consume() before a new one is accepted). On success: epoch = mlog_next_epoch() (kernel-wide monotonic clock, shared by every row); row's commit_epoch = epoch; committed_count = current write_cursor; committed bit set; _mlog_stats[MLOG_ST_COMMITS] bumped; returns epoch. Row address is recomputed fresh after the mlog_next_epoch call (r10/r11 are caller-saved and cannot be trusted to survive a nested call) rather than held across it -- only row_id (r12, callee-saved) and the returned epoch (rax, untouched by the address recompute) need to survive. One callee-save push (r12): entry rsp%16==8, +8=16 -> rsp%16==0 (odd count), valid for both nested calls. Labels prefixed mlog_commit_.",
      block: {
        push r12;
        mov r12, rdi;                    // row_id

        mov rdi, r12;
        call mlog_row_valid;
        cmp rax, 0;
        je  mlog_commit_not_init;

        lea r10, [rip + _mlog_row_pool];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;                    // row addr

        mov rax, [r10 + 0];              // header
        mov r9, rax;
        shr r9, 55;
        and r9, 1;                       // committed bit
        cmp r9, 0;
        jne mlog_commit_already;

        call mlog_next_epoch;            // rax = fresh epoch

        lea r10, [rip + _mlog_row_pool]; // recompute row addr (r10/r11 volatile
        mov r11, r12;                    // across the call above; rax untouched)
        shl r11, 6;
        add r10, r11;

        mov [r10 + 24], rax;             // commit_epoch = epoch
        mov r9, [r10 + 16];              // write_cursor
        mov [r10 + 32], r9;              // committed_count = write_cursor

        mov r8, [r10 + 0];               // header
        mov r11, 1;
        shl r11, 55;
        or  r8, r11;
        mov [r10 + 0], r8;               // committed bit set

        push rax;                        // preserve epoch across the stats bump
        lea r10, [rip + _mlog_stats];
        mov r11, [r10 + 16];
        add r11, 1;
        mov [r10 + 16], r11;             // MLOG_ST_COMMITS
        pop rax;

        jmp mlog_commit_out;

      mlog_commit_not_init:
        mov rax, 0xFFFFE87D;             // MLOG_NOT_INIT
        jmp mlog_commit_out;
      mlog_commit_already:
        mov rax, 0xFFFFE878;             // MLOG_ALREADY_COMMITTED

      mlog_commit_out:
        pop r12;
        ret
      }
    }

  // mutation_log_consume(row_id, expected_epoch) -> committed_count |
  // MLOG_NOT_INIT | MLOG_EPOCH_STALE.
  //
  // The reader's one-shot drain. Returns 0 (not an error) if nothing
  // has ever been committed. Requires expected_epoch to match the
  // row's actual commit_epoch -- the structural guard against reading
  // a mixture of frames the file header's design rationale describes.
  // Two callee-save pushes (r12, r13) plus an 8-byte pad -- entry
  // rsp%16==8, +16+8=32 -> rsp%16==0 (even push count needs the pad,
  // mirrors kind_tui_canvas_mint_body's six-push + sub rsp,8 shape).
  pub let mutation_log_consume : (u64, u64) -> u64 !{mem} @{cap} =
    fn (row_id: u64) (expected_epoch: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "Wave0-B14 G10-M2-001 (paideia-os #2304): one-shot drain of the currently-committed batch. Gate: (1) mlog_row_valid; (2) header's committed bit -- if clear, returns 0 (benign 'nothing new yet', not an error: there is no epoch to be stale against before the first commit); (3) if set, expected_epoch must equal commit_epoch, else MLOG_EPOCH_STALE. On success: committed_count is captured, the committed bit is cleared via subtraction of the known-set bit value (sidesteps the `and rN, imm64` restriction -- see file header ENCODER DISCIPLINE), write_cursor is reset to 0 (hands the row back to the writer for the next frame), _mlog_stats[MLOG_ST_CONSUMES] is bumped, and committed_count is returned. Two callee-save pushes (r12=row_id, r13=expected_epoch) + sub rsp,8: entry rsp%16==8, +16=24, +8=32 -> rsp%16==0. This function makes exactly one nested call (mlog_row_valid), before which the pad is already in place. Labels prefixed mlog_consume_.",
      block: {
        push r12;
        push r13;
        sub rsp, 8;

        mov r12, rdi;                    // row_id
        mov r13, rsi;                    // expected_epoch

        mov rdi, r12;
        call mlog_row_valid;
        cmp rax, 0;
        je  mlog_consume_not_init;

        lea r10, [rip + _mlog_row_pool];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;                    // row addr

        mov rax, [r10 + 0];              // header
        mov r9, rax;
        shr r9, 55;
        and r9, 1;                       // committed bit
        cmp r9, 0;
        je  mlog_consume_nothing;

        mov rax, [r10 + 24];             // commit_epoch
        cmp rax, r13;
        jne mlog_consume_stale;

        mov r9, [r10 + 32];              // committed_count (return value)
        mov r8, [r10 + 0];               // header
        mov r11, 1;
        shl r11, 55;
        sub r8, r11;                     // clear committed bit (known set here)
        mov [r10 + 0], r8;

        xor r11, r11;
        mov [r10 + 16], r11;             // write_cursor = 0

        lea r10, [rip + _mlog_stats];
        mov r11, [r10 + 24];
        add r11, 1;
        mov [r10 + 24], r11;             // MLOG_ST_CONSUMES

        mov rax, r9;                     // committed_count
        jmp mlog_consume_out;

      mlog_consume_not_init:
        mov rax, 0xFFFFE87D;             // MLOG_NOT_INIT
        jmp mlog_consume_out;
      mlog_consume_nothing:
        xor rax, rax;                    // nothing committed yet -- benign 0
        jmp mlog_consume_out;
      mlog_consume_stale:
        mov rax, 0xFFFFE879;             // MLOG_EPOCH_STALE

      mlog_consume_out:
        add rsp, 8;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // SECTION 13 -- BOOT INIT
  // ==========================================================================

  // mutation_log_init() -> (). Zero the row pool + ring pool and reset
  // the epoch clock. .bss is already zero at real boot; this is
  // defensive re-scrub, matching kind_tui_canvas.pdx tui_canvas_init /
  // kind_tty.pdx tty_table_reset.
  pub let mutation_log_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B14 G10-M2-001 (paideia-os #2304): zero _mlog_row_pool (32 u64 words) and _mlog_ring_pool (4096 u64 words), reset _mlog_next_epoch to 0. Boot-time defensive re-scrub. Labels prefixed mlog_init_.",
      block: {
        lea r10, [rip + _mlog_row_pool];
        xor rax, rax;
        xor rcx, rcx;
      mlog_init_row_loop:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  mlog_init_row_loop;

        lea r10, [rip + _mlog_ring_pool];
        xor rcx, rcx;
      mlog_init_ring_loop:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4096;
        jb  mlog_init_ring_loop;

        lea r10, [rip + _mlog_next_epoch];
        mov [r10 + 0], rax;
        ret
      }
    }
}
