    }

  pub let workspace_row_active_window : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B8-02 (#2288): active_window_kind_id at body2[31:0]. 0 = no active window. Labels prefixed workspace_raw_.",
      block: {
        push r12;
        mov r12, rdi;
        call workspace_tail_valid;
        cmp rax, 0;
        je  workspace_raw_bad;
        lea r10, [rip + _wksp_table];
        mov r11, r12;
        imul r11, r11, 32;
        add r10, r11;
        mov rax, [r10 + 16];
        and rax, 0xFFFFFFFF;
        jmp workspace_raw_out;
      workspace_raw_bad:
