  pub let workspace_row_output : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B8-02 (#2288): output_kind_id at body2[63:32]. 0 = detached. Labels prefixed workspace_ro_.",
      block: {
        push r12;
        mov r12, rdi;
        call workspace_tail_valid;
        cmp rax, 0;
        je  workspace_ro_bad;
        lea r10, [rip + _wksp_table];
        mov r11, r12;
        imul r11, r11, 32;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 32;
        and rax, 0xFFFFFFFF;
        jmp workspace_ro_out;
      workspace_ro_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      workspace_ro_out:
        pop r12;
        ret
      }
    }

  pub let workspace_row_created_at_seq : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B8-02 (#2288): created_at_seq at body3[63:0]. Labels prefixed workspace_rcs_.",
      block: {
        push r12;
        mov r12, rdi;
        call workspace_tail_valid;
        cmp rax, 0;
        je  workspace_rcs_bad;
        lea r10, [rip + _wksp_table];
        mov r11, r12;
        imul r11, r11, 32;
        add r10, r11;
        mov rax, [r10 + 24];
        jmp workspace_rcs_out;
      workspace_rcs_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      workspace_rcs_out:
        pop r12;
        ret
      }
    }

  // workspace_find_by_id(workspace_id) -> row_id | WKSP_ROW_NONE.
  pub let workspace_find_by_id : (u64) -> u64 !{mem} @{} =
    fn (workspace_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B8-02 (#2288): linear scan for workspace_id in header[31:0] of every live row. Labels prefixed workspace_fbi_.",
      block: {
        push rbx;
        push r12;
        mov r12, rdi;
        xor rbx, rbx;
      workspace_fbi_scan:
        cmp rbx, 16;
        jae workspace_fbi_none;
        lea r10, [rip + _wksp_table];
        mov r11, rbx;
        imul r11, r11, 32;
        add r10, r11;
        mov rax, [r10 + 0];
        mov r11, rax;
        shr r11, 56;
        cmp r11, 0;
        je  workspace_fbi_step;
        and rax, 0xFFFFFFFF;
        cmp rax, r12;
        jne workspace_fbi_step;
        mov rax, rbx;
        jmp workspace_fbi_out;
      workspace_fbi_step:
        add rbx, 1;
        jmp workspace_fbi_scan;
      workspace_fbi_none:
        mov rax, 0xFFFFEB70;               // WKSP_ROW_NONE
      workspace_fbi_out:
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Section 11  workspace_mint / workspace_revoke
  // ==========================================================================
  //
  // workspace_mint(workspace_id, name_offset, layout)
  //     -> row_id | WKSP_MINT_* sentinel.
  //
  // Fresh workspace: window_count = 0, active_window = 0,
  // output_kind_id = 0 (detached). created_at_seq stamped from the
  // monotonic counter AFTER the uniqueness check so a refused mint
  // does not burn a seq slot.
  pub let workspace_mint : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (workspace_id: u64) (name_offset: u64) (layout: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B8-02 (#2288): mint one KIND_WORKSPACE row. Four-push callee-save prologue = 32 bytes: entry rsp%16==8, +32+8=40, but we sub rsp,8 so the aligned frame is +40+8=48, %16==0 for every nested call. Args stashed into callee-save before any nested call: rbx=workspace_id, r12=name_offset, r13=layout. Refusal funnel bumps _wksp_stats[WKSP_ST_REFUSED] once at workspace_mb_refused. Labels prefixed workspace_mb_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        sub rsp, 8;

        mov rbx, rdi;                     // workspace_id
        mov r12, rsi;                     // name_offset
        mov r13, rdx;                     // layout

        // (1) workspace_id fits in u32.
        mov rdi, rbx;
        call workspace_u32_valid;
        cmp rax, 0;
        je  workspace_mb_bad_id;

        // (2) name_offset fits in u32.
        mov rdi, r12;
        call workspace_u32_valid;
        cmp rax, 0;
        je  workspace_mb_bad_name;

        // (3) layout in 0..3.
        mov rdi, r13;
        call workspace_layout_valid;
        cmp rax, 0;
        je  workspace_mb_bad_layout;

        // (4) workspace_id uniqueness.
        mov rdi, rbx;
        call workspace_find_by_id;
        mov r10, 0xFFFFEB70;              // WKSP_ROW_NONE
        cmp rax, r10;
        jne workspace_mb_id_in_use;

        // (5) Bump seq counter -> body3 (created_at_seq).
        call workspace_seq_next;
        mov r14, rax;                     // r14 = created_at_seq

        // Pack header = (workspace_id, layout).
        mov rdi, rbx;
        mov rsi, r13;
        call workspace_hdr_pack;
        mov rbx, rax;                     // rbx = hdr (workspace_id no longer needed)

        // Pack body1 = (name_offset, window_count=0).
        mov rdi, r12;
        xor rsi, rsi;
        call workspace_body1_pack;
        mov r12, rax;                     // r12 = body1

        // Pack body2 = (active_window=0, output_kind_id=0).
        xor rdi, rdi;
        xor rsi, rsi;
        call workspace_body2_pack;
        mov r13, rax;                     // r13 = body2

        // tail_alloc(hdr, body1, body2, body3).
        mov rdi, rbx;                     // hdr
        mov rsi, r12;                     // body1
        mov rdx, r13;                     // body2
        mov rcx, r14;                     // body3 = created_at_seq
        call workspace_tail_alloc;

        mov r10, 16;
        cmp rax, r10;
        jae workspace_mb_enospc;          // rax already the sentinel

        // Success: bump mints, preserve row_id across the note call.
        mov rbx, rax;
        mov rdi, 0;                       // WKSP_ST_MINTS
        call workspace_note;
        mov rax, rbx;
        jmp workspace_mb_out;

      workspace_mb_bad_id:
        mov rax, 0xFFFFEB7D;              // WKSP_MINT_BAD_ID
        jmp workspace_mb_refused;
      workspace_mb_bad_name:
        mov rax, 0xFFFFEB7A;              // WKSP_MINT_BAD_NAME
        jmp workspace_mb_refused;
      workspace_mb_bad_layout:
        mov rax, 0xFFFFEB7B;              // WKSP_MINT_BAD_LAYOUT
        jmp workspace_mb_refused;
      workspace_mb_id_in_use:
        mov rax, 0xFFFFEB7C;              // WKSP_MINT_ID_IN_USE
        jmp workspace_mb_refused;
      workspace_mb_enospc:
        // rax already WKSP_TAIL_ENOSPC (0xFFFFEB7F) from tail_alloc.

      workspace_mb_refused:
        mov rbx, rax;                     // stash sentinel
        mov rdi, 2;                       // WKSP_ST_REFUSED
        call workspace_note;
        mov rax, rbx;

      workspace_mb_out:
        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // workspace_revoke(row_id) -> 0 | WKSP_BAD_SLOT | WKSP_REVOKE_ALREADY.
  pub let workspace_revoke : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B8-02 (#2288): revoke one row. row_id >= WKSP_MAX -> WKSP_BAD_SLOT; not in_use -> WKSP_REVOKE_ALREADY; else free + bump revokes + return 0. Labels prefixed workspace_rev_.",
      block: {
        push r12;
        mov r12, rdi;

        mov r10, 16;
        cmp r12, r10;
        jae workspace_rev_bad_slot;

        mov rdi, r12;
        call workspace_tail_valid;
        cmp rax, 0;
        je  workspace_rev_already;

        mov rdi, r12;
        call workspace_tail_free;
        mov rdi, 1;                       // WKSP_ST_REVOKES
        call workspace_note;
        xor rax, rax;
        jmp workspace_rev_out;

      workspace_rev_bad_slot:
        mov rax, 0xFFFFEB79;              // WKSP_BAD_SLOT
        jmp workspace_rev_out;
      workspace_rev_already:
        mov rax, 0xFFFFEB78;              // WKSP_REVOKE_ALREADY

      workspace_rev_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Section 12  Placement / activation ops
  // ==========================================================================
  //
  // workspace_place_window(row_id, window_kind_id) -> 0 | error.
  // Validates row + window_kind_id, then bumps window_count in body1.
  // Refuses window_count overflow past u32 max (WKSP_PLACE_OVERFLOW).
  // Does NOT touch active_window -- placement and activation are
  // separate ops so a workspace can accumulate windows without
  // implicit focus shifts.
  pub let workspace_place_window : (u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64) (window_kind_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B8-02 (#2288): place. Three callee-save pushes (rbx=row_id, r12=window_kind_id, r13=row base) leave rsp%16==0 for the nested tail_valid / window_valid calls. No sub rsp,8 -- three pushes already align. Labels prefixed workspace_pw_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                     // row_id
        mov r12, rsi;                     // window_kind_id

        mov rdi, rbx;
        call workspace_tail_valid;
        cmp rax, 0;
        je  workspace_pw_bad_slot;

        mov rdi, r12;
        call workspace_window_valid;
        cmp rax, 0;
        je  workspace_pw_bad_window;

        // Load body1, decode window_count (upper 32 bits).
        lea r10, [rip + _wksp_table];
        mov r11, rbx;
        imul r11, r11, 32;
        add r10, r11;
        mov r13, r10;                     // r13 = row base
        mov rax, [r13 + 8];               // body1
        mov r11, rax;
        shr r11, 32;                      // r11 = window_count
        mov r10, 0xFFFFFFFF;
        cmp r11, r10;
        jae workspace_pw_overflow;

        // Bump window_count, re-pack body1.
        add r11, 1;
        mov r10, 0xFFFFFFFF;
        and rax, r10;                     // rax = name_offset (low 32)
        shl r11, 32;
        or  rax, r11;
        mov [r13 + 8], rax;

        xor rax, rax;
        jmp workspace_pw_out;

      workspace_pw_bad_slot:
        mov rax, 0xFFFFEB79;              // WKSP_BAD_SLOT
        jmp workspace_pw_out;
      workspace_pw_bad_window:
        mov rax, 0xFFFFEB75;              // WKSP_BAD_WINDOW
        jmp workspace_pw_out;
      workspace_pw_overflow:
        mov rax, 0xFFFFEB74;              // WKSP_PLACE_OVERFLOW

      workspace_pw_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // workspace_remove_window(row_id, window_kind_id) -> 0 | error.
  // Validates row + window_kind_id, refuses window_count underflow
  // (WKSP_REMOVE_UNDERFLOW), decrements window_count. If
  // active_window_kind_id == window_kind_id, clears active_window
  // (workspace-level GC of the stale focus pointer).
  pub let workspace_remove_window : (u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64) (window_kind_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B8-02 (#2288): remove. Same prologue shape as workspace_place_window: three pushes align rsp%16==0 for nested calls, no sub rsp,8. Decrement body1[63:32] and (if match) clear body2[31:0]. Labels prefixed workspace_rw2_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                     // row_id
        mov r12, rsi;                     // window_kind_id

        mov rdi, rbx;
        call workspace_tail_valid;
        cmp rax, 0;
        je  workspace_rw2_bad_slot;

        mov rdi, r12;
        call workspace_window_valid;
        cmp rax, 0;
        je  workspace_rw2_bad_window;

        // Load body1, decode window_count (upper 32 bits).
        lea r10, [rip + _wksp_table];
        mov r11, rbx;
        imul r11, r11, 32;
        add r10, r11;
        mov r13, r10;                     // r13 = row base
        mov rax, [r13 + 8];               // body1
        mov r11, rax;
        shr r11, 32;                      // r11 = window_count
        cmp r11, 0;
        je  workspace_rw2_underflow;

        // Decrement window_count, re-pack body1.
        sub r11, 1;
        mov r10, 0xFFFFFFFF;
        and rax, r10;                     // rax = name_offset (low 32)
        shl r11, 32;
        or  rax, r11;
        mov [r13 + 8], rax;

        // If active_window == window_kind_id, clear it.
        mov rax, [r13 + 16];              // body2
        mov r11, rax;
        shl r11, 32;
        shr r11, 32;              // r11 = active_window
        cmp r11, r12;
        jne workspace_rw2_ok;
        mov r10, 0xFFFFFFFF;
        shl r10, 32;                      // r10 = 0xFFFFFFFF00000000 (clear low 32)
        and rax, r10;
        mov [r13 + 16], rax;

      workspace_rw2_ok:
        xor rax, rax;
        jmp workspace_rw2_out;

      workspace_rw2_bad_slot:
        mov rax, 0xFFFFEB79;              // WKSP_BAD_SLOT
        jmp workspace_rw2_out;
      workspace_rw2_bad_window:
        mov rax, 0xFFFFEB75;              // WKSP_BAD_WINDOW
        jmp workspace_rw2_out;
      workspace_rw2_underflow:
        mov rax, 0xFFFFEB73;              // WKSP_REMOVE_UNDERFLOW

      workspace_rw2_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // workspace_activate(row_id, window_kind_id) -> 0 | error.
  // Validates row + window_kind_id, sets active_window_kind_id in
  // body2[31:0]. Does NOT check whether window_kind_id has been
  // previously placed in this workspace -- caller enforces that
  // invariant (the compositor's focus-router keeps its own
  // window-set index and calls workspace_activate only after the
  // window is present).
  pub let workspace_activate : (u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64) (window_kind_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B8-02 (#2288): activate. Overwrite body2[31:0] with window_kind_id, preserving body2[63:32] (output_kind_id). Three pushes align rsp%16==0 for nested calls, no sub rsp,8. Labels prefixed workspace_ac_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                     // row_id
        mov r12, rsi;                     // window_kind_id

        mov rdi, rbx;
        call workspace_tail_valid;
        cmp rax, 0;
        je  workspace_ac_bad_slot;

        mov rdi, r12;
        call workspace_window_valid;
        cmp rax, 0;
        je  workspace_ac_bad_window;

        // Load body2, mask low 32, OR window_kind_id.
        lea r10, [rip + _wksp_table];
        mov r11, rbx;
        imul r11, r11, 32;
        add r10, r11;
        mov r13, r10;                     // r13 = row base
        mov rax, [r13 + 16];              // body2
        mov r10, 0xFFFFFFFF;
        shl r10, 32;                      // 0xFFFFFFFF00000000
        and rax, r10;                     // keep output_kind_id
        mov r11, r12;
        shl r11, 32;
        shr r11, 32;
        or  rax, r11;
        mov [r13 + 16], rax;

        xor rax, rax;
        jmp workspace_ac_out;

      workspace_ac_bad_slot:
        mov rax, 0xFFFFEB79;              // WKSP_BAD_SLOT
        jmp workspace_ac_out;
      workspace_ac_bad_window:
        mov rax, 0xFFFFEB75;              // WKSP_BAD_WINDOW

      workspace_ac_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Section 13  Enumeration
  // ==========================================================================
  //
  // workspace_enumerate_next(from_cursor) -> row_id | WKSP_ENUM_END.
  //
  // Iteration primitive over the row pool. Caller starts with
  // from_cursor == 0; on each hit, calls again with (row_id + 1).
  // Returns WKSP_ENUM_END (0xFFFFEB72) when no more live rows.
  // Skips revoked rows. Bounded by WKSP_MAX (16); worst-case
  // scan is O(WKSP_MAX) per call. A dense-packed pool (all N
  // workspaces at rows 0..N-1) enumerates in O(N) total; a
  // sparse pool (holes from revokes) still terminates in bounded
  // time.
  //
  // This is the ONE enumeration primitive workspaces expose:
  // downstream compositor code composes higher-level iterators
  // (filter-by-layout, filter-by-output, count-live-workspaces)
  // by calling this in a loop and applying the predicate against
  // the row-field query helpers.
  pub let workspace_enumerate_next : (u64) -> u64 !{mem} @{} =
    fn (from_cursor: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B8-02 (#2288): scan from row from_cursor to WKSP_MAX for the first live row. Returns WKSP_ENUM_END if the cursor is past WKSP_MAX or no more live rows exist at or after from_cursor. Bumps _wksp_stats[WKSP_ST_QUERIES] once per call. Two callee-save pushes + sub rsp,8 = 24 bytes: entry rsp%16==8, +16+8=24, %16==0 for the nested workspace_note call. Labels prefixed workspace_en_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;
        mov rbx, rdi;                     // cursor

        // Note the query.
        mov rdi, 3;                       // WKSP_ST_QUERIES
        call workspace_note;

      workspace_en_scan:
        cmp rbx, 16;
        jae workspace_en_end;
        lea r10, [rip + _wksp_table];
        mov r11, rbx;
        imul r11, r11, 32;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        jne workspace_en_hit;
        add rbx, 1;
        jmp workspace_en_scan;

      workspace_en_hit:
        mov rax, rbx;
        jmp workspace_en_out;
      workspace_en_end:
        mov rax, 0xFFFFEB72;              // WKSP_ENUM_END

      workspace_en_out:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Section 14  Boot init.
  // ==========================================================================

  pub let workspace_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B8-02 (#2288): call through to workspace_stats_reset for one clean pool + counter + seq zero-out. Labels prefixed workspace_i_.",
      block: {
        call workspace_stats_reset;
        ret
      }
    }
}
