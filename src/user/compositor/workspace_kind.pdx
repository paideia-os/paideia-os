// src/user/compositor/workspace_kind.pdx -- Wave0-B8-02 (paideia-os #2288)
//
// KIND_WORKSPACE = 0x1D2, user-visible aggregation cap.
// Design authority: design/compositor/pwp-spec-vocabulary.md §2.13
// (KIND_WORKSPACE). Depends on G7-M8-001 (LANDED Batch 7); consumed
// by window_kind.pdx (Batch 6) which already carries the
// `workspace_kind_id` field in its body3[31:0] slot.
//
// A KIND_WORKSPACE row names one addressable workspace -- the
// granularity of "switch what set of windows is visible on which
// output". A workspace holds a dense-packed workspace_id, an
// interned-string name offset (user-visible label like "1", "web",
// "chat"), a tiling-layout descriptor, an active-window pointer,
// a live window count, an output binding, and a monotonic
// creation-sequence stamp for total ordering across workspace
// mints. Workspace switch (present-timeline-synchronised atomic
// transition, #2289) is the caller's job; this file lands the
// authority + enumeration primitives that switch is built on.
//
// This is a user-space module (svc-compositor process, ring 3).
// Not wired into `cap_table` / `cap_invoke_dispatch`; a future
// landing that promotes KIND_WORKSPACE authority into the kernel
// mirrors the `kind_color_profile.pdx` (0x18F) posture. Pattern
// parallel: src/user/compositor/window_kind.pdx (B6-05,
// KIND_WINDOW at 0x1C1) landed the same shape for a user-space
// derived cap with rights bitmask + row pool + mint factory +
// per-row field-query helpers.
//
// =============================================================================
// SECTION 0  KIND_* SLOT ALLOCATION
// =============================================================================
//
// Consulted `design/architecture/next-wave-derived-kinds.md`. At
// B8-02 landing time the 0x1D0..0x1DF band already carried:
//   0x1D0   RESERVATION_HOLDER_KIND        (input server process cap)
//   0x1D1   RP_COMPOSITOR_KIND_FORWARD     (compositor process cap)
// This landing claims:
//   0x1D2   KIND_WORKSPACE                  (B8-02, THIS FILE)
// leaving 0x1D3..0x1DF open for sibling G9.M1 landings in the same
// batch. Cross-verified by grep over `src/**/*.pdx` at landing --
// no live claim on 0x1D2.
//
// =============================================================================
// SECTION 1  DERIVATION LINEAGE (INFORMATIONAL)
// =============================================================================
//
// The vocabulary §2.13 lists KIND_IPC_ENDPOINT = 5 as the eventual
// derivation parent. This landing (per the Wave-0 dispatch manifest
// for B8-02) is TOP-LEVEL: the mint gate has NO parent-authority
// check. Workspaces are minted by the compositor's session-boot
// path directly, not derived from a client-held cap. When the
// KIND_WORKSPACE authority is promoted into the kernel a future
// landing will add the KIND_IPC_ENDPOINT parent check in front of
// the workspace_mint gate; the row layout + field packers below
// stay unchanged.
//
// =============================================================================
// SECTION 2  ROW LAYOUT -- 32 BYTES (FOUR u64 WORDS)
// =============================================================================
//
//   [+0]  header:  in_use[63:56] | reserved[55:48] |
//                  layout[47:40]  | reserved[39:32] |
//                  workspace_id[31:0]
//   [+8]  body1:   name_offset[31:0] | window_count[63:32]
//   [+16] body2:   active_window_kind_id[31:0] | output_kind_id[63:32]
//   [+24] body3:   created_at_seq[63:0]
//
// workspace_id is caller-supplied and MUST be unique among live
// rows (mint refuses a duplicate with WKSP_MINT_ID_IN_USE). Dense-
// packed (0..N-1) by convention, but this file only enforces
// uniqueness -- the dense-packing invariant is a caller property.
//
// name_offset is a u32 offset into the compositor's interned
// string table (the same table the a11y-tree name/description
// fields cite). No inline string storage -- keeps the row cap
// fixed-size and lets a future rename op flip name_offset atomically.
//
// layout is a WorkspaceLayout enum value (0..3). Validated at mint
// (workspace_layout_valid); no runtime layout swap via this
// module -- a future R_WKSP_MINT_TILING-gated op will swap layout
// through a fresh cap derivation.
//
// active_window_kind_id: u32 slot of the KIND_WINDOW that currently
// holds focus within this workspace. 0 = no active window (empty
// workspace or all-minimised). Set via workspace_activate; cleared
// automatically when workspace_remove_window sees the removed
// window as the active one.
//
// window_count: u32 live-window population. Bumped by
// workspace_place_window, decremented by workspace_remove_window.
// Refuses underflow (WKSP_REMOVE_UNDERFLOW) rather than wrapping.
//
// output_kind_id: u32 slot of the KIND_DISPLAY_OUTPUT this
// workspace is currently pinned to. 0 = detached (workspace exists
// but is not visible on any output). Set out-of-band by the
// workspace-switch atomic (#2289); this file does NOT expose an
// op for it (the switch is a compositor-privileged operation that
// mutates output_kind_id + present timeline together).
//
// created_at_seq: u64 monotonic sequence stamp taken at mint time
// (from `_wksp_seq_counter`, incremented every successful mint).
// Total-orders workspace mints across boot; used by the workspace
// persistence hook (#2290) to replay workspaces in creation order
// on session restore.
//
// All slots stored little-endian. No float leaks into a workspace-
// metadata cap per the FPU-discipline (see `design/kernel/no-fpu.md`).
//
// =============================================================================
// SECTION 3  FAILURE TAXONOMY 0xFFFFEB70..0xFFFFEB7F
// =============================================================================
//
// The Wave-0 dispatch manifest for B8-02 named 0xFFFFEB10..0xFFFFEB1F
// as the recommended failure-taxonomy band, but that page is
// already claimed by KIND_TUI_CANVAS (see
// `src/kernel/core/cap/kind_tui_canvas.pdx` TUI_TAIL_ENOSPC through
// TUI_REVOKE_ALREADY). Repo-wide grep at landing time showed the
// following EB-band pages as claimed:
//   0xFFFFEB00..0F  KIND_SIG_KEY
//   0xFFFFEB10..1F  KIND_TUI_CANVAS
//   0xFFFFEB20..2F  claimed
//   0xFFFFEB30..3F  claimed (partial + trailing)
//   0xFFFFEB40..4F  claimed
//   0xFFFFEB50..5F  claimed
//   0xFFFFEB60..6F  claimed (partial + trailing)
//   0xFFFFEB70..7F  FREE  <-- claimed here
// This landing takes 0xFFFFEB70..0xFFFFEB7F -- the next fresh
// 16-slot aligned page. WKSP_ROW_NONE sits at the page floor
// (0xFFFFEB70) so a downstream diagnostic that greps for the
// "row lookup miss" sentinel finds it as its one canonical name.
//
// =============================================================================
// SECTION 4  WorkspaceLayout ENUM
// =============================================================================
//
//   FLOATING          = 0  -- classic floating windows, no auto-layout.
//   TILING_BSP        = 1  -- binary-space-partition tiling (bspwm-shape).
//   TILING_STACKED    = 2  -- stacked tiling (one visible child, tabs across top).
//   TILING_FIBONACCI  = 3  -- fibonacci/spiral tiling (dwm/xmonad-shape).
//
// Validated at mint via workspace_layout_valid (rejects >3). Layout
// value is stored in header[47:40] so the row_id decode never has
// to touch body1/body2/body3 to read the layout enum -- one word
// load + shift + mask is enough for the enumerate cursor to filter
// workspaces by layout.
//
// =============================================================================
// SECTION 5  workspace_mint FACTORY -- gate order
// =============================================================================
//
// Gate order (fail-fast; refusal funnel bumps _wksp_stats[WKSP_ST_REFUSED]
// once):
//   (1) workspace_id fits in u32               -> WKSP_MINT_BAD_ID
//   (2) name_offset  fits in u32               -> WKSP_MINT_BAD_NAME
//   (3) layout       in 0..3                   -> WKSP_MINT_BAD_LAYOUT
//   (4) workspace_id uniqueness (scan live)    -> WKSP_MINT_ID_IN_USE
//   (5) pack header/body1/body2 + tail_alloc
//         body3 = created_at_seq (post-bump _wksp_seq_counter)
//
// Note (1) permits workspace_id == 0 (workspace #0 is the
// user-facing "first workspace"; dense-packing starts at 0).
// This is deliberate: unlike window_id (which uses 0 as an
// empty-row sentinel via the header layout), workspace_id shares
// the header word with the in_use marker only via disjoint bit
// ranges ([31:0] vs [63:56]) so a valid workspace_id = 0 does
// not collide with the row-empty check.

module WorkspaceKind = structure {

  pub let KIND_WORKSPACE   : u64 = 0x1D2

  // Row pool. WKSP_MAX = 16 covers a heavily-partitioned session
  // (16 named workspaces per output, i3/sway convention) without
  // over-committing .bss; a future landing that wants a higher
  // ceiling bumps this constant and re-derives _wksp_table size.
  pub let WKSP_MAX       : u64 = 16
  pub let WKSP_ROW_BYTES : u64 = 32

  // WorkspaceLayout enum values.
  pub let WKSP_LAYOUT_FLOATING         : u64 = 0
  pub let WKSP_LAYOUT_TILING_BSP       : u64 = 1
  pub let WKSP_LAYOUT_TILING_STACKED   : u64 = 2
  pub let WKSP_LAYOUT_TILING_FIBONACCI : u64 = 3
  pub let WKSP_LAYOUT_MAX              : u64 = 3

  // Rights. R_WKSP_ENUMERATE mirrors the R_*_READ (0x001) posture
  // every other KIND_* file in this repo takes. R_WKSP_MINT mirrors
  // R_*_MINT (0x200). R_WKSP_OBSERVE mirrors R_*_OBSERVE (0x400).
  // The compositor-specific bits (PLACE_WINDOW, REMOVE_WINDOW,
  // MINT_TILING, ACTIVATE) live in the 0x800..0x10000 band, above
  // every standard right so a rights-mask AND against R_ALL_STANDARD
  // leaves the compositor-specific bits untouched. QUERY_WINDOWS
  // is a distinct right at 0x002 (READ-shaped but scoped to the
  // window-set read) so a caller that can enumerate the workspace
  // pool cannot forge a window-set read without the second bit.
  pub let R_WKSP_ENUMERATE      : u64 = 0x001
  pub let R_WKSP_QUERY_WINDOWS  : u64 = 0x002
  pub let R_WKSP_MINT           : u64 = 0x200
  pub let R_WKSP_OBSERVE        : u64 = 0x400
  pub let R_WKSP_ACTIVATE       : u64 = 0x800
  pub let R_WKSP_PLACE_WINDOW   : u64 = 0x1000
  pub let R_WKSP_REMOVE_WINDOW  : u64 = 0x2000
  pub let R_WKSP_MINT_TILING    : u64 = 0x4000
  pub let R_WKSP_ALL            : u64 = 0x7E03
     // 0x001|0x002|0x200|0x400|0x800|0x1000|0x2000|0x4000 = 0x7E03

  // Ops. Arity ONE (op_arg[63:8] REFUSED, mirroring the WIN_OP_*
  // conventions window_kind.pdx §Section (Ops) records).
  pub let WKSP_OP_QUERY_ID              : u64 = 0
  pub let WKSP_OP_QUERY_NAME_OFFSET     : u64 = 1
  pub let WKSP_OP_QUERY_LAYOUT          : u64 = 2
  pub let WKSP_OP_QUERY_ACTIVE_WINDOW   : u64 = 3
  pub let WKSP_OP_QUERY_WINDOW_COUNT    : u64 = 4
  pub let WKSP_OP_QUERY_OUTPUT          : u64 = 5
  pub let WKSP_OP_QUERY_CREATED_AT_SEQ  : u64 = 6
  pub let WKSP_OP_PLACE_WINDOW          : u64 = 7
  pub let WKSP_OP_REMOVE_WINDOW         : u64 = 8
  pub let WKSP_OP_ACTIVATE              : u64 = 9
  pub let WKSP_OP_ENUMERATE_NEXT        : u64 = 10
  pub let WKSP_OP_DEBUG_PRINT           : u64 = 11
  pub let WKSP_OP_MAX                   : u64 = 11

  // Failure taxonomy 0xFFFFEB70..0xFFFFEB7F. See §3 for why this
  // page (spec named 0xFFFFEB10..1F but KIND_TUI_CANVAS already
  // holds it).
  pub let WKSP_OK                 : u64 = 0
  pub let WKSP_TAIL_ENOSPC        : u64 = 0xFFFFEB7F
  pub let WKSP_TAIL_BAD_ARG       : u64 = 0xFFFFEB7E
  pub let WKSP_MINT_BAD_ID        : u64 = 0xFFFFEB7D
  pub let WKSP_MINT_ID_IN_USE     : u64 = 0xFFFFEB7C
  pub let WKSP_MINT_BAD_LAYOUT    : u64 = 0xFFFFEB7B
  pub let WKSP_MINT_BAD_NAME      : u64 = 0xFFFFEB7A
  pub let WKSP_BAD_SLOT           : u64 = 0xFFFFEB79
  pub let WKSP_REVOKE_ALREADY     : u64 = 0xFFFFEB78
  pub let WKSP_UNSUP_OP           : u64 = 0xFFFFEB77
  pub let WKSP_WRONG_KIND         : u64 = 0xFFFFEB76
  pub let WKSP_BAD_WINDOW         : u64 = 0xFFFFEB75
  pub let WKSP_PLACE_OVERFLOW     : u64 = 0xFFFFEB74
  pub let WKSP_REMOVE_UNDERFLOW   : u64 = 0xFFFFEB73
  pub let WKSP_ENUM_END           : u64 = 0xFFFFEB72
  pub let WKSP_DECODE_BAD         : u64 = 0xFFFFEB71
  pub let WKSP_ROW_NONE           : u64 = 0xFFFFEB70

  pub let WKSP_U32_MAX : u64 = 0xFFFFFFFF

  // THE ONE STATE CELL. 16 rows * 32 bytes = 512 bytes = 64 u64.
  pub let mut _wksp_table : [u64; 64] = uninit @align(64)
  pub let mut _wksp_stats : [u64; 4]  = uninit @align(64)

  // Monotonic sequence counter for created_at_seq. Bumped before
  // the first mint's body3 pack; first successful mint stamps
  // created_at_seq = 1 (0 reserved as "unset").
  pub let mut _wksp_seq_counter : [u64; 1] = uninit @align(64)

  pub let WKSP_ST_MINTS   : u64 = 0
  pub let WKSP_ST_REVOKES : u64 = 1
  pub let WKSP_ST_REFUSED : u64 = 2
  pub let WKSP_ST_QUERIES : u64 = 3

  // Fingerprint tag. Emitted by the compositor on successful mint
  // of a KIND_WORKSPACE cap. Legacy suffix gives grep parity with
  // pre-Wave0 boot-log tooling (see e.g. `window_kind.pdx`
  // pdx_kind_window_meta, `reference_display_kind.pdx`
  // rdk_mint_ok_msg).
  pub let pdx_kind_workspace_meta : [u8; 46] = "workspace mint ok [legacy: WORKSPACE MINT OK]\0"

  // ==========================================================================
  // Section 6  Counter primitives.
  // ==========================================================================

  pub let workspace_stats_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B8-02 (#2288): clear row table + counters + seq at boot. 16 rows * 4 u64 = 64 u64 for the table, 4 u64 for stats, 1 u64 for the seq counter. Labels prefixed workspace_rs_.",
      block: {
        lea r10, [rip + _wksp_table];
        xor rax, rax;
        xor rcx, rcx;
      workspace_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 64;
        jb  workspace_rs_rows;

        lea r10, [rip + _wksp_stats];
        xor rcx, rcx;
      workspace_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  workspace_rs_stats;

        lea r10, [rip + _wksp_seq_counter];
        mov [r10 + 0], rax;
        ret
      }
    }

  pub let workspace_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B8-02 (#2288): counter bump. Encoder-conservative load-inc-store; no add reg,[mem]. Labels prefixed workspace_nt_.",
      block: {
        cmp rdi, 4;
        jae workspace_nt_out;
        lea r10, [rip + _wksp_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      workspace_nt_out:
        ret
      }
    }

  pub let workspace_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B8-02 (#2288): counter read. Labels prefixed workspace_st_.",
      block: {
        cmp rdi, 4;
        jae workspace_st_zero;
        lea r10, [rip + _wksp_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      workspace_st_zero:
        xor rax, rax;
        ret
      }
    }

  // workspace_seq_next: bump-and-return the monotonic seq counter.
  // First call returns 1 (0 reserved as "unset").
  pub let workspace_seq_next : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B8-02 (#2288): monotonic seq counter bump-and-read. Load-inc-store; no add reg,[mem]. Labels prefixed workspace_sn_.",
      block: {
        lea r10, [rip + _wksp_seq_counter];
        mov rax, [r10 + 0];
        add rax, 1;
        mov [r10 + 0], rax;
        ret
      }
    }

  // ==========================================================================
  // Section 7  Validators.
  // ==========================================================================

  pub let workspace_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B8-02 (#2288): subset test against R_WKSP_ALL = 0x7E03. Labels prefixed workspace_rv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x7E03;
        and rax, r10;
        cmp rax, rdi;
        jne workspace_rv_no;
        mov rax, 1;
        ret;
      workspace_rv_no:
        xor rax, rax;
        ret
      }
    }

  // workspace_u32_valid: 1 iff v fits in 32 bits.
  pub let workspace_u32_valid : (u64) -> u64 !{} @{} =
    fn (v: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B8-02 (#2288): 1 iff v <= WKSP_U32_MAX. Labels prefixed workspace_uv_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  workspace_uv_no;
        mov rax, 1;
        ret;
      workspace_uv_no:
        xor rax, rax;
        ret
      }
    }

  // workspace_layout_valid: 1 iff layout in 0..3 (WKSP_LAYOUT_MAX).
  pub let workspace_layout_valid : (u64) -> u64 !{} @{} =
    fn (layout: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B8-02 (#2288): 1 iff layout <= 3. Labels prefixed workspace_lv_.",
      block: {
        cmp rdi, 3;
        ja  workspace_lv_no;
        mov rax, 1;
        ret;
      workspace_lv_no:
        xor rax, rax;
        ret
      }
    }

  // workspace_window_valid: 1 iff window_kind_id is nonzero AND
  // fits in u32. Used by place/remove/activate to refuse the zero
  // sentinel (which is the "no active window" marker in body2).
  pub let workspace_window_valid : (u64) -> u64 !{} @{} =
    fn (window_kind_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B8-02 (#2288): 1 iff window_kind_id in (0, 2^32). Zero is reserved as the 'no active window' sentinel. Labels prefixed workspace_wv_.",
      block: {
        cmp rdi, 0;
        je  workspace_wv_no;
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  workspace_wv_no;
        mov rax, 1;
        ret;
      workspace_wv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Section 8  Packers.
  // ==========================================================================

  // header: in_use[63:56] | reserved[55:48] | layout[47:40] |
  //         reserved[39:32] | workspace_id[31:0].
  // Emitted WITHOUT in_use bit set; tail_alloc ORs it in.
  pub let workspace_hdr_pack : (u64, u64) -> u64 !{} @{} =
    fn (workspace_id: u64) (layout: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B8-02 (#2288): header pack. workspace_id at [31:0], layout at [47:40]. Both halves validated by caller (workspace_u32_valid + workspace_layout_valid). Labels prefixed workspace_hp_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  workspace_hp_bad;
        cmp rsi, 3;
        ja  workspace_hp_bad;
        mov rax, rdi;
        and rax, 0xFFFFFFFF;
        mov r10, rsi;
        and r10, 0xFF;
        shl r10, 40;
        or  rax, r10;
        ret;
      workspace_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // body1: name_offset[31:0] | window_count[63:32].
  pub let workspace_body1_pack : (u64, u64) -> u64 !{} @{} =
    fn (name_offset: u64) (window_count: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B8-02 (#2288): body1 pack. Both halves capped at u32 max. Labels prefixed workspace_b1_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  workspace_b1_bad;
        cmp rsi, r10;
        ja  workspace_b1_bad;
        mov rax, rdi;
        and rax, 0xFFFFFFFF;
        mov r10, rsi;
        and r10, 0xFFFFFFFF;
        shl r10, 32;
        or  rax, r10;
        ret;
      workspace_b1_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // body2: active_window_kind_id[31:0] | output_kind_id[63:32].
  pub let workspace_body2_pack : (u64, u64) -> u64 !{} @{} =
    fn (active_window: u64) (output_kind: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B8-02 (#2288): body2 pack. Both halves capped at u32 max; zero is legal in either (unset). Labels prefixed workspace_b2_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  workspace_b2_bad;
        cmp rsi, r10;
        ja  workspace_b2_bad;
        mov rax, rdi;
        and rax, 0xFFFFFFFF;
        mov r10, rsi;
        and r10, 0xFFFFFFFF;
        shl r10, 32;
        or  rax, r10;
        ret;
      workspace_b2_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // Section 9  Row pool: valid / alloc / free.
  // ==========================================================================

  pub let workspace_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B8-02 (#2288): 1 iff row_id < WKSP_MAX and in_use. Labels prefixed workspace_tv_.",
      block: {
        cmp rdi, 16;
        jae workspace_tv_no;
        lea r10, [rip + _wksp_table];
        mov r11, rdi;
        imul r11, r11, 32;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  workspace_tv_no;
        mov rax, 1;
        ret;
      workspace_tv_no:
        xor rax, rax;
        ret
      }
    }

  // workspace_tail_alloc(hdr, body1, body2, body3) -> row_id | err.
  // Low-first scan over 16 rows. Header stamped with in_use bit
  // (bit 56) here so callers pass an "unset in_use" packed header.
  pub let workspace_tail_alloc : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (body1: u64) (body2: u64) (body3: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B8-02 (#2288): claim one KIND_WORKSPACE row. Low-first scan (rbx=idx) over 16 rows of 32 bytes (idx*32 via imul). On claim: OR the 1<<56 in_use marker into hdr and store the four u64 body words. Five callee-save pushes (rbx=idx, r12=hdr, r13=body1, r14=body2, r15=body3) leave rsp%16==0 for the no-nested-call scan. Labels prefixed workspace_ta_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov r15, rcx;

        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne workspace_ta_bad;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp r13, r10;
        je  workspace_ta_bad;
        cmp r14, r10;
        je  workspace_ta_bad;

        xor rbx, rbx;
      workspace_ta_scan:
        cmp rbx, 16;
        jae workspace_ta_enospc;
        lea r10, [rip + _wksp_table];
        mov r11, rbx;
        imul r11, r11, 32;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  workspace_ta_claim;
        add rbx, 1;
        jmp workspace_ta_scan;

      workspace_ta_claim:
        mov rax, r12;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r13;
        mov [r10 + 16], r14;
        mov [r10 + 24], r15;
        mov rax, rbx;
        jmp workspace_ta_out;

      workspace_ta_enospc:
        mov rax, 0xFFFFEB7F;
        jmp workspace_ta_out;
      workspace_ta_bad:
        mov rax, 0xFFFFEB7E;

      workspace_ta_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let workspace_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B8-02 (#2288): scrub one row (all four words). Labels prefixed workspace_tf_.",
      block: {
        cmp rdi, 16;
        jae workspace_tf_out;
        lea r10, [rip + _wksp_table];
        mov r11, rdi;
        imul r11, r11, 32;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
      workspace_tf_out:
        ret
      }
    }

  // ==========================================================================
  // Section 10  Row-field query helpers.
  // ==========================================================================

  pub let workspace_row_id : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B8-02 (#2288): workspace_id at header[31:0]. Labels prefixed workspace_rid_.",
      block: {
        push r12;
        mov r12, rdi;
        call workspace_tail_valid;
        cmp rax, 0;
        je  workspace_rid_bad;
        lea r10, [rip + _wksp_table];
        mov r11, r12;
        imul r11, r11, 32;
        add r10, r11;
        mov rax, [r10 + 0];
        and rax, 0xFFFFFFFF;
        jmp workspace_rid_out;
      workspace_rid_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      workspace_rid_out:
        pop r12;
        ret
      }
    }

  pub let workspace_row_layout : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B8-02 (#2288): layout at header[47:40]. Labels prefixed workspace_rl_.",
      block: {
        push r12;
        mov r12, rdi;
        call workspace_tail_valid;
        cmp rax, 0;
        je  workspace_rl_bad;
        lea r10, [rip + _wksp_table];
        mov r11, r12;
        imul r11, r11, 32;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 40;
        and rax, 0xFF;
        jmp workspace_rl_out;
      workspace_rl_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      workspace_rl_out:
        pop r12;
        ret
      }
    }

  pub let workspace_row_name_offset : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B8-02 (#2288): name_offset at body1[31:0]. Labels prefixed workspace_rno_.",
      block: {
        push r12;
        mov r12, rdi;
        call workspace_tail_valid;
        cmp rax, 0;
        je  workspace_rno_bad;
        lea r10, [rip + _wksp_table];
        mov r11, r12;
        imul r11, r11, 32;
        add r10, r11;
        mov rax, [r10 + 8];
        and rax, 0xFFFFFFFF;
        jmp workspace_rno_out;
      workspace_rno_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      workspace_rno_out:
        pop r12;
        ret
      }
    }

  pub let workspace_row_window_count : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B8-02 (#2288): window_count at body1[63:32]. Labels prefixed workspace_rwc_.",
      block: {
        push r12;
        mov r12, rdi;
        call workspace_tail_valid;
        cmp rax, 0;
        je  workspace_rwc_bad;
        lea r10, [rip + _wksp_table];
        mov r11, r12;
        imul r11, r11, 32;
        add r10, r11;
        mov rax, [r10 + 8];
        shr rax, 32;
        and rax, 0xFFFFFFFF;
        jmp workspace_rwc_out;
      workspace_rwc_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      workspace_rwc_out:
        pop r12;
