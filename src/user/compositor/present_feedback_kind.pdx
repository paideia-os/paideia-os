        lea r10, [rip + _pf_table];
        mov r11, r12;
        imul r11, r11, 48;
        add r10, r11;
        mov rax, [r10 + 8];
        and rax, 0xFFFFFFFF;
        jmp present_feedback_rsub_out;
      present_feedback_rsub_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      present_feedback_rsub_out:
        pop r12;
        ret
