  // present_feedback_find_by_surface(surface_kind_id) -> row_id | PF_ROW_NONE.
  // Uniqueness gate for mint; also usable by callers that hold a
  // surface_kind_id and want to locate the feedback row for it.
  pub let present_feedback_find_by_surface : (u64) -> u64 !{mem} @{} =
    fn (surface_kind_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-07 (#2297): linear scan for surface_kind_id in header[31:0] of every live row. Labels prefixed present_feedback_fbs_.",
      block: {
        push rbx;
        push r12;
        mov r12, rdi;
        xor rbx, rbx;
      present_feedback_fbs_scan:
        cmp rbx, 16;
        jae present_feedback_fbs_none;
        lea r10, [rip + _pf_table];
        mov r11, rbx;
        imul r11, r11, 48;
        add r10, r11;
        mov rax, [r10 + 0];
        mov r11, rax;
        shr r11, 56;
        cmp r11, 0;
        je  present_feedback_fbs_step;
        and rax, 0xFFFFFFFF;
        cmp rax, r12;
        jne present_feedback_fbs_step;
        mov rax, rbx;
        jmp present_feedback_fbs_out;
      present_feedback_fbs_step:
        add rbx, 1;
        jmp present_feedback_fbs_scan;
      present_feedback_fbs_none:
        mov rax, 0xFFFFEBD0;               // PF_ROW_NONE
      present_feedback_fbs_out:
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Section 11  present_feedback_mint / present_feedback_revoke
  // ==========================================================================
  //
  // present_feedback_mint(surface_kind_id, subscriber_kind_id)
  //     -> row_id | PF_MINT_* sentinel.
  //
  // Fresh row: last_present=0, last_vblank=0, refresh_period=0,
  // frame_count=0, last_classification=0 (PRESENT_ON_TIME by default
  // -- the in_use gate keeps this from being read as a live value
  // before the first _record_present bumps it).
  pub let present_feedback_mint : (u64, u64) -> u64 !{mem} @{} =
    fn (surface_kind_id: u64) (subscriber_kind_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-07 (#2297): mint one KIND_PRESENT_FEEDBACK row. Three callee-save pushes (rbx=surface_kind_id, r12=subscriber_kind_id then body1, r13=packed hdr) leave rsp%16==0 for every nested call -- no sub rsp,8, three pushes already align. Refusal funnel bumps _pf_stats[PF_ST_REFUSED] once at present_feedback_mb_refused. Labels prefixed present_feedback_mb_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                     // surface_kind_id
        mov r12, rsi;                     // subscriber_kind_id

        // (1) surface_kind_id nonzero + fits in u32.
        mov rdi, rbx;
        call present_feedback_surface_valid;
        cmp rax, 0;
        je  present_feedback_mb_bad_surface;

        // (2) subscriber_kind_id fits in u32 (zero OK).
        mov rdi, r12;
        call present_feedback_u32_valid;
        cmp rax, 0;
        je  present_feedback_mb_bad_subscriber;

        // (3) surface_kind_id uniqueness.
        mov rdi, rbx;
        call present_feedback_find_by_surface;
        mov r10, 0xFFFFEBD0;              // PF_ROW_NONE
        cmp rax, r10;
        jne present_feedback_mb_dup;

        // (4) Pack header = (surface_kind_id, classification=0).
        mov rdi, rbx;
        xor rsi, rsi;
        call present_feedback_hdr_pack;
        mov r13, rax;                     // r13 = hdr

        // Pack body1 = (subscriber_kind_id).
        mov rdi, r12;
        call present_feedback_body1_pack;
        mov r12, rax;                     // r12 = body1

        // tail_alloc(hdr, body1); body2..body5 zeroed by allocator.
        mov rdi, r13;                     // hdr
        mov rsi, r12;                     // body1
        call present_feedback_tail_alloc;

        mov r10, 16;
        cmp rax, r10;
        jae present_feedback_mb_enospc;   // rax already the sentinel

        // Success: bump mints, preserve row_id across the note call.
        mov rbx, rax;
        mov rdi, 0;                       // PF_ST_MINTS
        call present_feedback_note;
        mov rax, rbx;
        jmp present_feedback_mb_out;

      present_feedback_mb_bad_surface:
        mov rax, 0xFFFFEBDC;              // PF_MINT_BAD_SURFACE
        jmp present_feedback_mb_refused;
      present_feedback_mb_bad_subscriber:
        mov rax, 0xFFFFEBDB;              // PF_MINT_BAD_SUBSCRIBER
        jmp present_feedback_mb_refused;
      present_feedback_mb_dup:
        mov rax, 0xFFFFEBDD;              // PF_MINT_DUP
        jmp present_feedback_mb_refused;
      present_feedback_mb_enospc:
        // rax already PF_TAIL_ENOSPC (0xFFFFEBDF) from tail_alloc.

      present_feedback_mb_refused:
        mov rbx, rax;                     // stash sentinel
        mov rdi, 2;                       // PF_ST_REFUSED
        call present_feedback_note;
        mov rax, rbx;

      present_feedback_mb_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // present_feedback_revoke(row_id) -> 0 | PF_BAD_SLOT | PF_REVOKE_ALREADY.
  pub let present_feedback_revoke : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-07 (#2297): revoke one row. row_id >= PF_MAX -> PF_BAD_SLOT; not in_use -> PF_REVOKE_ALREADY; else free + bump revokes + return 0. Labels prefixed present_feedback_rev_.",
      block: {
        push r12;
        mov r12, rdi;

        mov r10, 16;
        cmp r12, r10;
        jae present_feedback_rev_bad_slot;

        mov rdi, r12;
        call present_feedback_tail_valid;
        cmp rax, 0;
        je  present_feedback_rev_already;

        mov rdi, r12;
        call present_feedback_tail_free;
        mov rdi, 1;                       // PF_ST_REVOKES
        call present_feedback_note;
        xor rax, rax;
        jmp present_feedback_rev_out;

      present_feedback_rev_bad_slot:
        mov rax, 0xFFFFEBD9;              // PF_BAD_SLOT
        jmp present_feedback_rev_out;
      present_feedback_rev_already:
        mov rax, 0xFFFFEBD8;              // PF_REVOKE_ALREADY

      present_feedback_rev_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Section 12  Latch primitives -- record_present / record_vblank
  // ==========================================================================
  //
  // present_feedback_record_present(row_id, present_nsec, classification)
  //     -> 0 | error.
  //
  // Latches (present_nsec, classification) into body2/header, then
  // bumps frame_count in body5. Refuses u64-overflow of frame_count
  // (never reachable in a real boot window; defence-in-depth belt).
  pub let present_feedback_record_present : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64) (present_nsec: u64) (classification: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-07 (#2297): record present. Four callee-save pushes (rbx=row_id, r12=present_nsec, r13=classification, r14=row base) = 32 bytes: entry rsp%16==8, +32+8=40, sub rsp,8 aligns to 48, %16==0 for nested calls. Writes header[47:40]=classification, body2=present_nsec, body5+=1. Labels prefixed present_feedback_rp_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        sub rsp, 8;

        mov rbx, rdi;                     // row_id
        mov r12, rsi;                     // present_nsec
        mov r13, rdx;                     // classification

        mov rdi, rbx;
        call present_feedback_tail_valid;
        cmp rax, 0;
        je  present_feedback_rp_bad_slot;

        mov rdi, r13;
        call present_feedback_classification_valid;
        cmp rax, 0;
        je  present_feedback_rp_bad_class;

        lea r10, [rip + _pf_table];
        mov r11, rbx;
        imul r11, r11, 48;
        add r10, r11;
        mov r14, r10;                     // r14 = row base

        // Rewrite header[47:40] = classification.
        mov rax, [r14 + 0];
        // Mask off the classification byte (bits 40..47).
        mov r10, 0xFF;
        shl r10, 40;
        not r10;
        and rax, r10;
        // OR in new classification (low 8 bits).
        mov r10, r13;
        and r10, 0xFF;
        shl r10, 40;
        or  rax, r10;
        mov [r14 + 0], rax;

        // body2 = present_nsec.
        mov [r14 + 16], r12;

        // body5 (frame_count) += 1. Overflow-guarded (u64 max).
        mov rax, [r14 + 40];
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  present_feedback_rp_ok;      // saturate at u64 max
        add rax, 1;
        mov [r14 + 40], rax;

      present_feedback_rp_ok:
        xor rax, rax;
        jmp present_feedback_rp_out;

      present_feedback_rp_bad_slot:
        mov rax, 0xFFFFEBD9;              // PF_BAD_SLOT
        jmp present_feedback_rp_out;
      present_feedback_rp_bad_class:
        mov rax, 0xFFFFEBDA;              // PF_MINT_BAD_CLASS

      present_feedback_rp_out:
        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // present_feedback_record_vblank(row_id, vblank_nsec, period)
  //     -> 0 | error.
  //
  // Latches (vblank_nsec, period) into body3/body4. Does NOT bump
  // frame_count (a vblank without a present is not a frame). Does
  // NOT touch classification -- the caller sets classification via
  // record_present. A stand-alone vblank record leaves the previous
  // present's classification intact (correct behaviour for the
  // "vblank arrived, no client redraw was pending" case).
  pub let present_feedback_record_vblank : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64) (vblank_nsec: u64) (period: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-07 (#2297): record vblank. Three callee-save pushes (rbx=row_id, r12=vblank_nsec, r13=period) leave rsp%16==0 for the nested tail_valid call. Writes body3=vblank_nsec, body4=period. Labels prefixed present_feedback_rvb_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                     // row_id
        mov r12, rsi;                     // vblank_nsec
        mov r13, rdx;                     // period

        mov rdi, rbx;
        call present_feedback_tail_valid;
        cmp rax, 0;
        je  present_feedback_rvb_bad_slot;

        lea r10, [rip + _pf_table];
        mov r11, rbx;
        imul r11, r11, 48;
        add r10, r11;

        // body3 = vblank_nsec, body4 = period.
        mov [r10 + 24], r12;
        mov [r10 + 32], r13;

        xor rax, rax;
        jmp present_feedback_rvb_out;

      present_feedback_rvb_bad_slot:
        mov rax, 0xFFFFEBD9;              // PF_BAD_SLOT

      present_feedback_rvb_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Section 13  Subscription primitives -- unsubscribe
  // ==========================================================================
  //
  // present_feedback_unsubscribe(row_id) -> 0 | error.
  //
  // Clears subscriber_kind_id (body1[31:0]) to 0. History (body2..body5)
  // preserved -- the row remains queryable but no client is bound.
  // A future landing that adds present_feedback_subscribe writes back
  // to body1[31:0] to reattach a client without touching the history.
  pub let present_feedback_unsubscribe : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-07 (#2297): clear subscriber slot. Two callee-save pushes (rbx=row_id, r12=row base) leave rsp%16==8; sub rsp,8 aligns for nested tail_valid. Refuses if already unsubscribed (subscriber == 0). Labels prefixed present_feedback_un_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        mov rbx, rdi;                     // row_id

        mov rdi, rbx;
        call present_feedback_tail_valid;
        cmp rax, 0;
        je  present_feedback_un_bad_slot;

        lea r10, [rip + _pf_table];
        mov r11, rbx;
        imul r11, r11, 48;
        add r10, r11;
        mov r12, r10;                     // r12 = row base

        // Check current subscriber; refuse if already zero.
        mov rax, [r12 + 8];
        mov r11, rax;
        shl r11, 32;
        shr r11, 32;
        cmp r11, 0;
        je  present_feedback_un_already;

        // Clear body1[31:0], preserve body1[63:32] (reserved, 0 today).
        mov r10, 0xFFFFFFFF;
        shl r10, 32;                      // 0xFFFFFFFF00000000
        and rax, r10;
        mov [r12 + 8], rax;

        xor rax, rax;
        jmp present_feedback_un_out;

      present_feedback_un_bad_slot:
        mov rax, 0xFFFFEBD9;              // PF_BAD_SLOT
        jmp present_feedback_un_out;
      present_feedback_un_already:
        mov rax, 0xFFFFEBD3;              // PF_UNSUB_ALREADY

      present_feedback_un_out:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Section 14  Bundled query -- present_feedback_query_last
  // ==========================================================================
  //
  // present_feedback_query_last(row_id, out_ptr) -> 0 | error.
  //
  // Writes 40 bytes at *out_ptr (5 u64 fields, little-endian):
  //   [+0]  last_present_nsec
  //   [+8]  last_vblank_nsec
  //   [+16] refresh_period_nsec
  //   [+24] last_classification (zero-extended to u64)
  //   [+32] frame_count
  //
  // Caller MUST provide a 40-byte writable buffer; alignment is not
  // required by the writes (all 8-byte stores) but 8-byte alignment
  // is recommended for cache locality. Bumps _pf_stats[PF_ST_QUERIES]
  // once per call.
  pub let present_feedback_query_last : (u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64) (out_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-07 (#2297): bundled query. Three callee-save pushes (rbx=row_id, r12=out_ptr, r13=row base) leave rsp%16==0 for nested tail_valid + note. Labels prefixed present_feedback_ql_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                     // row_id
        mov r12, rsi;                     // out_ptr

        mov rdi, rbx;
        call present_feedback_tail_valid;
        cmp rax, 0;
        je  present_feedback_ql_bad_slot;

        // Note the query.
        mov rdi, 3;                       // PF_ST_QUERIES
        call present_feedback_note;

        lea r10, [rip + _pf_table];
        mov r11, rbx;
        imul r11, r11, 48;
        add r10, r11;
        mov r13, r10;                     // r13 = row base

        // out[+0] = last_present_nsec (body2).
        mov rax, [r13 + 16];
        mov [r12 + 0], rax;
        // out[+8] = last_vblank_nsec (body3).
        mov rax, [r13 + 24];
        mov [r12 + 8], rax;
        // out[+16] = refresh_period_nsec (body4).
        mov rax, [r13 + 32];
        mov [r12 + 16], rax;
        // out[+24] = last_classification (header[47:40], zero-extend).
        mov rax, [r13 + 0];
        shr rax, 40;
        and rax, 0xFF;
        mov [r12 + 24], rax;
        // out[+32] = frame_count (body5).
        mov rax, [r13 + 40];
        mov [r12 + 32], rax;

        xor rax, rax;
        jmp present_feedback_ql_out;

      present_feedback_ql_bad_slot:
        mov rax, 0xFFFFEBD9;              // PF_BAD_SLOT

      present_feedback_ql_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Section 15  Enumeration
  // ==========================================================================
  //
  // present_feedback_enumerate_next(from_cursor) -> row_id | PF_ENUM_END.
  //
  // Iteration primitive over the row pool. Caller starts with
  // from_cursor == 0; on each hit, calls again with (row_id + 1).
  // Returns PF_ENUM_END (0xFFFFEBD2) when no more live rows. Skips
  // revoked rows. Bounded by PF_MAX (16); worst-case scan is O(PF_MAX)
  // per call.
  pub let present_feedback_enumerate_next : (u64) -> u64 !{mem} @{} =
    fn (from_cursor: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-07 (#2297): scan from row from_cursor to PF_MAX for the first live row. Returns PF_ENUM_END if past PF_MAX or no more live rows. Bumps _pf_stats[PF_ST_QUERIES] once per call. Two callee-save pushes + sub rsp,8 = 24 bytes: entry rsp%16==8, +16+8=24, %16==0 for the nested note call. Labels prefixed present_feedback_en_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;
        mov rbx, rdi;                     // cursor

        // Note the query.
        mov rdi, 3;                       // PF_ST_QUERIES
        call present_feedback_note;

      present_feedback_en_scan:
        cmp rbx, 16;
        jae present_feedback_en_end;
        lea r10, [rip + _pf_table];
        mov r11, rbx;
        imul r11, r11, 48;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        jne present_feedback_en_hit;
        add rbx, 1;
        jmp present_feedback_en_scan;

      present_feedback_en_hit:
        mov rax, rbx;
        jmp present_feedback_en_out;
      present_feedback_en_end:
        mov rax, 0xFFFFEBD2;              // PF_ENUM_END

      present_feedback_en_out:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Section 16  Boot init.
  // ==========================================================================

  pub let present_feedback_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-07 (#2297): call through to present_feedback_stats_reset for one clean pool + counter zero-out. Labels prefixed present_feedback_i_.",
      block: {
        call present_feedback_stats_reset;
        ret
      }
    }
}
