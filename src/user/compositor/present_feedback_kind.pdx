// src/user/compositor/present_feedback_kind.pdx -- Wave0-B9-07 (paideia-os #2297)
//
// KIND_PRESENT_FEEDBACK = 0x1DA, derived cap over KIND_SURFACE (0x1B8).
// Design authority: design/compositor/pwp-spec-vocabulary.md §2.12
// (KIND_PRESENT_FEEDBACK) + design/roadmap/next-wave-synthesis.md §4
// pitfall P6 ("presentation feedback is mandatory, not optional"). Row
// depends on G9.M1-001 (KIND_WORKSPACE, LANDED B8-02, 0x1D2), which
// established the 0x1D0..0x1DF derived-kind band and the compositor
// row-pool template this file mirrors.
//
// One KIND_PRESENT_FEEDBACK row names one per-surface feedback channel:
// the client subscribes against a specific KIND_SURFACE (parent slot
// = 0x1B8), the compositor records every present + every vblank tick
// on the surface's row, and the client polls the row for the last
// timing tuple. The channel is a *stream* in spec terms; this file
// lands the row-cap authority + latch primitives + query surface
// that the streaming layer (a future landing that wires the row
// into vk_present_feedback_channel notifications) is built on.
//
// Mandatory per pitfall P6: adaptive-rate presentation, missed-vsync
// detection, and back-pressure signalling in the client stack all
// need a feedback stream. Without this row every present is a black
// hole from the client's perspective, and the compositor's frame
// budget (one refresh period) has no observable back-pressure edge.
// The classifier (#2299) labels each present as ON-TIME (0), LATE (1),
// DROPPED (2), or VBLANK (3) against the refresh period budget; the
// classification enum is embedded in the row header so a query never
// has to touch body words to read it.
//
// This is a user-space module (svc-compositor process, ring 3). Not
// wired into `cap_table` / `cap_invoke_dispatch`; a future landing
// that promotes the authority into the kernel mirrors the
// `kind_color_profile.pdx` (0x18F) posture. Pattern parallel:
// src/user/compositor/workspace_kind.pdx (B8-02, KIND_WORKSPACE at
// 0x1D2) landed the same shape for a user-space derived cap with
// rights bitmask + row pool + mint factory + per-row query helpers +
// enumeration cursor. This landing widens the row from 32 bytes to
// 48 bytes to accommodate the two u64 timestamps + refresh period +
// frame counter that vocabulary §2.12 enumerates.
//
// =============================================================================
// SECTION 0  KIND_* SLOT ALLOCATION
// =============================================================================
//
// Consulted `design/architecture/next-wave-derived-kinds.md` + full
// grep over `src/**/*.pdx` at landing time. The 0x1D0..0x1DF band
// carries:
//   0x1D0   RESERVATION_HOLDER_KIND        (input server process cap)
//   0x1D1   RP_COMPOSITOR_KIND_FORWARD     (compositor process cap)
//   0x1D2   KIND_WORKSPACE                  (B8-02, LANDED)
//   0x1D3   KIND_A11Y_TREE                  (LANDED)
//   0x1D4   KIND_IME_SESSION                (LANDED)
//   0x1D5   KIND_UI_CONTEXT                 (LANDED)
//   0x1D6   KIND_SEAT                       (LANDED)
//   0x1D7   KIND_INPUT_ROUTE                (LANDED)
//   0x1D8   RESERVED (B9-05/06 landings)
//   0x1D9   RESERVED (B9-05/06 landings)
// This landing claims:
//   0x1DA   KIND_PRESENT_FEEDBACK           (B9-07, THIS FILE)
// leaving 0x1DB..0x1DF open for sibling B9/B10 compositor landings.
// Cross-verified by grep over `src/**/*.pdx` at landing time -- no
// live claim on 0x1DA (task brief B9-07 "grep-verify free").
//
// =============================================================================
// SECTION 1  DERIVATION OVER KIND_SURFACE (0x1B8)
// =============================================================================
//
// The vocabulary §2.12 lists KIND_IPC_ENDPOINT = 5 as the *transport*
// parent (the feedback stream flows as an IPC endpoint at the wire
// level). This landing takes KIND_SURFACE (0x1B8) as the *authority*
// parent per the Wave-0 B9-07 dispatch brief: one KIND_PRESENT_FEEDBACK
// row is minted per KIND_SURFACE, and the surface's row_id is the
// key the mint-time uniqueness check keys against. The two parents
// are complementary -- the surface parent gates who can mint the
// feedback row (only the surface's owner), while the IPC-endpoint
// parent gates who can subscribe to notifications on it.
//
// The mint gate below does NOT wire the kind-half check against
// KIND_SURFACE (there is no `cap_table` in user space); a future
// landing that promotes KIND_PRESENT_FEEDBACK into the kernel adds
// the `kind == KIND_SURFACE (0x1B8) carrying R_SURFACE_MINT` gate
// in front of `present_feedback_mint`. The row layout + latch
// primitives + query surface below stay unchanged across that
// promotion. PARENT_KIND below is the single reconciliation point
// (one-line edit) if B6-01's KIND_SURFACE slot ever moves off 0x1B8.
//
// =============================================================================
// SECTION 2  ROW LAYOUT -- 48 BYTES (SIX u64 WORDS)
// =============================================================================
//
//   [+0]   header:  in_use[63:56] | reserved[55:48] |
//                   last_classification[47:40] | reserved[39:32] |
//                   surface_kind_id[31:0]
//   [+8]   body1:   subscriber_kind_id[31:0] | reserved[63:32]
//   [+16]  body2:   last_present_nsec (u64, monotonic ns)
//   [+24]  body3:   last_vblank_nsec  (u64, monotonic ns)
//   [+32]  body4:   refresh_period_nsec (u64, e.g. 16666667 for 60Hz)
//   [+40]  body5:   frame_count (u64, total presents on this surface)
//
// surface_kind_id is caller-supplied at mint and MUST be nonzero +
// unique across live rows. Zero refused (PF_MINT_BAD_SURFACE); duplicate
// refused (PF_MINT_DUP). One feedback row per surface -- if a surface
// wants two subscribers, that is a compositor-level fan-out on top of
// this row's single subscriber slot, not two feedback rows.
//
// subscriber_kind_id is the client that receives feedback notifications
// on the stream. 0 = no active subscriber (the row exists but no client
// is bound). Zero at mint is legal (subscribe-later flow); zero after
// present_feedback_unsubscribe is the terminal state. last_present +
// last_vblank + refresh_period + frame_count are PRESERVED across an
// unsubscribe -- history stays queryable, only the notification target
// clears.
//
// last_classification is the u8 enum value from PresentClassification
// (0..3). Stored in header[47:40] so the row-field query for
// classification is one word load + shift + mask, no body access.
// Uninit rows have this at 0 (PRESENT_ON_TIME), but the in_use bit
// gates every read so the sentinel is never read by mistake.
//
// last_present_nsec and last_vblank_nsec are monotonic-ns timestamps
// from the compositor's clock (same clock the kernel's
// hw_timeline_wait/hw_timeline_signal effects consume). Zero at mint;
// bumped by present_feedback_record_present / _record_vblank. Value
// 0xFFFFFFFFFFFFFFFF is NEVER produced by the compositor's clock in
// any reachable boot window (584 years post-monotonic-epoch), so the
// pack functions can safely use it as a bad-arg sentinel.
//
// refresh_period_nsec is the display's vblank-to-vblank period. 60Hz
// = 16_666_667 ns; 120Hz = 8_333_333 ns; 240Hz = 4_166_667 ns; VRR
// panels update this on every vblank as the actual measured period.
// 0 at mint (unknown until first vblank recorded).
//
// frame_count is a monotonic u64 present counter, one bump per
// _record_present call. Refuses u64-overflow (would take 5e11 years
// at 60Hz; the refusal is a defence-in-depth belt rather than a
// hot code path). Read by client-side adaptive-rate policy (frame
// count delta over a wall-clock window = observed FPS).
//
// All slots stored little-endian. No float leaks into a timing cap
// per FPU-discipline (see `design/kernel/no-fpu.md`) -- the refresh
// period is an integer ns count so the sub-Hz precision Vulkan's
// f32 VkPresentModeInfoEXT loses is preserved here.
//
// =============================================================================
// SECTION 3  FAILURE TAXONOMY 0xFFFFEBD0..0xFFFFEBDF
// =============================================================================
//
// The Wave-0 B9-07 dispatch brief allocates 0xFFFFEBD0..0xFFFFEBDF.
// Repo-wide grep at landing time shows this page unclaimed:
//   0xFFFFEBD0..DF  FREE  <-- claimed here
// Adjacent claimed pages: 0xFFFFEBEA..EF (audit_journal_broker),
// 0xFFFFEBFA..FF (elevate_broker). PF_ROW_NONE sits at the page floor
// (0xFFFFEBD0) so a downstream diagnostic that greps for the
// "row lookup miss" sentinel finds it as its one canonical name.
//
// =============================================================================
// SECTION 4  PresentClassification ENUM
// =============================================================================
//
//   PRESENT_ON_TIME  = 0  -- present latched within the refresh budget.
//   PRESENT_LATE     = 1  -- present latched, but past the target vblank.
//   PRESENT_DROPPED  = 2  -- present dropped (buffer age exceeded budget).
//   PRESENT_VBLANK   = 3  -- vblank tick with no client present pending.
//
// Validated at record-time via present_feedback_classification_valid
// (rejects >3). Stored in header[47:40] so the row-field query never
// has to touch a body word to read the last classification.
//
// =============================================================================
// SECTION 5  present_feedback_mint FACTORY -- gate order
// =============================================================================
//
// Gate order (fail-fast; refusal funnel bumps _pf_stats[PF_ST_REFUSED]
// once):
//   (1) surface_kind_id nonzero + fits in u32     -> PF_MINT_BAD_SURFACE
//   (2) subscriber_kind_id fits in u32 (zero OK)  -> PF_MINT_BAD_SUBSCRIBER
//   (3) surface_kind_id uniqueness (scan live)    -> PF_MINT_DUP
//   (4) pack header/body1 + tail_alloc (zeroed body2..body5)
//
// Note (2) permits subscriber_kind_id == 0 -- the row exists in the
// "no subscriber" terminal state at mint, and a later subscribe op
// installs the subscriber. This is the shape a compositor-issued
// mint-at-surface-create wants (row exists so timing is always
// latched, subscriber attaches on the client's first read).

module PresentFeedbackKind = structure {

  pub let KIND_PRESENT_FEEDBACK : u64 = 0x1DA
  pub let PARENT_KIND           : u64 = 0x1B8   // KIND_SURFACE

  // Row pool. PF_MAX = 16 covers a heavy compositor session
  // (16 concurrent surfaces with timing feedback) without over-
  // committing .bss; a future landing that wants a higher ceiling
  // bumps this constant and re-derives _pf_table size.
  pub let PF_MAX       : u64 = 16
  pub let PF_ROW_BYTES : u64 = 48

  // PresentClassification enum values.
  pub let PRESENT_ON_TIME : u64 = 0
  pub let PRESENT_LATE    : u64 = 1
  pub let PRESENT_DROPPED : u64 = 2
  pub let PRESENT_VBLANK  : u64 = 3
  pub let PF_CLASS_MAX    : u64 = 3

  // Rights bitmask. RIGHT_SUBSCRIBE / RIGHT_QUERY_LAST /
  // RIGHT_UNSUBSCRIBE / R_PF_REVOKE occupy the low bits (subscribe /
  // read / mutate); R_PF_MINT and RIGHT_OBSERVE sit in the 0x200/0x400
  // slots that mirror the R_*_MINT / R_*_OBSERVE conventions every
  // other KIND_* file in this repo takes.
  pub let RIGHT_SUBSCRIBE   : u64 = 0x001
  pub let RIGHT_QUERY_LAST  : u64 = 0x002
  pub let RIGHT_UNSUBSCRIBE : u64 = 0x004
  pub let R_PF_REVOKE       : u64 = 0x008
  pub let R_PF_MINT         : u64 = 0x200
  pub let RIGHT_OBSERVE     : u64 = 0x400
  pub let R_PF_ALL          : u64 = 0x60F
     // 0x001|0x002|0x004|0x008|0x200|0x400 = 0x60F

  // Ops. Arity ONE (op_arg[63:8] REFUSED, mirroring window_kind /
  // workspace_kind conventions).
  pub let PF_OP_QUERY_SURFACE         : u64 = 0
  pub let PF_OP_QUERY_SUBSCRIBER      : u64 = 1
  pub let PF_OP_QUERY_LAST_PRESENT    : u64 = 2
  pub let PF_OP_QUERY_LAST_VBLANK     : u64 = 3
  pub let PF_OP_QUERY_REFRESH_PERIOD  : u64 = 4
  pub let PF_OP_QUERY_CLASSIFICATION  : u64 = 5
  pub let PF_OP_QUERY_FRAME_COUNT     : u64 = 6
  pub let PF_OP_RECORD_PRESENT        : u64 = 7
  pub let PF_OP_RECORD_VBLANK         : u64 = 8
  pub let PF_OP_UNSUBSCRIBE           : u64 = 9
  pub let PF_OP_ENUMERATE_NEXT        : u64 = 10
  pub let PF_OP_DEBUG_PRINT           : u64 = 11
  pub let PF_OP_MAX                   : u64 = 11

  // Failure taxonomy 0xFFFFEBD0..0xFFFFEBDF.
  pub let PF_OK                    : u64 = 0
  pub let PF_TAIL_ENOSPC           : u64 = 0xFFFFEBDF
  pub let PF_TAIL_BAD_ARG          : u64 = 0xFFFFEBDE
  pub let PF_MINT_DUP              : u64 = 0xFFFFEBDD
  pub let PF_MINT_BAD_SURFACE      : u64 = 0xFFFFEBDC
  pub let PF_MINT_BAD_SUBSCRIBER   : u64 = 0xFFFFEBDB
  pub let PF_MINT_BAD_CLASS        : u64 = 0xFFFFEBDA
  pub let PF_BAD_SLOT              : u64 = 0xFFFFEBD9
  pub let PF_REVOKE_ALREADY        : u64 = 0xFFFFEBD8
  pub let PF_UNSUP_OP              : u64 = 0xFFFFEBD7
  pub let PF_WRONG_KIND            : u64 = 0xFFFFEBD6
  pub let PF_BAD_SURFACE           : u64 = 0xFFFFEBD5
  pub let PF_BAD_SUBSCRIBER        : u64 = 0xFFFFEBD4
  pub let PF_UNSUB_ALREADY         : u64 = 0xFFFFEBD3
  pub let PF_ENUM_END              : u64 = 0xFFFFEBD2
  pub let PF_DECODE_BAD            : u64 = 0xFFFFEBD1
  pub let PF_ROW_NONE              : u64 = 0xFFFFEBD0

  pub let PF_U32_MAX : u64 = 0xFFFFFFFF

  // THE ONE STATE CELL. 16 rows * 48 bytes = 768 bytes = 96 u64.
  pub let mut _pf_table : [u64; 96] = uninit @align(64)
  pub let mut _pf_stats : [u64; 4]  = uninit @align(64)

  pub let PF_ST_MINTS     : u64 = 0
  pub let PF_ST_REVOKES   : u64 = 1
  pub let PF_ST_REFUSED   : u64 = 2
  pub let PF_ST_QUERIES   : u64 = 3

  // Fingerprint tag. Emitted by the compositor on successful mint
  // of a KIND_PRESENT_FEEDBACK cap. Legacy suffix gives grep parity
  // with pre-Wave0 boot-log tooling (see e.g. workspace_kind.pdx
  // pdx_kind_workspace_meta, reference_display_kind.pdx
  // rdk_mint_ok_msg).
  pub let pdx_kind_present_feedback_meta : [u8; 60] = "present_feedback mint ok [legacy: PRESENT FEEDBACK MINT OK]\0"

  // ==========================================================================
  // Section 6  Counter primitives.
  // ==========================================================================

  pub let present_feedback_stats_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-07 (#2297): clear row table + counters at boot. 16 rows * 6 u64 = 96 u64 for the table, 4 u64 for stats. Labels prefixed present_feedback_rs_.",
      block: {
        lea r10, [rip + _pf_table];
        xor rax, rax;
        xor rcx, rcx;
      present_feedback_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 96;
        jb  present_feedback_rs_rows;

        lea r10, [rip + _pf_stats];
        xor rcx, rcx;
      present_feedback_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  present_feedback_rs_stats;
        ret
      }
    }

  pub let present_feedback_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-07 (#2297): counter bump. Encoder-conservative load-inc-store; no add reg,[mem]. Labels prefixed present_feedback_nt_.",
      block: {
        cmp rdi, 4;
        jae present_feedback_nt_out;
        lea r10, [rip + _pf_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      present_feedback_nt_out:
        ret
      }
    }

  pub let present_feedback_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-07 (#2297): counter read. Labels prefixed present_feedback_st_.",
      block: {
        cmp rdi, 4;
        jae present_feedback_st_zero;
        lea r10, [rip + _pf_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      present_feedback_st_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Section 7  Validators.
  // ==========================================================================

  pub let present_feedback_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B9-07 (#2297): subset test against R_PF_ALL = 0x60F. Labels prefixed present_feedback_rv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x60F;
        and rax, r10;
        cmp rax, rdi;
        jne present_feedback_rv_no;
        mov rax, 1;
        ret;
      present_feedback_rv_no:
        xor rax, rax;
        ret
      }
    }

  // present_feedback_u32_valid: 1 iff v fits in 32 bits.
  pub let present_feedback_u32_valid : (u64) -> u64 !{} @{} =
    fn (v: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B9-07 (#2297): 1 iff v <= PF_U32_MAX. Labels prefixed present_feedback_uv_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  present_feedback_uv_no;
        mov rax, 1;
        ret;
      present_feedback_uv_no:
        xor rax, rax;
        ret
      }
    }

  // present_feedback_surface_valid: 1 iff surface_kind_id nonzero
  // AND fits in u32. Surface = 0 is refused (a KIND_SURFACE cap
  // with row_id 0 does not name a live surface in this compositor's
  // model). Used by mint to gate PF_MINT_BAD_SURFACE.
  pub let present_feedback_surface_valid : (u64) -> u64 !{} @{} =
    fn (surface_kind_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B9-07 (#2297): 1 iff surface_kind_id in (0, 2^32). Zero is refused (no live surface has row_id 0). Labels prefixed present_feedback_sv_.",
      block: {
        cmp rdi, 0;
        je  present_feedback_sv_no;
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  present_feedback_sv_no;
        mov rax, 1;
        ret;
      present_feedback_sv_no:
        xor rax, rax;
        ret
      }
    }

  // present_feedback_classification_valid: 1 iff class in 0..3.
  pub let present_feedback_classification_valid : (u64) -> u64 !{} @{} =
    fn (class: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B9-07 (#2297): 1 iff class <= 3 (PF_CLASS_MAX). Labels prefixed present_feedback_cv_.",
      block: {
        cmp rdi, 3;
        ja  present_feedback_cv_no;
        mov rax, 1;
        ret;
      present_feedback_cv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Section 8  Packers.
  // ==========================================================================

  // header: in_use[63:56] | reserved[55:48] | last_classification[47:40] |
  //         reserved[39:32] | surface_kind_id[31:0].
  // Emitted WITHOUT in_use bit set; tail_alloc ORs it in.
  pub let present_feedback_hdr_pack : (u64, u64) -> u64 !{} @{} =
    fn (surface_kind_id: u64) (last_classification: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B9-07 (#2297): header pack. surface_kind_id at [31:0], last_classification at [47:40]. surface must be nonzero + <=u32 (present_feedback_surface_valid). classification must be <=3 (present_feedback_classification_valid). Bad arg -> 0xFFFFFFFFFFFFFFFF sentinel (tail_alloc catches). Labels prefixed present_feedback_hp_.",
      block: {
        cmp rdi, 0;
        je  present_feedback_hp_bad;
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  present_feedback_hp_bad;
        cmp rsi, 3;
        ja  present_feedback_hp_bad;
        mov rax, rdi;
        and rax, 0xFFFFFFFF;
        mov r10, rsi;
        and r10, 0xFF;
        shl r10, 40;
        or  rax, r10;
        ret;
      present_feedback_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // body1: subscriber_kind_id[31:0] | reserved[63:32].
  // subscriber = 0 is legal (no subscriber terminal state).
  pub let present_feedback_body1_pack : (u64) -> u64 !{} @{} =
    fn (subscriber_kind_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B9-07 (#2297): body1 pack. Only low 32 bits of subscriber_kind_id used; upper 32 reserved. Zero is legal. Labels prefixed present_feedback_b1_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  present_feedback_b1_bad;
        mov rax, rdi;
        and rax, 0xFFFFFFFF;
        ret;
      present_feedback_b1_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // Section 9  Row pool: valid / alloc / free.
  // ==========================================================================

  pub let present_feedback_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-07 (#2297): 1 iff row_id < PF_MAX and in_use. Row stride 48 bytes. Labels prefixed present_feedback_tv_.",
      block: {
        cmp rdi, 16;
        jae present_feedback_tv_no;
        lea r10, [rip + _pf_table];
        mov r11, rdi;
        imul r11, r11, 48;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  present_feedback_tv_no;
        mov rax, 1;
        ret;
      present_feedback_tv_no:
        xor rax, rax;
        ret
      }
    }

  // present_feedback_tail_alloc(hdr, body1) -> row_id | err.
  // Low-first scan over 16 rows. Header stamped with in_use bit
  // (bit 56) here so callers pass an "unset in_use" packed header.
  // body2..body5 are zeroed (fresh row: last_present=0, last_vblank=0,
  // refresh_period=0, frame_count=0).
  pub let present_feedback_tail_alloc : (u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (body1: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-07 (#2297): claim one KIND_PRESENT_FEEDBACK row. Low-first scan (rbx=idx) over 16 rows of 48 bytes (idx*48 via imul). On claim: OR the 1<<56 in_use marker into hdr and store six u64 words (body2..body5 zero). Refuses when hdr already has the in_use bit set (caller passed a stamped hdr in error) or when hdr/body1 is the bad-arg sentinel. Three callee-save pushes (rbx=idx, r12=hdr, r13=body1) leave rsp%16==0 -- no nested calls, so no sub rsp,8 needed. Labels prefixed present_feedback_ta_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rdi;
        mov r13, rsi;

        // Refuse a hdr that already has in_use set (caller error).
        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne present_feedback_ta_bad;
        // Refuse the bad-arg sentinel from either packer.
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp r12, r10;
        je  present_feedback_ta_bad;
        cmp r13, r10;
        je  present_feedback_ta_bad;

        xor rbx, rbx;
      present_feedback_ta_scan:
        cmp rbx, 16;
        jae present_feedback_ta_enospc;
        lea r10, [rip + _pf_table];
        mov r11, rbx;
        imul r11, r11, 48;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  present_feedback_ta_claim;
        add rbx, 1;
        jmp present_feedback_ta_scan;

      present_feedback_ta_claim:
        mov rax, r12;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r13;
        xor rax, rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        mov [r10 + 32], rax;
        mov [r10 + 40], rax;
        mov rax, rbx;
        jmp present_feedback_ta_out;

      present_feedback_ta_enospc:
        mov rax, 0xFFFFEBDF;
        jmp present_feedback_ta_out;
      present_feedback_ta_bad:
        mov rax, 0xFFFFEBDE;

      present_feedback_ta_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let present_feedback_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-07 (#2297): scrub one row (all six words). Labels prefixed present_feedback_tf_.",
      block: {
        cmp rdi, 16;
        jae present_feedback_tf_out;
        lea r10, [rip + _pf_table];
        mov r11, rdi;
        imul r11, r11, 48;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        mov [r10 + 32], rax;
        mov [r10 + 40], rax;
      present_feedback_tf_out:
        ret
      }
    }

  // ==========================================================================
  // Section 10  Row-field query helpers.
  // ==========================================================================

  pub let present_feedback_row_surface : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-07 (#2297): surface_kind_id at header[31:0]. Labels prefixed present_feedback_rs2_.",
      block: {
        push r12;
        mov r12, rdi;
        call present_feedback_tail_valid;
        cmp rax, 0;
        je  present_feedback_rs2_bad;
        lea r10, [rip + _pf_table];
        mov r11, r12;
        imul r11, r11, 48;
        add r10, r11;
        mov rax, [r10 + 0];
        and rax, 0xFFFFFFFF;
        jmp present_feedback_rs2_out;
      present_feedback_rs2_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      present_feedback_rs2_out:
        pop r12;
        ret
      }
    }

