// src/user/compositor/subsurface_sync.pdx -- Wave0-B7-01 (paideia-os #2258)
// G7.M3-003. Subsurface synchronisation modes (sync / desync) attached
// to a subsurface-tree EDGE.
//
// Design authority:
//   design/compositor/pwp-spec-vocabulary.md §2.3 KIND_SUBSURFACE
//     ("Sync mode (sync / desync) is stored on the edge; sync-mode
//      subsurfaces commit atomically with the parent's
//      KIND_SURFACE_COMMIT, desync subsurfaces commit independently.
//      Backs both video overlays (desync -- commit at frame cadence)
//      and toolkit-level compositing regions (sync -- commit at UI-
//      frame cadence).")
//   design/compositor/pwp-spec-vocabulary.md §2.6 tree edges
//   design/architecture/next-wave-derived-kinds.md (slot registry)
//
// Sibling / predecessor landings in this batch band:
//   surface_kind.pdx           -- KIND_SURFACE          = 0x1B8 (B6-01)
//   surface_commit.pdx         -- KIND_SURFACE_COMMIT   = 0x1B9 (B6-02)
//   surface_geometry.pdx       -- value record, no kind        (B6-03)
//   surface_buffer_bind.pdx    -- value record, no kind        (B6-04)
//   window_kind.pdx            -- KIND_WINDOW           = 0x1C1 (B6-05)
//   layer_tree.pdx             -- KIND_LAYER_TREE       = 0x1C2 (B6-06)
//   xdg_shell_states.pdx       -- KIND_XDG_TOPLEVEL_STATE=0x1C4 (B6-07)
//
// =============================================================================
// SECTION 0  WHY THIS KIND EXISTS  (SEPARATE FROM KIND_SURFACE)
// =============================================================================
//
// KIND_SURFACE is the composition primitive. A subsurface is a CHILD
// surface embedded at a fixed position inside a parent's coordinate
// space. Every subsurface is itself a KIND_SURFACE (so it can be
// buffer-attached, damage-annotated, and committed on its own); the
// EXTRA the subsurface relationship carries is:
//
//   * the (parent_surface_kind_id, child_surface_kind_id) edge --
//     which surface hangs off which surface,
//   * the (x, y) offset in the parent's coordinate space,
//   * the SYNC MODE: whether the child's own commits go live
//     immediately (desync) or ride the parent's next commit (sync).
//
// Splitting this "edge state" off KIND_SURFACE keeps the surface row
// narrow -- a client that never embeds a child surface holds a bare
// KIND_SURFACE and never mints a KIND_SUBSURFACE edge. Clients that
// DO embed children mint one KIND_SUBSURFACE per edge; the compositor
// walks the edge set at parent-commit time to fold in sync-mode
// children and leaves desync children to commit on their own cadence.
//
// The SYNC / DESYNC distinction is load-bearing for two very different
// workloads that both share the "composite a child region into a
// parent" shape:
//
//   * TOOLKIT WIDGETS (sync). A GTK-style widget tree renders its own
//     window's chrome + content into ONE toplevel surface. Any inner
//     region that has been extracted into a subsurface (a scrollable
//     list backed by a GPU texture, say) MUST commit atomically with
//     its parent, or the user sees a scrollbar out of sync with the
//     list content it labels for one frame. Sync mode names this:
//     the compositor buffers the child's commit and applies it in the
//     same atomic step as the parent's.
//
//   * VIDEO / GAME OVERLAYS (desync). A media player's decoded-video
//     surface publishes frames at its own cadence (24 / 30 / 60 fps)
//     that has nothing to do with the parent chrome's redraw cadence.
//     Forcing the video surface to commit at UI cadence would drop
//     video frames whenever the toolkit is idle, and forcing the
//     toolkit to commit at video cadence would spend CPU redrawing
//     chrome that has not changed. Desync mode names this: the child
//     commits independently and the compositor blits the freshest
//     available frame into the parent's next composed image.
//
// The mode LIVES ON THE EDGE (not on the child KIND_SURFACE) because
// the same child surface, if re-parented, may want a different sync
// posture in its new home; naming the mode on the edge lets a
// re-parent op change the mode implicitly with the parent choice
// rather than requiring a second op.
//
// =============================================================================
// SECTION 1  KIND_* SLOT ALLOCATION -- KIND_SUBSURFACE = 0x1BA
// =============================================================================
//
// Consulted design/architecture/next-wave-derived-kinds.md and the
// batch-6 window_kind.pdx registry-block comment. Batch-6 landings
// consumed 0x1B8 (KIND_SURFACE), 0x1B9 (KIND_SURFACE_COMMIT), 0x1C1
// (KIND_WINDOW), 0x1C2 (KIND_LAYER_TREE), and 0x1C4
// (KIND_XDG_TOPLEVEL_STATE). Slot 0x1BA was reserved in the window_
// kind.pdx registry comment as "surface geometry" but the
// surface_geometry.pdx landing chose to be a value record with NO
// KIND_ID (its module-header explains: "It is NOT a capability kind:
// no KIND_ID, no RIGHT_MINT gate, no cap_handler_* dispatch"). So
// slot 0x1BA is unclaimed at grep time:
//
//   $ grep -rn "= 0x1BA" src/                        # empty
//   $ grep -rn "KIND_SUBSURFACE.*=.*0x" src/         # empty
//
// This landing claims 0x1BA for KIND_SUBSURFACE. Adjacent to
// KIND_SURFACE (0x1B8) and KIND_SURFACE_COMMIT (0x1B9) so a reader
// grepping the compositor band lands on all three in one pass. The
// buffer-attach / geometry helpers (B6-03, B6-04) sit as value
// records without KIND_IDs and do not occupy the numeric registry.
//
// =============================================================================
// SECTION 2  DERIVATION OVER KIND_SURFACE
// =============================================================================
//
// The mint gate demands `kind == KIND_SURFACE (0x1B8)` on the parent
// cap AND `RIGHT_MINT` on that parent. The parent surface is the one
// the edge hangs the child off; the child surface is a SEPARATE
// KIND_SURFACE cap the client already holds (a subsurface edge does
// not itself mint a child KIND_SURFACE -- the caller mints the child
// via the normal surface path, then binds it into the parent via
// this edge).
//
// External clients hold {R_SS_READ, R_SS_SET_POSITION,
// R_SS_SET_SYNC_MODE, R_SS_QUERY_MODE}. R_SS_REPARENT is
// compositor-internal (the compositor is the only authority that can
// move a subsurface between parents, per the spec §2.3 "upgrade to
// KIND_WINDOW is a distinct mint" discipline that keeps re-parenting
// off the client path).
//
// =============================================================================
// SECTION 3  SubsurfaceEdge RECORD LAYOUT -- 32 BYTES / 4 u64 WORDS
// =============================================================================
//
// One SubsurfaceEdge per live edge. Layout:
//
//   [+0]  word0:  parent_surface_kind_id[31:0] | child_surface_kind_id[63:32]
//   [+8]  word1:  x[31:0] (i32)                | y[63:32] (i32)
//   [+16] word2:  sync_mode[7:0] | in_use[15:8] | reserved[63:16]
//   [+24] word3:  edge_seq (u64, monotonic on any position/mode change)
//
// Total: 32 bytes. Alignment: 8. The in_use byte at word2[15:8] is
// how the edge pool distinguishes free vs claimed slots at scan
// time; a caller who reaches into the record from outside the pool
// (e.g. via subsurface_edge_is_sync on a stack-allocated edge)
// leaves in_use zero and the predicate still functions since it
// only reads word2[7:0].
//
// Fields:
//   parent_surface_kind_id: u32   -- KIND_SURFACE cap id of the parent
//                                    surface (must equal 0x1B8-typed).
//   child_surface_kind_id: u32    -- KIND_SURFACE cap id of the child
//                                    surface (also 0x1B8-typed).
//   x, y: i32                     -- child's origin in parent's coord
//                                    space. Signed so a child that
//                                    hangs off-viewport (e.g. a menu
//                                    that opens above its anchor) can
//                                    name a negative origin without a
//                                    second sentinel.
//   sync_mode: u8                 -- SS_MODE_SYNC (0) or SS_MODE_DESYNC (1);
//                                    any other value refused at mint.
//   in_use: u8                    -- 1 iff this pool slot is claimed.
//   edge_seq: u64                 -- monotone, bumped on any op that
//                                    changes position or sync mode
//                                    (a subsequent landing wires the
//                                    setter; the factory here stamps
//                                    edge_seq = 1 at mint).
//
// =============================================================================
// SECTION 4  SYNC MODE ENUM
// =============================================================================
//
//   SS_MODE_SYNC     = 0   -- child commit rides the parent's next
//                             KIND_SURFACE_COMMIT (atomic with parent)
//   SS_MODE_DESYNC   = 1   -- child commit goes live immediately, on
//                             its own cadence
//
// Any value > 1 (low byte) is refused by subsurface_edge_new with
// SS_BAD_MODE. Wider arguments are masked to the low byte at pack
// time; a caller who passes "u64 all-ones as not-yet-populated"
// trips the guard rather than silently packing garbage.
//
// =============================================================================
// SECTION 5  FAILURE TAXONOMY 0xFFFFEA20..0xFFFFEA2F
// =============================================================================
//
// A repo-wide grep at landing time showed the 0xFFFFEA20..0xFFFFEA2F
// page free (clipboard owns 0xFFFFEA30..3F, layer_tree owns
// 0xFFFFEA40..4F, reference_display owns 0xFFFFEA50..5F; the 0x00..2F
// pages below clipboard are unclaimed). A fresh page here keeps
// grep lookups clean and leaves 0xFFFFEA00..0xFFFFEA1F open for
// further compositor primitives.
//
//   0xFFFFEA20  SS_OK             (named sentinel; same value as 0)
//   0xFFFFEA2F  SS_TAIL_ENOSPC    (edge pool exhausted at mint)
//   0xFFFFEA2E  SS_TAIL_BAD_ARG   (dispatcher arg smuggling; reserved)
//   0xFFFFEA2D  SS_MINT_BAD_PARENT  (parent_surface_kind_id == 0)
//   0xFFFFEA2C  SS_MINT_BAD_CHILD   (child_surface_kind_id == 0)
//   0xFFFFEA2B  SS_MINT_BAD_SELF    (parent == child)
//   0xFFFFEA2A  SS_BAD_MODE         (sync_mode not in {0, 1})
//   0xFFFFEA29  SS_BAD_SLOT         (slot id out of range)
//   0xFFFFEA28  SS_WRONG_KIND       (dispatcher: cap not KIND_SUBSURFACE)
//   0xFFFFEA27  SS_MINT_BAD_RIGHTS  (rights subset of R_SS_ALL violated)
//   0xFFFFEA26  SS_REVOKE_ALREADY   (double-revoke; reserved)
//   0xFFFFEA25  SS_UNSUP_OP         (dispatcher: unknown op)
//
// =============================================================================
// SECTION 6  LABEL PREFIX + ENCODER DISCIPLINE
// =============================================================================
//
// LABEL PREFIX: `subsurface_sync_` per task directive. All ASM jump
// targets are `subsurface_sync_<funcname>_<tag>`. This avoids the
// paideia-as reserved-word list (loop, if, etc.) per feedback_
// paideia_as_reserved_labels and keeps the label namespace private
// to this module.
//
// ENCODER-CONSERVATIVE:
//   * NO `add reg, [mem]` -- counter bumps use load / add reg,imm /
//     store idiom (see edge_seq stamp in subsurface_edge_new).
//   * NO `test` -- every zero/subset test uses `cmp reg, 0` /
//     `cmp reg, reg`.
//   * Every ASM block declares SysV callee-save discipline in its
//     justification.
//
// =============================================================================
// SECTION 7  FINGERPRINT
// =============================================================================
//
// ONE tag ending [legacy: ... OK] per softarch discipline. Data-only
// at THIS landing (mint dispatcher lands as a G7-M3-003 follow-on);
// needs allowlisting in tools/verify-fingerprint-coverage.sh with
// reason "subsurface_sync mint dispatcher not yet landed (Wave0-B7-01)".
// Allowlist wire-up is a separate landing per the batch's file-touch
// discipline (this landing is ONE file only).

module SubsurfaceSync = structure {

  // ==========================================================================
  // SECTION A  Identity + parent kind + rights.
  // ==========================================================================

  pub let KIND_SUBSURFACE          : u64 = 0x1BA
  pub let SS_PARENT_KIND_SURFACE   : u64 = 0x1B8    // Wave0-B6-01 sibling.
  pub let SS_CHILD_KIND_SURFACE    : u64 = 0x1B8    // child is also KIND_SURFACE.

  // Rights bit layout mirrors layer_tree.pdx / window_kind.pdx
  // conventions. R_SS_REPARENT is compositor-internal (never handed
  // out to a client cap); the mint gate rejects a rights word that
  // requests R_SS_REPARENT from an unauthorised holder in a follow-
  // on dispatcher landing.
  pub let R_SS_READ            : u64 = 0x001
  pub let R_SS_INVOKE          : u64 = 0x008
  pub let R_SS_REVOKE          : u64 = 0x010
  pub let R_SS_SET_POSITION    : u64 = 0x100
  pub let R_SS_MINT            : u64 = 0x200        // never handed out.
  pub let R_SS_SET_SYNC_MODE   : u64 = 0x400
  pub let R_SS_QUERY_MODE      : u64 = 0x800
  pub let R_SS_REPARENT        : u64 = 0x1000       // compositor-internal.
  pub let R_SS_ALL             : u64 = 0x1F19       // 0x001|0x008|0x010|0x100|0x200|0x400|0x800|0x1000

  // Sync mode enum (§4).
  pub let SS_MODE_SYNC         : u64 = 0
  pub let SS_MODE_DESYNC       : u64 = 1
  pub let SS_MODE_MAX          : u64 = 1            // inclusive upper bound.

  // Record + pool sizing.
  pub let SS_EDGE_BYTES        : u64 = 32           // one SubsurfaceEdge.
  pub let SS_MAX               : u64 = 8            // small pool at this landing.
  pub let SS_POOL_BYTES        : u64 = 256          // 8 * 32.
  pub let SS_POOL_WORDS        : u64 = 32           // 256 / 8.

  // Byte offsets within one SubsurfaceEdge (§3).
  pub let SS_OFF_PARENT_CHILD  : u64 = 0    // parent_kind_id[31:0] | child_kind_id[63:32]
  pub let SS_OFF_XY            : u64 = 8    // x[31:0]              | y[63:32]
  pub let SS_OFF_MODE_INUSE    : u64 = 16   // mode[7:0] | in_use[15:8] | reserved[63:16]
  pub let SS_OFF_EDGE_SEQ      : u64 = 24   // edge_seq (u64)

  // Failure taxonomy (§5).
  pub let SS_OK                    : u64 = 0
  pub let SS_TAIL_ENOSPC           : u64 = 0xFFFFEA2F
  pub let SS_TAIL_BAD_ARG          : u64 = 0xFFFFEA2E
  pub let SS_MINT_BAD_PARENT       : u64 = 0xFFFFEA2D
  pub let SS_MINT_BAD_CHILD        : u64 = 0xFFFFEA2C
  pub let SS_MINT_BAD_SELF         : u64 = 0xFFFFEA2B
  pub let SS_BAD_MODE              : u64 = 0xFFFFEA2A
  pub let SS_BAD_SLOT              : u64 = 0xFFFFEA29
  pub let SS_WRONG_KIND            : u64 = 0xFFFFEA28
  pub let SS_MINT_BAD_RIGHTS       : u64 = 0xFFFFEA27
  pub let SS_REVOKE_ALREADY        : u64 = 0xFFFFEA26
  pub let SS_UNSUP_OP              : u64 = 0xFFFFEA25

  // ==========================================================================
  // SECTION B  State cells.
  // ==========================================================================

  // SubsurfaceEdge pool. SS_MAX * SS_EDGE_BYTES = 8 * 32 = 256 bytes
  // = 32 u64 words. Each 32-byte slot backs one live edge. A slot
  // is free iff word2[15:8] (in_use) == 0.
  pub let mut _subsurface_edges : [u64; 32] = uninit @align(64)

  // ==========================================================================
  // SECTION C  Validators.
  // ==========================================================================

  // subsurface_sync_rights_valid(r) -> 1 iff r subset of R_SS_ALL.
  // The mint gate uses this to reject rights bits outside the
  // canonical set (in particular any bit past R_SS_REPARENT).
  pub let subsurface_sync_rights_valid : (u64) -> u64 !{} @{} =
    fn (r: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B7-01 (paideia-os #2258): subset test against R_SS_ALL = 0x1F19. Leaf, no callee-save discipline needed. Uses cmp (not test) per encoder discipline. Labels prefixed subsurface_sync_.",
      block: {
        mov rax, rdi;
        mov r10, 0x1F19;
        and rax, r10;
        cmp rax, rdi;
        jne subsurface_sync_rv_no;
        mov rax, 1;
        ret;
      subsurface_sync_rv_no:
        xor rax, rax;
        ret
      }
    }

  // subsurface_sync_mode_valid(m) -> 1 iff (m & 0xFF) in {0, 1}.
  // Wider bits are masked so a caller who passes "u64 all-ones as
  // not-yet-populated" trips the guard rather than silently packing
  // 0xFF into the low byte.
  pub let subsurface_sync_mode_valid : (u64) -> u64 !{} @{} =
    fn (m: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B7-01 (paideia-os #2258): mask low u8, compare against SS_MODE_MAX(1). Leaf. Labels prefixed subsurface_sync_.",
      block: {
        mov rax, rdi;
        mov r10, 0xFF;
        and rax, r10;
        mov r10, 1;
        cmp rax, r10;
        ja  subsurface_sync_mv_no;
        mov rax, 1;
        ret;
      subsurface_sync_mv_no:
        xor rax, rax;
        ret
      }
    }

  // subsurface_sync_slot_valid(s) -> 1 iff s < SS_MAX(8).
  pub let subsurface_sync_slot_valid : (u64) -> u64 !{} @{} =
    fn (s: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B7-01 (paideia-os #2258): bounds check against SS_MAX(8). Leaf. Labels prefixed subsurface_sync_.",
      block: {
        mov r10, 8;
        cmp rdi, r10;
        jae subsurface_sync_sv_no;
        mov rax, 1;
        ret;
      subsurface_sync_sv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // SECTION D  Slot address arithmetic.
  //
  // Slot base pointer = _subsurface_edges + slot_id * SS_EDGE_BYTES(32)
  //                   = _subsurface_edges + slot_id * 32.
  // Slot shift = 5 (since 32 = 1 << 5); a single shl / add resolves.
  // ==========================================================================

  // subsurface_sync_slot_addr(slot_id) -> ptr | 0 on OOB.
  pub let subsurface_sync_slot_addr : (u64) -> u64 !{mem} @{} =
    fn (slot_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B7-01 (paideia-os #2258): slot base = _subsurface_edges + slot_id * 32. Bounds-checked against SS_MAX(8); OOB returns 0 (caller compares against zero before dereferencing). Leaf; no nested call; no callee-save discipline. Labels prefixed subsurface_sync_.",
      block: {
        mov r10, 8;
        cmp rdi, r10;
        jae subsurface_sync_sa_no;
        lea r10, [rip + _subsurface_edges];
        mov r11, rdi;
        shl r11, 5;                      // slot_id * 32
        add r10, r11;
        mov rax, r10;
        ret;
      subsurface_sync_sa_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // SECTION E  Field readers (pointer-based).
  //
  // Every reader takes an edge pointer and returns the requested field
  // zero-extended into rax. All readers are pure -- no writes -- and
  // safe to call from a walk callback. A null pointer returns 0.
  // ==========================================================================

  // subsurface_edge_parent_kind_id(edge_ptr) -> u32-in-u64 | 0 on null.
  pub let subsurface_edge_parent_kind_id : (u64) -> u64 !{mem} @{} =
    fn (edge_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B7-01 (paideia-os #2258): read parent_surface_kind_id from word0[31:0]. Null pointer -> 0. Leaf. Labels prefixed subsurface_sync_.",
      block: {
        cmp rdi, 0;
        je  subsurface_sync_pk_zero;
        mov rax, [rdi + 0];
        mov r10, 0xFFFFFFFF;
        and rax, r10;
        ret;
      subsurface_sync_pk_zero:
        xor rax, rax;
        ret
      }
    }

  // subsurface_edge_child_kind_id(edge_ptr) -> u32-in-u64 | 0 on null.
  pub let subsurface_edge_child_kind_id : (u64) -> u64 !{mem} @{} =
    fn (edge_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B7-01 (paideia-os #2258): read child_surface_kind_id from word0[63:32]. Null pointer -> 0. Leaf. Labels prefixed subsurface_sync_.",
      block: {
        cmp rdi, 0;
        je  subsurface_sync_ck_zero;
        mov rax, [rdi + 0];
        shr rax, 32;
        ret;
      subsurface_sync_ck_zero:
        xor rax, rax;
        ret
      }
    }

  // subsurface_edge_x(edge_ptr) -> low-u32 of word1 | 0 on null.
  // The field is i32 semantically; the low-u32 is returned zero-
  // extended and the caller re-interprets as signed if needed.
  pub let subsurface_edge_x : (u64) -> u64 !{mem} @{} =
    fn (edge_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B7-01 (paideia-os #2258): read x from word1[31:0]. Field is i32 semantically; caller reinterprets. Null pointer -> 0. Leaf. Labels prefixed subsurface_sync_.",
      block: {
        cmp rdi, 0;
        je  subsurface_sync_x_zero;
        mov rax, [rdi + 8];
        mov r10, 0xFFFFFFFF;
        and rax, r10;
        ret;
      subsurface_sync_x_zero:
        xor rax, rax;
        ret
      }
    }

  // subsurface_edge_y(edge_ptr) -> high-u32 of word1 | 0 on null.
  pub let subsurface_edge_y : (u64) -> u64 !{mem} @{} =
    fn (edge_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B7-01 (paideia-os #2258): read y from word1[63:32]. Null pointer -> 0. Leaf. Labels prefixed subsurface_sync_.",
      block: {
        cmp rdi, 0;
        je  subsurface_sync_y_zero;
        mov rax, [rdi + 8];
        shr rax, 32;
        ret;
      subsurface_sync_y_zero:
        xor rax, rax;
        ret
      }
    }

  // subsurface_edge_sync_mode(edge_ptr) -> u8-in-u64 | 0 on null.
  pub let subsurface_edge_sync_mode : (u64) -> u64 !{mem} @{} =
    fn (edge_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B7-01 (paideia-os #2258): read sync_mode from word2[7:0]. Null pointer -> 0 (SS_MODE_SYNC, the safest default). Leaf. Labels prefixed subsurface_sync_.",
      block: {
        cmp rdi, 0;
        je  subsurface_sync_sm_zero;
        mov rax, [rdi + 16];
        mov r10, 0xFF;
        and rax, r10;
        ret;
      subsurface_sync_sm_zero:
        xor rax, rax;
        ret
      }
    }

  // subsurface_edge_in_use(edge_ptr) -> u8-in-u64 | 0 on null.
  pub let subsurface_edge_in_use : (u64) -> u64 !{mem} @{} =
    fn (edge_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B7-01 (paideia-os #2258): read in_use from word2[15:8]. Null pointer -> 0 (a null slot is trivially not in use). Leaf. Labels prefixed subsurface_sync_.",
      block: {
        cmp rdi, 0;
        je  subsurface_sync_iu_zero;
        mov rax, [rdi + 16];
        shr rax, 8;
        mov r10, 0xFF;
        and rax, r10;
        ret;
      subsurface_sync_iu_zero:
        xor rax, rax;
        ret
      }
    }

  // subsurface_edge_seq(edge_ptr) -> full u64 | 0 on null.
  pub let subsurface_edge_seq : (u64) -> u64 !{mem} @{} =
    fn (edge_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B7-01 (paideia-os #2258): read edge_seq (full u64) from word3 at [+24]. Null pointer -> 0. Leaf. Labels prefixed subsurface_sync_.",
      block: {
        cmp rdi, 0;
        je  subsurface_sync_es_zero;
        mov rax, [rdi + 24];
        ret;
      subsurface_sync_es_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // SECTION F  The is_sync predicate.
  //
  // subsurface_edge_is_sync(&e) -> bool.
  //
  // Returns 1 iff the edge's sync_mode field == SS_MODE_SYNC (0).
  // Returns 0 for a null pointer (a null edge is trivially non-sync
  // in the sense the caller cares about: no edge means no sync
  // commitment). The predicate reads only word2[7:0] and does not
  // consult in_use -- a caller who reaches into the record with a
  // stack-allocated SubsurfaceEdge (in_use == 0) still gets the
  // right answer.
  //
  // This is the fast path the compositor takes at parent-commit time:
  //   for each edge in parent.edges:
  //     if subsurface_edge_is_sync(&edge):
  //       fold child pending state into this atomic commit
  //     else:
  //       leave child on its own commit cadence
  // ==========================================================================

  pub let subsurface_edge_is_sync : (u64) -> u64 !{mem} @{} =
    fn (edge_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B7-01 (paideia-os #2258): 1 iff sync_mode == SS_MODE_SYNC(0). Null pointer -> 0. Field lives at word2[7:0] (offset +16, low byte). Leaf; no callee-save discipline. Uses cmp reg,0 (not test) per encoder discipline. Labels prefixed subsurface_sync_.",
      block: {
        cmp rdi, 0;
        je  subsurface_sync_is_no;
        mov rax, [rdi + 16];
        mov r10, 0xFF;
        and rax, r10;
        cmp rax, 0;
        jne subsurface_sync_is_no;
        mov rax, 1;
        ret;
      subsurface_sync_is_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // SECTION G  Packers.
  // ==========================================================================

  // subsurface_sync_pack_u32_pair(lo, hi) -> lo[31:0] | hi[63:32].
  // Reused for (parent_kind_id, child_kind_id) and (x, y) word packs.
  pub let subsurface_sync_pack_u32_pair : (u64, u64) -> u64 !{} @{} =
    fn (lo: u64) (hi: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B7-01 (paideia-os #2258): pack (u32, u32) -> u64 with lo at [31:0] and hi at [63:32]. Reused by subsurface_edge_new to write word0 (parent|child) and word1 (x|y). Leaf. Labels prefixed subsurface_sync_.",
      block: {
        mov rax, rdi;
        and rax, 0xFFFFFFFF;
        mov r10, rsi;
        and r10, 0xFFFFFFFF;
        shl r10, 32;
        or  rax, r10;
        ret
      }
    }

  // subsurface_sync_pack_mode_inuse(mode, in_use) -> mode[7:0] | in_use[15:8].
  // High 48 bits are reserved (zeroed).
  pub let subsurface_sync_pack_mode_inuse : (u64, u64) -> u64 !{} @{} =
    fn (mode: u64) (in_use: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B7-01 (paideia-os #2258): pack (mode u8, in_use u8) into word2. mode at [7:0], in_use at [15:8], reserved [63:16] zero. Leaf. Labels prefixed subsurface_sync_.",
      block: {
        mov rax, rdi;
        and rax, 0xFF;
        mov r10, rsi;
        and r10, 0xFF;
        shl r10, 8;
        or  rax, r10;
        ret
      }
    }

  // ==========================================================================
  // SECTION H  Edge pool primitives.
  //
  // A slot in _subsurface_edges is free iff word2[15:8] == 0. The
  // low-first scan in subsurface_edge_new claims the first free slot;
  // subsurface_edge_free scrubs one slot (all four u64 words) but
  // does not compact.
  // ==========================================================================

  // subsurface_edge_slot_free(slot_id) -> 1 iff slot in-range and in_use==0.
  // Used at scan time by subsurface_edge_new; also exposed so a follow-
  // on landing can query pool occupancy without re-implementing the
  // bit dance.
  pub let subsurface_edge_slot_free : (u64) -> u64 !{mem} @{} =
    fn (slot_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B7-01 (paideia-os #2258): 1 iff slot < SS_MAX(8) and in_use byte is zero. Address compute slot_id * 32 via shl 5. Leaf. Labels prefixed subsurface_sync_.",
      block: {
        mov r10, 8;
        cmp rdi, r10;
        jae subsurface_sync_sf_no;
        lea r10, [rip + _subsurface_edges];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 8;
        mov r11, 0xFF;
        and rax, r11;
        cmp rax, 0;
        jne subsurface_sync_sf_no;
        mov rax, 1;
        ret;
      subsurface_sync_sf_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // SECTION I  Factory.
  //
  // subsurface_edge_new(parent, child, x, y, mode) -> edge_ptr | 0.
  //
  // Validates:
  //   * parent (low u32) != 0                    -> SS_MINT_BAD_PARENT
  //   * child  (low u32) != 0                    -> SS_MINT_BAD_CHILD
  //   * parent (low u32) != child (low u32)      -> SS_MINT_BAD_SELF
  //   * mode   (low u8)  in {0, 1}               -> SS_BAD_MODE
  //
  // On any validation failure returns 0 (the caller compares against
  // zero; a distinct error-code return would require a two-word ABI
  // that would waste a register in the common success path). The
  // spec-canonical error codes are still exposed as constants for a
  // future dispatcher landing that returns them explicitly.
  //
  // On success, scans the pool low-first for a free slot (in_use==0),
  // stamps the four words:
  //   word0 = pack(parent_low32, child_low32)
  //   word1 = pack(x_low32, y_low32)
  //   word2 = pack(mode_low8, in_use=1)
  //   word3 = edge_seq = 1     (first version of the edge)
  // and returns the slot base pointer.
  //
  // Register assignment (five callee-save pushes: rbx, r12..r15):
  //   rbx = parent (u64 arg 1)
  //   r12 = child  (u64 arg 2)
  //   r13 = x      (u64 arg 3)
  //   r14 = y      (u64 arg 4)
  //   r15 = mode   (u64 arg 5)
  //
  // Five pushes on entry (rsp%16==8) -> rsp%16==0 for nested SysV
  // calls. Each nested call site adds a sub rsp, 8 / add rsp, 8 pad
  // so the callee still sees rsp%16==0 (SysV requires rsp%16==0 at
  // entry to the callee's prologue).
  // ==========================================================================

  pub let subsurface_edge_new : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (parent: u64) (child: u64) (x: u64) (y: u64) (mode: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B7-01 (paideia-os #2258): allocate one SubsurfaceEdge in the SS_MAX(8)-slot pool and stamp its four fields. Validation gate: parent!=0, child!=0, parent!=child (all on low u32), mode<=1. Any failure returns 0 (null-ptr sentinel; caller compares against zero). Success returns slot base pointer (never null). Five callee-save pushes hold the five u64 args across nested calls; each nested call site pads rsp with sub 8 / add 8 so the callee sees rsp%16==0 (SysV). Encoder-conservative: cmp not test; load-inc-store idiom (never add reg,[mem]) for the in_use claim + edge_seq stamp. Labels prefixed subsurface_sync_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov  rbx, rdi;                     // parent
        mov  r12, rsi;                     // child
        mov  r13, rdx;                     // x
        mov  r14, rcx;                     // y
        mov  r15, r8;                      // mode

        // Guard: parent low u32 != 0.
        mov  rax, rbx;
        mov  r10, 0xFFFFFFFF;
        and  rax, r10;
        cmp  rax, 0;
        je   subsurface_sync_new_fail;

        // Guard: child low u32 != 0.
        mov  rax, r12;
        and  rax, r10;
        cmp  rax, 0;
        je   subsurface_sync_new_fail;

        // Guard: parent low u32 != child low u32.
        mov  rax, rbx;
        and  rax, r10;
        mov  r11, r12;
        and  r11, r10;
        cmp  rax, r11;
        je   subsurface_sync_new_fail;

        // Guard: mode low u8 <= SS_MODE_MAX(1).
        mov  rax, r15;
        mov  r10, 0xFF;
        and  rax, r10;
        mov  r10, 1;
        cmp  rax, r10;
        ja   subsurface_sync_new_fail;

        // Scan pool low-first for a free slot.
        xor  rcx, rcx;                     // rcx = slot_id
      subsurface_sync_new_scan:
        cmp  rcx, 8;
        jae  subsurface_sync_new_fail;

        // Slot base = _subsurface_edges + rcx * 32.
        lea  r10, [rip + _subsurface_edges];
        mov  r11, rcx;
        shl  r11, 5;
        add  r10, r11;

        // Read word2, extract in_use (bits [15:8]).
        mov  rax, [r10 + 16];
        shr  rax, 8;
        mov  r11, 0xFF;
        and  rax, r11;
        cmp  rax, 0;
        je   subsurface_sync_new_claim;

        add  rcx, 1;
        jmp  subsurface_sync_new_scan;

      subsurface_sync_new_claim:
        // r10 already points at slot base.
        // Word0: pack(parent_low32, child_low32).
        mov  rax, rbx;
        mov  r11, 0xFFFFFFFF;
        and  rax, r11;
        mov  rdx, r12;
        and  rdx, r11;
        shl  rdx, 32;
        or   rax, rdx;
        mov  [r10 + 0], rax;

        // Word1: pack(x_low32, y_low32).
        mov  rax, r13;
        and  rax, r11;
        mov  rdx, r14;
        and  rdx, r11;
        shl  rdx, 32;
        or   rax, rdx;
        mov  [r10 + 8], rax;

        // Word2: mode_low8 | (in_use=1)<<8. High 48 bits zero.
        mov  rax, r15;
        mov  r11, 0xFF;
        and  rax, r11;
        mov  rdx, 1;
        shl  rdx, 8;
        or   rax, rdx;
        mov  [r10 + 16], rax;

        // Word3: edge_seq = 1 (first version).
        mov  rax, 1;
        mov  [r10 + 24], rax;

        // Return slot base pointer in rax.
        mov  rax, r10;
        jmp  subsurface_sync_new_out;

      subsurface_sync_new_fail:
        xor  rax, rax;

      subsurface_sync_new_out:
        pop  r15;
        pop  r14;
        pop  r13;
        pop  r12;
        pop  rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION J  Free + init.
  // ==========================================================================

  // subsurface_edge_free(slot_id) -> (). Scrubs one slot's four u64
  // words. Bounds-checked against SS_MAX(8); OOB is a silent no-op
  // (the caller has no way to react beyond retrying, and this path
  // is only reachable via a compositor-internal call).
  pub let subsurface_edge_free : (u64) -> () !{mem} @{} =
    fn (slot_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B7-01 (paideia-os #2258): scrub one 32-byte slot (four u64 words). Bounds-checked against SS_MAX(8); OOB is a silent no-op. Address compute slot_id * 32 via shl 5. Leaf. Labels prefixed subsurface_sync_.",
      block: {
        mov  r10, 8;
        cmp  rdi, r10;
        jae  subsurface_sync_free_out;
        lea  r10, [rip + _subsurface_edges];
        mov  r11, rdi;
        shl  r11, 5;
        add  r10, r11;
        xor  rax, rax;
        mov  [r10 + 0],  rax;
        mov  [r10 + 8],  rax;
        mov  [r10 + 16], rax;
        mov  [r10 + 24], rax;
      subsurface_sync_free_out:
        ret
      }
    }

  // subsurface_sync_init(): zero the edge pool. Defensive re-scrub;
  // .bss is already zero at real boot. Mirrors lt_init / hmk_init
  // / rdk_init.
  pub let subsurface_sync_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B7-01 (paideia-os #2258): zero _subsurface_edges (32 u64). Defensive; .bss is already zero at real boot. Loop-carried rcx = index cursor; load-store idiom (no add reg,[mem]). Labels prefixed subsurface_sync_.",
      block: {
        lea r10, [rip + _subsurface_edges];
        xor rax, rax;
        xor rcx, rcx;
      subsurface_sync_init_loop:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  subsurface_sync_init_loop;
        ret
      }
    }

  // ==========================================================================
  // SECTION K  Meta fingerprint.
  //
  // pdx_kind_subsurface_meta -- ONE tag ending [legacy: ... OK] per
  // softarch discipline. See §7. Data-only at this landing; the mint
  // dispatcher (a G7-M3-003 follow-on landing) will emit it via
  // klog_s1_x1 on every successful mint. Until that lands the string
  // needs allowlisting in tools/verify-fingerprint-coverage.sh with
  // reason "subsurface_sync mint dispatcher not yet landed
  // (Wave0-B7-01)".
  //
  // String length: 53 chars + NUL = 54 bytes. Sized [u8; 54] exactly.
  // ==========================================================================

  pub let pdx_kind_subsurface_meta : [u8; 54] = "pdx kind subsurface meta [legacy: SUBSURFACE SYNC OK]\0"
}
