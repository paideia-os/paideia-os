// src/user/compositor/surface_page_map.pdx -- Wave sigma sigma-02 (R37 GPU
// VM -> compositor surface page mapping)
//
// =============================================================================
// STATUS: HONEST SCAFFOLD
// =============================================================================
// R37 landed gpu_vm as a kernel-internal cap-op (kind_gpu_vm.pdx). Userspace
// has no gpu_vm_map syscall yet. This module establishes the wire shape for
// mapping a compositor-owned BO (allocated via sigma-01 scanout_bo) into a
// per-client GPU virtual address space, and stashes the mapping so the
// composer can look up a base VA per surface.
//
// Because the real gpu_vm_map has not landed, the local
// surface_page_map_gpu_vm_map_stub returns 0. The stored base_va is
// therefore 0 for every bound surface; surface_page_map_query_va returns 0
// on both "not bound" AND "bound but stub". The distinction becomes
// observable when the real syscall replaces the stub (base_va will then be
// a nonzero GPU-VM VA and observers can distinguish).
//
// LINKAGE. Unlinked in this wave; see scanout_bo.pdx header for the shared
// story on compositor/* catch-all + future compositor-runner.elf.
//
// =============================================================================
// SLOT LAYOUT (32 B / slot; 16 slots; 64 u64 total)
// =============================================================================
//   +0   u64 surface_kind_id     (0 => slot free; caller must never pass 0)
//   +8   u64 gpu_vm_row_id       (row returned by gpu_vm_map; stub-value 0)
//   +16  u64 base_va             (installed GPU-VA base; stub-value 0)
//   +24  u64 page_count          (mapped page count; stub-value 1)
//
// FREE INDICATOR. surface_kind_id == 0 => slot free. The caller (compositor
// core) uses non-zero surface_kind_id values (KIND_SURFACE rows begin at
// row_id=1) so 0 is safely reserved.
//
// FAILURE BAND. 0xFFFFEC80..0xFFFFEC8F reserved for surface_page_map;
// grep-verified fresh at landing.
//
// =============================================================================
// MODULE BASENAME
// =============================================================================
// surface_page_map.pdx -> module SurfacePageMap. Labels prefixed
// surface_page_map_.

module SurfacePageMap = structure {

  pub let SPM_MAX          : u64 = 16
  pub let SPM_ROW_BYTES    : u64 = 32
  pub let SPM_ROW_WORDS    : u64 = 4

  pub let SPM_OK            : u64 = 0
  pub let SPM_BAD_SURFACE   : u64 = 0xFFFFEC80
  pub let SPM_BAD_BO        : u64 = 0xFFFFEC81
  pub let SPM_ENOSPC        : u64 = 0xFFFFEC82
  pub let SPM_NOT_BOUND     : u64 = 0xFFFFEC83
  pub let SPM_STUB_FAIL     : u64 = 0xFFFFEC84

  // 16 slots * 4 u64 = 64 u64.
  pub let mut _surface_page_map : [u64; 64] = uninit @align(64)

  // ==========================================================================
  // Local R37 GPU VM map stub. Returns 0 unconditionally.
  // Signature intent: (gpu_vm_map)(bo_row_id, base_va, page_count) -> row_id
  // For scaffold, we accept a single packed handle (bo_row_id) and the
  // consumer ignores the return. When the real syscall lands, the stub
  // gets replaced with the syscall-shim call using the shim's own arity.
  // ==========================================================================

  pub let surface_page_map_gpu_vm_map_stub : (u64) -> u64 !{} @{} =
    fn (bo_row_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave sigma sigma-02: R37 GPU VM map stub. Returns 0 until userspace gpu_vm_map syscall lands. Leaf.",
      block: {
        xor rax, rax;
        ret
      }
    }

  pub let surface_page_map_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave sigma sigma-02: zero _surface_page_map (64 u64) at boot. Leaf. Labels prefixed surface_page_map_srz_.",
      block: {
        lea r10, [rip + _surface_page_map];
        xor rax, rax;
        xor rcx, rcx;
      surface_page_map_srz_step:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 64;
        jb  surface_page_map_srz_step;
        ret
      }
    }

  // surface_page_map_find(surface_kind_id) -> slot_idx | SPM_MAX.
  //   Linear scan; internal helper. Leaf. Not marked pub-hidden because
  //   paideia-as has no visibility levels; the leading spm_ prefix
  //   communicates internal-only intent.
  pub let surface_page_map_find : (u64) -> u64 !{mem} @{} =
    fn (surface_kind_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave sigma sigma-02: linear scan for surface_kind_id in _surface_page_map. Returns SPM_MAX (16) when not found. Leaf. Labels prefixed surface_page_map_fn_.",
      block: {
        xor rcx, rcx;
      surface_page_map_fn_step:
        cmp rcx, 16;
        jae surface_page_map_fn_none;
        lea r10, [rip + _surface_page_map];
        mov r11, rcx;
        imul r11, r11, 32;
        add r10, r11;
        mov rax, [r10 + 0];
        cmp rax, rdi;
        je  surface_page_map_fn_hit;
        add rcx, 1;
        jmp surface_page_map_fn_step;
      surface_page_map_fn_hit:
        mov rax, rcx;
        ret;
      surface_page_map_fn_none:
        mov rax, 16;
        ret
      }
    }

  // surface_page_map_bind(surface_kind_id, bo_slot_idx) -> SPM_OK |
  //                                                       SPM_BAD_SURFACE |
  //                                                       SPM_ENOSPC.
  //   Gates: surface_kind_id != 0 -> SPM_BAD_SURFACE.
  //   Idempotency: if surface_kind_id already bound, refuse with
  //   SPM_OK (no-op) — a compositor rebind is treated as harmless because
  //   the base_va is deterministic in the stub regime.
  //   Otherwise: find first free slot (surface_kind_id == 0); call the
  //   stub with bo_slot_idx; store {surface_kind_id, gpu_vm_row_id=0,
  //   base_va=0, page_count=1}.
  //
  //   ABI: 2 args. Three-push callee-save (rbx=surface, r12=bo_slot,
  //   r13=slot_idx) keeps rsp%16==0 across nested stub call
  //   (entry 8, +24 pushes = 0).
  pub let surface_page_map_bind : (u64, u64) -> u64 !{mem} @{} =
    fn (surface_kind_id: u64) (bo_slot_idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave sigma sigma-02: install one BO into per-client GPU-VM under a surface_kind_id. Three-push prologue (rbx/r12/r13). Idempotent on rebind. Labels prefixed surface_page_map_bd_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                          // surface_kind_id
        mov r12, rsi;                          // bo_slot_idx

        cmp rbx, 0;
        je  surface_page_map_bd_bads;

        // Idempotent rebind: if already bound, return OK.
        mov rdi, rbx;
        call surface_page_map_find;
        cmp rax, 16;
        jne surface_page_map_bd_ok;

        // Scan for a free slot (surface_kind_id == 0).
        xor r13, r13;
      surface_page_map_bd_scan:
        cmp r13, 16;
        jae surface_page_map_bd_full;
        lea r10, [rip + _surface_page_map];
        mov r11, r13;
        imul r11, r11, 32;
        add r10, r11;
        mov rax, [r10 + 0];
        cmp rax, 0;
        je  surface_page_map_bd_claim;
        add r13, 1;
        jmp surface_page_map_bd_scan;

      surface_page_map_bd_claim:
        // Call the stub with bo_slot_idx. Return value stored as
        // gpu_vm_row_id (stub value 0).
        mov rdi, r12;
        call surface_page_map_gpu_vm_map_stub;
        mov rcx, rax;                          // gpu_vm_row_id

        // Recompute slot base.
        lea r10, [rip + _surface_page_map];
        mov r11, r13;
        imul r11, r11, 32;
        add r10, r11;

        mov [r10 + 0], rbx;                    // surface_kind_id
        mov [r10 + 8], rcx;                    // gpu_vm_row_id
        xor rax, rax;
        mov [r10 + 16], rax;                   // base_va (stub 0)
        mov rax, 1;
        mov [r10 + 24], rax;                   // page_count (stub 1)

      surface_page_map_bd_ok:
        xor rax, rax;                          // SPM_OK
        jmp surface_page_map_bd_out;

      surface_page_map_bd_bads:
        mov rax, 0xFFFFEC80;                   // SPM_BAD_SURFACE
        jmp surface_page_map_bd_out;
      surface_page_map_bd_full:
        mov rax, 0xFFFFEC82;                   // SPM_ENOSPC

      surface_page_map_bd_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // surface_page_map_unbind(surface_kind_id) -> SPM_OK | SPM_NOT_BOUND.
  //   One-push prologue (rbx=surface) keeps rsp%16==0 across the find call
  //   (entry 8, +8 = 0).
  pub let surface_page_map_unbind : (u64) -> u64 !{mem} @{} =
    fn (surface_kind_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave sigma sigma-02: release the mapping for a surface. One-push prologue keeps rsp%16==0 for the nested find call. Labels prefixed surface_page_map_ub_.",
      block: {
        push rbx;

        mov rbx, rdi;

        mov rdi, rbx;
        call surface_page_map_find;
        cmp rax, 16;
        je  surface_page_map_ub_none;

        // Zero the slot (surface_kind_id -> 0 restores free indicator).
        lea r10, [rip + _surface_page_map];
        mov r11, rax;
        imul r11, r11, 32;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0], rax;
        mov [r10 + 8], rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        xor rax, rax;                          // SPM_OK
        jmp surface_page_map_ub_out;

      surface_page_map_ub_none:
        mov rax, 0xFFFFEC83;                   // SPM_NOT_BOUND

      surface_page_map_ub_out:
        pop rbx;
        ret
      }
    }

  // surface_page_map_query_va(surface_kind_id) -> base_va | 0.
  //   Reads base_va from the found slot; returns 0 on not-bound. Because
  //   the stub stores base_va=0 unconditionally, the "not bound" and
  //   "bound-stub" cases are indistinguishable in this wave; that
  //   ambiguity resolves when the real syscall replaces the stub.
  //   One-push prologue keeps rsp%16==0 across the find call.
  pub let surface_page_map_query_va : (u64) -> u64 !{mem} @{} =
    fn (surface_kind_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave sigma sigma-02: read base_va for a surface. Returns 0 when not bound. One-push prologue for the find call. Labels prefixed surface_page_map_qv_.",
      block: {
        push rbx;

        mov rbx, rdi;

        mov rdi, rbx;
        call surface_page_map_find;
        cmp rax, 16;
        je  surface_page_map_qv_none;

        lea r10, [rip + _surface_page_map];
        mov r11, rax;
        imul r11, r11, 32;
        add r10, r11;
        mov rax, [r10 + 16];
        jmp surface_page_map_qv_out;

      surface_page_map_qv_none:
        xor rax, rax;

      surface_page_map_qv_out:
        pop rbx;
        ret
      }
    }
}
