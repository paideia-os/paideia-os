  // ==========================================================================
  // Section 13  bbox helpers (union of two rects into a single bbox).
  //
  // A "rect" here is 4 i32 fields stored as u32 bit-patterns (x, y, w, h);
  // "bbox of rect" is (x, y, x+w, y+h) reinterpreted as (x, y, w, h) again
  // -- i.e. we track the OUTER extent (x_min, y_min, x_max, y_max) then
  // pack back as (x, y, w, h) on store. This module keeps bbox as (x, y,
  // w, h) directly on the row so every getter is one u64 load.
  //
  // The union of bbox (bx, by, bw, bh) with rect (rx, ry, rw, rh) is:
  //   nx = min(bx, rx)
  //   ny = min(by, ry)
  //   nx_max = max(bx + bw, rx + rw)
  //   ny_max = max(by + bh, ry + rh)
  //   -> (nx, ny, nx_max - nx, ny_max - ny)
  // The "empty bbox" convention (rect_count == 0) is (0, 0, 0, 0); the
  // first add_rect against an empty bbox copies the rect verbatim rather
  // than min/max-ing against zeros (which would incorrectly clamp to
  // origin). damage_kind_bbox_extend below implements that check.
  //
  // ARITHMETIC DISCIPLINE: no float, no FPU (per design/kernel/no-fpu.md).
  // Comparisons on i32 bit-patterns are done via an unsigned-bias trick
  // (XOR each operand with 0x80000000 to flip the sign bit, then compare
  // as unsigned) so the encoder's mnemonic table need not include movsx.
  // Adds and subs run in raw 64-bit; the low-32 mask on the result is
  // correct for both signed and unsigned interpretations (modular
  // arithmetic modulo 2^32 preserves the two's-complement bit pattern).
  // No overflow guard on bx+bw etc. -- a compositor that damages a rect
  // whose extent overflows i32 is already at a display-configuration
  // pathology (16-bit rects clamped at 65536, i32 rects at 2^31); the
  // caller has bigger problems than a bbox roll.
  // ==========================================================================

  // damage_kind_i32_min(a, b) -> min(a, b) as u32 bit-pattern.
  //
  // Signed compare via unsigned-bias trick (movsx not confirmed in the
  // encoder's mnemonic table): bias each operand by XOR 0x80000000
  // (flips the sign bit), then compare as unsigned. On i32 semantics
  // this maps [-2^31, 2^31) -> [0, 2^32) monotonically so unsigned <
  // agrees with signed <. Return the ORIGINAL (unbiased) operand.
  pub let damage_kind_i32_min : (u64, u64) -> u64 !{} @{} =
    fn (a: u64) (b: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B9-06 (#2294): signed min via unsigned-bias trick. Two 4-line bias sequences (mask u32, xor sign bit) into r10/rax, cmp + jb selects the smaller BIASED value, but we return the ORIGINAL operand. Labels prefixed damage_kind_.",
      block: {
        // biased_a in r10.
        mov r10, rdi;
        mov r11, 0xFFFFFFFF;
        and r10, r11;
        mov r11, 0x80000000;
        xor r10, r11;

        // biased_b in rax.
        mov rax, rsi;
        mov r11, 0xFFFFFFFF;
        and rax, r11;
        mov r11, 0x80000000;
        xor rax, r11;

        cmp r10, rax;
        jb  damage_kind_i32min_a;
        // b <= a (signed): return b as u32.
        mov rax, rsi;
        mov r11, 0xFFFFFFFF;
        and rax, r11;
        ret;
      damage_kind_i32min_a:
        // a < b (signed): return a as u32.
        mov rax, rdi;
        mov r11, 0xFFFFFFFF;
        and rax, r11;
        ret
      }
    }

  // damage_kind_i32_max(a, b) -> max(a, b) as u32 bit-pattern.
  pub let damage_kind_i32_max : (u64, u64) -> u64 !{} @{} =
    fn (a: u64) (b: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B9-06 (#2294): signed max via unsigned-bias trick (mirror of i32_min; ja selects the larger biased value). Labels prefixed damage_kind_.",
      block: {
        // biased_a in r10.
        mov r10, rdi;
        mov r11, 0xFFFFFFFF;
        and r10, r11;
        mov r11, 0x80000000;
        xor r10, r11;

        // biased_b in rax.
        mov rax, rsi;
        mov r11, 0xFFFFFFFF;
        and rax, r11;
        mov r11, 0x80000000;
        xor rax, r11;

        cmp r10, rax;
        ja  damage_kind_i32max_a;
        // b >= a (signed): return b as u32.
        mov rax, rsi;
        mov r11, 0xFFFFFFFF;
        and rax, r11;
        ret;
      damage_kind_i32max_a:
        mov rax, rdi;
        mov r11, 0xFFFFFFFF;
        and rax, r11;
        ret
      }
    }

  // damage_kind_i32_add(a, b) -> (a + b) low 32 bits.
  //
  // Modular arithmetic modulo 2^32 preserves the bit pattern of signed
  // addition (two's complement is closed under add mod 2^N), so no
  // sign-extend is needed -- the raw 64-bit add + u32 mask is correct.
  // OVERFLOW SEMANTICS: an add whose true signed result exceeds i32
  // range wraps (rather than saturating). A compositor that damages a
  // rect whose extent overflows i32 is already at a display-config
  // pathology; the caller has bigger problems than a bbox roll.
  pub let damage_kind_i32_add : (u64, u64) -> u64 !{} @{} =
    fn (a: u64) (b: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B9-06 (#2294): u32-truncated add. Modular arithmetic preserves signed bit pattern; no sign extension needed. Labels prefixed damage_kind_.",
      block: {
        mov rax, rdi;
        mov r10, rsi;
        add rax, r10;
        mov r11, 0xFFFFFFFF;
        and rax, r11;
        ret
      }
    }

  // damage_kind_i32_sub(a, b) -> (a - b) low 32 bits.
  pub let damage_kind_i32_sub : (u64, u64) -> u64 !{} @{} =
    fn (a: u64) (b: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B9-06 (#2294): u32-truncated sub; mirror of i32_add. Labels prefixed damage_kind_.",
      block: {
        mov rax, rdi;
        mov r10, rsi;
        sub rax, r10;
        mov r11, 0xFFFFFFFF;
        and rax, r11;
        ret
      }
    }

  // ==========================================================================
  // Section 14  Mutations: add_rect / clear / union.
  //
  // Every mutation bumps _dr_stats[DR_ST_MUTATIONS] and increments the
  // row's seq. seq wraparound at 2^64 is out of scope (a compositor
  // that damages 2^64 times in one boot has other problems); an atomic
  // add on the u64 field suffices.
  // ==========================================================================

  // damage_region_clear(row_id) -> DR_OK | DR_BAD_SLOT.
  //   rect_count = 0, bbox = (0, 0, 0, 0), rects[] left as-is (readers
  //   gated on rect_count won't see them). seq incremented.
  pub let damage_region_clear : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-06 (#2294): zero rect_count + bbox; increment seq; bump _dr_stats[DR_ST_MUTATIONS]. Preserves in_use marker (word0 top byte) and surface_kind_id (word0 low 32) by masking. Labels prefixed damage_kind_.",
      block: {
        push r12;

        mov r12, rdi;

        mov rdi, r12;
        call damage_kind_tail_valid;
        cmp rax, 0;
        je  damage_kind_dcl_bad;

        lea r10, [rip + _dr_table];
        mov r11, r12;
        imul r11, r11, 160;
        add r10, r11;

        // word0: preserve surface_kind_id (bits [31:0]) and in_use
        // (bits [63:56]); zero rect_count (bits [39:32]) and reserved
        // (bits [55:40]).
        mov rax, [r10 + 0];
        // build mask = 0xFF000000_FFFFFFFF (keep top byte + low u32).
        mov r11, 0xFF00000000000000;
        mov rcx, 0x00000000FFFFFFFF;
        or  r11, rcx;
        and rax, r11;
        mov [r10 + 0], rax;

        // bbox = (0, 0, 0, 0).
        xor rax, rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;

        // seq bump.
        mov rax, [r10 + 24];
        add rax, 1;
        mov [r10 + 24], rax;

        mov rdi, 3;                            // DR_ST_MUTATIONS
        call damage_kind_note;
        xor rax, rax;
        jmp damage_kind_dcl_out;

      damage_kind_dcl_bad:
        mov rax, 0xFFFFEBCA;                   // DR_BAD_SLOT

      damage_kind_dcl_out:
        pop r12;
        ret
      }
    }

  // damage_region_add_rect(row_id, x, y, w, h) -> DR_OK | DR_BAD_SLOT
  //                                              | DR_BAD_RECT.
  // Policy:
  //   (1) validate row + rect (w >= 0, h >= 0).
  //   (2) update bbox to union of current bbox with the incoming rect.
  //   (3) if rect_count < DR_MAX_RECTS, append the rect to rects[] and
  //       increment rect_count; otherwise leave rects[] alone (bbox
  //       already carries the coalesced extent -- the "conservative
  //       repaint" fallback).
  //   (4) bump seq + _dr_stats[DR_ST_MUTATIONS].
  //
  // Never emits DR_RECT_FULL in this landing (the policy above soaks
  // the overflow silently); the sentinel is claimed so a stricter
  // downstream policy can wire it in without a taxonomy bump.
  pub let damage_region_add_rect : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64) (x: u64) (y: u64) (w: u64) (h: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-06 (#2294): validate + append + bbox-extend + seq-bump. Six-push callee-save prologue (rbx=row_id, r12=x, r13=y, r14=w, r15=h, rbp=row_base) + one align push keeps rsp%16==0 across every nested call (tail_valid, rect_valid, i32_min/max/add/sub, note). Labels prefixed damage_kind_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;
        sub  rsp, 8;                           // align: entry 8, +48 pushes = 8, +8 pad = 0

        mov rbx, rdi;                          // row_id
        mov r12, rsi;                          // x
        mov r13, rdx;                          // y
        mov r14, rcx;                          // w
        mov r15, r8;                           // h

        // (1a) row valid.
        mov rdi, rbx;
        call damage_kind_tail_valid;
        cmp rax, 0;
        je  damage_kind_dar_bad;

        // (1b) rect valid (w >= 0, h >= 0).
        mov rdi, r14;
        mov rsi, r15;
        call damage_kind_rect_valid;
        cmp rax, 0;
        je  damage_kind_dar_badr;

        // rbp = row_base.
        lea rbp, [rip + _dr_table];
        mov r11, rbx;
        imul r11, r11, 160;
        add rbp, r11;

        // Read current rect_count out of word0 bits [39:32].
        mov rax, [rbp + 0];
        shr rax, 32;
        mov r10, 0xFF;
        and rax, r10;
        // rax = current rect_count (0..8).

        // Branch on rect_count == 0 (bbox seed) vs > 0 (bbox extend).
        cmp rax, 0;
        je  damage_kind_dar_seed;
        jmp damage_kind_dar_extend;

      damage_kind_dar_seed:
        // First rect on empty bbox: bbox = rect verbatim.
        // word1 = x | (y << 32).
        mov rax, r12;
        mov r10, 0xFFFFFFFF;
        and rax, r10;
        mov r11, r13;
        and r11, r10;
        shl r11, 32;
        or  rax, r11;
        mov [rbp + 8], rax;
        // word2 = w | (h << 32).
        mov rax, r14;
        mov r10, 0xFFFFFFFF;
        and rax, r10;
        mov r11, r15;
        and r11, r10;
        shl r11, 32;
        or  rax, r11;
        mov [rbp + 16], rax;
        jmp damage_kind_dar_write_rect;

      damage_kind_dar_extend:
        // bbox extend. bx = word1[31:0], by = word1[63:32],
        //              bw = word2[31:0], bh = word2[63:32].
        //
        // The correct order is:
        //   (a) old_right  = bx + bw          (read BEFORE overwriting bx)
        //   (b) old_bottom = by + bh
        //   (c) new_x      = i32_min(bx, x)
        //   (d) new_y      = i32_min(by, y)
        //   (e) new_right  = i32_max(old_right, x + w)
        //   (f) new_bottom = i32_max(old_bottom, y + h)
        //   (g) new_w      = i32_sub(new_right,  new_x)
        //   (h) new_h      = i32_sub(new_bottom, new_y)
        //
        // Uses rax + r10 + r11 as scratch across helper calls (each is a
        // leaf that only clobbers rax/r10/r11). Spills the four sticky
        // intermediates (old_right, old_bottom, new_x, new_y) to a 32-
        // byte stack window so they survive across the subsequent add /
        // max / sub helper calls without needing more callee-saves.

        sub rsp, 32;                           // 4 * u64 spill slots
        // [rsp + 0]  : old_right  = bx + bw
        // [rsp + 8]  : old_bottom = by + bh
        // [rsp + 16] : new_x      = min(bx, x)
        // [rsp + 24] : new_y      = min(by, y)

        // (a) old_right = i32_add(bx, bw).
        mov rax, [rbp + 8];
        mov r10, 0xFFFFFFFF;
        and rax, r10;                          // rax = bx
        mov r11, [rbp + 16];
        mov r10, 0xFFFFFFFF;
        and r11, r10;                          // r11 = bw
        mov rdi, rax;
        mov rsi, r11;
        call damage_kind_i32_add;
        mov [rsp + 0], rax;

        // (b) old_bottom = i32_add(by, bh).
        mov rax, [rbp + 8];
        shr rax, 32;                           // rax = by
        mov r11, [rbp + 16];
        shr r11, 32;                           // r11 = bh
        mov rdi, rax;
        mov rsi, r11;
        call damage_kind_i32_add;
        mov [rsp + 8], rax;

        // (e) new_x = i32_min(bx, x).
        mov rax, [rbp + 8];
        mov r10, 0xFFFFFFFF;
        and rax, r10;                          // rax = bx
        mov rdi, rax;
        mov rsi, r12;                          // r12 = x
        call damage_kind_i32_min;
        mov [rsp + 16], rax;

        // (f) new_y = i32_min(by, y).
        mov rax, [rbp + 8];
        shr rax, 32;
        mov rdi, rax;
        mov rsi, r13;                          // r13 = y
        call damage_kind_i32_min;
        mov [rsp + 24], rax;

        // (c) new_right = i32_max(old_right, x + w).
        //   temp = i32_add(x, w).
        mov rdi, r12;
        mov rsi, r14;
        call damage_kind_i32_add;
        mov rdi, [rsp + 0];
        mov rsi, rax;
        call damage_kind_i32_max;
        // rax = new_right. Compute new_w below with new_x.
        mov r10, rax;                          // stash new_right in r10
        mov rdi, r10;
        mov rsi, [rsp + 16];                   // new_x
        call damage_kind_i32_sub;
        // rax = new_w.
        mov r10, rax;                          // stash new_w in r10

        // (d) new_bottom = i32_max(old_bottom, y + h).
        mov rdi, r13;
        mov rsi, r15;
        call damage_kind_i32_add;
        mov rdi, [rsp + 8];
        mov rsi, rax;
        call damage_kind_i32_max;
        // rax = new_bottom. Compute new_h with new_y.
        mov r11, rax;                          // r11 = new_bottom
        mov rdi, r11;
        mov rsi, [rsp + 24];                   // new_y
        call damage_kind_i32_sub;
        // rax = new_h. r10 still = new_w.

        // Write word1 = new_x | (new_y << 32).
        mov r11, [rsp + 16];                   // new_x (u32-clean)
        mov rcx, [rsp + 24];                   // new_y
        shl rcx, 32;
        or  r11, rcx;
        mov [rbp + 8], r11;

        // Write word2 = new_w | (new_h << 32).
        mov r11, r10;                          // new_w
        mov rcx, rax;                          // new_h
        shl rcx, 32;
        or  r11, rcx;
        mov [rbp + 16], r11;

        add rsp, 32;                           // release spill area

      damage_kind_dar_write_rect:
        // Read rect_count again from word0 (may have been overwritten
        // between our read and now if reentrant -- it isn't; single-
        // core boot semantics per compositor process).
        mov rax, [rbp + 0];
        shr rax, 32;
        mov r10, 0xFF;
        and rax, r10;
        // rax = rect_count. If >= DR_MAX_RECTS (8), skip append.
        cmp rax, 8;
        jae damage_kind_dar_seq_bump;

        // Rect slot base = rbp + 32 + rect_count * 16.
        mov r10, rax;                          // rect_count
        imul r10, r10, 16;
        add r10, 32;
        // r10 = rect offset within row; word offset = rbp + r10.
        // rectword0 = x | (y << 32).
        mov r11, r12;                          // x
        mov rax, 0xFFFFFFFF;
        and r11, rax;
        mov rcx, r13;                          // y
        and rcx, rax;
        shl rcx, 32;
        or  r11, rcx;
        mov rax, rbp;
        add rax, r10;
        mov [rax + 0], r11;

        // rectword1 = w | (h << 32).
        mov r11, r14;
        mov rcx, 0xFFFFFFFF;
        and r11, rcx;
        mov rax, r15;
        and rax, rcx;
        shl rax, 32;
        or  r11, rax;
        mov rax, rbp;
        add rax, r10;
        mov [rax + 8], r11;

        // Increment rect_count in word0 bits [39:32]. Preserve
        // surface_kind_id (low 32) + in_use (top byte).
        mov rax, [rbp + 0];
        // Extract current rect_count.
        mov r10, rax;
        shr r10, 32;
        mov r11, 0xFF;
        and r10, r11;
        add r10, 1;
        // Clear old rect_count bits [39:32] via mask.
        mov r11, 0xFFFFFF00FFFFFFFF;
        and rax, r11;
        // Insert new rect_count.
        mov r11, r10;
        shl r11, 32;
        or  rax, r11;
        mov [rbp + 0], rax;

      damage_kind_dar_seq_bump:
        // Bump seq.
        mov rax, [rbp + 24];
        add rax, 1;
        mov [rbp + 24], rax;

        // Bump mutation counter.
        mov rdi, 3;                            // DR_ST_MUTATIONS
        call damage_kind_note;

        xor rax, rax;                          // DR_OK
        jmp damage_kind_dar_out;

      damage_kind_dar_bad:
        mov rax, 0xFFFFEBCA;                   // DR_BAD_SLOT
        jmp damage_kind_dar_out;
      damage_kind_dar_badr:
        mov rax, 0xFFFFEBC5;                   // DR_BAD_RECT

      damage_kind_dar_out:
        add rsp, 8;                            // undo align pad
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // damage_region_union(dst_row_id, src_row_id) -> DR_OK | DR_BAD_SLOT.
  //
  // Policy:
  //   (1) validate both rows in_use.
  //   (2) extend dst bbox by src bbox (bx/by/bw/bh of src).
  //   (3) attempt to append every src rect via damage_region_add_rect
  //       (which itself extends bbox + appends up to DR_MAX_RECTS). The
  //       add_rect fallback (silent skip once full, bbox already
  //       extended) handles the DR_UNION_OVERFLOW policy without a
  //       separate branch.
  //   (4) seq bump (add_rect already bumped, but bump once MORE so a
  //       caller can distinguish a union event from a lone add_rect
  //       -- the seq delta of a union is >= src.rect_count + 1). Also
  //       bumps mutation counter once for the union.
  //
  // A row cannot union with itself: dst == src -> DR_BAD_SLOT
  // (self-union is meaningless and the naive implementation below would
  // read src rects while add_rect mutates them).
  pub let damage_region_union : (u64, u64) -> u64 !{mem} @{} =
    fn (dst: u64) (src: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-06 (#2294): validate both + fold src bbox into dst + append every src rect (add_rect fallback handles overflow). Self-union refused with DR_BAD_SLOT. Four-push + 8-byte pad prologue keeps rsp%16==0 across nested calls (entry 8, +32 pushes = 8, +8 pad = 0); loop counter in rbx. Labels prefixed damage_kind_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        sub  rsp, 8;                           // align pad

        mov r12, rdi;                          // dst
        mov r13, rsi;                          // src

        // Self-union guard.
        cmp r12, r13;
        je  damage_kind_du_bad;

        // (1) both valid.
        mov rdi, r12;
        call damage_kind_tail_valid;
        cmp rax, 0;
        je  damage_kind_du_bad;
        mov rdi, r13;
        call damage_kind_tail_valid;
        cmp rax, 0;
        je  damage_kind_du_bad;

        // (2)+(3) Fold: for each i in 0..src.rect_count, append
        // (src.rects[i].x, .y, .w, .h) to dst via add_rect. If src
        // rect_count is zero but src bbox is non-empty, still extend
        // dst bbox by the bbox itself (rare but legal state after a
        // union that soaked the discrete-rect list).

        // Read src.rect_count.
        mov rdi, r13;
        call damage_region_rect_count;
        mov rbx, rax;                          // rbx = src.rect_count

        // If rect_count is 0 or a sentinel, feed the bbox as a single
        // rect (best-effort). A sentinel (>= DR_MAX_RECTS) shouldn't
        // occur but we guard anyway.
        cmp rbx, 0;
        jne damage_kind_du_loop;
        // rect_count == 0: append the src bbox as one rect if any of
        // (w, h) is non-zero.
        mov rdi, r13;
        call damage_region_bbox_w;
        mov r14, rax;                          // stash bbox_w
        mov rdi, r13;
        call damage_region_bbox_h;
        // r14 = bbox_w, rax = bbox_h.
        mov r10, r14;
        or  r10, rax;
        cmp r10, 0;
        je  damage_kind_du_seq;                // nothing to fold

        // Fetch bbox_x, bbox_y, then call add_rect(dst, x, y, w, h).
        // We need to load w back after fetching x/y since add_rect
        // will consume its args. Sequence:
        //   x = bbox_x(src)
        //   y = bbox_y(src)
        //   w = bbox_w(src)  (already stashed in r14)
        //   h = bbox_h(src)  (already in rax)
        mov r10, rax;                          // r10 = bbox_h
        mov rdi, r13;
        call damage_region_bbox_x;
        mov rsi, rax;                          // rsi = bbox_x (arg2 of add_rect)
        mov rdi, r13;
        call damage_region_bbox_y;
        mov rdx, rax;                          // rdx = bbox_y (arg3)
        mov rcx, r14;                          // rcx = bbox_w (arg4)
        mov r8,  r10;                          // r8  = bbox_h (arg5)
        mov rdi, r12;                          // rdi = dst    (arg1)
        call damage_region_add_rect;
        jmp damage_kind_du_seq;

      damage_kind_du_loop:
        // rbx has src.rect_count; loop rbx-- times, appending
        // (rect_x[i], rect_y[i], rect_w[i], rect_h[i]).
        //
        // Use r14 as loop counter (i = 0, 1, ...).
        xor r14, r14;
      damage_kind_du_iter:
        cmp r14, rbx;
        jae damage_kind_du_seq;

        // rect_x[i].
        mov rdi, r13;
        mov rsi, r14;
        call damage_region_rect_x;
        // stash x in [rsp+8]? We need one slot; sub rsp,8 lets us
        // hold x across the y read. But we entered with rsp%16==0
        // (four pushes -> 32 bytes, %16 == 0), and no further push
        // scaffolding will change alignment across THIS block if we
        // sub rsp,32 for four spills (x, y, w, h) each u64.
        //
        // Simpler: consume each add_rect arg immediately by chaining.
        // Since add_rect wants (dst, x, y, w, h), and our helpers
        // return one value at a time, we can spill each in turn. Use
        // sub rsp, 32 once inside this iteration and free at bottom.
        sub rsp, 32;                           // [rsp+0]=x [8]=y [16]=w [24]=h
        mov [rsp + 0], rax;

        mov rdi, r13;
        mov rsi, r14;
        call damage_region_rect_y;
        mov [rsp + 8], rax;

        mov rdi, r13;
        mov rsi, r14;
        call damage_region_rect_w;
        mov [rsp + 16], rax;

        mov rdi, r13;
        mov rsi, r14;
        call damage_region_rect_h;
        mov [rsp + 24], rax;

        mov rdi, r12;                          // dst
        mov rsi, [rsp + 0];                    // x
        mov rdx, [rsp + 8];                    // y
        mov rcx, [rsp + 16];                   // w
        mov r8,  [rsp + 24];                   // h
        call damage_region_add_rect;

        add rsp, 32;
        add r14, 1;
        jmp damage_kind_du_iter;

      damage_kind_du_seq:
        // Extra seq bump so a caller can distinguish a union from a
        // sequence of add_rect calls. add_rect already bumped one per
        // iteration; this second bump is the "union barrier". Also
        // bumps the mutation counter one MORE time for the union
        // itself (bookkeeping parity with the seq).
        mov r10, r12;                          // dst
        lea r11, [rip + _dr_table];
        imul r10, r10, 160;
        add r11, r10;
        mov rax, [r11 + 24];
        add rax, 1;
        mov [r11 + 24], rax;

        mov rdi, 3;                            // DR_ST_MUTATIONS
        call damage_kind_note;

        xor rax, rax;                          // DR_OK
        jmp damage_kind_du_out;

      damage_kind_du_bad:
        mov rax, 0xFFFFEBCA;                   // DR_BAD_SLOT

      damage_kind_du_out:
        add rsp, 8;                            // undo align pad
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Section 15  Boot init.
  // ==========================================================================

  pub let damage_kind_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-06 (#2294): call through to damage_kind_stats_reset for one clean pool + counter zero-out. Labels prefixed damage_kind_.",
      block: {
        call damage_kind_stats_reset;
        ret
      }
    }
}
