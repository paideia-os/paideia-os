// src/user/compositor/damage_kind.pdx -- Wave0-B9-06 (paideia-os #2294)
//
// KIND_DAMAGE_REGION = 0x1D9, derived over KIND_SURFACE (parent 0x1B8).
// Design authority: design/compositor/pwp-spec-vocabulary.md §2.11
// (KIND_DAMAGE_REGION) + §2.1 (KIND_SURFACE cross-reference), landed under
// Wave-0 Batch-9 alongside the G9 windowing / feedback fan-out (KIND_WINDOW
// derivatives at 0x1D8, KIND_PRESENT_FEEDBACK sib at 0x1DA, buffer-age-aware
// repaint downstream at #2295). Dependency: G9-M1-001 (LANDED in B8).
//
// One KIND_DAMAGE_REGION row names one rect-list describing the sub-region
// of a KIND_SURFACE that changed since the last commit. Aggregation across
// the subsurface tree is by union with clipping, computed at commit time;
// buffer-age-aware repaint (#2295) reads damage regions across N frames to
// decide how much of the front buffer to re-composite. Every row carries a
// monotonic sequence number so a consumer that stashed a snapshot at frame
// N can detect intervening mutations at compose time.
//
// =============================================================================
// SECTION 0  KIND_* SLOT ALLOCATION + PARENT-KIND RECONCILIATION
// =============================================================================
//
// Slot 0x1D9. Wave-0 Batch-9 dispatch places KIND_DAMAGE_REGION on the
// KIND_SURFACE subtree, just above the input-server family:
//   0x1D0  KIND_INPUT_SERVER          (B8 landed)
//   0x1D1  reserved
//   0x1D2  KIND_WORKSPACE             (B8 landed)
//   0x1D3  KIND_A11Y_TREE             (B8 landed)
//   0x1D4  KIND_IME_SESSION           (B8 landed, LINEAR)
//   0x1D5  KIND_UI_CONTEXT            (B8 landed)
//   0x1D6  KIND_SEAT                  (B8 landed)
//   0x1D7  KIND_INPUT_ROUTE           (B8 landed, LINEAR)
//   0x1D8  KIND_WINDOW*/reserved      (Batch-9 sibling row)
//   0x1D9  KIND_DAMAGE_REGION         (THIS FILE, B9-06)
//   0x1DA  KIND_PRESENT_FEEDBACK      (Batch-9 sibling row)
// Cross-verified by grep over src/**/*.pdx + design/**/*.md at landing;
// no live claim on 0x1D9. If a sibling in this same batch collides with
// 0x1D9 the reconciliation is a one-line edit to the KIND_DAMAGE_REGION
// constant below and a single fingerprint re-emission.
//
// Parent-kind reconciliation. The row dispatch briefing names the parent
// as KIND_SURFACE (0x1B8); pwp-spec-vocabulary.md §2.11 names it as
// KIND_MEMORY = 4. This file follows the DISPATCH briefing because:
//   (a) damage_region_mint takes a surface (row_id) argument by design
//       -- the mint gate cannot fail closed against an unrelated
//       KIND_MEMORY cap that has no notion of the surface a rect list
//       is FOR;
//   (b) the row layout inlines surface_kind_id -- a damage region is
//       structurally bound to one surface;
//   (c) KIND_SURFACE already carries R_SURFACE_DAMAGE (0x100, per
//       surface_kind.pdx §Section 4) as the mint-time authority for
//       damage state; that right + R_DR_MINT here is the natural gate.
// A follow-up chore updates the spec text to name KIND_SURFACE as the
// canonical parent in §2.11. This file is the executable authority.
//
// =============================================================================
// SECTION 1  DERIVATION OVER KIND_SURFACE
// =============================================================================
//
// The kind half of the mint gate demands `kind == KIND_SURFACE (0x1B8)`
// carrying R_SURFACE_DAMAGE (0x100) + R_SURFACE_MINT (0x200) per the
// parent's own rights bitmask. This file records only the DR-side gate
// (R_DR_ALL subset test) + the KIND_ID + failure taxonomy; the parent-
// side rights gate lives in the future kernel-side mint body (mirror of
// the cap_handler_surface pattern the M3 batch will land).
//
// Non-linear. A surface may carry multiple pending damage regions
// (one per uncommitted attach) that a commit-txn consumer folds into
// the surface's active damage state. The linearity discipline lives on
// KIND_SURFACE_COMMIT (§2.2), not here.
//
// =============================================================================
// SECTION 2  ROW LAYOUT -- 160 BYTES (20 u64 WORDS)
// =============================================================================
//
//   [+0]   word0:  surface_kind_id[31:0] | rect_count[39:32]
//                  | reserved[55:40] | in_use[63:56]
//   [+8]   word1:  bbox_x[31:0] | bbox_y[63:32]           (i32/i32 bit patterns)
//   [+16]  word2:  bbox_w[31:0] | bbox_h[63:32]           (i32/i32)
//   [+24]  word3:  seq (u64 monotonic)
//   [+32]  word4-5:   rect[0]: (x,y) | (w,h)              16 bytes (i32×4)
//   [+48]  word6-7:   rect[1]                             16 bytes
//   [+64]  word8-9:   rect[2]                             16 bytes
//   [+80]  word10-11: rect[3]                             16 bytes
//   [+96]  word12-13: rect[4]                             16 bytes
//   [+112] word14-15: rect[5]                             16 bytes
//   [+128] word16-17: rect[6]                             16 bytes
//   [+144] word18-19: rect[7]                             16 bytes
// Total: 160 bytes = 20 u64 words per row. 8-byte aligned.
//
// The dispatch briefing named a "96-byte pool" that is inconsistent with
// the field-list it also enumerated (8 × (i32,i32,i32,i32) = 128 bytes
// for the rect array alone). This file honours the FIELD LIST -- i32
// throughout, up to 8 rects, monotonic seq -- and treats the "96-byte"
// figure as a shorthand for the pool's row-count budget rather than a
// per-row cap. Row count DR_MAX = 32 keeps the pool at 32 * 160 = 5120
// bytes (640 u64 words), parity with window_kind's 32-row pool.
//
// in_use lives in the top byte of word0 (bit 63:56) matching the row-
// pool convention window_kind.pdx §Section 2 records. rect_count lives
// in bits [39:32] because its useful range is 0..8 (4 bits, but the
// byte slot is friendlier for shift-mask decode and keeps 16-bit
// headroom for a future "damaged-since-last-frame" bit-per-rect
// annotation without a layout bump).
//
// Rects are stored as i32 bit-patterns because a compositor that damages
// a rect whose origin is just outside the surface (an overscan flourish
// or a shadow that extends past the surface edge) MUST be able to name
// negative coordinates. The compositor clamps its own compose-time reach
// against the surface's extent; the damage region itself carries the
// declaring client's intent verbatim.
//
// bbox is the union of every added rect since the last damage_region_clear
// (or since mint). damage_region_bounds returns those four fields; a
// consumer that wants per-rect precision reads rect_count then indexes
// into the rect array (out of scope for this landing -- the compositor's
// consume path is #2295, buffer-age-aware repaint).
//
// =============================================================================
// SECTION 3  RIGHTS BITMASK
// =============================================================================
//
// Layout follows the hmk_ / surface_kind_ convention (READ 0x001, INVOKE
// 0x008, REVOKE 0x010, MINT 0x200, OBSERVE 0x400) and inserts the four
// damage-region-specific op-rights + CLEAR into the intervening 0x020..
// 0x800 range so a single AND against R_DR_ALL suffices for the mint-
// time subset test. Every OP in §Section 4 names exactly one of these
// bits as its required right.
//
//   R_DR_READ           0x001   generic query cap surface
//   R_DR_INVOKE         0x008   permission to enter cap_invoke
//   R_DR_REVOKE         0x010   revoke authority (holder side)
//   R_DR_QUERY_BOUNDS   0x020   OP_QUERY_BBOX / OP_IS_EMPTY / OP_RECT_COUNT
//   R_DR_ADD_RECT       0x040   OP_ADD_RECT (accumulate one rect)
//   R_DR_UNION          0x080   OP_UNION (fold another region in)
//   R_DR_SUBTRACT       0x100   OP_SUBTRACT (reserved for M3 downstream)
//   R_DR_MINT           0x200   factory authority (holder side of surface)
//   R_DR_OBSERVE        0x400   subscribe to per-region seq updates
//   R_DR_CLEAR          0x800   OP_CLEAR (reset rect_count to 0)
//   R_DR_ALL            0xFF9   OR of all above
//
// R_DR_CLEAR is a distinct right so a client that holds ADD_RECT +
// UNION for accumulation cannot silently drop a pending damage frame;
// only the commit-consumer (which owns the transaction) receives CLEAR
// authority. This is the P-analogue of the surface_kind commit / damage
// right separation.
//
// R_DR_SUBTRACT is reserved: no factory in this landing needs it. Its
// slot is claimed here so a future subtract op (M3-002 buffer-age-aware
// repaint may want to subtract known-clean bands) can flow through the
// same rights-mask gate without a downstream cap-shape bump.
//
// =============================================================================
// SECTION 4  OP NUMBERING
// =============================================================================
//
// Every op is arity ONE (row_id in target_ptr, sub-op in op_arg[7:0]);
// op_arg[63:8] MUST be zero -- the future dispatcher refuses a smuggled
// second value with DR_TAIL_BAD_ARG, mirroring surface_kind_ / hmk_
// dispatch discipline.
//
//   DR_OP_QUERY_BBOX       0
//   DR_OP_IS_EMPTY         1
//   DR_OP_RECT_COUNT       2
//   DR_OP_QUERY_SEQ        3
//   DR_OP_ADD_RECT         4    (four i32 packed into two u64 op args)
//   DR_OP_UNION            5    (other_row_id in op_arg)
//   DR_OP_CLEAR            6
//   DR_OP_QUERY_SURFACE    7
//   DR_OP_DEBUG_PRINT      8
//   DR_OP_MAX              8
//
// The four-i32-in-two-u64 packing convention for ADD_RECT matches the
// factory's row_id + four u64 signature: (x,y) in one u64, (w,h) in the
// next. The dispatcher's op decoder unpacks with the same shift/mask
// arithmetic the packers below use.
//
// =============================================================================
// SECTION 5  FAILURE TAXONOMY -- 0xFFFFEBC0..0xFFFFEBCF (16 slots)
// =============================================================================
//
// Fresh page, grep-verified free across src/ + design/ at landing time.
// The 16-slot band leaves headroom for the M3-002 buffer-age-aware
// repaint consumer's own decode failures (BAD_AGE, BAD_FRAME_INDEX)
// without a second reservation.
//
//   DR_OK                0             success sentinel
//   DR_TAIL_ENOSPC       0xFFFFEBCF    row pool full at mint
//   DR_TAIL_BAD_ARG      0xFFFFEBCE    op_arg[63:8] != 0
//   DR_MINT_BAD_PARENT   0xFFFFEBCD    parent kind != KIND_SURFACE
//   DR_MINT_BAD_RIGHTS   0xFFFFEBCC    rights !subset R_DR_ALL
//   DR_MINT_BAD_SURFACE  0xFFFFEBCB    surface row_id invalid (zero or
//                                      out of u32 range)
//   DR_BAD_SLOT          0xFFFFEBCA    row_id >= DR_MAX or not in_use
//   DR_WRONG_KIND        0xFFFFEBC9    cap not KIND_DAMAGE_REGION at
//                                      cap_invoke
//   DR_REVOKE_ALREADY    0xFFFFEBC8    double-revoke against same slot
//   DR_BAD_PTR           0xFFFFEBC7    row_id passed as sentinel u64::MAX
//   DR_RECT_FULL         0xFFFFEBC6    reserved: add_rect at rect_count
//                                      == 8; this file's policy is to
//                                      extend bbox WITHOUT appending
//                                      (return DR_OK), so this sentinel
//                                      is claimed but not emitted -- a
//                                      stricter downstream policy may
//                                      wire it in
//   DR_BAD_RECT          0xFFFFEBC5    w or h negative (a rect with
//                                      negative extent is meaningless)
//   DR_UNION_OVERFLOW    0xFFFFEBC4    reserved: union that cannot fit
//                                      folded discrete rects; policy in
//                                      this file is to extend bbox with
//                                      the other side's bbox instead
//   DR_UNSUP_OP          0xFFFFEBC3    op ordinal > DR_OP_MAX
//   DR_DECODE_BAD        0xFFFFEBC2    generic decode-shape reject
//   DR_ROW_NONE          0xFFFFEBC1    linear-scan sentinel
//   DR_UNUSED            0xFFFFEBC0    reserved band tail
//
// =============================================================================
// SECTION 6  LABEL PREFIX
// =============================================================================
//
// LABEL PREFIX: `damage_kind_` (per dispatch briefing). Every asm-body
// label below is `damage_kind_<local>` so no collision with paideia-as
// reserved keywords (`loop`, `if`, `let`, `while`, `for`, `match`, `pub`,
// `mod`, `use`, `fn`, `struct`, `enum`, `impl`, `trait`, `type`, `where`,
// `move`, `mut`, `ref`) per feedback_paideia_as_reserved_labels. Each
// local suffix is <= 6 chars where possible so the fully-qualified label
// stays inside the ring's log-line budget.

module DamageKind = structure {

  // ==========================================================================
  // Identity.
  // ==========================================================================

  pub let KIND_DAMAGE_REGION : u64 = 0x1D9
  pub let DR_PARENT_KIND     : u64 = 0x1B8            // KIND_SURFACE (B6-01)

  // ==========================================================================
  // Row pool sizing.
  // ==========================================================================

  pub let DR_MAX        : u64 = 32                    // rows in pool
  pub let DR_ROW_BYTES  : u64 = 160                   // per-row size
  pub let DR_ROW_WORDS  : u64 = 20                    // per-row u64 count
  pub let DR_MAX_RECTS  : u64 = 8                     // rects per region

  // ==========================================================================
  // Rights bitmask.
  // ==========================================================================

  pub let R_DR_READ          : u64 = 0x001
  pub let R_DR_INVOKE        : u64 = 0x008
  pub let R_DR_REVOKE        : u64 = 0x010
  pub let R_DR_QUERY_BOUNDS  : u64 = 0x020
  pub let R_DR_ADD_RECT      : u64 = 0x040
  pub let R_DR_UNION         : u64 = 0x080
  pub let R_DR_SUBTRACT      : u64 = 0x100
  pub let R_DR_MINT          : u64 = 0x200
  pub let R_DR_OBSERVE       : u64 = 0x400
  pub let R_DR_CLEAR         : u64 = 0x800
  pub let R_DR_ALL           : u64 = 0xFF9
     // 0x001|0x008|0x010|0x020|0x040|0x080|0x100|0x200|0x400|0x800

  // ==========================================================================
  // Op numbering.
  // ==========================================================================

  pub let DR_OP_QUERY_BBOX     : u64 = 0
  pub let DR_OP_IS_EMPTY       : u64 = 1
  pub let DR_OP_RECT_COUNT     : u64 = 2
  pub let DR_OP_QUERY_SEQ      : u64 = 3
  pub let DR_OP_ADD_RECT       : u64 = 4
  pub let DR_OP_UNION          : u64 = 5
  pub let DR_OP_CLEAR          : u64 = 6
  pub let DR_OP_QUERY_SURFACE  : u64 = 7
  pub let DR_OP_DEBUG_PRINT    : u64 = 8
  pub let DR_OP_MAX            : u64 = 8

  // ==========================================================================
  // Failure taxonomy 0xFFFFEBC0..0xFFFFEBCF.
  // ==========================================================================

  pub let DR_OK                : u64 = 0
  pub let DR_TAIL_ENOSPC       : u64 = 0xFFFFEBCF
  pub let DR_TAIL_BAD_ARG      : u64 = 0xFFFFEBCE
  pub let DR_MINT_BAD_PARENT   : u64 = 0xFFFFEBCD
  pub let DR_MINT_BAD_RIGHTS   : u64 = 0xFFFFEBCC
  pub let DR_MINT_BAD_SURFACE  : u64 = 0xFFFFEBCB
  pub let DR_BAD_SLOT          : u64 = 0xFFFFEBCA
  pub let DR_WRONG_KIND        : u64 = 0xFFFFEBC9
  pub let DR_REVOKE_ALREADY    : u64 = 0xFFFFEBC8
  pub let DR_BAD_PTR           : u64 = 0xFFFFEBC7
  pub let DR_RECT_FULL         : u64 = 0xFFFFEBC6
  pub let DR_BAD_RECT          : u64 = 0xFFFFEBC5
  pub let DR_UNION_OVERFLOW    : u64 = 0xFFFFEBC4
  pub let DR_UNSUP_OP          : u64 = 0xFFFFEBC3
  pub let DR_DECODE_BAD        : u64 = 0xFFFFEBC2
  pub let DR_ROW_NONE          : u64 = 0xFFFFEBC1

  pub let DR_U32_MAX : u64 = 0xFFFFFFFF

  // ==========================================================================
  // THE ONE STATE CELL. 32 rows * 20 u64 = 640 u64 = 5120 bytes.
  // Plus a 4-slot counter table (mints / revokes / refused / mutations).
  // ==========================================================================

  pub let mut _dr_table : [u64; 640] = uninit @align(64)
  pub let mut _dr_stats : [u64; 4]   = uninit @align(64)

  pub let DR_ST_MINTS     : u64 = 0
  pub let DR_ST_REVOKES   : u64 = 1
  pub let DR_ST_REFUSED   : u64 = 2
  pub let DR_ST_MUTATIONS : u64 = 3

  // ==========================================================================
  // Fingerprint tag.
  //
  // ONE line ending in `[legacy: ... OK]` per softarch discipline. The
  // future kernel-side kind_damage_region mint body will emit this string
  // via klog_s1_x1 on successful mint; until that landing arrives the
  // string is a data-only constant and needs allowlisting in
  // tools/verify-fingerprint-coverage.sh with reason "Wave0-B9-06 (#2294)
  // KIND_DAMAGE_REGION user-space cap-kind decl; kernel mint body not yet
  // landed; user-space damage_region_mint below is the transitional
  // authority that does not emit klog (compositor process, ring 3)". Main
  // coordinator adds that entry at Batch 9 close-out.
  //
  // Length: "damage region mint ok [legacy: DAMAGE REGION MINT OK]\0" =
  // 54 bytes.
  // ==========================================================================

  pub let pdx_kind_damage_region_meta : [u8; 54] = "damage region mint ok [legacy: DAMAGE REGION MINT OK]\0"

  // ==========================================================================
  // Section 7  Counter primitives.
  // ==========================================================================

  pub let damage_kind_stats_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-06 (#2294): clear row table + counters at boot. 32 rows * 20 u64 = 640 u64 for _dr_table + 4 u64 for _dr_stats. Leaf; no callee-save discipline; rax/rcx clobber. Uses cmp reg,imm rather than test (paideia-as U1605). Labels prefixed damage_kind_.",
      block: {
        lea r10, [rip + _dr_table];
        xor rax, rax;
        xor rcx, rcx;
      damage_kind_srz_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 640;
        jb  damage_kind_srz_rows;

        lea r10, [rip + _dr_stats];
        xor rcx, rcx;
      damage_kind_srz_st:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  damage_kind_srz_st;
        ret
      }
    }

  pub let damage_kind_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-06 (#2294): counter bump. Encoder-conservative load-inc-store; no add reg,[mem] (paideia-as ban). Labels prefixed damage_kind_.",
      block: {
        cmp rdi, 4;
        jae damage_kind_nt_out;
        lea r10, [rip + _dr_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      damage_kind_nt_out:
        ret
      }
    }

  pub let damage_kind_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-06 (#2294): counter read. Labels prefixed damage_kind_.",
      block: {
        cmp rdi, 4;
        jae damage_kind_stt_zero;
        lea r10, [rip + _dr_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      damage_kind_stt_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Section 8  Validators.
  // ==========================================================================

  // damage_kind_rights_valid: 1 iff rights subset of R_DR_ALL.
  pub let damage_kind_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B9-06 (#2294): subset test against R_DR_ALL = 0xFF9. Labels prefixed damage_kind_.",
      block: {
        mov rax, rdi;
        mov r10, 0xFF9;
        and rax, r10;
        cmp rax, rdi;
        jne damage_kind_rv_no;
        mov rax, 1;
        ret;
      damage_kind_rv_no:
        xor rax, rax;
        ret
      }
    }

  // damage_kind_u32_valid: 1 iff v <= 0xFFFFFFFF.
  pub let damage_kind_u32_valid : (u64) -> u64 !{} @{} =
    fn (v: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B9-06 (#2294): 1 iff v fits in u32. Reused for surface_kind_id and every u32-shaped op arg. Labels prefixed damage_kind_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  damage_kind_uv_no;
        mov rax, 1;
        ret;
      damage_kind_uv_no:
        xor rax, rax;
        ret
      }
    }

  // damage_kind_rect_valid: 1 iff w >= 0 AND h >= 0 (rect with negative
  // extent is meaningless; the rect origin x/y MAY be negative to name
  // an overscan/shadow band that starts outside the surface's extent).
  //
  // w and h arrive as u64 holding i32 bit-patterns. i32 sign bit is bit
  // 31; a negative i32 has bit 31 set. Extract by shifting right 31 and
  // testing against 1. Uses shr rather than a bit-test opcode; the
  // paideia-as resolver does not carry `test`.
  pub let damage_kind_rect_valid : (u64, u64) -> u64 !{} @{} =
    fn (w: u64) (h: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B9-06 (#2294): 1 iff sign bit of w AND sign bit of h are both zero. Uses shr r,31 + cmp r,0 rather than test (paideia-as U1605). Labels prefixed damage_kind_.",
      block: {
        // Mask to u32 first (caller may have passed a wider bit pattern).
        mov r10, 0xFFFFFFFF;
        mov rax, rdi;
        and rax, r10;
        shr rax, 31;
        cmp rax, 0;
        jne damage_kind_rvv_no;
        mov rax, rsi;
        and rax, r10;
        shr rax, 31;
        cmp rax, 0;
        jne damage_kind_rvv_no;
        mov rax, 1;
        ret;
      damage_kind_rvv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Section 9  Row pool: valid / alloc / free.
  // ==========================================================================

  // damage_kind_tail_valid: 1 iff row_id < DR_MAX and in_use.
  pub let damage_kind_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-06 (#2294): 1 iff row_id < DR_MAX AND top byte of word0 nonzero. Uses imul reg,reg,imm for row_id * 160 (encoder supports 3-operand imul with imm32). Labels prefixed damage_kind_.",
      block: {
        cmp rdi, 32;
        jae damage_kind_tv_no;
        lea r10, [rip + _dr_table];
        mov r11, rdi;
        imul r11, r11, 160;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  damage_kind_tv_no;
        mov rax, 1;
        ret;
      damage_kind_tv_no:
        xor rax, rax;
        ret
      }
    }

  // damage_kind_row_base(row_id) -> table_base + row_id*160 | 0 on
  // out-of-range. Helper used by every mutation body to avoid re-
  // computing the row base inline.
  pub let damage_kind_row_base : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-06 (#2294): return &_dr_table[row_id*160]; 0 iff row_id >= DR_MAX. NOT a validity check for in_use; that gate is damage_kind_tail_valid. Labels prefixed damage_kind_.",
      block: {
        cmp rdi, 32;
        jae damage_kind_rb_zero;
        lea rax, [rip + _dr_table];
        mov r11, rdi;
        imul r11, r11, 160;
        add rax, r11;
        ret;
      damage_kind_rb_zero:
        xor rax, rax;
        ret
      }
    }

  // damage_kind_tail_alloc(surface_kind_id) -> row_id | DR_TAIL_ENOSPC.
  // Low-first scan; on claim, zero every word of the row, then set
  // word0 = surface_kind_id[31:0] | in_use<<56.
  pub let damage_kind_tail_alloc : (u64) -> u64 !{mem} @{} =
    fn (surface_kind_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-06 (#2294): claim one KIND_DAMAGE_REGION row. Low-first scan over 32 rows of 160 bytes. On claim: write in_use|surface_kind_id into word0 then zero the remaining 19 words. Two-push prologue keeps rsp%16==0 for the leaf (no nested call). Uses cmp reg,0 (not test). Labels prefixed damage_kind_.",
      block: {
        push rbx;
        push r12;

        mov r12, rdi;                          // r12 = surface_kind_id
        xor rbx, rbx;                          // rbx = idx

      damage_kind_ta_scan:
        cmp rbx, 32;
        jae damage_kind_ta_enospc;
        lea r10, [rip + _dr_table];
        mov r11, rbx;
        imul r11, r11, 160;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  damage_kind_ta_claim;
        add rbx, 1;
        jmp damage_kind_ta_scan;

      damage_kind_ta_claim:
        // word0 = surface_kind_id[31:0] | (1 << 56).
        mov rax, r12;
        mov r11, 0xFFFFFFFF;
        and rax, r11;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0], rax;

        // word1..word19 = 0.
        xor rax, rax;
        mov [r10 + 8],   rax;
        mov [r10 + 16],  rax;
        mov [r10 + 24],  rax;
        mov [r10 + 32],  rax;
        mov [r10 + 40],  rax;
        mov [r10 + 48],  rax;
        mov [r10 + 56],  rax;
        mov [r10 + 64],  rax;
        mov [r10 + 72],  rax;
        mov [r10 + 80],  rax;
        mov [r10 + 88],  rax;
        mov [r10 + 96],  rax;
        mov [r10 + 104], rax;
        mov [r10 + 112], rax;
        mov [r10 + 120], rax;
        mov [r10 + 128], rax;
        mov [r10 + 136], rax;
        mov [r10 + 144], rax;
        mov [r10 + 152], rax;

        mov rax, rbx;
        jmp damage_kind_ta_out;

      damage_kind_ta_enospc:
        mov rax, 0xFFFFEBCF;                   // DR_TAIL_ENOSPC

      damage_kind_ta_out:
        pop r12;
        pop rbx;
        ret
      }
    }

  // damage_kind_tail_free: zero every word of the row (including in_use
  // marker). No-op when row_id out of range. Leaf.
  pub let damage_kind_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-06 (#2294): scrub one row (all 20 words). Labels prefixed damage_kind_.",
      block: {
        cmp rdi, 32;
        jae damage_kind_tf_out;
        lea r10, [rip + _dr_table];
        mov r11, rdi;
        imul r11, r11, 160;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],   rax;
        mov [r10 + 8],   rax;
        mov [r10 + 16],  rax;
        mov [r10 + 24],  rax;
        mov [r10 + 32],  rax;
        mov [r10 + 40],  rax;
        mov [r10 + 48],  rax;
        mov [r10 + 56],  rax;
        mov [r10 + 64],  rax;
        mov [r10 + 72],  rax;
        mov [r10 + 80],  rax;
        mov [r10 + 88],  rax;
        mov [r10 + 96],  rax;
        mov [r10 + 104], rax;
        mov [r10 + 112], rax;
        mov [r10 + 120], rax;
        mov [r10 + 128], rax;
        mov [r10 + 136], rax;
        mov [r10 + 144], rax;
        mov [r10 + 152], rax;
      damage_kind_tf_out:
        ret
      }
    }

  // ==========================================================================
  // Section 10  Mint / revoke.
  // ==========================================================================

  // damage_region_mint(surface: u64) -> row_id | DR_MINT_BAD_SURFACE
  //                                    | DR_TAIL_ENOSPC.
  //
  // The dispatch briefing's `damage_region_mint(surface) -> row_id`
  // signature. The `surface` argument is a KIND_SURFACE row_id (not a
  // kind ordinal); the caller has already resolved cap -> row. Gate:
  //   (1) surface != 0             -> DR_MINT_BAD_SURFACE
  //   (2) surface fits in u32      -> DR_MINT_BAD_SURFACE
  //   (3) tail_alloc(surface)      -> row_id or DR_TAIL_ENOSPC (funnel)
  // Success bumps _dr_stats[DR_ST_MINTS]; refusal bumps DR_ST_REFUSED.
  pub let damage_region_mint : (u64) -> u64 !{mem} @{} =
    fn (surface: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-06 (#2294): mint one KIND_DAMAGE_REGION row. Three-push prologue (rbx=surface, r12=alloc-result, r13=ENOSPC-sentinel) leaves rsp%16==0 (entry 8, minus 24 == -16 == %16 0) across every nested call to u32_valid, tail_alloc, note. Refusal funnel bumps DR_ST_REFUSED once. Labels prefixed damage_kind_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                          // rbx = surface

        // (1) surface != 0.
        cmp rbx, 0;
        je  damage_kind_dm_bad;

        // (2) surface fits in u32.
        mov rdi, rbx;
        call damage_kind_u32_valid;
        cmp rax, 0;
        je  damage_kind_dm_bad;

        // (3) tail_alloc(surface).
        mov rdi, rbx;
        call damage_kind_tail_alloc;
        mov r12, rax;                          // stash result

        // DR_TAIL_ENOSPC sentinel funnels through refused too.
        mov r13, 0xFFFFEBCF;
        cmp r12, r13;
        je  damage_kind_dm_enospc;

        // Success: bump mints, return row_id.
        mov rdi, 0;                            // DR_ST_MINTS
        call damage_kind_note;
        mov rax, r12;
        jmp damage_kind_dm_out;

      damage_kind_dm_bad:
        mov r12, 0xFFFFEBCB;                   // DR_MINT_BAD_SURFACE
      damage_kind_dm_enospc:
        // r12 already carries the sentinel (either DR_TAIL_ENOSPC from
        // tail_alloc or DR_MINT_BAD_SURFACE set just above).
        mov rdi, 2;                            // DR_ST_REFUSED
        call damage_kind_note;
        mov rax, r12;

      damage_kind_dm_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // damage_region_revoke(row_id) -> DR_OK | DR_BAD_SLOT | DR_REVOKE_ALREADY.
  pub let damage_region_revoke : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-06 (#2294): revoke one row. Out-of-range -> DR_BAD_SLOT; not in_use -> DR_REVOKE_ALREADY; else free + bump revokes + DR_OK. One-push prologue keeps rsp%16==0 for the nested calls to tail_valid + tail_free + note (entry 8, -8 == 0). Labels prefixed damage_kind_.",
      block: {
        push r12;

        mov r12, rdi;

        mov r10, 32;
        cmp r12, r10;
        jae damage_kind_drv_bad;

        mov rdi, r12;
        call damage_kind_tail_valid;
        cmp rax, 0;
        je  damage_kind_drv_already;

        mov rdi, r12;
        call damage_kind_tail_free;
        mov rdi, 1;                            // DR_ST_REVOKES
        call damage_kind_note;
        xor rax, rax;
        jmp damage_kind_drv_out;

      damage_kind_drv_bad:
        mov rax, 0xFFFFEBCA;                   // DR_BAD_SLOT
        jmp damage_kind_drv_out;
      damage_kind_drv_already:
        mov rax, 0xFFFFEBC8;                   // DR_REVOKE_ALREADY

      damage_kind_drv_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Section 11  Field readers.
  //
  // damage_region_bounds returns the four bbox fields via four getters
  // (paideia-as functions return one u64; a tuple return needs an out-
  // ptr; the four-getter shape is the surface_geometry_ precedent).
  // ==========================================================================

  // damage_region_surface(row_id) -> surface_kind_id | DR_BAD_SLOT.
  pub let damage_region_surface : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-06 (#2294): read surface_kind_id at word0[31:0]. Guard via tail_valid. Labels prefixed damage_kind_.",
      block: {
        push r12;
        mov r12, rdi;
        call damage_kind_tail_valid;
        cmp rax, 0;
        je  damage_kind_drs_bad;
        lea r10, [rip + _dr_table];
        mov r11, r12;
        imul r11, r11, 160;
        add r10, r11;
        mov rax, [r10 + 0];
        mov r11, 0xFFFFFFFF;
        and rax, r11;
        jmp damage_kind_drs_out;
      damage_kind_drs_bad:
        mov rax, 0xFFFFEBCA;                   // DR_BAD_SLOT
      damage_kind_drs_out:
        pop r12;
        ret
      }
    }

  // damage_region_rect_count(row_id) -> rect_count | DR_BAD_SLOT.
  // rect_count lives in word0 bits [39:32].
  pub let damage_region_rect_count : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-06 (#2294): read rect_count at word0[39:32]. Labels prefixed damage_kind_.",
      block: {
        push r12;
        mov r12, rdi;
        call damage_kind_tail_valid;
        cmp rax, 0;
        je  damage_kind_drc_bad;
        lea r10, [rip + _dr_table];
        mov r11, r12;
        imul r11, r11, 160;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 32;
        mov r11, 0xFF;
        and rax, r11;
        jmp damage_kind_drc_out;
      damage_kind_drc_bad:
        mov rax, 0xFFFFEBCA;
      damage_kind_drc_out:
        pop r12;
        ret
      }
    }

  // damage_region_seq(row_id) -> seq | 0 on bad slot (a fresh row has
  // seq == 0 so the sentinel is indistinguishable; callers that care
  // check damage_kind_tail_valid first).
  pub let damage_region_seq : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-06 (#2294): read seq at word3. Labels prefixed damage_kind_.",
      block: {
        push r12;
        mov r12, rdi;
        call damage_kind_tail_valid;
        cmp rax, 0;
        je  damage_kind_dsq_zero;
        lea r10, [rip + _dr_table];
        mov r11, r12;
        imul r11, r11, 160;
        add r10, r11;
        mov rax, [r10 + 24];
        jmp damage_kind_dsq_out;
      damage_kind_dsq_zero:
        xor rax, rax;
      damage_kind_dsq_out:
        pop r12;
        ret
      }
    }

  // damage_region_is_empty(row_id) -> 1 (empty) | 0 (non-empty). Bad
  // slot -> 1 (an unreadable row is conservatively empty for the caller
  // that gates a repaint on damage presence). Empty == rect_count == 0.
  pub let damage_region_is_empty : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-06 (#2294): 1 iff rect_count field is zero. Bad slot -> 1 (conservative). Labels prefixed damage_kind_.",
      block: {
        push r12;
        mov r12, rdi;
        call damage_kind_tail_valid;
        cmp rax, 0;
        je  damage_kind_die_yes;

        lea r10, [rip + _dr_table];
        mov r11, r12;
        imul r11, r11, 160;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 32;
        mov r11, 0xFF;
        and rax, r11;
        cmp rax, 0;
        jne damage_kind_die_no;

      damage_kind_die_yes:
        mov rax, 1;
        jmp damage_kind_die_out;
      damage_kind_die_no:
        xor rax, rax;
      damage_kind_die_out:
        pop r12;
        ret
      }
    }

  // damage_region_bbox_x(row_id) -> bbox_x (u32 bit-pattern of i32).
  pub let damage_region_bbox_x : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-06 (#2294): read bbox_x at word1[31:0]. Returned as u32 bit-pattern; caller sign-extends. Bad slot -> DR_BAD_SLOT. Labels prefixed damage_kind_.",
      block: {
        push r12;
        mov r12, rdi;
        call damage_kind_tail_valid;
        cmp rax, 0;
        je  damage_kind_dbx_bad;
        lea r10, [rip + _dr_table];
        mov r11, r12;
        imul r11, r11, 160;
        add r10, r11;
        mov rax, [r10 + 8];
        mov r11, 0xFFFFFFFF;
        and rax, r11;
        jmp damage_kind_dbx_out;
      damage_kind_dbx_bad:
        mov rax, 0xFFFFEBCA;
      damage_kind_dbx_out:
        pop r12;
        ret
      }
    }

  // damage_region_bbox_y(row_id) -> bbox_y.
