  // damage_region_bounds(row_id) is expressed as the four getters above
  // (damage_region_bbox_{x,y,w,h}); the dispatch briefing's tuple return
  // is fulfilled by that quartet, matching surface_geometry_'s field-
  // reader shape. A caller that wants an atomic snapshot reads seq
  // before and after, and retries on mismatch (compositor-side pattern).

  // ==========================================================================
  // Section 12  Rect-array accessors (per-index; caller reads
  //             rect_count first, then indexes into the array).
  // ==========================================================================

  // damage_region_rect_x(row_id, idx) -> rect[idx].x | DR_BAD_SLOT.
  // idx bounds: 0..DR_MAX_RECTS (out-of-range -> DR_BAD_RECT).
  pub let damage_region_rect_x : (u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64) (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-06 (#2294): read rect[idx].x. Row-base offset = 32 + idx*16. Guards: tail_valid + idx<8. Labels prefixed damage_kind_.",
      block: {
        push rbx;
        push r12;
        sub  rsp, 8;
        mov rbx, rdi;
        mov r12, rsi;

        cmp r12, 8;
        jae damage_kind_drx_badr;

        mov rdi, rbx;
        call damage_kind_tail_valid;
        cmp rax, 0;
        je  damage_kind_drx_bad;

        lea r10, [rip + _dr_table];
        mov r11, rbx;
        imul r11, r11, 160;
        add r10, r11;

        // rect base = row_base + 32 + idx*16
        mov r11, r12;
        imul r11, r11, 16;
        add r10, r11;
        mov rax, [r10 + 32];
        mov r11, 0xFFFFFFFF;
        and rax, r11;
        jmp damage_kind_drx_out;

      damage_kind_drx_badr:
        mov rax, 0xFFFFEBC5;                   // DR_BAD_RECT
        jmp damage_kind_drx_out;
      damage_kind_drx_bad:
        mov rax, 0xFFFFEBCA;                   // DR_BAD_SLOT

      damage_kind_drx_out:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }

  // damage_region_rect_y(row_id, idx) -> rect[idx].y.
  pub let damage_region_rect_y : (u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64) (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-06 (#2294): read rect[idx].y at word4+idx*2 high half. Labels prefixed damage_kind_.",
      block: {
        push rbx;
        push r12;
        sub  rsp, 8;
        mov rbx, rdi;
        mov r12, rsi;
        cmp r12, 8;
        jae damage_kind_dry_badr;
        mov rdi, rbx;
