        add r10, r11;
        mov r11, r12;
        imul r11, r11, 16;
        add r10, r11;
        mov rax, [r10 + 32];
        shr rax, 32;
        jmp damage_kind_dry_out;
      damage_kind_dry_badr:
        mov rax, 0xFFFFEBC5;
        jmp damage_kind_dry_out;
      damage_kind_dry_bad:
        mov rax, 0xFFFFEBCA;
      damage_kind_dry_out:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }

  // damage_region_rect_w(row_id, idx) -> rect[idx].w.
  pub let damage_region_rect_w : (u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64) (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-06 (#2294): read rect[idx].w. Labels prefixed damage_kind_.",
      block: {
        push rbx;
        push r12;
        sub  rsp, 8;
        mov rbx, rdi;
        mov r12, rsi;
        cmp r12, 8;
        jae damage_kind_drw_badr;
        mov rdi, rbx;
        call damage_kind_tail_valid;
        cmp rax, 0;
