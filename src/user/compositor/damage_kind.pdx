  // damage_region_rect_h(row_id, idx) -> rect[idx].h.
  pub let damage_region_rect_h : (u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64) (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-06 (#2294): read rect[idx].h at second-word high half. Labels prefixed damage_kind_.",
      block: {
        push rbx;
        push r12;
        sub  rsp, 8;
        mov rbx, rdi;
        mov r12, rsi;
        cmp r12, 8;
        jae damage_kind_drh_badr;
        mov rdi, rbx;
        call damage_kind_tail_valid;
        cmp rax, 0;
        je  damage_kind_drh_bad;
