// src/user/compositor/keynav_focus_ring.pdx -- Wave0-B12-08 (paideia-os #2312)
//
// KeynavFocusRing -- visual focus-ring painter + skip-link hotkey handler.
//
// The compositor's keyboard-navigation cursor (KeynavTaborder, Wave0-B9-10
// / paideia-os #2311) advances the ACTIVE focus node through the a11y
// tree; this module supplies the two follow-on user-visible signals:
//
//   (a) an outline that HIGHLIGHTS which widget currently holds focus so
//       a sighted user does not lose the caret across tab keystrokes
//       (focus_ring_paint -- lays down 4 damage-region-shaped strips
//       framing the widget rect at a caller-supplied thickness and
//       padding);
//   (b) SKIP-LINK hotkeys the user presses to jump the focus cursor
//       past uninteresting spans of the a11y tree straight to the next
//       heading / landmark / main region / navigation region
//       (focus_ring_handle_skip_link -- walks the a11y tree by role).
//
// Both signals share the same posture the KeynavTaborder module took:
// LOGIC MODULE, NOT A KIND. This file owns NO row pool, NO arena, NO
// global state; the FocusRingConfig struct is a caller-allocated 16-byte
// value passed by pointer (mirror of KeynavTaborder's cursor), and the
// a11y-tree walk in focus_ring_handle_skip_link is a pure translation
// from (keycode, tree_kind_id) -> (node_id) through the KIND_A11Y_TREE
// arena accessors (a11y_tree_arena_base, a11y_tree_hdr_node_count,
// a11y_tree_node_addr, a11y_tree_node_role) that tree_kind.pdx already
// exposes.
//
// Companion:
//   * src/user/compositor/keynav_taborder.pdx (Wave0-B9-10, paideia-os
//     #2311) -- the KeynavTaborder module this file layers over.
//     focus_ring_paint operates on the widget currently pointed at by
//     the cursor's current_node_id; focus_ring_handle_skip_link produces
//     a new node_id that the compositor keyboard-focus handler feeds
//     back into keynav_taborder_cursor_set_current.
//   * src/user/a11y/tree_kind.pdx (Wave0-B8-03, paideia-os #2302) --
//     KIND_A11Y_TREE. Same arena-accessor surface KeynavTaborder leans
//     on; every accessor this file uses (arena_base, hdr_node_count,
//     node_addr, node_role) is a pub let in TreeKind and resolves
//     through the linker's global-symbol table (the same cross-module
//     call shape src/user/shell.pdx uses against syscall_shim.pdx).
//
// =============================================================================
// SECTION 0  WHY THIS MODULE EXISTS  --  NOVEL-CLEAN POSTURE
// =============================================================================
//
// FOCUS-RING SEPARATE FROM WIDGET STATE.  POSIX-shaped toolkits (GTK,
// Qt, wxWidgets) all attach the focus indicator to the widget itself:
// the widget owns a "has-focus" bool, and paints an outline inside its
// own paint method when the bool is set. Two problems flow out of that:
//
//   1. The focus-ring style (thickness, colour, contrast, padding) is
//      duplicated across every widget class -- a system-wide accessible
//      "high-contrast focus ring" preference has to touch every paint
//      method to bite.
//   2. A widget that has been marked HIDDEN in the visual tree but still
//      carries has-focus == true paints an INVISIBLE focus indicator --
//      the user cannot see where the cursor lives.
//
// paideia-os collapses the two: the focus RING is a compositor concern
// (this module), the focus IDENTITY is the a11y tree's concern
// (KeynavTaborder + KIND_A11Y_TREE), and painting is driven from the
// cursor's current_node_id ONCE per keystroke rather than smeared across
// every widget class. A system-wide "high-contrast focus ring" preference
// mutates ONE FocusRingConfig value.
//
// SKIP-LINKS AS A COMPOSITOR PRIMITIVE.  WCAG 2.2 §2.4.1 (Bypass Blocks)
// requires a mechanism to skip past repeated content. HTML pages ship
// ad-hoc "<a href=#main>Skip to main</a>" anchors that are frequently
// visually hidden and often broken. This module makes skip-links a
// COMPOSITOR-LEVEL keystroke that walks the a11y tree by role, so every
// window's landmarks and headings are reachable via the same fixed
// hotkey pattern (Ctrl+H headings, Ctrl+L landmarks, Ctrl+M main region,
// Ctrl+N navigation region). Widgets do NOT declare skip-link anchors;
// their role in the a11y tree is the anchor.
//
// LOGIC MODULE, NOT A KIND.  Same rationale KeynavTaborder took (§0
// there): no KIND_KEYNAV_FOCUS_RING cap, no row pool, no arena. The
// FocusRingConfig VALUE (16 bytes = 2 x u64) is caller-allocated; the
// module owns NO global state. Sealed by consumption: a caller that
// reaches this module has already dereferenced a KIND_A11Y_TREE row_id
// (that requires RIGHT_A11Y_QUERY_TREE per tree_kind.pdx §A), so the
// authority check happens ONE layer up.
//
// =============================================================================
// SECTION 1  KIND_* SLOT ALLOCATION
// =============================================================================
//
// N/A -- value-type module. No KIND slot is claimed. See §0 rationale.
//
// =============================================================================
// SECTION 2  FOCUSRINGCONFIG LAYOUT  (16 BYTES = 2 x u64)
// =============================================================================
//
// One FocusRingConfig describes ONE ring style. The caller allocates the
// 16-byte value in its own memory (typically inside a per-seat or per-
// display preference block) and passes a pointer into focus_ring_paint.
//
//   [+0]  word0:  thickness_px[7:0] | padding_px[15:8]
//                 | high_contrast_mode[23:16] | reserved[63:24]
//   [+8]  word1:  ring_color_rgba[31:0] | reserved[63:32]
//
// Fields:
//   thickness_px: u8       -- ring stroke width in pixels. Default 2.
//                             Range 0..255 (0 disables the ring).
//   padding_px: u8         -- gap between the widget's outer edge and the
//                             ring's inner edge. Default 2.
//                             Range 0..255.
//   high_contrast_mode: u8 -- 0 = use ring_color_rgba as-is; 1 = tell
//                             the future rasterizer to substitute the
//                             system's high-contrast focus colour
//                             (accessibility preference override). At
//                             THIS landing the paint routine writes the
//                             strip rects only; colour substitution
//                             belongs to the rasterizer that consumes
//                             the strip list, not to this module.
//   ring_color_rgba: u32   -- packed R8G8B8A8. Default 0x3B82F680
//                             (Tailwind blue-500 @ 50% alpha), matching
//                             the design/kernel/kind-tui-canvas.md focus
//                             palette proposal.
//
// The config is COPYABLE: two configs holding the same word0/word1
// bytes are indistinguishable. It does NOT hold a reference to any
// widget or a11y tree; the same config can be reused across every
// widget the compositor paints.
//
// =============================================================================
// SECTION 3  WIDGET RECT + SURFACE OUTPUT LAYOUT
// =============================================================================
//
// widget_rect_ptr points at a 16-byte value shaped like a
// KIND_DAMAGE_REGION rect (mirror of damage_kind.pdx §2's rect
// encoding), i.e., two u64 words:
//
//   [+0]  word0:  x[31:0] | y[63:32]           (i32 bit patterns)
//   [+8]  word1:  w[31:0] | h[63:32]           (i32)
//
// Signed 32-bit semantics: a widget rect may extend past the compositor
// origin (negative x/y) when a workspace pans off-screen; the ring's 4
// strips inherit those semantics. Arithmetic in this module is done in
// u64 with 0xFFFFFFFF masking at the store site; wrap-around inside 32
// bits matches signed-two's-complement semantics for the (padding +
// thickness < 512) range this module cares about.
//
// surface_ptr points at a caller-allocated 72-byte scratch buffer where
// focus_ring_paint writes the RESULT: a 4-rect strip list framing the
// widget with the ring style. Layout matches damage_kind.pdx's rect
// list convention:
//
//   [+0]   word0:   rect_count (u64, always written as 4)
//   [+8]   rect[0]: TOP    strip (16 bytes: x,y,w,h as i32x4)
//   [+24]  rect[1]: BOTTOM strip
//   [+40]  rect[2]: LEFT   strip
//   [+56]  rect[3]: RIGHT  strip
//
// Total: 72 bytes required in surface_ptr. Each rect is a 2-word
// (x[31:0] | y[63:32], w[31:0] | h[63:32]) packed value.
//
// The four strips compose to the ring outline WITHOUT double-counting
// the corners:
//   TOP    = (x - p - t, y - p - t, w + 2(p+t), t)
//   BOTTOM = (x - p - t, y + h + p, w + 2(p+t), t)
//   LEFT   = (x - p - t, y - p,     t,          h + 2p)
//   RIGHT  = (x + w + p, y - p,     t,          h + 2p)
// where p = padding_px and t = thickness_px. TOP and BOTTOM span the
// full outer width so their ends cover the corners; LEFT and RIGHT stay
// inside that band so they do not overlap.
//
// A future landing that lands a real pixel rasterizer consumes this
// rect list AS IF it were a KIND_DAMAGE_REGION (the layout is byte-
// identical to damage_kind's row layout modulo the surface_kind_id /
// bbox / seq header) and paints the ring colour into each strip.
//
// =============================================================================
// SECTION 4  SKIP-LINK KEYCODE + ROLE ENCODING
// =============================================================================
//
// KEYCODE ENCODING.  The compositor's input pipeline routes keystrokes
// as a packed u64 with the low 16 bits carrying (modifier_bitmap[15:8]
// | base_key[7:0]). This module cares only about that low 16 bits:
//
//   keycode[7:0]  = base key (ASCII-shaped: H=0x48, L=0x4C, M=0x4D, N=0x4E)
//   keycode[15:8] = modifier bitmap (bit 0 = SHIFT, bit 1 = CTRL,
//                                    bit 2 = ALT,   bit 3 = META)
//
// SKIP-LINK PATTERN.  focus_ring_is_skip_link_key returns 1 iff:
//   (keycode >> 8) & 0xFF  ==  MOD_CTRL (0x02)   -- exact match, not
//                                                   subset, so Ctrl+Shift
//                                                   is deliberately NOT
//                                                   a skip-link (leaves
//                                                   Ctrl+Shift+* for
//                                                   window management)
//   AND (keycode & 0xFF) in {H(0x48), L(0x4C), M(0x4D), N(0x4E)}
//
// ROLE TARGETS.  Each skip-link maps to one a11y role ordinal:
//
//   Ctrl+H  ->  ROLE_HEADING       (12)
//   Ctrl+L  ->  ROLE_LANDMARK      (13)
//   Ctrl+M  ->  ROLE_MAIN          (14)
//   Ctrl+N  ->  ROLE_NAVIGATION    (15)
//
// These four role ordinals extend the AccessKit interactive vocabulary
// KeynavTaborder §D declared for its focusability filter (BUTTON,
// TEXTBOX, CHECKBOX, LIST_ITEM, LINK, MENU_ITEM at 2, 4, 5, 7, 8, 10).
// The four skip-link roles here occupy the next free ordinals (12..15)
// in the tree_kind.pdx §A role space; adding them as pub lets in
// tree_kind.pdx is a follow-on chore that this module does NOT block on
// (the a11y tree currently emits nodes with role in the 0..10 subset,
// so the skip-link scan will return KEYNAV_INDEX_NONE against a real
// live tree at this landing -- the primitive is here for when the tree
// grows the new roles).
//
// WALK SHAPE.  focus_ring_handle_skip_link does a LINEAR ordinal scan
// (node_id 0 .. node_count - 1) rather than a DFS traversal because
// there is no "current position" to walk FROM -- skip-links are ABSOLUTE
// jumps to the first-matching-role node, not RELATIVE next-matching-role
// jumps. The linear scan mirrors the tree's storage order which
// tree_kind.pdx §4.2 guarantees is topologically consistent (parent_id
// < child_id), so the first-matching return is deterministic across
// tree rebuilds. A future landing that wants "next matching AFTER the
// cursor" adds a starting-ordinal parameter without changing this
// entry point.
//
// =============================================================================
// SECTION 5  FAILURE TAXONOMY  0xFFFFEB61..0xFFFFEB67
// =============================================================================
//
// The task row hinted at 0xFFFFEB60..0xFFFFEB6F for this landing, but a
// repo-wide grep at landing time
// (`grep -rhoE '0xFFFFEB6[0-9A-Fa-f]' src/`) shows that band is CLAIMED
// by KIND_HOTPLUG_CHANNEL:
//   0xFFFFEB60 = HPCH marker sentinel
//   0xFFFFEB68..0xFFFFEB6F = HPCH_{SK_ABSENT, SK_ALREADY, BAD_SLOT,
//                            TAIL_ENOSPC, TAIL_BAD_ARG, MINT_BAD_RIGHTS,
//                            MINT_BAD_MASK, MINT_BAD_PORT}
// (see src/kernel/core/cap/kind_hotplug_channel.pdx). Following the
// keynav_taborder.pdx (Wave0-B9-10) precedent: when the task-row's band
// is CLAIMED, the free contiguous sub-slots inside that band become
// this module's failure band. The free range 0xFFFFEB61..0xFFFFEB67 is
// 7 slots, sufficient for the three input-validation sentinels this
// module needs. A future landing that adds a fifth sentinel (e.g.,
// a11y-tree-bound argument checks) falls back to the same substitution
// discipline (pick a nearby free sub-slot; note the substitution in
// the header).
//
// Every sentinel fits in imm32 for `mov reg, imm32`.
//
// KEYNAV_INDEX_NONE (0xFFFFFFFF) is REUSED from KeynavTaborder rather
// than redeclared in the local 0xFFFFEB6x band because it is a NODE-ID
// sentinel, not a failure code -- focus_ring_handle_skip_link returns
// it as "no matching node in this tree" (mirror of keynav_taborder_next
// returning it on an empty-focusable tree). Keeping the sentinel value
// identical across the two modules lets a compositor keyboard-focus
// handler chain focus_ring_handle_skip_link's return directly into
// keynav_taborder_cursor_set_current without a translation step.
//
// =============================================================================
// SECTION 6  FINGERPRINT
// =============================================================================
//
// One data-only tag ending `[legacy: KEYNAV FOCUS RING META OK]` per
// softarch fingerprint discipline (see kind_a11y_tree /
// keynav_taborder precedent). At this landing the tag is DECLARED
// only -- the emit body (klog_s1 at compositor init time, alongside
// keynav_taborder_meta) lands in the follow-on compositor wire-up
// landing. tools/verify-fingerprint-coverage.sh allowlisting with
// reason "keynav_focus_ring meta emit body not yet landed
// (Wave0-B12-08)" is a separate one-file landing per the batch's
// file-touch discipline (this landing is ONE file only, matching the
// pattern kind_a11y_tree.pdx set for Wave0-B8-03 and keynav_taborder.
// pdx set for Wave0-B9-10).
//
// LABEL PREFIX: `keynav_focus_ring_` (long form) throughout for
// externally-visible pub let names; ASM jump targets use the shorter
// `focus_ring_<funcname>_<tag>` shape to keep the label register
// budget legible without colliding with paideia-as reserved keywords
// (feedback_paideia_as_reserved_labels).

module KeynavFocusRing = structure {

  // ==========================================================================
  // SECTION A  Identity + failure taxonomy + sentinels.
  // ==========================================================================

  // Config field byte offsets (within the caller-allocated 16-byte
  // FocusRingConfig).
  pub let KEYNAV_FR_OFF_WORD0        : u64 = 0
  pub let KEYNAV_FR_OFF_WORD1        : u64 = 8
  pub let KEYNAV_FR_CONFIG_BYTES     : u64 = 16

  // Widget rect field byte offsets (within a caller-provided 16-byte
  // rect value; layout mirror of KIND_DAMAGE_REGION rect encoding, see
  // damage_kind.pdx §2).
  pub let KEYNAV_FR_WIDGET_BYTES     : u64 = 16

  // Surface output buffer size (rect_count + 4 x 16-byte rects).
  pub let KEYNAV_FR_SURFACE_BYTES    : u64 = 72

  // Default config values (see §2).
  pub let KEYNAV_FR_DEFAULT_THICK    : u64 = 2
  pub let KEYNAV_FR_DEFAULT_PAD      : u64 = 2
  pub let KEYNAV_FR_DEFAULT_HC       : u64 = 0
  pub let KEYNAV_FR_DEFAULT_RGBA     : u64 = 0x3B82F680

  // Packed word0 default: thickness=2 | padding=2<<8 | hc=0<<16.
  pub let KEYNAV_FR_DEFAULT_WORD0    : u64 = 0x0202

  // Skip-link key ordinals (ASCII upper-case, see §4).
  pub let KEYNAV_FR_KEY_H            : u64 = 0x48
  pub let KEYNAV_FR_KEY_L            : u64 = 0x4C
  pub let KEYNAV_FR_KEY_M            : u64 = 0x4D
  pub let KEYNAV_FR_KEY_N            : u64 = 0x4E

  // Modifier bitmap (see §4). We match CTRL exactly (not subset).
  pub let KEYNAV_FR_MOD_SHIFT        : u64 = 0x01
  pub let KEYNAV_FR_MOD_CTRL         : u64 = 0x02
  pub let KEYNAV_FR_MOD_ALT          : u64 = 0x04
  pub let KEYNAV_FR_MOD_META         : u64 = 0x08

  // A11yRole ordinals for skip-link targets (see §4). Extend
  // tree_kind.pdx §A's role space with the four "navigation-anchor"
  // roles skip-links map to. Ordinals 12..15 sit in the free run
  // immediately after tree_kind's declared MENU_ITEM(10).
  pub let KEYNAV_FR_ROLE_HEADING     : u64 = 12
  pub let KEYNAV_FR_ROLE_LANDMARK    : u64 = 13
  pub let KEYNAV_FR_ROLE_MAIN        : u64 = 14
  pub let KEYNAV_FR_ROLE_NAVIGATION  : u64 = 15

  // Node-id "no match" sentinel (reused from KeynavTaborder §A; see §5
  // rationale). Kept locally as a pub let so callers of this module do
  // not have to import KeynavTaborder just for the sentinel.
  pub let KEYNAV_FR_INDEX_NONE       : u64 = 0xFFFFFFFF

  // Rect-count value focus_ring_paint stamps into surface_ptr[+0].
  pub let KEYNAV_FR_RECT_COUNT       : u64 = 4

  // Failure taxonomy -- 0xFFFFEB61..0xFFFFEB67 (see file header §5).
  pub let KEYNAV_FR_OK               : u64 = 0
  pub let KEYNAV_FR_BAD_CONFIG       : u64 = 0xFFFFEB61  // NULL config_ptr.
  pub let KEYNAV_FR_BAD_WIDGET       : u64 = 0xFFFFEB62  // NULL widget_rect_ptr.
  pub let KEYNAV_FR_BAD_SURFACE      : u64 = 0xFFFFEB63  // NULL surface_ptr.

  // ==========================================================================
  // SECTION B  Fingerprint (data-only at this landing; see file header §6).
  // ==========================================================================
  //
  // "pdx kind keynav focus ring meta [legacy: KEYNAV FOCUS RING META OK]\0"
  //  = 67 bytes of payload + 1 NUL terminator = 68 bytes total.
  pub let pdx_kind_keynav_focus_ring_meta : [u8; 68] = "pdx kind keynav focus ring meta [legacy: KEYNAV FOCUS RING META OK]\0"

  // ==========================================================================
  // SECTION C  Config default + field accessors.
  //
  // The config is a caller-owned 16-byte value; every accessor takes a
  // config_ptr (u64 pointer to the first byte). All shifts / masks stay
  // encoder-conservative: no `mov_b`, no `add reg, [mem]`, no `test`.
  // ==========================================================================

  // keynav_focus_ring_config_default(config_ptr) -> KEYNAV_FR_OK
  //     | KEYNAV_FR_BAD_CONFIG.
  //
  // Stamps the caller-allocated 16-byte config with:
  //   thickness_px       = 2  (KEYNAV_FR_DEFAULT_THICK)
  //   padding_px         = 2  (KEYNAV_FR_DEFAULT_PAD)
  //   high_contrast_mode = 0  (KEYNAV_FR_DEFAULT_HC)
  //   ring_color_rgba    = 0x3B82F680 (KEYNAV_FR_DEFAULT_RGBA)
  pub let keynav_focus_ring_config_default : (u64) -> u64 !{mem} @{} =
    fn (config_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B12-08 (paideia-os #2312): stamp caller-allocated 16-byte FocusRingConfig with (thickness=2, padding=2, high_contrast=0, rgba=0x3B82F680). No callee-save needed (no nested calls, no callee-save reads). NULL config_ptr -> KEYNAV_FR_BAD_CONFIG. Labels prefixed focus_ring_ccd_.",
      block: {
        cmp rdi, 0;
        je  focus_ring_ccd_bad;

        mov rax, 0x0202;               // KEYNAV_FR_DEFAULT_WORD0
        mov [rdi + 0], rax;

        mov rax, 0x3B82F680;           // KEYNAV_FR_DEFAULT_RGBA
        mov [rdi + 8], rax;

        xor rax, rax;                  // KEYNAV_FR_OK
        ret;

      focus_ring_ccd_bad:
        mov rax, 0xFFFFEB61;           // KEYNAV_FR_BAD_CONFIG
        ret
      }
    }

  // keynav_focus_ring_config_thickness(config_ptr) -> u8 thickness_px.
  pub let keynav_focus_ring_config_thickness : (u64) -> u64 !{mem} @{} =
    fn (config_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B12-08 (paideia-os #2312): read thickness_px from config_word0[7:0]. Labels prefixed focus_ring_ct_.",
      block: {
        mov rax, [rdi + 0];
        and rax, 0xFF;
        ret
      }
    }

  // keynav_focus_ring_config_padding(config_ptr) -> u8 padding_px.
  pub let keynav_focus_ring_config_padding : (u64) -> u64 !{mem} @{} =
    fn (config_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B12-08 (paideia-os #2312): read padding_px from config_word0[15:8]. Labels prefixed focus_ring_cp_.",
      block: {
        mov rax, [rdi + 0];
        shr rax, 8;
        and rax, 0xFF;
        ret
      }
    }

  // keynav_focus_ring_config_high_contrast(config_ptr) -> u8 hc_mode.
  pub let keynav_focus_ring_config_high_contrast : (u64) -> u64 !{mem} @{} =
    fn (config_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B12-08 (paideia-os #2312): read high_contrast_mode from config_word0[23:16]. Labels prefixed focus_ring_chc_.",
      block: {
        mov rax, [rdi + 0];
        shr rax, 16;
        and rax, 0xFF;
        ret
      }
    }

  // keynav_focus_ring_config_rgba(config_ptr) -> u32 rgba.
  pub let keynav_focus_ring_config_rgba : (u64) -> u64 !{mem} @{} =
    fn (config_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B12-08 (paideia-os #2312): read ring_color_rgba from config_word1[31:0]. Labels prefixed focus_ring_crgb_.",
      block: {
        mov rax, [rdi + 8];
        and rax, 0xFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // SECTION D  Skip-link keycode predicates.
  //
  // Both predicates are pure functions of the keycode word; they touch
  // no memory and take no callee-save preservation.
  // ==========================================================================

  // keynav_focus_ring_is_skip_link_key(keycode) -> 1 iff Ctrl+{H,L,M,N}.
  //
  // Matches the modifier bitmap EXACTLY against MOD_CTRL (0x02) so
  // Ctrl+Shift+H does NOT trigger a skip-link (leaves Ctrl+Shift+*
  // available to window management).
  pub let keynav_focus_ring_is_skip_link_key : (u64) -> u64 !{} @{} =
    fn (keycode: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B12-08 (paideia-os #2312): 1 iff (keycode>>8)&0xFF == 0x02 AND keycode&0xFF in {H(0x48), L(0x4C), M(0x4D), N(0x4E)}. Exact modifier match (not subset) so Ctrl+Shift+* is deliberately NOT a skip-link. Four explicit compares against imm8 -- append-only for a future skip-link addition. Labels prefixed focus_ring_iskl_.",
      block: {
        mov rax, rdi;
        shr rax, 8;
        and rax, 0xFF;
        cmp rax, 0x02;                 // MOD_CTRL exact match
        jne focus_ring_iskl_no;

        mov rax, rdi;
        and rax, 0xFF;                 // base key

        mov r10, 0x48;                 // H
        cmp rax, r10;
        je  focus_ring_iskl_yes;
        mov r10, 0x4C;                 // L
        cmp rax, r10;
        je  focus_ring_iskl_yes;
        mov r10, 0x4D;                 // M
        cmp rax, r10;
        je  focus_ring_iskl_yes;
        mov r10, 0x4E;                 // N
        cmp rax, r10;
        je  focus_ring_iskl_yes;

      focus_ring_iskl_no:
        xor rax, rax;
        ret;

      focus_ring_iskl_yes:
        mov rax, 1;
        ret
      }
    }

  // keynav_focus_ring_skip_link_role(keycode) -> role ordinal
  //     | KEYNAV_FR_INDEX_NONE (0xFFFFFFFF) if keycode is not a
  //     skip-link.
  //
  // Splits the (keycode -> role) mapping out of handle_skip_link so a
  // caller that wants to preview the target role without walking the
  // tree can do so cheaply. Also makes handle_skip_link's body
  // trivially readable: "role = skip_link_role(k); if NONE return NONE;
  // else scan tree for first node of that role".
  pub let keynav_focus_ring_skip_link_role : (u64) -> u64 !{} @{} =
    fn (keycode: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B12-08 (paideia-os #2312): map Ctrl+H/L/M/N -> ROLE_{HEADING,LANDMARK,MAIN,NAVIGATION}. Modifier gate matches MOD_CTRL exactly (identical to is_skip_link_key so the two predicates stay in sync by construction). Non-skip-link keycodes -> KEYNAV_FR_INDEX_NONE. Labels prefixed focus_ring_slr_.",
      block: {
        mov rax, rdi;
        shr rax, 8;
        and rax, 0xFF;
        cmp rax, 0x02;                 // MOD_CTRL exact
        jne focus_ring_slr_none;

        mov rax, rdi;
        and rax, 0xFF;

        mov r10, 0x48;
        cmp rax, r10;
        je  focus_ring_slr_heading;
        mov r10, 0x4C;
        cmp rax, r10;
        je  focus_ring_slr_landmark;
        mov r10, 0x4D;
        cmp rax, r10;
        je  focus_ring_slr_main;
        mov r10, 0x4E;
        cmp rax, r10;
        je  focus_ring_slr_navigation;

      focus_ring_slr_none:
        mov rax, 0xFFFFFFFF;
        ret;

      focus_ring_slr_heading:
        mov rax, 12;                   // KEYNAV_FR_ROLE_HEADING
        ret;

      focus_ring_slr_landmark:
        mov rax, 13;                   // KEYNAV_FR_ROLE_LANDMARK
        ret;

      focus_ring_slr_main:
        mov rax, 14;                   // KEYNAV_FR_ROLE_MAIN
        ret;

      focus_ring_slr_navigation:
        mov rax, 15;                   // KEYNAV_FR_ROLE_NAVIGATION
        ret
      }
    }

  // ==========================================================================
  // SECTION E  Focus-ring painter.
  //
  // Computes the four ring strips (top / bottom / left / right) framing
  // the widget rect at the config's thickness + padding, and writes
  // them into the caller-provided 72-byte surface_ptr buffer as a
  // KIND_DAMAGE_REGION-shaped rect list (see file header §3).
  // ==========================================================================

  // keynav_focus_ring_paint(config_ptr, widget_rect_ptr, surface_ptr) ->
  //     KEYNAV_FR_OK | KEYNAV_FR_BAD_CONFIG | KEYNAV_FR_BAD_WIDGET
  //   | KEYNAV_FR_BAD_SURFACE.
  //
  // Reads (x,y,w,h) from widget_rect_ptr, reads (thickness, padding)
  // from config_ptr, composes 4 strip rects, and writes them into
  // surface_ptr starting at offset 8 (offset 0 gets rect_count=4).
  //
  // Signed 32-bit arithmetic is performed in u64 with 0xFFFFFFFF
  // masking at the store site. (padding + thickness) is bounded by
  // 2 * u8_max = 510 << 2^31, so no arithmetic overflows the signed
  // 32-bit range on inputs the caller could realistically pass.
  //
  // Five callee-save pushes (rbx = surface_ptr scratch, r12..r15 =
  // widget x/y/w/h). Entry rsp%16 == 8, five 8-byte pushes give
  // rsp%16 == 0. The body contains NO nested calls (every load and
  // store is memory-direct), so post-prologue rsp alignment is
  // decorative here -- kept anyway to preserve the alignment
  // invariant every module in this tree honours at every callsite.
  //
  // Register plan:
  //   rbx = surface_ptr (moved from rdx after arg-validation)
  //   r12 = widget x   (u32 in low 32 bits, treated as i32)
  //   r13 = widget y
  //   r14 = widget w
  //   r15 = widget h
  //   rcx = thickness  (u8, caller-save; body has no calls)
  //   r8  = padding    (u8, caller-save)
  //   r9  = thickness + padding = t + p (caller-save)
  //   rax, r10, r11 = arithmetic scratch (caller-save)
  pub let keynav_focus_ring_paint : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (config_ptr: u64) (widget_rect_ptr: u64) (surface_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B12-08 (paideia-os #2312): compose 4 focus-ring strips (top/bottom/left/right) framing widget_rect at config's (thickness, padding), write to surface_ptr as a KIND_DAMAGE_REGION-shaped rect list. Five callee-save pushes (rbx=surface, r12..r15=x/y/w/h): entry rsp%16==8, five 8-byte pushes give rsp%16==0. Body has NO nested calls; alignment is decorative but preserved. Signed 32-bit arithmetic done in u64 with 0xFFFFFFFF masking at the store site (safe: p+t is bounded by 2*u8_max=510, well under 2^31). NULL args -> KEYNAV_FR_BAD_{CONFIG,WIDGET,SURFACE}. Labels prefixed focus_ring_pt_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // Validate all three pointers.
        cmp rdi, 0;
        je  focus_ring_pt_bad_config;
        cmp rsi, 0;
        je  focus_ring_pt_bad_widget;
        cmp rdx, 0;
        je  focus_ring_pt_bad_surface;

        // Load widget (x, y, w, h) into r12..r15.
        mov rax, [rsi + 0];             // x low, y high
        mov r12, rax;
        and r12, 0xFFFFFFFF;            // r12 = x
        mov r13, rax;
        shr r13, 32;                    // r13 = y

        mov rax, [rsi + 8];             // w low, h high
        mov r14, rax;
        and r14, 0xFFFFFFFF;            // r14 = w
        mov r15, rax;
        shr r15, 32;                    // r15 = h

        // Load thickness + padding from config_word0 into caller-save.
        mov rax, [rdi + 0];
        mov rcx, rax;
        and rcx, 0xFF;                  // rcx = thickness = t
        mov r8, rax;
        shr r8, 8;
        and r8, 0xFF;                   // r8 = padding = p

        // Precompute t + p.
        mov r9, rcx;
        add r9, r8;                     // r9 = t + p

        // Point rbx at the surface buffer.
        mov rbx, rdx;                   // rbx = surface_ptr

        // Write rect_count = 4 at [rbx + 0].
        mov rax, 4;                     // KEYNAV_FR_RECT_COUNT
        mov [rbx + 0], rax;

        // -------- TOP strip at [rbx + 8]:
        //   (x - t - p, y - t - p, w + 2(t+p), t)

        // low word: x_out[31:0] | y_out[63:32]
        mov rax, r12;
        sub rax, r9;                    // x_out = x - (t + p)
        and rax, 0xFFFFFFFF;
        mov r10, r13;
        sub r10, r9;                    // y_out = y - (t + p)
        and r10, 0xFFFFFFFF;
        shl r10, 32;
        or  rax, r10;
        mov [rbx + 8], rax;

        // high word: w_out[31:0] | t[63:32]
        mov rax, r14;
        mov r10, r9;
        shl r10, 1;                     // 2 * (t + p)
        add rax, r10;                   // w_out = w + 2(t + p)
        and rax, 0xFFFFFFFF;
        mov r10, rcx;                   // t
        and r10, 0xFFFFFFFF;
        shl r10, 32;
        or  rax, r10;
        mov [rbx + 16], rax;

        // -------- BOTTOM strip at [rbx + 24]:
        //   (x - t - p, y + h + p, w + 2(t+p), t)

        // low word: x_out[31:0] | (y + h + p)[63:32]
        mov rax, r12;
        sub rax, r9;                    // x_out
        and rax, 0xFFFFFFFF;
        mov r10, r13;
        add r10, r15;                   // y + h
        add r10, r8;                    // y + h + p
        and r10, 0xFFFFFFFF;
        shl r10, 32;
        or  rax, r10;
        mov [rbx + 24], rax;

        // high word: w_out[31:0] | t[63:32]  (identical to TOP's high)
        mov rax, r14;
        mov r10, r9;
        shl r10, 1;
        add rax, r10;                   // w_out
        and rax, 0xFFFFFFFF;
        mov r10, rcx;                   // t
        and r10, 0xFFFFFFFF;
        shl r10, 32;
        or  rax, r10;
        mov [rbx + 32], rax;

        // -------- LEFT strip at [rbx + 40]:
        //   (x - t - p, y - p, t, h + 2p)

        // low word: x_out[31:0] | (y - p)[63:32]
        mov rax, r12;
        sub rax, r9;                    // x_out
        and rax, 0xFFFFFFFF;
        mov r10, r13;
        sub r10, r8;                    // y - p
        and r10, 0xFFFFFFFF;
        shl r10, 32;
        or  rax, r10;
        mov [rbx + 40], rax;

        // high word: t[31:0] | (h + 2p)[63:32]
        mov rax, rcx;                   // t
        and rax, 0xFFFFFFFF;
        mov r10, r15;                   // h
        mov r11, r8;
        shl r11, 1;                     // 2p
        add r10, r11;                   // h + 2p
        and r10, 0xFFFFFFFF;
        shl r10, 32;
        or  rax, r10;
        mov [rbx + 48], rax;

        // -------- RIGHT strip at [rbx + 56]:
        //   (x + w + p, y - p, t, h + 2p)

        // low word: (x + w + p)[31:0] | (y - p)[63:32]
        mov rax, r12;
        add rax, r14;                   // x + w
        add rax, r8;                    // x + w + p
        and rax, 0xFFFFFFFF;
        mov r10, r13;
        sub r10, r8;                    // y - p
        and r10, 0xFFFFFFFF;
        shl r10, 32;
        or  rax, r10;
        mov [rbx + 56], rax;

        // high word: t[31:0] | (h + 2p)[63:32]  (identical to LEFT's high)
        mov rax, rcx;                   // t
        and rax, 0xFFFFFFFF;
        mov r10, r15;                   // h
        mov r11, r8;
        shl r11, 1;
        add r10, r11;                   // h + 2p
        and r10, 0xFFFFFFFF;
        shl r10, 32;
        or  rax, r10;
        mov [rbx + 64], rax;

        xor rax, rax;                   // KEYNAV_FR_OK
        jmp focus_ring_pt_out;

      focus_ring_pt_bad_config:
        mov rax, 0xFFFFEB61;            // KEYNAV_FR_BAD_CONFIG
        jmp focus_ring_pt_out;

      focus_ring_pt_bad_widget:
        mov rax, 0xFFFFEB62;            // KEYNAV_FR_BAD_WIDGET
        jmp focus_ring_pt_out;

      focus_ring_pt_bad_surface:
        mov rax, 0xFFFFEB63;            // KEYNAV_FR_BAD_SURFACE

      focus_ring_pt_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION F  Skip-link handler.
  //
  // Given a keycode and a KIND_A11Y_TREE row_id, returns the node_id of
  // the FIRST node in that tree whose role matches the skip-link's
  // target role (Ctrl+H -> HEADING, etc.), or KEYNAV_FR_INDEX_NONE
  // (0xFFFFFFFF) if no such node exists / keycode is not a skip-link /
  // tree_kind_id is bad.
  //
  // Walk shape: LINEAR ordinal scan over node_id 0 .. node_count - 1,
  // using tree_kind.pdx's arena accessors. First-match returned. Bounded
  // by node_count (finite, per tree_kind.pdx §3 A11Y_MAX_NODES=32).
  // ==========================================================================

  // keynav_focus_ring_handle_skip_link(keycode, tree_kind_id) ->
  //     u32 node_id | KEYNAV_FR_INDEX_NONE.
  //
  // Five callee-save pushes (rbx=tree_kind_id, r12=arena_base scratch,
  // r13=target_role, r14=node_count, r15=node_id iterator): entry
  // rsp%16 == 8, five 8-byte pushes give rsp%16 == 0 -- naturally
  // aligned for every nested call (is_skip_link_key, skip_link_role,
  // a11y_tree_arena_base, a11y_tree_hdr_node_count,
  // a11y_tree_node_addr, a11y_tree_node_role).
  //
  // Note: is_skip_link_key + skip_link_role compute the same modifier
  // gate. Calling both is 5-6 extra compares per keystroke -- a
  // negligible cost against the tree walk, and the readability benefit
  // (each entry point remains a pure translation) outweighs the
  // micro-cost. The skip_link_role NONE return doubles as the
  // "keycode is not a skip-link" gate, so is_skip_link_key is
  // structurally redundant here; kept as an EXPLICIT precondition
  // check so a future landing that adds skip-link keys with a role
  // NOT in {HEADING, LANDMARK, MAIN, NAVIGATION} (skip_link_role would
  // then return NONE for a valid skip-link key) still gates cleanly.
  pub let keynav_focus_ring_handle_skip_link : (u64, u64) -> u64 !{mem} @{} =
    fn (keycode: u64) (tree_kind_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B12-08 (paideia-os #2312): map keycode -> target role, then linear-scan the a11y tree for the first node of that role. Five callee-save pushes (rbx=tree_kind_id/keycode-scratch, r12=arena_base, r13=target_role, r14=node_count, r15=node_iterator): entry rsp%16==8, five 8-byte pushes give rsp%16==0 -- naturally aligned for every nested call. tree_kind_id preserved in rbx across is_skip_link_key + skip_link_role calls (both are pure functions of rdi=keycode, so rsi=tree_kind_id survives -- but keeping tree_kind_id in a callee-save register makes the code robust to a future refactor of those predicates). Bounded scan by node_count (finite per tree_kind.pdx §3 A11Y_MAX_NODES=32). Labels prefixed focus_ring_hsl_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rsi;                   // rbx = tree_kind_id (survives)

        // Gate 1: keycode must be a skip-link key.
        // rdi already holds keycode.
        call keynav_focus_ring_is_skip_link_key;
        cmp rax, 0;
        je  focus_ring_hsl_none;

        // Gate 2: keycode must map to a known target role.
        // Re-pass keycode (still in rdi after the previous call --
        // is_skip_link_key does not clobber rdi in its body, but that
        // is an implementation detail; be defensive and re-populate).
        // Actually, no easy save of keycode across the first call
        // without another push; skip_link_role reads only rdi, so
        // reading it from rdi post-call is fine as long as
        // is_skip_link_key does not modify rdi. Re-verified: its body
        // is `mov rax, rdi; shr ...; and ...; cmp ...` and never
        // touches rdi -- safe.
        call keynav_focus_ring_skip_link_role;
        mov r10, 0xFFFFFFFF;
        cmp rax, r10;
        je  focus_ring_hsl_none;
        mov r13, rax;                   // r13 = target_role

        // Resolve arena_base for tree_kind_id.
        mov rdi, rbx;
        call a11y_tree_arena_base;
        cmp rax, 0;
        je  focus_ring_hsl_none;
        mov r12, rax;                   // r12 = arena_base

        // node_count = a11y_tree_hdr_node_count(arena_base).
        mov rdi, r12;
        call a11y_tree_hdr_node_count;
        mov r14, rax;                   // r14 = node_count

        // node_count == 0 -> NONE (no scan possible).
        cmp r14, 0;
        je  focus_ring_hsl_none;

        // Linear scan node_id = 0 .. node_count - 1.
        xor r15, r15;                   // r15 = node_id iterator = 0

      focus_ring_hsl_scan:
        cmp r15, r14;
        jae focus_ring_hsl_none;        // exhausted -> NONE

        // node_base = a11y_tree_node_addr(arena_base, node_id).
        mov rdi, r12;
        mov rsi, r15;
        call a11y_tree_node_addr;

        // role = a11y_tree_node_role(node_base).
        mov rdi, rax;
        call a11y_tree_node_role;

        cmp rax, r13;
        je  focus_ring_hsl_found;

        add r15, 1;
        jmp focus_ring_hsl_scan;

      focus_ring_hsl_found:
        mov rax, r15;
        jmp focus_ring_hsl_out;

      focus_ring_hsl_none:
        mov rax, 0xFFFFFFFF;            // KEYNAV_FR_INDEX_NONE

      focus_ring_hsl_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
