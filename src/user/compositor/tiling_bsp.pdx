// src/user/compositor/tiling_bsp.pdx -- Wave0-B8-08 (paideia-os #2291)
//
// TilingBsp -- binary-space-partition tiling primitives, the ONE
// tiling primitive used by every G9-M2 tiling mode. Novel-clean
// posture: floating (G9-M2-002) and stacked (G9-M2-003) modes build
// on top of BSP by treating a subtree as a "container" whose leaves
// render in floating/stacked mode; there is no parallel tiling engine.
//
// =============================================================================
// SECTION 0  WHY THIS IS A VALUE TYPE, NOT A KIND CAP
// =============================================================================
//
// Every KIND_WORKSPACE (0x1D2, workspace_kind.pdx, B8-02, LANDED this
// batch) owns ONE tiling tree as in-process compositor state. There
// is no cross-process handoff of a bare BSP tree: a client that wants
// to observe the tiling arrangement receives a projection through a
// distinct capability (a KIND_WORKSPACE observer op, or a
// KIND_A11Y_TREE binding) rather than a raw handle over this module's
// arena. Splitting the tiling tree into its own KIND cap would add a
// rights lattice, a mint dispatcher, and a row pool for authority we
// never hand out.
//
// The compositor mints one KIND_WORKSPACE per workspace, and each row
// claims exactly one BSP arena slot from _tiling_bsp_arenas at mint
// time via tiling_bsp_arena_alloc. On workspace revoke the row frees
// its arena slot via tiling_bsp_arena_free. Ownership is 1:1 with
// the KIND_WORKSPACE row, and the module never publishes a handle to
// its arena outside the compositor.
//
// =============================================================================
// SECTION 1  KIND_* SLOT ALLOCATION
// =============================================================================
//
// N/A -- this module is a VALUE TYPE. No KIND_TILING_BSP slot exists.
// The parent capability that anchors ownership is KIND_WORKSPACE
// (0x1D2), which references its arena slot via a small u8 index (the
// arena_slot field is per-workspace-row and lives in workspace_kind.
// pdx's row body, not here).
//
// =============================================================================
// SECTION 2  ARENA + NODE LAYOUT
// =============================================================================
//
// One arena backs one KIND_WORKSPACE row. Each arena is
// TB_HDR_BYTES + TB_MAX_NODES * TB_NODE_BYTES bytes:
//
//     header:            32 bytes  (SECTION 2.1 -- struct BspTree)
//     nodes[TB_MAX_NODES]: 64 * 32 = 2048 bytes  (SECTION 2.2 -- struct BspNode)
//     ----
//     total per arena:  2080 bytes
//
// TB_MAX_TREES arenas * 2080 bytes = 8320 bytes of arena .bss.
//
// Sizing: TB_MAX_NODES = 64 covers the worst case for the batch's
// "MAX 32 windows per workspace" policy (32 leaves + 31 internal
// splits + 1 slack slot). Refusing at 63 rather than 64 leaves room
// for the split body to allocate both new leaves atomically without
// half-committing.
//
// -----------------------------------------------------------------------------
// 2.1  struct BspTree  (header, 32 bytes at offset 0 within an arena)
// -----------------------------------------------------------------------------
//
//   [+0]  wsid_root:    workspace_kind_id[31:0] | root_index[63:32]
//   [+8]  count_cap:    node_count[31:0]        | arena_capacity[63:32]
//   [+16] version:      tree_version_seq[63:0]
//   [+24] free_head:    free_head_index[31:0]   | reserved[63:32]
//
// Fields:
//   workspace_kind_id: u32  -- the KIND_WORKSPACE row slot this tree
//                              belongs to (redundant with the row's own
//                              slot id, but carried in-band so a walker
//                              handed a bare tree_base pointer can
//                              cross-check against the owning row).
//   root_index: u32         -- index of the tree root; TB_INDEX_NONE
//                              for an empty tree.
//   node_count: u32         -- highwater of bump-allocated nodes; 0 for
//                              an empty tree, up to TB_MAX_NODES.
//   arena_capacity: u32     -- TB_MAX_NODES (== 64) at init; carried
//                              in-band so future variants can shrink
//                              or extend without recompiling callers.
//   tree_version_seq: u64   -- monotone; bumps on every split, collapse
//                              or insert. Callers (repaint / a11y
//                              broadcast) sample this to detect "the
//                              tree changed since last present" without
//                              walking it.
//   free_head_index: u32    -- head of the intrusive free list; TB_
//                              INDEX_NONE if the free list is empty.
//                              A freed node's parent_index field is
//                              overloaded as the "next free" link
//                              while the slot sits on the free list.
//
// -----------------------------------------------------------------------------
// 2.2  struct BspNode  (32 bytes, one per BSP tree node)
// -----------------------------------------------------------------------------
//
//   [+0]  axis_den:     axis[7:0] | reserved[31:8] | ratio_den[63:32]
//   [+8]  wnum:         window_kind_id[31:0] | ratio_num[63:32]
//   [+16] children:     left_child_index[31:0] | right_child_index[63:32]
//   [+24] parcnt:       parent_index[31:0] | subtree_window_count[63:32]
//
// A node is EITHER a LEAF or an INTERNAL split, discriminated by the
// axis field:
//
//   axis == TB_SPLIT_LEAF (255) -- LEAF
//     ratio_num  = 0 (unused)
//     ratio_den  = 0 (unused)
//     window_kind_id = the KIND_WINDOW cap id this leaf holds
//     left_child  = TB_INDEX_NONE
//     right_child = TB_INDEX_NONE
//     subtree_window_count = 1
//
//   axis == TB_SPLIT_HORIZONTAL (0) -- INTERNAL: children side-by-side
//     ratio_num  > 0   left_child gets ratio_num/ratio_den of width
//     ratio_den  > 0
//     window_kind_id = 0 (an internal split holds no window)
//     left_child  != TB_INDEX_NONE
//     right_child != TB_INDEX_NONE
//     subtree_window_count = left_child.count + right_child.count
//
//   axis == TB_SPLIT_VERTICAL (1)   -- INTERNAL: children stacked
//     (same as HORIZONTAL but ratio applies to height; left_child is
//     the TOP half and right_child is the BOTTOM half.)
//
// TOPOLOGICAL INVARIANT (mint enforces; walk assumes):
//   for every node i where parent_index != TB_INDEX_NONE:
//       nodes[parent_index].left_child == i
//       OR nodes[parent_index].right_child == i
//   (i.e. child->parent and parent->child links agree at every edge.)
//
// FREE-LIST INVARIANT:
//   A slot is on the free list iff its axis field == 0 AND the slot's
//   parent_index either points at another free slot (chained) or ==
//   TB_INDEX_NONE (list tail). Because axis == 0 is also
//   TB_SPLIT_HORIZONTAL (a legal internal-split axis), free-list
//   membership is disambiguated purely by the header's free_head_index
//   chain -- a caller walking from a tree root never traverses a free
//   slot because free slots are UNREACHABLE from the root by
//   construction.
//
// =============================================================================
// SECTION 3  FAILURE TAXONOMY  0xFFFFEB70..0xFFFFEB7F
// =============================================================================
//
// A repo-wide grep at landing time (grep -rhEo '0xFFFFEB[0-9A-Fa-f]{2}'
// over src/ + design/) showed the 0xFFFFEB70..0xFFFFEB7F page free
// (highest live EB6x claim was 0xFFFFEB6F; next live EBxx claim was
// 0xFFFFEBEA). Adjacent to the surrounding compositor kinds' bands so
// downstream G9 issues that add more tiling primitives keep contiguous
// numeric locality.
//
// =============================================================================
// SECTION 4  ENCODER-CONSERVATIVE DISCIPLINE
// =============================================================================
//
// Per the B8-08 spec:
//
//   * NO `and reg, imm64` -- for u32 zero-extension from a packed
//     word, use `shl reg, 32; shr reg, 32` (the shl discards whatever
//     upper bits were in the register and the shr right-shifts back,
//     leaving bits 0..31 intact and bits 32..63 zero).
//
//   * NO 2-op imul-with-imm -- always use the 3-op form
//     `imul dst, src, imm32` (which paideia-as encodes as the
//     REX + 69 + modrm + imm32 IMUL-with-imm sequence). Every
//     multiply-by-constant in this file uses that form or a shift-by-
//     immediate when the constant is a power of two (`shl reg, 5`
//     for the * 32 step of node_addr).
//
// TB_INDEX_NONE (0xFFFFFFFF as a u32-in-u64) is loaded via
// `mov reg, 0xFFFFFFFF; shl reg, 32; shr reg, 32` when the caller
// wants the exact bit-pattern 0x00000000FFFFFFFF (bounds compares are
// unsigned and tolerate either encoding when the compare's other
// operand is a small value, but zero-extension is preferred where
// disambiguation matters).
//
// =============================================================================
// SECTION 5  FINGERPRINT
// =============================================================================
//
// ONE data-only tag ending `[legacy: TILING BSP META OK]` per softarch
// discipline. Emitted (in a future landing that wires the tiling
// engine into the compositor's op loop) via klog_s1_x1 on every
// KIND_WORKSPACE mint that seeds a BSP tree. At THIS landing the
// string is data-only; the workspace_kind.pdx mint body (B8-02) does
// not yet call into tiling_bsp_arena_alloc, so no emission path is
// live. The tag is defined here so the fingerprint-coverage gate has
// a stable string to allowlist against once the workspace<->bsp wire-
// in lands.
//
// LABEL PREFIX: `tb_` for internal helpers and jump labels (safely
// avoids paideia-as reserved keywords such as `loop` / `if` /
// `return`; see feedback_paideia_as_reserved_labels). Public API
// functions carry the full `tiling_bsp_` prefix per the batch spec.

module TilingBsp = structure {

  // ==========================================================================
  // SECTION A  Sizing + enum + sentinel constants.
  // ==========================================================================

  // Arena pool sizing.
  pub let TB_MAX_TREES     : u64 = 4         // per-compositor tree pool.
  pub let TB_MAX_NODES     : u64 = 64        // per tree; 32 leaves + 31 splits + 1 slack.
  pub let TB_HDR_BYTES     : u64 = 32        // per-arena tree header.
  pub let TB_NODE_BYTES    : u64 = 32        // per-node record.
  pub let TB_ARENA_BYTES   : u64 = 2080      // 32 + 64 * 32.

  // Split-axis enum.
  pub let TB_SPLIT_HORIZONTAL : u64 = 0      // children side-by-side.
  pub let TB_SPLIT_VERTICAL   : u64 = 1      // children stacked.
  pub let TB_SPLIT_LEAF       : u64 = 255    // node is a leaf, not a split.

  // Sentinels.
  pub let TB_INDEX_NONE       : u64 = 0xFFFFFFFF     // u32-max, "no such node".
  pub let TB_VISIT_CONTINUE   : u64 = 0
  pub let TB_VISIT_STOP       : u64 = 1

  // Byte offsets within the tree header (SECTION 2.1).
  pub let TB_HDR_OFF_WSID_ROOT     : u64 = 0
  pub let TB_HDR_OFF_COUNT_CAP     : u64 = 8
  pub let TB_HDR_OFF_VERSION       : u64 = 16
  pub let TB_HDR_OFF_FREE          : u64 = 24

  // Byte offsets within a node (SECTION 2.2).
  pub let TB_NODE_OFF_AXIS_DEN     : u64 = 0
  pub let TB_NODE_OFF_WKID_NUM     : u64 = 8
  pub let TB_NODE_OFF_CHILDREN     : u64 = 16
  pub let TB_NODE_OFF_PARCNT       : u64 = 24

  // Stats slots.
  pub let TB_ST_SPLITS      : u64 = 0
  pub let TB_ST_COLLAPSES   : u64 = 1
  pub let TB_ST_WALKS       : u64 = 2
  pub let TB_ST_REFUSED     : u64 = 3

  // Failure taxonomy -- 0xFFFFEB70..0xFFFFEB7F (see file header §3).
  pub let TB_OK                    : u64 = 0
  pub let TB_ERR_ENOSPC            : u64 = 0xFFFFEB7F
  pub let TB_ERR_BAD_INDEX         : u64 = 0xFFFFEB7E
  pub let TB_ERR_NOT_LEAF          : u64 = 0xFFFFEB7D
  pub let TB_ERR_BAD_AXIS          : u64 = 0xFFFFEB7C
  pub let TB_ERR_BAD_RATIO         : u64 = 0xFFFFEB7B
  pub let TB_ERR_EMPTY_TREE        : u64 = 0xFFFFEB7A
  pub let TB_ERR_ROOT_COLLAPSE     : u64 = 0xFFFFEB79
  pub let TB_ERR_BAD_TREE          : u64 = 0xFFFFEB78
  pub let TB_ERR_STOP_VISITOR      : u64 = 0xFFFFEB77
  pub let TB_ERR_DEPTH_LIMIT       : u64 = 0xFFFFEB76
  pub let TB_ERR_BAD_ARENA         : u64 = 0xFFFFEB75
  pub let TB_ERR_BAD_WORKSPACE     : u64 = 0xFFFFEB74
  pub let TB_ERR_ALREADY_ROOT      : u64 = 0xFFFFEB73
  pub let TB_ERR_TOPOLOGY          : u64 = 0xFFFFEB72
  pub let TB_ERR_INTERNAL          : u64 = 0xFFFFEB71
  pub let TB_ERR_DECODE            : u64 = 0xFFFFEB70

  // ==========================================================================
  // SECTION B  State cells (arena pool + alloc bits + stats).
  // ==========================================================================

  // Per-tree arena pool. 4 arenas * 2080 bytes = 8320 bytes = 1040 u64.
  pub let mut _tiling_bsp_arenas    : [u64; 1040] = uninit @align(64)

  // Per-slot in-use flags (0 = free, 1 = allocated). Kept as a u64
  // per slot so the alloc/free path is a plain load+store with no
  // bit-manipulation (matches every other pool primitive in this
  // module and avoids the `and reg, imm64` shape).
  pub let mut _tiling_bsp_alloc_bits: [u64; 4]    = uninit @align(64)

  // Stats counters (splits, collapses, walks, refused). Bounds-
  // checked against 4 in tb_stats_bump / tb_stats_read.
  pub let mut _tiling_bsp_stats     : [u64; 4]    = uninit @align(64)

  // ==========================================================================
  // SECTION C  Fingerprint tag (data-only).
  //
  // pdx_kind_tiling_bsp_meta -- ONE tag ending [legacy: ... OK] per
  // softarch discipline. See file header §5. Wire-up path (workspace
  // mint -> tiling_bsp_arena_alloc -> emission via klog_s1_x1) lands
  // with a future batch; the coverage gate allowlist entry lands at
  // the same time.
  // ==========================================================================

  pub let pdx_kind_tiling_bsp_meta : [u8; 54] = "pdx kind tiling bsp meta [legacy: TILING BSP META OK]\0"

  // ==========================================================================
  // SECTION D  Bit-packing helpers.
  //
  // Every packed word in this module is (u32_lo | u32_hi << 32).
  // tb_pack_u32_pair is the canonical constructor; readers extract via
  // the header/node accessors in SECTIONS F + G below.
  //
  // Zero-extension of the low half uses `shl 32; shr 32` per the
  // encoder-conservative discipline (SECTION 4 of the file header).
  // ==========================================================================

  // tb_pack_u32_pair(lo, hi) -> lo[31:0] | hi[63:32].
  pub let tb_pack_u32_pair : (u64, u64) -> u64 !{} @{} =
    fn (lo: u64) (hi: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B8-08 (paideia-os #2291): pack (u32, u32) -> u64 with lo at [31:0] and hi at [63:32]. Zero-extension via shl 32; shr 32 (encoder-conservative -- no `and reg, imm32` mask). The `shl r10, 32` on hi discards any extraneous upper bits before the OR. Labels prefixed tb_pu_.",
      block: {
        mov rax, rdi;
        shl rax, 32;
        shr rax, 32;                 // zero-extended lo
        mov r10, rsi;
        shl r10, 32;                 // discards upper bits of hi, places into [63:32]
        or  rax, r10;
        ret
      }
    }

  // ==========================================================================
  // SECTION E  Arena pool primitives.
  //
  //   tb_arena_base(slot)  -> ptr to arena's tree header  (or 0 OOB).
  //   tiling_bsp_arena_alloc()   -> slot | TB_ERR_ENOSPC.
  //   tiling_bsp_arena_free(slot) -> ().
  //
  // Slot indices are 0..TB_MAX_TREES-1. Arena base pointer =
  // _tiling_bsp_arenas + slot * TB_ARENA_BYTES (2080).
  // ==========================================================================

  // tb_arena_base(slot) -> ptr | 0.
  pub let tb_arena_base : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B8-08 (paideia-os #2291): arena base pointer = _tiling_bsp_arenas + slot * TB_ARENA_BYTES(2080). Bounds-checked against TB_MAX_TREES(4); OOB returns 0 (caller compares against zero before dereferencing). Labels prefixed tb_ab_.",
      block: {
        mov r10, 4;
        cmp rdi, r10;
        jae tb_ab_no;
        lea r10, [rip + _tiling_bsp_arenas];
        mov r11, rdi;
        imul r11, r11, 2080;
        add r10, r11;
        mov rax, r10;
        ret;
      tb_ab_no:
        xor rax, rax;
        ret
      }
    }

  // tiling_bsp_arena_alloc() -> slot | TB_ERR_ENOSPC. Low-first scan
  // over the alloc-bits pool. On claim, sets the bit to 1 but does
  // NOT initialise the arena payload -- the caller must invoke
  // tiling_bsp_tree_new() on the returned slot before use.
  pub let tiling_bsp_arena_alloc : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B8-08 (paideia-os #2291): claim one arena slot via low-first scan of _tiling_bsp_alloc_bits (TB_MAX_TREES=4 slots, one u64 flag per slot). No callee-save needed; scratch only. Labels prefixed tb_aa_.",
      block: {
        xor rax, rax;                // slot cursor
        lea r10, [rip + _tiling_bsp_alloc_bits];
      tb_aa_scan:
        cmp rax, 4;
        jae tb_aa_enospc;
        mov r11, [r10 + rax * 8];
        cmp r11, 0;
        je  tb_aa_claim;
        add rax, 1;
        jmp tb_aa_scan;
      tb_aa_claim:
        mov r11, 1;
        mov [r10 + rax * 8], r11;
        ret;
      tb_aa_enospc:
        mov rax, 0xFFFFEB7F;         // TB_ERR_ENOSPC
        ret
      }
    }

  // tiling_bsp_arena_free(slot) -> (). Clears the alloc bit. Does not
  // zero the arena payload (redundant work; the next alloc's caller
  // re-invokes tiling_bsp_tree_new to re-initialise the header).
  pub let tiling_bsp_arena_free : (u64) -> () !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B8-08 (paideia-os #2291): free one arena slot by clearing its alloc bit. Bounds-checked against TB_MAX_TREES(4); OOB is a silent no-op (mirror lt_row_free's tolerance). Labels prefixed tb_af_.",
      block: {
        mov r10, 4;
        cmp rdi, r10;
        jae tb_af_out;
        lea r10, [rip + _tiling_bsp_alloc_bits];
        xor rax, rax;
        mov [r10 + rdi * 8], rax;
      tb_af_out:
        ret
      }
    }

  // ==========================================================================
  // SECTION F  Address arithmetic + header accessors.
  //
  //   tb_node_addr(tree_base, node_index) -> ptr.
  //     Precondition: caller validated node_index < node_count.
  //
  //   tb_hdr_*(tree_base) -> field value (u32 fields zero-extended).
  // ==========================================================================

  // tb_node_addr(tree_base, node_index) -> ptr.
  pub let tb_node_addr : (u64, u64) -> u64 !{} @{} =
    fn (tree_base: u64) (node_index: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B8-08 (paideia-os #2291): node address = tree_base + TB_HDR_BYTES(32) + node_index * TB_NODE_BYTES(32). node_index * 32 encoded as shl 5 (power-of-two multiply via shift). Precondition: caller validated node_index. Labels prefixed tb_na_.",
      block: {
        mov rax, rdi;
        add rax, 32;                     // skip header
        mov r10, rsi;
        shl r10, 5;                      // * 32
        add rax, r10;
        ret
      }
    }

  // tb_hdr_workspace_id(tree_base) -> u32 zero-extended.
  pub let tb_hdr_workspace_id : (u64) -> u64 !{mem} @{} =
    fn (tree_base: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B8-08 (paideia-os #2291): read workspace_kind_id from wsid_root[31:0]. shl 32; shr 32 zero-extend. Labels prefixed tb_hw_.",
      block: {
        mov rax, [rdi + 0];
        shl rax, 32;
        shr rax, 32;
        ret
      }
    }

  // tb_hdr_root_index(tree_base) -> u32.
  pub let tb_hdr_root_index : (u64) -> u64 !{mem} @{} =
    fn (tree_base: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B8-08 (paideia-os #2291): read root_index from wsid_root[63:32]. Labels prefixed tb_hr_.",
      block: {
        mov rax, [rdi + 0];
        shr rax, 32;
        ret
      }
    }

  // tb_hdr_node_count(tree_base) -> u32.
  pub let tb_hdr_node_count : (u64) -> u64 !{mem} @{} =
    fn (tree_base: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B8-08 (paideia-os #2291): read node_count from count_cap[31:0]. Labels prefixed tb_hnc_.",
      block: {
        mov rax, [rdi + 8];
        shl rax, 32;
        shr rax, 32;
        ret
      }
    }

  // tb_hdr_arena_capacity(tree_base) -> u32.
  pub let tb_hdr_arena_capacity : (u64) -> u64 !{mem} @{} =
    fn (tree_base: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B8-08 (paideia-os #2291): read arena_capacity from count_cap[63:32]. Labels prefixed tb_hac_.",
      block: {
        mov rax, [rdi + 8];
        shr rax, 32;
        ret
      }
    }

  // tb_hdr_version(tree_base) -> u64.
  pub let tb_hdr_version : (u64) -> u64 !{mem} @{} =
    fn (tree_base: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B8-08 (paideia-os #2291): read tree_version_seq (full u64). Labels prefixed tb_hv_.",
      block: {
        mov rax, [rdi + 16];
        ret
      }
    }

  // tb_hdr_free_head(tree_base) -> u32.
  pub let tb_hdr_free_head : (u64) -> u64 !{mem} @{} =
    fn (tree_base: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B8-08 (paideia-os #2291): read free_head_index from free_head[31:0]. Labels prefixed tb_hf_.",
      block: {
        mov rax, [rdi + 24];
        shl rax, 32;
        shr rax, 32;
        ret
      }
    }

  // ==========================================================================
  // SECTION G  Node field accessors.
  //
  // Every accessor takes a node_base pointer (as returned by
  // tb_node_addr) and returns the requested u32 field zero-extended
  // into rax, or the u8 axis field zero-extended.
  // ==========================================================================

  // tb_node_axis(node_base) -> u8 zero-extended.
  pub let tb_node_axis : (u64) -> u64 !{mem} @{} =
    fn (node_base: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B8-08 (paideia-os #2291): read axis from axis_den[7:0]. `and rax, 0xFF` uses the imm8-form AND (short encoding), which paideia-as encodes via the 32-bit-dest EAX-form when detecting a u8 mask on a u64 register -- matches layer_tree.pdx's u8 masking pattern (lt_pack_hdr_row). Labels prefixed tb_nax_.",
      block: {
        mov rax, [rdi + 0];
        and rax, 0xFF;
        ret
      }
    }

  // tb_node_ratio_den(node_base) -> u32.
  pub let tb_node_ratio_den : (u64) -> u64 !{mem} @{} =
    fn (node_base: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B8-08 (paideia-os #2291): read ratio_den from axis_den[63:32]. Labels prefixed tb_nrd_.",
      block: {
        mov rax, [rdi + 0];
        shr rax, 32;
        ret
      }
    }

  // tb_node_window_kind_id(node_base) -> u32.
  pub let tb_node_window_kind_id : (u64) -> u64 !{mem} @{} =
    fn (node_base: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B8-08 (paideia-os #2291): read window_kind_id from wnum[31:0]. Labels prefixed tb_nwk_.",
      block: {
        mov rax, [rdi + 8];
        shl rax, 32;
        shr rax, 32;
        ret
      }
    }

  // tb_node_ratio_num(node_base) -> u32.
  pub let tb_node_ratio_num : (u64) -> u64 !{mem} @{} =
    fn (node_base: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B8-08 (paideia-os #2291): read ratio_num from wnum[63:32]. Labels prefixed tb_nrn_.",
      block: {
        mov rax, [rdi + 8];
        shr rax, 32;
        ret
      }
    }

  // tb_node_left_child(node_base) -> u32.
  pub let tb_node_left_child : (u64) -> u64 !{mem} @{} =
    fn (node_base: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B8-08 (paideia-os #2291): read left_child_index from children[31:0]. Labels prefixed tb_nlc_.",
      block: {
        mov rax, [rdi + 16];
        shl rax, 32;
        shr rax, 32;
        ret
      }
    }

  // tb_node_right_child(node_base) -> u32.
  pub let tb_node_right_child : (u64) -> u64 !{mem} @{} =
    fn (node_base: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B8-08 (paideia-os #2291): read right_child_index from children[63:32]. Labels prefixed tb_nrc_.",
      block: {
        mov rax, [rdi + 16];
        shr rax, 32;
        ret
      }
    }

  // tb_node_parent_index(node_base) -> u32.
  pub let tb_node_parent_index : (u64) -> u64 !{mem} @{} =
    fn (node_base: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B8-08 (paideia-os #2291): read parent_index from parcnt[31:0]. Labels prefixed tb_npi_.",
      block: {
        mov rax, [rdi + 24];
        shl rax, 32;
        shr rax, 32;
        ret
      }
    }

  // tb_node_subtree_count(node_base) -> u32.
  pub let tb_node_subtree_count : (u64) -> u64 !{mem} @{} =
    fn (node_base: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B8-08 (paideia-os #2291): read subtree_window_count from parcnt[63:32]. Labels prefixed tb_nsc_.",
      block: {
        mov rax, [rdi + 24];
