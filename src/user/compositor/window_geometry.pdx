// src/user/compositor/window_geometry.pdx -- Wave0-B14 G7-M8-005 (paideia-os #2263)
//
// KIND_WINDOW_GEOMETRY = 0x1CA, LINEAR cap derived over KIND_WINDOW (0x1C1).
// (Originally landed at 0x1C3; renumbered post-batch when the parallel
// popup_positioning.pdx softarch #2264 independently claimed the same
// slot — grep-race on the free-slot survey. Both files' 'SLOT
// ALLOCATION' narratives below capture that pre-race view; the actual
// claim moved to 0x1CA — first free slot in the 0x1CA..0x1CF run of
// the KIND_WINDOW-derived cluster.)
//
// Design authority: design/compositor/pwp-spec-vocabulary.md §2.7
// KIND_XDG_TOPLEVEL_STATE ("the current window geometry (excluding
// client-side decoration) ... and interactive-resize edge bindings").
// Code precedent: xdg_shell_states.pdx (0x1C4, the STATE row that
// carries a MUTABLE (x,y,w,h) rect + edge mask today) and xdg_shell_
// geometry.pdx (Wave0-B7-02, #2262, the InteractiveResizeRequest /
// WindowGeometryUpdate VALUE-TYPE pair a client uses to mutate it).
//
// WHY A NEW CAP, NOT A THIRD FIELD ON xdg_shell_states.pdx. xdg-shell's
// `set_window_geometry` names the VISIBLE-REGION rect a client wants
// composited -- explicitly allowed to differ from its buffer extent
// (shadow margins, pre-render caches, a stale buffer mid-resize-drag).
// xdg_shell_states.pdx's rect is a plain mutable u64 pair any R_XDG_
// TS_SET_STATE holder can stomp at any time, no atomicity guarantee
// against a concurrent drag or an in-flight surface_commit. This
// landing's novel-clean move (xdg-shell's own proven request/state
// split, per the issue's framing) PROMOTES the rect from "a field you
// overwrite" to "a value you mint":
//
//   * LINEAR, no R_MINT bit -- the compositor's commit path is the sole
//     minter, mirroring route_kind.pdx's KIND_INPUT_ROUTE exactly.
//   * Minted ATOMICALLY once per geometry-changing commit -- tail_
//     alloc's claim is the one write that makes the row visible, so
//     there is no partial-write window (contrast SET_STATE's in-place
//     mutation of an already-visible row).
//   * window_geometry_apply is the ONE consumer: copies the rect out,
//     then frees the row. A minted-but-unapplied row is a bounded
//     resource question (WG_MAX = 8), never a half-applied-state hazard.
//
// FORWARD NOTE -- RESIZE_TXN is explicitly OUT OF SCOPE. The issue's
// full design wants the interactive-resize DRAG itself as a separate
// LINEAR cap that must consume-or-abort before the next commit; that
// needs its own row shape (drag-start rect, live pointer-tracked rect,
// the authenticating seat cap) and its own KIND_* ordinal. This landing
// is the "announce" half only (set_window_geometry's non-interactive
// sibling) -- already useful on its own. A future landing mints
// KIND_WINDOW_RESIZE_TXN and calls window_geometry_mint at drag-end.
//
// SLOT ALLOCATION -- 0x1C3. Repo sweep at landing time (every defining
// `= 0x1XX` in src/**/*.pdx, 0x1B8..0x1DE inclusive): 0x1B8 SURFACE,
// 0x1B9 SURFACE_COMMIT, 0x1BA SUBSURFACE, 0x1BB..0x1C0 free, 0x1C1
// WINDOW, 0x1C2 LAYER_TREE, 0x1C3 free, 0x1C4 XDG_TOPLEVEL_STATE, 0x1C5
// XDG_POPUP, 0x1C6 CLIP_OFFER, 0x1C7 DND_OFFER, 0x1C8 RECOVERY_PLANE,
// 0x1C9 SELECTION_OWNER, 0x1CA..0x1CF free, 0x1D0..0x1DE fully claimed.
// 0x1BB..0x1C0 was window_kind.pdx's own B6-05 reservation for KIND_
// LAYER_TREE / KIND_SUBSURFACE, but both landed elsewhere (0x1C2, 0x1BA)
// so it was never drawn down -- genuinely free today (zero hits in
// src/ or design/architecture/next-wave-derived-kinds.md). This landing
// picks 0x1C3 over the larger free runs because KIND_WINDOW_GEOMETRY
// derives over KIND_WINDOW, not KIND_SURFACE: 0x1C3 is the single free
// slot between KIND_LAYER_TREE (0x1C2) and KIND_XDG_TOPLEVEL_STATE
// (0x1C4), keeping the KIND_WINDOW-derived cluster (0x1C1..0x1C9)
// contiguous. The task's fallback band (0x1E0..0x1FF) is not needed --
// 0x1B8..0x1DE is not full.
//
// FAILURE TAXONOMY -- 0xFFFFE830..0xFFFFE83F, pre-assigned by the issue
// dispatch, verified free by grep. The issue reserves seven names,
// assigned to the TOP of the band counting down (kind_tui_canvas.pdx /
// route_kind.pdx convention), plus ONE code the reserved list did not
// anticipate -- GEOM_BAD_SLOT, needed because apply must reject an out-
// of-range/already-freed row_id. Eight slots (0x830..0x837) stay as
// headroom for RESIZE_TXN or any gate this landing missed.
//
//   0xFFFFE83F GEOM_REFUSED_DENSE       mint: pool full (WG_MAX=8 in_use);
//                                       this file's "DENSE" == siblings' *_TAIL_ENOSPC.
//   0xFFFFE83E GEOM_RECT_OUTSIDE_BUFFER mint: rect not in [0,buf_w)x[0,buf_h) --
//                                       the "distinct from buffer extent" cross-check.
//   0xFFFFE83D GEOM_EDGE_CONFLICT       mint: TOP+BOTTOM or LEFT+RIGHT both set
//                                       (impossible drag); NOVEL over xdg_shell_geometry.pdx.
//   0xFFFFE83C GEOM_EDGE_INVALID        mint: edges bit outside RESIZE_EDGE_MASK (0x0F).
//   0xFFFFE83B GEOM_RECT_EMPTY          mint: w <= 0 or h <= 0 (i32).
//   0xFFFFE83A GEOM_NULL                mint: window_kind_id low u32 == 0; apply: out_ptr == 0.
//   0xFFFFE839 GEOM_NOT_INIT            mint/apply: window_geometry_init has not run.
//   0xFFFFE838 GEOM_BAD_SLOT            apply: row_id >= WG_MAX or not in_use.
//
// GEOM_NOT_INIT -- unlike this family's other row-pool kinds (kind_
// tui_canvas.pdx, window_kind.pdx, route_kind.pdx), which rely on .bss
// zero-init alone, this cap mints ATOMICALLY once per commit on the hot
// path: a geometry minted against an unswept pool before boot reaches
// this subsystem could forge a row from stale cross-boot memory.
// window_geometry_init() zeroes the pool and stamps `_wg_ready = 1`;
// mint_body/apply_body both refuse with GEOM_NOT_INIT until set -- the
// one deliberate divergence from the family's "rely on .bss" posture.
//
// ROW LAYOUT -- 64 BYTES (one cache line; power-of-2 so the pool-slot
// address is `idx << 6`, never `imul` -- kind_tui_canvas.pdx / route_
// kind.pdx precedent):
//
//   [+0]  header:  in_use[63:56] | reserved[55:0]
//   [+8]  ids:     window_kind_id[31:0] | serial[63:32]
//   [+16] rect_xy: x[31:0] (i32) | y[63:32] (i32)
//   [+24] rect_wh: w[31:0] (i32) | h[63:32] (i32)
//   [+32] edge:    edges[7:0] | reserved[63:8]
//   [+40..56] reserved1..3: u64 each, 0 at mint.
//
// window_kind_id names the KIND_WINDOW row this belongs to (borrowed
// authority; a future dispatch-handler landing owns the cap_table
// cross-check, same forward-reference posture window_kind.pdx / route_
// kind.pdx take). serial is the same compositor-issued token xdg_
// shell_geometry.pdx's WindowGeometryUpdate carries; 0 stays legal.
// THE BUFFER EXTENT IS NOT STORED IN THE ROW -- mint_body's caller
// supplies buffer_wh_packed only to validate the rect against it
// (GEOM_RECT_OUTSIDE_BUFFER); the row persists only the visible-region
// rect. That is the literal "distinct from its buffer extent": the
// cap's payload IS the visible region, the buffer extent is a one-shot
// validation input, never a persisted field.
//
// RESIZE-EDGE BITMASK (byte-stable with xdg_shell_states.pdx §4 /
// xdg_shell_geometry.pdx §4 -- duplicated locally, same self-contained-
// leaf rationale xdg_shell_geometry.pdx gives):
//
//   NONE=0x00 TOP=0x01 BOTTOM=0x02 LEFT=0x04 RIGHT=0x08
//   TOP_LEFT=0x05(T|L) TOP_RIGHT=0x09(T|R) BOTTOM_LEFT=0x06(B|L)
//   BOTTOM_RIGHT=0x0A(B|R) ALL/MASK=0x0F
//
// mint accepts NONE (plain, non-interactive announce) or any single
// edge / valid corner; refuses TOP|BOTTOM (0x03) and LEFT|RIGHT (0x0C)
// as GEOM_EDGE_CONFLICT -- a tightening xdg_shell_geometry.pdx's
// request-shape validator does not make.
//
// ENCODER DISCIPLINE (paideia-as strict). No `test rN,rN` (`cmp rN,0`
// throughout); no `and rN,imm64` (mask via `mov r,imm32` then reg-reg
// `and`); no 2-op `imul`; no `neg`/`cqo`/`idiv` (i32 positivity range-
// checked via unsigned cmp against 1 and 0x7FFFFFFF, mirroring xdg_
// shell_geometry.pdx); no `add reg,[mem]` (stats use load-inc-store);
// every lambda takes at most 6 args (mint hits the ceiling exactly).
// Every multi-call body keeps rsp%16==0 immediately before each `call`
// via callee-saved registers holding live args across it -- never a
// bare `push reg; call; pop reg`; the one spot needing a scratch value
// to survive a nested call (mint's refusal funnel) uses `sub rsp,16;
// mov [rsp],rax; call ...; mov rax,[rsp]; add rsp,16` instead. Module
// name WindowGeometry (M0305). Label prefix `wg*_`.
//
// FINGERPRINT is DATA-ONLY, not yet emitted -- same posture as this
// whole family (surface_kind.pdx, window_kind.pdx's window_mint, xdg_
// shell_geometry.pdx: none call klog_s1_x1 despite several having full
// real mint bodies with real row pools, exactly as this file does). A
// future cap_invoke_dispatch landing is the first consumer that may add
// the klog_s1_x1 call to mint_body's success tail; until then the
// string is allowlisted in tools/verify-fingerprint-coverage.sh.

module WindowGeometry = structure {

  // ==========================================================================
  // SECTION 1  KIND ORDINAL + PARENT
  // ==========================================================================

  pub let KIND_WINDOW_GEOMETRY      : u64 = 0x1CA
  pub let KIND_WINDOW_GEOMETRY_BASE : u64 = 0x1C1   // = KIND_WINDOW

  // ==========================================================================
  // SECTION 2  RIGHTS
  // ==========================================================================
  //
  // LINEAR discipline (route_kind.pdx precedent): NO R_MINT bit. The
  // compositor's own commit path is the sole caller of mint_body; a
  // future dispatch-handler landing that wires this kind into
  // cap_invoke_dispatch would expose only R_GEOM_QUERY to a client
  // holding the resulting cap, keeping R_GEOM_APPLY compositor-held
  // (mirrors R_ROUTE_REVOKE's "server-held" posture exactly).

  pub let R_GEOM_QUERY   : u64 = 0x001
  pub let R_GEOM_APPLY   : u64 = 0x008
  pub let R_GEOM_OBSERVE : u64 = 0x400
  pub let R_GEOM_ALL     : u64 = 0x409   // 0x001 | 0x008 | 0x400

  // ==========================================================================
  // SECTION 3  ROW LAYOUT CONSTANTS
  // ==========================================================================

  pub let WG_ROW_BYTES : u64 = 64
  pub let WG_MAX        : u64 = 8    // pool ceiling (kind_tui_canvas / route_kind precedent)

  pub let WG_OFF_HEADER   : u64 = 0
  pub let WG_OFF_IDS      : u64 = 8
  pub let WG_OFF_RECT_XY  : u64 = 16
  pub let WG_OFF_RECT_WH  : u64 = 24
  pub let WG_OFF_EDGE     : u64 = 32
  pub let WG_OFF_RESERVED1 : u64 = 40
  pub let WG_OFF_RESERVED2 : u64 = 48
  pub let WG_OFF_RESERVED3 : u64 = 56

  pub let WG_HDR_IN_USE_BIT : u64 = 56

  // ==========================================================================
  // SECTION 4  RESIZE-EDGE BITMASK (byte-stable with xdg_shell_states.pdx
  // and xdg_shell_geometry.pdx -- see file header)
  // ==========================================================================

  pub let RESIZE_EDGE_NONE         : u64 = 0x00
  pub let RESIZE_EDGE_TOP          : u64 = 0x01
  pub let RESIZE_EDGE_BOTTOM       : u64 = 0x02
  pub let RESIZE_EDGE_LEFT         : u64 = 0x04
  pub let RESIZE_EDGE_RIGHT        : u64 = 0x08
  pub let RESIZE_EDGE_TOP_LEFT     : u64 = 0x05   // TOP    | LEFT
  pub let RESIZE_EDGE_TOP_RIGHT    : u64 = 0x09   // TOP    | RIGHT
  pub let RESIZE_EDGE_BOTTOM_LEFT  : u64 = 0x06   // BOTTOM | LEFT
  pub let RESIZE_EDGE_BOTTOM_RIGHT : u64 = 0x0A   // BOTTOM | RIGHT
  pub let RESIZE_EDGE_ALL          : u64 = 0x0F   // TOP|BOTTOM|LEFT|RIGHT
  pub let RESIZE_EDGE_MASK         : u64 = 0x0F   // valid-bits mask

  // ==========================================================================
  // SECTION 5  FAILURE TAXONOMY -- 0xFFFFE830..0xFFFFE83F (see file header)
  // ==========================================================================

  pub let GEOM_OK                  : u64 = 0
  pub let GEOM_REFUSED_DENSE       : u64 = 0xFFFFE83F
  pub let GEOM_RECT_OUTSIDE_BUFFER : u64 = 0xFFFFE83E
  pub let GEOM_EDGE_CONFLICT       : u64 = 0xFFFFE83D
  pub let GEOM_EDGE_INVALID        : u64 = 0xFFFFE83C
  pub let GEOM_RECT_EMPTY          : u64 = 0xFFFFE83B
  pub let GEOM_NULL                : u64 = 0xFFFFE83A
  pub let GEOM_NOT_INIT            : u64 = 0xFFFFE839
  pub let GEOM_BAD_SLOT            : u64 = 0xFFFFE838

  // ==========================================================================
  // SECTION 6  STATS COUNTER SLOTS
  // ==========================================================================

  pub let WG_ST_MINTS   : u64 = 0
  pub let WG_ST_APPLIES : u64 = 1
  pub let WG_ST_REFUSED : u64 = 2
  pub let WG_ST_MAX     : u64 = 8

  // ==========================================================================
  // SECTION 7  FINGERPRINT + DEBUG STRINGS (data-only; see file header)
  // ==========================================================================

  pub let pdx_kind_window_geometry_meta : [u8; 58] = "window geometry init ok [legacy: WINDOW GEOMETRY INIT OK]\0"

  // ==========================================================================
  // SECTION 8  GLOBAL STATE
  // ==========================================================================

  pub let mut _wg_pool  : [u8; 512] = uninit @align(8)    // WG_MAX(8) * WG_ROW_BYTES(64)
  pub let mut _wg_stats : [u64; 8]  = uninit @align(64)
  pub let mut _wg_ready : u64       = uninit @align(8)

  // ==========================================================================
  // SECTION 9  VALIDATORS (pure leaves, no nested calls)
  // ==========================================================================

  // window_geometry_edges_valid(edges) -> 1 iff edges & ~RESIZE_EDGE_MASK == 0.
  pub let window_geometry_edges_valid : (u64) -> u64 !{} @{} =
    fn (edges: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B14 G7-M8-005 (#2263): 1 iff edges has no bit outside the low 4 (RESIZE_EDGE_MASK = 0x0F). ~0x0F computed via NOT of a small immediate to avoid a 64-bit MOVABS, mirroring xdg_shell_geometry.pdx's badedges guard exactly. Labels prefixed wgev_.",
      block: {
        mov r10, 0x0F;
        not r10;                  // r10 = ~0x0F
        mov r11, rdi;
        and r11, r10;
        cmp r11, 0;
        jne wgev_no;
        mov rax, 1;
        ret;
      wgev_no:
        xor rax, rax;
        ret
      }
    }

  // window_geometry_edges_conflict(edges) -> 1 iff edges names both TOP
  // and BOTTOM, or both LEFT and RIGHT -- a physically impossible single-
  // pointer drag. NOVEL over the sibling request-shape validator (see
  // file header). Does not itself require edges to be in-mask first;
  // callers gate window_geometry_edges_valid before this predicate.
  pub let window_geometry_edges_conflict : (u64) -> u64 !{} @{} =
    fn (edges: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B14 G7-M8-005 (#2263): 1 iff (edges & 0x03) == 0x03 (TOP+BOTTOM) or (edges & 0x0C) == 0x0C (LEFT+RIGHT). Two masked compares, no test. Labels prefixed wgec_.",
      block: {
        mov r10, rdi;
        and r10, 0x03;
        cmp r10, 0x03;
        je  wgec_yes;
        mov r10, rdi;
        and r10, 0x0C;
        cmp r10, 0x0C;
        je  wgec_yes;
        xor rax, rax;
        ret;
      wgec_yes:
        mov rax, 1;
        ret
      }
    }

  // window_geometry_rect_positive(wh_packed) -> 1 iff w > 0 and h > 0
  // as i32 (w = low32, h = high32). Positivity via unsigned range-check
  // against [1, 0x7FFFFFFF], mirroring xdg_shell_geometry.pdx's
  // window_geometry_update_new guard exactly (never idiv/neg/cqo).
  pub let window_geometry_rect_positive : (u64) -> u64 !{} @{} =
    fn (wh_packed: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B14 G7-M8-005 (#2263): w (low32 of wh_packed) and h (high32) both in [1, 0x7FFFFFFF] (positive i32). `cmp reg,1;jb` catches zero; `cmp reg,0x7FFFFFFF;ja` catches negative-as-u32 (>= 0x80000000). Labels prefixed wgrp_.",
      block: {
        mov r10, rdi;
        mov r11, 0xFFFFFFFF;
        and r10, r11;
        cmp r10, 1;
        jb  wgrp_no;
        mov r11, 0x7FFFFFFF;
        cmp r10, r11;
        ja  wgrp_no;

        mov r10, rdi;
        shr r10, 32;
        cmp r10, 1;
        jb  wgrp_no;
        cmp r10, r11;              // r11 still 0x7FFFFFFF
        ja  wgrp_no;

        mov rax, 1;
        ret;
      wgrp_no:
        xor rax, rax;
        ret
      }
    }

  // window_geometry_rect_within_buffer(xy_packed, wh_packed,
  // buffer_wh_packed) -> 1 iff x >= 0, y >= 0, x+w <= buf_w, y+h <=
  // buf_h. THE cross-check that gives this cap's payload its meaning
  // ("distinct from buffer extent" -- see file header): buffer_wh_packed
  // is consumed here only, never stored in the row.
  pub let window_geometry_rect_within_buffer : (u64, u64, u64) -> u64 !{} @{} =
    fn (xy_packed: u64) (wh_packed: u64) (buffer_wh_packed: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B14 G7-M8-005 (#2263): x=low32(xy), y=high32(xy) must be non-negative i32 (<= 0x7FFFFFFF, unsigned reading); x+w <= buf_w=low32(buffer_wh) and y+h <= buf_h=high32(buffer_wh), both plain reg-reg `add`/`cmp` (never add reg,[mem]; no overflow risk since every operand is bounded to <= 0x7FFFFFFF in a 64-bit register). Register plan: rdi=xy_packed, rsi=wh_packed, rdx=buffer_wh_packed; scratch rax/r8/r9/r10/r11 all caller-saved, no nested call so no callee-save discipline needed. Labels prefixed wgrwb_.",
      block: {
        mov r10, 0xFFFFFFFF;
        mov r11, 0x7FFFFFFF;

        mov rax, rdi;
        and rax, r10;
        cmp rax, r11;
        ja  wgrwb_no;
        mov r8, rax;               // r8 = x

        mov rax, rdi;
        shr rax, 32;
        cmp rax, r11;
        ja  wgrwb_no;
        mov r9, rax;               // r9 = y

        mov rax, rsi;
        and rax, r10;
        add r8, rax;                // r8 = x + w

        mov rax, rsi;
        shr rax, 32;
        add r9, rax;                // r9 = y + h

        mov rax, rdx;
        and rax, r10;
        cmp r8, rax;                // (x+w) <= buf_w ?
        ja  wgrwb_no;

        mov rax, rdx;
        shr rax, 32;
        cmp r9, rax;                // (y+h) <= buf_h ?
        ja  wgrwb_no;

        mov rax, 1;
        ret;
      wgrwb_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // SECTION 10  ROW POOL PRIMITIVES
  //
  // No standalone pack_xy/pack_wh helpers: mint's caller pre-packs per
  // the ROW LAYOUT table above (x[31:0]|y[63:32], w[31:0]|h[63:32]),
  // byte-compatible with xdg_shell_geometry.pdx's WindowGeometryUpdate
  // word1/word2 -- same "factor packing to the caller" posture that
  // file's own window_geometry_update_new takes.
  // ==========================================================================

  // window_geometry_row_valid(idx) -> 1 iff idx < WG_MAX and in_use set.
  // Inlines the address compute (idx << 6) rather than a nested call,
  // mirroring kind_tui_canvas.pdx's tui_canvas_row_valid exactly.
  pub let window_geometry_row_valid : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B14 G7-M8-005 (#2263): 1 iff idx < WG_MAX(8) and the row's in_use byte (bit 56 of word0) is set. Labels prefixed wgrv_.",
      block: {
        mov r10, 8;
        cmp rdi, r10;
        jae wgrv_no;
        lea r10, [rip + _wg_pool];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  wgrv_no;
        mov rax, 1;
        ret;
      wgrv_no:
        xor rax, rax;
        ret
      }
    }

  // window_geometry_tail_alloc(window_kind_id, serial, xy_packed,
  // wh_packed, edges) -> row_id | GEOM_REFUSED_DENSE. THE ONLY WRITER
  // of _wg_pool on the allocate path. Low-first scan over WG_MAX rows.
  pub let window_geometry_tail_alloc : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (window_kind_id: u64) (serial: u64) (xy_packed: u64) (wh_packed: u64) (edges: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B14 G7-M8-005 (#2263): claim one geometry row. Low-first free scan over 8 rows of 64 bytes (idx*64 via shl 6, never imul). Populates ids/rect_xy/rect_wh/edge per the row layout; words 5..7 zeroed. Five callee-save pushes (40 bytes) leave rsp%16==0 with no further adjustment needed (entry rsp%16==8, +40=48, 48%16==0) -- this function makes no nested call, so the alignment only matters for a future caller's expectations, not for any call inside this body. Labels prefixed wgta_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;               // window_kind_id
        mov r12, rsi;                // serial
        mov r13, rdx;                // xy_packed
        mov r14, rcx;                // wh_packed
        mov r15, r8;                  // edges

        xor rcx, rcx;                 // idx = 0
      wgta_scan:
        cmp rcx, 8;
        jae wgta_dense;

        lea r10, [rip + _wg_pool];
        mov r11, rcx;
        shl r11, 6;
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  wgta_claim;

        add rcx, 1;
        jmp wgta_scan;

      wgta_claim:
        mov rax, 1;
        shl rax, 56;
        mov [r10 + 0], rax;          // header: in_use = 1

        mov r9, 0xFFFFFFFF;
        mov rax, r12;                 // serial
        and rax, r9;
        shl rax, 32;
        mov r8, rbx;                  // window_kind_id
        and r8, r9;
        or  rax, r8;
        mov [r10 + 8], rax;           // ids: window_kind_id | serial

        mov [r10 + 16], r13;          // rect_xy
        mov [r10 + 24], r14;          // rect_wh

        mov rax, r15;
        and rax, 0xFF;
        mov [r10 + 32], rax;          // edge (reserved bits zero)

        xor rax, rax;
        mov [r10 + 40], rax;
        mov [r10 + 48], rax;
        mov [r10 + 56], rax;

        mov rax, rcx;                 // row_id
        jmp wgta_out;

      wgta_dense:
        mov rax, 0xFFFFE83F;          // GEOM_REFUSED_DENSE

      wgta_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // window_geometry_tail_free(idx) -> (). Scrub the whole 64-byte row.
  // THE consume half of the LINEAR contract: window_geometry_apply
  // calls this immediately after copying the rect out, returning the
  // row to the free list -- there is no separate "consumed but still
  // allocated" state (see file header's LINEAR discussion).
  pub let window_geometry_tail_free : (u64) -> () !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B14 G7-M8-005 (#2263): scrub one row (all eight words). No bounds re-check -- callers (window_geometry_apply) have already gated idx via window_geometry_row_valid. Labels prefixed wgtf_.",
      block: {
        mov r10, 8;
        cmp rdi, r10;
        jae wgtf_out;
        lea r10, [rip + _wg_pool];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        mov [r10 + 32], rax;
        mov [r10 + 40], rax;
        mov [r10 + 48], rax;
        mov [r10 + 56], rax;
      wgtf_out:
        ret
      }
    }

  // ==========================================================================
  // SECTION 11  STATS BOOKKEEPING (load-inc-store idiom; no add reg,[mem])
  // ==========================================================================

  pub let window_geometry_stats_bump_mints : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B14 G7-M8-005 (#2263): bump _wg_stats[WG_ST_MINTS=0]. Called from window_geometry_mint's success tail only. Labels prefixed wgsm_ (none needed, straight-line).",
      block: {
        lea r10, [rip + _wg_stats];
        mov rax, [r10 + 0];
        add rax, 1;
        mov [r10 + 0], rax;
        ret
      }
    }

  pub let window_geometry_stats_bump_applies : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B14 G7-M8-005 (#2263): bump _wg_stats[WG_ST_APPLIES=1]. Called from window_geometry_apply's success tail only, immediately before the row is freed. Labels prefixed wgsa_ (none needed, straight-line).",
      block: {
        lea r10, [rip + _wg_stats];
        mov rax, [r10 + 8];
        add rax, 1;
        mov [r10 + 8], rax;
        ret
      }
    }

  pub let window_geometry_stats_bump_refused : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B14 G7-M8-005 (#2263): bump _wg_stats[WG_ST_REFUSED=2]. Called ONLY from window_geometry_mint's shared refusal funnel (wgm_refused), mirroring kind_tui_canvas.pdx's tcm_refused / tui_stats_bump_refused convention: apply's own failure arms (GEOM_NOT_INIT, GEOM_NULL, GEOM_BAD_SLOT) do NOT bump this counter, matching that same narrow scope. Labels prefixed wgsr_ (none needed, straight-line).",
      block: {
        lea r10, [rip + _wg_stats];
        mov rax, [r10 + 16];
        add rax, 1;
        mov [r10 + 16], rax;
        ret
      }
    }

  // ==========================================================================
  // SECTION 12  MINT / APPLY BODIES
  // ==========================================================================

  // window_geometry_mint(window_kind_id, serial, xy_packed, wh_packed,
  // edges, buffer_wh_packed) -> row_id | GEOM_NOT_INIT | GEOM_NULL |
  // GEOM_EDGE_INVALID | GEOM_EDGE_CONFLICT | GEOM_RECT_EMPTY |
  // GEOM_RECT_OUTSIDE_BUFFER | GEOM_REFUSED_DENSE.
  //
  // Gate order (fail-fast; the shared funnel wgm_refused bumps
  // WG_ST_REFUSED exactly once regardless of which gate tripped):
  //   (1) subsystem initialized              -> GEOM_NOT_INIT
  //   (2) window_kind_id (low u32) != 0      -> GEOM_NULL
  //   (3) edges in RESIZE_EDGE_MASK           -> GEOM_EDGE_INVALID
  //   (4) edges has no opposite-pair conflict -> GEOM_EDGE_CONFLICT
  //   (5) w > 0 and h > 0 (i32)               -> GEOM_RECT_EMPTY
  //   (6) rect contained in buffer extent     -> GEOM_RECT_OUTSIDE_BUFFER
  //   (7) tail_alloc                          -> GEOM_REFUSED_DENSE
  //
  // Six args exactly fill SysV's six integer argument registers (rdi,
  // rsi, rdx, rcx, r8, r9) -- the maximum this codebase's unsafe-lambda
  // shape supports. Register plan: rbx=window_kind_id, r12=serial,
  // r13=xy_packed, r14=wh_packed, r15=edges, rbp=buffer_wh_packed, all
  // live across every nested call below. Six pushes + sub rsp,8: entry
  // rsp%16==8, +48+8=56, rsp%16==0 -- identical arithmetic to
  // kind_tui_canvas.pdx's kind_tui_canvas_mint_body.
  pub let window_geometry_mint : (u64, u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{} =
    fn (window_kind_id: u64) (serial: u64) (xy_packed: u64) (wh_packed: u64) (edges: u64) (buffer_wh_packed: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "Wave0-B14 G7-M8-005 (#2263): mint KIND_WINDOW_GEOMETRY. Gate order documented above the fn. No klog_s1_x1 emission -- fingerprint stays data-only, matching the whole compositor family's posture (surface_kind.pdx, window_kind.pdx's window_mint, xdg_shell_geometry.pdx). The success path stashes tail_alloc's row_id into r14 (dead by then -- wh_packed's last use was the tail_alloc call itself) before calling window_geometry_stats_bump_mints, since that call clobbers rax as scratch; rax is restored from r14 immediately after, mirroring kind_tui_canvas.pdx's kind_tui_canvas_mint_body rbp-stash pattern. Refusal funnel wgm_refused preserves the sentinel across the stats-bump call via `sub rsp,16; mov [rsp],rax; call; mov rax,[rsp]; add rsp,16` -- never a bare push/call/pop, per this file's own encoder discipline. Labels prefixed wgm_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;
        sub rsp, 8;

        mov rbx, rdi;                // window_kind_id
        mov r12, rsi;                 // serial
        mov r13, rdx;                 // xy_packed
        mov r14, rcx;                 // wh_packed
        mov r15, r8;                   // edges
        mov rbp, r9;                    // buffer_wh_packed

        // Gate 1: subsystem initialized.
        lea r10, [rip + _wg_ready];
        mov rax, [r10 + 0];
        cmp rax, 0;
        je  wgm_not_init;

        // Gate 2: window_kind_id (low u32) != 0.
        mov r10, rbx;
        mov r11, 0xFFFFFFFF;
        and r10, r11;
        cmp r10, 0;
        je  wgm_null;

        // Gate 3: edges within RESIZE_EDGE_MASK.
        mov rdi, r15;
        call window_geometry_edges_valid;
        cmp rax, 0;
        je  wgm_edge_invalid;

        // Gate 4: no opposite-edge conflict.
        mov rdi, r15;
        call window_geometry_edges_conflict;
        cmp rax, 0;
        jne wgm_edge_conflict;

        // Gate 5: rect strictly positive.
        mov rdi, r14;
        call window_geometry_rect_positive;
        cmp rax, 0;
        je  wgm_rect_empty;

        // Gate 6: rect contained within the buffer extent.
        mov rdi, r13;
        mov rsi, r14;
        mov rdx, rbp;
        call window_geometry_rect_within_buffer;
        cmp rax, 0;
        je  wgm_outside_buffer;

        // All validated -- claim a row.
        mov rdi, rbx;
        mov rsi, r12;
        mov rdx, r13;
        mov rcx, r14;
        mov r8,  r15;
        call window_geometry_tail_alloc;

        mov r10, 8;
        cmp rax, r10;
        jae wgm_dense;                // rax already holds GEOM_REFUSED_DENSE

        mov r14, rax;                 // stash row_id (r14/wh_packed is dead here)
        call window_geometry_stats_bump_mints;
        mov rax, r14;                 // restore row_id -- stats_bump clobbers rax

        jmp wgm_out;

      wgm_not_init:
        mov rax, 0xFFFFE839;          // GEOM_NOT_INIT
        jmp wgm_refused;
      wgm_null:
        mov rax, 0xFFFFE83A;          // GEOM_NULL
        jmp wgm_refused;
      wgm_edge_invalid:
        mov rax, 0xFFFFE83C;          // GEOM_EDGE_INVALID
        jmp wgm_refused;
      wgm_edge_conflict:
        mov rax, 0xFFFFE83D;          // GEOM_EDGE_CONFLICT
        jmp wgm_refused;
      wgm_rect_empty:
        mov rax, 0xFFFFE83B;          // GEOM_RECT_EMPTY
        jmp wgm_refused;
      wgm_outside_buffer:
        mov rax, 0xFFFFE83E;          // GEOM_RECT_OUTSIDE_BUFFER
        jmp wgm_refused;
      wgm_dense:
        // rax already GEOM_REFUSED_DENSE (0xFFFFE83F) from tail_alloc.

      wgm_refused:
        sub rsp, 16;
        mov [rsp], rax;
        call window_geometry_stats_bump_refused;
        mov rax, [rsp];
        add rsp, 16;

      wgm_out:
        add rsp, 8;
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // window_geometry_apply(row_id, out_ptr) -> GEOM_OK | GEOM_NOT_INIT |
  // GEOM_NULL | GEOM_BAD_SLOT.
  //
  // COMPOSITOR CONSUMER STUB: copies the row's rect_xy + rect_wh (16
  // bytes) into the caller-provided out_ptr buffer, then FREES the row
  // -- the LINEAR one-shot consume. This is the "stub" half the issue
  // asks for: a real compositor paint step reads out_ptr and lowers it
  // onto the swapchain plane, but the actual lowering is out of scope
  // for this landing (no compositor paint-loop file exists yet to call
  // into). What this function guarantees, correctly, TODAY is the
  // consume-or-nothing contract: either out_ptr is fully populated and
  // the row is gone, or an error is returned and neither happened.
  //
  // Gate order: (1) subsystem initialized -> GEOM_NOT_INIT; (2) out_ptr
  // != 0 -> GEOM_NULL; (3) row_id valid + in_use -> GEOM_BAD_SLOT.
  // Failure arms do NOT bump WG_ST_REFUSED (mirrors kind_tui_canvas.pdx
  // / route_kind.pdx: revoke/consume-path failures are not counted as
  // mint refusals).
  //
  // Register plan: rbx=row_id, r12=out_ptr, preserved across the two
  // nested calls (row_valid, tail_free). Two pushes (16 bytes) + sub
  // rsp,8 (8 bytes): entry rsp%16==8, +16+8=24 more -> 32, rsp%16==0.
  pub let window_geometry_apply : (u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64) (out_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B14 G7-M8-005 (#2263): consume one KIND_WINDOW_GEOMETRY row -- copy rect_xy/rect_wh into out_ptr, then free the row (LINEAR one-shot apply). Two callee-save pushes (rbx=row_id, r12=out_ptr) + sub rsp,8 leave rsp%16==0 across both nested calls (entry 8, +16=24, +8=32, 32%16==0). Labels prefixed wga_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        mov rbx, rdi;                // row_id
        mov r12, rsi;                 // out_ptr

        // Gate 1: subsystem initialized.
        lea r10, [rip + _wg_ready];
        mov rax, [r10 + 0];
        cmp rax, 0;
        je  wga_not_init;

        // Gate 2: out_ptr != 0.
        cmp r12, 0;
        je  wga_null;

        // Gate 3: row_id valid + in_use.
        mov rdi, rbx;
        call window_geometry_row_valid;
        cmp rax, 0;
        je  wga_bad_slot;

        // Copy rect_xy + rect_wh (16 bytes) into the caller buffer.
        lea r10, [rip + _wg_pool];
        mov r11, rbx;
        shl r11, 6;
        add r10, r11;

        mov rax, [r10 + 16];         // rect_xy
        mov [r12 + 0], rax;
        mov rax, [r10 + 24];         // rect_wh
        mov [r12 + 8], rax;

        // Consume: free the row back to the pool.
        mov rdi, rbx;
        call window_geometry_tail_free;

        call window_geometry_stats_bump_applies;

        xor rax, rax;                // GEOM_OK
        jmp wga_out;

      wga_not_init:
        mov rax, 0xFFFFE839;         // GEOM_NOT_INIT
        jmp wga_out;
      wga_null:
        mov rax, 0xFFFFE83A;         // GEOM_NULL
        jmp wga_out;
      wga_bad_slot:
        mov rax, 0xFFFFE838;         // GEOM_BAD_SLOT

      wga_out:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION 13  BOOT INIT
  // ==========================================================================

  // window_geometry_init() -> (). Zero the pool + stats, then stamp
  // _wg_ready = 1. MUST run before any window_geometry_mint / apply
  // call -- see file header's GEOM_NOT_INIT discussion for why this
  // kind, unlike its .bss-reliant siblings, demands an explicit
  // readiness stamp rather than relying on zero-init alone.
  pub let window_geometry_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B14 G7-M8-005 (#2263): zero _wg_pool (64 u64 words = 512 bytes) and _wg_stats (8 u64 words), then set _wg_ready = 1. Labels prefixed wgi_.",
      block: {
        lea r10, [rip + _wg_pool];
        xor rax, rax;
        xor rcx, rcx;
      wgi_pool:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 64;
        jb  wgi_pool;

        lea r10, [rip + _wg_stats];
        xor rcx, rcx;
      wgi_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  wgi_stats;

        lea r10, [rip + _wg_ready];
        mov rax, 1;
        mov [r10 + 0], rax;
        ret
      }
    }
}
