// src/user/compositor/recovery_plane_takeover.pdx -- Wave0-B7-06 (paideia-os #2270)
//
// Recovery-plane TAKEOVER flow. Extends the reservation minted by
// src/user/compositor/recovery_plane_reserve.pdx (Wave-0 Batch-6,
// paideia-os #2269). Design authority: design/compositor/pwp-spec-
// vocabulary.md §2.17 KIND_RECOVERY_PLANE, "takeover flow promotes the
// input server to display source when compositor death is detected".
//
// The reservation landing was DELIBERATELY reservation-only (see #2269
// section header, "The takeover flow ... lands separately at
// paideia-os #2270"). This file is that separate landing: it does NOT
// re-declare KIND_RECOVERY_PLANE, does NOT re-derive over
// KIND_DISPLAY_PLANE, does NOT touch the singleton reservation cell.
// Its state is a distinct singleton -- one TakeoverEvent record plus a
// one-byte in-progress flag plus a monotonic takeover_seq counter --
// so a caller reading the reservation cell sees an unchanged snapshot
// while takeover state advances on the takeover cell.
//
// =============================================================================
// SECTION 0  RIGHTS -- NEW RIGHT ADDED ON TOP OF THE RESERVATION
// =============================================================================
//
// The reservation cap (#2269) carries RIGHT_HOLD_PLANE (0x001) and
// RIGHT_QUERY_PLANE_INFO (0x002). This landing introduces:
//
//   RIGHT_TAKEOVER   (0x004) -- the authority to execute the takeover
//                               flow (recovery_plane_takeover_execute)
//                               on the reservation.
//
// Kept STRUCTURALLY SEPARATE from the reservation's rights so that
// #2269's reservation cap CANNOT itself execute takeover: the boot-
// time mint in recovery_plane_reserve_at_boot produces a cap whose
// R_RP_ALL bound is 0x003; RIGHT_TAKEOVER (0x004) is added to that
// cap by an EXPLICIT input-server-startup step (a future kind that
// will land alongside the input-server process kind, gated on the
// input server having proved liveness at least once). The gate in
// recovery_plane_takeover_execute below refuses without this bit
// set, so a compositor that somehow smuggled a reservation cap
// STILL cannot execute takeover.
//
// R_RP_ALL widens to 0x007 as a matter of taxonomy documentation.
// The sibling reservation file's #2269 header line 152 already
// anticipates this widening ("When #2270 lands, R_RP_ALL widens to
// include RIGHT_TAKEOVER"); this file's R_RP_ALL_TAKEOVER constant
// is the widened value, kept locally so the reservation file need
// not be edited by this landing.
//
// =============================================================================
// SECTION 1  COMPOSITOR-DEATH TRIGGER TAXONOMY
// =============================================================================
//
// Four flavors of compositor death enumerate the trigger. Chosen so a
// post-mortem reads why the input server took over, and so a future
// integrity kind can require particular trigger evidence (e.g. an
// EXPLICIT trigger requires a signed abort receipt from the
// compositor's own liveness watchdog):
//
//   DEATH_TIMEOUT  (0) -- compositor missed its liveness deadline
//   DEATH_EXPLICIT (1) -- compositor filed an explicit abort receipt
//   DEATH_HW_HANG  (2) -- GPU/display hardware watchdog observed hang
//   DEATH_SIGSEGV  (3) -- compositor process died with SIGSEGV or
//                         equivalent kernel-observed fault
//
// The trigger byte is stored verbatim in TakeoverEvent.trigger and is
// NOT validated by the takeover gate. Callers with a bad trigger get
// their bad value back in the event record; policy over which trigger
// is acceptable lives in a higher layer.
//
// =============================================================================
// SECTION 2  TAKEOVER-EVENT ROW LAYOUT -- 24 BYTES (SINGLETON CELL)
// =============================================================================
//
// One TakeoverEvent per takeover attempt (successful or not: the cell
// records only successful takeovers, since failures return early
// before the recorder runs -- see gate order). The cell is a distinct
// singleton, NOT reused for reservation state:
//
//   [+0]   word0:  trigger[7:0]                      (u8 enum)
//                | reserved[31:8]                    (0)
//                | dead_compositor_process_kind_id[63:32]
//   [+8]   word1:  takeover_seq (u64)                (monotonic; post-
//                                                     bump value of the
//                                                     counter at word3)
//   [+16]  word2:  pre_takeover_recovery_reservation[31:0]
//                                                    (holder cap-kind
//                                                     id snapshot at
//                                                     takeover time --
//                                                     see field notes)
//                | reserved[63:32]                   (0)
//
// The singleton counter _recovery_plane_takeover_seq_counter (one u64)
// lives beside the cell. It is bumped on every successful takeover;
// its post-bump value is the takeover_seq witness. Same rationale as
// #2269's counter: user-space effect envelope means no rdtsc.
//
// The in-progress flag _recovery_plane_takeover_in_progress_flag
// (one u8 in a padded u64 cell) is the idempotent guard. It is
// CHECKED then SET; a second takeover attempt reads it and returns
// TO_ALREADY_ACTIVE without touching any other cell.
//
// The plane display-source state _recovery_plane_display_source_kind_id
// (one u64) tracks the current display source. Before any takeover it
// is zero (meaning "compositor still owns display"; the compositor's
// process kind id is a forward reservation and is not stamped here to
// keep the pre-takeover value POLICY-FREE). After a successful
// takeover it holds RESERVATION_HOLDER_KIND (0x1D0) -- the input
// server is now the display source. The swap in step 5 of the gate
// is a single-word store.
//
// pre_takeover_recovery_reservation field: paideia-as does not
// currently mint distinct u32 reservation-cell handles per row (the
// cell is a singleton, not a rowed table), so this field's cleanest
// witness is the holder_process_kind_id read from the reservation
// cell at takeover time. That value MUST be RESERVATION_HOLDER_KIND
// (0x1D0) for the takeover to proceed (gate step 2). Storing it here
// serves as an audit trail: any later reader of TakeoverEvent sees
// which kind id was in the reservation at the moment of promotion.
//
// =============================================================================
// SECTION 3  GATE ORDER -- recovery_plane_takeover_execute
// =============================================================================
//
// The execute path is a five-step gate followed by a two-store commit.
// Gates fire in the order the spec (issue #2270) calls out, and a
// failure at any gate returns before ANY state is written:
//
//   (1) Assert caller holds RIGHT_TAKEOVER on the reservation cap.
//       rdi carries the rights bitmap of the caller's reservation cap;
//       the low bits are the rights (bit 2 == RIGHT_TAKEOVER). Missing
//       -> TO_NO_RIGHT.
//
//   (2) Assert reservation.holder == caller. The reservation cell's
//       holder_process_kind_id (read from _recovery_plane_reservation_
//       cell + 8) MUST equal RESERVATION_HOLDER_KIND (0x1D0). This is
//       structurally equivalent to "the input server holds the
//       reservation" because #2269's factory refuses any other value.
//       Wrong -> TO_WRONG_HOLDER.
//
//   (3) Refuse if takeover already in progress. Read the in-progress
//       flag; if set, return TO_ALREADY_ACTIVE without touching any
//       other cell (idempotent guard).
//
//   (4) Record TakeoverEvent. Bump the takeover_seq counter (load-inc-
//       store; no `add reg,[mem]`), then write the three cell words
//       described in §2.
//
//   (5) Swap plane ownership. Store RESERVATION_HOLDER_KIND (0x1D0)
//       into _recovery_plane_display_source_kind_id. The dead
//       compositor's kind id (rdx on entry) is recorded in the event
//       for audit; the swap itself is unconditional-to-input-server
//       because the reservation cell's holder is already 0x1D0 by
//       gate (2).
//
//   (6) Set _takeover_in_progress = 1. This must be the LAST write:
//       a concurrent second caller that raced through gate (3) will
//       still lose gate (2)/(1), and setting the flag last means a
//       partial takeover cannot leave the flag armed with the event
//       cell empty.
//
// Return codes: TO_OK / TO_NO_RIGHT / TO_WRONG_HOLDER / TO_ALREADY_ACTIVE.
//
// =============================================================================
// SECTION 4  FAILURE TAXONOMY 0xFFFFE9D0..0xFFFFE9DF
// =============================================================================
//
// A repo-wide grep at landing time confirms 0xFFFFE9xx is unclaimed
// across src/ and design/ (adjacent bands 0xFFFFE9C0..CF and
// 0xFFFFE9E0..EF are also free). Chosen ONE BAND below the sibling
// reservation's 0xFFFFEED0..DF because the 0xFFFFEExx space is nearly
// fully populated (KIND_VK_SWAPCHAIN_IMAGE at EE00..0F,
// KIND_VK_SURFACE at EE10..1F, gui_layout at EEC0..CF, reservation
// at EED0..DF, HDR metadata at EEE0..EF, KIND_TONEMAP_LUT at
// EEF0..FF). The last-nibble tier D0..DF mirrors the sibling's
// choice so auditors can grep the two bands together and read them
// as a pair.
//
// =============================================================================
// SECTION 5  FINGERPRINT TAG
// =============================================================================
//
// ONE fingerprint tag on the module data, ending [legacy: ... OK] per
// softarch discipline. Same allowlist posture as the sibling
// reservation's pdx_kind_recovery_plane_meta: the future kernel-side
// dispatcher's takeover body will emit this string via klog_s1 on the
// successful takeover path; until that landing arrives the string is a
// data-only constant and needs an allowlist entry in
// tools/verify-fingerprint-coverage.sh with reason "recovery-plane
// takeover dispatcher not yet landed (G7.M6-002 / #2270)". Adding
// that allowlist entry is a SEPARATE landing; this file does not
// touch tools/.

module RecoveryPlaneTakeover = structure {

  // ==========================================================================
  // Identity (mirror of the reservation's, for local reference).
  //
  // KIND_RECOVERY_PLANE is authoritatively declared in
  // src/user/compositor/recovery_plane_reserve.pdx. The value is
  // repeated here so this module's asm bodies can compare against it
  // without an inter-module const reference (paideia-as does not
  // resolve peer-module `let` bindings inside asm blocks).
  // ==========================================================================

  pub let KIND_RECOVERY_PLANE      : u64 = 0x1C8
  pub let RESERVATION_HOLDER_KIND  : u64 = 0x1D0

  // ==========================================================================
  // Rights (see §0).
  //
  // RIGHT_HOLD_PLANE and RIGHT_QUERY_PLANE_INFO are declared in the
  // sibling reservation file; the constants are NOT re-exported here
  // to keep this module's rights surface strictly to what it adds.
  // R_RP_ALL_TAKEOVER is the WIDENED subset bound (0x007) that
  // includes all three rights; a future dispatcher-side subset check
  // uses this bound.
  // ==========================================================================

  pub let RIGHT_TAKEOVER           : u64 = 0x004
  pub let R_RP_ALL_TAKEOVER        : u64 = 0x007

  // ==========================================================================
  // Compositor-death trigger taxonomy (see §1).
  // ==========================================================================

  pub let DEATH_TIMEOUT            : u64 = 0
  pub let DEATH_EXPLICIT           : u64 = 1
  pub let DEATH_HW_HANG            : u64 = 2
  pub let DEATH_SIGSEGV            : u64 = 3

  // ==========================================================================
  // TakeoverEvent cell layout constants (see §2).
  // ==========================================================================

  pub let TO_EVENT_CELL_BYTES      : u64 = 24
  pub let TO_EVENT_CELL_WORDS      : u64 = 3

  // ==========================================================================
  // Failure taxonomy -- 0xFFFFE9D0..0xFFFFE9DF (see §4).
  // ==========================================================================

  pub let TO_OK                    : u64 = 0
  pub let TO_NO_RIGHT              : u64 = 0xFFFFE9D1
  pub let TO_WRONG_HOLDER          : u64 = 0xFFFFE9D2
  pub let TO_ALREADY_ACTIVE        : u64 = 0xFFFFE9D3
  pub let TO_DECODE_BAD            : u64 = 0xFFFFFFFFFFFFFFFF

  // ==========================================================================
  // Struct shape (see §2 for byte layout).
  //
  // Same declaration posture as the sibling reservation's
  // RecoveryPlaneReservation: shape is declared for documentation and
  // for future typed access; asm bodies drive the cell via offsets.
  // ==========================================================================

  struct TakeoverEvent {
    trigger: u8,
    dead_compositor_process_kind_id: u32,
    takeover_seq: u64,
    pre_takeover_recovery_reservation: u32
  }

  // ==========================================================================
  // Singleton state (see §2).
  //
  // Four cells, each independently scrubbed to zero by .bss at boot:
  //
  //   - _recovery_plane_takeover_event_cell         : 24 bytes (last event)
  //   - _recovery_plane_takeover_seq_counter        : u64
  //   - _recovery_plane_takeover_in_progress_flag   : u64 (u8 in low byte)
  //   - _recovery_plane_display_source_kind_id      : u64 (current source)
  //
  // The reservation cell itself is NOT redeclared: this module reads
  // from src/user/compositor/recovery_plane_reserve.pdx's
  // _recovery_plane_reservation_cell by absolute symbol name in the
  // rpt_x_ body (rip-relative lea against the sibling's exported
  // singleton -- both modules are linked into the input-server
  // binary at the same static-link stage).
  // ==========================================================================

  pub let mut _recovery_plane_takeover_event_cell        : [u8; 24] = uninit @align(8)
  pub let mut _recovery_plane_takeover_seq_counter       : [u64; 1] = uninit @align(8)
  pub let mut _recovery_plane_takeover_in_progress_flag  : [u64; 1] = uninit @align(8)
  pub let mut _recovery_plane_display_source_kind_id     : [u64; 1] = uninit @align(8)

  // ==========================================================================
  // Fingerprint tag (see §5).
  //
  // Size is 63 payload bytes + 1 NUL = 64 bytes.
  // ==========================================================================

  pub let pdx_kind_recovery_plane_takeover_meta : [u8; 64] = "recovery plane takeover ok [legacy: RECOVERY PLANE TAKEOVER OK]\0"

  // ==========================================================================
  // recovery_plane_takeover_execute(reservation_cap_rights, trigger, dead_process)
  //   rdi = reservation_cap rights bitmap
  //   rsi = trigger (u8 in low byte, high bits ignored)
  //   rdx = dead compositor process kind id (u32 in low 32, high bits ignored)
  //
  // Gate order per §3. Return per §3/§4. Labels prefixed rpt_x_.
  //
  // Frame: no callee-save pushes needed (no nested call). rdi/rsi/rdx
  // are stashed into r8/r9/r11 before any load-inc-store on the
  // counter so no argument is clobbered by rax use.
  // Entry rsp%16==8 stays throughout.
  // ==========================================================================

  pub let recovery_plane_takeover_execute : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (reservation_cap_rights: u64, trigger: u64, dead_process: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B7-06 (paideia-os #2270): five-gate takeover. (1) rdi & RIGHT_TAKEOVER(0x004) must be nonzero else TO_NO_RIGHT. (2) reservation cell holder_process_kind_id (word1 low32 at [_recovery_plane_reservation_cell+8]) must equal RESERVATION_HOLDER_KIND(0x1D0) else TO_WRONG_HOLDER. (3) _recovery_plane_takeover_in_progress_flag low byte must be zero else TO_ALREADY_ACTIVE. (4) bump _recovery_plane_takeover_seq_counter via load-inc-store (no `add reg,[mem]`), publish 24-byte TakeoverEvent cell -- word0 = trigger[7:0] | dead[63:32], word1 = takeover_seq, word2 = pre_takeover_recovery_reservation (the reservation holder read in step 2). (5) swap plane display source: store RESERVATION_HOLDER_KIND(0x1D0) into _recovery_plane_display_source_kind_id. (6) set in-progress flag LAST so a partial takeover cannot leave the flag armed with the event cell empty. Args stashed into r8 (rights), r9 (trigger), r11 (dead_process) before any rax use. No `test`, no `add reg,[mem]`. Labels prefixed rpt_x_.",
      block: {
        // Stash args before any rax use.
        mov r8, rdi;                             // r8 = rights bitmap
        mov r9, rsi;                             // r9 = trigger
        mov r11, rdx;                            // r11 = dead_process

        // (1) RIGHT_TAKEOVER (0x004) must be set.
        mov rax, r8;
        and rax, 0x4;
        cmp rax, 0;
        je  rpt_x_no_right;

        // (2) Reservation cell holder must equal RESERVATION_HOLDER_KIND.
        //     Read holder_process_kind_id (word1 low32) from the sibling
        //     module's singleton. Store the holder in r10 for the audit
        //     trail (pre_takeover_recovery_reservation).
        lea rcx, [rip + _recovery_plane_reservation_cell];
        mov rax, [rcx + 8];
        and rax, 0xFFFFFFFF;
        mov r10, rax;                            // r10 = holder snapshot
        mov rcx, 0x1D0;                          // RESERVATION_HOLDER_KIND
        cmp rax, rcx;
        jne rpt_x_wrong_holder;

        // (3) Refuse if already in progress.
        lea rcx, [rip + _recovery_plane_takeover_in_progress_flag];
        mov rax, [rcx];
        and rax, 0xFF;
        cmp rax, 0;
        jne rpt_x_already;

        // (4) Bump seq counter (load-inc-store); rdx (== takeover_seq)
        //     will be published into the event cell word1.
        lea rcx, [rip + _recovery_plane_takeover_seq_counter];
        mov rax, [rcx];
        add rax, 1;
        mov [rcx], rax;
        mov rdi, rax;                            // rdi = takeover_seq

        // (4) Publish event cell (24 bytes).
        lea rcx, [rip + _recovery_plane_takeover_event_cell];

        // word0: trigger[7:0] | reserved[31:8] | dead[63:32]
        mov rax, r9;
        and rax, 0xFF;                           // trigger low byte
        mov rsi, r11;
        and rsi, 0xFFFFFFFF;                     // dead kind id low32
        shl rsi, 32;
        or  rax, rsi;
        mov [rcx + 0], rax;

        // word1: takeover_seq
        mov [rcx + 8], rdi;

        // word2: pre_takeover_recovery_reservation (holder snapshot)
        //        packed in low32; high 32 bits reserved zero.
        mov rax, r10;
        and rax, 0xFFFFFFFF;
        mov [rcx + 16], rax;

        // (5) Swap plane display source to the input server.
        lea rcx, [rip + _recovery_plane_display_source_kind_id];
        mov rax, 0x1D0;                          // RESERVATION_HOLDER_KIND
        mov [rcx], rax;

        // (6) Arm the in-progress flag LAST.
        lea rcx, [rip + _recovery_plane_takeover_in_progress_flag];
        mov rax, 1;
        mov [rcx], rax;

        xor rax, rax;                            // TO_OK
        ret;

      rpt_x_no_right:
        mov rax, 0xFFFFE9D1;                     // TO_NO_RIGHT
        ret;

      rpt_x_wrong_holder:
        mov rax, 0xFFFFE9D2;                     // TO_WRONG_HOLDER
        ret;

      rpt_x_already:
        mov rax, 0xFFFFE9D3;                     // TO_ALREADY_ACTIVE
        ret
      }
    }

  // ==========================================================================
  // recovery_plane_takeover_in_progress() -> bool (1 iff flag set).
  //
  // Read the u8 in-progress flag from its dedicated singleton cell.
  // Callers wanting a full status snapshot combine this with
  // recovery_plane_takeover_last_event.
  //
  // Labels prefixed rpt_ip_.
  // ==========================================================================

  pub let recovery_plane_takeover_in_progress : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B7-06 (paideia-os #2270): 1 iff low byte of _recovery_plane_takeover_in_progress_flag is nonzero. No `test`. Labels prefixed rpt_ip_.",
      block: {
        lea r10, [rip + _recovery_plane_takeover_in_progress_flag];
        mov rax, [r10];
        and rax, 0xFF;
        cmp rax, 0;
        je  rpt_ip_no;
        mov rax, 1;
        ret;
      rpt_ip_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // recovery_plane_takeover_last_event(&mut out) -> u64
  //   rdi = destination pointer (24 bytes writable)
  //
  // Copy the singleton TakeoverEvent cell into the caller-supplied
  // buffer. Returns the takeover_seq of the copied event (0 if no
  // takeover has ever succeeded, since the counter starts at 0 and is
  // post-bumped to 1 on the first successful takeover). Passing rdi=0
  // is a caller error; the store will fault the mapped-nothing low
  // address rather than silently succeed.
  //
  // Labels prefixed rpt_le_. Copy is three u64 stores (24 bytes), no
  // rep movsq needed for a fixed 3-word cell.
  // ==========================================================================

  pub let recovery_plane_takeover_last_event : (u64) -> u64 !{mem} @{} =
    fn (out: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B7-06 (paideia-os #2270): copy the 24-byte _recovery_plane_takeover_event_cell into [rdi..rdi+24] via three u64 loads and three u64 stores. Return takeover_seq (word1) so a caller can observe monotonic progress without a second call. rdi=0 is caller error and will fault the store. Labels prefixed rpt_le_.",
      block: {
        lea r10, [rip + _recovery_plane_takeover_event_cell];
        mov rax, [r10 + 0];
        mov [rdi + 0], rax;
        mov rcx, [r10 + 8];                      // rcx = takeover_seq
        mov [rdi + 8], rcx;
        mov rax, [r10 + 16];
        mov [rdi + 16], rax;
        mov rax, rcx;                            // return takeover_seq
        ret
      }
    }

  // ==========================================================================
  // Defensive boot-time reset (.bss is already zero at real boot).
  //
  // Mirrors rp_init in the sibling reservation file. Zeroes the four
  // singletons this module owns. Does NOT touch the reservation
  // cell -- that is the sibling module's state and its own rp_init
  // handles it.
  //
  // Labels prefixed rpt_i_.
  // ==========================================================================

  pub let recovery_plane_takeover_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B7-06 (paideia-os #2270): zero the four singletons (event cell 24 bytes as three u64 stores, seq counter, in-progress flag, display source). Defensive re-scrub only; .bss is already zero at real boot. Labels prefixed rpt_i_.",
      block: {
        xor rax, rax;

        lea r10, [rip + _recovery_plane_takeover_event_cell];
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;

        lea r10, [rip + _recovery_plane_takeover_seq_counter];
        mov [r10 + 0], rax;

        lea r10, [rip + _recovery_plane_takeover_in_progress_flag];
        mov [r10 + 0], rax;

        lea r10, [rip + _recovery_plane_display_source_kind_id];
        mov [r10 + 0], rax;

        ret
      }
    }
}
