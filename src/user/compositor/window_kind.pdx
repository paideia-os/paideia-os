// src/user/compositor/window_kind.pdx -- Wave0-B6-05 (paideia-os #2254)
//
// KIND_WINDOW = 0x1C1, derived over KIND_SURFACE.
// Design authority: design/compositor/pwp-spec-vocabulary.md §2.4
// (KIND_WINDOW), plus pitfall P4 (a11y as first-class protocol
// participant, not a sidecar) from design/roadmap/next-wave-synthesis.md
// §4. This landing is one of five G7.M2/M3 parallel Batch-6 rows:
// B6-01..04 land KIND_SURFACE + KIND_SURFACE_COMMIT + surface geometry
// + buffer-attach at slots 0x1B8..0x1BB; this row (B6-05) is the first
// KIND_SURFACE-child cap and picks 0x1C1 per the Wave-0 dispatch
// manifest, leaving 0x1BC..0x1C0 open for G7.M3-002 (KIND_LAYER_TREE)
// and G7.M3-003 (KIND_SUBSURFACE sync-mode) sibling landings.
//
// One KIND_WINDOW row names one toplevel-window authority the
// compositor mints for a client. Adds the four slots vocabulary §2.4
// enumerates on top of the parent KIND_SURFACE row: z-order rank
// (compositor-authoritative), parent-window edge (for modality), tab-
// order rank in the window's Group, and workspace binding. Also carries
// -- MANDATORILY, per P4 -- an a11y-tree binding: window_mint refuses
// with WIN_MINT_NO_A11Y (0xFFFFEAA9) when a11y_tree_kind_id is zero.
// The impossible-to-compile-an-inaccessible-window property is
// STRUCTURAL: no code path in this file can populate a window row
// without a nonzero a11y_tree_kind_id, and the row layout has no
// escape hatch for "elaborate a11y later". This is the novel-clean
// posture over the Wayland precedent where a11y is a sidecar bolted
// on after the fact via an out-of-band ATSPI bridge.
//
// This module is user-space (svc-compositor process, ring 3). It is
// NOT wired into `cap_table` / `cap_invoke_dispatch`; a future landing
// that promotes KIND_WINDOW authority into the kernel would mirror the
// `kind_color_profile.pdx` (0x18F) posture and wire the same op catalog
// through `cap_invoke_dispatch`, but nothing in this file prevents
// that promotion. Pattern parallel: src/user/color/reference_display_
// kind.pdx (B1-05, KIND_REFERENCE_DISPLAY at 0x1B7) landed the same
// shape for a user-space derived cap with rights bitmask + row pool +
// mint factory.
//
// =============================================================================
// SECTION 0  KIND_* SLOT ALLOCATION
// =============================================================================
//
// Consulted `design/architecture/next-wave-derived-kinds.md` §"Summary
// counts and free bands" (line 2397). At B1-05 landing time the "next
// free tag" line named 0x1B7; B1-05 (`kind_hdr_metadata.pdx` and
// `reference_display_kind.pdx`) claimed 0x1B5 + 0x1B7 in the G7+ band
// (0x1B2..0x1BF documented as available by `design/graphics/r101-
// kernel-plan.md` §5). Wave-0 Batch-6 dispatch order allocates:
//   0x1B8   KIND_SURFACE                  (B6-01, g7-M2-001)
//   0x1B9   KIND_SURFACE_COMMIT           (B6-02, g7-M2-002)
//   0x1BA   surface geometry              (B6-03, g7-M2-003)
//   0x1BB   buffer-attach state           (B6-04, g7-M2-004)
//   0x1BC..0x1C0  RESERVED for G7.M3-002 (KIND_LAYER_TREE) and
//                 G7.M3-003 (KIND_SUBSURFACE sync-mode), keeping the
//                 KIND_SURFACE-family contiguous.
//   0x1C1   KIND_WINDOW                   (B6-05, THIS FILE)
// Cross-verified by grep over `src/**/kind_*.pdx` + `src/user/**` at
// landing -- no live claim on 0x1C1.
//
// If B6-01 lands KIND_SURFACE at a slot other than 0x1B8, the
// WIN_PARENT_KIND constant below is the single reconciliation point
// (one-line edit + fingerprint re-emission).
//
// =============================================================================
// SECTION 1  DERIVATION OVER KIND_SURFACE
// =============================================================================
//
// The kind half of the mint gate demands `kind == KIND_SURFACE (0x1B8)`
// carrying RIGHT_MINT. The KIND_SURFACE parent contributes the client-
// facing composition primitive (2D region + scale + viewport + transform
// + colour profile + damage region reference); KIND_WINDOW layers the
// toplevel-window authority on top: focus-eligibility, z-order rank,
// parent-window edge for modality chains, tab-order rank in the parent
// Group, workspace placement, and the a11y-tree binding. `KIND_LAYER`,
// `KIND_LAYER_TREE`, `KIND_XDG_TOPLEVEL_STATE`, and `KIND_XDG_POPUP`
// all derive from KIND_WINDOW in turn (vocabulary §3 derivation graph),
// which is what the R_WIN_MINT_LAYER / R_WIN_MINT_LAYER_TREE /
// R_WIN_MINT_XDG_TOPLEVEL_STATE / R_WIN_MINT_XDG_POPUP rights below
// gate.
//
// =============================================================================
// SECTION 2  ROW LAYOUT -- 32 BYTES (FOUR u64 WORDS)
// =============================================================================
//
//   [+0]  header:  in_use[63:56] | window_id[47:0] | reserved[55:48]
//   [+8]  body1:   parent_surface_kind_id[31:0] | parent_window_kind_id[63:32]
//   [+16] body2:   z_order_slot[31:0]           | tab_order_slot[63:32]
//   [+24] body3:   workspace_kind_id[31:0]      | a11y_tree_kind_id[63:32]
//
// window_id is client-supplied and MUST be unique among live rows
// (mint refuses a duplicate with WIN_MINT_ID_IN_USE). 48 bits chosen
// so a synthetic id built from (client_pid_lo:32 | seq:16) packs
// losslessly, matching the sizing rationale reference_display_kind.pdx
// records.
//
// parent_surface_kind_id: the KIND_SURFACE cap this window derives
// from. MUST be nonzero (a KIND_SURFACE cap holding target_ptr==0
// would name the ambient global surface, which does not exist in
// this compositor's model).
//
// parent_window_kind_id: 0 iff toplevel; else the parent window
// (modality edge, per vocabulary §2.4). Self-parent forbidden:
// WIN_MINT_SELF_PARENT refuses parent_window_kind_id == window_id.
//
// z_order_slot: signed i32 stored as its u32 bit-pattern. Positive
// slots stack above the reference plane (higher = frontmost);
// negative slots stack below (used for docked shells / backgrounds
// per KIND_LAYER role catalogue). Compositor-authoritative -- the
// client PROPOSES a slot at mint and via WIN_OP_SET_Z_ORDER, but
// the compositor's window-manager policy may collapse or reorder.
//
// tab_order_slot: u32 rank of this window within its Group's tab
// traversal cycle. 0 == "not tab-reachable" (used for cursor
// windows, tooltips, etc. that participate in focus chain but not
// keyboard navigation).
//
// workspace_kind_id: u32 slot of the KIND_WORKSPACE the window is
// placed in (vocabulary §2.13). MAY be zero at mint (window is
// unplaced), but the compositor's default workspace-assignment
// hook (#2290) will overwrite zero on first present.
//
// a11y_tree_kind_id: u32 slot of the KIND_A11Y_TREE bound to this
// window (vocabulary §2.21). MANDATORY at mint (nonzero). This is
// the P4 mitigation: the ONE structural gate that makes a11y a
// first-class protocol participant rather than a sidecar.
//
// All slots stored little-endian, matching every other row-tail
// layout in this repo (reference_display_kind.pdx §2, hdr_metadata_
// kind.pdx §3, kind_color_profile.pdx). No float leaks into a
// window-metadata cap per the FPU-discipline (see
// `design/kernel/no-fpu.md`).
//
// =============================================================================
// SECTION 3  FAILURE TAXONOMY 0xFFFFEAA0..0xFFFFEAAF
// =============================================================================
//
// Repo-wide grep at landing time showed the 0xFFFFEAA0..0xFFFFEAAF
// page as unclaimed across src/ and design/. Leaves 0xFFFFEA60..
// 0xFFFFEA9F for B6-01..04 (four sibling batches * one page each,
// same coordinated allocation posture reference_display_kind.pdx
// picked at 0xFFFFEA50..0xFFFFEA5F). The WIN_MINT_NO_A11Y sentinel
// (0xFFFFEAA9) is THE P4-enforcement sentinel this file exposes; a
// downstream diagnostic that greps for `MINT.*NO_A11Y` finds it as
// its one canonical name.
//
// =============================================================================
// SECTION 4  window_mint FACTORY -- P4 ENFORCEMENT GATE
// =============================================================================
//
// Gate order (fail-fast; refusal funnel bumps _wk_stats[WIN_ST_REFUSED]
// once):
//   (1) window_id in (0, 2^48)             -> WIN_MINT_BAD_ID
//   (2) parent_surface_kind_id != 0        -> WIN_MINT_BAD_SURFACE
//   (3) *** a11y_tree_kind_id != 0 ***     -> WIN_MINT_NO_A11Y
//                                             (P4 STRUCTURAL GATE)
//   (4) parent_window_kind_id != window_id -> WIN_MINT_SELF_PARENT
//   (5) window_id uniqueness (scan live)   -> WIN_MINT_ID_IN_USE
//   (6) pack body1/body2/body3 + tail_alloc
//
// Gate (3) is the whole reason this file exists as a first landing
// rather than a G10 back-port. It refuses at compile-time-of-cap
// (mint-time), not at first-a11y-query, so the impossible-to-elaborate-
// without-a11y property holds for every downstream KIND_XDG_TOPLEVEL_
// STATE / KIND_XDG_POPUP / KIND_LAYER derivation that reads back a
// window row -- they can assume a11y_tree_kind_id is always live.

module WindowKind = structure {

  pub let KIND_WINDOW      : u64 = 0x1C1
  pub let WIN_PARENT_KIND  : u64 = 0x1B8            // KIND_SURFACE (B6-01)

  // Row pool. WIN_MAX = 32 covers a heavily-tiled workspace (dozens
  // of terminal panes + browser tabs treated as windows) without
  // over-committing .bss; a future landing that wants a higher
  // ceiling bumps this constant and re-derives _wk_table size.
  pub let WIN_MAX       : u64 = 32
  pub let WIN_ROW_BYTES : u64 = 32

  // Rights. R_WIN_QUERY_STATE mirrors the R_*_READ (0x001) posture
  // every other KIND_* file in this repo takes. R_WIN_REVOKE mirrors
  // R_*_REVOKE (0x010). All four mint-child rights land in the
  // 0x2000..0x10000 band -- above every standard right (READ,
  // INVOKE, REVOKE, MINT, OBSERVE) so a rights-mask AND against
  // R_ALL_STANDARD leaves the compositor-specific bits untouched.
  // R_WIN_SET_STATE is the compositor-facing write bit (used for
  // z-order / tab-order / workspace / focus updates from the
  // window-manager policy). R_WIN_FOCUS is a distinct right so a
  // client that reads window state cannot forge a focus request;
  // only the input server (holding R_WIN_FOCUS) can drive focus
  // decisions per pitfall P2 (compositor-independent input).
  pub let R_WIN_QUERY_STATE           : u64 = 0x001
  pub let R_WIN_REVOKE                : u64 = 0x010
  pub let R_WIN_MINT                  : u64 = 0x200
  pub let R_WIN_OBSERVE               : u64 = 0x400
  pub let R_WIN_SET_STATE             : u64 = 0x1000
  pub let R_WIN_MINT_LAYER            : u64 = 0x2000
  pub let R_WIN_MINT_LAYER_TREE       : u64 = 0x4000
  pub let R_WIN_MINT_XDG_TOPLEVEL_STATE : u64 = 0x8000
  pub let R_WIN_MINT_XDG_POPUP        : u64 = 0x10000
  pub let R_WIN_FOCUS                 : u64 = 0x20000
  pub let R_WIN_ALL                   : u64 = 0x3F611
     // 0x001|0x010|0x200|0x400|0x1000|0x2000|0x4000|0x8000|0x10000|0x20000
     //  = 0x3F611

  // Ops. Arity ONE (op_arg[63:8] REFUSED, mirroring the RD_OP_*
  // conventions reference_display_kind.pdx §Section 4 records).
  // Query ops read one field each; SET_STATE fold their target
  // field into the op ordinal so an authority mismatch is a
  // fine-grained refusal, not a wide "set anything" surface.
  pub let WIN_OP_QUERY_PARENT_SURFACE : u64 = 0
  pub let WIN_OP_QUERY_PARENT_WINDOW  : u64 = 1
  pub let WIN_OP_QUERY_Z_ORDER        : u64 = 2
  pub let WIN_OP_QUERY_TAB_ORDER      : u64 = 3
  pub let WIN_OP_QUERY_WORKSPACE      : u64 = 4
  pub let WIN_OP_QUERY_A11Y_TREE      : u64 = 5
  pub let WIN_OP_QUERY_WINDOW_ID      : u64 = 6
  pub let WIN_OP_SET_Z_ORDER          : u64 = 7
  pub let WIN_OP_SET_TAB_ORDER        : u64 = 8
  pub let WIN_OP_SET_WORKSPACE        : u64 = 9
  pub let WIN_OP_DEBUG_PRINT          : u64 = 10
  pub let WIN_OP_MAX                  : u64 = 10

  // Failure taxonomy 0xFFFFEAA0..0xFFFFEAAF. Fresh page, grep-
  // verified free across src/ + design/ at landing.
  pub let WIN_OK                 : u64 = 0
  pub let WIN_TAIL_ENOSPC        : u64 = 0xFFFFEAAF
  pub let WIN_TAIL_BAD_ARG       : u64 = 0xFFFFEAAE
  pub let WIN_MINT_BAD_PARENT    : u64 = 0xFFFFEAAD
  pub let WIN_MINT_BAD_RIGHTS    : u64 = 0xFFFFEAAC
  pub let WIN_MINT_BAD_ID        : u64 = 0xFFFFEAAB
  pub let WIN_MINT_ID_IN_USE     : u64 = 0xFFFFEAAA
  pub let WIN_MINT_NO_A11Y       : u64 = 0xFFFFEAA9  // P4 STRUCTURAL GATE
  pub let WIN_MINT_BAD_WORKSPACE : u64 = 0xFFFFEAA8
  pub let WIN_MINT_BAD_SURFACE   : u64 = 0xFFFFEAA7
  pub let WIN_MINT_SELF_PARENT   : u64 = 0xFFFFEAA6
  pub let WIN_BAD_SLOT           : u64 = 0xFFFFEAA5
  pub let WIN_WRONG_KIND         : u64 = 0xFFFFEAA4
  pub let WIN_REVOKE_ALREADY     : u64 = 0xFFFFEAA3
  pub let WIN_UNSUP_OP           : u64 = 0xFFFFEAA2
  pub let WIN_DECODE_BAD         : u64 = 0xFFFFEAA1
  pub let WIN_ROW_NONE           : u64 = 0xFFFFEAA0

  pub let WIN_ID_MASK : u64 = 0xFFFFFFFFFFFF        // 48-bit window_id
  pub let WIN_U32_MAX : u64 = 0xFFFFFFFF

  // THE ONE STATE CELL. 32 rows * 32 bytes = 1024 bytes = 128 u64.
  pub let mut _wk_table : [u64; 128] = uninit @align(64)
  pub let mut _wk_stats : [u64; 4]   = uninit @align(64)

  pub let WIN_ST_MINTS   : u64 = 0
  pub let WIN_ST_REVOKES : u64 = 1
  pub let WIN_ST_REFUSED : u64 = 2
  pub let WIN_ST_QUERIES : u64 = 3

  // Fingerprint tag. Emitted by the compositor on successful mint
  // of a KIND_WINDOW cap. Legacy suffix gives grep parity with pre-
  // Wave0 boot-log tooling (see e.g. `kind_tui_canvas.pdx`
  // tui_mint_ok_msg, `reference_display_kind.pdx` rdk_mint_ok_msg).
  pub let pdx_kind_window_meta : [u8; 40] = "window mint ok [legacy: WINDOW MINT OK]\0"

  // ==========================================================================
  // Section 5  Counter primitives.
  // ==========================================================================

  pub let window_stats_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B6-05 (#2254): clear row table + counters at boot. 32 rows * 4 u64 = 128 u64 total. Labels prefixed window_rs_.",
      block: {
        lea r10, [rip + _wk_table];
        xor rax, rax;
        xor rcx, rcx;
      window_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 128;
        jb  window_rs_rows;

        lea r10, [rip + _wk_stats];
        xor rcx, rcx;
      window_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  window_rs_stats;
        ret
      }
    }

  pub let window_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B6-05 (#2254): counter bump. Encoder-conservative load-inc-store; no add reg,[mem]. Labels prefixed window_nt_.",
      block: {
        cmp rdi, 4;
        jae window_nt_out;
        lea r10, [rip + _wk_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      window_nt_out:
        ret
      }
    }

  pub let window_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B6-05 (#2254): counter read. Labels prefixed window_st_.",
      block: {
        cmp rdi, 4;
        jae window_st_zero;
        lea r10, [rip + _wk_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      window_st_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Section 6  Validators.
  // ==========================================================================

  pub let window_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B6-05 (#2254): subset test against R_WIN_ALL = 0x3F611. Labels prefixed window_rv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x3F611;
        and rax, r10;
        cmp rax, rdi;
        jne window_rv_no;
        mov rax, 1;
        ret;
      window_rv_no:
        xor rax, rax;
        ret
      }
    }

  // window_id must fit in 48 bits and be non-zero (a zero id would
  // shadow the row-empty sentinel in the header word).
  pub let window_id_valid : (u64) -> u64 !{} @{} =
    fn (window_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B6-05 (#2254): 1 iff window_id in (0, 2^48). Upper 16 bits MUST be zero so the header's in_use marker + reserved slot stay clear. Labels prefixed window_iv_.",
      block: {
        cmp rdi, 0;
        je  window_iv_no;
        mov rax, rdi;
        shr rax, 48;
        cmp rax, 0;
        jne window_iv_no;
        mov rax, 1;
        ret;
      window_iv_no:
        xor rax, rax;
        ret
      }
    }

  // window_u32_valid: 1 iff v fits in 32 bits (used for every u32-
  // shaped field the row layout stores).
  pub let window_u32_valid : (u64) -> u64 !{} @{} =
    fn (v: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B6-05 (#2254): 1 iff v <= WIN_U32_MAX. Labels prefixed window_uv_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  window_uv_no;
        mov rax, 1;
        ret;
      window_uv_no:
        xor rax, rax;
        ret
      }
    }

  // window_a11y_valid: 1 iff a11y_tree_kind_id is nonzero AND fits in
  // u32. THE P4-mitigation gate: no window row can be populated
  // without a live a11y-tree binding. reference_display_kind.pdx
  // took the same "reject the sentinel-zero" posture for its UNSET
  // ordinals; here the same posture enforces the compositor
  // vocabulary's mandatory-binding contract.
  pub let window_a11y_valid : (u64) -> u64 !{} @{} =
    fn (a11y: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B6-05 (#2254): P4 gate. 1 iff a11y_tree_kind_id in (0, 2^32). Zero is the WIN_MINT_NO_A11Y sentinel that refuses inaccessible windows STRUCTURALLY -- no path in this file populates a row without passing this check first. Labels prefixed window_av_.",
      block: {
        cmp rdi, 0;
        je  window_av_no;
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  window_av_no;
        mov rax, 1;
        ret;
      window_av_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Section 7  Packers.
  // ==========================================================================

  // body1: parent_surface_kind_id[31:0] | parent_window_kind_id[63:32]
  pub let window_body1_pack : (u64, u64) -> u64 !{} @{} =
    fn (parent_surface: u64) (parent_window: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B6-05 (#2254): body1 pack. Both halves capped at u32 max. Labels prefixed window_b1_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  window_b1_bad;
        cmp rsi, r10;
        ja  window_b1_bad;
        mov rax, rdi;
        and rax, 0xFFFFFFFF;
        mov r10, rsi;
        and r10, 0xFFFFFFFF;
        shl r10, 32;
        or  rax, r10;
        ret;
      window_b1_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // body2: z_order_slot[31:0] | tab_order_slot[63:32]
  // z_order_slot stored as u32 bit-pattern of the caller's i32;
  // sign-extension happens on the read side.
  pub let window_body2_pack : (u64, u64) -> u64 !{} @{} =
    fn (z_order: u64) (tab_order: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B6-05 (#2254): body2 pack. z_order MAY be any u32 bit-pattern (i32 semantics preserved via and-with-u32-mask); tab_order capped at u32 max. Labels prefixed window_b2_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rsi, r10;
        ja  window_b2_bad;
        mov rax, rdi;
        and rax, 0xFFFFFFFF;
        mov r10, rsi;
        and r10, 0xFFFFFFFF;
        shl r10, 32;
        or  rax, r10;
        ret;
      window_b2_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // body3: workspace_kind_id[31:0] | a11y_tree_kind_id[63:32]
  pub let window_body3_pack : (u64, u64) -> u64 !{} @{} =
    fn (workspace: u64) (a11y: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B6-05 (#2254): body3 pack. Both halves capped at u32 max. Labels prefixed window_b3_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  window_b3_bad;
        cmp rsi, r10;
        ja  window_b3_bad;
        mov rax, rdi;
        and rax, 0xFFFFFFFF;
        mov r10, rsi;
        and r10, 0xFFFFFFFF;
        shl r10, 32;
        or  rax, r10;
        ret;
      window_b3_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // header: (window_id in low 48) with in_use added at claim time.
  pub let window_hdr_pack : (u64) -> u64 !{} @{} =
    fn (window_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B6-05 (#2254): pack header sans in_use bit. window_id occupies bits [47:0]. Labels prefixed window_hp_.",
      block: {
        mov rax, rdi;
        shr rax, 48;
        cmp rax, 0;
        jne window_hp_bad;
        mov rax, rdi;
        ret;
      window_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // Section 8  Row pool: valid / alloc / free.
  // ==========================================================================

  pub let window_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B6-05 (#2254): 1 iff row_id < WIN_MAX and in_use. Labels prefixed window_tv_.",
      block: {
        cmp rdi, 32;
        jae window_tv_no;
        lea r10, [rip + _wk_table];
        mov r11, rdi;
        imul r11, r11, 32;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  window_tv_no;
        mov rax, 1;
        ret;
      window_tv_no:
        xor rax, rax;
        ret
      }
    }

  // window_tail_alloc(hdr, body1, body2, body3) -> row_id | err.
  // Low-first scan over 32 rows. Header stamped with in_use bit
  // (bit 56) here so callers pass an "unset in_use" packed header.
  pub let window_tail_alloc : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (body1: u64) (body2: u64) (body3: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B6-05 (#2254): claim one KIND_WINDOW row. Low-first scan (rbx=idx) over 32 rows of 32 bytes (idx*32 via imul). On claim: OR the 1<<56 in_use marker into hdr and store the four u64 body words. Five callee-save pushes (rbx=idx, r12=hdr, r13=body1, r14=body2, r15=body3) leave rsp%16==0 for the no-nested-call scan. Labels prefixed window_ta_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov r15, rcx;

        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne window_ta_bad;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp r13, r10;
        je  window_ta_bad;
        cmp r14, r10;
        je  window_ta_bad;
        cmp r15, r10;
        je  window_ta_bad;

        xor rbx, rbx;
      window_ta_scan:
        cmp rbx, 32;
        jae window_ta_enospc;
        lea r10, [rip + _wk_table];
        mov r11, rbx;
        imul r11, r11, 32;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  window_ta_claim;
        add rbx, 1;
        jmp window_ta_scan;

      window_ta_claim:
        mov rax, r12;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r13;
        mov [r10 + 16], r14;
        mov [r10 + 24], r15;
        mov rax, rbx;
        jmp window_ta_out;

      window_ta_enospc:
        mov rax, 0xFFFFEAAF;
        jmp window_ta_out;
      window_ta_bad:
        mov rax, 0xFFFFEAAE;

      window_ta_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let window_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B6-05 (#2254): scrub one row (all four words). Labels prefixed window_tf_.",
      block: {
        cmp rdi, 32;
        jae window_tf_out;
        lea r10, [rip + _wk_table];
        mov r11, rdi;
        imul r11, r11, 32;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
      window_tf_out:
        ret
      }
    }

  // ==========================================================================
  // Section 9  Row-field query helpers.
  // ==========================================================================

  pub let window_row_window_id : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B6-05 (#2254): window_id at header[47:0]. Labels prefixed window_rid_.",
      block: {
        push r12;
        mov r12, rdi;
        call window_tail_valid;
        cmp rax, 0;
        je  window_rid_bad;
        lea r10, [rip + _wk_table];
        mov r11, r12;
        imul r11, r11, 32;
        add r10, r11;
        mov rax, [r10 + 0];
        mov r10, 0xFFFFFFFFFFFF;
        and rax, r10;
        jmp window_rid_out;
      window_rid_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      window_rid_out:
        pop r12;
        ret
      }
    }

