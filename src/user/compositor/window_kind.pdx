  // window_find_by_id(window_id) -> row_id | WIN_ROW_NONE.
  pub let window_find_by_id : (u64) -> u64 !{mem} @{} =
    fn (window_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B6-05 (#2254): linear scan for window_id in header[47:0] of every live row. Labels prefixed window_fbi_.",
      block: {
        push rbx;
        push r12;
        mov r12, rdi;
        xor rbx, rbx;
      window_fbi_scan:
        cmp rbx, 32;
        jae window_fbi_none;
        lea r10, [rip + _wk_table];
        mov r11, rbx;
        imul r11, r11, 32;
        add r10, r11;
        mov rax, [r10 + 0];
        mov r11, rax;
        shr r11, 56;
        cmp r11, 0;
        je  window_fbi_step;
        mov r11, 0xFFFFFFFFFFFF;
        and rax, r11;
        cmp rax, r12;
        jne window_fbi_step;
        mov rax, rbx;
        jmp window_fbi_out;
      window_fbi_step:
        add rbx, 1;
        jmp window_fbi_scan;
      window_fbi_none:
        mov rax, 0xFFFFEAA0;                // WIN_ROW_NONE
      window_fbi_out:
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Section 10  Mint / revoke  --  window_mint IS the P4 GATE
  // ==========================================================================
  //
  // window_mint(window_id, parent_surface, parent_window, z_order,
  //             tab_workspace_pack, a11y_tree_kind_id) -> row_id | WIN_MINT_* sentinel.
  //
  // Six args (all in SysV registers -- max-arity paideia-as supports
  // without stack args). Two u32 slots (tab_order + workspace) are
  // packed into the single `tab_workspace_pack` word: layout
  //     tab_order[31:0] | workspace[63:32]
  // matching the row's body2/body3 encoding so a caller that reads a
  // row back can reuse the same shift/mask decode. Gate order:
  //   (1) window_id           (window_id_valid)
  //   (2) parent_surface      (nonzero, fits in u32)
  //   (3) a11y_tree           (window_a11y_valid -- THE P4 GATE)
  //   (4) parent_window       (fits in u32; self-parent forbidden)
  //   (5) tab_order/workspace (both fit in u32)
  //   (6) window_id uniqueness against live rows
  //       (window_find_by_id must return WIN_ROW_NONE)
  //   (7) body pack + tail_alloc
  pub let window_mint : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (window_id: u64) (parent_surface: u64) (parent_window: u64) (z_order: u64) (tab_workspace_pack: u64) (a11y_tree_kind_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B6-05 (#2254): mint one KIND_WINDOW row. Six-push callee-save prologue + sub rsp,8 = 56 bytes: entry rsp%16==8, +48+8=56, %16==0 for every nested call. Args stashed into callee-save before any nested call: rbx=window_id, r12=parent_surface, r13=a11y_tree_kind_id (kept alive across every gate for the P4 assertion at gate 3), r14=parent_window, r15=z_order, rbp=tab_workspace_pack. THE P4 GATE at (3) is the FIRST validation after window_id + parent_surface -- refusal path funnels through window_mb_no_a11y -> WIN_MINT_NO_A11Y (0xFFFFEAA9). Every validator + packer helper is a leaf using only r10/r11 scratch, so no push/pop scaffolding needed around them. Refusal funnel bumps _wk_stats[WIN_ST_REFUSED] once at window_mb_refused. Labels prefixed window_mb_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;
        sub rsp, 8;

        mov rbx, rdi;                     // window_id
        mov r12, rsi;                     // parent_surface
        mov r14, rdx;                     // parent_window
        mov r15, rcx;                     // z_order
        mov rbp, r8;                      // tab_workspace_pack
        mov r13, r9;                      // a11y_tree_kind_id

        // (1) window_id valid.
        mov rdi, rbx;
        call window_id_valid;
        cmp rax, 0;
        je  window_mb_bad_id;

        // (2) parent_surface: nonzero AND fits in u32.
        cmp r12, 0;
        je  window_mb_bad_surface;
        mov rdi, r12;
        call window_u32_valid;
        cmp rax, 0;
        je  window_mb_bad_surface;

        // (3) *** P4 STRUCTURAL GATE ***
        //     a11y_tree_kind_id MUST be nonzero (and fit in u32).
        //     Every downstream KIND_XDG_TOPLEVEL_STATE / KIND_XDG_
        //     POPUP / KIND_LAYER derivation reads back a11y_tree
        //     from body3[63:32] and MAY assume liveness. This gate
        //     is what makes that assumption sound.
        mov rdi, r13;
        call window_a11y_valid;
        cmp rax, 0;
        je  window_mb_no_a11y;

        // (4) parent_window: fits in u32 (0 legal == toplevel);
        //     self-parent forbidden.
        mov rdi, r14;
        call window_u32_valid;
        cmp rax, 0;
        je  window_mb_bad_parent;
        cmp r14, 0;
        je  window_mb_parent_ok;
        cmp r14, rbx;
        je  window_mb_self_parent;
      window_mb_parent_ok:

        // (5) tab_order + workspace both fit in u32. Both live
        //     inside rbp already packed; unpack + validate.
        mov rdi, rbp;
        and rdi, 0xFFFFFFFF;              // tab_order
        call window_u32_valid;
        cmp rax, 0;
        je  window_mb_bad_workspace;      // reuse: BAD_WORKSPACE
                                          // covers "bad pack half"
        mov rdi, rbp;
        shr rdi, 32;                      // workspace (already u32)
        call window_u32_valid;
        cmp rax, 0;
        je  window_mb_bad_workspace;

        // (6) window_id uniqueness.
        mov rdi, rbx;
        call window_find_by_id;
        mov r10, 0xFFFFEAA0;              // WIN_ROW_NONE
        cmp rax, r10;
        jne window_mb_id_in_use;

        // (7) Pack body1 = (parent_surface, parent_window).
        mov rdi, r12;
        mov rsi, r14;
        call window_body1_pack;
        mov r12, rax;                     // body1 (parent_surface no longer needed)

        // Pack body2 = (z_order, tab_order).  tab_order = rbp[31:0].
        mov rdi, r15;                     // z_order (u32 bit-pattern)
        mov rsi, rbp;
        and rsi, 0xFFFFFFFF;
        call window_body2_pack;
        mov r14, rax;                     // body2

        // Pack body3 = (workspace, a11y_tree). workspace = rbp[63:32].
        mov rdi, rbp;
        shr rdi, 32;
        mov rsi, r13;
        call window_body3_pack;
        mov r15, rax;                     // body3

        // Pack hdr = window_id (low 48; in_use added by tail_alloc).
        mov rdi, rbx;
        call window_hdr_pack;
        // rax = hdr.

        // tail_alloc(hdr, body1, body2, body3).
        mov rdi, rax;                     // hdr
        mov rsi, r12;                     // body1
        mov rdx, r14;                     // body2
        mov rcx, r15;                     // body3
        call window_tail_alloc;

        mov r10, 32;
        cmp rax, r10;
        jae window_mb_enospc;             // rax already the sentinel

        // Success: bump mints, preserve row_id across the note call.
        mov rbx, rax;
        mov rdi, 0;                       // WIN_ST_MINTS
        call window_note;
        mov rax, rbx;
        jmp window_mb_out;

      window_mb_bad_id:
        mov rax, 0xFFFFEAAB;              // WIN_MINT_BAD_ID
        jmp window_mb_refused;
      window_mb_bad_surface:
        mov rax, 0xFFFFEAA7;              // WIN_MINT_BAD_SURFACE
        jmp window_mb_refused;
      window_mb_no_a11y:
        mov rax, 0xFFFFEAA9;              // WIN_MINT_NO_A11Y (P4)
        jmp window_mb_refused;
      window_mb_bad_parent:
        mov rax, 0xFFFFEAAD;              // WIN_MINT_BAD_PARENT
        jmp window_mb_refused;
      window_mb_self_parent:
        mov rax, 0xFFFFEAA6;              // WIN_MINT_SELF_PARENT
        jmp window_mb_refused;
      window_mb_bad_workspace:
        mov rax, 0xFFFFEAA8;              // WIN_MINT_BAD_WORKSPACE
        jmp window_mb_refused;
      window_mb_id_in_use:
        mov rax, 0xFFFFEAAA;              // WIN_MINT_ID_IN_USE
        jmp window_mb_refused;
      window_mb_enospc:
        // rax already WIN_TAIL_ENOSPC (0xFFFFEAAF) from window_tail_alloc.

      window_mb_refused:
        mov rbx, rax;                     // stash sentinel
        mov rdi, 2;                       // WIN_ST_REFUSED
        call window_note;
        mov rax, rbx;

      window_mb_out:
        add rsp, 8;
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // window_revoke(row_id) -> 0 | WIN_BAD_SLOT | WIN_REVOKE_ALREADY.
  pub let window_revoke : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B6-05 (#2254): revoke one row. row_id >= WIN_MAX -> WIN_BAD_SLOT; not in_use -> WIN_REVOKE_ALREADY; else free + bump revokes + return 0. Labels prefixed window_rev_.",
      block: {
        push r12;
        mov r12, rdi;

        mov r10, 32;
        cmp r12, r10;
        jae window_rev_bad_slot;

        mov rdi, r12;
        call window_tail_valid;
        cmp rax, 0;
        je  window_rev_already;

        mov rdi, r12;
        call window_tail_free;
        mov rdi, 1;                       // WIN_ST_REVOKES
        call window_note;
        xor rax, rax;
        jmp window_rev_out;

      window_rev_bad_slot:
        mov rax, 0xFFFFEAA5;              // WIN_BAD_SLOT
        jmp window_rev_out;
      window_rev_already:
        mov rax, 0xFFFFEAA3;              // WIN_REVOKE_ALREADY

      window_rev_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Section 11  Boot init.
  // ==========================================================================

  pub let window_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B6-05 (#2254): call through to window_stats_reset for one clean pool + counter zero-out. Labels prefixed window_i_.",
      block: {
        call window_stats_reset;
        ret
      }
    }
}
