  pub let window_row_a11y_tree : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B6-05 (#2254): a11y_tree_kind_id at body3[63:32]. Guaranteed nonzero for any live row (P4 gate at window_mint refuses zero before tail_alloc). Labels prefixed window_ra_.",
      block: {
        push r12;
        mov r12, rdi;
        call window_tail_valid;
        cmp rax, 0;
        je  window_ra_bad;
        lea r10, [rip + _wk_table];
        mov r11, r12;
        imul r11, r11, 32;
        add r10, r11;
        mov rax, [r10 + 24];
        shr rax, 32;
        and rax, 0xFFFFFFFF;
        jmp window_ra_out;
      window_ra_bad:
