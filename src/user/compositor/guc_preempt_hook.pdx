// src/user/compositor/guc_preempt_hook.pdx -- Wave sigma sigma-05 (R37 GuC
// firmware -> compositor low-latency preempt)
//
// =============================================================================
// STATUS: HONEST SCAFFOLD
// =============================================================================
// R37 landed GuC firmware bring-up (kernel/core/drivers/gpu/guc_*.pdx). The
// GuC provides a submission-side preempt primitive that a compositor uses
// to break the currently-executing GPU context so a higher-priority draw
// (a cursor move, a modal focus change) can jump the queue. The userspace
// hook has no syscall shim yet; this module carries the wire shape and a
// monotone request counter plus a "last context preempted" observability
// slot, so a future consumer can trace the compositor's preempt cadence.
//
// The nested call goes through a local returns-0 stub
// (guc_preempt_hook_guc_preempt_context_stub). The compositor's
// per_client_gl_context slot layout (sigma-04) stores gpu_ctx_row_id at
// offset +8; a real consumer would read that field then pass the row_id
// to guc_preempt_context. For scaffold cleanliness we accept a
// ctx_slot_idx (from sigma-04's attach) and stash it verbatim in
// _guc_preempt_last_context. The "real" translation from ctx_slot_idx to
// gpu_ctx_row_id is deferred; if the caller wants that mapping observable
// the caller can pass gpu_ctx_row_id directly (per_client_ctx exposes it
// via a to-be-added accessor when the real syscall lands).
//
// LINKAGE. Unlinked in this wave; see scanout_bo.pdx header for the shared
// story.
//
// =============================================================================
// FINGERPRINT
// =============================================================================
// Dormant fingerprint string "GUC PREEMPT REQ" declared as a rodata
// constant. NO "OK" token in the string, so the golden-allowlist
// #1578 gate does not need an entry — the verifier only pins strings
// containing "OK" as fingerprints. When the real emit path lands (a
// klog_s1_x1 in the future userspace GuC preempt shim), the token can
// be lifted to "GUC PREEMPT REQ OK" and gated then.
//
// =============================================================================
// MODULE BASENAME
// =============================================================================
// guc_preempt_hook.pdx -> module GucPreemptHook. Labels prefixed
// guc_preempt_hook_.

module GucPreemptHook = structure {

  pub let GPH_OK          : u64 = 0
  pub let GPH_STUB_FAIL   : u64 = 0xFFFFECB0

  // Monotone counter of preempt requests issued (wraps at u64::MAX).
  pub let mut _guc_preempt_req_counter : [u64; 1] = uninit @align(64)
  // Last ctx_slot_idx passed to guc_preempt_request.
  pub let mut _guc_preempt_last_context : [u64; 1] = uninit @align(64)

  // Dormant fingerprint string. Zero-terminated. 16 bytes (15 wire chars
  // + NUL). No "OK" token, so no #1578 gate needed at emit time.
  pub let guc_preempt_hook_fp_req : [u8; 16] = "GUC PREEMPT REQ\0"

  // ==========================================================================
  // Local R37 guc_preempt_context stub. Returns 0 unconditionally.
  // ==========================================================================

  pub let guc_preempt_hook_guc_preempt_context_stub : (u64) -> u64 !{} @{} =
    fn (gpu_ctx_row_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave sigma sigma-05: R37 guc_preempt_context stub. Returns 0 until userspace guc_preempt_context syscall lands. Leaf.",
      block: {
        xor rax, rax;
        ret
      }
    }

  pub let guc_preempt_hook_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave sigma sigma-05: zero the request counter and last-context slot at boot. Leaf. Labels prefixed guc_preempt_hook_srz_.",
      block: {
        lea r10, [rip + _guc_preempt_req_counter];
        xor rax, rax;
        mov [r10 + 0], rax;
        lea r10, [rip + _guc_preempt_last_context];
        mov [r10 + 0], rax;
        ret
      }
    }

  // guc_preempt_request(ctx_slot_idx) -> stub_result | GPH_OK.
  //   Calls the stub with ctx_slot_idx (scaffold-only; the real path
  //   would translate to gpu_ctx_row_id via per_client_ctx). Bumps the
  //   monotone counter and stashes ctx_slot_idx in
  //   _guc_preempt_last_context regardless of stub return, because the
  //   observability signal (how often the compositor preempts, and for
  //   which context) is useful even when the underlying GuC command
  //   would have refused.
  //
  //   Two-push (rbx=ctx_slot_idx, r12=stub_result) prologue + 8B pad
  //   keeps rsp%16==0 across the nested stub call
  //   (entry 8, +16 pushes + 8 pad = 0).
  pub let guc_preempt_request : (u64) -> u64 !{mem} @{} =
    fn (ctx_slot_idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave sigma sigma-05: issue one preempt request. Two-push + pad prologue for the nested stub call. Counter + last-context updated unconditionally. Labels prefixed guc_preempt_request_.",
      block: {
        push rbx;
        push r12;
        sub  rsp, 8;

        mov rbx, rdi;                          // ctx_slot_idx

        mov rdi, rbx;
        call guc_preempt_hook_guc_preempt_context_stub;
        mov r12, rax;                          // stub_result

        // Bump counter via load-inc-store.
        lea r10, [rip + _guc_preempt_req_counter];
        mov rax, [r10 + 0];
        add rax, 1;
        mov [r10 + 0], rax;

        // Stash last-context.
        lea r10, [rip + _guc_preempt_last_context];
        mov [r10 + 0], rbx;

        mov rax, r12;                          // return stub_result (stub 0)

        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }

  // guc_preempt_last_context() -> ctx_slot_idx | 0. Leaf.
  //   Returns 0 before any preempt request has been issued
  //   (indistinguishable from a genuine slot 0 preempt; callers who care
  //   pair this with guc_preempt_req_count).
  pub let guc_preempt_last_context : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave sigma sigma-05: read _guc_preempt_last_context[0]. Leaf.",
      block: {
        lea r10, [rip + _guc_preempt_last_context];
        mov rax, [r10 + 0];
        ret
      }
    }

  // guc_preempt_req_count() -> u64. Leaf. Companion observability
  // primitive so callers can disambiguate the "never requested" case
  // from a genuine slot 0 preempt in guc_preempt_last_context.
  pub let guc_preempt_req_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave sigma sigma-05: read _guc_preempt_req_counter[0]. Leaf.",
      block: {
        lea r10, [rip + _guc_preempt_req_counter];
        mov rax, [r10 + 0];
        ret
      }
    }
}
