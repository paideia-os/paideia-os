// src/user/compositor/seat_isolation.pdx -- Wave θ θ-05 (paideia-os
// α-τ compositor plan)
//
// Multi-seat isolation smoke: mints 3 KIND_SEAT rows with distinct
// seat_kind_ids, installs an independent focus target for each via
// focus_router_init (per-seat FocusRouterState cell, per design/
// compositor per-seat focus history), asserts every seat's focus
// query returns ITS OWN focus target (not another seat's).
//
// =============================================================================
// SCAFFOLD GAP -- SEAT-CAP FOCUS TARGET SURFACE
// =============================================================================
//
// The task-scope pattern reads "seat_new / seat cap ops with focus
// target". A grep of src/user/input_server/seat_kind.pdx shows:
//
//   * seat_mint(row_ptr, id, keyboard, pointer) -> u64  -- factory
//   * seat_bind_touch, seat_bind_stylus, seat_lock / unlock,
//     seat_is_locked, seat_active_workspace
//
// but NO seat_set_focus_target / seat_get_focus_target pair. Per-seat
// focus history is designed to live in FocusRouterState (src/user/
// input_server/focus_router.pdx §0.1: "one FocusRouterState instance
// per KIND_SEAT row"), so this smoke ROUTES per-seat focus through
// focus_router rather than fabricating a seat-cap focus surface that
// does not exist. seat_kind's job here is to demonstrate three DISTINCT
// seat_kind_ids exist; focus_router's job is to demonstrate the
// per-seat focus cell holds an independent target per seat.
//
// If a future landing adds seat_set_focus_target on seat_kind.pdx,
// this smoke should be re-pointed there and this scaffold note
// retired.
//
// =============================================================================
// FINGERPRINT
// =============================================================================
//
// On a fully passing witness, the caller sees `seat_isolation_witness`
// return 0 and the `pdx_seat_isolation_meta` fingerprint tag
// ("SEAT ISOLATION OK") sits in rodata. The tag is scanned by
// tools/verify-fingerprint-coverage.sh; because θ-05 does not yet
// wire an ELF that emits the tag at boot (compositor_selftest.elf
// currently calls only buffer_age_rights_valid), the tag is
// ALLOWLISTED in that gate with a reason pointing at this file. A
// future compositor-runner.elf that consumes seat_isolation_witness
// at boot flips the allowlist entry to a golden line.

module SeatIsolation = structure {

  // ==========================================================================
  // Section A  Fingerprint.
  // ==========================================================================
  //
  // "SEAT ISOLATION OK\n" -- 18 wire bytes + NUL = 19 bytes storage.
  pub let pdx_seat_isolation_meta : [u8; 19] = "SEAT ISOLATION OK\n\0"

  // ==========================================================================
  // Section B  Storage.
  //
  // Three FocusRouterState cells (32 bytes each -- see focus_router.pdx
  // §A "FR_CELL_BYTES"). Storage cost = 96 bytes = 12 u64. Cache-line
  // aligned. .bss zero is a legal "uninitialised" FocusRouterState;
  // focus_router_init refuses re-init (word3 focus_change_seq != 0) so
  // successive witness calls WITHOUT a scrub would fail on the second
  // pass -- seat_isolation_scrub() is provided for exactly that.
  //
  // Three seat rows (64 bytes each -- see seat_kind.pdx §"SEAT_ROW_
  // BYTES"). Storage = 192 bytes = 24 u64.
  // ==========================================================================

  pub let mut _seat_iso_focus_cells : [u64; 12] = uninit @align(64)
  pub let mut _seat_iso_rows        : [u64; 24] = uninit @align(64)

  // Three synthetic (nonzero, u32-fits) seat_kind_ids and window
  // ids. Values chosen so seat_kind_id[low32] and window_kind_id[low32]
  // are visibly distinct in a hexdump if the witness ever fails.
  pub let SEAT_ISO_ID_A     : u64 = 0x00000101
  pub let SEAT_ISO_ID_B     : u64 = 0x00000102
  pub let SEAT_ISO_ID_C     : u64 = 0x00000103
  pub let SEAT_ISO_WIN_A    : u64 = 0x0000A00A
  pub let SEAT_ISO_WIN_B    : u64 = 0x0000B00B
  pub let SEAT_ISO_WIN_C    : u64 = 0x0000C00C

  // Placeholder keyboard / pointer / surface ids (nonzero, fit u32).
  // seat_mint requires nonzero kb + pointer; the specific values do
  // not matter for the isolation assertion (we never dispatch input).
  pub let SEAT_ISO_KB       : u64 = 0x00000201
  pub let SEAT_ISO_PTR      : u64 = 0x00000202
  pub let SEAT_ISO_SURFACE  : u64 = 0x00000303

  // ==========================================================================
  // Section C  Scrub.
  //
  // Zero the two backing arrays. Required between successive witness
  // invocations because focus_router_init refuses re-init on a cell
  // whose focus_change_seq (word3) is nonzero.
  // ==========================================================================

  pub let seat_isolation_scrub : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave θ θ-05: zero the 12 u64 focus-cell array + 24 u64 seat-row array. Labels prefixed seat_iso_sc_.",
      block: {
        lea r10, [rip + _seat_iso_focus_cells];
        xor rax, rax;
        xor rcx, rcx;
      seat_iso_sc_f_step:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 12;
        jb  seat_iso_sc_f_step;

        lea r10, [rip + _seat_iso_rows];
        xor rcx, rcx;
      seat_iso_sc_r_step:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 24;
        jb  seat_iso_sc_r_step;
        ret
      }
    }

  // ==========================================================================
  // Section D  Witness.
  //
  //   seat_isolation_witness() -> u64
  //
  //     0                on pass
  //     seat_idx + 1     on failure (1 = seat A, 2 = seat B, 3 = seat C)
  //     0xFFFFFFFE       on scrub-or-init refusal (setup failure, not
  //                      an isolation failure)
  //
  // Steps:
  //   (1) scrub the two backing arrays.
  //   (2) mint three KIND_SEAT rows via seat_mint into consecutive
  //       64-byte slices of _seat_iso_rows. On refusal (nonzero return)
  //       propagate 0xFFFFFFFE to the caller -- the smoke could not
  //       even reach the isolation-assertion phase.
  //   (3) init three FocusRouterState cells with the (seat_kind_id,
  //       window_kind_id) pair distinct per seat, into consecutive
  //       32-byte slices of _seat_iso_focus_cells. Refusal likewise
  //       propagates as 0xFFFFFFFE.
  //   (4) for each seat, focus_router_current_focus returns a packed
  //       u64: rax[63:32] = focused_window; rax[31:0] = focused_surface.
  //       Since we passed initial_window = SEAT_ISO_WIN_X per seat and
  //       focus_router_init publishes window into word0[63:32]
  //       verbatim (per focus_router.pdx §"focus_router_i_"), the
  //       observed rax[63:32] must equal SEAT_ISO_WIN_X for the
  //       corresponding seat. Any mismatch means seat X's focus cell
  //       read a value from a different seat, and we return
  //       seat_idx + 1.
  //
  // Callee-save posture: rbx + r12 + r13 + r14 + r15 (five pushes).
  // Entry rsp%16 == 8; 5 pushes -> (8+40)%16 == 0 at nested CALL
  // sites (seat_mint, focus_router_init, focus_router_current_focus,
  // seat_isolation_scrub). r15 is pushed only for alignment; the
  // body never reads or writes it.
  // ==========================================================================

  pub let seat_isolation_witness : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave θ θ-05: multi-seat isolation smoke. Five callee-save pushes (rbx/r12/r13/r14/r15; r15 is alignment padding only) align rsp%16==0 for nested seat_mint / focus_router_* calls. On refusal in setup (seat_mint or focus_router_init) return 0xFFFFFFFE. Isolation-assert phase compares focused_window (rax[63:32] of focus_router_current_focus) against expected SEAT_ISO_WIN_X per seat; mismatch returns seat_idx+1. Labels prefixed seat_iso_w_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // ---- (1) scrub ----
        call seat_isolation_scrub;

        // ---- (2) mint three seat rows ----
        // Row A at _seat_iso_rows + 0
        lea rdi, [rip + _seat_iso_rows];
        mov rsi, 0x00000101;                // SEAT_ISO_ID_A
        mov rdx, 0x00000201;                // SEAT_ISO_KB
        mov rcx, 0x00000202;                // SEAT_ISO_PTR
        call seat_mint;
        cmp rax, 0;
        jne seat_iso_w_setup_fail;

        // Row B at _seat_iso_rows + 64
        lea rdi, [rip + _seat_iso_rows];
        add rdi, 64;
        mov rsi, 0x00000102;                // SEAT_ISO_ID_B
        mov rdx, 0x00000201;                // SEAT_ISO_KB
        mov rcx, 0x00000202;                // SEAT_ISO_PTR
        call seat_mint;
        cmp rax, 0;
        jne seat_iso_w_setup_fail;

        // Row C at _seat_iso_rows + 128
        lea rdi, [rip + _seat_iso_rows];
        add rdi, 128;
        mov rsi, 0x00000103;                // SEAT_ISO_ID_C
        mov rdx, 0x00000201;                // SEAT_ISO_KB
        mov rcx, 0x00000202;                // SEAT_ISO_PTR
        call seat_mint;
        cmp rax, 0;
        jne seat_iso_w_setup_fail;

        // ---- (3) init three focus cells ----
        // Cell A at _seat_iso_focus_cells + 0
        lea rdi, [rip + _seat_iso_focus_cells];
        mov rsi, 0x00000101;                // seat_kind_id A
        mov rdx, 0x0000A00A;                // window A
        call focus_router_init;
        cmp rax, 0;
        jne seat_iso_w_setup_fail;

        // Cell B at _seat_iso_focus_cells + 32
        lea rdi, [rip + _seat_iso_focus_cells];
        add rdi, 32;
        mov rsi, 0x00000102;                // seat_kind_id B
        mov rdx, 0x0000B00B;                // window B
        call focus_router_init;
        cmp rax, 0;
        jne seat_iso_w_setup_fail;

        // Cell C at _seat_iso_focus_cells + 64
        lea rdi, [rip + _seat_iso_focus_cells];
        add rdi, 64;
        mov rsi, 0x00000103;                // seat_kind_id C
        mov rdx, 0x0000C00C;                // window C
        call focus_router_init;
        cmp rax, 0;
        jne seat_iso_w_setup_fail;

        // ---- (4) assert per-seat isolation ----
        // Seat A
        lea rdi, [rip + _seat_iso_focus_cells];
        call focus_router_current_focus;
        // r12 = observed window (rax[63:32])
        mov r12, rax;
        shr r12, 32;
        // r13 = expected = SEAT_ISO_WIN_A
        mov r13, 0x0000A00A;
        cmp r12, r13;
        jne seat_iso_w_fail_a;

        // Seat B
        lea rdi, [rip + _seat_iso_focus_cells];
        add rdi, 32;
        call focus_router_current_focus;
        mov r12, rax;
        shr r12, 32;
        mov r13, 0x0000B00B;
        cmp r12, r13;
        jne seat_iso_w_fail_b;

        // Seat C
        lea rdi, [rip + _seat_iso_focus_cells];
        add rdi, 64;
        call focus_router_current_focus;
        mov r12, rax;
        shr r12, 32;
        mov r13, 0x0000C00C;
        cmp r12, r13;
        jne seat_iso_w_fail_c;

        // Pass.
        xor rax, rax;
        jmp seat_iso_w_out;

      seat_iso_w_fail_a:
        mov rax, 1;
        jmp seat_iso_w_out;
      seat_iso_w_fail_b:
        mov rax, 2;
        jmp seat_iso_w_out;
      seat_iso_w_fail_c:
        mov rax, 3;
        jmp seat_iso_w_out;

      seat_iso_w_setup_fail:
        mov rax, 0xFFFFFFFE;

      seat_iso_w_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
