// src/user/compositor/tiling_floating.pdx -- Wave0-B10-04 (paideia-os #2292)
//
// TilingFloating -- value-type overlay for floating / stacked / fullscreen
// window layout modes on top of tiling_bsp's tree (B8-08, LANDED). Sibling
// of tiling_bsp.pdx: same "value type, no KIND cap" posture (see file
// header §0 of tiling_bsp.pdx), no cross-process handoff, no parallel
// tiling engine. The overlay LAYERS on top of the BSP tree:
//
//     * MODE_TILED     -- the BSP tree owns geometry; the overlay is a
//                         no-op (apply returns the bsp_geom unchanged).
//     * MODE_FLOATING  -- override geometry replaces the bsp_geom; the
//                         window still occupies a BSP leaf (so the tree
//                         doesn't reflow when it toggles floating), but
//                         renders at (override_x, override_y, override_w,
//                         override_h) instead. z_bump lifts it above its
//                         tiled neighbors so it draws on top.
//     * MODE_STACKED   -- all overrides sharing stack_group_id render at
//                         the bsp_geom of the group's "active" leaf, but
//                         only the group's visible_member is drawn; the
//                         others are hidden (apply returns TF_HIDDEN when
//                         the caller's window_kind_id is not the group's
//                         current visible_member). z_bump behaves as with
//                         FLOATING.
//     * MODE_FULLSCREEN -- override geometry ignored; the window renders
//                         at the OUTPUT bounds (passed to apply as a
//                         second (xy, wh) pair). Used for full-screen
//                         video/game clients.
//
// =============================================================================
// SECTION 0  WHY THIS IS A VALUE TYPE, NOT A KIND CAP
// =============================================================================
//
// Same reasoning as tiling_bsp.pdx §0. A FloatingOverride is per-window
// compositor state, owned by the KIND_WORKSPACE that anchors the BSP
// tree; it is not something we hand out cross-process. A StackedGroup
// aggregates member window_kind_ids and is likewise a workspace-scoped
// value. Splitting either into its own KIND cap would add a rights
// lattice and a mint dispatcher for authority we never externalize.
//
// =============================================================================
// SECTION 1  KIND_* SLOT ALLOCATION
// =============================================================================
//
// N/A -- value type. The workspace-side wire-in (a future landing that
// binds an override slot to each KIND_WINDOW row) plugs directly into
// the same KIND_WORKSPACE row that owns the BSP tree; no KIND_TILING_
// FLOATING slot exists.
//
// =============================================================================
// SECTION 2  POOL + STRUCT LAYOUT
// =============================================================================
//
// -----------------------------------------------------------------------------
// 2.1  struct FloatingOverride  (32 bytes, four u64 words)
// -----------------------------------------------------------------------------
//
//   [+0]  wkid_mode:   window_kind_id[31:0] | mode[39:32] | reserved[63:40]
//   [+8]  xy:          override_x[31:0]     | override_y[63:32]
//   [+16] wh:          override_w[31:0]     | override_h[63:32]
//   [+24] zb_grp:      z_bump[31:0]         | stack_group_id[63:32]
//
// Fields:
//   window_kind_id     u32  the KIND_WINDOW cap id this override targets;
//                           0 means "slot free" (see alloc gate).
//   mode               u8   TF_MODE_TILED / FLOATING / STACKED / FULLSCREEN.
//   override_x/y       i32  surface-relative geometry for FLOATING mode.
//                           Sign-extended interpretation is the caller's
//                           concern: the u32 accessor returns bits verbatim
//                           and the caller re-signs via `movsx`-equivalent
//                           shift pairs (`shl 32; sar 32`) IF it wants
//                           signed math. Apply itself only compares
//                           u32-equality against the visible_member slot,
//                           so sign never matters inside this module.
//   override_w/h       i32  effective width/height for FLOATING mode.
//                           MUST be > 0 when mode == FLOATING (validated
//                           in floating_override_new).
//   z_bump             i32  positive = above tiled neighbors, negative
//                           = below. Consumed by a future compositor
//                           z-sort pass; this module carries the value
//                           verbatim and never interprets it.
//   stack_group_id     u32  0 means "not stacked". Non-zero groups the
//                           override with all others sharing the same id
//                           (a future STACKED-mode apply cross-references
//                           the group pool to check visibility).
//
// -----------------------------------------------------------------------------
// 2.2  struct StackedGroup  (48 bytes, six u64 words)
// -----------------------------------------------------------------------------
//
//   [+0]  id_count:    group_id[31:0]        | member_count[63:32]
//   [+8]  visible:     visible_member_index[31:0] | reserved[63:32]
//   [+16] members01:   members[0] (u32)      | members[1] (u32)
//   [+24] members23:   members[2] (u32)      | members[3] (u32)
//   [+32] members45:   members[4] (u32)      | members[5] (u32)
//   [+40] members67:   members[6] (u32)      | members[7] (u32)
//
// Fields:
//   group_id             u32  0 means "slot free"; kernel-assigned
//                             monotonic ids so a future caller can
//                             cross-reference a FloatingOverride's
//                             stack_group_id back to its group.
//   member_count         u32  0..TF_STACK_MEMBERS (=8). Bounded by add.
//   visible_member_index u32  0..member_count-1 while member_count > 0;
//                             cycled by stacked_group_cycle_next mod
//                             member_count.
//   members[8]           u32  inline array of KIND_WINDOW cap ids;
//                             append-only via stacked_group_add.
//
// -----------------------------------------------------------------------------
// 2.3  Pool sizing
// -----------------------------------------------------------------------------
//
// TF_MAX_OVERRIDES * TF_OVR_BYTES = 32 * 32 = 1024 B = 128 u64  overrides pool
// TF_MAX_GROUPS    * TF_GRP_BYTES =  8 * 48 =  384 B =  48 u64  groups pool
// TF_MAX_OVERRIDES * 8            = 256 B                        overrides bits
// TF_MAX_GROUPS    * 8            =  64 B                        groups bits
// TF_STATS_MAX     * 8            =  32 B                        stats
//
// Grand total: 1024 + 384 + 256 + 64 + 32 = 1760 B of .bss.
//
// =============================================================================
// SECTION 3  FAILURE TAXONOMY  0xFFFFEAB0..0xFFFFEABF
// =============================================================================
//
// SPEC DEVIATION. The B10-04 issue spec names the failure band
// 0xFFFFEC40..0xFFFFEC4F. A repo-wide sweep at landing time
// (grep -rhEo '0xFFFFEC4[0-9A-Fa-f]' over src/ + design/) shows that
// band is fully occupied by KIND_NVME_CONTROLLER (kind_nvme_controller.
// pdx §3, NVMEC_TAIL_ENOSPC=0xFFFFEC4F down through NVMEC_PROBE_ENOSPC
// =0xFFFFEC42) from the R51.M1 landing. The adjacent TilingBsp band
// (0xFFFFEB70..0xFFFFEB7F, B8-08) has no free 16-code page in its
// vicinity either. The next verified-free 16-code page adjacent to the
// user-space compositor kinds' claimed range (xdg_shell_geometry:
// 0xFFFFEA70..0xFFFFEA7F, B7-01) is 0xFFFFEAB0..0xFFFFEABF. The KIND_
// TUI_CANVAS landing (R89.M1-001) took the same "spec-band collides,
// pick verified-free adjacent page" step (see its file-header deviation
// (1)), so this posture is precedented.
//
// =============================================================================
// SECTION 4  ENCODER-CONSERVATIVE DISCIPLINE
// =============================================================================
//
// Same rules as tiling_bsp.pdx §4:
//   * NO `and reg, imm64`  -- u32 zero-extension via `shl 32; shr 32`.
//   * NO 2-op `imul r, imm` -- either 3-op form or `shl r, N` power-of-two.
//   * NO `test`             -- use `cmp reg, 0` for zero-tests.
//   * NO `add reg, [mem]`   -- load-inc-store idiom for counter bumps.
//   * NO `movsx` / `movzx`  -- `shl 32; shr 32` for zero-ext, `shl 32;
//                              sar 32` for sign-ext (this file uses
//                              only zero-ext; signed interpretation of
//                              i32 fields is punted to the caller).
//   * u8 mask (mode, member index halves) via `and rax, 0xFF` (imm8
//     form, ok -- matches lt_pack_hdr_row / tb_node_axis idiom).
//
// =============================================================================
// SECTION 5  FINGERPRINT
// =============================================================================
//
// ONE data-only tag ending `[legacy: TILING FLOATING META OK]` per
// softarch discipline. Emission path (workspace mint -> override
// factory -> klog_s1_x1) lands with a future batch; the coverage-gate
// allowlist entry lands with the same. String is data-only here.
//
// LABEL PREFIX: `tf_` for internal helpers and jump labels. Public API
// functions carry the full `floating_override_` / `stacked_group_`
// prefix per the batch spec. All labels sidestep paideia-as reserved
// keywords (`loop`, `if`, `return` -- see feedback_paideia_as_reserved_
// labels).

module TilingFloating = structure {

  // ==========================================================================
  // SECTION A  Sizing + enum + sentinel constants.
  // ==========================================================================

  // Pool sizing.
  pub let TF_MAX_OVERRIDES   : u64 = 32       // per-compositor override pool.
  pub let TF_MAX_GROUPS      : u64 = 8        // per-compositor group pool.
  pub let TF_STACK_MEMBERS   : u64 = 8        // per-group inline members cap.
  pub let TF_OVR_BYTES       : u64 = 32       // per-override struct size.
  pub let TF_GRP_BYTES       : u64 = 48       // per-group struct size.
  pub let TF_STATS_MAX       : u64 = 4        // number of counter slots.

  // WindowLayoutMode enum.
  pub let TF_MODE_TILED      : u64 = 0
  pub let TF_MODE_FLOATING   : u64 = 1
  pub let TF_MODE_STACKED    : u64 = 2
  pub let TF_MODE_FULLSCREEN : u64 = 3
  pub let TF_MODE_MAX        : u64 = 3

  // Sentinels.
  pub let TF_SLOT_NONE       : u64 = 0xFFFFFFFF     // u32-max, "no such slot".

  // Byte offsets within a FloatingOverride (SECTION 2.1).
  pub let TF_OVR_OFF_WKID_MODE : u64 = 0
  pub let TF_OVR_OFF_XY        : u64 = 8
  pub let TF_OVR_OFF_WH        : u64 = 16
  pub let TF_OVR_OFF_ZB_GRP    : u64 = 24

  // Byte offsets within a StackedGroup (SECTION 2.2).
  pub let TF_GRP_OFF_ID_COUNT  : u64 = 0
  pub let TF_GRP_OFF_VISIBLE   : u64 = 8
  pub let TF_GRP_OFF_MEMBERS01 : u64 = 16
  pub let TF_GRP_OFF_MEMBERS23 : u64 = 24
  pub let TF_GRP_OFF_MEMBERS45 : u64 = 32
  pub let TF_GRP_OFF_MEMBERS67 : u64 = 40

  // Stats slots.
  pub let TF_ST_ALLOCS         : u64 = 0     // successful factory calls.
  pub let TF_ST_FREES          : u64 = 1     // slot returns.
  pub let TF_ST_APPLIES        : u64 = 2     // apply-body invocations.
  pub let TF_ST_REFUSED        : u64 = 3     // any refusal path.

  // Failure taxonomy -- 0xFFFFEAB0..0xFFFFEABF (see file header §3).
  pub let TF_OK                : u64 = 0
  pub let TF_ERR_ENOSPC        : u64 = 0xFFFFEABF
  pub let TF_ERR_BAD_SLOT      : u64 = 0xFFFFEABE
  pub let TF_ERR_BAD_MODE      : u64 = 0xFFFFEABD
  pub let TF_ERR_BAD_GEOMETRY  : u64 = 0xFFFFEABC
  pub let TF_ERR_GROUP_FULL    : u64 = 0xFFFFEABB
  pub let TF_ERR_EMPTY_GROUP   : u64 = 0xFFFFEABA
  pub let TF_ERR_NOT_FOUND     : u64 = 0xFFFFEAB9
  pub let TF_ERR_BAD_INDEX     : u64 = 0xFFFFEAB8
  pub let TF_ERR_BAD_WINDOW    : u64 = 0xFFFFEAB7
  pub let TF_ERR_BAD_GROUP_ID  : u64 = 0xFFFFEAB6
  pub let TF_HIDDEN            : u64 = 0xFFFFEAB5
  pub let TF_ERR_BAD_OUT_PTR   : u64 = 0xFFFFEAB4
  pub let TF_ERR_INTERNAL      : u64 = 0xFFFFEAB0

  // ==========================================================================
  // SECTION B  State cells (override + group pools + alloc bits + stats).
  // ==========================================================================

  // Override pool. 32 overrides * 32 bytes = 1024 B = 128 u64.
  pub let mut _tiling_floating_overrides : [u64; 128] = uninit @align(64)

  // Group pool. 8 groups * 48 bytes = 384 B = 48 u64.
  pub let mut _tiling_floating_groups    : [u64; 48]  = uninit @align(64)

  // Per-slot in-use flags. One u64 per slot: 0 = free, 1 = allocated.
  // Matches the tb_alloc_bits pattern in tiling_bsp.pdx: plain load+store
  // with no bit-manipulation, no `and reg, imm64` shape.
  pub let mut _tiling_floating_ovr_bits  : [u64; 32]  = uninit @align(64)
  pub let mut _tiling_floating_grp_bits  : [u64; 8]   = uninit @align(64)

  // Stats counters (allocs, frees, applies, refused). Bounds-checked
  // against TF_STATS_MAX (4).
  pub let mut _tiling_floating_stats     : [u64; 4]   = uninit @align(64)

  // ==========================================================================
  // SECTION C  Fingerprint tag (data-only).
  //
  // pdx_kind_tiling_floating_meta -- ONE tag ending [legacy: ... OK]
  // per softarch discipline. See file header §5. Consumer emission
  // (workspace mint -> floating_override_new -> klog_s1_x1) lands with
  // a future batch; the coverage-gate allowlist entry lands at the same
  // time.
  //
  // String length: 63 chars + \0 terminator = 64 bytes.
  // ==========================================================================

  pub let pdx_kind_tiling_floating_meta : [u8; 64] = "pdx kind tiling floating meta [legacy: TILING FLOATING META OK]\0"

  // ==========================================================================
  // SECTION D  Address arithmetic.
  //
  //   tf_ovr_addr(slot)  -> ptr to override at slot | 0 OOB.
  //   tf_grp_addr(slot)  -> ptr to group at slot    | 0 OOB.
  //
  // ==========================================================================

  // tf_ovr_addr(slot) -> ptr | 0.
  pub let tf_ovr_addr : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-04 (paideia-os #2292): override base = _tiling_floating_overrides + slot * TF_OVR_BYTES(32). Bounds-checked against TF_MAX_OVERRIDES(32); OOB returns 0. slot * 32 encoded as shl 5 (power-of-two multiply via shift, per §4 discipline). Labels prefixed tf_oa_.",
      block: {
        mov r10, 32;
        cmp rdi, r10;
        jae tf_oa_no;
        lea r10, [rip + _tiling_floating_overrides];
        mov r11, rdi;
        shl r11, 5;                     // * 32
        add r10, r11;
        mov rax, r10;
        ret;
      tf_oa_no:
        xor rax, rax;
        ret
      }
    }

  // tf_grp_addr(slot) -> ptr | 0.
  pub let tf_grp_addr : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-04 (paideia-os #2292): group base = _tiling_floating_groups + slot * TF_GRP_BYTES(48). Bounds-checked against TF_MAX_GROUPS(8); OOB returns 0. slot * 48 encoded as imul (3-op form, imm32 = 48) per §4 (48 is not a power of two). Labels prefixed tf_ga_.",
      block: {
        mov r10, 8;
        cmp rdi, r10;
        jae tf_ga_no;
        lea r10, [rip + _tiling_floating_groups];
        mov r11, rdi;
        imul r11, r11, 48;
        add r10, r11;
        mov rax, r10;
        ret;
      tf_ga_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // SECTION E  Pool allocators.
  //
  //   tf_ovr_pool_alloc()  -> slot | TF_ERR_ENOSPC.
  //   tf_ovr_pool_free(slot).
  //   tf_grp_pool_alloc()  -> slot | TF_ERR_ENOSPC.
  //   tf_grp_pool_free(slot).
  //
  // Low-first scan of the per-slot bits array. Mirrors tiling_bsp_arena_
  // alloc / _free exactly.
  // ==========================================================================

  // tf_ovr_pool_alloc() -> slot | TF_ERR_ENOSPC.
  pub let tf_ovr_pool_alloc : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-04 (paideia-os #2292): claim one override slot via low-first scan of _tiling_floating_ovr_bits (TF_MAX_OVERRIDES=32, one u64 per slot). No callee-save needed; scratch only. Labels prefixed tf_opa_.",
      block: {
        xor rax, rax;
        lea r10, [rip + _tiling_floating_ovr_bits];
      tf_opa_scan:
        cmp rax, 32;
        jae tf_opa_enospc;
        mov r11, [r10 + rax * 8];
        cmp r11, 0;
        je  tf_opa_claim;
        add rax, 1;
        jmp tf_opa_scan;
      tf_opa_claim:
        mov r11, 1;
        mov [r10 + rax * 8], r11;
        ret;
      tf_opa_enospc:
        mov rax, 0xFFFFEABF;            // TF_ERR_ENOSPC
        ret
      }
    }

  // tf_ovr_pool_free(slot) -> ().
  pub let tf_ovr_pool_free : (u64) -> () !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-04 (paideia-os #2292): free one override slot by clearing its bit. Bounds-checked against TF_MAX_OVERRIDES(32); OOB is a silent no-op (matches tiling_bsp_arena_free's lt_row_free tolerance). Labels prefixed tf_opf_.",
      block: {
        mov r10, 32;
        cmp rdi, r10;
        jae tf_opf_out;
        lea r10, [rip + _tiling_floating_ovr_bits];
        xor rax, rax;
        mov [r10 + rdi * 8], rax;
      tf_opf_out:
        ret
      }
    }

  // tf_grp_pool_alloc() -> slot | TF_ERR_ENOSPC.
  pub let tf_grp_pool_alloc : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-04 (paideia-os #2292): claim one group slot via low-first scan of _tiling_floating_grp_bits (TF_MAX_GROUPS=8, one u64 per slot). Labels prefixed tf_gpa_.",
      block: {
        xor rax, rax;
        lea r10, [rip + _tiling_floating_grp_bits];
      tf_gpa_scan:
        cmp rax, 8;
        jae tf_gpa_enospc;
        mov r11, [r10 + rax * 8];
        cmp r11, 0;
        je  tf_gpa_claim;
        add rax, 1;
        jmp tf_gpa_scan;
      tf_gpa_claim:
        mov r11, 1;
        mov [r10 + rax * 8], r11;
        ret;
      tf_gpa_enospc:
        mov rax, 0xFFFFEABF;            // TF_ERR_ENOSPC
        ret
      }
    }

  // tf_grp_pool_free(slot) -> ().
  pub let tf_grp_pool_free : (u64) -> () !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-04 (paideia-os #2292): free one group slot. OOB no-op. Labels prefixed tf_gpf_.",
      block: {
        mov r10, 8;
        cmp rdi, r10;
        jae tf_gpf_out;
        lea r10, [rip + _tiling_floating_grp_bits];
        xor rax, rax;
        mov [r10 + rdi * 8], rax;
      tf_gpf_out:
        ret
      }
    }

  // ==========================================================================
  // SECTION F  FloatingOverride accessors.
  //
  // Every accessor takes an ovr_base pointer (as returned by tf_ovr_addr)
  // and returns the requested u32 field zero-extended, or the u8 mode
  // field zero-extended. Signed interpretation of i32 fields is punted
  // to the caller (see file header §2.1).
  // ==========================================================================

  // tf_ovr_window_kind_id(ovr_base) -> u32.
  pub let tf_ovr_window_kind_id : (u64) -> u64 !{mem} @{} =
    fn (ovr_base: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-04 (paideia-os #2292): read window_kind_id from wkid_mode[31:0]. shl 32; shr 32 zero-extend. Labels prefixed tf_owk_.",
      block: {
        mov rax, [rdi + 0];
        shl rax, 32;
        shr rax, 32;
        ret
      }
    }

  // tf_ovr_mode(ovr_base) -> u8 zero-extended.
  pub let tf_ovr_mode : (u64) -> u64 !{mem} @{} =
    fn (ovr_base: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-04 (paideia-os #2292): read mode from wkid_mode[39:32]. shr 32 then `and rax, 0xFF` isolates the u8. imm8 mask matches tb_node_axis idiom. Labels prefixed tf_omd_.",
      block: {
        mov rax, [rdi + 0];
        shr rax, 32;
        and rax, 0xFF;
        ret
      }
    }

  // tf_ovr_x(ovr_base) -> u32 (bits of i32 verbatim).
  pub let tf_ovr_x : (u64) -> u64 !{mem} @{} =
    fn (ovr_base: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-04 (paideia-os #2292): read override_x from xy[31:0]. Zero-extended bits verbatim; signed interpretation is caller's concern. Labels prefixed tf_ox_.",
      block: {
        mov rax, [rdi + 8];
        shl rax, 32;
        shr rax, 32;
        ret
      }
    }

  // tf_ovr_y(ovr_base) -> u32.
  pub let tf_ovr_y : (u64) -> u64 !{mem} @{} =
    fn (ovr_base: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-04 (paideia-os #2292): read override_y from xy[63:32]. Labels prefixed tf_oy_.",
      block: {
        mov rax, [rdi + 8];
        shr rax, 32;
        ret
      }
    }

  // tf_ovr_w(ovr_base) -> u32.
  pub let tf_ovr_w : (u64) -> u64 !{mem} @{} =
    fn (ovr_base: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-04 (paideia-os #2292): read override_w from wh[31:0]. Labels prefixed tf_ow_.",
      block: {
        mov rax, [rdi + 16];
        shl rax, 32;
        shr rax, 32;
        ret
      }
    }

  // tf_ovr_h(ovr_base) -> u32.
  pub let tf_ovr_h : (u64) -> u64 !{mem} @{} =
    fn (ovr_base: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-04 (paideia-os #2292): read override_h from wh[63:32]. Labels prefixed tf_oh_.",
      block: {
        mov rax, [rdi + 16];
        shr rax, 32;
        ret
      }
    }

  // tf_ovr_z_bump(ovr_base) -> u32.
  pub let tf_ovr_z_bump : (u64) -> u64 !{mem} @{} =
    fn (ovr_base: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-04 (paideia-os #2292): read z_bump from zb_grp[31:0]. Labels prefixed tf_ozb_.",
      block: {
        mov rax, [rdi + 24];
        shl rax, 32;
        shr rax, 32;
        ret
      }
    }

  // tf_ovr_stack_group_id(ovr_base) -> u32.
  pub let tf_ovr_stack_group_id : (u64) -> u64 !{mem} @{} =
    fn (ovr_base: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-04 (paideia-os #2292): read stack_group_id from zb_grp[63:32]. Labels prefixed tf_osg_.",
      block: {
        mov rax, [rdi + 24];
        shr rax, 32;
        ret
      }
    }

  // ==========================================================================
  // SECTION G  StackedGroup accessors.
  // ==========================================================================

  // tf_grp_group_id(grp_base) -> u32.
  pub let tf_grp_group_id : (u64) -> u64 !{mem} @{} =
    fn (grp_base: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-04 (paideia-os #2292): read group_id from id_count[31:0]. Labels prefixed tf_ggi_.",
      block: {
        mov rax, [rdi + 0];
        shl rax, 32;
        shr rax, 32;
        ret
      }
    }

  // tf_grp_member_count(grp_base) -> u32.
  pub let tf_grp_member_count : (u64) -> u64 !{mem} @{} =
    fn (grp_base: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-04 (paideia-os #2292): read member_count from id_count[63:32]. Labels prefixed tf_gmc_.",
      block: {
        mov rax, [rdi + 0];
        shr rax, 32;
        ret
      }
    }

  // tf_grp_visible_index(grp_base) -> u32.
  pub let tf_grp_visible_index : (u64) -> u64 !{mem} @{} =
    fn (grp_base: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-04 (paideia-os #2292): read visible_member_index from visible[31:0]. Labels prefixed tf_gvi_.",
      block: {
        mov rax, [rdi + 8];
        shl rax, 32;
        shr rax, 32;
        ret
      }
    }

  // tf_grp_member_get(grp_base, member_idx) -> u32 window_kind_id.
  //
  // Bounds-checked against TF_STACK_MEMBERS(8); OOB returns 0.
  //
  // word_off = 16 + (idx >> 1) * 8; half = idx & 1 (0=lo, 1=hi).
  pub let tf_grp_member_get : (u64, u64) -> u64 !{mem} @{} =
    fn (grp_base: u64) (member_idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-04 (paideia-os #2292): read members[member_idx]. word_off = 16 + (idx >> 1) * 8; hi/lo half selected by (idx & 1). No shl 5 needed (>>1 then *8 == *4, encoded as shl 3 on the shifted result). Bounds check idx < TF_STACK_MEMBERS(8); OOB -> 0. Labels prefixed tf_gmg_.",
      block: {
        mov r10, 8;
        cmp rsi, r10;
        jae tf_gmg_no;

        // r11 = (idx >> 1) * 8 + 16
        mov r11, rsi;
        shr r11, 1;
        shl r11, 3;                     // * 8
        add r11, 16;

        // rax = word at [grp_base + r11]
        mov rax, [rdi + r11];

        // half = idx & 1; if 1, take high half, else take low half.
        mov r10, rsi;
        and r10, 0x1;                   // imm8 mask, ok per §4
        cmp r10, 0;
        jne tf_gmg_hi;
        shl rax, 32;
        shr rax, 32;
        ret;
      tf_gmg_hi:
        shr rax, 32;
        ret;
      tf_gmg_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // SECTION H  FloatingOverride write helpers.
  //
  //   tf_ovr_write_wkid_mode(ovr_base, wkid, mode)
  //   tf_ovr_write_xy       (ovr_base, x, y)
  //   tf_ovr_write_wh       (ovr_base, w, h)
  //   tf_ovr_write_zb_grp   (ovr_base, z_bump, stack_group_id)
  //
  // Every write helper packs the two u32 halves into a u64 and stores
  // it to the target word.
  // ==========================================================================

  // tf_ovr_write_wkid_mode(ovr_base, wkid, mode) -> ().
  pub let tf_ovr_write_wkid_mode : (u64, u64, u64) -> () !{mem} @{} =
    fn (ovr_base: u64) (wkid: u64) (mode: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-04 (paideia-os #2292): pack (wkid[31:0] | mode[39:32] | 0[63:40]) into wkid_mode. wkid zero-extended via shl32/shr32; mode masked to u8 (imm8 form) then shl 32 to sit at [39:32]. Labels prefixed tf_owwm_.",
      block: {
        mov rax, rsi;
        shl rax, 32;
        shr rax, 32;                    // rax = wkid zero-extended
        mov r10, rdx;
        and r10, 0xFF;                  // isolate u8 mode
        shl r10, 32;                    // place at [39:32]
        or  rax, r10;
        mov [rdi + 0], rax;
        ret
      }
    }

  // tf_ovr_write_xy(ovr_base, x, y) -> ().
  pub let tf_ovr_write_xy : (u64, u64, u64) -> () !{mem} @{} =
    fn (ovr_base: u64) (x: u64) (y: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-04 (paideia-os #2292): pack (x[31:0] | y[63:32]) into xy. Labels prefixed tf_owxy_.",
      block: {
        mov rax, rsi;
        shl rax, 32;
        shr rax, 32;                    // zero-extended x
        mov r10, rdx;
        shl r10, 32;                    // y into [63:32]
        or  rax, r10;
        mov [rdi + 8], rax;
        ret
      }
    }

  // tf_ovr_write_wh(ovr_base, w, h) -> ().
  pub let tf_ovr_write_wh : (u64, u64, u64) -> () !{mem} @{} =
    fn (ovr_base: u64) (w: u64) (h: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-04 (paideia-os #2292): pack (w[31:0] | h[63:32]) into wh. Labels prefixed tf_owwh_.",
      block: {
        mov rax, rsi;
        shl rax, 32;
        shr rax, 32;
        mov r10, rdx;
        shl r10, 32;
        or  rax, r10;
        mov [rdi + 16], rax;
        ret
      }
    }

  // tf_ovr_write_zb_grp(ovr_base, z_bump, stack_group_id) -> ().
  pub let tf_ovr_write_zb_grp : (u64, u64, u64) -> () !{mem} @{} =
    fn (ovr_base: u64) (z_bump: u64) (stack_group_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-04 (paideia-os #2292): pack (z_bump[31:0] | stack_group_id[63:32]) into zb_grp. Labels prefixed tf_owzg_.",
      block: {
        mov rax, rsi;
        shl rax, 32;
        shr rax, 32;
        mov r10, rdx;
        shl r10, 32;
        or  rax, r10;
        mov [rdi + 24], rax;
        ret
      }
    }

  // ==========================================================================
  // SECTION I  StackedGroup write helpers.
  //
  //   tf_grp_write_id_count(grp_base, group_id, member_count)
  //   tf_grp_write_visible (grp_base, visible_index)
  //   tf_grp_member_set    (grp_base, member_idx, window_kind_id)
  // ==========================================================================

  // tf_grp_write_id_count(grp_base, group_id, member_count) -> ().
  pub let tf_grp_write_id_count : (u64, u64, u64) -> () !{mem} @{} =
    fn (grp_base: u64) (group_id: u64) (member_count: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-04 (paideia-os #2292): pack (group_id[31:0] | member_count[63:32]) into id_count. Labels prefixed tf_gwic_.",
      block: {
        mov rax, rsi;
        shl rax, 32;
        shr rax, 32;
        mov r10, rdx;
        shl r10, 32;
        or  rax, r10;
        mov [rdi + 0], rax;
        ret
      }
    }

  // tf_grp_write_visible(grp_base, visible_index) -> ().
  //
  // Overwrites JUST the low 32 bits of the visible word, preserving the
  // reserved high half.
  pub let tf_grp_write_visible : (u64, u64) -> () !{mem} @{} =
    fn (grp_base: u64) (visible_index: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-04 (paideia-os #2292): overwrite visible[31:0] preserving reserved[63:32]. Load-mask-or-store idiom. Labels prefixed tf_gwv_.",
      block: {
        mov rax, [rdi + 8];
        shr rax, 32;                    // rax = reserved (u32) in low
        shl rax, 32;                    // move back to high
        mov r10, rsi;
        shl r10, 32;
        shr r10, 32;                    // zero-extended visible_index
        or  rax, r10;
        mov [rdi + 8], rax;
        ret
      }
    }

  // tf_grp_member_set(grp_base, member_idx, window_kind_id) -> ().
  //
  // Writes members[member_idx] = window_kind_id. Bounds-checked against
  // TF_STACK_MEMBERS(8); OOB is a silent no-op.
  //
  // word_off = 16 + (idx >> 1) * 8; half = idx & 1 (0=lo, 1=hi).
  // Load word, mask out the target half, OR in the new value, store.
  pub let tf_grp_member_set : (u64, u64, u64) -> () !{mem} @{} =
    fn (grp_base: u64) (member_idx: u64) (window_kind_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-04 (paideia-os #2292): write members[member_idx]. word_off = 16 + (idx >> 1) * 8; half selected by (idx & 1). Load-mask-or-store: preserves the OTHER half of the word. Bounds check idx < TF_STACK_MEMBERS(8); OOB no-op. Labels prefixed tf_gms_.",
      block: {
        mov r10, 8;
        cmp rsi, r10;
        jae tf_gms_out;

        // r11 = (idx >> 1) * 8 + 16 = target word offset within grp_base
        mov r11, rsi;
        shr r11, 1;
        shl r11, 3;
        add r11, 16;

        // Load existing word.
        mov rax, [rdi + r11];

        // Determine half: rcx = idx & 1 (0 = lo, 1 = hi).
        mov rcx, rsi;
        and rcx, 0x1;
        cmp rcx, 0;
        jne tf_gms_set_hi;

        // Set low half: mask out [31:0], OR in wkid.
        shr rax, 32;                    // rax = old high in low
        shl rax, 32;                    // rax = old high in [63:32], low zero
        mov r10, rdx;
        shl r10, 32;
        shr r10, 32;                    // zero-extended wkid in low
        or  rax, r10;
        mov [rdi + r11], rax;
        jmp tf_gms_out;

      tf_gms_set_hi:
        // Set high half: mask out [63:32], OR in wkid << 32.
        shl rax, 32;
        shr rax, 32;                    // rax = old low, high zero
        mov r10, rdx;
        shl r10, 32;                    // wkid at [63:32]
        or  rax, r10;
        mov [rdi + r11], rax;

      tf_gms_out:
        ret
      }
    }

  // ==========================================================================
  // SECTION J  Stats helpers.
  // ==========================================================================

  pub let tf_stats_bump : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-04 (paideia-os #2292): bounds-checked counter bump against TF_STATS_MAX(4). Load-inc-store idiom (no `add reg, [mem]`). Labels prefixed tf_sb_.",
      block: {
        cmp rdi, 4;
        jae tf_sb_out;
        lea r10, [rip + _tiling_floating_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      tf_sb_out:
        ret
      }
    }

  pub let tf_stats_read : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-04 (paideia-os #2292): bounds-checked counter read; OOB -> 0. Labels prefixed tf_sr_.",
      block: {
        cmp rdi, 4;
        jae tf_sr_zero;
        lea r10, [rip + _tiling_floating_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      tf_sr_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // SECTION K  Public API -- factories.
  //
  //   floating_override_new(window, mode, x, y, w, h) -> slot | error.
  //   stacked_group_new    (group_id)                 -> slot | error.
  // ==========================================================================

  // floating_override_new(window, mode, x, y, w, h) -> slot | error.
  //
  // Args (SysV): rdi=window, rsi=mode, rdx=x, rcx=y, r8=w, r9=h.
  //
  // Validation:
  //   * window != 0            -- else TF_ERR_BAD_WINDOW.
  //   * mode <= TF_MODE_MAX(3) -- else TF_ERR_BAD_MODE.
  //   * If mode == TF_MODE_FLOATING: w > 0 AND h > 0 -- else TF_ERR_BAD_GEOMETRY.
  //
  // On success: alloc a slot from the pool, initialise the four words
  // (wkid_mode, xy, wh, zb_grp -- z_bump and stack_group_id default 0),
  // bump TF_ST_ALLOCS, return slot.
  //
  // Callee-save layout: 6 pushes (rbx, r12..r15, rbp) = 48 bytes;
  // entry rsp%16==8 -> 8+48==56 -> %16==8; sub rsp, 24 -> 80 -> %16==0
  // (aligned for nested calls).
  // Fixed local frame: [rsp+0]=slot, [rsp+8]=err_stash, [rsp+16]=align pad.
  pub let floating_override_new : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (window: u64) (mode: u64) (x: u64) (y: u64) (w: u64) (h: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-04 (paideia-os #2292): factory for a fresh FloatingOverride. Six callee-save pushes (rbx=window, r12=mode, r13=x, r14=y, r15=w, rbp=h) + sub rsp, 24 -- entry rsp%16==8; +48 pushes==8; +24 sub==0 (aligned for nested tf_ovr_pool_alloc / tf_ovr_addr / tf_ovr_write_* / tf_stats_bump). Fixed local frame: [rsp+0]=slot, [rsp+8]=err_stash, [rsp+16]=align pad. Validation order: window!=0, mode<=3, (mode==FLOATING -> w>0 && h>0). tf_ovr_pool_alloc returns TF_ERR_ENOSPC (0xFFFFEABF) on ENOSPC which is well above TF_MAX_OVERRIDES(32), so `cmp rax, 32; jae` cleanly detects it. Labels prefixed tf_ovn_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;
        sub  rsp, 24;

        mov  rbx, rdi;
        mov  r12, rsi;
        mov  r13, rdx;
        mov  r14, rcx;
        mov  r15, r8;
        mov  rbp, r9;

        // --- Validation ---

        // window != 0
        cmp  rbx, 0;
        je   tf_ovn_bad_window;

        // mode <= TF_MODE_MAX(3)
        cmp  r12, 3;
        ja   tf_ovn_bad_mode;

        // If mode == FLOATING(1), require w > 0 AND h > 0.
        cmp  r12, 1;
        jne  tf_ovn_skip_geom;
        cmp  r15, 0;
        je   tf_ovn_bad_geom;
        cmp  rbp, 0;
        je   tf_ovn_bad_geom;

      tf_ovn_skip_geom:
        // --- Alloc slot ---
        call tf_ovr_pool_alloc;
        cmp  rax, 32;                   // TF_MAX_OVERRIDES; ENOSPC returns 0xFFFFEABF >> 32
        jae  tf_ovn_enospc;
        mov  [rsp + 0], rax;

        // --- Write the four override words ---

        // ovr_base = tf_ovr_addr(slot)
        mov  rdi, [rsp + 0];
        call tf_ovr_addr;

        // Word 0: wkid_mode = (window, mode)
        mov  rdi, rax;                  // ovr_base carried in rdi through the four writes
        mov  rsi, rbx;                  // window
        mov  rdx, r12;                  // mode
        call tf_ovr_write_wkid_mode;

        // Word 1: xy = (x, y). Recompute ovr_base (rdi was clobbered by the
        // call). Same for the following two.
        mov  rdi, [rsp + 0];
        call tf_ovr_addr;
        mov  rdi, rax;
        mov  rsi, r13;
        mov  rdx, r14;
        call tf_ovr_write_xy;

        // Word 2: wh = (w, h)
        mov  rdi, [rsp + 0];
        call tf_ovr_addr;
        mov  rdi, rax;
        mov  rsi, r15;
        mov  rdx, rbp;
        call tf_ovr_write_wh;

        // Word 3: zb_grp = (0, 0)  -- z_bump and stack_group_id default 0.
        mov  rdi, [rsp + 0];
        call tf_ovr_addr;
        mov  rdi, rax;
        xor  rsi, rsi;
        xor  rdx, rdx;
        call tf_ovr_write_zb_grp;

        // --- Bump ALLOCS stat, return slot ---
        mov  rdi, 0;                    // TF_ST_ALLOCS
        call tf_stats_bump;

        mov  rax, [rsp + 0];
        jmp  tf_ovn_out;

      tf_ovn_bad_window:
        mov  rax, 0xFFFFEAB7;           // TF_ERR_BAD_WINDOW
        jmp  tf_ovn_out_refused;

      tf_ovn_bad_mode:
        mov  rax, 0xFFFFEABD;           // TF_ERR_BAD_MODE
        jmp  tf_ovn_out_refused;

      tf_ovn_bad_geom:
        mov  rax, 0xFFFFEABC;           // TF_ERR_BAD_GEOMETRY
        jmp  tf_ovn_out_refused;

      tf_ovn_enospc:
        mov  rax, 0xFFFFEABF;           // TF_ERR_ENOSPC

      tf_ovn_out_refused:
        mov  [rsp + 8], rax;
        mov  rdi, 3;                    // TF_ST_REFUSED
        call tf_stats_bump;
        mov  rax, [rsp + 8];

      tf_ovn_out:
        add  rsp, 24;
        pop  rbp;
        pop  r15;
        pop  r14;
        pop  r13;
        pop  r12;
        pop  rbx;
        ret
      }
    }

  // stacked_group_new(group_id) -> slot | error.
  //
  // Validation: group_id != 0 (0 means "no group" per §2.1).
  //
  // On success: alloc a group slot, initialise (group_id, 0, 0, 0, ..., 0)
  // -- member_count = 0, visible_index = 0, all members = 0.
  pub let stacked_group_new : (u64) -> u64 !{mem} @{} =
    fn (group_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-04 (paideia-os #2292): factory for a fresh StackedGroup. Two callee-save pushes (rbx=group_id, r12=slot) + sub rsp, 8 -- entry rsp%16==8; +16 pushes == 8; +8 sub == 0 (aligned). Local: [rsp+0]=err_stash. Zeros all four member words (16..40) and the visible word (8) with a single store each; only id_count carries the initial group_id + 0 count. Labels prefixed tf_sgn_.",
      block: {
        push rbx;
        push r12;
        sub  rsp, 8;

        mov  rbx, rdi;

        // Validation: group_id != 0
        cmp  rbx, 0;
        je   tf_sgn_bad_id;

        // Alloc slot.
        call tf_grp_pool_alloc;
        cmp  rax, 8;                    // TF_MAX_GROUPS; ENOSPC returns 0xFFFFEABF
        jae  tf_sgn_enospc;
        mov  r12, rax;

        // grp_base = tf_grp_addr(slot)
        mov  rdi, r12;
        call tf_grp_addr;

        // Zero all six words explicitly (defensive; the pool may hold a
        // recycled slot whose prior contents survive the free/alloc).
        xor  r10, r10;
        mov  [rax + 0],  r10;           // id_count (rewritten below)
        mov  [rax + 8],  r10;           // visible
        mov  [rax + 16], r10;
        mov  [rax + 24], r10;
        mov  [rax + 32], r10;
        mov  [rax + 40], r10;

        // Now write id_count = (group_id, 0). rax still holds grp_base.
        mov  rdi, rax;
        mov  rsi, rbx;
        xor  rdx, rdx;                  // member_count = 0
        call tf_grp_write_id_count;

        // Bump ALLOCS.
        mov  rdi, 0;                    // TF_ST_ALLOCS
        call tf_stats_bump;

        mov  rax, r12;
        jmp  tf_sgn_out;

      tf_sgn_bad_id:
        mov  rax, 0xFFFFEAB6;           // TF_ERR_BAD_GROUP_ID
        jmp  tf_sgn_out_refused;

      tf_sgn_enospc:
        mov  rax, 0xFFFFEABF;           // TF_ERR_ENOSPC

      tf_sgn_out_refused:
        mov  [rsp + 0], rax;
        mov  rdi, 3;                    // TF_ST_REFUSED
        call tf_stats_bump;
        mov  rax, [rsp + 0];

      tf_sgn_out:
        add  rsp, 8;
        pop  r12;
        pop  rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION L  Public API -- apply.
  //
  // floating_override_apply(ovr_slot, bsp_xy, bsp_wh, output_xy,
  //                         output_wh, out_ptr) -> TF_OK | error | TF_HIDDEN
  //
  // Computes the effective (x, y, w, h) for the window this override
  // describes and writes it to *out_ptr / *(out_ptr + 8):
  //
  //   *out_ptr       = packed (eff_x | eff_y << 32)
  //   *(out_ptr + 8) = packed (eff_w | eff_h << 32)
  //
  // Mode dispatch:
  //   TILED       eff = bsp_xy / bsp_wh (verbatim).
  //   FLOATING    eff = (override_x, override_y, override_w, override_h).
  //   STACKED     If this override's stack_group_id != 0 AND the group's
  //               visible_member's window_kind_id matches this override's
  //               window_kind_id, eff = bsp_xy / bsp_wh; otherwise return
  //               TF_HIDDEN (caller does not render this window). If the
  //               group is empty or the id is 0 (mis-configured), same
  //               as TILED.
  //   FULLSCREEN  eff = output_xy / output_wh.
  //
  // out_ptr aligned to 8 bytes (caller invariant); no validation here
  // (matches tb_leaf_geom's out_ptr posture).
  //
  // Callee-save layout: 6 pushes = 48 bytes; entry rsp%16==8 -> 56 -> %16==8;
  // sub rsp, 24 -> 80 -> %16==0. Fixed local frame:
  //   [rsp+0]  = eff_xy (packed)
  //   [rsp+8]  = eff_wh (packed)
  //   [rsp+16] = align pad
  pub let floating_override_apply : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (ovr_slot: u64) (bsp_xy: u64) (bsp_wh: u64) (output_xy: u64)
       (output_wh: u64) (out_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-04 (paideia-os #2292): dispatch on mode, compute effective geometry, write to *out_ptr / *(out_ptr+8). Six callee-save pushes (rbx=ovr_slot, r12=bsp_xy, r13=bsp_wh, r14=output_xy, r15=output_wh, rbp=out_ptr) + sub rsp, 24 -- entry rsp%16==8; +48 pushes==8; +24 sub==0 (aligned for nested tf_ovr_addr / tf_ovr_mode / tf_ovr_x/y/w/h / tf_grp_* / tf_stats_bump). Validation: ovr_slot < TF_MAX_OVERRIDES(32); out_ptr != 0. Mode dispatch table via cmp/je fan-out (four modes, no computed goto). STACKED path: reads override's stack_group_id, if 0 falls through to TILED; else scans _tiling_floating_grp_bits for a group whose group_id matches (linear scan of 8 groups is fine at this ceiling), reads member at visible_member_index, compares against this override's window_kind_id -- match -> TILED-shape; mismatch -> TF_HIDDEN. Labels prefixed tf_oap_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;
        sub  rsp, 24;

        mov  rbx, rdi;
        mov  r12, rsi;
        mov  r13, rdx;
        mov  r14, rcx;
        mov  r15, r8;
        mov  rbp, r9;

        // --- Validation ---

        // ovr_slot < TF_MAX_OVERRIDES(32)
        mov  r10, 32;
        cmp  rbx, r10;
        jae  tf_oap_bad_slot;

        // out_ptr != 0
        cmp  rbp, 0;
        je   tf_oap_bad_out;

        // --- Read override's mode into r10 (via scratch through calls) ---
        // Stash into [rsp+16] because r10 does not survive tf_ovr_addr.
        mov  rdi, rbx;
        call tf_ovr_addr;
        cmp  rax, 0;
        je   tf_oap_bad_slot;
        mov  [rsp + 16], rax;           // stash ovr_base

        mov  rdi, rax;
        call tf_ovr_mode;
        // rax = mode

        // Dispatch.
        cmp  rax, 0;                    // TF_MODE_TILED
        je   tf_oap_do_tiled;
        cmp  rax, 1;                    // TF_MODE_FLOATING
        je   tf_oap_do_floating;
        cmp  rax, 2;                    // TF_MODE_STACKED
        je   tf_oap_do_stacked;
        cmp  rax, 3;                    // TF_MODE_FULLSCREEN
        je   tf_oap_do_fullscreen;

        // Impossible: writer bounded mode to <=3 at factory time.
        jmp  tf_oap_bad_mode;

      tf_oap_do_tiled:
        mov  [rsp + 0], r12;            // eff_xy = bsp_xy
        mov  [rsp + 8], r13;            // eff_wh = bsp_wh
        jmp  tf_oap_write;

      tf_oap_do_floating:
        // Read (x, y, w, h) from override, pack into two u64 words.
        mov  rdi, [rsp + 16];
        call tf_ovr_x;
        mov  rcx, rax;                  // rcx = x (survives following calls via [rsp+0])

        // Stash x in [rsp+0] low half for the pack pass below.
        shl  rcx, 32;
        shr  rcx, 32;                   // zero-ext x
        mov  [rsp + 0], rcx;

        mov  rdi, [rsp + 16];
        call tf_ovr_y;
        shl  rax, 32;                   // y at [63:32]
        mov  rcx, [rsp + 0];
        or   rcx, rax;
        mov  [rsp + 0], rcx;            // eff_xy done

        mov  rdi, [rsp + 16];
        call tf_ovr_w;
        shl  rax, 32;
        shr  rax, 32;
        mov  [rsp + 8], rax;

        mov  rdi, [rsp + 16];
        call tf_ovr_h;
        shl  rax, 32;                   // h at [63:32]
        mov  rcx, [rsp + 8];
        or   rcx, rax;
        mov  [rsp + 8], rcx;            // eff_wh done
        jmp  tf_oap_write;

      tf_oap_do_stacked:
        // Read stack_group_id; if 0, fall through to TILED behaviour.
        mov  rdi, [rsp + 16];
        call tf_ovr_stack_group_id;
        cmp  rax, 0;
        je   tf_oap_do_tiled;

        // Find the group slot whose group_id matches rax. Linear scan
        // over 8 groups. rax carries the target group_id across the loop
        // via callee-save r14... wait -- r14 is our output_xy. Use rbx?
        // rbx holds ovr_slot which we no longer need after the mode read.
        //
        // Repurpose rbx as target_group_id, r14 remains output_xy.
        mov  rbx, rax;                  // rbx = target group_id
        xor  r10, r10;                  // r10 = scan cursor
      tf_oap_scan_grp:
        cmp  r10, 8;
        jae  tf_oap_stacked_notfound;

        // Check alloc bit.
        lea  r11, [rip + _tiling_floating_grp_bits];
        mov  rcx, [r11 + r10 * 8];
        cmp  rcx, 0;
        je   tf_oap_scan_next;

        // Get group base + read its group_id.
        mov  [rsp + 0], r10;            // stash cursor across call
        mov  rdi, r10;
        call tf_grp_addr;
        cmp  rax, 0;
        je   tf_oap_scan_step;
        mov  rdi, rax;
        call tf_grp_group_id;
        cmp  rax, rbx;
        je   tf_oap_stacked_found;
      tf_oap_scan_step:
        mov  r10, [rsp + 0];
      tf_oap_scan_next:
        add  r10, 1;
        jmp  tf_oap_scan_grp;

      tf_oap_stacked_notfound:
        // No group with that id. Treat as TILED.
        mov  [rsp + 0], r12;
        mov  [rsp + 8], r13;
        jmp  tf_oap_write;

      tf_oap_stacked_found:
        // r10 was the cursor when we entered the check; it was stashed
        // in [rsp+0] pre-call. Recover it.
        mov  r10, [rsp + 0];
        // grp_slot = r10; get grp_base again.
        mov  rdi, r10;
        call tf_grp_addr;
        mov  r11, rax;                  // r11 = grp_base

        // member_count == 0? -> hidden (empty group).
        mov  rdi, r11;
        call tf_grp_member_count;
        cmp  rax, 0;
        je   tf_oap_hidden;

        // visible_member_index -> use to fetch member.
        mov  rdi, r11;
        call tf_grp_visible_index;
        // rax = visible_idx; call member_get(grp_base, visible_idx).
        mov  rdi, r11;
        mov  rsi, rax;
        call tf_grp_member_get;
        // rax = the group's currently-visible window_kind_id.

        // Compare against this override's window_kind_id.
        mov  rcx, rax;                  // rcx = visible_wkid
        mov  rdi, [rsp + 16];
        call tf_ovr_window_kind_id;
        cmp  rax, rcx;
        jne  tf_oap_hidden;

        // Visible: return TILED-shape geometry.
        mov  [rsp + 0], r12;
        mov  [rsp + 8], r13;
        jmp  tf_oap_write;

      tf_oap_do_fullscreen:
        mov  [rsp + 0], r14;            // eff_xy = output_xy
        mov  [rsp + 8], r15;            // eff_wh = output_wh
        jmp  tf_oap_write;

      tf_oap_write:
        // Store the packed (eff_xy, eff_wh) at *out_ptr / *(out_ptr+8).
        mov  rax, [rsp + 0];
        mov  [rbp + 0], rax;
        mov  rax, [rsp + 8];
        mov  [rbp + 8], rax;

        // Bump APPLIES, return TF_OK.
        mov  rdi, 2;                    // TF_ST_APPLIES
        call tf_stats_bump;

        xor  rax, rax;                  // TF_OK
        jmp  tf_oap_out;

      tf_oap_hidden:
        mov  rax, 0xFFFFEAB5;           // TF_HIDDEN (not an error; caller skips draw)
        jmp  tf_oap_out;

      tf_oap_bad_slot:
        mov  rax, 0xFFFFEABE;           // TF_ERR_BAD_SLOT
        jmp  tf_oap_out_refused;

      tf_oap_bad_out:
        mov  rax, 0xFFFFEAB4;           // TF_ERR_BAD_OUT_PTR
        jmp  tf_oap_out_refused;

      tf_oap_bad_mode:
        mov  rax, 0xFFFFEABD;           // TF_ERR_BAD_MODE (defense-in-depth)

      tf_oap_out_refused:
        // Preserve error across the tf_stats_bump call via [rsp+16]
        // (its "ovr_base stash" role is done in every refusal branch,
        // because we either failed before reading it or we're leaving
        // via the STACKED miscount path which reuses it via [rsp+0]).
        mov  [rsp + 16], rax;
        mov  rdi, 3;                    // TF_ST_REFUSED
        call tf_stats_bump;
        mov  rax, [rsp + 16];

      tf_oap_out:
        add  rsp, 24;
        pop  rbp;
        pop  r15;
        pop  r14;
        pop  r13;
        pop  r12;
        pop  rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION M  Public API -- StackedGroup members.
  //
  //   stacked_group_add        (grp_slot, window) -> TF_OK | error
  //   stacked_group_cycle_next (grp_slot)         -> new_visible_index | error
  // ==========================================================================

  // stacked_group_add(grp_slot, window) -> TF_OK | error.
  //
  // Appends window to the group's members array. Refuses with
  // TF_ERR_GROUP_FULL when member_count already == TF_STACK_MEMBERS(8).
  //
  // Bumps member_count by +1 on success; leaves visible_member_index
  // alone (a new member is added silently at the tail -- the caller
  // decides whether to cycle onto it).
  //
  // Two callee-save pushes (rbx=grp_slot, r12=window) + sub rsp, 8;
  // entry rsp%16==8; +16 pushes==8; +8 sub==0 (aligned).
  pub let stacked_group_add : (u64, u64) -> u64 !{mem} @{} =
    fn (grp_slot: u64) (window: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-04 (paideia-os #2292): append window to group members. Bounds-check grp_slot < TF_MAX_GROUPS(8) and member_count < TF_STACK_MEMBERS(8). Two callee-save pushes (rbx=grp_slot, r12=window) + sub rsp, 8. Local: [rsp+0] used both as grp_base cache and as err stash across the refused-path tf_stats_bump. Labels prefixed tf_sga_.",
      block: {
        push rbx;
        push r12;
        sub  rsp, 8;

        mov  rbx, rdi;
        mov  r12, rsi;

        // Bounds: grp_slot < 8
        mov  r10, 8;
        cmp  rbx, r10;
        jae  tf_sga_bad_slot;

        // Check alloc bit.
        lea  r10, [rip + _tiling_floating_grp_bits];
        mov  r11, [r10 + rbx * 8];
        cmp  r11, 0;
        je   tf_sga_not_found;

        // grp_base = tf_grp_addr(grp_slot)
        mov  rdi, rbx;
        call tf_grp_addr;
        cmp  rax, 0;
        je   tf_sga_bad_slot;
        mov  [rsp + 0], rax;

        // member_count = tf_grp_member_count(grp_base)
        mov  rdi, [rsp + 0];
        call tf_grp_member_count;
        // rax = current count
        cmp  rax, 8;                    // TF_STACK_MEMBERS
        jae  tf_sga_full;

        // members[count] = window
        mov  rdi, [rsp + 0];
        mov  rsi, rax;                  // member_idx = count
        mov  rdx, r12;                  // window
        call tf_grp_member_set;

        // id_count.member_count = old_count + 1. To preserve group_id,
        // read the current group_id, then write both back via
        // tf_grp_write_id_count(grp_base, group_id, old_count + 1).
        mov  rdi, [rsp + 0];
        call tf_grp_member_count;
        add  rax, 1;
        mov  r11, rax;                  // r11 = new_count (preserved across group_id read)

        mov  rdi, [rsp + 0];
        call tf_grp_group_id;
        // rax = group_id; r11 still = new_count.
        mov  rdi, [rsp + 0];
        mov  rsi, rax;
        mov  rdx, r11;
        call tf_grp_write_id_count;

        xor  rax, rax;                  // TF_OK
        jmp  tf_sga_out;

      tf_sga_bad_slot:
        mov  rax, 0xFFFFEABE;           // TF_ERR_BAD_SLOT
        jmp  tf_sga_out_refused;

      tf_sga_not_found:
        mov  rax, 0xFFFFEAB9;           // TF_ERR_NOT_FOUND
        jmp  tf_sga_out_refused;

      tf_sga_full:
        mov  rax, 0xFFFFEABB;           // TF_ERR_GROUP_FULL

      tf_sga_out_refused:
        mov  [rsp + 0], rax;
        mov  rdi, 3;                    // TF_ST_REFUSED
        call tf_stats_bump;
        mov  rax, [rsp + 0];

      tf_sga_out:
        add  rsp, 8;
        pop  r12;
        pop  rbx;
        ret
      }
    }

  // stacked_group_cycle_next(grp_slot) -> new_visible_index | error.
  //
  // Advances visible_member_index by 1 modulo member_count. Refuses
  // with TF_ERR_EMPTY_GROUP when member_count == 0.
  //
  // Modulo encoded as div-with-zero-upper: xor rdx, rdx; div r_count;
  // rdx is the remainder. count > 0 verified before the div, so no
  // divide-by-zero.
  pub let stacked_group_cycle_next : (u64) -> u64 !{mem} @{} =
    fn (grp_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-04 (paideia-os #2292): advance visible_member_index by 1 mod member_count. Bounds-check grp_slot; check alloc bit; refuse empty group. Two callee-save pushes (rbx=grp_slot, r12=grp_base) + sub rsp, 8 -- aligned. Modulo via unsigned div: xor rdx, rdx; div r_count; new_visible = rdx (remainder). Writes back via tf_grp_write_visible (preserves reserved high half). Labels prefixed tf_sgcn_.",
      block: {
        push rbx;
        push r12;
        sub  rsp, 8;

        mov  rbx, rdi;

        // Bounds.
        mov  r10, 8;
        cmp  rbx, r10;
        jae  tf_sgcn_bad_slot;

        // Alloc bit.
        lea  r10, [rip + _tiling_floating_grp_bits];
        mov  r11, [r10 + rbx * 8];
        cmp  r11, 0;
        je   tf_sgcn_not_found;

        // grp_base
        mov  rdi, rbx;
        call tf_grp_addr;
        cmp  rax, 0;
        je   tf_sgcn_bad_slot;
        mov  r12, rax;                  // r12 = grp_base

        // member_count
        mov  rdi, r12;
        call tf_grp_member_count;
        cmp  rax, 0;
        je   tf_sgcn_empty;
        mov  r10, rax;                  // r10 = member_count (survives next call)

        // visible_index
        mov  rdi, r12;
        call tf_grp_visible_index;
        // rax = old visible

        // new = (old + 1) mod count
        add  rax, 1;
        xor  rdx, rdx;
        div  r10;
        // rdx = new visible; rax = quotient (unused)

        // Write back.
        mov  rdi, r12;
        mov  rsi, rdx;
        call tf_grp_write_visible;

        // Return the new visible index. Re-read to avoid depending on
        // rsi surviving the write call (SysV clobbers rsi across calls;
        // tf_grp_write_visible does not preserve it).
        mov  rdi, r12;
        call tf_grp_visible_index;
        jmp  tf_sgcn_out;

      tf_sgcn_bad_slot:
        mov  rax, 0xFFFFEABE;           // TF_ERR_BAD_SLOT
        jmp  tf_sgcn_out_refused;

      tf_sgcn_not_found:
        mov  rax, 0xFFFFEAB9;           // TF_ERR_NOT_FOUND
        jmp  tf_sgcn_out_refused;

      tf_sgcn_empty:
        mov  rax, 0xFFFFEABA;           // TF_ERR_EMPTY_GROUP

      tf_sgcn_out_refused:
        mov  [rsp + 0], rax;
        mov  rdi, 3;                    // TF_ST_REFUSED
        call tf_stats_bump;
        mov  rax, [rsp + 0];

      tf_sgcn_out:
        add  rsp, 8;
        pop  r12;
        pop  rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION N  Public API -- override free.
  //
  // floating_override_free(slot) -> TF_OK | error.
  //
  // Bounds-checks the slot, clears its alloc bit (payload is not zeroed;
  // stacked_group_new zeros its slot on reuse; a similar reset lives in
  // the future workspace-wire-in for overrides). Bumps FREES.
  // ==========================================================================

  pub let floating_override_free : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-04 (paideia-os #2292): free an override slot. Bounds + alloc-bit check first; then call tf_ovr_pool_free and bump FREES. One callee-save push (rbx) leaves rsp%16==0 across nested calls. Labels prefixed tf_off_.",
      block: {
        push rbx;

        mov  rbx, rdi;

        // Bounds
        mov  r10, 32;
        cmp  rbx, r10;
        jae  tf_off_bad_slot;

        // Alloc bit set?
        lea  r10, [rip + _tiling_floating_ovr_bits];
        mov  r11, [r10 + rbx * 8];
        cmp  r11, 0;
        je   tf_off_not_found;

        // Free.
        mov  rdi, rbx;
        call tf_ovr_pool_free;

        // Bump FREES.
        mov  rdi, 1;                    // TF_ST_FREES
        call tf_stats_bump;

        xor  rax, rax;                  // TF_OK
        jmp  tf_off_out;

      tf_off_bad_slot:
        mov  rax, 0xFFFFEABE;           // TF_ERR_BAD_SLOT
        jmp  tf_off_out_refused;

      tf_off_not_found:
        mov  rax, 0xFFFFEAB9;           // TF_ERR_NOT_FOUND

      tf_off_out_refused:
        // Preserve rax across the stats bump via rbx (its own role is done).
        mov  rbx, rax;
        mov  rdi, 3;                    // TF_ST_REFUSED
        call tf_stats_bump;
        mov  rax, rbx;

      tf_off_out:
        pop  rbx;
        ret
      }
    }

  // stacked_group_free(slot) -> TF_OK | error. Symmetric with
  // floating_override_free.
  pub let stacked_group_free : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-04 (paideia-os #2292): free a group slot. Same shape as floating_override_free but against TF_MAX_GROUPS and _tiling_floating_grp_bits. Labels prefixed tf_gff_.",
      block: {
        push rbx;

        mov  rbx, rdi;

        mov  r10, 8;
        cmp  rbx, r10;
        jae  tf_gff_bad_slot;

        lea  r10, [rip + _tiling_floating_grp_bits];
        mov  r11, [r10 + rbx * 8];
        cmp  r11, 0;
        je   tf_gff_not_found;

        mov  rdi, rbx;
        call tf_grp_pool_free;

        mov  rdi, 1;                    // TF_ST_FREES
        call tf_stats_bump;

        xor  rax, rax;
        jmp  tf_gff_out;

      tf_gff_bad_slot:
        mov  rax, 0xFFFFEABE;
        jmp  tf_gff_out_refused;

      tf_gff_not_found:
        mov  rax, 0xFFFFEAB9;

      tf_gff_out_refused:
        mov  rbx, rax;
        mov  rdi, 3;
        call tf_stats_bump;
        mov  rax, rbx;

      tf_gff_out:
        pop  rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION O  Init.
  //
  // tiling_floating_init(): zero the two pools, the two alloc-bit
  // arrays, and the stats counter table. Defensive; .bss is already
  // zero at real boot. Mirrors tiling_bsp_init.
  // ==========================================================================

  pub let tiling_floating_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-04 (paideia-os #2292): zero _tiling_floating_overrides (128 u64), _tiling_floating_groups (48 u64), _tiling_floating_ovr_bits (32 u64), _tiling_floating_grp_bits (8 u64), _tiling_floating_stats (4 u64). Defensive; .bss is already zero at real boot. Labels prefixed tf_ini_.",
      block: {
        xor rax, rax;

        lea r10, [rip + _tiling_floating_overrides];
        xor rcx, rcx;
      tf_ini_ovr:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 128;
        jb  tf_ini_ovr;

        lea r10, [rip + _tiling_floating_groups];
        xor rcx, rcx;
      tf_ini_grp:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 48;
        jb  tf_ini_grp;

        lea r10, [rip + _tiling_floating_ovr_bits];
        xor rcx, rcx;
      tf_ini_ovr_bits:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  tf_ini_ovr_bits;

        lea r10, [rip + _tiling_floating_grp_bits];
        xor rcx, rcx;
      tf_ini_grp_bits:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  tf_ini_grp_bits;

        lea r10, [rip + _tiling_floating_stats];
        xor rcx, rcx;
      tf_ini_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  tf_ini_stats;
        ret
      }
    }
}
