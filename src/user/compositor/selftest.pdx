// src/user/compositor/selftest.pdx -- Wave β β-01 (paideia-os compositor
// QEMU bring-up)
//
// Minimal compositor-module self-check test-runner. Per design/testing/
// compositor-qemu-smoke-plan.md §4 (SSS-01 / COMP-QM-01), this is the
// "kernel-only... module self-checks... no daemon dependency" fixture
// that doc calls the ONE compositor smoke that is near-term feasible
// without a svc-compositor/svc-wm daemon (both still zero-source, G1/G2
// unresolved). It is a standalone user ELF -- own linker script
// (compositor_selftest.ld), own tools/build-user.sh object set -- that
// calls ONE real exported function from the existing src/user/
// compositor/*.pdx library, buffer_age_rights_valid (buffer_age.pdx,
// Wave0-B10-05 #2295), to prove genuine cross-object linkage against
// the compositor module tree rather than a fabricated always-true
// check. Emits the "COMP INIT OK" fingerprint that
// tools/boot/compositor-smokes/expected-boot_r113_compositor.txt
// already pins (frozen ahead of this landing).
//
// Why only ONE compositor sibling (buffer_age.pdx), not all 30:
// tools/build-user.sh's paideia-os #2344 fix deliberately excludes
// src/user/compositor/* from shell.elf/init.elf linkage -- pulling in
// all 30 files' rodata tables previously ballooned shell.elf past the
// tmpfs 64 KiB per-file cap. This file's own dedicated object set
// (selftest.o + buffer_age.o only) keeps that discipline intact: it
// links the smallest slice of the compositor tree that lets a real
// `call` into compositor code prove the wiring, not the whole tree.
//
// Self-contained: inlines its two SC+ syscalls (write=1, exit=60)
// directly, matching true.pdx / child_hello.pdx's discipline -- no
// syscall_shim dependency, no collision with init.elf / shell.elf
// object sets.

module Selftest = structure {
  // "COMP INIT OK\n" -- 13 wire bytes + NUL = 14 bytes storage.
  pub let msg_ok : [u8; 14] = "COMP INIT OK\n\0"
  pub let msg_ok_len : u64 = 13

  // "COMP INIT FAIL\n" -- 15 wire bytes + NUL = 16 bytes storage.
  // Fires only if buffer_age_rights_valid ever stops returning 1 for
  // an exact-R_BA_ALL argument -- an honest failure signal, never
  // expected to appear on a healthy boot.
  pub let msg_fail : [u8; 16] = "COMP INIT FAIL\n\0"
  pub let msg_fail_len : u64 = 15

  // _start -- user program entry point.
  pub let _start : () -> () !{mem, sysreg} @{fs, sched} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {fs, sched},
      justification: "Wave β β-01: calls buffer_age_rights_valid(0x3F9) -- 0x3F9 is R_BA_ALL, buffer_age.pdx's own full-rights mask -- which that function (`!{} @{}`, pure) is defined to return 1 for on an exact-subset match (rax = rdi & 0x3F9 == rdi). A real cross-object `call` (linker-resolved into buffer_age.o, mirroring ls.pdx's `call sys_getdents` into libc/getdents.o) is the mechanism that proves genuine compositor-module linkage rather than a hardcoded always-true branch. Initial process entry has rsp%16==0 per this tree's existing _start convention (true.pdx/child_hello.pdx/init.pdx all issue their first `call` with no preceding stack use), so the `call buffer_age_rights_valid` site needs no alignment padding. On rax==1, emits msg_ok via sys_write(1, &msg_ok, 13) (SC+ ID 1) then sys_exit(0) (SC+ ID 60); on any other rax, emits msg_fail(15) then sys_exit(1). Effects/capabilities are the union of sys_write's {mem,sysreg}@{fs} and sys_exit's {sysreg}@{sched} per the SC+ shim declarations (matching true.pdx's own declared union) -- buffer_age_rights_valid itself is `!{} @{}` and contributes nothing further. Reserved labels: prefixed cst_.",
      block: {
        mov rdi, 0x3F9;
        call buffer_age_rights_valid;
        cmp rax, 1;
        jne cst_fail;

        lea rsi, [rip + msg_ok];
        mov rdx, 13;
        mov rdi, 1;
        mov rax, 1;
        syscall;

        mov rdi, 0;
        mov rax, 60;
        syscall;
        hlt;

      cst_fail:
        lea rsi, [rip + msg_fail];
        mov rdx, 15;
        mov rdi, 1;
        mov rax, 1;
        syscall;

        mov rdi, 1;
        mov rax, 60;
        syscall;
        hlt
      }
    }
}
