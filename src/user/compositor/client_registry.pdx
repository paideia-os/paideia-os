// src/user/compositor/client_registry.pdx -- R113.M6-027 (paideia-os #2407)
//
// compositor_register_client(app_id, caps) -- the client-side entry a
// desktop-shell process (postui-desktop, src/user/postui-desktop/entry.pdx)
// calls once at startup to announce itself to svc-compositor before it
// asks for a surface.
//
// PLACEMENT NOTE (deviation from the issue text). #2407 asks for this API
// "in src/kernel/compositor/*.pdx". That path does not exist and has never
// existed in this tree: the compositor is a USERSPACE server living under
// src/user/compositor/ (surface_commit.pdx, xdg_shell_states.pdx,
// recovery_plane_reserve.pdx, ...) that talks to the kernel only through
// the KIND_SURFACE / KIND_HW / KIND_DEVICE capability surface in
// src/kernel/core/{cap,graphics}/. Registering a client is a
// compositor-policy decision (which app_ids exist, what caps they were
// granted), not a kernel primitive, so it belongs beside the rest of the
// compositor's own bookkeeping (layer_tree.pdx, workspace_session.pdx) --
// not in ring 0. This file lands it there instead of inventing a
// non-existent kernel subtree.
//
// LIFECYCLE-SKELETON SCOPE (matches src/user/input_server/main.pdx's own
// posture). Today this is same-address-space bookkeeping: a small fixed
// table of (app_id, caps) rows. It is NOT yet wired to a real IPC
// endpoint -- postui-desktop and svc-compositor are not split into two
// separately-scheduled processes yet (build-user.sh does not link either
// compositor/* or postui-desktop/* into a running binary today; see the
// tools/build-user.sh exclusion list). Once process separation lands, the
// real wire is: postui-desktop mints/holds a KIND_IPC_ENDPOINT to
// svc-compositor's registered service name, and compositor_register_client
// becomes a thin marshaller over cap_invoke_dispatch's KIND_IPC_ENDPOINT
// OP_SEND (src/kernel/core/cap/invoke.pdx call_kind_ipc), the same
// substrate KIND_SURFACE itself derives over. No kernel change is needed
// to make that transition -- KIND_IPC_ENDPOINT already exists and is
// already dispatched.
//
// CAPS ENCODING. `caps` is an opaque u64 bitmask the caller chooses; this
// landing does not interpret it (no bit assignment has been ratified yet).
// It is stored verbatim and returned by compositor_client_caps so a
// follow-up (surface-handoff gating, per-client compositing policy) has
// somewhere to read it from without re-deriving a wire format.
//
// FAILURE TAXONOMY 0xFFFFE150..0xFFFFE15F -- fresh band, verified free by
// grep across src/**/*.pdx at landing time (adjacent to the
// 0xFFFFE100..0xFFFFE4FF page route_revoke.pdx documented as entirely
// unclaimed at ITS landing time; this file takes the next 16-slot
// sub-band along that same page).

module ClientRegistry = structure {

  // ==========================================================================
  // Section 0  Table shape.
  // ==========================================================================

  pub let CLIENT_REGISTRY_MAX : u64 = 8

  pub let mut _client_app_ids : [u64; 8] = uninit @align(64)
  pub let mut _client_caps    : [u64; 8] = uninit @align(64)
  pub let mut _client_in_use  : [u64; 8] = uninit @align(64)

  // ==========================================================================
  // Section 1  Failure taxonomy.
  // ==========================================================================

  pub let CLIENT_OK               : u64 = 0
  pub let CLIENT_REGISTRY_FULL    : u64 = 0xFFFFE150
  pub let CLIENT_REGISTRY_DUP     : u64 = 0xFFFFE151
  pub let CLIENT_REGISTRY_BAD_ARG : u64 = 0xFFFFE152
  pub let CLIENT_REGISTRY_MISS    : u64 = 0xFFFFFFFFFFFFFFFF

  // ==========================================================================
  // Section 2  client_registry_init() -- clear the table at boot.
  // ==========================================================================

  pub let client_registry_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M6-027 (#2407): zero the three 8-wide row arrays at boot. Mirrors widgets_stats_reset's load-inc-store-free clear loop shape. Labels prefixed cri_.",
      block: {
        lea r10, [rip + _client_app_ids];
        lea r11, [rip + _client_caps];
        lea r9,  [rip + _client_in_use];
        xor rax, rax;
        xor rcx, rcx;
      cri_top:
        mov [r10 + rcx * 8], rax;
        mov [r11 + rcx * 8], rax;
        mov [r9  + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  cri_top;
        ret
      }
    }

  // ==========================================================================
  // Section 3  compositor_register_client(app_id, caps) -> slot | error.
  //
  // Refuses app_id == 0 (CLIENT_REGISTRY_BAD_ARG). Scans for an existing
  // row with the same app_id (CLIENT_REGISTRY_DUP -- a client registers
  // once; a second call is a caller bug, not silently accepted). Otherwise
  // takes the first free slot (in_use == 0) or refuses CLIENT_REGISTRY_FULL
  // once all CLIENT_REGISTRY_MAX rows are taken.
  // ==========================================================================

  pub let compositor_register_client : (u64, u64) -> u64 !{mem} @{} =
    fn (app_id: u64) (caps: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M6-027 (#2407): linear scan for a duplicate app_id, then linear scan for a free slot. app_id stays in rdi and caps stays in rsi for the whole body (never overwritten) rather than being copied to r12/r13 -- this function has no nested CALL, but it IS itself called with a caller-held value in r12 (src/user/postui-desktop/entry.pdx pdx_desktop_init), and r12/r13 are callee-saved per SysV: clobbering them here without a push/pop would silently corrupt that caller's state. Every scratch register used (r8=app_ids base, r9=caps base, r10=in_use base, rcx=scan index, rax=loaded value) is caller-saved, so no push/pop is needed at all -- the cheapest fix, not a workaround. Labels prefixed crc_.",
      block: {
        cmp rdi, 0;
        je  crc_bad_arg;
        lea r8,  [rip + _client_app_ids];
        lea r9,  [rip + _client_caps];
        lea r10, [rip + _client_in_use];

        // Pass 1: refuse a duplicate app_id among in-use rows.
        xor rcx, rcx;
      crc_dup_top:
        cmp rcx, 8;
        jae crc_dup_done;
        mov rax, [r10 + rcx * 8];
        cmp rax, 0;
        je  crc_dup_next;
        mov rax, [r8 + rcx * 8];
        cmp rax, rdi;
        je  crc_dup_hit;
      crc_dup_next:
        add rcx, 1;
        jmp crc_dup_top;
      crc_dup_hit:
        mov rax, 0xFFFFE151;             // CLIENT_REGISTRY_DUP
        ret;
      crc_dup_done:

        // Pass 2: take the first free slot.
        xor rcx, rcx;
      crc_free_top:
        cmp rcx, 8;
        jae crc_full;
        mov rax, [r10 + rcx * 8];
        cmp rax, 0;
        je  crc_take;
        add rcx, 1;
        jmp crc_free_top;
      crc_take:
        mov [r8 + rcx * 8], rdi;
        mov [r9 + rcx * 8], rsi;
        mov rax, 1;
        mov [r10 + rcx * 8], rax;
        mov rax, rcx;                    // return the slot index
        ret;
      crc_full:
        mov rax, 0xFFFFE150;             // CLIENT_REGISTRY_FULL
        ret;
      crc_bad_arg:
        mov rax, 0xFFFFE152;             // CLIENT_REGISTRY_BAD_ARG
        ret
      }
    }

  // ==========================================================================
  // Section 4  compositor_client_caps(app_id) -> caps bitmask, or
  // CLIENT_REGISTRY_MISS (all-ones) if app_id has no registered row.
  // ==========================================================================

  pub let compositor_client_caps : (u64) -> u64 !{mem} @{} =
    fn (app_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M6-027 (#2407): linear lookup of a registered client's caps bitmask. app_id stays in rdi (never copied to a callee-saved register -- see compositor_register_client's justification for why that matters). Labels prefixed ccc_.",
      block: {
        cmp rdi, 0;
        je  ccc_miss;
        lea r8,  [rip + _client_app_ids];
        lea r9,  [rip + _client_caps];
        lea r10, [rip + _client_in_use];
        xor rcx, rcx;
      ccc_top:
        cmp rcx, 8;
        jae ccc_miss;
        mov rax, [r10 + rcx * 8];
        cmp rax, 0;
        je  ccc_next;
        mov rax, [r8 + rcx * 8];
        cmp rax, rdi;
        je  ccc_hit;
      ccc_next:
        add rcx, 1;
        jmp ccc_top;
      ccc_hit:
        mov rax, [r9 + rcx * 8];
        ret;
      ccc_miss:
        mov rax, 0xFFFFFFFFFFFFFFFF;     // CLIENT_REGISTRY_MISS
        ret
      }
    }
}
