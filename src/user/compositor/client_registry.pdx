// src/user/compositor/client_registry.pdx -- R113.M6-027 (paideia-os #2407)
//
// compositor_register_client(app_id, caps) -- the client-side entry a
// desktop-shell process (postui-desktop, src/user/postui-desktop/entry.pdx)
// calls once at startup to announce itself to svc-compositor before it
// asks for a surface.
//
// PLACEMENT NOTE (deviation from the issue text). #2407 asks for this API
// "in src/kernel/compositor/*.pdx". That path does not exist and has never
// existed in this tree: the compositor is a USERSPACE server living under
// src/user/compositor/ (surface_commit.pdx, xdg_shell_states.pdx,
// recovery_plane_reserve.pdx, ...) that talks to the kernel only through
// the KIND_SURFACE / KIND_HW / KIND_DEVICE capability surface in
// src/kernel/core/{cap,graphics}/. Registering a client is a
// compositor-policy decision (which app_ids exist, what caps they were
// granted), not a kernel primitive, so it belongs beside the rest of the
// compositor's own bookkeeping (layer_tree.pdx, workspace_session.pdx) --
// not in ring 0. This file lands it there instead of inventing a
// non-existent kernel subtree.
//
// LIFECYCLE-SKELETON SCOPE (matches src/user/input_server/main.pdx's own
// posture). Today this is same-address-space bookkeeping: a small fixed
// table of (app_id, caps) rows. It is NOT yet wired to a real IPC
// endpoint -- postui-desktop and svc-compositor are not split into two
// separately-scheduled processes yet (build-user.sh does not link either
// compositor/* or postui-desktop/* into a running binary today; see the
// tools/build-user.sh exclusion list). Once process separation lands, the
// real wire is: postui-desktop mints/holds a KIND_IPC_ENDPOINT to
// svc-compositor's registered service name, and compositor_register_client
// becomes a thin marshaller over cap_invoke_dispatch's KIND_IPC_ENDPOINT
// OP_SEND (src/kernel/core/cap/invoke.pdx call_kind_ipc), the same
// substrate KIND_SURFACE itself derives over. No kernel change is needed
// to make that transition -- KIND_IPC_ENDPOINT already exists and is
// already dispatched.
//
// CAPS ENCODING. `caps` is an opaque u64 bitmask the caller chooses; this
// landing does not interpret it (no bit assignment has been ratified yet).
// It is stored verbatim and returned by compositor_client_caps so a
// follow-up (surface-handoff gating, per-client compositing policy) has
// somewhere to read it from without re-deriving a wire format.
//
// FAILURE TAXONOMY 0xFFFFE150..0xFFFFE15F -- fresh band, verified free by
// grep across src/**/*.pdx at landing time (adjacent to the
// 0xFFFFE100..0xFFFFE4FF page route_revoke.pdx documented as entirely
// unclaimed at ITS landing time; this file takes the next 16-slot
// sub-band along that same page).
//
// COMP-IMPL-05 (paideia-os compositor-impl-backtrack wave, design/
// kernel/compositor-impl-backtrack.md): widened CLIENT_REGISTRY_MAX
// from 8 to 32 rows and added a fourth parallel array, _client_
// endpoint_ids, so a row is the full {app_id, caps, endpoint_id}
// triple the wave's target names. endpoint_id defaults to
// CLIENT_NO_ENDPOINT (0) at registration -- the KIND_IPC_ENDPOINT
// wire this column anticipates (see the module header's "becomes a
// thin marshaller over cap_invoke_dispatch's KIND_IPC_ENDPOINT
// OP_SEND" note) is a follow-on landing once postui-desktop and svc-
// compositor split into separate processes; compositor_client_set_
// endpoint / compositor_client_endpoint are the accessor pair that
// landing will use, added here so the column is load-bearing rather
// than a placeholder. compositor_register_client's own two-argument
// signature (app_id, caps) is UNCHANGED -- its sole caller (src/user/
// postui-desktop/entry.pdx pdx_desktop_init) is preserved verbatim.
// FULL still returns CLIENT_REGISTRY_FULL (0xFFFFE150), not a POSIX
// -EBUSY: every other refusal in this file (DUP, BAD_ARG) already
// uses this same high-sentinel taxonomy for a same-address-space
// bookkeeping structure, and switching FULL alone to a negative
// errno would split one function's return convention in two for no
// consumer-visible benefit (postui-desktop's own call site above
// stores the raw result verbatim without interpreting it).

module ClientRegistry = structure {

  // ==========================================================================
  // Section 0  Table shape.
  // ==========================================================================

  pub let CLIENT_REGISTRY_MAX : u64 = 32

  pub let mut _client_app_ids      : [u64; 32] = uninit @align(64)
  pub let mut _client_caps         : [u64; 32] = uninit @align(64)
  pub let mut _client_in_use       : [u64; 32] = uninit @align(64)
  pub let mut _client_endpoint_ids : [u64; 32] = uninit @align(64)

  // ==========================================================================
  // Section 1  Failure taxonomy.
  // ==========================================================================

  pub let CLIENT_OK               : u64 = 0
  pub let CLIENT_REGISTRY_FULL    : u64 = 0xFFFFE150
  pub let CLIENT_REGISTRY_DUP     : u64 = 0xFFFFE151
  pub let CLIENT_REGISTRY_BAD_ARG : u64 = 0xFFFFE152
  pub let CLIENT_REGISTRY_MISS    : u64 = 0xFFFFFFFFFFFFFFFF
  pub let CLIENT_NO_ENDPOINT      : u64 = 0

  // ==========================================================================
  // Section 2  client_registry_init() -- clear the table at boot.
  // ==========================================================================

  pub let client_registry_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M6-027 (#2407) + COMP-IMPL-05 (32-slot / endpoint_id widening): zero the four 32-wide row arrays at boot. Mirrors widgets_stats_reset's load-inc-store-free clear loop shape. Labels prefixed cri_.",
      block: {
        lea r10, [rip + _client_app_ids];
        lea r11, [rip + _client_caps];
        lea r9,  [rip + _client_in_use];
        lea r8,  [rip + _client_endpoint_ids];
        xor rax, rax;
        xor rcx, rcx;
      cri_top:
        mov [r10 + rcx * 8], rax;
        mov [r11 + rcx * 8], rax;
        mov [r9  + rcx * 8], rax;
        mov [r8  + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  cri_top;
        ret
      }
    }

  // ==========================================================================
  // Section 3  compositor_register_client(app_id, caps) -> slot | error.
  //
  // Refuses app_id == 0 (CLIENT_REGISTRY_BAD_ARG). Scans for an existing
  // row with the same app_id (CLIENT_REGISTRY_DUP -- a client registers
  // once; a second call is a caller bug, not silently accepted). Otherwise
  // takes the first free slot (in_use == 0) or refuses CLIENT_REGISTRY_FULL
  // once all CLIENT_REGISTRY_MAX rows are taken.
  // ==========================================================================

  pub let compositor_register_client : (u64, u64) -> u64 !{mem} @{} =
    fn (app_id: u64) (caps: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M6-027 (#2407) + COMP-IMPL-05 (32-slot / endpoint_id widening): linear scan for a duplicate app_id, then linear scan for a free slot. app_id stays in rdi and caps stays in rsi for the whole body (never overwritten) rather than being copied to r12/r13 -- this function has no nested CALL, but it IS itself called with a caller-held value in r12 (src/user/postui-desktop/entry.pdx pdx_desktop_init), and r12/r13 are callee-saved per SysV: clobbering them here without a push/pop would silently corrupt that caller's state. Every scratch register used (r8=app_ids base, r9=caps base, r10=in_use base, r11=endpoint_ids base, rcx=scan index, rax=loaded value) is caller-saved, so no push/pop is needed at all -- the cheapest fix, not a workaround. A freshly-claimed row's endpoint_id is stamped CLIENT_NO_ENDPOINT (0) at claim time so a reader never sees uninitialised .bss before the follow-on KIND_IPC_ENDPOINT wire lands. Labels prefixed crc_.",
      block: {
        cmp rdi, 0;
        je  crc_bad_arg;
        lea r8,  [rip + _client_app_ids];
        lea r9,  [rip + _client_caps];
        lea r10, [rip + _client_in_use];
        lea r11, [rip + _client_endpoint_ids];

        // Pass 1: refuse a duplicate app_id among in-use rows.
        xor rcx, rcx;
      crc_dup_top:
        cmp rcx, 32;
        jae crc_dup_done;
        mov rax, [r10 + rcx * 8];
        cmp rax, 0;
        je  crc_dup_next;
        mov rax, [r8 + rcx * 8];
        cmp rax, rdi;
        je  crc_dup_hit;
      crc_dup_next:
        add rcx, 1;
        jmp crc_dup_top;
      crc_dup_hit:
        mov rax, 0xFFFFE151;             // CLIENT_REGISTRY_DUP
        ret;
      crc_dup_done:

        // Pass 2: take the first free slot.
        xor rcx, rcx;
      crc_free_top:
        cmp rcx, 32;
        jae crc_full;
        mov rax, [r10 + rcx * 8];
        cmp rax, 0;
        je  crc_take;
        add rcx, 1;
        jmp crc_free_top;
      crc_take:
        mov [r8 + rcx * 8], rdi;
        mov [r9 + rcx * 8], rsi;
        mov rax, 1;
        mov [r10 + rcx * 8], rax;
        xor rax, rax;
        mov [r11 + rcx * 8], rax;        // endpoint_id = CLIENT_NO_ENDPOINT
        mov rax, rcx;                    // return the slot index
        ret;
      crc_full:
        mov rax, 0xFFFFE150;             // CLIENT_REGISTRY_FULL
        ret;
      crc_bad_arg:
        mov rax, 0xFFFFE152;             // CLIENT_REGISTRY_BAD_ARG
        ret
      }
    }

  // ==========================================================================
  // Section 4  compositor_client_caps(app_id) -> caps bitmask, or
  // CLIENT_REGISTRY_MISS (all-ones) if app_id has no registered row.
  // ==========================================================================

  pub let compositor_client_caps : (u64) -> u64 !{mem} @{} =
    fn (app_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M6-027 (#2407): linear lookup of a registered client's caps bitmask. app_id stays in rdi (never copied to a callee-saved register -- see compositor_register_client's justification for why that matters). Labels prefixed ccc_.",
      block: {
        cmp rdi, 0;
        je  ccc_miss;
        lea r8,  [rip + _client_app_ids];
        lea r9,  [rip + _client_caps];
        lea r10, [rip + _client_in_use];
        xor rcx, rcx;
      ccc_top:
        cmp rcx, 32;
        jae ccc_miss;
        mov rax, [r10 + rcx * 8];
        cmp rax, 0;
        je  ccc_next;
        mov rax, [r8 + rcx * 8];
        cmp rax, rdi;
        je  ccc_hit;
      ccc_next:
        add rcx, 1;
        jmp ccc_top;
      ccc_hit:
        mov rax, [r9 + rcx * 8];
        ret;
      ccc_miss:
        mov rax, 0xFFFFFFFFFFFFFFFF;     // CLIENT_REGISTRY_MISS
        ret
      }
    }

  // ==========================================================================
  // Section 5  compositor_client_endpoint(app_id) -> endpoint_id, or
  // CLIENT_REGISTRY_MISS (all-ones) if app_id has no registered row.
  //
  // COMP-IMPL-05: mirrors compositor_client_caps byte-for-byte over the
  // fourth column (_client_endpoint_ids). See the module header note
  // on the KIND_IPC_ENDPOINT wire this column anticipates.
  // ==========================================================================

  pub let compositor_client_endpoint : (u64) -> u64 !{mem} @{} =
    fn (app_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "COMP-IMPL-05: linear lookup of a registered client's endpoint_id column, mirroring compositor_client_caps byte-for-byte (same scan shape, same registers) with the read column swapped to _client_endpoint_ids. app_id stays in rdi. Labels prefixed cce_.",
      block: {
        cmp rdi, 0;
        je  cce_miss;
        lea r8,  [rip + _client_app_ids];
        lea r9,  [rip + _client_endpoint_ids];
        lea r10, [rip + _client_in_use];
        xor rcx, rcx;
      cce_top:
        cmp rcx, 32;
        jae cce_miss;
        mov rax, [r10 + rcx * 8];
        cmp rax, 0;
        je  cce_next;
        mov rax, [r8 + rcx * 8];
        cmp rax, rdi;
        je  cce_hit;
      cce_next:
        add rcx, 1;
        jmp cce_top;
      cce_hit:
        mov rax, [r9 + rcx * 8];
        ret;
      cce_miss:
        mov rax, 0xFFFFFFFFFFFFFFFF;     // CLIENT_REGISTRY_MISS
        ret
      }
    }

  // ==========================================================================
  // Section 6  compositor_client_set_endpoint(app_id, endpoint_id) -> 0
  // (CLIENT_OK) on success, or CLIENT_REGISTRY_MISS (all-ones) if app_id
  // has no registered row.
  //
  // COMP-IMPL-05: the setter half of the endpoint_id column, for the
  // follow-on landing that mints a KIND_IPC_ENDPOINT to svc-compositor
  // once postui-desktop and svc-compositor split into separate
  // processes (see the module header note).
  // ==========================================================================

  pub let compositor_client_set_endpoint : (u64, u64) -> u64 !{mem} @{} =
    fn (app_id: u64) (endpoint_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "COMP-IMPL-05: linear lookup by app_id (identical scan shape to compositor_client_caps / compositor_client_endpoint), then a single store of endpoint_id into the matched row's _client_endpoint_ids slot. app_id stays in rdi and endpoint_id stays in rsi for the whole body (never overwritten). Labels prefixed cse_.",
      block: {
        cmp rdi, 0;
        je  cse_miss;
        lea r8,  [rip + _client_app_ids];
        lea r9,  [rip + _client_endpoint_ids];
        lea r10, [rip + _client_in_use];
        xor rcx, rcx;
      cse_top:
        cmp rcx, 32;
        jae cse_miss;
        mov rax, [r10 + rcx * 8];
        cmp rax, 0;
        je  cse_next;
        mov rax, [r8 + rcx * 8];
        cmp rax, rdi;
        je  cse_hit;
      cse_next:
        add rcx, 1;
        jmp cse_top;
      cse_hit:
        mov [r9 + rcx * 8], rsi;
        xor rax, rax;                    // CLIENT_OK
        ret;
      cse_miss:
        mov rax, 0xFFFFFFFFFFFFFFFF;     // CLIENT_REGISTRY_MISS
        ret
      }
    }

  // ==========================================================================
  // Section 7  subsurface_child_commit_notify(child_kind_id) -> ().
  //
  // Wave η η-03: the compositor-side notify entry point that
  // subsurface_sync.pdx's subsurface_parent_commit invokes for each
  // sync-mode subsurface child of a committed parent. This landing
  // provides a MINIMAL bookkeeping body: bump a monotone per-slot
  // notify counter keyed by (child_kind_id % CLIENT_REGISTRY_MAX(32)).
  // A future landing wires the real semantics -- flip the child's
  // pending-commit flag, enqueue a compositor OP that folds the child's
  // pending buffer into the parent's atomic commit, invoke the client-
  // registry KIND_IPC_ENDPOINT to deliver a frame notification, etc.
  // The counter is data-side observability so the harness (and the
  // subsurface_sync walker's fingerprint) can prove the notify path
  // actually fired without depending on the full commit-fold machinery.
  //
  // Rationale for the location: subsurface_sync.pdx documents its own
  // parent-commit walk shape ("for each edge in parent.edges: if is_
  // sync: fold child pending state into this atomic commit"). The fold
  // step lives in the compositor's client-registry-facing surface (this
  // module), not in subsurface_sync itself, so the extern named by the
  // Wave η dispatch belongs here. Bumping the per-child counter uses
  // the existing _client_in_use base pointer purely for its address
  // (no reads or writes of the client rows themselves), so no schema
  // change is needed on the client registry to receive the notify.
  // ==========================================================================

  pub let mut _subsurface_notify_counter : [u64; 32] = uninit @align(64)

  pub let subsurface_child_commit_notify : (u64) -> () !{mem} @{} =
    fn (child_kind_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave η η-03: bookkeeping-only body for the subsurface-child commit notify path. Bumps _subsurface_notify_counter[child_kind_id % 32] via load-inc-store (no `add reg,[mem]`) so the follow-on fold/wire landing has a proven notify entry point to hang policy off. Leaf; no callee-save discipline. Labels prefixed sccn_.",
      block: {
        // slot = child_kind_id AND 31.
        mov rax, rdi;
        mov r10, 31;
        and rax, r10;
        mov rcx, rax;
        lea r10, [rip + _subsurface_notify_counter];
        mov rax, [r10 + rcx * 8];
        add rax, 1;
        mov [r10 + rcx * 8], rax;
        ret
      }
    }

  // subsurface_child_commit_notify_count(slot) -- read-side accessor
  // for the notify counter. OOB slot -> 0.
  pub let subsurface_child_commit_notify_count : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave η η-03: read _subsurface_notify_counter[slot] with a bounds check (slot < 32). Leaf. Labels prefixed sccn_r_.",
      block: {
        cmp rdi, 32;
        jae sccn_r_zero;
        lea r10, [rip + _subsurface_notify_counter];
        mov rax, [r10 + rdi * 8];
        ret;
      sccn_r_zero:
        xor rax, rax;
        ret
      }
    }
}
