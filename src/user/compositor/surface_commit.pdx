// src/user/compositor/surface_commit.pdx -- G7-M2-002 (paideia-os #2248)
//
// KIND_SURFACE_COMMIT = 0x1B9, derived over KIND_SURFACE (0x1B8).
// LINEAR cap: no R_MINT bit; consumed at commit flush.
//
// Design authority: design/compositor/pwp-spec-vocabulary.md §2.2
// (KEYSTONE, Wave-0 Batch-1). This is the wire-level counterpart of
// KIND_MODESET_TXN at the display layer -- one atomic-commit
// transaction against a KIND_SURFACE. The client accumulates pending
// state (buffer attach with a timeline (id, value) waitpoint,
// geometry updates, damage region, subsurface transform / reparent)
// on the cap; the compositor consumes the cap at commit, atomically
// transitions the surface state at the timeline value the buffer
// waits on, and issues a fresh KIND_PRESENT_FEEDBACK when the frame
// reaches scanout. Linearity here forecloses double-commit and torn
// frames -- the P1 mitigation (no implicit sync) at compositor scope.
//
// PARALLEL LANDING NOTE. B6-01 (G7-M2-001, paideia-os #2246) is
// writing `src/user/compositor/surface_kind.pdx` concurrently. That
// file will define KIND_SURFACE at 0x1B8 and export it as a module
// symbol. This file references `KIND_SURFACE` as an EXTERNAL name
// (via the SurfaceKind module) rather than inlining the ordinal, so
// the ordinal choice remains authoritative at that landing; if
// B6-01 lands at a different slot the parent-slot constant here MUST
// track it and the derived-kinds registry MUST be reconciled at
// batch close.
//
// SLOT ALLOCATION. 0x1B9 is the next free derived-kind tag past the
// G6 wave (KIND_HDR_METADATA=0x1B5, KIND_TONEMAP_LUT=0x1B6,
// KIND_REFERENCE_DISPLAY=0x1B7 already landed under src/user/color/)
// and the parallel B6-01 landing at 0x1B8. Verified free by
// grep over src/kernel/core/cap/*.pdx and src/user/**/*.pdx as of
// this landing. Main should advance the "Next free derived-kind tag"
// line in design/architecture/next-wave-derived-kinds.md to 0x1BA
// at batch close, and reserve 0x1B8/0x1B9 to KIND_SURFACE /
// KIND_SURFACE_COMMIT respectively.
//
// LINEARITY DISCIPLINE (P1 mitigation).
//
//   * NO R_MINT bit is declared on this kind. A KIND_SURFACE_COMMIT
//     is minted BY the KIND_SURFACE authority (that parent holds
//     R_MINT on this derived family) and never by a client. Once
//     minted, the cap is held by exactly one client at exactly one
//     moment; the compositor's cap-table dispatch enforces the
//     no-clone contract at the kernel boundary (single-owner slot).
//
//   * Consume-on-flush contract: SEQ_FLUSH atomically stamps the
//     `flushed` bit in the row header, deducts the row from the pool
//     (row goes back to the free list), and hands the (pending-state,
//     timeline waitpoint) tuple to the surface-side apply gate.
//     ONE FLUSH PER MINT. A second flush attempt against a
//     already-flushed row returns SURFACE_COMMIT_ALREADY_FLUSHED;
//     a query op against an already-flushed row returns
//     SURFACE_COMMIT_STALE. The row is not reusable -- a fresh
//     transaction requires a fresh mint against KIND_SURFACE.
//
//   * The four accumulator rights (ATTACH_BUFFER, SET_GEOMETRY,
//     DAMAGE, TRANSFORM) mutate pending-state fields IN PLACE on the
//     row; they do not clone the cap and do not defer their edit.
//     SEQ_FLUSH is the atomic-batch boundary -- everything the client
//     accumulated becomes visible on the surface AT ONCE, not in the
//     order of the accumulator ops. This is the atomic-batch shape
//     the KEYSTONE §2.2 pins.
//
//   * The compositor is the ONLY authority allowed to observe or
//     revoke a KIND_SURFACE_COMMIT row: R_SURFACE_COMMIT_OBSERVE is
//     compositor-held, R_SURFACE_COMMIT_REVOKE is compositor-held.
//     A client that leaks its cap by process death is cleaned up by
//     the surface-side revoke path (a cap held by a dead client is
//     recovered when its cap table is torn down; the row's flushed
//     bit stays 0 and the row goes back to the free list).
//
// FINGERPRINT. One legacy-suffixed mint fingerprint per the standard
// klog convention (matches kind_tui_canvas / kind_tls_trust /
// tonemap_kind precedent). Emitted once on successful mint by the
// future substrate; no fingerprint on the accumulator or flush paths.
//
// LABEL PREFIX: `surface_commit_` throughout, sidestepping paideia-as
// reserved-word collisions (`loop`, `if`, `let`, `write`, ...).
//
// MECE SCOPE. Single file under src/user/compositor/. No mod.pdx
// exists in this directory yet; the registry marker
// `; wave0-b6-02: surface_commit` marks this module's slot if main
// decides to add one. This landing touches no other file.
//
// =============================================================================
// SECTION 1 -- KIND ORDINAL + PARENT
// =============================================================================
//
// The parent-slot constant is a FORWARD REFERENCE to the ordinal
// KIND_SURFACE will occupy after B6-01 lands. Kept as a bare
// numeric literal here (not `SurfaceKind.KIND_SURFACE`) to sidestep
// a module-order dependency in the encoder's linker step; the
// coordination point is the derived-kinds registry, which lists
// both ordinals atomically at batch close.

module SurfaceCommit = structure {

  // ==========================================================================
  // SECTION 1.1 -- KIND ORDINAL + LAM-HINT BASE
  // ==========================================================================

  pub let KIND_SURFACE_COMMIT      : u64 = 0x1B9
  pub let KIND_SURFACE_COMMIT_BASE : u64 = 0x1B8   // = KIND_SURFACE (B6-01)

  // ==========================================================================
  // SECTION 1.2 -- RIGHTS
  // ==========================================================================
  //
  // Bit assignments follow the kind_tui_canvas / tonemap_kind style
  // (a sparse map, so the future dispatcher can `test rax, R_*` and
  // branch on the single bit). CRITICALLY: there is NO R_MINT bit.
  // A LINEAR cap does not carry mint rights; the derivation authority
  // (KIND_SURFACE) is the sole minter and the compositor supplies
  // the mint gate.
  //
  //   R_ATTACH_BUFFER  -- accumulator: bind pending (buffer, timeline)
  //   R_SET_GEOMETRY   -- accumulator: bind pending KIND_SURFACE_GEOMETRY
  //   R_DAMAGE         -- accumulator: bind pending KIND_DAMAGE_REGION
  //   R_TRANSFORM      -- accumulator: bind pending transform / reparent
  //   R_SEQ_FLUSH      -- atomic-batch flush: consume cap, apply batch
  //   R_INVOKE         -- read-only queries (metadata / pending inspect)
  //   R_REVOKE         -- compositor-held teardown (client death, etc.)
  //   R_OBSERVE        -- compositor-held debug printer
  //
  // R_ALL is the OR of every declared bit and is the exact right-set
  // the KIND_SURFACE mint gate stamps at derivation time. The client
  // typically holds R_ALL minus R_REVOKE and R_OBSERVE (those stay
  // with the compositor).

  pub let R_SURFACE_COMMIT_ATTACH_BUFFER : u64 = 0x001
  pub let R_SURFACE_COMMIT_SET_GEOMETRY  : u64 = 0x002
  pub let R_SURFACE_COMMIT_DAMAGE        : u64 = 0x004
  pub let R_SURFACE_COMMIT_TRANSFORM     : u64 = 0x008
  pub let R_SURFACE_COMMIT_SEQ_FLUSH     : u64 = 0x010
  pub let R_SURFACE_COMMIT_INVOKE        : u64 = 0x020
  pub let R_SURFACE_COMMIT_REVOKE        : u64 = 0x040
  pub let R_SURFACE_COMMIT_OBSERVE       : u64 = 0x080
  pub let R_SURFACE_COMMIT_ALL           : u64 = 0x0FF

  // The client-visible right-set at mint time: everything except
  // REVOKE + OBSERVE (which stay with the compositor authority).
  pub let R_SURFACE_COMMIT_CLIENT        : u64 = 0x03F

  // ==========================================================================
  // SECTION 1.3 -- ROW LAYOUT (atomic_commit_batch, 64 bytes)
  // ==========================================================================
  //
  // One cache line per row (kind_tui_canvas / tonemap_kind precedent).
  // This IS the atomic_commit_batch struct the KEYSTONE §2.2 names:
  // every accumulator op edits ONE field in this row IN PLACE, and
  // SEQ_FLUSH publishes all four field-slots at once to the surface.
  //
  // Row layout (offsets in bytes):
  //
  //   [+0]  header:
  //             in_use[63:56]           1 iff row is allocated
  //             flushed[55:55]          1 iff SEQ_FLUSH has run (linear-consume gate)
  //             pending_mask[54:47]     one bit per accumulator that has run
  //                                     (bit 0 = ATTACH, 1 = GEOMETRY,
  //                                      2 = DAMAGE, 3 = TRANSFORM)
  //             reserved[46:0]          0 at mint; future flags land here
  //
  //   [+8]  commit_id: u64, kernel-assigned monotone token, never 0
  //                    (used by KIND_PRESENT_FEEDBACK to correlate)
  //
  //   [+16] surface_slot: u64, KIND_SURFACE(0x1B8) cap_table slot the
  //                       row was minted against; never rebound
  //
  //   -- atomic_commit_batch pending-state fields (§2.2) --
  //
  //   [+24] buffer_bind_pack:
  //             pending_buffer_slot[63:32]   KIND_VK_SWAPCHAIN_IMAGE
  //                                          / KIND_GPU_BO cap_table slot
  //                                          (0 = no pending buffer)
  //             timeline_id_lo[31:0]         low 32 bits of the
  //                                          KIND_HW_TIMELINE cap slot
  //
  //   [+32] timeline_wait_value: u64, wait value the compositor waits on
  //                              before publishing the buffer (P1: no
  //                              implicit sync -- this pin is mandatory
  //                              when pending_buffer_slot != 0)
  //
  //   [+40] geometry_slot: u64, KIND_SURFACE_GEOMETRY cap_table slot
  //                        (0 = no geometry update pending; else the
  //                        scale-factor + viewport + transform triple
  //                        landed by G7-M2-003)
  //
  //   [+48] damage_slot: u64, KIND_DAMAGE_REGION cap_table slot
  //                      (0 = no damage this commit; else the rect-list
  //                      aggregated per §2.10; a full-surface repaint
  //                      is expressed as a single rect covering the
  //                      viewport, not as a NULL slot)
  //
  //   [+56] transform_pack:
  //             transform_kind[63:56]     TRANSFORM_* enum (identity,
  //                                       rot90, rot180, rot270, flip)
  //             subsurface_reparent[55:0] KIND_SUBSURFACE cap_table
  //                                       slot to reparent under this
  //                                       surface on flush (0 = none)
  //
  // The row is written by exactly one client at a time (LINEAR
  // discipline); no cache-coherence fencing beyond the atomic
  // header stamp SEQ_FLUSH performs, because the accumulator ops
  // and the flush op are serialized by the client's own control flow
  // (a client that fires two accumulator ops in parallel against
  // its own cap has other problems).

  pub let SURFACE_COMMIT_ROW_BYTES : u64 = 64
  pub let SURFACE_COMMIT_MAX       : u64 = 8    // pool ceiling; kind_tui_canvas precedent

  // Offsets into the 64-byte row.
  pub let SURFACE_COMMIT_OFF_HEADER         : u64 = 0
  pub let SURFACE_COMMIT_OFF_COMMIT_ID      : u64 = 8
  pub let SURFACE_COMMIT_OFF_SURFACE_SLOT   : u64 = 16
  pub let SURFACE_COMMIT_OFF_BUFFER_BIND    : u64 = 24
  pub let SURFACE_COMMIT_OFF_TIMELINE_VALUE : u64 = 32
  pub let SURFACE_COMMIT_OFF_GEOMETRY       : u64 = 40
  pub let SURFACE_COMMIT_OFF_DAMAGE         : u64 = 48
  pub let SURFACE_COMMIT_OFF_TRANSFORM      : u64 = 56

  // pending_mask bit positions inside header[54:47]. The dispatcher's
  // idempotency check reads these to detect an accumulator op firing
  // twice against the same row (which is legal -- second write wins --
  // but is logged for the debug printer).
  pub let SURFACE_COMMIT_PMASK_ATTACH    : u64 = 0x01
  pub let SURFACE_COMMIT_PMASK_GEOMETRY  : u64 = 0x02
  pub let SURFACE_COMMIT_PMASK_DAMAGE    : u64 = 0x04
  pub let SURFACE_COMMIT_PMASK_TRANSFORM : u64 = 0x08
  pub let SURFACE_COMMIT_PMASK_ALL       : u64 = 0x0F

  // Header bit positions (in the top byte of the [+0] word).
  //   in_use   = bit 56 of the header word (top of the top byte low bit)
  //   flushed  = bit 55 of the header word (top-byte-adjacent)
  pub let SURFACE_COMMIT_HDR_IN_USE_BIT  : u64 = 56
  pub let SURFACE_COMMIT_HDR_FLUSHED_BIT : u64 = 55
  pub let SURFACE_COMMIT_HDR_PMASK_SHIFT : u64 = 47

  // ==========================================================================
  // SECTION 1.4 -- TRANSFORM ENUM (transform_pack[63:56])
  // ==========================================================================
  //
  // Enumerated per Wayland's `wl_output_transform` catalogue for wire
  // familiarity, but re-numbered as a small dense u64 so the packer
  // can mask-and-shift without a translation table. 0 is the reserved
  // sentinel (a valid commit that does not touch transform leaves
  // transform_kind == TRANSFORM_UNCHANGED, distinct from IDENTITY --
  // IDENTITY is a client asserting "reset to identity", UNCHANGED is
  // "do not touch transform this commit").

  pub let SURFACE_COMMIT_TRANSFORM_UNCHANGED    : u64 = 0
  pub let SURFACE_COMMIT_TRANSFORM_IDENTITY     : u64 = 1
  pub let SURFACE_COMMIT_TRANSFORM_ROT90        : u64 = 2
  pub let SURFACE_COMMIT_TRANSFORM_ROT180       : u64 = 3
  pub let SURFACE_COMMIT_TRANSFORM_ROT270       : u64 = 4
  pub let SURFACE_COMMIT_TRANSFORM_FLIP_H       : u64 = 5
  pub let SURFACE_COMMIT_TRANSFORM_FLIP_V       : u64 = 6
  pub let SURFACE_COMMIT_TRANSFORM_FLIP_ROT90   : u64 = 7
  pub let SURFACE_COMMIT_TRANSFORM_FLIP_ROT270  : u64 = 8
  pub let SURFACE_COMMIT_TRANSFORM_MAX          : u64 = 8

  // ==========================================================================
  // SECTION 1.5 -- OPS
  // ==========================================================================
  //
  // Every op is arity ONE (row_id in target_ptr, sub-op in op_arg[7:0];
  // the accumulator ops carry additional payload in op_arg[63:8]).
  // Dispatch lands in a future kernel-side cap_handler_surface_commit
  // milestone (G7-M2-005). The SEQ_FLUSH op is the LINEAR consume:
  // its handler MUST test-and-set the flushed bit atomically and MUST
  // move the row to the free list before returning.
  //
  //   ATTACH_BUFFER    payload: pending_buffer_slot | timeline_id_lo
  //                    + a follow-up SET_TIMELINE_VALUE op to pin
  //                    the wait value in a small-immediate-friendly
  //                    way (avoids a 64-bit wide payload in one op)
  //   SET_TIMELINE     payload: timeline_wait_value (full u64 in a
  //                    second-word slot the dispatcher reads from
  //                    the caller's arg register)
  //   SET_GEOMETRY     payload: geometry_slot
  //   SET_DAMAGE       payload: damage_slot
  //   SET_TRANSFORM    payload: transform_kind | subsurface_slot
  //   SEQ_FLUSH        payload: none; consumes the cap
  //   QUERY_PENDING    payload: field_id (0=buffer, 1=timeline,
  //                    2=geometry, 3=damage, 4=transform)
  //   QUERY_COMMIT_ID  payload: none
  //   DEBUG_PRINT      payload: none; R_OBSERVE required

  pub let SURFACE_COMMIT_OP_ATTACH_BUFFER  : u64 = 0
  pub let SURFACE_COMMIT_OP_SET_TIMELINE   : u64 = 1
  pub let SURFACE_COMMIT_OP_SET_GEOMETRY   : u64 = 2
  pub let SURFACE_COMMIT_OP_SET_DAMAGE     : u64 = 3
  pub let SURFACE_COMMIT_OP_SET_TRANSFORM  : u64 = 4
  pub let SURFACE_COMMIT_OP_SEQ_FLUSH      : u64 = 5
  pub let SURFACE_COMMIT_OP_QUERY_PENDING  : u64 = 6
  pub let SURFACE_COMMIT_OP_QUERY_COMMIT_ID: u64 = 7
  pub let SURFACE_COMMIT_OP_DEBUG_PRINT    : u64 = 8
  pub let SURFACE_COMMIT_OP_MAX            : u64 = 8

  // Pending-field IDs for the QUERY_PENDING op.
  pub let SURFACE_COMMIT_FIELD_BUFFER     : u64 = 0
  pub let SURFACE_COMMIT_FIELD_TIMELINE   : u64 = 1
  pub let SURFACE_COMMIT_FIELD_GEOMETRY   : u64 = 2
  pub let SURFACE_COMMIT_FIELD_DAMAGE     : u64 = 3
  pub let SURFACE_COMMIT_FIELD_TRANSFORM  : u64 = 4
  pub let SURFACE_COMMIT_FIELD_MAX        : u64 = 4

  // ==========================================================================
  // SECTION 1.6 -- FAILURE TAXONOMY
  // ==========================================================================
  //
  // A fresh 16-wide band: 0xFFFFEA60..0xFFFFEA6F, disjoint from every
  // documented kind band (KIND_TUI_CANVAS 0xFFFFEB10..1F,
  // KIND_TLS_TRUST 0xFFFFEB20..27, KIND_NIC 0xFFFFEB28..2F,
  // KIND_TONEMAP_LUT 0xFFFFEB30..3F, KIND_REFERENCE_DISPLAY
  // 0xFFFFEA50..5F, KIND_HDR_METADATA 0xFFFFEEE1..EF).
  // 0xFFFFEA60..0xFFFFEA6F is verified free by grep over
  // src/kernel/core/cap/*.pdx + src/user/**/*.pdx + tests/**/*.pdx as
  // of this landing.

  pub let SURFACE_COMMIT_OK                : u64 = 0
  pub let SURFACE_COMMIT_TAIL_ENOSPC       : u64 = 0xFFFFEA6F
  pub let SURFACE_COMMIT_TAIL_BAD_ARG      : u64 = 0xFFFFEA6E
  pub let SURFACE_COMMIT_MINT_BAD_PARENT   : u64 = 0xFFFFEA6D
  pub let SURFACE_COMMIT_MINT_BAD_RIGHTS   : u64 = 0xFFFFEA6C
  pub let SURFACE_COMMIT_MINT_BAD_SURFACE  : u64 = 0xFFFFEA6B
  pub let SURFACE_COMMIT_BAD_SLOT          : u64 = 0xFFFFEA6A
  pub let SURFACE_COMMIT_WRONG_KIND        : u64 = 0xFFFFEA69
  pub let SURFACE_COMMIT_BAD_RIGHTS        : u64 = 0xFFFFEA68
  pub let SURFACE_COMMIT_BAD_BUFFER        : u64 = 0xFFFFEA67
  pub let SURFACE_COMMIT_MISSING_TIMELINE  : u64 = 0xFFFFEA66  // buffer bound without timeline pin
  pub let SURFACE_COMMIT_BAD_GEOMETRY      : u64 = 0xFFFFEA65
  pub let SURFACE_COMMIT_BAD_DAMAGE        : u64 = 0xFFFFEA64
  pub let SURFACE_COMMIT_BAD_TRANSFORM     : u64 = 0xFFFFEA63
  pub let SURFACE_COMMIT_ALREADY_FLUSHED   : u64 = 0xFFFFEA62  // linear-consume violation
  pub let SURFACE_COMMIT_STALE             : u64 = 0xFFFFEA61  // query after flush
  pub let SURFACE_COMMIT_REVOKE_ALREADY    : u64 = 0xFFFFEA60
  pub let SURFACE_COMMIT_DECODE_BAD        : u64 = 0xFFFFFFFFFFFFFFFF

  // ==========================================================================
  // SECTION 1.7 -- STATS COUNTER SLOTS
  // ==========================================================================
  //
  // The kernel-side substrate will publish a _surface_commit_stats
  // [u64; 8] table; slot indices are named here so cross-module
  // bumpers agree. FLUSHES vs MINTS lets a boot-log observer verify
  // the LINEAR invariant (MINTS >= FLUSHES; deficit == in-flight
  // commits + client-death recoveries).

  pub let SURFACE_COMMIT_ST_MINTS      : u64 = 0
  pub let SURFACE_COMMIT_ST_FLUSHES    : u64 = 1
  pub let SURFACE_COMMIT_ST_REVOKES    : u64 = 2
  pub let SURFACE_COMMIT_ST_ATTACHES   : u64 = 3
  pub let SURFACE_COMMIT_ST_DAMAGES    : u64 = 4
  pub let SURFACE_COMMIT_ST_REFUSED    : u64 = 5
  pub let SURFACE_COMMIT_ST_DOUBLE     : u64 = 6   // ALREADY_FLUSHED occurrences
  pub let SURFACE_COMMIT_ST_MAX        : u64 = 8

  // ==========================================================================
  // SECTION 1.8 -- FINGERPRINT (one line, legacy-suffixed)
  // ==========================================================================
  //
  // pdx_kind_surface_commit_meta: emitted once on successful mint by
  // the future substrate. The legacy-suffix convention is what
  // tools/verify-fingerprint-coverage.sh enumerates, so this literal
  // is the machine-checkable name of the milestone. No fingerprint on
  // the accumulator, flush, query, or revoke paths.
  pub let pdx_kind_surface_commit_meta : [u8; 56] = "surface commit mint ok [legacy: SURFACE COMMIT MINT OK]\0"

  // Short field-name string constant for future debug-print use
  // (mirrors tmk_k_lut_id / rdk_k_disp_id precedent).
  pub let surface_commit_k_commit_id   : [u8; 10] = "commit_id\0"

  // ==========================================================================
  // SECTION 2 -- PACKERS + VALIDATORS (schema-only, pure leaves)
  // ==========================================================================
  //
  // Every function in this section is a pure, unsafe-bodied leaf with
  // small immediates (no MOVABS r64, imm64 anywhere), returns its
  // result in rax, and clobbers only rax + one scratch register.
  // Encoder-conservative pattern per kind_tls_trust / tonemap_kind.

  // surface_commit_transform_valid(t) -> 1 iff t in [0, TRANSFORM_MAX=8].
  // 0 == UNCHANGED is VALID (the "do not touch transform" sentinel).
  pub let surface_commit_transform_valid : (u64) -> u64 !{} @{} =
    fn (t: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G7-M2-002 (paideia-os #2248): transform enum validator. Admits 0..8 (UNCHANGED, IDENTITY, four rotations, three flip variants). 0 is the reserved 'do not touch' sentinel and is VALID -- a commit that doesn't touch transform stays at UNCHANGED. Small immediate. Labels prefixed surface_commit_tv_.",
      block: {
        cmp rdi, 8;
        ja  surface_commit_tv_no;
        mov rax, 1;
        ret;
      surface_commit_tv_no:
        xor rax, rax;
        ret
      }
    }

  // surface_commit_field_valid(f) -> 1 iff f in [0, FIELD_MAX=4].
  pub let surface_commit_field_valid : (u64) -> u64 !{} @{} =
    fn (f: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G7-M2-002 (paideia-os #2248): QUERY_PENDING field-id validator. Admits 0..4 (buffer, timeline, geometry, damage, transform). Labels prefixed surface_commit_fv_.",
      block: {
        cmp rdi, 4;
        ja  surface_commit_fv_no;
        mov rax, 1;
        ret;
      surface_commit_fv_no:
        xor rax, rax;
        ret
      }
    }

  // surface_commit_op_valid(op) -> 1 iff op in [0, OP_MAX=8].
  pub let surface_commit_op_valid : (u64) -> u64 !{} @{} =
    fn (op: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G7-M2-002 (paideia-os #2248): dispatch op validator. Admits 0..8 (ATTACH_BUFFER..DEBUG_PRINT). Labels prefixed surface_commit_ov_.",
      block: {
        cmp rdi, 8;
        ja  surface_commit_ov_no;
        mov rax, 1;
        ret;
      surface_commit_ov_no:
        xor rax, rax;
        ret
      }
    }

  // surface_commit_buffer_bind_pack(pending_buffer_slot, timeline_id_lo)
  //   -> pending_buffer_slot[63:32] | timeline_id_lo[31:0].
  // Both halves masked to 32 bits so an out-of-range argument cannot
  // smear into a neighbor field. Row-write helper for ATTACH_BUFFER.
  pub let surface_commit_buffer_bind_pack : (u64, u64) -> u64 !{} @{} =
    fn (pending_buffer_slot: u64) (timeline_id_lo: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G7-M2-002 (paideia-os #2248): pack pending_buffer_slot[63:32] | timeline_id_lo[31:0] per row layout at [+24]. Encoder-conservative build of the 32-bit mask via shl+shr to avoid MOVABS r64, 0xFFFFFFFF. Labels prefixed surface_commit_bp_ (none needed, straight-line).",
      block: {
        // rax = timeline_id_lo & 0xFFFFFFFF (via shl 32 / shr 32)
        mov rax, rsi;
        shl rax, 32;
        shr rax, 32;

        // r10 = pending_buffer_slot & 0xFFFFFFFF, shifted left 32
        mov r10, rdi;
        shl r10, 32;
        // shr rax was mask; now r10 already has slot in high 32
        // (the natural shl 32 both masks the high 32 of the input AND
        // places the low 32 in the high half; if slot has bits above
        // its low 32 they are dropped -- the intended masking behavior).
        or  rax, r10;
        ret
      }
    }

  // surface_commit_transform_pack(transform_kind, subsurface_slot)
  //   -> transform_kind[63:56] | subsurface_slot[55:0].
  // subsurface_slot MASKED to 56 bits so a caller with a pathological
  // value cannot smear into the transform field; the mint gate is
  // expected to reject such inputs upstream via SURFACE_COMMIT_BAD_TRANSFORM.
  pub let surface_commit_transform_pack : (u64, u64) -> u64 !{} @{} =
    fn (transform_kind: u64) (subsurface_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G7-M2-002 (paideia-os #2248): pack transform_kind[63:56] | subsurface_slot[55:0] per row layout at [+56]. subsurface_slot masked to 56 bits via shl+shr trick (avoids MOVABS r64, 0x00FFFFFFFFFFFFFF). Labels prefixed surface_commit_xp_ (none needed).",
      block: {
        // r10 = subsurface_slot & 0x00FFFFFFFFFFFFFF (56 bits)
        mov r10, rsi;
        shl r10, 8;
        shr r10, 8;

        mov rax, rdi;                 // transform_kind
        and rax, 0xFF;
        shl rax, 56;
        or  rax, r10;
        ret
      }
    }

  // surface_commit_hdr_pack() -> canonical row header at mint time.
  // Only the substrate's tail_alloc sets in_use (bit 56); flushed
  // (bit 55) and pending_mask (bits 47..54) stay 0 until the client
  // fires its first accumulator op. Mirror of tui_hdr_pack.
  pub let surface_commit_hdr_pack : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "G7-M2-002 (paideia-os #2248): canonical row header at mint time. Only in_use written by tail_alloc; flushed + pending_mask stay 0 until accumulator ops fire. Mirror of tonemap_kind.pdx tmk_hdr_pack. Labels prefixed surface_commit_hp_ (none needed).",
      block: {
        xor rax, rax;
        ret
      }
    }

  // surface_commit_pmask_set(header, bit) -> header with pending_mask
  // bit (0=ATTACH, 1=GEOMETRY, 2=DAMAGE, 3=TRANSFORM) set.
  // Idempotent: a second call with the same bit is a no-op relative
  // to the returned value (the dispatcher may still count the double
  // for SURFACE_COMMIT_ST_DOUBLE-like diagnostics upstream).
  pub let surface_commit_pmask_set : (u64, u64) -> u64 !{} @{} =
    fn (header: u64) (bit: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G7-M2-002 (paideia-os #2248): set one pending_mask bit in the header word at bit position (47 + bit). Small immediate (47 fits in imm8). Bit index masked to low 3 bits so a rogue caller cannot shift into the in_use / flushed neighborhood. Labels prefixed surface_commit_ps_ (none needed, straight-line).",
      block: {
        // r10 = 1 << (47 + (bit & 0x7))
        mov r10, rsi;
        and r10, 7;
        add r10, 47;
        mov rcx, r10;                 // shl needs count in cl
        mov r10, 1;
        shl r10, cl;
        mov rax, rdi;                 // header
        or  rax, r10;
        ret
      }
    }

  // ==========================================================================
  // SECTION 3 -- FLUSH STUB (linear-consume; real handler is kernel-side)
  // ==========================================================================
  //
  // The real SEQ_FLUSH handler lives in the future kernel-side
  // cap_handler_surface_commit milestone (G7-M2-005). That handler
  // MUST:
  //
  //   1. cmpxchg the flushed bit from 0 to 1 in the header word;
  //      on cmpxchg failure return SURFACE_COMMIT_ALREADY_FLUSHED
  //      (the linear-consume enforcement point).
  //   2. read the four pending-state field slots
  //      ([+24]..[+56]) into a register file.
  //   3. hand the tuple to the surface-side apply gate under a
  //      timeline-guarded transition (P1 mitigation -- no compositor
  //      publish until the buffer signals its wait value).
  //   4. return the row to the free list (in_use bit cleared).
  //   5. bump SURFACE_COMMIT_ST_FLUSHES.
  //
  // Until that handler lands, every dispatch of SEQ_FLUSH returns
  // SURFACE_COMMIT_STALE from the stub below so downstream harnesses
  // observe a well-formed refusal rather than a fabricated success.
  //
  // Contract: surface_commit_flush_stub(row_id) -> SURFACE_COMMIT_STALE.

  pub let surface_commit_flush_stub : (u64) -> u64 !{} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G7-M2-002 (paideia-os #2248): SEQ_FLUSH stub. Always returns SURFACE_COMMIT_STALE (0xFFFFEA61) until the kernel-side cap_handler_surface_commit lands at G7-M2-005. Does NOT stamp the flushed bit -- a fabricated flush would defeat the linear-consume invariant this file exists to establish. Small immediate (32-bit sign-safe: 0xFFFFEA61 fits into imm32 and sign-extends to a valid u64 sentinel). Labels prefixed surface_commit_fs_ (none needed, straight-line).",
      block: {
        mov rax, 0xFFFFEA61;
        ret
      }
    }
}
