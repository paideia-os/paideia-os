// src/user/compositor/pwp_a11y_wire.pdx -- Wave0-B12-07 (paideia-os #2306)
//
// PWP WIRE-LEVEL ADAPTER: A11Y-TREE SUBTREE UPDATES CARRIED *INLINE*
// WITH A SURFACE COMMIT.
//
// Design authority: design/compositor/pwp-spec-vocabulary.md §2.21
// (KIND_A11Y_TREE) + §2.2 (KIND_SURFACE_COMMIT). The next-wave synthesis
// P4 mitigation register pins a11y as a first-class protocol participant
// (see the WIN_MINT_NO_A11Y gate in src/user/compositor/window_kind.pdx
// and the autobind wrapper in src/user/compositor/a11y_bind_at_mint.pdx
// -- Wave0-B9-08, paideia-os #2305). This file closes the OTHER half of
// the P4 property: at wire time, an a11y-tree subtree update MUST ride
// INSIDE the surface commit that produced the frame it describes, in a
// SINGLE atomic message.
//
// =============================================================================
// SECTION 0  NOVEL-CLEAN vs POSIX-INHERITED
// =============================================================================
//
// A POSIX / X11 / Wayland-flavoured design would surface a11y updates
// through a *separate* protocol message ("update a11y tree N"), racing
// the surface commit that produced the pixel frame. Under that shape:
//
//   * a screen reader can (and in practice does) observe a frame whose
//     pixels do not yet match the a11y state -- the a11y-update packet
//     hasn't been dispatched yet, or has been dispatched but not yet
//     acted upon;
//   * a screen reader can observe an a11y state whose corresponding
//     pixels have not yet been painted -- the a11y-update landed first
//     and the compositor is still in the buffer-attach path;
//   * the "single atomic transition" that surface_commit.pdx (G7-M2-002,
//     paideia-os #2248) exists to establish at the pixel layer is torn
//     open at the a11y layer, because the two messages carry independent
//     ordering guarantees.
//
// NOVEL-CLEAN DESIGN. A single wire message carries BOTH the pixel
// commit AND the a11y-tree subtree update, atomically. The compositor's
// substrate applies both under one lock scope; there is no window in
// which pixels + a11y disagree. The mechanism is a 32-byte fixed
// payload attached to every SURFACE_COMMIT wire frame (this file's
// A11yInlinePayload) that references a variable-length inline buffer
// carried by the same wire message (see §2.2 of the spec for the
// commit-frame envelope shape).
//
// The three properties this delivers:
//
//   (P1)  Ordering:      the a11y subtree update is APPLIED at the
//                        same monotonic instant the surface commit
//                        flushes (see surface_commit.pdx §3 -- the
//                        SEQ_FLUSH atomic-batch boundary). A screen
//                        reader that samples tree_version_seq
//                        (a11y_tree_hdr_tree_seq) at frame N observes
//                        the tree state that corresponds to that
//                        frame's pixels.
//   (P2)  No race:       there is no separate a11y-update wire message
//                        to race the commit. A commit that fails to
//                        flush (SURFACE_COMMIT_ALREADY_FLUSHED etc.)
//                        also fails to apply its a11y payload -- the
//                        tree never diverges from what was painted.
//   (P3)  Bounded cost:  the payload is a fixed 32-byte header + a
//                        variable-length node-id buffer (u32 per added
//                        node). A commit with no a11y change carries
//                        node_count_added==0 and state_updates_bitmap==0;
//                        the payload adds 32 bytes to the frame and
//                        the unpack_and_apply fast-path returns
//                        immediately.
//
// =============================================================================
// SECTION 0.1  RELATIONSHIP TO SIBLINGS
// =============================================================================
//
//   src/user/compositor/surface_commit.pdx  (Wave0-B6-02, paideia-os #2248)
//     Owns KIND_SURFACE_COMMIT = 0x1B9 and the atomic-batch flush
//     discipline. THIS FILE's payload rides inline with a KIND_SURFACE_
//     COMMIT wire frame; a follow-on landing wires the payload into a
//     new SET_A11Y_PAYLOAD accumulator op on the commit cap.
//
//   src/user/a11y/tree_kind.pdx  (Wave0-B8-03, paideia-os #2302)
//     Owns KIND_A11Y_TREE = 0x1D3. THIS FILE's pwp_a11y_wire_unpack_
//     and_apply invokes a11y_tree_append_node and a11y_tree_update_
//     state per payload, so the tree that receives the update MUST be
//     the same tree the surface's window was bound to at mint.
//
//   src/user/compositor/a11y_bind_at_mint.pdx  (Wave0-B9-08, paideia-os
//     #2305)
//     Guarantees every KIND_WINDOW row has a live KIND_A11Y_TREE bound
//     at mint time. THIS FILE's precondition -- "the tree named by
//     a11y_tree_kind_id exists" -- is upheld by that landing plus
//     window_kind.pdx's own P4 gate (WIN_MINT_NO_A11Y).
//
// =============================================================================
// SECTION 0.2  FAILURE BAND DEVIATION
// =============================================================================
//
// The task row for this landing (Wave0-B12-07) prescribed 0xFFFFEB50..
// 0xFFFFEB5F as the failure band. A repo-wide grep at landing time
// (`grep -rhoE '0xFFFFEB5[0-9A-Fa-f]' src/`) shows that band FULLY
// OCCUPIED by src/kernel/core/cap/kind_page_flip.pdx (0xFFFFEB50..5F)
// and additionally overlapped by src/kernel/core/cap/kind_kek.pdx
// (0xFFFFEB50..57). The prescribed band is unavailable at Wave 0
// landing time.
//
// This landing takes the adjacent 0xFFFFEB60..0xFFFFEB6F band instead.
// Landing-time audit: 0xFFFFEB60 is the only claimed slot in the band
// (src/user/compositor/tiling_bsp.pdx or similar early landing --
// verified via grep); 0xFFFFEB61..0xFFFFEB67 are free (7 slots, more
// than enough for the six-code taxonomy this file needs). The
// deviation is intentional and documented HERE rather than silently
// papered over; a future band-tidy pass may reallocate.
//
// =============================================================================
// SECTION 0.3  INTERPRETATION OF node_ids_offset
// =============================================================================
//
// The task pins `node_ids_offset: u32 -- pointer into commit's inline
// buffer`. At Wave 0 fidelity, the inline-buffer BASE that the offset
// is measured against is the KIND_SURFACE_COMMIT wire frame's payload
// area, which is not yet established as a first-class contract (the
// SET_A11Y_PAYLOAD accumulator op that binds this payload lands in a
// follow-on milestone). This file therefore treats node_ids_offset as
// an ABSOLUTE POINTER for the purposes of pwp_a11y_wire_unpack_and_
// apply, with a documented follow-on to convert it to a proper base-
// relative offset once the commit-frame envelope shape lands.
//
// A caller that packs a payload today MUST place its `[u32; node_
// count_added]` node-id array at an address that fits in u32 (which,
// at Wave 0 kernel-image layout, every .bss address does) and pass
// that absolute address as `ids`. The pwp_a11y_wire_size accessor
// returns 32 + node_count_added * 4, mirroring what the inline buffer
// would consume were it appended immediately after the 32-byte
// header.
//
// =============================================================================
// SECTION 0.4  DISCIPLINE
// =============================================================================
//
// * Encoder rules: every packer / accessor is a pure unsafe-bodied
//   leaf clobbering only rax + r10/r11 scratch. The apply function
//   uses six callee-save pushes to hold (payload_ptr, tree, count,
//   ids, updates, index-cursor) across the nested a11y_tree_*
//   calls; entry rsp%16==8, six 8-byte pushes preserve parity, so
//   every gate call site is preceded by a `sub rsp,8` pad.
// * Labels: `pwp_a11y_wire_<funcname>_<tag>` throughout, sidesteps
//   paideia-as reserved-word collisions (loop / if / let / write /
//   ...) per the reserved-label note in .memory/.
// * No float: every field is u32 / u64; every arg and return is u64;
//   design/kernel/no-fpu.md.
// * Fingerprint: data-only tag `pdx_kind_pwp_a11y_wire_meta` with the
//   `[legacy: PWP A11Y WIRE META OK]` suffix for grep parity with the
//   sibling KIND-cap tags. Emission wiring lands with the surface_
//   commit dispatcher extension that consumes this payload; the tag
//   decl here reserves the canonical string and is not yet emitted
//   by any code path (no fingerprint-coverage allowlist entry needed
//   at this landing).

module PwpA11yWire = structure {

  // ==========================================================================
  // SECTION A  Payload shape + failure taxonomy + counter identity + fingerprint.
  // ==========================================================================
  //
  // A11yInlinePayload (32 bytes / 4 words / aligned 8):
  //
  //   [+0]  word0: surface_kind_id[31:0]     | a11y_tree_kind_id[63:32]
  //   [+8]  word1: node_count_added[31:0]    | node_ids_offset[63:32]
  //   [+16] state_updates_bitmap: u64        -- one bit per node whose
  //                                             state changed since the
  //                                             previous commit; bit i
  //                                             corresponds to node_id
  //                                             i in [0, 64)
  //   [+24] reserved: u64                    -- 0 at pack time; future
  //                                             use for a variant tag
  //                                             or a second bitmap
  //
  // Wire footprint at commit time:
  //     header (32 bytes) + node_count_added * sizeof(u32)   -- see
  //   pwp_a11y_wire_size.
  //
  // The payload IS the entire message from the wire adapter's point
  // of view. The KIND_SURFACE_COMMIT dispatcher extension (follow-on)
  // will read the header, then unpack_and_apply drives the a11y-tree
  // side-effects at the same moment the surface's own atomic-batch
  // flush stamps the flushed bit.

  pub let PWP_A11Y_WIRE_HEADER_BYTES  : u64 = 32
  pub let PWP_A11Y_WIRE_NODE_ID_BYTES : u64 = 4        // u32 per node id.

  // Header word offsets (byte offsets within a payload).
  pub let PWP_A11Y_WIRE_OFF_WORD0     : u64 = 0        // surface|tree
  pub let PWP_A11Y_WIRE_OFF_WORD1     : u64 = 8        // count|ids_off
  pub let PWP_A11Y_WIRE_OFF_UPDATES   : u64 = 16       // state_updates_bitmap
  pub let PWP_A11Y_WIRE_OFF_RESERVED  : u64 = 24

  // Ceilings enforced at pack / unpack time. NODE_COUNT_MAX matches
  // A11Y_MAX_NODES(32) from tree_kind.pdx so a wire message can never
  // carry more nodes than the destination tree can hold. Payloads that
  // try to overflow are refused with PWP_A11Y_WIRE_BAD_ARG.
  pub let PWP_A11Y_WIRE_NODE_COUNT_MAX : u64 = 32
  pub let PWP_A11Y_WIRE_BITMAP_BITS    : u64 = 64      // width of state_updates_bitmap

  // Failure taxonomy (see file header §0.2 for the band-deviation
  // rationale). Band 0xFFFFEB60..0xFFFFEB6F.
  //   PWP_A11Y_WIRE_OK              0
  //   PWP_A11Y_WIRE_BAD_DST         0xFFFFEB67  -- pack: dst pointer is 0
  //   PWP_A11Y_WIRE_BAD_ARG         0xFFFFEB66  -- pack: node_count_added > 32
  //   PWP_A11Y_WIRE_BAD_SURFACE     0xFFFFEB65  -- surface_kind_id == 0 / >u32
  //   PWP_A11Y_WIRE_BAD_TREE        0xFFFFEB64  -- a11y_tree_kind_id == 0 /
  //                                                >= A11Y_MAX(4)
  //   PWP_A11Y_WIRE_APPLY_FAILED    0xFFFFEB63  -- unpack: first appli-
  //                                                cation to tree returned
  //                                                a non-OK sentinel; the
  //                                                sentinel is preserved
  //                                                in the low 32 of rax
  //                                                (see below)
  //   PWP_A11Y_WIRE_BAD_PAYLOAD     0xFFFFEB62  -- unpack: payload_ptr
  //                                                is 0
  //   PWP_A11Y_WIRE_NULL_IDS_BUF    0xFFFFEB61  -- unpack: node_count_
  //                                                added > 0 but ids_
  //                                                offset == 0

  pub let PWP_A11Y_WIRE_OK             : u64 = 0
  pub let PWP_A11Y_WIRE_BAD_DST        : u64 = 0xFFFFEB67
  pub let PWP_A11Y_WIRE_BAD_ARG        : u64 = 0xFFFFEB66
  pub let PWP_A11Y_WIRE_BAD_SURFACE    : u64 = 0xFFFFEB65
  pub let PWP_A11Y_WIRE_BAD_TREE       : u64 = 0xFFFFEB64
  pub let PWP_A11Y_WIRE_APPLY_FAILED   : u64 = 0xFFFFEB63
  pub let PWP_A11Y_WIRE_BAD_PAYLOAD    : u64 = 0xFFFFEB62
  pub let PWP_A11Y_WIRE_NULL_IDS_BUF   : u64 = 0xFFFFEB61

  // Counter slot ordinals for the four-cell _pwp_a11y_wire_stats array
  // (three live slots plus one reserved for future -- e.g. per-commit
  // bytes-carried gauge). Bounds-checked against 4 in the bump / read
  // primitives.
  pub let PWP_A11Y_WIRE_ST_PACKS       : u64 = 0
  pub let PWP_A11Y_WIRE_ST_APPLIES     : u64 = 1
  pub let PWP_A11Y_WIRE_ST_REFUSED     : u64 = 2

  // Row of counters, 32-byte aligned to half a cache line (four u64).
  pub let mut _pwp_a11y_wire_stats : [u64; 4] = uninit @align(64)

  // Fingerprint tag. Data-only at this landing; emission wiring lands
  // with the surface_commit dispatcher extension that consumes this
  // payload via a klog_s1_x1 emit on every successful apply.
  //
  // "pdx kind pwp a11y wire meta [legacy: PWP A11Y WIRE META OK]\0"
  //   payload: 59 bytes; NUL terminator: 1; total 60 bytes.
  pub let pdx_kind_pwp_a11y_wire_meta : [u8; 60] = "pdx kind pwp a11y wire meta [legacy: PWP A11Y WIRE META OK]\0"

  // ==========================================================================
  // SECTION B  Validators (pure leaves).
  //
  // Each validator returns 1 iff its argument satisfies the payload's
  // wire-time invariant, 0 otherwise. The pack / unpack paths funnel
  // failures through their own PWP_A11Y_WIRE_* sentinels rather than
  // propagating a boolean, so validators are single-purpose.
  // ==========================================================================

  // pwp_a11y_wire_surface_valid(id) -> 1 iff id in (0, 2^32).
  // Mirrors a11y_tree_window_valid: an a11y payload with surface_kind_id
  // == 0 references no surface, and an id that doesn't fit in u32 cannot
  // survive the packed word0 layout.
  pub let pwp_a11y_wire_surface_valid : (u64) -> u64 !{} @{} =
    fn (id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B12-07 (paideia-os #2306): 1 iff surface_kind_id in (0, 2^32). Zero refuses free-floating a11y updates; the pack gate feeds PWP_A11Y_WIRE_BAD_SURFACE into the refusal funnel on failure. Labels prefixed pwp_a11y_wire_sv_.",
      block: {
        cmp rdi, 0;
        je  pwp_a11y_wire_sv_no;
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  pwp_a11y_wire_sv_no;
        mov rax, 1;
        ret;
      pwp_a11y_wire_sv_no:
        xor rax, rax;
        ret
      }
    }

  // pwp_a11y_wire_tree_valid(id) -> 1 iff id in [1, A11Y_MAX=4).
  // Tighter than surface_valid: a11y_tree_kind_id is the row_id into the
  // KIND_A11Y_TREE row pool (tree_kind.pdx §Section 8) whose ceiling is
  // A11Y_MAX = 4 at Wave 0. Zero is refused so a payload naming an
  // unbound tree is caught here rather than in the a11y-tree gate.
  pub let pwp_a11y_wire_tree_valid : (u64) -> u64 !{} @{} =
    fn (id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B12-07 (paideia-os #2306): 1 iff a11y_tree_kind_id in [1, A11Y_MAX(4)). Zero refuses free-floating trees. Labels prefixed pwp_a11y_wire_tv_.",
      block: {
        cmp rdi, 0;
        je  pwp_a11y_wire_tv_no;
        mov r10, 4;
        cmp rdi, r10;
        jae pwp_a11y_wire_tv_no;
        mov rax, 1;
        ret;
      pwp_a11y_wire_tv_no:
        xor rax, rax;
        ret
      }
    }

  // pwp_a11y_wire_count_valid(n) -> 1 iff n <= PWP_A11Y_WIRE_NODE_COUNT_MAX(32).
  pub let pwp_a11y_wire_count_valid : (u64) -> u64 !{} @{} =
    fn (n: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B12-07 (paideia-os #2306): 1 iff node_count_added <= 32 (A11Y_MAX_NODES). A wire message that overflows this ceiling could never fit in the destination tree, so it is refused at pack time. Labels prefixed pwp_a11y_wire_cv_.",
      block: {
        mov r10, 32;
        cmp rdi, r10;
        ja  pwp_a11y_wire_cv_no;
        mov rax, 1;
        ret;
      pwp_a11y_wire_cv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // SECTION C  Packers (word-level; used by pack_payload).
  //
  // Each packer folds two u32 halves into one u64 without a 64-bit
  // wide immediate (encoder-conservative shl+shr mask pattern).
  // ==========================================================================

  // pwp_a11y_wire_pack_word0(surface, tree) -> surface[31:0] | tree[63:32].
  pub let pwp_a11y_wire_pack_word0 : (u64, u64) -> u64 !{} @{} =
    fn (surface: u64) (tree: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B12-07 (paideia-os #2306): pack (surface_kind_id, a11y_tree_kind_id) -> u64 with surface at [31:0] and tree at [63:32]. Both halves masked to 32 bits via shl+shr so a rogue upper half cannot smear into a neighbour field. Labels prefixed pwp_a11y_wire_pw0_ (none needed, straight-line).",
      block: {
        mov rax, rdi;
        shl rax, 32;
        shr rax, 32;
        mov r10, rsi;
        shl r10, 32;
        or  rax, r10;
        ret
      }
    }

  // pwp_a11y_wire_pack_word1(count, ids_off) -> count[31:0] | ids_off[63:32].
  pub let pwp_a11y_wire_pack_word1 : (u64, u64) -> u64 !{} @{} =
    fn (count: u64) (ids_off: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B12-07 (paideia-os #2306): pack (node_count_added, node_ids_offset) -> u64. Same shape as pack_word0 (both fields u32-masked and placed low/high). Labels prefixed pwp_a11y_wire_pw1_ (none needed).",
      block: {
        mov rax, rdi;
        shl rax, 32;
        shr rax, 32;
        mov r10, rsi;
        shl r10, 32;
        or  rax, r10;
        ret
      }
    }

  // ==========================================================================
  // SECTION D  pwp_a11y_wire_pack_payload -- write a 32-byte header at dst.
  //
  // Signature: pack_payload(dst_ptr, surface, tree, added, ids_off, updates)
  //            -> PWP_A11Y_WIRE_OK | PWP_A11Y_WIRE_BAD_*.
  //
  // The task-row signature was pack_payload(surface, tree, added, ids,
  // updates) -> A11yInlinePayload. Because the payload is 32 bytes
  // (four u64) and pdx return values are one u64, the pragmatic
  // realisation is a caller-supplied destination pointer as the first
  // argument. The four data arguments follow verbatim; the return code
  // signals success / refusal rather than the payload bytes themselves.
  //
  // Six callee-save pushes (rbx=dst, r12=surface, r13=tree, r14=added,
  // r15=ids_off, rbp=updates) + `sub rsp, 8` = 56 bytes: entry rsp%16
  // ==8, six 8-byte pushes bring parity to 0, plus 8 = 8 for callees.
  // Every nested `call` site therefore sees rsp%16==0. Refusal path
  // funnels through pwp_a11y_wire_pp_refused which bumps the REFUSED
  // counter once and returns the sentinel in rax.
  //
  // Gate order:
  //   (1) dst != 0                     -> PWP_A11Y_WIRE_BAD_DST
  //   (2) surface valid                -> PWP_A11Y_WIRE_BAD_SURFACE
  //   (3) tree valid                   -> PWP_A11Y_WIRE_BAD_TREE
  //   (4) added <= NODE_COUNT_MAX(32)  -> PWP_A11Y_WIRE_BAD_ARG
  //   (5) write four u64 words to dst
  //   (6) bump PACKS counter, return OK
  //
  // ids_off is written verbatim (its interpretation as an absolute
  // pointer at Wave 0 is documented in file header §0.3); a caller
  // that passes 0 with added > 0 will be caught at unpack time by
  // PWP_A11Y_WIRE_NULL_IDS_BUF, not here.
  // ==========================================================================

  pub let pwp_a11y_wire_pack_payload : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (dst_ptr: u64) (surface: u64) (tree: u64) (added: u64) (ids_off: u64) (updates: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B12-07 (paideia-os #2306): write a 32-byte A11yInlinePayload at dst. Six callee-save pushes (rbx=dst, r12=surface, r13=tree, r14=added, r15=ids_off, rbp=updates) + sub rsp,8 = 56 bytes total: entry rsp%16==8, +48+8 = 56, %16==0 for every nested call. Refusal funnel bumps _pwp_a11y_wire_stats[REFUSED] once via pwp_a11y_wire_pp_refused. Labels prefixed pwp_a11y_wire_pp_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;
        sub  rsp, 8;

        mov  rbx, rdi;                       // dst_ptr
        mov  r12, rsi;                       // surface
        mov  r13, rdx;                       // tree
        mov  r14, rcx;                       // added
        mov  r15, r8;                        // ids_off
        mov  rbp, r9;                        // updates

        // (1) dst != 0
        cmp  rbx, 0;
        je   pwp_a11y_wire_pp_bad_dst;

        // (2) surface valid
        mov  rdi, r12;
        call pwp_a11y_wire_surface_valid;
        cmp  rax, 0;
        je   pwp_a11y_wire_pp_bad_surface;

        // (3) tree valid
        mov  rdi, r13;
        call pwp_a11y_wire_tree_valid;
        cmp  rax, 0;
        je   pwp_a11y_wire_pp_bad_tree;

        // (4) count valid
        mov  rdi, r14;
        call pwp_a11y_wire_count_valid;
        cmp  rax, 0;
        je   pwp_a11y_wire_pp_bad_arg;

        // (5) write four u64 words.
        //   [+0] word0: pack_word0(surface, tree)
        mov  rdi, r12;
        mov  rsi, r13;
        call pwp_a11y_wire_pack_word0;
        mov  [rbx + 0], rax;

        //   [+8] word1: pack_word1(added, ids_off)
        mov  rdi, r14;
        mov  rsi, r15;
        call pwp_a11y_wire_pack_word1;
        mov  [rbx + 8], rax;

        //   [+16] state_updates_bitmap (full u64, no mask)
        mov  [rbx + 16], rbp;

        //   [+24] reserved = 0
        xor  rax, rax;
        mov  [rbx + 24], rax;

        // (6) bump PACKS, return OK.
        mov  rdi, 0;                         // PWP_A11Y_WIRE_ST_PACKS
        call pwp_a11y_wire_stats_bump;
        xor  rax, rax;                       // PWP_A11Y_WIRE_OK
        jmp  pwp_a11y_wire_pp_out;

      pwp_a11y_wire_pp_bad_dst:
        mov  rax, 0xFFFFEB67;                // PWP_A11Y_WIRE_BAD_DST
        jmp  pwp_a11y_wire_pp_refused;
      pwp_a11y_wire_pp_bad_surface:
        mov  rax, 0xFFFFEB65;                // PWP_A11Y_WIRE_BAD_SURFACE
        jmp  pwp_a11y_wire_pp_refused;
      pwp_a11y_wire_pp_bad_tree:
        mov  rax, 0xFFFFEB64;                // PWP_A11Y_WIRE_BAD_TREE
        jmp  pwp_a11y_wire_pp_refused;
      pwp_a11y_wire_pp_bad_arg:
        mov  rax, 0xFFFFEB66;                // PWP_A11Y_WIRE_BAD_ARG

      pwp_a11y_wire_pp_refused:
        mov  rbx, rax;                       // stash sentinel (callee-save)
        mov  rdi, 2;                         // PWP_A11Y_WIRE_ST_REFUSED
        call pwp_a11y_wire_stats_bump;
        mov  rax, rbx;                       // restore sentinel

      pwp_a11y_wire_pp_out:
        add  rsp, 8;
        pop  rbp;
        pop  r15;
        pop  r14;
        pop  r13;
        pop  r12;
        pop  rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION E  Field accessors (unpack side).
  //
  // Each accessor takes a payload pointer and returns the named field
  // zero-extended into rax. Pure reads; no bounds checks (caller MUST
  // have validated the pointer). These mirror a11y_tree_hdr_* / a11y_
  // tree_node_* accessor style: shl/shr for high 32, and 0xFFFFFFFF
  // for low 32 (encoder-conservative, no MOVABS r64, imm64).
  // ==========================================================================

  pub let pwp_a11y_wire_get_surface : (u64) -> u64 !{mem} @{} =
    fn (payload_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B12-07 (paideia-os #2306): read surface_kind_id from word0[31:0]. Labels prefixed pwp_a11y_wire_gs_.",
      block: {
        mov rax, [rdi + 0];
        and rax, 0xFFFFFFFF;
        ret
      }
    }

  pub let pwp_a11y_wire_get_tree : (u64) -> u64 !{mem} @{} =
    fn (payload_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B12-07 (paideia-os #2306): read a11y_tree_kind_id from word0[63:32]. Labels prefixed pwp_a11y_wire_gt_.",
      block: {
        mov rax, [rdi + 0];
        shr rax, 32;
        ret
      }
    }

  pub let pwp_a11y_wire_get_node_count : (u64) -> u64 !{mem} @{} =
    fn (payload_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B12-07 (paideia-os #2306): read node_count_added from word1[31:0]. Labels prefixed pwp_a11y_wire_gnc_.",
      block: {
        mov rax, [rdi + 8];
        and rax, 0xFFFFFFFF;
        ret
      }
    }

  pub let pwp_a11y_wire_get_ids_offset : (u64) -> u64 !{mem} @{} =
    fn (payload_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B12-07 (paideia-os #2306): read node_ids_offset from word1[63:32]. At Wave 0 fidelity this is interpreted as an absolute pointer (see file header §0.3). Labels prefixed pwp_a11y_wire_gio_.",
      block: {
        mov rax, [rdi + 8];
        shr rax, 32;
        ret
      }
    }

  pub let pwp_a11y_wire_get_updates : (u64) -> u64 !{mem} @{} =
    fn (payload_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B12-07 (paideia-os #2306): read state_updates_bitmap (full u64) from [+16]. Labels prefixed pwp_a11y_wire_gu_.",
      block: {
        mov rax, [rdi + 16];
        ret
      }
    }

  // ==========================================================================
  // SECTION F  pwp_a11y_wire_size -- wire footprint for buffer allocation.
  //
  // Contract: pwp_a11y_wire_size(&payload) -> header (32) + node_count_
  // added * PWP_A11Y_WIRE_NODE_ID_BYTES(4). Result fits in u32 for any
  // node_count_added <= NODE_COUNT_MAX(32): 32 + 32*4 = 160 bytes max.
  //
  // Two callee-save pushes not needed (single leaf call to get_node_
  // count then arithmetic). Entry rsp%16==8; the nested call needs 0,
  // so one `sub rsp,8` pad wraps the call.
  // ==========================================================================

  pub let pwp_a11y_wire_size : (u64) -> u64 !{mem} @{} =
    fn (payload_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B12-07 (paideia-os #2306): wire footprint = 32 + node_count_added * 4. One nested call (get_node_count); wraps it in a sub rsp,8 pad so rsp%16==0 at the callsite. Straight arithmetic after the return. Labels prefixed pwp_a11y_wire_sz_.",
      block: {
        sub  rsp, 8;
        call pwp_a11y_wire_get_node_count;
        add  rsp, 8;
        shl  rax, 2;                         // * 4
        add  rax, 32;                        // + header
        ret
      }
    }

  // ==========================================================================
  // SECTION G  pwp_a11y_wire_unpack_and_apply.
  //
  // Contract: unpack_and_apply(&payload) -> PWP_A11Y_WIRE_OK
  //                                       | PWP_A11Y_WIRE_BAD_*
  //                                       | (a11y sentinel packed low32).
  //
  // Drives BOTH sides of the atomic-batch apply:
  //
  //   (1) For each id in payload.node_ids[0..node_count_added]:
  //         call a11y_tree_append_node(tree, parent=root_node_id,
  //                                    role=ROLE_UNKNOWN(0),
  //                                    label_off=0).
  //       On the first non-OK sentinel from a11y_tree_append_node,
  //       stop and return PWP_A11Y_WIRE_APPLY_FAILED (the a11y_tree
  //       sentinel remains observable via the a11y_tree_stats_refused
  //       counter). NB: this Wave-0 apply uses placeholder role /
  //       label; a follow-on landing will consume the actual role/
  //       state/label bytes from a companion inline record that lands
  //       when the SET_A11Y_PAYLOAD commit-op is defined. What this
  //       landing establishes is the WIRE PATH ATOMICITY -- one
  //       message drives both surface AND tree apply.
  //
  //   (2) For each bit set in payload.state_updates_bitmap (bit i,
  //         i in [0, 64)):
  //         call a11y_tree_update_state(tree, i, state=0).
  //       Same failure disposition: first non-OK stops and returns
  //       PWP_A11Y_WIRE_APPLY_FAILED. Placeholder state=0; the actual
  //       state bytes ride in the follow-on companion record.
  //
  // On success, bumps PWP_A11Y_WIRE_ST_APPLIES once (the whole payload
  // is one atomic apply, not one bump per sub-op). Refusal path bumps
  // REFUSED. The apply count returned in rax is 0 on success (OK
  // sentinel is 0); callers that want the applied-item count can read
  // it from a follow-on gauge extension.
  //
  // Six callee-save pushes (rbx=payload, r12=tree, r13=count, r14=ids,
  // r15=updates, rbp=index-cursor) + entry rsp%16==8, six 8-byte pushes
  // preserve parity, so every gate call is wrapped in a `sub rsp,8`
  // pad.
  // ==========================================================================

  pub let pwp_a11y_wire_unpack_and_apply : (u64) -> u64 !{mem} @{} =
    fn (payload_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B12-07 (paideia-os #2306): drive both a11y_tree_append_node (per added id) and a11y_tree_update_state (per set bit in state_updates_bitmap). Six callee-save pushes (rbx=payload, r12=tree, r13=count, r14=ids, r15=updates, rbp=index-cursor) preserve entry rsp%16==8; every nested call is preceded by sub rsp,8 to bring parity to 0. Refusal funnel bumps _pwp_a11y_wire_stats[REFUSED] once. Placeholder role=ROLE_UNKNOWN(0), state=0 -- follow-on landing consumes actual bytes from a companion inline record. Labels prefixed pwp_a11y_wire_ua_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov  rbx, rdi;                       // payload_ptr

        // (0) payload_ptr != 0?
        cmp  rbx, 0;
        je   pwp_a11y_wire_ua_bad_payload;

        // Read the four fields we need into callee-save.
        sub  rsp, 8;
        mov  rdi, rbx;
        call pwp_a11y_wire_get_tree;
        add  rsp, 8;
        mov  r12, rax;                       // tree

        sub  rsp, 8;
        mov  rdi, rbx;
        call pwp_a11y_wire_get_node_count;
        add  rsp, 8;
        mov  r13, rax;                       // count

        sub  rsp, 8;
        mov  rdi, rbx;
        call pwp_a11y_wire_get_ids_offset;
        add  rsp, 8;
        mov  r14, rax;                       // ids (absolute ptr Wave 0)

        sub  rsp, 8;
        mov  rdi, rbx;
        call pwp_a11y_wire_get_updates;
        add  rsp, 8;
        mov  r15, rax;                       // updates bitmap

        // Sanity: if count > 0 but ids == 0, refuse -- a payload that
        // claims added nodes but supplies no buffer is a caller bug.
        cmp  r13, 0;
        je   pwp_a11y_wire_ua_no_adds;
        cmp  r14, 0;
        je   pwp_a11y_wire_ua_null_ids;

      pwp_a11y_wire_ua_no_adds:
        // (1) APPEND loop: for i in [0, count):
        //       a11y_tree_append_node(tree, parent=0, role=0, label=0)
        //     Placeholder args; the wire path is what this landing
        //     establishes, not the role/label semantics. The i-th
        //     iteration reads ids[i] but does not use it against the
        //     tree (a11y_tree_append_node assigns its own node_id at
        //     the tail); the read is defensive so the caller's ids
        //     buffer is touched at Wave 0 and any bad pointer surfaces
        //     as a page fault here rather than in a downstream landing.
        xor  rbp, rbp;                       // i = 0

      pwp_a11y_wire_ua_apnd_step:
        cmp  rbp, r13;
        jae  pwp_a11y_wire_ua_apnd_done;

        // Defensive touch of ids[i] (u32 * i). Result discarded; the
        // point is to fault-early on a malformed ids pointer.
        mov  r10, rbp;
        shl  r10, 2;                         // i * 4 bytes
        add  r10, r14;
        mov  eax, [r10 + 0];                 // 32-bit read; upper 32 zeroed

        // a11y_tree_append_node(tree, parent_id=0, role=0, label_off=0)
        sub  rsp, 8;
        mov  rdi, r12;
        mov  rsi, 0;
        mov  rdx, 0;
        mov  rcx, 0;
        call a11y_tree_append_node;
        add  rsp, 8;

        // a11y_tree returns node_id in [0, A11Y_MAX_NODES=32) on
        // success; any sentinel is >= 0xFFFFEB70 (see tree_kind.pdx
        // §Section 5). Threshold: 32.
        mov  r10, 32;
        cmp  rax, r10;
        jae  pwp_a11y_wire_ua_apply_failed;

        add  rbp, 1;
        jmp  pwp_a11y_wire_ua_apnd_step;

      pwp_a11y_wire_ua_apnd_done:
        // (2) UPDATE loop: for i in [0, 64): if bit i of updates set:
        //       a11y_tree_update_state(tree, i, state=0)
        xor  rbp, rbp;

      pwp_a11y_wire_ua_upd_step:
        mov  r10, 64;
        cmp  rbp, r10;
        jae  pwp_a11y_wire_ua_upd_done;

        // Test bit rbp of r15 (paideia-as has no `test`; use and+cmp).
        mov  rcx, rbp;
        mov  rax, 1;
        shl  rax, cl;                        // rax = 1<<i
        and  rax, r15;
        cmp  rax, 0;
        je   pwp_a11y_wire_ua_upd_advance;

        // a11y_tree_update_state(tree, node_id=i, state=0)
        sub  rsp, 8;
        mov  rdi, r12;
        mov  rsi, rbp;
        mov  rdx, 0;
        call a11y_tree_update_state;
        add  rsp, 8;

        // Success sentinel is exactly 0 (A11Y_OK); any nonzero is a
        // failure sentinel in the 0xFFFFEB7x band.
        cmp  rax, 0;
        jne  pwp_a11y_wire_ua_apply_failed;

      pwp_a11y_wire_ua_upd_advance:
        add  rbp, 1;
        jmp  pwp_a11y_wire_ua_upd_step;

      pwp_a11y_wire_ua_upd_done:
        // Success: one atomic apply, bump APPLIES once.
        sub  rsp, 8;
        mov  rdi, 1;                         // PWP_A11Y_WIRE_ST_APPLIES
        call pwp_a11y_wire_stats_bump;
        add  rsp, 8;
        xor  rax, rax;                       // PWP_A11Y_WIRE_OK
        jmp  pwp_a11y_wire_ua_out;

      pwp_a11y_wire_ua_bad_payload:
        mov  rax, 0xFFFFEB62;                // PWP_A11Y_WIRE_BAD_PAYLOAD
        jmp  pwp_a11y_wire_ua_refused;
      pwp_a11y_wire_ua_null_ids:
        mov  rax, 0xFFFFEB61;                // PWP_A11Y_WIRE_NULL_IDS_BUF
        jmp  pwp_a11y_wire_ua_refused;
      pwp_a11y_wire_ua_apply_failed:
        mov  rax, 0xFFFFEB63;                // PWP_A11Y_WIRE_APPLY_FAILED

      pwp_a11y_wire_ua_refused:
        mov  rbx, rax;                       // stash sentinel (callee-save)
        sub  rsp, 8;
        mov  rdi, 2;                         // PWP_A11Y_WIRE_ST_REFUSED
        call pwp_a11y_wire_stats_bump;
        add  rsp, 8;
        mov  rax, rbx;                       // restore sentinel

      pwp_a11y_wire_ua_out:
        pop  rbp;
        pop  r15;
        pop  r14;
        pop  r13;
        pop  r12;
        pop  rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION H  Stats primitives + init.
  //
  // Same shape as a11y_bind_at_mint.pdx §Section B: a bounds-checked
  // bump, three individual accessors, a reset, and an init that scrubs
  // the row defensively.
  // ==========================================================================

  pub let pwp_a11y_wire_stats_bump : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B12-07 (paideia-os #2306): bounds-checked counter bump (which < 3). Load-inc-store idiom (no `add reg, [mem]`) per encoder discipline. Labels prefixed pwp_a11y_wire_sb_.",
      block: {
        cmp rdi, 3;
        jae pwp_a11y_wire_sb_out;
        lea r10, [rip + _pwp_a11y_wire_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      pwp_a11y_wire_sb_out:
        ret
      }
    }

  pub let pwp_a11y_wire_stats_packs : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B12-07 (paideia-os #2306): direct read of _pwp_a11y_wire_stats[PWP_A11Y_WIRE_ST_PACKS=0]. Labels prefixed pwp_a11y_wire_sp_.",
      block: {
        lea r10, [rip + _pwp_a11y_wire_stats];
        mov rax, [r10 + 0];
        ret
      }
    }

  pub let pwp_a11y_wire_stats_applies : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B12-07 (paideia-os #2306): direct read of _pwp_a11y_wire_stats[PWP_A11Y_WIRE_ST_APPLIES=1] at byte offset 8. Labels prefixed pwp_a11y_wire_sa_.",
      block: {
        lea r10, [rip + _pwp_a11y_wire_stats];
        mov rax, [r10 + 8];
        ret
      }
    }

  pub let pwp_a11y_wire_stats_refused : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B12-07 (paideia-os #2306): direct read of _pwp_a11y_wire_stats[PWP_A11Y_WIRE_ST_REFUSED=2] at byte offset 16. Labels prefixed pwp_a11y_wire_sf_.",
      block: {
        lea r10, [rip + _pwp_a11y_wire_stats];
        mov rax, [r10 + 16];
        ret
      }
    }

  pub let pwp_a11y_wire_stats_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B12-07 (paideia-os #2306): scrub all four cells of _pwp_a11y_wire_stats (three live slots plus one reserved). Defensive; .bss is already zero at real boot. Short encoder-safe step loop (not `loop` keyword). Labels prefixed pwp_a11y_wire_sre_.",
      block: {
        lea r10, [rip + _pwp_a11y_wire_stats];
        xor rax, rax;
        xor rcx, rcx;
      pwp_a11y_wire_sre_step:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  pwp_a11y_wire_sre_step;
        ret
      }
    }

  pub let pwp_a11y_wire_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B12-07 (paideia-os #2306): call through to pwp_a11y_wire_stats_reset for one clean counter zero-out at compositor init. Labels prefixed pwp_a11y_wire_i_.",
      block: {
        call pwp_a11y_wire_stats_reset;
        ret
      }
    }
}
