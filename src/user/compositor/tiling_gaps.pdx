// src/user/compositor/tiling_gaps.pdx -- Wave0-B12-04 (paideia-os #2293)
//
// TilingGaps -- value-type geometry-adjustment layer atop TilingBsp
// (B8-08, LANDED). Sibling of tiling_bsp.pdx and tiling_floating.pdx
// (B10-04, LANDED) with the same "value type, no KIND cap" posture --
// see tiling_bsp.pdx §0. Gaps and reserved-bar spans are per-workspace
// compositor state carried inline on the KIND_WORKSPACE row that owns
// the BSP tree; they are never handed cross-process. Adding a KIND_
// TILING_GAPS slot would introduce a rights lattice + mint dispatcher +
// row pool for authority we never externalise.
//
// The point of this module: the BSP walker in tiling_bsp lays out
// windows edge-to-edge against a rectangular workspace. Human-readable
// tiling wants:
//
//     * a small margin between adjacent tiles (INNER GAP)
//     * a slightly larger margin between the outermost tile row/column
//       and the workspace boundary (OUTER GAP)
//     * a reserved strip at the top and/or bottom for a status bar
//       or taskbar (BAR RESERVE)
//     * a "smart" mode that collapses gaps down to bar reserve alone
//       when the workspace holds a single window (so a full-screen
//       reader is not framed by empty pixels)
//
// This module owns those knobs as a small value-typed record
// (TilingGapConfig, 16 bytes / 2 u64 words) and one applier that
// consumes a raw BSP-computed geometry rectangle and returns the
// gap-adjusted rectangle. The applier is pure: no state, no side
// effects beyond writing *out_ptr. The BSP tree is unchanged; gaps
// are a rendering-time projection over BSP output, not a rewrite.
//
// =============================================================================
// SECTION 0  WHY THIS IS A VALUE TYPE, NOT A KIND CAP
// =============================================================================
//
// Same reasoning as tiling_bsp.pdx §0 and tiling_floating.pdx §0. A
// TilingGapConfig is per-workspace compositor policy state, changed
// only through the workspace's own op surface (a future compositor op
// binds this record onto a KIND_WORKSPACE row). No caller ever gets a
// bare handle to the record over the compositor's arena.
//
// =============================================================================
// SECTION 1  KIND_* SLOT ALLOCATION
// =============================================================================
//
// N/A -- value type. The workspace-side wire-in (a future landing that
// inlines a TilingGapConfig onto each KIND_WORKSPACE row) plugs into
// the KIND_WORKSPACE row body directly; no KIND_TILING_GAPS slot exists.
//
// =============================================================================
// SECTION 2  RECORD LAYOUT
// =============================================================================
//
// -----------------------------------------------------------------------------
// 2.1  struct TilingGapConfig  (16 bytes, two u64 words)
// -----------------------------------------------------------------------------
//
//   [+0]  gaps_pack:
//         outer_gap_px[15:0]       | inner_gap_px[31:16]
//       | top_bar_reserved_px[47:32] | bottom_bar_reserved_px[63:48]
//
//   [+8]  flags:
//         smart_gap_enabled[7:0]   | reserved[63:8]
//
// Fields:
//   outer_gap_px             u16   pixels between a workspace edge and the
//                                  outermost tile on that edge. Applied to
//                                  the tile ONLY when the tile touches the
//                                  edge. Common values: 4..16.
//   inner_gap_px             u16   pixels between two adjacent interior
//                                  tile edges. Each tile shrinks inward by
//                                  inner_gap_px/2 on every INTERIOR edge
//                                  (an edge shared with another tile), so
//                                  the visible spacing between neighbours
//                                  is exactly inner_gap_px. Common: 2..8.
//   top_bar_reserved_px      u16   pixels reserved at the workspace's top
//                                  edge for a status bar. A tile whose top
//                                  touches the workspace top additionally
//                                  shrinks its top by this amount (on top
//                                  of the outer_gap_px shrink).
//   bottom_bar_reserved_px   u16   symmetric with top_bar for a taskbar.
//   smart_gap_enabled        u8    0 = always apply gaps; 1 = collapse
//                                  ALL gap+outer adjustments (but not bar
//                                  reserves) to zero when the workspace
//                                  holds exactly one window. Consumed by
//                                  tiling_gaps_should_collapse; also
//                                  branched on in tiling_gaps_apply.
//
// TOTAL: 16 bytes. Alignment: 8. All-zero record is the "no gaps, no
// bars, smart disabled" legal form (edges pack against the workspace
// boundary).
//
// -----------------------------------------------------------------------------
// 2.2  Geometry input/output layout
// -----------------------------------------------------------------------------
//
// tiling_gaps_apply consumes a BSP-computed geometry rectangle in the
// packed 16-byte shape that tiling_floating_apply writes:
//
//   *(bsp_geom_ptr + 0) = x[31:0]  | y[63:32]     (u32/u32 in a u64 word)
//   *(bsp_geom_ptr + 8) = w[31:0]  | h[63:32]
//
// and writes the adjusted geometry to *out_ptr in the same shape:
//
//   *(out_ptr + 0)      = ax[31:0] | ay[63:32]
//   *(out_ptr + 8)      = aw[31:0] | ah[63:32]
//
// output_wh is passed as a single u64 argument packed as
//   output_w[31:0] | output_h[63:32]
//
// Coordinates are interpreted as u32 (workspace-relative, always
// non-negative). A caller with i32 semantics is responsible for its
// own sign-extension outside this module; the gap math here is pure
// u32 arithmetic and never overflows a u64 register at these ceilings.
//
// =============================================================================
// SECTION 3  APPLY ALGORITHM
// =============================================================================
//
// Given (cfg, bsp_geom, is_only_window, output_wh):
//
//   1. If smart_gap_enabled != 0 AND is_only_window != 0:
//        Return the "collapsed" rectangle -- the full workspace with
//        only the top/bottom bar reserves subtracted:
//            ax = 0, ay = top_bar
//            aw = output_w
//            ah = output_h - top_bar - bottom_bar
//        (No inner or outer gap. This is what a full-screen reader on
//        an empty workspace wants: no framing pixels, only the bars.)
//
//   2. Otherwise, compute per-edge adjustments as a function of whether
//      the input rectangle's edge coincides with the workspace edge:
//
//        at_left    <=> bsp.x           == 0
//        at_top     <=> bsp.y           == 0
//        at_right   <=> bsp.x + bsp.w   == output_w
//        at_bottom  <=> bsp.y + bsp.h   == output_h
//
//        dx_left    = at_left    ? outer_gap                  : inner_gap/2
//        dx_right   = at_right   ? outer_gap                  : inner_gap/2
//        dy_top     = at_top     ? outer_gap + top_bar        : inner_gap/2
//        dy_bottom  = at_bottom  ? outer_gap + bottom_bar     : inner_gap/2
//
//        ax = bsp.x + dx_left
//        ay = bsp.y + dy_top
//        aw = bsp.w - dx_left - dx_right
//        ah = bsp.h - dy_top   - dy_bottom
//
//   3. If dx_left + dx_right >= bsp.w OR dy_top + dy_bottom >= bsp.h,
//      the adjustments would produce a non-positive width or height.
//      Return TG_ERR_UNDERFLOW; do not write out_ptr. (Caller policy:
//      shrink the config, split fewer times, or refuse the split at
//      the tiler; do not paper over here.)
//
// The pure "at-edge" test uses exact equality against output_w / output_h
// rather than a floating-point tolerance because workspace geometry is
// integer-quantised end-to-end (see design/kernel/kind-tui-canvas.md on
// integer-pixel discipline; the same rule governs graphical tiling).
//
// =============================================================================
// SECTION 4  FAILURE TAXONOMY  0xFFFFE910..0xFFFFE91F
// =============================================================================
//
// SPEC DEVIATION.
//   The B12-04 issue names the failure band 0xFFFFEB10..0xFFFFEB1F. A
//   repo-wide sweep at landing time (grep -rhEo '0xFFFFEB1[0-9A-Fa-f]'
//   over src/ + design/ + tools/) shows the KIND_TUI_CANVAS landing
//   (R89.M1-001, kind_tui_canvas.pdx) has already claimed that page
//   (0xFFFFEB10 header sentinel plus 0xFFFFEB18..0xFFFFEB1F). The
//   issue's named fallback 0xFFFFE900..0xFFFFE90F is likewise claimed
//   (0xFFFFE900, 0xFFFFE90A..0xFFFFE90F all live). The next verified-
//   free 16-code page starting from the E900 fallback was checked
//   mechanically:
//
//       for hi in 0xFFFFE900 step 16 while hi < 0xFFFFF000:
//           if none of hi..hi+15 appears in the used set:
//               print(hi); break
//
//   yielding 0xFFFFE910. The KIND_TUI_CANVAS landing (see kind_tui_
//   canvas.pdx file-header deviation) and TilingFloating (B10-04, see
//   tiling_floating.pdx §3) both took the same "spec-band collides,
//   pick verified-free adjacent page" step, so the posture is
//   precedented within this family.
//
//   TG_OK                 : 0
//   TG_ERR_BAD_PTR        : 0xFFFFE91F  cfg_ptr / bsp_geom_ptr / out_ptr == 0
//   TG_ERR_BAD_OUTPUT     : 0xFFFFE91E  output_w == 0 or output_h == 0
//   TG_ERR_UNDERFLOW      : 0xFFFFE91D  gaps + reserves >= bsp.w or bsp.h
//   TG_ERR_BAD_GEOM       : 0xFFFFE91C  bsp.w == 0 or bsp.h == 0
//                                       (a zero-extent BSP leaf is a caller
//                                       bug; we refuse rather than emit an
//                                       adjusted rect no consumer can render)
//   TG_ERR_BAD_CONFIG     : 0xFFFFE91B  (reserved; not returned by any body
//                                       in THIS landing, but reserved so a
//                                       future config validator has a code
//                                       to return)
//
// =============================================================================
// SECTION 5  ENCODER-CONSERVATIVE DISCIPLINE
// =============================================================================
//
// Same rules as tiling_bsp.pdx §4 and tiling_floating.pdx §4:
//
//   * NO `and reg, imm64` / imm32 -- u32 zero-extension via `shl 32; shr 32`;
//     u16 zero-extension via `shl 48; shr 48` (mirrors window_kind.pdx's
//     u16 low-slot pattern); u8 mask via `and reg, 0xFF` (imm8 form, ok --
//     matches tb_node_axis / tf_ovr_mode idiom).
//
//   * NO 2-op `imul reg, imm`  -- either 3-op form (imul dst,src,imm32) or
//     `shl reg, N` when the constant is a power of two. This module never
//     multiplies by a runtime constant; the only "multiply" is /2 (right
//     shift by 1) applied to inner_gap in the interior-edge branch.
//
//   * NO `test`              -- `cmp reg, 0` for zero-tests.
//
//   * NO `add reg, [mem]`    -- always load the memory operand into a
//     scratch register first, then `add reg, reg`. The apply body
//     performs many `x + w` / `y + h` sums and this rule keeps every
//     one of them uniform.
//
//   * NO `sub reg, [mem]`    -- symmetric with the above; the collapsed-
//     form arithmetic `oh - top_bar - bot_bar` uses load-then-sub.
//
//   * NO `movsx` / `movzx`   -- `shl N; shr N` for zero-ext.
//
// =============================================================================
// SECTION 6  FINGERPRINT
// =============================================================================
//
// ONE data-only tag ending `[legacy: TILING GAPS META OK]` per softarch
// discipline (mirrors TilingBsp and TilingFloating). No mint body
// emits this string today -- TilingGaps is a value type. The KIND_
// WORKSPACE wire-in (a future landing that inlines a TilingGapConfig
// onto each KIND_WORKSPACE row) is the first consumer that may emit it
// as a side-band trace via klog_s1_x1; the coverage-gate allowlist
// entry lands with the same batch. String is data-only here so a
// future emission has a stable target.
//
// LABEL PREFIX: `tg_` for internal helpers and jump labels (avoids
// paideia-as reserved keywords -- `loop`, `if`, `return`; see feedback_
// paideia_as_reserved_labels). Public API functions carry the full
// `tiling_gaps_` prefix per the batch spec.

module TilingGaps = structure {

  // ==========================================================================
  // SECTION A  Record shape + defaults + failure codes.
  // ==========================================================================

  // Record sizing.
  pub let TG_CONFIG_BYTES       : u64 = 16       // total record size.
  pub let TG_CONFIG_WORDS       : u64 = 2        // 2 * u64.

  // Byte offsets within TilingGapConfig (SECTION 2.1).
  pub let TG_OFF_GAPS_PACK      : u64 = 0
  pub let TG_OFF_FLAGS          : u64 = 8

  // Sensible defaults for the "factory" form.
  pub let TG_DEFAULT_OUTER      : u64 = 8        // 8 px outer margin.
  pub let TG_DEFAULT_INNER      : u64 = 4        // 4 px inter-tile gap.
  pub let TG_DEFAULT_TOP_BAR    : u64 = 0        // no bar reserved by default.
  pub let TG_DEFAULT_BOTTOM_BAR : u64 = 0        // no bar reserved by default.
  pub let TG_DEFAULT_SMART      : u64 = 0        // smart-gap disabled by default.

  // Packed constant for the default record's gaps_pack word.
  //   outer=8   [15:0]     = 0x0008
  //   inner=4   [31:16]    = 0x00040000
  //   top_bar=0 [47:32]    = 0x0000_00000000
  //   bot_bar=0 [63:48]    = 0x0000_000000000000
  // Result: 0x0000_0000_0004_0008.
  pub let TG_DEFAULT_GAPS_PACK  : u64 = 0x0000000000040008

  // Failure taxonomy -- 0xFFFFE910..0xFFFFE91F (see file header §4).
  pub let TG_OK                 : u64 = 0
  pub let TG_ERR_BAD_PTR        : u64 = 0xFFFFE91F
  pub let TG_ERR_BAD_OUTPUT     : u64 = 0xFFFFE91E
  pub let TG_ERR_UNDERFLOW      : u64 = 0xFFFFE91D
  pub let TG_ERR_BAD_GEOM       : u64 = 0xFFFFE91C
  pub let TG_ERR_BAD_CONFIG     : u64 = 0xFFFFE91B

  // ==========================================================================
  // SECTION B  Fingerprint tag (data-only).
  //
  // pdx_kind_tiling_gaps_meta -- ONE tag ending [legacy: ... OK] per
  // softarch discipline. See file header §6.
  // ==========================================================================

  pub let pdx_kind_tiling_gaps_meta : [u8; 56] = "pdx kind tiling gaps meta [legacy: TILING GAPS META OK]\0"

  // ==========================================================================
  // SECTION C  Field accessors (read-only).
  //
  // Each accessor takes a cfg_ptr and returns the requested field
  // zero-extended into rax. All accessors are leaf functions with no
  // nested calls; no callee-save discipline required.
  //
  // The four u16 fields packed in gaps_pack use the `shl N; shr 48`
  // idiom to isolate one 16-bit slice:
  //   outer  (bits 15:0):  shl 48; shr 48
  //   inner  (bits 31:16): shl 32; shr 48
  //   top    (bits 47:32): shl 16; shr 48
  //   bottom (bits 63:48):           shr 48
  //
  // This mirrors window_kind.pdx's u16-slot pattern (window_kind.pdx L353,
  // L489) and generalises the shl/shr zero-extension idiom that
  // tiling_bsp.pdx uses for u32 halves.
  // ==========================================================================

  // tg_cfg_outer_gap(cfg_ptr) -> u16 zero-extended | 0 on null.
  pub let tg_cfg_outer_gap : (u64) -> u64 !{mem} @{} =
    fn (cfg_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B12-04 (paideia-os #2293): read outer_gap_px from gaps_pack[15:0]. Null pointer -> 0 (safest reading for a caller that has already failed to null-check the config). shl 48; shr 48 isolates bits 15:0. Labels prefixed tg_og_.",
      block: {
        cmp rdi, 0;
        je  tg_og_zero;
        mov rax, [rdi + 0];
        shl rax, 48;
        shr rax, 48;
        ret;
      tg_og_zero:
        xor rax, rax;
        ret
      }
    }

  // tg_cfg_inner_gap(cfg_ptr) -> u16 zero-extended | 0 on null.
  pub let tg_cfg_inner_gap : (u64) -> u64 !{mem} @{} =
    fn (cfg_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B12-04 (paideia-os #2293): read inner_gap_px from gaps_pack[31:16]. Null pointer -> 0. shl 32 pushes bits 31:16 into positions 63:48; shr 48 brings them back to 15:0 zero-extended. Labels prefixed tg_ig_.",
      block: {
        cmp rdi, 0;
        je  tg_ig_zero;
        mov rax, [rdi + 0];
        shl rax, 32;
        shr rax, 48;
        ret;
      tg_ig_zero:
        xor rax, rax;
        ret
      }
    }

  // tg_cfg_top_bar(cfg_ptr) -> u16 zero-extended | 0 on null.
  pub let tg_cfg_top_bar : (u64) -> u64 !{mem} @{} =
    fn (cfg_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B12-04 (paideia-os #2293): read top_bar_reserved_px from gaps_pack[47:32]. Null pointer -> 0. shl 16 then shr 48 isolates bits 47:32 into 15:0. Labels prefixed tg_tb_.",
      block: {
        cmp rdi, 0;
        je  tg_tb_zero;
        mov rax, [rdi + 0];
        shl rax, 16;
        shr rax, 48;
        ret;
      tg_tb_zero:
        xor rax, rax;
        ret
      }
    }

  // tg_cfg_bottom_bar(cfg_ptr) -> u16 zero-extended | 0 on null.
  pub let tg_cfg_bottom_bar : (u64) -> u64 !{mem} @{} =
    fn (cfg_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B12-04 (paideia-os #2293): read bottom_bar_reserved_px from gaps_pack[63:48]. Null pointer -> 0. shr 48 brings the high 16 bits to 15:0 zero-extended (no explicit high-half mask needed; those bits shift out of the register). Labels prefixed tg_bb_.",
      block: {
        cmp rdi, 0;
        je  tg_bb_zero;
        mov rax, [rdi + 0];
        shr rax, 48;
        ret;
      tg_bb_zero:
        xor rax, rax;
        ret
      }
    }

  // tg_cfg_smart_enabled(cfg_ptr) -> u8 zero-extended | 0 on null.
  pub let tg_cfg_smart_enabled : (u64) -> u64 !{mem} @{} =
    fn (cfg_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B12-04 (paideia-os #2293): read smart_gap_enabled from flags[7:0]. Null pointer -> 0 (smart-gap treated as disabled -- the safer default when the config is unreadable). `and rax, 0xFF` is imm8 form (matches tb_node_axis / tf_ovr_mode idiom; NOT the banned imm32 form). Labels prefixed tg_se_.",
      block: {
        cmp rdi, 0;
        je  tg_se_zero;
        mov rax, [rdi + 8];
        and rax, 0xFF;
        ret;
      tg_se_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // SECTION D  Factory -- tiling_gaps_config_default.
  //
  // tiling_gaps_config_default(out_ptr) -> TG_OK | TG_ERR_BAD_PTR.
  //
  // Writes the default record into a caller-provided 16-byte buffer:
  //   outer=8, inner=4, top_bar=0, bottom_bar=0, smart=0.
  //
  // Matches surface_geometry_default's shape (an out_ptr-taking factory
  // returning a status code rather than a struct-by-value, which the
  // ABI cannot express) -- see surface_geometry.pdx §3.
  // ==========================================================================

  pub let tiling_gaps_config_default : (u64) -> u64 !{mem} @{} =
    fn (out_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B12-04 (paideia-os #2293): fill 16-byte TilingGapConfig with default form (outer=8, inner=4, bars=0, smart=0). Null pointer -> TG_ERR_BAD_PTR. Leaf function, no nested calls; no callee-save discipline. Two word writes (gaps_pack + flags). The gaps_pack constant is precomputed as TG_DEFAULT_GAPS_PACK (0x0000000000040008) so the store is a single 64-bit immediate mov, no runtime packing. Labels prefixed tg_cd_.",
      block: {
        cmp rdi, 0;
        je  tg_cd_bad;

        // gaps_pack = 0x0000000000040008  (outer=8, inner=4, bars=0)
        mov rax, 0x0000000000040008;
        mov [rdi + 0], rax;

        // flags = 0  (smart disabled)
        xor rax, rax;
        mov [rdi + 8], rax;

        xor rax, rax;                    // TG_OK
        ret;

      tg_cd_bad:
        mov rax, 0xFFFFE91F;             // TG_ERR_BAD_PTR
        ret
      }
    }

  // ==========================================================================
  // SECTION E  Predicate -- tiling_gaps_should_collapse.
  //
  // tiling_gaps_should_collapse(cfg_ptr, window_count) -> 0 | 1.
  //
  // Returns 1 iff smart_gap_enabled != 0 AND window_count == 1.
  //
  // This is the fast-path check the compositor takes BEFORE calling
  // apply on the workspace's sole leaf: a `1` result tells the caller
  // that the coming apply on that leaf will return the "collapsed"
  // rectangle (workspace minus bars only). A compositor can use it to
  // short-circuit the per-leaf apply loop when it already knows the
  // workspace has exactly one window.
  //
  // Null pointer -> 0 (a null config disables smart mode implicitly).
  // ==========================================================================

  pub let tiling_gaps_should_collapse : (u64, u64) -> u64 !{mem} @{} =
    fn (cfg_ptr: u64) (window_count: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B12-04 (paideia-os #2293): 1 iff smart_gap_enabled != 0 AND window_count == 1. Leaf function, no nested calls; no callee-save discipline. Reads flags[7:0] inline via `and rax, 0xFF` (imm8 form). Two cmps, one AND-of-booleans expressed as sequential branches. Labels prefixed tg_sc_.",
      block: {
        cmp rdi, 0;
        je  tg_sc_no;

        // window_count == 1 ?
        cmp rsi, 1;
        jne tg_sc_no;

        // smart_gap_enabled != 0 ?
        mov rax, [rdi + 8];
        and rax, 0xFF;
        cmp rax, 0;
        je  tg_sc_no;

        mov rax, 1;
        ret;

      tg_sc_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // SECTION F  Applier -- tiling_gaps_apply.
  //
  // tiling_gaps_apply(cfg_ptr, bsp_geom_ptr, is_only_window,
  //                   output_wh, out_ptr)
  //   -> TG_OK | TG_ERR_BAD_PTR | TG_ERR_BAD_OUTPUT
  //    | TG_ERR_BAD_GEOM | TG_ERR_UNDERFLOW
  //
  // See SECTION 3 of the file header for the algorithm.
  //
  // ABI: rdi=cfg_ptr, rsi=bsp_geom_ptr, rdx=is_only_window,
  //      rcx=output_wh, r8=out_ptr.
  //
  // NO NESTED CALLS: every field extract is inline (shl/shr idioms
  // against loaded packed words), so this body needs no callee-save
  // discipline. Uses only caller-save registers (rax, rcx, rdx, rsi,
  // rdi, r8..r11) and a 128-byte stack local frame for spilling the
  // 15 intermediate values (5 cfg fields, 4 bsp coords, 2 output
  // dims, 4 per-edge adjustments) that do not all fit in caller-save
  // regs simultaneously.
  //
  // Stack local layout (all u64 slots):
  //   [rsp+0]    outer_gap        (u16, zero-extended)
  //   [rsp+8]    inner_gap        (u16)
  //   [rsp+16]   top_bar          (u16)
  //   [rsp+24]   bottom_bar       (u16)
  //   [rsp+32]   smart_enabled    (u8)
  //   [rsp+40]   x                (u32)
  //   [rsp+48]   y                (u32)
  //   [rsp+56]   w                (u32)
  //   [rsp+64]   h                (u32)
  //   [rsp+72]   ow               (u32)
  //   [rsp+80]   oh               (u32)
  //   [rsp+88]   dx_left          (u16 -- promoted to u64 for arithmetic)
  //   [rsp+96]   dx_right         (u16)
  //   [rsp+104]  dy_top           (u16)
  //   [rsp+112]  dy_bottom        (u16)
  //   [rsp+120]  is_only_window   (u64 stash of rdx across cfg extracts)
  //
  // Alignment is not required (no nested calls); 128 is chosen for
  // uniform slot naming and a small margin.
  //
  // The out_ptr (r8) is preserved verbatim through the body (no reg
  // clobbers it) and referenced only at the write step.
  // ==========================================================================

  pub let tiling_gaps_apply : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (cfg_ptr: u64) (bsp_geom_ptr: u64) (is_only_window: u64)
       (output_wh: u64) (out_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B12-04 (paideia-os #2293): pure geometry adjustment atop BSP output. Inline field extraction (no nested calls). 128-byte local frame for 16 u64 spill slots. Validation order: null-check cfg_ptr / bsp_geom_ptr / out_ptr, then bsp.w/h > 0 (TG_ERR_BAD_GEOM), then output_w/h > 0 (TG_ERR_BAD_OUTPUT). Smart+only-window collapse path is checked first; it uses its own arithmetic (output minus bars) and skips the per-edge dispatch. The per-edge dispatch computes four independent adjustments in sequence, spilling each to its slot; the final (ax, ay, aw, ah) assembly reloads the four adjustments and the four bsp coords, computes sums / differences reg-reg (never `add reg, [mem]` or `sub reg, [mem]`), then packs into two u64 words and stores to out_ptr. Underflow guard: dx_left+dx_right vs. w and dy_top+dy_bottom vs. h checked BEFORE the shrink so an underflow returns TG_ERR_UNDERFLOW without writing out_ptr. Labels prefixed tg_ap_.",
      block: {
        sub rsp, 128;

        // --- Null-check inputs. ---
        cmp rdi, 0;
        je  tg_ap_bad_ptr;
        cmp rsi, 0;
        je  tg_ap_bad_ptr;
        cmp r8, 0;
        je  tg_ap_bad_ptr;

        // --- Stash is_only_window across the cfg-field extracts. ---
        mov [rsp + 120], rdx;

        // --- Extract cfg fields into stack slots. ---
        // gaps_pack in r9 for four u16 slices.
        mov r9, [rdi + 0];

        // outer  = gaps_pack[15:0]  -> shl 48; shr 48.
        mov rax, r9;
        shl rax, 48;
        shr rax, 48;
        mov [rsp + 0], rax;

        // inner  = gaps_pack[31:16] -> shl 32; shr 48.
        mov rax, r9;
        shl rax, 32;
        shr rax, 48;
        mov [rsp + 8], rax;

        // top    = gaps_pack[47:32] -> shl 16; shr 48.
        mov rax, r9;
        shl rax, 16;
        shr rax, 48;
        mov [rsp + 16], rax;

        // bottom = gaps_pack[63:48] -> shr 48.
        mov rax, r9;
        shr rax, 48;
        mov [rsp + 24], rax;

        // smart  = flags[7:0].
        mov rax, [rdi + 8];
        and rax, 0xFF;
        mov [rsp + 32], rax;

        // --- Extract bsp_geom into stack slots. ---
        // rsi = bsp_geom_ptr.
        mov r9, [rsi + 0];               // xy packed

        // x = xy[31:0].
        mov rax, r9;
        shl rax, 32;
        shr rax, 32;
        mov [rsp + 40], rax;

        // y = xy[63:32].
        mov rax, r9;
        shr rax, 32;
        mov [rsp + 48], rax;

        mov r9, [rsi + 8];               // wh packed

        // w = wh[31:0].
        mov rax, r9;
        shl rax, 32;
        shr rax, 32;
        mov [rsp + 56], rax;

        // h = wh[63:32].
        mov rax, r9;
        shr rax, 32;
        mov [rsp + 64], rax;

        // --- Extract output_wh (still in rcx). ---
        // ow = output_wh[31:0].
        mov rax, rcx;
        shl rax, 32;
        shr rax, 32;
        mov [rsp + 72], rax;

        // oh = output_wh[63:32].
        mov rax, rcx;
        shr rax, 32;
        mov [rsp + 80], rax;

        // --- Validate bsp.w, bsp.h > 0 (TG_ERR_BAD_GEOM). ---
        mov rax, [rsp + 56];
        cmp rax, 0;
        je  tg_ap_bad_geom;
        mov rax, [rsp + 64];
        cmp rax, 0;
        je  tg_ap_bad_geom;

        // --- Validate output_w, output_h > 0 (TG_ERR_BAD_OUTPUT). ---
        mov rax, [rsp + 72];
        cmp rax, 0;
        je  tg_ap_bad_output;
        mov rax, [rsp + 80];
        cmp rax, 0;
        je  tg_ap_bad_output;

        // --- Dispatch: collapsed (smart && only_window) vs. per-edge. ---
        mov rax, [rsp + 32];             // smart
        cmp rax, 0;
        je  tg_ap_do_edges;
        mov rax, [rsp + 120];            // is_only_window
        cmp rax, 0;
        je  tg_ap_do_edges;

        // ---- Collapsed form ----
        //   ax = 0
        //   ay = top_bar
        //   aw = ow
        //   ah = oh - top_bar - bottom_bar
        // Underflow: top_bar + bottom_bar >= oh -> TG_ERR_UNDERFLOW.
        mov rax, [rsp + 16];             // top_bar
        mov r10, [rsp + 24];             // bottom_bar
        add rax, r10;                    // top + bottom
        mov r10, [rsp + 80];             // oh
        cmp rax, r10;
        jae tg_ap_underflow;

        // ax = 0  (write into slot 88 for uniform final-assembly).
        xor rax, rax;
        mov [rsp + 88], rax;             // ax slot (reuses dx_left slot)

        // ay = top_bar
        mov rax, [rsp + 16];
        mov [rsp + 96], rax;             // ay slot (reuses dx_right slot)

        // aw = ow
        mov rax, [rsp + 72];
        mov [rsp + 104], rax;            // aw slot (reuses dy_top slot)

        // ah = oh - top_bar - bottom_bar
        mov rax, [rsp + 80];             // oh
        mov r10, [rsp + 16];             // top_bar
        sub rax, r10;
        mov r10, [rsp + 24];             // bottom_bar
        sub rax, r10;
        mov [rsp + 112], rax;            // ah slot (reuses dy_bottom slot)

        jmp tg_ap_write;

      tg_ap_do_edges:
        // ---- Per-edge adjustments ----
        //
        // dx_left = (x == 0) ? outer : inner/2
        mov rax, [rsp + 40];             // x
        cmp rax, 0;
        je  tg_ap_left_edge;
        mov rax, [rsp + 8];              // inner
        shr rax, 1;                      // /2
        mov [rsp + 88], rax;             // dx_left = inner/2
        jmp tg_ap_left_done;
      tg_ap_left_edge:
        mov rax, [rsp + 0];              // outer
        mov [rsp + 88], rax;             // dx_left = outer
      tg_ap_left_done:

        // dx_right = (x + w == ow) ? outer : inner/2
        mov rax, [rsp + 40];             // x
        mov r10, [rsp + 56];             // w
        add rax, r10;                    // x + w
        mov r10, [rsp + 72];             // ow
        cmp rax, r10;
        je  tg_ap_right_edge;
        mov rax, [rsp + 8];              // inner
        shr rax, 1;
        mov [rsp + 96], rax;             // dx_right = inner/2
        jmp tg_ap_right_done;
      tg_ap_right_edge:
        mov rax, [rsp + 0];              // outer
        mov [rsp + 96], rax;             // dx_right = outer
      tg_ap_right_done:

        // dy_top = (y == 0) ? (outer + top_bar) : inner/2
        mov rax, [rsp + 48];             // y
        cmp rax, 0;
        je  tg_ap_top_edge;
        mov rax, [rsp + 8];
        shr rax, 1;
        mov [rsp + 104], rax;            // dy_top = inner/2
        jmp tg_ap_top_done;
      tg_ap_top_edge:
        mov rax, [rsp + 0];              // outer
        mov r10, [rsp + 16];             // top_bar
        add rax, r10;                    // outer + top_bar
        mov [rsp + 104], rax;            // dy_top = outer + top_bar
      tg_ap_top_done:

        // dy_bottom = (y + h == oh) ? (outer + bottom_bar) : inner/2
        mov rax, [rsp + 48];             // y
        mov r10, [rsp + 64];             // h
        add rax, r10;                    // y + h
        mov r10, [rsp + 80];             // oh
        cmp rax, r10;
        je  tg_ap_bot_edge;
        mov rax, [rsp + 8];
        shr rax, 1;
        mov [rsp + 112], rax;            // dy_bottom = inner/2
        jmp tg_ap_bot_done;
      tg_ap_bot_edge:
        mov rax, [rsp + 0];              // outer
        mov r10, [rsp + 24];             // bottom_bar
        add rax, r10;                    // outer + bottom_bar
        mov [rsp + 112], rax;            // dy_bottom = outer + bottom_bar
      tg_ap_bot_done:

        // --- Underflow guard: dx_left + dx_right vs. w ---
        mov rax, [rsp + 88];             // dx_left
        mov r10, [rsp + 96];             // dx_right
        add rax, r10;
        mov r10, [rsp + 56];             // w
        cmp rax, r10;
        jae tg_ap_underflow;

        // --- Underflow guard: dy_top + dy_bottom vs. h ---
        mov rax, [rsp + 104];            // dy_top
        mov r10, [rsp + 112];            // dy_bottom
        add rax, r10;
        mov r10, [rsp + 64];             // h
        cmp rax, r10;
        jae tg_ap_underflow;

        // --- Compute final (ax, ay, aw, ah) in-place over the adj slots ---
        //
        // ax = x + dx_left  (overwrites [rsp+88])
        mov rax, [rsp + 40];
        mov r10, [rsp + 88];
        add rax, r10;
        mov [rsp + 88], rax;

        // ay = y + dy_top   (overwrites [rsp+104])
        mov rax, [rsp + 48];
        mov r10, [rsp + 104];
        add rax, r10;
        mov [rsp + 104], rax;

        // aw = w - dx_left - dx_right
        //
        // dx_left slot (88) now holds ax; recover dx_left = ax - x
        // ([88] - [40]). dx_right slot (96) is still intact and will
        // be overwritten here (consumed BEFORE the overwrite).
        // ORDER MATTERS: we must NOT write aw to any slot before ah is
        // computed, because ah needs the intact ay slot (104). Writing
        // aw into slot 96 (which held dx_right, already consumed) is
        // safe; writing to slot 104 would corrupt ay.
        mov rax, [rsp + 88];             // ax
        mov r10, [rsp + 40];             // x
        sub rax, r10;                    // dx_left (recovered)
        mov r10, [rsp + 96];             // dx_right (still intact)
        add rax, r10;                    // dx_left + dx_right
        mov r10, [rsp + 56];             // w
        sub r10, rax;                    // w - (dx_left + dx_right)
        mov [rsp + 96], r10;             // aw -> slot 96 (over dx_right, safe)

        // ah = h - dy_top - dy_bottom
        //
        // dy_top slot (104) now holds ay; recover dy_top = ay - y
        // ([104] - [48]). dy_bottom slot (112) is still intact and
        // will be overwritten by the final ah store.
        mov rax, [rsp + 104];            // ay
        mov r10, [rsp + 48];             // y
        sub rax, r10;                    // dy_top (recovered)
        mov r10, [rsp + 112];            // dy_bottom (still intact)
        add rax, r10;                    // dy_top + dy_bottom
        mov r10, [rsp + 64];             // h
        sub r10, rax;                    // h - (dy_top + dy_bottom)
        mov [rsp + 112], r10;            // ah -> slot 112 (over dy_bottom, safe)

        // Slot map after this block:
        //   [rsp+88]  = ax
        //   [rsp+104] = ay
        //   [rsp+96]  = aw
        //   [rsp+112] = ah

      tg_ap_write:
        // --- Pack and write (ax, ay, aw, ah) to *out_ptr / *(out_ptr+8) ---
        //
        // At entry to tg_ap_write, both paths (collapsed and per-edge)
        // have assembled:
        //   collapsed: ax=[88], ay=[96],  aw=[104], ah=[112]
        //   per-edge:  ax=[88], ay=[104], aw=[96],  ah=[112]
        //
        // The slot map for ay/aw differs between paths. Distinguish by
        // re-checking the collapsed condition (smart && only_window).
        //
        // This is the ONE deviation from the "each path assembles into
        // the same slots" ideal; it saves reshuffling on the collapsed
        // path (which naturally has aw=ow in the dy_top slot).
        mov rax, [rsp + 32];             // smart
        cmp rax, 0;
        je  tg_ap_write_per_edge;
        mov rax, [rsp + 120];            // is_only_window
        cmp rax, 0;
        je  tg_ap_write_per_edge;

        // Collapsed layout: xy=(ax=[88], ay=[96]); wh=(aw=[104], ah=[112]).
        //
        // Pack xy = ax[31:0] | ay[63:32].
        mov rax, [rsp + 88];             // ax
        shl rax, 32;
        shr rax, 32;                     // zero-ext to low 32
        mov r10, [rsp + 96];             // ay
        shl r10, 32;                     // ay into high 32
        or  rax, r10;
        mov [r8 + 0], rax;

        // Pack wh = aw[31:0] | ah[63:32].
        mov rax, [rsp + 104];            // aw
        shl rax, 32;
        shr rax, 32;
        mov r10, [rsp + 112];            // ah
        shl r10, 32;
        or  rax, r10;
        mov [r8 + 8], rax;

        jmp tg_ap_ok;

      tg_ap_write_per_edge:
        // Per-edge layout: xy=(ax=[88], ay=[104]); wh=(aw=[96], ah=[112]).
        mov rax, [rsp + 88];             // ax
        shl rax, 32;
        shr rax, 32;
        mov r10, [rsp + 104];            // ay
        shl r10, 32;
        or  rax, r10;
        mov [r8 + 0], rax;

        mov rax, [rsp + 96];             // aw
        shl rax, 32;
        shr rax, 32;
        mov r10, [rsp + 112];            // ah
        shl r10, 32;
        or  rax, r10;
        mov [r8 + 8], rax;

      tg_ap_ok:
        xor rax, rax;                    // TG_OK
        add rsp, 128;
        ret;

      tg_ap_bad_ptr:
        mov rax, 0xFFFFE91F;             // TG_ERR_BAD_PTR
        add rsp, 128;
        ret;

      tg_ap_bad_output:
        mov rax, 0xFFFFE91E;             // TG_ERR_BAD_OUTPUT
        add rsp, 128;
        ret;

      tg_ap_underflow:
        mov rax, 0xFFFFE91D;             // TG_ERR_UNDERFLOW
        add rsp, 128;
        ret;

      tg_ap_bad_geom:
        mov rax, 0xFFFFE91C;             // TG_ERR_BAD_GEOM
        add rsp, 128;
        ret
      }
    }

}
