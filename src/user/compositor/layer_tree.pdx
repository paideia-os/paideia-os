// src/user/compositor/layer_tree.pdx -- Wave0-B6-06 (paideia-os #2256)
//
// KIND_LAYER_TREE = 0x1C2, sealed derived cap over KIND_WINDOW (0x1C1).
// Design authority: design/compositor/pwp-spec-vocabulary.md §2.6.
// Companion: window_kind.pdx (Wave0-B6-05, paideia-os #2254; parallel
// landing; the KIND_WINDOW slot allocation is coordinated at 0x1C1
// under the same G7-M3 batch).
//
// =============================================================================
// SECTION 0  WHY THIS KIND EXISTS
// =============================================================================
//
// One KIND_WINDOW carries the toplevel window authority (z-order slot,
// modality edge, tab-order, workspace slot, a11y-tree binding). The
// per-window ORDERED FOREST OF LAYERS -- background / content / overlay
// / cursor / notification, plus toolkit-specific layer roles -- is a
// distinct cap so a client that never composes multiple layers holds a
// bare KIND_WINDOW and never mints a KIND_LAYER_TREE. Splitting the two
// keeps the KIND_WINDOW row narrow and the KIND_LAYER_TREE row wide
// without wasting cache lines on windows that never grow a layer set.
//
// The tree is SEALED: no RIGHT_MINT for external actors, no query
// helper that hands a client-visible cap over a foreign sibling window's
// tree. Traversal (§7) walks the local subtree only, via the sealed
// compositor-only RIGHT_TRAVERSE. A compromised client can attack its
// own window's tree; cross-window observability is a distinct capability
// handoff (via a KIND_A11Y_TREE bind at the compositor's discretion),
// not an ambient state read.
//
// Damage-region propagation (§2.11 of the vocabulary spec) folds
// per-node damage bboxes upward to the window root at commit time so
// the compositor can issue a minimal repaint. The aggregation is INSIDE
// the sealed boundary: a leaf layer's bbox never leaves the compositor;
// only the union at the root reaches the outer scanout path.
//
// =============================================================================
// SECTION 1  KIND_* SLOT ALLOCATION
// =============================================================================
//
// Consulted `design/architecture/next-wave-derived-kinds.md` §"Summary
// counts and free bands" at landing: last active derived-kind tag is
// KIND_REFERENCE_DISPLAY (0x1B7, Wave0-B1-05). No live claim on 0x1B8
// through 0x1CF in src/ (grep-verified: kernel/core/cap/kind_*.pdx +
// user/**/*.pdx). B6-05 sibling landing (window_kind.pdx) allocates
// KIND_WINDOW at 0x1C1, immediately below this file's 0x1C2 slot -- the
// two slots are adjacent by design so a reader scanning the compositor
// band lands on both in one grep. The 0x1B8..0x1C0 gap is reserved for
// the neighbouring compositor primitives (KIND_SURFACE, KIND_SURFACE_
// COMMIT, KIND_SUBSURFACE) that land in earlier / neighbouring G7-M2
// batches.
//
// =============================================================================
// SECTION 2  DERIVATION OVER KIND_WINDOW  (SEALED SUBTREE)
// =============================================================================
//
// The mint gate demands `kind == KIND_WINDOW (0x1C1)` on the parent cap
// AND `RIGHT_MINT` on that parent. The mint additionally requires:
//
//   (a) parent KIND_WINDOW carries RIGHT_LAYER (a per-window right the
//       sibling window_kind.pdx defines; a KIND_WINDOW that was minted
//       without that right cannot grow a layer tree at all).
//   (b) sealed_flag == 1 at mint time (external mints are refused
//       structurally; the compositor is the only mint-authorised holder
//       and it always mints sealed).
//   (c) initial_node_count in [1, LT_MAX_NODES]; the root layer node
//       is populated at mint time (its layer_kind_id points at the
//       "background" KIND_LAYER slot allocated by window_kind.pdx).
//   (d) rights subset of R_LT_ALL (0xF19). External actors may hold
//       R_LT_TRAVERSE (0x800) only when the compositor explicitly grants
//       a debug / a11y snapshot; the standard client holds no rights on
//       this cap.
//
// Sealed-subtree discipline (per spec §2.6):
//   * RIGHT_APPEND_LAYER, RIGHT_REORDER, RIGHT_ATTACH_DAMAGE, and
//     RIGHT_TRAVERSE are COMPOSITOR-INTERNAL rights. They compose with
//     RIGHT_INVOKE on the cap the compositor uses to service its own
//     op queue; they never appear on a cap handed to a client.
//   * RIGHT_MINT is NEVER handed out. The set of mint-authorised
//     holders is {svc-compositor} and is asserted at mint time; a mint
//     by any other holder returns LT_MINT_BAD_PARENT.
//   * The traversal helpers (§7) walk the local subtree only. There is
//     no `layer_tree_walk_across_windows` op; the compositor performs
//     cross-window composition via a separate KIND_WORKSPACE / KIND_
//     OUTPUT walk that operates ONE-LEVEL UP from any given
//     KIND_LAYER_TREE. Composition below the tree root stays inside
//     the tree's sealed boundary.
//
// =============================================================================
// SECTION 3  KIND-CAP ROW LAYOUT  (64 BYTES = ONE CACHE LINE)
// =============================================================================
//
// This is the KIND-cap row (one row per live KIND_LAYER_TREE cap). The
// actual tree data (header + nodes) lives in a per-cap arena block
// allocated below (`_layer_tree_arenas`, §4).
//
//   [+0]  header:      in_use[63:56] | parent_window_slot[15:8]
//                    | sealed[16:16] | reserved[55:17]
//                    | reserved[7:0]
//   [+8]  arena_ref:   arena_slot[7:0] | reserved[63:8]
//                    -- arena_slot indexes _layer_tree_arenas (0..LT_MAX-1);
//                       ONE arena per row (no sharing; sealing collapses if
//                       two rows named the same arena).
//   [+16] stats0:      mints[63:0]         (per-row mint count; monotonic)
//   [+24] stats1:      commits[63:0]       (per-row commit count; monotonic)
//   [+32] a11y_ref:    a11y_tree_slot[15:0] | reserved[63:16]
//                    -- forward binding: on commit the aggregated damage
//                       region is announced on this a11y tree if != 0.
//   [+40] reserved
//   [+48] reserved
//   [+56] reserved
//
// LT_MAX = 4 rows * 64 bytes = 256 bytes of KIND-cap row pool.
//
// =============================================================================
// SECTION 4  ARENA LAYOUT  (PER-ROW TREE STORAGE)
// =============================================================================
//
// One arena backs one KIND_LAYER_TREE row. Each arena is
// LT_HEADER_BYTES + LT_MAX_NODES * LT_NODE_BYTES bytes:
//
//     header:           32 bytes  (SECTION 4.1 -- struct LayerTree)
//     nodes[LT_MAX_NODES]: 32 * 48 = 1536 bytes  (SECTION 4.2 -- struct LayerTreeNode)
//     ----
//     total per arena:  1568 bytes
//
// LT_MAX arenas * 1568 bytes = 6272 bytes of arena .bss.
//
// -----------------------------------------------------------------------------
// 4.1  struct LayerTree  (header, 32 bytes at offset 0 within an arena)
// -----------------------------------------------------------------------------
//
//   [+0]  hdr_words0:  node_count[31:0]  | root_index[63:32]
//   [+8]  hdr_words1:  window_kind_id[31:0] | sealed[63:32]  (sealed as u32)
//   [+16] tree_seq:    tree_damage_seq[63:0]
//                        -- monotone counter bumped on every attach-damage
//                           op against any node in this tree; used by the
//                           compositor's frame-throttle to detect "the tree
//                           changed since last present" without walking it.
//   [+24] reserved:    0
//
// Fields:
//   node_count: u32       -- number of valid nodes in the array; 0..LT_MAX_NODES.
//   root_index: u32       -- index of the tree root (0 by convention; LT_INDEX_NONE if empty).
//   window_kind_id: u32   -- kernel-side kind tag of the parent KIND_WINDOW (== 0x1C1).
//   sealed: u32           -- 1 iff sealed subtree discipline is in force (must be 1 in practice).
//   tree_damage_seq: u64  -- monotone tree-level damage sequence.
//
// -----------------------------------------------------------------------------
// 4.2  struct LayerTreeNode  (48 bytes, one per layer edge)
// -----------------------------------------------------------------------------
//
//   [+0]  node_words0:  layer_kind_id[31:0] | parent_index[63:32]
//   [+8]  node_words1:  next_sibling_index[31:0] | first_child_index[63:32]
//   [+16] node_bbox_xy: damage_bbox_x[31:0]      | damage_bbox_y[63:32]     (i32 halves)
//   [+24] node_bbox_wh: damage_bbox_w[31:0]      | damage_bbox_h[63:32]     (i32 halves)
//   [+32] node_seq:     subtree_damage_seq[63:0]
//   [+40] reserved:     0
//
// Fields:
//   layer_kind_id: u32          -- KIND_LAYER cap identifier (allocated by window_kind.pdx sibling).
//   parent_index: u32           -- index into node array (LT_INDEX_NONE = root).
//   next_sibling_index: u32     -- LT_INDEX_NONE terminates a sibling chain.
//   first_child_index: u32      -- LT_INDEX_NONE means leaf.
//   damage_bbox_x/y/w/h: i32    -- axis-aligned bbox in surface-space; w=0 or h=0 means no local damage.
//   subtree_damage_seq: u64     -- monotone; aggregates children on layer_tree_aggregate_damage.
//
// TOPOLOGICAL INVARIANT (mint enforces; walk assumes):
//     for i in 0..node_count where nodes[i].parent_index != LT_INDEX_NONE:
//         nodes[i].parent_index < i
//
// This invariant lets layer_tree_aggregate_damage complete in ONE reverse-
// order pass over the node array (see §7.2) with no explicit stack. The
// mint body (future landing) rejects a topology that violates it.
//
// =============================================================================
// SECTION 5  FAILURE TAXONOMY  0xFFFFEA40..0xFFFFEA4F
// =============================================================================
//
// A repo-wide grep at landing time (grep -rhEo '0xFFFFE[89ABCDEF][0-9A-Fa-f]{2}'
// over src/ + design/) showed the 0xFFFFEA40..0xFFFFEA4F page free.
// Adjacent to KIND_REFERENCE_DISPLAY (0xFFFFEA50..5F) so the two Wave-0
// user-space kinds share a numeric neighbourhood; downstream G7 issues
// that add more compositor kinds should keep the 0xEAxx band contiguous.
//
// =============================================================================
// SECTION 6  CAPABILITY OP CATALOG
// =============================================================================
//
// Every op is arity ONE (row_id in target_ptr, sub-op / arg in
// op_arg[7:0]); op_arg[63:8] MUST be zero -- the future dispatcher
// refuses a smuggled second value with LT_TAIL_BAD_ARG.
//
//   LT_OP_QUERY_NODE_COUNT       (op_arg IGNORED)     -> node_count (u32)
//   LT_OP_QUERY_ROOT             (op_arg IGNORED)     -> root_index (u32)
//   LT_OP_QUERY_SEALED           (op_arg IGNORED)     -> 0/1
//   LT_OP_QUERY_TREE_SEQ         (op_arg IGNORED)     -> tree_damage_seq (u64)
//   LT_OP_QUERY_ROOT_BBOX        (op_arg IGNORED)     -> packed (x|y|w|h)
//   LT_OP_TRAVERSE_STEP          (op_arg = cur_id)    -> DFS-successor index
//                                (LT_INDEX_NONE at end); the walk-as-op form
//                                for callers that don't want to pass a
//                                function pointer.
//   LT_OP_AGGREGATE_DAMAGE       (op_arg IGNORED)     -> LT_OK; runs one
//                                reverse-order aggregation pass.
//   LT_OP_DEBUG_PRINT            (op_arg IGNORED)     -> LT_OK; klog emit.
//
// APPEND_LAYER / REORDER / ATTACH_DAMAGE are NOT exposed as arity-one
// ops -- each takes multiple field words and lands as a compositor-
// internal helper (future landing kind_layer_tree.pdx cap_handler).
// The design here is: external clients can only query; the compositor
// mutates via internal APIs that go straight to the arena.
//
// =============================================================================
// SECTION 7  WALK + AGGREGATE  (SEALED, IN-ARENA)
// =============================================================================
//
// 7.1 STABLE-ORDER DFS WALK  (layer_tree_walk_ordered)
// ----------------------------------------------------
//
// DFS order is determined by:
//   * visit the current node,
//   * recurse into first_child (if present),
//   * on return, follow next_sibling (if present),
//   * on exhaustion of children + siblings, walk up via parent_index and
//     resume at parent's next_sibling.
//
// A visit function pointer is called at each node via `call rax` in the
// same shape vops.pdx uses (SysV alignment pad of 8 bytes around the
// indirect call). The visit function receives (arena_base, node_index)
// in (rdi, rsi) and returns 0 to continue or 1 to STOP the walk. STOP
// short-circuits back to the caller with LT_OK (the walk itself did not
// fail; the visitor asked to stop).
//
// The walk NEVER exits the arena. There is no cross-arena pointer chase.
// If a subtree_damage_seq is corrupt or a parent_index dangles the walk
// terminates at LT_INDEX_NONE without dereferencing invalid memory, per
// the LT_MAX_NODES bound check on every index read (see layer_tree_
// node_walk_next_dfs).
//
// 7.2 REVERSE-ORDER AGGREGATION  (layer_tree_aggregate_damage)
// ------------------------------------------------------------
//
// Given the topological invariant (§4.2), a single pass from
// i = node_count-1 down to 1 (root is at i=0) lifts each child's
// (subtree_damage_seq, bbox) to its parent:
//
//   for i in (node_count-1)..=1:
//       p = nodes[i].parent_index
//       if p != LT_INDEX_NONE and p < node_count:
//           if nodes[i].subtree_damage_seq > nodes[p].subtree_damage_seq:
//               nodes[p].subtree_damage_seq = nodes[i].subtree_damage_seq
//           nodes[p].bbox = bbox_union(nodes[p].bbox, nodes[i].bbox)
//
// After the pass, the root's bbox is the minimal repaint region and the
// root's subtree_damage_seq is the max child sequence. The compositor
// reads {root_bbox, root_seq} and issues one scanout blit per damaged
// pixel rect. Empty bboxes (w=0 OR h=0) contribute nothing to the union
// -- the bbox_union helper handles the empty operand explicitly.
//
// UNION MATH DISCIPLINE: the on-row bbox halves are declared i32 in
// §4.2 to keep the shape general, but the union body treats them as
// UNSIGNED u32 in the u64 halves it packs. Damage rects in surface-
// local coordinates are naturally nonnegative; a layer whose transform
// gives it a negative origin must resolve to nonnegative surface-space
// coordinates BEFORE the compositor attaches its damage rect. The
// damage-attach helper (future kind_layer_tree.pdx cap_handler)
// enforces the nonnegative invariant at attach time. Under that
// invariant the union's min/max compares are unsigned (jbe/jae), which
// matches every other bounds check in this file.
//
// =============================================================================
// SECTION 8  FINGERPRINT
// =============================================================================
//
// One tag ending `[legacy: LAYER TREE COMMIT OK]` per softarch
// discipline. Emitted (in a future landing kind_layer_tree.pdx) via
// klog_s1_x1 by the commit body on successful aggregate + present. The
// string is data-only at THIS landing (mint body + dispatcher land as
// G7-M3-002 follow-ons); needs allowlisting in tools/verify-fingerprint-
// coverage.sh with reason "kind_layer_tree commit body not yet landed
// (Wave0-B6-06)". Allowlist wire-up is a separate landing per the
// batch's file-touch discipline (this landing is ONE file only).
//
// LABEL PREFIX: `lt_` (layer-tree) -- avoids paideia-as reserved-
// keyword collisions per feedback_paideia_as_reserved_labels; all ASM
// jump targets are `lt_<funcname>_<tag>`.

module LayerTree = structure {

  // ==========================================================================
  // SECTION A  Identity + rights + op catalog + failure taxonomy.
  // ==========================================================================

  pub let KIND_LAYER_TREE          : u64 = 0x1C2
  pub let LT_PARENT_KIND_WINDOW    : u64 = 0x1C1     // Wave0-B6-05 sibling.

  // Rights. The four "internal" bits (APPEND_LAYER, REORDER, ATTACH_
  // DAMAGE, TRAVERSE) belong to the compositor's own service cap on
  // this row; a client cap holds none of them (sealed).
  pub let R_LT_READ           : u64 = 0x001
  pub let R_LT_INVOKE         : u64 = 0x008
  pub let R_LT_REVOKE         : u64 = 0x010
  pub let R_LT_APPEND_LAYER   : u64 = 0x100
  pub let R_LT_MINT           : u64 = 0x200     // never handed out.
  pub let R_LT_OBSERVE        : u64 = 0x400
  pub let R_LT_TRAVERSE       : u64 = 0x800     // compositor-internal.
  pub let R_LT_REORDER        : u64 = 0x1000
  pub let R_LT_ATTACH_DAMAGE  : u64 = 0x2000
  pub let R_LT_ALL            : u64 = 0x3F19    // 0x1|0x8|0x10|0x100|0x200|0x400|0x800|0x1000|0x2000

  // Row-pool + arena sizing.
  pub let LT_MAX              : u64 = 4         // KIND-cap rows.
  pub let LT_ROW_BYTES        : u64 = 64        // one cache line per row.
  pub let LT_HEADER_BYTES     : u64 = 32        // per-arena tree header.
  pub let LT_NODE_BYTES       : u64 = 48        // per-node record.
  pub let LT_MAX_NODES        : u64 = 32        // per tree.
  pub let LT_ARENA_BYTES      : u64 = 1568      // 32 + 32*48.

  // Node/tree offset constants (byte offsets within an arena).
  pub let LT_HDR_OFF_COUNT_ROOT     : u64 = 0    // node_count[31:0] | root_index[63:32]
  pub let LT_HDR_OFF_WKID_SEALED    : u64 = 8    // window_kind_id[31:0] | sealed[63:32]
  pub let LT_HDR_OFF_TREE_SEQ       : u64 = 16   // tree_damage_seq
  pub let LT_HDR_OFF_RESERVED       : u64 = 24

  pub let LT_NODE_OFF_LKID_PARENT   : u64 = 0    // layer_kind_id[31:0] | parent_index[63:32]
  pub let LT_NODE_OFF_SIB_CHILD     : u64 = 8    // next_sibling[31:0] | first_child[63:32]
  pub let LT_NODE_OFF_BBOX_XY       : u64 = 16
  pub let LT_NODE_OFF_BBOX_WH       : u64 = 24
  pub let LT_NODE_OFF_SUBTREE_SEQ   : u64 = 32
  pub let LT_NODE_OFF_RESERVED      : u64 = 40

  // Sentinel indices + arg encodings.
  pub let LT_INDEX_NONE       : u64 = 0xFFFFFFFF     // u32 max = "no such node".
  pub let LT_VISIT_CONTINUE   : u64 = 0
  pub let LT_VISIT_STOP       : u64 = 1

  // Ops (arity 1).
  pub let LT_OP_QUERY_NODE_COUNT   : u64 = 0
  pub let LT_OP_QUERY_ROOT         : u64 = 1
  pub let LT_OP_QUERY_SEALED       : u64 = 2
  pub let LT_OP_QUERY_TREE_SEQ     : u64 = 3
  pub let LT_OP_QUERY_ROOT_BBOX    : u64 = 4
  pub let LT_OP_TRAVERSE_STEP      : u64 = 5
  pub let LT_OP_AGGREGATE_DAMAGE   : u64 = 6
  pub let LT_OP_DEBUG_PRINT        : u64 = 7
  pub let LT_OP_MAX                : u64 = 7

  // Failure taxonomy -- 0xFFFFEA40..0xFFFFEA4F (see file header §5).
  pub let LT_OK                    : u64 = 0
  pub let LT_TAIL_ENOSPC           : u64 = 0xFFFFEA4F
  pub let LT_TAIL_BAD_ARG          : u64 = 0xFFFFEA4E
  pub let LT_MINT_BAD_PARENT       : u64 = 0xFFFFEA4D
  pub let LT_MINT_BAD_RIGHTS       : u64 = 0xFFFFEA4C
  pub let LT_MINT_NOT_SEALED       : u64 = 0xFFFFEA4B
  pub let LT_MINT_BAD_NODE_COUNT   : u64 = 0xFFFFEA4A
  pub let LT_MINT_BAD_TOPOLOGY     : u64 = 0xFFFFEA49
  pub let LT_MINT_NO_ARENA         : u64 = 0xFFFFEA48
  pub let LT_BAD_SLOT              : u64 = 0xFFFFEA47
  pub let LT_BAD_NODE_INDEX        : u64 = 0xFFFFEA46
  pub let LT_WRONG_KIND            : u64 = 0xFFFFEA45
  pub let LT_REVOKE_ALREADY        : u64 = 0xFFFFEA44
  pub let LT_UNSUP_OP              : u64 = 0xFFFFEA43
  pub let LT_TRAVERSE_END          : u64 = 0xFFFFEA42
  pub let LT_STOPPED_BY_VISITOR    : u64 = 0xFFFFEA41
  pub let LT_DECODE_BAD            : u64 = 0xFFFFFFFFFFFFFFFF

  // ==========================================================================
  // SECTION B  State cells.
  // ==========================================================================

  // KIND-cap row pool. LT_MAX rows * 64 bytes = 256 bytes = 32 u64.
  pub let mut _layer_tree_rows   : [u64; 32]  = uninit @align(64)

  // Per-row arena pool. LT_MAX arenas * 1568 bytes = 6272 bytes = 784 u64.
  pub let mut _layer_tree_arenas : [u64; 784] = uninit @align(64)

  // Per-row stats (mints/commits/traversals/refused). Bounds-checked
  // against 4 in lt_stats_bump / lt_stats_read.
  pub let mut _layer_tree_stats  : [u64; 4]   = uninit @align(64)

  pub let LT_ST_MINTS       : u64 = 0
  pub let LT_ST_COMMITS     : u64 = 1
  pub let LT_ST_TRAVERSALS  : u64 = 2
  pub let LT_ST_REFUSED     : u64 = 3

  // Fingerprint tag. Data-only at this landing; needs allowlisting in
  // tools/verify-fingerprint-coverage.sh with reason
  // "kind_layer_tree commit body not yet landed (Wave0-B6-06)" until
  // the sibling kind_layer_tree.pdx dispatcher lands and emits it via
  // klog_s1_x1 on every successful commit.
  pub let lt_commit_ok_msg : [u8; 52] = "layer tree commit ok [legacy: LAYER TREE COMMIT OK]\0"

  // ==========================================================================
  // SECTION C  Validators (mint-time).
  // ==========================================================================

  // lt_rights_valid(r) -> 1 iff r subset of R_LT_ALL (0x3F19).
  pub let lt_rights_valid : (u64) -> u64 !{} @{} =
    fn (r: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B6-06 (paideia-os #2256): subset test against R_LT_ALL = 0x3F19. Labels prefixed lt_rv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x3F19;
        and rax, r10;
        cmp rax, rdi;
        jne lt_rv_no;
        mov rax, 1;
        ret;
      lt_rv_no:
        xor rax, rax;
        ret
      }
    }

  // lt_node_count_valid(n) -> 1 iff n in [1, LT_MAX_NODES]. The tree
  // MUST have at least a root (n==0 is refused; a "windowless layer
  // tree" is not a valid cap).
  pub let lt_node_count_valid : (u64) -> u64 !{} @{} =
    fn (n: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B6-06 (paideia-os #2256): 1 iff n in [1, LT_MAX_NODES(32)]. Empty trees refused (a valid tree carries at least a background layer at index 0). Labels prefixed lt_ncv_.",
      block: {
        cmp rdi, 0;
        je  lt_ncv_no;
        mov r10, 32;
        cmp rdi, r10;
        ja  lt_ncv_no;
        mov rax, 1;
        ret;
      lt_ncv_no:
        xor rax, rax;
        ret
      }
    }

  // lt_index_valid(i, node_count) -> 1 iff i < node_count. Used at
  // every node-index dereference in walk + aggregate to keep an
  // out-of-range value from falling off the arena.
  pub let lt_index_valid : (u64, u64) -> u64 !{} @{} =
    fn (i: u64) (node_count: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B6-06 (paideia-os #2256): 1 iff i < node_count. The LT_INDEX_NONE sentinel (0xFFFFFFFF) also fails this check because node_count <= 32 << 0xFFFFFFFF. Labels prefixed lt_iv_.",
      block: {
        cmp rdi, rsi;
        jae lt_iv_no;
        mov rax, 1;
        ret;
      lt_iv_no:
        xor rax, rax;
        ret
      }
    }

  // lt_sealed_valid(s) -> 1 iff s == 1. A KIND_LAYER_TREE minted with
  // sealed==0 is a protocol error; the compositor is the only mint-
  // authorised holder and always mints sealed. See §2(b).
  pub let lt_sealed_valid : (u64) -> u64 !{} @{} =
    fn (s: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B6-06 (paideia-os #2256): 1 iff s == 1. Sealed-subtree discipline is not optional at this landing; any future 'debug unsealed' path lands as a distinct KIND (KIND_LAYER_TREE_SNAPSHOT) rather than a flag on this row. Labels prefixed lt_sv_.",
      block: {
        cmp rdi, 1;
        jne lt_sv_no;
        mov rax, 1;
        ret;
      lt_sv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // SECTION D  Packers (row + node/header word encoders).
  // ==========================================================================

  // lt_pack_hdr_row(parent_window_slot, sealed) -> row header word.
  // in_use[63:56] is left zero; the alloc path sets it. sealed bit
  // sits at [16:16]; parent_window_slot at [15:8].
  pub let lt_pack_hdr_row : (u64, u64) -> u64 !{} @{} =
    fn (parent_window_slot: u64) (sealed: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B6-06 (paideia-os #2256): pack KIND-cap row header: parent_window_slot[15:8] | sealed[16:16]. in_use bit is stamped by lt_row_alloc's success tail. Labels prefixed lt_phr_.",
      block: {
        mov rax, rdi;
        and rax, 0xFF;
        shl rax, 8;
        mov r10, rsi;
        and r10, 0x1;
        shl r10, 16;
        or  rax, r10;
        ret
      }
    }

  // lt_pack_u32_pair(lo, hi) -> lo[31:0] | hi[63:32]. Reused for
  // every (u32, u32) header/node word.
  pub let lt_pack_u32_pair : (u64, u64) -> u64 !{} @{} =
    fn (lo: u64) (hi: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B6-06 (paideia-os #2256): pack (u32, u32) -> u64 with lo at [31:0] and hi at [63:32]. Reused for header (count|root), (wkid|sealed), and node (lkid|parent), (sib|child), (x|y), (w|h) pairs. Labels prefixed lt_ppr_.",
      block: {
        mov rax, rdi;
        and rax, 0xFFFFFFFF;
        mov r10, rsi;
        and r10, 0xFFFFFFFF;
        shl r10, 32;
        or  rax, r10;
        ret
      }
    }

  // lt_pack_arena_ref(arena_slot) -> arena_slot[7:0] | reserved.
  pub let lt_pack_arena_ref : (u64) -> u64 !{} @{} =
    fn (arena_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B6-06 (paideia-os #2256): pack the arena_ref word (arena_slot at low 8 bits). Labels prefixed lt_par_.",
      block: {
        mov rax, rdi;
        and rax, 0xFF;
        ret
      }
    }

  // ==========================================================================
  // SECTION E  Arena address arithmetic.
  //
  // Arena base pointer = _layer_tree_arenas + arena_slot * LT_ARENA_BYTES
  //                    = _layer_tree_arenas + arena_slot * 1568.
  //
  // 1568 = 1024 + 512 + 32 = 49 * 32 = imul with a small constant. Every
  // caller either has the arena base pre-loaded (fast path) or resolves
  // it once via lt_arena_base(arena_slot).
  // ==========================================================================

  // lt_arena_base(arena_slot) -> ptr | LT_INDEX_NONE-shaped 0.
  pub let lt_arena_base : (u64) -> u64 !{mem} @{} =
    fn (arena_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B6-06 (paideia-os #2256): arena base pointer = _layer_tree_arenas + arena_slot * LT_ARENA_BYTES(1568). Bounds-checked against LT_MAX(4); OOB returns 0 (caller compares against zero before dereferencing). Labels prefixed lt_ab_.",
      block: {
        mov r10, 4;
        cmp rdi, r10;
        jae lt_ab_no;
        lea r10, [rip + _layer_tree_arenas];
        mov r11, rdi;
        imul r11, r11, 1568;
        add r10, r11;
        mov rax, r10;
        ret;
      lt_ab_no:
        xor rax, rax;
        ret
      }
    }

  // lt_node_addr(arena_base, node_index) -> ptr (no bounds check;
  // caller MUST have validated node_index < node_count first).
  pub let lt_node_addr : (u64, u64) -> u64 !{} @{} =
    fn (arena_base: u64) (node_index: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B6-06 (paideia-os #2256): node address = arena_base + LT_HEADER_BYTES(32) + node_index * LT_NODE_BYTES(48). Precondition: caller validated node_index via lt_index_valid. Labels prefixed lt_na_.",
      block: {
        mov rax, rdi;
        add rax, 32;                     // skip header
        mov r10, rsi;
        imul r10, r10, 48;
        add rax, r10;
        ret
      }
    }

  // ==========================================================================
  // SECTION F  Header + node field accessors (read-side).
  //
  // Field extraction from the packed u64 words. Every accessor takes
  // an arena_base (or node_base) pointer and returns the low-32-bit
  // (or full-64-bit) field zero-extended into rax. All accessors are
  // pure -- no writes -- and safe to call from a walk callback.
  // ==========================================================================

  pub let lt_hdr_node_count : (u64) -> u64 !{mem} @{} =
    fn (arena_base: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B6-06 (paideia-os #2256): read node_count from hdr_words0[31:0]. Labels prefixed lt_hnc_.",
      block: {
        mov rax, [rdi + 0];
        and rax, 0xFFFFFFFF;
        ret
      }
    }

  pub let lt_hdr_root_index : (u64) -> u64 !{mem} @{} =
    fn (arena_base: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B6-06 (paideia-os #2256): read root_index from hdr_words0[63:32]. Labels prefixed lt_hri_.",
      block: {
        mov rax, [rdi + 0];
        shr rax, 32;
        ret
      }
    }

  pub let lt_hdr_window_kind_id : (u64) -> u64 !{mem} @{} =
    fn (arena_base: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B6-06 (paideia-os #2256): read window_kind_id from hdr_words1[31:0]. Labels prefixed lt_hwk_.",
      block: {
        mov rax, [rdi + 8];
        and rax, 0xFFFFFFFF;
        ret
      }
    }

  pub let lt_hdr_sealed : (u64) -> u64 !{mem} @{} =
    fn (arena_base: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B6-06 (paideia-os #2256): read sealed from hdr_words1[63:32]. Labels prefixed lt_hs_.",
      block: {
        mov rax, [rdi + 8];
        shr rax, 32;
        ret
      }
    }

  pub let lt_hdr_tree_seq : (u64) -> u64 !{mem} @{} =
    fn (arena_base: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B6-06 (paideia-os #2256): read tree_damage_seq (full u64) from hdr[+16]. Labels prefixed lt_hts_.",
      block: {
        mov rax, [rdi + 16];
        ret
      }
    }

  pub let lt_node_parent_index : (u64) -> u64 !{mem} @{} =
    fn (node_base: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B6-06 (paideia-os #2256): read parent_index from node_words0[63:32]. Labels prefixed lt_npi_.",
      block: {
        mov rax, [rdi + 0];
        shr rax, 32;
        ret
      }
    }

  pub let lt_node_next_sibling : (u64) -> u64 !{mem} @{} =
    fn (node_base: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B6-06 (paideia-os #2256): read next_sibling_index from node_words1[31:0]. Labels prefixed lt_nns_.",
      block: {
        mov rax, [rdi + 8];
        and rax, 0xFFFFFFFF;
        ret
      }
    }

  pub let lt_node_first_child : (u64) -> u64 !{mem} @{} =
    fn (node_base: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B6-06 (paideia-os #2256): read first_child_index from node_words1[63:32]. Labels prefixed lt_nfc_.",
      block: {
        mov rax, [rdi + 8];
        shr rax, 32;
        ret
      }
    }

  pub let lt_node_subtree_seq : (u64) -> u64 !{mem} @{} =
    fn (node_base: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B6-06 (paideia-os #2256): read subtree_damage_seq (full u64) from node[+32]. Labels prefixed lt_nss_.",
      block: {
        mov rax, [rdi + 32];
        ret
      }
    }

  // ==========================================================================
  // SECTION G  DFS successor step.
  //
  // layer_tree_node_walk_next_dfs(arena_base, cur_index) -> next_index.
  //
  // Stable-order rule (§7.1):
  //   1. if cur has first_child != NONE          -> next = first_child
  //   2. else while cur != NONE:
  //        if cur has next_sibling != NONE       -> next = next_sibling
  //        else cur = cur.parent_index
  //   3. if walked past root                     -> next = LT_INDEX_NONE
  //
  // The walk NEVER dereferences a node whose index >= node_count. Every
  // parent-index / sibling-index / child-index read is guarded by an
  // index bounds check against the arena's node_count.
  // ==========================================================================

  pub let layer_tree_node_walk_next_dfs : (u64, u64) -> u64 !{mem} @{} =
    fn (arena_base: u64) (cur_index: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B6-06 (paideia-os #2256): DFS successor with bounds-checked node reads. Loop-carried state: rbx=arena_base, r12=cur_index cursor, r13=node_count. Three callee-save pushes leave rsp%16==0 at entry to every nested call (entry rsp%16==8, three 8-byte pushes -> rsp%16==0). LT_INDEX_NONE returned iff walk fell off the root. Labels prefixed lt_wn_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov  rbx, rdi;
        mov  r12, rsi;
        mov  rdi, rbx;
        call lt_hdr_node_count;
        mov  r13, rax;

        // Bounds-check cur_index once at entry.
        cmp  r12, r13;
        jae  lt_wn_end;

        // Step 1: first_child?
        mov  rdi, rbx;
        mov  rsi, r12;
        call lt_node_addr;
        mov  rdi, rax;
        call lt_node_first_child;
        cmp  rax, r13;
        jae  lt_wn_try_sibling;
        // In-range child -> return it.
        jmp  lt_wn_out;

      lt_wn_try_sibling:
        // Step 2: walk up chain until we find a sibling.
        // Precondition: r12 is a valid index (checked at entry / loop tail).
        mov  rdi, rbx;
        mov  rsi, r12;
        call lt_node_addr;
        mov  rdi, rax;
        call lt_node_next_sibling;
        cmp  rax, r13;
        jae  lt_wn_walk_up;
        jmp  lt_wn_out;

      lt_wn_walk_up:
        // r12 = r12.parent_index
        mov  rdi, rbx;
        mov  rsi, r12;
        call lt_node_addr;
        mov  rdi, rax;
        call lt_node_parent_index;
        mov  r12, rax;
        cmp  r12, r13;
        jae  lt_wn_end;
        jmp  lt_wn_try_sibling;

      lt_wn_end:
        mov  rax, 0xFFFFFFFF;

      lt_wn_out:
        pop  r13;
        pop  r12;
        pop  rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION H  Full ordered walk with visitor callback.
  //
  // layer_tree_walk_ordered(arena_base, visit_fn) -> LT_OK
  //                                                | LT_STOPPED_BY_VISITOR
  //                                                | LT_BAD_NODE_INDEX.
  //
  // visit_fn signature: (arena_base, node_index) -> u64
  //   returns LT_VISIT_CONTINUE(0) to keep walking, LT_VISIT_STOP(1)
  //   to short-circuit. Indirect call via `call rax` in the shape
  //   vops.pdx (src/kernel/core/fs/vops.pdx) established for the
  //   kernel: SysV entry rsp%16==8, one alignment pad (sub rsp,8 /
  //   add rsp,8) around the indirect call.
  // ==========================================================================

  pub let layer_tree_walk_ordered : (u64, u64) -> u64 !{mem} @{} =
    fn (arena_base: u64) (visit_fn: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B6-06 (paideia-os #2256): stable-order DFS driving a visit_fn via `call rax` (indirect-call pattern mirrors vops.pdx dispatchers). Loop-carried: rbx=arena_base, r12=visit_fn, r13=cur_index, r14=node_count. Four callee-save pushes leave rsp%16==8; add sub rsp,8 pad around each nested call so callee sees rsp%16==0 per SysV. Terminates on visitor STOP, on walk-past-root, or on any node index >= node_count (defensive; walk_next_dfs already guards). Labels prefixed lt_wo_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov  rbx, rdi;
        mov  r12, rsi;

        // Load node_count and starting index (root).
        sub  rsp, 8;
        mov  rdi, rbx;
        call lt_hdr_node_count;
        mov  r14, rax;
        mov  rdi, rbx;
        call lt_hdr_root_index;
        mov  r13, rax;
        add  rsp, 8;

        // Empty tree or malformed root -> just OK, nothing to walk.
        cmp  r14, 0;
        je   lt_wo_ok;
        cmp  r13, r14;
        jae  lt_wo_ok;

      lt_wo_loop:
        // Call visit_fn(arena_base, cur_index) via `call rax`.
        sub  rsp, 8;
        mov  rdi, rbx;
        mov  rsi, r13;
        mov  rax, r12;
        call rax;
        add  rsp, 8;
        cmp  rax, 1;
        je   lt_wo_stopped;

        // Advance cur_index via lt_node_walk_next_dfs.
        sub  rsp, 8;
        mov  rdi, rbx;
        mov  rsi, r13;
        call layer_tree_node_walk_next_dfs;
        mov  r13, rax;
        add  rsp, 8;

        cmp  r13, r14;
        jae  lt_wo_ok;
        jmp  lt_wo_loop;

      lt_wo_stopped:
        mov  rax, 0xFFFFEA41;                // LT_STOPPED_BY_VISITOR
        jmp  lt_wo_out;

      lt_wo_ok:
        xor  rax, rax;

      lt_wo_out:
        pop  r14;
        pop  r13;
        pop  r12;
        pop  rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION I  Bbox union helper (in-place onto parent node).
  //
  // lt_bbox_union_into_parent(parent_base, child_base) -> ().
  //
  // Rule: if parent has empty bbox (w==0 or h==0), take child's bbox
  // verbatim. Otherwise compute:
  //   nx1 = min(parent.x, child.x)
  //   ny1 = min(parent.y, child.y)
  //   nx2 = max(parent.x + parent.w, child.x + child.w)
  //   ny2 = max(parent.y + parent.h, child.y + child.h)
  //   parent.bbox = (nx1, ny1, nx2 - nx1, ny2 - ny1)
  //
  // All arithmetic is 32-bit signed (i32); the packed word carries
  // (x, y) at +16 and (w, h) at +24 in i32 halves.
  //
  // If the child bbox is itself empty (w==0 or h==0) the parent is
  // left unchanged.
  // ==========================================================================

  // lt_bbox_union_into_parent -- bbox union onto parent, in-place.
  // Called from layer_tree_aggregate_damage.
  //
  // Coordinate discipline: bboxes are in surface-local space and are
  // treated as NONNEGATIVE u32 -- the standard case for damage-region
  // coordinates. A layer with a negative-origin transform must resolve
  // to nonnegative surface-space coordinates BEFORE its damage rect is
  // attached; the compositor's damage-attach helper enforces that
  // (future landing kind_layer_tree.pdx cap_handler). Under the u32
  // discipline the min/max compares below are UNSIGNED (jbe/jae),
  // which the encoder handles with the same shape as every other
  // row/pool bound check in this file.
  //
  // Callee-save assignment (six pushes):
  //   rbx = parent_base
  //   r12 = child_base
  //   r13 = px  (u32, zero-extended)
  //   r14 = py
  //   r15 = pw
  //   rbp = ph
  //
  // Six pushes + entry rsp%16==8 -> rsp%16==8 (even count preserves
  // parity); leaf body with no nested calls so no further alignment
  // work is needed. All four parent originals are read into r13..rbp
  // BEFORE any packed-word write, so a partial write can never
  // invalidate a still-needed edge value.
  pub let lt_bbox_union_into_parent : (u64, u64) -> () !{mem} @{} =
    fn (parent_base: u64) (child_base: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B6-06 (paideia-os #2256): bbox union onto parent, in-place, u32-unsigned. Empty-operand short-circuit + copy-child fast path + general case (min-of-origins, max-of-far-corners, subtract for width/height). Six callee-save pushes hold parent originals across the compute; child fields stay in caller-scratch. Leaf body -- no nested calls. Labels prefixed lt_bu_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov  rbx, rdi;
        mov  r12, rsi;

        // Load child.wh word first for the empty-child short-circuit.
        mov  rax, [r12 + 24];
        mov  r10, rax;
        and  r10, 0xFFFFFFFF;                // r10 = cw (u32 in u64)
        cmp  r10, 0;
        je   lt_bu_out;
        mov  r11, rax;
        shr  r11, 32;                        // r11 = ch
        cmp  r11, 0;
        je   lt_bu_out;

        // Load parent originals into callee-save regs (all u32 zero-ext).
        mov  rax, [rbx + 16];
        mov  r13, rax;
        and  r13, 0xFFFFFFFF;                // r13 = px
        mov  r14, rax;
        shr  r14, 32;                        // r14 = py
        mov  rax, [rbx + 24];
        mov  r15, rax;
        and  r15, 0xFFFFFFFF;                // r15 = pw
        mov  rbp, rax;
        shr  rbp, 32;                        // rbp = ph

        // Parent empty? -> copy child verbatim.
        cmp  r15, 0;
        je   lt_bu_copy;
        cmp  rbp, 0;
        je   lt_bu_copy;
        jmp  lt_bu_general;

      lt_bu_copy:
        mov  rax, [r12 + 16];
        mov  [rbx + 16], rax;
        mov  rax, [r12 + 24];
        mov  [rbx + 24], rax;
        jmp  lt_bu_out;

      lt_bu_general:
        // Load child (cx, cy) into r8/r9. (cw is in r10, ch in r11.)
        mov  rax, [r12 + 16];
        mov  r8, rax;
        and  r8, 0xFFFFFFFF;                 // r8 = cx
        mov  r9, rax;
        shr  r9, 32;                         // r9 = cy

        // nx1 = min(px, cx). Result -> rdi (u32 zero-ext).
        mov  rdi, r13;
        cmp  rdi, r8;
        jbe  lt_bu_nx1_ok;
        mov  rdi, r8;
      lt_bu_nx1_ok:

        // ny1 = min(py, cy). Result -> rsi (u32 zero-ext).
        mov  rsi, r14;
        cmp  rsi, r9;
        jbe  lt_bu_ny1_ok;
        mov  rsi, r9;
      lt_bu_ny1_ok:

        // nx2 = max(px + pw, cx + cw). Result -> rax.
        mov  rax, r13;
        add  rax, r15;                       // rax = px + pw
        mov  rcx, r8;
        add  rcx, r10;                       // rcx = cx + cw
        cmp  rax, rcx;
        jae  lt_bu_nx2_ok;
        mov  rax, rcx;
      lt_bu_nx2_ok:
        // nw = nx2 - nx1
        sub  rax, rdi;
        // Stash nw in r10 (was cw; no longer needed).
        mov  r10, rax;

        // ny2 = max(py + ph, cy + ch). Result -> rax.
        mov  rax, r14;
        add  rax, rbp;                       // rax = py + ph
        mov  rcx, r9;
        add  rcx, r11;                       // rcx = cy + ch
        cmp  rax, rcx;
        jae  lt_bu_ny2_ok;
        mov  rax, rcx;
      lt_bu_ny2_ok:
        // nh = ny2 - ny1
        sub  rax, rsi;
        // Stash nh in r11 (was ch; no longer needed).
        mov  r11, rax;

        // Pack (nx1, ny1) into rax and write to +16.
        mov  rax, rdi;
        and  rax, 0xFFFFFFFF;
        mov  rcx, rsi;
        and  rcx, 0xFFFFFFFF;
        shl  rcx, 32;
        or   rax, rcx;
        mov  [rbx + 16], rax;

        // Pack (nw, nh) into rax and write to +24.
        mov  rax, r10;
        and  rax, 0xFFFFFFFF;
        mov  rcx, r11;
        and  rcx, 0xFFFFFFFF;
        shl  rcx, 32;
        or   rax, rcx;
        mov  [rbx + 24], rax;

      lt_bu_out:
        pop  rbp;
        pop  r15;
        pop  r14;
        pop  r13;
        pop  r12;
        pop  rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION J  Aggregate damage (reverse-order single pass).
  //
  // layer_tree_aggregate_damage(arena_base) -> LT_OK.
  //
  // Precondition: topological invariant (§4.2) holds -- for every
  // non-root node i, nodes[i].parent_index < i.  Under that invariant a
  // single pass i = (node_count - 1) .. 1 lifts each node's damage into
  // its parent; after the pass the root's bbox and subtree_damage_seq
  // aggregate the whole tree.
  //
  // Root (i == 0) has no parent to lift into, so the pass stops at i=1
  // and the root's own fields carry the aggregated result.
  //
  // Loop-carried:
  //   rbx = arena_base
  //   r12 = i (cursor, u64)
  //   r13 = node_count (u64)
  //   r14 = current_node_base (ptr)
  //   r15 = parent_node_base (ptr)
  //
  // Five pushes + entry rsp%16==8 -> after pushes rsp%16==0; add
  // sub rsp,8 pad around each nested call.
  // ==========================================================================

  pub let layer_tree_aggregate_damage : (u64) -> u64 !{mem} @{} =
    fn (arena_base: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B6-06 (paideia-os #2256): single reverse-order pass propagating each node's (subtree_damage_seq, bbox) up to its parent. Assumes topological invariant (parent_index[i] < i for i > 0); the mint body enforces the invariant at cap-construction time. Five callee-save pushes leave rsp%16==0 for every nested call (entry rsp%16==8, five 8-byte pushes -> rsp%16==0). Labels prefixed lt_ad_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov  rbx, rdi;

        mov  rdi, rbx;
        call lt_hdr_node_count;
        mov  r13, rax;

        // Fewer than 2 nodes -> nothing to aggregate.
        cmp  r13, 2;
        jb   lt_ad_ok;

        // Start i at node_count - 1.
        mov  r12, r13;
        sub  r12, 1;

      lt_ad_loop:
        // current_node_base = lt_node_addr(arena_base, i)
        mov  rdi, rbx;
        mov  rsi, r12;
        call lt_node_addr;
        mov  r14, rax;

        // parent_index = current.parent_index
        mov  rdi, r14;
        call lt_node_parent_index;

        // If parent_index >= node_count (either LT_INDEX_NONE or
        // corrupt), skip this node.
        cmp  rax, r13;
        jae  lt_ad_step;

        // Additionally require parent_index < i (topological invariant).
        cmp  rax, r12;
        jae  lt_ad_step;

        // parent_node_base = lt_node_addr(arena_base, parent_index)
        mov  rdi, rbx;
        mov  rsi, rax;
        call lt_node_addr;
        mov  r15, rax;

        // Lift subtree_damage_seq if child > parent.
        // child_seq = [r14 + 32] ; parent_seq = [r15 + 32]
        mov  rax, [r14 + 32];
        mov  r10, [r15 + 32];
        cmp  rax, r10;
        jbe  lt_ad_bbox;
        mov  [r15 + 32], rax;

      lt_ad_bbox:
        // Union child bbox into parent bbox.
        mov  rdi, r15;
        mov  rsi, r14;
        call lt_bbox_union_into_parent;

      lt_ad_step:
        cmp  r12, 1;
        jbe  lt_ad_ok;
        sub  r12, 1;
        jmp  lt_ad_loop;

      lt_ad_ok:
        xor  rax, rax;

        pop  r15;
        pop  r14;
        pop  r13;
        pop  r12;
        pop  rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION K  KIND-cap row-pool primitives (mint / free / valid).
  //
  // A KIND_LAYER_TREE row lives in _layer_tree_rows and points at an
  // arena slot in _layer_tree_arenas.  Rows and arenas share the same
  // slot index (row i owns arena i); the arena_ref field is present so
  // a future landing can decouple them (e.g. an arena pool larger than
  // the row pool for pathological workloads).
  // ==========================================================================

  pub let lt_row_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B6-06 (paideia-os #2256): 1 iff row_id < LT_MAX(4) and in_use. Address compute row_id * 64 via shl 6. Labels prefixed lt_rv2_.",
      block: {
        mov r10, 4;
        cmp rdi, r10;
        jae lt_rv2_no;
        lea r10, [rip + _layer_tree_rows];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  lt_rv2_no;
        mov rax, 1;
        ret;
      lt_rv2_no:
        xor rax, rax;
        ret
      }
    }

  // lt_row_alloc(hdr, arena_ref, a11y_ref) -> row_id | LT_TAIL_ENOSPC.
  //
  // hdr:       lt_pack_hdr_row output (in_use=0, parent_slot at [15:8],
  //            sealed at [16:16])
  // arena_ref: lt_pack_arena_ref output (arena_slot at [7:0])
  // a11y_ref:  a11y_tree_slot at [15:0]; may be zero (no a11y binding)
  //
  // Low-first scan; the found row's in_use bit is stamped by ORing
  // 1<<56 into hdr on the claim path. Stats0 (mints) is pre-incremented
  // to 1; stats1 (commits) starts at zero.
  pub let lt_row_alloc : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (arena_ref: u64) (a11y_ref: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B6-06 (paideia-os #2256): claim one KIND_LAYER_TREE row. Low-first scan (rbx=idx) over LT_MAX(4) rows of 64 bytes. Four callee-save pushes (rbx=idx, r12=hdr, r13=arena_ref, r14=a11y_ref) + sub rsp,8 pad = 40 B => rsp%16==0 for the no-nested-call scan (entry rsp%16==8, +40 = %16==0). Labels prefixed lt_ra_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        sub  rsp, 8;

        mov  r12, rdi;
        mov  r13, rsi;
        mov  r14, rdx;

        xor  rbx, rbx;
      lt_ra_scan:
        cmp  rbx, 4;
        jae  lt_ra_enospc;

        lea  r10, [rip + _layer_tree_rows];
        mov  r11, rbx;
        shl  r11, 6;
        add  r10, r11;

        mov  rax, [r10 + 0];
        shr  rax, 56;
        cmp  rax, 0;
        je   lt_ra_claim;

        add  rbx, 1;
        jmp  lt_ra_scan;

      lt_ra_claim:
        mov  rax, r12;
        mov  r11, 1;
        shl  r11, 56;
        or   rax, r11;
        mov  [r10 + 0],  rax;                // header (with in_use=1)
        mov  [r10 + 8],  r13;                // arena_ref
        mov  rax, 1;
        mov  [r10 + 16], rax;                // stats0 mints = 1
        xor  rax, rax;
        mov  [r10 + 24], rax;                // stats1 commits = 0
        mov  [r10 + 32], r14;                // a11y_ref
        mov  [r10 + 40], rax;                // reserved
        mov  [r10 + 48], rax;
        mov  [r10 + 56], rax;
        mov  rax, rbx;                       // row_id
        jmp  lt_ra_out;

      lt_ra_enospc:
        mov  rax, 0xFFFFEA4F;                // LT_TAIL_ENOSPC

      lt_ra_out:
        add  rsp, 8;
        pop  r14;
        pop  r13;
        pop  r12;
        pop  rbx;
        ret
      }
    }

  pub let lt_row_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B6-06 (paideia-os #2256): scrub one row (all eight u64 words). Bounds-checked against LT_MAX(4). Does NOT scrub the backing arena; that is a separate op the compositor may skip when re-minting into the same arena. Labels prefixed lt_rf_.",
      block: {
        mov  r10, 4;
        cmp  rdi, r10;
        jae  lt_rf_out;
        lea  r10, [rip + _layer_tree_rows];
        mov  r11, rdi;
        shl  r11, 6;
        add  r10, r11;
        xor  rax, rax;
        mov  [r10 + 0],  rax;
        mov  [r10 + 8],  rax;
        mov  [r10 + 16], rax;
        mov  [r10 + 24], rax;
        mov  [r10 + 32], rax;
        mov  [r10 + 40], rax;
        mov  [r10 + 48], rax;
        mov  [r10 + 56], rax;
      lt_rf_out:
        ret
      }
    }

  // ==========================================================================
  // SECTION L  Stats + init.
  // ==========================================================================

  pub let lt_stats_bump : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B6-06 (paideia-os #2256): bounds-checked counter bump against LT_ST_REFUSED+1=4. Load-inc-store idiom (no `add reg, [mem]`). Labels prefixed lt_sb_.",
      block: {
        cmp rdi, 4;
        jae lt_sb_out;
        lea r10, [rip + _layer_tree_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      lt_sb_out:
        ret
      }
    }

  pub let lt_stats_read : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B6-06 (paideia-os #2256): bounds-checked counter read; OOB -> 0. Labels prefixed lt_sr_.",
      block: {
        cmp rdi, 4;
        jae lt_sr_zero;
        lea r10, [rip + _layer_tree_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      lt_sr_zero:
        xor rax, rax;
        ret
      }
    }

  // lt_init(): zero row pool, arena pool, stats. Defensive re-scrub;
  // .bss is already zero at real boot. Mirrors hmk_init / rdk_init.
  pub let lt_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B6-06 (paideia-os #2256): zero _layer_tree_rows (32 u64), _layer_tree_arenas (784 u64), _layer_tree_stats (4 u64). Defensive; .bss is already zero at real boot. Labels prefixed lt_ini_.",
      block: {
        lea r10, [rip + _layer_tree_rows];
        xor rax, rax;
        xor rcx, rcx;
      lt_ini_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  lt_ini_rows;

        lea r10, [rip + _layer_tree_arenas];
        xor rcx, rcx;
      lt_ini_arenas:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 784;
        jb  lt_ini_arenas;

        lea r10, [rip + _layer_tree_stats];
        xor rcx, rcx;
      lt_ini_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  lt_ini_stats;
        ret
      }
    }

  // ==========================================================================
  // SECTION M  Meta fingerprint.
  //
  // pdx_kind_layer_tree_meta -- ONE tag ending [legacy: ... OK] per
  // softarch discipline. See §8. Data-only at this landing.
  // ==========================================================================

  pub let pdx_kind_layer_tree_meta : [u8; 54] = "pdx kind layer tree meta [legacy: LAYER TREE META OK]\0"
}
