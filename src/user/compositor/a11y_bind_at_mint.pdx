// src/user/compositor/a11y_bind_at_mint.pdx -- Wave0-B9-08 (paideia-os #2305)
//
// THE P4 STRUCTURAL GATE, MADE UNAVOIDABLE-BY-CONSTRUCTION.
//
// src/user/compositor/window_kind.pdx §Section 4 refuses at mint any
// KIND_WINDOW row whose a11y_tree_kind_id is zero (WIN_MINT_NO_A11Y =
// 0xFFFFEAA9). That refusal is the P4 mitigation from the next-wave
// synthesis review: a11y is a first-class protocol participant, not a
// sidecar bolted on later. But a refusal by itself is only half the
// property -- the OTHER half is that no reachable caller should ever
// have to remember to mint the a11y tree before calling window_mint.
// A trip-hazard rule is a rule that gets forgotten. This module is the
// wrapper every window mint caller in the compositor uses, and it makes
// the P4 gate STRUCTURALLY UNAVOIDABLE: the tree is either supplied by
// the caller (rare -- only when the caller is composing a tree from
// toolkit hints ahead of time) or MINTED HERE, on the caller's behalf,
// via a11y_tree_mint(window_id) before the window_mint hand-off.
//
// After a successful a11y_bind_at_mint_wrap call, the following holds
// unconditionally:
//   * window_row_a11y_tree(returned_row_id) is a nonzero u32.
//   * that u32 names a live KIND_A11Y_TREE row that was already minted
//     (either by the caller, then bump _abm_stats[EXPLICIT], or by
//     this file just now, then bump _abm_stats[AUTOBIND]).
//   * a screen reader that later subscribes to that tree via
//     a11y_tree_subscribe(tree_row_id, sub_cap) will observe the
//     window's a11y state before the window has been PRESENTed for
//     the first time -- because the tree has already been minted by
//     the time window_mint returns.
//
// This is NOT a KIND cap. There is no row pool, no rights bitmask, no
// op catalog, no cap_handler routing. It is one logic module with three
// helpers, four failure codes, and three counters that measure the
// (autobind, explicit, refused) mix. The a11y-tree cap (KIND_A11Y_TREE
// = 0x1D3) and the window cap (KIND_WINDOW = 0x1C1) are the real
// capabilities; this module orchestrates their pairing at mint time.
//
// =============================================================================
// SECTION 0  RELATIONSHIP TO SIBLINGS
// =============================================================================
//
//   src/user/compositor/window_kind.pdx  (Wave0-B6-05, KIND_WINDOW = 0x1C1)
//     Owns window_mint. Refuses a11y_tree_kind_id == 0 unconditionally
//     with WIN_MINT_NO_A11Y (0xFFFFEAA9). Exposes window_row_a11y_tree
//     (row_id) for the post-mint verify step; returns the actual u32
//     tree slot for a live row and 0xFFFFFFFFFFFFFFFF for a bad row.
//
//   src/user/a11y/tree_kind.pdx  (Wave0-B8-03, KIND_A11Y_TREE = 0x1D3)
//     Owns a11y_tree_mint(window_kind_id). Returns the row_id (< A11Y_MAX
//     = 4, and used verbatim as the tree_kind_id in the window row's
//     a11y_tree slot) on success, or one of A11Y_MINT_BAD_WINDOW /
//     A11Y_MINT_NO_ARENA / A11Y_TAIL_ENOSPC (all >= A11Y_MAX) on failure.
//
// The two KIND caps already know how to refuse a bad pairing. What was
// missing was the FRIENDLY DEFAULT that autobinds a fresh tree when a
// caller does not care about the specific KIND_A11Y_TREE identity --
// the vast majority of window mints, in practice. Making that autobind
// a first-class wrapper (rather than each caller reimplementing "mint
// tree then mint window") is what turns the P4 gate from "trip-hazard
// callers must remember" into "wall you literally cannot walk through
// without a tree in hand".
//
// =============================================================================
// SECTION 1  API
// =============================================================================
//
// a11y_bind_at_mint_wrap(window_id, parent_surface, parent_window,
//                        z_order, tab_workspace_pack, a11y_tree_kind_id)
//     -> row_id (< ABM_WIN_MAX) | ABM_* sentinel
//
//   Six args, mirroring window_mint's own signature so callers pass
//   through verbatim. Behaviour:
//     * a11y_tree_kind_id == 0 -> mint a fresh KIND_A11Y_TREE via
//       a11y_tree_mint(window_id) and use the returned row_id in its
//       place. On a11y_tree_mint failure -> ABM_A11Y_MINT_FAILED (only
//       refused_count is bumped; autobind_count is NOT bumped because
//       the autobind did not succeed).
//     * a11y_tree_kind_id != 0 -> pass through unchanged. Caller
//       supplied a specific tree; explicit_bind_count is bumped BEFORE
//       the window_mint call so an accounting caller can see that the
//       explicit path was taken even if window_mint later refuses.
//     * window_mint returned a sentinel (>= ABM_WIN_MAX = 32)
//       -> ABM_WINDOW_MINT_FAILED. refused_count is bumped.
//       LEAK NOTE: on the autobind branch, the a11y tree that this
//       file just minted stays LIVE if window_mint refuses -- the row
//       is not rolled back. The leak is bounded by A11Y_MAX(4) trees
//       and preferable to a partial-revoke race window at this landing
//       size. A follow-on landing that adds a a11y_tree_revoke
//       rollback path (mirroring window_kind.pdx's window_revoke) is
//       tracked as a M2-follow-up in the P4 mitigation register.
//     * window_mint succeeded but window_row_a11y_tree(row_id) reads
//       back zero -> ABM_VERIFY_FAILED. refused_count is bumped. This
//       branch is UNREACHABLE by construction (window_kind.pdx's own
//       gate refuses zero at mint time and window_row_a11y_tree
//       reads the stored slot verbatim) but the check is here as a
//       cross-module invariant assert: if some future refactor of
//       window_kind.pdx quietly stops enforcing the gate, this
//       assert fires the moment a bind-with-tree=nonzero call
//       returns a row whose slot went to zero anyway.
//
// a11y_bind_verify(window_row_id) -> 1 iff row.a11y_tree_kind_id in
//                                    (0, 2^32).
//   Convenience wrapper over window_row_a11y_tree. Maps the u64 the
//   accessor returns to a boolean:
//     * live row with a valid tree slot -> u32 in (0, 2^32) -> 1
//     * live row somehow bearing 0 -> 0 (should not happen; see above)
//     * revoked / OOB row -> accessor returns 0xFFFFFFFFFFFFFFFF (>
//       2^32) -> 0
//   Callers that only want "the wrapper produced this row and the
//   invariant still holds" get 1 here without having to interpret the
//   accessor's sentinel encoding.
//
// a11y_bind_stats_autobind()      -> u64  monotonic autobind count.
// a11y_bind_stats_explicit_bind() -> u64  monotonic explicit-bind count.
// a11y_bind_stats_refused()       -> u64  monotonic refusal count.
// a11y_bind_stats_reset()         -> ()   zero all three (test/init only).
//
// The three individual accessors are inlined direct memory reads
// (no branch, no bounds check) rather than call-through-a-generic-
// stats-read helper: the counters live at fixed offsets in _abm_stats
// and the three-cell surface is small enough to enumerate.
//
// =============================================================================
// SECTION 2  FAILURE TAXONOMY 0xFFFFEBE0..0xFFFFEBEF
// =============================================================================
//
// Repo-wide grep at landing time (`grep -rE '0xFFFFEBE[0-9A-Fa-f]'` over
// src/ + design/) shows 0xFFFFEBEA..0xFFFFEBEF claimed by
// src/kernel/core/ipc/audit_journal_broker.pdx (AJB_REGISTER_BAD_ID
// down through AJB_DISPATCH_BAD_KIND) and 0xFFFFEBE0..0xFFFFEBE9 free.
// Three codes suffice at this landing (0xFFFFEBE9..0xFFFFEBE7),
// leaving 0xFFFFEBE0..0xFFFFEBE6 open for follow-on rollback / retry /
// diagnostic codes without a band re-allocation. The band is
// intentionally adjacent to audit_journal_broker's own band so the
// wider "compositor/broker P4-adjacent" grep set stays contiguous.
//
// =============================================================================
// SECTION 3  DISCIPLINE
// =============================================================================
//
// * Encoder rules: leaf counter primitives use r10/r11 scratch only;
//   the wrap function follows window_mint's own posture -- six callee-
//   save pushes + `sub rsp, 8` to bring rsp%16 to 0 for nested calls.
// * Labels: all `a11y_bind_<funcname>_<tag>` per the reserved-label
//   note (`loop`, `if` etc. are paideia-as keywords; every label here
//   is prefixed by its function so no bare-keyword collision is
//   possible). `a11y_bind_sre_step` in particular avoids naming the
//   `loop` keyword directly.
// * No float: every counter is u64, every arg is u64, every return is
//   u64. Follows design/kernel/no-fpu.md.
// * Fingerprint: data-only tag (pdx_kind_a11y_bind_at_mint_meta) with
//   the `[legacy: A11Y BIND AT MINT OK]` suffix for grep parity with
//   the sibling kind-cap tags (pdx_kind_window_meta, pdx_kind_a11y_
//   tree_meta). Emission body lands with the downstream compositor
//   dispatcher; the tag decl here reserves the canonical string and
//   is not yet emitted by any code path, so no golden line is required
//   and no fingerprint-coverage allowlist entry is needed at this
//   landing (unlike tree_kind.pdx / window_kind.pdx whose mint bodies
//   emit their own tags today -- this file's wrap function has no
//   klog emit yet).

module A11yBindAtMint = structure {

  // ==========================================================================
  // SECTION A  Failure taxonomy + counter identity + fingerprint tag.
  // ==========================================================================

  pub let ABM_OK                  : u64 = 0
  pub let ABM_A11Y_MINT_FAILED    : u64 = 0xFFFFEBE9
  pub let ABM_WINDOW_MINT_FAILED  : u64 = 0xFFFFEBE8
  pub let ABM_VERIFY_FAILED       : u64 = 0xFFFFEBE7

  // Counter slot ordinals for the four-cell _abm_stats array (three
  // live slots plus one reserved for future rollback counters -- the
  // extra cell rounds the array up to half a cache line and gives us
  // headroom to add a fourth counter without shrinking the alignment
  // pad).
  pub let ABM_ST_AUTOBIND         : u64 = 0
  pub let ABM_ST_EXPLICIT_BIND    : u64 = 1
  pub let ABM_ST_REFUSED          : u64 = 2

  // Row-pool ceilings mirrored from the sibling KIND caps this file
  // calls into. These are the "how do I tell a valid row_id from a
  // sentinel" thresholds -- window_mint returns a row_id in
  // [0, ABM_WIN_MAX) on success and a WIN_* code (>= ABM_WIN_MAX) on
  // failure; a11y_tree_mint returns a row_id in [0, ABM_A11Y_MAX) on
  // success and an A11Y_* code (>= ABM_A11Y_MAX) on failure. Duplicated
  // here rather than imported so the sentinel comparisons stay one-line
  // and encoder-obvious; if window_kind.pdx or tree_kind.pdx ever grows
  // its row pool, these two constants MUST be bumped in lockstep. The
  // comment intentionally names both source-of-truth files.
  pub let ABM_WIN_MAX             : u64 = 32       // window_kind.pdx WIN_MAX
  pub let ABM_A11Y_MAX            : u64 = 4        // tree_kind.pdx A11Y_MAX

  // THE ONE STATE CELL. Four u64 = 32 bytes = half a cache line.
  pub let mut _abm_stats : [u64; 4] = uninit @align(64)

  // Fingerprint tag. Data-only at this landing; emission wiring lands
  // when the compositor dispatcher grows a klog_s1_x1 call at the tail
  // of every successful a11y_bind_at_mint_wrap. Suffix `[legacy: A11Y
  // BIND AT MINT OK]` matches the pattern pdx_kind_window_meta and
  // pdx_kind_a11y_tree_meta use so grep tooling that scans for
  // "^pdx_kind_.*_meta" over src/**/*.pdx finds all three as a set.
  //
  // "pdx a11y bind at mint meta [legacy: A11Y BIND AT MINT OK]\0"
  // = 57 bytes of payload + 1 NUL terminator = 58 bytes total.
  pub let pdx_kind_a11y_bind_at_mint_meta : [u8; 58] = "pdx a11y bind at mint meta [legacy: A11Y BIND AT MINT OK]\0"

  // ==========================================================================
  // SECTION B  Counter primitives.
  //
  // The three inlined stats accessors are direct memory reads (no branch,
  // no bounds check). The bounds-checked bump primitive is here so the
  // wrap function can name a slot ordinal by constant (0/1/2) rather than
  // hand-inline the load-add-store idiom three times. Every counter cell
  // starts at 0 (zero-init .bss); a11y_bind_stats_reset re-scrubs
  // defensively on init paths that want the counters reset mid-life.
  // ==========================================================================

  pub let a11y_bind_stats_bump : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-08 (paideia-os #2305): bounds-checked counter bump (which < 3). Load-inc-store idiom (no `add reg, [mem]`) per encoder discipline. Labels prefixed a11y_bind_sb_.",
      block: {
        cmp rdi, 3;
        jae a11y_bind_sb_out;
        lea r10, [rip + _abm_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      a11y_bind_sb_out:
        ret
      }
    }

  pub let a11y_bind_stats_autobind : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-08 (paideia-os #2305): direct read of _abm_stats[ABM_ST_AUTOBIND=0]. No branch, no bounds check -- the slot is a compile-time constant. Labels prefixed a11y_bind_sa_.",
      block: {
        lea r10, [rip + _abm_stats];
        mov rax, [r10 + 0];
        ret
      }
    }

  pub let a11y_bind_stats_explicit_bind : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-08 (paideia-os #2305): direct read of _abm_stats[ABM_ST_EXPLICIT_BIND=1] at byte offset 8. Labels prefixed a11y_bind_se_.",
      block: {
        lea r10, [rip + _abm_stats];
        mov rax, [r10 + 8];
        ret
      }
    }

  pub let a11y_bind_stats_refused : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-08 (paideia-os #2305): direct read of _abm_stats[ABM_ST_REFUSED=2] at byte offset 16. Labels prefixed a11y_bind_sf_.",
      block: {
        lea r10, [rip + _abm_stats];
        mov rax, [r10 + 16];
        ret
      }
    }

  pub let a11y_bind_stats_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-08 (paideia-os #2305): scrub all four cells of _abm_stats (three live slots + one reserved for future rollback counters). Defensive; .bss is already zero at real boot. Encoder-safe short loop, no `add reg, [mem]`. Labels prefixed a11y_bind_sre_ (step-not-loop to avoid the paideia-as `loop` keyword collision documented in feedback_paideia_as_reserved_labels).",
      block: {
        lea r10, [rip + _abm_stats];
        xor rax, rax;
        xor rcx, rcx;
      a11y_bind_sre_step:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  a11y_bind_sre_step;
        ret
      }
    }

  // ==========================================================================
  // SECTION C  a11y_bind_verify -- convenience predicate over
  //                                window_row_a11y_tree.
  //
  // window_row_a11y_tree (window_kind.pdx §Section 9) returns either the
  // stored u32 tree slot (< 2^32, and nonzero for any row that came through
  // window_mint's P4 gate) OR the 0xFFFFFFFFFFFFFFFF sentinel for a bad
  // row. This predicate maps both refusal branches -- zero AND sentinel --
  // to false, and only the "live row with a real tree slot" branch to
  // true. One callee-save push (rbx=window_row_id): entry rsp%16==8, one
  // 8-byte push gives rsp%16==0 which is exactly what the nested `call
  // window_row_a11y_tree` needs at the callsite; no further pad required.
  // ==========================================================================

  pub let a11y_bind_verify : (u64) -> u64 !{mem} @{} =
    fn (window_row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-08 (paideia-os #2305): predicate over window_row_a11y_tree. 1 iff the accessor returns a u32 in (0, 2^32); 0 for both the zero-slot escape (unreachable by construction, see file header §1) and the 0xFFFFFFFFFFFFFFFF bad-row sentinel. One callee-save push (rbx=window_row_id) gives rsp%16==0 for the nested call. Labels prefixed a11y_bind_v_.",
      block: {
        push rbx;
        mov  rbx, rdi;                     // window_row_id
        mov  rdi, rbx;
        call window_row_a11y_tree;
        cmp  rax, 0;
        je   a11y_bind_v_no;
        mov  r10, 0xFFFFFFFF;
        cmp  rax, r10;
        ja   a11y_bind_v_no;
        mov  rax, 1;
        jmp  a11y_bind_v_out;
      a11y_bind_v_no:
        xor  rax, rax;
      a11y_bind_v_out:
        pop  rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION D  a11y_bind_at_mint_wrap -- THE P4-ENFORCEMENT WRAPPER.
  //
  // Signature matches window_mint verbatim so a caller replaces every
  // `call window_mint` with `call a11y_bind_at_mint_wrap` without
  // touching argument marshalling. Six args in the SysV integer regs;
  // no stack args.
  //
  //   rdi = window_id
  //   rsi = parent_surface
  //   rdx = parent_window
  //   rcx = z_order
  //   r8  = tab_workspace_pack
  //   r9  = a11y_tree_kind_id (0 == autobind)
  //
  // Six callee-save pushes + `sub rsp, 8` = 56 bytes = %16==0 at every
  // nested call (matches window_mint's own posture). Register assignments
  // across the whole body (all live across every nested call):
  //   rbx = window_id                (needed for a11y_tree_mint AND window_mint)
  //   r12 = parent_surface           (needed for window_mint)
  //   r13 = parent_window            (needed for window_mint)
  //   r14 = z_order                  (needed for window_mint)
  //   r15 = tab_workspace_pack       (needed for window_mint)
  //   rbp = a11y_tree_kind_id        (rewritten to autobound tree if 0 in)
  //
  // Gate order:
  //   (1) if a11y_tree_kind_id == 0 -> a11y_tree_mint(window_id); on
  //       failure -> ABM_A11Y_MINT_FAILED; on success bump AUTOBIND.
  //       Else bump EXPLICIT_BIND (accounting before the window_mint
  //       call so an accounting caller can distinguish explicit-tried-
  //       and-failed from autobind-tried-and-failed).
  //   (2) window_mint(rbx, r12, r13, r14, r15, rbp); on sentinel
  //       (>= ABM_WIN_MAX) -> ABM_WINDOW_MINT_FAILED. See file header
  //       §1 for the tree-leak note on this branch.
  //   (3) window_row_a11y_tree(row_id) != 0 -> ABM_VERIFY_FAILED on
  //       any refusal (unreachable by construction; belt-and-braces).
  //
  // The three refusal paths funnel through a11y_bind_w_refused which
  // stashes the sentinel in rbx (callee-save, survives the stats_bump
  // call) and then re-materialises it into rax right before the shared
  // epilogue.
  // ==========================================================================

  pub let a11y_bind_at_mint_wrap : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (window_id: u64) (parent_surface: u64) (parent_window: u64) (z_order: u64) (tab_workspace_pack: u64) (a11y_tree_kind_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-08 (paideia-os #2305): wrap window_mint with the P4 autobind gate. Six callee-save pushes (rbx=window_id, r12=parent_surface, r13=parent_window, r14=z_order, r15=tab_workspace_pack, rbp=a11y_tree_kind_id) + sub rsp,8 = 56 bytes: entry rsp%16==8, +48+8 = 56, %16==0 for every nested call. All six window_mint args stashed into callee-save before any nested call so they survive the a11y_tree_mint call on the autobind branch. Refusal funnel bumps _abm_stats[ABM_ST_REFUSED] once via a11y_bind_w_refused. LEAK NOTE: on the autobind branch, a11y_tree row minted just before a window_mint failure is NOT rolled back; the leak is bounded by A11Y_MAX(4) and is tracked as a M2-follow-up (see file header §1). Labels prefixed a11y_bind_w_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;
        sub  rsp, 8;

        mov  rbx, rdi;                     // window_id
        mov  r12, rsi;                     // parent_surface
        mov  r13, rdx;                     // parent_window
        mov  r14, rcx;                     // z_order
        mov  r15, r8;                      // tab_workspace_pack
        mov  rbp, r9;                      // a11y_tree_kind_id (0 == autobind)

        // (1) Autobind vs explicit-bind decision.
        cmp  rbp, 0;
        jne  a11y_bind_w_explicit;

        // Autobind branch: mint a fresh KIND_A11Y_TREE for window_id.
        // a11y_tree_mint returns tree_row_id (< ABM_A11Y_MAX(4)) on
        // success; on failure returns an A11Y_* sentinel >= 4.
        mov  rdi, rbx;
        call a11y_tree_mint;
        mov  r10, 4;                       // ABM_A11Y_MAX
        cmp  rax, r10;
        jae  a11y_bind_w_a11y_failed;
        mov  rbp, rax;                     // rewrite rbp = autobound tree

        mov  rdi, 0;                       // ABM_ST_AUTOBIND
        call a11y_bind_stats_bump;
        jmp  a11y_bind_w_call_window;

      a11y_bind_w_explicit:
        // Caller supplied a nonzero tree id. Bump explicit-bind BEFORE
        // window_mint so an accounting caller distinguishes explicit-
        // tried-and-failed from autobind-tried-and-failed.
        mov  rdi, 1;                       // ABM_ST_EXPLICIT_BIND
        call a11y_bind_stats_bump;

      a11y_bind_w_call_window:
        // (2) window_mint(window_id, parent_surface, parent_window,
        //                 z_order, tab_workspace_pack, effective_tree).
        mov  rdi, rbx;
        mov  rsi, r12;
        mov  rdx, r13;
        mov  rcx, r14;
        mov  r8,  r15;
        mov  r9,  rbp;
        call window_mint;
        mov  r10, 32;                      // ABM_WIN_MAX
        cmp  rax, r10;
        jae  a11y_bind_w_win_failed;

        // (3) Cross-module invariant assert: the fresh row's a11y_tree
        //     slot MUST be nonzero. Unreachable in a correct build (the
        //     P4 gate in window_kind.pdx refuses zero at mint time), but
        //     this check catches any future refactor that quietly stops
        //     enforcing the gate.
        mov  rbx, rax;                     // stash row_id (bx callee-save)
        mov  rdi, rbx;
        call window_row_a11y_tree;
        cmp  rax, 0;
        je   a11y_bind_w_verify_failed;

        mov  rax, rbx;                     // success: return row_id
        jmp  a11y_bind_w_out;

      a11y_bind_w_a11y_failed:
        mov  rax, 0xFFFFEBE9;              // ABM_A11Y_MINT_FAILED
        jmp  a11y_bind_w_refused;
      a11y_bind_w_win_failed:
        mov  rax, 0xFFFFEBE8;              // ABM_WINDOW_MINT_FAILED
        jmp  a11y_bind_w_refused;
      a11y_bind_w_verify_failed:
        mov  rax, 0xFFFFEBE7;              // ABM_VERIFY_FAILED

      a11y_bind_w_refused:
        mov  rbx, rax;                     // stash sentinel (callee-save)
        mov  rdi, 2;                       // ABM_ST_REFUSED
        call a11y_bind_stats_bump;
        mov  rax, rbx;                     // restore sentinel

      a11y_bind_w_out:
        add  rsp, 8;
        pop  rbp;
        pop  r15;
        pop  r14;
        pop  r13;
        pop  r12;
        pop  rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION E  Boot init.
  //
  // Compositor init calls a11y_bind_init once to zero the counter cells.
  // .bss is already zero at real boot so this is defensive; a subsequent
  // reset-during-test caller can also call a11y_bind_stats_reset directly.
  // ==========================================================================

  pub let a11y_bind_init : () -> () !{mem} @{} =
