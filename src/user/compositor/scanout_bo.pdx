// src/user/compositor/scanout_bo.pdx -- Wave sigma sigma-01 (R37 GPU BO ->
// compositor scanout buffer allocator)
//
// =============================================================================
// STATUS: HONEST SCAFFOLD
// =============================================================================
// R37 exposed gpu_bo_mint as a kernel-internal cap-op (kind_gpu_bo.pdx) but
// no userspace mint syscall has landed. This module establishes the wire
// shape for compositor-owned scanout BO allocation and keeps the call-site
// dormant behind a local returns-0 stub (scanout_bo_gpu_bo_mint_stub); when
// the real syscall lands, the stub gets replaced with a syscall-shim call
// and the call site is already wired. scanout_bo_query_addr always returns 0
// because the real BO->CPU-visible address needs sigma-02's GPU-VM mapping,
// which is itself a dormant scaffold in this wave. Both dormant paths are
// documented at the call site.
//
// LINKAGE. This module compiles via the compositor/* catch-all branch in
// tools/build-user.sh (which currently only routes buffer_age.pdx and
// damage_kind.pdx into compositor_selftest.elf). It is not yet linked into
// any binary; a future wave that adds compositor-runner.elf will route
// scanout_bo.o alongside its siblings. Because the module is unlinked, the
// gpu_bo_mint stub being local (rather than genuinely external) is safe:
// there is no shared symbol for a future kernel-side dispatcher to override.
//
// =============================================================================
// SLOT LAYOUT (32 B / slot; 8 slots; 32 u64 total)
// =============================================================================
//   +0   u64 bo_row_id           (row id returned by gpu_bo_mint;
//                                 stub-value is 0)
//   +8   u64 pixel_bytes         (width * height * 4; observability only)
//   +16  u64 width|height        (low 32 = width; hi 32 = height)
//   +24  u64 tiling_kind|flags   (low 32 = tiling_kind; hi 32 = flags)
//
// FREE INDICATOR. A slot is FREE iff its width (low 32 of +16) == 0. A real
// scanout must be at least 1x1 so 0 is an unambiguous vacancy sentinel.
//
// SENTINELS.
//   SB_NO_SLOT  = 0xFFFFFFFF   returned by scanout_bo_alloc on full-pool
//                              or bad-dim; fits inside u32 so a caller can
//                              cheaply distinguish from a valid 0..7 idx.
//   SB_BAD_SLOT = 0xFFFFEC70   returned by scanout_bo_release on
//                              out-of-range slot_idx.
//
// FAILURE BAND. 0xFFFFEC70..0xFFFFEC7F reserved for scanout_bo primitives;
// grep-verified fresh at landing (buffer_age holds 0xFFFFEC50..EC5F,
// clipboard 0xFFFFEC00..EC0F, etc.).
//
// =============================================================================
// MODULE BASENAME
// =============================================================================
// scanout_bo.pdx -> module ScanoutBo (PascalCase basename rule per
// feedback_pdx_encoder_pitfalls). Labels prefixed scanout_bo_ to dodge
// paideia-as reserved keywords (loop/if/let/...).

module ScanoutBo = structure {

  pub let SB_MAX          : u64 = 8
  pub let SB_ROW_BYTES    : u64 = 32
  pub let SB_ROW_WORDS    : u64 = 4
  pub let SB_NO_SLOT      : u64 = 0xFFFFFFFF

  pub let SB_OK           : u64 = 0
  pub let SB_BAD_SLOT     : u64 = 0xFFFFEC70
  pub let SB_ENOSPC       : u64 = 0xFFFFEC71
  pub let SB_BAD_DIM      : u64 = 0xFFFFEC72

  // 8 slots * 4 u64 = 32 u64.
  pub let mut _scanout_bo_slots : [u64; 32] = uninit @align(64)

  // ==========================================================================
  // Local R37 GPU BO mint stub. Returns 0 unconditionally; the real symbol
  // will land when the userspace gpu_bo_mint syscall exists (R37 next
  // wave). Naming: sigma-prefixed with the module name so a future
  // linker-visible externally-defined `gpu_bo_mint` does not collide.
  // ==========================================================================

  pub let scanout_bo_gpu_bo_mint_stub : (u64) -> u64 !{} @{} =
    fn (size: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave sigma sigma-01: R37 GPU BO mint stub. Returns 0 until userspace gpu_bo_mint syscall lands. Leaf; no clobber discipline beyond rax.",
      block: {
        xor rax, rax;
        ret
      }
    }

  pub let scanout_bo_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave sigma sigma-01: zero _scanout_bo_slots (32 u64) at boot. Leaf. Labels prefixed scanout_bo_srz_.",
      block: {
        lea r10, [rip + _scanout_bo_slots];
        xor rax, rax;
        xor rcx, rcx;
      scanout_bo_srz_step:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  scanout_bo_srz_step;
        ret
      }
    }

  // scanout_bo_alloc(width, height, tiling_kind) -> slot_idx | SB_NO_SLOT.
  //   Gates: width != 0, height != 0 -> SB_NO_SLOT (BAD_DIM funnel).
  //   Scans 8 slots low-first (free = width field == 0). On claim: call
  //   the mint stub with size = width*height*4; store bo_row_id (0),
  //   pixel_bytes, width|height, tiling_kind|flags.
  //
  //   ABI: 3 args in rdi, rsi, rdx. Five-push callee-save prologue
  //   (rbx=width, r12=height, r13=tiling_kind, r14=size, r15=idx) leaves
  //   rsp%16==0 across the nested stub call (entry 8, +40 pushes = 0).
  pub let scanout_bo_alloc : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (width: u64) (height: u64) (tiling_kind: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave sigma sigma-01: reserve one scanout BO slot. Gates on dim != 0. Low-first scan by width==0. Size = width*height*4 via 2-op imul reg-reg + shl. Five-push prologue (rbx/r12/r13/r14/r15) keeps rsp%16==0 across scanout_bo_gpu_bo_mint_stub call. Labels prefixed scanout_bo_al_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                          // width
        mov r12, rsi;                          // height
        mov r13, rdx;                          // tiling_kind

        cmp rbx, 0;
        je  scanout_bo_al_full;
        cmp r12, 0;
        je  scanout_bo_al_full;

        // size = width * height * 4.
        mov rax, rbx;
        imul rax, r12;
        shl rax, 2;
        mov r14, rax;                          // r14 = pixel_bytes

        // Scan slots low-first. r15 = idx.
        xor r15, r15;
      scanout_bo_al_scan:
        cmp r15, 8;
        jae scanout_bo_al_full;
        lea r10, [rip + _scanout_bo_slots];
        mov r11, r15;
        imul r11, r11, 32;
        add r10, r11;
        // Slot base in r10. Extract width from [r10 + 16] low 32.
        mov rax, [r10 + 16];
        mov rcx, 0xFFFFFFFF;
        and rax, rcx;
        cmp rax, 0;
        je  scanout_bo_al_claim;
        add r15, 1;
        jmp scanout_bo_al_scan;

      scanout_bo_al_claim:
        // Call the mint stub with size = r14. Preserved: rbx, r12, r13,
        // r14, r15 (all callee-save). r10 clobbered by the call.
        mov rdi, r14;
        call scanout_bo_gpu_bo_mint_stub;
        mov rcx, rax;                          // rcx = bo_row_id (0)

        // Recompute slot base.
        lea r10, [rip + _scanout_bo_slots];
        mov r11, r15;
        imul r11, r11, 32;
        add r10, r11;

        // +0: bo_row_id.
        mov [r10 + 0], rcx;
        // +8: pixel_bytes.
        mov [r10 + 8], r14;
        // +16: width | (height << 32).
        mov rax, r12;
        shl rax, 32;
        mov rdi, rbx;
        mov rsi, 0xFFFFFFFF;
        and rdi, rsi;
        or  rax, rdi;
        mov [r10 + 16], rax;
        // +24: tiling_kind | 0.
        mov rax, r13;
        mov rdi, 0xFFFFFFFF;
        and rax, rdi;
        mov [r10 + 24], rax;

        mov rax, r15;                          // return slot_idx
        jmp scanout_bo_al_out;

      scanout_bo_al_full:
        mov rax, 0xFFFFFFFF;                   // SB_NO_SLOT

      scanout_bo_al_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // scanout_bo_release(slot_idx) -> SB_OK | SB_BAD_SLOT.
  //   Out-of-range slot_idx -> SB_BAD_SLOT; else zero all 4 words of the
  //   slot (which restores width==0 free indicator). Leaf.
  pub let scanout_bo_release : (u64) -> u64 !{mem} @{} =
    fn (slot_idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave sigma sigma-01: free one scanout BO slot. Leaf; no callee-save. Labels prefixed scanout_bo_rl_.",
      block: {
        cmp rdi, 8;
        jae scanout_bo_rl_bad;
        lea r10, [rip + _scanout_bo_slots];
        mov r11, rdi;
        imul r11, r11, 32;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0], rax;
        mov [r10 + 8], rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        ret;
      scanout_bo_rl_bad:
        mov rax, 0xFFFFEC70;                   // SB_BAD_SLOT
        ret
      }
    }

  // scanout_bo_query_addr(slot_idx) -> u64.
  //   Returns 0 always. The real CPU-visible address requires sigma-02's
  //   surface_page_map to install the BO into a per-client GPU-VM, which
  //   is itself scaffold. Dormant. Leaf.
  pub let scanout_bo_query_addr : (u64) -> u64 !{} @{} =
    fn (slot_idx: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave sigma sigma-01: dormant address query. Returns 0 until sigma-02 VM install lands. Leaf.",
      block: {
        xor rax, rax;
        ret
      }
    }
}
