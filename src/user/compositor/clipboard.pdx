  pub let co_row_rev_seq : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B6-08 (#2266): revocation_seq at row+32. Monotonic; recipient invalidates on any bump past the seq it first observed. Labels prefixed clipboard_rrs_.",
      block: {
        push r12;
        mov r12, rdi;
        call co_tail_valid;
        cmp rax, 0;
        je  clipboard_rrs_bad;
