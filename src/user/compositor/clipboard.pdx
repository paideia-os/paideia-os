  // ==========================================================================
  // Section 11  Mint / revoke.
  // ==========================================================================

  // clip_offer_mint factory. Contract:
  //
  //   co_mint(source_win, recipient_win, mime_types_ptr,
  //           mime_type_count, data_kind_id)
  //     -> row_id | CO_MINT_* sentinel
  //
  // Five args (all in SysV registers -- rdi/rsi/rdx/rcx/r8). Gate
  // order:
  //   (1) source_win     valid   -> CO_MINT_BAD_SRC
  //   (2) recipient_win  valid   -> CO_MINT_BAD_RCPT
  //       (recipient == 0 refused: no broadcast; this is what
  //        forecloses "any app can snoop the clipboard")
  //   (3) source != recipient    -> CO_MINT_BAD_SELF
  //       (self-paste through a sealed cap is degenerate; refuse
  //        early so a compositor bug that stitches an offer to its
  //        own owner window cannot silently ship)
  //   (4) mime_type_count valid  -> CO_MINT_BAD_MIME
  //   (5) mime_types_ptr non-null-> CO_MIME_PTR_NULL
  //   (6) data_kind_id  valid    -> CO_MINT_BAD_DATA
  //   (7) pack windows + payload words
  //   (8) tail_alloc -> row_id | CO_TAIL_ENOSPC
  //
  // Refusal funnel bumps _co_stats[CO_ST_REFUSED] once at the
  // clipboard_mb_refused label; success bumps _co_stats[CO_ST_MINTS].
  pub let co_mint : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (source_win: u64) (recipient_win: u64) (mime_types_ptr: u64) (mime_type_count: u64) (data_kind_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B6-08 (#2266): mint one KIND_CLIP_OFFER row (sealed). Five callee-save pushes + one sub rsp,8 = 48 bytes: entry rsp%16==8, +40+8=48, %16==0 for every nested call. All five args are stashed BEFORE any nested call clobbers a caller-save reg: rbx=source_win, r12=recipient_win, r13=mime_types_ptr, r14=mime_type_count, r15=data_kind_id. Every validator + packer helper is a leaf using only r10/r11 scratch beyond the SysV in/out contract, so no additional push/pop scaffolding is needed around them. Refusal funnel bumps CO_ST_REFUSED once at clipboard_mb_refused. Labels prefixed clipboard_mb_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;

        mov rbx, rdi;                     // source_win
        mov r12, rsi;                     // recipient_win
        mov r13, rdx;                     // mime_types_ptr
        mov r14, rcx;                     // mime_type_count
        mov r15, r8;                      // data_kind_id

        // (1) source_win
        mov rdi, rbx;
        call co_win_valid;
        cmp rax, 0;
        je  clipboard_mb_bad_src;

        // (2) recipient_win -- must be non-zero (NO broadcast)
        mov rdi, r12;
        call co_win_valid;
        cmp rax, 0;
        je  clipboard_mb_bad_rcpt;

        // (3) source != recipient
        cmp rbx, r12;
        je  clipboard_mb_bad_self;

        // (4) mime_type_count
        mov rdi, r14;
        call co_mime_count_valid;
        cmp rax, 0;
        je  clipboard_mb_bad_mime;

        // (5) mime_types_ptr non-null
        mov rdi, r13;
        call co_mime_ptr_valid;
        cmp rax, 0;
        je  clipboard_mb_ptr_null;

        // (6) data_kind_id
        mov rdi, r15;
        call co_data_kind_valid;
        cmp rax, 0;
        je  clipboard_mb_bad_data;

        // (7) Pack windows = (source_win, recipient_win).
        mov rdi, rbx;
        mov rsi, r12;
        call co_windows_pack;
        mov rbx, rax;                     // windows (source_win no longer needed)

        // Pack payload = (mime_type_count, data_kind_id).
        mov rdi, r14;
        mov rsi, r15;
        call co_payload_pack;
        mov r12, rax;                     // payload (recipient_win no longer needed)

        // (8) tail_alloc(windows, payload, mime_ptr) -> row_id | sentinel.
        mov rdi, rbx;                     // windows
        mov rsi, r12;                     // payload
        mov rdx, r13;                     // mime_types_ptr
        call co_tail_alloc;

        mov r10, 4;
        cmp rax, r10;
        jae clipboard_mb_enospc;          // rax already the sentinel

        // Success: stash row_id in a callee-save across the note
        // call (co_note clobbers rax as scratch), then return it.
        mov rbx, rax;
        mov rdi, 0;                       // CO_ST_MINTS
        call co_note;
        mov rax, rbx;
        jmp clipboard_mb_out;

      clipboard_mb_bad_src:
        mov rax, 0xFFFFEA3B;              // CO_MINT_BAD_SRC
        jmp clipboard_mb_refused;
      clipboard_mb_bad_rcpt:
        mov rax, 0xFFFFEA3A;              // CO_MINT_BAD_RCPT
        jmp clipboard_mb_refused;
      clipboard_mb_bad_self:
        mov rax, 0xFFFFEA39;              // CO_MINT_BAD_SELF
        jmp clipboard_mb_refused;
      clipboard_mb_bad_mime:
        mov rax, 0xFFFFEA38;              // CO_MINT_BAD_MIME
        jmp clipboard_mb_refused;
      clipboard_mb_ptr_null:
        mov rax, 0xFFFFEA31;              // CO_MIME_PTR_NULL
        jmp clipboard_mb_refused;
      clipboard_mb_bad_data:
        mov rax, 0xFFFFEA37;              // CO_MINT_BAD_DATA
        jmp clipboard_mb_refused;
      clipboard_mb_enospc:
        // rax already CO_TAIL_ENOSPC (0xFFFFEA3F) from co_tail_alloc.

      clipboard_mb_refused:
        mov rbx, rax;                     // stash sentinel
        mov rdi, 2;                       // CO_ST_REFUSED
        call co_note;
        mov rax, rbx;

      clipboard_mb_out:
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // clip_offer_revoke bumps revocation_seq so the recipient's next
  // access sees invalidation on the next co_row_rev_seq read. Row
  // is NOT freed here -- the recipient may still be reading through
  // its query rights; freeing races the read. Freeing is a separate
  // GC pass (co_tail_free) driven by refcount going to zero, which
  // is out of scope here (G7-M5-003).
  //
  // Contract:
  //   co_revoke(row_id) -> 0 | CO_BAD_SLOT | CO_REVOKE_ALREADY
  pub let co_revoke : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B6-08 (#2266): revoke one row by BUMPING revocation_seq (no free -- the recipient may still be mid-read; free is a separate GC pass). row_id >= CO_MAX -> CO_BAD_SLOT; not in_use -> CO_REVOKE_ALREADY; else load-inc-store revocation_seq + bump revokes + return 0. Encoder-conservative load-inc-store (no add reg,[mem]). Labels prefixed clipboard_rev_.",
      block: {
        push r12;
        mov r12, rdi;

        mov r10, 4;
        cmp r12, r10;
        jae clipboard_rev_bad_slot;

        mov rdi, r12;
        call co_tail_valid;
        cmp rax, 0;
        je  clipboard_rev_already;

        // Bump revocation_seq at row+32. Load-inc-store; the
        // encoder rejects add reg,[mem].
        lea r10, [rip + _co_table];
        mov r11, r12;
        imul r11, r11, 40;
        add r10, r11;
        mov rax, [r10 + 32];
        add rax, 1;
        mov [r10 + 32], rax;

        mov rdi, 1;                       // CO_ST_REVOKES
        call co_note;
        xor rax, rax;
        jmp clipboard_rev_out;

      clipboard_rev_bad_slot:
        mov rax, 0xFFFFEA36;              // CO_BAD_SLOT
        jmp clipboard_rev_out;
      clipboard_rev_already:
        mov rax, 0xFFFFEA34;              // CO_REVOKE_ALREADY

      clipboard_rev_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Section 12  Boot init.
  // ==========================================================================

  // co_init() -> (). Boot-time defensive re-scrub. Zero pool +
  // counters. .bss is already zero at real boot; this call gives a
  // future witness a clean re-scrub point and matches the
  // reference_display_kind.pdx / kind_tui_canvas.pdx convention.
  pub let co_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B6-08 (#2266): call through to co_stats_reset for one clean pool + counter zero-out. Labels prefixed clipboard_i_.",
      block: {
        call co_stats_reset;
        ret
      }
    }

  // pdx_kind_clip_offer_meta fingerprint tag decl (fingerprint-coverage
  // tooling scans for the exact one-line meta decl; the [legacy: ... OK]
  // suffix gives grep parity with pre-Wave0 boot-log tooling).
  pub let pdx_kind_clip_offer_meta : [u8; 50] = "kind_clip_offer meta [legacy: KIND_CLIP_OFFER OK]\0"
}
