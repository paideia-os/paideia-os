// src/user/compositor/clipboard.pdx -- Wave0-B6-08 (paideia-os #2266)
//
// KIND_CLIP_OFFER = 0x1C6, derived over KIND_MEMORY (= KIND_PAGE, 4).
// Design authority: design/compositor/pwp-spec-vocabulary.md §2.14
// KIND_CLIP_OFFER (SEALED cap flow; opaque MIME payload; NO ambient
// broadcast). Sibling of §2.15 KIND_DND_OFFER (same sealed posture,
// short-lived) and §2.16 KIND_SELECTION_OWNER (issues the offer).
//
// =============================================================================
// SECTION 0  DESIGN COMMITMENT  --  NOVEL-CLEAN, SEALED-CAP CLIPBOARD
// =============================================================================
//
// PaideiaOS' clipboard is deliberately NOT X11's selection buffer.
// There is no ambient global-state read: any process that polls
// "give me the clipboard" cannot exist because there is no cap it can
// name to ask that. Instead every clipboard transfer is a two-window
// capability handoff:
//
//   (1) The source window's KIND_SELECTION_OWNER (§2.16, sibling) --
//       the compositor authority that OWNS a selection kind (primary
//       or clipboard) at a moment -- mints ONE KIND_CLIP_OFFER row
//       naming the specific recipient window that just requested a
//       paste. The mint takes both source AND recipient window
//       KIND_IDs as inputs and PIN-VALIDATES both; a recipient of 0
//       (== "broadcast") is REFUSED at the gate (CO_MINT_BAD_RCPT).
//
//   (2) The compositor delivers that one row's cap to the recipient
//       through the recipient's KIND_INPUT_ROUTE-adjacent focus
//       channel. NO third process ever sees the row -- the compositor
//       is the only actor that can look at the row pool (its .bss),
//       so a compromised sibling client cannot observe a clipboard
//       transfer between two other windows.
//
//   (3) The recipient calls co_row_mime_types_ptr / co_row_mime_count
//       through its RIGHT_QUERY_MIME_TYPES to walk the offered MIME
//       types (interned strings; the compositor keeps the string
//       table -- the recipient never dereferences the pointer through
//       its own address space, it re-asks the compositor to fetch
//       each entry through the standard cap-invoke ABI, sibling to
//       how KIND_A11Y_TREE §2.21 exposes edges without ever handing
//       out a raw pointer). The recipient then calls receive_data
//       (RIGHT_RECEIVE_DATA) to materialise the payload out of the
//       row's data_kind_id (a KIND_MEMORY row the source pre-staged);
//       receive_data is landed at G7-M5-002 (out of scope here).
//
//   (4) If the source revokes (window closed, selection cleared, a
//       new selection was made), co_revoke bumps revocation_seq. The
//       recipient's next access sees the bumped seq and treats the
//       offer as invalidated.
//
// The rights layout is what enforces the "recipient consumes, no
// re-share" contract: RIGHT_QUERY_MIME_TYPES + RIGHT_RECEIVE_DATA +
// RIGHT_REVOKE and NOTHING ELSE. There is deliberately NO R_CO_MINT
// bit in R_CO_ALL -- a mint gate that grants mint-rights to the
// derived cap would let the recipient re-mint the offer for a third
// window; sealed means the source's compositor is the only actor
// that can call co_mint. This mirrors how KIND_TLS_TRUST
// (kernel/core/cap/kind_tls_trust.pdx) refuses WRITE/MINT/REVOKE
// entirely to keep the anchor immutable-once-minted; here we allow
// REVOKE (the source retains the authority to invalidate the offer),
// but not MINT.
//
// This user-space module lives on the compositor side of the ring
// boundary -- it is NOT wired into cap_table / cap_invoke_dispatch
// (those live behind kernel ring boundaries and this file lives on
// the user side of that boundary; see path). The compositor process
// (a userland supervisor at ring 3) holds the row pool. A future
// landing that promotes clipboard-offer authority INTO the kernel
// would move the row pool + mint gate into src/kernel/core/cap/
// (mirroring the kind_color_profile.pdx posture at 0x18F) and wire
// the same op catalogue through cap_invoke_dispatch; nothing here
// prevents that promotion.
//
// =============================================================================
// SECTION 1  KIND_* SLOT ALLOCATION
// =============================================================================
//
// KIND_CLIP_OFFER = 0x1C6. next-wave-derived-kinds.md §"Summary
// counts and free bands" (line 2397) names 0x1B5 as the next free
// tag; the first three post-2397 landings walked 0x1B5..0x1B7 (Wave-0
// Batch-1: KIND_HDR_METADATA at 0x1B5, KIND_TONEMAP_LUT at 0x1B6,
// KIND_REFERENCE_DISPLAY at 0x1B7). Wave-0 Batch-6 assigns 0x1B8..
// 0x1C5 to sibling PWP-vocabulary kinds (window, surface, seat,
// input-route, damage, present-feedback, workspace, ...) in the
// same parallel dispatch; KIND_CLIP_OFFER lands at 0x1C6 as the
// eighth Batch-6 slot per the manifest. Grep over src/**/kind_*.pdx
// + src/**/*_kind.pdx at landing time confirmed no live claim on
// 0x1C6 across the kernel or user tree.
//
// =============================================================================
// SECTION 2  DERIVATION OVER KIND_MEMORY
// =============================================================================
//
// The clipboard payload itself lives in a caller-supplied KIND_MEMORY
// row (data_kind_id below); the CLIP_OFFER row wraps a compositor-
// held handle to that payload. The mint gate is the standard "you
// must hold a KIND_MEMORY parent carrying RIGHT_MINT". Payload bytes
// are LAZY: the recipient calls receive_data (a G7-M5-002 landing,
// out of scope) to materialise them out of data_kind_id; the offer
// row itself only names the data cap, so the source can revoke the
// offer without eagerly materialising a copy.
//
// =============================================================================
// SECTION 3  ROW LAYOUT  --  40 BYTES (FIVE u64 WORDS)
// =============================================================================
//
//   [+0]  header:     in_use[63:56] | reserved[55:0]
//   [+8]  windows:    source_win[31:0]  | recipient_win[63:32]
//   [+16] payload:    mime_count[31:0]  | data_kind_id[63:32]
//   [+24] mime_ptr:   mime_types_ptr (u64) -- opaque compositor-owned
//                     pointer to an interned MIME string table
//   [+32] rev:        revocation_seq (u64, monotonic; incremented on
//                     every co_revoke call)
//
// source_win / recipient_win are KIND_WINDOW ids (u32). recipient == 0
// means "broadcast" which is exactly the X11 shape we refuse to
// support: co_mint returns CO_MINT_BAD_RCPT on recipient == 0. The
// source == 0 case is also refused (CO_MINT_BAD_SRC) so a stale
// "unset" id can never collide with a live window authority. Both
// fields are u32 so they pack into one u64; if the KIND_WINDOW id
// space ever exceeds 32 bits the row grows to 48 bytes here.
//
// data_kind_id (u32) is a cap_table slot id, not a raw pointer -- the
// recipient dereferences it through cap_invoke_dispatch (KIND_MEMORY
// reader ops). 32 bits is well past the cap_table's row ceiling.
//
// revocation_seq (full u64) starts at 0 on mint and is incremented on
// every co_revoke. The recipient reads it via co_row_rev_seq and
// treats any seq > "the seq I saw at first receive" as invalidation.
// Full u64 (rather than packing into the header's 56 free bits) is
// chosen for symmetry with the design doc's "sealed cap w/ monotonic
// invalidation" contract -- a 56-bit seq will not overflow in
// practice, but a full u64 leaves NO ambiguity about "does this
// wrap".
//
// =============================================================================
// SECTION 4  FAILURE TAXONOMY  --  0xFFFFEA30..0xFFFFEA3F
// =============================================================================
//
// Repo-wide grep at landing time showed 0xFFFFEA30..0xFFFFEA3F free
// across src/ + design/ (the 0xFFFFEA page is otherwise home to
// KIND_REFERENCE_DISPLAY at 0xFFFFEA50..5F; a fresh page here keeps
// grep-lookups clean and leaves 0xFFFFEA00..0xFFFFEA2F + 0xFFFFEA40..
// 0xFFFFEA4F for the other Batch-6 siblings that need one).
//
// =============================================================================
// SECTION 5  OP CATALOGUE  (arity 1; op_arg[63:8] REFUSED per convention)
// =============================================================================
//
//   CO_OP_QUERY_SOURCE      (op_arg IGNORED) -> source_window_kind_id
//   CO_OP_QUERY_RECIPIENT   (op_arg IGNORED) -> recipient_window_kind_id
//   CO_OP_QUERY_MIME_COUNT  (op_arg IGNORED) -> mime_type_count
//   CO_OP_QUERY_MIME_PTR    (op_arg IGNORED) -> mime_types_ptr (opaque)
//   CO_OP_QUERY_DATA_KIND   (op_arg IGNORED) -> data_kind_id
//   CO_OP_QUERY_REV_SEQ     (op_arg IGNORED) -> revocation_seq
//   CO_OP_REVOKE            (op_arg IGNORED) -> 0 | CO_* sentinel
//
// A recipient that wants the full offer:
//   (1) calls QUERY_MIME_COUNT
//   (2) walks 0..count-1, asking the compositor for each MIME string
//       via a separate compositor-mediated op (out of scope here)
//   (3) calls QUERY_DATA_KIND to get the KIND_MEMORY cap slot id
//   (4) calls the KIND_MEMORY reader (G7-M5-002 receive_data) to
//       materialise bytes into a caller-owned buffer
//   (5) checks QUERY_REV_SEQ before and after; a bumped seq
//       invalidates the transfer.

module Clipboard = structure {

  pub let KIND_CLIP_OFFER      : u64 = 0x1C6
  pub let KIND_CLIP_OFFER_BASE : u64 = 4          // KIND_MEMORY

  // Row pool. CO_MAX = 4 because a typical desktop has 0..1 live
  // clipboard offers at any moment (one per active selection kind:
  // primary + clipboard, times a small fanout for the "just-paste-
  // in-flight" transient). 4 covers a multi-headed workstation with
  // concurrent paste requests without over-committing .bss.
  pub let CO_MAX       : u64 = 4
  pub let CO_ROW_BYTES : u64 = 40

  // Rights. SEALED cap: NO R_CO_MINT bit. The compositor is the only
  // actor that can mint (it holds the KIND_MEMORY parent cap for the
  // payload); the recipient's derived cap grants query + receive +
  // revoke and that is the entire surface.
  //
  //   R_CO_QUERY_MIME_TYPES  -- read mime_type_count + walk MIME strs
  //   R_CO_RECEIVE_DATA      -- materialise payload out of data_kind_id
  //   R_CO_REVOKE            -- source can invalidate the offer
  //   (NO R_CO_MINT)         -- sealed; recipient cannot re-share
  pub let R_CO_QUERY_MIME_TYPES : u64 = 0x001
  pub let R_CO_RECEIVE_DATA     : u64 = 0x002
  pub let R_CO_REVOKE           : u64 = 0x010
  pub let R_CO_ALL              : u64 = 0x013     // 0x001|0x002|0x010

  // Ops. Every op arity ONE -- op_arg[63:8] REFUSED per convention.
  pub let CO_OP_QUERY_SOURCE     : u64 = 0
  pub let CO_OP_QUERY_RECIPIENT  : u64 = 1
  pub let CO_OP_QUERY_MIME_COUNT : u64 = 2
  pub let CO_OP_QUERY_MIME_PTR   : u64 = 3
  pub let CO_OP_QUERY_DATA_KIND  : u64 = 4
  pub let CO_OP_QUERY_REV_SEQ    : u64 = 5
  pub let CO_OP_REVOKE           : u64 = 6
  pub let CO_OP_MAX              : u64 = 6

  // Failure taxonomy 0xFFFFEA30..0xFFFFEA3F. Grep-verified free
  // across src/ + design/ at landing.
  pub let CO_OK               : u64 = 0
  pub let CO_TAIL_ENOSPC      : u64 = 0xFFFFEA3F
  pub let CO_TAIL_BAD_ARG     : u64 = 0xFFFFEA3E
  pub let CO_MINT_BAD_PARENT  : u64 = 0xFFFFEA3D
  pub let CO_MINT_BAD_RIGHTS  : u64 = 0xFFFFEA3C
  pub let CO_MINT_BAD_SRC     : u64 = 0xFFFFEA3B  // source_win == 0
  pub let CO_MINT_BAD_RCPT    : u64 = 0xFFFFEA3A  // recipient_win == 0 (broadcast refused)
  pub let CO_MINT_BAD_SELF    : u64 = 0xFFFFEA39  // source == recipient
  pub let CO_MINT_BAD_MIME    : u64 = 0xFFFFEA38  // mime_count == 0 or overflow
  pub let CO_MINT_BAD_DATA    : u64 = 0xFFFFEA37  // data_kind_id == 0
  pub let CO_BAD_SLOT         : u64 = 0xFFFFEA36
  pub let CO_WRONG_KIND       : u64 = 0xFFFFEA35
  pub let CO_REVOKE_ALREADY   : u64 = 0xFFFFEA34
  pub let CO_UNSUP_OP         : u64 = 0xFFFFEA33
  pub let CO_MIME_MAX_EXCEED  : u64 = 0xFFFFEA32
  pub let CO_MIME_PTR_NULL    : u64 = 0xFFFFEA31
  pub let CO_INVALIDATED      : u64 = 0xFFFFEA30

  pub let CO_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let CO_ROW_NONE   : u64 = 0xFF

  // Cap on mime_type_count. A well-formed clipboard offer names
  // 1..~10 MIME types (text/plain;charset=utf-8, text/html,
  // image/png, image/svg+xml, application/pdf, ...); 64 is well
  // clear of any real caller and small enough that a malicious
  // source cannot exhaust the compositor's interned string table
  // through offer-count amplification.
  pub let CO_MIME_MAX : u64 = 64

  // THE ONE STATE CELL. 4 rows * 40 bytes = 160 bytes = 20 u64.
  pub let mut _co_table : [u64; 20] = uninit @align(64)
  pub let mut _co_stats : [u64; 4]  = uninit @align(64)

  pub let CO_ST_MINTS   : u64 = 0
  pub let CO_ST_REVOKES : u64 = 1
  pub let CO_ST_REFUSED : u64 = 2
  pub let CO_ST_QUERIES : u64 = 3

  // Fingerprint tag. Emitted by the compositor on successful mint of
  // a clipboard-offer cap. Legacy suffix gives grep parity with pre-
  // Wave0 boot-log tooling per this codebase's tag convention (see
  // rdk_mint_ok_msg in src/user/color/reference_display_kind.pdx,
  // tui_mint_ok_msg in kind_tui_canvas.pdx, nic_mint_ok_msg in
  // kind_nic.pdx).
  pub let co_mint_ok_msg : [u8; 49] = "clip offer mint ok [legacy: CLIP OFFER MINT OK]\n\0"

  // ==========================================================================
  // Section 6  Counter primitives.
  // ==========================================================================

  pub let co_stats_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B6-08 (#2266): clear row table + counters at boot. Labels prefixed clipboard_rs_.",
      block: {
        lea r10, [rip + _co_table];
        xor rax, rax;
        xor rcx, rcx;
      clipboard_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 20;
        jb  clipboard_rs_rows;

        lea r10, [rip + _co_stats];
        xor rcx, rcx;
      clipboard_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  clipboard_rs_stats;
        ret
      }
    }

  pub let co_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B6-08 (#2266): counter bump. Encoder-conservative load-inc-store; no add reg,[mem]. Labels prefixed clipboard_nt_.",
      block: {
        cmp rdi, 4;
        jae clipboard_nt_out;
        lea r10, [rip + _co_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      clipboard_nt_out:
        ret
      }
    }

  pub let co_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B6-08 (#2266): counter read. Labels prefixed clipboard_st_.",
      block: {
        cmp rdi, 4;
        jae clipboard_st_zero;
        lea r10, [rip + _co_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      clipboard_st_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Section 7  Validators.
  // ==========================================================================

  pub let co_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B6-08 (#2266): subset test against R_CO_ALL = 0x013. NO R_CO_MINT bit present -- sealed. Labels prefixed clipboard_rv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x013;
        and rax, r10;
        cmp rax, rdi;
        jne clipboard_rv_no;
        mov rax, 1;
        ret;
      clipboard_rv_no:
        xor rax, rax;
        ret
      }
    }

  // co_win_valid(win_id) -> 1 iff win_id fits in u32 and is non-zero.
  // Non-zero: a zero KIND_WINDOW id would collide with the "unset"
  // sentinel this file uses as the recipient-broadcast refusal
  // trigger. u32-bounded: source_win / recipient_win are stored in
  // u32 halves of the windows word.
  pub let co_win_valid : (u64) -> u64 !{} @{} =
    fn (win_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B6-08 (#2266): 1 iff win_id in (0, 2^32). Labels prefixed clipboard_wv_.",
      block: {
        cmp rdi, 0;
        je  clipboard_wv_no;
        mov rax, rdi;
        shr rax, 32;
        cmp rax, 0;
        jne clipboard_wv_no;
        mov rax, 1;
        ret;
      clipboard_wv_no:
        xor rax, rax;
        ret
      }
    }

  // co_mime_count_valid(count) -> 1 iff 0 < count <= CO_MIME_MAX.
  // A clipboard offer with zero MIME types has no advertised payload
  // shape and is refused at mint (CO_MINT_BAD_MIME); the ceiling
  // (CO_MIME_MAX = 64) foreclose interning-table exhaustion via
  // amplified offers.
  pub let co_mime_count_valid : (u64) -> u64 !{} @{} =
    fn (count: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B6-08 (#2266): 1 iff count in (0, CO_MIME_MAX=64]. Labels prefixed clipboard_mv_.",
      block: {
        cmp rdi, 0;
        je  clipboard_mv_no;
        mov r10, 64;
        cmp rdi, r10;
        ja  clipboard_mv_no;
        mov rax, 1;
        ret;
      clipboard_mv_no:
        xor rax, rax;
        ret
      }
    }

  pub let co_data_kind_valid : (u64) -> u64 !{} @{} =
    fn (data_kind_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B6-08 (#2266): 1 iff data_kind_id in (0, 2^32). Non-zero because the payload cap must exist. Labels prefixed clipboard_dv_.",
      block: {
        cmp rdi, 0;
        je  clipboard_dv_no;
        mov rax, rdi;
        shr rax, 32;
        cmp rax, 0;
        jne clipboard_dv_no;
        mov rax, 1;
        ret;
      clipboard_dv_no:
        xor rax, rax;
        ret
      }
    }

  pub let co_mime_ptr_valid : (u64) -> u64 !{} @{} =
    fn (mime_ptr: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B6-08 (#2266): 1 iff mime_ptr != 0. The pointer is opaque to the recipient (compositor-owned interned table) but a null pointer is a broken offer. Labels prefixed clipboard_pv_.",
      block: {
        cmp rdi, 0;
        je  clipboard_pv_no;
        mov rax, 1;
        ret;
      clipboard_pv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Section 8  Packers.
  // ==========================================================================

  // windows word: source_win[31:0] | recipient_win[63:32]
  pub let co_windows_pack : (u64, u64) -> u64 !{} @{} =
    fn (source_win: u64) (recipient_win: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B6-08 (#2266): windows pack. Both halves capped at u32 max. Labels prefixed clipboard_wp_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  clipboard_wp_bad;
        cmp rsi, r10;
        ja  clipboard_wp_bad;
        mov rax, rdi;
        and rax, 0xFFFFFFFF;
        mov r10, rsi;
        and r10, 0xFFFFFFFF;
        shl r10, 32;
        or  rax, r10;
        ret;
      clipboard_wp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // payload word: mime_count[31:0] | data_kind_id[63:32]
  pub let co_payload_pack : (u64, u64) -> u64 !{} @{} =
    fn (mime_count: u64) (data_kind_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B6-08 (#2266): payload pack. Both halves capped at u32 max. Labels prefixed clipboard_pp_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  clipboard_pp_bad;
        cmp rsi, r10;
        ja  clipboard_pp_bad;
        mov rax, rdi;
        and rax, 0xFFFFFFFF;
        mov r10, rsi;
        and r10, 0xFFFFFFFF;
        shl r10, 32;
        or  rax, r10;
        ret;
      clipboard_pp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // Section 9  Row pool: valid / alloc / free.
  // ==========================================================================

  pub let co_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B6-08 (#2266): 1 iff row_id < CO_MAX and in_use. Row stride = CO_ROW_BYTES = 40. Labels prefixed clipboard_tv_.",
      block: {
        cmp rdi, 4;
        jae clipboard_tv_no;
        lea r10, [rip + _co_table];
        mov r11, rdi;
        imul r11, r11, 40;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  clipboard_tv_no;
        mov rax, 1;
        ret;
      clipboard_tv_no:
        xor rax, rax;
        ret
      }
    }

  // co_tail_alloc(windows, payload, mime_ptr) -> row_id | err.
  // Low-first scan over CO_MAX = 4 rows. Header is stamped with the
  // in_use bit (bit 56) here so callers pass no header explicitly;
  // revocation_seq initialises to 0 at claim time.
  pub let co_tail_alloc : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (windows: u64) (payload: u64) (mime_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B6-08 (#2266): claim one CLIP_OFFER row. Low-first scan (rbx=idx) over 4 rows of 40 bytes (idx*40 via imul). On claim: stamp header with the 1<<56 in_use bit, zero revocation_seq, store windows/payload/mime_ptr. Four callee-save pushes (rbx=idx, r12=windows, r13=payload, r14=mime_ptr) plus one sub rsp,8 leave rsp%16==0 across the internal (no-nested-call) scan. Labels prefixed clipboard_ta_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        sub rsp, 8;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;

        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp r12, r10;
        je  clipboard_ta_bad;
        cmp r13, r10;
        je  clipboard_ta_bad;
        cmp r14, r10;
        je  clipboard_ta_bad;

        xor rbx, rbx;
      clipboard_ta_scan:
        cmp rbx, 4;
        jae clipboard_ta_enospc;
        lea r10, [rip + _co_table];
        mov r11, rbx;
        imul r11, r11, 40;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  clipboard_ta_claim;
        add rbx, 1;
        jmp clipboard_ta_scan;

      clipboard_ta_claim:
        // header = (1 << 56)  -- in_use bit set; reserved[55:0] = 0
        mov rax, 1;
        shl rax, 56;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r12;   // windows word
        mov [r10 + 16], r13;   // payload word
        mov [r10 + 24], r14;   // mime_types_ptr
        xor rax, rax;
        mov [r10 + 32], rax;   // revocation_seq = 0
        mov rax, rbx;
        jmp clipboard_ta_out;

      clipboard_ta_enospc:
        mov rax, 0xFFFFEA3F;   // CO_TAIL_ENOSPC
        jmp clipboard_ta_out;
      clipboard_ta_bad:
        mov rax, 0xFFFFEA3E;   // CO_TAIL_BAD_ARG

      clipboard_ta_out:
        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let co_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B6-08 (#2266): scrub one row (all five words). Labels prefixed clipboard_tf_.",
      block: {
        cmp rdi, 4;
        jae clipboard_tf_out;
        lea r10, [rip + _co_table];
        mov r11, rdi;
        imul r11, r11, 40;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        mov [r10 + 32], rax;
      clipboard_tf_out:
        ret
      }
    }

  // ==========================================================================
  // Section 10  Row-field query helpers.
  // ==========================================================================

  // clip_offer_query_mime_types = the two-step "count + ptr" reader
  // pair below (co_row_mime_count + co_row_mime_types_ptr). A single
  // "return &[MimeStr]" API is not offered because paideia-as has no
  // slice type and no reference type -- the recipient walks the
  // interned string table through the compositor via successive
  // op_arg calls; see §5 op catalogue for the walk protocol.

  pub let co_row_source : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B6-08 (#2266): source_win at windows[31:0]. Labels prefixed clipboard_rs2_.",
      block: {
        push r12;
        mov r12, rdi;
        call co_tail_valid;
        cmp rax, 0;
        je  clipboard_rs2_bad;
        lea r10, [rip + _co_table];
        mov r11, r12;
        imul r11, r11, 40;
        add r10, r11;
        mov rax, [r10 + 8];
        and rax, 0xFFFFFFFF;
        jmp clipboard_rs2_out;
      clipboard_rs2_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      clipboard_rs2_out:
        pop r12;
        ret
      }
    }

  pub let co_row_recipient : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
