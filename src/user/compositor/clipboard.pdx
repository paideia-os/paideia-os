        mov r11, r12;
        imul r11, r11, 40;
        add r10, r11;
        mov rax, [r10 + 8];
        shr rax, 32;
        and rax, 0xFFFFFFFF;
        jmp clipboard_rr_out;
      clipboard_rr_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      clipboard_rr_out:
        pop r12;
        ret
      }
    }

