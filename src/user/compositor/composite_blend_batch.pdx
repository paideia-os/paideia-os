// src/user/compositor/composite_blend_batch.pdx -- Wave sigma sigma-03 (R37
// GPU submit -> composite blend batch builder)
//
// =============================================================================
// STATUS: HONEST SCAFFOLD
// =============================================================================
// R37 landed gpu_submit as a kernel-internal cap-op (kind_gpu_submit.pdx).
// Userspace has no gpu_submit_kick syscall yet. This module accumulates
// blend commands into a fixed-size command ring so the compositor can build
// one batch per frame and hand it to GPU-side execution in a single
// syscall. Until that syscall lands, blend_batch_submit calls a local
// returns-0 stub (composite_blend_batch_gpu_submit_kick_stub) and clears
// the ring, which preserves the observable "one submit per composite pass"
// cadence even though no GPU work is actually issued.
//
// LINKAGE. Unlinked in this wave; see scanout_bo.pdx header for the shared
// story.
//
// =============================================================================
// COMMAND RING (128 slots x 48 B/slot = 6144 B = 768 u64)
// =============================================================================
//   +0   u64 op
//   +8   u64 src_bo
//   +16  u64 dst_bo
//   +24  u64 x|y      (low 32 = x; hi 32 = y)
//   +32  u64 w|h      (low 32 = w; hi 32 = h)
//   +40  u64 flags
//
// Per the wave brief: task-nominal per-slot size is 40 B (op+src+dst+x+y+
// w+h+flags with each dim a u32); pack the 4 dims (x, y, w, h) into two
// u64s to keep the slot 8-byte aligned and round to 48 B (matches the
// briefing's "round to 48B" note).
//
// The ring uses a strictly linear write cursor (_blend_batch_count) rather
// than a circular head-tail scheme: a batch is built up in one composite
// pass and drained by blend_batch_submit on the same pass, so there is no
// concurrent read-vs-write pointer to coordinate. blend_batch_add_op
// refuses (EFULL == 0xFFFFEC91) when the count has reached 128; the caller
// is expected to submit-then-add-again to make room.
//
// =============================================================================
// FUNCTION ARITY NOTE
// =============================================================================
// The brief describes blend_batch_add_op(op, src, dst, x, y, w, h, flags)
// (8 args). SysV passes only 6 args in registers, and this module packs
// x/y into rcx and w/h into r8 to keep the call site register-only.
// Callers use the helper convention:
//
//   xy_pack = x | (y << 32)
//   wh_pack = w | (h << 32)
//
// blend_batch_add_op takes (op, src_bo, dst_bo, xy_pack, wh_pack, flags)
// = 6 args in rdi, rsi, rdx, rcx, r8, r9. The row stores xy_pack and
// wh_pack VERBATIM at +24 and +32 so no unpack-then-repack shuffle
// happens on the hot path.
//
// =============================================================================
// MODULE BASENAME
// =============================================================================
// composite_blend_batch.pdx -> module CompositeBlendBatch. Labels prefixed
// composite_blend_batch_.

module CompositeBlendBatch = structure {

  pub let CBB_MAX_CMDS   : u64 = 128
  pub let CBB_ROW_BYTES  : u64 = 48
  pub let CBB_ROW_WORDS  : u64 = 6

  pub let CBB_OK          : u64 = 0
  pub let CBB_FULL        : u64 = 0xFFFFEC91
  pub let CBB_SUBMIT_FAIL : u64 = 0xFFFFEC92

  // 128 slots * 6 u64 = 768 u64.
  pub let mut _blend_batch_cmds  : [u64; 768] = uninit @align(64)
  pub let mut _blend_batch_count : [u64;   1] = uninit @align(64)

  // ==========================================================================
  // Local R37 gpu_submit_kick stub. Returns 0 unconditionally.
  // Signature intent: (batch_ptr, batch_bytes) -> submit_row_id | error.
  // The scaffold passes only the batch base pointer; the stub ignores it.
  // ==========================================================================

  pub let composite_blend_batch_gpu_submit_kick_stub : (u64) -> u64 !{} @{} =
    fn (batch_ptr: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave sigma sigma-03: R37 gpu_submit_kick stub. Returns 0 until userspace gpu_submit_kick syscall lands. Leaf.",
      block: {
        xor rax, rax;
        ret
      }
    }

  pub let composite_blend_batch_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave sigma sigma-03: zero _blend_batch_cmds (768 u64) + _blend_batch_count (1 u64) at boot. Leaf. Labels prefixed composite_blend_batch_srz_.",
      block: {
        lea r10, [rip + _blend_batch_cmds];
        xor rax, rax;
        xor rcx, rcx;
      composite_blend_batch_srz_step:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 768;
        jb  composite_blend_batch_srz_step;
        lea r10, [rip + _blend_batch_count];
        mov [r10 + 0], rax;
        ret
      }
    }

  // blend_batch_pending_count() -> u64. Leaf.
  pub let blend_batch_pending_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave sigma sigma-03: read _blend_batch_count[0]. Leaf.",
      block: {
        lea r10, [rip + _blend_batch_count];
        mov rax, [r10 + 0];
        ret
      }
    }

  // blend_batch_add_op(op, src_bo, dst_bo, xy_pack, wh_pack, flags)
  //   -> CBB_OK | CBB_FULL.
  //
  // 6 args in rdi, rsi, rdx, rcx, r8, r9 (SysV register-only).
  // Leaf function; no callee-save needed (r8..r11, rcx are caller-save).
  // On success: write row at _blend_batch_cmds[count*6..count*6+5],
  // increment count.
  pub let blend_batch_add_op : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (op: u64) (src_bo: u64) (dst_bo: u64) (xy_pack: u64) (wh_pack: u64) (flags: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave sigma sigma-03: append one blend cmd to the ring. Read count, cmp against CBB_MAX_CMDS, compute row base = _blend_batch_cmds + count*48, write 6 u64, bump count. Leaf; no callee-save. Labels prefixed composite_blend_batch_ao_.",
      block: {
        // Read count.
        lea r10, [rip + _blend_batch_count];
        mov r11, [r10 + 0];
        cmp r11, 128;
        jae composite_blend_batch_ao_full;

        // Compute row base = _blend_batch_cmds + count * 48.
        lea r10, [rip + _blend_batch_cmds];
        mov rax, r11;
        imul rax, rax, 48;
        add r10, rax;

        // Write 6 u64 fields.
        mov [r10 +  0], rdi;                   // op
        mov [r10 +  8], rsi;                   // src_bo
        mov [r10 + 16], rdx;                   // dst_bo
        mov [r10 + 24], rcx;                   // xy_pack
        mov [r10 + 32], r8;                    // wh_pack
        mov [r10 + 40], r9;                    // flags

        // Bump count.
        lea r10, [rip + _blend_batch_count];
        add r11, 1;
        mov [r10 + 0], r11;

        xor rax, rax;                          // CBB_OK
        ret;

      composite_blend_batch_ao_full:
        mov rax, 0xFFFFEC91;                   // CBB_FULL
        ret
      }
    }

  // blend_batch_submit() -> submit_result | CBB_OK.
  //   Walks the pending count (only to compute the byte length; a real
  //   consumer would iterate row-by-row and encode a GPU-side command
  //   stream). Calls the stub with the base pointer of _blend_batch_cmds
  //   and returns its result (stub-value 0). On success, clears the
  //   count.
  //
  //   One-push prologue keeps rsp%16==0 across the stub call.
  pub let blend_batch_submit : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave sigma sigma-03: drain the pending cmd ring. Calls the stub; on rax==0, clears _blend_batch_count[0]. One-push prologue keeps rsp%16==0 across the stub call. Labels prefixed composite_blend_batch_sm_.",
      block: {
        push rbx;

        // Load base into rdi for the stub call.
        lea rdi, [rip + _blend_batch_cmds];
        call composite_blend_batch_gpu_submit_kick_stub;
        mov rbx, rax;                          // stash result

        cmp rbx, 0;
        jne composite_blend_batch_sm_out;

        // Clear count on success.
        lea r10, [rip + _blend_batch_count];
        xor rax, rax;
        mov [r10 + 0], rax;

      composite_blend_batch_sm_out:
        mov rax, rbx;
        pop rbx;
        ret
      }
    }
}
