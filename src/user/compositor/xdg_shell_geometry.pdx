// src/user/compositor/xdg_shell_geometry.pdx -- Wave0-B7-02 (paideia-os #2262)
//
// XdgShellGeometry -- the OPERATION-SHAPE half of the xdg-shell-equivalent
// resize / geometry pair. Batch-6 landed KIND_XDG_TOPLEVEL_STATE (#2260;
// see xdg_shell_states.pdx), which carries the STATE record: the current
// (x, y, w, h) rect, the current interactive-resize edge bitmask, the
// tiling / maximized enum. THIS module lands the request/event value
// types that let a client START an interactive resize drag or ANNOUNCE a
// new geometry to the compositor -- the two operations that mutate a
// KIND_XDG_TOPLEVEL_STATE row from the client side.
//
// Design authority:
//   * design/compositor/pwp-spec-vocabulary.md §2.7 KIND_XDG_TOPLEVEL_STATE
//     -- "interactive-resize edge bindings + geometry (excluding CSD)".
//     Batch-6 (#2260) fielded the state row; batch-7 (#2262 / this file)
//     fields the request/event shapes the client uses to drive it.
//
// =============================================================================
// SECTION 0  VALUE TYPES, NOT KINDS
// =============================================================================
//
// InteractiveResizeRequest and WindowGeometryUpdate are VALUE records --
// 16- and 24-byte data shapes that ride the wire between a client and the
// compositor. Neither owns a KIND_ID slot, a rights bitmask, a mint gate,
// or a cap-table row. The authority they carry is entirely borrowed:
//
//   * `window_kind_id` names an already-minted KIND_WINDOW (#2254) row.
//     The compositor consumes the record only if the sending client holds
//     the parent-window cap with RIGHT_REQUEST_INTERACTIVE_RESIZE (for
//     the resize request) or RIGHT_SET_GEOMETRY_EXCL (for the geometry
//     update). Rights are checked by the KIND_XDG_TOPLEVEL_STATE dispatch
//     handler; this module publishes only the record shape.
//
//   * `pointer_button_seat` names a KIND_SEAT pointer capability
//     (allocated in the input plane) that authenticates WHICH physical
//     pointer initiated the drag; the compositor uses it to bind the
//     resize's grab to the correct seat so a second pointer's motion does
//     not smear the drag.
//
//   * `serial` is a compositor-issued monotonic token the client echoes
//     into every request; the compositor uses it to pair a resize-start
//     request with the exact pointer-button-down event that authorised
//     it (the "compositor cross-checks the serial" pattern Wayland's
//     xdg_toplevel.resize freezes in place -- serials that do not match
//     an outstanding button event get refused, so a stale request cannot
//     hijack a fresh grab).
//
// NOVEL-CLEAN CHOICES.
//
//   * NO CSD (client-side decoration) IN THE GEOMETRY UPDATE. Wayland's
//     xdg_surface.set_window_geometry has famously two spellings depending
//     on whether the toolkit paints a titlebar (the "window with titlebar"
//     rect and the "window without titlebar" rect); every X11 shell has
//     re-hit the resulting bug class. PaideiaOS's window system has no
//     server-side decoration and the record's (x, y, w, h) is always the
//     client-drawn-content rect (spec §2.7 pins this).
//
//   * SERIAL IS MANDATORY ON BOTH SIDES. Both InteractiveResizeRequest
//     and WindowGeometryUpdate carry a 32-bit serial (spec §2.7's
//     request/response pattern). A record whose serial is zero is legal
//     value shape but semantically means "unsolicited" -- the compositor
//     accepts it only from privileged origins (e.g. the shell process
//     itself); the client-side factory always passes the last serial it
//     was handed by the compositor's pointer-event pipeline. Serial
//     validation is a dispatch-handler concern; this factory does not
//     reject serial == 0 (a shell's synthesised geometry update needs to
//     express that).
//
//   * EDGES IS A 4-BIT MASK, CORNERS ARE OR OF TWO. The bit layout
//     matches xdg_shell_states.pdx §4 exactly (TOP=0x01, BOTTOM=0x02,
//     LEFT=0x04, RIGHT=0x08); this is the same wire form Wayland
//     xdg_toplevel.resize's `edges` argument uses, chosen for the same
//     reason (a corner is exactly the OR of one vertical and one
//     horizontal edge; a diagonal drag is not a fifth state). Bit 4..7
//     are refused by the factory validator -- future rotation handles
//     land as a separate op, not by widening this mask.
//
//   * INTERACTIVE_RESIZE_IS_CORNER IS EXACTLY popcount(edges) == 2. Not
//     "any of TOP_LEFT / TOP_RIGHT / BOTTOM_LEFT / BOTTOM_RIGHT" (an
//     enumeration a future widening breaks silently) -- a bit-count
//     predicate that generalises: if edges is validated (0 < e && e <=
//     0x0F && e & 0x0F == e), then popcount==2 is an exhaustive
//     characterisation of the four corner OR-combinations.
//
// =============================================================================
// SECTION 1  ON-WIRE LAYOUTS
// =============================================================================
//
// InteractiveResizeRequest -- 16 bytes / 2 u64 words (one cache line quarter):
//
//   [+0]  word0:  window_kind_id[31:0] | serial[63:32]
//   [+8]  word1:  resize_edges[7:0]    | reserved[31:8] | pointer_button_seat[63:32]
//
// WindowGeometryUpdate -- 24 bytes / 3 u64 words:
//
//   [+0]  word0:  window_kind_id[31:0] | serial[63:32]
//   [+8]  word1:  x[31:0] (i32)        | y[63:32] (i32)
//   [+16] word2:  w[31:0] (i32)        | h[63:32] (i32)
//
// Both records are 8-byte aligned. Neither carries a header word: they are
// EPHEMERAL request/event payloads, not cap-table rows -- the sending
// process allocates them on its own stack (or in a shared IPC ring), the
// receiving compositor consumes them into a KIND_XDG_TOPLEVEL_STATE row
// (via the state module's setter path) and never persists the record
// itself.
//
// =============================================================================
// SECTION 2  FAILURE TAXONOMY 0xFFFFEA70..0xFFFFEA7F
// =============================================================================
//
// A fresh 16-wide band verified free at landing time by grep across
// src/**/*.pdx + design/**/*.md. 0xFFFFEA60..0xFFFFEA6F is claimed
// upstream (recovery); 0xFFFFEA80..0xFFFFEA8F is currently unassigned.
// This band sits directly above the recovery block and below the next
// free page. See xdg_shell_states.pdx §7 for the sibling band
// (0xFFFFEA40..0xFFFFEA4F) that covers the row-side failures.

module XdgShellGeometry = structure {

  // ==========================================================================
  // SECTION 3  RECORD SIZES + FIELD OFFSETS
  // ==========================================================================

  pub let XSG_IRR_BYTES              : u64 = 16
  pub let XSG_WGU_BYTES              : u64 = 24

  // InteractiveResizeRequest offsets.
  pub let XSG_IRR_OFF_WINDOW_SERIAL  : u64 = 0
  pub let XSG_IRR_OFF_EDGES_SEAT     : u64 = 8

  // WindowGeometryUpdate offsets.
  pub let XSG_WGU_OFF_WINDOW_SERIAL  : u64 = 0
  pub let XSG_WGU_OFF_XY             : u64 = 8
  pub let XSG_WGU_OFF_WH             : u64 = 16

  // ==========================================================================
  // SECTION 4  RESIZE-EDGE BITMASK (mirrors xdg_shell_states.pdx §4)
  // ==========================================================================
  //
  // Duplicated locally rather than imported so this module is a
  // self-contained op-shape leaf a substrate can reason about without
  // pulling in the KIND_XDG_TOPLEVEL_STATE row layout. Values are
  // BYTE-STABLE with xdg_shell_states.pdx; any change must land in both.

  pub let RESIZE_EDGE_NONE           : u64 = 0x00
  pub let RESIZE_EDGE_TOP            : u64 = 0x01
  pub let RESIZE_EDGE_BOTTOM         : u64 = 0x02
  pub let RESIZE_EDGE_LEFT           : u64 = 0x04
  pub let RESIZE_EDGE_RIGHT          : u64 = 0x08
  pub let RESIZE_EDGE_TOP_LEFT       : u64 = 0x05   // TOP    | LEFT
  pub let RESIZE_EDGE_TOP_RIGHT      : u64 = 0x09   // TOP    | RIGHT
  pub let RESIZE_EDGE_BOTTOM_LEFT    : u64 = 0x06   // BOTTOM | LEFT
  pub let RESIZE_EDGE_BOTTOM_RIGHT   : u64 = 0x0A   // BOTTOM | RIGHT
  pub let RESIZE_EDGE_ALL            : u64 = 0x0F   // TOP|BOTTOM|LEFT|RIGHT
  pub let RESIZE_EDGE_MASK           : u64 = 0x0F   // valid-bits mask

  // ==========================================================================
  // SECTION 5  FAILURE TAXONOMY 0xFFFFEA70..0xFFFFEA7F
  // ==========================================================================

  pub let XSG_OK                     : u64 = 0
  pub let XSG_BAD_OUT_PTR            : u64 = 0xFFFFEA7F
  pub let XSG_BAD_WINDOW             : u64 = 0xFFFFEA7E
  pub let XSG_BAD_EDGES              : u64 = 0xFFFFEA7D
  pub let XSG_BAD_SEAT               : u64 = 0xFFFFEA7C
  pub let XSG_BAD_GEOMETRY_W         : u64 = 0xFFFFEA7B
  pub let XSG_BAD_GEOMETRY_H         : u64 = 0xFFFFEA7A

  // ==========================================================================
  // SECTION 6  FINGERPRINT (one line, legacy-suffixed)
  // ==========================================================================
  //
  // Value-type presence tag; no mint body in this module. The
  // KIND_XDG_TOPLEVEL_STATE dispatch handler (kernel-side follow-up) is
  // the first consumer that can emit this string on the wire the first
  // time an interactive-resize request or a geometry update is presented
  // post-boot. Until that landing wires the emit, the string is data-only
  // and needs to be allowlisted in tools/verify-fingerprint-coverage.sh
  // with reason "Wave0-B7-02 (#2262) XdgShellGeometry op-shape value
  // types; no mint body to emit from -- KIND_XDG_TOPLEVEL_STATE dispatch
  // (kernel follow-up) is the first consumer that may emit as a
  // side-band trace once request/event consume paths land."
  //
  // Length arithmetic: 27 printable chars ("xdg shell geometry meta ok ")
  // + 36 printable chars ("[legacy: XDG SHELL GEOMETRY META OK]")
  // + 1 NUL terminator == 64 bytes.
  pub let pdx_kind_xdg_shell_geometry_meta : [u8; 64] = "xdg shell geometry meta ok [legacy: XDG SHELL GEOMETRY META OK]\0"

  // ==========================================================================
  // SECTION 7  FACTORY: interactive_resize_request_new
  // ==========================================================================
  //
  // Signature: (out_ptr, window, serial, edges, seat) -> u64
  //   * out_ptr:  pointer to a 16-byte caller-provided buffer
  //   * window:   parent KIND_WINDOW kind_id (low 32 bits used); non-zero
  //   * serial:   compositor-issued request serial (low 32 bits used);
  //               zero is legal (unsolicited from a privileged origin)
  //   * edges:    RESIZE_EDGE_* bitmask (low 4 bits used); non-zero and
  //               all bits within RESIZE_EDGE_MASK == 0x0F
  //   * seat:     pointer-carrying KIND_SEAT (low 32 bits used); non-zero
  //   * returns:  XSG_OK on success; otherwise a taxonomy code and the
  //               out_ptr buffer is left untouched.
  //
  // Register plan (SysV): rdi=out_ptr, rsi=window, rdx=serial, rcx=edges,
  // r8=seat. Scratch: rax, r10, r11 (all caller-saved). NO clobber of
  // rbx, rbp, r12..r15 (callee-saved).
  pub let interactive_resize_request_new : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (out_ptr: u64) (window: u64) (serial: u64) (edges: u64) (seat: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B7-02 (#2262): pack a 16-byte InteractiveResizeRequest record into a caller-provided buffer. Validation order: out_ptr != 0, window != 0 (low u32), seat != 0 (low u32), edges != 0, edges & ~0x0F == 0. All comparisons use `cmp reg, imm`+conditional-jump (never `test`) per row's coding budget. Packing uses `shl r64, 32` + `or` (never `add reg, [mem]`). Reserved bits [31:8] of word1 stay zero. Register plan (SysV): rdi=out_ptr, rsi=window, rdx=serial, rcx=edges, r8=seat; scratch rax/r10/r11 caller-saved. Labels prefixed xdg_shell_geometry_irr_.",
      block: {
        // Guard: out_ptr != 0.
        cmp rdi, 0;
        je  xdg_shell_geometry_irr_badout;

        // Guard: window (low u32) != 0. Mask before compare so a stray
        // high-half bit doesn't pass a nominally-zero window.
        mov r10, rsi;
        mov r11, 0xFFFFFFFF;
        and r10, r11;
        cmp r10, 0;
        je  xdg_shell_geometry_irr_badwin;

        // Guard: seat (low u32) != 0.
        mov r10, r8;
        and r10, r11;              // r11 still 0xFFFFFFFF
        cmp r10, 0;
        je  xdg_shell_geometry_irr_badseat;

        // Guard: edges != 0.
        cmp rcx, 0;
        je  xdg_shell_geometry_irr_bededges;

        // Guard: edges & ~0x0F == 0. r10 = ~0x0F via NOT of a small imm
        // (sidesteps MOVABS on a 64-bit constant).
        mov r10, 0x0F;
        not r10;                    // r10 = 0xFFFFFFFFFFFFFFF0
        mov r11, rcx;
        and r11, r10;
        cmp r11, 0;
        jne xdg_shell_geometry_irr_bededges;

        // ---- All validated. Commit the writes. ----

        // word0 = (serial_lo32 << 32) | (window_lo32).
        mov r10, 0xFFFFFFFF;
        mov rax, rdx;               // serial
        and rax, r10;
        shl rax, 32;
        mov r11, rsi;               // window
        and r11, r10;
        or  rax, r11;
        mov [rdi + 0], rax;

        // word1 = (seat_lo32 << 32) | (edges & 0xFF). Reserved [31:8] == 0.
        mov rax, r8;                // seat
        and rax, r10;               // r10 still 0xFFFFFFFF
        shl rax, 32;
        mov r11, rcx;               // edges
        and r11, 0xFF;
        or  rax, r11;
        mov [rdi + 8], rax;

        xor rax, rax;               // XSG_OK
        ret;

      xdg_shell_geometry_irr_badout:
        mov rax, 0xFFFFEA7F;        // XSG_BAD_OUT_PTR
        ret;

      xdg_shell_geometry_irr_badwin:
        mov rax, 0xFFFFEA7E;        // XSG_BAD_WINDOW
        ret;

      xdg_shell_geometry_irr_bededges:
        mov rax, 0xFFFFEA7D;        // XSG_BAD_EDGES
        ret;

      xdg_shell_geometry_irr_badseat:
        mov rax, 0xFFFFEA7C;        // XSG_BAD_SEAT
        ret
      }
    }

  // ==========================================================================
  // SECTION 8  FACTORY: window_geometry_update_new
  // ==========================================================================
  //
  // Signature: (out_ptr, window, xy_packed, wh_packed, serial) -> u64
  //   * out_ptr:    pointer to a 24-byte caller-provided buffer
  //   * window:     parent KIND_WINDOW kind_id (low 32 bits used); non-zero
  //   * xy_packed:  x[31:0] (i32) | y[63:32] (i32) -- pack via
  //                 xdg_shell_states_geom_xy_pack (byte-compatible)
  //   * wh_packed:  w[31:0] (i32) | h[63:32] (i32) -- pack via
  //                 xdg_shell_states_geom_wh_pack (byte-compatible)
  //   * serial:     compositor-issued serial (low 32 bits used)
  //   * returns:    XSG_OK on success; taxonomy code on failure and the
  //                 out_ptr buffer is left untouched.
  //
  // WHY xy_packed / wh_packed AND NOT 4 SEPARATE COORDS. Passing x/y/w/h
  // as four individual u64s alongside out_ptr, window, serial would need
  // 7 args -- one over the SysV 6-register ceiling this codebase's fn
  // shape supports. The caller-side packers already exist in the sibling
  // module (xdg_shell_states.pdx §11) and produce the exact byte layout
  // this record stores, so factoring the packing to the caller keeps
  // this factory a pure leaf that stays in registers with no stack args.
  //
  // VALIDATION: w > 0 AND h > 0 (i32 semantics). A negative or zero
  // width/height is refused; the spec pins geometry as the CSD-EXCLUDED
  // client-content rect, and a zero-sized content rect is not a legal
  // update (MINIMIZED is expressed by a state transition on the sibling
  // KIND_XDG_TOPLEVEL_STATE row, not by shrinking geometry to zero).
  //
  // Register plan (SysV): rdi=out_ptr, rsi=window, rdx=xy_packed,
  // rcx=wh_packed, r8=serial. Scratch: rax, r10, r11 (caller-saved).
  pub let window_geometry_update_new : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (out_ptr: u64) (window: u64) (xy_packed: u64) (wh_packed: u64) (serial: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B7-02 (#2262): pack a 24-byte WindowGeometryUpdate record. Validation: out_ptr != 0, window != 0 (low u32), w > 0 as i32 (low u32 of wh_packed in [1, 0x7FFFFFFF]), h > 0 as i32 (high u32 of wh_packed in [1, 0x7FFFFFFF]). i32 positivity via `cmp reg, 1; jb bad` (catches zero) then `cmp reg, 0x7FFFFFFF; ja bad` (catches negative-as-u32 == >= 0x80000000). Never uses `test`. Never uses `add reg, [mem]`. Register plan: rdi=out_ptr, rsi=window, rdx=xy_packed, rcx=wh_packed, r8=serial; scratch rax/r10/r11 caller-saved. Labels prefixed xdg_shell_geometry_wgu_.",
      block: {
        // Guard: out_ptr != 0.
        cmp rdi, 0;
        je  xdg_shell_geometry_wgu_badout;

        // Guard: window (low u32) != 0.
        mov r10, rsi;
        mov r11, 0xFFFFFFFF;
        and r10, r11;
        cmp r10, 0;
        je  xdg_shell_geometry_wgu_badwin;

        // Guard: w (low 32 bits of wh_packed) in [1, 0x7FFFFFFF] (positive i32).
        mov r10, rcx;
        and r10, r11;               // r11 == 0xFFFFFFFF
        cmp r10, 1;
        jb  xdg_shell_geometry_wgu_badw;
        mov r11, 0x7FFFFFFF;
        cmp r10, r11;
        ja  xdg_shell_geometry_wgu_badw;

        // Guard: h (high 32 bits of wh_packed) in [1, 0x7FFFFFFF] (positive i32).
        mov r10, rcx;
        shr r10, 32;                // r10 = h as u32-in-u64
        cmp r10, 1;
        jb  xdg_shell_geometry_wgu_badh;
        cmp r10, r11;               // r11 still 0x7FFFFFFF
        ja  xdg_shell_geometry_wgu_badh;

        // ---- All validated. Commit the writes. ----

        // word0 = (serial_lo32 << 32) | (window_lo32).
        mov r10, 0xFFFFFFFF;
        mov rax, r8;                // serial
        and rax, r10;
        shl rax, 32;
        mov r11, rsi;               // window
        and r11, r10;
        or  rax, r11;
        mov [rdi + 0], rax;

        // word1 = xy_packed (already caller-packed in the wire layout).
        mov [rdi + 8], rdx;

        // word2 = wh_packed (already caller-packed).
        mov [rdi + 16], rcx;

        xor rax, rax;               // XSG_OK
        ret;

      xdg_shell_geometry_wgu_badout:
        mov rax, 0xFFFFEA7F;        // XSG_BAD_OUT_PTR
        ret;

      xdg_shell_geometry_wgu_badwin:
        mov rax, 0xFFFFEA7E;        // XSG_BAD_WINDOW
        ret;

      xdg_shell_geometry_wgu_badw:
        mov rax, 0xFFFFEA7B;        // XSG_BAD_GEOMETRY_W
        ret;

      xdg_shell_geometry_wgu_badh:
        mov rax, 0xFFFFEA7A;        // XSG_BAD_GEOMETRY_H
        ret
      }
    }

  // ==========================================================================
  // SECTION 9  PREDICATE: interactive_resize_is_corner
  // ==========================================================================
  //
  // Returns 1 iff popcount(edges & 0x0F) == 2. For a well-formed edge
  // bitmask (validated by interactive_resize_request_new above), the four
  // corner combinations TOP_LEFT (0x05), TOP_RIGHT (0x09), BOTTOM_LEFT
  // (0x06), BOTTOM_RIGHT (0x0A) are exactly the popcount==2 subset. The
  // predicate does not itself validate the input: it masks to the low 4
  // bits before counting so high-bit garbage becomes noise that yields
  // false rather than a corruption. A caller that wants strict input
  // rejection layers xdg_shell_states_edges_valid (sibling module) in
  // front.
  //
  // ALGORITHM. Manual 4-bit popcount (no POPCNT dependency): mask to 0x0F,
  // then sum bits 0..3 via shift + and + reg-reg add. Four bits, four
  // add-pairs, one cmp at the end. Pure leaf; no memory access; no
  // callee-save discipline.
  pub let interactive_resize_is_corner : (u64) -> u64 !{} @{} =
    fn (edges: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B7-02 (#2262): popcount==2 predicate over the low 4 bits of `edges`. AND-then-shift bit extraction so each bit falls into [0,1]; add reg,reg accumulator (never add reg,[mem]); final cmp against 2. Uses `cmp reg, imm` + `je` (never `test`). No POPCNT dependency -- the 4-bit input space is small enough that manual summation is cheaper than a feature check. Labels prefixed xdg_shell_geometry_ic_.",
      block: {
        // rax = edges & 0x0F (mask to valid-bits so high-bit noise -> false).
        mov rax, rdi;
        and rax, 0x0F;

        // r10 = bit 0.
        mov r10, rax;
        and r10, 1;

        // r10 += bit 1.
        mov r11, rax;
        shr r11, 1;
        and r11, 1;
        add r10, r11;

        // r10 += bit 2.
        mov r11, rax;
        shr r11, 2;
        and r11, 1;
        add r10, r11;

        // r10 += bit 3.
        mov r11, rax;
        shr r11, 3;
        and r11, 1;
        add r10, r11;

        // popcount == 2 -> 1; else 0.
        cmp r10, 2;
        je  xdg_shell_geometry_ic_yes;
        xor rax, rax;
        ret;

      xdg_shell_geometry_ic_yes:
        mov rax, 1;
        ret
      }
    }
}
