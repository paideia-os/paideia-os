// src/user/compositor/selection_owner.pdx -- Wave0-B7-05 (paideia-os #2268)
//
// KIND_SELECTION_OWNER = 0x1C9, sealed derived cap over KIND_WINDOW
// (= 0x1C1, Wave0-B6-05 sibling).  Design authority:
// design/compositor/pwp-spec-vocabulary.md §2.16 KIND_SELECTION_OWNER.
//
// =============================================================================
// SECTION 0  DESIGN COMMITMENT  --  ONE OWNER PER SELECTION KIND,
//                                   AUTO-REVOKED ON WINDOW DESTROY
// =============================================================================
//
// PaideiaOS' selection-ownership authority is the sibling of the sealed
// clipboard-offer flow at §2.14 (src/user/compositor/clipboard.pdx,
// KIND_CLIP_OFFER = 0x1C6): where CLIP_OFFER carries the payload of
// ONE in-flight paste-request handoff, KIND_SELECTION_OWNER names the
// window that currently OWNS a selection (primary or clipboard) at a
// moment and mints the offer to a specific recipient at paste time.
//
// The load-bearing decisions here (all reversed from the X11 shape) are:
//
//   (1) TWO selection kinds -- SEL_CLIPBOARD (0) and SEL_PRIMARY (1) --
//       sealed at boot.  The set is not extensible at runtime: any
//       future selection kind is a NEW enum value that lands with its
//       own design amendment (mirroring how KIND_SURFACE_COMMIT's op
//       catalogue is stable across a compositor lifetime).  A caller
//       that asks for selection_kind >= 2 is refused at every entry
//       point with SO_BAD_KIND.
//
//   (2) ONE owner per selection kind.  The row pool is indexed by
//       selection_kind rather than being a free-list, so
//       selection_owner_replace is a swap-in-place: the caller learns
//       the previous owner as its return value (may be 0 = no prior
//       owner), and the compositor is free to route any pending offer
//       tied to the previous owner into REVOCATION via the sibling
//       KIND_CLIP_OFFER co_revoke flow.  This is the "PRIMARY /
//       CLIPBOARD split at the X11 protocol level" shape without the
//       X11 "any client can call XGetSelectionOwner without a
//       capability" ambient-authority leak.
//
//   (3) Ownership is revoked AUTOMATICALLY on window destroy.  A
//       stale selection reference cannot survive its owning window --
//       when a client's KIND_WINDOW cap goes out of scope (or the
//       window process crashes), the compositor's window-lifecycle
//       hook calls selection_owner_on_window_destroy(window_kind_id),
//       which walks the two rows and zeros the owner_window_kind_id
//       of any row whose owner matches.  The next paste attempt
//       against the revoked slot sees owner == 0 and fails cleanly
//       (SO_NO_OWNER) rather than reading freed memory or unrelated
//       content -- pitfall P4-adjacent enforcement (a11y P4 is about
//       "a11y-tree bound at window mint"; this is the *symmetric*
//       "selection ownership released at window destroy").
//
//   (4) SEALED cap.  R_SEL_MINT is DELIBERATELY ABSENT from the
//       rights set.  Only the compositor -- which holds the
//       KIND_WINDOW parent cap for every window -- can mint a
//       KIND_SELECTION_OWNER row (the "mint" here is really the
//       initial row-slot arming at boot; the runtime authority is
//       selection_owner_replace, which asserts R_SEL_REPLACE on the
//       caller's cap).  A recipient window cannot re-mint the
//       ownership authority to hand it to a third window; the only
//       transitions are (replace, clear, on_window_destroy) and each
//       is compositor-gated.  Mirrors the sealed posture of
//       KIND_TLS_TRUST (src/kernel/core/cap/kind_tls_trust.pdx) and
//       the sibling KIND_CLIP_OFFER (§2.14).
//
// This user-space module lives on the compositor side of the ring
// boundary (userland supervisor at ring 3); it is not wired into
// cap_table / cap_invoke_dispatch (those live behind kernel ring
// boundaries).  A future promotion of selection-ownership authority
// INTO the kernel (e.g. to make selection-holding a compositor-
// crash-survivable invariant carried by the recovery plane at
// KIND_RECOVERY_PLANE = 0x1C8, sibling B6-09) would move the row
// pool + swap-in body into src/kernel/core/cap/kind_selection_owner.pdx
// and wire the same op catalogue through cap_invoke_dispatch;
// nothing here prevents that promotion.
//
// =============================================================================
// SECTION 1  KIND_* SLOT ALLOCATION
// =============================================================================
//
// KIND_SELECTION_OWNER = 0x1C9.  Grep-verified free across
// src/**/kind_*.pdx + src/**/*_kind.pdx + src/user/compositor/*.pdx +
// design/ at landing time.  Adjacent to:
//   0x1C6  KIND_CLIP_OFFER            (Wave0-B6-08, sibling in the
//                                      clipboard flow)
//   0x1C7  KIND_DND_OFFER             (Wave0-B6-XX, sibling drag-and-
//                                      drop flow)
//   0x1C8  KIND_RECOVERY_PLANE        (Wave0-B6-09)
//   0x1C9  KIND_SELECTION_OWNER       (THIS FILE, Wave0-B7-05)
//
// Parent-kind is KIND_WINDOW (0x1C1, Wave0-B6-05 sibling).  This is a
// deviation from the design doc's naming of KIND_IPC_ENDPOINT (= 5) as
// the parent in the §3 derivation graph: the ipc-endpoint parent is
// the right shape when the selection authority is a free-standing
// service, but PaideiaOS scopes each ownership row to a specific
// KIND_WINDOW (the "which client currently owns this selection?"
// question is always "which of the compositor's windows?", not "which
// arbitrary IPC peer?").  Deriving over KIND_WINDOW makes
// on_window_destroy a natural sibling-lifecycle hook rather than a
// cross-authority callback, and keeps the rights compass local to the
// window-cap surface every consumer already carries.  The op-catalogue
// and RIGHTS layout below are otherwise faithful to the design intent.
//
// =============================================================================
// SECTION 2  SELECTION KIND ENUM  (sealed at boot)
// =============================================================================
//
//   SEL_CLIPBOARD  = 0   (X11-style CLIPBOARD; explicit copy-paste)
//   SEL_PRIMARY    = 1   (X11-style PRIMARY; select-to-copy)
//
// Any value >= 2 is refused at every entry point with SO_BAD_KIND.
// The enum is sealed at boot: a runtime extension would land as a new
// KIND (KIND_SELECTION_OWNER_EX or similar) rather than a widening of
// this enum, so a code path that has been validated against the two-
// row pool never has to defend against a third row appearing.
//
// =============================================================================
// SECTION 3  ROW LAYOUT  --  32 BYTES (FOUR u64 WORDS)
// =============================================================================
//
//   [+0]  owner_win_and_mime:
//         owner_window_kind_id[31:0] | mime_type_count[63:32]
//   [+8]  data_and_reserved:
//         data_kind_id[31:0] | reserved[63:32]
//   [+16] mime_types_ptr    (u64, opaque compositor-owned interned
//                            string table pointer)
//   [+24] owned_since_seq   (u64, monotonic; snapshot of _so_seq at
//                            the moment this owner took the slot)
//
// The pool is indexed BY selection_kind (2 rows only, one per enum
// value).  There is no in_use header bit because the slot always
// exists once boot has zeroed the pool; "empty" is signalled by
// owner_window_kind_id == 0.  Row stride = 32 bytes (a power-of-two
// shift-by-5 rather than the imul-by-40 the sibling clipboard row uses;
// selection_kind is 1 bit at the caller side, so the stride can be
// tighter here).
//
// owner_window_kind_id / data_kind_id / mime_type_count are u32 fields
// packed into u64 halves.  If the KIND_WINDOW id space ever exceeds
// 32 bits (the cap_table row ceiling is well under that today) the row
// grows to 40 bytes here.
//
// owned_since_seq is a full u64 (rather than packing into a header's
// spare bits) for symmetry with the sibling KIND_CLIP_OFFER's
// revocation_seq: a monotonic-counter contract wants NO ambiguity
// about wraparound.  _so_seq is bumped by every successful
// selection_owner_replace and cleared to 0 at boot; its value at
// swap-in time is copied into the row's owned_since_seq.
//
// =============================================================================
// SECTION 4  RIGHTS  --  SEALED (NO R_SEL_MINT)
// =============================================================================
//
//   R_SEL_QUERY_OWNER   0x001   read owner_window_kind_id / is-held
//   R_SEL_REPLACE       0x002   swap in a new owner (returns previous)
//   R_SEL_CLEAR         0x004   release the slot (owner -> 0)
//   R_SEL_OBSERVE       0x008   subscribe to ownership-change events
//                               (out of scope here; declared for parity
//                                with the spec's rights compass)
//   R_SEL_ALL           0x00F   0x001 | 0x002 | 0x004 | 0x008
//
// R_SEL_MINT is DELIBERATELY NOT DEFINED.  The compositor mints the
// row-slots ONCE at boot (selection_owner_init) and does not mint
// again; runtime authority is carried through R_SEL_REPLACE +
// R_SEL_CLEAR on a cap that a client obtained by other means (typically
// as the return value of a compositor RPC that gated on the window
// being a compositor-owned surface).  A recipient cap therefore cannot
// re-share ownership authority with a third window.  Mirrors
// KIND_CLIP_OFFER's R_CO_ALL = 0x013 shape (no R_CO_MINT bit).
//
// =============================================================================
// SECTION 5  OP CATALOGUE  (arity 1; op_arg[63:8] REFUSED per convention)
// =============================================================================
//
//   SO_OP_QUERY_OWNER       (op_arg = selection_kind) -> owner_window_kind_id
//   SO_OP_QUERY_MIME_COUNT  (op_arg = selection_kind) -> mime_type_count
//   SO_OP_QUERY_MIME_PTR    (op_arg = selection_kind) -> mime_types_ptr
//   SO_OP_QUERY_DATA_KIND   (op_arg = selection_kind) -> data_kind_id
//   SO_OP_QUERY_OWNED_SEQ   (op_arg = selection_kind) -> owned_since_seq
//   SO_OP_IS_HELD           (op_arg = selection_kind) -> 0 | 1
//   SO_OP_CLEAR             (op_arg = selection_kind) -> 0 | SO_* sentinel
//
// selection_owner_replace is NOT in the op catalogue because it takes
// four extra u64 args (new_owner, mime_types_ptr, mime_type_count,
// data_kind_id) that do not fit the single-op-arg dispatch shape --
// callers with R_SEL_REPLACE invoke selection_owner_replace directly.
//
// =============================================================================
// SECTION 6  FAILURE TAXONOMY  --  0xFFFFEA70..0xFFFFEA7F
// =============================================================================
//
// Fresh page for KIND_SELECTION_OWNER.  Grep-verified free across
// src/ + design/ at landing time; the 0xFFFFEA family is home to the
// sibling PWP-vocabulary kinds (CO at ...30..3F, LT at ...40..4F,
// RDK at ...50..5F, surface_commit at ...60..6F, WIN at ...A0..AF),
// and 0xFFFFEA70..7F is the next unclaimed page adjacent to that band.
//
// =============================================================================
// SECTION 7  WINDOW-DESTROY CALLBACK
// =============================================================================
//
// selection_owner_on_window_destroy(window_kind_id) walks BOTH rows
// (selection_kind = 0 and 1) and, for each row whose
// owner_window_kind_id matches the destroyed window, calls
// selection_owner_clear(kind) to release the slot.  This IS the
// P4-adjacent auto-revocation gate: no ambient scan, no client-
// requested-cleanup path -- the compositor's window-lifecycle
// dispatcher calls this function unconditionally on every window
// destroy, and any selection that named the destroyed window as owner
// is released synchronously before the destroy returns.
//
// If window_kind_id == 0 the call is a no-op (zero is the "no owner"
// sentinel; treating it as a match would clear both rows on every
// bogus call).  The callback bumps _so_stats[SO_ST_AUTOREVOKES] once
// per row it clears, so the compositor's health rollup can trend the
// "how many selections did that lost-window take with it" metric.
//
// LABEL PREFIX: `selection_owner_` (per task spec).  All ASM jump
// targets are `selection_owner_<funcname>_<tag>` to avoid paideia-as
// reserved-keyword collisions (see feedback_paideia_as_reserved_labels).

module SelectionOwner = structure {

  // ==========================================================================
  // SECTION A  Identity + rights + op catalog + failure taxonomy.
  // ==========================================================================

  pub let KIND_SELECTION_OWNER      : u64 = 0x1C9
  pub let KIND_SELECTION_OWNER_BASE : u64 = 0x1C1   // = KIND_WINDOW

  // SelectionKind enum.  Sealed at boot to {0, 1}; any value >= 2 is
  // refused at every entry point.
  pub let SEL_CLIPBOARD : u64 = 0
  pub let SEL_PRIMARY   : u64 = 1
  pub let SEL_KIND_MAX  : u64 = 2       // exclusive upper bound.

  // Rights.  SEALED cap: NO R_SEL_MINT bit.
  pub let R_SEL_QUERY_OWNER : u64 = 0x001
  pub let R_SEL_REPLACE     : u64 = 0x002
  pub let R_SEL_CLEAR       : u64 = 0x004
  pub let R_SEL_OBSERVE     : u64 = 0x008
  pub let R_SEL_ALL         : u64 = 0x00F

  // Row pool sizing.
  pub let SO_MAX       : u64 = 2         // one row per selection_kind
  pub let SO_ROW_BYTES : u64 = 32        // shift-by-5 stride

  // Op catalogue.  Every op arity ONE -- op_arg is the selection_kind.
  pub let SO_OP_QUERY_OWNER      : u64 = 0
  pub let SO_OP_QUERY_MIME_COUNT : u64 = 1
  pub let SO_OP_QUERY_MIME_PTR   : u64 = 2
  pub let SO_OP_QUERY_DATA_KIND  : u64 = 3
  pub let SO_OP_QUERY_OWNED_SEQ  : u64 = 4
  pub let SO_OP_IS_HELD          : u64 = 5
  pub let SO_OP_CLEAR            : u64 = 6
  pub let SO_OP_MAX              : u64 = 6

  // Cap on mime_type_count (mirrors CO_MIME_MAX in clipboard.pdx: a
  // well-formed selection advertises ~1..10 MIME types; 64 is well
  // clear of any real caller and small enough that a malicious owner
  // cannot exhaust the compositor's interned string table through
  // offer-count amplification).
  pub let SO_MIME_MAX : u64 = 64

  // Failure taxonomy 0xFFFFEA70..0xFFFFEA7F.  Grep-verified free
  // across src/ + design/ at landing.
  pub let SO_OK              : u64 = 0
  pub let SO_BAD_KIND        : u64 = 0xFFFFEA7F   // selection_kind >= 2
  pub let SO_BAD_OWNER       : u64 = 0xFFFFEA7E   // new_owner overflows u32
  pub let SO_BAD_MIME_COUNT  : u64 = 0xFFFFEA7D   // count == 0 or > SO_MIME_MAX
  pub let SO_BAD_MIME_PTR    : u64 = 0xFFFFEA7C   // mime_types_ptr == 0
  pub let SO_BAD_DATA        : u64 = 0xFFFFEA7B   // data_kind_id == 0 or overflow
  pub let SO_BAD_RIGHTS      : u64 = 0xFFFFEA7A   // rights ! subset of R_SEL_ALL
  pub let SO_NO_OWNER        : u64 = 0xFFFFEA79   // slot empty on a read
  pub let SO_UNSUP_OP        : u64 = 0xFFFFEA78   // op_id > SO_OP_MAX
  pub let SO_OP_ARG_RESERVED : u64 = 0xFFFFEA77   // op_arg[63:8] non-zero
  pub let SO_CLEAR_ALREADY   : u64 = 0xFFFFEA76   // slot already empty on clear
  pub let SO_SELF_OWNER      : u64 = 0xFFFFEA75   // new_owner == 0 (use clear)

  pub let SO_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF

  // ==========================================================================
  // SECTION B  State cells.
  // ==========================================================================

  // Row pool.  SO_MAX(2) rows * SO_ROW_BYTES(32) = 64 bytes = 8 u64.
  pub let mut _so_table : [u64; 8] = uninit @align(64)

  // Monotonic ownership sequence.  Bumped by selection_owner_replace
  // (before the row is stamped) so every owner sees a strictly
  // greater owned_since_seq than its predecessor.  Full u64 to
  // foreclose wraparound anxieties.
  pub let mut _so_seq   : [u64; 1] = uninit @align(64)

  // Per-module stats.
  pub let mut _so_stats : [u64; 4] = uninit @align(64)

  pub let SO_ST_REPLACES    : u64 = 0
  pub let SO_ST_CLEARS      : u64 = 1
  pub let SO_ST_AUTOREVOKES : u64 = 2
  pub let SO_ST_REFUSED     : u64 = 3

  // Fingerprint tag.  Data-only at this landing (the compositor's
  // dispatcher emits it via klog_s1_x1 on every successful replace once
  // the sibling wire-up lands); until then this string needs
  // allowlisting in tools/verify-fingerprint-coverage.sh with reason
  // "Wave0-B7-05 (#2268) KIND_SELECTION_OWNER row body landed; the
  // dispatcher-side emit lands with the compositor invoke path -- no
  // mint body to emit from in this file."  Legacy suffix gives grep
  // parity with pre-Wave0 boot-log tooling (see co_mint_ok_msg in
  // src/user/compositor/clipboard.pdx, tui_mint_ok_msg in
  // src/kernel/core/cap/kind_tui_canvas.pdx, and rdk_mint_ok_msg in
  // src/user/color/reference_display_kind.pdx).
  pub let pdx_kind_selection_owner_meta : [u8; 60] = "kind_selection_owner meta [legacy: KIND_SELECTION_OWNER OK]\0"

  // ==========================================================================
  // SECTION C  Counter primitives.
  // ==========================================================================

  // selection_owner_stats_reset() -> (): zero pool + counters at boot.
  pub let selection_owner_stats_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B7-05 (#2268): clear row table + seq + counters at boot. Labels prefixed selection_owner_srs_.",
      block: {
        lea r10, [rip + _so_table];
        xor rax, rax;
        xor rcx, rcx;
      selection_owner_srs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  selection_owner_srs_rows;

        lea r10, [rip + _so_seq];
        mov [r10 + 0], rax;

        lea r10, [rip + _so_stats];
        xor rcx, rcx;
      selection_owner_srs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  selection_owner_srs_stats;
        ret
      }
    }

  // selection_owner_note(which) -> (): bump one stats counter.
  // Encoder-conservative load-inc-store; no add reg,[mem].
  pub let selection_owner_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B7-05 (#2268): counter bump. Encoder-conservative load-inc-store; no add reg,[mem]. Labels prefixed selection_owner_nt_.",
      block: {
        cmp rdi, 4;
        jae selection_owner_nt_out;
        lea r10, [rip + _so_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      selection_owner_nt_out:
        ret
      }
    }

  // selection_owner_stat(which) -> u64: read one stats counter.
  pub let selection_owner_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B7-05 (#2268): counter read; OOB -> 0. Labels prefixed selection_owner_st_.",
      block: {
        cmp rdi, 4;
        jae selection_owner_st_zero;
        lea r10, [rip + _so_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      selection_owner_st_zero:
        xor rax, rax;
        ret
      }
    }

  // selection_owner_seq_bump() -> u64: increment _so_seq and return the
  // NEW value.  Encoder-conservative load-inc-store.  Called from
  // selection_owner_replace so every new owner is stamped with a seq
  // strictly greater than any prior owner's owned_since_seq.
  pub let selection_owner_seq_bump : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B7-05 (#2268): bump monotonic ownership seq and return new value. Load-inc-store; no add reg,[mem]. Labels prefixed selection_owner_sb_.",
      block: {
        lea r10, [rip + _so_seq];
        mov rax, [r10 + 0];
        add rax, 1;
        mov [r10 + 0], rax;
        ret
      }
    }

  // selection_owner_seq_read() -> u64: read _so_seq without bump.
  // Callers use this to snapshot the "current seq" for observation
  // subscriptions (out of scope for this landing).
  pub let selection_owner_seq_read : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B7-05 (#2268): read monotonic ownership seq. Labels prefixed selection_owner_sr_.",
      block: {
        lea r10, [rip + _so_seq];
        mov rax, [r10 + 0];
        ret
      }
    }

  // ==========================================================================
  // SECTION D  Validators.
  // ==========================================================================

  // selection_owner_kind_valid(kind) -> 1 iff kind < SO_KIND_MAX(2).
  pub let selection_owner_kind_valid : (u64) -> u64 !{} @{} =
    fn (kind: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B7-05 (#2268): 1 iff kind < SO_KIND_MAX(2). Sealed enum: SEL_CLIPBOARD(0), SEL_PRIMARY(1). Labels prefixed selection_owner_kv_.",
      block: {
        cmp rdi, 2;
        jae selection_owner_kv_no;
        mov rax, 1;
        ret;
      selection_owner_kv_no:
        xor rax, rax;
        ret
      }
    }

  // selection_owner_rights_valid(rights) -> 1 iff rights subset of R_SEL_ALL(0x00F).
  // The subset test forecloses a caller that tries to slip an
  // undefined bit (e.g. an aspirational R_SEL_MINT) past the gate.
  pub let selection_owner_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B7-05 (#2268): subset test against R_SEL_ALL = 0x00F. NO R_SEL_MINT bit present -- sealed. Labels prefixed selection_owner_rv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x00F;
        and rax, r10;
        cmp rax, rdi;
        jne selection_owner_rv_no;
        mov rax, 1;
        ret;
      selection_owner_rv_no:
        xor rax, rax;
        ret
      }
    }

  // selection_owner_win_valid(win_id) -> 1 iff win_id in (0, 2^32).
  // Non-zero: a zero KIND_WINDOW id would collide with the "no owner"
  // sentinel.  u32-bounded: owner_window_kind_id is stored in a u32
  // half of the row.
  pub let selection_owner_win_valid : (u64) -> u64 !{} @{} =
    fn (win_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B7-05 (#2268): 1 iff win_id in (0, 2^32). Labels prefixed selection_owner_wv_.",
      block: {
        cmp rdi, 0;
        je  selection_owner_wv_no;
        mov rax, rdi;
        shr rax, 32;
        cmp rax, 0;
        jne selection_owner_wv_no;
        mov rax, 1;
        ret;
      selection_owner_wv_no:
        xor rax, rax;
        ret
      }
    }

  // selection_owner_mime_count_valid(count) -> 1 iff 0 < count <= SO_MIME_MAX.
  pub let selection_owner_mime_count_valid : (u64) -> u64 !{} @{} =
    fn (count: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B7-05 (#2268): 1 iff count in (0, SO_MIME_MAX(64)]. Zero-typed selections are refused (no advertised payload shape). Labels prefixed selection_owner_mcv_.",
      block: {
        cmp rdi, 0;
        je  selection_owner_mcv_no;
        mov r10, 64;
        cmp rdi, r10;
        ja  selection_owner_mcv_no;
        mov rax, 1;
        ret;
      selection_owner_mcv_no:
        xor rax, rax;
        ret
      }
    }

  // selection_owner_mime_ptr_valid(mime_ptr) -> 1 iff mime_ptr != 0.
  pub let selection_owner_mime_ptr_valid : (u64) -> u64 !{} @{} =
    fn (mime_ptr: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B7-05 (#2268): 1 iff mime_ptr != 0. The pointer is opaque to the recipient (compositor-owned interned table) but a null pointer is a broken selection. Labels prefixed selection_owner_mpv_.",
      block: {
        cmp rdi, 0;
        je  selection_owner_mpv_no;
        mov rax, 1;
        ret;
      selection_owner_mpv_no:
        xor rax, rax;
        ret
      }
    }

  // selection_owner_data_kind_valid(data_kind_id) -> 1 iff in (0, 2^32).
  pub let selection_owner_data_kind_valid : (u64) -> u64 !{} @{} =
    fn (data_kind_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B7-05 (#2268): 1 iff data_kind_id in (0, 2^32). Non-zero because the payload cap must exist. Labels prefixed selection_owner_dv_.",
      block: {
        cmp rdi, 0;
        je  selection_owner_dv_no;
        mov rax, rdi;
        shr rax, 32;
        cmp rax, 0;
        jne selection_owner_dv_no;
        mov rax, 1;
        ret;
      selection_owner_dv_no:
        xor rax, rax;
        ret
      }
    }

  // selection_owner_op_arg_valid(op_arg) -> 1 iff op_arg[63:8] == 0.
  // The op catalogue takes selection_kind in the low 8 bits; any
  // caller that puts non-zero bits above that is refused per the
  // "arity 1; op_arg[63:8] REFUSED per convention" contract shared
  // across the compositor's op catalogues.
  pub let selection_owner_op_arg_valid : (u64) -> u64 !{} @{} =
    fn (op_arg: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B7-05 (#2268): 1 iff op_arg[63:8] == 0. Labels prefixed selection_owner_oav_.",
      block: {
        mov rax, rdi;
        shr rax, 8;
        cmp rax, 0;
        jne selection_owner_oav_no;
        mov rax, 1;
        ret;
      selection_owner_oav_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // SECTION E  Row-pool addressing.
  //
  // Pool base = _so_table.  Row offset = selection_kind * SO_ROW_BYTES(32).
  // 32 is a shift-by-5 (power-of-two stride) so the row-address
  // computation is a single `shl r,5; add r,base` rather than the imul
  // the sibling clipboard row uses (its 40-byte stride is not a power
  // of two).  Every accessor bounds-checks selection_kind FIRST via
  // selection_owner_kind_valid so an OOB kind never reaches the shift.
  // ==========================================================================

  // selection_owner_row_base(kind) -> ptr | 0.  0 == OOB kind.
  pub let selection_owner_row_base : (u64) -> u64 !{mem} @{} =
    fn (kind: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B7-05 (#2268): row base = _so_table + kind * SO_ROW_BYTES(32). OOB kind returns 0; caller compares against zero before dereferencing. Labels prefixed selection_owner_rb_.",
      block: {
        cmp rdi, 2;
        jae selection_owner_rb_no;
        lea r10, [rip + _so_table];
        mov r11, rdi;
        shl r11, 5;                       // * 32
        add r10, r11;
        mov rax, r10;
        ret;
      selection_owner_rb_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // SECTION F  Row-field query helpers.
  //
  // Every read-side accessor validates kind first, resolves the row
  // base, then extracts the field.  A field on an empty slot returns
  // 0 (for owner / mime_count / data_kind_id / mime_ptr /
  // owned_since_seq) rather than a distinguished sentinel: the caller
  // that needs "is-held?" polls selection_owner_is_held explicitly.
  // ==========================================================================

  // selection_owner_query(kind) -> owner_window_kind_id | 0.
  // 0 == "no owner" (either the slot is empty, or kind was OOB and
  // row_base returned 0).  The convention "owner==0 means no owner"
  // is the same shape a caller sees after selection_owner_clear.
  pub let selection_owner_query : (u64) -> u64 !{mem} @{} =
    fn (kind: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B7-05 (#2268): read owner_window_kind_id at row+0[31:0]. OOB kind -> 0 (same shape as an empty slot). Labels prefixed selection_owner_q_.",
      block: {
        push r12;
        mov r12, rdi;
        call selection_owner_row_base;
        cmp rax, 0;
        je  selection_owner_q_zero;
        mov rax, [rax + 0];
        and rax, 0xFFFFFFFF;
        jmp selection_owner_q_out;
      selection_owner_q_zero:
        xor rax, rax;
      selection_owner_q_out:
        pop r12;
        ret
      }
    }

  // selection_owner_is_held(kind) -> 0 | 1.  1 iff owner != 0.
  pub let selection_owner_is_held : (u64) -> u64 !{mem} @{} =
    fn (kind: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B7-05 (#2268): 1 iff owner_window_kind_id != 0. Delegates to selection_owner_query for the field extract; OOB kind falls through to 0. Labels prefixed selection_owner_ih_.",
      block: {
        push r12;
        mov r12, rdi;
        call selection_owner_query;
        cmp rax, 0;
        je  selection_owner_ih_no;
        mov rax, 1;
        jmp selection_owner_ih_out;
      selection_owner_ih_no:
        xor rax, rax;
      selection_owner_ih_out:
        pop r12;
        ret
      }
    }

  // selection_owner_mime_count(kind) -> mime_type_count | 0.
  pub let selection_owner_mime_count : (u64) -> u64 !{mem} @{} =
    fn (kind: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B7-05 (#2268): read mime_type_count at row+0[63:32]. Labels prefixed selection_owner_mc_.",
      block: {
        push r12;
        mov r12, rdi;
        call selection_owner_row_base;
        cmp rax, 0;
        je  selection_owner_mc_zero;
        mov rax, [rax + 0];
        shr rax, 32;
        jmp selection_owner_mc_out;
      selection_owner_mc_zero:
        xor rax, rax;
      selection_owner_mc_out:
        pop r12;
        ret
      }
    }

  // selection_owner_data_kind(kind) -> data_kind_id | 0.
  pub let selection_owner_data_kind : (u64) -> u64 !{mem} @{} =
    fn (kind: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B7-05 (#2268): read data_kind_id at row+8[31:0]. Labels prefixed selection_owner_dk_.",
      block: {
        push r12;
        mov r12, rdi;
        call selection_owner_row_base;
        cmp rax, 0;
        je  selection_owner_dk_zero;
        mov rax, [rax + 8];
        and rax, 0xFFFFFFFF;
        jmp selection_owner_dk_out;
      selection_owner_dk_zero:
        xor rax, rax;
      selection_owner_dk_out:
        pop r12;
        ret
      }
    }

  // selection_owner_mime_ptr(kind) -> mime_types_ptr | 0.
  pub let selection_owner_mime_ptr : (u64) -> u64 !{mem} @{} =
    fn (kind: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B7-05 (#2268): read mime_types_ptr at row+16. Opaque to the recipient (compositor-owned interned table). Labels prefixed selection_owner_mp_.",
      block: {
        push r12;
        mov r12, rdi;
        call selection_owner_row_base;
        cmp rax, 0;
        je  selection_owner_mp_zero;
        mov rax, [rax + 16];
        jmp selection_owner_mp_out;
      selection_owner_mp_zero:
        xor rax, rax;
      selection_owner_mp_out:
        pop r12;
        ret
      }
    }

  // selection_owner_owned_since(kind) -> owned_since_seq | 0.
  pub let selection_owner_owned_since : (u64) -> u64 !{mem} @{} =
    fn (kind: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B7-05 (#2268): read owned_since_seq at row+24. Labels prefixed selection_owner_os_.",
      block: {
        push r12;
        mov r12, rdi;
        call selection_owner_row_base;
        cmp rax, 0;
        je  selection_owner_os_zero;
        mov rax, [rax + 24];
        jmp selection_owner_os_out;
      selection_owner_os_zero:
        xor rax, rax;
      selection_owner_os_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // SECTION G  Replace + clear.
  // ==========================================================================

  // selection_owner_replace(kind, new_owner, mime_types_ptr,
  //                         mime_type_count, data_kind_id)
  //   -> previous owner (may be 0) | SO_* sentinel
  //
  // Atomic-per-selection-kind swap.  Gate order:
  //   (1) kind             valid   -> SO_BAD_KIND
  //   (2) new_owner        valid   -> SO_BAD_OWNER (u32-bound + non-zero;
  //                                                 zero owner is refused
  //                                                 with SO_SELF_OWNER --
  //                                                 the intended path for
  //                                                 "release ownership" is
  //                                                 selection_owner_clear,
  //                                                 not a swap-in of 0)
  //   (3) mime_type_count  valid   -> SO_BAD_MIME_COUNT
  //   (4) mime_types_ptr   valid   -> SO_BAD_MIME_PTR
  //   (5) data_kind_id     valid   -> SO_BAD_DATA
  //   (6) load previous owner (may be 0)
  //   (7) bump _so_seq; stamp row with new fields + owned_since_seq
  //   (8) bump _so_stats[SO_ST_REPLACES]
  //   (9) return previous owner
  //
  // Register plan: rbx=kind, r12=new_owner, r13=mime_types_ptr,
  // r14=mime_type_count, r15=data_kind_id (all stashed BEFORE any
  // nested call), rbp=previous_owner (stashed across the seq_bump and
  // note calls).  Six callee-save pushes + zero pad = 48 bytes: entry
  // rsp%16==8, +48+8=56, rsp%16==0 for every nested call.
  //
  // Refusal funnel bumps _so_stats[SO_ST_REFUSED] once at
  // selection_owner_rp_refused.
  pub let selection_owner_replace : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (kind: u64) (new_owner: u64) (mime_types_ptr: u64) (mime_type_count: u64) (data_kind_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B7-05 (#2268): atomic-per-kind swap. Six callee-save pushes + one sub rsp,8 = 56 bytes: entry rsp%16==8, +48+8=56, rsp%16==0 for every nested call. All five args stashed BEFORE any nested call: rbx=kind, r12=new_owner, r13=mime_types_ptr, r14=mime_type_count, r15=data_kind_id. rbp holds the loaded previous_owner across seq_bump + note calls. Every validator is a leaf using only r10/r11 scratch beyond the SysV in/out contract. Refusal funnel bumps SO_ST_REFUSED once at selection_owner_rp_refused. Labels prefixed selection_owner_rp_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;
        sub rsp, 8;

        mov rbx, rdi;                     // kind
        mov r12, rsi;                     // new_owner
        mov r13, rdx;                     // mime_types_ptr
        mov r14, rcx;                     // mime_type_count
        mov r15, r8;                      // data_kind_id

        // (1) kind
        mov rdi, rbx;
        call selection_owner_kind_valid;
        cmp rax, 0;
        je  selection_owner_rp_bad_kind;

        // (2) new_owner (non-zero + u32-bound)
        cmp r12, 0;
        je  selection_owner_rp_self_owner;
        mov rdi, r12;
        call selection_owner_win_valid;
        cmp rax, 0;
        je  selection_owner_rp_bad_owner;

        // (3) mime_type_count
        mov rdi, r14;
        call selection_owner_mime_count_valid;
        cmp rax, 0;
        je  selection_owner_rp_bad_mime_count;

        // (4) mime_types_ptr
        mov rdi, r13;
        call selection_owner_mime_ptr_valid;
        cmp rax, 0;
        je  selection_owner_rp_bad_mime_ptr;

        // (5) data_kind_id
        mov rdi, r15;
        call selection_owner_data_kind_valid;
        cmp rax, 0;
        je  selection_owner_rp_bad_data;

        // (6) load previous owner (for the return value).  Row base
        //     is resolvable because kind is validated; row+0[31:0]
        //     carries the current owner.
        mov rdi, rbx;
        call selection_owner_row_base;
        // rax == row base (guaranteed non-zero since kind is valid).
        mov r10, [rax + 0];
        mov rbp, r10;
        and rbp, 0xFFFFFFFF;              // previous_owner = row+0[31:0]

        // (7) Bump _so_seq and stamp the row.  seq_bump returns the
        //     NEW seq value in rax; we copy it into owned_since_seq.
        //     Row base is not preserved across seq_bump (rax is
        //     clobbered), so re-resolve after the bump.
        call selection_owner_seq_bump;
        mov r10, rax;                     // r10 = new_seq

        mov rdi, rbx;
        call selection_owner_row_base;
        // rax = row base again.
        // Pack row+0 = new_owner[31:0] | mime_type_count[63:32].
        mov r11, r12;
        shl r11, 32;
        shr r11, 32;
        mov rcx, r14;
        and rcx, 0xFFFFFFFF;
        shl rcx, 32;
        or  r11, rcx;
        mov [rax + 0], r11;
        // Pack row+8 = data_kind_id[31:0] | reserved[63:32] (== 0).
        mov r11, r15;
        shl r11, 32;
        shr r11, 32;
        mov [rax + 8], r11;
        // Row+16 = mime_types_ptr (u64).
        mov [rax + 16], r13;
        // Row+24 = owned_since_seq = new_seq.
        mov [rax + 24], r10;

        // (8) Bump _so_stats[SO_ST_REPLACES].
        mov rdi, 0;                       // SO_ST_REPLACES
        call selection_owner_note;

        // (9) Return previous_owner.
        mov rax, rbp;
        jmp selection_owner_rp_out;

      selection_owner_rp_bad_kind:
        mov rax, 0xFFFFEA7F;              // SO_BAD_KIND
        jmp selection_owner_rp_refused;
      selection_owner_rp_self_owner:
        mov rax, 0xFFFFEA75;              // SO_SELF_OWNER
        jmp selection_owner_rp_refused;
      selection_owner_rp_bad_owner:
        mov rax, 0xFFFFEA7E;              // SO_BAD_OWNER
        jmp selection_owner_rp_refused;
      selection_owner_rp_bad_mime_count:
        mov rax, 0xFFFFEA7D;              // SO_BAD_MIME_COUNT
        jmp selection_owner_rp_refused;
      selection_owner_rp_bad_mime_ptr:
        mov rax, 0xFFFFEA7C;              // SO_BAD_MIME_PTR
        jmp selection_owner_rp_refused;
      selection_owner_rp_bad_data:
        mov rax, 0xFFFFEA7B;              // SO_BAD_DATA

      selection_owner_rp_refused:
        mov rbp, rax;                     // stash sentinel
        mov rdi, 3;                       // SO_ST_REFUSED
        call selection_owner_note;
        mov rax, rbp;

      selection_owner_rp_out:
        add rsp, 8;
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // selection_owner_clear(kind) -> 0 | SO_BAD_KIND | SO_CLEAR_ALREADY.
  // Zeros the entire row (owner + mime_count + data_kind_id +
  // mime_types_ptr + owned_since_seq).  Bumps _so_stats[SO_ST_CLEARS]
  // on success; refusal path bumps _so_stats[SO_ST_REFUSED] via the
  // funnel.  Called by selection_owner_on_window_destroy for each
  // matched row, and by any caller with R_SEL_CLEAR that wants to
  // release ownership explicitly.
  pub let selection_owner_clear : (u64) -> u64 !{mem} @{} =
    fn (kind: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B7-05 (#2268): release the slot; refuse OOB kind (SO_BAD_KIND) and already-empty slot (SO_CLEAR_ALREADY). One callee-save push (r12=kind) leaves rsp%16==0 across the nested row_base + note calls. Labels prefixed selection_owner_cl_.",
      block: {
        push r12;
        mov r12, rdi;

        // Validate kind.
        mov rdi, r12;
        call selection_owner_kind_valid;
        cmp rax, 0;
        je  selection_owner_cl_bad_kind;

        // Resolve row base + check owner != 0.
        mov rdi, r12;
        call selection_owner_row_base;
        // rax = row base (non-zero for valid kind).
        mov r10, [rax + 0];
        mov r11, r10;
        shl r11, 32;
        shr r11, 32;              // owner_window_kind_id
        cmp r11, 0;
        je  selection_owner_cl_already;

        // Zero all four words.
        xor r10, r10;
        mov [rax + 0],  r10;
        mov [rax + 8],  r10;
        mov [rax + 16], r10;
        mov [rax + 24], r10;

        // Bump _so_stats[SO_ST_CLEARS].
        mov rdi, 1;                       // SO_ST_CLEARS
        call selection_owner_note;

        xor rax, rax;                     // SO_OK
        jmp selection_owner_cl_out;

      selection_owner_cl_bad_kind:
        mov rax, 0xFFFFEA7F;              // SO_BAD_KIND
        jmp selection_owner_cl_refused;
      selection_owner_cl_already:
        mov rax, 0xFFFFEA76;              // SO_CLEAR_ALREADY

      selection_owner_cl_refused:
        mov r12, rax;                     // stash sentinel in r12 (kind no longer needed)
        mov rdi, 3;                       // SO_ST_REFUSED
        call selection_owner_note;
        mov rax, r12;

      selection_owner_cl_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // SECTION H  Window-destroy callback.
  // ==========================================================================

  // selection_owner_on_window_destroy(window_kind_id) -> ()
  //
  // Walks BOTH rows (selection_kind = 0 and 1).  For each row whose
  // owner_window_kind_id == window_kind_id, zeros the row and bumps
  // _so_stats[SO_ST_AUTOREVOKES].  If window_kind_id == 0 the call is
  // a no-op (zero is the "no owner" sentinel; treating it as a match
  // would clear both rows on every bogus call).
  //
  // Register plan: rbx = window_kind_id, r12 = current-kind index.
  // Two callee-save pushes + one sub rsp,8 = 24 bytes: entry rsp%16==8,
  // +16+8=24, rsp%16==0 for every nested call.
  //
  // This IS the P4-adjacent auto-revocation gate: no ambient scan, no
  // client-requested cleanup path -- the compositor's window-lifecycle
  // dispatcher calls this function unconditionally on every window
  // destroy.  The compositor is expected to route any pending
  // KIND_CLIP_OFFER whose source_win matches the destroyed window
  // through co_revoke as a sibling cleanup step (not this file's
  // scope; see clipboard.pdx §11).
  pub let selection_owner_on_window_destroy : (u64) -> () !{mem} @{} =
    fn (window_kind_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B7-05 (#2268): walk both rows, clear any whose owner matches; window_kind_id == 0 is a no-op (zero is the 'no owner' sentinel). Two callee-save pushes + one sub rsp,8 = 24 bytes: entry rsp%16==8, +16+8=24, rsp%16==0 for every nested call. Uses the low-level row-scrub path (not selection_owner_clear) so we can attribute the cleared slot to SO_ST_AUTOREVOKES rather than SO_ST_CLEARS. Labels prefixed selection_owner_wd_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        mov rbx, rdi;                     // window_kind_id

        // No-op guard: window_kind_id == 0 is the "no owner" sentinel;
        // do not walk (would clear both rows on any bogus 0 call).
        cmp rbx, 0;
        je  selection_owner_wd_out;

        xor r12, r12;                     // current-kind index

      selection_owner_wd_scan:
        cmp r12, 2;
        jae selection_owner_wd_out;

        // Resolve row base for kind = r12.
        mov rdi, r12;
        call selection_owner_row_base;
        // rax = row base (non-zero for kind < 2).

        // Load owner_window_kind_id at row+0[31:0].
        mov r10, [rax + 0];
        mov r11, r10;
        shl r11, 32;
        shr r11, 32;              // owner

        // Skip if owner == 0 (slot empty).
        cmp r11, 0;
        je  selection_owner_wd_next;

        // Match?
        cmp r11, rbx;
        jne selection_owner_wd_next;

        // Clear the row (low-level scrub; attribute to SO_ST_AUTOREVOKES).
        xor r10, r10;
        mov [rax + 0],  r10;
        mov [rax + 8],  r10;
        mov [rax + 16], r10;
        mov [rax + 24], r10;

        // Bump _so_stats[SO_ST_AUTOREVOKES].
        mov rdi, 2;                       // SO_ST_AUTOREVOKES
        call selection_owner_note;

      selection_owner_wd_next:
        add r12, 1;
        jmp selection_owner_wd_scan;

      selection_owner_wd_out:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION I  Boot init.
  // ==========================================================================

  // selection_owner_init() -> ().  Boot-time defensive re-scrub.  Zero
  // pool + seq + counters.  .bss is already zero at real boot; this
  // call gives a future witness a clean re-scrub point and matches the
  // reference_display_kind.pdx / clipboard.pdx / kind_tui_canvas.pdx
  // convention.
  pub let selection_owner_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B7-05 (#2268): call through to selection_owner_stats_reset for one clean pool + seq + counter zero-out. Labels prefixed selection_owner_i_.",
      block: {
        call selection_owner_stats_reset;
        ret
      }
    }
}
