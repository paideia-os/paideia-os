      present_feedback_classifier_rdc_out:
        pop r12;
        ret
      }
    }

  pub let present_feedback_classifier_row_last_seq : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-04 (paideia-os #2299): last_classification_seq at body3 (u64). Bad row -> 0xFFFFFFFFFFFFFFFF. Labels prefixed present_feedback_classifier_rls_.",
      block: {
        push r12;
        mov r12, rdi;
        call present_feedback_classifier_tail_valid;
        cmp rax, 0;
        je  present_feedback_classifier_rls_bad;
        lea r10, [rip + _pfc_table];
        mov r11, r12;
        imul r11, r11, 32;
        add r10, r11;
        mov rax, [r10 + 24];
        jmp present_feedback_classifier_rls_out;
      present_feedback_classifier_rls_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      present_feedback_classifier_rls_out:
        pop r12;
        ret
      }
    }

  // present_feedback_classifier_find_by_surface(surface_kind_id)
  //     -> row_id | PFC_ROW_NONE.
  // Uniqueness gate for mint; also usable by callers that hold a
  // surface_kind_id and want to locate its classifier row.
  pub let present_feedback_classifier_find_by_surface : (u64) -> u64 !{mem} @{} =
    fn (surface_kind_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-04 (paideia-os #2299): linear scan for surface_kind_id in header[31:0] of every live row. Labels prefixed present_feedback_classifier_fbs_.",
      block: {
        push rbx;
        push r12;
        mov r12, rdi;
        xor rbx, rbx;
      present_feedback_classifier_fbs_scan:
        cmp rbx, 16;
        jae present_feedback_classifier_fbs_none;
        lea r10, [rip + _pfc_table];
        mov r11, rbx;
        imul r11, r11, 32;
        add r10, r11;
        mov rax, [r10 + 0];
        mov r11, rax;
        shr r11, 56;
        cmp r11, 0;
        je  present_feedback_classifier_fbs_step;
        and rax, 0xFFFFFFFF;
        cmp rax, r12;
        jne present_feedback_classifier_fbs_step;
        mov rax, rbx;
        jmp present_feedback_classifier_fbs_out;
      present_feedback_classifier_fbs_step:
        add rbx, 1;
        jmp present_feedback_classifier_fbs_scan;
      present_feedback_classifier_fbs_none:
        mov rax, 0xFFFFEAD6;               // PFC_ROW_NONE
      present_feedback_classifier_fbs_out:
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION G  classifier_classify  -- pure threshold-tree function.
  // ==========================================================================
  //
  // present_feedback_classifier_classify(present_nsec, target_vblank_nsec)
  //     -> PresentClassification (0/1/2).
  //
  // Threshold tree (§4):
  //   if P <= T + PFC_ON_TIME_MARGIN_NSEC:   return PRESENT_ON_TIME
  //   else if P <= T + PFC_LATE_MARGIN_NSEC: return PRESENT_LATE
  //   else:                                  return PRESENT_DROPPED
  //
  // No memory access, no callee-save, no stats bump -- this function is
  // called on every present the compositor observes (up to 60/120/240 Hz
  // per surface) so it stays as cheap as possible.
  pub let present_feedback_classifier_classify : (u64, u64) -> u64 !{} @{} =
    fn (present_nsec: u64) (target_vblank_nsec: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B11-04 (paideia-os #2299): pure classifier. rdi=present_nsec (P), rsi=target_vblank_nsec (T). Compute T+ON_TIME_MARGIN, compare P; if P<=that -> return 0. Compute T+LATE_MARGIN, compare P; if P<=that -> return 1. Else return 2. Overflow on T+margin not reachable with monotonic-ns clock (see §4). Labels prefixed present_feedback_classifier_c_.",
      block: {
        // Threshold 1: T + PFC_ON_TIME_MARGIN_NSEC (1_000_000 ns).
        mov rax, rsi;
        mov r10, 1000000;
        add rax, r10;
        cmp rdi, rax;
        jbe present_feedback_classifier_c_ontime;

        // Threshold 2: T + PFC_LATE_MARGIN_NSEC (5_000_000 ns).
        mov rax, rsi;
        mov r10, 5000000;
        add rax, r10;
        cmp rdi, rax;
        jbe present_feedback_classifier_c_late;

        // Fallthrough: DROPPED.
        mov rax, 2;
        ret;

      present_feedback_classifier_c_ontime:
        xor rax, rax;                       // PRESENT_ON_TIME = 0
        ret;
      present_feedback_classifier_c_late:
        mov rax, 1;                         // PRESENT_LATE = 1
        ret
      }
    }

  // ==========================================================================
  // SECTION H  classifier_mint  /  classifier_revoke
  // ==========================================================================
  //
  // present_feedback_classifier_mint(surface_kind_id)
  //     -> row_id | PFC_MINT_* sentinel.
  //
  // Fresh row: on_time_count=0, late_count=0, dropped_count=0,
  // last_classification_seq=0, back_pressure_active=0.  Gate order:
  // surface_valid, uniqueness, pack + alloc.
  pub let present_feedback_classifier_mint : (u64) -> u64 !{mem} @{} =
    fn (surface_kind_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-04 (paideia-os #2299): allocate one classifier row. Two callee-save pushes (rbx=surface_kind_id, r12=hdr) leave rsp%16==8; sub rsp,8 aligns to 16 for every nested call. Refusal funnel bumps _pfc_stats[PFC_ST_REFUSED] once at present_feedback_classifier_mb_refused. Labels prefixed present_feedback_classifier_mb_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        mov rbx, rdi;                     // surface_kind_id

        // (1) surface_kind_id nonzero + fits in u32.
        mov rdi, rbx;
        call present_feedback_classifier_surface_valid;
        cmp rax, 0;
        je  present_feedback_classifier_mb_bad_surface;

        // (2) surface_kind_id uniqueness.
        mov rdi, rbx;
        call present_feedback_classifier_find_by_surface;
        mov r10, 0xFFFFEAD6;              // PFC_ROW_NONE
        cmp rax, r10;
        jne present_feedback_classifier_mb_dup;

        // (3) Pack header.
        mov rdi, rbx;
        call present_feedback_classifier_hdr_pack;
        mov r12, rax;                     // r12 = hdr

        // tail_alloc(hdr); body1..body3 zeroed by allocator.
        mov rdi, r12;
        call present_feedback_classifier_tail_alloc;

        mov r10, 16;
        cmp rax, r10;
        jae present_feedback_classifier_mb_enospc;   // rax already sentinel

        // Success: bump mints, preserve row_id across the note call.
        mov rbx, rax;
        mov rdi, 0;                       // PFC_ST_MINTS
        call present_feedback_classifier_stats_bump;
        mov rax, rbx;
        jmp present_feedback_classifier_mb_out;

      present_feedback_classifier_mb_bad_surface:
        mov rax, 0xFFFFEADD;              // PFC_MINT_BAD_SURFACE
        jmp present_feedback_classifier_mb_refused;
      present_feedback_classifier_mb_dup:
        mov rax, 0xFFFFEADC;              // PFC_MINT_DUP
        jmp present_feedback_classifier_mb_refused;
      present_feedback_classifier_mb_enospc:
        // rax already PFC_TAIL_ENOSPC (0xFFFFEADF).

      present_feedback_classifier_mb_refused:
        mov rbx, rax;                     // stash sentinel
        mov rdi, 5;                       // PFC_ST_REFUSED
        call present_feedback_classifier_stats_bump;
        mov rax, rbx;

      present_feedback_classifier_mb_out:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }

  // present_feedback_classifier_revoke(row_id) -> 0 | PFC_BAD_SLOT
  //                                                | PFC_REVOKE_ALREADY.
  pub let present_feedback_classifier_revoke : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-04 (paideia-os #2299): revoke one row. row_id >= PFC_MAX -> PFC_BAD_SLOT; not in_use -> PFC_REVOKE_ALREADY; else free + bump revokes + return 0. One callee-save push (r12=row_id) gives rsp%16==0 for every nested call. Labels prefixed present_feedback_classifier_rev_.",
      block: {
        push r12;
        mov r12, rdi;

        mov r10, 16;
        cmp r12, r10;
        jae present_feedback_classifier_rev_bad_slot;

        mov rdi, r12;
        call present_feedback_classifier_tail_valid;
        cmp rax, 0;
        je  present_feedback_classifier_rev_already;

        mov rdi, r12;
        call present_feedback_classifier_tail_free;
        mov rdi, 1;                       // PFC_ST_REVOKES
        call present_feedback_classifier_stats_bump;
        xor rax, rax;
        jmp present_feedback_classifier_rev_out;

      present_feedback_classifier_rev_bad_slot:
        mov rax, 0xFFFFEADB;              // PFC_BAD_SLOT
        jmp present_feedback_classifier_rev_out;
      present_feedback_classifier_rev_already:
        mov rax, 0xFFFFEAD9;              // PFC_REVOKE_ALREADY

      present_feedback_classifier_rev_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // SECTION I  classifier_ingest  -- bump counters + evaluate back-pressure
  // ==========================================================================
  //
  // present_feedback_classifier_ingest(row_id, classification)
  //     -> 0 | PFC_BAD_SLOT | PFC_BAD_CLASS | PFC_INGEST_OVERFLOW.
  //
  // 1. Validates row_id + class (class must be in {0,1,2}; PRESENT_VBLANK
  //    is refused with PFC_BAD_CLASS per §1).
  // 2. Bumps the appropriate u32 sub-counter (refusing u32 overflow).
  // 3. Bumps last_classification_seq.
  // 4. If class in {LATE, DROPPED}, re-evaluates the back-pressure gate:
  //    if (late_count + dropped_count) >= PFC_BP_THRESHOLD and back-
  //    pressure was NOT previously latched, latches it to 1 and bumps
  //    the aggregate PFC_ST_BP_ACTIVATIONS.
  // 5. Bumps aggregate PFC_ST_INGESTS.
  pub let present_feedback_classifier_ingest : (u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64) (classification: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-04 (paideia-os #2299): ingest one classification. Four callee-save pushes (rbx=row_id, r12=class, r13=row base, r14=scratch) = 32 bytes: entry rsp%16==8, +32+8=40, sub rsp,8 aligns to 48, %16==0 for nested calls. Order: validate row, validate class, update the appropriate counter, bump seq, evaluate back-pressure. Labels prefixed present_feedback_classifier_in_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        sub rsp, 8;

        mov rbx, rdi;                     // row_id
        mov r12, rsi;                     // classification

        // (1) row valid.
        mov rdi, rbx;
        call present_feedback_classifier_tail_valid;
        cmp rax, 0;
        je  present_feedback_classifier_in_bad_slot;

        // (2) class valid (0..2).
        mov rdi, r12;
        call present_feedback_classifier_class_valid;
        cmp rax, 0;
        je  present_feedback_classifier_in_bad_class;

        // Compute row base.
        lea r10, [rip + _pfc_table];
        mov r11, rbx;
        imul r11, r11, 32;
        add r10, r11;
        mov r13, r10;                     // r13 = row base

        // (3) Bump the appropriate sub-counter based on class.
        cmp r12, 0;
        je  present_feedback_classifier_in_bump_on_time;
        cmp r12, 1;
        je  present_feedback_classifier_in_bump_late;
        // class == 2: DROPPED.
        jmp present_feedback_classifier_in_bump_dropped;

      present_feedback_classifier_in_bump_on_time:
        // body1[31:0] += 1 (refuse u32 overflow).
        mov rax, [r13 + 8];
        mov r11, rax;
        shl r11, 32;
        shr r11, 32;                      // r11 = current on_time
        mov r10, 0xFFFFFFFF;
        cmp r11, r10;
        je  present_feedback_classifier_in_overflow;
        add r11, 1;
        // Reassemble: preserve high 32 bits of body1 (late_count).
        mov r10, 0xFFFFFFFF;
        shl r10, 32;                      // 0xFFFFFFFF00000000
        and rax, r10;
        or  rax, r11;
        mov [r13 + 8], rax;
        jmp present_feedback_classifier_in_seq;

      present_feedback_classifier_in_bump_late:
        // body1[63:32] += 1 (refuse u32 overflow).
        mov rax, [r13 + 8];
        mov r11, rax;
        shr r11, 32;                      // r11 = current late
        mov r10, 0xFFFFFFFF;
        cmp r11, r10;
        je  present_feedback_classifier_in_overflow;
        add r11, 1;
        // Reassemble: preserve low 32 bits of body1 (on_time_count).
        mov r10, 0xFFFFFFFF;
        and rax, r10;                     // rax = old on_time (low32)
        shl r11, 32;
        or  rax, r11;
        mov [r13 + 8], rax;
        jmp present_feedback_classifier_in_seq;

      present_feedback_classifier_in_bump_dropped:
        // body2[31:0] += 1 (refuse u32 overflow).
        mov rax, [r13 + 16];
        mov r11, rax;
        shl r11, 32;
        shr r11, 32;                      // r11 = current dropped
        mov r10, 0xFFFFFFFF;
        cmp r11, r10;
        je  present_feedback_classifier_in_overflow;
        add r11, 1;
        // Reassemble: preserve high 32 bits (reserved).
        mov r10, 0xFFFFFFFF;
        shl r10, 32;
        and rax, r10;
        or  rax, r11;
        mov [r13 + 16], rax;

      present_feedback_classifier_in_seq:
        // (4) Bump last_classification_seq (body3, u64).  Saturate at u64
        // max as a defence-in-depth belt (unreachable in any real boot
        // window).
        mov rax, [r13 + 24];
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  present_feedback_classifier_in_bp_check;
        add rax, 1;
        mov [r13 + 24], rax;

      present_feedback_classifier_in_bp_check:
        // (5) Back-pressure gate: only relevant if class is LATE or
        // DROPPED.  Class ON_TIME (0) skips the gate.
        cmp r12, 0;
        je  present_feedback_classifier_in_done;

        // Read on_time (unused here), late (body1 high 32), dropped
        // (body2 low 32); test (late + dropped) >= PFC_BP_THRESHOLD.
        mov rax, [r13 + 8];
        shr rax, 32;                      // rax = late_count
        mov r14, rax;
        mov rax, [r13 + 16];
        and rax, 0xFFFFFFFF;              // rax = dropped_count
        add r14, rax;                     // r14 = late + dropped

        mov r10, 4;                       // PFC_BP_THRESHOLD
        cmp r14, r10;
        jb  present_feedback_classifier_in_done;

        // Threshold crossed.  Check current back_pressure_active bit at
        // header[39:32]; if already set, do nothing (monotonic latch).
        mov rax, [r13 + 0];
        mov r11, rax;
        shr r11, 32;
        and r11, 0xFF;
        cmp r11, 0;
        jne present_feedback_classifier_in_done;

        // Latch back_pressure_active = 1 into header[39:32].  Mask off
        // the byte then OR in 1<<32.
        mov r10, 0xFF;
        shl r10, 32;
        not r10;                          // clear-mask for [39:32]
        and rax, r10;
        mov r11, 1;
        shl r11, 32;
        or  rax, r11;
        mov [r13 + 0], rax;

        // Bump aggregate PFC_ST_BP_ACTIVATIONS.
        mov rdi, 6;                       // PFC_ST_BP_ACTIVATIONS
        call present_feedback_classifier_stats_bump;

      present_feedback_classifier_in_done:
        // Bump aggregate PFC_ST_INGESTS.
        mov rdi, 2;                       // PFC_ST_INGESTS
        call present_feedback_classifier_stats_bump;
        xor rax, rax;
        jmp present_feedback_classifier_in_out;

      present_feedback_classifier_in_bad_slot:
        mov rax, 0xFFFFEADB;              // PFC_BAD_SLOT
        jmp present_feedback_classifier_in_refused;
      present_feedback_classifier_in_bad_class:
        mov rax, 0xFFFFEADA;              // PFC_BAD_CLASS
        jmp present_feedback_classifier_in_refused;
      present_feedback_classifier_in_overflow:
        mov rax, 0xFFFFEAD7;              // PFC_INGEST_OVERFLOW

      present_feedback_classifier_in_refused:
        mov rbx, rax;                     // stash sentinel
        mov rdi, 5;                       // PFC_ST_REFUSED
        call present_feedback_classifier_stats_bump;
        mov rax, rbx;

      present_feedback_classifier_in_out:
        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION J  classifier_back_pressure_signal  -- hot-path polling
  // ==========================================================================
  //
  // present_feedback_classifier_back_pressure_signal(row_id) -> u8.
  //
  // Returns 1 iff back_pressure_active is set on the in_use row; 0 iff
  // row not in_use or back-pressure not latched.  Designed to be poll-
  // loop hot: one bounds check + one u64 load + shift + mask, no stats
  // bump, no callee-save frame beyond the tail_valid call.
  pub let present_feedback_classifier_back_pressure_signal : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-04 (paideia-os #2299): read back_pressure_active at header[39:32]. One callee-save push (r12=row_id) gives rsp%16==0 for the nested tail_valid call. Returns 0 (u8-widened) if row not in_use; returns 0 or 1 otherwise. Labels prefixed present_feedback_classifier_bp_.",
      block: {
        push r12;
        mov r12, rdi;
        call present_feedback_classifier_tail_valid;
        cmp rax, 0;
        je  present_feedback_classifier_bp_zero;
        lea r10, [rip + _pfc_table];
        mov r11, r12;
        imul r11, r11, 32;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 32;
        and rax, 0xFF;
        jmp present_feedback_classifier_bp_out;
      present_feedback_classifier_bp_zero:
        xor rax, rax;
      present_feedback_classifier_bp_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // SECTION K  classifier_reset  -- clear counters + back-pressure latch
  // ==========================================================================
  //
  // present_feedback_classifier_reset(row_id) -> 0 | PFC_BAD_SLOT.
  //
  // Clears on_time_count, late_count, dropped_count, back_pressure_
  // active.  PRESERVES surface_kind_id (header[31:0]) and last_
  // classification_seq (body3) -- see §1 reset for the rationale.
  // Bumps aggregate PFC_ST_RESETS.
  pub let present_feedback_classifier_reset : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-04 (paideia-os #2299): clear per-row counters + back-pressure latch. Two callee-save pushes (rbx=row_id, r12=row base) leave rsp%16==8; sub rsp,8 aligns for nested tail_valid + stats_bump. Rewrites header preserving in_use and surface_kind_id, clearing back_pressure_active. Zeros body1 and body2 (all counters). Preserves body3 (last_classification_seq). Labels prefixed present_feedback_classifier_rst_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        mov rbx, rdi;                     // row_id

        mov rdi, rbx;
        call present_feedback_classifier_tail_valid;
        cmp rax, 0;
        je  present_feedback_classifier_rst_bad_slot;

        lea r10, [rip + _pfc_table];
        mov r11, rbx;
        imul r11, r11, 32;
        add r10, r11;
        mov r12, r10;                     // r12 = row base

        // Header: preserve in_use[63:56] + surface_kind_id[31:0]; clear
        // back_pressure_active[39:32] and reserved bytes.
        mov rax, [r12 + 0];
        // Mask: in_use bit + surface_kind_id low 32.
        mov r11, 0xFF;
        shl r11, 56;                      // in_use mask
        mov r10, 0xFFFFFFFF;              // surface mask
        or  r10, r11;                     // combined preserve mask
        and rax, r10;
        mov [r12 + 0], rax;

        // Body1 (on_time / late) = 0.
        xor rax, rax;
        mov [r12 + 8], rax;
        // Body2 (dropped + reserved) = 0.
        mov [r12 + 16], rax;
        // Body3 (last_classification_seq) PRESERVED.

        mov rdi, 3;                       // PFC_ST_RESETS
        call present_feedback_classifier_stats_bump;
        xor rax, rax;
        jmp present_feedback_classifier_rst_out;

      present_feedback_classifier_rst_bad_slot:
        mov rax, 0xFFFFEADB;              // PFC_BAD_SLOT
        mov rbx, rax;
        mov rdi, 5;                       // PFC_ST_REFUSED
        call present_feedback_classifier_stats_bump;
        mov rax, rbx;

      present_feedback_classifier_rst_out:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION L  Bundled query  --  classifier_stats
  // ==========================================================================
  //
  // present_feedback_classifier_stats(row_id, out_ptr) -> 0 | error.
  //
  // Writes 32 bytes at *out_ptr (four u64 fields, little-endian):
  //   [+0]  on_time_count (zero-extended to u64)
  //   [+8]  late_count    (zero-extended to u64)
  //   [+16] dropped_count (zero-extended to u64)
  //   [+24] back_pressure_active (zero-extended to u64)
  // Bumps PFC_ST_QUERIES once per call.  Refuses out_ptr == 0 or
  // 0xFFFF..FF with PFC_STATS_BAD_PTR.
  pub let present_feedback_classifier_stats : (u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64) (out_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-04 (paideia-os #2299): bundled stats read. Three callee-save pushes (rbx=row_id, r12=out_ptr, r13=row base) leave rsp%16==0 for every nested call. Labels prefixed present_feedback_classifier_qs_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                     // row_id
        mov r12, rsi;                     // out_ptr

        // Gate: out_ptr valid.
        mov rdi, r12;
        call present_feedback_classifier_out_ptr_valid;
        cmp rax, 0;
        je  present_feedback_classifier_qs_bad_ptr;

        // Gate: row valid.
        mov rdi, rbx;
        call present_feedback_classifier_tail_valid;
        cmp rax, 0;
        je  present_feedback_classifier_qs_bad_slot;

        // Note the query.
        mov rdi, 4;                       // PFC_ST_QUERIES
        call present_feedback_classifier_stats_bump;

        lea r10, [rip + _pfc_table];
        mov r11, rbx;
        imul r11, r11, 32;
        add r10, r11;
        mov r13, r10;                     // r13 = row base

        // out[+0] = on_time_count (body1[31:0], zero-extend).
        mov rax, [r13 + 8];
        and rax, 0xFFFFFFFF;
        mov [r12 + 0], rax;
        // out[+8] = late_count (body1[63:32]).
        mov rax, [r13 + 8];
        shr rax, 32;
        mov [r12 + 8], rax;
        // out[+16] = dropped_count (body2[31:0]).
        mov rax, [r13 + 16];
        and rax, 0xFFFFFFFF;
        mov [r12 + 16], rax;
        // out[+24] = back_pressure_active (header[39:32], zero-extend).
        mov rax, [r13 + 0];
        shr rax, 32;
        and rax, 0xFF;
        mov [r12 + 24], rax;

        xor rax, rax;
        jmp present_feedback_classifier_qs_out;

      present_feedback_classifier_qs_bad_ptr:
        mov rax, 0xFFFFEAD8;              // PFC_STATS_BAD_PTR
        jmp present_feedback_classifier_qs_refused;
      present_feedback_classifier_qs_bad_slot:
        mov rax, 0xFFFFEADB;              // PFC_BAD_SLOT

      present_feedback_classifier_qs_refused:
        mov rbx, rax;
        mov rdi, 5;                       // PFC_ST_REFUSED
        call present_feedback_classifier_stats_bump;
        mov rax, rbx;

      present_feedback_classifier_qs_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION M  Boot init.
  // ==========================================================================

  pub let present_feedback_classifier_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-04 (paideia-os #2299): scrub row pool + all stats counters. 16 rows * 4 u64 = 64 u64 for the table, 8 u64 for stats. Two encoder-safe step-loops (`_step` suffix to avoid the paideia-as `loop` keyword collision). Labels prefixed present_feedback_classifier_i_.",
      block: {
        // Scrub _pfc_table.
        lea r10, [rip + _pfc_table];
        xor rax, rax;
        xor rcx, rcx;
      present_feedback_classifier_i_rows_step:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 64;
        jb  present_feedback_classifier_i_rows_step;

        // Scrub _pfc_stats.
        lea r10, [rip + _pfc_stats];
        xor rcx, rcx;
      present_feedback_classifier_i_stats_step:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  present_feedback_classifier_i_stats_step;
        ret
      }
    }
}
