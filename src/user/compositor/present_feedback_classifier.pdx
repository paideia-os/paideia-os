  pub let present_feedback_classifier_stats_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-04 (paideia-os #2299): scrub all eight cells of _pfc_stats (seven live slots + one reserved). Encoder-safe short step-loop; `_step` suffix (not `_loop`) avoids the paideia-as `loop` keyword collision. Labels prefixed present_feedback_classifier_sre_.",
      block: {
        lea r10, [rip + _pfc_stats];
        xor rax, rax;
        xor rcx, rcx;
      present_feedback_classifier_sre_step:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  present_feedback_classifier_sre_step;
        ret
      }
    }

  // ==========================================================================
  // SECTION C  Validators.
  // ==========================================================================

  // present_feedback_classifier_surface_valid: 1 iff surface_kind_id
  // nonzero AND fits in u32.  Zero is refused (no live surface has row_id
  // 0 in the compositor's model).  Used by mint to gate
  // PFC_MINT_BAD_SURFACE.
  pub let present_feedback_classifier_surface_valid : (u64) -> u64 !{} @{} =
    fn (surface_kind_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B11-04 (paideia-os #2299): 1 iff surface_kind_id in (0, 2^32). Labels prefixed present_feedback_classifier_sv2_.",
      block: {
        cmp rdi, 0;
        je  present_feedback_classifier_sv2_no;
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  present_feedback_classifier_sv2_no;
        mov rax, 1;
        ret;
      present_feedback_classifier_sv2_no:
        xor rax, rax;
        ret
      }
    }

  // present_feedback_classifier_class_valid: 1 iff class in 0..2
  // (ingest-side trichotomy).  PRESENT_VBLANK (3) is refused -- see §1
  // ingest for the rationale.
  pub let present_feedback_classifier_class_valid : (u64) -> u64 !{} @{} =
    fn (class: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B11-04 (paideia-os #2299): 1 iff class <= PFC_CLASS_INGEST_MAX(2). Labels prefixed present_feedback_classifier_cv_.",
      block: {
        cmp rdi, 2;
        ja  present_feedback_classifier_cv_no;
        mov rax, 1;
        ret;
      present_feedback_classifier_cv_no:
        xor rax, rax;
        ret
      }
    }

  // present_feedback_classifier_out_ptr_valid: 1 iff out_ptr not 0 and
  // not the 0xFFFF..FF sentinel.  Used by classifier_stats.
  pub let present_feedback_classifier_out_ptr_valid : (u64) -> u64 !{} @{} =
    fn (out_ptr: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B11-04 (paideia-os #2299): 1 iff out_ptr not 0 and not 0xFFFFFFFFFFFFFFFF. Caller MUST supply a 32-byte writable buffer per §1 classifier_stats. Labels prefixed present_feedback_classifier_ov_.",
      block: {
        cmp rdi, 0;
        je  present_feedback_classifier_ov_no;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rdi, r10;
        je  present_feedback_classifier_ov_no;
        mov rax, 1;
        ret;
      present_feedback_classifier_ov_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // SECTION D  Packers.
  // ==========================================================================

  // header: in_use[63:56] | reserved[55:40] | back_pressure_active[39:32] |
  //         surface_kind_id[31:0].
  // Emitted WITHOUT in_use bit set and WITHOUT back_pressure_active set;
  // tail_alloc ORs the in_use marker in on claim.
  pub let present_feedback_classifier_hdr_pack : (u64) -> u64 !{} @{} =
    fn (surface_kind_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B11-04 (paideia-os #2299): header pack. surface_kind_id at [31:0]; must be nonzero + <=u32 (present_feedback_classifier_surface_valid). back_pressure_active starts 0 (cleared bits at [39:32]). Bad arg -> 0xFFFFFFFFFFFFFFFF sentinel (tail_alloc catches). Labels prefixed present_feedback_classifier_hp_.",
      block: {
        cmp rdi, 0;
        je  present_feedback_classifier_hp_bad;
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  present_feedback_classifier_hp_bad;
        mov rax, rdi;
        and rax, 0xFFFFFFFF;
        ret;
      present_feedback_classifier_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // SECTION E  Row pool: valid / alloc / free.
  // ==========================================================================

  pub let present_feedback_classifier_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-04 (paideia-os #2299): 1 iff row_id < PFC_MAX(16) and in_use. Row stride 32 bytes. Labels prefixed present_feedback_classifier_tv_.",
      block: {
        cmp rdi, 16;
        jae present_feedback_classifier_tv_no;
        lea r10, [rip + _pfc_table];
        mov r11, rdi;
        imul r11, r11, 32;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  present_feedback_classifier_tv_no;
        mov rax, 1;
        ret;
      present_feedback_classifier_tv_no:
        xor rax, rax;
        ret
      }
    }

  // present_feedback_classifier_tail_alloc(hdr) -> row_id | err.
  // Low-first scan over 16 rows.  Header stamped with in_use bit (bit 56)
  // here so callers pass an "unset in_use" packed header.  body1..body3
  // zeroed on claim (fresh row: on_time=0, late=0, dropped=0, seq=0,
  // back_pressure_active=0).
  pub let present_feedback_classifier_tail_alloc : (u64) -> u64 !{mem} @{} =
    fn (hdr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-04 (paideia-os #2299): claim one classifier row. Low-first scan (rbx=idx) over 16 rows of 32 bytes (idx*32 via imul). On claim: OR the 1<<56 in_use marker into hdr and store four u64 words (body1..body3 zero). Refuses when hdr already has the in_use bit set (caller error) or when hdr is the bad-arg sentinel. Two callee-save pushes (rbx=idx, r12=hdr); no nested calls in the body so post-push rsp alignment is benign. Labels prefixed present_feedback_classifier_ta_.",
      block: {
        push rbx;
        push r12;

        mov r12, rdi;

        // Refuse a hdr that already has in_use set (caller error).
        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne present_feedback_classifier_ta_bad;
        // Refuse the bad-arg sentinel from the packer.
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp r12, r10;
        je  present_feedback_classifier_ta_bad;

        xor rbx, rbx;
      present_feedback_classifier_ta_scan:
        cmp rbx, 16;
        jae present_feedback_classifier_ta_enospc;
        lea r10, [rip + _pfc_table];
        mov r11, rbx;
        imul r11, r11, 32;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  present_feedback_classifier_ta_claim;
        add rbx, 1;
        jmp present_feedback_classifier_ta_scan;

      present_feedback_classifier_ta_claim:
        mov rax, r12;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0],  rax;
        xor rax, rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        mov rax, rbx;
        jmp present_feedback_classifier_ta_out;

      present_feedback_classifier_ta_enospc:
        mov rax, 0xFFFFEADF;
        jmp present_feedback_classifier_ta_out;
      present_feedback_classifier_ta_bad:
        mov rax, 0xFFFFEADE;

      present_feedback_classifier_ta_out:
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let present_feedback_classifier_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-04 (paideia-os #2299): scrub one row (all four words). Labels prefixed present_feedback_classifier_tf_.",
      block: {
        cmp rdi, 16;
        jae present_feedback_classifier_tf_out;
        lea r10, [rip + _pfc_table];
        mov r11, rdi;
        imul r11, r11, 32;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
      present_feedback_classifier_tf_out:
        ret
      }
    }

  // ==========================================================================
  // SECTION F  Row-field query helpers.
  // ==========================================================================

  pub let present_feedback_classifier_row_surface : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-04 (paideia-os #2299): surface_kind_id at header[31:0]. Bad row -> 0xFFFFFFFFFFFFFFFF. Labels prefixed present_feedback_classifier_rs_.",
      block: {
        push r12;
        mov r12, rdi;
        call present_feedback_classifier_tail_valid;
        cmp rax, 0;
        je  present_feedback_classifier_rs_bad;
        lea r10, [rip + _pfc_table];
        mov r11, r12;
        imul r11, r11, 32;
        add r10, r11;
        mov rax, [r10 + 0];
        and rax, 0xFFFFFFFF;
        jmp present_feedback_classifier_rs_out;
      present_feedback_classifier_rs_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      present_feedback_classifier_rs_out:
        pop r12;
        ret
      }
    }

  pub let present_feedback_classifier_row_on_time_count : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-04 (paideia-os #2299): on_time_count at body1[31:0]. Bad row -> 0xFFFFFFFFFFFFFFFF. Labels prefixed present_feedback_classifier_rot_.",
      block: {
        push r12;
        mov r12, rdi;
        call present_feedback_classifier_tail_valid;
        cmp rax, 0;
        je  present_feedback_classifier_rot_bad;
        lea r10, [rip + _pfc_table];
        mov r11, r12;
        imul r11, r11, 32;
        add r10, r11;
        mov rax, [r10 + 8];
        and rax, 0xFFFFFFFF;
        jmp present_feedback_classifier_rot_out;
      present_feedback_classifier_rot_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      present_feedback_classifier_rot_out:
        pop r12;
