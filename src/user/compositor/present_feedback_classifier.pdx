// src/user/compositor/present_feedback_classifier.pdx -- Wave0-B11-04 (paideia-os #2299)
//
// MISSED-PRESENT + LATE-PRESENT CLASSIFIER + CLIENT BACK-PRESSURE SIGNAL.
//
// src/user/compositor/present_feedback_kind.pdx (Wave0-B9-07, KIND_PRESENT_
// FEEDBACK = 0x1DA) lands the per-surface feedback ROW and stores the LAST
// classification the compositor stamped into each surface's row.  It also
// EXPORTS the PresentClassification enum (PRESENT_ON_TIME=0, PRESENT_LATE=1,
// PRESENT_DROPPED=2, PRESENT_VBLANK=3) that the row's header[47:40] byte
// carries.  What it deliberately does NOT own: the CLASSIFICATION LOGIC
// itself -- the threshold policy that decides, given a present timestamp
// and its target vblank timestamp, which enum value to stamp.  Nor the
// per-surface HISTORY of classifications, nor the aggregate BACK-PRESSURE
// SIGNAL that a client stack polls to slow itself down when it is
// consistently missing vsync.
//
// src/user/compositor/present_feedback_route.pdx (Wave0-B10-06,
// #2298) lands the FAN-OUT half of the feedback stream: budget-one-refresh
// arbitration so a subscriber that follows N surfaces sees AT MOST ONE
// event per vsync.  It sits BELOW this file's classifier -- routing
// dispatches events, this classifier decides which class each event is.
//
// This landing is the CLASSIFIER + BACK-PRESSURE half.  For each surface
// the compositor tracks separately, one ClassifierState row records:
//   * how many presents fell in each timing band (ON_TIME / LATE / DROPPED),
//   * the last classification's monotonic sequence number, and
//   * a single-bit back_pressure_active latch that goes hot once the client
//     has consistently missed vblank.
// Client stacks poll classifier_back_pressure_signal(row_id) on their own
// cadence; when it returns 1, the client throttles its own render loop
// (skip a frame, drop LOD, reduce workgroup fan-out -- the client's
// policy, not ours).  The back-pressure latch is monotonic-add-only until
// classifier_reset clears it, so a client that briefly recovers does not
// see the signal flap on and off; the compositor calls classifier_reset
// on quiescence (window minimised, workspace switched away, surface
// unmapped) to reset the classifier for the next active period.
//
// =============================================================================
// SECTION 0  RELATIONSHIP TO SIBLINGS
// =============================================================================
//
//   src/user/compositor/present_feedback_kind.pdx  (Wave0-B9-07,
//                                                    KIND_PRESENT_FEEDBACK
//                                                    = 0x1DA)
//     Owns the per-surface feedback row + PresentClassification enum values
//     (0..3).  This classifier RECEIVES the (present_nsec, target_vblank_
//     nsec) inputs, computes which enum value applies, and the compositor
//     then stamps that value into the KIND_PRESENT_FEEDBACK row via
//     present_feedback_record_present.  The two files agree on the enum
//     values via numeric equality (PRESENT_ON_TIME=0, PRESENT_LATE=1,
//     PRESENT_DROPPED=2, PRESENT_VBLANK=3); no cross-file import at this
//     landing (paideia-as user-space is per-file at present).
//
//   src/user/compositor/present_feedback_route.pdx  (Wave0-B10-06,
//                                                     #2298)
//     Owns budget-one-refresh fan-out.  Orthogonal to this classifier --
//     routing decides HOW MANY events a subscriber gets per vsync, this
//     classifier decides WHICH CLASS each event is.  A client that
//     receives a budget-suppressed event pair has no observability gap
//     because the classifier state is per-SURFACE, not per-event.
//
//   design/compositor/pwp-spec-vocabulary.md §2.12
//     "the compositor budget is one refresh period; the classifier labels
//     events as ON-TIME / LATE / MISSED / SKIPPED against that budget."
//     The threshold policy this file lands is the concrete realisation of
//     "against that budget" -- 1ms slop on the ON-TIME side, 5ms on the
//     LATE side, 33ms (2 frames at 60Hz) as the hard-drop marker.
//
//   design/roadmap/next-wave-synthesis.md §4 pitfall P6
//     "presentation feedback is mandatory, not optional".  A stream with
//     no back-pressure signal is worse than no stream -- the client stack
//     has no correction handle when the compositor is choking.  This file
//     lands the client-visible back-pressure bit that the pitfall
//     mandates.
//
// =============================================================================
// SECTION 1  API
// =============================================================================
//
// classifier_classify(present_nsec, target_vblank_nsec) -> PresentClassification
//
//   PURE FUNCTION.  Given the actual present timestamp and the target
//   vblank timestamp (both monotonic ns from the compositor's clock),
//   returns one of:
//     0  PRESENT_ON_TIME  present arrived at or within
//                         PFC_ON_TIME_MARGIN_NSEC (1ms) after the target
//                         vblank (early arrivals also ON_TIME).
//     1  PRESENT_LATE     present arrived >1ms but <=5ms after the target
//                         vblank (past the ON_TIME slop but still within
//                         the LATE grace band).
//     2  PRESENT_DROPPED  present arrived >5ms after the target vblank
//                         (past the LATE grace band -- treated as a dropped
//                         frame from the classifier's POV even if the
//                         compositor still displayed it eventually).
//   PRESENT_VBLANK (3) is NEVER returned by this function; that enum
//   value names the "vblank with no present pending" case, which is
//   observed by the compositor's vblank tick handler, not by a present
//   classification.  A future landing that adds classifier_classify_vblank
//   returns 3 in that case; this landing keeps the surface trichotomous.
//
// classifier_ingest(row_id, classification) -> 0 | PFC_BAD_SLOT | PFC_BAD_CLASS
//
//   Bumps the row's counter for the given classification (on_time_count /
//   late_count / dropped_count depending on class 0/1/2) and refreshes
//   last_classification_seq.  On classes 1 (LATE) or 2 (DROPPED), also
//   re-evaluates the back-pressure gate: if (late_count + dropped_count)
//   >= PFC_BP_THRESHOLD, back_pressure_active is latched to 1.  Once
//   latched, back_pressure_active stays 1 until classifier_reset clears
//   it (see back-pressure semantics below).
//
//   Class 3 (PRESENT_VBLANK) is REFUSED with PFC_BAD_CLASS -- this file's
//   ingest surface accepts only the ON_TIME/LATE/DROPPED trichotomy that
//   classify() produces.  A vblank-with-no-present event is a distinct
//   signal the caller records elsewhere (present_feedback_record_vblank
//   in the sibling module).
//
// classifier_back_pressure_signal(row_id) -> u8
//
//   Returns 1 iff back_pressure_active is set on the row.  Returns 0 iff
//   the row is not in_use OR back_pressure_active == 0.  This is the
//   client-facing polling surface -- clients call it on their own render
//   cadence, cheap (one row bounds check + one u64 load + shift + mask).
//   No stats bump on this call: it is designed to be poll-loop hot.
//
// classifier_reset(row_id) -> 0 | PFC_BAD_SLOT
//
//   Clears on_time_count, late_count, dropped_count, back_pressure_active
//   to 0 on the row.  PRESERVES surface_kind_id and last_classification_
//   seq (the sequence number is a monotonic identifier the caller uses to
//   correlate observations across reset boundaries -- resetting it would
//   break that identity).  Called on quiescence (window minimised,
//   workspace switched away, surface unmapped) so the next active period
//   starts with a clean counter frame.
//
// classifier_mint(surface_kind_id) -> row_id | PFC_MINT_BAD_SURFACE |
//                                     PFC_MINT_DUP | PFC_TAIL_ENOSPC
//
//   Allocates one ClassifierState row for a surface.  surface_kind_id
//   MUST be nonzero + fit in u32; MUST NOT collide with an in_use row's
//   surface_kind_id (uniqueness gate mirrors present_feedback_kind.pdx's
//   own uniqueness: one classifier per surface, not multiple).
//
// classifier_revoke(row_id) -> 0 | PFC_BAD_SLOT | PFC_REVOKE_ALREADY
//
//   Consumes the row.  Distinguishes out-of-range from double-revoke so
//   observability tooling can tell the two apart.
//
// classifier_stats(row_id, out_ptr) -> 0 | PFC_BAD_SLOT | PFC_STATS_BAD_PTR
//
//   Writes 32 bytes at *out_ptr (four u64 fields, little-endian):
//     [+0]  on_time_count (zero-extended u32 -> u64)
//     [+8]  late_count    (zero-extended u32 -> u64)
//     [+16] dropped_count (zero-extended u32 -> u64)
//     [+24] back_pressure_active (zero-extended u8 -> u64)
//   Bumps _pfc_stats[PFC_ST_QUERIES] once per call.  Individual field
//   accessors below are the preferred surface for callers that only want
//   one field; this bundled query exists for observability tooling that
//   wants all four in one atomic read.
//
// classifier_row_on_time_count / _late_count / _dropped_count / _surface
//   Direct row-field accessors.  Bad row -> 0xFFFFFFFFFFFFFFFF sentinel
//   (same convention as sibling row accessors).
//
// classifier_stats_mints / _revokes / _ingests / _resets / _queries /
// _refused / _bp_activations -> u64
//   Aggregate counter accessors.  Read by boot diagnostics + regression
//   tests + the compositor debug overlay.
//
// classifier_stats_reset() -> ()
//   Zero the aggregate counter block (test / init).
//
// classifier_init() -> ()
//   Boot init: scrub row pool + aggregate counters.
//
// =============================================================================
// SECTION 2  FAILURE TAXONOMY  0xFFFFEAD0..0xFFFFEADF
//                              (BRIEF: 0xFFFFED90..0xFFFFED9F, COLLIDED)
// =============================================================================
//
// Dispatch brief (Wave-0 B11-04) allocated 0xFFFFED90..0xFFFFED9F, but
// repo-wide grep at landing time shows that band TRIPLE-CLAIMED by three
// disjoint prior claimants:
//   0xFFFFED90..9F  GCV_*  (src/kernel/core/drivers/color/gpu_convert.pdx
//                            §1: GCV_BAD_ORD/BAD_MATRIX/BAD_SLOT).
//   0xFFFFED90..9F  VSE_*  (src/kernel/core/drivers/vello/
//                            vello_scene_encoder.pdx §2: VSE_ERR_BAD_
//                            SCENE/BAD_BYTES/BAD_PATHS/BUSY/NO_ROOM/
//                            NOT_STARTED/UPLOAD_FAIL/BAD_OP).
//   0xFFFFED90..9F  HLG    (src/user/color/hlg_transform.pdx §2).
// A fourth claim from this file would alias into values every one of
// those callers cross-checks against.  Escalated by the same rule
// present_feedback_route.pdx (§2 header) applied to the brief's own EC60
// collision: pick the nearest completely-free 16-code band that a repo-
// wide grep verifies is unused.  Grep pass across 0xFFFFED0x..0xFFFFED8x
// (every one occupied) and 0xFFFFEAxx (the compositor's own page) shows
// 0xFFFFEAD0..0xFFFFEADF FREE.  Claimed here.  Sits in the same 0xFFFFEA__
// page as the adjacent compositor bands (present_feedback_route
// 0xFFFFEAB0..BF, window_kind 0xFFFFEAA0..AF, xdg_shell_geometry
// 0xFFFFEA70..7F, subsurface_sync 0xFFFFEA20..2F), so grep sets that
// walk the compositor's failure pages remain contiguous.  A follow-on
// issue on the M4 punchlist tracks the brief's ED90 collision: the
// dispatch brief's failure-band register needs the same grep pass this
// landing did (see present_feedback_route.pdx §2 for the prior instance
// of the same pathology at EC60).
//
// Codes (high-first, mirroring sibling KIND_*/logic modules):
//   PFC_TAIL_ENOSPC       = 0xFFFFEADF   row pool full.
//   PFC_TAIL_BAD_ARG      = 0xFFFFEADE   packer bad-arg sentinel.
//   PFC_MINT_BAD_SURFACE  = 0xFFFFEADD   surface_kind_id == 0 or > u32.
//   PFC_MINT_DUP          = 0xFFFFEADC   surface_kind_id collides with
//                                         an in_use row.
//   PFC_BAD_SLOT          = 0xFFFFEADB   row_id >= PFC_MAX or not in_use.
//   PFC_BAD_CLASS         = 0xFFFFEADA   classification value not in
//                                         {ON_TIME, LATE, DROPPED} (3
//                                         VBLANK is refused -- see §1
//                                         ingest for rationale).
//   PFC_REVOKE_ALREADY    = 0xFFFFEAD9   revoke on already-free row.
//   PFC_STATS_BAD_PTR     = 0xFFFFEAD8   classifier_stats received a
//                                         0/0xFFFF..FF out_ptr.
//   PFC_INGEST_OVERFLOW   = 0xFFFFEAD7   counter would exceed u32 max
//                                         (defence-in-depth belt; 4G
//                                         ingests per surface is not
//                                         observably reachable).
//   0xFFFFEAD0..0xFFFFEAD6 open for follow-on rollback / retry codes.
//
// =============================================================================
// SECTION 3  ROW LAYOUT -- 32 BYTES (FOUR u64 WORDS)
// =============================================================================
//
//   [+0]   header: in_use[63:56] | reserved[55:40] |
//                  back_pressure_active[39:32] | surface_kind_id[31:0]
//   [+8]   counts:  on_time_count[31:0] | late_count[63:32]
//   [+16]  drops:   dropped_count[31:0] | reserved[63:32]
//   [+24]  last_classification_seq (u64, monotonic increment per ingest)
//
// surface_kind_id is caller-supplied at mint and MUST be nonzero + unique
// across in_use rows.  Zero refused (PFC_MINT_BAD_SURFACE); duplicate
// refused (PFC_MINT_DUP).  One classifier row per surface -- if a
// caller wants two classification windows on one surface, that is a
// caller-side fan-out on top of this row's single-window state.
//
// back_pressure_active is a u8 latch in header[39:32].  0 at mint;
// classifier_ingest sets it to 1 when the (late_count + dropped_count)
// crosses PFC_BP_THRESHOLD; classifier_reset clears it back to 0.
// Stored in the header word so classifier_back_pressure_signal is a
// single-word load + shift + mask, no body access -- the read is the
// hot path (client polls it on the render loop) so the row layout
// optimises for it.
//
// on_time_count, late_count, dropped_count are u32 counters split
// across two u64 words for packing efficiency (header + counts + drops =
// 3 u64 = 24 bytes; the fourth u64 carries last_classification_seq).
// Each counter refuses u32 overflow at ingest (PFC_INGEST_OVERFLOW);
// classifier_reset clears them.
//
// last_classification_seq is a monotonic u64 counter that bumps on every
// ingest (regardless of class).  Callers use it to correlate observations
// across ingest events without having to track their own sequence
// separately.  PRESERVED across classifier_reset (reset clears the
// counters and back-pressure latch but not the seq -- resetting the seq
// would break cross-reset correlation).
//
// All slots stored little-endian.  No float leaks into a timing/count
// cell per FPU-discipline (design/kernel/no-fpu.md) -- present_nsec /
// vblank_nsec are integer ns, counters are unsigned integers.
//
// =============================================================================
// SECTION 4  CLASSIFICATION LOGIC
// =============================================================================
//
// classifier_classify's threshold decision tree, given present_nsec (P)
// and target_vblank_nsec (T):
//
//   if P <= T + PFC_ON_TIME_MARGIN_NSEC (1ms slop):   return PRESENT_ON_TIME
//   else if P <= T + PFC_LATE_MARGIN_NSEC (5ms):      return PRESENT_LATE
//   else:                                             return PRESENT_DROPPED
//
// Early arrivals (P < T) fall into the ON_TIME branch trivially -- the
// comparison P <= T + slop is satisfied for any P <= T.  The margin
// values encode the compositor's real budget: 1ms below the ideal
// deadline is "on-schedule", 1-5ms after is "late but recoverable"
// (client can still redraw for the next vsync), >5ms is "dropped" from
// the classifier's POV (client should assume its frame was skipped).
//
// The PFC_DROPPED_MARGIN_NSEC (33ms = 2 frames at 60Hz) constant is
// exposed for callers that want to distinguish a single missed frame
// from a bulk timeline stall (P > T + 33ms means the classifier is at
// least 2 frames behind).  Not used in the classification itself --
// classify's return set is trichotomous (ON_TIME/LATE/DROPPED) and any
// overshoot past LATE_MARGIN is treated as DROPPED.  A future landing
// that adds a "hard-drop" enum variant can consume DROPPED_MARGIN to
// widen the return set.
//
// Overflow considerations: T + margin can theoretically overflow u64,
// but the compositor's monotonic-ns clock in any reachable boot window
// stays well below 2^64 - 33e6 (a 584-year uptime at ns precision).
// The comparison uses unsigned semantics; a caller who deliberately
// feeds T = 0xFFFFFFFFFFFFFFFE (near the u64 top) as a probe input
// observes wrap and gets a nonsensical classification -- the caller's
// responsibility, not the classifier's, since no reachable clock
// produces that value.
//
// =============================================================================
// SECTION 5  BACK-PRESSURE SIGNAL
// =============================================================================
//
// The back-pressure latch has three properties the design targets:
//
//  (a) MONOTONIC-ADD-ONLY between resets.  Once (late_count + dropped_
//      count) crosses PFC_BP_THRESHOLD, back_pressure_active stays 1
//      until classifier_reset explicitly clears it.  Rationale: a
//      client that briefly recovers (one ON_TIME event after a run of
//      LATE events) should not observe the signal flap on and off --
//      transient recovery is not evidence that the pressure has
//      passed, and a flapping signal would drive the client's
//      throttling policy into oscillation.
//
//  (b) CLEARABLE ON QUIESCENCE.  The compositor calls classifier_reset
//      when the surface becomes inactive (window minimised, workspace
//      switched away, surface unmapped).  This restores back_pressure_
//      active to 0 so the next active period starts clean.  Without
//      this, a surface that once experienced back-pressure would stay
//      back-pressured for the life of the classifier row, even across
//      full quiescence + reactivation cycles.
//
//  (c) SINGLE-BIT READ.  classifier_back_pressure_signal returns u8 (0
//      or 1) so the client's polling code is a single register-width
//      comparison against zero.  No stats bump on read -- the read
//      is designed to be poll-loop hot, and a counter bump per read
//      would defeat the point.
//
// PFC_BP_THRESHOLD = 4 (four combined LATE + DROPPED events within one
// reset window).  Chosen so a client that has four missed vsyncs in a
// row without a reset in between clearly deserves back-pressure; a
// client whose miss rate is <4 events per reset window is treated as
// recoverable.  The compositor calls classifier_reset at least once per
// window (per §5 (b)) so the window boundary is compositor-controlled,
// not fixed to a wall-clock interval.
//
// =============================================================================
// SECTION 6  DISCIPLINE
// =============================================================================
//
// * Encoder rules: leaf primitives use r10/r11 scratch only; multi-arg
//   helpers push callee-save (rbx/r12/r13/r14) with `sub rsp, 8` as
//   needed to bring rsp%16 to 0 for every nested call.  Every counter
//   bump is load-inc-store (`mov rax, [mem]; add rax, 1; mov [mem], rax`),
//   never `add [mem], reg` -- the encoder-safe idiom per the paideia-as
//   Group-4 instruction discipline.
// * Labels: all `present_feedback_classifier_<funcname>_<tag>` per the
//   reserved-label note (`loop`, `if` etc. are paideia-as keywords;
//   every label is prefixed by the function's short tag so no bare-
//   keyword collision is possible).  Short per-function tags (e.g.
//   `_c_`, `_in_`, `_bp_`) keep the label width in line with the
//   sibling present_feedback_kind.pdx module.
// * No float: every arg / return / row cell is u64.  Follows
//   design/kernel/no-fpu.md.
// * Fingerprint: data-only tag (pdx_kind_present_feedback_classifier_
//   meta) with the `[legacy: PRESENT FEEDBACK CLASSIFIER OK]` suffix for
//   grep parity with pdx_kind_present_feedback_meta and pdx_kind_present
//   _feedback_route_meta.  Emission body lands with the downstream
//   compositor dispatcher; the tag decl here reserves the canonical
//   string and is not yet emitted by any code path, so no golden line
//   is required at this landing.

module PresentFeedbackClassifier = structure {

  // ==========================================================================
  // SECTION A  Constants + failure taxonomy + counter identity + fingerprint.
  // ==========================================================================

  pub let PFC_OK                     : u64 = 0

  // Timing thresholds (ns).  See §4 for the classification decision tree
  // and §5 for the back-pressure gate.
  pub let PFC_ON_TIME_MARGIN_NSEC    : u64 = 1000000       // 1 ms
  pub let PFC_LATE_MARGIN_NSEC       : u64 = 5000000       // 5 ms
  pub let PFC_DROPPED_MARGIN_NSEC    : u64 = 33333333      // 33 ms (2 frames @ 60Hz)

  // Back-pressure gate.  See §5.
  pub let PFC_BP_THRESHOLD           : u64 = 4

  // PresentClassification enum values (numeric parity with the sibling
  // present_feedback_kind.pdx: PRESENT_ON_TIME=0, LATE=1, DROPPED=2,
  // VBLANK=3).  Duplicated here so the classifier can be reasoned about
  // as a self-contained module.
  pub let PFC_CLASS_ON_TIME          : u64 = 0
  pub let PFC_CLASS_LATE             : u64 = 1
  pub let PFC_CLASS_DROPPED          : u64 = 2
  pub let PFC_CLASS_VBLANK           : u64 = 3
  pub let PFC_CLASS_INGEST_MAX       : u64 = 2   // ingest accepts 0..2 only

  // Failure taxonomy 0xFFFFEAD0..0xFFFFEADF (see file header §2 for the
  // brief-time ED90 triple-collision and this band's rationale).
  pub let PFC_TAIL_ENOSPC            : u64 = 0xFFFFEADF
  pub let PFC_TAIL_BAD_ARG           : u64 = 0xFFFFEADE
  pub let PFC_MINT_BAD_SURFACE       : u64 = 0xFFFFEADD
  pub let PFC_MINT_DUP               : u64 = 0xFFFFEADC
  pub let PFC_BAD_SLOT               : u64 = 0xFFFFEADB
  pub let PFC_BAD_CLASS              : u64 = 0xFFFFEADA
  pub let PFC_REVOKE_ALREADY         : u64 = 0xFFFFEAD9
  pub let PFC_STATS_BAD_PTR          : u64 = 0xFFFFEAD8
  pub let PFC_INGEST_OVERFLOW        : u64 = 0xFFFFEAD7
  pub let PFC_ROW_NONE               : u64 = 0xFFFFEAD6   // find-by-surface miss

  // Ceilings.
  pub let PFC_MAX                    : u64 = 16
  pub let PFC_ROW_BYTES              : u64 = 32
  pub let PFC_U32_MAX                : u64 = 0xFFFFFFFF

  // Counter slot ordinals for the _pfc_stats array (seven live slots +
  // one reserved for future counters -- the extra cell rounds the array
  // to a full cache line for locality).
  pub let PFC_ST_MINTS               : u64 = 0
  pub let PFC_ST_REVOKES             : u64 = 1
  pub let PFC_ST_INGESTS             : u64 = 2
  pub let PFC_ST_RESETS              : u64 = 3
  pub let PFC_ST_QUERIES             : u64 = 4
  pub let PFC_ST_REFUSED             : u64 = 5
  pub let PFC_ST_BP_ACTIVATIONS      : u64 = 6
  pub let PFC_ST_MAX                 : u64 = 8

  // THE ONE STATE CELL.  16 rows * 32 bytes = 512 bytes = 64 u64.
  pub let mut _pfc_table : [u64; 64] = uninit @align(64)
  pub let mut _pfc_stats : [u64; 8]  = uninit @align(64)

  // Fingerprint tag.  Suffix `[legacy: PRESENT FEEDBACK CLASSIFIER OK]`
  // matches the pattern pdx_kind_present_feedback_meta uses so grep
  // tooling that scans for "^pdx_kind_.*_meta" finds all sibling tags
  // as a set.  Data-only at this landing; emission wiring lands when
  // the compositor dispatcher grows a klog_s1_x1 call at the tail of
  // every successful classifier_mint.  No golden line required.
  //
  // "pdx present feedback classifier meta [legacy: PRESENT FEEDBACK CLASSIFIER OK]\0"
  //   =  37 bytes prefix + 40 bytes bracketed suffix + 1 NUL = 78 bytes.
  pub let pdx_kind_present_feedback_classifier_meta : [u8; 78] = "pdx present feedback classifier meta [legacy: PRESENT FEEDBACK CLASSIFIER OK]\0"

  // ==========================================================================
  // SECTION B  Counter primitives.
  //
  // Seven inlined stats accessors are direct memory reads at fixed
  // offsets.  The bounds-checked bump primitive is exposed so the
  // internal helpers can name a slot ordinal by constant (0..6) rather
  // than hand-inline the load-add-store idiom seven times.
  // ==========================================================================

  pub let present_feedback_classifier_stats_bump : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-04 (paideia-os #2299): bounds-checked counter bump (which < 8). Load-inc-store idiom (no `add reg, [mem]`) per encoder discipline. Labels prefixed present_feedback_classifier_sb_.",
      block: {
        cmp rdi, 8;
        jae present_feedback_classifier_sb_out;
        lea r10, [rip + _pfc_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      present_feedback_classifier_sb_out:
        ret
      }
    }

  pub let present_feedback_classifier_stats_mints : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-04 (paideia-os #2299): direct read of _pfc_stats[PFC_ST_MINTS=0]. Labels prefixed present_feedback_classifier_sm_.",
      block: {
        lea r10, [rip + _pfc_stats];
        mov rax, [r10 + 0];
        ret
      }
    }

  pub let present_feedback_classifier_stats_revokes : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-04 (paideia-os #2299): direct read of _pfc_stats[PFC_ST_REVOKES=1] at byte offset 8. Labels prefixed present_feedback_classifier_sv_.",
      block: {
        lea r10, [rip + _pfc_stats];
        mov rax, [r10 + 8];
        ret
      }
    }

