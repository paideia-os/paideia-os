      }
    }

  pub let present_feedback_classifier_row_late_count : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-04 (paideia-os #2299): late_count at body1[63:32]. Bad row -> 0xFFFFFFFFFFFFFFFF. Labels prefixed present_feedback_classifier_rlt_.",
      block: {
        push r12;
        mov r12, rdi;
        call present_feedback_classifier_tail_valid;
        cmp rax, 0;
        je  present_feedback_classifier_rlt_bad;
        lea r10, [rip + _pfc_table];
        mov r11, r12;
        imul r11, r11, 32;
        add r10, r11;
        mov rax, [r10 + 8];
        shr rax, 32;
        jmp present_feedback_classifier_rlt_out;
      present_feedback_classifier_rlt_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      present_feedback_classifier_rlt_out:
        pop r12;
        ret
      }
    }

  pub let present_feedback_classifier_row_dropped_count : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-04 (paideia-os #2299): dropped_count at body2[31:0]. Bad row -> 0xFFFFFFFFFFFFFFFF. Labels prefixed present_feedback_classifier_rdc_.",
      block: {
        push r12;
        mov r12, rdi;
        call present_feedback_classifier_tail_valid;
        cmp rax, 0;
        je  present_feedback_classifier_rdc_bad;
        lea r10, [rip + _pfc_table];
        mov r11, r12;
        imul r11, r11, 32;
        add r10, r11;
        mov rax, [r10 + 16];
        and rax, 0xFFFFFFFF;
        jmp present_feedback_classifier_rdc_out;
      present_feedback_classifier_rdc_bad:
