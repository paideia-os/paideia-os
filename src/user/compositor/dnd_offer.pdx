  // dnd_offer_is_accepted(row_id) -> 1 iff accepted_mime_offset !=
  // DND_ACCEPT_NONE (0xFFFFFFFF). Returns 0 on invalid row (matches
  // 'not accepted' at the semantic boundary: an invalid row cannot
  // be accepted). This is the guard the recipient MUST check before
  // calling receive_data on data_kind_id.
  pub let dnd_offer_is_accepted : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B7-04 (#2267): 1 iff accepted_mime_offset != 0xFFFFFFFF. Labels prefixed dnd_offer_ia_.",
      block: {
        push r12;
        mov r12, rdi;
        call dnd_offer_tail_valid;
        cmp rax, 0;
        je  dnd_offer_ia_no;
        lea r10, [rip + _dnd_table];
        mov r11, r12;
        imul r11, r11, 56;
        add r10, r11;
        mov rax, [r10 + 40];
        and rax, 0xFFFFFFFF;
        mov r10, 0xFFFFFFFF;
        cmp rax, r10;
        je  dnd_offer_ia_no;
        mov rax, 1;
        jmp dnd_offer_ia_out;
      dnd_offer_ia_no:
        xor rax, rax;
      dnd_offer_ia_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Section 11  Mint / update / accept / reject / revoke.
  // ==========================================================================

  // dnd_offer_mint factory. Contract:
  //
  //   dnd_offer_mint(source_win, mime_types_ptr, mime_type_count,
  //                  data_kind_id, serial)
  //     -> row_id | DND_MINT_* sentinel
  //
  // Five args (all in SysV registers -- rdi/rsi/rdx/rcx/r8). Gate
  // order:
  //   (1) source_win     valid   -> DND_MINT_BAD_SRC
  //   (2) mime_type_count valid  -> DND_MINT_BAD_MIME
  //   (3) mime_types_ptr non-null-> DND_MIME_PTR_NULL
  //   (4) data_kind_id  valid    -> DND_MINT_BAD_DATA
  //   (5) serial         valid    -> DND_MINT_BAD_SERIAL
  //   (6) pack windows(source, 0)  -- target starts as 0 (no target)
  //   (7) pack payload(mime_count, data_kind_id)
  //   (8) pack pointer(0, 0)       -- pointer starts at origin
  //   (9) pack accept(DND_ACCEPT_NONE, serial)  -- not yet accepted
  //  (10) tail_alloc(...) -> row_id | DND_TAIL_ENOSPC
  //
  // Refusal funnel bumps _dnd_stats[DND_ST_REFUSED] once at the
  // dnd_offer_mb_refused label; success bumps _dnd_stats[DND_ST_MINTS].
  pub let dnd_offer_mint : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (source_win: u64) (mime_types_ptr: u64) (mime_type_count: u64) (data_kind_id: u64) (serial: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B7-04 (#2267): mint one KIND_DND_OFFER row (sealed). Five callee-save pushes + one sub rsp,8 = 48 bytes: entry rsp%16==8, +40+8=48, %16==0 for every nested call. All five args are stashed BEFORE any nested call clobbers a caller-save reg: rbx=source_win, r12=mime_types_ptr, r13=mime_type_count, r14=data_kind_id, r15=serial. Every validator + packer helper is a leaf using only r10/r11 scratch beyond the SysV in/out contract, so no additional push/pop scaffolding is needed around them. Target starts as 0 (no drop target yet). Pointer starts as (0,0). Accept starts as DND_ACCEPT_NONE. Refusal funnel bumps DND_ST_REFUSED once at dnd_offer_mb_refused. Labels prefixed dnd_offer_mb_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;

        mov rbx, rdi;                     // source_win
        mov r12, rsi;                     // mime_types_ptr
        mov r13, rdx;                     // mime_type_count
        mov r14, rcx;                     // data_kind_id
        mov r15, r8;                      // serial

        // (1) source_win non-zero + u32-bounded
        mov rdi, rbx;
        call dnd_offer_source_valid;
        cmp rax, 0;
        je  dnd_offer_mb_bad_src;

        // (2) mime_type_count in (0, DND_MIME_MAX]
        mov rdi, r13;
        call dnd_offer_mime_count_valid;
        cmp rax, 0;
        je  dnd_offer_mb_bad_mime;

        // (3) mime_types_ptr non-null
        mov rdi, r12;
        call dnd_offer_mime_ptr_valid;
        cmp rax, 0;
        je  dnd_offer_mb_ptr_null;

        // (4) data_kind_id in (0, 2^32)
        mov rdi, r14;
        call dnd_offer_data_kind_valid;
        cmp rax, 0;
        je  dnd_offer_mb_bad_data;

        // (5) serial in (0, 2^32)
        mov rdi, r15;
        call dnd_offer_serial_valid;
        cmp rax, 0;
        je  dnd_offer_mb_bad_serial;

        // (6) Pack windows = (source_win, 0). Target starts unset.
        mov rdi, rbx;
        xor rsi, rsi;
        call dnd_offer_windows_pack;
        mov rbx, rax;                     // windows (source_win no longer needed)

        // (7) Pack payload = (mime_type_count, data_kind_id).
        mov rdi, r13;
        mov rsi, r14;
        call dnd_offer_payload_pack;
        mov r13, rax;                     // payload

        // (8) Pack pointer = (0, 0). Origin.
        xor rdi, rdi;
        xor rsi, rsi;
        call dnd_offer_pointer_pack;
        mov r14, rax;                     // pointer

        // (9) Pack accept = (DND_ACCEPT_NONE, serial). Not accepted.
        mov rdi, 0xFFFFFFFF;              // DND_ACCEPT_NONE
        mov rsi, r15;
        call dnd_offer_accept_pack;
        mov r15, rax;                     // accept

        // (10) tail_alloc(windows, payload, mime_ptr, pointer, accept).
        mov rdi, rbx;                     // windows
        mov rsi, r13;                     // payload
        mov rdx, r12;                     // mime_types_ptr
        mov rcx, r14;                     // pointer
        mov r8,  r15;                     // accept
        call dnd_offer_tail_alloc;

        mov r10, 4;
        cmp rax, r10;
        jae dnd_offer_mb_enospc;          // rax already the sentinel

        // Success: stash row_id in a callee-save across the note
        // call (dnd_offer_note clobbers rax as scratch), then
        // return it.
        mov rbx, rax;
        mov rdi, 0;                       // DND_ST_MINTS
        call dnd_offer_note;
        mov rax, rbx;
        jmp dnd_offer_mb_out;

      dnd_offer_mb_bad_src:
        mov rax, 0xFFFFEA2B;              // DND_MINT_BAD_SRC
        jmp dnd_offer_mb_refused;
      dnd_offer_mb_bad_mime:
        mov rax, 0xFFFFEA2A;              // DND_MINT_BAD_MIME
        jmp dnd_offer_mb_refused;
      dnd_offer_mb_ptr_null:
        mov rax, 0xFFFFEA23;              // DND_MIME_PTR_NULL
        jmp dnd_offer_mb_refused;
      dnd_offer_mb_bad_data:
        mov rax, 0xFFFFEA29;              // DND_MINT_BAD_DATA
        jmp dnd_offer_mb_refused;
      dnd_offer_mb_bad_serial:
        mov rax, 0xFFFFEA28;              // DND_MINT_BAD_SERIAL
        jmp dnd_offer_mb_refused;
      dnd_offer_mb_enospc:
        // rax already DND_TAIL_ENOSPC (0xFFFFEA2F) from tail_alloc.

      dnd_offer_mb_refused:
        mov rbx, rax;                     // stash sentinel
        mov rdi, 2;                       // DND_ST_REFUSED
        call dnd_offer_note;
        mov rax, rbx;

      dnd_offer_mb_out:
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // dnd_offer_update_target(row_id, target_win, pointer_x, pointer_y)
  //   -> 0 | DND_* sentinel
  // Compositor-only call, invoked on pointer motion. Mutates the
  // target_win field in the windows word AND the pointer word. Does
  // NOT touch payload / mime / accept / serial / rev_seq -- those
  // are stable across the drag session.
  pub let dnd_offer_update_target : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64) (target_win: u64) (pointer_x: u64) (pointer_y: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B7-04 (#2267): compositor-only update of target + pointer on pointer motion. Row-id / target validation first; then load-mask-store the target half of the windows word and overwrite the pointer word wholesale. Four callee-save pushes (rbx=row_id, r12=target_win, r13=pointer_x, r14=pointer_y) plus one sub rsp,8: entry rsp%16==8, +32+8=40, %16==8 -- INSUFFICIENT. Adjust to five pushes: add push rbp (unused, just for alignment) OR use +16 sub. Chosen: sub rsp, 16 instead of 8 -- +32+16=48, %16==0. Labels prefixed dnd_offer_ut_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        sub rsp, 16;

        mov rbx, rdi;                     // row_id
        mov r12, rsi;                     // target_win
        mov r13, rdx;                     // pointer_x
        mov r14, rcx;                     // pointer_y

        // Validate row_id
        mov r10, 4;
        cmp rbx, r10;
        jae dnd_offer_ut_bad_slot;

        mov rdi, rbx;
        call dnd_offer_tail_valid;
        cmp rax, 0;
        je  dnd_offer_ut_invalidated;

        // Validate target_win (0 permitted)
        mov rdi, r12;
        call dnd_offer_target_valid;
        cmp rax, 0;
        je  dnd_offer_ut_bad_target;

        // Validate coords (either sign-ext-i32 or zero-ext-i32 form)
        mov rdi, r13;
        call dnd_offer_coord_valid;
        cmp rax, 0;
        je  dnd_offer_ut_bad_target;

        mov rdi, r14;
        call dnd_offer_coord_valid;
        cmp rax, 0;
        je  dnd_offer_ut_bad_target;

        // Compute row base into r11 (kept across the field mutations).
        lea r10, [rip + _dnd_table];
        mov r11, rbx;
        imul r11, r11, 56;
        add r11, r10;

        // Update windows word: preserve low 32 (source), overwrite
        // high 32 (target). load; mask low; or in target<<32; store.
        mov rax, [r11 + 8];
        mov r10, 0xFFFFFFFF;
        and rax, r10;                     // rax = source_win (low)
        mov r10, r12;
        and r10, 0xFFFFFFFF;
        shl r10, 32;
        or  rax, r10;                     // rax = source | (target<<32)
        mov [r11 + 8], rax;

        // Update pointer word wholesale via packer (drops high bits
        // of each coord input, which is what we want for i32).
        mov rdi, r13;
        mov rsi, r14;
        call dnd_offer_pointer_pack;
        mov [r11 + 32], rax;

        // Success: bump updates counter, return 0.
        mov rdi, 4;                       // DND_ST_UPDATES
        call dnd_offer_note;
        xor rax, rax;
        jmp dnd_offer_ut_out;

      dnd_offer_ut_bad_slot:
        mov rax, 0xFFFFEA27;              // DND_BAD_SLOT
        jmp dnd_offer_ut_out;
      dnd_offer_ut_invalidated:
        mov rax, 0xFFFFEA22;              // DND_INVALIDATED
        jmp dnd_offer_ut_out;
      dnd_offer_ut_bad_target:
        mov rax, 0xFFFFEA20;              // DND_BAD_TARGET

      dnd_offer_ut_out:
        add rsp, 16;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // dnd_offer_accept(row_id, mime_offset) -> 0 | DND_* sentinel.
  // Target-side call. Records the accepted MIME index in the
  // accept-word low half; preserves the serial in the high half.
  // mime_offset must be < mime_type_count (validated).
  pub let dnd_offer_accept : (u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64) (mime_offset: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B7-04 (#2267): target-side accept boundary. Validate row + mime_offset < mime_type_count; then load-mask-store the low 32 of the accept word (serial in high 32 preserved). Three callee-save pushes (rbx=row_id, r12=mime_offset, r13=row_base) plus one sub rsp,8 = 32 bytes; entry rsp%16==8, +24+8=32, %16==0. Labels prefixed dnd_offer_ac_.",
      block: {
        push rbx;
        push r12;
        push r13;
        sub rsp, 8;

        mov rbx, rdi;                     // row_id
        mov r12, rsi;                     // mime_offset

        // Validate row_id
        mov r10, 4;
        cmp rbx, r10;
        jae dnd_offer_ac_bad_slot;

        mov rdi, rbx;
        call dnd_offer_tail_valid;
        cmp rax, 0;
        je  dnd_offer_ac_invalidated;

        // mime_offset must fit in u32
        mov r10, 0xFFFFFFFF;
        cmp r12, r10;
        ja  dnd_offer_ac_bad_offset;

        // Fetch mime_type_count from payload[+16].low32
        lea r10, [rip + _dnd_table];
        mov r11, rbx;
        imul r11, r11, 56;
        add r11, r10;
        mov r13, r11;                     // keep row base

        mov rax, [r13 + 16];
        and rax, 0xFFFFFFFF;              // rax = mime_type_count
        cmp r12, rax;
        jae dnd_offer_ac_bad_offset;

        // Load accept word, replace low 32 with mime_offset,
        // preserve high 32 (serial).
        mov rax, [r13 + 40];
        mov r10, 0xFFFFFFFF;
        shl r10, 32;                      // r10 = 0xFFFFFFFF00000000
        and rax, r10;                     // rax = serial<<32
        mov r10, r12;
        and r10, 0xFFFFFFFF;
        or  rax, r10;                     // rax = serial | mime_offset
        mov [r13 + 40], rax;

        // Success: bump accepts counter, return 0.
        mov rdi, 5;                       // DND_ST_ACCEPTS
        call dnd_offer_note;
        xor rax, rax;
        jmp dnd_offer_ac_out;

      dnd_offer_ac_bad_slot:
        mov rax, 0xFFFFEA27;              // DND_BAD_SLOT
        jmp dnd_offer_ac_out;
      dnd_offer_ac_invalidated:
        mov rax, 0xFFFFEA22;              // DND_INVALIDATED
        jmp dnd_offer_ac_out;
      dnd_offer_ac_bad_offset:
        mov rax, 0xFFFFEA21;              // DND_BAD_MIME_OFFSET

      dnd_offer_ac_out:
        add rsp, 8;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // dnd_offer_reject(row_id) -> 0 | DND_* sentinel.
  // Target-side call. Stamps DND_ACCEPT_NONE in the accept-word low
  // half AND bumps revocation_seq (so a subsequent receive_data race
  // on a stale cap sees invalidation). Keeps the serial in the
  // accept-word high half for post-mortem inspection.
  pub let dnd_offer_reject : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B7-04 (#2267): target-side reject. Stamp DND_ACCEPT_NONE in accept.low32 (serial preserved), bump revocation_seq (encoder-conservative load-inc-store), bump rejects counter, return 0. Two callee-save pushes (rbx=row_id, r12=row_base) fine on alignment: entry rsp%16==8, +16+0=16, %16==8 -- INSUFFICIENT for the nested call. Add sub rsp,8: +16+8=24, %16==8 -- still insufficient. Use three pushes with sub rsp,8: three*8=24 + 8 = 32, %16==0. Third push is rbp (spare). Labels prefixed dnd_offer_rj_.",
      block: {
        push rbx;
        push r12;
        push rbp;
        sub rsp, 8;

        mov rbx, rdi;                     // row_id

        // Validate row_id
        mov r10, 4;
        cmp rbx, r10;
        jae dnd_offer_rj_bad_slot;

        mov rdi, rbx;
        call dnd_offer_tail_valid;
        cmp rax, 0;
        je  dnd_offer_rj_invalidated;

        lea r10, [rip + _dnd_table];
        mov r11, rbx;
        imul r11, r11, 56;
        add r11, r10;
        mov r12, r11;                     // row base

        // Load accept, keep high 32 (serial), stamp low 32 with
        // DND_ACCEPT_NONE (0xFFFFFFFF). Result: serial<<32 |
        // 0xFFFFFFFF.
        mov rax, [r12 + 40];
        mov r10, 0xFFFFFFFF;
        shl r10, 32;
        and rax, r10;
        mov r10, 0xFFFFFFFF;
        or  rax, r10;
        mov [r12 + 40], rax;

        // Bump revocation_seq at row+48. Load-inc-store (no add
        // reg,[mem]).
        mov rax, [r12 + 48];
        add rax, 1;
        mov [r12 + 48], rax;

        mov rdi, 6;                       // DND_ST_REJECTS
        call dnd_offer_note;
        xor rax, rax;
        jmp dnd_offer_rj_out;

      dnd_offer_rj_bad_slot:
        mov rax, 0xFFFFEA27;              // DND_BAD_SLOT
        jmp dnd_offer_rj_out;
      dnd_offer_rj_invalidated:
        mov rax, 0xFFFFEA22;              // DND_INVALIDATED

      dnd_offer_rj_out:
        add rsp, 8;
        pop rbp;
        pop r12;
        pop rbx;
        ret
      }
    }

  // dnd_offer_revoke bumps revocation_seq so the recipient's next
  // access sees invalidation on the next dnd_offer_row_rev_seq read.
  // Row is NOT freed here -- the recipient may still be reading
  // through its query rights; freeing races the read. Freeing is a
  // separate GC pass (dnd_offer_tail_free) driven by refcount going
  // to zero, which is out of scope here (G7-M5-003).
  //
  // Contract:
  //   dnd_offer_revoke(row_id) -> 0 | DND_BAD_SLOT | DND_REVOKE_ALREADY
  pub let dnd_offer_revoke : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B7-04 (#2267): source-side revoke by BUMPING revocation_seq (no free -- the target may still be mid-read; free is a separate GC pass). row_id >= DND_MAX -> DND_BAD_SLOT; not in_use -> DND_REVOKE_ALREADY; else load-inc-store revocation_seq + bump revokes + return 0. Encoder-conservative load-inc-store (no add reg,[mem]). Labels prefixed dnd_offer_rev_.",
      block: {
        push r12;
        mov r12, rdi;

        mov r10, 4;
        cmp r12, r10;
        jae dnd_offer_rev_bad_slot;

        mov rdi, r12;
        call dnd_offer_tail_valid;
        cmp rax, 0;
        je  dnd_offer_rev_already;

        // Bump revocation_seq at row+48. Load-inc-store; the
        // encoder rejects add reg,[mem].
        lea r10, [rip + _dnd_table];
        mov r11, r12;
        imul r11, r11, 56;
        add r10, r11;
        mov rax, [r10 + 48];
        add rax, 1;
        mov [r10 + 48], rax;

        mov rdi, 1;                       // DND_ST_REVOKES
        call dnd_offer_note;
        xor rax, rax;
        jmp dnd_offer_rev_out;

      dnd_offer_rev_bad_slot:
        mov rax, 0xFFFFEA27;              // DND_BAD_SLOT
        jmp dnd_offer_rev_out;
      dnd_offer_rev_already:
        mov rax, 0xFFFFEA25;              // DND_REVOKE_ALREADY

      dnd_offer_rev_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Section 12  Boot init.
  // ==========================================================================

  // dnd_offer_init() -> (). Boot-time defensive re-scrub. Zero pool
  // + counters. .bss is already zero at real boot; this call gives
  // a future witness a clean re-scrub point and matches the
  // clipboard.pdx / reference_display_kind.pdx convention.
  pub let dnd_offer_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B7-04 (#2267): call through to dnd_offer_stats_reset for one clean pool + counter zero-out. Labels prefixed dnd_offer_i_.",
      block: {
        call dnd_offer_stats_reset;
        ret
      }
    }

  // pdx_kind_dnd_offer_meta fingerprint tag decl (fingerprint-coverage
  // tooling scans for the exact one-line meta decl; the [legacy: ... OK]
  // suffix gives grep parity with pre-Wave0 boot-log tooling).
  pub let pdx_kind_dnd_offer_meta : [u8; 48] = "kind_dnd_offer meta [legacy: KIND_DND_OFFER OK]\0"
}
