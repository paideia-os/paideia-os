// src/user/compositor/dnd_offer.pdx -- Wave0-B7-04 (paideia-os #2267)
//
// KIND_DND_OFFER = 0x1C7, derived over KIND_MEMORY (= KIND_PAGE, 4).
// Design authority: design/compositor/pwp-spec-vocabulary.md §2.15
// KIND_DND_OFFER (SEALED cap flow; opaque MIME payload; short-lived;
// scoped to one drag-drop operation). Sibling of §2.14 KIND_CLIP_OFFER
// (co-located at 0x1C6; same sealed posture, longer-lived) and §2.16
// KIND_SELECTION_OWNER (unaffected by drag).
//
// =============================================================================
// SECTION 0  DESIGN COMMITMENT  --  NOVEL-CLEAN, SEALED-CAP DRAG-AND-DROP
// =============================================================================
//
// PaideiaOS' drag-and-drop is deliberately NOT X11's XDND round-tripping
// nor Wayland's wl_data_device broadcast. There is no ambient "any
// window under the pointer sees the payload" step: an in-flight drag
// binds exactly one source-window's payload to exactly one currently-
// under-pointer target-window at a time, and the payload is a SEALED
// cap that only the compositor can re-target as the pointer moves.
//
//   (1) The source window's KIND_SELECTION_OWNER-style drag origin
//       calls dnd_offer_mint the moment a drag starts, naming the
//       source window, the MIME types the payload advertises, the
//       KIND_MEMORY row that holds the payload bytes (lazy -- the row
//       is minted by the source and pin-validated at mint), and a
//       drag-serial the target will echo back on accept/reject to
//       protect against stale accepts across serial-numbered drag
//       sessions. The target-window field starts at 0 ("no target
//       under pointer yet") and is updated in-place by the compositor
//       as the pointer moves via dnd_offer_update_target.
//
//   (2) On pointer motion the compositor calls dnd_offer_update_target
//       with the new target-window id (0 = no drop target) and the
//       new pointer position in root coords. The target-window field
//       is compositor-owned; a recipient never mutates it -- it is a
//       read-only field on the recipient's cap (R_DND_QUERY_POSITION
//       lets it read pointer_x / pointer_y through the compositor to
//       align its drop-preview highlight; the target field itself is
//       always self-referential from the recipient's perspective).
//
//   (3) The target window's cap grants R_DND_QUERY_MIME_TYPES +
//       R_DND_RECEIVE_DATA + R_DND_QUERY_POSITION + R_DND_ACCEPT +
//       R_DND_REJECT (and the source holds R_DND_REVOKE). On drop the
//       target calls dnd_offer_accept(row, mime_offset) selecting the
//       MIME index it wants (0..mime_type_count-1) or dnd_offer_reject
//       to bounce the drop. Accept records the accepted_mime_offset;
//       reject stamps a sentinel offset. Both are terminal for the
//       target's use of the cap -- the payload materialisation via
//       R_DND_RECEIVE_DATA is guarded on dnd_offer_is_accepted.
//
//   (4) If the source revokes (drag cancelled, source window died,
//       pointer released outside any target), dnd_offer_revoke bumps
//       revocation_seq. The target's next access sees the bump and
//       treats the offer as invalidated. Revoke is BROADER than the
//       clipboard sibling because a drag session terminates in more
//       ways: escape key, pointer up over no target, source death,
//       explicit cancel. All those paths funnel through dnd_offer_revoke.
//
// The rights layout is what enforces the "recipient consumes, no
// re-share" contract: R_DND_QUERY_MIME_TYPES + R_DND_RECEIVE_DATA +
// R_DND_QUERY_POSITION + R_DND_ACCEPT + R_DND_REJECT + R_DND_REVOKE
// and NOTHING ELSE. There is deliberately NO R_DND_MINT bit in
// R_DND_ALL -- a mint gate that grants mint-rights to the derived
// cap would let a target re-mint the drag offer for a third window
// mid-drag; sealed means the source's compositor is the only actor
// that can call dnd_offer_mint. This mirrors KIND_CLIP_OFFER (which
// forbids R_CO_MINT for the same reason) and KIND_TLS_TRUST at
// kernel/core/cap/kind_tls_trust.pdx (which refuses WRITE/MINT/REVOKE
// entirely to keep the anchor immutable-once-minted); here we allow
// REVOKE (the source retains the authority to invalidate the drag),
// ACCEPT/REJECT (the target's decision moment), and QUERY_* rights,
// but not MINT.
//
// This user-space module lives on the compositor side of the ring
// boundary -- it is NOT wired into cap_table / cap_invoke_dispatch
// (those live behind kernel ring boundaries and this file lives on
// the user side of that boundary; see path). The compositor process
// (a userland supervisor at ring 3) holds the row pool. A future
// landing that promotes drag-offer authority INTO the kernel would
// move the row pool + mint gate into src/kernel/core/cap/ (mirroring
// the kind_color_profile.pdx posture at 0x18F) and wire the same op
// catalogue through cap_invoke_dispatch; nothing here prevents that
// promotion.
//
// =============================================================================
// SECTION 1  KIND_* SLOT ALLOCATION
// =============================================================================
//
// KIND_DND_OFFER = 0x1C7. next-wave-derived-kinds.md §"Summary counts
// and free bands" (line 2397) names 0x1B5 as the next free tag; the
// Wave-0 Batch-6 assignment walked 0x1B8..0x1C6 for the PWP-vocabulary
// kinds (window, surface, seat, input-route, damage, present-feedback,
// workspace, ..., ending at KIND_CLIP_OFFER = 0x1C6). Wave-0 Batch-7
// picks 0x1C7 as the immediate next free slot; KIND_RECOVERY_PLANE
// already sits at 0x1C8 (see src/user/compositor/recovery_plane_reserve.pdx
// which reserved 0x1C8 in Batch-6). Grep over src/**/kind_*.pdx +
// src/**/*_kind.pdx + src/**/*.pdx at landing time confirmed no live
// claim on 0x1C7 across the kernel or user tree.
//
// =============================================================================
// SECTION 2  DERIVATION OVER KIND_MEMORY
// =============================================================================
//
// The drag payload itself lives in a caller-supplied KIND_MEMORY row
// (data_kind_id below); the DND_OFFER row wraps a compositor-held
// handle to that payload. The mint gate is the standard "you must
// hold a KIND_MEMORY parent carrying RIGHT_MINT". Payload bytes are
// LAZY: the recipient calls receive_data (a G7-M5-002 landing, out
// of scope) to materialise them out of data_kind_id, and MUST first
// call dnd_offer_is_accepted to confirm the accept boundary was
// crossed. The offer row itself only names the data cap, so the
// source can revoke the offer without eagerly materialising a copy.
//
// =============================================================================
// SECTION 3  ROW LAYOUT  --  56 BYTES (SEVEN u64 WORDS)
// =============================================================================
//
//   [+0]  header:     in_use[63:56] | reserved[55:0]
//   [+8]  windows:    source_win[31:0]  | target_win[63:32]
//   [+16] payload:    mime_count[31:0]  | data_kind_id[63:32]
//   [+24] mime_ptr:   mime_types_ptr (u64) -- opaque compositor-owned
//                     pointer to an interned MIME string table
//   [+32] pointer:    pointer_x[31:0]   | pointer_y[63:32]
//                     (both i32 in caller semantics; stored as raw
//                     32-bit bit patterns and returned zero-extended;
//                     caller sign-extends on read via movsxd or
//                     equivalent -- keeps this file's reads uniform
//                     with the other u32 fields and defers the sign-
//                     bit interpretation to the caller who owns the
//                     coordinate-system convention)
//   [+40] accept:     accepted_mime_offset[31:0] | serial[63:32]
//                     (accepted_mime_offset == 0xFFFFFFFF means "not
//                     yet accepted"; any other value is a valid MIME
//                     index in 0..mime_type_count-1)
//   [+48] rev:        revocation_seq (u64, monotonic; incremented on
//                     every dnd_offer_revoke call)
//
// source_win / target_win are KIND_WINDOW ids (u32). source_win MUST
// be non-zero (dnd_offer_mint refuses zero as DND_MINT_BAD_SRC); this
// is the drag origin and there is no meaningful "unset" source. In
// contrast target_win MAY be 0, and starts at 0 at mint time: 0 is
// the sentinel for "no window currently under the pointer" and is a
// valid transient state during an in-flight drag. dnd_offer_update_target
// happily accepts target_win == 0 -- that is how "you moved off any
// drop target" is expressed. Both fields are u32 so they pack into
// one u64; if the KIND_WINDOW id space ever exceeds 32 bits the row
// grows to 64 bytes here.
//
// data_kind_id (u32) is a cap_table slot id, not a raw pointer -- the
// recipient dereferences it through cap_invoke_dispatch (KIND_MEMORY
// reader ops) after crossing the accept boundary. 32 bits is well
// past the cap_table's row ceiling.
//
// serial (u32) is a monotonic drag-session serial minted by the
// input server / compositor before the mint call. The target echoes
// it back on accept / reject so a stale accept from a previous drag
// (window was fast, the same MIME set was re-offered milliseconds
// later on a new drag) does not collide. Serial 0 is refused at
// mint (DND_MINT_BAD_SERIAL) so 0 can be reserved as a "no drag"
// sentinel by any future consumer.
//
// revocation_seq (full u64) starts at 0 on mint and is incremented on
// every dnd_offer_revoke. The recipient reads it via dnd_offer_row_rev_seq
// and treats any seq > "the seq I saw at first receive" as invalidation.
// Full u64 (rather than packing into the header's 56 free bits) is
// chosen for symmetry with the design doc's "sealed cap w/ monotonic
// invalidation" contract -- a 56-bit seq will not overflow in
// practice, but a full u64 leaves NO ambiguity about "does this
// wrap". Matches clipboard.pdx §3.
//
// =============================================================================
// SECTION 4  FAILURE TAXONOMY  --  0xFFFFEA20..0xFFFFEA2F
// =============================================================================
//
// Repo-wide grep at landing time showed 0xFFFFEA20..0xFFFFEA2F free
// across src/ + design/ (KIND_CLIP_OFFER sits at 0xFFFFEA30..0xFFFFEA3F
// immediately above; a fresh page here keeps grep-lookups clean and
// leaves 0xFFFFEA00..0xFFFFEA1F free for other Batch-7 siblings that
// need one). The taxonomy mirrors clipboard's shape point-for-point:
// TAIL_ENOSPC/TAIL_BAD_ARG for the row pool, MINT_BAD_* for the mint
// gate, BAD_SLOT/REVOKE_ALREADY/UNSUP_OP/MIME_MAX_EXCEED/MIME_PTR_NULL/
// INVALIDATED for the runtime surface, plus two DND-specific sentinels
// (MINT_BAD_SERIAL and BAD_MIME_OFFSET for the accept-index check).
//
// =============================================================================
// SECTION 5  OP CATALOGUE  (arity 1..3; op_arg[63:X] REFUSED per convention)
// =============================================================================
//
//   DND_OP_QUERY_SOURCE         (op_arg IGNORED) -> source_window_kind_id
//   DND_OP_QUERY_TARGET         (op_arg IGNORED) -> target_window_kind_id (may be 0)
//   DND_OP_QUERY_MIME_COUNT     (op_arg IGNORED) -> mime_type_count
//   DND_OP_QUERY_MIME_PTR       (op_arg IGNORED) -> mime_types_ptr (opaque)
//   DND_OP_QUERY_DATA_KIND      (op_arg IGNORED) -> data_kind_id
//   DND_OP_QUERY_POINTER_X      (op_arg IGNORED) -> pointer_x (i32, zero-ext u64)
//   DND_OP_QUERY_POINTER_Y      (op_arg IGNORED) -> pointer_y (i32, zero-ext u64)
//   DND_OP_QUERY_ACCEPT_OFFSET  (op_arg IGNORED) -> accepted_mime_offset (0xFFFFFFFF = not accepted)
//   DND_OP_QUERY_SERIAL         (op_arg IGNORED) -> serial
//   DND_OP_QUERY_REV_SEQ        (op_arg IGNORED) -> revocation_seq
//   DND_OP_UPDATE_TARGET        (target, x, y)   -> 0 | DND_* sentinel (compositor-only)
//   DND_OP_ACCEPT               (mime_offset)    -> 0 | DND_* sentinel (target-side)
//   DND_OP_REJECT               (op_arg IGNORED) -> 0 | DND_* sentinel (target-side)
//   DND_OP_REVOKE               (op_arg IGNORED) -> 0 | DND_* sentinel (source-side)
//
// A recipient that wants to consummate the drop:
//   (1) calls QUERY_MIME_COUNT + walks the MIME table (compositor-
//       mediated string fetches, out of scope here)
//   (2) picks the MIME index it will accept and calls ACCEPT(mime_offset)
//   (3) calls QUERY_DATA_KIND to get the KIND_MEMORY cap slot id
//   (4) calls the KIND_MEMORY reader (G7-M5-002 receive_data) to
//       materialise bytes into a caller-owned buffer
//   (5) checks QUERY_REV_SEQ before and after; a bumped seq
//       invalidates the transfer.

module DndOffer = structure {

  pub let KIND_DND_OFFER      : u64 = 0x1C7
  pub let KIND_DND_OFFER_BASE : u64 = 4          // KIND_MEMORY

  // Row pool. DND_MAX = 4 because a workstation has 0..1 live drag
  // sessions at any moment (drag is single-pointer, single-session
  // per seat; even multi-seat compositors rarely exceed 4). 4 covers
  // a multi-seat rig with concurrent drags without over-committing
  // .bss. Matches CO_MAX in clipboard.pdx §3 for the same reason.
  pub let DND_MAX       : u64 = 4
  pub let DND_ROW_BYTES : u64 = 56

  // Rights. SEALED cap: NO R_DND_MINT bit. The compositor is the only
  // actor that can mint (it holds the KIND_MEMORY parent cap for the
  // payload); the target's derived cap grants query + receive +
  // accept + reject + revoke and that is the entire surface.
  //
  //   R_DND_QUERY_MIME_TYPES  -- read mime_type_count + walk MIME strs
  //   R_DND_RECEIVE_DATA      -- materialise payload out of data_kind_id
  //                              (guarded by dnd_offer_is_accepted at
  //                              the consumer; the right itself is
  //                              orthogonal to accept-state so the
  //                              recipient can precompute buffer sizing)
  //   R_DND_QUERY_POSITION    -- read pointer_x / pointer_y (updates
  //                              across drag; caller polls or the
  //                              compositor pushes via a stream on
  //                              a companion channel)
  //   R_DND_ACCEPT            -- target-side accept boundary
  //   R_DND_REJECT            -- target-side reject boundary
  //   R_DND_REVOKE            -- source can invalidate the offer
  //   (NO R_DND_MINT)         -- sealed; target cannot re-share
  //
  // Bit 0x008 is deliberately left UNUSED as the "would be MINT"
  // reservation; keeping it clear in R_DND_ALL makes the sealed
  // property grep-visible (a future refactor that stitches MINT at
  // 0x008 will stand out in review).
  pub let R_DND_QUERY_MIME_TYPES : u64 = 0x001
  pub let R_DND_RECEIVE_DATA     : u64 = 0x002
  pub let R_DND_QUERY_POSITION   : u64 = 0x004
  pub let R_DND_ACCEPT           : u64 = 0x010
  pub let R_DND_REJECT           : u64 = 0x020
  pub let R_DND_REVOKE           : u64 = 0x040
  pub let R_DND_ALL              : u64 = 0x077     // 0x001|0x002|0x004|0x010|0x020|0x040

  // Ops. Arity varies -- most are arity 1 (op_arg[63:8] REFUSED), but
  // DND_OP_UPDATE_TARGET is arity 3 (target, x, y packed by the caller
  // on the ABI boundary; the row-mutator helper below takes them as
  // three SysV registers) and DND_OP_ACCEPT is arity 1 (mime_offset).
  pub let DND_OP_QUERY_SOURCE        : u64 = 0
  pub let DND_OP_QUERY_TARGET        : u64 = 1
  pub let DND_OP_QUERY_MIME_COUNT    : u64 = 2
  pub let DND_OP_QUERY_MIME_PTR      : u64 = 3
  pub let DND_OP_QUERY_DATA_KIND     : u64 = 4
  pub let DND_OP_QUERY_POINTER_X     : u64 = 5
  pub let DND_OP_QUERY_POINTER_Y     : u64 = 6
  pub let DND_OP_QUERY_ACCEPT_OFFSET : u64 = 7
  pub let DND_OP_QUERY_SERIAL        : u64 = 8
  pub let DND_OP_QUERY_REV_SEQ       : u64 = 9
  pub let DND_OP_UPDATE_TARGET       : u64 = 10
  pub let DND_OP_ACCEPT              : u64 = 11
  pub let DND_OP_REJECT              : u64 = 12
  pub let DND_OP_REVOKE              : u64 = 13
  pub let DND_OP_MAX                 : u64 = 13

  // Failure taxonomy 0xFFFFEA20..0xFFFFEA2F. Grep-verified free
  // across src/ + design/ at landing.
  pub let DND_OK                : u64 = 0
  pub let DND_TAIL_ENOSPC       : u64 = 0xFFFFEA2F
  pub let DND_TAIL_BAD_ARG      : u64 = 0xFFFFEA2E
  pub let DND_MINT_BAD_PARENT   : u64 = 0xFFFFEA2D
  pub let DND_MINT_BAD_RIGHTS   : u64 = 0xFFFFEA2C
  pub let DND_MINT_BAD_SRC      : u64 = 0xFFFFEA2B  // source_win == 0
  pub let DND_MINT_BAD_MIME     : u64 = 0xFFFFEA2A  // mime_count == 0 or overflow
  pub let DND_MINT_BAD_DATA     : u64 = 0xFFFFEA29  // data_kind_id == 0
  pub let DND_MINT_BAD_SERIAL   : u64 = 0xFFFFEA28  // serial == 0 (reserved)
  pub let DND_BAD_SLOT          : u64 = 0xFFFFEA27
  pub let DND_WRONG_KIND        : u64 = 0xFFFFEA26
  pub let DND_REVOKE_ALREADY    : u64 = 0xFFFFEA25
  pub let DND_UNSUP_OP          : u64 = 0xFFFFEA24
  pub let DND_MIME_PTR_NULL     : u64 = 0xFFFFEA23
  pub let DND_INVALIDATED       : u64 = 0xFFFFEA22
  pub let DND_BAD_MIME_OFFSET   : u64 = 0xFFFFEA21  // accept: mime_offset >= mime_type_count
  pub let DND_BAD_TARGET        : u64 = 0xFFFFEA20  // update_target: target overflows u32

  pub let DND_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let DND_ROW_NONE   : u64 = 0xFF

  // Cap on mime_type_count. Same argument as clipboard.pdx §3: a
  // well-formed drag offer names 1..~10 MIME types; 64 is well clear
  // of any real caller and small enough that a malicious source
  // cannot exhaust the compositor's interned string table through
  // offer-count amplification.
  pub let DND_MIME_MAX : u64 = 64

  // Sentinel for "not yet accepted" in accepted_mime_offset (a u32
  // field packed into accept[+40] low half). 0xFFFFFFFF is the
  // canonical "u32 max" sentinel here; any real MIME index is in
  // 0..DND_MIME_MAX-1 which cannot collide with 0xFFFFFFFF.
  pub let DND_ACCEPT_NONE : u64 = 0xFFFFFFFF

  // THE ONE STATE CELL. 4 rows * 56 bytes = 224 bytes = 28 u64.
  pub let mut _dnd_table : [u64; 28] = uninit @align(64)
  pub let mut _dnd_stats : [u64; 8]  = uninit @align(64)

  pub let DND_ST_MINTS    : u64 = 0
  pub let DND_ST_REVOKES  : u64 = 1
  pub let DND_ST_REFUSED  : u64 = 2
  pub let DND_ST_QUERIES  : u64 = 3
  pub let DND_ST_UPDATES  : u64 = 4      // dnd_offer_update_target success
  pub let DND_ST_ACCEPTS  : u64 = 5      // dnd_offer_accept success
  pub let DND_ST_REJECTS  : u64 = 6      // dnd_offer_reject success

  // Fingerprint tag. Emitted by the compositor on successful mint of
  // a drag-offer cap. Legacy suffix gives grep parity with pre-Wave0
  // boot-log tooling per this codebase's tag convention (see
  // co_mint_ok_msg in src/user/compositor/clipboard.pdx and
  // rdk_mint_ok_msg in src/user/color/reference_display_kind.pdx).
  pub let dnd_mint_ok_msg : [u8; 47] = "dnd offer mint ok [legacy: DND OFFER MINT OK]\n\0"

  // ==========================================================================
  // Section 6  Counter primitives.
  // ==========================================================================

  pub let dnd_offer_stats_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B7-04 (#2267): clear row table + counters at boot. Labels prefixed dnd_offer_rs_.",
      block: {
        lea r10, [rip + _dnd_table];
        xor rax, rax;
        xor rcx, rcx;
      dnd_offer_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 28;
        jb  dnd_offer_rs_rows;

        lea r10, [rip + _dnd_stats];
        xor rcx, rcx;
      dnd_offer_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  dnd_offer_rs_stats;
        ret
      }
    }

  pub let dnd_offer_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B7-04 (#2267): counter bump. Encoder-conservative load-inc-store; no add reg,[mem]. Labels prefixed dnd_offer_nt_.",
      block: {
        cmp rdi, 8;
        jae dnd_offer_nt_out;
        lea r10, [rip + _dnd_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      dnd_offer_nt_out:
        ret
      }
    }

  pub let dnd_offer_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B7-04 (#2267): counter read. Labels prefixed dnd_offer_st_.",
      block: {
        cmp rdi, 8;
        jae dnd_offer_st_zero;
        lea r10, [rip + _dnd_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      dnd_offer_st_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Section 7  Validators.
  // ==========================================================================

  pub let dnd_offer_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B7-04 (#2267): subset test against R_DND_ALL = 0x077. NO R_DND_MINT bit present -- sealed. Labels prefixed dnd_offer_rv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x077;
        and rax, r10;
        cmp rax, rdi;
        jne dnd_offer_rv_no;
        mov rax, 1;
        ret;
      dnd_offer_rv_no:
        xor rax, rax;
        ret
      }
    }

  // dnd_offer_source_valid(win_id) -> 1 iff win_id fits in u32 and is
  // non-zero. Non-zero because the drag origin is always a real
  // window; there is no "unset" source sentinel. u32-bounded because
  // source_win is stored in the low u32 of the windows word.
  pub let dnd_offer_source_valid : (u64) -> u64 !{} @{} =
    fn (win_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B7-04 (#2267): 1 iff win_id in (0, 2^32). Labels prefixed dnd_offer_sv_.",
      block: {
        cmp rdi, 0;
        je  dnd_offer_sv_no;
        mov rax, rdi;
        shr rax, 32;
        cmp rax, 0;
        jne dnd_offer_sv_no;
        mov rax, 1;
        ret;
      dnd_offer_sv_no:
        xor rax, rax;
        ret
      }
    }

  // dnd_offer_target_valid(win_id) -> 1 iff win_id fits in u32
  // (zero PERMITTED as the "no drop target under pointer" sentinel).
  // Only checks the u32 bound because target is legitimately zero
  // during pointer-off-target motion. Contrast with source_valid
  // above which refuses zero.
  pub let dnd_offer_target_valid : (u64) -> u64 !{} @{} =
    fn (win_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B7-04 (#2267): 1 iff win_id in [0, 2^32). Zero permitted -- 'no drop target'. Labels prefixed dnd_offer_tv_.",
      block: {
        mov rax, rdi;
        shr rax, 32;
        cmp rax, 0;
        jne dnd_offer_tv_no;
        mov rax, 1;
        ret;
      dnd_offer_tv_no:
        xor rax, rax;
        ret
      }
    }

  // dnd_offer_mime_count_valid(count) -> 1 iff 0 < count <= DND_MIME_MAX.
  // A drag offer with zero MIME types has no advertised payload
  // shape and is refused at mint (DND_MINT_BAD_MIME); the ceiling
  // (DND_MIME_MAX = 64) forecloses interning-table exhaustion.
  pub let dnd_offer_mime_count_valid : (u64) -> u64 !{} @{} =
    fn (count: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B7-04 (#2267): 1 iff count in (0, DND_MIME_MAX=64]. Labels prefixed dnd_offer_mv_.",
      block: {
        cmp rdi, 0;
        je  dnd_offer_mv_no;
        mov r10, 64;
        cmp rdi, r10;
        ja  dnd_offer_mv_no;
        mov rax, 1;
        ret;
      dnd_offer_mv_no:
        xor rax, rax;
        ret
      }
    }

  pub let dnd_offer_data_kind_valid : (u64) -> u64 !{} @{} =
    fn (data_kind_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B7-04 (#2267): 1 iff data_kind_id in (0, 2^32). Non-zero because the payload cap must exist. Labels prefixed dnd_offer_dv_.",
      block: {
        cmp rdi, 0;
        je  dnd_offer_dv_no;
        mov rax, rdi;
        shr rax, 32;
        cmp rax, 0;
        jne dnd_offer_dv_no;
        mov rax, 1;
        ret;
      dnd_offer_dv_no:
        xor rax, rax;
        ret
      }
    }

  pub let dnd_offer_mime_ptr_valid : (u64) -> u64 !{} @{} =
    fn (mime_ptr: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B7-04 (#2267): 1 iff mime_ptr != 0. Opaque to target (compositor-owned interned table) but a null pointer is a broken offer. Labels prefixed dnd_offer_pv_.",
      block: {
        cmp rdi, 0;
        je  dnd_offer_pv_no;
        mov rax, 1;
        ret;
      dnd_offer_pv_no:
        xor rax, rax;
        ret
      }
    }

  // dnd_offer_serial_valid(serial) -> 1 iff serial in (0, 2^32).
  // Serial 0 is reserved as a 'no drag session' sentinel for any
  // future caller; refuse it at mint so it never appears on a live
  // row.
  pub let dnd_offer_serial_valid : (u64) -> u64 !{} @{} =
    fn (serial: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B7-04 (#2267): 1 iff serial in (0, 2^32). Labels prefixed dnd_offer_ssv_.",
      block: {
        cmp rdi, 0;
        je  dnd_offer_ssv_no;
        mov rax, rdi;
        shr rax, 32;
        cmp rax, 0;
        jne dnd_offer_ssv_no;
        mov rax, 1;
        ret;
      dnd_offer_ssv_no:
        xor rax, rax;
        ret
      }
    }

  // dnd_offer_coord_valid(coord) -> 1 iff coord fits in the low 32
  // bits (i.e. discarding high 32 bits is idempotent). The caller
  // may pass a signed i32 as its u64-sign-extended form (high half
  // 0xFFFFFFFF) OR as its unsigned zero-extended form (high half 0);
  // both must be accepted. Test: the sign-extended-i32 low bit 31
  // must match every bit in the high half.
  pub let dnd_offer_coord_valid : (u64) -> u64 !{} @{} =
    fn (coord: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B7-04 (#2267): 1 iff coord is a valid i32-in-u64 (either zero-ext or sign-ext form). Compute expected high = (low >> 31 ? 0xFFFFFFFF : 0); compare against actual high. Labels prefixed dnd_offer_cv_.",
      block: {
        // rax = low 32 bits
        mov rax, rdi;
        and rax, 0xFFFFFFFF;
        // r10 = high 32 bits (actual)
        mov r10, rdi;
        shr r10, 32;
        // r11 = expected high: 0xFFFFFFFF if low bit 31 is set, else 0
        mov r11, rax;
        shr r11, 31;
        // r11 in {0,1}; multiply by 0xFFFFFFFF -> {0, 0xFFFFFFFF}
        cmp r11, 0;
        je  dnd_offer_cv_hi_zero;
        mov r11, 0xFFFFFFFF;
        jmp dnd_offer_cv_hi_cmp;
      dnd_offer_cv_hi_zero:
        xor r11, r11;
      dnd_offer_cv_hi_cmp:
        cmp r10, r11;
        jne dnd_offer_cv_no;
        mov rax, 1;
        ret;
      dnd_offer_cv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Section 8  Packers.
  // ==========================================================================

  // windows word: source_win[31:0] | target_win[63:32]
  pub let dnd_offer_windows_pack : (u64, u64) -> u64 !{} @{} =
    fn (source_win: u64) (target_win: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B7-04 (#2267): windows pack. Both halves capped at u32 max. Labels prefixed dnd_offer_wp_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  dnd_offer_wp_bad;
        cmp rsi, r10;
        ja  dnd_offer_wp_bad;
        mov rax, rdi;
        and rax, 0xFFFFFFFF;
        mov r10, rsi;
        and r10, 0xFFFFFFFF;
        shl r10, 32;
        or  rax, r10;
        ret;
      dnd_offer_wp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // payload word: mime_count[31:0] | data_kind_id[63:32]
  pub let dnd_offer_payload_pack : (u64, u64) -> u64 !{} @{} =
    fn (mime_count: u64) (data_kind_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B7-04 (#2267): payload pack. Both halves capped at u32 max. Labels prefixed dnd_offer_pp_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  dnd_offer_pp_bad;
        cmp rsi, r10;
        ja  dnd_offer_pp_bad;
        mov rax, rdi;
        and rax, 0xFFFFFFFF;
        mov r10, rsi;
        and r10, 0xFFFFFFFF;
        shl r10, 32;
        or  rax, r10;
        ret;
      dnd_offer_pp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // pointer word: pointer_x[31:0] | pointer_y[63:32]  (low 32 bits
  // of each input treated as an i32 bit-pattern; high 32 bits of the
  // input are discarded here, so the caller is free to pass either
  // zero-ext or sign-ext i32 forms).
  pub let dnd_offer_pointer_pack : (u64, u64) -> u64 !{} @{} =
    fn (pointer_x: u64) (pointer_y: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B7-04 (#2267): pointer pack. Low 32 bits of each arg; high bits DISCARDED (i32 bit pattern already carries sign in bit 31). Labels prefixed dnd_offer_ptp_.",
      block: {
        mov rax, rdi;
        and rax, 0xFFFFFFFF;
        mov r10, rsi;
        and r10, 0xFFFFFFFF;
        shl r10, 32;
        or  rax, r10;
        ret
      }
    }

  // accept word: accepted_mime_offset[31:0] | serial[63:32]
  pub let dnd_offer_accept_pack : (u64, u64) -> u64 !{} @{} =
    fn (accepted_mime_offset: u64) (serial: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B7-04 (#2267): accept pack. Both halves capped at u32 max. Labels prefixed dnd_offer_ap_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  dnd_offer_ap_bad;
        cmp rsi, r10;
        ja  dnd_offer_ap_bad;
        mov rax, rdi;
        and rax, 0xFFFFFFFF;
        mov r10, rsi;
        and r10, 0xFFFFFFFF;
        shl r10, 32;
        or  rax, r10;
        ret;
      dnd_offer_ap_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // Section 9  Row pool: valid / alloc / free.
  // ==========================================================================

  pub let dnd_offer_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B7-04 (#2267): 1 iff row_id < DND_MAX and in_use. Row stride = DND_ROW_BYTES = 56. Labels prefixed dnd_offer_tv2_.",
      block: {
        cmp rdi, 4;
        jae dnd_offer_tv2_no;
        lea r10, [rip + _dnd_table];
        mov r11, rdi;
        imul r11, r11, 56;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  dnd_offer_tv2_no;
        mov rax, 1;
        ret;
      dnd_offer_tv2_no:
        xor rax, rax;
        ret
      }
    }

  // dnd_offer_tail_alloc(windows, payload, mime_ptr, pointer, accept)
  //   -> row_id | err.
  // Five words caller-provided; the sixth (rev_seq) is initialised
  // to 0 at claim time and the header stamps the in_use bit.
  pub let dnd_offer_tail_alloc : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (windows: u64) (payload: u64) (mime_ptr: u64) (pointer: u64) (accept: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B7-04 (#2267): claim one DND_OFFER row. Low-first scan (rbx=idx) over 4 rows of 56 bytes (idx*56 via imul). On claim: stamp header with the 1<<56 in_use bit, zero revocation_seq, store windows/payload/mime_ptr/pointer/accept. Six callee-save pushes (rbx=idx, r12=windows, r13=payload, r14=mime_ptr, r15=pointer -- plus one stashed via memory) plus one sub rsp,8 leave rsp%16==0 across the internal (no-nested-call) scan. Accept word (5th arg, r8 on SysV entry) is preserved through the scan by copying it to rbp after the push discipline is set. Labels prefixed dnd_offer_ta_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov r12, rdi;                     // windows
        mov r13, rsi;                     // payload
        mov r14, rdx;                     // mime_ptr
        mov r15, rcx;                     // pointer
        mov rbp, r8;                      // accept

        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp r12, r10;
        je  dnd_offer_ta_bad;
        cmp r13, r10;
        je  dnd_offer_ta_bad;
        cmp r14, r10;
        je  dnd_offer_ta_bad;
        cmp rbp, r10;
        je  dnd_offer_ta_bad;
        // pointer word cannot be 'bad' (packer never fails); no check.

        xor rbx, rbx;
      dnd_offer_ta_scan:
        cmp rbx, 4;
        jae dnd_offer_ta_enospc;
        lea r10, [rip + _dnd_table];
        mov r11, rbx;
        imul r11, r11, 56;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  dnd_offer_ta_claim;
        add rbx, 1;
        jmp dnd_offer_ta_scan;

      dnd_offer_ta_claim:
        // header = (1 << 56)  -- in_use bit set; reserved[55:0] = 0
        mov rax, 1;
        shl rax, 56;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r12;   // windows word
        mov [r10 + 16], r13;   // payload word
        mov [r10 + 24], r14;   // mime_types_ptr
        mov [r10 + 32], r15;   // pointer word
        mov [r10 + 40], rbp;   // accept word
        xor rax, rax;
        mov [r10 + 48], rax;   // revocation_seq = 0
        mov rax, rbx;
        jmp dnd_offer_ta_out;

      dnd_offer_ta_enospc:
        mov rax, 0xFFFFEA2F;   // DND_TAIL_ENOSPC
        jmp dnd_offer_ta_out;
      dnd_offer_ta_bad:
        mov rax, 0xFFFFEA2E;   // DND_TAIL_BAD_ARG

      dnd_offer_ta_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let dnd_offer_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B7-04 (#2267): scrub one row (all seven words). Labels prefixed dnd_offer_tf_.",
      block: {
        cmp rdi, 4;
        jae dnd_offer_tf_out;
        lea r10, [rip + _dnd_table];
        mov r11, rdi;
        imul r11, r11, 56;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        mov [r10 + 32], rax;
        mov [r10 + 40], rax;
        mov [r10 + 48], rax;
      dnd_offer_tf_out:
        ret
      }
    }

  // ==========================================================================
  // Section 10  Row-field query helpers.
