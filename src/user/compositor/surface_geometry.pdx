// src/user/compositor/surface_geometry.pdx -- G7.M2-003 (paideia-os #2250)
// Wave-0 Batch-6 #03.  KEYSTONE dependency: G7.M2-001 surface_kind.pdx
// (paideia-os #2246, being written in parallel as B6-01) — the row body
// this record is dropped into.
//
// Design authority:
//   design/compositor/pwp-spec-vocabulary.md §2.1 KIND_SURFACE
//     ("Carries scale factor, viewport, transform, colour profile ID …
//      Fractional-scale as first-class per pitfall P3 …")
//   design/roadmap/next-wave-synthesis.md §4 pitfall P3 (fractional-scale)
//
// =============================================================================
// WHAT THIS MODULE IS
// =============================================================================
//
// One value-type record — SurfaceGeometry — that names every field the
// compositor needs to know to lower a client-side pixel buffer onto the
// swapchain plane the display server has scheduled for the surface.  It is
// NOT a capability kind: no `KIND_ID`, no `RIGHT_MINT` gate, no
// `cap_handler_*` dispatch.  It is data the KIND_SURFACE row (0x2246,
// sibling) inlines as its geometry tail, and that a KIND_SURFACE_COMMIT
// (0x2248, sibling) accumulates in its pending-state buffer.
//
// The point of this record existing as a first-class artefact — with an
// enumerated field set and a stable byte layout — rather than being an
// implicit tuple of loose primitives on the surface row is the P3
// pitfall.  Wayland's history has repeatedly re-hit the same shape:
// "fractional-scale" (5/4, 3/2, 7/4) was bolted on years after the wire
// protocol froze, arrived as a client-side rendering hint, and then had
// to be re-plumbed into every downstream sink (buffer sizing, viewport
// arithmetic, subsurface positioning) as a series of coupled extensions.
// The load-bearing decision here is:
//
//   1. scale is a rational num/den, never a float.  A u32/u32 numerator
//      / denominator pair carries 5/4 exactly (never 1.25000001), rounds
//      predictably at every consumer, and packs into two words that all
//      compositor bodies can copy with a single mov pair.
//
//   2. the scale factor LIVES ON THE SURFACE.  It never lives on the
//      swapchain, and NO CONSUMER OF THIS RECORD ever supersamples an
//      image against the scale factor.  A compositor that renders a 5/4-
//      scale surface at 5/4 the pixel count against a scanned-out plane
//      re-introduces the exact class of bug P3 is written to foreclose
//      (visible ringing on subpixel-aliased text at fractional scales,
//      compounded across multiple layered subsurfaces).  Instead the
//      client renders at the surface's own logical size and lets the
//      display's own scale-then-scan pipeline (KIND_DISPLAY_PLANE at
//      0x172 or the KIND_VK_SWAPCHAIN_IMAGE at G3) carry the scale into
//      the physical pixel grid.  The scale factor on this record is
//      declarative: "the client rendered at this scale; the sink is
//      free to promote it to a matching hardware plane or to
//      downsample it before compositing, but it MUST NOT upsample the
//      client buffer to swapchain resolution."
//
//   3. the src/dst viewport rectangle pair is expressed in the same
//      integer domain as the buffer / surface itself.  Six i32 fields
//      (src_x, src_y, src_w, src_h, dst_w, dst_h) name a buffer-space
//      source rectangle and a surface-space destination extent; the
//      destination origin is implicit (0, 0) — repositioning inside the
//      surface tree is a subsurface-edge concern (§2.3), not a viewport
//      concern.  All-zero == "no viewport, sample the entire buffer at
//      1:1 into the whole surface".  Signed rather than unsigned so a
//      compositor that wants to name a source rectangle whose origin is
//      just outside the buffer (a scroll animation seeded from a
//      partially-out-of-frame region) does not need a second sentinel
//      value; the compositor clamps its own reach against the buffer's
//      actual extent at compose time.
//
//   4. the transform enum is the Wayland-parity 3-bit set (identity /
//      rot90 / rot180 / rot270 / flipped / flipped_rot90 /
//      flipped_rot180 / flipped_rot270).  Wayland-parity is a
//      deliberate compatibility surface: a toolkit that already writes
//      a `wl_output.transform` u32 into its output-configuration path
//      can literally hand the same enum value to this record without a
//      lookup table.  Not compatibility in the wire sense (PWP is a
//      different wire, §1) — compatibility in the "the concept means
//      the same thing" sense that keeps porting cost down.
//
//   5. the stride hint is optional (0 == "compositor derives from
//      buffer format + width").  It exists so a client with a private
//      row-padded buffer allocator can tell the compositor its actual
//      row stride once, at attach time, rather than have the compositor
//      re-derive it every commit.  Non-zero values do NOT authorise a
//      stride smaller than the compositor's own derivation would give
//      (that would let a client shrink the visible buffer without a
//      re-attach); a debug-mode compositor may cross-check and refuse
//      the attach.
//
// =============================================================================
// SECTION 0  RECORD LAYOUT — 48 BYTES / 6 u64 WORDS
// =============================================================================
//
//   [+0]  word0:  scale_num[31:0]      | scale_den[63:32]
//   [+8]  word1:  viewport_src_x[31:0] | viewport_src_y[63:32]     (i32/i32)
//   [+16] word2:  viewport_src_w[31:0] | viewport_src_h[63:32]     (i32/i32)
//   [+24] word3:  viewport_dst_w[31:0] | viewport_dst_h[63:32]     (i32/i32)
//   [+32] word4:  transform[7:0] | reserved[31:8] | stride_hint[63:32]
//   [+40] word5:  reserved (must be zero at rest; reserved for a future
//                 colour-profile-slot back-reference so the compositor can
//                 resolve the surface's KIND_COLOR_PROFILE without a
//                 second lookup).
//
// Total: 48 bytes.  Alignment: 8.  All-zero record is a legal but
// non-default state (scale_den == 0 is an INVALID marker; the default
// factory writes 1/1).
//
// =============================================================================
// SECTION 1  TRANSFORM ENUM (Wayland-parity)
// =============================================================================
//
//   SG_XFORM_IDENTITY           = 0
//   SG_XFORM_ROT_90             = 1   (90°  CCW)
//   SG_XFORM_ROT_180            = 2
//   SG_XFORM_ROT_270            = 3   (270° CCW == 90° CW)
//   SG_XFORM_FLIPPED            = 4   (mirror across the vertical axis)
//   SG_XFORM_FLIPPED_ROT_90     = 5
//   SG_XFORM_FLIPPED_ROT_180    = 6
//   SG_XFORM_FLIPPED_ROT_270    = 7
//
// Any value > 7 is refused by surface_geometry_new with SG_BAD_TRANSFORM.
//
// =============================================================================
// SECTION 2  FAILURE TAXONOMY 0xFFFFED70..0xFFFFED7F
// =============================================================================
//
//   0xFFFFED70  SG_OK               (sentinel — same value as 0 elsewhere;
//                                    exposed as a named constant for the
//                                    caller that wants to compare against
//                                    a symbol rather than a literal 0)
//   0xFFFFED71  SG_BAD_PTR          out_ptr / sg_ptr == 0
//   0xFFFFED72  SG_BAD_SCALE_DEN    scale_den == 0 (would encode division
//                                   by zero at every downstream consumer)
//   0xFFFFED73  SG_BAD_TRANSFORM    transform > 7
//
// The 0xFFFFED70..7F page was chosen after grepping src/ and design/ for
// any live claim; the compositor family (0xFFFFED* range) already houses
// several G5/G6 kinds without collision.  A follow-up chore reserves the
// page in design/architecture/next-wave-derived-kinds.md alongside the
// KIND_SURFACE slot (0x1B?) — same "reserve at landing time" posture the
// R91–R101 blocks already take in that registry.
//
// =============================================================================

module SurfaceGeometry = structure {

  // ---- fingerprint (data-only) --------------------------------------------
  // ONE tag ending [legacy: ... OK] per softarch discipline.  No mint
  // body emits this string today — SurfaceGeometry is a value type, not
  // a KIND cap.  The KIND_SURFACE mint body (paideia-os #2246, sibling
  // B6-01 in this batch) is the first consumer that could emit it as a
  // side-band trace once the record is populated on a fresh row.  Until
  // that landing wires the emit, the string is data-only and needs to
  // be allowlisted in tools/verify-fingerprint-coverage.sh with reason
  // "G7.M2-003 (#2250) SurfaceGeometry value-type record; no mint body
  // to emit from — KIND_SURFACE (#2246) is the first consumer that may
  // emit as a side-band trace.  Not written in this landing to keep
  // this file's diff to the record definition alone."
  pub let pdx_kind_surface_geometry_meta : [u8; 60] = "surface geometry meta ok [legacy: SURFACE GEOMETRY META OK]\0"

  // ---- record shape constants --------------------------------------------
  pub let SG_RECORD_BYTES         : u64 = 48
  pub let SG_RECORD_WORDS         : u64 = 6

  // ---- transform enum ----------------------------------------------------
  pub let SG_XFORM_IDENTITY           : u64 = 0
  pub let SG_XFORM_ROT_90             : u64 = 1
  pub let SG_XFORM_ROT_180            : u64 = 2
  pub let SG_XFORM_ROT_270            : u64 = 3
  pub let SG_XFORM_FLIPPED            : u64 = 4
  pub let SG_XFORM_FLIPPED_ROT_90     : u64 = 5
  pub let SG_XFORM_FLIPPED_ROT_180    : u64 = 6
  pub let SG_XFORM_FLIPPED_ROT_270    : u64 = 7
  pub let SG_XFORM_MAX                : u64 = 7    // inclusive upper bound

  // ---- error codes -------------------------------------------------------
  pub let SG_OK                       : u64 = 0
  pub let SG_BAD_PTR                  : u64 = 0xFFFFED71
  pub let SG_BAD_SCALE_DEN            : u64 = 0xFFFFED72
  pub let SG_BAD_TRANSFORM            : u64 = 0xFFFFED73

  // ---- default-record packed constants -----------------------------------
  // word0 for identity: scale_num=1 (low u32) | scale_den=1 (high u32).
  //   (1u32 << 32) | 1u32 == 0x0000_0001_0000_0001.
  pub let SG_WORD0_IDENTITY_SCALE     : u64 = 0x0000000100000001

  // =========================================================================
  // SECTION 3  FACTORIES
  // =========================================================================

  // surface_geometry_default(out_ptr) -> SG_OK | SG_BAD_PTR.
  //
  // Writes the identity form into the caller-provided 48-byte buffer:
  //   scale = 1/1, no viewport, transform = IDENTITY, stride_hint = 0.
  // This is the "attach-time-null" shape a compositor writes into a
  // freshly minted KIND_SURFACE row before the client has issued any
  // geometry op — the "no-op" record that surface_geometry_is_identity
  // returns 1 for.
  pub let surface_geometry_default : (u64) -> u64 !{mem} @{} =
    fn (out_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G7.M2-003 (paideia-os #2250): fill 48-byte SurfaceGeometry with identity form. Null pointer -> SG_BAD_PTR. No callee-save discipline required (leaf, no nested call); rax carries the result. Uses immediate mov + reg store rather than add reg,[mem] (banned per softarch note). Labels prefixed surface_geometry_ to avoid reserved-word collision (loop/if).",
      block: {
        cmp rdi, 0;
        je  surface_geometry_def_bad;

        // word0: scale = 1/1 packed.
        mov rax, 0x0000000100000001;
        mov [rdi + 0], rax;

        // words 1..5: all zero.
        xor rax, rax;
        mov [rdi + 8],  rax;
        mov [rdi + 16], rax;
        mov [rdi + 24], rax;
        mov [rdi + 32], rax;
        mov [rdi + 40], rax;

        xor rax, rax;              // SG_OK
        ret;

      surface_geometry_def_bad:
        mov rax, 0xFFFFED71;       // SG_BAD_PTR
        ret
      }
    }

  // surface_geometry_new(out_ptr, scale_num, scale_den, transform)
  //   -> SG_OK | SG_BAD_PTR | SG_BAD_SCALE_DEN | SG_BAD_TRANSFORM.
  //
  // The four-arg factory a client uses at first-attach time to declare
  // its intended scale factor and orientation without a viewport.  The
  // viewport slots are zeroed (no crop), stride_hint is zeroed (let the
  // compositor derive it from the buffer format), and word5 is reserved
  // (zero).  A later attach that adds a viewport is a subsequent
  // surface_geometry_set_viewport call (not in this landing — the sibling
  // paideia-os #2251 lands the viewport setter alongside the commit
  // body that consumes it).
  //
  // Only the low 32 bits of scale_num / scale_den are consumed; the low
  // 8 bits of transform.  Wider arguments are masked, not refused, so a
  // caller writing "u64 all-ones as a not-yet-populated field" trips a
  // guard rather than silently packing garbage into the record.
  pub let surface_geometry_new : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (out_ptr: u64) (scale_num: u64) (scale_den: u64) (transform: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G7.M2-003 (paideia-os #2250): pack scale_num/scale_den/transform into a 48-byte SurfaceGeometry record with no viewport. Validate: out_ptr != 0, scale_den (low u32) != 0, transform (low u8) <= 7. rdi=out, rsi=scale_num, rdx=scale_den, rcx=transform. No nested call, so no callee-save discipline; every clobber uses caller-saved r10/r11 for temps. Two-word-pack of scale uses shl r,32 + or (no add reg,[mem]). Labels prefixed surface_geometry_.",
      block: {
        // Guard: out_ptr != 0.
        cmp rdi, 0;
        je  surface_geometry_new_badptr;

        // Guard: scale_den low u32 != 0 (division by zero at every consumer).
        mov r10, rdx;
        mov r11, 0xFFFFFFFF;
        and r10, r11;
        cmp r10, 0;
        je  surface_geometry_new_badden;

        // Guard: transform low u8 <= 7.
        mov r10, rcx;
        mov r11, 0xFF;
        and r10, r11;
        mov r11, 7;
        cmp r10, r11;
        ja  surface_geometry_new_badxf;

        // word0 = (scale_den_low32 << 32) | scale_num_low32.
        mov rax, rdx;              // rax = scale_den (u64)
        mov r11, 0xFFFFFFFF;
        and rax, r11;              // rax = scale_den & u32
        shl rax, 32;               // rax = scale_den << 32
        mov r10, rsi;              // r10 = scale_num (u64)
        and r10, r11;              // r10 = scale_num & u32
        or  rax, r10;              // rax = packed word0
        mov [rdi + 0], rax;

        // words 1..3: viewport = all zero (no crop).
        xor rax, rax;
        mov [rdi + 8],  rax;
        mov [rdi + 16], rax;
        mov [rdi + 24], rax;

        // word4 = (0 << 32) | (transform & 0xFF).  stride_hint = 0.
        mov rax, rcx;
        mov r11, 0xFF;
        and rax, r11;              // rax = transform low byte, zero-extended
        mov [rdi + 32], rax;

        // word5 reserved.
        xor rax, rax;
        mov [rdi + 40], rax;

        xor rax, rax;              // SG_OK
        ret;

      surface_geometry_new_badptr:
        mov rax, 0xFFFFED71;       // SG_BAD_PTR
        ret;

      surface_geometry_new_badden:
        mov rax, 0xFFFFED72;       // SG_BAD_SCALE_DEN
        ret;

      surface_geometry_new_badxf:
        mov rax, 0xFFFFED73;       // SG_BAD_TRANSFORM
        ret
      }
    }

  // =========================================================================
  // SECTION 4  PREDICATES / FIELD READERS
  // =========================================================================

  // surface_geometry_is_identity(sg_ptr) -> 0 | 1.  Null pointer -> 0.
  //
  // Returns 1 iff EVERY field matches the default form:
  //   word0 == SG_WORD0_IDENTITY_SCALE  (scale 1/1)
  //   word1 == 0                          (no src origin)
  //   word2 == 0                          (no src extent)
  //   word3 == 0                          (no dst extent)
  //   word4 == 0                          (transform IDENTITY, stride_hint 0)
  //   word5 == 0                          (reserved)
  //
  // This is the fast path the compositor takes at commit time: an
  // identity-geometry surface is directly-scanoutable if its buffer
  // format matches a scanned-out plane's, skipping the composition
  // shader entirely.  Getting this predicate wrong (e.g. returning 1
  // for a surface with a viewport set) breaks direct-scanout
  // correctness; the field-by-field compare below is deliberate.
  pub let surface_geometry_is_identity : (u64) -> u64 !{mem} @{} =
    fn (sg_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G7.M2-003 (paideia-os #2250): field-by-field identity compare. Null pointer -> 0 (a null record is trivially non-identity in the sense the caller cares about: cannot direct-scanout what you cannot read). Six sequential loads + compares against the identity constants; no callee-save discipline (leaf, no nested call). Uses cmp reg, imm/reg for all guards (never test, never add reg,[mem]).",
      block: {
        cmp rdi, 0;
        je  surface_geometry_isid_no;

        // word0 == 0x0000_0001_0000_0001 ?
        mov rax, [rdi + 0];
        mov r10, 0x0000000100000001;
        cmp rax, r10;
        jne surface_geometry_isid_no;

        // word1 == 0 ?
        mov rax, [rdi + 8];
        cmp rax, 0;
        jne surface_geometry_isid_no;

        // word2 == 0 ?
        mov rax, [rdi + 16];
        cmp rax, 0;
        jne surface_geometry_isid_no;

        // word3 == 0 ?
        mov rax, [rdi + 24];
        cmp rax, 0;
        jne surface_geometry_isid_no;

        // word4 == 0 ?  (transform IDENTITY + stride_hint 0)
        mov rax, [rdi + 32];
        cmp rax, 0;
        jne surface_geometry_isid_no;

        // word5 == 0 ?  (reserved)
        mov rax, [rdi + 40];
        cmp rax, 0;
        jne surface_geometry_isid_no;

        mov rax, 1;
        ret;

      surface_geometry_isid_no:
        xor rax, rax;
        ret
      }
    }

  // surface_geometry_scale_num(sg_ptr) -> u32-in-u64 | 0 on null.
  pub let surface_geometry_scale_num : (u64) -> u64 !{mem} @{} =
    fn (sg_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G7.M2-003 (paideia-os #2250): read scale numerator (low u32 of word0). Null pointer -> 0 (a null geometry has no scale; the caller is expected to have gated on surface_geometry_is_identity before invoking this on a scanout path). Mask against 0xFFFFFFFF because the field is u32 packed into the low half.",
      block: {
        cmp rdi, 0;
        je  surface_geometry_sn_zero;
        mov rax, [rdi + 0];
        mov r10, 0xFFFFFFFF;
        and rax, r10;
        ret;
      surface_geometry_sn_zero:
        xor rax, rax;
        ret
      }
    }

  // surface_geometry_scale_den(sg_ptr) -> u32-in-u64 | 0 on null.
  pub let surface_geometry_scale_den : (u64) -> u64 !{mem} @{} =
    fn (sg_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G7.M2-003 (paideia-os #2250): read scale denominator (high u32 of word0). Null pointer -> 0. shr rax, 32 extracts the high half.",
      block: {
        cmp rdi, 0;
        je  surface_geometry_sd_zero;
        mov rax, [rdi + 0];
        shr rax, 32;
        ret;
      surface_geometry_sd_zero:
        xor rax, rax;
        ret
      }
    }

  // surface_geometry_transform(sg_ptr) -> u8-in-u64 | 0 on null.
  pub let surface_geometry_transform : (u64) -> u64 !{mem} @{} =
    fn (sg_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G7.M2-003 (paideia-os #2250): read transform enum (low u8 of word4). Null pointer -> 0 (SG_XFORM_IDENTITY, which is the safest reading for a caller that has already failed the null check).",
      block: {
        cmp rdi, 0;
        je  surface_geometry_xf_zero;
        mov rax, [rdi + 32];
        mov r10, 0xFF;
        and rax, r10;
        ret;
      surface_geometry_xf_zero:
        xor rax, rax;
        ret
      }
    }

  // surface_geometry_stride_hint(sg_ptr) -> u32-in-u64 | 0 on null.
  pub let surface_geometry_stride_hint : (u64) -> u64 !{mem} @{} =
    fn (sg_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G7.M2-003 (paideia-os #2250): read stride_hint (high u32 of word4). Null pointer -> 0 (the caller-derive fallback). shr rax, 32 extracts the high half.",
      block: {
        cmp rdi, 0;
        je  surface_geometry_sh_zero;
        mov rax, [rdi + 32];
        shr rax, 32;
        ret;
      surface_geometry_sh_zero:
        xor rax, rax;
        ret
      }
    }

  // surface_geometry_viewport_present(sg_ptr) -> 0 | 1.
  //
  // 1 iff any of the six viewport fields (words 1..3 in aggregate) is
  // non-zero.  The compositor reads this at commit to decide whether to
  // apply the viewport-crop path or the whole-buffer path; a null pointer
  // reads as "no viewport" (0), consistent with the identity form.
  pub let surface_geometry_viewport_present : (u64) -> u64 !{mem} @{} =
    fn (sg_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G7.M2-003 (paideia-os #2250): 1 iff words[1..3] carry any non-zero byte. Three sequential loads + or into r10; final r10 != 0 -> 1. Uses cmp reg, 0 (not test), and does NOT use add reg,[mem]. Null pointer -> 0 (identity form has no viewport).",
      block: {
        cmp rdi, 0;
        je  surface_geometry_vp_zero;

        // Accumulate the OR of the three viewport words into r10.
        mov r10, [rdi + 8];
        mov r11, [rdi + 16];
        or  r10, r11;
        mov r11, [rdi + 24];
        or  r10, r11;

        cmp r10, 0;
        je  surface_geometry_vp_zero;
        mov rax, 1;
        ret;

      surface_geometry_vp_zero:
        xor rax, rax;
        ret
      }
    }

  // surface_geometry_record_bytes() -> 48.
  //
  // A caller that wants to allocate a SurfaceGeometry buffer without
  // hard-coding "48" reads it from this constant-returning fn (which
  // mirrors SG_RECORD_BYTES for import-shape reasons — some downstream
  // sites can only reach an fn, not a let binding).
  pub let surface_geometry_record_bytes : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "G7.M2-003 (paideia-os #2250): return SG_RECORD_BYTES (48) as an fn-shaped constant for callers that can only reach functions, not let bindings.",
      block: {
        mov rax, 48;
        ret
      }
    }

}
