// src/user/compositor/workspace_switch.pdx -- Wave0-B9-05 (paideia-os #2289)
//
// WorkspaceSwitch -- present-timeline-synchronised atomic transition
// between two live KIND_WORKSPACE rows on one KIND_DISPLAY_OUTPUT.
// Design authority: design/compositor/pwp-spec-vocabulary.md §2.13
// (KIND_WORKSPACE), the sentence "Workspace switch is a present-
// timeline-synchronised atomic transition (#2289) so the user never
// sees half-old / half-new state during the switch."
//
// Depends on G9-M1-001 (workspace_kind.pdx LANDED B8-02, KIND_WORKSPACE
// at 0x1D2). This landing does NOT re-declare KIND_WORKSPACE and does
// NOT allocate a new KIND_* slot. Consumes the sibling module's row
// pool (_wksp_table) DIRECTLY via rip-relative loads, matching the
// convention recovery_plane_takeover.pdx (B7-06) uses to read the
// sibling reservation cell (_recovery_plane_reservation_cell).
//
// =============================================================================
// SECTION 0  WHY THIS IS A LOGIC MODULE, NOT A KIND CAP
// =============================================================================
//
// A workspace-switch transaction is EPHEMERAL compositor state: it is
// minted at the moment the compositor decides to swap what workspace
// is visible on an output, it holds the display's present-timeline
// waitpoint that makes the swap atomic, and it dies as soon as the
// swap commits (or is refused). Handing a raw cap for a live
// transaction to a client would give the client a way to defer / cancel
// the compositor's atomic commit, which is exactly the concurrency
// hazard the timeline-synchronised design is meant to eliminate.
//
// Sibling precedent: tiling_bsp.pdx (B8-08) makes the identical
// "value type, not KIND cap" call for the same reason -- the arena
// is compositor-internal state, not a client-visible authority. The
// header there (§0 WHY THIS IS A VALUE TYPE, NOT A KIND CAP) is the
// canonical statement of the rule; this landing applies it to switch
// transactions.
//
// A future landing that wants a client-observable switch-in-flight
// (e.g. so an a11y consumer can announce "switching to workspace 3"
// before the swap lands) will publish a PROJECTION through a distinct
// observer capability, mirroring KIND_A11Y_TREE's read-only binding,
// rather than exposing the WorkspaceSwitchTxn row itself.
//
// =============================================================================
// SECTION 1  KIND_* SLOT ALLOCATION
// =============================================================================
//
// N/A -- logic module. No KIND_WORKSPACE_SWITCH slot. The parent
// authority that gates who may mint a switch is the compositor's own
// process boundary (svc-compositor holds the mint gate as a
// process-internal invariant, same posture as tiling_bsp arenas).
//
// =============================================================================
// SECTION 2  WorkspaceSwitchTxn ROW LAYOUT -- 40 BYTES (FIVE u64 WORDS)
// =============================================================================
//
//   [+0]   word0:  from_workspace_kind_id[31:0] | to_workspace_kind_id[63:32]
//   [+8]   word1:  seat_kind_id[31:0]           | output_kind_id[63:32]
//   [+16]  word2:  present_timeline_id (u64, full width)
//   [+24]  word3:  present_timeline_value (u64, full width)
//   [+32]  word4:  switch_seq (u64, full width; 0 = row empty)
//
// The row is 40 bytes = 5 u64 words. The pool is _workspace_switch_table
// = [u64; 40] = 8 rows * 5 u64. Row indexing is imul r11, r11, 40
// (fits in imm8) then add to the base.
//
// Two u32 halves are packed into words 0/1 to shave four u64 stores off
// the mint hot-path. present_timeline_id and present_timeline_value are
// stored as full u64s because the timeline value is a monotonically-
// increasing GPU/present-feedback counter that will grow past 2^32
// over a long session (per design/compositor/pwp-spec-vocabulary.md §2
// "Present-feedback timelines").
//
// switch_seq stamps the monotonic order of switch mints across boot.
// switch_seq == 0 is reserved as the empty-row marker (the seq counter
// post-bumps to 1 on the first mint), so a caller reading the switch
// pool distinguishes "no txn in this slot" from "txn with seq 0" by
// treating word4 == 0 as EMPTY.
//
// The "was this txn already committed" bit lives OUTSIDE the row, in
// _workspace_switch_committed_flags (one u64 = 64 bits, 8 used). This
// keeps the row layout stable and lets the commit epoch be flipped
// atomically without a read-modify-write on the row word (the flags
// cell is only ever OR'd, never AND'd back to zero, and the row is
// freed by scrubbing word4 to 0 which naturally decouples from the
// flags-cell bit for that slot -- the workspace_switch_init and
// workspace_switch_release paths clear the flags bitmask alongside).
//
// =============================================================================
// SECTION 3  FAILURE TAXONOMY 0xFFFFEBB0..0xFFFFEBBF
// =============================================================================
//
// The Wave-0 dispatch manifest for B9-05 named 0xFFFFEBB0..0xFFFFEBBF
// as the failure-taxonomy band. Repo-wide grep at landing time showed
// the following EB-band pages as claimed (see workspace_kind.pdx §3
// for the survey up to page 0xFFFFEB7F):
//   0xFFFFEB70..7F  KIND_WORKSPACE   (B8-02)
//   0xFFFFEB80..8F  free / adjacent B9 sibling reserved
//   0xFFFFEB90..9F  free / adjacent B9 sibling reserved
//   0xFFFFEBA0..AF  free / adjacent B9 sibling reserved
//   0xFFFFEBB0..BF  FREE  <-- claimed here
//   0xFFFFEBEA..EF  audit_journal_broker (kernel)
//   0xFFFFEBF9..FF  elevate_broker (kernel)
// This landing takes 0xFFFFEBB0..0xFFFFEBBF -- the assigned page.
// WS_ROW_NONE sits at the page floor (0xFFFFEBB0) so a downstream
// diagnostic that greps for the "row lookup miss" sentinel finds it
// as its one canonical name.
//
//   WS_OK              = 0
//   WS_TAIL_ENOSPC     = 0xFFFFEBBF   mint refused: pool full
//   WS_TAIL_BAD_ARG    = 0xFFFFEBBE   internal packer refusal
//   WS_NEW_BAD_FROM    = 0xFFFFEBBD   from_workspace_kind_id >  u32 max
//   WS_NEW_BAD_TO      = 0xFFFFEBBC   to_workspace_kind_id   >  u32 max
//   WS_NEW_SAME_WSP    = 0xFFFFEBBB   from == to (a no-op switch)
//   WS_NEW_BAD_SEAT    = 0xFFFFEBBA   seat_kind_id           >  u32 max
//   WS_NEW_BAD_OUTPUT  = 0xFFFFEBB9   output_kind_id         >  u32 max
//   WS_NEW_FROM_GONE   = 0xFFFFEBB8   from workspace not in _wksp_table
//   WS_NEW_TO_GONE     = 0xFFFFEBB7   to workspace not in _wksp_table
//   WS_BAD_SLOT        = 0xFFFFEBB6   row_id >= WS_SWITCH_MAX
//   WS_WORKSPACE_GONE  = 0xFFFFEBB5   from/to revoked between new/execute
//   WS_TIMELINE_STALE  = 0xFFFFEBB4   present cursor < txn.value (not ready)
//                                     OR execute called after commit missed
//   WS_EXEC_ALREADY    = 0xFFFFEBB3   execute called twice on same row
//   WS_ROW_EMPTY       = 0xFFFFEBB2   query on unallocated row
//   WS_ROW_NONE        = 0xFFFFEBB0   sentinel floor / find-miss
//
// =============================================================================
// SECTION 4  TIMELINE SEMANTICS
// =============================================================================
//
// A workspace switch is atomic w.r.t. one output's present-feedback
// timeline: the workspace binding on that output flips at the same
// vsync boundary the GPU signals via the (timeline_id, value) tuple
// the txn carries. In a fully wired system the compositor blocks in
// workspace_switch_execute until the kernel-driven present-feedback
// timeline reaches txn.present_timeline_value, then commits the
// workspace binding, THEN returns to the caller.
//
// This landing is the LOGIC scaffold. The present-feedback timeline
// row cap itself lands in the same batch as KIND_PRESENT_FEEDBACK
// (0x1DA, present_feedback_kind.pdx, B9-07 = paideia-os #2297); a
// later wiring landing joins that row's LAST_VBLANK signal to this
// module's present-cursor cell. To let workspace_switch exercise the
// STALE / WORKSPACE_GONE / OK sentinels end-to-end today, this file
// maintains a single-cell "present cursor" u64:
//
//   _workspace_switch_present_cursor : [u64; 1]
//
// A future landing that wires real present-feedback replaces the
// workspace_switch_cursor_advance stub with a hook from the GPU's
// present-feedback IRQ; the cursor cell's SEMANTICS ("the highest
// timeline value delivered so far") stay identical, so no caller of
// workspace_switch_is_pending / workspace_switch_execute needs to
// change. The cursor is not per-timeline yet -- the multi-output /
// multi-timeline case is future work (see design doc §2.13, "one
// switch per output at a time is the M1 posture").
//
// workspace_switch_is_pending(row_id)  -- 1 iff cursor < txn.value.
// workspace_switch_execute(row_id)     -- if cursor < txn.value =>
//                                          WS_TIMELINE_STALE (caller
//                                          raced ahead of the timeline
//                                          signal; the natural fix is
//                                          to poll is_pending first).
//                                          If cursor >= txn.value =>
//                                          validate both workspaces
//                                          still exist and commit.
//
// The commit is "atomic" per the design in this narrow sense: the
// two workspace-row binding updates happen after the timeline-alive
// check, and the commit flag is set LAST so an interrupted commit
// (crash between the two workspace updates) is observable via the
// committed-flag being clear -- a future crash-recovery landing can
// then retry or roll back. On a single-core ring-3 loop this window
// is bounded and lock-free reads of workspace_kind body2 see either
// the pre-switch state OR the post-switch state, never a mixed pair.
// A future landing that adds a "publication epoch" cell (versioned
// pointer flip) will subsume this scaffolding.
//
// =============================================================================
// SECTION 5  workspace_switch_new FACTORY -- gate order
// =============================================================================
//
// Gate order (fail-fast; refusal funnel bumps
// _workspace_switch_stats[WS_ST_REFUSED] once at workspace_swn_refused):
//   (1) from_workspace_kind_id fits in u32       -> WS_NEW_BAD_FROM
//   (2) to_workspace_kind_id   fits in u32       -> WS_NEW_BAD_TO
//   (3) from != to                               -> WS_NEW_SAME_WSP
//   (4) seat_kind_id fits in u32                 -> WS_NEW_BAD_SEAT
//   (5) output_kind_id fits in u32               -> WS_NEW_BAD_OUTPUT
//   (6) from workspace exists (_wksp_table scan) -> WS_NEW_FROM_GONE
//   (7) to   workspace exists (_wksp_table scan) -> WS_NEW_TO_GONE
//   (8) tail_alloc -> row_id or WS_TAIL_ENOSPC
//   (9) stamp switch_seq (post-bump counter)     -> word4
//
// Note: workspace_id == 0 is a legal workspace id (see workspace_kind.
// pdx §5); we do NOT refuse from/to == 0 as an id.

module WorkspaceSwitch = structure {

  pub let WS_SWITCH_MAX       : u64 = 8
  pub let WS_SWITCH_ROW_BYTES : u64 = 40

  pub let WS_U32_MAX          : u64 = 0xFFFFFFFF

  // Failure taxonomy 0xFFFFEBB0..0xFFFFEBBF (see §3).
  pub let WS_OK               : u64 = 0
  pub let WS_TAIL_ENOSPC      : u64 = 0xFFFFEBBF
  pub let WS_TAIL_BAD_ARG     : u64 = 0xFFFFEBBE
  pub let WS_NEW_BAD_FROM     : u64 = 0xFFFFEBBD
  pub let WS_NEW_BAD_TO       : u64 = 0xFFFFEBBC
  pub let WS_NEW_SAME_WSP     : u64 = 0xFFFFEBBB
  pub let WS_NEW_BAD_SEAT     : u64 = 0xFFFFEBBA
  pub let WS_NEW_BAD_OUTPUT   : u64 = 0xFFFFEBB9
  pub let WS_NEW_FROM_GONE    : u64 = 0xFFFFEBB8
  pub let WS_NEW_TO_GONE      : u64 = 0xFFFFEBB7
  pub let WS_BAD_SLOT         : u64 = 0xFFFFEBB6
  pub let WS_WORKSPACE_GONE   : u64 = 0xFFFFEBB5
  pub let WS_TIMELINE_STALE   : u64 = 0xFFFFEBB4
  pub let WS_EXEC_ALREADY     : u64 = 0xFFFFEBB3
  pub let WS_ROW_EMPTY        : u64 = 0xFFFFEBB2
  pub let WS_ROW_NONE         : u64 = 0xFFFFEBB0

  // Row-field query key. Kept in step with §2 word/bit layout above.
  pub let WS_FIELD_FROM_WSP        : u64 = 0
  pub let WS_FIELD_TO_WSP          : u64 = 1
  pub let WS_FIELD_SEAT            : u64 = 2
  pub let WS_FIELD_OUTPUT          : u64 = 3
  pub let WS_FIELD_TIMELINE_ID     : u64 = 4
  pub let WS_FIELD_TIMELINE_VALUE  : u64 = 5
  pub let WS_FIELD_SWITCH_SEQ      : u64 = 6

  // Stats bank indices.
  pub let WS_ST_NEW          : u64 = 0
  pub let WS_ST_EXECUTE_OK   : u64 = 1
  pub let WS_ST_REFUSED      : u64 = 2
  pub let WS_ST_QUERIES      : u64 = 3

  // THE ONE STATE CELL. 8 rows * 5 u64 = 40 u64 = 320 bytes.
  pub let mut _workspace_switch_table            : [u64; 40] = uninit @align(64)
  pub let mut _workspace_switch_stats            : [u64; 4]  = uninit @align(64)

  // Monotonic seq counter for switch_seq (post-bump; first mint stamps 1).
  pub let mut _workspace_switch_seq_counter      : [u64; 1]  = uninit @align(64)

  // Present-feedback cursor. Advanced by a future landing from the
  // GPU/present-feedback IRQ; here bumped only via
  // workspace_switch_cursor_advance (test/wiring hook, no rights gate).
  pub let mut _workspace_switch_present_cursor   : [u64; 1]  = uninit @align(64)

  // Commit bitmask. Bit k = 1 iff execute has committed row k.
  // Cleared alongside the row on workspace_switch_release / init.
  pub let mut _workspace_switch_committed_flags  : [u64; 1]  = uninit @align(64)

  // Fingerprint tag. Emitted by the compositor on successful commit
  // of a workspace switch. Legacy suffix gives grep parity with
  // pre-Wave0 boot-log tooling (see workspace_kind.pdx
  // pdx_kind_workspace_meta, recovery_plane_takeover.pdx
  // pdx_kind_recovery_plane_takeover_meta).
  pub let pdx_kind_workspace_switch_meta : [u8; 50] = "workspace switch ok [legacy: WORKSPACE SWITCH OK]\0"

  // ==========================================================================
  // Section 6  Counter + cursor primitives.
  // ==========================================================================

  pub let workspace_switch_stats_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-05 (#2289): clear row table + counters + cursor + committed-flag bitmask at boot. 8 rows * 5 u64 = 40 u64 for the table, 4 u64 for stats, 1 u64 for seq, 1 u64 for present cursor, 1 u64 for committed bitmask. Labels prefixed workspace_srs_.",
      block: {
        lea r10, [rip + _workspace_switch_table];
        xor rax, rax;
        xor rcx, rcx;
      workspace_srs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 40;
        jb  workspace_srs_rows;

        lea r10, [rip + _workspace_switch_stats];
        xor rcx, rcx;
      workspace_srs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  workspace_srs_stats;

        lea r10, [rip + _workspace_switch_seq_counter];
        mov [r10 + 0], rax;
        lea r10, [rip + _workspace_switch_present_cursor];
        mov [r10 + 0], rax;
        lea r10, [rip + _workspace_switch_committed_flags];
        mov [r10 + 0], rax;
        ret
      }
    }

  pub let workspace_switch_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-05 (#2289): counter bump. Encoder-conservative load-inc-store; no add reg,[mem]. Labels prefixed workspace_snt_.",
      block: {
        cmp rdi, 4;
        jae workspace_snt_out;
        lea r10, [rip + _workspace_switch_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      workspace_snt_out:
        ret
      }
    }

  pub let workspace_switch_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-05 (#2289): counter read. Labels prefixed workspace_sst_.",
      block: {
        cmp rdi, 4;
        jae workspace_sst_zero;
        lea r10, [rip + _workspace_switch_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      workspace_sst_zero:
        xor rax, rax;
        ret
      }
    }

  // Bump-and-return the monotonic switch_seq counter. First call
  // returns 1 (0 reserved as the empty-row marker in word4).
  pub let workspace_switch_seq_next : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-05 (#2289): monotonic switch_seq bump-and-read. Load-inc-store; no add reg,[mem]. Labels prefixed workspace_ssn_.",
      block: {
        lea r10, [rip + _workspace_switch_seq_counter];
        mov rax, [r10 + 0];
        add rax, 1;
        mov [r10 + 0], rax;
        ret
      }
    }

  // Test/wiring hook: overwrite the present-cursor cell with `value`.
  // A future landing replaces this stub with a hook driven by the
  // GPU's present-feedback IRQ.  The SEMANTICS are unchanged: the
  // cursor cell always holds the highest timeline value delivered so
  // far, so a monotonic bump is the caller's discipline.  Callers
  // that need atomic max-with-observed can wrap in a load-cmp-store
  // externally.
  pub let workspace_switch_cursor_advance : (u64) -> () !{mem} @{} =
    fn (value: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-05 (#2289): overwrite _workspace_switch_present_cursor with rdi. No monotonicity enforcement -- the wiring caller (present-feedback IRQ) is the one obliged to keep the value monotonically increasing. Labels prefixed workspace_sca_.",
      block: {
        lea r10, [rip + _workspace_switch_present_cursor];
        mov [r10 + 0], rdi;
        ret
      }
    }

  pub let workspace_switch_cursor_read : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-05 (#2289): read present cursor. Labels prefixed workspace_scr_.",
      block: {
        lea r10, [rip + _workspace_switch_present_cursor];
        mov rax, [r10 + 0];
        ret
      }
    }

  // ==========================================================================
  // Section 7  Validators.
  // ==========================================================================

  pub let workspace_switch_u32_valid : (u64) -> u64 !{} @{} =
    fn (v: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B9-05 (#2289): 1 iff v <= WS_U32_MAX. Same shape as workspace_u32_valid in the sibling module. Labels prefixed workspace_suv_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  workspace_suv_no;
        mov rax, 1;
        ret;
      workspace_suv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Section 8  Internal helper: workspace-alive lookup.
  //
  // workspace_switch_wksp_find(workspace_id) -> wksp_row_id | WS_ROW_NONE.
  //
  // Directly walks the sibling module's _wksp_table row pool.  This is a
  // LOAD-ONLY consumer -- no mutation.  Same shape as the sibling's
  // workspace_find_by_id but open-coded here so this module does not need
  // a cross-module call (matches the recovery_plane_takeover.pdx pattern
  // of directly reading _recovery_plane_reservation_cell from the sibling
  // reservation module).
  //
  // Iteration is bounded by WKSP_MAX = 16 (see workspace_kind.pdx §2).
  // If the sibling ever bumps its WKSP_MAX constant, this loop bound
  // widens in step -- kept as a numeric literal here to preserve the
  // encoder-conservative constant-load pattern.
  // ==========================================================================

  pub let workspace_switch_wksp_find : (u64) -> u64 !{mem} @{} =
    fn (workspace_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-05 (#2289): linear scan for workspace_id in header[31:0] of every live row of _wksp_table (16 rows, 32-byte stride). Two callee-save pushes (rbx=idx, r12=needle) leave rsp%16==8 with no nested call; no sub rsp,8. Labels prefixed workspace_swf_.",
      block: {
        push rbx;
        push r12;
        mov r12, rdi;
        xor rbx, rbx;
      workspace_swf_scan:
        cmp rbx, 16;
        jae workspace_swf_none;
        lea r10, [rip + _wksp_table];
        mov r11, rbx;
        imul r11, r11, 32;
        add r10, r11;
        mov rax, [r10 + 0];
        mov r11, rax;
        shr r11, 56;
        cmp r11, 0;
        je  workspace_swf_step;
        and rax, 0xFFFFFFFF;
        cmp rax, r12;
        jne workspace_swf_step;
        mov rax, rbx;
        jmp workspace_swf_out;
      workspace_swf_step:
        add rbx, 1;
        jmp workspace_swf_scan;
      workspace_swf_none:
        mov rax, 0xFFFFEBB0;               // WS_ROW_NONE
      workspace_swf_out:
        pop r12;
        pop rbx;
        ret
      }
    }

  // Rebind output_kind_id on the workspace row identified by `wid`.
  // Writes body2[63:32] of the matching _wksp_table row to `new_out`,
  // preserving body2[31:0] (active_window_kind_id).  Returns 0 on
  // success, WS_WORKSPACE_GONE if no live row carries `wid`.
  //
  // NOT rights-gated -- this is a compositor-internal helper called
  // exclusively from workspace_switch_execute after the caller-level
  // rights check has already fired.  Do not expose to clients.
  pub let workspace_switch_wksp_rebind_output : (u64, u64) -> u64 !{mem} @{} =
    fn (wid: u64, new_out: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-05 (#2289): find wksp row by id, then write body2[63:32] = new_out & u32-max, preserving body2[31:0]. Two callee-save pushes (rbx=needle, r12=new_out). One nested call (workspace_switch_wksp_find): rsp%16==8 at entry, +16=24 %16==8 after pushes, sub rsp,8 -> %16==0 for the call. Labels prefixed workspace_swro_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        mov rbx, rdi;                     // wid
        mov r12, rsi;                     // new_out

        mov rdi, rbx;
        call workspace_switch_wksp_find;
        mov r11, 0xFFFFEBB0;              // WS_ROW_NONE
        cmp rax, r11;
        je  workspace_swro_gone;

        // rax = wksp row_id.  Compute row base in _wksp_table.
        lea r10, [rip + _wksp_table];
        mov r11, rax;
        imul r11, r11, 32;
        add r10, r11;

        // Load body2, clear high 32 bits, OR in new_out & 0xFFFFFFFF.
        mov rax, [r10 + 16];
        and rax, 0xFFFFFFFF;              // keep active_window (low 32)
        mov r11, r12;
        shl r11, 32;
        shr r11, 32;
        shl r11, 32;
        or  rax, r11;
        mov [r10 + 16], rax;

        xor rax, rax;                     // WS_OK
        jmp workspace_swro_out;

      workspace_swro_gone:
        mov rax, 0xFFFFEBB5;              // WS_WORKSPACE_GONE

      workspace_swro_out:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Section 9  Row pool: valid / commit-flag / alloc / free.
  // ==========================================================================

  pub let workspace_switch_row_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-05 (#2289): 1 iff row_id < WS_SWITCH_MAX AND word4 (switch_seq) != 0. Labels prefixed workspace_srv_.",
      block: {
        cmp rdi, 8;
        jae workspace_srv_no;
        lea r10, [rip + _workspace_switch_table];
        mov r11, rdi;
        imul r11, r11, 40;
        add r10, r11;
        mov rax, [r10 + 32];              // word4 = switch_seq
        cmp rax, 0;
        je  workspace_srv_no;
        mov rax, 1;
        ret;
      workspace_srv_no:
        xor rax, rax;
        ret
      }
    }

  // 1 iff commit bit for row_id is set in _workspace_switch_committed_flags.
  pub let workspace_switch_row_committed : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-05 (#2289): 1 iff bit row_id of committed bitmask is set. row_id >= 8 -> 0. Labels prefixed workspace_src_.",
      block: {
        cmp rdi, 8;
        jae workspace_src_no;
        lea r10, [rip + _workspace_switch_committed_flags];
        mov rax, [r10 + 0];
        mov rcx, rdi;
        shr rax, cl;
        and rax, 1;
        ret;
      workspace_src_no:
        xor rax, rax;
        ret
      }
    }

  // Set commit bit for row_id.  Internal helper (called from execute).
  pub let workspace_switch_row_mark_committed : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-05 (#2289): OR in bit row_id of committed bitmask. row_id >= 8 -> no-op. Encoder-conservative shift-then-or, no BTS. Labels prefixed workspace_smc_.",
      block: {
        cmp rdi, 8;
        jae workspace_smc_out;
        lea r10, [rip + _workspace_switch_committed_flags];
        mov rcx, rdi;
        mov rax, 1;
        shl rax, cl;                      // rax = 1 << row_id
        mov r11, [r10 + 0];
        or  r11, rax;
        mov [r10 + 0], r11;
      workspace_smc_out:
        ret
      }
    }

  // workspace_switch_tail_alloc(word0, word1, word2, word3, word4)
  //     -> row_id | WS_TAIL_ENOSPC | WS_TAIL_BAD_ARG.
  //
  // Low-first scan over WS_SWITCH_MAX rows.  A row is EMPTY iff word4
  // (switch_seq) == 0; on claim, all five words are stored.  Refuses if
  // caller passes word4 == 0 (would forge an empty row) with
  // WS_TAIL_BAD_ARG.  Six callee-save pushes (rbx=idx, r12..r15=words0..3,
  // rbp=word4) leave rsp%16==8; +48+8=56 %16==8, sub rsp,8 -> %16==0 for
  // the no-nested-call scan.
  pub let workspace_switch_tail_alloc : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (word0: u64) (word1: u64) (word2: u64) (word3: u64) (word4: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-05 (#2289): claim one WorkspaceSwitchTxn row. Low-first scan (rbx=idx) over 8 rows of 40 bytes (idx*40 via imul, imm8 fits). On claim: store the five u64 body words. word4 == 0 is refused as caller-forged-empty-row (WS_TAIL_BAD_ARG). Six callee-save pushes (rbx=idx, r12..r15=word0..word3, rbp=word4); no nested calls, so no rsp alignment padding needed (mirrors workspace_kind.pdx workspace_tail_alloc's push-only prologue). Labels prefixed workspace_sta_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov r12, rdi;                     // word0
        mov r13, rsi;                     // word1
        mov r14, rdx;                     // word2
        mov r15, rcx;                     // word3
        mov rbp, r8;                      // word4

        cmp rbp, 0;
        je  workspace_sta_bad;

        xor rbx, rbx;
      workspace_sta_scan:
        cmp rbx, 8;
        jae workspace_sta_enospc;
        lea r10, [rip + _workspace_switch_table];
        mov r11, rbx;
        imul r11, r11, 40;
        add r10, r11;
        mov rax, [r10 + 32];              // word4 (empty marker)
        cmp rax, 0;
        je  workspace_sta_claim;
        add rbx, 1;
        jmp workspace_sta_scan;

      workspace_sta_claim:
        mov [r10 + 0],  r12;
        mov [r10 + 8],  r13;
        mov [r10 + 16], r14;
        mov [r10 + 24], r15;
        mov [r10 + 32], rbp;
        mov rax, rbx;
        jmp workspace_sta_out;

      workspace_sta_enospc:
        mov rax, 0xFFFFEBBF;              // WS_TAIL_ENOSPC
        jmp workspace_sta_out;
      workspace_sta_bad:
        mov rax, 0xFFFFEBBE;              // WS_TAIL_BAD_ARG

      workspace_sta_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // Scrub one row + clear its commit-flag bit.  row_id >= WS_SWITCH_MAX
  // is a no-op (bounded, no fault).
  pub let workspace_switch_release : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-05 (#2289): scrub one row (five u64 stores) and clear its bit in _workspace_switch_committed_flags. row_id >= 8 -> no-op. Labels prefixed workspace_srl_.",
      block: {
        cmp rdi, 8;
        jae workspace_srl_out;

        lea r10, [rip + _workspace_switch_table];
        mov r11, rdi;
        imul r11, r11, 40;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        mov [r10 + 32], rax;

        // Clear commit bit: AND NOT (1 << row_id).
        lea r10, [rip + _workspace_switch_committed_flags];
        mov rcx, rdi;
        mov rax, 1;
        shl rax, cl;
        not rax;                          // rax = ~(1 << row_id)
        mov r11, [r10 + 0];
        and r11, rax;
        mov [r10 + 0], r11;

      workspace_srl_out:
        ret
      }
    }

  // ==========================================================================
  // Section 10  Row-field query helpers.
  //
  // One helper per field.  All return WS_ROW_EMPTY (0xFFFFEBB2) if the
  // slot is empty (word4 == 0) or WS_BAD_SLOT (0xFFFFEBB6) if row_id
  // is out of range.  This preserves the sibling module's convention
  // that a diagnostic can distinguish "bad index" from "index in
  // range but slot empty" (see workspace_kind.pdx Section 10).
  // ==========================================================================

  pub let workspace_switch_row_from_workspace : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-05 (#2289): from_workspace_kind_id at word0[31:0]. Labels prefixed workspace_srfw_.",
      block: {
        push r12;
        mov r12, rdi;
        call workspace_switch_row_valid;
        cmp rax, 0;
        je  workspace_srfw_bad;
        lea r10, [rip + _workspace_switch_table];
        mov r11, r12;
        imul r11, r11, 40;
        add r10, r11;
        mov rax, [r10 + 0];
        and rax, 0xFFFFFFFF;
        jmp workspace_srfw_out;
      workspace_srfw_bad:
        mov rax, 0xFFFFEBB2;              // WS_ROW_EMPTY
      workspace_srfw_out:
        pop r12;
        ret
      }
    }

  pub let workspace_switch_row_to_workspace : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-05 (#2289): to_workspace_kind_id at word0[63:32]. Labels prefixed workspace_srtw_.",
      block: {
        push r12;
        mov r12, rdi;
        call workspace_switch_row_valid;
        cmp rax, 0;
        je  workspace_srtw_bad;
        lea r10, [rip + _workspace_switch_table];
        mov r11, r12;
        imul r11, r11, 40;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 32;
        and rax, 0xFFFFFFFF;
        jmp workspace_srtw_out;
      workspace_srtw_bad:
        mov rax, 0xFFFFEBB2;
      workspace_srtw_out:
        pop r12;
        ret
      }
    }

