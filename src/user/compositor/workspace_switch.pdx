  // ==========================================================================
  // Section 11  workspace_switch_new  --  mint one WorkspaceSwitchTxn row.
  //
  // Signature:
  //   workspace_switch_new(from_wksp: u64,
  //                        to_wksp:   u64,
  //                        seat:      u64,
  //                        output:    u64,
  //                        timeline:  u64,
  //                        value:     u64)
  //     -> row_id | WS_NEW_* sentinel.
  //
  // Gate order per §5.  Six pushes + sub rsp,8 = 56 bytes: entry
  // rsp%16==8, +56+8=64 %16==0 for every nested call.  All six args
  // stashed into callee-save registers before any nested call clobbers
  // rdi/rsi/rdx/rcx/r8/r9.
  // ==========================================================================

  pub let workspace_switch_new : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (from_wksp: u64) (to_wksp: u64) (seat: u64) (output: u64) (timeline: u64) (value: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-05 (#2289): nine-gate mint. (1) from_wksp <= u32-max else WS_NEW_BAD_FROM. (2) to_wksp <= u32-max else WS_NEW_BAD_TO. (3) from != to else WS_NEW_SAME_WSP. (4) seat <= u32-max else WS_NEW_BAD_SEAT. (5) output <= u32-max else WS_NEW_BAD_OUTPUT. (6) from workspace exists (workspace_switch_wksp_find != WS_ROW_NONE) else WS_NEW_FROM_GONE. (7) to workspace exists else WS_NEW_TO_GONE. (8) tail_alloc -> row_id or WS_TAIL_ENOSPC. (9) stamp switch_seq (post-bump counter). Refusal funnel bumps _workspace_switch_stats[WS_ST_REFUSED] once at workspace_swn_refused; success bumps [WS_ST_NEW]. Six callee-save pushes (rbx=from, r12=to, r13=seat, r14=output, r15=timeline, rbp=value) plus sub rsp,8 = 56 bytes = %16==0 for every nested call. Labels prefixed workspace_swn_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;
        sub rsp, 8;

        mov rbx, rdi;                     // from_wksp
        mov r12, rsi;                     // to_wksp
        mov r13, rdx;                     // seat
        mov r14, rcx;                     // output
        mov r15, r8;                      // timeline
        mov rbp, r9;                      // value

        // (1) from fits in u32.
        mov rdi, rbx;
        call workspace_switch_u32_valid;
        cmp rax, 0;
        je  workspace_swn_bad_from;

        // (2) to fits in u32.
        mov rdi, r12;
        call workspace_switch_u32_valid;
        cmp rax, 0;
        je  workspace_swn_bad_to;

        // (3) from != to.
        cmp rbx, r12;
        je  workspace_swn_same;

        // (4) seat fits in u32.
        mov rdi, r13;
        call workspace_switch_u32_valid;
        cmp rax, 0;
        je  workspace_swn_bad_seat;

        // (5) output fits in u32.
        mov rdi, r14;
        call workspace_switch_u32_valid;
        cmp rax, 0;
        je  workspace_swn_bad_output;

        // (6) from workspace exists.
        mov rdi, rbx;
        call workspace_switch_wksp_find;
        mov r10, 0xFFFFEBB0;              // WS_ROW_NONE
        cmp rax, r10;
        je  workspace_swn_from_gone;

        // (7) to workspace exists.
        mov rdi, r12;
        call workspace_switch_wksp_find;
        mov r10, 0xFFFFEBB0;              // WS_ROW_NONE
        cmp rax, r10;
        je  workspace_swn_to_gone;

        // (8) Pack word0/word1 in-place.
        //     word0 = from[31:0] | to[63:32]
        mov rax, rbx;
        and rax, 0xFFFFFFFF;
        mov r10, r12;
        and r10, 0xFFFFFFFF;
        shl r10, 32;
        or  rax, r10;
        mov rbx, rax;                     // rbx = word0 (from/to no longer needed)

        //     word1 = seat[31:0] | output[63:32]
        mov rax, r13;
        and rax, 0xFFFFFFFF;
        mov r10, r14;
        and r10, 0xFFFFFFFF;
        shl r10, 32;
        or  rax, r10;
        mov r12, rax;                     // r12 = word1 (seat/output no longer needed)

        // (9) Bump seq counter -> word4 (switch_seq).
        call workspace_switch_seq_next;
        mov r13, rax;                     // r13 = switch_seq

        // tail_alloc(word0=rbx, word1=r12, word2=r15, word3=rbp, word4=r13).
        mov rdi, rbx;
        mov rsi, r12;
        mov rdx, r15;
        mov rcx, rbp;
        mov r8,  r13;
        call workspace_switch_tail_alloc;

        mov r10, 8;
        cmp rax, r10;
        jae workspace_swn_enospc;         // rax already the sentinel

        // Success: bump WS_ST_NEW, preserve row_id across the note call.
        mov rbx, rax;
        mov rdi, 0;                       // WS_ST_NEW
        call workspace_switch_note;
        mov rax, rbx;
        jmp workspace_swn_out;

      workspace_swn_bad_from:
        mov rax, 0xFFFFEBBD;              // WS_NEW_BAD_FROM
        jmp workspace_swn_refused;
      workspace_swn_bad_to:
        mov rax, 0xFFFFEBBC;              // WS_NEW_BAD_TO
        jmp workspace_swn_refused;
      workspace_swn_same:
        mov rax, 0xFFFFEBBB;              // WS_NEW_SAME_WSP
        jmp workspace_swn_refused;
      workspace_swn_bad_seat:
        mov rax, 0xFFFFEBBA;              // WS_NEW_BAD_SEAT
        jmp workspace_swn_refused;
      workspace_swn_bad_output:
        mov rax, 0xFFFFEBB9;              // WS_NEW_BAD_OUTPUT
        jmp workspace_swn_refused;
      workspace_swn_from_gone:
        mov rax, 0xFFFFEBB8;              // WS_NEW_FROM_GONE
        jmp workspace_swn_refused;
      workspace_swn_to_gone:
        mov rax, 0xFFFFEBB7;              // WS_NEW_TO_GONE
        jmp workspace_swn_refused;
      workspace_swn_enospc:
        // rax already WS_TAIL_ENOSPC (0xFFFFEBBF) from tail_alloc.

      workspace_swn_refused:
        mov rbx, rax;                     // stash sentinel
        mov rdi, 2;                       // WS_ST_REFUSED
        call workspace_switch_note;
        mov rax, rbx;

      workspace_swn_out:
        add rsp, 8;
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Section 12  workspace_switch_is_pending / workspace_switch_execute
  //
  // is_pending(row_id): 1 iff cursor < txn.present_timeline_value.
  //     Returns 0 if the row is empty or already committed (a committed
  //     txn is by definition not pending).  Bumps WS_ST_QUERIES once.
  //
  // execute(row_id):
  //   - row_id >= WS_SWITCH_MAX             -> WS_BAD_SLOT
  //   - row empty (word4 == 0)              -> WS_BAD_SLOT
  //   - commit bit already set              -> WS_EXEC_ALREADY
  //   - cursor < txn.value                  -> WS_TIMELINE_STALE
  //   - from workspace revoked since new    -> WS_WORKSPACE_GONE
  //   - to workspace revoked since new      -> WS_WORKSPACE_GONE
  //   - success: rebind from-workspace out to 0, to-workspace out to
  //     txn.output_kind_id, set commit bit LAST, bump WS_ST_EXECUTE_OK,
  //     return WS_OK.
  //
  // The rebind order (from first, then to) is deterministic; a lock-
  // free reader that samples both rows in that same order sees a
  // consistent (pre or post) snapshot on this single-core ring-3 stub.
  // ==========================================================================

  pub let workspace_switch_is_pending : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-05 (#2289): 1 iff row is valid AND not committed AND cursor < txn.present_timeline_value. Two callee-save pushes plus sub rsp,8 = 24 bytes: entry rsp%16==8, +16+8=24 %16==8, sub rsp,8 -> %16==0 for the nested workspace_switch_note call. Labels prefixed workspace_sip_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        mov rbx, rdi;                     // row_id

        // Bump WS_ST_QUERIES.
        mov rdi, 3;                       // WS_ST_QUERIES
        call workspace_switch_note;

        // Validate row.
        mov rdi, rbx;
        call workspace_switch_row_valid;
        cmp rax, 0;
        je  workspace_sip_no;

        // Committed rows are not pending.
        mov rdi, rbx;
        call workspace_switch_row_committed;
        cmp rax, 0;
        jne workspace_sip_no;

        // Load txn.present_timeline_value (word3) and cursor.
        lea r10, [rip + _workspace_switch_table];
        mov r11, rbx;
        imul r11, r11, 40;
        add r10, r11;
        mov r12, [r10 + 24];              // r12 = txn.value

        lea r10, [rip + _workspace_switch_present_cursor];
        mov rax, [r10 + 0];               // rax = cursor
        cmp rax, r12;
        jb  workspace_sip_yes;            // cursor < value -> pending

      workspace_sip_no:
        xor rax, rax;
        jmp workspace_sip_out;
      workspace_sip_yes:
        mov rax, 1;

      workspace_sip_out:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let workspace_switch_execute : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-05 (#2289): six-gate atomic commit. (1) row_id < WS_SWITCH_MAX. (2) row is in_use (word4 != 0). (3) commit bit not already set. (4) present cursor >= txn.present_timeline_value. (5) rebind from-workspace output_kind_id -> 0 (WS_WORKSPACE_GONE if wksp missing). (6) rebind to-workspace output_kind_id -> txn.output_kind_id. (7) set commit bit LAST. Success bumps WS_ST_EXECUTE_OK. Four callee-save pushes plus sub rsp,8 = 40 bytes: entry rsp%16==8, +32+8=40 %16==8, sub rsp,8 -> %16==0 for every nested call. Labels prefixed workspace_sxe_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        sub rsp, 8;

        mov rbx, rdi;                     // row_id

        // (1) row_id < WS_SWITCH_MAX.
        cmp rbx, 8;
        jae workspace_sxe_bad_slot;

        // (2) Row in_use? word4 (switch_seq) != 0.
        lea r10, [rip + _workspace_switch_table];
        mov r11, rbx;
        imul r11, r11, 40;
        add r10, r11;
        mov r12, r10;                     // r12 = row base
        mov rax, [r12 + 32];
        cmp rax, 0;
        je  workspace_sxe_bad_slot;

        // (3) Commit bit already set?
        mov rdi, rbx;
        call workspace_switch_row_committed;
        cmp rax, 0;
        jne workspace_sxe_already;

        // (4) Cursor >= txn.present_timeline_value?
        //     Re-load row base after the nested call (r12 preserved).
        mov rax, [r12 + 24];              // txn.value
        mov r13, rax;                     // r13 = txn.value
        lea r10, [rip + _workspace_switch_present_cursor];
        mov rax, [r10 + 0];               // cursor
        cmp rax, r13;
        jb  workspace_sxe_stale;

        // Extract from / to / output from the row.
        //   word0[31:0]  = from_wksp
        //   word0[63:32] = to_wksp
        //   word1[63:32] = output_kind_id
        mov rax, [r12 + 0];
        mov r13, rax;                     // r13 = word0
        and r13, 0xFFFFFFFF;              // r13 = from_wksp
        mov rax, [r12 + 0];
        shr rax, 32;
        and rax, 0xFFFFFFFF;
        mov r14, rax;                     // r14 = to_wksp
        mov rax, [r12 + 8];
        shr rax, 32;
        and rax, 0xFFFFFFFF;
        // rax = output_kind_id -- stash in the stack scratch slot
        // to free up a register for the two rebind calls.
        mov [rsp + 0], rax;

        // (5) Rebind from-workspace output -> 0.
        mov rdi, r13;
        xor rsi, rsi;
        call workspace_switch_wksp_rebind_output;
        cmp rax, 0;
        jne workspace_sxe_gone;

        // (6) Rebind to-workspace output -> txn.output_kind_id.
        mov rdi, r14;
        mov rsi, [rsp + 0];
        call workspace_switch_wksp_rebind_output;
        cmp rax, 0;
        jne workspace_sxe_gone;

        // (7) Set commit bit LAST (see §4 atomicity note).
        mov rdi, rbx;
        call workspace_switch_row_mark_committed;

        // Bump WS_ST_EXECUTE_OK.
        mov rdi, 1;                       // WS_ST_EXECUTE_OK
        call workspace_switch_note;

        xor rax, rax;                     // WS_OK
        jmp workspace_sxe_out;

      workspace_sxe_bad_slot:
        mov rax, 0xFFFFEBB6;              // WS_BAD_SLOT
        jmp workspace_sxe_refused;
      workspace_sxe_already:
        mov rax, 0xFFFFEBB3;              // WS_EXEC_ALREADY
        jmp workspace_sxe_refused;
      workspace_sxe_stale:
        mov rax, 0xFFFFEBB4;              // WS_TIMELINE_STALE
        jmp workspace_sxe_refused;
      workspace_sxe_gone:
        mov rax, 0xFFFFEBB5;              // WS_WORKSPACE_GONE

      workspace_sxe_refused:
        mov rbx, rax;                     // stash sentinel
        mov rdi, 2;                       // WS_ST_REFUSED
        call workspace_switch_note;
        mov rax, rbx;

      workspace_sxe_out:
        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Section 13  Boot init.
  // ==========================================================================

  pub let workspace_switch_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-05 (#2289): call through to workspace_switch_stats_reset for one clean pool + counter + cursor + committed-flags zero-out. Labels prefixed workspace_si_.",
      block: {
        call workspace_switch_stats_reset;
        ret
      }
    }
}
