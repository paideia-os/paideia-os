// src/user/compositor/keynav_taborder.pdx -- Wave0-B9-10 (paideia-os #2311)
//
// KeynavTaborder -- a11y-derived keyboard tab-order cursor.
//
// The compositor's keyboard-navigation Tab / Shift-Tab handlers advance
// focus by asking THIS module for the next / previous focusable node in
// the a11y tree of the currently-active window. There is NO separate
// "focusable widget list" and NO tab-index annotation on widgets: the
// tab-order is DERIVED (not maintained) from the a11y tree the screen
// reader is already walking.
//
// Companion:
//   * src/user/a11y/tree_kind.pdx (Wave0-B8-03, paideia-os #2302) --
//     KIND_A11Y_TREE. Row_id + arena layout + node_words shape (id,
//     role, parent, first_child, next_sibling, state, label, value).
//     Every accessor this file leans on (a11y_tree_arena_base,
//     a11y_tree_hdr_node_count, a11y_tree_node_addr,
//     a11y_tree_node_role, a11y_tree_node_state,
//     a11y_tree_node_parent, a11y_tree_node_first_child,
//     a11y_tree_node_next_sibling) is a pub let in TreeKind and
//     resolves through the linker's global-symbol table -- the same
//     cross-module call shape src/user/shell.pdx uses against
//     syscall_shim.pdx / dispatch.pdx / tokenizer.pdx.
//
// =============================================================================
// SECTION 0  WHY THIS MODULE EXISTS  --  NOVEL-CLEAN POSTURE
// =============================================================================
//
// A11Y-FIRST TAB-ORDER.  POSIX-shaped toolkits (GTK, Qt, wxWidgets) all
// carry TWO independent "focusable widget" registries: (1) the tab-focus
// chain the Tab key walks, and (2) the a11y tree the screen reader
// walks. Keeping the two in sync is a class of bugs no toolkit has
// eliminated -- a widget that has been marked hidden in the visual
// tree but still lives in the tab chain, or vice versa, silently drops
// the user into an unreachable focus state. The paideia-os compositor
// collapses the two: the a11y tree IS the tab-order source, and the
// visual-focus advance walks it via THIS module. A widget is focusable
// iff (role, state) makes it announceable by a screen reader (§B).
//
// LOGIC MODULE, NOT A KIND.  There is no KIND_KEYNAV_TABORDER cap.
// A TabOrderCursor is a small 16-byte VALUE the compositor thread
// allocates in its own memory (e.g., per-window keyboard-focus state)
// and passes into this module's entry points. The module owns NO global
// state -- no row pool, no arena pool, no stats. The identity being
// walked (the a11y tree) is already a KIND cap with its own row-pool
// discipline (src/user/a11y/tree_kind.pdx); adding a second row-pool
// here would duplicate that authority for zero new capability grant.
// (Compare src/user/compositor/tiling_bsp.pdx, another compositor-
// internal value type that stays out of the KIND slot allocation.)
//
// SEALED BY CONSUMPTION.  Because this module HOLDS no state, there is
// no rights lattice to expose. A caller that reaches this module has
// already dereferenced a KIND_A11Y_TREE row_id (that requires
// RIGHT_A11Y_QUERY_TREE per tree_kind.pdx §A), so the authority check
// happens ONE layer up. Every entry point here is a pure translation
// from (cursor state, a11y-tree geometry) -> (new cursor state, node
// ordinal) and is safe from any observer.
//
// =============================================================================
// SECTION 1  KIND_* SLOT ALLOCATION
// =============================================================================
//
// N/A -- value-type module. No KIND slot is claimed. See §0 rationale.
//
// =============================================================================
// SECTION 2  TABORDERCURSOR LAYOUT  (16 BYTES = 2 x u64)
// =============================================================================
//
// One cursor tracks ONE reader-view walk over ONE a11y tree. The caller
// allocates the 16-byte cursor in its own memory (typically inside a
// per-window keyboard-focus state block) and holds it across Tab
// keystrokes.
//
//   [+0]  cursor_word0:  a11y_tree_kind_id[31:0] | current_node_id[63:32]
//   [+8]  cursor_word1:  direction[7:0] | reserved[63:8]
//
// Fields:
//   a11y_tree_kind_id: u32   -- KIND_A11Y_TREE row_id (0..A11Y_MAX-1 in
//                               tree_kind.pdx). Fixed at init; identifies
//                               which tree this cursor walks.
//   current_node_id: u32     -- last-returned focusable node ordinal, or
//                               KEYNAV_INDEX_NONE (0xFFFFFFFF) meaning
//                               "not yet advanced" / "no focusable node
//                               in this tree at all".
//   direction: u8            -- KEYNAV_DIR_FORWARD(0) or
//                               KEYNAV_DIR_BACKWARD(1). Purely
//                               informational -- next() / prev() ignore
//                               it and instead use the direction implied
//                               by the entry-point name. The field
//                               exists for debug / observer inspection
//                               so a paused walk can be re-anchored in
//                               the same direction it was moving.
//
// The cursor is COPYABLE: two cursors on the same tree that hold the
// same (current_node_id, direction) are indistinguishable. A cursor
// does NOT hold a strong reference to the tree; a caller that
// invalidates the tree (window destroy -> a11y_tree_revoke) MUST discard
// or re-initialise any cursor pointing at it (behaviour of a
// dangling-slot cursor: next()/prev() return KEYNAV_INDEX_NONE via the
// KEYNAV_TAB_BAD_TREE fall-through of a11y_tree_arena_base).
//
// =============================================================================
// SECTION 3  DFS PRE-ORDER TRAVERSAL SEMANTICS
// =============================================================================
//
// "Tree-DFS order" == PRE-ORDER walk of the a11y tree via
// (first_child, next_sibling) pointers (tree_kind.pdx §4.2). Root is
// visited first; each node's children (in first_child chain order)
// come immediately after that node; the walk exits a subtree via
// next_sibling of the deepest visited ancestor.
//
// FORWARD SUCCESSOR (dfs_next_ordinal):
//   1. if node.first_child != NONE  -> return first_child
//   2. else walk (node, node.parent, ...) upward until we find a node
//      whose next_sibling != NONE; return that next_sibling.
//   3. else return KEYNAV_INDEX_NONE (end of pre-order walk).
//
// BACKWARD PREDECESSOR (dfs_prev_ordinal):
//   1. Find prev_sibling by scanning node.parent.first_child chain for
//      the entry whose next_sibling == node. If found, descend to its
//      deepest-last node (recursively: walk first_child then the
//      next_sibling chain to the tail, then repeat). Return that
//      deepest-last.
//   2. else return node.parent (may be KEYNAV_INDEX_NONE at the root).
//
// FOCUSABILITY FILTER (§B):
//   A node is focusable iff:
//     * role in { BUTTON, TEXTBOX, CHECKBOX, LIST_ITEM, LINK,
//                 MENU_ITEM } (six roles taken from AccessKit's core
//       interactive vocabulary), AND
//     * (state & (STATE_HIDDEN | STATE_DISABLED)) == 0.
//
// keynav_taborder_next walks the DFS successor chain, skipping non-
// focusable nodes, until it either finds one or exhausts the tree.
// On exhaustion the walk WRAPS to the first focusable node in the
// tree (find_first_focusable, DFS pre-order). If the tree contains
// zero focusable nodes at all, the return is KEYNAV_INDEX_NONE and
// current_node_id is left at KEYNAV_INDEX_NONE.
//
// keynav_taborder_prev mirrors: walks predecessor, wraps to last
// focusable (deepest-last of root) on exhaustion.
//
// CHILD-CHAIN ORDER NOTE.  Per tree_kind.pdx §4.2, a11y_tree_append_node
// PREPENDS to the parent's first_child list, so the first_child chain
// is in REVERSE INSERTION ORDER at the storage layer. That mismatch is
// the a11y tree's problem to resolve (screen readers doing presentation-
// order walks re-sort at the boundary); THIS module walks whatever
// storage order the tree exposes, so a future switch from prepend-child
// to append-child in tree_kind.pdx does not require any change here.
//
// TERMINATION.  Each next() / prev() invocation caps its focusability
// scan at A11Y_MAX_NODES(32) iterations. A malformed tree that violates
// tree_kind.pdx's parent<child topological invariant cannot loop this
// module forever; the scan just returns KEYNAV_INDEX_NONE after visiting
// every valid ordinal.
//
// =============================================================================
// SECTION 4  FAILURE TAXONOMY  0xFFFFEB90..0xFFFFEB9F
// =============================================================================
//
// The task row hinted at 0xFFFFEC00..0xFFFFEC0F for this landing, but a
// repo-wide grep at landing time
// (`grep -rhoE '0xFFFFEC0[0-9A-Fa-f]' src/`) shows that band is fully
// claimed by KIND_ELEVATE_CHANNEL (0xFFFFEC00..0xFFFFEC0F -- see
// src/kernel/core/elevate_channel.pdx + design/security/elevate-broker.
// md). Falling back to the tree_kind.pdx (Wave0-B8-03) precedent: when
// the task-row's band is claimed, pick the next free 16-slot band and
// note the substitution in the header. Repo-wide grep at landing time
// shows 0xFFFFEB81..0xFFFFEBE9 is a 90-slot free run (last band-close
// at 0xFFFFEB80 = kind_a11y_tree's neighbourhood ceiling, next
// band-open at 0xFFFFEBEA); the low 16 of that run -- 0xFFFFEB90..
// 0xFFFFEB9F -- become this module's failure band. Adjacent to the
// a11y tree's own 0xFFFFEB70..0xFFFFEB7F band, which keeps the wider
// "a11y+keynav" family contiguous within the EBxx page.
//
// Every sentinel fits in imm32 for `mov reg, imm32`.
//
// =============================================================================
// SECTION 5  FINGERPRINT
// =============================================================================
//
// One data-only tag ending `[legacy: KEYNAV TABORDER META OK]` per
// softarch fingerprint discipline (see kind_a11y_tree /
// kind_layer_tree / kind_tiling_bsp precedent). At this landing the
// tag is DECLARED only -- the emit body (klog_s1 at compositor init
// time, alongside a11y_tree_init) lands in the follow-on compositor
// wire-up landing. tools/verify-fingerprint-coverage.sh allowlisting
// with reason "keynav_taborder meta emit body not yet landed
// (Wave0-B9-10)" is a separate one-file landing per the batch's
// file-touch discipline (this landing is ONE file only, matching the
// pattern kind_a11y_tree.pdx set for Wave0-B8-03).
//
// LABEL PREFIX: `keynav_taborder_` throughout -- avoids paideia-as
// reserved-keyword collisions per feedback_paideia_as_reserved_labels;
// all ASM jump targets are `keynav_taborder_<funcname>_<tag>`.

module KeynavTaborder = structure {

  // ==========================================================================
  // SECTION A  Identity + failure taxonomy + sentinels.
  // ==========================================================================

  // Direction discriminant (informational; §2).
  pub let KEYNAV_DIR_FORWARD    : u64 = 0
  pub let KEYNAV_DIR_BACKWARD   : u64 = 1
  pub let KEYNAV_DIR_MAX        : u64 = 1

  // "No such node" sentinel. Reuses the same u32 saturation value the
  // a11y tree uses for A11Y_INDEX_NONE so a cursor whose current_node_id
  // is NONE round-trips through tree_kind.pdx accessors as a NONE-node.
  pub let KEYNAV_INDEX_NONE     : u64 = 0xFFFFFFFF

  // Maximum nodes per tree; mirrors A11Y_MAX_NODES (tree_kind.pdx §3).
  // Used to cap the focusability scan so a malformed tree cannot loop
  // this module (§3 TERMINATION).
  pub let KEYNAV_MAX_NODES      : u64 = 32

  // Cursor field byte offsets (within the caller-allocated 16-byte
  // TabOrderCursor).
  pub let KEYNAV_OFF_WORD0      : u64 = 0
  pub let KEYNAV_OFF_WORD1      : u64 = 8
  pub let KEYNAV_CURSOR_BYTES   : u64 = 16

  // A11yRole ordinals we filter on (copied out of tree_kind.pdx §A;
  // the ROLE_* constants there are the canonical source). Kept in a
  // local const block so this file compiles without importing TreeKind
  // -- the six values below are stable-by-shape (append-only enum in
  // tree_kind.pdx §A) and any future extension of AccessKit roles that
  // WOULD add to the focusable set (SPINBOX, SLIDER, TAB, ...) lands
  // here as an added `cmp` in keynav_taborder_role_focusable.
  pub let KEYNAV_ROLE_BUTTON    : u64 = 2
  pub let KEYNAV_ROLE_TEXTBOX   : u64 = 4
  pub let KEYNAV_ROLE_CHECKBOX  : u64 = 5
  pub let KEYNAV_ROLE_LIST_ITEM : u64 = 7
  pub let KEYNAV_ROLE_LINK      : u64 = 8
  pub let KEYNAV_ROLE_MENU_ITEM : u64 = 10

  // A11yState bits we filter on (copied out of tree_kind.pdx §A).
  // HIDDEN removes the node from the reader-view entirely; DISABLED
  // marks it as non-interactive. Either bit set -> not focusable.
  pub let KEYNAV_STATE_DISABLED : u64 = 0x02
  pub let KEYNAV_STATE_HIDDEN   : u64 = 0x04
  pub let KEYNAV_STATE_FILTER   : u64 = 0x06        // HIDDEN | DISABLED

  // Failure taxonomy -- 0xFFFFEB90..0xFFFFEB9F (see file header §4).
  pub let KEYNAV_TAB_OK             : u64 = 0
  pub let KEYNAV_TAB_BAD_TREE       : u64 = 0xFFFFEB9F  // arena_base zero.
  pub let KEYNAV_TAB_EMPTY_TREE     : u64 = 0xFFFFEB9E  // node_count == 0.
  pub let KEYNAV_TAB_NO_FOCUSABLE   : u64 = 0xFFFFEB9D  // 0 focusable nodes.
  pub let KEYNAV_TAB_BAD_DIR        : u64 = 0xFFFFEB9C  // dir > MAX.
  pub let KEYNAV_TAB_BAD_CURSOR     : u64 = 0xFFFFEB9B  // NULL cursor_ptr.
  pub let KEYNAV_TAB_BAD_TREE_ID    : u64 = 0xFFFFEB9A  // tree_kind_id out of range.

  // ==========================================================================
  // SECTION B  Fingerprint (data-only at this landing; see file header §5).
  // ==========================================================================
  //
  // "pdx kind keynav taborder meta [legacy: KEYNAV TABORDER META OK]\0"
  //  = 63 bytes of payload + 1 NUL terminator = 64 bytes total.
  pub let pdx_kind_keynav_taborder_meta : [u8; 64] = "pdx kind keynav taborder meta [legacy: KEYNAV TABORDER META OK]\0"

  // ==========================================================================
  // SECTION C  Cursor field accessors (packers + readers + writers).
  //
  // The cursor is a caller-owned 16-byte value; every accessor takes a
  // cursor_ptr (u64 pointer to the first byte). All shifts / masks stay
  // encoder-conservative: no `mov_b`, no `add reg, [mem]`, no `test`.
  // ==========================================================================

  // keynav_taborder_pack_word0(tree_kind_id, current_node_id) -> u64.
  // Packs cursor word 0 = tree_kind_id[31:0] | current_node_id[63:32].
  pub let keynav_taborder_pack_word0 : (u64, u64) -> u64 !{} @{} =
    fn (tree_kind_id: u64) (current_node_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B9-10 (paideia-os #2311): pack cursor_word0 = tree_kind_id[31:0] | current_node_id[63:32]. Both inputs masked to u32 before OR. Labels prefixed keynav_taborder_p0_.",
      block: {
        mov rax, rdi;
        and rax, 0xFFFFFFFF;
        mov r10, rsi;
        and r10, 0xFFFFFFFF;
        shl r10, 32;
        or  rax, r10;
        ret
      }
    }

  // keynav_taborder_pack_word1(direction) -> u64.
  // Packs cursor word 1 = direction[7:0] | reserved[63:8].
  pub let keynav_taborder_pack_word1 : (u64) -> u64 !{} @{} =
    fn (direction: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B9-10 (paideia-os #2311): pack cursor_word1 = direction[7:0] | reserved. Reserved bits 8..63 held zero for future expansion. Labels prefixed keynav_taborder_p1_.",
      block: {
        mov rax, rdi;
        and rax, 0xFF;
        ret
      }
    }

  // keynav_taborder_cursor_tree(cursor_ptr) -> u32 tree_kind_id.
  pub let keynav_taborder_cursor_tree : (u64) -> u64 !{mem} @{} =
    fn (cursor_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-10 (paideia-os #2311): read tree_kind_id from cursor_word0[31:0]. Labels prefixed keynav_taborder_ct_.",
      block: {
        mov rax, [rdi + 0];
        and rax, 0xFFFFFFFF;
        ret
      }
    }

  // keynav_taborder_cursor_current(cursor_ptr) -> u32 current_node_id.
  pub let keynav_taborder_cursor_current : (u64) -> u64 !{mem} @{} =
    fn (cursor_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-10 (paideia-os #2311): read current_node_id from cursor_word0[63:32]. Labels prefixed keynav_taborder_cc_.",
      block: {
        mov rax, [rdi + 0];
        shr rax, 32;
        ret
      }
    }

  // keynav_taborder_cursor_dir(cursor_ptr) -> u8 direction.
  pub let keynav_taborder_cursor_dir : (u64) -> u64 !{mem} @{} =
    fn (cursor_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-10 (paideia-os #2311): read direction from cursor_word1[7:0]. Labels prefixed keynav_taborder_cd_.",
      block: {
        mov rax, [rdi + 8];
        and rax, 0xFF;
        ret
      }
    }

  // keynav_taborder_cursor_set_current(cursor_ptr, node_id) -> ().
  // Overwrites current_node_id preserving tree_kind_id in cursor_word0.
  pub let keynav_taborder_cursor_set_current : (u64, u64) -> () !{mem} @{} =
    fn (cursor_ptr: u64) (node_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-10 (paideia-os #2311): rewrite cursor_word0[63:32] = node_id (u32-masked), preserving cursor_word0[31:0] = tree_kind_id. Labels prefixed keynav_taborder_csc_.",
      block: {
        mov rax, [rdi + 0];
        and rax, 0xFFFFFFFF;           // preserve tree_kind_id
        mov r10, rsi;
        and r10, 0xFFFFFFFF;
        shl r10, 32;
        or  rax, r10;
        mov [rdi + 0], rax;
        ret
      }
    }

  // keynav_taborder_cursor_set_dir(cursor_ptr, direction) -> ().
  pub let keynav_taborder_cursor_set_dir : (u64, u64) -> () !{mem} @{} =
    fn (cursor_ptr: u64) (direction: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-10 (paideia-os #2311): rewrite cursor_word1[7:0] = direction (u8-masked), clearing reserved bits 8..63. Labels prefixed keynav_taborder_csd_.",
      block: {
        mov rax, rsi;
        and rax, 0xFF;
        mov [rdi + 8], rax;
        ret
      }
    }

  // ==========================================================================
  // SECTION D  Focusability predicates.
  //
  // A node is focusable iff its role is one of the six interactive
  // AccessKit roles AND neither STATE_HIDDEN nor STATE_DISABLED is set.
  // (See file header §3.)
  // ==========================================================================

  // keynav_taborder_role_focusable(role) -> 1 iff role in the interactive
  // AccessKit subset {BUTTON, TEXTBOX, CHECKBOX, LIST_ITEM, LINK,
  // MENU_ITEM}. Six explicit `cmp` compares -- an add-a-role extension
  // (SPINBOX, SLIDER, TAB) adds one line here and nothing else.
  pub let keynav_taborder_role_focusable : (u64) -> u64 !{} @{} =
    fn (role: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B9-10 (paideia-os #2311): 1 iff role in {BUTTON(2), TEXTBOX(4), CHECKBOX(5), LIST_ITEM(7), LINK(8), MENU_ITEM(10)}. Six explicit compares against imm8 values -- append-only for a future role addition. Labels prefixed keynav_taborder_rf_.",
      block: {
        cmp rdi, 2;
        je  keynav_taborder_rf_yes;
        cmp rdi, 4;
        je  keynav_taborder_rf_yes;
        cmp rdi, 5;
        je  keynav_taborder_rf_yes;
        cmp rdi, 7;
        je  keynav_taborder_rf_yes;
        cmp rdi, 8;
        je  keynav_taborder_rf_yes;
        cmp rdi, 10;
        je  keynav_taborder_rf_yes;
        xor rax, rax;
        ret;
      keynav_taborder_rf_yes:
        mov rax, 1;
        ret
      }
    }

  // keynav_taborder_state_focusable(state) -> 1 iff (state & (HIDDEN
  // | DISABLED)) == 0. Bits 8..63 of the state byte are ignored per
  // tree_kind.pdx §A future-reservation.
  pub let keynav_taborder_state_focusable : (u64) -> u64 !{} @{} =
    fn (state: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B9-10 (paideia-os #2311): 1 iff (state & (HIDDEN(0x04) | DISABLED(0x02))) == 0. Uses and+cmp per G4 (no test). Labels prefixed keynav_taborder_sf_.",
      block: {
        mov rax, rdi;
        mov r10, 0x06;                 // HIDDEN | DISABLED
        and rax, r10;
        cmp rax, 0;
        jne keynav_taborder_sf_no;
        mov rax, 1;
        ret;
      keynav_taborder_sf_no:
        xor rax, rax;
        ret
      }
    }

  // keynav_taborder_is_focusable(node_base) -> 1 iff BOTH role AND
  // state make the node focusable. Reads role from node_words0[39:32]
  // and state from node_words2[39:32] directly -- inlining the a11y
  // node layout knowledge here (tree_kind.pdx §4.2) avoids two nested
  // cross-module calls per test. This is the hot-path predicate on
  // the DFS scan, so keeping it call-free matters.
  pub let keynav_taborder_is_focusable : (u64) -> u64 !{mem} @{} =
    fn (node_base: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-10 (paideia-os #2311): combined predicate. Inlines the raw shifted loads for node_role / node_state to avoid two nested cross-module accessor calls per iteration on the DFS focusability scan. ONE callee-save push (rbx=node_base): entry rsp%16==8, one 8-byte push gives rsp%16==0 -- the value every nested `call` needs at the callsite. rbx alone is sufficient because rbx (callee-save) survives both role_focusable and state_focusable, and role does not need to be preserved across the second call. Labels prefixed keynav_taborder_if_.",
      block: {
        push rbx;

        mov  rbx, rdi;                 // node_base (callee-save)

        // Read role from node_words0[39:32]: [rbx+0] >> 32 & 0xFF.
        mov  rax, [rbx + 0];
        shr  rax, 32;
        and  rax, 0xFF;

        // Role gate.
        mov  rdi, rax;
        call keynav_taborder_role_focusable;
        cmp  rax, 0;
        je   keynav_taborder_if_no;

        // Read state from node_words2[39:32]: [rbx+16] >> 32 & 0xFF.
        mov  rax, [rbx + 16];
        shr  rax, 32;
        and  rax, 0xFF;

        // State gate.
        mov  rdi, rax;
        call keynav_taborder_state_focusable;
        cmp  rax, 0;
        je   keynav_taborder_if_no;

        mov  rax, 1;
        jmp  keynav_taborder_if_out;

      keynav_taborder_if_no:
        xor  rax, rax;

      keynav_taborder_if_out:
        pop  rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION E  Raw DFS successor / predecessor helpers.
  //
  // These operate on the a11y tree's stored (first_child, next_sibling,
  // parent) pointers WITHOUT any focusability filter. The next/prev
  // entry points wrap them in a bounded focusability scan (§F).
  //
  // arena_base is the KIND_A11Y_TREE arena pointer returned by
  // a11y_tree_arena_base(row_id). node_id is the u32 ordinal to move
  // FROM; the returned ordinal is either the DFS successor / predecessor
  // or KEYNAV_INDEX_NONE if we walked past the endpoint of the tree.
  // ==========================================================================

  // keynav_taborder_dfs_next(arena_base, node_id) -> u32 successor
  //                                                | KEYNAV_INDEX_NONE.
  //
  // Pre-order successor: first_child if present, else uphill until we
  // find a next_sibling, else NONE.
  //
  // Three callee-save pushes (rbx=arena_base, r12=node_id, r13=scratch)
  // + entry rsp%16==8 => rsp%16==0 after prologue; every nested call
  // is naturally aligned.
  pub let keynav_taborder_dfs_next : (u64, u64) -> u64 !{mem} @{} =
    fn (arena_base: u64) (node_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-10 (paideia-os #2311): DFS pre-order successor. Uses first_child else uphill-next_sibling; NONE at end-of-tree. Three callee-save pushes leave rsp%16==0 for nested a11y_tree_node_addr/first_child/next_sibling/parent calls. Labels prefixed keynav_taborder_dn_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov  rbx, rdi;                 // arena_base
        mov  r12, rsi;                 // node_id

        // NONE input -> NONE output.
        mov  r10, 0xFFFFFFFF;
        cmp  r12, r10;
        je   keynav_taborder_dn_none;

        // node_base = a11y_tree_node_addr(arena_base, node_id).
        mov  rdi, rbx;
        mov  rsi, r12;
        call a11y_tree_node_addr;
        mov  r13, rax;                 // r13 = node_base

        // Step 1: first_child?
        mov  rdi, r13;
        call a11y_tree_node_first_child;
        mov  r10, 0xFFFFFFFF;
        cmp  rax, r10;
        jne  keynav_taborder_dn_out;   // rax already holds the successor

        // Step 2: walk uphill (node, parent, grandparent, ...) looking
        //         for a next_sibling.
      keynav_taborder_dn_uphill:
        // Load node_base for the current r12.
        mov  rdi, rbx;
        mov  rsi, r12;
        call a11y_tree_node_addr;
        mov  r13, rax;

        // Try node.next_sibling.
        mov  rdi, r13;
        call a11y_tree_node_next_sibling;
        mov  r10, 0xFFFFFFFF;
        cmp  rax, r10;
        jne  keynav_taborder_dn_out;   // rax holds the successor

        // Else move to parent and retry.
        mov  rdi, r13;
        call a11y_tree_node_parent;
        mov  r12, rax;
        cmp  r12, r10;
        jne  keynav_taborder_dn_uphill;

        // Fell out the top: end-of-tree.
      keynav_taborder_dn_none:
        mov  rax, 0xFFFFFFFF;

      keynav_taborder_dn_out:
        pop  r13;
        pop  r12;
        pop  rbx;
        ret
      }
    }

  // keynav_taborder_dfs_descend_last(arena_base, node_id) -> u32
  //     deepest-last descendant of node_id (inclusive).
  //
  // Repeatedly walk first_child, then follow the next_sibling chain to
  // its tail. Returns the input node_id if it has no children. Bounded
  // by KEYNAV_MAX_NODES(32) at each descent step to keep a malformed
  // (cyclic) tree from spinning.
  pub let keynav_taborder_dfs_descend_last : (u64, u64) -> u64 !{mem} @{} =
    fn (arena_base: u64) (node_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-10 (paideia-os #2311): descend to the pre-order-last descendant of node_id (inclusive). Four callee-save pushes (rbx=arena_base, r12=node_id, r13=node_base scratch, r14=outer descent counter). NO nested calls in the body (all node-field accesses are inlined raw shifted loads to keep the tight loop call-free), so post-prologue rsp alignment is irrelevant here. Outer descent bounded by KEYNAV_MAX_NODES(32); inner sibling-tail walk also bounded by KEYNAV_MAX_NODES via caller-save rcx (safe to keep caller-save because the inner loop contains no calls either). Labels prefixed keynav_taborder_dl_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov  rbx, rdi;                 // arena_base
        mov  r12, rsi;                 // node_id

        mov  r10, 0xFFFFFFFF;
        cmp  r12, r10;
        je   keynav_taborder_dl_out;   // NONE stays NONE (rax=r12 below)

        // Outer descent counter r14 = 0..KEYNAV_MAX_NODES.
        xor  r14, r14;
      keynav_taborder_dl_descend:
        mov  r10, 32;
        cmp  r14, r10;
        jae  keynav_taborder_dl_out;   // hit safety cap; return current r12

        // node_base = arena_base + 32 + node_id * 32 (inlined; avoids
        // a nested a11y_tree_node_addr call in the tight loop).
        mov  r13, r12;
        shl  r13, 5;
        add  r13, rbx;
        add  r13, 32;

        // first_child = [node_base + 8] >> 32.
        mov  rax, [r13 + 8];
        shr  rax, 32;

        mov  r10, 0xFFFFFFFF;
        cmp  rax, r10;
        je   keynav_taborder_dl_out;   // leaf: r12 IS the descend-last

        // rax = first_child; walk sibling chain to the tail.
        mov  r12, rax;                 // r12 = current sibling
        xor  rcx, rcx;                 // inner-sibling counter
      keynav_taborder_dl_sib:
        mov  r10, 32;
        cmp  rcx, r10;
        jae  keynav_taborder_dl_descend_next;  // safety cap; use current r12

        // sib_base = arena_base + 32 + r12 * 32.
        mov  r8, r12;
        shl  r8, 5;
        add  r8, rbx;
        add  r8, 32;

        // next_sibling = [sib_base + 16] & 0xFFFFFFFF.
        mov  rax, [r8 + 16];
        and  rax, 0xFFFFFFFF;

        mov  r10, 0xFFFFFFFF;
        cmp  rax, r10;
        je   keynav_taborder_dl_descend_next;  // no more siblings; r12 is tail

        mov  r12, rax;                 // advance to next sibling
        add  rcx, 1;
        jmp  keynav_taborder_dl_sib;

      keynav_taborder_dl_descend_next:
        add  r14, 1;
        jmp  keynav_taborder_dl_descend;

      keynav_taborder_dl_out:
        mov  rax, r12;
        pop  r14;
        pop  r13;
        pop  r12;
        pop  rbx;
        ret
      }
    }

  // keynav_taborder_dfs_prev(arena_base, node_id) -> u32 predecessor
  //                                                | KEYNAV_INDEX_NONE.
  //
  // Pre-order predecessor: prev_sibling.descend_last if prev_sibling
  // exists, else parent (may be NONE at root).
  //
  // prev_sibling: scan parent.first_child chain for the entry whose
  // next_sibling == node_id. If node_id IS the parent's first_child,
  // there is no prev_sibling.
  pub let keynav_taborder_dfs_prev : (u64, u64) -> u64 !{mem} @{} =
    fn (arena_base: u64) (node_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-10 (paideia-os #2311): DFS pre-order predecessor. Five callee-save pushes (rbx=arena_base, r12=node_id, r13=parent_id, r14=cursor, r15=scratch_base): entry rsp%16==8, five 8-byte pushes give rsp%16==0 -- naturally aligned for the one nested call (dfs_descend_last). rbx, r12, r13, r14 all need callee-save preservation across that call (r13 is the fallback-parent return value; r14 could be caller-save since it is only read into rsi before the call and never used after, but keeping it in r14 makes the scan loop's `mov r14, rax` pattern uniform with the DFS scans elsewhere). rcx safety counter is safe here: the scan loop body contains NO nested calls (the ONE call, dfs_descend_last, occurs at the found-case exit, followed by unconditional jmp to out). Labels prefixed keynav_taborder_dp_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov  rbx, rdi;                 // arena_base
        mov  r12, rsi;                 // node_id

        mov  r10, 0xFFFFFFFF;
        cmp  r12, r10;
        je   keynav_taborder_dp_none;

        // Load current node's parent_id.
        mov  r15, r12;
        shl  r15, 5;
        add  r15, rbx;
        add  r15, 32;                  // node_base = arena+32+id*32
        mov  rax, [r15 + 8];
        and  rax, 0xFFFFFFFF;          // parent[31:0]
        mov  r13, rax;                 // r13 = parent_id

        mov  r10, 0xFFFFFFFF;
        cmp  r13, r10;
        je   keynav_taborder_dp_none;  // root: no predecessor -> NONE

        // parent_base = arena_base + 32 + parent_id * 32.
        mov  r15, r13;
        shl  r15, 5;
        add  r15, rbx;
        add  r15, 32;

        // r14 = parent.first_child.
        mov  rax, [r15 + 8];
        shr  rax, 32;
        mov  r14, rax;

        // If r14 == node_id: no prev_sibling -> return parent.
        cmp  r14, r12;
        je   keynav_taborder_dp_ret_parent;

        // Otherwise walk sibling chain looking for the entry whose
        // next_sibling == node_id. r14 holds the running "candidate
        // prev-sibling"; rcx bounds the scan.
        xor  rcx, rcx;                 // safety counter (loop-local; no calls in body)
      keynav_taborder_dp_scan:
        mov  r10, 32;
        cmp  rcx, r10;
        jae  keynav_taborder_dp_ret_parent;  // fell out; degrade to parent

        // r14 may itself equal NONE if the chain terminates before we
        // find node_id -- degrade to parent in that case too.
        mov  r10, 0xFFFFFFFF;
        cmp  r14, r10;
        je   keynav_taborder_dp_ret_parent;

        // sib_base = arena + 32 + r14 * 32.
        mov  r15, r14;
        shl  r15, 5;
        add  r15, rbx;
        add  r15, 32;

        // rax = sib.next_sibling.
        mov  rax, [r15 + 16];
        and  rax, 0xFFFFFFFF;

        cmp  rax, r12;
        jne  keynav_taborder_dp_advance;

        // Found: r14 is prev_sibling. Descend to its pre-order-last.
        mov  rdi, rbx;
        mov  rsi, r14;
        call keynav_taborder_dfs_descend_last;
        jmp  keynav_taborder_dp_out;

      keynav_taborder_dp_advance:
        mov  r14, rax;                 // walk to next sibling
        add  rcx, 1;
        jmp  keynav_taborder_dp_scan;

      keynav_taborder_dp_ret_parent:
        mov  rax, r13;
        jmp  keynav_taborder_dp_out;

      keynav_taborder_dp_none:
        mov  rax, 0xFFFFFFFF;

      keynav_taborder_dp_out:
        pop  r15;
        pop  r14;
        pop  r13;
        pop  r12;
        pop  rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION F  Focusable-node finders (first / last / next / prev).
  //
  // find_first_focusable and find_last_focusable are the "wrap targets"
  // for the entry-point next/prev. All four scans are bounded by
  // KEYNAV_MAX_NODES(32).
  // ==========================================================================

  // keynav_taborder_find_first_focusable(arena_base) -> u32
  //     first focusable node in DFS pre-order | KEYNAV_INDEX_NONE.
  //
  // Starts at root, walks dfs_next until a focusable is found, or the
  // walk hits KEYNAV_INDEX_NONE. Root itself is checked first.
  pub let keynav_taborder_find_first_focusable : (u64) -> u64 !{mem} @{} =
    fn (arena_base: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-10 (paideia-os #2311): DFS-first focusable node. Three callee-save pushes (rbx=arena_base, r12=node_id, r13=scratch_node_base): entry rsp%16==8, three 8-byte pushes give rsp%16==0 -- the value every nested `call` needs at the callsite. No sub rsp,8 pad required. rcx (caller-save) as safety counter is safe: every nested call clobbers rcx but we re-load bounds from imm32 immediately before each compare. Scan bounded by KEYNAV_MAX_NODES(32). Labels prefixed keynav_taborder_ff_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov  rbx, rdi;                 // arena_base

        // Start at root: r12 = a11y_tree_hdr_root_node_id(arena_base).
        mov  rdi, rbx;
        call a11y_tree_hdr_root_node_id;
        mov  r12, rax;

      keynav_taborder_ff_scan:
        // Terminate when dfs_next hands back the end-of-tree sentinel.
        // Bounded implicitly by the a11y tree's finite node_count --
        // dfs_next visits each node at most once in pre-order before
        // returning KEYNAV_INDEX_NONE.
        mov  r10, 0xFFFFFFFF;
        cmp  r12, r10;
        je   keynav_taborder_ff_none;

        // node_base = arena + 32 + r12*32 (inline).
        mov  r13, r12;
        shl  r13, 5;
        add  r13, rbx;
        add  r13, 32;

        // Check focusability.
        mov  rdi, r13;
        call keynav_taborder_is_focusable;
        cmp  rax, 0;
        jne  keynav_taborder_ff_hit;

        // Advance DFS.
        mov  rdi, rbx;
        mov  rsi, r12;
        call keynav_taborder_dfs_next;
        mov  r12, rax;
        jmp  keynav_taborder_ff_scan;

      keynav_taborder_ff_hit:
        mov  rax, r12;
        jmp  keynav_taborder_ff_out;

      keynav_taborder_ff_none:
        mov  rax, 0xFFFFFFFF;

      keynav_taborder_ff_out:
        pop  r13;
        pop  r12;
        pop  rbx;
        ret
      }
    }

  // keynav_taborder_find_last_focusable(arena_base) -> u32
  //     last focusable node in DFS pre-order | KEYNAV_INDEX_NONE.
  //
  // Start at the pre-order-last of root (dfs_descend_last of root),
  // then walk dfs_prev until a focusable is found or the walk hits
  // NONE.
  pub let keynav_taborder_find_last_focusable : (u64) -> u64 !{mem} @{} =
    fn (arena_base: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-10 (paideia-os #2311): DFS-last focusable node. Starts at dfs_descend_last(root), walks dfs_prev backward. Three callee-save pushes: entry rsp%16==8, three 8-byte pushes give rsp%16==0 -- naturally aligned for every nested call. Termination by dfs_prev returning KEYNAV_INDEX_NONE at start-of-tree; no rcx counter (rcx is caller-save and would be clobbered by is_focusable / dfs_prev, and the tree is finite so pre-order-backward is bounded by node_count regardless). Labels prefixed keynav_taborder_fl_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov  rbx, rdi;                 // arena_base

        // Start at root, descend to its DFS-last leaf.
        mov  rdi, rbx;
        call a11y_tree_hdr_root_node_id;
        mov  r12, rax;

        mov  rdi, rbx;
        mov  rsi, r12;
        call keynav_taborder_dfs_descend_last;
        mov  r12, rax;

      keynav_taborder_fl_scan:
        mov  r10, 0xFFFFFFFF;
        cmp  r12, r10;
        je   keynav_taborder_fl_none;

        // node_base = arena + 32 + r12*32.
        mov  r13, r12;
        shl  r13, 5;
        add  r13, rbx;
        add  r13, 32;

        mov  rdi, r13;
        call keynav_taborder_is_focusable;
        cmp  rax, 0;
        jne  keynav_taborder_fl_hit;

        // Advance backward.
        mov  rdi, rbx;
        mov  rsi, r12;
        call keynav_taborder_dfs_prev;
        mov  r12, rax;
        jmp  keynav_taborder_fl_scan;

      keynav_taborder_fl_hit:
        mov  rax, r12;
        jmp  keynav_taborder_fl_out;

      keynav_taborder_fl_none:
        mov  rax, 0xFFFFFFFF;

      keynav_taborder_fl_out:
        pop  r13;
        pop  r12;
        pop  rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION G  Entry points  --  init / reset / next / prev.
  //
  // These are the four operations a compositor keyboard-focus handler
  // consumes. Every entry point takes a caller-owned cursor_ptr (§2).
  // ==========================================================================

  // keynav_taborder_init(cursor_ptr, tree_kind_id) -> KEYNAV_TAB_OK
  //     | KEYNAV_TAB_BAD_CURSOR | KEYNAV_TAB_BAD_TREE_ID.
  //
  // Writes the cursor with:
  //   tree_kind_id     = tree_kind_id
  //   current_node_id  = first focusable in DFS pre-order (or
  //                      KEYNAV_INDEX_NONE if none exist)
  //   direction        = KEYNAV_DIR_FORWARD (0)
  //
  // Bad tree_kind_id (a11y_tree_arena_base returns 0) leaves the
  // cursor with current_node_id = KEYNAV_INDEX_NONE and returns
  // KEYNAV_TAB_BAD_TREE_ID -- callers that ignore the return still
  // observe a consistent "empty" cursor.
  pub let keynav_taborder_init : (u64, u64) -> u64 !{mem} @{} =
    fn (cursor_ptr: u64) (tree_kind_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-10 (paideia-os #2311): initialise cursor to (tree_kind_id, first_focusable_or_NONE, FORWARD). Three callee-save pushes (rbx=cursor_ptr, r12=tree_kind_id, r13=arena_base): entry rsp%16==8, three 8-byte pushes give rsp%16==0 -- naturally aligned for every nested call. NULL cursor -> KEYNAV_TAB_BAD_CURSOR; bad tree_kind_id (arena_base==0) -> KEYNAV_TAB_BAD_TREE_ID with the cursor left at (tree_kind_id, NONE, FORWARD) so callers that ignore the return still observe a legible empty cursor. Labels prefixed keynav_taborder_i_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov  rbx, rdi;                 // cursor_ptr
        mov  r12, rsi;                 // tree_kind_id

        // NULL cursor?
        cmp  rbx, 0;
        je   keynav_taborder_i_bad_cursor;

        // Stamp direction first (word1 = 0 = FORWARD, plus zeroed
        // reserved bits) so a partial write leaves a legible cursor.
        xor  rax, rax;
        mov  [rbx + 8], rax;

        // Pre-stamp word0 with (tree_kind_id, KEYNAV_INDEX_NONE) so any
        // early-return failure path leaves a walkable-empty cursor.
        mov  rdi, r12;
        mov  rsi, 0xFFFFFFFF;
        call keynav_taborder_pack_word0;
        mov  [rbx + 0], rax;

        // Resolve arena_base for tree_kind_id.
        mov  rdi, r12;
        call a11y_tree_arena_base;
        cmp  rax, 0;
        je   keynav_taborder_i_bad_tree_id;
        mov  r13, rax;

        // find_first_focusable(arena_base) -> current_node_id or NONE.
        mov  rdi, r13;
        call keynav_taborder_find_first_focusable;

        // Store rax (u32-masked) as current_node_id.
        mov  rdi, rbx;
        mov  rsi, rax;
        call keynav_taborder_cursor_set_current;

        xor  rax, rax;                 // KEYNAV_TAB_OK
        jmp  keynav_taborder_i_out;

      keynav_taborder_i_bad_cursor:
        mov  rax, 0xFFFFEB9B;          // KEYNAV_TAB_BAD_CURSOR
        jmp  keynav_taborder_i_out;

      keynav_taborder_i_bad_tree_id:
        mov  rax, 0xFFFFEB9A;          // KEYNAV_TAB_BAD_TREE_ID

      keynav_taborder_i_out:
        pop  r13;
        pop  r12;
        pop  rbx;
        ret
      }
    }

  // keynav_taborder_reset(cursor_ptr) -> KEYNAV_TAB_OK
  //     | KEYNAV_TAB_BAD_CURSOR | KEYNAV_TAB_BAD_TREE_ID.
  //
  // Rewinds current_node_id back to the first focusable node in DFS
  // pre-order. Leaves tree_kind_id and direction untouched.
  pub let keynav_taborder_reset : (u64) -> u64 !{mem} @{} =
    fn (cursor_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-10 (paideia-os #2311): rewind cursor to first focusable node in DFS pre-order. Preserves tree_kind_id and direction. ONE callee-save push (rbx=cursor_ptr): entry rsp%16==8, one 8-byte push gives rsp%16==0 -- naturally aligned for every nested call. tree_kind_id does not need callee-save preservation because it flows directly from cursor_tree's return (rax) into a11y_tree_arena_base's argument (rdi) without any intervening call. Labels prefixed keynav_taborder_r_.",
      block: {
        push rbx;

        mov  rbx, rdi;

        cmp  rbx, 0;
        je   keynav_taborder_r_bad_cursor;

        // Read tree_kind_id from cursor, feed directly into arena_base.
        mov  rdi, rbx;
        call keynav_taborder_cursor_tree;
        mov  rdi, rax;
        call a11y_tree_arena_base;
        cmp  rax, 0;
        je   keynav_taborder_r_bad_tree_id;

        // Find first focusable.
        mov  rdi, rax;
        call keynav_taborder_find_first_focusable;

        // Store back.
        mov  rdi, rbx;
        mov  rsi, rax;
        call keynav_taborder_cursor_set_current;

        xor  rax, rax;
        jmp  keynav_taborder_r_out;

      keynav_taborder_r_bad_cursor:
        mov  rax, 0xFFFFEB9B;
        jmp  keynav_taborder_r_out;

      keynav_taborder_r_bad_tree_id:
        mov  rax, 0xFFFFEB9A;

      keynav_taborder_r_out:
        pop  rbx;
        ret
      }
    }

  // keynav_taborder_next(cursor_ptr) -> u32 new_current_node_id.
  //
  // Advances the cursor to the next focusable node in DFS pre-order.
  // Wrap at end-of-tree returns to the first focusable node
  // (find_first_focusable). If the tree contains ZERO focusable nodes,
  // the cursor is left at KEYNAV_INDEX_NONE and KEYNAV_INDEX_NONE is
  // returned. Also updates cursor.direction = KEYNAV_DIR_FORWARD (0).
  //
  // NULL cursor / bad tree_kind_id => KEYNAV_INDEX_NONE (typed as u32
  // sentinel, since the return type is u32 node_id, not an error
  // sentinel). The error-shape codes are reserved for init/reset paths
  // that don't return node_ids.
  pub let keynav_taborder_next : (u64) -> u64 !{mem} @{} =
    fn (cursor_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-10 (paideia-os #2311): DFS-next focusable node with wrap-to-first. Three callee-save pushes (rbx=cursor_ptr, r12=arena_base, r13=current): entry rsp%16==8, three 8-byte pushes give rsp%16==0 -- naturally aligned for every nested call. Node-base scratch uses caller-save r8 (recomputed each iteration; does not need to survive nested calls). Termination guaranteed by dfs_next eventually returning KEYNAV_INDEX_NONE (a11y tree is finite and every pre-order pass visits each node at most once per tree_kind.pdx §4.2 topological invariant). Labels prefixed keynav_taborder_n_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov  rbx, rdi;                 // cursor_ptr

        cmp  rbx, 0;
        je   keynav_taborder_n_none;

        // Stamp direction = FORWARD (word1 low byte = 0, reserved
        // bits cleared).
        xor  rax, rax;
        mov  [rbx + 8], rax;

        // Read tree_kind_id + resolve arena_base.
        mov  rdi, rbx;
        call keynav_taborder_cursor_tree;
        mov  rdi, rax;
        call a11y_tree_arena_base;
        cmp  rax, 0;
        je   keynav_taborder_n_none;
        mov  r12, rax;                 // arena_base

        // Read current_node_id.
        mov  rdi, rbx;
        call keynav_taborder_cursor_current;
        mov  r13, rax;                 // current

        // If current is NONE, wrap directly to first focusable.
        mov  r10, 0xFFFFFFFF;
        cmp  r13, r10;
        je   keynav_taborder_n_wrap;

      keynav_taborder_n_scan:
        // r13 = dfs_next(arena_base, r13).
        mov  rdi, r12;
        mov  rsi, r13;
        call keynav_taborder_dfs_next;
        mov  r13, rax;

        // r13 == NONE => end-of-tree => wrap.
        mov  r10, 0xFFFFFFFF;
        cmp  r13, r10;
        je   keynav_taborder_n_wrap;

        // node_base = arena + 32 + r13*32. r8 is caller-save; we
        // recompute this every iteration so surviving a call is not
        // required.
        mov  r8, r13;
        shl  r8, 5;
        add  r8, r12;
        add  r8, 32;

        mov  rdi, r8;
        call keynav_taborder_is_focusable;
        cmp  rax, 0;
        jne  keynav_taborder_n_hit;

        jmp  keynav_taborder_n_scan;

      keynav_taborder_n_wrap:
        // find_first_focusable(arena_base).
        mov  rdi, r12;
        call keynav_taborder_find_first_focusable;
        mov  r13, rax;

      keynav_taborder_n_hit:
        // Store r13 as new current_node_id.
        mov  rdi, rbx;
        mov  rsi, r13;
        call keynav_taborder_cursor_set_current;
        mov  rax, r13;
        jmp  keynav_taborder_n_out;

      keynav_taborder_n_none:
        mov  rax, 0xFFFFFFFF;

      keynav_taborder_n_out:
        pop  r13;
        pop  r12;
        pop  rbx;
        ret
      }
    }

  // keynav_taborder_prev(cursor_ptr) -> u32 new_current_node_id.
  //
  // Mirrors keynav_taborder_next in reverse: DFS predecessor, wrap at
  // start-of-tree to find_last_focusable. Stamps cursor.direction =
  // KEYNAV_DIR_BACKWARD (1).
  pub let keynav_taborder_prev : (u64) -> u64 !{mem} @{} =
    fn (cursor_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-10 (paideia-os #2311): DFS-previous focusable node with wrap-to-last. Same three-push shape as keynav_taborder_next; naturally aligned for every nested call. Termination guaranteed by dfs_prev eventually returning KEYNAV_INDEX_NONE at start-of-tree. Direction stamped BACKWARD. Node-base scratch uses caller-save r8. Labels prefixed keynav_taborder_p_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov  rbx, rdi;

        cmp  rbx, 0;
        je   keynav_taborder_p_none;

        // Stamp direction = BACKWARD (word1 = 1).
        mov  rax, 1;
        mov  [rbx + 8], rax;

        mov  rdi, rbx;
        call keynav_taborder_cursor_tree;
        mov  rdi, rax;
        call a11y_tree_arena_base;
        cmp  rax, 0;
        je   keynav_taborder_p_none;
        mov  r12, rax;

        mov  rdi, rbx;
        call keynav_taborder_cursor_current;
        mov  r13, rax;

        mov  r10, 0xFFFFFFFF;
        cmp  r13, r10;
        je   keynav_taborder_p_wrap;

      keynav_taborder_p_scan:
        mov  rdi, r12;
        mov  rsi, r13;
        call keynav_taborder_dfs_prev;
        mov  r13, rax;

        mov  r10, 0xFFFFFFFF;
        cmp  r13, r10;
        je   keynav_taborder_p_wrap;

        mov  r8, r13;
        shl  r8, 5;
        add  r8, r12;
        add  r8, 32;

        mov  rdi, r8;
        call keynav_taborder_is_focusable;
        cmp  rax, 0;
        jne  keynav_taborder_p_hit;

        jmp  keynav_taborder_p_scan;

      keynav_taborder_p_wrap:
        mov  rdi, r12;
        call keynav_taborder_find_last_focusable;
        mov  r13, rax;

      keynav_taborder_p_hit:
        mov  rdi, rbx;
        mov  rsi, r13;
        call keynav_taborder_cursor_set_current;
        mov  rax, r13;
        jmp  keynav_taborder_p_out;

      keynav_taborder_p_none:
        mov  rax, 0xFFFFFFFF;

      keynav_taborder_p_out:
        pop  r13;
        pop  r12;
        pop  rbx;
        ret
      }
    }
}
