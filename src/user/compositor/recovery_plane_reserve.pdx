// src/user/compositor/recovery_plane_reserve.pdx -- Wave0-B6-09 (paideia-os #2269)
//
// KIND_RECOVERY_PLANE = 0x1C8, derived over KIND_DISPLAY_PLANE (= 0x173).
// Design authority: design/compositor/pwp-spec-vocabulary.md §2.17 (line 117),
// design/roadmap/next-wave-osarch.md line 434 (recovery-console reserved plane).
//
// One reservation-shaped capability. The primary plane of pipe 0 is held for
// the recovery console; the reservation itself is minted ONCE at boot by the
// INPUT SERVER process (not svc-compositor), so a compositor lockup can
// never free the plane. Pitfall P8 enforcement: KIND_SCANOUT_LEASE mint
// already refuses `plane_slot == SL_RESERVED_PLANE_SLOT` -- see
// src/kernel/core/cap/kind_scanout_lease.pdx:117 (sl_rp_reserved_plane_check,
// justification "G2.M1-005 (#1447) + P8"). KIND_RECOVERY_PLANE is that slot's
// cap-shaped name: the reservation is a first-class capability the input
// server holds and the compositor CANNOT mint, forge, or revoke.
//
// This file is deliberately RESERVATION-ONLY. The takeover flow -- promoting
// the input server to the display source when compositor death is detected
// -- lands separately at paideia-os #2270 (G7-M6-002). Splitting the two
// keeps the reservation surface auditable in one file: any check that the
// primary plane is held goes through recovery_plane_is_reserved, whose sole
// backing state is the singleton cell defined below.
//
// =============================================================================
// SECTION 0  KIND_* SLOT ALLOCATION
// =============================================================================
//
// KIND_RECOVERY_PLANE = 0x1C8. The freshest live claim near this band is
// KIND_REFERENCE_DISPLAY = 0x1B7 (Wave-0 Batch-1, paideia-os #2240). Wave-0
// Batch-6 is a parallel dispatch; the batch orchestrator handed this landing
// 0x1C8 (well past the 0x1B8..0x1BF used by sibling B6 agents) so no
// cross-agent collision is possible. Kind ordinals must ultimately be
// pinned in design/architecture/next-wave-derived-kinds.md; this file
// declares the value here and the ordinal ledger absorbs it at close of
// Wave-0 Batch-6.
//
// Two forward-reservation ordinals appear in the constants below because
// this reservation cannot be verified against symbols that do not yet
// exist:
//
//   0x1D0  RESERVATION_HOLDER_KIND  -- the input server process cap kind,
//                                      to be minted when the input-server
//                                      landing lands (G8.M1+). This file's
//                                      factory refuses any holder value
//                                      NOT equal to this ordinal, so an
//                                      accidental mint by svc-compositor is
//                                      refused structurally.
//
//   0x1D1  RP_COMPOSITOR_KIND_FORWARD -- the compositor process cap kind,
//                                        also to be minted when the
//                                        compositor process kind lands.
//                                        Belt-and-suspenders: if a future
//                                        edit accidentally aliases the
//                                        holder ordinal to compositor's,
//                                        the second inequality check
//                                        (holder != RP_COMPOSITOR_KIND_
//                                        FORWARD) fires independently.
//
// Both forward ordinals sit adjacent to KIND_RECOVERY_PLANE = 0x1C8 in the
// input-service kind block so a later audit finds them together.
//
// =============================================================================
// SECTION 1  DERIVATION OVER KIND_DISPLAY_PLANE
// =============================================================================
//
// KIND_DISPLAY_PLANE (= 0x173, kernel-minted, see
// design/graphics/r101-kernel-plan.md §4 and next-wave-derived-kinds.md
// §R36) is the kernel's authority over one addressable overlay/primary
// plane on one display pipe. RIGHT_MINT on a KIND_DISPLAY_PLANE cap gates
// derivation of a KIND_RECOVERY_PLANE: only a holder of RIGHT_MINT on the
// primary plane of pipe 0 can create the reservation, and that mint is
// SEALED -- the resulting KIND_RECOVERY_PLANE cap does NOT itself carry
// RIGHT_MINT (see §3), so the reservation cannot deepen into a derived
// tree the compositor could exploit.
//
// KIND_SCANOUT_LEASE (0x188) is the sibling kind on the same primary
// plane: a client with RIGHT_MINT on KIND_DISPLAY_PLANE can normally
// lease it for direct scanout, but SL_MINT_RESERVED (0xFFFFF615, see
// kind_scanout_lease.pdx sl_rp_reserved_plane_check) refuses that lease
// specifically when plane_slot == 0 on pipe 0. The refusal is enforced
// by the kernel-side dispatcher; this file records the cap-shaped name
// of the slot the kernel already refuses to lease.
//
// =============================================================================
// SECTION 2  ROW LAYOUT -- 32 BYTES (SINGLETON CELL)
// =============================================================================
//
// This kind is a SINGLETON -- there is exactly one recovery-plane
// reservation per boot, not a pool of many. The cell layout is four u64
// words:
//
//   [+0]   word0:  pipe_index[31:0]                (must be 0 on pipe 0)
//                | plane_slot[63:32]               (must be SL_RESERVED_
//                                                   PLANE_SLOT = 0)
//   [+8]   word1:  holder_process_kind_id[31:0]    (input server process
//                                                   cap kind)
//                | reserved[63:32]                 (0)
//   [+16]  word2:  reserved_at_boot_seq (u64)      (monotonic, minted from
//                                                   the singleton counter
//                                                   at word4 below)
//   [+24]  word3:  in_use[7:0]                     (0 = free, 1 = reserved)
//                | reserved[63:8]                  (0)
//
// The singleton counter _recovery_plane_boot_seq_counter (one u64) lives
// beside the cell. It is bumped on successful reservation and its value
// at bump-time is the reserved_at_boot_seq witness. rdtsc is deliberately
// NOT used here: rdtsc requires the {sysreg} effect and the kernel-side
// KIND_ landings that use it (kind_volume_snapshot.pdx kvs_row_alloc)
// live in ring 0. The paideia-os user-space discipline is to prefer a
// bumped counter over a hardware timestamp for boot-witness purposes;
// the monotonicity guarantee is unaffected (successive reservations
// receive strictly increasing seqs) and the {mem}-only effect keeps
// this file inside the user-space effect envelope every sibling user
// KIND_* under src/user/color/*.pdx uses.
//
// =============================================================================
// SECTION 3  RIGHTS
// =============================================================================
//
// Two rights only:
//
//   RIGHT_HOLD_PLANE        (0x001) -- the authority to occupy the
//                                      reserved slot; the compositor
//                                      being unable to obtain this cap
//                                      is exactly the P8 invariant.
//
//   RIGHT_QUERY_PLANE_INFO  (0x002) -- read-only observability: given
//                                      the cap, tell me (pipe_index,
//                                      plane_slot, holder_kind_id,
//                                      reserved_at_boot_seq). No write
//                                      surface.
//
// Deliberately ABSENT:
//
//   R_MINT                          -- the reservation is sealed to the
//                                      input server; svc-compositor
//                                      cannot mint a KIND_RECOVERY_PLANE
//                                      even if it somehow obtained a
//                                      RIGHT_HOLD_PLANE cap. Mirrors
//                                      KIND_SCANOUT_LEASE's leaf-kind
//                                      posture (no R_MINT on the row
//                                      itself; the plane lease cannot
//                                      deepen).
//
//   RIGHT_TAKEOVER                  -- introduced by #2270 (G7-M6-002)
//                                      alongside the takeover state
//                                      machine (RESERVED -> TAKING_OVER
//                                      -> DISPLAY_SOURCE). This landing
//                                      is reservation-only; no takeover
//                                      right is defined here.
//
// R_RP_ALL is the tight upper bound (0x003) that a future kernel-side
// dispatcher will enforce via subset check. When #2270 lands, R_RP_ALL
// widens to include RIGHT_TAKEOVER; the subset check on this file's
// current rights_valid stays a correct SUBSET of the future R_RP_ALL,
// so no consumer of the current rights bitmap needs updating.
//
// =============================================================================
// SECTION 4  FAILURE TAXONOMY 0xFFFFEED0..0xFFFFEEDF
// =============================================================================
//
// A repo-wide grep at landing time confirms 0xFFFFEED0..DF is unclaimed
// across src/ and design/ (adjacent bands: HDR metadata's 0xFFFFEEE0..EF
// and the KIND_TONEMAP_LUT 0xFFFFEEF0..FF page). Chosen so a caller can
// distinguish which precondition refused the reservation (already-
// reserved vs holder-wrong-kind vs holder-is-compositor) at the
// boundary, without re-running the check chain.

module RecoveryPlaneReserve = structure {

  // ==========================================================================
  // Identity.
  // ==========================================================================

  pub let KIND_RECOVERY_PLANE     : u64 = 0x1C8
  pub let KIND_RECOVERY_PLANE_BASE : u64 = 0x173   // = KIND_DISPLAY_PLANE

  // Rights (see §3).
  pub let RIGHT_HOLD_PLANE        : u64 = 0x001
  pub let RIGHT_QUERY_PLANE_INFO  : u64 = 0x002
  pub let R_RP_ALL                : u64 = 0x003

  // Slot constants.
  //
  // SL_RESERVED_PLANE_SLOT is the cap-shaped mirror of the constant of
  // the same name in kind_scanout_lease.pdx:117; the two files MUST
  // agree, because the scanout-lease mint gate refuses a lease against
  // this slot (SL_MINT_RESERVED, 0xFFFFF615) and this file's factory
  // records the reservation over exactly that slot.
  pub let SL_RESERVED_PLANE_SLOT  : u64 = 0
  pub let RP_PRIMARY_PIPE_INDEX   : u64 = 0

  // Cell layout.
  pub let RP_CELL_BYTES           : u64 = 32
  pub let RP_CELL_WORDS           : u64 = 4

  // Forward-reservation ordinals (see §0). Both are placeholders that
  // become real KIND_* ordinals when the input-server and compositor
  // process-kind landings arrive; this file's factory refuses any
  // holder value NOT equal to RESERVATION_HOLDER_KIND, and any holder
  // value equal to RP_COMPOSITOR_KIND_FORWARD, so a misassigned
  // ordinal is detected at the boundary rather than silently.
  pub let RESERVATION_HOLDER_KIND    : u64 = 0x1D0
  pub let RP_COMPOSITOR_KIND_FORWARD : u64 = 0x1D1

  // Failure taxonomy -- 0xFFFFEED0..0xFFFFEEDF (see §4).
  pub let RP_OK                        : u64 = 0
  pub let RP_ALREADY_RESERVED          : u64 = 0xFFFFEED1
  pub let RP_HOLDER_NOT_INPUT_SERVER   : u64 = 0xFFFFEED2
  pub let RP_HOLDER_IS_COMPOSITOR      : u64 = 0xFFFFEED3
  pub let RP_BAD_PIPE_INDEX            : u64 = 0xFFFFEED4
  pub let RP_BAD_PLANE_SLOT            : u64 = 0xFFFFEED5
  pub let RP_DECODE_BAD                : u64 = 0xFFFFFFFFFFFFFFFF

  // ==========================================================================
  // Struct shape.
  //
  // Declared for documentation and for future consumers that want to
  // load the fields via a typed accessor. The singleton cell backing
  // the reservation is _recovery_plane_reservation_cell below, whose
  // byte layout matches this struct's field order (u32/u32 packed at
  // +0, u32/u32 packed at +8, u64 at +16, u64 flag at +24). Explicit
  // reserved-padding word (u32 at +12 conceptually) is NOT modelled as
  // a struct field because paideia-as structs do not currently express
  // alignment padding at intermediate offsets; the cell writers wire
  // the reserved bits to zero directly.
  // ==========================================================================

  struct RecoveryPlaneReservation {
    pipe_index: u32,
    plane_slot: u32,
    holder_process_kind_id: u32,
    reserved_at_boot_seq: u64
  }

  // ==========================================================================
  // Singleton state.
  //
  // ONE reservation per boot. The cell is scrubbed by boot to zero via
  // .bss; the monotonic counter is bumped once at successful reserve
  // and its post-bump value is the reserved_at_boot_seq stamp.
  // ==========================================================================

  pub let mut _recovery_plane_reservation_cell : [u8; 32] = uninit @align(8)
  pub let mut _recovery_plane_boot_seq_counter : [u64; 1] = uninit @align(8)

  // ==========================================================================
  // Fingerprint tag.
  //
  // ONE tag ending [legacy: ... OK] per softarch discipline. The future
  // kernel-side dispatcher's reservation-mint body will emit this
  // string via klog_s1 on the successful reserve path; until that
  // landing arrives the string is a data-only constant and needs an
  // allowlist entry in tools/verify-fingerprint-coverage.sh with
  // reason "recovery-plane dispatcher not yet landed (G7.M6-001;
  // takeover cascade at #2270)". Adding that allowlist entry is a
  // separate landing (this file must not touch tools/), and follows
  // the exact posture hmk_mint_ok_msg / rdk_mint_ok_msg use today.
  // ==========================================================================

  pub let pdx_kind_recovery_plane_meta : [u8; 62] = "recovery plane reservation ok [legacy: RECOVERY PLANE RSV OK]\0"

  // ==========================================================================
  // Predicates.
  // ==========================================================================

  // rp_holder_valid(kind_id) -> 1 iff kind_id == RESERVATION_HOLDER_KIND
  // (i.e. the input server) AND kind_id != RP_COMPOSITOR_KIND_FORWARD.
  // The second inequality is redundant while the two constants disagree
  // by construction, but it is the belt-and-suspenders check that fires
  // if a future edit accidentally aliases the two ordinals.
  pub let rp_holder_valid : (u64) -> u64 !{} @{} =
    fn (kind_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B6-09 (paideia-os #2269): 1 iff kind_id == RESERVATION_HOLDER_KIND(0x1D0) AND kind_id != RP_COMPOSITOR_KIND_FORWARD(0x1D1). Two independent checks so a future edit that aliases the constants still fails one of them. Labels prefixed rp_hv_.",
      block: {
        mov r10, 0x1D0;
        cmp rdi, r10;
        jne rp_hv_no;
        mov r10, 0x1D1;
        cmp rdi, r10;
        je  rp_hv_no;
        mov rax, 1;
        ret;
      rp_hv_no:
        xor rax, rax;
        ret
      }
    }

  // recovery_plane_is_reserved(cell_ptr) -> 1 iff the cell's in_use
  // byte is set. cell_ptr in rdi is expected to point at a
  // _recovery_plane_reservation_cell (or any 32-byte cell of the same
  // layout); passing 0 in rdi is a caller error and will read [0+24]
  // which will #PF on a mapped-nothing low address -- the caller must
  // supply the pointer explicitly.
  //
  // A no-argument overload that consults the module singleton is
  // rp_singleton_is_reserved below.
  pub let recovery_plane_is_reserved : (u64) -> u64 !{mem} @{} =
    fn (cell_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B6-09 (paideia-os #2269): 1 iff [cell_ptr+24] low byte is nonzero. rdi is the cell pointer per SysV AMD64. Labels prefixed rp_ir_.",
      block: {
        mov rax, [rdi + 24];
        and rax, 0xFF;
        cmp rax, 0;
        je  rp_ir_no;
        mov rax, 1;
        ret;
      rp_ir_no:
        xor rax, rax;
        ret
      }
    }

  // rp_singleton_is_reserved() -> 1 iff the module's singleton cell
  // reports in_use. Preferred entry point for callers that do not
  // have a cell pointer in hand.
  pub let rp_singleton_is_reserved : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B6-09 (paideia-os #2269): 1 iff _recovery_plane_reservation_cell[+24] low byte is nonzero. Consults the module singleton. Labels prefixed rp_sir_.",
      block: {
        lea r10, [rip + _recovery_plane_reservation_cell];
        mov rax, [r10 + 24];
        and rax, 0xFF;
        cmp rax, 0;
        je  rp_sir_no;
        mov rax, 1;
        ret;
      rp_sir_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Getters (RIGHT_QUERY_PLANE_INFO surface).
  // ==========================================================================

  pub let rp_get_pipe_index : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B6-09 (paideia-os #2269): read pipe_index[31:0] from cell word0. Labels prefixed rp_gpi_.",
      block: {
        lea r10, [rip + _recovery_plane_reservation_cell];
        mov rax, [r10 + 0];
        and rax, 0xFFFFFFFF;
        ret
      }
    }

  pub let rp_get_plane_slot : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B6-09 (paideia-os #2269): read plane_slot[63:32] from cell word0. Labels prefixed rp_gps_.",
      block: {
        lea r10, [rip + _recovery_plane_reservation_cell];
        mov rax, [r10 + 0];
        shr rax, 32;
        and rax, 0xFFFFFFFF;
        ret
      }
    }

  pub let rp_get_holder_kind_id : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B6-09 (paideia-os #2269): read holder_process_kind_id[31:0] from cell word1. Labels prefixed rp_ghk_.",
      block: {
        lea r10, [rip + _recovery_plane_reservation_cell];
        mov rax, [r10 + 8];
        and rax, 0xFFFFFFFF;
        ret
      }
    }

  pub let rp_get_boot_seq : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B6-09 (paideia-os #2269): read reserved_at_boot_seq (u64) from cell word2. Labels prefixed rp_gbs_.",
      block: {
        lea r10, [rip + _recovery_plane_reservation_cell];
        mov rax, [r10 + 16];
        ret
      }
    }

  // ==========================================================================
  // One-shot factory.
  //
  // recovery_plane_reserve_at_boot(input_server_proc_kind_id) -> u64:
  //   RP_OK on success, else one of RP_ALREADY_RESERVED,
  //   RP_HOLDER_NOT_INPUT_SERVER, RP_HOLDER_IS_COMPOSITOR.
  //
  // Called ONCE by boot code from within the input server process.
  // Populates the module singleton. On success:
  //   - pipe_index and plane_slot are baked to 0
  //     (RP_PRIMARY_PIPE_INDEX and SL_RESERVED_PLANE_SLOT respectively)
  //     as compile-time invariants; the mint refuses to record any
  //     other value because the CELL WRITER hard-codes zero.
  //   - holder_process_kind_id is the caller-supplied argument, gated
  //     by rp_holder_valid (equal to RESERVATION_HOLDER_KIND, not
  //     equal to RP_COMPOSITOR_KIND_FORWARD).
  //   - reserved_at_boot_seq is the post-bump value of the singleton
  //     counter (first successful reserve receives 1).
  //   - in_use[7:0] is set to 1; a second call sees this flag and
  //     returns RP_ALREADY_RESERVED without touching the cell.
  //
  // Sig-compat note: the natural return type is the struct
  // RecoveryPlaneReservation, but paideia-as does not currently return
  // structs by value from asm bodies (all sibling KIND_* factories
  // return u64 status codes with the row/singleton parked in memory).
  // Callers reconstruct the RecoveryPlaneReservation view by reading
  // the four getters above once RP_OK is returned. The struct type
  // remains as the shape declaration for future front-end typed
  // access.
  //
  // Frame: no callee-save pushes needed (no nested call), so
  // entry rsp%16==8 stays through the whole body.
  // ==========================================================================

  pub let recovery_plane_reserve_at_boot : (u64) -> u64 !{mem} @{} =
    fn (input_server_proc_kind_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B6-09 (paideia-os #2269): one-shot reservation factory. Order: (1) refuse if singleton cell already in_use (RP_ALREADY_RESERVED); (2) rp_holder_valid must pass -- kind_id == RESERVATION_HOLDER_KIND(0x1D0) AND kind_id != RP_COMPOSITOR_KIND_FORWARD(0x1D1). Refusal cases split BAD_INPUT_SERVER vs IS_COMPOSITOR so the caller sees which check bit; (3) bump _recovery_plane_boot_seq_counter, remember post-bump value; (4) write cell -- word0 = 0 (pipe_index=0 packed with plane_slot=0), word1 = kind_id low32 (padding zero), word2 = boot_seq, word3 = 1 (in_use). No callee-save pushes: no nested call, rdi (holder) is the only live loop-carried value and is stashed in r8 before the counter bump. Entry rsp%16==8 stays. Labels prefixed rp_r_.",
      block: {
        // (1) refuse if already reserved.
        lea r10, [rip + _recovery_plane_reservation_cell];
        mov rax, [r10 + 24];
        and rax, 0xFF;
        cmp rax, 0;
        jne rp_r_already;

        // (2) holder gate. Two checks, ordered so the classifier
        //     distinguishes NOT_INPUT_SERVER (holder != 0x1D0) from
        //     IS_COMPOSITOR (holder == 0x1D1, which would already have
        //     failed the first check because 0x1D1 != 0x1D0, but the
        //     compositor-specific refusal is preferred for observability).
        mov r11, 0x1D1;                  // RP_COMPOSITOR_KIND_FORWARD
        cmp rdi, r11;
        je  rp_r_is_compositor;

        mov r11, 0x1D0;                  // RESERVATION_HOLDER_KIND
        cmp rdi, r11;
        jne rp_r_bad_holder;

        // (3) bump singleton counter; post-bump value is boot_seq.
        //     Load-inc-store (no `add reg, [mem]`).
        mov r8, rdi;                     // save holder kind id
        lea r11, [rip + _recovery_plane_boot_seq_counter];
        mov rax, [r11];
        add rax, 1;
        mov [r11], rax;
        mov r9, rax;                     // r9 = boot_seq

        // (4) publish cell.
        lea r10, [rip + _recovery_plane_reservation_cell];
        xor rax, rax;
        mov [r10 + 0], rax;              // word0: pipe_index=0 | plane_slot=0
        mov rax, r8;
        and rax, 0xFFFFFFFF;             // holder low32, reserved bits zero
        mov [r10 + 8], rax;              // word1: holder | 0
        mov [r10 + 16], r9;              // word2: boot_seq
        mov rax, 1;
        mov [r10 + 24], rax;             // word3: in_use = 1

        xor rax, rax;                    // RP_OK
        ret;

      rp_r_already:
        mov rax, 0xFFFFEED1;             // RP_ALREADY_RESERVED
        ret;

      rp_r_is_compositor:
        mov rax, 0xFFFFEED3;             // RP_HOLDER_IS_COMPOSITOR
        ret;

      rp_r_bad_holder:
        mov rax, 0xFFFFEED2;             // RP_HOLDER_NOT_INPUT_SERVER
        ret
      }
    }

  // ==========================================================================
  // Defensive boot-time reset (.bss is already zero at real boot).
  // ==========================================================================

  pub let rp_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B6-09 (paideia-os #2269): zero the singleton cell (four u64 words) and the boot-seq counter (one u64). Defensive re-scrub; mirrors hmk_init in src/user/color/hdr_metadata_kind.pdx. Labels prefixed rp_i_.",
      block: {
        lea r10, [rip + _recovery_plane_reservation_cell];
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        lea r10, [rip + _recovery_plane_boot_seq_counter];
        mov [r10 + 0],  rax;
        ret
      }
    }
}
