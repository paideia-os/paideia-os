// src/user/compositor/surface_kind.pdx -- G7.M2-001 (paideia-os #2246)
//
// KIND_SURFACE = 0x1B8, derived over KIND_IPC_ENDPOINT (= 5).
//
// Wave 0 Batch 6 dispatch. This landing DECLARES the KIND_SURFACE
// cap-kind identity for the G7 paideia-window-protocol (PWP) surface
// authority: slot number, rights bitmask, op numbering, failure
// taxonomy band, and the mint-success fingerprint tag. Row layout,
// pool storage, validators, packers, and the kernel-side dispatcher /
// mint body / cap_handler are NOT scoped to this issue -- they land
// under the M2-002 (surface_commit.pdx, #2248), M2-003
// (surface_geometry.pdx, #2250), and M2-004 (surface_buffer_bind.pdx,
// #2252) siblings, and the eventual kernel-side kind_surface.pdx +
// cap_handler_surface.pdx pair.
//
// AUTHORITY: design/compositor/pwp-spec-vocabulary.md §2.1
// KIND_SURFACE (KEYSTONE, frozen Batch 1). Linearity: non-linear
// (R_MINT present; children KIND_SUBSURFACE, KIND_SURFACE_COMMIT,
// KIND_WINDOW derive from it). Parent: KIND_IPC_ENDPOINT = 5. This
// file MUST NOT restate the spec; it only nails the identity in
// code so downstream code can name it.
//
// =============================================================================
// SECTION 0  WHY THIS KIND EXISTS
// =============================================================================
//
// A `KIND_SURFACE` is the client-facing composition primitive: one
// addressable 2D region a client renders into, spoken to as an RPC
// endpoint the compositor answers on. It anchors the whole compositor
// tree -- `KIND_WINDOW`, `KIND_LAYER`, `KIND_SUBSURFACE`, and
// `KIND_INPUT_ROUTE` all name a surface as their anchor -- so the
// cap-kind identity has to freeze BEFORE any of those children can
// derive from it. That is the shape of G7.M2 vs G7.M3: this file is
// the M2-001 root, the next three M2 siblings extend the surface
// state (commit txn, geometry, buffer-attach), then M3 grafts window
// and layer-tree onto the same anchor.
//
// The pwp-spec-vocabulary §2.1 commitment is that fractional-scale
// is a FIRST-CLASS field ON THE SURFACE, not on any downstream
// swapchain, and that R_MINT here is the sole authority for minting
// KIND_SUBSURFACE, KIND_SURFACE_COMMIT, and KIND_WINDOW. Both
// commitments show up here as declared rights and as OP_MINT_*
// numbering; the enforcement lives in the future dispatcher.
//
// =============================================================================
// SECTION 1  DERIVATION OVER KIND_IPC_ENDPOINT
// =============================================================================
//
// The kind half of the mint gate demands `kind == KIND_IPC_ENDPOINT
// (5)` carrying R_SURFACE_MINT. Downstream mints -- KIND_SUBSURFACE,
// KIND_SURFACE_COMMIT, KIND_WINDOW -- each demand `kind ==
// KIND_SURFACE (0x1B8)` carrying R_SURFACE_MINT with the further
// per-child right-subset required by the child's own file (not yet
// landed).
//
// The `KIND_COLOR_PROFILE = 0x18F` cross-reference the spec mandates
// is a MINT-TIME cap-table read the future kernel-side mint body
// performs (mirror of the hmk_dv_ref_valid structural cross-check
// for HDR RPU refs). This file declares only the failure code
// SURFACE_MINT_BAD_COLOR_REF the dispatcher raises on that path.
//
// =============================================================================
// SECTION 2  SLOT ALLOCATION -- 0x1B8
// =============================================================================
//
// `next-wave-derived-kinds.md` reports next-free-tag `0x1B5`, but that
// document has fallen behind the Wave-0 Batch-1 color landings:
// KIND_HDR_METADATA claimed `0x1B5` (src/user/color/hdr_metadata_kind
// .pdx), KIND_TONEMAP_LUT claimed `0x1B6` (src/user/color/tonemap_kind
// .pdx), and KIND_REFERENCE_DISPLAY claimed `0x1B7` (src/user/color/
// reference_display_kind.pdx). The next truly free tag past that
// block is `0x1B8`; the registry-refresh step (main coordinator's job
// at Batch 6 close-out) will move the "Next free derived-kind tag"
// line forward to `0x1B9` and land the row for `KIND_SURFACE`.
//
// The failure-code band 0xFFFFEEF1..0xFFFFEEFA is fresh per a
// monorepo-wide sweep of 0xFFFFEE__ at landing time: the immediate
// neighbours 0xFFFFEEF0 and 0xFFFFEEFB are used elsewhere, but the
// 10-slot gap between them was empty. 10 codes cover the current
// mint / revoke / decode failure surface with headroom.
//
// =============================================================================
// SECTION 3  LABEL PREFIX
// =============================================================================
//
// LABEL PREFIX: `sk_` (surface-kind). Reserved -- no asm bodies land
// in this file, but every follow-up (surface_commit.pdx,
// surface_geometry.pdx, surface_buffer_bind.pdx) that adds asm
// bodies will use its OWN prefix (`sck_` / `sgk_` / `sbk_`) so
// per-file debug tags stay disambiguated in the ring. All prefixes
// avoid the paideia-as reserved-keyword set (`loop`, `if`, `let`,
// `while`, `for`, `match`, `pub`, `mod`, `use`, `fn`, `struct`,
// `enum`, `impl`, `trait`, `type`, `where`, `move`, `mut`, `ref`)
// per feedback_paideia_as_reserved_labels.

module SurfaceKind = structure {

  // ==========================================================================
  // Identity.
  // ==========================================================================

  pub let KIND_SURFACE      : u64 = 0x1B8
  pub let KIND_SURFACE_BASE : u64 = 5           // = KIND_IPC_ENDPOINT

  // ==========================================================================
  // Rights bitmask.
  //
  // Layout follows the hmk_/tui_canvas convention (READ at 0x001,
  // INVOKE at 0x008, REVOKE at 0x010, MINT at 0x200, OBSERVE at 0x400)
  // and inserts the four surface-specific op-rights per §2.1 of the
  // vocabulary index (QUERY_GEOMETRY, ATTACH_BUFFER, COMMIT, DAMAGE)
  // into the intervening 0x020..0x100 range so a single AND against
  // R_SURFACE_ALL suffices for the mint-time subset test. Every OP
  // in §Section 4 below names exactly one of these bits as its
  // required right; the future dispatcher's per-op gate refuses a
  // mismatch with SURFACE_MINT_BAD_RIGHTS.
  //
  //   R_SURFACE_READ            0x001   generic query cap surface
  //   R_SURFACE_INVOKE          0x008   permission to enter cap_invoke
  //   R_SURFACE_REVOKE          0x010   revoke authority (holder side)
  //   R_SURFACE_QUERY_GEOMETRY  0x020   OP_QUERY_GEOMETRY / SCALE / TRANSFORM / VIEWPORT
  //   R_SURFACE_ATTACH_BUFFER   0x040   OP_ATTACH_BUFFER (pending state)
  //   R_SURFACE_COMMIT          0x080   OP_MINT_COMMIT_TXN
  //   R_SURFACE_DAMAGE          0x100   OP_DAMAGE_ADD (accumulate rects)
  //   R_SURFACE_MINT            0x200   OP_MINT_SUBSURFACE / OP_MINT_WINDOW
  //                                     / OP_MINT_COMMIT_TXN
  //   R_SURFACE_OBSERVE         0x400   subscribe to KIND_PRESENT_FEEDBACK
  //   R_SURFACE_ALL             0x7F9   OR of all above
  // ==========================================================================

  pub let R_SURFACE_READ           : u64 = 0x001
  pub let R_SURFACE_INVOKE         : u64 = 0x008
  pub let R_SURFACE_REVOKE         : u64 = 0x010
  pub let R_SURFACE_QUERY_GEOMETRY : u64 = 0x020
  pub let R_SURFACE_ATTACH_BUFFER  : u64 = 0x040
  pub let R_SURFACE_COMMIT         : u64 = 0x080
  pub let R_SURFACE_DAMAGE         : u64 = 0x100
  pub let R_SURFACE_MINT           : u64 = 0x200
  pub let R_SURFACE_OBSERVE        : u64 = 0x400
  pub let R_SURFACE_ALL            : u64 = 0x7F9

  // ==========================================================================
  // Op numbering.
  //
  // Every op is arity ONE (row_id in target_ptr, sub-op in
  // op_arg[7:0]); op_arg[63:8] MUST be zero -- the future dispatcher
  // will refuse a smuggled second value with SURFACE_TAIL_BAD_ARG,
  // mirroring the hmk_ / ksh_ dispatch discipline.
  //
  // OP_MINT_COMMIT_TXN takes R_SURFACE_MINT AND R_SURFACE_COMMIT --
  // the linearity discipline on KIND_SURFACE_COMMIT (spec §2.2) is
  // enforced at commit consumption, not at mint; a client with mint
  // authority but no commit authority (e.g. an audit reader) is
  // refused at the AND gate before a linear cap is even minted.
  // ==========================================================================

  pub let SURFACE_OP_QUERY_GEOMETRY   : u64 = 0
  pub let SURFACE_OP_QUERY_SCALE      : u64 = 1
  pub let SURFACE_OP_QUERY_TRANSFORM  : u64 = 2
  pub let SURFACE_OP_QUERY_VIEWPORT   : u64 = 3
  pub let SURFACE_OP_QUERY_COLOR_REF  : u64 = 4
  pub let SURFACE_OP_ATTACH_BUFFER    : u64 = 5
  pub let SURFACE_OP_DAMAGE_ADD       : u64 = 6
  pub let SURFACE_OP_MINT_COMMIT_TXN  : u64 = 7
  pub let SURFACE_OP_MINT_SUBSURFACE  : u64 = 8
  pub let SURFACE_OP_MINT_WINDOW      : u64 = 9
  pub let SURFACE_OP_DEBUG_PRINT      : u64 = 10
  pub let SURFACE_OP_MAX              : u64 = 10

  // ==========================================================================
  // Failure taxonomy -- 0xFFFFEEF1..0xFFFFEEFA (10 slots).
  //
  // Fresh band, verified free by monorepo-wide sweep of 0xFFFFEE__ at
  // landing time (immediate neighbours 0xFFFFEEF0 and 0xFFFFEEFB are
  // used, but 0xFFFFEEF1..0xFFFFEEFA was empty; 10 slots cover the
  // current mint / revoke / decode failure surface with headroom).
  //
  //   SURFACE_TAIL_ENOSPC      0xFFFFEEFA  row pool full (future)
  //   SURFACE_TAIL_BAD_ARG     0xFFFFEEF9  op_arg[63:8] != 0
  //   SURFACE_MINT_BAD_PARENT  0xFFFFEEF8  parent kind != KIND_IPC_ENDPOINT
  //   SURFACE_MINT_BAD_RIGHTS  0xFFFFEEF7  rights !subset R_SURFACE_ALL
  //   SURFACE_MINT_BAD_ANCHOR  0xFFFFEEF6  IPC endpoint slot invalid / wrong kind
  //   SURFACE_MINT_BAD_COLOR_REF 0xFFFFEEF5  KIND_COLOR_PROFILE cross-ref bad
  //   SURFACE_BAD_SLOT         0xFFFFEEF4  row_id out of range or not in_use
  //   SURFACE_WRONG_KIND       0xFFFFEEF3  cap not KIND_SURFACE at cap_invoke
  //   SURFACE_REVOKE_ALREADY   0xFFFFEEF2  double-revoke against same slot
  //   SURFACE_LINEARITY_VIOL   0xFFFFEEF1  reserved: KIND_SURFACE_COMMIT
  //                                        consumed twice (M2-002 uses)
  //   SURFACE_DECODE_BAD       0xFF..FF    generic decode-shape reject
  // ==========================================================================

  pub let SURFACE_OK                    : u64 = 0
  pub let SURFACE_TAIL_ENOSPC           : u64 = 0xFFFFEEFA
  pub let SURFACE_TAIL_BAD_ARG          : u64 = 0xFFFFEEF9
  pub let SURFACE_MINT_BAD_PARENT       : u64 = 0xFFFFEEF8
  pub let SURFACE_MINT_BAD_RIGHTS       : u64 = 0xFFFFEEF7
  pub let SURFACE_MINT_BAD_ANCHOR       : u64 = 0xFFFFEEF6
  pub let SURFACE_MINT_BAD_COLOR_REF    : u64 = 0xFFFFEEF5
  pub let SURFACE_BAD_SLOT              : u64 = 0xFFFFEEF4
  pub let SURFACE_WRONG_KIND            : u64 = 0xFFFFEEF3
  pub let SURFACE_REVOKE_ALREADY        : u64 = 0xFFFFEEF2
  pub let SURFACE_LINEARITY_VIOL        : u64 = 0xFFFFEEF1
  pub let SURFACE_DECODE_BAD            : u64 = 0xFFFFFFFFFFFFFFFF

  // ==========================================================================
  // Fingerprint tag.
  //
  // ONE line ending in `[legacy: ... OK]` per softarch discipline. The
  // future kind_surface mint body (kernel-side, not this file) will
  // emit this string via klog_s1_x1 on successful mint; until that
  // landing arrives the string is a data-only constant and needs to be
  // allowlisted in tools/verify-fingerprint-coverage.sh with reason
  // "G7.M2-001 (#2246) kind_surface mint body not yet landed". The
  // main coordinator adds that allowlist entry at Batch 6 close-out.
  //
  // Length: "surface kind mint ok [legacy: SURFACE KIND MINT OK]\0" =
  // 52 bytes.
  // ==========================================================================

  pub let pdx_kind_surface_meta : [u8; 52] = "surface kind mint ok [legacy: SURFACE KIND MINT OK]\0"
}
