// src/user/compositor/popup_positioning.pdx -- Wave0-B14 G7-M8-006
// (paideia-os #2264)
//
// KIND_POPUP_POSITIONER = 0x1C3, derived over KIND_WINDOW (0x1C1).
// LINEAR cap: no R_MINT bit on the client-visible right-set; consumed
// exactly once when the popup it describes is mapped.
//
// ISSUE-TRACKER NOTE. GitHub #2264 and #2265 are byte-identical
// duplicate filings ("xdg-shell-equivalent: popup positioning + grab
// semantics", slug G7-M4-003 on both). #2265 already landed CLOSED as
// src/user/compositor/xdg_shell_popup.pdx (KIND_XDG_POPUP = 0x1C5),
// which folds an anchor rect + edge + gravity + grab-seat + serial
// directly into the popup row. This landing does not re-implement
// that row; it closes the still-open duplicate (#2264) with the
// genuinely distinct piece the shared title also describes but
// xdg_shell_popup.pdx does not attempt: the positioner as its own
// capability, checked once, atomically, before a popup exists. Main
// should note the duplicate at close time.
//
// Design authority:
//   * design/compositor/pwp-spec-vocabulary.md §2.7 (KIND_XDG_POPUP).
//   * src/user/compositor/xdg_shell_popup.pdx (Wave0-B7-03, #2265) --
//     companion / prior art. Its anchor_xy / anchor_wh / edge_pack
//     fields are sized IDENTICALLY to this file's [+24]/[+32]/[+56]
//     (SECTION 5, interop note in SECTION 14); this file does not
//     import that module (MECE SCOPE below) -- the shapes agree on the
//     wire by independent declaration, not by dependency.
//   * Wayland xdg_shell's `xdg_positioner` -- the prior art this kind
//     reinterprets. There, a free-floating factory object is mutated
//     across up to seven separate requests (set_size / set_anchor_rect
//     / set_anchor / set_gravity / set_constraint_adjustment /
//     set_offset / set_reactive) before a final `get_popup` consumes
//     it; every intermediate state is a legal, live, INCOHERENT
//     object, and two `get_popup` calls racing one positioner resolve
//     to implementation-defined "last write wins" behavior.
//
// NOVEL-CLEAN DIVERGENCE: ATOMIC MINT, NOT MUTATE-THEN-CONSUME.
// This kind collapses xdg_positioner's seven-request accumulator into
// ONE factory call (popup_positioner_mint, SECTION 13) that takes
// every field as an argument and either produces a complete,
// internally-consistent row or refuses with the row untouched -- no
// partially-configured positioner is ever observable as a capability,
// closing the "client forgot set_anchor_rect before get_popup" /
// "client raced two set_* calls" class of bugs xdg_shell's own
// `invalid_input` protocol error exists to report after the fact.
// LINEARITY is the second half: a positioner is consumed EXACTLY ONCE
// (popup_positioner_consume, SECTION 14), stamping a `consumed` bit
// that makes a second consume a hard refusal (POSITIONER_ALREADY_
// CONSUMED) instead of xdg_shell's implementation-defined double-use.
// Consuming a positioner always MEANS "this popup is mapping now" --
// the gate a future popup_map wire-body calls immediately before
// minting the KIND_XDG_POPUP row, mirroring the consume-on-flush shape
// surface_commit.pdx (0x1B9) already uses for the same P1 reason (no
// implicit sync, no ambient double-use).
//
// WHY A SEPARATE KIND FROM KIND_XDG_POPUP. xdg_shell_popup.pdx's
// constructor-argument shape covers a SIMPLE popup fine. This kind
// covers what that shape does not: a positioner computed, inspected,
// or re-derived BEFORE the popup it backs is known to exist -- e.g. a
// menu library scoring several candidate anchors for least constraint
// adjustment, then minting exactly one popup against the winner. A
// toolkit that never needs this keeps calling xdg_popup_mint directly,
// unchanged; this kind is additive.
//
// CONSTRAINT-ADJUST BITMASK (SECTION 4). Six independent bits request
// compositor-side adjustment when the naive placement (anchor rect's
// attach point per anchor_edge, popup growing from it per gravity,
// plus offset) would leave the popup outside the constraint region
// (typically the parent's output): SLIDE_X/Y translate the popup back
// in without resizing; FLIP_X/Y mirror anchor_edge and gravity across
// that axis (a right-fanning submenu that would overflow instead fans
// left); RESIZE_X/Y shrink the popup along that axis as a last resort.
// This file validates and stores the bitmask; the constraint solver
// that walks real output geometry is compositor-side runtime logic for
// a follow-up milestone, same "schema seed" posture xdg_shell_popup.pdx
// takes for its own grab-serial cross-check.
//
// LINEAR RIGHTS DISCIPLINE. No R_MINT bit (SECTION 2), mirroring
// surface_commit.pdx: the parent KIND_WINDOW authority is the sole
// minter, via a right bit a future landing adds to window_kind.pdx the
// same way R_WIN_MINT_XDG_POPUP (0x10000) already gates KIND_XDG_POPUP
// there. Once minted, a row is single-owner until consumed.
//
// SLOT ALLOCATION -- 0x1C3. Grep-verified free across src/user/
// compositor/*.pdx + src/user/*.pdx (`KIND_[A-Z_]*\s*=\s*0x1[BCD]`)
// plus a full-repo sweep for every `0x1[B-F][0-9A-F]` KIND_ ordinal.
// 0x1C3 is the sole remaining gap inside the XDG-shell cluster
// KIND_WINDOW(0x1C1) / KIND_LAYER_TREE(0x1C2) / [0x1C3] / KIND_XDG_
// TOPLEVEL_STATE(0x1C4) / KIND_XDG_POPUP(0x1C5): window_kind.pdx
// originally reserved 0x1BC..0x1C0 for LAYER_TREE and SUBSURFACE, but
// both landed elsewhere (0x1C2, 0x1BA), leaving 0x1C3 unclaimed and
// the only slot that completes the contiguous block. The wider
// 0x1B8..0x1DE band this row's brief named is NOT full (0x1BB,
// 0x1BC..0x1C0, 0x1CA..0x1CF also free at landing time), so the
// 0x1E0..0x1FF overflow band the brief allows for was not needed.
//
// FAILURE BAND. 0xFFFFE820..0xFFFFE82F, pre-assigned. Ten codes
// declared (SECTION 7); 0xFFFFE820..0xFFFFE825 stay RESERVED for the
// future mint-gate wrapper (parent-rights refusal, row-pool WRONG_
// KIND/BAD_SLOT, revoke-already), same posture as xdg_shell_popup.pdx
// reserving codes for its own not-yet-landed dispatcher.
//
// FINGERPRINT. One legacy-suffixed init fingerprint (SECTION 9),
// data-only at this landing per the sibling B8/B10/B11/B12/B13
// pattern -- no dispatcher exists yet to emit it. Allowlisted in
// tools/verify-fingerprint-coverage.sh, same reasoning as the sibling
// `bidi caret init ok` entry.
//
// MECE SCOPE. Two files, both listed in the row brief:
//   * NEW: src/user/compositor/popup_positioning.pdx (this file)
//   * EDIT: tools/verify-fingerprint-coverage.sh (allowlist entry for
//     pdx_kind_popup_positioner_meta)
// This file does not import XdgShellPopup (avoids a cross-file
// module-order dependency for shapes that only need to be BIT-
// COMPATIBLE, not literally shared -- the same choice surface_commit.
// pdx makes for KIND_SURFACE's ordinal). The anchor/gravity enum and
// row byte shape are independently declared here with matching values.
//
// LABEL PREFIX. `popup_positioner_` throughout, sidestepping
// paideia-as reserved-word collisions (`loop`, `if`, `for`, `match`).
// Every jump target is `popup_positioner_<fn>_<tag>`.
//
// ENCODER-CONSERVATIVE PATTERN (paideia-as strict). No `test`, no
// `and rN, imm64`, no 2-op `imul`, no `add reg, [mem]`, no `mov_bzx` /
// `mov_wzx`. Every field-width mask here is a `shl N; shr N` pair
// (isolate the bits of interest by shifting the rest off each end and
// zero-filling back), matching bidi_caret.pdx's idiom and sidestepping
// the sign-extension-vs-zero-extension hazard a bare `and reg,
// 0xFFFFFFFF` (bit 31 set) would carry. A single-bit test on a packed
// header word uses `shl (63-K); shr 63` to isolate bit K into bit 0
// regardless of neighbouring bits. NO function in this file contains a
// `call` -- every one is a pure leaf (validators, packers, accessors)
// or a straight-line validate-then-store body (mint, consume); the
// stats slots (SECTION 8) are free-standing infrastructure a future
// dispatcher wires in, exactly as xdg_shell_popup.pdx's own stats
// section declares slots no function there bumps either. No register
// is ever pushed and rsp is never touched.
//
// =============================================================================

module PopupPositioning = structure {

  // ==========================================================================
  // SECTION 1 -- KIND ORDINAL + PARENT + POOL CEILING
  // ==========================================================================

  pub let KIND_POPUP_POSITIONER : u64 = 0x1C3
  pub let PPOS_PARENT_KIND      : u64 = 0x1C1   // = KIND_WINDOW (B6-05, #2254)

  // Pool ceiling. A positioner is short-lived (computed, consumed,
  // discarded within one popup-map call); a heavily-nested menu chain
  // computing several candidate positioners before settling on one
  // realistically never holds more than a handful live at once. 16
  // mirrors XPOP_MAX's own nested-menu-depth rationale in
  // xdg_shell_popup.pdx. 16 * 64 = 1024 bytes -- one 1 KiB slab.
  pub let PPOS_MAX       : u64 = 16
  pub let PPOS_ROW_BYTES : u64 = 64

  // ==========================================================================
  // SECTION 2 -- RIGHTS
  // ==========================================================================
  //
  // No R_MINT bit -- LINEAR discipline (see header NOVEL-CLEAN /
  // LINEAR RIGHTS DISCIPLINE notes). The parent KIND_WINDOW authority
  // is the sole minter via a future mint-gate wrapper.

  pub let R_PPOS_QUERY   : u64 = 0x001   // read anchor/gravity/adjust/parent fields
  pub let R_PPOS_CONSUME : u64 = 0x002   // linear consume (popup-map path)
  pub let R_PPOS_REVOKE  : u64 = 0x010   // compositor-held teardown
  pub let R_PPOS_OBSERVE : u64 = 0x400   // compositor-held debug printer
  pub let R_PPOS_ALL     : u64 = 0x413   // 0x001|0x002|0x010|0x400

  // Client-visible right-set at mint time: query + consume. REVOKE and
  // OBSERVE stay with the compositor, mirroring every sibling LINEAR
  // cap's split.
  pub let R_PPOS_CLIENT  : u64 = 0x003

  // ==========================================================================
  // SECTION 3 -- ANCHOR / GRAVITY ENUM (shared nine-value enumeration)
  // ==========================================================================
  //
  // Identical numbering to xdg_shell_popup.pdx's ANCHOR_* constants
  // (independently declared here -- see MECE SCOPE). anchor_edge names
  // the point on the anchor rect the popup attaches to; gravity names
  // the direction the popup grows from that point. Both fields share
  // this one enumeration, validated by two separately-named predicates
  // (SECTION 11) so a call site stays self-documenting about which
  // field it checks.

  pub let PPOS_ANCHOR_NONE         : u64 = 0
  pub let PPOS_ANCHOR_TOP          : u64 = 1
  pub let PPOS_ANCHOR_BOTTOM       : u64 = 2
  pub let PPOS_ANCHOR_LEFT         : u64 = 3
  pub let PPOS_ANCHOR_RIGHT        : u64 = 4
  pub let PPOS_ANCHOR_TOP_LEFT     : u64 = 5
  pub let PPOS_ANCHOR_TOP_RIGHT    : u64 = 6
  pub let PPOS_ANCHOR_BOTTOM_LEFT  : u64 = 7
  pub let PPOS_ANCHOR_BOTTOM_RIGHT : u64 = 8
  pub let PPOS_ANCHOR_MAX          : u64 = 8

  // ==========================================================================
  // SECTION 4 -- CONSTRAINT-ADJUST BITMASK
  // ==========================================================================
  //
  // Six independent bits (see header CONSTRAINT-ADJUST SEMANTICS).
  // NONE = 0 is the legal "do not adjust; refuse to map if the naive
  // placement does not fit" request. Any combination of the six bits
  // is a legal mask; only bits above bit 5 are invalid.

  pub let PPOS_ADJUST_NONE      : u64 = 0x00
  pub let PPOS_ADJUST_SLIDE_X   : u64 = 0x01
  pub let PPOS_ADJUST_SLIDE_Y   : u64 = 0x02
  pub let PPOS_ADJUST_FLIP_X    : u64 = 0x04
  pub let PPOS_ADJUST_FLIP_Y    : u64 = 0x08
  pub let PPOS_ADJUST_RESIZE_X  : u64 = 0x10
  pub let PPOS_ADJUST_RESIZE_Y  : u64 = 0x20
  pub let PPOS_ADJUST_ALL       : u64 = 0x3F

  // ==========================================================================
  // SECTION 5 -- ROW LAYOUT -- 64 BYTES (one cache line)
  // ==========================================================================
  //
  //   [+0]  header:     in_use(bit56) | consumed(bit55) | reserved[54:0]
  //                     Both bits are single-bit flags tested by
  //                     shift-isolation (see header ENCODER-
  //                     CONSERVATIVE PATTERN), not byte-wide fields.
  //                     in_use is self-stamped by popup_positioner_
  //                     mint (SECTION 13) -- unlike xdg_shell_popup.pdx,
  //                     which defers in_use to a companion pool-
  //                     allocator landing, THIS row family has no such
  //                     companion yet, so the factory is self-
  //                     sufficient for lifecycle testing, mirroring
  //                     bidi_caret_init's self-owned "already-init"
  //                     signal. consumed is stamped only by
  //                     popup_positioner_consume (SECTION 14).
  //
  //   [+8]  positioner_id: u64, RESERVED for a future kernel-assigned
  //                        monotonic token (0 at this landing).
  //                        Mirrors xdg_shell_popup.pdx's popup_id
  //                        field, which that file's own mint body also
  //                        leaves untouched pending its pool allocator.
  //
  //   [+16] parent_window_kind_id: u64, zero-extended from the low 32
  //                        bits of the mint argument (bits[63:32]
  //                        reserved, 0). Names the KIND_WINDOW row the
  //                        eventual popup will anchor against.
  //
  //   [+24] anchor_xy:   anchor_rect_x[31:0] (i32) | anchor_rect_y[63:32] (i32)
  //   [+32] anchor_wh:   anchor_rect_w[31:0] (i32) | anchor_rect_h[63:32] (i32)
  //   [+40] popup_size:  popup_w[31:0] (i32) | popup_h[63:32] (i32)
  //   [+48] offset_xy:   offset_x[31:0] (i32) | offset_y[63:32] (i32)
  //   [+56] enum_pack:   anchor_edge[7:0] | gravity[15:8] |
  //                      constraint_adjust[23:16] | reserved[63:24]
  //
  // ANCHOR RECT VS. POPUP SIZE. These are two DIFFERENT rectangles,
  // easy to conflate: anchor_xy/anchor_wh is the box on the PARENT the
  // popup attaches to (parent-local coordinates, may legally be a
  // single point with nonzero width/height but zero area is refused --
  // see POSITIONER_ANCHOR_RECT_EMPTY); popup_size is the size of the
  // POPUP WINDOW ITSELF once mapped. Wayland's xdg_positioner keeps
  // the same two-rect split (`set_anchor_rect` vs `set_size`); this
  // row keeps both fields but validates them together in one call
  // instead of two independent requests.
  //
  // Coordinates are SIGNED (i32 per component), matching xdg_shell_
  // popup.pdx's own anchor coordinate contract -- an anchor rect
  // partially off a window's geometry (as happens after a drag that
  // leaves the window's origin off-screen) still round-trips.

  pub let PPOS_OFF_HEADER       : u64 = 0
  pub let PPOS_OFF_POSITIONER_ID: u64 = 8
  pub let PPOS_OFF_PARENT       : u64 = 16
  pub let PPOS_OFF_ANCHOR_XY    : u64 = 24
  pub let PPOS_OFF_ANCHOR_WH    : u64 = 32
  pub let PPOS_OFF_POPUP_SIZE   : u64 = 40
  pub let PPOS_OFF_OFFSET_XY    : u64 = 48
  pub let PPOS_OFF_ENUM_PACK    : u64 = 56

  // Header bit positions (isolated via shift, never AND-masked).
  pub let PPOS_HDR_IN_USE_BIT   : u64 = 56
  pub let PPOS_HDR_CONSUMED_BIT : u64 = 55

  // ==========================================================================
  // SECTION 6 -- OP TAGS (future dispatch surface)
  // ==========================================================================
  //
  // Kernel dispatch surface for a follow-up milestone, mirroring
  // xdg_shell_popup.pdx's own op-tag placeholder section. No dispatch
  // handler exists yet; these tags document the eventual
  // cap_invoke_dispatch surface so callers written against it today
  // do not need to change shape once the handler lands.

  pub let PPOS_OP_MINT                : u64 = 0   // op_arg = packed mint payload ptr
  pub let PPOS_OP_CONSUME             : u64 = 1   // op_arg = out ptr (5 u64 payload words)
  pub let PPOS_OP_QUERY_ANCHOR_EDGE   : u64 = 2
  pub let PPOS_OP_QUERY_GRAVITY       : u64 = 3
  pub let PPOS_OP_QUERY_ADJUST        : u64 = 4
  pub let PPOS_OP_QUERY_PARENT_WINDOW : u64 = 5
  pub let PPOS_OP_QUERY_CONSUMED      : u64 = 6
  pub let PPOS_OP_DEBUG_PRINT         : u64 = 7   // R_PPOS_OBSERVE; row dump
  pub let PPOS_OP_MAX                 : u64 = 7

  // ==========================================================================
  // SECTION 7 -- FAILURE TAXONOMY -- 0xFFFFE820..0xFFFFE82F
  // ==========================================================================
  //
  // Pre-assigned 16-wide band (row brief). Ten codes declared; the low
  // six (0xFFFFE820..0xFFFFE825) stay reserved for the future mint-
  // gate wrapper (parent-rights refusal, row-pool WRONG_KIND/BAD_SLOT,
  // revoke-already) -- same posture as xdg_shell_popup.pdx's own
  // taxonomy, which declares XPOP_TAIL_ENOSPC without ever raising it
  // from xdg_popup_mint (that code is reserved for a pool allocator
  // that has not landed either). POSITIONER_REFUSED_DENSE below takes
  // the identical role here: declared, documented, not yet raised.

  pub let PPOS_OK                       : u64 = 0
  pub let POSITIONER_NULL               : u64 = 0xFFFFE82F  // row_ptr / out_ptr == 0
  pub let POSITIONER_ANCHOR_INVALID     : u64 = 0xFFFFE82E  // anchor_edge > PPOS_ANCHOR_MAX
  pub let POSITIONER_GRAVITY_INVALID    : u64 = 0xFFFFE82D  // gravity > PPOS_ANCHOR_MAX
  pub let POSITIONER_ADJUST_INVALID     : u64 = 0xFFFFE82C  // constraint_adjust > PPOS_ADJUST_ALL
  pub let POSITIONER_ANCHOR_RECT_EMPTY  : u64 = 0xFFFFE82B  // anchor_rect_w == 0 or anchor_rect_h == 0
  pub let POSITIONER_SIZE_INVALID       : u64 = 0xFFFFE82A  // popup_w == 0 or popup_h == 0
  pub let POSITIONER_REFUSED_DENSE      : u64 = 0xFFFFE829  // row pool exhausted (reserved;
                                                             // not raised until a pool
                                                             // allocator lands)
  pub let POSITIONER_NOT_INIT           : u64 = 0xFFFFE828  // consume before a successful mint
                                                             // (in_use bit clear)
  pub let POSITIONER_ALREADY_CONSUMED   : u64 = 0xFFFFE827  // second consume attempt (LINEAR
                                                             // violation)
  pub let POSITIONER_BAD_PARENT         : u64 = 0xFFFFE826  // parent_window_kind_id >= 2^32
  // 0xFFFFE820..0xFFFFE825 RESERVED for the future mint-gate wrapper.

  // ==========================================================================
  // SECTION 8 -- STATS COUNTER SLOTS
  // ==========================================================================
  //
  // Named here so a future dispatcher and a future test witness agree
  // on slot indices. Nothing in THIS file bumps these (see header
  // ENCODER-CONSERVATIVE PATTERN) -- they are free-standing
  // infrastructure a dispatcher wires in, mirroring xdg_shell_popup.
  // pdx's own SECTION 7.

  pub let PPOS_ST_MINTS    : u64 = 0
  pub let PPOS_ST_CONSUMES : u64 = 1
  pub let PPOS_ST_QUERIES  : u64 = 2
  pub let PPOS_ST_REFUSED  : u64 = 3
  pub let PPOS_ST_MAX      : u64 = 8

  // ==========================================================================
  // SECTION 9 -- FINGERPRINT (one line, legacy-suffixed)
  // ==========================================================================
  //
  // Emitted once on successful mint by a future substrate. Data-only
  // at this landing (allowlisted in tools/verify-fingerprint-
  // coverage.sh, same posture as the sibling `bidi caret init ok`
  // entry) -- no dispatcher exists yet to call popup_positioner_mint.
  //
  // Byte count: 59 content chars + 1 NUL = 60.
  pub let pdx_kind_popup_positioner_meta : [u8; 60] = "popup positioner init ok [legacy: POPUP POSITIONER INIT OK]\0"

  // Short field-name string constants for future debug-print use
  // (mirror latin_deadkey_k_provider_id / bidi_caret_k_paragraph
  // precedent).
  pub let popup_positioner_k_anchor  : [u8; 7] = "anchor\0"
  pub let popup_positioner_k_gravity : [u8; 8] = "gravity\0"
  pub let popup_positioner_k_adjust  : [u8; 7] = "adjust\0"

  // ==========================================================================
  // SECTION 10 -- STATS CELL
  // ==========================================================================
  //
  // Module-level counters shared across every positioner row in this
  // process, sized to PPOS_ST_MAX. Mirrors _bidi_caret_stats layout.
  // Declared and reserved only -- the reset/bump/read primitives land
  // with the future dispatcher that actually calls them (SECTION 8),
  // same minimal posture xdg_shell_popup.pdx takes for its own stats.

  pub let mut _popup_positioner_stats : [u64; 8] = uninit @align(64)

  // ==========================================================================
  // SECTION 11 -- VALIDATORS (pure leaves, small immediates)
  // ==========================================================================
  //
  // Every function here is a pure unsafe-bodied leaf returning in rax
  // and clobbering only rax + one scratch. No `test`, no `and reg,
  // imm` wider than a single small comparison bound. Labels prefixed
  // popup_positioner_ per this row's reserved-label discipline.

  // popup_positioner_anchor_valid(e) -> 1 iff e <= PPOS_ANCHOR_MAX.
  pub let popup_positioner_anchor_valid : (u64) -> u64 !{} @{} =
    fn (e: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B14 G7-M8-006 (#2264): anchor_edge validator, admits 0..8. Small immediate so no MOVABS. Labels prefixed popup_positioner_av_.",
      block: {
        cmp rdi, 8;
        ja  popup_positioner_av_no;
        mov rax, 1;
        ret;
      popup_positioner_av_no:
        xor rax, rax;
        ret
      }
    }

  // popup_positioner_gravity_valid(g) -> 1 iff g <= PPOS_ANCHOR_MAX.
  // Same enumeration as anchor_edge; separate name so a call site is
  // self-documenting about which field it validates.
  pub let popup_positioner_gravity_valid : (u64) -> u64 !{} @{} =
    fn (g: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B14 G7-M8-006 (#2264): gravity validator (same enumeration as anchor_edge). Labels prefixed popup_positioner_gv_.",
      block: {
        cmp rdi, 8;
        ja  popup_positioner_gv_no;
        mov rax, 1;
        ret;
      popup_positioner_gv_no:
        xor rax, rax;
        ret
      }
    }

  // popup_positioner_adjust_valid(mask) -> 1 iff mask <= PPOS_ADJUST_ALL.
  pub let popup_positioner_adjust_valid : (u64) -> u64 !{} @{} =
    fn (mask: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B14 G7-M8-006 (#2264): constraint-adjust bitmask validator, admits any combination of the six declared bits (0..0x3F). Labels prefixed popup_positioner_adjv_.",
      block: {
        cmp rdi, 0x3F;
        ja  popup_positioner_adjv_no;
        mov rax, 1;
        ret;
      popup_positioner_adjv_no:
        xor rax, rax;
        ret
      }
    }

  // popup_positioner_u32_valid(v) -> 1 iff v < 2^32. Used for
  // parent_window_kind_id. Shift-based range test (shr 32; cmp 0)
  // rather than a masked comparison, per bidi_caret_offset_valid's
  // idiom -- sidesteps the sign-extension hazard a bare `cmp reg,
  // 0xFFFFFFFF` (bit 31 set) would carry.
  pub let popup_positioner_u32_valid : (u64) -> u64 !{} @{} =
    fn (v: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B14 G7-M8-006 (#2264): 1 iff v < 2^32. Encoder-conservative 32-bit range test via shr 32 / cmp 0, mirroring bidi_caret_offset_valid exactly. Labels prefixed popup_positioner_uv_.",
      block: {
        mov rax, rdi;
        shr rax, 32;
        cmp rax, 0;
        jne popup_positioner_uv_no;
        mov rax, 1;
        ret;
      popup_positioner_uv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // SECTION 12 -- PACKERS (pure leaves)
  // ==========================================================================

  // popup_positioner_i32_pair_pack(lo, hi) -> lo[31:0] | hi[63:32].
  // Used by a caller to build anchor_ptr entries, popup_size_pack, and
  // offset_pack before calling popup_positioner_mint. Low 32 bits of
  // `lo` are isolated by shift (shl 32; shr 32), not AND-masked, so a
  // negative i32 packed into `lo` round-trips: the sign bit lands at
  // bit 31 of the packed word and is reinterpreted correctly by a
  // reader that treats that half as i32.
  pub let popup_positioner_i32_pair_pack : (u64, u64) -> u64 !{} @{} =
    fn (lo: u64) (hi: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B14 G7-M8-006 (#2264): signed i32 pair pack -- lo[31:0] | hi[63:32]. Used for anchor_ptr entries, popup_size_pack, and offset_pack. Labels prefixed popup_positioner_ip_.",
      block: {
        mov rax, rsi;
        shl rax, 32;
        mov r10, rdi;
        shl r10, 32;
        shr r10, 32;
        or  rax, r10;
        ret
      }
    }

  // popup_positioner_enum_pack(edge, gravity, adjust) ->
  // edge[7:0] | gravity[15:8] | adjust[23:16]. Each input is cleaned
  // to a byte via shl 56 / shr 56 before being placed, so an
  // out-of-range caller argument cannot smear into a neighbouring
  // field (the mint factory re-validates the assembled word anyway,
  // but a clean pack keeps popup_positioner_get_* accessors correct
  // even against a hand-built word that skipped the mint gate).
  pub let popup_positioner_enum_pack : (u64, u64, u64) -> u64 !{} @{} =
    fn (edge: u64) (gravity: u64) (adjust: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B14 G7-M8-006 (#2264): pack edge[7:0] | gravity[15:8] | adjust[23:16] per row layout at [+56]. Each field cleaned to a byte via shl 56 / shr 56. Labels prefixed popup_positioner_ep_.",
      block: {
        mov rax, rdx;
        shl rax, 56;
        shr rax, 56;
        shl rax, 16;
        mov r10, rsi;
        shl r10, 56;
        shr r10, 56;
        shl r10, 8;
        or  rax, r10;
        mov r10, rdi;
        shl r10, 56;
        shr r10, 56;
        or  rax, r10;
        ret
      }
    }

  // popup_positioner_hdr_pack() -> canonical empty header (0). The
  // in_use bit is stamped by popup_positioner_mint itself, not here --
  // mirrors xdg_shell_popup_hdr_pack / surface_commit's equivalent.
  pub let popup_positioner_hdr_pack : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B14 G7-M8-006 (#2264): canonical empty row header; popup_positioner_mint stamps in_use itself. Labels prefixed popup_positioner_hp_.",
      block: {
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // SECTION 13 -- FACTORY: popup_positioner_mint
  // ==========================================================================
  //
  // popup_positioner_mint(row_ptr, parent_window_kind_id, anchor_ptr,
  //                        popup_size_pack, offset_pack, enum_pack) -> u64
  //
  //   anchor_ptr points at 4 packed i32s [ax,ay,aw,ah] -- the SAME
  //   16-byte shape xdg_popup_mint's own anchor_ptr argument uses.
  //   popup_size_pack / offset_pack are built via popup_positioner_
  //   i32_pair_pack; enum_pack via popup_positioner_enum_pack (SECTION
  //   12). Returns PPOS_OK on success; a POSITIONER_* refusal code with
  //   the row left completely untouched on any validation failure --
  //   the ATOMIC MINT the header's NOVEL-CLEAN DIVERGENCE note
  //   describes. Six args fit rdi..r9 with no stack spill and no
  //   nested `call`, so no stack-alignment reasoning applies here.
  pub let popup_positioner_mint : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (row_ptr: u64) (parent_window_kind_id: u64) (anchor_ptr: u64) (popup_size_pack: u64) (offset_pack: u64) (enum_pack: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B14 G7-M8-006 (paideia-os #2264): atomic positioner factory. Validates parent range, anchor_edge, gravity, constraint_adjust, anchor-rect emptiness, and popup-size emptiness BEFORE any store -- an invalid positioner is never observable as a capability (see header NOVEL-CLEAN DIVERGENCE). No nested call; six args fit rdi..r9 with no stack spill; no push/pop, no rsp adjustment. Scratch: rax, r10, r11 (all caller-saved); rdi/rsi/rdx/rcx/r8/r9 hold the incoming args and are read repeatedly but never overwritten until each field's own commit write, so validation order does not require staging copies. Every mask is shl/shr, never AND-immediate. Labels prefixed popup_positioner_pm_.",
      block: {
        // (1) row_ptr null.
        cmp rdi, 0;
        je  popup_positioner_pm_null;

        // (2) parent_window_kind_id must fit u32.
        mov rax, rsi;
        shr rax, 32;
        cmp rax, 0;
        jne popup_positioner_pm_bad_parent;

        // (3) anchor_edge = enum_pack[7:0].
        mov rax, r9;
        shl rax, 56;
        shr rax, 56;
        cmp rax, 8;
        ja  popup_positioner_pm_bad_edge;

        // (4) gravity = enum_pack[15:8].
        mov rax, r9;
        shr rax, 8;
        shl rax, 56;
        shr rax, 56;
        cmp rax, 8;
        ja  popup_positioner_pm_bad_gravity;

        // (5) constraint_adjust = enum_pack[23:16].
        mov rax, r9;
        shr rax, 16;
        shl rax, 56;
        shr rax, 56;
        cmp rax, 0x3F;
        ja  popup_positioner_pm_bad_adjust;

        // (6) anchor rect must not be empty: aw and ah both nonzero.
        mov r10d, [rdx + 8];
        cmp r10, 0;
        je  popup_positioner_pm_rect_empty;
        mov r11d, [rdx + 12];
        cmp r11, 0;
        je  popup_positioner_pm_rect_empty;

        // (7) popup size must not be empty: pw and ph both nonzero.
        mov rax, rcx;
        shl rax, 32;
        shr rax, 32;
        cmp rax, 0;
        je  popup_positioner_pm_size_invalid;
        mov rax, rcx;
        shr rax, 32;
        cmp rax, 0;
        je  popup_positioner_pm_size_invalid;

        // ---- All validated. Commit the writes. ----

        // [+16] parent_window_kind_id, zero-extended to u32 (upper 32
        // reserved, 0).
        mov rax, rsi;
        shl rax, 32;
        shr rax, 32;
        mov [rdi + 16], rax;

        // [+24] anchor_xy: ax[31:0] | ay[63:32], from anchor_ptr[0..8).
        mov r10d, [rdx + 0];
        mov r11d, [rdx + 4];
        shl r11, 32;
        or  r10, r11;
        mov [rdi + 24], r10;

        // [+32] anchor_wh: aw[31:0] | ah[63:32], from anchor_ptr[8..16).
        mov r10d, [rdx + 8];
        mov r11d, [rdx + 12];
        shl r11, 32;
        or  r10, r11;
        mov [rdi + 32], r10;

        // [+40] popup_size verbatim (already validated nonzero halves).
        mov [rdi + 40], rcx;

        // [+48] offset_xy verbatim (unconstrained additive offset --
        // zero and negative offsets are both legal).
        mov [rdi + 48], r8;

        // [+56] enum_pack cleaned to its low 24 bits (edge | gravity |
        // adjust); reserved[63:24] stays zero.
        mov rax, r9;
        shl rax, 40;
        shr rax, 40;
        mov [rdi + 56], rax;

        // [+0] header: in_use bit (56) set; consumed bit (55) and
        // every reserved bit stay zero.
        mov r10, 1;
        shl r10, 56;
        mov [rdi + 0], r10;

        xor rax, rax;                       // PPOS_OK
        ret;

      popup_positioner_pm_null:
        mov rax, 0xFFFFE82F;                // POSITIONER_NULL
        ret;
      popup_positioner_pm_bad_parent:
        mov rax, 0xFFFFE826;                // POSITIONER_BAD_PARENT
        ret;
      popup_positioner_pm_bad_edge:
        mov rax, 0xFFFFE82E;                // POSITIONER_ANCHOR_INVALID
        ret;
      popup_positioner_pm_bad_gravity:
        mov rax, 0xFFFFE82D;                // POSITIONER_GRAVITY_INVALID
        ret;
      popup_positioner_pm_bad_adjust:
        mov rax, 0xFFFFE82C;                // POSITIONER_ADJUST_INVALID
        ret;
      popup_positioner_pm_rect_empty:
        mov rax, 0xFFFFE82B;                // POSITIONER_ANCHOR_RECT_EMPTY
        ret;
      popup_positioner_pm_size_invalid:
        mov rax, 0xFFFFE82A;                // POSITIONER_SIZE_INVALID
        ret
      }
    }

  // ==========================================================================
  // SECTION 14 -- LINEAR CONSUME: popup_positioner_consume
  // ==========================================================================
  //
  // popup_positioner_consume(row_ptr, out_ptr) -> u64
  //
  //   The single consume-point a future popup_map wire-body calls
  //   immediately before minting the KIND_XDG_POPUP row -- the LINEAR
  //   discipline the header's NOVEL-CLEAN DIVERGENCE note names.
  //   Refuses POSITIONER_NOT_INIT (in_use bit clear) or POSITIONER_
  //   ALREADY_CONSUMED (consumed bit already set); succeeds exactly
  //   once per mint, copying the row's five payload words ([+24]..
  //   [+56]) into a caller-supplied 40-byte out_ptr and stamping the
  //   consumed bit.
  //
  //   INTEROP POINT: out_ptr[0..16) reproduces xdg_popup_mint's own
  //   16-byte anchor_ptr shape verbatim; out_ptr[24..32) reproduces its
  //   offset_pack; the low 16 bits of out_ptr[32..40) reproduce its
  //   edge_gravity_pack (this row's extra byte at out_ptr[34] carries
  //   constraint_adjust, which xdg_popup_mint simply has no slot for
  //   and ignores at that width). A future popup-map landing can call
  //   xdg_popup_mint with anchor_ptr=out_ptr, offset_pack=*(out_ptr+24),
  //   edge_gravity_pack=*(out_ptr+32) -- no repacking step.
  pub let popup_positioner_consume : (u64, u64) -> u64 !{mem} @{} =
    fn (row_ptr: u64) (out_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B14 G7-M8-006 (paideia-os #2264): linear consume gate. Order: null gates on both pointers, in_use-bit gate (POSITIONER_NOT_INIT), consumed-bit gate (POSITIONER_ALREADY_CONSUMED), five-word payload copy to out_ptr, consumed-bit stamp preserving in_use + reserved. Single-bit tests isolate the bit via shl(63-K)/shr63 rather than AND-immediate. No nested call; two args, no stack spill. Labels prefixed popup_positioner_cs_.",
      block: {
        cmp rdi, 0;
        je  popup_positioner_cs_null;
        cmp rsi, 0;
        je  popup_positioner_cs_null;

        mov rax, [rdi + 0];

        // in_use bit (56): isolate via shl 7 / shr 63.
        mov r10, rax;
        shl r10, 7;
        shr r10, 63;
        cmp r10, 0;
        je  popup_positioner_cs_not_init;

        // consumed bit (55): isolate via shl 8 / shr 63.
        mov r10, rax;
        shl r10, 8;
        shr r10, 63;
        cmp r10, 0;
        jne popup_positioner_cs_already;

        // Copy the five payload words [+24..+63] into out_ptr[0..39].
        mov r10, [rdi + 24];
        mov [rsi + 0], r10;
        mov r10, [rdi + 32];
        mov [rsi + 8], r10;
        mov r10, [rdi + 40];
        mov [rsi + 16], r10;
        mov r10, [rdi + 48];
        mov [rsi + 24], r10;
        mov r10, [rdi + 56];
        mov [rsi + 32], r10;

        // Stamp the consumed bit (55). rax still holds the original
        // header word, so in_use (56) and reserved bits are preserved
        // by OR-ing into it rather than re-deriving from scratch.
        mov r10, 1;
        shl r10, 55;
        or  rax, r10;
        mov [rdi + 0], rax;

        xor rax, rax;                       // PPOS_OK
        ret;

      popup_positioner_cs_null:
        mov rax, 0xFFFFE82F;                // POSITIONER_NULL
        ret;
      popup_positioner_cs_not_init:
        mov rax, 0xFFFFE828;                // POSITIONER_NOT_INIT
        ret;
      popup_positioner_cs_already:
        mov rax, 0xFFFFE827;                // POSITIONER_ALREADY_CONSUMED
        ret
      }
    }

  // ==========================================================================
  // SECTION 15 -- ACCESSORS / PREDICATES (pure leaves)
  // ==========================================================================
  //
  // Every accessor takes row_ptr in rdi and returns in rax. A null
  // row_ptr is undefined behavior at this level, mirroring bidi_
  // caret_get_* / xdg_popup_has_grab precedent. No nested call
  // anywhere in this section.

  // popup_positioner_is_minted(row_ptr) -> 1 iff in_use bit (56) set.
  pub let popup_positioner_is_minted : (u64) -> u64 !{mem} @{} =
    fn (row_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B14 G7-M8-006 (#2264): isolate header bit 56 via shl 7 / shr 63. Labels prefixed popup_positioner_im_.",
      block: {
        mov rax, [rdi + 0];
        shl rax, 7;
        shr rax, 63;
        ret
      }
    }

  // popup_positioner_is_consumed(row_ptr) -> 1 iff consumed bit (55) set.
  pub let popup_positioner_is_consumed : (u64) -> u64 !{mem} @{} =
    fn (row_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B14 G7-M8-006 (#2264): isolate header bit 55 via shl 8 / shr 63. Labels prefixed popup_positioner_ic_.",
      block: {
        mov rax, [rdi + 0];
        shl rax, 8;
        shr rax, 63;
        ret
      }
    }

  // popup_positioner_get_anchor_edge(row_ptr) -> enum_pack[7:0].
  pub let popup_positioner_get_anchor_edge : (u64) -> u64 !{mem} @{} =
    fn (row_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B14 G7-M8-006 (#2264): read anchor_edge from enum_pack[7:0] at row_ptr+56. Byte isolated via shl 56 / shr 56. Labels prefixed popup_positioner_ge_.",
      block: {
        mov rax, [rdi + 56];
        shl rax, 56;
        shr rax, 56;
        ret
      }
    }

  // popup_positioner_get_gravity(row_ptr) -> enum_pack[15:8].
  pub let popup_positioner_get_gravity : (u64) -> u64 !{mem} @{} =
    fn (row_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B14 G7-M8-006 (#2264): read gravity from enum_pack[15:8] at row_ptr+56. Labels prefixed popup_positioner_gg_.",
      block: {
        mov rax, [rdi + 56];
        shr rax, 8;
        shl rax, 56;
        shr rax, 56;
        ret
      }
    }

  // popup_positioner_get_constraint_adjust(row_ptr) -> enum_pack[23:16].
  pub let popup_positioner_get_constraint_adjust : (u64) -> u64 !{mem} @{} =
    fn (row_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B14 G7-M8-006 (#2264): read constraint_adjust from enum_pack[23:16] at row_ptr+56. Labels prefixed popup_positioner_ga_.",
      block: {
        mov rax, [rdi + 56];
        shr rax, 16;
        shl rax, 56;
        shr rax, 56;
        ret
      }
    }

  // popup_positioner_get_parent_window(row_ptr) -> parent_window_kind_id.
  // Already u32-clean from the mint-time commit write; a full u64 read
  // needs no further masking.
  pub let popup_positioner_get_parent_window : (u64) -> u64 !{mem} @{} =
    fn (row_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B14 G7-M8-006 (#2264): read parent_window_kind_id from row_ptr+16 (already zero-extended to u32 at mint time). Labels prefixed popup_positioner_gp_.",
      block: {
        mov rax, [rdi + 16];
        ret
      }
    }
}
