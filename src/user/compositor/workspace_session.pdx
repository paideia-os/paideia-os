  // workspace_session_find_by_pair(workspace_id, window_kind_id) ->
  //     row_id | WSESS_ROW_NONE.
  // Linear scan for the (workspace_id, window_kind_id) composite key.
  // Used by the restore path to check "already restored this
  // window" before calling workspace_place_window.
  pub let workspace_session_find_by_pair : (u64, u64) -> u64 !{mem} @{} =
    fn (workspace_id: u64) (window_kind_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B12-03 (#2290): linear scan for (workspace_id, window_kind_id) pair in word0[31:0] + word1[31:0] of every live row. Four callee-save pushes (rbx=cursor, r12=workspace_id, r13=window_kind_id, r14=row base) leave rsp%16==8; sub rsp,8 aligns for no-nested-call scan. Labels prefixed workspace_session_fbp_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        sub rsp, 8;

        mov r12, rdi;
        mov r13, rsi;
        xor rbx, rbx;

      workspace_session_fbp_scan:
        cmp rbx, 64;
        jae workspace_session_fbp_none;
        lea r10, [rip + _wsess_entries];
        mov r11, rbx;
        imul r11, r11, 32;
        add r10, r11;
        mov r14, r10;

        mov rax, [r14 + 0];
        mov r11, rax;
        shr r11, 56;
        cmp r11, 0;
        je  workspace_session_fbp_step;

        and rax, 0xFFFFFFFF;
        cmp rax, r12;
        jne workspace_session_fbp_step;

        mov rax, [r14 + 8];
        and rax, 0xFFFFFFFF;
        cmp rax, r13;
        jne workspace_session_fbp_step;

        mov rax, rbx;
        jmp workspace_session_fbp_out;

      workspace_session_fbp_step:
        add rbx, 1;
        jmp workspace_session_fbp_scan;

      workspace_session_fbp_none:
        mov rax, 0xFFFFE9F0;

      workspace_session_fbp_out:
        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Section 11  workspace_session_add_entry
  // ==========================================================================
  //
  // workspace_session_add_entry(workspace_id, window_kind_id,
  //                             app_pkg_offset, geom_x, geom_y,
  //                             geom_w, geom_h, state)
  //     -> row_id | WSESS_ADD_* sentinel.
  //
  // The SysV x86_64 ABI passes the first six args in
  // rdi/rsi/rdx/rcx/r8/r9; the seventh (geom_h) and eighth (state)
  // arrive on the stack at [rsp+8] / [rsp+16] on function entry
  // (with the return address at [rsp+0]).
  //
  // Gate order (fail-fast; refusal funnel bumps _wsess_stats no
  // separate refused-counter kept -- add_entry callers can inspect
  // the returned sentinel):
  //   (1) workspace_id fits in u32            -> WSESS_ADD_BAD_WORKSPACE
  //   (2) window_kind_id in (0, u32max]       -> WSESS_ADD_BAD_WINDOW
  //   (3) app_pkg_offset fits in u32          -> WSESS_ADD_BAD_PKG
  //   (4) geom_x, geom_y valid i32-in-i64     -> WSESS_ADD_BAD_GEOM
  //   (5) geom_w, geom_h positive i32         -> WSESS_ADD_BAD_GEOM
  //   (6) state fits in u8                    -> WSESS_ADD_BAD_STATE
  //   (7) pack word0/word1/word2/word3 +
  //         tail_alloc                        -> row_id | WSESS_TAIL_ENOSPC
  //
  // On success, bumps _wsess_stats[WSESS_ST_ADDS] and returns row_id.
  //
  // Register / stack discipline:
  //   entry: rsp%16 == 8 (post-CALL).
  //   pushes: rbx r12 r13 r14 r15 = 40 bytes, aligned rsp%16 == 0.
  //   sub rsp, 16 -> total frame 56 bytes, rsp%16 == 0 for nested
  //     calls; the 16-byte scratch holds geom_w at [rsp+0] with
  //     [rsp+8] reserved (padding, keeps 16-byte alignment).
  //   stashed-args mapping into callee-save:
  //     rbx = workspace_id (rdi)
  //     r12 = window_kind_id (rsi)
  //     r13 = app_pkg_offset (rdx)
  //     r14 = geom_x (rcx)
  //     r15 = geom_y (r8)
  //   The three remaining args (geom_w in r9 stashed at [rsp+0],
  //     geom_h at [rsp+64], state at [rsp+72]) are loaded on
  //     demand. After the prologue, the return address is at
  //     [rsp+56], geom_h at [rsp+64], state at [rsp+72] (56 = 40
  //     pushes + 16 sub).
  pub let workspace_session_add_entry : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (workspace_id: u64) (window_kind_id: u64) (app_pkg_offset: u64) (geom_xy_packed: u64) (geom_wh_packed: u64) (state: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B12-03 (#2290): add one WorkspaceSessionEntry row. paideia-as B1708 caps unsafe lambdas at 6 args, so x+y are packed into geom_xy_packed (x[31:0]|y[63:32]) and w+h into geom_wh_packed (w[31:0]|h[63:32]). Unpacks inline via shl 32/shr 32. Labels prefixed workspace_session_add_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 32;

        mov rbx, rdi;                     // workspace_id
        mov r12, rsi;                     // window_kind_id
        mov r13, rdx;                     // app_pkg_offset
        // Unpack geom_xy_packed (rcx) into geom_x (r14) and geom_y ([rsp+16]).
        mov r14, rcx;
        shl r14, 32;
        shr r14, 32;                      // r14 = geom_x (low 32 of rcx)
        mov r15, rcx;
        shr r15, 32;                      // r15 = geom_y (high 32 of rcx)
        mov [rsp + 16], r15;              // scratch slot: geom_y
        // Unpack geom_wh_packed (r8) into geom_w ([rsp+0]) and geom_h ([rsp+8]).
        mov r15, r8;
        shl r15, 32;
        shr r15, 32;                      // r15 = geom_w
        mov [rsp + 0], r15;               // scratch: geom_w
        mov r15, r8;
        shr r15, 32;                      // r15 = geom_h
        mov [rsp + 8], r15;               // scratch: geom_h
        mov [rsp + 24], r9;               // scratch: state
        mov r15, [rsp + 16];              // r15 = geom_y

        // (1) workspace_id fits in u32.
        mov rdi, rbx;
        call workspace_session_u32_valid;
        cmp rax, 0;
        je  workspace_session_add_bad_workspace;

        // (2) window_kind_id nonzero and in u32.
        mov rdi, r12;
        call workspace_session_window_valid;
        cmp rax, 0;
        je  workspace_session_add_bad_window;

        // (3) app_pkg_offset fits in u32.
        mov rdi, r13;
        call workspace_session_u32_valid;
        cmp rax, 0;
        je  workspace_session_add_bad_pkg;

        // (4a) geom_x valid i32.
        mov rdi, r14;
        call workspace_session_i32_valid;
        cmp rax, 0;
        je  workspace_session_add_bad_geom;

        // (4b) geom_y valid i32.
        mov rdi, r15;
        call workspace_session_i32_valid;
        cmp rax, 0;
        je  workspace_session_add_bad_geom;

        // (5a) geom_w > 0 and <= 0x7FFFFFFF.
        mov rdi, [rsp + 0];               // geom_w
        call workspace_session_extent_valid;
        cmp rax, 0;
        je  workspace_session_add_bad_geom;

        // (5b) geom_h > 0 and <= 0x7FFFFFFF. Load from local scratch.
        mov rdi, [rsp + 8];               // geom_h (unpacked to local)
        call workspace_session_extent_valid;
        cmp rax, 0;
        je  workspace_session_add_bad_geom;

        // (6) state fits in u8. Load from local scratch.
        mov rdi, [rsp + 24];              // state (local scratch)
        call workspace_session_state_valid;
        cmp rax, 0;
        je  workspace_session_add_bad_state;

        // (7a) Pack word0 = (workspace_id, state).
        mov rdi, rbx;
        mov rsi, [rsp + 24];              // state
        call workspace_session_word0_pack;
        mov rbx, rax;                     // rbx = word0 (workspace_id no longer needed)

        // (7b) Pack word1 = (window_kind_id, app_pkg_offset).
        mov rdi, r12;
        mov rsi, r13;
        call workspace_session_word1_pack;
        mov r12, rax;                     // r12 = word1

        // (7c) Pack word2 = (geom_x, geom_y).
        mov rdi, r14;
        mov rsi, r15;
        call workspace_session_word2_pack;
        mov r13, rax;                     // r13 = word2

        // (7d) Pack word3 = (geom_w, geom_h).
        mov rdi, [rsp + 0];               // geom_w
        mov rsi, [rsp + 8];               // geom_h (local scratch)
        call workspace_session_word3_pack;
        mov r14, rax;                     // r14 = word3

        // (7e) tail_alloc(word0, word1, word2, word3).
        mov rdi, rbx;
        mov rsi, r12;
        mov rdx, r13;
        mov rcx, r14;
        call workspace_session_tail_alloc;

        mov r10, 64;
        cmp rax, r10;
        jae workspace_session_add_enospc; // rax already the sentinel

        // Success: bump adds counter, preserve row_id across the note call.
        mov rbx, rax;
        mov rdi, 0;                       // WSESS_ST_ADDS
        call workspace_session_note;
        mov rax, rbx;
        jmp workspace_session_add_out;

      workspace_session_add_bad_workspace:
        mov rax, 0xFFFFE9FD;
        jmp workspace_session_add_out;
      workspace_session_add_bad_window:
        mov rax, 0xFFFFE9FC;
        jmp workspace_session_add_out;
      workspace_session_add_bad_pkg:
        mov rax, 0xFFFFE9FB;
        jmp workspace_session_add_out;
      workspace_session_add_bad_geom:
        mov rax, 0xFFFFE9FA;
        jmp workspace_session_add_out;
      workspace_session_add_bad_state:
        mov rax, 0xFFFFE9F9;
        jmp workspace_session_add_out;
      workspace_session_add_enospc:
        // rax already WSESS_TAIL_ENOSPC (0xFFFFE9FF).

      workspace_session_add_out:
        add rsp, 32;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Section 12  Enumeration
  // ==========================================================================
  //
  // workspace_session_enumerate_next(from_cursor) -> row_id |
  //                                                  WSESS_ENUM_END.
  //
  // Iteration primitive over the entry pool. Caller starts with
  // from_cursor == 0; on each hit, calls again with (row_id + 1).
  // Returns WSESS_ENUM_END (0xFFFFE9F7) when no more live rows.
  // Skips revoked / uninitialised rows. Bounded by WSESS_MAX (64);
  // worst-case scan is O(WSESS_MAX) per call. This is the ONE
  // enumeration primitive exposed; downstream code composes higher-
  // level iterators (filter-by-workspace, filter-by-pkg) by calling
  // this in a loop and applying the predicate against the row-field
  // query helpers.
  pub let workspace_session_enumerate_next : (u64) -> u64 !{mem} @{} =
    fn (from_cursor: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B12-03 (#2290): scan from row from_cursor to WSESS_MAX for the first live row. One callee-save push (rbx=cursor) is enough -- no nested calls in the scan body. Labels prefixed workspace_session_en_.",
      block: {
        push rbx;
        mov rbx, rdi;

      workspace_session_en_scan:
        cmp rbx, 64;
        jae workspace_session_en_end;
        lea r10, [rip + _wsess_entries];
        mov r11, rbx;
        imul r11, r11, 32;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        jne workspace_session_en_hit;
        add rbx, 1;
        jmp workspace_session_en_scan;

      workspace_session_en_hit:
        mov rax, rbx;
        jmp workspace_session_en_out;
      workspace_session_en_end:
        mov rax, 0xFFFFE9F7;

      workspace_session_en_out:
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Section 13  workspace_session_save / workspace_session_restore
  // ==========================================================================
  //
  // workspace_session_save(user_fp_offset) -> entry_count | err.
  //
  // Directly walks the sibling module's _wksp_table row pool
  // (declared pub in workspace_kind.pdx §Section 6). This is a
  // LOAD-ONLY consumer of the sibling pool -- no mutation. Same
  // shape as calling workspace_enumerate_next + workspace_row_id +
  // workspace_row_active_window would give, but open-coded here so
  // this module does not need a cross-module call (matches the
  // recovery_plane_takeover.pdx pattern of directly reading
  // _recovery_plane_reservation_cell from the sibling reservation
  // module, and the workspace_switch.pdx pattern of open-coding
  // workspace_switch_wksp_find over _wksp_table). If the sibling
  // ever bumps its WKSP_MAX constant, this loop bound widens in
  // step -- kept as a numeric literal here to preserve the encoder-
  // conservative constant-load pattern.
  //
  // For each live workspace, records ONE ENTRY per workspace
  // (workspace_id + active_window) into _wsess_entries via
  // workspace_session_add_entry, and returns the number of entries
  // written. The user_fp_offset is the interned-table offset naming
  // the user this snapshot belongs to; it is not stored in the
  // entry pool (a session snapshot is per-user by construction of
  // the caller's file-path) but MUST fit in u32 for consistency
  // with the workspace_kind.pdx name-offset convention.
  //
  // Per-window geometry (x, y, w, h) is not observable from the
  // KIND_WORKSPACE row (it lives on xdg_shell_geometry siblings);
  // this landing records (x=0, y=0, w=1, h=1) as a placeholder
  // triangle so the row survives the extent-valid gate. A follow-on
  // landing that walks the KIND_WINDOW pool for the true geometry
  // replaces the placeholder with the observed value. State byte
  // defaults to WSESS_STATE_NORMAL.
  //
  // If a workspace's active_window is 0 ("no active window"), the
  // workspace is SKIPPED (a session with no visible window in a
  // workspace is a stable state, not a rehydration target).
  //
  // Callee-save discipline: five pushes (rbx=fp_offset, r12=count,
  // r13=cursor, r14=workspace_id, r15=active_window) = 40 bytes;
  // entry rsp%16==8 so rsp%16==0 after the pushes -- aligned for
  // nested calls with NO extra sub rsp,8. Two-arg stack push inside
  // the loop (state then geom_h) keeps alignment across the nested
  // add_entry call.
  pub let workspace_session_save : (u64) -> u64 !{mem} @{} =
    fn (user_fp_offset: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B12-03 (#2290): save one session snapshot. Refuses user_fp_offset > u32. Open-codes a linear scan over _wksp_table (16 rows, 32-byte stride); for each live workspace, reads workspace_id (word0[31:0]) and active_window (word2[31:0]), then calls workspace_session_add_entry with (workspace_id, active_window, pkg=0, x=0, y=0, w=1, h=1, state=0). Skips workspaces with active_window==0. Five callee-save pushes = 40 bytes; rsp%16==0 for nested calls with no extra sub rsp,8. Labels prefixed workspace_session_sv_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                     // user_fp_offset

        // Validate fp offset.
        mov rdi, rbx;
        call workspace_session_u32_valid;
        cmp rax, 0;
        je  workspace_session_sv_bad_fp;

        xor r12, r12;                     // count = 0
        xor r13, r13;                     // cursor = 0

      workspace_session_sv_loop:
        cmp r13, 16;                      // WKSP_MAX
        jae workspace_session_sv_done;

        // Load _wksp_table row r13.
        lea r10, [rip + _wksp_table];
        mov r11, r13;
        imul r11, r11, 32;
        add r10, r11;

        // Check in_use (word0[63:56]).
        mov rax, [r10 + 0];
        mov r11, rax;
        shr r11, 56;
        cmp r11, 0;
        je  workspace_session_sv_step;

        // Extract workspace_id (word0[31:0]).
        mov r14, rax;
        and r14, 0xFFFFFFFF;

        // Extract active_window (body2 [+16] low 32 bits).
        mov rax, [r10 + 16];
        and rax, 0xFFFFFFFF;
        cmp rax, 0;
        je  workspace_session_sv_step;
        mov r15, rax;

        // Call workspace_session_add_entry(workspace_id,
        //   active_window, pkg=0, x=0, y=0, w=1, h=1, state=0).
        // First six args in rdi/rsi/rdx/rcx/r8/r9; args 7 and 8 go
        // on the stack. Current rsp%16 == 0. Pushing two 8-byte
        // args keeps alignment. Push in reverse order so arg7
        // (geom_h) sits at rsp+0 and arg8 (state) at rsp+8 just
        // before the CALL (which itself pushes the 8-byte return
        // address). After the call, arg7 is at rsp+8 and arg8 at
        // rsp+16 from the callee's frame.
        mov rdi, r14;                     // workspace_id
        mov rsi, r15;                     // window_kind_id (active_window)
        xor rdx, rdx;                     // pkg = 0
        xor rcx, rcx;                     // geom_x = 0
        xor r8, r8;                       // geom_y = 0
        mov r9, 1;                        // geom_w = 1
        mov rax, 0;                       // state = 0 (arg 8)
        push rax;
        mov rax, 1;                       // geom_h = 1 (arg 7)
        push rax;
        call workspace_session_add_entry;
        add rsp, 16;

        // If add returned an error sentinel (rax >= WSESS_MAX = 64),
        // skip counting but keep going -- one bad row must not abort
        // the whole snapshot.
        cmp rax, 64;
        jae workspace_session_sv_step;
        add r12, 1;                       // count++

      workspace_session_sv_step:
        add r13, 1;
        jmp workspace_session_sv_loop;

      workspace_session_sv_done:
        // Bump saves counter, then return count.
        mov rdi, 1;                       // WSESS_ST_SAVES
        call workspace_session_note;
        mov rax, r12;
        jmp workspace_session_sv_out;

      workspace_session_sv_bad_fp:
        mov rax, 0xFFFFE9F6;

      workspace_session_sv_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // workspace_session_restore(user_fp_offset) -> entry_count | err.
  //
  // Walks the _wsess_entries table (as if reloaded from disk) and
  // re-installs each entry by calling workspace_place_window(
  // workspace_row, window_kind_id). Returns the number of entries
  // successfully re-installed. If workspace_place_window returns
  // nonzero for any entry, restore halts, bumps WSESS_ST_RESTORE_
  // FAIL, and returns WSESS_RESTORE_BAD_ROW so the caller can decide
  // whether to keep the partial restoration or roll back.
  //
  // Preconditions the CALLER guarantees:
  //   (1) The KIND_WORKSPACE rows named by each entry's workspace_id
  //       already exist (a prior boot-phase re-minted them via
  //       workspace_mint using the persisted created_at_seq order).
  //   (2) The KIND_WINDOW rows named by each entry's window_kind_id
  //       already exist (the app-respawn path did the workspace_
  //       session_row_pkg_offset -> exec dance before this restore).
  //
  // Both preconditions are the SESSION-BOOT ORCHESTRATOR's job; this
  // module only wires the entry->place_window mechanical step.
  //
  // Open-codes the workspace-lookup + window-count-bump against
  // _wksp_table rather than cross-calling workspace_find_by_id +
  // workspace_place_window, following the recovery_plane_takeover
  // / workspace_switch precedent. The mutation is the SAME single-
  // word update workspace_place_window performs: it decodes
  // body1[63:32] (window_count), refuses u32-overflow, adds 1, and
  // stores back -- verbatim from the workspace_kind.pdx §Section 12
  // encoder. This module does NOT set body2[31:0] (active_window)
  // -- placement and activation are separate ops in the sibling
  // (workspace_kind.pdx §Section 12 comment). A future landing that
  // wants to snap focus back to the persisted active_window uses
  // the entry's window_kind_id via workspace_session_row_window_
  // kind_id and calls workspace_activate itself.
  //
  // Callee-save discipline: four pushes (rbx=fp, r12=count,
  // r13=cursor, r14=workspace row base) leave rsp%16==8; sub rsp,8
  // aligns for nested calls at rsp%16==0.
  pub let workspace_session_restore : (u64) -> u64 !{mem} @{} =
    fn (user_fp_offset: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B12-03 (#2290): restore one session snapshot. Refuses user_fp_offset > u32. Walks _wsess_entries via workspace_session_enumerate_next; for each entry, resolves entry.workspace_id -> _wksp_table row via open-coded linear scan, then bumps that row's window_count (body1[63:32]) mirroring workspace_place_window. Halts on the first mismatch or overflow with WSESS_RESTORE_BAD_ROW. Four callee-save pushes + sub rsp,8 = 40 bytes; rsp%16==0 for nested calls. Labels prefixed workspace_session_rs_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        sub rsp, 8;

        mov rbx, rdi;                     // user_fp_offset

        // Validate fp offset.
        mov rdi, rbx;
        call workspace_session_u32_valid;
        cmp rax, 0;
        je  workspace_session_rs_bad_fp;

        xor r12, r12;                     // count = 0
        xor r13, r13;                     // cursor = 0

      workspace_session_rs_loop:
        mov rdi, r13;
        call workspace_session_enumerate_next;
        mov r10, 0xFFFFE9F7;              // WSESS_ENUM_END
        cmp rax, r10;
        je  workspace_session_rs_done;
        cmp rax, 64;                      // WSESS_MAX
        jae workspace_session_rs_done;

        // r13 = entry row_id.
        mov r13, rax;

        // Read workspace_id from this entry.
        mov rdi, r13;
        call workspace_session_row_workspace_id;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  workspace_session_rs_bad_row;
        mov [rsp + 0], rax;               // scratch: workspace_id

        // Read window_kind_id from this entry (validate later).
        mov rdi, r13;
        call workspace_session_row_window_kind_id;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  workspace_session_rs_bad_row;
        cmp rax, 0;
        je  workspace_session_rs_bad_row;

        // Open-coded scan of _wksp_table for a live row whose
        // word0[31:0] matches [rsp+0]. Uses r14 as row base on hit.
        xor r11, r11;                     // wksp cursor
      workspace_session_rs_wksp_scan:
        cmp r11, 16;                      // WKSP_MAX
        jae workspace_session_rs_bad_row;
        lea r10, [rip + _wksp_table];
        mov r14, r11;
        imul r14, r14, 32;
        add r10, r14;
        mov r14, r10;                     // r14 = row base
        mov rax, [r14 + 0];
        mov r10, rax;
        shr r10, 56;
        cmp r10, 0;
        je  workspace_session_rs_wksp_step;
        and rax, 0xFFFFFFFF;
        mov r10, [rsp + 0];
        cmp rax, r10;
        je  workspace_session_rs_wksp_hit;
      workspace_session_rs_wksp_step:
        add r11, 1;
        jmp workspace_session_rs_wksp_scan;

      workspace_session_rs_wksp_hit:
        // Bump window_count in body1[63:32] of the row at r14.
        // Refuse u32 overflow.
        mov rax, [r14 + 8];
        mov r11, rax;
        shr r11, 32;                      // r11 = window_count
        mov r10, 0xFFFFFFFF;
        cmp r11, r10;
        jae workspace_session_rs_bad_row;
        add r11, 1;
        and rax, 0xFFFFFFFF;              // keep name_offset (low 32)
        shl r11, 32;
        or  rax, r11;
        mov [r14 + 8], rax;

        add r12, 1;                       // count++

        add r13, 1;                       // step entry cursor
        jmp workspace_session_rs_loop;

      workspace_session_rs_done:
        // Bump restores counter, return count.
        mov rdi, 2;                       // WSESS_ST_RESTORES
        call workspace_session_note;
        mov rax, r12;
        jmp workspace_session_rs_out;

      workspace_session_rs_bad_fp:
        mov rax, 0xFFFFE9F5;
        jmp workspace_session_rs_out;

      workspace_session_rs_bad_row:
        mov rdi, 3;                       // WSESS_ST_RESTORE_FAIL
        call workspace_session_note;
        mov rax, 0xFFFFE9F4;

      workspace_session_rs_out:
        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Section 14  Boot init.
  // ==========================================================================

  pub let workspace_session_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B12-03 (#2290): call through to workspace_session_stats_reset for one clean pool + counter zero-out. Labels prefixed workspace_session_i_.",
      block: {
        call workspace_session_stats_reset;
        ret
      }
    }
}
