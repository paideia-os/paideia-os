// src/user/compositor/workspace_session.pdx -- Wave0-B12-03 (paideia-os #2290)
//
// WorkspaceSession -- per-workspace window-set persistence + save/restore.
// Design authority: design/compositor/pwp-spec-vocabulary.md §2.13
// (KIND_WORKSPACE), the "workspace persistence hook (#2290)" citation
// in workspace_kind.pdx §2 ("created_at_seq stamp used by the workspace
// persistence hook (#2290) to replay workspaces in creation order on
// session restore"). Depends on G9-M1-001 (workspace_kind.pdx LANDED
// B8-02, KIND_WORKSPACE at 0x1D2). This landing does NOT re-declare
// KIND_WORKSPACE and does NOT allocate a new KIND_* slot -- it is a
// pure logic module sitting under svc-compositor's session-lifecycle
// path (see §0 below).
//
// On logout / reboot the compositor calls workspace_session_save to
// snapshot every live workspace's window set (open apps, geometry,
// state) into an entry table that a later fs landing serialises to
// /system/prefs/session/<user_fingerprint>/workspace_N.pdxsess. On
// login the reverse path calls workspace_session_restore, which walks
// the deserialised entries and re-installs each window into its
// original workspace at its original geometry.
//
// =============================================================================
// SECTION 0  WHY THIS IS A LOGIC MODULE, NOT A KIND CAP
// =============================================================================
//
// A session-persistence table is COMPOSITOR-INTERNAL state: the
// entry table is minted at logout by the compositor's session-lifecycle
// path, consumed once by the login-time restore path, and dies with
// the compositor process. Handing a raw cap for the entry pool to a
// client would let the client forge session state (fake "this window
// used to be at (X, Y)") past the compositor's placement policy,
// which is exactly the trust-boundary hazard the design authority
// avoids by scoping session-persistence to svc-compositor's own
// process-boundary.
//
// Sibling precedent: workspace_switch.pdx (B9-05) makes the identical
// "value type, not KIND cap" call for the same reason -- switch
// transactions are compositor-internal atomic-commit state, not a
// client-visible authority. tiling_bsp.pdx (B8-08) is the canonical
// statement of the rule (its §0 WHY THIS IS A VALUE TYPE, NOT A KIND
// CAP). This landing applies it to session-persistence entries.
//
// A future landing that wants a client-observable "session save in
// flight" indicator (e.g. so an a11y consumer can announce "saving
// session before logout") will publish a PROJECTION through a distinct
// observer capability, mirroring KIND_A11Y_TREE's read-only binding,
// rather than exposing the entry-table rows themselves.
//
// =============================================================================
// SECTION 1  KIND_* SLOT ALLOCATION
// =============================================================================
//
// N/A -- logic module. No KIND_WORKSPACE_SESSION slot. The parent
// authority that gates who may call workspace_session_save /
// workspace_session_restore is the compositor's own process boundary
// (svc-compositor holds the gate as a process-internal invariant,
// same posture as tiling_bsp arenas and workspace_switch txns).
//
// =============================================================================
// SECTION 2  WorkspaceSessionEntry ROW LAYOUT -- 32 BYTES (FOUR u64 WORDS)
// =============================================================================
//
//   [+0]  word0: in_use[63:56] | state[55:48] | reserved[47:32] |
//                workspace_id[31:0]
//   [+8]  word1: app_pkg_offset[63:32] | window_kind_id[31:0]
//   [+16] word2: geometry_y[63:32] | geometry_x[31:0]
//   [+24] word3: geometry_h[63:32] | geometry_w[31:0]
//
// workspace_id : u32 -- caller-provided, matches KIND_WORKSPACE row's
//   header[31:0] (workspace_kind.pdx §2). A single workspace may
//   appear in MULTIPLE entries (once per open window on that
//   workspace); the (workspace_id, window_kind_id) pair is the
//   session-entry composite key. Uniqueness is a caller property,
//   not enforced here -- a workspace with two identical window rows
//   is legal (and preserved verbatim across a restore cycle).
//
// window_kind_id : u32 -- the KIND_WINDOW row this entry snapshots.
//   Value 0 is refused (WSESS_ADD_BAD_WINDOW), matching the "0 = no
//   active window" sentinel workspace_kind.pdx §2 documents. On
//   restore, this id is passed to workspace_place_window to re-install
//   the window in its recorded workspace.
//
// app_pkg_offset : u32 -- offset into the compositor's interned
//   package-name table naming the application to respawn on restore
//   (e.g. "org.paideia.editor"). MAY be zero for "already-running,
//   do not respawn" (used when a window belongs to a system service
//   that persists across the session boundary). No inline string
//   storage -- keeps the row cap fixed-size and shares the interned
//   table with the a11y-tree name/description fields and workspace_
//   kind name_offset.
//
// geometry_x, geometry_y : i32 -- signed screen coordinates of the
//   window origin. Stored as raw u32 bit-patterns; the row-field
//   query helpers hand back the raw bits and the caller sign-extends
//   into i64 as needed (matches the z_order_slot posture in
//   window_kind.pdx §2 comment). Negative values legal: a window on
//   an output whose logical origin is not (0, 0) may sit at negative
//   pixel coords in the compositor's global coordinate space.
//
// geometry_w, geometry_h : i32 -- signed width / height. Negative
//   values are STRUCTURALLY LEGAL (i32 bit-pattern) but SEMANTICALLY
//   REFUSED (WSESS_ADD_BAD_GEOM) -- a window with negative extent
//   would restore in a non-renderable configuration. Zero extent is
//   also refused (a zero-width or zero-height window has no visible
//   surface, so persisting it wastes an entry slot).
//
// state : u8 -- WindowState enum value. State values 0..7 are the
//   currently-live vocabulary (see §4 below); higher values reserved
//   for future window states (tiled-left, tiled-right, snapped-quad,
//   ...) which this landing accepts opaquely (WSESS_ADD_BAD_STATE
//   only refuses values that overflow u8, i.e. never for a value
//   passed via the u64 arg register -- the packer masks to u8).
//
// in_use : u8 -- 1 iff the row holds a live entry. Stored at
//   word0[63:56] so a downstream diagnostic that greps the row-empty
//   marker finds it at the top of word0, matching workspace_kind.pdx
//   §2 header layout convention.
//
// All slots stored little-endian. No float leaks into a session-entry
// cap per the FPU-discipline (see design/kernel/no-fpu.md).
//
// Row is 32 bytes = 4 u64 words. Pool is _wsess_entries = [u64; 256]
// = 64 rows * 4 u64. Row indexing is imul r11, r11, 32 (fits in
// imm8) then add to the base -- one-hop into the pool for every row
// access. 64 entries covers a heavily-partitioned session (four
// windows on sixteen workspaces, dwm/i3 convention) without
// over-committing .bss; a future landing that wants a higher ceiling
// bumps this constant and re-derives _wsess_entries size.
//
// =============================================================================
// SECTION 3  FAILURE TAXONOMY 0xFFFFE9F0..0xFFFFE9FF
// =============================================================================
//
// The Wave-0 dispatch manifest for B12-03 named 0xFFFFEB00..0xFFFFEB0F
// as the recommended failure-taxonomy band, but that page is entirely
// claimed by KIND_SIG_KEY (kind_sig_key.pdx §3 owns 0xFFFFEB00..
// 0xFFFFEB0F as the KIND_SIG_KEY page, of which the file actively
// uses 0xFFFFEB08..0xFFFFEB0F and reserves the low half as its
// canonical page). Repo-wide grep at landing time showed EVERY page
// in the 0xFFFFEB00..0xFFFFEBFF band as claimed (workspace_kind.pdx
// EB70..EB7F, KIND_TUI_CANVAS EB10..EB1F, workspace_switch EBB0..EBBF,
// damage_kind EBC0..EBCF, present_feedback_kind EBD0..EBDF, a11y_
// bind_at_mint EBE0..EBEF, screen_reader_protocol EBF0..EBF8, plus
// input_server and kernel occupants in every other page); a full-band
// scan up to 0xFFFFFFFF finds the next fresh 16-slot page at 0xFFFFE9F0.
//
// This landing takes 0xFFFFE9F0..0xFFFFE9FF -- the nearest free
// 16-slot page below the packed EB band. WSESS_ROW_NONE sits at the
// page floor (0xFFFFE9F0) so a downstream diagnostic that greps for
// the "row lookup miss" sentinel finds it as its one canonical name,
// matching the workspace_kind.pdx WKSP_ROW_NONE @ 0xFFFFEB70 posture.
//
//   WSESS_OK                = 0
//   WSESS_TAIL_ENOSPC       = 0xFFFFE9FF   add_entry refused: pool full
//   WSESS_TAIL_BAD_ARG      = 0xFFFFE9FE   internal packer refusal
//   WSESS_ADD_BAD_WORKSPACE = 0xFFFFE9FD   workspace_id > u32 max
//   WSESS_ADD_BAD_WINDOW    = 0xFFFFE9FC   window_kind_id 0 or > u32
//   WSESS_ADD_BAD_PKG       = 0xFFFFE9FB   app_pkg_offset > u32 max
//   WSESS_ADD_BAD_GEOM      = 0xFFFFE9FA   x/y/w/h out of i32 range,
//                                          or w<=0 or h<=0
//   WSESS_ADD_BAD_STATE     = 0xFFFFE9F9   state > u8 max
//   WSESS_BAD_SLOT          = 0xFFFFE9F8   row_id >= WSESS_MAX
//   WSESS_ENUM_END          = 0xFFFFE9F7   enumeration walked off pool
//   WSESS_SAVE_BAD_FP       = 0xFFFFE9F6   save: user_fp_offset >u32
//   WSESS_RESTORE_BAD_FP    = 0xFFFFE9F5   restore: user_fp_offset >u32
//   WSESS_RESTORE_BAD_ROW   = 0xFFFFE9F4   restore: row rejected by
//                                          workspace_place_window
//   WSESS_DECODE_BAD        = 0xFFFFE9F3   row-field decode saw
//                                          an unset in_use bit
//   WSESS_ROW_EMPTY         = 0xFFFFE9F2   query on unallocated row
//   WSESS_RESERVED          = 0xFFFFE9F1   reserved for future use
//   WSESS_ROW_NONE          = 0xFFFFE9F0   sentinel floor / find-miss
//
// =============================================================================
// SECTION 4  WindowState ENUM (INFORMATIONAL)
// =============================================================================
//
//   WSESS_STATE_NORMAL     = 0   -- floating / tiled at native size
//   WSESS_STATE_MAXIMIZED  = 1   -- fills its output's work area
//   WSESS_STATE_MINIMIZED  = 2   -- iconified / hidden from view
//   WSESS_STATE_FULLSCREEN = 3   -- fills entire output, chrome hidden
//   WSESS_STATE_TILED_L    = 4   -- half-tiled left
//   WSESS_STATE_TILED_R    = 5   -- half-tiled right
//   WSESS_STATE_TILED_T    = 6   -- half-tiled top
//   WSESS_STATE_TILED_B    = 7   -- half-tiled bottom
//
// State byte accepts any u8 value (packer masks to 8 bits); values
// 8..255 are reserved for future window states this landing does not
// need to interpret. On restore, the caller reads the raw state byte
// and applies whatever state-transition op matches; unknown values
// fall through to WSESS_STATE_NORMAL by convention.
//
// =============================================================================
// SECTION 5  workspace_session_save / workspace_session_restore
// =============================================================================
//
// SAVE PATH (called from svc-compositor's logout hook):
//
//   workspace_session_save(user_fp_offset) -> entry_count | err.
//
// Iterates the KIND_WORKSPACE pool via workspace_enumerate_next; for
// each live workspace, records ONE ENTRY per workspace (snapshot of
// workspace_id + active window) into _wsess_entries. Returns the
// number of entries written. Refuses if user_fp_offset does not fit
// in u32 (WSESS_SAVE_BAD_FP).
//
// The actual serialisation to /system/prefs/session/<user_fingerprint>/
// workspace_N.pdxsess is stubbed in this landing -- the entry table
// IS the persistence layer at this altitude. A follow-on landing that
// wires the vfs write-path replaces the workspace_session_flush stub
// with a syscall path; the entry-table SEMANTICS ("what needs to be
// written back") stay identical, so no caller of workspace_session_
// save needs to change. This mirrors the workspace_switch cursor-cell
// scaffolding pattern (workspace_switch.pdx §4).
//
// Per-window geometry (x, y, w, h) is not available on the KIND_
// WORKSPACE row (it lives on xdg_shell_geometry siblings); the save
// path records a zero-geometry placeholder for each workspace's
// active window and defers per-window geometry population to a
// downstream landing that walks the KIND_WINDOW pool. The caller
// that wants richer per-window geometry today calls workspace_
// session_add_entry DIRECTLY with the observed x/y/w/h before or
// after workspace_session_save. add_entry is the public authoritative
// entry-creator; save is a bulk-snapshot convenience over it.
//
// RESTORE PATH (called from svc-compositor's login hook):
//
//   workspace_session_restore(user_fp_offset) -> entry_count | err.
//
// Walks the _wsess_entries table (as if reloaded from disk) and
// re-installs each entry by calling workspace_place_window(
// workspace_row, window_kind_id) for the entry's workspace. Refuses
// if user_fp_offset does not fit in u32 (WSESS_RESTORE_BAD_FP). If
// workspace_place_window returns nonzero for any entry, restore
// halts, records the failing sentinel via _wsess_stats[WSESS_ST_
// RESTORE_FAIL], and returns WSESS_RESTORE_BAD_ROW so the caller can
// decide whether to keep the partial restoration or roll back.
//
// The actual deserialisation from disk is stubbed here alongside
// save; a follow-on landing feeds the entry table from the vfs
// read-path before restore is called.

module WorkspaceSession = structure {

  // Row pool sizing.
  pub let WSESS_MAX       : u64 = 64
  pub let WSESS_ROW_BYTES : u64 = 32

  // WindowState enum values (see §4). Not exhaustive; add_entry
  // accepts any u8. Callers of restore read the raw state byte from
  // the row-field query helper and apply whatever state-transition
  // op matches.
  pub let WSESS_STATE_NORMAL     : u64 = 0
  pub let WSESS_STATE_MAXIMIZED  : u64 = 1
  pub let WSESS_STATE_MINIMIZED  : u64 = 2
  pub let WSESS_STATE_FULLSCREEN : u64 = 3
  pub let WSESS_STATE_TILED_L    : u64 = 4
  pub let WSESS_STATE_TILED_R    : u64 = 5
  pub let WSESS_STATE_TILED_T    : u64 = 6
  pub let WSESS_STATE_TILED_B    : u64 = 7
  pub let WSESS_STATE_MAX_U8     : u64 = 0xFF

  // Failure taxonomy 0xFFFFE9F0..0xFFFFE9FF. See §3 for why this page
  // (spec named 0xFFFFEB00..0F but KIND_SIG_KEY already holds the
  // entire page).
  pub let WSESS_OK                : u64 = 0
  pub let WSESS_TAIL_ENOSPC       : u64 = 0xFFFFE9FF
  pub let WSESS_TAIL_BAD_ARG      : u64 = 0xFFFFE9FE
  pub let WSESS_ADD_BAD_WORKSPACE : u64 = 0xFFFFE9FD
  pub let WSESS_ADD_BAD_WINDOW    : u64 = 0xFFFFE9FC
  pub let WSESS_ADD_BAD_PKG       : u64 = 0xFFFFE9FB
  pub let WSESS_ADD_BAD_GEOM      : u64 = 0xFFFFE9FA
  pub let WSESS_ADD_BAD_STATE     : u64 = 0xFFFFE9F9
  pub let WSESS_BAD_SLOT          : u64 = 0xFFFFE9F8
  pub let WSESS_ENUM_END          : u64 = 0xFFFFE9F7
  pub let WSESS_SAVE_BAD_FP       : u64 = 0xFFFFE9F6
  pub let WSESS_RESTORE_BAD_FP    : u64 = 0xFFFFE9F5
  pub let WSESS_RESTORE_BAD_ROW   : u64 = 0xFFFFE9F4
  pub let WSESS_DECODE_BAD        : u64 = 0xFFFFE9F3
  pub let WSESS_ROW_EMPTY         : u64 = 0xFFFFE9F2
  pub let WSESS_RESERVED          : u64 = 0xFFFFE9F1
  pub let WSESS_ROW_NONE          : u64 = 0xFFFFE9F0

  pub let WSESS_U32_MAX : u64 = 0xFFFFFFFF
  pub let WSESS_I32_MAX : u64 = 0x000000007FFFFFFF
  pub let WSESS_I32_MIN : u64 = 0xFFFFFFFF80000000

  // THE ONE STATE CELL. 64 rows * 32 bytes = 2048 bytes = 256 u64.
  pub let mut _wsess_entries : [u64; 256] = uninit @align(64)
  pub let mut _wsess_stats   : [u64; 4]   = uninit @align(64)

  // Stat slots.
  pub let WSESS_ST_ADDS         : u64 = 0
  pub let WSESS_ST_SAVES        : u64 = 1
  pub let WSESS_ST_RESTORES     : u64 = 2
  pub let WSESS_ST_RESTORE_FAIL : u64 = 3

  // Fingerprint tag. Emitted by the compositor on successful
  // workspace_session_save. Legacy suffix gives grep parity with
  // pre-Wave0 boot-log tooling (see e.g. workspace_kind.pdx
  // pdx_kind_workspace_meta).
  pub let pdx_kind_workspace_session_meta : [u8; 50] = "workspace_session save ok [legacy: WSESS SAVE OK]\0"

  // ==========================================================================
  // Section 6  Counter primitives.
  // ==========================================================================

  pub let workspace_session_stats_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B12-03 (#2290): clear entry pool + counters at boot. 64 rows * 4 u64 = 256 u64 for the table, 4 u64 for stats. Labels prefixed workspace_session_rs_.",
      block: {
        lea r10, [rip + _wsess_entries];
        xor rax, rax;
        xor rcx, rcx;
      workspace_session_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 256;
        jb  workspace_session_rs_rows;

        lea r10, [rip + _wsess_stats];
        xor rcx, rcx;
      workspace_session_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  workspace_session_rs_stats;
        ret
      }
    }

  pub let workspace_session_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B12-03 (#2290): counter bump. Encoder-conservative load-inc-store; no add reg,[mem]. Labels prefixed workspace_session_nt_.",
      block: {
        cmp rdi, 4;
        jae workspace_session_nt_out;
        lea r10, [rip + _wsess_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      workspace_session_nt_out:
        ret
      }
    }

  pub let workspace_session_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B12-03 (#2290): counter read. Labels prefixed workspace_session_st_.",
      block: {
        cmp rdi, 4;
        jae workspace_session_st_zero;
        lea r10, [rip + _wsess_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      workspace_session_st_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Section 7  Validators.
  // ==========================================================================

  // workspace_session_u32_valid: 1 iff v fits in 32 bits.
  pub let workspace_session_u32_valid : (u64) -> u64 !{} @{} =
    fn (v: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B12-03 (#2290): 1 iff v <= WSESS_U32_MAX. Labels prefixed workspace_session_uv_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  workspace_session_uv_no;
        mov rax, 1;
        ret;
      workspace_session_uv_no:
        xor rax, rax;
        ret
      }
    }

  // workspace_session_i32_valid: 1 iff v as u64 is either in
  // [0, 0x7FFFFFFF] (positive i32) or in [0xFFFFFFFF80000000,
  // 0xFFFFFFFFFFFFFFFF] (negative i32 sign-extended into u64).
  // Values that fit in u32 but do not sit inside either signed band
  // (i.e. 0x80000000..0xFFFFFFFF interpreted as raw bits) are also
  // ACCEPTED here -- the packer just masks to 32 bits and the field-
  // query helper hands back the raw u32 bit-pattern. The single
  // rejection band is "large positive that would not fit even sign-
  // extended", i.e. 0x0000000080000000..0xFFFFFFFF7FFFFFFF.
  pub let workspace_session_i32_valid : (u64) -> u64 !{} @{} =
    fn (v: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B12-03 (#2290): 1 iff v is a valid i32 (positive band [0, 0x7FFFFFFF] or negative band [0xFFFFFFFF80000000, 0xFFFFFFFFFFFFFFFF]) OR a raw u32 bit-pattern (0..0xFFFFFFFF). Labels prefixed workspace_session_iv_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        jbe workspace_session_iv_yes;
        mov r10, 0xFFFFFFFF80000000;
        cmp rdi, r10;
        jae workspace_session_iv_yes;
        xor rax, rax;
        ret;
      workspace_session_iv_yes:
        mov rax, 1;
        ret
      }
    }

  // workspace_session_window_valid: 1 iff window_kind_id is nonzero
  // AND fits in u32. Zero is the "no active window" sentinel per
  // workspace_kind.pdx §2 body2 layout; a session entry naming
  // window 0 would restore a phantom window.
  pub let workspace_session_window_valid : (u64) -> u64 !{} @{} =
    fn (window_kind_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B12-03 (#2290): 1 iff window_kind_id in (0, 2^32). Labels prefixed workspace_session_wv_.",
      block: {
        cmp rdi, 0;
        je  workspace_session_wv_no;
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  workspace_session_wv_no;
        mov rax, 1;
        ret;
      workspace_session_wv_no:
        xor rax, rax;
        ret
      }
    }

  // workspace_session_extent_valid: 1 iff extent (width or height)
  // is strictly positive AND fits in i32 positive band. Zero refused
  // (a zero-extent window has no renderable surface). Negative
  // refused (semantically ill-formed for an extent).
  pub let workspace_session_extent_valid : (u64) -> u64 !{} @{} =
    fn (extent: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B12-03 (#2290): 1 iff extent in (0, 0x7FFFFFFF]. Zero and >i32max both refused. Labels prefixed workspace_session_ev_.",
      block: {
        cmp rdi, 0;
        je  workspace_session_ev_no;
        mov r10, 0x7FFFFFFF;
        cmp rdi, r10;
        ja  workspace_session_ev_no;
        mov rax, 1;
        ret;
      workspace_session_ev_no:
        xor rax, rax;
        ret
      }
    }

  // workspace_session_state_valid: 1 iff state fits in u8 (0..255).
  // Any u8 value is accepted; unknown states fall through to
  // NORMAL by convention on restore.
  pub let workspace_session_state_valid : (u64) -> u64 !{} @{} =
    fn (state: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B12-03 (#2290): 1 iff state <= 0xFF. Labels prefixed workspace_session_sv_.",
      block: {
        cmp rdi, 0xFF;
        ja  workspace_session_sv_no;
        mov rax, 1;
        ret;
      workspace_session_sv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Section 8  Packers.
  // ==========================================================================

  // word0: in_use[63:56] | state[55:48] | reserved[47:32] |
  //        workspace_id[31:0].
  // Emitted WITHOUT in_use bit set; tail_alloc ORs it in.
  pub let workspace_session_word0_pack : (u64, u64) -> u64 !{} @{} =
    fn (workspace_id: u64) (state: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B12-03 (#2290): word0 pack. workspace_id at [31:0], state at [55:48]. Both halves validated by caller (workspace_session_u32_valid + workspace_session_state_valid). Labels prefixed workspace_session_p0_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  workspace_session_p0_bad;
        cmp rsi, 0xFF;
        ja  workspace_session_p0_bad;
        mov rax, rdi;
        and rax, 0xFFFFFFFF;
        mov r10, rsi;
        and r10, 0xFF;
        shl r10, 48;
        or  rax, r10;
        ret;
      workspace_session_p0_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // word1: app_pkg_offset[63:32] | window_kind_id[31:0].
  pub let workspace_session_word1_pack : (u64, u64) -> u64 !{} @{} =
    fn (window_kind_id: u64) (app_pkg_offset: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B12-03 (#2290): word1 pack. Both halves capped at u32 max. Labels prefixed workspace_session_p1_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  workspace_session_p1_bad;
        cmp rsi, r10;
        ja  workspace_session_p1_bad;
        mov rax, rdi;
        and rax, 0xFFFFFFFF;
        mov r10, rsi;
        and r10, 0xFFFFFFFF;
        shl r10, 32;
        or  rax, r10;
        ret;
      workspace_session_p1_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // word2: geometry_y[63:32] | geometry_x[31:0]. Both halves are
  // raw u32 bit-patterns (may encode i32 negatives).
  pub let workspace_session_word2_pack : (u64, u64) -> u64 !{} @{} =
    fn (geometry_x: u64) (geometry_y: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B12-03 (#2290): word2 pack. Both halves masked to u32 bit-pattern; caller supplies i32-in-i64 (sign-extended) or raw u32. Validator (workspace_session_i32_valid) has already accepted both. Labels prefixed workspace_session_p2_.",
      block: {
        mov rax, rdi;
        and rax, 0xFFFFFFFF;
        mov r10, rsi;
        and r10, 0xFFFFFFFF;
        shl r10, 32;
        or  rax, r10;
        ret
      }
    }

  // word3: geometry_h[63:32] | geometry_w[31:0]. Same shape as word2.
  pub let workspace_session_word3_pack : (u64, u64) -> u64 !{} @{} =
    fn (geometry_w: u64) (geometry_h: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B12-03 (#2290): word3 pack. Both halves masked to u32 bit-pattern. Extents validated by caller (workspace_session_extent_valid > 0). Labels prefixed workspace_session_p3_.",
      block: {
        mov rax, rdi;
        and rax, 0xFFFFFFFF;
        mov r10, rsi;
        and r10, 0xFFFFFFFF;
        shl r10, 32;
        or  rax, r10;
        ret
      }
    }

  // ==========================================================================
  // Section 9  Row pool: valid / alloc / free.
  // ==========================================================================

  pub let workspace_session_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B12-03 (#2290): 1 iff row_id < WSESS_MAX and in_use. Labels prefixed workspace_session_tv_.",
      block: {
        cmp rdi, 64;
        jae workspace_session_tv_no;
        lea r10, [rip + _wsess_entries];
        mov r11, rdi;
        imul r11, r11, 32;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  workspace_session_tv_no;
        mov rax, 1;
        ret;
      workspace_session_tv_no:
        xor rax, rax;
        ret
      }
    }

  // workspace_session_tail_alloc(word0, word1, word2, word3) -> row_id | err.
  // Low-first scan over WSESS_MAX rows. word0 stamped with in_use
  // bit (bit 56) here so callers pass an "unset in_use" packed word0.
  pub let workspace_session_tail_alloc : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (word0: u64) (word1: u64) (word2: u64) (word3: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B12-03 (#2290): claim one WorkspaceSessionEntry row. Low-first scan (rbx=idx) over 64 rows of 32 bytes (idx*32 via imul). On claim: OR the 1<<56 in_use marker into word0 and store the four u64 body words. Five callee-save pushes (rbx=idx, r12=word0, r13=word1, r14=word2, r15=word3) leave rsp%16==0 for the no-nested-call scan. Labels prefixed workspace_session_ta_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov r15, rcx;

        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne workspace_session_ta_bad;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp r12, r10;
        je  workspace_session_ta_bad;
        cmp r13, r10;
        je  workspace_session_ta_bad;

        xor rbx, rbx;
      workspace_session_ta_scan:
        cmp rbx, 64;
        jae workspace_session_ta_enospc;
        lea r10, [rip + _wsess_entries];
        mov r11, rbx;
        imul r11, r11, 32;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  workspace_session_ta_claim;
        add rbx, 1;
        jmp workspace_session_ta_scan;

      workspace_session_ta_claim:
        mov rax, r12;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r13;
        mov [r10 + 16], r14;
        mov [r10 + 24], r15;
        mov rax, rbx;
        jmp workspace_session_ta_out;

      workspace_session_ta_enospc:
        mov rax, 0xFFFFE9FF;
        jmp workspace_session_ta_out;
      workspace_session_ta_bad:
        mov rax, 0xFFFFE9FE;

      workspace_session_ta_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let workspace_session_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B12-03 (#2290): scrub one row (all four words). Labels prefixed workspace_session_tf_.",
      block: {
        cmp rdi, 64;
        jae workspace_session_tf_out;
        lea r10, [rip + _wsess_entries];
        mov r11, rdi;
        imul r11, r11, 32;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
      workspace_session_tf_out:
        ret
      }
    }

  // Zero-out the ENTIRE entry table. Used at session-boundary
  // transitions: before a restore-from-disk reload, and after a
  // successful save-to-disk flush. Cheaper than iterating tail_free
  // over every row because it touches the underlying words in one
  // pass without checking in_use.
  pub let workspace_session_clear_all : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B12-03 (#2290): scrub the whole 256-word pool. Labels prefixed workspace_session_ca_.",
      block: {
        lea r10, [rip + _wsess_entries];
        xor rax, rax;
        xor rcx, rcx;
      workspace_session_ca_loop:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 256;
        jb  workspace_session_ca_loop;
        ret
      }
    }

  // ==========================================================================
  // Section 10  Row-field query helpers.
  // ==========================================================================

  pub let workspace_session_row_workspace_id : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B12-03 (#2290): workspace_id at word0[31:0]. Labels prefixed workspace_session_rwid_.",
      block: {
        push r12;
        mov r12, rdi;
        call workspace_session_tail_valid;
        cmp rax, 0;
        je  workspace_session_rwid_bad;
        lea r10, [rip + _wsess_entries];
        mov r11, r12;
        imul r11, r11, 32;
        add r10, r11;
        mov rax, [r10 + 0];
        and rax, 0xFFFFFFFF;
        jmp workspace_session_rwid_out;
      workspace_session_rwid_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      workspace_session_rwid_out:
        pop r12;
        ret
      }
    }

  pub let workspace_session_row_state : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B12-03 (#2290): state at word0[55:48]. Labels prefixed workspace_session_rst_.",
      block: {
        push r12;
        mov r12, rdi;
        call workspace_session_tail_valid;
        cmp rax, 0;
        je  workspace_session_rst_bad;
        lea r10, [rip + _wsess_entries];
        mov r11, r12;
        imul r11, r11, 32;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 48;
        and rax, 0xFF;
        jmp workspace_session_rst_out;
      workspace_session_rst_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      workspace_session_rst_out:
        pop r12;
        ret
      }
    }

  pub let workspace_session_row_window_kind_id : (u64) -> u64 !{mem} @{} =
