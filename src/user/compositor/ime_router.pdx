  // ==========================================================================
  // SECTION 4 -- VALIDATORS (pure leaves; small immediates only)
  // ==========================================================================
  //
  // Every validator returns 1 iff its input is well-formed, else 0.
  // Encoder-conservative pattern per surface_commit / provider_kind /
  // session_kind (no `and r11, imm64`, straight-line fast path).

  // ime_router_seat_valid(seat_kind_id) -> 1 iff in (0, 2^32).
  // Non-zero (a 0 seat id is the "no seat" sentinel) and u32-bounded
  // (the field is stored in a u32 half of seat_and_session).
  pub let ime_router_seat_valid : (u64) -> u64 !{} @{} =
    fn (seat_kind_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G11-M3-001 (paideia-os #2316): 1 iff seat_kind_id in (0, 2^32). Labels prefixed ime_router_sv_.",
      block: {
        cmp rdi, 0;
        je  ime_router_sv_no;
        mov rax, rdi;
        shr rax, 32;
        cmp rax, 0;
        jne ime_router_sv_no;
        mov rax, 1;
        ret;
      ime_router_sv_no:
        xor rax, rax;
        ret
      }
    }

