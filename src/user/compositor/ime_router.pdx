  // ==========================================================================
  // SECTION 5 -- ROW-POOL ADDRESSING
  // ==========================================================================

  // ime_router_slot(idx) -> &_ime_router_pool[idx*48].
  // No bounds check by policy -- mirrors provider_kind_slot / clipboard
  // slot; caller validates idx first via ime_router_row_valid or
  // factory's own bounded scan.  Uses imul r,r,48 per the encoder-OK
  // three-operand shape (imm8 fits sign-extended; provider_kind.pdx
  // uses the same idiom).
  pub let ime_router_slot : (u64) -> u64 !{} @{} =
    fn (idx: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G11-M3-001 (paideia-os #2316): &_ime_router_pool[idx*48]. imul r,r,imm8 form (mirrors provider_kind_slot). No bounds check by policy. Labels prefixed ime_router_ps_.",
      block: {
        lea rax, [rip + _ime_router_pool];
        imul rdi, rdi, 48;
        add rax, rdi;
        ret
      }
    }

  // ime_router_row_valid(idx) -> 1 iff idx < IME_ROUTER_MAX and in_use
  // byte is set.  Inlined address compute (no nested call); mirrors
  // provider_kind_row_valid / tui_canvas_row_valid.
  pub let ime_router_row_valid : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M3-001 (paideia-os #2316): 1 iff idx < IME_ROUTER_MAX(1) and in_use set. Inlined address compute (idx*48 via imul r,r,imm8) rather than nested call to ime_router_slot, keeping this a pure leaf. Labels prefixed ime_router_rv2_.",
      block: {
        cmp rdi, 1;
        jae ime_router_rv2_no;
        lea r10, [rip + _ime_router_pool];
        mov r11, rdi;
        imul r11, r11, 48;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  ime_router_rv2_no;
        mov rax, 1;
        ret;
      ime_router_rv2_no:
        xor rax, rax;
        ret
      }
    }

  // ime_router_bypass_disabled(idx) -> 1 iff bypass_disabled bit set on
  // the (assumed in_use) row.  This is the STRUCTURAL ASSERTION helper:
  // every op path is free to call this before proceeding; the invariant
  // says it must return 1 for any live router row.  Returns 0 on OOB
  // or empty row.
  pub let ime_router_bypass_disabled : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M3-001 (paideia-os #2316): 1 iff bypass_disabled bit (bit 40 of header word) is set. Used as a structural assertion helper by op paths that want to prove the invariant before proceeding. Inlined address compute. Labels prefixed ime_router_bd_.",
      block: {
        cmp rdi, 1;
        jae ime_router_bd_no;
        lea r10, [rip + _ime_router_pool];
        mov r11, rdi;
        imul r11, r11, 48;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 40;
        and rax, 1;
        ret;
      ime_router_bd_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // SECTION 6 -- PACKERS (row-write helpers)
  // ==========================================================================

  // ime_router_hdr_pack() -> canonical header at mint time.
  // in_use[63:56] = 1 AND bypass_disabled[47:40] = 1 -- both set
  // simultaneously to enforce the "no router without bypass_disabled"
  // invariant structurally.  Reserved bits stay 0.
  //
  // Header word value:
  //   (1 << 56) | (1 << 40)
  // = 0x0100000000000000 | 0x0000010000000000
  // = 0x0100010000000000
  pub let ime_router_hdr_pack : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "G11-M3-001 (paideia-os #2316): canonical row header at mint time. in_use (bit 56) AND bypass_disabled (bit 40) both set. Encoder-conservative build via shl (no MOVABS r64, imm64). Straight-line.",
      block: {
        mov rax, 1;
        shl rax, 56;                        // in_use bit
        mov r10, 1;
        shl r10, 40;                        // bypass_disabled bit
        or  rax, r10;
        ret
      }
    }

  // ime_router_seat_session_pack(seat_kind_id, active_session_kind_id)
  //   -> active_session_kind_id[63:32] | seat_kind_id[31:0].
  // Row-write helper for seat_and_session at [+8].  Both halves masked
  // to 32 bits so an out-of-range argument cannot smear into a neighbor
  // field.
  pub let ime_router_seat_session_pack : (u64, u64) -> u64 !{} @{} =
    fn (seat_kind_id: u64) (active_session_kind_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G11-M3-001 (paideia-os #2316): pack active_session_kind_id[63:32] | seat_kind_id[31:0] per row layout at [+8]. Encoder-conservative build of 32-bit mask via shl+shr. Straight-line.",
      block: {
        // rax = seat_kind_id & 0xFFFFFFFF
        mov rax, rdi;
        shl rax, 32;
        shr rax, 32;

        // r10 = active_session_kind_id << 32
        mov r10, rsi;
        shl r10, 32;

        or  rax, r10;
        ret
      }
    }

  // ime_router_provider_pack(active_provider_kind_id)
  //   -> active_provider_kind_id[31:0] | reserved[63:32]=0.
  // Row-write helper for provider_and_pad at [+16].
  pub let ime_router_provider_pack : (u64) -> u64 !{} @{} =
    fn (active_provider_kind_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G11-M3-001 (paideia-os #2316): pack active_provider_kind_id[31:0] with reserved[63:32]=0 per row layout at [+16]. Encoder-conservative 32-bit mask via shl+shr.",
      block: {
        mov rax, rdi;
        shl rax, 32;
        shr rax, 32;
        ret
      }
    }

  // ==========================================================================
  // SECTION 7 -- ROW-FIELD QUERY HELPERS
  // ==========================================================================
  //
  // Every read-side accessor validates row idx first via
  // ime_router_row_valid, then extracts the field.  An accessor on an
  // empty / OOB row returns 0.

  // ime_router_query_seat(row_id) -> seat_kind_id | 0.
  pub let ime_router_query_seat : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M3-001 (paideia-os #2316): read seat_kind_id at row+8[31:0]. OOB / empty row -> 0. One callee-save push (rbx) + retaddr (8) + one nested call = 16 bytes total on entry, rsp%16==0 for the nested call. Labels prefixed ime_router_qs_.",
      block: {
        push rbx;
        mov rbx, rdi;
        mov rdi, rbx;
        call ime_router_row_valid;
        cmp rax, 0;
        je  ime_router_qs_zero;
        mov rdi, rbx;
        call ime_router_slot;
        mov rax, [rax + 8];
        and rax, 0xFFFFFFFF;
        jmp ime_router_qs_out;
      ime_router_qs_zero:
        xor rax, rax;
      ime_router_qs_out:
        pop rbx;
        ret
      }
    }

  // ime_router_query_session(row_id) -> active_session_kind_id | 0.
  pub let ime_router_query_session : (u64) -> u64 !{mem} @{} =
