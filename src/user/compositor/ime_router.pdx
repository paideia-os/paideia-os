  // ==========================================================================
  // SECTION 8 -- FACTORY + OPS
  // ==========================================================================

  // ime_router_mint(seat) -> row_id | IMR_*.
  //
  // The mint factory: validate the seat, allocate the single row from
  // the pool, stamp header (in_use=1 AND bypass_disabled=1 SIMULTANEOUSLY
  // via ime_router_hdr_pack), stamp seat_and_session (with active_
  // session=0 for now), stamp provider_and_pad (with active_provider=0),
  // stamp routed_count=0, session_switches=0, reserved=0.  Bump
  // IMR_ST_MINTS.  Return the row_id (0 on success, since IMR_MAX = 1).
  //
  // Gate order:
  //   (1) seat valid          -> IMR_BAD_SEAT
  //   (2) scan pool for free  -> IMR_ALREADY (single-instance ceiling)
  //   (3) stamp header (in_use=1 AND bypass_disabled=1), seat_and_session
  //       (with session=0), provider_and_pad (with provider=0), routed_
  //       count=0, session_switches=0, reserved=0
  //   (4) bump IMR_ST_MINTS
  //   (5) return row_id
  //
  // Refusal funnel bumps IMR_ST_REFUSED once at ime_router_mint_refused.
  //
  // The novel-clean bypass_disabled=1 assertion is STRUCTURAL: the mint
  // path uses ime_router_hdr_pack which unconditionally builds both
  // bits into the header word.  There is no code path in this file
  // that stamps a header with bypass_disabled = 0.  A hypothetical
  // future variant that wanted a bypass path would need its own factory
  // and its own kind ordinal.
  //
  // Register plan (three callee-save pushes = 24 bytes; entry rsp%16==8
  // -> 24+8=32 %16==0 for every nested call):
  //   rbx = seat
  //   r12 = row_id (scanned + written)
  //   r13 = row base pointer (once resolved)
  pub let ime_router_mint : (u64) -> u64 !{mem} @{} =
    fn (seat: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M3-001 (paideia-os #2316): mint factory. Three callee-save pushes = 24 bytes: entry rsp%16==8, +24+8=32, rsp%16==0 for every nested call (validators and note are leaves per SysV rbx/r12/r13 preservation). rbx stashes seat across nested calls; r12 holds row_id; r13 holds row base. Refusal funnel bumps IMR_ST_REFUSED once at ime_router_mint_refused. Row stamp writes six u64 words directly with `mov [r13+off], rN` (encoder-conservative). The bypass_disabled=1 assertion is STRUCTURAL via ime_router_hdr_pack. Labels prefixed ime_router_mint_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                       // seat

        // (1) seat valid.
        mov rdi, rbx;
        call ime_router_seat_valid;
        cmp rax, 0;
        je  ime_router_mint_bad_seat;

        // (2) scan pool for free row (low-first; IMR_MAX=1 so at most
        //     one iteration).
        xor r12, r12;                       // idx = 0
      ime_router_mint_scan:
        cmp r12, 1;
        jae ime_router_mint_already;
        lea r10, [rip + _ime_router_pool];
        mov r11, r12;
        imul r11, r11, 48;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  ime_router_mint_claim;
        add r12, 1;
        jmp ime_router_mint_scan;

      ime_router_mint_claim:
        // r10 already points at the target row base.  Snapshot into r13.
        mov r13, r10;

        // Header via hdr_pack: in_use=1 AND bypass_disabled=1 in one word.
        call ime_router_hdr_pack;
        mov [r13 + 0], rax;

        // seat_and_session: session=0 | seat[31:0].
        mov rax, rbx;
        shl rax, 32;
        shr rax, 32;                        // rax = seat & 0xFFFFFFFF
        mov [r13 + 8], rax;                 // session[63:32] = 0

        // provider_and_pad: provider=0 | reserved=0.
        xor rax, rax;
        mov [r13 + 16], rax;

        // routed_count = 0.
        xor rax, rax;
        mov [r13 + 24], rax;

        // session_switches = 0.
        xor rax, rax;
        mov [r13 + 32], rax;

        // reserved.
        xor rax, rax;
        mov [r13 + 40], rax;

        // Bump IMR_ST_MINTS.
        mov rdi, 0;                         // IMR_ST_MINTS
        call ime_router_note;

        // Return row_id.
        mov rax, r12;
        jmp ime_router_mint_out;

      ime_router_mint_bad_seat:
        mov rax, 0xFFFFE9BD;                // IMR_BAD_SEAT
        jmp ime_router_mint_refused;
      ime_router_mint_already:
        mov rax, 0xFFFFE9B6;                // IMR_ALREADY
        jmp ime_router_mint_refused;

      ime_router_mint_refused:
        // Stash refusal code across the note call.
        mov r12, rax;
        mov rdi, 6;                         // IMR_ST_REFUSED
        call ime_router_note;
        mov rax, r12;
        jmp ime_router_mint_out;

      ime_router_mint_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ime_router_route_keystroke(row_id, key_event) -> IMR_ROUTED | IMR_*.
  //
  // Forward the key_event to the router's active session.  The key_event
  // is an opaque u64 encoding of (keycode, modifiers, press/release) as
  // agreed by the KIND_SEAT wire format -- this file does not interpret
  // it, only forwards.  On success bumps the row's routed_count and
  // IMR_ST_ROUTES, and returns IMR_ROUTED (=IMR_OK=0).  On no session
  // (active_session_kind_id == 0) bumps IMR_ST_ROUTES_NOSESS and returns
  // IMR_NO_SESSION.  On row_id / bypass violation the refusal funnel
  // bumps IMR_ST_REFUSED.
  //
  // Gate order:
  //   (1) row_id valid + in_use -> IMR_BAD_SLOT
  //   (2) bypass_disabled == 1  -> IMR_BYPASS_REFUSED (defensive; the
  //                                factory structurally stamps 1, so
  //                                this can only ever hit on a corrupted
  //                                row)
  //   (3) active_session_kind_id != 0 -> IMR_NO_SESSION
  //   (4) bump routed_count on the row
  //   (5) bump IMR_ST_ROUTES
  //   (6) return IMR_ROUTED
  //
  // Register plan (three callee-save pushes = 24 bytes; entry rsp%16==8
  // -> 24+8=32 %16==0):
  //   rbx = row_id
  //   r12 = key_event (forwarded to the future dispatcher; row-level
  //         primitive treats it opaquely)
  //   r13 = row base pointer
  pub let ime_router_route_keystroke : (u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64) (key_event: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M3-001 (paideia-os #2316): route a keystroke to the active session. Three callee-save pushes = 24 bytes; entry rsp%16==8 -> 32, %16==0 for every nested call. rbx=row_id, r12=key_event (opaque forward), r13=row base. Bumps row's routed_count (encoder-conservative load-inc-store) and IMR_ST_ROUTES on success; IMR_ST_ROUTES_NOSESS on no session; IMR_ST_REFUSED on gate refusal. Labels prefixed ime_router_rk_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                       // row_id
        mov r12, rsi;                       // key_event (opaque forward)

        // (1) row_id valid + in_use.
        mov rdi, rbx;
        call ime_router_row_valid;
        cmp rax, 0;
        je  ime_router_rk_bad_slot;

        // (2) bypass_disabled == 1 (defensive assertion).
        mov rdi, rbx;
        call ime_router_bypass_disabled;
        cmp rax, 0;
        je  ime_router_rk_bypass;

        // Resolve row base.
        mov rdi, rbx;
        call ime_router_slot;
        mov r13, rax;

        // (3) active_session_kind_id != 0.
        mov rax, [r13 + 8];
        shr rax, 32;                        // session in low 32 of rax
        cmp rax, 0;
        je  ime_router_rk_no_session;

        // (4) bump routed_count.  Encoder-conservative load-inc-store.
        mov rax, [r13 + 24];
        add rax, 1;
        mov [r13 + 24], rax;

        // (5) bump IMR_ST_ROUTES.
        mov rdi, 2;                         // IMR_ST_ROUTES
        call ime_router_note;

        // (6) return IMR_ROUTED (= IMR_OK = 0).
        xor rax, rax;
        jmp ime_router_rk_out;

      ime_router_rk_no_session:
        mov rdi, 3;                         // IMR_ST_ROUTES_NOSESS
        call ime_router_note;
        mov rax, 0xFFFFE9B8;                // IMR_NO_SESSION
        jmp ime_router_rk_out;

      ime_router_rk_bad_slot:
        mov rax, 0xFFFFE9BA;                // IMR_BAD_SLOT
        jmp ime_router_rk_refused;
      ime_router_rk_bypass:
        // Bump the dedicated bypass counter AND the refused funnel.
        mov rdi, 7;                         // IMR_ST_BYPASS_REFUSED
        call ime_router_note;
        mov rax, 0xFFFFE9B3;                // IMR_BYPASS_REFUSED
        jmp ime_router_rk_refused;

      ime_router_rk_refused:
        mov r13, rax;
        mov rdi, 6;                         // IMR_ST_REFUSED
        call ime_router_note;
        mov rax, r13;

      ime_router_rk_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ime_router_switch_provider(row_id, new_provider, new_session)
  //   -> IMR_OK | IMR_*.
  //
  // Rewrite the router row's (active_provider_kind_id, active_session_
  // kind_id) pair IN PLACE.  The caller is responsible for having
  // already:
  //   * unbound the previous session from the previous provider (via
  //     ime_provider_unbind_session(old_provider, old_session)); and
  //   * looked up the new provider and minted the new session (via
  //     ime_provider_lookup_by_lang + ime_session_mint + ime_provider_
  //     bind_session).
  // This file's swap-in primitive does not do the cross-module dance:
  // it is a row-level state transition on the router row alone, so it
  // can land ahead of the wire-body glue.  The dispatcher-side substrate
  // that turns "user pressed the language toggle key" into the full
  // unbind/lookup/mint/bind sequence lives in a future landing.
  //
  // Passing new_session == 0 is legal and means "swap in a new provider
  // but do not yet have an open session on it" -- the router waits for
  // the next focus event to mint a session against the new provider.
  //
  // If (new_provider, new_session) matches the current (active_provider,
  // active_session) EXACTLY, the call is a no-op OK (does not bump
  // session_switches or IMR_ST_SWITCHES).  Any change to either field
  // is a real switch and bumps both.
  //
  // Gate order:
  //   (1) row_id valid + in_use   -> IMR_BAD_SLOT
  //   (2) bypass_disabled == 1    -> IMR_BYPASS_REFUSED
  //   (3) new_provider valid      -> IMR_BAD_PROVIDER (new_provider == 0
  //                                  is "unbind provider entirely" and
  //                                  is legal on the revoke path; here
  //                                  the switch path requires a valid
  //                                  target)
  //   (4) new_session validity    -- 0 is legal (see above); if nonzero
  //                                  it must fit u32, else IMR_BAD_SESSION
  //   (5) compare against current pair; if identical, no-op OK
  //   (6) rewrite row+8[63:32]  = new_session (seat[31:0] preserved)
  //       rewrite row+16[31:0]  = new_provider (reserved[63:32] preserved)
  //   (7) bump session_switches
  //   (8) bump IMR_ST_SWITCHES
  //   (9) return IMR_OK
  //
  // Register plan (four callee-save pushes = 32 bytes; entry rsp%16==8
  // -> 32+8=40, add sub rsp,8 to reach 48 for the nested note call
  // (%16==0)):
  //   rbx = row_id
  //   r12 = new_provider
  //   r13 = new_session
  //   r14 = row base pointer
  pub let ime_router_switch_provider : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64) (new_provider: u64) (new_session: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M3-001 (paideia-os #2316): swap the router row's (active_provider, active_session) pair in place. Four callee-save pushes + sub rsp,8 = 40 bytes; entry rsp%16==8 -> 40+8=48, %16==0 for every nested call. rbx=row_id, r12=new_provider, r13=new_session, r14=row base. new_session==0 is legal (means 'swapped provider, no session yet -- wait for next focus'). Identical (provider, session) pair is a no-op OK. Refusal funnel at ime_router_sp_refused. Labels prefixed ime_router_sp_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        sub rsp, 8;

        mov rbx, rdi;                       // row_id
        mov r12, rsi;                       // new_provider
        mov r13, rdx;                       // new_session

        // (1) row_id valid + in_use.
        mov rdi, rbx;
        call ime_router_row_valid;
        cmp rax, 0;
        je  ime_router_sp_bad_slot;

        // (2) bypass_disabled == 1.
        mov rdi, rbx;
        call ime_router_bypass_disabled;
        cmp rax, 0;
        je  ime_router_sp_bypass;

        // (3) new_provider valid.
        mov rdi, r12;
        call ime_router_provider_valid;
        cmp rax, 0;
        je  ime_router_sp_bad_provider;

        // (4) new_session validity (0 or in (0, 2^32)).
        cmp r13, 0;
        je  ime_router_sp_session_ok;
        // Nonzero: must fit u32.
        mov rax, r13;
        shr rax, 32;
        cmp rax, 0;
        jne ime_router_sp_bad_session;
      ime_router_sp_session_ok:

        // Resolve row base.
        mov rdi, rbx;
        call ime_router_slot;
        mov r14, rax;

        // (5) Compare against current pair; if identical -> no-op OK.
        // Current active_provider = row+16[31:0]
        mov rax, [r14 + 16];
        and rax, 0xFFFFFFFF;
        cmp rax, r12;
        jne ime_router_sp_do_swap;
        // Providers match; compare sessions.
        mov rax, [r14 + 8];
        shr rax, 32;
        cmp rax, r13;
        jne ime_router_sp_do_swap;
        // Identical pair -> no-op OK.
        xor rax, rax;
        jmp ime_router_sp_out;

      ime_router_sp_do_swap:
        // (6a) Rewrite row+8[63:32] = new_session, seat[31:0] preserved.
        mov rax, [r14 + 8];
        and rax, 0xFFFFFFFF;                // rax = seat (preserve low 32)
        mov r10, r13;
        shl r10, 32;                        // r10 = new_session << 32
        or  rax, r10;
        mov [r14 + 8], rax;

        // (6b) Rewrite row+16[31:0] = new_provider, reserved preserved.
        // Extract reserved (top 32) and re-shift it back to the top,
        // clearing the low 32 as a side effect -- this avoids any
        // MOVABS r64, imm64 / sign-extend hazard from a `mov r64, 0xFFFFFFFF`
        // mask literal.
        mov rax, [r14 + 16];
        shr rax, 32;                        // rax = reserved (in low 32)
        shl rax, 32;                        // rax = reserved (in top 32); low 32 = 0
        mov r10, r12;
        shl r10, 32;
        shr r10, 32;                        // r10 = new_provider & 0xFFFFFFFF
        or  rax, r10;
        mov [r14 + 16], rax;

        // (7) bump session_switches.
        mov rax, [r14 + 32];
        add rax, 1;
        mov [r14 + 32], rax;

        // (8) bump IMR_ST_SWITCHES.
        mov rdi, 4;                         // IMR_ST_SWITCHES
        call ime_router_note;

        // (9) return IMR_OK.
        xor rax, rax;
        jmp ime_router_sp_out;

      ime_router_sp_bad_slot:
        mov rax, 0xFFFFE9BA;                // IMR_BAD_SLOT
        jmp ime_router_sp_refused;
      ime_router_sp_bypass:
        mov rdi, 7;                         // IMR_ST_BYPASS_REFUSED
        call ime_router_note;
        mov rax, 0xFFFFE9B3;                // IMR_BYPASS_REFUSED
        jmp ime_router_sp_refused;
      ime_router_sp_bad_provider:
        mov rax, 0xFFFFE9BB;                // IMR_BAD_PROVIDER
        jmp ime_router_sp_refused;
      ime_router_sp_bad_session:
        mov rax, 0xFFFFE9BC;                // IMR_BAD_SESSION
        jmp ime_router_sp_refused;

      ime_router_sp_refused:
        mov r14, rax;
        mov rdi, 6;                         // IMR_ST_REFUSED
        call ime_router_note;
        mov rax, r14;

      ime_router_sp_out:
        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ime_router_query_active(row_id)
  //   -> active_session_kind_id[31:0] | active_provider_kind_id[63:32].
  //
  // Read both active_* fields in one packed u64 return.  This is the
  // shape the compositor's OSD (the "current IME" indicator on the
  // panel) polls at a low frequency; a single call gets both values
  // atomically enough for display purposes (the ops that write the
  // pair -- switch_provider -- write session first then provider, so
  // a torn read could see the new session with the old provider; the
  // OSD tolerates one frame of that transient).
  //
  // Returns 0 on OOB / empty row (the OSD then displays "IME: none").
  // Bumps IMR_ST_QUERIES on every non-refused call (both hit and
  // empty-row cases count as a query).
  //
  // Return encoding:
  //   rax[31:0]  = active_session_kind_id
  //   rax[63:32] = active_provider_kind_id
  //
  // A caller that wants ONLY session or ONLY provider can call
  // ime_router_query_session / ime_router_query_provider directly.
  //
  // Register plan (two callee-save pushes = 16 bytes; entry rsp%16==8
  // -> 16+8=24, add sub rsp,8 to reach 32 for the nested note call):
  //   rbx = row_id
  //   r12 = row base pointer
  pub let ime_router_query_active : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M3-001 (paideia-os #2316): read (active_session, active_provider) packed into one u64. Two callee-save pushes + sub rsp,8 = 24 bytes; entry rsp%16==8 -> 24+8=32, %16==0 for nested calls. rbx=row_id, r12=row base. Returns 0 on OOB / empty row. Bumps IMR_ST_QUERIES on every non-refused call. Labels prefixed ime_router_qa_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        mov rbx, rdi;                       // row_id

        mov rdi, rbx;
        call ime_router_row_valid;
        cmp rax, 0;
        je  ime_router_qa_zero;

        // Bump IMR_ST_QUERIES.
        mov rdi, 5;                         // IMR_ST_QUERIES
        call ime_router_note;

        // Resolve row base.
        mov rdi, rbx;
        call ime_router_slot;
        mov r12, rax;

        // session = row+8[63:32]
        mov rax, [r12 + 8];
        shr rax, 32;                        // rax = session in low 32
        // provider = row+16[31:0] -- place in high 32 of return via
        // shl 32 (mask+shift in one step, no MOVABS mask literal).
        mov r10, [r12 + 16];
        shl r10, 32;                        // provider now in high 32
                                            // (low 32 zero as side effect)
        or  rax, r10;
        jmp ime_router_qa_out;

      ime_router_qa_zero:
        // Still count as a query attempt.
        mov rdi, 5;                         // IMR_ST_QUERIES
        call ime_router_note;
        xor rax, rax;

      ime_router_qa_out:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ime_router_revoke(row_id) -> IMR_OK | IMR_*.
  //
  // Clear all router state: zero the entire row (including the in_use
  // AND bypass_disabled bits) so the slot returns to the free list.
  // Bumps IMR_ST_REVOKES.  A second revoke against an already-empty row
  // returns IMR_REVOKE_ALREADY without bumping.
  //
  // The caller is responsible for having already:
  //   * unbound the active session from the active provider (if any); and
  //   * revoked the active session (if any).
  // This file's revoke primitive does NOT walk those cross-module refs.
  //
  // A revoke does NOT preserve bypass_disabled -- the whole row is
  // zeroed, including that bit.  A subsequent ime_router_mint will
  // re-stamp both header bits (in_use=1 AND bypass_disabled=1) via
  // ime_router_hdr_pack, so the invariant is re-established on the
  // next mint.
  //
  // Gate order:
  //   (1) row_id in range     -> IMR_BAD_SLOT
  //   (2) row is in_use       -> IMR_REVOKE_ALREADY
  //   (3) zero all 6 words of the row
  //   (4) bump IMR_ST_REVOKES
  //   (5) return IMR_OK
  //
  // Register plan (two callee-save pushes = 16 bytes; entry rsp%16==8
  // -> 24, add sub rsp,8 to reach 32 for nested calls):
  //   rbx = row_id
  //   r12 = row base pointer
  pub let ime_router_revoke : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G11-M3-001 (paideia-os #2316): revoke the router row; zero all six words (including the bypass_disabled bit). Two callee-save pushes + sub rsp,8 = 24 bytes; entry rsp%16==8 -> 32, %16==0 for nested calls. Refuses on OOB (IMR_BAD_SLOT) or on already-empty row (IMR_REVOKE_ALREADY). Bumps IMR_ST_REVOKES on success. Labels prefixed ime_router_rev_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        mov rbx, rdi;                       // row_id

        // (1) row_id in range.
        cmp rbx, 1;
        jae ime_router_rev_bad_slot;

        // Resolve row base.
        mov rdi, rbx;
        call ime_router_slot;
        mov r12, rax;

        // (2) row is in_use? (test in_use bit directly, not
        //     ime_router_row_valid, so we can distinguish OOB from
        //     already-empty.)
        mov rax, [r12 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  ime_router_rev_already;

        // (3) zero all 6 words.
        xor rax, rax;
        mov [r12 + 0],  rax;                // header (clears in_use AND
                                            //         bypass_disabled)
        mov [r12 + 8],  rax;                // seat_and_session
        mov [r12 + 16], rax;                // provider_and_pad
        mov [r12 + 24], rax;                // routed_count
        mov [r12 + 32], rax;                // session_switches
        mov [r12 + 40], rax;                // reserved

        // (4) bump IMR_ST_REVOKES.
        mov rdi, 1;                         // IMR_ST_REVOKES
        call ime_router_note;

        // (5) return IMR_OK.
        xor rax, rax;
        jmp ime_router_rev_out;

      ime_router_rev_bad_slot:
        mov rax, 0xFFFFE9BA;                // IMR_BAD_SLOT
        jmp ime_router_rev_refused;
      ime_router_rev_already:
        mov rax, 0xFFFFE9B4;                // IMR_REVOKE_ALREADY
        jmp ime_router_rev_refused;

      ime_router_rev_refused:
        mov r12, rax;
        mov rdi, 6;                         // IMR_ST_REFUSED
        call ime_router_note;
        mov rax, r12;

      ime_router_rev_out:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }
}
