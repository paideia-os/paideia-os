// src/user/compositor/a11y_tree.pdx -- Wave ζ ζ-05 (KIND_A11Y_NODE
// consumer: userspace edge index + BFS descendants query).
//
// A PURE USERSPACE EDGE INDEX ALONGSIDE THE CAP SYSTEM. This file adds
// a parent/child edge table that names accessibility-node relationships
// by their kernel-assigned node_id (u16 range, per design/a11y/
// kind-a11y-node.md's ANODE row layout §Row layout). It does NOT touch
// KIND_A11Y_NODE caps (src/kernel/core/cap/kind_a11y_node.pdx, 0x1E6)
// nor KIND_A11Y_TREE (src/user/a11y/tree_kind.pdx, 0x1D3): those two
// citizens own row storage + rights + sys_cap_invoke dispatch. This
// file is the DESCENDANT-TRAVERSAL WIRE that a query API needs — a
// separate concern the kernel-side cap intentionally does NOT provide
// (kind_a11y_node.pdx §Ops lists only QUERY_PARENT / QUERY_ROLE /
// QUERY_LABEL_PTR / QUERY_LABEL_LEN / DEBUG_PRINT; there is no
// QUERY_CHILDREN op today, and the design doc §Ops closes on "arity
// ONE" for every op).
//
// WHY A USERSPACE INDEX RATHER THAN A KERNEL ONE. Adding a parent->
// children edge list to the kernel row (kind_a11y_node.pdx §Row layout)
// would either require a bounded per-row child array (fixed cost per
// row, wasted on leaf nodes) or an out-of-band arena the kernel would
// have to grow + garbage-collect. The design doc explicitly defers
// that: "a11y_node_cap_mint takes four independent u64-shaped arguments
// -- (parent_node_id, role, label_ptr, label_len)". Child-set is not
// among them. This file keeps the kernel row minimal and puts the
// descendant traversal in userspace where it belongs, mirroring the
// pattern src/user/a11y/tree_kind.pdx already uses (its own arena
// substrate lives entirely userspace-side).
//
// SCOPE. Two operations: (1) a11y_tree_add_edge(parent, child) claims
// one edge slot in the 128-entry table; (2) a11y_tree_query_descendants
// (root, out_buf, buf_cap) BFS-walks the table starting at root,
// writing discovered child node_ids (as u32) into out_buf up to
// buf_cap. Both operate on u16-range node_ids (packed into u32 slots:
// parent in [15:0], child in [31:16]). No dependency on any kernel
// symbol, no external references outside this file's own arena — so
// the .o assembles standalone even though tools/build-user.sh's
// compositor/* exclusion branch keeps it out of shell.elf today
// (paideia-os #2344).
//
// PACKING FORMAT + THE "EMPTY SLOT == 0" INVARIANT. Every slot is a
// u32 with parent in [15:0] and child in [31:16]. A slot value of 0
// means "empty" — this is unambiguous because a11y_node_cap_mint
// (kernel §a11y_node_cap_mint step 4) pre-increments _a11y_node_next_id
// so the first live node_id is 1, matching the ANODE_ID_NONE = 0
// convention in the design doc §Row layout. So a parent==0 or child==0
// never names a real edge — the slot value 0 is exclusive to
// "unclaimed" and the add gate refuses parent==0/child==0 verbatim.
// A node_id > 0xFFFF is also refused: the pack format truncates above
// 65535 and the kernel row's node_id is a u64 in principle but the
// pool cap is ANODE_MAX(64), so today 0xFFFF is a comfortable ceiling.
//
// CYCLE POSTURE. Accessibility trees are acyclic by contract, but a
// malformed edge set (an add sequence that mistakenly forms a cycle)
// must not hang the BFS. The query uses out_buf itself as the frontier
// queue and self-caps at buf_cap, so a cycle self-terminates when the
// output buffer fills — the caller sees `count == buf_cap` and can
// escalate (a real screen reader would log + refuse). No visited-set
// bitmap is maintained: the buf_cap ceiling IS the termination
// guarantee, and adding a bitmap would double the storage for a
// pathology that shouldn't occur in real inputs.
//
// FAILURE TAXONOMY -- 0xFFFFE950..0xFFFFE95F.
// Grep-verified free at landing time (`grep -rn '0xFFFFE95[0-9A-Fa-f]'`
// over src/ + design/ returns zero hits). Only two codes claimed;
// 0xFFFFE952..E95F stays open for follow-on rollback / diagnostic
// codes without a band re-allocation.
//
// DISCIPLINE.
// * PascalCase basename: a11y_tree.pdx = module A11yTree.
// * Encoder rules: no `test rN,rN`; no 2-op `imul r,imm`; no `neg`;
//   no sil/dil/bl; no `qword ptr`; no `[reg + N*1]`; scale in SIB
//   limited to 4 (u32 slot) or 8 (u64 stats) per the tree's proven
//   set. `mov_d [mem], rN` / `mov_d rN, [mem]` for u32 loads/stores
//   (aml_arena.pdx pattern) — never a bare `mov [mem], eax` that
//   would silently REX.W-widen.
// * Labels: prefixed by function to avoid the reserved-keyword
//   collision (`loop`, `if`, ...); `a11y_tree_qd_frontier` chosen
//   over `frontier_loop`.
// * SysV alignment: query_descendants pushes six callee-save + sub 8
//   = 56 bytes so rsp%16==0 at any nested call site (this file has
//   NO nested calls, but the discipline stays for symmetry with the
//   sibling compositor files).
// * Stats: three counter cells (edges added / queries served /
//   refusals), rounded to four for cache-line pad; NOT named
//   _a11y_tree_stats because that collides with src/user/a11y/
//   tree_kind.pdx's own _a11y_tree_stats (both would emit as ELF
//   globals; every `pub let` scalar is a real symbol per the
//   monorepo's landing discipline). Named _a11y_tree_edge_stats
//   here to keep the concerns typographically distinct.

module A11yTree = structure {

  // ==========================================================================
  // SECTION A  Identity, taxonomy, storage.
  // ==========================================================================

  pub let A11Y_TREE_EDGE_MAX  : u64 = 128
  pub let A11Y_TREE_NODE_MAX  : u64 = 0xFFFF        // pack format ceiling

  pub let A11Y_TREE_OK        : u64 = 0
  pub let A11Y_TREE_ENOSPC    : u64 = 0xFFFFE950
  pub let A11Y_TREE_BAD_ARG   : u64 = 0xFFFFE951

  pub let A11Y_TREE_ST_EDGES   : u64 = 0
  pub let A11Y_TREE_ST_QUERIES : u64 = 1
  pub let A11Y_TREE_ST_REFUSED : u64 = 2

  // 128 slots × u32 = 512 bytes = 8 cache lines.
  pub let mut _a11y_tree_edges      : [u32; 128] = uninit @align(64)
  // 4 counter cells (three live + one reserved) = 32 bytes = half cache line.
  pub let mut _a11y_tree_edge_stats : [u64; 4]   = uninit @align(64)

  // ==========================================================================
  // SECTION B  Reset. Defensive; .bss is already zero at real boot.
  // ==========================================================================

  pub let a11y_tree_edges_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave ζ ζ-05: scrub 128 edge slots (u32 each) plus 4 counter cells. Two short scans, no `add reg, [mem]` RMW. Labels prefixed a11y_tree_er_ (edges-reset), suffix -step to avoid the paideia-as `loop` keyword collision.",
      block: {
        lea r10, [rip + _a11y_tree_edges];
        xor rax, rax;
        xor rcx, rcx;
      a11y_tree_er_edges_step:
        mov_d [r10 + rcx * 4], rax;
        add rcx, 1;
        cmp rcx, 128;
        jb  a11y_tree_er_edges_step;

        lea r10, [rip + _a11y_tree_edge_stats];
        xor rcx, rcx;
      a11y_tree_er_stats_step:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  a11y_tree_er_stats_step;
        ret
      }
    }

  // ==========================================================================
  // SECTION C  Counter bump / read primitives.
  // ==========================================================================

  pub let a11y_tree_edge_stats_bump : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave ζ ζ-05: bounds-checked counter bump (which < 4). Load-inc-store idiom (no `add reg, [mem]`). Labels prefixed a11y_tree_esb_.",
      block: {
        cmp rdi, 4;
        jae a11y_tree_esb_out;
        lea r10, [rip + _a11y_tree_edge_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      a11y_tree_esb_out:
        ret
      }
    }

  pub let a11y_tree_edge_stats_read : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave ζ ζ-05: bounds-checked counter read. Labels prefixed a11y_tree_esr_.",
      block: {
        cmp rdi, 4;
        jae a11y_tree_esr_zero;
        lea r10, [rip + _a11y_tree_edge_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      a11y_tree_esr_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // SECTION D  a11y_tree_add_edge(parent, child) -> slot_index | ENOSPC | BAD_ARG.
  //
  // Gates: parent != 0 AND child != 0 AND parent <= 0xFFFF AND child
  // <= 0xFFFF. (parent == 0 would name the tree root but the root
  // never appears on the child-side of an edge, so it never needs a
  // row here either; child == 0 is the "empty slot" sentinel.) Then
  // low-first scan for a slot whose current value is 0, and write the
  // packed edge.
  // ==========================================================================

  pub let a11y_tree_add_edge : (u64, u64) -> u64 !{mem} @{} =
    fn (parent: u64) (child: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave ζ ζ-05: pack parent (low 16) | child (high 16) into a u32 slot; refuse zero-endpoint or >0xFFFF; low-first free-slot scan (slot value == 0 means empty). Bumps A11Y_TREE_ST_EDGES on success, A11Y_TREE_ST_REFUSED on any refusal (BAD_ARG or ENOSPC). Two callee-save pushes (rbx = packed-edge cache, r12 = scratch base pointer stash) + sub rsp,8 = 24 bytes -- entry rsp%16==8, +16+8 = 24, rsp%16==0 at every nested call (only a11y_tree_edge_stats_bump nests). Labels prefixed a11y_tree_ae_.",
      block: {
        push rbx;
        push r12;
        sub  rsp, 8;

        cmp  rdi, 0;
        je   a11y_tree_ae_bad;
        cmp  rsi, 0;
        je   a11y_tree_ae_bad;
        mov  r10, 0xFFFF;
        cmp  rdi, r10;
        ja   a11y_tree_ae_bad;
        cmp  rsi, r10;
        ja   a11y_tree_ae_bad;

        // Pack: rax = (child << 16) | parent -- low 32 bits meaningful.
        mov  rax, rsi;
        shl  rax, 16;
        or   rax, rdi;
        mov  rbx, rax;                    // stash packed edge (callee-save)

        lea  r12, [rip + _a11y_tree_edges];
        xor  rcx, rcx;
      a11y_tree_ae_scan:
        cmp  rcx, 128;
        jae  a11y_tree_ae_enospc;
        mov_d r11, [r12 + rcx * 4];
        cmp  r11, 0;
        je   a11y_tree_ae_claim;
        add  rcx, 1;
        jmp  a11y_tree_ae_scan;

      a11y_tree_ae_claim:
        mov_d [r12 + rcx * 4], rbx;
        // Bump edges counter; slot index survives in rcx across the
        // bump call as it is not touched by the bump primitive above
        // (which reads / writes only _a11y_tree_edge_stats via r10/rax).
        // Belt-and-braces: stash slot index into rbx before the call.
        mov  rbx, rcx;
        mov  rdi, 0;                      // A11Y_TREE_ST_EDGES
        call a11y_tree_edge_stats_bump;
        mov  rax, rbx;                    // return slot index
        jmp  a11y_tree_ae_out;

      a11y_tree_ae_enospc:
        mov  rbx, 0xFFFFE950;             // A11Y_TREE_ENOSPC
        mov  rdi, 2;                      // A11Y_TREE_ST_REFUSED
        call a11y_tree_edge_stats_bump;
        mov  rax, rbx;
        jmp  a11y_tree_ae_out;

      a11y_tree_ae_bad:
        mov  rbx, 0xFFFFE951;             // A11Y_TREE_BAD_ARG
        mov  rdi, 2;                      // A11Y_TREE_ST_REFUSED
        call a11y_tree_edge_stats_bump;
        mov  rax, rbx;

      a11y_tree_ae_out:
        add  rsp, 8;
        pop  r12;
        pop  rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION E  a11y_tree_query_descendants(root, out_buf, buf_cap) -> count.
  //
  // BFS from root through _a11y_tree_edges. Uses out_buf itself as the
  // frontier queue: the first `count` u32s hold both the BFS result
  // AND the yet-to-visit queue (`head` tracks the next un-visited
  // slot). This means the buf_cap ceiling doubles as the cycle
  // self-terminator: a malformed edge set that forms a cycle stops
  // adding when count == buf_cap, and the caller sees the full buffer
  // and can escalate. No visited-set bitmap is maintained (see file
  // header §CYCLE POSTURE).
  //
  // BAD_ARG conditions (return 0 verbatim rather than a distinct
  // sentinel, since count==0 is already the "nothing to walk" outcome
  // a valid but empty tree would produce): root == 0, out_buf == 0,
  // buf_cap == 0. A11Y_TREE_ST_QUERIES bumps once per non-BAD_ARG
  // call; BAD_ARG bumps A11Y_TREE_ST_REFUSED and returns 0.
  //
  // Register plan across the whole body (all callee-save so they
  // survive the a11y_tree_edge_stats_bump nested call):
  //   rbx = current node_id (u32-range, u64-slot)
  //   r12 = out_buf pointer
  //   r13 = buf_cap
  //   r14 = count (u32s written)
  //   r15 = head (u32-index of next un-visited slot)
  //
  // Five callee-save pushes = 40 bytes -- entry rsp%16==8, +40 = 48,
  // rsp%16==0 at every nested call (only edge_stats_bump nests). No
  // pad needed; the five callee-saves happen to align exactly.
  // ==========================================================================

  pub let a11y_tree_query_descendants : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (root: u64) (out_buf: u64) (buf_cap: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave ζ ζ-05: BFS from root through _a11y_tree_edges; writes discovered child node_ids as u32 into out_buf; returns count. Frontier queue reuses out_buf; buf_cap self-terminates any cycle. Five callee-save pushes (rbx=current, r12=out_buf, r13=buf_cap, r14=count, r15=head) = 40 bytes -- entry rsp%16==8, +40 lands rsp%16==0 for every nested call (only a11y_tree_edge_stats_bump nests); no pad qword needed since five pushes align exactly. `mov_d rN, [mem]` for u32 loads (aml_arena.pdx pattern) zero-extends into full-width rN; `mov_d [mem], rN` for the paired store. BAD_ARG paths (root/out_buf/buf_cap == 0) return 0 verbatim (indistinguishable from an empty valid walk) after bumping REFUSED. Non-BAD_ARG calls bump QUERIES. Labels prefixed a11y_tree_qd_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // BAD_ARG gate: any of root/out_buf/buf_cap == 0 -> refuse.
        cmp  rdi, 0;
        je   a11y_tree_qd_bad;
        cmp  rsi, 0;
        je   a11y_tree_qd_bad;
        cmp  rdx, 0;
        je   a11y_tree_qd_bad;

        mov  rbx, rdi;                    // current = root
        mov  r12, rsi;                    // out_buf
        mov  r13, rdx;                    // buf_cap
        xor  r14, r14;                    // count = 0
        xor  r15, r15;                    // head  = 0

        // Bump QUERIES once up-front. Slot index 1 = A11Y_TREE_ST_QUERIES.
        mov  rdi, 1;
        call a11y_tree_edge_stats_bump;

      a11y_tree_qd_frontier:
        lea  r10, [rip + _a11y_tree_edges];
        xor  rcx, rcx;

      a11y_tree_qd_scan:
        cmp  rcx, 128;
        jae  a11y_tree_qd_next_frontier;
        mov_d r11, [r10 + rcx * 4];
        cmp  r11, 0;
        je   a11y_tree_qd_scan_next;

        // Extract parent (low 16); compare against current (low 16 too).
        mov  rax, r11;
        and  rax, 0xFFFF;
        mov  r8,  rbx;
        and  r8,  0xFFFF;
        cmp  rax, r8;
        jne  a11y_tree_qd_scan_next;

        // Extract child (bits 31:16).
        mov  rax, r11;
        shr  rax, 16;
        and  rax, 0xFFFF;

        // Capacity: count < buf_cap else abort BFS with what we have.
        cmp  r14, r13;
        jae  a11y_tree_qd_done;

        // Write child as u32 at out_buf[count]; increment count.
        mov_d [r12 + r14 * 4], rax;
        add  r14, 1;

      a11y_tree_qd_scan_next:
        add  rcx, 1;
        jmp  a11y_tree_qd_scan;

      a11y_tree_qd_next_frontier:
        cmp  r15, r14;
        jae  a11y_tree_qd_done;
        // current = out_buf[head] (u32, zero-extended into rbx).
        mov_d rbx, [r12 + r15 * 4];
        add  r15, 1;
        jmp  a11y_tree_qd_frontier;

      a11y_tree_qd_done:
        mov  rax, r14;
        pop  r15;
        pop  r14;
        pop  r13;
        pop  r12;
        pop  rbx;
        ret;

      a11y_tree_qd_bad:
        mov  rdi, 2;                      // A11Y_TREE_ST_REFUSED
        call a11y_tree_edge_stats_bump;
        xor  rax, rax;
        pop  r15;
        pop  r14;
        pop  r13;
        pop  r12;
        pop  rbx;
        ret
      }
    }
}
