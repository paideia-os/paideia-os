// src/user/compositor/per_client_gl_context.pdx -- Wave sigma sigma-04 (R37
// GPU context -> compositor per-client GL-like context)
//
// =============================================================================
// STATUS: HONEST SCAFFOLD
// =============================================================================
// R37 landed gpu_context as a kernel-internal cap-op (kind_gpu_context.pdx).
// Userspace has no gpu_context_new / gpu_context_switch syscalls yet. This
// module carries one context slot per client (indexed by client_kind_id)
// that stashes {gpu_ctx_row_id, vm_slot_idx, flags} so a future compositor
// draw path can look up the correct GPU-context handle when it dispatches
// to a client's surface.
//
// Both nested cap-ops go through local returns-0 stubs. The vm_slot_idx
// field is a placeholder that will bind, when the real path lands, to the
// per-client GPU-VM row assigned by sigma-02 surface_page_map; in this wave
// it is stored as PCC_VM_UNBOUND (0xFFFFFFFF) so an observer can see the
// intent without misreading a stub 0 as "bound to slot 0".
//
// LINKAGE. Unlinked in this wave; see scanout_bo.pdx header for the shared
// story.
//
// =============================================================================
// SLOT LAYOUT (32 B / slot; 16 slots; 64 u64 total)
// =============================================================================
//   +0   u64 client_kind_id       (0 => slot free)
//   +8   u64 gpu_ctx_row_id       (from gpu_context_new; stub 0)
//   +16  u64 vm_slot_idx          (PCC_VM_UNBOUND until real path lands)
//   +24  u64 flags                (bit 0 = active; other bits reserved)
//
// The "active" bit tracks the last per_client_ctx_activate result: at most
// one slot has bit 0 set at a time, and per_client_ctx_activate clears
// every other slot's active bit before setting its own.
//
// FAILURE BAND. 0xFFFFECA0..0xFFFFECAF reserved for per_client_gl_context;
// grep-verified fresh at landing.
//
// =============================================================================
// MODULE BASENAME
// =============================================================================
// per_client_gl_context.pdx -> module PerClientGlContext. Labels prefixed
// per_client_ctx_ (leading label token abbreviated from the module name;
// the ELF symbols use the module name in full via the `pub let` prefix).

module PerClientGlContext = structure {

  pub let PCC_MAX          : u64 = 16
  pub let PCC_ROW_BYTES    : u64 = 32
  pub let PCC_ROW_WORDS    : u64 = 4
  pub let PCC_VM_UNBOUND   : u64 = 0xFFFFFFFF
  pub let PCC_NO_SLOT      : u64 = 0xFFFFFFFF
  pub let PCC_FLAG_ACTIVE  : u64 = 0x1

  pub let PCC_OK           : u64 = 0
  pub let PCC_BAD_CLIENT   : u64 = 0xFFFFECA0
  pub let PCC_ENOSPC       : u64 = 0xFFFFECA1
  pub let PCC_NOT_ATTACHED : u64 = 0xFFFFECA2
  pub let PCC_STUB_FAIL    : u64 = 0xFFFFECA3

  // Mode constant intended for gpu_context_new (LINEAR). Kept as a
  // module-let so a future consumer can swap TILED without an inline
  // literal spread across call sites.
  pub let PCC_MODE_LINEAR  : u64 = 0

  // 16 slots * 4 u64 = 64 u64.
  pub let mut _per_client_ctx : [u64; 64] = uninit @align(64)

  // ==========================================================================
  // Local R37 stubs. Both return 0. Distinct names per stub so a future
  // externally-defined kernel symbol does not accidentally shadow.
  // ==========================================================================

  pub let per_client_ctx_gpu_context_new_stub : (u64) -> u64 !{} @{} =
    fn (mode: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave sigma sigma-04: R37 gpu_context_new stub. Returns 0 until userspace gpu_context_new syscall lands. Leaf.",
      block: {
        xor rax, rax;
        ret
      }
    }

  pub let per_client_ctx_gpu_context_switch_stub : (u64) -> u64 !{} @{} =
    fn (gpu_ctx_row_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave sigma sigma-04: R37 gpu_context_switch stub. Returns 0 until userspace gpu_context_switch syscall lands. Leaf.",
      block: {
        xor rax, rax;
        ret
      }
    }

  pub let per_client_ctx_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave sigma sigma-04: zero _per_client_ctx (64 u64) at boot. Leaf. Labels prefixed per_client_ctx_srz_.",
      block: {
        lea r10, [rip + _per_client_ctx];
        xor rax, rax;
        xor rcx, rcx;
      per_client_ctx_srz_step:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 64;
        jb  per_client_ctx_srz_step;
        ret
      }
    }

  // per_client_ctx_find(client_kind_id) -> slot_idx | PCC_MAX.
  //   Linear scan by client_kind_id at +0. Internal helper. Leaf.
  pub let per_client_ctx_find : (u64) -> u64 !{mem} @{} =
    fn (client_kind_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave sigma sigma-04: linear scan for client_kind_id. Returns PCC_MAX (16) when not found. Leaf. Labels prefixed per_client_ctx_fn_.",
      block: {
        xor rcx, rcx;
      per_client_ctx_fn_step:
        cmp rcx, 16;
        jae per_client_ctx_fn_none;
        lea r10, [rip + _per_client_ctx];
        mov r11, rcx;
        imul r11, r11, 32;
        add r10, r11;
        mov rax, [r10 + 0];
        cmp rax, rdi;
        je  per_client_ctx_fn_hit;
        add rcx, 1;
        jmp per_client_ctx_fn_step;
      per_client_ctx_fn_hit:
        mov rax, rcx;
        ret;
      per_client_ctx_fn_none:
        mov rax, 16;
        ret
      }
    }

  // per_client_ctx_attach(client_kind_id) -> slot_idx | PCC_NO_SLOT.
  //   Gates: client_kind_id != 0 -> PCC_NO_SLOT (BAD_CLIENT funnel).
  //   Idempotent on re-attach: returns the existing slot_idx.
  //   Otherwise: find first free (client_kind_id == 0); call gpu_context_
  //   new stub with LINEAR mode; store {client_kind_id, ctx_row (stub 0),
  //   vm_slot_idx = PCC_VM_UNBOUND, flags = 0}. Returns slot_idx.
  //
  //   Two-push prologue (rbx=client, r12=slot_idx) + 8-byte pad keeps
  //   rsp%16==0 across nested calls (entry 8, +16 pushes + 8 pad = 0).
  pub let per_client_ctx_attach : (u64) -> u64 !{mem} @{} =
    fn (client_kind_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave sigma sigma-04: attach a GPU context to a client. Two-push + pad prologue for nested find + stub calls. Idempotent. Labels prefixed per_client_ctx_at_.",
      block: {
        push rbx;
        push r12;
        sub  rsp, 8;

        mov rbx, rdi;

        cmp rbx, 0;
        je  per_client_ctx_at_bad;

        // Idempotent: return existing slot_idx if present.
        mov rdi, rbx;
        call per_client_ctx_find;
        cmp rax, 16;
        jne per_client_ctx_at_hit;

        // Scan for a free slot.
        xor r12, r12;
      per_client_ctx_at_scan:
        cmp r12, 16;
        jae per_client_ctx_at_bad;            // reuse bad-return path for ENOSPC too
        lea r10, [rip + _per_client_ctx];
        mov r11, r12;
        imul r11, r11, 32;
        add r10, r11;
        mov rax, [r10 + 0];
        cmp rax, 0;
        je  per_client_ctx_at_claim;
        add r12, 1;
        jmp per_client_ctx_at_scan;

      per_client_ctx_at_claim:
        // Call gpu_context_new(LINEAR).
        mov rdi, 0;                           // PCC_MODE_LINEAR
        call per_client_ctx_gpu_context_new_stub;
        mov rcx, rax;                         // gpu_ctx_row_id

        // Recompute slot base.
        lea r10, [rip + _per_client_ctx];
        mov r11, r12;
        imul r11, r11, 32;
        add r10, r11;

        mov [r10 + 0], rbx;                   // client_kind_id
        mov [r10 + 8], rcx;                   // gpu_ctx_row_id
        mov rax, 0xFFFFFFFF;
        mov [r10 + 16], rax;                  // vm_slot_idx = PCC_VM_UNBOUND
        xor rax, rax;
        mov [r10 + 24], rax;                  // flags = 0

        mov rax, r12;                         // return slot_idx
        jmp per_client_ctx_at_out;

      per_client_ctx_at_hit:
        // Existing slot_idx already in rax.
        jmp per_client_ctx_at_out;

      per_client_ctx_at_bad:
        mov rax, 0xFFFFFFFF;                  // PCC_NO_SLOT

      per_client_ctx_at_out:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }

  // per_client_ctx_detach(client_kind_id) -> PCC_OK | PCC_NOT_ATTACHED.
  //   One-push prologue keeps rsp%16==0 across the find call.
  pub let per_client_ctx_detach : (u64) -> u64 !{mem} @{} =
    fn (client_kind_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave sigma sigma-04: detach GPU context. One-push prologue for the find call. Labels prefixed per_client_ctx_dt_.",
      block: {
        push rbx;

        mov rbx, rdi;

        mov rdi, rbx;
        call per_client_ctx_find;
        cmp rax, 16;
        je  per_client_ctx_dt_none;

        lea r10, [rip + _per_client_ctx];
        mov r11, rax;
        imul r11, r11, 32;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0], rax;
        mov [r10 + 8], rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        xor rax, rax;                         // PCC_OK
        jmp per_client_ctx_dt_out;

      per_client_ctx_dt_none:
        mov rax, 0xFFFFECA2;                  // PCC_NOT_ATTACHED

      per_client_ctx_dt_out:
        pop rbx;
        ret
      }
    }

  // per_client_ctx_activate(client_kind_id) -> PCC_OK | PCC_NOT_ATTACHED.
  //   Clears the active bit on every slot then sets it on the found slot,
  //   after calling the gpu_context_switch stub with the stashed
  //   gpu_ctx_row_id. Two-push (rbx=client, r12=slot_idx) prologue + 8B
  //   pad = 32 (aligned) for the nested calls.
  pub let per_client_ctx_activate : (u64) -> u64 !{mem} @{} =
    fn (client_kind_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave sigma sigma-04: activate GPU context for one client. Two-push + pad prologue (rbx/r12 + 8B) keeps rsp%16==0 across nested find + stub calls. Labels prefixed per_client_ctx_av_.",
      block: {
        push rbx;
        push r12;
        sub  rsp, 8;

        mov rbx, rdi;

        mov rdi, rbx;
        call per_client_ctx_find;
        cmp rax, 16;
        je  per_client_ctx_av_none;
        mov r12, rax;                         // r12 = slot_idx

        // Read gpu_ctx_row_id from the slot and call switch stub.
        lea r10, [rip + _per_client_ctx];
        mov r11, r12;
        imul r11, r11, 32;
        add r10, r11;
        mov rdi, [r10 + 8];                   // gpu_ctx_row_id
        call per_client_ctx_gpu_context_switch_stub;

        // Clear active bit on every slot.
        xor rcx, rcx;
      per_client_ctx_av_clr:
        cmp rcx, 16;
        jae per_client_ctx_av_set;
        lea r10, [rip + _per_client_ctx];
        mov r11, rcx;
        imul r11, r11, 32;
        add r10, r11;
        mov rax, [r10 + 24];
        // Clear bit 0 via `and rax, 0xFFFFFFFE`. The imm32 0xFFFFFFFE
        // sign-extends to 0xFFFFFFFFFFFFFFFE at the encoder, which
        // preserves every bit above bit 0. Destination is rax so no
        // r11-imm64-scratch collision (see feedback_pdx_encoder_
        // pitfalls); attested-safe by kernel/acpi/fadt.pdx `and rax,
        // 0xFFFF` pattern.
        and rax, 0xFFFFFFFE;
        mov [r10 + 24], rax;
        add rcx, 1;
        jmp per_client_ctx_av_clr;

      per_client_ctx_av_set:
        // Set active bit on the winning slot.
        lea r10, [rip + _per_client_ctx];
        mov r11, r12;
        imul r11, r11, 32;
        add r10, r11;
        mov rax, [r10 + 24];
        mov rdi, 1;
        or  rax, rdi;
        mov [r10 + 24], rax;

        xor rax, rax;                         // PCC_OK
        jmp per_client_ctx_av_out;

      per_client_ctx_av_none:
        mov rax, 0xFFFFECA2;                  // PCC_NOT_ATTACHED

      per_client_ctx_av_out:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }
}
