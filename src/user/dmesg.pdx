// src/user/dmesg.pdx -- R60.M7-001 (paideia-os #1816) -- /bin/dmesg user binary
//
// Minimal self-contained /bin/dmesg: peek the kernel klog ring once via
// sys_dmesg(SC+ ID 13), echo the returned bytes to stdout via sys_write,
// then report a fingerprint (with byte count) or a fail marker and exit.
//
// -----------------------------------------------------------------------------
// M0 posture -- what is real, what is deferred
// -----------------------------------------------------------------------------
//
// REAL:
//   (a) The sys_dmesg(13) syscall path -- single 4-KiB peek into a .bss
//       scratch buffer, kernel body at src/kernel/core/syscall/dispatch.pdx
//       dispatch_dmesg (L913+), which calls sys_dmesg_body ->
//       klog_ring_read_tail. This is a non-consuming peek: the ring tail
//       pointer does NOT advance, so repeated calls see the same window.
//   (b) sys_write(1, ...) to emit the raw ring bytes on stdout -- lands on
//       whatever the shell wired to fd 1 (init's boot-time dup2 chain to
//       /dev/tty0, preserved across fork+exec).
//   (c) Decimal formatting via a local dm_print_u64_dec helper, routed
//       through sys_debug_puts rather than sys_write so the fingerprint
//       rides the tty-bypassing channel used by every other M0 fingerprint
//       emitter in this tree (cp.pdx, mkdir.pdx, touch.pdx, rm.pdx, mv.pdx).
//
// DEFERRED (M1+):
//   No pagination and no loop -- a single 4096-byte peek is the syscall's
//   own per-call cap (dispatch.pdx's DISPATCH_IO_MAX) and is sufficient at
//   R60 klog volumes. A future dmesg -f / offset-tracking mode would need
//   the ring to expose a real read cursor (sys_dmesg is peek-only at M0,
//   matching POSIX syslog(2) SYSLOG_ACTION_READ_ALL semantics per
//   dispatch.pdx's own dispatch_dmesg comment) -- out of scope for #1816.
//
// -----------------------------------------------------------------------------
// Design choice -- self-contained, no syscall_shim link dependency
// -----------------------------------------------------------------------------
//
// Mirrors true.pdx / cat.pdx / ps.pdx / rm.pdx / mv.pdx / mkdir.pdx /
// touch.pdx / cp.pdx: inlines every syscall it needs directly at their call
// sites. One .pdx file, one .elf. tools/build-user.sh classifies dmesg into
// its own object set (no library pull-in, no collision with init.elf /
// shell.elf's shared syscall_shim.o). The one internal `call`
// (dm_print_u64_dec) is a local helper defined in the same module.
//
// dm_print_u64_dec is a verbatim adaptation of cp.pdx's cp_print_u64_dec
// (itself adapted from ps.pdx's print_u64_dec, the tree's reference
// divide-by-10 implementation, R17-M2-736 D12 / #736), routed through
// sys_debug_puts instead of sys_write for the same reason cp.pdx chose
// that channel: the byte-count suffix should ride the same fail-safe path
// as the rest of dmesg's fingerprint/fail-marker output.
//
// -----------------------------------------------------------------------------
// argv posture (R62.M1-005, #1836)
// -----------------------------------------------------------------------------
//
// dmesg takes no path argument -- it peeks the kernel klog ring, not a
// file -- so it is unaffected by the R62 frozen execve argc/argv/envp ABI
// (design/user/execve-abi.md) beyond the fact that argc/argv/envp now
// legitimately arrive in rdi/rsi/rdx at _start (ignored here, same as
// they always were).
//
// -----------------------------------------------------------------------------
// SC+ IDs used (src/user/syscall_shim.pdx §2.1)
// -----------------------------------------------------------------------------
//   1  = sys_write(fd, buf, count)   -> count written or -errno
//   12 = sys_debug_puts(buf, count)  -- fingerprint + fail-marker emit
//   13 = sys_dmesg(buf, len)         -> bytes copied (>=0) or -errno
//   60 = sys_exit(status)            -- never returns
//
// -----------------------------------------------------------------------------
// Register discipline in _start
// -----------------------------------------------------------------------------
//
//   r12 = &dmesg_buf (lea'd once, constant for the whole function -- kept
//         in a callee-save register because it is re-read after the
//         intervening sys_write / sys_debug_puts / dm_print_u64_dec calls,
//         all of which are SysV callee-save-respecting per the tree's own
//         syscall + local-call conventions).
//   r13 = bytes copied by sys_dmesg (saved immediately out of rax before
//         sys_write's own return value clobbers it; re-read for the
//         fingerprint's decimal suffix).
//
// No push/pop prologue is needed: SYSCALL preserves callee-save registers
// per amd64 fast-syscall rules, and dm_print_u64_dec is a SysV
// callee-save-respecting local call (matches cp.pdx's `call
// cp_print_u64_dec` posture).
//
// -----------------------------------------------------------------------------
// Encoder-gap discipline
// -----------------------------------------------------------------------------
//
// No `add reg, [mem]` / `sub reg, [mem]` anywhere. All immediates
// (4096 for the peek length, 4096 for the write-length cap symmetry, the
// literal string lengths) fit comfortably under the imm32 sign-extension
// boundary this tree tracks (paideia-as 09309ef's `add/sub r64, [mem]`
// support is not exercised here since this binary has no memory-operand
// arithmetic to begin with).
//
// -----------------------------------------------------------------------------
// Reserved-label discipline
// -----------------------------------------------------------------------------
//
// Every _start label is prefixed `dm_`; every dm_print_u64_dec internal
// label is prefixed `dm_pud_` (bare `loop`/`done`/`top` are paideia-as
// keywords per the tree's reserved-label convention).

module Dmesg = structure {

  // 4 KiB peek scratch. .bss (uninit) so p_filesz stays small; the loader
  // zero-fills bss pages (matches cat.pdx's cat_buf / cp.pdx's cp_buf
  // rationale). Declared [u64; 512] rather than [u8; 4096] so paideia-as
  // places it at 8-byte alignment, matching the kernel's own
  // _dispatch_dmesg_buf_scratch @align(8) declaration in dispatch.pdx.
  pub let mut dmesg_buf : [u64; 512] = uninit @align(8)

  // Fingerprint prefix -- everything up to and including "bytes=". The
  // variable byte count is appended by dm_print_u64_dec, and the
  // trailing newline is a separate one-byte sys_debug_puts. Storage
  // carries the trailing NUL; wire length excludes it. ASCII "--" in
  // place of an em-dash keeps the line 7-bit ASCII (matches cp.pdx /
  // mkdir.pdx precedent).
  pub let dm_msg_prefix     : [u8; 19] = "dmesg ok -- bytes=\0"
  pub let dm_msg_prefix_len : u64     = 18

  pub let dm_msg_nl     : [u8; 2] = "\n\0"
  pub let dm_msg_nl_len : u64     = 1

  // Fail marker -- sys_dmesg returned a negative errno.
  pub let dm_err_fail     : [u8; 17] = "dmesg peek fail\n\0"
  pub let dm_err_fail_len : u64     = 16

  // ==========================================================================
  // dm_print_u64_dec(value: u64) -> ()
  //
  // u64 -> decimal ASCII, emitted via sys_debug_puts (SC+ ID 12) so the
  // byte count rides the same tty-bypassing fingerprint channel as the
  // rest of dmesg's output. Verbatim adaptation of cp.pdx's
  // cp_print_u64_dec (itself adapted from ps.pdx's print_u64_dec, the
  // tree's reference divide-by-10 implementation, R17-M2-736 D12 / #736):
  // digits are stashed right-to-left in a 24-byte stack scratch, then one
  // sys_debug_puts emits the [first_digit, len] slice. Zero fast-paths to
  // a single '0' digit.
  //
  // SysV register discipline:
  //   Reads    : rdi (value)
  //   Preserves: rbx, rbp, r12-r15 (callee-save; untouched by this body)
  //   Clobbers : rax, rcx, rdx, rsi, rdi, r9, r10, r11
  //   Stack    : 24 bytes (20 digits max for u64::MAX + 4 for 16-B align)
  // ==========================================================================
  pub let dm_print_u64_dec : (u64) -> () !{mem, sysreg} @{fs} =
    fn (value: u64) -> unsafe {
      effects: {mem, sysreg},
      capabilities: {fs},
      justification: "R60.M7-001 (#1816): u64 -> decimal ASCII for dmesg's 'bytes=<N>' fingerprint suffix, emitted via sys_debug_puts (SC+ ID 12) so the digits ride the same tty-bypassing channel as dmesg's fingerprint/fail markers. Verbatim divide-by-10 loop shape (src/user/cp.pdx §cp_print_u64_dec / src/user/ps.pdx §print_u64_dec, R17-M2-736 D12 / #736): (1) zero fast-path writes a single '0' digit and returns. (2) Otherwise r9 holds the remaining value and r10 is a right-to-left cursor into a 24-byte stack scratch starting at offset 19; each iteration divides r9 by 10 (rax:rdx = r9/10 via `xor rdx,rdx; div rcx`), converts the remainder to ASCII, stores it at the cursor, decrements the cursor, and loops until the quotient reaches zero. (3) The final cursor position plus (rsp+20 - cursor) gives the [buf, len] slice, emitted as sys_debug_puts(buf, len) -- rdi=buf, rsi=len, rax=12, syscall. @no_frame: the body manages its own 24-byte frame via `sub rsp, 24` / `add rsp, 24` rather than an auto rbp prologue, matching cp_print_u64_dec / print_u64_dec posture verbatim. Encoder-gap discipline: no `add reg, [mem]` / `sub reg, [mem]` -- the cursor arithmetic is register-only.",
      block: {
        // 24-byte stack scratch (20 digits max + 4-byte 16-B-align slop).
        sub rsp, 24;

        // Zero special case.
        cmp rdi, 0;
        jne dm_pud_divide_setup;
          mov al, 0x30;                   // ASCII '0'
          mov [rsp], al;
          mov rdi, rsp;                   // buf = &scratch
          mov rsi, 1;                     // count = 1
          mov rax, 12;                    // SC+ ID 12 = sys_debug_puts
          syscall;
          add rsp, 24;
          ret;

        dm_pud_divide_setup:
          mov r9, rdi;                    // r9  = remaining value
          mov r10, rsp;
          add r10, 19;                    // r10 = cursor at last staging byte

        dm_pud_loop_top:
          mov rax, r9;
          mov rcx, 10;
          xor rdx, rdx;                   // zero-extend rdx:rax for div
          div rcx;                        // rax = quotient, rdx = remainder
          add rdx, 0x30;                  // digit -> ASCII '0'..'9'
          mov [r10], dl;                  // store at cursor
          mov r9, rax;                    // r9 = quotient
          cmp r9, 0;
          je dm_pud_loop_done;
          sub r10, 1;                     // advance cursor left
          jmp dm_pud_loop_top;

        dm_pud_loop_done:
          // r10 points at first (MSB) digit. Length = (rsp + 20) - r10.
          mov rax, rsp;
          add rax, 20;
          sub rax, r10;                   // rax = digit count
          mov rsi, rax;                   // count
          mov rdi, r10;                   // buf
          mov rax, 12;                    // SC+ ID 12 = sys_debug_puts
          syscall;
          add rsp, 24;
          ret
      }
    } @no_frame

  // -------------------------------------------------------------------------
  // _start -- user program entry point. Never returns.
  //
  // Sequence:
  //   (1) sys_dmesg(buf=&dmesg_buf, len=4096) -- SC+ ID 13. rax = bytes
  //       copied (>=0) or -errno.
  //   (2) rax < 0 -> dm_fail (emit "dmesg peek fail\n", sys_exit(1)).
  //   (3) Else r13 = bytes copied (saved out of rax before the next
  //       syscall clobbers it). sys_write(1, &dmesg_buf, r13) -- SC+ ID 1,
  //       echoes the ring bytes to stdout (return value discarded, same
  //       posture as cp.pdx's fd closes -- dmesg does not retry short
  //       writes at M0).
  //   (4) Emit dm_msg_prefix ("dmesg ok -- bytes="), `call
  //       dm_print_u64_dec` with rdi = r13, emit dm_msg_nl ("\n").
  //   (5) sys_exit(0).
  //
  // Effects/caps:
  //   mem     -- reads dm_msg_*/dm_err_* rodata, reads+writes dmesg_buf.
  //   sysreg  -- every SYSCALL clobbers rcx (RIP)/r11 (rflags).
  //   fs      -- sys_write / sys_debug_puts (both dispatch through the
  //              fs-capability syscall table per syscall_shim.pdx).
  //   sched   -- sys_exit terminates the task.
  //
  // @no_frame because the function ends in sys_exit on every terminal
  // path (never returns); entry rsp%16==0 per the PVH loader contract.
  // -------------------------------------------------------------------------
  pub let _start : () -> () !{mem, sysreg} @{fs, sched} =
    fn () -> unsafe {
      effects: {mem, sysreg},
      capabilities: {fs, sched},
      justification: "R60.M7-001 (#1816): /bin/dmesg _start. Inlines sys_dmesg (SC+ ID 13, kernel body at src/kernel/core/syscall/dispatch.pdx dispatch_dmesg L913+, which delegates to sys_dmesg_body -> klog_ring_read_tail -- a non-consuming ring peek), sys_write (SC+ ID 1), sys_debug_puts (SC+ ID 12) and sys_exit (SC+ ID 60), plus one same-module `call dm_print_u64_dec` for the byte-count suffix -- same one-file-one-ELF pattern as true.pdx / cat.pdx / ps.pdx / cp.pdx. Sequence: (1) sys_dmesg(buf=&dmesg_buf, len=4096) -- rdi=buf VA (rip-relative lea), rsi=4096 (the syscall's own DISPATCH_IO_MAX cap per dispatch.pdx, so passing exactly 4096 never triggers the dispatcher's internal clamp), rax=13, syscall. rax<0 -> dm_fail (emit 'dmesg peek fail\\n' via sys_debug_puts, sys_exit(1)) -- mirrors sys_dmesg_body's own negative-errno contract (EFAULT on a bad user_ptr_ok walk is the only failure mode reachable from a correctly-sized, always-mapped .bss buffer, but the check is unconditional regardless of how unlikely). (2) Else r13 := rax (bytes copied, saved before sys_write's own return value clobbers rax) -- r13 is callee-save so it survives the sys_write, sys_debug_puts x2, and `call dm_print_u64_dec` that follow. (3) sys_write(1, &dmesg_buf, r13) -- echoes the ring bytes to stdout; return value discarded (dmesg does not retry short writes at M0, matching cp.pdx's sys_write posture -- the tty backend under /dev/tty0 does not short-write at R17-R60). (4) Emit dm_msg_prefix ('dmesg ok -- bytes='), `call dm_print_u64_dec` with rdi=r13, emit dm_msg_nl ('\\n'), sys_exit(0). Register plan: r12 = &dmesg_buf (lea'd once, constant for the whole function, re-read at the sys_write call site after the sys_dmesg syscall), r13 = bytes copied (survives every subsequent syscall + the `call dm_print_u64_dec`, callee-save, untouched by that callee per its own documented preserve-set). Neither is pushed: SYSCALL preserves callee-save regs per amd64 fast-syscall rules, and dm_print_u64_dec is a SysV callee-save-respecting function (matches cp.pdx's `call cp_print_u64_dec` posture). @no_frame because every terminal path ends in sys_exit; entry rsp%16==0 per the PVH loader contract. Encoder-gap discipline: no `add reg, [mem]` / `sub reg, [mem]` anywhere. Reserved-label discipline: every label prefixed `dm_`. sys_dmesg is stateless-peek (does not advance the ring tail), so unlike cp.pdx/mkdir.pdx there is no fd/handle to close on any path.",
      block: {
        // ============================================================
        // Phase 1 -- sys_dmesg(buf=&dmesg_buf, len=4096) -> bytes copied
        // ============================================================
        lea r12, [rip + dmesg_buf];          // r12 = &dmesg_buf (constant)
        mov rdi, r12;                        // buf
        mov rsi, 4096;                        // len (== syscall's own cap)
        mov rax, 13;                          // SC+ ID 13 = sys_dmesg
        syscall;

        cmp rax, 0;
        jl dm_fail;
        mov r13, rax;                         // r13 = bytes copied

        // ============================================================
        // Phase 2 -- sys_write(1, &dmesg_buf, r13) -- echo ring bytes
        // ============================================================
        mov rdi, 1;                           // fd = stdout
        mov rsi, r12;                         // buf = &dmesg_buf
        mov rdx, r13;                         // count = bytes copied
        mov rax, 1;                            // SC+ ID 1 = sys_write
        syscall;

        // ============================================================
        // Phase 3 -- fingerprint: "dmesg ok -- bytes=<N>\n"
        // ============================================================
        lea rdi, [rip + dm_msg_prefix];
        mov rsi, 18;                          // dm_msg_prefix_len
        mov rax, 12;                           // SC+ ID 12 = sys_debug_puts
        syscall;

        mov rdi, r13;                          // value = bytes copied
        call dm_print_u64_dec;

        lea rdi, [rip + dm_msg_nl];
        mov rsi, 1;                            // dm_msg_nl_len
        mov rax, 12;                           // SC+ ID 12 = sys_debug_puts
        syscall;

        xor rdi, rdi;                          // status = 0 (OK)
        mov rax, 60;                            // SC+ ID 60 = sys_exit
        syscall;
        hlt;

      dm_fail:
        // ============================================================
        // Phase 4 -- sys_dmesg returned a negative errno.
        // ============================================================
        lea rdi, [rip + dm_err_fail];
        mov rsi, 16;                           // dm_err_fail_len
        mov rax, 12;                            // SC+ ID 12 = sys_debug_puts
        syscall;

        mov rdi, 1;                            // status = 1
        mov rax, 60;                            // SC+ ID 60 = sys_exit
        syscall;
        hlt
      }
    } @no_frame
}
