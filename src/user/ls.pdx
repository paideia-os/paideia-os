// src/user/ls.pdx -- R57.M4-001 (#1797); v1.1 paideia-os/ls#29;
//                    v1.2 paideia-os/paideia-os#2452 (Wave 9 flag suite).
//
// /bin/ls -- POSIX-lite directory lister.
//
// v1.2 (2026-09-12, paideia-os#2452): POSIX-lite flag suite.
//   -a  show hidden entries (leading '.')
//   -l  long format (octal mode, decimal size, name)
//   -1  one entry per line (default; -1 is accepted as a no-op)
//   -F  append type suffix: '/' for dir, '*' for executable (mode & 0o111)
//
// Combined single-char forms work (`-al`, `-1F`, `-la`). The parser also
// honours `--` as an end-of-flags sentinel. On the first non-flag arg,
// the rest of argv is treated as paths -- MVP consumes only the FIRST
// non-flag path; extra paths are silently ignored (POSIX multi-dir
// listing with per-header framing is deferred).
//
// Semantic change from v1.1: by default hidden entries (name[0]=='.')
// are now HIDDEN.  Previously ls showed every getdents record verbatim.
// `-a` restores the pre-v1.2 behaviour.  This aligns with POSIX ls(1)
// and no existing shell script in-tree relied on the leaky default.
//
// v1.1 (2026-09-12, paideia-os/ls#29): userspace cwd-relative path
// resolution.  Mirrors the mkdir v1.1-B / cp v1.1.0-B pattern.  Before
// v1.1, ls handed argv[1] verbatim to sys_open and relied on the
// kernel's path_resolve(..., cwd=TASK_OFF_CWD) (R86.M1-005 #1958) to
// anchor relatives against the caller's cwd.  That was correct once
// the kernel was updated, but it left the tool blind to what it was
// actually listing.  v1.1 moves the join into userspace.
//
// Minimum-viable ls, argv-aware since R62.M1-004 (#1833).
//
// -----------------------------------------------------------------------------
// Record layout consumed here (getdents; frozen at R56.M3)
// -----------------------------------------------------------------------------
//
//   +0   ino:      u64
//   +8   name_len: u16  (0 marks the terminator record; else 1..255)
//   +10  type:     u8   VNODE_TYPE_DIR=2, VNODE_TYPE_REG=1 (backend-defined)
//   +11  reserved: u8
//   +12  name[name_len]  (no NUL terminator)
//
// -----------------------------------------------------------------------------
// stat struct layout consumed here (sys_stat; frozen at R56.M3-002)
// -----------------------------------------------------------------------------
//
//   +0   ino     u64
//   +8   size    u64        <- -l size column
//   +16  mtime   u64
//   +24  mode    u32        <- -l mode column + -F exec-bit test
//   +28  nlink   u32
//   +32  uid     u32
//   +36  gid     u32
//   +40  blksize u32
//   +44  blocks  u32
//   +48..+63    reserved
//
// tmpfs currently returns mode == 0 (see sys_stat.pdx header note); on a
// tmpfs-mounted target `ls -l` therefore prints '000000' in the mode
// column.  This is honest -- exposing the substrate limitation rather
// than fabricating POSIX-shaped mode bits.  pdxfs-lite returns the low
// 12 bits of the on-disk mode.
//
// -----------------------------------------------------------------------------
// Control flow
// -----------------------------------------------------------------------------
//
//   Phase -1 (v1.2, #2452) -- flag-parse prologue:
//     scan argv[1..], accumulate flag bits into _ls_flags; first non-
//     flag arg becomes r13 (target_arg); `--` is the end-of-flags
//     sentinel; bare `-` is treated as a path arg.
//   Phase 0 (v1.1, ls#29) -- classify-and-resolve prologue:
//     r13 == 0                          -> ls_no_arg   (default = cwd)
//     r13[0] == '/'                     -> ls_use_absolute (verbatim)
//     otherwise                         -> ls_do_resolve  (cwd + '/' + arg)
//   ls_capture_dir_path: strcpy the NUL-term path in rdi into
//                        _ls_dir_path, set _ls_dir_path_len, hand rdi
//                        back as &_ls_dir_path.  Every walk-phase stat
//                        composes entry paths against this scratch.
//   ls_open_path_ready:  sys_open(rdi, O_RDONLY=0, 0) -> fd
//   ls_getdents_top:     call sys_getdents(fd, buf, 4096)
//   ls_walk_top:         walk one record
//                        -- hidden-entry filter (skip name[0]=='.' unless -a)
//                        -- if -l or -F: ls_compose_and_stat(record, name_len)
//                        -- if -l:       emit "<oct-mode> <dec-size> "
//                        -- emit name
//                        -- if -F:       emit '/' | '*' | nothing
//                        -- emit '\n'
//                        -- advance; loop.
//   ls_close_done:       sys_close(fd); sys_exit(0)
//   ls_fail_open:        LS OPEN FAIL\n; sys_exit(1)
//   ls_fail_getdents:    LS GETDENTS FAIL\n; sys_close(fd); sys_exit(2)
//   ls_fail_getcwd:      LS GETCWD FAIL\n; sys_exit(3)
//   ls_fail_path_too_long: LS PATH TOO LONG\n; sys_exit(4)
//
// -----------------------------------------------------------------------------
// SC+ IDs consumed
// -----------------------------------------------------------------------------
//   1  = sys_write(fd, buf, count)     -- inlined by ls_put_bytes /
//                                         ls_put_u64_dec / ls_put_u64_oct6
//   2  = sys_open(path, flags, mode)   -- inlined in _start
//   3  = sys_close(fd)                 -- inlined in _start
//   12 = sys_debug_puts(buf, count)    -- inlined (fail-path serial marker)
//   60 = sys_exit(status)              -- inlined; never returns
//   77 = sys_stat(path, len, buf)      -- inlined by ls_compose_and_stat
//                                         (v1.2, #2452); returns 0 or
//                                         negative errno; fills 64-byte
//                                         record at buf.
//   78 = sys_getdents(fd, buf, cnt)    -- CALLED via src/user/libc/getdents.pdx
//   86 = sys_getcwd(buf_va, buf_len)   -- inlined (v1.1 resolve prologue)
//
// -----------------------------------------------------------------------------
// Register discipline
// -----------------------------------------------------------------------------
//
// No prologue pushes. Standalone ELF entry: iretq lands at _start with
// user_rsp at a page-aligned VA, so rsp % 16 == 0 at entry and remains
// so throughout _start (no push, no sub rsp, N).  Every same-module
// helper (ls_put_bytes / ls_put_u64_dec / ls_put_u64_oct6 /
// ls_compose_and_stat) is a SysV callee that preserves rbx, rbp, r12-r15.
// SYSCALL semantics preserve everything except rax (return), rcx (RIP),
// r11 (rflags); paideia-os's sysret epilogue additionally zeroes
// rdi/rsi/rdx/r8/r9/r10 (entry.pdx #743 hardening), so every caller-
// save reg needs reloading from a stable home (memory or r12-r15)
// after a syscall.
//
// Phase -1 register plan (transient, dies at end of Phase -1):
//   rbx = argc            (temp; reassigned to fd in Phase 1)
//   r12 = argv base       (temp; reassigned to bytes_returned in Phase 2)
//   r13 = target_arg      (or 0; dies at end of Phase 0 -- Phase 0's
//                          resolve arm consumes it; then r13 is
//                          reassigned to offset walker in Phase 2)
//   r14 = post_dashdash   (0/1; sticky flag set by the `--` sentinel so
//                          subsequent args are unconditionally path
//                          candidates; dies at end of Phase -1; then
//                          r14 is reassigned to &_ls_buf in Phase 2)
//   rcx = argv index
//   r9  = per-arg flag-char cursor
//   r15 = current argv[rcx] pointer
//
// Phase 0 register plan (v1.1, unchanged):
//   r15 = raw target-arg pointer (preserved across sys_getcwd)
//   r8  = cwd_len; r9 = user_len; r10 = sep; r11 = write cursor.
//
// Post-Phase-0 (ls_open_path_ready onward) uses the frozen v1.0 plan:
//   rbx = fd (set once by sys_open, live across every syscall + call)
//   r12 = bytes_returned by the current sys_getdents call
//   r13 = offset walker into _ls_buf
//   r14 = _ls_buf base VA (lea'd once, constant for the rest of _start)
//   r15 = per-iteration record pointer (= r14 + r13; reloaded after any
//                                      SYSCALL or CALL that clobbers it)
//
// -----------------------------------------------------------------------------
// Encoder-gap discipline (paideia-as feedback_pdx_encoder_pitfalls)
// -----------------------------------------------------------------------------
//
// * No `test rN, rN` -- every zero-check is `cmp reg, 0`.
// * No `and rN, imm64` on r8-r15 -- flag-bit masks are staged into rdx
//   first (`mov rdx, imm; and rax, rdx`).
// * No 2-op `imul r, imm`; no `add reg, [mem]` / `sub reg, [mem]`.
// * All flag-bit test loads land in rax (accumulator).
// * Byte loads use `xor rax, rax; mov_b rax, [ptr]` per the #1248
//   mitigation pattern the tree already follows.
// * The one 32-bit load (`mov edi, [rax + 24]` for the u32 mode field)
//   uses the ps.pdx-precedent form.
//
// -----------------------------------------------------------------------------
// Reserved-label discipline
// -----------------------------------------------------------------------------
//
// Every label prefixed `ls_` per the reserved-word convention.  Helper
// functions use their own prefixes (`lpb_`, `lpud_`, `lpuo_`, `lcas_`)
// to avoid cross-helper label collisions.

module Ls = structure {

  // ==========================================================================
  // Static strings.  All storage carries the trailing NUL for strlen-
  // safety; the wire length excludes it.
  // ==========================================================================
  pub let ls_newline : [u8; 2] = "\n\0"
  pub let ls_space   : [u8; 2] = " \0"
  pub let ls_slash_s : [u8; 2] = "/\0"
  pub let ls_star_s  : [u8; 2] = "*\0"

  // Fail markers -- routed through sys_debug_puts (SC+ ID 12) rather
  // than sys_write(1,..) so a broken stdout does not swallow the
  // diagnostic.
  pub let ls_err_open_msg : [u8; 15] = "LS OPEN FAIL\n\0"
  pub let ls_err_open_len : u64 = 13
  pub let ls_err_getd_msg : [u8; 19] = "LS GETDENTS FAIL\n\0"
  pub let ls_err_getd_len : u64 = 17
  pub let ls_err_gcwd_msg : [u8; 16] = "LS GETCWD FAIL\n\0"
  pub let ls_err_gcwd_len : u64 = 15
  pub let ls_err_tlong_msg : [u8; 18] = "LS PATH TOO LONG\n\0"
  pub let ls_err_tlong_len : u64 = 17

  // ==========================================================================
  // Flag bit masks.  Kept as module-level consts for documentation --
  // the code uses the literal integer via `mov rdx, imm; and rax, rdx`
  // (encoder-gap discipline forbids `and rN, imm64` on r8-r15, and
  // rax's own imm form is redundant with the reg-reg form used).
  // ==========================================================================
  pub let LS_FLAG_A : u64 = 1
  pub let LS_FLAG_L : u64 = 2
  pub let LS_FLAG_1 : u64 = 4
  pub let LS_FLAG_F : u64 = 8
  pub let LS_FLAG_L_OR_F : u64 = 10

  // ==========================================================================
  // BSS scratches.  .bss (uninit) rather than .data so ls.elf's
  // p_filesz stays small; the loader zero-fills bss pages, so every
  // scratch starts zero-valued on first entry to _start.
  //
  // 4 KiB getdents record scratch (matches kernel-side GETDENTS_IO_MAX).
  pub let mut _ls_buf : [u8; 4096] = uninit @align(8)

  // v1.1 cwd + resolve scratches (kept verbatim from v1.1).
  pub let mut _ls_cwd_scratch      : [u8; 256] = uninit @align(8)
  pub let mut _ls_resolved_scratch : [u8; 256] = uninit @align(8)

  // v1.2 (#2452): the canonical NUL-term absolute path of the directory
  // being listed.  Populated at end of Phase 0 by copying whichever of
  // the three arms' scratches (cwd / resolved / argv-verbatim) ended
  // up in rdi.  Every per-entry stat composes against this scratch,
  // freeing the walk phase from having to know which arm produced its
  // path.  256B to match the kernel path caps (SYS_STAT_PATH_MAX,
  // SYS_MKDIR_PATH_MAX, SYS_GETCWD_PATH_MAX).
  pub let mut _ls_dir_path     : [u8; 256] = uninit @align(8)
  pub let mut _ls_dir_path_len : u64       = uninit @align(8)

  // v1.2 (#2452): per-entry stat path buffer.  Composed as
  // _ls_dir_path + [sep] + entry_name + NUL.  Sized at 512B so the
  // worst case (255B dir + 1B sep + 255B name + 1B NUL) fits with
  // headroom.  Any composition exceeding 511 usable bytes flips
  // _ls_stat_ok = 0 without invoking sys_stat.
  pub let mut _ls_entry_path : [u8; 512] = uninit @align(8)

  // v1.2 (#2452): sys_stat output scratch (64 bytes per the R56.M3-002
  // struct layout).  Only mode (+24, u32) and size (+8, u64) are read
  // back at this landing; ino/mtime/nlink/uid/gid/blksize/blocks are
  // filled by the kernel but ignored here (space for -l column growth).
  pub let mut _ls_stat_buf : [u8; 64] = uninit @align(8)

  // v1.2 (#2452): 1 = last sys_stat succeeded, 0 = failed or was
  // skipped.  Read by ls_no_stat's mode/size formatter and by the
  // -F exec-bit branch to decide whether _ls_stat_buf's contents are
  // authoritative (on failure the mode/size fields are re-zeroed by
  // ls_compose_and_stat, so a spurious '000000  0' prints instead of
  // stale bytes from a prior entry).
  pub let mut _ls_stat_ok : u64 = uninit @align(8)

  // v1.2 (#2452): flag-bit accumulator populated by Phase -1.
  pub let mut _ls_flags : u64 = uninit @align(8)

  // v1.2 (#2452): 6-byte octal formatter scratch.  Used only by
  // ls_put_u64_oct6 for the -l mode column.  BSS rather than stack
  // to keep the helper's `sub rsp / add rsp` bookkeeping out of the
  // picture (the helper has no nested CALL, and SYSCALL is stack-
  // alignment-neutral).
  pub let mut _ls_oct_scratch : [u8; 8] = uninit @align(8)

  // ==========================================================================
  // ls_put_bytes(buf, count) -- sys_write(1, buf, count).
  //
  // Small trampoline used by the -l / -F / newline emit sites so a
  // full 5-instruction syscall sequence does not repeat six times per
  // entry.  Return value ignored: sys_write's tty0 backing is length-
  // honoring at R17.M0, and a short write would only affect a fail-
  // path marker (which sys_debug_puts handles separately anyway).
  //
  // SysV register discipline:
  //   Reads    : rdi (buf), rsi (count)
  //   Preserves: rbx, rbp, r12-r15 (untouched)
  //   Clobbers : rax, rcx, rdx, rsi, rdi, r8, r9, r10, r11
  // ==========================================================================
  pub let ls_put_bytes : (u64, u64) -> () !{mem, sysreg} @{fs} =
    fn (buf: u64) (count: u64) -> unsafe {
      effects: {mem, sysreg},
      capabilities: {fs},
      justification: "v1.2 (#2452): thin sys_write(1, buf, count) trampoline. Emit sites in the v1.2 walk phase (mode column, size column, name, -F suffix, newline) share the shape; centralising it here shrinks _start below the R31.M2-1595 16-page budget cap.  Args arrive in rdi/rsi per SysV; the body shuffles them into the SC+ ID 1 slots (rdi=fd, rsi=buf, rdx=count) in reverse-dependency order (rsi->rdx before rdi is overwritten) so no scratch register is needed.  @no_frame: leaf function, no CALL, single syscall, no stack scratch; `ret` returns directly to the caller.  Effect union matches syscall_shim.pdx's sys_write row.  Encoder-gap: no test/and-imm on high regs.",
      block: {
        mov rdx, rsi;                        // count = old rsi
        mov rsi, rdi;                        // buf   = old rdi
        mov rdi, 1;                          // fd    = stdout
        mov rax, 1;                          // SC+ ID 1
        syscall;
        ret
      }
    } @no_frame

  // ==========================================================================
  // ls_put_u64_dec(value) -- u64 -> decimal ASCII on fd=1.
  //
  // Verbatim shape of cp_print_u64_dec (src/user/cp.pdx §L153, itself
  // an adaptation of ps.pdx / init.pdx's print_u64_dec), but re-targeted
  // from sys_debug_puts (SC+ ID 12) to sys_write(fd=1) (SC+ ID 1) so
  // -l's size column lands on the same stdout stream as the entry name.
  //
  // SysV register discipline:
  //   Reads    : rdi (value)
  //   Preserves: rbx, rbp, r12-r15
  //   Clobbers : rax, rcx, rdx, rsi, rdi, r9, r10, r11
  //   Stack    : 24 bytes (20 digits max for u64::MAX + 4 slop for 16-B align)
  // ==========================================================================
  pub let ls_put_u64_dec : (u64) -> () !{mem, sysreg} @{fs} =
    fn (value: u64) -> unsafe {
      effects: {mem, sysreg},
      capabilities: {fs},
      justification: "v1.2 (#2452): u64 -> decimal ASCII for -l's size column, emitted via sys_write(fd=1) so the digits ride the same stdout stream as the entry name (contrast cp_print_u64_dec, which uses sys_debug_puts to bypass the tty for fingerprint markers).  Divide-by-10 loop shape verbatim from cp.pdx §L153 / ps.pdx §L196 / init.pdx §L200: (1) zero fast-path writes a single '0' digit and returns.  (2) Otherwise r9 holds the remaining value and r10 is a right-to-left cursor into a 24-byte stack scratch starting at offset 19; each iteration divides r9 by 10 (rax:rdx = r9/10 via `xor rdx,rdx; div rcx`), converts the remainder to ASCII, stores it at the cursor, decrements the cursor, and loops until the quotient reaches zero.  (3) The final cursor position plus (rsp+20 - cursor) gives the [buf, len] slice, emitted as sys_write(1, buf, len).  @no_frame: the body manages its own 24-byte frame via `sub rsp, 24` / `add rsp, 24` rather than an auto rbp prologue, matching cp_print_u64_dec verbatim.  Alignment: caller's rsp%16==0 pre-CALL; +8 return addr + 24 frame = 32 == %16 0 inside the syscall.  Encoder-gap: no `add reg, [mem]` / `sub reg, [mem]` -- cursor arithmetic is register-only.",
      block: {
        sub rsp, 24;

        cmp rdi, 0;
        jne lpud_divide_setup;
          mov al, 0x30;                      // ASCII '0'
          mov [rsp], al;
          mov rdi, 1;                        // fd = stdout
          mov rsi, rsp;
          mov rdx, 1;
          mov rax, 1;                        // SC+ ID 1
          syscall;
          add rsp, 24;
          ret;

        lpud_divide_setup:
          mov r9, rdi;                       // r9  = remaining value
          mov r10, rsp;
          add r10, 19;                       // r10 = cursor

        lpud_loop_top:
          mov rax, r9;
          mov rcx, 10;
          xor rdx, rdx;
          div rcx;                           // rax = quo, rdx = rem
          add rdx, 0x30;
          mov [r10], dl;
          mov r9, rax;
          cmp r9, 0;
          je  lpud_loop_done;
          sub r10, 1;
          jmp lpud_loop_top;

        lpud_loop_done:
          mov rax, rsp;
          add rax, 20;
          sub rax, r10;                      // rax = digit count
          mov rdx, rax;                      // count
          mov rsi, r10;                      // buf
          mov rdi, 1;                        // fd = stdout
          mov rax, 1;                        // SC+ ID 1
          syscall;
          add rsp, 24;
          ret
      }
    } @no_frame

  // ==========================================================================
  // ls_put_u64_oct6(value) -- 6-char octal ASCII on fd=1.
  //
  // Emits bits 17..0 of `value` as a 6-digit zero-padded octal string
  // ("000000".."777777").  Sufficient for POSIX mode words: the widest
  // real mode this landing sees is S_IFREG|0o644 (0x81A4 = 15 bits) or
  // S_IFDIR|0o755 (0x41ED = 14 bits), both fitting comfortably in 18
  // bits.  A future mode that overflows 18 bits silently truncates
  // (documented; a follow-on widens to 7 or 8 digits).
  //
  // SysV register discipline:
  //   Reads    : rdi (value)
  //   Preserves: rbx, rbp, r12-r15
  //   Clobbers : rax, rcx, rdx, rsi, rdi, r8, r9, r10, r11
  //   Stack    : none (uses _ls_oct_scratch in .bss)
  // ==========================================================================
  pub let ls_put_u64_oct6 : (u64) -> () !{mem, sysreg} @{fs} =
    fn (value: u64) -> unsafe {
      effects: {mem, sysreg},
      capabilities: {fs},
      justification: "v1.2 (#2452): 6-char zero-padded octal ASCII for -l's mode column.  Unrolled digit extract (6 x `mov rax, rdi; shr rax, k; and rax, 7; add rax, 0x30; mov_b [_ls_oct_scratch + i], rax`) followed by one sys_write(1, buf, 6).  Chosen over a divide-by-8 loop because the constant-width output is smaller in emitted bytes and sidesteps the div-instruction's flag-register clobber ordering.  BSS scratch rather than stack because the helper has no nested CALL and syscall is stack-alignment-neutral.  @no_frame: leaf, no CALL, single syscall.  Encoder-gap: shr rax,imm and and rax,imm8 are accumulator-form encodings the pitfalls list allows; the store form `mov_b [rcx + N], rax` follows kind_blkdev.pdx precedent.",
      block: {
        lea rcx, [rip + _ls_oct_scratch];

        // Digit 0 (bits 15..17)
        mov rax, rdi;
        shr rax, 15;
        and rax, 7;
        add rax, 0x30;
        mov_b [rcx], rax;

        // Digit 1 (bits 12..14)
        mov rax, rdi;
        shr rax, 12;
        and rax, 7;
        add rax, 0x30;
        mov_b [rcx + 1], rax;

        // Digit 2 (bits 9..11)
        mov rax, rdi;
        shr rax, 9;
        and rax, 7;
        add rax, 0x30;
        mov_b [rcx + 2], rax;

        // Digit 3 (bits 6..8)
        mov rax, rdi;
        shr rax, 6;
        and rax, 7;
        add rax, 0x30;
        mov_b [rcx + 3], rax;

        // Digit 4 (bits 3..5)
        mov rax, rdi;
        shr rax, 3;
        and rax, 7;
        add rax, 0x30;
        mov_b [rcx + 4], rax;

        // Digit 5 (bits 0..2)
        mov rax, rdi;
        and rax, 7;
        add rax, 0x30;
        mov_b [rcx + 5], rax;

        // sys_write(1, _ls_oct_scratch, 6)
        lea rsi, [rip + _ls_oct_scratch];
        mov rdi, 1;
        mov rdx, 6;
        mov rax, 1;
        syscall;
        ret
      }
    } @no_frame

  // ==========================================================================
  // ls_compose_and_stat(record_ptr, name_len) -- compose entry path
  // then sys_stat.
  //
  // Composes _ls_entry_path = _ls_dir_path + [sep] + name[0..name_len]
  // + NUL, then calls sys_stat(&_ls_entry_path, 255, &_ls_stat_buf).
  // The separator is elided when _ls_dir_path is exactly "/" (same
  // trick the Phase 0 resolve arm uses to avoid a double slash).
  //
  // On success (sys_stat returns 0), sets _ls_stat_ok = 1 and leaves
  // _ls_stat_buf populated.  On any failure (compose overflow OR
  // sys_stat error), sets _ls_stat_ok = 0 AND explicitly zeroes the
  // mode+size fields of _ls_stat_buf so a subsequent -l emit prints
  // "000000 0" placeholder rather than stale bytes from the prior
  // entry.
  //
  // SysV register discipline:
  //   Reads    : rdi (record_ptr), rsi (name_len)
  //   Preserves: rbx, rbp, r12-r15
  //   Clobbers : rax, rcx, rdx, rsi, rdi, r8, r9, r10, r11
  // ==========================================================================
  pub let ls_compose_and_stat : (u64, u64) -> () !{mem, sysreg} @{fs} =
    fn (record_ptr: u64) (name_len: u64) -> unsafe {
      effects: {mem, sysreg},
      capabilities: {fs},
      justification: "v1.2 (#2452): compose _ls_entry_path = _ls_dir_path + '/' + name + NUL, then sys_stat(&entry_path, 255, &_ls_stat_buf) (SC+ ID 77, kernel body at core/syscall/sys_stat.pdx, R56.M3-002 #1791).  Structured so callers pay for at most one composition per entry regardless of whether -l, -F, or both are set.  Sequence: (1) Stash record_ptr in r10 and name_len in r11 (survive the compose block; die by the time the syscall clobbers them, and we do not need them past that point).  (2) Zero mode (u32 at +24) and size (u64 at +8) fields of _ls_stat_buf so a subsequent stat failure leaves the placeholder pattern rather than stale bytes.  (3) Copy _ls_dir_path bytes into _ls_entry_path (rcx = cursor).  (4) Decide separator: skip if dir_len==1 AND dir[0]=='/' (root special case).  (5) Length guard: cursor + name_len must be < 511 (leaving NUL slot at 511 max); on overflow, set _ls_stat_ok=0 and ret without calling sys_stat.  (6) Copy name bytes.  (7) NUL-terminate.  (8) sys_stat -- rax = 0 or -errno.  (9) On success, _ls_stat_ok = 1; on failure, _ls_stat_ok = 0.  @no_frame: helper has no nested CALL, single syscall, no stack scratch.  Encoder-gap discipline: byte loads use xor rax,rax; mov_b rax,[ptr]; no `add reg,[mem]`; all pointer arithmetic register-only.  Reserved-label discipline: every label prefixed lcas_ (compose-and-stat).",
      block: {
        // Stash args.
        mov r10, rdi;                        // r10 = record_ptr
        mov r11, rsi;                        // r11 = name_len

        // Zero mode + size fields (defensive; overwritten on success).
        xor rax, rax;
        mov [rip + _ls_stat_buf + 8], rax;    // size u64
        mov [rip + _ls_stat_buf + 24], rax;   // mode u32 + nlink u32 (both zero)

        // Copy _ls_dir_path bytes into _ls_entry_path.
        lea rdi, [rip + _ls_entry_path];
        lea rsi, [rip + _ls_dir_path];
        mov r8, [rip + _ls_dir_path_len];    // r8 = dir_len
        xor rcx, rcx;                        // rcx = write cursor

      lcas_cpy_dir_top:
        cmp rcx, r8;
        jae lcas_cpy_dir_done;
        xor rax, rax;
        mov_b rax, [rsi + rcx*1];
        mov_b [rdi + rcx*1], rax;
        add rcx, 1;
        jmp lcas_cpy_dir_top;

      lcas_cpy_dir_done:
        // Decide separator: skip if dir_len == 1 AND dir[0] == '/'.
        cmp r8, 1;
        jne lcas_sep_needed;
        xor rax, rax;
        mov_b rax, [rsi];
        cmp rax, 0x2F;
        je  lcas_no_sep;

      lcas_sep_needed:
        mov rax, 0x2F;
        mov_b [rdi + rcx*1], rax;
        add rcx, 1;

      lcas_no_sep:
        // Length guard: cursor + name_len must be < 511 (leaving one
        // slot for the trailing NUL at index 511).
        mov rdx, rcx;
        add rdx, r11;
        cmp rdx, 511;
        ja  lcas_toolong;

        // Copy name bytes: source = record_ptr + 12 + i.
        xor r9, r9;

      lcas_cpy_name_top:
        cmp r9, r11;
        jae lcas_cpy_name_done;
        // rdx = &record_ptr[12 + r9]  (no scaled indexing beyond *1)
        mov rdx, r10;
        add rdx, 12;
        add rdx, r9;
        xor rax, rax;
        mov_b rax, [rdx];
        mov_b [rdi + rcx*1], rax;
        add rcx, 1;
        add r9, 1;
        jmp lcas_cpy_name_top;

      lcas_cpy_name_done:
        // NUL-terminate.
        xor rax, rax;
        mov_b [rdi + rcx*1], rax;

        // sys_stat(&_ls_entry_path, 255, &_ls_stat_buf).
        lea rdi, [rip + _ls_entry_path];
        mov rsi, 255;
        lea rdx, [rip + _ls_stat_buf];
        mov rax, 77;                         // SC+ ID 77
        syscall;

        // rax = 0 on success, negative errno on failure.
        cmp rax, 0;
        jl  lcas_stat_failed;
        mov rax, 1;
        mov [rip + _ls_stat_ok], rax;
        ret;

      lcas_stat_failed:
        xor rax, rax;
        mov [rip + _ls_stat_ok], rax;
        ret;

      lcas_toolong:
        xor rax, rax;
        mov [rip + _ls_stat_ok], rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // _start -- user program entry point.  Never returns.
  //
  // Effects/caps:
  //   mem     -- reads sys_open path + writes _ls_buf via sys_getdents +
  //              reads _ls_buf during walk + writes stdout via sys_write +
  //              reads/writes _ls_dir_path/_ls_entry_path/_ls_stat_buf.
  //   sysreg  -- every SYSCALL clobbers rcx (RIP)/r11 (rflags) plus
  //              rdi/rsi/rdx/r8/r9/r10 (entry.pdx #743 zero-out).
  //   fs      -- sys_open / sys_getdents / sys_close / sys_write / sys_stat.
  //   sched   -- sys_exit terminates the task (sched teardown).
  //
  // @no_frame because the function ends in sys_exit on every terminal
  // path -- no epilogue is needed and no auto-emitted rbp prologue is
  // wanted; the register plan documented in the module header tracks
  // rsp %16 explicitly (no push, no sub rsp, N; every same-module
  // helper CALL preserves rsp invariance).
  // ==========================================================================
  pub let _start : () -> () !{mem, sysreg} @{fs, sched} =
    fn () -> unsafe {
      effects: {mem, sysreg},
      capabilities: {fs, sched},
      justification: "R57.M4-001 (#1797) + R62.M1-004 (#1833) + v1.1 (paideia-os/ls#29) + v1.2 (paideia-os#2452): /bin/ls _start. #1797 landed the first ring-3 caller of sys_getdents (SC+ ID 78). #1833 wired the frozen execve argc/argv ABI. v1.1 (ls#29) moved cwd-relative path resolution into userspace. v1.2 (#2452) adds POSIX-lite flag suite -a/-l/-1/-F. Phase -1 (v1.2): scan argv[1..] for flag args, accumulate into _ls_flags. First non-flag arg becomes r13 (target_arg). Combined single-char forms (`-al`, `-1F`) are supported; `--` is the end-of-flags sentinel; bare `-` is treated as a path arg. Unknown flag chars are silently ignored (MVP posture; POSIX ls exits 2 on unknown flag, tightened in a follow-on). Phase 0 (v1.1): r13==0 -> ls_no_arg (default = cwd); r13[0]=='/' -> ls_use_absolute (verbatim); else -> ls_do_resolve (cwd + '/' + arg). Every arm sets rdi to a NUL-term absolute path and jumps/falls to ls_capture_dir_path, which strcpies rdi into _ls_dir_path, sets _ls_dir_path_len, and hands rdi back as &_ls_dir_path -- freeing the walk phase from having to know which arm produced its path. Phase 1: sys_open(rdi, O_RDONLY=0, mode=0) SC+ ID 2 -- rax = fd in [3,32) or negative errno; the `cmp rax, 32; jae ls_fail_open` gate catches both. Store fd in rbx (SysV callee-save; SYSCALL preserves rbx per amd64 fast-syscall rules; every same-module helper CALL preserves rbx). Phase 2: lea r14, [rip + _ls_buf] once (r14 stays live for the whole loop; v1.2 walk phase does NOT overwrite it). Phase 3 (ls_getdents_top): sys_getdents(fd, buf, 4096) via `call sys_getdents` (linker-resolved into src/user/libc/getdents.pdx). rax == 0 -> ls_close_done. rax > 4096 -> ls_fail_getdents. Otherwise r12 = bytes_returned; r13 = 0. Phase 4 (v1.2 rewrite, ls_walk_top): bounds-check offset+12 <= bytes; insufficient -> refill. Load name_len as u16 via mov_w r8,[r15+8]. name_len == 0 -> ls_close_done (terminator). Then: (4a) HIDDEN-ENTRY FILTER -- if FLAG_A clear AND name[0]=='.', jump to ls_advance_only (skip). (4b) If FLAG_L or FLAG_F set, `call ls_compose_and_stat` (rdi=record_ptr, rsi=name_len) -- fills _ls_stat_buf, sets _ls_stat_ok. After CALL, r13/r14 preserved; reload r15 = r14 + r13; reload r8 = mov_w [r15+8]. (4c) If FLAG_L set, emit '<oct-mode> <dec-size> ' prefix: load mode via `lea rax,[rip+_ls_stat_buf]; mov edi,[rax+24]` (32-bit load zero-extends per ps.pdx precedent), `call ls_put_u64_oct6`; space via `call ls_put_bytes`; size via `mov rdi,[rax+8]; call ls_put_u64_dec`; space. (4d) Emit name via `call ls_put_bytes(&record.name, name_len)`. (4e) If FLAG_F set, check type byte at [r15+10]: type==2 (VNODE_TYPE_DIR) -> emit '/'; else if _ls_stat_ok and (mode & 0o111)!=0 -> emit '*'; else nothing. Symlink '@' skipped -- kernel getdents does not surface symlink type at R56.M3, so faking it would misrepresent every regular file as symlink. (4f) Emit newline. (4g) Reload r15/r8 and fall through to ls_advance_only, which advances r13 by 12+name_len and loops. Phase 5 (ls_close_done): sys_close(fd); sys_exit(0). Fail paths emit a length-bounded LS-*-FAIL marker via sys_debug_puts (SC+ ID 12) then sys_exit with a distinguishing status (1=open, 2=getdents, 3=getcwd, 4=path too long). @no_frame + rsp%16 invariant per module header. Encoder-gap: no test/and-imm on high regs; every flag-bit test lands the mask in rdx first (`mov rdx, imm; and rax, rdx`); byte loads use xor+mov_b pattern; the one 32-bit load uses ps.pdx-precedent `mov edi, [rax+N]`. Reserved-label discipline: every label prefixed ls_ -- new v1.2 labels ls_parse_top, ls_parse_flag_chars, ls_flag_char_top, ls_flag_char_done, ls_set_a, ls_set_l, ls_set_1, ls_set_F, ls_flag_char_next, ls_take_arg, ls_take_arg_skip, ls_parse_done, ls_capture_dir_path, ls_cdp_top, ls_cdp_truncate, ls_cdp_done, ls_emit_entry, ls_no_stat, ls_emit_name, ls_check_exec, ls_after_suffix, ls_emit_nl, ls_advance_only all keep the prefix.",
      block: {
        // ============================================================
        // Phase -1 (v1.2, paideia-os#2452) -- flag parse
        // ============================================================
        // rdi=argc, rsi=argv, rdx=envp at entry (envp unused).
        //
        // rbx and r12 are used here as short-lived scratches for
        // argc/argv; both are reassigned before their walk-phase roles
        // (rbx -> fd in Phase 1; r12 -> bytes_returned in Phase 3).
        mov rbx, rdi;                         // rbx = argc
        mov r12, rsi;                         // r12 = argv base

        // Init _ls_flags = 0 and target_arg (r13) = 0.  r14 is
        // repurposed here as the sticky "paths-only" flag: once we
        // see `--`, every subsequent arg is a path candidate even if
        // it starts with '-'.  r14 gets reassigned to &_ls_buf in
        // Phase 2, well after the parse pass ends.
        xor rax, rax;
        mov [rip + _ls_flags], rax;
        xor r13, r13;
        xor r14, r14;                         // r14 = post_dashdash flag

        // Start argv index at 1 (skip argv[0]).
        mov rcx, 1;

      ls_parse_top:
        cmp rcx, rbx;
        jae ls_parse_done;
        mov r15, [r12 + rcx*8];               // r15 = argv[rcx]

        // Post-`--` mode: unconditionally treat as path.
        cmp r14, 0;
        jne ls_take_arg;

        // Peek first byte to classify: '-...' vs path.
        xor rax, rax;
        mov_b rax, [r15];
        cmp rax, 0x2D;                        // '-'
        jne ls_take_arg;

        // Second byte tells us bare-'-' (path) vs "--"/flags.
        xor rax, rax;
        mov_b rax, [r15 + 1];
        cmp rax, 0;                           // bare '-'
        je  ls_take_arg;
        cmp rax, 0x2D;                        // could be "--"
        jne ls_parse_flag_chars;

        // Might be "--" alone (end-of-flags sentinel).  A "--foo" is
        // treated as a run of flag chars (MVP: unknown chars silently
        // ignored, so effectively a no-op).
        xor rax, rax;
        mov_b rax, [r15 + 2];
        cmp rax, 0;
        jne ls_parse_flag_chars;

        // True "--": set post_dashdash sticky flag so subsequent args
        // are unconditionally path candidates, then skip this arg.
        mov r14, 1;
        add rcx, 1;
        jmp ls_parse_top;

      ls_parse_flag_chars:
        // Iterate bytes from offset 1 until NUL.
        mov r9, 1;

      ls_flag_char_top:
        xor rax, rax;
        mov_b rax, [r15 + r9*1];
        cmp rax, 0;
        je  ls_flag_char_done;
        cmp rax, 0x61;                        // 'a'
        je  ls_set_a;
        cmp rax, 0x6C;                        // 'l'
        je  ls_set_l;
        cmp rax, 0x31;                        // '1'
        je  ls_set_1;
        cmp rax, 0x46;                        // 'F'
        je  ls_set_F;
        // Unknown flag: silently ignore for MVP.
        jmp ls_flag_char_next;

      ls_set_a:
        mov rax, [rip + _ls_flags];
        mov rdx, 1;                           // LS_FLAG_A
        or  rax, rdx;
        mov [rip + _ls_flags], rax;
        jmp ls_flag_char_next;

      ls_set_l:
        mov rax, [rip + _ls_flags];
        mov rdx, 2;                           // LS_FLAG_L
        or  rax, rdx;
        mov [rip + _ls_flags], rax;
        jmp ls_flag_char_next;

      ls_set_1:
        mov rax, [rip + _ls_flags];
        mov rdx, 4;                           // LS_FLAG_1
        or  rax, rdx;
        mov [rip + _ls_flags], rax;
        jmp ls_flag_char_next;

      ls_set_F:
        mov rax, [rip + _ls_flags];
        mov rdx, 8;                           // LS_FLAG_F
        or  rax, rdx;
        mov [rip + _ls_flags], rax;
        jmp ls_flag_char_next;

      ls_flag_char_next:
        add r9, 1;
        jmp ls_flag_char_top;

      ls_flag_char_done:
        add rcx, 1;
        jmp ls_parse_top;

      ls_take_arg:
        // First non-flag arg becomes target_arg (r13).  Extra path args
        // are silently ignored at this landing (multi-dir listing is a
        // future evolution).
        cmp r13, 0;
        jne ls_take_arg_skip;
        mov r13, r15;
      ls_take_arg_skip:
        add rcx, 1;
        jmp ls_parse_top;

      ls_parse_done:
        // r13 = target_arg or 0.  rbx (argc) and r12 (argv) are dead
        // by end of Phase -1 (Phase 0's arms use r15 for the target
        // arg pointer, and r12/rbx are reassigned in Phase 2/1).

        // ============================================================
        // Phase 0 (v1.1) -- classify target_arg and, on the relative
        // arm, resolve it against sys_getcwd BEFORE any sys_open sees
        // it.
        // ============================================================
        cmp r13, 0;
        je  ls_no_arg;

        mov r15, r13;
        xor rax, rax;
        mov_b rax, [r15];
        cmp rax, 0x2F;                        // '/'
        je  ls_use_absolute;

        // Any other first byte -> relative arm.
        jmp ls_do_resolve;

      ls_no_arg:
        // argc<2 (no path arg) -> list cwd.  Fill _ls_cwd_scratch with
        // cwd string.
        lea rdi, [rip + _ls_cwd_scratch];
        mov rsi, 256;
        mov rax, 86;                          // SC+ ID 86 = sys_getcwd
        syscall;
        cmp rax, 0;
        jl  ls_fail_getcwd;
        lea rdi, [rip + _ls_cwd_scratch];
        jmp ls_capture_dir_path;

      ls_use_absolute:
        // Absolute path -> pass through verbatim.
        mov rdi, r15;
        jmp ls_capture_dir_path;

      ls_do_resolve:
        // Relative path -> resolve against cwd.
        lea rdi, [rip + _ls_cwd_scratch];
        mov rsi, 256;
        mov rax, 86;                          // SC+ ID 86 = sys_getcwd
        syscall;
        cmp rax, 0;
        jl  ls_fail_getcwd;

        // r8 = cwd_len (excluding trailing NUL).
        mov r8, rax;
        sub r8, 1;

        // Inline bounded strlen(r15), cap at 255.  r9 = user_len.
        xor r9, r9;
      ls_ulen_top:
        cmp r9, 255;
        jae ls_fail_path_too_long;
        xor rax, rax;
        mov_b rax, [r15 + r9*1];
        cmp rax, 0;
        je  ls_ulen_done;
        add r9, 1;
        jmp ls_ulen_top;

      ls_ulen_done:
        // Separator: sep = 1 default, sep = 0 iff cwd is exactly "/".
        mov r10, 1;
        cmp r8, 1;
        jne ls_sep_done;
        lea rax, [rip + _ls_cwd_scratch];
        xor rdx, rdx;
        mov_b rdx, [rax];
        cmp rdx, 0x2F;
        jne ls_sep_done;
        xor r10, r10;

      ls_sep_done:
        // total_len = cwd_len + sep + user_len.  Must leave a NUL slot
        // at index total_len, so total_len <= 255.
        mov rdx, r8;
        add rdx, r10;
        add rdx, r9;
        cmp rdx, 255;
        ja  ls_fail_path_too_long;

        // ---- Copy cwd bytes into resolved scratch ----
        lea rdi, [rip + _ls_resolved_scratch];
        lea rsi, [rip + _ls_cwd_scratch];
        xor r11, r11;                         // r11 = write cursor
      ls_cpy_cwd_top:
        cmp r11, r8;
        jae ls_cpy_cwd_done;
        xor rax, rax;
        mov_b rax, [rsi + r11*1];
        mov_b [rdi + r11*1], rax;
        add r11, 1;
        jmp ls_cpy_cwd_top;

      ls_cpy_cwd_done:
        // ---- Emit separator if needed ----
        cmp r10, 0;
        je  ls_cpy_user_start;
        mov rax, 0x2F;
        mov_b [rdi + r11*1], rax;
        add r11, 1;

      ls_cpy_user_start:
        // ---- Copy user bytes ----
        xor rcx, rcx;
      ls_cpy_user_top:
        cmp rcx, r9;
        jae ls_cpy_user_done;
        xor rdx, rdx;
        mov_b rdx, [r15 + rcx*1];
        mov_b [rdi + r11*1], rdx;
        add r11, 1;
        add rcx, 1;
        jmp ls_cpy_user_top;

      ls_cpy_user_done:
        // NUL-terminate at [rdi + r11].
        xor rax, rax;
        mov_b [rdi + r11*1], rax;
        lea rdi, [rip + _ls_resolved_scratch];
        // Fall through to ls_capture_dir_path.

      ls_capture_dir_path:
        // ============================================================
        // v1.2 (#2452): copy NUL-terminated path at rdi into
        // _ls_dir_path; set _ls_dir_path_len.  Freeing the walk phase
        // from having to know which Phase 0 arm produced its path.
        // ============================================================
        lea r11, [rip + _ls_dir_path];
        xor rcx, rcx;                         // rcx = length counter

      ls_cdp_top:
        cmp rcx, 255;
        jae ls_cdp_truncate;
        xor rax, rax;
        mov_b rax, [rdi + rcx*1];
        mov_b [r11 + rcx*1], rax;
        cmp rax, 0;
        je  ls_cdp_done;
        add rcx, 1;
        jmp ls_cdp_top;

      ls_cdp_truncate:
        // Force NUL at index 255.  Should not fire in practice (all
        // three Phase 0 arms produce <=255-byte paths), but keeps the
        // invariant airtight so ls_compose_and_stat cannot walk off
        // the end of _ls_dir_path.
        xor rax, rax;
        mov_b [r11 + rcx*1], rax;

      ls_cdp_done:
        mov [rip + _ls_dir_path_len], rcx;
        lea rdi, [rip + _ls_dir_path];
        // Fall through to ls_open_path_ready.

      ls_open_path_ready:
        // ============================================================
        // Phase 1 -- sys_open(path, O_RDONLY = 0, mode = 0) -> fd
        // ============================================================
        xor rsi, rsi;
        xor rdx, rdx;
        mov rax, 2;                           // SC+ ID 2 = sys_open
        syscall;

        cmp rax, 32;
        jae ls_fail_open;
        mov rbx, rax;                         // rbx = fd (callee-save)

        // r14 = &_ls_buf, constant for the rest of _start.
        lea r14, [rip + _ls_buf];

      ls_getdents_top:
        // ============================================================
        // Phase 2 -- sys_getdents(fd, buf, 4096)
        // ============================================================
        mov rdi, rbx;
        mov rsi, r14;
        mov rdx, 4096;
        call sys_getdents;

        cmp rax, 0;
        je  ls_close_done;

        cmp rax, 4096;
        ja  ls_fail_getdents;

        mov r12, rax;                         // r12 = bytes_returned
        xor r13, r13;                         // r13 = offset

      ls_walk_top:
        // ============================================================
        // Phase 3 -- bounds-check + walk one record
        // ============================================================
        mov rcx, r13;
        add rcx, 12;
        cmp rcx, r12;
        ja  ls_getdents_top;

        mov r15, r14;
        add r15, r13;

        xor r8, r8;
        mov_w r8, [r15 + 8];
        cmp r8, 0;
        je  ls_close_done;                    // terminator -> done

        // ============================================================
        // Phase 4a (v1.2, #2452) -- hidden-entry filter
        // ============================================================
        mov rax, [rip + _ls_flags];
        mov rdx, 1;                           // LS_FLAG_A
        and rax, rdx;
        cmp rax, 0;
        jne ls_emit_entry;                    // -a set -> keep entry
        xor rax, rax;
        mov_b rax, [r15 + 12];                // first name byte
        cmp rax, 0x2E;                        // '.'
        je  ls_advance_only;                  // hide entry

      ls_emit_entry:
        // ============================================================
        // Phase 4b (v1.2, #2452) -- compose + stat if -l or -F
        // ============================================================
        mov rax, [rip + _ls_flags];
        mov rdx, 10;                          // LS_FLAG_L | LS_FLAG_F
        and rax, rdx;
        cmp rax, 0;
        je  ls_no_stat;

        mov rdi, r15;                         // record_ptr
        mov rsi, r8;                          // name_len
        call ls_compose_and_stat;

        // After CALL, r13/r14 preserved.  Reload r15 = r14 + r13 and
        // r8 = record.name_len from memory (caller-save clobbered).
        mov r15, r14;
        add r15, r13;
        xor r8, r8;
        mov_w r8, [r15 + 8];

      ls_no_stat:
        // ============================================================
        // Phase 4c (v1.2, #2452) -- if -l, emit "<oct-mode> <dec-size> "
        // ============================================================
        mov rax, [rip + _ls_flags];
        mov rdx, 2;                           // LS_FLAG_L
        and rax, rdx;
        cmp rax, 0;
        je  ls_emit_name;

        // Mode (u32 at _ls_stat_buf + 24).
        lea rax, [rip + _ls_stat_buf];
        mov edi, [rax + 24];                  // rdi = mode (zero-ext)
        call ls_put_u64_oct6;

        // Space.
        lea rdi, [rip + ls_space];
        mov rsi, 1;
        call ls_put_bytes;

        // Size (u64 at _ls_stat_buf + 8).
        lea rax, [rip + _ls_stat_buf];
        mov rdi, [rax + 8];                   // rdi = size
        call ls_put_u64_dec;

        // Space.
        lea rdi, [rip + ls_space];
        mov rsi, 1;
        call ls_put_bytes;

        // Reload r15 / r8 -- CALLs clobber caller-save regs.
        mov r15, r14;
        add r15, r13;
        xor r8, r8;
        mov_w r8, [r15 + 8];

      ls_emit_name:
        // ============================================================
        // Phase 4d (v1.2, #2452) -- emit name.
        // ============================================================
        mov rdi, r15;
        add rdi, 12;                          // buf = &record.name
        mov rsi, r8;                          // count = name_len
        call ls_put_bytes;
        // Reload r15 / r8.
        mov r15, r14;
        add r15, r13;
        xor r8, r8;
        mov_w r8, [r15 + 8];

        // ============================================================
        // Phase 4e (v1.2, #2452) -- if -F, emit type suffix.
        // ============================================================
        mov rax, [rip + _ls_flags];
        mov rdx, 8;                           // LS_FLAG_F
        and rax, rdx;
        cmp rax, 0;
        je  ls_emit_nl;

        // Type byte at [r15 + 10] (u8).
        xor rax, rax;
        mov_b rax, [r15 + 10];
        cmp rax, 2;                           // VNODE_TYPE_DIR
        jne ls_check_exec;
        lea rdi, [rip + ls_slash_s];
        mov rsi, 1;
        call ls_put_bytes;
        jmp ls_after_suffix;

      ls_check_exec:
        // Only meaningful when stat succeeded (mode field is
        // authoritative).  On stat failure _ls_stat_buf's mode was
        // re-zeroed by ls_compose_and_stat, so the & 0o111 test would
        // reliably return 0 anyway, but the explicit gate documents
        // intent.
        mov rax, [rip + _ls_stat_ok];
        cmp rax, 0;
        je  ls_after_suffix;
        lea rax, [rip + _ls_stat_buf];
        mov edi, [rax + 24];                  // rdi = mode
        mov rdx, 0x49;                        // 0o111 exec bits
        and rdi, rdx;
        cmp rdi, 0;
        je  ls_after_suffix;
        lea rdi, [rip + ls_star_s];
        mov rsi, 1;
        call ls_put_bytes;

      ls_after_suffix:
        // Fall through to newline.

      ls_emit_nl:
        // ============================================================
        // Phase 4f (v1.2, #2452) -- newline.
        // ============================================================
        lea rdi, [rip + ls_newline];
        mov rsi, 1;
        call ls_put_bytes;
        // Reload r15 / r8 for advance.
        mov r15, r14;
        add r15, r13;
        xor r8, r8;
        mov_w r8, [r15 + 8];

      ls_advance_only:
        // ============================================================
        // Phase 4g -- advance offset by 12 + name_len.
        //
        // Reached either via the hidden-entry filter (r8/r13 still
        // valid from the walk-top load) or via the emit path (r8/r13
        // reloaded just above).  Either way both are valid here.
        // ============================================================
        add r13, 12;
        add r13, r8;
        jmp ls_walk_top;

      ls_close_done:
        // ============================================================
        // Phase 5 -- sys_close(fd); sys_exit(0)
        // ============================================================
        mov rdi, rbx;
        mov rax, 3;                           // SC+ ID 3 = sys_close
        syscall;

        xor rdi, rdi;
        mov rax, 60;                          // SC+ ID 60 = sys_exit
        syscall;
        hlt;

      ls_fail_open:
        // sys_debug_puts("LS OPEN FAIL\n", 13)
        lea rdi, [rip + ls_err_open_msg];
        mov rsi, 13;
        mov rax, 12;                          // SC+ ID 12 = sys_debug_puts
        syscall;
        mov rdi, 1;
        mov rax, 60;
        syscall;
        hlt;

      ls_fail_getdents:
        // sys_debug_puts("LS GETDENTS FAIL\n", 17)
        lea rdi, [rip + ls_err_getd_msg];
        mov rsi, 17;
        mov rax, 12;
        syscall;
        // sys_close(fd) -- clean up before exit.
        mov rdi, rbx;
        mov rax, 3;
        syscall;
        mov rdi, 2;
        mov rax, 60;
        syscall;
        hlt;

      ls_fail_getcwd:
        // sys_debug_puts("LS GETCWD FAIL\n", 15)
        lea rdi, [rip + ls_err_gcwd_msg];
        mov rsi, 15;
        mov rax, 12;
        syscall;
        mov rdi, 3;
        mov rax, 60;
        syscall;
        hlt;

      ls_fail_path_too_long:
        // sys_debug_puts("LS PATH TOO LONG\n", 17)
        lea rdi, [rip + ls_err_tlong_msg];
        mov rsi, 17;
        mov rax, 12;
        syscall;
        mov rdi, 4;
        mov rax, 60;
        syscall;
        hlt
      }
    } @no_frame
}
