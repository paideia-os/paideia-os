// src/user/ls.pdx -- R57.M4-001 (#1797); v1.1 paideia-os/ls#29
//
// /bin/ls -- first ring-3 user of sys_getdents (SC+ ID 78).
//
// v1.1 (2026-09-12, paideia-os/ls#29): userspace cwd-relative path
// resolution.  Mirrors the mkdir v1.1-B / cp v1.1.0-B pattern.  Before
// v1.1, ls handed argv[1] verbatim to sys_open and relied on the
// kernel's path_resolve(..., cwd=TASK_OFF_CWD) (R86.M1-005 #1958) to
// anchor relatives against the caller's cwd.  That was correct once
// the kernel was updated, but it left the tool blind to what it was
// actually listing: the string handed to sys_open was the same
// "./sub" the user typed, while the vnode it landed on was
// getcwd()+"/sub".  It also left argc<2 defaulting to "/" rather than
// the cwd, an M0 stopgap that pre-dated R86.  v1.1 moves the join
// into userspace: absolute paths still pass through, but relative
// paths (including "." and multi-component "a/b") are resolved
// against sys_getcwd (SC+ ID 86, R86.M1-003 #1956) before sys_open
// sees the string.  argc<2 now defaults to cwd (POSIX ls(1) shape)
// instead of the historical root default.
//
// Minimum-viable ls, argv-aware since R62.M1-004 (#1833):
//   * Target directory is argv[1] when the shell supplied one (argc >= 2,
//     per the frozen execve argc/argv/envp ABI in
//     design/user/execve-abi.md -- rdi=argc, rsi=argv at _start); falls
//     back to the caller's cwd (v1.1) when argc < 2.
//   * No flags (-l, -a, -R, ...); one line per entry, name only.
//   * Bounded 4 KiB scratch buffer, self-contained inline syscalls for
//     open/write/close/exit/getcwd (matches child_hello / true /
//     echo_server "one .pdx, one .elf" discipline), and one
//     linker-resolved call into the libc/getdents.pdx wrapper for
//     sys_getdents.  Pulling the wrapper in via the ld link -- rather
//     than inlining a fourth `mov rax, 78; syscall` -- exercises the
//     libc/ splitting the round introduced and is what makes ls.elf
//     the first proof that a ring-3 binary can link against
//     src/user/libc/*.o.  sys_getcwd (SC+ ID 86) is inlined at the
//     resolve site -- keeps the classify-and-resolve prologue self-
//     contained the same way mkdir v1.1-B does it, and avoids growing
//     a second libc wrapper for one call site.
//
// -----------------------------------------------------------------------------
// Record layout consumed here (kernel side owns the shape; frozen at R56.M3)
// -----------------------------------------------------------------------------
//
//   +0   ino:      u64
//   +8   name_len: u16  (0 marks the terminator record; else 1..255)
//   +10  type:     u8
//   +11  reserved: u8
//   +12  name[name_len]  (no NUL terminator)
//
// -----------------------------------------------------------------------------
// Control flow
// -----------------------------------------------------------------------------
//
//   Phase 0 (v1.1, paideia-os/ls#29) -- classify-and-resolve prologue:
//     argc < 2                          -> ls_no_arg   (default = cwd)
//     argv[1][0] == '/'                 -> ls_use_absolute (verbatim)
//     otherwise                         -> ls_do_resolve  (cwd + '/' + arg)
//     -- every arm sets rdi to a NUL-terminated absolute path in one of
//        _ls_cwd_scratch (cwd) or _ls_resolved_scratch (join) or argv[1]
//        (absolute passthrough), then falls through to ls_open_path_ready.
//     -- sys_getcwd failure -> ls_fail_getcwd  (exit 3)
//     -- resolved path > 255 -> ls_fail_path_too_long (exit 4)
//   ls_open_path_ready: sys_open(rdi, O_RDONLY=0, 0) -> fd,
//                                             error -> LS OPEN FAIL (exit 1)
//   ls_getdents_top:    call sys_getdents(fd, buf, 4096)
//                         rax == 0                        -> ls_close_done
//                         rax > 4096 (negative errno)     -> ls_fail_getdents
//                         else                            -> walk records
//   ls_walk_top:        bounds check header (offset+12 <= bytes)
//                         no room                         -> ls_getdents_top (refill)
//                         name_len == 0                   -> ls_close_done (drained)
//                         else write name + newline, advance, loop
//   ls_close_done:      sys_close(fd); sys_exit(0)
//   ls_fail_open:       sys_debug_puts("LS OPEN FAIL\n"); sys_exit(1)
//   ls_fail_getdents:   sys_debug_puts("LS GETDENTS FAIL\n"); sys_close(fd); sys_exit(2)
//   ls_fail_getcwd:     sys_debug_puts("LS GETCWD FAIL\n"); sys_exit(3)
//   ls_fail_path_too_long:
//                       sys_debug_puts("LS PATH TOO LONG\n"); sys_exit(4)
//
// -----------------------------------------------------------------------------
// SC+ IDs (per src/user/syscall_shim.pdx §2.1 + R56.M3 addition + R86.M1)
// -----------------------------------------------------------------------------
//   1  = sys_write(fd, buf, count)     -- inlined
//   2  = sys_open(path, flags, mode)   -- inlined
//   3  = sys_close(fd)                 -- inlined
//   12 = sys_debug_puts(buf, count)    -- inlined (fail-path serial marker)
//   60 = sys_exit(status)              -- inlined; never returns
//   78 = sys_getdents(fd, buf, cnt)    -- CALLED via src/user/libc/getdents.pdx
//   86 = sys_getcwd(buf_va, buf_len)   -- inlined (v1.1 resolve prologue);
//                                         kernel body sys_getcwd.pdx
//                                         (R86.M1-003 #1956) returns bytes
//                                         written INCLUDING trailing NUL
//                                         (POSIX getcwd(3) convention:
//                                         N-1 is the string's strlen) or
//                                         negative-errno on -EFAULT /
//                                         -ERANGE / -ENOENT.
//
// -----------------------------------------------------------------------------
// Register discipline
// -----------------------------------------------------------------------------
//
// No prologue pushes. Standalone ELF entry: iretq lands at _start with
// user_rsp equal to user_stack_alloc's returned top -- a page-aligned VA,
// so rsp % 16 == 0 at entry (16-byte-aligned per SysV pre-CALL contract).
// No push is emitted, no `sub rsp, N` is emitted, and no epilogue is
// needed because every terminal path ends in sys_exit (SC+ ID 60) which
// never returns. Callee-save regs (rbx, r12-r15) are used directly:
// SYSCALL preserves them per amd64 fast-syscall rules, and the one
// `call sys_getdents` is into a callee that follows SysV callee-save.
//
// Phase 0 (v1.1 resolve prologue) has its own overlay register plan
// that is fully consumed before ls_open_path_ready runs:
//   r15 = raw argv[1] pointer (preserved across sys_getcwd; SysV
//         callee-save + amd64 fast-syscall preserves r15). Dies at
//         ls_open_path_ready -- the ls-loop body reuses r15 as the
//         per-record pointer, but only AFTER the resolve prologue's
//         final `jmp ls_open_path_ready`.
//   r8   = cwd_len (excluding trailing NUL); dies at end of Phase 0.
//   r9   = user_len (argv[1] bounded strlen); dies at end of Phase 0.
//   r10  = sep (0 when cwd is exactly "/"; 1 otherwise); dies at end
//         of Phase 0.
//   r11  = write cursor into _ls_resolved_scratch; dies at end of
//         Phase 0. r11 is safe as loop scratch here because it is
//         only touched between syscalls; the sys_getcwd `syscall` is
//         complete before r11 is ever used, and every subsequent
//         loop step (byte copy, NUL-terminate) runs without a nested
//         syscall or CALL.
//
// Post-Phase-0 (ls_open_path_ready onward) uses the frozen v1.0 plan:
//   rbx = fd (set once by sys_open, live across every syscall + call)
//   r12 = bytes_returned by the current sys_getdents call
//   r13 = offset walker into _ls_buf
//   r14 = _ls_buf base VA (lea'd once, constant for the rest of _start)
//   r15 = per-iteration record pointer (= r14 + r13)
//
// -----------------------------------------------------------------------------
// Encoder-gap discipline
// -----------------------------------------------------------------------------
//
// paideia-as (phase-3-m2-002) does NOT support `add reg, [mem]` or
// `sub reg, [mem]`; the R56.M3-003 kernel body of sys_getdents itself
// works around this (see src/kernel/core/syscall/sys_getdents.pdx §Encoder
// gap). This file has no memory-mem operand pairs -- every advance is
// register-arithmetic on the offset (r13) and register-arithmetic on
// pointers (r15 = r14 + r13).
//
// -----------------------------------------------------------------------------
// Reserved-label discipline
// -----------------------------------------------------------------------------
//
// Every label prefixed `ls_` per the reserved-word convention -- bare
// `top`, `done`, `loop`, `walk` would collide with paideia-as keywords.

module Ls = structure {

  // -------------------------------------------------------------------------
  // v1.1 (paideia-os/ls#29): the argc<2 default is now the caller's cwd
  // (read via sys_getcwd into _ls_cwd_scratch at _start's Phase 0),
  // matching POSIX ls(1).  The R62.M1-004 (#1833) hardcoded "/" fallback
  // has been retired -- keeping it as dead rodata would misdirect readers
  // to a codepath that no longer exists.
  //
  // Newline written after every entry name. sys_write is length-bounded to
  // 1 byte; the trailing NUL is rodata padding, never sent on the wire.
  // -------------------------------------------------------------------------
  pub let ls_newline : [u8; 2] = "\n\0"

  // Fail markers -- routed through sys_debug_puts (SC+ ID 12) rather than
  // sys_write(1,..) so a broken stdout does not swallow the diagnostic.
  // Storage carries the trailing NUL for strlen-safety; the wire length
  // (ls_err_*_len) excludes it.
  pub let ls_err_open_msg : [u8; 15] = "LS OPEN FAIL\n\0"
  pub let ls_err_open_len : u64 = 13
  pub let ls_err_getd_msg : [u8; 19] = "LS GETDENTS FAIL\n\0"
  pub let ls_err_getd_len : u64 = 17

  // v1.1 (paideia-os/ls#29): sys_getcwd + resolve fail markers.
  // Wire lengths exclude the trailing NUL; storage carries it for
  // strlen-safety.
  pub let ls_err_gcwd_msg : [u8; 16] = "LS GETCWD FAIL\n\0"
  pub let ls_err_gcwd_len : u64 = 15
  pub let ls_err_tlong_msg : [u8; 18] = "LS PATH TOO LONG\n\0"
  pub let ls_err_tlong_len : u64 = 17

  // -------------------------------------------------------------------------
  // 4 KiB record scratch. Matches the kernel side's GETDENTS_IO_MAX cap
  // exactly, so a single sys_getdents call returns at most one buffer's
  // worth and never truncates a record header. @align(8) matches the
  // buffer's own ino:u64 alignment.
  //
  // .bss (uninit) rather than .data (zero-init constant) so ls.elf's
  // p_filesz stays small; the loader zero-fills bss pages, so the buffer
  // starts zero-valued on first entry to _start (the record layout does
  // not require a specific initial state -- sys_getdents writes over it).
  // -------------------------------------------------------------------------
  pub let mut _ls_buf : [u8; 4096] = uninit @align(8)

  // -------------------------------------------------------------------------
  // v1.1 (paideia-os/ls#29): userspace cwd-relative resolve scratches.
  //
  // Both sized at 256 bytes to match the kernel's own SYS_GETCWD_PATH_MAX
  // and SYS_MKDIR_PATH_MAX limits verbatim -- the same discipline mkdir
  // v1.1-B and cp v1.1.0-B follow so no join we compose here can be
  // longer than a path the kernel is willing to walk downstream.
  //
  //   _ls_cwd_scratch       -- destination for sys_getcwd. Also serves
  //                            as the sys_open target directly on the
  //                            argc<2 arm (list-cwd default) since
  //                            sys_getcwd NUL-terminates its write.
  //   _ls_resolved_scratch  -- staging for the joined absolute path
  //                            (cwd + '/' + argv[1]) handed to sys_open
  //                            on the relative-path arm. Any join whose
  //                            total length exceeds 255 (leaving room
  //                            for the trailing NUL at index 255)
  //                            exits 4 (LS_PATH_TOO_LONG).
  //
  // Both scratches are single-flow: only _start writes them, and
  // _start's Phase 0 fully overwrites the bytes it consumes before
  // the sys_open call site. .bss (uninit) so ls.elf's p_filesz stays
  // small; the loader zero-fills bss pages, so the buffers start
  // zero-valued on first entry to _start.
  // -------------------------------------------------------------------------
  pub let mut _ls_cwd_scratch      : [u8; 256] = uninit @align(8)
  pub let mut _ls_resolved_scratch : [u8; 256] = uninit @align(8)

  // -------------------------------------------------------------------------
  // _start -- user program entry point. Never returns.
  //
  // Effects/caps:
  //   mem     -- reads sys_open path + writes _ls_buf via sys_getdents +
  //              reads _ls_buf during walk + writes stdout via sys_write.
  //   sysreg  -- every SYSCALL clobbers rcx (RIP)/r11 (rflags).
  //   fs      -- sys_open / sys_getdents / sys_close / sys_write.
  //   sched   -- sys_exit terminates the task (sched teardown).
  //
  // @no_frame because the function ends in sys_exit on every terminal
  // path (never returns) -- no epilogue is needed and no auto-emitted
  // rbp prologue is wanted; the register plan documented above tracks
  // rsp %16 explicitly.
  // -------------------------------------------------------------------------
  pub let _start : () -> () !{mem, sysreg} @{fs, sched} =
    fn () -> unsafe {
      effects: {mem, sysreg},
      capabilities: {fs, sched},
      justification: "R57.M4-001 (#1797) + R62.M1-004 (#1833) + v1.1 (paideia-os/ls#29): /bin/ls _start. First ring-3 caller of sys_getdents (SC+ ID 78, R56.M3-003 kernel body at src/kernel/core/syscall/sys_getdents.pdx). #1833: argc/argv now arrive in rdi/rsi at _start per the frozen execve ABI (design/user/execve-abi.md). v1.1 (paideia-os/ls#29): Phase 0 is a full classify-and-resolve prologue mirroring mkdir v1.1-B (paideia-os/mkdir#25) and cp v1.1.0-B (paideia-os/cp#21), moving the cwd-anchor into userspace so the string handed to sys_open IS the absolute path the vnode walker will resolve against and so argc<2 defaults to the caller's cwd (POSIX ls(1) shape) instead of the historical `/` M0 default. Sequence: (0.a) argc<2 -> ls_no_arg: sys_getcwd(&_ls_cwd_scratch,256) SC+ ID 86 -- inlined `mov rax, 86; syscall`; rax<0 -> ls_fail_getcwd (exit 3, emits LS GETCWD FAIL\\n); otherwise rdi=&_ls_cwd_scratch (NUL-terminated by sys_getcwd's own POSIX-shaped write, R86.M1-003 #1956) and fall through to ls_open_path_ready. (0.b) argc>=2 with argv[1][0]=='/' -> ls_use_absolute: rdi = argv[1] verbatim (own aspace per execve ABI; any prefixing on our side would be actively wrong since path_resolve anchors absolute paths against the mount root regardless of cwd). (0.c) argc>=2 with any other first byte (including '.' followed by NUL, '/', or another '.', producing '.', './foo', '..', '.foo') -> ls_do_resolve: sys_getcwd(&_ls_cwd_scratch,256) -- rax = bytes incl NUL, cwd_len = rax-1. Inline bounded strlen on argv[1] (capped at 255; overflow -> ls_fail_path_too_long, exit 4, emits LS PATH TOO LONG\\n). Separator: sep=1 by default, or sep=0 when cwd is exactly '/' (cwd_len==1 AND _ls_cwd_scratch[0]=='/') to avoid the double slash on `ls foo` under root. total_len = cwd_len + sep + user_len; > 255 -> ls_fail_path_too_long. Copy cwd bytes into _ls_resolved_scratch, then '/' if sep==1, then user bytes, then NUL-terminate. rdi = &_ls_resolved_scratch; fall through to ls_open_path_ready. The kernel's path_resolve normalises '.' components and '..' walks back up via vnode parent_idx (R86.M1-002/003) inside every resolved absolute we compose here. (1) ls_open_path_ready: sys_open(rdi, O_RDONLY=0, 0) SC+ ID 2 -- inlined `mov rax, 2; syscall`; rax = fd in [3,32) on success or negative-errno; the `cmp rax, 32; jae ls_fail_open` gate catches both (fd out of range and any bit-63-set negative). Store fd in rbx across every subsequent syscall/call (SysV callee-save; SYSCALL preserves rbx per amd64 fast-syscall rules; `call sys_getdents` preserves rbx as SysV callee). (2) lea r14, [rip + _ls_buf] once -- r14 stays live for the whole loop; the v1.1 resolve prologue does NOT touch r14 (only r8/r9/r10/r11/r15 as documented in the register-discipline block comment above), so the ls_walk_top plan is unchanged. (3) ls_getdents_top: sys_getdents(fd, buf, 4096) via `call sys_getdents` (linker-resolved into src/user/libc/getdents.pdx's arity-3 wrapper). rax == 0 -> ls_close_done. rax > 4096 -> ls_fail_getdents. Otherwise stash bytes in r12 and start the walk. (4) ls_walk_top: bounds-check `offset+12 <= bytes` -- insufficient -> refill. Load name_len as u16 via `mov_w r8, [r15 + 8]`. name_len == 0 -> ls_close_done. Otherwise emit two length-bounded sys_write(1,...) calls (name, then '\\n'), reload name_len (r8 is caller-save + SYSCALL clobbers it), advance offset += 12 + name_len. (5) ls_close_done: sys_close(fd) SC+ ID 3; sys_exit(0) SC+ ID 60. (6) Fail paths emit their length-bounded LS-*-FAIL marker via sys_debug_puts (SC+ ID 12, bypasses tty state) then sys_exit with a distinguishing status (1=open failure -- never got fd; 2=getdents failure -- close-then-exit; 3=getcwd failure -- never got fd; 4=path too long -- never got fd). All markers use plain-English tokens per the runtime-string convention (no R/#/v prefixes). @no_frame because every terminal path ends in sys_exit. Register plan and rsp %16 tracking in the block comment above; no push, no sub rsp, N -- entry rsp %16 == 0 and every subsequent CALL sees %16 == 0 (the resolve prologue's only nested syscall is a raw `syscall` which does not affect rsp). Encoder-gap discipline (paideia-as feedback_pdx_encoder_pitfalls): no `test rN, rN` anywhere (every zero-check is `cmp reg, 0`); no `and rN, imm64` on r8-r15; no 2-op `imul r, imm`; no `add reg, [mem]` / `sub reg, [mem]`; every cmp immediate fits imm16 (max seen: 0x1000=4096); byte loads use `xor rax, rax; mov_b rax, [ptr]` per the #1248 mitigation pattern that sys_getcwd_body itself uses. Reserved-label discipline: every label prefixed `ls_` -- new labels ls_no_arg, ls_use_absolute, ls_do_resolve, ls_ulen_top, ls_ulen_done, ls_sep_done, ls_cpy_cwd_top, ls_cpy_cwd_done, ls_cpy_user_start, ls_cpy_user_top, ls_cpy_user_done, ls_fail_getcwd, ls_fail_path_too_long all keep the prefix.",
      block: {
        // ============================================================
        // Phase 0 (v1.1, paideia-os/ls#29) -- classify argv[1] and, on
        // the relative arm, resolve it against sys_getcwd BEFORE any
        // sys_open sees it.  Mirrors mkdir v1.1-B / cp v1.1.0-B.
        //
        //   argc<2                  -> ls_no_arg    (default = cwd)
        //   argv[1][0]=='/'         -> ls_use_absolute (verbatim)
        //   otherwise               -> ls_do_resolve  (cwd + '/' + arg)
        //
        // Every arm sets rdi to a NUL-terminated absolute path and
        // jumps (or falls through) to ls_open_path_ready.
        // ============================================================
        // rdi=argc, rsi=argv, rdx=envp at entry (envp unused here).
        cmp rdi, 2;
        jl  ls_no_arg;

        // argc >= 2: peek argv[1] first byte to classify.
        mov r15, [rsi + 8];                  // r15 = argv[1] ptr (own aspace)

        xor rax, rax;
        mov_b rax, [r15];
        cmp rax, 0x2F;                       // '/'
        je  ls_use_absolute;

        // Any other first byte -> relative arm.  `.` (list cwd), `..`,
        // `./sub`, `foo`, `a/b` all flow through the shared resolve.
        jmp ls_do_resolve;

      ls_no_arg:
        // ============================================================
        // argc<2 -> list cwd.  Fill _ls_cwd_scratch with cwd string.
        // ============================================================
        lea rdi, [rip + _ls_cwd_scratch];
        mov rsi, 256;
        mov rax, 86;                         // SC+ ID 86 = sys_getcwd
        syscall;
        cmp rax, 0;
        jl  ls_fail_getcwd;
        lea rdi, [rip + _ls_cwd_scratch];
        jmp ls_open_path_ready;

      ls_use_absolute:
        // ============================================================
        // Absolute path -> pass through verbatim.
        // ============================================================
        mov rdi, r15;
        jmp ls_open_path_ready;

      ls_do_resolve:
        // ============================================================
        // Relative path -> resolve against cwd.
        // ============================================================
        // sys_getcwd(&_ls_cwd_scratch, 256).
        lea rdi, [rip + _ls_cwd_scratch];
        mov rsi, 256;
        mov rax, 86;                         // SC+ ID 86 = sys_getcwd
        syscall;
        cmp rax, 0;
        jl  ls_fail_getcwd;

        // r8 = cwd_len (excluding trailing NUL).
        mov r8, rax;
        sub r8, 1;

        // Inline bounded strlen(r15), cap at 255. r9 = user_len.
        xor r9, r9;
      ls_ulen_top:
        cmp r9, 255;
        jae ls_fail_path_too_long;
        xor rax, rax;
        mov_b rax, [r15 + r9*1];
        cmp rax, 0;
        je  ls_ulen_done;
        add r9, 1;
        jmp ls_ulen_top;

      ls_ulen_done:
        // Separator: sep = 1 by default, sep = 0 iff cwd is exactly "/"
        // (cwd_len == 1 AND _ls_cwd_scratch[0] == '/'). Elides the
        // double slash on `ls foo` under root.
        mov r10, 1;
        cmp r8, 1;
        jne ls_sep_done;
        lea rax, [rip + _ls_cwd_scratch];
        xor rdx, rdx;
        mov_b rdx, [rax];
        cmp rdx, 0x2F;
        jne ls_sep_done;
        xor r10, r10;                        // cwd == "/" -> sep = 0

      ls_sep_done:
        // total_len = cwd_len + sep + user_len.  Must leave a NUL slot
        // at index total_len, so total_len <= 255.
        mov rdx, r8;
        add rdx, r10;
        add rdx, r9;
        cmp rdx, 255;
        ja  ls_fail_path_too_long;

        // ---- Copy cwd bytes into resolved scratch ----
        lea rdi, [rip + _ls_resolved_scratch];
        lea rsi, [rip + _ls_cwd_scratch];
        xor r11, r11;                        // r11 = write cursor
      ls_cpy_cwd_top:
        cmp r11, r8;
        jae ls_cpy_cwd_done;
        xor rax, rax;
        mov_b rax, [rsi + r11*1];
        mov_b [rdi + r11*1], rax;
        add r11, 1;
        jmp ls_cpy_cwd_top;

      ls_cpy_cwd_done:
        // ---- Emit separator if needed ----
        cmp r10, 0;
        je  ls_cpy_user_start;
        mov rax, 0x2F;                       // '/'
        mov_b [rdi + r11*1], rax;
        add r11, 1;

      ls_cpy_user_start:
        // ---- Copy user bytes ----
        xor rcx, rcx;                        // rcx = user read index
      ls_cpy_user_top:
        cmp rcx, r9;
        jae ls_cpy_user_done;
        xor rdx, rdx;
        mov_b rdx, [r15 + rcx*1];
        mov_b [rdi + r11*1], rdx;
        add r11, 1;
        add rcx, 1;
        jmp ls_cpy_user_top;

      ls_cpy_user_done:
        // NUL-terminate at [rdi + r11].
        xor rax, rax;
        mov_b [rdi + r11*1], rax;

        // rdi already points to _ls_resolved_scratch after the byte-
        // copy loop, but restate the lea for clarity and to guard
        // against any future refactor that reassigns rdi in the copy
        // path.  Fall through to ls_open_path_ready.
        lea rdi, [rip + _ls_resolved_scratch];

      ls_open_path_ready:
        // ============================================================
        // Phase 1 -- sys_open(path, O_RDONLY = 0, mode = 0) -> fd
        // ============================================================
        xor rsi, rsi;                        // flags = O_RDONLY (0)
        xor rdx, rdx;                        // mode = 0 (ignored by sys_open)
        mov rax, 2;                          // SC+ ID 2 = sys_open
        syscall;

        // rax = fd in [3, 32) on success, else negative-errno (bit 63 set).
        // `cmp rax, 32; jae` catches both cases: any valid fd is < 32,
        // and any negative-errno as unsigned is >> 32.
        cmp rax, 32;
        jae ls_fail_open;
        mov rbx, rax;                        // rbx = fd (callee-save)

        // r14 = &_ls_buf, constant for the rest of _start.
        lea r14, [rip + _ls_buf];

      ls_getdents_top:
        // ============================================================
        // Phase 2 -- sys_getdents(fd, buf, 4096)
        // ============================================================
        mov rdi, rbx;                        // fd
        mov rsi, r14;                        // buf
        mov rdx, 4096;                       // nbytes
        call sys_getdents;                   // libc wrapper -> SC+ ID 78

        // rax == 0 -> directory drained (spec: 'if bytes==0 break').
        cmp rax, 0;
        je  ls_close_done;

        // rax > 4096 -> negative errno (bit 63 set as unsigned dwarfs 4096).
        cmp rax, 4096;
        ja  ls_fail_getdents;

        mov r12, rax;                        // r12 = bytes_returned
        xor r13, r13;                        // r13 = offset := 0

      ls_walk_top:
        // ============================================================
        // Phase 3 -- walk one record
        // ============================================================
        // Bounds: offset + 12 must be <= bytes to fit a header.
        // Insufficient -> batch drained without terminator; refill.
        mov rcx, r13;
        add rcx, 12;
        cmp rcx, r12;
        ja  ls_getdents_top;

        // Materialise record pointer: r15 = &_ls_buf[offset].
        mov r15, r14;
        add r15, r13;

        // Load name_len as u16 (zero-extended into r8).
        xor r8, r8;
        mov_w r8, [r15 + 8];
        cmp r8, 0;
        je  ls_close_done;                   // terminator -> directory drained

        // ============================================================
        // Phase 4 -- emit one entry: name, then '\n'.
        // ============================================================
        // sys_write(1, &buf[offset + 12], name_len)
        mov rdi, 1;                          // fd = stdout
        mov rsi, r15;
        add rsi, 12;                         // buf = &record.name
        mov rdx, r8;                         // count = name_len
        mov rax, 1;                          // SC+ ID 1 = sys_write
        syscall;

        // sys_write(1, "\n", 1)
        mov rdi, 1;                          // fd = stdout
        lea rsi, [rip + ls_newline];         // buf = &newline
        mov rdx, 1;                          // count = 1
        mov rax, 1;                          // SC+ ID 1 = sys_write
        syscall;

        // Advance offset += 12 + name_len. r8 was caller-save and clobbered
        // by SYSCALL, so reload name_len from memory. r13 (offset) is
        // callee-save and survives; r14 / r15 base + rec ptr survive.
        mov r15, r14;
        add r15, r13;
        xor r8, r8;
        mov_w r8, [r15 + 8];
        add r13, 12;
        add r13, r8;
        jmp ls_walk_top;

      ls_close_done:
        // ============================================================
        // Phase 5 -- sys_close(fd); sys_exit(0)
        // ============================================================
        mov rdi, rbx;                        // fd
        mov rax, 3;                          // SC+ ID 3 = sys_close
        syscall;

        xor rdi, rdi;                        // status = 0 (OK)
        mov rax, 60;                         // SC+ ID 60 = sys_exit
        syscall;

        // Unreachable. sys_exit does not return; defensive hlt in case of
        // an impossible fallthrough (kernel regression on ID 60).
        hlt;

      ls_fail_open:
        // sys_debug_puts("LS OPEN FAIL\n", 13)
        lea rdi, [rip + ls_err_open_msg];
        mov rsi, 13;                         // ls_err_open_len
        mov rax, 12;                         // SC+ ID 12 = sys_debug_puts
        syscall;

        // sys_exit(1) -- open failed; no fd to close.
        mov rdi, 1;
        mov rax, 60;
        syscall;
        hlt;

      ls_fail_getdents:
        // sys_debug_puts("LS GETDENTS FAIL\n", 17)
        lea rdi, [rip + ls_err_getd_msg];
        mov rsi, 17;                         // ls_err_getd_len
        mov rax, 12;                         // SC+ ID 12 = sys_debug_puts
        syscall;

        // sys_close(fd) -- clean up the open fd before exit.
        mov rdi, rbx;
        mov rax, 3;                          // SC+ ID 3 = sys_close
        syscall;

        // sys_exit(2) -- distinguish from open failure (1).
        mov rdi, 2;
        mov rax, 60;
        syscall;
        hlt;

      ls_fail_getcwd:
        // v1.1 (paideia-os/ls#29): sys_getcwd failure in the resolve
        // prologue.  No fd was opened, so no sys_close is needed.
        // sys_debug_puts("LS GETCWD FAIL\n", 15)
        lea rdi, [rip + ls_err_gcwd_msg];
        mov rsi, 15;                         // ls_err_gcwd_len
        mov rax, 12;                         // SC+ ID 12 = sys_debug_puts
        syscall;

        // sys_exit(3) -- distinguish from open (1) / getdents (2).
        mov rdi, 3;
        mov rax, 60;
        syscall;
        hlt;

      ls_fail_path_too_long:
        // v1.1 (paideia-os/ls#29): the composed cwd+'/'+argv[1] would
        // exceed SYS_MKDIR_PATH_MAX-1 (255) once NUL-terminated.  No fd
        // was opened.  sys_debug_puts("LS PATH TOO LONG\n", 17)
        lea rdi, [rip + ls_err_tlong_msg];
        mov rsi, 17;                         // ls_err_tlong_len
        mov rax, 12;                         // SC+ ID 12 = sys_debug_puts
        syscall;

        // sys_exit(4) -- distinguish from open (1) / getdents (2) /
        // getcwd (3).
        mov rdi, 4;
        mov rax, 60;
        syscall;
        hlt
      }
    } @no_frame
}
