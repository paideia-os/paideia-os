// src/user/color/hdr_metadata_kind.pdx -- G6.M4-003 (paideia-os #2237)
//
// KIND_HDR_METADATA = 0x1B5, derived over KIND_MEMORY (= KIND_PAGE, 4).
//
// Wave 0 Batch 1 dispatch per MASTER_PLAN.md. This landing DECLARES the
// KIND_HDR_METADATA cap-kind identity for the G6 color pipeline: slot
// number, rights, ops, failure taxonomy, on-cap row layout, pure
// validators and packers. The kernel-side dispatcher / mint body /
// cap_handler live in a future issue (kind_hdr_metadata.pdx +
// cap_handler_hdr_metadata.pdx); everything user-space needs to
// CONSTRUCT an HDR-metadata payload prior to minting (and to
// INTERPRET one after a query) is here.
//
// =============================================================================
// SECTION 0  WHY THIS KIND EXISTS
// =============================================================================
//
// HDR-capable outputs (HDR10, HDR10+, HLG, Dolby Vision) drive a
// reference-display tone-mapping pipeline that MUST know two things
// about the incoming content:
//
//   (a) STATIC MASTERING METADATA -- the colour volume the content
//       was mastered on (SMPTE ST 2086: red/green/blue primary
//       chromaticities, white point, min/max mastering-display
//       luminance), plus content-light-level bounds (HEVC max-CLL
//       and max-FALL per ITU-T H.265 D.2.35).
//
//   (b) DYNAMIC METADATA when the content is Dolby Vision -- an
//       RPU (Reference Processing Unit) payload delivered per-frame
//       that the DV composer applies before tone-mapping. RPU
//       parsing (composing L1/L2/L8 trim metadata, applying MMR /
//       NLQ curves, etc.) is the DV composer's job; THIS cap
//       carries a REFERENCE to the KIND_MEMORY-hosted RPU byte
//       range, never the parsed form. The compositor MUST hold
//       BOTH this cap AND the referenced KIND_MEMORY cap to consume
//       an RPU -- capability composition rather than a smuggled
//       pointer.
//
// A KIND_COLOR_PROFILE (0x18F, kind_color_profile.pdx) already
// records the CICP triplet + optional ICC v4 reference; the two
// caps compose per surface commit: COLOR_PROFILE describes WHICH
// colourspace the pixels live in, HDR_METADATA describes HOW BRIGHT
// / how volume-bounded that space is on the source master. Both
// are P5 invariants once G6 closes.
//
// =============================================================================
// SECTION 1  RELATIONSHIP TO CLOSED #1515 (G6.M2-002 EOTF/OETF)
// =============================================================================
//
// The predecessor issue #1515 delivered TRANSFER CURVES ONLY (sRGB,
// PQ, HLG, Dolby Vision EOTF/OETF; test on synthetic gradient) -- a
// per-pixel value-domain mapping executed in the shader stage of the
// compositor pipeline. It did NOT create KIND_HDR_METADATA, and it
// carries no static-mastering or dynamic-metadata payload; it is a
// pure function from [0,1] scRGB-linear to display-encoded values,
// or vice versa. #1515's "New capabilities" note listing
// KIND_HDR_METADATA is a FORWARD-REFERENCE to the G6.M4 landing
// this file starts; it is not a claim that #1515 shipped the cap.
// (Verified: gh api repos/paideia-os/paideia-os/issues/1515 -- body
// deliverable is exclusively "transfer curves; test on synthetic
// gradient".) See §5 of this file for the compose seam.
//
// =============================================================================
// SECTION 2  DERIVATION OVER KIND_MEMORY
// =============================================================================
//
// The kind half of the mint gate demands `kind == KIND_MEMORY (4)`
// carrying RIGHT_MINT. The mint additionally requires:
//
//   (a) rights subset of R_HDR_ALL (0x619)
//   (b) every ST 2086 chromaticity coordinate in [0, HDR_COORD_SCALE]
//       (0..50000 == 0.0..1.0 in the 0.00002-unit wire encoding)
//   (c) mastering luminance well-ordered under unit conversion
//       (lmax in [1, 10000] cd/m^2, lmin in [1, 65535] 0.0001-cd/m^2
//       units, lmin < lmax * 10000)
//   (d) max_cll / max_fall in [0, 65535] cd/m^2 (0 == "unknown" is
//       LEGAL per HEVC D.2.35)
//   (e) DV-reference consistency: (has_dv == 0 AND dv_rpu_slot == 0)
//       OR (has_dv == 1 AND dv_rpu_slot < 256). The MEMORY-derivation
//       gate applied to dv_rpu_slot is a separate check the future
//       mint body performs via kind_check_memory(dv_rpu_slot) -- this
//       file exposes only the structural half of the DV cross-check
//       because the cap_table read is a kernel-side operation.
//
// =============================================================================
// SECTION 3  ROW LAYOUT -- 64 BYTES (ONE CACHE LINE)
// =============================================================================
//
//   [+0]  header:      in_use[63:56] | parent_slot[15:8]
//   [+8]  prim_r:      prim_r_x[31:0] | prim_r_y[63:32]     (ST 2086)
//   [+16] prim_g:      prim_g_x[31:0] | prim_g_y[63:32]     (ST 2086)
//   [+24] prim_b:      prim_b_x[31:0] | prim_b_y[63:32]     (ST 2086)
//   [+32] white:       white_x[31:0] | white_y[63:32]       (ST 2086)
//   [+40] lum:         lum_max[31:0] | lum_min[63:32]       (raw wire)
//   [+48] cll_fall:    max_cll[31:0] | max_fall[63:32]      (HEVC D.2.35)
//   [+56] dv_tail:     dv_rpu_slot[15:0] | has_dv[23:16] | reserved[63:24]
//                      -- dv_rpu_slot is a cap_table slot holding
//                         KIND_MEMORY over the DV RPU byte range;
//                         when has_dv==0 the slot field MUST be 0.
//
// 8 rows * 64 bytes = 512 bytes.
//
// =============================================================================
// SECTION 4  FAILURE TAXONOMY -- 0xFFFFEEE1..0xFFFFEEEF
// =============================================================================
//
// Fresh band, verified free by a monorepo-wide sweep of
// 0xFFFFE?__ codes at landing time (gap between 0xFFFFEEE0 and
// 0xFFFFEEF0 == 16 slots; 15 used here, 0xFFFFEEE0 stays claimed
// by its adjacent kind). Every code is nameable at the boundary
// so a caller can distinguish which validator refused the mint
// (bad_primaries vs bad_lum vs bad_cll vs bad_dv_ref) without
// re-running the check chain client-side.
//
// =============================================================================
// SECTION 5  COMPOSE SEAM WITH KIND_COLOR_PROFILE
// =============================================================================
//
// A surface commit that lands on an HDR output presents THREE caps
// to the compositor: KIND_COLOR_PROFILE (colourspace identity),
// KIND_HDR_METADATA (mastering + CLL/FALL + optional DV pathway),
// and the KIND_SURFACE / KIND_GPU_BO for the pixels themselves.
// The G6.M4 dispatcher will refuse a commit whose HDR_METADATA
// row records has_dv == 1 while the referenced dv_rpu_slot no
// longer holds KIND_MEMORY (stale-ref rejection via the future
// cap_table re-read). Nothing in THIS file performs that check --
// it is a kernel-side dispatcher concern that would land alongside
// kind_hdr_metadata.pdx.
//
// LABEL PREFIX: `hmk_` (HDR-metadata-kind) -- avoids paideia-as
// reserved-keyword collisions (`loop`, `if`, `let`, ...) per
// feedback_paideia_as_reserved_labels.

module HdrMetadataKind = structure {

  // ==========================================================================
  // Identity.
  // ==========================================================================

  pub let KIND_HDR_METADATA      : u64 = 0x1B5
  pub let KIND_HDR_METADATA_BASE : u64 = 4          // = KIND_MEMORY

  // Rights layout mirrors kind_color_profile.pdx's R_CP_* exactly so
  // the future dispatcher's per-op gate can name the same bit
  // positions across both color caps.
  pub let R_HDR_READ    : u64 = 0x001
  pub let R_HDR_INVOKE  : u64 = 0x008
  pub let R_HDR_REVOKE  : u64 = 0x010
  pub let R_HDR_MINT    : u64 = 0x200
  pub let R_HDR_OBSERVE : u64 = 0x400
  pub let R_HDR_ALL     : u64 = 0x619

  // Ops. Every op is arity ONE (row_id in target_ptr, sub-op in
  // op_arg[7:0]); op_arg[63:8] MUST be zero -- the future dispatcher
  // will refuse a smuggled second value with HDR_TAIL_BAD_ARG,
  // mirroring kind_schema_handle.pdx ksh_hn_ dispatch discipline.
  pub let HDR_OP_QUERY_MAX_CLL     : u64 = 0
  pub let HDR_OP_QUERY_MAX_FALL    : u64 = 1
  pub let HDR_OP_QUERY_LUM_MAX     : u64 = 2
  pub let HDR_OP_QUERY_LUM_MIN     : u64 = 3
  pub let HDR_OP_QUERY_PRIM_R      : u64 = 4
  pub let HDR_OP_QUERY_PRIM_G      : u64 = 5
  pub let HDR_OP_QUERY_PRIM_B      : u64 = 6
  pub let HDR_OP_QUERY_WHITE       : u64 = 7
  pub let HDR_OP_QUERY_HAS_DV      : u64 = 8
  pub let HDR_OP_QUERY_DV_RPU_REF  : u64 = 9
  pub let HDR_OP_DEBUG_PRINT       : u64 = 10
  pub let HDR_OP_MAX               : u64 = 10

  // Failure taxonomy -- 0xFFFFEEE1..0xFFFFEEEF (see file header §4).
  pub let HDR_OK                   : u64 = 0
  pub let HDR_TAIL_ENOSPC          : u64 = 0xFFFFEEEF
  pub let HDR_TAIL_BAD_ARG         : u64 = 0xFFFFEEEE
  pub let HDR_MINT_BAD_PARENT      : u64 = 0xFFFFEEED
  pub let HDR_MINT_BAD_RIGHTS      : u64 = 0xFFFFEEEC
  pub let HDR_MINT_BAD_PRIMARIES   : u64 = 0xFFFFEEEB
  pub let HDR_MINT_BAD_WHITE       : u64 = 0xFFFFEEEA
  pub let HDR_MINT_BAD_LUM         : u64 = 0xFFFFEEE9
  pub let HDR_MINT_BAD_CLL         : u64 = 0xFFFFEEE8
  pub let HDR_MINT_BAD_FALL        : u64 = 0xFFFFEEE7
  pub let HDR_MINT_BAD_HAS_DV      : u64 = 0xFFFFEEE6
  pub let HDR_MINT_BAD_DV_REF      : u64 = 0xFFFFEEE5
  pub let HDR_BAD_SLOT             : u64 = 0xFFFFEEE4
  pub let HDR_WRONG_KIND           : u64 = 0xFFFFEEE3
  pub let HDR_REVOKE_ALREADY       : u64 = 0xFFFFEEE2
  pub let HDR_DECODE_BAD           : u64 = 0xFFFFFFFFFFFFFFFF

  // ST 2086 chromaticity wire scale: coordinates are 0.00002-unit
  // fixed-point integers (integer range [0, 50000] == floating
  // range [0.0, 1.0]) per ITU-T H.265 Annex F.
  pub let HDR_COORD_SCALE      : u64 = 50000

  // Mastering-display luminance wire form: lum_max is in 1 cd/m^2
  // units [1, 10000], lum_min in 0.0001-cd/m^2 units [1, 65535]
  // (ITU-T H.265 D.2.28). The unit-conversion factor between the
  // two is HDR_LUM_MAX_UNIT_TO_MIN (1 cd/m^2 == 10000 min-units).
  pub let HDR_LUM_MAX_MAX          : u64 = 10000
  pub let HDR_LUM_MIN_MAX          : u64 = 65535
  pub let HDR_LUM_MAX_UNIT_TO_MIN  : u64 = 10000

  // max-CLL / max-FALL wire form: 16-bit cd/m^2 (HEVC D.2.35);
  // value 0 is legal ("unknown", encoder did not compute).
  pub let HDR_CLL_MAX  : u64 = 65535
  pub let HDR_FALL_MAX : u64 = 65535

  // has_dv is a 1-bit predicate widened to a u64 at the API surface;
  // any value outside {0, 1} is refused by hmk_dv_ref_valid.
  pub let HDR_HAS_DV_MAX : u64 = 1

  // Row pool sizing (one cache line per row, kind_tui_canvas.pdx
  // precedent; 8 rows starting ceiling).
  pub let HDR_MD_MAX       : u64 = 8
  pub let HDR_MD_ROW_BYTES : u64 = 64

  // THE ONE STATE CELL. Confined to hdr_metadata_kind.o by the
  // build-time confinement gate the future kind_hdr_metadata
  // landing will add (mirrors _tui_canvas_pool's confinement in
  // tools/build.sh; not yet wired -- see softarch report §4).
  // 8 rows * 64 bytes = 512 bytes.
  pub let mut _hdr_md_pool  : [u8; 512] = uninit @align(8)

  // Counters (mints / revokes / queries / refused). Bounds-checked
  // against 4 in hmk_stats_bump / hmk_stats_read.
  pub let mut _hdr_md_stats : [u64; 4] = uninit @align(64)

  pub let HDR_ST_MINTS   : u64 = 0
  pub let HDR_ST_REVOKES : u64 = 1
  pub let HDR_ST_QUERIES : u64 = 2
  pub let HDR_ST_REFUSED : u64 = 3

  // Fingerprint -- ONE tag ending [legacy: ... OK] per softarch
  // discipline. The future kind_hdr_metadata mint body will emit
  // this string via klog_s1_x1 on successful mint; until that
  // landing arrives the string is a data-only constant and needs
  // to be allowlisted in tools/verify-fingerprint-coverage.sh
  // with reason "kind_hdr_metadata mint body not yet landed
  // (G6.M4-004)". See softarch report §4.
  pub let hmk_mint_ok_msg : [u8; 46] = "hdr metadata mint ok [legacy: HDR MD MINT OK]\0"

  // ==========================================================================
  // Validators.
  // ==========================================================================

  // hmk_coord_valid(v) -> 1 iff v <= HDR_COORD_SCALE (50000). 0 is
  // legal (a coordinate exactly at the encoding origin).
  pub let hmk_coord_valid : (u64) -> u64 !{} @{} =
    fn (v: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G6.M4-003 (paideia-os #2237): 1 iff v <= HDR_COORD_SCALE(50000). ST 2086 primary/white x/y wire encoding per ITU-T H.265 Annex F (0.00002-unit fixed point; integer range [0, 50000]). Labels prefixed hmk_cv_.",
      block: {
        mov r10, 50000;
        cmp rdi, r10;
        ja  hmk_cv_no;
        mov rax, 1;
        ret;
      hmk_cv_no:
        xor rax, rax;
        ret
      }
    }

  // hmk_primaries_valid(rx, ry, gx, gy, bx, by) -> 1 iff every arg
  // <= HDR_COORD_SCALE. Six args fit SysV register slots exactly
  // (rdi/rsi/rdx/rcx/r8/r9); no stack args, no callee-save pushes
  // needed (no nested call is made from this leaf beyond the tail
  // return, and every compare is against a materialised immediate).
  pub let hmk_primaries_valid : (u64, u64, u64, u64, u64, u64) -> u64 !{} @{} =
    fn (rx: u64) (ry: u64) (gx: u64) (gy: u64) (bx: u64) (by: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G6.M4-003 (paideia-os #2237): every ST 2086 primary chromaticity coordinate (R/G/B x/y) in [0, HDR_COORD_SCALE]. Six args = six SysV register slots; no pushes, no nested calls. r10 rematerialised per compare because the encoder does not schedule live-across-jump immediates. Labels prefixed hmk_pv_.",
      block: {
        mov r10, 50000;
        cmp rdi, r10;
        ja  hmk_pv_no;
        cmp rsi, r10;
        ja  hmk_pv_no;
        cmp rdx, r10;
        ja  hmk_pv_no;
        cmp rcx, r10;
        ja  hmk_pv_no;
        cmp r8,  r10;
        ja  hmk_pv_no;
        cmp r9,  r10;
        ja  hmk_pv_no;
        mov rax, 1;
        ret;
      hmk_pv_no:
        xor rax, rax;
        ret
      }
    }

  // hmk_white_valid(wx, wy) -> 1 iff both in [0, HDR_COORD_SCALE].
  pub let hmk_white_valid : (u64, u64) -> u64 !{} @{} =
    fn (wx: u64) (wy: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G6.M4-003 (paideia-os #2237): ST 2086 white-point x/y each in [0, HDR_COORD_SCALE]. Labels prefixed hmk_wv_.",
      block: {
        mov r10, 50000;
        cmp rdi, r10;
        ja  hmk_wv_no;
        cmp rsi, r10;
        ja  hmk_wv_no;
        mov rax, 1;
        ret;
      hmk_wv_no:
        xor rax, rax;
        ret
      }
    }

  // hmk_lum_valid(lmax, lmin) -> 1 iff lmax in [1, HDR_LUM_MAX_MAX]
  // AND lmin in [1, HDR_LUM_MIN_MAX] AND (lmin < lmax *
  // HDR_LUM_MAX_UNIT_TO_MIN). The last clause enforces well-ordering
  // AFTER unit conversion, because lmin uses 0.0001-cd/m^2 units and
  // lmax uses 1-cd/m^2 units; a raw compare of the wire integers
  // would let a 5000 (== 0.5 cd/m^2) min slip past a 1000 (== 1000
  // cd/m^2) max because 5000 > 1000 in the raw integer domain.
  pub let hmk_lum_valid : (u64, u64) -> u64 !{} @{} =
    fn (lmax: u64) (lmin: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G6.M4-003 (paideia-os #2237): mastering-display luminance bounds per ITU-T H.265 D.2.28. lmax in [1, 10000], lmin in [1, 65535], AND lmin < lmax * 10000 (unit-converted well-ordering: lmin is 0.0001-cd/m^2 units and lmax is 1-cd/m^2 units, so a raw integer compare would misfire on any pair where the raw integers cross unit boundaries). imul carries no possibility of overflow because lmax <= 10000 and 10000*10000 == 100_000_000, well inside u64. Labels prefixed hmk_lv_.",
      block: {
        cmp rdi, 0;
        je  hmk_lv_no;
        mov r10, 10000;
        cmp rdi, r10;
        ja  hmk_lv_no;
        cmp rsi, 0;
        je  hmk_lv_no;
        mov r10, 65535;
        cmp rsi, r10;
        ja  hmk_lv_no;
        mov rax, rdi;
        imul rax, 10000;
        cmp rsi, rax;
        jae hmk_lv_no;
        mov rax, 1;
        ret;
      hmk_lv_no:
        xor rax, rax;
        ret
      }
    }

  // hmk_cll_valid(v) -> 1 iff v <= HDR_CLL_MAX (65535). 0 is legal
  // ("unknown" per HEVC D.2.35). Applied identically to max_cll
  // and max_fall (see hmk_fall_valid alias).
  pub let hmk_cll_valid : (u64) -> u64 !{} @{} =
    fn (v: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G6.M4-003 (paideia-os #2237): 1 iff v <= HDR_CLL_MAX(65535). 0 legal per HEVC D.2.35. Labels prefixed hmk_cw_.",
      block: {
        mov r10, 65535;
        cmp rdi, r10;
        ja  hmk_cw_no;
        mov rax, 1;
        ret;
      hmk_cw_no:
        xor rax, rax;
        ret
      }
    }

  // hmk_fall_valid(v) -> 1 iff v <= HDR_FALL_MAX (65535). Distinct
  // named leaf rather than a hmk_cll_valid re-call so the mint
  // body's refusal funnel can classify HDR_MINT_BAD_CLL vs
  // HDR_MINT_BAD_FALL at the call site without threading a
  // discriminator through the validator.
  pub let hmk_fall_valid : (u64) -> u64 !{} @{} =
    fn (v: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G6.M4-003 (paideia-os #2237): 1 iff v <= HDR_FALL_MAX(65535). Separate leaf from hmk_cll_valid so caller-side classification (BAD_CLL vs BAD_FALL) stays cheap. Labels prefixed hmk_fv_.",
      block: {
        mov r10, 65535;
        cmp rdi, r10;
        ja  hmk_fv_no;
        mov rax, 1;
        ret;
      hmk_fv_no:
        xor rax, rax;
        ret
      }
    }

  // hmk_rights_valid(r) -> 1 iff r subset of R_HDR_ALL (0x619).
  pub let hmk_rights_valid : (u64) -> u64 !{} @{} =
    fn (r: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G6.M4-003 (paideia-os #2237): subset test against R_HDR_ALL = 0x619. Labels prefixed hmk_rv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x619;
        and rax, r10;
        cmp rax, rdi;
        jne hmk_rv_no;
        mov rax, 1;
        ret;
      hmk_rv_no:
        xor rax, rax;
        ret
      }
    }

  // hmk_dv_ref_valid(has_dv, dv_rpu_slot) -> 1 iff (has_dv==0 AND
  // dv_rpu_slot==0) OR (has_dv==1 AND dv_rpu_slot<256). The
  // KIND_MEMORY parent gate applied to dv_rpu_slot is a separate
  // cap_table read the future kernel-side mint body performs; this
  // validator only enforces the STRUCTURAL cross-check (has_dv and
  // dv_rpu_slot cannot disagree on presence).
  pub let hmk_dv_ref_valid : (u64, u64) -> u64 !{} @{} =
    fn (has_dv: u64) (dv_rpu_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G6.M4-003 (paideia-os #2237): structural cross-check between has_dv predicate and dv_rpu_slot field. (has_dv==0 AND slot==0) OR (has_dv==1 AND slot<256). has_dv outside {0,1} refused. Labels prefixed hmk_dv_.",
      block: {
        cmp rdi, 1;
        ja  hmk_dv_no;
        cmp rdi, 0;
        jne hmk_dv_has;
        cmp rsi, 0;
        jne hmk_dv_no;
        mov rax, 1;
        ret;
      hmk_dv_has:
        mov r10, 256;
        cmp rsi, r10;
        jae hmk_dv_no;
        mov rax, 1;
        ret;
      hmk_dv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Packers.
  // ==========================================================================

  // hmk_pack_xy(x, y) -> x[31:0] | y[63:32]. Reused for every ST 2086
  // (x, y) chromaticity pair (R, G, B, W) and for the (lum_max,
  // lum_min) and (max_cll, max_fall) pairs. Consumers hold both
  // halves as u32 wire values before packing.
  pub let hmk_pack_xy : (u64, u64) -> u64 !{} @{} =
    fn (x: u64) (y: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G6.M4-003 (paideia-os #2237): pack x[31:0] | y[63:32]. Reused for four ST 2086 chromaticity pairs, lum(max,min), cll(max,fall). Labels prefixed hmk_pxy_.",
      block: {
        mov rax, rdi;
        and rax, 0xFFFFFFFF;
        mov r10, rsi;
        and r10, 0xFFFFFFFF;
        shl r10, 32;
        or  rax, r10;
        ret
      }
    }

  // hmk_pack_dv_tail(dv_rpu_slot, has_dv) -> dv_rpu_slot[15:0] |
  // has_dv[23:16] | reserved[63:24].
  pub let hmk_pack_dv_tail : (u64, u64) -> u64 !{} @{} =
    fn (dv_rpu_slot: u64) (has_dv: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G6.M4-003 (paideia-os #2237): pack DV RPU-reference tail word per file-header row layout +56: slot[15:0] | has_dv[23:16] | reserved[63:24]. Labels prefixed hmk_pdt_.",
      block: {
        mov rax, rdi;
        and rax, 0xFFFF;
        mov r10, rsi;
        and r10, 0xFF;
        shl r10, 16;
        or  rax, r10;
        ret
      }
    }

  // hmk_hdr_pack(parent_slot) -> in_use[63:56]=0 | parent_slot[15:8]
  // | zeros elsewhere. Only parent_slot is written here; in_use is
  // set by hmk_row_alloc on the successful claim path.
  pub let hmk_hdr_pack : (u64) -> u64 !{} @{} =
    fn (parent_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "G6.M4-003 (paideia-os #2237): canonical row-header encoder; parent_slot at [15:8]; in_use[63:56] deferred to hmk_row_alloc's success tail. Labels prefixed hmk_hp_.",
      block: {
        mov rax, rdi;
        and rax, 0xFF;
        shl rax, 8;
        ret
      }
    }

  // ==========================================================================
  // Row pool: row_valid / row_alloc / row_free / setters for CLL and DV.
  //
  // Split into three writers (row_alloc for the mastering-metadata
  // block, row_set_cll_fall for CLL/FALL, row_set_dv for the DV tail)
  // rather than one eight-arg body so every entry point takes at
  // most six args and fits the SysV AMD64 register slots without
  // spilling to the stack -- the same discipline kind_bt_pairing.pdx
  // and kind_scanout_lease.pdx use for their multi-field mint paths.
  // ==========================================================================

  // hmk_row_valid(idx) -> 1 iff idx < HDR_MD_MAX(8) and in_use set.
  // Inlines the pool-address compute (idx*64 via shl 6) rather than
  // calling a nested slot-address helper, keeping this a pure leaf.
  // Mirrors kind_tui_canvas.pdx tui_canvas_row_valid one-for-one.
  pub let hmk_row_valid : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G6.M4-003 (paideia-os #2237): 1 iff idx < HDR_MD_MAX(8) and in_use set. Inlined idx*64 via shl 6 (SIB scale cap is 8). Mirrors kind_tui_canvas.pdx tui_canvas_row_valid. Labels prefixed hmk_rv2_.",
      block: {
        mov r10, 8;
        cmp rdi, r10;
        jae hmk_rv2_no;
        lea r10, [rip + _hdr_md_pool];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  hmk_rv2_no;
        mov rax, 1;
        ret;
      hmk_rv2_no:
        xor rax, rax;
        ret
      }
    }

  // hmk_row_alloc(hdr, prim_r_pack, prim_g_pack, prim_b_pack,
  //               white_pack, lum_pack) -> row_id | HDR_TAIL_ENOSPC.
  //
  // THE ONLY WRITER of _hdr_md_pool's mastering-metadata block
  // (header + primaries R/G/B + white + lum). CLL/FALL word and DV
  // tail word are zero-initialised here and written later via
  // hmk_row_set_cll_fall / hmk_row_set_dv against the returned
  // row_id.
  //
  // Low-first free scan over 8 rows of 64 bytes. Six args fit SysV
  // registers exactly (rdi/rsi/rdx/rcx/r8/r9); five callee-save
  // pushes park the pack args across the (currently absent) nested
  // call surface -- the shape mirrors kind_tui_canvas.pdx
  // tui_canvas_tail_alloc so a future kernel-side dispatcher can
  // add klog emission or cap-table cross-check calls here without
  // re-writing the frame.
  pub let hmk_row_alloc : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (prim_r_pack: u64) (prim_g_pack: u64) (prim_b_pack: u64) (white_pack: u64) (lum_pack: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G6.M4-003 (paideia-os #2237): claim one HDR-metadata row (THE ONLY WRITER of _hdr_md_pool's mastering-block). Six SysV register args (rdi..r9). Low-first scan over 8 rows of 64 bytes (idx*64 via shl 6). Populates header + primaries R/G/B + white + lum; CLL/FALL and DV tail zero-initialised here and written later via hmk_row_set_cll_fall / hmk_row_set_dv. Five callee-save pushes park hdr/pack args (rbx/r12/r13/r14/r15); entry rsp%16==8, five pushes -> rsp%16==0, no nested calls so no further alignment work required. Labels prefixed hmk_ra_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                    // hdr
        mov r12, rsi;                    // prim_r_pack
        mov r13, rdx;                    // prim_g_pack
        mov r14, rcx;                    // prim_b_pack
        mov r15, r8;                     // white_pack
        // r9 == lum_pack, kept in r9 (no nested call clobbers it)

        xor rcx, rcx;                    // idx = 0
      hmk_ra_scan:
        cmp rcx, 8;
        jae hmk_ra_enospc;

        lea r10, [rip + _hdr_md_pool];
        mov r11, rcx;
        shl r11, 6;                      // idx * 64
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  hmk_ra_claim;

        add rcx, 1;
        jmp hmk_ra_scan;

      hmk_ra_claim:
        mov rax, rbx;                    // hdr
        mov rdi, 1;
        shl rdi, 56;
        or  rax, rdi;                    // header |= in_use<<56
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r12;             // prim_r_pack
        mov [r10 + 16], r13;             // prim_g_pack
        mov [r10 + 24], r14;             // prim_b_pack
        mov [r10 + 32], r15;             // white_pack
        mov [r10 + 40], r9;              // lum_pack
        xor rax, rax;
        mov [r10 + 48], rax;             // cll_fall = 0 (default)
        mov [r10 + 56], rax;             // dv_tail  = 0 (default)
        mov rax, rcx;                    // row_id
        jmp hmk_ra_out;

      hmk_ra_enospc:
        mov rax, 0xFFFFEEEF;             // HDR_TAIL_ENOSPC

      hmk_ra_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // hmk_row_set_cll_fall(row_id, cll_pack) -> HDR_OK | HDR_BAD_SLOT.
  // Writes the CLL/FALL word (+48) of an existing row. Refuses a
  // row that is not in_use (mint sequence is: hmk_row_alloc first,
  // then this and hmk_row_set_dv against the returned row_id).
  pub let hmk_row_set_cll_fall : (u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64) (cll_pack: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G6.M4-003 (paideia-os #2237): write CLL/FALL word (+48) of an existing row. One callee-save push (r12=cll_pack across the nested hmk_row_valid call) + sub rsp,8 leaves rsp%16==0 (entry rsp%16==8, +8+8=16, %16==0). Labels prefixed hmk_scf_.",
      block: {
        push r12;
        sub  rsp, 8;
        mov  r12, rsi;                   // save cll_pack across the call

        call hmk_row_valid;
        cmp rax, 0;
        je  hmk_scf_bad;

        lea r10, [rip + _hdr_md_pool];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov [r10 + 48], r12;
        xor rax, rax;                    // HDR_OK
        jmp hmk_scf_out;

      hmk_scf_bad:
        mov rax, 0xFFFFEEE4;             // HDR_BAD_SLOT

      hmk_scf_out:
        add rsp, 8;
        pop r12;
        ret
      }
    }

  // hmk_row_set_dv(row_id, dv_pack) -> HDR_OK | HDR_BAD_SLOT.
  // Writes the DV tail word (+56).
  pub let hmk_row_set_dv : (u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64) (dv_pack: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G6.M4-003 (paideia-os #2237): write DV tail word (+56) of an existing row. Same frame shape as hmk_row_set_cll_fall (one callee-save push + sub rsp,8 = 16 B, entry rsp%16==8 -> rsp%16==0). Labels prefixed hmk_sdv_.",
      block: {
        push r12;
        sub  rsp, 8;
        mov  r12, rsi;

        call hmk_row_valid;
        cmp rax, 0;
        je  hmk_sdv_bad;

        lea r10, [rip + _hdr_md_pool];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov [r10 + 56], r12;
        xor rax, rax;
        jmp hmk_sdv_out;

      hmk_sdv_bad:
        mov rax, 0xFFFFEEE4;             // HDR_BAD_SLOT

      hmk_sdv_out:
        add rsp, 8;
        pop r12;
        ret
      }
    }

  // hmk_row_free(idx) -> (). Scrub the whole 64-byte row. Bounds
  // check keeps an out-of-range idx from writing past the pool.
  pub let hmk_row_free : (u64) -> () !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G6.M4-003 (paideia-os #2237): scrub one row (all eight words). Bounds check on idx before writing. Labels prefixed hmk_rf_.",
      block: {
        mov r10, 8;
        cmp rdi, r10;
        jae hmk_rf_out;
        lea r10, [rip + _hdr_md_pool];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        mov [r10 + 32], rax;
        mov [r10 + 40], rax;
        mov [r10 + 48], rax;
        mov [r10 + 56], rax;
      hmk_rf_out:
        ret
      }
    }

  // ==========================================================================
  // Stats counters.
  // ==========================================================================

  pub let hmk_stats_bump : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G6.M4-003 (paideia-os #2237): bounds-checked counter bump against HDR_ST_REFUSED+1=4. Load-inc-store idiom (no `add reg, [mem]`). Labels prefixed hmk_sb_.",
      block: {
        cmp rdi, 4;
        jae hmk_sb_out;
        lea r10, [rip + _hdr_md_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      hmk_sb_out:
        ret
      }
    }

  pub let hmk_stats_read : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G6.M4-003 (paideia-os #2237): bounds-checked counter read; OOB -> 0 rather than a fault. Labels prefixed hmk_sr_.",
      block: {
        cmp rdi, 4;
        jae hmk_sr_zero;
        lea r10, [rip + _hdr_md_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      hmk_sr_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Boot-time reset (defensive; .bss is already zero at real boot).
  // ==========================================================================

  pub let hmk_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "G6.M4-003 (paideia-os #2237): zero _hdr_md_pool (64 u64 words) and _hdr_md_stats (4 u64 words). Defensive re-scrub; mirrors kind_tui_canvas.pdx kind_tui_canvas_init. Labels prefixed hmk_ini_.",
      block: {
        lea r10, [rip + _hdr_md_pool];
        xor rax, rax;
        xor rcx, rcx;
      hmk_ini_pool:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 64;
        jb  hmk_ini_pool;

        lea r10, [rip + _hdr_md_stats];
        xor rcx, rcx;
      hmk_ini_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  hmk_ini_stats;
        ret
      }
    }
}
