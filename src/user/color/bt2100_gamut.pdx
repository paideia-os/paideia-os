// src/user/color/bt2100_gamut.pdx -- Wave0-B15 G6-M2-001 (paideia-os #2241)
//
// BT.2100 (HDR wide-gamut) color conversion helpers: fixed RGB<->XYZ
// 3x3 matrices for the BT.2100 primaries (identical to BT.2020's, per
// ITU-R BT.2100-2 Table 2 / SS5.3), plus D65<->D50 Bradford chromatic-
// adaptation matrices. DATA-ONLY + PURE COMPUTATION: fixed matrix
// constants and register-only matrix-vector multiply helpers. Consumer
// wires (compositor paint pipeline, HDR settings panel) are future
// landings. Module id M0305 (Bt2100Gamut).
//
// Novel-clean rationale: BT.2100 is the modern ITU-R HDR color-space
// standard (PQ/HLG transfer functions over BT.2020 primaries); the G6
// pipeline must support it as a first-class citizen rather than only
// round-tripping through sRGB, which would needlessly clip HDR gamut.
// This file gives the pipeline the matrix substrate to move between
// the BT.2100 RGB working space, CIE XYZ (the interchange space every
// ICC profile pivots through), and the two reference illuminants D65
// (video/display native white) and D50 (the ICC v4 Profile Connection
// Space white) that color-managed compositing needs to bridge.
//
// =============================================================================
// SECTION 0  WHY BITCAST-DANCE SCALAR-DOUBLE ARITHMETIC
// =============================================================================
//
// paideia-as v0.24.0 (paideia-as#1333) landed the legacy-SSE scalar
// f32/f64 encoder substrate (movsd/addsd/subsd/mulsd/divsd/sqrtsd,
// cvtsi2sd/cvttsd2si, movq_ld/movq_st GPR<->XMM bitcast movs) but
// deliberately deferred two things (paideia-as CHANGELOG v0.24.0):
// memory-operand scalar-float forms (`movsd xmm, [mem]` does not
// exist -- every SSE mnemonic here is register-register only), and
// source-level float literals (`let x: f64 = 0.708;` does not lower
// to these mnemonics yet -- the parser/typer/emit_walker wiring is
// separate follow-up work). Consequence: every f64 value in this file
// is carried as its IEEE 754 binary64 bit pattern in a u64, and
// enters/leaves the floating-point domain via the bitcast dance:
//
//   mov   r10, <u64 bit pattern>   // GPR holds the raw bits
//   movq_ld xmm0, r10              // bitcast reinterpret (not a
//                                  //   numeric int->float convert)
//   mulsd/addsd/... xmm0, xmm1     // real IEEE 754 double arithmetic
//   movq_st r10, xmm0              // bitcast back to a GPR
//   mov   [mem], r10               // store the result bits
//
// Matrix constants live as `[u64; 9]` bit-pattern arrays (row-major,
// SECTION 1), loaded via an ordinary integer `mov reg, [mem]` (no
// memory-operand SSE form needed for that half) and then bitcast into
// an XMM register for the multiply/add.
//
// =============================================================================
// SECTION 1  MATRIX DERIVATION + STORAGE LAYOUT
// =============================================================================
//
// BT.2100-2 SS5.3 primaries + D65 white (identical to BT.2020 Table 2):
// R(0.708,0.292), G(0.170,0.797), B(0.131,0.046), Wd65(0.3127,0.3290).
// Standard chromaticity -> RGB->XYZ construction (Poynton's Color FAQ
// SS "The transformation from RGB to CIE XYZ"):
//
//   Xc = xc/yc, Yc = 1, Zc = (1 - xc - yc)/yc   for c in {r, g, b, w}
//   M  = [[Xr,Xg,Xb], [Yr,Yg,Yb], [Zr,Zg,Zb]] ;  S = M^-1 . [Xw,Yw,Zw]^T
//   RGB->XYZ = M . diag(S)
//
// Zr = (1 - 0.708 - 0.292)/0.292 = 0 exactly (R's xy sums to unity),
// which is why matrix cell [6] below is exactly 0.0 -- not a rounding
// artifact: computed with exact rational arithmetic (Python
// `fractions.Fraction`), rounded once to the nearest binary64. XYZ->RGB
// is this matrix's exact algebraic inverse (round-trip verified).
//
// Bradford chromatic adaptation (D65<->D50) follows the standard
// Bradford cone-response formulation (Lam 1985; the same matrices ICC
// v4 / LittleCMS use to bridge a D65 working space to the D50 PCS):
//
//   MA = [[0.8951,0.2664,-0.1614],[-0.7502,1.7135,0.0367],[0.0389,-0.0685,1.0296]]
//   rho/gamma/beta_{src,dst} = MA . White_{src,dst}
//   Adapt = MA^-1 . diag(rho_dst/rho_src, gamma_dst/gamma_src, beta_dst/beta_src) . MA
//
// using CIE reference whites D65=(0.95047,1,1.08883), D50=(0.96422,1,
// 0.82521). D65_TO_D50 and D50_TO_D65 are exact algebraic inverses
// (round-trip verified). All 36 cells were computed once and pinned
// as fixed constants; nothing here recomputes them at runtime.
//
// Each matrix is a row-major `[u64; 9]` of f64 bit patterns:
//   RGB_TO_XYZ:          [X;Y;Z]    = M . [R;G;B]
//   XYZ_TO_RGB:          [R;G;B]    = M . [X;Y;Z]
//   BRADFORD_D65_TO_D50: [Xd;Yd;Zd] = M . [Xs;Ys;Zs]   (src white D65)
//   BRADFORD_D50_TO_D65: [Xd;Yd;Zd] = M . [Xs;Ys;Zs]   (src white D50)
//   idx 0,1,2 / 3,4,5 / 6,7,8 = row 0 / row 1 / row 2
//
// =============================================================================
// SECTION 2  FAILURE TAXONOMY 0xFFFFE8F0..0xFFFFE8FF
// =============================================================================
//
//   0xFFFFE8FF  BT21_NULL                 -- out_ptr is 0
//   0xFFFFE8FE  BT21_INVALID_TRIPLE       -- an input bit pattern's exponent
//                                            field is all-ones (Inf or NaN)
//   0xFFFFE8FD  BT21_MATRIX_UNAVAILABLE   -- unknown matrix id or
//                                            out-of-range cell index
//   0xFFFFE8FC  BT21_OUT_OF_GAMUT         -- bt2100_xyz_to_rgb: result
//                                            written, but some channel falls
//                                            outside [0.0, 1.0]
//   0xFFFFE8FB  BT21_ADAPTATION_UNDEFINED -- bt2100_bradford_adapt: unknown
//                                            direction ordinal
//   0xFFFFE8FA  BT21_REFUSED_DENSE        -- RESERVED, not emitted this
//                                            landing (see note below)
//   0xFFFFE8F9  BT21_NOT_INIT             -- RESERVED, not emitted this
//                                            landing (see note below)
//
// BT21_REFUSED_DENSE and BT21_NOT_INIT are reserved per the issue's
// namespace directive but have no live emitter this landing: the API
// is scalar-triple-only (one pixel/one XYZ point per call) and the
// matrices are fixed compile-time constants with nothing to "install",
// so neither a dense/batch refusal nor an init gate has a genuine
// caller yet. A future dense (N-at-once) entry point, or a future
// custom-primaries variant requiring an install step, would be the
// first real emitter of each -- the "declared but not emitted"
// convention this codebase already uses (e.g. klog/keys.pdx
// tag_sys_taskinfo_ok). 0xFFFFE8F0..0xFFFFE8F8 stay free for later use.
//
// DOWNSTREAM: the compositor paint pipeline and the HDR settings panel
// are the two named future consumers; neither is wired at this
// landing, so no boot witness exercises this file and its fingerprint
// tag is allowlisted in tools/verify-fingerprint-coverage.sh (data-
// only decl, same posture as this G6 wave's sibling schema-seed
// landings).

module Bt2100Gamut = structure {

  // -- fingerprint ------------------------------------------------------
  pub let pdx_kind_bt2100_gamut_meta : [u8; 52] = "bt2100 gamut init ok [legacy: BT2100 GAMUT INIT OK]\0"

  // -- ordinals & error codes --------------------------------------------
  pub let BT21_OK                    : u64 = 0
  pub let BT21_NULL                  : u64 = 0xFFFFE8FF
  pub let BT21_INVALID_TRIPLE        : u64 = 0xFFFFE8FE
  pub let BT21_MATRIX_UNAVAILABLE    : u64 = 0xFFFFE8FD
  pub let BT21_OUT_OF_GAMUT          : u64 = 0xFFFFE8FC
  pub let BT21_ADAPTATION_UNDEFINED  : u64 = 0xFFFFE8FB
  pub let BT21_REFUSED_DENSE         : u64 = 0xFFFFE8FA
  pub let BT21_NOT_INIT              : u64 = 0xFFFFE8F9

  // -- matrix ids (for bt2100_matrix_cell) --------------------------------
  pub let BT21_MATRIX_RGB_TO_XYZ           : u64 = 0
  pub let BT21_MATRIX_XYZ_TO_RGB           : u64 = 1
  pub let BT21_MATRIX_BRADFORD_D65_TO_D50  : u64 = 2
  pub let BT21_MATRIX_BRADFORD_D50_TO_D65  : u64 = 3
  pub let BT21_MATRIX_COUNT                : u64 = 4
  pub let BT21_MATRIX_CELLS                : u64 = 9

  // -- adaptation direction ids (for bt2100_bradford_adapt) ---------------
  pub let BT21_ADAPT_D65_TO_D50      : u64 = 0
  pub let BT21_ADAPT_D50_TO_D65      : u64 = 1

  // =========================================================================
  // Matrix constants -- row-major [u64; 9] f64 bit patterns. See SECTION 1
  // for derivation and SECTION 2 for layout. Values verified to round-trip
  // (RGB->XYZ->RGB and D65->D50->D65 both recover the input exactly, to
  // full binary64 precision) at derivation time.
  // =========================================================================

  // RGB->XYZ, BT.2100 primaries + D65 white (ITU-R BT.2100-2 SS5.3).
  pub let _bt2100_rgb_to_xyz : [u64; 9] = [
    0x3FE461F5D84C18DC,  // [0,0] X-from-R =  0.6369580483012913
    0x3FC282CE83ACFF98,  // [0,1] X-from-G =  0.1446169035862084
    0x3FC59DE44C9F941A,  // [0,2] X-from-B =  0.1688809751641720
    0x3FD0D0148CCF66F2,  // [1,0] Y-from-R =  0.2627002120112670
    0x3FE5B22902FD967D,  // [1,1] Y-from-G =  0.6779980715188710
    0x3FAE5CCB69AB60A2,  // [1,2] Y-from-B =  0.0593017164698619
    0x0000000000000000,  // [2,0] Z-from-R =  0.0000000000000000 (exact)
    0x3F9CBF168A39D534,  // [2,1] Z-from-G =  0.0280726930490875
    0x3FF0F9CB77C699AE,  // [2,2] Z-from-B =  1.0609850577107909
  ]

  // XYZ->RGB, exact algebraic inverse of the matrix above.
  pub let _bt2100_xyz_to_rgb : [u64; 9] = [
    0x3FFB77673C6F9E48,  // [0,0] R-from-X =  1.7166511879712676
    0xBFD6C34F641D9634,  // [0,1] R-from-Y = -0.3556707837763924
    0xBFD03727351A2D1A,  // [0,2] R-from-Z = -0.2533662813736598
    0xBFE5557A6BFC0414,  // [1,0] G-from-X = -0.6666843518324890
    0x3FF9DD1B6DDF1D7E,  // [1,1] G-from-Y =  1.6164812366349390
    0x3F9025A1324E0E31,  // [1,2] G-from-Z =  0.0157685458139111
    0x3F92102ECB55B8BA,  // [2,0] B-from-X =  0.0176398574453109
    0xBFA5E607A2582455,  // [2,1] B-from-Y = -0.0427706132578087
    0x3FEE25B571E54EEC,  // [2,2] B-from-Z =  0.9421031212354740
  ]

  // Bradford chromatic adaptation, D65 (video/display-referred white)
  // -> D50 (ICC v4 Profile Connection Space white).
  pub let _bt2100_bradford_d65_to_d50 : [u64; 9] = [
    0x3FF0C3D5B8FE74BB,  // [0,0]  1.0478112436606313
    0x3F976F95E4B3A25B,  // [0,1]  0.0228866024816930
    0xBFA9AA3E34DD4A92,  // [0,2] -0.0501269759685289
    0x3F9E405CCA038212,  // [1,0]  0.0295423982905750
    0x3FEFB20C5906106E,  // [1,1]  0.9904844034904394
    0xBF917551709C6ED1,  // [1,2] -0.0170490956289616
    0xBF82E9883ADADA9F,  // [2,0] -0.0092344897233095
    0x3F8ECF30112210BD,  // [2,1]  0.0150436167934987
    0x3FE811765D14D04A,  // [2,2]  0.7521316354746059
  ]

  // Bradford chromatic adaptation, D50 -> D65. Exact algebraic inverse
  // of the matrix above.
  pub let _bt2100_bradford_d50_to_d65 : [u64; 9] = [
    0x3FEE941568CC7756,  // [0,0]  0.9555766150331049
    0xBF9797A0404EAC4A,  // [0,1] -0.0230393447160789
    0x3FB02B7DE6CF3941,  // [0,2]  0.0631636322498013
    0xBF9CF7EF2D6116D6,  // [1,0] -0.0282895442435550
    0x3FF028B88A97A70B,  // [1,1]  1.0099416173711144
    0x3F958307DCB278B3,  // [1,2]  0.0210076549961904
    0x3F892FC7DC7315A1,  // [2,0]  0.0122981657172073
    0xBF94F9808DFC6DE7,  // [2,1] -0.0204830252324494
    0x3FF5474F86B3B11E,  // [2,2]  1.3299098264497569
  ]

  // ---------------------------------------------------------------------------
  // Section 4  Pure register-only helpers (no memory access)
  // ---------------------------------------------------------------------------

  // bt2100_is_nonfinite(bits) -> 1 iff the binary64 exponent field
  // (bits 52..62) is all-ones (Inf or NaN payload), else 0. Every
  // public conversion function below rejects non-finite inputs with
  // BT21_INVALID_TRIPLE rather than propagating a NaN/Inf through the
  // matrix multiply -- this codebase has no FPU exception handler
  // wired (see design/kernel/no-fpu.md), so a silent NaN propagation
  // would surface as a mystifying garbage result far from its cause.
  pub let bt2100_is_nonfinite : (u64) -> u64 !{} @{} =
    fn (bits: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B15 G6-M2-001 (#2241): exponent-all-ones (Inf/NaN) guard. shr+and(imm32) extracts the 11-bit exponent field; 0x7FF fits an imm32 so the 'no and r11,imm64' pitfall does not apply here. Leaf, no calls, no push/pop needed.",
      block: {
        mov r10, rdi;
        shr r10, 52;
        and r10, 0x7FF;
        cmp r10, 0x7FF;
        jne bt21_nf_ok;
        mov rax, 1;
        ret;
      bt21_nf_ok:
        xor rax, rax;
        ret
      }
    }

  // bt2100_in_unit_interval(bits) -> 1 iff the binary64 value decodes
  // to a number in [0.0, 1.0], else 0. Used by bt2100_xyz_to_rgb's
  // gamut check. ucomisd sets CF/ZF/PF per an unsigned-style compare;
  // jb/ja read those flags exactly as SDM Vol 1 SS4.2.1 documents for
  // COMISD/UCOMISD, which is why the branches below use the unsigned
  // conditional jump mnemonics rather than a signed jl/jg.
  pub let bt2100_in_unit_interval : (u64) -> u64 !{} @{} =
    fn (bits: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B15 G6-M2-001 (#2241): [0,1] bound check via ucomisd against bitcast 0.0/1.0. Leaf, no calls, no push/pop needed.",
      block: {
        movq_ld xmm0, rdi;
        mov r10, 0;
        movq_ld xmm1, r10;
        ucomisd xmm0, xmm1;
        jb  bt21_iu_no;
        mov r10, 0x3FF0000000000000;
        movq_ld xmm1, r10;
        ucomisd xmm0, xmm1;
        ja  bt21_iu_no;
        mov rax, 1;
        ret;
      bt21_iu_no:
        xor rax, rax;
        ret
      }
    }

  // bt2100_dot3(a0, a1, a2, b0, b1, b2) -> (a0*b0 + a1*b1 + a2*b2) as an
  // f64 bit pattern. The one arithmetic primitive every matrix-vector
  // multiply below is built from -- a 3x3 . 3x1 product is three calls
  // to this per output triple. SysV maps the six u64 params to
  // rdi/rsi/rdx/rcx/r8/r9 (exactly the 6-register integer-arg budget;
  // this sits at, not over, the unsafe-lambda arity cap). Leaf, no
  // calls, no push/pop needed.
  pub let bt2100_dot3 : (u64, u64, u64, u64, u64, u64) -> u64 !{} @{} =
    fn (a0: u64) (a1: u64) (a2: u64) (b0: u64) (b1: u64) (b2: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B15 G6-M2-001 (#2241): 3-term dot product via the movq_ld/mulsd/addsd/movq_st bitcast dance (paideia-as v0.24 scalar-SSE substrate is register-register only, SECTION 0). xmm0 accumulates; xmm1..xmm5 are scratch. No memory access.",
      block: {
        movq_ld xmm0, rdi;
        movq_ld xmm1, rcx;
        mulsd xmm0, xmm1;

        movq_ld xmm2, rsi;
        movq_ld xmm3, r8;
        mulsd xmm2, xmm3;
        addsd xmm0, xmm2;

        movq_ld xmm4, rdx;
        movq_ld xmm5, r9;
        mulsd xmm4, xmm5;
        addsd xmm0, xmm4;

        movq_st rax, xmm0;
        ret
      }
    }

  // ---------------------------------------------------------------------------
  // Section 5  RGB <-> XYZ conversion
  // ---------------------------------------------------------------------------

  // bt2100_rgb_to_xyz(r_bits, g_bits, b_bits, out_ptr) -> BT21_OK | error.
  // Writes the XYZ triple (X, Y, Z f64 bit patterns, 8 bytes each) to
  // out_ptr[0], out_ptr[8], out_ptr[16] on success. On BT21_NULL or
  // BT21_INVALID_TRIPLE, out_ptr is left untouched -- a fabricated
  // triple would let a caller that ignores the return code silently
  // proceed with garbage (same discipline as tmk_sample_stub).
  //
  // Five-push discipline (rbx/r12/r13/r14/r15) keeps rsp%16 == 0
  // before every inner call, matching this codebase's odd-parity
  // convention (entry rsp%16 == 8; 5 pushes -> 48 total -> 0 mod 16).
  pub let bt2100_rgb_to_xyz : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (r_bits: u64) (g_bits: u64) (b_bits: u64) (out_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B15 G6-M2-001 (#2241): RGB->XYZ via _bt2100_rgb_to_xyz row-major matrix, three bt2100_dot3 calls (one per output channel). Rejects a null out_ptr and any non-finite input channel before touching the matrix. Five-push discipline for call-safety.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        mov rbx, rdi;
        mov r12, rsi;
        mov r13, rdx;
        mov r14, rcx;

        cmp r14, 0;
        je  bt21_r2x_null;

        mov rdi, rbx;
        call bt2100_is_nonfinite;
        cmp rax, 0;
        jne bt21_r2x_invalid;
        mov rdi, r12;
        call bt2100_is_nonfinite;
        cmp rax, 0;
        jne bt21_r2x_invalid;
        mov rdi, r13;
        call bt2100_is_nonfinite;
        cmp rax, 0;
        jne bt21_r2x_invalid;

        lea r15, [rip + _bt2100_rgb_to_xyz];

        // X = row 0 . (r, g, b)
        mov rdi, [r15 + 0];
        mov rsi, [r15 + 8];
        mov rdx, [r15 + 16];
        mov rcx, rbx;
        mov r8, r12;
        mov r9, r13;
        call bt2100_dot3;
        mov [r14 + 0], rax;

        // Y = row 1 . (r, g, b)
        mov rdi, [r15 + 24];
        mov rsi, [r15 + 32];
        mov rdx, [r15 + 40];
        mov rcx, rbx;
        mov r8, r12;
        mov r9, r13;
        call bt2100_dot3;
        mov [r14 + 8], rax;

        // Z = row 2 . (r, g, b)
        mov rdi, [r15 + 48];
        mov rsi, [r15 + 56];
        mov rdx, [r15 + 64];
        mov rcx, rbx;
        mov r8, r12;
        mov r9, r13;
        call bt2100_dot3;
        mov [r14 + 16], rax;

        xor rax, rax;
        jmp bt21_r2x_out;

      bt21_r2x_null:
        mov rax, 0xFFFFE8FF;
        jmp bt21_r2x_out;

      bt21_r2x_invalid:
        mov rax, 0xFFFFE8FE;

      bt21_r2x_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // bt2100_xyz_to_rgb(x_bits, y_bits, z_bits, out_ptr) -> BT21_OK |
  // BT21_OUT_OF_GAMUT | error. Writes the RGB triple to out_ptr[0..24]
  // via _bt2100_xyz_to_rgb, then checks all three channels against
  // [0.0, 1.0]. BT21_OUT_OF_GAMUT is returned when a channel falls
  // outside that range, but the (already-computed) triple is still
  // written -- a future gamut-mapping consumer needs the raw value,
  // not a refusal, to do anything useful with it. Same five-push
  // discipline as bt2100_rgb_to_xyz.
  pub let bt2100_xyz_to_rgb : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (x_bits: u64) (y_bits: u64) (z_bits: u64) (out_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B15 G6-M2-001 (#2241): XYZ->RGB via _bt2100_xyz_to_rgb row-major matrix + post-hoc gamut check (bt2100_in_unit_interval x3). Rejects null out_ptr / non-finite input before computing; writes the triple unconditionally once computed and reports BT21_OUT_OF_GAMUT without withholding data. Five-push discipline for call-safety.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        mov rbx, rdi;
        mov r12, rsi;
        mov r13, rdx;
        mov r14, rcx;

        cmp r14, 0;
        je  bt21_x2r_null;

        mov rdi, rbx;
        call bt2100_is_nonfinite;
        cmp rax, 0;
        jne bt21_x2r_invalid;
        mov rdi, r12;
        call bt2100_is_nonfinite;
        cmp rax, 0;
        jne bt21_x2r_invalid;
        mov rdi, r13;
        call bt2100_is_nonfinite;
        cmp rax, 0;
        jne bt21_x2r_invalid;

        lea r15, [rip + _bt2100_xyz_to_rgb];

        // R = row 0 . (x, y, z)
        mov rdi, [r15 + 0];
        mov rsi, [r15 + 8];
        mov rdx, [r15 + 16];
        mov rcx, rbx;
        mov r8, r12;
        mov r9, r13;
        call bt2100_dot3;
        mov [r14 + 0], rax;

        // G = row 1 . (x, y, z)
        mov rdi, [r15 + 24];
        mov rsi, [r15 + 32];
        mov rdx, [r15 + 40];
        mov rcx, rbx;
        mov r8, r12;
        mov r9, r13;
        call bt2100_dot3;
        mov [r14 + 8], rax;

        // B = row 2 . (x, y, z)
        mov rdi, [r15 + 48];
        mov rsi, [r15 + 56];
        mov rdx, [r15 + 64];
        mov rcx, rbx;
        mov r8, r12;
        mov r9, r13;
        call bt2100_dot3;
        mov [r14 + 16], rax;

        // Gamut check -- reload the just-stored triple, one channel
        // per bt2100_in_unit_interval call. r14 (out_ptr) survives
        // across every call above and below (callee-saved).
        mov rdi, [r14 + 0];
        call bt2100_in_unit_interval;
        cmp rax, 0;
        je  bt21_x2r_oog;
        mov rdi, [r14 + 8];
        call bt2100_in_unit_interval;
        cmp rax, 0;
        je  bt21_x2r_oog;
        mov rdi, [r14 + 16];
        call bt2100_in_unit_interval;
        cmp rax, 0;
        je  bt21_x2r_oog;

        xor rax, rax;
        jmp bt21_x2r_out;

      bt21_x2r_null:
        mov rax, 0xFFFFE8FF;
        jmp bt21_x2r_out;

      bt21_x2r_invalid:
        mov rax, 0xFFFFE8FE;
        jmp bt21_x2r_out;

      bt21_x2r_oog:
        mov rax, 0xFFFFE8FC;

      bt21_x2r_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ---------------------------------------------------------------------------
  // Section 6  D65 <-> D50 Bradford chromatic adaptation
  // ---------------------------------------------------------------------------

  // bt2100_bradford_d65_to_d50(x_bits, y_bits, z_bits, out_ptr) ->
  // BT21_OK | error. XYZ tristimulus values are not gamut-bounded to
  // [0, 1] (an HDR scene's Y routinely exceeds 1), so unlike
  // bt2100_xyz_to_rgb there is no post-hoc range check here -- only
  // the null-pointer and non-finite-input guards. Same five-push /
  // three-dot3-call shape as the RGB<->XYZ pair above.
  pub let bt2100_bradford_d65_to_d50 : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (x_bits: u64) (y_bits: u64) (z_bits: u64) (out_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B15 G6-M2-001 (#2241): D65->D50 Bradford adaptation via _bt2100_bradford_d65_to_d50. No gamut check -- XYZ tristimulus values are unbounded above 1.0 for HDR content. Five-push discipline for call-safety.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        mov rbx, rdi;
        mov r12, rsi;
        mov r13, rdx;
        mov r14, rcx;

        cmp r14, 0;
        je  bt21_d65_null;

        mov rdi, rbx;
        call bt2100_is_nonfinite;
        cmp rax, 0;
        jne bt21_d65_invalid;
        mov rdi, r12;
        call bt2100_is_nonfinite;
        cmp rax, 0;
        jne bt21_d65_invalid;
        mov rdi, r13;
        call bt2100_is_nonfinite;
        cmp rax, 0;
        jne bt21_d65_invalid;

        lea r15, [rip + _bt2100_bradford_d65_to_d50];

        mov rdi, [r15 + 0];
        mov rsi, [r15 + 8];
        mov rdx, [r15 + 16];
        mov rcx, rbx;
        mov r8, r12;
        mov r9, r13;
        call bt2100_dot3;
        mov [r14 + 0], rax;

        mov rdi, [r15 + 24];
        mov rsi, [r15 + 32];
        mov rdx, [r15 + 40];
        mov rcx, rbx;
        mov r8, r12;
        mov r9, r13;
        call bt2100_dot3;
        mov [r14 + 8], rax;

        mov rdi, [r15 + 48];
        mov rsi, [r15 + 56];
        mov rdx, [r15 + 64];
        mov rcx, rbx;
        mov r8, r12;
        mov r9, r13;
        call bt2100_dot3;
        mov [r14 + 16], rax;

        xor rax, rax;
        jmp bt21_d65_out;

      bt21_d65_null:
        mov rax, 0xFFFFE8FF;
        jmp bt21_d65_out;

      bt21_d65_invalid:
        mov rax, 0xFFFFE8FE;

      bt21_d65_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // bt2100_bradford_d50_to_d65 -- mirror of the above, via
  // _bt2100_bradford_d50_to_d65 (the exact algebraic inverse matrix).
  pub let bt2100_bradford_d50_to_d65 : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (x_bits: u64) (y_bits: u64) (z_bits: u64) (out_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B15 G6-M2-001 (#2241): D50->D65 Bradford adaptation via _bt2100_bradford_d50_to_d65. No gamut check, same rationale as the d65_to_d50 sibling. Five-push discipline for call-safety.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        mov rbx, rdi;
        mov r12, rsi;
        mov r13, rdx;
        mov r14, rcx;

        cmp r14, 0;
        je  bt21_d50_null;

        mov rdi, rbx;
        call bt2100_is_nonfinite;
        cmp rax, 0;
        jne bt21_d50_invalid;
        mov rdi, r12;
        call bt2100_is_nonfinite;
        cmp rax, 0;
        jne bt21_d50_invalid;
        mov rdi, r13;
        call bt2100_is_nonfinite;
        cmp rax, 0;
        jne bt21_d50_invalid;

        lea r15, [rip + _bt2100_bradford_d50_to_d65];

        mov rdi, [r15 + 0];
        mov rsi, [r15 + 8];
        mov rdx, [r15 + 16];
        mov rcx, rbx;
        mov r8, r12;
        mov r9, r13;
        call bt2100_dot3;
        mov [r14 + 0], rax;

        mov rdi, [r15 + 24];
        mov rsi, [r15 + 32];
        mov rdx, [r15 + 40];
        mov rcx, rbx;
        mov r8, r12;
        mov r9, r13;
        call bt2100_dot3;
        mov [r14 + 8], rax;

        mov rdi, [r15 + 48];
        mov rsi, [r15 + 56];
        mov rdx, [r15 + 64];
        mov rcx, rbx;
        mov r8, r12;
        mov r9, r13;
        call bt2100_dot3;
        mov [r14 + 16], rax;

        xor rax, rax;
        jmp bt21_d50_out;

      bt21_d50_null:
        mov rax, 0xFFFFE8FF;
        jmp bt21_d50_out;

      bt21_d50_invalid:
        mov rax, 0xFFFFE8FE;

      bt21_d50_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // bt2100_bradford_adapt(direction, x_bits, y_bits, z_bits, out_ptr)
  // -> BT21_OK | BT21_ADAPTATION_UNDEFINED | error. Convenience
  // dispatcher over the two direction-specific functions above, for a
  // caller that carries the direction as a runtime value (e.g. a
  // color-managed pipeline stage parameterised by profile PCS) rather
  // than picking the function at compile time. Pure tail-forward: no
  // callee-saved registers are needed, just a `sub rsp, 8` / `add rsp,
  // 8` pad to keep rsp%16 == 0 across the single forwarded call (the
  // sub/add-rsp idiom, not a bare push-reg/call/pop-reg pair, per this
  // codebase's alignment-padding convention).
  pub let bt2100_bradford_adapt : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (direction: u64) (x_bits: u64) (y_bits: u64) (z_bits: u64) (out_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B15 G6-M2-001 (#2241): direction-keyed dispatch to bt2100_bradford_d65_to_d50 / bt2100_bradford_d50_to_d65. Register shuffle (rdi<-rsi<-rdx<-rcx<-r8) forwards (x,y,z,out_ptr) after consuming direction; each source register is read before being overwritten so the chain is safe. sub/add rsp,8 pads alignment for the single forwarded call.",
      block: {
        sub rsp, 8;

        cmp rdi, 0;
        je  bt21_ba_d65;
        cmp rdi, 1;
        je  bt21_ba_d50;

        mov rax, 0xFFFFE8FB;
        jmp bt21_ba_out;

      bt21_ba_d65:
        mov rdi, rsi;
        mov rsi, rdx;
        mov rdx, rcx;
        mov rcx, r8;
        call bt2100_bradford_d65_to_d50;
        jmp bt21_ba_out;

      bt21_ba_d50:
        mov rdi, rsi;
        mov rsi, rdx;
        mov rdx, rcx;
        mov rcx, r8;
        call bt2100_bradford_d50_to_d65;

      bt21_ba_out:
        add rsp, 8;
        ret
      }
    }

  // ---------------------------------------------------------------------------
  // Section 7  Matrix introspection
  // ---------------------------------------------------------------------------

  // bt2100_matrix_cell(matrix_id, idx) -> f64 bit pattern |
  // BT21_MATRIX_UNAVAILABLE. Read-only accessor over the four fixed
  // matrices (BT21_MATRIX_* ids), for a caller that wants to inspect
  // or display the raw coefficients (e.g. a future HDR settings panel
  // showing the active gamut matrix) without duplicating the constant
  // tables. Leaf (no calls) -- rsp parity is irrelevant here.
  pub let bt2100_matrix_cell : (u64, u64) -> u64 !{mem} @{} =
    fn (matrix_id: u64) (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B15 G6-M2-001 (#2241): read-only cell accessor over the four fixed matrices. imul(3-op) computes the byte offset; straight-line cmp/je selects the base address; add reg,reg (not reg,[mem]) combines them before the single load.",
      block: {
        cmp rdi, 4;
        jae bt21_mc_bad;
        cmp rsi, 9;
        jae bt21_mc_bad;

        mov r10, rsi;
        imul r10, r10, 8;

        cmp rdi, 0;
        je  bt21_mc_m0;
        cmp rdi, 1;
        je  bt21_mc_m1;
        cmp rdi, 2;
        je  bt21_mc_m2;

        lea r11, [rip + _bt2100_bradford_d50_to_d65];
        jmp bt21_mc_load;

      bt21_mc_m0:
        lea r11, [rip + _bt2100_rgb_to_xyz];
        jmp bt21_mc_load;

      bt21_mc_m1:
        lea r11, [rip + _bt2100_xyz_to_rgb];
        jmp bt21_mc_load;

      bt21_mc_m2:
        lea r11, [rip + _bt2100_bradford_d65_to_d50];

      bt21_mc_load:
        add r11, r10;
        mov rax, [r11 + 0];
        ret;

      bt21_mc_bad:
        mov rax, 0xFFFFE8FD;
        ret
      }
    }
}
