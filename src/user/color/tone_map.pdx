// src/user/color/tone_map.pdx -- Wave0-B15 G6-M2-002 (paideia-os #2239)
//
// Reference HDR->SDR tone-mapping curves: the Uncharted 2 ("Hable")
// filmic operator that ITU-R BT.2408-6 Annex 5 cites as a display-
// referred creative-intent example, plus the classic and extended
// Reinhard operators (Reinhard, Stark, Shirley & Ferwerda, "Photographic
// Tone Reproduction for Digital Images", SIGGRAPH 2002, eqs. 3/4).
//
// This module is DATA-ONLY + PURE-COMPUTATION: every entry point is a
// leaf-ish function of its scalar f64 argument(s), with no installed
// state, no capability, and no device-facing wire. The paint-pipeline
// consumer that actually walks a frame's HDR luminance through one of
// these curves on the way to an SDR sink is a FUTURE landing (tracked
// against the failure-taxonomy reservations in SECTION 2 below); this
// landing exists so that future consumer can pick, per scene, whichever
// curve reads better -- Hable's toe-and-shoulder filmic rolloff for
// high-key/specular content, or Reinhard's simpler monotonic rolloff
// for balanced/technical content -- without paying for a second
// round-trip through the type system to add the option later.
//
// =============================================================================
// SECTION 0  THE TWO CURVES, IN CLOSED FORM
// =============================================================================
//
// -- Hable (Uncharted 2) filmic --------------------------------------------
//
// John Hable's 2010 GDC talk operator, built from Jim Hejl & Richard
// Burgess-Dawson's earlier film-emulation curve. The raw (un-normalized)
// per-channel operator is:
//
//   Hable(x) = ((x*(A*x + C*B) + D*E) / (x*(A*x + B) + D*F)) - E/F
//
// with the standard constants this module hard-codes:
//
//   A = 0.15   B = 0.50   C = 0.10   D = 0.20   E = 0.02   F = 0.30
//
// Hable(x) alone is not white-balanced -- Hable(1.0) != 1.0 -- so the
// operator is always applied relative to a reference white point W:
//
//   tone_map_hable(x) = Hable(x) / Hable(W)          W = 11.2
//
// W = 11.2 is Hable's own published constant (chosen so that an input
// of relative linear-scene-white maps back out near 1.0 after the
// division). Because A, B, D, F are all positive constants and this
// module's `tm_validate_nonneg` gate rejects negative x before either
// Hable() evaluation runs, the denominator x*(A*x+B)+D*F is a sum of
// non-negative terms plus the strictly-positive constant D*F = 0.06 --
// it can never reach zero, so the curve has no removable division-by-
// zero case to guard for finite, validated inputs.
//
// -- Reinhard, classic ------------------------------------------------------
//
//   tone_map_reinhard(L) = L / (1 + L)
//
// Simple, monotonic, no configurable white point: L=0 maps to 0, and
// the curve asymptotes to 1 as L -> infinity. Reinhard eq. 3.
//
// -- Reinhard, extended (with burn-out white point) -------------------------
//
//   tone_map_reinhard_extended(L, W) = (L * (1 + L / W^2)) / (1 + L)
//
// W ("Lwhite" in the paper) is the smallest luminance that should map
// to pure white -- Reinhard eq. 4. A caller-supplied W of exactly zero
// (positive or negative zero) is rejected as TM_WHITE_POINT_ZERO rather
// than silently producing a divide-by-zero inside L/W^2.
//
// =============================================================================
// SECTION 1  THE f64-LITERAL WORKAROUND
// =============================================================================
//
// paideia-as's scalar-SSE encoder substrate (paideia-as#1333, landed at
// v0.24.0) gives raw `unsafe` blocks direct access to the legacy-SSE
// register-register mnemonics -- movsd/addsd/subsd/mulsd/divsd/movq_ld/
// movq_st and friends -- but the parser/typer front-end for an actual
// `f64` source-level literal (`let x: f64 = 1.5;`) is explicitly called
// out in that release's own changelog as the deferred remaining piece.
// There is also no memory-operand scalar-float form (`movsd xmm,[mem]`)
// -- every SSE mnemonic here is register-register only.
//
// The workaround (same shape as B15-04 bt2100_gamut.pdx uses): every f64
// constant this module needs is pre-computed off-line to its raw IEEE
// 754 binary64 bit pattern and stored as a plain `u64` in a `pub let`
// array (`_tm_f64_consts`, declared just inside the module below). At
// runtime, a constant is loaded in two steps -- an ordinary
// `mov r64, [rip + table + idx*8]`
// GPR load, then a `movq_ld xmmN, r64` bitcast into the SSE register
// file -- rather than ever appearing as a float literal in the asm text.
// A result is likewise read back out via `movq_st r64, xmmN` before it
// is returned in `rax` (this module's public ABI surface is `u64`
// bit-pattern in, `u64` bit-pattern out; the caller bitcasts to/from an
// `f64` binding on its own side, once the language surface supports one).
//
// =============================================================================
// SECTION 2  FAILURE TAXONOMY 0xFFFFE900..0xFFFFE90F
// =============================================================================
//
//   0xFFFFE90F  TM_NULL              -- reserved: a future pointer-taking
//                                       bulk/LUT API's null-pointer guard.
//                                       No entry point in this landing
//                                       takes a pointer argument.
//   0xFFFFE90E  TM_MODE_INVALID      -- tone_map_curve_select's mode is
//                                       not one of TM_MODE_HABLE (0),
//                                       TM_MODE_REINHARD (1), or
//                                       TM_MODE_REINHARD_EXT (2).
//   0xFFFFE90D  TM_INPUT_NAN         -- input bit pattern's exponent
//                                       field is all-ones (covers both
//                                       NaN and +-Infinity -- neither has
//                                       a meaningful tone-mapped value).
//   0xFFFFE90C  TM_INPUT_NEG         -- input is a genuine negative
//                                       finite value (sign bit set and
//                                       magnitude nonzero; -0.0 is NOT
//                                       rejected here -- IEEE 754 treats
//                                       -0.0 == +0.0, and this module
//                                       does likewise).
//   0xFFFFE90B  TM_WHITE_POINT_ZERO  -- tone_map_reinhard_extended's W
//                                       argument is +-0.0 (its square
//                                       would divide L/W^2 by zero).
//   0xFFFFE90A  TM_REFUSED_DENSE     -- reserved: a future dense-LUT
//                                       install path's refusal code (see
//                                       hdr10_transform.pdx's PQ OETF row
//                                       for the shape such a table would
//                                       take). This landing is pure
//                                       computation with no table to
//                                       install, so nothing returns this
//                                       code yet.
//   0xFFFFE909  TM_NOT_INIT          -- reserved: a future install-gated
//                                       consumer wire's "not installed
//                                       yet" code, mirroring hdr10_
//                                       transform.pdx's HDR10_NOT_
//                                       INSTALLED. This landing installs
//                                       nothing, so every entry point is
//                                       always "ready".
//
// The three reserved-but-unused codes (TM_NULL, TM_REFUSED_DENSE,
// TM_NOT_INIT) are declared now so the failure band stays a single
// contiguous, pre-registered allocation across this landing and its
// paint-pipeline follow-up, rather than growing a second disjoint band
// later. TM_MODE_INVALID, TM_INPUT_NAN, TM_INPUT_NEG, and TM_WHITE_
// POINT_ZERO are actively returned by the functions below.
//
// =============================================================================

module ToneMap = structure {

  // -- fingerprint ------------------------------------------------------
  //
  // A future witness/smoke test emits this via sys_debug_puts once a
  // boot-reachable caller exists (the paint-pipeline consumer wire,
  // still a future landing per this file's module-header note); until
  // then this is a data-only declaration, same posture as several sibling G6/G7-
  // G12 "meta" fingerprints already allowlisted in tools/verify-
  // fingerprint-coverage.sh. Line ends in `[legacy: TONE MAP INIT OK]`
  // per the fingerprint convention (klog/keys.pdx and user/init.pdx §5).
  pub let pdx_kind_tone_map_meta : [u8; 44] = "tone map init ok [legacy: TONE MAP INIT OK]\0"

  // -- mode ordinals ------------------------------------------------------

  pub let TM_MODE_HABLE        : u64 = 0
  pub let TM_MODE_REINHARD     : u64 = 1
  pub let TM_MODE_REINHARD_EXT : u64 = 2

  // -- failure taxonomy (ordinals; see the header comment's SECTION 2 for
  //    the per-code description) -----------------------------------------

  pub let TM_OK                : u64 = 0
  pub let TM_NULL              : u64 = 0xFFFFE90F  // reserved, see SECTION 2
  pub let TM_MODE_INVALID      : u64 = 0xFFFFE90E
  pub let TM_INPUT_NAN         : u64 = 0xFFFFE90D
  pub let TM_INPUT_NEG         : u64 = 0xFFFFE90C
  pub let TM_WHITE_POINT_ZERO  : u64 = 0xFFFFE90B
  pub let TM_REFUSED_DENSE     : u64 = 0xFFFFE90A  // reserved, see SECTION 2
  pub let TM_NOT_INIT          : u64 = 0xFFFFE909  // reserved, see SECTION 2

  // -- f64 bit-pattern constant table ------------------------------------
  //
  // Eight IEEE 754 binary64 constants, each pre-computed off-line to its
  // raw bit pattern (see SECTION 1's f64-literal-workaround note). Row
  // order is [ONE, A, B, C, D, E, F, W] so that a load is a single
  // `mov r64, [rip + _tm_f64_consts + idx*8]`; the TM_IDX_* ordinals
  // below document idx for each row without paideia-as ever resolving
  // them symbolically inside an unsafe block (the asm hard-codes the
  // byte offset idx*8 directly, same convention hdr10_transform.pdx's
  // HDR10_ST_* stat-slot ordinals use).
  //
  //   idx 0  ONE = 1.0                 = 0x3FF0000000000000
  //   idx 1  A   = 0.15  (Hable)       = 0x3FC3333333333333
  //   idx 2  B   = 0.50  (Hable)       = 0x3FE0000000000000
  //   idx 3  C   = 0.10  (Hable)       = 0x3FB999999999999A
  //   idx 4  D   = 0.20  (Hable)       = 0x3FC999999999999A
  //   idx 5  E   = 0.02  (Hable)       = 0x3F947AE147AE147B
  //   idx 6  F   = 0.30  (Hable)       = 0x3FD3333333333333
  //   idx 7  W   = 11.2  (Hable white) = 0x4026666666666666
  //
  // 0.0's bit pattern is the all-zero u64 and needs no table row -- every
  // site that needs a zero f64 constructs it with `xor r, r` before the
  // `movq_ld` bitcast, which is strictly cheaper than a table load.
  pub let _tm_f64_consts : [u64; 8] = [
    0x3FF0000000000000, 0x3FC3333333333333, 0x3FE0000000000000, 0x3FB999999999999A,
    0x3FC999999999999A, 0x3F947AE147AE147B, 0x3FD3333333333333, 0x4026666666666666
  ]

  pub let TM_IDX_ONE : u64 = 0
  pub let TM_IDX_A   : u64 = 1
  pub let TM_IDX_B   : u64 = 2
  pub let TM_IDX_C   : u64 = 3
  pub let TM_IDX_D   : u64 = 4
  pub let TM_IDX_E   : u64 = 5
  pub let TM_IDX_F   : u64 = 6
  pub let TM_IDX_W   : u64 = 7

  // ===========================================================================
  // SECTION 3  INPUT VALIDATION
  // ===========================================================================

  // tm_validate_nonneg(x_bits) -> TM_OK | TM_INPUT_NAN | TM_INPUT_NEG.
  //
  // Pure bit-pattern classification of an IEEE 754 binary64 -- no SSE
  // instruction is needed (and paideia-as has no `jp`/`jnp` conditional
  // jump to read the FPU parity flag a ucomisd-based NaN test would rely
  // on, so this sidesteps that gap entirely rather than working around
  // it). A leaf function: no CALLs, so no rsp%16 alignment concern and
  // no push/pop prologue.
  //
  //   1. exponent field (bits 52-62) all-ones -> NaN or +-Infinity ->
  //      TM_INPUT_NAN (neither has a meaningful tone-mapped value, so
  //      both share the one pre-allocated code rather than inventing a
  //      TM_INPUT_INF this module's failure band was not given).
  //   2. sign bit (bit 63) clear -> non-negative (or +0.0) -> TM_OK.
  //   3. sign bit set: -0.0 (magnitude, i.e. bits 0-62, all zero) is the
  //      sole accepted exception (IEEE 754 -0.0 == +0.0); any other
  //      sign-set pattern is a genuine negative -> TM_INPUT_NEG.
  pub let tm_validate_nonneg : (u64) -> u64 !{} @{} =
    fn (x: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B15 G6-M2-002 (#2239): pure bit-pattern NaN/Infinity + sign classification of an f64 bit pattern. Register-register AND only (mask constants are loaded into a scratch register via mov before each and, never and reg,imm64 directly) per the paideia-as encoder pitfall list. No jp/jnp mnemonic exists in this toolchain, so NaN detection uses the exponent-field bit test rather than a ucomisd self-compare + parity-flag branch. Every scratch register here (r8, r9, r10, r11, rax) is SysV caller-saved -- deliberately avoiding rbx/r12-r15/rbp, since every call site stashes its own live state in those across this call and a callee-saved register this leaf clobbered without a save/restore would corrupt it. Leaf function: no nested calls, so no rsp alignment concern.",
      block: {
        mov r10, rdi;

        // Non-finite check: exponent field all-ones.
        mov r11, 0x7FF0000000000000;
        mov rax, r10;
        and rax, r11;
        cmp rax, r11;
        je  tm_vn_nan;

        // Sign-bit check (bit 63).
        mov r9, 0x8000000000000000;
        mov rax, r10;
        and rax, r9;
        cmp rax, 0;
        je  tm_vn_ok;

        // Sign bit set: -0.0 is accepted; any other magnitude is negative.
        mov r8, 0x7FFFFFFFFFFFFFFF;
        mov rax, r10;
        and rax, r8;
        cmp rax, 0;
        je  tm_vn_ok;
        jmp tm_vn_neg;

      tm_vn_ok:
        xor rax, rax;
        ret;

      tm_vn_nan:
        mov rax, 0xFFFFE90D;
        ret;

      tm_vn_neg:
        mov rax, 0xFFFFE90C;
        ret
      }
    }

  // ===========================================================================
  // SECTION 4  HABLE (UNCHARTED 2) FILMIC CURVE
  // ===========================================================================

  // tm_hable_curve_raw(x_bits) -> Hable(x) bit pattern.
  //
  // The raw (un-normalized, un-validated) Uncharted 2 operator:
  //
  //   Hable(x) = ((x*(A*x+C*B)+D*E) / (x*(A*x+B)+D*F)) - E/F
  //
  // Internal helper: called both on the caller's (already-validated)
  // input and on the fixed white-point constant W, so it does not
  // itself validate x -- tone_map_hable validates the former and W is a
  // hard-coded positive constant that never needs validation. A leaf
  // function: no CALLs, so no rsp alignment concern.
  //
  // t = A*x is computed once (xmm7) and reused in both the numerator's
  // and denominator's inner term, matching the closed form's shared
  // sub-expression rather than recomputing A*x twice. C*B, D*E, and D*F
  // are likewise computed fresh from the stored primitives on every
  // call rather than pre-multiplied into additional stored constants --
  // this keeps _tm_f64_consts to exactly the eight named literals a
  // reviewer can check against the closed form above, at the cost of
  // three extra mulsd instructions this reference implementation does
  // not need to avoid.
  pub let tm_hable_curve_raw : (u64) -> u64 !{mem} @{} =
    fn (x: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B15 G6-M2-002 (#2239): Uncharted 2 filmic operator over the standard A/B/C/D/E/F constants, register-register SSE only (no memory-operand scalar-float form exists in this toolchain, so every constant is a GPR mov + movq_ld bitcast pair from _tm_f64_consts). Uses xmm0-xmm14 as pure per-call scratch (all SysV-caller-saved, no callee-save obligation) with each intermediate given its own register so the mul/add/div chain reads directly off the closed form in the header comment. Leaf function: no CALLs, so no rsp alignment concern and no GPR push/pop prologue.",
      block: {
        movq_ld xmm0, rdi;

        lea r10, [rip + _tm_f64_consts];
        mov r11, [r10 + 8];
        movq_ld xmm1, r11;              // xmm1 = A
        mov r11, [r10 + 16];
        movq_ld xmm2, r11;              // xmm2 = B
        mov r11, [r10 + 24];
        movq_ld xmm3, r11;              // xmm3 = C
        mov r11, [r10 + 32];
        movq_ld xmm4, r11;              // xmm4 = D
        mov r11, [r10 + 40];
        movq_ld xmm5, r11;              // xmm5 = E
        mov r11, [r10 + 48];
        movq_ld xmm6, r11;              // xmm6 = F

        // t = A*x.
        movsd xmm7, xmm1;
        mulsd xmm7, xmm0;               // xmm7 = t

        // num = x*(t + C*B) + D*E.
        movsd xmm8, xmm3;
        mulsd xmm8, xmm2;               // xmm8 = C*B
        movsd xmm9, xmm7;
        addsd xmm9, xmm8;               // xmm9 = t + C*B
        mulsd xmm9, xmm0;               // xmm9 = x*(t + C*B)
        movsd xmm10, xmm4;
        mulsd xmm10, xmm5;              // xmm10 = D*E
        addsd xmm9, xmm10;              // xmm9 = num

        // den = x*(t + B) + D*F.
        movsd xmm11, xmm7;
        addsd xmm11, xmm2;              // xmm11 = t + B
        mulsd xmm11, xmm0;              // xmm11 = x*(t + B)
        movsd xmm12, xmm4;
        mulsd xmm12, xmm6;              // xmm12 = D*F
        addsd xmm11, xmm12;             // xmm11 = den (strictly > 0, see SECTION 0)

        // result = num/den - E/F.
        movsd xmm13, xmm9;
        divsd xmm13, xmm11;             // xmm13 = num/den
        movsd xmm14, xmm5;
        divsd xmm14, xmm6;              // xmm14 = E/F
        subsd xmm13, xmm14;             // xmm13 = Hable(x)

        movq_st rax, xmm13;
        ret
      }
    }

  // tone_map_hable(x_bits) -> tone-mapped bit pattern | TM_INPUT_NAN | TM_INPUT_NEG.
  //
  //   tone_map_hable(x) = Hable(x) / Hable(W)          W = 11.2
  //
  // Public entry point: validates x, then evaluates tm_hable_curve_raw
  // twice (once for x, once for the fixed white point W) and divides.
  // Hable(W) is a fixed positive constant for the standard A-F, W
  // parameters this module hard-codes (see SECTION 0), so the final
  // divsd has no realistic divide-by-zero case to guard.
  pub let tone_map_hable : (u64) -> u64 !{mem} @{} =
    fn (x: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B15 G6-M2-002 (#2239): three-push callee-save discipline (rbx, r12, r13) keeps rsp%16 == 0 before each of the three nested calls (tm_validate_nonneg, then tm_hable_curve_raw twice). r12 preserves x's bit pattern across the validate call; r13 and rbx stash the two tm_hable_curve_raw results (both callee-saved, so safe across the second nested call) ahead of the final SSE divide, which needs no further calls.",
      block: {
        push rbx;
        push r12;
        push r13;
        mov r12, rdi;

        mov rdi, r12;
        call tm_validate_nonneg;
        cmp rax, 0;
        jne tm_th_out;                  // propagate TM_INPUT_NAN / TM_INPUT_NEG verbatim

        mov rdi, r12;
        call tm_hable_curve_raw;
        mov r13, rax;                   // r13 = Hable(x)

        lea r10, [rip + _tm_f64_consts];
        mov rdi, [r10 + 56];            // idx 7 = W
        call tm_hable_curve_raw;
        mov rbx, rax;                   // rbx = Hable(W)

        movq_ld xmm0, r13;
        movq_ld xmm1, rbx;
        divsd xmm0, xmm1;               // xmm0 = Hable(x) / Hable(W)
        movq_st rax, xmm0;

      tm_th_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ===========================================================================
  // SECTION 5  REINHARD CURVES
  // ===========================================================================

  // tone_map_reinhard(x_bits) -> tone-mapped bit pattern | TM_INPUT_NAN | TM_INPUT_NEG.
  //
  //   tone_map_reinhard(L) = L / (1 + L)
  pub let tone_map_reinhard : (u64) -> u64 !{mem} @{} =
    fn (x: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B15 G6-M2-002 (#2239): three-push callee-save discipline (rbx, r12, r13; only r12 carries live state, rbx/r13 are alignment padding matching the sibling entry points' 3-push idiom) keeps rsp%16 == 0 before the nested tm_validate_nonneg call. The SSE division that follows needs no further calls.",
      block: {
        push rbx;
        push r12;
        push r13;
        mov r12, rdi;

        mov rdi, r12;
        call tm_validate_nonneg;
        cmp rax, 0;
        jne tm_tr_out;                  // propagate TM_INPUT_NAN / TM_INPUT_NEG verbatim

        movq_ld xmm0, r12;              // xmm0 = L
        lea r10, [rip + _tm_f64_consts];
        mov r11, [r10 + 0];             // idx 0 = ONE
        movq_ld xmm1, r11;
        addsd xmm1, xmm0;               // xmm1 = 1 + L
        movsd xmm2, xmm0;
        divsd xmm2, xmm1;               // xmm2 = L / (1 + L)
        movq_st rax, xmm2;

      tm_tr_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // tone_map_reinhard_extended(x_bits, w_bits) ->
  //   tone-mapped bit pattern | TM_INPUT_NAN | TM_INPUT_NEG | TM_WHITE_POINT_ZERO.
  //
  //   tone_map_reinhard_extended(L, W) = (L * (1 + L/W^2)) / (1 + L)
  //
  // x and w are each run through tm_validate_nonneg (a negative or
  // non-finite burn-out white point is as meaningless as a negative or
  // non-finite luminance); w is additionally rejected as TM_WHITE_
  // POINT_ZERO when its magnitude is zero (+0.0 or -0.0), since W=0
  // would divide L/W^2 by zero.
  pub let tone_map_reinhard_extended : (u64, u64) -> u64 !{mem} @{} =
    fn (x: u64) (w: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B15 G6-M2-002 (#2239): three-push callee-save discipline (rbx, r12, r13) keeps rsp%16 == 0 before the two nested tm_validate_nonneg calls; r12=x and r13=w are preserved across both (and across the intervening rax-clobbering validate call) since tm_validate_nonneg touches only caller-saved scratch. The zero-magnitude white-point check masks the sign bit off with a register-register and (mask loaded via mov, never and reg,imm64 directly) so -0.0 is rejected on the same footing as +0.0. The SSE arithmetic that follows needs no further calls.",
      block: {
        push rbx;
        push r12;
        push r13;
        mov r12, rdi;                   // x bits
        mov r13, rsi;                   // w bits

        mov rdi, r12;
        call tm_validate_nonneg;
        cmp rax, 0;
        jne tm_tre_out;                 // propagate x's TM_INPUT_NAN / TM_INPUT_NEG

        mov rdi, r13;
        call tm_validate_nonneg;
        cmp rax, 0;
        jne tm_tre_out;                 // propagate w's TM_INPUT_NAN / TM_INPUT_NEG

        mov r10, r13;
        mov r11, 0x7FFFFFFFFFFFFFFF;
        and r10, r11;
        cmp r10, 0;
        jne tm_tre_wp_ok;
        mov rax, 0xFFFFE90B;            // TM_WHITE_POINT_ZERO
        jmp tm_tre_out;

      tm_tre_wp_ok:
        movq_ld xmm0, r12;              // xmm0 = L
        movq_ld xmm1, r13;              // xmm1 = W

        movsd xmm2, xmm1;
        mulsd xmm2, xmm1;               // xmm2 = W^2

        movsd xmm3, xmm0;
        divsd xmm3, xmm2;               // xmm3 = L / W^2

        lea r10, [rip + _tm_f64_consts];
        mov r11, [r10 + 0];             // idx 0 = ONE
        movq_ld xmm4, r11;              // xmm4 = 1.0

        movsd xmm5, xmm4;
        addsd xmm5, xmm3;               // xmm5 = 1 + L/W^2

        movsd xmm6, xmm0;
        mulsd xmm6, xmm5;               // xmm6 = L * (1 + L/W^2)   [numerator]

        movsd xmm7, xmm4;
        addsd xmm7, xmm0;               // xmm7 = 1 + L             [denominator]

        divsd xmm6, xmm7;               // xmm6 = numerator / denominator
        movq_st rax, xmm6;

      tm_tre_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ===========================================================================
  // SECTION 6  DISPATCHER
  // ===========================================================================

  // tone_map_curve_select(mode, x_bits, w_bits) -> tone-mapped bit pattern | err.
  //
  // Delegates to exactly one of the three curve entry points per `mode`:
  //
  //   TM_MODE_HABLE (0)        -> tone_map_hable(x_bits)              w_bits ignored
  //   TM_MODE_REINHARD (1)     -> tone_map_reinhard(x_bits)           w_bits ignored
  //   TM_MODE_REINHARD_EXT (2) -> tone_map_reinhard_extended(x_bits, w_bits)
  //   anything else            -> TM_MODE_INVALID
  //
  // This is the one entry point a future paint-pipeline consumer would
  // call per-scene once it has picked a curve (see the module header's
  // "novel-clean" framing: dual-curve availability lets HDR content pick
  // per-scene the perceptually-better mapping without the consumer
  // needing to know either curve's own call shape).
  pub let tone_map_curve_select : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (mode: u64) (x: u64) (w: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B15 G6-M2-002 (#2239): pure tail-forward dispatch, same sub-rsp,8/add-rsp,8 alignment-padding convention (not a bare push-reg/call/pop-reg pair) as this wave's sibling bt2100_gamut.pdx's bt2100_bradford_adapt. No callee-saved register is needed: the mode cmp chain never touches rsi/rdx (x/w), so each arm reads them directly -- reshuffling rsi->rdi (and rdx->rsi for the 2-arg extended arm) reads each source register before it is overwritten, exactly mirroring bt2100_bradford_adapt's own cascading-mov comment. Exactly one call per arm, so nothing needs to survive past it.",
      block: {
        sub rsp, 8;

        cmp rdi, 0;
        je  tm_cs_hable;
        cmp rdi, 1;
        je  tm_cs_reinhard;
        cmp rdi, 2;
        je  tm_cs_reinhard_ext;

        mov rax, 0xFFFFE90E;            // TM_MODE_INVALID
        jmp tm_cs_out;

      tm_cs_hable:
        mov rdi, rsi;                   // x bits
        call tone_map_hable;
        jmp tm_cs_out;

      tm_cs_reinhard:
        mov rdi, rsi;                   // x bits
        call tone_map_reinhard;
        jmp tm_cs_out;

      tm_cs_reinhard_ext:
        mov rdi, rsi;                   // x bits (read before rsi is overwritten below)
        mov rsi, rdx;                   // w bits
        call tone_map_reinhard_extended;

      tm_cs_out:
        add rsp, 8;
        ret
      }
    }
}
