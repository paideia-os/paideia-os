  // rdk_find_by_display_id(display_id) -> row_id | RD_ROW_NONE.
  pub let rdk_find_by_display_id : (u64) -> u64 !{mem} @{} =
    fn (display_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B1-05 (#2240): linear scan for display_id in header[47:0] of every live row. Labels prefixed rdk_fbd_.",
      block: {
        push rbx;
        push r12;
        mov r12, rdi;
        xor rbx, rbx;
      rdk_fbd_scan:
        cmp rbx, 8;
        jae rdk_fbd_none;
        lea r10, [rip + _rdk_table];
        mov r11, rbx;
        imul r11, r11, 32;
        add r10, r11;
        mov rax, [r10 + 0];
        mov r11, rax;
        shr r11, 56;
        cmp r11, 0;
        je  rdk_fbd_step;
        mov r11, 0xFFFFFFFFFFFF;
        and rax, r11;
        cmp rax, r12;
        jne rdk_fbd_step;
        mov rax, rbx;
        jmp rdk_fbd_out;
      rdk_fbd_step:
        add rbx, 1;
        jmp rdk_fbd_scan;
      rdk_fbd_none:
        mov rax, 0xFF;
      rdk_fbd_out:
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Section 10  Capability-advertisement interface.
  // ==========================================================================

  // rdk_advertise_count() -> number of live rows in [0, RD_MAX].
  // Every op_arg passed to RD_OP_ADVERTISE_COUNT is ignored; callers
  // that need a stable snapshot should reissue COUNT between AT()
  // calls if the compositor is known to be reconfiguring displays.
  pub let rdk_advertise_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B1-05 (#2240): count live rows. Two callee-save pushes leave rsp%16==0 across the internal (no-call) scan. Labels prefixed rdk_ac_.",
      block: {
        push rbx;
        push r12;
        xor rbx, rbx;                     // idx cursor
        xor r12, r12;                     // count
      rdk_ac_scan:
        cmp rbx, 8;
        jae rdk_ac_done;
        lea r10, [rip + _rdk_table];
        mov r11, rbx;
        imul r11, r11, 32;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  rdk_ac_step;
        add r12, 1;
      rdk_ac_step:
        add rbx, 1;
        jmp rdk_ac_scan;
      rdk_ac_done:
        mov rax, r12;
        pop r12;
        pop rbx;
        ret
      }
    }

  // rdk_advertise_display_id(compact_idx) -> display_id | RD_ADV_NONE.
  // Walks live rows in low-first row-id order and returns the
  // display_id at compact position `compact_idx`. Compact iteration
  // means a caller that reads COUNT then walks AT(0)..AT(COUNT-1)
  // enumerates every advertised display without seeing a hole.
  pub let rdk_advertise_display_id : (u64) -> u64 !{mem} @{} =
    fn (compact_idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B1-05 (#2240): compact-index enumeration. Three callee-save pushes (rbx=row cursor, r12=live counter, r13=target compact idx) leave rsp%16==0 across the internal scan. Labels prefixed rdk_aa_.",
      block: {
        push rbx;
        push r12;
        push r13;
        mov r13, rdi;                     // target compact idx
        xor rbx, rbx;                     // row cursor
        xor r12, r12;                     // live counter
      rdk_aa_scan:
        cmp rbx, 8;
        jae rdk_aa_none;
        lea r10, [rip + _rdk_table];
        mov r11, rbx;
        imul r11, r11, 32;
        add r10, r11;
        mov rax, [r10 + 0];
        mov r11, rax;
        shr r11, 56;
        cmp r11, 0;
        je  rdk_aa_step;
        cmp r12, r13;
        jne rdk_aa_inc;
        mov r11, 0xFFFFFFFFFFFF;
        and rax, r11;
        jmp rdk_aa_out;
      rdk_aa_inc:
        add r12, 1;
      rdk_aa_step:
        add rbx, 1;
        jmp rdk_aa_scan;
      rdk_aa_none:
        mov rax, 0xFFFFEA50;              // RD_ADV_NONE
      rdk_aa_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Section 11  Mint / revoke.
  // ==========================================================================

  // rdk_pack_ords(prim, wp, trc, surr) -> u32-packed ordinal quartet
  // suitable for the ord_pack argument of rdk_mint_body. Layout:
  //     prim[7:0] | wp[15:8] | trc[23:16] | surr[31:24]
  //
  // A helper rather than inlined into every caller because the same
  // packed form is the exact low half of the row's body1 word, so a
  // decoder that reads body1 back from a row can reuse the same
  // shift/mask pattern rdk_row_primaries / _white_point / _transfer /
  // _surround already implement.
  pub let rdk_pack_ords : (u64, u64, u64, u64) -> u64 !{} @{} =
    fn (prim: u64) (wp: u64) (trc: u64) (surr: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B1-05 (#2240): pack four u8 ordinals into a u32. Each ordinal capped at 0xFF; overflow -> 0xFFFF...FF sentinel. Labels prefixed rdk_po_.",
      block: {
        mov r10, 0xFF;
        cmp rdi, r10;
        ja  rdk_po_bad;
        cmp rsi, r10;
        ja  rdk_po_bad;
        cmp rdx, r10;
        ja  rdk_po_bad;
        cmp rcx, r10;
        ja  rdk_po_bad;
        mov rax, rdi;
        and rax, 0xFF;
        mov r10, rsi;
        and r10, 0xFF;
        shl r10, 8;
        or  rax, r10;
        mov r10, rdx;
        and r10, 0xFF;
        shl r10, 16;
        or  rax, r10;
        mov r10, rcx;
        and r10, 0xFF;
        shl r10, 24;
        or  rax, r10;
        ret;
      rdk_po_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // rdk_mint_body(parent_slot, display_id, ord_pack, peak_cd,
  //               black_ucd, flags) -> row_id | RD_MINT_* sentinel.
  //
  // Six args (all in SysV registers -- max-arity paideia-as supports
  // without stack args) because reference-display characterisation is
  // genuinely nine-dimensional; the four small ordinals (primaries,
  // white-point, transfer, surround) are packed into `ord_pack` by
  // the caller through rdk_pack_ords, matching the row layout's own
  // low-32-bits-of-body1 encoding. Gate order:
  //   (1) display_id  (rdk_id_valid)
  //   (2) primaries   (rdk_prim_valid, unpacked from ord_pack[7:0])
  //   (3) white_point (rdk_wp_valid,   unpacked from ord_pack[15:8])
  //   (4) transfer    (rdk_trc_valid,  unpacked from ord_pack[23:16])
  //   (5) surround    (rdk_surr_valid, unpacked from ord_pack[31:24])
  //   (6) luminance   (rdk_lum_valid: peak+black joint check)
  //   (7) display_id  uniqueness against live rows
  //       (rdk_find_by_display_id must return RD_ROW_NONE)
  //   (8) body pack + tail alloc
  pub let rdk_mint_body : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (parent_slot: u64) (display_id: u64) (ord_pack: u64) (peak_cd: u64) (black_ucd: u64) (flags: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B1-05 (#2240): mint one KIND_REFERENCE_DISPLAY row. Six-push callee-save prologue + sub rsp,8 = 56 bytes: entry rsp%16==8, +48+8=56, %16==0 for every nested call. All six args are stashed into callee-save registers BEFORE any nested call clobbers a caller-save reg: rbx=display_id, r12=parent_slot, r13=ord_pack, r14=peak_cd, r15=black_ucd, rbp=flags. Every validator + packer helper is a leaf using only r10/r11 scratch beyond the SysV in/out contract, so no push/pop scaffolding is needed around them. Refusal funnel bumps _rdk_stats[RD_ST_REFUSED] once at rdk_mb_refused. Labels prefixed rdk_mb_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;
        sub rsp, 8;

        mov r12, rdi;                     // parent_slot
        mov rbx, rsi;                     // display_id
        mov r13, rdx;                     // ord_pack
        mov r14, rcx;                     // peak_cd
        mov r15, r8;                      // black_ucd
        mov rbp, r9;                      // flags

        // (1) display_id
        mov rdi, rbx;
        call rdk_id_valid;
        cmp rax, 0;
        je  rdk_mb_bad_id;

        // (2) primaries -- ord_pack[7:0]
        mov rdi, r13;
        and rdi, 0xFF;
        call rdk_prim_valid;
        cmp rax, 0;
        je  rdk_mb_bad_prim;

        // (3) white_point -- ord_pack[15:8]
        mov rdi, r13;
        shr rdi, 8;
        and rdi, 0xFF;
        call rdk_wp_valid;
        cmp rax, 0;
        je  rdk_mb_bad_wp;

        // (4) transfer -- ord_pack[23:16]
        mov rdi, r13;
        shr rdi, 16;
        and rdi, 0xFF;
        call rdk_trc_valid;
        cmp rax, 0;
        je  rdk_mb_bad_trc;

        // (5) surround -- ord_pack[31:24]
        mov rdi, r13;
        shr rdi, 24;
        and rdi, 0xFF;
        call rdk_surr_valid;
        cmp rax, 0;
        je  rdk_mb_bad_surr;

        // (6) luminance -- joint peak+black check.
        mov rdi, r14;                     // peak_cd
        mov rsi, r15;                     // black_ucd
        call rdk_lum_valid;
        cmp rax, 0;
        je  rdk_mb_bad_lum;

        // (7) display_id uniqueness.
        mov rdi, rbx;
        call rdk_find_by_display_id;
        mov r10, 0xFF;                    // RD_ROW_NONE
        cmp rax, r10;
        jne rdk_mb_id_in_use;

        // (8) Pack body1 = ord_pack[31:0] | flags[63:32]. Bypass
        // rdk_body1_pack: the ord_pack low 32 bits are already the
        // exact layout body1_pack would emit, and flags is a u64
        // whose shl-32 automatically drops any bits at [63:32].
        mov rax, r13;
        and rax, 0xFFFFFFFF;
        mov r10, rbp;
        shl r10, 32;
        or  rax, r10;
        mov r13, rax;                     // body1 (ord_pack no longer needed)

        // Pack body2 = (peak_cd, black_ucd).
        mov rdi, r14;                     // peak_cd
        mov rsi, r15;                     // black_ucd
        call rdk_body2_pack;
        mov r14, rax;                     // body2 (peak_cd no longer needed)

        // Pack body3 = (parent_slot).
        mov rdi, r12;                     // parent_slot
        call rdk_body3_pack;
        mov r15, rax;                     // body3 (black_ucd no longer needed)

        // Pack hdr = display_id (low 48 bits, in_use added by
        // tail_alloc).
        mov rdi, rbx;                     // display_id
        call rdk_hdr_pack;
        // rax now holds hdr.

        // tail_alloc(hdr, body1, body2, body3) -> row_id | sentinel.
        mov rdi, rax;                     // hdr
        mov rsi, r13;                     // body1
        mov rdx, r14;                     // body2
        mov rcx, r15;                     // body3
        call rdk_tail_alloc;

        mov r10, 8;
        cmp rax, r10;
        jae rdk_mb_enospc;                // rax already the sentinel

        // Success: bump mints, preserve row_id across the note call
        // (rdk_note clobbers rax as scratch), return row_id.
        mov rbx, rax;                     // stash row_id in callee-save
        mov rdi, 0;                       // RD_ST_MINTS
        call rdk_note;
        mov rax, rbx;
        jmp rdk_mb_out;

      rdk_mb_bad_id:
        mov rax, 0xFFFFEA5B;              // RD_MINT_BAD_ID
        jmp rdk_mb_refused;
      rdk_mb_bad_prim:
        mov rax, 0xFFFFEA59;              // RD_MINT_BAD_PRIM
        jmp rdk_mb_refused;
      rdk_mb_bad_wp:
        mov rax, 0xFFFFEA58;              // RD_MINT_BAD_WP
        jmp rdk_mb_refused;
      rdk_mb_bad_trc:
        mov rax, 0xFFFFEA57;              // RD_MINT_BAD_TRC
        jmp rdk_mb_refused;
      rdk_mb_bad_surr:
        mov rax, 0xFFFFEA56;              // RD_MINT_BAD_SURR
        jmp rdk_mb_refused;
      rdk_mb_bad_lum:
        mov rax, 0xFFFFEA55;              // RD_MINT_BAD_LUM
        jmp rdk_mb_refused;
      rdk_mb_id_in_use:
        mov rax, 0xFFFFEA5A;              // RD_MINT_ID_IN_USE
        jmp rdk_mb_refused;
      rdk_mb_enospc:
        // rax already RD_TAIL_ENOSPC (0xFFFFEA5F) from rdk_tail_alloc.

      rdk_mb_refused:
        mov rbx, rax;                     // stash sentinel
        mov rdi, 2;                       // RD_ST_REFUSED
        call rdk_note;
        mov rax, rbx;

      rdk_mb_out:
        add rsp, 8;
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // rdk_revoke_body(row_id) -> 0 | RD_BAD_SLOT | RD_REVOKE_ALREADY.
  pub let rdk_revoke_body : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B1-05 (#2240): revoke one row. row_id >= RD_MAX -> RD_BAD_SLOT; not in_use -> RD_REVOKE_ALREADY; else free + bump revokes + return 0. Labels prefixed rdk_rev_.",
      block: {
        push r12;
        mov r12, rdi;

        mov r10, 8;
        cmp r12, r10;
        jae rdk_rev_bad_slot;

        mov rdi, r12;
        call rdk_tail_valid;
        cmp rax, 0;
        je  rdk_rev_already;

        mov rdi, r12;
        call rdk_tail_free;
        mov rdi, 1;                       // RD_ST_REVOKES
        call rdk_note;
        xor rax, rax;
        jmp rdk_rev_out;

      rdk_rev_bad_slot:
        mov rax, 0xFFFFEA54;              // RD_BAD_SLOT
        jmp rdk_rev_out;
      rdk_rev_already:
        mov rax, 0xFFFFEA52;              // RD_REVOKE_ALREADY

      rdk_rev_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Section 12  Boot init.
  // ==========================================================================

  // rdk_init() -> (). Boot-time defensive re-scrub. Zero pool +
  // counters. .bss is already zero at real boot; this call gives a
  // future witness a clean re-scrub point and matches the
  // kind_color_profile.pdx / kind_tui_canvas.pdx convention.
  pub let rdk_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B1-05 (#2240): call through to rdk_stats_reset for one clean pool + counter zero-out. Labels prefixed rdk_i_.",
      block: {
        call rdk_stats_reset;
        ret
      }
    }
}
