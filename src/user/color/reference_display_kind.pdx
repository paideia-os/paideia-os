        cmp rax, 0;
        je  rdk_rpr_bad;
        lea r10, [rip + _rdk_table];
        mov r11, r12;
        imul r11, r11, 32;
        add r10, r11;
        mov rax, [r10 + 8];
        and rax, 0xFF;
        jmp rdk_rpr_out;
      rdk_rpr_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      rdk_rpr_out:
        pop r12;
