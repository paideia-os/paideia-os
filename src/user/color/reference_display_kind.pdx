// src/user/color/reference_display_kind.pdx -- Wave0-B1-05 (paideia-os #2240)
//
// KIND_REFERENCE_DISPLAY = 0x1B7, derived over KIND_MEMORY (= KIND_PAGE, 4).
// Design authority: MASTER_PLAN.md Phase A + Wave-0 Batch-1 manifest.
//
// One reference-display characterisation capability. The compositor
// holds one row per display it knows how to render for; a client that
// wants to know "what displays does this compositor speak" asks the
// two-step advertisement interface (COUNT then AT(idx)) and reads
// each returned row's primaries / white-point / transfer / peak+black
// luminance / viewing-environment surround through the per-field
// QUERY_* ops. A colour-management channel (see
// `src/kernel/core/ipc/color_management_channel.pdx`) uses the same
// per-row metadata as its `set_reference_display` sink; a rendering
// pipeline that wants to compute a display-referred tonemap (BT.2100
// HLG OOTF / PQ ST.2084) reads peak_luminance out of the row it was
// handed rather than baking a fixed 1000 cd/m^2 assumption in shader
// code. Downstream landing G6-M6-002 (BT.2100 helpers, paideia-os
// #2241) folds these fields into the OOTF gamma derivation.
//
// This module is user-space. It is NOT wired into `cap_table` /
// `cap_invoke_dispatch` -- those live behind kernel ring boundaries,
// and this file lives on the user side of that boundary (see file
// path). The compositor process (a userland supervisor at ring 3)
// mints one row per known reference display at boot and holds the
// authority to advertise them; client processes ask the compositor
// through IPC, and the compositor answers by evaluating the query
// helpers below against its own local row pool. A future landing that
// promotes reference-display authority INTO the kernel would move
// the row pool + mint gate into `src/kernel/core/cap/` (mirroring the
// `kind_color_profile.pdx` posture at 0x18F) and wire the same op
// catalog through `cap_invoke_dispatch`; nothing in this file
// prevents that promotion.
//
// =============================================================================
// SECTION 0  KIND_* SLOT ALLOCATION
// =============================================================================
//
// Consulted `design/architecture/next-wave-derived-kinds.md` §"Summary
// counts and free bands" at landing (line 2397): "Next free derived-
// kind tag: 0x1B7" (after `KIND_KEK = 0x1B4`, R90-XREPO.LV11.M5-001).
// Cross-verified by grep over `src/kernel/core/cap/kind_*.pdx` -- no
// live claim on 0x1B7. Same G7+ band (0x1B2..0x1BF) that
// `KIND_SCHEMA_HANDLE` (0x1B2), `KIND_VOLUME_SNAPSHOT` (0x1B3), and
// `KIND_KEK` (0x1B4) occupy.
//
// =============================================================================
// SECTION 1  DERIVATION OVER KIND_MEMORY
// =============================================================================
//
// The metadata blob (primaries + white-point + transfer + luminance +
// surround) is small enough to live entirely inline in the row, but
// the derivation still requires a KIND_MEMORY parent carrying
// RIGHT_MINT: it is the standard "you must already hold reach over
// SOME memory page to mint one derived reference-display cap".
// Mirrors `kind_color_profile.pdx` (0x18F) exactly for that gate,
// which is the closest precedent for a user-facing display-metadata
// kind.
//
// =============================================================================
// SECTION 2  ROW LAYOUT -- 32 BYTES (FOUR u64 WORDS)
// =============================================================================
//
//   [+0]  header:  in_use[63:56] | display_id[47:0] | reserved[55:48]
//   [+8]  body1:   primaries_ord[7:0] | white_point_ord[15:8]
//                | transfer_ord[23:16] | surround_ord[31:24]
//                | flags[63:32]
//   [+16] body2:   peak_luminance_cd_m2[31:0]
//                | black_luminance_ucd_m2[63:32]
//   [+24] body3:   parent_memory_slot[7:0] | reserved[63:8]
//
// display_id is client-supplied and MUST be unique among live rows
// (mint refuses a duplicate with RD_MINT_ID_IN_USE). 48 bits is chosen
// so a synthetic id built from EDID manufacturer (16 bits) plus the
// EDID product code (16 bits) plus the low 16 bits of the serial can
// pack losslessly.
//
// peak_luminance stored in cd/m^2 (u32; PQ ST.2084 peaks at 10 000).
// black_luminance stored in micro-cd/m^2 (u32; a 0.001 cd/m^2 OLED
// black registers as 1 000 000, fitting well inside u32). Both units
// keep the whole row integer -- no float leaks into a metadata cap
// per the FPU-discipline (see `design/kernel/no-fpu.md`).
//
// =============================================================================
// SECTION 3  FAILURE TAXONOMY 0xFFFFEA50..0xFFFFEA5F
// =============================================================================
//
// A repo-wide grep at landing time showed the 0xFFFFEA50..0xFFFFEA5F
// page as unclaimed across src/ and design/. Chosen ahead of the
// "adjacent to KIND_COLOR_PROFILE (0xFFFFEE40..4F)" band because that
// neighbouring page is already crowded by the R101 GUI + G6 colour
// landings; a fresh page here keeps failure-code coverage clean.
//
// =============================================================================
// SECTION 4  CAPABILITY ADVERTISEMENT INTERFACE
// =============================================================================
//
// Two arity-one QUERY-family ops answer "which displays does this
// compositor know":
//
//   RD_OP_ADVERTISE_COUNT (op_arg IGNORED)
//       -> live row count, i.e. number of reference displays the
//          compositor advertises. Bounded by RD_MAX = 8.
//
//   RD_OP_ADVERTISE_AT   (op_arg = compact index 0..count-1)
//       -> display_id at that live-row index, or RD_ADV_NONE if the
//          index is out of range. Compact iteration is over the LIVE
//          rows in low-first row-id order, so a caller that reads
//          COUNT then walks AT(0)..AT(COUNT-1) enumerates every
//          advertised display without seeing a hole.
//
// A client that wants full metadata for a specific display asks
// AT(idx) for the display_id, then reissues QUERY_PRIMARIES /
// QUERY_WHITE_POINT / QUERY_TRANSFER / QUERY_PEAK_LUM /
// QUERY_BLACK_LUM / QUERY_SURROUND against the row it earlier minted
// or was handed by the compositor for that display_id. The
// compositor's row-of-display-id lookup is the `rdk_find_by_display_
// id` helper below (returned as row-id + RD_ROW_NONE sentinel).

module ReferenceDisplayKind = structure {

  pub let KIND_REFERENCE_DISPLAY : u64 = 0x1B7
  pub let RD_PARENT_KIND         : u64 = 4          // KIND_MEMORY

  // Row pool. RD_MAX = 8 mirrors kind_tui_canvas.pdx's starting
  // ceiling (a typical desktop advertises 1..3 outputs; 8 covers
  // multi-head workstations without over-committing .bss).
  pub let RD_MAX       : u64 = 8
  pub let RD_ROW_BYTES : u64 = 32

  // Rights. R_RD_ADVERTISE is the one right that gates the
  // capability-advertisement interface (COUNT + AT). Read/query is a
  // separate right so a client that already holds an advertise cap
  // can list displays but cannot decode a specific row's metadata
  // without also holding read on the specific display cap. R_MINT
  // PRESENT -- a compositor derives per-display advertisement caps
  // from a hub cap the display supervisor holds.
  pub let R_RD_READ      : u64 = 0x001
  pub let R_RD_INVOKE    : u64 = 0x008
  pub let R_RD_REVOKE    : u64 = 0x010
  pub let R_RD_MINT      : u64 = 0x200
  pub let R_RD_OBSERVE   : u64 = 0x400
  pub let R_RD_ADVERTISE : u64 = 0x800
  pub let R_RD_ALL       : u64 = 0xC19             // 0x001|0x008|0x010|0x200|0x400|0x800

  // Primaries ordinal. BT.709 (Rec.709) is the SDR desktop default;
  // BT.2020 the wide-gamut HDR reference; DCI-P3 the consumer HDR /
  // wide-gamut cinema reference; CUSTOM the "compositor knows the CIE
  // xy of each primary through an out-of-band ICC profile" escape.
  pub let RD_PRIM_UNSET  : u64 = 0
  pub let RD_PRIM_BT709  : u64 = 1
  pub let RD_PRIM_BT2020 : u64 = 2
  pub let RD_PRIM_DCI_P3 : u64 = 3
  pub let RD_PRIM_CUSTOM : u64 = 4
  pub let RD_PRIM_MAX    : u64 = 4

  // White-point ordinal. D65 is the near-universal display default;
  // D50 the print-referenced reference; CUSTOM for out-of-band CIE
  // xy pairs riding a companion ICC / CICP profile.
  pub let RD_WP_UNSET  : u64 = 0
  pub let RD_WP_D65    : u64 = 1
  pub let RD_WP_D50    : u64 = 2
  pub let RD_WP_CUSTOM : u64 = 3
  pub let RD_WP_MAX    : u64 = 3

  // Transfer characteristic ordinal. The seven standard curves plus
  // CUSTOM. LINEAR is included because reference-display metadata for
  // a scene-linear render target still needs an ordinal to name.
  pub let RD_TRC_UNSET      : u64 = 0
  pub let RD_TRC_GAMMA22    : u64 = 1
  pub let RD_TRC_SRGB       : u64 = 2              // IEC 61966-2-1
  pub let RD_TRC_BT1886     : u64 = 3              // ITU-R BT.1886
  pub let RD_TRC_PQ_ST2084  : u64 = 4              // SMPTE ST.2084
  pub let RD_TRC_HLG_BT2100 : u64 = 5              // ITU-R BT.2100 HLG
  pub let RD_TRC_LINEAR     : u64 = 6
  pub let RD_TRC_CUSTOM     : u64 = 7
  pub let RD_TRC_MAX        : u64 = 7

  // Viewing-environment surround ordinal. CIECAM02 / ICC.1 v4 name
  // the four canonical surrounds (dark / dim / average / bright).
  pub let RD_SURR_DARK    : u64 = 0
  pub let RD_SURR_DIM     : u64 = 1
  pub let RD_SURR_AVERAGE : u64 = 2
  pub let RD_SURR_BRIGHT  : u64 = 3
  pub let RD_SURR_MAX     : u64 = 3

  // Luminance bounds. PQ ST.2084 peaks at 10000 cd/m^2; anything
  // higher is out of any deployed transfer's dynamic range. Black
  // stored in micro-cd/m^2 to preserve OLED-scale precision without
  // introducing floats; ceiling 1e9 (i.e. 1000 cd/m^2) is a
  // physically impossible "black" value, so it lands well above any
  // real display's dark point while still fitting u32.
  pub let RD_PEAK_MAX_CDM2   : u64 = 10000
  pub let RD_BLACK_MAX_UCDM2 : u64 = 1000000000

  // Ops. Every op arity ONE -- op_arg[63:8] REFUSED (mirrors
  // kind_color_profile.pdx CP_OP_* conventions).
  pub let RD_OP_QUERY_DISPLAY_ID : u64 = 0
  pub let RD_OP_QUERY_PRIMARIES  : u64 = 1
  pub let RD_OP_QUERY_WHITE_POINT: u64 = 2
  pub let RD_OP_QUERY_TRANSFER   : u64 = 3
  pub let RD_OP_QUERY_PEAK_LUM   : u64 = 4
  pub let RD_OP_QUERY_BLACK_LUM  : u64 = 5
  pub let RD_OP_QUERY_SURROUND   : u64 = 6
  pub let RD_OP_ADVERTISE_COUNT  : u64 = 7
  pub let RD_OP_ADVERTISE_AT     : u64 = 8
  pub let RD_OP_DEBUG_PRINT      : u64 = 9
  pub let RD_OP_MAX              : u64 = 9

  // Failure taxonomy -- 0xFFFFEA50..0xFFFFEA5F. Fresh page,
  // grep-verified free across src/ + design/ at landing.
  pub let RD_OK                : u64 = 0
  pub let RD_TAIL_ENOSPC       : u64 = 0xFFFFEA5F
  pub let RD_TAIL_BAD_ARG      : u64 = 0xFFFFEA5E
  pub let RD_MINT_BAD_PARENT   : u64 = 0xFFFFEA5D
  pub let RD_MINT_BAD_RIGHTS   : u64 = 0xFFFFEA5C
  pub let RD_MINT_BAD_ID       : u64 = 0xFFFFEA5B
  pub let RD_MINT_ID_IN_USE    : u64 = 0xFFFFEA5A
  pub let RD_MINT_BAD_PRIM     : u64 = 0xFFFFEA59
  pub let RD_MINT_BAD_WP       : u64 = 0xFFFFEA58
  pub let RD_MINT_BAD_TRC      : u64 = 0xFFFFEA57
  pub let RD_MINT_BAD_SURR     : u64 = 0xFFFFEA56
  pub let RD_MINT_BAD_LUM      : u64 = 0xFFFFEA55
  pub let RD_BAD_SLOT          : u64 = 0xFFFFEA54
  pub let RD_WRONG_KIND        : u64 = 0xFFFFEA53
  pub let RD_REVOKE_ALREADY    : u64 = 0xFFFFEA52
  pub let RD_UNSUP_OP          : u64 = 0xFFFFEA51
  pub let RD_ADV_NONE          : u64 = 0xFFFFEA50

  pub let RD_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let RD_ROW_NONE   : u64 = 0xFF

  // THE ONE STATE CELL. 8 rows * 32 bytes = 256 bytes = 32 u64.
  pub let mut _rdk_table : [u64; 32] = uninit @align(64)
  pub let mut _rdk_stats : [u64; 4]  = uninit @align(64)

  pub let RD_ST_MINTS   : u64 = 0
  pub let RD_ST_REVOKES : u64 = 1
  pub let RD_ST_REFUSED : u64 = 2
  pub let RD_ST_QUERIES : u64 = 3

  // Fingerprint tag. Emitted by the display supervisor on successful
  // mint of a reference-display cap. Legacy suffix gives grep parity
  // with pre-Wave0 boot-log tooling per this codebase's tag
  // convention (see e.g. `kind_tui_canvas.pdx` tui_mint_ok_msg,
  // `kind_nic.pdx` nic_mint_ok_msg).
  pub let rdk_mint_ok_msg : [u8; 62] = "reference display mint ok [legacy: REFERENCE DISPLAY MINT OK]\0"

  // ==========================================================================
  // Section 5  Counter primitives.
  // ==========================================================================

  pub let rdk_stats_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B1-05 (#2240): clear row table + counters at boot. Labels prefixed rdk_rs_.",
      block: {
        lea r10, [rip + _rdk_table];
        xor rax, rax;
        xor rcx, rcx;
      rdk_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  rdk_rs_rows;

        lea r10, [rip + _rdk_stats];
        xor rcx, rcx;
      rdk_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  rdk_rs_stats;
        ret
      }
    }

  pub let rdk_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B1-05 (#2240): counter bump. Encoder-conservative load-inc-store; no add reg,[mem]. Labels prefixed rdk_nt_.",
      block: {
        cmp rdi, 4;
        jae rdk_nt_out;
        lea r10, [rip + _rdk_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      rdk_nt_out:
        ret
      }
    }

  pub let rdk_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B1-05 (#2240): counter read. Labels prefixed rdk_st_.",
      block: {
        cmp rdi, 4;
        jae rdk_st_zero;
        lea r10, [rip + _rdk_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      rdk_st_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Section 6  Validators.
  // ==========================================================================

  pub let rdk_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B1-05 (#2240): subset test against R_RD_ALL = 0xC19. Labels prefixed rdk_rv_.",
      block: {
        mov rax, rdi;
        mov r10, 0xC19;
        and rax, r10;
        cmp rax, rdi;
        jne rdk_rv_no;
        mov rax, 1;
        ret;
      rdk_rv_no:
        xor rax, rax;
        ret
      }
    }

  pub let rdk_prim_valid : (u64) -> u64 !{} @{} =
    fn (p: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B1-05 (#2240): 1 iff p in [1, RD_PRIM_MAX=4]. UNSET (0) refused: an advertised display without a primaries ordinal is not something the tonemap pipeline can bind to. Labels prefixed rdk_pv_.",
      block: {
        cmp rdi, 0;
        je  rdk_pv_no;
        mov r10, 4;
        cmp rdi, r10;
        ja  rdk_pv_no;
        mov rax, 1;
        ret;
      rdk_pv_no:
        xor rax, rax;
        ret
      }
    }

  pub let rdk_wp_valid : (u64) -> u64 !{} @{} =
    fn (w: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B1-05 (#2240): 1 iff w in [1, RD_WP_MAX=3]. UNSET (0) refused per rdk_prim_valid's rationale. Labels prefixed rdk_wv_.",
      block: {
        cmp rdi, 0;
        je  rdk_wv_no;
        mov r10, 3;
        cmp rdi, r10;
        ja  rdk_wv_no;
        mov rax, 1;
        ret;
      rdk_wv_no:
        xor rax, rax;
        ret
      }
    }

  pub let rdk_trc_valid : (u64) -> u64 !{} @{} =
    fn (t: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B1-05 (#2240): 1 iff t in [1, RD_TRC_MAX=7]. UNSET (0) refused. Labels prefixed rdk_tv_.",
      block: {
        cmp rdi, 0;
        je  rdk_tv_no;
        mov r10, 7;
        cmp rdi, r10;
        ja  rdk_tv_no;
        mov rax, 1;
        ret;
      rdk_tv_no:
        xor rax, rax;
        ret
      }
    }

  pub let rdk_surr_valid : (u64) -> u64 !{} @{} =
    fn (s: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B1-05 (#2240): 1 iff s <= RD_SURR_MAX=3. DARK (0) is legal (a cinema-grade reference display often lives in a dark room). Labels prefixed rdk_sv_.",
      block: {
        mov r10, 3;
        cmp rdi, r10;
        ja  rdk_sv_no;
        mov rax, 1;
        ret;
      rdk_sv_no:
        xor rax, rax;
        ret
      }
    }

  // rdk_lum_valid(peak_cd, black_ucd) -> 1 iff peak in [1,
  // RD_PEAK_MAX_CDM2] and black in [0, RD_BLACK_MAX_UCDM2] and
  // black_ucd < peak_cd * 1_000_000 (so black is strictly below
  // peak in the same units).
  pub let rdk_lum_valid : (u64, u64) -> u64 !{} @{} =
    fn (peak_cd: u64) (black_ucd: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B1-05 (#2240): joint peak+black check. peak must be strictly positive and <= RD_PEAK_MAX_CDM2 (=10000); black is stored in micro-cd/m^2 and must be <= RD_BLACK_MAX_UCDM2 (=1e9); black_ucd must be strictly less than peak_cd * 1_000_000 (peak converted to the same micro-cd/m^2 units). Uses imul for the scale so no MOVABS immediate leaks in. Labels prefixed rdk_lv_.",
      block: {
        cmp rdi, 0;
        je  rdk_lv_no;
        mov r10, 10000;
        cmp rdi, r10;
        ja  rdk_lv_no;
        mov r10, 1000000000;
        cmp rsi, r10;
        ja  rdk_lv_no;
        mov rax, rdi;
        mov r10, 1000000;
        imul rax, r10;                     // rax = peak_cd * 1_000_000
        cmp rsi, rax;
        jae rdk_lv_no;                     // black_ucd >= peak_ucd
        mov rax, 1;
        ret;
      rdk_lv_no:
        xor rax, rax;
        ret
      }
    }

  // display_id must fit in 48 bits and be non-zero (a zero id would
  // shadow the "row empty" sentinel in the header word).
  pub let rdk_id_valid : (u64) -> u64 !{} @{} =
    fn (display_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B1-05 (#2240): 1 iff display_id in (0, 2^48). Upper 16 bits MUST be zero so the header's in_use marker + reserved slots stay clear. Labels prefixed rdk_iv_.",
      block: {
        cmp rdi, 0;
        je  rdk_iv_no;
        mov rax, rdi;
        shr rax, 48;
        cmp rax, 0;
        jne rdk_iv_no;
        mov rax, 1;
        ret;
      rdk_iv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Section 7  Packers.
  // ==========================================================================

  // body1: primaries_ord[7:0] | white_point_ord[15:8]
  //      | transfer_ord[23:16] | surround_ord[31:24] | flags[63:32]
  pub let rdk_body1_pack : (u64, u64, u64, u64, u64) -> u64 !{} @{} =
    fn (prim: u64) (wp: u64) (trc: u64) (surr: u64) (flags: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B1-05 (#2240): body1 pack. Each ordinal capped at 0xFF; flags occupies the upper u32 verbatim (shl 32 drops any bits at [63:32] of the input flags word, so no explicit mask). Labels prefixed rdk_b1_.",
      block: {
        mov r10, 0xFF;
        cmp rdi, r10;
        ja  rdk_b1_bad;
        cmp rsi, r10;
        ja  rdk_b1_bad;
        cmp rdx, r10;
        ja  rdk_b1_bad;
        cmp rcx, r10;
        ja  rdk_b1_bad;

        mov rax, rdi;
        and rax, 0xFF;
        mov r10, rsi;
        and r10, 0xFF;
        shl r10, 8;
        or  rax, r10;
        mov r10, rdx;
        and r10, 0xFF;
        shl r10, 16;
        or  rax, r10;
        mov r10, rcx;
        and r10, 0xFF;
        shl r10, 24;
        or  rax, r10;
        mov r10, r8;
        shl r10, 32;
        or  rax, r10;
        ret;
      rdk_b1_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // body2: peak_luminance_cd_m2[31:0] | black_luminance_ucd_m2[63:32]
  pub let rdk_body2_pack : (u64, u64) -> u64 !{} @{} =
    fn (peak_cd: u64) (black_ucd: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B1-05 (#2240): body2 pack. Both halves capped at u32 max. Labels prefixed rdk_b2_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  rdk_b2_bad;
        cmp rsi, r10;
        ja  rdk_b2_bad;
        mov rax, rdi;
        and rax, 0xFFFFFFFF;
        mov r10, rsi;
        and r10, 0xFFFFFFFF;
        shl r10, 32;
        or  rax, r10;
        ret;
      rdk_b2_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // header: (display_id in low 48) with in_use added at claim time.
  pub let rdk_hdr_pack : (u64) -> u64 !{} @{} =
    fn (display_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B1-05 (#2240): pack header sans in_use bit. display_id occupies bits [47:0]. Labels prefixed rdk_hp_.",
      block: {
        mov rax, rdi;
        shr rax, 48;
        cmp rax, 0;
        jne rdk_hp_bad;
        mov rax, rdi;
        ret;
      rdk_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // body3: parent_memory_slot[7:0] | reserved[63:8]
  pub let rdk_body3_pack : (u64) -> u64 !{} @{} =
    fn (parent_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B1-05 (#2240): body3 pack. parent_slot capped at 0xFF (u8). Labels prefixed rdk_b3_.",
      block: {
        mov r10, 0xFF;
        cmp rdi, r10;
        ja  rdk_b3_bad;
        mov rax, rdi;
        and rax, 0xFF;
        ret;
      rdk_b3_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // Section 8  Row pool: valid / alloc / free.
  // ==========================================================================

  pub let rdk_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B1-05 (#2240): 1 iff row_id < RD_MAX and in_use. Labels prefixed rdk_tv2_.",
      block: {
        cmp rdi, 8;
        jae rdk_tv2_no;
        lea r10, [rip + _rdk_table];
        mov r11, rdi;
        imul r11, r11, 32;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  rdk_tv2_no;
        mov rax, 1;
        ret;
      rdk_tv2_no:
        xor rax, rax;
        ret
      }
    }

  // rdk_tail_alloc(hdr, body1, body2, body3) -> row_id | err.
  // Low-first scan over 8 rows. Header is stamped with the in_use bit
  // (bit 56) here so callers pass an "unset in_use" packed header.
  pub let rdk_tail_alloc : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (body1: u64) (body2: u64) (body3: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B1-05 (#2240): claim one REFERENCE_DISPLAY row. Low-first scan (rbx=idx) over 8 rows of 32 bytes (idx*32 via imul). On claim: OR the 1<<56 in_use marker into hdr and store the four u64 body words. Five callee-save pushes (rbx=idx cursor, r12=hdr, r13=body1, r14=body2, r15=body3) leave rsp%16==0 for the internal no-nested-call scan. Labels prefixed rdk_ta_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov r15, rcx;

        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne rdk_ta_bad;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp r13, r10;
        je  rdk_ta_bad;
        cmp r14, r10;
        je  rdk_ta_bad;
        cmp r15, r10;
        je  rdk_ta_bad;

        xor rbx, rbx;
      rdk_ta_scan:
        cmp rbx, 8;
        jae rdk_ta_enospc;
        lea r10, [rip + _rdk_table];
        mov r11, rbx;
        imul r11, r11, 32;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  rdk_ta_claim;
        add rbx, 1;
        jmp rdk_ta_scan;

      rdk_ta_claim:
        mov rax, r12;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r13;
        mov [r10 + 16], r14;
        mov [r10 + 24], r15;
        mov rax, rbx;
        jmp rdk_ta_out;

      rdk_ta_enospc:
        mov rax, 0xFFFFEA5F;
        jmp rdk_ta_out;
      rdk_ta_bad:
        mov rax, 0xFFFFEA5E;

      rdk_ta_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let rdk_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B1-05 (#2240): scrub one row (all four words). Labels prefixed rdk_tf_.",
      block: {
        cmp rdi, 8;
        jae rdk_tf_out;
        lea r10, [rip + _rdk_table];
        mov r11, rdi;
        imul r11, r11, 32;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
      rdk_tf_out:
        ret
      }
    }

  // ==========================================================================
  // Section 9  Row-field query helpers.
  // ==========================================================================

  // rdk_row_display_id(row_id) -> display_id | RD_DECODE_BAD.
  pub let rdk_row_display_id : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B1-05 (#2240): display_id at header[47:0]. Labels prefixed rdk_rid_.",
      block: {
        push r12;
        mov r12, rdi;
        call rdk_tail_valid;
        cmp rax, 0;
        je  rdk_rid_bad;
        lea r10, [rip + _rdk_table];
        mov r11, r12;
        imul r11, r11, 32;
        add r10, r11;
        mov rax, [r10 + 0];
        mov r10, 0xFFFFFFFFFFFF;
        and rax, r10;
        jmp rdk_rid_out;
      rdk_rid_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      rdk_rid_out:
        pop r12;
        ret
      }
    }

