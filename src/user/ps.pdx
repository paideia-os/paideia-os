// src/user/ps.pdx -- R57.M4-003 (paideia-os #1799) + R60.M7-002 (#1817)
//                    + paideia-os#2431 (CMD from TCB.comm + RSS column drop)
//                    + paideia-os#2453 (Wave 12 POSIX-lite flag suite: -a -e -f)
// -- /bin/ps user binary
//
// Minimal task-list utility.  Walks the kernel-exposed task table one
// slot at a time via sys_taskinfo(idx, buf), formats each returned
// 64-byte ps_record on stdout (fd 1), and exits with status 0 on end-of-
// pool.  Header line + one line per live task:
//
//   PID PPID S CPU_TICKS START CMD
//   1 0 1 42 3 init
//   3 1 1 7 51 shell
//
// R60.M7-002 (#1817) doubled the ps_record from 32 to 64 bytes and added
// three columns: CPU_TICKS (cumulative 100 Hz LAPIC ticks the task has
// been on-CPU), RSS (mapped-frame count -- always 0 at R60, deferred),
// and START (the global tick count at task creation, i.e. a task-age
// baseline). No cpu% column is computed here: there is no "read the
// current tick count" syscall at R60, so the raw cpu_ticks/start_tick
// pair is printed and the operator (or a follow-up ps -o cpu%) derives a
// percentage from cpu_ticks / (now - start), once "now" is available to
// userspace.
//
// -----------------------------------------------------------------------------
// paideia-os#2431 (2026-09) -- CMD wired to real comm[]; RSS column DROPPED
// -----------------------------------------------------------------------------
//
// CMD column.  task_pool.pdx §TASK_OFF_COMM (paideia-os#2431) added a
// 16-byte u8 field at TCB offset +464 populated by sys_execve_shim's
// Phase 8.5 with the basename of the successfully-execve'd path;
// task_info.pdx copies it into the ps_record's +16..+31 slot (which was
// always reserved for it -- see §"Record parse" below).  This file
// renders bytes ps_record[16..32] as the CMD column when byte 0 is
// non-zero, falling back to the pre-#2431 synthetic `task<pid>` name
// when byte 0 is NUL.  The fallback still fires for two classes of task
// today: pid 1 (init is loaded by boot_spawn's elf_lite_load path, NOT
// via sys_execve, so its comm stays at the task_new zero-fill), and
// kernel witness TCBs constructed without ever handing control to an
// image.
//
// RSS column.  DROPPED from the visible header and per-record emit,
// deliberately.  task_info.pdx §rss_pages argues at length why the
// aspace walk that would populate the field honestly is deferred (no
// per-aspace primitive exists at R60, frame_meta refcounts are global-
// pool-indexed rather than per-aspace, and the walk runs under the
// caller's CR3 rather than the target's).  Novel-and-clean discipline:
// don't ship an always-zero column that reads as "this task uses no
// memory" -- either the number is real or the column is absent.  The
// underlying ps_record slot at +40 stays reserved (task_info.pdx's
// 64-byte contract is unchanged), so a future PML4-walk landing that
// populates rss_pages honestly can re-add the header word + one
// print_u64_dec call without renegotiating the record layout, the
// syscall shape, or any other column.
//
// -----------------------------------------------------------------------------
// paideia-os#2453 (Wave 12, 2026-09) -- POSIX-lite flag suite
// -----------------------------------------------------------------------------
//
// Argv-driven flag scan (Phase -1, same combined-char shape as ls v1.2):
//
//   -a   show ALL processes (no-op today; default is already 'all')
//   -e   synonym for -a (POSIX 'every process'); no-op today
//   -f   full format: prepends a UID column and inserts a TTY column
//        before CMD; the START column header is re-labelled STIME for
//        the -f header line (same underlying start_tick u64 value)
//
// Combined single-char forms work (`-af`, `-fe`, `-aef`). `--` is the
// end-of-flags sentinel. Unknown flag chars are silently ignored (MVP
// posture, matches ls v1.2). ps takes no positional args at this
// landing; any non-flag arg is ignored.
//
// The kernel-side ps_record does NOT carry a uid field or a tty field
// today. -f therefore prints hardcoded placeholders:
//   UID   = 0    (root)     -- every task runs as root at R57-R60
//   TTY   = tty0            -- init dup2's /dev/tty0 to fd 0/1/2 at
//                              boot, and fork+exec preserves the fd
//                              table by default, so tty0 is the honest
//                              inherited controlling tty for every
//                              user task in the current tree; a task
//                              re-parented to a pipe would still print
//                              tty0 here, which is a documented lie
//                              corrected when the kernel wires a real
//                              controlling-tty field into the TCB
// A follow-on ticket extends task_info's 64-byte record with real
// uid @ +56 and tty[8] @ +64 (widening to 72 or 128 bytes; slot at
// +40 rss_pages stays reserved). At that landing this file's UID and
// TTY emit sites swap the immediate loads for full-width `mov` loads
// from ps_record with NO other change to layout, header lengths, or
// per-record emit ordering.
//
// -l (long) is deferred at Wave 12 -- POSIX ps -l needs F (flags),
// PRI, NI, ADDR, SZ, WCHAN, all of which require task-scheduler
// metadata not exposed by task_info at R60. A future landing that
// extends the record adds -l without renegotiating the -a/-e/-f
// contract.
//
// %CPU column is also deferred: computing it requires a "read the
// current global tick count" syscall (sys_clock_ticks) that has not
// landed. The raw cpu_ticks/start_tick pair stays in the output for
// the operator to derive a ratio from, exactly as at the #1817
// landing.
//
// -----------------------------------------------------------------------------
// M0 posture -- what is real, what is placeholder
// -----------------------------------------------------------------------------
//
// REAL:
//   (a) The sys_taskinfo(83) syscall path -- iteration, error handling,
//       64-byte ps_record parse (pid @ +0 u32, ppid @ +4 u32, state @ +8 u32,
//       cpu_ticks @ +32 u64, rss_pages @ +40 u64 (always 0, see above),
//       start_tick @ +48 u64 -- R60.M7-002 #1817 extension).
//   (b) Decimal formatting via a local print_u64_dec helper (verbatim
//       shape of src/user/init.pdx's own, which is the tree's reference
//       implementation of the divide-by-10 loop -- see init.pdx §L97).
//   (c) sys_write(1, ...) for every emit -- output lands on whatever the
//       shell wired to fd 1 (init's setup dup2s /dev/tty0 to 0/1/2 at
//       boot, and fork+exec preserves the fd table by default).
//   (d) End-of-iteration signalled by -ESRCH from sys_taskinfo; empty
//       slots between live pids signalled by -ENOENT and skipped.
//
// REAL (paideia-os#2431 landing):
//   The ps_record's +16..+31 name field is now populated by
//   task_info.pdx from TCB.comm @+464 on every task_get_info call.
//   ps.pdx renders it as the CMD column when byte 0 is non-zero, with
//   a synthesised `task<pid>` fallback when byte 0 is NUL (init,
//   witness TCBs, any task that has never execve'd).
//
// PLACEHOLDER (still deferred at #2431):
//   RSS column dropped from output entirely; the ps_record slot at
//   +40 stays reserved and reads 0 (see the paideia-os#2431 file-
//   header block above for the reasoning + how a future PML4 walker
//   adds it back without breaking the record layout).
//
// -----------------------------------------------------------------------------
// Design choice -- self-contained, no syscall_shim link dependency
// -----------------------------------------------------------------------------
//
// Mirrors src/user/true.pdx and src/user/child_hello.pdx exactly:
// inlines the three syscalls it needs (write=1, exit=60, taskinfo=83)
// directly at their call sites.  This keeps the ELF tiny (well under
// the tmpfs 64 KiB per-file cap), removes any linker collision with
// the shared syscall_shim.o consumed by init.elf and shell.elf, and
// matches the "one .pdx file, one .elf" pattern used by every trivial
// fixture in this tree.  tools/build-user.sh classifies ps into its
// own object set for the same reason.
//
// print_u64_dec is duplicated here rather than shared with init because
// the shared-library form of it would drag it into a libutil.a that the
// self-contained pattern deliberately avoids; every self-contained
// binary in this tree that formats decimals carries its own copy for
// the same reason (see the identical duplication in init.pdx §L97 vs.
// the reference copy in src/kernel/core/klog/hex.pdx §u64_to_dec).
//
// -----------------------------------------------------------------------------
// SC+ ID discipline (frozen per R17-M1-001 / #610 + R57.M4-003)
// -----------------------------------------------------------------------------
//
//   1  = sys_write(fd, buf, count)
//   60 = sys_exit(status)                (never returns)
//   83 = sys_taskinfo(idx, buf_va)       (this issue -- #1799)
//
// -----------------------------------------------------------------------------
// Register discipline in _start
// -----------------------------------------------------------------------------
//
// r12 = idx counter (u64, iterates 0..64).  Callee-save; survives the
//       intervening sys_write / print_u64_dec calls without spill.
// The ps_record buffer is a .bss array addressed via `lea` at each use --
// simpler than pinning it in a callee-save reg because paideia-as
// resolves rip-relative addresses cheaply.
//
// Safety cap: the loop terminates on -ESRCH (idx >= MAX_PIDS) at the
// syscall layer, but a defensive `cmp r12, 64; jae ps_done` at the top
// of the loop guarantees termination even if the syscall's bound ever
// drifts.  Cost is one branch per iteration and one less way the M0
// binary can wedge the shell.

module Ps = structure {

  // ==========================================================================
  // .bss scratch -- 64-byte task-info ps_record, refilled per iteration.
  //
  // R60.M7-002 (#1817): widened from [u64; 4] (32 B) to [u64; 8] (64 B) to
  // match TASK_INFO_RECORD_BYTES's doubling (src/kernel/core/sched/
  // task_info.pdx §Record layout).  Declared as [u64; 8] rather than
  // [u8; 64] so paideia-as places it at 8-byte alignment (matches
  // _dispatch_taskinfo_scratch's own align(8) in src/kernel/core/syscall/
  // dispatch.pdx).  The u32 field reads below load through
  // `mov ecx, [rax + k]` and do not require 4-byte or 8-byte alignment,
  // but the aligned form is what lets the new u64 field reads
  // (`mov rcx, [rax + k]` for cpu_ticks/start_tick) be simple unaligned-
  // safe qword loads with no further annotation.
  // ==========================================================================
  pub let mut ps_record : [u64; 8] = uninit @align(8)

  // ==========================================================================
  // rodata strings -- header, separators, name prefix.
  //
  // NUL byte is stored on every string for strlen-safety symmetry with
  // the rest of the tree (init.pdx / shell.pdx / true.pdx), but is NEVER
  // written on the wire -- every sys_write below is length-bounded to
  // the visible-byte count.  Byte counts NUL-inclusive per #699 discipline
  // followed elsewhere.
  //
  //   hdr_msg     : "PID PPID S CPU_TICKS START CMD\n"
  //                                        31 bytes + NUL = 32  (paideia-os#2431:
  //                                        RSS column dropped, was 35 + NUL = 36)
  //   sp_msg      : " "                    1 byte  + NUL =  2
  //   nl_msg      : "\n"                   1 byte  + NUL =  2
  //   task_prefix : "task"                 4 bytes + NUL =  5
  // ==========================================================================
  pub let hdr_msg     : [u8; 32] = "PID PPID S CPU_TICKS START CMD\n\0"
  pub let hdr_len     : u64     = 31
  pub let sp_msg      : [u8; 2]  = " \0"
  pub let sp_len      : u64     = 1
  pub let nl_msg      : [u8; 2]  = "\n\0"
  pub let nl_len      : u64     = 1
  pub let task_prefix : [u8; 5]  = "task\0"
  pub let task_prefix_len : u64 = 4

  // paideia-os#2453 (Wave 12): -f header + TTY placeholder string.
  //
  // hdr_msg_f: "UID PID PPID S CPU_TICKS STIME TTY CMD\n"
  //            39 bytes + NUL = 40. Same column ordering as POSIX ps
  //            -f (UID first, TTY between STIME and CMD); the START
  //            column of the default header becomes STIME here (same
  //            underlying start_tick value, name closer to POSIX).
  // tty_msg  : "tty0"  4 bytes + NUL = 5. Emitted verbatim for every
  //            task under -f; see file-header §Wave 12 for the honest-
  //            lie caveat when a future task is re-parented to a pipe.
  pub let hdr_msg_f   : [u8; 40] = "UID PID PPID S CPU_TICKS STIME TTY CMD\n\0"
  pub let hdr_f_len   : u64     = 39
  pub let tty_msg     : [u8; 5]  = "tty0\0"
  pub let tty_len     : u64     = 4

  // paideia-os#2453 (Wave 12): flag bit-mask constants + BSS
  // accumulator. Kept as module-level consts for documentation --
  // the code uses the literal integer via `mov rdx, imm; and rax, rdx`
  // (encoder-gap discipline forbids `and rN, imm64` on r8-r15).
  pub let PS_FLAG_A : u64 = 1
  pub let PS_FLAG_E : u64 = 2
  pub let PS_FLAG_F : u64 = 4

  // Flag accumulator, populated by Phase -1 and read by every flag-
  // branch site in _start (header emit, per-record UID emit, per-
  // record TTY emit). BSS rather than a callee-save reg because the
  // walk phase already claims r12 for the loop counter and adding a
  // second callee-save carrier would force spill/reload discipline
  // around every helper CALL.
  pub let mut _ps_flags : u64 = uninit @align(8)

  // ==========================================================================
  // print_u64_dec(value: u64) -> ()
  //
  // Verbatim shape of init.pdx §print_u64_dec (R17-M2-736 D12 / paideia-as
  // #736): divide-by-10 loop on a 24-byte stack scratch, then a single
  // sys_write emits the [first_digit, length] slice.  Zero handled as a
  // special case (writes a single '0').  Uses sys_write(fd=1, buf, len)
  // rather than sys_debug_puts because ps is meant to land its output on
  // stdout (fd 1) rather than always on the raw UART; when the shell
  // fork-execs ps, the inherited fd 1 already resolves to /dev/tty0 via
  // init's boot-time dup2 chain, so at R17-R57 the two share a wire path
  // but the fd-based emit keeps ps compatible with any future shell that
  // wires stdout to a pipe or a file.
  //
  // SysV register discipline:
  //   Reads    : rdi (value)
  //   Preserves: rbx, rbp, r12-r15 (callee-save)
  //   Clobbers : rax, rcx, rdx, rsi, rdi, r8, r9, r10, r11
  //   Stack    : 24 bytes (20 digits max for u64::MAX + 4 for 16-B align)
  // ==========================================================================
  pub let print_u64_dec : (u64) -> () !{mem, sysreg} @{fs} =
    fn (value: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {fs},
      justification: "R57.M4-003 (#1799): u64 -> decimal ASCII for ps output. Verbatim shape of init.pdx §print_u64_dec (R17-M2-736 D12 / #736) -- divide-by-10 loop stashes digits right-to-left in a 24-byte stack scratch, then one sys_write emits the [first_digit, len] slice. Zero fast-paths to a single '0' digit. u64-wide (matches kernel u64_to_dec at hex.pdx §77) although ps at M0 only passes u32-range values (pid/ppid/state all u32). Uses sys_write(fd=1) rather than sys_debug_puts because ps writes to stdout and inherits the shell's fd 1 -- at R17-R57 this resolves to /dev/tty0 via init's dup2 chain, but the fd path composes with a future pipe or file re-target. Effect union: {mem} for stack writes + string reads; {sysreg} for the syscall; @{fs} for the sys_write path (matches syscall_shim.pdx's own declared row for sys_write in the shell/init tree). Callee-save regs (r12-r15) untouched so _start can hold the loop counter in r12 across the call.",
      block: {
        // 24-byte stack scratch (20 digits max + 4-byte 16-B-align slop).
        sub rsp, 24;

        // Zero special case.
        cmp rdi, 0;
        jne pud_divide_setup;
          // value == 0 -> single '0' digit, emit and return.
          mov al, 0x30;                   // ASCII '0'
          mov [rsp], al;
          // sys_write(1, buf=&scratch, count=1)
          mov rsi, rsp;                   // buf
          mov rdi, 1;                     // fd = stdout
          mov rdx, 1;                     // count
          mov rax, 1;                     // SC+ ID 1 = sys_write
          syscall;
          add rsp, 24;
          ret;

        pud_divide_setup:
          mov r9, rdi;                    // r9  = remaining value
          mov r10, rsp;
          add r10, 19;                    // r10 = cursor at last staging byte

        pud_loop_top:
          mov rax, r9;
          mov rcx, 10;
          xor rdx, rdx;                   // zero-extend rdx:rax for div
          div rcx;                        // rax = quotient, rdx = remainder
          add rdx, 0x30;                  // digit -> ASCII '0'..'9'
          mov [r10], dl;                  // store at cursor
          mov r9, rax;                    // r9 = quotient
          cmp r9, 0;
          je pud_loop_done;
          sub r10, 1;                     // advance cursor left
          jmp pud_loop_top;

        pud_loop_done:
          // r10 points at first (MSB) digit.  Length = (rsp + 20) - r10.
          mov rax, rsp;
          add rax, 20;
          sub rax, r10;                   // rax = digit count
          // sys_write(1, buf=r10, count=rax)
          mov rdx, rax;                   // count
          mov rsi, r10;                   // buf
          mov rdi, 1;                     // fd = stdout
          mov rax, 1;                     // SC+ ID 1 = sys_write
          syscall;
          add rsp, 24;
          ret
      }
    } @no_frame

  // ==========================================================================
  // write_bytes(buf: u64, len: u64) -> ()  -- sys_write(1, buf, len) wrapper
  //
  // Marshals SysV args (rdi=buf, rsi=len) into the sys_write shape
  // (rdi=fd=1, rsi=buf, rdx=len, rax=1).  A one-line helper rather than
  // inlining the three-mov + syscall at every call site because ps
  // emits eleven rodata slices per ps_record and the wrapper collapses
  // that to eleven `call write_bytes` at 5 bytes each vs. eleven
  // 12-byte inline sequences.
  // ==========================================================================
  pub let write_bytes : (u64, u64) -> () !{mem, sysreg} @{fs} =
    fn (buf: u64) (len: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {fs},
      justification: "R57.M4-003 (#1799): sys_write(1, buf, len) wrapper for ps output. rdi=buf, rsi=len at entry; sys_write wants rdi=fd, rsi=buf, rdx=count, rax=sysno. Three-move shuffle + syscall. Callee-save clean; caller holds loop state in r12 across this call. sys_write's own return value (bytes written or errno) is discarded here -- ps at M0 does not retry short writes; the tty backend under /dev/tty0 does not short-write at R17-R57 (see src/kernel/core/tty/ for the UART TX path).",
      block: {
        mov rdx, rsi;                     // count = len
        mov rsi, rdi;                     // buf   = original rdi
        mov rdi, 1;                       // fd    = stdout
        mov rax, 1;                       // SC+ ID 1 = sys_write
        syscall;
        ret
      }
    } @no_frame

  // ==========================================================================
  // _start -- ps entry point.
  //
  // Sequence:
  //   (1) Emit header line ("PID PPID S CMD\n").
  //   (2) Loop idx = 0..64:
  //         a. sys_taskinfo(idx, &ps_record).
  //         b. rax == 0     -> print ps_record, advance.
  //         c. rax == -ENOENT -> skip (empty slot), advance.
  //         d. rax == any other errno (incl. -ESRCH) -> break loop.
  //       The safety cap `cmp r12, 64` guards against an M1 syscall
  //       that ever grew a bound; without the cap a syscall bug could
  //       hang ps forever.
  //   (3) sys_exit(0).
  //
  // Record parse:
  //   [ps_record + 0]  pid (u32)
  //   [ps_record + 4]  ppid (u32)
  //   [ps_record + 8]  state (u32, low byte meaningful)
  //   [ps_record + 16] name[16] (paideia-os#2431: real comm[]; 0 -> synth 'task<pid>')
  //   [ps_record + 32] cpu_ticks (u64)  -- R60.M7-002 (#1817)
  //   [ps_record + 40] rss_pages (u64)  -- always 0 (#1817 deferred, #2431 column dropped)
  //   [ps_record + 48] start_tick (u64) -- R60.M7-002 (#1817)
  //
  // Per-ps_record emit (paideia-os#2431: no RSS field, CMD from comm[]):
  //   <pid> ' ' <ppid> ' ' <state> ' ' <cpu_ticks> ' ' <start_tick> ' '
  //   ( <name[0..strlen]>  if name[0] != 0  else  "task" <pid> ) '\n'
  //
  // All prints go through write_bytes / print_u64_dec so an M2 pipe
  // hook-up (grep-style filter) works transparently.
  // ==========================================================================
  pub let _start : () -> () !{mem, sysreg} @{fs, sched} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {fs, sched},
      justification: "R57.M4-003 (#1799) + R60.M7-002 (#1817) + paideia-os#2431 + paideia-os#2453 (Wave 12): /bin/ps _start. Iterates the task pool via sys_taskinfo(83), formats one line per live task on stdout. Inlines the three syscalls it needs (SC+ ID 1 sys_write via write_bytes, SC+ ID 83 sys_taskinfo, SC+ ID 60 sys_exit) so the binary is self-contained (no syscall_shim link dependency, no collision with init.elf / shell.elf object sets -- same pattern as child_hello.pdx / true.pdx per R15-M6-009 / #560 and R17.M5 / #638). r12 holds the loop counter (callee-save, survives every nested call). Loop termination has TWO gates: primary is `rax == -ENOENT -> skip / other errno -> stop` after each sys_taskinfo, secondary is `cmp r12, 64; jae done` at the top -- the primary catches the honest -ESRCH from the syscall, the secondary is defensive against any future drift in the syscall's own bound. #1817 widened the per-record emit with two visible u64 columns (cpu_ticks @ +32 and start_tick @ +48), read via full-width `mov rdi, [rax + k]` (not the zero-extending `mov edi` the u32 pid/ppid/state columns use) and printed through the same print_u64_dec helper. paideia-os#2431 (2026-09): (a) drops the RSS column entirely from the visible header + per-record emit — the ps_record slot at +40 stays reserved but reads 0, and shipping an always-zero column reads as 'this task uses no memory' rather than 'we deferred the honest walk' (see task_info.pdx §rss_pages for why the aspace walk is not attempted at R60; a future PML4 walker restores the visible column without renegotiating the record layout). (b) wires the CMD column to the real 16-byte name field at ps_record[16..32] (populated by task_info.pdx from TCB.comm @+464, which sys_execve_shim.pdx Phase 8.5 stamps with the basename of every successfully-execve'd path). If ps_record[16] is non-zero, emit bytes 0..strlen (bounded at 16); else fall back to the pre-#2431 synthetic `task<pid>` rendering — the exact one-branch pivot the file header pre-announced. Bytes-per-record scan uses two `mov_b` loops (one to sniff byte 0 for the branch, one to compute strlen); both xor-then-mov_b idiom for zero-extension since mov_b does not implicitly zero-extend. Callee-save clean at every branch: write_bytes and print_u64_dec both preserve r12 per their own justifications. No cpu% column: deriving one needs a 'read the current tick count' syscall this milestone does not add, so the raw cpu_ticks/start_tick pair is printed for the operator to derive a ratio from. paideia-os#2453 (Wave 12, 2026-09): POSIX-lite flag suite. Phase -1 scans argv[1..] for combined single-char flag args and accumulates bits into _ps_flags: -a (FLAG_A=1, no-op today; default is already 'all'), -e (FLAG_E=2, POSIX 'every process' synonym for -a, also no-op today), -f (FLAG_F=4, full format — prepends UID column and inserts TTY column before CMD; header line switches from hdr_msg to hdr_msg_f which renames START to STIME). Combined forms (`-af`, `-fe`, `-aef`) work by iterating flag-char bytes until NUL. `--` is the end-of-flags sentinel (subsequent args unconditionally ignored — ps takes no positional args at this landing). Unknown flag chars silently ignored (MVP posture, matches ls v1.2 #2452). Phase -1 uses transient regs (rbx=argc, r13=argv, r14=post_dashdash sticky) that all die at end of parse — none conflict with the walk phase's r12 (loop counter) claim. Header emit branches on FLAG_F: default header 31 bytes vs -f header 39 bytes. Per-record emit branches twice on FLAG_F: (a) at ps_print_record entry, emit '<uid> ' before pid (uid hardcoded to 0 — kernel task_info has no uid field at R60; see file-header §Wave 12 placeholders); (b) just before CMD, emit 'tty0 ' (tty likewise hardcoded — kernel task_info has no controlling-tty field). Both placeholders are documented as follow-on kernel work in the file header §Wave 12; when task_info's 64-byte record grows uid @+56 and tty[8]@+64, these emit sites swap the immediate loads for full-width mov loads with no other layout change. Encoder-gap discipline: every flag-bit test uses `mov rax, [rip+_ps_flags]; mov rdx, imm; and rax, rdx; cmp rax, 0` (no `and rN, imm64` on high regs, no `test rN, rN`); byte peeks use `xor rax, rax; mov_b rax, [ptr]`. Reserved-label discipline: every new label prefixed ps_ (ps_parse_top, ps_parse_flag_chars, ps_flag_char_top, ps_flag_char_done, ps_set_a, ps_set_e, ps_set_f, ps_flag_char_next, ps_parse_arg_ignore, ps_parse_done, ps_hdr_full, ps_hdr_done, ps_emit_uid_done, ps_emit_tty_done). Effect union: {mem, sysreg} for the syscalls + memory reads/writes; @{fs, sched} matches the union of sys_write ({fs}) and sys_exit ({sched}) per src/user/syscall_shim.pdx.",
      block: {
        // ============================================================
        // Phase -1 (paideia-os#2453, Wave 12) -- argv flag scan.
        //
        // On execve entry rdi=argc, rsi=argv, rdx=envp per the frozen
        // execve ABI (design/user/execve-abi.md). ps ignores envp.
        //
        // Transient reg plan (all die at end of Phase -1, none clash
        // with the walk phase's r12 loop-counter claim):
        //   rbx = argc
        //   r13 = argv base
        //   r14 = post_dashdash sticky flag (0/1)
        //   rcx = argv index (starts at 1, skipping argv[0])
        //   r15 = current argv[rcx] pointer
        //   r9  = per-arg flag-char cursor
        // ============================================================
        mov rbx, rdi;                     // rbx = argc
        mov r13, rsi;                     // r13 = argv base

        // Zero _ps_flags and post_dashdash; init argv index to 1.
        xor rax, rax;
        mov [rip + _ps_flags], rax;
        xor r14, r14;                     // r14 = post_dashdash
        mov rcx, 1;

      ps_parse_top:
        cmp rcx, rbx;
        jae ps_parse_done;
        mov r15, [r13 + rcx*8];           // r15 = argv[rcx]

        // Post-`--` mode: unconditionally ignore (ps has no path args).
        cmp r14, 0;
        jne ps_parse_arg_ignore;

        // Peek first byte to classify.
        xor rax, rax;
        mov_b rax, [r15];
        cmp rax, 0x2D;                    // '-'
        jne ps_parse_arg_ignore;

        // Second byte: NUL -> bare "-", ignore; '-' -> could be "--".
        xor rax, rax;
        mov_b rax, [r15 + 1];
        cmp rax, 0;
        je  ps_parse_arg_ignore;
        cmp rax, 0x2D;
        jne ps_parse_flag_chars;

        // Might be "--" alone. A "--foo" is treated as a run of flag
        // chars (unknowns silently ignored, so effectively a no-op).
        xor rax, rax;
        mov_b rax, [r15 + 2];
        cmp rax, 0;
        jne ps_parse_flag_chars;

        // True "--": set sticky flag, skip this arg.
        mov r14, 1;
        add rcx, 1;
        jmp ps_parse_top;

      ps_parse_flag_chars:
        // Iterate bytes from offset 1 until NUL.
        mov r9, 1;

      ps_flag_char_top:
        xor rax, rax;
        mov_b rax, [r15 + r9*1];
        cmp rax, 0;
        je  ps_flag_char_done;
        cmp rax, 0x61;                    // 'a'
        je  ps_set_a;
        cmp rax, 0x65;                    // 'e'
        je  ps_set_e;
        cmp rax, 0x66;                    // 'f'
        je  ps_set_f;
        // Unknown flag: silently ignore for MVP.
        jmp ps_flag_char_next;

      ps_set_a:
        mov rax, [rip + _ps_flags];
        mov rdx, 1;                       // PS_FLAG_A
        or  rax, rdx;
        mov [rip + _ps_flags], rax;
        jmp ps_flag_char_next;

      ps_set_e:
        mov rax, [rip + _ps_flags];
        mov rdx, 2;                       // PS_FLAG_E
        or  rax, rdx;
        mov [rip + _ps_flags], rax;
        jmp ps_flag_char_next;

      ps_set_f:
        mov rax, [rip + _ps_flags];
        mov rdx, 4;                       // PS_FLAG_F
        or  rax, rdx;
        mov [rip + _ps_flags], rax;
        jmp ps_flag_char_next;

      ps_flag_char_next:
        add r9, 1;
        jmp ps_flag_char_top;

      ps_flag_char_done:
        add rcx, 1;
        jmp ps_parse_top;

      ps_parse_arg_ignore:
        add rcx, 1;
        jmp ps_parse_top;

      ps_parse_done:
        // rbx, r13, r14 all dead here.

        // ============================================================
        // Step 1: emit header line.
        //
        // Default: "PID PPID S CPU_TICKS START CMD\n" (31 bytes).
        // -f:      "UID PID PPID S CPU_TICKS STIME TTY CMD\n" (39 bytes).
        // ============================================================
        mov rax, [rip + _ps_flags];
        mov rdx, 4;                       // PS_FLAG_F
        and rax, rdx;
        cmp rax, 0;
        jne ps_hdr_full;

        lea rdi, [rip + hdr_msg];
        mov rsi, 31;                      // hdr_len; inlined -- paideia-as
                                           // does not resolve cross-module
                                           // let-constants at parse time
        call write_bytes;
        jmp ps_hdr_done;

      ps_hdr_full:
        lea rdi, [rip + hdr_msg_f];
        mov rsi, 39;                      // hdr_f_len (inlined; see above)
        call write_bytes;

      ps_hdr_done:

        // ============================================================
        // Step 2: iterate idx = 0..64.
        // r12 = idx counter.
        // ============================================================
        xor r12, r12;                     // idx = 0

      ps_loop:
        // Safety cap: paranoia against a drifted syscall bound.
        cmp r12, 64;
        jae ps_done;

        // sys_taskinfo(idx=r12, buf=&ps_record).
        mov rdi, r12;
        lea rsi, [rip + ps_record];
        mov rax, 83;                      // SC+ ID 83 = sys_taskinfo
        syscall;
        // rax = 0 | -ENOENT (0xFFFFFFFFFFFFFFFE) | -ESRCH (0xFFFFFFFFFFFFFFFD) |
        //       -EFAULT (0xFFFFFFFFFFFFFFF2).

        cmp rax, 0;
        je ps_print_record;

        // Error path: distinguish -ENOENT (skip) from anything else (stop).
        // Compute -rax = errno magnitude; -ENOENT gives rcx=2, -ESRCH
        // gives rcx=3, -EFAULT gives rcx=14.  Only rcx==2 continues.
        mov rcx, 0;
        sub rcx, rax;                     // rcx = -rax = errno magnitude
        cmp rcx, 2;
        je ps_advance;                    // -ENOENT -> skip this idx
        jmp ps_done;                      // -ESRCH / -EFAULT / other -> stop

      ps_print_record:
        // Emit "<pid> <ppid> <state> <cpu_ticks> <start> [tty0 ] task<pid>\n"
        // or, under -f, "<uid> <pid> <ppid> <state> <cpu_ticks> <start> tty0 <cmd>\n".
        //
        // paideia-os#2453 (Wave 12): if -f, emit "<uid> " prefix.
        // uid hardcoded to 0 (root) at this landing; kernel ps_record
        // has no uid field. See file-header §Wave 12 for the follow-
        // on that lands a real uid field at ps_record[+56].
        mov rax, [rip + _ps_flags];
        mov rdx, 4;                       // PS_FLAG_F
        and rax, rdx;
        cmp rax, 0;
        je  ps_emit_uid_done;
        mov rdi, 0;                       // uid = 0 (placeholder)
        call print_u64_dec;
        lea rdi, [rip + sp_msg];
        mov rsi, 1;
        call write_bytes;

      ps_emit_uid_done:
        // pid: load u32 from ps_record+0, print as decimal.
        lea rax, [rip + ps_record];
        mov edi, [rax + 0];               // rdi = pid (u32 zero-ext)
        call print_u64_dec;

        // separator " "
        lea rdi, [rip + sp_msg];
        mov rsi, 1;                       // sp_len
        call write_bytes;

        // ppid
        lea rax, [rip + ps_record];
        mov edi, [rax + 4];               // rdi = ppid (u32 zero-ext)
        call print_u64_dec;

        // separator " "
        lea rdi, [rip + sp_msg];
        mov rsi, 1;
        call write_bytes;

        // state (low byte of the u32 field; print full u32 for now --
        // state is always in {0..4} so decimal width is 1 char)
        lea rax, [rip + ps_record];
        mov edi, [rax + 8];               // rdi = state (u32 zero-ext)
        call print_u64_dec;

        // separator " "
        lea rdi, [rip + sp_msg];
        mov rsi, 1;
        call write_bytes;

        // cpu_ticks: full u64 load from ps_record+32 (R60.M7-002 #1817).
        // Unlike pid/ppid/state above, this is NOT zero-extended from a
        // 32-bit load -- `mov rdi, [rax + 32]` pulls the whole qword,
        // since print_u64_dec's signature is already u64-wide.
        lea rax, [rip + ps_record];
        mov rdi, [rax + 32];               // rdi = cpu_ticks (u64)
        call print_u64_dec;

        // separator " "
        lea rdi, [rip + sp_msg];
        mov rsi, 1;
        call write_bytes;

        // rss_pages column: DROPPED (paideia-os#2431). The ps_record's
        // +40 slot stays reserved and reads 0 (task_info.pdx §rss_pages
        // still defers the aspace-walk); we simply do not emit it. See
        // this file's header §"RSS column" for the reasoning + how a
        // future PML4 walker restores the column without renegotiating
        // the record layout.

        // start_tick: full u64 load from ps_record+48 (R60.M7-002 #1817).
        lea rax, [rip + ps_record];
        mov rdi, [rax + 48];               // rdi = start_tick (u64)
        call print_u64_dec;

        // separator " "
        lea rdi, [rip + sp_msg];
        mov rsi, 1;
        call write_bytes;

        // ============================================================
        // TTY column (paideia-os#2453, Wave 12). Under -f only, emit
        // 'tty0 ' between the start_tick column and the CMD column.
        // Hardcoded string (kernel ps_record has no tty field at
        // R60); see file-header §Wave 12 for the follow-on that
        // extends the record with tty[8] @+64 and swaps this
        // immediate emit for a bounded strlen+write.
        // ============================================================
        mov rax, [rip + _ps_flags];
        mov rdx, 4;                       // PS_FLAG_F
        and rax, rdx;
        cmp rax, 0;
        je  ps_emit_tty_done;
        lea rdi, [rip + tty_msg];
        mov rsi, 4;                       // tty_len (inlined)
        call write_bytes;
        lea rdi, [rip + sp_msg];
        mov rsi, 1;
        call write_bytes;

      ps_emit_tty_done:
        // ============================================================
        // CMD column (paideia-os#2431). Read the u8 name field at
        // ps_record[16..32] (populated by task_info.pdx from TCB.comm
        // @+464, which sys_execve_shim.pdx Phase 8.5 stamps with the
        // basename of every successfully-execve'd path). If byte 0 is
        // non-zero, emit bytes 0..strlen (bounded at 16). Otherwise
        // fall back to the pre-#2431 synthetic `task<pid>` rendering
        // for tasks that have never execve'd (init before its first
        // exec, kernel witness TCBs).
        //
        // No new syscalls, no new .bss scratch: the name lives inline
        // in the ps_record already, so both the length scan and the
        // one write_bytes call operate on ps_record[16] directly. All
        // scratch is caller-save (rax/rcx/rdx/rdi/rsi); r12 (idx
        // counter) survives because write_bytes / print_u64_dec are
        // both callee-save clean per their own justifications.
        // ============================================================
        lea rax, [rip + ps_record];
        add rax, 16;                       // rax = &ps_record.name[0]
        xor rcx, rcx;
        mov_b rcx, [rax];                  // rcx = name[0]
        cmp rcx, 0;
        je ps_emit_cmd_synth;

        // --- comm path: compute strlen (<=16) then one write ---
        xor rcx, rcx;                      // rcx = i (bytes counted)
      ps_emit_cmd_comm_len:
        cmp rcx, 16;
        jae ps_emit_cmd_comm_write;
        xor rdx, rdx;
        mov_b rdx, [rax];
        cmp rdx, 0;
        je ps_emit_cmd_comm_write;
        add rax, 1;                        // walk forward
        add rcx, 1;
        jmp ps_emit_cmd_comm_len;
      ps_emit_cmd_comm_write:
        // Restore &ps_record.name[0] for the write_bytes call; length in rcx.
        lea rdi, [rip + ps_record];
        add rdi, 16;                       // rdi = &name[0]
        mov rsi, rcx;                      // rsi = strlen (<= 16)
        call write_bytes;
        jmp ps_emit_cmd_done;

      ps_emit_cmd_synth:
        // --- synthetic "task<pid>" fallback ---
        lea rdi, [rip + task_prefix];
        mov rsi, 4;                       // task_prefix_len
        call write_bytes;
        lea rax, [rip + ps_record];
        mov edi, [rax + 0];               // rdi = pid (u32 zero-ext)
        call print_u64_dec;

      ps_emit_cmd_done:
        // newline
        lea rdi, [rip + nl_msg];
        mov rsi, 1;                       // nl_len
        call write_bytes;

      ps_advance:
        add r12, 1;
        jmp ps_loop;

      ps_done:
        // sys_exit(0)
        mov rdi, 0;                       // status = 0
        mov rax, 60;                      // SC+ ID 60 = sys_exit
        syscall;
        // Unreachable; sys_exit does not return.  Defensive hlt for the
        // impossible fallthrough (matches true.pdx / child_hello.pdx).
        hlt
      }
    }

}
