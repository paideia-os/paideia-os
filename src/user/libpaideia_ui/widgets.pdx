// src/user/libpaideia_ui/widgets.pdx -- Wave0-B10-09 (paideia-os #2327)
//
// G12.M1-002: IMMEDIATE-MODE WIDGETS (button / label / slider / checkbox).
//
// Design authority: design/roadmap/next-wave-softarch.md §G12 toolkit
// stack and design/roadmap/next-wave-synthesis.md line 99. This file
// builds the FIRST widget layer atop the KIND_UI_CONTEXT root that
// landed at Wave0-B8-05 (immediate_context.pdx, KIND=0x1D5).
//
// NOVEL-CLEAN POSTURE.  Straight egui-shape immediate mode: each widget
// is a single function call that returns its interaction result at the
// call site. There is NO widget struct, NO callback registration, NO
// tree diff. Every frame the client re-issues the whole widget list;
// widgets read hover/click routing state from the enclosing KIND_UI_
// CONTEXT row and return WR_* enum values immediately. This is the
// "cheap to reason about" property egui gets from immediate mode --
// the widget IS the call.
//
// -----------------------------------------------------------------------------
// FRAME-LIFECYCLE CONTRACT
// -----------------------------------------------------------------------------
//
// Every widget call MUST occur between a matching pair of
// ui_context_begin_frame / ui_context_end_frame on the same context row
// (immediate_context.pdx §Section 4). This file does not re-assert
// frame_in_progress at every widget entry -- the widget-id counter
// gate embedded in ui_context_allocate_id already refuses on an
// exhausted counter, and allocate_id is tolerant of frame_in_progress
// == 0 (per the "library helper pre-populates a sentinel" note in the
// B8-05 header). A future G12.M1-004 landing may promote R_UI_ADD_
// WIDGET to a hard gate at the dispatch layer; until then a client
// bug that skips begin_frame is caught by allocate_id's overflow when
// a stale counter rolls, not by this file.
//
// -----------------------------------------------------------------------------
// WIDGET RECT
// -----------------------------------------------------------------------------
//
// Widgets consume a WidgetRect passed BY POINTER (rect_ptr: u64). The
// rect is a 16-byte structure laid out as four contiguous i32 fields
// in the caller's frame (or wherever the client stored it):
//
//   [+0]  x : i32
//   [+4]  y : i32
//   [+8]  w : i32
//   [+12] h : i32
//
// x/y are widget-local screen-space coordinates (units follow the
// surface's DPI-scale convention -- G12.M2 will pin the transform
// authority when the renderer wires in). w/h are widget extents in the
// same units; negative w or h are refused (WIDGETS_BAD_RECT).
//
// Pass-by-pointer keeps every widget signature <= 5 u64 args, well
// inside the SysV register-argument budget (rdi..r8), avoiding stack-
// arg emission on any widget. The client typically stack-allocates the
// rect immediately before the widget call:
//
//     let r : WidgetRect = { x: 10, y: 20, w: 120, h: 24 };
//     let event = widget_button(&mut ctx, &r, LBL_OK);
//
// -----------------------------------------------------------------------------
// WIDGET-ID + ROUTING
// -----------------------------------------------------------------------------
//
// Each widget claims a fresh widget_id via ui_context_allocate_id (a
// call INTO immediate_context.pdx that this file uses as its only
// upstream dependency for interaction wiring). The id is then used as
// the routing key for two queries:
//
//   - ui_context_is_hovered(row_id, widget_id) -> bool
//   - ui_context_was_clicked(row_id, widget_id) -> bool
//
// Both routing slots (hover_widget_id and click_widget_id in the ctx
// row's body3/body4) are pre-populated by KIND_INPUT_ROUTE routing
// (G12.M1-003, landing under paideia-os #2328) between end_frame of
// frame N-1 and begin_frame of frame N. Until G12.M1-003 lands, both
// slots stay 0 across a frame -- widgets read this as "nothing hovered,
// nothing clicked" and every widget on this landing therefore returns
// WR_NONE. That is the honest state: interaction wiring is a follow-on
// milestone, and this file lands the widget SHAPE + return-value
// contract that the renderer wire (G12.M1-004) and the routing wire
// (G12.M1-003) attach to.
//
// -----------------------------------------------------------------------------
// PAINT
// -----------------------------------------------------------------------------
//
// widget_paint_rect(ctx, rect_ptr, color) is a PLACEHOLDER painter.
// The real KIND_SURFACE painting path is a G12.M2 landing (kind_
// framebuffer draw ops); this landing bumps a paint-call counter
// (widgets_stats[WIDGETS_ST_PAINTS]) so a smoke witness can prove the
// widget bodies ran without a live rasterizer. The widget bodies below
// (widget_button / _label / _slider / _checkbox) each call the
// painter, so the counter reflects the widget-body execution count
// once G12.M2 wires the real draw calls under the same signature.
//
// -----------------------------------------------------------------------------
// WIDGET-BY-WIDGET SHAPE
// -----------------------------------------------------------------------------
//
//   widget_button(ctx, rect, label_offset) -> WR_NONE | WR_HOVERED | WR_CLICKED
//     Allocates a widget_id, paints (border + fill + centered label
//     placeholder), returns WR_CLICKED if was_clicked, else WR_HOVERED
//     if is_hovered, else WR_NONE.
//
//   widget_label(ctx, rect, text_offset, text_len) -> ()
//     No result. Just paints text into the rect. Purely decorative
//     (labels never claim a widget_id -- they are inert on the routing
//     side, matching egui::Label's no-response default).
//
//   widget_slider(ctx, rect, value_ptr, min_val, max_val)
//     -> WR_NONE | WR_HOVERED | WR_ACTIVE | WR_CHANGED
//     Allocates a widget_id, clamps *value_ptr to [min_val, max_val]
//     (an unconditional invariant honored on every call, even without
//     interaction), paints the track + thumb placeholder, and if
//     was_clicked bumps *value_ptr by one step (placeholder for real
//     drag semantics that land with G12.M1-003 pointer routing).
//     Returns WR_CHANGED if the final value differs from the initial
//     value, else WR_ACTIVE if was_clicked without value change, else
//     WR_HOVERED / WR_NONE by the same priority as widget_button.
//
//   widget_checkbox(ctx, rect, label_offset, state_ptr)
//     -> WR_NONE | WR_HOVERED | WR_CHANGED
//     Allocates a widget_id, paints the box (checked/unchecked) and
//     the trailing label placeholder, and if was_clicked toggles
//     *state_ptr (XOR bit 0). Returns WR_CHANGED if toggled, else
//     WR_HOVERED / WR_NONE.
//
// -----------------------------------------------------------------------------
// FAILURE TAXONOMY 0xFFFFEC90..0xFFFFEC9F
// -----------------------------------------------------------------------------
//
// Repo-wide grep at landing time shows the 0xFFFFEC90..0xFFFFEC9F page
// entirely unclaimed across src/ and design/. 16 slots give headroom
// past the immediate 5 refusal cases; the unused low half is reserved
// for G12.M1-003/-004 follow-ups (WIDGETS_ROUTE_UNBOUND, WIDGETS_
// PAINT_UNAVAILABLE, ...).
//
// Widget entry points return WidgetResult (a u64 enum in {0,1,2,3,4}),
// NOT a sentinel. On any refusal the entry point (a) bumps _widgets_
// stats[WIDGETS_ST_REFUSED] once, then (b) collapses the return to
// WR_NONE (== 0). The WIDGETS_* sentinels below are constants used
// internally for reasoning parity with sibling modules; external
// observers read the refused counter, not a returned sentinel.
//
// -----------------------------------------------------------------------------
// ARITHMETIC / ENCODER DISCIPLINE
// -----------------------------------------------------------------------------
//
// No float, no FPU (design/kernel/no-fpu.md). i32 comparisons use the
// unsigned-bias trick from damage_kind.pdx (XOR each operand with
// 0x80000000, compare unsigned) so the encoder's mnemonic table need
// not include movsx/movsxd. All 32-bit loads use `mov_d rax, [mem]`
// (zero-extending); all 32-bit stores use `mov_d [mem], reg`. Row
// offsets are computed via `shl r, imm` rather than `imul r,r,imm`
// (same encoder-conservative posture as immediate_context.pdx).

module Widgets = structure {

  // ==========================================================================
  // Section 1  Return enum + failure taxonomy.
  // ==========================================================================

  pub let WR_NONE     : u64 = 0
  pub let WR_HOVERED  : u64 = 1
  pub let WR_CLICKED  : u64 = 2
  pub let WR_ACTIVE   : u64 = 3
  pub let WR_CHANGED  : u64 = 4

  // Failure sentinels 0xFFFFEC90..0xFFFFEC9F. Not returned from the
  // widget entry points (which collapse to WR_NONE on refusal per the
  // header) but reserved for the G12.M1-003/-004 follow-ups that
  // promote widget calls onto the dispatcher and can surface a distinct
  // sentinel through op_status.
  pub let WIDGETS_OK             : u64 = 0
  pub let WIDGETS_BAD_SLOT       : u64 = 0xFFFFEC9F   // row_id >= UI_MAX
  pub let WIDGETS_BAD_RECT       : u64 = 0xFFFFEC9E   // rect_ptr == 0 OR w<0 OR h<0
  pub let WIDGETS_BAD_PTR        : u64 = 0xFFFFEC9D   // value_ptr / state_ptr == 0
  pub let WIDGETS_BAD_RANGE      : u64 = 0xFFFFEC9C   // slider: min > max
  pub let WIDGETS_ID_FAIL        : u64 = 0xFFFFEC9B   // allocate_id refused
  // 0xFFFFEC90..0xFFFFEC9A reserved.

  // WidgetRect layout constants. Rect is 16 bytes at rect_ptr:
  //   [+0]  x  : i32
  //   [+4]  y  : i32
  //   [+8]  w  : i32
  //   [+12] h  : i32
  pub let WIDGETS_RECT_BYTES     : u64 = 16
  pub let WIDGETS_RECT_OFF_X     : u64 = 0
  pub let WIDGETS_RECT_OFF_Y     : u64 = 4
  pub let WIDGETS_RECT_OFF_W     : u64 = 8
  pub let WIDGETS_RECT_OFF_H     : u64 = 12

  // Slider step size for the placeholder click-advances-value semantics.
  // Real drag semantics land with G12.M1-003 pointer routing.
  pub let WIDGETS_SLIDER_STEP    : u64 = 1

  // ==========================================================================
  // Section 2  Counters.
  // ==========================================================================
  //
  // Small stats vector for smoke-witness observability. Four u64s:
  //   [WIDGETS_ST_PAINTS]   -- widget_paint_rect calls (all widget
  //                            bodies invoke this once, so also a
  //                            proxy for widget-body execution count).
  //   [WIDGETS_ST_CLICKED]  -- widgets that returned WR_CLICKED.
  //   [WIDGETS_ST_CHANGED]  -- widgets that returned WR_CHANGED.
  //   [WIDGETS_ST_REFUSED]  -- refused entry-point invocations.

  pub let mut _widgets_stats : [u64; 4] = uninit @align(64)

  pub let WIDGETS_ST_PAINTS   : u64 = 0
  pub let WIDGETS_ST_CLICKED  : u64 = 1
  pub let WIDGETS_ST_CHANGED  : u64 = 2
  pub let WIDGETS_ST_REFUSED  : u64 = 3

  pub let widgets_stats_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-09 (#2327): clear counter vector at boot. Four u64 slots. Labels prefixed widgets_sr_.",
      block: {
        lea r10, [rip + _widgets_stats];
        xor rax, rax;
        xor rcx, rcx;
      widgets_sr_top:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  widgets_sr_top;
        ret
      }
    }

  pub let widgets_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-09 (#2327): counter bump. Encoder-conservative load-inc-store; no `add reg,[mem]`. Labels prefixed widgets_nt_.",
      block: {
        cmp rdi, 4;
        jae widgets_nt_out;
        lea r10, [rip + _widgets_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      widgets_nt_out:
        ret
      }
    }

  pub let widgets_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-09 (#2327): counter read. Labels prefixed widgets_st_.",
      block: {
        cmp rdi, 4;
        jae widgets_st_zero;
        lea r10, [rip + _widgets_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      widgets_st_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Section 3  Rect readers.
  // ==========================================================================
  //
  // widgets_rect_x / _y / _w / _h read one i32 field from a rect. The
  // 32-bit load uses `mov_d` (zero-extending) -- callers that need the
  // signed value sign-extend at the call site via the unsigned-bias
  // trick, matching damage_kind_i32_min/_max.
  //
  // Refuses rect_ptr == 0 by returning 0. A widget entry point checks
  // rect_ptr against 0 in its own gate and refuses before dereferencing;
  // these helpers stay tolerant so a placeholder call site can probe a
  // NULL rect without a crash.

  pub let widgets_rect_x : (u64) -> u64 !{mem} @{} =
    fn (rect_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-09 (#2327): read rect.x (i32) at [ptr+0]. NULL-tolerant. Labels prefixed widgets_rx_.",
      block: {
        cmp rdi, 0;
        je  widgets_rx_zero;
        mov_d rax, [rdi + 0];
        ret;
      widgets_rx_zero:
        xor rax, rax;
        ret
      }
    }

  pub let widgets_rect_y : (u64) -> u64 !{mem} @{} =
    fn (rect_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-09 (#2327): read rect.y (i32) at [ptr+4]. NULL-tolerant. Labels prefixed widgets_ry_.",
      block: {
        cmp rdi, 0;
        je  widgets_ry_zero;
        mov_d rax, [rdi + 4];
        ret;
      widgets_ry_zero:
        xor rax, rax;
        ret
      }
    }

  pub let widgets_rect_w : (u64) -> u64 !{mem} @{} =
    fn (rect_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-09 (#2327): read rect.w (i32) at [ptr+8]. NULL-tolerant. Labels prefixed widgets_rw_.",
      block: {
        cmp rdi, 0;
        je  widgets_rw_zero;
        mov_d rax, [rdi + 8];
        ret;
      widgets_rw_zero:
        xor rax, rax;
        ret
      }
    }

  pub let widgets_rect_h : (u64) -> u64 !{mem} @{} =
    fn (rect_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-09 (#2327): read rect.h (i32) at [ptr+12]. NULL-tolerant. Labels prefixed widgets_rh_.",
      block: {
        cmp rdi, 0;
        je  widgets_rh_zero;
        mov_d rax, [rdi + 12];
        ret;
      widgets_rh_zero:
        xor rax, rax;
        ret
      }
    }

  // widgets_rect_valid: 1 iff rect_ptr != 0 AND (w bit-pattern's sign
  // bit clear) AND (h bit-pattern's sign bit clear). Sign check is via
  // the top bit of the low 32 bits: bit 31 == 0 <=> i32 >= 0.
  pub let widgets_rect_valid : (u64) -> u64 !{mem} @{} =
    fn (rect_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-09 (#2327): 1 iff rect_ptr != 0 AND w >= 0 AND h >= 0 (bit 31 == 0 of each). Encoder-conservative: bit-31 test via `and rax, 0x80000000; cmp rax, 0; jne no`. Labels prefixed widgets_rv_.",
      block: {
        cmp rdi, 0;
        je  widgets_rv_no;
        // Check w (at +8) sign bit.
        mov_d rax, [rdi + 8];
        mov r10, 0x80000000;
        and rax, r10;
        cmp rax, 0;
        jne widgets_rv_no;
        // Check h (at +12) sign bit.
        mov_d rax, [rdi + 12];
        mov r10, 0x80000000;
        and rax, r10;
        cmp rax, 0;
        jne widgets_rv_no;
        mov rax, 1;
        ret;
      widgets_rv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Section 4  i32 clamp.
  // ==========================================================================
  //
  // widgets_i32_clamp(v, min_v, max_v) -> clamp(v, min_v, max_v) as u32
  // bit-pattern in the low 32 bits of rax. Uses the unsigned-bias trick
  // (XOR with 0x80000000) for signed compare, matching damage_kind_
  // i32_min / damage_kind_i32_max. If min_v > max_v (bad range), the
  // returned value is v unmodified -- the caller (widget_slider) has
  // already gated on WIDGETS_BAD_RANGE and short-circuited before
  // reaching this helper; the tolerant behaviour here documents that
  // the primitive itself does not enforce range ordering.

  pub let widgets_i32_clamp : (u64, u64, u64) -> u64 !{} @{} =
    fn (v: u64) (min_v: u64) (max_v: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B10-09 (#2327): clamp i32 v to [min_v, max_v] via unsigned-bias trick (mask u32, xor 0x80000000, unsigned compare). Two branches: v < min -> return min; v > max -> return max; else return v. All returned values masked to u32. Labels prefixed widgets_cl_.",
      block: {
        // biased_v in r10.
        mov r10, rdi;
        mov r11, 0xFFFFFFFF;
        and r10, r11;
        mov r11, 0x80000000;
        xor r10, r11;

        // biased_min in r8.
        mov r8, rsi;
        mov r11, 0xFFFFFFFF;
        and r8, r11;
        mov r11, 0x80000000;
        xor r8, r11;

        // biased_max in r9.
        mov r9, rdx;
        mov r11, 0xFFFFFFFF;
        and r9, r11;
        mov r11, 0x80000000;
        xor r9, r11;

        // v < min?  (biased_v < biased_min)
        cmp r10, r8;
        jb  widgets_cl_ret_min;

        // v > max?  (biased_v > biased_max)
        cmp r10, r9;
        ja  widgets_cl_ret_max;

        // In range: return v as u32.
        mov rax, rdi;
        mov r11, 0xFFFFFFFF;
        and rax, r11;
        ret;

      widgets_cl_ret_min:
        mov rax, rsi;
        mov r11, 0xFFFFFFFF;
        and rax, r11;
        ret;

      widgets_cl_ret_max:
        mov rax, rdx;
        mov r11, 0xFFFFFFFF;
        and rax, r11;
        ret
      }
    }

  // ==========================================================================
  // Section 5  widget_paint_rect (placeholder).
  // ==========================================================================
  //
  // widget_paint_rect(row_id, rect_ptr, color)
  //
  // Placeholder painter. Real KIND_SURFACE draw ops land with G12.M2
  // (kind_framebuffer draw wire). Until then this helper:
  //   (a) refuses NULL rect (no counter bump -- silent no-op),
  //   (b) bumps WIDGETS_ST_PAINTS on every non-NULL invocation,
  //   (c) returns () with no observable state change beyond the counter.
  // The row_id / color arguments are consumed for ABI shape parity with
  // the future real signature (which will hand row_id to a surface_
  // commit_draw_rect delegate and color to the pixel writer).

  pub let widget_paint_rect : (u64, u64, u64) -> () !{mem} @{} =
    fn (row_id: u64) (rect_ptr: u64) (color: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-09 (#2327): placeholder painter -- bumps WIDGETS_ST_PAINTS. rect_ptr NULL is silent no-op. row_id / color unused in this landing; ABI shape matches the future kind_framebuffer draw-rect wire (G12.M2). Zero callee-save pushes needed (only one nested call, entry rsp%16 == 8; add sub rsp,8 to reach rsp%16 == 0 for the note call). Labels prefixed widgets_pr_.",
      block: {
        cmp rsi, 0;
        je  widgets_pr_out_raw;
        sub rsp, 8;
        mov rdi, 0;                       // WIDGETS_ST_PAINTS
        call widgets_note;
        add rsp, 8;
      widgets_pr_out_raw:
        ret
      }
    }

  // ==========================================================================
  // Section 6  widget_label.
  // ==========================================================================
  //
  // widget_label(row_id, rect_ptr, text_offset, text_len) -> ()
  //
  // Purely decorative -- claims no widget_id (matches egui::Label's
  // default no-response), so it participates in no routing. Just paints
  // background + text placeholder. text_offset / text_len name the byte
  // range in the client's string arena (a G12.M2/M3 concern to wire
  // through the surface's font atlas); this landing consumes them into
  // the placeholder painter for ABI shape only.

  pub let widget_label : (u64, u64, u64, u64) -> () !{mem} @{} =
    fn (row_id: u64) (rect_ptr: u64) (text_offset: u64) (text_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-09 (#2327): paint-only decorative label. Refuses NULL rect via a silent no-op (WIDGETS_ST_REFUSED bumped for observability). Otherwise delegates to widget_paint_rect with a neutral background color (0 = default fg-on-bg from the surface's palette). text_offset / text_len consumed for ABI parity with the future font-atlas wire; unused in this landing. One callee-save push (r12=row_id) keeps rsp%16 aligned across the paint_rect + optional refused-note. Labels prefixed widgets_lb_.",
      block: {
        push r12;
        mov r12, rdi;                     // row_id

        cmp rsi, 0;
        je  widgets_lb_refused;

        // Paint placeholder background: widget_paint_rect(row_id, rect, 0).
        mov rdi, r12;
        // rsi = rect_ptr (already in place)
        xor rdx, rdx;                     // color = 0 (neutral)
        call widget_paint_rect;
        jmp widgets_lb_out;

      widgets_lb_refused:
        mov rdi, 3;                       // WIDGETS_ST_REFUSED
        call widgets_note;

      widgets_lb_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Section 7  widget_button.
  // ==========================================================================
  //
  // widget_button(row_id, rect_ptr, label_offset)
  //   -> WR_NONE | WR_HOVERED | WR_CLICKED
  //
  // Steps:
  //   (1) Gate rect (NULL / negative extents).
  //   (2) Allocate widget_id via ui_context_allocate_id (upstream call
  //       into ImmediateContext); refusal collapses to WR_NONE +
  //       WIDGETS_ST_REFUSED bump.
  //   (3) Paint: widget_paint_rect(row, rect, WIDGETS_BUTTON_BG). A
  //       real renderer distinguishes hovered / active states via
  //       color; the placeholder emits one paint call per body execution
  //       for smoke-witness parity.
  //   (4) Query was_clicked -> WR_CLICKED (bump WIDGETS_ST_CLICKED);
  //       else is_hovered -> WR_HOVERED; else WR_NONE.
  //
  // The label_offset argument names the byte offset of the label string
  // in the client's font arena; unused in this landing (G12.M2 font wire
  // consumes it) but retained in the signature so the eventual wire is
  // a pure body change with no caller migration.

  pub let widget_button : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64) (rect_ptr: u64) (label_offset: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-09 (#2327): button widget. Three callee-save pushes (rbx=row_id, r12=rect_ptr, r13=widget_id) leave rsp%16 == 8 -> +24 = %16 == 0 for every nested call. Refusal funnel bumps WIDGETS_ST_REFUSED once and returns WR_NONE. Click branch bumps WIDGETS_ST_CLICKED. Labels prefixed widgets_bt_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                     // row_id
        mov r12, rsi;                     // rect_ptr
        // rdx (label_offset) unused in this landing -- G12.M2 font wire.

        // (1) Rect gate.
        mov rdi, r12;
        call widgets_rect_valid;
        cmp rax, 0;
        je  widgets_bt_refused;

        // (2) Allocate widget_id.
        mov rdi, rbx;
        call ui_context_allocate_id;
        // Sentinels UI_BAD_SLOT (0xFFFFEB7A) and UI_FRAME_OVERFLOW
        // (0xFFFFEB76) live in the ImmediateContext failure page
        // 0xFFFFEB70..0xFFFFEB7F.  A valid widget_id is a u32 counting
        // up from 1; reaching 0xFFFFEB70 (~4.29 billion) would need
        // that many widgets in one frame, which is a client bug ruled
        // out by the widget_id_counter overflow gate at 0xFFFFFFFF
        // upstream.  Threshold at 0xFFFFEB70 catches both sentinels
        // cleanly.
        mov r10, 0xFFFFEB70;
        cmp rax, r10;
        jae widgets_bt_refused;
        mov r13, rax;                     // widget_id

        // (3) Paint placeholder (color 0 for now).
        mov rdi, rbx;
        mov rsi, r12;
        xor rdx, rdx;
        call widget_paint_rect;

        // (4) Interaction query. Click wins over hover.
        mov rdi, rbx;
        mov rsi, r13;
        call ui_context_was_clicked;
        cmp rax, 0;
        jne widgets_bt_click;

        mov rdi, rbx;
        mov rsi, r13;
        call ui_context_is_hovered;
        cmp rax, 0;
        jne widgets_bt_hover;

        mov rax, 0;                       // WR_NONE
        jmp widgets_bt_out;

      widgets_bt_click:
        mov rdi, 1;                       // WIDGETS_ST_CLICKED
        call widgets_note;
        mov rax, 2;                       // WR_CLICKED
        jmp widgets_bt_out;

      widgets_bt_hover:
        mov rax, 1;                       // WR_HOVERED
        jmp widgets_bt_out;

      widgets_bt_refused:
        mov rdi, 3;                       // WIDGETS_ST_REFUSED
        call widgets_note;
        mov rax, 0;                       // WR_NONE

      widgets_bt_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Section 8  widget_slider.
  // ==========================================================================
  //
  // widget_slider(row_id, rect_ptr, value_ptr, min_val, max_val)
  //   -> WR_NONE | WR_HOVERED | WR_ACTIVE | WR_CHANGED
  //
  // Invariants honored on EVERY call (even refusal):
  //   - *value_ptr is always clamped to [min_val, max_val] before
  //     returning (except on rect / value_ptr / range refusal, which
  //     short-circuits without touching *value_ptr).
  //
  // Steps:
  //   (1) Gate rect, value_ptr, and range (min <= max).
  //   (2) Load *value_ptr (i32 at [value_ptr+0..3] via mov_d).
  //   (3) Allocate widget_id.
  //   (4) Paint track + thumb placeholder.
  //   (5) If was_clicked: bump v by WIDGETS_SLIDER_STEP (placeholder
  //       for real drag semantics that land with G12.M1-003 routing).
  //   (6) Clamp to [min_val, max_val].
  //   (7) Store the clamped value back to *value_ptr.
  //   (8) Return WR_CHANGED if the final value differs from the initial
  //       loaded value; else WR_ACTIVE if was_clicked without change
  //       (rare: e.g., clicked-at-max where bump is clamped down);
  //       else WR_HOVERED / WR_NONE as usual.

  pub let widget_slider : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64) (rect_ptr: u64) (value_ptr: u64) (min_val: u64) (max_val: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-09 (#2327): slider widget. Six callee-save pushes (rbx=row_id, r12=rect_ptr THEN click_flag, r13=value_ptr, r14=min_val, r15=max_val, rbp=v_initial) + sub rsp,8 for widget_id slot ([rsp+0]) land rsp%16 == 0 (entry %16 == 8, +48+8 = %16 == 0). r12 is repurposed after widget_paint_rect (rect_ptr no longer needed) as the callee-save home for click_flag -- caller-save would be silently clobbered by the subsequent widgets_i32_clamp / ui_context_is_hovered calls. Refusal funnel bumps WIDGETS_ST_REFUSED once and returns WR_NONE. Change branch bumps WIDGETS_ST_CHANGED. Labels prefixed widgets_sl_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;
        sub  rsp, 8;

        mov rbx, rdi;                     // row_id
        mov r12, rsi;                     // rect_ptr
        mov r13, rdx;                     // value_ptr
        mov r14, rcx;                     // min_val
        mov r15, r8;                      // max_val

        // (1a) Rect gate.
        mov rdi, r12;
        call widgets_rect_valid;
        cmp rax, 0;
        je  widgets_sl_refused;

        // (1b) value_ptr gate.
        cmp r13, 0;
        je  widgets_sl_refused;

        // (1c) Range gate: min_val <= max_val (signed via unsigned-bias
        // trick).  bias_min in r10, bias_max in r11.
        mov r10, r14;
        mov r9, 0xFFFFFFFF;
        and r10, r9;
        mov r9, 0x80000000;
        xor r10, r9;
        mov r11, r15;
        mov r9, 0xFFFFFFFF;
        and r11, r9;
        mov r9, 0x80000000;
        xor r11, r9;
        cmp r10, r11;
        ja  widgets_sl_refused;           // min > max (signed)

        // (2) Load initial *value_ptr as i32 -> zero-extended u32 in rbp.
        mov_d rbp, [r13 + 0];

        // (3) Allocate widget_id (stashed in [rsp+0] since we already
        // hold rbp/r14/r15 for other state).  Sentinel gate at
        // 0xFFFFEB70 catches UI_BAD_SLOT / UI_FRAME_OVERFLOW (see
        // widget_button §Section 7 for the threshold rationale).
        mov rdi, rbx;
        call ui_context_allocate_id;
        mov r10, 0xFFFFEB70;
        cmp rax, r10;
        jae widgets_sl_refused;
        mov [rsp + 0], rax;

        // (4) Paint placeholder.  After this call, r12 (rect_ptr) is
        // dead -- reuse it as the callee-save home for click_flag,
        // which must survive both widgets_i32_clamp and ui_context_is_
        // hovered further down.  Using a caller-save (r9) for click_
        // flag would silently lose it across widgets_i32_clamp; using
        // r12 (callee-save, restored at exit) is the safe stash.
        mov rdi, rbx;
        mov rsi, r12;
        xor rdx, rdx;
        call widget_paint_rect;

        // (5) Query was_clicked; stash click flag in r12 (formerly
        // rect_ptr, now dead).
        mov rdi, rbx;
        mov rsi, [rsp + 0];
        call ui_context_was_clicked;
        mov r12, rax;                     // click_flag (0 or 1)

        // Candidate value: start with rbp (initial), add STEP if clicked.
        mov rax, rbp;
        cmp r12, 0;
        je  widgets_sl_no_bump;
        add rax, 1;                       // WIDGETS_SLIDER_STEP
      widgets_sl_no_bump:

        // (6) Clamp candidate to [min, max]. r14 = min, r15 = max.
        // widgets_i32_clamp(candidate, min, max) -> clamped u32.
        mov rdi, rax;
        mov rsi, r14;
        mov rdx, r15;
        call widgets_i32_clamp;
        // rax = clamped value (u32 in low 32).

        // (7) Store clamped value back to *value_ptr.
        mov_d [r13 + 0], rax;

        // (8) Determine return.  Compare final (rax) vs initial (rbp),
        // both masked to u32.
        mov r10, rax;
        mov r11, 0xFFFFFFFF;
        and r10, r11;
        mov r8, rbp;
        and r8, r11;
        cmp r10, r8;
        jne widgets_sl_changed;

        // No value change.  If clicked, WR_ACTIVE; else hover/none.
        cmp r12, 0;
        jne widgets_sl_active;

        mov rdi, rbx;
        mov rsi, [rsp + 0];
        call ui_context_is_hovered;
        cmp rax, 0;
        jne widgets_sl_hover;

        mov rax, 0;                       // WR_NONE
        jmp widgets_sl_out;

      widgets_sl_changed:
        mov rdi, 2;                       // WIDGETS_ST_CHANGED
        call widgets_note;
        mov rax, 4;                       // WR_CHANGED
        jmp widgets_sl_out;

      widgets_sl_active:
        mov rax, 3;                       // WR_ACTIVE
        jmp widgets_sl_out;

      widgets_sl_hover:
        mov rax, 1;                       // WR_HOVERED
        jmp widgets_sl_out;

      widgets_sl_refused:
        mov rdi, 3;                       // WIDGETS_ST_REFUSED
        call widgets_note;
        mov rax, 0;                       // WR_NONE

      widgets_sl_out:
        add rsp, 8;
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Section 9  widget_checkbox.
  // ==========================================================================
  //
  // widget_checkbox(row_id, rect_ptr, label_offset, state_ptr)
  //   -> WR_NONE | WR_HOVERED | WR_CHANGED
  //
  // *state_ptr is a u64 slot holding 0 (unchecked) or 1 (checked).
  // Toggle on was_clicked via `xor rax, 1` on the loaded value; store
  // back; return WR_CHANGED if toggled, else WR_HOVERED / WR_NONE.
  //
  // The label_offset is unused in this landing (G12.M2 font wire will
  // consume it) but retained in the signature.

  pub let widget_checkbox : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64) (rect_ptr: u64) (label_offset: u64) (state_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-09 (#2327): checkbox widget. Five callee-save pushes (rbx=row_id, r12=rect_ptr, r13=state_ptr, r14=widget_id, r15=click_flag) land rsp%16 == 0 for every nested call (entry %16 == 8, +40 -> %16 == 0). label_offset (rdx) unused in this landing. Refusal funnel bumps WIDGETS_ST_REFUSED; toggle branch bumps WIDGETS_ST_CHANGED. Labels prefixed widgets_ck_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                     // row_id
        mov r12, rsi;                     // rect_ptr
        // rdx (label_offset) unused in this landing.
        mov r13, rcx;                     // state_ptr

        // (1a) Rect gate.
        mov rdi, r12;
        call widgets_rect_valid;
        cmp rax, 0;
        je  widgets_ck_refused;

        // (1b) state_ptr gate.
        cmp r13, 0;
        je  widgets_ck_refused;

        // (2) Allocate widget_id.  Sentinel gate at 0xFFFFEB70 catches
        // UI_BAD_SLOT / UI_FRAME_OVERFLOW (see widget_button §Section 7
        // for the threshold rationale).
        mov rdi, rbx;
        call ui_context_allocate_id;
        mov r10, 0xFFFFEB70;
        cmp rax, r10;
        jae widgets_ck_refused;
        mov r14, rax;                     // widget_id

        // (3) Paint placeholder.
        mov rdi, rbx;
        mov rsi, r12;
        xor rdx, rdx;
        call widget_paint_rect;

        // (4) Query was_clicked; stash click flag in r15.
        mov rdi, rbx;
        mov rsi, r14;
        call ui_context_was_clicked;
        mov r15, rax;

        // (5) If clicked, XOR bit 0 of *state_ptr and store back.
        cmp r15, 0;
        je  widgets_ck_no_toggle;
        mov rax, [r13 + 0];
        xor rax, 1;
        mov [r13 + 0], rax;
        mov rdi, 2;                       // WIDGETS_ST_CHANGED
        call widgets_note;
        mov rax, 4;                       // WR_CHANGED
        jmp widgets_ck_out;

      widgets_ck_no_toggle:
        // Not clicked; query hover.
        mov rdi, rbx;
        mov rsi, r14;
        call ui_context_is_hovered;
        cmp rax, 0;
        jne widgets_ck_hover;
        mov rax, 0;                       // WR_NONE
        jmp widgets_ck_out;

      widgets_ck_hover:
        mov rax, 1;                       // WR_HOVERED
        jmp widgets_ck_out;

      widgets_ck_refused:
        mov rdi, 3;                       // WIDGETS_ST_REFUSED
        call widgets_note;
        mov rax, 0;                       // WR_NONE

      widgets_ck_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Section 10  Boot init.
  // ==========================================================================
  //
  // Zero-out the stats vector once at library init. Mirrors immediate_
  // context_stats_reset -- the two libraries share the same boot cadence
  // (the client calls ui_context_init then widgets_init, in that order,
  // before the first frame).

  pub let widgets_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-09 (#2327): call through to widgets_stats_reset for one clean counter zero-out. Labels prefixed widgets_i_.",
      block: {
        call widgets_stats_reset;
        ret
      }
    }

  // ==========================================================================
  // Section 11  Fingerprint tag.
  // ==========================================================================
  //
  // Data-only constant, emitted by the library once widgets_init has
  // been called and the first widget body runs (G12.M1-004 klog wire
  // will emit this; until then it is a compile-time literal). Follows
  // the pdx_kind_<name>_meta legacy-suffix convention (immediate_
  // context.pdx pdx_kind_ui_context_meta, window_kind.pdx pdx_kind_
  // window_meta, etc.). Needs an allowlist entry in tools/verify-
  // fingerprint-coverage.sh with reason "G12.M1-002 (#2327) widgets
  // body not yet emitted -- G12.M1-004 klog wire pending" until the
  // klog emission site lands. The main coordinator adds that allowlist
  // entry at Batch 10 close-out.
  //
  // Length: "widgets ready ok [legacy: WIDGETS READY OK]\0" = 44 bytes
  // (43 chars + NUL, per the strlen+1 rule).
  pub let pdx_kind_widgets_meta : [u8; 44] = "widgets ready ok [legacy: WIDGETS READY OK]\0"
}
