// src/user/libpaideia_ui/view_tree.pdx -- Wave0-B10-10 (paideia-os #2329)
//
// G12.M2-001: RETAINED-MODE VIEW TREE + REACTIVE RE-RENDER (Xilem-shape).
//
// Design authority: design/roadmap/next-wave-softarch.md §G12 (line
// 736 -- Developer APIs + first-party toolkit) and next-wave-synthesis
// .md line 99. This file lands the SECOND paradigm layer of the
// paideia-ui toolkit: a retained-mode view tree that sits ON TOP OF
// the immediate-mode context (immediate_context.pdx, Wave0-B8-05,
// KIND_UI_CONTEXT=0x1D5) and delegates its per-frame widget emission
// through the immediate-mode widget catalogue (widgets.pdx, Wave0-B10
// -09).
//
// NOVEL-CLEAN POSTURE.  paideia-ui deliberately ships BOTH paradigms
// side by side rather than picking one dogma: a client can drive some
// panels via egui-shape immediate-mode calls (cheap, no state), and
// other panels via Xilem-shape retained-mode view descriptions
// (reactive, diff-and-patch). The two paradigms MEET at the widget-
// call boundary -- view_tree_reconcile below emits widget_button /
// widget_label / ... calls that are indistinguishable from a direct
// immediate-mode caller invoking the same primitives. That is the
// "layer on top" property this file expresses: retained mode is a
// diff-and-patch OVERLAY that walks its tree once per frame and drops
// through to the immediate-mode widget layer for the actual paint.
//
// The classical Xilem architecture (Raph Levien, post-Druid 2022+;
// cited in the roadmap at line 753) is the direct precedent: view
// descriptions are declarative values, the toolkit diffs the current
// value against the prior frame's value, and only the changed widgets
// re-emit. This file's shape follows the Xilem discipline in three
// steps -- (1) BUILD: a view function calls view_tree_append_node for
// every element it wants painted, computing a prop_hash from the
// visible props; (2) DIFF: view_tree_diff compares this frame's
// prop_hashes with the previous frame's array (caller-owned; the
// toolkit does not double-allocate the prev-hash arena) and sets the
// dirty_bitmap bit for every node whose hash changed; (3) RECONCILE:
// view_tree_reconcile walks the tree once, emitting widget calls
// ONLY for dirty nodes (or all nodes on first frame).
//
// The retained tree is INTENTIONALLY not linked into a KIND cap.
// This is a value-type module (matches sibling widgets.pdx and
// tiling_bsp.pdx precedents): the retained-view abstraction is a
// per-context library helper, not a cross-process authority. A future
// landing that promotes retained-mode into a compositor-adjacent
// service (svc-toolkit) can wrap this pool behind a KIND_VIEW_TREE
// derived over KIND_UI_CONTEXT; that promotion is out of scope for
// G12.M2 because the retained shape's contract is per-frame diff, and
// per-frame IPC round-trips would defeat the point.
//
// =============================================================================
// SECTION 0  KIND SLOT ALLOCATION
// =============================================================================
//
// No KIND allocated. Value-type module. Depends transitively on
// KIND_UI_CONTEXT (0x1D5, immediate_context.pdx Wave0-B8-05) as the
// paradigm meeting-point: every reconcile call takes a ui_context row
// id whose frame lifecycle brackets the reconcile walk (client calls
// ui_context_begin_frame before view_tree_reconcile; ui_context_end_
// frame after). This mirrors widgets.pdx's dependency shape.
//
// =============================================================================
// SECTION 1  RELATION TO SIBLING MODULES
// =============================================================================
//
// - immediate_context.pdx (Wave0-B8-05, KIND_UI_CONTEXT=0x1D5): the
//   frame-lifecycle authority. view_tree_reconcile reads the ui_
//   context row's widget_id_counter through ui_context_allocate_id and
//   the hover/click routing slots through the widget-layer helpers.
//   view_tree does NOT bypass the context for interaction routing.
//
// - widgets.pdx (Wave0-B10-09): the immediate-mode widget primitives
//   this file delegates through at reconcile time. widget_button /
//   widget_label / widget_slider / widget_checkbox each take a
//   ui_context row_id + rect_ptr + payload; view_tree_reconcile
//   synthesises the rect (from stored node state) and invokes the
//   matching widget entry point per node kind. The retained tree does
//   NOT re-implement paint logic -- reconcile is a walk-and-dispatch,
//   never a walk-and-render.
//
// - state_hash_table_ptr (immediate_context.pdx §Section 2 body5,
//   G12.M1-002/003 concern): the immediate-mode retained-STATE table
//   (widget_id -> state blob) is orthogonal to this file's retained-
//   TREE. Immediate mode retains per-widget state (open/closed, scroll
//   offset); retained mode retains per-node view description. Both
//   layers can coexist within the same KIND_UI_CONTEXT row.
//
// =============================================================================
// SECTION 2  ViewNode ROW LAYOUT -- 48 BYTES (SIX u64 WORDS)
// =============================================================================
//
//   [+0]   word0:   in_use[63:56] | reserved[55:40] | kind[39:32] | node_id[31:0]
//   [+8]   word1:   parent_id[31:0] | first_child_id[63:32]
//   [+16]  word2:   next_sibling_id[31:0] | reserved[63:32]
//   [+24]  word3:   prop_hash: u64                    -- change detection key
//   [+32]  word4:   state_ptr: u64                    -- arena-alloc'd retained blob (0 == no state)
//   [+40]  word5:   tree_id[31:0] | reserved[63:32]   -- back-reference for cross-tree gate
//
// Row size 48 chosen per task brief. Not power-of-2 -- addressing
// therefore uses the encoder-conservative `lea r11, [rdi + rdi*2];
// shl r11, 4;` idiom (r11 = idx*3, then r11 = idx*48). Both `lea r,
// [r + r*2]` and `shl r, imm8` are single-byte-encoded primary forms
// with no imm32/imul-with-imm hazard. Verified against sibling
// addressing patterns in immediate_context.pdx (shl r11, 6) and
// widgets.pdx.
//
// node_id is u32 with sentinel 0 == "no node". Widget IDs (from
// ui_context_allocate_id) and view-tree node IDs are DIFFERENT
// namespaces: a node_id is a slot index into _view_node_pool; a
// widget_id is a per-frame counter within a KIND_UI_CONTEXT. The
// reconcile pass converts node_id -> widget_id at emit time via a
// fresh ui_context_allocate_id call per dirty node.
//
// parent_id / first_child_id / next_sibling_id together form the
// classic first-child / next-sibling n-ary tree encoding (Knuth vol1
// §2.3.2). Every insertion is O(1) at the head of the parent's child
// list, which is the shape a Xilem-style view function produces
// (append-in-order during the frame walk). Traversal at reconcile
// time is a depth-first walk following first_child then next_sibling
// pointers.
//
// prop_hash is the change-detection key: view functions compute it
// over their visible props (label text, disabled flag, slider value,
// etc.) and the diff pass compares this frame's hash with the
// previous frame's hash for the same node_id. Zero is a valid hash
// value; there is NO "no hash yet" sentinel -- the dirty bitmap
// carries that information separately.
//
// state_ptr is a caller-owned u64 pointer to a retained-state blob
// (a text-input's buffer, a scroll area's offset, a tree view's
// expanded-set bitmap). This file DOES NOT allocate or free the blob
// -- it stores the pointer opaquely and returns it at reconcile time.
// A future G12.M2-003 landing (retained_state.pdx, #2331) may
// standardise the blob shape; this file merely carries the pointer.
//
// tree_id back-reference lets view_tree_append_node refuse a parent_
// id from a foreign tree (VT_BAD_PARENT). Without it a client could
// splice trees together silently by passing a parent_id that named a
// valid node in a different tree; the cross-tree gate turns that into
// a hard refusal.
//
// All slots stored little-endian, matching every other row-tail
// layout in this repo. No float leaks into a view-tree node per the
// FPU-discipline (design/kernel/no-fpu.md).
//
// =============================================================================
// SECTION 3  ViewTree ROW LAYOUT -- 32 BYTES (FOUR u64 WORDS)
// =============================================================================
//
//   [+0]   word0:   in_use[63:56] | reserved[55:32] | root_id[31:0]
//   [+8]   word1:   node_count[31:0] | reserved[63:32]
//   [+16]  word2:   frame_num: u64                    -- monotone; bumped on each rebuild
//   [+24]  word3:   dirty_bitmap: u64                 -- first 64 nodes; bit set = re-render needed
//
// Row size 32 chosen (over 24-byte minimum) so tree addressing uses
// `shl r11, 5` -- power-of-2 encoder-conservative shift. The extra
// 8-byte reserved slot in word1[63:32] absorbs a future max-child-
// depth counter (for a bounded-recursion reconcile walk) without a
// row-shape migration.
//
// root_id is u32 with sentinel 0 == "no root yet". The first
// view_tree_append_node with parent_id == 0 stamps root_id in place
// so downstream diff/reconcile passes can start from the root without
// a separate view_tree_set_root call.
//
// node_count is a monotone counter of appended nodes since the last
// view_tree_reset call. It caps at 128 (the pool capacity, see
// VT_NODE_MAX below) and is used by diff/reconcile to bound the walk.
//
// frame_num bumps at the START of each view_tree_reset call (the
// signal that the client is beginning a new frame's rebuild). This
// mirrors immediate_context's frame_number semantics; the two
// counters are independent (a retained-mode client can rebuild its
// view tree at a different cadence from the immediate-mode context's
// frame counter -- e.g. an animation frame that re-emits every 16ms
// vs. an event-driven view rebuild only on state change).
//
// dirty_bitmap is a 64-bit map covering the first 64 nodes.
// view_tree_diff sets bit N when node N's prop_hash changed since
// prev_prop_hashes_ptr[N]; view_tree_reconcile reads the bitmap and
// emits widget calls only for set bits (or emits ALL bits when
// frame_num == 1, the "first frame" case). Nodes beyond index 63 are
// ALWAYS treated as dirty (defensive over-emission) -- a future
// dirty-tracking landing may promote to a variable-size bitmap; the
// 64-bit fixed size covers the common panel-size (a settings dialog,
// a file browser sidebar) without the arena cost.
//
// =============================================================================
// SECTION 4  FAILURE TAXONOMY 0xFFFFEAB0..0xFFFFEABF
// =============================================================================
//
// NB: the task-brief-suggested band 0xFFFFECA0..0xFFFFECAF is CLAIMED
// in full by src/kernel/core/drivers/ahci/cmd_alloc.pdx +
// src/kernel/core/drivers/ahci/io_submit.pdx (AHCIIO cmd alloc + I/O
// submit, design/hardware/nvme-ahci-tail-milestones.md line 1064).
// Repo-wide grep at landing time (`grep -rn "0xFFFFECAx"`) shows all
// 16 slots claimed there. This file uses 0xFFFFEAB0..0xFFFFEABF, a
// fresh 16-slot page grep-verified free across src/ + design/ at
// landing (no hits in the entire page). This comment records that
// choice so a future grep for the brief-suggested constant lands
// here.
//
// Nearest allocated neighbours: 0xFFFFEA00..EA1F (unclaimed lower
// page, see grep discipline below), 0xFFFFEAC0..EAFF (unclaimed
// upper pages, reserved for G12.M2-002/003 follow-ups per the roadmap
// row map).
//
// 16 slots give headroom past the immediate 10 refusal cases; the
// unused low half (0xFFFFEAB0..0xFFFFEAB5) is reserved for G12.M2-
// 002/003 follow-ups (VT_STATE_BIND_ALREADY, VT_RECONCILE_BAD_DEPTH,
// VT_TREE_LOCKED, ...).
//
// =============================================================================
// SECTION 5  DIFF-AND-PATCH INVARIANT
// =============================================================================
//
// The retained-mode contract this file enforces:
//
//   1. view_tree_reset ASSERTS a valid tree_id. On success: bump
//      frame_num, clear node_count to 0, clear dirty_bitmap to 0,
//      clear root_id to 0. The client then rebuilds by calling
//      view_tree_append_node for every node it wants painted.
//
//   2. view_tree_append_node ASSERTS a valid tree_id, kind < VNK_MAX,
//      parent_id EITHER == 0 (root) OR names a live node in THIS
//      tree. On success: claim a node slot from _view_node_pool,
//      link into parent's first-child list (parent's old first_child
//      becomes new node's next_sibling), stamp prop_hash + state_ptr,
//      return the fresh node_id.
//
//   3. view_tree_diff ASSERTS a valid tree_id AND a nonzero prev_
//      prop_hashes_ptr. On success: walks nodes [0..node_count),
//      compares each node's prop_hash with prev_prop_hashes_ptr[N],
//      sets dirty_bitmap bit N on mismatch, returns dirty_count. The
//      first-frame case (frame_num == 1) treats all nodes as dirty
//      regardless of the pointer contents -- callers are expected
//      but not required to pass a zero-initialised prev array.
//
//   4. view_tree_reconcile ASSERTS a valid tree_id AND a valid ui_
//      context row_id. On success: walks the tree depth-first, for
//      each node whose dirty bit is set (or all nodes on first
//      frame) it maps kind to a widget primitive (VNK_BUTTON ->
//      widget_button, VNK_LABEL -> widget_label, ...) and emits the
//      call with the appropriate rect + payload extracted from the
//      node's state blob. VNK_CONTAINER emits no direct widget call
//      (recurses into children). This file's landing wires the
//      DISPATCH SKELETON; the actual widget-call emission per kind
//      is a G12.M2-003 concern (retained_state.pdx, #2331) where the
//      state blob shape is standardised. Until then reconcile
//      counts dirty nodes and bumps VT_ST_RECONCILES; the widget-
//      call fanout leaves an inline delegation-site comment naming
//      the target widget entry point per kind.
//
// This state machine is the Xilem-shape "declare, diff, patch"
// discipline the roadmap cites at §G12: the client's view function
// is a pure description-producer, the toolkit is the diff-and-patch
// engine, and the widget layer is the paint engine. The three
// concerns are separated so an app author writing view functions
// never touches paint code, and a toolkit contributor optimising
// diff never touches app semantics.
//
// =============================================================================
// SECTION 6  ENCODER RULES + LABEL PREFIX
// =============================================================================
//
// paideia-as M0305 module = ViewTree (PascalCase of file basename
// view_tree.pdx). Labels prefixed `view_tree_`. Encoder-conservative
// throughout: no `imul r,r,imm`, no imm64 forms via anonymous mov,
// no `add reg,[mem]`. Row-index math for the 48-byte node uses the
// two-op `lea r11, [rdi + rdi*2]; shl r11, 4;` idiom; the 32-byte
// tree row uses `shl r11, 5`. Callee-save discipline: rbx/r12..r15
// each pushed exactly once per function that uses them, keeping
// rsp%16 aligned before every nested call.

module ViewTree = structure {

  // ==========================================================================
  // Section 0  Constants: kinds, sizes, caps.
  // ==========================================================================

  // ViewNodeKind enum. VNK_CONTAINER == 0 matches the "no kind yet"
  // shape for a freshly-cleared node word; container is the invariant
  // "recurse into children, emit nothing directly" case, so the
  // default zero'd node is a benign container the reconcile pass
  // silently descends through.
  pub let VNK_CONTAINER : u64 = 0
  pub let VNK_BUTTON    : u64 = 1
  pub let VNK_LABEL     : u64 = 2
  pub let VNK_LIST      : u64 = 3
  pub let VNK_TEXTFIELD : u64 = 4
  pub let VNK_CHECKBOX  : u64 = 5
  pub let VNK_SLIDER    : u64 = 6
  pub let VNK_TREE      : u64 = 7
  pub let VNK_MAX       : u64 = 8              // sentinel; kinds >= this refused

  // Pool caps. VT_MAX = 8 trees mirrors UI_MAX for parity with the
  // KIND_UI_CONTEXT pool: one retained tree per context is the
  // common shape (settings dialog root + tool palette root + main
  // window root fits in 8). VT_NODE_MAX = 128 covers a rich panel
  // (settings dialog with ~60 rows, file browser sidebar with ~40
  // entries) without over-committing .bss. 128 * 48 = 6144 bytes =
  // 1.5 4KB pages. The dirty_bitmap covers only the first 64 nodes;
  // nodes 64..127 are always-dirty at reconcile time.
  pub let VT_MAX          : u64 = 8
  pub let VT_ROW_BYTES    : u64 = 32
  pub let VT_ROW_SHIFT    : u64 = 5            // 1 << 5 == 32
  pub let VT_NODE_MAX     : u64 = 128
  pub let VT_NODE_BYTES   : u64 = 48
  // No shift for 48; use `lea + shl 4` -- see §Section 6 header.
  pub let VT_DIRTY_BITS   : u64 = 64           // dirty_bitmap width

  pub let VT_U32_MAX      : u64 = 0xFFFFFFFF

  // Failure taxonomy 0xFFFFEAB0..0xFFFFEABF. Fresh page, grep-
  // verified free across src/ + design/ at landing.
  pub let VT_OK                  : u64 = 0
  pub let VT_TAIL_ENOSPC         : u64 = 0xFFFFEABF
  pub let VT_TAIL_BAD_ARG        : u64 = 0xFFFFEABE
  pub let VT_BAD_SLOT            : u64 = 0xFFFFEABD
  pub let VT_BAD_PARENT          : u64 = 0xFFFFEABC
  pub let VT_BAD_KIND            : u64 = 0xFFFFEABB
  pub let VT_NODE_ENOSPC         : u64 = 0xFFFFEABA
  pub let VT_BAD_NODE            : u64 = 0xFFFFEAB9
  pub let VT_DIFF_BAD_PTR        : u64 = 0xFFFFEAB8
  pub let VT_REVOKE_ALREADY      : u64 = 0xFFFFEAB7
  pub let VT_UNSUP_OP            : u64 = 0xFFFFEAB6
  // 0xFFFFEAB0..0xFFFFEAB5 reserved for G12.M2-002/003 follow-ups.

  // THE TWO STATE CELLS.
  //   _view_tree_table:  8 trees * 32 bytes = 256 bytes = 32 u64.
  //   _view_node_pool:   128 nodes * 48 bytes = 6144 bytes = 768 u64.
  //   _view_node_bump:   single u64 -- next-free node index.
  //   _view_tree_stats:  counter array.
  pub let mut _view_tree_table : [u64; 32]  = uninit @align(64)
  pub let mut _view_node_pool  : [u64; 768] = uninit @align(64)
  pub let mut _view_node_bump  : [u64; 1]   = uninit @align(64)
  pub let mut _view_tree_stats : [u64; 8]   = uninit @align(64)

  pub let VT_ST_NEW          : u64 = 0
  pub let VT_ST_RESETS       : u64 = 1
  pub let VT_ST_APPENDS      : u64 = 2
  pub let VT_ST_DIFFS        : u64 = 3
  pub let VT_ST_RECONCILES   : u64 = 4
  pub let VT_ST_REVOKES      : u64 = 5
  pub let VT_ST_REFUSED      : u64 = 6
  pub let VT_ST_DIRTY_TOTAL  : u64 = 7          // running dirty-count sum

  // Fingerprint tag. Emitted by the library on successful mint of a
  // ViewTree (view_tree_new success path). Legacy suffix gives grep
  // parity with pre-Wave0 boot-log tooling.
  //
  // Length: "view tree new ok [legacy: VIEW TREE NEW OK]\0" =
  // 44 bytes (strlen 43 + null terminator).
  //
  // Data-only constant until the actual klog emission wire lands
  // (G12.M2-003 concern). Needs an allowlist entry in tools/verify-
  // fingerprint-coverage.sh with reason "Wave0-B10 G12.M2-001
  // (#2329) view_tree_new dispatcher + toolkit runtime not yet
  // wired". The main coordinator adds that allowlist entry at Batch
  // 10 close-out.
  pub let pdx_kind_view_tree_meta : [u8; 44] = "view tree new ok [legacy: VIEW TREE NEW OK]\0"

  // ==========================================================================
  // Section 1  Counter primitives.
  // ==========================================================================

  pub let view_tree_stats_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-10 (#2329): clear tree table + node pool + bump + counters at boot. 32 + 768 + 1 + 8 = 809 u64 total. Three separate scrub loops for readability (each single-op inner body). Labels prefixed view_tree_sr_.",
      block: {
        // Scrub _view_tree_table (32 u64).
        lea r10, [rip + _view_tree_table];
        xor rax, rax;
        xor rcx, rcx;
      view_tree_sr_trees:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  view_tree_sr_trees;

        // Scrub _view_node_pool (768 u64).
        lea r10, [rip + _view_node_pool];
        xor rcx, rcx;
      view_tree_sr_nodes:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 768;
        jb  view_tree_sr_nodes;

        // Scrub _view_node_bump (1 u64).
        lea r10, [rip + _view_node_bump];
        mov [r10 + 0], rax;

        // Scrub _view_tree_stats (8 u64).
        lea r10, [rip + _view_tree_stats];
        xor rcx, rcx;
      view_tree_sr_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  view_tree_sr_stats;
        ret
      }
    }

  pub let view_tree_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-10 (#2329): counter bump. Encoder-conservative load-inc-store; no `add reg,[mem]`. Labels prefixed view_tree_nt_.",
      block: {
        cmp rdi, 8;
        jae view_tree_nt_out;
        lea r10, [rip + _view_tree_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      view_tree_nt_out:
        ret
      }
    }

  pub let view_tree_note_add : (u64, u64) -> () !{mem} @{} =
    fn (which: u64) (delta: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-10 (#2329): counter bump by delta (used to accumulate dirty_count into VT_ST_DIRTY_TOTAL). Labels prefixed view_tree_na_.",
      block: {
        cmp rdi, 8;
        jae view_tree_na_out;
        lea r10, [rip + _view_tree_stats];
        mov rax, [r10 + rdi * 8];
        add rax, rsi;
        mov [r10 + rdi * 8], rax;
      view_tree_na_out:
        ret
      }
    }

  pub let view_tree_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-10 (#2329): counter read. Labels prefixed view_tree_st_.",
      block: {
        cmp rdi, 8;
        jae view_tree_st_zero;
        lea r10, [rip + _view_tree_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      view_tree_st_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Section 2  Validators.
  // ==========================================================================

  // view_tree_kind_valid: 1 iff kind < VNK_MAX (== 8).
  pub let view_tree_kind_valid : (u64) -> u64 !{} @{} =
    fn (kind: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B10-10 (#2329): 1 iff kind < 8. Labels prefixed view_tree_kv_.",
      block: {
        cmp rdi, 8;
        jae view_tree_kv_no;
        mov rax, 1;
        ret;
      view_tree_kv_no:
        xor rax, rax;
        ret
      }
    }

  // view_tree_u32_valid: 1 iff v fits in 32 bits.
  pub let view_tree_u32_valid : (u64) -> u64 !{} @{} =
    fn (v: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B10-10 (#2329): 1 iff v <= VT_U32_MAX. Labels prefixed view_tree_uv_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  view_tree_uv_no;
        mov rax, 1;
        ret;
      view_tree_uv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Section 3  Tree-row pool: valid / alloc / free.
  // ==========================================================================

  // view_tree_row_valid: 1 iff tree_id < VT_MAX AND header in_use set.
  // Tree row size 32 -- addressing via `shl r11, 5` (VT_ROW_SHIFT).
  pub let view_tree_row_valid : (u64) -> u64 !{mem} @{} =
    fn (tree_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-10 (#2329): 1 iff tree_id < VT_MAX and header in_use bit set. Power-of-2 row size -> `shl r11, 5` addressing. Labels prefixed view_tree_rv_.",
      block: {
        cmp rdi, 8;
        jae view_tree_rv_no;
        lea r10, [rip + _view_tree_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  view_tree_rv_no;
        mov rax, 1;
        ret;
      view_tree_rv_no:
        xor rax, rax;
        ret
      }
    }

  // view_tree_row_alloc: claim one tree row (low-first scan).
  // Header stamped with in_use bit (bit 56); root_id starts 0,
  // node_count starts 0, frame_num starts 0, dirty_bitmap starts 0.
  pub let view_tree_row_alloc : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-10 (#2329): claim one ViewTree row. Low-first scan (rbx=idx) over 8 rows of 32 bytes (idx*32 via `shl r11, 5`). On claim: header = (1 << 56); all body words zeroed. Single callee-save push (rbx=idx) keeps rsp%16 aligned. Labels prefixed view_tree_ra_.",
      block: {
        push rbx;
        xor rbx, rbx;
      view_tree_ra_scan:
        cmp rbx, 8;
        jae view_tree_ra_enospc;
        lea r10, [rip + _view_tree_table];
        mov r11, rbx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  view_tree_ra_claim;
        add rbx, 1;
        jmp view_tree_ra_scan;

      view_tree_ra_claim:
        mov r11, 1;
        shl r11, 56;
        mov [r10 + 0],  r11;                // header: in_use = 1, root_id = 0
        xor rax, rax;
        mov [r10 + 8],  rax;                // node_count = 0
        mov [r10 + 16], rax;                // frame_num = 0
        mov [r10 + 24], rax;                // dirty_bitmap = 0
        mov rax, rbx;
        jmp view_tree_ra_out;

      view_tree_ra_enospc:
        mov rax, 0xFFFFEABF;                // VT_TAIL_ENOSPC

      view_tree_ra_out:
        pop rbx;
        ret
      }
    }

  // view_tree_row_free: scrub one tree row (four words). Does NOT
  // touch _view_node_pool -- freed nodes remain resident until
  // view_tree_reset next runs (or the bump allocator wraps at pool
  // reinit). This is deliberate: revoking a tree does not require
  // walking its nodes if the pool is per-boot lease.
  pub let view_tree_row_free : (u64) -> () !{mem} @{} =
    fn (tree_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-10 (#2329): scrub one tree row (4 u64). Labels prefixed view_tree_rf_.",
      block: {
        cmp rdi, 8;
        jae view_tree_rf_out;
        lea r10, [rip + _view_tree_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
      view_tree_rf_out:
        ret
      }
    }

  // ==========================================================================
  // Section 4  Node-pool bump allocator.
  // ==========================================================================
  //
  // Nodes are allocated from a single global pool via a bump counter
  // (_view_node_bump). This is the Xilem-shape "arena per frame"
  // discipline: view_tree_reset resets the bump to 0 so the whole
  // pool is reclaimed at once; individual node frees are neither
  // supported nor needed (a retained view rebuilds the whole tree on
  // each reset).
  //
  // The bump index is compared against VT_NODE_MAX (128); exhaustion
  // returns VT_NODE_ENOSPC. Node index 0 is a VALID node slot (the
  // sentinel 0 == "no node" applies to node_id fields inside a node,
  // not to the pool index) -- but the first node allocated in a
  // fresh tree naturally becomes root_id.

  // view_tree_node_base: returns pointer into _view_node_pool for
  // node index N. Addressing via `lea r11, [rdi + rdi*2]; shl r11,
  // 4;` -- r11 = idx*3, then r11 = idx*48. Both ops encoder-
  // conservative (no imul-with-imm hazard).
  //
  // Caller MUST guarantee 0 <= idx < VT_NODE_MAX; this helper does
  // not bounds-check.
  pub let view_tree_node_base : (u64) -> u64 !{} @{} =
    fn (idx: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B10-10 (#2329): compute _view_node_pool base pointer for node index idx. Addressing: r11 = idx*3 (via `lea r11, [rdi + rdi*2]`) then r11 <<= 4 (idx*48). Returns absolute address. Labels prefixed view_tree_nb_.",
      block: {
        lea rax, [rip + _view_node_pool];
        lea r11, [rdi + rdi * 2];
        shl r11, 4;
        add rax, r11;
        ret
      }
    }

  // view_tree_node_alloc: claim next node slot via bump. Returns
  // pool-index (0..VT_NODE_MAX-1) on success, VT_NODE_ENOSPC on
  // exhaustion. The claimed slot's storage is zeroed here so the
  // caller can OR in fields word-at-a-time; a stale non-zero from a
  // prior tree cannot leak.
  pub let view_tree_node_alloc : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-10 (#2329): bump-alloc one node slot. Loads _view_node_bump[0]; if >= VT_NODE_MAX refuse (VT_NODE_ENOSPC); else store back the incremented value, compute base via view_tree_node_base, zero all six words, return the pre-increment index. Single callee-save push (r12=claimed_idx) keeps rsp aligned across the nested view_tree_node_base call. Labels prefixed view_tree_na2_.",
      block: {
        push r12;
        lea r10, [rip + _view_node_bump];
        mov rax, [r10 + 0];
        cmp rax, 128;
        jae view_tree_na2_enospc;
        mov r12, rax;                       // r12 = claimed idx
        add rax, 1;
        mov [r10 + 0], rax;

        // Zero the six words at &_view_node_pool[claimed_idx].
        mov rdi, r12;
        call view_tree_node_base;
        xor r11, r11;
        mov [rax + 0],  r11;
        mov [rax + 8],  r11;
        mov [rax + 16], r11;
        mov [rax + 24], r11;
        mov [rax + 32], r11;
        mov [rax + 40], r11;

        mov rax, r12;
        jmp view_tree_na2_out;

      view_tree_na2_enospc:
        mov rax, 0xFFFFEABA;                // VT_NODE_ENOSPC

      view_tree_na2_out:
        pop r12;
        ret
      }
    }

  // view_tree_node_in_use: 1 iff pool idx < bump AND node's in_use
  // bit is set. Used by view_tree_append_node to gate parent_id.
  pub let view_tree_node_in_use : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-10 (#2329): 1 iff idx < _view_node_bump AND node word0 in_use bit set. Single callee-save push (r12=idx) keeps rsp aligned. Labels prefixed view_tree_niu_.",
      block: {
        push r12;
        mov r12, rdi;

        cmp r12, 128;
        jae view_tree_niu_no;

        lea r10, [rip + _view_node_bump];
        mov rax, [r10 + 0];
        cmp r12, rax;
        jae view_tree_niu_no;

        mov rdi, r12;
        call view_tree_node_base;
        mov r11, [rax + 0];
        shr r11, 56;
        cmp r11, 0;
        je  view_tree_niu_no;
        mov rax, 1;
        jmp view_tree_niu_out;

      view_tree_niu_no:
        xor rax, rax;

      view_tree_niu_out:
        pop r12;
        ret
      }
    }

  // view_tree_node_tree_id: read the tree_id back-reference from a
  // node (word5[31:0]). Caller must have validated node_in_use.
  pub let view_tree_node_tree_id : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-10 (#2329): read tree_id from node[+40][31:0]. Single callee-save push (r12=idx). Labels prefixed view_tree_nti_.",
      block: {
        push r12;
        mov r12, rdi;
        mov rdi, r12;
        call view_tree_node_base;
        mov rax, [rax + 40];
        and rax, 0xFFFFFFFF;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Section 5  Factory: view_tree_new () -> tree_id | err
  // ==========================================================================
  //
  // The task-brief signature "view_tree_new() -> ViewTree" is
  // expressed as tree_id (u64 slot index) here to match the row-pool
  // shape every sibling factory uses (ui_context_new returns row_id,
  // wksp_new returns row_id, ...). The client passes tree_id into
  // every subsequent view_tree_* call.
  //
  // Refusal funnel through view_tree_new_refused bumps VT_ST_REFUSED
  // once. The row_alloc path also bumps VT_ST_NEW on success.

  pub let view_tree_new : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-10 (#2329): mint one ViewTree row. Delegates to view_tree_row_alloc; on success bumps VT_ST_NEW; on failure (sentinel >= VT_MAX) funnels through refused counter. Single callee-save push (rbx=tree_id) keeps rsp aligned. Labels prefixed view_tree_n_.",
      block: {
        push rbx;
        call view_tree_row_alloc;
        mov r10, 8;
        cmp rax, r10;
        jae view_tree_n_refused;            // rax is the sentinel

        mov rbx, rax;                       // stash tree_id
        mov rdi, 0;                         // VT_ST_NEW
        call view_tree_note;
        mov rax, rbx;
        jmp view_tree_n_out;

      view_tree_n_refused:
        mov rbx, rax;
        mov rdi, 6;                         // VT_ST_REFUSED
        call view_tree_note;
        mov rax, rbx;

      view_tree_n_out:
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Section 6  view_tree_append_node
  // ==========================================================================
  //
  // view_tree_append_node(tree_id, parent_id, kind, prop_hash,
  //                       state_ptr) -> node_id | err
  //
  // Gate order (fail-fast; refusal funnel bumps VT_ST_REFUSED once):
  //   (1) tree_id valid                       -> VT_BAD_SLOT
  //   (2) kind < VNK_MAX                      -> VT_BAD_KIND
  //   (3) parent_id == 0 OR (parent_id names an in-use node in THIS
  //       tree)                               -> VT_BAD_PARENT
  //   (4) node bump-alloc succeeds            -> VT_NODE_ENOSPC
  //
  // On success:
  //   - Stamp node word0 = in_use[63:56] | kind[39:32] | node_id[31:0]
  //     where node_id == the fresh pool index (u32).
  //   - Stamp node word3 = prop_hash.
  //   - Stamp node word4 = state_ptr.
  //   - Stamp node word5 = tree_id (back-reference for VT_BAD_PARENT
  //     cross-tree gate).
  //   - If parent_id == 0: set tree's root_id in place if it was 0
  //     (first node becomes root); leave node's parent_id = 0 and
  //     next_sibling = 0 (root's siblings meaningless).
  //   - If parent_id != 0: node's parent_id = parent, node's next_
  //     sibling = parent's old first_child, parent's first_child =
  //     new node.
  //   - Bump tree's node_count.
  //   - Bump VT_ST_APPENDS.

  pub let view_tree_append_node : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (tree_id: u64) (parent_id: u64) (kind: u64) (prop_hash: u64) (state_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-10 (#2329): claim one node from the bump pool + link into parent's child list + stamp tree's root_id on first append with parent==0. Five callee-save pushes (rbx=tree_id, r12=parent_id, r13=kind, r14=prop_hash, r15=state_ptr) then one xchg to keep rsp%16 == 8 -> +40 = rsp%16 == 0 for nested calls. Args stashed BEFORE any nested-call clobber. Refusal funnel via view_tree_an_refused. Labels prefixed view_tree_an_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;                         // rsp %16 == 0 for nested calls

        mov rbx, rdi;                       // tree_id
        mov r12, rsi;                       // parent_id
        mov r13, rdx;                       // kind
        mov r14, rcx;                       // prop_hash
        mov r15, r8;                        // state_ptr

        // (1) tree_id valid.
        mov rdi, rbx;
        call view_tree_row_valid;
        cmp rax, 0;
        je  view_tree_an_bad_slot;

        // (2) kind < VNK_MAX.
        mov rdi, r13;
        call view_tree_kind_valid;
        cmp rax, 0;
        je  view_tree_an_bad_kind;

        // (3) parent_id == 0 -> allowed (root case); else parent must
        //     be in-use AND belong to THIS tree.
        cmp r12, 0;
        je  view_tree_an_parent_ok;

        mov rdi, r12;
        call view_tree_node_in_use;
        cmp rax, 0;
        je  view_tree_an_bad_parent;

        mov rdi, r12;
        call view_tree_node_tree_id;
        cmp rax, rbx;
        jne view_tree_an_bad_parent;

      view_tree_an_parent_ok:
        // (4) bump-alloc one node.
        call view_tree_node_alloc;
        cmp rax, 128;
        jae view_tree_an_node_enospc;       // rax already VT_NODE_ENOSPC

        // rax = fresh pool idx = node_id. Save to r10 for downstream
        // writes; we no longer need any of r13..r15 after their
        // consumption below, but keep rbx (tree_id) + r12 (parent_id)
        // alive for the link step.
        push rax;                           // stash node_id on stack (rsp %16 == 8)
        sub rsp, 8;                         // rsp %16 == 0

        // Compute node base -> stored in r11 across writes.
        mov rdi, rax;                       // rdi = node_id
        call view_tree_node_base;
        // rax = node base pointer.

        // word0 = (1 << 56) | (kind << 32) | node_id
        // Rebuild node_id from stack (we destroyed it via rdi=arg).
        mov r10, [rsp + 8];                 // node_id
        and r10, 0xFFFFFFFF;                // safety mask
        mov r11, r13;
        and r11, 0xFF;
        shl r11, 32;
        or  r10, r11;                       // r10 = kind<<32 | node_id
        mov r11, 1;
        shl r11, 56;
        or  r10, r11;                       // r10 = in_use | kind | node_id
        mov [rax + 0], r10;

        // word3 = prop_hash
        mov [rax + 24], r14;

        // word4 = state_ptr
        mov [rax + 32], r15;

        // word5 = tree_id (low 32 bits)
        mov r10, rbx;
        and r10, 0xFFFFFFFF;
        mov [rax + 40], r10;

        // Link step. parent_id in r12.
        cmp r12, 0;
        jne view_tree_an_link_child;

        // parent == 0 case: root.  Stamp tree's root_id[31:0] IN
        // PLACE if root_id currently 0 (first-with-null-parent wins).
        lea r10, [rip + _view_tree_table];
        mov r11, rbx;
        shl r11, 5;
        add r10, r11;                       // r10 = tree row base
        mov r11, [r10 + 0];
        mov rcx, r11;
        and rcx, 0xFFFFFFFF;                // rcx = current root_id
        cmp rcx, 0;
        jne view_tree_an_link_done;         // root already set, leave

        // Write root_id into low 32 bits of tree word0 (preserving
        // in_use in byte 7 and any reserved middle bits).
        mov rcx, 0xFFFFFFFF;
        not rcx;
        and r11, rcx;                       // clear low 32
        mov rcx, [rsp + 8];                 // node_id
        and rcx, 0xFFFFFFFF;
        or  r11, rcx;
        mov [r10 + 0], r11;
        jmp view_tree_an_link_done;

      view_tree_an_link_child:
        // parent != 0: link into parent's first-child list.
        // parent word1 = parent_id[31:0] | first_child_id[63:32]
        //   - Read parent's word1 -> old_first_child = high 32.
        //   - Write node's word1  = parent_id[31:0] | old_first_child[63:32].
        //   - Wait: that would put OLD first_child into node's next_
        //     sibling slot, but the layout has parent_id in word1
        //     and next_sibling in word2. Let me re-do carefully.
        // Layout recap:
        //   node word1 = parent_id[31:0] | first_child_id[63:32]   (node's own children ptr)
        //   node word2 = next_sibling_id[31:0] | reserved
        // So the linking:
        //   1. old_first = parent.word1[63:32]  (parent's first_child)
        //   2. node.word2[31:0] = old_first     (node's next_sibling)
        //   3. node.word1[31:0] = parent_id     (node's parent)
        //   4. parent.word1[63:32] = node_id    (parent's first_child = new node)

        // rax still node base. Save it (nested call will clobber).
        push rax;                           // node base (rsp %16 == 8)
        sub rsp, 8;                         // rsp %16 == 0

        // Compute parent base -> keep in r10.
        mov rdi, r12;
        call view_tree_node_base;
        mov r10, rax;                       // r10 = parent base

        mov rax, [rsp + 8];                 // rax = node base
        add rsp, 16;                        // pop node base scratch

        // parent word1
        mov r11, [r10 + 8];
        mov rcx, r11;
        shr rcx, 32;                        // rcx = old_first_child
        and rcx, 0xFFFFFFFF;

        // node.word2[31:0] = old_first_child (preserve upper reserved).
        mov r13, [rax + 16];
        mov rdx, 0xFFFFFFFF;
        not rdx;
        and r13, rdx;                       // clear low 32
        or  r13, rcx;
        mov [rax + 16], r13;

        // node.word1[31:0] = parent_id.
        mov r13, [rax + 8];
        mov rdx, 0xFFFFFFFF;
        not rdx;
        and r13, rdx;
        mov rcx, r12;
        and rcx, 0xFFFFFFFF;
        or  r13, rcx;
        mov [rax + 8], r13;

        // parent.word1[63:32] = node_id.
        mov rcx, [rsp + 8];                 // node_id (still on stack from outer push)
        and rcx, 0xFFFFFFFF;
        shl rcx, 32;
        mov r11, [r10 + 8];
        mov rdx, 0xFFFFFFFF;
        shl rdx, 32;
        not rdx;
        and r11, rdx;                       // clear high 32
        or  r11, rcx;
        mov [r10 + 8], r11;

      view_tree_an_link_done:
        // Bump tree's node_count (word1[31:0]).
        lea r10, [rip + _view_tree_table];
        mov r11, rbx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 8];
        mov rcx, rax;
        and rcx, 0xFFFFFFFF;
        add rcx, 1;
        mov rdx, 0xFFFFFFFF;
        not rdx;
        and rax, rdx;
        or  rax, rcx;
        mov [r10 + 8], rax;

        // Return node_id (bottom of stack: [rsp+8]).
        mov rax, [rsp + 8];
        add rsp, 16;                        // pop node_id + pad

        // Bump VT_ST_APPENDS.
        mov rbx, rax;                       // stash node_id
        mov rdi, 2;                         // VT_ST_APPENDS
        call view_tree_note;
        mov rax, rbx;
        jmp view_tree_an_out;

      view_tree_an_bad_slot:
        mov rax, 0xFFFFEABD;                // VT_BAD_SLOT
        jmp view_tree_an_refused;
      view_tree_an_bad_kind:
        mov rax, 0xFFFFEABB;                // VT_BAD_KIND
        jmp view_tree_an_refused;
      view_tree_an_bad_parent:
        mov rax, 0xFFFFEABC;                // VT_BAD_PARENT
        jmp view_tree_an_refused;
      view_tree_an_node_enospc:
        // rax already VT_NODE_ENOSPC (0xFFFFEABA).

      view_tree_an_refused:
        mov rbx, rax;
        mov rdi, 6;                         // VT_ST_REFUSED
        call view_tree_note;
        mov rax, rbx;

      view_tree_an_out:
        add rsp, 8;                         // undo initial rsp align
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Section 7  view_tree_diff
  // ==========================================================================
  //
  // view_tree_diff(tree_id, prev_prop_hashes_ptr) -> dirty_count | err
  //
  // Walks pool indices [0..node_count) for THIS tree (nodes whose
  // word5 tree_id == tree_id AND in_use bit set), compares each
  // node's prop_hash (word3) with prev_prop_hashes_ptr[node_idx],
  // sets dirty_bitmap bit (node_idx) on mismatch, returns the number
  // of newly-dirty nodes. Nodes beyond dirty_bitmap width
  // (VT_DIRTY_BITS == 64) are always treated as dirty; the count
  // still increments for them.
  //
  // First-frame case: if the tree's frame_num == 0 at entry, the
  // pointer contents are ignored and ALL in-tree nodes are marked
  // dirty (dirty_bitmap = 0xFFFFFFFFFFFFFFFF for indices 0..63; count
  // == total in-tree nodes).
  //
  // Refusals:
  //   - tree_id invalid           -> VT_BAD_SLOT
  //   - prev_prop_hashes_ptr == 0 -> VT_DIFF_BAD_PTR

  pub let view_tree_diff : (u64, u64) -> u64 !{mem} @{} =
    fn (tree_id: u64) (prev_hashes_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-10 (#2329): walk [0..bump), skip nodes not owned by tree_id or not in_use, compare prop_hash to prev_hashes[idx], set dirty bit and count. Four callee-save pushes (rbx=tree_id, r12=prev_ptr, r13=idx, r14=dirty_count) keep rsp%16 aligned. Labels prefixed view_tree_d_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov rbx, rdi;                       // tree_id
        mov r12, rsi;                       // prev_hashes_ptr

        // Gate: tree valid.
        mov rdi, rbx;
        call view_tree_row_valid;
        cmp rax, 0;
        je  view_tree_d_bad_slot;

        // Gate: prev_hashes_ptr nonzero.
        cmp r12, 0;
        je  view_tree_d_bad_ptr;

        // Load tree row base + frame_num into r15-alt (use rax
        // temporarily; frame_num consumed as first-frame flag).
        lea r10, [rip + _view_tree_table];
        mov r11, rbx;
        shl r11, 5;
        add r10, r11;
        mov rcx, [r10 + 16];                // rcx = frame_num
        // frame_num == 0 -> first-frame -> mark all dirty.

        // Load current bump into rdx (walk bound).
        lea r11, [rip + _view_node_bump];
        mov rdx, [r11 + 0];
        cmp rdx, 128;
        jbe view_tree_d_have_bound;
        mov rdx, 128;
      view_tree_d_have_bound:

        xor r13, r13;                       // idx
        xor r14, r14;                       // dirty_count
        xor r8,  r8;                        // accumulated dirty_bitmap

      view_tree_d_loop:
        cmp r13, rdx;
        jae view_tree_d_done;

        // Check node in-use AND belongs to this tree.
        mov rdi, r13;
        call view_tree_node_in_use;
        cmp rax, 0;
        je  view_tree_d_next;

        mov rdi, r13;
        call view_tree_node_tree_id;
        cmp rax, rbx;
        jne view_tree_d_next;

        // First-frame? All in-tree nodes dirty.
        cmp rcx, 0;
        je  view_tree_d_mark_dirty;

        // Compare prop_hash to prev[idx].
        mov rdi, r13;
        call view_tree_node_base;
        mov r9, [rax + 24];                 // current prop_hash
        mov r11, [r12 + r13 * 8];           // prev_hashes_ptr[idx]
        cmp r9, r11;
        je  view_tree_d_next;

      view_tree_d_mark_dirty:
        add r14, 1;
        // Set bitmap bit idx if idx < 64.
        cmp r13, 64;
        jae view_tree_d_next;
        mov r9, 1;
        mov rcx, r13;
        shl r9, cl;
        or  r8, r9;
        // Reload rcx (frame_num) -- we clobbered it as shift count.
        mov rcx, [r10 + 16];

      view_tree_d_next:
        add r13, 1;
        jmp view_tree_d_loop;

      view_tree_d_done:
        // Write accumulated dirty_bitmap into tree row word3.
        mov [r10 + 24], r8;

        // Bump VT_ST_DIFFS + accumulate VT_ST_DIRTY_TOTAL.
        mov rbx, r14;                       // stash return value
        mov rdi, 3;                         // VT_ST_DIFFS
        call view_tree_note;
        mov rdi, 7;                         // VT_ST_DIRTY_TOTAL
        mov rsi, rbx;
        call view_tree_note_add;
        mov rax, rbx;
        jmp view_tree_d_out;

      view_tree_d_bad_slot:
        mov rax, 0xFFFFEABD;
        jmp view_tree_d_refused;
      view_tree_d_bad_ptr:
        mov rax, 0xFFFFEAB8;

      view_tree_d_refused:
        mov rbx, rax;
        mov rdi, 6;                         // VT_ST_REFUSED
        call view_tree_note;
        mov rax, rbx;

      view_tree_d_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Section 8  view_tree_reconcile
  // ==========================================================================
  //
  // view_tree_reconcile(tree_id, ui_context_row_id) -> emitted_count | err
  //
  // Walks the tree DEPTH-FIRST from root_id (following first_child /
  // next_sibling pointers). For every node whose dirty bit is set
  // (or every node if frame_num == 0), it maps the node's kind to a
  // widget primitive and (WOULD) emit the call:
  //
  //   VNK_CONTAINER  -> no direct widget call; recurse into children
  //   VNK_BUTTON     -> widget_button(ui_context, rect, label_offset)
  //   VNK_LABEL      -> widget_label(ui_context, rect, text_offset, text_len)
  //   VNK_LIST       -> widget_list_row per child (G12.M2-002 concern)
  //   VNK_TEXTFIELD  -> widget_textfield (G12.M2-002 concern)
  //   VNK_CHECKBOX   -> widget_checkbox(ui_context, rect, label_offset, state_ptr)
  //   VNK_SLIDER     -> widget_slider(ui_context, rect, value_ptr, min, max)
  //   VNK_TREE       -> widget_tree_row per child (G12.M2-002 concern)
  //
  // The DELEGATION SITE for the widget-call fanout is deferred to
  // G12.M2-003 (retained_state.pdx, #2331) because the per-kind rect
  // + payload extraction from the state blob requires the standard-
  // ised blob shape that lands there. Until then this landing wires
  // the DISPATCH SKELETON: it walks the tree, counts nodes it WOULD
  // emit (matching the dirty selection), bumps VT_ST_RECONCILES, and
  // returns the emitted_count. A future patch to this file will
  // replace the "emit" body with the actual widget_* calls per kind.
  //
  // Refusals:
  //   - tree_id invalid  -> VT_BAD_SLOT
  //   - ui_context_row_id invalid -> handled by the widget primitives
  //     themselves at emit time; this file does not double-gate
  //     (widgets.pdx has WIDGETS_BAD_SLOT for its own row check)

  pub let view_tree_reconcile : (u64, u64) -> u64 !{mem} @{} =
    fn (tree_id: u64) (ui_context_row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-10 (#2329): dispatch skeleton -- walk pool [0..bump) restricted to nodes in THIS tree, count dirty nodes (or all on first frame), bump VT_ST_RECONCILES. Widget-call fanout is a G12.M2-003 concern (see §Section 8 header). Four callee-save pushes (rbx=tree_id, r12=idx, r13=emitted_count, r14=dirty_bitmap_snapshot) keep rsp%16 aligned. Labels prefixed view_tree_r_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov rbx, rdi;                       // tree_id
        // ui_context_row_id (rsi) passed through unused for now (see
        // Section 8 delegation-site note); the widget primitives that
        // land here in G12.M2-003 will read it via the call-site
        // load of rsi. Suppress-unused: keep in rsi.

        mov rdi, rbx;
        call view_tree_row_valid;
        cmp rax, 0;
        je  view_tree_r_bad_slot;

        // Load tree row: frame_num + dirty_bitmap.
        lea r10, [rip + _view_tree_table];
        mov r11, rbx;
        shl r11, 5;
        add r10, r11;
        mov rcx, [r10 + 16];                // rcx = frame_num
        mov r14, [r10 + 24];                // r14 = dirty_bitmap snapshot

        // Walk pool [0..bump).
        lea r11, [rip + _view_node_bump];
        mov rdx, [r11 + 0];
        cmp rdx, 128;
        jbe view_tree_r_have_bound;
        mov rdx, 128;
      view_tree_r_have_bound:

        xor r12, r12;                       // idx
        xor r13, r13;                       // emitted_count

      view_tree_r_loop:
        cmp r12, rdx;
        jae view_tree_r_done;

        mov rdi, r12;
        call view_tree_node_in_use;
        cmp rax, 0;
        je  view_tree_r_next;

        mov rdi, r12;
        call view_tree_node_tree_id;
        cmp rax, rbx;
        jne view_tree_r_next;

        // Dirty selection: first-frame -> all dirty; else consult
        // bitmap for idx < 64; else always-dirty (fallback).
        cmp rcx, 0;
        je  view_tree_r_do_emit;
        cmp r12, 64;
        jae view_tree_r_do_emit;
        mov r9, 1;
        mov rax, r12;
        push rcx;                           // shl clobbers cl; save rcx
        mov rcx, rax;
        shl r9, cl;
        pop rcx;
        and r9, r14;
        cmp r9, 0;
        je  view_tree_r_next;

      view_tree_r_do_emit:
        // DELEGATION SITE (G12.M2-003): extract node kind (word0[39:32])
        // and dispatch to the matching widget_* primitive from
        // widgets.pdx with rect + payload from the node's state blob
        // (word4). VNK_CONTAINER emits nothing (skip). Until the state
        // -blob standardisation lands, this skeleton counts and bumps.
        add r13, 1;

      view_tree_r_next:
        add r12, 1;
        jmp view_tree_r_loop;

      view_tree_r_done:
        mov rbx, r13;                       // stash count
        mov rdi, 4;                         // VT_ST_RECONCILES
        call view_tree_note;
        mov rax, rbx;
        jmp view_tree_r_out;

      view_tree_r_bad_slot:
        mov rax, 0xFFFFEABD;
        mov rbx, rax;
        mov rdi, 6;                         // VT_ST_REFUSED
        call view_tree_note;
        mov rax, rbx;

      view_tree_r_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Section 9  view_tree_reset
  // ==========================================================================
  //
  // view_tree_reset(tree_id) -> 0 | VT_BAD_SLOT
  //
  // Clears the tree's node accounting so the client can rebuild from
  // scratch this frame:
  //   - Bump frame_num (word2 += 1).
  //   - Clear root_id to 0 (word0[31:0]).
  //   - Clear node_count to 0 (word1[31:0]).
  //   - Clear dirty_bitmap to 0 (word3).
  //   - Reset _view_node_bump to 0 (the whole pool is reclaimed).
  //
  // NB: the bump-pool reset is GLOBAL, not per-tree. A client that
  // holds multiple retained trees at once and resets one MUST reset
  // all trees together (or the surviving trees will hold node_ids
  // that alias fresh nodes appended by the client after the reset).
  // A future G12.M2-003 landing (retained_state.pdx, #2331) may
  // promote to per-tree bump arenas; the single-pool posture matches
  // the common "one retained view per app" case at zero cost.

  pub let view_tree_reset : (u64) -> u64 !{mem} @{} =
    fn (tree_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-10 (#2329): reset one tree's per-frame accounting + reset the global node bump. Single callee-save push (r12=tree_id) keeps rsp aligned across nested calls. Labels prefixed view_tree_rs_.",
      block: {
        push r12;
        mov r12, rdi;

        mov rdi, r12;
        call view_tree_row_valid;
        cmp rax, 0;
        je  view_tree_rs_bad_slot;

        // Compute tree row base.
        lea r10, [rip + _view_tree_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;

        // Bump frame_num (word2).
        mov rax, [r10 + 16];
        add rax, 1;
        mov [r10 + 16], rax;

        // Clear root_id (word0[31:0]) preserving in_use byte.
        mov rax, [r10 + 0];
        mov r11, 0xFFFFFFFF;
        not r11;
        and rax, r11;
        mov [r10 + 0], rax;

        // Clear node_count (word1[31:0]) preserving upper reserved.
        mov rax, [r10 + 8];
        mov r11, 0xFFFFFFFF;
        not r11;
        and rax, r11;
        mov [r10 + 8], rax;

        // Clear dirty_bitmap (word3).
        xor rax, rax;
        mov [r10 + 24], rax;

        // Reset the global node bump. See §Section 9 header note on
        // the single-pool posture.
        lea r10, [rip + _view_node_bump];
        xor rax, rax;
        mov [r10 + 0], rax;

        // Bump VT_ST_RESETS.
        mov rdi, 1;
        call view_tree_note;
        xor rax, rax;                       // VT_OK
        jmp view_tree_rs_out;

      view_tree_rs_bad_slot:
        mov rax, 0xFFFFEABD;
        mov r12, rax;
        mov rdi, 6;                         // VT_ST_REFUSED
        call view_tree_note;
        mov rax, r12;

      view_tree_rs_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Section 10  Revoke.
  // ==========================================================================

  pub let view_tree_revoke : (u64) -> u64 !{mem} @{} =
    fn (tree_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-10 (#2329): revoke one tree row. tree_id >= VT_MAX -> VT_BAD_SLOT; not in_use -> VT_REVOKE_ALREADY; else free + bump revokes + return 0. Labels prefixed view_tree_rv2_.",
      block: {
        push r12;
        mov r12, rdi;

        mov r10, 8;
        cmp r12, r10;
        jae view_tree_rv2_bad_slot;

        mov rdi, r12;
        call view_tree_row_valid;
        cmp rax, 0;
        je  view_tree_rv2_already;

        mov rdi, r12;
        call view_tree_row_free;
        mov rdi, 5;                         // VT_ST_REVOKES
        call view_tree_note;
        xor rax, rax;
        jmp view_tree_rv2_out;

      view_tree_rv2_bad_slot:
        mov rax, 0xFFFFEABD;                // VT_BAD_SLOT
        jmp view_tree_rv2_out;
      view_tree_rv2_already:
        mov rax, 0xFFFFEAB7;                // VT_REVOKE_ALREADY

      view_tree_rv2_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Section 11  Boot init.
  // ==========================================================================

  pub let view_tree_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-10 (#2329): call through to view_tree_stats_reset for one clean pool + counter zero-out. Labels prefixed view_tree_i_.",
      block: {
        call view_tree_stats_reset;
        ret
      }
    }
}
