// src/user/libpaideia_ui/layout.pdx -- Wave0-B11-08 (paideia-os #2328)
//
// G12.M1-003: IMMEDIATE-MODE LAYOUT CONTAINERS
// (horizontal / vertical / grid / z-order stack).
//
// Design authority: design/roadmap/next-wave-softarch.md §G12 toolkit
// stack and design/roadmap/next-wave-synthesis.md line 99. This file
// stacks the FIRST layout layer on top of the G12.M1-001 KIND_UI_
// CONTEXT root (immediate_context.pdx, KIND=0x1D5, Wave0-B8-05) and
// the G12.M1-002 widget primitives (widgets.pdx, Wave0-B10-09). A
// client typically wires the three together like this each frame:
//
//     let mut c : LayoutContainer = uninit;
//     let container_rect : WidgetRect = { x:0, y:0, w:400, h:300 };
//     layout_begin(&mut c, ctx_row, LAYOUT_VERTICAL, &container_rect, 4);
//     let mut r : WidgetRect = { x:0, y:0, w:120, h:24 };
//     layout_place_widget(&mut c, r.w, r.h, &mut r);
//     widget_button(ctx_row, &r, LBL_OK);
//     layout_place_widget(&mut c, r.w, r.h, &mut r);
//     widget_button(ctx_row, &r, LBL_CANCEL);
//     layout_end(&c);
//
// NOVEL-CLEAN POSTURE.  Immediate-mode layout matches the immediate-
// mode widget shape: the container is a plain stack-allocated struct
// owned by the client, mutated in place as each widget is placed.
// There is NO retained layout tree between frames (that is a
// retained-mode toolkit tax; see immediate_context.pdx §NOVEL-CLEAN
// POSTURE header). This file therefore owns NO row pool -- unlike
// its siblings (kind_ui_context, view_tree) it has no .bss table, no
// rights bitmask, no mint factory. Just a struct shape + a small
// function library that reads/writes it.
//
// -----------------------------------------------------------------------------
// LAYOUT CONTAINER STRUCT LAYOUT -- 64 BYTES (POWER-OF-2, ONE CACHE LINE)
// -----------------------------------------------------------------------------
//
//   [+0]  header:  parent_ctx_id[31:0] | dir[39:32] |
//                  reserved[47:40]     | gap_px[63:48]
//   [+8]  origin:  origin_x[31:0]      | origin_y[63:32]     -- top-left
//   [+16] size:    size_w[31:0]        | size_h[63:32]       -- extents
//   [+24] cursor:  next_child_x[31:0]  | next_child_y[63:32] -- placement head
//   [+32] misc:    children_placed[31:0] | grid_cols[47:32] |
//                  reserved[63:48]
//   [+40] cells:   cell_w[31:0]        | cell_h[63:32]       -- GRID only
//   [+48] reserved
//   [+56] reserved
//
// Fields:
//   parent_ctx_id -- KIND_UI_CONTEXT row id (u32) the layout binds to.
//                    Stored for downstream widget-call parity; layout
//                    body itself does not invoke the ctx directly.
//   dir           -- LayoutDir enum value (u8: 0..3).
//   gap_px        -- spacing between children in surface-space pixels
//                    (u16).
//   origin_x/y    -- top-left corner of the container in surface
//                    coordinates (i32; caller expected non-negative --
//                    see §Section 7 comment on the u32-domain
//                    arithmetic assumption).
//   size_w/h      -- container extents (i32, gated non-negative by
//                    widgets_rect_valid at begin). Widget placement
//                    past origin+size triggers LAYOUT_OVERFLOW.
//   next_child_x/y-- running cursor: the (x,y) where the NEXT widget
//                    will be placed. Reset by layout_begin to origin_x/y;
//                    advanced by layout_place_widget by the widget's
//                    extents + gap along the layout axis.
//   children_placed-- count of widgets placed so far (u32). Used both
//                    as a per-frame observability counter and as the
//                    LAYOUT_GRID cell index (col = c % grid_cols,
//                    row = c / grid_cols).
//   grid_cols     -- for LAYOUT_GRID: number of cells per row (u16);
//                    0 otherwise.
//   cell_w/cell_h -- for LAYOUT_GRID: per-cell extents (i32) captured
//                    at layout_grid_begin. Placement of the Nth widget
//                    into (col, row) uses (cell_w + gap_px) and
//                    (cell_h + gap_px) as strides; 0 otherwise.
//
// Total 64 bytes = one cache line, matching the KIND_UI_CONTEXT row
// size (immediate_context.pdx §Section 2). Chosen over the smallest
// packing (~40 bytes) because a hot per-frame layout struct sits in
// exactly one line, and 64 = 2^6 keeps the addressing style parity
// with sibling files.
//
// Little-endian storage throughout, matching every row-tail layout
// in this repo. No FPU per design/kernel/no-fpu.md. i32 fields are
// stored zero-extended into u32 slots; signed comparisons use the
// unsigned-bias trick (XOR with 0x80000000, unsigned compare) from
// damage_kind.pdx / widgets.pdx.
//
// -----------------------------------------------------------------------------
// LAYOUT DIRECTIONS
// -----------------------------------------------------------------------------
//
//   LAYOUT_HORIZONTAL = 0
//     Widgets flow left-to-right. next_child_x advances by
//     (widget_w + gap_px) per placement; next_child_y stays at
//     origin_y. Wrapping (multi-line horizontal) is out of scope
//     for this landing; wide rows overflow the container's right
//     edge and return LAYOUT_OVERFLOW at the widget that first
//     crosses it. Future policy (wrap vs. clip vs. scroll) belongs
//     to a G12.M2 layout-behaviour extension.
//
//   LAYOUT_VERTICAL = 1
//     Widgets flow top-to-bottom. next_child_y advances by
//     (widget_h + gap_px) per placement; next_child_x stays at
//     origin_x. Same overflow discipline as HORIZONTAL along the
//     bottom edge.
//
//   LAYOUT_GRID = 2
//     Widgets flow left-to-right, wrapping every grid_cols
//     placements. Placement of the Nth widget lands at
//         x = origin_x + (N % grid_cols) * (cell_w + gap_px)
//         y = origin_y + (N / grid_cols) * (cell_h + gap_px)
//     regardless of the widget_w/widget_h arguments to layout_
//     place_widget (grid layout is CELL-DRIVEN, not widget-driven).
//     widget_w/widget_h are still consumed for ABI-shape parity so
//     the caller need not fork the placement call per direction --
//     the out_rect is populated with (cell_w, cell_h) for GRID and
//     with (widget_w, widget_h) for the other three directions.
//
//   LAYOUT_STACK = 3
//     Z-order stack: all widgets overlap at (origin_x, origin_y).
//     next_child_x/y never advance; children_placed still counts
//     up so a downstream layer can pick a Z-order via the count.
//     No overflow (widgets always fit their own origin).
//
// -----------------------------------------------------------------------------
// FRAME-LIFECYCLE POSITION
// -----------------------------------------------------------------------------
//
// Layout containers live entirely INSIDE a frame -- a client typically
// calls layout_begin AFTER ui_context_begin_frame and BEFORE the first
// widget call, then layout_end before ui_context_end_frame. This file
// does not itself assert frame_in_progress; that assertion lives at the
// widget call sites (widgets.pdx §FRAME-LIFECYCLE CONTRACT) and any
// misuse (layout call outside a frame, widget call outside a layout)
// funnels through the widget-side allocate_id counter, matching the
// widgets.pdx posture.
//
// -----------------------------------------------------------------------------
// FAILURE TAXONOMY 0xFFFFEAD0..0xFFFFEADF
// -----------------------------------------------------------------------------
//
// NB: the task-brief-suggested band 0xFFFFEDD0..0xFFFFEDDF is FULLY
// CLAIMED across src/kernel/core/ipc/text_shape_channel.pdx §Section 2
// (grep hits at all 12 populated slots there). This file uses the
// next fresh 16-slot page, 0xFFFFEAD0..0xFFFFEADF, grep-verified free
// across src/, design/, and tests/ at landing. This comment records
// the choice so a future grep for the brief-suggested constant lands
// here.
//
// 16 slots give headroom past the immediate 10 refusal cases; the
// unused low half is reserved for G12.M1-004 follow-ups (wrap policy,
// clipping mode, ...).
//
// LAYOUT_OK  = 0 is the standard success return.
//
// -----------------------------------------------------------------------------
// ENCODER RULES + LABEL PREFIX
// -----------------------------------------------------------------------------
//
// paideia-as M0305 module = Layout (PascalCase of file basename
// layout.pdx). Labels prefixed `layout_`. Tag size = strlen+1 per
// the sibling files' convention. Encoder-conservative throughout:
// no `imul r,r,imm`, no imm64 forms via anonymous mov (large
// constants loaded via mov r10, <imm>; use-r10), no `add reg,[mem]`.
// Grid col*stride and row*stride are computed via a bounded add-
// loop rather than `imul` so this file's encoder budget matches
// the sibling widgets.pdx even without a 3-operand-imul primitive.
// For realistic children_placed counts (dozens per frame across
// grid_cols on the order of 4..16) this is a handful of add-branch
// iterations, well under a single memory-load's latency budget.
// Callee-save discipline: rbx / r12..r15 / rbp each pushed exactly
// once per function that uses them, keeping rsp%16 aligned before
// every nested call.

module Layout = structure {

  // ==========================================================================
  // Section 0  Constants: LayoutDir enum + struct offsets + caps.
  // ==========================================================================

  pub let LAYOUT_HORIZONTAL : u64 = 0
  pub let LAYOUT_VERTICAL   : u64 = 1
  pub let LAYOUT_GRID       : u64 = 2
  pub let LAYOUT_STACK      : u64 = 3
  pub let LAYOUT_DIR_MAX    : u64 = 4       // sentinel; dir >= this refused

  // Container struct: 64 bytes, byte-offsets of each u64 word.
  pub let LAYOUT_BYTES      : u64 = 64
  pub let LAYOUT_OFF_HEADER : u64 = 0
  pub let LAYOUT_OFF_ORIGIN : u64 = 8
  pub let LAYOUT_OFF_SIZE   : u64 = 16
  pub let LAYOUT_OFF_CURSOR : u64 = 24
  pub let LAYOUT_OFF_MISC   : u64 = 32
  pub let LAYOUT_OFF_CELLS  : u64 = 40
  // 48..63 reserved.

  // Field extraction masks (documented; body uses inline literals).
  pub let LAYOUT_U32_MASK   : u64 = 0xFFFFFFFF
  pub let LAYOUT_U16_MASK   : u64 = 0xFFFF
  pub let LAYOUT_U8_MASK    : u64 = 0xFF

  // WidgetRect layout (interop with widgets.pdx §Section 3):
  //   [+0]  x  : i32
  //   [+4]  y  : i32
  //   [+8]  w  : i32
  //   [+12] h  : i32
  pub let LAYOUT_RECT_OFF_X : u64 = 0
  pub let LAYOUT_RECT_OFF_Y : u64 = 4
  pub let LAYOUT_RECT_OFF_W : u64 = 8
  pub let LAYOUT_RECT_OFF_H : u64 = 12

  // ==========================================================================
  // Section 1  Failure taxonomy 0xFFFFEAD0..0xFFFFEADF.
  // ==========================================================================
  //
  // Fresh 16-slot page; grep-verified free across src/, design/, tests/
  // at landing. See the header note about the brief's suggested band
  // (0xFFFFEDD0..0xFFFFEDDF) being already claimed by text_shape_
  // channel.pdx.

  pub let LAYOUT_OK              : u64 = 0
  pub let LAYOUT_BAD_CONTAINER   : u64 = 0xFFFFEADF   // container_ptr == 0
  pub let LAYOUT_BAD_CTX         : u64 = 0xFFFFEADE   // ctx == 0 or > u32 max
  pub let LAYOUT_BAD_DIR         : u64 = 0xFFFFEADD   // dir >= LAYOUT_DIR_MAX
  pub let LAYOUT_BAD_RECT        : u64 = 0xFFFFEADC   // rect_ptr == 0 / w<0 / h<0
  pub let LAYOUT_BAD_WH          : u64 = 0xFFFFEADB   // widget_w<0 or widget_h<0
  pub let LAYOUT_BAD_OUT         : u64 = 0xFFFFEADA   // out_rect_ptr == 0
  pub let LAYOUT_BAD_COLS        : u64 = 0xFFFFEAD9   // grid cols == 0 or > u16
  pub let LAYOUT_BAD_GAP         : u64 = 0xFFFFEAD8   // gap_px > u16 max
  pub let LAYOUT_OVERFLOW        : u64 = 0xFFFFEAD7   // cursor past container extents
  pub let LAYOUT_BAD_CELL        : u64 = 0xFFFFEAD6   // grid cell_w<0 or cell_h<0
  // 0xFFFFEAD0..0xFFFFEAD5 reserved for G12.M1-004 follow-ups.

  // ==========================================================================
  // Section 2  Counters -- observability without a row pool.
  // ==========================================================================
  //
  // Small stats vector; four u64 slots:
  //   [LAYOUT_ST_BEGINS]    -- layout_begin / _grid_begin / _stack_begin OK.
  //   [LAYOUT_ST_PLACES]    -- layout_place_widget OK.
  //   [LAYOUT_ST_OVERFLOWS] -- placement crossed container extent.
  //   [LAYOUT_ST_REFUSED]   -- refused entry-point invocations.

  pub let mut _layout_stats : [u64; 4] = uninit @align(64)

  pub let LAYOUT_ST_BEGINS    : u64 = 0
  pub let LAYOUT_ST_PLACES    : u64 = 1
  pub let LAYOUT_ST_OVERFLOWS : u64 = 2
  pub let LAYOUT_ST_REFUSED   : u64 = 3

  pub let layout_stats_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-08 (#2328): clear stats vector at boot. Four u64 slots. Labels prefixed layout_sr_.",
      block: {
        lea r10, [rip + _layout_stats];
        xor rax, rax;
        xor rcx, rcx;
      layout_sr_top:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  layout_sr_top;
        ret
      }
    }

  pub let layout_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-08 (#2328): counter bump. Encoder-conservative load-inc-store; no `add reg,[mem]`. Labels prefixed layout_nt_.",
      block: {
        cmp rdi, 4;
        jae layout_nt_out;
        lea r10, [rip + _layout_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      layout_nt_out:
        ret
      }
    }

  pub let layout_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-08 (#2328): counter read. Labels prefixed layout_st_.",
      block: {
        cmp rdi, 4;
        jae layout_st_zero;
        lea r10, [rip + _layout_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      layout_st_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Section 3  Simple validators.
  // ==========================================================================

  // layout_ptr_valid: 1 iff p != 0.
  pub let layout_ptr_valid : (u64) -> u64 !{} @{} =
    fn (p: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B11-08 (#2328): 1 iff p != 0. Labels prefixed layout_pv_.",
      block: {
        cmp rdi, 0;
        je  layout_pv_no;
        mov rax, 1;
        ret;
      layout_pv_no:
        xor rax, rax;
        ret
      }
    }

  // layout_dir_valid: 1 iff dir in {0,1,2,3}.
  pub let layout_dir_valid : (u64) -> u64 !{} @{} =
    fn (dir: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B11-08 (#2328): 1 iff dir < LAYOUT_DIR_MAX (4). Labels prefixed layout_dv_.",
      block: {
        cmp rdi, 4;
        jae layout_dv_no;
        mov rax, 1;
        ret;
      layout_dv_no:
        xor rax, rax;
        ret
      }
    }

  // layout_u16_valid: 1 iff v fits in 16 bits.
  pub let layout_u16_valid : (u64) -> u64 !{} @{} =
    fn (v: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B11-08 (#2328): 1 iff v <= 0xFFFF. Reg-load form for the 16-bit imm, matching widgets_i32_clamp's posture for large-imm compares. Labels prefixed layout_wv_.",
      block: {
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  layout_wv_no;
        mov rax, 1;
        ret;
      layout_wv_no:
        xor rax, rax;
        ret
      }
    }

  // layout_nonneg_i32: 1 iff v's low 32 bits sign bit is 0 (i.e., v
  // interpreted as i32 is >= 0). Encoder-conservative: mask 0x80000000
  // via a reg-load AND, matching widgets_rect_valid.
  pub let layout_nonneg_i32 : (u64) -> u64 !{} @{} =
    fn (v: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B11-08 (#2328): 1 iff low-32 sign bit clear (i32 >= 0). Same technique as widgets_rect_valid. Labels prefixed layout_nn_.",
      block: {
        mov rax, rdi;
        mov r10, 0x80000000;
        and rax, r10;
        cmp rax, 0;
        jne layout_nn_no;
        mov rax, 1;
        ret;
      layout_nn_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Section 4  Container field readers.
  // ==========================================================================
  //
  // NULL-tolerant helpers matching widgets_rect_x/y/w/h posture. A
  // caller with a genuine container reads via the entry points below;
  // these helpers are primarily used by internal implementation and
  // by testing / debug harnesses that want to inspect layout state.

  pub let layout_parent_ctx : (u64) -> u64 !{mem} @{} =
    fn (container_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-08 (#2328): parent_ctx_id at header[31:0]. NULL-tolerant (returns 0). Labels prefixed layout_pc_.",
      block: {
        cmp rdi, 0;
        je  layout_pc_zero;
        mov rax, [rdi + 0];
        and rax, 0xFFFFFFFF;
        ret;
      layout_pc_zero:
        xor rax, rax;
        ret
      }
    }

  pub let layout_dir : (u64) -> u64 !{mem} @{} =
    fn (container_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-08 (#2328): dir at header[39:32]. NULL-tolerant. Labels prefixed layout_d_.",
      block: {
        cmp rdi, 0;
        je  layout_d_zero;
        mov rax, [rdi + 0];
        shr rax, 32;
        and rax, 0xFF;
        ret;
      layout_d_zero:
        xor rax, rax;
        ret
      }
    }

  pub let layout_gap_px : (u64) -> u64 !{mem} @{} =
    fn (container_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-08 (#2328): gap_px at header[63:48]. NULL-tolerant. Labels prefixed layout_gp_.",
      block: {
        cmp rdi, 0;
        je  layout_gp_zero;
        mov rax, [rdi + 0];
        shr rax, 48;
        and rax, 0xFFFF;
        ret;
      layout_gp_zero:
        xor rax, rax;
        ret
      }
    }

  pub let layout_children_placed : (u64) -> u64 !{mem} @{} =
    fn (container_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-08 (#2328): children_placed at misc[31:0]. NULL-tolerant. Labels prefixed layout_cp_.",
      block: {
        cmp rdi, 0;
        je  layout_cp_zero;
        mov rax, [rdi + 32];
        and rax, 0xFFFFFFFF;
        ret;
      layout_cp_zero:
        xor rax, rax;
        ret
      }
    }

  pub let layout_grid_cols : (u64) -> u64 !{mem} @{} =
    fn (container_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-08 (#2328): grid_cols at misc[47:32]. NULL-tolerant. Labels prefixed layout_gc_.",
      block: {
        cmp rdi, 0;
        je  layout_gc_zero;
        mov rax, [rdi + 32];
        shr rax, 32;
        and rax, 0xFFFF;
        ret;
      layout_gc_zero:
        xor rax, rax;
        ret
      }
    }

  pub let layout_next_child_x : (u64) -> u64 !{mem} @{} =
    fn (container_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-08 (#2328): next_child_x at cursor[31:0]. NULL-tolerant. Labels prefixed layout_ncx_.",
      block: {
        cmp rdi, 0;
        je  layout_ncx_zero;
        mov rax, [rdi + 24];
        and rax, 0xFFFFFFFF;
        ret;
      layout_ncx_zero:
        xor rax, rax;
        ret
      }
    }

  pub let layout_next_child_y : (u64) -> u64 !{mem} @{} =
    fn (container_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-08 (#2328): next_child_y at cursor[63:32]. NULL-tolerant. Labels prefixed layout_ncy_.",
      block: {
        cmp rdi, 0;
        je  layout_ncy_zero;
        mov rax, [rdi + 24];
        shr rax, 32;
        and rax, 0xFFFFFFFF;
        ret;
      layout_ncy_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Section 5  Internal: layout_write_common
  // ==========================================================================
  //
  // layout_write_common(container_ptr, ctx, dir, rect_ptr, gap_px)
  //   populates the common fields (header, origin, size, cursor, misc,
  //   cells) for HORIZONTAL / VERTICAL / STACK. The cells word and
  //   grid_cols slot are zeroed here; layout_grid_begin patches them
  //   after the shared-stamp call. Caller MUST have validated all args.

  pub let layout_write_common : (u64, u64, u64, u64, u64) -> () !{mem} @{} =
    fn (container_ptr: u64) (ctx: u64) (dir: u64) (rect_ptr: u64) (gap_px: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-08 (#2328): stamp common fields. Caller has validated ptrs + ranges. Zero callee-save pushes needed (no nested calls). Labels prefixed layout_wc_.",
      block: {
        // Pack header = parent_ctx[31:0] | dir[39:32] | 0[47:40] | gap[63:48].
        mov rax, rsi;
        mov r11, 0xFFFFFFFF;
        and rax, r11;                     // parent_ctx_id
        mov r10, rdx;
        and r10, 0xFF;
        shl r10, 32;                      // dir at [39:32]
        or  rax, r10;
        mov r10, r8;
        mov r11, 0xFFFF;
        and r10, r11;
        shl r10, 48;                      // gap_px at [63:48]
        or  rax, r10;
        mov [rdi + 0], rax;

        // origin word: rect.x[31:0] | rect.y[63:32].
        mov_d rax, [rcx + 0];             // rect.x -> rax[31:0], zero-ext
        mov_d r10, [rcx + 4];             // rect.y
        shl r10, 32;
        or  rax, r10;
        mov [rdi + 8], rax;
        // Cursor starts at origin -- reuse rax.
        mov [rdi + 24], rax;

        // size word: rect.w[31:0] | rect.h[63:32].
        mov_d rax, [rcx + 8];             // rect.w
        mov_d r10, [rcx + 12];            // rect.h
        shl r10, 32;
        or  rax, r10;
        mov [rdi + 16], rax;

        // misc word: children_placed=0 | grid_cols=0 | reserved=0.
        xor rax, rax;
        mov [rdi + 32], rax;
        // cells word: cell_w=0 | cell_h=0.
        mov [rdi + 40], rax;
        // Reserved words.
        mov [rdi + 48], rax;
        mov [rdi + 56], rax;
        ret
      }
    }

  // ==========================================================================
  // Section 6  Public factories: layout_begin / _grid_begin / _stack_begin.
  // ==========================================================================
  //
  // layout_begin(container_ptr, ctx, dir, rect_ptr, gap_px) -> u64 status
  //
  // Gate order (fail-fast; refusal funnel bumps LAYOUT_ST_REFUSED once):
  //   (1) container_ptr != 0                    -> LAYOUT_BAD_CONTAINER
  //   (2) ctx != 0 AND fits in u32              -> LAYOUT_BAD_CTX
  //   (3) dir < LAYOUT_DIR_MAX (4)              -> LAYOUT_BAD_DIR
  //   (4) rect valid (nonzero ptr, w>=0, h>=0)  -> LAYOUT_BAD_RECT
  //   (5) gap_px fits in u16                    -> LAYOUT_BAD_GAP
  //
  // On success, layout_write_common stamps the struct + bump LAYOUT_ST_
  // BEGINS + return 0. Callers that want GRID or STACK dispatch through
  // the sibling factories below; both funnel back through this function
  // after packing dir and gap_px appropriately.

  pub let layout_begin : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (container_ptr: u64) (ctx: u64) (dir: u64) (rect_ptr: u64) (gap_px: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-08 (#2328): begin one HORIZONTAL / VERTICAL / STACK / GRID container. Five callee-save pushes (rbx=container_ptr, r12=ctx, r13=dir, r14=rect_ptr, r15=gap_px) leave rsp%16 == 0 for every nested call (entry %16 == 8, +40 -> %16 == 0). Refusal funnel bumps LAYOUT_ST_REFUSED once and returns the sentinel. Labels prefixed layout_bg_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                     // container_ptr
        mov r12, rsi;                     // ctx
        mov r13, rdx;                     // dir
        mov r14, rcx;                     // rect_ptr
        mov r15, r8;                      // gap_px

        // (1) container_ptr != 0.
        mov rdi, rbx;
        call layout_ptr_valid;
        cmp rax, 0;
        je  layout_bg_bad_container;

        // (2) ctx valid (nonzero AND fits in u32).
        mov rdi, r12;
        call immediate_context_kind_ref_valid;
        cmp rax, 0;
        je  layout_bg_bad_ctx;

        // (3) dir < LAYOUT_DIR_MAX.
        mov rdi, r13;
        call layout_dir_valid;
        cmp rax, 0;
        je  layout_bg_bad_dir;

        // (4) rect valid (nonzero, w>=0, h>=0).
        mov rdi, r14;
        call widgets_rect_valid;
        cmp rax, 0;
        je  layout_bg_bad_rect;

        // (5) gap_px fits in u16.
        mov rdi, r15;
        call layout_u16_valid;
        cmp rax, 0;
        je  layout_bg_bad_gap;

        // Stamp the struct.
        mov rdi, rbx;
        mov rsi, r12;
        mov rdx, r13;
        mov rcx, r14;
        mov r8,  r15;
        call layout_write_common;

        // Bump BEGINS + return OK.
        mov rdi, 0;                       // LAYOUT_ST_BEGINS
        call layout_note;
        xor rax, rax;                     // LAYOUT_OK
        jmp layout_bg_out;

      layout_bg_bad_container:
        mov rax, 0xFFFFEADF;              // LAYOUT_BAD_CONTAINER
        jmp layout_bg_refused;
      layout_bg_bad_ctx:
        mov rax, 0xFFFFEADE;              // LAYOUT_BAD_CTX
        jmp layout_bg_refused;
      layout_bg_bad_dir:
        mov rax, 0xFFFFEADD;              // LAYOUT_BAD_DIR
        jmp layout_bg_refused;
      layout_bg_bad_rect:
        mov rax, 0xFFFFEADC;              // LAYOUT_BAD_RECT
        jmp layout_bg_refused;
      layout_bg_bad_gap:
        mov rax, 0xFFFFEAD8;              // LAYOUT_BAD_GAP

      layout_bg_refused:
        mov rbx, rax;                     // stash sentinel
        mov rdi, 3;                       // LAYOUT_ST_REFUSED
        call layout_note;
        mov rax, rbx;

      layout_bg_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // layout_grid_begin(container_ptr, ctx, cols, rect_ptr,
  //                   cell_wh_packed, gap_px) -> u64 status
  //
  // cell_wh_packed = cell_w[31:0] | cell_h[63:32] (both i32-in-u32).
  //
  // Gates: same as layout_begin, PLUS
  //   (6) cols >= 1 AND cols fits in u16   -> LAYOUT_BAD_COLS
  //   (7) cell_w >= 0 AND cell_h >= 0      -> LAYOUT_BAD_CELL
  //
  // On success: calls layout_begin with dir=LAYOUT_GRID, then patches
  // the misc.grid_cols slot and the cells word.

  pub let layout_grid_begin : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (container_ptr: u64) (ctx: u64) (cols: u64) (rect_ptr: u64) (cell_wh_packed: u64) (gap_px: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-08 (#2328): grid convenience factory. Six callee-save pushes (rbx=container_ptr, r12=ctx, r13=cols, r14=rect_ptr, r15=cell_wh_packed, rbp=gap_px) + sub rsp,8 land rsp%16 == 0 for every nested call (entry %16 == 8, +48+8 = %16 == 0). Refusal funnel bumps LAYOUT_ST_REFUSED once. Labels prefixed layout_gb_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;
        sub  rsp, 8;

        mov rbx, rdi;                     // container_ptr
        mov r12, rsi;                     // ctx
        mov r13, rdx;                     // cols
        mov r14, rcx;                     // rect_ptr
        mov r15, r8;                      // cell_wh_packed
        mov rbp, r9;                      // gap_px

        // Reuse layout_begin's gates by calling it with dir=GRID.
        mov rdi, rbx;
        mov rsi, r12;
        mov rdx, 2;                       // LAYOUT_GRID
        mov rcx, r14;
        mov r8,  rbp;
        call layout_begin;
        cmp rax, 0;
        jne layout_gb_out_from_begin;     // sentinel already set + noted

        // (6) cols >= 1 AND cols fits in u16.
        cmp r13, 0;
        je  layout_gb_bad_cols;
        mov rdi, r13;
        call layout_u16_valid;
        cmp rax, 0;
        je  layout_gb_bad_cols;

        // (7) cell_w >= 0 AND cell_h >= 0.
        mov rdi, r15;
        call layout_nonneg_i32;           // low-32 = cell_w
        cmp rax, 0;
        je  layout_gb_bad_cell;
        mov rdi, r15;
        shr rdi, 32;                      // high-32 = cell_h
        call layout_nonneg_i32;
        cmp rax, 0;
        je  layout_gb_bad_cell;

        // Patch misc.grid_cols (bits 47:32) into the misc word,
        // preserving children_placed (bits 31:0) and reserved (bits
        // 63:48). Just after layout_begin the misc word is zero, so
        // the AND-clear is a no-op today; the mask stays so a future
        // layout_begin variant that seeds misc slots keeps this write
        // correct.
        mov rax, [rbx + 32];
        mov r10, 0xFFFF;
        shl r10, 32;                      // mask covering bits 47:32
        not r10;
        and rax, r10;                     // clear cols slot
        mov r10, r13;
        mov r11, 0xFFFF;
        and r10, r11;
        shl r10, 32;
        or  rax, r10;
        mov [rbx + 32], rax;

        // Patch cells word: cell_w[31:0] | cell_h[63:32] from packed input.
        mov rax, r15;
        mov r11, 0xFFFFFFFF;
        and rax, r11;                     // cell_w
        mov r10, r15;
        shr r10, 32;
        and r10, r11;                     // cell_h
        shl r10, 32;
        or  rax, r10;
        mov [rbx + 40], rax;

        xor rax, rax;                     // LAYOUT_OK
        jmp layout_gb_out;

      layout_gb_bad_cols:
        mov rax, 0xFFFFEAD9;              // LAYOUT_BAD_COLS
        jmp layout_gb_refused;
      layout_gb_bad_cell:
        mov rax, 0xFFFFEAD6;              // LAYOUT_BAD_CELL

      layout_gb_refused:
        mov rbx, rax;                     // stash sentinel
        mov rdi, 3;                       // LAYOUT_ST_REFUSED
        call layout_note;
        mov rax, rbx;
        jmp layout_gb_out;

      layout_gb_out_from_begin:
        // rax carries the layout_begin sentinel; refusal already noted.

      layout_gb_out:
        add rsp, 8;
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // layout_stack_begin(container_ptr, ctx, rect_ptr) -> u64 status
  //
  // Z-order stack: all widgets overlap at (rect.x, rect.y). Convenience
  // wrapper that dispatches through layout_begin with dir=LAYOUT_STACK
  // and gap_px=0 (gap is meaningless when children overlap).

  pub let layout_stack_begin : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (container_ptr: u64) (ctx: u64) (rect_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-08 (#2328): stack convenience factory. Trampolines to layout_begin with dir=LAYOUT_STACK, gap_px=0. Zero callee-save pushes; one sub rsp,8 aligns rsp%16 == 0 for the nested call. Labels prefixed layout_sb_.",
      block: {
        sub rsp, 8;
        // rdi=container_ptr, rsi=ctx unchanged.
        mov rcx, rdx;                     // rect_ptr -> arg4
        mov rdx, 3;                       // LAYOUT_STACK -> arg3
        xor r8, r8;                       // gap_px=0 -> arg5
        call layout_begin;
        add rsp, 8;
        ret
      }
    }

  // ==========================================================================
  // Section 7  layout_place_widget.
  // ==========================================================================
  //
  // layout_place_widget(container_ptr, widget_w, widget_h, out_rect_ptr)
  //   -> u64 status
  //
  // Gate order:
  //   (1) container_ptr != 0                    -> LAYOUT_BAD_CONTAINER
  //   (2) out_rect_ptr != 0                     -> LAYOUT_BAD_OUT
  //   (3) widget_w >= 0 AND widget_h >= 0       -> LAYOUT_BAD_WH
  //
  // Placement per LayoutDir:
  //
  //   HORIZONTAL: (x, y) = (next_child_x, next_child_y);
  //               next_child_x = next_child_x + widget_w + gap_px
  //
  //   VERTICAL:   (x, y) = (next_child_x, next_child_y);
  //               next_child_y = next_child_y + widget_h + gap_px
  //
  //   GRID:       col = children_placed % grid_cols
  //               row = children_placed / grid_cols
  //               x = origin_x + col * (cell_w + gap_px)
  //               y = origin_y + row * (cell_h + gap_px)
  //               (widget_w / widget_h ignored; out_rect w/h = cell_w/h)
  //
  //   STACK:      (x, y) = (origin_x, origin_y);
  //               cursor never advances.
  //
  // Overflow check: after computing (x, y), if x + w > origin_x + size_w
  // (horizontal / grid axes) OR y + h > origin_y + size_h (vertical /
  // grid axes), bump LAYOUT_ST_OVERFLOWS and return LAYOUT_OVERFLOW
  // WITHOUT writing out_rect. STACK skips overflow entirely (widgets
  // always fit their own origin).
  //
  // On success: writes out_rect { x, y, w, h }, increments children_
  // placed, advances cursor per dir, bumps LAYOUT_ST_PLACES, returns 0.
  //
  // ARITHMETIC ASSUMPTION: this landing treats origin_x/y and size_w/h
  // as non-negative u32-domain values. widgets_rect_valid gates size on
  // non-negativity; origin non-negativity is a caller convention (most
  // surfaces begin at (0, 0) or an offset that stays inside the display
  // extent). A future landing that supports negative-origin containers
  // will need to switch the horizontal/vertical overflow compares to
  // the unsigned-bias signed-compare pattern used in widgets_i32_clamp.
  // Documented here so a grep for LAYOUT_OVERFLOW lands the constraint.
  //
  // GRID div/mod: recomputed each place_widget via a bounded subtract
  // loop (no idiv emitted; see the module header for the rationale).
  // Since children_placed is a small integer in practice (dozens per
  // frame across grid_cols of 4..16), the loop cost is a few add-branch
  // iterations -- well under a memory load's latency budget.

  pub let layout_place_widget : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (container_ptr: u64) (widget_w: u64) (widget_h: u64) (out_rect_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-08 (#2328): place one widget within a container. Six callee-save pushes (rbx=container_ptr, r12=widget_w [becomes cell_w for GRID], r13=widget_h [becomes cell_h for GRID], r14=out_rect_ptr, r15=widget_x, rbp=widget_y) + sub rsp,8 land rsp%16 == 0 for every nested call (entry %16 == 8, +48+8 = %16 == 0). Dispatch on dir with a small compare-chain (LAYOUT_DIR_MAX == 4 so at most 4 arms). Refusal funnel bumps LAYOUT_ST_REFUSED once. Labels prefixed layout_pw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;
        sub  rsp, 8;

        mov rbx, rdi;                     // container_ptr
        mov r12, rsi;                     // widget_w
        mov r13, rdx;                     // widget_h
        mov r14, rcx;                     // out_rect_ptr

        // (1) container_ptr valid.
        mov rdi, rbx;
        call layout_ptr_valid;
        cmp rax, 0;
        je  layout_pw_bad_container;

        // (2) out_rect_ptr valid.
        cmp r14, 0;
        je  layout_pw_bad_out;

        // (3) widget_w / widget_h nonneg (i32 >= 0).
        mov rdi, r12;
        call layout_nonneg_i32;
        cmp rax, 0;
        je  layout_pw_bad_wh;
        mov rdi, r13;
        call layout_nonneg_i32;
        cmp rax, 0;
        je  layout_pw_bad_wh;

        // Dispatch on dir (header[39:32]).
        mov rax, [rbx + 0];
        shr rax, 32;
        and rax, 0xFF;

        cmp rax, 0;
        je  layout_pw_horiz;
        cmp rax, 1;
        je  layout_pw_vert;
        cmp rax, 2;
        je  layout_pw_grid;
        cmp rax, 3;
        je  layout_pw_stack;
        // Unknown dir -- container corrupted; refuse.
        mov rax, 0xFFFFEADD;              // LAYOUT_BAD_DIR
        jmp layout_pw_refused;

        // -- LAYOUT_HORIZONTAL --------------------------------------
      layout_pw_horiz:
        // widget_x = next_child_x (cursor low32).
        // widget_y = next_child_y (cursor high32).
        mov rax, [rbx + 24];
        mov r15, rax;
        mov r11, 0xFFFFFFFF;
        and r15, r11;                     // r15 = widget_x
        shr rax, 32;
        mov rbp, rax;
        and rbp, r11;                     // rbp = widget_y

        // Overflow: (widget_x + widget_w) > (origin_x + size_w)?
        mov rax, [rbx + 8];
        and rax, r11;                     // origin_x
        mov r10, [rbx + 16];
        and r10, r11;                     // size_w
        add rax, r10;                     // limit_x
        mov r10, r15;
        add r10, r12;                     // widget_x + widget_w
        cmp r10, rax;
        ja  layout_pw_overflow;

        // Advance cursor: next_child_x = old_x + widget_w + gap_px.
        mov rax, [rbx + 24];
        mov r10, rax;
        and r10, r11;                     // old next_child_x
        add r10, r12;
        // gap_px from header[63:48].
        mov r9, [rbx + 0];
        shr r9, 48;
        mov rdx, 0xFFFF;
        and r9, rdx;
        add r10, r9;
        and r10, r11;                     // mask new_x to u32
        // Repack cursor: new_x[31:0] | old_y[63:32].
        shr rax, 32;
        shl rax, 32;                      // clear low32
        or  rax, r10;
        mov [rbx + 24], rax;
        jmp layout_pw_commit;

        // -- LAYOUT_VERTICAL ----------------------------------------
      layout_pw_vert:
        mov rax, [rbx + 24];
        mov r15, rax;
        mov r11, 0xFFFFFFFF;
        and r15, r11;                     // widget_x
        shr rax, 32;
        mov rbp, rax;
        and rbp, r11;                     // widget_y

        // Overflow: (widget_y + widget_h) > (origin_y + size_h)?
        mov rax, [rbx + 8];
        shr rax, 32;
        and rax, r11;                     // origin_y
        mov r10, [rbx + 16];
        shr r10, 32;
        and r10, r11;                     // size_h
        add rax, r10;                     // limit_y
        mov r10, rbp;
        add r10, r13;
        cmp r10, rax;
        ja  layout_pw_overflow;

        // Advance cursor: next_child_y = old_y + widget_h + gap_px.
        mov rax, [rbx + 24];
        mov r10, rax;
        shr r10, 32;
        and r10, r11;                     // old next_child_y
        add r10, r13;
        mov r9, [rbx + 0];
        shr r9, 48;
        mov rdx, 0xFFFF;
        and r9, rdx;
        add r10, r9;
        and r10, r11;
        // Repack cursor: old_x[31:0] | new_y[63:32].
        and rax, r11;                     // low32 stays as old_x
        shl r10, 32;
        or  rax, r10;
        mov [rbx + 24], rax;
        jmp layout_pw_commit;

        // -- LAYOUT_GRID --------------------------------------------
        // See the header COMMENT above for the div/mod-via-loop
        // rationale. r10 = grid_cols, r11 = children_placed at entry.
      layout_pw_grid:
        mov rax, [rbx + 32];
        mov r11, rax;
        mov r9, 0xFFFFFFFF;
        and r11, r9;                      // r11 = children_placed
        shr rax, 32;
        mov rdx, 0xFFFF;
        and rax, rdx;                     // rax = grid_cols
        cmp rax, 0;
        je  layout_pw_bad_grid_col;       // corrupt: grid without cols

        // Compute col = children_placed % grid_cols
        //         row = children_placed / grid_cols
        // via a single bounded loop; scratches r15 as running row.
        xor r15, r15;                     // row accumulator
      layout_pw_grid_divmod:
        cmp r11, rax;
        jb  layout_pw_grid_divmod_done;
        sub r11, rax;
        add r15, 1;
        jmp layout_pw_grid_divmod;
      layout_pw_grid_divmod_done:
        // r11 = col, r15 = row.

        // Load cell_w, cell_h + gap_px.
        mov rcx, [rbx + 40];
        mov r8, rcx;
        and r8, r9;                       // r8 = cell_w
        shr rcx, 32;
        and rcx, r9;                      // rcx = cell_h
        mov r9, [rbx + 0];
        shr r9, 48;
        and r9, rdx;                      // r9 = gap_px

        // widget_x = origin_x + col * (cell_w + gap_px).
        // Accumulator in r10; loop counter reuses r11 (col, consumed).
        // Encoder-conservative "multiply via bounded add-loop" per the
        // module header rationale -- no `imul r,r,imm` emitted.
        mov rdx, r8;
        add rdx, r9;                      // cell_stride_w
        xor r10, r10;                     // accumulator
      layout_pw_grid_xmul_loop:
        cmp r11, 0;
        je  layout_pw_grid_xmul_end;
        add r10, rdx;
        sub r11, 1;
        jmp layout_pw_grid_xmul_loop;
      layout_pw_grid_xmul_end:
        // r10 = col * cell_stride_w. Add origin_x.
        mov rdx, [rbx + 8];
        mov r11, 0xFFFFFFFF;
        and rdx, r11;                     // origin_x
        add r10, rdx;
        mov r15, r10;                     // widget_x -> r15 (rewrite row)
        // (r15 previously held row; we no longer need it now that x is
        // computed. Row is recomputed below from a fresh divmod.)

        // Recompute row (r15 got clobbered above; re-derive from a
        // fresh divmod so subsequent y math has the correct count).
        mov rax, [rbx + 32];
        and rax, r11;                     // children_placed
        // grid_cols already lost from rax; reload.
        mov r9, [rbx + 32];
        shr r9, 32;
        mov rdx, 0xFFFF;
        and r9, rdx;                      // r9 = grid_cols (fresh)
        xor r13, r13;                     // row accum (r13 was widget_h;
                                          // will be reassigned cell_h below)
      layout_pw_grid_rowmod:
        cmp rax, r9;
        jb  layout_pw_grid_rowmod_done;
        sub rax, r9;
        add r13, 1;
        jmp layout_pw_grid_rowmod;
      layout_pw_grid_rowmod_done:
        // r13 = row.

        // Reload cell_w / cell_h / gap for the y multiply (r8/rcx/r9
        // survived the divmod above but reloading is defensive and
        // encoder-cheap).
        mov r8, [rbx + 40];
        mov r11, 0xFFFFFFFF;
        and r8, r11;                      // cell_w
        mov rcx, [rbx + 40];
        shr rcx, 32;
        and rcx, r11;                     // cell_h
        mov r9, [rbx + 0];
        shr r9, 48;
        mov rdx, 0xFFFF;
        and r9, rdx;                      // gap_px

        // widget_y = origin_y + row * (cell_h + gap_px).
        mov rdx, rcx;
        add rdx, r9;                      // cell_stride_h
        xor r10, r10;                     // accumulator
      layout_pw_grid_ymul_loop:
        cmp r13, 0;
        je  layout_pw_grid_ymul_end;
        add r10, rdx;
        sub r13, 1;
        jmp layout_pw_grid_ymul_loop;
      layout_pw_grid_ymul_end:
        mov rdx, [rbx + 8];
        shr rdx, 32;
        and rdx, r11;                     // origin_y
        add r10, rdx;
        mov rbp, r10;                     // widget_y -> rbp

        // GRID overwrites widget_w/widget_h with cell_w/cell_h for the
        // out_rect (grid is CELL-DRIVEN). Reload to be safe.
        mov r12, [rbx + 40];
        and r12, r11;                     // widget_w := cell_w
        mov r13, [rbx + 40];
        shr r13, 32;
        and r13, r11;                     // widget_h := cell_h

        // Overflow: (widget_x + cell_w) > (origin_x + size_w)?
        mov rax, [rbx + 8];
        and rax, r11;                     // origin_x
        mov r10, [rbx + 16];
        and r10, r11;                     // size_w
        add rax, r10;                     // limit_x
        mov r10, r15;
        add r10, r12;
        cmp r10, rax;
        ja  layout_pw_overflow;

        // (widget_y + cell_h) > (origin_y + size_h)?
        mov rax, [rbx + 8];
        shr rax, 32;
        and rax, r11;                     // origin_y
        mov r10, [rbx + 16];
        shr r10, 32;
        and r10, r11;                     // size_h
        add rax, r10;                     // limit_y
        mov r10, rbp;
        add r10, r13;
        cmp r10, rax;
        ja  layout_pw_overflow;

        // Cursor is not the source of truth for GRID (recomputed from
        // children_placed each call), but we still park it at the
        // current placement for observability + so a hypothetical
        // mid-frame dir switch to HORIZONTAL/VERTICAL resumes sanely.
        mov rax, r15;
        and rax, r11;
        mov r10, rbp;
        and r10, r11;
        shl r10, 32;
        or  rax, r10;
        mov [rbx + 24], rax;
        jmp layout_pw_commit;

        // -- LAYOUT_STACK -------------------------------------------
        // All widgets overlap at (origin_x, origin_y). No overflow,
        // no cursor advance. out_rect w/h stays widget_w/widget_h.
      layout_pw_stack:
        mov rax, [rbx + 8];
        mov r15, rax;
        mov r11, 0xFFFFFFFF;
        and r15, r11;                     // widget_x = origin_x
        shr rax, 32;
        mov rbp, rax;
        and rbp, r11;                     // widget_y = origin_y
        jmp layout_pw_commit;

        // -- Commit: write out_rect + advance children_placed + note --
      layout_pw_commit:
        // out_rect.x = r15, out_rect.y = rbp,
        // out_rect.w = r12, out_rect.h = r13.
        mov rax, r15;
        mov_d [r14 + 0], rax;
        mov rax, rbp;
        mov_d [r14 + 4], rax;
        mov rax, r12;
        mov_d [r14 + 8], rax;
        mov rax, r13;
        mov_d [r14 + 12], rax;

        // children_placed += 1 (misc[31:0]).
        mov rax, [rbx + 32];
        mov r10, rax;
        mov r11, 0xFFFFFFFF;
        and r10, r11;
        add r10, 1;
        and r10, r11;
        shr rax, 32;
        shl rax, 32;                      // preserve upper half
        or  rax, r10;
        mov [rbx + 32], rax;

        // Bump LAYOUT_ST_PLACES.
        mov rdi, 1;                       // LAYOUT_ST_PLACES
        call layout_note;
        xor rax, rax;                     // LAYOUT_OK
        jmp layout_pw_out;

      layout_pw_overflow:
        mov rdi, 2;                       // LAYOUT_ST_OVERFLOWS
        call layout_note;
        mov rax, 0xFFFFEAD7;              // LAYOUT_OVERFLOW
        jmp layout_pw_out;

      layout_pw_bad_container:
        mov rax, 0xFFFFEADF;              // LAYOUT_BAD_CONTAINER
        jmp layout_pw_refused;
      layout_pw_bad_out:
        mov rax, 0xFFFFEADA;              // LAYOUT_BAD_OUT
        jmp layout_pw_refused;
      layout_pw_bad_wh:
        mov rax, 0xFFFFEADB;              // LAYOUT_BAD_WH
        jmp layout_pw_refused;
      layout_pw_bad_grid_col:
        mov rax, 0xFFFFEAD9;              // LAYOUT_BAD_COLS
        // fallthrough

      layout_pw_refused:
        mov rbx, rax;                     // stash sentinel
        mov rdi, 3;                       // LAYOUT_ST_REFUSED
        call layout_note;
        mov rax, rbx;

      layout_pw_out:
        add rsp, 8;
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Section 8  layout_end.
  // ==========================================================================
  //
  // No-op stub (layout state is stack-allocated by the caller; nothing
  // to release). Present as a lifecycle bookend so client code reads
  // symmetrically (layout_begin ... layout_end) and so a future landing
  // that adds cleanup (e.g., emitting a per-container debug fingerprint)
  // has a natural wire-in point that requires no caller migration.
  // Returns LAYOUT_OK on non-NULL container; LAYOUT_BAD_CONTAINER on
  // NULL.

  pub let layout_end : (u64) -> u64 !{mem} @{} =
    fn (container_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-08 (#2328): lifecycle bookend (no-op). Returns LAYOUT_OK on non-NULL, LAYOUT_BAD_CONTAINER on NULL. Labels prefixed layout_e_.",
      block: {
        cmp rdi, 0;
        je  layout_e_bad;
        xor rax, rax;                     // LAYOUT_OK
        ret;
      layout_e_bad:
        mov rax, 0xFFFFEADF;              // LAYOUT_BAD_CONTAINER
        ret
      }
    }

  // ==========================================================================
  // Section 9  Boot init.
  // ==========================================================================
  //
  // Zero-out the stats vector once at library init. The client calls
  // ui_context_init then widgets_init then layout_init, in that order,
  // before the first frame (matches the sibling libraries' boot
  // cadence).

  pub let layout_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-08 (#2328): call through to layout_stats_reset for one clean counter zero-out. Labels prefixed layout_i_.",
      block: {
        call layout_stats_reset;
        ret
      }
    }

  // ==========================================================================
  // Section 10  Fingerprint tag.
  // ==========================================================================
  //
  // Data-only constant. Emitted by the library once layout_init has
  // been called and the first layout_begin runs (G12.M1-004 klog wire
  // will emit this; until then it is a compile-time literal). Follows
  // the pdx_kind_<name>_meta legacy-suffix convention (widgets.pdx
  // pdx_kind_widgets_meta, immediate_context.pdx pdx_kind_ui_context_
  // meta). Needs an allowlist entry in tools/verify-fingerprint-
  // coverage.sh with reason "Wave0-B11 G12-M1-003 (#2328) layout body
  // not yet emitted -- G12.M1-004 klog wire pending". This landing
  // adds that allowlist entry directly (see the sibling G12.M1-002
  // widgets entry above it) so the fingerprint-coverage gate stays
  // green.
  //
  // Length: "layout ready ok [legacy: LAYOUT READY OK]\0" = 42 bytes
  // (41 chars + NUL, per the strlen+1 rule).
  pub let pdx_kind_layout_meta : [u8; 42] = "layout ready ok [legacy: LAYOUT READY OK]\0"
}
