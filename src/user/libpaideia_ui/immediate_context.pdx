  // ==========================================================================
  // Section 10  Factory: ui_context_new (window, surface) -> row_id | err
  // ==========================================================================
  //
  // Gate order (fail-fast; refusal funnel bumps _ui_stats[UI_ST_REFUSED]
  // once):
  //   (1) window  != 0 AND fits in u32         -> UI_MINT_BAD_WINDOW
  //   (2) surface != 0 AND fits in u32         -> UI_MINT_BAD_SURFACE
  //   (3) body1_pack(window, surface)          -> UI_TAIL_BAD_ARG via
  //                                               the sentinel 0xFFFF..
  //   (4) tail_alloc(body1, state_ptr=0)       -> UI_TAIL_ENOSPC
  //
  // The state_hash_table_ptr is intentionally 0 at mint -- the retained
  // -state table is bound in a subsequent G12.M1-002/003 landing via
  // ui_context_bind_state_table (not in this file). The row helper
  // immediate_context_row_state_ptr tolerates the zero (returns 0).
  //
  // Note: this factory takes only (window, surface). The caller is
  // responsible for having already validated the KIND_WINDOW cap
  // carries R_WIN_MINT before invoking ui_context_new; that check is
  // the future dispatcher's concern, not this library helper's.

  pub let ui_context_new : (u64, u64) -> u64 !{mem} @{} =
    fn (window: u64) (surface: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B8-05 (#2326): mint one KIND_UI_CONTEXT row. Three callee-save pushes (rbx=window, r12=surface, r13=body1) leave rsp%16 == 8 -> +24 = rsp%16 == 0 for every nested call. Args stashed BEFORE any nested-call clobber. Refusal funnel through immediate_context_mb_refused bumps UI_ST_REFUSED once. Labels prefixed immediate_context_mb_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                     // window
        mov r12, rsi;                     // surface

        // (1) window valid: nonzero AND fits in u32.
        mov rdi, rbx;
        call immediate_context_kind_ref_valid;
        cmp rax, 0;
        je  immediate_context_mb_bad_window;

        // (2) surface valid: nonzero AND fits in u32.
        mov rdi, r12;
        call immediate_context_kind_ref_valid;
        cmp rax, 0;
        je  immediate_context_mb_bad_surface;

        // (3) Pack body1 = (window, surface).
        mov rdi, rbx;
        mov rsi, r12;
        call immediate_context_body1_pack;
        mov r13, rax;                     // body1

        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp r13, r10;
        je  immediate_context_mb_bad_pack;

        // (4) tail_alloc(body1, state_ptr=0).
        mov rdi, r13;
        xor rsi, rsi;                     // state_ptr = 0 at mint
        call immediate_context_tail_alloc;

        mov r10, 8;
        cmp rax, r10;
        jae immediate_context_mb_enospc;  // rax already the sentinel

        // Success: bump mints, preserve row_id across the note call.
        mov rbx, rax;
        mov rdi, 0;                       // UI_ST_MINTS
        call immediate_context_note;
        mov rax, rbx;
        jmp immediate_context_mb_out;

      immediate_context_mb_bad_window:
        mov rax, 0xFFFFEB7D;              // UI_MINT_BAD_WINDOW
        jmp immediate_context_mb_refused;
      immediate_context_mb_bad_surface:
        mov rax, 0xFFFFEB7C;              // UI_MINT_BAD_SURFACE
        jmp immediate_context_mb_refused;
      immediate_context_mb_bad_pack:
        mov rax, 0xFFFFEB7E;              // UI_TAIL_BAD_ARG
        jmp immediate_context_mb_refused;
      immediate_context_mb_enospc:
        // rax already UI_TAIL_ENOSPC (0xFFFFEB7F) from tail_alloc.

      immediate_context_mb_refused:
        mov rbx, rax;                     // stash sentinel
        mov rdi, 2;                       // UI_ST_REFUSED
        call immediate_context_note;
        mov rax, rbx;

      immediate_context_mb_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Section 11  Frame lifecycle: begin_frame / end_frame
  // ==========================================================================
  //
  // ui_context_begin_frame(row_id) -> 0 | UI_BAD_SLOT | UI_FRAME_BAD_STATE
  //
  // Asserts frame_in_progress == 0. On success: bump frame_number
  // (body2), reset widget_id_counter to 1 (body3[31:0] = 1, reserving
  // widget_id 0 as the "no widget" sentinel matching hover/click),
  // clear hover_widget_id (body3[63:32] = 0), clear click_widget_id
  // (body4[31:0] = 0), set frame_in_progress = 1 (header[7:0]).
  //
  // hover_widget_id and click_widget_id are re-populated between end_
  // frame N-1 and begin_frame N by KIND_INPUT_ROUTE routing (G12.M1-
  // 003); begin_frame's clearing here is the "unknown at start of
  // frame" reset that pointer routing overwrites synchronously before
  // the client sees the frame.

  pub let ui_context_begin_frame : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B8-05 (#2326): begin one frame. Row-slot gate, frame_in_progress gate, then reset per-frame state (bump frame_number, reset widget_id_counter to 1, clear hover+click routing slots, set frame_in_progress=1). Single callee-save push (r12=row_id) keeps rsp%16 aligned across the tail_valid + note nested calls. Labels prefixed immediate_context_bf_.",
      block: {
        push r12;
        mov r12, rdi;

        mov r10, 8;
        cmp r12, r10;
        jae immediate_context_bf_bad_slot;

        mov rdi, r12;
        call immediate_context_tail_valid;
        cmp rax, 0;
        je  immediate_context_bf_bad_slot;

        // Compute row base into r10 (surviving nested call).
        lea r10, [rip + _ui_table];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;

        // Check frame_in_progress == 0.
        mov rax, [r10 + 0];
        mov r11, rax;
        and r11, 0xFF;
        cmp r11, 0;
        jne immediate_context_bf_bad_state;

        // Bump frame_number (body2).
        mov rax, [r10 + 16];
        add rax, 1;
        mov [r10 + 16], rax;

        // Reset body3: widget_id_counter = 1, hover_widget_id = 0.
        mov rax, 1;
        mov [r10 + 24], rax;

        // Reset body4: click_widget_id = 0 (preserve upper reserved).
        xor rax, rax;
        mov [r10 + 32], rax;

        // Set frame_in_progress = 1 in header[7:0], preserving in_use.
        mov rax, [r10 + 0];
        mov r11, 0xFF;
        not r11;
        and rax, r11;                     // clear byte 0
        or  rax, 1;                       // set frame_in_progress = 1
        mov [r10 + 0], rax;

        // Bump UI_ST_FRAMES.
        mov rdi, 3;                       // UI_ST_FRAMES
        call immediate_context_note;
        xor rax, rax;                     // UI_OK
        jmp immediate_context_bf_out;

      immediate_context_bf_bad_slot:
        mov rax, 0xFFFFEB7A;              // UI_BAD_SLOT
        jmp immediate_context_bf_out;
      immediate_context_bf_bad_state:
        mov rax, 0xFFFFEB77;              // UI_FRAME_BAD_STATE

      immediate_context_bf_out:
        pop r12;
        ret
      }
    }

  // ui_context_end_frame(row_id) -> 0 | UI_BAD_SLOT | UI_FRAME_BAD_STATE
  //
  // Asserts frame_in_progress == 1. On success: (a) DELEGATE to
  // surface_commit.pdx via a future call to surface_commit_flush_stub
  // -- this landing leaves the delegation as an inline comment (the
  // flush protocol requires KIND_SURFACE_COMMIT linearity discipline
  // that is not yet in place; G12.M1-004 wires it in one shot); (b)
  // clear frame_in_progress = 0 in header[7:0].

  pub let ui_context_end_frame : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B8-05 (#2326): end one frame. Row-slot gate, frame_in_progress gate, then clear frame_in_progress = 0. The surface commit delegation to surface_commit_flush_stub (surface_commit.pdx) lands in G12.M1-004; until then this file leaves the delegation as an inline documentation reference and returns UI_OK on state-machine advance alone. Single callee-save push (r12=row_id). Labels prefixed immediate_context_ef_.",
      block: {
        push r12;
        mov r12, rdi;

        mov r10, 8;
        cmp r12, r10;
        jae immediate_context_ef_bad_slot;

        mov rdi, r12;
        call immediate_context_tail_valid;
        cmp rax, 0;
        je  immediate_context_ef_bad_slot;

        // Compute row base.
        lea r10, [rip + _ui_table];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;

        // Check frame_in_progress == 1.
        mov rax, [r10 + 0];
        mov r11, rax;
        and r11, 0xFF;
        cmp r11, 1;
        jne immediate_context_ef_bad_state;

        // DELEGATION SITE (G12.M1-004): call surface_commit_flush_stub
        // with the row's surface_kind_id (body1[63:32]) once that
        // protocol is wired. Until then, state-machine advance only.

        // Clear frame_in_progress = 0 in header[7:0], preserving in_use.
        mov rax, [r10 + 0];
        mov r11, 0xFF;
        not r11;
        and rax, r11;
        mov [r10 + 0], rax;

        xor rax, rax;                     // UI_OK
        jmp immediate_context_ef_out;

      immediate_context_ef_bad_slot:
        mov rax, 0xFFFFEB7A;              // UI_BAD_SLOT
        jmp immediate_context_ef_out;
      immediate_context_ef_bad_state:
        mov rax, 0xFFFFEB77;              // UI_FRAME_BAD_STATE

      immediate_context_ef_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Section 12  ID allocator: ui_context_allocate_id
  // ==========================================================================
  //
  // ui_context_allocate_id(row_id) -> widget_id (nonzero u32) | err
  //
  // Returns a fresh widget ID and increments the widget_id_counter in
  // place. Widget IDs 1..0xFFFFFFFE are returned in order; widget_id
  // 0xFFFFFFFF triggers UI_FRAME_OVERFLOW rather than wrapping (which
  // would alias widget 0 == "no widget" with a real widget). A frame
  // with more than 4 billion widgets is a client bug; the refusal
  // path here is a defensive gate, not a supported operating regime.
  //
  // Tolerant of frame_in_progress == 0 (see §Section 4 note): the
  // library helper pre-populates a sentinel widget outside the loop
  // to keep widget IDs stable across frame boundaries. The future
  // dispatcher's R_UI_ADD_WIDGET gate would refuse an add outside a
  // frame, but this file's allocate_id itself is used by both paths.

  pub let ui_context_allocate_id : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B8-05 (#2326): allocate fresh widget ID within a frame. Load widget_id_counter from body3[31:0]; if == 0xFFFFFFFF refuse (UI_FRAME_OVERFLOW); else store back the incremented value and return the pre-increment value. Preserves hover_widget_id in body3[63:32]. Single callee-save push (r12=row_id). Labels prefixed immediate_context_ai_.",
      block: {
        push r12;
        mov r12, rdi;

        mov r10, 8;
        cmp r12, r10;
        jae immediate_context_ai_bad_slot;

        mov rdi, r12;
        call immediate_context_tail_valid;
        cmp rax, 0;
        je  immediate_context_ai_bad_slot;

        // Compute row base.
        lea r10, [rip + _ui_table];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;

        // Load body3 = widget_id_counter[31:0] | hover_widget_id[63:32].
        mov rax, [r10 + 24];
        mov r11, rax;
        shr r11, 32;                      // r11 = hover (preserved)
        and rax, 0xFFFFFFFF;              // rax = widget_id_counter

        // Refuse at 0xFFFFFFFF (would wrap to 0 == "no widget").
        mov rcx, 0xFFFFFFFF;
        cmp rax, rcx;
        je  immediate_context_ai_overflow;

        // Increment and store back the packed body3.
        mov rdx, rax;                     // rdx = returned widget_id
        add rax, 1;                       // widget_id_counter += 1
        // Repack: body3 = widget_id_counter[31:0] | hover[63:32].
        shl r11, 32;
        or  rax, r11;
        mov [r10 + 24], rax;

        mov rax, rdx;                     // return pre-increment value
        jmp immediate_context_ai_out;

      immediate_context_ai_bad_slot:
        mov rax, 0xFFFFEB7A;              // UI_BAD_SLOT
        jmp immediate_context_ai_out;
      immediate_context_ai_overflow:
        mov rax, 0xFFFFEB76;              // UI_FRAME_OVERFLOW

      immediate_context_ai_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Section 13  Query helpers: is_hovered / was_clicked
  // ==========================================================================
  //
  // ui_context_is_hovered(row_id, widget_id) -> bool (0 or 1)
  // ui_context_was_clicked(row_id, widget_id) -> bool (0 or 1)
  //
  // Both return 0 (not-matching) when the row is invalid, when the
  // widget_id argument is 0 ("no widget"), or when the row's per-
  // frame routing slot does not match widget_id. This is deliberately
  // strict: a false "no click" is a rendering artifact (widget looks
  // idle when the pointer was there), whereas a false "was clicked"
  // is a semantic bug (widget fires when the pointer wasn't). The
  // strict-zero-on-invalid posture is the safe direction.
  //
  // Bool return matches the "0/1" convention every other validator in
  // this file uses (immediate_context_u32_valid, rights_valid,
  // kind_ref_valid). Callers that need a "true" typed value cast at
  // the call site.

  pub let ui_context_is_hovered : (u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64) (widget_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B8-05 (#2326): 1 iff row valid AND widget_id nonzero AND matches body3[63:32]. Widget_id 0 always returns 0 (matches the 'no widget' sentinel). Two callee-save pushes (r12=row_id, r13=widget_id) keep rsp aligned across tail_valid. Labels prefixed immediate_context_hv_.",
      block: {
        push r12;
        push r13;

        mov r12, rdi;
        mov r13, rsi;

        // widget_id == 0 -> 0 (matches sentinel).
        cmp r13, 0;
        je  immediate_context_hv_no;

        mov r10, 8;
        cmp r12, r10;
        jae immediate_context_hv_no;

        mov rdi, r12;
        call immediate_context_tail_valid;
        cmp rax, 0;
        je  immediate_context_hv_no;

        // Load hover_widget_id from body3[63:32].
        lea r10, [rip + _ui_table];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 24];
        shr rax, 32;
        and rax, 0xFFFFFFFF;

        // Compare against widget_id (only low 32 bits matter).
        mov r11, r13;
        shl r11, 32;
        shr r11, 32;
        cmp rax, r11;
        jne immediate_context_hv_no;

        mov rax, 1;
        jmp immediate_context_hv_out;

      immediate_context_hv_no:
        xor rax, rax;

      immediate_context_hv_out:
        pop r13;
        pop r12;
        ret
      }
    }

  pub let ui_context_was_clicked : (u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64) (widget_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B8-05 (#2326): 1 iff row valid AND widget_id nonzero AND matches body4[31:0]. Widget_id 0 always returns 0. Two callee-save pushes (r12=row_id, r13=widget_id). Labels prefixed immediate_context_wc_.",
      block: {
        push r12;
        push r13;

        mov r12, rdi;
        mov r13, rsi;

        // widget_id == 0 -> 0.
        cmp r13, 0;
        je  immediate_context_wc_no;

        mov r10, 8;
        cmp r12, r10;
        jae immediate_context_wc_no;

        mov rdi, r12;
        call immediate_context_tail_valid;
        cmp rax, 0;
        je  immediate_context_wc_no;

        // Load click_widget_id from body4[31:0].
        lea r10, [rip + _ui_table];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 32];
        and rax, 0xFFFFFFFF;

        mov r11, r13;
        shl r11, 32;
        shr r11, 32;
        cmp rax, r11;
        jne immediate_context_wc_no;

        mov rax, 1;
        jmp immediate_context_wc_out;

      immediate_context_wc_no:
        xor rax, rax;

      immediate_context_wc_out:
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Section 14  Revoke.
  // ==========================================================================

  pub let ui_context_revoke : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B8-05 (#2326): revoke one row. row_id >= UI_MAX -> UI_BAD_SLOT; not in_use -> UI_REVOKE_ALREADY; else free + bump revokes + return 0. Labels prefixed immediate_context_rev_.",
      block: {
        push r12;
        mov r12, rdi;

        mov r10, 8;
        cmp r12, r10;
        jae immediate_context_rev_bad_slot;

        mov rdi, r12;
        call immediate_context_tail_valid;
        cmp rax, 0;
        je  immediate_context_rev_already;

        mov rdi, r12;
        call immediate_context_tail_free;
        mov rdi, 1;                       // UI_ST_REVOKES
        call immediate_context_note;
        xor rax, rax;
        jmp immediate_context_rev_out;

      immediate_context_rev_bad_slot:
        mov rax, 0xFFFFEB7A;              // UI_BAD_SLOT
        jmp immediate_context_rev_out;
      immediate_context_rev_already:
        mov rax, 0xFFFFEB78;              // UI_REVOKE_ALREADY

      immediate_context_rev_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Section 15  Boot init.
  // ==========================================================================

  pub let ui_context_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B8-05 (#2326): call through to immediate_context_stats_reset for one clean pool + counter zero-out. Labels prefixed immediate_context_i_.",
      block: {
        call immediate_context_stats_reset;
        ret
      }
    }
}
