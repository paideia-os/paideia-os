// src/user/libpaideia_ui/immediate_context.pdx -- Wave0-B8-05 (paideia-os #2326)
//
// KIND_UI_CONTEXT = 0x1D5, derived over KIND_WINDOW (0x1C1).
//
// Design authority: design/roadmap/next-wave-softarch.md §KIND_UI_CONTEXT
// (line 743) and the G12 toolkit row in design/roadmap/next-wave-
// synthesis.md (line 99). This is the ROOT cap the paideia-ui library
// exports to any client -- every widget cap (KIND_WIDGET, KIND_TEXT_
// INPUT, KIND_BUTTON, ...) that lands in G12.M2/M3/M4 will derive from
// this KIND_UI_CONTEXT.
//
// NOVEL-CLEAN POSTURE.  PaideiaOS toolkit design leans egui-shape:
// IMMEDIATE MODE. There is NO widget tree persisted between frames.
// Every frame the client re-issues the whole widget list; the toolkit
// keeps ONLY per-widget retained state (open/closed, scroll offset,
// selection, ...) in a hash table keyed by widget ID. No layout
// retention between frames -- cheap to reason about, cheap to skip.
// This is the deliberate departure from Xilem-shape / GTK-shape
// retained-mode toolkits where the widget tree persists and mutations
// diff into the render layer; those toolkits pay a "widget lifecycle"
// tax the immediate-mode shape does not owe.
//
// The retained-state hash table is a G12.M1-002/003 concern (this
// file declares only the pointer slot state_hash_table_ptr; the table
// allocation + hash + probe policy land in the sibling files).
//
// This module is user-space (client-linked into every UI-bearing
// process, plus svc-compositor's helper harness for its own settings
// panel). It is NOT wired into `cap_table` / `cap_invoke_dispatch`; the
// UI-context row pool lives in the library's own .bss so a client
// creates and drives its own context without a syscall round-trip per
// frame -- the frame boundary crosses into the compositor ONLY at
// end_frame via a KIND_SURFACE_COMMIT delegation (surface_commit.pdx).
// A future landing that promotes KIND_UI_CONTEXT authority into a
// separate svc-toolkit process would mirror window_kind.pdx's row
// pool + rights bitmask + factory shape unchanged, just relocated.
//
// PATTERN PARALLEL: src/user/compositor/window_kind.pdx (Wave0-B6-05,
// KIND_WINDOW at 0x1C1) is the closest kin -- same "user-space
// derived-cap with row pool + rights + mint factory" shape. This file
// omits the P4 a11y-tree gate (a11y binds at KIND_WINDOW; a context
// inherits transitively via its parent window) and adds frame-
// lifecycle assertion state (frame_in_progress byte + frame_number
// monotone counter + widget_id_counter reset-per-frame + hover/click
// per-frame routing slots).
//
// =============================================================================
// SECTION 0  KIND_* SLOT ALLOCATION
// =============================================================================
//
// 0x1D5 in the derived-kinds band. Landing-time grep across src/ and
// design/ shows only 0x1D0 (RESERVATION_HOLDER_KIND) and 0x1D1 (RP_
// COMPOSITOR_KIND_FORWARD) claimed in the 0x1D0..0x1DF page; 0x1D2..
// 0x1DF are free. Wave-0 Batch-8 dispatch reserves 0x1D5 for this
// KIND_UI_CONTEXT root, leaving 0x1D2..0x1D4 for near-batch B8-01..04
// prereqs and 0x1D6..0x1DF for the G12.M2/M3 widget-cap children that
// derive from KIND_UI_CONTEXT.
//
// =============================================================================
// SECTION 1  DERIVATION OVER KIND_WINDOW
// =============================================================================
//
// The kind half of the mint gate demands `kind == KIND_WINDOW (0x1C1)`
// carrying R_WIN_MINT (see window_kind.pdx §Section 10). A context
// binds transitively to that window's surface: the mint factory
// records BOTH the window_kind_id and the surface_kind_id so a
// downstream frame-flush can skip a re-derivation of surface-from-
// window at every commit. The client is responsible for passing the
// right surface (svc-compositor exposes it as a paired mint result at
// window creation); mint refuses with UI_MINT_BAD_WINDOW / UI_MINT_
// BAD_SURFACE when either is zero.
//
// KIND_WIDGET, KIND_TEXT_INPUT, KIND_BUTTON, KIND_SCROLL_AREA and
// the rest of the G12.M2/M3 widget-cap family will all derive from
// KIND_UI_CONTEXT in turn -- R_UI_MINT below is the gate.
//
// =============================================================================
// SECTION 2  ROW LAYOUT -- 64 BYTES (EIGHT u64 WORDS, POWER-OF-2)
// =============================================================================
//
//   [+0]  header:  in_use[63:56] | reserved[55:8] | frame_in_progress[7:0]
//   [+8]  body1:   window_kind_id[31:0] | surface_kind_id[63:32]
//   [+16] body2:   frame_number: u64                 -- monotone; bumps at begin
//   [+24] body3:   widget_id_counter[31:0] | hover_widget_id[63:32]
//   [+32] body4:   click_widget_id[31:0]   | reserved[63:32]
//   [+40] body5:   state_hash_table_ptr: u64         -- 0 until table_bind lands
//   [+48] reserved
//   [+56] reserved
//
// Row size 64 chosen (over the 32-byte window_kind precedent) for two
// reasons: (a) 64 is a cache-line, so a hot per-frame context sits in
// exactly one line; (b) 64 = 2^6, so row addressing uses `shl r11, 6`
// -- encoder-conservative (no 2-op imul-with-imm, no `imul r,r,64`
// dependence). The two trailing reserved words absorb the G12.M2/M3
// follow-ups (state hash cursor, per-frame pointer coords, drag
// origin, ...) without a row-shape migration.
//
// frame_in_progress lives in header[7:0] rather than a separate word
// so the alloc / free scrub touches one word to set/clear both the
// in_use marker and the frame flag consistently.
//
// widget_id_counter is u32 with wraparound sentinel: 0 is reserved
// as "no widget" (matches hover_widget_id == 0 / click_widget_id == 0
// meaning "no hover / no click this frame"). ui_context_allocate_id
// returns 1, 2, 3, ..., 0xFFFFFFFF; the widget_id_counter == 0
// wraparound refuses with UI_FRAME_OVERFLOW rather than aliasing
// widget 0 with a real widget.
//
// hover_widget_id / click_widget_id are set by pointer routing
// (KIND_INPUT_ROUTE, a G12.M1-003 concern -- #2328) between end_frame
// of frame N-1 and begin_frame of frame N; ui_context_is_hovered and
// ui_context_was_clicked read those slots.
//
// state_hash_table_ptr is a u64 raw pointer to the retained-state
// hash table (widget_id -> state blob) that G12.M1-002/003 lands.
// This file leaves it as 0 at mint; a subsequent ui_context_bind_
// state_table landing populates it via a compare-and-set once the
// table constructor exists. Reading it back through the row helper
// tolerates zero (returns 0 -- caller decides "no table yet").
//
// All slots stored little-endian, matching every other row-tail
// layout in this repo (window_kind.pdx, reference_display_kind.pdx,
// kind_color_profile.pdx). No float leaks into a UI-context cap per
// the FPU-discipline (design/kernel/no-fpu.md).
//
// =============================================================================
// SECTION 3  FAILURE TAXONOMY 0xFFFFEB70..0xFFFFEB7F
// =============================================================================
//
// Repo-wide grep at landing time shows the 0xFFFFEB70..0xFFFFEB7F
// page entirely unclaimed across src/ and design/. Nearest neighbours:
// 0xFFFFEB6F (kind_framebuffer sibling), 0xFFFFEB80 (unclaimed).
// 16 slots give headroom past the immediate 8 refusal cases; the
// unused low half (0xFFFFEB70..0xFFFFEB73) is reserved for G12.M1-002/
// 003 follow-ups (UI_STATE_BIND_ALREADY, UI_STATE_TABLE_NULL, ...).
//
// NB: the task-brief-suggested band 0xFFFFEB40..0xFFFFEB4F is CLAIMED
// in full by src/kernel/core/cap/kind_framebuffer.pdx §Section 3 (grep
// hits at all 16 slots there). This file uses the next fresh 16-slot
// page, 0xFFFFEB70..0xFFFFEB7F, and this comment records that choice
// so a future grep for the brief-suggested constant lands here.
//
// =============================================================================
// SECTION 4  FRAME-LIFECYCLE INVARIANTS
// =============================================================================
//
// The whole point of this cap is to make the immediate-mode frame
// loop's state machine EXPLICIT and enforce it at every call site:
//
//   1. ui_context_begin_frame ASSERTS frame_in_progress == 0. If it
//      is 1 (client forgot to end the previous frame), refuse with
//      UI_FRAME_BAD_STATE. On success: bump frame_number, reset
//      widget_id_counter to 1 (reserving 0 as the "no widget"
//      sentinel), set frame_in_progress = 1.
//
//   2. Between begin_frame and end_frame, the client calls
//      ui_context_allocate_id + ui_context_is_hovered / was_clicked
//      to drive widget rendering. ADD_WIDGET / QUERY_HOVER / QUERY_
//      CLICK rights all gate through the enclosing frame -- an
//      allocate outside a frame is a client bug the future dispatcher
//      catches (this file's allocate_id itself is tolerant so the
//      library helper can pre-populate a sentinel outside the loop).
//
//   3. ui_context_end_frame ASSERTS frame_in_progress == 1. If it is
//      0 (double-end or end-without-begin), refuse with UI_FRAME_BAD_
//      STATE. On success: (a) DELEGATE to surface_commit.pdx via a
//      future stub call (this landing leaves the delegation as an
//      inline comment and a return-value passthrough -- the actual
//      surface_commit_flush_stub wiring lands with G12.M1-004
//      because the flush protocol requires KIND_SURFACE_COMMIT
//      linearity discipline that is not yet in place); (b) clear
//      frame_in_progress = 0.
//
// This state machine is the "cheap to reason about" property egui
// gets from immediate mode: there are exactly two states per context
// (frame open / frame closed), and every operation names which state
// it demands. A retained-mode toolkit would need N states per widget
// lifecycle (created / mounted / dirty / measured / laid-out /
// rendered / unmounted) and pay a scheduler tax to advance them; the
// immediate-mode shape has zero widgets to schedule between frames.

module ImmediateContext = structure {

  pub let KIND_UI_CONTEXT       : u64 = 0x1D5
  pub let UI_CTX_PARENT_KIND    : u64 = 0x1C1        // KIND_WINDOW (Wave0-B6-05)

  // Row pool. UI_MAX = 8 covers a heavily-partitioned client (main
  // window + settings dialog + a few tool palettes) without over-
  // committing .bss; a client that wants many contexts (e.g. an IDE
  // with 20 tool windows) bumps this constant and re-derives _ui_table
  // size. 8 * 64 = 512 bytes = one 4KB page's 1/8th.
  pub let UI_MAX       : u64 = 8
  pub let UI_ROW_BYTES : u64 = 64
  pub let UI_ROW_SHIFT : u64 = 6                     // 1 << 6 == 64

  // Rights. Eight-bit bitmask covering the six egui-shape operations
  // (BEGIN_FRAME, END_FRAME, ADD_WIDGET, QUERY_HOVER, QUERY_CLICK,
  // ALLOCATE_ID) plus OBSERVE (for a compositor debug overlay that
  // inspects context state without driving it) plus MINT (for the
  // G12.M2/M3 widget-cap children that derive from KIND_UI_CONTEXT).
  // Layout mirrors window_kind.pdx's convention: standard bits at low
  // ordinals, context-specific bits packed contiguously.
  pub let R_UI_BEGIN_FRAME     : u64 = 0x001
  pub let R_UI_END_FRAME       : u64 = 0x002
  pub let R_UI_ADD_WIDGET      : u64 = 0x004
  pub let R_UI_QUERY_HOVER     : u64 = 0x008
  pub let R_UI_QUERY_CLICK     : u64 = 0x010
  pub let R_UI_ALLOCATE_ID     : u64 = 0x020
  pub let R_UI_OBSERVE         : u64 = 0x040
  pub let R_UI_MINT            : u64 = 0x080
  pub let R_UI_ALL             : u64 = 0x0FF
     // 0x001|0x002|0x004|0x008|0x010|0x020|0x040|0x080 == 0x0FF

  // Op numbering. Arity ONE (op_arg[63:8] REFUSED, mirroring the
  // window / surface conventions).
  pub let UI_OP_BEGIN_FRAME    : u64 = 0
  pub let UI_OP_END_FRAME      : u64 = 1
  pub let UI_OP_ALLOCATE_ID    : u64 = 2
  pub let UI_OP_QUERY_HOVER    : u64 = 3
  pub let UI_OP_QUERY_CLICK    : u64 = 4
  pub let UI_OP_QUERY_FRAME_NO : u64 = 5
  pub let UI_OP_QUERY_WINDOW   : u64 = 6
  pub let UI_OP_QUERY_SURFACE  : u64 = 7
  pub let UI_OP_DEBUG_PRINT    : u64 = 8
  pub let UI_OP_MAX            : u64 = 8

  // Failure taxonomy 0xFFFFEB70..0xFFFFEB7F. Fresh page, grep-
  // verified free across src/ + design/ at landing.
  pub let UI_OK                  : u64 = 0
  pub let UI_TAIL_ENOSPC         : u64 = 0xFFFFEB7F
  pub let UI_TAIL_BAD_ARG        : u64 = 0xFFFFEB7E
  pub let UI_MINT_BAD_WINDOW     : u64 = 0xFFFFEB7D
  pub let UI_MINT_BAD_SURFACE    : u64 = 0xFFFFEB7C
  pub let UI_MINT_BAD_RIGHTS     : u64 = 0xFFFFEB7B
  pub let UI_BAD_SLOT            : u64 = 0xFFFFEB7A
  pub let UI_WRONG_KIND          : u64 = 0xFFFFEB79
  pub let UI_REVOKE_ALREADY      : u64 = 0xFFFFEB78
  pub let UI_FRAME_BAD_STATE     : u64 = 0xFFFFEB77
  pub let UI_FRAME_OVERFLOW      : u64 = 0xFFFFEB76
  pub let UI_UNSUP_OP            : u64 = 0xFFFFEB75
  pub let UI_DECODE_BAD          : u64 = 0xFFFFEB74
  pub let UI_ROW_NONE            : u64 = 0xFFFFEB73
  // 0xFFFFEB70..0xFFFFEB72 reserved for G12.M1-002/003 follow-ups.

  pub let UI_U32_MAX : u64 = 0xFFFFFFFF

  // THE ONE STATE CELL. 8 rows * 64 bytes = 512 bytes = 64 u64.
  pub let mut _ui_table : [u64; 64] = uninit @align(64)
  pub let mut _ui_stats : [u64; 4]  = uninit @align(64)

  pub let UI_ST_MINTS   : u64 = 0
  pub let UI_ST_REVOKES : u64 = 1
  pub let UI_ST_REFUSED : u64 = 2
  pub let UI_ST_FRAMES  : u64 = 3

  // Fingerprint tag. Emitted by the library on successful mint of a
  // KIND_UI_CONTEXT cap. Legacy suffix gives grep parity with pre-
  // Wave0 boot-log tooling (see e.g. window_kind.pdx pdx_kind_window
  // _meta, surface_kind.pdx pdx_kind_surface_meta). Until the actual
  // klog emission wire lands (G12.M1-004), this string is a data-only
  // constant and needs an allowlist entry in tools/verify-fingerprint
  // -coverage.sh with reason "G12.M1-001 (#2326) kind_ui_context mint
  // body not yet landed". The main coordinator adds that allowlist
  // entry at Batch 8 close-out.
  //
  // Length: "ui context mint ok [legacy: UI CONTEXT MINT OK]\0" =
  // 48 bytes.
  pub let pdx_kind_ui_context_meta : [u8; 48] = "ui context mint ok [legacy: UI CONTEXT MINT OK]\0"

  // ==========================================================================
  // Section 5  Counter primitives.
  // ==========================================================================

  pub let immediate_context_stats_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B8-05 (#2326): clear row table + counters at boot. 8 rows * 8 u64 = 64 u64 total. Labels prefixed immediate_context_rs_.",
      block: {
        lea r10, [rip + _ui_table];
        xor rax, rax;
        xor rcx, rcx;
      immediate_context_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 64;
        jb  immediate_context_rs_rows;

        lea r10, [rip + _ui_stats];
        xor rcx, rcx;
      immediate_context_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  immediate_context_rs_stats;
        ret
      }
    }

  pub let immediate_context_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B8-05 (#2326): counter bump. Encoder-conservative load-inc-store; no `add reg,[mem]`. Labels prefixed immediate_context_nt_.",
      block: {
        cmp rdi, 4;
        jae immediate_context_nt_out;
        lea r10, [rip + _ui_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      immediate_context_nt_out:
        ret
      }
    }

  pub let immediate_context_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B8-05 (#2326): counter read. Labels prefixed immediate_context_st_.",
      block: {
        cmp rdi, 4;
        jae immediate_context_st_zero;
        lea r10, [rip + _ui_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      immediate_context_st_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Section 6  Validators.
  // ==========================================================================

  pub let immediate_context_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B8-05 (#2326): subset test against R_UI_ALL = 0x0FF. Labels prefixed immediate_context_rv_.",
      block: {
        mov rax, rdi;
        mov r10, 0xFF;
        and rax, r10;
        cmp rax, rdi;
        jne immediate_context_rv_no;
        mov rax, 1;
        ret;
      immediate_context_rv_no:
        xor rax, rax;
        ret
      }
    }

  // immediate_context_u32_valid: 1 iff v fits in 32 bits.
  pub let immediate_context_u32_valid : (u64) -> u64 !{} @{} =
    fn (v: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B8-05 (#2326): 1 iff v <= UI_U32_MAX. Encoder-conservative: load 0xFFFFFFFF into r10 rather than emit an imm64 form. Labels prefixed immediate_context_uv_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  immediate_context_uv_no;
        mov rax, 1;
        ret;
      immediate_context_uv_no:
        xor rax, rax;
        ret
      }
    }

  // immediate_context_kind_ref_valid: 1 iff kind_id is nonzero AND
  // fits in u32. Used at mint for both window_kind_id and surface_
  // kind_id (both refuse zero: a zero KIND ref names no live cap).
  pub let immediate_context_kind_ref_valid : (u64) -> u64 !{} @{} =
    fn (kind_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B8-05 (#2326): 1 iff kind_id in (0, 2^32). Both the mint's window ref and surface ref must be nonzero live u32 slots. Labels prefixed immediate_context_kv_.",
      block: {
        cmp rdi, 0;
        je  immediate_context_kv_no;
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  immediate_context_kv_no;
        mov rax, 1;
        ret;
      immediate_context_kv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Section 7  Row pool: valid / alloc / free.
  // ==========================================================================

  pub let immediate_context_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B8-05 (#2326): 1 iff row_id < UI_MAX and header in_use bit set. Row-index math via `shl r11, 6` (UI_ROW_SHIFT) -- power-of-2 row size sidesteps the 2-op imul-with-imm hazard. Labels prefixed immediate_context_tv_.",
      block: {
        cmp rdi, 8;
        jae immediate_context_tv_no;
        lea r10, [rip + _ui_table];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  immediate_context_tv_no;
        mov rax, 1;
        ret;
      immediate_context_tv_no:
        xor rax, rax;
        ret
      }
    }

  // immediate_context_tail_alloc(body1, state_ptr) -> row_id | err.
  // Low-first scan over 8 rows. Header stamped with in_use bit (bit 56)
  // here; frame_in_progress starts at 0, frame_number starts at 0,
  // widget_id_counter starts at 0 (begin_frame resets it to 1 on first
  // frame). hover_widget_id and click_widget_id start at 0 (no widget
  // hovered / clicked yet).
  pub let immediate_context_tail_alloc : (u64, u64) -> u64 !{mem} @{} =
    fn (body1: u64) (state_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B8-05 (#2326): claim one KIND_UI_CONTEXT row. Low-first scan (rbx=idx) over 8 rows of 64 bytes (idx*64 via `shl r11, 6`). On claim: header = (1 << 56) with frame_in_progress byte zero; body1 stored as-is; body2/body3/body4 zeroed; body5 = state_ptr (typically 0 at mint, populated later by bind_state_table). Three callee-save pushes (rbx=idx, r12=body1, r13=state_ptr) leave rsp%16 == 8 -> +24 = rsp%16 == 0 for the no-nested-call scan. Encoder-conservative: `shl r11, 6` not `imul r11, r11, 64`. Labels prefixed immediate_context_ta_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rdi;                     // body1
        mov r13, rsi;                     // state_ptr

        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp r12, r10;
        je  immediate_context_ta_bad;

        xor rbx, rbx;
      immediate_context_ta_scan:
        cmp rbx, 8;
        jae immediate_context_ta_enospc;
        lea r10, [rip + _ui_table];
        mov r11, rbx;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  immediate_context_ta_claim;
        add rbx, 1;
        jmp immediate_context_ta_scan;

      immediate_context_ta_claim:
        // header = 1 << 56 (in_use set; frame_in_progress byte zero).
        mov r11, 1;
        shl r11, 56;
        mov [r10 + 0],  r11;
        mov [r10 + 8],  r12;              // body1 (window+surface pack)
        xor rax, rax;
        mov [r10 + 16], rax;              // frame_number = 0
        mov [r10 + 24], rax;              // widget_id_counter=0 | hover=0
        mov [r10 + 32], rax;              // click=0 | reserved
        mov [r10 + 40], r13;              // state_hash_table_ptr
        mov [r10 + 48], rax;              // reserved
        mov [r10 + 56], rax;              // reserved
        mov rax, rbx;
        jmp immediate_context_ta_out;

      immediate_context_ta_enospc:
        mov rax, 0xFFFFEB7F;              // UI_TAIL_ENOSPC
        jmp immediate_context_ta_out;
      immediate_context_ta_bad:
        mov rax, 0xFFFFEB7E;              // UI_TAIL_BAD_ARG

      immediate_context_ta_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let immediate_context_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B8-05 (#2326): scrub one row (all eight words). Encoder-conservative: `shl r11, 6` addressing. Labels prefixed immediate_context_tf_.",
      block: {
        cmp rdi, 8;
        jae immediate_context_tf_out;
        lea r10, [rip + _ui_table];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        mov [r10 + 32], rax;
        mov [r10 + 40], rax;
        mov [r10 + 48], rax;
        mov [r10 + 56], rax;
      immediate_context_tf_out:
        ret
      }
    }

  // ==========================================================================
  // Section 8  Body packer (window + surface into one word).
  // ==========================================================================

  // body1: window_kind_id[31:0] | surface_kind_id[63:32]
  pub let immediate_context_body1_pack : (u64, u64) -> u64 !{} @{} =
    fn (window: u64) (surface: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B8-05 (#2326): body1 pack. Both halves capped at u32 max. Encoder-conservative: mask via `and rax, 0xFFFFFFFF` (32-bit-sign-extended imm form) and shl 32. Labels prefixed immediate_context_b1_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  immediate_context_b1_bad;
        cmp rsi, r10;
        ja  immediate_context_b1_bad;
        mov rax, rdi;
        and rax, 0xFFFFFFFF;
        mov r10, rsi;
        and r10, 0xFFFFFFFF;
        shl r10, 32;
        or  rax, r10;
        ret;
      immediate_context_b1_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

