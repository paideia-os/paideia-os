// src/user/libpaideia_ui/retained_widgets.pdx -- Wave0-B11-09 (paideia-os #2330)
//
// G12.M2-002: RETAINED-MODE WIDGET CATALOGUE (factory shims over view_tree).
//
// Design authority: design/roadmap/next-wave-softarch.md §G12 (line
// 736 -- Developer APIs + first-party toolkit) and next-wave-synthesis
// .md line 99. This file lands the CLIENT-FACING FACTORY layer of the
// retained-mode paradigm that view_tree.pdx (Wave0-B10-10, paideia-os
// #2329) built the substrate for. Every factory here is a THIN SHIM
// over view_tree_append_node: it composes a prop_hash from the visible
// props the client passed, maps the widget kind to the matching
// VNK_* enum from view_tree, and forwards through. No new pool, no
// new counters-of-record -- the retained-tree node accounting stays
// authoritative in view_tree, and this file merely adds a small
// per-factory hit counter for observability parity with widgets.pdx's
// _widgets_stats.
//
// -----------------------------------------------------------------------------
// WHY FACTORIES BELONG IN THEIR OWN FILE
// -----------------------------------------------------------------------------
//
// view_tree.pdx is the substrate authority: pool, diff, reconcile, and
// the raw append primitive. A client that hand-composes prop_hash and
// remembers "button is VNK_BUTTON = 1" per call is one refactor away
// from a hash-collision or a kind-mismatch bug. The factory layer
// lifts that discipline into named entry points so the client's view
// function reads as a straight-line description ("button, list, list-
// items, textfield") rather than a bespoke append-node loop.
//
// The factory shape follows egui/Xilem tradition: one function per
// widget class, taking the visible props as positional u64 args,
// returning the fresh node_id (or a view_tree_* sentinel on refusal --
// factories propagate substrate errors verbatim rather than remap).
// The client's view function then chains them:
//
//     let win  = view_tree_append_node(t, 0, VNK_CONTAINER, 0, 0);
//     let ok   = retained_button_new(t, win, LBL_OK);
//     let list = retained_list_new(t, win, item_count);
//     retained_list_add_item(t, list, LBL_FILE_1);
//     retained_list_add_item(t, list, LBL_FILE_2);
//     let tf   = retained_textfield_new(t, win, TEXT_INIT, 64);
//     ... later, on state change ...
//     retained_textfield_set_text(t, tf, TEXT_UPDATED);
//
// The set_text mutator is the shape's escape hatch: the diff pass
// (view_tree_diff, view_tree.pdx §Section 7) fires on prop_hash
// mismatch, so a mutator that ONLY updates the on-tree node's
// prop_hash is enough to make the next reconcile emit the changed
// widget without a whole-tree rebuild. This is the retained-mode
// counterpart of egui's "just re-emit every frame" -- retained mode
// mutates existing nodes; immediate mode re-emits from scratch. The
// two paradigms meet at the widget-call boundary (view_tree_reconcile)
// exactly as documented in view_tree.pdx §Section 1.
//
// -----------------------------------------------------------------------------
// PROP_HASH COMPOSITION
// -----------------------------------------------------------------------------
//
// The prop_hash is the diff-pass change-detection key (view_tree.pdx
// §Section 2 word3). It MUST be a pure function of the visible props
// the factory received; two calls with identical args produce the same
// hash and the diff correctly reports "unchanged". The composition
// per widget kind:
//
//   button    : prop_hash = label_offset
//   label     : prop_hash = text_offset
//   list      : prop_hash = item_count               (parent list node)
//   list-item : prop_hash = label_offset             (each VNK_LABEL child)
//   tree      : prop_hash = root_label_offset        (parent tree node)
//   tree-child: prop_hash = label_offset             (each VNK_LABEL child)
//   textfield : prop_hash = (max_len << 32) | (text_offset & 0xFFFFFFFF)
//
// The textfield choice is deliberate: max_len and text_offset are BOTH
// visible props (max_len bounds the input, text_offset names the
// initial buffer). Packing both into one u64 keeps the retained_
// textfield_set_text mutator's job simple: preserve upper 32 (max_len
// unchanged across a text update), overwrite lower 32 with the new
// text_offset. The client cannot mutate max_len without rebuilding
// the whole node -- a max_len change is a schema change, not a
// content change, and the diff-and-patch discipline treats it that
// way.
//
// -----------------------------------------------------------------------------
// LIST + TREE MODEL
// -----------------------------------------------------------------------------
//
// retained_list_new / retained_tree_new create the PARENT container
// node (VNK_LIST / VNK_TREE) only. Individual items / children are
// added via retained_list_add_item / retained_tree_add_child, each of
// which appends a VNK_LABEL child under the parent. This is the
// simplest correct shape for the substrate: the VNK enum has no
// distinct "list item" or "tree node" kind (see view_tree.pdx
// §Section 0 constants), so items ARE labels parented under the
// list/tree container. A future widget-layer landing (G12.M2-003
// retained_state.pdx, paideia-os #2331) that promotes list-item or
// tree-child to a richer kind can add VNK_LIST_ITEM / VNK_TREE_CHILD
// without breaking the factory API -- the shim would flip its VNK_
// argument to view_tree_append_node.
//
// item_count in retained_list_new is a HINT stored as prop_hash on
// the parent list node. The substrate does not preallocate N children;
// the client calls add_item N times to actually populate. The hint
// serves the diff pass: a change to item_count between frames marks
// the parent list node dirty, so a reconcile pass that recomputes
// list layout metrics (scrollbar extent, per-row Y) has a signal to
// fire on even when individual child labels are unchanged.
//
// -----------------------------------------------------------------------------
// FAILURE TAXONOMY 0xFFFFEAC0..0xFFFFEACF
// -----------------------------------------------------------------------------
//
// NB: the task-brief-suggested band 0xFFFFEDE0..0xFFFFEDEF is CLAIMED
// in full by src/kernel/core/ipc/vk_present_feedback_channel.pdx,
// src/kernel/core/ipc/font_load_channel.pdx, and
// src/kernel/core/ipc/vello_render_channel.pdx (per repo-wide grep at
// landing). Choosing a fresh page (0xFFFFEAC0..0xFFFFEACF) grep-
// verified free across src/ + design/ at landing. The choice sits
// IMMEDIATELY ABOVE view_tree.pdx's own 0xFFFFEAB0..0xFFFFEABF page,
// which is deliberate: the substrate + factory pair reserves a
// contiguous 32-slot region (0xFFFFEAB0..0xFFFFEACF) for the G12.M2
// retained-mode wave, so a future grep for either end lands in the
// obvious neighbour. view_tree.pdx §Section 4 header pre-reserved
// 0xFFFFEAC0..EAFF for G12.M2-002/003 follow-ups; this file takes
// the low 16 slots of that reservation, leaving 0xFFFFEAD0..0xFFFFEAEF
// for G12.M2-003 (retained_state.pdx, paideia-os #2331).
//
// The retained factory refusals are strictly a superset of the
// view_tree substrate refusals: any error the substrate returns
// (VT_BAD_SLOT, VT_BAD_KIND, VT_BAD_PARENT, VT_NODE_ENOSPC) is
// propagated VERBATIM by the factory (which does not remap). The
// factory adds its own refusal only for the ONE gate the substrate
// cannot express: retained_textfield_set_text needs a "node exists,
// but is not a textfield" refusal, which lands here as RW_BAD_KIND.
//
//   RW_OK        (0x00000000) -- success sentinel for set_text.
//   RW_BAD_SLOT  (0xFFFFEACF) -- tree_id invalid at set_text entry.
//   RW_BAD_NODE  (0xFFFFEACE) -- node_id not in use at set_text entry.
//   RW_BAD_TREE  (0xFFFFEACD) -- node_id belongs to a foreign tree.
//   RW_BAD_KIND  (0xFFFFEACC) -- node_id names a non-VNK_TEXTFIELD.
//   RW_UNSUP_OP  (0xFFFFEACB) -- reserved for future mutators.
//   0xFFFFEAC0..0xFFFFEACA reserved for follow-ups.
//
// Factory success paths that call view_tree_append_node PROPAGATE its
// return value directly: on success rax is a pool index < VT_NODE_MAX
// (== 128); on failure rax is a VT_* sentinel in the 0xFFFFEA00 page.
// The factory uses `cmp rax, 128; jae fail;` as its own success/fail
// discriminator; no ambiguity because pool indices are strictly < 128
// and sentinels are strictly >= 0xFFFFEA00.
//
// -----------------------------------------------------------------------------
// ENCODER RULES + LABEL PREFIX
// -----------------------------------------------------------------------------
//
// paideia-as M0305 module = RetainedWidgets (PascalCase of file
// basename retained_widgets.pdx). Labels prefixed `retained_widgets_`.
// Encoder-conservative throughout: no `imul r,r,imm`, no imm64 forms
// via anonymous mov, no `add reg,[mem]`. All wide-immediate constants
// (0xFFFFFFFF, 0xFFFFEA00, ...) staged into r10/r11 before use.
// Callee-save discipline: rbx/r12..r15 each pushed exactly once per
// function that uses them, keeping rsp%16 aligned before every nested
// call.
//
// FRAME-LIFECYCLE NOTE. Factory calls are NOT gated on a matching
// ui_context begin/end_frame pair -- retained-mode rebuild happens
// OUTSIDE the immediate-mode frame lifecycle (per view_tree.pdx
// §Section 1 relation-to-siblings body). A client that mixes both
// paradigms calls view_tree_reset -> retained_*_new... -> view_tree_
// diff -> view_tree_reconcile OUTSIDE the immediate-mode frame, and
// the reconcile pass is what enters the frame at its own choice of
// cadence.

module RetainedWidgets = structure {

  // ==========================================================================
  // Section 0  Constants: local VNK mirror + failure taxonomy + counters.
  // ==========================================================================
  //
  // The VNK_* enum authority lives in view_tree.pdx §Section 0. This
  // file MIRRORS the four values it needs (BUTTON=1, LABEL=2, LIST=3,
  // TEXTFIELD=4, TREE=7) as local named constants so the factory
  // bodies read as `mov rdx, RW_KIND_BUTTON;` rather than `mov rdx, 1;`.
  // A schema change to view_tree.pdx that renumbers VNK_* will surface
  // here as a mismatch the retained_textfield_set_text kind-check
  // catches at runtime (VT_BAD_KIND propagated). A tighter compile-
  // time link is a future-refactor concern -- paideia-as module-cross
  // imports are landing under a separate satellite.
  pub let RW_KIND_BUTTON     : u64 = 1     // mirror of VNK_BUTTON
  pub let RW_KIND_LABEL      : u64 = 2     // mirror of VNK_LABEL
  pub let RW_KIND_LIST       : u64 = 3     // mirror of VNK_LIST
  pub let RW_KIND_TEXTFIELD  : u64 = 4     // mirror of VNK_TEXTFIELD
  pub let RW_KIND_TREE       : u64 = 7     // mirror of VNK_TREE

  pub let RW_NODE_MAX        : u64 = 128   // mirror of VT_NODE_MAX; success/fail cutoff

  // Failure taxonomy 0xFFFFEAC0..0xFFFFEACF. Fresh page, grep-verified
  // free at landing. Only retained_textfield_set_text produces these
  // (every other factory forwards view_tree_* sentinels verbatim).
  pub let RW_OK              : u64 = 0
  pub let RW_BAD_SLOT        : u64 = 0xFFFFEACF
  pub let RW_BAD_NODE        : u64 = 0xFFFFEACE
  pub let RW_BAD_TREE        : u64 = 0xFFFFEACD
  pub let RW_BAD_KIND        : u64 = 0xFFFFEACC
  pub let RW_UNSUP_OP        : u64 = 0xFFFFEACB
  // 0xFFFFEAC0..0xFFFFEACA reserved for G12.M2-002 follow-ups.

  // Small stats vector for smoke-witness observability. Mirrors
  // widgets.pdx's _widgets_stats shape. Twelve u64 slots (nine used +
  // three headroom).
  pub let mut _retained_widgets_stats : [u64; 12] = uninit @align(64)

  pub let RW_ST_BUTTONS          : u64 = 0
  pub let RW_ST_LABELS           : u64 = 1
  pub let RW_ST_LISTS            : u64 = 2
  pub let RW_ST_LIST_ITEMS       : u64 = 3
  pub let RW_ST_TREES            : u64 = 4
  pub let RW_ST_TREE_CHILDREN    : u64 = 5
  pub let RW_ST_TEXTFIELDS       : u64 = 6
  pub let RW_ST_TEXTFIELD_UPDATES: u64 = 7
  pub let RW_ST_REFUSED          : u64 = 8
  // slots 9..11 reserved.

  // Fingerprint tag. Emitted by the library on successful mint of the
  // first factory-created retained widget (data-only until the klog
  // emission wire lands with G12.M2-003 retained_state.pdx). Legacy
  // suffix gives grep parity with pre-Wave0 boot-log tooling.
  //
  // Length: "retained widgets new ok [legacy: RETAINED WIDGETS NEW OK]\0"
  // strlen = 57, size = 58 bytes (strlen + 1).
  //
  // Needs an allowlist entry in tools/verify-fingerprint-coverage.sh
  // with reason "Wave0-B11 G12.M2-002 (#2330) retained_widgets factory
  // catalogue not yet wired into a boot witness". The main coordinator
  // adds that allowlist entry at Batch 11 close-out (matches the
  // Wave0-B10 view_tree_new pattern).
  pub let pdx_kind_retained_widgets_meta : [u8; 58] = "retained widgets new ok [legacy: RETAINED WIDGETS NEW OK]\0"

  // ==========================================================================
  // Section 1  Counter primitives.
  // ==========================================================================

  pub let retained_widgets_stats_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-09 (#2330): clear _retained_widgets_stats vector at boot. 12 u64 slots. Labels prefixed retained_widgets_sr_.",
      block: {
        lea r10, [rip + _retained_widgets_stats];
        xor rax, rax;
        xor rcx, rcx;
      retained_widgets_sr_top:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 12;
        jb  retained_widgets_sr_top;
        ret
      }
    }

  pub let retained_widgets_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-09 (#2330): counter bump. Encoder-conservative load-inc-store; no `add reg,[mem]`. Labels prefixed retained_widgets_nt_.",
      block: {
        cmp rdi, 12;
        jae retained_widgets_nt_out;
        lea r10, [rip + _retained_widgets_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      retained_widgets_nt_out:
        ret
      }
    }

  pub let retained_widgets_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-09 (#2330): counter read. Labels prefixed retained_widgets_st_.",
      block: {
        cmp rdi, 12;
        jae retained_widgets_stat_zero;
        lea r10, [rip + _retained_widgets_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      retained_widgets_stat_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Section 2  retained_button_new
  // ==========================================================================
  //
  // retained_button_new(tree_id, parent, label_offset) -> node_id | err
  //
  // Thin shim: calls view_tree_append_node(tree_id, parent, VNK_BUTTON,
  // prop_hash=label_offset, state_ptr=0). Success bumps RW_ST_BUTTONS;
  // any substrate refusal (rax >= 128) bumps RW_ST_REFUSED. rax is
  // propagated verbatim so the caller sees the exact view_tree_*
  // sentinel on failure.

  pub let retained_button_new : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (tree_id: u64) (parent: u64) (label_offset: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-09 (#2330): button factory. Two callee-save pushes (rbx=node_id, then sub rsp,8 for align since two nested calls -- view_tree_append_node + retained_widgets_note -- follow). Arg shuffle: rdx (label_offset) -> rcx (prop_hash); rdx = VNK_BUTTON=1; r8 = 0. Labels prefixed retained_widgets_bn_.",
      block: {
        push rbx;                             // rsp %16 == 0

        // Shuffle args into view_tree_append_node's shape.
        // rdi=tree_id already in place; rsi=parent already in place.
        mov rcx, rdx;                         // rcx = prop_hash = label_offset
        mov rdx, 1;                           // rdx = VNK_BUTTON
        xor r8, r8;                           // r8  = state_ptr = 0
        call view_tree_append_node;

        // rax is either node_id (< 128) or VT_* sentinel (>= 0xFFFFEA00).
        mov rbx, rax;                         // stash return value
        mov r10, 128;
        cmp rax, r10;
        jae retained_widgets_bn_fail;

        mov rdi, 0;                           // RW_ST_BUTTONS
        call retained_widgets_note;
        mov rax, rbx;
        jmp retained_widgets_bn_out;

      retained_widgets_bn_fail:
        mov rdi, 8;                           // RW_ST_REFUSED
        call retained_widgets_note;
        mov rax, rbx;

      retained_widgets_bn_out:
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Section 3  retained_label_new
  // ==========================================================================
  //
  // retained_label_new(tree_id, parent, text_offset) -> node_id | err
  //
  // Same shim shape as retained_button_new; kind=VNK_LABEL, prop_hash
  // = text_offset.

  pub let retained_label_new : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (tree_id: u64) (parent: u64) (text_offset: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-09 (#2330): label factory. Same shim shape as retained_button_new; kind=VNK_LABEL=2, prop_hash=text_offset. Labels prefixed retained_widgets_ln_.",
      block: {
        push rbx;                             // rsp %16 == 0

        mov rcx, rdx;                         // rcx = prop_hash = text_offset
        mov rdx, 2;                           // rdx = VNK_LABEL
        xor r8, r8;                           // r8  = state_ptr = 0
        call view_tree_append_node;

        mov rbx, rax;
        mov r10, 128;
        cmp rax, r10;
        jae retained_widgets_ln_fail;

        mov rdi, 1;                           // RW_ST_LABELS
        call retained_widgets_note;
        mov rax, rbx;
        jmp retained_widgets_ln_out;

      retained_widgets_ln_fail:
        mov rdi, 8;                           // RW_ST_REFUSED
        call retained_widgets_note;
        mov rax, rbx;

      retained_widgets_ln_out:
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Section 4  retained_list_new + retained_list_add_item
  // ==========================================================================
  //
  // retained_list_new(tree_id, parent, item_count) -> node_id | err
  //   Creates the VNK_LIST parent container node. item_count is a
  //   HINT stored as prop_hash; the child items are appended by
  //   retained_list_add_item, not preallocated here.
  //
  // retained_list_add_item(tree_id, list_node, label_offset) -> item_node_id | err
  //   Appends a VNK_LABEL child under list_node. The substrate
  //   (view_tree_append_node) enforces list_node's cross-tree
  //   membership via its own VT_BAD_PARENT gate.

  pub let retained_list_new : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (tree_id: u64) (parent: u64) (item_count: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-09 (#2330): list-container factory. Same shim shape as retained_button_new; kind=VNK_LIST=3, prop_hash=item_count. Labels prefixed retained_widgets_lsn_.",
      block: {
        push rbx;                             // rsp %16 == 0

        mov rcx, rdx;                         // rcx = prop_hash = item_count
        mov rdx, 3;                           // rdx = VNK_LIST
        xor r8, r8;                           // r8  = state_ptr = 0
        call view_tree_append_node;

        mov rbx, rax;
        mov r10, 128;
        cmp rax, r10;
        jae retained_widgets_lsn_fail;

        mov rdi, 2;                           // RW_ST_LISTS
        call retained_widgets_note;
        mov rax, rbx;
        jmp retained_widgets_lsn_out;

      retained_widgets_lsn_fail:
        mov rdi, 8;                           // RW_ST_REFUSED
        call retained_widgets_note;
        mov rax, rbx;

      retained_widgets_lsn_out:
        pop rbx;
        ret
      }
    }

  pub let retained_list_add_item : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (tree_id: u64) (list_node: u64) (label_offset: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-09 (#2330): list-item append. Same shim shape as retained_button_new; parent is list_node; kind=VNK_LABEL=2 (list items ARE labels parented under VNK_LIST, per §Section 4 header). prop_hash=label_offset. Labels prefixed retained_widgets_lai_.",
      block: {
        push rbx;                             // rsp %16 == 0

        mov rcx, rdx;                         // rcx = prop_hash = label_offset
        mov rdx, 2;                           // rdx = VNK_LABEL (list item)
        xor r8, r8;                           // r8  = state_ptr = 0
        call view_tree_append_node;

        mov rbx, rax;
        mov r10, 128;
        cmp rax, r10;
        jae retained_widgets_lai_fail;

        mov rdi, 3;                           // RW_ST_LIST_ITEMS
        call retained_widgets_note;
        mov rax, rbx;
        jmp retained_widgets_lai_out;

      retained_widgets_lai_fail:
        mov rdi, 8;                           // RW_ST_REFUSED
        call retained_widgets_note;
        mov rax, rbx;

      retained_widgets_lai_out:
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Section 5  retained_tree_new + retained_tree_add_child
  // ==========================================================================
  //
  // retained_tree_new(tree_id, parent, root_label_offset) -> node_id | err
  //   Creates the VNK_TREE parent container node. root_label_offset
  //   is stored as prop_hash (names the tree's root-label text).
  //
  // retained_tree_add_child(tree_id, parent_node, label_offset)
  //   -> child_node_id | err
  //   Appends a VNK_LABEL child under parent_node. parent_node may be
  //   the tree-root returned by retained_tree_new OR any other tree
  //   node returned by a prior retained_tree_add_child call, letting
  //   the client build arbitrary-depth tree topologies.

  pub let retained_tree_new : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (tree_id: u64) (parent: u64) (root_label_offset: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-09 (#2330): tree-container factory. kind=VNK_TREE=7, prop_hash=root_label_offset. Labels prefixed retained_widgets_trn_.",
      block: {
        push rbx;                             // rsp %16 == 0

        mov rcx, rdx;                         // rcx = prop_hash = root_label_offset
        mov rdx, 7;                           // rdx = VNK_TREE
        xor r8, r8;                           // r8  = state_ptr = 0
        call view_tree_append_node;

        mov rbx, rax;
        mov r10, 128;
        cmp rax, r10;
        jae retained_widgets_trn_fail;

        mov rdi, 4;                           // RW_ST_TREES
        call retained_widgets_note;
        mov rax, rbx;
        jmp retained_widgets_trn_out;

      retained_widgets_trn_fail:
        mov rdi, 8;                           // RW_ST_REFUSED
        call retained_widgets_note;
        mov rax, rbx;

      retained_widgets_trn_out:
        pop rbx;
        ret
      }
    }

  pub let retained_tree_add_child : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (tree_id: u64) (parent_node: u64) (label_offset: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-09 (#2330): tree-child append. kind=VNK_LABEL=2 (tree children ARE labels parented under VNK_TREE / a parent VNK_LABEL, per §Section 5 header). prop_hash=label_offset. Labels prefixed retained_widgets_trc_.",
      block: {
        push rbx;                             // rsp %16 == 0

        mov rcx, rdx;                         // rcx = prop_hash = label_offset
        mov rdx, 2;                           // rdx = VNK_LABEL (tree child)
        xor r8, r8;                           // r8  = state_ptr = 0
        call view_tree_append_node;

        mov rbx, rax;
        mov r10, 128;
        cmp rax, r10;
        jae retained_widgets_trc_fail;

        mov rdi, 5;                           // RW_ST_TREE_CHILDREN
        call retained_widgets_note;
        mov rax, rbx;
        jmp retained_widgets_trc_out;

      retained_widgets_trc_fail:
        mov rdi, 8;                           // RW_ST_REFUSED
        call retained_widgets_note;
        mov rax, rbx;

      retained_widgets_trc_out:
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Section 6  retained_textfield_new
  // ==========================================================================
  //
  // retained_textfield_new(tree_id, parent, initial_text_offset, max_len)
  //   -> node_id | err
  //
  // Four-arg factory. prop_hash composition:
  //   prop_hash = (max_len << 32) | (initial_text_offset & 0xFFFFFFFF)
  //
  // Both max_len and initial_text_offset are visible props (see
  // §PROP_HASH COMPOSITION header note). The packing keeps
  // retained_textfield_set_text's mutator simple: it preserves the
  // upper 32 (max_len) and overwrites the lower 32 (text_offset).
  //
  // Args ordering: rdi=tree_id, rsi=parent, rdx=initial_text_offset,
  // rcx=max_len. Composition:
  //   rcx (max_len)   << 32                 -> upper 32
  //   rdx (text_off)  & 0xFFFFFFFF          -> lower 32
  //   OR together -> prop_hash
  // then call view_tree_append_node(tree_id, parent, VNK_TEXTFIELD,
  //                                 prop_hash, 0).

  pub let retained_textfield_new : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (tree_id: u64) (parent: u64) (initial_text_offset: u64) (max_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-09 (#2330): textfield factory. Four-arg factory -- pack (max_len, initial_text_offset) into a single prop_hash u64 before forwarding to view_tree_append_node. kind=VNK_TEXTFIELD=4. Single callee-save push (rbx=node_id) keeps rsp %16 == 0 across the two nested calls. Labels prefixed retained_widgets_tfn_.",
      block: {
        push rbx;                             // rsp %16 == 0

        // Compose prop_hash = (max_len << 32) | (initial_text_offset & 0xFFFFFFFF).
        // rcx = max_len, rdx = initial_text_offset.
        mov r10, rcx;                         // r10 = max_len
        shl r10, 32;                          // r10 = max_len << 32
        mov r11, rdx;                         // r11 = initial_text_offset
        mov rax, 0xFFFFFFFF;
        and r11, rax;                         // r11 = text_off & 0xFFFFFFFF
        or  r10, r11;                         // r10 = composed prop_hash

        // Set up call args. rdi=tree_id already in place; rsi=parent
        // already in place. rdx and rcx are rebuilt below.
        mov rdx, 4;                           // rdx = VNK_TEXTFIELD
        mov rcx, r10;                         // rcx = prop_hash
        xor r8, r8;                           // r8  = state_ptr = 0
        call view_tree_append_node;

        mov rbx, rax;
        mov r10, 128;
        cmp rax, r10;
        jae retained_widgets_tfn_fail;

        mov rdi, 6;                           // RW_ST_TEXTFIELDS
        call retained_widgets_note;
        mov rax, rbx;
        jmp retained_widgets_tfn_out;

      retained_widgets_tfn_fail:
        mov rdi, 8;                           // RW_ST_REFUSED
        call retained_widgets_note;
        mov rax, rbx;

      retained_widgets_tfn_out:
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Section 7  retained_textfield_set_text
  // ==========================================================================
  //
  // retained_textfield_set_text(tree_id, node_id, new_text_offset)
  //   -> RW_OK | RW_BAD_SLOT | RW_BAD_NODE | RW_BAD_TREE | RW_BAD_KIND
  //
  // The retained-mode escape hatch: update a live textfield node's
  // prop_hash so the next view_tree_diff pass sees the change and
  // view_tree_reconcile emits the widget. Gate order (fail-fast; the
  // refusal funnel bumps RW_ST_REFUSED once):
  //
  //   (1) tree_id valid                       -> RW_BAD_SLOT
  //   (2) node_id in-use in the pool          -> RW_BAD_NODE
  //   (3) node's word5 tree_id == tree_id     -> RW_BAD_TREE
  //   (4) node's word0 kind    == VNK_TEXTFIELD -> RW_BAD_KIND
  //
  // On success: read old prop_hash (word3), clear its low 32 bits
  // (preserving max_len in the upper 32), OR in new_text_offset in
  // the low 32 bits, write back. Bump RW_ST_TEXTFIELD_UPDATES. The
  // diff pass fires on the next view_tree_diff call because the
  // prev-frame prop_hash array carries the old value.

  pub let retained_textfield_set_text : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (tree_id: u64) (node_id: u64) (new_text_offset: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-09 (#2330): textfield-content mutator. Four gate checks (slot, node, cross-tree, kind) then in-place update of word3 lower 32 bits preserving upper 32 (max_len). Three callee-save pushes (rbx=tree_id, r12=node_id, r13=new_text_offset) + sub rsp,8 to keep rsp %16 == 0 across nested calls (view_tree_row_valid, view_tree_node_in_use, view_tree_node_tree_id, view_tree_node_base, retained_widgets_note). Labels prefixed retained_widgets_sst_.",
      block: {
        push rbx;
        push r12;
        push r13;
        sub rsp, 8;                           // rsp %16 == 0 for nested calls

        mov rbx, rdi;                         // tree_id
        mov r12, rsi;                         // node_id
        mov r13, rdx;                         // new_text_offset

        // (1) tree_id valid.
        mov rdi, rbx;
        call view_tree_row_valid;
        cmp rax, 0;
        je  retained_widgets_sst_bad_slot;

        // (2) node in use.
        mov rdi, r12;
        call view_tree_node_in_use;
        cmp rax, 0;
        je  retained_widgets_sst_bad_node;

        // (3) node's tree_id matches.
        mov rdi, r12;
        call view_tree_node_tree_id;
        cmp rax, rbx;
        jne retained_widgets_sst_bad_tree;

        // (4) node's kind == VNK_TEXTFIELD (4). Node word0 layout:
        //     in_use[63:56] | reserved[55:40] | kind[39:32] | node_id[31:0]
        // Extract kind: shr 32, mask low 8.
        mov rdi, r12;
        call view_tree_node_base;
        // rax = node base pointer. Preserve across the kind check.
        mov r11, [rax + 0];
        shr r11, 32;
        and r11, 0xFF;
        cmp r11, 4;
        jne retained_widgets_sst_bad_kind;

        // Update prop_hash (word3): preserve upper 32 (max_len),
        // overwrite lower 32 with new_text_offset.
        mov r10, [rax + 24];                  // r10 = old prop_hash
        mov r11, 0xFFFFFFFF;
        shl r11, 32;
        and r10, r11;                         // r10 = max_len << 32 (upper preserved)
        mov r11, r13;                         // r11 = new_text_offset
        mov rcx, 0xFFFFFFFF;
        and r11, rcx;                         // r11 = new_text_offset & 0xFFFFFFFF
        or  r10, r11;
        mov [rax + 24], r10;                  // write back

        // Bump RW_ST_TEXTFIELD_UPDATES.
        mov rdi, 7;
        call retained_widgets_note;
        xor rax, rax;                         // RW_OK
        jmp retained_widgets_sst_out;

      retained_widgets_sst_bad_slot:
        mov rax, 0xFFFFEACF;                  // RW_BAD_SLOT
        jmp retained_widgets_sst_refused;
      retained_widgets_sst_bad_node:
        mov rax, 0xFFFFEACE;                  // RW_BAD_NODE
        jmp retained_widgets_sst_refused;
      retained_widgets_sst_bad_tree:
        mov rax, 0xFFFFEACD;                  // RW_BAD_TREE
        jmp retained_widgets_sst_refused;
      retained_widgets_sst_bad_kind:
        mov rax, 0xFFFFEACC;                  // RW_BAD_KIND

      retained_widgets_sst_refused:
        mov rbx, rax;                         // stash sentinel
        mov rdi, 8;                           // RW_ST_REFUSED
        call retained_widgets_note;
        mov rax, rbx;

      retained_widgets_sst_out:
        add rsp, 8;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Section 8  Boot init.
  // ==========================================================================

  pub let retained_widgets_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B11-09 (#2330): call through to retained_widgets_stats_reset for one clean counter zero-out. view_tree.pdx's own view_tree_init separately zeroes the substrate pool/counters -- boot order is view_tree_init BEFORE retained_widgets_init so the substrate is ready before any factory call. Labels prefixed retained_widgets_i_.",
      block: {
        call retained_widgets_stats_reset;
        ret
      }
    }
}
