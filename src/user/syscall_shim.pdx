  // ==========================================================================
  // R65v2.M1-001 (paideia-os #1979) -- persistent-home probe + mount
  // ==========================================================================

  // sys_stat(path_va, path_len, stat_buf_va) -> 0 (success) or negative errno.
  // Kernel body (sys_stat_body, sysno 77) landed at R56.M3-002 (#1791); no
  // userland trampoline existed until init.pdx's home-mount probe needed
  // one. Arity 3 lands directly in the raw syscall's first three arg slots
  // (rdi/rsi/rdx) -- no shuffle needed, same shape as sys_open.
  pub let sys_stat : (u64, u64, u64) -> u64 !{mem, sysreg} @{fs} =
    fn (path_va: u64) (path_len: u64) (stat_buf_va: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {fs},
      justification: "R65v2.M1-001 (#1979): SC+ ID 77. SysV args rdi/rsi/rdx -> SYSCALL ID 77. No arg shuffle (arity 3 < 4). Kernel body at core/syscall/sys_stat.pdx (sys_stat_body, landed R56.M3-002 #1791) -- this trampoline is the first userland caller, needed so init.pdx can probe /var/pdxfs/home.img and /dev/nvme0 before deciding whether to mount a persistent founder home directory.",
      block: {
        mov rax, 77;
        syscall;
        ret
      }
    }

  // sys_mount(dev_path_va, dev_path_len, mount_point_va, mount_point_len,
  //           backend_id) -> mount_slot in [0..7] on success, or a
  //           0xFFFFED6x sentinel on failure (see sys_mount.pdx's own
  //           failure taxonomy).
  //
  // Kernel body (sys_mount_body via sys_mount_shim, sysno 75) landed at
  // R53.M2-002 (#1737); dispatch wire (dispatch_mount) rewired real at
  // paideia-os 274c93b. No userland trampoline existed until this round's
  // init.pdx home-mount probe needed one.
  //
  // SPECIAL: arity 5 needs a TWO-register SysV->SYSCALL shuffle, not the
  // single rcx->r10 move sys_wait4 uses for arity 4. entry.pdx's own
  // shuffle (`mov r8, r10; mov rcx, rdx; mov rdx, rsi; mov rsi, rdi; pop
  // rdi`) reads raw r10 into dispatch's r8 slot and clobbers raw r8 mid-
  // sequence WITHOUT ever reading it -- so a 5th argument staged in the
  // SysV-conventional r8 would simply be lost. The only register entry.pdx
  // never touches is r9, which rides through untouched into dispatch's own
  // r9 register. dispatch_mount's own landed shuffle confirms the wire:
  // `mov rdi,rsi; mov rsi,rdx; mov rdx,rcx; mov rcx,r8; mov r8,r9` reading
  // dev_path_va/dev_path_len/mount_point_va/mount_point_len/backend_id off
  // rsi/rdx/rcx/r8/r9 respectively -- i.e. dispatch's a4=backend_id comes
  // from r9, not r8. This trampoline therefore moves mount_point_len
  // (SysV rcx) to r10 AND backend_id (SysV r8) to r9 before `syscall`.
  pub let sys_mount : (u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{fs} =
    fn (dev_path_va: u64) (dev_path_len: u64) (mount_point_va: u64) (mount_point_len: u64) (backend_id: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {fs},
      justification: "R65v2.M1-001 (#1979): SC+ ID 75. SysV args rdi/rsi/rdx/rcx/r8 -> SYSCALL args rdi/rsi/rdx/r10/r9 (two-move shuffle: `mov r10, rcx` places mount_point_len at the raw arg3 slot entry.pdx reads into dispatch's r8; `mov r9, r8` places backend_id at raw r9, the one register entry.pdx's shuffle never touches, which is the only way it can reach dispatch_mount's own r9=a4=backend_id slot -- see this trampoline's own header comment for the full wire trace against entry.pdx and dispatch_mount). Kernel body at core/syscall/sys_mount.pdx (sys_mount_body via sys_mount_shim), dispatch wire at core/syscall/dispatch.pdx dispatch_mount (sysno 75, rewired real at paideia-os 274c93b) -- this trampoline is the first userland caller of the real 5-arg path-based ABI (mount.pdxfs's own tools/user/mount.pdxfs/src/mount_op.pdx targets a different, mismatched aspirational cap-slot ABI -- see that file's own KERNEL GAP #2 note; that mismatch is out of scope here).",
      block: {
        mov r10, rcx;
        mov r9, r8;
        mov rax, 75;
        syscall;
        ret
      }
    }

