      effects: {mem, sysreg}, capabilities: {fs},
      justification: "Wave 7 (#2446): SC+ ID 96. Arity 5 -- see block-comment above for the mov r10,rcx + mov r9,r8 shuffle. Kernel body at core/syscall/handlers/sys_sendto.pdx (R93.M2-004 #2052).",
      block: {
        mov r10, rcx;
        mov r9, r8;
        mov rax, 96;
        syscall;
        ret
      }
    }

