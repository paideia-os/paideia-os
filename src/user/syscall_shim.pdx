        syscall;
        ret
      }
    }

  // ==========================================================================
  // Wave U (paideia-os/shell#39) -- exec-time capability reconciliation
  // ==========================================================================

  // sys_exec_reconcile_caps(child_pid, child_caps_decl_ptr, child_caps_decl_len) -> reconciled cap count or negative errno.
  pub let sys_exec_reconcile_caps : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (child_pid: u64) (child_caps_decl_ptr: u64) (child_caps_decl_len: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "Wave U (paideia-os/shell#39): SC+ ID 118 -- shifted off the issue-requested 96, which is SC+ ID for sys_sendto (Wave 7, #2446, this same file). SysV args rdi/rsi/rdx -> SYSCALL ID 118. No arg shuffle (arity 3 < 4). Userspace-visible trampoline over the ALREADY-LANDED kernel substrate paideia-os R90-XREPO.013.M0-001 (src/kernel/core/cap/reconcile.pdx cap_reconcile_at_exec) -- per tools/user/shell/src/exec.pdx's own extensive commentary, the kernel body has existed since that landing; only the syscall-table SC+ ID allocation and this userspace wrapper were pending, which is exactly what shell#39 asked for. Returns the reconciled cap-set count (>= 0) or a negative errno. `cap` capability because the body walks / narrows the child task's cap_table against its declared caps.decl manifest. Floor-only in the sense that the kernel-side dispatch arm for sysno 118 still needs to be wired to call the already-landed cap_reconcile_at_exec body -- a follow-up, same staging as every other Wave U sysno in this file.",
      block: {
        mov rax, 118;
        syscall;
        ret
      }
    }

  // ==========================================================================
  // Wave U (paideia-os#2455) -- /bin/ps %CPU substrate
  // ==========================================================================

  // sys_clock_ticks() -> global scheduler tick count since boot.
  pub let sys_clock_ticks : () -> u64 !{sysreg} @{} =
    fn () -> unsafe {
      effects: {sysreg}, capabilities: {},
      justification: "Wave U (#2455): SC+ ID 119 -- shifted off the issue-requested 96/97, both already SC+ IDs (sys_sendto / sys_recvfrom, Wave 7 #2446, this same file). Arity 0 -- no SysV args, no shuffle. Sole consumer: /bin/ps's %CPU column, computed as (task_ticks / uptime_ticks) * 100 where task_ticks comes from the existing sys_taskinfo (SC+ 83) row and uptime_ticks comes from this new syscall. No capabilities required -- a global tick counter read has no fs/cap/sched authority implication, mirroring sys_getpid's empty capability set. Floor-only landing: no kernel dispatch arm exists yet; a real body would read the same tick counter core/sched/yield.pdx / the PIT-or-HPET-driven scheduler tick ISR already increments for preemption accounting.",
      block: {
        mov rax, 119;
        syscall;
        ret
      }
    }

  // ==========================================================================
  // R121.M2 (paideia-os #2496) -- KIND_PIPELINE_EDGE zero-copy transport
  // ==========================================================================
  //
  // Two new SC+ IDs (131, 132) for the semantic-shell pipeline substrate.
  // Chosen contiguously above the τ-03 rlimit block (127..130). Both go
  // to real, wired kernel dispatch arms in this landing (not floor-only):
  //   131 -> dispatch_pipe_edge_send in core/syscall/dispatch.pdx
  //   132 -> dispatch_pipe_edge_recv in core/syscall/dispatch.pdx
  // Both bodies live in src/kernel/core/cap/pipeline_edge_transport.pdx
  // as pipe_edge_send / pipe_edge_recv respectively.
  //
  // No user pointers on either syscall; both are pure by-cap: the caller
  // passes cap_table slot indices (0..255) and the kernel walks its own
  // cap_table without touching user memory. So no user_ptr_ok gate on
  // either dispatch arm and no KPTI bounce.
  //
  // Return values (both syscalls):
  //   -EAGAIN (0xFFFFFFFFFFFFFFF5) on ring-full (send) / ring-empty (recv)
  //   -EBADF  (0xFFFFFFFFFFFFFFF7) on invalid edge_cap or invalid mem_cap
  //   -EINVAL (0xFFFFFFFFFFFFFFEA) on other structural refusals
  //   Otherwise: 0 (send) or the popped mem_cap_slot (recv).

  // sys_pipe_edge_send(edge_cap_slot, mem_cap_slot)
  //   -> 0 | -EAGAIN | -EBADF | -EINVAL.
  //
  // Producer half of the intra-process by-cap transport. Push a MemCap
  // handle into the SPSC ring associated with the edge. Non-blocking;
  // caller polls / sleeps and retries on -EAGAIN.
  pub let sys_pipe_edge_send : (u64, u64) -> u64 !{sysreg} @{cap} =
    fn (edge_cap_slot: u64) (mem_cap_slot: u64) -> unsafe {
      effects: {sysreg}, capabilities: {cap},
      justification: "R121.M2 (paideia-os #2496): SC+ ID 131. Chosen contiguously above the τ-03 rlimit block (127..130) -- next free sysno per the dispatch.pdx bounds gate (was `cmp rdi, 130; ja dispatch_enosys`, widened to 132 in this landing). SysV args rdi/rsi -> SYSCALL ID 131. No arg shuffle (arity 2 < 4). Kernel body: pipe_edge_send in src/kernel/core/cap/pipeline_edge_transport.pdx §13; kernel dispatch arm dispatch_pipe_edge_send in src/kernel/core/syscall/dispatch.pdx. Pure by-cap: no user pointers, no KPTI bounce. `cap` capability because the body walks cap_table to validate both slot references (edge slot kind == KIND_PIPELINE_EDGE with R_PE_SEND, mem slot kind == KIND_MEMORY).",
      block: {
        mov rax, 131;
        syscall;
        ret
      }
    }

  // sys_pipe_edge_recv(edge_cap_slot)
  //   -> mem_cap_slot | -EAGAIN | -EBADF.
  //
  // Consumer half. Pop a MemCap handle from the SPSC ring. Non-blocking;
  // caller polls / sleeps and retries on -EAGAIN.
  //
  // Return is the raw cap_slot index of a MemCap in the caller's own
  // cap_table (intra-process at M2). The receiver may then cap_invoke
  // that slot to read the memory contents. Valid cap_slot returns fall
  // in [0, 255]; any u64 above 0xFFFFFF... is an errno.
  pub let sys_pipe_edge_recv : (u64) -> u64 !{sysreg} @{cap} =
    fn (edge_cap_slot: u64) -> unsafe {
      effects: {sysreg}, capabilities: {cap},
      justification: "R121.M2 (paideia-os #2496): SC+ ID 132. Contiguous with 131 (send). SysV arg rdi -> SYSCALL ID 132. No arg shuffle (arity 1 < 4). Kernel body: pipe_edge_recv in src/kernel/core/cap/pipeline_edge_transport.pdx §13; kernel dispatch arm dispatch_pipe_edge_recv in src/kernel/core/syscall/dispatch.pdx. Pure by-cap. `cap` capability because the body walks cap_table to validate the edge slot (kind == KIND_PIPELINE_EDGE with R_PE_RECV).",
      block: {
        mov rax, 132;
        syscall;
        ret
      }
    }
}
