// src/user/touch.pdx -- R58.M5 (paideia-os #1809) -- /bin/touch user binary
//
// Minimal self-contained /bin/touch: create (or open) one hardcoded file via
// sys_open(O_CREAT|O_WRONLY) then sys_close, then report success/failure
// and exit.
//
// -----------------------------------------------------------------------------
// argv[1] -- M0 hardcoded path (per sys_execve_shim.pdx §Non-Scope)
// -----------------------------------------------------------------------------
//
// Per src/user/ls.pdx §argv/envp note: execve does NOT populate argc/argv
// onto the user stack at M0 (see sys_execve_shim.pdx §Non-Scope), so
// argv[1] is not reachable from _start. This binary hardcodes the target
// path to "/tmp/x" pending execve argv wire-up (see sys_execve_shim.pdx
// §Non-Scope). Once argv-passing lands, touch's target collapses to the
// real argv[1] with no change to the syscall sequence below.
//
// -----------------------------------------------------------------------------
// Design choice -- self-contained, no syscall_shim link dependency
// -----------------------------------------------------------------------------
//
// Mirrors true.pdx / cat.pdx / ps.pdx / rm.pdx / mv.pdx / mkdir.pdx:
// inlines the syscalls it needs (sys_open=2, sys_close=3, sys_debug_puts=12,
// sys_exit=60) directly at their call sites. One .pdx file, one .elf.
// build-user.sh classifies touch into its own object set (no library
// pull-in).
//
// -----------------------------------------------------------------------------
// SC+ IDs used (src/user/syscall_shim.pdx §2.1)
// -----------------------------------------------------------------------------
//   2  = sys_open(path, flags, mode)  -> fd or -errno
//   3  = sys_close(fd)                -> 0 or -errno
//   12 = sys_debug_puts(buf, count)   -- fingerprint emit
//   60 = sys_exit(status)             -- never returns
//
// flags = O_CREAT|O_WRONLY = 0x40|0x01 = 0x41 -- verbatim value
// rootfs_seed.pdx passes to sys_open for its own per-file seed writes
// (see rootfs_seed.pdx §104). mode = 0x1A4 (0644), same source.
//
// -----------------------------------------------------------------------------
// Register discipline
// -----------------------------------------------------------------------------
//
// rbx holds the fd returned by sys_open across the sys_close call (the
// only cross-syscall-surviving value in this binary; SYSCALL preserves
// callee-save registers per amd64 fast-syscall rules). No prologue push;
// entry rsp%16==0 per the PVH loader contract, and every terminal path
// ends in sys_exit.
//
// -----------------------------------------------------------------------------
// Encoder-gap discipline
// -----------------------------------------------------------------------------
//
// No `add reg, [mem]` / `sub reg, [mem]` anywhere in this file.
//
// -----------------------------------------------------------------------------
// Reserved-label discipline
// -----------------------------------------------------------------------------
//
// The one internal label is prefixed `touch_` per the paideia-as
// reserved-word convention.

module Touch = structure {

  // Hardcoded M0 target path. Absolute + NUL-terminated.
  pub let touch_path : [u8; 7] = "/tmp/x\0"

  // Fingerprint strings -- routed through sys_debug_puts (SC+ ID 12).
  // Storage carries the trailing NUL; wire length excludes it. ASCII
  // "--" in place of an em-dash keeps the line 7-bit ASCII.
  pub let touch_msg_ok    : [u8; 25] = "touch ok -- path=/tmp/x\n\0"
  pub let touch_msg_ok_len : u64 = 24

  pub let touch_msg_fail    : [u8; 17] = "TOUCH OPEN FAIL\n\0"
  pub let touch_msg_fail_len : u64 = 16

  // -------------------------------------------------------------------------
  // _start -- user program entry point. Never returns.
  //
  // Effects/caps:
  //   mem     -- reads touch_path / touch_msg_* rodata.
  //   sysreg  -- every SYSCALL clobbers rcx (RIP)/r11 (rflags).
  //   fs      -- sys_open / sys_close.
  //   sched   -- sys_exit terminates the task.
  //
  // @no_frame because the function ends in sys_exit on every terminal
  // path (never returns).
  // -------------------------------------------------------------------------
  pub let _start : () -> () !{mem, sysreg} @{fs, sched} =
    fn () -> unsafe {
      effects: {mem, sysreg},
      capabilities: {fs, sched},
      justification: "R58.M5 (#1809): /bin/touch _start. Inlines sys_open (SC+ ID 2), sys_close (SC+ ID 3), sys_debug_puts (SC+ ID 12) and sys_exit (SC+ ID 60) -- same one-file-one-ELF pattern as true.pdx / cat.pdx / rm.pdx / mv.pdx / mkdir.pdx. Sequence: (1) sys_open(touch_path, 0x41, 0x1A4) -- rdi = path VA (rip-relative lea), rsi = 0x41 = O_CREAT|O_WRONLY (verbatim value rootfs_seed.pdx passes to sys_open for its own per-file seed writes, see rootfs_seed.pdx §104), rdx = 0x1A4 = 0644, rax = 2, syscall. rax < 0 (signed test via `cmp rax, 0; jl`, matching cat.pdx's own sys_open error gate at cat.pdx §152) -> emit 'TOUCH OPEN FAIL\\n' via sys_debug_puts, sys_exit(1). Otherwise stash fd in rbx (callee-save; SYSCALL preserves it per amd64 fast-syscall rules) and (2) sys_close(rbx) -- rdi = rbx, rax = 3, syscall; return value ignored per fd_close-of-live-fd's proven no-fail contract at R16.M3-005 (#591) once fd was minted by a matching sys_open (same posture as ls.pdx's own sys_close call). (3) emit 'touch ok -- path=/tmp/x\\n' via sys_debug_puts, sys_exit(0). @no_frame because every terminal path ends in sys_exit; entry rsp%16==0 per the PVH loader contract. Encoder-gap discipline: no `add reg, [mem]` / `sub reg, [mem]` anywhere. Reserved-label discipline: the one internal label is prefixed `touch_`. argv[1] is IGNORED at R17.M0 per sys_execve_shim.pdx §Non-Scope, so the target path is hardcoded to /tmp/x pending the execve argv wire-up.",
      block: {
        // ============================================================
        // Phase 1 -- sys_open(touch_path, O_CREAT|O_WRONLY=0x41, mode=0x1A4)
        // ============================================================
        lea rdi, [rip + touch_path];
        mov rsi, 0x41;                        // O_CREAT|O_WRONLY
        mov rdx, 0x1A4;                        // mode 0644
        mov rax, 2;                            // SC+ ID 2 = sys_open
        syscall;

        cmp rax, 0;
        jl touch_fail;
        mov rbx, rax;                          // rbx = fd (callee-save)

        // ============================================================
        // Phase 2 -- sys_close(fd)
        // ============================================================
        mov rdi, rbx;                           // fd
        mov rax, 3;                             // SC+ ID 3 = sys_close
        syscall;

        // ============================================================
        // Phase 3 -- success: sys_debug_puts(touch_msg_ok, 24); sys_exit(0)
        // ============================================================
        lea rdi, [rip + touch_msg_ok];
        mov rsi, 24;                            // touch_msg_ok_len
        mov rax, 12;                            // SC+ ID 12 = sys_debug_puts
        syscall;

        xor rdi, rdi;                           // status = 0 (OK)
        mov rax, 60;                             // SC+ ID 60 = sys_exit
        syscall;
        hlt;

      touch_fail:
        // ============================================================
        // Phase 4 -- fail: sys_debug_puts(touch_msg_fail, 16); sys_exit(1)
        // ============================================================
        lea rdi, [rip + touch_msg_fail];
        mov rsi, 16;                             // touch_msg_fail_len
        mov rax, 12;                             // SC+ ID 12 = sys_debug_puts
        syscall;

        mov rdi, 1;                              // status = 1 (open failed)
        mov rax, 60;                             // SC+ ID 60 = sys_exit
        syscall;
        hlt
      }
    } @no_frame
}
