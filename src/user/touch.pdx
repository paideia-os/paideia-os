// src/user/touch.pdx -- R58.M5 (paideia-os #1809) -- /bin/touch user binary
//
// Minimal self-contained /bin/touch: create (or open) one file via
// sys_open(O_CREAT|O_WRONLY) then sys_close, then report success/failure
// (echoing the real path used) and exit.
//
// -----------------------------------------------------------------------------
// argv[1] -- real since R62.M1-005 (#1836); fingerprint honest since #2433
// -----------------------------------------------------------------------------
//
// argc/argv arrive in rdi/rsi at _start per the frozen execve ABI
// (design/user/execve-abi.md). When argc >= 2, argv[1] (a pointer
// directly into this process's own address space) is the file to create
// -- sys_open takes a NUL-terminated path with no explicit length
// argument, so no strlen scan is needed for the open call itself. When
// argc < 2, the target falls back to the original M0 hardcoded "/tmp/x".
//
// #2433 (2026-09-11): the R62.M1-005 argv wire-up was correct; disasm of
// build/user/touch.elf confirmed `mov 0x8(%rsi),%r12` executed and the
// real argv[1] path was passed to sys_open. But the success fingerprint
// remained the M0 literal string "touch ok -- path=/tmp/x\n", which made
// every argv-driven invocation look like the fallback had fired. This
// round replaces the single-shot hardcoded fingerprint with three
// sys_debug_puts calls that concatenate "touch ok -- path=" + the real
// path bytes (inline strlen scan of r12, cap 255, matching rm.pdx /
// mkdir.pdx) + "\n". design/user/execve-abi.md §Migrated tools flagged
// this as the deferred follow-up round; #2433 landed it for touch.
//
// -----------------------------------------------------------------------------
// Design choice -- self-contained, no syscall_shim link dependency
// -----------------------------------------------------------------------------
//
// Mirrors true.pdx / cat.pdx / ps.pdx / rm.pdx / mv.pdx / mkdir.pdx:
// inlines the syscalls it needs (sys_open=2, sys_close=3, sys_debug_puts=12,
// sys_exit=60) directly at their call sites. One .pdx file, one .elf.
// build-user.sh classifies touch into its own object set (no library
// pull-in).
//
// -----------------------------------------------------------------------------
// SC+ IDs used (src/user/syscall_shim.pdx §2.1)
// -----------------------------------------------------------------------------
//   2  = sys_open(path, flags, mode)  -> fd or -errno
//   3  = sys_close(fd)                -> 0 or -errno
//   12 = sys_debug_puts(buf, count)   -- fingerprint emit
//   60 = sys_exit(status)             -- never returns
//
// flags = O_CREAT|O_WRONLY = 0x40|0x01 = 0x41 -- verbatim value
// rootfs_seed.pdx passes to sys_open for its own per-file seed writes
// (see rootfs_seed.pdx §104). mode = 0x1A4 (0644), same source.
//
// -----------------------------------------------------------------------------
// Register discipline
// -----------------------------------------------------------------------------
//
// rbx holds the fd returned by sys_open across the sys_close call. r12
// (R62.M1-005 #1836 addition) holds the resolved target path pointer
// (argv[1] or the default) from Phase 0 through Phase 3's fingerprint
// emit -- both are SysV callee-save and SYSCALL preserves them per amd64
// fast-syscall rules. rcx is used as the strlen cursor in Phase 3 (rcx is
// caller-save and clobbered by every SYSCALL, so it is zeroed at the top
// of the strlen loop after the prefix sys_debug_puts). No prologue push;
// entry rsp%16==0 per the PVH loader contract, and every terminal path
// ends in sys_exit.
//
// -----------------------------------------------------------------------------
// Encoder-gap discipline
// -----------------------------------------------------------------------------
//
// No `add reg, [mem]` / `sub reg, [mem]` anywhere in this file. The
// strlen scan uses `mov_b rax, [r12 + rcx * 1]` (extended base +
// non-extended index, proven in the tree at src/kernel/core/graphics/
// surface_toplevel.pdx L817, src/kernel/core/ipc/schema_registry.pdx
// L698, src/kernel/core/drivers/usb/hid/kbd_full.pdx L349) with the
// standard `xor rax, rax` pre-zero so the byte compare observes only the
// loaded byte (paideia-as #1248).
//
// -----------------------------------------------------------------------------
// Reserved-label discipline
// -----------------------------------------------------------------------------
//
// Every internal label is prefixed `touch_` per the paideia-as
// reserved-word convention.

module Touch = structure {

  // Hardcoded M0 fallback path. Absolute + NUL-terminated. Used when
  // argc < 2. When argc >= 2, argv[1] supplants this pointer.
  pub let touch_path : [u8; 7] = "/tmp/x\0"

  // Fingerprint prefix -- emitted verbatim, then followed by the real
  // path bytes (length via inline strlen scan of r12, cap 255) and a
  // trailing newline. Written as three sys_debug_puts calls rather than a
  // single hardcoded literal so the fingerprint actually reports the path
  // that was opened (see #2433 and design/user/execve-abi.md §Migrated
  // tools). Storage carries the trailing NUL for strlen-safety; the wire
  // length excludes it. ASCII "--" in place of an em-dash keeps the line
  // 7-bit ASCII (see rootfs_seed.pdx L23 note).
  pub let touch_msg_ok_prefix    : [u8; 18] = "touch ok -- path=\0"
  pub let touch_msg_ok_prefix_len : u64 = 17

  pub let touch_msg_nl : [u8; 2] = "\n\0"

  pub let touch_msg_fail    : [u8; 17] = "TOUCH OPEN FAIL\n\0"
  pub let touch_msg_fail_len : u64 = 16

  // -------------------------------------------------------------------------
  // _start -- user program entry point. Never returns.
  //
  // Effects/caps:
  //   mem     -- reads touch_path / touch_msg_* rodata + reads argv[1]
  //              bytes via the Phase 3 strlen scan.
  //   sysreg  -- every SYSCALL clobbers rcx (RIP)/r11 (rflags).
  //   fs      -- sys_open / sys_close.
  //   sched   -- sys_exit terminates the task.
  //
  // @no_frame because the function ends in sys_exit on every terminal
  // path (never returns).
  // -------------------------------------------------------------------------
  pub let _start : () -> () !{mem, sysreg} @{fs, sched} =
    fn () -> unsafe {
      effects: {mem, sysreg},
      capabilities: {fs, sched},
      justification: "R58.M5 (#1809) + R62.M1-005 (#1836) + #2433: /bin/touch _start. Inlines sys_open (SC+ ID 2), sys_close (SC+ ID 3), sys_debug_puts (SC+ ID 12) and sys_exit (SC+ ID 60) -- same one-file-one-ELF pattern as true.pdx / cat.pdx / rm.pdx / mv.pdx / mkdir.pdx. Phase 0 reads argc (rdi) per the frozen execve ABI (design/user/execve-abi.md); when argc >= 2, r12 = argv[1] (`[rsi + 8]`, own-aspace pointer); when argc < 2, r12 = &touch_path ('/tmp/x'). Sequence: (1) sys_open(r12, 0x41, 0x1A4) -- rdi = r12, rsi = 0x41 = O_CREAT|O_WRONLY (verbatim value rootfs_seed.pdx passes to sys_open for its own per-file seed writes, see rootfs_seed.pdx §104), rdx = 0x1A4 = 0644, rax = 2, syscall. rax < 0 (signed test via `cmp rax, 0; jl`, matching cat.pdx's own sys_open error gate) -> emit 'TOUCH OPEN FAIL\\n' via sys_debug_puts, sys_exit(1). Otherwise stash fd in rbx (callee-save; SYSCALL preserves it) and (2) sys_close(rbx) -- rdi = rbx, rax = 3, syscall; return value ignored per fd_close-of-live-fd's proven no-fail contract at R16.M3-005 (#591) once fd was minted by a matching sys_open. (3) #2433 fingerprint: three sys_debug_puts calls -- (3a) emit 'touch ok -- path=' (touch_msg_ok_prefix, 17 bytes); (3b) inline strlen of r12 into rcx capped at 255 via `xor rax, rax; mov_b rax, [r12 + rcx * 1]; cmp rax, 0; je done; add rcx, 1; cmp rcx, 255; jae done` -- the rm.pdx/mkdir.pdx strlen shape (paideia-as #1248 pre-zero-then-mov_b idiom), then emit the path bytes via sys_debug_puts(r12, rcx); (3c) emit '\\n' via sys_debug_puts(touch_msg_nl, 1); (3d) sys_exit(0). Splitting the fingerprint into three writes rather than the pre-#2433 single-shot literal is what makes the printed path reflect the real target -- resolving the false-positive regression report where an argv-driven `touch /tmp/newfile2` continued to print 'path=/tmp/x' even though the syscall targeted /tmp/newfile2 correctly (disasm of build/user/touch.elf at HEAD 4d20614 confirmed `mov 0x8(%rsi),%r12` and `mov %r12,%rdi` prior to sys_open). r12 is SysV callee-save and SYSCALL preserves it, so the same pointer set in Phase 0 remains valid through the entire Phase 3 sequence. rcx must be re-zeroed inside the loop because the prefix syscall in Phase 3a clobbered it (rcx receives the user RIP on SYSCALL return). Fail path is unchanged: emit 'TOUCH OPEN FAIL\\n' via sys_debug_puts, sys_exit(1). @no_frame because every terminal path ends in sys_exit; entry rsp%16==0 per the PVH loader contract; no push, no sub rsp emitted. Encoder-gap discipline: no `add reg, [mem]` / `sub reg, [mem]` anywhere. `mov_b rax, [r12 + rcx * 1]` (extended base + non-extended index) is proven at src/kernel/core/graphics/surface_toplevel.pdx L817, src/kernel/core/ipc/schema_registry.pdx L698, src/kernel/core/drivers/usb/hid/kbd_full.pdx L349. Reserved-label discipline: every label is prefixed `touch_`.",
      block: {
        // ============================================================
        // Phase 0 (#1836) -- resolve target path from argv[1], or fall
        // back to the M0 hardcoded /tmp/x default. No strlen needed for
        // the open call: sys_open takes a bare NUL-terminated path.
        // ============================================================
        cmp rdi, 2;
        jl  touch_use_default;
        mov r12, [rsi + 8];                   // r12 = argv[1] (own aspace, direct deref)
        jmp touch_path_ready;

      touch_use_default:
        lea r12, [rip + touch_path];

      touch_path_ready:
        // ============================================================
        // Phase 1 -- sys_open(r12, O_CREAT|O_WRONLY=0x41, mode=0x1A4)
        // ============================================================
        mov rdi, r12;
        mov rsi, 0x41;                        // O_CREAT|O_WRONLY
        mov rdx, 0x1A4;                       // mode 0644
        mov rax, 2;                           // SC+ ID 2 = sys_open
        syscall;

        cmp rax, 0;
        jl touch_fail;
        mov rbx, rax;                         // rbx = fd (callee-save)

        // ============================================================
        // Phase 2 -- sys_close(fd)
        // ============================================================
        mov rdi, rbx;                         // fd
        mov rax, 3;                           // SC+ ID 3 = sys_close
        syscall;

        // ============================================================
        // Phase 3a (#2433) -- emit "touch ok -- path=" prefix.
        // ============================================================
        lea rdi, [rip + touch_msg_ok_prefix];
        mov rsi, 17;                          // touch_msg_ok_prefix_len
        mov rax, 12;                          // SC+ ID 12 = sys_debug_puts
        syscall;

        // ============================================================
        // Phase 3b (#2433) -- inline strlen of r12 into rcx, cap 255,
        // then emit path bytes via sys_debug_puts(r12, rcx). Matches
        // rm.pdx rm_strlen_loop / mkdir.pdx mkdir_strlen_loop. rcx was
        // clobbered by the Phase 3a syscall, so re-zero it here.
        // ============================================================
        xor rcx, rcx;                         // rcx = strlen cursor

      touch_strlen_loop:
        xor rax, rax;                         // pre-zero: mov_b does not zero-extend
        mov_b rax, [r12 + rcx * 1];
        cmp rax, 0;
        je  touch_strlen_done;
        add rcx, 1;
        cmp rcx, 255;
        jae touch_strlen_done;                // cap at 255
        jmp touch_strlen_loop;

      touch_strlen_done:
        mov rdi, r12;                         // buf = resolved path pointer
        mov rsi, rcx;                         // count = path_len
        mov rax, 12;                          // SC+ ID 12 = sys_debug_puts
        syscall;

        // ============================================================
        // Phase 3c (#2433) -- emit trailing newline.
        // ============================================================
        lea rdi, [rip + touch_msg_nl];
        mov rsi, 1;
        mov rax, 12;                          // SC+ ID 12 = sys_debug_puts
        syscall;

        // ============================================================
        // Phase 3d -- sys_exit(0)
        // ============================================================
        xor rdi, rdi;                         // status = 0 (OK)
        mov rax, 60;                          // SC+ ID 60 = sys_exit
        syscall;
        hlt;

      touch_fail:
        // ============================================================
        // Phase 4 -- fail: sys_debug_puts(touch_msg_fail, 16); sys_exit(1)
        // ============================================================
        lea rdi, [rip + touch_msg_fail];
        mov rsi, 16;                          // touch_msg_fail_len
        mov rax, 12;                          // SC+ ID 12 = sys_debug_puts
        syscall;

        mov rdi, 1;                           // status = 1 (open failed)
        mov rax, 60;                          // SC+ ID 60 = sys_exit
        syscall;
        hlt
      }
    } @no_frame
}
