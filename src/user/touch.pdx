// src/user/touch.pdx -- R58.M5 (paideia-os #1809) -- /bin/touch user binary
//
// Minimal self-contained /bin/touch: create (or open) one hardcoded file via
// sys_open(O_CREAT|O_WRONLY) then sys_close, then report success/failure
// and exit.
//
// -----------------------------------------------------------------------------
// argv[1] -- real since R62.M1-005 (#1836), falls back to /tmp/x
// -----------------------------------------------------------------------------
//
// argc/argv arrive in rdi/rsi at _start per the frozen execve ABI
// (design/user/execve-abi.md). When argc >= 2, argv[1] (a pointer
// directly into this process's own address space) is the file to create
// -- sys_open takes a NUL-terminated path with no explicit length
// argument, so no strlen scan is needed (unlike rm.pdx/mkdir.pdx's
// sys_unlink/sys_mkdir, which do take an explicit path_len cap). When
// argc < 2, the target falls back to the original M0 hardcoded "/tmp/x".
//
// -----------------------------------------------------------------------------
// Design choice -- self-contained, no syscall_shim link dependency
// -----------------------------------------------------------------------------
//
// Mirrors true.pdx / cat.pdx / ps.pdx / rm.pdx / mv.pdx / mkdir.pdx:
// inlines the syscalls it needs (sys_open=2, sys_close=3, sys_debug_puts=12,
// sys_exit=60) directly at their call sites. One .pdx file, one .elf.
// build-user.sh classifies touch into its own object set (no library
// pull-in).
//
// -----------------------------------------------------------------------------
// SC+ IDs used (src/user/syscall_shim.pdx §2.1)
// -----------------------------------------------------------------------------
//   2  = sys_open(path, flags, mode)  -> fd or -errno
//   3  = sys_close(fd)                -> 0 or -errno
//   12 = sys_debug_puts(buf, count)   -- fingerprint emit
//   60 = sys_exit(status)             -- never returns
//
// flags = O_CREAT|O_WRONLY = 0x40|0x01 = 0x41 -- verbatim value
// rootfs_seed.pdx passes to sys_open for its own per-file seed writes
// (see rootfs_seed.pdx §104). mode = 0x1A4 (0644), same source.
//
// -----------------------------------------------------------------------------
// Register discipline
// -----------------------------------------------------------------------------
//
// rbx holds the fd returned by sys_open across the sys_close call. r12
// (R62.M1-005 #1836 addition) holds the resolved target path pointer
// (argv[1] or the default) from Phase 0 through Phase 1's sys_open --
// both are SysV callee-save and SYSCALL preserves them per amd64
// fast-syscall rules. No prologue push; entry rsp%16==0 per the PVH
// loader contract, and every terminal path ends in sys_exit.
//
// -----------------------------------------------------------------------------
// Encoder-gap discipline
// -----------------------------------------------------------------------------
//
// No `add reg, [mem]` / `sub reg, [mem]` anywhere in this file.
//
// -----------------------------------------------------------------------------
// Reserved-label discipline
// -----------------------------------------------------------------------------
//
// The one internal label is prefixed `touch_` per the paideia-as
// reserved-word convention.

module Touch = structure {

  // Hardcoded M0 target path. Absolute + NUL-terminated.
  pub let touch_path : [u8; 7] = "/tmp/x\0"

  // Fingerprint strings -- routed through sys_debug_puts (SC+ ID 12).
  // Storage carries the trailing NUL; wire length excludes it. ASCII
  // "--" in place of an em-dash keeps the line 7-bit ASCII.
  pub let touch_msg_ok    : [u8; 25] = "touch ok -- path=/tmp/x\n\0"
  pub let touch_msg_ok_len : u64 = 24

  pub let touch_msg_fail    : [u8; 17] = "TOUCH OPEN FAIL\n\0"
  pub let touch_msg_fail_len : u64 = 16

  // -------------------------------------------------------------------------
  // _start -- user program entry point. Never returns.
  //
  // Effects/caps:
  //   mem     -- reads touch_path / touch_msg_* rodata.
  //   sysreg  -- every SYSCALL clobbers rcx (RIP)/r11 (rflags).
  //   fs      -- sys_open / sys_close.
  //   sched   -- sys_exit terminates the task.
  //
  // @no_frame because the function ends in sys_exit on every terminal
  // path (never returns).
  // -------------------------------------------------------------------------
  pub let _start : () -> () !{mem, sysreg} @{fs, sched} =
    fn () -> unsafe {
      effects: {mem, sysreg},
      capabilities: {fs, sched},
      justification: "R58.M5 (#1809) + R62.M1-005 (#1836): /bin/touch _start. Inlines sys_open (SC+ ID 2), sys_close (SC+ ID 3), sys_debug_puts (SC+ ID 12) and sys_exit (SC+ ID 60) -- same one-file-one-ELF pattern as true.pdx / cat.pdx / rm.pdx / mv.pdx / mkdir.pdx. #1836: Phase 0 reads argc (rdi) per the frozen execve ABI (design/user/execve-abi.md); when argc >= 2, r12 = argv[1] (`[rsi + 8]`, own-aspace pointer); when argc < 2, r12 = &touch_path ('/tmp/x'). No strlen is needed (unlike rm.pdx/mkdir.pdx): sys_open takes a bare NUL-terminated path with no explicit length argument. Sequence: (1) sys_open(r12, 0x41, 0x1A4) -- rdi = r12, rsi = 0x41 = O_CREAT|O_WRONLY (verbatim value rootfs_seed.pdx passes to sys_open for its own per-file seed writes, see rootfs_seed.pdx §104), rdx = 0x1A4 = 0644, rax = 2, syscall. rax < 0 (signed test via `cmp rax, 0; jl`, matching cat.pdx's own sys_open error gate) -> emit 'TOUCH OPEN FAIL\\n' via sys_debug_puts, sys_exit(1). Otherwise stash fd in rbx (callee-save; SYSCALL preserves it) and (2) sys_close(rbx) -- rdi = rbx, rax = 3, syscall; return value ignored per fd_close-of-live-fd's proven no-fail contract at R16.M3-005 (#591) once fd was minted by a matching sys_open. (3) emit 'touch ok -- path=/tmp/x\\n' via sys_debug_puts (unchanged literal text regardless of the real target -- see design/user/execve-abi.md §Migrated tools), sys_exit(0). @no_frame because every terminal path ends in sys_exit; entry rsp%16==0 per the PVH loader contract. Encoder-gap discipline: no `add reg, [mem]` / `sub reg, [mem]` anywhere. Reserved-label discipline: every label is prefixed `touch_`.",
      block: {
        // ============================================================
        // Phase 0 (#1836) -- resolve target path from argv[1], or fall
        // back to the M0 hardcoded /tmp/x default. No strlen needed:
        // sys_open takes a bare NUL-terminated path.
        // ============================================================
        cmp rdi, 2;
        jl  touch_use_default;
        mov r12, [rsi + 8];                   // r12 = argv[1] (own aspace, direct deref)
        jmp touch_path_ready;

      touch_use_default:
        lea r12, [rip + touch_path];

      touch_path_ready:
        // ============================================================
        // Phase 1 -- sys_open(r12, O_CREAT|O_WRONLY=0x41, mode=0x1A4)
        // ============================================================
        mov rdi, r12;
        mov rsi, 0x41;                        // O_CREAT|O_WRONLY
        mov rdx, 0x1A4;                        // mode 0644
        mov rax, 2;                            // SC+ ID 2 = sys_open
        syscall;

        cmp rax, 0;
        jl touch_fail;
        mov rbx, rax;                          // rbx = fd (callee-save)

        // ============================================================
        // Phase 2 -- sys_close(fd)
        // ============================================================
        mov rdi, rbx;                           // fd
        mov rax, 3;                             // SC+ ID 3 = sys_close
        syscall;

        // ============================================================
        // Phase 3 -- success: sys_debug_puts(touch_msg_ok, 24); sys_exit(0)
        // ============================================================
        lea rdi, [rip + touch_msg_ok];
        mov rsi, 24;                            // touch_msg_ok_len
        mov rax, 12;                            // SC+ ID 12 = sys_debug_puts
        syscall;

        xor rdi, rdi;                           // status = 0 (OK)
        mov rax, 60;                             // SC+ ID 60 = sys_exit
        syscall;
        hlt;

      touch_fail:
        // ============================================================
        // Phase 4 -- fail: sys_debug_puts(touch_msg_fail, 16); sys_exit(1)
        // ============================================================
        lea rdi, [rip + touch_msg_fail];
        mov rsi, 16;                             // touch_msg_fail_len
        mov rax, 12;                             // SC+ ID 12 = sys_debug_puts
        syscall;

        mov rdi, 1;                              // status = 1 (open failed)
        mov rax, 60;                             // SC+ ID 60 = sys_exit
        syscall;
        hlt
      }
    } @no_frame
}
