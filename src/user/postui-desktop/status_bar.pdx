// src/user/postui-desktop/status_bar.pdx -- R113.M6-028 (paideia-os #2408)
//
// Three status-bar widget slots: clock, battery, wifi. Rendered as a
// STATUS_BAR_HEIGHT_PX (24px) top bar (config.pdx) -- this file owns the
// three widgets' state and sampling cadence; the pixel blit itself rides
// the same Frame/scanline path terminal_widget.pdx uses and is not
// duplicated here.
//
// BATTERY: REAL CAPABILITY, NOT A NEW STUB KIND. The issue text for this
// wave asks for a new "KIND_POWER_SUPPLY" kernel stub returning a fixed
// placeholder. That would shadow capability infrastructure that ALREADY
// EXISTS and is ALREADY REAL: KIND_BATTERY (0x158, src/kernel/core/cap/
// kind_battery.pdx, landed R31.M3-001 #1099) is dispatched today
// (invoke.pdx `cmp rcx, 0x158`) with a working BATTERY_OP_QUERY_PERCENT
// (op=3) that reads a live row, not a hardcoded constant. Inventing a
// second, parallel, fake-valued "KIND_POWER_SUPPLY" alongside a real
// KIND_BATTERY would misrepresent the capability catalog's own invariant
// (every existing kind's header states plainly that it never fabricates a
// value -- see kind_battery.pdx's own "NO OP REACHABLE THROUGH THIS
// BRANCH CAN CHANGE A DESIGN CAPACITY..." framing) and would give a future
// reader two competing "the battery" capabilities to reconcile. This file
// therefore calls the real KIND_BATTERY op directly. What IS still a
// placeholder: STATUS_BAR_BATTERY_SLOT (config.pdx) is 0 until postui-
// desktop is a real spawned process a supervisor can hand a battery-read
// cap to (see config.pdx §SPAWN-TIME CAPABILITY GAP) -- status_bar_
// battery_percent falls back to STATUS_BAR_BATTERY_PLACEHOLDER_PCT (75,
// matching the wave's own placeholder example) ONLY while that slot is 0,
// and calls the real capability the moment it is not.
//
// WIFI: NO EQUIVALENT INFRASTRUCTURE EXISTS. A repo-wide grep at landing
// time (SSID, signal_dbm, rssi, signal_strength) turns up zero hits: no
// KIND_WIFI_* kind (0x178 KIND_WIFI_PHY, 0x179 KIND_WIFI_VIF, ...,
// kind.pdx) exposes a signal-quality or SSID query today. RING SEPARATION
// makes a same-tree kernel "stub function" unreachable from this file
// regardless: src/user/**/*.pdx and src/kernel/**/*.pdx are compiled and
// LINKED SEPARATELY by tools/build-user.sh / tools/build.sh into
// different binaries (a ring-3 ELF cannot call a ring-0 symbol directly;
// only a syscall crosses that boundary), so a kernel-side placeholder
// function is reachable from here ONLY once it is wired behind a real
// sysno + dispatch.pdx branch -- exactly the "driver work" this wave is
// explicitly scoped away from. See src/kernel/core/net/wifi_status_stub.pdx
// for the (intentionally inert, not dispatched) kernel-side placeholder
// this file's wifi widget mirrors; status_bar_wifi_signal_pct /
// status_bar_wifi_ssid below return the SAME fixed values LOCALLY, in
// userspace, with no syscall at all -- an honest same-process constant,
// not a capability call dressed up to look like one. Follow-up: allocate
// a KIND_NET_WIRELESS derived kind (kind.pdx / invoke.pdx) + a syscall
// wire, then delete this file's local placeholder in favour of a real
// sys_cap_invoke against it.

module StatusBar = structure {

  // ==========================================================================
  // Section 0  State.
  //
  // _sb_clock: [last_poll_ns, cached_ns]
  // ==========================================================================

  pub let mut _sb_clock : [u64; 2] = uninit @align(64)

  pub let STATUS_BAR_BATTERY_PLACEHOLDER_PCT : u64 = 75

  // BATTERY_OP_QUERY_PERCENT (kind_battery.pdx op=3). Duplicated as a
  // plain literal for the same ring-separation reason terminal_widget.pdx
  // duplicates the TTY op ordinals.
  pub let BATTERY_OP_QUERY_PERCENT : u64 = 3

  pub let status_bar_clock_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M6-028 (#2408): zero the two-word clock cell at boot. Labels prefixed sbci_.",
      block: {
        lea r10, [rip + _sb_clock];
        xor rax, rax;
        mov [r10 + 0], rax;
        mov [r10 + 8], rax;
        ret
      }
    }

  // ==========================================================================
  // Section 1  Clock widget: poll every STATUS_BAR_CLOCK_POLL_NS (config.pdx).
  //
  // status_bar_clock_tick() re-samples sys_clock_read_ns only if at least
  // STATUS_BAR_CLOCK_POLL_NS has elapsed since the last sample, and always
  // returns the currently-cached value (fresh or stale-by-less-than-the-
  // interval, both correct per the polling contract). Called from the
  // desktop main loop (entry.pdx) once per iteration; cheap when the
  // interval hasn't elapsed (one memory read, one compare, no syscall).
  // ==========================================================================

  pub let status_bar_clock_tick : () -> u64 !{mem, sysreg} @{} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "R113.M6-028 (#2408): r12 holds &_sb_clock across the single call to sys_clock_read_ns. Pushed/popped around the body -- sys_clock_read_ns's own body only clobbers rax/rcx/r11, but this function is itself called from a loop (entry.pdx pdx_desktop_main_loop) that may grow to hold state in r12 across it, so r12 is treated as callee-saved per SysV regardless of what today's callee happens to touch. Delta computed via sub (no `neg`, no `test`). Labels prefixed sbct_.",
      block: {
        push r12;
        lea r12, [rip + _sb_clock];
        call sys_clock_read_ns;
        mov r10, rax;                     // now_ns
        mov r11, [r12 + 0];               // last_poll_ns
        mov rax, r10;
        sub rax, r11;                     // delta = now - last (wraps harmlessly if now < last)
        cmp rax, 1000000;                 // STATUS_BAR_CLOCK_POLL_NS
        jb  sbct_stale_ok;
        mov [r12 + 0], r10;               // last_poll_ns = now
        mov [r12 + 8], r10;               // cached_ns = now
      sbct_stale_ok:
        mov rax, [r12 + 8];
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Section 2  Battery widget (see header §BATTERY).
  // ==========================================================================

  pub let status_bar_battery_percent : (u64) -> u64 !{sysreg} @{cap} =
    fn (battery_slot: u64) -> unsafe {
      effects: {sysreg}, capabilities: {cap},
      justification: "R113.M6-028 (#2408): battery_slot==0 (not granted at spawn, config.pdx convention) returns the placeholder 75; otherwise a real sys_cap_invoke(battery_slot, BATTERY_OP_QUERY_PERCENT=3) against the live KIND_BATTERY cap. Labels prefixed sbbp_.",
      block: {
        cmp rdi, 0;
        je  sbbp_placeholder;
        mov rsi, 3;                       // BATTERY_OP_QUERY_PERCENT
        call sys_cap_invoke;
        ret;
      sbbp_placeholder:
        mov rax, 75;                      // STATUS_BAR_BATTERY_PLACEHOLDER_PCT
        ret
      }
    }

  // ==========================================================================
  // Section 3  Wifi widget (see header §WIFI). Fixed userspace placeholder,
  // no syscall. Mirrors src/kernel/core/net/wifi_status_stub.pdx's values
  // exactly so the two stay in lockstep until the real wire lands.
  // ==========================================================================

  pub let status_bar_wifi_signal_pct : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R113.M6-028 (#2408): fixed placeholder, no syscall, no capability -- see file header §WIFI. Labels prefixed sbws_.",
      block: {
        mov rax, 60;
        ret
      }
    }

  pub let status_bar_wifi_ssid_len : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R113.M6-028 (#2408): length of status_bar_wifi_ssid_str (\"WEAK\\0\", 4 chars + NUL = 5 bytes, wire length excludes the NUL per this codebase's sys_debug_puts convention). Labels prefixed sbwl_.",
      block: {
        mov rax, 4;
        ret
      }
    }

  // Placeholder SSID text. "WEAK" per this wave's own stub example
  // (issue text: "wifi returns WEAK/60") -- not a real network name.
  pub let status_bar_wifi_ssid_str : [u8; 5] = "WEAK\0"

  pub let status_bar_wifi_ssid_ptr : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R113.M6-028 (#2408): return &status_bar_wifi_ssid_str for a caller that wants to blit it directly. Labels prefixed sbwp_.",
      block: {
        lea rax, [rip + status_bar_wifi_ssid_str];
        ret
      }
    }
}
