// src/user/postui-desktop/status_bar.pdx -- R113.M6-028 (paideia-os #2408)
//
// Three status-bar widget slots: clock, battery, wifi. Rendered as a
// STATUS_BAR_HEIGHT_PX (24px) top bar (config.pdx) -- this file owns the
// three widgets' state and sampling cadence; the pixel blit itself rides
// the same Frame/scanline path terminal_widget.pdx uses and is not
// duplicated here.
//
// BATTERY: REAL CAPABILITY, NOT A NEW STUB KIND. The issue text for this
// wave asks for a new "KIND_POWER_SUPPLY" kernel stub returning a fixed
// placeholder. That would shadow capability infrastructure that ALREADY
// EXISTS and is ALREADY REAL: KIND_BATTERY (0x158, src/kernel/core/cap/
// kind_battery.pdx, landed R31.M3-001 #1099) is dispatched today
// (invoke.pdx `cmp rcx, 0x158`) with a working BATTERY_OP_QUERY_PERCENT
// (op=3) that reads a live row, not a hardcoded constant. Inventing a
// second, parallel, fake-valued "KIND_POWER_SUPPLY" alongside a real
// KIND_BATTERY would misrepresent the capability catalog's own invariant
// (every existing kind's header states plainly that it never fabricates a
// value -- see kind_battery.pdx's own "NO OP REACHABLE THROUGH THIS
// BRANCH CAN CHANGE A DESIGN CAPACITY..." framing) and would give a future
// reader two competing "the battery" capabilities to reconcile. This file
// therefore calls the real KIND_BATTERY op directly. What IS still a
// placeholder: STATUS_BAR_BATTERY_SLOT (config.pdx) is 0 until postui-
// desktop is a real spawned process a supervisor can hand a battery-read
// cap to (see config.pdx §SPAWN-TIME CAPABILITY GAP) -- status_bar_
// battery_percent falls back to STATUS_BAR_BATTERY_PLACEHOLDER_PCT (75,
// matching the wave's own placeholder example) ONLY while that slot is 0,
// and calls the real capability the moment it is not.
//
// WIFI: NO EQUIVALENT INFRASTRUCTURE EXISTS. A repo-wide grep at landing
// time (SSID, signal_dbm, rssi, signal_strength) turns up zero hits: no
// KIND_WIFI_* kind (0x178 KIND_WIFI_PHY, 0x179 KIND_WIFI_VIF, ...,
// kind.pdx) exposes a signal-quality or SSID query today. RING SEPARATION
// makes a same-tree kernel "stub function" unreachable from this file
// regardless: src/user/**/*.pdx and src/kernel/**/*.pdx are compiled and
// LINKED SEPARATELY by tools/build-user.sh / tools/build.sh into
// different binaries (a ring-3 ELF cannot call a ring-0 symbol directly;
// only a syscall crosses that boundary), so a kernel-side placeholder
// function is reachable from here ONLY once it is wired behind a real
// sysno + dispatch.pdx branch -- exactly the "driver work" this wave is
// explicitly scoped away from. See src/kernel/core/net/wifi_status_stub.pdx
// for the (intentionally inert, not dispatched) kernel-side placeholder
// this file's wifi widget mirrors; status_bar_wifi_signal_pct /
// status_bar_wifi_ssid below return the SAME fixed values LOCALLY, in
// userspace, with no syscall at all -- an honest same-process constant,
// not a capability call dressed up to look like one. Follow-up: allocate
// a KIND_NET_WIRELESS derived kind (kind.pdx / invoke.pdx) + a syscall
// wire, then delete this file's local placeholder in favour of a real
// sys_cap_invoke against it.

module StatusBar = structure {

  // ==========================================================================
  // Section 0  State.
  //
  // _sb_clock: [last_poll_ns, cached_ns]
  // ==========================================================================

  pub let mut _sb_clock : [u64; 2] = uninit @align(64)

  pub let STATUS_BAR_BATTERY_PLACEHOLDER_PCT : u64 = 75

  // BATTERY_OP_QUERY_PERCENT (kind_battery.pdx op=3). Duplicated as a
  // plain literal for the same ring-separation reason terminal_widget.pdx
  // duplicates the TTY op ordinals.
  pub let BATTERY_OP_QUERY_PERCENT : u64 = 3

  pub let status_bar_clock_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M6-028 (#2408): zero the two-word clock cell at boot. Labels prefixed sbci_.",
      block: {
        lea r10, [rip + _sb_clock];
        xor rax, rax;
        mov [r10 + 0], rax;
        mov [r10 + 8], rax;
        ret
      }
    }

  // ==========================================================================
  // Section 1  Clock widget: poll every STATUS_BAR_CLOCK_POLL_NS (config.pdx).
  //
  // status_bar_clock_tick() re-samples sys_clock_read_ns only if at least
  // STATUS_BAR_CLOCK_POLL_NS has elapsed since the last sample, and always
  // returns the currently-cached value (fresh or stale-by-less-than-the-
  // interval, both correct per the polling contract). Called from the
  // desktop main loop (entry.pdx) once per iteration; cheap when the
  // interval hasn't elapsed (one memory read, one compare, no syscall).
  // ==========================================================================

  pub let status_bar_clock_tick : () -> u64 !{mem, sysreg} @{} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "R113.M6-028 (#2408): r12 holds &_sb_clock across the single call to sys_clock_read_ns. Pushed/popped around the body -- sys_clock_read_ns's own body only clobbers rax/rcx/r11, but this function is itself called from a loop (entry.pdx pdx_desktop_main_loop) that may grow to hold state in r12 across it, so r12 is treated as callee-saved per SysV regardless of what today's callee happens to touch. Delta computed via sub (no `neg`, no `test`). Labels prefixed sbct_.",
      block: {
        push r12;
        lea r12, [rip + _sb_clock];
        call sys_clock_read_ns;
        mov r10, rax;                     // now_ns
        mov r11, [r12 + 0];               // last_poll_ns
        mov rax, r10;
        sub rax, r11;                     // delta = now - last (wraps harmlessly if now < last)
        cmp rax, 1000000;                 // STATUS_BAR_CLOCK_POLL_NS
        jb  sbct_stale_ok;
        mov [r12 + 0], r10;               // last_poll_ns = now
        mov [r12 + 8], r10;               // cached_ns = now
      sbct_stale_ok:
        mov rax, [r12 + 8];
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Section 2  Battery widget (see header §BATTERY).
  // ==========================================================================

  pub let status_bar_battery_percent : (u64) -> u64 !{sysreg} @{cap} =
    fn (battery_slot: u64) -> unsafe {
      effects: {sysreg}, capabilities: {cap},
      justification: "R113.M6-028 (#2408): battery_slot==0 (not granted at spawn, config.pdx convention) returns the placeholder 75; otherwise a real sys_cap_invoke(battery_slot, BATTERY_OP_QUERY_PERCENT=3) against the live KIND_BATTERY cap. Labels prefixed sbbp_.",
      block: {
        cmp rdi, 0;
        je  sbbp_placeholder;
        mov rsi, 3;                       // BATTERY_OP_QUERY_PERCENT
        call sys_cap_invoke;
        ret;
      sbbp_placeholder:
        mov rax, 75;                      // STATUS_BAR_BATTERY_PLACEHOLDER_PCT
        ret
      }
    }

  // ==========================================================================
  // Section 3  Wifi widget (see header §WIFI). Fixed userspace placeholder,
  // no syscall. Mirrors src/kernel/core/net/wifi_status_stub.pdx's values
  // exactly so the two stay in lockstep until the real wire lands.
  // ==========================================================================

  pub let status_bar_wifi_signal_pct : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R113.M6-028 (#2408): fixed placeholder, no syscall, no capability -- see file header §WIFI. Labels prefixed sbws_.",
      block: {
        mov rax, 60;
        ret
      }
    }

  pub let status_bar_wifi_ssid_len : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R113.M6-028 (#2408): length of status_bar_wifi_ssid_str (\"WEAK\\0\", 4 chars + NUL = 5 bytes, wire length excludes the NUL per this codebase's sys_debug_puts convention). Labels prefixed sbwl_.",
      block: {
        mov rax, 4;
        ret
      }
    }

  // Placeholder SSID text. "WEAK" per this wave's own stub example
  // (issue text: "wifi returns WEAK/60") -- not a real network name.
  pub let status_bar_wifi_ssid_str : [u8; 5] = "WEAK\0"

  pub let status_bar_wifi_ssid_ptr : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R113.M6-028 (#2408): return &status_bar_wifi_ssid_str for a caller that wants to blit it directly. Labels prefixed sbwp_.",
      block: {
        lea rax, [rip + status_bar_wifi_ssid_str];
        ret
      }
    }

  // ==========================================================================
  // Section 4  KIND_A11Y_NODE a11y annotations for status-bar widgets
  // (Wave ζ ζ-01 — KIND_A11Y_NODE consumer landing).
  //
  // The three status-bar widgets (clock/battery/wifi) each carry a
  // KIND_A11Y_NODE cap-slot cell in _status_bar_a11y_nodes and a
  // static ROLE + label string. When a real user-side mint syscall
  // lands (see below), status_bar_a11y_init walks the three cells and
  // mints one KIND_A11Y_NODE per widget with role=STATUS_BAR_A11Y_ROLE
  // and label_ptr/label_len naming its label string. Each returned cap
  // slot is cached back into the array so downstream consumers (a
  // future screen-reader-facing query, or an audit trail) can invoke
  // ANODE_OP_QUERY_ROLE / QUERY_LABEL_PTR / QUERY_LABEL_LEN against
  // it directly.
  //
  // TWO SCAFFOLD GAPS THIS FILE CANNOT CLOSE ITSELF, DOCUMENTED HERE
  // AND IN design/a11y/a11y-node-consumer-guide.md:
  //
  //   (1) NO USERSPACE MINT SYSCALL EXISTS TODAY. a11y_node_cap_mint
  //       (src/kernel/core/cap/kind_a11y_node.pdx §a11y_node_cap_mint,
  //       ordinal 0x1E6) is a direct kernel function, not reachable
  //       through sys_cap_invoke: the design doc §"Why mint is not
  //       reached through cap_invoke" explains why (four independent
  //       u64 args, no bit-packing fits them into one op_arg). A
  //       future sys_a11y_node_mint (akin to sys_volume_mint.pdx's
  //       shape) will marshal (parent, role, label_ptr, label_len)
  //       into that direct kernel call; until it lands,
  //       status_bar_a11y_init can only ZERO the cap-slot cells
  //       defensively -- a11y_node_cap_mint always returns a
  //       nonzero cap_table slot on success, so cell value 0 is the
  //       unambiguous "not yet minted" sentinel.
  //
  //   (2) a11y_bind_at_mint IS FOR WINDOWS, NOT WIDGETS.
  //       src/user/compositor/a11y_bind_at_mint.pdx's
  //       a11y_bind_at_mint_wrap signature is (window_id,
  //       parent_surface, parent_window, z_order, tab_workspace_pack,
  //       a11y_tree_kind_id) -> row_id -- verbatim mirroring
  //       window_mint's six-arg shape. That gate enforces the P4
  //       invariant "every KIND_WINDOW row carries a KIND_A11Y_TREE
  //       reference at mint time"; it has no per-widget contract
  //       (status-bar widgets are NOT KIND_WINDOW citizens; they are
  //       internal state in this file). This wave's dispatch note
  //       assumed a `bind(widget_kind_id, a11y_node_id) -> u64`
  //       signature that does not exist -- documented as a signature
  //       divergence in the wave report.
  //
  // ROLE CHOICE. src/user/a11y/kind_a11y_node.pdx enumerates 40 role
  // ordinals (0..39); there is no ROLE_STATUS today. ROLE_LABEL (5) is
  // the closest match for a read-only, non-interactive status-bar
  // readout (clock/battery/wifi text). A follow-on landing that
  // extends the role taxonomy with ROLE_STATUS = 40 (and bumps
  // ROLE_MAX to 40 in both src/user/a11y/kind_a11y_node.pdx and
  // src/kernel/core/cap/kind_a11y_node.pdx §ANODE_ROLE_MAX) would
  // repoint STATUS_BAR_A11Y_ROLE at that new ordinal in one line.
  //
  // WIRING INTO pdx_desktop_init. Deliberately NOT wired here into
  // entry.pdx's pdx_desktop_init sequence (which has a fixed 3-slot
  // _desktop_init_state and a specific register plan around r12) --
  // that call is added when postui-desktop grows a real spawned
  // process path (see config.pdx §SPAWN-TIME CAPABILITY GAP). At
  // that landing, entry.pdx grows a fourth init step calling
  // status_bar_a11y_init between the terminal-widget-init and clock-
  // init lines it already carries.
  // ==========================================================================

  pub let mut _status_bar_a11y_nodes : [u64; 3] = uninit @align(64)

  // ROLE_LABEL from src/user/a11y/kind_a11y_node.pdx (ordinal 5).
  pub let STATUS_BAR_A11Y_ROLE : u64 = 5

  pub let STATUS_BAR_A11Y_IDX_CLOCK   : u64 = 0
  pub let STATUS_BAR_A11Y_IDX_BATTERY : u64 = 1
  pub let STATUS_BAR_A11Y_IDX_WIFI    : u64 = 2

  // Static label strings (NUL-terminated for eventual sys_debug_puts
  // parity; label_len below reports the payload byte count, excluding
  // the NUL, matching status_bar_wifi_ssid_len's convention above).
  pub let status_bar_a11y_label_clock   : [u8; 6]  = "CLOCK\0"
  pub let status_bar_a11y_label_battery : [u8; 8]  = "BATTERY\0"
  pub let status_bar_a11y_label_wifi    : [u8; 5]  = "WIFI\0"

  // Corresponding label payload lengths (excluding the NUL, mirroring
  // status_bar_wifi_ssid_len's contract in Section 3).
  pub let STATUS_BAR_A11Y_LABEL_LEN_CLOCK   : u64 = 5
  pub let STATUS_BAR_A11Y_LABEL_LEN_BATTERY : u64 = 7
  pub let STATUS_BAR_A11Y_LABEL_LEN_WIFI    : u64 = 4

  pub let status_bar_a11y_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave ζ ζ-01: zero the three cap-slot cells (0 == 'not yet minted' -- a11y_node_cap_mint returns a nonzero cap_table slot on success, so 0 is unambiguous). Real mint is deferred until sys_a11y_node_mint lands (see file header §SCAFFOLD GAP 1). Three plain qword stores at [r10+0/8/16], no loop needed. Labels prefixed sba_i_.",
      block: {
        lea r10, [rip + _status_bar_a11y_nodes];
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        ret
      }
    }

  // status_bar_a11y_node_slot(idx) -> cap slot cached at
  // _status_bar_a11y_nodes[idx], or 0 for idx >= 3.
  pub let status_bar_a11y_node_slot : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave ζ ζ-01: bounds-checked read of _status_bar_a11y_nodes[idx]. Slot value 0 means 'not yet minted' per file header. Labels prefixed sba_ns_.",
      block: {
        cmp rdi, 3;
        jae sba_ns_bad;
        lea r10, [rip + _status_bar_a11y_nodes];
        mov rax, [r10 + rdi * 8];
        ret;
      sba_ns_bad:
        xor rax, rax;
        ret
      }
    }

  // status_bar_a11y_label_ptr(idx) -> &label_string for idx in {0,1,2},
  // else 0.
  pub let status_bar_a11y_label_ptr : (u64) -> u64 !{} @{} =
    fn (idx: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave ζ ζ-01: idx -> label-string pointer (idx 0/1/2 -> clock/battery/wifi). Labels prefixed sba_lp_.",
      block: {
        cmp rdi, 0;
        je  sba_lp_clock;
        cmp rdi, 1;
        je  sba_lp_battery;
        cmp rdi, 2;
        je  sba_lp_wifi;
        xor rax, rax;
        ret;
      sba_lp_clock:
        lea rax, [rip + status_bar_a11y_label_clock];
        ret;
      sba_lp_battery:
        lea rax, [rip + status_bar_a11y_label_battery];
        ret;
      sba_lp_wifi:
        lea rax, [rip + status_bar_a11y_label_wifi];
        ret
      }
    }

  // status_bar_a11y_label_len(idx) -> payload byte count of the label
  // named by status_bar_a11y_label_ptr(idx), or 0 for a bad idx.
  pub let status_bar_a11y_label_len : (u64) -> u64 !{} @{} =
    fn (idx: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave ζ ζ-01: idx -> label payload length (excluding NUL). Mirrors status_bar_wifi_ssid_len's convention. Labels prefixed sba_ll_.",
      block: {
        cmp rdi, 0;
        je  sba_ll_clock;
        cmp rdi, 1;
        je  sba_ll_battery;
        cmp rdi, 2;
        je  sba_ll_wifi;
        xor rax, rax;
        ret;
      sba_ll_clock:
        mov rax, 5;
        ret;
      sba_ll_battery:
        mov rax, 7;
        ret;
      sba_ll_wifi:
        mov rax, 4;
        ret
      }
    }
}
