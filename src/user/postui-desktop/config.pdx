// src/user/postui-desktop/config.pdx -- R113.M6-027 (paideia-os #2407)
//
// Static configuration for the postui-desktop shell: identity, geometry,
// and the handful of well-known slot numbers the shell reads today as
// placeholders pending real process-spawn capability delivery.
//
// WHY THIS FILE HAS NO ASM. Every constant here is a `pub let NAME : u64 =
// <literal>` binding -- data, not code -- so none of it needs an unsafe
// block. Consumers (entry.pdx, status_bar.pdx, terminal_widget.pdx,
// launcher.pdx, surface_wire.pdx) reference these by name rather than
// re-typing literals, matching the layout-constant style
// libpaideia_ui/widgets.pdx uses for WIDGETS_RECT_OFF_*.
//
// SPAWN-TIME CAPABILITY GAP (read this before touching STATUS_BAR_*_SLOT
// or DESKTOP_SURFACE_SLOT below). postui-desktop is not yet a process the
// kernel or init spawns with capabilities pre-populated in its CSpace --
// build-user.sh does not link it into any binary today (see the
// postui-desktop/* exclusion branch added alongside this file). The slot
// numbers below are therefore PLACEHOLDERS: once a real desktop-shell
// spawn path lands (init hands the new process a KIND_SURFACE sub-cap for
// its terminal Frame and, if granted, a KIND_BATTERY read cap for the
// status bar), these constants become "the slot init is contractually
// obligated to populate" rather than "a guess". Every call site that
// reads one is commented at the call site, not just here.

module Config = structure {

  // ==========================================================================
  // Section 0  Identity.
  // ==========================================================================

  // app_id passed to compositor_register_client (client_registry.pdx).
  // Opaque to the registry; chosen here as a small non-zero constant
  // distinct from every other app_id this landing is aware of (none exist
  // yet -- postui-desktop is the first compositor client this tree
  // defines).
  pub let DESKTOP_APP_ID : u64 = 1

  // Capability bitmask passed alongside DESKTOP_APP_ID. Uninterpreted by
  // client_registry.pdx today (see its header); the two bits below record
  // this landing's OWN policy intent -- "this client wants a terminal
  // surface and status-bar peripheral reads" -- so a future consumer of
  // compositor_client_caps has a real value to branch on rather than an
  // arbitrary placeholder.
  pub let DESKTOP_CAP_SURFACE : u64 = 0x1
  pub let DESKTOP_CAP_STATUS_PERIPHERALS : u64 = 0x2
  pub let DESKTOP_CAPS : u64 = 0x3   // DESKTOP_CAP_SURFACE | DESKTOP_CAP_STATUS_PERIPHERALS

  // ==========================================================================
  // Section 1  Geometry.
  // ==========================================================================

  pub let STATUS_BAR_HEIGHT_PX : u64 = 24

  // Terminal widget occupies the full width below the status bar. Height
  // is a placeholder screen height (1080) minus the status bar; a real
  // layout pass reads the actual output mode via KIND_DISPLAY_MODE
  // (src/kernel/core/cap/kind.pdx 0x172) once the desktop owns a display
  // output -- out of scope for this UI-shell landing.
  pub let TERMINAL_WIDGET_X : u64 = 0
  pub let TERMINAL_WIDGET_Y : u64 = 24        // = STATUS_BAR_HEIGHT_PX
  pub let TERMINAL_WIDGET_W : u64 = 1920
  pub let TERMINAL_WIDGET_H : u64 = 1056      // 1080 - 24

  // Launcher grid: 3 fixed slots, evenly spaced, 96px square icons.
  pub let LAUNCHER_SLOT_COUNT : u64 = 3
  pub let LAUNCHER_ICON_SIZE_PX : u64 = 96
  pub let LAUNCHER_ICON_GAP_PX  : u64 = 32
  pub let LAUNCHER_ORIGIN_X : u64 = 64
  pub let LAUNCHER_ORIGIN_Y : u64 = 96         // below the status bar

  // ==========================================================================
  // Section 2  Placeholder capability slots (see header §SPAWN-TIME GAP).
  // ==========================================================================

  // Cap-table slot this process will invoke for its terminal Frame's
  // KIND_SURFACE authority. 0 is deliberately NOT a valid placeholder --
  // slot 0 is the process's own KIND_PROCESS cap by kernel convention
  // (cap_invoke_dispatch's kind==1 arm) -- so surface_wire.pdx's gate
  // treats 0 as "not yet granted" and refuses cleanly instead of invoking
  // a cap that happens to exist but means something else entirely.
  pub let DESKTOP_SURFACE_SLOT : u64 = 0

  // Cap-table slot for a KIND_BATTERY (src/kernel/core/cap/kind_battery.pdx,
  // 0x158) read cap, if the supervisor grants one at spawn. Same
  // "0 == not granted" convention as DESKTOP_SURFACE_SLOT.
  pub let STATUS_BAR_BATTERY_SLOT : u64 = 0

  // Cap-table slot for a KIND_TTY (src/kernel/core/cap/kind_tty.pdx,
  // 0x197) sink cap for the terminal widget's stdin/stdout. Same
  // "0 == not granted" convention as DESKTOP_SURFACE_SLOT; terminal_
  // widget_init refuses cleanly on 0 rather than invoking a slot that
  // happens to exist but names something else.
  pub let TERMINAL_WIDGET_TTY_SLOT : u64 = 0

  // ==========================================================================
  // Section 3  Status-bar polling cadence.
  // ==========================================================================

  // status_bar_tick re-samples the clock widget once every this many
  // nanoseconds of sys_clock_read_ns delta, per #2408's "polled every 1000
  // ticks" -- this codebase's monotonic clock reads nanoseconds
  // (clock_read_ns.pdx), not a hardware "tick" counter, so the interval is
  // expressed in the unit that syscall actually returns: 1000 * 1000 ns =
  // 1 ms. A future landing that exposes a real jiffies-style tick counter
  // can re-express this constant in that unit without touching call sites.
  pub let STATUS_BAR_CLOCK_POLL_NS : u64 = 1000000
}
