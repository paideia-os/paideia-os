// src/user/postui-desktop/surface_wire.pdx -- R113.M6-030 (paideia-os #2411
// in the issue text; landed here as #2410 per the wave dispatch -- see
// module header note below)
//
// postui-desktop's end-to-end capability-plumbing check: before the
// terminal widget's Frame is allowed to draw, this file invokes the
// KIND_SURFACE capability the desktop was (or was not) handed at spawn,
// directly via sys_cap_invoke, and gates on whether that invocation comes
// back as a live surface row rather than an invoke-level or surface-level
// failure sentinel.
//
// WHY OP_SURFACE_QUERY (op_arg = 0). cap_handler_surface's dispatch table
// (src/kernel/core/cap/handlers/cap_handler_surface.pdx §OP_SURFACE_*) is
// reached via the SAME generic sys_cap_invoke(slot, op_arg) syscall every
// other capability kind uses (src/user/syscall_shim.pdx sys_cap_invoke,
// SC+ ID 4) -- op_arg IS the op ordinal directly at this landing
// (cap_invoke_dispatch's call_kind_surface arm, R113.M1-001b). OP_SURFACE_
// QUERY = 0 is the read-only op (KGATE_QUERY = READ | QUERY_GEOMETRY,
// 0x021) -- the cheapest possible probe that proves the slot names a live
// KIND_SURFACE row without mutating anything, which is exactly what a
// presence gate needs. OP_SURFACE_COMMIT/DAMAGE/ATTACH/DESTROY/MINT would
// either mutate compositor state the gate has no business touching, or
// (MINT) manufacture a NEW surface rather than confirm an existing one.
//
// FAILURE DISCRIMINATION. At this landing, cap_invoke_dispatch's
// call_kind_surface arm always sets arg2 (the query-selector) to 0 (R113.
// M1-001b -- "arg2/arg3 are zero" until M1-002 refines op_arg into a
// packed encoding), so OP_SURFACE_QUERY through sys_cap_invoke always
// resolves to sh_q_dims -> surface_row_dims_get(slot). That accessor's
// OWN contract (kind_surface.pdx) is "0 for any out-of-range or dead-row
// slot, else the real packed wh_packed field" -- it does not raise a
// distinct sentinel for a bad slot the way REPORT-style ops do. Two
// further sentinels CAN reach this call site before surface_row_dims_get
// ever runs: INVOKE_RESULT_INVALID_HANDLE (0xFFFFFFFFFFFFFFFE, slot >= 256
// or an empty/never-minted/revoked descriptor -- src/kernel/core/cap/
// invoke.pdx) and INVOKE_DENIED (0xFFFFFFFFFFFFFFFD, a live cap whose
// rights lack R_SURFACE_KGATE_QUERY). desktop_surface_gate therefore
// refuses on exactly three outcomes: result == 0 (dead row or a
// degenerate 0x0 surface -- accepted as a false-negative risk this
// UI-shell gate can live with, since a real terminal Frame is never
// minted at 0x0), result == INVOKE_RESULT_INVALID_HANDLE, or result ==
// INVOKE_DENIED. Both sentinels are compared via a MOV-then-CMP-reg,reg
// pair rather than `cmp rax, 0xFFFFFFFFFFFFFFFE` directly -- CMP's
// immediate form is limited to a sign-extended imm32, so a bare 64-bit
// literal on the CMP itself would silently compare against the wrong
// value (this is the exact class of encoder trap
// feedback_pdx_encoder_pitfalls.md warns about, one level more subtle
// than the documented ones: it is not a REJECTED encoding, it is an
// accepted one that assembles to a different comparison than intended).
//
// SCOPE NOTE. This is the presence/plumbing GATE only -- it does not read
// back geometry or wire a real draw. terminal_widget.pdx's Frame-to-rect
// blit (R113.M6-031, #2411) calls desktop_surface_gate before it starts
// swapping buffers, and refuses to run (falls back to an inert widget) if
// the gate refuses.

module SurfaceWire = structure {

  pub let SURFACE_WIRE_OK      : u64 = 0
  pub let SURFACE_WIRE_REFUSED : u64 = 0xFFFFE190

  // desktop_surface_gate(slot) -> SURFACE_WIRE_OK (0) if invoking
  // OP_SURFACE_QUERY (op_arg=0) against `slot` comes back as a plausible
  // surface-row result; SURFACE_WIRE_REFUSED otherwise. slot == 0 is
  // refused up front without a syscall -- config.pdx's DESKTOP_SURFACE_
  // SLOT convention reserves 0 for "not granted at spawn" (0 is the
  // process's own KIND_PROCESS cap, never a surface).
  pub let desktop_surface_gate : (u64) -> u64 !{sysreg} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {sysreg}, capabilities: {cap},
      justification: "R113.M6-030 (#2410): gate on sys_cap_invoke(slot, OP_SURFACE_QUERY=0). rdi already holds slot per SysV; op_arg=0 loaded into rsi before the call. Zero callee-save pushes -- single nested call with no locals live across it, so the standard entry-state alignment (matches every other single-call trampoline in syscall_shim.pdx / builtins.pdx dispatch_cap) applies unchanged. Refusal test per the header's §FAILURE DISCRIMINATION: result == 0, or result == INVOKE_RESULT_INVALID_HANDLE, or result == INVOKE_DENIED -- the latter two compared via mov-into-r10 then cmp reg,reg (never `cmp rax, <64-bit literal>`, which would truncate/sign-extend through CMP's imm32 encoding). Labels prefixed dsg_.",
      block: {
        cmp rdi, 0;
        je  dsg_refused;
        mov rsi, 0;                      // OP_SURFACE_QUERY
        call sys_cap_invoke;
        cmp rax, 0;
        je  dsg_refused;
        mov r10, 0xFFFFFFFFFFFFFFFE;     // INVOKE_RESULT_INVALID_HANDLE
        cmp rax, r10;
        je  dsg_refused;
        mov r10, 0xFFFFFFFFFFFFFFFD;     // INVOKE_DENIED
        cmp rax, r10;
        je  dsg_refused;
        xor rax, rax;                    // SURFACE_WIRE_OK
        ret;
      dsg_refused:
        mov rax, 0xFFFFE190;             // SURFACE_WIRE_REFUSED
        ret
      }
    }
}
