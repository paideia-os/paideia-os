// src/user/postui-desktop/launcher.pdx -- R113.M6-029 (paideia-os #2409)
//
// Application launcher: a hardcoded 3-slot grid ("term" / "files" /
// "browser" placeholders, per the issue's own stub-is-OK scope), and the
// postui_desktop_launch(app_id) message shape a click sends to the
// desktop's exec dispatcher.
//
// MANIFEST SCANNING DEFERRED. #2409 describes reading /system/apps/
// *.desktop-like manifests as the eventual source of the grid; no such
// directory convention or parser exists anywhere in this tree today, and
// building one is explicitly out of scope for a wave scoped to the
// desktop-shell UI layer ("Stub OK: even a hardcoded 3-slot grid... is
// acceptable" -- issue text verbatim). LAUNCHER_SLOT_COUNT (config.pdx)
// = 3 and the three (app_id, path) rows below ARE that hardcoded grid.
//
// postui_desktop_launch AS AN IPC MESSAGE SHAPE. Struct LaunchMsg below
// documents the wire shape a real cross-process send will carry once
// postui-desktop and its exec-dispatcher owner are split into separate
// scheduled processes (today they are not -- see client_registry.pdx's
// own "not yet wired to a real IPC endpoint" note, which applies
// identically here: build-user.sh does not link postui-desktop/* into any
// binary yet, so there is exactly one address space in play and
// launcher_click calling postui_desktop_launch is a same-process function
// call, not yet a KIND_IPC_ENDPOINT OP_SEND). The struct is declared now
// so the eventual IPC marshaller has an agreed field layout to serialize
// rather than inventing one at that landing.
//
// EXEC DISPATCH. postui_desktop_exec_dispatch forks (sys_fork) and, in
// the child, sys_execve's the resolved /bin/<app_id> path -- the same
// fork-then-execve shape src/user/init.pdx's own child-spawn path uses
// (init.pdx init_child: label). None of the three placeholder binaries
// (/bin/term, /bin/files, /bin/browser) exist in any built image today;
// sys_execve returning is therefore the expected outcome of a click at
// this landing (-ENOENT), not a bug -- exactly as authorized by the
// issue's stub scope.

module Launcher = structure {

  // ==========================================================================
  // Section 0  Failure taxonomy (0xFFFFE160..0xFFFFE16F).
  // ==========================================================================

  pub let LAUNCHER_OK       : u64 = 0
  pub let LAUNCHER_BAD_SLOT : u64 = 0xFFFFE160

  // ==========================================================================
  // Section 1  LaunchMsg wire shape (documentation; see header).
  //
  //   [+0] app_id : u64
  //
  // One field today. A real IPC send will prepend a header (sender pid,
  // schema tag) the way sys_semantic_send's fixed-schema ring does
  // (src/kernel/core/syscall/handlers/sys_semantic_send.pdx) -- deferred
  // to that landing, not guessed at here.
  // ==========================================================================

  struct LaunchMsg {
    app_id: u64
  }

  // ==========================================================================
  // Section 2  The 3-slot grid.
  // ==========================================================================

  pub let LAUNCHER_APP_TERM    : u64 = 1
  pub let LAUNCHER_APP_FILES   : u64 = 2
  pub let LAUNCHER_APP_BROWSER : u64 = 3

  pub let launcher_label_term    : [u8; 5]  = "term\0"
  pub let launcher_label_files   : [u8; 6]  = "files\0"
  pub let launcher_label_browser : [u8; 8]  = "browser\0"

  pub let launcher_path_term    : [u8; 10] = "/bin/term\0"
  pub let launcher_path_files   : [u8; 11] = "/bin/files\0"
  pub let launcher_path_browser : [u8; 13] = "/bin/browser\0"

  // launcher_slot_app_id(index) -> app_id for grid index 0..2, or
  // LAUNCHER_BAD_SLOT for anything else.
  pub let launcher_slot_app_id : (u64) -> u64 !{} @{} =
    fn (index: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R113.M6-029 (#2409): 3-way small-imm cmp chain, index -> app_id. Labels prefixed lsa_.",
      block: {
        cmp rdi, 0;
        je  lsa_term;
        cmp rdi, 1;
        je  lsa_files;
        cmp rdi, 2;
        je  lsa_browser;
        mov rax, 0xFFFFE160;             // LAUNCHER_BAD_SLOT
        ret;
      lsa_term:
        mov rax, 1;                      // LAUNCHER_APP_TERM
        ret;
      lsa_files:
        mov rax, 2;                      // LAUNCHER_APP_FILES
        ret;
      lsa_browser:
        mov rax, 3;                      // LAUNCHER_APP_BROWSER
        ret
      }
    }

  // launcher_slot_label_ptr(index) -> &label string, or 0 for a bad slot.
  pub let launcher_slot_label_ptr : (u64) -> u64 !{} @{} =
    fn (index: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R113.M6-029 (#2409): index -> label pointer. Labels prefixed lsl_.",
      block: {
        cmp rdi, 0;
        je  lsl_term;
        cmp rdi, 1;
        je  lsl_files;
        cmp rdi, 2;
        je  lsl_browser;
        xor rax, rax;
        ret;
      lsl_term:
        lea rax, [rip + launcher_label_term];
        ret;
      lsl_files:
        lea rax, [rip + launcher_label_files];
        ret;
      lsl_browser:
        lea rax, [rip + launcher_label_browser];
        ret
      }
    }

  // launcher_app_path_ptr(app_id) -> &path string, or 0 if app_id is
  // unrecognized.
  pub let launcher_app_path_ptr : (u64) -> u64 !{} @{} =
    fn (app_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R113.M6-029 (#2409): app_id -> exec path pointer. Labels prefixed lap_.",
      block: {
        cmp rdi, 1;
        je  lap_term;
        cmp rdi, 2;
        je  lap_files;
        cmp rdi, 3;
        je  lap_browser;
        xor rax, rax;
        ret;
      lap_term:
        lea rax, [rip + launcher_path_term];
        ret;
      lap_files:
        lea rax, [rip + launcher_path_files];
        ret;
      lap_browser:
        lea rax, [rip + launcher_path_browser];
        ret
      }
    }

  // ==========================================================================
  // Section 3  Exec dispatch.
  // ==========================================================================

  // postui_desktop_exec_dispatch(path_ptr) -> child_pid (parent) | never
  // returns on execve success (child) | negative errno (child, execve
  // failed -- expected today per header §EXEC DISPATCH).
  pub let postui_desktop_exec_dispatch : (u64) -> u64 !{mem, sysreg} @{sched, mem} =
    fn (path_ptr: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {sched, mem},
      justification: "R113.M6-029 (#2409): fork-then-execve, mirroring src/user/init.pdx's init_child: shape. r12 holds path_ptr across the call to sys_fork. Pushed/popped around the body -- r12 is callee-saved per SysV and this function's own caller (postui_desktop_launch) does not currently hold anything live in r12, but the push/pop keeps that true regardless of future callers. Labels prefixed pdxd_.",
      block: {
        push r12;
        mov r12, rdi;
        call sys_fork;
        cmp rax, 0;
        jne pdxd_parent;
        mov rdi, r12;
        xor rsi, rsi;                    // argv = NULL
        xor rdx, rdx;                    // envp = NULL
        call sys_execve;
        pop r12;
        ret;                             // reached only if execve failed
      pdxd_parent:
        pop r12;
        ret                              // rax = child_pid
      }
    }

  // postui_desktop_launch(app_id) -> LAUNCHER_OK if app_id resolves and
  // exec dispatch was attempted, else LAUNCHER_BAD_SLOT.
  pub let postui_desktop_launch : (u64) -> u64 !{mem, sysreg} @{sched, mem} =
    fn (app_id: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {sched, mem},
      justification: "R113.M6-029 (#2409): resolve app_id to a path via launcher_app_path_ptr (leaf, no register clobber beyond rax), then dispatch. Labels prefixed pdl_.",
      block: {
        call launcher_app_path_ptr;      // rdi already = app_id
        cmp rax, 0;
        je  pdl_bad_slot;
        mov rdi, rax;
        call postui_desktop_exec_dispatch;
        xor rax, rax;                    // LAUNCHER_OK
        ret;
      pdl_bad_slot:
        mov rax, 0xFFFFE160;             // LAUNCHER_BAD_SLOT
        ret
      }
    }

  // launcher_click(index) -> forwards to postui_desktop_launch via
  // launcher_slot_app_id. This is the click handler entry point a
  // pointer-routing widget call (once G12.M1-003 lands) would invoke.
  pub let launcher_click : (u64) -> u64 !{mem, sysreg} @{sched, mem} =
    fn (index: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {sched, mem},
      justification: "R113.M6-029 (#2409): index -> app_id -> launch. Labels prefixed lc_.",
      block: {
        call launcher_slot_app_id;       // rdi already = index
        mov r10, 0xFFFFE160;             // LAUNCHER_BAD_SLOT
        cmp rax, r10;
        je  lc_bad_slot;
        mov rdi, rax;
        call postui_desktop_launch;
        ret;
      lc_bad_slot:
        mov rax, 0xFFFFE160;
        ret
      }
    }

  // ==========================================================================
  // Section 4  KIND_A11Y_NODE a11y annotations for launcher slots
  // (Wave ζ ζ-02 — KIND_A11Y_NODE consumer landing).
  //
  // Each of the three launcher slots (term / files / browser) carries
  // a KIND_A11Y_NODE cap-slot cell in _launcher_a11y_nodes and reuses
  // the existing launcher_label_{term,files,browser} strings above as
  // its label payload (no per-a11y label duplication — one truth for
  // "the launcher slot is named 'files'"). launcher_a11y_init walks
  // the three cells and, once a userspace mint syscall exists, mints
  // one KIND_A11Y_NODE per slot with role=LAUNCHER_A11Y_ROLE and
  // label pointing at the existing launcher_label_* string. Each
  // returned cap slot is cached back into the array so a downstream
  // consumer can invoke ANODE_OP_QUERY_ROLE / QUERY_LABEL_PTR against
  // it directly.
  //
  // The two scaffold gaps documented in status_bar.pdx §Section 4
  // apply identically here (no userspace sys_a11y_node_mint yet, and
  // a11y_bind_at_mint is window-scoped not widget-scoped) -- see
  // design/a11y/a11y-node-consumer-guide.md and the wave ζ report.
  //
  // ROLE_BUTTON (2) from src/user/a11y/kind_a11y_node.pdx is an exact
  // match for a launcher slot (interactive, click-invoked launch);
  // no follow-on taxonomy extension needed the way status_bar's
  // ROLE_LABEL-as-STATUS placeholder does.
  //
  // Wiring into pdx_desktop_init is deferred for the same reason
  // status_bar_a11y_init's is -- see status_bar.pdx §Section 4
  // header note on the pdx_desktop_init fixed-3-slot state.
  // ==========================================================================

  pub let mut _launcher_a11y_nodes : [u64; 3] = uninit @align(64)

  pub let LAUNCHER_A11Y_ROLE : u64 = 2         // ROLE_BUTTON

  pub let LAUNCHER_A11Y_IDX_TERM    : u64 = 0
  pub let LAUNCHER_A11Y_IDX_FILES   : u64 = 1
  pub let LAUNCHER_A11Y_IDX_BROWSER : u64 = 2

  // Label payload lengths (excluding the NUL) for the existing
  // launcher_label_{term,files,browser} strings above. Matches
  // status_bar_wifi_ssid_len's payload-vs-NUL convention.
  pub let LAUNCHER_A11Y_LABEL_LEN_TERM    : u64 = 4
  pub let LAUNCHER_A11Y_LABEL_LEN_FILES   : u64 = 5
  pub let LAUNCHER_A11Y_LABEL_LEN_BROWSER : u64 = 7

  pub let launcher_a11y_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave ζ ζ-02: zero the three cap-slot cells (0 == 'not yet minted' -- see status_bar.pdx §Section 4 for the mint scaffold gap). Three plain qword stores. Labels prefixed la_i_.",
      block: {
        lea r10, [rip + _launcher_a11y_nodes];
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        ret
      }
    }

  pub let launcher_a11y_node_slot : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave ζ ζ-02: bounds-checked read of _launcher_a11y_nodes[idx]. Labels prefixed la_ns_.",
      block: {
        cmp rdi, 3;
        jae la_ns_bad;
        lea r10, [rip + _launcher_a11y_nodes];
        mov rax, [r10 + rdi * 8];
        ret;
      la_ns_bad:
        xor rax, rax;
        ret
      }
    }

  // launcher_a11y_label_ptr(idx) -> pointer into the existing
  // launcher_label_{term,files,browser} strings (no per-a11y label
  // duplication).
  pub let launcher_a11y_label_ptr : (u64) -> u64 !{} @{} =
    fn (idx: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave ζ ζ-02: idx -> existing launcher_label_* pointer (idx 0/1/2 -> term/files/browser). Reuses the launcher_slot_label_ptr shape above with the SAME dispatch, one level up (that helper takes a slot index; this one takes the same index and returns the same pointer, kept as a distinct symbol for a11y-vs-widget-render callsite legibility). Labels prefixed la_lp_.",
      block: {
        cmp rdi, 0;
        je  la_lp_term;
        cmp rdi, 1;
        je  la_lp_files;
        cmp rdi, 2;
        je  la_lp_browser;
        xor rax, rax;
        ret;
      la_lp_term:
        lea rax, [rip + launcher_label_term];
        ret;
      la_lp_files:
        lea rax, [rip + launcher_label_files];
        ret;
      la_lp_browser:
        lea rax, [rip + launcher_label_browser];
        ret
      }
    }

  pub let launcher_a11y_label_len : (u64) -> u64 !{} @{} =
    fn (idx: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave ζ ζ-02: idx -> label payload length (excluding NUL). Labels prefixed la_ll_.",
      block: {
        cmp rdi, 0;
        je  la_ll_term;
        cmp rdi, 1;
        je  la_ll_files;
        cmp rdi, 2;
        je  la_ll_browser;
        xor rax, rax;
        ret;
      la_ll_term:
        mov rax, 4;
        ret;
      la_ll_files:
        mov rax, 5;
        ret;
      la_ll_browser:
        mov rax, 7;
        ret
      }
    }
}
