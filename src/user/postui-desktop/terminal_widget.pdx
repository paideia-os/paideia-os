// src/user/postui-desktop/terminal_widget.pdx -- R113.M6-027 (paideia-os
// #2407, M1 terminal widget) + R113.M6-031 (paideia-os #2411, Frame draws)
//
// The desktop's one terminal widget: a postui::Frame subsurface configured
// for stdin/stdout via KIND_TTY (src/kernel/core/cap/kind_tty.pdx, 0x197),
// plus the Frame-to-rect blit wiring #2411 asks for.
//
// KIND_TTY IS ITSELF A SUBSTRATE-PREP LANDING (see kind_tty.pdx's own
// header): TTY_OP_WRITE today "records the acknowledgement... does not
// touch a physical device" and carries no (buf,len) payload through
// cap_invoke -- real byte I/O rides sys_read/sys_write against a TTY fd,
// a wire that lands with R49.M1 per that file's own scope note. This
// widget therefore does exactly what a KIND_TTY holder CAN do today:
// query rows/cols (TTY_OP_QUERY_ROWS=1, TTY_OP_QUERY_COLS=2) to size
// itself, and record readiness. Byte-level stdin/stdout plumbing is a
// follow-up tracked by kind_tty.pdx's own R49.M1 note, not invented here.
//
// FRAME DRAWS (#2411). "postui::Frame" and "KIND_GFX_BUFFER" name no
// existing kernel primitive in this tree (grep at landing time: zero
// hits for either outside this wave's own issue text) -- there is no
// scanout-buffer capability kind between KIND_SURFACE (0x1B8, the
// abstract compositor surface) and KIND_GPU_BO (0x174, a raw GPU buffer
// object) that a client-side "pre-rendered scanlines" handoff would ride.
// Rather than inventing a parallel capability kind for a UI-shell wave
// explicitly scoped away from driver work, this file models the Frame
// hand-off as a plain userspace struct (_tw_frame below: scanline
// pointer + length + swap counter) and gates every swap on
// desktop_surface_gate (surface_wire.pdx) -- the real, already-dispatched
// KIND_SURFACE capability -- so "the widget's compositor callback swaps
// the buffer on vblank" is honestly a same-process counter bump today,
// not a real vblank ISR hookup (that requires the display-plane
// scanout wiring in src/kernel/core/graphics/scanout.pdx + a real
// per-client vblank subscription, both out of scope here). The counter
// exists so a smoke witness can prove terminal_widget_frame_swap ran.

module TerminalWidget = structure {

  // ==========================================================================
  // Section 0  Failure taxonomy (0xFFFFE180..0xFFFFE18F).
  // ==========================================================================

  pub let TW_OK          : u64 = 0
  pub let TW_BAD_ARG     : u64 = 0xFFFFE180
  pub let TW_NO_SURFACE  : u64 = 0xFFFFE181

  // ==========================================================================
  // Section 1  State.
  //
  // _tw_state: [tty_slot, rows, cols, ready_flag]
  // _tw_frame: [scanline_ptr, scanline_len, swap_count]
  // ==========================================================================

  pub let mut _tw_state : [u64; 4] = uninit @align(64)
  pub let mut _tw_frame : [u64; 3] = uninit @align(64)

  // TTY op ordinals (kind_tty.pdx; duplicated here as plain literals --
  // this is a ring-3 file and cannot reference the ring-0 module's
  // symbols directly, only the numeric contract it publishes).
  pub let TTY_OP_QUERY_ROWS : u64 = 1
  pub let TTY_OP_QUERY_COLS : u64 = 2

  // ==========================================================================
  // Section 2  terminal_widget_init(tty_slot) -> TW_OK | TW_BAD_ARG.
  //
  // Refuses tty_slot == 0 (not granted). Otherwise queries rows then cols
  // via two sequential sys_cap_invoke calls -- r12 holds tty_slot and r13
  // holds &_tw_state across both. Both are callee-saved per SysV, so both
  // are pushed on entry and popped before every return -- this function's
  // caller (src/user/postui-desktop/entry.pdx pdx_desktop_init) holds its
  // own live value in r12 across the call to this function, and that
  // value must come back unharmed regardless of what this body does
  // internally.
  // ==========================================================================

  pub let terminal_widget_init : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (tty_slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R113.M6-027 (#2407): size the widget from its KIND_TTY cap. r12=tty_slot, r13=&_tw_state, both held across two sequential sys_cap_invoke calls. sys_cap_invoke's own body only clobbers rax/rcx/r11 (SYSCALL's own hardware contract) but this function's callER may hold a live value in r12/r13 (src/user/postui-desktop/entry.pdx pdx_desktop_init does exactly that) -- r12/r13 are callee-saved per SysV, so they are pushed on entry and popped before every return path, leaving this function's own use of them invisible to its caller. Labels prefixed twi_.",
      block: {
        cmp rdi, 0;
        je  twi_bad_arg;
        push r12;
        push r13;
        mov r12, rdi;
        lea r13, [rip + _tw_state];
        mov [r13 + 0], r12;               // _tw_state[0] = tty_slot

        mov rdi, r12;
        mov rsi, 1;                       // TTY_OP_QUERY_ROWS
        call sys_cap_invoke;
        mov [r13 + 8], rax;               // _tw_state[1] = rows

        mov rdi, r12;
        mov rsi, 2;                       // TTY_OP_QUERY_COLS
        call sys_cap_invoke;
        mov [r13 + 16], rax;              // _tw_state[2] = cols

        mov rax, 1;
        mov [r13 + 24], rax;              // _tw_state[3] = ready
        pop r13;
        pop r12;
        xor rax, rax;                     // TW_OK
        ret;
      twi_bad_arg:
        mov rax, 0xFFFFE180;              // TW_BAD_ARG
        ret
      }
    }

  pub let terminal_widget_rows : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M6-027 (#2407): read cached rows. Labels prefixed twr_.",
      block: {
        lea r10, [rip + _tw_state];
        mov rax, [r10 + 8];
        ret
      }
    }

  pub let terminal_widget_cols : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M6-027 (#2407): read cached cols. Labels prefixed twc_.",
      block: {
        lea r10, [rip + _tw_state];
        mov rax, [r10 + 16];
        ret
      }
    }

  pub let terminal_widget_is_ready : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M6-027 (#2407): read ready flag. Labels prefixed twir_.",
      block: {
        lea r10, [rip + _tw_state];
        mov rax, [r10 + 24];
        ret
      }
    }

  // ==========================================================================
  // Section 3  terminal_widget_frame_swap(surface_slot, scanline_ptr,
  //   scanline_len) -> TW_OK | TW_NO_SURFACE | TW_BAD_ARG.
  //
  // Gates on desktop_surface_gate(surface_slot) (surface_wire.pdx) before
  // accepting the new scanline pointer, per the file header's §FRAME
  // DRAWS scope note. On acceptance, records the pointer/length and
  // bumps the swap counter -- the "vblank swap" placeholder.
  // ==========================================================================

  pub let terminal_widget_frame_swap : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (surface_slot: u64) (scanline_ptr: u64) (scanline_len: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R113.M6-031 (#2411): r12=scanline_ptr, r13=scanline_len held across the single call to desktop_surface_gate. Pushed/popped around the whole body -- desktop_surface_gate itself only touches r10/rax/rsi/rdi so r12/r13 would in fact survive unpushed, but this function is called with surface_slot/scanline args, not guaranteed callee-saved-register-free callers, so the push/pop is kept for the same reason terminal_widget_init keeps its own (a future caller may hold a live value in r12/r13 across this call; SysV requires this function to preserve them regardless of what its own callees happen to touch today). Refuses scanline_ptr==0. Labels prefixed twfs_.",
      block: {
        cmp rsi, 0;
        je  twfs_bad_arg;
        push r12;
        push r13;
        mov r12, rsi;                     // scanline_ptr
        mov r13, rdx;                     // scanline_len
        call desktop_surface_gate;        // rdi already = surface_slot
        cmp rax, 0;
        jne twfs_no_surface;
        lea r10, [rip + _tw_frame];
        mov [r10 + 0], r12;               // scanline_ptr
        mov [r10 + 8], r13;               // scanline_len
        mov rax, [r10 + 16];
        add rax, 1;
        mov [r10 + 16], rax;              // swap_count++
        pop r13;
        pop r12;
        xor rax, rax;                     // TW_OK
        ret;
      twfs_no_surface:
        pop r13;
        pop r12;
        mov rax, 0xFFFFE181;              // TW_NO_SURFACE
        ret;
      twfs_bad_arg:
        mov rax, 0xFFFFE180;              // TW_BAD_ARG
        ret
      }
    }

  pub let terminal_widget_swap_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M6-031 (#2411): read the vblank-swap placeholder counter, for a smoke witness. Labels prefixed twsc_.",
      block: {
        lea r10, [rip + _tw_frame];
        mov rax, [r10 + 16];
        ret
      }
    }
}
