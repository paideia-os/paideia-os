// src/user/postui-desktop/entry.pdx -- R113.M6-027 (paideia-os #2407)
//
// postui-desktop's process entry: registers with the compositor, gates
// the terminal widget's surface handoff on real capability presence, and
// brings up the terminal widget + status bar + launcher, in that order.
//
// LIFECYCLE-SKELETON SCOPE, matching src/user/input_server/main.pdx's own
// posture at its equivalent landing: this file wires the INIT sequence
// and a MAIN LOOP skeleton. It is not yet a linked, spawned process
// (see tools/build-user.sh's postui-desktop/* exclusion branch, added
// alongside this file) -- it compiles and type-checks today; the real
// process-spawn wire (init hands it a KIND_SURFACE sub-cap + optionally a
// KIND_BATTERY read cap, per config.pdx's own §SPAWN-TIME CAPABILITY GAP)
// is a follow-up landing.

module Entry = structure {

  // ==========================================================================
  // Section 0  Init-result state: [client_reg, surface_gate, terminal_init].
  // ==========================================================================

  pub let mut _desktop_init_state : [u64; 3] = uninit @align(64)

  // ==========================================================================
  // Section 1  pdx_desktop_init() -> compositor_register_client's result
  // (a client-table slot index on success, or one of client_registry.pdx's
  // CLIENT_REGISTRY_* sentinels).
  //
  // Sequence: register with the compositor, gate the surface handoff,
  // init the terminal widget, init the status-bar clock cell -- four
  // sequential calls, each stack-neutral, chained the same zero-extra-
  // pushes way src/user/init.pdx's own call sys_fork / call sys_debug_puts
  // / call sys_execve sequence is. The one push/pop pair in the body
  // brackets r12 itself (this function's own callee-saved-register
  // discipline for ITS caller), not the call chain.
  // ==========================================================================

  pub let pdx_desktop_init : () -> u64 !{mem, sysreg} @{cap, sched} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap, sched},
      justification: "R113.M6-027 (#2407): four-step init sequence. r12 holds &_desktop_init_state across all four calls. compositor_register_client and terminal_widget_init both push/pop r12/r13 internally specifically so a caller like this one can hold a live value in r12 across them (see their own justifications); desktop_surface_gate and status_bar_clock_init never touch r12 at all. r12 is itself pushed/popped here around the whole body per the same SysV callee-saved discipline, for this function's own (future) caller. Labels prefixed pdi_.",
      block: {
        push r12;
        lea r12, [rip + _desktop_init_state];

        mov rdi, 1;                      // DESKTOP_APP_ID
        mov rsi, 3;                      // DESKTOP_CAPS
        call compositor_register_client;
        mov [r12 + 0], rax;

        mov rdi, 0;                      // DESKTOP_SURFACE_SLOT (placeholder)
        call desktop_surface_gate;
        mov [r12 + 8], rax;

        mov rdi, 0;                      // TERMINAL_WIDGET_TTY_SLOT (placeholder)
        call terminal_widget_init;
        mov [r12 + 16], rax;

        call status_bar_clock_init;

        mov rax, [r12 + 0];              // return the compositor_register_client result
        pop r12;
        ret
      }
    }

  pub let pdx_desktop_surface_gate_result : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M6-027 (#2407): read cached surface-gate result. Labels prefixed pdsg_.",
      block: {
        lea r10, [rip + _desktop_init_state];
        mov rax, [r10 + 8];
        ret
      }
    }

  pub let pdx_desktop_terminal_init_result : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M6-027 (#2407): read cached terminal_widget_init result. Labels prefixed pdti_.",
      block: {
        lea r10, [rip + _desktop_init_state];
        mov rax, [r10 + 16];
        ret
      }
    }

  // ==========================================================================
  // Section 2  Main-loop skeleton.
  //
  // pdx_desktop_main_loop(): infinite loop, one status_bar_clock_tick
  // call per iteration. Shape mirrors src/user/input_server/main.pdx's
  // input_server_main_loop exactly: push rbx to realign (entry rsp%16==8
  // -> post-push rsp%16==0, required for `call`), tight jmp-back loop, one
  // call per pass. Real event-driven scheduling (launcher clicks, wifi/
  // battery re-samples on their own cadence) is a follow-up once
  // postui-desktop is a real spawned, scheduled process -- see the file
  // header's lifecycle-skeleton note.
  // ==========================================================================

  pub let pdx_desktop_main_loop : () -> () !{mem, sysreg} @{} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "R113.M6-027 (#2407): infinite loop skeleton, one call to status_bar_clock_tick per pass -- same push/jmp shape as input_server_main_loop (push rbx realigns rsp to %16==0 for the nested call; unused after the push, but kept as a callee-saved scratch reservation for a future per-iteration event value the way input_server_main_loop reserves rbx for its state pointer). Unreachable pop/ret tail for well-formed procedure shape. Labels prefixed pdml_.",
      block: {
        push rbx;
      pdml_top:
        call status_bar_clock_tick;
        jmp  pdml_top;
        pop  rbx;
        ret
      }
    }
}
