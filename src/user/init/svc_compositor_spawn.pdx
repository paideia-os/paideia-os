// src/user/init/svc_compositor_spawn.pdx -- Wave β β-04 (paideia-os
// compositor QEMU bring-up)
//
// init-side svc-compositor userspace daemon spawn wire. Called once
// from Init._start (src/user/init.pdx), right after tty0 setup (dup2
// of fd 0/1/2) and before rootfs_seed_run, per the task brief's literal
// "on boot, after tty init" placement.
//
// Forks and execve()s /system/services/svc-compositor, matching the
// elevate_broker_daemon precedent: fork, attempt exec, do NOT wait4
// (a compositor daemon is long-lived, like elevate_broker_daemon --
// see init.pdx's own init_fork_sh_parent comment for why a wait4'd
// child placed ahead of the /bin/sh cycle would starve later code of
// CPU time it never gets back). The PARENT emits the task-specified
// "SVC-COMP SPAWNED pid=<N>" fingerprint unconditionally once fork
// returns -- mirroring init.pdx's own "INIT FORK SH OK" / "INIT FORK
// ELEVATE OK" convention, where a fork-side marker witnesses the
// spawn ATTEMPT, independent of whether the exec that follows in the
// child succeeds.
//
// HONESTY NOTE (design/testing/compositor-qemu-smoke-plan.md §3, gap
// G2): svc-compositor has ZERO source in this monorepo as of this
// landing -- R102 specs it as an uncreated satellite repo, and no
// rootfs seed writes anything to /system/services/svc-compositor.
// This file provides the SPAWN WIRE only. Until a real daemon lands
// (G1 lineage decision -> G2 daemon source -> a seed function analogous
// to bin_seeds.pdx's bin_true_seed, but rooted at /system/services/
// rather than /bin/), the child's execve will return -ENOENT and the
// CHILD emits "SVC-COMP SPAWN EXEC FAIL" then exits -- an honest,
// distinguishable failure signal, not a silently-swallowed one. The
// parent-side "SPAWNED pid=<N>" marker still fires because the fork
// itself succeeds; it asserts "init attempted the spawn", not "the
// daemon is running" -- the same distinction init.pdx already draws
// for /bin/sh and the elevate broker daemon.

module SvcCompositorSpawn = structure {
  // "/system/services/svc-compositor" -- 31 chars + NUL = 32 bytes.
  pub let svc_compositor_path : [u8; 32] = "/system/services/svc-compositor\0"

  // "SVC-COMP SPAWNED pid=" -- 22 chars + NUL = 23 bytes. Emitted, then
  // the real fork-returned pid via Init.print_u64_dec, then a newline.
  pub let svc_comp_spawned_prefix : [u8; 23] = "SVC-COMP SPAWNED pid=\0"
  pub let svc_comp_newline : [u8; 2] = "\n\0"

  // "SVC-COMP SPAWN EXEC FAIL\n" -- 25 wire bytes + NUL = 26 bytes.
  // Fires in the CHILD only if execve returns (expected today per the
  // honesty note above, pending a real svc-compositor seed).
  pub let svc_comp_exec_fail_msg : [u8; 26] = "SVC-COMP SPAWN EXEC FAIL\n\0"

  // svc_compositor_spawn_run() -- called once from Init._start.
  pub let svc_compositor_spawn_run : () -> () !{mem, sysreg} @{fs, sched} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {fs, sched},
      justification: "Wave β β-04: fork+execve(/system/services/svc-compositor) wire, non-wait4'd (long-lived daemon, mirrors init.pdx's own elevate_broker_daemon cycle). Called from Init._start right after tty0 setup, before rootfs_seed_run -- at that call site r12 (the tty fd) is already dead (last read by the preceding sys_close) and no other init-owned register is expected to survive across this call, so this function is free to use r13 as scratch without a push/pop: it is a leaf relative to init.pdx's _start in the sense that _start's own next write to r13 (the later wait4 pid-preservation step) freshly overwrites whatever this function leaves behind, matching the same 'r13 used as scratch with no save/restore' discipline _start's own D12 wait4 block already follows for the same reason (it too is never read by a caller expecting SysV callee-save). Sequence: call sys_fork() -> rax = 0 (child) or child_pid (parent) or negative errno. Child (rax==0): sys_execve(&svc_compositor_path, argv=NULL, envp=&Init._init_envp) -- envp is a cross-module `pub` data symbol on Init, resolved by the linker exactly like Init.print_u64_dec below; execve does not return on success. If it returns (expected today -- no rootfs seed populates /system/services/svc-compositor yet, see this file's header honesty note), emit svc_comp_exec_fail_msg (25 bytes) via sys_debug_puts then sys_exit(1). Parent (rax != 0, and rax not checked against <0 here because sys_fork's documented failure contract elsewhere in this tree is 'negative errno', which would also be != 0 and is treated the same as a real pid for this fire-and-forget marker -- a fork failure here is not boot-fatal, matching the design brief's ask for an unconditional post-fork marker): save rax into r13 (scratch, see above), emit svc_comp_spawned_prefix (22 bytes) via sys_debug_puts, emit r13 as decimal via Init.print_u64_dec (cross-module call, same linker-resolution pattern as ls.pdx's `call sys_getdents`), emit svc_comp_newline (1 byte), then `ret` back into Init._start's rootfs_seed_run call unchanged. Effects/capabilities: {mem,sysreg} for the fork/execve/debug_puts syscalls' own declared effects (union, matching Init._start's own {mem,sysreg}); {fs,sched} for execve's path resolution and fork's scheduler enqueue respectively (union of sys_execve's and sys_fork's own declared capabilities per the SC+ shim). Reserved labels: prefixed svc_comp_.",
      block: {
        call sys_fork;
        cmp rax, 0;
        je svc_comp_spawn_child;

        // ---------- Parent path: unconditional post-fork marker ----------
        mov r13, rax;                       // r13 = child pid (scratch; see justification)

        lea rdi, [rip + svc_comp_spawned_prefix];
        mov rsi, 22;
        call sys_debug_puts;

        mov rdi, r13;
        call print_u64_dec;

        lea rdi, [rip + svc_comp_newline];
        mov rsi, 1;
        call sys_debug_puts;

        ret;

        // ---------- Child path: execve, expected to fail today ----------
        svc_comp_spawn_child:
          lea rdi, [rip + svc_compositor_path];
          xor rsi, rsi;                     // argv = NULL
          lea rdx, [rip + _init_envp];      // envp = &Init._init_envp
          call sys_execve;

          // Reached only on execve failure (expected -- see header).
          lea rdi, [rip + svc_comp_exec_fail_msg];
          mov rsi, 25;
          call sys_debug_puts;
          mov rdi, 1;
          call sys_exit;
          // Unreachable; belt-and-suspenders hlt for the impossible fallthrough.
          hlt
      }
    }
}
