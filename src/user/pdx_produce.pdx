// src/user/pdx_produce.pdx -- R121.M5 (paideia-os #2499) canary producer
//
// Exercises sys_pipe_edge_send (SC+ ID 131) three times against a
// well-known edge_cap_slot=1 and mem_cap_slot=2 in the caller's own
// cap_table.
//
// R121.M5 CAP-MINT GAP (documented, not fixed here):
//
//   pipeline_edge_alloc + pipe_edge_bind are kernel-side primitives with
//   no user-facing syscall today (src/kernel/core/cap/pipeline_edge.pdx
//   §12 header note: "pipeline_edge_alloc: Not reachable via cap_invoke
//   (no MINT right at M1)"). Consequently no ring-3 caller can mint a
//   KIND_PIPELINE_EDGE cap into its own cap_table, and the shell cannot
//   feed valid edge caps to this canary. sys_pipe_edge_send therefore
//   returns -EBADF (0xFFFFFFFFFFFFFFF7 -- edge_cap_slot resolves to a
//   descriptor with kind != KIND_PIPELINE_EDGE).
//
//   That is the point of this canary at M5: it exercises the SYSCALL
//   dispatch arm end-to-end (SysV shim -> IDT sysenter -> kernel
//   dispatcher's cmp/je for ID 131 -> pipe_edge_send -> refuse arm
//   PET_SEND_BAD_ROW -> -EBADF back through SYSRET), independent of
//   the still-absent mint plumbing. Follow-up landings (R121.M5+ or
//   R123) add sys_pipe_edge_mint / sys_pipe_edge_bind syscalls, at
//   which point the shell's exec_child_pipeline_typed_entry can seed
//   real caps before fork and this canary starts observing 0 returns
//   instead of -EBADF -- without any change to the canary itself.
//
// Self-contained _start (no syscall_shim linkage). Same one-file-one-
// ELF discipline as child_hello.pdx / true.pdx / echo_server.pdx --
// tools/build-user.sh classifies pdx_produce.o into its own object set
// so the shim's other wrappers are not dragged in.
//
// SC+ IDs (frozen per src/user/syscall_shim.pdx):
//   12  = sys_debug_puts(buf, count)      -- fingerprint emit
//   60  = sys_exit(status)                -- terminate
//   131 = sys_pipe_edge_send(edge, mem)   -- the actual R121.M5 exercise
//
// Fingerprints (each terminated by '\n', wire length excludes NUL):
//   pdx-produce start N=3
//   pdx-produce send i=0     ... pdx-produce send i=1 ... pdx-produce send i=2
//   pdx-produce done
//
// A grep for `pdx-produce start N=3` in the boot klog is byte-proof
// that the LEFT child of an exec_child_pipeline_typed_entry actually
// execve'd this ELF; a grep for `pdx-produce done` proves the child
// ran to completion (all three send attempts returned and exit(0)
// executed).

module PdxProduce = structure {
  // Wire lengths are the byte counts (NUL excluded). Storage widths
  // include the NUL terminator so paideia-as accepts them as [u8;N]
  // literals.
  pub let pp_msg_start     : [u8; 22] = "pdx-produce start N=3\n\0"
  pub let pp_msg_start_len : u64      = 21
  pub let pp_msg_send0     : [u8; 20] = "pdx-produce send i=0\n\0"
  pub let pp_msg_send1     : [u8; 20] = "pdx-produce send i=1\n\0"
  pub let pp_msg_send2     : [u8; 20] = "pdx-produce send i=2\n\0"
  pub let pp_msg_send_len  : u64      = 20
  pub let pp_msg_done      : [u8; 17] = "pdx-produce done\n\0"
  pub let pp_msg_done_len  : u64      = 16

  pub let _start : () -> () !{mem, sysreg} @{fs, sched, cap} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {fs, sched, cap},
      justification: "R121.M5 (paideia-os #2499) canary producer: emit pp_msg_start via sys_debug_puts (SC+ ID 12), then three unrolled sys_pipe_edge_send (SC+ ID 131) attempts against the hardcoded edge_cap_slot=1 / mem_cap_slot=2 pair (both are placeholders per the CAP-MINT GAP header note above -- absent minted caps every send returns -EBADF, which the canary intentionally ignores because its purpose at M5 is dispatch-arm exercise, not payload transfer), sandwiching a per-iteration pp_msg_send{0,1,2} fingerprint between attempts so a grep of the three witnesses proves each send round-tripped through the kernel. Final pp_msg_done fingerprint fires only if all three attempts returned (so a hang or a #PF inside sys_pipe_edge_send would suppress it). Then sys_exit(0) (SC+ ID 60). Self-contained _start (no syscall_shim linkage) mirrors child_hello.pdx / true.pdx / ps.pdx / cat.pdx classification -- the shim's other wrappers are excluded from pdx_produce.elf via tools/build-user.sh's dedicated object set. Register plan: sends are unrolled (no loop counter) so no callee-save reg needs to survive across a SYSCALL. Every SYSCALL clobbers only rax/rcx/r11 per the kernel entry contract; rdi/rsi/rdx are argument regs the next call reloads verbatim from immediates or a fresh lea. sys_exit does not return; the trailing hlt is defensive (impossible fallthrough). Encoder-gap posture per feedback_pdx_encoder_pitfalls: no `test rN,rN` (no zero-check needed anywhere -- the send returns are intentionally discarded); no `and rN, imm64`; no 2-op `imul r, imm`; no `add reg, [mem]`; every immediate fits imm32 (12, 60, 131, small message lengths <= 21 all fit imm8). Reserved-label discipline: labels pp_-prefixed.",
      block: {
        // --- pp_msg_start via sys_debug_puts ---
        lea rdi, [rip + pp_msg_start];
        mov rsi, 21;
        mov rax, 12;
        syscall;

        // --- send i=0 ---
        mov rdi, 1;                      // edge_cap_slot placeholder
        mov rsi, 2;                      // mem_cap_slot placeholder
        mov rax, 131;                    // SC+ ID sys_pipe_edge_send
        syscall;
        lea rdi, [rip + pp_msg_send0];
        mov rsi, 20;
        mov rax, 12;
        syscall;

        // --- send i=1 ---
        mov rdi, 1;
        mov rsi, 2;
        mov rax, 131;
        syscall;
        lea rdi, [rip + pp_msg_send1];
        mov rsi, 20;
        mov rax, 12;
        syscall;

        // --- send i=2 ---
        mov rdi, 1;
        mov rsi, 2;
        mov rax, 131;
        syscall;
        lea rdi, [rip + pp_msg_send2];
        mov rsi, 20;
        mov rax, 12;
        syscall;

        // --- pp_msg_done ---
        lea rdi, [rip + pp_msg_done];
        mov rsi, 16;
        mov rax, 12;
        syscall;

        // --- sys_exit(0) ---
        mov rdi, 0;
        mov rax, 60;
        syscall;
        hlt
      }
    }
}
