// src/user/shell.pdx — R17-M3-001 (#621) + R17-M3-002 (#622)
// Interactive shell: prompt, read line (byte-by-byte until '\n'), dispatch (stub for now), loop.
// Acceptance: builds; runs to prompt; reads line byte-by-byte; stops at '\n' or EOF or buffer full.
// See design/kernel/r17-m3-001-shell-main-loop.md and design/kernel/r17-m3-002-shell-line-reader.md.

module Shell = structure {
  pub let prompt_msg : [u8; 3] = "$ \0"
  pub let prompt_len : u64 = 2

  // R17-M5-749 (paideia-os #749): entry-point witness marker. Emitted as
  // the very first thing shell._start does, via sys_debug_puts, before
  // dispatch_init. Its presence on serial log proves that
  // (1) init's fork+execve("/bin/sh") landed control in shell's _start,
  // (2) the ELF loader placed e_entry correctly, (3) syscall_shim
  // resolves against the kernel's SC+ dispatch. sys_debug_puts is
  // length-bounded and bypasses the tty layer, so it lands on serial
  // even if tty state has an issue.
  //
  // 12 bytes on wire (excludes trailing NUL); rodata storage 13 bytes.
  pub let shell_start_msg : [u8; 13] = "SHELL START\n\0"
  pub let shell_start_len : u64 = 12

  pub let mut line_buf : [u8; 256] = uninit @align(8)

  // R65v2.M1-003 (#1981): shell chdir-on-entry to $HOME.
  //
  // R106.M2 (paideia-os #2229) regression note: init.pdx retargeted its
  // envp HOME value from the R65v2 hardcoded HOME literal
  // (8-byte value) to the R106 content-addressed
  // "HOME=/home/<64-hex-placeholder>/" shape (70-byte value, sourced
  // from FounderConstants.fc_placeholder_home_path). No code change was
  // needed here: shell_home_match's prefix compare only inspects the
  // fixed 5-byte "HOME=" key, and shell_home_strlen computes the
  // value's length via a NUL-scan bounded at 255 rather than assuming
  // any fixed width, so the longer fingerprint-shaped value is picked
  // up unchanged. See design/roadmap/persistent-home-wave.md §R106.M2.
  pub let shell_home_prefix : [u8; 6] = "HOME=\0"

  // paideia-os #2450: line-editing echo sequences emitted by
  // shell_read_line when the reader consumes a control byte.
  //
  //   shell_erase_seq     — "\x08 \x08" (BS, space, BS): visually
  //                          rubs out the last echoed glyph on a
  //                          hardware/terminal that does destructive
  //                          backspace-in-place. 3 bytes on the wire;
  //                          rodata storage 4 bytes (trailing NUL is
  //                          convention, not consumed by sys_write).
  //
  //   shell_clearline_seq — "\r\x1b[K" (CR, ANSI erase-to-EOL):
  //                          repositions the cursor to column 0 and
  //                          clears the rest of the current line, which
  //                          is what Ctrl-U (kill-line) needs to do
  //                          alongside resetting the in-memory buffer
  //                          cursor. 4 bytes on the wire; rodata
  //                          storage 5 bytes.
  //
  // No fingerprint on either write path (the line reader is a hot loop
  // and every accepted keystroke goes through it — a per-write debug
  // trace would flood the serial log).
  pub let shell_erase_seq     : [u8; 4] = "\x08 \x08\0"
  pub let shell_clearline_seq : [u8; 5] = "\r\x1b[K\0"

  // shell_read_line(buf, sz) -> bytes_read (rax).
  // Read bytes from stdin (fd 0) into buf, one byte at a time via sys_read(0, buf, 1).
  // Stop when: (1) newline found (0x0A), (2) EOF (bytes_read from syscall == 0), or (3) buffer full (rcx >= sz).
  // Returns total bytes read (including the newline if present).
  //
  // paideia-os #2450: before queuing the just-read byte into buf, dispatch
  // on control codes:
  //   0x08 (BS) / 0x7F (DEL) → erase last accepted byte, echo "\x08 \x08"
  //                            (silent when the buffer is already empty).
  //   0x15 (Ctrl-U)          → drop the whole line, echo "\r\x1b[K", reset
  //                            the write cursor to buf base.
  //   0x0A (newline)         → accept + break (unchanged).
  //   any other <0x20        → silent drop (matches conventional line-mode
  //                            shells; Ctrl-C is #2451 and left as-is).
  //   printable              → accept, loop.
  // Accept means "inc r14, inc r12"; retract means "dec r14, dec r12" — the
  // byte the kernel just wrote into [r12] is left in place because the next
  // sys_read into that same slot overwrites it. Ctrl-U's reset uses r15 as
  // the buf-base anchor (initialised from rdi alongside r12), which is why
  // this rev extends the callee-save save/restore set from {r12,r13,r14} to
  // {r12,r13,r14,r15}. All echo writes go through sys_write, which follows
  // SysV and preserves r12–r15, so no per-call reload dance is needed.
  pub let shell_read_line : (u64, u64) -> u64 !{mem, sysreg} @{fs} =
    fn (buf: u64) (sz: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {fs},
      justification: "R17-m3-002 (#622) + paideia-os #2450: shell_read_line reads from stdin byte-by-byte until newline, EOF, or buffer full. buf in rdi, sz in rsi. Loop: sys_read(0, current_buf_ptr, 1); if rax<=0 break; otherwise load the byte and dispatch on line-editing control codes before accepting it. Returns total bytes read in rax. #722 fix retained: buf/sz/counter live in callee-save r12/r13/r14 (SysV) so the syscall shim's r10->r8 shuffle (kernel entry.pdx L42) does not clobber them. #2450 adds r15 = buf base (captured from rdi alongside r12) so Ctrl-U can rewind r12 to the start of the buffer without recomputing an address from an already-clobbered rdi; r15 joins the callee-save push/pop set. Backspace/DEL retract via `dec r14; dec r12`, then echo '\\x08 \\x08' (BS-space-BS) via sys_write(1, shell_erase_seq, 3) to erase the glyph on the terminal; when r14==0 the retract is skipped and no echo is emitted (matches bash/dash line-mode). Ctrl-U resets r14 to 0 and r12 to r15, then echoes '\\r\\x1b[K' via sys_write(1, shell_clearline_seq, 4). Any other control byte below 0x20 (except newline) is silently dropped — no advance, no echo. Newline still accepts (inc r14, inc r12) before breaking so the caller's #670 NUL-terminate-at-line_buf[bytes_read] slot placement is unchanged. The paideia-as #1248 `cmp al, imm8` mitigation is preserved: every dispatch compare is against the AL half of a rax that has been AND-masked to 0xff first, so the encoder's REX.W-widened compare still sees the byte value. Reserved-label discipline: labels prefixed `read_` (existing) or `read_bs_`/`read_cu_`/`read_nl_` (new).",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;           // r12 = buf write cursor (callee-save, survives sys_read/sys_write)
        mov r13, rsi;           // r13 = sz cap
        xor r14, r14;           // r14 = bytes_read counter
        mov r15, rdi;           // r15 = buf base (Ctrl-U rewind anchor)

read_loop:
        // if r14 >= r13: break (buffer full)
        cmp r14, r13;
        jge read_done;

        // call sys_read(0, r12, 1) — read one byte into the current slot
        mov rdi, 0;             // rdi = fd (stdin)
        mov rsi, r12;           // rsi = current write cursor
        mov rdx, 1;             // rdx = count (1 byte)
        call sys_read;

        // if rax <= 0: EOF or error, break
        cmp rax, 0;
        jle read_done;

        // Load the byte we just read. Mitigate paideia-as #1248 by
        // explicitly zeroing rax's upper bits so subsequent `cmp al, imm8`
        // (encoded as REX.W `cmp rax, imm8`) still reflects only the byte.
        xor rax, rax;
        mov_b rax, [r12];
        and rax, 0xff;

        // newline → accept + break
        cmp al, 0x0A;
        je read_nl_accept;

        // backspace (0x08) or DEL (0x7F) → erase last accepted byte
        cmp al, 0x08;
        je read_bs_handler;
        cmp al, 0x7f;
        je read_bs_handler;

        // Ctrl-U (0x15) → kill line: rewind buffer, clear terminal line
        cmp al, 0x15;
        je read_cu_handler;

        // Any other byte < 0x20 → silent drop (do not advance, do not echo)
        cmp al, 0x20;
        jb read_loop;

        // Normal byte → accept, loop
        inc r14;
        inc r12;
        jmp read_loop;

read_nl_accept:
        // Newline is retained in the buffer (matches original contract:
        // caller counts on bytes_read including the terminator when one
        // was seen, and lays the NUL down at line_buf[bytes_read]).
        inc r14;
        inc r12;
        jmp read_done;

read_bs_handler:
        // Nothing accepted yet → silent drop (r14/r12 stay put; the
        // BS/DEL byte the kernel wrote into [r12] is abandoned because
        // the next sys_read overwrites the same slot).
        cmp r14, 0;
        je read_loop;

        // Retract the previously accepted byte.
        dec r14;
        dec r12;

        // Echo "\x08 \x08" (BS, space, BS) so the terminal visually
        // erases the last glyph. sys_write preserves r12-r15.
        mov rdi, 1;
        lea rsi, [rip + shell_erase_seq];
        mov rdx, 3;
        call sys_write;
        jmp read_loop;

read_cu_handler:
        // Rewind write cursor to buf base and drop the accepted count;
        // r15 was seeded from the incoming rdi at entry for exactly this.
        xor r14, r14;
        mov r12, r15;

        // Echo "\r\x1b[K" (CR + ANSI erase-to-EOL) so the terminal drops
        // the visible prompt-line tail to match the now-empty buffer.
        mov rdi, 1;
        lea rsi, [rip + shell_clearline_seq];
        mov rdx, 4;
        call sys_write;
        jmp read_loop;

read_done:
        mov rax, r14;           // return bytes_read in rax
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // _start — user program entry point. Main loop: prompt → read → tokenize → dispatch → loop.
  // Never returns (sys_exit_thread on Ctrl-D or builtin_exit).
  pub let _start : () -> () !{mem, sysreg} @{fs, cap, sched} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {fs, cap, sched},
      justification: "R17-m3-001 (#621) + R17-m3-002 (#622) + R17-m3-003 (#623) + R17-m3-004 (#624) + R17-m3-005 (#625) + R17-m5-749 (paideia-os #749) + R65v2.M1-003 (#1981) + paideia-os #2456: shell _start main loop. FIRST, before anything else, stashes envp (rdx per design/user/execve-abi.md) into callee-save r12 -- the very next instruction (the witness-marker sys_debug_puts) is free to clobber rdx as a caller-save register, so this capture cannot be deferred even by one call. paideia-os #2456: immediately mirrors r12 into Dispatch.envp_slot (.bss) so resolve_path's rp_walk_path can source PATH= from envp without depending on r12 threading through the main_loop call chain; envp_slot is written even when r12==0 (dispatch_find_path_env treats NULL identically to 'no PATH entry'). R17-M5-749: emits 'SHELL START\\n' via sys_debug_puts (12 bytes) as an entry-point witness marker — proves init's fork+execve('/bin/sh') transferred control here, independent of tty/dispatch state; lands on serial even if downstream init/read paths have bugs. THEN: initialize dispatch table (dispatch_init). R65v2.M1-003: scans r12 (envp) for an entry whose first 5 bytes match 'HOME=' (mov_b-based byte compare per this codebase's #1248 mitigation discipline, bounded to the execve-abi.md 16-entry cap), and on a match calls sys_chdir(value_ptr, strlen(value_ptr) capped at 255). Both a scan miss (no envp, no HOME entry, cap exhausted) and a failed sys_chdir are silently ignored -- every task's TASK_OFF_CWD already defaults to root ('/') per R86.M1-006 (#1959), so there is nothing to explicitly fall back to. No fingerprint on any path (quiet by design, matching the rootfs-seed loop's own skip-silently discipline). THEN the pre-existing main loop: emit prompt ($ ), read line via shell_read_line into line_buf[256] (byte-by-byte until newline/EOF/full), tokenize the line via tokenize (in-place split into argv[16]), dispatch via dispatch_line (walk builtin table), on dispatch_line miss (rax==1), invoke exec_child to fork+execve argv[0] and wait for the child. Exit on EOF (bytes_read == 0).",
      block: {
        // R65v2.M1-003 (#1981): capture envp (rdx at _start entry per
        // design/user/execve-abi.md) into a callee-save register BEFORE
        // the witness-marker sys_debug_puts call below, which — like
        // every other call in this function — is free to clobber rdx as
        // a caller-save register. envp is 0 if init execve'd /bin/sh
        // without one (pre-R65 behaviour, or any other caller that
        // passes envp=NULL); the scan below treats that identically to
        // "HOME not found".
        mov r12, rdx;                    // r12 = envp

        // paideia-os #2456: mirror envp into Dispatch.envp_slot so
        // resolve_path can consult PATH= from envp without depending on
        // r12 surviving every intervening call in main_loop. r12 is
        // callee-save under SysV but shell._start's own call graph never
        // guarantees it back to resolve_path without a chain of preserves;
        // one .bss store here is the cheap, robust alternative and mirrors
        // the shell_home_scan discipline immediately below (which also
        // treats envp==0 as "no HOME"). envp_slot lives in dispatch.pdx --
        // linker resolves the [rip + envp_slot] reference the same way it
        // resolves argv_buf/argc across the shell.elf link.
        lea rax, [rip + envp_slot];
        mov [rax], r12;

        // R17-M5-749: entry-point witness marker — see shell_start_msg
        // rodata comment above. Must come BEFORE dispatch_init so a
        // dispatch_init bug doesn't hide the fact shell reached _start.
        lea rdi, [rip + shell_start_msg];
        mov rsi, 12;                    // len excludes trailing NUL
        call sys_debug_puts;

        call dispatch_init;
        // R86.M1-006 (#1959): cwd_init retired -- every task's
        // TASK_OFF_CWD is now stamped by the kernel's task_new (root
        // vnode idx 1) at construction time, so userspace no longer
        // needs its own "/" bootstrap.

        // R65v2.M1-003 (#1981): scan envp for "HOME=" and chdir there
        // before the first prompt. Every task's TASK_OFF_CWD already
        // defaults to root ("/") per R86.M1-006 (#1959) above, so an
        // absent envp, a scan miss, or a failed sys_chdir all leave the
        // shell at "/" with no further action needed — silent by design,
        // no fingerprint either way (design/user/persistent-home.md §4).
        cmp r12, 0;
        je shell_home_done;              // no envp -- stay at "/"

        xor r13, r13;                    // r13 = envp index i

      shell_home_scan:
        cmp r13, 16;                     // execve-abi.md hard cap: <=16 entries
        jge shell_home_done;

        mov rax, [r12 + r13*8];          // rax = envp[i]
        cmp rax, 0;
        je shell_home_done;              // NULL terminator -- no HOME found

        mov r14, rax;                    // r14 = candidate "KEY=VALUE\0" ptr
        xor r15, r15;                    // r15 = matched-prefix-chars counter
        lea rdi, [rip + shell_home_prefix]; // "HOME=\0" (5 significant chars)

      shell_home_cmp:
        cmp r15, 5;
        jge shell_home_match;

        xor rax, rax;
        mov_b rax, [r14 + r15*1];
        xor rdx, rdx;
        mov_b rdx, [rdi + r15*1];
        cmp rax, rdx;
        jne shell_home_next;

        inc r15;
        jmp shell_home_cmp;

      shell_home_match:
        // r14 + 5 is the value ("...operator\0"); compute its length
        // (bounded 255, matching SYS_CHDIR_PATH_MAX-1) via a NUL-scan.
        lea rdi, [r14 + 5];
        xor rsi, rsi;                    // rsi = length

      shell_home_strlen:
        cmp rsi, 255;
        jge shell_home_call;
        xor rax, rax;
        mov_b rax, [rdi + rsi*1];
        cmp rax, 0;
        je shell_home_call;
        inc rsi;
        jmp shell_home_strlen;

      shell_home_call:
        call sys_chdir;                  // rax = 0 | negative errno (ignored
                                          // -- silent by design, see header)
        jmp shell_home_done;

      shell_home_next:
        inc r13;
        jmp shell_home_scan;

      shell_home_done:

        // main_loop:
main_loop:
        // emit prompt
        lea rdi, [rip + prompt_msg];
        call puts_new;

        // read line into line_buf, max 255 bytes (leave slot 255 for #670 NUL)
        lea rdi, [rip + line_buf];
        mov rsi, 255;
        call shell_read_line;

        // if bytes_read == 0 → exit (Ctrl-D / EOF)
        cmp rax, 0;
        je exit_on_eof;

        // #670: always NUL-terminate at line_buf[bytes_read] so tokens are C-strings
        // even when the buffer-full or missing-newline path is hit in tokenize.
        xor rcx, rcx;
        lea r8, [rip + line_buf];
        add r8, rax;
        mov [r8], cl;

        // tokenize the line first (returns argc in rax; also stored in argc slot)
        mov rsi, rax;           // rsi = bytes_read
        lea rdi, [rip + line_buf];
        call tokenize;

        // #628: empty line → skip dispatch, reprompt
        cmp rax, 0;
        je main_loop;

        // dispatch the line (walk builtin table, dispatch_line takes no args)
        call dispatch_line;
        cmp rax, 0;
        je main_loop;

        // rax==1: builtin miss — fork+execve argv[0] and wait
        call exec_child;

        // loop
        jmp main_loop;

exit_on_eof:
        mov rdi, 0;
        call builtin_exit;

        // unreachable
        ret
      }
    }
}
