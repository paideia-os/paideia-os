// src/user/shell.pdx — R17-M3-001 (#621) + R17-M3-002 (#622)
// Interactive shell: prompt, read line (byte-by-byte until '\n'), dispatch (stub for now), loop.
// Acceptance: builds; runs to prompt; reads line byte-by-byte; stops at '\n' or EOF or buffer full.
// See design/kernel/r17-m3-001-shell-main-loop.md and design/kernel/r17-m3-002-shell-line-reader.md.

module Shell = structure {
  pub let prompt_msg : [u8; 3] = "$ \0"
  pub let prompt_len : u64 = 2

  // R17-M5-749 (paideia-os #749): entry-point witness marker. Emitted as
  // the very first thing shell._start does, via sys_debug_puts, before
  // dispatch_init. Its presence on serial log proves that
  // (1) init's fork+execve("/bin/sh") landed control in shell's _start,
  // (2) the ELF loader placed e_entry correctly, (3) syscall_shim
  // resolves against the kernel's SC+ dispatch. sys_debug_puts is
  // length-bounded and bypasses the tty layer, so it lands on serial
  // even if tty state has an issue.
  //
  // 12 bytes on wire (excludes trailing NUL); rodata storage 13 bytes.
  pub let shell_start_msg : [u8; 13] = "SHELL START\n\0"
  pub let shell_start_len : u64 = 12

  pub let mut line_buf : [u8; 256] = uninit @align(8)

  // R65v2.M1-003 (#1981): shell chdir-on-entry to $HOME.
  //
  // R106.M2 (paideia-os #2229) regression note: init.pdx retargeted its
  // envp HOME value from the R65v2 hardcoded "HOME=/home/operator"
  // (8-byte value) to the R106 content-addressed
  // "HOME=/home/<64-hex-placeholder>/" shape (70-byte value, sourced
  // from FounderConstants.fc_placeholder_home_path). No code change was
  // needed here: shell_home_match's prefix compare only inspects the
  // fixed 5-byte "HOME=" key, and shell_home_strlen computes the
  // value's length via a NUL-scan bounded at 255 rather than assuming
  // any fixed width, so the longer fingerprint-shaped value is picked
  // up unchanged. See design/roadmap/persistent-home-wave.md §R106.M2.
  pub let shell_home_prefix : [u8; 6] = "HOME=\0"

  // shell_read_line(buf, sz) -> bytes_read (rax).
  // Read bytes from stdin (fd 0) into buf, one byte at a time via sys_read(0, buf, 1).
  // Stop when: (1) newline found (0x0A), (2) EOF (bytes_read from syscall == 0), or (3) buffer full (rcx >= sz).
  // Returns total bytes read (including the newline if present).
  pub let shell_read_line : (u64, u64) -> u64 !{mem, sysreg} @{fs} =
    fn (buf: u64) (sz: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {fs},
      justification: "R17-m3-002 (#622): shell_read_line reads from stdin byte-by-byte until newline, EOF, or buffer full. buf in rdi, sz in rsi. Loop: sys_read(0, current_buf_ptr, 1), check if byte is 0x0A or syscall returned 0, increment counter and pointer, continue. Returns total bytes read in rax. #722 fix: original body kept buf/sz/counter in r8/r9/rcx — caller-save arg registers per SysV — which the syscall entry path clobbers (kernel entry.pdx L42 does `mov r8, r10` shuffling SYSCALL ABI → SysV C ABI). Switched to callee-save r12 (buf), r13 (sz), r14 (counter) with SysV prologue push/pop discipline.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;           // r12 = buf (callee-save, survives sys_read)
        mov r13, rsi;           // r13 = sz  (callee-save)
        xor r14, r14;           // r14 = bytes_read counter (callee-save)

read_loop:
        // if r14 >= r13: break (buffer full)
        cmp r14, r13;
        jge read_done;

        // call sys_read(0, r12, 1) — read one byte
        mov rdi, 0;             // rdi = fd (stdin)
        mov rsi, r12;           // rsi = current buffer pointer
        mov rdx, 1;             // rdx = count (1 byte)
        call sys_read;

        // if rax <= 0: EOF or error, break
        cmp rax, 0;
        jle read_done;

        // byte is now at [r12]. Increment counter and pointer
        inc r14;
        mov al, [r12];          // al = byte we just read
        inc r12;

        // Mitigate paideia-as #1248: explicitly zero upper bits of rax before cmp al, 0x0A
        // (paideia-as currently emits cmp al, imm8 as cmp rax, imm8 with REX.W)
        and rax, 0xff;

        // if byte == 0x0A (newline): break
        cmp al, 0x0A;
        je read_done;

        // loop
        jmp read_loop;

read_done:
        mov rax, r14;           // return bytes_read in rax
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // _start — user program entry point. Main loop: prompt → read → tokenize → dispatch → loop.
  // Never returns (sys_exit_thread on Ctrl-D or builtin_exit).
  pub let _start : () -> () !{mem, sysreg} @{fs, cap, sched} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {fs, cap, sched},
      justification: "R17-m3-001 (#621) + R17-m3-002 (#622) + R17-m3-003 (#623) + R17-m3-004 (#624) + R17-m3-005 (#625) + R17-m5-749 (paideia-os #749) + R65v2.M1-003 (#1981): shell _start main loop. FIRST, before anything else, stashes envp (rdx per design/user/execve-abi.md) into callee-save r12 -- the very next instruction (the witness-marker sys_debug_puts) is free to clobber rdx as a caller-save register, so this capture cannot be deferred even by one call. R17-M5-749: emits 'SHELL START\\n' via sys_debug_puts (12 bytes) as an entry-point witness marker — proves init's fork+execve('/bin/sh') transferred control here, independent of tty/dispatch state; lands on serial even if downstream init/read paths have bugs. THEN: initialize dispatch table (dispatch_init). R65v2.M1-003: scans r12 (envp) for an entry whose first 5 bytes match 'HOME=' (mov_b-based byte compare per this codebase's #1248 mitigation discipline, bounded to the execve-abi.md 16-entry cap), and on a match calls sys_chdir(value_ptr, strlen(value_ptr) capped at 255). Both a scan miss (no envp, no HOME entry, cap exhausted) and a failed sys_chdir are silently ignored -- every task's TASK_OFF_CWD already defaults to root ('/') per R86.M1-006 (#1959), so there is nothing to explicitly fall back to. No fingerprint on any path (quiet by design, matching the rootfs-seed loop's own skip-silently discipline). THEN the pre-existing main loop: emit prompt ($ ), read line via shell_read_line into line_buf[256] (byte-by-byte until newline/EOF/full), tokenize the line via tokenize (in-place split into argv[16]), dispatch via dispatch_line (walk builtin table), on dispatch_line miss (rax==1), invoke exec_child to fork+execve argv[0] and wait for the child. Exit on EOF (bytes_read == 0).",
      block: {
        // R65v2.M1-003 (#1981): capture envp (rdx at _start entry per
        // design/user/execve-abi.md) into a callee-save register BEFORE
        // the witness-marker sys_debug_puts call below, which — like
        // every other call in this function — is free to clobber rdx as
        // a caller-save register. envp is 0 if init execve'd /bin/sh
        // without one (pre-R65 behaviour, or any other caller that
        // passes envp=NULL); the scan below treats that identically to
        // "HOME not found".
        mov r12, rdx;                    // r12 = envp

        // R17-M5-749: entry-point witness marker — see shell_start_msg
        // rodata comment above. Must come BEFORE dispatch_init so a
        // dispatch_init bug doesn't hide the fact shell reached _start.
        lea rdi, [rip + shell_start_msg];
        mov rsi, 12;                    // len excludes trailing NUL
        call sys_debug_puts;

        call dispatch_init;
        // R86.M1-006 (#1959): cwd_init retired -- every task's
        // TASK_OFF_CWD is now stamped by the kernel's task_new (root
        // vnode idx 1) at construction time, so userspace no longer
        // needs its own "/" bootstrap.

        // R65v2.M1-003 (#1981): scan envp for "HOME=" and chdir there
        // before the first prompt. Every task's TASK_OFF_CWD already
        // defaults to root ("/") per R86.M1-006 (#1959) above, so an
        // absent envp, a scan miss, or a failed sys_chdir all leave the
        // shell at "/" with no further action needed — silent by design,
        // no fingerprint either way (design/user/persistent-home.md §4).
        cmp r12, 0;
        je shell_home_done;              // no envp -- stay at "/"

        xor r13, r13;                    // r13 = envp index i

      shell_home_scan:
        cmp r13, 16;                     // execve-abi.md hard cap: <=16 entries
        jge shell_home_done;

        mov rax, [r12 + r13*8];          // rax = envp[i]
        cmp rax, 0;
        je shell_home_done;              // NULL terminator -- no HOME found

        mov r14, rax;                    // r14 = candidate "KEY=VALUE\0" ptr
        xor r15, r15;                    // r15 = matched-prefix-chars counter
        lea rdi, [rip + shell_home_prefix]; // "HOME=\0" (5 significant chars)

      shell_home_cmp:
        cmp r15, 5;
        jge shell_home_match;

        xor rax, rax;
        mov_b rax, [r14 + r15*1];
        xor rdx, rdx;
        mov_b rdx, [rdi + r15*1];
        cmp rax, rdx;
        jne shell_home_next;

        inc r15;
        jmp shell_home_cmp;

      shell_home_match:
        // r14 + 5 is the value ("...operator\0"); compute its length
        // (bounded 255, matching SYS_CHDIR_PATH_MAX-1) via a NUL-scan.
        lea rdi, [r14 + 5];
        xor rsi, rsi;                    // rsi = length

      shell_home_strlen:
        cmp rsi, 255;
        jge shell_home_call;
        xor rax, rax;
        mov_b rax, [rdi + rsi*1];
        cmp rax, 0;
        je shell_home_call;
        inc rsi;
        jmp shell_home_strlen;

      shell_home_call:
        call sys_chdir;                  // rax = 0 | negative errno (ignored
                                          // -- silent by design, see header)
        jmp shell_home_done;

      shell_home_next:
        inc r13;
        jmp shell_home_scan;

      shell_home_done:

        // main_loop:
main_loop:
        // emit prompt
        lea rdi, [rip + prompt_msg];
        call puts_new;

        // read line into line_buf, max 255 bytes (leave slot 255 for #670 NUL)
        lea rdi, [rip + line_buf];
        mov rsi, 255;
        call shell_read_line;

        // if bytes_read == 0 → exit (Ctrl-D / EOF)
        cmp rax, 0;
        je exit_on_eof;

        // #670: always NUL-terminate at line_buf[bytes_read] so tokens are C-strings
        // even when the buffer-full or missing-newline path is hit in tokenize.
        xor rcx, rcx;
        lea r8, [rip + line_buf];
        add r8, rax;
        mov [r8], cl;

        // tokenize the line first (returns argc in rax; also stored in argc slot)
        mov rsi, rax;           // rsi = bytes_read
        lea rdi, [rip + line_buf];
        call tokenize;

        // #628: empty line → skip dispatch, reprompt
        cmp rax, 0;
        je main_loop;

        // dispatch the line (walk builtin table, dispatch_line takes no args)
        call dispatch_line;
        cmp rax, 0;
        je main_loop;

        // rax==1: builtin miss — fork+execve argv[0] and wait
        call exec_child;

        // loop
        jmp main_loop;

exit_on_eof:
        mov rdi, 0;
        call builtin_exit;

        // unreachable
        ret
      }
    }
}
