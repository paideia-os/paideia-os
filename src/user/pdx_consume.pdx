// src/user/pdx_consume.pdx -- R121.M5 (paideia-os #2499) canary consumer
//
// Mirror of pdx_produce.pdx (see that file's header for the R121.M5
// CAP-MINT GAP context). Exercises sys_pipe_edge_recv (SC+ ID 132)
// three times against a hardcoded edge_cap_slot=1. Returns are
// -EBADF at M5 (no minted caps in the cap_table) and intentionally
// ignored; the point is dispatch-arm exercise.
//
// SC+ IDs (frozen per src/user/syscall_shim.pdx):
//   12  = sys_debug_puts(buf, count)
//   60  = sys_exit(status)
//   132 = sys_pipe_edge_recv(edge)
//
// Fingerprints:
//   pdx-consume start N=3
//   pdx-consume recv i=0 ... pdx-consume recv i=1 ... pdx-consume recv i=2
//   pdx-consume done

module PdxConsume = structure {
  pub let pc_msg_start     : [u8; 22] = "pdx-consume start N=3\n\0"
  pub let pc_msg_start_len : u64      = 21
  pub let pc_msg_recv0     : [u8; 20] = "pdx-consume recv i=0\n\0"
  pub let pc_msg_recv1     : [u8; 20] = "pdx-consume recv i=1\n\0"
  pub let pc_msg_recv2     : [u8; 20] = "pdx-consume recv i=2\n\0"
  pub let pc_msg_recv_len  : u64      = 20
  pub let pc_msg_done      : [u8; 17] = "pdx-consume done\n\0"
  pub let pc_msg_done_len  : u64      = 16

  pub let _start : () -> () !{mem, sysreg} @{fs, sched, cap} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {fs, sched, cap},
      justification: "R121.M5 (paideia-os #2499) canary consumer: mirror of pdx_produce._start with sys_pipe_edge_recv (SC+ ID 132, arity 1) substituted for sys_pipe_edge_send (arity 2). Same unrolled 3-attempt shape, same fingerprint-around-syscall witness ordering, same self-contained _start (no shim linkage), same CAP-MINT GAP context (recv returns -EBADF absent a minted KIND_PIPELINE_EDGE cap; ignored at M5). Encoder-gap posture identical to pdx_produce. Labels pc_-prefixed to distinguish from producer's pp_.",
      block: {
        // --- pc_msg_start ---
        lea rdi, [rip + pc_msg_start];
        mov rsi, 21;
        mov rax, 12;
        syscall;

        // --- recv i=0 ---
        mov rdi, 1;                      // edge_cap_slot placeholder
        mov rax, 132;                    // SC+ ID sys_pipe_edge_recv
        syscall;
        lea rdi, [rip + pc_msg_recv0];
        mov rsi, 20;
        mov rax, 12;
        syscall;

        // --- recv i=1 ---
        mov rdi, 1;
        mov rax, 132;
        syscall;
        lea rdi, [rip + pc_msg_recv1];
        mov rsi, 20;
        mov rax, 12;
        syscall;

        // --- recv i=2 ---
        mov rdi, 1;
        mov rax, 132;
        syscall;
        lea rdi, [rip + pc_msg_recv2];
        mov rsi, 20;
        mov rax, 12;
        syscall;

        // --- pc_msg_done ---
        lea rdi, [rip + pc_msg_done];
        mov rsi, 16;
        mov rax, 12;
        syscall;

        // --- sys_exit(0) ---
        mov rdi, 0;
        mov rax, 60;
        syscall;
        hlt
      }
    }
}
