// src/user/aml/aml_resource.pdx — R30.M1-005 (#1053)
//
// The ACPI resource-descriptor mini-language, ACPI 6.5 §6.4.
//
// PLACEMENT — CONSTITUTIONAL
// -------------------------
// Userspace only. See design/acpi/no-aml-in-kernel.md. Like aml_term.pdx
// this module declares NO private storage: every byte it reads goes
// through the aml_lex accessor API, so the objdump-r confinement proof in
// tools/verify-aml-parser.sh extends to cover it unchanged.
//
// =====================================================================
// WHAT A RESOURCE TEMPLATE IS, AND WHY THAT IS A PROBLEM
// =====================================================================
// A resource template is a `Buffer` whose CONTENTS happen to be a list of
// resource descriptors — the thing `_CRS`, `_PRS` and `_SRS` return, and
// the only way a driver learns which interrupt, which MMIO window or
// which I2C address its device actually uses.
//
// Nothing in the AML byte stream marks such a buffer. `Buffer` is
// `Buffer`. The distinction is CONTEXTUAL: it comes from the name of the
// object the buffer is the value of, which is knowledge the parser does
// not have and the caller does.
//
// EAGER OR LAZY — AND WHY LAZY
// ----------------------------
// Parsing eagerly, at Buffer-parse time, means reinterpreting EVERY
// buffer in the table as a resource list. Ordinary data buffers are
// common — firmware blobs, UUIDs, EC scratch — and their first byte will
// sometimes land on a plausible small-descriptor tag. Two bad outcomes
// follow: a data buffer acquires a fictitious resource tree that a
// consumer may act on, or a perfectly legal data buffer fails resource
// validation and the whole TABLE is refused. Both are worse than the
// thing eager parsing buys, which is nothing — no consumer needs the
// resource view until it asks for it.
//
// So parsing is LAZY: aml_res_parse is called by a consumer that already
// knows, from context, that this buffer is a template.
//
// THE DISCRIMINATOR IS WHOLE-BUFFER VALIDATION, NOT A SNIFF
// ---------------------------------------------------------
// Context alone is not enough to be safe, because the caller's context
// can be wrong and the bytes are still firmware-supplied. So
// aml_res_is_template answers the question structurally, and it answers
// it over the WHOLE buffer rather than by looking at the first byte:
//
//   every descriptor from the first byte onward has a known tag and an
//   in-bounds length; the walk arrives EXACTLY at an EndTag; the EndTag
//   is the last thing in the buffer; and its checksum byte is either 0
//   ("not computed", which ACPI permits and iasl emits) or makes the sum
//   of every byte in the template zero modulo 256.
//
// A first-byte sniff would accept any buffer beginning 0x22. This
// accepts only a buffer that is a complete, self-consistent, exactly-fitting
// descriptor list. A data buffer passing that test by accident is not a
// realistic concern; a data buffer failing it is simply reported as not a
// template, with nothing allocated and NO ERROR LATCHED — an unhelpful
// question deserves an answer, not a refused parse.
//
// aml_res_parse runs the same validation as its first phase and refuses
// to allocate anything at all if it fails, so a partial resource tree
// built from a bad template cannot exist. That two-phase shape is why
// the building walk below carries no error handling: by the time it runs,
// every length and tag in the buffer has already been proven.
//
// =====================================================================
// DESCRIPTOR ENCODING — §6.4.1, §6.4.2
// =====================================================================
//   SMALL   byte 0 bit 7 = 0; bits [6:3] = item name; bits [2:0] = the
//           number of data bytes that follow. Header is 1 byte.
//   LARGE   byte 0 bit 7 = 1; bits [6:0] = item name; bytes 1..2 = a
//           little-endian u16 data length. Header is 3 bytes.
//
// Small item names: 4 IRQ, 5 DMA, 6 StartDependent, 7 EndDependent,
// 8 IO, 9 FixedIO, 10 FixedDMA, 14 VendorShort, 15 EndTag. Everything
// else is reserved and is refused.
//
// Large item names: 1 Memory24, 2 GenericRegister, 4 VendorLong,
// 5 Memory32, 6 Memory32Fixed, 7 DWordSpace, 8 WordSpace, 9 ExtendedIRQ,
// 10 QWordSpace, 11 ExtendedSpace, 12 GpioConnection, 13 PinFunction,
// 14 GenericSerialBus, 15 PinConfig, 16 PinGroup, 17 PinGroupFunction,
// 18 PinGroupConfig. 0, 3 and anything above 18 are reserved and refused.
//
// PAYLOAD OFFSETS OF THE FIXED-LAYOUT DESCRIPTORS
// -----------------------------------------------
// Offsets below are into the descriptor's DATA payload (after the 1- or
// 3-byte header) and are read with aml_res_u8/u16/u32/u64. They are
// documented here rather than wrapped in one accessor each, because they
// are constants of the specification and a named wrapper per field would
// be sixty functions that add nothing a reader of §6.4 does not have.
// The three families whose offsets are NOT constant — address spaces,
// GPIO and serial bus — do get real accessors, below, because their
// field positions are computed from other fields.
//
//   IRQ (small 4)         u16 @0 interrupt mask; u8 @2 flags when len==3
//   DMA (small 5)         u8  @0 channel mask;  u8 @1 flags
//   IO (small 8)          u8  @0 decode; u16 @1 min; u16 @3 max;
//                         u8  @5 alignment; u8 @6 length
//   FixedIO (small 9)     u16 @0 base; u8 @2 length
//   FixedDMA (small 10)   u16 @0 request line; u16 @2 channel; u8 @4 width
//   EndTag (small 15)     u8  @0 checksum
//   Memory32 (large 5)    u8  @0 info; u32 @1 min; u32 @5 max;
//                         u32 @9 alignment; u32 @13 length
//   Memory32Fixed (6)     u8  @0 info; u32 @1 base; u32 @5 length
//   ExtendedIRQ (9)       u8  @0 flags; u8 @1 count; u32 @2.. the vectors
//
// =====================================================================
// NODE KINDS
// =====================================================================
//   42 RESOURCE  the decoded template; parent is the BUFFER node,
//                arg0/arg1 = the descriptor-list extent
//   43 RESDESC   one descriptor; flags[7:0] = item name, flags[8] = 1 for
//                the large form; arg0 = offset of the tag byte,
//                arg1 = one past the descriptor's last byte
//
// The descriptor's PAYLOAD is not copied into the arena — arg0/arg1
// delimit it in the AML buffer and the accessors read it there. This is
// the same discipline src_off establishes for every other fixed operand,
// and it is what lets a _CRS with forty descriptors cost forty 32-byte
// nodes rather than a copy of the buffer.
//
// ERROR CODES (the taxonomy continues at 25)
// ------------------------------------------
//   25 AML_ERR_RES_CHECKSUM   EndTag checksum is non-zero and wrong
//   26 AML_ERR_RES_TRUNCATED  a descriptor runs past the buffer end
//   27 AML_ERR_RES_LENGTH     a large descriptor's length field overruns
//   28 AML_ERR_RES_NO_ENDTAG  no EndTag, or bytes after it
//   29 AML_ERR_RES_BAD_TAG    reserved or unknown item name
//
// TRUNCATED versus LENGTH is not pedantry. TRUNCATED says the buffer ran
// out under a descriptor whose header was believable; LENGTH says the
// descriptor's own 16-bit length field claims more bytes than exist.
// The first is a table that was cut short, the second is a length field
// that lies — and on firmware, those have different causes and different
// fixes.

module AmlResource = structure {

  // ==========================================================================
  // aml_res_at(off) -> the byte at absolute offset off.
  // ==========================================================================
  pub let aml_res_at : (u64) -> u64 !{mem} @{} =
    fn (off: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-005 (#1053): read the AML buffer byte at absolute offset rdi by repositioning the cursor and taking one byte through aml_lex_u8. Random access is expressed as seek-then-read rather than as a pointer computation because aml_lex_u8 is one of exactly two functions permitted to dereference the buffer (invariant I1), and the whole confinement proof rests on that staying true. The cost is one extra call per byte, which a resource template of a few dozen bytes does not notice. Both callees fail closed: a seek outside the buffer is refused and a read after a latched error returns 0 without touching memory, so this function cannot over-read even if handed nonsense. Reserved labels: none.",
      block: {
        call aml_lex_seek;
        call aml_lex_u8;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Tag admissibility. Reserved item names are refused, not tolerated.
  // ==========================================================================

  pub let aml_res_small_ok : (u64) -> u64 !{} @{} =
    fn (tag: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R30.M1-005 (#1053): 1 when rdi is a small resource item name ACPI 6.5 §6.4.2 defines -- 4 IRQ, 5 DMA, 6 StartDependent, 7 EndDependent, 8 IO, 9 FixedIO, 10 FixedDMA, 14 VendorShort, 15 EndTag. Reserved names are refused rather than skipped by their length byte, because a reserved tag in a buffer a caller believes is a template is evidence the caller is wrong about the buffer, and continuing would then decode ordinary data as resources. Pure. Reserved labels: aml_rso_.",
      block: {
        cmp rdi, 4;
        jb aml_rso_no;
        cmp rdi, 10;
        jbe aml_rso_yes;
        cmp rdi, 14;
        je aml_rso_yes;
        cmp rdi, 15;
        je aml_rso_yes;
      aml_rso_no:
        xor rax, rax;
        ret;
      aml_rso_yes:
        mov rax, 1;
        ret
      }
    } @no_frame

  pub let aml_res_large_ok : (u64) -> u64 !{} @{} =
    fn (tag: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R30.M1-005 (#1053): 1 when rdi is a large resource item name ACPI 6.5 §6.4.3 defines -- 1 Memory24, 2 GenericRegister, and the contiguous run 4 VendorLong through 18 PinGroupConfig. 0 and 3 are reserved and 19 upward is undefined, so both are refused. Pure. Reserved labels: aml_rlo_.",
      block: {
        cmp rdi, 1;
        je aml_rlo_yes;
        cmp rdi, 2;
        je aml_rlo_yes;
        cmp rdi, 4;
        jb aml_rlo_no;
        cmp rdi, 18;
        jbe aml_rlo_yes;
      aml_rlo_no:
        xor rax, rax;
        ret;
      aml_rlo_yes:
        mov rax, 1;
        ret
      }
    } @no_frame

  // ==========================================================================
  // aml_res_validate(start, end) -> 0 when [start, end) is a well-formed
  // resource template, otherwise the error code that describes why not.
  //
  // LATCHES NOTHING. This is a question, not a parse.
  // ==========================================================================
  pub let aml_res_validate : (u64, u64) -> u64 !{mem} @{} =
    fn (start: u64) (end_off: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-005 (#1053): decide whether [rdi, rsi) is a complete resource-descriptor list, RETURNING a code rather than latching one. Not latching is the whole reason this is a separate function from aml_res_parse: aml_res_is_template asks it speculatively about buffers that are probably not templates at all, and a speculative question must not poison a parse that is otherwise fine. It can afford not to check for read errors because every read it issues is inside [start, end), which is inside the buffer by construction -- so aml_lex_u8 cannot reach its EOF path. The walk enforces four separate properties, each with its own code: every tag is one the specification defines (29), every descriptor's extent stays inside the buffer (26), a large descriptor's own length field does not claim more than exists (27), and the walk lands EXACTLY on an EndTag that is the last thing present (28). Only then is the checksum evaluated, and a zero checksum byte is accepted as 'not computed' per §6.4.2.9 rather than being treated as a failed sum -- that byte is what iasl emits for a template it did not checksum, so rejecting it would refuse most real _CRS buffers. Locals: r12=cursor, r13=end, r14=tag byte then checksum accumulator, r15=item name then byte counter; [rsp+0]=start, [rsp+8]=length scratch. Reserved labels: aml_rv_.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 16;
        mov [rsp + 0], rdi;
        mov r12, rdi;
        mov r13, rsi;
      aml_rv_loop:
        cmp r12, r13;
        jae aml_rv_noend;
        mov rdi, r12;
        call aml_res_at;
        mov r14, rax;
        mov rcx, r14;
        and rcx, 0x80;
        cmp rcx, 0;
        jne aml_rv_large;

        // ---- small: 1-byte header, length in bits [2:0] ----
        mov r15, r14;
        shr r15, 3;
        and r15, 0x0F;
        mov rdi, r15;
        call aml_res_small_ok;
        cmp rax, 0;
        je aml_rv_badtag;
        mov rcx, r14;
        and rcx, 0x07;                   // data length
        mov rax, r12;
        add rax, 1;
        add rax, rcx;                    // one past this descriptor
        cmp rax, r13;
        ja aml_rv_trunc;
        cmp r15, 0x0F;
        je aml_rv_endtag;
        mov r12, rax;
        jmp aml_rv_loop;

        // ---- large: 3-byte header, little-endian u16 length ----
      aml_rv_large:
        mov r15, r14;
        and r15, 0x7F;
        mov rdi, r15;
        call aml_res_large_ok;
        cmp rax, 0;
        je aml_rv_badtag;
        mov rax, r12;
        add rax, 3;
        cmp rax, r13;
        ja aml_rv_trunc;                 // the header itself is cut short
        mov rdi, r12;
        add rdi, 1;
        call aml_res_at;
        mov [rsp + 8], rax;
        mov rdi, r12;
        add rdi, 2;
        call aml_res_at;
        shl rax, 8;
        mov rcx, [rsp + 8];
        or rax, rcx;                     // declared payload length
        mov rcx, rax;
        mov rax, r12;
        add rax, 3;
        add rax, rcx;
        cmp rax, r13;
        ja aml_rv_length;                // the length field itself lies
        mov r12, rax;
        jmp aml_rv_loop;

        // ---- EndTag: must be 0x79, last, and checksum-consistent ----
      aml_rv_endtag:
        mov rcx, r14;
        and rcx, 0x07;
        cmp rcx, 1;                      // EndTag always carries one byte
        jne aml_rv_trunc;
        mov rcx, r12;
        add rcx, 2;
        cmp rcx, r13;
        jne aml_rv_noend;                // bytes after the EndTag
        mov rdi, r12;
        add rdi, 1;
        call aml_res_at;
        cmp rax, 0;
        je aml_rv_ok;                    // §6.4.2.9: 0 means "not computed"
        mov rdi, [rsp + 0];
        call aml_lex_seek;
        mov r15, r12;
        add r15, 2;
        mov rcx, [rsp + 0];
        sub r15, rcx;                    // bytes covered by the checksum
        xor r14, r14;
      aml_rv_sum:
        cmp r15, 0;
        je aml_rv_sumdone;
        call aml_lex_u8;
        add r14, rax;
        sub r15, 1;
        jmp aml_rv_sum;
      aml_rv_sumdone:
        and r14, 0xFF;
        cmp r14, 0;
        jne aml_rv_cksum;
      aml_rv_ok:
        xor rax, rax;
        jmp aml_rv_ret;
      aml_rv_cksum:
        mov rax, 25;                     // AML_ERR_RES_CHECKSUM
        jmp aml_rv_ret;
      aml_rv_trunc:
        mov rax, 26;                     // AML_ERR_RES_TRUNCATED
        jmp aml_rv_ret;
      aml_rv_length:
        mov rax, 27;                     // AML_ERR_RES_LENGTH
        jmp aml_rv_ret;
      aml_rv_noend:
        mov rax, 28;                     // AML_ERR_RES_NO_ENDTAG
        jmp aml_rv_ret;
      aml_rv_badtag:
        mov rax, 29;                     // AML_ERR_RES_BAD_TAG
      aml_rv_ret:
        add rsp, 16;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    } @no_frame

  // ==========================================================================
  // aml_res_is_template(node) -> 1 when the BUFFER node's contents are a
  // well-formed resource template. Latches nothing, allocates nothing.
  // ==========================================================================
  pub let aml_res_is_template : (u64) -> u64 !{mem} @{} =
    fn (node: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-005 (#1053): the discriminator. Answers, for the AML_NODE_BUFFER rdi, whether its initialiser bytes form a complete resource-descriptor list. Refuses to answer -- returning 0 -- when a parse error is already latched, because every read would then be blocked by invariant I2 and the walk would validate a buffer of zeroes rather than the real one. Restores the cursor before returning, so a consumer may ask this question in the middle of anything without disturbing it. The answer is deliberately a BOOLEAN and not the reason: a buffer that is not a template is not an error, it is a buffer, and the caller that asked usually just wants to move on. aml_res_parse is what turns the same failure into a diagnosable code. Locals: r12=node, r13=saved cursor, r14=result. Reserved labels: aml_rit_.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        call aml_lex_err;
        cmp rax, 0;
        jne aml_rit_no;
        mov rdi, r12;
        call aml_node_kind;
        cmp rax, 35;                     // AML_NODE_BUFFER
        jne aml_rit_no;
        call aml_lex_pos;
        mov r13, rax;
        mov rdi, r12;
        call aml_node_arg0;
        mov r14, rax;
        mov rdi, r12;
        call aml_node_arg1;
        mov rdi, r14;
        mov rsi, rax;
        call aml_res_validate;
        mov r14, rax;
        mov rdi, r13;
        call aml_lex_seek;               // leave the cursor where it was
        cmp r14, 0;
        jne aml_rit_no;
        mov rax, 1;
        pop r14;
        pop r13;
        pop r12;
        ret;
      aml_rit_no:
        xor rax, rax;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    } @no_frame

  // ==========================================================================
  // aml_res_build(res_node, start, end) -> the descriptor count.
  //
  // The second phase. Runs ONLY on a buffer aml_res_validate has already
  // accepted, which is why it carries no error handling of its own.
  // ==========================================================================
  pub let aml_res_build : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (res_node: u64) (start: u64) (end_off: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-005 (#1053): emit one AML_NODE_RESDESC child of rdi per descriptor in [rsi, rdx). Carries no structural error handling because it is unreachable except behind a successful aml_res_validate, and duplicating the checks here would mean two implementations of the tag and length arithmetic that could disagree -- the failure mode being a tree that describes something the validator never saw. The only failure it does handle is arena exhaustion, which stops the walk and leaves the sticky latch to report it. The EndTag is emitted as a node like any other so a consumer can reach its checksum byte, and the walk stops there rather than at the buffer end, so trailing bytes cannot become a phantom descriptor. Locals: r12=cursor, r13=end, r14=resource node, r15=count; [rsp+0]=tag byte, [rsp+8]=item name, [rsp+16]=descriptor end, [rsp+24]=large flag. Reserved labels: aml_rb_.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 32;
        mov r14, rdi;
        mov r12, rsi;
        mov r13, rdx;
        xor r15, r15;
      aml_rb_loop:
        cmp r12, r13;
        jae aml_rb_out;
        mov rdi, r12;
        call aml_res_at;
        mov [rsp + 0], rax;
        mov rcx, rax;
        and rcx, 0x80;
        cmp rcx, 0;
        jne aml_rb_large;
        mov rax, [rsp + 0];
        mov rcx, rax;
        shr rcx, 3;
        and rcx, 0x0F;
        mov [rsp + 8], rcx;              // item name
        and rax, 0x07;
        add rax, 1;
        add rax, r12;
        mov [rsp + 16], rax;             // one past the descriptor
        xor rax, rax;
        mov [rsp + 24], rax;
        jmp aml_rb_emit;
      aml_rb_large:
        mov rax, [rsp + 0];
        and rax, 0x7F;
        mov [rsp + 8], rax;
        mov rdi, r12;
        add rdi, 1;
        call aml_res_at;
        mov [rsp + 16], rax;
        mov rdi, r12;
        add rdi, 2;
        call aml_res_at;
        shl rax, 8;
        mov rcx, [rsp + 16];
        or rax, rcx;
        add rax, 3;
        add rax, r12;
        mov [rsp + 16], rax;
        mov rax, 1;
        mov [rsp + 24], rax;
      aml_rb_emit:
        mov rdi, 43;                     // AML_NODE_RESDESC
        xor rsi, rsi;
        mov rdx, r14;
        mov rcx, r12;
        call aml_node_alloc;
        cmp rax, 0;
        je aml_rb_out;
        mov rcx, rax;
        mov rax, [rsp + 24];
        shl rax, 8;                      // large flag at bit 8
        mov rdx, [rsp + 8];
        or rax, rdx;
        mov rdi, rcx;
        mov rsi, rax;
        push rcx;
        call aml_node_set_flags;
        pop rcx;
        mov rdi, rcx;
        mov rsi, r12;
        mov rdx, [rsp + 16];
        call aml_node_set_args;
        add r15, 1;
        mov rax, [rsp + 24];
        cmp rax, 0;
        jne aml_rb_next;
        mov rax, [rsp + 8];
        cmp rax, 0x0F;                   // EndTag closes the list
        je aml_rb_out;
      aml_rb_next:
        mov r12, [rsp + 16];
        jmp aml_rb_loop;
      aml_rb_out:
        mov rax, r15;
        add rsp, 32;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    } @no_frame

  // ==========================================================================
  // aml_res_parse(node) -> the AML_NODE_RESOURCE index, 0 on refusal.
  // ==========================================================================
  pub let aml_res_parse : (u64) -> u64 !{mem} @{} =
    fn (node: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-005 (#1053): decode the AML_NODE_BUFFER rdi as a resource template. Validate first, allocate second: nothing at all is added to the arena unless the entire buffer has been proven to be a well-formed descriptor list, so there is no state in which a consumer can find a half-built resource tree and act on it. A validation failure latches the specific code -- checksum, truncated, length, no-endtag or bad-tag -- which is the difference between this entry point and aml_res_is_template: a caller who asserts the buffer IS a template wants to know why it is not, while a caller who is merely asking does not. A node that is not a Buffer returns 0 without latching, since that is a caller bug rather than a firmware one and poisoning the parse would misattribute it. The cursor is restored on every path. Locals: r12=node, r13=saved cursor, r14=start, r15=end. Reserved labels: aml_rp_.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;
        mov r12, rdi;
        call aml_node_kind;
        cmp rax, 35;                     // AML_NODE_BUFFER
        jne aml_rp_fail;
        call aml_lex_pos;
        mov r13, rax;
        mov rdi, r12;
        call aml_node_arg0;
        mov r14, rax;
        mov rdi, r12;
        call aml_node_arg1;
        mov r15, rax;
        mov rdi, r14;
        mov rsi, r15;
        call aml_res_validate;
        cmp rax, 0;
        jne aml_rp_bad;
        mov rdi, 42;                     // AML_NODE_RESOURCE
        xor rsi, rsi;
        mov rdx, r12;
        mov rcx, r14;
        call aml_node_alloc;
        cmp rax, 0;
        je aml_rp_restore;
        mov r12, rax;
        mov rdi, r12;
        mov rsi, r14;
        mov rdx, r15;
        call aml_node_set_args;
        mov rdi, r12;
        mov rsi, r14;
        mov rdx, r15;
        call aml_res_build;
        mov rdi, r13;
        call aml_lex_seek;
        call aml_lex_err;
        cmp rax, 0;
        jne aml_rp_fail;
        mov rax, r12;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret;
      aml_rp_bad:
        mov rdi, rax;
        call aml_lex_set_err;
      aml_rp_restore:
        mov rdi, r13;
        call aml_lex_seek;
      aml_rp_fail:
        xor rax, rax;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Descriptor accessors.
  // ==========================================================================

  pub let aml_res_tag : (u64) -> u64 !{mem} @{} =
    fn (desc: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-005 (#1053): the resource item name of descriptor node rdi -- flags[7:0]. Small and large names share the accessor because they are disjoint in practice: a consumer tests aml_res_large first when it matters. Reserved labels: none.",
      block: {
        call aml_node_flags;
        and rax, 0xFF;
        ret
      }
    } @no_frame

  pub let aml_res_large : (u64) -> u64 !{mem} @{} =
    fn (desc: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-005 (#1053): flags[8] of descriptor node rdi -- 1 for the large form, whose header is three bytes rather than one. Kept as a stored bit rather than re-derived from the source byte so that a consumer walking the tree never has to touch the AML buffer to know the shape of a node. Reserved labels: none.",
      block: {
        call aml_node_flags;
        shr rax, 8;
        and rax, 0x01;
        ret
      }
    } @no_frame

  pub let aml_res_data_off : (u64) -> u64 !{mem} @{} =
    fn (desc: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-005 (#1053): the absolute offset of descriptor rdi's first PAYLOAD byte -- the tag offset plus one for a small descriptor or three for a large one. Every typed read below is expressed relative to this, so the small/large header difference is handled in exactly one place. Locals: r12=descriptor node. Reserved labels: aml_rdo_.",
      block: {
        push r12;
        mov r12, rdi;
        call aml_node_arg0;
        push rax;
        mov rdi, r12;
        call aml_res_large;
        pop rcx;
        cmp rax, 0;
        je aml_rdo_small;
        add rcx, 3;
        mov rax, rcx;
        pop r12;
        ret;
      aml_rdo_small:
        add rcx, 1;
        mov rax, rcx;
        pop r12;
        ret
      }
    } @no_frame

  pub let aml_res_data_len : (u64) -> u64 !{mem} @{} =
    fn (desc: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-005 (#1053): the payload length of descriptor rdi, computed as arg1 minus the payload offset rather than re-read from the encoded length field. Those two agree by construction because aml_res_build derived arg1 from that same field, and deriving it here again would be a second decode that could drift. Locals: r12=descriptor node, r13=payload offset. Reserved labels: aml_rdl_.",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        call aml_res_data_off;
        mov r13, rax;
        mov rdi, r12;
        call aml_node_arg1;
        cmp rax, r13;
        jbe aml_rdl_zero;
        sub rax, r13;
        pop r13;
        pop r12;
        ret;
      aml_rdl_zero:
        xor rax, rax;
        pop r13;
        pop r12;
        ret
      }
    } @no_frame

  // ==========================================================================
  // aml_res_read(desc, off, width) -> a little-endian field of the payload.
  // ==========================================================================
  pub let aml_res_read : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (desc: u64) (off: u64) (width: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-005 (#1053): read the little-endian field of rdx bytes at payload offset rsi of descriptor rdi. THREE bounds are enforced before anything is read: the width must be 1, 2, 4 or 8; the field must lie entirely within THIS DESCRIPTOR, tested against the descriptor's own arg1; and it must lie within the bound buffer. The middle one is the one that matters and the one it is tempting to omit -- a wrong payload offset would otherwise read the NEIGHBOURING descriptor's bytes and return a perfectly plausible value, which is the characteristic failure of a hand-written resource decoder and produces a driver programmed for the wrong device rather than a fault. Out of range yields 0. The cursor is saved and restored on every path, so an accessor may be called at any point without disturbing a parse in progress. Frame: [rsp+0]=descriptor node, [rsp+8]=payload offset. Locals: r12=absolute field offset, r13=width, r14=saved cursor, r15=one past the field. Reserved labels: aml_rr_.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 16;
        mov [rsp + 0], rdi;
        mov [rsp + 8], rsi;
        mov r13, rdx;
        call aml_lex_pos;
        mov r14, rax;
        mov rdi, [rsp + 0];
        call aml_res_data_off;
        mov r12, rax;
        mov rcx, [rsp + 8];
        add r12, rcx;                    // absolute offset of the field
        mov r15, r12;
        add r15, r13;                    // one past the field
        cmp r13, 1;
        je aml_rr_indesc;
        cmp r13, 2;
        je aml_rr_indesc;
        cmp r13, 4;
        je aml_rr_indesc;
        cmp r13, 8;
        jne aml_rr_zero;
      aml_rr_indesc:
        mov rdi, [rsp + 0];
        call aml_node_arg1;              // the descriptor's own end
        cmp r15, rax;
        ja aml_rr_zero;                  // would spill into the next one
        mov rdi, r12;
        mov rsi, r15;
        call aml_res_span_ok;
        cmp rax, 0;
        je aml_rr_zero;
        mov rdi, r12;
        call aml_lex_seek;
        cmp r13, 1;
        je aml_rr_b;
        cmp r13, 2;
        je aml_rr_w;
        cmp r13, 4;
        je aml_rr_d;
        call aml_lex_u64;
        jmp aml_rr_done;
      aml_rr_b:
        call aml_lex_u8;
        jmp aml_rr_done;
      aml_rr_w:
        call aml_lex_u16;
        jmp aml_rr_done;
      aml_rr_d:
        call aml_lex_u32;
      aml_rr_done:
        mov r15, rax;
        mov rdi, r14;
        call aml_lex_seek;
        mov rax, r15;
        jmp aml_rr_ret;
      aml_rr_zero:
        mov rdi, r14;
        call aml_lex_seek;
        xor rax, rax;
      aml_rr_ret:
        add rsp, 16;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    } @no_frame

  pub let aml_res_span_ok : (u64, u64) -> u64 !{mem} @{} =
    fn (lo: u64) (hi: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-005 (#1053): 1 when [rdi, rsi) lies inside the currently bound AML buffer. Split out of aml_res_read so the containment test is one named thing rather than an inline comparison buried in a register shuffle, and so the harness can exercise it directly. Reserved labels: aml_rsk_.",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        mov r13, rsi;
        call aml_lex_len;
        cmp r13, rax;
        ja aml_rsk_no;
        cmp r12, r13;
        ja aml_rsk_no;
        mov rax, 1;
        pop r13;
        pop r12;
        ret;
      aml_rsk_no:
        xor rax, rax;
        pop r13;
        pop r12;
        ret
      }
    } @no_frame

  pub let aml_res_u8 : (u64, u64) -> u64 !{mem} @{} =
    fn (desc: u64) (off: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-005 (#1053): the byte at payload offset rsi of descriptor rdi. Reserved labels: none.",
      block: {
        mov rdx, 1;
        call aml_res_read;
        ret
      }
    } @no_frame

  pub let aml_res_u16 : (u64, u64) -> u64 !{mem} @{} =
    fn (desc: u64) (off: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-005 (#1053): the little-endian 16-bit field at payload offset rsi of descriptor rdi -- an IRQ mask, an IO port bound, a GPIO pin number. Reserved labels: none.",
      block: {
        mov rdx, 2;
        call aml_res_read;
        ret
      }
    } @no_frame

  pub let aml_res_u32 : (u64, u64) -> u64 !{mem} @{} =
    fn (desc: u64) (off: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-005 (#1053): the little-endian 32-bit field at payload offset rsi of descriptor rdi -- a Memory32Fixed base or length, an I2C connection speed. Reserved labels: none.",
      block: {
        mov rdx, 4;
        call aml_res_read;
        ret
      }
    } @no_frame

  pub let aml_res_u64 : (u64, u64) -> u64 !{mem} @{} =
    fn (desc: u64) (off: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-005 (#1053): the little-endian 64-bit field at payload offset rsi of descriptor rdi -- the granularity, bounds and length of a QWord address-space descriptor. Reserved labels: none.",
      block: {
        mov rdx, 8;
        call aml_res_read;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Address-space descriptors — Word (8), DWord (7), QWord (10).
  //
  // Their payload is ResourceType(1) GeneralFlags(1) TypeFlags(1) then five
  // fields of the SAME width W: Granularity, Min, Max, TranslationOffset,
  // Length. W is 2, 4 or 8 depending on the item name, so the offsets are
  // computed rather than constant — which is why these get accessors and
  // the fixed-layout descriptors in the header table do not.
  // ==========================================================================

  pub let aml_res_space_width : (u64) -> u64 !{mem} @{} =
    fn (desc: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-005 (#1053): the field width of address-space descriptor rdi -- 2 for WordSpace (item 8), 4 for DWordSpace (7), 8 for QWordSpace (10), and 0 for anything else, which makes 0 the natural 'this is not an address-space descriptor' answer and stops the min/max/length accessors from computing offsets into a descriptor that has no such fields. ExtendedSpace (11) is deliberately excluded: it has a different layout and would need its own accessors. Reserved labels: aml_rsw_.",
      block: {
        call aml_res_tag;
        cmp rax, 8;
        je aml_rsw_w;
        cmp rax, 7;
        je aml_rsw_d;
        cmp rax, 10;
        je aml_rsw_q;
        xor rax, rax;
        ret;
      aml_rsw_w:
        mov rax, 2;
        ret;
      aml_rsw_d:
        mov rax, 4;
        ret;
      aml_rsw_q:
        mov rax, 8;
        ret
      }
    } @no_frame

  pub let aml_res_space_min : (u64) -> u64 !{mem} @{} =
    fn (desc: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-005 (#1053): the Minimum address of address-space descriptor rdi, at payload offset 3 + W where W is the descriptor's field width. Returns 0 when the descriptor is not an address space at all, because aml_res_space_width yields 0 there and the read is then a zero-width one that aml_res_read refuses. Locals: r12=descriptor, r13=width. Reserved labels: aml_rsm_.",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        call aml_res_space_width;
        mov r13, rax;
        mov rdi, r12;
        mov rsi, 3;
        add rsi, r13;
        mov rdx, r13;
        call aml_res_read;
        pop r13;
        pop r12;
        ret
      }
    } @no_frame

  pub let aml_res_space_max : (u64) -> u64 !{mem} @{} =
    fn (desc: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-005 (#1053): the Maximum address of address-space descriptor rdi, at payload offset 3 + 2W. Locals: r12=descriptor, r13=width. Reserved labels: none.",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        call aml_res_space_width;
        mov r13, rax;
        mov rdi, r12;
        mov rsi, 3;
        add rsi, r13;
        add rsi, r13;
        mov rdx, r13;
        call aml_res_read;
        pop r13;
        pop r12;
        ret
      }
    } @no_frame

  pub let aml_res_space_len : (u64) -> u64 !{mem} @{} =
    fn (desc: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-005 (#1053): the address Length of address-space descriptor rdi, at payload offset 3 + 4W -- past Granularity, Minimum, Maximum and TranslationOffset. This is the field a bus driver actually needs, and computing its offset by hand at each call site is how an off-by-one-field bug gets into a translation window. Locals: r12=descriptor, r13=width. Reserved labels: none.",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        call aml_res_space_width;
        mov r13, rax;
        mov rdi, r12;
        mov rsi, 3;
        add rsi, r13;
        add rsi, r13;
        add rsi, r13;
        add rsi, r13;
        mov rdx, r13;
        call aml_res_read;
        pop r13;
        pop r12;
        ret
      }
    } @no_frame

  // ==========================================================================
  // GpioInt / GpioIo — large item 12, §6.4.3.8.1.
  //
  // The pin table is not at a fixed offset: its position and extent come
  // from PinTableOffset and ResourceSourceNameOffset, both of which are
  // measured from the START OF THE DESCRIPTOR rather than from its
  // payload. Getting that base wrong by three bytes silently yields
  // neighbouring pin numbers, so the conversion happens once, here.
  // ==========================================================================

  pub let aml_res_gpio_type : (u64) -> u64 !{mem} @{} =
    fn (desc: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-005 (#1053): the GPIO connection type of descriptor rdi -- 0 GpioInt (an interrupt), 1 GpioIo. Payload offset 1. This single byte is what decides whether a pin becomes an interrupt line or a general-purpose IO on the LPSS controllers R30.M2 enumerates. Reserved labels: none.",
      block: {
        mov rsi, 1;
        call aml_res_u8;
        ret
      }
    } @no_frame

  pub let aml_res_gpio_pin_count : (u64) -> u64 !{mem} @{} =
    fn (desc: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-005 (#1053): how many pins descriptor rdi's pin table holds, derived as (ResourceSourceNameOffset - PinTableOffset) / 2 since the table runs from one to the other and each entry is a u16. Both offsets are payload fields at 11 and 14. A ResourceSourceNameOffset that does not exceed PinTableOffset yields 0 rather than a huge count from an unsigned underflow -- the check is cheap and the alternative is a loop that walks the whole buffer. Locals: r12=descriptor, r13=pin-table offset. Reserved labels: aml_rgc_.",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        mov rsi, 11;
        call aml_res_u16;
        mov r13, rax;                    // PinTableOffset
        mov rdi, r12;
        mov rsi, 14;
        call aml_res_u16;                // ResourceSourceNameOffset
        cmp rax, r13;
        jbe aml_rgc_zero;
        sub rax, r13;
        shr rax, 1;
        pop r13;
        pop r12;
        ret;
      aml_rgc_zero:
        xor rax, rax;
        pop r13;
        pop r12;
        ret
      }
    } @no_frame

  pub let aml_res_gpio_pin : (u64, u64) -> u64 !{mem} @{} =
    fn (desc: u64) (i: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-005 (#1053): pin i of GPIO descriptor rdi. PinTableOffset is measured from the descriptor's first byte while aml_res_u16 indexes from the payload, so three -- the large-descriptor header size -- is subtracted once here to convert between the two coordinate systems. That subtraction is the entire reason this accessor exists rather than a documented offset in the header table. Out-of-range i is not special-cased: the resulting offset falls outside the descriptor and aml_res_read returns 0. Locals: r12=descriptor, r13=index. Reserved labels: aml_rgp_.",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        mov r13, rsi;
        mov rsi, 11;
        call aml_res_u16;                // PinTableOffset, descriptor-relative
        cmp rax, 3;
        jb aml_rgp_zero;
        sub rax, 3;                      // -> payload-relative
        mov rsi, rax;
        add rsi, r13;
        add rsi, r13;                    // + 2*i
        mov rdi, r12;
        call aml_res_u16;
        pop r13;
        pop r12;
        ret;
      aml_rgp_zero:
        xor rax, rax;
        pop r13;
        pop r12;
        ret
      }
    } @no_frame

  // ==========================================================================
  // GenericSerialBus — large item 14, §6.4.3.8.2. I2C is bus type 1.
  // ==========================================================================

  pub let aml_res_serial_type : (u64) -> u64 !{mem} @{} =
    fn (desc: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-005 (#1053): the SerialBusType of descriptor rdi at payload offset 2 -- 1 I2C, 2 SPI, 3 UART. The type-specific data that follows has a DIFFERENT layout per bus, so a consumer must test this before using aml_res_i2c_addr or aml_res_i2c_speed; reading an SPI descriptor's bytes as an I2C address would produce a valid-looking slave address for a device that is not there. Reserved labels: none.",
      block: {
        mov rsi, 2;
        call aml_res_u8;
        ret
      }
    } @no_frame

  pub let aml_res_i2c_speed : (u64) -> u64 !{mem} @{} =
    fn (desc: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-005 (#1053): the I2C ConnectionSpeed in Hz, the first type-specific field, at payload offset 9 -- immediately after the 9-byte common serial-bus header. Reserved labels: none.",
      block: {
        mov rsi, 9;
        call aml_res_u32;
        ret
      }
    } @no_frame

  pub let aml_res_i2c_addr : (u64) -> u64 !{mem} @{} =
    fn (desc: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-005 (#1053): the I2C SlaveAddress, at payload offset 13 -- after the common header and the 4-byte ConnectionSpeed. This is the field that tells the LPSS I2C driver which address on the bus a touchpad or sensor hub answers at, which is the whole point of R30 reaching this far. Reserved labels: none.",
      block: {
        mov rsi, 13;
        call aml_res_u16;
        ret
      }
    } @no_frame
}
