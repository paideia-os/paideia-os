// src/user/aml/aml_term.pdx — R30.M1-003 (#1051) / R30.M1-004 (#1052)
//
// AML term parser: control flow (§20.2.5.3) and data objects (§20.2.3,
// §20.2.5.4), layered on the #1049 tokenizer, the #1050 arena and the
// #1049 opcode table.
//
// PLACEMENT — CONSTITUTIONAL
// -------------------------
// Userspace only. See design/acpi/no-aml-in-kernel.md.
//
// NO PRIVATE STORAGE
// ------------------
// This module declares no .bss at all. Everything it needs lives in the
// lexer cursor or the arena, reached through their accessor APIs. That is
// deliberate: tools/verify-aml-parser.sh proves with objdump -r that
// aml_lex_state, the arena arrays and aml_optab are each relocated against
// from ONE object only, and adding this module to that script's MODULES
// list therefore turns the existing three assertions into a proof that the
// term parser cannot reach any of them directly. Introducing state here
// would have meant extending the script; introducing none makes the script
// stronger for free.
//
// =====================================================================
// THE METHOD-INVOCATION PROBLEM, AND HOW IT IS SOLVED
// =====================================================================
// In AML a bare NameString in term position may be a METHOD CALL, and the
// number of TermArgs that follow it IS NOT IN THE BYTE STREAM. It comes
// from bits [2:0] of the MethodFlags byte of the corresponding
// `Method` declaration — which may appear LATER in the same table, or in
// a different table entirely.
//
// This is not a detail. Getting the count wrong does not produce a parse
// error: it produces a parse that SUCCEEDS and is wrong. Read one arg too
// few and the next argument is re-interpreted as a statement; read one too
// many and a following statement is swallowed as an argument. Either way
// the resulting namespace looks plausible and mis-drives hardware. So the
// argument count is never guessed, under any circumstance.
//
// TWO PASSES
// ----------
// aml_parse now runs the buffer twice, which is the same shape ACPICA
// uses and for the same reason.
//
//   PASS A — DECLARATION.  aml_parse_termlist(root, len, 0). Descends
//     only name-defining constructs (Scope, Device, ThermalZone,
//     Processor, PowerResource and the Field family), exactly as
//     R30.M1-002 did. Method bodies and If/Else/While packages are
//     recorded as BYTE EXTENTS in arg0/arg1 and are NOT entered. Because
//     pass A never needs to know an arity to walk past a body, it can
//     complete without resolving anything — and when it completes, EVERY
//     Method declaration in the table is in the arena.
//
//   PASS B — BODY.  aml_term_bodies() sweeps the arena (not the buffer)
//     over the nodes pass A created, and parses the body of each METHOD,
//     IF, ELSE and WHILE from its recorded extent. Arity lookups now
//     search a COMPLETE declaration set, so a forward reference — a
//     method calling one defined later in the same table, which ASL
//     permits and real DSDTs contain — resolves correctly.
//
// Nothing is parsed twice: pass A allocates the body-bearing node, pass B
// allocates only its children. Bit 15 of the node's flags word marks
// "body parsed", so the sweep is idempotent. Nested control flow found
// DURING pass B is parsed inline, because at that point every arity is
// already known, so it never needs a third pass and the sweep only ever
// visits indices below its starting high-water mark.
//
// WHERE THE ARITY COMES FROM
// --------------------------
// aml_term_lookup searches, in this order:
//
//   1. INTERPRETER BUILT-INS. `_OSI` is a method of one argument that the
//      interpreter supplies and no table declares; real DSDTs call it
//      without an External. `_OS_`, `_REV` and `_GL_` are interpreter
//      objects, not methods. Omitting these would make essentially every
//      shipping DSDT unparseable.
//   2. A `Method` node in the arena — arity from MethodFlags [2:0].
//   3. An `External` node declaring ObjectType 8 (MethodObj) — arity from
//      its ArgumentCount byte. This is precisely the mechanism ACPI
//      defines for naming an object another table owns, and it is what
//      makes the cross-table case resolvable rather than guessed.
//   4. Any other declaration of the name — it is an object, not a method,
//      so the NameString is a reference and consumes no further bytes.
//
// Matching is on the FINAL NameSeg, not the full path. Full scope
// resolution needs the evaluator's namespace walk (R30.M2), and arity is
// a property of the method, not of the path used to reach it. The
// approximation is made SAFE rather than merely convenient: if two
// declarations share a final NameSeg and disagree on arity, the parse is
// refused with AML_ERR_AMBIGUOUS_CALL (21) instead of picking one. Two
// same-named methods with different arities are the only input this
// approximation could mis-parse, and that input is rejected.
//
// WHEN IT CANNOT BE RESOLVED
// --------------------------
// A NameString whose final segment matches nothing is refused with
// AML_ERR_UNRESOLVED_CALL (20). It is tempting to assume "not a method,
// therefore a plain object reference" — but that assumption is exactly
// the mis-parse described above: `Store(FOO(1), Local0)` and
// `Store(FOO, One)` differ only in whether FOO takes an argument. ACPI
// requires an `External` declaration for any object a table references
// but does not own, so refusing is spec-conformant, and the operator gets
// a precise code and offset instead of a wrong namespace.
//
// KNOWN LIMIT, STATED RATHER THAN PAPERED OVER
// --------------------------------------------
// A `Method` declared INSIDE an If/While body is invisible to pass A,
// because pass A does not enter those bodies. A call to it from a body
// swept EARLIER in pass B is therefore unresolvable and is refused. The
// alternative — descending control flow in pass A — reintroduces the very
// circularity the two passes exist to break, since a control-flow body is
// arbitrary terms. Conditional method definitions are rare and are
// normally called from within the same block, which pass B parses in
// order and therefore resolves. This is a refusal, never a mis-parse.
//
// =====================================================================
// NODE KINDS ADDED HERE (the #1050 table continues at 23)
// =====================================================================
//   23 CALL        name_ref = callee; flags[7:0] = resolved argc;
//                  arg0/arg1 = argument byte extent; children = the args
//   24 EXPR        flags = op16; children = TermArg operands. Scalars
//                  that are NOT TermArgs live in arg0/arg1: MatchOp puts
//                  its two MatchOpcodes there, AcquireOp its timeout,
//                  FatalOp its type and code.
//   25 IF          arg0 = predicate start, arg1 = package end;
//                  child 0 = predicate, the rest is the body
//   26 ELSE        arg0 = body start, arg1 = package end; children = body
//   27 WHILE       as IF
//   28 RETURN      child 0 = the returned TermArg; flags bit 0 set when
//                  the operand was absent (see below)
//   29 BREAK       30 CONTINUE   31 NOOP   32 BREAKPOINT   (leaves)
//   33 INT         flags = 1; arg0 = u64-arena index of the value
//   34 STRING      arg0/arg1 = byte extent including the terminating NUL
//   35 BUFFER      arg0 = first initialiser byte, arg1 = package end;
//                  child 0 = the size TermArg
//   36 PACKAGE     flags = declared NumElements; arg0/arg1 = element-list
//                  extent; children = the encoded initialisers
//   37 VARPACKAGE  as PACKAGE but child 0 is the count TermArg and flags
//                  is 0xFFFF, the "count is not a literal" sentinel
//   38 NAMEREF     a NameString in value position; name_ref set
//   39 ARGX        flags = 0..6      40 LOCALX  flags = 0..7
//   41 MISC        flags = op16 (Revision / Debug / Timer)
//
// ELSE IS A SIBLING, NOT A CHILD
// ------------------------------
// AML encodes DefElse as a term FOLLOWING its DefIfElse in the same
// TermList, and that is how it is represented: the ELSE node is the
// immediately-following sibling of its IF. Making it a child would have
// been tidier to consume but would have put it in the IF's child list
// alongside the predicate and the body — and in pass A the ELSE is
// created BEFORE the body is, so it would have landed in the middle of
// the eventual child order. The positional convention costs a consumer
// one sibling test and is stable across both passes. An ELSE whose
// preceding sibling is not an IF is AML_ERR_ELSE_WITHOUT_IF (24).
//
// RETURN WITH NO OPERAND
// ----------------------
// The grammar requires ReturnOp to carry an ArgObject, and iasl always
// emits `Return(Zero)`. Some shipping firmware nonetheless emits a bare
// ReturnOp as the last byte of a method body. Parsing the following byte
// as its operand would consume a byte belonging to the enclosing package;
// so when the cursor is already at the enclosing end, the operand is
// treated as an implicit Zero, recorded by flags bit 0 with no child.
// This is a bounded, explicitly-flagged concession to real tables, not a
// silent tolerance: a consumer can see exactly which Returns were fixed
// up.
//
// PACKAGE ELEMENT COUNTS — WHY THE OBVIOUS CHECK IS WRONG
// -------------------------------------------------------
// It is tempting to reject a Package whose declared NumElements exceeds
// what its PkgLength could hold. That check is WRONG: §20.2.5.4 allows a
// package's initialiser list to be shorter than its declared element
// count, with the remainder uninitialised, so `Package(0xFF){}` is legal
// and common. The sound check is the other direction — the encoded
// initialiser list must not contain MORE elements than were declared —
// and that is AML_ERR_PKG_ELEM_COUNT (22). An element that straddles the
// package end is caught separately as AML_ERR_PKG_OVERRUN (11).
//
// BUFFER SIZES
// ------------
// `Buffer` carries a size TermArg followed by however many initialiser
// bytes the PkgLength covers. When the size is a LITERAL, a size larger
// than the extent is a contradiction the parser can see, and it is
// AML_ERR_BUF_SIZE_OVF (23). When the size is a computed TermArg the
// value is a runtime property, no check is possible, and none is
// invented — `Buffer(Local0){}` is legal AML.
//
// CONTAINMENT AT OPEN TIME
// ------------------------
// aml_term_pkg_open_in checks a nested package's end against its
// ENCLOSING end before anything inside it is read. aml_lex_pkglength
// already proves a package fits the BUFFER; this proves it fits its
// PARENT. Without it, an If whose PkgLength overruns the enclosing
// TermList would be detected only after its body had been parsed out of
// bytes belonging to the parent — the right error for the wrong reason,
// and a pile of bogus nodes on the way.
//
// ERROR CODES ADDED HERE (the #1049 taxonomy continues at 20)
// -----------------------------------------------------------
//   20 AML_ERR_UNRESOLVED_CALL   NameString whose arity cannot be known
//   21 AML_ERR_AMBIGUOUS_CALL    two declarations, two different arities
//   22 AML_ERR_PKG_ELEM_COUNT    more initialisers than declared elements
//   23 AML_ERR_BUF_SIZE_OVF      literal Buffer size exceeds its extent
//   24 AML_ERR_ELSE_WITHOUT_IF   Else whose preceding sibling is not an If
//   30 AML_ERR_BAD_TERMARG       byte cannot begin a TermArg
// (25..29 belong to aml_resource.pdx / #1053.)

module AmlTerm = structure {

  // ==========================================================================
  // aml_term_pkg_open_in(end_off) -> absolute package end, 0 on error.
  // ==========================================================================
  pub let aml_term_pkg_open_in : (u64) -> u64 !{mem} @{} =
    fn (end_off: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-003 (#1051): read a PkgLength and convert it to an absolute end offset that is proven to lie within the ENCLOSING construct's end (rdi). aml_ns_pkg_open already proves the package fits the buffer; this adds the containment check that the buffer bound cannot give, because a package can sit inside the table and still overrun its parent. Checking at OPEN time rather than after the body is parsed matters twice over: the body would otherwise be built out of bytes that belong to the parent, leaving a pile of nodes that describe nothing, and err_off would point at the end of the damage instead of at the lying length field. Latches AML_ERR_PKG_OVERRUN (11). Locals: r12 = enclosing end. Reserved labels: aml_tpo_.",
      block: {
        push r12;
        mov r12, rdi;
        call aml_ns_pkg_open;
        cmp rax, 0;
        je aml_tpo_fail;
        cmp rax, r12;
        ja aml_tpo_over;
        pop r12;
        ret;
      aml_tpo_over:
        mov rdi, 11;                     // AML_ERR_PKG_OVERRUN
        call aml_lex_set_err;
      aml_tpo_fail:
        xor rax, rax;
        pop r12;
        ret
      }
    } @no_frame

  // ==========================================================================
  // aml_term_final_seg(name_ref) -> the last NameSeg, or 0.
  // ==========================================================================
  pub let aml_term_final_seg : (u64) -> u64 !{mem} @{} =
    fn (name_ref: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-003 (#1051): return the LAST NameSeg of name-arena entry rdi, or 0 when the entry has no segments (a NullName, which names nothing and can therefore never be a call). The final segment is the identity of the object; the leading segments are the path used to reach it, and arity is a property of the method rather than of the path. Returns 0 for the arena's null entry too, so an unnamed node is naturally excluded from the declaration scan. Locals: r12 = name_ref, r13 = segment count. Reserved labels: aml_tfs_.",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        call aml_name_segcount;
        mov r13, rax;
        cmp r13, 0;
        je aml_tfs_none;
        mov rdi, r12;
        mov rsi, r13;
        sub rsi, 1;
        call aml_name_seg;
        pop r13;
        pop r12;
        ret;
      aml_tfs_none:
        xor rax, rax;
        pop r13;
        pop r12;
        ret
      }
    } @no_frame

  // ==========================================================================
  // aml_term_lookup(name_ref) -> packed lookup result.
  //
  //   0                 not found — arity unknowable
  //   bit 9   found
  //   bit 8   the declaration is a METHOD (otherwise it is an object)
  //   [7:0]   argument count when bit 8 is set
  // ==========================================================================
  pub let aml_term_lookup : (u64) -> u64 !{mem} @{} =
    fn (name_ref: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-003 (#1051): resolve the ARITY of the object named by name-arena entry rdi. Consults the four sources in the file header: interpreter built-ins first (a table never declares _OSI, and every shipping DSDT calls it), then a linear scan of the node arena for a METHOD or an External-of-MethodObj whose final NameSeg matches, then any other declaration of that segment. The scan is O(nodes) per call and therefore O(nodes * calls) overall, which is fine at 512-node fixture scale and is noted in design/acpi/aml-parser.md as the thing to replace with a sorted name index when the arena is grown for a real DSDT. Ambiguity is REFUSED, not resolved: a second METHOD match whose argument count differs from the first latches AML_ERR_AMBIGUOUS_CALL (21) and returns 0, because picking either one would silently mis-parse the argument list. Locals: r12 = target segment, r13 = scan index, r14 = node count, r15 = accumulated result; [rsp+0] = the candidate argc of the node under test. Reserved labels: aml_tlk_.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 16;
        call aml_term_final_seg;
        mov r12, rax;
        cmp r12, 0;
        je aml_tlk_none;
        mov rcx, 0x49534F5F;             // '_OSI' packed little-endian
        cmp r12, rcx;
        je aml_tlk_osi;
        mov rcx, 0x5F534F5F;             // '_OS_'
        cmp r12, rcx;
        je aml_tlk_obj;
        mov rcx, 0x5645525F;             // '_REV'
        cmp r12, rcx;
        je aml_tlk_obj;
        mov rcx, 0x5F4C475F;             // '_GL_'
        cmp r12, rcx;
        je aml_tlk_obj;
        xor r15, r15;
        call aml_node_count;
        mov r14, rax;
        mov r13, 1;
      aml_tlk_loop:
        cmp r13, r14;
        jae aml_tlk_done;
        mov rdi, r13;
        call aml_node_name;
        cmp rax, 0;
        je aml_tlk_next;
        mov rdi, rax;
        call aml_term_final_seg;
        cmp rax, r12;
        jne aml_tlk_next;
        mov rdi, r13;
        call aml_node_kind;
        cmp rax, 4;                      // AML_NODE_METHOD
        je aml_tlk_method;
        cmp rax, 15;                     // AML_NODE_EXTERNAL
        je aml_tlk_ext;
      aml_tlk_object:
        or r15, 0x200;                   // found, not a method
        jmp aml_tlk_next;
      aml_tlk_method:
        mov rdi, r13;
        call aml_method_argcount;
        mov [rsp + 0], rax;
        jmp aml_tlk_cand;
      aml_tlk_ext:
        mov rdi, r13;
        call aml_node_flags;
        mov rcx, rax;
        and rcx, 0xFF;                   // ObjectType
        cmp rcx, 8;                      // MethodObj
        jne aml_tlk_object;
        shr rax, 8;
        and rax, 0xFF;                   // ArgumentCount
        mov [rsp + 0], rax;
      aml_tlk_cand:
        mov rcx, r15;
        and rcx, 0x100;
        cmp rcx, 0;
        je aml_tlk_take;                 // first method candidate
        mov rcx, r15;
        and rcx, 0xFF;
        mov rdx, [rsp + 0];
        cmp rcx, rdx;
        jne aml_tlk_ambig;               // same name, different arity
        jmp aml_tlk_next;
      aml_tlk_take:
        mov rcx, [rsp + 0];
        and rcx, 0xFF;
        mov r15, rcx;
        or r15, 0x300;                   // found | method
      aml_tlk_next:
        add r13, 1;
        jmp aml_tlk_loop;
      aml_tlk_done:
        mov rax, r15;
        jmp aml_tlk_ret;
      aml_tlk_osi:
        mov rax, 0x301;                  // found | method | argc 1
        jmp aml_tlk_ret;
      aml_tlk_obj:
        mov rax, 0x200;                  // found, not a method
        jmp aml_tlk_ret;
      aml_tlk_ambig:
        mov rdi, 21;                     // AML_ERR_AMBIGUOUS_CALL
        call aml_lex_set_err;
      aml_tlk_none:
        xor rax, rax;
      aml_tlk_ret:
        add rsp, 16;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    } @no_frame

  // ==========================================================================
  // aml_term_name_or_call(parent, end_off, src_off) -> node, 0 on error.
  // ==========================================================================
  pub let aml_term_name_or_call : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (parent: u64) (end_off: u64) (src_off: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-003 (#1051): consume a NameString at the cursor and turn it into either an AML_NODE_CALL with its arguments parsed, or an AML_NODE_NAMEREF. rdi=parent, rsi=enclosing end, rdx=source offset of the first name byte. The whole point of the two-pass loader converges here: aml_term_lookup either yields an argument count from a real declaration or yields nothing, and nothing means AML_ERR_UNRESOLVED_CALL (20). No third option exists, because the byte after the name is an argument or a statement depending solely on that count, and a wrong choice desynchronises everything that follows without producing an error. The CALL node's arguments are parsed as its CHILDREN and its arg0/arg1 record the byte extent they occupied, so a consumer can both walk them structurally and re-read them from the source. Locals: r12=parent, r13=end, r14=src_off, r15=node; [rsp+0]=name_ref, [rsp+8]=argc, [rsp+16]=args start, [rsp+24]=loop counter. Reserved labels: aml_tnc_.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 32;
        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        call aml_lex_namestring;
        mov [rsp + 0], rax;
        call aml_lex_err;
        cmp rax, 0;
        jne aml_tnc_fail;
        mov rdi, [rsp + 0];
        call aml_term_lookup;
        mov [rsp + 8], rax;
        call aml_lex_err;
        cmp rax, 0;
        jne aml_tnc_fail;
        mov rax, [rsp + 8];
        cmp rax, 0;
        je aml_tnc_unres;
        mov rcx, rax;
        and rcx, 0x100;                  // is it a method?
        cmp rcx, 0;
        je aml_tnc_ref;

        // ---- method invocation: argc TermArgs follow ----
        mov rdi, 23;                     // AML_NODE_CALL
        mov rsi, [rsp + 0];
        mov rdx, r12;
        mov rcx, r14;
        call aml_node_alloc;
        mov r15, rax;
        cmp r15, 0;
        je aml_tnc_fail;
        mov rax, [rsp + 8];
        and rax, 0xFF;                   // argc
        mov [rsp + 8], rax;
        mov rdi, r15;
        mov rsi, rax;
        call aml_node_set_flags;
        call aml_lex_pos;
        mov [rsp + 16], rax;             // first argument byte
        mov rdi, r15;
        mov rsi, r13;
        mov rdx, [rsp + 8];
        call aml_term_args;
        cmp rax, 0;
        jne aml_tnc_fail;
        call aml_lex_pos;
        mov rdi, r15;
        mov rsi, [rsp + 16];
        mov rdx, rax;
        call aml_node_set_args;
        mov rax, r15;
        jmp aml_tnc_ret;

        // ---- a plain reference: consumes no further bytes ----
      aml_tnc_ref:
        mov rdi, 38;                     // AML_NODE_NAMEREF
        mov rsi, [rsp + 0];
        mov rdx, r12;
        mov rcx, r14;
        call aml_node_alloc;
        cmp rax, 0;
        je aml_tnc_fail;
        jmp aml_tnc_ret;

      aml_tnc_unres:
        mov rdi, 20;                     // AML_ERR_UNRESOLVED_CALL
        call aml_lex_set_err;
      aml_tnc_fail:
        xor rax, rax;
      aml_tnc_ret:
        add rsp, 32;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    } @no_frame

  // ==========================================================================
  // aml_term_args(parent, end_off, n) -> err — read n TermArgs as children.
  // ==========================================================================
  pub let aml_term_args : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (parent: u64) (end_off: u64) (n: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-003 (#1051): append rdx TermArgs to node rdi, bounded by rsi. A module-level function rather than a local loop inside aml_term_expr because the five irregular operand shapes need an argument RUN at three different points -- before a trailing NameString, between two raw MatchOpcodes, and after a leading NameString -- and a single loop body cannot be re-entered from three places without either a local subroutine call or three copies of the loop. Both alternatives are worse: a local call would be the only one in the AML tree and would not survive an assembler that emits local labels differently, and three copies would be three chances for an off-by-one in the operand count. Stops on the first failed argument, leaving the sticky error to describe it. Locals: r12=parent, r13=end, r14=remaining. Reserved labels: aml_tas_.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
      aml_tas_loop:
        cmp r14, 0;
        je aml_tas_out;
        mov rdi, r12;
        mov rsi, r13;
        call aml_term_arg;
        cmp rax, 0;
        je aml_tas_out;
        sub r14, 1;
        jmp aml_tas_loop;
      aml_tas_out:
        pop r14;
        pop r13;
        pop r12;
        call aml_lex_err;
        ret
      }
    } @no_frame

  // ==========================================================================
  // aml_term_expr(parent, end_off, entry, src_off) -> node, 0 on error.
  // ==========================================================================
  pub let aml_term_expr : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (parent: u64) (end_off: u64) (entry: u64) (src_off: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-003 (#1051): parse the operand list of an expression opcode whose packed table entry is rdx and whose opcode byte(s) have already been consumed. rdi=parent, rsi=enclosing end, rcx=source offset. The node records the op16 in its flags, so ONE node kind covers all sixty-six expression opcodes and a consumer switches on data rather than on structure. The operand sequence is driven entirely by the table's argc and shape fields: shape 0 is argc TermArgs and covers sixty of them; the five irregular shapes each splice a raw ByteData, WordData, DWordData or NameString into the sequence at a fixed position, and those scalars go into the node's arg0/arg1 rather than being fabricated into child nodes, because they are not evaluable operands. Reading one of them as a TermArg would consume the wrong number of bytes and desynchronise the enclosing TermList SILENTLY, which is why the shape lives in the table where aml_optab_selfcheck can police it rather than in a comment. Frame: 48 bytes -- [0] entry then scratch, [8] argc then scratch, [16] shape, [24] first captured scalar, [32] source offset (saved immediately because rcx does not survive the first call), [40] second captured scalar. Locals: r12=parent, r13=end, r14=node, r15=TermArgs still owed. Reserved labels: aml_tex_.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 48;
        mov r12, rdi;
        mov r13, rsi;
        mov [rsp + 0], rdx;              // packed table entry
        mov [rsp + 32], rcx;             // source offset
        mov rdi, rdx;
        call aml_optab_argc;
        mov [rsp + 8], rax;
        mov rdi, [rsp + 0];
        call aml_optab_shape;
        mov [rsp + 16], rax;
        mov rdi, [rsp + 0];
        call aml_optab_op;
        mov [rsp + 24], rax;             // op16, briefly
        mov rdi, 24;                     // AML_NODE_EXPR
        xor rsi, rsi;
        mov rdx, r12;
        mov rcx, [rsp + 32];
        call aml_node_alloc;
        mov r14, rax;
        cmp r14, 0;
        je aml_tex_fail;
        mov rdi, r14;
        mov rsi, [rsp + 24];
        call aml_node_set_flags;
        mov r15, [rsp + 8];              // TermArgs still owed
        mov rax, [rsp + 16];             // shape
        cmp rax, 0;
        je aml_tex_args;
        cmp rax, 1;
        je aml_tex_namelast;
        cmp rax, 2;
        je aml_tex_match;
        cmp rax, 3;
        je aml_tex_acquire;
        cmp rax, 4;
        je aml_tex_fatal;
        cmp rax, 5;
        je aml_tex_namefirst;
        jmp aml_tex_fail;

        // ---- shape 1: argc-1 TermArgs then a DECLARED NameString ----
      aml_tex_namelast:
        sub r15, 1;
        mov rdi, r14;
        mov rsi, r13;
        mov rdx, r15;
        call aml_term_args;
        cmp rax, 0;
        jne aml_tex_fail;
        jmp aml_tex_name;

        // ---- shape 5: a NameString then argc-1 TermArgs ----
      aml_tex_namefirst:
        sub r15, 1;
        call aml_lex_pos;
        mov [rsp + 0], rax;
        call aml_lex_namestring;
        mov [rsp + 8], rax;
        call aml_lex_err;
        cmp rax, 0;
        jne aml_tex_fail;
        mov rdi, 38;                     // AML_NODE_NAMEREF
        mov rsi, [rsp + 8];
        mov rdx, r14;
        mov rcx, [rsp + 0];
        call aml_node_alloc;
        cmp rax, 0;
        je aml_tex_fail;
        jmp aml_tex_args;

        // ---- shape 2: SearchPkg op1 Operand1 op2 Operand2 StartIndex ----
      aml_tex_match:
        mov rdi, r14;
        mov rsi, r13;
        mov rdx, 1;
        call aml_term_args;              // SearchPkg
        cmp rax, 0;
        jne aml_tex_fail;
        call aml_lex_u8;                 // MatchOpcode1
        mov [rsp + 24], rax;
        call aml_lex_err;
        cmp rax, 0;
        jne aml_tex_fail;
        mov rdi, r14;
        mov rsi, r13;
        mov rdx, 1;
        call aml_term_args;              // Operand1
        cmp rax, 0;
        jne aml_tex_fail;
        call aml_lex_u8;                 // MatchOpcode2
        mov [rsp + 40], rax;
        call aml_lex_err;
        cmp rax, 0;
        jne aml_tex_fail;
        mov rdi, r14;
        mov rsi, [rsp + 24];
        mov rdx, [rsp + 40];
        call aml_node_set_args;
        mov r15, 2;                      // Operand2, StartIndex
        jmp aml_tex_args;

        // ---- shape 3: MutexObject then a WordData timeout ----
      aml_tex_acquire:
        mov rdi, r14;
        mov rsi, r13;
        mov rdx, 1;
        call aml_term_args;
        cmp rax, 0;
        jne aml_tex_fail;
        call aml_lex_u16;
        mov [rsp + 24], rax;
        call aml_lex_err;
        cmp rax, 0;
        jne aml_tex_fail;
        mov rdi, r14;
        mov rsi, [rsp + 24];
        xor rdx, rdx;
        call aml_node_set_args;
        jmp aml_tex_done;

        // ---- shape 4: FatalType, FatalCode, then one TermArg ----
      aml_tex_fatal:
        call aml_lex_u8;
        mov [rsp + 24], rax;
        call aml_lex_u32;
        mov [rsp + 40], rax;
        call aml_lex_err;
        cmp rax, 0;
        jne aml_tex_fail;
        mov rdi, r14;
        mov rsi, [rsp + 24];
        mov rdx, [rsp + 40];
        call aml_node_set_args;
        mov r15, 1;
        jmp aml_tex_args;

        // ---- the plain TermArg run ----
      aml_tex_args:
        mov rdi, r14;
        mov rsi, r13;
        mov rdx, r15;
        call aml_term_args;
        cmp rax, 0;
        jne aml_tex_fail;
        jmp aml_tex_done;

        // ---- the trailing NameString of shape 1 ----
      aml_tex_name:
        call aml_lex_pos;
        mov [rsp + 0], rax;
        call aml_lex_namestring;
        mov [rsp + 8], rax;
        call aml_lex_err;
        cmp rax, 0;
        jne aml_tex_fail;
        mov rdi, 38;                     // AML_NODE_NAMEREF
        mov rsi, [rsp + 8];
        mov rdx, r14;
        mov rcx, [rsp + 0];
        call aml_node_alloc;
        cmp rax, 0;
        je aml_tex_fail;
      aml_tex_done:
        mov rax, r14;
        jmp aml_tex_ret;
      aml_tex_fail:
        xor rax, rax;
      aml_tex_ret:
        add rsp, 48;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    } @no_frame

  // ==========================================================================
  // aml_term_buffer(parent, end_off) -> node, 0 on error.
  // ==========================================================================
  pub let aml_term_buffer : (u64, u64) -> u64 !{mem} @{} =
    fn (parent: u64) (end_off: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-004 (#1052): parse DefBuffer := BufferOp PkgLength BufferSize ByteList with the cursor on the BufferOp. rdi=parent, rsi=enclosing end. The initialiser bytes are NOT copied into the arena: arg0/arg1 delimit them in the source buffer, which is the same discipline src_off already establishes for every fixed scalar operand and is what keeps a Buffer of a kilobyte from costing a kilobyte of node arena. The size operand is parsed as a child TermArg because it may legitimately be computed; when it turns out to be a literal, the parser can and does check it against the extent the PkgLength actually reserved, and latches AML_ERR_BUF_SIZE_OVF (23) if the buffer claims more bytes than it has. That check is deliberately conditional: applying it to a computed size would mean inventing a value, and Buffer(Local0){} is legal AML. Locals: r12=parent, r13=end, r14=node, r15=package end; [rsp+0]=source offset, [rsp+8]=size child, [rsp+16]=data start. Reserved labels: aml_tbf_.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 32;
        mov r12, rdi;
        mov r13, rsi;
        call aml_lex_pos;
        mov [rsp + 0], rax;
        call aml_lex_u8;                 // consume BufferOp
        mov rdi, r13;
        call aml_term_pkg_open_in;
        mov r15, rax;
        cmp r15, 0;
        je aml_tbf_fail;
        mov rdi, 35;                     // AML_NODE_BUFFER
        xor rsi, rsi;
        mov rdx, r12;
        mov rcx, [rsp + 0];
        call aml_node_alloc;
        mov r14, rax;
        cmp r14, 0;
        je aml_tbf_fail;
        mov rdi, r14;
        mov rsi, r15;
        call aml_term_arg;               // BufferSize, bounded by the package
        mov [rsp + 8], rax;
        cmp rax, 0;
        je aml_tbf_fail;
        call aml_lex_pos;
        mov [rsp + 16], rax;             // first initialiser byte
        cmp rax, r15;
        ja aml_tbf_over;
        mov rdi, r14;
        mov rsi, [rsp + 16];
        mov rdx, r15;
        call aml_node_set_args;
        // literal size: it must fit the bytes the PkgLength reserved
        mov rdi, [rsp + 8];
        call aml_node_kind;
        cmp rax, 33;                     // AML_NODE_INT
        jne aml_tbf_seek;
        mov rdi, [rsp + 8];
        call aml_node_arg0;
        mov rdi, rax;
        call aml_u64_get;
        mov rcx, r15;
        mov rdx, [rsp + 16];
        sub rcx, rdx;                    // bytes the PkgLength actually reserved
        cmp rax, rcx;
        ja aml_tbf_size;
      aml_tbf_seek:
        mov rdi, r15;
        call aml_lex_seek;
        call aml_lex_err;
        cmp rax, 0;
        jne aml_tbf_fail;
        mov rax, r14;
        jmp aml_tbf_ret;
      aml_tbf_size:
        mov rdi, 23;                     // AML_ERR_BUF_SIZE_OVF
        call aml_lex_set_err;
        jmp aml_tbf_fail;
      aml_tbf_over:
        mov rdi, 11;                     // AML_ERR_PKG_OVERRUN
        call aml_lex_set_err;
      aml_tbf_fail:
        xor rax, rax;
      aml_tbf_ret:
        add rsp, 32;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    } @no_frame

  // ==========================================================================
  // aml_term_pkg_elem(parent, end_off) -> node, 0 on error.
  // ==========================================================================
  pub let aml_term_pkg_elem : (u64, u64) -> u64 !{mem} @{} =
    fn (parent: u64) (end_off: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-004 (#1052): parse one PackageElement := DataRefObject | NameString. The distinction from an ordinary TermArg is the whole reason this function exists: inside a package a bare NameString is ALWAYS a reference and never an invocation, because §20.2.5.4 admits only data there. Routing package elements through the TermArg path would submit every element name to arity resolution and could refuse a perfectly legal package of device paths — the classic _PRT shape — merely because the names are not methods. Locals: r12=parent, r13=end, r14=source offset. Reserved labels: aml_tpe_.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        mov r13, rsi;
        call aml_lex_pos;
        mov r14, rax;
        call aml_lex_peek_u8;
        push rax;
        call aml_lex_err;
        cmp rax, 0;
        pop rcx;
        jne aml_tpe_fail;
        mov rdi, rcx;
        call aml_ns_is_namelead;
        cmp rax, 0;
        je aml_tpe_data;
        call aml_lex_namestring;
        push rax;
        call aml_lex_err;
        cmp rax, 0;
        pop rcx;
        jne aml_tpe_fail;
        mov rdi, 38;                     // AML_NODE_NAMEREF
        mov rsi, rcx;
        mov rdx, r12;
        mov rcx, r14;
        call aml_node_alloc;
        cmp rax, 0;
        je aml_tpe_fail;
        pop r14;
        pop r13;
        pop r12;
        ret;
      aml_tpe_data:
        mov rdi, r12;
        mov rsi, r13;
        call aml_term_arg;
        pop r14;
        pop r13;
        pop r12;
        ret;
      aml_tpe_fail:
        xor rax, rax;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    } @no_frame

  // ==========================================================================
  // aml_term_package(parent, end_off, isvar) -> node, 0 on error.
  // ==========================================================================
  pub let aml_term_package : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (parent: u64) (end_off: u64) (isvar: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-004 (#1052): parse DefPackage := PackageOp PkgLength NumElements PackageElementList, or DefVarPackage whose element count is a TermArg rather than a ByteData. rdi=parent, rsi=enclosing end, rdx=1 for the variable form. Elements are read until the cursor reaches the package end exactly; the element loop carries the same two guards as the term loop — a zero-advance iteration is AML_ERR_NO_PROGRESS (14) and an element that ends past the package end is AML_ERR_PKG_OVERRUN (11) — because a package element list is attacker-controlled in exactly the same way a TermList is. The count check runs ONE WAY ONLY: more encoded initialisers than NumElements declared is AML_ERR_PKG_ELEM_COUNT (22), while fewer is legal and common, since §20.2.5.4 leaves the remainder uninitialised. Reversing that test would reject Package(0xFF){}, which real firmware emits. The variable form has no literal count to check against, so it records the 0xFFFF sentinel in flags and relies on the containment guards alone. Locals: r12=parent, r13=package end, r14=node, r15=elements seen; [rsp+0]=source offset, [rsp+8]=declared count, [rsp+16]=isvar, [rsp+24]=cursor snapshot. Reserved labels: aml_tpk_.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 32;
        mov r12, rdi;
        mov [rsp + 16], rdx;
        mov r13, rsi;
        call aml_lex_pos;
        mov [rsp + 0], rax;
        call aml_lex_u8;                 // consume PackageOp / VarPackageOp
        mov rdi, r13;
        call aml_term_pkg_open_in;
        mov r13, rax;                    // package end from here on
        cmp r13, 0;
        je aml_tpk_fail;
        mov rdi, 36;                     // AML_NODE_PACKAGE
        mov rax, [rsp + 16];
        cmp rax, 0;
        je aml_tpk_alloc;
        mov rdi, 37;                     // AML_NODE_VARPACKAGE
      aml_tpk_alloc:
        xor rsi, rsi;
        mov rdx, r12;
        mov rcx, [rsp + 0];
        call aml_node_alloc;
        mov r14, rax;
        cmp r14, 0;
        je aml_tpk_fail;
        mov rax, [rsp + 16];
        cmp rax, 0;
        jne aml_tpk_varcount;
        call aml_lex_u8;                 // NumElements ByteData
        mov [rsp + 8], rax;
        call aml_lex_err;
        cmp rax, 0;
        jne aml_tpk_fail;
        mov rdi, r14;
        mov rsi, [rsp + 8];
        call aml_node_set_flags;
        jmp aml_tpk_body;
      aml_tpk_varcount:
        mov rdi, r14;
        mov rsi, r13;
        call aml_term_arg;               // VarNumElements
        cmp rax, 0;
        je aml_tpk_fail;
        mov rdi, r14;
        mov rsi, 0xFFFF;                 // "the count is not a literal"
        call aml_node_set_flags;
        mov rax, 0xFFFF;
        mov [rsp + 8], rax;
      aml_tpk_body:
        call aml_lex_pos;
        mov rdi, r14;
        mov rsi, rax;
        mov rdx, r13;
        call aml_node_set_args;
        xor r15, r15;
      aml_tpk_loop:
        call aml_lex_err;
        cmp rax, 0;
        jne aml_tpk_fail;
        call aml_lex_pos;
        mov [rsp + 24], rax;
        cmp rax, r13;
        jae aml_tpk_count;
        mov rdi, r14;
        mov rsi, r13;
        call aml_term_pkg_elem;
        cmp rax, 0;
        je aml_tpk_fail;
        add r15, 1;
        call aml_lex_pos;
        mov rcx, [rsp + 24];
        cmp rax, rcx;
        jbe aml_tpk_noprog;
        cmp rax, r13;
        ja aml_tpk_over;
        jmp aml_tpk_loop;
      aml_tpk_count:
        mov rcx, [rsp + 8];
        cmp r15, rcx;
        ja aml_tpk_many;
        mov rax, r14;
        jmp aml_tpk_ret;
      aml_tpk_many:
        mov rdi, 22;                     // AML_ERR_PKG_ELEM_COUNT
        call aml_lex_set_err;
        jmp aml_tpk_fail;
      aml_tpk_noprog:
        mov rdi, 14;                     // AML_ERR_NO_PROGRESS
        call aml_lex_set_err;
        jmp aml_tpk_fail;
      aml_tpk_over:
        mov rdi, 11;                     // AML_ERR_PKG_OVERRUN
        call aml_lex_set_err;
      aml_tpk_fail:
        xor rax, rax;
      aml_tpk_ret:
        add rsp, 32;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    } @no_frame

  // ==========================================================================
  // aml_term_arg(parent, end_off) -> node, 0 on error.
  //
  // One TermArg per §20.2.3. Literals are recognised BEFORE the opcode is
  // consumed, so aml_lex_integer — which peeks its own prefix — stays the
  // single decoder for every integer form.
  // ==========================================================================
  pub let aml_term_arg : (u64, u64) -> u64 !{mem} @{} =
    fn (parent: u64) (end_off: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-004 (#1052): parse one TermArg as a child of rdi, bounded by rsi. Dispatch order is load-bearing. A name-lead byte is tested first, because none of those bytes is an opcode and running one through the table would report 'unknown opcode' for what is really an invocation or a reference. The integer and string prefixes are tested next, WITHOUT consuming the opcode, so that aml_lex_integer keeps ownership of every integer form -- it peeks its own prefix, and duplicating that decode here would be a second place for the Ones/Zero/One special cases to drift. The three aggregates likewise re-read their own opcode. Everything else goes through the opcode table, where a miss is AML_ERR_UNKNOWN_OPCODE (5), a hit without F_M1_HANDLED is AML_ERR_UNEXPECTED_OP (10) and a hit whose class cannot appear in value position -- a control-flow opcode, most obviously -- is AML_ERR_BAD_TERMARG (30). Three codes rather than one because 'corrupt', 'unimplemented' and 'grammatically impossible here' need different responses. Locals: r12=parent, r13=end, r14=source offset, r15=packed entry; [rsp+0]=peeked byte, [rsp+8]=node, [rsp+16]=scratch. Reserved labels: aml_tar_.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 32;
        mov r12, rdi;
        mov r13, rsi;
        call aml_lex_pos;
        mov r14, rax;
        call aml_lex_peek_u8;
        mov [rsp + 0], rax;
        call aml_lex_err;
        cmp rax, 0;
        jne aml_tar_fail;
        mov rdi, [rsp + 0];
        call aml_ns_is_namelead;
        cmp rax, 0;
        jne aml_tar_name;
        mov rax, [rsp + 0];
        cmp rax, 0x00;
        je aml_tar_int;
        cmp rax, 0x01;
        je aml_tar_int;
        cmp rax, 0x0A;
        je aml_tar_int;
        cmp rax, 0x0B;
        je aml_tar_int;
        cmp rax, 0x0C;
        je aml_tar_int;
        cmp rax, 0x0E;
        je aml_tar_int;
        cmp rax, 0xFF;
        je aml_tar_int;
        cmp rax, 0x0D;
        je aml_tar_str;
        cmp rax, 0x11;
        je aml_tar_buf;
        cmp rax, 0x12;
        je aml_tar_pkg;
        cmp rax, 0x13;
        je aml_tar_vpkg;

        // ---- everything else is opcode-dispatched ----
        call aml_lex_opcode;
        mov [rsp + 0], rax;
        call aml_lex_err;
        cmp rax, 0;
        jne aml_tar_fail;
        mov rdi, [rsp + 0];
        call aml_optab_find;
        mov r15, rax;
        cmp r15, 0;
        je aml_tar_unk;
        mov rdi, r15;
        call aml_optab_flags;
        and rax, 0x40;                   // F_M1_HANDLED
        cmp rax, 0;
        je aml_tar_unexp;
        mov rdi, r15;
        call aml_optab_class;
        cmp rax, 4;
        je aml_tar_expr;
        cmp rax, 5;
        je aml_tar_argx;
        cmp rax, 6;
        je aml_tar_localx;
        cmp rax, 7;
        je aml_tar_misc;
        jmp aml_tar_badarg;

      aml_tar_name:
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, r14;
        call aml_term_name_or_call;
        jmp aml_tar_ret;

      aml_tar_int:
        call aml_lex_integer;
        mov [rsp + 16], rax;
        call aml_lex_err;
        cmp rax, 0;
        jne aml_tar_fail;
        mov rdi, [rsp + 16];
        call aml_u64_alloc;
        mov [rsp + 16], rax;
        cmp rax, 0;
        je aml_tar_fail;
        mov rdi, 33;                     // AML_NODE_INT
        xor rsi, rsi;
        mov rdx, r12;
        mov rcx, r14;
        call aml_node_alloc;
        mov [rsp + 8], rax;
        cmp rax, 0;
        je aml_tar_fail;
        mov rdi, [rsp + 8];
        mov rsi, 1;                      // data kind 1 = integer
        call aml_node_set_flags;
        mov rdi, [rsp + 8];
        mov rsi, [rsp + 16];
        xor rdx, rdx;
        call aml_node_set_args;
        mov rax, [rsp + 8];
        jmp aml_tar_ret;

      aml_tar_str:
        call aml_lex_u8;                 // consume StringPrefix
        call aml_lex_pos;
        mov [rsp + 16], rax;             // first character
      aml_tar_scan:
        call aml_lex_u8;
        mov [rsp + 0], rax;
        call aml_lex_err;
        cmp rax, 0;
        jne aml_tar_fail;               // unterminated -> EOF, never over-read
        mov rax, [rsp + 0];
        cmp rax, 0;
        jne aml_tar_scan;
        mov rdi, 34;                     // AML_NODE_STRING
        xor rsi, rsi;
        mov rdx, r12;
        mov rcx, r14;
        call aml_node_alloc;
        mov [rsp + 8], rax;
        cmp rax, 0;
        je aml_tar_fail;
        call aml_lex_pos;
        mov rdi, [rsp + 8];
        mov rsi, [rsp + 16];
        mov rdx, rax;
        call aml_node_set_args;
        mov rax, [rsp + 8];
        jmp aml_tar_ret;

      aml_tar_buf:
        mov rdi, r12;
        mov rsi, r13;
        call aml_term_buffer;
        jmp aml_tar_ret;
      aml_tar_pkg:
        mov rdi, r12;
        mov rsi, r13;
        xor rdx, rdx;
        call aml_term_package;
        jmp aml_tar_ret;
      aml_tar_vpkg:
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, 1;
        call aml_term_package;
        jmp aml_tar_ret;

      aml_tar_expr:
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, r15;
        mov rcx, r14;
        call aml_term_expr;
        jmp aml_tar_ret;

      aml_tar_argx:
        mov rax, [rsp + 0];
        sub rax, 0x68;                   // Arg0Op
        mov [rsp + 16], rax;
        mov rdi, 39;                     // AML_NODE_ARGX
        jmp aml_tar_leaf;
      aml_tar_localx:
        mov rax, [rsp + 0];
        sub rax, 0x60;                   // Local0Op
        mov [rsp + 16], rax;
        mov rdi, 40;                     // AML_NODE_LOCALX
        jmp aml_tar_leaf;
      aml_tar_misc:
        mov rax, [rsp + 0];
        mov [rsp + 16], rax;             // op16 identifies Revision/Debug/Timer
        mov rdi, 41;                     // AML_NODE_MISC
      aml_tar_leaf:
        xor rsi, rsi;
        mov rdx, r12;
        mov rcx, r14;
        call aml_node_alloc;
        mov [rsp + 8], rax;
        cmp rax, 0;
        je aml_tar_fail;
        mov rdi, [rsp + 8];
        mov rsi, [rsp + 16];
        call aml_node_set_flags;
        mov rax, [rsp + 8];
        jmp aml_tar_ret;

      aml_tar_unk:
        mov rdi, 5;                      // AML_ERR_UNKNOWN_OPCODE
        call aml_lex_set_err;
        jmp aml_tar_fail;
      aml_tar_unexp:
        mov rdi, 10;                     // AML_ERR_UNEXPECTED_OP
        call aml_lex_set_err;
        jmp aml_tar_fail;
      aml_tar_badarg:
        mov rdi, 30;                     // AML_ERR_BAD_TERMARG
        call aml_lex_set_err;
      aml_tar_fail:
        xor rax, rax;
      aml_tar_ret:
        add rsp, 32;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    } @no_frame

  // ==========================================================================
  // aml_term_obj(parent, end_off, pass) -> err — one TermObj in STATEMENT
  // position. pass 0 = declaration, 1 = body.
  // ==========================================================================
  pub let aml_term_obj : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (parent: u64) (end_off: u64) (pass: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-003 (#1051): parse one statement-position TermObj as a child of rdi, bounded by rsi, in pass rdx. The opcode is decoded and then, for the two categories this function does not own, the cursor is SEEKED BACK to the opcode so the owner can re-read it: namespace-defining opcodes go to aml_parse_term and everything that is not control flow goes to aml_term_arg, which is how an expression used as a statement -- Store(...) on its own line -- reaches exactly one implementation rather than two. Re-decoding a two-byte opcode costs two buffer reads through the bounds-checked path and buys a single dispatch table; duplicating the dispatch would have been the alternative. In pass 0 an If, Else or While records its extent and is skipped, because its body is arbitrary terms whose method arities are not yet known; in pass 1 the predicate and body are parsed inline. Locals: r12=parent, r13=end, r14=source offset, r15=pass; [rsp+0]=peeked byte then packed entry, [rsp+8]=node, [rsp+16]=package end. Reserved labels: aml_tob_.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 32;
        mov r12, rdi;
        mov r13, rsi;
        mov r15, rdx;
        call aml_lex_pos;
        mov r14, rax;
        call aml_lex_peek_u8;
        mov [rsp + 0], rax;
        call aml_lex_err;
        cmp rax, 0;
        jne aml_tob_out;
        mov rdi, [rsp + 0];
        call aml_ns_is_namelead;
        cmp rax, 0;
        je aml_tob_op;
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, r14;
        call aml_term_name_or_call;
        jmp aml_tob_out;

      aml_tob_op:
        call aml_lex_opcode;
        mov [rsp + 0], rax;
        call aml_lex_err;
        cmp rax, 0;
        jne aml_tob_out;
        mov rdi, [rsp + 0];
        call aml_optab_find;
        cmp rax, 0;
        je aml_tob_unk;
        mov [rsp + 0], rax;
        mov rdi, rax;
        call aml_optab_flags;
        and rax, 0x40;                   // F_M1_HANDLED
        cmp rax, 0;
        je aml_tob_unexp;
        mov rdi, [rsp + 0];
        call aml_optab_class;
        cmp rax, 1;
        je aml_tob_ns;
        cmp rax, 3;
        je aml_tob_ctrl;
        // a value in statement position: rewind and let the TermArg path own it
        mov rdi, r14;
        call aml_lex_seek;
        mov rdi, r12;
        mov rsi, r13;
        call aml_term_arg;
        jmp aml_tob_out;

      aml_tob_ns:
        mov rdi, r14;
        call aml_lex_seek;
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, r15;
        call aml_parse_term;
        jmp aml_tob_out;

      aml_tob_ctrl:
        mov rdi, [rsp + 0];
        call aml_optab_node;
        cmp rax, 25;
        je aml_tob_if;
        cmp rax, 26;
        je aml_tob_else;
        cmp rax, 27;
        je aml_tob_while;
        cmp rax, 28;
        je aml_tob_ret;
        // Break / Continue / Noop / BreakPoint are bare leaves
        mov rdi, rax;
        xor rsi, rsi;
        mov rdx, r12;
        mov rcx, r14;
        call aml_node_alloc;
        jmp aml_tob_out;

        // ---- If / While: PkgLength Predicate TermList ----
      aml_tob_if:
        mov rdi, 25;
        jmp aml_tob_pred;
      aml_tob_while:
        mov rdi, 27;
      aml_tob_pred:
        mov [rsp + 8], rdi;              // node kind
        mov rdi, r13;
        call aml_term_pkg_open_in;
        mov [rsp + 16], rax;
        cmp rax, 0;
        je aml_tob_out;
        mov rdi, [rsp + 8];
        xor rsi, rsi;
        mov rdx, r12;
        mov rcx, r14;
        call aml_node_alloc;
        mov [rsp + 8], rax;
        cmp rax, 0;
        je aml_tob_out;
        call aml_lex_pos;
        mov rdi, [rsp + 8];
        mov rsi, rax;                    // predicate start
        mov rdx, [rsp + 16];
        call aml_node_set_args;
        cmp r15, 0;
        je aml_tob_skip;                 // declaration pass: extent only
        mov rdi, [rsp + 8];
        mov rsi, [rsp + 16];
        call aml_term_arg;               // the predicate
        cmp rax, 0;
        je aml_tob_out;
        jmp aml_tob_body;

        // ---- Else: PkgLength TermList, validated against its If ----
      aml_tob_else:
        mov rdi, r12;
        call aml_node_last_child;
        mov [rsp + 8], rax;
        cmp rax, 0;
        je aml_tob_orphan;
        mov rdi, rax;
        call aml_node_kind;
        cmp rax, 25;                     // AML_NODE_IF
        jne aml_tob_orphan;
        mov rdi, r13;
        call aml_term_pkg_open_in;
        mov [rsp + 16], rax;
        cmp rax, 0;
        je aml_tob_out;
        mov rdi, 26;                     // AML_NODE_ELSE
        xor rsi, rsi;
        mov rdx, r12;
        mov rcx, r14;
        call aml_node_alloc;
        mov [rsp + 8], rax;
        cmp rax, 0;
        je aml_tob_out;
        call aml_lex_pos;
        mov rdi, [rsp + 8];
        mov rsi, rax;
        mov rdx, [rsp + 16];
        call aml_node_set_args;
        cmp r15, 0;
        je aml_tob_skip;
      aml_tob_body:
        mov rdi, [rsp + 8];
        mov rsi, [rsp + 16];
        mov rdx, 1;
        call aml_parse_termlist;
        mov rdi, [rsp + 8];
        mov rsi, 0x8000;                 // body parsed
        call aml_node_set_flags;
        jmp aml_tob_out;
      aml_tob_skip:
        mov rdi, [rsp + 16];
        call aml_lex_seek;
        jmp aml_tob_out;

        // ---- Return: one TermArg, or an implicit Zero at a body end ----
      aml_tob_ret:
        mov rdi, 28;                     // AML_NODE_RETURN
        xor rsi, rsi;
        mov rdx, r12;
        mov rcx, r14;
        call aml_node_alloc;
        mov [rsp + 8], rax;
        cmp rax, 0;
        je aml_tob_out;
        call aml_lex_pos;
        cmp rax, r13;
        jb aml_tob_retarg;
        mov rdi, [rsp + 8];
        mov rsi, 1;                      // implicit Zero operand
        call aml_node_set_flags;
        jmp aml_tob_out;
      aml_tob_retarg:
        mov rdi, [rsp + 8];
        mov rsi, r13;
        call aml_term_arg;
        jmp aml_tob_out;

      aml_tob_orphan:
        mov rdi, 24;                     // AML_ERR_ELSE_WITHOUT_IF
        call aml_lex_set_err;
        jmp aml_tob_out;
      aml_tob_unk:
        mov rdi, 5;                      // AML_ERR_UNKNOWN_OPCODE
        call aml_lex_set_err;
        jmp aml_tob_out;
      aml_tob_unexp:
        mov rdi, 10;                     // AML_ERR_UNEXPECTED_OP
        call aml_lex_set_err;
      aml_tob_out:
        add rsp, 32;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        call aml_lex_err;
        ret
      }
    } @no_frame

  // ==========================================================================
  // aml_term_fill_body(node) -> err — parse one recorded body extent.
  // ==========================================================================
  pub let aml_term_fill_body : (u64) -> u64 !{mem} @{} =
    fn (node: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-003 (#1051): parse the body a declaration-pass node recorded as the extent [arg0, arg1). rdi=node. IF and WHILE additionally carry their predicate at arg0, ahead of the TermList, so those two re-read it here; METHOD and ELSE do not. Seeking backwards into an already-validated extent is safe by construction: arg0/arg1 were produced by aml_lex_pkglength, which proved them inside the buffer, and aml_lex_seek refuses anything outside it regardless. Locals: r12=node, r13=body end. Reserved labels: aml_tfb_.",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        call aml_node_arg1;
        mov r13, rax;
        mov rdi, r12;
        call aml_node_arg0;
        mov rdi, rax;
        call aml_lex_seek;
        call aml_lex_err;
        cmp rax, 0;
        jne aml_tfb_out;
        mov rdi, r12;
        call aml_node_kind;
        cmp rax, 25;                     // IF
        je aml_tfb_pred;
        cmp rax, 27;                     // WHILE
        jne aml_tfb_list;
      aml_tfb_pred:
        mov rdi, r12;
        mov rsi, r13;
        call aml_term_arg;
        cmp rax, 0;
        je aml_tfb_out;
      aml_tfb_list:
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, 1;
        call aml_parse_termlist;
      aml_tfb_out:
        pop r13;
        pop r12;
        call aml_lex_err;
        ret
      }
    } @no_frame

  // ==========================================================================
  // aml_term_bodies() -> err — PASS B.
  // ==========================================================================
  pub let aml_term_bodies : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-003 (#1051): the body pass. Sweeps the nodes the declaration pass created and parses the body of every METHOD, IF, ELSE and WHILE that still has one recorded but not entered. The sweep is over the ARENA rather than the buffer, which is what makes the two passes cost one buffer walk and not two, and what guarantees no construct is parsed twice: pass A allocated the body-bearing node, pass B allocates only its children. The high-water mark is sampled ONCE before the loop, so nodes created by the sweep itself -- a nested Method, a nested If -- are not revisited; they are parsed inline as they are encountered, which is sound because by pass B every arity is already known. Bit 15 of the flags word is set whether or not a body was actually present, so a second sweep is a no-op rather than a re-parse. Locals: r12=index, r13=high-water mark, r14=node kind. Reserved labels: aml_tbd_.",
      block: {
        push r12;
        push r13;
        push r14;
        call aml_node_count;
        mov r13, rax;
        mov r12, 1;
      aml_tbd_loop:
        cmp r12, r13;
        jae aml_tbd_out;
        call aml_lex_err;
        cmp rax, 0;
        jne aml_tbd_out;
        mov rdi, r12;
        call aml_node_kind;
        mov r14, rax;
        cmp r14, 4;                      // METHOD
        je aml_tbd_cand;
        cmp r14, 25;                     // IF
        je aml_tbd_cand;
        cmp r14, 26;                     // ELSE
        je aml_tbd_cand;
        cmp r14, 27;                     // WHILE
        je aml_tbd_cand;
        jmp aml_tbd_next;
      aml_tbd_cand:
        mov rdi, r12;
        call aml_node_flags;
        mov r14, rax;
        and rax, 0x8000;
        cmp rax, 0;
        jne aml_tbd_next;                // already parsed
        or r14, 0x8000;
        mov rdi, r12;
        mov rsi, r14;
        call aml_node_set_flags;
        mov rdi, r12;
        call aml_node_arg0;
        mov r14, rax;
        mov rdi, r12;
        call aml_node_arg1;
        cmp rax, r14;
        jbe aml_tbd_next;                // empty body
        mov rdi, r12;
        call aml_term_fill_body;
        call aml_lex_err;
        cmp rax, 0;
        jne aml_tbd_out;
      aml_tbd_next:
        add r12, 1;
        jmp aml_tbd_loop;
      aml_tbd_out:
        pop r14;
        pop r13;
        pop r12;
        call aml_lex_err;
        ret
      }
    } @no_frame
}
