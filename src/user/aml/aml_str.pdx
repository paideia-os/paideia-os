// src/user/aml/aml_str.pdx — R30.M2-003 (#1056)
//
// ACPI 6.5 §19.3.5 implicit conversion, and the String/Buffer operators
// that are built out of it.
//
// PLACEMENT — CONSTITUTIONAL
// -------------------------
// Userspace only. See design/acpi/no-aml-in-kernel.md.
//
// NO PRIVATE MUTABLE STORAGE
// --------------------------
// One read-only table, aml_conv_tab, and nothing else. Like aml_optab it
// is confined to this object by tools/verify-aml-parser.sh: it is the
// authority on what each operator wants from each operand, and a second
// writer — or a second READER that had its own copy — would be a way for
// the implementations and the table to disagree, which is exactly the
// failure the table exists to prevent.
//
// =====================================================================
// THE CONVERSION MODEL, STATED PLAINLY
// =====================================================================
// §19.3.5 is the classic AML footgun and it is two DIFFERENT rules that
// look like one. Implementations that treat them as one work on simple
// tables and corrupt real ones.
//
// RULE 1 — OPERAND CONVERSION IS KEYED BY THE OPERATOR (§19.3.5.5).
// There is no universal coercion. `Add` converts a String operand TO an
// Integer; `Concatenate` converts an Integer operand TO a String or a
// Buffer. The same operand, the same type, two opposite conversions,
// chosen by the OPERATOR. So the model here is a table keyed by
// (operator, operand position) giving the WANTED type, and a second
// table keyed by (wanted type, actual type) giving the conversion:
//
//     aml_conv_want(op16, pos)  ->  the type this operator wants here
//     aml_conv_cast(obj, want)  ->  the object converted, or a refusal
//
// aml_conv_tab is the first table, as DATA — seventeen rows, each row
// four want-codes packed one per byte. Any opcode not in it defaults to
// "Integer, Integer, Target, Integer", which is the shape every
// arithmetic and logical operator has, so #1055's twenty-four operators
// are covered by the default and needed no rows. Adding an operator is
// adding a row; it is never editing a branch.
//
// Four of the operators in this file ARE table rows plus a store:
// ToBuffer wants Buffer, ToInteger wants Integer, ToHexString wants
// String-hex and ToDecimalString wants String-decimal. Their bodies
// contain no conversion logic at all, because the conversion IS the
// operator. That is the strongest evidence the factoring is the right
// one, and it is why the table was worth building rather than writing
// four bespoke converters.
//
// RULE 2 — STORE CONVERSION IS KEYED BY THE DESTINATION'S EXISTING TYPE
// (§19.3.5.7). Storing an Integer into a Name that currently holds a
// Buffer converts the INTEGER TO A BUFFER. It does NOT retype the Name
// to Integer. Implemented backwards this appears to work — a table that
// only ever stores integers into integer names behaves identically —
// and then silently destroys a `_CRS` buffer on real hardware. The
// direction is enforced in aml_eval_store_obj, not here, but it is
// stated here because the two rules must be read together.
//
// The counterpart is §19.3.5.8: a store to a LocalX or to a DebugObject
// does NO conversion and overwrites the slot wholesale, and CopyObject
// (§19.6.20) does no conversion anywhere. So the three behaviours are
// deliberately three code paths, and the corpus pins each against the
// other two.
//
// WANT CODES
// ----------
//     0  ANY        no conversion; the operator inspects the type itself
//     1  Integer
//     2  String, HEX     — the implicit Integer/Buffer -> String rule
//     3  Buffer
//     4  Package
//    12  String, DECIMAL — reachable only from ToDecimalString
//    20  Reference
//   100  SAME AS OPERAND 0 — Concatenate, and only Concatenate
//   101  TARGET     — a destination, not a value; never evaluated here
//
// 100 exists because §19.6.13 keys Concatenate's SECOND operand off the
// RUNTIME type of its first. That is a two-stage lookup, it is the only
// one in the specification, and giving it a code keeps it visible in the
// table instead of hidden inside Concatenate's body.
//
// =====================================================================
// WHERE THIS IMPLEMENTATION FOLLOWS ACPICA RATHER THAN THE PROSE
// =====================================================================
// Two conversions are under-specified in §19.3.5 and firmware is written
// against ACPICA's actual behaviour, so ACPICA is what is implemented and
// this is where that is recorded.
//
//   INTEGER -> STRING (hex) is FIXED WIDTH AND ZERO PADDED: eight
//   characters on a revision-1 table, sixteen on a revision-2 one
//   (AcpiExConvertToAscii, base 16). `ToHexString(One)` is therefore
//   "0000000000000001", not "1". Suppressing the leading zeros looks
//   tidier and breaks every table that concatenates a hex string and
//   indexes into the result at a fixed offset.
//
//   INTEGER -> STRING (decimal) SUPPRESSES leading zeros, because the
//   same ACPICA function does. The two disagree, deliberately, and a
//   reader who assumes they agree writes one of them wrong.
//
//   BUFFER -> STRING is a COMMA-SEPARATED ELEMENT LIST, not a number:
//   "AB,CD,EF" in hex and "1,2,3" in decimal. An empty Buffer converts
//   to an empty String. Reading a Buffer as one big number is the
//   mistake that makes ToHexString of a four-byte buffer produce a
//   plausible 32-bit value and lose the fact that it was four elements.
//
//   STRING -> INTEGER accepts DECIMAL and 0x-PREFIXED HEX, skips leading
//   blanks, and stops at the first character that is not a digit in the
//   chosen base, yielding what it had accumulated so far. A string with
//   no digits at all is zero and is NOT an error, which is ACPICA's
//   behaviour and which real tables rely on when they parse an _OSI-ish
//   version string.
//
// =====================================================================
// FUEL
// =====================================================================
// Every operator here is reached through aml_eval_obj, which spends one
// step before dispatching, so an expression tree cannot be walked for
// free. The two operators with an unbounded INNER loop — Match, which
// scans a Package, and the byte loops behind Concatenate — are bounded
// differently and both bounds are real: Match spends one step of fuel
// PER ELEMENT through aml_eval_spend, and the byte loops are bounded by
// the payload heap, which is 8 KiB and refuses rather than growing. A
// `While(One) { Concatenate(Local0, "x", Local0) }` therefore terminates
// twice over — on fuel if the budget is small, on AML_ERR_OBJ_HEAP_FULL
// if it is not — and the corpus asserts both endings.
//
// OPCODES OWNED HERE
// ------------------
//   0x73 Concatenate         0x84 ConcatenateResTemplate
//   0x87 SizeOf              0x89 Match
//   0x96 ToBuffer            0x97 ToDecimalString
//   0x98 ToHexString         0x99 ToInteger
//   0x9C ToString            0x9E Mid
//
// Store, CopyObject, RefOf, CondRefOf, DerefOf, Index and ObjectType are
// #1057's and live in aml_str's sibling aml_ref.pdx.

module AmlStr = structure {

  // ==========================================================================
  // THE OPERAND TABLE. One row per operator whose operands are not the
  // default (Integer, Integer, Target, Integer).
  //
  //   [15:0]  op16
  //   [23:16] want for operand 0
  //   [31:24] want for operand 1
  //   [39:32] want for operand 2
  //   [47:40] want for operand 3
  // ==========================================================================
  //
  // TWO OF THE NINETEEN ROWS ARE NOT OPERATORS IN THE USUAL SENSE.
  //
  //   0x086 Notify (#1059) is a Type1Opcode — a STATEMENT, with no value.
  //   It is here because its operands still have types and the table is
  //   where operand types live. Its want of REFERENCE in position 0 does
  //   real work: aml_conv_cast returns a Reference unchanged and latches
  //   AML_ERR_BAD_REF for everything else, so `Notify(5, 0x80)` and
  //   `Notify(SOMEINT, 0x80)` are refused by the TABLE and Notify's body
  //   contains no type test of its own.
  //
  //   0xFF01 is not an opcode at all. It is the METHOD ARGUMENT position
  //   row (#1058), and 0xFF01 is chosen because op16 is a single-byte
  //   opcode (0x00..0xFF) or an extended one (0x5Bxx), so nothing in the
  //   encoding can ever collide with it. Its wants are ANY in every
  //   position, which is a POSITIVE STATEMENT and not a filler: ACPI 6.5
  //   §19.6.83 gives method arguments no implicit conversion, the callee
  //   sees exactly the object the caller computed, and WITHOUT THIS ROW
  //   the default shape would apply — position 0 would want Integer and
  //   position 2 would want TARGET, which is wrong in both places and
  //   would silently coerce every Buffer argument ever passed. The row is
  //   what makes aml_eval_call's promotion loop a table lookup rather
  //   than a special case, so a future predefined-method signature table
  //   (`_OSI` wanting String, `_SRS` wanting Buffer) is a row edit and
  //   not a new code path.
  //
  pub let aml_conv_len : u64 = 19

  pub let aml_conv_tab : [u64; 19] = [
    0x0000000065000070,  // 0x070 Store      ANY, TARGET
    0x0000000000650071,  // 0x071 RefOf      TARGET (a name, not a value)
    0x0000006564000073,  // 0x073 Concat     ANY, SAME-AS-0, TARGET
    0x0000000000000083,  // 0x083 DerefOf    ANY
    0x0000006503030084,  // 0x084 ConcatRes  BUFFER, BUFFER, TARGET
    0x0000000001140086,  // 0x086 Notify     REFERENCE, INTEGER
    0x0000000000000087,  // 0x087 SizeOf     ANY
    0x0000006501000088,  // 0x088 Index      ANY, INTEGER, TARGET
    0x0001000000000089,  // 0x089 Match      ANY, ANY, ANY, INTEGER
    0x000000000000008E,  // 0x08E ObjectType ANY
    0x0000000065030096,  // 0x096 ToBuffer   BUFFER, TARGET
    0x00000000650C0097,  // 0x097 ToDecStr   STRING-DECIMAL, TARGET
    0x0000000065020098,  // 0x098 ToHexStr   STRING-HEX, TARGET
    0x0000000065010099,  // 0x099 ToInteger  INTEGER, TARGET
    0x000000650103009C,  // 0x09C ToString   BUFFER, INTEGER, TARGET
    0x000000006500009D,  // 0x09D CopyObject ANY, TARGET
    0x000065010100009E,  // 0x09E Mid        ANY, INTEGER, INTEGER, TARGET
    0x0000000065655B12,  // 0x5B12 CondRefOf TARGET, TARGET
    0x000000000000FF01   // METHOD ARG       ANY, ANY, ANY, ANY  (§19.6.83)
  ]

  pub let aml_conv_argop : u64 = 0xFF01

  pub let aml_conv_want : (u64, u64) -> u64 !{mem} @{} =
    fn (op16: u64) (pos: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M2-003 (#1056): the type operator rdi wants in operand position rsi, per ACPI 6.5 §19.3.5.5. A LINEAR scan of seventeen rows rather than a binary search: the table is small, a linear scan cannot be wrong about ordering, and the opcode table next door already carries the cost of proving its own rows are sorted. An opcode with no row gets the DEFAULT shape -- Integer, Integer, Target, Integer -- which is exactly the shape of every arithmetic and logical operator, so #1055's twenty-four operators are described by this function without occupying a row and the corpus can assert that aml_eval_node's integer fast path agrees with the table it does not consult. That agreement is the whole reason the default is spelled out here rather than left implicit. Locals: r12=op16, r13=pos, r14=cursor. Reserved labels: aml_cw_.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;
        mov r12, rdi;
        mov r13, rsi;
        cmp r13, 4;
        jae aml_cw_zero;
        lea rcx, [rip + aml_conv_len];
        mov r15, [rcx];
        lea rcx, [rip + aml_conv_tab];
        xor r14, r14;
      aml_cw_scan:
        cmp r14, r15;
        jae aml_cw_default;
        mov rax, [rcx + r14*8];
        mov rdx, rax;
        mov r8, 0xFFFF;
        and rdx, r8;
        cmp rdx, r12;
        je aml_cw_hit;
        add r14, 1;
        jmp aml_cw_scan;
      aml_cw_hit:
        mov rcx, r13;
        shl rcx, 3;
        add rcx, 16;
        shr rax, cl;
        mov rdx, 0xFF;
        and rax, rdx;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret;
      aml_cw_default:
        cmp r13, 2;
        je aml_cw_dtarget;
        mov rax, 1;                      // Integer
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret;
      aml_cw_dtarget:
        mov rax, 101;                    // TARGET
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret;
      aml_cw_zero:
        xor rax, rax;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Integer -> String.
  // ==========================================================================

  pub let aml_conv_dec_digits : (u64) -> u64 !{mem} @{} =
    fn (value: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M2-003 (#1056): how many decimal digits rdi needs, minimum one. Counted by repeated division rather than by a table of powers of ten because the value is already truncated to the table width and the loop runs at most twenty times; a power table would be twenty constants to get wrong for a saving no caller can measure. Zero needs one digit, which is the case a bare division loop returns zero for and the reason the test is written as do-while. Locals: r12=value, r13=count. Reserved labels: aml_cdd_.",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        mov r13, 1;
        mov rcx, 10;
      aml_cdd_loop:
        mov rax, r12;
        cmp rax, 10;
        jb aml_cdd_out;
        xor rdx, rdx;
        div rcx;
        mov r12, rax;
        add r13, 1;
        jmp aml_cdd_loop;
      aml_cdd_out:
        mov rax, r13;
        pop r13;
        pop r12;
        ret
      }
    } @no_frame

  pub let aml_conv_int_to_str : (u64, u64) -> u64 !{mem} @{} =
    fn (value: u64) (base: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M2-003 (#1056): convert integer rdi to a String object in base rsi (10 or 16). The two bases are NOT symmetric and that asymmetry is ACPICA's, not an oversight: base 16 produces a FIXED-WIDTH ZERO-PADDED string of width/4 characters, so ToHexString(One) on a 64-bit table is sixteen characters ending in '1'; base 10 suppresses leading zeros. Tables index into hex strings at fixed offsets, which is only meaningful if the width is fixed, and tables print decimal strings for humans, which is only readable if it is not padded. Digits are emitted most-significant first for hex (a shift per digit) and least-significant first into a pre-sized buffer for decimal (a division per digit), which is the natural direction for each and avoids a reversal pass. Locals: r12=value, r13=base, r14=object, r15=cursor; [rsp+0]=digit count. Reserved labels: aml_cis_.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 16;
        mov r12, rdi;
        mov r13, rsi;
        cmp r13, 16;
        je aml_cis_hex;

        // ---- decimal, leading zeros suppressed ----
        mov rdi, r12;
        call aml_conv_dec_digits;
        mov [rsp + 0], rax;
        mov rdi, rax;
        call aml_obj_str_alloc;
        mov r14, rax;
        cmp r14, 0;
        je aml_cis_out;
        mov r15, [rsp + 0];
      aml_cis_dec:
        cmp r15, 0;
        je aml_cis_ok;
        sub r15, 1;
        mov rax, r12;
        xor rdx, rdx;
        mov rcx, 10;
        div rcx;
        mov r12, rax;                    // quotient
        add rdx, 48;                     // '0'
        mov rdi, r14;
        mov rsi, r15;
        call aml_obj_set_byte;
        jmp aml_cis_dec;

        // ---- hex, fixed width, zero padded ----
      aml_cis_hex:
        call aml_eval_width;
        shr rax, 2;                      // width/4 hex digits
        mov [rsp + 0], rax;
        mov rdi, rax;
        call aml_obj_str_alloc;
        mov r14, rax;
        cmp r14, 0;
        je aml_cis_out;
        xor r15, r15;
      aml_cis_hloop:
        mov rax, [rsp + 0];
        cmp r15, rax;
        jae aml_cis_ok;
        sub rax, r15;
        sub rax, 1;
        shl rax, 2;                      // bit position of this nibble
        mov rcx, rax;
        mov rax, r12;
        shr rax, cl;
        mov rdx, 15;
        and rax, rdx;
        cmp rax, 10;
        jb aml_cis_hdec;
        add rax, 55;                     // 'A' - 10
        jmp aml_cis_hput;
      aml_cis_hdec:
        add rax, 48;                     // '0'
      aml_cis_hput:
        mov rdx, rax;
        mov rdi, r14;
        mov rsi, r15;
        call aml_obj_set_byte;
        add r15, 1;
        jmp aml_cis_hloop;

      aml_cis_ok:
        mov rax, r14;
      aml_cis_out:
        mov rax, r14;
        add rsp, 16;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    } @no_frame

  pub let aml_conv_buf_to_str : (u64, u64) -> u64 !{mem} @{} =
    fn (obj: u64) (base: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M2-003 (#1056): convert Buffer rdi to a comma-separated element String in base rsi. A BUFFER IS A LIST, NOT A NUMBER (§19.6.142/143 and AcpiExConvertToString): a three-byte buffer becomes 'AB,CD,EF' in hex or '1,2,3' in decimal, never one eight-digit number. Each hex element is exactly two uppercase digits -- zero-padded, unlike an Integer's decimal -- because a byte is a byte and dropping the leading zero of 0x0F would make the list ambiguous. An EMPTY buffer becomes an EMPTY string rather than a lone comma or a zero. Two passes: the first sizes the result exactly, the second fills it, which is the only way to allocate once from a bump heap that cannot resize. Decimal digits are written BACKWARDS from the element's last position, because division yields the least significant digit first and reversing afterwards would need a scratch buffer this module does not have. Locals: r12=object, r13=base, r14=length, r15=element cursor; [rsp+0]=result, [rsp+8]=write position, [rsp+16]=size accumulator then element value, [rsp+24]=digit count, [rsp+32]=digit write position. Reserved labels: aml_cbs_.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 48;
        mov r12, rdi;
        mov r13, rsi;
        call aml_obj_len;
        mov r14, rax;
        cmp r14, 0;
        je aml_cbs_empty;
        // ---- pass 1: size ----
        xor r15, r15;
        mov rax, r14;
        sub rax, 1;
        mov [rsp + 16], rax;             // one comma between each pair
      aml_cbs_size:
        cmp r15, r14;
        jae aml_cbs_alloc;
        cmp r13, 16;
        je aml_cbs_size_hex;
        mov rdi, r12;
        mov rsi, r15;
        call aml_obj_byte;
        mov rdi, rax;
        call aml_conv_dec_digits;
        mov rdx, [rsp + 16];
        add rdx, rax;
        mov [rsp + 16], rdx;
        add r15, 1;
        jmp aml_cbs_size;
      aml_cbs_size_hex:
        mov rdx, [rsp + 16];
        add rdx, 2;
        mov [rsp + 16], rdx;
        add r15, 1;
        jmp aml_cbs_size;
      aml_cbs_alloc:
        mov rdi, [rsp + 16];
        call aml_obj_str_alloc;
        mov [rsp + 0], rax;
        cmp rax, 0;
        je aml_cbs_out;
        // ---- pass 2: fill ----
        xor r15, r15;
        xor rax, rax;
        mov [rsp + 8], rax;              // write position
      aml_cbs_fill:
        cmp r15, r14;
        jae aml_cbs_done;
        cmp r15, 0;
        je aml_cbs_elem;
        mov rdi, [rsp + 0];
        mov rsi, [rsp + 8];
        mov rdx, 44;                     // ','
        call aml_obj_set_byte;
        mov rax, [rsp + 8];
        add rax, 1;
        mov [rsp + 8], rax;
      aml_cbs_elem:
        mov rdi, r12;
        mov rsi, r15;
        call aml_obj_byte;
        cmp r13, 16;
        je aml_cbs_hex;
        // ---- decimal element, no padding, written back to front ----
        mov [rsp + 16], rax;             // the value
        mov rdi, rax;
        call aml_conv_dec_digits;
        mov [rsp + 24], rax;             // digit count
        mov rdx, [rsp + 8];
        add rdx, rax;
        mov [rsp + 32], rdx;             // one past this element's last digit
        mov [rsp + 8], rdx;              // the next element starts there
      aml_cbs_dloop:
        mov rax, [rsp + 24];
        cmp rax, 0;
        je aml_cbs_next;
        sub rax, 1;
        mov [rsp + 24], rax;
        mov rax, [rsp + 32];
        sub rax, 1;
        mov [rsp + 32], rax;
        mov rax, [rsp + 16];
        xor rdx, rdx;
        mov rcx, 10;
        div rcx;
        mov [rsp + 16], rax;             // quotient
        add rdx, 48;                     // '0' + remainder
        mov rdi, [rsp + 0];
        mov rsi, [rsp + 32];
        call aml_obj_set_byte;
        jmp aml_cbs_dloop;
      aml_cbs_hex:
        mov [rsp + 24], rax;
        shr rax, 4;
        mov rdx, 15;
        and rax, rdx;
        cmp rax, 10;
        jb aml_cbs_h0d;
        add rax, 55;
        jmp aml_cbs_h0p;
      aml_cbs_h0d:
        add rax, 48;
      aml_cbs_h0p:
        mov rdx, rax;
        mov rdi, [rsp + 0];
        mov rsi, [rsp + 8];
        call aml_obj_set_byte;
        mov rax, [rsp + 24];
        mov rdx, 15;
        and rax, rdx;
        cmp rax, 10;
        jb aml_cbs_h1d;
        add rax, 55;
        jmp aml_cbs_h1p;
      aml_cbs_h1d:
        add rax, 48;
      aml_cbs_h1p:
        mov rdx, rax;
        mov rdi, [rsp + 0];
        mov rsi, [rsp + 8];
        add rsi, 1;
        call aml_obj_set_byte;
        mov rax, [rsp + 8];
        add rax, 2;
        mov [rsp + 8], rax;
      aml_cbs_next:
        add r15, 1;
        jmp aml_cbs_fill;
      aml_cbs_done:
        mov rax, [rsp + 0];
        add rsp, 48;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret;
      aml_cbs_empty:
        xor rdi, rdi;
        call aml_obj_str_alloc;
        add rsp, 48;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret;
      aml_cbs_out:
        xor rax, rax;
        add rsp, 48;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    } @no_frame

  // ==========================================================================
  // String / Buffer -> Integer.
  // ==========================================================================

  pub let aml_conv_str_to_int : (u64) -> u64 !{mem} @{} =
    fn (obj: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M2-003 (#1056): the integer value of String rdi, per §19.6.144 as ACPICA implements it. Leading blanks and tabs are skipped; a '0x' or '0X' prefix selects hexadecimal, otherwise decimal; digits are accumulated until the first character that is not a digit IN THE CHOSEN BASE, and what was accumulated is the answer. A string with no digits at all is ZERO AND NOT AN ERROR -- refusing it would refuse real tables that hand ToInteger a version string -- while a string of digits followed by junk yields the digits, which is what firmware expects when it parses a partly-numeric identifier. The result goes through aml_eval_trunc, so a sixteen-digit hex string in a revision-1 table wraps to 32 bits exactly as an arithmetic result would. The scan is bounded by the object's own length, so the NUL is never required to stop it. Locals: r12=object, r13=length, r14=cursor, r15=accumulator; [rsp+0]=base. Reserved labels: aml_csi_.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 16;
        mov r12, rdi;
        call aml_obj_len;
        mov r13, rax;
        xor r14, r14;
        xor r15, r15;
        mov rax, 10;
        mov [rsp + 0], rax;
      aml_csi_blank:
        cmp r14, r13;
        jae aml_csi_done;
        mov rdi, r12;
        mov rsi, r14;
        call aml_obj_byte;
        cmp rax, 32;                     // ' '
        je aml_csi_skip;
        cmp rax, 9;                      // '\t'
        jne aml_csi_prefix;
      aml_csi_skip:
        add r14, 1;
        jmp aml_csi_blank;
      aml_csi_prefix:
        cmp rax, 48;                     // '0'
        jne aml_csi_digits;
        mov rax, r14;
        add rax, 1;
        cmp rax, r13;
        jae aml_csi_digits;
        mov rdi, r12;
        mov rsi, rax;
        call aml_obj_byte;
        cmp rax, 120;                    // 'x'
        je aml_csi_hex;
        cmp rax, 88;                     // 'X'
        jne aml_csi_digits;
      aml_csi_hex:
        mov rax, 16;
        mov [rsp + 0], rax;
        add r14, 2;
      aml_csi_digits:
        cmp r14, r13;
        jae aml_csi_done;
        mov rdi, r12;
        mov rsi, r14;
        call aml_obj_byte;
        mov rdx, rax;
        cmp rdx, 48;
        jb aml_csi_done;
        cmp rdx, 57;                     // '0'..'9'
        jbe aml_csi_dig09;
        mov rcx, [rsp + 0];
        cmp rcx, 16;
        jne aml_csi_done;
        cmp rdx, 65;
        jb aml_csi_done;
        cmp rdx, 70;                     // 'A'..'F'
        jbe aml_csi_digAF;
        cmp rdx, 97;
        jb aml_csi_done;
        cmp rdx, 102;                    // 'a'..'f'
        ja aml_csi_done;
        sub rdx, 87;
        jmp aml_csi_acc;
      aml_csi_digAF:
        sub rdx, 55;
        jmp aml_csi_acc;
      aml_csi_dig09:
        sub rdx, 48;
      aml_csi_acc:
        mov r8, rdx;                     // the digit
        mov rax, r15;
        mov rcx, [rsp + 0];
        imul rax, rcx;
        add rax, r8;
        mov r15, rax;
        add r14, 1;
        jmp aml_csi_digits;
      aml_csi_done:
        mov rdi, r15;
        call aml_eval_trunc;
        add rsp, 16;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    } @no_frame

  pub let aml_conv_buf_to_int : (u64) -> u64 !{mem} @{} =
    fn (obj: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M2-003 (#1056): the integer value of Buffer rdi -- the first width/8 bytes, LITTLE ENDIAN, zero-extended when the buffer is shorter. Taking MIN(length, width/8) rather than refusing a longer buffer is ACPICA's behaviour and the one real tables depend on: a _CRS fragment handed to ToInteger is routinely longer than eight bytes and the low bytes are what was meant. A buffer shorter than the width is zero-extended rather than sign-extended because AML integers are unsigned. Locals: r12=object, r13=byte count, r14=cursor, r15=accumulator. Reserved labels: aml_cbi_.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;
        mov r12, rdi;
        call aml_eval_width;
        shr rax, 3;
        mov r13, rax;                    // width in bytes
        mov rdi, r12;
        call aml_obj_len;
        cmp rax, r13;
        jae aml_cbi_go;
        mov r13, rax;
      aml_cbi_go:
        xor r14, r14;
        xor r15, r15;
      aml_cbi_loop:
        cmp r14, r13;
        jae aml_cbi_done;
        mov rdi, r12;
        mov rsi, r14;
        call aml_obj_byte;
        mov rcx, r14;
        shl rcx, 3;
        shl rax, cl;
        or r15, rax;
        add r14, 1;
        jmp aml_cbi_loop;
      aml_cbi_done:
        mov rax, r15;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Integer / String -> Buffer.
  // ==========================================================================

  pub let aml_conv_int_to_buf : (u64) -> u64 !{mem} @{} =
    fn (value: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M2-003 (#1056): convert integer rdi to a Buffer of width/8 little-endian bytes (§19.3.5.4). The LENGTH FOLLOWS THE TABLE REVISION, not the magnitude of the value: `ToBuffer(One)` is four bytes on a revision-1 table and eight on a revision-2 one, and a table that copies the result into a fixed-size field depends on exactly that. Sizing it to the significant bytes instead would produce a one-byte buffer for One, which then fails to fill a four-byte field and leaves three bytes of whatever was there. Locals: r12=value, r13=byte count, r14=object, r15=cursor. Reserved labels: aml_cib_.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;
        mov r12, rdi;
        call aml_eval_width;
        shr rax, 3;
        mov r13, rax;
        mov rdi, r13;
        call aml_obj_buf_alloc;
        mov r14, rax;
        cmp r14, 0;
        je aml_cib_out;
        xor r15, r15;
      aml_cib_loop:
        cmp r15, r13;
        jae aml_cib_out;
        mov rcx, r15;
        shl rcx, 3;
        mov rax, r12;
        shr rax, cl;
        mov rdx, 255;
        and rax, rdx;
        mov rdx, rax;
        mov rdi, r14;
        mov rsi, r15;
        call aml_obj_set_byte;
        add r15, 1;
        jmp aml_cib_loop;
      aml_cib_out:
        mov rax, r14;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    } @no_frame

  pub let aml_conv_str_to_buf : (u64) -> u64 !{mem} @{} =
    fn (obj: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M2-003 (#1056): convert String rdi to a Buffer, INCLUDING THE TERMINATING NUL, per §19.6.140. The NUL is not an implementation detail here: `ToBuffer(\"AB\")` is three bytes and a table that builds a _HID string and stores it into a buffer field relies on the terminator being present. Dropping it produces a two-byte buffer and a field whose last byte is stale. The copy is len+1 bytes, which aml_obj_copy permits because a String object owns the byte one past its recorded length. Locals: r12=object, r13=length, r14=result. Reserved labels: aml_csb_.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;
        mov r12, rdi;
        call aml_obj_len;
        mov r13, rax;
        mov rdi, r13;
        add rdi, 1;
        call aml_obj_buf_alloc;
        mov r14, rax;
        cmp r14, 0;
        je aml_csb_out;
        mov rdi, r14;
        xor rsi, rsi;
        mov rdx, r12;
        xor rcx, rcx;
        mov r8, r13;
        add r8, 1;
        call aml_obj_copy;
      aml_csb_out:
        mov rax, r14;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    } @no_frame

  // ==========================================================================
  // THE CAST. (wanted type, actual type) -> the converted object.
  // ==========================================================================

  pub let aml_conv_cast : (u64, u64) -> u64 !{mem} @{} =
    fn (obj: u64) (want: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M2-003 (#1056): convert object rdi to the type rsi wants, per ACPI 6.5 §19.3.5. THE SECOND HALF OF THE CONVERSION MODEL: aml_conv_want says what the operator wants, this says how to get it, and no operator implements a conversion of its own. Want 0 (ANY) and want 100 (SAME-AS-0) return the object untouched -- the first because the operator inspects the type itself, the second because only Concatenate can resolve it and it does so by calling back here with a concrete type. An object ALREADY of the wanted type is returned as-is rather than copied, which matters for more than speed: Store(FOO, BAR) with both Buffers must not silently deep-copy, because CopyObject is the operator that means that and Store is not. A pair with no conversion defined -- Package to Integer, reference to String -- is AML_ERR_NO_CONVERSION (47), never a zero, because a zero-valued Integer standing in for 'this Package is not a number' is a wrong answer that arithmetic will happily consume. Locals: r12=object, r13=want, r14=actual type. Reserved labels: aml_cc_.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;
        mov r12, rdi;
        mov r13, rsi;
        cmp r13, 0;
        je aml_cc_same;                  // ANY
        mov rax, 100;
        cmp r13, rax;
        je aml_cc_same;                  // SAME-AS-0: the caller resolves it
        mov rax, 101;
        cmp r13, rax;
        je aml_cc_same;                  // TARGET: never a value
        cmp r12, 0;
        je aml_cc_none;
        mov rdi, r12;
        call aml_obj_type;
        mov r14, rax;
        cmp r14, r13;
        je aml_cc_same;                  // already the wanted type
        cmp r13, 1;
        je aml_cc_int;
        cmp r13, 2;
        je aml_cc_str;
        mov rax, 12;
        cmp r13, rax;
        je aml_cc_strdec;
        cmp r13, 3;
        je aml_cc_buf;
        cmp r13, 4;
        je aml_cc_no;                    // nothing converts TO a Package
        mov rax, 20;
        cmp r13, rax;
        je aml_cc_ref;
        jmp aml_cc_no;

      aml_cc_int:
        cmp r14, 2;
        je aml_cc_int_s;
        cmp r14, 3;
        jne aml_cc_no;
        mov rdi, r12;
        call aml_conv_buf_to_int;
        jmp aml_cc_mkint;
      aml_cc_int_s:
        mov rdi, r12;
        call aml_conv_str_to_int;
      aml_cc_mkint:
        mov rdi, rax;
        call aml_obj_int;
        jmp aml_cc_ret;

      aml_cc_str:
        cmp r14, 1;
        je aml_cc_str_i;
        cmp r14, 3;
        jne aml_cc_no;
        mov rdi, r12;
        mov rsi, 16;
        call aml_conv_buf_to_str;
        jmp aml_cc_ret;
      aml_cc_str_i:
        mov rdi, r12;
        call aml_obj_base;
        mov rdi, rax;
        mov rsi, 16;
        call aml_conv_int_to_str;
        jmp aml_cc_ret;

      aml_cc_strdec:
        cmp r14, 2;
        je aml_cc_same;                  // a String is already a String
        cmp r14, 1;
        je aml_cc_sd_i;
        cmp r14, 3;
        jne aml_cc_no;
        mov rdi, r12;
        mov rsi, 10;
        call aml_conv_buf_to_str;
        jmp aml_cc_ret;
      aml_cc_sd_i:
        mov rdi, r12;
        call aml_obj_base;
        mov rdi, rax;
        mov rsi, 10;
        call aml_conv_int_to_str;
        jmp aml_cc_ret;

      aml_cc_buf:
        cmp r14, 1;
        je aml_cc_buf_i;
        cmp r14, 2;
        jne aml_cc_no;
        mov rdi, r12;
        call aml_conv_str_to_buf;
        jmp aml_cc_ret;
      aml_cc_buf_i:
        mov rdi, r12;
        call aml_obj_base;
        mov rdi, rax;
        call aml_conv_int_to_buf;
        jmp aml_cc_ret;

      aml_cc_ref:
        mov rdi, 45;                     // AML_ERR_BAD_REF
        call aml_eval_set_err;
        jmp aml_cc_none;

      aml_cc_no:
        mov rdi, 47;                     // AML_ERR_NO_CONVERSION
        call aml_eval_set_err;
      aml_cc_none:
        xor rax, rax;
        jmp aml_cc_ret;

      aml_cc_same:
        mov rax, r12;
      aml_cc_ret:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    } @no_frame

  pub let aml_conv_operand : (u64, u64) -> u64 !{mem} @{} =
    fn (expr_node: u64) (pos: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M2-003 (#1056): evaluate operand rsi of EXPR node rdi and convert it to whatever the operator wants there. THE single operand-fetch for every operator in this file and in aml_ref.pdx, which is what makes the (operator, position) table load-bearing rather than documentation -- an implementation that fetched its own operands could disagree with the table and nothing would notice. A TARGET position (want 101) returns 0 without evaluating anything, because a destination is a NODE to be stored into and evaluating it would read the very object about to be overwritten. Locals: r12=node, r13=pos, r14=want. Reserved labels: aml_co_.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;
        mov r12, rdi;
        mov r13, rsi;
        call aml_node_flags;
        mov rdi, rax;
        mov rsi, r13;
        call aml_conv_want;
        mov r14, rax;
        mov rax, 101;
        cmp r14, rax;
        je aml_co_none;
        mov rdi, r12;
        mov rsi, r13;
        call aml_arith_child;
        cmp rax, 0;
        je aml_co_none;
        mov rdi, rax;
        call aml_eval_obj;
        cmp rax, 0;
        je aml_co_out;
        mov rdi, rax;
        mov rsi, r14;
        call aml_conv_cast;
        jmp aml_co_out;
      aml_co_none:
        xor rax, rax;
      aml_co_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Comparison, shared by Match and by the logical use of strings.
  // ==========================================================================

  pub let aml_str_cmp : (u64, u64) -> u64 !{mem} @{} =
    fn (a: u64) (b: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M2-003 (#1056): compare two objects of the SAME type; 0 equal, 1 a greater, 2 a less. Integers compare UNSIGNED (ja/jb), for the reason stated in aml_arith.pdx: a signed compare ranks Ones below Zero and inverts every ordering test in the table. Strings and Buffers compare byte by byte to the shorter length and then by LENGTH, which is the lexicographic order §19.6.65 specifies for Match and which ACPICA implements -- comparing only to the shorter length would make 'AB' and 'ABC' equal and let Match return the wrong element. A type this does not understand answers 'not equal, not greater', so a Match against it simply never matches instead of latching, which is what an uninitialised or exotic package element must do. Locals: r12=a, r13=b, r14=n, r15=cursor. Reserved labels: aml_scm_.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 16;
        mov r12, rdi;
        mov r13, rsi;
        call aml_obj_type;
        mov [rsp + 0], rax;
        cmp rax, 1;
        je aml_scm_int;
        cmp rax, 2;
        je aml_scm_bytes;
        cmp rax, 3;
        je aml_scm_bytes;
        mov rax, 2;                      // unknown: report 'less', never equal
        jmp aml_scm_out;

      aml_scm_int:
        mov rdi, r12;
        call aml_obj_base;
        mov r14, rax;
        mov rdi, r13;
        call aml_obj_base;
        cmp r14, rax;
        ja aml_scm_gt;
        jb aml_scm_lt;
        jmp aml_scm_eq;

      aml_scm_bytes:
        mov rdi, r12;
        call aml_obj_len;
        mov r14, rax;
        mov [rsp + 8], rax;
        mov rdi, r13;
        call aml_obj_len;
        cmp rax, r14;
        jae aml_scm_go;
        mov r14, rax;                    // n = min(la, lb)
      aml_scm_go:
        xor r15, r15;
      aml_scm_loop:
        cmp r15, r14;
        jae aml_scm_bylen;
        mov rdi, r12;
        mov rsi, r15;
        call aml_obj_byte;
        mov rdx, rax;
        mov rdi, r13;
        mov rsi, r15;
        call aml_obj_byte;
        cmp rdx, rax;
        ja aml_scm_gt;
        jb aml_scm_lt;
        add r15, 1;
        jmp aml_scm_loop;
      aml_scm_bylen:
        mov rdi, r13;
        call aml_obj_len;
        mov rdx, [rsp + 8];
        cmp rdx, rax;
        ja aml_scm_gt;
        jb aml_scm_lt;
      aml_scm_eq:
        xor rax, rax;
        jmp aml_scm_out;
      aml_scm_gt:
        mov rax, 1;
        jmp aml_scm_out;
      aml_scm_lt:
        mov rax, 2;
      aml_scm_out:
        add rsp, 16;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Concatenate — §19.6.13. The result type is keyed off operand 0.
  // ==========================================================================

  pub let aml_str_concat : (u64, u64) -> u64 !{mem} @{} =
    fn (a: u64) (b: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M2-003 (#1056): Concatenate(rdi, rsi) per ACPI 6.5 §19.6.13. THE OPERATOR THAT PROVES CONVERSION IS OPERATOR-KEYED: given an Integer operand, `Add` would convert it to nothing and `Concatenate` converts the OTHER operand TO an Integer and produces a BUFFER of the two integers laid end to end at the table's width. Three cases, keyed on the RUNTIME type of operand 0, which is what want-code 100 in the operand table denotes: Integer gives a Buffer of 2*(width/8) bytes; String gives a String; Buffer gives a Buffer. Any other first operand -- a Package, a reference -- is AML_ERR_BAD_OBJTYPE (48), because there is no defined concatenation for them and inventing one would silently accept a table that meant something else. Note the Integer case produces a BUFFER, not an Integer: it is the one case where the result type differs from the operand type, and getting it wrong yields an Integer whose value looks like the second operand. Locals: r12=a, r13=b, r14=type of a, r15=result; [rsp+0]=len(a), [rsp+8]=len(b). Reserved labels: aml_sct_.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 32;
        mov r12, rdi;
        mov r13, rsi;
        cmp r12, 0;
        je aml_sct_bad;
        cmp r13, 0;
        je aml_sct_bad;
        mov rdi, r12;
        call aml_obj_type;
        mov r14, rax;
        cmp r14, 1;
        je aml_sct_int;
        cmp r14, 2;
        je aml_sct_str;
        cmp r14, 3;
        je aml_sct_buf;
        jmp aml_sct_bad;

        // ---- Integer + Integer -> Buffer of two width-sized integers ----
      aml_sct_int:
        mov rdi, r13;
        mov rsi, 1;
        call aml_conv_cast;
        mov r13, rax;
        cmp r13, 0;
        je aml_sct_fail;
        call aml_eval_width;
        shr rax, 3;
        mov [rsp + 0], rax;              // bytes per integer
        mov rdi, rax;
        add rdi, rax;
        call aml_obj_buf_alloc;
        mov r15, rax;
        cmp r15, 0;
        je aml_sct_fail;
        mov rdi, r12;
        call aml_obj_base;
        mov [rsp + 8], rax;
        xor rcx, rcx;
      aml_sct_ia:
        mov rdx, [rsp + 0];
        cmp rcx, rdx;
        jae aml_sct_ib0;
        mov [rsp + 16], rcx;
        mov rax, [rsp + 8];
        shl rcx, 3;
        shr rax, cl;
        mov rdx, 255;
        and rax, rdx;
        mov rdx, rax;
        mov rdi, r15;
        mov rsi, [rsp + 16];
        call aml_obj_set_byte;
        mov rcx, [rsp + 16];
        add rcx, 1;
        jmp aml_sct_ia;
      aml_sct_ib0:
        mov rdi, r13;
        call aml_obj_base;
        mov [rsp + 8], rax;
        xor rcx, rcx;
      aml_sct_ib:
        mov rdx, [rsp + 0];
        cmp rcx, rdx;
        jae aml_sct_done;
        mov [rsp + 16], rcx;
        mov rax, [rsp + 8];
        shl rcx, 3;
        shr rax, cl;
        mov rdx, 255;
        and rax, rdx;
        mov rdx, rax;
        mov rdi, r15;
        mov rsi, [rsp + 16];
        mov rcx, [rsp + 0];
        add rsi, rcx;
        call aml_obj_set_byte;
        mov rcx, [rsp + 16];
        add rcx, 1;
        jmp aml_sct_ib;

        // ---- String + String -> String ----
      aml_sct_str:
        mov rdi, r13;
        mov rsi, 2;
        call aml_conv_cast;
        mov r13, rax;
        cmp r13, 0;
        je aml_sct_fail;
        mov rdi, r12;
        call aml_obj_len;
        mov [rsp + 0], rax;
        mov rdi, r13;
        call aml_obj_len;
        mov [rsp + 8], rax;
        mov rdi, [rsp + 0];
        add rdi, rax;
        call aml_obj_str_alloc;
        mov r15, rax;
        cmp r15, 0;
        je aml_sct_fail;
        mov rdi, r15;
        xor rsi, rsi;
        mov rdx, r12;
        xor rcx, rcx;
        mov r8, [rsp + 0];
        call aml_obj_copy;
        mov rdi, r15;
        mov rsi, [rsp + 0];
        mov rdx, r13;
        xor rcx, rcx;
        mov r8, [rsp + 8];
        call aml_obj_copy;
        jmp aml_sct_done;

        // ---- Buffer + Buffer -> Buffer ----
      aml_sct_buf:
        mov rdi, r13;
        mov rsi, 3;
        call aml_conv_cast;
        mov r13, rax;
        cmp r13, 0;
        je aml_sct_fail;
        mov rdi, r12;
        call aml_obj_len;
        mov [rsp + 0], rax;
        mov rdi, r13;
        call aml_obj_len;
        mov [rsp + 8], rax;
        mov rdi, [rsp + 0];
        add rdi, rax;
        call aml_obj_buf_alloc;
        mov r15, rax;
        cmp r15, 0;
        je aml_sct_fail;
        mov rdi, r15;
        xor rsi, rsi;
        mov rdx, r12;
        xor rcx, rcx;
        mov r8, [rsp + 0];
        call aml_obj_copy;
        mov rdi, r15;
        mov rsi, [rsp + 0];
        mov rdx, r13;
        xor rcx, rcx;
        mov r8, [rsp + 8];
        call aml_obj_copy;
        jmp aml_sct_done;

      aml_sct_bad:
        mov rdi, 48;                     // AML_ERR_BAD_OBJTYPE
        call aml_eval_set_err;
      aml_sct_fail:
        xor r15, r15;
      aml_sct_done:
        mov rax, r15;
        add rsp, 32;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Resource-template concatenation — §19.6.14.
  // ==========================================================================

  pub let aml_str_res_end : (u64) -> u64 !{mem} @{} =
    fn (obj: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M2-003 (#1056): walk the resource descriptors of Buffer rdi and return the OFFSET OF ITS EndTag, or 0 if it is not a well-formed template. ConcatenateResTemplate is only defined over templates (§19.6.14), and 'assume it ends with an EndTag' is not the same check: a buffer whose last two bytes happen to be 0x79 0x00 but whose descriptor chain does not reach them would be concatenated at the wrong point and produce a template the consumer walks into the middle of. So the chain is WALKED -- small descriptors are 1 + (tag & 7) bytes, large ones 3 + the 16-bit length -- and each step is checked to stay within the buffer and to make progress. This is the same decode as aml_resource.pdx's, over heap bytes rather than over the source buffer, and it is deliberately NOT a call into that module: aml_res_* is bound to the AML buffer through the lexer cursor and a heap object has no offset there. Offset 0 is unambiguous as a failure because a template's EndTag can never be its first byte -- an empty template is still a lone EndTag, and a lone EndTag at offset 0 with nothing before it is the one case that returns 0 and is rejected, which is correct since concatenating nothing is a table bug. Locals: r12=object, r13=length, r14=cursor, r15=next. Reserved labels: aml_sre_.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;
        mov r12, rdi;
        call aml_obj_type;
        cmp rax, 3;
        jne aml_sre_no;
        mov rdi, r12;
        call aml_obj_len;
        mov r13, rax;
        xor r14, r14;
      aml_sre_loop:
        cmp r14, r13;
        jae aml_sre_no;
        mov rdi, r12;
        mov rsi, r14;
        call aml_obj_byte;
        mov rdx, rax;
        mov rcx, 128;
        and rax, rcx;
        cmp rax, 0;
        jne aml_sre_large;
        // small: EndTag is item name 0x0F with length 1 -> tag byte 0x79
        mov rax, rdx;
        mov rcx, 0x79;
        cmp rax, rcx;
        je aml_sre_hit;
        mov rcx, 7;
        and rax, rcx;
        mov r15, r14;
        add r15, 1;
        add r15, rax;
        jmp aml_sre_step;
      aml_sre_large:
        mov rax, r14;
        add rax, 3;
        cmp rax, r13;
        ja aml_sre_no;
        mov rdi, r12;
        mov rsi, r14;
        add rsi, 1;
        call aml_obj_byte;
        mov r15, rax;
        mov rdi, r12;
        mov rsi, r14;
        add rsi, 2;
        call aml_obj_byte;
        shl rax, 8;
        or r15, rax;
        add r15, 3;
        add r15, r14;
      aml_sre_step:
        cmp r15, r14;
        jbe aml_sre_no;                  // no progress
        cmp r15, r13;
        ja aml_sre_no;
        mov r14, r15;
        jmp aml_sre_loop;
      aml_sre_hit:
        mov rax, r14;
        add rax, 2;
        cmp rax, r13;
        ja aml_sre_no;                   // EndTag without its checksum byte
        cmp r14, 0;
        je aml_sre_no;                   // a template with no descriptors
        mov rax, r14;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret;
      aml_sre_no:
        xor rax, rax;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    } @no_frame

  pub let aml_str_concat_res : (u64, u64) -> u64 !{mem} @{} =
    fn (a: u64) (b: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M2-003 (#1056): ConcatenateResTemplate(rdi, rsi) per §19.6.14 -- the descriptors of both templates followed by ONE new EndTag. The EndTag of each source is DROPPED, which is the whole difference from a plain Concatenate and the reason this operator exists: joining two templates byte for byte would leave an EndTag in the middle and every consumer would stop there, silently losing the second half. The new EndTag's checksum byte is written as ZERO, which §6.4.2.9 defines as 'checksum not present' and which is what iasl and ACPICA both emit for a generated template. A source that is not a well-formed template is AML_ERR_BAD_OBJTYPE (48). Locals: r12=a, r13=b, r14=end of a, r15=end of b; [rsp+0]=result. Reserved labels: aml_scr_.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 16;
        mov r12, rdi;
        mov r13, rsi;
        mov rdi, r12;
        call aml_str_res_end;
        mov r14, rax;
        cmp r14, 0;
        je aml_scr_bad;
        mov rdi, r13;
        call aml_str_res_end;
        mov r15, rax;
        cmp r15, 0;
        je aml_scr_bad;
        mov rdi, r14;
        add rdi, r15;
        add rdi, 2;
        call aml_obj_buf_alloc;
        mov [rsp + 0], rax;
        cmp rax, 0;
        je aml_scr_fail;
        mov rdi, [rsp + 0];
        xor rsi, rsi;
        mov rdx, r12;
        xor rcx, rcx;
        mov r8, r14;
        call aml_obj_copy;
        mov rdi, [rsp + 0];
        mov rsi, r14;
        mov rdx, r13;
        xor rcx, rcx;
        mov r8, r15;
        call aml_obj_copy;
        mov rdi, [rsp + 0];
        mov rsi, r14;
        add rsi, r15;
        mov rdx, 0x79;                   // EndTag
        call aml_obj_set_byte;
        mov rdi, [rsp + 0];
        mov rsi, r14;
        add rsi, r15;
        add rsi, 1;
        xor rdx, rdx;                    // checksum: 0 = not present
        call aml_obj_set_byte;
        mov rax, [rsp + 0];
        add rsp, 16;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret;
      aml_scr_bad:
        mov rdi, 48;                     // AML_ERR_BAD_OBJTYPE
        call aml_eval_set_err;
      aml_scr_fail:
        xor rax, rax;
        add rsp, 16;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Mid, ToString, SizeOf.
  // ==========================================================================

  pub let aml_str_mid : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (obj: u64) (index: u64) (length: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M2-003 (#1056): Mid(rdi, rsi, rdx) per §19.6.66 -- a sub-String of a String or a sub-Buffer of a Buffer, and never a change of type. An index at or beyond the source length yields an EMPTY result of the source's type, NOT an error: §19.6.66 defines it that way and a table that walks a string until Mid returns nothing depends on it. The length is CLAMPED to what remains rather than checked, for the same reason. Both clamps are computed in 64-bit arithmetic from firmware-supplied values, so the subtraction that produces 'what remains' is guarded by the index test that precedes it and cannot underflow. Locals: r12=object, r13=index, r14=count, r15=result. Reserved labels: aml_smd_.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 16;
        mov r12, rdi;
        mov r13, rsi;
        mov [rsp + 0], rdx;
        call aml_obj_type;
        mov [rsp + 8], rax;
        cmp rax, 2;
        je aml_smd_ok;
        cmp rax, 3;
        je aml_smd_ok;
        mov rdi, 48;                     // AML_ERR_BAD_OBJTYPE
        call aml_eval_set_err;
        jmp aml_smd_fail;
      aml_smd_ok:
        mov rdi, r12;
        call aml_obj_len;
        cmp r13, rax;
        jae aml_smd_zero;
        sub rax, r13;                    // what remains
        mov r14, [rsp + 0];
        cmp r14, rax;
        jbe aml_smd_alloc;
        mov r14, rax;
        jmp aml_smd_alloc;
      aml_smd_zero:
        xor r14, r14;
      aml_smd_alloc:
        mov rax, [rsp + 8];
        cmp rax, 2;
        je aml_smd_astr;
        mov rdi, r14;
        call aml_obj_buf_alloc;
        jmp aml_smd_got;
      aml_smd_astr:
        mov rdi, r14;
        call aml_obj_str_alloc;
      aml_smd_got:
        mov r15, rax;
        cmp r15, 0;
        je aml_smd_fail;
        cmp r14, 0;
        je aml_smd_done;
        mov rdi, r15;
        xor rsi, rsi;
        mov rdx, r12;
        mov rcx, r13;
        mov r8, r14;
        call aml_obj_copy;
      aml_smd_done:
        mov rax, r15;
        add rsp, 16;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret;
      aml_smd_fail:
        xor rax, rax;
        add rsp, 16;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    } @no_frame

  pub let aml_str_tostring : (u64, u64) -> u64 !{mem} @{} =
    fn (obj: u64) (length: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M2-003 (#1056): ToString(rdi, rsi) per §19.6.145 -- copy bytes out of a Buffer until the FIRST NUL or until rsi bytes have been taken, WHICHEVER COMES FIRST. Both terminators, not one. Stopping only at the NUL loses the length argument, which tables use to take a fixed-size field out of a longer buffer; stopping only at the length copies embedded NULs into the middle of a String, which then measures longer than it prints and breaks every consumer that trusts SizeOf. The absent-length encoding is Ones, and it needs no special case because it is larger than any buffer and the length clamp handles it -- but the clamp must therefore be an unsigned MIN against the buffer length, which it is. Locals: r12=object, r13=limit, r14=count, r15=result. Reserved labels: aml_sts_.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;
        mov r12, rdi;
        mov r13, rsi;
        call aml_obj_type;
        cmp rax, 3;
        jne aml_sts_bad;
        mov rdi, r12;
        call aml_obj_len;
        cmp r13, rax;
        jbe aml_sts_scan;
        mov r13, rax;                    // clamp to the buffer, absorbs Ones
      aml_sts_scan:
        xor r14, r14;
      aml_sts_loop:
        cmp r14, r13;
        jae aml_sts_alloc;
        mov rdi, r12;
        mov rsi, r14;
        call aml_obj_byte;
        cmp rax, 0;
        je aml_sts_alloc;                // the first NUL ends it
        add r14, 1;
        jmp aml_sts_loop;
      aml_sts_alloc:
        mov rdi, r14;
        call aml_obj_str_alloc;
        mov r15, rax;
        cmp r15, 0;
        je aml_sts_out;
        cmp r14, 0;
        je aml_sts_out;
        mov rdi, r15;
        xor rsi, rsi;
        mov rdx, r12;
        xor rcx, rcx;
        mov r8, r14;
        call aml_obj_copy;
      aml_sts_out:
        mov rax, r15;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret;
      aml_sts_bad:
        mov rdi, 48;                     // AML_ERR_BAD_OBJTYPE
        call aml_eval_set_err;
        xor rax, rax;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    } @no_frame

  pub let aml_str_sizeof : (u64) -> u64 !{mem} @{} =
    fn (obj: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M2-003 (#1056): SizeOf(rdi) per §19.6.125 -- characters for a String excluding its NUL, bytes for a Buffer, ELEMENTS for a Package. AN INTEGER IS AN ERROR, AML_ERR_BAD_OBJTYPE (48), and that is the spec: 'SizeOf is not defined for an Integer'. It is tempting to answer with the integer width, which is what an implementation that treats SizeOf as sizeof() would do, and the answer would be wrong in a way that only shows up when a table branches on it. A String returns its length WITHOUT the NUL even though the heap allocation includes one, because that is what §19.6.125 counts and what a table then feeds to Mid. Locals: r12=object. Reserved labels: aml_ssz_.",
      block: {
        push r12;
        mov r12, rdi;
        call aml_obj_type;
        cmp rax, 2;
        je aml_ssz_ok;
        cmp rax, 3;
        je aml_ssz_ok;
        cmp rax, 4;
        je aml_ssz_ok;
        mov rdi, 48;                     // AML_ERR_BAD_OBJTYPE
        call aml_eval_set_err;
        xor rax, rax;
        pop r12;
        ret;
      aml_ssz_ok:
        mov rdi, r12;
        call aml_obj_len;
        pop r12;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Match — §19.6.65.
  // ==========================================================================

  pub let aml_str_match_one : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (elem: u64) (opcode: u64) (against: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M2-003 (#1056): does package element rdi satisfy MatchOpcode rsi against object rdx? MTR (0) is unconditionally true and is what a table writes when it wants only one of the two conditions to apply, so it must succeed WITHOUT evaluating the operand -- an implementation that compared anyway would refuse the extremely common Match(PKG, MTR, 0, MEQ, x, 0). The comparison object is converted to the ELEMENT's type, not the other way round: §19.6.65 compares against the package's contents, so a package of Strings matched against an Integer converts the Integer to a String, and doing it backwards would convert every element to an Integer and make every string element compare as zero. An opcode above 5 is AML_ERR_BAD_OBJTYPE (48) rather than a silent false, because it means the two raw MatchOpcode bytes were decoded from the wrong offset. Locals: r12=element, r13=opcode, r14=against, r15=comparison. Reserved labels: aml_smo_.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;
        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        cmp r13, 0;
        je aml_smo_true;                 // MTR
        cmp r13, 5;
        ja aml_smo_bad;
        mov rdi, r12;
        call aml_obj_type;
        mov rdi, r14;
        mov rsi, rax;
        call aml_conv_cast;
        cmp rax, 0;
        je aml_smo_false;
        mov rdi, r12;
        mov rsi, rax;
        call aml_str_cmp;
        mov r15, rax;
        cmp r13, 1;
        je aml_smo_meq;
        cmp r13, 2;
        je aml_smo_mle;
        cmp r13, 3;
        je aml_smo_mlt;
        cmp r13, 4;
        je aml_smo_mge;
        // MGT
        cmp r15, 1;
        je aml_smo_true;
        jmp aml_smo_false;
      aml_smo_meq:
        cmp r15, 0;
        je aml_smo_true;
        jmp aml_smo_false;
      aml_smo_mle:
        cmp r15, 1;
        jne aml_smo_true;
        jmp aml_smo_false;
      aml_smo_mlt:
        cmp r15, 2;
        je aml_smo_true;
        jmp aml_smo_false;
      aml_smo_mge:
        cmp r15, 2;
        jne aml_smo_true;
        jmp aml_smo_false;
      aml_smo_bad:
        mov rdi, 48;                     // AML_ERR_BAD_OBJTYPE
        call aml_eval_set_err;
      aml_smo_false:
        xor rax, rax;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret;
      aml_smo_true:
        mov rax, 1;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    } @no_frame

  pub let aml_str_match : (u64) -> u64 !{mem} @{} =
    fn (expr_node: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M2-003 (#1056): Match per §19.6.65 -- the index of the first Package element at or after StartIndex satisfying BOTH conditions, or Ones. The two MatchOpcodes are RAW BYTES in the encoding, not TermArgs, which is why the R30.M1 term parser put them in the node's arg0/arg1 (shape 2 in aml_optab.pdx) and why they are read from there rather than fetched as operands; reading them as operands would consume the wrong children and compare against the search package itself. AN UNINITIALISED ELEMENT NEVER MATCHES and is skipped without an error, because §20.2.5.4 permits a package with fewer initialisers than declared elements and Match over such a package is legal and common. ONE STEP OF FUEL IS SPENT PER ELEMENT, so a Match over a firmware-declared 0xFFFF-element package terminates on the budget rather than running for as long as the package claims to be -- the outer aml_eval_obj spend bounds the OPERATOR, this bounds the LOOP INSIDE it, and only the second one bounds this operator's actual cost. Locals: r12=node, r13=package, r14=cursor, r15=count; [rsp+0]=op1, [rsp+8]=op2, [rsp+16]=match1, [rsp+24]=match2. Reserved labels: aml_smt_.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 48;
        mov r12, rdi;
        mov rdi, r12;
        xor rsi, rsi;
        call aml_conv_operand;
        mov r13, rax;
        cmp r13, 0;
        je aml_smt_fail;
        mov rdi, r13;
        call aml_obj_type;
        cmp rax, 4;
        jne aml_smt_bad;
        mov rdi, r12;
        call aml_node_arg0;
        mov [rsp + 0], rax;              // MatchOpcode 1
        mov rdi, r12;
        call aml_node_arg1;
        mov [rsp + 8], rax;              // MatchOpcode 2
        mov rdi, r12;
        mov rsi, 1;
        call aml_conv_operand;
        mov [rsp + 16], rax;
        mov rdi, r12;
        mov rsi, 2;
        call aml_conv_operand;
        mov [rsp + 24], rax;
        mov rdi, r12;
        mov rsi, 3;
        call aml_conv_operand;
        cmp rax, 0;
        je aml_smt_fail;
        mov rdi, rax;
        call aml_obj_int_value;
        mov r14, rax;                    // StartIndex
        mov rdi, r13;
        call aml_obj_len;
        mov r15, rax;                    // NumElements
      aml_smt_loop:
        cmp r14, r15;
        jae aml_smt_miss;
        call aml_eval_spend;             // one step per element examined
        cmp rax, 0;
        je aml_smt_fail;
        mov rdi, r13;
        mov rsi, r14;
        call aml_obj_elem_get;
        cmp rax, 0;
        je aml_smt_next;                 // uninitialised: never matches
        mov [rsp + 32], rax;
        mov rdi, rax;
        mov rsi, [rsp + 0];
        mov rdx, [rsp + 16];
        call aml_str_match_one;
        cmp rax, 0;
        je aml_smt_next;
        mov rdi, [rsp + 32];
        mov rsi, [rsp + 8];
        mov rdx, [rsp + 24];
        call aml_str_match_one;
        cmp rax, 0;
        je aml_smt_next;
        mov rdi, r14;
        call aml_obj_int;
        add rsp, 48;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret;
      aml_smt_next:
        add r14, 1;
        jmp aml_smt_loop;
      aml_smt_miss:
        call aml_eval_ones;
        mov rdi, rax;
        call aml_obj_int;
        add rsp, 48;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret;
      aml_smt_bad:
        mov rdi, 48;                     // AML_ERR_BAD_OBJTYPE
        call aml_eval_set_err;
      aml_smt_fail:
        xor rax, rax;
        add rsp, 48;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Dispatch.
  // ==========================================================================

  pub let aml_str_handles : (u64) -> u64 !{} @{} =
    fn (op16: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R30.M2-003 (#1056): the exact set of opcodes this module evaluates, as an executable predicate rather than as a comment -- the same device as aml_arith_handles and for the same reason: the corpus asserts coverage in BOTH directions, so a list that claims ten while the dispatch chain implements nine fails a test instead of surviving as a header comment. Ten opcodes and they are NOT contiguous: 0x73 sits inside #1055's arithmetic run, 0x87 and 0x89 sit between #1057's DerefOf and ObjectType, and 0x96..0x9E interleaves with #1057's CopyObject at 0x9D. So this is a list of ten compares rather than a range test, deliberately, because every range that could be drawn over these would swallow an opcode belonging to another module. Reserved labels: aml_sh_.",
      block: {
        cmp rdi, 0x73;                   // Concatenate
        je aml_sh_yes;
        cmp rdi, 0x84;                   // ConcatenateResTemplate
        je aml_sh_yes;
        cmp rdi, 0x87;                   // SizeOf
        je aml_sh_yes;
        cmp rdi, 0x89;                   // Match
        je aml_sh_yes;
        cmp rdi, 0x96;                   // ToBuffer
        je aml_sh_yes;
        cmp rdi, 0x97;                   // ToDecimalString
        je aml_sh_yes;
        cmp rdi, 0x98;                   // ToHexString
        je aml_sh_yes;
        cmp rdi, 0x99;                   // ToInteger
        je aml_sh_yes;
        cmp rdi, 0x9C;                   // ToString
        je aml_sh_yes;
        cmp rdi, 0x9E;                   // Mid
        je aml_sh_yes;
        xor rax, rax;
        ret;
      aml_sh_yes:
        mov rax, 1;
        ret
      }
    } @no_frame

  pub let aml_str_eval : (u64) -> u64 !{mem} @{} =
    fn (expr_node: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M2-003 (#1056): evaluate an AML_NODE_EXPR whose op16 this module owns and return the resulting OBJECT. Four of the ten operators -- ToBuffer, ToDecimalString, ToHexString, ToInteger -- have NO BODY AT ALL beyond fetching operand 0 and storing it: their conversion is a row in aml_conv_tab, so the operator IS the cast. That is the payoff of making conversion table-driven, and it is why those four cannot drift apart from the implicit conversions Concatenate uses; they are literally the same code. Every operator that takes a Target stores through aml_eval_store_obj, which applies §19.3.5.7's convert-to-the-destination's-existing-type rule -- so `ToHexString(x, BUF)` where BUF holds a Buffer produces a String and then stores it AS A BUFFER, which is correct and is the kind of two-stage conversion that is impossible to get right without separating operand conversion from store conversion. Locals: r12=node, r13=op16, r14=result, r15=scratch. Reserved labels: aml_se_.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 16;
        mov r12, rdi;
        call aml_node_flags;
        mov r13, rax;
        xor r14, r14;

        cmp r13, 0x73;
        je aml_se_concat;
        cmp r13, 0x84;
        je aml_se_concatres;
        cmp r13, 0x87;
        je aml_se_sizeof;
        cmp r13, 0x89;
        je aml_se_match;
        cmp r13, 0x9C;
        je aml_se_tostring;
        cmp r13, 0x9E;
        je aml_se_mid;
        cmp r13, 0x96;
        je aml_se_cast1;
        cmp r13, 0x97;
        je aml_se_cast1;
        cmp r13, 0x98;
        je aml_se_cast1;
        cmp r13, 0x99;
        je aml_se_cast1;
        mov rdi, 35;                     // AML_ERR_NOT_EVALUABLE
        call aml_eval_set_err;
        jmp aml_se_out;

        // ---- the four pure conversions: operand 0, cast by the table ----
      aml_se_cast1:
        mov rdi, r12;
        xor rsi, rsi;
        call aml_conv_operand;
        mov r14, rax;
        mov rsi, 1;
        jmp aml_se_store;

        // ---- Concatenate ----
      aml_se_concat:
        mov rdi, r12;
        xor rsi, rsi;
        call aml_conv_operand;
        mov r15, rax;
        mov rdi, r12;
        mov rsi, 1;
        call aml_conv_operand;
        mov rdi, r15;
        mov rsi, rax;
        call aml_str_concat;
        mov r14, rax;
        mov rsi, 2;
        jmp aml_se_store;

      aml_se_concatres:
        mov rdi, r12;
        xor rsi, rsi;
        call aml_conv_operand;
        mov r15, rax;
        mov rdi, r12;
        mov rsi, 1;
        call aml_conv_operand;
        mov rdi, r15;
        mov rsi, rax;
        call aml_str_concat_res;
        mov r14, rax;
        mov rsi, 2;
        jmp aml_se_store;

        // ---- SizeOf: no Target, returns an Integer ----
      aml_se_sizeof:
        mov rdi, r12;
        xor rsi, rsi;
        call aml_conv_operand;
        mov rdi, rax;
        call aml_ref_deref;
        mov rdi, rax;
        call aml_str_sizeof;
        mov rdi, rax;
        call aml_obj_int;
        mov r14, rax;
        jmp aml_se_out;

        // ---- Match: no Target ----
      aml_se_match:
        mov rdi, r12;
        call aml_str_match;
        mov r14, rax;
        jmp aml_se_out;

        // ---- ToString(Source, Length, Result) ----
      aml_se_tostring:
        mov rdi, r12;
        xor rsi, rsi;
        call aml_conv_operand;
        mov r15, rax;
        mov rdi, r12;
        mov rsi, 1;
        call aml_conv_operand;
        cmp rax, 0;
        je aml_se_out;
        mov rdi, rax;
        call aml_obj_int_value;
        mov rdi, r15;
        mov rsi, rax;
        call aml_str_tostring;
        mov r14, rax;
        mov rsi, 2;
        jmp aml_se_store;

        // ---- Mid(Source, Index, Length, Result) ----
      aml_se_mid:
        mov rdi, r12;
        xor rsi, rsi;
        call aml_conv_operand;
        mov r15, rax;
        mov rdi, r12;
        mov rsi, 1;
        call aml_conv_operand;
        cmp rax, 0;
        je aml_se_out;
        mov rdi, rax;
        call aml_obj_int_value;
        mov [rsp + 0], rax;
        mov rdi, r12;
        mov rsi, 2;
        call aml_conv_operand;
        cmp rax, 0;
        je aml_se_out;
        mov rdi, rax;
        call aml_obj_int_value;
        mov rdx, rax;
        mov rdi, r15;
        mov rsi, [rsp + 0];
        call aml_str_mid;
        mov r14, rax;
        mov rsi, 3;
        jmp aml_se_store;

        // ---- store into the optional Target at child rsi ----
      aml_se_store:
        cmp r14, 0;
        je aml_se_out;
        mov [rsp + 8], rsi;
        mov rdi, r12;
        mov rsi, [rsp + 8];
        call aml_arith_child;
        cmp rax, 0;
        je aml_se_out;                   // no Target encoded
        mov rdi, rax;
        mov rsi, r14;
        call aml_eval_store_obj;

      aml_se_out:
        call aml_eval_err;
        cmp rax, 0;
        je aml_se_ret;
        xor r14, r14;
      aml_se_ret:
        mov rax, r14;
        add rsp, 16;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    } @no_frame

}
