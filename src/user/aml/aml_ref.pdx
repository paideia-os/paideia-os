// src/user/aml/aml_ref.pdx — R30.M2-004 (#1057)
//
// Package, Reference and Index semantics: RefOf, DerefOf, CondRefOf,
// Index, ObjectType, Store and CopyObject.
//
// PLACEMENT — CONSTITUTIONAL
// -------------------------
// Userspace only. See design/acpi/no-aml-in-kernel.md.
//
// NO PRIVATE STORAGE
// ------------------
// None at all. Every object lives in aml_obj.pdx's arena and every frame
// slot in aml_eval.pdx's pool, both reached through their accessor APIs.
// Adding this module to the MODULES list in tools/verify-aml-parser.sh
// therefore costs no new assertion and makes the existing ones strictly
// stronger — they now also prove the reference machinery cannot form an
// address into the object table, the payload heap or the frame pool.
//
// =====================================================================
// Index IS THREE OPERATORS WEARING ONE OPCODE
// =====================================================================
// §19.6.63. `Index(Source, Index, Result)` produces a DIFFERENT KIND OF
// REFERENCE for each of the three legal source types, and the three are
// not interchangeable:
//
//   Index(Buffer,  n)  ->  a BufferField reference to ONE BYTE.
//                          DerefOf yields that byte as an Integer;
//                          a store writes that byte and TRUNCATES.
//   Index(String,  n)  ->  a BufferField reference into the string's
//                          characters. Same byte semantics; a distinct
//                          kind because the object it points into has a
//                          NUL the Buffer does not.
//   Index(Package, n)  ->  a handle on the ELEMENT. DerefOf yields the
//                          element OBJECT, of whatever type it is;
//                          a store REPLACES the element wholesale, with
//                          no conversion and no truncation.
//
// Conflating the package case with either byte case is the bug this file
// is shaped to prevent: `Store(0x1234, Index(PKG,0))` must leave element
// 0 holding the Integer 0x1234, while `Store(0x1234, Index(BUF,0))` must
// leave byte 0 holding 0x34 and the rest discarded. An implementation
// with one "container reference" kind gets one of those two wrong, and
// gets it wrong SILENTLY — the table runs, the value is plausible, and
// the hardware is programmed with the low byte of something.
//
// So aml_obj.pdx gives them three distinct reference sub-kinds, this
// file switches on the sub-kind rather than on the base object's type,
// and the corpus asserts each Index form yields its own kind and each
// DerefOf round-trips.
//
// =====================================================================
// THE STORE BOUNDARY, MOVED
// =====================================================================
// #1055 drew the boundary at "does this destination need a reference
// object to describe it". Everything on the far side was
// AML_ERR_BAD_TARGET (41). This issue moves it. Storable now:
//
//   1. the `Zero` literal        — the null target, discards (unchanged)
//   2. LocalX                    — overwrite, NO conversion (§19.3.5.8)
//   3. ArgX                      — overwrite, EXCEPT that an ArgX holding
//                                  a Reference stores THROUGH it
//                                  (§19.3.5.8, and see below)
//   4. a NAMEREF                 — CONVERT TO THE DESTINATION'S EXISTING
//                                  TYPE (§19.3.5.7), for every type, not
//                                  only for integers
//   5. DebugObj                  — a real sink; discards
//   6. an Index() expression     — evaluated to a reference, stored
//                                  through, per its sub-kind
//   7. a RefOf() expression, or any operand that evaluates to a
//      Reference — stored through
//
// THE NEW BOUNDARY is drawn at objects whose storage is not in this
// process: a FieldUnit (an OperationRegion field element) is
// AML_ERR_BAD_TARGET (41) because writing one means an actual bus
// transaction, and that is R30.M3's OpRegion handler machinery, not
// something to approximate here. Also refused: a Package or Buffer
// OBJECT used directly as a destination without an Index, and a Method
// or Device name, which are declarations rather than value cells.
//
// STORING TO AN ArgX THAT HOLDS A REFERENCE
// -----------------------------------------
// §19.3.5.8's object-storing table says a store to an ArgX whose current
// contents are an ObjectReference is performed to the TARGET of that
// reference, not to the slot. This is how a method mutates its caller's
// object when the caller passed `RefOf(FOO)`, and refusing it would
// refuse a genuine and not-rare firmware idiom. A LocalX does NOT behave
// this way — a store to a Local always overwrites, even when the Local
// holds a reference — and the asymmetry is in the specification, not a
// simplification here. The corpus pins both halves, because an
// implementation that made them agree would be wrong whichever way it
// made them agree.
//
// CondRefOf AND THE ONE PLACE A MISS IS A VALUE
// ----------------------------------------------
// §19.6.19. `CondRefOf(Source, Result)` returns True and fills Result
// when Source exists, and returns FALSE — not an error — when it does
// not. It is the only construct in AML where a namespace miss is data.
// aml_eval_set_quiet suppresses exactly one latch, AML_ERR_NAME_NOT_FOUND
// (36), for the duration of that one resolution, and restores the flag
// afterwards. It does NOT suppress AML_ERR_BAD_PARENT_PREFIX (39) or
// AML_ERR_NAME_TOO_DEEP (38): a malformed path is not a miss, and a
// CondRefOf over `^^^^^^FOO` from the root is a broken table whether or
// not FOO exists.
//
// DerefOf OF A STRING IS REFUSED, DELIBERATELY
// ---------------------------------------------
// §19.6.28 also permits the operand to be a String naming a namespace
// path. Implementing it means building a name-arena entry from heap
// bytes at evaluation time — and the name arena is part of the parse
// tree, which evaluation is forbidden to mutate (see aml_obj.pdx's
// header: the arena is the wire format and must be byte-identical before
// and after a method runs). So it is AML_ERR_BAD_REF (45), a refusal
// with a code, and it waits for the evaluator to own name scratch of its
// own. A wrong dereference is worse than no dereference.
//
// OPCODES OWNED HERE
// ------------------
//   0x70 Store        0x71 RefOf     0x83 DerefOf    0x88 Index
//   0x8E ObjectType   0x9D CopyObject                0x5B12 CondRefOf

module AmlRef = structure {

  // ==========================================================================
  // ObjectType of a DECLARATION — ACPI 6.5 §19.6.101.
  // ==========================================================================

  pub let aml_ref_node_objtype : (u64) -> u64 !{mem} @{} =
    fn (node: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M2-004 (#1057): the ACPI ObjectType code of the declaration at arena node rdi, 0 (Uninitialized) for a node that declares no object. The mapping is written as a table with the spec's numbering because the OBJECT model already uses that numbering (see aml_obj.pdx): a NAME's five data kinds fold onto Integer/String/Buffer/Package, and everything else -- Method 8, Device 6, OperationRegion 10, Mutex 9, Event 7, PowerResource 11, Processor 12, ThermalZone 13, a field element 5 (FieldUnit) -- is a direct row. A SCOPE answers 0 rather than a type of its own, which is correct: `Scope` creates no object, it only opens a namespace level, and reporting a type for it would let a table branch on the existence of a scope as though it held data. An ALIAS also answers 0 rather than following to its source, matching the #1054 rule that reading THROUGH an alias is refused rather than half-done. Locals: r12=node, r13=kind. Reserved labels: aml_rnt_.",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        cmp r12, 0;
        je aml_rnt_zero;
        call aml_node_kind;
        mov r13, rax;
        cmp r13, 5;                      // NAME
        je aml_rnt_name;
        cmp r13, 4;                      // METHOD
        je aml_rnt_method;
        cmp r13, 3;                      // DEVICE
        je aml_rnt_device;
        cmp r13, 10;                     // OPREGION
        je aml_rnt_region;
        cmp r13, 17;                     // MUTEX
        je aml_rnt_mutex;
        cmp r13, 18;                     // EVENT
        je aml_rnt_event;
        cmp r13, 8;                      // POWERRES
        je aml_rnt_power;
        cmp r13, 7;                      // PROCESSOR
        je aml_rnt_proc;
        cmp r13, 9;                      // THERMALZONE
        je aml_rnt_thermal;
        cmp r13, 14;                     // FIELD_ELEM
        je aml_rnt_field;
        jmp aml_rnt_zero;
      aml_rnt_name:
        mov rdi, r12;
        call aml_node_flags;
        cmp rax, 5;                      // var-package folds onto Package
        jne aml_rnt_out;
        mov rax, 4;
        jmp aml_rnt_out;
      aml_rnt_method:
        mov rax, 8;
        jmp aml_rnt_out;
      aml_rnt_device:
        mov rax, 6;
        jmp aml_rnt_out;
      aml_rnt_region:
        mov rax, 10;
        jmp aml_rnt_out;
      aml_rnt_mutex:
        mov rax, 9;
        jmp aml_rnt_out;
      aml_rnt_event:
        mov rax, 7;
        jmp aml_rnt_out;
      aml_rnt_power:
        mov rax, 11;
        jmp aml_rnt_out;
      aml_rnt_proc:
        mov rax, 12;
        jmp aml_rnt_out;
      aml_rnt_thermal:
        mov rax, 13;
        jmp aml_rnt_out;
      aml_rnt_field:
        mov rax, 5;                      // FieldUnit
        jmp aml_rnt_out;
      aml_rnt_zero:
        xor rax, rax;
      aml_rnt_out:
        pop r13;
        pop r12;
        ret
      }
    } @no_frame

  pub let aml_ref_objtype : (u64) -> u64 !{mem} @{} =
    fn (obj: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M2-004 (#1057): the ObjectType code `ObjectType` should report for object rdi. A non-reference answers its own type, which is a field read because the internal tag IS the spec's numbering. A REFERENCE is followed, per §19.6.101 -- ObjectType of a reference is the type of what it refers to, and reporting 20 would leak an internal tag into a table's control flow. The three Index forms answer differently and that is the specification, not an inconsistency: a Buffer or String index answers 14 (BufferField), because that is what the reference denotes, while a Package index answers the type of the ELEMENT, because a package element is an object in its own right. An uninitialised element answers 0 (Uninitialized), which is exactly what §19.6.101 defines 0 for and what a table tests when it walks a sparsely-filled package. Locals: r12=object, r13=sub-kind. Reserved labels: aml_rot_.",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        call aml_obj_type;
        mov rcx, 20;
        cmp rax, rcx;
        jne aml_rot_out;
        mov rdi, r12;
        call aml_obj_refkind;
        mov r13, rax;
        cmp r13, 1;
        je aml_rot_name;
        cmp r13, 4;
        je aml_rot_elem;
        cmp r13, 5;
        je aml_rot_field;
        cmp r13, 6;
        je aml_rot_field;
        // REF_LOCAL / REF_ARG: the type of whatever the slot holds
        mov rdi, r12;
        call aml_ref_deref;
        cmp rax, 0;
        je aml_rot_zero;
        mov rdi, rax;
        call aml_obj_type;
        jmp aml_rot_out;
      aml_rot_name:
        mov rdi, r12;
        call aml_obj_base;
        mov rdi, rax;
        call aml_ref_node_objtype;
        jmp aml_rot_out;
      aml_rot_elem:
        mov rdi, r12;
        call aml_obj_base;
        mov r13, rax;
        mov rdi, r12;
        call aml_obj_len;
        mov rdi, r13;
        mov rsi, rax;
        call aml_obj_elem_get;
        cmp rax, 0;
        je aml_rot_zero;
        mov rdi, rax;
        call aml_obj_type;
        jmp aml_rot_out;
      aml_rot_field:
        mov rax, 14;                     // BufferField
        jmp aml_rot_out;
      aml_rot_zero:
        xor rax, rax;
      aml_rot_out:
        pop r13;
        pop r12;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Dereference.
  // ==========================================================================

  pub let aml_ref_deref : (u64) -> u64 !{mem} @{} =
    fn (obj: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M2-004 (#1057): follow reference rdi to the object it denotes. A NON-REFERENCE PASSES THROUGH UNCHANGED, which is what makes this callable from SizeOf and ObjectType and the arithmetic operand path without each of them testing first -- §19.3.5.6 defines exactly that automatic dereference. The DerefOf OPERATOR does not use the pass-through: it tests for a reference itself and latches AML_ERR_BAD_REF (45) on anything else, because `DerefOf(5)` is a table bug and silently returning 5 would hide it. Six sub-kinds, six behaviours. A frame reference CHECKS THE SERIAL first: frames are eight reused slots, so a reference into a popped frame would otherwise read whichever method occupies that slot now, and that is AML_ERR_STALE_REF (49). A package element that was never initialised is AML_ERR_UNINIT_ELEMENT (50) -- §20.2.5.4 permits the hole to exist, §19.6.28 does not permit reading it. A buffer or string field yields a fresh Integer object holding the byte, which is the value semantics §19.6.63 gives a BufferField of one byte. Locals: r12=object, r13=sub-kind, r14=base, r15=index. Reserved labels: aml_rd_.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;
        mov r12, rdi;
        cmp r12, 0;
        je aml_rd_zero;
        call aml_obj_type;
        mov rcx, 20;
        cmp rax, rcx;
        jne aml_rd_same;
        mov rdi, r12;
        call aml_obj_refkind;
        mov r13, rax;
        mov rdi, r12;
        call aml_obj_base;
        mov r14, rax;
        mov rdi, r12;
        call aml_obj_len;
        mov r15, rax;
        cmp r13, 1;
        je aml_rd_name;
        cmp r13, 2;
        je aml_rd_slot;
        cmp r13, 3;
        je aml_rd_slot;
        cmp r13, 4;
        je aml_rd_elem;
        cmp r13, 5;
        je aml_rd_byte;
        cmp r13, 6;
        je aml_rd_byte;
        jmp aml_rd_bad;

      aml_rd_name:
        mov rdi, r14;
        call aml_eval_decl_obj;
        jmp aml_rd_out;

      aml_rd_slot:
        mov rdi, r14;
        call aml_frame_serial_of;
        mov rdx, rax;
        mov rdi, r12;
        call aml_obj_aux;
        cmp rax, rdx;
        jne aml_rd_stale;
        mov rdi, r14;
        mov rsi, r13;
        mov rdx, r15;
        call aml_frame_ref_get;
        jmp aml_rd_out;

      aml_rd_elem:
        mov rdi, r14;
        mov rsi, r15;
        call aml_obj_elem_get;
        cmp rax, 0;
        je aml_rd_uninit;
        jmp aml_rd_out;

      aml_rd_byte:
        mov rdi, r14;
        mov rsi, r15;
        call aml_obj_byte;
        mov rdi, rax;
        call aml_obj_int;
        jmp aml_rd_out;

      aml_rd_stale:
        mov rdi, 49;                     // AML_ERR_STALE_REF
        call aml_eval_set_err;
        jmp aml_rd_zero;
      aml_rd_uninit:
        mov rdi, 50;                     // AML_ERR_UNINIT_ELEMENT
        call aml_eval_set_err;
        jmp aml_rd_zero;
      aml_rd_bad:
        mov rdi, 45;                     // AML_ERR_BAD_REF
        call aml_eval_set_err;
      aml_rd_zero:
        xor rax, rax;
        jmp aml_rd_out;
      aml_rd_same:
        mov rax, r12;
      aml_rd_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Index — three source types, three reference kinds.
  // ==========================================================================

  pub let aml_ref_index : (u64, u64) -> u64 !{mem} @{} =
    fn (src: u64) (i: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M2-004 (#1057): Index(rdi, rsi) per §19.6.63 -- a reference whose SUB-KIND is chosen by the source's type. Buffer gives REF_BUF_FIELD (5), String gives REF_STR_FIELD (6), Package gives REF_PKG_ELEM (4), and anything else -- an Integer above all, which is the mistake a table makes when it indexes a name it thought was a buffer -- is AML_ERR_BAD_OBJTYPE (48). The bound is checked HERE, at construction, and not only at dereference: a reference that is out of range is not a valid reference, and letting one be built means the error surfaces at whatever unrelated place it is eventually used. Out of range is AML_ERR_OBJ_RANGE (46). For a String the bound is the character count, so Index(STR, len) -- the NUL -- is out of range; the NUL is part of the encoding, not an addressable character. Locals: r12=source, r13=index, r14=type. Reserved labels: aml_ri_.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;
        mov r12, rdi;
        mov r13, rsi;
        cmp r12, 0;
        je aml_ri_bad;
        call aml_obj_type;
        mov r14, rax;
        cmp r14, 2;
        je aml_ri_ok;
        cmp r14, 3;
        je aml_ri_ok;
        cmp r14, 4;
        je aml_ri_ok;
        jmp aml_ri_bad;
      aml_ri_ok:
        mov rdi, r12;
        call aml_obj_len;
        cmp r13, rax;
        jae aml_ri_range;
        cmp r14, 3;
        je aml_ri_buf;
        cmp r14, 2;
        je aml_ri_str;
        mov rdi, 4;                      // REF_PKG_ELEM
        jmp aml_ri_make;
      aml_ri_buf:
        mov rdi, 5;                      // REF_BUF_FIELD
        jmp aml_ri_make;
      aml_ri_str:
        mov rdi, 6;                      // REF_STR_FIELD
      aml_ri_make:
        mov rsi, r12;
        mov rdx, r13;
        xor rcx, rcx;                    // no serial: object references do
        call aml_obj_ref;                //   not age the way frames do
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret;
      aml_ri_bad:
        mov rdi, 48;                     // AML_ERR_BAD_OBJTYPE
        call aml_eval_set_err;
        jmp aml_ri_zero;
      aml_ri_range:
        mov rdi, 46;                     // AML_ERR_OBJ_RANGE
        call aml_eval_set_err;
      aml_ri_zero:
        xor rax, rax;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Building a reference from a target-shaped node — RefOf / CondRefOf.
  // ==========================================================================

  pub let aml_ref_of_node : (u64, u64) -> u64 !{mem} @{} =
    fn (node: u64) (quiet: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M2-004 (#1057): build a reference denoting the storage arena node rdi names. rsi asks for a QUIET namespace miss, which only CondRefOf passes -- see the file header for why exactly one latch is suppressed and no other. Four node shapes are referenceable. A NAMEREF resolves to a declaration and becomes REF_NAME, which is a reference to the DECLARATION and not to its current value, so a later store through it is visible to every other reader of that name. A LocalX or ArgX becomes REF_LOCAL/REF_ARG stamped with the CURRENT FRAME's serial, so the reference is invalidated by the frame being popped rather than silently re-aimed. An Index() expression is EVALUATED, because Index already produces a reference and RefOf(Index(...)) is the same reference -- building a reference to a reference would need a dereference chain nothing in ACPI defines. Everything else is AML_ERR_BAD_REF (45): RefOf of a literal, of an arithmetic expression or of Debug names no storage. Locals: r12=node, r13=quiet, r14=kind, r15=scratch. Reserved labels: aml_ron_.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 16;
        mov r12, rdi;
        mov r13, rsi;
        cmp r12, 0;
        je aml_ron_bad;
        call aml_node_kind;
        mov r14, rax;
        cmp r14, 38;                     // NAMEREF
        je aml_ron_name;
        cmp r14, 40;                     // LOCALX
        je aml_ron_local;
        cmp r14, 39;                     // ARGX
        je aml_ron_arg;
        cmp r14, 24;                     // EXPR
        je aml_ron_expr;
        jmp aml_ron_bad;

      aml_ron_name:
        mov rdi, r13;
        call aml_eval_set_quiet;
        mov [rsp + 0], rax;              // the previous flag
        call aml_eval_scope;
        mov [rsp + 8], rax;
        mov rdi, r12;
        call aml_node_name;
        mov rsi, rax;
        mov rdi, [rsp + 8];
        call aml_eval_resolve;
        mov r14, rax;
        mov rdi, [rsp + 0];
        call aml_eval_set_quiet;         // restore, always
        cmp r14, 0;
        je aml_ron_zero;                 // a miss: the caller decides
        mov rdi, 1;                      // REF_NAME
        mov rsi, r14;
        xor rdx, rdx;
        xor rcx, rcx;
        call aml_obj_ref;
        jmp aml_ron_out;

      aml_ron_local:
        mov rdi, 2;                      // REF_LOCAL
        jmp aml_ron_slot;
      aml_ron_arg:
        mov rdi, 3;                      // REF_ARG
      aml_ron_slot:
        mov r14, rdi;
        call aml_eval_frames;
        cmp rax, 0;
        je aml_ron_noframe;
        mov r15, rax;                    // the frame index
        mov rdi, r12;
        call aml_node_flags;
        mov [rsp + 0], rax;              // the slot
        mov rdi, r15;
        call aml_frame_serial_of;
        mov rcx, rax;
        mov rdx, [rsp + 0];
        mov rdi, r14;
        mov rsi, r15;
        call aml_obj_ref;
        jmp aml_ron_out;

      aml_ron_expr:
        mov rdi, r12;
        call aml_node_flags;
        cmp rax, 0x88;                   // IndexOp
        jne aml_ron_bad;
        mov rdi, r12;
        call aml_eval_obj;
        jmp aml_ron_out;

      aml_ron_noframe:
        mov rdi, 40;                     // AML_ERR_NO_FRAME
        call aml_eval_set_err;
        jmp aml_ron_zero;
      aml_ron_bad:
        mov rdi, 45;                     // AML_ERR_BAD_REF
        call aml_eval_set_err;
      aml_ron_zero:
        xor rax, rax;
      aml_ron_out:
        add rsp, 16;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Storing through a reference.
  // ==========================================================================

  pub let aml_ref_store_through : (u64, u64) -> u64 !{mem} @{} =
    fn (refobj: u64) (src: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M2-004 (#1057): store object rsi through reference rdi. Returns 1 on success, 0 having latched. Each sub-kind stores DIFFERENTLY and the differences are the specification. REF_NAME goes through aml_eval_store_named, so §19.3.5.7's convert-to-the-destination's-existing-type rule applies -- storing an Integer through a reference to a Name holding a Buffer produces a Buffer. REF_LOCAL and REF_ARG overwrite the slot with NO conversion (§19.3.5.8), after the serial check that keeps a popped frame's reference from writing into whoever holds that slot now. REF_PKG_ELEM REPLACES the element, also with no conversion, because a package element has no fixed type to convert to. REF_BUF_FIELD and REF_STR_FIELD convert the source to an Integer and write its LOW BYTE, discarding the rest: a one-byte field truncates, and that truncation is §19.3.5.7's rule for a BufferField, not an approximation. Locals: r12=reference, r13=source, r14=sub-kind, r15=base; [rsp+0]=index. Reserved labels: aml_rst_.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 16;
        mov r12, rdi;
        mov r13, rsi;
        cmp r12, 0;
        je aml_rst_bad;
        cmp r13, 0;
        je aml_rst_bad;
        call aml_obj_type;
        mov rcx, 20;
        cmp rax, rcx;
        jne aml_rst_bad;
        mov rdi, r12;
        call aml_obj_refkind;
        mov r14, rax;
        mov rdi, r12;
        call aml_obj_base;
        mov r15, rax;
        mov rdi, r12;
        call aml_obj_len;
        mov [rsp + 0], rax;
        cmp r14, 1;
        je aml_rst_name;
        cmp r14, 2;
        je aml_rst_slot;
        cmp r14, 3;
        je aml_rst_slot;
        cmp r14, 4;
        je aml_rst_elem;
        cmp r14, 5;
        je aml_rst_byte;
        cmp r14, 6;
        je aml_rst_byte;
        jmp aml_rst_bad;

      aml_rst_name:
        mov rdi, r15;
        mov rsi, r13;
        call aml_eval_store_named;
        jmp aml_rst_out;

      aml_rst_slot:
        mov rdi, r15;
        call aml_frame_serial_of;
        mov rdx, rax;
        mov rdi, r12;
        call aml_obj_aux;
        cmp rax, rdx;
        jne aml_rst_stale;
        mov rdi, r15;
        mov rsi, r14;
        mov rdx, [rsp + 0];
        mov rcx, r13;
        call aml_frame_ref_set;
        jmp aml_rst_out;

      aml_rst_elem:
        mov rdi, r15;
        mov rsi, [rsp + 0];
        mov rdx, r13;
        call aml_obj_elem_set;
        jmp aml_rst_out;

      aml_rst_byte:
        mov rdi, r13;
        mov rsi, 1;                      // convert to Integer, then truncate
        call aml_conv_cast;
        cmp rax, 0;
        je aml_rst_no;
        mov rdi, rax;
        call aml_obj_int_value;
        mov rcx, 255;
        and rax, rcx;
        mov rdx, rax;
        mov rdi, r15;
        mov rsi, [rsp + 0];
        call aml_obj_set_byte;
        jmp aml_rst_out;

      aml_rst_stale:
        mov rdi, 49;                     // AML_ERR_STALE_REF
        call aml_eval_set_err;
        jmp aml_rst_no;
      aml_rst_bad:
        mov rdi, 45;                     // AML_ERR_BAD_REF
        call aml_eval_set_err;
      aml_rst_no:
        xor rax, rax;
      aml_rst_out:
        add rsp, 16;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Dispatch.
  // ==========================================================================

  pub let aml_ref_handles : (u64) -> u64 !{} @{} =
    fn (op16: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R30.M2-004 (#1057): the exact set of opcodes this module evaluates, as an executable predicate -- the same device as aml_arith_handles and aml_str_handles, and asserted by the corpus in both directions so the claim cannot rot into a stale comment. Seven opcodes, scattered across the space by the encoding rather than grouped: Store at 0x70 sits below the arithmetic run, RefOf at 0x71 inside it, DerefOf at 0x83 between Mod and ConcatRes, Index at 0x88 and ObjectType at 0x8E among the string operators, CopyObject at 0x9D between ToString and Mid, and CondRefOf alone in the 0x5B escape space. There is no range that captures them and no range is attempted. Reserved labels: aml_rh_.",
      block: {
        cmp rdi, 0x70;                   // Store
        je aml_rh_yes;
        cmp rdi, 0x71;                   // RefOf
        je aml_rh_yes;
        cmp rdi, 0x83;                   // DerefOf
        je aml_rh_yes;
        cmp rdi, 0x88;                   // Index
        je aml_rh_yes;
        cmp rdi, 0x8E;                   // ObjectType
        je aml_rh_yes;
        cmp rdi, 0x9D;                   // CopyObject
        je aml_rh_yes;
        mov rcx, 0x5B12;                 // CondRefOf
        cmp rdi, rcx;
        je aml_rh_yes;
        xor rax, rax;
        ret;
      aml_rh_yes:
        mov rax, 1;
        ret
      }
    } @no_frame

  pub let aml_ref_eval : (u64) -> u64 !{mem} @{} =
    fn (expr_node: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M2-004 (#1057): evaluate an AML_NODE_EXPR whose op16 this module owns and return the resulting OBJECT. Store and CopyObject both return the SOURCE object, which is what §19.6.126/§19.6.20 specify and what makes `Store(Store(x, A), B)` -- which real tables write -- assign x to both. They differ only in the store rule, and they are two call sites rather than one with a flag so neither can be reached by the other's path. ObjectType resolves a NAMEREF operand rather than evaluating it, and then splits: a NAME answers its CURRENT type through aml_eval_decl_obj -- so a Name declared as a Buffer that CopyObject has retyped to Integer answers 1, not 3, which is the whole point of asking -- while every other declaration answers from the NODE, because `ObjectType(DEV0)` on a Device has no object to materialise and evaluating it first would report AML_ERR_NOT_EVALUABLE for a question with a perfectly good answer. CondRefOf returns Ones or Zero and stores only on the Ones path, so a Result target is left untouched on a miss, which is what a table testing for an optional object depends on. Locals: r12=node, r13=op16, r14=result, r15=scratch; [rsp+0]=source object. Reserved labels: aml_re_.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 16;
        mov r12, rdi;
        call aml_node_flags;
        mov r13, rax;
        xor r14, r14;

        cmp r13, 0x70;
        je aml_re_store;
        cmp r13, 0x9D;
        je aml_re_copy;
        cmp r13, 0x71;
        je aml_re_refof;
        cmp r13, 0x83;
        je aml_re_deref;
        cmp r13, 0x88;
        je aml_re_index;
        cmp r13, 0x8E;
        je aml_re_objtype;
        mov rcx, 0x5B12;
        cmp r13, rcx;
        je aml_re_condref;
        mov rdi, 35;                     // AML_ERR_NOT_EVALUABLE
        call aml_eval_set_err;
        jmp aml_re_out;

        // ---- Store(Source, Target) — §19.3.5.7 conversion ----
      aml_re_store:
        mov rdi, r12;
        xor rsi, rsi;
        call aml_conv_operand;
        mov r14, rax;
        cmp r14, 0;
        je aml_re_out;
        mov rdi, r12;
        mov rsi, 1;
        call aml_arith_child;
        cmp rax, 0;
        je aml_re_out;
        mov rdi, rax;
        mov rsi, r14;
        call aml_eval_store_obj;
        jmp aml_re_out;

        // ---- CopyObject(Source, Target) — §19.6.20, no conversion ----
      aml_re_copy:
        mov rdi, r12;
        xor rsi, rsi;
        call aml_conv_operand;
        mov r14, rax;
        cmp r14, 0;
        je aml_re_out;
        mov rdi, r12;
        mov rsi, 1;
        call aml_arith_child;
        cmp rax, 0;
        je aml_re_out;
        mov rdi, rax;
        mov rsi, r14;
        call aml_eval_copy_obj;
        jmp aml_re_out;

        // ---- RefOf(Source) ----
      aml_re_refof:
        mov rdi, r12;
        xor rsi, rsi;
        call aml_arith_child;
        mov rdi, rax;
        xor rsi, rsi;                    // not quiet: a miss is an error here
        call aml_ref_of_node;
        mov r14, rax;
        cmp r14, 0;
        jne aml_re_out;
        mov rdi, 36;                     // AML_ERR_NAME_NOT_FOUND
        call aml_eval_set_err;
        jmp aml_re_out;

        // ---- CondRefOf(Source, Result) — a miss is False, not an error ----
      aml_re_condref:
        mov rdi, r12;
        xor rsi, rsi;
        call aml_arith_child;
        mov rdi, rax;
        mov rsi, 1;                      // quiet
        call aml_ref_of_node;
        mov r15, rax;
        call aml_eval_err;
        cmp rax, 0;
        jne aml_re_out;                  // a malformed path still fails
        cmp r15, 0;
        je aml_re_condfalse;
        mov rdi, r12;
        mov rsi, 1;
        call aml_arith_child;
        cmp rax, 0;
        je aml_re_condtrue;
        mov rdi, rax;
        mov rsi, r15;
        call aml_eval_store_obj;
      aml_re_condtrue:
        call aml_eval_ones;
        mov rdi, rax;
        call aml_obj_int;
        mov r14, rax;
        jmp aml_re_out;
      aml_re_condfalse:
        xor rdi, rdi;
        call aml_obj_int;
        mov r14, rax;
        jmp aml_re_out;

        // ---- DerefOf(Source) ----
      aml_re_deref:
        mov rdi, r12;
        xor rsi, rsi;
        call aml_conv_operand;
        mov r15, rax;
        cmp r15, 0;
        je aml_re_out;
        mov rdi, r15;
        call aml_obj_type;
        mov rcx, 20;
        cmp rax, rcx;
        jne aml_re_notref;
        mov rdi, r15;
        call aml_ref_deref;
        mov r14, rax;
        jmp aml_re_out;
      aml_re_notref:
        mov rdi, 45;                     // AML_ERR_BAD_REF
        call aml_eval_set_err;
        jmp aml_re_out;

        // ---- Index(Source, Index, Result) ----
      aml_re_index:
        mov rdi, r12;
        xor rsi, rsi;
        call aml_conv_operand;
        mov rdi, rax;
        call aml_ref_deref;              // §19.3.5.6 automatic dereference
        mov r15, rax;
        mov rdi, r12;
        mov rsi, 1;
        call aml_conv_operand;
        cmp rax, 0;
        je aml_re_out;
        mov rdi, rax;
        call aml_obj_int_value;
        mov rdi, r15;
        mov rsi, rax;
        call aml_ref_index;
        mov r14, rax;
        cmp r14, 0;
        je aml_re_out;
        mov rdi, r12;
        mov rsi, 2;
        call aml_arith_child;
        cmp rax, 0;
        je aml_re_out;
        mov rdi, rax;
        mov rsi, r14;
        call aml_eval_store_obj;
        jmp aml_re_out;

        // ---- ObjectType(Source) ----
      aml_re_objtype:
        mov rdi, r12;
        xor rsi, rsi;
        call aml_arith_child;
        mov r15, rax;
        cmp r15, 0;
        je aml_re_out;
        mov rdi, r15;
        call aml_node_kind;
        cmp rax, 38;                     // NAMEREF: answer from the node
        jne aml_re_otval;
        call aml_eval_scope;
        mov rdi, rax;
        mov r14, rdi;
        mov rdi, r15;
        call aml_node_name;
        mov rsi, rax;
        mov rdi, r14;
        call aml_eval_resolve;
        cmp rax, 0;
        je aml_re_otfail;
        mov r15, rax;
        mov rdi, r15;
        call aml_node_kind;
        cmp rax, 5;                      // a NAME answers its CURRENT type
        jne aml_re_otdecl;
        mov rdi, r15;
        call aml_eval_decl_obj;
        cmp rax, 0;
        je aml_re_otfail;
        mov rdi, rax;
        call aml_obj_type;
        jmp aml_re_otmake;
      aml_re_otdecl:
        mov rdi, r15;
        call aml_ref_node_objtype;
        jmp aml_re_otmake;
      aml_re_otval:
        mov rdi, r15;
        call aml_eval_obj;
        cmp rax, 0;
        je aml_re_otfail;
        mov rdi, rax;
        call aml_ref_objtype;
      aml_re_otmake:
        mov rdi, rax;
        call aml_obj_int;
        mov r14, rax;
        jmp aml_re_out;
      aml_re_otfail:
        xor r14, r14;

      aml_re_out:
        call aml_eval_err;
        cmp rax, 0;
        je aml_re_ret;
        xor r14, r14;
      aml_re_ret:
        mov rax, r14;
        add rsp, 16;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    } @no_frame

}
