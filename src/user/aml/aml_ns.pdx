// src/user/aml/aml_ns.pdx — R30.M1-002 (#1050)
//
// AML namespace-object parser: Scope, Device, Method, Field and their
// relatives, per ACPI 6.5 §20.2.5.1 (NameSpaceModifierObj) and §20.2.5.2
// (NamedObj).
//
// PLACEMENT — CONSTITUTIONAL
// -------------------------
// Userspace only. See design/acpi/no-aml-in-kernel.md.
//
// WHAT THIS MILESTONE PARSES, AND WHAT IT REFUSES
// -----------------------------------------------
// This is a NAMESPACE parser, not a term parser. It walks the top-level
// TermList of a table and descends only into constructs that DEFINE
// NAMES. Everything else is either skipped by its self-describing
// PkgLength or refused outright. Nothing is executed — evaluation is
// R30.M2 (#1054+).
//
//   Descended into   Scope, Device, ThermalZone, Processor, PowerResource
//   Recorded whole   Method (name + flags + body extent; the body is a
//                    TermList full of control flow, which is #1051)
//   Recorded whole   Field, IndexField, BankField (+ their FieldLists —
//                    the element grammar IS namespace structure)
//   Recorded         OpRegion, Name, Alias, External, Mutex, Event
//   Skipped opaquely Buffer, Package, VarPackage, If, Else, While —
//                    every one carries a PkgLength, so the extent is
//                    known and bounds-checked before the skip
//   Refused          any other real opcode -> AML_ERR_UNEXPECTED_OP (10)
//   Refused          a bare NameString in term position, i.e. a method
//                    invocation -> AML_ERR_METHOD_INVOCATION (18)
//   Refused          a byte that is not an AML opcode at all
//                    -> AML_ERR_UNKNOWN_OPCODE (5)
//
// The distinction between those last three codes is the point. "This
// table is corrupt", "this construct is not implemented yet" and "this
// is a method call, which needs #1051" demand different responses from
// an operator staring at a machine that will not boot, so they are not
// collapsed into one error.
//
// WHY OPAQUE SKIPPING IS SOUND AND GUESSING IS NOT
// ------------------------------------------------
// An unparsed construct that carries a PkgLength can be stepped over
// exactly, because aml_lex_pkglength has already proven the package fits
// inside the buffer. An unparsed construct WITHOUT a PkgLength has no
// knowable extent short of decoding its operands; skipping a guessed
// number of bytes would resynchronise the parser mid-instruction and
// produce a namespace that looks plausible and is wrong. A wrong
// namespace is worse than no namespace — it silently mis-drives
// hardware. So those are refused.
//
// METHOD BODIES ARE DELIBERATELY NOT DESCENDED
// --------------------------------------------
// A Method's package body is an arbitrary TermList: If/Else/While,
// expressions, method invocations. Parsing it needs #1051 and #1052. At
// this milestone the Method node records its name, its flags byte
// (argument count, serialized bit, sync level) and the byte extent of
// its body, and the cursor is seeked past it. When #1051 lands, the
// change is to descend into [arg0, arg1) — the node already carries the
// extent, so no re-parse and no representation change is needed.
//
// RECURSION
// ---------
// aml_parse_termlist and aml_parse_term are mutually recursive over
// attacker-controlled nesting depth. The budget is claimed and released
// through aml_lex_depth_enter / aml_lex_depth_leave, checked before the
// increment so the counter stays balanced on every failure path. The
// harness asserts depth == 0 after every fixture, accepted and rejected
// alike.
//
// TERMINATION
// -----------
// Two guards make the term loop unable to spin. Every iteration must
// advance the cursor (AML_ERR_NO_PROGRESS, 14) and must not advance past
// its enclosing package end (AML_ERR_PKG_OVERRUN, 11). Together with the
// PkgLength TOO_SMALL check in the lexer — which rejects a package
// shorter than its own length field, the classic zero-progress encoding
// — that closes the livelock surface.

module AmlNs = structure {

  // ==========================================================================
  // aml_ns_is_namelead(b) -> 1 when b can begin a NameString.
  //
  // In term position such a byte is a MethodInvocation, which needs the
  // method's declared argument count to know how many TermArgs follow —
  // that is #1051. Detecting it BEFORE the opcode table is consulted is
  // what keeps AML_ERR_UNKNOWN_OPCODE meaning "corrupt", since none of
  // these bytes is an opcode.
  // ==========================================================================
  pub let aml_ns_is_namelead : (u64) -> u64 !{} @{} =
    fn (b: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R30.M1-002 (#1050): true for any byte that can begin a §20.2.2 NameString: DualNamePrefix 0x2E, MultiNamePrefix 0x2F, RootChar 0x5C, ParentPrefixChar 0x5E, or a LeadNameChar ('A'..'Z', '_'). None of these values is an AML opcode, so the test is unambiguous and can safely run before the opcode table is consulted. Note 0x5B (ExtOpPrefix) sits between RootChar and ParentPrefixChar numerically but is deliberately absent — it IS an opcode. Tail-calls aml_lex_leadnamechar_ok for the letter/underscore range. Pure. Reserved labels: aml_ns_inl_.",
      block: {
        cmp rdi, 0x2E;
        je aml_ns_inl_yes;
        cmp rdi, 0x2F;
        je aml_ns_inl_yes;
        cmp rdi, 0x5C;
        je aml_ns_inl_yes;
        cmp rdi, 0x5E;
        je aml_ns_inl_yes;
        call aml_lex_leadnamechar_ok;
        ret;
      aml_ns_inl_yes:
        mov rax, 1;
        ret
      }
    } @no_frame

  // ==========================================================================
  // aml_ns_pkg_open() -> absolute package end offset, 0 on error.
  // ==========================================================================
  pub let aml_ns_pkg_open : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-002 (#1050): read a §20.2.4 PkgLength and convert it to an ABSOLUTE end offset. Samples the cursor before the decode because the decoded length includes the PkgLength bytes themselves, so the extent is measured from the lead byte. Every call site wants the end offset rather than the length — bounds are compared, lengths are not — so doing the addition once here removes an arithmetic step from a dozen call sites. Returns 0 on failure; 0 is unambiguous because aml_lex_pkglength has already rejected any package shorter than its own length field, so a successful decode always yields an end offset of at least 1. Reserved labels: aml_ns_po_.",
      block: {
        push r12;
        call aml_lex_pos;
        mov r12, rax;                    // pkg_start
        call aml_lex_pkglength;
        cmp rax, 0;
        je aml_ns_po_fail;
        add rax, r12;
        pop r12;
        ret;
      aml_ns_po_fail:
        xor rax, rax;
        pop r12;
        ret
      }
    } @no_frame

  // ==========================================================================
  // aml_ns_open_pkg_named(kind, parent, src_off) -> node index, 0 on error.
  //
  // The shared prologue of every "PkgLength NameString ..." construct:
  // Scope, Device, ThermalZone, Processor, PowerResource, Method, Field,
  // IndexField, BankField. Factoring it out is not just brevity — it means
  // there is exactly ONE place where a package extent can be mis-computed.
  //
  // The freshly-allocated node carries arg1 = package end and arg0 = 0.
  // The caller consumes whatever fixed operands its construct has, then
  // reads arg1 back and rewrites both slots. Returning the extent through
  // the node rather than through a second output parameter keeps the
  // helper to a single return value and puts the extent where it has to
  // end up anyway.
  // ==========================================================================
  pub let aml_ns_open_pkg_named : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (kind: u64) (parent: u64) (src_off: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-002 (#1050): shared prologue for the nine PkgLength-then-NameString constructs. rdi=node kind, rsi=parent index, rdx=opcode source offset. Reads the package extent, reads the name into the name arena, allocates the node, and parks the package end in arg1 so the caller can retrieve it after consuming its own fixed operands — one return value, no output parameter, and the extent lands in its final home immediately. Note the name is read BEFORE the node is allocated, so a malformed name aborts without leaving a half-initialised node spliced into the parent's child list. Locals: r12=kind then node index, r13=parent, r14=src_off, r15=package end. Reserved labels: aml_ns_opn_.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;
        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        call aml_ns_pkg_open;
        mov r15, rax;
        call aml_lex_err;
        cmp rax, 0;
        jne aml_ns_opn_fail;
        call aml_lex_namestring;
        push rax;
        call aml_lex_err;
        cmp rax, 0;
        pop rcx;
        jne aml_ns_opn_fail;
        mov rdi, r12;
        mov rsi, rcx;
        mov rdx, r13;
        mov rcx, r14;
        call aml_node_alloc;
        cmp rax, 0;
        je aml_ns_opn_fail;
        mov r12, rax;
        mov rdi, r12;
        xor rsi, rsi;
        mov rdx, r15;
        call aml_node_set_args;
        mov rax, r12;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret;
      aml_ns_opn_fail:
        xor rax, rax;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    } @no_frame

  // ==========================================================================
  // aml_ns_dataobj(node) -> err — the DataRefObject following a NameOp.
  //
  // Name is the one namespace-defining construct whose payload is a data
  // object, and _HID / _CID / _UID / _ADR are exactly the names a driver
  // stack needs, so it cannot be deferred wholesale to #1052. What IS
  // deferred is any payload that is not a literal: integer literals,
  // strings and the three PkgLength-bearing aggregates are handled; a
  // computed initialiser is refused with AML_ERR_UNEXPECTED_OP.
  // ==========================================================================
  pub let aml_ns_dataobj : (u64) -> u64 !{mem} @{} =
    fn (node: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-002 (#1050): parse the DataRefObject after a NameOp NameString and record it on node rdi. Four shapes are accepted. (1) Integer literals (Zero/One/Ones/Byte/Word/DWord/QWord) -> flags=1, arg0 = index into the u64 side table, because the value is genuinely 64-bit and will not fit an argument slot. (2) StringPrefix 0x0D -> flags=2, arg0/arg1 = the byte extent including the terminating NUL; the scan is bounded by aml_lex_u8's own EOF check, so an unterminated string in a truncated table reports EOF rather than running off the buffer. (3) Buffer 0x11 / Package 0x12 / VarPackage 0x13 -> flags=3/4/5, arg0/arg1 = the package extent, cursor seeked past it; their contents are #1052. (4) Anything else is refused with AML_ERR_UNEXPECTED_OP (10) rather than guessed at. Note the flags are written BEFORE the aggregate's extent is computed, while the data-kind constant is still live in r14, which avoids a fifth stack slot. Locals: r12=node, r13/r14=scratch. Reserved labels: aml_ns_do_.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        call aml_lex_peek_u8;
        mov r13, rax;
        call aml_lex_err;
        cmp rax, 0;
        jne aml_ns_do_out;
        cmp r13, 0x0D;
        je aml_ns_do_str;
        cmp r13, 0x11;
        je aml_ns_do_buf;
        cmp r13, 0x12;
        je aml_ns_do_pkg;
        cmp r13, 0x13;
        je aml_ns_do_vpkg;
        cmp r13, 0x00;
        je aml_ns_do_int;
        cmp r13, 0x01;
        je aml_ns_do_int;
        cmp r13, 0xFF;
        je aml_ns_do_int;
        cmp r13, 0x0A;
        je aml_ns_do_int;
        cmp r13, 0x0B;
        je aml_ns_do_int;
        cmp r13, 0x0C;
        je aml_ns_do_int;
        cmp r13, 0x0E;
        je aml_ns_do_int;
        mov rdi, 10;                     // AML_ERR_UNEXPECTED_OP (#1052)
        call aml_lex_set_err;
        jmp aml_ns_do_out;
      aml_ns_do_int:
        call aml_lex_integer;
        mov r13, rax;
        call aml_lex_err;
        cmp rax, 0;
        jne aml_ns_do_out;
        mov rdi, r13;
        call aml_u64_alloc;
        mov r13, rax;
        cmp r13, 0;
        je aml_ns_do_out;
        mov rdi, r12;
        mov rsi, 1;                      // data kind 1 = integer
        call aml_node_set_flags;
        mov rdi, r12;
        mov rsi, r13;
        xor rdx, rdx;
        call aml_node_set_args;
        jmp aml_ns_do_out;
      aml_ns_do_str:
        mov rdi, r12;
        mov rsi, 2;                      // data kind 2 = string
        call aml_node_set_flags;
        call aml_lex_u8;                 // consume StringPrefix
        call aml_lex_pos;
        mov r13, rax;                    // first character
      aml_ns_do_scan:
        call aml_lex_u8;
        mov r14, rax;
        call aml_lex_err;
        cmp rax, 0;
        jne aml_ns_do_out;               // unterminated -> EOF, never over-read
        cmp r14, 0;
        jne aml_ns_do_scan;
        call aml_lex_pos;
        mov r14, rax;                    // one past the NUL
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, r14;
        call aml_node_set_args;
        jmp aml_ns_do_out;
      aml_ns_do_buf:
        mov r14, 3;
        jmp aml_ns_do_agg;
      aml_ns_do_pkg:
        mov r14, 4;
        jmp aml_ns_do_agg;
      aml_ns_do_vpkg:
        mov r14, 5;
      aml_ns_do_agg:
        mov rdi, r12;
        mov rsi, r14;                    // data kind 3/4/5
        call aml_node_set_flags;
        call aml_lex_u8;                 // consume the aggregate opcode
        call aml_lex_pos;
        mov r13, rax;                    // PkgLength lead byte
        call aml_lex_pkglength;
        mov r14, rax;
        call aml_lex_err;
        cmp rax, 0;
        jne aml_ns_do_out;
        add r14, r13;                    // package end
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, r14;
        call aml_node_set_args;
        mov rdi, r14;
        call aml_lex_seek;
      aml_ns_do_out:
        pop r14;
        pop r13;
        pop r12;
        call aml_lex_err;
        ret
      }
    } @no_frame

  // ==========================================================================
  // aml_ns_fieldlist(parent, end_off, field_flags) -> err
  //
  // ACPI 6.5 §20.2.5.2 FieldList:
  //
  //   ReservedField        := 0x00 PkgLength                (bit width)
  //   AccessField          := 0x01 AccessType AccessAttrib
  //   ConnectField         := 0x02 (NameString | BufferData)
  //   ExtendedAccessField  := 0x03 AccessType ExtendedAccessAttrib
  //                                AccessLength
  //   NamedField           := NameSeg PkgLength             (bit width)
  //
  // The PkgLength in ReservedField and NamedField is a BIT COUNT, not a
  // byte extent — it names no region of the buffer at all. Running it
  // through the package-semantics decoder would reject legal firmware the
  // moment a field's declared width exceeded the bytes remaining, so those
  // two sites use aml_lex_pkglength_value instead. Getting this wrong is
  // the single most common way an AML parser fails on real tables.
  //
  // Every element is emitted as a child node in source order, including
  // the ones that carry no name. An access-rule change is positional — it
  // governs the elements that follow it — so discarding it and keeping
  // only its effect on the named fields would lose the ability to
  // round-trip or re-emit the list.
  // ==========================================================================
  pub let aml_ns_fieldlist : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (parent: u64) (end_off: u64) (field_flags: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-002 (#1050): parse a §20.2.5.2 FieldList into child nodes of rdi, stopping at rsi, with rdx the enclosing FieldFlags byte. Maintains two pieces of running state that the element grammar makes positional: r14 is the bit offset accumulated across all preceding elements (named and reserved alike), and r15 is the currently effective access byte, whose low nibble an AccessField replaces while the LockRule and UpdateRule bits inherited from the FieldFlags byte persist. Each named element captures BOTH at the moment it is declared, so a consumer never has to replay the list to learn a field's width or access rule. The loop is bounded three ways: the sticky error flag, an exact-equality end test that treats an element straddling the package end as AML_ERR_PKG_OVERRUN (11) rather than reading beyond it, and an AML_ERR_FIELD_OFFSET_OVF (17) guard on the running bit offset, which is stored in a 32-bit node slot and must not silently truncate. Frame: 48 bytes of locals at [rsp+0..40] — element source offset, then five scratch slots, which ExtendedAccessField needs all of because it carries three operands plus a node index. Reserved labels: aml_ns_fl_.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 48;
        mov r12, rdi;                    // parent node
        mov r13, rsi;                    // end offset
        xor r14, r14;                    // running bit offset
        mov r15, rdx;
        and r15, 0xFF;                   // effective access byte
      aml_ns_fl_loop:
        call aml_lex_err;
        cmp rax, 0;
        jne aml_ns_fl_out;
        call aml_lex_pos;
        mov [rsp + 0], rax;              // element source offset
        cmp rax, r13;
        je aml_ns_fl_out;                // exactly at the package end
        ja aml_ns_fl_over;               // an element straddled the end
        call aml_lex_peek_u8;
        mov [rsp + 8], rax;
        call aml_lex_err;
        cmp rax, 0;
        jne aml_ns_fl_out;
        mov rax, [rsp + 8];
        cmp rax, 0x00;
        je aml_ns_fl_rsvd;
        cmp rax, 0x01;
        je aml_ns_fl_acc;
        cmp rax, 0x02;
        je aml_ns_fl_conn;
        cmp rax, 0x03;
        je aml_ns_fl_eacc;
        mov rdi, rax;
        call aml_lex_leadnamechar_ok;
        cmp rax, 0;
        je aml_ns_fl_bad;
        jmp aml_ns_fl_named;

        // ---- ReservedField: 0x00 PkgLength(bits) ----
      aml_ns_fl_rsvd:
        call aml_lex_u8;
        call aml_lex_pkglength_value;    // BIT width, not a byte extent
        mov [rsp + 8], rax;
        call aml_lex_err;
        cmp rax, 0;
        jne aml_ns_fl_out;
        mov rdi, 21;                     // AML_NODE_FIELD_RESERVED
        xor rsi, rsi;
        mov rdx, r12;
        mov rcx, [rsp + 0];
        call aml_node_alloc;
        mov [rsp + 32], rax;
        cmp rax, 0;
        je aml_ns_fl_out;
        mov rdi, [rsp + 32];
        mov rsi, r14;
        mov rdx, [rsp + 8];
        call aml_node_set_args;
        mov rax, [rsp + 8];
        add r14, rax;
        mov rcx, 0xFFFFFFFF;
        cmp r14, rcx;
        ja aml_ns_fl_ovf;
        jmp aml_ns_fl_loop;

        // ---- AccessField: 0x01 AccessType AccessAttrib ----
      aml_ns_fl_acc:
        call aml_lex_u8;                 // consume 0x01
        call aml_lex_u8;                 // AccessType
        mov [rsp + 8], rax;
        call aml_lex_u8;                 // AccessAttrib
        mov [rsp + 16], rax;
        call aml_lex_err;
        cmp rax, 0;
        jne aml_ns_fl_out;
        xor rax, rax;
        mov [rsp + 24], rax;             // AccessLength = 0 for the short form
        jmp aml_ns_fl_accapply;

        // ---- ExtendedAccessField: 0x03 AccessType ExtAttrib AccessLength ----
      aml_ns_fl_eacc:
        call aml_lex_u8;                 // consume 0x03
        call aml_lex_u8;                 // AccessType
        mov [rsp + 8], rax;
        call aml_lex_u8;                 // ExtendedAccessAttrib
        mov [rsp + 16], rax;
        call aml_lex_u8;                 // AccessLength
        mov [rsp + 24], rax;
        call aml_lex_err;
        cmp rax, 0;
        jne aml_ns_fl_out;

      aml_ns_fl_accapply:
        mov rcx, r15;
        and rcx, 0xF0;                   // keep LockRule + UpdateRule
        mov rax, [rsp + 8];
        and rax, 0x0F;                   // new AccessType nibble
        or rcx, rax;
        mov rax, [rsp + 16];
        and rax, 0xFF;
        shl rax, 8;                      // attribute in bits [15:8]
        or rcx, rax;
        mov r15, rcx;
        mov rdi, 20;                     // AML_NODE_FIELD_ACCESS
        xor rsi, rsi;
        mov rdx, r12;
        mov rcx, [rsp + 0];
        call aml_node_alloc;
        mov [rsp + 32], rax;
        cmp rax, 0;
        je aml_ns_fl_out;
        mov rdi, [rsp + 32];
        mov rsi, r15;
        call aml_node_set_flags;
        mov rdi, [rsp + 32];
        mov rsi, [rsp + 24];             // AccessLength
        xor rdx, rdx;
        call aml_node_set_args;
        jmp aml_ns_fl_loop;

        // ---- ConnectField: 0x02 (NameString | BufferData) ----
      aml_ns_fl_conn:
        call aml_lex_u8;                 // consume 0x02
        call aml_lex_peek_u8;
        mov [rsp + 8], rax;
        call aml_lex_err;
        cmp rax, 0;
        jne aml_ns_fl_out;
        mov rax, [rsp + 8];
        cmp rax, 0x11;                   // BufferOp selects the BufferData form
        je aml_ns_fl_connbuf;
        call aml_lex_namestring;
        mov [rsp + 16], rax;
        call aml_lex_err;
        cmp rax, 0;
        jne aml_ns_fl_out;
        mov rdi, 22;                     // AML_NODE_FIELD_CONNECT
        mov rsi, [rsp + 16];
        mov rdx, r12;
        mov rcx, [rsp + 0];
        call aml_node_alloc;
        cmp rax, 0;
        je aml_ns_fl_out;
        jmp aml_ns_fl_loop;
      aml_ns_fl_connbuf:
        call aml_lex_u8;                 // consume BufferOp
        call aml_lex_pos;
        mov [rsp + 8], rax;              // PkgLength lead byte
        call aml_lex_pkglength;
        mov [rsp + 16], rax;
        call aml_lex_err;
        cmp rax, 0;
        jne aml_ns_fl_out;
        mov rdi, 22;
        xor rsi, rsi;
        mov rdx, r12;
        mov rcx, [rsp + 0];
        call aml_node_alloc;
        mov [rsp + 32], rax;
        cmp rax, 0;
        je aml_ns_fl_out;
        mov rax, [rsp + 8];
        mov rcx, [rsp + 16];
        add rcx, rax;
        mov [rsp + 24], rcx;             // buffer package end
        mov rdi, [rsp + 32];
        mov rsi, [rsp + 8];
        mov rdx, [rsp + 24];
        call aml_node_set_args;
        mov rdi, [rsp + 24];
        call aml_lex_seek;
        jmp aml_ns_fl_loop;

        // ---- NamedField: NameSeg PkgLength(bits) ----
      aml_ns_fl_named:
        call aml_lex_nameseg;
        mov [rsp + 16], rax;
        call aml_lex_err;
        cmp rax, 0;
        jne aml_ns_fl_out;
        call aml_lex_pkglength_value;    // BIT width, not a byte extent
        mov [rsp + 8], rax;
        call aml_lex_err;
        cmp rax, 0;
        jne aml_ns_fl_out;
        mov rdi, 1;
        call aml_name_alloc;
        mov [rsp + 24], rax;
        cmp rax, 0;
        je aml_ns_fl_out;
        mov rdi, [rsp + 24];
        mov rsi, 1;                      // one segment
        xor rdx, rdx;                    // no '^' prefix
        xor rcx, rcx;                    // not root-relative
        call aml_name_set_hdr;
        mov rdi, [rsp + 24];
        xor rsi, rsi;
        mov rdx, [rsp + 16];
        call aml_name_set_seg;
        mov rdi, 14;                     // AML_NODE_FIELD_ELEM
        mov rsi, [rsp + 24];
        mov rdx, r12;
        mov rcx, [rsp + 0];
        call aml_node_alloc;
        mov [rsp + 32], rax;
        cmp rax, 0;
        je aml_ns_fl_out;
        mov rdi, [rsp + 32];
        mov rsi, r15;                    // effective access at this point
        call aml_node_set_flags;
        mov rdi, [rsp + 32];
        mov rsi, r14;                    // bit offset
        mov rdx, [rsp + 8];              // bit width
        call aml_node_set_args;
        mov rax, [rsp + 8];
        add r14, rax;
        mov rcx, 0xFFFFFFFF;
        cmp r14, rcx;
        ja aml_ns_fl_ovf;
        jmp aml_ns_fl_loop;

      aml_ns_fl_bad:
        mov rdi, 13;                     // AML_ERR_BAD_FIELD_ELEM
        call aml_lex_set_err;
        jmp aml_ns_fl_out;
      aml_ns_fl_over:
        mov rdi, 11;                     // AML_ERR_PKG_OVERRUN
        call aml_lex_set_err;
        jmp aml_ns_fl_out;
      aml_ns_fl_ovf:
        mov rdi, 17;                     // AML_ERR_FIELD_OFFSET_OVF
        call aml_lex_set_err;
      aml_ns_fl_out:
        add rsp, 48;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        call aml_lex_err;
        ret
      }
    } @no_frame

  // ==========================================================================
  // aml_parse_term(parent, end_off) -> err — one TermObj in namespace
  // position.
  // ==========================================================================
  pub let aml_parse_term : (u64, u64) -> u64 !{mem} @{} =
    fn (parent: u64) (end_off: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-002 (#1050): parse one namespace-position TermObj as a child of rdi. Order of the three rejection tests is deliberate. First the name-lead test, because a bare NameString is a method invocation and none of its lead bytes is an opcode — running it through the table would report the wrong error. Then the table lookup, whose miss means the byte is not an AML opcode at all. Then the F_M1_HANDLED bit, whose absence means the opcode is real but unimplemented. Dispatch is on the table's NODE KIND rather than on the opcode, so the branch chain is proportional to the dozen node shapes rather than the hundred-odd opcodes, and #1051/#1052 extend it by adding rows plus at most one arm. Frame: 32 bytes at [rsp+0..24] for the package end, name reference, node index and one scratch. Locals: r12=parent, r13=end offset, r14=opcode source offset, r15=the packed table entry, re-decoded on demand rather than held in a caller-saved register across the nested calls. Reserved labels: aml_ns_term_.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 32;
        mov r12, rdi;
        mov r13, rsi;
        call aml_lex_pos;
        mov r14, rax;                    // opcode source offset
        call aml_lex_peek_u8;
        mov [rsp + 24], rax;
        call aml_lex_err;
        cmp rax, 0;
        jne aml_ns_term_out;
        mov rdi, [rsp + 24];
        call aml_ns_is_namelead;
        cmp rax, 0;
        jne aml_ns_term_minv;
        call aml_lex_opcode;
        mov [rsp + 24], rax;
        call aml_lex_err;
        cmp rax, 0;
        jne aml_ns_term_out;
        mov rdi, [rsp + 24];
        call aml_optab_find;
        mov r15, rax;
        cmp r15, 0;
        je aml_ns_term_unk;
        mov rax, r15;
        shr rax, 24;
        and rax, 0x40;                   // F_M1_HANDLED
        cmp rax, 0;
        je aml_ns_term_unhandled;
        mov rax, r15;
        shr rax, 40;
        and rax, 0xFF;                   // node kind
        cmp rax, 2;
        je aml_ns_term_scope;            // Scope
        cmp rax, 3;
        je aml_ns_term_scope;            // Device
        cmp rax, 9;
        je aml_ns_term_scope;            // ThermalZone
        cmp rax, 7;
        je aml_ns_term_proc;             // Processor
        cmp rax, 8;
        je aml_ns_term_pwr;              // PowerResource
        cmp rax, 4;
        je aml_ns_term_method;
        cmp rax, 11;
        je aml_ns_term_field;
        cmp rax, 12;
        je aml_ns_term_ifield;
        cmp rax, 13;
        je aml_ns_term_bfield;
        cmp rax, 10;
        je aml_ns_term_opreg;
        cmp rax, 5;
        je aml_ns_term_name;
        cmp rax, 6;
        je aml_ns_term_alias;
        cmp rax, 15;
        je aml_ns_term_ext;
        cmp rax, 17;
        je aml_ns_term_mutex;
        cmp rax, 18;
        je aml_ns_term_event;
        jmp aml_ns_term_unhandled;

        // ---- Scope / Device / ThermalZone: PkgLength NameString TermList ----
      aml_ns_term_scope:
        mov rax, r15;
        shr rax, 40;
        and rax, 0xFF;
        mov rdi, rax;
        mov rsi, r12;
        mov rdx, r14;
        call aml_ns_open_pkg_named;
        mov [rsp + 16], rax;
        cmp rax, 0;
        je aml_ns_term_out;
        jmp aml_ns_term_body;

        // ---- Processor: + ProcID(1) PblkAddr(4) PblkLen(1) ----
      aml_ns_term_proc:
        mov rdi, 7;
        mov rsi, r12;
        mov rdx, r14;
        call aml_ns_open_pkg_named;
        mov [rsp + 16], rax;
        cmp rax, 0;
        je aml_ns_term_out;
        call aml_lex_u8;                 // ProcID
        mov [rsp + 24], rax;
        call aml_lex_u32;                // PblkAddr
        call aml_lex_u8;                 // PblkLen
        call aml_lex_err;
        cmp rax, 0;
        jne aml_ns_term_out;
        mov rdi, [rsp + 16];
        mov rsi, [rsp + 24];
        call aml_node_set_flags;
        jmp aml_ns_term_body;

        // ---- PowerResource: + SystemLevel(1) ResourceOrder(2) ----
      aml_ns_term_pwr:
        mov rdi, 8;
        mov rsi, r12;
        mov rdx, r14;
        call aml_ns_open_pkg_named;
        mov [rsp + 16], rax;
        cmp rax, 0;
        je aml_ns_term_out;
        call aml_lex_u8;                 // SystemLevel
        mov [rsp + 24], rax;
        call aml_lex_u16;                // ResourceOrder
        call aml_lex_err;
        cmp rax, 0;
        jne aml_ns_term_out;
        mov rdi, [rsp + 16];
        mov rsi, [rsp + 24];
        call aml_node_set_flags;
        jmp aml_ns_term_body;

        // ---- shared tail: record the TermList extent and descend ----
      aml_ns_term_body:
        call aml_lex_pos;
        mov [rsp + 0], rax;              // TermList start
        mov rdi, [rsp + 16];
        call aml_node_arg1;
        mov [rsp + 8], rax;              // package end (parked by the helper)
        mov rdi, [rsp + 16];
        mov rsi, [rsp + 0];
        mov rdx, [rsp + 8];
        call aml_node_set_args;
        mov rdi, [rsp + 16];
        mov rsi, [rsp + 8];
        call aml_parse_termlist;
        jmp aml_ns_term_out;

        // ---- Method: PkgLength NameString MethodFlags TermList ----
      aml_ns_term_method:
        mov rdi, 4;
        mov rsi, r12;
        mov rdx, r14;
        call aml_ns_open_pkg_named;
        mov [rsp + 16], rax;
        cmp rax, 0;
        je aml_ns_term_out;
        call aml_lex_u8;                 // MethodFlags
        mov [rsp + 24], rax;
        call aml_lex_err;
        cmp rax, 0;
        jne aml_ns_term_out;
        mov rdi, [rsp + 16];
        mov rsi, [rsp + 24];
        call aml_node_set_flags;
        call aml_lex_pos;
        mov [rsp + 0], rax;              // body start
        mov rdi, [rsp + 16];
        call aml_node_arg1;
        mov [rsp + 8], rax;              // body end
        mov rdi, [rsp + 16];
        mov rsi, [rsp + 0];
        mov rdx, [rsp + 8];
        call aml_node_set_args;
        mov rdi, [rsp + 8];
        call aml_lex_seek;               // body is #1051, not descended
        jmp aml_ns_term_out;

        // ---- Field: PkgLength NameString FieldFlags FieldList ----
      aml_ns_term_field:
        mov rdi, 11;
        mov rsi, r12;
        mov rdx, r14;
        call aml_ns_open_pkg_named;
        mov [rsp + 16], rax;
        cmp rax, 0;
        je aml_ns_term_out;
        jmp aml_ns_term_fflags;

        // ---- IndexField: PkgLength NameString NameString FieldFlags ----
      aml_ns_term_ifield:
        mov rdi, 12;
        mov rsi, r12;
        mov rdx, r14;
        call aml_ns_open_pkg_named;
        mov [rsp + 16], rax;
        cmp rax, 0;
        je aml_ns_term_out;
        call aml_lex_namestring;         // DataName
        push rax;
        call aml_lex_err;
        cmp rax, 0;
        pop rcx;
        jne aml_ns_term_out;
        mov rsi, rcx;
        mov rdi, 19;                     // AML_NODE_FIELD_LINK
        mov rdx, [rsp + 16];
        mov rcx, r14;
        call aml_node_alloc;
        cmp rax, 0;
        je aml_ns_term_out;
        jmp aml_ns_term_fflags;

        // ---- BankField: PkgLength Region Bank BankValue FieldFlags ----
      aml_ns_term_bfield:
        mov rdi, 13;
        mov rsi, r12;
        mov rdx, r14;
        call aml_ns_open_pkg_named;
        mov [rsp + 16], rax;
        cmp rax, 0;
        je aml_ns_term_out;
        call aml_lex_namestring;         // BankName
        push rax;
        call aml_lex_err;
        cmp rax, 0;
        pop rcx;
        jne aml_ns_term_out;
        mov rsi, rcx;
        mov rdi, 19;                     // AML_NODE_FIELD_LINK
        mov rdx, [rsp + 16];
        mov rcx, r14;
        call aml_node_alloc;
        mov [rsp + 0], rax;
        cmp rax, 0;
        je aml_ns_term_out;
        call aml_lex_integer;            // BankValue (literal only at M1)
        push rax;
        call aml_lex_err;
        cmp rax, 0;
        pop rcx;
        jne aml_ns_term_out;
        mov rdi, rcx;
        call aml_u64_alloc;
        mov [rsp + 8], rax;
        cmp rax, 0;
        je aml_ns_term_out;
        mov rdi, [rsp + 0];
        mov rsi, [rsp + 8];
        xor rdx, rdx;
        call aml_node_set_args;
        jmp aml_ns_term_fflags;

        // ---- shared tail: FieldFlags byte then the FieldList ----
      aml_ns_term_fflags:
        call aml_lex_u8;                 // FieldFlags
        mov [rsp + 24], rax;
        call aml_lex_err;
        cmp rax, 0;
        jne aml_ns_term_out;
        mov rdi, [rsp + 16];
        mov rsi, [rsp + 24];
        call aml_node_set_flags;
        call aml_lex_pos;
        mov [rsp + 0], rax;              // FieldList start
        mov rdi, [rsp + 16];
        call aml_node_arg1;
        mov [rsp + 8], rax;              // package end
        mov rdi, [rsp + 16];
        mov rsi, [rsp + 0];
        mov rdx, [rsp + 8];
        call aml_node_set_args;
        mov rdi, [rsp + 16];
        mov rsi, [rsp + 8];
        mov rdx, [rsp + 24];
        call aml_ns_fieldlist;
        jmp aml_ns_term_out;

        // ---- OpRegion: NameString RegionSpace RegionOffset RegionLen ----
      aml_ns_term_opreg:
        call aml_lex_namestring;
        push rax;
        call aml_lex_err;
        cmp rax, 0;
        pop rcx;
        jne aml_ns_term_out;
        mov rsi, rcx;
        mov rdi, 10;
        mov rdx, r12;
        mov rcx, r14;
        call aml_node_alloc;
        mov [rsp + 16], rax;
        cmp rax, 0;
        je aml_ns_term_out;
        call aml_lex_u8;                 // RegionSpace
        mov [rsp + 24], rax;
        call aml_lex_err;
        cmp rax, 0;
        jne aml_ns_term_out;
        mov rdi, [rsp + 16];
        mov rsi, [rsp + 24];
        call aml_node_set_flags;
        call aml_lex_integer;            // RegionOffset
        push rax;
        call aml_lex_err;
        cmp rax, 0;
        pop rcx;
        jne aml_ns_term_out;
        mov rdi, rcx;
        call aml_u64_alloc;
        mov [rsp + 0], rax;
        cmp rax, 0;
        je aml_ns_term_out;
        call aml_lex_integer;            // RegionLen
        push rax;
        call aml_lex_err;
        cmp rax, 0;
        pop rcx;
        jne aml_ns_term_out;
        mov rdi, rcx;
        call aml_u64_alloc;
        mov [rsp + 8], rax;
        cmp rax, 0;
        je aml_ns_term_out;
        mov rdi, [rsp + 16];
        mov rsi, [rsp + 0];
        mov rdx, [rsp + 8];
        call aml_node_set_args;
        jmp aml_ns_term_out;

        // ---- Name: NameString DataRefObject ----
      aml_ns_term_name:
        call aml_lex_namestring;
        push rax;
        call aml_lex_err;
        cmp rax, 0;
        pop rcx;
        jne aml_ns_term_out;
        mov rsi, rcx;
        mov rdi, 5;
        mov rdx, r12;
        mov rcx, r14;
        call aml_node_alloc;
        mov [rsp + 16], rax;
        cmp rax, 0;
        je aml_ns_term_out;
        mov rdi, [rsp + 16];
        call aml_ns_dataobj;
        jmp aml_ns_term_out;

        // ---- Alias: NameString(source) NameString(alias) ----
      aml_ns_term_alias:
        call aml_lex_namestring;
        push rax;
        call aml_lex_err;
        cmp rax, 0;
        pop rcx;
        jne aml_ns_term_out;
        mov [rsp + 0], rcx;              // source name reference
        mov rdi, 6;
        xor rsi, rsi;
        mov rdx, r12;
        mov rcx, r14;
        call aml_node_alloc;
        mov [rsp + 16], rax;
        cmp rax, 0;
        je aml_ns_term_out;
        call aml_lex_namestring;         // the alias itself
        push rax;
        call aml_lex_err;
        cmp rax, 0;
        pop rcx;
        jne aml_ns_term_out;
        mov rdi, [rsp + 16];
        mov rsi, rcx;
        call aml_node_set_name;
        mov rdi, [rsp + 16];
        mov rsi, [rsp + 0];
        xor rdx, rdx;
        call aml_node_set_args;
        jmp aml_ns_term_out;

        // ---- External: NameString ObjectType(1) ArgumentCount(1) ----
      aml_ns_term_ext:
        call aml_lex_namestring;
        push rax;
        call aml_lex_err;
        cmp rax, 0;
        pop rcx;
        jne aml_ns_term_out;
        mov rsi, rcx;
        mov rdi, 15;
        mov rdx, r12;
        mov rcx, r14;
        call aml_node_alloc;
        mov [rsp + 16], rax;
        cmp rax, 0;
        je aml_ns_term_out;
        call aml_lex_u8;                 // ObjectType
        mov [rsp + 0], rax;
        call aml_lex_u8;                 // ArgumentCount
        mov [rsp + 8], rax;
        call aml_lex_err;
        cmp rax, 0;
        jne aml_ns_term_out;
        mov rax, [rsp + 8];
        and rax, 0xFF;
        shl rax, 8;
        mov rcx, [rsp + 0];
        and rcx, 0xFF;
        or rax, rcx;
        mov rdi, [rsp + 16];
        mov rsi, rax;
        call aml_node_set_flags;
        jmp aml_ns_term_out;

        // ---- Mutex: NameString SyncFlags(1) ----
      aml_ns_term_mutex:
        call aml_lex_namestring;
        push rax;
        call aml_lex_err;
        cmp rax, 0;
        pop rcx;
        jne aml_ns_term_out;
        mov rsi, rcx;
        mov rdi, 17;
        mov rdx, r12;
        mov rcx, r14;
        call aml_node_alloc;
        mov [rsp + 16], rax;
        cmp rax, 0;
        je aml_ns_term_out;
        call aml_lex_u8;                 // SyncFlags
        mov [rsp + 24], rax;
        call aml_lex_err;
        cmp rax, 0;
        jne aml_ns_term_out;
        mov rdi, [rsp + 16];
        mov rsi, [rsp + 24];
        call aml_node_set_flags;
        jmp aml_ns_term_out;

        // ---- Event: NameString ----
      aml_ns_term_event:
        call aml_lex_namestring;
        push rax;
        call aml_lex_err;
        cmp rax, 0;
        pop rcx;
        jne aml_ns_term_out;
        mov rsi, rcx;
        mov rdi, 18;
        mov rdx, r12;
        mov rcx, r14;
        call aml_node_alloc;
        cmp rax, 0;
        je aml_ns_term_out;
        jmp aml_ns_term_out;

        // ---- a real opcode this milestone does not parse ----
      aml_ns_term_unhandled:
        mov rax, r15;
        shr rax, 24;
        and rax, 0x81;                   // F_PKGLEN | F_OPAQUE_OK
        cmp rax, 0x81;
        jne aml_ns_term_unexp;
        call aml_ns_pkg_open;
        mov [rsp + 8], rax;
        call aml_lex_err;
        cmp rax, 0;
        jne aml_ns_term_out;
        mov rdi, 16;                     // AML_NODE_OPAQUE
        xor rsi, rsi;
        mov rdx, r12;
        mov rcx, r14;
        call aml_node_alloc;
        mov [rsp + 16], rax;
        cmp rax, 0;
        je aml_ns_term_out;
        call aml_lex_pos;
        mov [rsp + 0], rax;
        mov rdi, [rsp + 16];
        mov rsi, [rsp + 0];
        mov rdx, [rsp + 8];
        call aml_node_set_args;
        mov rdi, [rsp + 8];
        call aml_lex_seek;
        jmp aml_ns_term_out;

      aml_ns_term_unexp:
        mov rdi, 10;                     // AML_ERR_UNEXPECTED_OP
        call aml_lex_set_err;
        jmp aml_ns_term_out;
      aml_ns_term_unk:
        mov rdi, 5;                      // AML_ERR_UNKNOWN_OPCODE
        call aml_lex_set_err;
        jmp aml_ns_term_out;
      aml_ns_term_minv:
        mov rdi, 18;                     // AML_ERR_METHOD_INVOCATION
        call aml_lex_set_err;
      aml_ns_term_out:
        add rsp, 32;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        call aml_lex_err;
        ret
      }
    } @no_frame

  // ==========================================================================
  // aml_parse_termlist(parent, end_off) -> err
  // ==========================================================================
  pub let aml_parse_termlist : (u64, u64) -> u64 !{mem} @{} =
    fn (parent: u64) (end_off: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-002 (#1050): parse TermObjs into rdi until the cursor reaches rsi. Claims a recursion level first and releases it on every exit that took one — the enter/leave pair is split around the loop rather than wrapped inside it so that the depth-exhausted path, which never incremented, can skip the release and keep the counter balanced. Three termination guards, each closing a distinct hostile input: the sticky error flag stops the loop after any fault; a zero-advance iteration is AML_ERR_NO_PROGRESS (14), which catches a construct that consumes nothing; and an iteration that ends past the package end is AML_ERR_PKG_OVERRUN (11), which catches a child whose declared extent contradicts its parent's. Locals: r12=parent, r13=end offset, r14=cursor snapshot taken before each term. Reserved labels: aml_ns_tl_.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        mov r13, rsi;
        call aml_lex_depth_enter;
        cmp rax, 0;
        jne aml_ns_tl_out;
      aml_ns_tl_loop:
        call aml_lex_err;
        cmp rax, 0;
        jne aml_ns_tl_leave;
        call aml_lex_pos;
        mov r14, rax;
        cmp r14, r13;
        jae aml_ns_tl_leave;
        mov rdi, r12;
        mov rsi, r13;
        call aml_parse_term;
        call aml_lex_err;
        cmp rax, 0;
        jne aml_ns_tl_leave;
        call aml_lex_pos;
        cmp rax, r14;
        jbe aml_ns_tl_noprog;
        cmp rax, r13;
        ja aml_ns_tl_over;
        jmp aml_ns_tl_loop;
      aml_ns_tl_noprog:
        mov rdi, 14;                     // AML_ERR_NO_PROGRESS
        call aml_lex_set_err;
        jmp aml_ns_tl_leave;
      aml_ns_tl_over:
        mov rdi, 11;                     // AML_ERR_PKG_OVERRUN
        call aml_lex_set_err;
      aml_ns_tl_leave:
        call aml_lex_depth_leave;
      aml_ns_tl_out:
        pop r14;
        pop r13;
        pop r12;
        call aml_lex_err;
        ret
      }
    } @no_frame

  // ==========================================================================
  // aml_parse(buf, len) -> root node index, or 0 if the table was rejected.
  // ==========================================================================
  pub let aml_parse : (u64, u64) -> u64 !{mem} @{} =
    fn (buf: u64) (len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-002 (#1050): parse an AML byte buffer into the arena and return the root node index, or 0 if anything was rejected. rdi=buffer, rsi=length. Resets the arenas before binding the cursor so a previous parse cannot leak nodes into this one. The synthetic root records the whole buffer as its extent (arg0=0, arg1=len), which makes 'the table' a node like any other and means a consumer walks one uniform tree rather than special-casing the top level. Returns 0 on ANY latched error rather than a partial tree: a caller that received a node index must be able to trust the subtree under it, and the detail of what went wrong is available from aml_lex_err / aml_lex_err_off. The arena is deliberately left populated on failure so an operator can inspect how far the parse got. Locals: r12=buffer then root index, r13=length. Reserved labels: aml_ns_p_.",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        mov r13, rsi;
        call aml_arena_reset;
        mov rdi, r12;
        mov rsi, r13;
        call aml_lex_init;
        mov rdi, 1;                      // AML_NODE_ROOT
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call aml_node_alloc;
        mov r12, rax;
        cmp r12, 0;
        je aml_ns_p_fail;
        mov rdi, r12;
        xor rsi, rsi;
        mov rdx, r13;
        call aml_node_set_args;
        mov rdi, r12;
        mov rsi, r13;
        call aml_parse_termlist;
        call aml_lex_err;
        cmp rax, 0;
        jne aml_ns_p_fail;
        mov rax, r12;
        pop r13;
        pop r12;
        ret;
      aml_ns_p_fail:
        xor rax, rax;
        pop r13;
        pop r12;
        ret
      }
    } @no_frame
}
