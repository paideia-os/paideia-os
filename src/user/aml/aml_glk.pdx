// src/user/aml/aml_glk.pdx — R30.M8-001 (#1082)
//
// THE ACPI GLOBAL LOCK.
//
// ---------------------------------------------------------------------
// THE PROPERTY THIS FILE EXISTS TO MAKE TRUE
// ---------------------------------------------------------------------
//   When this process touches a resource the firmware also touches,
//   exactly one of the two is touching it, and whichever one finishes
//   second was told the other had wanted it.
//
// Both halves matter and the second is the one that gets skipped.
//
// ---------------------------------------------------------------------
// WHY THIS IS NOT AN ORDINARY MUTEX
// ---------------------------------------------------------------------
// aml_ctl.pdx already has a mutex: aml_mutex_pool, which serializes
// AML's own Serialized methods against each other. That mutex works
// because every party to it is code in this process, and code in this
// process can be made to wait.
//
// THE OTHER PARTY HERE IS SYSTEM MANAGEMENT MODE, AND IT CANNOT BE MADE
// TO WAIT. An SMI preempts everything — ring 0, interrupts disabled,
// NMIs, the lot. It does not schedule, it does not yield, and it does
// not consult us. When firmware wants the embedded controller it takes
// it, and the only thing standing between its transaction and ours is
// this word.
//
// Two consequences run through every line below.
//
// FIRST: the read-modify-write must be a SINGLE ATOMIC INSTRUCTION. A
// load, a computation and a store is not the same thing as a compare-
// exchange; it is the same thing MOST of the time, which is the worst
// possible property for a synchronisation primitive to have. Firmware
// can land between any two of our instructions, so the window between
// the load and the store is a window in which our store overwrites a
// decision firmware already made. The instruction is lock_cmpxchg_d and
// its atomicity is the whole mechanism.
//
// SECOND: a fixture in which the word never changes underneath us
// proves nothing whatever about the case the protocol exists for. So
// this module ships an ADVERSARY — a synthetic firmware that mutates
// the lock word at exactly the point a real SMI would, between our read
// and our write. See THE ADVERSARY below.
//
// ---------------------------------------------------------------------
// THE PROTOCOL — ACPI 6.5 §5.2.10.1, and why it is spelled this way
// ---------------------------------------------------------------------
// The lock is a 32-bit field at FACS offset 0x10:
//
//     bit 0   Owned     someone holds the lock
//     bit 1   Pending   someone else wants it and must be signalled
//
// ACQUIRE:
//     do {
//        old = *GL;
//        new = (old & ~1) | 1;         // claim Owned
//        if (old & 1) new |= 2;        // it was already held: register
//     } while (cmpxchg(GL, old, new) != old);
//     acquired = ((new & 2) == 0);
//
// RELEASE:
//     do {
//        old = *GL;
//        new = old & ~3;               // drop Owned AND Pending
//     } while (cmpxchg(GL, old, new) != old);
//     must_signal = ((old & 2) != 0);
//
// `(old & ~1) | 1` is arithmetically just `old | 1`, and this module
// emits the one-instruction form. The masked form is what the
// specification prints, and the reason to keep the specification's
// spelling in the comment rather than in the code is that the
// interesting conditional is the NEXT line — Pending is set from the
// OLD value, not the new one. That is the line a reimplementation gets
// wrong, so that is the line the comment is for.
//
// YOU ACQUIRED IT ONLY IF PENDING CAME BACK CLEAR. A successful
// compare-exchange means our write landed; it does NOT mean we hold the
// lock. If firmware held it, the value we successfully wrote is one
// that says "firmware holds it and we are waiting" — a correct write of
// a value that means we lost. Treating a successful cmpxchg as a
// successful acquire is the single easiest way to write this function
// wrongly, and it produces a driver that transacts against the EC while
// SMM is mid-transaction on the same registers.
//
// ---------------------------------------------------------------------
// THE DOORBELL, AND WHY OMITTING IT IS THE WORST BUG AVAILABLE HERE
// ---------------------------------------------------------------------
// If the value we replace on RELEASE had Pending set, some other party
// asked for the lock while we held it and is now waiting to be told it
// is free. Telling it is a write of GBL_RLS to PM1_CNT.
//
// Skip that write and NOTHING BREAKS HERE. Our acquire count balances,
// our release count balances, our transactions complete, our tests pass.
// What breaks is the FIRMWARE, which waits for a signal that never
// comes, and which therefore stops servicing the things only it can
// service. On the T14 G4 that includes thermal response: the EC's fan
// and throttle policy is driven through firmware paths that take this
// lock.
//
// A machine that overheats because a doorbell write was skipped is the
// failure this module is designed against, and it is designed against
// twice: the write is on the release path, and aml_glk_signals() counts
// it so a corpus can assert the doorbell rang rather than assert that
// the code that would ring it exists.
//
// THE DOORBELL IS A READ-MODIFY-WRITE, NOT A STORE. PM1_CNT is a
// control register with live occupants — SCI_EN (bit 0) is what keeps
// the machine in ACPI mode at all. Writing 0x04 to it, which is what
// "set GBL_RLS" looks like if you write the bit you mean, clears SCI_EN
// and drops the platform out of ACPI mode. So aml_glk_signal reads the
// register first and ORs.
//
// And it masks SLP_EN (bit 13) out of the value it writes back. SLP_EN
// is write-only and one-shot: writing 1 to it INITIATES A SLEEP
// TRANSITION. It reads back as 0 on every part we know of, so the mask
// is redundant on every part we know of — which is exactly the argument
// for having it, because the cost is one instruction and the failure it
// covers is the machine suspending in the middle of an EC transaction
// on a part where the read-back is not 0.
//
// ---------------------------------------------------------------------
// 32-BIT, AND THAT IS LOAD-BEARING
// ---------------------------------------------------------------------
// The lock is a u32 at FACS+0x10. The FACS `Flags` field is the u32 at
// FACS+0x14, immediately after it.
//
// lock_cmpxchg (64-bit) at FACS+0x10 would read-modify-write BOTH — it
// would carry Flags through our arithmetic and store it back, and any
// firmware update to Flags landing inside our window would be silently
// reverted. The instruction here is lock_cmpxchg_d, the 32-bit form,
// and aml_glk_facs reserves +20 as a guard word the corpus asserts is
// untouched. A 64-bit mutant fails that assertion rather than passing
// review.
//
// ---------------------------------------------------------------------
// NESTING — the hardware lock is taken at 0->1 and dropped at 1->0
// ---------------------------------------------------------------------
// AML may acquire \_GL recursively; ACPI requires OSPM to keep an
// ownership count and touch the hardware only at the boundaries.
//
// This is not bookkeeping tidiness. An inner release that dropped the
// hardware lock would hand the EC to firmware IN THE MIDDLE OF THE
// OUTER TRANSACTION, and the outer caller would carry on driving
// registers it no longer owns. The corruption appears in whatever
// firmware did with the EC in the interval, which is to say somewhere
// else, later, in a subsystem that never called us.
//
// So aml_glk_enter at depth > 0 increments and returns, touching no
// hardware, and aml_glk_leave at depth > 1 decrements and returns,
// touching no hardware. aml_glk_nest_enters/leaves count exactly those
// cases so that "the nesting path was taken" is assertable rather than
// inferred from the hardware counts staying put.
//
// ---------------------------------------------------------------------
// BOUNDED WAIT, THEN REFUSE — the EC's discipline, distinct code
// ---------------------------------------------------------------------
// Firmware that never releases must produce a refusal, not a hang. Same
// posture as R30.M7's IBF/OBF waits (#1081) and the same honest caveat:
// AML_GLK_WAIT_MAX is a bound on WORK, not on TIME. This process has no
// clock. That is a limitation and it is named here rather than hidden
// behind a constant that looks like microseconds.
//
// The refusal code is AML_ERR_GLK_TIMEOUT (77) and it is DISTINCT from
// AML_ERR_EC_TIMEOUT_IBF (69) and AML_ERR_EC_TIMEOUT_OBF (70). Three
// codes because they are three different machine faults: the EC did not
// take our byte, the EC did not answer, and FIRMWARE will not let go.
// The first two are the EC; the third is not the EC's fault at all, and
// an operator who conflated them would replace the wrong part.
//
// WAITING IS NOT SPINNING ON THE WORD. When firmware holds the lock we
// have already registered Pending, and the thing that says it is free
// is the RELEASE SIGNAL — GBL_STS in PM1_STS, which firmware raises as
// an SCI when it drops a lock somebody was waiting on. Polling the lock
// word instead would work by accident and would keep working right up
// until a firmware that batches its releases. aml_glk_signalled() reads
// the signal; the wait loop reads aml_glk_signalled().
//
// ---------------------------------------------------------------------
// THE ADVERSARY
// ---------------------------------------------------------------------
// aml_glk_smm_step is called on EVERY pass of EVERY compare-exchange
// loop, in both modes, from the point after the new value is computed
// and before it is written — which is precisely where an SMI is a
// problem and nowhere else.
//
// In hardware mode it observes and returns. In synthetic mode it is the
// firmware: it writes the lock word, from outside our sequence, in the
// window our sequence is supposed to survive.
//
// This is the aml_ec_synth arrangement (#1081) applied to a different
// device. THE CODE UNDER TEST IS BYTE-IDENTICAL IN BOTH MODES — the
// call is unconditional and only the device behind it decides whether
// to act — so every assertion the corpus makes about the compare-
// exchange loop is an assertion about the shipping loop.
//
// The witness this buys: with lock_cmpxchg_d, an injected mutation
// makes our write fail, we retry, and we observe the injected value.
// With a load/compute/store in its place, our store lands on top of the
// injection and firmware's decision disappears. The corpus asserts
// aml_glk_cas_retries() > 0 and asserts the injected bits survive; a
// non-atomic implementation fails both.
//
// ---------------------------------------------------------------------
// PLACEMENT — ring 3, beside the interpreter
// ---------------------------------------------------------------------
// design/acpi/no-aml-in-kernel.md forbids firmware bytecode in ring 0,
// and this module exists to serve the AML bubble's OpRegion accesses.
// It sits in src/user/aml/ for the reason aml_ec.pdx does. It contains
// no port instruction: the doorbell goes through aml_region_port_out,
// which tools/verify-aml-parser.sh pins as one of the only two sites in
// userspace that may emit one.
//
// ---------------------------------------------------------------------
// ERROR CODES ADDED HERE — continuing aml_ec.pdx's 68..75
// ---------------------------------------------------------------------
//   76 AML_ERR_GLK_UNBOUND    no FACS has been attached
//   77 AML_ERR_GLK_TIMEOUT    firmware would not release; bounded out
//   78 AML_ERR_GLK_UNDERFLOW  release with no acquisition outstanding
//   79 AML_ERR_GLK_DEPTH      ownership count would exceed its bound
//   80 AML_ERR_GLK_CAS_STUCK  compare-exchange lost its race too often

module AmlGlk = structure {

  // ==========================================================================
  // Modes. Same shape as AML_EC_MODE_*; the code under test cannot read
  // this and does not branch on it -- only the synthetic FIRMWARE does.
  // ==========================================================================

  pub let AML_GLK_MODE_HW    : u64 = 0
  pub let AML_GLK_MODE_SYNTH : u64 = 1

  // The lock word lives at FACS offset 0x10; `Flags` at 0x14.
  pub let AML_GLK_FACS_OFF : u64 = 16

  pub let AML_GLK_OWNED   : u64 = 1
  pub let AML_GLK_PENDING : u64 = 2

  // PM1_CNT bits. GBL_RLS is the doorbell; SLP_EN is the bit that must
  // never be carried back in by a read-modify-write.
  pub let AML_GLK_GBL_RLS : u64 = 0x0004
  pub let AML_GLK_SLP_EN  : u64 = 0x2000

  // PM1_STS bit 5 -- firmware raises it when it releases a lock that had
  // Pending set. This is the release SIGNAL; it is not the lock word.
  pub let AML_GLK_GBL_STS : u64 = 0x0020

  // Bounds on WORK, not on time. This process has no clock; see the
  // module header. AML_GLK_CAS_MAX bounds one compare-exchange loop --
  // an adversary that mutates the word on every single pass would
  // otherwise keep a correct implementation looping forever, which is a
  // livelock rather than a hang and is no better.
  pub let AML_GLK_CAS_MAX  : u64 = 1024
  pub let AML_GLK_WAIT_MAX : u64 = 20000

  // Nesting bound. Deliberately larger than aml_ctl's 8-deep mutex pool
  // and smaller than anything that could wrap the counter: \_GL nesting
  // is bounded in practice by the evaluator's frame depth, and a bound
  // that is merely "large" is still a bound that gets CHECKED.
  pub let AML_GLK_DEPTH_MAX : u64 = 32

  pub let AML_ERR_GLK_UNBOUND   : u64 = 76
  pub let AML_ERR_GLK_TIMEOUT   : u64 = 77
  pub let AML_ERR_GLK_UNDERFLOW : u64 = 78
  pub let AML_ERR_GLK_DEPTH     : u64 = 79
  pub let AML_ERR_GLK_CAS_STUCK : u64 = 80

  // ==========================================================================
  // Module storage. Confined to aml_glk.o by tools/verify-aml-parser.sh,
  // for the reason aml_ec_state is confined: a second writer could forge
  // an ownership depth, and a forged depth of 1 makes the next release
  // drop a hardware lock this process never took -- handing the EC to
  // firmware while some other caller is mid-transaction on it.
  //
  // aml_glk_state byte offsets:
  //    +0 mode              +8 FACS host VA     +16 PM1_CNT port
  //   +24 PM1_STS port      +32 bound           +40 ownership depth
  //   +48 hw acquires       +56 hw releases     +64 nested enters
  //   +72 nested leaves     +80 CAS retries     +88 doorbell signals
  //   +96 polls on last wait                   +104 timeouts
  //  +112 pending observations                 +120 unbound refusals
  //  +128 underflow refusals                   +136 depth refusals
  //  +144 CAS-stuck refusals                   +152 last error
  //  +160 enter calls      +168 leave calls    +176 successful CASes
  //  +184 deepest depth reached
  // ==========================================================================

  pub let mut aml_glk_state : [u64; 32] = uninit @align(64)

  // THE SYNTHETIC FACS. Byte offsets mirror the real one:
  //   +16 the Global Lock dword (FACS 0x10)
  //   +20 Flags (FACS 0x14) -- THE GUARD WORD. Nothing in this module
  //       may write it, and the corpus asserts it survives every
  //       acquire/release cycle. A 64-bit compare-exchange at +16 would
  //       carry it through the arithmetic and store it back; that mutant
  //       is caught here rather than on a machine.
  pub let mut aml_glk_facs : [u64; 8] = uninit @align(64)

  // THE ADVERSARY -- synthetic System Management Mode.
  //   +0  mode: 0 quiet, 1 inject while budget lasts
  //   +8  injections remaining
  //   +16 the value to STORE into the lock word at the injection point
  //   +24 injections performed
  //   +32 steps observed (times the injection point was reached)
  //   +40 release-signal state: non-zero once firmware has "released"
  //   +48 signal after N steps; 0 = never
  //   +56 doorbell writes the synthetic PM1_CNT received
  pub let mut aml_glk_smm : [u64; 8] = uninit @align(64)

  // ==========================================================================
  // aml_glk_reset() -- clear the per-session counters and the depth.
  //
  // The BINDING (FACS address, ports) deliberately survives, for the
  // reason aml_ec_reset leaves the EC's ports alone: where the FACS is
  // is a system fact, not a per-session one.
  // ==========================================================================

  pub let aml_glk_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M8-001 (#1082): clear the ownership depth and every counter, leaving the FACS/port binding intact. Clearing the DEPTH here is deliberate and is the only place other than aml_glk_enter/leave that touches it: a corpus fixture that has just witnessed a refusal must start the next fixture from a known state without the refusal's depth leaking into it. Leaf; a fixed-length store run. Labels prefixed aml_glkr_ per reserved-label discipline.",
      block: {
        lea rcx, [rip + aml_glk_state];
        xor rax, rax;
        mov [rcx + 40], rax;             // depth
        mov [rcx + 48], rax;
        mov [rcx + 56], rax;
        mov [rcx + 64], rax;
        mov [rcx + 72], rax;
        mov [rcx + 80], rax;
        mov [rcx + 88], rax;
        mov [rcx + 96], rax;
        mov [rcx + 104], rax;
        mov [rcx + 112], rax;
        mov [rcx + 120], rax;
        mov [rcx + 128], rax;
        mov [rcx + 136], rax;
        mov [rcx + 144], rax;
        mov [rcx + 152], rax;
        mov [rcx + 160], rax;
        mov [rcx + 168], rax;
        mov [rcx + 176], rax;
        mov [rcx + 184], rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // aml_glk_attach(facs_va, pm1_cnt_port, pm1_sts_port) -> 1 | 0
  //
  // THE BINDING STEP, and the only writer of the FACS address and the
  // two ports.
  //
  // NO DEFAULTS, and the refusal of a zero argument is the point. A
  // zero FACS address would run the compare-exchange against virtual
  // address 0x10; a zero PM1_CNT port would send the doorbell to port 0
  // and never wake the firmware that is waiting for it. Both are
  // failures that look like success from in here. The three refusals
  // are one branch because they are one condition -- the caller does not
  // actually know where the platform's lock is.
  // ==========================================================================

  pub let aml_glk_attach : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (facs_va: u64) (pm1_cnt_port: u64) (pm1_sts_port: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M8-001 (#1082): bind the FACS host VA and the two PM1 register ports. Refuses any zero argument rather than binding a placeholder, for the reason aml_ec_attach refuses a zero port: a default here is a compare-exchange against a guessed address on a machine that put its FACS somewhere else, and the arithmetic would still 'work'. Sets bound LAST, after all three fields are in place, so no acquire can observe a half-built binding. Leaf; no nested call. Labels prefixed aml_glka_ per reserved-label discipline.",
      block: {
        cmp rdi, 0;
        je aml_glka_bad;
        cmp rsi, 0;
        je aml_glka_bad;
        cmp rdx, 0;
        je aml_glka_bad;

        lea rcx, [rip + aml_glk_state];
        mov [rcx + 8], rdi;              // FACS host VA
        mov [rcx + 16], rsi;             // PM1_CNT port
        mov [rcx + 24], rdx;             // PM1_STS port
        mov rax, 1;
        mov [rcx + 32], rax;             // bound -- LAST
        ret;

      aml_glka_bad:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let aml_glk_bound : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M8-001 (#1082): 1 once aml_glk_attach has bound a FACS and both ports. Leaf load. Reserved labels: none.",
      block: {
        lea rcx, [rip + aml_glk_state];
        mov rax, [rcx + 32];
        ret
      }
    } @no_frame

  pub let aml_glk_mode_set : (u64) -> () !{mem} @{} =
    fn (mode: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M8-001 (#1082): select hardware or synthetic firmware. Read ONLY by aml_glk_smm_step and aml_glk_signal -- the synthetic DEVICE -- and never by the acquire or release loops, which are byte-identical in both modes. That is what makes a corpus assertion about the loop an assertion about the shipping loop. Leaf store. Reserved labels: none.",
      block: {
        lea rcx, [rip + aml_glk_state];
        mov [rcx + 0], rdi;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Counters. One per cause, for the reason aml_ec_stat has one per
  // cause: the latched error code is overwritten by the next success,
  // so "did this happen at all" must stay assertable afterwards.
  // ==========================================================================

  pub let aml_glk_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M8-001 (#1082): read counter `which` from the state block, 0 if out of range. One bounds-checked accessor rather than twenty named leaves, for the reason aml_ec_stat is one: the counters are a homogeneous block read almost exclusively by the corpus, and twenty near-identical functions would be twenty places for an offset to drift out of step with the header comment. The guard precedes the address arithmetic. Reserved labels: aml_glks_.",
      block: {
        cmp rdi, 32;
        jae aml_glks_zero;
        lea rcx, [rip + aml_glk_state];
        mov rax, [rcx + rdi*8];
        ret;
      aml_glks_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  // Indices into aml_glk_stat, named so the corpus and the header
  // comment cannot drift apart silently.
  pub let AML_GLK_ST_DEPTH     : u64 = 5
  pub let AML_GLK_ST_ACQUIRES  : u64 = 6
  pub let AML_GLK_ST_RELEASES  : u64 = 7
  pub let AML_GLK_ST_NEST_IN   : u64 = 8
  pub let AML_GLK_ST_NEST_OUT  : u64 = 9
  pub let AML_GLK_ST_RETRIES   : u64 = 10
  pub let AML_GLK_ST_SIGNALS   : u64 = 11
  pub let AML_GLK_ST_POLLS     : u64 = 12
  pub let AML_GLK_ST_TIMEOUTS  : u64 = 13
  pub let AML_GLK_ST_PENDING   : u64 = 14
  pub let AML_GLK_ST_UNBOUND   : u64 = 15
  pub let AML_GLK_ST_UNDERFLOW : u64 = 16
  pub let AML_GLK_ST_DEPTH_REF : u64 = 17
  pub let AML_GLK_ST_STUCK     : u64 = 18
  pub let AML_GLK_ST_LAST_ERR  : u64 = 19
  pub let AML_GLK_ST_ENTERS    : u64 = 20
  pub let AML_GLK_ST_LEAVES    : u64 = 21
  pub let AML_GLK_ST_CASES     : u64 = 22
  pub let AML_GLK_ST_MAXDEPTH  : u64 = 23

  // ==========================================================================
  // THE SYNTHETIC FIRMWARE.
  //
  // aml_glk_synth_reset(initial_lock_word) puts the synthetic FACS in a
  // known state and disarms the adversary. The GUARD WORD at +20 is
  // stamped with a recognisable non-zero pattern rather than left zero:
  // a 64-bit compare-exchange mutant would zero it, and "it is still
  // 0xF1A65ED5" is an assertion a zero-initialised field could not make.
  // ==========================================================================

  pub let AML_GLK_GUARD : u64 = 0xF1A65ED5

  pub let aml_glk_synth_reset : (u64) -> () !{mem} @{} =
    fn (initial: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M8-001 (#1082): put the synthetic FACS in a known state with `initial` in the lock dword, stamp the guard word at +20, and disarm the adversary. Writes the lock word with mov_d and the guard with mov_d so the two are independent 32-bit stores, exactly as they are on a real FACS -- a helper that wrote both with one 64-bit store would make the guard assertion vacuous by construction. Leaf. Labels prefixed aml_glksr_ per reserved-label discipline.",
      block: {
        lea rcx, [rip + aml_glk_facs];
        mov_d [rcx + 16], rdi;           // the Global Lock dword
        mov rax, 0xF1A65ED5;
        mov_d [rcx + 20], rax;           // the guard word (FACS Flags)

        lea rcx, [rip + aml_glk_smm];
        xor rax, rax;
        mov [rcx + 0], rax;              // adversary quiet
        mov [rcx + 8], rax;
        mov [rcx + 16], rax;
        mov [rcx + 24], rax;
        mov [rcx + 32], rax;
        mov [rcx + 40], rax;             // release signal clear
        mov [rcx + 48], rax;
        mov [rcx + 56], rax;
        ret
      }
    } @no_frame

  pub let aml_glk_facs_word : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M8-001 (#1082): read the synthetic FACS lock dword. Zero-extended 32-bit load, so a corpus comparing against a 32-bit constant cannot be fooled by upper bits a wide store left behind. Leaf. Reserved labels: none.",
      block: {
        lea rcx, [rip + aml_glk_facs];
        xor rax, rax;
        mov eax, [rcx + 16];
        ret
      }
    } @no_frame

  pub let aml_glk_facs_guard : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M8-001 (#1082): read the guard word at FACS+0x14. THE 64-BIT-MUTANT DETECTOR: a lock_cmpxchg (rather than lock_cmpxchg_d) at FACS+0x10 read-modify-writes eight bytes, carrying this word through the acquire arithmetic and storing the result back. The corpus asserts this reads AML_GLK_GUARD after every fixture. Leaf. Reserved labels: none.",
      block: {
        lea rcx, [rip + aml_glk_facs];
        xor rax, rax;
        mov eax, [rcx + 20];
        ret
      }
    } @no_frame

  pub let aml_glk_facs_addr : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M8-001 (#1082): the address of the synthetic FACS, so a corpus can hand it to aml_glk_attach without the harness needing the symbol. Keeping the harness off the symbol is what lets tools/verify-aml-parser.sh assert that aml_glk.o is the ONLY object relocating against aml_glk_facs. Leaf. Reserved labels: none.",
      block: {
        lea rax, [rip + aml_glk_facs];
        ret
      }
    } @no_frame

  // ==========================================================================
  // aml_glk_smm_arm(injections, mask) -- arm the adversary.
  //
  // The interference is `word ^= mask`, A TOGGLE RATHER THAN A STORE,
  // and the choice is not cosmetic.
  //
  // A store of a constant can collide AT MOST ONCE. The first pass reads
  // W, firmware stores V, our compare-exchange expects W and fails. The
  // second pass reads V, firmware stores V again -- the same value the
  // word already holds -- and our compare-exchange expects V and
  // succeeds. Sustained contention is not expressible that way, so a
  // store-based adversary would leave the retry loop tested only to a
  // depth of one and the retry BOUND never exercised at all.
  //
  // A toggle is also the more faithful model. Firmware does not park a
  // constant in the lock word; it acquires and releases, which is
  // exactly bit 0 going up and down. `mask = 1` is firmware taking and
  // dropping the lock repeatedly, which is the contention pattern a busy
  // platform actually produces.
  // ==========================================================================

  pub let aml_glk_smm_arm : (u64, u64) -> () !{mem} @{} =
    fn (injections: u64) (mask: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M8-001 (#1082): arm the synthetic firmware to toggle `mask` in the lock word at the next `injections` compare-exchange injection points. A TOGGLE, not a store -- see the block comment: a constant store collides at most once, because after the first collision the word already holds the constant and the next pass agrees with it, which would leave sustained contention and the retry bound untestable. Mode is derived from the budget rather than passed separately -- a budget of zero IS a quiet adversary, and two independent knobs that can disagree ('armed, budget 0') would be a fixture state with no meaning. Leaf. Reserved labels: none.",
      block: {
        lea rcx, [rip + aml_glk_smm];
        mov [rcx + 8], rdi;              // injections remaining
        mov [rcx + 16], rsi;             // value to store
        xor rax, rax;
        cmp rdi, 0;
        je aml_glkarm_quiet;
        mov rax, 1;
      aml_glkarm_quiet:
        mov [rcx + 0], rax;              // mode = (budget != 0)
        ret
      }
    } @no_frame

  pub let aml_glk_smm_signal_after : (u64) -> () !{mem} @{} =
    fn (steps: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M8-001 (#1082): make the synthetic firmware raise its release signal once the injection point has been reached `steps` times, and clear the lock word at the same moment. This is what lets the corpus exercise the WAIT path to a successful conclusion rather than only to its timeout: firmware that holds the lock for a while and then lets go is the ordinary case, and a fixture that only ever models firmware which never releases would leave the successful wait untested. 0 disables. Leaf. Reserved labels: none.",
      block: {
        lea rcx, [rip + aml_glk_smm];
        mov [rcx + 48], rdi;
        ret
      }
    } @no_frame

  pub let aml_glk_smm_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M8-001 (#1082): read word `which` of the adversary's descriptor, 0 if out of range. Bounds-checked before the address arithmetic. Reserved labels: aml_glkss_.",
      block: {
        cmp rdi, 8;
        jae aml_glkss_zero;
        lea rcx, [rip + aml_glk_smm];
        mov rax, [rcx + rdi*8];
        ret;
      aml_glkss_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let AML_GLK_SMM_DONE   : u64 = 3   // injections performed
  pub let AML_GLK_SMM_STEPS  : u64 = 4   // injection points reached
  pub let AML_GLK_SMM_SIGNAL : u64 = 5   // release signal raised
  pub let AML_GLK_SMM_BELLS  : u64 = 7   // doorbells the synth received

  // ==========================================================================
  // aml_glk_smm_step() -- THE INJECTION POINT.
  //
  // Called unconditionally from both compare-exchange loops, after the
  // new value is computed and before it is written. That is the only
  // instant at which an SMI is a correctness problem, so it is the only
  // instant the adversary is given.
  //
  // In AML_GLK_MODE_HW this observes and returns: the cost is one call
  // per compare-exchange pass, and paying it unconditionally is what
  // keeps the loop byte-identical between modes. A version that
  // branched around the call in hardware mode would be testing a
  // different instruction sequence than it ships.
  // ==========================================================================

  pub let aml_glk_smm_step : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M8-001 (#1082): the SMI injection point. In synthetic mode: bump the step count; if the release-after threshold is reached, clear the lock word and raise the release signal; otherwise, if the adversary has budget, STORE its value into the lock word -- from outside the caller's read-modify-write sequence, which is exactly what an SMI does. The write targets the BOUND FACS (aml_glk_state+8), not the synthetic array directly, so the adversary and the protocol provably touch the same word; targeting the array would let a binding bug hide behind an adversary that still appeared to interfere. Written with mov_d: a 64-bit store would clobber the guard word and make the guard assertion report the ADVERSARY rather than a 64-bit mutant in the protocol. Leaf; no nested call, so the caller's frame arithmetic is unaffected. Labels prefixed aml_glkst_ per reserved-label discipline.",
      block: {
        lea rcx, [rip + aml_glk_state];
        mov rax, [rcx + 0];
        cmp rax, 1;                      // AML_GLK_MODE_SYNTH
        jne aml_glkst_out;

        mov r9, [rcx + 8];               // the BOUND FACS address
        cmp r9, 0;
        je aml_glkst_out;

        lea rcx, [rip + aml_glk_smm];
        mov rax, [rcx + 32];
        add rax, 1;
        mov [rcx + 32], rax;             // steps observed
        mov r8, rax;

        // ---- firmware lets go after N steps ----
        // ONE-SHOT: the threshold is zeroed as it fires. Firmware
        // releases a lock once; a threshold that stayed armed would
        // clear the word on every later step, which would model a
        // firmware that continuously revokes rather than one that
        // finished with the lock -- and would silently invalidate every
        // acquire the fixture went on to make.
        mov rax, [rcx + 48];
        cmp rax, 0;
        je aml_glkst_inject;
        cmp r8, rax;
        jb aml_glkst_inject;
        xor rax, rax;
        mov [rcx + 48], rax;             // disarm: one release, not many
        mov_d [r9 + 16], rax;            // clear the lock word
        mov rax, 1;
        mov [rcx + 40], rax;             // and raise the release signal
        ret;

        // ---- otherwise interfere, while the budget lasts ----
      aml_glkst_inject:
        mov rax, [rcx + 0];
        cmp rax, 0;
        je aml_glkst_out;
        mov rax, [rcx + 8];
        cmp rax, 0;
        je aml_glkst_out;
        sub rax, 1;
        mov [rcx + 8], rax;              // spend one injection
        mov rax, [rcx + 24];
        add rax, 1;
        mov [rcx + 24], rax;             // injections performed

        // THE INTERFERENCE: word ^= mask, from outside the caller's
        // read-modify-write sequence. mov_d throughout, so the guard
        // word at +20 stays out of it and a guard failure can only ever
        // mean a 64-bit compare-exchange in the PROTOCOL.
        xor rax, rax;
        mov eax, [r9 + 16];
        xor rax, [rcx + 16];
        mov_d [r9 + 16], rax;

      aml_glkst_out:
        ret
      }
    } @no_frame

  // ==========================================================================
  // aml_glk_signalled() -> 1 | 0 -- has firmware raised the release
  // signal since we started waiting?
  //
  // THE SIGNAL IS NOT THE LOCK WORD, and reading the word here instead
  // would be the shortcut that works by accident. Firmware raises
  // GBL_STS (PM1_STS bit 5) when it releases a lock somebody had marked
  // Pending; that is a statement about US, addressed to us. The lock
  // word merely happens to be free, which it may also be transiently
  // between two of firmware's own operations.
  // ==========================================================================

  pub let aml_glk_signalled : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M8-001 (#1082): 1 iff the firmware release signal is raised. In synthetic mode the adversary is first given a SCHEDULING OPPORTUNITY -- aml_glk_smm_step -- and then its flag is read. Stepping here as well as at the compare-exchange is what makes the synthetic firmware able to release a lock WHILE WE WAIT, which is the ordinary case on a machine and the only way the successful-wait path is reachable at all; a fixture whose firmware could only act inside our compare-exchange loop would leave the wait exercised solely to its timeout. In hardware mode the signal is GBL_STS (bit 5) of PM1_STS, read through aml_region_port_in as a 16-bit port access -- this module emits no port instruction of its own, per the confinement tools/verify-aml-parser.sh enforces. Not @no_frame: both arms make a nested call. Labels prefixed aml_glksg_ per reserved-label discipline.",
      block: {
        lea rcx, [rip + aml_glk_state];
        mov rax, [rcx + 0];
        cmp rax, 1;                      // AML_GLK_MODE_SYNTH
        jne aml_glksg_hw;

        call aml_glk_smm_step;           // let the synthetic firmware run
        lea rcx, [rip + aml_glk_smm];
        mov rax, [rcx + 40];
        cmp rax, 0;
        je aml_glksg_no;
        mov rax, 1;
        ret;

      aml_glksg_hw:
        lea rcx, [rip + aml_glk_state];
        mov rdi, [rcx + 24];             // PM1_STS port
        cmp rdi, 0;
        je aml_glksg_no;
        mov rsi, 2;                      // 16-bit register
        call aml_region_port_in;
        and rax, 0x0020;                 // AML_GLK_GBL_STS
        cmp rax, 0;
        je aml_glksg_no;
        mov rax, 1;
        ret;

      aml_glksg_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // aml_glk_signal() -- RING THE DOORBELL.
  //
  // Read PM1_CNT, OR in GBL_RLS, mask SLP_EN out, write it back. See the
  // module header for why each of those three is load-bearing; the short
  // form is that a bare store of 0x0004 clears SCI_EN and drops the
  // machine out of ACPI mode, and a read-modify-write that carries
  // SLP_EN back in suspends it.
  // ==========================================================================

  pub let aml_glk_signal : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M8-001 (#1082): write GBL_RLS to PM1_CNT, telling firmware the lock it was waiting on is free. Counted at aml_glk_state+88 on BOTH paths, so the corpus asserts the doorbell RANG rather than asserting that code which would ring it exists -- the distinction the module header argues is the difference between a working machine and one that overheats. Synthetic mode records the write in the adversary's descriptor instead of touching a port; hardware mode does a 16-bit read-modify-write through aml_region_port_in/out, ORing GBL_RLS (0x0004) and masking SLP_EN (0x2000) out of the value written back. The mask is redundant on every part whose PM1_CNT reads SLP_EN back as 0, which is the argument FOR it: one instruction against a machine suspending mid-EC-transaction. r12 holds the state pointer and r13 the port across the two nested calls; two pushes plus the frame leave rsp%16 == 0 at each. Labels prefixed aml_glksi_ per reserved-label discipline.",
      block: {
        push r12;
        push r13;
        lea r12, [rip + aml_glk_state];

        mov rax, [r12 + 88];
        add rax, 1;
        mov [r12 + 88], rax;             // signals -- counted in both modes

        mov rax, [r12 + 0];
        cmp rax, 1;                      // AML_GLK_MODE_SYNTH
        jne aml_glksi_hw;

        lea rcx, [rip + aml_glk_smm];
        mov rax, [rcx + 56];
        add rax, 1;
        mov [rcx + 56], rax;             // the synth PM1_CNT heard it
        xor rax, rax;
        mov [rcx + 40], rax;             // the wait is over; clear the signal
        mov rax, 1;
        jmp aml_glksi_out;

      aml_glksi_hw:
        mov r13, [r12 + 16];             // PM1_CNT port
        cmp r13, 0;
        je aml_glksi_no;

        mov rdi, r13;
        mov rsi, 2;
        call aml_region_port_in;         // READ, never a bare store
        or rax, 0x0004;                  // AML_GLK_GBL_RLS
        and rax, 0xDFFF;                 // mask SLP_EN (0x2000) back out
        mov rdx, rax;
        mov rdi, r13;
        mov rsi, 2;
        call aml_region_port_out;
        mov rax, 1;
        jmp aml_glksi_out;

      aml_glksi_no:
        xor rax, rax;

      aml_glksi_out:
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // aml_glk_try() -> 1 acquired | 0 pending | AML_GLK_TRY_STUCK
  //
  // ONE FULL COMPARE-EXCHANGE ACQUIRE. This is the protocol, and it is
  // deliberately a separate function from aml_glk_enter so that the
  // corpus can drive the interleavings directly rather than only
  // through the nesting and waiting that wrap it.
  //
  // Returns 1 if this call took the lock, 0 if firmware holds it and our
  // interest has been registered (Pending is now set, so the release
  // will ring our doorbell), and AML_GLK_TRY_STUCK if the compare-
  // exchange lost its race AML_GLK_CAS_MAX times.
  // ==========================================================================

  pub let AML_GLK_TRY_STUCK : u64 = 0xFFFFFFFFFFFFFFFF

  pub let aml_glk_try : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M8-001 (#1082): one ACPI 6.5 §5.2.10.1 acquire. Read the 32-bit lock word; new = old | 1 (the specification's `(old & ~1) | 1`); if old carried Owned, also set Pending, which is what makes the eventual release ring our doorbell. Call the injection point. Then lock_cmpxchg_d -- THE 32-BIT FORM, because a 64-bit compare-exchange at FACS+0x10 would read-modify-write the Flags word at +0x14 as well. ZF discriminates: taken, or lost the race and rax now holds the observed value, in which case bump the retry count and go round. ACQUIRED IFF THE VALUE WE WROTE HAS PENDING CLEAR -- a successful compare-exchange is not a successful acquire, and conflating the two is the defect that transacts against the EC while SMM is mid-transaction on it. r12=state, r13=FACS, r14=old, r15=new; four pushes plus the frame leave rsp%16 == 0 at the nested call, and all four survive it because they are callee-saved -- rax and rcx are reloaded from r14/r15 after the call precisely because they are not. The compare-exchange's memory base is r13, never rax: rax is lock_cmpxchg's implicit operand and using it as the base trips paideia-as U1613. Labels prefixed aml_glkt_ per reserved-label discipline.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;

        lea r12, [rip + aml_glk_state];
        mov rax, [r12 + 32];
        cmp rax, 0;
        je aml_glkt_unbound;
        mov r13, [r12 + 8];              // the FACS host VA

        xor r11, r11;                    // retry budget

      aml_glkt_retry:
        xor rax, rax;
        mov eax, [r13 + 16];             // old = *GL   (32-bit, zero-extended)
        mov r14, rax;
        mov r15, rax;
        or r15, 1;                       // new = (old & ~1) | 1

        mov rax, r14;
        and rax, 1;                      // did somebody already own it?
        cmp rax, 0;
        je aml_glkt_nopend;
        or r15, 2;                       // then register our interest

      aml_glkt_nopend:
        // ---- THE INJECTION POINT: an SMI lands HERE or nowhere ----
        push r11;
        sub rsp, 8;
        call aml_glk_smm_step;
        add rsp, 8;
        pop r11;

        mov rax, r14;                    // expected -> RAX (implicit operand)
        mov rcx, r15;                    // new      -> register operand
        lock_cmpxchg_d [r13 + 16], rcx;
        je aml_glkt_took;

        // Lost the race: firmware wrote between our read and our write.
        // rax holds what it wrote. Count it and re-derive from the truth.
        mov rax, [r12 + 80];
        add rax, 1;
        mov [r12 + 80], rax;             // CAS retries
        add r11, 1;
        cmp r11, 1024;                   // AML_GLK_CAS_MAX
        jae aml_glkt_stuck;
        jmp aml_glkt_retry;

      aml_glkt_took:
        mov rax, [r12 + 176];
        add rax, 1;
        mov [r12 + 176], rax;            // successful compare-exchanges

        mov rax, r15;
        and rax, 2;
        cmp rax, 0;
        jne aml_glkt_pending;
        mov rax, 1;                      // ACQUIRED
        jmp aml_glkt_out;

      aml_glkt_pending:
        mov rax, [r12 + 112];
        add rax, 1;
        mov [r12 + 112], rax;            // pending observations
        xor rax, rax;                    // wrote successfully, did NOT acquire
        jmp aml_glkt_out;

      aml_glkt_stuck:
        mov rax, [r12 + 144];
        add rax, 1;
        mov [r12 + 144], rax;
        mov rax, 80;                     // AML_ERR_GLK_CAS_STUCK
        mov [r12 + 152], rax;
        mov rdi, rax;
        call aml_eval_set_err;
        mov rax, 0xFFFFFFFFFFFFFFFF;     // AML_GLK_TRY_STUCK
        jmp aml_glkt_out;

      aml_glkt_unbound:
        mov rax, [r12 + 120];
        add rax, 1;
        mov [r12 + 120], rax;
        mov rax, 76;                     // AML_ERR_GLK_UNBOUND
        mov [r12 + 152], rax;
        mov rdi, rax;
        call aml_eval_set_err;
        mov rax, 0xFFFFFFFFFFFFFFFF;

      aml_glkt_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // aml_glk_enter() -> 1 held | 0 refused
  //
  // THE ACQUIRE THE EC PATH CALLS. Ownership-counted: the hardware lock
  // is taken at 0->1 only.
  // ==========================================================================

  pub let aml_glk_enter : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M8-001 (#1082): acquire the Global Lock, counting ownership. At depth > 0 this increments and returns 1 HAVING TOUCHED NO HARDWARE -- AML acquires \\_GL recursively and the hardware lock must be held once, not re-taken. At depth 0 it runs aml_glk_try; on 0 (firmware holds it) it waits for the RELEASE SIGNAL, bounded by AML_GLK_WAIT_MAX, and retries; exhaustion latches AML_ERR_GLK_TIMEOUT (77) and REFUSES rather than waiting longer, because firmware that never releases must produce a bug report and not a hang. The depth bound is checked before the increment, not after, so an overflow can never be committed and then noticed. The wait polls aml_glk_signalled(), never the lock word -- see that function for why the distinction is real. r12=state, r13=poll counter; two pushes plus the frame leave rsp%16 == 0 at every nested call. Labels prefixed aml_glke_ per reserved-label discipline.",
      block: {
        push r12;
        push r13;

        lea r12, [rip + aml_glk_state];
        mov rax, [r12 + 160];
        add rax, 1;
        mov [r12 + 160], rax;            // enter calls

        mov rax, [r12 + 32];
        cmp rax, 0;
        je aml_glke_unbound;

        // ---- the nesting arm: no hardware, ever ----
        mov rax, [r12 + 40];
        cmp rax, 0;
        je aml_glke_take;

        cmp rax, 32;                     // AML_GLK_DEPTH_MAX
        jae aml_glke_toodeep;
        add rax, 1;
        mov [r12 + 40], rax;
        mov rcx, [r12 + 184];
        cmp rax, rcx;
        jbe aml_glke_nest_done;
        mov [r12 + 184], rax;            // deepest depth reached
      aml_glke_nest_done:
        mov rax, [r12 + 64];
        add rax, 1;
        mov [r12 + 64], rax;             // nested enters
        mov rax, 1;
        jmp aml_glke_out;

        // ---- the hardware arm ----
      aml_glke_take:
        xor r13, r13;
        mov [r12 + 96], r13;             // polls on THIS wait

      aml_glke_attempt:
        call aml_glk_try;
        cmp rax, 1;
        je aml_glke_got;
        cmp rax, 0;
        jne aml_glke_failed;             // AML_GLK_TRY_STUCK: already latched

        // Firmware holds it and Pending is now set, so its release will
        // ring our doorbell. Wait for THAT, not for the word.
      aml_glke_wait:
        add r13, 1;
        mov [r12 + 96], r13;
        cmp r13, 20000;                  // AML_GLK_WAIT_MAX
        jae aml_glke_timeout;
        call aml_glk_signalled;
        cmp rax, 0;
        je aml_glke_wait;
        jmp aml_glke_attempt;

      aml_glke_got:
        mov rax, 1;
        mov [r12 + 40], rax;             // depth 0 -> 1
        mov rcx, [r12 + 184];
        cmp rax, rcx;
        jbe aml_glke_got_done;
        mov [r12 + 184], rax;
      aml_glke_got_done:
        mov rax, [r12 + 48];
        add rax, 1;
        mov [r12 + 48], rax;             // hardware acquires
        mov rax, 1;
        jmp aml_glke_out;

      aml_glke_timeout:
        mov rax, [r12 + 104];
        add rax, 1;
        mov [r12 + 104], rax;
        mov rax, 77;                     // AML_ERR_GLK_TIMEOUT
        mov [r12 + 152], rax;
        mov rdi, rax;
        call aml_eval_set_err;
        xor rax, rax;
        jmp aml_glke_out;

      aml_glke_toodeep:
        mov rax, [r12 + 136];
        add rax, 1;
        mov [r12 + 136], rax;
        mov rax, 79;                     // AML_ERR_GLK_DEPTH
        mov [r12 + 152], rax;
        mov rdi, rax;
        call aml_eval_set_err;
        xor rax, rax;
        jmp aml_glke_out;

      aml_glke_unbound:
        mov rax, [r12 + 120];
        add rax, 1;
        mov [r12 + 120], rax;
        mov rax, 76;                     // AML_ERR_GLK_UNBOUND
        mov [r12 + 152], rax;
        mov rdi, rax;
        call aml_eval_set_err;
        xor rax, rax;
        jmp aml_glke_out;

      aml_glke_failed:
        xor rax, rax;

      aml_glke_out:
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // aml_glk_leave() -> 1 released | 0 refused
  //
  // THE RELEASE THE EC PATH CALLS. The hardware lock is dropped at
  // 1->0 only, and the doorbell rings iff the value we replaced carried
  // Pending.
  // ==========================================================================

  pub let aml_glk_leave : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M8-001 (#1082): release the Global Lock, counting ownership. At depth > 1 this decrements and returns HAVING TOUCHED NO HARDWARE: an inner release that dropped the hardware lock would hand the EC to firmware in the middle of the outer transaction, and the outer caller would go on driving registers it no longer owned. At depth 1 it runs the §5.2.10.1 release loop -- new = old & ~3, cleared with two shifts rather than an `and` against a 32-bit mask whose sign-extension would have to be argued -- and then, IFF THE OLD VALUE CARRIED PENDING, rings the doorbell. Omitting that signal is the failure this module is built against: nothing here breaks, and the firmware waits forever for a lock it was promised. Depth 0 is AML_ERR_GLK_UNDERFLOW (78) and NOT a silent no-op, because a release with nothing outstanding means a caller's bracketing is broken and the next hardware release would be somebody else's. r12=state, r13=FACS, r14=old, r15=new. Labels prefixed aml_glkl_ per reserved-label discipline.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;

        lea r12, [rip + aml_glk_state];
        mov rax, [r12 + 168];
        add rax, 1;
        mov [r12 + 168], rax;            // leave calls

        mov rax, [r12 + 32];
        cmp rax, 0;
        je aml_glkl_unbound;

        mov rax, [r12 + 40];
        cmp rax, 0;
        je aml_glkl_underflow;
        cmp rax, 1;
        je aml_glkl_drop;

        // ---- the nesting arm: no hardware, ever ----
        sub rax, 1;
        mov [r12 + 40], rax;
        mov rax, [r12 + 72];
        add rax, 1;
        mov [r12 + 72], rax;             // nested leaves
        mov rax, 1;
        jmp aml_glkl_out;

        // ---- the hardware arm ----
      aml_glkl_drop:
        mov r13, [r12 + 8];
        xor r11, r11;

      aml_glkl_retry:
        xor rax, rax;
        mov eax, [r13 + 16];             // old = *GL
        mov r14, rax;
        mov r15, rax;
        shr r15, 2;
        shl r15, 2;                      // new = old & ~3, both bits at once

        push r11;
        sub rsp, 8;
        call aml_glk_smm_step;           // the same injection point
        add rsp, 8;
        pop r11;

        mov rax, r14;
        mov rcx, r15;
        lock_cmpxchg_d [r13 + 16], rcx;
        je aml_glkl_dropped;

        mov rax, [r12 + 80];
        add rax, 1;
        mov [r12 + 80], rax;             // CAS retries
        add r11, 1;
        cmp r11, 1024;                   // AML_GLK_CAS_MAX
        jae aml_glkl_stuck;
        jmp aml_glkl_retry;

      aml_glkl_dropped:
        mov rax, [r12 + 176];
        add rax, 1;
        mov [r12 + 176], rax;            // successful compare-exchanges

        xor rax, rax;
        mov [r12 + 40], rax;             // depth 1 -> 0
        mov rax, [r12 + 56];
        add rax, 1;
        mov [r12 + 56], rax;             // hardware releases

        // ---- THE DOORBELL ----
        mov rax, r14;
        and rax, 2;                      // did the value we replaced pend?
        cmp rax, 0;
        je aml_glkl_quiet;
        call aml_glk_signal;

      aml_glkl_quiet:
        mov rax, 1;
        jmp aml_glkl_out;

      aml_glkl_stuck:
        mov rax, [r12 + 144];
        add rax, 1;
        mov [r12 + 144], rax;
        mov rax, 80;                     // AML_ERR_GLK_CAS_STUCK
        mov [r12 + 152], rax;
        mov rdi, rax;
        call aml_eval_set_err;
        xor rax, rax;
        jmp aml_glkl_out;

      aml_glkl_underflow:
        mov rax, [r12 + 128];
        add rax, 1;
        mov [r12 + 128], rax;
        mov rax, 78;                     // AML_ERR_GLK_UNDERFLOW
        mov [r12 + 152], rax;
        mov rdi, rax;
        call aml_eval_set_err;
        xor rax, rax;
        jmp aml_glkl_out;

      aml_glkl_unbound:
        mov rax, [r12 + 120];
        add rax, 1;
        mov [r12 + 120], rax;
        mov rax, 76;                     // AML_ERR_GLK_UNBOUND
        mov [r12 + 152], rax;
        mov rdi, rax;
        call aml_eval_set_err;
        xor rax, rax;

      aml_glkl_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let aml_glk_depth : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M8-001 (#1082): the current ownership count. The invariant every fixture checks on exit is that this is 0 -- a non-zero depth after a completed episode is a leaked hardware lock, which on a real machine is firmware locked out of the EC until reboot. Leaf load. Reserved labels: none.",
      block: {
        lea rcx, [rip + aml_glk_state];
        mov rax, [rcx + 40];
        ret
      }
    } @no_frame
}
