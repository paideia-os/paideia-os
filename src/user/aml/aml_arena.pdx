// src/user/aml/aml_arena.pdx — R30.M1-002 (#1050)
//
// Flat, index-addressed AST arena for the AML parser.
//
// PLACEMENT — CONSTITUTIONAL
// -------------------------
// Userspace only. See design/acpi/no-aml-in-kernel.md and the header of
// src/user/aml/aml_lex.pdx.
//
// WHY AN ARENA OF INDICES AND NOT A TREE OF POINTERS
// --------------------------------------------------
// The acpi_supervisor process parses AML on one side of an IPC boundary
// and serves namespace queries to clients on the other (see
// design/ipc/userspace-server-substrate.md and
// design/acpi/acpica-bubble.md). A pointer-linked tree cannot cross that
// boundary: the receiver maps the payload at a different virtual address,
// so every pointer in it is garbage. Three properties follow, and they
// are the whole reason this file exists:
//
//   1. NO POINTERS ANYWHERE. Every reference between arena records is a
//      small integer index into a named array. A record is meaningful
//      wherever the array is mapped.
//   2. FIXED-STRIDE RECORDS. A node is exactly 32 bytes, four u64 words.
//      A consumer needs no allocator, no relocation pass, and no schema
//      negotiation to walk it — index i lives at base + i*32, always.
//   3. THE ARRAYS ARE THE WIRE FORMAT. Handing the namespace to another
//      process is a memcpy of three contiguous arrays plus three counts.
//      There is no serialise step to get wrong.
//
// Index 0 is the reserved null sentinel in all three arenas. Allocation
// starts at 1, so "0" unambiguously means absent — no child, no sibling,
// no name — without a separate presence bit.
//
// NODE RECORD — 4 x u64, 32 bytes
// -------------------------------
//   word0  [15:0]  kind          AML_NODE_* (see the table below)
//          [31:16] flags         kind-specific semantic flags
//          [63:32] name_ref      index into aml_name_arena (0 = unnamed)
//   word1  [31:0]  first_child   node index (0 = leaf)
//          [63:32] next_sibling  node index (0 = last)
//   word2  [31:0]  parent        node index (0 = root's parent)
//          [63:32] src_off       byte offset of this node's OPCODE within
//                                the AML buffer
//   word3  [31:0]  arg0          kind-specific
//          [63:32] arg1          kind-specific
//
// src_off is what keeps the record narrow. Fixed scalar operands that do
// not drive structure (Processor's PblkAddr, PowerResource's
// ResourceOrder, the raw bytes of a Buffer initialiser) are NOT copied
// into the node; they remain recoverable from the source buffer at
// src_off. Anything that DOES drive structure or semantics — a Method's
// flags byte, a Field's access rules, a field element's bit offset and
// width — is stored, because a consumer must not have to re-parse to act
// correctly.
//
// When a construct carries more than the record holds, the answer is
// ANOTHER NODE, never a wider record. IndexField and BankField each name
// two objects; the second name becomes an AML_NODE_FIELD_LINK child.
// That keeps the stride fixed and keeps #1051/#1052 from being tempted to
// grow word3 into a union.
//
// NODE KINDS
// ----------
//    1 ROOT            synthetic; arg0=0, arg1=buffer length
//    2 SCOPE           arg0=TermList start, arg1=package end
//    3 DEVICE          as SCOPE
//    4 METHOD          flags=MethodFlags byte; arg0=body start, arg1=body end
//    5 NAME            flags=data kind (1 int, 2 string, 3 buffer,
//                      4 package, 5 var-package);
//                      int: arg0=aml_u64_arena index, arg1=0
//                      other: arg0=payload start, arg1=payload end
//    6 ALIAS           name_ref=alias name; arg0=source name_ref
//    7 PROCESSOR       flags=ProcID; arg0=TermList start, arg1=package end
//    8 POWERRES        flags=SystemLevel; arg0/arg1 as PROCESSOR
//    9 THERMALZONE     as SCOPE
//   10 OPREGION        flags=RegionSpace; arg0=u64 index of offset,
//                      arg1=u64 index of length
//   11 FIELD           flags=FieldFlags byte; arg0=FieldList start,
//                      arg1=package end
//   12 INDEXFIELD      as FIELD; first child is a FIELD_LINK naming the
//                      data object
//   13 BANKFIELD       as FIELD; first child is a FIELD_LINK naming the
//                      bank object, with arg0 = u64 index of BankValue
//   14 FIELD_ELEM      named field element; flags[7:0]=effective field
//                      flags, flags[15:8]=access attribute;
//                      arg0=bit offset, arg1=bit width
//   15 EXTERNAL        flags[7:0]=ObjectType, flags[15:8]=ArgumentCount
//   16 OPAQUE          a PkgLength-bearing opcode not parsed at this
//                      milestone; arg0=body start, arg1=package end.
//                      The opcode itself is at src_off.
//   17 MUTEX           flags=SyncFlags
//   18 EVENT           no payload
//   19 FIELD_LINK      second NameString of INDEXFIELD / BANKFIELD
//   20 FIELD_ACCESS    AccessField / ExtendedAccessField;
//                      flags[7:0]=the new EFFECTIVE field-flags byte (the
//                      AccessType nibble replaced, LockRule and
//                      UpdateRule inherited from the enclosing
//                      FieldFlags), flags[15:8]=AccessAttrib,
//                      arg0=AccessLength (0 for the short form).
//                      Stored in the same layout as FIELD_ELEM's flags so
//                      the two compare directly.
//   21 FIELD_RESERVED  ReservedField; arg0=bit offset, arg1=bit width
//   22 FIELD_CONNECT   ConnectField; name_ref set for the NameString form,
//                      arg0/arg1 = buffer extent for the BufferData form
//
// NAME ARENA
// ----------
// A u32 array. Entry `ref` is a header word followed by SegCount NameSeg
// words:
//
//   [ref]            [7:0] SegCount, [15:8] ParentPrefix ('^') count,
//                    [16] RootChar ('\') flag
//   [ref+1 .. +Seg]  NameSeg, four ASCII characters packed little-endian
//                    (first character in bits [7:0])
//
// NameSegs are stored in ACPICA's packed order so a comparison against a
// literal such as '_HID' is one integer compare, not a string walk.
//
// U64 ARENA
// ---------
// Side table for values that genuinely need 64 bits — OpRegion offsets and
// lengths, Name integer values, BankField bank values. Nodes reference
// them by index, preserving property 1.
//
// CAPACITIES
// ----------
// 512 nodes / 512 name words / 128 u64 slots. These are R30.M1 fixture
// scale, not shipping scale; a full DSDT needs roughly two orders of
// magnitude more, which is a .bss sizing change and nothing else.
// Exhaustion is a clean latched error (AML_ERR_NODE_ARENA_FULL 9,
// AML_ERR_NAME_ARENA_FULL 8, AML_ERR_U64_ARENA_FULL 16), never a wrap and
// never an overwrite — the corpus proves this with a fixture that
// deliberately exhausts the node arena.
//
// SIDE TABLE
// ----------
// aml_node_last is a build-time-only accelerator holding, per node, the
// index of its most recently appended child, so appending is O(1) instead
// of walking the sibling chain. It is NOT part of the exported
// representation and is NOT transferred over IPC — the sibling chain in
// word1 is authoritative.

module AmlArena = structure {

  // ==========================================================================
  // Arena storage. 512 nodes x 4 words = 2048 u64 = 16 KiB.
  // ==========================================================================
  pub let mut aml_node_arena  : [u64; 2048] = uninit @align(8)
  pub let mut aml_name_arena  : [u32; 512]  = uninit @align(4)
  pub let mut aml_u64_arena   : [u64; 128]  = uninit @align(8)
  pub let mut aml_node_last   : [u32; 512]  = uninit @align(4)

  // [0] node_next   [1] name_next   [2] u64_next   [3..7] reserved
  pub let mut aml_arena_state : [u64; 8] = uninit @align(8)

  // ==========================================================================
  // aml_arena_reset() — return all three arenas to the empty state.
  // ==========================================================================
  pub let aml_arena_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-002 (#1050): reset the arenas. All three next-free cursors go to 1, not 0, because index 0 is the reserved null sentinel in every arena — that is what lets 'no child', 'no sibling' and 'no name' all be the literal zero without a separate presence bit. Zeroes the three sentinel slots as well so a consumer that dereferences index 0 defensively reads zeroes rather than stale data from a previous parse. Note aml_node_last is deliberately NOT bulk-cleared: aml_node_alloc initialises each entry as it hands the index out, so no entry is ever read before it is written, and bulk-clearing 512 entries on every reset would be work for no invariant. Reserved labels: none.",
      block: {
        lea rcx, [rip + aml_arena_state];
        mov rax, 1;
        mov [rcx + 0], rax;              // node_next
        mov [rcx + 8], rax;              // name_next
        mov [rcx + 16], rax;             // u64_next
        xor rax, rax;
        mov [rcx + 24], rax;
        mov [rcx + 32], rax;
        mov [rcx + 40], rax;
        mov [rcx + 48], rax;
        mov [rcx + 56], rax;
        lea rcx, [rip + aml_node_arena];
        mov [rcx + 0], rax;              // node[0] sentinel
        mov [rcx + 8], rax;
        mov [rcx + 16], rax;
        mov [rcx + 24], rax;
        lea rcx, [rip + aml_name_arena];
        mov_d [rcx + 0], rax;            // name[0] sentinel
        lea rcx, [rip + aml_u64_arena];
        mov [rcx + 0], rax;              // u64[0] sentinel
        lea rcx, [rip + aml_node_last];
        mov_d [rcx + 0], rax;
        ret
      }
    } @no_frame

  pub let aml_node_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-002 (#1050): return the node next-free cursor. Because allocation starts at 1, this doubles as 'one past the highest valid node index', which is the form a consumer walking the arena linearly wants. Leaf accessor. Reserved labels: none.",
      block: {
        lea rcx, [rip + aml_arena_state];
        mov rax, [rcx + 0];
        ret
      }
    } @no_frame

  pub let aml_name_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-002 (#1050): return the name-arena next-free u32 cursor — one past the last word in use. Leaf accessor. Reserved labels: none.",
      block: {
        lea rcx, [rip + aml_arena_state];
        mov rax, [rcx + 8];
        ret
      }
    } @no_frame

  pub let aml_u64_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-002 (#1050): return the u64-side-table next-free cursor. Leaf accessor. Reserved labels: none.",
      block: {
        lea rcx, [rip + aml_arena_state];
        mov rax, [rcx + 16];
        ret
      }
    } @no_frame

  // ==========================================================================
  // aml_node_alloc(kind, name_ref, parent, src_off) -> index
  //
  // Allocates a node and appends it to `parent`'s child list. Returns 0
  // (with AML_ERR_NODE_ARENA_FULL latched) when the arena is exhausted.
  // ==========================================================================
  pub let aml_node_alloc : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (kind: u64) (name_ref: u64) (parent: u64) (src_off: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-002 (#1050): allocate one 32-byte node and splice it onto the end of parent's child list. rdi=kind, rsi=name_ref, rdx=parent, rcx=src_off. Steps: (1) bounds-check node_next against the 512-node capacity and latch AML_ERR_NODE_ARENA_FULL (9) on exhaustion — the arena refuses rather than wrapping, so a hostile table can waste memory but never corrupt an already-built subtree; (2) compute the record address as base + idx*32 via shl 5, since x86 addressing tops out at scale 8 and a 32-byte stride needs an explicit shift; (3) pack word0 = kind | (0 flags) | name_ref<<32 and word2 = parent | src_off<<32, masking the low halves through a REGISTER holding 0xFFFFFFFF rather than an immediate, because AND r64,imm32 sign-extends and an immediate 0xFFFFFFFF would be a no-op mask; (4) append via aml_node_last[parent] in O(1) — empty list writes parent.word1 low half, otherwise the previous sibling's word1 high half; (5) initialise aml_node_last[idx]=0 so the new node's own list starts empty and no entry is ever read before being written. Locals: r12 becomes the new index after word0 is packed, r13=name_ref, r14=parent, r15=src_off. Reserved labels: aml_na_.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;
        mov r12, rdi;                    // kind
        mov r13, rsi;                    // name_ref
        mov r14, rdx;                    // parent
        mov r15, rcx;                    // src_off
        lea rcx, [rip + aml_arena_state];
        mov rax, [rcx + 0];              // node_next
        cmp rax, 512;
        jae aml_na_full;
        mov rdx, rax;
        add rdx, 1;
        mov [rcx + 0], rdx;              // bump
        push rax;                        // stash idx
        mov r8, rax;
        shl r8, 5;                       // idx * 32
        lea rcx, [rip + aml_node_arena];
        add r8, rcx;                     // &node[idx]
        // word0 = kind | (flags=0 << 16) | (name_ref << 32)
        mov rdx, r13;
        shl rdx, 32;
        mov rcx, r12;
        and rcx, 0xFFFF;
        or rdx, rcx;
        mov [r8 + 0], rdx;
        // word1 = 0 (no children, no sibling)
        xor rdx, rdx;
        mov [r8 + 8], rdx;
        // word2 = parent | (src_off << 32)
        mov rdx, r15;
        shl rdx, 32;
        mov rcx, 0xFFFFFFFF;
        mov r9, r14;
        and r9, rcx;
        or rdx, r9;
        mov [r8 + 16], rdx;
        // word3 = 0
        xor rdx, rdx;
        mov [r8 + 24], rdx;
        pop r12;                         // r12 = idx from here on
        // clear this node's own last-child accelerator
        lea rcx, [rip + aml_node_last];
        xor rdx, rdx;
        mov_d [rcx + r12*4], rdx;
        // append to parent's child list
        cmp r14, 0;
        je aml_na_done;
        lea rcx, [rip + aml_node_last];
        xor rdx, rdx;
        mov_d rdx, [rcx + r14*4];        // previous last child
        cmp rdx, 0;
        jne aml_na_append;
        // first child: set parent.word1 low half
        mov r9, r14;
        shl r9, 5;
        lea rcx, [rip + aml_node_arena];
        add r9, rcx;
        mov r10, [r9 + 8];
        shr r10, 32;
        shl r10, 32;                     // keep next_sibling, clear first_child
        or r10, r12;
        mov [r9 + 8], r10;
        jmp aml_na_setlast;
      aml_na_append:
        // previous sibling: set its word1 high half
        mov r9, rdx;
        shl r9, 5;
        lea rcx, [rip + aml_node_arena];
        add r9, rcx;
        mov r10, [r9 + 8];
        mov rcx, 0xFFFFFFFF;
        and r10, rcx;                    // keep first_child, clear next_sibling
        mov rcx, r12;
        shl rcx, 32;
        or r10, rcx;
        mov [r9 + 8], r10;
      aml_na_setlast:
        lea rcx, [rip + aml_node_last];
        mov_d [rcx + r14*4], r12;
      aml_na_done:
        mov rax, r12;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret;
      aml_na_full:
        mov rdi, 9;                      // AML_ERR_NODE_ARENA_FULL
        call aml_lex_set_err;
        xor rax, rax;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Node mutators.
  // ==========================================================================

  pub let aml_node_set_flags : (u64, u64) -> () !{mem} @{} =
    fn (idx: u64) (flags: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-002 (#1050): replace the flags half-word of node idx, preserving kind and name_ref. rdi=idx, rsi=flags. Rebuilds word0 from its parts rather than masking with a 64-bit immediate: kind is recovered with AND 0xFFFF (safe as an immediate because it is below 0x80000000 and therefore sign-extends to itself), name_ref is recovered with a shift-right/shift-left pair, and the new flags are OR'd in at bit 16. Silently ignores an out-of-range index so a caller already unwinding after an arena-full error cannot scribble past the arena. Reserved labels: aml_nsf_.",
      block: {
        cmp rdi, 512;
        jae aml_nsf_out;
        mov r8, rdi;
        shl r8, 5;
        lea rcx, [rip + aml_node_arena];
        add r8, rcx;
        mov rax, [r8];
        mov rdx, rax;
        and rdx, 0xFFFF;                 // kind
        shr rax, 32;
        shl rax, 32;                     // name_ref << 32
        or rax, rdx;
        mov rcx, rsi;
        and rcx, 0xFFFF;
        shl rcx, 16;
        or rax, rcx;
        mov [r8], rax;
      aml_nsf_out:
        ret
      }
    } @no_frame

  pub let aml_node_set_args : (u64, u64, u64) -> () !{mem} @{} =
    fn (idx: u64) (arg0: u64) (arg1: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-002 (#1050): write both kind-specific argument slots of node idx as word3 = arg0 | arg1<<32. rdi=idx, rsi=arg0, rdx=arg1. Written as a single store because the two slots are always set together — every node kind that uses arg0 also defines arg1, even if only as zero, so a partial-update entry point would be an invitation to leave half a record stale. Low half masked through a register-held 0xFFFFFFFF. Out-of-range index is ignored. Reserved labels: aml_nsa_.",
      block: {
        cmp rdi, 512;
        jae aml_nsa_out;
        mov r8, rdi;
        shl r8, 5;
        lea rcx, [rip + aml_node_arena];
        add r8, rcx;
        mov rax, rdx;
        shl rax, 32;
        mov rcx, 0xFFFFFFFF;
        and rsi, rcx;
        or rax, rsi;
        mov [r8 + 24], rax;
      aml_nsa_out:
        ret
      }
    } @no_frame

  pub let aml_node_set_name : (u64, u64) -> () !{mem} @{} =
    fn (idx: u64) (name_ref: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-002 (#1050): replace the name_ref half of word0, preserving kind and flags. rdi=idx, rsi=name_ref. Needed because ALIAS reads its two NameStrings in source order (source first, alias second) while the node's identity is the SECOND of them — the node must exist before the second name is parsed so that a parse failure still leaves a well-formed partial tree. Low 32 bits of word0 preserved through a register-held mask. Out-of-range index ignored. Reserved labels: aml_nsn_.",
      block: {
        cmp rdi, 512;
        jae aml_nsn_out;
        mov r8, rdi;
        shl r8, 5;
        lea rcx, [rip + aml_node_arena];
        add r8, rcx;
        mov rax, [r8];
        mov rcx, 0xFFFFFFFF;
        and rax, rcx;                    // keep kind | flags
        mov rcx, rsi;
        shl rcx, 32;
        or rax, rcx;
        mov [r8], rax;
      aml_nsn_out:
        ret
      }
    } @no_frame

  // ==========================================================================
  // Node accessors. Every one bounds-checks and returns 0 for an
  // out-of-range index: the test harness probes indices freely, and a
  // consumer walking a partially-built tree after an error must not be able
  // to read past the arena.
  // ==========================================================================

  pub let aml_node_kind : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-002 (#1050): return word0[15:0] of node idx, the AML_NODE_* discriminant. Bounds-checked; 0 for an out-of-range index, which is also the sentinel node's kind, so 'invalid' and 'null node' read alike and neither is mistaken for a real node. Reserved labels: aml_nk_.",
      block: {
        cmp rdi, 512;
        jae aml_nk_out;
        mov r8, rdi;
        shl r8, 5;
        lea rcx, [rip + aml_node_arena];
        add r8, rcx;
        mov rax, [r8];
        and rax, 0xFFFF;
        ret;
      aml_nk_out:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let aml_node_flags : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-002 (#1050): return word0[31:16] of node idx — the kind-specific flag word (MethodFlags, FieldFlags, RegionSpace, ObjectType|ArgCount, ...). Bounds-checked. Reserved labels: aml_nf_.",
      block: {
        cmp rdi, 512;
        jae aml_nf_out;
        mov r8, rdi;
        shl r8, 5;
        lea rcx, [rip + aml_node_arena];
        add r8, rcx;
        mov rax, [r8];
        shr rax, 16;
        and rax, 0xFFFF;
        ret;
      aml_nf_out:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let aml_node_name : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-002 (#1050): return word0[63:32] of node idx — the name-arena index, 0 when the node is unnamed. Bounds-checked. Reserved labels: aml_nn_.",
      block: {
        cmp rdi, 512;
        jae aml_nn_out;
        mov r8, rdi;
        shl r8, 5;
        lea rcx, [rip + aml_node_arena];
        add r8, rcx;
        mov rax, [r8];
        shr rax, 32;
        ret;
      aml_nn_out:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let aml_node_first_child : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-002 (#1050): return word1[31:0] of node idx — the first child index, 0 for a leaf. Masked through a register-held 0xFFFFFFFF. Bounds-checked. Reserved labels: aml_nfc_.",
      block: {
        cmp rdi, 512;
        jae aml_nfc_out;
        mov r8, rdi;
        shl r8, 5;
        lea rcx, [rip + aml_node_arena];
        add r8, rcx;
        mov rax, [r8 + 8];
        mov rcx, 0xFFFFFFFF;
        and rax, rcx;
        ret;
      aml_nfc_out:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let aml_node_next_sibling : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-002 (#1050): return word1[63:32] of node idx — the next sibling index, 0 when last in its list. Bounds-checked. Reserved labels: aml_nns_.",
      block: {
        cmp rdi, 512;
        jae aml_nns_out;
        mov r8, rdi;
        shl r8, 5;
        lea rcx, [rip + aml_node_arena];
        add r8, rcx;
        mov rax, [r8 + 8];
        shr rax, 32;
        ret;
      aml_nns_out:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let aml_node_parent : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-002 (#1050): return word2[31:0] of node idx — the parent index, 0 for the root. Masked through a register-held 0xFFFFFFFF. Bounds-checked. Reserved labels: aml_np_.",
      block: {
        cmp rdi, 512;
        jae aml_np_out;
        mov r8, rdi;
        shl r8, 5;
        lea rcx, [rip + aml_node_arena];
        add r8, rcx;
        mov rax, [r8 + 16];
        mov rcx, 0xFFFFFFFF;
        and rax, rcx;
        ret;
      aml_np_out:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let aml_node_src_off : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-002 (#1050): return word2[63:32] of node idx — the byte offset of this node's OPCODE within the AML buffer. This is the field that lets the record stay 32 bytes wide: any fixed scalar operand not stored in the node is recoverable by re-reading from here. Bounds-checked. Reserved labels: aml_nso_.",
      block: {
        cmp rdi, 512;
        jae aml_nso_out;
        mov r8, rdi;
        shl r8, 5;
        lea rcx, [rip + aml_node_arena];
        add r8, rcx;
        mov rax, [r8 + 16];
        shr rax, 32;
        ret;
      aml_nso_out:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let aml_node_arg0 : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-002 (#1050): return word3[31:0] of node idx — the first kind-specific slot. Masked through a register-held 0xFFFFFFFF. Bounds-checked. Reserved labels: aml_na0_.",
      block: {
        cmp rdi, 512;
        jae aml_na0_out;
        mov r8, rdi;
        shl r8, 5;
        lea rcx, [rip + aml_node_arena];
        add r8, rcx;
        mov rax, [r8 + 24];
        mov rcx, 0xFFFFFFFF;
        and rax, rcx;
        ret;
      aml_na0_out:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let aml_node_arg1 : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-002 (#1050): return word3[63:32] of node idx — the second kind-specific slot. Bounds-checked. Reserved labels: aml_na1_.",
      block: {
        cmp rdi, 512;
        jae aml_na1_out;
        mov r8, rdi;
        shl r8, 5;
        lea rcx, [rip + aml_node_arena];
        add r8, rcx;
        mov rax, [r8 + 24];
        shr rax, 32;
        ret;
      aml_na1_out:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let aml_node_last_child : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-003 (#1051): return the index of node idx's most recently appended child, 0 when it has none. This reads the aml_node_last accelerator, which is why the function lives HERE and not in the parser: aml_node_last is private storage confined to this object by tools/verify-aml-parser.sh, and the alternative -- letting aml_term.pdx reach into it -- would break the confinement assertion for the sake of one lookup. Needed because ACPI encodes DefElse as a term that FOLLOWS its DefIfElse in the same TermList, so validating 'this Else has an If' is a preceding-sibling query, and the preceding sibling of the term about to be appended is exactly the parent's current last child. Walking the sibling chain instead would be O(n) per Else on a list the parser is still building. Bounds-checked; 0 for an out-of-range index. Reserved labels: aml_nlc_.",
      block: {
        cmp rdi, 512;
        jae aml_nlc_out;
        lea rcx, [rip + aml_node_last];
        xor rax, rax;
        mov_d rax, [rcx + rdi*4];
        ret;
      aml_nlc_out:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Name arena.
  // ==========================================================================

  pub let aml_name_alloc : (u64) -> u64 !{mem} @{} =
    fn (seg_count: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-002 (#1050): reserve one header word plus seg_count NameSeg words and return the header index. rdi=seg_count. The capacity test is written as next + seg_count + 1 > 512 evaluated in 64-bit arithmetic, so an absurd seg_count taken from a MultiNamePath byte (up to 255) cannot wrap the cursor past the check — the sum is computed at full width before the compare. Latches AML_ERR_NAME_ARENA_FULL (8) and returns 0 on exhaustion, which the caller distinguishes from the legitimate 'no name' index 0 by probing aml_lex_err. Reserved labels: aml_nal_.",
      block: {
        lea rcx, [rip + aml_arena_state];
        mov rax, [rcx + 8];              // name_next
        mov rdx, rax;
        add rdx, rdi;
        add rdx, 1;
        cmp rdx, 512;
        ja aml_nal_full;
        mov [rcx + 8], rdx;
        ret;
      aml_nal_full:
        mov rdi, 8;                      // AML_ERR_NAME_ARENA_FULL
        call aml_lex_set_err;
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let aml_name_set_hdr : (u64, u64, u64, u64) -> () !{mem} @{} =
    fn (ref: u64) (seg_count: u64) (carats: u64) (root: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-002 (#1050): write the name-arena header word for entry ref: [7:0] SegCount, [15:8] ParentPrefixChar count, [16] RootChar flag. rdi=ref, rsi=seg_count, rdx=carats, rcx=root. The fourth argument is copied out of rcx into r8 as the FIRST instruction because rcx is also the natural scratch register for the rip-relative base address, and losing it would silently drop the root-prefix bit — a corruption that would make an absolute path parse as a relative one. Out-of-range ref ignored. Reserved labels: aml_nsh_.",
      block: {
        mov r8, rcx;                     // save root before rcx is reused
        cmp rdi, 512;
        jae aml_nsh_out;
        lea r9, [rip + aml_name_arena];
        mov rax, rsi;
        and rax, 0xFF;                   // SegCount
        mov r10, rdx;
        and r10, 0xFF;
        shl r10, 8;                      // ParentPrefix count
        or rax, r10;
        and r8, 0x01;
        shl r8, 16;                      // RootChar flag
        or rax, r8;
        mov_d [r9 + rdi*4], rax;
      aml_nsh_out:
        ret
      }
    } @no_frame

  pub let aml_name_set_seg : (u64, u64, u64) -> () !{mem} @{} =
    fn (ref: u64) (i: u64) (seg: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-002 (#1050): store NameSeg i of name entry ref at word ref+1+i. rdi=ref, rsi=i, rdx=seg. Recomputes and re-bounds-checks the absolute word index rather than trusting that aml_name_alloc reserved enough, because the segment count driving the loop comes from a firmware byte and the two must be checked against the same capacity independently. Out-of-range write ignored. Reserved labels: aml_nss_.",
      block: {
        mov r8, rdi;
        add r8, rsi;
        add r8, 1;
        cmp r8, 512;
        jae aml_nss_out;
        lea r9, [rip + aml_name_arena];
        mov_d [r9 + r8*4], rdx;
      aml_nss_out:
        ret
      }
    } @no_frame

  pub let aml_name_hdr : (u64) -> u64 !{mem} @{} =
    fn (ref: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-002 (#1050): return the raw header word of name entry ref, zero-extended. Bounds-checked; 0 for an out-of-range ref, which reads as SegCount=0/no prefix and is therefore inert. Uses the xor-then-mov_d zero-extend idiom. Reserved labels: aml_nh_.",
      block: {
        cmp rdi, 512;
        jae aml_nh_out;
        lea r9, [rip + aml_name_arena];
        xor rax, rax;
        mov_d rax, [r9 + rdi*4];
        ret;
      aml_nh_out:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let aml_name_seg : (u64, u64) -> u64 !{mem} @{} =
    fn (ref: u64) (i: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-002 (#1050): return NameSeg i of name entry ref — four ASCII characters packed little-endian, first character in bits [7:0], so a caller compares against a literal such as '_HID' with one integer compare. rdi=ref, rsi=i. Bounds-checked on the absolute word index. Reserved labels: aml_nsg_.",
      block: {
        mov r8, rdi;
        add r8, rsi;
        add r8, 1;
        cmp r8, 512;
        jae aml_nsg_out;
        lea r9, [rip + aml_name_arena];
        xor rax, rax;
        mov_d rax, [r9 + r8*4];
        ret;
      aml_nsg_out:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let aml_name_segcount : (u64) -> u64 !{mem} @{} =
    fn (ref: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-002 (#1050): decode [7:0] of the name header — the number of NameSegs in entry ref. Reserved labels: none.",
      block: {
        call aml_name_hdr;
        and rax, 0xFF;
        ret
      }
    } @no_frame

  pub let aml_name_carats : (u64) -> u64 !{mem} @{} =
    fn (ref: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-002 (#1050): decode [15:8] of the name header — the count of leading ParentPrefixChar '^' characters, i.e. how many namespace levels to ascend before resolving the segments. Reserved labels: none.",
      block: {
        call aml_name_hdr;
        shr rax, 8;
        and rax, 0xFF;
        ret
      }
    } @no_frame

  pub let aml_name_root : (u64) -> u64 !{mem} @{} =
    fn (ref: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-002 (#1050): decode bit 16 of the name header — set when the NameString began with RootChar '\\' and therefore resolves from the namespace root rather than the current scope. Reserved labels: none.",
      block: {
        call aml_name_hdr;
        shr rax, 16;
        and rax, 0x01;
        ret
      }
    } @no_frame

  // ==========================================================================
  // u64 side table.
  // ==========================================================================

  pub let aml_u64_alloc : (u64) -> u64 !{mem} @{} =
    fn (value: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-002 (#1050): append a 64-bit value to the side table and return its index. rdi=value. Exists because OpRegion offsets and lengths, Name integer values and BankField bank values are genuinely 64-bit and will not fit the node's 32-bit argument slots; storing an index instead preserves the no-pointers property that makes the arena IPC-transferable. Latches AML_ERR_U64_ARENA_FULL (16) and returns 0 on exhaustion; index 0 is the reserved sentinel so 0 is never a valid value handle. Reserved labels: aml_ua_.",
      block: {
        lea rcx, [rip + aml_arena_state];
        mov rax, [rcx + 16];             // u64_next
        cmp rax, 128;
        jae aml_ua_full;
        mov rdx, rax;
        add rdx, 1;
        mov [rcx + 16], rdx;
        lea rcx, [rip + aml_u64_arena];
        mov [rcx + rax*8], rdi;
        ret;
      aml_ua_full:
        mov rdi, 16;                     // AML_ERR_U64_ARENA_FULL
        call aml_lex_set_err;
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let aml_u64_get : (u64) -> u64 !{mem} @{} =
    fn (ref: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-002 (#1050): read side-table slot ref. Bounds-checked; 0 for an out-of-range index. Reserved labels: aml_ug_.",
      block: {
        cmp rdi, 128;
        jae aml_ug_out;
        lea rcx, [rip + aml_u64_arena];
        mov rax, [rcx + rdi*8];
        ret;
      aml_ug_out:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Decoders for the flag words whose bit layout is defined by ACPI 6.5
  // §20.2.5.2. These live here rather than in a comment so the semantics
  // are executable and testable, not documentation that can drift.
  // ==========================================================================

  pub let aml_method_argcount : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-002 (#1050): MethodFlags bits [2:0] — the number of arguments the method accepts, 0..7. Reserved labels: none.",
      block: {
        call aml_node_flags;
        and rax, 0x07;
        ret
      }
    } @no_frame

  pub let aml_method_serialized : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-002 (#1050): MethodFlags bit 3 — the SerializeFlag. When set, the interpreter must hold a per-method mutex for the duration of the invocation. Reserved labels: none.",
      block: {
        call aml_node_flags;
        shr rax, 3;
        and rax, 0x01;
        ret
      }
    } @no_frame

  pub let aml_method_synclevel : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-002 (#1050): MethodFlags bits [7:4] — the SyncLevel, 0..15, used to order acquisition of serialized methods and mutexes and so to make deadlock statically avoidable. Reserved labels: none.",
      block: {
        call aml_node_flags;
        shr rax, 4;
        and rax, 0x0F;
        ret
      }
    } @no_frame

  pub let aml_field_access_type : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-002 (#1050): FieldFlags bits [3:0] — AccessType: 0 AnyAcc, 1 ByteAcc, 2 WordAcc, 3 DWordAcc, 4 QWordAcc, 5 BufferAcc. This is the width the interpreter must use for every access to the region, and getting it wrong on an EC or LPSS OpRegion is a hardware-visible fault, not a cosmetic one. Reserved labels: none.",
      block: {
        call aml_node_flags;
        and rax, 0x0F;
        ret
      }
    } @no_frame

  pub let aml_field_lock_rule : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-002 (#1050): FieldFlags bit 4 — LockRule. When set the interpreter must acquire the global ACPI lock (shared with the firmware) around each access. Reserved labels: none.",
      block: {
        call aml_node_flags;
        shr rax, 4;
        and rax, 0x01;
        ret
      }
    } @no_frame

  pub let aml_field_update_rule : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-002 (#1050): FieldFlags bits [6:5] — UpdateRule: 0 Preserve, 1 WriteAsOnes, 2 WriteAsZeros. Governs what happens to the bits of an access unit that the field does not cover during a partial write. Reserved labels: none.",
      block: {
        call aml_node_flags;
        shr rax, 5;
        and rax, 0x03;
        ret
      }
    } @no_frame
}
