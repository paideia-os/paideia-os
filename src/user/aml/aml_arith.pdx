// src/user/aml/aml_arith.pdx — R30.M2-002 (#1055)
//
// AML arithmetic and logical operators, ACPI 6.5 §19.6.
//
// PLACEMENT — CONSTITUTIONAL
// -------------------------
// Userspace only. See design/acpi/no-aml-in-kernel.md.
//
// NO PRIVATE STORAGE
// ------------------
// Like aml_term.pdx and aml_resource.pdx, this module declares no .bss at
// all: the evaluation context, the frame pool and the path buffers all
// live in aml_eval.pdx and are reached through its accessor API. Adding
// this module to the MODULES list in tools/verify-aml-parser.sh therefore
// costs no new assertion and makes the existing ones strictly stronger —
// they now also prove that the operator implementations cannot reach the
// lexer cursor, the arenas, the opcode table or the evaluation state
// directly. A module that needs storage must extend the script; a module
// that needs none strengthens it for free.
//
// =====================================================================
// WHAT THIS MODULE OWNS
// =====================================================================
// Twenty-four opcodes, in five shapes:
//
//   binary with an optional Target   Add 0x72, Subtract 0x74,
//                                    Multiply 0x77, Mod 0x85,
//                                    ShiftLeft 0x79, ShiftRight 0x7A,
//                                    And 0x7B, Nand 0x7C, Or 0x7D,
//                                    Nor 0x7E, Xor 0x7F
//   unary with an optional Target    Not 0x80, FindSetLeftBit 0x81,
//                                    FindSetRightBit 0x82
//   read-modify-write                Increment 0x75, Decrement 0x76
//   two destinations                 Divide 0x78
//   logical, no Target               LAnd 0x90, LOr 0x91, LNot 0x92,
//                                    LEqual 0x93, LGreater 0x94,
//                                    LLess 0x95
//
// Any other op16 is AML_ERR_NOT_EVALUABLE (35): Store, Index, DerefOf,
// Concat, SizeOf, ToBuffer and the rest belong to #1056 and #1057, and
// they are refused rather than approximated.
//
// LGreaterEqual, LLessEqual AND LNotEqual HAVE NO OPCODES
// -------------------------------------------------------
// ASL spells them, AML does not encode them. §19.6.66/68/70 define them
// as the negations of their duals, and iasl emits exactly that:
//
//   LGreaterEqual(a,b)  ->  LNot(LLess(a,b))       0x92 0x95 a b
//   LLessEqual(a,b)     ->  LNot(LGreater(a,b))    0x92 0x94 a b
//   LNotEqual(a,b)      ->  LNot(LEqual(a,b))      0x92 0x93 a b
//
// So they need no implementation and get none — they fall out of LNot
// composed with the three that do exist. The corpus asserts them against
// the real iasl byte encoding rather than against an invented opcode,
// which is the only way that assertion means anything.
//
// =====================================================================
// THE THREE THINGS THAT ARE EASY TO GET WRONG
// =====================================================================
//
// 1. SHIFT COUNTS AT OR ABOVE THE INTEGER WIDTH.
//    ACPI: all bits shifted out, result Zero. x86: the shift count is
//    MASKED to 6 bits (or 5 in 32-bit operand size), so a bare
//    `shl rax, cl` computes ShiftLeft(One, 64) as One. That is a silent
//    wrong answer in a construct real firmware writes when it builds a
//    mask from a computed width. The count is therefore compared against
//    aml_eval_width FIRST and the zero result produced explicitly.
//
// 2. DIVIDE BY ZERO.
//    x86 `div` with a zero divisor raises #DE, which in a userspace
//    process is SIGFPE — firmware bytecode would be able to kill the
//    acpi_supervisor process. Both Divide and Mod test the divisor
//    BEFORE the div executes and latch AML_ERR_DIVIDE_BY_ZERO (34).
//    Divide also has TWO destinations, Remainder then Quotient
//    (§19.6.34), in that order, and returns the quotient.
//
// 3. COMPARISONS ARE UNSIGNED.
//    AML integers are unsigned (§19.6). LGreater and LLess use ja/jb,
//    not jg/jl. Signed compares would make 0xFFFFFFFFFFFFFFFF — which is
//    Ones, the value every logical operator returns for TRUE — compare
//    as less than Zero, and a `While(LLess(Local0, Ones))` would exit
//    immediately.
//
// INTEGER WIDTH
// -------------
// Not handled here, and that is the design. Every operand arrives
// through aml_eval_node, which truncates; every result leaves through
// aml_eval_trunc before it is stored or returned. So a revision-1 table
// gets 32-bit semantics without a single width test in any of the
// twenty-four operator bodies — except the two shifts, which need the
// width as a VALUE rather than as a mask, and get it from
// aml_eval_width. One choke point plus one deliberate exception, not
// twenty-four opportunities to forget.
//
// TARGETS
// -------
// Most of these operators take an optional Target. Storing into one is
// aml_eval_store, in aml_eval.pdx, which handles exactly four
// destinations: the `Zero` null target (discard), LocalX, ArgX, and a
// NAMEREF that resolves to an integer-valued Name object. That is the
// boundary with #1057: a Target that is an Index(), a field element, or
// a reference of any other kind is AML_ERR_BAD_TARGET (41) here and gets
// its real implementation with the rest of the reference machinery. The
// boundary is drawn at "does this destination need a reference object to
// describe it" — if it does, it is #1057's.

module AmlArith = structure {

  // ==========================================================================
  // aml_arith_child(node, n) -> the n-th child of node, or 0.
  // ==========================================================================
  pub let aml_arith_child : (u64, u64) -> u64 !{mem} @{} =
    fn (node: u64) (n: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M2-002 (#1055): return child rsi of node rdi, 0 when there are fewer. Operand order in an EXPR node is the order the R30.M1 term parser appended them, which is the order they appear in the byte stream, which is the order ACPI 6.5 §19.6 specifies -- so 'operand k' is 'child k' with no remapping table to get out of step with the grammar. Returning 0 for a missing operand rather than latching is deliberate: an ABSENT optional Target is the common case, and the callers distinguish 'no target' from 'bad target' by testing for zero before calling aml_eval_store. Locals: r12 = remaining hops. Reserved labels: aml_arc_.",
      block: {
        push r12;
        push r13;
        mov r12, rsi;
        call aml_node_first_child;
      aml_arc_hop:
        cmp r12, 0;
        je aml_arc_out;
        cmp rax, 0;
        je aml_arc_out;
        mov rdi, rax;
        call aml_node_next_sibling;
        sub r12, 1;
        jmp aml_arc_hop;
      aml_arc_out:
        pop r13;
        pop r12;
        ret
      }
    } @no_frame

  // ==========================================================================
  // aml_arith_handles(op16) -> 1 when this module evaluates that opcode.
  // ==========================================================================
  pub let aml_arith_handles : (u64) -> u64 !{} @{} =
    fn (op16: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R30.M2-002 (#1055): the exact set of opcodes this module evaluates, as an executable predicate rather than as a comment. It exists so the corpus can assert coverage in BOTH directions -- every opcode #1055 claims is handled, and every opcode it does not claim is genuinely refused with AML_ERR_NOT_EVALUABLE by aml_arith_eval. Without it the coverage claim would be a list in a header that nothing checks, and the failure mode of such a list is that it says twenty-four while the dispatch chain implements twenty-three. The opcode space is ALMOST but not quite kind here, and the almost is where the bug was: 0x72..0x82 is a contiguous arithmetic run and 0x90..0x95 a contiguous logical one, but 0x73 ConcatOp sits INSIDE the first run and belongs to #1056, and 0x85 ModOp sits OUTSIDE it -- 0x83 DerefOf and 0x84 ConcatRes separate Mod from the rest. So the predicate is two ranges, one hole punched out and one opcode added back. Writing it as 'two ranges' alone silently dropped Mod, and the corpus caught it precisely because it asserts this predicate against the same list the dispatch chain implements. Reserved labels: aml_arh_.",
      block: {
        cmp rdi, 0x85;                   // ModOp — outside the 0x72..0x82 run
        je aml_arh_yes;
        // 0x72..0x82, minus 0x73 ConcatOp (a string/buffer operator, #1056)
        cmp rdi, 0x72;
        jb aml_arh_log;
        cmp rdi, 0x82;
        ja aml_arh_log;
        cmp rdi, 0x73;                   // ConcatOp
        je aml_arh_no;
      aml_arh_yes:
        mov rax, 1;
        ret;
      aml_arh_log:
        // 0x90..0x95 logical
        cmp rdi, 0x90;
        jb aml_arh_no;
        cmp rdi, 0x95;
        ja aml_arh_no;
        mov rax, 1;
        ret;
      aml_arh_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // aml_arith_eval(expr_node) -> value.
  // ==========================================================================
  pub let aml_arith_eval : (u64) -> u64 !{mem} @{} =
    fn (expr_node: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M2-002 (#1055): evaluate an AML_NODE_EXPR whose flags word carries the op16, and return its value. Dispatch is on the opcode into five shapes -- binary-with-target, unary-with-target, read-modify-write, Divide, and logical -- because those five exhaust the operand grammars in §19.6 and collapsing them would mean re-deriving 'which child is the target' per opcode. Three correctness points are enforced here and nowhere else. (1) A shift count at or above the integer width produces ZERO, tested before the shift, because x86 masks the count to 6 bits and would otherwise compute ShiftLeft(One,64) as One. (2) Divide and Mod test the divisor BEFORE `div` executes: a zero divisor raises #DE, which is SIGFPE in a userspace process, so firmware bytecode could otherwise kill the acpi_supervisor -- it is AML_ERR_DIVIDE_BY_ZERO (34) instead. (3) LGreater and LLess use ja/jb, not jg/jl: AML integers are unsigned, and a signed compare would rank Ones below Zero and make While(LLess(Local0,Ones)) exit at once. Integer width is NOT handled here -- operands arrive truncated from aml_eval_node and results leave through aml_eval_trunc -- so a revision-1 table gets 32-bit semantics with no width test in any operator body except the two shifts, which need the width as a value. Divide's destinations are Remainder then Quotient, in that order per §19.6.34, and the returned value is the quotient. Locals: r12=node, r13=op16, r14=first operand, r15=second operand; [rsp+0]=child0, [rsp+8]=child1, [rsp+16]=child2, [rsp+24]=child3, [rsp+32]=result, [rsp+40]=quotient, [rsp+48]=remainder. Reserved labels: aml_ar_.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 64;
        mov r12, rdi;
        call aml_node_flags;
        mov r13, rax;
        mov rdi, r13;
        call aml_arith_handles;
        cmp rax, 0;
        je aml_ar_unev;
        // ---- route by shape ----
        cmp r13, 0x75;                   // IncrementOp
        je aml_ar_rmw;
        cmp r13, 0x76;                   // DecrementOp
        je aml_ar_rmw;
        cmp r13, 0x78;                   // DivideOp
        je aml_ar_div;
        cmp r13, 0x80;                   // NotOp
        je aml_ar_un;
        cmp r13, 0x81;                   // FindSetLeftBitOp
        je aml_ar_un;
        cmp r13, 0x82;                   // FindSetRightBitOp
        je aml_ar_un;
        cmp r13, 0x92;                   // LnotOp
        je aml_ar_lnot;
        cmp r13, 0x90;
        jae aml_ar_log;                  // 0x90/0x91/0x93/0x94/0x95
        jmp aml_ar_bin;

        // ==================================================================
        // Binary with an optional Target.
        // ==================================================================
      aml_ar_bin:
        mov rdi, r12;
        xor rsi, rsi;
        call aml_arith_child;
        mov [rsp + 0], rax;
        mov rdi, r12;
        mov rsi, 1;
        call aml_arith_child;
        mov [rsp + 8], rax;
        mov rdi, r12;
        mov rsi, 2;
        call aml_arith_child;
        mov [rsp + 16], rax;
        mov rdi, [rsp + 0];
        call aml_eval_node;
        mov r14, rax;
        mov rdi, [rsp + 8];
        call aml_eval_node;
        mov r15, rax;
        call aml_eval_err;
        cmp rax, 0;
        jne aml_ar_fail;

        cmp r13, 0x72;                   // AddOp
        je aml_ar_add;
        cmp r13, 0x74;                   // SubtractOp
        je aml_ar_sub;
        cmp r13, 0x77;                   // MultiplyOp
        je aml_ar_mul;
        cmp r13, 0x85;                   // ModOp
        je aml_ar_mod;
        cmp r13, 0x79;                   // ShiftLeftOp
        je aml_ar_shl;
        cmp r13, 0x7A;                   // ShiftRightOp
        je aml_ar_shr;
        cmp r13, 0x7B;                   // AndOp
        je aml_ar_and;
        cmp r13, 0x7C;                   // NandOp
        je aml_ar_nand;
        cmp r13, 0x7D;                   // OrOp
        je aml_ar_or;
        cmp r13, 0x7E;                   // NorOp
        je aml_ar_nor;
        cmp r13, 0x7F;                   // XorOp
        je aml_ar_xor;
        jmp aml_ar_unev;

      aml_ar_add:
        mov rax, r14;
        add rax, r15;
        jmp aml_ar_bstore;
      aml_ar_sub:
        mov rax, r14;
        sub rax, r15;
        jmp aml_ar_bstore;
      aml_ar_mul:
        mov rax, r14;
        mov rcx, r15;
        imul rax, rcx;
        jmp aml_ar_bstore;
      aml_ar_mod:
        cmp r15, 0;
        je aml_ar_divzero;
        xor rdx, rdx;
        mov rax, r14;
        mov rcx, r15;
        div rcx;
        mov rax, rdx;                    // remainder
        jmp aml_ar_bstore;
      aml_ar_shl:
        call aml_eval_width;
        cmp r15, rax;
        jae aml_ar_shiftout;
        mov rax, r14;
        mov rcx, r15;
        shl rax, cl;
        jmp aml_ar_bstore;
      aml_ar_shr:
        call aml_eval_width;
        cmp r15, rax;
        jae aml_ar_shiftout;
        mov rax, r14;
        mov rcx, r15;
        shr rax, cl;
        jmp aml_ar_bstore;
      aml_ar_shiftout:
        xor rax, rax;                    // every bit shifted out
        jmp aml_ar_bstore;
      aml_ar_and:
        mov rax, r14;
        and rax, r15;
        jmp aml_ar_bstore;
      aml_ar_nand:
        mov rax, r14;
        and rax, r15;
        not rax;
        jmp aml_ar_bstore;
      aml_ar_or:
        mov rax, r14;
        or rax, r15;
        jmp aml_ar_bstore;
      aml_ar_nor:
        mov rax, r14;
        or rax, r15;
        not rax;
        jmp aml_ar_bstore;
      aml_ar_xor:
        mov rax, r14;
        xor rax, r15;

      aml_ar_bstore:
        mov rdi, rax;
        call aml_eval_trunc;
        mov [rsp + 32], rax;
        mov rdi, [rsp + 16];
        cmp rdi, 0;
        je aml_ar_bdone;
        mov rsi, [rsp + 32];
        call aml_eval_store;
        cmp rax, 0;
        je aml_ar_fail;
      aml_ar_bdone:
        mov rax, [rsp + 32];
        jmp aml_ar_ret;

        // ==================================================================
        // Unary with an optional Target: Not, FindSetLeftBit,
        // FindSetRightBit.
        // ==================================================================
      aml_ar_un:
        mov rdi, r12;
        xor rsi, rsi;
        call aml_arith_child;
        mov [rsp + 0], rax;
        mov rdi, r12;
        mov rsi, 1;
        call aml_arith_child;
        mov [rsp + 16], rax;             // target
        mov rdi, [rsp + 0];
        call aml_eval_node;
        mov r14, rax;
        call aml_eval_err;
        cmp rax, 0;
        jne aml_ar_fail;
        cmp r13, 0x80;
        je aml_ar_not;
        cmp r13, 0x81;
        je aml_ar_fsl;
        // ---- FindSetRightBit: 1-based index of the least significant set
        //      bit, 0 when the operand is zero (§19.6.44).
        cmp r14, 0;
        je aml_ar_bitnone;
        mov r15, 1;
      aml_ar_fsr:
        mov rax, r14;
        and rax, 1;
        cmp rax, 0;
        jne aml_ar_bitdone;
        shr r14, 1;
        add r15, 1;
        jmp aml_ar_fsr;
      aml_ar_fsl:
        // ---- FindSetLeftBit: 1-based index of the most significant set
        //      bit, 0 when the operand is zero (§19.6.43). Written as a
        //      shift loop rather than bsr because bsr leaves the
        //      destination UNDEFINED for a zero source, and "undefined"
        //      is exactly the input a hostile table supplies.
        xor r15, r15;
      aml_ar_fsll:
        cmp r14, 0;
        je aml_ar_bitdone;
        shr r14, 1;
        add r15, 1;
        jmp aml_ar_fsll;
      aml_ar_bitnone:
        xor r15, r15;
      aml_ar_bitdone:
        mov rax, r15;
        jmp aml_ar_ustore;
      aml_ar_not:
        mov rax, r14;
        not rax;
      aml_ar_ustore:
        mov rdi, rax;
        call aml_eval_trunc;
        mov [rsp + 32], rax;
        mov rdi, [rsp + 16];
        cmp rdi, 0;
        je aml_ar_udone;
        mov rsi, [rsp + 32];
        call aml_eval_store;
        cmp rax, 0;
        je aml_ar_fail;
      aml_ar_udone:
        mov rax, [rsp + 32];
        jmp aml_ar_ret;

        // ==================================================================
        // Increment / Decrement — the operand is both source and
        // destination (§19.6.51/§19.6.29). Reading it with aml_eval_node
        // and writing it with aml_eval_store means the two agree on what
        // is storable by construction: a literal reads fine and then
        // fails the store with AML_ERR_BAD_TARGET, which is exactly the
        // right diagnosis for Increment(One).
        // ==================================================================
      aml_ar_rmw:
        mov rdi, r12;
        xor rsi, rsi;
        call aml_arith_child;
        mov [rsp + 0], rax;
        mov rdi, [rsp + 0];
        call aml_eval_node;
        mov r14, rax;
        call aml_eval_err;
        cmp rax, 0;
        jne aml_ar_fail;
        cmp r13, 0x75;
        je aml_ar_inc;
        sub r14, 1;
        jmp aml_ar_rmwstore;
      aml_ar_inc:
        add r14, 1;
      aml_ar_rmwstore:
        mov rdi, r14;
        call aml_eval_trunc;
        mov [rsp + 32], rax;
        mov rdi, [rsp + 0];
        mov rsi, [rsp + 32];
        call aml_eval_store;
        cmp rax, 0;
        je aml_ar_fail;
        mov rax, [rsp + 32];
        jmp aml_ar_ret;

        // ==================================================================
        // Divide — two destinations, Remainder then Quotient.
        // ==================================================================
      aml_ar_div:
        mov rdi, r12;
        xor rsi, rsi;
        call aml_arith_child;
        mov [rsp + 0], rax;
        mov rdi, r12;
        mov rsi, 1;
        call aml_arith_child;
        mov [rsp + 8], rax;
        mov rdi, r12;
        mov rsi, 2;
        call aml_arith_child;
        mov [rsp + 16], rax;             // Remainder target
        mov rdi, r12;
        mov rsi, 3;
        call aml_arith_child;
        mov [rsp + 24], rax;             // Quotient target
        mov rdi, [rsp + 0];
        call aml_eval_node;
        mov r14, rax;
        mov rdi, [rsp + 8];
        call aml_eval_node;
        mov r15, rax;
        call aml_eval_err;
        cmp rax, 0;
        jne aml_ar_fail;
        cmp r15, 0;
        je aml_ar_divzero;
        xor rdx, rdx;
        mov rax, r14;
        mov rcx, r15;
        div rcx;
        mov [rsp + 40], rax;             // quotient
        mov [rsp + 48], rdx;             // remainder
        mov rdi, [rsp + 40];
        call aml_eval_trunc;
        mov [rsp + 40], rax;
        mov rdi, [rsp + 48];
        call aml_eval_trunc;
        mov [rsp + 48], rax;
        mov rdi, [rsp + 16];
        cmp rdi, 0;
        je aml_ar_divq;
        mov rsi, [rsp + 48];
        call aml_eval_store;
        cmp rax, 0;
        je aml_ar_fail;
      aml_ar_divq:
        mov rdi, [rsp + 24];
        cmp rdi, 0;
        je aml_ar_divdone;
        mov rsi, [rsp + 40];
        call aml_eval_store;
        cmp rax, 0;
        je aml_ar_fail;
      aml_ar_divdone:
        mov rax, [rsp + 40];
        jmp aml_ar_ret;

        // ==================================================================
        // Logical. No Target operand; the result is Ones or Zero at the
        // table's integer width.
        // ==================================================================
      aml_ar_log:
        mov rdi, r12;
        xor rsi, rsi;
        call aml_arith_child;
        mov [rsp + 0], rax;
        mov rdi, r12;
        mov rsi, 1;
        call aml_arith_child;
        mov [rsp + 8], rax;
        mov rdi, [rsp + 0];
        call aml_eval_node;
        mov r14, rax;
        mov rdi, [rsp + 8];
        call aml_eval_node;
        mov r15, rax;
        call aml_eval_err;
        cmp rax, 0;
        jne aml_ar_fail;
        cmp r13, 0x90;                   // LandOp
        je aml_ar_land;
        cmp r13, 0x91;                   // LorOp
        je aml_ar_lor;
        cmp r13, 0x93;                   // LEqualOp
        je aml_ar_leq;
        cmp r13, 0x94;                   // LGreaterOp
        je aml_ar_lgt;
        cmp r13, 0x95;                   // LLessOp
        je aml_ar_llt;
        jmp aml_ar_unev;
      aml_ar_land:
        cmp r14, 0;
        je aml_ar_false;
        cmp r15, 0;
        je aml_ar_false;
        jmp aml_ar_true;
      aml_ar_lor:
        cmp r14, 0;
        jne aml_ar_true;
        cmp r15, 0;
        jne aml_ar_true;
        jmp aml_ar_false;
      aml_ar_leq:
        cmp r14, r15;
        je aml_ar_true;
        jmp aml_ar_false;
      aml_ar_lgt:
        cmp r14, r15;
        ja aml_ar_true;                  // UNSIGNED — AML integers are
        jmp aml_ar_false;
      aml_ar_llt:
        cmp r14, r15;
        jb aml_ar_true;                  // UNSIGNED
        jmp aml_ar_false;

      aml_ar_lnot:
        mov rdi, r12;
        xor rsi, rsi;
        call aml_arith_child;
        mov [rsp + 0], rax;
        mov rdi, [rsp + 0];
        call aml_eval_node;
        mov r14, rax;
        call aml_eval_err;
        cmp rax, 0;
        jne aml_ar_fail;
        cmp r14, 0;
        je aml_ar_true;
        jmp aml_ar_false;

      aml_ar_true:
        call aml_eval_ones;
        jmp aml_ar_ret;
      aml_ar_false:
        xor rax, rax;
        jmp aml_ar_ret;

      aml_ar_divzero:
        mov rdi, 34;                     // AML_ERR_DIVIDE_BY_ZERO
        call aml_eval_set_err;
        jmp aml_ar_fail;
      aml_ar_unev:
        mov rdi, 35;                     // AML_ERR_NOT_EVALUABLE
        call aml_eval_set_err;
      aml_ar_fail:
        xor rax, rax;
      aml_ar_ret:
        add rsp, 64;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    } @no_frame
}
