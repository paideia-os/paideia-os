// src/user/aml/aml_obj.pdx — R30.M2-003 (#1056) / R30.M2-004 (#1057)
//
// The ACPI OBJECT MODEL: Integer, String, Buffer, Package, Reference, and
// the storage they live in.
//
// PLACEMENT — CONSTITUTIONAL
// -------------------------
// Userspace only. See design/acpi/no-aml-in-kernel.md.
//
// =====================================================================
// WHY A SECOND ARENA AND NOT A WIDER NODE
// =====================================================================
// The #1050 node arena is a SYNTAX tree: it describes what the table
// says. Evaluation needs to describe what the table currently MEANS —
// the buffer a `Name` holds after three stores, a Package element that
// was assigned at run time, a reference produced by `Index`. Those are
// values, they change, and they have no source-buffer offset.
//
// Two candidate designs were rejected before this one.
//
//   MUTATE THE NODE ARENA. Give NAME nodes a mutable payload. This
//   destroys the property design/acpi/aml-parser.md is built on: the
//   arena is THE WIRE FORMAT, memcpy-able to another process, and it is
//   the same bytes for the whole life of the table. If evaluation
//   mutated it, a second evaluation of the same table would start from
//   wherever the first one finished, `_STA` would return different
//   answers on the second boot-time sweep than on the first, and the
//   IPC payload would depend on when it was taken. Evaluation therefore
//   NEVER writes the node arena. Not "rarely"; never.
//
//   POINTERS TO MALLOC'D OBJECTS. The acpi_supervisor process has no
//   allocator by design (design/acpi/acpica-bubble.md), and a pointer
//   graph re-introduces exactly the property the arena exists to avoid.
//
// So: a SECOND index-addressed arena, with the same three properties as
// the first — no pointers, fixed 32-byte stride, arrays are the whole
// representation — and a per-node BINDING TABLE that says which object
// a declaration currently holds. The parse tree stays immutable and the
// evaluation state is entirely in these five arrays.
//
// =====================================================================
// OBJECT RECORD — 4 x u64, 32 bytes, the same stride as a node
// =====================================================================
//   word0  [15:0]  type       an ACPI ObjectType code (see below)
//          [23:16] refkind    reference sub-kind, type 20 only
//          [63:24] reserved
//   word1  type-dependent primary field
//   word2  type-dependent length / index
//   word3  type-dependent auxiliary
//
//   type 1  INTEGER    w1 = value                     w2 = 0    w3 = 0
//   type 2  STRING     w1 = heap offset               w2 = length, NUL excluded
//   type 3  BUFFER     w1 = heap offset               w2 = length
//   type 4  PACKAGE    w1 = element-run start         w2 = NumElements
//   type 20 REFERENCE  w1 = base                      w2 = index  w3 = serial
//
// THE TYPE CODES ARE THE ACPI ObjectType CODES, DELIBERATELY
// ----------------------------------------------------------
// 1 Integer, 2 String, 3 Buffer, 4 Package, 5 FieldUnit, 6 Device,
// 7 Event, 8 Method, 9 Mutex, 10 OperationRegion, 11 PowerResource,
// 12 Processor, 13 ThermalZone, 14 BufferField, 15 DDBHandle,
// 16 DebugObject — ACPI 6.5 §19.6.101. Type 20 for a reference follows
// ACPICA's ACPI_TYPE_LOCAL_REFERENCE, which is beyond the 16 the spec
// defines precisely because a reference is not a spec-visible type.
//
// Using the spec's numbering as the internal tag means `ObjectType` is
// nearly a field read and there is ONE numbering rather than two with a
// mapping table between them. A mapping table is a thing that gets out
// of step; the six-line switch that would build it is exactly the sort
// of code that silently reports a Buffer as a Package after someone
// inserts a row.
//
// REFERENCE SUB-KINDS — word0[23:16]
// ----------------------------------
//   1 REF_NAME       w1 = arena NODE index of the declaration
//   2 REF_LOCAL      w1 = frame index, w2 = slot 0..7, w3 = frame serial
//   3 REF_ARG        w1 = frame index, w2 = slot 0..6, w3 = frame serial
//   4 REF_PKG_ELEM   w1 = package OBJECT, w2 = element index
//   5 REF_BUF_FIELD  w1 = buffer OBJECT,  w2 = byte index
//   6 REF_STR_FIELD  w1 = string OBJECT,  w2 = byte index
//
// THE LAST THREE ARE THE POINT OF #1057. `Index` is type-dependent and
// produces a DIFFERENT kind of reference for each source type (§19.6.63):
// a byte field into a Buffer, a byte field into a String's characters,
// and a handle on a Package ELEMENT. Collapsing 4 and 5 into one kind —
// "it is a container, this is the index" — reads fine and silently
// corrupts, because storing an Integer through a package-element
// reference REPLACES the element with an Integer object, whereas storing
// one through a buffer-field reference writes ONE BYTE and truncates.
// Buffer and String are kept apart for the same reason at one remove:
// they behave identically today, but a String has a NUL the Buffer does
// not, so a future `SizeOf`/growth rule that treats them alike would be
// wrong for one of them. Distinct kinds make that a compile-time-visible
// choice instead of an accident.
//
// FRAME REFERENCES CARRY A SERIAL, AND THAT IS NOT OPTIONAL
// ---------------------------------------------------------
// `RefOf(Local0)` names a slot in the CURRENT frame. Frames are a pool
// of eight reused slots, so a reference holding only "frame 3, slot 0"
// silently re-aims at a DIFFERENT method's Local0 once frame 3 has been
// popped and re-pushed — a wrong value, produced from a plausible
// reference, which is the failure mode this whole subsystem is built to
// refuse. aml_frame_push therefore stamps a monotonically increasing
// SERIAL into each frame it hands out, a frame reference records it, and
// a dereference that finds a different serial is AML_ERR_STALE_REF (49)
// rather than a read of someone else's local.
//
// =====================================================================
// STORAGE, LIFETIME AND CONFINEMENT
// =====================================================================
// Five arrays, all .bss, all private to this object and all proved
// private by tools/verify-aml-parser.sh with `objdump -r` — the same
// mechanism and the same reason as aml_lex_state and the node arena.
// Confinement is not tidiness here either: every bounds check in this
// file (object index against the high-water mark, byte index against the
// object's own length, element index against NumElements) is only an
// invariant for as long as no other object can form an address into
// these arrays.
//
//   aml_obj_table  512 objects x 32 B    16 KiB
//   aml_obj_heap   8192 bytes                    String/Buffer payloads
//   aml_obj_elem   1024 u32                      Package element slots
//   aml_obj_bind   512 u32                       node index -> object
//   aml_obj_state  counters
//
// LIFETIME IS THE EVALUATION SESSION. Allocation is a bump; there is no
// free. aml_eval_reset calls aml_obj_reset, so every session starts with
// an empty object arena and an empty binding table, and therefore
// re-materialises each named object from its IMMUTABLE declaration. Two
// consequences, both wanted:
//
//   * evaluating the same table twice gives the same answers, because
//     the second evaluation cannot see the first one's stores;
//   * a firmware method that allocates without bound fails with a
//     LATCHED, BOUNDED error (AML_ERR_OBJ_ARENA_FULL 42,
//     AML_ERR_OBJ_HEAP_FULL 43, AML_ERR_OBJ_ELEM_FULL 44) rather than
//     growing the process, which is the same posture as the frame pool:
//     "allocate more" under firmware-controlled recursion is the attack,
//     not the mitigation.
//
// A garbage collector was considered and rejected: the reachability root
// set is the binding table plus every live frame slot plus the native
// stack of the evaluator, and the last of those is not enumerable from
// here. A bump allocator with a hard ceiling is honest; a collector that
// cannot see one of its roots is a use-after-free.
//
// THE BINDING TABLE IS INDEXED BY NODE
// ------------------------------------
// aml_obj_bind[node] is the object a declaration currently holds, 0
// meaning "not yet materialised — use the declaration". That keeps the
// node stride at 32 bytes (a binding field inside the node would have
// meant a wider record, which #1050 exists to forbid) and keeps the
// mutation strictly outside the wire format. It is sized to the node
// arena and index-checked against it.
//
// =====================================================================
// ERROR CODES ADDED HERE (the taxonomy continues at 42)
// =====================================================================
//   42 AML_ERR_OBJ_ARENA_FULL  512 objects in use
//   43 AML_ERR_OBJ_HEAP_FULL   8192 payload bytes in use
//   44 AML_ERR_OBJ_ELEM_FULL   1024 package element slots in use
//   45 AML_ERR_BAD_REF         DerefOf/store through a non-reference
//   46 AML_ERR_OBJ_RANGE       index outside the object's own extent
//   47 AML_ERR_NO_CONVERSION   §19.3.5 defines no conversion (#1056)
//   48 AML_ERR_BAD_OBJTYPE     operand type the operator does not accept
//   49 AML_ERR_STALE_REF       frame reference whose frame has been reused
//   50 AML_ERR_UNINIT_ELEMENT  package element that was never initialised
//
// Errors latch through aml_eval_set_err — this module deliberately has
// no error slot of its own. Object allocation happens only during
// evaluation, and a second first-writer-wins latch would mean an
// arena-full condition that did not block evaluation, which is precisely
// the "caller forgot to check" failure aml_eval_spend's execution-
// blocking rule exists to make impossible.

module AmlObj = structure {

  // ==========================================================================
  // Private storage. Confined to this object by tools/verify-aml-parser.sh.
  //
  //   aml_obj_state  +0   magic (0x414D4C4F once reset)
  //                  +8   next free object index (1 = empty)
  //                  +16  next free heap byte  (1 = empty; 0 means "none")
  //                  +24  next free element slot (1 = empty)
  //                  +32..63 reserved
  // ==========================================================================
  pub let mut aml_obj_state : [u64; 8]    = uninit @align(8)
  pub let mut aml_obj_table : [u64; 2048] = uninit @align(8)
  pub let mut aml_obj_heap  : [u64; 1024] = uninit @align(8)
  pub let mut aml_obj_elem  : [u32; 1024] = uninit @align(4)
  pub let mut aml_obj_bind  : [u32; 512]  = uninit @align(4)

  // ==========================================================================
  // Lifecycle.
  // ==========================================================================

  pub let aml_obj_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M2-003 (#1056): begin an object session. The three bump cursors go to 1 -- index 0 is the null sentinel in all three arenas, exactly as in the node arena, so 'no object', 'no payload' and 'no element run' need no separate presence bit. The BINDING TABLE is zeroed in full, and that is the load-bearing part: a stale binding would make a named object appear to hold the PREVIOUS session's value, so the second evaluation of a table would not agree with the first. The table arrays themselves are NOT zeroed, because no reader can reach a record above the high-water mark -- every accessor bounds-checks against aml_obj_state+8 first -- and zeroing 16 KiB per session to defend an invariant already enforced by a compare is work for nothing. Called from aml_eval_reset, so a caller cannot begin an evaluation without beginning an object session. Reserved labels: aml_obr_.",
      block: {
        lea rcx, [rip + aml_obj_state];
        mov rax, 1;
        mov [rcx + 8], rax;
        mov [rcx + 16], rax;
        mov [rcx + 24], rax;
        mov rax, 0x414D4C4F;
        mov [rcx + 0], rax;
        lea rcx, [rip + aml_obj_bind];
        xor rax, rax;
        xor rdx, rdx;
      aml_obr_zero:
        mov_d [rcx + rdx*4], rax;
        add rdx, 1;
        cmp rdx, 512;
        jb aml_obr_zero;
        ret
      }
    } @no_frame

  pub let aml_obj_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M2-003 (#1056): the next free object index, which because allocation is a bump from 1 is also one more than the number of objects in use. The corpus uses it to prove that the integer fast path in aml_eval_node allocates NO objects -- an arithmetic-only method must leave this at 1, and a regression that routed integers through the object model would show up here rather than as a mysterious arena exhaustion four milestones later. Leaf accessor. Reserved labels: none.",
      block: {
        lea rcx, [rip + aml_obj_state];
        mov rax, [rcx + 8];
        ret
      }
    } @no_frame

  pub let aml_obj_heap_used : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M2-003 (#1056): the next free payload byte. Diagnostic; the corpus asserts a Concatenate loop drives it to the ceiling and stops rather than wrapping. Leaf accessor. Reserved labels: none.",
      block: {
        lea rcx, [rip + aml_obj_state];
        mov rax, [rcx + 16];
        ret
      }
    } @no_frame

  pub let aml_obj_elem_used : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M2-004 (#1057): the next free package-element slot. Leaf accessor. Reserved labels: none.",
      block: {
        lea rcx, [rip + aml_obj_state];
        mov rax, [rcx + 24];
        ret
      }
    } @no_frame

  // ==========================================================================
  // Allocation.
  // ==========================================================================

  pub let aml_obj_alloc : (u64) -> u64 !{mem} @{} =
    fn (ty: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M2-003 (#1056): allocate one 32-byte object record of ACPI type rdi and return its index, or 0 having latched AML_ERR_OBJ_ARENA_FULL (42). All four words are written -- the type into word0 and zero into the other three -- so no accessor can ever read a field of a freshly allocated object that was left over from a previous session. That matters because the arena is NOT zeroed at reset: the high-water-mark check keeps stale records unreachable, and writing all four words here is what keeps them unreachable the instant the mark moves. The record address is base + idx*32 via shl 5, since x86 addressing scales to 8 at most. Refusal rather than a wrap is the same rule as the frame pool: firmware controls how many objects a method creates. Reserved labels: aml_oba_.",
      block: {
        lea rcx, [rip + aml_obj_state];
        mov rax, [rcx + 8];
        cmp rax, 512;
        jae aml_oba_full;
        mov rdx, rax;
        add rdx, 1;
        mov [rcx + 8], rdx;
        lea rcx, [rip + aml_obj_table];
        mov rdx, rax;
        shl rdx, 5;
        add rcx, rdx;
        mov [rcx + 0], rdi;
        xor rdx, rdx;
        mov [rcx + 8], rdx;
        mov [rcx + 16], rdx;
        mov [rcx + 24], rdx;
        ret;
      aml_oba_full:
        mov rdi, 42;                     // AML_ERR_OBJ_ARENA_FULL
        call aml_eval_set_err;
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let aml_obj_word : (u64, u64) -> u64 !{mem} @{} =
    fn (obj: u64) (w: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M2-003 (#1056): word rsi (0..3) of object rdi, or 0 when either index is out of range. THE only read path into the object table, which is what makes 'no accessor reads above the high-water mark' a property of one function rather than of every caller. Object 0 is the null sentinel and reads as zero on every word, so 'no object' propagates as zeroes instead of faulting -- callers distinguish it by testing the index, exactly as they do in the node arena. Reserved labels: aml_obw_.",
      block: {
        cmp rdi, 0;
        je aml_obw_zero;
        cmp rsi, 4;
        jae aml_obw_zero;
        lea rcx, [rip + aml_obj_state];
        mov rax, [rcx + 8];
        cmp rdi, rax;
        jae aml_obw_zero;
        lea rcx, [rip + aml_obj_table];
        mov rax, rdi;
        shl rax, 5;
        add rcx, rax;
        mov rax, [rcx + rsi*8];
        ret;
      aml_obw_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let aml_obj_set_word : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (obj: u64) (w: u64) (value: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M2-003 (#1056): write word rsi of object rdi. Returns 1 on success, 0 on an out-of-range index WITHOUT writing -- the twin of aml_obj_word and the only write path, so the same single bounds check covers every mutation. No error is latched on refusal: every caller here allocated the object it is filling in, so an out-of-range index is unreachable by construction and a latch would report a code for a condition the corpus cannot produce. Reserved labels: aml_obsw_.",
      block: {
        cmp rdi, 0;
        je aml_obsw_no;
        cmp rsi, 4;
        jae aml_obsw_no;
        lea rcx, [rip + aml_obj_state];
        mov rax, [rcx + 8];
        cmp rdi, rax;
        jae aml_obsw_no;
        lea rcx, [rip + aml_obj_table];
        mov rax, rdi;
        shl rax, 5;
        add rcx, rax;
        mov [rcx + rsi*8], rdx;
        mov rax, 1;
        ret;
      aml_obsw_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let aml_obj_type : (u64) -> u64 !{mem} @{} =
    fn (obj: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M2-003 (#1056): the ACPI ObjectType code of object rdi, 0 for the null object. This IS the value `ObjectType` returns, because the internal tag and the spec's numbering are the same numbering -- see the file header. Reserved labels: none.",
      block: {
        mov rsi, 0;
        call aml_obj_word;
        mov rcx, 0xFFFF;
        and rax, rcx;
        ret
      }
    } @no_frame

  pub let aml_obj_refkind : (u64) -> u64 !{mem} @{} =
    fn (obj: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M2-004 (#1057): the reference sub-kind of object rdi, 0 when it is not a reference. Reading it from word0[23:16] rather than from a fourth word is what keeps a reference inside the same 32-byte stride as every other object -- a reference needs three fields (base, index, serial) and it has exactly three. Reserved labels: none.",
      block: {
        mov rsi, 0;
        call aml_obj_word;
        shr rax, 16;
        mov rcx, 0xFF;
        and rax, rcx;
        ret
      }
    } @no_frame

  pub let aml_obj_base : (u64) -> u64 !{mem} @{} =
    fn (obj: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M2-003 (#1056): word1 -- the Integer's value, the String/Buffer heap offset, the Package element-run start, or the reference's base. Named rather than spelled aml_obj_word(o,1) at forty call sites so the meaning of word1 is stated once. Reserved labels: none.",
      block: {
        mov rsi, 1;
        call aml_obj_word;
        ret
      }
    } @no_frame

  pub let aml_obj_len : (u64) -> u64 !{mem} @{} =
    fn (obj: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M2-003 (#1056): word2 -- a String's length EXCLUDING its NUL, a Buffer's byte count, a Package's NumElements, or a reference's index. This is the raw field; `SizeOf` is not this function, because SizeOf must REFUSE an Integer (§19.6.125) and this must not, being the accessor the refusal is written in terms of. Reserved labels: none.",
      block: {
        mov rsi, 2;
        call aml_obj_word;
        ret
      }
    } @no_frame

  pub let aml_obj_aux : (u64) -> u64 !{mem} @{} =
    fn (obj: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M2-004 (#1057): word3 -- the frame serial of a REF_LOCAL/REF_ARG, zero elsewhere. Reserved labels: none.",
      block: {
        mov rsi, 3;
        call aml_obj_word;
        ret
      }
    } @no_frame

  pub let aml_obj_int : (u64) -> u64 !{mem} @{} =
    fn (value: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M2-003 (#1056): allocate an Integer object holding rdi. NOT truncated to the table width here: the caller obtained the value from aml_eval_node or from aml_eval_trunc, both of which have already applied the width, and truncating a second time in a constructor would put a width decision in a place with no way to know whether the value is a width-bearing AML integer or a length in bytes. One choke point, per the #1054 header, and this is not it. Locals: r12=value, r13=object. Reserved labels: aml_obi_.",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        mov rdi, 1;                      // ACPI type 1 = Integer
        call aml_obj_alloc;
        mov r13, rax;
        cmp r13, 0;
        je aml_obi_out;
        mov rdi, r13;
        mov rsi, 1;
        mov rdx, r12;
        call aml_obj_set_word;
      aml_obi_out:
        mov rax, r13;
        pop r13;
        pop r12;
        ret
      }
    } @no_frame

  pub let aml_obj_int_value : (u64) -> u64 !{mem} @{} =
    fn (obj: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M2-003 (#1056): the value of an Integer object. An object of any OTHER type is AML_ERR_BAD_OBJTYPE (48) and zero, never a silent read of word1 -- word1 of a Buffer is a heap offset, and returning it as though it were an integer would hand a driver an address-shaped small number that looks entirely plausible. Callers that WANT a conversion ask aml_conv_cast for one; this is the accessor for a value that is already an Integer. Locals: r12=object. Reserved labels: aml_obiv_.",
      block: {
        push r12;
        mov r12, rdi;
        call aml_obj_type;
        cmp rax, 1;
        jne aml_obiv_bad;
        mov rdi, r12;
        call aml_obj_base;
        pop r12;
        ret;
      aml_obiv_bad:
        mov rdi, 48;                     // AML_ERR_BAD_OBJTYPE
        call aml_eval_set_err;
        xor rax, rax;
        pop r12;
        ret
      }
    } @no_frame

  // ==========================================================================
  // The payload heap. Exactly two functions form an address into it.
  // ==========================================================================

  pub let aml_obj_heap_alloc : (u64) -> u64 !{mem} @{} =
    fn (n: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M2-003 (#1056): reserve rdi ZEROED payload bytes and return the offset of the first, or 0 having latched AML_ERR_OBJ_HEAP_FULL (43). Offset 0 is never handed out -- the cursor starts at 1 -- so 0 is unambiguously the failure value and no caller needs a second out-parameter. The capacity test is written as an ADD FOLLOWED BY AN UNSIGNED-BELOW CHECK ON THE SUM, so a length taken from a firmware-controlled Buffer size near 2^64 cannot wrap the cursor past the ceiling: the wrap is detected as 'end < start' before the ceiling compare runs. Zeroing is not optional -- a Buffer whose initialiser list is shorter than its declared size is zero-filled by §20.2.5.4, and the alternative is that it is filled with the previous method's string. Locals: r12=n, r13=start, r14=end. Reserved labels: aml_obha_.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;
        mov r12, rdi;
        lea rcx, [rip + aml_obj_state];
        mov r13, [rcx + 16];
        mov r14, r13;
        add r14, r12;
        cmp r14, r13;
        jb aml_obha_full;                // 64-bit wrap
        mov rax, 8192;
        cmp r14, rax;
        ja aml_obha_full;
        mov [rcx + 16], r14;
        lea rcx, [rip + aml_obj_heap];
        add rcx, r13;
        xor rax, rax;
        xor r15, r15;
      aml_obha_zero:
        cmp r15, r12;
        jae aml_obha_done;
        mov_b [rcx], rax;
        add rcx, 1;
        add r15, 1;
        jmp aml_obha_zero;
      aml_obha_done:
        mov rax, r13;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret;
      aml_obha_full:
        mov rdi, 43;                     // AML_ERR_OBJ_HEAP_FULL
        call aml_eval_set_err;
        xor rax, rax;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    } @no_frame

  pub let aml_obj_heap_get : (u64) -> u64 !{mem} @{} =
    fn (off: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M2-003 (#1056): the payload byte at heap offset rdi, zero-extended. Bounds-checked against the HIGH-WATER MARK rather than against the array size, so a read of never-allocated heap is refused even though the address would be within the .bss object -- 'inside the array' is not the invariant, 'inside something that was allocated' is. Out of range yields 0 with no latch, because the two callers (aml_obj_byte, aml_obj_copy) have already bounds-checked against the OBJECT's own extent and latched AML_ERR_OBJ_RANGE there; a second latch here would report the wrong code for the same fault. Uses the xor-then-mov_b zero-extend idiom (paideia-as #1248). Reserved labels: aml_obhg_.",
      block: {
        lea rcx, [rip + aml_obj_state];
        mov rax, [rcx + 16];
        cmp rdi, rax;
        jae aml_obhg_zero;
        lea rcx, [rip + aml_obj_heap];
        add rcx, rdi;
        xor rax, rax;
        mov_b rax, [rcx];
        ret;
      aml_obhg_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let aml_obj_heap_set : (u64, u64) -> u64 !{mem} @{} =
    fn (off: u64) (byte: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M2-003 (#1056): write the low byte of rsi at heap offset rdi. Returns 1 on success, 0 on an out-of-range offset having written NOTHING. Same high-water-mark bound as aml_obj_heap_get and for the same reason. Reserved labels: aml_obhs_.",
      block: {
        lea rcx, [rip + aml_obj_state];
        mov rax, [rcx + 16];
        cmp rdi, rax;
        jae aml_obhs_no;
        lea rcx, [rip + aml_obj_heap];
        add rcx, rdi;
        mov_b [rcx], rsi;
        mov rax, 1;
        ret;
      aml_obhs_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let aml_obj_str_alloc : (u64) -> u64 !{mem} @{} =
    fn (len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M2-003 (#1056): allocate a String object of rdi characters, zero-filled, and return its index. len+1 heap bytes are reserved so a String object is ALWAYS NUL-terminated in the heap while its recorded length excludes the NUL. That is the representation AML itself uses -- §20.2.3 encodes a string as bytes followed by a NUL -- and keeping it means ToBuffer's 'including the null terminator' rule (§19.6.140) is a copy of len+1 rather than a copy plus a special case, and a String can be handed to a consumer as a C string with no re-encoding. The length is capped at 8191 before the +1 so the increment cannot wrap. Locals: r12=len, r13=heap offset, r14=object. Reserved labels: aml_obsa_.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;
        mov r12, rdi;
        mov rax, 8191;
        cmp r12, rax;
        ja aml_obsa_toobig;
        mov rdi, r12;
        add rdi, 1;
        call aml_obj_heap_alloc;
        mov r13, rax;
        cmp r13, 0;
        je aml_obsa_fail;
        mov rdi, 2;                      // ACPI type 2 = String
        call aml_obj_alloc;
        mov r14, rax;
        cmp r14, 0;
        je aml_obsa_fail;
        mov rdi, r14;
        mov rsi, 1;
        mov rdx, r13;
        call aml_obj_set_word;
        mov rdi, r14;
        mov rsi, 2;
        mov rdx, r12;
        call aml_obj_set_word;
        mov rax, r14;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret;
      aml_obsa_toobig:
        mov rdi, 43;                     // AML_ERR_OBJ_HEAP_FULL
        call aml_eval_set_err;
      aml_obsa_fail:
        xor rax, rax;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    } @no_frame

  pub let aml_obj_buf_alloc : (u64) -> u64 !{mem} @{} =
    fn (len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M2-003 (#1056): allocate a Buffer object of rdi zero-filled bytes. No NUL, deliberately -- a Buffer is not NUL-terminated and reserving a byte for one would make SizeOf and the heap accounting disagree by one, which is the kind of off-by-one that shows up as a corrupted last byte in a resource template. A zero-length Buffer is legal (`Buffer(0){}` appears in real tables) and gets a heap offset with no bytes behind it, which is safe because every read is bounds-checked against the object's own length of zero. Locals: r12=len, r13=heap offset, r14=object. Reserved labels: aml_obba_.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;
        mov r12, rdi;
        mov rax, 8192;
        cmp r12, rax;
        ja aml_obba_toobig;
        mov rdi, r12;
        call aml_obj_heap_alloc;
        mov r13, rax;
        cmp r12, 0;
        je aml_obba_obj;                 // zero-length: offset is irrelevant
        cmp r13, 0;
        je aml_obba_fail;
      aml_obba_obj:
        mov rdi, 3;                      // ACPI type 3 = Buffer
        call aml_obj_alloc;
        mov r14, rax;
        cmp r14, 0;
        je aml_obba_fail;
        mov rdi, r14;
        mov rsi, 1;
        mov rdx, r13;
        call aml_obj_set_word;
        mov rdi, r14;
        mov rsi, 2;
        mov rdx, r12;
        call aml_obj_set_word;
        mov rax, r14;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret;
      aml_obba_toobig:
        mov rdi, 43;                     // AML_ERR_OBJ_HEAP_FULL
        call aml_eval_set_err;
      aml_obba_fail:
        xor rax, rax;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    } @no_frame

  pub let aml_obj_byte : (u64, u64) -> u64 !{mem} @{} =
    fn (obj: u64) (i: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M2-003 (#1056): byte rsi of String or Buffer rdi. THE bounds check that makes Index(Buffer,n) safe: the index is compared against the OBJECT's own length before the heap offset is added, so a firmware-supplied index cannot reach another object's payload even though both live in the same array. Out of range latches AML_ERR_OBJ_RANGE (46) and returns 0 -- an error, not a zero byte, because a zero byte read from past the end of a resource template is a valid-looking descriptor. A String read at index len (its NUL) is out of range by this rule; ToBuffer, which needs the NUL, asks for len+1 bytes from the heap directly through aml_obj_copy. Locals: r12=object, r13=index. Reserved labels: aml_obby_.",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        mov r13, rsi;
        call aml_obj_type;
        cmp rax, 2;
        je aml_obby_ok;
        cmp rax, 3;
        jne aml_obby_type;
      aml_obby_ok:
        mov rdi, r12;
        call aml_obj_len;
        cmp r13, rax;
        jae aml_obby_range;
        mov rdi, r12;
        call aml_obj_base;
        add rax, r13;
        mov rdi, rax;
        call aml_obj_heap_get;
        pop r13;
        pop r12;
        ret;
      aml_obby_type:
        mov rdi, 48;                     // AML_ERR_BAD_OBJTYPE
        call aml_eval_set_err;
        xor rax, rax;
        pop r13;
        pop r12;
        ret;
      aml_obby_range:
        mov rdi, 46;                     // AML_ERR_OBJ_RANGE
        call aml_eval_set_err;
        xor rax, rax;
        pop r13;
        pop r12;
        ret
      }
    } @no_frame

  pub let aml_obj_set_byte : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (obj: u64) (i: u64) (byte: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M2-004 (#1057): write byte rdx at index rsi of String or Buffer rdi. Returns 1 on success, 0 having latched. This is the write half of the BufferField reference: `Store(0xFF, Index(BUF,3))` lands here, and it is where the truncation to ONE BYTE happens -- storing an Integer through a buffer-field reference writes the low byte and discards the rest per §19.3.5.7, which is why the source is narrowed by the mov_b at the store rather than being range-checked and refused. Same object-relative bounds check as aml_obj_byte. Locals: r12=object, r13=index, r14=byte. Reserved labels: aml_obsb_.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;
        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        call aml_obj_type;
        cmp rax, 2;
        je aml_obsb_ok;
        cmp rax, 3;
        jne aml_obsb_type;
      aml_obsb_ok:
        mov rdi, r12;
        call aml_obj_len;
        cmp r13, rax;
        jae aml_obsb_range;
        mov rdi, r12;
        call aml_obj_base;
        add rax, r13;
        mov rdi, rax;
        mov rsi, r14;
        call aml_obj_heap_set;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret;
      aml_obsb_type:
        mov rdi, 48;                     // AML_ERR_BAD_OBJTYPE
        call aml_eval_set_err;
        jmp aml_obsb_no;
      aml_obsb_range:
        mov rdi, 46;                     // AML_ERR_OBJ_RANGE
        call aml_eval_set_err;
      aml_obsb_no:
        xor rax, rax;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    } @no_frame

  pub let aml_obj_copy : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (dst: u64) (doff: u64) (src: u64) (soff: u64) (n: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M2-003 (#1056): copy rdx8 bytes from payload offset rcx of object rdx to payload offset rsi of object rdi, working in HEAP OFFSETS so a String's NUL can be copied even though it sits one past the object's recorded length. Bounds are checked ONCE, before the loop, against each object's payload extent extended by one for the NUL of a String -- checking per byte would be the same test 8000 times, and checking not at all is how a Concatenate of two strings walks into the next object. Copies LOW TO HIGH, which is safe here because a destination is always freshly allocated and therefore never overlaps a source. Locals: r12=dst base, r13=src base, r14=n, r15=cursor. Reserved labels: aml_obcp_.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 32;
        mov [rsp + 0], rdi;              // dst object
        mov [rsp + 8], rsi;              // dst offset
        mov [rsp + 16], rdx;             // src object
        mov [rsp + 24], rcx;             // src offset
        mov r14, r8;
        cmp r14, 0;
        je aml_obcp_ok;
        // destination extent
        mov rdi, [rsp + 0];
        call aml_obj_len;
        mov rcx, rax;
        mov rdi, [rsp + 0];
        call aml_obj_type;
        cmp rax, 2;
        jne aml_obcp_dchk;
        add rcx, 1;                      // a String owns its NUL
      aml_obcp_dchk:
        mov rax, [rsp + 8];
        add rax, r14;
        cmp rax, rcx;
        ja aml_obcp_range;
        // source extent
        mov rdi, [rsp + 16];
        call aml_obj_len;
        mov rcx, rax;
        mov rdi, [rsp + 16];
        call aml_obj_type;
        cmp rax, 2;
        jne aml_obcp_schk;
        add rcx, 1;
      aml_obcp_schk:
        mov rax, [rsp + 24];
        add rax, r14;
        cmp rax, rcx;
        ja aml_obcp_range;
        // heap bases
        mov rdi, [rsp + 0];
        call aml_obj_base;
        mov r12, rax;
        mov rax, [rsp + 8];
        add r12, rax;
        mov rdi, [rsp + 16];
        call aml_obj_base;
        mov r13, rax;
        mov rax, [rsp + 24];
        add r13, rax;
        xor r15, r15;
      aml_obcp_loop:
        cmp r15, r14;
        jae aml_obcp_ok;
        mov rdi, r13;
        add rdi, r15;
        call aml_obj_heap_get;
        mov rsi, rax;
        mov rdi, r12;
        add rdi, r15;
        call aml_obj_heap_set;
        add r15, 1;
        jmp aml_obcp_loop;
      aml_obcp_ok:
        mov rax, 1;
        add rsp, 32;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret;
      aml_obcp_range:
        mov rdi, 46;                     // AML_ERR_OBJ_RANGE
        call aml_eval_set_err;
        xor rax, rax;
        add rsp, 32;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Packages.
  // ==========================================================================

  pub let aml_obj_pkg_alloc : (u64) -> u64 !{mem} @{} =
    fn (n: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M2-004 (#1057): allocate a Package object of rdi element slots, every slot the null object. A run of u32 slots in a side array rather than n object records, for the same reason the name arena stores NameSegs in a run: the record stays 32 bytes and a package of 200 elements costs 200 u32 rather than 200 records. The zeroed slots are what makes an UNINITIALISED element detectable -- §20.2.5.4 allows Package(0xFF){} with no initialisers at all, and reading such an element must be AML_ERR_UNINIT_ELEMENT (50) rather than a read of object 0's zero words. The count is capped at 1024 before the add so the cursor cannot wrap. Locals: r12=n, r13=element run start, r14=object. Reserved labels: aml_obpa_.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;
        mov r12, rdi;
        lea rcx, [rip + aml_obj_state];
        mov r13, [rcx + 24];
        mov rax, r13;
        add rax, r12;
        cmp rax, r13;
        jb aml_obpa_full;
        mov rdx, 1024;
        cmp rax, rdx;
        ja aml_obpa_full;
        mov [rcx + 24], rax;
        lea rcx, [rip + aml_obj_elem];
        xor rax, rax;
        xor r15, r15;
      aml_obpa_zero:
        cmp r15, r12;
        jae aml_obpa_obj;
        mov rdx, r13;
        add rdx, r15;
        mov_d [rcx + rdx*4], rax;
        add r15, 1;
        jmp aml_obpa_zero;
      aml_obpa_obj:
        mov rdi, 4;                      // ACPI type 4 = Package
        call aml_obj_alloc;
        mov r14, rax;
        cmp r14, 0;
        je aml_obpa_fail;
        mov rdi, r14;
        mov rsi, 1;
        mov rdx, r13;
        call aml_obj_set_word;
        mov rdi, r14;
        mov rsi, 2;
        mov rdx, r12;
        call aml_obj_set_word;
        mov rax, r14;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret;
      aml_obpa_full:
        mov rdi, 44;                     // AML_ERR_OBJ_ELEM_FULL
        call aml_eval_set_err;
      aml_obpa_fail:
        xor rax, rax;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    } @no_frame

  pub let aml_obj_elem_get : (u64, u64) -> u64 !{mem} @{} =
    fn (obj: u64) (i: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M2-004 (#1057): element rsi of Package rdi as an OBJECT INDEX, 0 when the slot was never initialised. Two distinct refusals, and keeping them distinct is the point: an index at or beyond NumElements is AML_ERR_OBJ_RANGE (46) -- the table asked for an element that does not exist -- while an index WITHIN NumElements whose slot is still zero returns 0 without latching, so the caller can decide. DerefOf turns that 0 into AML_ERR_UNINIT_ELEMENT (50) and Match treats it as 'never matches', which are the two different right answers §19.6.65 and §19.6.28 give to the same condition. A non-Package is AML_ERR_BAD_OBJTYPE (48). Locals: r12=object, r13=index. Reserved labels: aml_obeg_.",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        mov r13, rsi;
        call aml_obj_type;
        cmp rax, 4;
        jne aml_obeg_type;
        mov rdi, r12;
        call aml_obj_len;
        cmp r13, rax;
        jae aml_obeg_range;
        mov rdi, r12;
        call aml_obj_base;
        add rax, r13;
        lea rcx, [rip + aml_obj_elem];
        mov_d rax, [rcx + rax*4];
        pop r13;
        pop r12;
        ret;
      aml_obeg_type:
        mov rdi, 48;                     // AML_ERR_BAD_OBJTYPE
        call aml_eval_set_err;
        jmp aml_obeg_zero;
      aml_obeg_range:
        mov rdi, 46;                     // AML_ERR_OBJ_RANGE
        call aml_eval_set_err;
      aml_obeg_zero:
        xor rax, rax;
        pop r13;
        pop r12;
        ret
      }
    } @no_frame

  pub let aml_obj_elem_set : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (obj: u64) (i: u64) (value: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M2-004 (#1057): bind element rsi of Package rdi to object rdx. Returns 1 on success, 0 having latched. This is what `Store(x, Index(PKG,n))` does, and it REPLACES the element rather than writing into it -- a package element has no fixed type, so §19.3.5.7's convert-to-the-existing-type rule does not apply to it and applying it anyway would refuse the perfectly legal a Store of a String into Index(PKG,0) on a package whose element 0 was an Integer. Same two refusals as aml_obj_elem_get. Locals: r12=object, r13=index, r14=value. Reserved labels: aml_obes_.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;
        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        call aml_obj_type;
        cmp rax, 4;
        jne aml_obes_type;
        mov rdi, r12;
        call aml_obj_len;
        cmp r13, rax;
        jae aml_obes_range;
        mov rdi, r12;
        call aml_obj_base;
        add rax, r13;
        lea rcx, [rip + aml_obj_elem];
        mov_d [rcx + rax*4], r14;
        mov rax, 1;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret;
      aml_obes_type:
        mov rdi, 48;                     // AML_ERR_BAD_OBJTYPE
        call aml_eval_set_err;
        jmp aml_obes_no;
      aml_obes_range:
        mov rdi, 46;                     // AML_ERR_OBJ_RANGE
        call aml_eval_set_err;
      aml_obes_no:
        xor rax, rax;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    } @no_frame

  // ==========================================================================
  // References.
  // ==========================================================================

  pub let aml_obj_ref : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (kind: u64) (base: u64) (index: u64) (serial: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M2-004 (#1057): allocate a Reference object of sub-kind rdi. The three payload fields mean different things per kind and the file header is the table; what is enforced HERE is only that the kind is one of the six defined, because a reference with an unknown sub-kind would be dereferenced by a chain of compares that fell through to 'not a reference' and reported AML_ERR_BAD_REF for an object that is plainly a reference. Refusing at construction gives the error at the site that got it wrong. Locals: r12..r15 = the four fields, [rsp+0] = object. Reserved labels: aml_obrf_.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 16;
        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov r15, rcx;
        cmp r12, 1;
        jb aml_obrf_bad;
        cmp r12, 6;
        ja aml_obrf_bad;
        mov rdi, 20;                     // ACPI_TYPE_LOCAL_REFERENCE
        call aml_obj_alloc;
        mov [rsp + 0], rax;
        cmp rax, 0;
        je aml_obrf_out;
        mov rdi, rax;
        mov rsi, 0;
        mov rdx, 20;
        mov rcx, r12;
        shl rcx, 16;
        or rdx, rcx;
        call aml_obj_set_word;
        mov rdi, [rsp + 0];
        mov rsi, 1;
        mov rdx, r13;
        call aml_obj_set_word;
        mov rdi, [rsp + 0];
        mov rsi, 2;
        mov rdx, r14;
        call aml_obj_set_word;
        mov rdi, [rsp + 0];
        mov rsi, 3;
        mov rdx, r15;
        call aml_obj_set_word;
      aml_obrf_out:
        mov rax, [rsp + 0];
        add rsp, 16;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret;
      aml_obrf_bad:
        mov rdi, 45;                     // AML_ERR_BAD_REF
        call aml_eval_set_err;
        xor rax, rax;
        add rsp, 16;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    } @no_frame

  // ==========================================================================
  // The binding table: which object a declaration currently holds.
  // ==========================================================================

  pub let aml_obj_bind_get : (u64) -> u64 !{mem} @{} =
    fn (node: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M2-004 (#1057): the object arena node rdi is currently bound to, 0 meaning 'not materialised yet -- read the declaration'. Bounds-checked against the 512-node arena capacity, which is the same capacity the table is sized to, so the check and the array cannot drift. Reserved labels: aml_obbg_.",
      block: {
        cmp rdi, 512;
        jae aml_obbg_zero;
        lea rcx, [rip + aml_obj_bind];
        mov_d rax, [rcx + rdi*4];
        ret;
      aml_obbg_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let aml_obj_bind_set : (u64, u64) -> u64 !{mem} @{} =
    fn (node: u64) (obj: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M2-004 (#1057): bind arena node rdi to object rsi. Returns 1 on success. THIS IS THE ONLY WAY A STORE BECOMES VISIBLE, and it is the reason the node arena stays immutable: `Store(7, FOO)` writes here, not into FOO's record, so the parse tree that goes over IPC is the same bytes it was before the method ran. Zeroed wholesale by aml_obj_reset, which is what makes each evaluation session start from the declarations again. Reserved labels: aml_obbs_.",
      block: {
        cmp rdi, 512;
        jae aml_obbs_no;
        lea rcx, [rip + aml_obj_bind];
        mov_d [rcx + rdi*4], rsi;
        mov rax, 1;
        ret;
      aml_obbs_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Bounded reads of the AML source buffer, for materialising declarations.
  // ==========================================================================

  pub let aml_obj_src_u8 : (u64) -> u64 !{mem} @{} =
    fn (off: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M2-003 (#1056): the byte at absolute offset rdi of the bound AML buffer, for materialising a String or Buffer declaration whose payload the parser deliberately did NOT copy into the arena (design/acpi/aml-parser.md: src_off is what keeps the node record 32 bytes wide). The offset is compared against aml_lex_len BEFORE the seek, so an out-of-range materialisation is AML_ERR_OBJ_RANGE (46) rather than an EOF latched into the PARSE slot -- a parse latch at evaluation time would be attributed to the table's syntax, which it is not. The cursor is saved and restored, so this may be called at any point without disturbing a parse in progress; it is the same discipline as aml_res_read and for the same reason. Locals: r12=offset, r13=saved cursor. Reserved labels: aml_obsu_.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;
        mov r12, rdi;
        call aml_lex_len;
        cmp r12, rax;
        jae aml_obsu_range;
        call aml_lex_pos;
        mov r13, rax;
        mov rdi, r12;
        call aml_lex_seek;
        cmp rax, 0;
        jne aml_obsu_restore;            // aml_lex_seek returns 0 on SUCCESS
        call aml_lex_u8;
        mov r14, rax;
        mov rdi, r13;
        call aml_lex_seek;
        mov rax, r14;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret;
      aml_obsu_restore:
        mov rdi, r13;
        call aml_lex_seek;
      aml_obsu_range:
        mov rdi, 46;                     // AML_ERR_OBJ_RANGE
        call aml_eval_set_err;
        xor rax, rax;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    } @no_frame

}
