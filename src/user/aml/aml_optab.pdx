// src/user/aml/aml_optab.pdx — R30.M1-001 (#1049)
//
// Data-driven AML opcode table per ACPI 6.5 §20.2.3.
//
// PLACEMENT — CONSTITUTIONAL
// -------------------------
// Userspace only. See design/acpi/no-aml-in-kernel.md.
//
// WHY A TABLE AND NOT A MATCH
// ---------------------------
// AML has roughly 120 opcodes and this milestone implements the fifteen
// or so that define namespace objects. #1051 adds control flow, #1052
// adds data objects, and R30.M2 adds the evaluator. If opcode dispatch
// were a chain of compares, each of those issues would edit CONTROL FLOW
// in a hot recursive function, and each edit would be a chance to
// mis-order a branch or drop a case.
//
// Instead there is one sorted array of packed descriptors and one binary
// search. Adding an opcode is adding a ROW. The parser's structure does
// not change as the implemented subset grows; only the data does, and the
// self-check below mechanically rejects a badly-formed row.
//
// The table is complete for single-byte and 0x5B-escape opcodes as of
// ACPI 6.5, not just for the subset this milestone parses. That
// completeness is what makes the two rejection codes mean different
// things:
//
//   AML_ERR_UNKNOWN_OPCODE (5)  the byte is not an AML opcode at all —
//                               the table has been consulted and the
//                               stream is corrupt or misaligned.
//   AML_ERR_UNEXPECTED_OP (10)  the byte IS a valid opcode, but this
//                               milestone does not parse it.
//
// Collapsing those two into one code would make a genuinely corrupt table
// indistinguishable from an unimplemented feature, which is exactly the
// distinction an operator needs when a machine fails to boot.
//
// ENTRY ENCODING (u64)
// --------------------
//   [15:0]  op16       normalised opcode: 0x00NN for a single-byte
//                      opcode, 0x5BNN for an ExtOpPrefix escape. The
//                      normalisation performed by aml_lex_opcode is what
//                      lets both live in ONE sorted array.
//   [23:16] class      1 NAMESPACE, 2 DATA, 3 CONTROL, 4 EXPR, 5 ARG,
//                      6 LOCAL, 7 MISC, 8 NAMELEAD. Never 0, so a packed
//                      entry is never all-zero and 0 is usable as the
//                      "not found" return.
//   [31:24] flags      0x01 F_PKGLEN     a PkgLength follows the opcode
//                      0x02 F_NAMESTR    a NameString follows
//                      0x04 F_FLAGBYTE   a flags ByteData follows the name
//                      0x08 F_TERMLIST   the package body is a TermList
//                      0x10 F_FIELDLIST  the package body is a FieldList
//                      0x20 F_EXTOP      opcode is a 0x5B escape
//                      0x40 F_M1_HANDLED parsed by R30.M1-002
//                      0x80 F_OPAQUE_OK  safe to skip via its PkgLength
//   [39:32] argc       fixed TermArg count. Informational at M1; #1051
//                      and #1052 consume it.
//   [47:40] node       AML_NODE_* to allocate, 0 for none.
//   [63:48] reserved, zero.
//
// F_OPAQUE_OK IS THE SAFETY HINGE
// -------------------------------
// An opcode this milestone does not parse can be handled in exactly one
// of two ways. If it carries a PkgLength, its extent is self-describing:
// the parser records an AML_NODE_OPAQUE covering the package and skips
// it, which is sound because the length has already been bounds-checked
// against the buffer. If it does NOT carry a PkgLength, its extent is
// only knowable by decoding its operands — and guessing a skip distance
// would silently resynchronise the parser at the wrong byte, producing a
// plausible but wrong namespace. So those are refused outright with
// AML_ERR_UNEXPECTED_OP. Buffer, Package, VarPackage, If, Else and While
// are the six opcodes that carry F_OPAQUE_OK today; #1051 and #1052
// replace the opaque treatment with real parsing by changing their rows
// and adding handlers, not by touching the skip logic.
//
// SELF-CHECK
// ----------
// aml_optab_selfcheck walks the table asserting the invariants the binary
// search and the parser depend on: strictly ascending op16 (a single
// out-of-order row would make lookups silently miss), class in range,
// F_TERMLIST implies F_PKGLEN, F_FIELDLIST implies F_PKGLEN and
// F_FLAGBYTE, and every op16 above 0xFF carries F_EXTOP with a 0x5B high
// byte. The harness runs it before every fixture, so a malformed row
// added by a later issue fails the build rather than corrupting a parse.

module AmlOptab = structure {

  pub let aml_optab_len : u64 = 113

  pub let aml_optab : [u64; 113] = [
    0x0000000000020000,  // 0x000  ZeroOp
    0x0000000000020001,  // 0x001  OneOp
    0x0000060042010006,  // 0x006  AliasOp -- NameString NameString
    0x0000050042010008,  // 0x008  NameOp -- NameString DataRefObject
    0x000000000002000A,  // 0x00A  BytePrefix
    0x000000000002000B,  // 0x00B  WordPrefix
    0x000000000002000C,  // 0x00C  DWordPrefix
    0x000000000002000D,  // 0x00D  StringPrefix
    0x000000000002000E,  // 0x00E  QWordPrefix
    0x000002004B010010,  // 0x010  ScopeOp
    0x0000000081020011,  // 0x011  BufferOp
    0x0000000081020012,  // 0x012  PackageOp
    0x0000000081020013,  // 0x013  VarPackageOp
    0x000004004F010014,  // 0x014  MethodOp
    0x00000F0042010015,  // 0x015  ExternalOp -- NameString ObjType ArgCount
    0x0000000000060060,  // 0x060  Local0Op
    0x0000000000060061,  // 0x061  Local1Op
    0x0000000000060062,  // 0x062  Local2Op
    0x0000000000060063,  // 0x063  Local3Op
    0x0000000000060064,  // 0x064  Local4Op
    0x0000000000060065,  // 0x065  Local5Op
    0x0000000000060066,  // 0x066  Local6Op
    0x0000000000060067,  // 0x067  Local7Op
    0x0000000000050068,  // 0x068  Arg0Op
    0x0000000000050069,  // 0x069  Arg1Op
    0x000000000005006A,  // 0x06A  Arg2Op
    0x000000000005006B,  // 0x06B  Arg3Op
    0x000000000005006C,  // 0x06C  Arg4Op
    0x000000000005006D,  // 0x06D  Arg5Op
    0x000000000005006E,  // 0x06E  Arg6Op
    0x0000000200040070,  // 0x070  StoreOp
    0x0000000100040071,  // 0x071  RefOfOp
    0x0000000300040072,  // 0x072  AddOp
    0x0000000300040073,  // 0x073  ConcatOp
    0x0000000300040074,  // 0x074  SubtractOp
    0x0000000100040075,  // 0x075  IncrementOp
    0x0000000100040076,  // 0x076  DecrementOp
    0x0000000300040077,  // 0x077  MultiplyOp
    0x0000000400040078,  // 0x078  DivideOp
    0x0000000300040079,  // 0x079  ShiftLeftOp
    0x000000030004007A,  // 0x07A  ShiftRightOp
    0x000000030004007B,  // 0x07B  AndOp
    0x000000030004007C,  // 0x07C  NandOp
    0x000000030004007D,  // 0x07D  OrOp
    0x000000030004007E,  // 0x07E  NorOp
    0x000000030004007F,  // 0x07F  XorOp
    0x0000000200040080,  // 0x080  NotOp
    0x0000000200040081,  // 0x081  FindSetLeftBitOp
    0x0000000200040082,  // 0x082  FindSetRightBitOp
    0x0000000100040083,  // 0x083  DerefOfOp
    0x0000000300040084,  // 0x084  ConcatResOp
    0x0000000300040085,  // 0x085  ModOp
    0x0000000200040086,  // 0x086  NotifyOp
    0x0000000100040087,  // 0x087  SizeOfOp
    0x0000000300040088,  // 0x088  IndexOp
    0x0000000600040089,  // 0x089  MatchOp
    0x000000030004008A,  // 0x08A  CreateDWordFieldOp
    0x000000030004008B,  // 0x08B  CreateWordFieldOp
    0x000000030004008C,  // 0x08C  CreateByteFieldOp
    0x000000030004008D,  // 0x08D  CreateBitFieldOp
    0x000000010004008E,  // 0x08E  ObjectTypeOp
    0x000000030004008F,  // 0x08F  CreateQWordFieldOp
    0x0000000200040090,  // 0x090  LandOp
    0x0000000200040091,  // 0x091  LorOp
    0x0000000100040092,  // 0x092  LnotOp
    0x0000000200040093,  // 0x093  LEqualOp
    0x0000000200040094,  // 0x094  LGreaterOp
    0x0000000200040095,  // 0x095  LLessOp
    0x0000000200040096,  // 0x096  ToBufferOp
    0x0000000200040097,  // 0x097  ToDecimalStringOp
    0x0000000200040098,  // 0x098  ToHexStringOp
    0x0000000200040099,  // 0x099  ToIntegerOp
    0x000000030004009C,  // 0x09C  ToStringOp
    0x000000020004009D,  // 0x09D  CopyObjectOp
    0x000000040004009E,  // 0x09E  MidOp
    0x000000000003009F,  // 0x09F  ContinueOp
    0x00000000810300A0,  // 0x0A0  IfOp
    0x00000000810300A1,  // 0x0A1  ElseOp
    0x00000000810300A2,  // 0x0A2  WhileOp
    0x00000000000300A3,  // 0x0A3  NoopOp
    0x00000001000300A4,  // 0x0A4  ReturnOp
    0x00000000000300A5,  // 0x0A5  BreakOp
    0x00000000000300CC,  // 0x0CC  BreakPointOp
    0x00000000000200FF,  // 0x0FF  OnesOp
    0x0000110066015B01,  // 0x5B01 MutexOp -- NameString SyncFlags
    0x0000120062015B02,  // 0x5B02 EventOp -- NameString
    0x0000000220045B12,  // 0x5B12 CondRefOfOp
    0x0000000420045B13,  // 0x5B13 CreateFieldOp
    0x0000000620045B1F,  // 0x5B1F LoadTableOp
    0x0000000220045B20,  // 0x5B20 LoadOp
    0x0000000120045B21,  // 0x5B21 StallOp
    0x0000000120045B22,  // 0x5B22 SleepOp
    0x0000000220045B23,  // 0x5B23 AcquireOp
    0x0000000120045B24,  // 0x5B24 SignalOp
    0x0000000220045B25,  // 0x5B25 WaitOp
    0x0000000120045B26,  // 0x5B26 ResetOp
    0x0000000120045B27,  // 0x5B27 ReleaseOp
    0x0000000220045B28,  // 0x5B28 FromBCDOp
    0x0000000220045B29,  // 0x5B29 ToBCDOp
    0x0000000120045B2A,  // 0x5B2A UnloadOp
    0x0000000020075B30,  // 0x5B30 RevisionOp
    0x0000000020075B31,  // 0x5B31 DebugOp
    0x0000000320045B32,  // 0x5B32 FatalOp
    0x0000000020075B33,  // 0x5B33 TimerOp
    0x00000A0062015B80,  // 0x5B80 OpRegionOp -- NameString RegionSpace RegionOffset RegionLen
    0x00000B0077015B81,  // 0x5B81 FieldOp
    0x000003006B015B82,  // 0x5B82 DeviceOp
    0x000007006B015B83,  // 0x5B83 ProcessorOp -- + ProcID PblkAddr PblkLen
    0x000008006B015B84,  // 0x5B84 PowerResOp -- + SystemLevel ResourceOrder
    0x000009006B015B85,  // 0x5B85 ThermalZoneOp
    0x00000C0077015B86,  // 0x5B86 IndexFieldOp
    0x00000D0077015B87,  // 0x5B87 BankFieldOp
    0x0000000022015B88  // 0x5B88 DataRegionOp -- deferred to #1052 (three TermArgs)
  ]

  // ==========================================================================
  // aml_optab_find(op16) -> packed entry, or 0 when the opcode is unknown.
  //
  // Binary search over the sorted table. Returning 0 for "not found" is
  // safe because every real entry carries a non-zero class field, so no
  // legitimate entry can pack to zero.
  // ==========================================================================
  pub let aml_optab_find : (u64) -> u64 !{mem} @{} =
    fn (op16: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-001 (#1049): binary search aml_optab for the normalised 16-bit opcode in rdi, returning the packed descriptor or 0. Half-open [lo, hi) interval: mid = lo + (hi-lo)/2 computed as a subtraction then shift, which cannot overflow for any table size and does not depend on lo+hi staying in range. A match returns the entry directly rather than an index, so the parser never has to re-index the table and no second bounds check is needed. Returning 0 for a miss is unambiguous because the class field of every real row is non-zero by construction and aml_optab_selfcheck enforces it. Locals: r12=lo, r13=hi, r14=key, r15=table base. Reserved labels: aml_of_.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;
        mov r14, rdi;
        and r14, 0xFFFF;
        xor r12, r12;
        lea rcx, [rip + aml_optab_len];
        mov r13, [rcx];
        lea r15, [rip + aml_optab];
      aml_of_loop:
        cmp r12, r13;
        jae aml_of_miss;
        mov rax, r13;
        sub rax, r12;
        shr rax, 1;
        add rax, r12;                    // mid
        mov rdx, [r15 + rax*8];
        mov rcx, rdx;
        and rcx, 0xFFFF;
        cmp rcx, r14;
        je aml_of_hit;
        jb aml_of_right;
        mov r13, rax;                    // hi = mid
        jmp aml_of_loop;
      aml_of_right:
        mov r12, rax;
        add r12, 1;                      // lo = mid + 1
        jmp aml_of_loop;
      aml_of_hit:
        mov rax, rdx;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret;
      aml_of_miss:
        xor rax, rax;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Field extractors for a packed entry.
  // ==========================================================================

  pub let aml_optab_op : (u64) -> u64 !{} @{} =
    fn (entry: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R30.M1-001 (#1049): extract [15:0] of a packed opcode-table entry -- the normalised op16. Pure. Reserved labels: none.",
      block: {
        mov rax, rdi;
        and rax, 0xFFFF;
        ret
      }
    } @no_frame

  pub let aml_optab_class : (u64) -> u64 !{} @{} =
    fn (entry: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R30.M1-001 (#1049): extract [23:16] -- the opcode class (1 NAMESPACE .. 8 NAMELEAD). Pure. Reserved labels: none.",
      block: {
        mov rax, rdi;
        shr rax, 16;
        and rax, 0xFF;
        ret
      }
    } @no_frame

  pub let aml_optab_flags : (u64) -> u64 !{} @{} =
    fn (entry: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R30.M1-001 (#1049): extract [31:24] -- the structural flag byte that tells the parser what syntactically follows the opcode. Pure. Reserved labels: none.",
      block: {
        mov rax, rdi;
        shr rax, 24;
        and rax, 0xFF;
        ret
      }
    } @no_frame

  pub let aml_optab_argc : (u64) -> u64 !{} @{} =
    fn (entry: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R30.M1-001 (#1049): extract [39:32] -- the fixed TermArg count. Carried now and consumed by #1051/#1052 so that adding expression parsing is a data-driven walk rather than another per-opcode branch. Pure. Reserved labels: none.",
      block: {
        mov rax, rdi;
        shr rax, 32;
        and rax, 0xFF;
        ret
      }
    } @no_frame

  pub let aml_optab_node : (u64) -> u64 !{} @{} =
    fn (entry: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R30.M1-001 (#1049): extract [47:40] -- the AML_NODE_* kind this opcode allocates, 0 for none. The parser dispatches on THIS rather than on the opcode, which is what keeps the dispatch chain proportional to the number of node SHAPES (about a dozen) instead of the number of opcodes (over a hundred). Pure. Reserved labels: none.",
      block: {
        mov rax, rdi;
        shr rax, 40;
        and rax, 0xFF;
        ret
      }
    } @no_frame

  // ==========================================================================
  // aml_optab_selfcheck() -> 0 when the table is well-formed, otherwise
  // (index + 1) of the first offending row.
  // ==========================================================================
  pub let aml_optab_selfcheck : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M1-001 (#1049): validate the invariants aml_optab_find and the parser depend on, returning 0 or the 1-based index of the first bad row. Checks, in order: (1) op16 strictly ascending -- a single out-of-order row makes the binary search silently miss opcodes rather than fail loudly, which is the worst possible failure mode for a table meant to be extended by three later issues; (2) class in 1..8, which also guarantees no real entry packs to zero and therefore that 0 is a safe not-found sentinel; (3) F_TERMLIST implies F_PKGLEN, because a TermList body has no other way to know where it ends; (4) F_FIELDLIST implies F_PKGLEN and F_FLAGBYTE, matching §20.2.5.2 where every field-list construct is PkgLength NameString FieldFlags FieldList; (5) any op16 above 0xFF must carry F_EXTOP and have 0x5B as its high byte, since that is the only two-byte form AML defines. The flag byte is parked on the stack across the flag checks and popped on both the pass and fail paths, so the two failure labels differ only in whether they pop first. Locals: r12=index, r13=previous op16, r14=table length, r15=table base. Reserved labels: aml_sc_.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;
        lea rcx, [rip + aml_optab_len];
        mov r14, [rcx];
        lea r15, [rip + aml_optab];
        xor r12, r12;
        xor r13, r13;
      aml_sc_loop:
        cmp r12, r14;
        jae aml_sc_ok;
        mov rdx, [r15 + r12*8];
        mov rcx, rdx;
        and rcx, 0xFFFF;                 // op16
        cmp r12, 0;
        je aml_sc_noprev;
        cmp rcx, r13;
        jbe aml_sc_bad;                  // must be strictly ascending
      aml_sc_noprev:
        mov r13, rcx;
        mov rax, rdx;
        shr rax, 16;
        and rax, 0xFF;                   // class
        cmp rax, 1;
        jb aml_sc_bad;
        cmp rax, 8;
        ja aml_sc_bad;
        mov rax, rdx;
        shr rax, 24;
        and rax, 0xFF;                   // flags
        push rax;
        mov r8, rax;
        and r8, 0x08;                    // F_TERMLIST
        cmp r8, 0;
        je aml_sc_f2;
        mov r8, rax;
        and r8, 0x01;                    // requires F_PKGLEN
        cmp r8, 0;
        je aml_sc_bad_pop;
      aml_sc_f2:
        mov r8, rax;
        and r8, 0x10;                    // F_FIELDLIST
        cmp r8, 0;
        je aml_sc_f3;
        mov r8, rax;
        and r8, 0x05;                    // requires F_PKGLEN | F_FLAGBYTE
        cmp r8, 0x05;
        jne aml_sc_bad_pop;
      aml_sc_f3:
        cmp rcx, 0x100;
        jb aml_sc_f4;
        mov r8, rax;
        and r8, 0x20;                    // F_EXTOP
        cmp r8, 0;
        je aml_sc_bad_pop;
        mov r8, rcx;
        shr r8, 8;
        cmp r8, 0x5B;                    // ExtOpPrefix
        jne aml_sc_bad_pop;
      aml_sc_f4:
        pop rax;
        add r12, 1;
        jmp aml_sc_loop;
      aml_sc_bad_pop:
        pop rax;
      aml_sc_bad:
        mov rax, r12;
        add rax, 1;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret;
      aml_sc_ok:
        xor rax, rax;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    } @no_frame
}
