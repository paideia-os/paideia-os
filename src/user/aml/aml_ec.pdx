// src/user/aml/aml_ec.pdx — R30.M7-001/002/003 (#1079 / #1080 / #1081)
//
// The Embedded Controller: the OperationRegion transaction that opens the
// gate #1065 left shut, the _Qxx query dispatch, and the serialization
// discipline that has to hold both of them at once.
//
// Full rationale: design/acpi/embedded-controller.md. The sections that
// cannot be reconstructed from the code are reproduced here.
//
// =====================================================================
// WHY THIS IS ONE MODULE AND NOT THREE
// =====================================================================
// The transaction, the query and the lock are three descriptions of one
// mechanism, and the dependency between them runs the wrong way for
// separate design: the serialization scheme is what decides whether the
// query path is EXPRESSIBLE, and the query path is the only caller that
// re-enters the transaction path from inside its own episode.
//
// A serialization scheme designed against the OperationRegion handler
// alone is a plain mutex. A plain mutex makes the query path deadlock.
// That is not an edge case -- on a T14 it is what happens the first time
// the lid is closed.
//
// =====================================================================
// THE REENTRANCY DECISION -- read this before changing anything here
// =====================================================================
// _Qxx methods read and write EC registers. That is what they are FOR:
// a lid _Qxx reads the lid state byte out of EC space. So the query path
// necessarily looks like this:
//
//   SCI, SCI_EVT set in the EC status byte
//     -> QR_EC (0x84), read query byte xx
//     -> dispatch _Qxx
//          -> _Qxx executes AML that touches the EC OperationRegion
//               -> BACK INTO THE TRANSACTION PATH
//
// Hold a transaction lock across the dispatch and the last step
// deadlocks against the lock the dispatch itself holds. Drop it before
// the dispatch and an unrelated transaction can interleave with the
// query -- and the EC has ONE outstanding transaction and no arbitration
// of its own, so both are corrupted. Neither naive option is right.
//
// THE DECISION: two claims, at two granularities, with different
// lifetimes. Conflating them is the bug.
//
//   THE TRANSACTION CLAIM (aml_ec_state[+32], "xact_busy") covers
//   EXACTLY ONE REGISTER HANDSHAKE -- command byte, address byte, data
//   byte -- and nothing else. Taken at the top of aml_ec_xact, released
//   on EVERY exit path including every timeout, and NEVER held across a
//   call into the interpreter.
//
//   THE EPISODE CLAIM (aml_ec_state[+40] / [+48]) covers a query from
//   the QR_EC that produced the byte to the return of the _Qxx it
//   selected. It is a COARSER AND WEAKER claim: it does not exclude
//   transactions, it ADMITS them. That is its entire purpose.
//
// The invariant that makes the query path work:
//
//     WHEN _Qxx RUNS, xact_busy IS 0 AND episode IS NON-ZERO.
//
// The QR_EC transaction takes and releases xact_busy like any other
// transaction, BEFORE the dispatch. The dispatch then happens with the
// transaction claim free, so the _Qxx body's EC reads acquire it
// normally and complete. The episode claim stays held throughout, which
// is what records that a query is in flight and what bounds nesting.
//
// WHY xact_busy IS STILL CHECKED, given nothing can trip it today. In a
// single-threaded interpreter the reentrant case is unreachable through
// any legitimate path -- which is precisely why it is worth asserting.
// It catches a future issue that "just adds a quick EC read" inside the
// handshake, a second thread in the supervisor, and most likely of all a
// later refactor that decides to hold the lock across the dispatch after
// all. The corpus trips it deliberately through the synthetic EC's probe
// hook (aml_ec_state[+200]) and asserts the OUTER TRANSACTION STILL
// COMPLETES -- a reentrancy guard that poisoned the transaction it fired
// inside would be worse than the bug it guards against.
//
// =====================================================================
// TIMEOUTS ARE NOT OPTIONAL, AND THE WITNESS IS THE POINT
// =====================================================================
// The EC is slow -- transactions take milliseconds -- and a wedged EC
// that never sets OBF hangs an unbounded poll forever, in a path that
// battery and thermal code call routinely. Every wait on IBF/OBF is
// bounded by AML_EC_POLL_MAX.
//
// A test suite in which the fake EC always answers proves NOTHING about
// the path that matters, because the failure being guarded is precisely
// the one where it does not. So the synthetic EC carries two wedge
// modes -- AML_EC_WEDGE_IBF (never clears IBF) and AML_EC_WEDGE_OBF
// (never sets OBF) -- and the corpus asserts that each produces a
// REFUSAL WITH ITS OWN CODE, that the refusal is counted, and that
// xact_busy is CLEAR afterwards. A timeout that left the claim held
// would turn one wedged transaction into a permanently dead EC path,
// which is the same defect as no timeout at all arriving one transaction
// later.
//
// THE BOUND IS IN ITERATIONS, NOT TIME, and that is a limitation worth
// naming rather than hiding: this process has no timer. AML_EC_POLL_MAX
// port reads is a bound on WORK, and on real hardware the wall time it
// corresponds to depends on the platform's port latency. It is a real
// bound -- the loop terminates -- but converting it to a millisecond
// bound needs a clock the supervisor does not yet have.
//
// =====================================================================
// BURST MODE IS NOT IMPLEMENTED
// =====================================================================
// BE_EC (0x82) and BD_EC (0x83) are named below and deliberately unused.
// The reason is stated rather than left unmentioned: THE EC EXITS BURST
// AUTONOMOUSLY after roughly a millisecond of inactivity, with no
// notification. Code that enters burst and then assumes it is still in
// burst is wrong in a way that shows up only under load -- exactly the
// class of bug a corpus running at full speed against a synthetic EC
// would never reproduce. Burst is a throughput optimisation for
// multi-byte sequences and nothing here has one. If it is ever added it
// must re-check BURST before every step that assumes it, and the
// synthetic EC must model the autonomous exit.
//
// =====================================================================
// THE PORTS ARE NOT HARDCODED
// =====================================================================
// 0x62 and 0x66 are CONVENTIONAL, and wrong on machines that relocate
// them. Both ports come from the EC device's _CRS by way of
// aml_ec_attach, and until that has been called every transaction
// refuses with AML_ERR_EC_UNBOUND rather than transacting against a
// guess. The same call binds the NAMESPACE SCOPE that _Qxx is resolved
// in, which is why aml_ec_query_pump has arity zero: a caller-supplied
// scope would let a query dispatch some OTHER device's _Q80.
//
// Port access itself stays confined to aml_region_port_in and
// aml_region_port_out -- still the only two functions in this repository
// containing in/out, still asserted by tools/verify-aml-parser.sh. This
// module calls them; it contains no port instruction.

module AmlEc = structure {

  // ==========================================================================
  // ACPI 6.5 §12.2 -- commands and status bits
  // ==========================================================================

  pub let AML_EC_CMD_RD : u64 = 0x80          // read  EC space
  pub let AML_EC_CMD_WR : u64 = 0x81          // write EC space
  pub let AML_EC_CMD_BE : u64 = 0x82          // burst enable  -- NOT USED
  pub let AML_EC_CMD_BD : u64 = 0x83          // burst disable -- NOT USED
  pub let AML_EC_CMD_QR : u64 = 0x84          // query

  pub let AML_EC_STS_OBF   : u64 = 0x01
  pub let AML_EC_STS_IBF   : u64 = 0x02
  pub let AML_EC_STS_CMD   : u64 = 0x08
  pub let AML_EC_STS_BURST : u64 = 0x10
  pub let AML_EC_STS_SCI   : u64 = 0x20
  pub let AML_EC_STS_SMI   : u64 = 0x40

  // ==========================================================================
  // Refusal codes. Continuing aml_region.pdx's numbering: 62, 65, 66 and
  // 67 are taken there. Distinct causes get distinct codes, because the
  // whole value of a refusal is that the operator can tell which one it
  // was: an input buffer that never drains and an output buffer that
  // never fills are different hardware faults with different fixes.
  // ==========================================================================

  pub let AML_ERR_EC_UNBOUND     : u64 = 68
  pub let AML_ERR_EC_TIMEOUT_IBF : u64 = 69
  pub let AML_ERR_EC_TIMEOUT_OBF : u64 = 70
  pub let AML_ERR_EC_STATUS      : u64 = 71
  pub let AML_ERR_EC_RANGE       : u64 = 72
  pub let AML_ERR_EC_REENTRANT   : u64 = 73
  pub let AML_ERR_EC_QUERY_DEPTH : u64 = 74
  pub let AML_ERR_EC_BAD_OP      : u64 = 75

  // ==========================================================================
  // Bounds and shapes
  // ==========================================================================

  pub let AML_EC_POLL_MAX        : u64 = 20000
  pub let AML_EC_QUERY_MAX_DEPTH : u64 = 4
  pub let AML_EC_SPACE_MAX       : u64 = 256

  pub let AML_EC_OP_READ  : u64 = 1
  pub let AML_EC_OP_WRITE : u64 = 2

  // A transaction returns the byte read (0..255) or 1 for a completed
  // write. Failure is a value no successful transaction can produce, so
  // one call yields both the outcome and the value -- and a caller that
  // forgets to check cannot mistake a refusal for data, which is what a
  // 0-on-failure convention would allow on a register that reads 0.
  pub let AML_EC_XACT_FAIL : u64 = 0xFFFFFFFFFFFFFFFF

  pub let AML_EC_MODE_PORT  : u64 = 0
  pub let AML_EC_MODE_SYNTH : u64 = 1

  pub let AML_EC_WEDGE_NONE : u64 = 0
  pub let AML_EC_WEDGE_IBF  : u64 = 1
  pub let AML_EC_WEDGE_OBF  : u64 = 2

  // The EC signals a response while its input buffer still holds the
  // address byte it was given -- i.e. it never consumed the address, so
  // whatever is in the output buffer is not the answer to the question
  // that was asked. This is a DIFFERENT FAULT from either timeout and it
  // is the one that produces plausible wrong data rather than a hang,
  // which is why it gets its own wedge and its own refusal code.
  pub let AML_EC_WEDGE_STUCK_ADDR : u64 = 3

  // Query pump outcomes. 0 and 2 are counted separately for the reason
  // evt_stream.pdx counts drops separately from unrouted: "nothing was
  // pending" and "something was pending and the table defines no handler
  // for it" are different conditions with different fixes, and summing
  // them makes a quiet machine indistinguishable from an incomplete one.
  pub let AML_EC_Q_NONE       : u64 = 0
  pub let AML_EC_Q_DISPATCHED : u64 = 1
  pub let AML_EC_Q_NO_METHOD  : u64 = 2

  // ==========================================================================
  // Module storage. Confined to this object; tools/verify-aml-parser.sh
  // asserts it, for the reason aml_region_ec_state is confined: a second
  // writer could forge a transaction count or clear the transaction claim
  // out from under a handshake in progress.
  //
  // aml_ec_state byte offsets:
  //    +0 mode              +8 data port        +16 cmd port
  //   +24 bound            +32 xact_busy        +40 episode
  //   +48 episode depth    +56 xacts committed  +64 glk enters
  //   +72 glk leaves       +80 xacts attempted  +88 queries seen
  //   +96 queries dispatched                   +104 queries zero
  //  +112 queries w/o method                   +120 IBF timeouts
  //  +128 OBF timeouts     +136 status refusals +144 range refusals
  //  +152 reentrant refusals                   +160 depth refusals
  //  +168 unbound refusals +176 bad-op refusals +184 scope node
  //  +192 last query byte  +200 reentrancy probe
  //  +208 reentrancy probe result              +216 polls on last wait
  //  +224 GLK-denied transactions (R30.M8-001, #1082)
  // ==========================================================================

  pub let mut aml_ec_state : [u64; 32]  = uninit @align(64)

  // The synthetic EC. Byte offsets:
  //   +0 status   +8 data (output buffer)   +16 phase   +24 wedge
  //  +32 pending query   +40 latched address   +48 RAM writes seen
  //
  // Phases: 0 idle, 1 RD awaiting address, 2 WR awaiting address,
  //         3 WR awaiting data.
  pub let mut aml_ec_synth : [u64; 8]   = uninit @align(64)

  // 256 bytes of EC space, one byte per word. A word per byte costs 2 KiB
  // and buys the ability to store a sentinel outside 0..255 in a slot,
  // which the corpus uses to prove a transaction touched the byte it
  // named and not its neighbour.
  pub let mut aml_ec_ram : [u64; 256]   = uninit @align(64)

  // ==========================================================================
  // aml_ec_reset() -- clear the driver's session state.
  //
  // The BINDING (ports, scope) and the committed-transaction count
  // deliberately survive, for the reason aml_region_ec_state[0] and [1]
  // survive aml_region_reset: which ports the EC is on is a system fact,
  // not a per-session one, and "this process has never performed an EC
  // transaction" is a whole-process claim.
  // ==========================================================================

  pub let aml_ec_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M7-003 (#1081): clear the per-session counters and the two claims, leaving the port/scope binding and the lifetime transaction count intact. Clearing xact_busy here is deliberate and is the ONLY place other than aml_ec_xact's own exits that touches it: a corpus fixture that has just witnessed a timeout must be able to start the next fixture from a known state without the timeout's claim leaking into it. Leaf; a fixed-length store loop over the counter block. Labels prefixed aml_ecr_ per reserved-label discipline.",
      block: {
        lea rcx, [rip + aml_ec_state];
        xor rax, rax;
        mov [rcx + 32], rax;             // xact_busy
        mov [rcx + 40], rax;             // episode
        mov [rcx + 48], rax;             // episode depth
        mov [rcx + 64], rax;             // glk enters
        mov [rcx + 72], rax;             // glk leaves
        mov [rcx + 80], rax;             // attempted
        mov [rcx + 88], rax;
        mov [rcx + 96], rax;
        mov [rcx + 104], rax;
        mov [rcx + 112], rax;
        mov [rcx + 120], rax;
        mov [rcx + 128], rax;
        mov [rcx + 136], rax;
        mov [rcx + 144], rax;
        mov [rcx + 152], rax;
        mov [rcx + 160], rax;
        mov [rcx + 168], rax;
        mov [rcx + 176], rax;
        mov [rcx + 192], rax;
        mov [rcx + 200], rax;
        mov [rcx + 208], rax;
        mov [rcx + 216], rax;
        mov [rcx + 224], rax;            // GLK-denied (R30.M8-001, #1082)
        ret
      }
    } @no_frame

  // ==========================================================================
  // aml_ec_attach(device_node, data_port, cmd_port) -> 1 | 0
  //
  // THE BINDING STEP, and the only writer of the ports and the scope.
  // Both ports come from the EC device's _CRS; this function does not
  // supply defaults, because a default here is a transaction against a
  // guessed port on a machine that relocated them.
  //
  // It also registers this module's transaction entry with aml_region,
  // which is what OPENS THE #1065 GATE. That call is the single
  // relocation against aml_region_ec_backing_set in the whole tree, and
  // tools/verify-aml-parser.sh pins it at exactly one from this object.
  // ==========================================================================

  pub let aml_ec_attach : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (device_node: u64) (data_port: u64) (cmd_port: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M7-001 (#1079): bind the EC's two ports and its namespace scope, and register the transaction entry that opens the #1065 gate. Refuses a zero device node or a zero port rather than binding a placeholder: a zero cmd port would send every command byte to port 0, and a zero scope would make every _Qxx resolve from the root and run whatever _Q80 the table happens to define anywhere. The three refusals are one branch because they are one condition -- 'the caller does not actually know where the EC is'. Registration is LAST, after the binding is complete, so the gate is never open over a half-built binding. Locals: r12=node, r13=data, r14=cmd. Labels prefixed aml_eca_ per reserved-label discipline.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;

        cmp r12, 0;
        je aml_eca_bad;
        cmp r13, 0;
        je aml_eca_bad;
        cmp r14, 0;
        je aml_eca_bad;

        lea rcx, [rip + aml_ec_state];
        mov [rcx + 184], r12;            // scope node
        mov [rcx + 8], r13;              // data port
        mov [rcx + 16], r14;             // cmd port
        mov rax, 1;
        mov [rcx + 24], rax;             // bound

        // OPEN THE GATE. aml_region routes EmbeddedControl accesses
        // through whatever this registers; before this call it refuses
        // them with AML_ERR_REGION_EC_GATED and after it they transact.
        lea rdi, [rip + aml_ec_xact];
        call aml_region_ec_backing_set;

        mov rax, 1;
        jmp aml_eca_out;

      aml_eca_bad:
        xor rax, rax;

      aml_eca_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let aml_ec_bound : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M7-001 (#1079): 1 once aml_ec_attach has bound ports and scope. Leaf load. Reserved labels: none.",
      block: {
        lea rcx, [rip + aml_ec_state];
        mov rax, [rcx + 24];
        ret
      }
    } @no_frame

  // ==========================================================================
  // Counters. Each refusal cause gets its own, because the latched error
  // code is overwritten by the next success and "did the refusal happen
  // at all" must stay assertable -- the device aml_region_refusals and
  // aml_region_ec_gated already use.
  // ==========================================================================

  pub let aml_ec_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M7-003 (#1081): read counter `which` from the state block, 0 if out of range. One bounds-checked accessor rather than twenty named ones: the counters are a homogeneous block read almost exclusively by the corpus, and twenty near-identical leaf functions would be twenty places for an offset to drift out of step with the header comment. The guard precedes the address arithmetic. Reserved labels: aml_ecs_.",
      block: {
        cmp rdi, 32;
        jae aml_ecs_zero;
        lea rcx, [rip + aml_ec_state];
        mov rax, [rcx + rdi*8];
        ret;
      aml_ecs_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  // Indices into aml_ec_stat, named so the corpus and the header comment
  // cannot drift apart silently.
  pub let AML_EC_ST_XACT_BUSY : u64 = 4
  pub let AML_EC_ST_EPISODE   : u64 = 5
  pub let AML_EC_ST_DEPTH     : u64 = 6
  pub let AML_EC_ST_COMMITTED : u64 = 7
  pub let AML_EC_ST_GLK_IN    : u64 = 8
  pub let AML_EC_ST_GLK_OUT   : u64 = 9
  pub let AML_EC_ST_ATTEMPTED : u64 = 10
  pub let AML_EC_ST_Q_SEEN    : u64 = 11
  pub let AML_EC_ST_Q_DISP    : u64 = 12
  pub let AML_EC_ST_Q_ZERO    : u64 = 13
  pub let AML_EC_ST_Q_NOMETH  : u64 = 14
  pub let AML_EC_ST_TO_IBF    : u64 = 15
  pub let AML_EC_ST_TO_OBF    : u64 = 16
  pub let AML_EC_ST_STATUS    : u64 = 17
  pub let AML_EC_ST_RANGE     : u64 = 18
  pub let AML_EC_ST_REENTRANT : u64 = 19
  pub let AML_EC_ST_DEPTH_REF : u64 = 20
  pub let AML_EC_ST_UNBOUND   : u64 = 21
  pub let AML_EC_ST_BADOP     : u64 = 22
  pub let AML_EC_ST_LAST_Q    : u64 = 24
  pub let AML_EC_ST_PROBE_RES : u64 = 26
  pub let AML_EC_ST_POLLS     : u64 = 27

  // R30.M8-001 (#1082). Transactions refused because the Global Lock
  // could not be taken. The third term of the generalised balance
  // identity glk_enters + glk_denied == attempted; see THE GLOBAL LOCK
  // SEAM below for why the identity generalised rather than weakened.
  pub let AML_EC_ST_GLK_DENIED : u64 = 28

  // ==========================================================================
  // THE GLOBAL LOCK SEAM -- REAL AS OF R30.M8-001 (#1082).
  //
  // R30.M7-003 (#1081) placed this seam and made it count. #1082 put the
  // ACPI Global Lock behind it (src/user/aml/aml_glk.pdx): enter now runs
  // the FACS compare-exchange and CAN FAIL, and leave runs the release
  // loop and rings the GBL_RLS doorbell when firmware is waiting.
  //
  // Enter and leave still bracket the HANDSHAKE, inside the transaction
  // claim, on every path including every timeout exit -- the placement
  // was chosen so that this substitution needed no other change to the
  // transaction body beyond honouring the new failure.
  //
  // THE BALANCE ASSERTION SURVIVED THE SUBSTITUTION, WHICH IS WHY IT WAS
  // WRITTEN FIRST. #1081's corpus asserted
  //
  //     glk_enters == glk_leaves == attempted
  //
  // when the seam could not fail. A real lock can, so the invariant
  // generalises rather than weakens:
  //
  //     glk_enters == glk_leaves                    (still exact)
  //     glk_enters + glk_denied == attempted        (the new accounting)
  //
  // On every fixture where the lock is obtainable, glk_denied is 0 and
  // the original triple equality holds UNCHANGED. That is the test
  // passing because the property still holds, not because the test was
  // relaxed to fit. An implementation that acquires the lock and leaks
  // it on a timeout path still fails the first equation, exactly as it
  // was going to in #1081.
  //
  // The seam is PER-TRANSACTION by design and the query episode is
  // deliberately outside it. SMM may interleave its own EC transactions
  // between two of a _Qxx's, and must be allowed to: holding the Global
  // Lock across a _Qxx would starve firmware for milliseconds, and the
  // firmware paths that starve are the ones that run the fans.
  // ==========================================================================

  pub let aml_ec_glk_enter : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M7-003 (#1081) / R30.M8-001 (#1082): the Global Lock acquire seam. Delegates to aml_glk_enter, which runs the ACPI 6.5 §5.2.10.1 compare-exchange against the FACS and counts ownership so a recursive acquire does not re-take the hardware lock. Returns 1 held, 0 refused. THE COUNTER IS BUMPED ONLY ON SUCCESS, which is what keeps glk_enters == glk_leaves exact: a refused acquire is not followed by a release, so counting it here would break the very balance assertion this seam exists to support. Not @no_frame -- there is a nested call. Labels prefixed aml_ecg_ per reserved-label discipline.",
      block: {
        call aml_glk_enter;
        cmp rax, 0;
        je aml_ecg_denied;
        lea rcx, [rip + aml_ec_state];
        mov rax, [rcx + 64];
        add rax, 1;
        mov [rcx + 64], rax;
        mov rax, 1;
        ret;
      aml_ecg_denied:
        xor rax, rax;
        ret
      }
    }

  pub let aml_ec_glk_leave : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M7-003 (#1081) / R30.M8-001 (#1082): the Global Lock release seam, called on every exit path from the handshake including every timeout. Delegates to aml_glk_leave, which drops the hardware lock only at ownership 1->0 and rings the GBL_RLS doorbell iff the value it replaced carried Pending. The return value is deliberately discarded: a release that refuses has already latched its own code and bumped its own counter, and there is no exit path from a completed handshake that could act differently on the news. Not @no_frame -- there is a nested call. Reserved labels: none.",
      block: {
        call aml_glk_leave;
        lea rcx, [rip + aml_ec_state];
        mov rax, [rcx + 72];
        add rax, 1;
        mov [rcx + 72], rax;
        ret
      }
    }

  // ==========================================================================
  // THE SYNTHETIC EMBEDDED CONTROLLER.
  //
  // Same device gpe_io.pdx's GPE_IO_MODE_SYNTH is: the code under test
  // does not know the mode exists. aml_ec_xact is byte-identical in both
  // modes, so every assertion the corpus makes about the handshake is an
  // assertion about the SHIPPING transaction rather than about a test
  // double of it.
  //
  // The wedge modes are the reason this exists at all. A synthetic EC
  // that always answers would leave the timeout path -- the one that
  // matters, the one a real wedged EC takes -- completely unexercised.
  // ==========================================================================

  pub let aml_ec_synth_reset : (u64) -> () !{mem} @{} =
    fn (wedge: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M7-003 (#1081): put the synthetic EC in a known idle state with wedge mode rdi, and zero its 256 bytes of space. The RAM clear is a counted loop over a fixed 256 iterations, not a length the caller supplies. Labels prefixed aml_ecsr_ per reserved-label discipline.",
      block: {
        lea rcx, [rip + aml_ec_synth];
        xor rax, rax;
        mov [rcx + 0], rax;              // status: idle, nothing buffered
        mov [rcx + 8], rax;              // data
        mov [rcx + 16], rax;             // phase
        mov [rcx + 24], rdi;             // wedge
        mov [rcx + 32], rax;             // pending query
        mov [rcx + 40], rax;             // latched address
        mov [rcx + 48], rax;             // RAM writes seen

        lea rcx, [rip + aml_ec_ram];
        xor r8, r8;
      aml_ecsr_clear:
        cmp r8, 256;
        jae aml_ecsr_done;
        mov [rcx + r8*8], rax;
        add r8, 1;
        jmp aml_ecsr_clear;
      aml_ecsr_done:
        ret
      }
    } @no_frame

  pub let aml_ec_mode_set : (u64) -> () !{mem} @{} =
    fn (mode: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M7-003 (#1081): select the port seam. AML_EC_MODE_PORT (0) is the production default and reaches real ports through aml_region_port_in/out; AML_EC_MODE_SYNTH (1) reaches the model above. Leaf. Reserved labels: none.",
      block: {
        lea rcx, [rip + aml_ec_state];
        mov [rcx + 0], rdi;
        ret
      }
    } @no_frame

  pub let aml_ec_ram_poke : (u64, u64) -> () !{mem} @{} =
    fn (addr: u64) (value: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M7-001 (#1079): seed one byte of the synthetic EC's space, so a fixture can prove a read returned THAT byte rather than a plausible one. Bounds-checked before the address arithmetic; an out-of-range poke is dropped rather than wrapped, because a wrapping poke would seed a byte the fixture did not name and the resulting assertion would pass for the wrong reason. Reserved labels: aml_ecp_.",
      block: {
        cmp rdi, 256;
        jae aml_ecp_out;
        lea rcx, [rip + aml_ec_ram];
        mov [rcx + rdi*8], rsi;
      aml_ecp_out:
        ret
      }
    } @no_frame

  pub let aml_ec_ram_peek : (u64) -> u64 !{mem} @{} =
    fn (addr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M7-001 (#1079): read one byte of the synthetic EC's space. Bounds-checked; AML_EC_XACT_FAIL out of range so a fixture cannot mistake an out-of-range peek for a byte that reads zero. Reserved labels: aml_ecq_.",
      block: {
        cmp rdi, 256;
        jae aml_ecq_out;
        lea rcx, [rip + aml_ec_ram];
        mov rax, [rcx + rdi*8];
        ret;
      aml_ecq_out:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  pub let aml_ec_synth_query_set : (u64) -> () !{mem} @{} =
    fn (q: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M7-002 (#1080): arm the synthetic EC with the byte its next QR_EC will return, and raise SCI_EVT in its status to match. Setting the status bit as well as the byte matters: a fixture that armed the byte alone would be testing the query pump against a device that never actually signalled, which is not the sequence the driver sees. Reserved labels: none.",
      block: {
        lea rcx, [rip + aml_ec_synth];
        mov [rcx + 32], rdi;
        mov rax, [rcx + 0];
        or rax, 0x20;                    // AML_EC_STS_SCI
        mov [rcx + 0], rax;
        ret
      }
    } @no_frame

  pub let aml_ec_synth_writes : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M7-001 (#1079): how many bytes the synthetic EC has had written into its space. A write transaction that refused partway must not have moved this. Leaf load. Reserved labels: none.",
      block: {
        lea rcx, [rip + aml_ec_synth];
        mov rax, [rcx + 48];
        ret
      }
    } @no_frame

  // ==========================================================================
  // The register seam. Four functions, and the mode branch lives ONLY
  // here: aml_ec_xact above them is identical in both modes.
  // ==========================================================================

  pub let aml_ec_rd_status : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M7-003 (#1081): read the EC status register (the command port read side). In synth mode AML_EC_WEDGE_IBF forces IBF set on every read, which is exactly what a controller that never drains its input buffer looks like from here -- modelled as a property of the STATUS READ rather than as a counter in the wait loop, so the wait loop under test contains no test-only branch. Reserved labels: aml_ecrs_.",
      block: {
        push r12;
        lea rcx, [rip + aml_ec_state];
        mov rax, [rcx + 0];
        cmp rax, 1;                      // AML_EC_MODE_SYNTH
        je aml_ecrs_synth;

        mov rdi, [rcx + 16];             // cmd port
        mov rsi, 1;
        call aml_region_port_in;
        jmp aml_ecrs_out;

      aml_ecrs_synth:
        lea rcx, [rip + aml_ec_synth];
        mov rax, [rcx + 0];
        mov r12, [rcx + 24];             // wedge
        cmp r12, 1;                      // AML_EC_WEDGE_IBF
        jne aml_ecrs_out;
        or rax, 0x02;                    // IBF never clears

      aml_ecrs_out:
        pop r12;
        ret
      }
    }

  pub let aml_ec_rd_data : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M7-003 (#1081): read the EC data port. Reading it CLEARS OBF on the synthetic device, as it does on the real one -- a model that left OBF set would let a second read of a one-byte response succeed, and the driver would never learn it had read the same byte twice. Reserved labels: aml_ecrd_.",
      block: {
        lea rcx, [rip + aml_ec_state];
        mov rax, [rcx + 0];
        cmp rax, 1;
        je aml_ecrd_synth;

        mov rdi, [rcx + 8];              // data port
        mov rsi, 1;
        call aml_region_port_in;
        ret;

      aml_ecrd_synth:
        lea rcx, [rip + aml_ec_synth];
        mov rax, [rcx + 0];
        mov r8, 0xFFFFFFFFFFFFFFFE;      // ~AML_EC_STS_OBF
        and rax, r8;
        mov [rcx + 0], rax;
        mov rax, [rcx + 8];
        ret
      }
    }

  pub let aml_ec_wr_cmd : (u64) -> () !{mem} @{} =
    fn (v: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M7-003 (#1081): write a command byte to the EC command port. The synthetic device advances its phase here: RD_EC and WR_EC arm an address phase, QR_EC produces the armed query byte immediately and sets OBF (unless wedged), and any other byte is latched without effect -- including BE_EC and BD_EC, which this driver never sends. AML_EC_WEDGE_OBF suppresses the OBF set, which is a controller that accepts the command and never answers. Locals: r12=command. Reserved labels: aml_ecwc_.",
      block: {
        push r12;
        mov r12, rdi;
        lea rcx, [rip + aml_ec_state];
        mov rax, [rcx + 0];
        cmp rax, 1;
        je aml_ecwc_synth;

        mov rdi, [rcx + 16];             // cmd port
        mov rsi, 1;
        mov rdx, r12;
        call aml_region_port_out;
        jmp aml_ecwc_out;

      aml_ecwc_synth:
        lea rcx, [rip + aml_ec_synth];
        cmp r12, 0x80;                   // RD_EC
        je aml_ecwc_rd;
        cmp r12, 0x81;                   // WR_EC
        je aml_ecwc_wr;
        cmp r12, 0x84;                   // QR_EC
        je aml_ecwc_qr;
        jmp aml_ecwc_out;

      aml_ecwc_rd:
        mov rax, 1;
        mov [rcx + 16], rax;             // phase 1: awaiting address
        jmp aml_ecwc_out;

      aml_ecwc_wr:
        mov rax, 2;
        mov [rcx + 16], rax;             // phase 2: awaiting address
        jmp aml_ecwc_out;

      aml_ecwc_qr:
        // The query byte is consumed by the read: a second QR_EC with no
        // new event pending must return 0, which is what makes "query
        // zero is not a query" reachable in a fixture at all.
        mov rax, [rcx + 32];
        mov [rcx + 8], rax;              // into the output buffer
        xor rax, rax;
        mov [rcx + 32], rax;             // consumed
        mov [rcx + 16], rax;             // phase idle
        mov rax, [rcx + 0];
        mov r8, 0xFFFFFFFFFFFFFFDF;      // ~AML_EC_STS_SCI
        and rax, r8;                     // the event has been collected
        mov [rcx + 0], rax;
        mov r8, [rcx + 24];
        cmp r8, 2;                       // AML_EC_WEDGE_OBF
        je aml_ecwc_out;
        or rax, 0x01;                    // OBF
        mov [rcx + 0], rax;

      aml_ecwc_out:
        pop r12;
        ret
      }
    }

  pub let aml_ec_wr_data : (u64) -> () !{mem} @{} =
    fn (v: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M7-003 (#1081): write a byte to the EC data port. The synthetic device interprets it by phase: an address in phase 1 produces the addressed byte into the output buffer and sets OBF (unless AML_EC_WEDGE_OBF), an address in phase 2 is latched, and a byte in phase 3 lands in EC space. The address is masked to 8 bits before it indexes the model, which is a property of the MODEL and not a substitute for aml_ec_xact's range refusal -- the refusal happens first and this mask exists so that a mutant which removes it cannot index past the array. Locals: r12=value. Reserved labels: aml_ecwd_.",
      block: {
        push r12;
        push r13;
        mov r12, rdi;
        lea rcx, [rip + aml_ec_state];
        mov rax, [rcx + 0];
        cmp rax, 1;
        je aml_ecwd_synth;

        mov rdi, [rcx + 8];              // data port
        mov rsi, 1;
        mov rdx, r12;
        call aml_region_port_out;
        jmp aml_ecwd_out;

      aml_ecwd_synth:
        lea rcx, [rip + aml_ec_synth];
        mov rax, [rcx + 16];             // phase
        cmp rax, 1;
        je aml_ecwd_rdaddr;
        cmp rax, 2;
        je aml_ecwd_wraddr;
        cmp rax, 3;
        je aml_ecwd_wrdata;
        jmp aml_ecwd_out;

      aml_ecwd_rdaddr:
        mov r13, r12;
        and r13, 255;
        mov [rcx + 40], r13;
        xor rax, rax;
        mov [rcx + 16], rax;             // idle
        lea r8, [rip + aml_ec_ram];
        mov rax, [r8 + r13*8];
        mov [rcx + 8], rax;              // into the output buffer
        mov r8, [rcx + 24];
        cmp r8, 2;                       // AML_EC_WEDGE_OBF
        je aml_ecwd_out;
        mov rax, [rcx + 0];
        or rax, 0x01;                    // OBF
        cmp r8, 3;                       // AML_EC_WEDGE_STUCK_ADDR
        jne aml_ecwd_obfput;
        or rax, 0x02;                    // ... with IBF still asserted
      aml_ecwd_obfput:
        mov [rcx + 0], rax;
        jmp aml_ecwd_out;

      aml_ecwd_wraddr:
        mov r13, r12;
        and r13, 255;
        mov [rcx + 40], r13;
        mov rax, 3;
        mov [rcx + 16], rax;             // awaiting data
        jmp aml_ecwd_out;

      aml_ecwd_wrdata:
        mov r13, [rcx + 40];
        and r13, 255;
        lea r8, [rip + aml_ec_ram];
        mov [r8 + r13*8], r12;
        xor rax, rax;
        mov [rcx + 16], rax;             // idle
        mov rax, [rcx + 48];
        add rax, 1;
        mov [rcx + 48], rax;             // RAM writes seen

      aml_ecwd_out:
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // The bounded waits. THE reason this module refuses instead of hanging.
  //
  // Both loops are counted to AML_EC_POLL_MAX and both record how many
  // polls the last wait took, so a fixture can distinguish "answered
  // immediately" from "answered on the last possible iteration" -- which
  // is what makes an off-by-one in the bound visible rather than merely
  // survivable.
  //
  // aml_ec_wait_ibf_clear also carries the REENTRANCY PROBE HOOK. It is
  // here rather than in a test-only wrapper because the property under
  // test is "a transaction issued while another is mid-handshake is
  // refused, and the outer one still completes", and there is no way to
  // be mid-handshake except from inside the handshake.
  // ==========================================================================

  pub let aml_ec_wait_ibf_clear : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M7-003 (#1081): poll the status register until IBF is clear, at most AML_EC_POLL_MAX times; 1 if it cleared, 0 on the bound. The bound is on WORK, not on time -- this process has no clock -- and that is a real bound because the loop counter is a local the device cannot influence. On the first iteration only, a non-zero reentrancy probe is consumed and a nested aml_ec_xact is issued, whose return value is recorded for the corpus; the probe is cleared BEFORE the nested call, so the nesting is exactly one level deep and cannot recur. Locals: r12=iteration, r13=status. Reserved labels: aml_ecwi_.",
      block: {
        push r12;
        push r13;
        xor r12, r12;

        lea rcx, [rip + aml_ec_state];
        mov rax, [rcx + 200];            // reentrancy probe
        cmp rax, 0;
        je aml_ecwi_loop;
        xor r13, r13;
        mov [rcx + 200], r13;            // consume BEFORE the nested call
        mov rdi, 1;                      // AML_EC_OP_READ
        xor rsi, rsi;
        xor rdx, rdx;
        call aml_ec_xact;
        lea rcx, [rip + aml_ec_state];
        mov [rcx + 208], rax;            // what the nested attempt returned

      aml_ecwi_loop:
        cmp r12, 20000;                  // AML_EC_POLL_MAX
        jae aml_ecwi_timeout;
        call aml_ec_rd_status;
        mov r13, rax;
        and r13, 0x02;                   // AML_EC_STS_IBF
        cmp r13, 0;
        je aml_ecwi_ok;
        add r12, 1;
        jmp aml_ecwi_loop;

      aml_ecwi_ok:
        lea rcx, [rip + aml_ec_state];
        mov [rcx + 216], r12;
        mov rax, 1;
        jmp aml_ecwi_out;

      aml_ecwi_timeout:
        lea rcx, [rip + aml_ec_state];
        mov [rcx + 216], r12;
        xor rax, rax;

      aml_ecwi_out:
        pop r13;
        pop r12;
        ret
      }
    }

  pub let aml_ec_wait_obf_set : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M7-003 (#1081): poll the status register until OBF is set, at most AML_EC_POLL_MAX times; 1 if it set, 0 on the bound. This is the wait a wedged EC hangs forever on in implementations that do not bound it, and AML_EC_WEDGE_OBF is the fixture that proves this one does not. Locals: r12=iteration, r13=status. Reserved labels: aml_ecwo_.",
      block: {
        push r12;
        push r13;
        xor r12, r12;

      aml_ecwo_loop:
        cmp r12, 20000;                  // AML_EC_POLL_MAX
        jae aml_ecwo_timeout;
        call aml_ec_rd_status;
        mov r13, rax;
        and r13, 0x01;                   // AML_EC_STS_OBF
        cmp r13, 0;
        jne aml_ecwo_ok;
        add r12, 1;
        jmp aml_ecwo_loop;

      aml_ecwo_ok:
        lea rcx, [rip + aml_ec_state];
        mov [rcx + 216], r12;
        mov rax, 1;
        jmp aml_ecwo_out;

      aml_ecwo_timeout:
        lea rcx, [rip + aml_ec_state];
        mov [rcx + 216], r12;
        xor rax, rax;

      aml_ecwo_out:
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // aml_ec_xact(op, addr, value) -> byte | 1 | AML_EC_XACT_FAIL
  //
  // THE TRANSACTION. This is the function aml_ec_attach registers with
  // aml_region, and the only path by which an EmbeddedControl
  // OperationRegion access reaches hardware.
  //
  // THE SIGNATURE IS THE SECURITY ARGUMENT, and tools/verify-aml-parser.sh
  // pins it verbatim. `addr` is an EC-SPACE ADDRESS in 0..255 that
  // aml_region derived from the binding row's own offset arithmetic --
  // the same confined footing #1075/#1076 put the GPIO pad path on. There
  // is NO BASE PARAMETER and no region parameter. A mutant that adds one
  // fails the build rather than the review, which matters here more than
  // anywhere else in R30: an EC write outside the range firmware declared
  // can do things no specification describes, on a part that owns battery
  // charging and fan control.
  //
  // ORDER OF THE GUARDS is load-bearing. Bound, then op, then range, then
  // reentrancy, then claim. Range before the claim so that a rejected
  // address never takes the transaction claim at all; reentrancy last of
  // the refusals so that the nested-call witness reaches it having passed
  // everything else, which is what makes the assertion about REENTRANCY
  // rather than about some earlier guard firing first.
  // ==========================================================================

  pub let aml_ec_xact : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (op: u64) (addr: u64) (value: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M7-001/003 (#1079/#1081): perform one complete EC handshake -- RD_EC or WR_EC -- against the bound ports, serialized by the transaction claim and bounded at every wait. Returns the byte read, 1 for a completed write, or AML_EC_XACT_FAIL having latched a specific code through aml_eval_set_err and bumped that cause's counter. The transaction claim is released and the Global Lock seam left on EVERY exit path including all four timeout exits: a timeout that leaked the claim would turn one wedged transaction into a permanently dead EC path, which is the same defect as having no timeout, arriving one transaction later. The write path waits for IBF to clear a FOURTH time after the data byte, because the transaction is not complete until the EC has consumed it and a caller that returned early would let the next transaction's command byte race the previous one's data. Locals: r12=op, r13=addr, r14=value, r15=result. Reserved labels: aml_ecx_.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;
        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;

        // ---- guard 1: is there an EC at all? ----
        lea rcx, [rip + aml_ec_state];
        mov rax, [rcx + 24];
        cmp rax, 0;
        je aml_ecx_unbound;

        // ---- guard 2: read or write, nothing else ----
        cmp r12, 1;                      // AML_EC_OP_READ
        je aml_ecx_opok;
        cmp r12, 2;                      // AML_EC_OP_WRITE
        je aml_ecx_opok;
        jmp aml_ecx_badop;

      aml_ecx_opok:
        // ---- guard 3: EC space is 256 bytes. REFUSE, never wrap. ----
        cmp r13, 256;                    // AML_EC_SPACE_MAX
        jae aml_ecx_range;

        // ---- guard 4: no transaction inside a transaction ----
        lea rcx, [rip + aml_ec_state];
        mov rax, [rcx + 32];
        cmp rax, 0;
        jne aml_ecx_reent;

        // ---- take the claim ----
        mov rax, 1;
        mov [rcx + 32], rax;
        mov rax, [rcx + 80];
        add rax, 1;
        mov [rcx + 80], rax;             // attempted

        // ---- take the Global Lock, or refuse the transaction ----
        // A refused acquire means FIRMWARE holds the EC. Proceeding
        // anyway would drive the same registers SMM is mid-handshake on,
        // which is the entire condition the Global Lock exists to
        // prevent -- so this is a refusal, not a retry and not a warning.
        // NOTE the asymmetry with every other refusal below: this one
        // does NOT call aml_ec_glk_leave, because nothing was acquired.
        // That is what keeps glk_enters == glk_leaves exact.
        call aml_ec_glk_enter;
        cmp rax, 0;
        je aml_ecx_glk;

        // ---- step 1: the EC must be ready for a command ----
        call aml_ec_wait_ibf_clear;
        cmp rax, 0;
        je aml_ecx_to_ibf;

        // ---- step 2: the command byte ----
        cmp r12, 1;
        je aml_ecx_cmd_rd;
        mov rdi, 0x81;                   // WR_EC
        jmp aml_ecx_cmd_go;
      aml_ecx_cmd_rd:
        mov rdi, 0x80;                   // RD_EC
      aml_ecx_cmd_go:
        call aml_ec_wr_cmd;

        call aml_ec_wait_ibf_clear;
        cmp rax, 0;
        je aml_ecx_to_ibf;

        // ---- step 3: the address byte ----
        mov rdi, r13;
        call aml_ec_wr_data;

        cmp r12, 1;
        je aml_ecx_read_tail;

        // ---- write tail: wait, data, wait ----
        call aml_ec_wait_ibf_clear;
        cmp rax, 0;
        je aml_ecx_to_ibf;

        mov rdi, r14;
        call aml_ec_wr_data;

        call aml_ec_wait_ibf_clear;
        cmp rax, 0;
        je aml_ecx_to_ibf;

        mov r15, 1;
        jmp aml_ecx_commit;

        // ---- read tail: wait for the answer ----
      aml_ecx_read_tail:
        call aml_ec_wait_obf_set;
        cmp rax, 0;
        je aml_ecx_to_obf;

        // The status must be CONSISTENT WITH THE STEP REACHED. OBF set
        // with IBF still set means the EC never consumed our address, so
        // whatever is in the output buffer is not our data. Returning it
        // would be exactly the fiction #1065 refused to produce.
        call aml_ec_rd_status;
        mov r10, rax;
        and r10, 0x02;                   // AML_EC_STS_IBF
        cmp r10, 0;
        jne aml_ecx_status;

        call aml_ec_rd_data;
        mov r15, rax;
        and r15, 255;

      aml_ecx_commit:
        call aml_ec_glk_leave;
        lea rcx, [rip + aml_ec_state];
        xor rax, rax;
        mov [rcx + 32], rax;             // release the claim
        mov rax, [rcx + 56];
        add rax, 1;
        mov [rcx + 56], rax;             // committed
        mov rax, r15;
        jmp aml_ecx_out;

        // ================= refusals =================

      aml_ecx_to_ibf:
        call aml_ec_glk_leave;
        lea rcx, [rip + aml_ec_state];
        xor rax, rax;
        mov [rcx + 32], rax;
        mov rax, [rcx + 120];
        add rax, 1;
        mov [rcx + 120], rax;
        mov rdi, 69;                     // AML_ERR_EC_TIMEOUT_IBF
        jmp aml_ecx_fail;

      aml_ecx_to_obf:
        call aml_ec_glk_leave;
        lea rcx, [rip + aml_ec_state];
        xor rax, rax;
        mov [rcx + 32], rax;
        mov rax, [rcx + 128];
        add rax, 1;
        mov [rcx + 128], rax;
        mov rdi, 70;                     // AML_ERR_EC_TIMEOUT_OBF
        jmp aml_ecx_fail;

        // The Global Lock was refused. The transaction claim IS held --
        // it was taken before the acquire -- so it is released here, and
        // the lock is NOT, because we never had it. The refusal code is
        // deliberately NOT overwritten: aml_glk_enter already latched the
        // specific cause (76 UNBOUND / 77 TIMEOUT / 80 CAS_STUCK), and an
        // EC-flavoured code stamped on top would tell an operator to
        // replace the embedded controller when the fault is firmware
        // holding a lock it will not release.
      aml_ecx_glk:
        lea rcx, [rip + aml_ec_state];
        xor rax, rax;
        mov [rcx + 32], rax;             // release the transaction claim
        mov rax, [rcx + 224];
        add rax, 1;
        mov [rcx + 224], rax;            // GLK-denied transactions
        mov rax, 0xFFFFFFFFFFFFFFFF;     // AML_EC_XACT_FAIL
        jmp aml_ecx_out;

      aml_ecx_status:
        call aml_ec_glk_leave;
        lea rcx, [rip + aml_ec_state];
        xor rax, rax;
        mov [rcx + 32], rax;
        mov rax, [rcx + 136];
        add rax, 1;
        mov [rcx + 136], rax;
        mov rdi, 71;                     // AML_ERR_EC_STATUS
        jmp aml_ecx_fail;

        // The three guards below fire BEFORE the claim is taken, so they
        // neither release it nor touch the Global Lock seam -- a refused
        // transaction was never attempted, and so never appears in any
        // of the three terms of glk_enters + glk_denied == attempted.
      aml_ecx_range:
        lea rcx, [rip + aml_ec_state];
        mov rax, [rcx + 144];
        add rax, 1;
        mov [rcx + 144], rax;
        mov rdi, 72;                     // AML_ERR_EC_RANGE
        jmp aml_ecx_fail;

      aml_ecx_reent:
        lea rcx, [rip + aml_ec_state];
        mov rax, [rcx + 152];
        add rax, 1;
        mov [rcx + 152], rax;
        mov rdi, 73;                     // AML_ERR_EC_REENTRANT
        jmp aml_ecx_fail;

      aml_ecx_unbound:
        lea rcx, [rip + aml_ec_state];
        mov rax, [rcx + 168];
        add rax, 1;
        mov [rcx + 168], rax;
        mov rdi, 68;                     // AML_ERR_EC_UNBOUND
        jmp aml_ecx_fail;

      aml_ecx_badop:
        lea rcx, [rip + aml_ec_state];
        mov rax, [rcx + 176];
        add rax, 1;
        mov [rcx + 176], rax;
        mov rdi, 75;                     // AML_ERR_EC_BAD_OP

      aml_ecx_fail:
        call aml_eval_set_err;
        mov rax, 0xFFFFFFFFFFFFFFFF;     // AML_EC_XACT_FAIL

      aml_ecx_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // aml_ec_probe_arm(n) -- arm the reentrancy witness.
  // ==========================================================================

  pub let aml_ec_probe_arm : (u64) -> () !{mem} @{} =
    fn (n: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M7-003 (#1081): arm the nested-transaction probe consumed by the next aml_ec_wait_ibf_clear. Its result lands in slot AML_EC_ST_PROBE_RES. Leaf. Reserved labels: none.",
      block: {
        lea rcx, [rip + aml_ec_state];
        mov [rcx + 200], rdi;
        xor rax, rax;
        mov [rcx + 208], rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // aml_ec_query_seg(q) -> packed NameSeg for _Qxx
  //
  // A NameSeg is four ASCII characters packed little-endian, first
  // character in bits [7:0] (aml_name_seg). _Qxx is '_', 'Q', then the
  // query byte as two UPPERCASE hex digits, high nibble first.
  //
  // Uppercase is not cosmetic. NameSegs compare as integers, so '_Q8a'
  // and '_Q8A' are different names and only one of them is the one the
  // table declares.
  // ==========================================================================

  pub let aml_ec_query_seg : (u64) -> u64 !{} @{} =
    fn (q: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R30.M7-002 (#1080): build the packed NameSeg for query byte rdi. Pure; no memory touched at all, which is why its effect row is empty where every other function here carries {mem}. The two nibbles go through the same digit conversion in sequence rather than through a lookup table, so there is one place for the '0'/'A' boundary to be right. Locals: r8=nibble, r9=accumulator. Reserved labels: aml_ecqs_.",
      block: {
        mov r9, 0x5F;                    // '_'
        mov rax, 0x51;                   // 'Q'
        shl rax, 8;
        or r9, rax;

        // high nibble -> bits [23:16]
        mov r8, rdi;
        shr r8, 4;
        and r8, 15;
        cmp r8, 10;
        jb aml_ecqs_hidec;
        add r8, 55;                      // 'A' - 10
        jmp aml_ecqs_hiput;
      aml_ecqs_hidec:
        add r8, 48;                      // '0'
      aml_ecqs_hiput:
        shl r8, 16;
        or r9, r8;

        // low nibble -> bits [31:24]
        mov r8, rdi;
        and r8, 15;
        cmp r8, 10;
        jb aml_ecqs_lodec;
        add r8, 55;
        jmp aml_ecqs_loput;
      aml_ecqs_lodec:
        add r8, 48;
      aml_ecqs_loput:
        shl r8, 24;
        or r9, r8;

        mov rax, r9;
        ret
      }
    } @no_frame

  // ==========================================================================
  // aml_ec_query_pump() -> AML_EC_Q_NONE | _DISPATCHED | _NO_METHOD
  //                        | AML_EC_XACT_FAIL
  //
  // ARITY ZERO, and that is deliberate. The namespace scope _Qxx is
  // resolved in comes from aml_ec_attach, not from the caller: a
  // caller-supplied scope would let a query dispatch some OTHER device's
  // _Q80, which is the same class of mistake as a caller-supplied base
  // address on the transaction path.
  //
  // QUERY ZERO IS NOT A QUERY. QR_EC returning 0 means NO QUERY PENDING.
  // Dispatching _Q00 for it is a real bug that appears in naive
  // implementations: it invokes a method the firmware may well have
  // defined for something else, on an event that did not happen. The
  // corpus witnesses this directly -- the fixture DEFINES _Q00 with an
  // observable body, the synthetic EC is made to return 0, and the
  // assertion is that the observable did not move.
  //
  // THE REENTRANT STEP is the call to aml_eval_method below. It happens
  // with the transaction claim FREE and the episode claim HELD, which is
  // the whole decision of this milestone in two lines of code.
  // ==========================================================================

  pub let aml_ec_query_pump : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M7-002 (#1080): issue QR_EC, and if the byte is non-zero resolve and invoke the matching _Qxx in the EC device's scope. The QR_EC handshake is a normal transaction and RELEASES THE TRANSACTION CLAIM BEFORE THE DISPATCH -- that is the reentrancy decision, and holding it here instead is the deadlock this milestone exists to prevent. The episode claim is taken around the dispatch and released after it on both the success and the not-found path, so a table whose _Qxx faults cannot leave the episode depth permanently raised and refuse every later query with AML_ERR_EC_QUERY_DEPTH. Resolution is EXACT IN THE EC'S SCOPE, not the §5.3 upward search: the search rule would find an ancestor's _Q80 when this EC defines none and run the wrong device's handler. Locals: r12=query byte, r13=node, r14=scope. Reserved labels: aml_ecqp_.",
      block: {
        push r12;
        push r13;
        push r14;

        // ---- episode depth bound, checked before anything is issued ----
        lea rcx, [rip + aml_ec_state];
        mov rax, [rcx + 48];
        cmp rax, 4;                      // AML_EC_QUERY_MAX_DEPTH
        jae aml_ecqp_deep;

        mov r14, [rcx + 184];            // scope node from aml_ec_attach
        mov rax, [rcx + 24];
        cmp rax, 0;
        je aml_ecqp_unbound;

        // ---- the QR_EC transaction, inline: it is neither a read nor a
        //      write of EC space and carries no address byte, so it does
        //      not go through aml_ec_xact's op dispatch. It takes and
        //      releases the SAME claim, which is what makes the _Qxx
        //      dispatch below safe.
        lea rcx, [rip + aml_ec_state];
        mov rax, [rcx + 32];
        cmp rax, 0;
        jne aml_ecqp_reent;
        mov rax, 1;
        mov [rcx + 32], rax;
        mov rax, [rcx + 80];
        add rax, 1;
        mov [rcx + 80], rax;             // attempted

        // ---- take the Global Lock, or refuse the QR_EC handshake ----
        // R30.M8-DEBUG. This call site was left unchecked when #1082
        // landed: aml_ec_xact's identical call was gated with cmp/je
        // aml_ecx_glk, but this one -- the QR_EC transaction the module
        // header above calls "a normal transaction" -- fell straight
        // through into the handshake on a refusal, exactly the defect
        // class #1082's own commit message describes for aml_ec_xact.
        // A denial here means firmware holds the EC; proceeding would
        // drive the same registers SMM is mid-handshake on. It also
        // broke the balance identity: aml_ec_glk_leave (called
        // unconditionally below on every exit path) would still bump
        // GLK_OUT even though GLK_IN was never bumped by a refused
        // aml_ec_glk_enter. As with aml_ecx_glk: release the
        // transaction claim, count the denial, and do NOT call
        // aml_ec_glk_leave (nothing was acquired) and do NOT overwrite
        // the latched cause (aml_glk_enter already latched its own).
        call aml_ec_glk_enter;
        cmp rax, 0;
        je aml_ecqp_glk;

        call aml_ec_wait_ibf_clear;
        cmp rax, 0;
        je aml_ecqp_to_ibf;

        mov rdi, 0x84;                   // QR_EC
        call aml_ec_wr_cmd;

        call aml_ec_wait_obf_set;
        cmp rax, 0;
        je aml_ecqp_to_obf;

        call aml_ec_rd_data;
        mov r12, rax;
        and r12, 255;

        call aml_ec_glk_leave;
        lea rcx, [rip + aml_ec_state];
        xor rax, rax;
        mov [rcx + 32], rax;             // THE CLAIM IS NOW FREE
        mov rax, [rcx + 56];
        add rax, 1;
        mov [rcx + 56], rax;             // committed
        mov rax, [rcx + 88];
        add rax, 1;
        mov [rcx + 88], rax;             // queries seen
        mov [rcx + 192], r12;            // last query byte

        // ---- QUERY ZERO IS NOT A QUERY ----
        cmp r12, 0;
        je aml_ecqp_zero;

        // ---- resolve _Qxx exactly, in the EC's own scope ----
        mov rdi, r12;
        call aml_ec_query_seg;
        mov rdi, r14;
        mov rsi, rax;
        call aml_eval_find_in_scope;
        mov r13, rax;
        cmp r13, 0;
        je aml_ecqp_nometh;

        // ---- open the episode and DISPATCH. The claim is free here. ----
        lea rcx, [rip + aml_ec_state];
        mov rax, [rcx + 48];
        add rax, 1;
        mov [rcx + 48], rax;             // episode depth
        mov [rcx + 40], r12;             // episode marker: the query byte

        mov rdi, r13;
        call aml_eval_method;

        lea rcx, [rip + aml_ec_state];
        mov rax, [rcx + 48];
        sub rax, 1;
        mov [rcx + 48], rax;
        cmp rax, 0;
        jne aml_ecqp_disp;
        xor rax, rax;
        mov [rcx + 40], rax;             // episode closed

      aml_ecqp_disp:
        lea rcx, [rip + aml_ec_state];
        mov rax, [rcx + 96];
        add rax, 1;
        mov [rcx + 96], rax;             // queries dispatched
        mov rax, 1;                      // AML_EC_Q_DISPATCHED
        jmp aml_ecqp_out;

      aml_ecqp_zero:
        lea rcx, [rip + aml_ec_state];
        mov rax, [rcx + 104];
        add rax, 1;
        mov [rcx + 104], rax;            // queries zero
        xor rax, rax;                    // AML_EC_Q_NONE
        jmp aml_ecqp_out;

      aml_ecqp_nometh:
        // Firmware is not obliged to define every _Qxx. Counted, not
        // latched: treating a missing method as a fault would make a
        // normal machine look broken.
        lea rcx, [rip + aml_ec_state];
        mov rax, [rcx + 112];
        add rax, 1;
        mov [rcx + 112], rax;
        mov rax, 2;                      // AML_EC_Q_NO_METHOD
        jmp aml_ecqp_out;

      aml_ecqp_to_ibf:
        call aml_ec_glk_leave;
        lea rcx, [rip + aml_ec_state];
        xor rax, rax;
        mov [rcx + 32], rax;
        mov rax, [rcx + 120];
        add rax, 1;
        mov [rcx + 120], rax;
        mov rdi, 69;                     // AML_ERR_EC_TIMEOUT_IBF
        jmp aml_ecqp_fail;

      aml_ecqp_to_obf:
        call aml_ec_glk_leave;
        lea rcx, [rip + aml_ec_state];
        xor rax, rax;
        mov [rcx + 32], rax;
        mov rax, [rcx + 128];
        add rax, 1;
        mov [rcx + 128], rax;
        mov rdi, 70;                     // AML_ERR_EC_TIMEOUT_OBF
        jmp aml_ecqp_fail;

      aml_ecqp_reent:
        lea rcx, [rip + aml_ec_state];
        mov rax, [rcx + 152];
        add rax, 1;
        mov [rcx + 152], rax;
        mov rdi, 73;                     // AML_ERR_EC_REENTRANT
        jmp aml_ecqp_fail;

      aml_ecqp_deep:
        lea rcx, [rip + aml_ec_state];
        mov rax, [rcx + 160];
        add rax, 1;
        mov [rcx + 160], rax;
        mov rdi, 74;                     // AML_ERR_EC_QUERY_DEPTH
        jmp aml_ecqp_fail;

      aml_ecqp_unbound:
        lea rcx, [rip + aml_ec_state];
        mov rax, [rcx + 168];
        add rax, 1;
        mov [rcx + 168], rax;
        mov rdi, 68;                     // AML_ERR_EC_UNBOUND
        jmp aml_ecqp_fail;

        // The Global Lock was refused. The transaction claim IS held --
        // it was taken above -- so it is released here, and the lock is
        // NOT, because we never had it. The refusal code is deliberately
        // NOT overwritten: aml_glk_enter already latched the specific
        // cause (76 UNBOUND / 77 TIMEOUT / 80 CAS_STUCK), and an
        // EC-flavoured code stamped on top would tell an operator to
        // replace the embedded controller when the fault is firmware
        // holding a lock it will not release. Mirrors aml_ecx_glk in
        // aml_ec_xact exactly.
      aml_ecqp_glk:
        lea rcx, [rip + aml_ec_state];
        xor rax, rax;
        mov [rcx + 32], rax;             // release the transaction claim
        mov rax, [rcx + 224];
        add rax, 1;
        mov [rcx + 224], rax;            // GLK-denied transactions
        mov rax, 0xFFFFFFFFFFFFFFFF;     // AML_EC_XACT_FAIL
        jmp aml_ecqp_out;

      aml_ecqp_fail:
        call aml_eval_set_err;
        mov rax, 0xFFFFFFFFFFFFFFFF;     // AML_EC_XACT_FAIL

      aml_ecqp_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }
}
