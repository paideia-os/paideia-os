// src/user/dispatch.pdx — R17-M3-004 (#624) + R17-M4 (#629-634)
// Shell builtin dispatch: runtime-loaded table of command names and handlers.
// Accepts argc/argv from Tokenizer .bss, walks builtin table, calls matching handler or returns not-found.
// Acceptance: builds; echo/exit/pwd/help/env builtins work; dispatch_line returns 0 on hit, 1 on miss.
// See design/kernel/r17-m3-004-shell-builtin-dispatch.md and design/kernel/r17-m4-shell-builtins.md.

module Dispatch = structure {
  pub let echo_name = "echo\0"
  pub let exit_name = "exit\0"
  pub let pwd_name = "pwd\0"
  pub let help_name = "help\0"
  pub let env_name = "env\0"
  pub let cd_name = "cd\0"
  pub let sp_char = " "
  pub let nl_char = "\n"
  pub let bin_prefix = "/bin/\0"
  pub let usr_bin_prefix = "/usr/bin/\0"
  pub let help_sep = " - \0"
  pub let env_path_msg = "PATH=/bin\n\0"
  pub let echo_desc = "echo text to stdout\0"
  pub let exit_desc = "exit shell (opt N)\0"
  pub let pwd_desc = "print working directory\0"
  pub let help_desc = "list all builtins\0"
  pub let env_desc = "print environment vars\0"
  pub let cd_desc = "change working directory\0"
  pub let cd_err_rel = "cd: relative paths not supported\n\0"
  pub let cd_err_long = "cd: path too long\n\0"

  // R57.M4-005 (#1801): "shell exec ok" fingerprint, split into three
  // fixed-length fragments so the emit sequence can sandwich the two
  // runtime-length fields (argv[0] name, resolved path) between them via
  // sys_debug_puts (SC+ ID 12). ASCII "--" (not U+2014 em-dash) per
  // rootfs_seed.pdx L23's 7-bit-ASCII-on-wire note. Wire lengths (NUL
  // excluded, passed explicitly as sys_debug_puts's rsi): prefix=25,
  // mid=10, tail=25.
  pub let sh_exec_ok_prefix = "shell exec ok -- argv[0]=\0"
  pub let sh_exec_ok_mid = " resolved=\0"
  pub let sh_exec_ok_tail = " [legacy: SHELL EXEC OK]\n\0"

  // R58.M5-001 (#1805): "shell redirect ok" fingerprint, split into
  // fixed-length fragments the same way sh_exec_ok_* is above, so the
  // emit sequence in exec_child's rd_ redirect scan can sandwich the
  // three runtime-length fields (argv[0] name, operator, target file)
  // between them via sys_debug_puts (SC+ ID 12). ASCII "--" (not U+2014).
  // Wire lengths (NUL excluded, passed explicitly as sys_debug_puts's
  // rsi): prefix=29, mid_op=4, mid_file=6, tail=29.
  pub let sh_redirect_ok_prefix = "shell redirect ok -- argv[0]=\0"
  pub let sh_redirect_ok_mid_op = " op=\0"
  pub let sh_redirect_ok_mid_file = " file=\0"
  pub let sh_redirect_ok_tail = " [legacy: SHELL REDIRECT OK]\n\0"

  pub let mut builtin_names : [u64; 8] = uninit @align(8)
  pub let mut builtin_handlers : [u64; 8] = uninit @align(8)
  pub let mut builtin_descs : [u64; 8] = uninit @align(8)
  pub let mut builtin_count : u64 = uninit @align(8)

  pub let mut child_wait_status : [u64; 1] = uninit @align(8)
  pub let mut resolved_path : [u8; 320] = uninit @align(8)
  // R57.M4-005 (#1801): sys_stat (SC+ ID 77) result scratch for
  // resolve_path's PATH-prefix probe. 64 bytes matches the kernel-side
  // stat struct layout (src/kernel/core/syscall/sys_stat.pdx); contents
  // are unused beyond the rax==0/!=0 hit/miss signal, so no field
  // offsets are named here.
  pub let mut _resolved_stat_scratch : [u64; 8] = uninit @align(8)
  pub let mut _cwd_buf : [u8; 256] = uninit @align(8)
  pub let mut echo_emit_nl : u64 = uninit @align(8)
  pub let mut echo_first_token : u64 = uninit @align(8)
  pub let mut echo_idx : u64 = uninit @align(8)

  // dispatch_init() — populate runtime dispatch table at startup.
  // Loads addresses of echo_name, exit_name, pwd_name, help_name, env_name into builtin_names[0..4].
  // Loads addresses of echo_builtin, exit_builtin, pwd_builtin, help_builtin, env_builtin into builtin_handlers[0..4].
  // Loads addresses of echo_desc, exit_desc, pwd_desc, help_desc, env_desc into builtin_descs[0..4].
  // Sets builtin_count = 5.
  pub let dispatch_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R17-m3-004 (#624) + R17-M4 (#629-634): dispatch_init populates builtin_names, builtin_handlers, builtin_descs, builtin_count at runtime startup. Called once from _start before main_loop. No arguments; no return.",
      block: {
        lea rdi, [rip + builtin_names];
        lea rax, [rip + echo_name];
        mov [rdi + 0], rax;
        lea rax, [rip + exit_name];
        mov [rdi + 8], rax;
        lea rax, [rip + pwd_name];
        mov [rdi + 16], rax;
        lea rax, [rip + help_name];
        mov [rdi + 24], rax;
        lea rax, [rip + env_name];
        mov [rdi + 32], rax;
        lea rax, [rip + cd_name];
        mov [rdi + 40], rax;

        lea rdi, [rip + builtin_handlers];
        lea rax, [rip + echo_builtin];
        mov [rdi + 0], rax;
        lea rax, [rip + exit_builtin];
        mov [rdi + 8], rax;
        lea rax, [rip + pwd_builtin];
        mov [rdi + 16], rax;
        lea rax, [rip + help_builtin];
        mov [rdi + 24], rax;
        lea rax, [rip + env_builtin];
        mov [rdi + 32], rax;
        lea rax, [rip + cd_builtin];
        mov [rdi + 40], rax;

        lea rdi, [rip + builtin_descs];
        lea rax, [rip + echo_desc];
        mov [rdi + 0], rax;
        lea rax, [rip + exit_desc];
        mov [rdi + 8], rax;
        lea rax, [rip + pwd_desc];
        mov [rdi + 16], rax;
        lea rax, [rip + help_desc];
        mov [rdi + 24], rax;
        lea rax, [rip + env_desc];
        mov [rdi + 32], rax;
        lea rax, [rip + cd_desc];
        mov [rdi + 40], rax;

        lea rdi, [rip + builtin_count];
        mov rax, 6;
        mov [rdi], rax;

        ret
      }
    } @no_frame

  // dispatch_line() -> u64
  // Reads argc and argv_buf from Tokenizer .bss (linked symbols).
  // Walks builtin_names table, compares argv[0] against each builtin name.
  // If hit: calls matching handler, returns 0.
  // If miss (no builtin matches, or argc==0): returns 1.
  // Register plan: r9 = argv[0], r10 = strlen(argv[0]), r11 = loop index.
  pub let dispatch_line : () -> u64 !{mem, sysreg} @{fs} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {fs},
      justification: "R17-m3-004 (#624): dispatch_line walks runtime builtin table. Reads argc/argv_buf from Tokenizer symbols (extern linkage). No arguments; uses r9=argv[0], r10=strlen(argv[0]), r11=loop index. Returns 0 on builtin hit (and calls handler), 1 on miss.",
      block: {
        lea rax, [rip + argc];
        mov rax, [rax];
        cmp rax, 0;
        je dispatch_notfound;

        lea rax, [rip + argv_buf];
        mov r9, [rax];
        mov rdi, r9;
        call strlen;
        mov r10, rax;

        xor r11, r11;
dispatch_loop:
        lea rax, [rip + builtin_count];
        mov rax, [rax];
        cmp r11, rax;
        jge dispatch_notfound;

        lea rax, [rip + builtin_names];
        mov rdi, [rax + r11*8];
        call strlen;
        cmp rax, r10;
        jne dispatch_next;

        mov rdi, r9;
        lea rax, [rip + builtin_names];
        mov rsi, [rax + r11*8];
        mov rdx, r10;
        call memcmp;
        cmp rax, 0;
        jne dispatch_next;

        lea rax, [rip + builtin_handlers];
        mov rax, [rax + r11*8];
        sub rsp, 8;
        call rax;
        add rsp, 8;
        xor rax, rax;
        ret;
dispatch_next:
        add r11, 1;
        jmp dispatch_loop;
dispatch_notfound:
        mov rax, 1;
        ret
      }
    } @no_frame

  // echo_builtin() -> u64
  // Emits argv[1..argc-1] (or argv[2..argc-1] if argv[1]=="-n") space-separated.
  // If "-n" flag not present, followed by newline. Reads argc/argv_buf from Tokenizer .bss.
  pub let echo_builtin : () -> u64 !{mem, sysreg} @{fs} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {fs},
      justification: "R17-M4 (#629) + #1016 fix: echo_builtin with -n flag support. Emits argv[1..argc-1] space-separated. If argv[1]==\"-n\", suppresses trailing newline and starts from argv[2]. Reads argc/argv_buf from Tokenizer .bss. Returns 0. Two bugs fixed for #1016: (a) space suppression tracked via echo_first_token .bss slot rather than the old r9==1||r9==2 heuristic that silently dropped the space between argv[1] and argv[2] when no -n flag was given. (b) argc AND the loop index are reloaded from memory at the top of every echo_scan iteration — the userland→kernel syscall path in src/kernel/core/syscall/entry.pdx shuffles r10 (SYSCALL arg-4) into r8 (SysV arg-5) and does not restore r10 before sysret; likewise r9 survives the shuffle only conditionally, so both are pinned to echo_idx / argc .bss slots across sys_write calls. Prior version kept argc in r10 and index in r9 across sys_write, which silently exited the loop after argv[1] because the garbage r10 satisfied the r9>=r10 test on iteration 2 (echo hello world → 'hello' only).",
      block: {
        // default: emit_nl = 1, first_token = 1, echo_idx = 1
        lea rax, [rip + echo_emit_nl];
        mov rcx, 1;
        mov [rax], rcx;
        lea rax, [rip + echo_first_token];
        mov rcx, 1;
        mov [rax], rcx;
        lea rax, [rip + echo_idx];
        mov rcx, 1;
        mov [rax], rcx;

        // if argc >= 2, check argv[1] for "-n" (exactly two chars: '-','n', NUL)
        lea rax, [rip + argc];
        mov r10, [rax];
        cmp r10, 2;
        jl echo_scan;
        lea rax, [rip + argv_buf];
        mov r11, [rax + 8];
        xor rax, rax;
        mov al, [r11];
        and rax, 0xff;
        cmp rax, 0x2D;
        jne echo_scan;
        xor rax, rax;
        mov al, [r11 + 1];
        and rax, 0xff;
        cmp rax, 0x6E;
        jne echo_scan;
        xor rax, rax;
        mov al, [r11 + 2];
        and rax, 0xff;
        cmp rax, 0;
        jne echo_scan;
        // "-n" confirmed: skip it, suppress \n
        lea rax, [rip + echo_idx];
        mov rcx, 2;
        mov [rax], rcx;
        lea rax, [rip + echo_emit_nl];
        xor rcx, rcx;
        mov [rax], rcx;

echo_scan:
        // Reload argc and idx from memory — r10 (arg-4) is clobbered by the
        // kernel's syscall shuffle on every sys_write; r9 is preserved but
        // pinning both to memory is simpler than tracking which subset.
        lea rax, [rip + argc];
        mov r10, [rax];
        lea rax, [rip + echo_idx];
        mov r9, [rax];
        cmp r9, r10;
        jge echo_maybe_nl;
        // Emit leading space unless this is the first token to be printed.
        lea rax, [rip + echo_first_token];
        mov rcx, [rax];
        cmp rcx, 0;
        jne echo_arg;   // first_token != 0 → no leading space, and mark 0 below
        mov rdi, 1;
        lea rsi, [rip + sp_char];
        mov rdx, 1;
        call sys_write;
echo_arg:
        // Reload r9 (idx) — sys_write above may have clobbered it (see justification).
        lea rax, [rip + echo_idx];
        mov r9, [rax];
        lea rax, [rip + argv_buf];
        mov rdi, [rax + r9*8];
        call strlen;
        mov rdx, rax;
        // Reload r9 again — strlen shouldn't touch it but be defensive.
        lea rax, [rip + echo_idx];
        mov r9, [rax];
        mov rdi, 1;
        lea rax, [rip + argv_buf];
        mov rsi, [rax + r9*8];
        call sys_write;
        // mark first_token = 0 (subsequent iterations get a leading space)
        lea rax, [rip + echo_first_token];
        xor rcx, rcx;
        mov [rax], rcx;
        // Advance idx via memory (r9 may be clobbered post-sys_write).
        lea rax, [rip + echo_idx];
        mov rcx, [rax];
        add rcx, 1;
        mov [rax], rcx;
        jmp echo_scan;
echo_maybe_nl:
        lea rax, [rip + echo_emit_nl];
        mov rax, [rax];
        cmp rax, 0;
        je echo_done;
        mov rdi, 1;
        lea rsi, [rip + nl_char];
        mov rdx, 1;
        call sys_write;
echo_done:
        xor rax, rax;
        ret
      }
    } @no_frame

  // exit_builtin() -> u64
  // Call sys_exit with optional numeric exit code from argv[1], or 0 if not provided.
  pub let exit_builtin : () -> u64 !{mem, sysreg} @{} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "R17-M4 (#630): exit_builtin calls sys_exit with optional numeric exit code from argv[1]. Parses argv[1] via dec_parse, or uses 0. Returns (unreachable).",
      block: {
        lea rax, [rip + argc];
        mov rax, [rax];
        xor rdi, rdi;
        cmp rax, 2;
        jl exit_go;
        lea rax, [rip + argv_buf];
        mov rdi, [rax + 8];
        call dec_parse;
        mov rdi, rax;
exit_go:
        call sys_exit;
        hlt
      }
    } @no_frame

  // dec_parse(rdi=cstr) -> u64 (in rax)
  // Parse a null-terminated decimal string into u64. Non-digit chars terminate parsing.
  pub let dec_parse : (u64) -> u64 !{mem} @{} =
    fn (s: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R17-M4 (#630 helper): dec_parse parses decimal string (cstr in rdi) into u64 returned in rax. Loop: load byte, if not in [0x30..0x39] stop, else accumulate via rax*10+digit.",
      block: {
        xor rax, rax;
dec_parse_loop:
        xor rcx, rcx;
        mov cl, [rdi];
        and rcx, 0xff;
        cmp rcx, 0x30;
        jl dec_parse_done;
        cmp rcx, 0x39;
        jg dec_parse_done;
        mov r8, rax;
        shl r8, 3;
        add r8, rax;
        add r8, rax;
        sub rcx, 0x30;
        add r8, rcx;
        mov rax, r8;
        add rdi, 1;
        jmp dec_parse_loop;
dec_parse_done:
        ret
      }
    } @no_frame

  // cwd_init() -> ()
  // Initialize current working directory buffer: set _cwd_buf[0]='/', _cwd_buf[1..255]=NUL (zero-init in .bss).
  pub let cwd_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R17-M4 (#631 helper): cwd_init initializes _cwd_buf with root directory '/'. .bss is zero-init, so byte 1 is already NUL.",
      block: {
        lea rdi, [rip + _cwd_buf];
        mov rcx, 0x2F;
        mov [rdi], cl;
        ret
      }
    } @no_frame

  // pwd_builtin() -> u64
  // Print working directory (_cwd_buf) and newline.
  pub let pwd_builtin : () -> u64 !{mem, sysreg} @{fs} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {fs},
      justification: "R17-M4 (#631): pwd_builtin emits _cwd_buf (current directory) + newline via puts_new and sys_write. Returns 0.",
      block: {
        lea rdi, [rip + _cwd_buf];
        call puts_new;
        mov rdi, 1;
        lea rsi, [rip + nl_char];
        mov rdx, 1;
        call sys_write;
        xor rax, rax;
        ret
      }
    } @no_frame

  // help_builtin() -> u64
  // List all builtins with descriptions. Uses r12 (callee-saved).
  pub let help_builtin : () -> u64 !{mem, sysreg} @{fs} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {fs},
      justification: "R17-M4 (#633): help_builtin walks builtin table and emits name - desc\\n for each. Uses r12 (callee-saved). Returns 0.",
      block: {
        push r12;
        xor r12, r12;
help_loop:
        lea rax, [rip + builtin_count];
        mov rax, [rax];
        cmp r12, rax;
        jge help_done;

        // name
        lea rax, [rip + builtin_names];
        mov rdi, [rax + r12*8];
        call puts_new;

        // " - "
        mov rdi, 1;
        lea rsi, [rip + help_sep];
        mov rdx, 3;
        call sys_write;

        // desc
        lea rax, [rip + builtin_descs];
        mov rdi, [rax + r12*8];
        call puts_new;

        // \n
        mov rdi, 1;
        lea rsi, [rip + nl_char];
        mov rdx, 1;
        call sys_write;

        add r12, 1;
        jmp help_loop;
help_done:
        pop r12;
        xor rax, rax;
        ret
      }
    } @no_frame

  // env_builtin() -> u64
  // Print environment variables (stub: prints PATH=/bin).
  pub let env_builtin : () -> u64 !{mem, sysreg} @{fs} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {fs},
      justification: "R17-M4 (#634): env_builtin emits environment (stub: PATH=/bin). Returns 0.",
      block: {
        mov rdi, 1;
        lea rsi, [rip + env_path_msg];
        mov rdx, 10;
        call sys_write;
        xor rax, rax;
        ret
      }
    } @no_frame

  // cd_builtin() -> u64
  // Change working directory: copy argv[1] into _cwd_buf. argc<2 resets to "/".
  // Rejects relative paths (must start with '/') and paths >= 256 bytes.
  // No kernel-side existence check at R17.M4 (no chdir/stat syscall yet).
  pub let cd_builtin : () -> u64 !{mem, sysreg} @{fs} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {fs},
      justification: "R17-M4 (#632): cd_builtin writes argv[1] to _cwd_buf. argc<2 → reset _cwd_buf to \"/\". argv[1][0] != '/' → error (POSIX-analog since no HOME/relative resolution). strlen(argv[1]) > 255 → error (buffer bound). Uses strlen+memcpy from string.pdx; #1248-safe byte compare (xor rax; mov al; and rax, 0xff; cmp rax).",
      block: {
        lea rax, [rip + argc];
        mov rax, [rax];
        cmp rax, 2;
        jl cd_reset_root;

        // argv[1] pointer
        lea rax, [rip + argv_buf];
        mov r10, [rax + 8];

        // Reject relative path: argv[1][0] must be '/'
        xor rax, rax;
        mov al, [r10];
        and rax, 0xff;
        cmp rax, 0x2F;
        jne cd_err_relative;

        // Length check: strlen(argv[1]) must be <= 255
        mov rdi, r10;
        call strlen;
        mov r11, rax;
        cmp r11, 255;
        jg cd_err_too_long;

        // memcpy(_cwd_buf, argv[1], strlen+1) — includes trailing NUL
        add r11, 1;
        lea rdi, [rip + _cwd_buf];
        mov rsi, r10;
        mov rdx, r11;
        call memcpy;
        xor rax, rax;
        ret;

      cd_reset_root:
        lea rdi, [rip + _cwd_buf];
        mov rcx, 0x2F;
        mov [rdi], cl;
        xor rcx, rcx;
        mov [rdi + 1], cl;
        xor rax, rax;
        ret;

      cd_err_relative:
        mov rdi, 2;
        lea rsi, [rip + cd_err_rel];
        mov rdx, 33;
        call sys_write;
        mov rax, 1;
        ret;

      cd_err_too_long:
        mov rdi, 2;
        lea rsi, [rip + cd_err_long];
        mov rdx, 18;
        call sys_write;
        mov rax, 1;
        ret
      }
    } @no_frame

  // rp_build_candidate(prefix_ptr: u64, prefix_len: u64) -> u64
  // R57.M4-005 (#1801): builds "<prefix><argv[0]-name>\0" into the
  // resolved_path .bss slot and returns its address. Parameterized
  // sibling of the original hardcoded-/bin/-prefix build code (same
  // memcpy+strlen shape, same r8-reload discipline), so resolve_path's
  // PATH-prefix loop can reuse one code path for every candidate instead
  // of duplicating the memcpy pair per prefix.
  pub let rp_build_candidate : (u64, u64) -> u64 !{mem} @{} =
    fn (prefix_ptr: u64) (prefix_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R57.M4-005 (#1801): rp_build_candidate(prefix_ptr, prefix_len) copies prefix_ptr[0..prefix_len) then argv_buf[0]'s NUL-terminated name into resolved_path, returning &resolved_path. r10 holds prefix_len across the first memcpy call (memcpy clobbers rax/rcx/rdi/rsi/r8, but not r9/r10) so the second copy's destination offset (resolved_path + prefix_len) can be computed via register-register `add rdi, r10` -- no `add reg, [mem]` per this file's encoder-conservatism discipline. Mirrors the WAVE-9 (#1012) r8-reload fix in the original resolve_prepend code: memcpy's `mov r8, rdi` (dst-save for return) clobbers r8, so argv_buf[0]'s pointer is reloaded into r8 fresh before each use; strlen is relied upon to preserve r8 (per its string.pdx impl, which only touches rax/rcx/rdi) so a single reload before `call strlen` suffices to carry the pointer through both the length computation and the subsequent memcpy's src argument.",
      block: {
        // rdi = prefix_ptr, rsi = prefix_len (SysV arg registers, per the
        // curried fn signature above -- same binding memcpy/strlen use).
        mov r10, rsi;                    // r10 = prefix_len (survives the memcpy call below)
        mov r9, rdi;                     // r9 = prefix_ptr

        lea rdi, [rip + resolved_path];  // dst = &resolved_path
        mov rsi, r9;                     // src = prefix_ptr
        mov rdx, r10;                    // n = prefix_len
        call memcpy;

        // memcpy clobbers r8 (its impl does `mov r8, rdi` to save dst for
        // return, per the WAVE-9 (#1012) fix this mirrors). Reload argv[0]
        // pointer fresh before using r8 again.
        lea rax, [rip + argv_buf];
        mov r8, [rax];
        mov rdi, r8;
        call strlen;                     // rax = strlen(argv[0]); strlen preserves r8
        add rax, 1;                      // include NUL terminator
        mov rdx, rax;                    // n = namelen + 1
        lea rdi, [rip + resolved_path];
        add rdi, r10;                    // dst = resolved_path + prefix_len (register-only add)
        mov rsi, r8;                     // src = argv[0] ptr (preserved by strlen)
        call memcpy;

        lea rax, [rip + resolved_path];
        ret
      }
    } @no_frame

  // resolve_path() -> u64
  // R57.M4-005 (#1801): PATH-prefix walk for argv[0] without a '/'.
  //
  // Design:
  //   - If argv[0] contains '/': legacy as-is behavior (return argv[0]
  //     unchanged), but still emit the "shell exec ok" fingerprint
  //     (resolved == argv[0] name) so downstream shell smokes observe
  //     that resolve_path executed on this path too.
  //   - Otherwise walk a hardcoded PATH prefix list ["/bin/", "/usr/bin/"]
  //     (mirrors init's PATH=/bin:/usr/bin per the issue). For each
  //     prefix: build "<prefix><argv[0]>\0" into the resolved_path .bss
  //     slot via rp_build_candidate, then probe it with sys_stat (SC+ ID
  //     77, rdi=path, rsi=255, rdx=&_resolved_stat_scratch). rax == 0 ->
  //     hit: emit the fingerprint and return &resolved_path. rax != 0 ->
  //     miss: try the next prefix.
  //   - If every prefix misses, fall through to the legacy /bin/-prepend
  //     behavior (rebuild resolved_path with bin_prefix, no fingerprint)
  //     so execve still runs and fails with the same ENOENT-style
  //     failure mode as before #1801 -- no regression on a genuinely
  //     missing binary.
  //
  //   Deferred: env-passed PATH. init.pdx is NOT touched by this issue --
  //   sys_execve_shim does not populate envp at M0 (see ls.pdx L7-11's
  //   header note re sys_execve_shim.pdx §Non-Scope), so there is no
  //   envp for init to seed a PATH variable into. The two-prefix list
  //   here is hardcoded and stays that way until execve gains envp
  //   support.
  //
  // Uses memcpy and strlen from string.pdx for copying and length
  // computation, and inline `mov rax, 77/12; syscall` for sys_stat /
  // sys_debug_puts (mirrors rootfs_seed.pdx's inline-syscall shape).
  pub let resolve_path : () -> u64 !{mem, sysreg} @{fs} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {fs},
      justification: "R57.M4-005 (#1801): resolve_path now walks a hardcoded two-entry PATH prefix list (\"/bin/\", \"/usr/bin/\") when argv[0] has no '/', probing each candidate with sys_stat (SC+ ID 77) via rp_build_candidate before committing to it, and falls through to the legacy /bin/-prepend behavior only if both miss (no regression: execve still fails ENOENT-style on a genuinely missing binary). On a hit (or on the as-is '/'-containing path) it emits a 'shell exec ok -- argv[0]=<name> resolved=<path> [legacy: SHELL EXEC OK]' fingerprint via 5 sys_debug_puts calls (SC+ ID 12) so downstream shell smokes can observe resolve_path's decision; the fall-through-to-/bin/ miss path does NOT emit it. Capabilities widen from {} to {fs} (sys_stat is fs-gated, same as sys_open/sys_getdents in ls.pdx) and effects widen from {mem} to {mem, sysreg} (every SYSCALL clobbers rcx/r11 and the debug_puts/stat calls are real SYSCALLs, not just callee calls). envp-based PATH is explicitly deferred -- see the design comment above -- because sys_execve_shim does not pass envp to the child at M0, so init.pdx has nothing to seed. Reserved-label discipline: all internal labels are rp_-prefixed (resolve_scan/resolve_prepend/resolve_asis's bare-word-adjacent names predate this fix; rp_scan/rp_asis/rp_walk_path/rp_hit replace them here) since bare `walk`/`loop`/etc. are paideia-as keywords.",
      block: {
        lea rax, [rip + argv_buf];
        mov r8, [rax];
        mov r9, r8;
rp_scan:
        xor rax, rax;
        mov al, [r9];
        and rax, 0xff;
        cmp rax, 0;
        je rp_walk_path;
        cmp rax, 0x2F;
        je rp_asis;
        add r9, 1;
        jmp rp_scan;

rp_asis:
        // argv[0] already contains '/': legacy as-is behavior, plus the
        // hit fingerprint (resolved == argv[0] name) so this path is
        // also observable downstream.
        lea rdi, [rip + sh_exec_ok_prefix];
        mov rsi, 25;
        mov rax, 12;
        syscall;

        lea rax, [rip + argv_buf];
        mov r8, [rax];
        mov rdi, r8;
        call strlen;
        mov rsi, rax;
        lea rax, [rip + argv_buf];
        mov r8, [rax];
        mov rdi, r8;
        mov rax, 12;
        syscall;

        lea rdi, [rip + sh_exec_ok_mid];
        mov rsi, 10;
        mov rax, 12;
        syscall;

        lea rax, [rip + argv_buf];
        mov r8, [rax];
        mov rdi, r8;
        call strlen;
        mov rsi, rax;
        lea rax, [rip + argv_buf];
        mov r8, [rax];
        mov rdi, r8;
        mov rax, 12;
        syscall;

        lea rdi, [rip + sh_exec_ok_tail];
        mov rsi, 25;
        mov rax, 12;
        syscall;

        lea rax, [rip + argv_buf];
        mov rax, [rax];
        ret;

rp_walk_path:
        // No '/' in argv[0]: walk the hardcoded PATH prefix list.
        lea rdi, [rip + bin_prefix];
        mov rsi, 5;
        call rp_build_candidate;

        lea rdi, [rip + resolved_path];
        mov rsi, 255;
        lea rdx, [rip + _resolved_stat_scratch];
        mov rax, 77;
        syscall;
        cmp rax, 0;
        je rp_hit;

        lea rdi, [rip + usr_bin_prefix];
        mov rsi, 9;
        call rp_build_candidate;

        lea rdi, [rip + resolved_path];
        mov rsi, 255;
        lea rdx, [rip + _resolved_stat_scratch];
        mov rax, 77;
        syscall;
        cmp rax, 0;
        je rp_hit;

        // Both candidates missed: fall through to the legacy
        // /bin/-prepend behavior. Do NOT emit the fingerprint here --
        // only a genuine hit emits it.
        lea rdi, [rip + bin_prefix];
        mov rsi, 5;
        call rp_build_candidate;
        ret;

rp_hit:
        // sys_stat succeeded on resolved_path (rax == 0): emit the
        // fingerprint, then return &resolved_path.
        lea rdi, [rip + sh_exec_ok_prefix];
        mov rsi, 25;
        mov rax, 12;
        syscall;

        lea rax, [rip + argv_buf];
        mov r8, [rax];
        mov rdi, r8;
        call strlen;
        mov rsi, rax;
        lea rax, [rip + argv_buf];
        mov r8, [rax];
        mov rdi, r8;
        mov rax, 12;
        syscall;

        lea rdi, [rip + sh_exec_ok_mid];
        mov rsi, 10;
        mov rax, 12;
        syscall;

        lea rdi, [rip + resolved_path];
        mov r8, rdi;
        call strlen;
        mov rsi, rax;
        mov rdi, r8;
        mov rax, 12;
        syscall;

        lea rdi, [rip + sh_exec_ok_tail];
        mov rsi, 25;
        mov rax, 12;
        syscall;

        lea rax, [rip + resolved_path];
        ret
      }
    } @no_frame

  // exec_child() -> u64 !{mem, sysreg, sysprivcap} @{fs, sched, cap}
  // Fork and execve argv[0] with NULL-terminated argv_buf. Parent waits via sys_wait4.
  // Returns 0 on child spawned, 1 on error (argc==0 or fork failed).
  //
  // R58.M5-001 (#1805): before resolve_path/execve, the child branch scans
  // argv_buf for the tokenizer's redirect tokens (which point at
  // Tokenizer::redirect_gt / redirect_gtgt / redirect_lt rodata — see
  // tokenizer.pdx header note) and, for each one found: opens the
  // following token (the target filename) with the matching flags,
  // sys_dup2's the new fd onto the target fd (1 for '>'/'>>', 0 for '<'),
  // closes the new fd, and removes both the operator and filename tokens
  // from argv_buf (left-compact) so execve never sees them. This scan is
  // child-only (post-fork, separate address space via COW) — the parent's
  // argv_buf is untouched.
  pub let exec_child : () -> u64 !{mem, sysreg, sysprivcap} @{fs, sched, cap} =
    fn () -> unsafe {
      effects: {mem, sysreg, sysprivcap}, capabilities: {fs, sched, cap},
      justification: "R17-m3-005 (#625) + R17-m3-006 (#626) + R58.M5-001 (#1805): exec_child forks + execves argv[0] with NULL-terminated argv_buf, envp=NULL; parent waits via sys_wait4 into child_wait_status. On fork error or argc==0 returns 1; on execve failure child calls sys_exit(127). Reads argc/argv_buf from Tokenizer .bss (linked symbols). Callees are syscall shims (no SysV pad needed). R17-m3-006 (#626): child branch calls resolve_path to prepend /bin/ when argv[0] has no slash. R58.M5-001 (#1805): child branch additionally runs an rd_-prefixed redirect scan (see block below) between the fork and resolve_path/execve. Register plan for the scan: r12=argc (loaded once), r13=read_idx, r14=write_idx, r15=current token ptr / target_fd carrier, rbx=fd returned by sys_open (needed across the sys_dup2 call so sys_close can close the ORIGINAL fd, not dup2's return value) -- all six are callee-saved and untouched by strlen/memcmp (touch only rax/rcx/rdx/rdi/rsi/r8) and by the sys_open/sys_dup2/sys_close/sys_debug_puts stubs (each is `mov rax,N; syscall; ret`, touching only rax plus whatever the SYSCALL instruction itself clobbers -- rcx/r11 -- never r12-r15/rbx). rax/rcx/rdx/rdi/rsi/r8/r9/r10/r11 are NOT trusted to survive any call or inline `syscall` in this scan, per dispatch.pdx's own documented r9/r10 syscall-shuffle risk (see echo_builtin's justification above) -- every use of argv_buf[i] is reloaded fresh via `lea rax,[rip+argv_buf]; mov r_, [rax+idx*8]` immediately before each use rather than cached across a call, mirroring resolve_path's rp_hit reload discipline. Detection is strlen+memcmp against Tokenizer's redirect_gt/redirect_gtgt/redirect_lt rodata (not a raw byte compare), per the issue's explicit instruction, so the check stays coupled to the same constants the tokenizer used to build the token rather than to an assumed byte value. Reserved-label discipline: every new label is rd_-prefixed.",
      block: {
        // Guard: argc == 0 → error
        lea rax, [rip + argc];
        mov rax, [rax];
        cmp rax, 0;
        je exec_child_err;

        // NULL-terminate argv_buf[argc] = 0
        xor rcx, rcx;
        lea r11, [rip + argv_buf];
        mov [r11 + rax*8], rcx;

        // fork
        call sys_fork;
        cmp rax, 0;
        jl exec_child_err;
        je exec_child_do_execve;

        // parent: wait4(pid, &child_wait_status, 0, NULL). rax has pid.
        mov rdi, rax;
        lea rsi, [rip + child_wait_status];
        xor rdx, rdx;
        xor rcx, rcx;
        call sys_wait4;
        ret;

exec_child_do_execve:
        // R58.M5-001 (#1805): redirect scan + left-compact, child-only.
        push r12;
        push r13;
        push r14;
        push r15;
        push rbx;

        lea rax, [rip + argc];
        mov r12, [rax];         // r12 = argc
        xor r13, r13;           // r13 = read_idx = 0
        xor r14, r14;           // r14 = write_idx = 0

rd_loop:
        cmp r13, r12;
        jge rd_compact_done;

        lea rax, [rip + argv_buf];
        mov r15, [rax + r13*8]; // r15 = argv_buf[read_idx] (survives strlen/memcmp — neither touches r15)
        mov rdi, r15;
        call strlen;            // rax = strlen(token)
        cmp rax, 2;
        je rd_try_gtgt;
        cmp rax, 1;
        jne rd_keep_token;

        // len == 1: could be '>' or '<'
        mov rdi, r15;
        lea rsi, [rip + redirect_gt];
        mov rdx, 1;
        call memcmp;
        cmp rax, 0;
        je rd_try_gt_single;

        mov rdi, r15;
        lea rsi, [rip + redirect_lt];
        mov rdx, 1;
        call memcmp;
        cmp rax, 0;
        je rd_try_lt;

        jmp rd_keep_token;

rd_try_gtgt:
        mov rdi, r15;
        lea rsi, [rip + redirect_gtgt];
        mov rdx, 2;
        call memcmp;
        cmp rax, 0;
        jne rd_keep_token;
        // matched ">>": append to stdout
        mov r15, 1;                     // r15 = target_fd (stdout)
        mov rsi, 0x241;                 // O_WRONLY|O_CREAT|O_APPEND (vfs_open.pdx: 0x01|0x40|0x200)
        jmp rd_open_common;

rd_try_gt_single:
        mov r15, 1;                     // r15 = target_fd (stdout)
        mov rsi, 0xC1;                  // O_WRONLY|O_CREAT|O_TRUNC (vfs_open.pdx: 0x01|0x40|0x80)
        jmp rd_open_common;

rd_try_lt:
        mov r15, 0;                     // r15 = target_fd (stdin)
        mov rsi, 0;                     // O_RDONLY
        jmp rd_open_common;

rd_open_common:
        // rsi already holds open() flags (set by the caller above). Need
        // a filename token following the operator: argv_buf[read_idx+1].
        mov rax, r13;
        add rax, 1;
        cmp rax, r12;
        jge rd_apply_no_target;         // operator with nothing after it: drop it alone

        lea rcx, [rip + argv_buf];
        mov rdi, [rcx + rax*8];         // rdi = filename ptr (sys_open arg1)
        mov rdx, 0x1A4;                 // mode 0644 (only meaningful with O_CREAT)
        call sys_open;                  // rax = new fd, or negative errno
        cmp rax, 0;
        jl rd_apply_open_err;
        mov rbx, rax;                   // rbx = new fd (survives sys_dup2/sys_close: neither touches rbx)

        mov rdi, rbx;
        mov rsi, r15;                   // newfd = target_fd
        call sys_dup2;
        mov rdi, rbx;                   // close the ORIGINAL new fd, not sys_dup2's return value
        call sys_close;

        // Fingerprint: "shell redirect ok -- argv[0]=<name> op=<op> file=<path> [legacy: SHELL REDIRECT OK]\n"
        lea rdi, [rip + sh_redirect_ok_prefix];
        mov rsi, 29;
        mov rax, 12;
        syscall;

        lea rax, [rip + argv_buf];
        mov r8, [rax];                  // argv[0] ptr (index 0 is stable across compaction — see justification)
        mov rdi, r8;
        call strlen;
        mov rsi, rax;
        lea rax, [rip + argv_buf];
        mov r8, [rax];
        mov rdi, r8;
        mov rax, 12;
        syscall;

        lea rdi, [rip + sh_redirect_ok_mid_op];
        mov rsi, 4;
        mov rax, 12;
        syscall;

        lea rax, [rip + argv_buf];
        mov r8, [rax + r13*8];          // op token ptr (still the operator: read_idx untouched so far)
        mov rdi, r8;
        call strlen;
        mov rsi, rax;
        lea rax, [rip + argv_buf];
        mov r8, [rax + r13*8];
        mov rdi, r8;
        mov rax, 12;
        syscall;

        lea rdi, [rip + sh_redirect_ok_mid_file];
        mov rsi, 6;
        mov rax, 12;
        syscall;

        mov rcx, r13;
        add rcx, 1;
        lea rax, [rip + argv_buf];
        mov r8, [rax + rcx*8];          // filename token ptr
        mov rdi, r8;
        call strlen;
        mov rsi, rax;
        mov rcx, r13;
        add rcx, 1;
        lea rax, [rip + argv_buf];
        mov r8, [rax + rcx*8];
        mov rdi, r8;
        mov rax, 12;
        syscall;

        lea rdi, [rip + sh_redirect_ok_tail];
        mov rsi, 29;
        mov rax, 12;
        syscall;

        add r13, 2;                     // consumed operator + filename; neither copied forward
        jmp rd_loop;

rd_apply_open_err:
        // sys_open failed: drop the malformed redirect silently (M0
        // best-effort), no fingerprint.
        add r13, 2;
        jmp rd_loop;

rd_apply_no_target:
        // operator with no following token: drop just the operator.
        add r13, 1;
        jmp rd_loop;

rd_keep_token:
        // not a redirect: left-compact copy argv_buf[read_idx] -> argv_buf[write_idx].
        lea rax, [rip + argv_buf];
        mov [rax + r14*8], r15;
        add r13, 1;
        add r14, 1;
        jmp rd_loop;

rd_compact_done:
        // NUL-pointer-terminate the compacted argv at write_idx, and keep
        // argc consistent with the new (child-local) count.
        lea rax, [rip + argv_buf];
        xor rcx, rcx;
        mov [rax + r14*8], rcx;
        lea rax, [rip + argc];
        mov [rax], r14;

        // #1805 debugger finding: if EVERY token was consumed by the
        // redirect scan (e.g. line was `> /tmp/x` with no command), the
        // post-compaction argc is 0 and resolve_path would deref
        // argv_buf[0]==NULL. Exit the child cleanly with 127 instead.
        cmp r14, 0;
        je rd_apply_empty_argv;

        pop rbx;
        pop r15;
        pop r14;
        pop r13;
        pop r12;

        // child: execve(resolve_path(), &argv_buf[0], NULL)
        call resolve_path;
        mov rdi, rax;
        lea rsi, [rip + argv_buf];
        xor rdx, rdx;
        call sys_execve;
        // execve returned → failed. Exit 127.
        mov rdi, 127;
        call sys_exit;
        hlt;

rd_apply_empty_argv:
        // Post-compaction argc == 0 — no command left to exec. Restore
        // callee-save regs, then sys_exit(127) in the child (mirrors the
        // "execve returned -> failed" exit code above).
        pop rbx;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        mov rdi, 127;
        call sys_exit;
        hlt;

exec_child_err:
        mov rax, 1;
        ret
      }
    } @no_frame
}
