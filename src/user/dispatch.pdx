// src/user/dispatch.pdx — R17-M3-004 (#624) + R17-M4 (#629-634)
// Shell builtin dispatch: runtime-loaded table of command names and handlers.
// Accepts argc/argv from Tokenizer .bss, walks builtin table, calls matching handler or returns not-found.
// Acceptance: builds; echo/exit/pwd/help/env builtins work; dispatch_line returns 0 on hit, 1 on miss.
// See design/kernel/r17-m3-004-shell-builtin-dispatch.md and design/kernel/r17-m4-shell-builtins.md.

module Dispatch = structure {
  pub let echo_name = "echo\0"
  pub let exit_name = "exit\0"
  pub let pwd_name = "pwd\0"
  pub let help_name = "help\0"
  pub let env_name = "env\0"
  pub let cd_name = "cd\0"
  pub let sp_char = " "
  pub let nl_char = "\n"
  pub let bin_prefix = "/bin/\0"
  pub let usr_bin_prefix = "/usr/bin/\0"
  pub let help_sep = " - \0"
  pub let env_path_msg = "PATH=/bin\n\0"
  pub let clear_name = "clear\0"
  pub let clear_desc = "clear screen and home cursor\0"
  pub let clear_seq = "\x1b[2J\x1b[H\0"
  pub let echo_desc = "echo text to stdout\0"
  pub let exit_desc = "exit shell (opt N)\0"
  pub let pwd_desc = "print working directory\0"
  pub let help_desc = "list all builtins\0"

  // #1975: help_builtin's /bin enumeration. help_bin_path has no trailing
  // slash (matches rootfs_seed.pdx's rs_path_bin convention for opening
  // "/bin" as a directory). help_bin_header wire length (NUL excluded) is
  // 7 ("\n/bin:\n").
  pub let help_bin_path = "/bin\0"
  pub let help_bin_header = "\n/bin:\n\0"
  pub let env_desc = "print environment vars\0"
  pub let cd_desc = "change working directory\0"

  // R86.M1-006 (#1959): cd_builtin now calls sys_chdir directly (kernel-
  // side path resolution against TASK_OFF_CWD replaces the old local
  // _cwd_buf copy + "must be absolute" refusal). "shell cd ok -- path=" is
  // split into fixed-length fragments the same way sh_exec_ok_* is above,
  // so the emit sequence can sandwich the runtime-length resolved path
  // (read back via sys_getcwd) between prefix and tail via sys_debug_puts.
  // Wire lengths (NUL excluded): prefix=20, tail=1 (just '\n').
  pub let cd_ok_prefix = "shell cd ok -- path=\0"
  pub let cd_fail_msg = "SHELL CD FAIL\n\0"
  pub let cd_root_path = "/\0"

  // R57.M4-005 (#1801): "shell exec ok" fingerprint, split into three
  // fixed-length fragments so the emit sequence can sandwich the two
  // runtime-length fields (argv[0] name, resolved path) between them via
  // sys_debug_puts (SC+ ID 12). ASCII "--" (not U+2014 em-dash) per
  // rootfs_seed.pdx L23's 7-bit-ASCII-on-wire note. Wire lengths (NUL
  // excluded, passed explicitly as sys_debug_puts's rsi): prefix=25,
  // mid=10, tail=25.
  pub let sh_exec_ok_prefix = "shell exec ok -- argv[0]=\0"
  pub let sh_exec_ok_mid = " resolved=\0"
  pub let sh_exec_ok_tail = " [legacy: SHELL EXEC OK]\n\0"

  // R58.M5-001 (#1805): "shell redirect ok" fingerprint, split into
  // fixed-length fragments the same way sh_exec_ok_* is above, so the
  // emit sequence in exec_child's rd_ redirect scan can sandwich the
  // three runtime-length fields (argv[0] name, operator, target file)
  // between them via sys_debug_puts (SC+ ID 12). ASCII "--" (not U+2014).
  // Wire lengths (NUL excluded, passed explicitly as sys_debug_puts's
  // rsi): prefix=29, mid_op=4, mid_file=6, tail=29.
  pub let sh_redirect_ok_prefix = "shell redirect ok -- argv[0]=\0"
  pub let sh_redirect_ok_mid_op = " op=\0"
  pub let sh_redirect_ok_mid_file = " file=\0"
  pub let sh_redirect_ok_tail = " [legacy: SHELL REDIRECT OK]\n\0"

  pub let mut builtin_names : [u64; 8] = uninit @align(8)
  pub let mut builtin_handlers : [u64; 8] = uninit @align(8)
  pub let mut builtin_descs : [u64; 8] = uninit @align(8)
  pub let mut builtin_count : u64 = uninit @align(8)

  pub let mut child_wait_status : [u64; 1] = uninit @align(8)
  pub let mut resolved_path : [u8; 320] = uninit @align(8)
  // R57.M4-005 (#1801): sys_stat (SC+ ID 77) result scratch for
  // resolve_path's PATH-prefix probe. 64 bytes matches the kernel-side
  // stat struct layout (src/kernel/core/syscall/sys_stat.pdx); contents
  // are unused beyond the rax==0/!=0 hit/miss signal, so no field
  // offsets are named here.
  pub let mut _resolved_stat_scratch : [u64; 8] = uninit @align(8)
  // R86.M1-006/007 (#1959/#1960): sys_getcwd echo buffers for cd_builtin's
  // "shell cd ok -- path=<X>" fingerprint and pwd_builtin's own output.
  // Replaces the R17-M4 _cwd_buf (retired) -- the kernel's TASK_OFF_CWD is
  // now the sole source of truth for "where am I"; userspace only ever
  // holds a transient echo of what sys_getcwd just reported.
  pub let mut _cd_path_scratch : [u8; 256] = uninit @align(8)
  pub let mut _pwd_buf : [u8; 256] = uninit @align(8)
  // #1975: help_builtin's sys_getdents scratch for its /bin enumeration.
  // 4 KiB matches the kernel's GETDENTS_IO_MAX cap (src/user/ls.pdx's
  // _ls_buf follows the same sizing).
  pub let mut _help_bin_buf : [u8; 4096] = uninit @align(8)
  pub let mut echo_emit_nl : u64 = uninit @align(8)
  pub let mut echo_first_token : u64 = uninit @align(8)
  pub let mut echo_idx : u64 = uninit @align(8)

  // dispatch_init() — populate runtime dispatch table at startup.
  // Loads addresses of echo_name, exit_name, pwd_name, help_name, env_name, cd_name, clear_name into builtin_names[0..6].
  // Loads addresses of echo_builtin, exit_builtin, pwd_builtin, help_builtin, env_builtin, cd_builtin, clear_builtin into builtin_handlers[0..6].
  // Loads addresses of echo_desc, exit_desc, pwd_desc, help_desc, env_desc, cd_desc, clear_desc into builtin_descs[0..6].
  // Sets builtin_count = 7.
  pub let dispatch_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R17-m3-004 (#624) + R17-M4 (#629-634): dispatch_init populates builtin_names, builtin_handlers, builtin_descs, builtin_count at runtime startup. Called once from _start before main_loop. No arguments; no return.",
      block: {
        lea rdi, [rip + builtin_names];
        lea rax, [rip + echo_name];
        mov [rdi + 0], rax;
        lea rax, [rip + exit_name];
        mov [rdi + 8], rax;
        lea rax, [rip + pwd_name];
        mov [rdi + 16], rax;
        lea rax, [rip + help_name];
        mov [rdi + 24], rax;
        lea rax, [rip + env_name];
        mov [rdi + 32], rax;
        lea rax, [rip + cd_name];
        mov [rdi + 40], rax;
        lea rax, [rip + clear_name];
        mov [rdi + 48], rax;

        lea rdi, [rip + builtin_handlers];
        lea rax, [rip + echo_builtin];
        mov [rdi + 0], rax;
        lea rax, [rip + exit_builtin];
        mov [rdi + 8], rax;
        lea rax, [rip + pwd_builtin];
        mov [rdi + 16], rax;
        lea rax, [rip + help_builtin];
        mov [rdi + 24], rax;
        lea rax, [rip + env_builtin];
        mov [rdi + 32], rax;
        lea rax, [rip + cd_builtin];
        mov [rdi + 40], rax;
        lea rax, [rip + clear_builtin];
        mov [rdi + 48], rax;

        lea rdi, [rip + builtin_descs];
        lea rax, [rip + echo_desc];
        mov [rdi + 0], rax;
        lea rax, [rip + exit_desc];
        mov [rdi + 8], rax;
        lea rax, [rip + pwd_desc];
        mov [rdi + 16], rax;
        lea rax, [rip + help_desc];
        mov [rdi + 24], rax;
        lea rax, [rip + env_desc];
        mov [rdi + 32], rax;
        lea rax, [rip + cd_desc];
        mov [rdi + 40], rax;
        lea rax, [rip + clear_desc];
        mov [rdi + 48], rax;

        lea rdi, [rip + builtin_count];
        mov rax, 7;
        mov [rdi], rax;

        ret
      }
    } @no_frame

  // dispatch_line() -> u64
  // Reads argc and argv_buf from Tokenizer .bss (linked symbols).
  // Walks builtin_names table, compares argv[0] against each builtin name.
  // If hit: calls matching handler, returns 0.
  // If miss (no builtin matches, or argc==0): returns 1.
  // Register plan: r9 = argv[0], r10 = strlen(argv[0]), r11 = loop index.
  pub let dispatch_line : () -> u64 !{mem, sysreg} @{fs} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {fs},
      justification: "R17-m3-004 (#624): dispatch_line walks runtime builtin table. Reads argc/argv_buf from Tokenizer symbols (extern linkage). No arguments; uses r9=argv[0], r10=strlen(argv[0]), r11=loop index. Returns 0 on builtin hit (and calls handler), 1 on miss.",
      block: {
        lea rax, [rip + argc];
        mov rax, [rax];
        cmp rax, 0;
        je dispatch_notfound;

        lea rax, [rip + argv_buf];
        mov r9, [rax];
        mov rdi, r9;
        call strlen;
        mov r10, rax;

        xor r11, r11;
dispatch_loop:
        lea rax, [rip + builtin_count];
        mov rax, [rax];
        cmp r11, rax;
        jge dispatch_notfound;

        lea rax, [rip + builtin_names];
        mov rdi, [rax + r11*8];
        call strlen;
        cmp rax, r10;
        jne dispatch_next;

        mov rdi, r9;
        lea rax, [rip + builtin_names];
        mov rsi, [rax + r11*8];
        mov rdx, r10;
        call memcmp;
        cmp rax, 0;
        jne dispatch_next;

        lea rax, [rip + builtin_handlers];
        mov rax, [rax + r11*8];
        sub rsp, 8;
        call rax;
        add rsp, 8;
        xor rax, rax;
        ret;
dispatch_next:
        add r11, 1;
        jmp dispatch_loop;
dispatch_notfound:
        mov rax, 1;
        ret
      }
    } @no_frame

  // echo_builtin() -> u64
  // Emits argv[1..argc-1] (or argv[2..argc-1] if argv[1]=="-n") space-separated.
  // If "-n" flag not present, followed by newline. Reads argc/argv_buf from Tokenizer .bss.
  pub let echo_builtin : () -> u64 !{mem, sysreg} @{fs} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {fs},
      justification: "R17-M4 (#629) + #1016 fix: echo_builtin with -n flag support. Emits argv[1..argc-1] space-separated. If argv[1]==\"-n\", suppresses trailing newline and starts from argv[2]. Reads argc/argv_buf from Tokenizer .bss. Returns 0. Two bugs fixed for #1016: (a) space suppression tracked via echo_first_token .bss slot rather than the old r9==1||r9==2 heuristic that silently dropped the space between argv[1] and argv[2] when no -n flag was given. (b) argc AND the loop index are reloaded from memory at the top of every echo_scan iteration — the userland→kernel syscall path in src/kernel/core/syscall/entry.pdx shuffles r10 (SYSCALL arg-4) into r8 (SysV arg-5) and does not restore r10 before sysret; likewise r9 survives the shuffle only conditionally, so both are pinned to echo_idx / argc .bss slots across sys_write calls. Prior version kept argc in r10 and index in r9 across sys_write, which silently exited the loop after argv[1] because the garbage r10 satisfied the r9>=r10 test on iteration 2 (echo hello world → 'hello' only).",
      block: {
        // default: emit_nl = 1, first_token = 1, echo_idx = 1
        lea rax, [rip + echo_emit_nl];
        mov rcx, 1;
        mov [rax], rcx;
        lea rax, [rip + echo_first_token];
        mov rcx, 1;
        mov [rax], rcx;
        lea rax, [rip + echo_idx];
        mov rcx, 1;
        mov [rax], rcx;

        // if argc >= 2, check argv[1] for "-n" (exactly two chars: '-','n', NUL)
        lea rax, [rip + argc];
        mov r10, [rax];
        cmp r10, 2;
        jl echo_scan;
        lea rax, [rip + argv_buf];
        mov r11, [rax + 8];
        xor rax, rax;
        mov al, [r11];
        and rax, 0xff;
        cmp rax, 0x2D;
        jne echo_scan;
        xor rax, rax;
        mov al, [r11 + 1];
        and rax, 0xff;
        cmp rax, 0x6E;
        jne echo_scan;
        xor rax, rax;
        mov al, [r11 + 2];
        and rax, 0xff;
        cmp rax, 0;
        jne echo_scan;
        // "-n" confirmed: skip it, suppress \n
        lea rax, [rip + echo_idx];
        mov rcx, 2;
        mov [rax], rcx;
        lea rax, [rip + echo_emit_nl];
        xor rcx, rcx;
        mov [rax], rcx;

echo_scan:
        // Reload argc and idx from memory — r10 (arg-4) is clobbered by the
        // kernel's syscall shuffle on every sys_write; r9 is preserved but
        // pinning both to memory is simpler than tracking which subset.
        lea rax, [rip + argc];
        mov r10, [rax];
        lea rax, [rip + echo_idx];
        mov r9, [rax];
        cmp r9, r10;
        jge echo_maybe_nl;
        // Emit leading space unless this is the first token to be printed.
        lea rax, [rip + echo_first_token];
        mov rcx, [rax];
        cmp rcx, 0;
        jne echo_arg;   // first_token != 0 → no leading space, and mark 0 below
        mov rdi, 1;
        lea rsi, [rip + sp_char];
        mov rdx, 1;
        call sys_write;
echo_arg:
        // Reload r9 (idx) — sys_write above may have clobbered it (see justification).
        lea rax, [rip + echo_idx];
        mov r9, [rax];
        lea rax, [rip + argv_buf];
        mov rdi, [rax + r9*8];
        call strlen;
        mov rdx, rax;
        // Reload r9 again — strlen shouldn't touch it but be defensive.
        lea rax, [rip + echo_idx];
        mov r9, [rax];
        mov rdi, 1;
        lea rax, [rip + argv_buf];
        mov rsi, [rax + r9*8];
        call sys_write;
        // mark first_token = 0 (subsequent iterations get a leading space)
        lea rax, [rip + echo_first_token];
        xor rcx, rcx;
        mov [rax], rcx;
        // Advance idx via memory (r9 may be clobbered post-sys_write).
        lea rax, [rip + echo_idx];
        mov rcx, [rax];
        add rcx, 1;
        mov [rax], rcx;
        jmp echo_scan;
echo_maybe_nl:
        lea rax, [rip + echo_emit_nl];
        mov rax, [rax];
        cmp rax, 0;
        je echo_done;
        mov rdi, 1;
        lea rsi, [rip + nl_char];
        mov rdx, 1;
        call sys_write;
echo_done:
        xor rax, rax;
        ret
      }
    } @no_frame

  // exit_builtin() -> u64
  // Call sys_exit with optional numeric exit code from argv[1], or 0 if not provided.
  pub let exit_builtin : () -> u64 !{mem, sysreg} @{} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "R17-M4 (#630): exit_builtin calls sys_exit with optional numeric exit code from argv[1]. Parses argv[1] via dec_parse, or uses 0. Returns (unreachable).",
      block: {
        lea rax, [rip + argc];
        mov rax, [rax];
        xor rdi, rdi;
        cmp rax, 2;
        jl exit_go;
        lea rax, [rip + argv_buf];
        mov rdi, [rax + 8];
        call dec_parse;
        mov rdi, rax;
exit_go:
        call sys_exit;
        hlt
      }
    } @no_frame

  // dec_parse(rdi=cstr) -> u64 (in rax)
  // Parse a null-terminated decimal string into u64. Non-digit chars terminate parsing.
  pub let dec_parse : (u64) -> u64 !{mem} @{} =
    fn (s: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R17-M4 (#630 helper): dec_parse parses decimal string (cstr in rdi) into u64 returned in rax. Loop: load byte, if not in [0x30..0x39] stop, else accumulate via rax*10+digit.",
      block: {
        xor rax, rax;
dec_parse_loop:
        xor rcx, rcx;
        mov cl, [rdi];
        and rcx, 0xff;
        cmp rcx, 0x30;
        jl dec_parse_done;
        cmp rcx, 0x39;
        jg dec_parse_done;
        mov r8, rax;
        shl r8, 3;
        add r8, rax;
        add r8, rax;
        sub rcx, 0x30;
        add r8, rcx;
        mov rax, r8;
        add rdi, 1;
        jmp dec_parse_loop;
dec_parse_done:
        ret
      }
    } @no_frame

  // pwd_builtin() -> u64
  // R86.M1-007 (#1960): print the kernel's current-working-directory
  // vnode (TASK_OFF_CWD) via sys_getcwd, replacing the R17-M4 local
  // _cwd_buf echo. On failure (-EFAULT/-ENOENT/-ERANGE, none reachable
  // in practice at R86 -- getcwd is called with a full PATH_MAX buffer
  // and a task's cwd is always valid), emit nothing beyond the syscall's
  // own klog fingerprint absence and return 1.
  pub let pwd_builtin : () -> u64 !{mem, sysreg} @{fs} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {fs},
      justification: "R86.M1-007 (#1960): pwd_builtin calls sys_getcwd(&_pwd_buf, 256) -> rax = bytes written (incl. NUL) or negative errno. On success, sys_write(1, &_pwd_buf, rax-1) emits the path (rax-1 excludes the NUL sys_getcwd counted) followed by a newline via sys_write(1, &nl_char, 1); returns 0. On failure (rax < 0), returns 1 without writing anything -- matches cd_builtin's own fail-silent-to-stdout / nonzero-return convention.",
      block: {
        lea rdi, [rip + _pwd_buf];
        mov rsi, 256;
        call sys_getcwd;                 // rax = bytes (incl NUL) or -errno
        cmp rax, 0;
        jl pwd_fail;

        mov r10, rax;
        sub r10, 1;                      // r10 = strlen (excludes NUL)
        mov rdi, 1;
        lea rsi, [rip + _pwd_buf];
        mov rdx, r10;
        call sys_write;

        mov rdi, 1;
        lea rsi, [rip + nl_char];
        mov rdx, 1;
        call sys_write;

        xor rax, rax;
        ret;

      pwd_fail:
        mov rax, 1;
        ret
      }
    } @no_frame

  // help_builtin() -> u64
  // List all builtins with descriptions, then enumerate /bin contents.
  // Uses r12 (callee-saved) for the builtin loop.
  pub let help_builtin : () -> u64 !{mem, sysreg} @{fs} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {fs},
      justification: "R17-M4 (#633) + #1975: help_builtin walks builtin table and emits name - desc\\n for each (uses r12, callee-saved), then enumerates /bin so users can discover non-builtin commands without a separate `ls /bin`. #1975 addendum: after help_done's original pop r12, emit a '\\n/bin:\\n' header via sys_write(1,...), then sys_open(help_bin_path='/bin', O_RDONLY=0, mode=0) -- on failure (rax<0, this file's own signed-check convention, e.g. rd_open_common at exec_child) skip straight to cleanup so a missing/unmounted /bin degrades to 'help still works, just no listing' rather than failing the whole builtin. On success, walk sys_getdents (SC+ ID 78) exactly like src/user/ls.pdx's ls_getdents_top/ls_walk_top: inlined here (`mov rax, 78; syscall`) rather than `call`ed through src/user/libc/getdents.pdx, because build-user.sh routes libc/*.pdx's LIBC_OBJECTS into the ls.elf link only (see that file's header) and shell.elf does not consume them -- inlining avoids widening that link boundary for one call site. Register plan for the /bin walk, chosen to avoid r12 (already used and popped back to the caller's value by the builtin loop above, so left alone rather than re-saved): r13 = fd, r14 = bytes_returned for the current getdents batch, r15 = offset walker into _help_bin_buf. No persistent record-pointer register (unlike ls.pdx's r15) -- recomputed transiently into rax (`lea rax,[rip+_help_bin_buf]; add rax, r15`) each time it is needed, since caller-save rax is clobbered by every sys_write/syscall in between anyway. r13-r15 are pushed/popped around the whole block because help_builtin returns via ret to dispatch_line (not sys_exit), so SysV callee-save regs must come back intact. name_len is read via `xor r8,r8; mov_w r8,[rax+8]` per the frozen sys_getdents record layout (+8 u16 name_len, +12 name bytes, matching ls.pdx and src/kernel/core/syscall/sys_getdents.pdx). rax==0 or rax>4096 (negative errno, unsigned) both route to help_bin_close (empty dir and getdents failure are both 'stop and clean up', matching ls.pdx's ls_close_done/ls_fail_getdents both closing fd). Encoder-gap discipline: no `add reg,[mem]`/`sub reg,[mem]` anywhere -- every advance is register arithmetic. Reserved-label discipline: every new label prefixed `help_bin_`.",
      block: {
        push r12;
        xor r12, r12;
help_loop:
        lea rax, [rip + builtin_count];
        mov rax, [rax];
        cmp r12, rax;
        jge help_done;

        // name
        lea rax, [rip + builtin_names];
        mov rdi, [rax + r12*8];
        call puts_new;

        // " - "
        mov rdi, 1;
        lea rsi, [rip + help_sep];
        mov rdx, 3;
        call sys_write;

        // desc
        lea rax, [rip + builtin_descs];
        mov rdi, [rax + r12*8];
        call puts_new;

        // \n
        mov rdi, 1;
        lea rsi, [rip + nl_char];
        mov rdx, 1;
        call sys_write;

        add r12, 1;
        jmp help_loop;
help_done:
        pop r12;

        // ============================================================
        // #1975: enumerate /bin after the compiled-in builtin list.
        // ============================================================
        push r13;
        push r14;
        push r15;

        // "\n/bin:\n" (wire length 7, excludes help_bin_header's NUL)
        mov rdi, 1;
        lea rsi, [rip + help_bin_header];
        mov rdx, 7;
        call sys_write;

        // sys_open("/bin", O_RDONLY = 0, mode = 0) -> fd
        lea rdi, [rip + help_bin_path];
        xor rsi, rsi;
        xor rdx, rdx;
        call sys_open;
        cmp rax, 0;
        jl help_bin_pop;                 // open failed -- skip enumeration
        mov r13, rax;                    // r13 = fd

help_bin_getdents_top:
        mov rdi, r13;
        lea rsi, [rip + _help_bin_buf];
        mov rdx, 4096;
        mov rax, 78;                     // SC+ ID 78 = sys_getdents (inlined;
                                          // libc/getdents.pdx not linked into
                                          // shell.elf -- see justification)
        syscall;

        cmp rax, 0;
        je help_bin_close;               // directory drained
        cmp rax, 4096;
        ja help_bin_close;               // negative errno -- bail out, clean up

        mov r14, rax;                    // bytes_returned
        xor r15, r15;                    // offset := 0

help_bin_walk_top:
        // Bounds: offset + 12 must be <= bytes_returned to fit a header.
        mov rcx, r15;
        add rcx, 12;
        cmp rcx, r14;
        ja help_bin_getdents_top;        // batch drained without terminator; refill

        lea rax, [rip + _help_bin_buf];
        add rax, r15;                    // rax = &buf[offset] (record ptr)

        xor r8, r8;
        mov_w r8, [rax + 8];             // name_len (u16, zero-extended)
        cmp r8, 0;
        je help_bin_close;               // terminator -- directory drained

        // sys_write(1, &buf[offset + 12], name_len)
        mov rdi, 1;
        mov rsi, rax;
        add rsi, 12;
        mov rdx, r8;
        call sys_write;

        // sys_write(1, "\n", 1)
        mov rdi, 1;
        lea rsi, [rip + nl_char];
        mov rdx, 1;
        call sys_write;

        // Advance offset += 12 + name_len. rax/r8 are caller-save and
        // clobbered by the two calls above, so recompute the record
        // pointer and reload name_len from memory; r13-r15 are
        // callee-save and survive.
        lea rax, [rip + _help_bin_buf];
        add rax, r15;
        xor r8, r8;
        mov_w r8, [rax + 8];
        add r15, 12;
        add r15, r8;
        jmp help_bin_walk_top;

help_bin_close:
        mov rdi, r13;
        call sys_close;

help_bin_pop:
        pop r15;
        pop r14;
        pop r13;

        xor rax, rax;
        ret
      }
    } @no_frame

  // env_builtin() -> u64
  // Print environment variables (stub: prints PATH=/bin).
  pub let env_builtin : () -> u64 !{mem, sysreg} @{fs} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {fs},
      justification: "R17-M4 (#634): env_builtin emits environment (stub: PATH=/bin). Returns 0.",
      block: {
        mov rdi, 1;
        lea rsi, [rip + env_path_msg];
        mov rdx, 10;
        call sys_write;
        xor rax, rax;
        ret
      }
    } @no_frame

  // cd_builtin() -> u64
  // R86.M1-006 (#1959): change working directory via sys_chdir (kernel-
  // side TASK_OFF_CWD), replacing the R17-M4 local _cwd_buf copy. argc<2
  // resets to "/" (no $HOME support, same default the retired code used).
  // Relative paths and paths of any length up to sys_chdir's own
  // PATH_MAX-1=255 cap are now accepted -- the kernel resolves them
  // against the CURRENT cwd, and rejects a nonexistent or non-directory
  // target itself (-ENOENT/-ENOTDIR), so this builtin no longer needs its
  // own leading-'/' refusal or length gate.
  pub let cd_builtin : () -> u64 !{mem, sysreg} @{fs} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {fs},
      justification: "R86.M1-006 (#1959): cd_builtin calls sys_chdir(argv[1], strlen(argv[1])) when argc>=2, or sys_chdir(\"/\", 1) when argc<2 (no-arg default, matching the retired code's own reset-to-root convention). On success (rax>=0, signed test per the tree's own cp.pdx/dmesg.pdx/cat.pdx negative-errno idiom), emits 'shell cd ok -- path=<X>' via sys_debug_puts(cd_ok_prefix) + sys_getcwd(&_cd_path_scratch, 256) + sys_write(1, ...) + a trailing newline, then returns 0. On failure, emits 'SHELL CD FAIL\\n' via sys_write(2, cd_fail_msg, 14) and returns 1. If sys_getcwd itself fails after a successful chdir (not reachable in practice -- a task's cwd is always a valid vnode once chdir has just set it -- but checked defensively since sys_getcwd's own contract allows -ERANGE/-EFAULT/-ENOENT), the path echo is skipped and only the trailing newline is emitted; the builtin still returns 0 (the chdir itself succeeded).",
      block: {
        lea rax, [rip + argc];
        mov rax, [rax];
        cmp rax, 2;
        jl cd_no_arg;

        // argv[1] pointer -- walker cap 255, not strlen (walker's cap
        // includes room for the NUL; passing raw strlen exhausts the
        // walker before it sees NUL and returns -EFAULT). Matches the
        // rm.pdx/mv.pdx/rootfs_seed.pdx convention documented in
        // src/user/rm.pdx's header ("path_len is a walker CAP, not an
        // exact strlen -- mirrors rootfs_seed.pdx's `mov rsi, 255`
        // usage ahead of sys_mkdir").
        lea rax, [rip + argv_buf];
        mov rdi, [rax + 8];              // path_va = argv[1]
        mov rsi, 255;                    // walker cap
        call sys_chdir;
        jmp cd_check;

      cd_no_arg:
        lea rdi, [rip + cd_root_path];
        mov rsi, 255;                    // walker cap (see comment above)
        call sys_chdir;

      cd_check:
        cmp rax, 0;
        jl cd_fail;

        // Success: "shell cd ok -- path=<X>\n"
        mov rdi, 1;
        lea rsi, [rip + cd_ok_prefix];
        mov rdx, 20;
        call sys_write;

        lea rdi, [rip + _cd_path_scratch];
        mov rsi, 256;
        call sys_getcwd;                 // rax = bytes (incl NUL) or -errno
        cmp rax, 0;
        jl cd_ok_nl;                     // getcwd failed -- skip path echo

        mov r10, rax;
        sub r10, 1;                      // r10 = strlen (excludes NUL)
        mov rdi, 1;
        lea rsi, [rip + _cd_path_scratch];
        mov rdx, r10;
        call sys_write;

      cd_ok_nl:
        mov rdi, 1;
        lea rsi, [rip + nl_char];
        mov rdx, 1;
        call sys_write;

        xor rax, rax;
        ret;

      cd_fail:
        mov rdi, 2;
        lea rsi, [rip + cd_fail_msg];
        mov rdx, 14;
        call sys_write;
        mov rax, 1;
        ret
      }
    } @no_frame

  // clear_builtin() -> u64
  // Emits the ANSI clear-screen + cursor-home escape sequence
  // "\x1b[2J\x1b[H" (7 bytes on the wire) via sys_write(1, ...). Returns 0.
  pub let clear_builtin : () -> u64 !{mem, sysreg} @{fs} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {fs},
      justification: "clear builtin: emits ANSI clear-screen + cursor-home escape sequence (\\x1b[2J\\x1b[H, 7 bytes) via sys_write(1, clear_seq, 7). Mirrors env_builtin's shape. Returns 0.",
      block: {
        mov rdi, 1;
        lea rsi, [rip + clear_seq];
        mov rdx, 7;
        call sys_write;
        xor rax, rax;
        ret
      }
    }

  // rp_build_candidate(prefix_ptr: u64, prefix_len: u64) -> u64
  // R57.M4-005 (#1801): builds "<prefix><argv[0]-name>\0" into the
  // resolved_path .bss slot and returns its address. Parameterized
  // sibling of the original hardcoded-/bin/-prefix build code (same
  // memcpy+strlen shape, same r8-reload discipline), so resolve_path's
  // PATH-prefix loop can reuse one code path for every candidate instead
  // of duplicating the memcpy pair per prefix.
  pub let rp_build_candidate : (u64, u64) -> u64 !{mem} @{} =
    fn (prefix_ptr: u64) (prefix_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R57.M4-005 (#1801): rp_build_candidate(prefix_ptr, prefix_len) copies prefix_ptr[0..prefix_len) then argv_buf[0]'s NUL-terminated name into resolved_path, returning &resolved_path. r10 holds prefix_len across the first memcpy call (memcpy clobbers rax/rcx/rdi/rsi/r8, but not r9/r10) so the second copy's destination offset (resolved_path + prefix_len) can be computed via register-register `add rdi, r10` -- no `add reg, [mem]` per this file's encoder-conservatism discipline. Mirrors the WAVE-9 (#1012) r8-reload fix in the original resolve_prepend code: memcpy's `mov r8, rdi` (dst-save for return) clobbers r8, so argv_buf[0]'s pointer is reloaded into r8 fresh before each use; strlen is relied upon to preserve r8 (per its string.pdx impl, which only touches rax/rcx/rdi) so a single reload before `call strlen` suffices to carry the pointer through both the length computation and the subsequent memcpy's src argument.",
      block: {
        // rdi = prefix_ptr, rsi = prefix_len (SysV arg registers, per the
        // curried fn signature above -- same binding memcpy/strlen use).
        mov r10, rsi;                    // r10 = prefix_len (survives the memcpy call below)
        mov r9, rdi;                     // r9 = prefix_ptr

        lea rdi, [rip + resolved_path];  // dst = &resolved_path
        mov rsi, r9;                     // src = prefix_ptr
        mov rdx, r10;                    // n = prefix_len
        call memcpy;

        // memcpy clobbers r8 (its impl does `mov r8, rdi` to save dst for
        // return, per the WAVE-9 (#1012) fix this mirrors). Reload argv[0]
        // pointer fresh before using r8 again.
        lea rax, [rip + argv_buf];
        mov r8, [rax];
        mov rdi, r8;
        call strlen;                     // rax = strlen(argv[0]); strlen preserves r8
        add rax, 1;                      // include NUL terminator
        mov rdx, rax;                    // n = namelen + 1
        lea rdi, [rip + resolved_path];
        add rdi, r10;                    // dst = resolved_path + prefix_len (register-only add)
        mov rsi, r8;                     // src = argv[0] ptr (preserved by strlen)
        call memcpy;

        lea rax, [rip + resolved_path];
        ret
      }
    } @no_frame

  // resolve_path() -> u64
  // R57.M4-005 (#1801): PATH-prefix walk for argv[0] without a '/'.
  //
  // Design:
  //   - If argv[0] contains '/': legacy as-is behavior (return argv[0]
  //     unchanged), but still emit the "shell exec ok" fingerprint
  //     (resolved == argv[0] name) so downstream shell smokes observe
  //     that resolve_path executed on this path too.
  //   - Otherwise walk a hardcoded PATH prefix list ["/bin/", "/usr/bin/"]
  //     (mirrors init's PATH=/bin:/usr/bin per the issue). For each
  //     prefix: build "<prefix><argv[0]>\0" into the resolved_path .bss
  //     slot via rp_build_candidate, then probe it with sys_stat (SC+ ID
  //     77, rdi=path, rsi=255, rdx=&_resolved_stat_scratch). rax == 0 ->
  //     hit: emit the fingerprint and return &resolved_path. rax != 0 ->
  //     miss: try the next prefix.
  //   - If every prefix misses, fall through to the legacy /bin/-prepend
  //     behavior (rebuild resolved_path with bin_prefix, no fingerprint)
  //     so execve still runs and fails with the same ENOENT-style
  //     failure mode as before #1801 -- no regression on a genuinely
  //     missing binary.
  //
  //   Deferred: env-passed PATH. init.pdx is NOT touched by this issue --
  //   sys_execve_shim does not populate envp at M0 (see ls.pdx L7-11's
  //   header note re sys_execve_shim.pdx §Non-Scope), so there is no
  //   envp for init to seed a PATH variable into. The two-prefix list
  //   here is hardcoded and stays that way until execve gains envp
  //   support.
  //
  // Uses memcpy and strlen from string.pdx for copying and length
  // computation, and inline `mov rax, 77/12; syscall` for sys_stat /
  // sys_debug_puts (mirrors rootfs_seed.pdx's inline-syscall shape).
  pub let resolve_path : () -> u64 !{mem, sysreg} @{fs} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {fs},
      justification: "R57.M4-005 (#1801): resolve_path now walks a hardcoded two-entry PATH prefix list (\"/bin/\", \"/usr/bin/\") when argv[0] has no '/', probing each candidate with sys_stat (SC+ ID 77) via rp_build_candidate before committing to it, and falls through to the legacy /bin/-prepend behavior only if both miss (no regression: execve still fails ENOENT-style on a genuinely missing binary). On a hit (or on the as-is '/'-containing path) it emits a 'shell exec ok -- argv[0]=<name> resolved=<path> [legacy: SHELL EXEC OK]' fingerprint via 5 sys_debug_puts calls (SC+ ID 12) so downstream shell smokes can observe resolve_path's decision; the fall-through-to-/bin/ miss path does NOT emit it. Capabilities widen from {} to {fs} (sys_stat is fs-gated, same as sys_open/sys_getdents in ls.pdx) and effects widen from {mem} to {mem, sysreg} (every SYSCALL clobbers rcx/r11 and the debug_puts/stat calls are real SYSCALLs, not just callee calls). envp-based PATH is explicitly deferred -- see the design comment above -- because sys_execve_shim does not pass envp to the child at M0, so init.pdx has nothing to seed. Reserved-label discipline: all internal labels are rp_-prefixed (resolve_scan/resolve_prepend/resolve_asis's bare-word-adjacent names predate this fix; rp_scan/rp_asis/rp_walk_path/rp_hit replace them here) since bare `walk`/`loop`/etc. are paideia-as keywords.",
      block: {
        lea rax, [rip + argv_buf];
        mov r8, [rax];
        mov r9, r8;
rp_scan:
        xor rax, rax;
        mov al, [r9];
        and rax, 0xff;
        cmp rax, 0;
        je rp_walk_path;
        cmp rax, 0x2F;
        je rp_asis;
        add r9, 1;
        jmp rp_scan;

rp_asis:
        // argv[0] already contains '/': legacy as-is behavior, plus the
        // hit fingerprint (resolved == argv[0] name) so this path is
        // also observable downstream.
        lea rdi, [rip + sh_exec_ok_prefix];
        mov rsi, 25;
        mov rax, 12;
        syscall;

        lea rax, [rip + argv_buf];
        mov r8, [rax];
        mov rdi, r8;
        call strlen;
        mov rsi, rax;
        lea rax, [rip + argv_buf];
        mov r8, [rax];
        mov rdi, r8;
        mov rax, 12;
        syscall;

        lea rdi, [rip + sh_exec_ok_mid];
        mov rsi, 10;
        mov rax, 12;
        syscall;

        lea rax, [rip + argv_buf];
        mov r8, [rax];
        mov rdi, r8;
        call strlen;
        mov rsi, rax;
        lea rax, [rip + argv_buf];
        mov r8, [rax];
        mov rdi, r8;
        mov rax, 12;
        syscall;

        lea rdi, [rip + sh_exec_ok_tail];
        mov rsi, 25;
        mov rax, 12;
        syscall;

        lea rax, [rip + argv_buf];
        mov rax, [rax];
        ret;

rp_walk_path:
        // No '/' in argv[0]: walk the hardcoded PATH prefix list.
        lea rdi, [rip + bin_prefix];
        mov rsi, 5;
        call rp_build_candidate;

        lea rdi, [rip + resolved_path];
        mov rsi, 255;
        lea rdx, [rip + _resolved_stat_scratch];
        mov rax, 77;
        syscall;
        cmp rax, 0;
        je rp_hit;

        lea rdi, [rip + usr_bin_prefix];
        mov rsi, 9;
        call rp_build_candidate;

        lea rdi, [rip + resolved_path];
        mov rsi, 255;
        lea rdx, [rip + _resolved_stat_scratch];
        mov rax, 77;
        syscall;
        cmp rax, 0;
        je rp_hit;

        // Both candidates missed: fall through to the legacy
        // /bin/-prepend behavior. Do NOT emit the fingerprint here --
        // only a genuine hit emits it.
        lea rdi, [rip + bin_prefix];
        mov rsi, 5;
        call rp_build_candidate;
        ret;

rp_hit:
        // sys_stat succeeded on resolved_path (rax == 0): emit the
        // fingerprint, then return &resolved_path.
        lea rdi, [rip + sh_exec_ok_prefix];
        mov rsi, 25;
        mov rax, 12;
        syscall;

        lea rax, [rip + argv_buf];
        mov r8, [rax];
        mov rdi, r8;
        call strlen;
        mov rsi, rax;
        lea rax, [rip + argv_buf];
        mov r8, [rax];
        mov rdi, r8;
        mov rax, 12;
        syscall;

        lea rdi, [rip + sh_exec_ok_mid];
        mov rsi, 10;
        mov rax, 12;
        syscall;

        lea rdi, [rip + resolved_path];
        mov r8, rdi;
        call strlen;
        mov rsi, rax;
        mov rdi, r8;
        mov rax, 12;
        syscall;

        lea rdi, [rip + sh_exec_ok_tail];
        mov rsi, 25;
        mov rax, 12;
        syscall;

        lea rax, [rip + resolved_path];
        ret
      }
    } @no_frame

  // exec_child() -> u64 !{mem, sysreg, sysprivcap} @{fs, sched, cap}
  // Fork and execve argv[0] with NULL-terminated argv_buf. Parent waits via sys_wait4.
  // Returns 0 on child spawned, 1 on error (argc==0 or fork failed).
  //
  // R58.M5-001 (#1805): before resolve_path/execve, the child branch scans
  // argv_buf for the tokenizer's redirect tokens (which point at
  // Tokenizer::redirect_gt / redirect_gtgt / redirect_lt rodata — see
  // tokenizer.pdx header note) and, for each one found: opens the
  // following token (the target filename) with the matching flags,
  // sys_dup2's the new fd onto the target fd (1 for '>'/'>>', 0 for '<'),
  // closes the new fd, and removes both the operator and filename tokens
  // from argv_buf (left-compact) so execve never sees them. This scan is
  // child-only (post-fork, separate address space via COW) — the parent's
  // argv_buf is untouched.
  pub let exec_child : () -> u64 !{mem, sysreg, sysprivcap} @{fs, sched, cap} =
    fn () -> unsafe {
      effects: {mem, sysreg, sysprivcap}, capabilities: {fs, sched, cap},
      justification: "R17-m3-005 (#625) + R17-m3-006 (#626) + R58.M5-001 (#1805): exec_child forks + execves argv[0] with NULL-terminated argv_buf, envp=NULL; parent waits via sys_wait4 into child_wait_status. On fork error or argc==0 returns 1; on execve failure child calls sys_exit(127). Reads argc/argv_buf from Tokenizer .bss (linked symbols). Callees are syscall shims (no SysV pad needed). R17-m3-006 (#626): child branch calls resolve_path to prepend /bin/ when argv[0] has no slash. R58.M5-001 (#1805): child branch additionally runs an rd_-prefixed redirect scan (see block below) between the fork and resolve_path/execve. Register plan for the scan: r12=argc (loaded once), r13=read_idx, r14=write_idx, r15=current token ptr / target_fd carrier, rbx=fd returned by sys_open (needed across the sys_dup2 call so sys_close can close the ORIGINAL fd, not dup2's return value) -- all six are callee-saved and untouched by strlen/memcmp (touch only rax/rcx/rdx/rdi/rsi/r8) and by the sys_open/sys_dup2/sys_close/sys_debug_puts stubs (each is `mov rax,N; syscall; ret`, touching only rax plus whatever the SYSCALL instruction itself clobbers -- rcx/r11 -- never r12-r15/rbx). rax/rcx/rdx/rdi/rsi/r8/r9/r10/r11 are NOT trusted to survive any call or inline `syscall` in this scan, per dispatch.pdx's own documented r9/r10 syscall-shuffle risk (see echo_builtin's justification above) -- every use of argv_buf[i] is reloaded fresh via `lea rax,[rip+argv_buf]; mov r_, [rax+idx*8]` immediately before each use rather than cached across a call, mirroring resolve_path's rp_hit reload discipline. Detection is strlen+memcmp against Tokenizer's redirect_gt/redirect_gtgt/redirect_lt rodata (not a raw byte compare), per the issue's explicit instruction, so the check stays coupled to the same constants the tokenizer used to build the token rather than to an assumed byte value. Reserved-label discipline: every new label is rd_-prefixed.",
      block: {
        // Guard: argc == 0 → error
        lea rax, [rip + argc];
        mov rax, [rax];
        cmp rax, 0;
        je exec_child_err;

        // NULL-terminate argv_buf[argc] = 0
        xor rcx, rcx;
        lea r11, [rip + argv_buf];
        mov [r11 + rax*8], rcx;

        // fork
        call sys_fork;
        cmp rax, 0;
        jl exec_child_err;
        je exec_child_do_execve;

        // parent: wait4(pid, &child_wait_status, 0, NULL). rax has pid.
        mov rdi, rax;
        lea rsi, [rip + child_wait_status];
        xor rdx, rdx;
        xor rcx, rcx;
        call sys_wait4;
        ret;

exec_child_do_execve:
        // R58.M5-001 (#1805): redirect scan + left-compact, child-only.
        push r12;
        push r13;
        push r14;
        push r15;
        push rbx;

        lea rax, [rip + argc];
        mov r12, [rax];         // r12 = argc
        xor r13, r13;           // r13 = read_idx = 0
        xor r14, r14;           // r14 = write_idx = 0

rd_loop:
        cmp r13, r12;
        jge rd_compact_done;

        lea rax, [rip + argv_buf];
        mov r15, [rax + r13*8]; // r15 = argv_buf[read_idx] (survives strlen/memcmp — neither touches r15)
        mov rdi, r15;
        call strlen;            // rax = strlen(token)
        cmp rax, 2;
        je rd_try_gtgt;
        cmp rax, 1;
        jne rd_keep_token;

        // len == 1: could be '>' or '<'
        mov rdi, r15;
        lea rsi, [rip + redirect_gt];
        mov rdx, 1;
        call memcmp;
        cmp rax, 0;
        je rd_try_gt_single;

        mov rdi, r15;
        lea rsi, [rip + redirect_lt];
        mov rdx, 1;
        call memcmp;
        cmp rax, 0;
        je rd_try_lt;

        jmp rd_keep_token;

rd_try_gtgt:
        mov rdi, r15;
        lea rsi, [rip + redirect_gtgt];
        mov rdx, 2;
        call memcmp;
        cmp rax, 0;
        jne rd_keep_token;
        // matched ">>": append to stdout
        mov r15, 1;                     // r15 = target_fd (stdout)
        mov rsi, 0x241;                 // O_WRONLY|O_CREAT|O_APPEND (vfs_open.pdx: 0x01|0x40|0x200)
        jmp rd_open_common;

rd_try_gt_single:
        mov r15, 1;                     // r15 = target_fd (stdout)
        mov rsi, 0xC1;                  // O_WRONLY|O_CREAT|O_TRUNC (vfs_open.pdx: 0x01|0x40|0x80)
        jmp rd_open_common;

rd_try_lt:
        mov r15, 0;                     // r15 = target_fd (stdin)
        mov rsi, 0;                     // O_RDONLY
        jmp rd_open_common;

rd_open_common:
        // rsi already holds open() flags (set by the caller above). Need
        // a filename token following the operator: argv_buf[read_idx+1].
        mov rax, r13;
        add rax, 1;
        cmp rax, r12;
        jge rd_apply_no_target;         // operator with nothing after it: drop it alone

        lea rcx, [rip + argv_buf];
        mov rdi, [rcx + rax*8];         // rdi = filename ptr (sys_open arg1)
        mov rdx, 0x1A4;                 // mode 0644 (only meaningful with O_CREAT)
        call sys_open;                  // rax = new fd, or negative errno
        cmp rax, 0;
        jl rd_apply_open_err;
        mov rbx, rax;                   // rbx = new fd (survives sys_dup2/sys_close: neither touches rbx)

        mov rdi, rbx;
        mov rsi, r15;                   // newfd = target_fd
        call sys_dup2;
        mov rdi, rbx;                   // close the ORIGINAL new fd, not sys_dup2's return value
        call sys_close;

        // Fingerprint: "shell redirect ok -- argv[0]=<name> op=<op> file=<path> [legacy: SHELL REDIRECT OK]\n"
        lea rdi, [rip + sh_redirect_ok_prefix];
        mov rsi, 29;
        mov rax, 12;
        syscall;

        lea rax, [rip + argv_buf];
        mov r8, [rax];                  // argv[0] ptr (index 0 is stable across compaction — see justification)
        mov rdi, r8;
        call strlen;
        mov rsi, rax;
        lea rax, [rip + argv_buf];
        mov r8, [rax];
        mov rdi, r8;
        mov rax, 12;
        syscall;

        lea rdi, [rip + sh_redirect_ok_mid_op];
        mov rsi, 4;
        mov rax, 12;
        syscall;

        lea rax, [rip + argv_buf];
        mov r8, [rax + r13*8];          // op token ptr (still the operator: read_idx untouched so far)
        mov rdi, r8;
        call strlen;
        mov rsi, rax;
        lea rax, [rip + argv_buf];
        mov r8, [rax + r13*8];
        mov rdi, r8;
        mov rax, 12;
        syscall;

        lea rdi, [rip + sh_redirect_ok_mid_file];
        mov rsi, 6;
        mov rax, 12;
        syscall;

        mov rcx, r13;
        add rcx, 1;
        lea rax, [rip + argv_buf];
        mov r8, [rax + rcx*8];          // filename token ptr
        mov rdi, r8;
        call strlen;
        mov rsi, rax;
        mov rcx, r13;
        add rcx, 1;
        lea rax, [rip + argv_buf];
        mov r8, [rax + rcx*8];
        mov rdi, r8;
        mov rax, 12;
        syscall;

        lea rdi, [rip + sh_redirect_ok_tail];
        mov rsi, 29;
        mov rax, 12;
        syscall;

        add r13, 2;                     // consumed operator + filename; neither copied forward
        jmp rd_loop;

rd_apply_open_err:
        // sys_open failed: drop the malformed redirect silently (M0
        // best-effort), no fingerprint.
        add r13, 2;
        jmp rd_loop;

rd_apply_no_target:
        // operator with no following token: drop just the operator.
        add r13, 1;
        jmp rd_loop;

rd_keep_token:
        // not a redirect: left-compact copy argv_buf[read_idx] -> argv_buf[write_idx].
        lea rax, [rip + argv_buf];
        mov [rax + r14*8], r15;
        add r13, 1;
        add r14, 1;
        jmp rd_loop;

rd_compact_done:
        // NUL-pointer-terminate the compacted argv at write_idx, and keep
        // argc consistent with the new (child-local) count.
        lea rax, [rip + argv_buf];
        xor rcx, rcx;
        mov [rax + r14*8], rcx;
        lea rax, [rip + argc];
        mov [rax], r14;

        // #1805 debugger finding: if EVERY token was consumed by the
        // redirect scan (e.g. line was `> /tmp/x` with no command), the
        // post-compaction argc is 0 and resolve_path would deref
        // argv_buf[0]==NULL. Exit the child cleanly with 127 instead.
        cmp r14, 0;
        je rd_apply_empty_argv;

        pop rbx;
        pop r15;
        pop r14;
        pop r13;
        pop r12;

        // child: execve(resolve_path(), &argv_buf[0], NULL)
        call resolve_path;
        mov rdi, rax;
        lea rsi, [rip + argv_buf];
        xor rdx, rdx;
        call sys_execve;
        // execve returned → failed. Exit 127.
        mov rdi, 127;
        call sys_exit;
        hlt;

rd_apply_empty_argv:
        // Post-compaction argc == 0 — no command left to exec. Restore
        // callee-save regs, then sys_exit(127) in the child (mirrors the
        // "execve returned -> failed" exit code above).
        pop rbx;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        mov rdi, 127;
        call sys_exit;
        hlt;

exec_child_err:
        mov rax, 1;
        ret
      }
    } @no_frame

  // ==========================================================================
  // R106.M4-KERNEL (paideia-os #2231) -- fixed-shape token-record dispatch
  // surface.
  //
  // This is the KERNEL-facing integration point that the novel-shape
  // tokenizer landing in paideia-os #2342 (src/user/tokenizer.pdx -- NOT
  // touched by this change) will eventually hand its parsed command to,
  // REPLACING the string-based dispatch_line path for that caller. Until
  // #2342 lands, nothing calls dispatch_from_tokenizer_stream yet -- it
  // ships now as a self-contained, independently correct entry point so
  // the tokenizer work has a stable contract to target. dispatch_line and
  // every builtin above are UNCHANGED and remain shell.pdx's only call
  // path today.
  //
  // Record layout (DFT_REC_SIZE=80 bytes total), pointer passed in rdi:
  //   +0  u64 opcode        one of DFT_OP_* below
  //   +8  u64 arg_count     0..DFT_REC_ARGV_MAX(8) inclusive
  //   +16 u64 arg_ptrs[8]   NUL-terminated cstr pointers; every slot in
  //                         [0, arg_count) MUST be non-NULL (dense-packing
  //                         invariant -- see DFT_REFUSED_DENSE)
  // ==========================================================================
  pub let DFT_REC_ARGV_MAX : u64 = 8
  pub let DFT_REC_SIZE     : u64 = 80

  // Opcode enum. 0..6 mirror dispatch_init's builtin_names/_handlers/_descs
  // fill order one-for-one (echo, exit, pwd, help, env, cd, clear -- see
  // dispatch_init's own header comment above). Opcode 7 is new: "run this
  // as an external command", bridging into the SAME fork+execve+redirect
  // machinery exec_child already owns rather than duplicating it. Anything
  // past DFT_OP_MAX is DFT_OPCODE_INVALID.
  pub let DFT_OP_ECHO  : u64 = 0
  pub let DFT_OP_EXIT  : u64 = 1
  pub let DFT_OP_PWD   : u64 = 2
  pub let DFT_OP_HELP  : u64 = 3
  pub let DFT_OP_ENV   : u64 = 4
  pub let DFT_OP_CD    : u64 = 5
  pub let DFT_OP_CLEAR : u64 = 6
  pub let DFT_OP_EXEC  : u64 = 7
  pub let DFT_OP_MAX   : u64 = 7

  // Failure band 0xFFFFE920..0xFFFFE92F (pre-assigned; repo-wide grep at
  // landing time confirms unclaimed -- adjacent sibling 0xFFFFE9xx bands
  // are recovery_plane_takeover.pdx's 0xFFFFE9D0..DF, provider_kind.pdx's
  // 0xFFFFE9A0..AF, display.pdx's 0xFFFFE900..0F). 8 of 16 slots used;
  // 0xFFFFE928..92F reserved for future DFT_ growth. These are RETURN
  // VALUES of dispatch_from_tokenizer_stream, distinct from dispatch_line's
  // plain 0/1 convention -- the string path is untouched by this band.
  pub let DFT_NULL                   : u64 = 0xFFFFE920  // record ptr == 0
  pub let DFT_OPCODE_INVALID         : u64 = 0xFFFFE921  // opcode > DFT_OP_MAX
  pub let DFT_ARG_COUNT_OUT_OF_RANGE : u64 = 0xFFFFE922  // arg_count > DFT_REC_ARGV_MAX
  pub let E_CD_NO_ARG                : u64 = 0xFFFFE923  // bare `cd` (arg_count==0) via the tokenized path
  pub let DFT_CD_NO_ARG              : u64 = 0xFFFFE923  // == E_CD_NO_ARG (two names, one code -- issue #2231 scope item 4)
  pub let DFT_CD_NOT_A_DIR           : u64 = 0xFFFFE924  // sys_chdir -ENOTDIR (0xFFFFFFFFFFFFFFEC, sys_chdir.pdx)
  pub let DFT_CD_NOT_FOUND           : u64 = 0xFFFFE925  // sys_chdir -ENOENT/-EFAULT (any other negative rax)
  pub let DFT_REFUSED_DENSE          : u64 = 0xFFFFE926  // arg_ptrs has a NULL hole inside [0, arg_count)
  pub let DFT_NOT_INIT               : u64 = 0xFFFFE927  // dispatch_init has not run yet (builtin_count==0)

  pub let dispatch_from_tokenizer_meta : [u8; 64] = "dispatch from tokenizer ok [legacy: DISPATCH FROM TOKENIZER OK]\0"

  // _dft_rec_ptr: single-flow scratch holding the caller's record pointer
  // across calls (sys_chdir/sys_getcwd/sys_write/echo_builtin/etc. all
  // clobber rdi/rax and are not trusted to preserve any caller-save
  // register -- same discipline resolve_path's rp_hit and exec_child's rd_
  // scan already document in this file). No concurrent callers at R106.M4
  // (single-threaded shell), matching _cd_path_scratch/_pwd_buf's own
  // single-flow posture above.
  pub let mut _dft_rec_ptr : u64 = uninit @align(8)

  // dispatch_from_tokenizer_stream(rec_ptr: u64) -> u64
  //
  // Consumes ONE fixed-shape token record (see layout above) and executes
  // it, in place of dispatch_line's argc/argv_buf-from-Tokenizer-.bss +
  // strcmp walk. Guard order (each failure returns immediately, no partial
  // side effects before the guard that rejects it):
  //   1. rec_ptr == 0                          -> DFT_NULL
  //   2. builtin_count == 0 (dispatch_init      -> DFT_NOT_INIT
  //      never ran)
  //   3. arg_count > DFT_REC_ARGV_MAX(8)        -> DFT_ARG_COUNT_OUT_OF_RANGE
  //   4. opcode > DFT_OP_MAX(7)                 -> DFT_OPCODE_INVALID
  //   5. any arg_ptrs[i] for i in               -> DFT_REFUSED_DENSE
  //      [0, arg_count) is NULL
  // Once all five guards clear, the dispatch_from_tokenizer_meta
  // fingerprint fires -- it witnesses "a well-formed record reached and
  // was accepted by this entry point", independent of whether the
  // specific opcode's OWN execution then succeeds (a validly-dispatched
  // `cd /nonexistent` still emits it; only a malformed record suppresses
  // it).
  //
  // Opcode 5 (cd) gets its own granular-error path per issue #2231 scope
  // item 2, BEFORE the generic argc/argv_buf bridge below ever runs:
  //   arg_count == 0                              -> E_CD_NO_ARG (bare `cd`)
  //   sys_chdir returns -ENOTDIR (0x...FFEC)      -> DFT_CD_NOT_A_DIR
  //   sys_chdir returns anything else negative    -> DFT_CD_NOT_FOUND
  //   sys_chdir returns 0                         -> same "shell cd ok --
  //                                                   path=<X>" echo
  //                                                   cd_builtin's string
  //                                                   path emits (reuses
  //                                                   cd_ok_prefix /
  //                                                   _cd_path_scratch /
  //                                                   nl_char verbatim);
  //                                                   returns 0
  //
  // Every OTHER opcode (0-4, 6: echo/exit/pwd/help/env/clear, plus 7's
  // external-exec) is handled by a generic bridge: arg_ptrs[0..arg_count)
  // is copied into the Tokenizer .bss argv_buf (shared with dispatch_line
  // -- see tokenizer.pdx), arg_count into argc, and argv_buf[arg_count] is
  // NUL-pointer-terminated (exec_child's own NULL-terminate step is
  // therefore redundant but harmless for opcode 7 -- it re-terminates at
  // the same index). The matching builtin is then CALLED UNCHANGED --
  // echo_builtin/exit_builtin/pwd_builtin/help_builtin/env_builtin/
  // clear_builtin/exec_child are not modified by this issue and keep
  // reading argc/argv_buf exactly as dispatch_line's callers always have.
  //
  // Register plan: r9 = scan/copy index, r10 = arg_count, r11 = opcode.
  // r10/r11 survive the dense-packing scan and the argc-store/NUL-
  // terminate sequence (pure mov/lea/add/jmp, no CALL or SYSCALL in
  // between). The fingerprint's inline `syscall` (SC+ ID 12) DOES clobber
  // rcx/r11 per this file's own documented syscall-clobber convention (see
  // resolve_path's justification) -- opcode is therefore reloaded fresh
  // from _dft_rec_ptr immediately after that syscall, before the opcode
  // cascade runs, on the generic-bridge path. The cd path never needs that
  // reload: its own fingerprint emission happens before r10 (arg_count) is
  // next read, and r10 is untouched by `syscall`.
  //
  // Effects/capabilities are exec_child's own row, `!{mem, sysreg,
  // sysprivcap} @{fs, sched, cap}` -- this function can reach exec_child
  // (opcode 7) and therefore must not declare less than what that call
  // needs; every other opcode this function reaches needs only the
  // {mem,sysreg}@{fs} subset the other builtins already declare, so the
  // exec_child row is a safe superset covering all eight opcodes.
  //
  // Reserved-label discipline: every new label is dft_-prefixed.
  pub let dispatch_from_tokenizer_stream : (u64) -> u64 !{mem, sysreg, sysprivcap} @{fs, sched, cap} =
    fn (rec_ptr: u64) -> unsafe {
      effects: {mem, sysreg, sysprivcap}, capabilities: {fs, sched, cap},
      justification: "R106.M4-KERNEL (paideia-os #2231): dispatch_from_tokenizer_stream consumes a fixed-shape token record (opcode u64 @+0, arg_count u64 @+8, arg_ptrs[8] u64 @+16 -- DFT_REC_SIZE=80) and executes it, as the kernel-facing integration surface the #2342 tokenizer will target instead of dispatch_line's argc/argv_buf-from-Tokenizer-.bss + strcmp walk. dispatch_line and every builtin remain unmodified; this is purely additive. Guard cascade (rec_ptr==0 -> DFT_NULL; builtin_count==0 -> DFT_NOT_INIT; arg_count>8 -> DFT_ARG_COUNT_OUT_OF_RANGE; opcode>7 -> DFT_OPCODE_INVALID; any arg_ptrs[i] in [0,arg_count) NULL -> DFT_REFUSED_DENSE) runs before the record pointer is stashed into _dft_rec_ptr is even trusted for a second read -- each guard reads directly off rdi/rec_ptr so no scratch write happens before the record is known well-formed enough to act on. Opcode 5 (cd) branches BEFORE the generic bridge into its own granular-error path (issue #2231 scope item 2): arg_count==0 -> E_CD_NO_ARG (==DFT_CD_NO_ARG); else sys_chdir(arg_ptrs[0], 255) is called directly, and its return is examined -- 0xFFFFFFFFFFFFFFEC (-ENOTDIR) -> DFT_CD_NOT_A_DIR, any other negative -> DFT_CD_NOT_FOUND, 0 -> the same 'shell cd ok -- path=<X>' echo cd_builtin's string path emits (cd_ok_prefix + sys_getcwd(&_cd_path_scratch,256) + sys_write, mirrored verbatim) then return 0. Every other opcode (0-4,6-7) is handled by a shared bridge: arg_ptrs[0..arg_count) copied into the Tokenizer argv_buf, arg_count into argc, argv_buf[arg_count] NUL-pointer-terminated, then the matching UNCHANGED builtin (echo_builtin/exit_builtin/pwd_builtin/help_builtin/env_builtin/clear_builtin/exec_child for opcode 7) is called and its return forwarded verbatim. The dispatch_from_tokenizer_meta fingerprint (SC+ ID 12 sys_debug_puts, wire length 63) fires once every guard has cleared -- on the generic-bridge path right after the argc/NUL-terminate step, on the cd path right after the arg_count==0 check point -- witnessing acceptance of a well-formed record independent of the selected opcode's own later success/failure. Register plan: r9=scan/copy index, r10=arg_count, r11=opcode, both loaded once from rec_ptr and surviving the dense-packing scan plus the argc-store/NUL-terminate sequence unclobbered (no CALL/SYSCALL runs inside either loop); the fingerprint's inline `syscall` clobbers rcx/r11 per this file's documented syscall-clobber convention (resolve_path's own justification), so the generic-bridge path reloads opcode fresh from _dft_rec_ptr immediately after that syscall before the opcode cascade reads r11 again -- the cd path needs no such reload since its own next read is r10 (arg_count), untouched by `syscall`. _dft_rec_ptr (single-flow .bss scratch, no concurrent callers at R106.M4) is reloaded fresh before every dereference rather than trusted in a register across any CALL, mirroring resolve_path's rp_hit / rp_build_candidate reload discipline already established in this file. Effects/capabilities `!{mem, sysreg, sysprivcap} @{fs, sched, cap}` are exec_child's own row verbatim -- the superset needed because opcode 7 reaches exec_child, and a safe over-declaration for the other seven opcodes which need only {mem,sysreg}@{fs}. Encoder-gap discipline: no `test rN,rN` (uses `cmp rN,0`), no `add reg,[mem]` (SIB+disp addressing `[base+index*8+disp]` used throughout instead, matching fd_table.pdx's `mov rax,[rdi+rsi*8+168]` precedent), no `and r11,imm64`. Reserved-label discipline: every new label is dft_-prefixed.",
      block: {
        cmp rdi, 0;
        je dft_null;

        lea rax, [rip + builtin_count];
        mov rax, [rax];
        cmp rax, 0;
        je dft_not_init;

        lea rax, [rip + _dft_rec_ptr];
        mov [rax], rdi;

        mov r10, [rdi + 8];              // r10 = arg_count
        cmp r10, 8;
        ja dft_argc_bad;

        mov r11, [rdi + 0];              // r11 = opcode
        cmp r11, 7;
        ja dft_opcode_bad;

        // Dense-packing scan over arg_ptrs[0..arg_count).
        xor r9, r9;
dft_dense_top:
        cmp r9, r10;
        jge dft_dense_done;
        lea rax, [rip + _dft_rec_ptr];
        mov rax, [rax];
        mov rax, [rax + r9*8 + 16];      // arg_ptrs[r9]
        cmp rax, 0;
        je dft_refused_dense;
        add r9, 1;
        jmp dft_dense_top;
dft_dense_done:

        cmp r11, 5;
        je dft_do_cd;

        // ---- Generic bridge (opcodes 0-4, 6, 7): copy arg_ptrs into
        // argv_buf, arg_count into argc, NUL-terminate argv_buf[arg_count].
        xor r9, r9;
dft_copy_top:
        cmp r9, r10;
        jge dft_copy_done;
        lea rax, [rip + _dft_rec_ptr];
        mov rax, [rax];
        mov rax, [rax + r9*8 + 16];      // arg_ptrs[r9]
        lea rdx, [rip + argv_buf];
        mov [rdx + r9*8], rax;
        add r9, 1;
        jmp dft_copy_top;
dft_copy_done:
        lea rax, [rip + argc];
        mov [rax], r10;
        lea rax, [rip + argv_buf];
        xor rcx, rcx;
        mov [rax + r10*8], rcx;          // argv_buf[arg_count] = NULL

        lea rdi, [rip + dispatch_from_tokenizer_meta];
        mov rsi, 63;
        mov rax, 12;
        syscall;

        // Reload opcode -- the syscall above clobbers r11.
        lea rax, [rip + _dft_rec_ptr];
        mov rax, [rax];
        mov r11, [rax + 0];

        cmp r11, 0;
        je dft_call_echo;
        cmp r11, 1;
        je dft_call_exit;
        cmp r11, 2;
        je dft_call_pwd;
        cmp r11, 3;
        je dft_call_help;
        cmp r11, 4;
        je dft_call_env;
        cmp r11, 6;
        je dft_call_clear;
        // Only DFT_OP_EXEC(7) remains after the opcode<=7 gate and the
        // six explicit checks above.
        call exec_child;
        ret;

dft_call_echo:
        call echo_builtin;
        ret;
dft_call_exit:
        call exit_builtin;
        ret;                            // unreachable: exit_builtin calls sys_exit
dft_call_pwd:
        call pwd_builtin;
        ret;
dft_call_help:
        call help_builtin;
        ret;
dft_call_env:
        call env_builtin;
        ret;
dft_call_clear:
        call clear_builtin;
        ret;

dft_do_cd:
        // Fingerprint fires here too -- a bare `cd` (caught just below) is
        // still an ACCEPTED, well-formed dispatch; only the guards above
        // (null/not-init/argc/opcode/density) suppress it.
        lea rdi, [rip + dispatch_from_tokenizer_meta];
        mov rsi, 63;
        mov rax, 12;
        syscall;

        cmp r10, 0;
        je dft_cd_no_arg;

        lea rax, [rip + _dft_rec_ptr];
        mov rax, [rax];
        mov rdi, [rax + 16];             // arg_ptrs[0] (density-checked non-NULL above)
        mov rsi, 255;                    // walker cap, matches cd_builtin's own convention
        call sys_chdir;
        cmp rax, 0;
        je dft_cd_ok;
        cmp rax, 0xFFFFFFFFFFFFFFEC;     // -ENOTDIR (sys_chdir.pdx SYS_CHDIR_ERR_ENOTDIR)
        je dft_cd_notdir;
        jmp dft_cd_notfound;             // -ENOENT / -EFAULT / any other negative rax

dft_cd_ok:
        mov rdi, 1;
        lea rsi, [rip + cd_ok_prefix];
        mov rdx, 20;
        call sys_write;

        lea rdi, [rip + _cd_path_scratch];
        mov rsi, 256;
        call sys_getcwd;
        cmp rax, 0;
        jl dft_cd_ok_nl;

        mov r10, rax;
        sub r10, 1;
        mov rdi, 1;
        lea rsi, [rip + _cd_path_scratch];
        mov rdx, r10;
        call sys_write;

dft_cd_ok_nl:
        mov rdi, 1;
        lea rsi, [rip + nl_char];
        mov rdx, 1;
        call sys_write;
        xor rax, rax;
        ret;

dft_null:
        mov rax, 0xFFFFE920;             // DFT_NULL
        ret;
dft_not_init:
        mov rax, 0xFFFFE927;             // DFT_NOT_INIT
        ret;
dft_argc_bad:
        mov rax, 0xFFFFE922;             // DFT_ARG_COUNT_OUT_OF_RANGE
        ret;
dft_opcode_bad:
        mov rax, 0xFFFFE921;             // DFT_OPCODE_INVALID
        ret;
dft_refused_dense:
        mov rax, 0xFFFFE926;             // DFT_REFUSED_DENSE
        ret;
dft_cd_no_arg:
        mov rax, 0xFFFFE923;             // DFT_CD_NO_ARG == E_CD_NO_ARG
        ret;
dft_cd_notdir:
        mov rax, 0xFFFFE924;             // DFT_CD_NOT_A_DIR
        ret;
dft_cd_notfound:
        mov rax, 0xFFFFE925;             // DFT_CD_NOT_FOUND
        ret
      }
    } @no_frame
}
