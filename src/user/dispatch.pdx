// src/user/dispatch.pdx — R17-M3-004 (#624) + R17-M4 (#629-634)
// Shell builtin dispatch: runtime-loaded table of command names and handlers.
// Accepts argc/argv from Tokenizer .bss, walks builtin table, calls matching handler or returns not-found.
// Acceptance: builds; echo/exit/pwd/help/env builtins work; dispatch_line returns 0 on hit, 1 on miss.
// See design/kernel/r17-m3-004-shell-builtin-dispatch.md and design/kernel/r17-m4-shell-builtins.md.

module Dispatch = structure {
  pub let echo_name = "echo\0"
  pub let exit_name = "exit\0"
  pub let pwd_name = "pwd\0"
  pub let help_name = "help\0"
  pub let env_name = "env\0"
  pub let cd_name = "cd\0"
  pub let sp_char = " "
  pub let nl_char = "\n"
  pub let bin_prefix = "/bin/\0"
  pub let sbin_prefix = "/sbin/\0"
  // paideia-os #2456: PATH env-var key (5 significant bytes + NUL). Used by
  // dispatch_find_path_env's prefix compare against each envp entry, exactly
  // the same shape shell.pdx's shell_home_prefix uses for "HOME=".
  pub let path_env_key = "PATH=\0"
  pub let help_sep = " - \0"
  pub let env_path_msg = "PATH=/bin\n\0"
  pub let clear_name = "clear\0"
  pub let clear_desc = "clear screen and home cursor\0"
  pub let clear_seq = "\x1b[2J\x1b[H\0"
  pub let echo_desc = "echo text to stdout\0"
  pub let exit_desc = "exit shell (opt N)\0"
  pub let pwd_desc = "print working directory\0"
  pub let help_desc = "list all builtins\0"

  // #1975: help_builtin's /bin enumeration. help_bin_path has no trailing
  // slash (matches rootfs_seed.pdx's rs_path_bin convention for opening
  // "/bin" as a directory). help_bin_header wire length (NUL excluded) is
  // 7 ("\n/bin:\n").
  pub let help_bin_path = "/bin\0"
  pub let help_bin_header = "\n/bin:\n\0"
  pub let env_desc = "print environment vars\0"
  pub let cd_desc = "change working directory\0"

  // R86.M1-006 (#1959): cd_builtin now calls sys_chdir directly (kernel-
  // side path resolution against TASK_OFF_CWD replaces the old local
  // _cwd_buf copy + "must be absolute" refusal). "shell cd ok -- path=" is
  // split into fixed-length fragments the same way sh_exec_ok_* is above,
  // so the emit sequence can sandwich the runtime-length resolved path
  // (read back via sys_getcwd) between prefix and tail via sys_debug_puts.
  // Wire lengths (NUL excluded): prefix=20, tail=1 (just '\n').
  pub let cd_ok_prefix = "shell cd ok -- path=\0"
  pub let cd_fail_msg = "SHELL CD FAIL\n\0"
  pub let cd_root_path = "/\0"

  // paideia-os #2468: "sh: <cmd>: not found\n" diagnostic emitted by
  // the failed-execve arms of exec_child + pipeline forks. Prefix +
  // argv[0] + suffix are three separate sys_write(2, ...) calls so the
  // runtime-length command name gets echoed. Wire lengths exclude NUL.
  pub let sh_err_prefix = "sh: \0"
  pub let sh_err_suffix = ": not found\n\0"

  // R57.M4-005 (#1801): "shell exec ok" fingerprint, split into three
  // fixed-length fragments so the emit sequence can sandwich the two
  // runtime-length fields (argv[0] name, resolved path) between them via
  // sys_debug_puts (SC+ ID 12). ASCII "--" (not U+2014 em-dash) per
  // rootfs_seed.pdx L23's 7-bit-ASCII-on-wire note. Wire lengths (NUL
  // excluded, passed explicitly as sys_debug_puts's rsi): prefix=25,
  // mid=10, tail=25.
  pub let sh_exec_ok_prefix = "shell exec ok -- argv[0]=\0"
  pub let sh_exec_ok_mid = " resolved=\0"
  pub let sh_exec_ok_tail = " [legacy: SHELL EXEC OK]\n\0"

  // R58.M5-001 (#1805): "shell redirect ok" fingerprint, split into
  // fixed-length fragments the same way sh_exec_ok_* is above, so the
  // emit sequence in exec_child's rd_ redirect scan can sandwich the
  // three runtime-length fields (argv[0] name, operator, target file)
  // between them via sys_debug_puts (SC+ ID 12). ASCII "--" (not U+2014).
  // Wire lengths (NUL excluded, passed explicitly as sys_debug_puts's
  // rsi): prefix=29, mid_op=4, mid_file=6, tail=29.
  pub let sh_redirect_ok_prefix = "shell redirect ok -- argv[0]=\0"
  pub let sh_redirect_ok_mid_op = " op=\0"
  pub let sh_redirect_ok_mid_file = " file=\0"
  pub let sh_redirect_ok_tail = " [legacy: SHELL REDIRECT OK]\n\0"

  // paideia-os #2470 / #2473 (R119.M3): "pipe integrated ok stages=<n>"
  // fingerprint (semantic-shell-materialization-plan.md §4 R121.M5
  // wording adopted at R119.M3 for early wire evidence, since #2494's
  // UART RX race blocks reliable dynamic verification of `ls | cat`
  // output). Emitted by exec_child_pipeline_entry's PARENT branch AFTER
  // both children have been reaped via sys_wait4 -- so a hit in the
  // klog stream is byte-proof that (a) sys_pipe returned successfully,
  // (b) both forks succeeded, (c) both children ran to completion, and
  // (d) both were reaped before the shell reprinted the prompt. Every
  // reachable pipeline in R119 is a two-command shape so <n> is a
  // static "2" (fixed-width, avoids the paideia-as encoder's binary-
  // to-decimal formatting hazards); R121.M5 will widen <n> to a
  // runtime-length field once N-stage pipelines land. Wire length
  // (NUL excluded, passed explicitly as sys_debug_puts's rsi): 34.
  pub let sh_pipe_ok_msg = "shell pipe integrated ok stages=2\n\0"

  // ==========================================================================
  // R121.M5 (paideia-os #2499) -- semantic-shell typed-pipeline gate +
  // fingerprints for exec_child_pipeline_typed_entry (defined at file tail).
  //
  // Gate discipline: the typed-path is OFF by default. It engages only when
  // envp carries `SHELL_TYPED_PIPE=1` (byte-exact "1" value; any other value
  // -- "0", "y", empty, absent -- falls through to the legacy sys_pipe
  // + fork/exec_child_pipeline_entry path that #2470/#2473 shipped). This
  // preserves the R119.M3 fix's default behavior byte-for-byte for every
  // pipeline shape while the KIND_PIPELINE_EDGE substrate matures.
  //
  // CAP-MINT GAP (M5 discovery, NOT closed here):
  //
  //   The task expected exec_child_pipeline_typed_entry to mint two
  //   KIND_PIPELINE_EDGE caps (schema_id=0x121F, PE_ROLE_PROD/CONS)
  //   via cap_mint(KIND_PIPELINE_EDGE) and bind them via cap_invoke
  //   before the two forks. But pipeline_edge_alloc's own header note
  //   (src/kernel/core/cap/pipeline_edge.pdx §12: "Not reachable via
  //   cap_invoke (no MINT right at M1)") and the shim inventory
  //   (src/user/syscall_shim.pdx) both confirm there is no user-facing
  //   syscall for mint or for bind today -- only SC+ 131 send and
  //   SC+ 132 recv are wired. Consequently no ring-3 caller can seed
  //   KIND_PIPELINE_EDGE caps into its own cap_table, and the LEFT
  //   child's sys_pipe_edge_send observes -EBADF at every attempt
  //   against the unminted cap_table slot the pdx-produce canary passes.
  //
  //   R121.M5 lands the typed dispatcher entry + the two canaries +
  //   the rootfs seed rows as SKELETON: every code path that will
  //   exist post-mint is in place, and the dispatch-arm exercise
  //   (SysV shim -> sysenter -> pipe_edge_{send,recv} kernel body ->
  //   refuse arm PET_{SEND,RECV}_BAD_ROW -> -EBADF back through
  //   SYSRET) runs end-to-end. What remains for a follow-up landing
  //   (R121.M5-followup or R123): two new SC+ IDs (proposed 133
  //   sys_pipe_edge_mint, 134 sys_pipe_edge_bind) wrapping the
  //   already-`pub` pipeline_edge_alloc + pipe_edge_bind primitives
  //   plus a cap_mint_write into the caller's cap_table. The
  //   `records=0` field of sh_typed_pipe_ok_msg widens to a runtime
  //   count once those syscalls land.
  //
  // Fingerprints (each terminated by '\n', wire lengths exclude the NUL
  // storage byte, passed explicitly as sys_debug_puts's rsi):
  //   sh_typed_pipe_gate_msg (25) -- gate detected `SHELL_TYPED_PIPE=1`
  //                                  in envp and the pipe scan already
  //                                  found a `|`; emitted BEFORE the
  //                                  first fork so a hang inside the
  //                                  typed path is bisectable.
  //   sh_typed_pipe_gap_msg  (30) -- documents the CAP-MINT GAP once
  //                                  per gated invocation; grep this to
  //                                  find "typed path was chosen but
  //                                  cap-mint is not yet available".
  //   sh_typed_pipe_ok_msg   (39) -- both children reaped via wait4;
  //                                  R121.M5 acceptance witness. The
  //                                  `records=0` is static at M5 (no
  //                                  successful sends yet, per the gap);
  //                                  future landing widens to runtime N.
  //
  // shell_typed_pipe_name / _len: envp scan target for tokenizer_find_env.
  // 16 bytes ("SHELL_TYPED_PIPE"); no trailing NUL, no `=` -- the scanner
  // matches leading bytes then requires an `=`, so we pass just the name.
  pub let shell_typed_pipe_name : [u8; 17] = "SHELL_TYPED_PIPE\0"
  pub let shell_typed_pipe_name_len : u64 = 16
  pub let sh_typed_pipe_gate_msg : [u8; 26] = "shell typed-pipe gate on\n\0"
  pub let sh_typed_pipe_gate_msg_len : u64 = 25
  pub let sh_typed_pipe_gap_msg : [u8; 31] = "shell typed-pipe gap cap-mint\n\0"
  pub let sh_typed_pipe_gap_msg_len : u64 = 30
  pub let sh_typed_pipe_ok_msg : [u8; 40] = "shell typed-pipe ok stages=2 records=0\n\0"
  pub let sh_typed_pipe_ok_msg_len : u64 = 39

  pub let mut builtin_names : [u64; 8] = uninit @align(8)
  pub let mut builtin_handlers : [u64; 8] = uninit @align(8)
  pub let mut builtin_descs : [u64; 8] = uninit @align(8)
  pub let mut builtin_count : u64 = uninit @align(8)

  pub let mut child_wait_status : [u64; 1] = uninit @align(8)

  // paideia-os#2451: sys_pipe's caller-owned output pair. [0] = read_fd,
  // [1] = write_fd, matching syscall_shim.pdx sys_pipe's documented
  // 2x u64 output layout. Populated once per exec_child_pipeline call;
  // no reentrancy concern (single-threaded shell, one line dispatched
  // at a time).
  pub let mut _dp_pipe_fds : [u64; 2] = uninit @align(8)
  pub let mut resolved_path : [u8; 320] = uninit @align(8)
  // R57.M4-005 (#1801): sys_stat (SC+ ID 77) result scratch for
  // resolve_path's PATH-prefix probe. 64 bytes matches the kernel-side
  // stat struct layout (src/kernel/core/syscall/sys_stat.pdx); contents
  // are unused beyond the rax==0/!=0 hit/miss signal, so no field
  // offsets are named here.
  pub let mut _resolved_stat_scratch : [u64; 8] = uninit @align(8)
  // R86.M1-006/007 (#1959/#1960): sys_getcwd echo buffers for cd_builtin's
  // "shell cd ok -- path=<X>" fingerprint and pwd_builtin's own output.
  // Replaces the R17-M4 _cwd_buf (retired) -- the kernel's TASK_OFF_CWD is
  // now the sole source of truth for "where am I"; userspace only ever
  // holds a transient echo of what sys_getcwd just reported.
  pub let mut _cd_path_scratch : [u8; 256] = uninit @align(8)
  pub let mut _pwd_buf : [u8; 256] = uninit @align(8)
  // #1975: help_builtin's sys_getdents scratch for its /bin enumeration.
  // 4 KiB matches the kernel's GETDENTS_IO_MAX cap (src/user/ls.pdx's
  // _ls_buf follows the same sizing).
  pub let mut _help_bin_buf : [u8; 4096] = uninit @align(8)

  // paideia-os #2456: envp base pointer stashed by shell._start once it
  // captures rdx (envp per design/user/execve-abi.md). resolve_path's
  // rp_walk_path branch reads this slot to consult "PATH=" before falling
  // back to the hardcoded /bin:/sbin probe list. Zero (uninit .bss ->
  // effectively 0 at load time; shell always writes r12 into it once at
  // _start, even when r12==0/envp==NULL) means "no envp captured", which
  // dispatch_find_path_env treats identically to "no PATH entry present"
  // and drops straight through to the fallback list.
  pub let mut envp_slot : u64 = uninit @align(8)

  // paideia-os #2469 (R119.M2, #2472): stash slot for the bitmap
  // apply_pre_dispatch_redirects returns, parked here across
  // dispatch_line + exec_child and consumed by
  // unwind_pre_dispatch_redirects at the tail of every main_loop
  // iteration. Single-flow (main_loop is strictly sequential and this
  // module has one call site), so no aliasing concern; stays in .bss
  // rather than on the caller's stack to keep shell.pdx main_loop's
  // pre-fix zero-push-per-iteration discipline unchanged. 0 (its
  // uninit-.bss reset each iteration by the explicit write below)
  // means "no redirects applied this cycle" and the unwind call is
  // a fall-through-noop.
  pub let mut _shell_redirect_bitmap : u64 = uninit @align(8)

  // paideia-os #2456: scratch for building "<segment>/" out of one
  // colon-separated PATH segment (which unlike bin_prefix/sbin_prefix
  // does NOT carry a trailing slash) before rp_build_seg_candidate copies
  // it into resolved_path and appends argv[0]. Length cap 256 mirrors
  // _cd_path_scratch/_pwd_buf sizing; individual segments longer than
  // 254 bytes (leaving room for '/' + defensive margin) are skipped by
  // the walk loop rather than truncated. Single-flow (no concurrent
  // callers at R106; matches _resolved_stat_scratch's own posture).
  pub let mut _path_segment_scratch : [u8; 256] = uninit @align(8)
  pub let mut echo_emit_nl : u64 = uninit @align(8)
  pub let mut echo_first_token : u64 = uninit @align(8)
  pub let mut echo_idx : u64 = uninit @align(8)

  // dispatch_init() — populate runtime dispatch table at startup.
  // Loads addresses of echo_name, exit_name, pwd_name, help_name, env_name, cd_name, clear_name into builtin_names[0..6].
  // Loads addresses of echo_builtin, exit_builtin, pwd_builtin, help_builtin, env_builtin, cd_builtin, clear_builtin into builtin_handlers[0..6].
  // Loads addresses of echo_desc, exit_desc, pwd_desc, help_desc, env_desc, cd_desc, clear_desc into builtin_descs[0..6].
  // Sets builtin_count = 7.
  pub let dispatch_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R17-m3-004 (#624) + R17-M4 (#629-634): dispatch_init populates builtin_names, builtin_handlers, builtin_descs, builtin_count at runtime startup. Called once from _start before main_loop. No arguments; no return.",
      block: {
        lea rdi, [rip + builtin_names];
        lea rax, [rip + echo_name];
        mov [rdi + 0], rax;
        lea rax, [rip + exit_name];
        mov [rdi + 8], rax;
        lea rax, [rip + pwd_name];
        mov [rdi + 16], rax;
        lea rax, [rip + help_name];
        mov [rdi + 24], rax;
        lea rax, [rip + env_name];
        mov [rdi + 32], rax;
        lea rax, [rip + cd_name];
        mov [rdi + 40], rax;
        lea rax, [rip + clear_name];
        mov [rdi + 48], rax;

        lea rdi, [rip + builtin_handlers];
        lea rax, [rip + echo_builtin];
        mov [rdi + 0], rax;
        lea rax, [rip + exit_builtin];
        mov [rdi + 8], rax;
        lea rax, [rip + pwd_builtin];
        mov [rdi + 16], rax;
        lea rax, [rip + help_builtin];
        mov [rdi + 24], rax;
        lea rax, [rip + env_builtin];
        mov [rdi + 32], rax;
        lea rax, [rip + cd_builtin];
        mov [rdi + 40], rax;
        lea rax, [rip + clear_builtin];
        mov [rdi + 48], rax;

        lea rdi, [rip + builtin_descs];
        lea rax, [rip + echo_desc];
        mov [rdi + 0], rax;
        lea rax, [rip + exit_desc];
        mov [rdi + 8], rax;
        lea rax, [rip + pwd_desc];
        mov [rdi + 16], rax;
        lea rax, [rip + help_desc];
        mov [rdi + 24], rax;
        lea rax, [rip + env_desc];
        mov [rdi + 32], rax;
        lea rax, [rip + cd_desc];
        mov [rdi + 40], rax;
        lea rax, [rip + clear_desc];
        mov [rdi + 48], rax;

        lea rdi, [rip + builtin_count];
        mov rax, 7;
        mov [rdi], rax;

        ret
      }
    } @no_frame

  // dispatch_line() -> u64
  // Reads argc and argv_buf from Tokenizer .bss (linked symbols).
  // Walks builtin_names table, compares argv[0] against each builtin name.
  // If hit: calls matching handler, returns 0.
  // If miss (no builtin matches, or argc==0): returns 1.
  // Register plan: r9 = argv[0], r10 = strlen(argv[0]), r11 = loop index.
  pub let dispatch_line : () -> u64 !{mem, sysreg} @{fs} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {fs},
      justification: "R17-m3-004 (#624): dispatch_line walks runtime builtin table. Reads argc/argv_buf from Tokenizer symbols (extern linkage). No arguments; uses r9=argv[0], r10=strlen(argv[0]), r11=loop index. Returns 0 on builtin hit (and calls handler), 1 on miss.",
      block: {
        lea rax, [rip + argc];
        mov rax, [rax];
        cmp rax, 0;
        je dispatch_notfound;

        lea rax, [rip + argv_buf];
        mov r9, [rax];
        mov rdi, r9;
        call strlen;
        mov r10, rax;

        xor r11, r11;
dispatch_loop:
        lea rax, [rip + builtin_count];
        mov rax, [rax];
        cmp r11, rax;
        jge dispatch_notfound;

        lea rax, [rip + builtin_names];
        mov rdi, [rax + r11*8];
        call strlen;
        cmp rax, r10;
        jne dispatch_next;

        mov rdi, r9;
        lea rax, [rip + builtin_names];
        mov rsi, [rax + r11*8];
        mov rdx, r10;
        call memcmp;
        cmp rax, 0;
        jne dispatch_next;

        lea rax, [rip + builtin_handlers];
        mov rax, [rax + r11*8];
        sub rsp, 8;
        call rax;
        add rsp, 8;
        xor rax, rax;
        ret;
dispatch_next:
        add r11, 1;
        jmp dispatch_loop;
dispatch_notfound:
        mov rax, 1;
        ret
      }
    } @no_frame

  // ==========================================================================
  // paideia-os #2469 (R119.M2, #2472): pre-dispatch redirect application.
  //
  // Root-cause bisection for #2469 (recorded here so the flow is visible
  // at the call site):
  //
  //   Symptom A:  `cat /etc/hostname > out` — file created, empty; the
  //   'shell redirect ok' fingerprint fired (so exec_child's rd_ scan
  //   ran and sys_open returned a positive fd) but cat's content still
  //   landed on the console instead of in `out`.
  //
  //     Bug (i)   sys_dup2's phase-1/2 fd validator rejected any dst
  //               < 3 as -EBADF. exec_child's rd_open_common issued
  //               `sys_dup2(new_fd, 1)` which was refused: fd_table[1]
  //               was NEVER rewired onto `out`, and the subsequent
  //               sys_close(new_fd) dropped the last vnode ref and
  //               truncated `out` back to empty.
  //
  //     Bug (ii)  Even IF phase-1/2 had accepted dst=1, the kernel's
  //               dispatch_write handler short-circuited ALL fd 1/2
  //               writes to a UART fast-path before ever reading
  //               task.fd_table[fd]. cat's `sys_write(1, "paideia\n", 8)`
  //               went to the console regardless of what fd_table[1]
  //               held. (The comment on the shortcut cited an early-
  //               boot 'preserves stdout/stderr until init opens TTY
  //               fds' convenience that was never retired once real
  //               producers started installing fds there.)
  //
  //     Bug (iii) sys_write's own [3,32) fd lower-bound gate — a
  //               transitive duplicate of the sys_dup2 gate above. Even
  //               once the dispatch shortcut was made conditional, the
  //               body would still EBADF a legitimate fd=1 write.
  //
  //   Symptom B:  `echo hello > out` — printed 'hello > out' literally,
  //   no file created. The tokenizer produced argv=[echo, hello, >, out]
  //   and dispatch_line matched `echo`, invoking echo_builtin -- which
  //   walked argv[1..argc) space-separated. The redirect scan lives ONLY
  //   in exec_child (post-fork, child-only) and never fires for builtins.
  //
  //     Bug (iv)  No builtin-side redirect scrub. Any builtin (echo, env,
  //               pwd, help, ...) received redirect operators as literal
  //               argv entries.
  //
  // Fix layout:
  //
  //   (i)-(iii) Kernel-side: sys_dup2 fd range widened to [0,32),
  //             sys_write range likewise, and dispatch_write for fd 1/2
  //             now probes task.fd_table[fd] before the UART shortcut
  //             (empty slot ⇒ UART fallback for early boot; populated
  //             slot ⇒ real body path). See sys_dup2.pdx, sys_write.pdx,
  //             core/syscall/dispatch.pdx.
  //
  //   (iv)      This module: apply_pre_dispatch_redirects + companion
  //             unwind_pre_dispatch_redirects are called from shell.pdx
  //             main_loop BEFORE dispatch_line. Applies redirects to the
  //             shell's own fd_table (so any builtin that writes to fd 1
  //             hits the redirected file, and any external command that
  //             falls through to exec_child inherits the fd across fork).
  //             argv is scrubbed in place so exec_child's own rd_ scan
  //             (still there defensively) finds nothing to do.
  //
  // Save/restore discipline:
  //   Today the shell's fd_table[0/1/2] is empty (init's dup2 chain also
  //   suffered bug (i) until this fix; even after, those slots depend on
  //   /dev/tty0 being opened successfully). The unwind path therefore
  //   just closes the redirected fd -- the slot returns to 0 and
  //   subsequent shell writes take dispatch_write's UART fallback, which
  //   is exactly what the shell had before the redirect. If a future init
  //   populates stdio with a real vnode, a follow-up will grow this pair
  //   to sys_dup2(target_fd, save_slot) before the redirect and dup2 back
  //   afterward -- sys_dup2 now accepts stdio fds on both sides for
  //   exactly that shape.
  // ==========================================================================

  // apply_pre_dispatch_redirects() -> u64
  //
  // Scans Tokenizer's argv_buf/argc for '>'/'>>'/'<' operators. For each
  // hit, opens the following filename token, sys_dup2's the new fd onto
  // the target (1 for '>'/'>>'; 0 for '<'), closes the new fd, and drops
  // both the operator and filename tokens from argv (left-compact write
  // cursor). Updates argc to the post-scrub count.
  //
  // Returns a bitmap of target_fds that were successfully retargeted:
  //   bit 0 set -> fd 0 was redirected
  //   bit 1 set -> fd 1 was redirected
  //   bit 2 set -> fd 2 was redirected
  // (Higher bits reserved for future save-slot state.) 0 means "no
  // redirects present or every candidate was malformed"; the caller
  // still runs dispatch_line/exec_child but does not need to unwind.
  //
  // Best-effort: a sys_open failure or a missing filename token drops
  // that redirect silently and the loop continues -- same posture as
  // exec_child's rd_apply_open_err. Idempotent on an already-scrubbed
  // argv (returns 0 and touches nothing).
  //
  // Register plan (mirrors exec_child's rd_ scan):
  //   rbx = accumulated bitmap (survives sys_open/sys_dup2/sys_close)
  //   r12 = argc, loaded once
  //   r13 = read_idx, r14 = write_idx
  //   r15 = current token ptr / target_fd carrier (as in exec_child)
  // All five are callee-save; strlen/memcmp/sys_* touch only caller-save.
  // Rax/rcx/rdx/rdi/rsi/r8-r11 are NOT trusted across CALL or SYSCALL
  // (dispatch.pdx-wide convention -- see resolve_path's rp_hit reload
  // discipline); every argv_buf[i] use is reloaded fresh.
  //
  // Reserved-label discipline: every label is apr_-prefixed (bare `loop`,
  // `if`, `top`, `done` are paideia-as keywords).
  pub let apply_pre_dispatch_redirects : () -> u64 !{mem, sysreg} @{fs} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {fs},
      justification: "paideia-os #2469 (R119.M2, #2472): scans Tokenizer argv_buf for '>'/'>>'/'<' and applies each redirect to the shell's OWN fd_table via sys_open + sys_dup2 + sys_close, left-compacts argv, updates argc, and returns a bitmap (bit N = target_fd N was retargeted). Called from shell.pdx main_loop BEFORE dispatch_line so that both builtins (in-process) and external commands (post-fork via exec_child) see the redirect applied. Structural twin of exec_child's rd_ scan (same argc/argv walk, same open+dup2+close+compact shape, same operator constants from Tokenizer rodata), but this one runs in the PARENT shell process (whereas exec_child's runs in the forked child); the parent needs the redirect for builtins that never fork, and the child inherits it across fork for the external-command path. exec_child's own rd_ scan is preserved as defense-in-depth: on an already-scrubbed argv it left-compacts verbatim and dups nothing (idempotent). Best-effort taxonomy: sys_open failure or missing filename drops that redirect silently and the loop continues, mirroring rd_apply_open_err/rd_apply_no_target. 2>&1 is intentionally NOT handled here (it's a fd-to-fd redirect, not a file open; exec_child's own rd_ scan still covers it for external commands; a builtin-side 2>&1 is a future add). Register plan: rbx=bitmap (must survive every nested call; not touched by strlen/memcmp/sys_* per SysV callee-save + the syscall_shim's `mov rax,N; syscall; ret` shape that clobbers only rcx/r11 beyond rax), r12=argc, r13=read_idx, r14=write_idx, r15=token_ptr/target_fd -- exactly the layout exec_child uses so its debugger discipline for rd_ transfers verbatim. Bitmap-set uses `or rbx, imm8` (1/2/4 for fd 0/1/2) rather than a variable shift so the encoder path stays on 8-bit immediates (avoids the codebase's `shl reg, cl` cases and the `and r11, imm64` pitfall class entirely). Encoder-gap discipline: no `test rN,rN` (uses cmp rN,0); no `add reg,[mem]` (indexed loads via [base + idx*8]); no 2-op `imul r,imm`. Alignment: 5-push prologue (40B) + return-addr (8B) = 48B = 16 mod 0 at every nested call site, matching every other 5-push callee in this file. Pushing rax mid-flow (across sys_dup2/sys_close) breaks that to %16==8 -- safe because syscall_shim entries are `mov+syscall+ret` with no C-ABI callee inside. Effects/capabilities `!{mem,sysreg} @{fs}` cover argv scans + open/dup2/close syscalls; no fingerprint emitted (the existing exec_child rd_ scan's 'shell redirect ok' fingerprint stays -- for builtin paths, the caller is expected to add its own witness at the main_loop callsite if desired). Reserved-label discipline: every label apr_-prefixed.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        xor rbx, rbx;                    // bitmap = 0

        lea rax, [rip + argc];
        mov r12, [rax];                  // r12 = argc
        xor r13, r13;                    // r13 = read_idx
        xor r14, r14;                    // r14 = write_idx

      apr_loop:
        cmp r13, r12;
        jge apr_compact_done;

        lea rax, [rip + argv_buf];
        mov r15, [rax + r13*8];          // r15 = argv_buf[read_idx]
        mov rdi, r15;
        call strlen;                     // rax = strlen(token)

        cmp rax, 2;
        je apr_try_gtgt;
        cmp rax, 1;
        jne apr_keep_token;

        // len == 1: '>' or '<'
        mov rdi, r15;
        lea rsi, [rip + redirect_gt];
        mov rdx, 1;
        call memcmp;
        cmp rax, 0;
        je apr_gt_single;

        mov rdi, r15;
        lea rsi, [rip + redirect_lt];
        mov rdx, 1;
        call memcmp;
        cmp rax, 0;
        je apr_lt;

        jmp apr_keep_token;

      apr_try_gtgt:
        mov rdi, r15;
        lea rsi, [rip + redirect_gtgt];
        mov rdx, 2;
        call memcmp;
        cmp rax, 0;
        jne apr_keep_token;
        // matched ">>": append to stdout
        mov r15, 1;                       // target_fd = 1
        mov rsi, 0x241;                    // O_WRONLY|O_CREAT|O_APPEND (see vfs_open.pdx)
        jmp apr_open_common;

      apr_gt_single:
        mov r15, 1;                       // target_fd = 1
        mov rsi, 0xC1;                     // O_WRONLY|O_CREAT|O_TRUNC
        jmp apr_open_common;

      apr_lt:
        mov r15, 0;                       // target_fd = 0
        mov rsi, 0;                        // O_RDONLY
        jmp apr_open_common;

      apr_open_common:
        // Need argv_buf[read_idx + 1] as the filename token.
        mov rax, r13;
        add rax, 1;
        cmp rax, r12;
        jge apr_no_target;

        lea rcx, [rip + argv_buf];
        mov rdi, [rcx + rax*8];           // filename ptr
        mov rdx, 0x1A4;                    // mode 0644
        call sys_open;                     // rax = new_fd or -errno
        cmp rax, 0;
        jl apr_open_err;

        // rax = new_fd. Preserve it across sys_dup2 by stashing on stack
        // (rbx-r15 are all live; syscalls only clobber rax/rcx/r11).
        push rax;                          // save new_fd  (%16 breaks to 8; safe for syscall shims)
        mov rdi, rax;                      // oldfd = new_fd
        mov rsi, r15;                      // newfd = target_fd
        call sys_dup2;
        pop rdi;                           // restore new_fd
        call sys_close;

        // Mark bit r15 in the bitmap (r15 is 0/1/2 -> or with 1/2/4).
        cmp r15, 0;
        je apr_mark_stdin;
        cmp r15, 1;
        je apr_mark_stdout;
        or rbx, 4;                         // fd 2
        jmp apr_consumed;
      apr_mark_stdin:
        or rbx, 1;
        jmp apr_consumed;
      apr_mark_stdout:
        or rbx, 2;

      apr_consumed:
        add r13, 2;                        // dropped operator + filename
        jmp apr_loop;

      apr_open_err:
        // Malformed redirect: drop operator + filename silently.
        add r13, 2;
        jmp apr_loop;

      apr_no_target:
        // Operator with no following token: drop just the operator.
        add r13, 1;
        jmp apr_loop;

      apr_keep_token:
        // Not a redirect: left-compact copy argv_buf[read] -> argv_buf[write].
        lea rax, [rip + argv_buf];
        mov [rax + r14*8], r15;
        add r13, 1;
        add r14, 1;
        jmp apr_loop;

      apr_compact_done:
        // NUL-pointer-terminate compacted argv; update argc.
        lea rax, [rip + argv_buf];
        xor rcx, rcx;
        mov [rax + r14*8], rcx;
        lea rax, [rip + argc];
        mov [rax], r14;

        mov rax, rbx;                      // return bitmap

        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    } @no_frame

  // unwind_pre_dispatch_redirects(bitmap) -> ()
  //
  // Inverse of apply_pre_dispatch_redirects. For each bit set in `bitmap`,
  // sys_close's the corresponding fd (0, 1, or 2). This drops the vnode
  // refcount held by the redirect's sys_dup2, so on the shell's next
  // write to that fd, dispatch_write's fd_table probe finds an empty
  // slot and takes the UART fallback -- identical to the pre-redirect
  // behavior in a shell whose stdio was never externally installed. See
  // the header block above for the save/restore extension path (needs
  // sys_dup2 accepting stdio on both sides, which this fix landed).
  //
  // rdi = bitmap (u64; only bits 0/1/2 consulted).
  //
  // Reserved-label discipline: upr_-prefixed.
  pub let unwind_pre_dispatch_redirects : (u64) -> () !{sysreg} @{fs} =
    fn (bitmap: u64) -> unsafe {
      effects: {sysreg}, capabilities: {fs},
      justification: "paideia-os #2469 (R119.M2, #2472): closes each fd the companion apply_pre_dispatch_redirects retargeted, restoring the shell's fd_table[0/1/2] to 'empty' so dispatch_write's fd 1/2 probe falls back to UART for subsequent shell output (prompt, error messages, next command's dispatch). 1-push prologue (rbx) preserves the bitmap across sys_close's syscall shim (which only clobbers rax/rcx/r11 beyond rax, but rbx is callee-save regardless). Bit-test uses `mov rax, rbx; and rax, imm8; cmp rax, 0; je` rather than `test rbx, imm` (paideia-as encoder pitfall list — no `test rN, rN` and defensive against test-with-imm gaps). Three fixed sys_close calls in sequence rather than a loop -- simplest possible shape for a three-element enumeration; the loop version would need a shift/loop-index register but gain no size benefit. If bitmap is 0 (no redirects were applied), all three branches fall through and the function returns without any syscall. Effects/capabilities `!{sysreg} @{fs}` match sys_close's own row. Alignment: 1-push prologue (8B) + return-addr (8B) = 16 = 0 mod 16 at every syscall shim callsite -- but shims are `mov rax,N; syscall; ret` (no nested C-ABI call) so alignment is irrelevant; the push is purely for rbx preservation. Reserved-label discipline: upr_-prefixed.",
      block: {
        push rbx;
        mov rbx, rdi;                      // rbx = bitmap

        mov rax, rbx;
        and rax, 1;
        cmp rax, 0;
        je upr_check_stdout;
        mov rdi, 0;
        call sys_close;

      upr_check_stdout:
        mov rax, rbx;
        and rax, 2;
        cmp rax, 0;
        je upr_check_stderr;
        mov rdi, 1;
        call sys_close;

      upr_check_stderr:
        mov rax, rbx;
        and rax, 4;
        cmp rax, 0;
        je upr_end;
        mov rdi, 2;
        call sys_close;

      upr_end:
        pop rbx;
        ret
      }
    } @no_frame

  // echo_builtin() -> u64
  // Emits argv[1..argc-1] (or argv[2..argc-1] if argv[1]=="-n") space-separated.
  // If "-n" flag not present, followed by newline. Reads argc/argv_buf from Tokenizer .bss.
  pub let echo_builtin : () -> u64 !{mem, sysreg} @{fs} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {fs},
      justification: "R17-M4 (#629) + #1016 fix: echo_builtin with -n flag support. Emits argv[1..argc-1] space-separated. If argv[1]==\"-n\", suppresses trailing newline and starts from argv[2]. Reads argc/argv_buf from Tokenizer .bss. Returns 0. Two bugs fixed for #1016: (a) space suppression tracked via echo_first_token .bss slot rather than the old r9==1||r9==2 heuristic that silently dropped the space between argv[1] and argv[2] when no -n flag was given. (b) argc AND the loop index are reloaded from memory at the top of every echo_scan iteration — the userland→kernel syscall path in src/kernel/core/syscall/entry.pdx shuffles r10 (SYSCALL arg-4) into r8 (SysV arg-5) and does not restore r10 before sysret; likewise r9 survives the shuffle only conditionally, so both are pinned to echo_idx / argc .bss slots across sys_write calls. Prior version kept argc in r10 and index in r9 across sys_write, which silently exited the loop after argv[1] because the garbage r10 satisfied the r9>=r10 test on iteration 2 (echo hello world → 'hello' only).",
      block: {
        // default: emit_nl = 1, first_token = 1, echo_idx = 1
        lea rax, [rip + echo_emit_nl];
        mov rcx, 1;
        mov [rax], rcx;
        lea rax, [rip + echo_first_token];
        mov rcx, 1;
        mov [rax], rcx;
        lea rax, [rip + echo_idx];
        mov rcx, 1;
        mov [rax], rcx;

        // if argc >= 2, check argv[1] for "-n" (exactly two chars: '-','n', NUL)
        lea rax, [rip + argc];
        mov r10, [rax];
        cmp r10, 2;
        jl echo_scan;
        lea rax, [rip + argv_buf];
        mov r11, [rax + 8];
        xor rax, rax;
        mov al, [r11];
        and rax, 0xff;
        cmp rax, 0x2D;
        jne echo_scan;
        xor rax, rax;
        mov al, [r11 + 1];
        and rax, 0xff;
        cmp rax, 0x6E;
        jne echo_scan;
        xor rax, rax;
        mov al, [r11 + 2];
        and rax, 0xff;
        cmp rax, 0;
        jne echo_scan;
        // "-n" confirmed: skip it, suppress \n
        lea rax, [rip + echo_idx];
        mov rcx, 2;
        mov [rax], rcx;
        lea rax, [rip + echo_emit_nl];
        xor rcx, rcx;
        mov [rax], rcx;

echo_scan:
        // Reload argc and idx from memory — r10 (arg-4) is clobbered by the
        // kernel's syscall shuffle on every sys_write; r9 is preserved but
        // pinning both to memory is simpler than tracking which subset.
        lea rax, [rip + argc];
        mov r10, [rax];
        lea rax, [rip + echo_idx];
        mov r9, [rax];
        cmp r9, r10;
        jge echo_maybe_nl;
        // Emit leading space unless this is the first token to be printed.
        lea rax, [rip + echo_first_token];
        mov rcx, [rax];
        cmp rcx, 0;
        jne echo_arg;   // first_token != 0 → no leading space, and mark 0 below
        mov rdi, 1;
        lea rsi, [rip + sp_char];
        mov rdx, 1;
        call sys_write;
echo_arg:
        // Reload r9 (idx) — sys_write above may have clobbered it (see justification).
        lea rax, [rip + echo_idx];
        mov r9, [rax];
        lea rax, [rip + argv_buf];
        mov rdi, [rax + r9*8];
        call strlen;
        mov rdx, rax;
        // Reload r9 again — strlen shouldn't touch it but be defensive.
        lea rax, [rip + echo_idx];
        mov r9, [rax];
        mov rdi, 1;
        lea rax, [rip + argv_buf];
        mov rsi, [rax + r9*8];
        call sys_write;
        // mark first_token = 0 (subsequent iterations get a leading space)
        lea rax, [rip + echo_first_token];
        xor rcx, rcx;
        mov [rax], rcx;
        // Advance idx via memory (r9 may be clobbered post-sys_write).
        lea rax, [rip + echo_idx];
        mov rcx, [rax];
        add rcx, 1;
        mov [rax], rcx;
        jmp echo_scan;
echo_maybe_nl:
        lea rax, [rip + echo_emit_nl];
        mov rax, [rax];
        cmp rax, 0;
        je echo_done;
        mov rdi, 1;
        lea rsi, [rip + nl_char];
        mov rdx, 1;
        call sys_write;
echo_done:
        xor rax, rax;
        ret
      }
    } @no_frame

  // exit_builtin() -> u64
  // Call sys_exit with optional numeric exit code from argv[1], or 0 if not provided.
  pub let exit_builtin : () -> u64 !{mem, sysreg} @{} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "R17-M4 (#630): exit_builtin calls sys_exit with optional numeric exit code from argv[1]. Parses argv[1] via dec_parse, or uses 0. Returns (unreachable).",
      block: {
        lea rax, [rip + argc];
        mov rax, [rax];
        xor rdi, rdi;
        cmp rax, 2;
        jl exit_go;
        lea rax, [rip + argv_buf];
        mov rdi, [rax + 8];
        call dec_parse;
        mov rdi, rax;
exit_go:
        call sys_exit;
        hlt
      }
    } @no_frame

  // dec_parse(rdi=cstr) -> u64 (in rax)
  // Parse a null-terminated decimal string into u64. Non-digit chars terminate parsing.
  pub let dec_parse : (u64) -> u64 !{mem} @{} =
    fn (s: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R17-M4 (#630 helper): dec_parse parses decimal string (cstr in rdi) into u64 returned in rax. Loop: load byte, if not in [0x30..0x39] stop, else accumulate via rax*10+digit.",
      block: {
        xor rax, rax;
dec_parse_loop:
        xor rcx, rcx;
        mov cl, [rdi];
        and rcx, 0xff;
        cmp rcx, 0x30;
        jl dec_parse_done;
        cmp rcx, 0x39;
        jg dec_parse_done;
        mov r8, rax;
        shl r8, 3;
        add r8, rax;
        add r8, rax;
        sub rcx, 0x30;
        add r8, rcx;
        mov rax, r8;
        add rdi, 1;
        jmp dec_parse_loop;
dec_parse_done:
        ret
      }
    } @no_frame

  // pwd_builtin() -> u64
  // R86.M1-007 (#1960): print the kernel's current-working-directory
  // vnode (TASK_OFF_CWD) via sys_getcwd, replacing the R17-M4 local
  // _cwd_buf echo. On failure (-EFAULT/-ENOENT/-ERANGE, none reachable
  // in practice at R86 -- getcwd is called with a full PATH_MAX buffer
  // and a task's cwd is always valid), emit nothing beyond the syscall's
  // own klog fingerprint absence and return 1.
  pub let pwd_builtin : () -> u64 !{mem, sysreg} @{fs} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {fs},
      justification: "R86.M1-007 (#1960): pwd_builtin calls sys_getcwd(&_pwd_buf, 256) -> rax = bytes written (incl. NUL) or negative errno. On success, sys_write(1, &_pwd_buf, rax-1) emits the path (rax-1 excludes the NUL sys_getcwd counted) followed by a newline via sys_write(1, &nl_char, 1); returns 0. On failure (rax < 0), returns 1 without writing anything -- matches cd_builtin's own fail-silent-to-stdout / nonzero-return convention.",
      block: {
        lea rdi, [rip + _pwd_buf];
        mov rsi, 256;
        call sys_getcwd;                 // rax = bytes (incl NUL) or -errno
        cmp rax, 0;
        jl pwd_fail;

        mov r10, rax;
        sub r10, 1;                      // r10 = strlen (excludes NUL)
        mov rdi, 1;
        lea rsi, [rip + _pwd_buf];
        mov rdx, r10;
        call sys_write;

        mov rdi, 1;
        lea rsi, [rip + nl_char];
        mov rdx, 1;
        call sys_write;

        xor rax, rax;
        ret;

      pwd_fail:
        mov rax, 1;
        ret
      }
    } @no_frame

  // help_builtin() -> u64
  // List all builtins with descriptions, then enumerate /bin contents.
  // Uses r12 (callee-saved) for the builtin loop.
  pub let help_builtin : () -> u64 !{mem, sysreg} @{fs} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {fs},
      justification: "R17-M4 (#633) + #1975: help_builtin walks builtin table and emits name - desc\\n for each (uses r12, callee-saved), then enumerates /bin so users can discover non-builtin commands without a separate `ls /bin`. #1975 addendum: after help_done's original pop r12, emit a '\\n/bin:\\n' header via sys_write(1,...), then sys_open(help_bin_path='/bin', O_RDONLY=0, mode=0) -- on failure (rax<0, this file's own signed-check convention, e.g. rd_open_common at exec_child) skip straight to cleanup so a missing/unmounted /bin degrades to 'help still works, just no listing' rather than failing the whole builtin. On success, walk sys_getdents (SC+ ID 78) exactly like src/user/ls.pdx's ls_getdents_top/ls_walk_top: inlined here (`mov rax, 78; syscall`) rather than `call`ed through src/user/libc/getdents.pdx, because build-user.sh routes libc/*.pdx's LIBC_OBJECTS into the ls.elf link only (see that file's header) and shell.elf does not consume them -- inlining avoids widening that link boundary for one call site. Register plan for the /bin walk, chosen to avoid r12 (already used and popped back to the caller's value by the builtin loop above, so left alone rather than re-saved): r13 = fd, r14 = bytes_returned for the current getdents batch, r15 = offset walker into _help_bin_buf. No persistent record-pointer register (unlike ls.pdx's r15) -- recomputed transiently into rax (`lea rax,[rip+_help_bin_buf]; add rax, r15`) each time it is needed, since caller-save rax is clobbered by every sys_write/syscall in between anyway. r13-r15 are pushed/popped around the whole block because help_builtin returns via ret to dispatch_line (not sys_exit), so SysV callee-save regs must come back intact. name_len is read via `xor r8,r8; mov_w r8,[rax+8]` per the frozen sys_getdents record layout (+8 u16 name_len, +12 name bytes, matching ls.pdx and src/kernel/core/syscall/sys_getdents.pdx). rax==0 or rax>4096 (negative errno, unsigned) both route to help_bin_close (empty dir and getdents failure are both 'stop and clean up', matching ls.pdx's ls_close_done/ls_fail_getdents both closing fd). Encoder-gap discipline: no `add reg,[mem]`/`sub reg,[mem]` anywhere -- every advance is register arithmetic. Reserved-label discipline: every new label prefixed `help_bin_`.",
      block: {
        push r12;
        xor r12, r12;
help_loop:
        lea rax, [rip + builtin_count];
        mov rax, [rax];
        cmp r12, rax;
        jge help_done;

        // name
        lea rax, [rip + builtin_names];
        mov rdi, [rax + r12*8];
        call puts_new;

        // " - "
        mov rdi, 1;
        lea rsi, [rip + help_sep];
        mov rdx, 3;
        call sys_write;

        // desc
        lea rax, [rip + builtin_descs];
        mov rdi, [rax + r12*8];
        call puts_new;

        // \n
        mov rdi, 1;
        lea rsi, [rip + nl_char];
        mov rdx, 1;
        call sys_write;

        add r12, 1;
        jmp help_loop;
help_done:
        pop r12;

        // ============================================================
        // #1975: enumerate /bin after the compiled-in builtin list.
        // ============================================================
        push r13;
        push r14;
        push r15;

        // "\n/bin:\n" (wire length 7, excludes help_bin_header's NUL)
        mov rdi, 1;
        lea rsi, [rip + help_bin_header];
        mov rdx, 7;
        call sys_write;

        // sys_open("/bin", O_RDONLY = 0, mode = 0) -> fd
        lea rdi, [rip + help_bin_path];
        xor rsi, rsi;
        xor rdx, rdx;
        call sys_open;
        cmp rax, 0;
        jl help_bin_pop;                 // open failed -- skip enumeration
        mov r13, rax;                    // r13 = fd

help_bin_getdents_top:
        mov rdi, r13;
        lea rsi, [rip + _help_bin_buf];
        mov rdx, 4096;
        mov rax, 78;                     // SC+ ID 78 = sys_getdents (inlined;
                                          // libc/getdents.pdx not linked into
                                          // shell.elf -- see justification)
        syscall;

        cmp rax, 0;
        je help_bin_close;               // directory drained
        cmp rax, 4096;
        ja help_bin_close;               // negative errno -- bail out, clean up

        mov r14, rax;                    // bytes_returned
        xor r15, r15;                    // offset := 0

help_bin_walk_top:
        // Bounds: offset + 12 must be <= bytes_returned to fit a header.
        mov rcx, r15;
        add rcx, 12;
        cmp rcx, r14;
        ja help_bin_getdents_top;        // batch drained without terminator; refill

        lea rax, [rip + _help_bin_buf];
        add rax, r15;                    // rax = &buf[offset] (record ptr)

        xor r8, r8;
        mov_w r8, [rax + 8];             // name_len (u16, zero-extended)
        cmp r8, 0;
        je help_bin_close;               // terminator -- directory drained

        // sys_write(1, &buf[offset + 12], name_len)
        mov rdi, 1;
        mov rsi, rax;
        add rsi, 12;
        mov rdx, r8;
        call sys_write;

        // sys_write(1, "\n", 1)
        mov rdi, 1;
        lea rsi, [rip + nl_char];
        mov rdx, 1;
        call sys_write;

        // Advance offset += 12 + name_len. rax/r8 are caller-save and
        // clobbered by the two calls above, so recompute the record
        // pointer and reload name_len from memory; r13-r15 are
        // callee-save and survive.
        lea rax, [rip + _help_bin_buf];
        add rax, r15;
        xor r8, r8;
        mov_w r8, [rax + 8];
        add r15, 12;
        add r15, r8;
        jmp help_bin_walk_top;

help_bin_close:
        mov rdi, r13;
        call sys_close;

help_bin_pop:
        pop r15;
        pop r14;
        pop r13;

        xor rax, rax;
        ret
      }
    } @no_frame

  // env_builtin() -> u64
  // Print environment variables (stub: prints PATH=/bin).
  pub let env_builtin : () -> u64 !{mem, sysreg} @{fs} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {fs},
      justification: "R17-M4 (#634): env_builtin emits environment (stub: PATH=/bin). Returns 0.",
      block: {
        mov rdi, 1;
        lea rsi, [rip + env_path_msg];
        mov rdx, 10;
        call sys_write;
        xor rax, rax;
        ret
      }
    } @no_frame

  // cd_builtin() -> u64
  // R86.M1-006 (#1959): change working directory via sys_chdir (kernel-
  // side TASK_OFF_CWD), replacing the R17-M4 local _cwd_buf copy. argc<2
  // resets to "/" (no $HOME support, same default the retired code used).
  // Relative paths and paths of any length up to sys_chdir's own
  // PATH_MAX-1=255 cap are now accepted -- the kernel resolves them
  // against the CURRENT cwd, and rejects a nonexistent or non-directory
  // target itself (-ENOENT/-ENOTDIR), so this builtin no longer needs its
  // own leading-'/' refusal or length gate.
  pub let cd_builtin : () -> u64 !{mem, sysreg} @{fs} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {fs},
      justification: "R86.M1-006 (#1959): cd_builtin calls sys_chdir(argv[1], strlen(argv[1])) when argc>=2, or sys_chdir(\"/\", 1) when argc<2 (no-arg default, matching the retired code's own reset-to-root convention). On success (rax>=0, signed test per the tree's own cp.pdx/dmesg.pdx/cat.pdx negative-errno idiom), emits 'shell cd ok -- path=<X>' via sys_debug_puts(cd_ok_prefix) + sys_getcwd(&_cd_path_scratch, 256) + sys_write(1, ...) + a trailing newline, then returns 0. On failure, emits 'SHELL CD FAIL\\n' via sys_write(2, cd_fail_msg, 14) and returns 1. If sys_getcwd itself fails after a successful chdir (not reachable in practice -- a task's cwd is always a valid vnode once chdir has just set it -- but checked defensively since sys_getcwd's own contract allows -ERANGE/-EFAULT/-ENOENT), the path echo is skipped and only the trailing newline is emitted; the builtin still returns 0 (the chdir itself succeeded).",
      block: {
        lea rax, [rip + argc];
        mov rax, [rax];
        cmp rax, 2;
        jl cd_no_arg;

        // argv[1] pointer -- walker cap 255, not strlen (walker's cap
        // includes room for the NUL; passing raw strlen exhausts the
        // walker before it sees NUL and returns -EFAULT). Matches the
        // rm.pdx/mv.pdx/rootfs_seed.pdx convention documented in
        // src/user/rm.pdx's header ("path_len is a walker CAP, not an
        // exact strlen -- mirrors rootfs_seed.pdx's `mov rsi, 255`
        // usage ahead of sys_mkdir").
        lea rax, [rip + argv_buf];
        mov rdi, [rax + 8];              // path_va = argv[1]
        mov rsi, 255;                    // walker cap
        call sys_chdir;
        jmp cd_check;

      cd_no_arg:
        lea rdi, [rip + cd_root_path];
        mov rsi, 255;                    // walker cap (see comment above)
        call sys_chdir;

      cd_check:
        cmp rax, 0;
        jl cd_fail;

        // Success: "shell cd ok -- path=<X>\n"
        mov rdi, 1;
        lea rsi, [rip + cd_ok_prefix];
        mov rdx, 20;
        call sys_write;

        lea rdi, [rip + _cd_path_scratch];
        mov rsi, 256;
        call sys_getcwd;                 // rax = bytes (incl NUL) or -errno
        cmp rax, 0;
        jl cd_ok_nl;                     // getcwd failed -- skip path echo

        mov r10, rax;
        sub r10, 1;                      // r10 = strlen (excludes NUL)
        mov rdi, 1;
        lea rsi, [rip + _cd_path_scratch];
        mov rdx, r10;
        call sys_write;

      cd_ok_nl:
        mov rdi, 1;
        lea rsi, [rip + nl_char];
        mov rdx, 1;
        call sys_write;

        xor rax, rax;
        ret;

      cd_fail:
        mov rdi, 2;
        lea rsi, [rip + cd_fail_msg];
        mov rdx, 14;
        call sys_write;
        mov rax, 1;
        ret
      }
    } @no_frame

  // clear_builtin() -> u64
  // Emits the ANSI clear-screen + cursor-home escape sequence
  // "\x1b[2J\x1b[H" (7 bytes on the wire) via sys_write(1, ...). Returns 0.
  pub let clear_builtin : () -> u64 !{mem, sysreg} @{fs} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {fs},
      justification: "clear builtin: emits ANSI clear-screen + cursor-home escape sequence (\\x1b[2J\\x1b[H, 7 bytes) via sys_write(1, clear_seq, 7). Mirrors env_builtin's shape. Returns 0.",
      block: {
        mov rdi, 1;
        lea rsi, [rip + clear_seq];
        mov rdx, 7;
        call sys_write;
        xor rax, rax;
        ret
      }
    }

  // rp_build_candidate(prefix_ptr: u64, prefix_len: u64) -> u64
  // R57.M4-005 (#1801): builds "<prefix><argv[0]-name>\0" into the
  // resolved_path .bss slot and returns its address. Parameterized
  // sibling of the original hardcoded-/bin/-prefix build code (same
  // memcpy+strlen shape, same r8-reload discipline), so resolve_path's
  // PATH-prefix loop can reuse one code path for every candidate instead
  // of duplicating the memcpy pair per prefix.
  pub let rp_build_candidate : (u64, u64) -> u64 !{mem} @{} =
    fn (prefix_ptr: u64) (prefix_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R57.M4-005 (#1801): rp_build_candidate(prefix_ptr, prefix_len) copies prefix_ptr[0..prefix_len) then argv_buf[0]'s NUL-terminated name into resolved_path, returning &resolved_path. r10 holds prefix_len across the first memcpy call (memcpy clobbers rax/rcx/rdi/rsi/r8, but not r9/r10) so the second copy's destination offset (resolved_path + prefix_len) can be computed via register-register `add rdi, r10` -- no `add reg, [mem]` per this file's encoder-conservatism discipline. Mirrors the WAVE-9 (#1012) r8-reload fix in the original resolve_prepend code: memcpy's `mov r8, rdi` (dst-save for return) clobbers r8, so argv_buf[0]'s pointer is reloaded into r8 fresh before each use; strlen is relied upon to preserve r8 (per its string.pdx impl, which only touches rax/rcx/rdi) so a single reload before `call strlen` suffices to carry the pointer through both the length computation and the subsequent memcpy's src argument.",
      block: {
        // rdi = prefix_ptr, rsi = prefix_len (SysV arg registers, per the
        // curried fn signature above -- same binding memcpy/strlen use).
        mov r10, rsi;                    // r10 = prefix_len (survives the memcpy call below)
        mov r9, rdi;                     // r9 = prefix_ptr

        lea rdi, [rip + resolved_path];  // dst = &resolved_path
        mov rsi, r9;                     // src = prefix_ptr
        mov rdx, r10;                    // n = prefix_len
        call memcpy;

        // memcpy clobbers r8 (its impl does `mov r8, rdi` to save dst for
        // return, per the WAVE-9 (#1012) fix this mirrors). Reload argv[0]
        // pointer fresh before using r8 again.
        lea rax, [rip + argv_buf];
        mov r8, [rax];
        mov rdi, r8;
        call strlen;                     // rax = strlen(argv[0]); strlen preserves r8
        add rax, 1;                      // include NUL terminator
        mov rdx, rax;                    // n = namelen + 1
        lea rdi, [rip + resolved_path];
        add rdi, r10;                    // dst = resolved_path + prefix_len (register-only add)
        mov rsi, r8;                     // src = argv[0] ptr (preserved by strlen)
        call memcpy;

        lea rax, [rip + resolved_path];
        ret
      }
    } @no_frame

  // dispatch_find_path_env(envp: u64) -> u64
  // paideia-os #2456: scan the envp array (u64 pointer slots, NULL-
  // terminated, execve-abi.md hard cap of 16 entries -- same discipline
  // shell.pdx's shell_home_scan already uses for "HOME=") for an entry
  // whose first 5 bytes match "PATH=". On hit, returns the byte address
  // *after* the '=' (i.e. the value pointer suitable for a colon-split
  // walk). On miss OR envp==0, returns 0 -- caller falls back to the
  // hardcoded /bin:/sbin probe list without probing anything env-sourced
  // first.
  //
  // Byte compare uses the xor-then-mov_b idiom the rest of this codebase
  // installed as the paideia-as #1248 mitigation (see shell_home_cmp,
  // echo_builtin, read_loop). No SYSCALL / CALL inside the hot loop, so
  // no scratch-slot pinning is needed; r10/r11 carry envp base + scan
  // index across the loop and are caller-save (this function is only
  // ever called from resolve_path, which pushes r14/r15 fresh at
  // rp_walk_path and does not read r10/r11 across this CALL).
  //
  // Reserved-label discipline: labels dfpe_-prefixed.
  pub let dispatch_find_path_env : (u64) -> u64 !{mem} @{} =
    fn (envp: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os #2456: dispatch_find_path_env(envp) scans up to 16 envp[] entries (design/user/execve-abi.md cap, mirrored by shell.pdx's shell_home_scan) looking for one whose first 5 bytes match the path_env_key rodata literal 'PATH='. On match returns envp[i]+5 (pointer past '='); on envp==NULL, NULL-terminator hit, cap exhausted, or no match, returns 0. Byte compare uses the xor+mov_b idiom (paideia-as #1248 mitigation, same shape as shell_home_cmp): rax/rdx are zero-extended before each `mov_b` so the wider `cmp rax, rdx` sees only the byte value. No CALL/SYSCALL inside the loop -- r10 (envp base), r11 (scan index), and r14 (candidate entry ptr) survive without any spill. Reserved-label discipline: all labels dfpe_-prefixed.",
      block: {
        cmp rdi, 0;
        je dfpe_miss;
        mov r10, rdi;                    // r10 = envp base
        xor r11, r11;                    // r11 = i

      dfpe_scan:
        cmp r11, 16;                     // execve-abi.md hard cap
        jge dfpe_miss;
        mov r14, [r10 + r11*8];          // r14 = envp[i]
        cmp r14, 0;
        je dfpe_miss;                    // NULL terminator

        xor rcx, rcx;                    // rcx = j (prefix char index)
        lea rdx, [rip + path_env_key];

      dfpe_cmp:
        cmp rcx, 5;
        jge dfpe_hit;
        xor rax, rax;
        mov_b rax, [r14 + rcx*1];
        xor r8, r8;
        mov_b r8, [rdx + rcx*1];
        cmp rax, r8;
        jne dfpe_next;
        add rcx, 1;
        jmp dfpe_cmp;

      dfpe_hit:
        mov rax, r14;
        add rax, 5;                      // skip past '='
        ret;

      dfpe_next:
        add r11, 1;
        jmp dfpe_scan;

      dfpe_miss:
        xor rax, rax;
        ret
      }
    } @no_frame

  // rp_build_seg_candidate(seg_ptr: u64, seg_len: u64) -> u64
  // paideia-os #2456: sibling of rp_build_candidate specialised for
  // envp-sourced PATH segments, which unlike the hardcoded bin_prefix /
  // sbin_prefix rodata (both of which already end in '/') carry NO
  // trailing slash -- a raw colon-split from "PATH=/bin:/sbin:/usr/local
  // /bin" yields "/bin", "/sbin", "/usr/local/bin". Builds
  // "<seg><'/'><argv[0]>\0" into the resolved_path .bss slot and returns
  // its address, matching rp_build_candidate's r8/r10 discipline exactly:
  //   - r10 pins seg_len across the first memcpy (memcpy clobbers
  //     rax/rcx/rdi/rsi/r8 but not r9/r10 per string.pdx impl -- the
  //     WAVE-9 #1012 fix rp_build_candidate documents applies verbatim).
  //   - argv[0] pointer is reloaded fresh into r8 before its next use
  //     because memcpy's `mov r8, rdi` (dst-save for return value) trashes
  //     r8; strlen preserves r8 so a single reload suffices for the
  //     subsequent length+memcpy pair.
  // Caller must guarantee seg_len + 1 + strlen(argv[0]) + 1 <= 320
  // (resolved_path capacity); rp_walk_path enforces this by refusing to
  // call rp_build_seg_candidate on any segment longer than 254 bytes.
  pub let rp_build_seg_candidate : (u64, u64) -> u64 !{mem} @{} =
    fn (seg_ptr: u64) (seg_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os #2456: rp_build_seg_candidate(seg_ptr, seg_len) is the trailing-slash-injecting variant of rp_build_candidate for envp-sourced PATH segments. Copies seg_ptr[0..seg_len) into resolved_path, stores '/' at resolved_path[seg_len], then copies argv_buf[0]'s NUL-terminated name at resolved_path[seg_len+1..]. Returns &resolved_path. r10 = seg_len pinned across the first memcpy (memcpy touches only rax/rcx/rdi/rsi/r8 per string.pdx, so r9/r10 survive). r8 = argv[0] ptr reloaded fresh after strlen (memcpy's `mov r8, rdi` clobbers r8, mirror of the WAVE-9 #1012 fix rp_build_candidate cites). The '/' write goes through cl (low byte of a zero-extended rcx) so no wide-imm move into a memory byte is generated. No new labels; no branches.",
      block: {
        // rdi = seg_ptr, rsi = seg_len (SysV curried arg registers)
        mov r10, rsi;                    // r10 = seg_len (survives memcpy)
        mov r9, rdi;                     // r9 = seg_ptr

        lea rdi, [rip + resolved_path];  // dst = &resolved_path
        mov rsi, r9;                     // src = seg_ptr
        mov rdx, r10;                    // n = seg_len
        call memcpy;

        // Append '/' at resolved_path[seg_len].
        lea rax, [rip + resolved_path];
        add rax, r10;                    // register-only add (no `add reg, [mem]`)
        mov rcx, 0x2F;                   // '/'
        mov [rax], cl;

        // Reload argv[0] pointer into r8 (memcpy clobbers r8 per WAVE-9
        // #1012 fix cited above). strlen preserves r8 -- see string.pdx.
        lea rax, [rip + argv_buf];
        mov r8, [rax];
        mov rdi, r8;
        call strlen;                     // rax = strlen(argv[0])
        add rax, 1;                      // include NUL terminator
        mov rdx, rax;                    // n = namelen + 1
        lea rdi, [rip + resolved_path];
        add rdi, r10;                    // dst = resolved_path + seg_len
        add rdi, 1;                      // dst += 1 (past the '/' just written)
        mov rsi, r8;                     // src = argv[0] ptr
        call memcpy;

        lea rax, [rip + resolved_path];
        ret
      }
    } @no_frame

  // resolve_path() -> u64
  // R57.M4-005 (#1801): PATH-prefix walk for argv[0] without a '/'.
  //
  // Design:
  //   - If argv[0] contains '/': legacy as-is behavior (return argv[0]
  //     unchanged), but still emit the "shell exec ok" fingerprint
  //     (resolved == argv[0] name) so downstream shell smokes observe
  //     that resolve_path executed on this path too.
  //   - Otherwise consult the process's envp for a "PATH=" entry
  //     (paideia-os #2456): dispatch_find_path_env(envp_slot) returns the
  //     value pointer if present, or 0 if envp is NULL / no PATH entry.
  //     On non-zero, walk the value as a colon-separated list of prefixes
  //     (each prefix has NO trailing slash -- rp_build_seg_candidate
  //     injects one before appending argv[0]). Empty segments and
  //     segments longer than 254 bytes are skipped rather than truncated
  //     or probed as CWD-relative.
  //   - If envp yields no PATH (or every env-sourced prefix misses), fall
  //     back to the hardcoded prefix list ["/bin/", "/sbin/"] (per issue
  //     #2456's specified fallback -- /bin comes first, preserving the
  //     pre-#2456 "/bin-first" behaviour every shell smoke has always
  //     observed). For each prefix: build "<prefix><argv[0]>\0" into the
  //     resolved_path .bss slot via rp_build_candidate, then probe it
  //     with sys_stat (SC+ ID 77, rdi=path, rsi=255, rdx=&_resolved_stat_
  //     scratch). rax == 0 -> hit: emit the fingerprint and return
  //     &resolved_path. rax != 0 -> miss: try the next prefix.
  //   - If every prefix (env-sourced AND hardcoded fallback) misses, fall
  //     through to the legacy /bin/-prepend behaviour (rebuild
  //     resolved_path with bin_prefix, no fingerprint) so execve still
  //     runs and fails with the same ENOENT-style failure mode as before
  //     -- no regression on a genuinely missing binary.
  //
  // envp threading: shell._start captures rdx (the design/user/execve-
  // abi.md-defined envp base) into callee-save r12 as its very first
  // instruction, then also stashes it into the envp_slot .bss slot this
  // file owns so resolve_path can read it without depending on r12
  // surviving every intervening call chain. envp==NULL is handled
  // identically to "no PATH entry" and drops straight through to the
  // hardcoded fallback -- init pre-#2456 execve'd /bin/sh with envp=NULL
  // and this file must keep booting under that shape.
  //
  // Uses memcpy and strlen from string.pdx for copying and length
  // computation, and inline `mov rax, 77/12; syscall` for sys_stat /
  // sys_debug_puts (mirrors rootfs_seed.pdx's inline-syscall shape).
  pub let resolve_path : () -> u64 !{mem, sysreg} @{fs} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {fs},
      justification: "R57.M4-005 (#1801) + paideia-os #2456: resolve_path consults envp[PATH=...] via dispatch_find_path_env(envp_slot) FIRST when argv[0] has no '/', walking each colon-separated segment as a probe candidate (rp_build_seg_candidate injects the '/' separator between segment and argv[0], since env-sourced segments do not carry a trailing slash), and only falls back to the hardcoded /bin then /sbin prefix list if envp yields no PATH or every env-sourced segment misses sys_stat (SC+ ID 77). The final legacy /bin/-prepend fallthrough is preserved so execve still fails ENOENT-style on a genuinely missing binary. On a hit (or on the as-is '/'-containing path) emits the 'shell exec ok -- argv[0]=<name> resolved=<path> [legacy: SHELL EXEC OK]' fingerprint via 5 sys_debug_puts calls (SC+ ID 12); the fallthrough-to-/bin/ miss path does NOT emit it. Register plan for the envp segment walk: r14 = current segment start, r15 = scan cursor -- both callee-save, pushed at rp_walk_path and popped before every ret path. rp_build_seg_candidate touches only caller-save regs (r8/r9/r10 per its own justification) and sys_stat's inline `syscall` clobbers only rcx/r11, so r14/r15 survive across both. envp_slot is read via `[rip + envp_slot]` (populated by shell._start before it enters main_loop; NULL if the shell was execve'd without envp). Capabilities widen from {} to {fs} (sys_stat is fs-gated, same as sys_open/sys_getdents in ls.pdx) and effects widen from {mem} to {mem, sysreg} (every SYSCALL clobbers rcx/r11 and the debug_puts/stat calls are real SYSCALLs, not just callee calls). Reserved-label discipline: all internal labels are rp_-prefixed (resolve_scan/resolve_prepend/resolve_asis's bare-word-adjacent names predate this fix; rp_scan/rp_asis/rp_walk_path/rp_hit/rp_env_*/rp_hardcoded replace them here) since bare `walk`/`loop`/etc. are paideia-as keywords.",
      block: {
        lea rax, [rip + argv_buf];
        mov r8, [rax];
        mov r9, r8;
rp_scan:
        xor rax, rax;
        mov al, [r9];
        and rax, 0xff;
        cmp rax, 0;
        je rp_walk_path;
        cmp rax, 0x2F;
        je rp_asis;
        add r9, 1;
        jmp rp_scan;

rp_asis:
        // argv[0] already contains '/': legacy as-is behavior, plus the
        // hit fingerprint (resolved == argv[0] name) so this path is
        // also observable downstream.
        lea rdi, [rip + sh_exec_ok_prefix];
        mov rsi, 25;
        mov rax, 12;
        syscall;

        lea rax, [rip + argv_buf];
        mov r8, [rax];
        mov rdi, r8;
        call strlen;
        mov rsi, rax;
        lea rax, [rip + argv_buf];
        mov r8, [rax];
        mov rdi, r8;
        mov rax, 12;
        syscall;

        lea rdi, [rip + sh_exec_ok_mid];
        mov rsi, 10;
        mov rax, 12;
        syscall;

        lea rax, [rip + argv_buf];
        mov r8, [rax];
        mov rdi, r8;
        call strlen;
        mov rsi, rax;
        lea rax, [rip + argv_buf];
        mov r8, [rax];
        mov rdi, r8;
        mov rax, 12;
        syscall;

        lea rdi, [rip + sh_exec_ok_tail];
        mov rsi, 25;
        mov rax, 12;
        syscall;

        lea rax, [rip + argv_buf];
        mov rax, [rax];
        ret;

rp_walk_path:
        // paideia-os #2456: consult envp[PATH=...] first; on miss (envp
        // NULL, no PATH entry, or every env-sourced segment probed and
        // missed) drop through to the hardcoded /bin then /sbin fallback,
        // then the legacy /bin fallthrough. r14/r15 are callee-save --
        // push here so the env-seg loop can carry (seg_start, scan) in
        // them across rp_build_seg_candidate + inline sys_stat without
        // spilling to .bss on every iteration.
        push r14;
        push r15;

        lea rax, [rip + envp_slot];
        mov rdi, [rax];
        call dispatch_find_path_env;     // rax = value ptr, or 0 on miss
        cmp rax, 0;
        je rp_hardcoded;                 // no envp PATH -- try /bin then /sbin

        mov r14, rax;                    // r14 = current segment start

      rp_env_seg_top:
        mov r15, r14;                    // r15 = segment scan cursor
      rp_env_seg_scan:
        xor rax, rax;
        mov_b rax, [r15];
        cmp rax, 0;
        je rp_env_seg_last;              // end of PATH string
        cmp rax, 0x3A;                   // ':'
        je rp_env_seg_try;
        add r15, 1;
        jmp rp_env_seg_scan;

      rp_env_seg_try:
        // Segment is [r14, r15). Compute length in rcx.
        mov rcx, r15;
        sub rcx, r14;
        cmp rcx, 0;
        je rp_env_seg_advance;           // empty segment (":" or "::") -- skip
        cmp rcx, 254;
        ja rp_env_seg_advance;           // too long for scratch -- skip
        mov rdi, r14;                    // seg_ptr
        mov rsi, rcx;                    // seg_len
        call rp_build_seg_candidate;

        lea rdi, [rip + resolved_path];
        mov rsi, 255;
        lea rdx, [rip + _resolved_stat_scratch];
        mov rax, 77;
        syscall;
        cmp rax, 0;
        je rp_env_hit;

      rp_env_seg_advance:
        mov r14, r15;
        add r14, 1;                      // step past the colon
        jmp rp_env_seg_top;

      rp_env_seg_last:
        // Final segment [r14, r15) with no trailing colon.
        mov rcx, r15;
        sub rcx, r14;
        cmp rcx, 0;
        je rp_hardcoded;
        cmp rcx, 254;
        ja rp_hardcoded;
        mov rdi, r14;
        mov rsi, rcx;
        call rp_build_seg_candidate;

        lea rdi, [rip + resolved_path];
        mov rsi, 255;
        lea rdx, [rip + _resolved_stat_scratch];
        mov rax, 77;
        syscall;
        cmp rax, 0;
        je rp_env_hit;
        // All env-sourced segments missed -- fall into the hardcoded
        // fallback below.

      rp_hardcoded:
        // Hardcoded fallback: /bin then /sbin (paideia-os #2456's
        // specified fallback). /bin comes first, preserving the pre-
        // #2456 /bin-first observable behaviour.
        lea rdi, [rip + bin_prefix];
        mov rsi, 5;
        call rp_build_candidate;

        lea rdi, [rip + resolved_path];
        mov rsi, 255;
        lea rdx, [rip + _resolved_stat_scratch];
        mov rax, 77;
        syscall;
        cmp rax, 0;
        je rp_env_hit;

        lea rdi, [rip + sbin_prefix];
        mov rsi, 6;
        call rp_build_candidate;

        lea rdi, [rip + resolved_path];
        mov rsi, 255;
        lea rdx, [rip + _resolved_stat_scratch];
        mov rax, 77;
        syscall;
        cmp rax, 0;
        je rp_env_hit;

        // Every candidate missed: legacy /bin/-prepend fallthrough. Do
        // NOT emit the fingerprint here -- only a genuine hit emits it.
        // execve still fails ENOENT-style on the /bin/<name> path just
        // as before #2456.
        lea rdi, [rip + bin_prefix];
        mov rsi, 5;
        call rp_build_candidate;
        pop r15;
        pop r14;
        ret;

      rp_env_hit:
        // sys_stat succeeded: pop the env-walk callee-saves, then reuse
        // the shared fingerprint emitter at rp_hit (which reads
        // resolved_path fresh -- no register state is inherited from the
        // walk beyond what rp_hit itself sets up).
        pop r15;
        pop r14;
        jmp rp_hit;

rp_hit:
        // sys_stat succeeded on resolved_path (rax == 0): emit the
        // fingerprint, then return &resolved_path.
        lea rdi, [rip + sh_exec_ok_prefix];
        mov rsi, 25;
        mov rax, 12;
        syscall;

        lea rax, [rip + argv_buf];
        mov r8, [rax];
        mov rdi, r8;
        call strlen;
        mov rsi, rax;
        lea rax, [rip + argv_buf];
        mov r8, [rax];
        mov rdi, r8;
        mov rax, 12;
        syscall;

        lea rdi, [rip + sh_exec_ok_mid];
        mov rsi, 10;
        mov rax, 12;
        syscall;

        lea rdi, [rip + resolved_path];
        mov r8, rdi;
        call strlen;
        mov rsi, rax;
        mov rdi, r8;
        mov rax, 12;
        syscall;

        lea rdi, [rip + sh_exec_ok_tail];
        mov rsi, 25;
        mov rax, 12;
        syscall;

        lea rax, [rip + resolved_path];
        ret
      }
    } @no_frame

  // exec_child() -> u64 !{mem, sysreg, sysprivcap} @{fs, sched, cap}
  // Fork and execve argv[0] with NULL-terminated argv_buf, forwarding the
  // shell's own envp_slot (paideia-os#2460; was hardcoded NULL). Parent
  // waits via sys_wait4.
  // Returns 0 on child spawned, 1 on error (argc==0 or fork failed).
  //
  // R58.M5-001 (#1805): before resolve_path/execve, the child branch scans
  // argv_buf for the tokenizer's redirect tokens (which point at
  // Tokenizer::redirect_gt / redirect_gtgt / redirect_lt rodata — see
  // tokenizer.pdx header note) and, for each one found: opens the
  // following token (the target filename) with the matching flags,
  // sys_dup2's the new fd onto the target fd (1 for '>'/'>>', 0 for '<'),
  // closes the new fd, and removes both the operator and filename tokens
  // from argv_buf (left-compact) so execve never sees them. This scan is
  // child-only (post-fork, separate address space via COW) — the parent's
  // argv_buf is untouched.
  // paideia-os#2451 (Wave U, 2026-09-13) addendum: exec_child now scans
  // argv_buf for a pipe ('|') token BEFORE forking. On a hit it branches
  // to exec_child_pipeline_entry (defined at the tail of this function's
  // body, after exec_child_err) instead of the single-fork path below --
  // see that label's own header comment for the two-fork + sys_pipe
  // strategy. The redirect scan (child-only, below) also gained a
  // "2>&1" case (content-compare against Tokenizer::dup2_stderr_op)
  // that issues a bare sys_dup2(1, 2) and consumes just its own token
  // (no following filename, unlike >, >>, <).
  pub let exec_child : () -> u64 !{mem, sysreg, sysprivcap} @{fs, sched, cap} =
    fn () -> unsafe {
      effects: {mem, sysreg, sysprivcap}, capabilities: {fs, sched, cap},
      justification: "R17-m3-005 (#625) + R17-m3-006 (#626) + R58.M5-001 (#1805) + paideia-os#2460: exec_child forks + execves argv[0] with NULL-terminated argv_buf, envp=envp_slot (the shell's own inherited environment; was hardcoded NULL before #2460 -- see the execve callsite's own comment); parent waits via sys_wait4 into child_wait_status. On fork error or argc==0 returns 1; on execve failure child calls sys_exit(127). Reads argc/argv_buf from Tokenizer .bss (linked symbols). Callees are syscall shims (no SysV pad needed). R17-m3-006 (#626): child branch calls resolve_path to prepend /bin/ when argv[0] has no slash. R58.M5-001 (#1805): child branch additionally runs an rd_-prefixed redirect scan (see block below) between the fork and resolve_path/execve. Register plan for the scan: r12=argc (loaded once), r13=read_idx, r14=write_idx, r15=current token ptr / target_fd carrier, rbx=fd returned by sys_open (needed across the sys_dup2 call so sys_close can close the ORIGINAL fd, not dup2's return value) -- all six are callee-saved and untouched by strlen/memcmp (touch only rax/rcx/rdx/rdi/rsi/r8) and by the sys_open/sys_dup2/sys_close/sys_debug_puts stubs (each is `mov rax,N; syscall; ret`, touching only rax plus whatever the SYSCALL instruction itself clobbers -- rcx/r11 -- never r12-r15/rbx). rax/rcx/rdx/rdi/rsi/r8/r9/r10/r11 are NOT trusted to survive any call or inline `syscall` in this scan, per dispatch.pdx's own documented r9/r10 syscall-shuffle risk (see echo_builtin's justification above) -- every use of argv_buf[i] is reloaded fresh via `lea rax,[rip+argv_buf]; mov r_, [rax+idx*8]` immediately before each use rather than cached across a call, mirroring resolve_path's rp_hit reload discipline. Detection is strlen+memcmp against Tokenizer's redirect_gt/redirect_gtgt/redirect_lt rodata (not a raw byte compare), per the issue's explicit instruction, so the check stays coupled to the same constants the tokenizer used to build the token rather than to an assumed byte value. Reserved-label discipline: every new label is rd_-prefixed.",
      block: {
        // Guard: argc == 0 → error
        lea rax, [rip + argc];
        mov rax, [rax];
        cmp rax, 0;
        je exec_child_err;

        // paideia-os#2451: scan for a pipe token BEFORE forking -- a
        // pipeline needs two forks + an inter-process fd, an entirely
        // different shape from the single-fork path below. Parent-side
        // scan (unlike the redirect scan, which is child-only): if no
        // '|' is found, argv_buf/argc are untouched and control falls
        // straight through to the pre-existing single-command path.
        // r12 = argc (parked here; strlen/memcmp never touch r12) and
        // doubles as exec_child_pipeline_entry's own argc input. r10 =
        // scan index / pipe_idx on a hit.
        mov r12, rax;             // r12 = argc
        xor r10, r10;             // r10 = scan index
      ec_pipe_scan:
        cmp r10, r12;
        jge ec_no_pipe;
        lea r11, [rip + argv_buf];
        mov rdi, [r11 + r10*8];
        call strlen;
        cmp rax, 1;
        jne ec_pipe_scan_next;
        lea r11, [rip + argv_buf];
        mov rdi, [r11 + r10*8];
        lea rsi, [rip + pipe_op];
        mov rdx, 1;
        call memcmp;
        cmp rax, 0;
        je ec_typed_gate_check;         // R121.M5 #2499: route through
                                        // typed-path gate first; falls
                                        // through to legacy exec_child_
                                        // pipeline_entry when the gate is
                                        // off (SHELL_TYPED_PIPE env var
                                        // absent or != "1"). r10 =
                                        // pipe_idx, r12 = argc live
                                        // across the gate check (r10 is
                                        // preserved by an explicit push;
                                        // r12 is callee-save through
                                        // tokenizer_find_env per its
                                        // own header contract).
      ec_pipe_scan_next:
        add r10, 1;
        jmp ec_pipe_scan;
      ec_no_pipe:
        mov rax, r12;             // restore argc into rax for the code below

        // NULL-terminate argv_buf[argc] = 0
        xor rcx, rcx;
        lea r11, [rip + argv_buf];
        mov [r11 + rax*8], rcx;

        // fork
        call sys_fork;
        cmp rax, 0;
        jl exec_child_err;
        je exec_child_do_execve;

        // parent: wait4(pid, &child_wait_status, 0, NULL). rax has pid.
        mov rdi, rax;
        lea rsi, [rip + child_wait_status];
        xor rdx, rdx;
        xor rcx, rcx;
        call sys_wait4;
        ret;

exec_child_do_execve:
        // R58.M5-001 (#1805): redirect scan + left-compact, child-only.
        push r12;
        push r13;
        push r14;
        push r15;
        push rbx;

        lea rax, [rip + argc];
        mov r12, [rax];         // r12 = argc
        xor r13, r13;           // r13 = read_idx = 0
        xor r14, r14;           // r14 = write_idx = 0

rd_loop:
        cmp r13, r12;
        jge rd_compact_done;

        lea rax, [rip + argv_buf];
        mov r15, [rax + r13*8]; // r15 = argv_buf[read_idx] (survives strlen/memcmp — neither touches r15)
        mov rdi, r15;
        call strlen;            // rax = strlen(token)
        cmp rax, 4;
        je rd_try_dup2_stderr;
        cmp rax, 2;
        je rd_try_gtgt;
        cmp rax, 1;
        jne rd_keep_token;

        // len == 1: could be '>' or '<'
        mov rdi, r15;
        lea rsi, [rip + redirect_gt];
        mov rdx, 1;
        call memcmp;
        cmp rax, 0;
        je rd_try_gt_single;

        mov rdi, r15;
        lea rsi, [rip + redirect_lt];
        mov rdx, 1;
        call memcmp;
        cmp rax, 0;
        je rd_try_lt;

        jmp rd_keep_token;

rd_try_dup2_stderr:
        // paideia-os#2451: "2>&1" -- dup2(1, 2), no following filename
        // token to consume (unlike >, >>, < which all take a target).
        mov rdi, r15;
        lea rsi, [rip + dup2_stderr_op];
        mov rdx, 4;
        call memcmp;
        cmp rax, 0;
        jne rd_keep_token;
        mov rdi, 1;              // oldfd = stdout
        mov rsi, 2;              // newfd = stderr
        call sys_dup2;
        add r13, 1;              // consumed just this one token
        jmp rd_loop;

rd_try_gtgt:
        mov rdi, r15;
        lea rsi, [rip + redirect_gtgt];
        mov rdx, 2;
        call memcmp;
        cmp rax, 0;
        jne rd_keep_token;
        // matched ">>": append to stdout
        mov r15, 1;                     // r15 = target_fd (stdout)
        mov rsi, 0x241;                 // O_WRONLY|O_CREAT|O_APPEND (vfs_open.pdx: 0x01|0x40|0x200)
        jmp rd_open_common;

rd_try_gt_single:
        mov r15, 1;                     // r15 = target_fd (stdout)
        mov rsi, 0xC1;                  // O_WRONLY|O_CREAT|O_TRUNC (vfs_open.pdx: 0x01|0x40|0x80)
        jmp rd_open_common;

rd_try_lt:
        mov r15, 0;                     // r15 = target_fd (stdin)
        mov rsi, 0;                     // O_RDONLY
        jmp rd_open_common;

rd_open_common:
        // rsi already holds open() flags (set by the caller above). Need
        // a filename token following the operator: argv_buf[read_idx+1].
        mov rax, r13;
        add rax, 1;
        cmp rax, r12;
        jge rd_apply_no_target;         // operator with nothing after it: drop it alone

        lea rcx, [rip + argv_buf];
        mov rdi, [rcx + rax*8];         // rdi = filename ptr (sys_open arg1)
        mov rdx, 0x1A4;                 // mode 0644 (only meaningful with O_CREAT)
        call sys_open;                  // rax = new fd, or negative errno
        cmp rax, 0;
        jl rd_apply_open_err;
        mov rbx, rax;                   // rbx = new fd (survives sys_dup2/sys_close: neither touches rbx)

        mov rdi, rbx;
        mov rsi, r15;                   // newfd = target_fd
        call sys_dup2;
        mov rdi, rbx;                   // close the ORIGINAL new fd, not sys_dup2's return value
        call sys_close;

        // Fingerprint: "shell redirect ok -- argv[0]=<name> op=<op> file=<path> [legacy: SHELL REDIRECT OK]\n"
        lea rdi, [rip + sh_redirect_ok_prefix];
        mov rsi, 29;
        mov rax, 12;
        syscall;

        lea rax, [rip + argv_buf];
        mov r8, [rax];                  // argv[0] ptr (index 0 is stable across compaction — see justification)
        mov rdi, r8;
        call strlen;
        mov rsi, rax;
        lea rax, [rip + argv_buf];
        mov r8, [rax];
        mov rdi, r8;
        mov rax, 12;
        syscall;

        lea rdi, [rip + sh_redirect_ok_mid_op];
        mov rsi, 4;
        mov rax, 12;
        syscall;

        lea rax, [rip + argv_buf];
        mov r8, [rax + r13*8];          // op token ptr (still the operator: read_idx untouched so far)
        mov rdi, r8;
        call strlen;
        mov rsi, rax;
        lea rax, [rip + argv_buf];
        mov r8, [rax + r13*8];
        mov rdi, r8;
        mov rax, 12;
        syscall;

        lea rdi, [rip + sh_redirect_ok_mid_file];
        mov rsi, 6;
        mov rax, 12;
        syscall;

        mov rcx, r13;
        add rcx, 1;
        lea rax, [rip + argv_buf];
        mov r8, [rax + rcx*8];          // filename token ptr
        mov rdi, r8;
        call strlen;
        mov rsi, rax;
        mov rcx, r13;
        add rcx, 1;
        lea rax, [rip + argv_buf];
        mov r8, [rax + rcx*8];
        mov rdi, r8;
        mov rax, 12;
        syscall;

        lea rdi, [rip + sh_redirect_ok_tail];
        mov rsi, 29;
        mov rax, 12;
        syscall;

        add r13, 2;                     // consumed operator + filename; neither copied forward
        jmp rd_loop;

rd_apply_open_err:
        // sys_open failed: drop the malformed redirect silently (M0
        // best-effort), no fingerprint.
        add r13, 2;
        jmp rd_loop;

rd_apply_no_target:
        // operator with no following token: drop just the operator.
        add r13, 1;
        jmp rd_loop;

rd_keep_token:
        // not a redirect: left-compact copy argv_buf[read_idx] -> argv_buf[write_idx].
        lea rax, [rip + argv_buf];
        mov [rax + r14*8], r15;
        add r13, 1;
        add r14, 1;
        jmp rd_loop;

rd_compact_done:
        // NUL-pointer-terminate the compacted argv at write_idx, and keep
        // argc consistent with the new (child-local) count.
        lea rax, [rip + argv_buf];
        xor rcx, rcx;
        mov [rax + r14*8], rcx;
        lea rax, [rip + argc];
        mov [rax], r14;

        // #1805 debugger finding: if EVERY token was consumed by the
        // redirect scan (e.g. line was `> /tmp/x` with no command), the
        // post-compaction argc is 0 and resolve_path would deref
        // argv_buf[0]==NULL. Exit the child cleanly with 127 instead.
        cmp r14, 0;
        je rd_apply_empty_argv;

        pop rbx;
        pop r15;
        pop r14;
        pop r13;
        pop r12;

        // child: execve(resolve_path(), &argv_buf[0], envp_slot)
        // paideia-os#2460: forward the shell's own inherited envp to the
        // child instead of NULL -- envp_slot is populated once at
        // shell._start (see its own header) from the execve-abi.md rdx
        // envp argument the shell itself received, and resolve_path
        // already reads this same slot for its PATH= lookup, so every
        // exec_child callsite threading it through here is consistent
        // with the one value already in scope.
        call resolve_path;
        mov rdi, rax;
        lea rsi, [rip + argv_buf];
        lea rax, [rip + envp_slot];
        mov rdx, [rax];
        call sys_execve;
        // paideia-os #2468: execve returned → failed. Emit
        // "sh: <argv[0]>: not found\n" to fd 2 before sys_exit(127).
        // Inline strlen(argv[0]) into rcx (cap 255); reload argv_buf[0]
        // fresh since every intervening syscall clobbers caller-save regs.
        mov rdi, 2;
        lea rsi, [rip + sh_err_prefix];
        mov rdx, 4;                          // "sh: "
        mov rax, 1;
        syscall;
        lea rax, [rip + argv_buf];
        mov rbx, [rax];                      // rbx = argv_buf[0]
        xor rcx, rcx;
      ec_notfound_strlen:
        xor rax, rax;
        mov_b rax, [rbx + rcx*1];
        cmp rax, 0;
        je  ec_notfound_strlen_done;
        add rcx, 1;
        cmp rcx, 255;
        jae ec_notfound_strlen_done;
        jmp ec_notfound_strlen;
      ec_notfound_strlen_done:
        mov rdi, 2;
        mov rsi, rbx;
        mov rdx, rcx;
        mov rax, 1;
        syscall;
        mov rdi, 2;
        lea rsi, [rip + sh_err_suffix];
        mov rdx, 12;                         // ": not found\n"
        mov rax, 1;
        syscall;
        mov rdi, 127;
        call sys_exit;
        hlt;

rd_apply_empty_argv:
        // Post-compaction argc == 0 — no command left to exec. Restore
        // callee-save regs, then sys_exit(127) in the child (mirrors the
        // "execve returned -> failed" exit code above).
        pop rbx;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        mov rdi, 127;
        call sys_exit;
        hlt;

exec_child_err:
        mov rax, 1;
        ret;

      // ==========================================================================
      // paideia-os#2451 (wire-up) + #2470/#2473 (R119.M3 wire evidence +
      // completeness audit): two-command pipeline ("cmd1 | cmd2").
      //
      // Reached from ec_pipe_scan above with r10 = pipe_idx, r12 = argc.
      // Strategy: sys_pipe for an fd pair, fork the LEFT (writer) child
      // first, then fork the RIGHT (reader) child from the still-intact
      // parent argv_buf, then the parent closes both pipe ends and waits
      // on both children. Each child mutates its OWN COW copy of
      // argv_buf/argc (truncate-in-place for LEFT, shift-and-truncate
      // for RIGHT) so resolve_path/sys_execve can stay argument-free
      // exactly like the pre-existing single-command path -- neither
      // child's mutation is visible to the parent or its sibling.
      //
      // R119.M3 audit (2026-09-23, this landing): at #2451 wire-up time
      // sys_pipe was floor-only (silently returning -ENOSYS from the
      // syscall shim's default-branch of the dispatcher's cmp-chain);
      // R119.M1 (#2471, commit 30e794f) landed sys_pipe's real kernel
      // body (core/syscall/handlers/sys_pipe.pdx + pipe_backend.pdx +
      // the dispatch arm). The wire-up here was inspected against the
      // five R119.M3 correctness requirements (sys_pipe call shape,
      // two forks, both children's dup2/close pairs, parent close-then-
      // wait4-BOTH ordering) and found already correct -- no code shape
      // needed to change. The only wire diff for R119.M3 is the
      // sh_pipe_ok_msg witness emission in the parent branch below,
      // since the wait4-both-children ordering the plan flagged is the
      // exact ordering already implemented: parent closes both pipe
      // ends first (so the pipe reaches EOF once both children close
      // their own copies), then sys_wait4(left_pid) then
      // sys_wait4(right_pid). Because sys_wait4 blocks until the named
      // child terminates, and the left (writer) cannot terminate until
      // it has drained its stdout into the pipe buffer or received
      // -EPIPE from a right-side early exit, no output can be lost by
      // reaping in this order; and because both wait4 calls complete
      // before the parent returns 0, shell.pdx's main_loop cannot
      // reprint the prompt while either child is still buffering.
      //
      // Register plan (5 callee-save pushes = 40 bytes; entry rsp%16==8
      // (fresh from exec_child's own entry, no prior pushes on this
      // control-flow branch) -> after 5 pushes rsp%16==0 for every
      // nested SysV call in every branch, parent and both children):
      //   r12 = pipe_idx (LEFT child's own truncation point; dead in
      //         the parent once right_start/right_count are computed,
      //         so the parent reuses it to carry right_pid)
      //   r13 = right_start = pipe_idx + 1 (RIGHT child only)
      //   r14 = right_count = argc - right_start (RIGHT child only)
      //   r15 = read_fd  (parent close + RIGHT child dup2 target)
      //   rbx = write_fd (parent close + LEFT child dup2 target)
      //   rbp = left_pid (parent only, set after the first fork)
      // ==========================================================================
      exec_child_pipeline_entry:
        push rbx;
        push rbp;
        push r13;
        push r14;
        push r15;

        mov r13, r10;
        add r13, 1;              // right_start = pipe_idx + 1
        mov r14, r12;
        sub r14, r13;            // right_count = argc - right_start
        mov r12, r10;            // r12 = pipe_idx (argc no longer needed)

        lea rdi, [rip + _dp_pipe_fds];
        call sys_pipe;
        cmp rax, 0;
        jl exec_child_pipeline_err;

        lea r11, [rip + _dp_pipe_fds];
        mov r15, [r11 + 0];      // read_fd
        mov rbx, [r11 + 8];      // write_fd

        // Fork LEFT (writer) child.
        call sys_fork;
        cmp rax, 0;
        jl exec_child_pipeline_err;
        je exec_child_pipeline_left_child;
        mov rbp, rax;            // parent: left_pid

        // Fork RIGHT (reader) child from the parent's still-intact argv_buf.
        call sys_fork;
        cmp rax, 0;
        jl exec_child_pipeline_err;
        je exec_child_pipeline_right_child;

        // Parent: rax = right_pid. pipe_idx (r12) is dead on this path;
        // reuse it to carry right_pid across the close/wait4 calls
        // below (all caller-save regs are clobbered by those calls).
        mov r12, rax;
        mov rdi, r15;
        call sys_close;
        mov rdi, rbx;
        call sys_close;

        mov rdi, rbp;
        lea rsi, [rip + child_wait_status];
        xor rdx, rdx;
        xor rcx, rcx;
        call sys_wait4;

        mov rdi, r12;
        lea rsi, [rip + child_wait_status];
        xor rdx, rdx;
        xor rcx, rcx;
        call sys_wait4;

        // paideia-os #2470 / #2473 (R119.M3): witness fingerprint. Both
        // children were reaped by the two wait4 calls above -- emitting
        // here is byte-proof that the entire two-stage pipeline ran to
        // completion (see sh_pipe_ok_msg's header comment for why this
        // static-trace witness stands in for #2494's blocked dynamic
        // output verification). sys_debug_puts is !{sysreg}@{} so this
        // fits exec_child's existing {mem,sysreg,sysprivcap} effects
        // and {fs,sched,cap} capability rows without widening.
        lea rdi, [rip + sh_pipe_ok_msg];
        mov rsi, 34;
        call sys_debug_puts;

        xor rax, rax;
        pop r15;
        pop r14;
        pop r13;
        pop rbp;
        pop rbx;
        ret;

      exec_child_pipeline_left_child:
        // Truncate this child's own argv_buf/argc copy at pipe_idx,
        // wire write_fd onto stdout, drop both original pipe fds.
        lea r11, [rip + argv_buf];
        xor rcx, rcx;
        mov [r11 + r12*8], rcx;
        lea r11, [rip + argc];
        mov [r11], r12;

        mov rdi, rbx;
        mov rsi, 1;
        call sys_dup2;
        mov rdi, r15;
        call sys_close;
        mov rdi, rbx;
        call sys_close;

        // paideia-os#2460: forward envp_slot instead of NULL (see the
        // single-command execve site's comment above for rationale).
        call resolve_path;
        mov rdi, rax;
        lea rsi, [rip + argv_buf];
        lea rax, [rip + envp_slot];
        mov rdx, [rax];
        call sys_execve;
        mov rdi, 127;
        call sys_exit;
        hlt;

      exec_child_pipeline_right_child:
        // Shift argv_buf[right_start .. right_start+right_count) down
        // to argv_buf[0 .. right_count) in this child's own COW copy,
        // NUL-terminate, wire read_fd onto stdin, drop both original
        // pipe fds.
        xor rcx, rcx;            // i = 0
      ecp_rc_shift:
        cmp rcx, r14;
        jge ecp_rc_shift_done;
        lea r11, [rip + argv_buf];
        mov r9, r13;
        add r9, rcx;
        mov r8, [r11 + r9*8];
        mov [r11 + rcx*8], r8;
        add rcx, 1;
        jmp ecp_rc_shift;
      ecp_rc_shift_done:
        lea r11, [rip + argv_buf];
        xor rcx, rcx;
        mov [r11 + r14*8], rcx;
        lea r11, [rip + argc];
        mov [r11], r14;

        mov rdi, r15;
        mov rsi, 0;
        call sys_dup2;
        mov rdi, r15;
        call sys_close;
        mov rdi, rbx;
        call sys_close;

        // paideia-os#2460: forward envp_slot instead of NULL (see the
        // single-command execve site's comment above for rationale).
        call resolve_path;
        mov rdi, rax;
        lea rsi, [rip + argv_buf];
        lea rax, [rip + envp_slot];
        mov rdx, [rax];
        call sys_execve;
        mov rdi, 127;
        call sys_exit;
        hlt;

      exec_child_pipeline_err:
        pop r15;
        pop r14;
        pop r13;
        pop rbp;
        pop rbx;
        mov rax, 1;
        ret;

      // ==========================================================================
      // R121.M5 (paideia-os #2499) -- typed-pipeline gate check.
      //
      // Reached from ec_pipe_scan on a `|` hit (r10 = pipe_idx, r12 = argc).
      // Scans envp for a `SHELL_TYPED_PIPE=1` entry. On hit, emits the
      // sh_typed_pipe_gate_msg + sh_typed_pipe_gap_msg fingerprints and
      // jumps into exec_child_pipeline_typed_entry (defined below). On
      // any miss (env absent, value != "1"), falls straight through to
      // the legacy exec_child_pipeline_entry so the R119.M3 fix's
      // behavior is preserved byte-for-byte when the typed path is off.
      //
      // tokenizer_find_env's contract (per src/user/tokenizer.pdx §tfe_
      // header): rdi = envp base, rsi = name_ptr, rdx = name_len; touches
      // only caller-save regs (r8/r9/r10/r11/rax/rcx clobbered); r12-r15
      // and rbx preserved. r10 is EXPLICITLY listed as clobbered ("r10 =
      // envp base parked"), so we must save it across the call. r12 is
      // safe. Alignment: exec_child is @no_frame; ec_pipe_scan has run
      // no pushes; entry rsp%16==8. One push (r10) drops rsp%16 to 0 for
      // the tokenizer_find_env CALL. After pop r10 we are back at
      // rsp%16==8, matching the state both exec_child_pipeline_entry and
      // exec_child_pipeline_typed_entry assume at their own labels.
      //
      // Encoder-gap posture: no `test rN,rN` (uses `cmp rN,0`); no `and
      // rN, imm64`; the value-byte load uses the `xor rN,rN; mov_b rN,[..]`
      // idiom that dodges paideia-as #1248. Reserved-label discipline:
      // ec_typed_-prefixed to distinguish from the pre-existing ec_pipe_
      // scan and exec_child_pipeline_ labels.
      // ==========================================================================
      ec_typed_gate_check:
        push r10;                         // preserve pipe_idx across
                                          // tokenizer_find_env; r12 (argc)
                                          // survives per the callee's own
                                          // header contract.
        lea rdi, [rip + envp_slot];
        mov rdi, [rdi];                   // rdi = envp base (may be 0;
                                          // tokenizer_find_env treats 0 as
                                          // a miss and returns 0).
        lea rsi, [rip + shell_typed_pipe_name];
        mov rdx, 16;                      // shell_typed_pipe_name_len
        call tokenizer_find_env;
        pop r10;                          // restore pipe_idx.
        cmp rax, 0;
        je exec_child_pipeline_entry;     // env var absent -> legacy path.

        // rax = pointer past the `=`; check the value byte == '1' (0x31).
        // Any other value ('0', 'y', empty '\0', ...) also drops us onto
        // the legacy path so the gate is strictly opt-in.
        mov rcx, rax;
        xor rax, rax;
        mov_b rax, [rcx];
        cmp rax, 49;                      // '1'
        jne exec_child_pipeline_entry;

        // Gate is on: emit the two witness fingerprints and fall into
        // the typed body. sys_debug_puts clobbers only rax/rcx/r11 per
        // this file's documented syscall-clobber convention (resolve_path's
        // own justification); r10/r12 survive both emits.
        lea rdi, [rip + sh_typed_pipe_gate_msg];
        mov rsi, 25;                      // sh_typed_pipe_gate_msg_len
        mov rax, 12;
        syscall;

        lea rdi, [rip + sh_typed_pipe_gap_msg];
        mov rsi, 30;                      // sh_typed_pipe_gap_msg_len
        mov rax, 12;
        syscall;
        jmp exec_child_pipeline_typed_entry;

      // ==========================================================================
      // R121.M5 (paideia-os #2499) -- typed-pipeline two-fork entry.
      //
      // Reached from ec_typed_gate_check (r10 = pipe_idx, r12 = argc) after
      // the SHELL_TYPED_PIPE=1 gate fires. Mirrors exec_child_pipeline_entry
      // (paideia-os #2451) byte-for-byte MINUS the sys_pipe call and the
      // dup2/close pairs in each child branch: the typed path routes
      // bytes through KIND_PIPELINE_EDGE caps (via SC+ 131/132), not
      // through fd 0/1, so the children keep the parent's inherited
      // stdout wired to serial and every send/recv rides the syscall
      // path directly.
      //
      // CAP-MINT GAP (see sh_typed_pipe_ok_msg header note above): at
      // M5 the shell mints NO KIND_PIPELINE_EDGE caps because the
      // requisite sys_pipe_edge_mint / sys_pipe_edge_bind syscalls do
      // not yet exist; the canaries pdx-produce / pdx-consume therefore
      // observe -EBADF on every sys_pipe_edge_{send,recv} attempt
      // against the un-seeded cap_table slots they hardcode. When the
      // mint plumbing lands (R121.M5-followup or R123), a mint+bind
      // block inserts here BETWEEN the wait-plan setup and the first
      // fork; nothing else in this body needs to change.
      //
      // Register plan (5 callee-save pushes = 40 bytes; entry rsp%16==8
      // after ec_typed_gate_check's balanced push/pop -> after 5 pushes
      // rsp%16==0 for every nested SysV call, matching
      // exec_child_pipeline_entry's own register discipline):
      //   r12 = pipe_idx (LEFT child's own truncation point; dead in
      //         parent once right_start/right_count are computed, then
      //         reused to carry right_pid across the two wait4 calls)
      //   r13 = right_start = pipe_idx + 1 (RIGHT child only)
      //   r14 = right_count = argc - right_start (RIGHT child only)
      //   r15 = UNUSED at M5 (was read_fd in the legacy body; retained
      //         as a placeholder so the follow-up mint+bind block can
      //         park the LEFT edge cap_slot here without renumbering)
      //   rbx = UNUSED at M5 (was write_fd; retained for the RIGHT
      //         edge cap_slot in the follow-up landing)
      //   rbp = left_pid (parent only, set after the first fork)
      // ==========================================================================
      exec_child_pipeline_typed_entry:
        push rbx;
        push rbp;
        push r13;
        push r14;
        push r15;

        mov r13, r10;
        add r13, 1;                       // right_start = pipe_idx + 1
        mov r14, r12;
        sub r14, r13;                     // right_count = argc - right_start
        mov r12, r10;                     // r12 = pipe_idx (argc no longer needed)

        // R121.M5-followup insertion point (do NOT reorder): once
        // sys_pipe_edge_mint (proposed SC+ 133) lands, allocate the
        // PROD endpoint into r15 and the CONS endpoint into rbx here,
        // then sys_pipe_edge_bind (proposed SC+ 134) them. At M5 both
        // slots stay unclaimed and each child's canary hardcodes its
        // own slot indices, exercising the syscall dispatch arm
        // without needing a mint.

        // Fork LEFT (producer) child.
        call sys_fork;
        cmp rax, 0;
        jl ec_typed_err;
        je ec_typed_left_child;
        mov rbp, rax;                     // parent: left_pid

        // Fork RIGHT (consumer) child from the parent's still-intact
        // argv_buf. Neither child's argv mutation is visible to the
        // parent (COW) so this second fork sees the un-truncated array.
        call sys_fork;
        cmp rax, 0;
        jl ec_typed_err;
        je ec_typed_right_child;

        // Parent: rax = right_pid. pipe_idx (r12) is dead on this
        // branch; reuse it to carry right_pid across the two wait4
        // calls (all caller-save regs are clobbered by each wait4).
        mov r12, rax;

        mov rdi, rbp;
        lea rsi, [rip + child_wait_status];
        xor rdx, rdx;
        xor rcx, rcx;
        call sys_wait4;

        mov rdi, r12;
        lea rsi, [rip + child_wait_status];
        xor rdx, rdx;
        xor rcx, rcx;
        call sys_wait4;

        // R121.M5 acceptance witness. Both children reaped -- fingerprint
        // is byte-proof that (a) the gate detected SHELL_TYPED_PIPE=1,
        // (b) both forks succeeded, (c) both canary execves resolved
        // and ran, (d) both children reached sys_exit before the parent
        // returned. `records=0` is static at M5 per the CAP-MINT GAP
        // note above; widens to a runtime N once sys_pipe_edge_mint
        // lands and the shell counts successful sends.
        lea rdi, [rip + sh_typed_pipe_ok_msg];
        mov rsi, 39;                      // sh_typed_pipe_ok_msg_len
        call sys_debug_puts;

        xor rax, rax;
        pop r15;
        pop r14;
        pop r13;
        pop rbp;
        pop rbx;
        ret;

      ec_typed_left_child:
        // LEFT (producer): truncate this child's own argv_buf/argc copy
        // at pipe_idx, resolve_path, execve. No fd wiring at M5 -- the
        // canary emits via sys_debug_puts (SC+ 12) which goes straight
        // to serial regardless of fd 1's state; the KIND_PIPELINE_EDGE
        // cap path lives entirely in sys_pipe_edge_send (SC+ 131).
        lea r11, [rip + argv_buf];
        xor rcx, rcx;
        mov [r11 + r12*8], rcx;
        lea r11, [rip + argc];
        mov [r11], r12;

        call resolve_path;
        mov rdi, rax;
        lea rsi, [rip + argv_buf];
        lea rax, [rip + envp_slot];
        mov rdx, [rax];
        call sys_execve;
        mov rdi, 127;
        call sys_exit;
        hlt;

      ec_typed_right_child:
        // RIGHT (consumer): shift argv_buf[right_start .. +right_count)
        // down to argv_buf[0..right_count) in this child's own COW copy,
        // NUL-terminate, resolve_path, execve. Mirrors the legacy
        // exec_child_pipeline_right_child shape modulo the dropped
        // dup2/close pair; label prefix ectr_ (typed right) distinguishes
        // from the legacy ecp_rc_ shift.
        xor rcx, rcx;                     // i = 0
      ectr_shift:
        cmp rcx, r14;
        jge ectr_shift_done;
        lea r11, [rip + argv_buf];
        mov r9, r13;
        add r9, rcx;
        mov r8, [r11 + r9*8];
        mov [r11 + rcx*8], r8;
        add rcx, 1;
        jmp ectr_shift;
      ectr_shift_done:
        lea r11, [rip + argv_buf];
        xor rcx, rcx;
        mov [r11 + r14*8], rcx;
        lea r11, [rip + argc];
        mov [r11], r14;

        call resolve_path;
        mov rdi, rax;
        lea rsi, [rip + argv_buf];
        lea rax, [rip + envp_slot];
        mov rdx, [rax];
        call sys_execve;
        mov rdi, 127;
        call sys_exit;
        hlt;

      ec_typed_err:
        pop r15;
        pop r14;
        pop r13;
        pop rbp;
        pop rbx;
        mov rax, 1;
        ret
      }
    } @no_frame

  // ==========================================================================
  // R106.M4-KERNEL (paideia-os #2231) -- fixed-shape token-record dispatch
  // surface.
  //
  // This is the KERNEL-facing integration point that the novel-shape
  // tokenizer landing in paideia-os #2342 (src/user/tokenizer.pdx -- NOT
  // touched by this change) will eventually hand its parsed command to,
  // REPLACING the string-based dispatch_line path for that caller. Until
  // #2342 lands, nothing calls dispatch_from_tokenizer_stream yet -- it
  // ships now as a self-contained, independently correct entry point so
  // the tokenizer work has a stable contract to target. dispatch_line and
  // every builtin above are UNCHANGED and remain shell.pdx's only call
  // path today.
  //
  // Record layout (DFT_REC_SIZE=80 bytes total), pointer passed in rdi:
  //   +0  u64 opcode        one of DFT_OP_* below
  //   +8  u64 arg_count     0..DFT_REC_ARGV_MAX(8) inclusive
  //   +16 u64 arg_ptrs[8]   NUL-terminated cstr pointers; every slot in
  //                         [0, arg_count) MUST be non-NULL (dense-packing
  //                         invariant -- see DFT_REFUSED_DENSE)
  // ==========================================================================
  pub let DFT_REC_ARGV_MAX : u64 = 8
  pub let DFT_REC_SIZE     : u64 = 80

  // Opcode enum. 0..6 mirror dispatch_init's builtin_names/_handlers/_descs
  // fill order one-for-one (echo, exit, pwd, help, env, cd, clear -- see
  // dispatch_init's own header comment above). Opcode 7 is new: "run this
  // as an external command", bridging into the SAME fork+execve+redirect
  // machinery exec_child already owns rather than duplicating it. Anything
  // past DFT_OP_MAX is DFT_OPCODE_INVALID.
  pub let DFT_OP_ECHO  : u64 = 0
  pub let DFT_OP_EXIT  : u64 = 1
  pub let DFT_OP_PWD   : u64 = 2
  pub let DFT_OP_HELP  : u64 = 3
  pub let DFT_OP_ENV   : u64 = 4
  pub let DFT_OP_CD    : u64 = 5
  pub let DFT_OP_CLEAR : u64 = 6
  pub let DFT_OP_EXEC  : u64 = 7
  pub let DFT_OP_MAX   : u64 = 7

  // Failure band 0xFFFFE920..0xFFFFE92F (pre-assigned; repo-wide grep at
  // landing time confirms unclaimed -- adjacent sibling 0xFFFFE9xx bands
  // are recovery_plane_takeover.pdx's 0xFFFFE9D0..DF, provider_kind.pdx's
  // 0xFFFFE9A0..AF, display.pdx's 0xFFFFE900..0F). 8 of 16 slots used;
  // 0xFFFFE928..92F reserved for future DFT_ growth. These are RETURN
  // VALUES of dispatch_from_tokenizer_stream, distinct from dispatch_line's
  // plain 0/1 convention -- the string path is untouched by this band.
  pub let DFT_NULL                   : u64 = 0xFFFFE920  // record ptr == 0
  pub let DFT_OPCODE_INVALID         : u64 = 0xFFFFE921  // opcode > DFT_OP_MAX
  pub let DFT_ARG_COUNT_OUT_OF_RANGE : u64 = 0xFFFFE922  // arg_count > DFT_REC_ARGV_MAX
  pub let E_CD_NO_ARG                : u64 = 0xFFFFE923  // bare `cd` (arg_count==0) via the tokenized path
  pub let DFT_CD_NO_ARG              : u64 = 0xFFFFE923  // == E_CD_NO_ARG (two names, one code -- issue #2231 scope item 4)
  pub let DFT_CD_NOT_A_DIR           : u64 = 0xFFFFE924  // sys_chdir -ENOTDIR (0xFFFFFFFFFFFFFFEC, sys_chdir.pdx)
  pub let DFT_CD_NOT_FOUND           : u64 = 0xFFFFE925  // sys_chdir -ENOENT/-EFAULT (any other negative rax)
  pub let DFT_REFUSED_DENSE          : u64 = 0xFFFFE926  // arg_ptrs has a NULL hole inside [0, arg_count)
  pub let DFT_NOT_INIT               : u64 = 0xFFFFE927  // dispatch_init has not run yet (builtin_count==0)

  pub let dispatch_from_tokenizer_meta : [u8; 64] = "dispatch from tokenizer ok [legacy: DISPATCH FROM TOKENIZER OK]\0"

  // _dft_rec_ptr: single-flow scratch holding the caller's record pointer
  // across calls (sys_chdir/sys_getcwd/sys_write/echo_builtin/etc. all
  // clobber rdi/rax and are not trusted to preserve any caller-save
  // register -- same discipline resolve_path's rp_hit and exec_child's rd_
  // scan already document in this file). No concurrent callers at R106.M4
  // (single-threaded shell), matching _cd_path_scratch/_pwd_buf's own
  // single-flow posture above.
  pub let mut _dft_rec_ptr : u64 = uninit @align(8)

  // dispatch_from_tokenizer_stream(rec_ptr: u64) -> u64
  //
  // Consumes ONE fixed-shape token record (see layout above) and executes
  // it, in place of dispatch_line's argc/argv_buf-from-Tokenizer-.bss +
  // strcmp walk. Guard order (each failure returns immediately, no partial
  // side effects before the guard that rejects it):
  //   1. rec_ptr == 0                          -> DFT_NULL
  //   2. builtin_count == 0 (dispatch_init      -> DFT_NOT_INIT
  //      never ran)
  //   3. arg_count > DFT_REC_ARGV_MAX(8)        -> DFT_ARG_COUNT_OUT_OF_RANGE
  //   4. opcode > DFT_OP_MAX(7)                 -> DFT_OPCODE_INVALID
  //   5. any arg_ptrs[i] for i in               -> DFT_REFUSED_DENSE
  //      [0, arg_count) is NULL
  // Once all five guards clear, the dispatch_from_tokenizer_meta
  // fingerprint fires -- it witnesses "a well-formed record reached and
  // was accepted by this entry point", independent of whether the
  // specific opcode's OWN execution then succeeds (a validly-dispatched
  // `cd /nonexistent` still emits it; only a malformed record suppresses
  // it).
  //
  // Opcode 5 (cd) gets its own granular-error path per issue #2231 scope
  // item 2, BEFORE the generic argc/argv_buf bridge below ever runs:
  //   arg_count == 0                              -> E_CD_NO_ARG (bare `cd`)
  //   sys_chdir returns -ENOTDIR (0x...FFEC)      -> DFT_CD_NOT_A_DIR
  //   sys_chdir returns anything else negative    -> DFT_CD_NOT_FOUND
  //   sys_chdir returns 0                         -> same "shell cd ok --
  //                                                   path=<X>" echo
  //                                                   cd_builtin's string
  //                                                   path emits (reuses
  //                                                   cd_ok_prefix /
  //                                                   _cd_path_scratch /
  //                                                   nl_char verbatim);
  //                                                   returns 0
  //
  // Every OTHER opcode (0-4, 6: echo/exit/pwd/help/env/clear, plus 7's
  // external-exec) is handled by a generic bridge: arg_ptrs[0..arg_count)
  // is copied into the Tokenizer .bss argv_buf (shared with dispatch_line
  // -- see tokenizer.pdx), arg_count into argc, and argv_buf[arg_count] is
  // NUL-pointer-terminated (exec_child's own NULL-terminate step is
  // therefore redundant but harmless for opcode 7 -- it re-terminates at
  // the same index). The matching builtin is then CALLED UNCHANGED --
  // echo_builtin/exit_builtin/pwd_builtin/help_builtin/env_builtin/
  // clear_builtin/exec_child are not modified by this issue and keep
  // reading argc/argv_buf exactly as dispatch_line's callers always have.
  //
  // Register plan: r9 = scan/copy index, r10 = arg_count, r11 = opcode.
  // r10/r11 survive the dense-packing scan and the argc-store/NUL-
  // terminate sequence (pure mov/lea/add/jmp, no CALL or SYSCALL in
  // between). The fingerprint's inline `syscall` (SC+ ID 12) DOES clobber
  // rcx/r11 per this file's own documented syscall-clobber convention (see
  // resolve_path's justification) -- opcode is therefore reloaded fresh
  // from _dft_rec_ptr immediately after that syscall, before the opcode
  // cascade runs, on the generic-bridge path. The cd path never needs that
  // reload: its own fingerprint emission happens before r10 (arg_count) is
  // next read, and r10 is untouched by `syscall`.
  //
  // Effects/capabilities are exec_child's own row, `!{mem, sysreg,
  // sysprivcap} @{fs, sched, cap}` -- this function can reach exec_child
  // (opcode 7) and therefore must not declare less than what that call
  // needs; every other opcode this function reaches needs only the
  // {mem,sysreg}@{fs} subset the other builtins already declare, so the
  // exec_child row is a safe superset covering all eight opcodes.
  //
  // Reserved-label discipline: every new label is dft_-prefixed.
  pub let dispatch_from_tokenizer_stream : (u64) -> u64 !{mem, sysreg, sysprivcap} @{fs, sched, cap} =
    fn (rec_ptr: u64) -> unsafe {
      effects: {mem, sysreg, sysprivcap}, capabilities: {fs, sched, cap},
      justification: "R106.M4-KERNEL (paideia-os #2231): dispatch_from_tokenizer_stream consumes a fixed-shape token record (opcode u64 @+0, arg_count u64 @+8, arg_ptrs[8] u64 @+16 -- DFT_REC_SIZE=80) and executes it, as the kernel-facing integration surface the #2342 tokenizer will target instead of dispatch_line's argc/argv_buf-from-Tokenizer-.bss + strcmp walk. dispatch_line and every builtin remain unmodified; this is purely additive. Guard cascade (rec_ptr==0 -> DFT_NULL; builtin_count==0 -> DFT_NOT_INIT; arg_count>8 -> DFT_ARG_COUNT_OUT_OF_RANGE; opcode>7 -> DFT_OPCODE_INVALID; any arg_ptrs[i] in [0,arg_count) NULL -> DFT_REFUSED_DENSE) runs before the record pointer is stashed into _dft_rec_ptr is even trusted for a second read -- each guard reads directly off rdi/rec_ptr so no scratch write happens before the record is known well-formed enough to act on. Opcode 5 (cd) branches BEFORE the generic bridge into its own granular-error path (issue #2231 scope item 2): arg_count==0 -> E_CD_NO_ARG (==DFT_CD_NO_ARG); else sys_chdir(arg_ptrs[0], 255) is called directly, and its return is examined -- 0xFFFFFFFFFFFFFFEC (-ENOTDIR) -> DFT_CD_NOT_A_DIR, any other negative -> DFT_CD_NOT_FOUND, 0 -> the same 'shell cd ok -- path=<X>' echo cd_builtin's string path emits (cd_ok_prefix + sys_getcwd(&_cd_path_scratch,256) + sys_write, mirrored verbatim) then return 0. Every other opcode (0-4,6-7) is handled by a shared bridge: arg_ptrs[0..arg_count) copied into the Tokenizer argv_buf, arg_count into argc, argv_buf[arg_count] NUL-pointer-terminated, then the matching UNCHANGED builtin (echo_builtin/exit_builtin/pwd_builtin/help_builtin/env_builtin/clear_builtin/exec_child for opcode 7) is called and its return forwarded verbatim. The dispatch_from_tokenizer_meta fingerprint (SC+ ID 12 sys_debug_puts, wire length 63) fires once every guard has cleared -- on the generic-bridge path right after the argc/NUL-terminate step, on the cd path right after the arg_count==0 check point -- witnessing acceptance of a well-formed record independent of the selected opcode's own later success/failure. Register plan: r9=scan/copy index, r10=arg_count, r11=opcode, both loaded once from rec_ptr and surviving the dense-packing scan plus the argc-store/NUL-terminate sequence unclobbered (no CALL/SYSCALL runs inside either loop); the fingerprint's inline `syscall` clobbers rcx/r11 per this file's documented syscall-clobber convention (resolve_path's own justification), so the generic-bridge path reloads opcode fresh from _dft_rec_ptr immediately after that syscall before the opcode cascade reads r11 again -- the cd path needs no such reload since its own next read is r10 (arg_count), untouched by `syscall`. _dft_rec_ptr (single-flow .bss scratch, no concurrent callers at R106.M4) is reloaded fresh before every dereference rather than trusted in a register across any CALL, mirroring resolve_path's rp_hit / rp_build_candidate reload discipline already established in this file. Effects/capabilities `!{mem, sysreg, sysprivcap} @{fs, sched, cap}` are exec_child's own row verbatim -- the superset needed because opcode 7 reaches exec_child, and a safe over-declaration for the other seven opcodes which need only {mem,sysreg}@{fs}. Encoder-gap discipline: no `test rN,rN` (uses `cmp rN,0`), no `add reg,[mem]` (SIB+disp addressing `[base+index*8+disp]` used throughout instead, matching fd_table.pdx's `mov rax,[rdi+rsi*8+168]` precedent), no `and r11,imm64`. Reserved-label discipline: every new label is dft_-prefixed.",
      block: {
        cmp rdi, 0;
        je dft_null;

        lea rax, [rip + builtin_count];
        mov rax, [rax];
        cmp rax, 0;
        je dft_not_init;

        lea rax, [rip + _dft_rec_ptr];
        mov [rax], rdi;

        mov r10, [rdi + 8];              // r10 = arg_count
        cmp r10, 8;
        ja dft_argc_bad;

        mov r11, [rdi + 0];              // r11 = opcode
        cmp r11, 7;
        ja dft_opcode_bad;

        // Dense-packing scan over arg_ptrs[0..arg_count).
        xor r9, r9;
dft_dense_top:
        cmp r9, r10;
        jge dft_dense_done;
        lea rax, [rip + _dft_rec_ptr];
        mov rax, [rax];
        mov rax, [rax + r9*8 + 16];      // arg_ptrs[r9]
        cmp rax, 0;
        je dft_refused_dense;
        add r9, 1;
        jmp dft_dense_top;
dft_dense_done:

        cmp r11, 5;
        je dft_do_cd;

        // ---- Generic bridge (opcodes 0-4, 6, 7): copy arg_ptrs into
        // argv_buf, arg_count into argc, NUL-terminate argv_buf[arg_count].
        xor r9, r9;
dft_copy_top:
        cmp r9, r10;
        jge dft_copy_done;
        lea rax, [rip + _dft_rec_ptr];
        mov rax, [rax];
        mov rax, [rax + r9*8 + 16];      // arg_ptrs[r9]
        lea rdx, [rip + argv_buf];
        mov [rdx + r9*8], rax;
        add r9, 1;
        jmp dft_copy_top;
dft_copy_done:
        lea rax, [rip + argc];
        mov [rax], r10;
        lea rax, [rip + argv_buf];
        xor rcx, rcx;
        mov [rax + r10*8], rcx;          // argv_buf[arg_count] = NULL

        lea rdi, [rip + dispatch_from_tokenizer_meta];
        mov rsi, 63;
        mov rax, 12;
        syscall;

        // Reload opcode -- the syscall above clobbers r11.
        lea rax, [rip + _dft_rec_ptr];
        mov rax, [rax];
        mov r11, [rax + 0];

        cmp r11, 0;
        je dft_call_echo;
        cmp r11, 1;
        je dft_call_exit;
        cmp r11, 2;
        je dft_call_pwd;
        cmp r11, 3;
        je dft_call_help;
        cmp r11, 4;
        je dft_call_env;
        cmp r11, 6;
        je dft_call_clear;
        // Only DFT_OP_EXEC(7) remains after the opcode<=7 gate and the
        // six explicit checks above.
        call exec_child;
        ret;

dft_call_echo:
        call echo_builtin;
        ret;
dft_call_exit:
        call exit_builtin;
        ret;                            // unreachable: exit_builtin calls sys_exit
dft_call_pwd:
        call pwd_builtin;
        ret;
dft_call_help:
        call help_builtin;
        ret;
dft_call_env:
        call env_builtin;
        ret;
dft_call_clear:
        call clear_builtin;
        ret;

dft_do_cd:
        // Fingerprint fires here too -- a bare `cd` (caught just below) is
        // still an ACCEPTED, well-formed dispatch; only the guards above
        // (null/not-init/argc/opcode/density) suppress it.
        lea rdi, [rip + dispatch_from_tokenizer_meta];
        mov rsi, 63;
        mov rax, 12;
        syscall;

        cmp r10, 0;
        je dft_cd_no_arg;

        lea rax, [rip + _dft_rec_ptr];
        mov rax, [rax];
        mov rdi, [rax + 16];             // arg_ptrs[0] (density-checked non-NULL above)
        mov rsi, 255;                    // walker cap, matches cd_builtin's own convention
        call sys_chdir;
        cmp rax, 0;
        je dft_cd_ok;
        cmp rax, 0xFFFFFFFFFFFFFFEC;     // -ENOTDIR (sys_chdir.pdx SYS_CHDIR_ERR_ENOTDIR)
        je dft_cd_notdir;
        jmp dft_cd_notfound;             // -ENOENT / -EFAULT / any other negative rax

dft_cd_ok:
        mov rdi, 1;
        lea rsi, [rip + cd_ok_prefix];
        mov rdx, 20;
        call sys_write;

        lea rdi, [rip + _cd_path_scratch];
        mov rsi, 256;
        call sys_getcwd;
        cmp rax, 0;
        jl dft_cd_ok_nl;

        mov r10, rax;
        sub r10, 1;
        mov rdi, 1;
        lea rsi, [rip + _cd_path_scratch];
        mov rdx, r10;
        call sys_write;

dft_cd_ok_nl:
        mov rdi, 1;
        lea rsi, [rip + nl_char];
        mov rdx, 1;
        call sys_write;
        xor rax, rax;
        ret;

dft_null:
        mov rax, 0xFFFFE920;             // DFT_NULL
        ret;
dft_not_init:
        mov rax, 0xFFFFE927;             // DFT_NOT_INIT
        ret;
dft_argc_bad:
        mov rax, 0xFFFFE922;             // DFT_ARG_COUNT_OUT_OF_RANGE
        ret;
dft_opcode_bad:
        mov rax, 0xFFFFE921;             // DFT_OPCODE_INVALID
        ret;
dft_refused_dense:
        mov rax, 0xFFFFE926;             // DFT_REFUSED_DENSE
        ret;
dft_cd_no_arg:
        mov rax, 0xFFFFE923;             // DFT_CD_NO_ARG == E_CD_NO_ARG
        ret;
dft_cd_notdir:
        mov rax, 0xFFFFE924;             // DFT_CD_NOT_A_DIR
        ret;
dft_cd_notfound:
        mov rax, 0xFFFFE925;             // DFT_CD_NOT_FOUND
        ret
      }
    } @no_frame
}
