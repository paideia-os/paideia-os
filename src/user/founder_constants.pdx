// src/user/founder_constants.pdx — R106.M1 (paideia-os #2228)
//
// Content-addressed founder identity — PLACEHOLDER constants.
//
// This module isolates the R106-era build-time placeholder fingerprint
// used to give the persistent-home tree its final SHAPE
// (`/home/<64-hex-fp>/`) BEFORE the R108.M2 identity substrate lands
// real Argon2id + ML-DSA-65 key generation. Every consumer that would
// otherwise embed a literal placeholder string (rootfs_seed.pdx for
// R106.M1; init.pdx's HOME env for R106.M2; dispatch.pdx / shell.pdx
// for R106.M3's `/home/operator` retirement) SHOULD import from this
// module. Doing so means R108.M2 can retire the placeholder in a single
// commit — flip the `fc_placeholder_*` symbols to the real founder
// fingerprint (derived from `argon2id_derive` + `mldsa65_keygen` +
// `SHAKE-256(pk)[0..32]`), and every path consumer picks up the change
// through the linker.
//
// See design/user/content-addressed-identity.md §1 for the identity
// primitive and §9 for the arbitrated-0 → arbitrated-1 alignment table
// this module sits at the head of.
//
// The chosen placeholder value is the 64-hex byte string
//
//   deadbeef00000000000000000000000000000000000000000000000000000000
//
// Rationale for the specific bytes:
//   * 64 lowercase hex chars = 32 bytes when hex-decoded, matching
//     `SHAKE-256(pubkey)[0..32]` fingerprint width per
//     content-addressed-identity.md §1 (so the wire shape is already
//     what R108 will produce).
//   * The `deadbeef` prefix is a widely-recognised sentinel — anyone
//     reading `ls /home/` before R108 lands immediately recognises this
//     as a placeholder, not a real user identity. R108.M2 will overwrite
//     the whole string with the real founder fingerprint atomically.
//   * All-zero tail keeps the value bit-cheap for future hash-based
//     lookups (a real fingerprint drawn from SHAKE-256 will have every
//     bit populated; the extreme zero density here is another signal
//     that this is a placeholder).
//   * Not derived from any secret. This is a public, deliberately-
//     inauthentic value; no user can hold the ML-DSA-65 private key
//     whose SHAKE-256(pk)[0..32] equals `deadbeef00...` (finding such
//     a key would break SHAKE-256 preimage resistance).
//
// LABEL PREFIX: `fc_` (founder_constants) — avoids paideia-as reserved
// keyword collisions (`loop`, `if`, `let`, ...) per
// feedback_paideia_as_reserved_labels.
//
// LIFECYCLE:
//   Introduced   : R106.M1  (this module)
//   First reader : R106.M1  (rootfs_seed.pdx — mkdir /home/<fp>/)
//   Extended by  : R106.M2  (init.pdx — HOME=/home/<fp>)
//                  R106.M3  (dispatch.pdx / shell.pdx — /home/operator retirement)
//   Retired      : R108.M2  (real founder fp overwrites these symbols
//                            in one commit; module renames to
//                            founder_identity.pdx or similar).

module FounderConstants = structure {

  // ==========================================================================
  // Fingerprint width (bytes when hex-decoded / chars when hex-rendered).
  // These are the two forms in which a fingerprint travels through the
  // OS surface: 32 raw bytes on the wire (in cap records, sig payloads,
  // etc.), and 64 lowercase hex chars in every path component and every
  // user-visible rendering.
  // ==========================================================================

  pub let FC_FINGERPRINT_BYTES     : u64 = 32
  pub let FC_FINGERPRINT_HEX_CHARS : u64 = 64

  // ==========================================================================
  // Placeholder fingerprint — 64 lowercase hex chars, NUL-terminated for
  // easy embedding in path composition. Wire length excludes the NUL.
  //
  // Storage is emit_len + 1 (trailing NUL is not written to the wire;
  // any consumer that hands the value to a length-bounded syscall
  // passes FC_PLACEHOLDER_FP_HEX_LEN, not sizeof(fc_placeholder_fp_hex)).
  // ==========================================================================

  pub let fc_placeholder_fp_hex     : [u8; 65] = "deadbeef00000000000000000000000000000000000000000000000000000000\0"
  pub let fc_placeholder_fp_hex_len : u64      = 64

  // ==========================================================================
  // /home root directory — parent of every per-user home. Mode 0755
  // (world-traversable so any user can chdir into their own home; only
  // the /home root owner (init at R106) can add or remove home entries).
  // NUL-terminated for sys_stat / sys_mkdir.
  // ==========================================================================

  pub let fc_home_root_path     : [u8; 6] = "/home\0"
  pub let fc_home_root_path_len : u64     = 5

  // ==========================================================================
  // Per-user home path for the placeholder founder — the R106-shape
  // form that R108.M2 will overwrite in place with the real founder
  // fingerprint. Composition:
  //
  //     "/home/" (6) + fp_hex (64) + "\0" (1) = 71 bytes storage
  //     wire length excluding NUL                = 70 bytes
  //
  // Mode expectations at the mkdir site: 0700 (owner-only). See
  // content-addressed-identity.md §5 — access to a user's home is
  // gated by holding a cap subject-bound to the owner's fingerprint,
  // not by a POSIX (uid, gid, mode) tuple. The 0700 mode is a
  // belt-and-suspenders defence-in-depth default for any future
  // POSIX-shaped consumer; the authoritative access gate remains
  // the cap held on the subtree's KIND_HOME_ROOT.
  // ==========================================================================

  pub let fc_placeholder_home_path     : [u8; 71] = "/home/deadbeef00000000000000000000000000000000000000000000000000000000\0"
  pub let fc_placeholder_home_path_len : u64      = 70
}
