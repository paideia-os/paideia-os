// src/user/echo_server.pdx — R20b.M5-001 (#1563)
//                             + R20b.M6-003 (#1566)
// Echo-server userspace binary — target-shape for the R20b userspace-
// server substrate under the R20b.M6-003 dual-endpoint pattern. Declares
// an `_init_caps` sidecar per design/loader/init-caps-sidecar.md §2
// seeding cap-table slot 0 with a KIND_IPC_ENDPOINT capability for
// endpoint_id=1 (direction=BIDI, rights=R_IPC_ALL). Body is an infinite
// request/reply loop:
//
//   loop:
//     sys_ipc_recv(cap_slot=2, hdr, payload, 4088)  // blocks on empty
//     hdr.op |= 0x80                                // FRAME_OP_REPLY_BIT
//     sys_ipc_reply(cap_slot=2, hdr, payload, len)  // hdr.reply_endpoint_id
//                                                    // in the received hdr
//                                                    // routes reply to
//                                                    // client's reply
//                                                    // endpoint (§4.4)
//
// Dual-endpoint routing note (R20b.M6-003 / #1566)
// ------------------------------------------------
// The server does NOT know or need a cap for the client's reply endpoint.
// The client encodes reply_endpoint_id into the request header's u16 slot
// at bytes 2..3 (repurposed from v1's reserved "flags" field per
// design/ipc/userspace-server-substrate.md §4.4). This server's reply
// loop preserves the incoming hdr verbatim (only bit 7 of op flipped);
// sys_ipc_reply_body reads the header's reply_endpoint_id and — when
// non-zero — publishes the reply to THAT endpoint, bypassing the
// cap_slot's resolved endpoint. This closes the same-endpoint
// request/reply race documented in §4.4.
//
// Posture note — SUPERSEDED at R31.M2-1590 (#1590)
// -----------------------------------------------
// This file used to carry a note explaining that the "real 2-task
// scheduler-driven roundtrip" was deferred, that the M6-003 witness
// stayed kernel-driven against init's user_pml4, and that this source
// existed only as a target-shape whose "runtime spawn wires up
// post-R20b". That is no longer true.
//
// #1590 landed the loader-side multi-task boot spawn path
// (src/kernel/core/loader/boot_spawn.pdx). This binary is spawned as a
// real ring-3 task at boot, alongside echo_client, and the scheduler
// alternates them. The proof is on the wire and comes from HERE: the
// "R31 ECHO SERVER RING3 OK" line below is printed by this code, in
// ring 3, in this task's own address space. See boot_r31_spawn_pair in
// tools/run-smoke.sh and design/ipc/userspace-server-substrate.md §4.5.
//
// The kernel-side M5/M6 witnesses are deliberately RETAINED. They are
// no longer the only evidence, but they remain useful as unit-level
// checks of the individual syscall bodies — they exercise error paths
// (empty-endpoint drain, missing reply bit, cap-slot rights denial)
// that a single successful round trip does not reach.
//
// SC+ IDs inlined
// ---------------
// This binary inlines the two IPC syscalls it needs directly (matches
// child_hello.pdx / true.pdx one-file-one-ELF discipline; keeps the
// binary self-contained without pulling syscall_shim.pdx's other 12
// wrappers). SC+ IDs (frozen at R17-M1-001 / R20b.M3):
//   40 = sys_ipc_recv    (rdi=cap_slot, rsi=hdr_va, rdx=payload_va, rcx=max)
//   41 = sys_ipc_reply   (rdi=cap_slot, rsi=hdr_va, rdx=payload_va, rcx=len)
// The dispatch shim (M6-002) resolves cap_slot → endpoint_id at the
// kernel boundary; the server just passes cap_slot 2 (its own endpoint,
// seeded via the _init_caps sidecar).
//
// SysV rcx is the 4th arg; the SYSCALL entry stashes it into r10 before
// the body reads a3 — no user-side arg shuffle needed at arity 4.

module EchoServer = structure {

  // ============================================================================
  // _init_caps sidecar — declared per design/loader/init-caps-sidecar.md §2.
  //
  // Two published symbols in .rodata, hand-packed as [u64; N] until
  // paideia-as grows struct-in-rodata support:
  //
  //   _init_caps_count : u16 = 1
  //   _init_caps       : InitCap[1]
  //
  // The single entry seeds cap-table slot 0 with:
  //   slot         = 0
  //   kind         = 5 (KIND_IPC_ENDPOINT — base per cap/kind.pdx)
  //   rights       = 0x0B (R_IPC_ALL = READ|WRITE|INVOKE per kind_endpoint.pdx)
  //   target_ptr   = 0x0000_0000_0002_0001
  //                  bits [15:0]  = 1 (endpoint_id — the "svc.echo" endpoint)
  //                  bits [17:16] = 2 (direction=BIDI per kind_endpoint.pdx)
  //
  // Byte layout inside the 16-byte InitCap record (natural 8-byte alignment):
  //   +0  u16 slot   = 0x0000
  //   +2  u16 kind   = 0x0005
  //   +4  u32 rights = 0x0000_000B
  //   +8  u64 target = 0x0000_0000_0002_0001
  //
  // Packed as two u64 words (LE):
  //   word0 = (rights_u32 << 32) | (kind_u16 << 16) | slot_u16
  //         = (0x0000_000B << 32) | (0x0005 << 16) | 0x0000
  //         = 0x0000_000B_0005_0000
  //   word1 = target_ptr
  //         = 0x0000_0000_0002_0001
  //
  // Marked `pub let` (immutable) — matches the immutable-array idiom
  // used for msg / init_msg / wait_prefix throughout src/user/. paideia-as
  // emits both to .rodata via the rip-relative addressing the loader's
  // symbol walker uses.
  // ============================================================================

  // count = 1 in low 16 bits of the u64 (upper 48 bits reserved zero).
  // The sidecar validator (init_caps_validate) reads this as a u16 via
  // qword-load + mask 0xFFFF — see src/kernel/core/loader/init_caps.pdx §L130.
  pub let _init_caps_count : u64 = 1

  // Single entry — see byte layout above.
  //
  // R31.M2-1596 (#1596): THE SLOT NUMBERS HERE ARE GLOBAL, NOT LOCAL.
  //
  // R20b runs one cap_table shared by every task, and loader_seed_caps mints
  // at the ABSOLUTE slot this sidecar names. Every sidecar-carrying image in
  // this tree named slot 0 until #1596, so spawning any two of them meant the
  // second silently overwrote the first's descriptor -- and cap_mint_write
  // clears cap_owner[slot] on every mint, so it erased the first task's
  // ownership claim too. The echo pair survived that only by coincidence
  // (same kind, same endpoint, superset rights); two images whose slot 0
  // named different objects would have swapped authority with no diagnostic
  // anywhere.
  //
  // loader_seed_caps now REFUSES to seed a slot a live task holds
  // (LOADER_SEED_SLOT_TAKEN). That refusal made this image fail to boot
  // alongside its siblings, which was a true statement about the design, so
  // the slots were changed rather than the check weakened. The allocation is
  // in design/capabilities/loader-seeded-slot-allocation.md and is enforced
  // at build time by tools/verify-user-cap-sidecars.sh.
  //
  // It is INTERIM. Under per-task capability spaces the slot an image names
  // becomes private to it and this whole comment stops being true.
  pub let _init_caps : [u64; 2] = [
    // slot=2, kind=KIND_IPC_ENDPOINT(5), rights=R_IPC_ALL(0x0B)
    //   #1596: was slot 0, which collided with echo_client's slot 0.
    0x0000000B00050002,
    // target_ptr: endpoint_id=1, direction=BIDI(2)
    0x0000000000020001
  ]

  // ============================================================================
  // Server-side hdr + payload scratch buffers (.bss @align(8)).
  //
  // hdr_scratch: 8 bytes for the packed message header (op@+0, ver@+1,
  //   reply_endpoint_id@+2..3 LE, payload_len@+4..7 LE per frame.pdx
  //   §encode layout — R20b.M6-003 repurposed the v1 "flags" u16 slot as
  //   reply_endpoint_id). Written by sys_ipc_recv's user_bounce_recv
  //   walker on drain; read + modified (bit-7 flip on op ONLY —
  //   reply_endpoint_id preserved) + written by sys_ipc_reply's
  //   user_bounce_send walker on publish. sys_ipc_reply_body reads the
  //   preserved reply_endpoint_id and routes the reply to that endpoint
  //   (§4.4 dual-endpoint).
  //
  // payload_scratch: 4088-byte drain sink sized to FRAME_MAX_PAYLOAD (the
  //   maximum a single-slot endpoint holds per acpi-supervisor-schema §3).
  //   Round up to whole u64s -> 511 slots (511*8 = 4088, exact fit).
  //   Written by sys_ipc_recv on drain, read verbatim by sys_ipc_reply on
  //   the reply publish (echo semantic: payload is passed through unmodified).
  //
  // `let mut` because paideia-as's `pub let` (immutable) cannot accept a
  // bare `[u64; N]` .bss reservation at rodata scope — matches the
  // `pub let mut wait_status : [u64; 1] = uninit @align(8)` idiom in
  // src/user/init.pdx L59.
  // ============================================================================

  pub let mut hdr_scratch     : [u64; 1]   = uninit @align(8)
  pub let mut payload_scratch : [u64; 511] = uninit @align(8)

  // ============================================================================
  // R31.M2-1590 (#1590): ring-3 proof-of-life marker.
  //
  // Emitted once, before the first sys_ipc_recv, via sys_debug_puts (SC+ ID
  // 12 — the one syscall that depends on nothing but the SYSCALL entry path,
  // which is why init uses it for the same purpose).
  //
  // Why the server needs its own marker at all, when the client's success
  // already implies a server replied: because "a reply arrived" is exactly
  // what the four kernel-side Option-B witnesses also produce, and the whole
  // point of #1590 is to stop accepting that as evidence of a running
  // server. This line can only be printed by ring-3 code executing at
  // echo_server's entry point in echo_server's own address space. It is the
  // difference between the kernel talking to itself and a process running.
  // ============================================================================
  pub let ring3_msg : [u8; 26] = "R31 ECHO SERVER RING3 OK\n\0"
  pub let ring3_len : u64 = 25

  // ============================================================================
  // _start — user program entry point. Infinite loop; never returns.
  //
  // Effects / capabilities
  // ----------------------
  // {mem, sysreg} @{cap}:
  //   mem     — hdr_scratch + payload_scratch reads/writes.
  //   sysreg  — every SYSCALL instruction touches IA32_LSTAR/IA32_CSTAR/
  //             IA32_FMASK indirectly via the CPU's fast-syscall path.
  //   cap     — the two IPC syscalls are cap-gated at the dispatch shim
  //             (M6-002 landed; cap_slot 2 = server endpoint per sidecar).
  //
  // Register discipline
  // -------------------
  // r12 stashes payload_len returned by sys_ipc_recv across the bit-7
  // flip + sys_ipc_reply call (SysV callee-save; syscall preserves it).
  // rdi/rsi/rdx/rcx set fresh per syscall.
  //
  // Retry-on-error posture
  // ----------------------
  // sys_ipc_recv returns negative on -EFAULT / -EBADF / -EACCES (see
  // sys_ipc_recv.pdx §sentinels + dispatch.pdx dispatch_ipc_recv). If the
  // cap slot is bad or the walker rejects our hdr/payload VAs (both cases
  // are defensive — hdr_scratch and payload_scratch are our own .bss so
  // walker success is guaranteed), we defensively `jl server_loop` back
  // to retry instead of hlt'ing. Same rationale as R20b.M5-001 posture.
  // ============================================================================

  pub let _start : () -> () !{mem, sysreg} @{cap} =
    fn () -> unsafe {
      effects: {mem, sysreg},
      capabilities: {cap},
      justification: "R20b.M5-001 (#1563) + R20b.M6-003 (#1566): echo_server _start. Infinite request/reply loop over cap_slot=2 (seeded by _init_caps sidecar to endpoint_id=1). Sequence per iteration: (1) sys_ipc_recv(rdi=2, rsi=&hdr_scratch, rdx=&payload_scratch, rcx=4088) SC+ ID 40. rax = payload_len on success or negative errno (-EFAULT/-EBADF/-EACCES). On negative, defensively branch back to server_loop; the failure modes are structural (bad cap slot / walker VA rejection) and the tight retry keeps behaviour deterministic without introducing a userspace error-handling policy at M6. r12 stashes payload_len across the bit-7 flip + reply call (SysV callee-save; SYSCALL preserves r12 per amd64 fast-syscall rules). (2) OR 0x80 into hdr_scratch's low byte via `lea rax, [rip+hdr_scratch] ; mov rcx, [rax] ; or rcx, 0x80 ; mov [rax], rcx` — u64-granularity load/or/store avoids any byte-level idiom, and since hdr's op field is byte 0 of the packed u64 (native LE per frame_encode/frame_decode round-trip), or'ing 0x80 into the low byte of the u64 exactly sets FRAME_OP_REPLY_BIT (=0x80 per frame.pdx §L112). CRUCIALLY: reply_endpoint_id (bytes 2..3 of hdr) is preserved verbatim by the u64 or 0x80 op — we're only touching bit 7 of byte 0, leaving bits 8..63 (ver, reply_endpoint_id, payload_len) intact. sys_ipc_reply_body reads reply_endpoint_id from the hdr and routes the reply to that endpoint if non-zero (M6-003 dual-endpoint per userspace-server-substrate.md §4.4). (3) sys_ipc_reply(rdi=2, rsi=&hdr_scratch, rdx=&payload_scratch, rcx=r12) SC+ ID 41. rax = 0 on success or pass-through send-body error; we do NOT branch on the return because the loop retry-on-recv-error absorbs any anomalies. cap_slot=2 gates the reply's WRITE|INVOKE rights on the SERVER's own endpoint (dispatch_ipc_reply gate 0); the actual reply target is derived from hdr.reply_endpoint_id inside sys_ipc_reply_body. (4) jmp server_loop. Never returns. Effects union: {mem} for hdr_scratch/payload_scratch touches; {sysreg} for every SYSCALL. @{cap} because sys_ipc_recv/reply are cap-gated post-M6-002. @no_frame because the loop is a tail-call replacement of the entire function body.",
      block: {
        // ---- Step 0 (R31.M2-1590 / #1590): ring-3 proof of life. ----
        // Emitted once, outside the loop, before anything can block.
        lea rdi, [rip + ring3_msg];
        mov rsi, 25;                       // ring3_len (excludes trailing NUL)
        mov rax, 12;                       // SC+ ID 12 = sys_debug_puts
        syscall;

        server_loop:
          // ---- Step 1: sys_ipc_recv(cap_slot=2, hdr, payload, 4088). SC+ ID 40. ----
          mov rdi, 2;                        // cap_slot=2 (server endpoint per _init_caps; #1596)
          lea rsi, [rip + hdr_scratch];      // out_hdr_va (user VA — our .bss)
          lea rdx, [rip + payload_scratch];  // out_payload_va (user VA — our .bss)
          mov rcx, 4088;                     // out_payload_max = FRAME_MAX_PAYLOAD
          mov rax, 40;                       // SC+ ID 40
          syscall;
          // rax = payload_len [0..4088] or negative errno.
          cmp rax, 0;
          jl server_loop;                    // defensive retry on -EFAULT/-EBADF/-EACCES
          mov r12, rax;                      // stash payload_len (SysV callee-save)

          // ---- Step 2: bit-7 flip on hdr.op (byte 0 of the packed u64). ----
          // FRAME_OP_REPLY_BIT = 0x80 per frame.pdx §L112.
          // The u64 or 0x80 touches ONLY bit 7 of byte 0; bytes 1..7
          // (ver + reply_endpoint_id + payload_len) are preserved.
          // reply_endpoint_id (bytes 2..3) survives so sys_ipc_reply_body
          // can route the reply back to the client's reply endpoint
          // (M6-003 dual-endpoint per §4.4).
          lea rax, [rip + hdr_scratch];
          mov rcx, [rax];                    // rcx = packed hdr u64
          or rcx, 0x80;                      // set FRAME_OP_REPLY_BIT on op byte
          mov [rax], rcx;                    // write back

          // ---- Step 3: sys_ipc_reply(cap_slot=2, hdr, payload, len). SC+ ID 41. ----
          // cap_slot=2 gates rights on server's own endpoint; the actual
          // reply target is derived from hdr.reply_endpoint_id inside
          // sys_ipc_reply_body (M6-003 dual-endpoint).
          mov rdi, 2;                        // cap_slot=2 (server endpoint; #1596)
          lea rsi, [rip + hdr_scratch];      // hdr_va (bit-7 flipped; reply_eid preserved)
          lea rdx, [rip + payload_scratch];  // payload_va (unchanged; echo)
          mov rcx, r12;                      // payload_len from recv
          mov rax, 41;                       // SC+ ID 41
          syscall;
          // rax = 0 (OK) or pass-through -EFAULT / -EAGAIN / -EINVAL / -EBADF.
          //   -EINVAL cannot fire here — we set bit 7 explicitly above.
          //   -EAGAIN could fire IF the target reply endpoint has a
          //     stale in-flight message (protocol misuse); we ignore
          //     since the loop retry-on-recv-error absorbs anomalies.
          //   Structural failures (walker regressions on our .bss)
          //     cannot recover; the loop stays deterministic.

          jmp server_loop
      }
    } @no_frame
}
