// src/user/echo_server.pdx — R20b.M5-001 (#1563)
// Echo-server userspace binary — closure witness for the R20b userspace-
// server substrate. Declares an `_init_caps` sidecar per
// design/loader/init-caps-sidecar.md §2 seeding cap-table slot 0 with a
// KIND_IPC_ENDPOINT capability for endpoint_id=1 (direction=BIDI, rights=
// R_IPC_ALL). Body is an infinite request/reply loop:
//
//   loop:
//     sys_ipc_recv(endpoint_id=1, hdr, payload, 4088)  // blocks on empty
//     hdr.op |= 0x80                                    // FRAME_OP_REPLY_BIT
//     sys_ipc_reply(endpoint_id=1, hdr, payload, len)
//
// R20b.M5 posture note
// --------------------
// At R20b.M5 the kernel's post-elf_lite_load hook does NOT yet walk the
// image's symbol table to resolve `_init_caps` / `_init_caps_count`
// (deferred per design/loader/init-caps-sidecar.md §5 phase-1 and
// src/kernel/core/loader/seed_caps.pdx §Phase-1 sidecar placement); it
// wires a zero-count sidecar instead. As a result THIS binary is not
// invoked at boot by the kernel M5-001 witness — the roundtrip is
// driven kernel-side via direct calls to sys_ipc_send_body /
// sys_ipc_recv_body / sys_ipc_reply_body / sys_svc_lookup_body against
// init's user-mapped page (same discipline as R20b.M3-001/002/003
// witnesses). The binary is built + embedded + verified as a real ELF
// so the runtime side lands the moment the loader symbol walker
// (Phase-2 of #1562) and a task-spawning hook for server binaries land
// (post-R20b).
//
// Raw endpoint_id in syscall args (M3 scaffolding)
// ------------------------------------------------
// The M3 dispatch shims (dispatch_ipc_recv / dispatch_ipc_send /
// dispatch_ipc_reply — src/kernel/core/syscall/dispatch.pdx) currently
// treat their first arg as a raw endpoint_id, not a cap_slot (per the
// "Scaffolding at R20b.M3-001" note in each dispatch shim: "userspace
// has not yet been seeded any KIND_IPC_ENDPOINT caps ... deferred to
// the M3-004 syscall-shim wire-up"). The echo_server therefore passes
// endpoint_id=1 directly rather than a cap_slot obtained via cap
// invocation — this is the intended scaffolding shape at R20b.M5. Once
// the cap-slot indirection lands the first arg would become slot 0
// (the sidecar-seeded slot), and the dispatch shim would resolve
// slot -> endpoint_id via the cap descriptor's target_ptr tail.
//
// SC+ IDs inlined
// ---------------
// This binary inlines the four IPC syscalls it needs directly (matches
// child_hello.pdx / true.pdx one-file-one-ELF discipline; keeps the
// binary self-contained without pulling syscall_shim.pdx's other 12
// wrappers). SC+ IDs (frozen at R17-M1-001 / R20b.M3):
//   40 = sys_ipc_recv    (rdi=id, rsi=hdr_va, rdx=payload_va, rcx=max)
//   41 = sys_ipc_reply   (rdi=id, rsi=hdr_va, rdx=payload_va, rcx=len)
//   42 = sys_ipc_send    (rdi=id, rsi=hdr_va, rdx=payload_va, rcx=len)
//   43 = sys_svc_lookup  (rdi=name_va, rsi=name_len)
// Arity <= 4 with no rcx→r10 shuffle needed at the shim level; SysV rcx
// is the 4th arg and is stashed by the SYSCALL entry into r10 before
// the body reads a3.  (The kernel-side dispatch shim owns the SysV->
// SYSCALL shuffle; the userspace shim just loads rax + SYSCALLs.)

module EchoServer = structure {

  // ============================================================================
  // _init_caps sidecar — declared per design/loader/init-caps-sidecar.md §2.
  //
  // Two published symbols in .rodata, hand-packed as [u64; N] until
  // paideia-as grows struct-in-rodata support:
  //
  //   _init_caps_count : u16 = 1
  //   _init_caps       : InitCap[1]
  //
  // The single entry seeds cap-table slot 0 with:
  //   slot         = 0
  //   kind         = 5 (KIND_IPC_ENDPOINT — base per cap/kind.pdx)
  //   rights       = 0x0B (R_IPC_ALL = READ|WRITE|INVOKE per kind_endpoint.pdx)
  //   target_ptr   = 0x0000_0000_0002_0001
  //                  bits [15:0]  = 1 (endpoint_id)
  //                  bits [17:16] = 2 (direction=BIDI per kind_endpoint.pdx)
  //
  // Byte layout inside the 16-byte InitCap record (natural 8-byte alignment):
  //   +0  u16 slot   = 0x0000
  //   +2  u16 kind   = 0x0005
  //   +4  u32 rights = 0x0000_000B
  //   +8  u64 target = 0x0000_0000_0002_0001
  //
  // Packed as two u64 words (LE):
  //   word0 = (rights_u32 << 32) | (kind_u16 << 16) | slot_u16
  //         = (0x0000_000B << 32) | (0x0005 << 16) | 0x0000
  //         = 0x0000_000B_0005_0000
  //   word1 = target_ptr
  //         = 0x0000_0000_0002_0001
  //
  // Marked `pub let` (immutable) — matches the immutable-array idiom
  // used for msg / init_msg / wait_prefix throughout src/user/. paideia-as
  // emits both to .rodata via the rip-relative addressing the loader's
  // future symbol walker will use.
  // ============================================================================

  // count = 1 in low 16 bits of the u64 (upper 48 bits reserved zero).
  // The sidecar validator (init_caps_validate) reads this as a u16 via
  // qword-load + mask 0xFFFF — see src/kernel/core/loader/init_caps.pdx §L130.
  pub let _init_caps_count : u64 = 1

  // Single entry — see byte layout above.
  pub let _init_caps : [u64; 2] = [
    // slot=0, kind=KIND_IPC_ENDPOINT(5), rights=R_IPC_ALL(0x0B)
    0x0000000B00050000,
    // target_ptr: endpoint_id=1, direction=BIDI(2)
    0x0000000000020001
  ]

  // ============================================================================
  // Server-side hdr + payload scratch buffers (.bss @align(8)).
  //
  // hdr_scratch: 8 bytes for the packed message header (op@+0, ver@+1,
  //   flags@+2..3 LE, payload_len@+4..7 LE per frame.pdx §encode layout).
  //   Written by sys_ipc_recv's user_bounce_recv walker on drain; read +
  //   modified (bit-7 flip on op) + written by sys_ipc_reply's
  //   user_bounce_send walker on publish.
  //
  // payload_scratch: 4088-byte drain sink sized to FRAME_MAX_PAYLOAD (the
  //   maximum a single-slot endpoint holds per acpi-supervisor-schema §3).
  //   Round up to whole u64s -> 511 slots (511*8 = 4088, exact fit).
  //   Written by sys_ipc_recv on drain, read verbatim by sys_ipc_reply on
  //   the reply publish (echo semantic: payload is passed through unmodified).
  //
  // `let mut` because paideia-as's `pub let` (immutable) cannot accept a
  // bare `[u64; N]` .bss reservation at rodata scope — matches the
  // `pub let mut wait_status : [u64; 1] = uninit @align(8)` idiom in
  // src/user/init.pdx L59.
  // ============================================================================

  pub let mut hdr_scratch     : [u64; 1]   = uninit @align(8)
  pub let mut payload_scratch : [u64; 511] = uninit @align(8)

  // ============================================================================
  // _start — user program entry point. Infinite loop; never returns.
  //
  // Effects / capabilities
  // ----------------------
  // {mem, sysreg} @{cap}:
  //   mem     — hdr_scratch + payload_scratch reads/writes.
  //   sysreg  — every SYSCALL instruction touches IA32_LSTAR/IA32_CSTAR/
  //             IA32_FMASK indirectly via the CPU's fast-syscall path.
  //   cap     — the four IPC syscalls are cap-gated at the dispatch shim
  //             once M3-004 wires the cap-slot indirection (R20b post-M5).
  //
  // Register discipline
  // -------------------
  // r12 stashes payload_len returned by sys_ipc_recv across the bit-7
  // flip + sys_ipc_reply call (SysV callee-save; syscall preserves it).
  // rdi/rsi/rdx/rcx set fresh per syscall (SysV caller-save; SYSCALL
  // clobbers rcx into rip-save + r11 into rflags-save, but we reload
  // rcx on each call so the clobber is inert).
  //
  // Retry-on-error posture
  // ----------------------
  // sys_ipc_recv returns negative on -EFAULT / -EBADF (see
  // sys_ipc_recv.pdx §sentinels). If the endpoint id is bad or the walker
  // rejects our hdr/payload VAs (both cases are defensive — hdr_scratch
  // and payload_scratch are our own .bss so walker success is guaranteed),
  // we defensively `jl server_loop` back to retry instead of hlt'ing.
  // A tight retry loop is acceptable at R20b because (a) the failure modes
  // above are structural bugs in the substrate, not runtime conditions
  // the server can adapt to; (b) if the endpoint is empty the body blocks
  // via sched_block rather than returning EAGAIN.
  // ============================================================================

  pub let _start : () -> () !{mem, sysreg} @{cap} =
    fn () -> unsafe {
      effects: {mem, sysreg},
      capabilities: {cap},
      justification: "R20b.M5-001 (#1563): echo_server _start. Infinite request/reply loop over endpoint_id=1 (matches svc.echo -> endpoint_id=1 registration in kernel_main M5-001 witness). Sequence per iteration: (1) sys_ipc_recv(rdi=1, rsi=&hdr_scratch, rdx=&payload_scratch, rcx=4088) SC+ ID 40. rax = payload_len on success or negative errno (-EFAULT/-EBADF). On negative, defensively branch back to server_loop; the failure modes are structural (bad endpoint id / walker VA rejection) and the tight retry keeps behaviour deterministic without introducing a userspace error-handling policy at M5. r12 stashes payload_len across the bit-7 flip + reply call (SysV callee-save; SYSCALL preserves r12 per amd64 fast-syscall rules). (2) OR 0x80 into hdr_scratch's low byte via `lea rax, [rip+hdr_scratch] ; mov rcx, [rax] ; or rcx, 0x80 ; mov [rax], rcx` — u64-granularity load/or/store avoids any byte-level idiom, and since hdr's op field is byte 0 of the packed u64 (native LE per frame_encode/frame_decode round-trip), or'ing 0x80 into the low byte of the u64 exactly sets FRAME_OP_REPLY_BIT (=0x80 per frame.pdx §L112). sys_ipc_reply_body's pre-check reads byte 0 via user_read_bytes_via_walk + and 0x80 (see sys_ipc_reply.pdx §Step 2); a set bit accepts the reply, an unset bit rejects with -EINVAL. (3) sys_ipc_reply(rdi=1, rsi=&hdr_scratch, rdx=&payload_scratch, rcx=r12) SC+ ID 41. rax = 0 on success or pass-through send-body error; we do NOT branch on the return because the loop retry-on-recv-error absorbs any anomalies (a failed reply leaves the client waiting on recv, which then blocks in sched_block until we successfully reply on the next iteration — deterministic starvation-free convergence for M5 witness testing, not a production semantic). (4) jmp server_loop. Never returns. Effects union: {mem} for hdr_scratch/payload_scratch touches; {sysreg} for every SYSCALL. @{cap} because sys_ipc_recv/reply will be cap-gated once M3-004 lands. @no_frame because the loop is a tail-call replacement of the entire function body.",
      block: {
        server_loop:
          // ---- Step 1: sys_ipc_recv(id=1, hdr, payload, 4088). SC+ ID 40. ----
          mov rdi, 1;                        // endpoint_id (raw per M3 scaffolding)
          lea rsi, [rip + hdr_scratch];      // out_hdr_va (user VA — our .bss)
          lea rdx, [rip + payload_scratch];  // out_payload_va (user VA — our .bss)
          mov rcx, 4088;                     // out_payload_max = FRAME_MAX_PAYLOAD
          mov rax, 40;                       // SC+ ID 40
          syscall;
          // rax = payload_len [0..4088] or negative errno.
          cmp rax, 0;
          jl server_loop;                    // defensive retry on -EFAULT/-EBADF
          mov r12, rax;                      // stash payload_len (SysV callee-save)

          // ---- Step 2: bit-7 flip on hdr.op (byte 0 of the packed u64). ----
          // FRAME_OP_REPLY_BIT = 0x80 per frame.pdx §L112.
          lea rax, [rip + hdr_scratch];
          mov rcx, [rax];                    // rcx = packed hdr u64
          or rcx, 0x80;                      // set FRAME_OP_REPLY_BIT on op byte
          mov [rax], rcx;                    // write back

          // ---- Step 3: sys_ipc_reply(id=1, hdr, payload, len). SC+ ID 41. ----
          mov rdi, 1;                        // endpoint_id
          lea rsi, [rip + hdr_scratch];      // hdr_va (bit-7 already flipped)
          lea rdx, [rip + payload_scratch];  // payload_va (unchanged; echo)
          mov rcx, r12;                      // payload_len from recv
          mov rax, 41;                       // SC+ ID 41
          syscall;
          // rax = 0 (OK) or pass-through -EFAULT / -EAGAIN / -EINVAL.
          //   -EINVAL cannot fire here — we set bit 7 explicitly above.
          //   -EAGAIN cannot fire — endpoint was just drained by our recv.
          //   -EFAULT would indicate a walker regression on our own .bss,
          //   which is a structural bug the loop cannot recover from.
          //   We ignore rax and loop; a failed reply surfaces as the client
          //   blocking indefinitely, which the M5 fingerprint asserts against.

          jmp server_loop
      }
    } @no_frame
}
