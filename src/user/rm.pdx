// src/user/rm.pdx -- R58.M5 (paideia-os #1806) -- /bin/rm user binary
//
// Minimal self-contained /bin/rm: unlink one hardcoded path via the R56.M3-005
// sys_unlink syscall body (sysno 81, src/kernel/core/syscall/sys_unlink.pdx),
// then report success/failure and exit.
//
// -----------------------------------------------------------------------------
// argv[1] -- real since R62.M1-005 (#1836), falls back to /tmp/x
// -----------------------------------------------------------------------------
//
// argc/argv arrive in rdi/rsi at _start per the frozen execve ABI
// (design/user/execve-abi.md). When argc >= 2, argv[1] (a pointer
// directly into this process's own address space) is the unlink target,
// its length taken via an inline strlen scan capped at 255. When argc < 2
// (the shell invoked `rm` with no operand), the target falls back to the
// original M0 hardcoded "/tmp/x".
//
// -----------------------------------------------------------------------------
// Design choice -- self-contained, no syscall_shim link dependency
// -----------------------------------------------------------------------------
//
// Mirrors true.pdx / cat.pdx / ps.pdx: inlines the two SC+ syscalls it
// needs (sys_unlink=81, sys_exit=60) plus sys_debug_puts=12 for the
// fingerprint, directly at their call sites. One .pdx file, one .elf.
// build-user.sh classifies rm into its own object set for the same
// reason (no library pull-in).
//
// -----------------------------------------------------------------------------
// SC+ IDs used (src/user/syscall_shim.pdx §2.1 + R56.M3 addition)
// -----------------------------------------------------------------------------
//   12 = sys_debug_puts(buf, count)   -- fingerprint emit (bypasses tty state)
//   60 = sys_exit(status)             -- never returns
//   81 = sys_unlink(path_va, path_len) -- R56.M3-005 (#1794); rax = 0 on
//        success, negative errno otherwise (see sys_unlink.pdx §Failure
//        taxonomy). path_len is a walker CAP, not an exact strlen --
//        mirrors rootfs_seed.pdx's `mov rsi, 255` usage ahead of sys_mkdir.
//
// -----------------------------------------------------------------------------
// Register discipline
// -----------------------------------------------------------------------------
//
// rbx holds the resolved path pointer and r12 the resolved path length
// across the sys_unlink syscall (R62.M1-005 #1836 addition -- both are
// SysV callee-save and SYSCALL preserves them per amd64 fast-syscall
// rules). Otherwise straight-line: rdi/rsi/rdx/rax carry syscall args, and
// no prologue push is needed; entry rsp%16==0 per the PVH loader contract
// (matches ls.pdx / true.pdx posture) and every terminal path ends in
// sys_exit, so no epilogue is needed.
//
// -----------------------------------------------------------------------------
// Encoder-gap discipline
// -----------------------------------------------------------------------------
//
// No `add reg, [mem]` / `sub reg, [mem]` anywhere in this file (paideia-as
// does not support the memory-source arithmetic form). Every operation
// here is register-immediate or register-register. The inline argv[1]
// strlen scan uses `mov_b rax, [rbx + rcx*1]` (register+register*1
// addressing, proven throughout the tree -- e.g. src/kernel/core/fs/
// pdxfs_lite/create.pdx) with the standard `xor rax, rax` pre-zero so the
// byte compare observes only the loaded byte (paideia-as #1248).
//
// -----------------------------------------------------------------------------
// Reserved-label discipline
// -----------------------------------------------------------------------------
//
// Every label is prefixed `rm_` per the paideia-as reserved-word
// convention (`loop`, `if`, `top`, `done` etc. are keywords).

module Rm = structure {

  // Hardcoded M0 target path. Absolute + NUL-terminated.
  pub let rm_path : [u8; 7] = "/tmp/x\0"

  // Fingerprint strings -- routed through sys_debug_puts (SC+ ID 12)
  // rather than sys_write so a broken stdout does not swallow the
  // diagnostic (mirrors ls.pdx §112 rationale). Storage carries the
  // trailing NUL for strlen-safety; the wire length (rm_*_len) excludes
  // it. ASCII "--" used in place of an em-dash so the line stays 7-bit
  // ASCII (see rootfs_seed.pdx L23 note).
  pub let rm_msg_ok    : [u8; 22] = "rm ok -- path=/tmp/x\n\0"
  pub let rm_msg_ok_len : u64 = 21

  pub let rm_msg_fail    : [u8; 16] = "RM UNLINK FAIL\n\0"
  pub let rm_msg_fail_len : u64 = 15

  // -------------------------------------------------------------------------
  // _start -- user program entry point. Never returns.
  //
  // Effects/caps:
  //   mem     -- reads rm_path / rm_msg_* rodata.
  //   sysreg  -- every SYSCALL clobbers rcx (RIP)/r11 (rflags).
  //   fs      -- sys_unlink.
  //   sched   -- sys_exit terminates the task.
  //
  // @no_frame because the function ends in sys_exit on every terminal
  // path (never returns) -- no epilogue is needed and no auto-emitted
  // rbp prologue is wanted.
  // -------------------------------------------------------------------------
  pub let _start : () -> () !{mem, sysreg} @{fs, sched} =
    fn () -> unsafe {
      effects: {mem, sysreg},
      capabilities: {fs, sched},
      justification: "R58.M5 (#1806) + R62.M1-005 (#1836): /bin/rm _start. Inlines sys_unlink (SC+ ID 81, R56.M3-005 kernel body at src/kernel/core/syscall/sys_unlink.pdx), sys_debug_puts (SC+ ID 12) and sys_exit (SC+ ID 60) -- no syscall_shim link dependency, same one-file-one-ELF pattern as true.pdx / cat.pdx / ps.pdx. #1836: Phase 0 reads argc (rdi) per the frozen execve ABI (design/user/execve-abi.md); when argc >= 2, rbx = argv[1] (`[rsi + 8]`, own-aspace pointer, no walker needed) and r12 = an inline byte-scan strlen of it capped at 255 (rm_strlen_loop: `xor rax, rax; mov_b rax, [rbx + rcx*1]; cmp rax, 0`, the paideia-as #1248 zero-extend-before-compare idiom used throughout this tree); when argc < 2, rbx = &rm_path ('/tmp/x') and r12 = 255 (the original walker-cap default). Sequence: (1) sys_unlink(rbx, r12) -- rdi = rbx, rsi = r12, rax = 81, syscall. rax == 0 -> success: emit 'rm ok -- path=/tmp/x\\n' via sys_debug_puts (unchanged literal text regardless of the real target -- see design/user/execve-abi.md §Migrated tools), sys_exit(0). rax != 0 (any negative errno per sys_unlink.pdx §Failure taxonomy -- -EFAULT/-EINVAL/-ENOENT) -> emit 'RM UNLINK FAIL\\n' via sys_debug_puts, sys_exit(1). rbx/r12 are SysV callee-save and survive the syscall per amd64 fast-syscall rules. @no_frame because every terminal path ends in sys_exit; entry rsp%16==0 per the PVH loader contract (matches ls.pdx / true.pdx posture), no push emitted, no epilogue needed. Encoder-gap discipline: no `add reg, [mem]` / `sub reg, [mem]` anywhere. Reserved-label discipline: every label is prefixed `rm_`.",
      block: {
        // ============================================================
        // Phase 0 (#1836) -- resolve target path from argv[1], or fall
        // back to the M0 hardcoded /tmp/x default.
        // ============================================================
        cmp rdi, 2;
        jl  rm_use_default;
        mov rbx, [rsi + 8];                  // rbx = argv[1] (own aspace, direct deref)
        xor rcx, rcx;                        // rcx = strlen cursor

      rm_strlen_loop:
        xor rax, rax;                        // pre-zero: mov_b does not zero-extend
        mov_b rax, [rbx + rcx*1];
        cmp rax, 0;
        je  rm_strlen_done;
        add rcx, 1;
        cmp rcx, 255;
        jae rm_strlen_done;                  // cap at 255
        jmp rm_strlen_loop;

      rm_strlen_done:
        mov r12, rcx;                        // r12 = path_len
        jmp rm_path_ready;

      rm_use_default:
        lea rbx, [rip + rm_path];
        mov r12, 255;                        // path_len cap (walker hint)

      rm_path_ready:
        // ============================================================
        // Phase 1 -- sys_unlink(rbx=path_va, r12=path_len)
        // ============================================================
        mov rdi, rbx;
        mov rsi, r12;
        mov rax, 81;                         // SC+ ID 81 = sys_unlink
        syscall;

        cmp rax, 0;
        jne rm_fail;

        // ============================================================
        // Phase 2 -- success: sys_debug_puts(rm_msg_ok, 21); sys_exit(0)
        // ============================================================
        lea rdi, [rip + rm_msg_ok];
        mov rsi, 21;                         // rm_msg_ok_len
        mov rax, 12;                         // SC+ ID 12 = sys_debug_puts
        syscall;

        xor rdi, rdi;                        // status = 0 (OK)
        mov rax, 60;                         // SC+ ID 60 = sys_exit
        syscall;
        hlt;

      rm_fail:
        // ============================================================
        // Phase 3 -- fail: sys_debug_puts(rm_msg_fail, 15); sys_exit(1)
        // ============================================================
        lea rdi, [rip + rm_msg_fail];
        mov rsi, 15;                         // rm_msg_fail_len
        mov rax, 12;                         // SC+ ID 12 = sys_debug_puts
        syscall;

        mov rdi, 1;                          // status = 1 (unlink failed)
        mov rax, 60;                         // SC+ ID 60 = sys_exit
        syscall;
        hlt
      }
    } @no_frame
}
