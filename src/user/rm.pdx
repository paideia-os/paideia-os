// src/user/rm.pdx -- R58.M5 (paideia-os #1806) -- /bin/rm user binary
//
// Minimal self-contained /bin/rm: unlink one hardcoded path via the R56.M3-005
// sys_unlink syscall body (sysno 81, src/kernel/core/syscall/sys_unlink.pdx),
// then report success/failure and exit.
//
// -----------------------------------------------------------------------------
// argv[1] -- M0 hardcoded path (per sys_execve_shim.pdx §Non-Scope)
// -----------------------------------------------------------------------------
//
// Per src/user/ls.pdx §argv/envp note: execve does NOT populate argc/argv
// onto the user stack at M0 (see sys_execve_shim.pdx §Non-Scope), so
// argv[1] is not reachable from _start. This binary hardcodes the target
// path to "/tmp/x" pending execve argv wire-up (see sys_execve_shim.pdx
// §Non-Scope). Once argv-passing lands, rm's target collapses to the real
// argv[1] with no change to the syscall sequence below.
//
// -----------------------------------------------------------------------------
// Design choice -- self-contained, no syscall_shim link dependency
// -----------------------------------------------------------------------------
//
// Mirrors true.pdx / cat.pdx / ps.pdx: inlines the two SC+ syscalls it
// needs (sys_unlink=81, sys_exit=60) plus sys_debug_puts=12 for the
// fingerprint, directly at their call sites. One .pdx file, one .elf.
// build-user.sh classifies rm into its own object set for the same
// reason (no library pull-in).
//
// -----------------------------------------------------------------------------
// SC+ IDs used (src/user/syscall_shim.pdx §2.1 + R56.M3 addition)
// -----------------------------------------------------------------------------
//   12 = sys_debug_puts(buf, count)   -- fingerprint emit (bypasses tty state)
//   60 = sys_exit(status)             -- never returns
//   81 = sys_unlink(path_va, path_len) -- R56.M3-005 (#1794); rax = 0 on
//        success, negative errno otherwise (see sys_unlink.pdx §Failure
//        taxonomy). path_len is a walker CAP, not an exact strlen --
//        mirrors rootfs_seed.pdx's `mov rsi, 255` usage ahead of sys_mkdir.
//
// -----------------------------------------------------------------------------
// Register discipline
// -----------------------------------------------------------------------------
//
// Straight-line: rdi/rsi/rdx/rax carry syscall args, nothing survives
// across a syscall that a later instruction needs, so no callee-save
// register is used at all. No prologue push; entry rsp%16==0 per the
// PVH loader contract (matches ls.pdx / true.pdx posture) and every
// terminal path ends in sys_exit, so no epilogue is needed.
//
// -----------------------------------------------------------------------------
// Encoder-gap discipline
// -----------------------------------------------------------------------------
//
// No `add reg, [mem]` / `sub reg, [mem]` anywhere in this file (paideia-as
// does not support the memory-source arithmetic form). Every operation
// here is register-immediate or register-register.
//
// -----------------------------------------------------------------------------
// Reserved-label discipline
// -----------------------------------------------------------------------------
//
// The one internal label is prefixed `rm_` per the paideia-as reserved-
// word convention (`loop`, `if`, `top`, `done` etc. are keywords).

module Rm = structure {

  // Hardcoded M0 target path. Absolute + NUL-terminated.
  pub let rm_path : [u8; 7] = "/tmp/x\0"

  // Fingerprint strings -- routed through sys_debug_puts (SC+ ID 12)
  // rather than sys_write so a broken stdout does not swallow the
  // diagnostic (mirrors ls.pdx §112 rationale). Storage carries the
  // trailing NUL for strlen-safety; the wire length (rm_*_len) excludes
  // it. ASCII "--" used in place of an em-dash so the line stays 7-bit
  // ASCII (see rootfs_seed.pdx L23 note).
  pub let rm_msg_ok    : [u8; 22] = "rm ok -- path=/tmp/x\n\0"
  pub let rm_msg_ok_len : u64 = 21

  pub let rm_msg_fail    : [u8; 16] = "RM UNLINK FAIL\n\0"
  pub let rm_msg_fail_len : u64 = 15

  // -------------------------------------------------------------------------
  // _start -- user program entry point. Never returns.
  //
  // Effects/caps:
  //   mem     -- reads rm_path / rm_msg_* rodata.
  //   sysreg  -- every SYSCALL clobbers rcx (RIP)/r11 (rflags).
  //   fs      -- sys_unlink.
  //   sched   -- sys_exit terminates the task.
  //
  // @no_frame because the function ends in sys_exit on every terminal
  // path (never returns) -- no epilogue is needed and no auto-emitted
  // rbp prologue is wanted.
  // -------------------------------------------------------------------------
  pub let _start : () -> () !{mem, sysreg} @{fs, sched} =
    fn () -> unsafe {
      effects: {mem, sysreg},
      capabilities: {fs, sched},
      justification: "R58.M5 (#1806): /bin/rm _start. Inlines sys_unlink (SC+ ID 81, R56.M3-005 kernel body at src/kernel/core/syscall/sys_unlink.pdx), sys_debug_puts (SC+ ID 12) and sys_exit (SC+ ID 60) -- no syscall_shim link dependency, same one-file-one-ELF pattern as true.pdx / cat.pdx / ps.pdx. Sequence: (1) sys_unlink(rm_path, 255) -- rdi = path VA (rip-relative lea), rsi = 255 (walker cap, not strlen -- mirrors rootfs_seed.pdx's own `mov rsi, 255` ahead of sys_mkdir), rax = 81, syscall. rax == 0 -> success: emit 'rm ok -- path=/tmp/x\\n' via sys_debug_puts, sys_exit(0). rax != 0 (any negative errno per sys_unlink.pdx §Failure taxonomy -- -EFAULT/-EINVAL/-ENOENT) -> emit 'RM UNLINK FAIL\\n' via sys_debug_puts, sys_exit(1). No callee-save register is used: nothing needs to survive across a syscall boundary that a later instruction reads, so the whole body is straight-line rdi/rsi/rdx/rax traffic. @no_frame because every terminal path ends in sys_exit; entry rsp%16==0 per the PVH loader contract (matches ls.pdx / true.pdx posture), no push emitted, no epilogue needed. Encoder-gap discipline: no `add reg, [mem]` / `sub reg, [mem]` anywhere. Reserved-label discipline: the one internal label is prefixed `rm_`. argv[1] is IGNORED at R17.M0 per sys_execve_shim.pdx §Non-Scope (execve does not populate the user stack with argc/argv yet), so the target path is hardcoded to /tmp/x pending the execve argv wire-up.",
      block: {
        // ============================================================
        // Phase 1 -- sys_unlink(rm_path, path_len=255)
        // ============================================================
        lea rdi, [rip + rm_path];
        mov rsi, 255;                        // path_len cap (walker hint)
        mov rax, 81;                         // SC+ ID 81 = sys_unlink
        syscall;

        cmp rax, 0;
        jne rm_fail;

        // ============================================================
        // Phase 2 -- success: sys_debug_puts(rm_msg_ok, 21); sys_exit(0)
        // ============================================================
        lea rdi, [rip + rm_msg_ok];
        mov rsi, 21;                         // rm_msg_ok_len
        mov rax, 12;                         // SC+ ID 12 = sys_debug_puts
        syscall;

        xor rdi, rdi;                        // status = 0 (OK)
        mov rax, 60;                         // SC+ ID 60 = sys_exit
        syscall;
        hlt;

      rm_fail:
        // ============================================================
        // Phase 3 -- fail: sys_debug_puts(rm_msg_fail, 15); sys_exit(1)
        // ============================================================
        lea rdi, [rip + rm_msg_fail];
        mov rsi, 15;                         // rm_msg_fail_len
        mov rax, 12;                         // SC+ ID 12 = sys_debug_puts
        syscall;

        mov rdi, 1;                          // status = 1 (unlink failed)
        mov rax, 60;                         // SC+ ID 60 = sys_exit
        syscall;
        hlt
      }
    } @no_frame
}
