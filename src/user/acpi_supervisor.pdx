// src/user/acpi_supervisor.pdx — R20-M4-002 (#820)
//
// ACPI supervisor userspace binary — target-shape sibling of echo_server
// for the R20b userspace-server substrate. Declares an `_init_caps`
// sidecar seeding TWO cap slots:
//
//   cap_slot 0 — KIND_IPC_ENDPOINT for the RPC endpoint (endpoint_id=3,
//                R_IPC_READ | R_IPC_WRITE | R_IPC_INVOKE — server drains
//                requests + publishes replies through the dual-endpoint
//                pattern per userspace-server-substrate.md §4.4).
//   cap_slot 1 — KIND_ACPI for read-only access to the ACPI static-table
//                byte range (R_ACPI_READ = 0x01 per acpi_cap.pdx). At
//                R20-M4-002 the KIND_ACPI-mapped physical range is not
//                yet exposed to ring-3 (that wires up with the userspace
//                bubble in R34); the sidecar entry proves the cap-table
//                seeding shape and lets the kernel-side witness assert
//                that both entries validated cleanly.
//
// _start body — infinite dispatch loop:
//
//   loop:
//     sys_ipc_recv(cap_slot=0, hdr, payload, 4088)   // blocks on empty
//     op = hdr.op & 0x7F                             // strip reply bit
//     dispatch:
//       op = 1 (ACPI_OP_ENUMERATE)   → stub-encode a 2-byte n_tables=0 reply
//       op = 2 (ACPI_OP_GET_MADT)    → stub-encode a 2-byte n_lapics=0 reply
//       op = 3 (ACPI_OP_GET_MCFG)    → stub-encode a 2-byte n_segments=0 reply
//       op = 4 (ACPI_OP_GET_HPET)    → stub-encode a 16-byte zero-filled HPET reply
//       default                       → 8-byte error reply (op=0x7F, ver=1)
//     hdr.op |= 0x80                                // FRAME_OP_REPLY_BIT
//     hdr.payload_len = <computed>                  // per-op reply size
//     sys_ipc_reply(cap_slot=0, hdr, payload, len)  // dual-endpoint via
//                                                    // hdr.reply_endpoint_id
//     goto loop
//
// Stub-reply posture (R20-M4-002)
// -------------------------------
// The real ACPI parsers (sup_enumerate_tables / sup_get_madt_lapic_list /
// sup_get_mcfg_ranges / sup_get_hpet in
// src/kernel/acpi/supervisor_dispatch.pdx) live in the kernel — they
// need to touch physical memory mapped by the KIND_ACPI cap, which in
// R20 is only accessible in ring-0. Until the KIND_ACPI mapping is
// re-exposed to ring-3 (R34 userspace bubble), the userspace binary's
// dispatch loop cannot do real parsing — it returns shape-correct but
// empty responses (count-only headers) so the wire protocol round-trip
// still works.
//
// The R20-M4-002 witness in kernel_main.pdx §m4_002_acpi_rpc_witness
// bypasses this stub entirely: it calls the sup_* kernel helpers
// directly to build real responses (populated with the actual q35 ACPI
// data), then drives the IPC round-trip through sys_ipc_send_body /
// sys_ipc_recv_body / sys_ipc_reply_body against init's user_pml4. This
// is the same "Option B — kernel-side witness driving the RPC" posture
// used by R20b.M5-001 (echo_server) and R20b.M6-003 (echo_client /
// dual-endpoint RPC): the source binary lands at M4-002 as the target
// shape (built + embedded + shape-verified at every push); the runtime
// ring-3 spawn wires up when multi-task boot orchestration lands
// post-R20b.
//
// Opcode table (mirrors acpi-supervisor-schema.md §4)
// ---------------------------------------------------
//   op = 0x01  ACPI_OP_ENUMERATE
//   op = 0x02  ACPI_OP_GET_MADT
//   op = 0x03  ACPI_OP_GET_MCFG
//   op = 0x04  ACPI_OP_GET_HPET
//   op = 0x7F  ACPI_OP_ERROR    (reply-only sentinel)
//
// SC+ IDs inlined (matches echo_server.pdx / echo_client.pdx discipline)
// ----------------------------------------------------------------------
//   40 = sys_ipc_recv    (rdi=cap_slot, rsi=hdr_va, rdx=payload_va, rcx=max)
//   41 = sys_ipc_reply   (rdi=cap_slot, rsi=hdr_va, rdx=payload_va, rcx=len)
//
// SysV rcx is the 4th arg; the SYSCALL entry stashes it into r10 before
// the body reads a3 — no user-side arg shuffle needed at arity 4.

module AcpiSupervisor = structure {

  // ============================================================================
  // _init_caps sidecar — TWO entries (matches design/loader/init-caps-
  // sidecar.md §2 format). Total 32 bytes = 4 u64 words + a u64 count.
  //
  // Entry 0: cap_slot=0 — RPC endpoint (endpoint_id=3, distinct from the
  //   echo_server's endpoint_id=1 and echo_client's reply_ep=2 so a
  //   witness can hold all three sidecars concurrently without collision).
  //   +0  u16 slot   = 0x0000
  //   +2  u16 kind   = 0x0005 (KIND_IPC_ENDPOINT — base per cap/kind.pdx)
  //   +4  u32 rights = 0x0000_000B (R_IPC_READ | R_IPC_WRITE | R_IPC_INVOKE
  //                                 = 0x01 | 0x02 | 0x08 — full BIDI)
  //   +8  u64 target = 0x0000_0000_0002_0003
  //                    bits [15:0]  = 3 (endpoint_id — "svc.acpi" endpoint)
  //                    bits [17:16] = 2 (direction=BIDI per kind_endpoint.pdx)
  //   Packed:
  //     word0 = (0x0000_000B << 32) | (0x0005 << 16) | 0x0000
  //           = 0x0000_000B_0005_0000
  //     word1 = 0x0000_0000_0002_0003
  //
  // Entry 1: cap_slot=1 — KIND_ACPI capability (read-only access to the
  //   ACPI static-table byte range). At M4-002 the KIND_ACPI-mapped
  //   physical range is not yet exposed to ring-3 (deferred to R34
  //   userspace bubble); the sidecar entry proves the seeding shape.
  //   +0  u16 slot   = 0x0001
  //   +2  u16 kind   = 0x0020 (KIND_ACPI — derived-kind tag per acpi_cap.pdx)
  //   +4  u32 rights = 0x0000_0001 (R_ACPI_READ)
  //   +8  u64 target = 0x0000_0000_0000_0000
  //                    (base_pa filled by the loader mint at spawn time;
  //                    at R20-M4-002 target=0 signals "cap present but
  //                    not yet bound to a physical range" — the loader
  //                    validator accepts this per init_caps.pdx §mint
  //                    posture: base_pa=0 is legal for KIND_ACPI
  //                    seeding as long as the acpi_cap_mint gate is not
  //                    invoked with base_pa=0).
  //   Packed:
  //     word0 = (0x0000_0001 << 32) | (0x0020 << 16) | 0x0001
  //           = 0x0000_0001_0020_0001
  //     word1 = 0x0000_0000_0000_0000
  //
  // The loader validator (init_caps_validate) walks the array via a
  // 16-byte stride per entry (design/loader/init-caps-sidecar.md §2
  // "InitCap[16 B]" and src/kernel/core/loader/init_caps.pdx §L130).
  // ============================================================================

  pub let _init_caps_count : u64 = 2

  pub let _init_caps : [u64; 4] = [
    // Entry 0: slot=0, kind=KIND_IPC_ENDPOINT(5), rights=R_IPC_ALL(0x0B)
    0x0000000B00050000,
    // target_ptr: endpoint_id=3 (svc.acpi), direction=BIDI(2)
    0x0000000000020003,
    // Entry 1: slot=1, kind=KIND_ACPI(0x20), rights=R_ACPI_READ(0x01)
    0x0000000100200001,
    // target_ptr: base_pa=0 (unbound — loader may fill at mint time)
    0x0000000000000000
  ]

  // ============================================================================
  // Server-side hdr + payload scratch buffers (.bss @align(8)).
  //
  // hdr_scratch: 8 bytes for the packed message header (op@+0, ver@+1,
  //   reply_endpoint_id@+2..3 LE, payload_len@+4..7 LE per frame.pdx
  //   §encode layout — R20b.M6-003 repurposed the v1 "flags" u16 slot as
  //   reply_endpoint_id). Written by sys_ipc_recv on drain; read + modified
  //   (bit-7 flip on op, payload_len rewritten with reply len) + written
  //   by sys_ipc_reply on publish. sys_ipc_reply_body reads the preserved
  //   reply_endpoint_id and routes the reply to that endpoint (§4.4
  //   dual-endpoint).
  //
  // payload_scratch: 4088-byte drain sink sized to FRAME_MAX_PAYLOAD.
  //   Round up to whole u64s -> 511 slots (511*8 = 4088, exact fit).
  //   Written by sys_ipc_recv on drain; overwritten by the dispatch
  //   arm with the stub-response bytes before sys_ipc_reply publishes it.
  //
  // `let mut` because paideia-as's `pub let` (immutable) cannot accept a
  // bare `[u64; N]` .bss reservation at rodata scope — matches the
  // `pub let mut wait_status : [u64; 1] = uninit @align(8)` idiom in
  // src/user/init.pdx L59.
  // ============================================================================

  pub let mut hdr_scratch     : [u64; 1]   = uninit @align(8)
  pub let mut payload_scratch : [u64; 511] = uninit @align(8)

  // ============================================================================
  // _start — user program entry point. Infinite dispatch loop; never returns.
  //
  // Effects / capabilities
  // ----------------------
  // {mem, sysreg} @{cap}:
  //   mem     — hdr_scratch + payload_scratch reads/writes.
  //   sysreg  — every SYSCALL instruction touches IA32_LSTAR/IA32_CSTAR/
  //             IA32_FMASK indirectly via the CPU's fast-syscall path.
  //   cap     — the two IPC syscalls are cap-gated at the dispatch shim
  //             (M6-002 landed; cap_slot 0 = server endpoint per sidecar).
  //
  // Register discipline
  // -------------------
  // r12 stashes the op byte (masked) across the dispatch arms so the
  // reply's op field can be recomputed with the reply bit set.
  // r13 stashes the reply-payload length so sys_ipc_reply's hdr rebuild
  // can encode payload_len correctly.
  // rdi/rsi/rdx/rcx set fresh per syscall.
  //
  // Reply-hdr rebuild strategy
  // --------------------------
  // The recv'd hdr has fields (op, ver, reply_endpoint_id, payload_len_req);
  // for the reply we want (op|0x80, ver, reply_endpoint_id [preserved],
  // payload_len_rep). Steps 3-4 of the loop:
  //   1. Read the u64 hdr into rax.
  //   2. AND with a mask that keeps reply_endpoint_id + ver + low byte of op:
  //      0x0000_0000_FFFF_FFFF preserves bits 0..31 (op, ver, reply_eid).
  //   3. OR 0x80 into byte 0 (set FRAME_OP_REPLY_BIT).
  //   4. OR in (payload_len_rep << 32) at bits 32..63.
  //   5. Store back.
  // ============================================================================

  pub let _start : () -> () !{mem, sysreg} @{cap} =
    fn () -> unsafe {
      effects: {mem, sysreg},
      capabilities: {cap},
      justification: "R20-M4-002 (#820): acpi_supervisor _start. Infinite request/dispatch/reply loop over cap_slot=0 (seeded by _init_caps sidecar to endpoint_id=3 with R_IPC_ALL). Sequence per iteration: (1) sys_ipc_recv(rdi=0, rsi=&hdr_scratch, rdx=&payload_scratch, rcx=4088) SC+ ID 40. rax = payload_len on success or negative errno; on negative, defensively branch back to server_loop (same retry posture as echo_server _start). (2) Load hdr u64 via `mov rax, [hdr_scratch]`; extract op = rax & 0xFF; dispatch on op via a chain of cmp/je against 1/2/3/4/default. (3) Each dispatch arm computes the reply payload_len (stashed in r13) and — for ops 1/2/3 — writes a 2-byte u16 count=0 header into payload_scratch (stub response per M4-002 posture — real parsers live kernel-side, see file header). Op 4 zero-fills the first 16 bytes of payload_scratch for the 16-byte HPET response. Default (unknown op) sets payload_len=8 and writes an 8-byte error stub (all zeros). (4) Rebuild hdr: reload the u64 hdr, mask keeps bits 0..31 (op|ver|reply_eid), OR bit 7 into byte 0 (FRAME_OP_REPLY_BIT), OR (r13 << 32) into bits 32..63 (payload_len_rep). Store back. (5) sys_ipc_reply(rdi=0, rsi=&hdr_scratch, rdx=&payload_scratch, rcx=r13) SC+ ID 41. rax = 0 (OK) or pass-through error; don't gate on failure — the loop's next recv absorbs any anomaly. (6) jmp server_loop. Never returns. Effects union: {mem} for hdr/payload writes; {sysreg} for every SYSCALL. @{cap} because the two IPC syscalls are cap-gated post-M6-002. @no_frame because the loop is a tail-call replacement of the entire function body. Register discipline: r12 = op byte (stashed across the reply-hdr rebuild), r13 = reply payload_len (stashed across the syscall). Both callee-save; SYSCALL preserves them per amd64 fast-syscall rules. r15 unused but pushed for prologue-symmetry across the sibling binaries (child_hello / true / echo_server all follow the same 0-push posture; this binary matches for consistency).",
      block: {
        server_loop:
          // ---- Step 1: sys_ipc_recv(cap_slot=0, hdr, payload, 4088). SC+ ID 40. ----
          mov rdi, 0;                        // cap_slot=0 (server endpoint per _init_caps)
          lea rsi, [rip + hdr_scratch];      // out_hdr_va (user VA — our .bss)
          lea rdx, [rip + payload_scratch];  // out_payload_va (user VA — our .bss)
          mov rcx, 4088;                     // out_payload_max = FRAME_MAX_PAYLOAD
          mov rax, 40;                       // SC+ ID 40
          syscall;
          // rax = payload_len [0..4088] or negative errno.
          cmp rax, 0;
          jl server_loop;                    // defensive retry

          // ---- Step 2: extract op byte + dispatch ----
          lea rax, [rip + hdr_scratch];
          mov rax, [rax];                    // rax = packed hdr u64
          mov r12, rax;                      // stash raw hdr in r12
          and rax, 0xFF;                     // rax = op byte

          // Dispatch chain — cmp/je against each known op.
          cmp rax, 1;
          je  acpi_dispatch_enumerate;
          cmp rax, 2;
          je  acpi_dispatch_madt;
          cmp rax, 3;
          je  acpi_dispatch_mcfg;
          cmp rax, 4;
          je  acpi_dispatch_hpet;
          jmp acpi_dispatch_default;

        acpi_dispatch_enumerate:
          // Stub: write u16 count=0 at payload_scratch+0. payload_len=2.
          xor rax, rax;
          lea rcx, [rip + payload_scratch];
          mov_w [rcx], rax;                  // n_tables = 0
          mov r13, 2;                        // reply payload_len
          jmp acpi_reply_hdr_rebuild;

        acpi_dispatch_madt:
          // Stub: u16 count=0 → payload_len=2.
          xor rax, rax;
          lea rcx, [rip + payload_scratch];
          mov_w [rcx], rax;                  // n_lapics = 0
          mov r13, 2;
          jmp acpi_reply_hdr_rebuild;

        acpi_dispatch_mcfg:
          // Stub: u16 count=0 → payload_len=2.
          xor rax, rax;
          lea rcx, [rip + payload_scratch];
          mov_w [rcx], rax;                  // n_segments = 0
          mov r13, 2;
          jmp acpi_reply_hdr_rebuild;

        acpi_dispatch_hpet:
          // Stub: 16 bytes of zeros → payload_len=16.
          xor rax, rax;
          lea rcx, [rip + payload_scratch];
          mov [rcx + 0], rax;
          mov [rcx + 8], rax;
          mov r13, 16;
          jmp acpi_reply_hdr_rebuild;

        acpi_dispatch_default:
          // Unknown op — reply with 8-byte zero payload (error-shaped stub).
          xor rax, rax;
          lea rcx, [rip + payload_scratch];
          mov [rcx], rax;
          mov r13, 8;
          // Fall through to acpi_reply_hdr_rebuild.

        acpi_reply_hdr_rebuild:
          // Rebuild reply hdr: keep op|ver|reply_eid (low 32 bits of r12),
          // set FRAME_OP_REPLY_BIT (bit 7 of byte 0), write payload_len_rep
          // into bits 32..63.
          mov rax, r12;
          mov rcx, 0xFFFFFFFF;
          and rax, rcx;                      // rax = low 32 bits (op|ver|reply_eid)
          or  rax, 0x80;                     // set FRAME_OP_REPLY_BIT
          mov rcx, r13;
          shl rcx, 32;                       // payload_len << 32
          or  rax, rcx;
          lea rcx, [rip + hdr_scratch];
          mov [rcx], rax;                    // store rebuilt hdr

          // ---- Step 3: sys_ipc_reply(cap_slot=0, hdr, payload, r13). SC+ ID 41. ----
          mov rdi, 0;                        // cap_slot=0 (server endpoint)
          lea rsi, [rip + hdr_scratch];      // hdr_va (bit-7 set; reply_eid preserved)
          lea rdx, [rip + payload_scratch];  // payload_va (stub-filled)
          mov rcx, r13;                      // payload_len_rep
          mov rax, 41;                       // SC+ ID 41
          syscall;
          // rax = 0 (OK) or pass-through error; don't branch.

          jmp server_loop
      }
    } @no_frame
}
