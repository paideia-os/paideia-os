// src/user/sh_dispatch.pdx — R222.M7 (paideia-os #2664, umbrella #2486) +
//                            R229.M11 (paideia-os #2729, umbrella #2493)
//
// /bin/sh front-end dispatcher: route to legacy or semantic shell based on
// `PDX_SHELL_MODE` envp variable.
//
// =============================================================================
// SECTION 0  R229.M11 POSTURE — WHAT CHANGED, WHAT IS REAL, WHAT IS DEFERRED
// =============================================================================
//
// R229.M11 FLIP (paideia-os #2729):
//   The default routing policy has been INVERTED relative to R222.M7. At M7
//   the unset / unknown / missing-envp branches all fell through to the
//   legacy shell -- preserving every existing workflow byte-for-byte while
//   the semantic shell's dependency chain was still being wired. At R229.M11
//   the semantic path becomes the default and the legacy path requires an
//   EXPLICIT opt-out (`PDX_SHELL_MODE=legacy`). The semantic path is still
//   stubbed at M11 -- `_sd_semantic_stub` still tail-calls `_sd_legacy_fallback`
//   after emitting the "not yet available" marker -- so the user-visible
//   behavior remains stable (every invocation still ends up in the legacy
//   shell), but the DEFAULT path now routes through the semantic entry
//   fingerprint. When the real semantic-shell body replaces the stub
//   (sibling landing per `design/shell/legacy-shell-retirement.md`), the
//   M11 flip becomes the semantic-shell default without further edits
//   to this file.
//
//   Only two sites inside _sd_route changed at M11:
//     * The byte-compare target: sd_semantic_val -> sd_legacy_val, with the
//       match length constant 9 -> 7 (the "legacy\0" NUL-terminated literal).
//     * The jump polarity at the match / miss sites: value-match now routes
//       to sd_route_legacy (explicit opt-out), value-miss and every fall-
//       through case (envp==0, scan exhausted, no PDX_SHELL_MODE= entry)
//       now route to sd_route_semantic (the new default).
//
//   The `legacy-sh` alias (hard-link to shell.elf via tools/build-user.sh)
//   stays bit-identical across the flip; retirement of the alias is a
//   future landing per `design/shell/legacy-shell-retirement.md` §5.
//
// REAL at R229.M11 (inherited from M7):
//   (a) The front-end binary builds + links clean as a self-contained ELF
//       (one-file-one-ELF, mirrors true.pdx / cat.pdx / run.pdx classification).
//   (b) `_sd_route` scans envp for `PDX_SHELL_MODE=` using the shell_home_scan
//       byte-compare idiom (paideia-as #1248 mitigation).
//   (c) `_sd_semantic_stub` emits a semantic-not-yet-available marker through
//       sys_debug_puts, then tail-calls `_sd_legacy_fallback` so the user's
//       command still runs under the legacy shell. This stub body is
//       UNCHANGED at M11 -- the flip is in _sd_route's routing policy, not
//       in the stub itself. Replacing the stub body with the real semantic
//       entry remains a single-site edit per §SECTION 7 of sh-dispatch.md.
//   (d) `_sd_legacy_fallback` emits a legacy-mode marker, then sys_execve's
//       `/bin/legacy-sh` with the original argv + envp. UNCHANGED at M11.
//
// DEFERRED (post-R229.M11):
//   (i)   Real semantic-shell entry replaces _sd_semantic_stub's body. This
//         lands when the semantic shell's dependencies (R222..R228) are
//         fully wired and soak-tested per the umbrella #2493 roadmap.
//   (ii)  `legacy-sh` alias retirement. The hard-linked alias stays alive
//         for one release cycle (per `design/shell/legacy-shell-retirement.md`
//         §5) so any downstream script with `#!/bin/legacy-sh` or an
//         explicit `PDX_SHELL_MODE=legacy` incantation keeps working. After
//         the release-cycle grace window the alias is dropped from
//         tools/build-user.sh and this file's `_sd_legacy_fallback` body
//         becomes a hard error.
//   (iii) `-c '...'` command-line option parsing. Both shells today ignore
//         argv past argv[0]; a future landing wires it on both sides.
//
// =============================================================================
// SECTION 1  SC+ IDS USED
// =============================================================================
//
// Inlined at every syscall site -- same one-file-one-ELF discipline as
// cat.pdx / true.pdx / run.pdx (no syscall_shim link dependency).
//
//    1  = sys_write(fd, buf, count)        -> count written or -errno
//   12  = sys_debug_puts(buf, count)       -- fingerprint emit (bypasses tty)
//   59  = sys_execve(path, argv, envp)     -> never returns, or -errno
//   60  = sys_exit(status)                 -- never returns
//
// =============================================================================
// SECTION 2  ENCODER DISCIPLINE (feedback_pdx_encoder_pitfalls, 2026-10-15)
// =============================================================================
//
//   * cmp rN, 0           never `test rN, rN`
//   * mov r10, imm64      staging; never `and r11, imm64`
//   * shl rN, 3 / 4       stride multiplies; never 2-op `imul r, imm`
//   * single-line         `pub let name : [u8; N] = "..."`  (no multiline body)
//   * module basename     ShDispatch matches sh_dispatch.pdx (CamelCase from
//                         underscored basename -- same rule as ChildHello /
//                         PdxProduce / ElevateBrokerDaemon)
//   * fingerprint tags    byte count = len(string) + 1 for the trailing NUL;
//                         wire-length constants exclude the NUL
//   * labels              every internal branch label prefixed `sd_` so no
//                         reserved paideia-as keyword can be hit (loop, if,
//                         match, where, filter, ... — see
//                         reference_paideia_as_reserved_labels)
//   * byte loads          `xor rax, rax; mov_b rax, [ptr]` + `cmp rax, imm8`
//                         (paideia-as #1248 mitigation)
//   * displacement        no chained-displacement `[reg + a + b]`; one
//                         SIB form `[reg + idx*scale]` per load
//
// =============================================================================
// SECTION 3  REGISTER DISCIPLINE
// =============================================================================
//
// _start enters at rsp%16==0 (PVH loader contract, same as every other
// user ELF in this tree). Argc/argv/envp arrive in rdi/rsi/rdx per
// design/user/execve-abi.md. r11 is clobbered by the first nested `call`
// (every CALL also stamps rcx via SysV + r11 via syscall), so survivors
// across the call graph live in r12..r15. _start captures envp (rdx) into
// envp_slot (.bss) BEFORE emitting the SH DISPATCH START witness, since
// sys_debug_puts clobbers caller-save rdx -- same discipline shell.pdx
// uses for its own envp capture (shell.pdx L211-224).
//
// =============================================================================

module ShDispatch = structure {

  // ==========================================================================
  // RETURN CODES
  // ==========================================================================
  pub let SH_DISPATCH_OK            : u64 = 0
  pub let SH_DISPATCH_ERR_EXEC      : u64 = 0x1300
  pub let SH_DISPATCH_ERR_SEMANTIC  : u64 = 0x1301

  // ==========================================================================
  // ENVP SCAN CAP (design/user/execve-abi.md — mirrors shell_home_scan)
  // ==========================================================================
  pub let SH_DISPATCH_ENVP_CAP      : u64 = 16

  // ==========================================================================
  // FINGERPRINT / MARKER STRINGS
  //
  // Byte counts are len(string including trailing newline) + 1 for the NUL
  // terminator. Wire-length *_len constants are len WITHOUT the NUL — the
  // byte count sys_debug_puts / sys_write actually puts on the wire.
  // ==========================================================================

  // "SH DISPATCH START\n" — 18 wire bytes + 1 NUL = 19 storage.
  pub let sd_start_msg       : [u8; 19] = "SH DISPATCH START\n\0"
  pub let sd_start_len       : u64 = 18

  // "sh dispatch mode=legacy\n" — 24 wire bytes + 1 NUL = 25 storage.
  pub let sd_mode_legacy_msg : [u8; 25] = "sh dispatch mode=legacy\n\0"
  pub let sd_mode_legacy_len : u64 = 24

  // "sh dispatch mode=semantic (stub)\n" — 33 wire bytes + 1 NUL = 34 storage.
  pub let sd_mode_semantic_msg : [u8; 34] = "sh dispatch mode=semantic (stub)\n\0"
  pub let sd_mode_semantic_len : u64 = 33

  // "sh dispatch semantic shell not yet available\n" — 45 wire + 1 NUL = 46.
  pub let sd_semantic_na_msg : [u8; 46] = "sh dispatch semantic shell not yet available\n\0"
  pub let sd_semantic_na_len : u64 = 45

  // "sh dispatch: execve legacy-sh failed\n" — 37 wire + 1 NUL = 38.
  pub let sd_exec_fail_msg   : [u8; 38] = "sh dispatch: execve legacy-sh failed\n\0"
  pub let sd_exec_fail_len   : u64 = 37

  // ==========================================================================
  // ENV-KEY + VALUES
  //
  // 15-byte prefix compare for the key (no NUL on the wire).
  // Match-value compares use a joint NUL terminator so e.g. "legacy-foo"
  // falls through to the semantic default (bytes 0..5 match "legacy" but
  // byte 6 is '-' in the candidate and NUL in sd_legacy_val, so the byte
  // compare diverges and the scan moves on to the semantic branch).
  //
  // R229.M11 flip (paideia-os #2729): the ACTIVE match-target is now
  // `sd_legacy_val`; `sd_semantic_val` ships for documentation (same role
  // `sd_legacy_val` held at M7). See SECTION 0 header for the full rationale.
  // ==========================================================================

  // "PDX_SHELL_MODE=" — 15 significant chars (prefix) + 1 NUL = 16 storage.
  pub let sd_mode_env_key    : [u8; 16] = "PDX_SHELL_MODE=\0"
  pub let sd_mode_env_key_prefix_len : u64 = 15

  // "semantic\0" — reserved for a future explicit-semantic fingerprint
  // (symmetric to the M7 role of sd_legacy_val). At R229.M11 the semantic
  // path IS the default, so an explicit `semantic` value takes the same
  // fall-through branch every unset / unknown value takes. The literal is
  // retained in rodata so a smoke can grep the shipped ELF to confirm the
  // symmetric opt-in literal is wired, and so a future landing that
  // distinguishes "semantic (user asked for the real semantic shell)" from
  // "semantic (default fall-through)" has the compare constant already here.
  pub let sd_semantic_val    : [u8; 9]  = "semantic\0"
  pub let sd_semantic_val_match_len : u64 = 9

  // "legacy\0" — compared byte-for-byte including the trailing NUL. ACTIVE
  // match target at R229.M11: a byte-for-byte match routes to
  // `_sd_legacy_fallback` (explicit opt-out of the new semantic default);
  // any mismatch (including unset, unknown values, or partial prefixes
  // like "legacy-foo") falls through to `_sd_semantic_stub`.
  pub let sd_legacy_val      : [u8; 7]  = "legacy\0"
  pub let sd_legacy_val_match_len : u64 = 7

  // ==========================================================================
  // LEGACY-SHELL EXECVE PATH
  //
  // Resolved by the kernel's path resolver against TASK_OFF_CWD-independent
  // root ("/") since the path is absolute. /bin/legacy-sh must exist in
  // tmpfs for the fallback to succeed; see SECTION 0 (ii) for the pending
  // kernel-side bin_seeds.pdx landing.
  // ==========================================================================

  // "/bin/legacy-sh\0" — 14 bytes + 1 NUL = 15 storage.
  pub let sd_legacy_path     : [u8; 15] = "/bin/legacy-sh\0"
  pub let sd_legacy_path_len : u64 = 14

  // ==========================================================================
  // ENVP .BSS SLOT
  //
  // Captured from rdx at _start entry (per execve-abi.md) so the main()
  // thin wrapper and any future test caller can route into _sd_route
  // without having its own copy of envp. Writing is the ONLY writer; every
  // reader is a pure load. envp_slot==0 means "no envp captured" and is
  // treated identically to "PDX_SHELL_MODE not found" — the fall-through
  // branch dominates the dispatch.
  //
  // Mirrors the Dispatch.envp_slot discipline in src/user/dispatch.pdx
  // (paideia-os #2456) — same shape, scoped local to this one binary so
  // the self-contained one-file-one-ELF rule holds.
  // ==========================================================================
  pub let mut envp_slot : u64 = uninit @align(8)

  // ==========================================================================
  // _sd_route(argc, argv, envp) -> exit_code
  //
  // Scans envp for `PDX_SHELL_MODE=` using the exact byte-compare idiom
  // shell.pdx's shell_home_scan uses for `HOME=` (paideia-as #1248
  // mitigation: every byte load is `xor rax, rax; mov_b rax, [...]` so a
  // subsequent REX.W `cmp al, imm8` reflects only the low byte).
  //
  // R229.M11 policy (paideia-os #2729) — DEFAULT FLIPPED from legacy to
  // semantic:
  //   envp == 0                    -> semantic stub (silent, no key fingerprint)
  //   envp exhausted / NULL term   -> semantic stub
  //   PDX_SHELL_MODE= not present  -> semantic stub (NEW DEFAULT)
  //   value == "legacy\0"          -> _sd_legacy_fallback (explicit opt-out)
  //   value == "semantic\0"        -> _sd_semantic_stub (symmetric fall-through)
  //   value == anything else       -> _sd_semantic_stub (conservative)
  //
  // Rationale for routing unknowns to semantic rather than legacy at M11:
  // the whole point of the R229 landing is to retire legacy as the default
  // path. If an unknown value fell through to legacy, every typo of
  // `PDX_SHELL_MODE=sematic` (missing 'n') or `=sema` would silently keep
  // the user on the retiring shell. Routing unknowns to the new default
  // makes the retirement visible and the opt-out explicit.
  //
  // Register plan: rbx = argc, r12 = argv, r13 = envp base, r14 = scan
  // index i, r15 = candidate envp[i] ptr. 5 callee-save pushes; entry
  // rsp%16==8 (one CALL below _start's %16==0), after +5 pushes %16==0,
  // which is what every nested CALL below needs to land its own callee
  // at %16==8. No SYSCALL inside the scan hot loop.
  //
  // Reserved-label discipline: all internal branches prefixed `sd_route_`.
  // ==========================================================================
  pub let _sd_route : (u64, u64, u64) -> u64 !{mem, sysreg} @{fs, sched} =
    fn (argc: u64) (argv: u64) (envp: u64) -> unsafe {
      effects: {mem, sysreg},
      capabilities: {fs, sched},
      justification: "R229.M11 (paideia-os #2729, umbrella #2493): _sd_route(argc, argv, envp) walks envp (NULL-terminated u64 array, design/user/execve-abi.md hard cap SH_DISPATCH_ENVP_CAP=16) and matches each entry's first 15 bytes against sd_mode_env_key ('PDX_SHELL_MODE='). On a prefix hit, it then compares the following 7 bytes (envp[i]+15..+22) against sd_legacy_val ('legacy\\0'); a byte-level match including the shared NUL at offset 6 routes to _sd_legacy_fallback (explicit opt-out of the new semantic default), every other outcome (envp==NULL, scan exhausted, cap exhausted, no PDX_SHELL_MODE= entry, non-legacy value) falls through to _sd_semantic_stub (the new R229.M11 default). This is a flip of the R222.M7 policy where the match target was sd_semantic_val and the default fall-through was legacy; see SECTION 0 header for the full rationale. Effects are {mem,sysreg} + capabilities {fs,sched} because the two tail calls each ultimately reach sys_execve (fs-gated) and sys_exit (sched-gated); the scan itself touches neither. 5 callee-save pushes (rbx, r12, r13, r14, r15) parity-aligned entry %16==8 -> body %16==0 so the nested CALL into _sd_legacy_fallback / _sd_semantic_stub lands its own callee at %16==8 per SysV. Byte compare uses the xor-then-mov_b idiom this codebase installed as the paideia-as #1248 mitigation (shell_home_cmp L286-294, dfpe_cmp L1325-1335): rax and rcx are zero-extended before each mov_b so the wider cmp al, imm8 (encoded REX.W cmp rax,imm8) reflects only the byte value. No `test rN,rN`, no `and r11,imm64`, no `imul r,imm` -- every discipline from feedback_pdx_encoder_pitfalls holds. Reserved-label discipline: all internal labels prefixed sd_route_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                        // rbx = argc (threaded to tail call)
        mov r12, rsi;                        // r12 = argv
        mov r13, rdx;                        // r13 = envp base

        // envp == 0 -> semantic (new default; no envp, treat as unset mode).
        cmp r13, 0;
        je sd_route_semantic;

        xor r14, r14;                        // r14 = scan index i

      sd_route_scan:
        // Honor execve-abi.md's 16-entry cap (SH_DISPATCH_ENVP_CAP; literal
        // 16 in-line to keep the asm immediate on the single-encoded-form
        // path -- `cmp rN, imm8 sign-ext` -- rather than relying on symbol
        // resolution for a numeric immediate the paideia-as encoder has no
        // precedent for in self-contained one-file-one-ELF binaries).
        cmp r14, 16;
        jae sd_route_semantic;               // cap exhausted -> new default

        mov r15, [r13 + r14 * 8];            // r15 = envp[i]
        cmp r15, 0;
        je sd_route_semantic;                // NULL terminator -> new default

        // Prefix-compare r15[0..15) against sd_mode_env_key.
        xor r11, r11;                        // r11 = j (prefix index)
        lea r10, [rip + sd_mode_env_key];

      sd_route_cmp:
        // 15 = sd_mode_env_key_prefix_len (literal; see note at
        // sd_route_scan above about the paideia-as immediate-encoding
        // discipline).
        cmp r11, 15;
        jae sd_route_value;                  // 15 bytes matched -> consult value

        xor rax, rax;
        mov_b rax, [r15 + r11 * 1];
        xor rcx, rcx;
        mov_b rcx, [r10 + r11 * 1];
        cmp rax, rcx;
        jne sd_route_next;                   // byte diverged -> try next envp[i]

        add r11, 1;
        jmp sd_route_cmp;

      sd_route_value:
        // r15 + 15 points at the value byte 0. R229.M11 flip: compare
        // against "legacy\0" byte-for-byte including the trailing NUL at
        // value_match_len-1=6. Any byte mismatch (including "semantic",
        // "legacy-foo", "", or anything else) falls through to the
        // semantic stub -- the "semantic" literal is a documented
        // symmetric opt-in but takes the same path as the unset default.
        mov r10, r15;
        add r10, 15;                         // r10 = &value (skip 15-byte prefix)
        xor r11, r11;                        // r11 = k (value index)
        lea r9, [rip + sd_legacy_val];

      sd_route_valcmp:
        // 7 = sd_legacy_val_match_len (incl shared trailing NUL).
        cmp r11, 7;
        jae sd_route_legacy;                 // 7 bytes matched (incl shared NUL)

        xor rax, rax;
        mov_b rax, [r10 + r11 * 1];
        xor rcx, rcx;
        mov_b rcx, [r9 + r11 * 1];
        cmp rax, rcx;
        jne sd_route_semantic;               // value != "legacy\0" -> semantic

        // Shared NUL (both operands zero at this index) is a valid stop:
        // the next loop iteration will exit via the length check above, so
        // we fall through without an early-stop branch.
        add r11, 1;
        jmp sd_route_valcmp;

      sd_route_next:
        add r14, 1;
        jmp sd_route_scan;

      sd_route_semantic:
        mov rdi, rbx;
        mov rsi, r12;
        mov rdx, r13;
        call _sd_semantic_stub;
        jmp sd_route_out;

      sd_route_legacy:
        mov rdi, rbx;
        mov rsi, r12;
        mov rdx, r13;
        call _sd_legacy_fallback;

      sd_route_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // _sd_legacy_fallback(argc, argv, envp) -> exit_code
  //
  // Emits the "mode=legacy" marker, then sys_execve's /bin/legacy-sh with
  // the original argv + envp. On a successful execve the kernel replaces
  // the image and this function never returns; on failure (most commonly
  // -ENOENT until the kernel-side bin_seeds landing noted in SECTION 0.ii)
  // emits the fail marker and returns SH_DISPATCH_ERR_EXEC. The caller
  // (_sd_route) hands that return value to _start, which tails into
  // sys_exit so the error code lands as the process's exit status.
  //
  // Register plan: rbx = argc, r12 = argv, r13 = envp (all three
  // preserved across the sys_debug_puts call that would otherwise clobber
  // caller-save rdx holding envp). 3 callee-save pushes; entry %16==8 ->
  // body %16==0 after pushes, which is what the nested SYSCALLs require
  // (SYSCALL itself has no %16 contract, but the preceding `call`-depth
  // bookkeeping still needs to stay honest for the next edit).
  //
  // Reserved-label discipline: all internal labels prefixed sd_legacy_.
  // ==========================================================================
  pub let _sd_legacy_fallback : (u64, u64, u64) -> u64 !{mem, sysreg} @{fs, sched} =
    fn (argc: u64) (argv: u64) (envp: u64) -> unsafe {
      effects: {mem, sysreg},
      capabilities: {fs, sched},
      justification: "R222.M7 (paideia-os #2664): _sd_legacy_fallback(argc, argv, envp) emits the 'sh dispatch mode=legacy' marker via sys_debug_puts (SC+ ID 12, bypasses tty so the fingerprint lands even if the shell has no stdout yet) and then calls sys_execve('/bin/legacy-sh', argv, envp) (SC+ ID 59). sys_execve replaces the task image on success (never returns); on failure the function emits the 'sh dispatch: execve legacy-sh failed' marker and returns SH_DISPATCH_ERR_EXEC = 0x1300. Argc/argv/envp are captured into callee-save rbx/r12/r13 BEFORE the first sys_debug_puts call since every SYSCALL potentially clobbers caller-save rdx (holding envp per execve-abi.md). Effects {mem,sysreg} + capabilities {fs,sched} match sys_execve + sys_debug_puts union. 3 callee-save pushes keep rsp%16 even. Encoder discipline per SECTION 2 of the module header. Reserved-label discipline: all internal labels prefixed sd_legacy_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                        // rbx = argc
        mov r12, rsi;                        // r12 = argv
        mov r13, rdx;                        // r13 = envp

        // Emit "sh dispatch mode=legacy\n" via sys_debug_puts.
        // 24 = sd_mode_legacy_len.
        lea rdi, [rip + sd_mode_legacy_msg];
        mov rsi, 24;
        mov rax, 12;                         // SC+ sys_debug_puts
        syscall;

        // sys_execve("/bin/legacy-sh", argv, envp).
        lea rdi, [rip + sd_legacy_path];
        mov rsi, r12;
        mov rdx, r13;
        mov rax, 59;                         // SC+ sys_execve
        syscall;

        // Reached only if execve failed (image not seeded yet, or any
        // other kernel-side refusal). sys_execve returns -errno in rax
        // when it does return; we don't thread the specific errno into
        // the exit code at M7 -- the marker + fail code is enough for
        // the smoke to distinguish success (execve replaced the image,
        // this ret never fires) from failure (ret returns the error).
        // 37 = sd_exec_fail_len.
        lea rdi, [rip + sd_exec_fail_msg];
        mov rsi, 37;
        mov rax, 12;                         // SC+ sys_debug_puts
        syscall;

        mov rax, 0x1300;                     // SH_DISPATCH_ERR_EXEC

        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // _sd_semantic_stub(argc, argv, envp) -> exit_code
  //
  // Emits the semantic-shell-not-yet-available marker and tail-calls
  // _sd_legacy_fallback so the user's invocation still runs under the
  // legacy shell. Rationale (SECTION 0.c): wire the gate NOW; replacing
  // this function's body with the real semantic entry at R229 close is a
  // single-site edit with no ripple into _start / _sd_route.
  //
  // Register plan: argc/argv/envp preserved across the two sys_debug_puts
  // calls in callee-save rbx/r12/r13, then tail-call forwards them to
  // _sd_legacy_fallback whose own ret value propagates up.
  //
  // Reserved-label discipline: labels prefixed sd_stub_ (reserved for a
  // future revision; the current body has no internal branches).
  // ==========================================================================
  pub let _sd_semantic_stub : (u64, u64, u64) -> u64 !{mem, sysreg} @{fs, sched} =
    fn (argc: u64) (argv: u64) (envp: u64) -> unsafe {
      effects: {mem, sysreg},
      capabilities: {fs, sched},
      justification: "R222.M7 (paideia-os #2664): _sd_semantic_stub(argc, argv, envp) emits two markers via sys_debug_puts (SC+ ID 12): first 'sh dispatch mode=semantic (stub)' then 'sh dispatch semantic shell not yet available'. Then it tail-calls _sd_legacy_fallback with the same argc/argv/envp triple so the user's invocation still runs. Both markers ride sys_debug_puts rather than sys_write so they land on serial even if the shell has no stdout wired yet (the shell is literally what wires stdout, so the dispatcher cannot assume it) -- same discipline as cp.pdx / mkdir.pdx / touch.pdx fingerprint channels. Argc/argv/envp captured into callee-save rbx/r12/r13 before the first SYSCALL. Effects/capabilities match _sd_legacy_fallback union (which is where control eventually lands). Reserved-label discipline: labels sd_stub_-prefixed (none emitted at M7).",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                        // rbx = argc
        mov r12, rsi;                        // r12 = argv
        mov r13, rdx;                        // r13 = envp

        // Emit "sh dispatch mode=semantic (stub)\n" via sys_debug_puts.
        // 33 = sd_mode_semantic_len.
        lea rdi, [rip + sd_mode_semantic_msg];
        mov rsi, 33;
        mov rax, 12;                         // SC+ sys_debug_puts
        syscall;

        // Emit "sh dispatch semantic shell not yet available\n".
        // 45 = sd_semantic_na_len.
        lea rdi, [rip + sd_semantic_na_msg];
        mov rsi, 45;
        mov rax, 12;                         // SC+ sys_debug_puts
        syscall;

        // Tail-call into the legacy fallback. The returned exit code
        // (either 0 if execve succeeded -- unreachable, since execve
        // replaced the image -- or SH_DISPATCH_ERR_EXEC) is what this
        // function returns; the caller (_sd_route / _start / main) hands
        // it to sys_exit.
        mov rdi, rbx;
        mov rsi, r12;
        mov rdx, r13;
        call _sd_legacy_fallback;

        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // main(argc, argv) -> exit_code
  //
  // C-style thin wrapper so a future test harness or chained caller can
  // enter the dispatcher without re-synthesising envp. Reads envp from the
  // .bss envp_slot populated at _start, then calls _sd_route(argc, argv,
  // envp). Entry via /bin/sh execve goes through _start, not main; main is
  // here for programmatic callers only.
  //
  // Register plan: 1 callee-save push (rbx = argv) across the envp load
  // and the subsequent CALL. Entry rsp%16==8 (one CALL below the caller),
  // after +1 push %16==0, nested CALL into _sd_route lands at %16==8 per
  // SysV.
  //
  // Reserved-label discipline: labels prefixed sd_main_ (none emitted).
  // ==========================================================================
  pub let main : (u64, u64) -> u64 !{mem, sysreg} @{fs, sched} =
    fn (argc: u64) (argv: u64) -> unsafe {
      effects: {mem, sysreg},
      capabilities: {fs, sched},
      justification: "R222.M7 (paideia-os #2664): main(argc, argv) thin C-style wrapper for programmatic callers. Reads envp from envp_slot (.bss, populated at _start before any syscall per the shell.pdx L213-224 pattern) and forwards (argc, argv, envp) to _sd_route whose return value propagates up to the caller. Entry via /bin/sh execve goes through _start; main is reserved for a future test harness. Encoder discipline per SECTION 2. Reserved-label discipline: labels sd_main_-prefixed (none at M7).",
      block: {
        push rbx;
        mov rbx, rsi;                        // rbx = argv (preserved across load)

        // envp = envp_slot (populated at _start entry).
        lea rax, [rip + envp_slot];
        mov rdx, [rax + 0];                  // rdx = envp

        // _sd_route(argc=rdi, argv=rsi, envp=rdx). argc is still in rdi
        // (we never touched it); restore argv into rsi from rbx.
        mov rsi, rbx;
        call _sd_route;

        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // _start -- /bin/sh entry point (post-R229 swap).
  //
  // ABI per design/user/execve-abi.md:
  //   rdi = argc
  //   rsi = argv (NULL-terminated char**)
  //   rdx = envp (NULL-terminated char**)
  //   rsp % 16 == 0  (PVH loader contract)
  //
  // Flow:
  //   (1) Stash rdx (envp) into envp_slot BEFORE the first syscall --
  //       sys_debug_puts clobbers caller-save rdx, same reason shell.pdx
  //       L211-224 captures envp into r12 / Dispatch.envp_slot as its very
  //       first instruction.
  //   (2) Emit "SH DISPATCH START\n" via sys_debug_puts (fingerprint).
  //   (3) Call _sd_route(argc, argv, envp) which routes to legacy or
  //       semantic.
  //   (4) sys_exit(route_result). Only reaches here if execve FAILED
  //       (success replaces the image); on failure we exit with
  //       SH_DISPATCH_ERR_EXEC = 0x1300 so init / parent can distinguish
  //       the dispatcher-level failure from the legacy shell's own exit
  //       codes.
  //
  // Register plan: no callee-save pushes (we never return; sys_exit is a
  // terminal syscall). r12/r13/r14 hold argc/argv/envp across the first
  // sys_debug_puts call -- those are callee-save so the SYSCALL does not
  // clobber them. @no_frame because every terminal path ends in sys_exit.
  // ==========================================================================
  pub let _start : () -> () !{mem, sysreg} @{fs, sched, cap} =
    fn () -> unsafe {
      effects: {mem, sysreg},
      capabilities: {fs, sched, cap},
      justification: "R222.M7 (paideia-os #2664): /bin/sh front-end dispatcher _start. (1) Captures envp (rdx per design/user/execve-abi.md) into envp_slot (.bss) BEFORE the first syscall -- sys_debug_puts clobbers caller-save rdx, same reason shell.pdx L211 captures rdx into r12 as its very first instruction. The .bss stash means main() (and any future test caller) can read envp without threading it through its ABI. (2) Emits 'SH DISPATCH START' via sys_debug_puts (SC+ 12) as an entry witness -- proves the dispatcher reached _start before any route decision happens. (3) Calls _sd_route(argc, argv, envp) which scans PDX_SHELL_MODE= and dispatches. (4) sys_exit (SC+ 60) with the route return code -- only reached on execve failure, since a successful execve replaces the image. @no_frame because every terminal path is a sys_exit syscall. Entry rsp%16==0 per PVH; the nested CALL into _sd_route lands at %16==8 which is SysV-correct. Capabilities widen to {fs, sched, cap} to cover the entire downstream call graph (sys_execve is fs+sched-gated, cap included defensively for a future SC+ 138 grant surface that the dispatcher may wrap on behalf of the shell per design/shell/sh-dispatch.md §7). Encoder discipline per SECTION 2 of the module header. Reserved-label discipline: labels sd_entry_-prefixed (none emitted at M7).",
      block: {
        // ---- Phase 0: capture argc/argv/envp into callee-save regs
        //              BEFORE the first syscall touches caller-save rdx.
        mov r12, rdi;                        // r12 = argc
        mov r13, rsi;                        // r13 = argv
        mov r14, rdx;                        // r14 = envp

        // Mirror envp into envp_slot (.bss) for main() + future callers.
        lea rax, [rip + envp_slot];
        mov [rax + 0], r14;

        // ---- Phase 1: entry witness.
        // 18 = sd_start_len.
        lea rdi, [rip + sd_start_msg];
        mov rsi, 18;
        mov rax, 12;                         // SC+ sys_debug_puts
        syscall;

        // ---- Phase 2: route.
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, r14;
        call _sd_route;

        // ---- Phase 3: exit with route return code.
        //
        // Reached only when _sd_route returned, which happens only when
        // _sd_legacy_fallback's sys_execve failed (success would replace
        // the image, so this ret path is unreachable).
        mov rdi, rax;                        // rdi = exit code
        mov rax, 60;                         // SC+ sys_exit
        syscall;

        hlt
      }
    } @no_frame
}
