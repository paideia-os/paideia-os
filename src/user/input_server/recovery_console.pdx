// src/user/input_server/recovery_console.pdx -- Wave0-B10-01 (paideia-os #2275)
//
// Input-server RECOVERY-CONSOLE takeover-execution logic. This module is
// the third and final leg of the recovery-plane triptych:
//
//   Leg 1 -- src/user/compositor/recovery_plane_reserve.pdx (Wave-0 Batch-6,
//            paideia-os #2269): mints the RESERVATION cap at KIND=0x1C8;
//            RIGHT_HOLD_PLANE(0x001) + RIGHT_QUERY_PLANE_INFO(0x002).
//
//   Leg 2 -- src/user/compositor/recovery_plane_takeover.pdx (Wave-0 Batch-7,
//            paideia-os #2270): adds RIGHT_TAKEOVER(0x004) and the
//            recovery_plane_takeover_execute primitive that swaps the plane
//            display source to the input server on compositor death.
//
//   Leg 3 -- THIS FILE (paideia-os #2275): the STATE MACHINE that combines
//            the reservation + the takeover primitive with a minimal
//            emergency framebuffer painter, so an operator sees a banner
//            (and can act on it) after the swap.
//
// The three legs are DELIBERATELY separate: reservation is a policy-free
// cap; takeover is a policy-free primitive that requires RIGHT_TAKEOVER;
// this file is the CALLER of the takeover primitive plus the console UX
// on top of it. The split matches the pattern in
// design/compositor/pwp-spec-vocabulary.md sec-2.17 (KIND_RECOVERY_PLANE)
// where the reservation cap is described as inert until the input server
// walks it through the takeover flow -- this module IS that walk.
//
// LIFECYCLE POSITION.
//
// The input-server process (src/user/input_server/main.pdx, Wave-0 Batch-8,
// paideia-os #2274, KIND_INPUT_SERVER=0x1D0) already:
//   - holds the reservation (bound at input_server_init via
//     recovery_reservation_id, main.pdx §Fields word0[63:32]),
//   - has been granted RIGHT_TAKEOVER out of band by the input-server
//     startup step (see recovery_plane_takeover.pdx sec-0 discussion of
//     "explicit input-server-startup step").
//
// This module is INSTANTIATED once by the input-server main loop after
// input_server_init returns IS_OK, with the reservation id and takeover
// rights read from the InputServerFields singleton. On compositor death,
// the input-server main loop calls recovery_console_on_compositor_death,
// which then walks the state IDLE -> TAKEOVER_ACTIVE -> RECOVERED
// transitions in response to real events.
//
// =============================================================================
// SECTION 0  STATE MACHINE
// =============================================================================
//
// Three states, one byte each (packed into the low byte of a padded u64
// so the store is a single word write and so a partial write cannot leave
// the byte in a torn value):
//
//   IDLE             (0) -- initial state after recovery_console_init.
//                            No takeover has been attempted; the plane
//                            display source is still the compositor.
//
//   TAKEOVER_ACTIVE  (1) -- on_compositor_death has successfully called
//                            recovery_plane_takeover_execute; the plane
//                            display source is now the input server; the
//                            banner has been painted; input dispatch is
//                            active on this cap.
//
//   RECOVERED        (2) -- the input-server main loop observed that a
//                            NEW compositor process has claimed the plane
//                            (via recovery_plane_takeover_release invoked
//                            from a compositor-restart witness); the
//                            recovery console is idle again but records
//                            the recovered state so an operator query
//                            can distinguish "cold boot" from "post-
//                            recovery boot".
//
// Legal transitions (the only ones the mutators write):
//
//   IDLE               -->  TAKEOVER_ACTIVE   (on_compositor_death)
//   TAKEOVER_ACTIVE    -->  RECOVERED         (release)
//
// All other transitions (IDLE->RECOVERED, RECOVERED->TAKEOVER_ACTIVE,
// TAKEOVER_ACTIVE->IDLE, RECOVERED->IDLE, self-loops) are REFUSED with
// RC_BAD_STATE. The mutator gates check state FIRST -- before any
// sub-call or memory write -- so an out-of-order call cannot leave the
// takeover primitive advanced with the console state stale, or vice-
// versa.
//
// dispatch_input is READ-ONLY on state (it does NOT transition on ENTER
// or R -- it returns an action code, and the caller decides whether to
// invoke a syscall or a compositor-restart). Callable ONLY when state
// is TAKEOVER_ACTIVE; other states return RC_BAD_STATE. This keeps the
// key-to-action mapping deterministic and grep-verifiable (there is no
// hidden "dispatch actually rebooted" path).
//
// =============================================================================
// SECTION 1  RIGHTS ASSERTION AT INIT
// =============================================================================
//
// recovery_console_init asserts that the caller-supplied takeover_rights
// bitmap has RIGHT_TAKEOVER (0x004) set. This is a STRUCTURAL gate on
// this module's usefulness -- a RecoveryConsoleState without the
// takeover bit is inert (on_compositor_death would round-trip to
// takeover_execute and get TO_NO_RIGHT). Refusing at init makes the
// failure appear at the earliest possible callsite (the input-server
// startup path, near where the rights bitmap was assembled) rather than
// at the first compositor death.
//
// The other two rights (RIGHT_HOLD_PLANE, RIGHT_QUERY_PLANE_INFO) are
// stored verbatim in the state cell but NOT structurally asserted here:
// they are the reservation's own responsibility, and the reservation
// cell's own factory (recovery_plane_reserve_at_boot in leg 1) already
// enforced them at reservation mint time.
//
// =============================================================================
// SECTION 2  CELL LAYOUT -- 32 BYTES (SINGLETON)
// =============================================================================
//
// RecoveryConsoleState is a SINGLETON per input-server process: exactly
// one recovery console exists per boot, mirroring the singleton posture
// of both the reservation (recovery_plane_reserve.pdx) and the input-
// server-fields cell (input_server/main.pdx). Cell shape (four u64
// words, packed):
//
//   [+0]   word0:  plane_reservation_id[31:0]         (the reservation
//                                                     cell id held by
//                                                     the input server;
//                                                     copied from
//                                                     InputServerFields
//                                                     word0[63:32])
//                | takeover_rights[63:32]             (rights bitmap of
//                                                     the reservation
//                                                     cap; MUST contain
//                                                     RIGHT_TAKEOVER
//                                                     0x004)
//
//   [+8]   word1:  text_buffer_ptr (u64)              (address of the
//                                                     80x25 char cell
//                                                     buffer for banner
//                                                     paint; 0 until
//                                                     recovery_console_
//                                                     bind_text_buffer
//                                                     is called; paint
//                                                     with 0 returns
//                                                     RC_NO_TEXT_BUFFER)
//
//   [+16]  word2:  takeover_seq (u64)                 (the takeover_seq
//                                                     witness from the
//                                                     sibling
//                                                     _recovery_plane_
//                                                     takeover_seq_
//                                                     counter observed
//                                                     at successful
//                                                     on_compositor_
//                                                     death; 0 until the
//                                                     first takeover)
//
//   [+24]  word3:  state (u8 low byte, u56 reserved)  (0=IDLE, 1=
//                                                     TAKEOVER_ACTIVE,
//                                                     2=RECOVERED; upper
//                                                     56 bits zero and
//                                                     unused)
//
// State is stored as a padded u64 rather than a bare u8 so mutator
// writes are single-word stores (no partial-byte torn-write window)
// and so the encoder never has to emit a byte-level store to update
// the state field. Getter reads mask with 0xFF.
//
// The cell is scrubbed to zero by .bss at real boot; recovery_console_
// reset re-scrubs defensively. A companion singleton
// _recovery_console_state_cell (32 bytes) sits at file scope so callers
// without their own scratch cell can drive the module against the
// canonical singleton; the mutators accept an explicit state_ptr in
// rdi so a future test harness can drive them against a scratch cell
// as well (same pattern input_server_main_loop uses for testability).
//
// =============================================================================
// SECTION 3  BANNER TEXT
// =============================================================================
//
// The banner is exactly 64 bytes of ASCII, NO trailing NUL (the char
// cells hold characters, not C strings):
//
//   "COMPOSITOR DIED. Press ENTER to reboot / R to restart-compositor"
//
// Bytes are copied 1:1 into the low 64 char cells of the text buffer
// (row 0 of an 80x25 grid, columns 0..63). Columns 64..79 of row 0 and
// all of rows 1..24 are LEFT UNTOUCHED -- the caller is responsible for
// either pre-clearing the buffer (typical: the emergency framebuffer
// backend fills with 0x00 on takeover) or accepting that stale pixels
// survive in the un-touched cells. This keeps paint_banner O(64) with
// zero syscall or driver dependency.
//
// The copy is a byte-oriented loop (63 iterations of
// mov al,[rsi]/mov [rdi],al/add rsi,1/add rdi,1/sub rcx,1/cmp/jne),
// NOT a rep movsb: the encoder does not emit rep prefixes in this
// tree's asm bodies (see grep 'rep movsb' src/kernel -> zero hits).
// Byte-level mov [reg],al and mov al,[reg] are both attested in the
// tree (scsi_cmd.pdx st_be16/st_be32 and kernel_main_uefi.pdx's
// print loop).
//
// =============================================================================
// SECTION 4  KEY-TO-ACTION MAPPING
// =============================================================================
//
// dispatch_input returns one of three action codes as its u64 return
// value; the caller decides how to act on each:
//
//   RC_ACT_NONE                (0)  -- key was not one of ENTER or R;
//                                      caller MUST NOT trigger a reboot
//                                      or restart on this key.
//
//   RC_ACT_REBOOT              (1)  -- caller SHOULD invoke the reboot
//                                      syscall (or ACPI reset) after
//                                      dispatching this action.
//
//   RC_ACT_RESTART_COMPOSITOR  (2)  -- caller SHOULD respawn svc-
//                                      compositor via its init-side
//                                      spawn helper.
//
// Keys are ASCII (post-HID-translation): ENTER is 0x0D, R is 0x52
// (uppercase) or 0x72 (lowercase). Any other key returns RC_ACT_NONE.
// The recovery console INTENTIONALLY accepts only the two-key mnemonic:
// a keyboard-buffer flood cannot drive the state machine into an
// unexpected transition, because dispatch_input never mutates state
// (see sec-0 discussion). Non-ASCII HID codes (arrow keys, function
// keys, modifiers) are also RC_ACT_NONE and are silently ignored.
//
// =============================================================================
// SECTION 5  FAILURE TAXONOMY -- 0xFFFFEAF0..0xFFFFEAFF
// =============================================================================
//
// Repo-wide grep at landing time confirms 0xFFFFEAF0..0xFFFFEAFF is
// UNCLAIMED across src/ and design/ (adjacent 0xFFFFEAA0..AF is
// KIND_WINDOW; 0xFFFFEAB0..0xFFFFEAE0 are free; 0xFFFFEB70..7F is
// input_server/main.pdx; 0xFFFFEB80..0xFFFFEBEF is a mix of input-
// server sibling kinds). The task-row hint 0xFFFFEC10..0xFFFFEC1F is
// occupied by KIND_PDXFS_TXN (kind_pdxfs_txn.pdx sec-3), so this
// landing takes 0xFFFFEAF0..FF instead per the "grep-verify free"
// directive.
//
//   RC_OK                 (0)          -- success on any mutator.
//   RC_ALREADY_INIT       (0xFFFFEAF0) -- init called twice.
//   RC_MISSING_TAKEOVER   (0xFFFFEAF1) -- takeover_rights & 0x004 == 0.
//   RC_NULL_RESERVATION   (0xFFFFEAF2) -- reservation_id == 0 at init.
//   RC_BAD_STATE          (0xFFFFEAF3) -- illegal state-machine step.
//   RC_NO_TEXT_BUFFER     (0xFFFFEAF4) -- paint with text_buffer_ptr==0.
//   RC_NULL_STATE_PTR     (0xFFFFEAF5) -- state_ptr==0 to any mutator.
//   RC_DECODE_BAD         (0xFFFF...F) -- unreachable u64 sentinel.
//
// on_compositor_death FORWARDS the failure code from
// recovery_plane_takeover_execute (TO_NO_RIGHT / TO_WRONG_HOLDER /
// TO_ALREADY_ACTIVE) rather than remapping it: those codes live in
// 0xFFFFE9D0..0xFFFFE9DF, disjoint from this file's band, so the
// forwarded value is grep-attributable to leg 2 without ambiguity.
//
// =============================================================================
// SECTION 6  FINGERPRINT TAG
// =============================================================================
//
// ONE tag ending [legacy: ... OK] per softarch discipline. Same
// allowlist posture as legs 1 and 2 and as input_server/main.pdx: the
// future kernel-side dispatcher's on_compositor_death path will emit
// this string via klog_s1 on the successful IDLE -> TAKEOVER_ACTIVE
// transition; until that landing arrives the string is a data-only
// constant and needs an allowlist entry in
// tools/verify-fingerprint-coverage.sh with reason "recovery-console
// takeover-execution dispatcher not yet landed (G8.M1-002 / #2275)".
// Adding that allowlist entry is a SEPARATE landing; this file does
// NOT touch tools/ (same discipline the three prior recovery-plane /
// input-server files enforced).

module RecoveryConsole = structure {

  // ==========================================================================
  // Identity + rights (mirrors of legs 1 and 2, for local reference).
  //
  // KIND_RECOVERY_PLANE and RIGHT_TAKEOVER are authoritatively declared
  // in recovery_plane_reserve.pdx and recovery_plane_takeover.pdx
  // respectively; the values are repeated here so this module's asm
  // bodies can compare against them without an inter-module const
  // reference (paideia-as does not resolve peer-module `let` bindings
  // inside asm blocks; the same convention is used in the sibling
  // recovery_plane_takeover.pdx sec-Identity).
  // ==========================================================================

  pub let KIND_RECOVERY_PLANE : u64 = 0x1C8
  pub let RIGHT_TAKEOVER      : u64 = 0x004

  // ==========================================================================
  // State-machine ordinals (sec-0).
  // ==========================================================================

  pub let RC_STATE_IDLE            : u64 = 0
  pub let RC_STATE_TAKEOVER_ACTIVE : u64 = 1
  pub let RC_STATE_RECOVERED       : u64 = 2

  // ==========================================================================
  // dispatch_input action codes (sec-4).
  // ==========================================================================

  pub let RC_ACT_NONE               : u64 = 0
  pub let RC_ACT_REBOOT             : u64 = 1
  pub let RC_ACT_RESTART_COMPOSITOR : u64 = 2

  // ==========================================================================
  // Key ordinals (ASCII, post-HID-translation; sec-4).
  // ==========================================================================

  pub let RC_KEY_ENTER : u64 = 0x0D
  pub let RC_KEY_R_UC  : u64 = 0x52
  pub let RC_KEY_R_LC  : u64 = 0x72

  // ==========================================================================
  // Cell layout (sec-2).
  // ==========================================================================

  pub let RC_CELL_BYTES  : u64 = 32
  pub let RC_CELL_WORDS  : u64 = 4
  pub let RC_BANNER_LEN  : u64 = 64

  // ==========================================================================
  // Failure taxonomy -- 0xFFFFEAF0..0xFFFFEAFF (sec-5).
  // ==========================================================================

  pub let RC_OK                 : u64 = 0
  pub let RC_ALREADY_INIT       : u64 = 0xFFFFEAF0
  pub let RC_MISSING_TAKEOVER   : u64 = 0xFFFFEAF1
  pub let RC_NULL_RESERVATION   : u64 = 0xFFFFEAF2
  pub let RC_BAD_STATE          : u64 = 0xFFFFEAF3
  pub let RC_NO_TEXT_BUFFER     : u64 = 0xFFFFEAF4
  pub let RC_NULL_STATE_PTR     : u64 = 0xFFFFEAF5
  pub let RC_DECODE_BAD         : u64 = 0xFFFFFFFFFFFFFFFF

  // ==========================================================================
  // Struct shape (see sec-2 for byte layout).
  //
  // Same declaration posture as sibling reservation / takeover / input-
  // server files: shape is declared for documentation and for future
  // typed access; asm bodies drive the cell via offsets.
  // ==========================================================================

  struct RecoveryConsoleState {
    plane_reservation_id: u32,
    takeover_rights: u32,
    text_buffer_ptr: u64,
    takeover_seq: u64,
    state: u8
  }

  // ==========================================================================
  // Singleton state (sec-2).
  //
  // ONE recovery console per input-server process. Cell is scrubbed by
  // .bss at real boot; recovery_console_reset re-scrubs defensively.
  // Mutators accept an explicit state_ptr in rdi so a scratch cell can
  // drive them in a future test harness.
  // ==========================================================================

  pub let mut _recovery_console_state_cell : [u8; 32] = uninit @align(8)

  // ==========================================================================
  // Banner bytes (sec-3). Exactly 64 chars, NO trailing NUL.
  // ==========================================================================

  pub let _recovery_console_banner_bytes : [u8; 64] = "COMPOSITOR DIED. Press ENTER to reboot / R to restart-compositor"

  // ==========================================================================
  // Fingerprint tag (sec-6).
  //
  // Size is 49 payload bytes + 1 NUL = 50 bytes.
  // ==========================================================================

  pub let pdx_kind_recovery_console_meta : [u8; 50] = "recovery console ok [legacy: RECOVERY CONSOLE OK]\0"

  // ==========================================================================
  // recovery_console_init(state_ptr, reservation, takeover_rights) -> u64
  //   rdi = state_ptr (may be _recovery_console_state_cell)
  //   rsi = reservation (u32 in low32; high bits ignored)
  //   rdx = takeover_rights (u32 in low32; high bits ignored)
  //
  // Gate order:
  //   (1) state_ptr==0             -> RC_NULL_STATE_PTR
  //   (2) reservation low32 == 0   -> RC_NULL_RESERVATION
  //   (3) takeover_rights & 0x004 == 0 -> RC_MISSING_TAKEOVER
  //   (4) already-init: state_ptr word3 low byte non-zero OR word0 non-
  //       zero -> RC_ALREADY_INIT  (either witness catches a second
  //                                 init on a cell that has been
  //                                 through a full IDLE->...->RECOVERED
  //                                 cycle -- the word0 pack is non-
  //                                 zero, and the state byte is 2)
  //   (5) publish cell:
  //         word0 = reservation_low32 | (takeover_rights_low32 << 32)
  //         word1 = 0   (text_buffer_ptr; caller sets via bind)
  //         word2 = 0   (takeover_seq)
  //         word3 = 0   (state = IDLE)
  //
  // Frame: no callee-save pushes needed (no nested call). Entry
  // rsp%16==8 stays throughout. r11 is used ONLY as a pointer stash --
  // never masked -- to sidestep U1615 (and r11,imm64 blocked).
  //
  // Labels prefixed recovery_console_i_.
  // ==========================================================================

  pub let recovery_console_init : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (state_ptr: u64, reservation: u64, takeover_rights: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-01 (paideia-os #2275): recovery-console init. Gate (1) rdi==0 -> RC_NULL_STATE_PTR. (2) rsi low32 (via shl 32/shr 32) ==0 -> RC_NULL_RESERVATION. (3) rdx & 0x004 (RIGHT_TAKEOVER) ==0 -> RC_MISSING_TAKEOVER. (4) state cell word3 low byte non-zero OR word0 non-zero -> RC_ALREADY_INIT (two witnesses so a full-cycle cell -- state=RECOVERED, word0 populated -- still refuses re-init). (5) publish: word0 = reservation_low32 | (takeover_rights_low32 << 32); word1/word2/word3 zeroed. Zero-extend via `mov r10, 0xFFFFFFFF; and rN, r10` -- r11 is never masked, only used as a pointer stash. No `test`; no `add reg,[mem]`; no `and r11,imm`. Labels prefixed recovery_console_i_.",
      block: {
        // (1) state_ptr null check.
        cmp rdi, 0;
        je  recovery_console_i_null_ptr;

        // Stash state_ptr into r11 before rax reuse.
        mov r11, rdi;

        // (2) reservation low32 null check.
        mov rax, rsi;
        shl rax, 32;
        shr rax, 32;
        cmp rax, 0;
        je  recovery_console_i_null_res;

        // (3) RIGHT_TAKEOVER (0x004) must be set.
        mov rax, rdx;
        and rax, 0x4;
        cmp rax, 0;
        je  recovery_console_i_missing_to;

        // (4a) already-init check via state byte (word3 low byte).
        mov rax, [r11 + 24];
        and rax, 0xFF;
        cmp rax, 0;
        jne recovery_console_i_already;

        // (4b) already-init check via word0 (non-zero pack -> a prior
        //      init has populated reservation/rights; refuse re-init).
        mov rax, [r11 + 0];
        cmp rax, 0;
        jne recovery_console_i_already;

        // (5) publish word0 = reservation_low32 | (takeover_rights_low32 << 32).
        mov r10, 0xFFFFFFFF;
        mov rax, rsi;
        and rax, r10;                    // rax = reservation low32
        mov rcx, rdx;
        and rcx, r10;                    // rcx = takeover_rights low32
        shl rcx, 32;
        or  rax, rcx;                    // rax = word0
        mov [r11 + 0], rax;

        // Zero remaining words (text_buffer_ptr, takeover_seq, state).
        xor rax, rax;
        mov [r11 + 8],  rax;             // word1: text_buffer_ptr = 0
        mov [r11 + 16], rax;             // word2: takeover_seq = 0
        mov [r11 + 24], rax;             // word3: state = IDLE

        xor rax, rax;                    // RC_OK
        ret;

      recovery_console_i_null_ptr:
        mov rax, 0xFFFFEAF5;             // RC_NULL_STATE_PTR
        ret;

      recovery_console_i_null_res:
        mov rax, 0xFFFFEAF2;             // RC_NULL_RESERVATION
        ret;

      recovery_console_i_missing_to:
        mov rax, 0xFFFFEAF1;             // RC_MISSING_TAKEOVER
        ret;

      recovery_console_i_already:
        mov rax, 0xFFFFEAF0;             // RC_ALREADY_INIT
        ret
      }
    }

  // ==========================================================================
  // recovery_console_bind_text_buffer(state_ptr, ptr) -> u64
  //   rdi = state_ptr
  //   rsi = text_buffer_ptr (u64 -- caller-mapped 80x25 char cell buffer)
  //
  // Setter for the paint target. Called AFTER recovery_console_init
  // (state_ptr is validated as non-null; state is NOT gated so the
  // caller can bind the buffer in any state, including RECOVERED, in
  // case a later boot cycle wants to reuse the same cell). Overwrites
  // any previous binding unconditionally.
  //
  // Labels prefixed recovery_console_btb_.
  // ==========================================================================

  pub let recovery_console_bind_text_buffer : (u64, u64) -> u64 !{mem} @{} =
    fn (state_ptr: u64, text_buffer_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-01 (paideia-os #2275): text-buffer setter. Refuse rdi==0 -> RC_NULL_STATE_PTR; else store rsi into [rdi+8]. No state-machine gate: the buffer can be bound in any state (a re-bind at RECOVERED prepares the cell for a follow-on takeover cycle). Labels prefixed recovery_console_btb_.",
      block: {
        cmp rdi, 0;
        je  recovery_console_btb_null_ptr;
        mov [rdi + 8], rsi;
        xor rax, rax;                    // RC_OK
        ret;
      recovery_console_btb_null_ptr:
        mov rax, 0xFFFFEAF5;             // RC_NULL_STATE_PTR
        ret
      }
    }

  // ==========================================================================
  // recovery_console_on_compositor_death(state_ptr, dead_pid, trigger) -> u64
  //   rdi = state_ptr
  //   rsi = dead_pid   (u32 in low32; compositor process kind id)
  //   rdx = trigger    (u8 in low byte; DEATH_TIMEOUT / EXPLICIT / HW_HANG /
  //                     SIGSEGV per recovery_plane_takeover.pdx sec-1)
  //
  // Combines leg 2's takeover primitive with the state-machine step
  // IDLE -> TAKEOVER_ACTIVE and the banner paint. Gate order:
  //
  //   (1) state_ptr==0                            -> RC_NULL_STATE_PTR
  //   (2) state != IDLE                           -> RC_BAD_STATE
  //   (3) call recovery_plane_takeover_execute(takeover_rights, trigger,
  //       dead_pid); on non-zero return, FORWARD the code (do NOT
  //       remap: TO_* codes live in 0xFFFFE9D0..DF, disjoint from this
  //       module's band).
  //   (4) record takeover_seq into word2 by reading the sibling
  //       _recovery_plane_takeover_seq_counter (leg 2's post-bump
  //       value is now the seq for this successful takeover).
  //   (5) transition state to TAKEOVER_ACTIVE (1). Written as a full-
  //       word store so no torn-byte window exists.
  //   (6) paint the banner (call recovery_console_paint_banner with
  //       state_ptr). If the caller has NOT yet bound a text buffer,
  //       the paint returns RC_NO_TEXT_BUFFER -- but at this point
  //       the takeover has ALREADY committed and the state cell says
  //       TAKEOVER_ACTIVE. We SWALLOW that particular paint failure
  //       (return RC_OK anyway) because the takeover semantic
  //       (compositor no longer owns display) is the load-bearing
  //       effect, not the banner itself.
  //
  // Frame:
  //   - entry rsp%16 == 8
  //   - push rbx: save state_ptr across the two `call`s (rbx is SysV
  //     callee-save; the callees preserve it). After push rsp%16==0
  //     which is the required call alignment.
  //   - all mutations happen after the sub-call returns OK; a failed
  //     takeover_execute returns before ANY state write here.
  //
  // Labels prefixed recovery_console_ocd_.
  // ==========================================================================

  pub let recovery_console_on_compositor_death : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (state_ptr: u64, dead_pid: u64, trigger: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-01 (paideia-os #2275): five-gate takeover step. (1) rdi==0 -> RC_NULL_STATE_PTR. (2) state byte at [rdi+24] & 0xFF must equal 0 (IDLE) else RC_BAD_STATE. (3) marshal for recovery_plane_takeover_execute: rdi=takeover_rights (from state cell word0[63:32], loaded via shr 32), rsi=trigger, rdx=dead_pid. Preserve state_ptr in rbx across the call (push rbx aligns rsp%16 to 0 for the call). On non-zero return -- forward the TO_* code verbatim (0xFFFFE9Dx band is disjoint from this file's 0xFFFFEAFx). (4) load _recovery_plane_takeover_seq_counter (leg-2 symbol) and stash into [rbx+16]. (5) store full u64 value 1 (TAKEOVER_ACTIVE) into [rbx+24]. (6) call recovery_console_paint_banner(rbx); paint failure is SWALLOWED (return RC_OK) because the load-bearing effect is the takeover swap, not the banner. No `test`, no `add reg,[mem]`, no `and r11,imm`. Labels prefixed recovery_console_ocd_.",
      block: {
        // (1) state_ptr null check.
        cmp rdi, 0;
        je  recovery_console_ocd_null_ptr;

        // Save state_ptr in rbx across the sub-calls (rbx is SysV
        // callee-save). push aligns rsp to 16 for the call.
        push rbx;
        mov  rbx, rdi;

        // (2) state must be IDLE (0).
        mov rax, [rbx + 24];
        and rax, 0xFF;
        cmp rax, 0;
        jne recovery_console_ocd_bad_state;

        // (3) marshal args for recovery_plane_takeover_execute.
        //     rdi = takeover_rights (word0[63:32])
        //     rsi = trigger        (already in rdx on entry; move)
        //     rdx = dead_pid       (already in rsi on entry; swap via r10)
        mov r10, rsi;                    // r10 = dead_pid (from entry rsi)
        mov rax, [rbx + 0];
        shr rax, 32;                     // rax = takeover_rights low32
        mov rdi, rax;                    // arg1 = takeover_rights
        mov rsi, rdx;                    // arg2 = trigger (from entry rdx)
        mov rdx, r10;                    // arg3 = dead_pid

        call recovery_plane_takeover_execute;

        // Non-zero return -> forward code (TO_NO_RIGHT / TO_WRONG_HOLDER /
        // TO_ALREADY_ACTIVE from leg 2's 0xFFFFE9Dx band).
        cmp rax, 0;
        jne recovery_console_ocd_forward;

        // (4) record takeover_seq from leg-2 counter.
        lea r10, [rip + _recovery_plane_takeover_seq_counter];
        mov rax, [r10];
        mov [rbx + 16], rax;             // word2: takeover_seq

        // (5) transition state to TAKEOVER_ACTIVE (1) via full-word store.
        mov rax, 1;
        mov [rbx + 24], rax;

        // (6) paint the banner. Failure is swallowed -- see justification.
        mov rdi, rbx;
        call recovery_console_paint_banner;

        xor rax, rax;                    // RC_OK
        pop rbx;
        ret;

      recovery_console_ocd_null_ptr:
        mov rax, 0xFFFFEAF5;             // RC_NULL_STATE_PTR
        ret;

      recovery_console_ocd_bad_state:
        mov rax, 0xFFFFEAF3;             // RC_BAD_STATE
        pop rbx;
        ret;

      recovery_console_ocd_forward:
        // rax already carries the TO_* code from leg 2.
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // recovery_console_paint_banner(state_ptr) -> u64
  //   rdi = state_ptr
  //
  // Copies the 64-byte banner into the first 64 char cells of the
  // caller's text buffer. Gate order:
  //   (1) state_ptr==0                     -> RC_NULL_STATE_PTR
  //   (2) text_buffer_ptr (word1) == 0     -> RC_NO_TEXT_BUFFER
  //   (3) byte copy loop (64 iterations, mov al,[rsi] / mov [rdi],al /
  //       add rsi,1 / add rdi,1 / sub rcx,1 / cmp rcx,0 / jne).
  //
  // State is NOT gated: the caller may paint from any state (typical
  // use: repaint after a partial-screen overwrite). The banner is the
  // same 64 bytes regardless of state.
  //
  // Labels prefixed recovery_console_pb_.
  // ==========================================================================

  pub let recovery_console_paint_banner : (u64) -> u64 !{mem} @{} =
    fn (state_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-01 (paideia-os #2275): 64-byte banner paint. (1) rdi==0 -> RC_NULL_STATE_PTR. (2) [rdi+8] (text_buffer_ptr) == 0 -> RC_NO_TEXT_BUFFER. (3) byte-oriented copy loop (mov al,[rsi] / mov [rdi],al / add rsi,1 / add rdi,1 / sub rcx,1 / cmp rcx,0 / jne) over rsi = _recovery_console_banner_bytes, rdi = text_buffer_ptr, rcx = 64. No rep prefix; no `test`; no `add reg,[mem]`. Byte-level load/store follows scsi_cmd.pdx st_beN pattern. Labels prefixed recovery_console_pb_.",
      block: {
        cmp rdi, 0;
        je  recovery_console_pb_null_ptr;

        mov rax, [rdi + 8];              // text_buffer_ptr
        cmp rax, 0;
        je  recovery_console_pb_no_buf;

        // Copy loop setup: rsi = banner, rdi = dst, rcx = 64.
        lea rsi, [rip + _recovery_console_banner_bytes];
        mov rdi, rax;
        mov rcx, 64;

      recovery_console_pb_top:
        cmp rcx, 0;
        je  recovery_console_pb_done;
        mov al, [rsi];
        mov [rdi], al;
        add rsi, 1;
        add rdi, 1;
        sub rcx, 1;
        jmp recovery_console_pb_top;

      recovery_console_pb_done:
        xor rax, rax;                    // RC_OK
        ret;

      recovery_console_pb_null_ptr:
        mov rax, 0xFFFFEAF5;             // RC_NULL_STATE_PTR
        ret;

      recovery_console_pb_no_buf:
        mov rax, 0xFFFFEAF4;             // RC_NO_TEXT_BUFFER
        ret
      }
    }

  // ==========================================================================
  // recovery_console_dispatch_input(state_ptr, key) -> u64
  //   rdi = state_ptr
  //   rsi = key (ASCII, post-HID-translation)
  //
  // Read-only on state (see sec-0). Returns an action code:
  //   RC_ACT_NONE               (0)
  //   RC_ACT_REBOOT             (1)  -- key == 0x0D (ENTER)
  //   RC_ACT_RESTART_COMPOSITOR (2)  -- key == 0x52 (R) or 0x72 (r)
  //
  // Or an error:
  //   RC_NULL_STATE_PTR         (0xFFFFEAF5) -- rdi == 0
  //   RC_BAD_STATE              (0xFFFFEAF3) -- state != TAKEOVER_ACTIVE
  //
  // Only ENTER and R (either case) map to actions; every other key --
  // including HID keycodes that happen to collide numerically with ASCII
  // controls -- returns RC_ACT_NONE. See sec-4 for the design rationale.
  //
  // Key comparison mask: key is taken as u8, so mask with 0xFF before
  // comparing. This lets the caller pass either a raw byte or a 32/64-
  // bit event word whose low byte carries the key -- both work.
  //
  // Labels prefixed recovery_console_di_.
  // ==========================================================================

  pub let recovery_console_dispatch_input : (u64, u64) -> u64 !{mem} @{} =
    fn (state_ptr: u64, key: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-01 (paideia-os #2275): read-only key dispatch. (1) rdi==0 -> RC_NULL_STATE_PTR. (2) state != TAKEOVER_ACTIVE (byte at [rdi+24] & 0xFF == 1) -> RC_BAD_STATE. (3) mask rsi with 0xFF; compare to 0x0D -> RC_ACT_REBOOT; 0x52 or 0x72 -> RC_ACT_RESTART_COMPOSITOR; else RC_ACT_NONE. State is NOT mutated. No `test`; no `add reg,[mem]`. Labels prefixed recovery_console_di_.",
      block: {
        cmp rdi, 0;
        je  recovery_console_di_null_ptr;

        // state must be TAKEOVER_ACTIVE (1).
        mov rax, [rdi + 24];
        and rax, 0xFF;
        cmp rax, 1;
        jne recovery_console_di_bad_state;

        // mask key to low byte.
        mov rax, rsi;
        and rax, 0xFF;

        // ENTER (0x0D) -> RC_ACT_REBOOT.
        cmp rax, 0x0D;
        je  recovery_console_di_reboot;

        // R uppercase (0x52) -> RC_ACT_RESTART_COMPOSITOR.
        cmp rax, 0x52;
        je  recovery_console_di_restart;

        // R lowercase (0x72) -> RC_ACT_RESTART_COMPOSITOR.
        cmp rax, 0x72;
        je  recovery_console_di_restart;

        // any other key -> RC_ACT_NONE (0).
        xor rax, rax;
        ret;

      recovery_console_di_reboot:
        mov rax, 1;                      // RC_ACT_REBOOT
        ret;

      recovery_console_di_restart:
        mov rax, 2;                      // RC_ACT_RESTART_COMPOSITOR
        ret;

      recovery_console_di_null_ptr:
        mov rax, 0xFFFFEAF5;             // RC_NULL_STATE_PTR
        ret;

      recovery_console_di_bad_state:
        mov rax, 0xFFFFEAF3;             // RC_BAD_STATE
        ret
      }
    }

  // ==========================================================================
  // recovery_console_release(state_ptr) -> u64
  //   rdi = state_ptr
  //
  // TAKEOVER_ACTIVE -> RECOVERED transition, called by the input-server
  // main loop after a NEW compositor has claimed the plane. Gate order:
  //   (1) state_ptr==0             -> RC_NULL_STATE_PTR
  //   (2) state != TAKEOVER_ACTIVE -> RC_BAD_STATE
  //   (3) store 2 (RECOVERED) into word3 (full-word store; no torn-byte
  //       window).
  //
  // Does NOT touch the leg-2 takeover primitive (releasing the takeover
  // primitive itself is a distinct concern to be landed as
  // recovery_plane_takeover_release in a future patch to leg 2). Does
  // NOT clear text_buffer_ptr or takeover_seq: those are useful audit
  // trail after recovery.
  //
  // Labels prefixed recovery_console_r_.
  // ==========================================================================

  pub let recovery_console_release : (u64) -> u64 !{mem} @{} =
    fn (state_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-01 (paideia-os #2275): TAKEOVER_ACTIVE -> RECOVERED transition. (1) rdi==0 -> RC_NULL_STATE_PTR. (2) state byte at [rdi+24] & 0xFF must equal 1 (TAKEOVER_ACTIVE) else RC_BAD_STATE. (3) store full u64 value 2 into [rdi+24]. text_buffer_ptr and takeover_seq are NOT cleared (audit trail after recovery). No `test`; no `add reg,[mem]`. Labels prefixed recovery_console_r_.",
      block: {
        cmp rdi, 0;
        je  recovery_console_r_null_ptr;

        mov rax, [rdi + 24];
        and rax, 0xFF;
        cmp rax, 1;
        jne recovery_console_r_bad_state;

        mov rax, 2;                      // RC_STATE_RECOVERED
        mov [rdi + 24], rax;

        xor rax, rax;                    // RC_OK
        ret;

      recovery_console_r_null_ptr:
        mov rax, 0xFFFFEAF5;             // RC_NULL_STATE_PTR
        ret;

      recovery_console_r_bad_state:
        mov rax, 0xFFFFEAF3;             // RC_BAD_STATE
        ret
      }
    }

  // ==========================================================================
  // Getters (RIGHT_QUERY_PLANE_INFO surface analog).
  //
  // All take state_ptr in rdi; NONE check for null (getters are
  // read-only and a null-pointer fault at the load is louder than a
  // silent zero return). Callers that want the null check use the
  // singleton or validate up front.
  //
  // Labels prefixed per-getter.
  // ==========================================================================

  pub let recovery_console_get_state : (u64) -> u64 !{mem} @{} =
    fn (state_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-01 (paideia-os #2275): read state byte at [rdi+24] and mask 0xFF. Labels prefixed recovery_console_gs_.",
      block: {
        mov rax, [rdi + 24];
        and rax, 0xFF;
        ret
      }
    }

  pub let recovery_console_get_reservation : (u64) -> u64 !{mem} @{} =
    fn (state_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-01 (paideia-os #2275): read plane_reservation_id (word0[31:0]) via shl 32/shr 32 zero-extend. Labels prefixed recovery_console_gr_.",
      block: {
        mov rax, [rdi + 0];
        shl rax, 32;
        shr rax, 32;
        ret
      }
    }

  pub let recovery_console_get_takeover_rights : (u64) -> u64 !{mem} @{} =
    fn (state_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-01 (paideia-os #2275): read takeover_rights (word0[63:32]) via shr 32. Labels prefixed recovery_console_gtr_.",
      block: {
        mov rax, [rdi + 0];
        shr rax, 32;
        ret
      }
    }

  pub let recovery_console_get_text_buffer_ptr : (u64) -> u64 !{mem} @{} =
    fn (state_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-01 (paideia-os #2275): read text_buffer_ptr (word1). Labels prefixed recovery_console_gtbp_.",
      block: {
        mov rax, [rdi + 8];
        ret
      }
    }

  pub let recovery_console_get_takeover_seq : (u64) -> u64 !{mem} @{} =
    fn (state_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-01 (paideia-os #2275): read takeover_seq (word2). Labels prefixed recovery_console_gts_.",
      block: {
        mov rax, [rdi + 16];
        ret
      }
    }

  // ==========================================================================
  // Defensive boot-time reset (.bss is already zero at real boot).
  //
  // Zeroes all four words of the caller-supplied state cell. Mirrors
  // rp_init / rpt_i_ / input_server_r_ in the sibling files. Labels
  // prefixed recovery_console_reset_.
  // ==========================================================================

  pub let recovery_console_reset : (u64) -> () !{mem} @{} =
    fn (state_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B10-01 (paideia-os #2275): zero the 32-byte state cell (four u64 stores). Defensive re-scrub; .bss is already zero at real boot. No null-ptr check: a null store faults loudly. Labels prefixed recovery_console_reset_.",
      block: {
        xor rax, rax;
        mov [rdi + 0],  rax;
        mov [rdi + 8],  rax;
        mov [rdi + 16], rax;
        mov [rdi + 24], rax;
        ret
      }
    }
}
