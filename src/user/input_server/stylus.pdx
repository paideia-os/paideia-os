// src/user/input_server/stylus.pdx -- Wave0-B10-03 (paideia-os #2284)
//
// KIND_STYLUS_DEVICE = 0x1DB, derived over KIND_INPUT_SERVER (0x1D0,
// landed by B8-01 in Wave-0 Batch-8). One Wacom-class stylus (pen,
// eraser, brush, airbrush, mouse-puck, lens) tracked on ONE bound
// KIND_SEAT (0x1D6), reporting pressure, tilt, button state, and
// tool-in-range (proximity) transitions. The pre-committed slot lives
// in seat_kind.pdx's SEAT_OP_BIND_STYLUS + seat_bind_stylus dance
// (B8-06, #2285, LANDED); this landing writes the row + factory + the
// four update paths (proximity, position, button) the input server's
// USB HID tablet driver will drive per report descriptor decode.
//
// Design authority:
//   * design/compositor/pwp-spec-vocabulary.md §2.12 KIND_STYLUS_DEVICE
//     (this landing seeds the ordinal + row layout; the spec section is
//     stub-shaped until the compositor pen-and-paper vocab review in
//     the next design batch). Parent-slot pin (KIND_INPUT_SERVER at
//     0x1D0) matches the sibling touch_contact / touch_device pattern
//     of hanging derived kinds off the input server rather than off
//     the seat: the driver's report decoder is a server-internal
//     consumer, not per-seat.
//   * design/compositor/pwp-spec-vocabulary.md §2.9 KIND_SEAT (B8-06
//     sibling landing) -- stylus_kind_id lives at ids3[31:0] of the
//     seat row; seat_bind_stylus is what wires a minted
//     KIND_STYLUS_DEVICE into a seat.
//   * design/roadmap/next-wave-synthesis.md §4 pitfall P2 -- the input
//     server IS the authority for stylus event dispatch; downstream
//     delivery is one-hop (via KIND_INPUT_ROUTE, 0x1D7) after the
//     driver decodes the HID report set. A minted KIND_STYLUS_DEVICE
//     is server-internal; clients never see a raw stylus cap, only the
//     resulting per-frame STYLUS_* delivery through their input route.
//
// PURPOSE. A derived-kind capability that names ONE physical stylus
// (identified by device_serial -- Wacom Intuos/Cintiq styli publish a
// 64-bit hardware serial in every HID report so the driver can tell a
// pen tip from an eraser tip from a barrel puck without misrouting a
// button press). The row carries:
//   * device_serial (u64)     -- hardware serial from the HID report.
//                                Nonzero required; zero would confuse
//                                the multi-tool dedup pass because the
//                                Wacom driver interprets serial==0 as
//                                "tool absent" per XI2's tool-in-proximity
//                                protocol.
//   * seat_kind_id (u32)      -- the KIND_SEAT (0x1D6) this stylus is
//                                bound to; determines which surface the
//                                per-frame event is delivered to (via
//                                the seat's active KIND_INPUT_ROUTE).
//   * current_tool (u8)       -- one of TOOL_PEN..TOOL_LENS. Wacom
//                                report descriptors distinguish six
//                                tool classes; the compositor's cursor
//                                theme picks its glyph off this byte.
//   * in_range (u8)           -- 0 = out of proximity, 1 = in range.
//                                A tool that lifts out of the sensor
//                                field returns to 0 and drops its
//                                pressure/button state on next update.
//   * pressure (u16)          -- 0..65535 linear, native Wacom
//                                resolution. Zero pressure is legal
//                                when the tool is hovering (in_range
//                                but no tip contact).
//   * tilt_x, tilt_y (i16)    -- device tilt in centidegrees
//                                (-9000..9000 = -90.00..90.00 deg).
//                                Wacom EMR styli report tilt via HID
//                                usage 0x3D/0x3E; the driver publishes
//                                the raw signed centidegree value.
//   * button_state (u8)       -- bitmask (bit 0 = BUTTON_TIP, bit 1 =
//                                BUTTON_BARREL_1, bit 2 = BUTTON_BARREL_2).
//                                XI2's ButtonPress/ButtonRelease
//                                boundaries live per-bit here so the
//                                compositor sees a debounced final
//                                state, not an intermediate half-press.
//   * pos_x, pos_y (i32)      -- surface-relative in surface-DPI
//                                pixels. i32 (not u32) because a stylus
//                                tracked to the surface edge and out
//                                still reports last-known coords with
//                                sub-zero or over-max values until
//                                out_of_range fires.
//   * last_seq (u64)          -- monotonic per-input-server sequence,
//                                bumped on EVERY update path (proximity,
//                                position, button). Consumers use the
//                                delta to detect a dropped USB report
//                                and reset their tilt-smoothing filter.
//
// A typical drawing session emits: proximity(in=1, tool=PEN) then
// position(x, y, p, tx, ty) at report rate (200 Hz on Wacom EMR) then
// proximity(in=0) on tool lift. The compositor's paint pipeline reads
// (pressure, tilt) each frame and thresholds against the last_seq
// delta to decide whether to interpolate a missed sample.
//
// =============================================================================
// NOVEL-CLEAN CHOICES
// =============================================================================
//
// (1) TOOL-IN-PROXIMITY IS A FIRST-CLASS FIELD, NOT AN EVENT KIND.
//     A stylus that hovers over the sensor without touching (in_range
//     == 1, pressure == 0) is a HOVER, not a "no report" gap. The
//     compositor's hover-target highlighter reads is_hovering(row) as
//     a single-load predicate and paints the affordance without waiting
//     for a synthetic ENTER/LEAVE stream. This mirrors XI2's
//     tool-in-proximity valuator (which every application ignores in
//     practice because XI2 delivers it as a spurious motion event with
//     zero pressure) but names the state directly at the row so no
//     downstream heuristic has to reconstruct "is this really a hover".
//
// (2) BUTTON STATE IS A BITMASK, NOT AN EVENT STREAM.
//     The compositor sees a live snapshot of which buttons are pressed
//     right now (bit 0 = TIP, bit 1 = BARREL_1, bit 2 = BARREL_2), not
//     a queue of ButtonPress/ButtonRelease transitions it has to fold.
//     Multi-button chords (tip + barrel_1 = pan tool, barrel_1 +
//     barrel_2 = context menu) are a single-load bitmask compare, not
//     a state-machine walk. XI2's per-button-event posture forces
//     every drawing app to keep a parallel bitmask synced by hand;
//     we hold the bitmask ourselves.
//
// (3) DEVICE SERIAL IS THE IDENTITY, NOT THE SEAT+TOOL COMBINATION.
//     A user with two identical Wacom pens (say a rocket-tipped and a
//     flat-tipped Intuos Pro pen) on the same tablet sees two distinct
//     KIND_STYLUS_DEVICE rows keyed by their factory-programmed
//     serials. A per-pen brush preset in the drawing app can key off
//     the serial without a "which pen is this" heuristic. Wacom's own
//     driver keys off serial for exactly this reason; the novelty
//     here is naming it as the row's primary identity rather than a
//     side-table lookup.
//
// (4) LAST_SEQ IS BUMPED ON EVERY UPDATE, INCLUDING BUTTON-ONLY.
//     A caller can compute "how stale is this row" from a single u64
//     compare rather than reasoning about position-only vs. button-only
//     paths. This makes the compositor's dropped-sample detector
//     trivial: any gap > 1 in last_seq between consecutive reads is
//     a missed report. XI2's per-event-kind seq numbering forces
//     every consumer to reconstruct a total order across streams; the
//     single-sequence-per-row posture folds that job into the row.
//
// =============================================================================
// SLOT ALLOCATION -- KIND_STYLUS_DEVICE = 0x1DB
// =============================================================================
//
// Consulted design/architecture/next-wave-derived-kinds.md and grepped
// src/ + tests/ for 0x1DB at landing time -- unclaimed (only reference
// is a commentary comment in src/user/compositor/present_feedback_kind.pdx
// noting "0x1DB..0x1DF open for sibling B9/B10 compositor landings",
// which explicitly leaves it for input-server-family use). Neighbours:
//   0x1D0  KIND_INPUT_SERVER               (B8-01 landed)
//   0x1D1  RP_COMPOSITOR_KIND_FORWARD      (recovery-plane forward kind)
//   0x1D2..0x1D5  device-kind reservations (KIND_KEYBOARD_DEVICE,
//                 KIND_POINTER_DEVICE, KIND_TOUCH_DEVICE = 0x1D4,
//                 KIND_STYLUS_DEVICE previously reserved at 0x1D5)
//   0x1D6  KIND_SEAT                       (B8-06 landed)
//   0x1D7  KIND_INPUT_ROUTE                (B8-07 landed)
//   0x1D8  KIND_TOUCH_CONTACT              (B9-03 landed)
//   0x1D9..0x1DA  unassigned
//   0x1DB  KIND_STYLUS_DEVICE              (THIS FILE, B10-03)
//   0x1DC..0x1DF  unassigned
//
// STYLUS_PARENT_KIND is the reconciliation point if B8-01 ends up
// rebinding 0x1D0; one-line edit + fingerprint re-emission.
//
// =============================================================================
// ROW LAYOUT -- 48 BYTES / 6 U64
// =============================================================================
//
//   [+0]  serial:   device_serial[63:0]
//   [+8]  ids:      seat_kind_id[31:0] | current_tool[39:32]
//                 | in_range[47:40]    | pressure[63:48]
//   [+16] tilt:     tilt_x[15:0]       | tilt_y[31:16]
//                 | button_state[39:32]| reserved[63:40]
//   [+24] pos:      pos_x[31:0]        | pos_y[63:32]      (both i32)
//   [+32] seq:      last_seq[63:0]
//   [+40] reserved: reserved0[63:0]                        (future:
//                                                          tool_serial_hi
//                                                          for 128-bit
//                                                          Wacom Cintiq
//                                                          Pro IDs)
//
// Every u32/i32/u16/i16 slot is packed via shl/shr masking (no
// `and reg, imm64` per this file's encoder-conservative posture,
// same as seat_kind / touch_contact). The one-byte fields (current_tool,
// in_range, button_state) use `and rax, 0xFF` (imm8-form on rax) plus
// shl to their target bit position -- no MOVZX/MOVSX generated.
// device_serial == 0 is refused so [+0] doubles as the row-empty
// sentinel (matches touch_contact's contact_id == 0 discipline).
//
// =============================================================================
// FAILURE TAXONOMY -- 0xFFFFEAB0..0xFFFFEABF
// =============================================================================
//
// Fresh 16-slot band, verified free at landing time by grep across
// src/**/*.pdx + tests/**/*.pdx (no existing 0xFFFFEAB* sentinel in
// tree). Neighbours (with the input-server-family bands for context):
//   0xFFFFEAA0..AF  entirely free (reserved for later Wave-0 rows)
//   0xFFFFEAB0..BF  KIND_STYLUS_DEVICE (THIS BAND)
//   0xFFFFEAC0..EAFF entirely free
//   0xFFFFEB70..7F  KIND_SEAT + KIND_INPUT_ROUTE (band shared)
//   0xFFFFEB80..8F  KIND_FOCUS_ROUTER
//   0xFFFFEB90..9F  AccelCurve (value type)
//   0xFFFFEBA0..AF  KIND_TOUCH_CONTACT
//
// The task-brief-suggested band 0xFFFFEC30..EC3F is already held by
// KIND_TTY (kind_tty.pdx §3), so this landing takes the nearest fresh
// 16-slot page verified free by grep -- 0xFFFFEAB0..0xFFFFEABF.
//
// =============================================================================
// ENCODER-CONSERVATIVE DISCIPLINE (per B10-03 spec)
// =============================================================================
//
//   * NO `test rN, rN`. Use `cmp rN, 0` instead (paideia-as U1605).
//   * NO `and r11, imm64`. r11 is internal scratch under U1615; stage
//     the mask through rax/r10 which accept small-imm AND, or use
//     shl/shr masking.
//   * NO 2-op imul-with-imm. Use reg-reg imul only.
//   * NO `add reg, [mem]`. Load through a scratch first, then
//     register-to-register `add`.
//   * NO MOVSX/MOVZX. Sign/zero extend via shl/sar or shl/shr pairs.
//   * u32 zero-extension via `shl 32; shr 32`. Small-imm AND
//     (`and rax, 0xFF`) on rax/r10 is acceptable for u8 extraction.
//   * i16 sign validation via `shl 48; sar 48` compare.
//
// Module = Stylus (M0305). Label prefix = stylus_. Tag size = strlen+1.

module Stylus = structure {

  // ==========================================================================
  // SECTION 1 -- KIND ORDINAL + PARENT
  // ==========================================================================

  pub let KIND_STYLUS_DEVICE   : u64 = 0x1DB
  pub let STYLUS_PARENT_KIND   : u64 = 0x1D0   // KIND_INPUT_SERVER

  // Pool ceiling. 4 concurrent styli -- a Wacom Cintiq Pro 32 tracks up
  // to 2 pens simultaneously (the "second pen" is typically a puck or
  // lens); 4 covers a multi-user shared-tablet edge case with margin.
  // 4 * 48 = 192 bytes -- three-quarters of one cache line pair, fits
  // well within a shared page with sibling device pools.
  pub let STYLUS_MAX           : u64 = 4
  pub let STYLUS_ROW_BYTES     : u64 = 48

  // Documentary masks -- assembly uses shl/shr masking.
  pub let STYLUS_U32_MAX       : u64 = 0xFFFFFFFF
  pub let STYLUS_U16_MAX       : u64 = 0xFFFF
  pub let STYLUS_U8_MAX        : u64 = 0xFF

  // ==========================================================================
  // SECTION 2 -- RIGHTS
  // ==========================================================================
  //
  // Seven rights on the KIND_STYLUS_DEVICE family. The (query-pressure,
  // query-tilt, query-button, subscribe-proximity, revoke) quintet is
  // the per-row working set; (R_STY_OBSERVE, R_STY_MINT) are the
  // derivation-family bits held on the parent (KIND_INPUT_SERVER) and
  // never on individual stylus rows.
  //
  //   RIGHT_QUERY_PRESSURE       -- read the current pressure value
  //   RIGHT_QUERY_TILT           -- read tilt_x / tilt_y
  //   RIGHT_QUERY_BUTTON         -- read the button_state bitmask
  //   RIGHT_SUBSCRIBE_PROXIMITY  -- receive proximity transitions
  //                                 (in_range 0<->1 edges)
  //   RIGHT_REVOKE               -- call the row's teardown (returns
  //                                 the row to the pool)
  //   R_STY_OBSERVE              -- introspection on the stylus table
  //                                 (row-count, per-seat aggregate) held
  //                                 on KIND_INPUT_SERVER, not on rows
  //   R_STY_MINT                 -- derive KIND_STYLUS_DEVICE rows (held
  //                                 on KIND_INPUT_SERVER); no client
  //                                 ever holds this

  pub let RIGHT_QUERY_PRESSURE      : u64 = 0x001
  pub let RIGHT_QUERY_TILT          : u64 = 0x002
  pub let RIGHT_QUERY_BUTTON        : u64 = 0x004
  pub let RIGHT_SUBSCRIBE_PROXIMITY : u64 = 0x008
  pub let RIGHT_REVOKE              : u64 = 0x010
  pub let R_STY_OBSERVE             : u64 = 0x020
  pub let R_STY_MINT                : u64 = 0x200
  pub let R_STY_ALL                 : u64 = 0x23F
     // 0x001 | 0x002 | 0x004 | 0x008 | 0x010 | 0x020 | 0x200

  // ==========================================================================
  // SECTION 3 -- STYLUSTOOL ENUM
  // ==========================================================================
  //
  // Six tool classes matching Wacom's HID report descriptor
  // publication set. TOOL_PEN is the default at mint time; the driver
  // transitions to TOOL_ERASER when the pen is flipped (Wacom EMR
  // pens publish a distinct tool-serial-suffix bit that the driver
  // decodes as the eraser tip); TOOL_BRUSH / TOOL_AIRBRUSH are the
  // pressure-and-tilt-modulated brush variants; TOOL_MOUSE is the
  // Wacom Intuos mouse puck (a coordinate-only tool with no pressure);
  // TOOL_LENS is the magnifier puck (also coordinate-only).

  pub let TOOL_PEN             : u64 = 0
  pub let TOOL_ERASER          : u64 = 1
  pub let TOOL_BRUSH           : u64 = 2
  pub let TOOL_AIRBRUSH        : u64 = 3
  pub let TOOL_MOUSE           : u64 = 4
  pub let TOOL_LENS            : u64 = 5
  pub let TOOL_MAX             : u64 = 5

  // ==========================================================================
  // SECTION 4 -- STYLUSBUTTON ENUM
  // ==========================================================================
  //
  // Three buttons matching the Wacom Pro Pen 2's physical control set.
  // Enum value is the bit position in button_state (BUTTON_TIP = bit 0,
  // BUTTON_BARREL_1 = bit 1, BUTTON_BARREL_2 = bit 2). Higher-bit
  // slots are reserved for future stylus models with additional
  // controls (Wacom's rocker-switch pens publish up to 4 button bits).

  pub let BUTTON_TIP           : u64 = 0
  pub let BUTTON_BARREL_1      : u64 = 1
  pub let BUTTON_BARREL_2      : u64 = 2
  pub let BUTTON_MAX           : u64 = 2

  // Bit-mask constants for button_state (bit position = enum value).
  pub let BUTTON_MASK_TIP      : u64 = 0x01
  pub let BUTTON_MASK_BARREL_1 : u64 = 0x02
  pub let BUTTON_MASK_BARREL_2 : u64 = 0x04

  // ==========================================================================
  // SECTION 5 -- ROW LAYOUT OFFSETS
  // ==========================================================================

  pub let STYLUS_OFF_SERIAL    : u64 = 0    // device_serial (full u64)
  pub let STYLUS_OFF_IDS       : u64 = 8    // seat | tool | in_range | pressure
  pub let STYLUS_OFF_TILT      : u64 = 16   // tilt_x | tilt_y | button_state | rsvd
  pub let STYLUS_OFF_POS       : u64 = 24   // pos_x | pos_y (both i32)
  pub let STYLUS_OFF_SEQ       : u64 = 32   // last_seq (full u64)
  pub let STYLUS_OFF_RSVD      : u64 = 40   // reserved (full u64)

  // Sub-word bit positions for STYLUS_OFF_IDS:
  //   seat_kind_id  bits [31:0]
  //   current_tool  bits [39:32]
  //   in_range      bits [47:40]
  //   pressure      bits [63:48]
  pub let STYLUS_IDS_TOOL_SHIFT     : u64 = 32
  pub let STYLUS_IDS_IN_RANGE_SHIFT : u64 = 40
  pub let STYLUS_IDS_PRESSURE_SHIFT : u64 = 48

  // Sub-word bit positions for STYLUS_OFF_TILT:
  //   tilt_x        bits [15:0]
  //   tilt_y        bits [31:16]
  //   button_state  bits [39:32]
  //   reserved      bits [63:40]
  pub let STYLUS_TILT_TILT_Y_SHIFT  : u64 = 16
  pub let STYLUS_TILT_BUTTON_SHIFT  : u64 = 32

  // ==========================================================================
  // SECTION 6 -- OP TAGS (dispatch surface)
  // ==========================================================================

  pub let STY_OP_MINT               : u64 = 0
  pub let STY_OP_UPDATE_PROXIMITY   : u64 = 1
  pub let STY_OP_UPDATE_POSITION    : u64 = 2
  pub let STY_OP_UPDATE_BUTTON      : u64 = 3
  pub let STY_OP_QUERY_PRESSURE     : u64 = 4
  pub let STY_OP_QUERY_TILT         : u64 = 5
  pub let STY_OP_QUERY_BUTTON       : u64 = 6
  pub let STY_OP_QUERY_TOOL         : u64 = 7
  pub let STY_OP_QUERY_IN_RANGE     : u64 = 8
  pub let STY_OP_QUERY_SEAT         : u64 = 9
  pub let STY_OP_QUERY_SERIAL       : u64 = 10
  pub let STY_OP_REVOKE             : u64 = 11
  pub let STY_OP_MAX                : u64 = 11

  // ==========================================================================
  // SECTION 7 -- FAILURE TAXONOMY -- 0xFFFFEAB0..0xFFFFEABF
  // ==========================================================================

  pub let STYLUS_OK                  : u64 = 0
  pub let STYLUS_TAIL_ENOSPC         : u64 = 0xFFFFEABF
  pub let STYLUS_MINT_BAD_SERIAL     : u64 = 0xFFFFEABE
  pub let STYLUS_MINT_BAD_SEAT       : u64 = 0xFFFFEABD
  pub let STYLUS_PROX_BAD_TOOL       : u64 = 0xFFFFEABC
  pub let STYLUS_PROX_BAD_IN_RANGE   : u64 = 0xFFFFEABB
  pub let STYLUS_POS_BAD_PRESSURE    : u64 = 0xFFFFEABA
  pub let STYLUS_POS_BAD_TILT_X      : u64 = 0xFFFFEAB9
  pub let STYLUS_POS_BAD_TILT_Y      : u64 = 0xFFFFEAB8
  pub let STYLUS_BUTTON_BAD_KIND     : u64 = 0xFFFFEAB7
  pub let STYLUS_BUTTON_BAD_PRESSED  : u64 = 0xFFFFEAB6
  pub let STYLUS_ROW_NONE            : u64 = 0xFFFFEAB5
  pub let STYLUS_BAD_SLOT            : u64 = 0xFFFFEAB4
  pub let STYLUS_BAD_RIGHTS          : u64 = 0xFFFFEAB3
  pub let STYLUS_WRONG_KIND          : u64 = 0xFFFFEAB2
  pub let STYLUS_UNSUP_OP            : u64 = 0xFFFFEAB1
  pub let STYLUS_REVOKE_ALREADY      : u64 = 0xFFFFEAB0

  // ==========================================================================
  // SECTION 8 -- STATS COUNTER SLOTS (declaratory)
  // ==========================================================================

  pub let STY_ST_MINTS               : u64 = 0
  pub let STY_ST_PROXIMITY_UPDATES   : u64 = 1
  pub let STY_ST_POSITION_UPDATES    : u64 = 2
  pub let STY_ST_BUTTON_UPDATES      : u64 = 3
  pub let STY_ST_REFUSED             : u64 = 4
  pub let STY_ST_REVOKES             : u64 = 5
  pub let STY_ST_MAX                 : u64 = 6

  // ==========================================================================
  // SECTION 9 -- FINGERPRINT (one line, legacy-suffixed)
  // ==========================================================================
  //
  // Emitted once on successful stylus_device_mint by the future
  // substrate. The legacy-suffix convention is what
  // tools/verify-fingerprint-coverage.sh enumerates. No fingerprint on
  // proximity / position / button / query paths.
  //
  // Byte count: "stylus device meta [legacy: STYLUS DEVICE META OK]\0"
  //   = 50 chars + NUL = 51.
  pub let pdx_kind_stylus_meta : [u8; 51] = "stylus device meta [legacy: STYLUS DEVICE META OK]\0"

  // ==========================================================================
  // SECTION 10 -- VALIDATORS (pure leaves)
  // ==========================================================================
  //
  // Every function here is a pure, unsafe-bodied leaf with small
  // immediates. Returns in rax, clobbers rax + one scratch. No `test`,
  // no `and reg, imm64`, no MOVZX/MOVSX. Labels prefixed stylus_.

  // stylus_serial_valid(serial) -> 1 iff serial != 0.
  // Zero is refused: Wacom's XI2 tool-in-proximity protocol interprets
  // serial==0 as "tool absent"; a row with a zero serial cannot be
  // dedup-ed against sibling tools on the same physical tablet.
  pub let stylus_serial_valid : (u64) -> u64 !{} @{} =
    fn (serial: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "B10-03 (#2284): device_serial validator (nonzero, full u64). Zero refused so [+0] doubles as row-empty sentinel and matches Wacom's XI2 tool-in-proximity convention (serial==0 == tool absent). Small immediate compare, no encoder concern. Labels prefixed stylus_sv_.",
      block: {
        cmp rdi, 0;
        je  stylus_sv_no;
        mov rax, 1;
        ret;
      stylus_sv_no:
        xor rax, rax;
        ret
      }
    }

  // stylus_seat_valid(seat_kind_id) -> 1 iff in (0, 2^32).
  pub let stylus_seat_valid : (u64) -> u64 !{} @{} =
    fn (seat_kind_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "B10-03 (#2284): seat kind_id validator (nonzero + fits u32). Zero refused: a stylus with no seat has nowhere to route its per-frame event. Uses shr 32 rather than `and reg, 0xFFFFFFFF`. Labels prefixed stylus_stv_.",
      block: {
        cmp rdi, 0;
        je  stylus_stv_no;
        mov rax, rdi;
        shr rax, 32;
        cmp rax, 0;
        jne stylus_stv_no;
        mov rax, 1;
        ret;
      stylus_stv_no:
        xor rax, rax;
        ret
      }
    }

  // stylus_tool_valid(tool) -> 1 iff tool in [0..TOOL_MAX=5].
  pub let stylus_tool_valid : (u64) -> u64 !{} @{} =
    fn (tool: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "B10-03 (#2284): tool enum validator (TOOL_PEN=0..TOOL_LENS=5). Small immediate compare; ja captures both signed-negative (never happens with u64) and > 5. Labels prefixed stylus_tv_.",
      block: {
        cmp rdi, 5;
        ja  stylus_tv_no;
        mov rax, 1;
        ret;
      stylus_tv_no:
        xor rax, rax;
        ret
      }
    }

  // stylus_in_range_valid(in_range) -> 1 iff in_range in [0, 1].
  pub let stylus_in_range_valid : (u64) -> u64 !{} @{} =
    fn (in_range: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "B10-03 (#2284): in_range validator (0 = out of proximity, 1 = in range). Small immediate compare. Labels prefixed stylus_irv_.",
      block: {
        cmp rdi, 1;
        ja  stylus_irv_no;
        mov rax, 1;
        ret;
      stylus_irv_no:
        xor rax, rax;
        ret
      }
    }

  // stylus_pressure_valid(pressure) -> 1 iff fits u16.
  // Zero IS legal (a hovering stylus reads zero pressure without lift).
  pub let stylus_pressure_valid : (u64) -> u64 !{} @{} =
    fn (pressure: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "B10-03 (#2284): pressure validator (fits u16; zero legal). Uses shr 16 to check upper bits are clear rather than `and reg, 0xFFFF`. Labels prefixed stylus_pv_.",
      block: {
        mov rax, rdi;
        shr rax, 16;
        cmp rax, 0;
        jne stylus_pv_no;
        mov rax, 1;
        ret;
      stylus_pv_no:
        xor rax, rax;
        ret
      }
    }

  // stylus_tilt_valid(tilt) -> 1 iff tilt fits in i16 (sign-extended low
  // 16 bits equal the input). Range check against -9000..9000 is the
  // caller's business; here we only guarantee the tilt fits the row
  // slot's signed 16-bit width so packing doesn't truncate silently.
  pub let stylus_tilt_valid : (u64) -> u64 !{} @{} =
    fn (tilt: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "B10-03 (#2284): tilt validator (fits i16). Sign-extends low 16 bits via shl 48 / sar 48 and compares with input; if equal, tilt fits in i16 (no smearing). No MOVSX generated. Labels prefixed stylus_tlv_.",
      block: {
        mov rax, rdi;
        shl rax, 48;
        sar rax, 48;
        cmp rax, rdi;
        jne stylus_tlv_no;
        mov rax, 1;
        ret;
      stylus_tlv_no:
        xor rax, rax;
        ret
      }
    }

  // stylus_button_valid(button_kind) -> 1 iff in [0..BUTTON_MAX=2].
  pub let stylus_button_valid : (u64) -> u64 !{} @{} =
    fn (button_kind: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "B10-03 (#2284): button-kind enum validator (BUTTON_TIP=0..BUTTON_BARREL_2=2). Small immediate compare. Labels prefixed stylus_bv_.",
      block: {
        cmp rdi, 2;
        ja  stylus_bv_no;
        mov rax, 1;
        ret;
      stylus_bv_no:
        xor rax, rax;
        ret
      }
    }

  // stylus_pressed_valid(pressed) -> 1 iff pressed in [0, 1].
  pub let stylus_pressed_valid : (u64) -> u64 !{} @{} =
    fn (pressed: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "B10-03 (#2284): pressed-flag validator (0 = released, 1 = pressed). Small immediate compare. Labels prefixed stylus_pdv_.",
      block: {
        cmp rdi, 1;
        ja  stylus_pdv_no;
        mov rax, 1;
        ret;
      stylus_pdv_no:
        xor rax, rax;
        ret
      }
    }

  // stylus_rights_valid(rights) -> 1 iff rights subset of R_STY_ALL.
  pub let stylus_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "B10-03 (#2284): rights subset test against R_STY_ALL = 0x23F. Small imm, so `and reg, imm32` sign-extends 0x23F to 0x000000000000023F -- correct as a mask. Labels prefixed stylus_rv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x23F;
        and rax, r10;
        cmp rax, rdi;
        jne stylus_rv_no;
        mov rax, 1;
        ret;
      stylus_rv_no:
        xor rax, rax;
        ret
      }
    }

  // stylus_op_valid(op) -> 1 iff op in [0, STY_OP_MAX=11].
  pub let stylus_op_valid : (u64) -> u64 !{} @{} =
    fn (op: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "B10-03 (#2284): dispatch op validator. Admits 0..11. Small immediate. Labels prefixed stylus_ov_.",
      block: {
        cmp rdi, 11;
        ja  stylus_ov_no;
        mov rax, 1;
        ret;
      stylus_ov_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // SECTION 11 -- FACTORY: stylus_device_mint(serial, seat) -> row_id
  // ==========================================================================
  //
  // Stub factory (matches route_kind's input_route_mint and
  // touch_contact's touch_contact_track posture). Validates inputs and,
  // on success, returns sentinel row_id 1; returns a STYLUS_MINT_* on
  // refusal. The real row-write path (pool allocation via a future
  // _sty_pool_alloc, packed writes at STYLUS_OFF_SERIAL..STYLUS_OFF_RSVD
  // with current_tool = TOOL_PEN, in_range = 0, pressure = 0,
  // button_state = 0, last_seq initial = 0, stats bump on STY_ST_MINTS,
  // fingerprint emit) lands in the follow-up substrate milestone.
  //
  // Validation order: serial, seat.
  //
  // Signature: (serial, seat) -> u64
  //   serial: rdi (u64, nonzero)
  //   seat:   rsi (u32, nonzero, KIND_SEAT slot)

  pub let stylus_device_mint : (u64, u64) -> u64 !{} @{} =
    fn (serial: u64) (seat: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "B10-03 (#2284): stylus_device_mint stub factory. Validation order: (1) serial nonzero else STYLUS_MINT_BAD_SERIAL (0xFFFFEABE); (2) seat nonzero + fits u32 else STYLUS_MINT_BAD_SEAT (0xFFFFEABD). On success returns sentinel row_id 1 (real pool allocation lands in the follow-up substrate milestone; the sentinel matches route_kind's input_route_mint and touch_contact's touch_contact_track posture). Scratch: rax, r10. All u32 checks via shr rather than `and reg, imm64`. Labels prefixed stylus_m_.",
      block: {
        // Validate serial (nonzero).
        cmp rdi, 0;
        je  stylus_m_bad_serial;

        // Validate seat (nonzero, fits u32).
        cmp rsi, 0;
        je  stylus_m_bad_seat;
        mov r10, rsi;
        shr r10, 32;
        cmp r10, 0;
        jne stylus_m_bad_seat;

        // Success: sentinel row_id 1 (never 0; row 0 reserved).
        mov rax, 1;
        ret;

      stylus_m_bad_serial:
        mov rax, 0xFFFFEABE;    // STYLUS_MINT_BAD_SERIAL
        ret;
      stylus_m_bad_seat:
        mov rax, 0xFFFFEABD;    // STYLUS_MINT_BAD_SEAT
        ret
      }
    }

  // ==========================================================================
  // SECTION 12 -- UPDATE PROXIMITY:
  //   stylus_device_update_proximity(row_ptr, in_range, tool) -> status
  // ==========================================================================
  //
  // Real memory-mutating function. Rewrites the ids word ([+8]) to
  // update current_tool (bits [39:32]) and in_range (bits [47:40])
  // preserving seat_kind_id (bits [31:0]) and pressure (bits [63:48]).
  // Bumps last_seq by 1.
  //
  // Refuses on:
  //   * row_ptr == 0          -> STYLUS_ROW_NONE
  //   * in_range > 1          -> STYLUS_PROX_BAD_IN_RANGE
  //   * tool > TOOL_MAX (5)   -> STYLUS_PROX_BAD_TOOL
  //
  // Signature: (row_ptr, in_range, tool) -> u64
  //   row_ptr:  rdi (pointer to 48-byte row)
  //   in_range: rsi (u8, 0 or 1)
  //   tool:     rdx (u8, 0..5)

  pub let stylus_device_update_proximity : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (row_ptr: u64) (in_range: u64) (tool: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "B10-03 (#2284): update proximity (current_tool + in_range) preserving seat_kind_id and pressure. Validation order: row_ptr nonzero (STYLUS_ROW_NONE), in_range <= 1 (STYLUS_PROX_BAD_IN_RANGE), tool <= 5 (STYLUS_PROX_BAD_TOOL). All validated before any store: a refused update leaves the row byte-identical. Ids word rebuild: load current ids into rax; extract seat_kind_id (shl 32; shr 32) into r10; extract pressure (shr 48; shl 48) into r11; OR seat + (tool masked & shifted to [39:32]) + (in_range masked & shifted to [47:40]) + pressure. Bumps last_seq via load/add/store on [+32] (no add-reg-mem). Scratch: rax, r10, r11. Labels prefixed stylus_up_.",
      block: {
        // ---- Validate row_ptr nonzero. ----
        cmp rdi, 0;
        je  stylus_up_bad_row;

        // ---- Validate in_range in [0, 1]. ----
        cmp rsi, 1;
        ja  stylus_up_bad_in_range;

        // ---- Validate tool <= 5. ----
        cmp rdx, 5;
        ja  stylus_up_bad_tool;

        // ---- Rebuild ids word: preserve seat + pressure, replace tool + in_range. ----
        mov rax, [rdi + 8];       // load current ids
        // Extract seat_kind_id (low 32) into r10.
        mov r10, rax;
        shl r10, 32;
        shr r10, 32;              // r10 = seat_kind_id at [31:0]
        // Extract pressure (bits [63:48]) into r11.
        mov r11, rax;
        shr r11, 48;              // r11 = pressure in low 16
        shl r11, 48;              // r11 = pressure at [63:48]

        // Build tool byte at [39:32] via rax, then OR into r11.
        mov rax, rdx;
        and rax, 0xFF;            // profile to u8 (imm8 on rax)
        shl rax, 32;              // tool at [39:32]
        or  r11, rax;

        // Build in_range byte at [47:40] via rax, then OR into r11.
        mov rax, rsi;
        and rax, 0xFF;
        shl rax, 40;              // in_range at [47:40]
        or  r11, rax;

        // OR seat_kind_id.
        or  r11, r10;

        // Store the rebuilt ids word.
        mov [rdi + 8], r11;

        // ---- Bump last_seq at [+32]. ----
        mov rax, [rdi + 32];
        add rax, 1;
        mov [rdi + 32], rax;

        // STYLUS_OK.
        xor rax, rax;
        ret;

      stylus_up_bad_row:
        mov rax, 0xFFFFEAB5;      // STYLUS_ROW_NONE
        ret;
      stylus_up_bad_in_range:
        mov rax, 0xFFFFEABB;      // STYLUS_PROX_BAD_IN_RANGE
        ret;
      stylus_up_bad_tool:
        mov rax, 0xFFFFEABC;      // STYLUS_PROX_BAD_TOOL
        ret
      }
    }

  // ==========================================================================
  // SECTION 13 -- UPDATE POSITION:
  //   stylus_device_update_position(row_ptr, x, y, pressure, tilt_x, tilt_y) -> status
  // ==========================================================================
  //
  // Real memory-mutating function. Rewrites:
  //   * pos word at [+24]: pos_x[31:0] | pos_y[63:32]
  //   * ids word at [+8]:  preserves seat + tool + in_range, replaces pressure[63:48]
  //   * tilt word at [+16]: preserves button_state + reserved, replaces tilt_x + tilt_y
  // Bumps last_seq by 1.
  //
  // Refuses on:
  //   * row_ptr == 0             -> STYLUS_ROW_NONE
  //   * pressure > 0xFFFF        -> STYLUS_POS_BAD_PRESSURE
  //   * tilt_x doesn't fit i16   -> STYLUS_POS_BAD_TILT_X
  //   * tilt_y doesn't fit i16   -> STYLUS_POS_BAD_TILT_Y
  //
  // x / y are i32; the packer truncates on write (matches X11's silent-
  // truncate posture for legacy driver quirks).
  //
  // Signature: (row_ptr, x, y, pressure, tilt_x, tilt_y) -> u64
  //   row_ptr:  rdi (pointer)
  //   x:        rsi (i32; packer truncates)
  //   y:        rdx (i32; packer truncates)
  //   pressure: rcx (u16)
  //   tilt_x:   r8  (i16)
  //   tilt_y:   r9  (i16)

  pub let stylus_device_update_position : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (row_ptr: u64) (x: u64) (y: u64) (pressure: u64)
       (tilt_x: u64) (tilt_y: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "B10-03 (#2284): update position (pos_x, pos_y, pressure, tilt_x, tilt_y). Preserves serial ([+0]), seat + tool + in_range in ids word ([+8] low 48 bits), button_state + reserved in tilt word ([+16] bits [39:40+]). Validation order: row_ptr nonzero (STYLUS_ROW_NONE), pressure fits u16 (STYLUS_POS_BAD_PRESSURE) via shr 16, tilt_x fits i16 (STYLUS_POS_BAD_TILT_X) via shl 48/sar 48 compare, tilt_y fits i16 (STYLUS_POS_BAD_TILT_Y) via same. All validated before any store. Word rebuilds documented inline. Bumps last_seq via load/add/store on [+32]. Scratch: rax, r10, r11. Callee-save push of r12/r13 not required (all params live in caller-saved regs and are consumed in order). Labels prefixed stylus_ud_.",
      block: {
        // ---- Validate row_ptr nonzero. ----
        cmp rdi, 0;
        je  stylus_ud_bad_row;

        // ---- Validate pressure fits u16. ----
        mov r10, rcx;
        shr r10, 16;
        cmp r10, 0;
        jne stylus_ud_bad_pressure;

        // ---- Validate tilt_x fits i16 (shl 48 / sar 48 compare). ----
        mov r10, r8;
        shl r10, 48;
        sar r10, 48;
        cmp r10, r8;
        jne stylus_ud_bad_tilt_x;

        // ---- Validate tilt_y fits i16. ----
        mov r10, r9;
        shl r10, 48;
        sar r10, 48;
        cmp r10, r9;
        jne stylus_ud_bad_tilt_y;

        // ---- Rebuild pos word at [+24]: pos_x[31:0] | pos_y[63:32]. ----
        // rax = x & 0xFFFFFFFF
        mov rax, rsi;
        shl rax, 32;
        shr rax, 32;
        // r10 = y << 32 (truncates high bits)
        mov r10, rdx;
        shl r10, 32;
        or  rax, r10;
        mov [rdi + 24], rax;

        // ---- Rebuild ids word at [+8]: replace pressure[63:48], preserve rest. ----
        mov rax, [rdi + 8];       // load current ids
        // Extract low 48 bits (seat + tool + in_range) via shl 16; shr 16.
        mov r10, rax;
        shl r10, 16;
        shr r10, 16;              // r10 = low 48 bits (bits [47:0])
        // Build new pressure at [63:48] via rax, then OR.
        mov rax, rcx;
        shl rax, 48;              // pressure at [63:48] (truncates high bits)
        or  r10, rax;
        mov [rdi + 8], r10;

        // ---- Rebuild tilt word at [+16]: replace tilt_x + tilt_y, preserve high. ----
        mov rax, [rdi + 16];      // load current tilt word
        // Extract high 32 bits (button_state + reserved) via shr 32; shl 32.
        mov r10, rax;
        shr r10, 32;
        shl r10, 32;              // r10 = bits [63:32] preserved
        // Build new tilt_x at [15:0] via rax.
        mov rax, r8;
        shl rax, 48;
        shr rax, 48;              // rax = tilt_x zero-extended to u16
        or  r10, rax;
        // Build new tilt_y at [31:16] via rax.
        mov rax, r9;
        shl rax, 48;
        shr rax, 32;              // tilt_y at [31:16] (zero-extended to u16 then shifted up)
        or  r10, rax;
        mov [rdi + 16], r10;

        // ---- Bump last_seq at [+32]. ----
        mov rax, [rdi + 32];
        add rax, 1;
        mov [rdi + 32], rax;

        // STYLUS_OK.
        xor rax, rax;
        ret;

      stylus_ud_bad_row:
        mov rax, 0xFFFFEAB5;      // STYLUS_ROW_NONE
        ret;
      stylus_ud_bad_pressure:
        mov rax, 0xFFFFEABA;      // STYLUS_POS_BAD_PRESSURE
        ret;
      stylus_ud_bad_tilt_x:
        mov rax, 0xFFFFEAB9;      // STYLUS_POS_BAD_TILT_X
        ret;
      stylus_ud_bad_tilt_y:
        mov rax, 0xFFFFEAB8;      // STYLUS_POS_BAD_TILT_Y
        ret
      }
    }

  // ==========================================================================
  // SECTION 14 -- UPDATE BUTTON:
  //   stylus_device_update_button(row_ptr, button_kind, pressed) -> status
  // ==========================================================================
  //
  // Real memory-mutating function. Rewrites bits [39:32] of the tilt
  // word ([+16]) to set (pressed==1) or clear (pressed==0) the bit
  // corresponding to button_kind (BUTTON_TIP=0..BUTTON_BARREL_2=2).
  // Preserves tilt_x, tilt_y, and reserved bits. Bumps last_seq by 1.
  //
  // Refuses on:
  //   * row_ptr == 0            -> STYLUS_ROW_NONE
  //   * button_kind > 2         -> STYLUS_BUTTON_BAD_KIND
  //   * pressed > 1             -> STYLUS_BUTTON_BAD_PRESSED
  //
  // Bit-mask derivation via explicit per-button branch (avoids
  // `shl reg, cl` which the encoder-conservative posture sidesteps).
  //
  // Signature: (row_ptr, button_kind, pressed) -> u64
  //   row_ptr:     rdi (pointer)
  //   button_kind: rsi (u8, 0..2)
  //   pressed:     rdx (u8, 0 or 1)

  pub let stylus_device_update_button : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (row_ptr: u64) (button_kind: u64) (pressed: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "B10-03 (#2284): update button_state bit in the tilt word ([+16], bits [39:32]) preserving tilt_x, tilt_y, and reserved bits. Validation order: row_ptr nonzero (STYLUS_ROW_NONE), button_kind <= 2 (STYLUS_BUTTON_BAD_KIND), pressed <= 1 (STYLUS_BUTTON_BAD_PRESSED). All validated before any store. Bit-mask (1, 2, or 4) selected via explicit per-button branch to avoid `shl reg, cl` under this file's encoder-conservative posture. Set: OR the mask into button_state; clear: NOT the mask (full 64-bit inversion, harmless since button_state is masked to bits [7:0] before rebuild) then AND. Bumps last_seq via load/add/store on [+32]. Scratch: rax, r10, r11. Labels prefixed stylus_ub_.",
      block: {
        // ---- Validate row_ptr nonzero. ----
        cmp rdi, 0;
        je  stylus_ub_bad_row;

        // ---- Validate button_kind <= 2. ----
        cmp rsi, 2;
        ja  stylus_ub_bad_kind;

        // ---- Validate pressed <= 1. ----
        cmp rdx, 1;
        ja  stylus_ub_bad_pressed;

        // ---- Select bit mask via per-button branch. ----
        cmp rsi, 0;
        je  stylus_ub_mask_tip;
        cmp rsi, 1;
        je  stylus_ub_mask_b1;
        // Fallthrough: button_kind == 2 -> mask = 4.
        mov r11, 4;
        jmp stylus_ub_have_mask;
      stylus_ub_mask_tip:
        mov r11, 1;
        jmp stylus_ub_have_mask;
      stylus_ub_mask_b1:
        mov r11, 2;
      stylus_ub_have_mask:
        // r11 = bit mask (1, 2, or 4) in low 8 bits.

        // ---- Load tilt word, extract current button_state into r10. ----
        mov rax, [rdi + 16];
        mov r10, rax;
        shr r10, 32;
        and r10, 0xFF;            // r10 = current button_state (u8 in bits [7:0])

        // ---- Apply set or clear. ----
        cmp rdx, 0;
        je  stylus_ub_clear;
        // Set: r10 |= r11
        or  r10, r11;
        jmp stylus_ub_after_bit;
      stylus_ub_clear:
        // Clear: r10 &= ~r11. NOT r11 flips full 64 bits; the subsequent
        // AND is harmless because r10 carries button_state only in bits
        // [7:0] and the rebuild below re-masks via shl 32 (bits [39:32]).
        not r11;
        and r10, r11;
      stylus_ub_after_bit:

        // ---- Rebuild tilt word: preserve high 24 bits, replace button. ----
        // rax still holds original tilt word.
        // Extract high 24 bits (bits [63:40]) via shr 40; shl 40 -- into r11.
        mov r11, rax;
        shr r11, 40;
        shl r11, 40;              // r11 = bits [63:40] preserved (reserved)
        // Extract low 32 bits (tilt_x + tilt_y) via shl 32; shr 32 -- into rax.
        shl rax, 32;
        shr rax, 32;              // rax = bits [31:0] preserved
        or  r11, rax;
        // Position new button_state at [39:32].
        and r10, 0xFF;            // ensure only low 8 bits set
        shl r10, 32;              // button_state at [39:32]
        or  r11, r10;
        mov [rdi + 16], r11;

        // ---- Bump last_seq at [+32]. ----
        mov rax, [rdi + 32];
        add rax, 1;
        mov [rdi + 32], rax;

        // STYLUS_OK.
        xor rax, rax;
        ret;

      stylus_ub_bad_row:
        mov rax, 0xFFFFEAB5;      // STYLUS_ROW_NONE
        ret;
      stylus_ub_bad_kind:
        mov rax, 0xFFFFEAB7;      // STYLUS_BUTTON_BAD_KIND
        ret;
      stylus_ub_bad_pressed:
        mov rax, 0xFFFFEAB6;      // STYLUS_BUTTON_BAD_PRESSED
        ret
      }
    }

  // ==========================================================================
  // SECTION 15 -- PREDICATES
  // ==========================================================================
  //
  // Boolean predicates used by the compositor's cursor/paint pipeline.
  // Both take a row_ptr and return 1 (true) or 0 (false) in rax.

  // stylus_device_is_hovering(row_ptr) -> bool.
  // TRUE iff in_range == 1 AND pressure == 0 (the tool is over the
  // sensor but not touching -- a HOVER for cursor-target highlighting).
  pub let stylus_device_is_hovering : (u64) -> u64 !{mem} @{} =
    fn (row_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "B10-03 (#2284): predicate 'is hovering' = (in_range == 1 && pressure == 0). Reads the ids word ([+8]), extracts in_range byte (bits [47:40]) via shr 40 + and 0xFF, extracts pressure u16 (bits [63:48]) via shr 48. Returns 1 iff both conditions hold, else 0. Single load, arithmetic in registers -- no MOVZX. Scratch: rax, r10, r11. Labels prefixed stylus_ih_.",
      block: {
        mov rax, [rdi + 8];       // load ids word
        // Extract in_range into r10.
        mov r10, rax;
        shr r10, 40;
        and r10, 0xFF;            // r10 = in_range (0 or 1)
        cmp r10, 1;
        jne stylus_ih_no;
        // Extract pressure into r11 (shr 48 clears top bits automatically).
        mov r11, rax;
        shr r11, 48;              // r11 = pressure (u16 in low 16)
        cmp r11, 0;
        jne stylus_ih_no;
        // Both conditions hold: return 1.
        mov rax, 1;
        ret;
      stylus_ih_no:
        xor rax, rax;
        ret
      }
    }

  // stylus_device_is_drawing(row_ptr) -> bool.
  // TRUE iff in_range == 1 AND pressure > 0 AND (button_state & 0x01)
  // (tool is in range, applying pressure, and the tip button is down --
  // the classic drawing predicate).
  pub let stylus_device_is_drawing : (u64) -> u64 !{mem} @{} =
    fn (row_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "B10-03 (#2284): predicate 'is drawing' = (in_range == 1 && pressure > 0 && (button_state & BUTTON_MASK_TIP)). Reads ids word ([+8]) and tilt word ([+16]). Extracts in_range (bits [47:40]) and pressure (bits [63:48]) from ids; extracts button_state (bits [39:32]) from tilt. Returns 1 iff all three conditions hold, else 0. Two loads, arithmetic in registers -- no MOVZX. Scratch: rax, r10, r11. Labels prefixed stylus_id_.",
      block: {
        // Load ids word, check in_range.
        mov rax, [rdi + 8];
        mov r10, rax;
        shr r10, 40;
        and r10, 0xFF;            // r10 = in_range
        cmp r10, 1;
        jne stylus_id_no;

        // Check pressure > 0.
        mov r11, rax;
        shr r11, 48;              // r11 = pressure (u16)
        cmp r11, 0;
        je  stylus_id_no;

        // Load tilt word, check button_state & BUTTON_MASK_TIP.
        mov rax, [rdi + 16];
        shr rax, 32;
        and rax, 0x01;            // rax = tip bit (0 or 1)
        cmp rax, 0;
        je  stylus_id_no;

        // All three conditions hold.
        mov rax, 1;
        ret;
      stylus_id_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // SECTION 16 -- FIELD ACCESSORS
  // ==========================================================================
  //
  // Read-only field extractors used by the dispatch surface (query ops)
  // and by the compositor's paint pipeline for the ordinary per-frame
  // read path. Each takes a row_ptr and returns the requested field
  // zero- or sign-extended into rax.

  // stylus_device_serial(row_ptr) -> u64 (full device_serial).
  pub let stylus_device_serial : (u64) -> u64 !{mem} @{} =
    fn (row_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "B10-03 (#2284): read device_serial from [+0] (full u64). One load, one ret. Labels prefixed stylus_gs_.",
      block: {
        mov rax, [rdi + 0];
        ret
      }
    }

  // stylus_device_seat(row_ptr) -> u64 (u32 seat_kind_id in low 32).
  pub let stylus_device_seat : (u64) -> u64 !{mem} @{} =
    fn (row_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "B10-03 (#2284): read seat_kind_id from ids[31:0]. Load, shl 32 / shr 32 to mask to low 32. Labels prefixed stylus_gse_.",
      block: {
        mov rax, [rdi + 8];
        shl rax, 32;
        shr rax, 32;
        ret
      }
    }

  // stylus_device_tool(row_ptr) -> u64 (u8 current_tool in low byte).
  pub let stylus_device_tool : (u64) -> u64 !{mem} @{} =
    fn (row_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "B10-03 (#2284): read current_tool from ids[39:32]. Load, shr 32, and 0xFF (imm8-form on rax). No MOVZX. Labels prefixed stylus_gt_.",
      block: {
        mov rax, [rdi + 8];
        shr rax, 32;
        and rax, 0xFF;
        ret
      }
    }

  // stylus_device_in_range(row_ptr) -> u64 (u8 in_range in low byte).
  pub let stylus_device_in_range : (u64) -> u64 !{mem} @{} =
    fn (row_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "B10-03 (#2284): read in_range from ids[47:40]. Load, shr 40, and 0xFF. No MOVZX. Labels prefixed stylus_gr_.",
      block: {
        mov rax, [rdi + 8];
        shr rax, 40;
        and rax, 0xFF;
        ret
      }
    }

  // stylus_device_pressure(row_ptr) -> u64 (u16 pressure in low 16 bits).
  pub let stylus_device_pressure : (u64) -> u64 !{mem} @{} =
    fn (row_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "B10-03 (#2284): read pressure u16 from ids[63:48]. Load, shr 48 -- upper bits clear automatically. Labels prefixed stylus_gp_.",
      block: {
        mov rax, [rdi + 8];
        shr rax, 48;
        ret
      }
    }

  // stylus_device_tilt_x(row_ptr) -> u64 (i16 sign-extended in rax).
  pub let stylus_device_tilt_x : (u64) -> u64 !{mem} @{} =
    fn (row_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "B10-03 (#2284): read i16 tilt_x from tilt[15:0] with sign extension. Load, shl 48 (kill high bits), sar 48 (sign-extend from bit 15). Labels prefixed stylus_gtx_.",
      block: {
        mov rax, [rdi + 16];
        shl rax, 48;
        sar rax, 48;
        ret
      }
    }

  // stylus_device_tilt_y(row_ptr) -> u64 (i16 sign-extended in rax).
  pub let stylus_device_tilt_y : (u64) -> u64 !{mem} @{} =
    fn (row_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "B10-03 (#2284): read i16 tilt_y from tilt[31:16] with sign extension. Load, shl 32 (put bit 31 at bit 63), sar 48 (arithmetic right 48 sign-extends the top 16). Labels prefixed stylus_gty_.",
      block: {
        mov rax, [rdi + 16];
        shl rax, 32;
        sar rax, 48;
        ret
      }
    }

  // stylus_device_button_state(row_ptr) -> u64 (u8 button_state in low byte).
  pub let stylus_device_button_state : (u64) -> u64 !{mem} @{} =
    fn (row_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "B10-03 (#2284): read button_state bitmask from tilt[39:32]. Load, shr 32, and 0xFF. No MOVZX. Labels prefixed stylus_gb_.",
      block: {
        mov rax, [rdi + 16];
        shr rax, 32;
        and rax, 0xFF;
        ret
      }
    }

  // stylus_device_pos_x(row_ptr) -> u64 (i32 sign-extended in rax).
  pub let stylus_device_pos_x : (u64) -> u64 !{mem} @{} =
    fn (row_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "B10-03 (#2284): read i32 pos_x from pos[31:0] with sign extension. Load, shl 32 (kill high bits), sar 32 (sign-extend from bit 31). Labels prefixed stylus_gpx_.",
      block: {
        mov rax, [rdi + 24];
        shl rax, 32;
        sar rax, 32;
        ret
      }
    }

  // stylus_device_pos_y(row_ptr) -> u64 (i32 sign-extended in rax).
  pub let stylus_device_pos_y : (u64) -> u64 !{mem} @{} =
    fn (row_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "B10-03 (#2284): read i32 pos_y from pos[63:32] with sign extension. Load, sar 32 (arithmetic right shift preserves sign of bit 63 which is bit 31 of pos_y). Labels prefixed stylus_gpy_.",
      block: {
        mov rax, [rdi + 24];
        sar rax, 32;
        ret
      }
    }

  // stylus_device_last_seq(row_ptr) -> u64 (full last_seq).
  pub let stylus_device_last_seq : (u64) -> u64 !{mem} @{} =
    fn (row_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "B10-03 (#2284): read last_seq from [+32] (full u64). One load, one ret. Labels prefixed stylus_gq_.",
