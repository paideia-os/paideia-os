// src/user/input_server/trackpad_gesture.pdx -- Wave0-B12-01 (paideia-os #2282)
//
// TrackpadGesture -- per-KIND_POINTER_DEVICE (0x1D3) trackpad gesture
// prefilter. The KIND_INPUT_SERVER (0x1D0, main.pdx, B8-01, LANDED)
// consults this value-type row on every raw synaptics/HID trackpad
// report to (a) reject palm-shaped contacts before they reach the
// gesture recogniser, (b) tag two-finger scrolls with the user's
// natural-scroll orientation preference, (c) classify multi-finger
// touches (2 = scroll/pan; 3 = system gesture; more = ignored), and
// (d) drop the tap-click windowing timestamp the double-tap recogniser
// uses. Every KIND_POINTER_DEVICE row of trackpad flavour carries ONE
// TrackpadGesture inline in its row body (the input server owns the
// storage; there is no cross-process handoff of a bare prefilter row).
//
// =============================================================================
// SECTION 0  WHY THIS IS A VALUE TYPE, NOT A KIND CAP
// =============================================================================
//
// A gesture prefilter is a per-device tuning-and-latch surface, not a
// shareable capability. The KIND_POINTER_DEVICE cap (0x1D3, sibling to
// KIND_KEYBOARD_DEVICE 0x1D2) already names the device; the prefilter
// is a piece of that device's local state. Splitting the prefilter into
// its own KIND cap would add a rights lattice, a mint dispatcher, and a
// row pool for authority we never hand out -- mirroring AccelCurve
// (accel_curve.pdx §0) and ScrollAxis (scroll_axis.pdx §0): every
// KIND_POINTER_DEVICE of trackpad flavour owns exactly ONE
// TrackpadGesture inline.
//
// Cross-repo alignment: libinput (Peter Hutterer) implements palm-
// rejection, tap-click, and natural-scroll as per-device tunables the
// display server toggles opaquely; the shape here mirrors that -- the
// prefilter lives with the device, the compositor never sees the
// intermediate raw contact stream, and a libinput-style enum picks the
// filter class emitted per ingest step. The design/roadmap/next-wave-
// osarch.md pointer-device notes anchor the correspondence.
//
// =============================================================================
// SECTION 1  KIND_* SLOT ALLOCATION
// =============================================================================
//
// N/A -- this module is a VALUE TYPE. No KIND_TRACKPAD_GESTURE slot
// exists. The parent capability that anchors ownership is
// KIND_POINTER_DEVICE (0x1D3), whose row body reserves a 32-byte
// TrackpadGesture inline slot alongside the AccelCurve (32 B) and
// ScrollAxis pair (2 x 32 B) landings. The device_kind_id argument to
// trackpad_gesture_init below is the reconciliation point when the
// KIND_POINTER_DEVICE row-body layout is frozen.
//
// =============================================================================
// SECTION 2  ROW LAYOUT -- 32 BYTES / 4 U64
// =============================================================================
//
//   [+0]  ident:  device_kind_id[31:0]      | active_contact_count[39:32]
//                | natural_scroll_enabled[47:40] | tap_threshold_ms[63:48]
//   [+8]  thresh: palm_area_threshold[15:0] | reserved[63:16]
//   [+16] tap:    last_tap_nsec[63:0]
//   [+24] seq:    gesture_seq[63:0]
//
// Fields:
//   device_kind_id:          u32  -- the KIND_POINTER_DEVICE cap slot
//                                     this prefilter belongs to. In-band
//                                     so a consumer handed a bare row
//                                     pointer can cross-check the owner.
//   active_contact_count:    u8   -- the count fed by the last ingest.
//                                     0 iff all fingers lifted; capped
//                                     at 10 to match touch_contact's
//                                     TOUCH_CONTACT_MAX. Read by the
//                                     recogniser's tick handler between
//                                     ingests to keep the "how many
//                                     fingers are down right now" answer
//                                     a single-load away.
//   natural_scroll_enabled:  u8   -- 0 = traditional (two-finger swipe
//                                     up = content up; matches the
//                                     wheel-scroll convention), 1 = macOS-
//                                     style reversed. Named at the
//                                     prefilter (not per axis) so the
//                                     tap and scroll gestures share one
//                                     orientation knob per device.
//   tap_threshold_ms:        u16  -- double-tap window in milliseconds.
//                                     200 ms is libinput's default and
//                                     matches Wayland's wp_pointer_
//                                     gestures_v1 tap-timeout convention.
//                                     The double-tap predicate converts
//                                     this to nanoseconds via a
//                                     reg-reg imul against 1_000_000.
//   palm_area_threshold:     u16  -- palm-rejection threshold in square
//                                     millimetres. A contact whose
//                                     reported area exceeds this is
//                                     classified as a palm and filtered
//                                     out. Wacom / synaptics driver
//                                     spec: a fingertip contact is
//                                     50..150 sqmm; a resting palm is
//                                     typically 400+ sqmm. Default 500
//                                     matches libinput's PALM_PRESSURE
//                                     posture (area, not pressure, is
//                                     the discriminator on capacitive
//                                     touchpads).
//   last_tap_nsec:           u64  -- monotonic nanosecond timestamp of
//                                     the last single-finger ingest. Fed
//                                     by the input server's clock read
//                                     (compositor tick or KIND_CLOCK
//                                     query). Used by the double-tap
//                                     predicate to compute delta against
//                                     a fresh nsec argument.
//   gesture_seq:              u64  -- monotonic per-row sequence bumped
//                                     on EVERY successful ingest,
//                                     including palm-reject and count==0
//                                     paths. Consumers use the delta to
//                                     detect a dropped USB report and
//                                     reset any partial-gesture state.
//
// -----------------------------------------------------------------------------
// 2.1  GestureFilter enum (return values from ingest)
// -----------------------------------------------------------------------------
//
//   FILTER_TAP_CLICK       (0):
//     Zero or single-contact update. Also the default when no other
//     classification fires. Matches touch_contact's GESTURE_TAP=0 so a
//     future dispatcher can share the jump-table encoding without a
//     mapping table between the enum spaces.
//
//   FILTER_PALM_REJECT     (1):
//     One of the contacts in this ingest step exceeded palm_area_
//     threshold. The active_contact_count is NOT updated -- a palm
//     touch does not participate in the finger-count classifier so the
//     downstream gesture recogniser sees a byte-identical row.
//
//   FILTER_NATURAL_SCROLL  (2):
//     Two-finger contact and natural_scroll_enabled == 1. The classifier
//     preserves the two-finger classification but tags the filter class
//     so the scroll_axis apply body knows to invert direction.
//
//   FILTER_TWO_FINGER      (3):
//     Two-finger contact and natural_scroll_enabled == 0. Traditional
//     scroll/pan orientation.
//
//   FILTER_THREE_FINGER    (4):
//     Three-or-more-finger contact. The system gesture surface
//     (workspace switch, app expose, mission-control-style overview)
//     consumes this filter class; the compositor never sees the raw
//     contact set.
//
// -----------------------------------------------------------------------------
// 2.2  Ingest ordering
// -----------------------------------------------------------------------------
//
// trackpad_gesture_ingest performs, in order:
//
//   1. Validate row_ptr nonzero, contact_count <= 10, contact_area
//      fits u16. All checked before any store: a refused ingest leaves
//      the row byte-identical.
//   2. Bump gesture_seq (always -- even on palm reject; downstream
//      dropped-sample detector reads this).
//   3. Palm check: contact_area > palm_area_threshold -> return
//      FILTER_PALM_REJECT immediately without updating count / tap.
//   4. Overwrite active_contact_count in the ident word (preserves
//      device_kind_id, natural_scroll_enabled, tap_threshold_ms).
//   5. Dispatch by contact_count:
//        count >= 3            -> FILTER_THREE_FINGER
//        count == 2 && natural -> FILTER_NATURAL_SCROLL
//        count == 2            -> FILTER_TWO_FINGER
//        count == 1            -> update last_tap_nsec = nsec;
//                                 return FILTER_TAP_CLICK
//        count == 0            -> FILTER_TAP_CLICK (no timestamp update;
//                                 all fingers lifted)
//
// The "update last_tap_nsec on count==1" step is what feeds the
// double-tap predicate. Two consecutive count==1 ingests within
// tap_threshold_ms constitute a double tap; the predicate reads the
// stored timestamp and compares against the caller's fresh nsec.
//
// =============================================================================
// SECTION 3  FAILURE TAXONOMY -- 0xFFFFEAE0..0xFFFFEAEF
// =============================================================================
//
// Task-brief-assigned band 0xFFFFEAE0..0xFFFFEAEF, grep-verified free
// at landing time (no `pub let ... 0xFFFFEAE[0-F]` sentinel definitions
// across src/**/*.pdx + tests/**/*.pdx). The pre-existing 0xFFFFEAE0 /
// 0xFFFFEAEF ambient hits (enumerate.pdx, recovery_console.pdx,
// scroll_axis.pdx, retained_widgets.pdx) are all commentary references
// noting the band as "free" / "reserved" -- none defines a sentinel.
//
// Neighbours:
//   0xFFFFEAB0..0xFFFFEABF  KIND_STYLUS_DEVICE          (B10-03)
//   0xFFFFEAC0..0xFFFFEACF  one ambient hit (adjacent driver band)
//   0xFFFFEAD0..0xFFFFEADF  ScrollAxis                  (B11-02)
//   0xFFFFEAE0..0xFFFFEAEF  TrackpadGesture             (THIS BAND, B12-01)
//   0xFFFFEB70..0xFFFFEB7F  KIND_SEAT + KIND_INPUT_ROUTE (input-server family)
//   0xFFFFEB90..0xFFFFEB9F  AccelCurve                  (B9-02)
//   0xFFFFEBA0..0xFFFFEBAF  KIND_TOUCH_CONTACT          (B9-03)
//
// Ordering (highest to lowest): catch-all sentinel at the top, refusal
// reasons dense below, mirrors the seat_kind / route_kind convention.
//
// =============================================================================
// SECTION 4  ENCODER-CONSERVATIVE DISCIPLINE
// =============================================================================
//
// Per the B12-01 spec (mirrors B9/B10/B11 encoder rules):
//
//   * NO `test rN, rN`. Use `cmp rN, 0`. paideia-as U1605.
//
//   * NO `add reg, [mem]`. Load through a scratch, then reg-reg `add`.
//
//   * NO `and r11, imm...` in ANY form. r11 is internal scratch under
//     U1615 and any `and r11, imm` shape is refused by paideia-as.
//     Small-imm AND (`and rax, 0xFF`, `and rax, 0xFFFF`, `and r10, ...`)
//     on rax/r10 is acceptable for u8/u16 field extraction (matches
//     accel_curve.pdx §4 and scroll_axis.pdx §4).
//
//   * NO 2-op imul-with-imm. 2-op reg-reg (`imul rax, r10`) is fine
//     and matches accel_curve.pdx's ac_ap_ (line 1183). The
//     double-tap predicate uses it for the ms->nsec conversion.
//
//   * NO `neg`, `cqo`, `idiv`. Signed magnitude is not required on any
//     path here (all fields are unsigned; the double-tap delta subtracts
//     two u64s and treats underflow as "not a double-tap").
//
//   * NO mov_bzx/wzx. Zero-extension via `shl 32; shr 32` (u32),
//     `shl 48; shr 48` (u16), `shr 40; and rax, 0xFF` (u8 field extract)
//     or small-imm AND on rax/r10.
//
//   * u32 zero-extension via `shl 32; shr 32`. u16 via `shl 48; shr 48`
//     or `and rax, 0xFFFF` on rax/r10. u8 via `and rax, 0xFF` on
//     rax/r10.
//
// Module = TrackpadGesture (M0305). Label prefix = trackpad_gesture_.
// Tag byte-count = strlen + 1 (NUL-terminated).
//
// =============================================================================
// SECTION 5  FINGERPRINT
// =============================================================================
//
// ONE data-only tag ending `[legacy: TRACKPAD GESTURE META OK]` per
// softarch discipline. Emitted (in a future landing that wires the
// input server's trackpad HID decode path through
// trackpad_gesture_ingest) via klog_s1_x1 on the first successful
// init per boot. At THIS landing the string is data-only; the input
// server's dispatch body (main.pdx) does not yet call into this module,
// so no emission path is live. The tag is defined here so the
// fingerprint-coverage gate (tools/verify-fingerprint-coverage.sh) has
// a stable string to allowlist against once the trackpad wire-in lands.
//
// LABEL PREFIX. Public API functions carry the full `trackpad_gesture_`
// prefix per the batch spec. Internal jump labels use the same prefix
// with a function-specific suffix (e.g. `trackpad_gesture_i_...` in
// trackpad_gesture_ingest) to keep the branch-target namespace flat
// and to sidestep any paideia-as reserved-keyword collisions.

module TrackpadGesture = structure {

  // ==========================================================================
  // SECTION A  Row sizing + enum + default constants
  // ==========================================================================

  // Row size. 32 bytes = 4 u64, one half of a cache line.
  pub let TRACKPAD_GESTURE_ROW_BYTES : u64 = 32

  // Byte offsets within the row (SECTION 2).
  pub let TG_OFF_IDENT       : u64 = 0     // device | count | natural | tap_ms
  pub let TG_OFF_THRESH      : u64 = 8     // palm_area_threshold | reserved
  pub let TG_OFF_LAST_TAP    : u64 = 16    // last_tap_nsec (full u64)
  pub let TG_OFF_GESTURE_SEQ : u64 = 24    // gesture_seq (full u64)

  // Sub-word bit positions for TG_OFF_IDENT:
  //   device_kind_id          bits [31:0]
  //   active_contact_count    bits [39:32]
  //   natural_scroll_enabled  bits [47:40]
  //   tap_threshold_ms        bits [63:48]
  pub let TG_IDENT_ACTIVE_COUNT_SHIFT   : u64 = 32
  pub let TG_IDENT_NATURAL_SCROLL_SHIFT : u64 = 40
  pub let TG_IDENT_TAP_THRESHOLD_SHIFT  : u64 = 48

  // GestureFilter enum (return values from ingest / stored dispatch tag).
  pub let FILTER_TAP_CLICK       : u64 = 0
  pub let FILTER_PALM_REJECT     : u64 = 1
  pub let FILTER_NATURAL_SCROLL  : u64 = 2
  pub let FILTER_TWO_FINGER      : u64 = 3
  pub let FILTER_THREE_FINGER    : u64 = 4
  pub let FILTER_MAX             : u64 = 4

  // Maximum contact count admitted by ingest. Matches touch_contact.pdx's
  // TOUCH_CONTACT_MAX = 10 (T14 G4's touch controller exposes 10 hardware
  // slots and the Synaptics-compatible spec caps at 10 simultaneous
  // fingers). Higher counts are refused with TG_BAD_CONTACT_COUNT.
  pub let TG_MAX_CONTACT_COUNT : u64 = 10

  // Defaults installed by trackpad_gesture_init.
  pub let TG_TAP_THRESHOLD_MS_DEFAULT     : u64 = 200   // libinput default
  pub let TG_PALM_AREA_THRESHOLD_DEFAULT  : u64 = 500   // sqmm; typical palm > 400

  // Milliseconds -> nanoseconds multiplier. Used by the double-tap
  // predicate via reg-reg imul (encoder-conservative posture forbids
  // 2-op imul-with-imm; the multiplier lives in a register).
  pub let TG_MS_TO_NSEC : u64 = 1000000

  // Documentary u32/u16/u8 masks -- assembly uses shl/shr masking or
  // small-imm AND on rax/r10.
  pub let TG_U32_MAX : u64 = 0xFFFFFFFF
  pub let TG_U16_MAX : u64 = 0xFFFF
  pub let TG_U8_MAX  : u64 = 0xFF

  // ==========================================================================
  // SECTION B  Rights (declaratory; the parent KIND_POINTER_DEVICE cap
  // is the actual authority, but the prefilter's operations divide into
  // three rights classes for the future dispatch surface).
  // ==========================================================================
  //
  //   RIGHT_TG_INGEST   -- author trackpad_gesture_ingest (mutates the row)
  //   RIGHT_TG_QUERY    -- read predicates and field accessors
  //   RIGHT_TG_TUNE     -- overwrite tap_threshold_ms, palm_area_threshold,
  //                        natural_scroll_enabled (setter suite)
  //   R_TG_ALL          -- union of the above

  pub let RIGHT_TG_INGEST : u64 = 0x001
  pub let RIGHT_TG_QUERY  : u64 = 0x002
  pub let RIGHT_TG_TUNE   : u64 = 0x004
  pub let R_TG_ALL        : u64 = 0x007

  // ==========================================================================
  // SECTION C  Op tags (dispatch surface)
  // ==========================================================================

  pub let TG_OP_INIT                : u64 = 0
  pub let TG_OP_INGEST              : u64 = 1
  pub let TG_OP_QUERY_PALM          : u64 = 2
  pub let TG_OP_QUERY_DOUBLE_TAP    : u64 = 3
  pub let TG_OP_QUERY_ACTIVE_COUNT  : u64 = 4
  pub let TG_OP_QUERY_SEQ           : u64 = 5
  pub let TG_OP_TUNE_TAP_THRESHOLD  : u64 = 6
  pub let TG_OP_TUNE_PALM_THRESHOLD : u64 = 7
  pub let TG_OP_SET_NATURAL_SCROLL  : u64 = 8
  pub let TG_OP_MAX                 : u64 = 8

  // ==========================================================================
  // SECTION D  Stats counter slots (declaratory)
  // ==========================================================================

  pub let TG_ST_INGESTS         : u64 = 0
  pub let TG_ST_TAP_CLICKS      : u64 = 1
  pub let TG_ST_PALM_REJECTS    : u64 = 2
  pub let TG_ST_TWO_FINGER      : u64 = 3
  pub let TG_ST_THREE_FINGER    : u64 = 4
  pub let TG_ST_NATURAL_SCROLL  : u64 = 5
  pub let TG_ST_REFUSED         : u64 = 6
  pub let TG_ST_MAX             : u64 = 7

  // ==========================================================================
  // SECTION E  Failure taxonomy -- 0xFFFFEAE0..0xFFFFEAEF
  // ==========================================================================

  pub let TRACKPAD_GESTURE_OK           : u64 = 0
  pub let TG_BAD_ARG                    : u64 = 0xFFFFEAEF  // catch-all
  pub let TG_BAD_DEVICE                 : u64 = 0xFFFFEAEE  // device_kind_id 0 or > u32
  pub let TG_BAD_ROW                    : u64 = 0xFFFFEAED  // row_ptr == 0
  pub let TG_BAD_TAP_THRESHOLD          : u64 = 0xFFFFEAEC  // tap_threshold_ms > u16
  pub let TG_BAD_PALM_THRESHOLD         : u64 = 0xFFFFEAEB  // palm_area_threshold > u16
  pub let TG_BAD_NATURAL_SCROLL         : u64 = 0xFFFFEAEA  // natural_scroll > 1
  pub let TG_BAD_CONTACT_COUNT          : u64 = 0xFFFFEAE9  // count > TG_MAX_CONTACT_COUNT
  pub let TG_BAD_CONTACT_AREA           : u64 = 0xFFFFEAE8  // area > u16
  pub let TG_UNSUP_OP                   : u64 = 0xFFFFEAE7  // dispatch op > TG_OP_MAX
  pub let TG_BAD_RIGHTS                 : u64 = 0xFFFFEAE6  // rights not subset of R_TG_ALL
  pub let TG_UNSUP_FILTER               : u64 = 0xFFFFEAE5  // filter enum > FILTER_MAX
  // 0xFFFFEAE0..0xFFFFEAE4 reserved for G8-M3 follow-ups (three-finger
  // subclassifier variants, per-hand handedness, edge-swipe detection).

  // ==========================================================================
  // SECTION F  Fingerprint tag (data-only)
  //
  // pdx_kind_trackpad_gesture_meta -- ONE tag ending [legacy: ... OK]
  // per softarch discipline. See file header §5. Wire-up path (input
  // server's trackpad ingest -> trackpad_gesture_ingest -> emission via
  // klog_s1_x1) lands with a future batch; the coverage-gate allowlist
  // entry lands at the same time.
  //
  // Byte count: "trackpad gesture meta [legacy: TRACKPAD GESTURE META OK]\0"
  //   = 56 chars + NUL = 57.
  // ==========================================================================

  pub let pdx_kind_trackpad_gesture_meta : [u8; 57] = "trackpad gesture meta [legacy: TRACKPAD GESTURE META OK]\0"

  // ==========================================================================
  // SECTION G  Validators (pure leaves)
  //
  // Every function in this section is a pure unsafe-bodied leaf with
  // small immediates, returns in rax, and clobbers only rax + one
  // scratch. No `test`, no `and r11, imm`. Labels prefixed
  // trackpad_gesture_*v_.
  // ==========================================================================

  // trackpad_gesture_device_valid(kind_id) -> 1 iff kind_id in (0, 2^32).
  pub let trackpad_gesture_device_valid : (u64) -> u64 !{} @{} =
    fn (kind_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "B12-01 (#2282): device_kind_id validator. 1 iff kind_id nonzero + fits u32. Zero refused: a prefilter with no device has no owning row to cross-check against. Uses shr 32 rather than `and reg, 0xFFFFFFFF` per this file's encoder-conservative posture. Labels prefixed trackpad_gesture_dv_.",
      block: {
        cmp rdi, 0;
        je  trackpad_gesture_dv_no;
        mov rax, rdi;
        shr rax, 32;
        cmp rax, 0;
        jne trackpad_gesture_dv_no;
        mov rax, 1;
        ret;
      trackpad_gesture_dv_no:
        xor rax, rax;
        ret
      }
    }

  // trackpad_gesture_tap_threshold_valid(ms) -> 1 iff ms fits u16.
  // Zero IS legal (a caller may disable double-tap detection by setting
  // the threshold to 0; every finite tap delta exceeds 0 so no double
  // tap ever fires).
  pub let trackpad_gesture_tap_threshold_valid : (u64) -> u64 !{} @{} =
    fn (ms: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "B12-01 (#2282): tap_threshold_ms validator (fits u16; zero legal for 'double-tap disabled'). Uses shr 16 rather than `and reg, 0xFFFF`. Labels prefixed trackpad_gesture_tv_.",
      block: {
        mov rax, rdi;
        shr rax, 16;
        cmp rax, 0;
        jne trackpad_gesture_tv_no;
        mov rax, 1;
        ret;
      trackpad_gesture_tv_no:
        xor rax, rax;
        ret
      }
    }

  // trackpad_gesture_palm_threshold_valid(area) -> 1 iff area fits u16.
  // Zero legal (rejects every nonzero-area contact as palm; unusual but
  // not invalid -- the caller may want an all-reject debug mode).
  pub let trackpad_gesture_palm_threshold_valid : (u64) -> u64 !{} @{} =
    fn (area: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "B12-01 (#2282): palm_area_threshold validator (fits u16; zero legal for aggressive-reject debug mode). Uses shr 16. Labels prefixed trackpad_gesture_pv_.",
      block: {
        mov rax, rdi;
        shr rax, 16;
        cmp rax, 0;
        jne trackpad_gesture_pv_no;
        mov rax, 1;
        ret;
      trackpad_gesture_pv_no:
        xor rax, rax;
        ret
      }
    }

  // trackpad_gesture_natural_scroll_valid(flag) -> 1 iff flag in [0, 1].
  pub let trackpad_gesture_natural_scroll_valid : (u64) -> u64 !{} @{} =
    fn (flag: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "B12-01 (#2282): natural_scroll_enabled validator (0 or 1). Small immediate compare. Labels prefixed trackpad_gesture_nv_.",
      block: {
        cmp rdi, 1;
        ja  trackpad_gesture_nv_no;
        mov rax, 1;
        ret;
      trackpad_gesture_nv_no:
        xor rax, rax;
        ret
      }
    }

  // trackpad_gesture_contact_count_valid(count) -> 1 iff count <= TG_MAX_CONTACT_COUNT.
  pub let trackpad_gesture_contact_count_valid : (u64) -> u64 !{} @{} =
    fn (count: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "B12-01 (#2282): contact_count validator (0..10, matches touch_contact.pdx TOUCH_CONTACT_MAX). Small immediate. Labels prefixed trackpad_gesture_ccv_.",
      block: {
        cmp rdi, 10;
        ja  trackpad_gesture_ccv_no;
        mov rax, 1;
        ret;
      trackpad_gesture_ccv_no:
        xor rax, rax;
        ret
      }
    }

  // trackpad_gesture_filter_valid(filter) -> 1 iff filter in [0..FILTER_MAX=4].
  pub let trackpad_gesture_filter_valid : (u64) -> u64 !{} @{} =
    fn (filter: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "B12-01 (#2282): GestureFilter enum validator (0..4). Small immediate. Labels prefixed trackpad_gesture_fv_.",
      block: {
        cmp rdi, 4;
        ja  trackpad_gesture_fv_no;
        mov rax, 1;
        ret;
      trackpad_gesture_fv_no:
        xor rax, rax;
        ret
      }
    }

  // trackpad_gesture_rights_valid(rights) -> 1 iff rights subset of R_TG_ALL.
  pub let trackpad_gesture_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "B12-01 (#2282): rights subset test against R_TG_ALL = 0x007. Small imm on rax. Labels prefixed trackpad_gesture_rv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x007;
        and rax, r10;
        cmp rax, rdi;
        jne trackpad_gesture_rv_no;
        mov rax, 1;
        ret;
      trackpad_gesture_rv_no:
        xor rax, rax;
        ret
      }
    }

  // trackpad_gesture_op_valid(op) -> 1 iff op in [0, TG_OP_MAX=8].
  pub let trackpad_gesture_op_valid : (u64) -> u64 !{} @{} =
    fn (op: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "B12-01 (#2282): dispatch op validator. Admits 0..8. Small immediate. Labels prefixed trackpad_gesture_ov_.",
      block: {
        cmp rdi, 8;
        ja  trackpad_gesture_ov_no;
        mov rax, 1;
        ret;
      trackpad_gesture_ov_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // SECTION H  Field accessors (readers)
  //
  // Each accessor takes a row_ptr and returns the requested field zero-
  // extended into rax. No MOVZX; extraction via shl/shr or small-imm AND
  // on rax.
  // ==========================================================================

  // trackpad_gesture_device(row_ptr) -> u32 device_kind_id.
  pub let trackpad_gesture_device : (u64) -> u64 !{mem} @{} =
    fn (row_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "B12-01 (#2282): read device_kind_id from ident[31:0]. Zero-extend via shl 32; shr 32. Labels prefixed trackpad_gesture_gd_.",
      block: {
        mov rax, [rdi + 0];
        shl rax, 32;
        shr rax, 32;
        ret
      }
    }

  // trackpad_gesture_active_contact_count(row_ptr) -> u8 count.
  pub let trackpad_gesture_active_contact_count : (u64) -> u64 !{mem} @{} =
    fn (row_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "B12-01 (#2282): read active_contact_count from ident[39:32]. Extract via shr 32 then `and rax, 0xFF`. No MOVZX. Labels prefixed trackpad_gesture_gc_.",
      block: {
        mov rax, [rdi + 0];
        shr rax, 32;
        and rax, 0xFF;
        ret
      }
    }

  // trackpad_gesture_natural_scroll_enabled(row_ptr) -> u8 flag.
  pub let trackpad_gesture_natural_scroll_enabled : (u64) -> u64 !{mem} @{} =
    fn (row_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "B12-01 (#2282): read natural_scroll_enabled from ident[47:40]. Extract via shr 40 then `and rax, 0xFF`. No MOVZX. Labels prefixed trackpad_gesture_gn_.",
      block: {
        mov rax, [rdi + 0];
        shr rax, 40;
        and rax, 0xFF;
        ret
      }
    }

  // trackpad_gesture_tap_threshold_ms(row_ptr) -> u16 ms.
  pub let trackpad_gesture_tap_threshold_ms : (u64) -> u64 !{mem} @{} =
    fn (row_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "B12-01 (#2282): read tap_threshold_ms from ident[63:48]. One load, one shr 48 -- upper bits clear automatically. Labels prefixed trackpad_gesture_gt_.",
      block: {
        mov rax, [rdi + 0];
        shr rax, 48;
        ret
      }
    }

  // trackpad_gesture_palm_area_threshold(row_ptr) -> u16 sqmm.
  pub let trackpad_gesture_palm_area_threshold : (u64) -> u64 !{mem} @{} =
    fn (row_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "B12-01 (#2282): read palm_area_threshold from thresh[15:0]. Load, `and rax, 0xFFFF` (imm32 on rax, accepted per accel_curve §4). Labels prefixed trackpad_gesture_gp_.",
      block: {
        mov rax, [rdi + 8];
        and rax, 0xFFFF;
        ret
      }
    }

  // trackpad_gesture_last_tap_nsec(row_ptr) -> u64.
  pub let trackpad_gesture_last_tap_nsec : (u64) -> u64 !{mem} @{} =
    fn (row_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "B12-01 (#2282): read last_tap_nsec from [+16] (full u64). One load, one ret. Labels prefixed trackpad_gesture_gl_.",
      block: {
        mov rax, [rdi + 16];
        ret
      }
    }

  // trackpad_gesture_seq(row_ptr) -> u64.
  pub let trackpad_gesture_seq : (u64) -> u64 !{mem} @{} =
    fn (row_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "B12-01 (#2282): read gesture_seq from [+24] (full u64). One load, one ret. Labels prefixed trackpad_gesture_gs_.",
      block: {
        mov rax, [rdi + 24];
        ret
      }
    }

  // ==========================================================================
  // SECTION I  Factory: trackpad_gesture_init(row_ptr, device_kind_id) -> status
  //
  // Writes the ident word (device_kind_id + defaults for count/natural/
  // tap_ms), the thresh word (palm_area_threshold default), and zeroes
  // last_tap_nsec and gesture_seq. Validates row_ptr and device_kind_id;
  // refuses on failure and leaves the row untouched.
  //
  // Note: the task-brief-suggested signature
  //   trackpad_gesture_init(device) -> TrackpadGestureState
  // is realised here as (row_ptr, device) -> status. The 32-byte struct
  // does not fit in a return-register pair, and every sibling factory
  // in this repo (accel_curve_new, scroll_axis_new, seat_mint, tiling_
  // bsp_tree_new) takes a row_ptr and returns a status code. This
  // matches accel_curve.pdx §G exactly.
  //
  // Signature: (row_ptr, device_kind_id) -> u64
  //   row_ptr:        rdi (pointer to zeroed 32-byte row)
  //   device_kind_id: rsi (u32, nonzero, KIND_POINTER_DEVICE slot)
  // ==========================================================================

  pub let trackpad_gesture_init : (u64, u64) -> u64 !{mem} @{} =
    fn (row_ptr: u64) (device_kind_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "B12-01 (#2282): factory writing device_kind_id + defaulted count/natural/tap_ms into ident, palm_area_threshold default into thresh, and zero into last_tap_nsec and gesture_seq. Validation order: row_ptr nonzero (TG_BAD_ROW); device_kind_id nonzero + fits u32 (TG_BAD_DEVICE). All validations complete before any store, so a failed init leaves the row byte-identical to its pre-call state. Defaults: active_contact_count=0, natural_scroll_enabled=0, tap_threshold_ms=200 (libinput default), palm_area_threshold=500 sqmm (typical palm > 400). Scratch: rax, r10. All u32 masking via shl 32 / shr 32; small-imm loads via `mov r10, <imm32>` + `shl` to target bit position. Labels prefixed trackpad_gesture_in_.",
      block: {
        // ---- Validate row_ptr nonzero. ----
        cmp rdi, 0;
        je  trackpad_gesture_in_bad_row;

        // ---- Validate device_kind_id nonzero + fits u32. ----
        cmp rsi, 0;
        je  trackpad_gesture_in_bad_device;
        mov r10, rsi;
        shr r10, 32;
        cmp r10, 0;
        jne trackpad_gesture_in_bad_device;

        // ---- All validated. Commit the writes. ----
        // ident ([+0]): device_kind_id[31:0]
        //             | active_contact_count=0[39:32]
        //             | natural_scroll_enabled=0[47:40]
        //             | tap_threshold_ms=200[63:48]
        mov rax, rsi;
        shl rax, 32;
        shr rax, 32;                // rax = device_kind_id zero-extended
        mov r10, 200;               // TG_TAP_THRESHOLD_MS_DEFAULT
        shl r10, 48;                // r10 = tap_threshold_ms at [63:48]
        or  rax, r10;
        mov [rdi + 0], rax;

        // thresh ([+8]): palm_area_threshold=500[15:0] | reserved=0[63:16]
        mov rax, 500;               // TG_PALM_AREA_THRESHOLD_DEFAULT
        mov [rdi + 8], rax;

        // last_tap_nsec ([+16]): 0.
        xor rax, rax;
        mov [rdi + 16], rax;

        // gesture_seq ([+24]): 0.
        mov [rdi + 24], rax;

        // TRACKPAD_GESTURE_OK = 0.
        xor rax, rax;
        ret;

      trackpad_gesture_in_bad_row:
        mov rax, 0xFFFFEAED;        // TG_BAD_ROW
        ret;
      trackpad_gesture_in_bad_device:
        mov rax, 0xFFFFEAEE;        // TG_BAD_DEVICE
        ret
      }
    }

  // ==========================================================================
  // SECTION J  Predicates
  //
  //   trackpad_gesture_is_palm(row_ptr, area)          -> bool
  //   trackpad_gesture_is_double_tap(row_ptr, nsec)    -> bool
  //
  // Both take a row_ptr and one argument and return 1 (true) or 0 (false)
  // in rax. Used by the compositor / gesture recogniser fast paths.
  // ==========================================================================

  // trackpad_gesture_is_palm(row_ptr, area) -> bool.
  // TRUE iff area > palm_area_threshold.
  //
  // Signature: (row_ptr, area) -> u64
  //   row_ptr: rdi
  //   area:    rsi (u16 in practice; caller ensures u16 fit)
  pub let trackpad_gesture_is_palm : (u64, u64) -> u64 !{mem} @{} =
    fn (row_ptr: u64) (area: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "B12-01 (#2282): predicate 'is palm' = area > palm_area_threshold. Loads thresh word ([+8]), masks palm_area_threshold via `and rax, 0xFFFF` (imm32 on rax, accepted). Compares rsi > rax (ja) and returns 1 or 0. Scratch: rax. Labels prefixed trackpad_gesture_ip_.",
      block: {
        mov rax, [rdi + 8];
        and rax, 0xFFFF;             // rax = palm_area_threshold (u16)
        cmp rsi, rax;
        ja  trackpad_gesture_ip_yes;
        xor rax, rax;
        ret;
      trackpad_gesture_ip_yes:
        mov rax, 1;
        ret
      }
    }

  // trackpad_gesture_is_double_tap(row_ptr, nsec) -> bool.
  // TRUE iff (nsec - last_tap_nsec) < (tap_threshold_ms * 1_000_000).
  //
  // If nsec < last_tap_nsec the subtraction wraps to a huge u64, which
  // exceeds every plausible threshold_nsec so the predicate correctly
  // returns 0 (a stale-timestamp caller is not double-tapping).
  //
  // Signature: (row_ptr, nsec) -> u64
  //   row_ptr: rdi
  //   nsec:    rsi (u64 monotonic clock read)
  pub let trackpad_gesture_is_double_tap : (u64, u64) -> u64 !{mem} @{} =
    fn (row_ptr: u64) (nsec: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "B12-01 (#2282): predicate 'is double tap' = (nsec - last_tap_nsec) < (tap_threshold_ms * 1_000_000). Extracts tap_threshold_ms from ident[63:48] via shr 48, multiplies by TG_MS_TO_NSEC via reg-reg imul (encoder-conservative posture: no 2-op imul-with-imm, so the multiplier is loaded into r10 first). Loads last_tap_nsec, computes delta = nsec - last_tap_nsec (may underflow -- treated as 'huge, not double-tap'), and compares delta < threshold_nsec (jb). tap_threshold_ms fits u16 (<=65535); 65535 * 1_000_000 = ~6.55e10, well within u64 range. Scratch: rax, r10, r11. Labels prefixed trackpad_gesture_dt_.",
      block: {
        // Load tap_threshold_ms from ident[63:48].
        mov rax, [rdi + 0];
        shr rax, 48;                 // rax = tap_threshold_ms (u16 in low 16)

        // Convert to nsec via reg-reg imul (no 2-op imul-with-imm).
        mov r10, 1000000;            // TG_MS_TO_NSEC
        imul rax, r10;               // rax = threshold_nsec

        // Load last_tap_nsec.
        mov r10, [rdi + 16];

        // Compute delta = nsec - last_tap_nsec.
        mov r11, rsi;
        sub r11, r10;                // r11 = delta (underflow -> huge)

        // if delta < threshold_nsec -> true.
        cmp r11, rax;
        jb  trackpad_gesture_dt_yes;
        xor rax, rax;
        ret;
      trackpad_gesture_dt_yes:
        mov rax, 1;
        ret
      }
    }

  // ==========================================================================
  // SECTION K  Ingest -- the classifier hot path.
  //
  //   trackpad_gesture_ingest(row_ptr, contact_count, contact_area, nsec)
  //     -> GestureFilter | status
  //
  // Real memory-mutating function driven by the input server's trackpad
  // HID decode. See file header §2.2 for the full ingest ordering.
  //
  // On success returns one of FILTER_TAP_CLICK / FILTER_PALM_REJECT /
  // FILTER_NATURAL_SCROLL / FILTER_TWO_FINGER / FILTER_THREE_FINGER.
  // On refusal returns a TG_BAD_* sentinel from the 0xFFFFEAE0..EAEF
  // band and leaves the row byte-identical.
  //
  // Signature: (row_ptr, contact_count, contact_area, nsec) -> u64
  //   row_ptr:       rdi (pointer to initialised 32-byte row)
  //   contact_count: rsi (u8, 0..10)
  //   contact_area:  rdx (u16 sqmm; largest contact in this ingest step)
  //   nsec:          rcx (u64 monotonic clock read at ingest)
  // ==========================================================================

  pub let trackpad_gesture_ingest : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (row_ptr: u64) (contact_count: u64) (contact_area: u64) (nsec: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "B12-01 (#2282): trackpad prefilter classifier. Validation order: row_ptr nonzero (TG_BAD_ROW), contact_count <= 10 (TG_BAD_CONTACT_COUNT), contact_area fits u16 (TG_BAD_CONTACT_AREA). All validated before any store. Ordered dispatch: (1) bump gesture_seq at [+24] via load/add/store (no `add reg, [mem]`); (2) palm check -- contact_area > palm_area_threshold (thresh[15:0]) -> return FILTER_PALM_REJECT without updating count or tap timestamp (mirrors libinput palm-latch posture); (3) overwrite active_contact_count in ident[39:32] preserving device (bits [31:0]), natural_scroll (bits [47:40]), tap_threshold_ms (bits [63:48]) via 0xFF mask staged through r10 then NOT to clear the target byte (matches accel_curve_set_profile's mask discipline); (4) dispatch by count: >=3 -> FILTER_THREE_FINGER, ==2 && natural_scroll_enabled -> FILTER_NATURAL_SCROLL, ==2 -> FILTER_TWO_FINGER, ==1 -> update last_tap_nsec = nsec + return FILTER_TAP_CLICK, ==0 -> FILTER_TAP_CLICK. Scratch: rax, r10, r11. All u8/u16 masking via `and rax, 0xFF` / `and rax, 0xFFFF` on rax (accepted per accel_curve §4). No `and r11, imm`, no MOVZX, no 2-op imul-with-imm. Labels prefixed trackpad_gesture_i_.",
      block: {
        // ---- Validate row_ptr nonzero. ----
        cmp rdi, 0;
        je  trackpad_gesture_i_bad_row;

        // ---- Validate contact_count <= TG_MAX_CONTACT_COUNT (10). ----
        cmp rsi, 10;
        ja  trackpad_gesture_i_bad_count;

        // ---- Validate contact_area fits u16. ----
        mov r10, rdx;
        shr r10, 16;
        cmp r10, 0;
        jne trackpad_gesture_i_bad_area;

        // ---- Bump gesture_seq at [+24]. Always -- palm rejects still tick. ----
        mov rax, [rdi + 24];
        add rax, 1;
        mov [rdi + 24], rax;

        // ---- Palm check: if contact_area > palm_area_threshold -> FILTER_PALM_REJECT. ----
        mov rax, [rdi + 8];
        and rax, 0xFFFF;             // rax = palm_area_threshold
        cmp rdx, rax;
        ja  trackpad_gesture_i_palm;

        // ---- Overwrite active_contact_count in ident[39:32], preserve rest. ----
        // Load ident, build ~(0xFF << 32) mask in r10, AND to clear bits [39:32].
        mov rax, [rdi + 0];
        mov r10, 0xFF;
        shl r10, 32;                 // r10 = 0x000000FF00000000
        not r10;                     // r10 = 0xFFFFFF00FFFFFFFF
        and rax, r10;                // rax has [39:32] cleared

        // Position new count byte at [39:32] via rax (freshly rebuilt via r10
        // staging so we don't clobber the just-masked value).
        // r10 = new count, masked to u8, shifted to [39:32].
        mov r10, rsi;
        and r10, 0xFF;               // r10 accepts imm-form AND
        shl r10, 32;
        or  rax, r10;
        mov [rdi + 0], rax;

        // ---- Dispatch by contact_count. ----
        cmp rsi, 3;
        jae trackpad_gesture_i_three;     // count >= 3
        cmp rsi, 2;
        je  trackpad_gesture_i_two;
        cmp rsi, 1;
        je  trackpad_gesture_i_tap;

        // count == 0: all fingers lifted; no timestamp update.
        xor rax, rax;                     // FILTER_TAP_CLICK
        ret;

      trackpad_gesture_i_tap:
        // count == 1: stamp last_tap_nsec = nsec, return FILTER_TAP_CLICK.
        mov [rdi + 16], rcx;
        xor rax, rax;                     // FILTER_TAP_CLICK
        ret;

      trackpad_gesture_i_two:
        // count == 2: consult natural_scroll_enabled at ident[47:40].
        mov rax, [rdi + 0];
        shr rax, 40;
        and rax, 0xFF;                    // rax = natural_scroll_enabled
        cmp rax, 1;
        je  trackpad_gesture_i_natural;
        mov rax, 3;                       // FILTER_TWO_FINGER
        ret;

      trackpad_gesture_i_natural:
        mov rax, 2;                       // FILTER_NATURAL_SCROLL
        ret;

      trackpad_gesture_i_three:
        mov rax, 4;                       // FILTER_THREE_FINGER
        ret;

      trackpad_gesture_i_palm:
        // Palm reject: gesture_seq was already bumped; count and tap
        // remain byte-identical (a palm does not participate in the
        // finger-count classifier).
        mov rax, 1;                       // FILTER_PALM_REJECT
        ret;

      trackpad_gesture_i_bad_row:
        mov rax, 0xFFFFEAED;              // TG_BAD_ROW
        ret;
      trackpad_gesture_i_bad_count:
        mov rax, 0xFFFFEAE9;              // TG_BAD_CONTACT_COUNT
        ret;
      trackpad_gesture_i_bad_area:
        mov rax, 0xFFFFEAE8;              // TG_BAD_CONTACT_AREA
        ret
      }
    }

  // ==========================================================================
  // SECTION L  Setters (tune knobs; overwrite exactly one field each)
  //
  //   trackpad_gesture_set_tap_threshold(row_ptr, ms)         -> status
  //   trackpad_gesture_set_palm_threshold(row_ptr, sqmm)      -> status
  //   trackpad_gesture_set_natural_scroll(row_ptr, flag)      -> status
  //
  // Each setter overwrites only its target field(s), preserving the
  // other packed fields. Validates before writing so a refused call
  // leaves the row byte-identical to its prior state.
  // ==========================================================================

  // trackpad_gesture_set_tap_threshold(row_ptr, ms) -> status.
  //
  // Refuses:
  //   * row_ptr == 0    -> TG_BAD_ROW
  //   * ms > u16        -> TG_BAD_TAP_THRESHOLD
  //
  // Overwrites bits [63:48] of the ident word, preserving device
  // [31:0], active_contact_count [39:32], natural_scroll [47:40].
  pub let trackpad_gesture_set_tap_threshold : (u64, u64) -> u64 !{mem} @{} =
    fn (row_ptr: u64) (ms: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "B12-01 (#2282): overwrite tap_threshold_ms in ident[63:48] preserving device, count, natural_scroll. Validates row_ptr and ms-fits-u16. Read-modify-write via shl 16; shr 16 to clear bits [63:48] of the loaded ident (bits [15:0] were 0 before shift; shl 16 keeps only bits [47:0], shr 16 puts them back in place with [63:48] zero; then OR in the new tap_threshold_ms shifted to [63:48]). Scratch: rax, r10. Labels prefixed trackpad_gesture_stt_.",
      block: {
        cmp rdi, 0;
        je  trackpad_gesture_stt_bad_row;

        // Validate ms fits u16.
        mov r10, rsi;
        shr r10, 16;
        cmp r10, 0;
        jne trackpad_gesture_stt_bad;

        // Load ident, clear bits [63:48] via shl 16 then shr 16.
        mov rax, [rdi + 0];
        shl rax, 16;                     // drop bits [63:48], all fields shift up
        shr rax, 16;                     // shift back; bits [63:48] now zero
        // Position new ms at [63:48].
        mov r10, rsi;
        shl r10, 48;
        or  rax, r10;
        mov [rdi + 0], rax;

        xor rax, rax;                    // TRACKPAD_GESTURE_OK
        ret;

      trackpad_gesture_stt_bad_row:
        mov rax, 0xFFFFEAED;             // TG_BAD_ROW
        ret;
      trackpad_gesture_stt_bad:
        mov rax, 0xFFFFEAEC;             // TG_BAD_TAP_THRESHOLD
        ret
      }
    }

  // trackpad_gesture_set_palm_threshold(row_ptr, sqmm) -> status.
  //
  // Refuses:
  //   * row_ptr == 0    -> TG_BAD_ROW
  //   * sqmm > u16      -> TG_BAD_PALM_THRESHOLD
  //
  // Overwrites bits [15:0] of the thresh word, preserving reserved
  // bits [63:16] (currently always zero, but future-safe).
  pub let trackpad_gesture_set_palm_threshold : (u64, u64) -> u64 !{mem} @{} =
    fn (row_ptr: u64) (sqmm: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "B12-01 (#2282): overwrite palm_area_threshold in thresh[15:0] preserving reserved [63:16]. Validates row_ptr and sqmm-fits-u16. Read-modify-write via shr 16 / shl 16 to clear low 16 bits, then OR in new value masked to u16 via shl 48 / shr 48. Scratch: rax, r10. Labels prefixed trackpad_gesture_spt_.",
      block: {
        cmp rdi, 0;
        je  trackpad_gesture_spt_bad_row;

        // Validate sqmm fits u16.
        mov r10, rsi;
        shr r10, 16;
        cmp r10, 0;
        jne trackpad_gesture_spt_bad;

        // Load thresh, clear bits [15:0] via shr 16; shl 16.
        mov rax, [rdi + 8];
        shr rax, 16;
        shl rax, 16;                     // bits [15:0] now zero
        // Mask sqmm to u16 and OR in.
        mov r10, rsi;
        shl r10, 48;
        shr r10, 48;                     // r10 = sqmm zero-extended to u16
        or  rax, r10;
        mov [rdi + 8], rax;

        xor rax, rax;
        ret;

      trackpad_gesture_spt_bad_row:
        mov rax, 0xFFFFEAED;
        ret;
      trackpad_gesture_spt_bad:
        mov rax, 0xFFFFEAEB;             // TG_BAD_PALM_THRESHOLD
        ret
      }
    }

  // trackpad_gesture_set_natural_scroll(row_ptr, flag) -> status.
  //
  // Refuses:
  //   * row_ptr == 0    -> TG_BAD_ROW
  //   * flag > 1        -> TG_BAD_NATURAL_SCROLL
  //
  // Overwrites bits [47:40] of the ident word (natural_scroll_enabled),
  // preserving device [31:0], active_contact_count [39:32], and
  // tap_threshold_ms [63:48].
  pub let trackpad_gesture_set_natural_scroll : (u64, u64) -> u64 !{mem} @{} =
    fn (row_ptr: u64) (flag: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "B12-01 (#2282): overwrite natural_scroll_enabled in ident[47:40] preserving device, count, tap_threshold_ms. Validates row_ptr and flag<=1. Uses the same shl/not mask staging through r10 as trackpad_gesture_ingest's count rewrite. Scratch: rax, r10. Labels prefixed trackpad_gesture_sns_.",
      block: {
        cmp rdi, 0;
        je  trackpad_gesture_sns_bad_row;

        cmp rsi, 1;
        ja  trackpad_gesture_sns_bad;

        // Load ident, clear bits [47:40] via mask staged in r10.
        mov rax, [rdi + 0];
        mov r10, 0xFF;
        shl r10, 40;                     // r10 = 0x0000FF0000000000
        not r10;                         // r10 = 0xFFFF00FFFFFFFFFF
        and rax, r10;                    // rax has [47:40] cleared

        // Position new flag at [47:40].
        mov r10, rsi;
        and r10, 0xFF;
        shl r10, 40;
        or  rax, r10;
        mov [rdi + 0], rax;

        xor rax, rax;
        ret;

      trackpad_gesture_sns_bad_row:
        mov rax, 0xFFFFEAED;
        ret;
      trackpad_gesture_sns_bad:
        mov rax, 0xFFFFEAEA;             // TG_BAD_NATURAL_SCROLL
        ret
      }
    }
}
