// src/user/input_server/touch_contact.pdx -- Wave0-B9-03 (paideia-os #2283)
//
// KIND_TOUCH_CONTACT = 0x1D8, derived over KIND_INPUT_SERVER (0x1D0,
// landed by B8-01 in Wave-0 Batch-8). One tracked finger on one bound
// KIND_TOUCH_DEVICE (0x1D4) as seen by one KIND_SEAT (0x1D6). Owns
// the transient per-contact state (current position, pressure, state
// byte, first-seen sequence) that the input server's per-seat
// gesture-recogniser tree walks each tick to classify multi-finger
// motion into one of seven GestureKind values.
//
// Design authority:
//   * design/compositor/pwp-spec-vocabulary.md §2.11 KIND_TOUCH_CONTACT
//     (this landing seeds the ordinal + row layout; the spec section is
//     stub-shaped until the compositor pen-and-paper vocab review in
//     the next design batch). The parent-slot pin (KIND_INPUT_SERVER at
//     0x1D0) matches the seat + route landings' pattern of hanging
//     derived kinds off the input server rather than off the seat,
//     because the recogniser walks contacts across seats when a
//     multi-seat rig has a shared touch surface (uncommon but not
//     impossible).
//   * design/roadmap/next-wave-synthesis.md §4 pitfall P2 -- the input
//     server IS the authority for gesture recognition; delivery is
//     one-hop (via KIND_INPUT_ROUTE, 0x1D7) after the recogniser
//     classifies the contact set. A minted KIND_TOUCH_CONTACT is
//     server-internal; clients never see a raw contact cap, only the
//     resulting GESTURE_* delivery through their input route.
//   * design/compositor/pwp-spec-vocabulary.md §2.10 KIND_INPUT_ROUTE
//     (B8-07 sibling landing) -- once the recogniser classifies a
//     contact set into a GestureKind, the input server mints the
//     matching gesture event (KIND_GESTURE_EVENT, future landing) and
//     forwards it via the seat's active KIND_INPUT_ROUTE. That
//     downstream mint requires the RIGHT_MINT_GESTURE right on the
//     contact row.
//
// PURPOSE. A derived-kind capability that names ONE tracked finger.
// The row carries:
//   * contact_id (u32) -- hardware-assigned finger ID; the touch
//     driver's per-frame slot number. Zero is the row-empty sentinel;
//     hardware finger IDs are 1-based per T14 G4's Synaptics-compatible
//     touch spec.
//   * seat_kind_id (u32) -- the KIND_SEAT (0x1D6) this finger belongs
//     to; determines which surface the resulting gesture is delivered
//     to (via the seat's active KIND_INPUT_ROUTE).
//   * touch_device_kind_id (u32) -- the KIND_TOUCH_DEVICE (0x1D4)
//     hardware the finger arrived on. Held on the row so the
//     recogniser can reject cross-device gestures (a pinch across two
//     physical touchpads is nonsense) in O(1) without a seat walk.
//   * pos_x, pos_y (i32 each) -- CURRENT position, surface-relative,
//     in surface-DPI pixels. i32 (not u32) because a moving finger
//     that leaves the surface's inner rect is still tracked until UP
//     with negative or over-max coordinates.
//   * pressure (u16) -- current touch pressure, 0..65535 linear. Zero
//     is legal (a resting finger on a low-sensitivity capacitive
//     screen reads zero pressure without lifting).
//   * state (u8) -- 0=DOWN (first frame), 1=MOVE (subsequent frame
//     with position delta), 2=UP (final frame; row freed by next tick),
//     3=CANCEL (surface lost focus or driver-reset mid-contact; treat
//     like UP but with no gesture emission).
//   * first_seen_seq (u64) -- monotonic per-input-server sequence at
//     first frame. Used by the tap-timeout / long-press classifier
//     (tap timeout = 200 ms, long-press timeout = 500 ms in T14 G4
//     libinput-compatible defaults) and by the double-tap detector
//     (400 ms gap between UP and next DOWN in the same neighbourhood).
//
// A typical single-finger tap emits: DOWN → UP within one recogniser
// tick with < 200 ms elapsed → GESTURE_TAP. A single-finger drag emits
// DOWN → MOVE (many frames) → UP → GESTURE_PAN. Two-finger simultaneous
// tracking with converging/diverging positions emits GESTURE_PINCH;
// rotation-only tracking emits GESTURE_ROTATE; ≥ 3 fingers moving
// uniformly emits GESTURE_SWIPE.
//
// =============================================================================
// NOVEL-CLEAN CHOICES
// =============================================================================
//
// (1) THE RECOGNISER IS SERVER-INTERNAL, GESTURES ARE THE CLIENT API.
//     A client NEVER sees a raw KIND_TOUCH_CONTACT cap. What it holds
//     is R_ROUTE_DELIVER_TOUCH on its KIND_INPUT_ROUTE and receives
//     GestureKind-tagged events from the input server's recogniser
//     tree. This is the inverse of X11 (which forwards raw touch
//     events and expects the client to run its own recogniser --
//     giving every X11 client a keylogger-equivalent view of the
//     device stream) and matches Wayland's wp_pointer_gestures
//     protocol posture, but here the recogniser is a first-class kind
//     row rather than a compositor-side ad-hoc struct.
//
// (2) DEVICE BINDING IS TYPED, NOT PARENTED.
//     The row's touch_device_kind_id is a u32 slot, not a parent-cap
//     derivation edge. Rationale: a finger on device A that transiently
//     crosses into a surface owned by device B's seat is still one
//     contact -- the parent-cap posture would force a re-mint per
//     device crossing, which is wrong for a physically continuous
//     touch. The typed slot lets the recogniser reject cross-device
//     gestures at classification time without a re-mint dance.
//
// (3) STATE=UP ROWS ARE FREED BY THE NEXT TICK, NOT IMMEDIATELY.
//     touch_contact_end() sets state=UP and returns; the tick handler
//     (a future landing) reads the UP marker on its next sweep and
//     returns the row to the pool. This one-tick grace period is what
//     lets the double-tap recogniser see the previous UP still on the
//     table when a fresh DOWN arrives in the same neighbourhood. An
//     "immediate free on UP" posture would force the recogniser to
//     carry a parallel side-table of "recently up" contacts, which
//     drifts out of sync with the actual pool the first time an event
//     is delayed.
//
// (4) GESTURE RECOGNITION IS COUNT-DIRECTED, NOT STATE-MACHINE-DIRECTED.
//     The recogniser walks the active contact array and dispatches
//     based on ((count, aggregate-state)) rather than running a state
//     machine per contact. This is the same posture surface_commit
//     takes for its atomic-batch model: aggregate-shape at commit time,
//     not per-field mutation tracking. The advantage is testability --
//     any set of contact rows classifies deterministically without a
//     hidden per-contact FSM cursor to snapshot.
//
// =============================================================================
// SLOT ALLOCATION -- KIND_TOUCH_CONTACT = 0x1D8
// =============================================================================
//
// Consulted design/architecture/next-wave-derived-kinds.md and grepped
// src/ for 0x1D8 -- unclaimed at landing. Neighbours:
//   0x1D0  KIND_INPUT_SERVER               (B8-01 landed)
//   0x1D1  RP_COMPOSITOR_KIND_FORWARD      (recovery-plane forward kind)
//   0x1D2..0x1D5  device-kind reservations (KIND_KEYBOARD_DEVICE, ...
//                 KIND_TOUCH_DEVICE at 0x1D4)
//   0x1D6  KIND_SEAT                       (B8-06 landed)
//   0x1D7  KIND_INPUT_ROUTE                (B8-07 landed)
//   0x1D8  KIND_TOUCH_CONTACT              (THIS FILE, B9-03)
//   0x1D9..0x1DF  unassigned
//
// TOUCH_CONTACT_PARENT_KIND is the reconciliation point if B8-01
// ends up rebinding 0x1D0; one-line edit + fingerprint re-emission.
//
// =============================================================================
// ROW LAYOUT -- 32 BYTES
// =============================================================================
//
//   [+0]  ids0:  contact_id[31:0]         | seat_kind_id[63:32]
//   [+8]  ids1:  touch_device_kind_id[31:0] | pos_x[63:32]           (i32 in high)
//   [+16] state: pos_y[31:0] | pressure[47:32] | state[55:48] | reserved[63:56]
//   [+24] seq:   first_seen_seq[63:0]
//
// Every u32/i32 slot is packed via shl 32 / shr 32 (no `and reg, imm64`
// per this file's encoder-conservative posture, same as seat_kind).
// The state byte is written / read via a shl-and-shr byte-shift pair
// so no MOVZX/MOVSX is generated (encoder discipline: no mov_bzx/wzx).
// contact_id == 0 is refused so [+0] doubles as the row-empty sentinel
// (matches seat_kind's seat_id == 0 discipline). No separate header
// word: 32 bytes total, half a cache line.
//
// =============================================================================
// FAILURE TAXONOMY -- 0xFFFFEBA0..0xFFFFEBAF
// =============================================================================
//
// Fresh 16-slot band, verified free by grep across src/**/*.pdx +
// tests/**/*.pdx at landing time (no existing 0xFFFFEBA* sentinel in
// tree). Neighbours:
//   0xFFFFEB70..7F  KIND_SEAT + KIND_INPUT_ROUTE (band shared, see the
//                   route_kind.pdx band-deviation note; both files
//                   use the SEAT_* / ROUTE_KIND_* namespace to keep
//                   sentinels disambiguated at readback time)
//   0xFFFFEB80..9F  entirely free (reserved for later Wave-0 B9 rows)
//   0xFFFFEBA0..AF  KIND_TOUCH_CONTACT (THIS BAND)
//   0xFFFFEBB0..DF  entirely free
//   0xFFFFEBE0..EF  KIND_AUDIT_JOURNAL_BROKER (from ipc/)

module TouchContact = structure {

  // ==========================================================================
  // SECTION 1 -- KIND ORDINAL + PARENT + POOL CEILING
  // ==========================================================================

  pub let KIND_TOUCH_CONTACT        : u64 = 0x1D8
  pub let TOUCH_CONTACT_PARENT_KIND : u64 = 0x1D0   // KIND_INPUT_SERVER

  // Pool ceiling. 10 concurrent contacts -- T14 G4's touch controller
  // exposes 10 hardware slots and the spec-standard Synaptics driver
  // caps at 10 simultaneous fingers. 10 * 32 = 320 bytes -- fits well
  // within one 4 KiB page shared with sibling contact pools.
  pub let TOUCH_CONTACT_MAX       : u64 = 10
  pub let TOUCH_CONTACT_ROW_BYTES : u64 = 32

  // Documentary u32 mask -- assembly uses shl 32 / shr 32.
  pub let TOUCH_CONTACT_U32_MAX : u64 = 0xFFFFFFFF
  pub let TOUCH_CONTACT_U16_MAX : u64 = 0xFFFF

  // ==========================================================================
  // SECTION 2 -- RIGHTS
  // ==========================================================================
  //
  // Six rights on the KIND_TOUCH_CONTACT family. The (track, query,
  // mint-gesture, revoke) quartet is the server's own working set;
  // (R_TC_OBSERVE, R_TC_MINT) are the derivation-family bits held on
  // the parent (KIND_INPUT_SERVER) and never on individual contact
  // rows.
  //
  //   RIGHT_TRACK_CONTACT    -- author touch_contact_track (create + update)
  //   RIGHT_QUERY_ACTIVE     -- read current pos/pressure/state
  //   RIGHT_MINT_GESTURE     -- authorise the recogniser to mint a
  //                             KIND_GESTURE_EVENT (future landing) for
  //                             this contact set
  //   RIGHT_REVOKE           -- call touch_contact_end (state -> UP)
  //   R_TC_OBSERVE           -- introspection on the contact table
  //                             (row-count, per-seat aggregate) held on
  //                             KIND_INPUT_SERVER, not on rows
  //   R_TC_MINT              -- derive KIND_TOUCH_CONTACT rows (held on
  //                             KIND_INPUT_SERVER); no client ever
  //                             holds this

  pub let RIGHT_TRACK_CONTACT : u64 = 0x001
  pub let RIGHT_QUERY_ACTIVE  : u64 = 0x002
  pub let RIGHT_MINT_GESTURE  : u64 = 0x004
  pub let RIGHT_REVOKE        : u64 = 0x008
  pub let R_TC_OBSERVE        : u64 = 0x010
  pub let R_TC_MINT           : u64 = 0x200
  pub let R_TC_ALL            : u64 = 0x21F
     // 0x001 | 0x002 | 0x004 | 0x008 | 0x010 | 0x200

  // ==========================================================================
  // SECTION 3 -- GESTURE KIND ENUM
  // ==========================================================================
  //
  // Seven values covering the input-server-recognised gesture set.
  // Enum values are contiguous 0..6 so a future dispatcher can index a
  // jump table without a sparse-map probe. The classifier in Section 9
  // emits GESTURE_TAP / GESTURE_PAN / GESTURE_PINCH / GESTURE_SWIPE in
  // its first-pass shape; GESTURE_DOUBLE_TAP / GESTURE_LONG_PRESS /
  // GESTURE_ROTATE land in the follow-up recogniser milestone once the
  // first_seen_seq deltas are wired into the tick handler.

  pub let GESTURE_TAP         : u64 = 0
  pub let GESTURE_DOUBLE_TAP  : u64 = 1
  pub let GESTURE_LONG_PRESS  : u64 = 2
  pub let GESTURE_PAN         : u64 = 3
  pub let GESTURE_PINCH       : u64 = 4
  pub let GESTURE_ROTATE      : u64 = 5
  pub let GESTURE_SWIPE       : u64 = 6
  pub let GESTURE_KIND_MAX    : u64 = 6

  // ==========================================================================
  // SECTION 4 -- STATE ENUM
  // ==========================================================================

  pub let TOUCH_STATE_DOWN    : u64 = 0
  pub let TOUCH_STATE_MOVE    : u64 = 1
  pub let TOUCH_STATE_UP      : u64 = 2
  pub let TOUCH_STATE_CANCEL  : u64 = 3
  pub let TOUCH_STATE_MAX     : u64 = 3

  // ==========================================================================
  // SECTION 5 -- ROW LAYOUT OFFSETS
  // ==========================================================================

  pub let TC_OFF_IDS0  : u64 = 0    // contact_id | seat_kind_id
  pub let TC_OFF_IDS1  : u64 = 8    // touch_device_kind_id | pos_x
  pub let TC_OFF_STATE : u64 = 16   // pos_y | pressure | state | reserved
  pub let TC_OFF_SEQ   : u64 = 24   // first_seen_seq

  // Sub-word bit positions in TC_OFF_STATE (bits from LSB):
  //   pos_y     bits [31:0]
  //   pressure  bits [47:32]
  //   state     bits [55:48]
  //   reserved  bits [63:56]
  pub let TC_STATE_POS_Y_SHIFT    : u64 = 0
  pub let TC_STATE_PRESSURE_SHIFT : u64 = 32
  pub let TC_STATE_STATE_SHIFT    : u64 = 48

  // ==========================================================================
  // SECTION 6 -- OP TAGS
  // ==========================================================================

  pub let TC_OP_TRACK             : u64 = 0
  pub let TC_OP_UPDATE            : u64 = 1
  pub let TC_OP_END               : u64 = 2
  pub let TC_OP_RECOGNISE         : u64 = 3
  pub let TC_OP_QUERY_POS         : u64 = 4
  pub let TC_OP_QUERY_STATE       : u64 = 5
  pub let TC_OP_QUERY_PRESSURE    : u64 = 6
  pub let TC_OP_QUERY_SEAT        : u64 = 7
  pub let TC_OP_QUERY_DEVICE      : u64 = 8
  pub let TC_OP_MAX               : u64 = 8

  // ==========================================================================
  // SECTION 7 -- FAILURE TAXONOMY -- 0xFFFFEBA0..0xFFFFEBAF
  // ==========================================================================

  pub let TC_OK                     : u64 = 0
  pub let TC_TAIL_ENOSPC            : u64 = 0xFFFFEBAF
  pub let TC_TRACK_BAD_CONTACT_ID   : u64 = 0xFFFFEBAE
  pub let TC_TRACK_BAD_SEAT         : u64 = 0xFFFFEBAD
  pub let TC_TRACK_BAD_DEVICE       : u64 = 0xFFFFEBAC
  pub let TC_TRACK_BAD_PRESSURE     : u64 = 0xFFFFEBAB
  pub let TC_UPDATE_BAD_STATE       : u64 = 0xFFFFEBAA
  pub let TC_UPDATE_BAD_ROW         : u64 = 0xFFFFEBA9
  pub let TC_UPDATE_BAD_PRESSURE    : u64 = 0xFFFFEBA8
  pub let TC_END_BAD_ROW            : u64 = 0xFFFFEBA7
  pub let TC_END_ALREADY            : u64 = 0xFFFFEBA6
  pub let TC_GESTURE_BAD_ARRAY      : u64 = 0xFFFFEBA5
  pub let TC_GESTURE_BAD_COUNT      : u64 = 0xFFFFEBA4
  pub let TC_BAD_SLOT               : u64 = 0xFFFFEBA3
  pub let TC_BAD_RIGHTS             : u64 = 0xFFFFEBA2
  pub let TC_UNSUP_OP               : u64 = 0xFFFFEBA1
  pub let TC_ROW_NONE               : u64 = 0xFFFFEBA0

  // ==========================================================================
  // SECTION 8 -- STATS COUNTER SLOTS
  // ==========================================================================

  pub let TC_ST_TRACKS         : u64 = 0
  pub let TC_ST_UPDATES        : u64 = 1
  pub let TC_ST_ENDS           : u64 = 2
  pub let TC_ST_GESTURES       : u64 = 3
  pub let TC_ST_REFUSED        : u64 = 4
  pub let TC_ST_CANCELS        : u64 = 5   // state == CANCEL sightings
  pub let TC_ST_CROSS_DEV      : u64 = 6   // recogniser rejects
  pub let TC_ST_MAX            : u64 = 8

  // ==========================================================================
  // SECTION 9 -- FINGERPRINT (one line, legacy-suffixed)
  // ==========================================================================
  //
  // Emitted once on successful touch_contact_track by the future
  // substrate. The legacy-suffix convention is what
  // tools/verify-fingerprint-coverage.sh enumerates. No fingerprint on
  // update / end / recognise / query paths.
  //
  // Byte count: "touch contact track ok [legacy: TOUCH CONTACT TRACK OK]\0"
  //   = 55 chars + NUL = 56.
  pub let pdx_kind_touch_contact_meta : [u8; 56] = "touch contact track ok [legacy: TOUCH CONTACT TRACK OK]\0"

  // ==========================================================================
  // SECTION 10 -- VALIDATORS (pure leaves)
  // ==========================================================================
  //
  // Every function here is a pure, unsafe-bodied leaf with small
  // immediates. Returns in rax, clobbers rax + one scratch. No `test`,
  // no `and reg, imm64`, no MOVZX. Labels prefixed touch_contact_.

  // touch_contact_contact_id_valid(id) -> 1 iff id in (0, 2^32).
  // Zero is refused so the row's [+0] doubles as a row-empty sentinel.
  pub let touch_contact_contact_id_valid : (u64) -> u64 !{} @{} =
    fn (id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "B9-03 (#2283): contact_id validator (nonzero + fits u32). Zero refused so [+0] doubles as row-empty sentinel. Uses shr 32 to check upper bits are clear rather than `and reg, 0xFFFFFFFF`. Labels prefixed touch_contact_civ_.",
      block: {
        cmp rdi, 0;
        je  touch_contact_civ_no;
        mov rax, rdi;
        shr rax, 32;
        cmp rax, 0;
        jne touch_contact_civ_no;
        mov rax, 1;
        ret;
      touch_contact_civ_no:
        xor rax, rax;
        ret
      }
    }

  // touch_contact_seat_valid(seat_kind_id) -> 1 iff in (0, 2^32).
  pub let touch_contact_seat_valid : (u64) -> u64 !{} @{} =
    fn (seat_kind_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "B9-03 (#2283): seat kind_id validator (nonzero + fits u32). Zero refused: a contact with no seat has nowhere to route its gesture. Uses shr 32 rather than `and reg, 0xFFFFFFFF`. Labels prefixed touch_contact_sv_.",
      block: {
        cmp rdi, 0;
        je  touch_contact_sv_no;
        mov rax, rdi;
        shr rax, 32;
        cmp rax, 0;
        jne touch_contact_sv_no;
        mov rax, 1;
        ret;
      touch_contact_sv_no:
        xor rax, rax;
        ret
      }
    }

  // touch_contact_device_valid(device_kind_id) -> 1 iff in (0, 2^32).
  pub let touch_contact_device_valid : (u64) -> u64 !{} @{} =
    fn (device_kind_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "B9-03 (#2283): touch_device kind_id validator (nonzero + fits u32). Zero refused: a contact with no source device cannot be dedup-ed against sibling fingers on the same hardware. Uses shr 32 rather than `and reg, 0xFFFFFFFF`. Labels prefixed touch_contact_dv_.",
      block: {
        cmp rdi, 0;
        je  touch_contact_dv_no;
        mov rax, rdi;
        shr rax, 32;
        cmp rax, 0;
        jne touch_contact_dv_no;
        mov rax, 1;
        ret;
      touch_contact_dv_no:
        xor rax, rax;
        ret
      }
    }

  // touch_contact_pressure_valid(pressure) -> 1 iff fits u16.
  // Zero IS legal (a resting finger on a low-sensitivity capacitive
  // screen reads zero pressure without lifting).
  pub let touch_contact_pressure_valid : (u64) -> u64 !{} @{} =
    fn (pressure: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "B9-03 (#2283): pressure validator (fits u16; zero legal). Uses shr 16 to check upper bits are clear rather than `and reg, 0xFFFF` (small enough for imm32, but shr keeps consistent with the shl/shr masking discipline). Labels prefixed touch_contact_pv_.",
      block: {
        mov rax, rdi;
        shr rax, 16;
        cmp rax, 0;
        jne touch_contact_pv_no;
        mov rax, 1;
        ret;
      touch_contact_pv_no:
        xor rax, rax;
        ret
      }
    }

  // touch_contact_state_valid(state) -> 1 iff state in [0..3].
  pub let touch_contact_state_valid : (u64) -> u64 !{} @{} =
    fn (state: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "B9-03 (#2283): state validator (DOWN=0, MOVE=1, UP=2, CANCEL=3). Small immediate compare; ja captures both signed-negative (never happens with u64) and > 3. Labels prefixed touch_contact_stv_.",
      block: {
        cmp rdi, 3;
        ja  touch_contact_stv_no;
        mov rax, 1;
        ret;
      touch_contact_stv_no:
        xor rax, rax;
        ret
      }
    }

  // touch_contact_rights_valid(rights) -> 1 iff rights subset of R_TC_ALL.
  pub let touch_contact_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "B9-03 (#2283): rights subset test against R_TC_ALL = 0x21F. Small imm, so `and reg, imm32` sign-extends 0x21F to 0x000000000000021F -- correct as a mask. Labels prefixed touch_contact_rv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x21F;
        and rax, r10;
        cmp rax, rdi;
        jne touch_contact_rv_no;
        mov rax, 1;
        ret;
      touch_contact_rv_no:
        xor rax, rax;
        ret
      }
    }

  // touch_contact_op_valid(op) -> 1 iff op in [0, TC_OP_MAX=8].
  pub let touch_contact_op_valid : (u64) -> u64 !{} @{} =
    fn (op: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "B9-03 (#2283): dispatch op validator. Admits 0..8. Small immediate. Labels prefixed touch_contact_ov_.",
      block: {
        cmp rdi, 8;
        ja  touch_contact_ov_no;
        mov rax, 1;
        ret;
      touch_contact_ov_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // SECTION 11 -- PACKERS
  // ==========================================================================
  //
  // Every packer masks its u32 fields via shl 32 / shr 32 so an
  // out-of-range argument cannot smear into a neighbour field. No
  // `and reg, imm64`, no `mov reg, 0xFFFFFFFF` reliance.

  // touch_contact_pack_ids0(contact_id, seat_kind_id)
  //   -> contact_id[31:0] | seat_kind_id[63:32]
  pub let touch_contact_pack_ids0 : (u64, u64) -> u64 !{} @{} =
    fn (contact_id: u64) (seat_kind_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "B9-03 (#2283): pack ids0 (contact_id[31:0] | seat_kind_id[63:32]). Row-write helper for TC_OFF_IDS0 = 0. Both halves masked via shl 32 / shr 32. Labels prefixed touch_contact_p0_ (none needed, straight-line).",
      block: {
        // rax = contact_id & 0xFFFFFFFF
        mov rax, rdi;
        shl rax, 32;
        shr rax, 32;
        // r10 = seat_kind_id << 32
        mov r10, rsi;
        shl r10, 32;
        or  rax, r10;
        ret
      }
    }

  // touch_contact_pack_ids1(device_kind_id, pos_x)
  //   -> device_kind_id[31:0] | pos_x[63:32]
  // pos_x is i32; its bit pattern is packed as-is (the recogniser
  // treats it as signed at read time via a shl 32 / sar 32 pair).
  pub let touch_contact_pack_ids1 : (u64, u64) -> u64 !{} @{} =
    fn (device_kind_id: u64) (pos_x: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "B9-03 (#2283): pack ids1 (touch_device_kind_id[31:0] | pos_x[63:32]). Row-write helper for TC_OFF_IDS1 = 8. Both halves masked via shl 32 / shr 32. pos_x is i32; sign preserved at readback via shl 32 / sar 32 in the recogniser. Labels prefixed touch_contact_p1_ (none needed, straight-line).",
      block: {
        // rax = device_kind_id & 0xFFFFFFFF
        mov rax, rdi;
        shl rax, 32;
        shr rax, 32;
        // r10 = pos_x << 32 (truncates any bits above the low 32)
        mov r10, rsi;
        shl r10, 32;
        or  rax, r10;
        ret
      }
    }

  // touch_contact_pack_state(pos_y, pressure, state)
  //   -> pos_y[31:0] | pressure[47:32] | state[55:48] | reserved[63:56]
  // pos_y is i32 (packed as-is), pressure is u16 (masked via
  // shl 48 / shr 16 net-shift-left 32), state is u8 (masked via
  // shl 56 / shr 8 net-shift-left 48). No `and reg, imm64` and no
  // MOVZX -- pure shifted immediates.
  pub let touch_contact_pack_state : (u64, u64, u64) -> u64 !{} @{} =
    fn (pos_y: u64) (pressure: u64) (state: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "B9-03 (#2283): pack state word (pos_y[31:0] | pressure[47:32] | state[55:48]; reserved[63:56] = 0). pos_y masked via shl 32 / shr 32; pressure masked to u16 via shl 48 / shr 16 (net shift-left 32 with high bits above 47 cleared); state masked to u8 via shl 56 / shr 8 (net shift-left 48 with high bits above 55 cleared). No `and reg, imm64`, no MOVZX. Labels prefixed touch_contact_ps_ (none needed, straight-line).",
      block: {
        // rax = pos_y & 0xFFFFFFFF
        mov rax, rdi;
        shl rax, 32;
        shr rax, 32;

        // r10 = (pressure & 0xFFFF) << 32
        mov r10, rsi;
        shl r10, 48;
        shr r10, 16;
        or  rax, r10;

        // r11 = (state & 0xFF) << 48
        mov r11, rdx;
        shl r11, 56;
        shr r11, 8;
        or  rax, r11;
        ret
      }
    }

  // ==========================================================================
  // SECTION 12 -- FACTORY: touch_contact_track(contact_id, seat, device,
  //                                            x, y, pressure) -> row_id
  // ==========================================================================
  //
  // Stub factory (matches route_kind's input_route_mint posture).
  // Validates inputs and, on success, returns a sentinel row_id 1;
  // returns a TC_TRACK_* sentinel on refusal. The real row-write path
  // (pool allocation via a future _tc_pool_alloc, packed writes at
  // TC_OFF_IDS0..TC_OFF_SEQ, stats bump on TC_ST_TRACKS, fingerprint
  // emit) lands in the follow-up substrate milestone.
  //
  // Validation order: contact_id, seat, device, pressure. x/y are
  // i32 and accepted as-is (the packer truncates on write; a caller
  // that hands out-of-range coordinates gets truncated coordinates
  // at delivery, matching X11's silent-truncate posture for legacy
  // driver quirks).
  //
  // Signature: (contact_id, seat, device, x, y, pressure) -> u64
  //   contact_id: rdi (u32, nonzero)
  //   seat:       rsi (u32, nonzero, KIND_SEAT slot)
  //   device:     rdx (u32, nonzero, KIND_TOUCH_DEVICE slot)
  //   x:          rcx (i32, any bit pattern; packer truncates)
  //   y:          r8  (i32, any bit pattern; packer truncates)
  //   pressure:   r9  (u16, zero legal)

  pub let touch_contact_track : (u64, u64, u64, u64, u64, u64) -> u64 !{} @{} =
    fn (contact_id: u64) (seat: u64) (device: u64)
       (x: u64) (y: u64) (pressure: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "B9-03 (#2283): touch_contact_track stub factory. Validation order: (1) contact_id nonzero + fits u32 else TC_TRACK_BAD_CONTACT_ID (0xFFFFEBAE); (2) seat nonzero + fits u32 else TC_TRACK_BAD_SEAT (0xFFFFEBAD); (3) device nonzero + fits u32 else TC_TRACK_BAD_DEVICE (0xFFFFEBAC); (4) pressure fits u16 else TC_TRACK_BAD_PRESSURE (0xFFFFEBAB). On success returns sentinel row_id 1 (real pool allocation lands in the follow-up substrate milestone; the sentinel matches route_kind's input_route_mint posture). x, y are i32 and accepted as-is; the packer truncates on write. All u32 checks via shr rather than `and reg, imm64`. Scratch: rax, r10. Labels prefixed touch_contact_t_.",
      block: {
        // Validate contact_id (nonzero, fits u32).
        cmp rdi, 0;
        je  touch_contact_t_bad_id;
        mov r10, rdi;
        shr r10, 32;
        cmp r10, 0;
        jne touch_contact_t_bad_id;

        // Validate seat (nonzero, fits u32).
        cmp rsi, 0;
        je  touch_contact_t_bad_seat;
        mov r10, rsi;
        shr r10, 32;
        cmp r10, 0;
        jne touch_contact_t_bad_seat;

        // Validate device (nonzero, fits u32).
        cmp rdx, 0;
        je  touch_contact_t_bad_dev;
        mov r10, rdx;
        shr r10, 32;
        cmp r10, 0;
        jne touch_contact_t_bad_dev;

        // Validate pressure (fits u16). Zero legal.
        mov r10, r9;
        shr r10, 16;
        cmp r10, 0;
        jne touch_contact_t_bad_pressure;

        // Success: sentinel row_id 1 (never 0; row 0 reserved).
        mov rax, 1;
        ret;

      touch_contact_t_bad_id:
        mov rax, 0xFFFFEBAE;   // TC_TRACK_BAD_CONTACT_ID
        ret;
      touch_contact_t_bad_seat:
        mov rax, 0xFFFFEBAD;   // TC_TRACK_BAD_SEAT
        ret;
      touch_contact_t_bad_dev:
        mov rax, 0xFFFFEBAC;   // TC_TRACK_BAD_DEVICE
        ret;
      touch_contact_t_bad_pressure:
        mov rax, 0xFFFFEBAB;   // TC_TRACK_BAD_PRESSURE
        ret
      }
    }

  // ==========================================================================
  // SECTION 13 -- UPDATE: touch_contact_update(row_ptr, x, y, pressure, state)
  // ==========================================================================
  //
  // Real memory-mutating function. Writes a fresh pos_x into ids1's
  // high 32, and a fresh pos_y | pressure | state into the state word.
  // Preserves ids1's low 32 (touch_device_kind_id) and ids0/first_seen_seq
  // (unchanged; the mint-time values stay pinned).
  //
  // Refuses on:
  //   * row_ptr == 0            -> TC_UPDATE_BAD_ROW
  //   * pressure > 0xFFFF       -> TC_UPDATE_BAD_PRESSURE
  //   * state > 3               -> TC_UPDATE_BAD_STATE
  //
  // Signature: (row_ptr, x, y, pressure, state) -> u64
  //   row_ptr:  rdi (pointer to 32-byte row)
  //   x:        rsi (i32; packer truncates)
  //   y:        rdx (i32; packer truncates)
  //   pressure: rcx (u16)
  //   state:    r8  (u8, 0..3)
  pub let touch_contact_update : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (row_ptr: u64) (x: u64) (y: u64) (pressure: u64) (state: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "B9-03 (#2283): update the transient half of a touch-contact row (pos_x, pos_y, pressure, state). Preserves ids0 (contact_id | seat), ids1's low 32 (touch_device_kind_id), and first_seen_seq. Validation order: row_ptr nonzero (TC_UPDATE_BAD_ROW), pressure fits u16 (TC_UPDATE_BAD_PRESSURE), state <= 3 (TC_UPDATE_BAD_STATE). All validated before any store: a refused update leaves the row byte-identical. Word writes: ids1's high 32 (pos_x) built via shl 32 / shr 32 mask on device + shl 32 on pos_x + or; state word built via three shl/shr pairs then or (pos_y at [31:0], pressure at [47:32] via shl 48 / shr 16, state at [55:48] via shl 56 / shr 8). No `and reg, imm64`, no MOVZX. Scratch: rax, r10, r11. Labels prefixed touch_contact_u_.",
      block: {
        // ---- Validate row_ptr nonzero. ----
        cmp rdi, 0;
        je  touch_contact_u_bad_row;

        // ---- Validate pressure fits u16. ----
        mov r10, rcx;
        shr r10, 16;
        cmp r10, 0;
        jne touch_contact_u_bad_pressure;

        // ---- Validate state in [0..3]. ----
        cmp r8, 3;
        ja  touch_contact_u_bad_state;

        // ---- Rebuild ids1: preserve low 32 (device), replace high 32 (x). ----
        mov r10, [rdi + 8];
        shl r10, 32;
        shr r10, 32;              // r10 = device_kind_id in low 32
        mov r11, rsi;             // x
        shl r11, 32;              // x in high 32 (truncates high bits)
        or  r10, r11;
        mov [rdi + 8], r10;

        // ---- Build state word: pos_y | pressure | state | 0. ----
        // r10 = pos_y & 0xFFFFFFFF
        mov r10, rdx;
        shl r10, 32;
        shr r10, 32;

        // r11 = (pressure & 0xFFFF) << 32 (via shl 48 / shr 16)
        mov r11, rcx;
        shl r11, 48;
        shr r11, 16;
        or  r10, r11;

        // r11 = (state & 0xFF) << 48 (via shl 56 / shr 8)
        mov r11, r8;
        shl r11, 56;
        shr r11, 8;
        or  r10, r11;

        mov [rdi + 16], r10;

        // TC_OK.
        xor rax, rax;
        ret;

      touch_contact_u_bad_row:
        mov rax, 0xFFFFEBA9;      // TC_UPDATE_BAD_ROW
        ret;
      touch_contact_u_bad_pressure:
        mov rax, 0xFFFFEBA8;      // TC_UPDATE_BAD_PRESSURE
        ret;
      touch_contact_u_bad_state:
        mov rax, 0xFFFFEBAA;      // TC_UPDATE_BAD_STATE
        ret
      }
    }

  // ==========================================================================
  // SECTION 14 -- END: touch_contact_end(row_ptr)
  // ==========================================================================
  //
  // Sets state=UP (2) in the state word's byte [55:48], preserving
  // pos_y, pressure, and reserved. The row is freed by the input
  // server's next tick sweep (see NOVEL-CLEAN §3).
  //
  // Refuses on:
  //   * row_ptr == 0          -> TC_END_BAD_ROW
  //   * state already UP (2)  -> TC_END_ALREADY
  //
  // Signature: (row_ptr) -> u64
  pub let touch_contact_end : (u64) -> u64 !{mem} @{} =
    fn (row_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "B9-03 (#2283): transition state to UP (2). Reads the state word at [+16], isolates the state byte via shr 48 + and 0xFF (imm32 form; sign-extends 0x000000FF harmlessly), refuses TC_END_ALREADY if already 2. Otherwise clears bits [55:48] with a shl-then-not mask (mov r11,0xFF; shl r11,48; not r11 -> r11 = 0xFF00FFFFFFFFFFFF) then ORs in (2 << 48). Preserves pos_y, pressure, and reserved. No `and reg, imm64`, no MOVZX. Scratch: rax, r8, r10, r11. Labels prefixed touch_contact_e_.",
      block: {
        // Validate row_ptr nonzero.
        cmp rdi, 0;
        je  touch_contact_e_bad_row;

        // Load state word, isolate state byte.
        mov r8, [rdi + 16];
        mov r10, r8;
        shr r10, 48;
        and r10, 0xFF;
        cmp r10, 2;
        je  touch_contact_e_already;

        // Clear bits [55:48]. Build mask via mov 0xFF, shl 48, not.
        mov r11, 0xFF;
        shl r11, 48;              // r11 = 0x00FF000000000000
        not r11;                  // r11 = 0xFF00FFFFFFFFFFFF
        and r8, r11;

        // OR in (2 << 48).
        mov r11, 2;
        shl r11, 48;
        or  r8, r11;
        mov [rdi + 16], r8;

        xor rax, rax;             // TC_OK
        ret;

      touch_contact_e_bad_row:
        mov rax, 0xFFFFEBA7;      // TC_END_BAD_ROW
        ret;
      touch_contact_e_already:
        mov rax, 0xFFFFEBA6;      // TC_END_ALREADY
        ret
      }
    }

  // ==========================================================================
  // SECTION 15 -- RECOGNISER: touch_contact_recognise_gesture(array, count)
  // ==========================================================================
  //
  // Walks the caller-supplied array of TouchContact row pointers (up
  // to 10 entries) and classifies the aggregate into one GestureKind.
  //
  // First-pass classifier (this landing):
  //   count == 0 or > 10       -> GESTURE_TAP (fallback; the future
  //                                dispatcher gates the recogniser on
  //                                a nonzero count already so the
  //                                fallback is defensive)
  //   count == 1
  //       any contact in MOVE  -> GESTURE_PAN
  //       else                 -> GESTURE_TAP
  //   count == 2               -> GESTURE_PINCH
  //   count >= 3               -> GESTURE_SWIPE
  //
  // GESTURE_DOUBLE_TAP / GESTURE_LONG_PRESS / GESTURE_ROTATE emission
  // requires the first_seen_seq deltas that the tick handler will feed
  // in (G8-M4 follow-up); this landing establishes the walk shape and
  // the dispatch surface, not the timing analysis.
  //
  // Walk shape: for each of `count` entries at array[i]:
  //   * load ptr = [array + i*8] (implemented via a `add r8, 8` cursor
  //     to sidestep index*scale addressing)
  //   * null ptr -> skip
  //   * load state word at [ptr + 16], shr 48, and 0xFF -> state byte
  //   * if state == MOVE (1), bump the MOVE-count accumulator
  // No cross-device rejection in this first pass (the recogniser
  // metadata for that check needs the seat + device slots, wired in
  // the follow-up landing that adds a `walk_and_reject_cross_device`
  // helper).
  //
  // Signature: (array_ptr, count) -> u64 (GestureKind)
  pub let touch_contact_recognise_gesture : (u64, u64) -> u64 !{mem} @{} =
    fn (array_ptr: u64) (count: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "B9-03 (#2283): first-pass gesture classifier over an array of TouchContact row pointers. Sanity: count == 0 or count > 10 -> GESTURE_TAP fallback. Otherwise walks up to `count` entries: load ptr via `mov r11, [r8]` on a byte-cursor r8 bumped by 8 per iteration (no `mov r,[base+idx*scale]` needed, sidestepping any SIB scale-encoder concerns); null ptr entries are skipped. For each entry the state byte is isolated via `mov rax, [r11+16]; shr rax, 48; and rax, 0xFF` (imm32 AND, no MOVZX). MOVE (1) count accumulates in r10. Classification: count == 2 -> PINCH (4); count >= 3 -> SWIPE (6); count == 1 with any MOVE -> PAN (3), else TAP (0). GESTURE_DOUBLE_TAP / LONG_PRESS / ROTATE await the first_seen_seq deltas the tick handler feeds in the follow-up milestone. Scratch: rax, r8, r9, r10, r11. Labels prefixed touch_contact_rg_.",
      block: {
        // Sanity: count == 0 -> fallback TAP.
        cmp rsi, 0;
        je  touch_contact_rg_tap;
        // Sanity: count > 10 -> fallback TAP.
        cmp rsi, 10;
        ja  touch_contact_rg_tap;

        // Walk. r8 = cursor into array; r9 = remaining; r10 = MOVE count.
        mov r8, rdi;
        mov r9, rsi;
        xor r10, r10;

      touch_contact_rg_walk_top:
        cmp r9, 0;
        je  touch_contact_rg_walk_done;

        // Load pointer at current cursor.
        mov r11, [r8];
        cmp r11, 0;
        je  touch_contact_rg_walk_next;   // null -> skip

        // Load state word, isolate state byte.
        mov rax, [r11 + 16];
        shr rax, 48;
        and rax, 0xFF;
        cmp rax, 1;                       // MOVE?
        jne touch_contact_rg_walk_next;

        // Bump MOVE count.
        mov rax, r10;
        add rax, 1;
        mov r10, rax;

      touch_contact_rg_walk_next:
        // Bump cursor by 8 (pointer stride), decrement remaining.
        mov rax, r8;
        add rax, 8;
        mov r8, rax;
        mov rax, r9;
        sub rax, 1;
        mov r9, rax;
        jmp touch_contact_rg_walk_top;

      touch_contact_rg_walk_done:
        // Classification by (count, MOVE-count).
        cmp rsi, 3;
        jae touch_contact_rg_swipe;       // count >= 3 -> SWIPE
        cmp rsi, 2;
        je  touch_contact_rg_pinch;       // count == 2 -> PINCH
        // count == 1: PAN if any MOVE, else TAP.
        cmp r10, 0;
        jne touch_contact_rg_pan;
        // fall through to TAP.

      touch_contact_rg_tap:
        xor rax, rax;                     // GESTURE_TAP = 0
        ret;

      touch_contact_rg_pan:
        mov rax, 3;                       // GESTURE_PAN
        ret;

      touch_contact_rg_pinch:
        mov rax, 4;                       // GESTURE_PINCH
        ret;

      touch_contact_rg_swipe:
        mov rax, 6;                       // GESTURE_SWIPE
        ret
      }
    }

  // ==========================================================================
  // SECTION 16 -- QUERIES
  // ==========================================================================

  // touch_contact_state_byte(row_ptr) -> u64 (0..3 in low byte).
  // Reads the state word at [+16], shifts state byte down, masks to
  // the low 8 bits via imm32 AND. Used by the recogniser tick handler.
  pub let touch_contact_state_byte : (u64) -> u64 !{mem} @{} =
    fn (row_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "B9-03 (#2283): read the state byte from the state word ([+16], bits [55:48]). One load, one shr 48, one and 0xFF (imm32 form; no MOVZX), one ret. Labels prefixed touch_contact_sb_ (none needed, straight-line).",
      block: {
        mov rax, [rdi + 16];
        shr rax, 48;
        and rax, 0xFF;
        ret
      }
    }

  // touch_contact_pressure_word(row_ptr) -> u64 (u16 pressure in low bits).
  pub let touch_contact_pressure_word : (u64) -> u64 !{mem} @{} =
    fn (row_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "B9-03 (#2283): read the pressure u16 from the state word ([+16], bits [47:32]). Load, shl 16 / shr 48 net-shift-right 32 with high bits above 16 cleared. No MOVZX. Labels prefixed touch_contact_pw_ (none needed, straight-line).",
      block: {
        mov rax, [rdi + 16];
        shl rax, 16;              // drops the top 16 bits (state + reserved)
        shr rax, 48;              // net right-shift 32, mask to low 16
        ret
      }
    }

  // touch_contact_pos_x(row_ptr) -> u64 (i32 sign-extended in rax).
  // Reads the high 32 of ids1 ([+8]) via sar 32 to preserve sign.
  pub let touch_contact_pos_x : (u64) -> u64 !{mem} @{} =
    fn (row_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "B9-03 (#2283): read i32 pos_x from ids1[63:32]. One load, one sar 32 (arithmetic shift preserves sign). Labels prefixed touch_contact_px_ (none needed, straight-line).",
      block: {
        mov rax, [rdi + 8];
        sar rax, 32;
        ret
      }
    }

  // touch_contact_pos_y(row_ptr) -> u64 (i32 sign-extended in rax).
  // Reads the low 32 of state ([+16]) via shl 32 / sar 32.
  pub let touch_contact_pos_y : (u64) -> u64 !{mem} @{} =
    fn (row_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "B9-03 (#2283): read i32 pos_y from the state word's low 32 bits ([+16], bits [31:0]). Load, shl 32 (kill high bits), sar 32 (sign-extend from bit 31). Labels prefixed touch_contact_py_ (none needed, straight-line).",
      block: {
        mov rax, [rdi + 16];
        shl rax, 32;
        sar rax, 32;
        ret
      }
    }

  // touch_contact_seat(row_ptr) -> u64 (u32 seat_kind_id in low 32).
  pub let touch_contact_seat : (u64) -> u64 !{mem} @{} =
    fn (row_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "B9-03 (#2283): read seat_kind_id from ids0[63:32]. One load, one shr 32. Labels prefixed touch_contact_seat_ (none needed, straight-line).",
      block: {
        mov rax, [rdi + 0];
        shr rax, 32;
        ret
      }
    }

  // touch_contact_device(row_ptr) -> u64 (u32 device_kind_id in low 32).
  pub let touch_contact_device : (u64) -> u64 !{mem} @{} =
    fn (row_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "B9-03 (#2283): read touch_device_kind_id from ids1[31:0]. Load, shl 32 / shr 32 to mask to low 32. Labels prefixed touch_contact_dev_ (none needed, straight-line).",
      block: {
        mov rax, [rdi + 8];
        shl rax, 32;
        shr rax, 32;
        ret
      }
    }

  // touch_contact_first_seen_seq(row_ptr) -> u64.
  pub let touch_contact_first_seen_seq : (u64) -> u64 !{mem} @{} =
    fn (row_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "B9-03 (#2283): read first_seen_seq from [+24]. One load, one ret. Labels prefixed touch_contact_fs_ (none needed, straight-line).",
      block: {
        mov rax, [rdi + 24];
        ret
      }
    }
}
