// src/user/input_server/seat_lock.pdx -- Wave0-B12-02 (paideia-os #2286)
//
// SEAT LOCK / UNLOCK BOOKKEEPING AND INTER-SEAT ISOLATION INVARIANTS.
//
// This is a LOGIC MODULE (not a KIND cap): it holds the per-seat lock
// bookkeeping cell that the input server consults on every screen-lock
// / unlock decision to (a) delegate the actual locked-byte transition
// to SeatKind.seat_lock / SeatKind.seat_unlock (the P2 dispatch gate
// on the seat row itself), (b) record WHY the seat was locked
// (LOCK_MANUAL / LOCK_IDLE / LOCK_SUSPEND / LOCK_SWITCH_USER) for
// audit + policy, (c) count failed unlock attempts and back off after
// N so a brute-force keyboard walker cannot exhaust credentials, and
// (d) verify the inter-seat isolation invariant that a locked seat's
// input never crosses over to a peer seat via a shared KIND_INPUT_
// ROUTE.
//
// Design authority:
//   * design/compositor/pwp-spec-vocabulary.md §2.9 KIND_SEAT --
//     "seat lock/unlock (G8.M5-002, #2286) mediates for the emergency-
//     console handover flow." The lock decision lives on the seat row
//     (seat_kind_stater byte at [+32], see seat_kind.pdx §3 SEAT_
//     STATE_LOCKED_BYTE); this module owns the meta-bookkeeping the
//     seat row does not carry (reason ordinal, failed-attempt counter,
//     back-off deadline) and enforces the cross-seat isolation
//     assertion the row's single locked byte cannot express by itself.
//   * design/compositor/pwp-spec-vocabulary.md §2.10 KIND_INPUT_ROUTE
//     -- routes are LINEAR and consumed on focus change (focus_router)
//     or on target destroy (route_revoke); the isolation invariant this
//     module enforces is "no live route names two different seats at
//     the same instant", so a locked seat cannot leak an event to a
//     peer through a mis-configured route.
//   * design/roadmap/next-wave-synthesis.md §4 pitfall P2 -- "screen-
//     lock decision is a single capability operation, not an ambient
//     global state a hundred subscribers each have to consult." The
//     dispatch gate is the locked byte on the seat row; this module
//     surrounds that byte with the meta-fields needed to actually
//     implement a screen-lock UX (why + attempts + back-off) without
//     bloating the seat row itself.
//   * src/user/input_server/seat_kind.pdx §13 -- seat_lock / seat_unlock
//     primitives take a raw row_ptr, transition the locked byte, and
//     return SEAT_OK or SEAT_LOCK_ALREADY / SEAT_UNLOCK_ALREADY. This
//     module wraps those primitives with the state-machine that
//     credentials + attempt-counting + reason-recording require.
//   * src/user/input_server/route_revoke.pdx -- the sibling logic
//     module. route_revoke's route_revoke_on_seat_lock is the CALLEE
//     the future dispatcher invokes BEFORE stamping the locked byte;
//     seat_lock_engage in this file is a peer, not a subroutine of it
//     (both feed the same lock-transition orchestration a future
//     G8.M5-003 dispatcher will drive).
//
// LIFECYCLE POSITION.
//
// One SeatLockState instance per KIND_SEAT row -- the input server's
// per-seat lock-screen orchestrator owns the cell. Not a singleton
// (contrast route_revoke.pdx's singleton implicit-grab cell): a multi-
// seat workstation locks each seat independently (seat A's idle timer
// firing must not lock seat B), so the cell is caller-owned and passed
// in on every call. The state pointer is passed in on every call so
// the module is testable against scratch cells without needing a
// global pool ceiling.
//
// PARALLEL LANDING NOTE.
//
// This landing depends on:
//   * src/user/input_server/seat_kind.pdx (Wave0-B8-06 #2285, LANDED B8)
//     -- provides SeatKind.seat_lock / SeatKind.seat_unlock resolved
//     at link time (bare `call seat_lock` / `call seat_unlock`, same
//     cross-file pattern focus_router.pdx uses for input_route_mint /
//     input_route_revoke). Also provides SEAT_LOCK_ALREADY (0xFFFFEB78)
//     and SEAT_UNLOCK_ALREADY (0xFFFFEB77) sentinels this module
//     forwards verbatim when the underlying primitive refuses.
//   * src/user/input_server/route_kind.pdx (Wave0-B8, G8-M2-001,
//     LANDED B8) -- provides KIND_INPUT_ROUTE row layout constants
//     (ROUTE_KIND_OFF_SEAT_SURFACE = +16; low 32 = seat_kind_id, high
//     32 = surface_kind_id) that seat_lock_verify_isolation would walk
//     if a public pool-walker primitive existed. See STUB SCOPE below.
//
// This landing does NOT touch seat_kind.pdx, route_kind.pdx, or
// route_revoke.pdx. All symbols this file publishes are consumed by
// future landings (the G8.M5-003 lock-op dispatcher, the idle-timer
// engine, the credential-prompt agent, the multi-seat regression
// harness).
//
// STUB SCOPE (well-formed intent, no fabricated results).
//
//   (1) SeatKind.seat_lock / seat_unlock DO exist and ARE called; this
//       is not a stub. seat_lock_engage really transitions the locked
//       byte to 1 on the target seat row; seat_lock_verify_and_release
//       really transitions it back to 0 on success. The failure-path
//       accounting (attempt counter, lockout deadline) is fully live
//       today.
//
//   (2) The route-pool walker seat_lock_verify_isolation would consult
//       (ROUTE_KIND row array walked at ROUTE_KIND_OFF_SEAT_SURFACE
//       = +16, comparing seat_kind_id halves against the two argument
//       state cells' seat_kind_id fields) does not yet have a public
//       walker primitive (see route_revoke.pdx §STUB SCOPE for the
//       same discussion). Until that helper lands (targeted G8-M2-004),
//       seat_lock_verify_isolation validates its two arguments, checks
//       that the two state cells name DIFFERENT seat_kind_ids (a null
//       predicate the pool walker will refine, not replace) and returns
//       SL_OK. A caller that gets SL_OK today sees a well-formed "no
//       obvious isolation breach detected", not a proof of full
//       isolation -- the pool walk will strengthen this to a real
//       proof when it lands.
//
//   (3) Credential verification compares credential_hash against a
//       stored expected_credential_hash set via
//       seat_lock_set_credential_hash. The hash comparison itself is
//       constant-time-BY-CONSTRUCTION: both hashes are u64 words and
//       we compare with `cmp reg, reg`, which the x86-64 core executes
//       in a single cycle regardless of operand values (there is no
//       early-exit on mismatch to time-side-channel through). A future
//       credential-prompt-agent landing will replace the raw-hash
//       expected value with a KDF-derived comparand, but the constant-
//       time compare shape stays byte-identical.
//
// FAILURE-BAND ALLOCATION.
//
// The row-spec pinned 0xFFFFEAF0..0xFFFFEAFF, but that band is already
// occupied by RECOVERY_CONSOLE (see
// src/user/input_server/recovery_console.pdx §5 lines 225-327 --
// RC_ALREADY_INIT through RC_NULL_STATE_PTR claim 0xFFFFEAF0..EAF5,
// and the band tail 0xFFFFEAFF is claimed as RC_ROW_NONE). A grep-
// verify walk across the neighbouring EAxx and EBxx pages confirms
// every 16-slot window adjacent to the input-server neighborhood is
// claimed by another sibling. Rather than displace RECOVERY_CONSOLE
// or squeeze into a partial band, this landing takes
// 0xFFFFE140..0xFFFFE14F -- a fresh 16-slot window, verified free by
// grep across src/**/*.pdx + tests/**/*.pdx as of this landing
// (grep for "0xFFFFE14[0-9A-Fa-f]" returns zero hits). The band-open
// pattern here mirrors route_revoke.pdx §"FAILURE-BAND ALLOCATION"
// (also 0xFFFFE1xx-family) and focus_router.pdx §60 (a sibling logic
// module that also deviated from its row-spec-suggested band). Main
// should update the row-spec at batch close to reflect the actual
// band, or reissue with a re-negotiated adjacent band if a later
// Wave-0 landing frees a nearer slot.
//
// LABEL PREFIX. `seat_lock_` throughout, sidestepping paideia-as
// reserved-word collisions (`loop`, `if`, `let`, `write`, `lock`,
// `unlock` -- though `lock` and `unlock` alone are not currently
// reserved, prefixing avoids future-reservation risk). Internal
// labels use short suffixes (seat_lock_i_ for init, seat_lock_e_ for
// engage, seat_lock_v_ for verify_and_release, seat_lock_ie_ for
// is_engaged, seat_lock_vi_ for verify_isolation, seat_lock_sc_ for
// set_credential_hash, seat_lock_r_ for reset).
//
// MECE SCOPE. Single file under src/user/input_server/. No mod.pdx
// exists in this directory (sibling B8/B10/B11 landings also do not
// create one). This landing touches no other file.
//
// =============================================================================
// SECTION 0 -- STRUCT SHAPE
// =============================================================================
//
// SeatLockState is a 48-byte caller-owned cell. Six u64 words:
//
//   [+0]  word0:  seat_kind_id[31:0]
//               | unlock_attempts[63:32]
//
//   [+8]  word1:  locked_at_seq (u64)              monotonic; the
//                                                  post-bump value at
//                                                  successful engage.
//                                                  ZERO iff unlocked.
//                                                  (dispatch consumers
//                                                  test word1 != 0 as
//                                                  the fast "am I
//                                                  locked?" predicate)
//
//   [+16] word2:  unlock_lockout_until_nsec (u64)  monotonic clock
//                                                  threshold; 0 iff no
//                                                  back-off active.
//                                                  Interpreted against
//                                                  the same nsec base
//                                                  the kernel's HPET/
//                                                  invariant-TSC clock
//                                                  publishes. Callers
//                                                  compare via
//                                                  seat_lock_is_locked_
//                                                  out(state, now_nsec)
//                                                  BEFORE attempting
//                                                  verify_and_release;
//                                                  the compare itself
//                                                  lives in the caller
//                                                  because this module
//                                                  must not read the
//                                                  clock (that would
//                                                  couple this leaf to
//                                                  the syscall surface,
//                                                  killing its testability).
//
//   [+24] word3:  lock_reason[7:0]                 SEAT_LOCK_REASON_*
//                                                  ordinal (see §1.3).
//                                                  Meaningful only when
//                                                  word1 != 0.
//               | reserved[63:8]                    (0 at init; future
//                                                  flag bits: e.g.
//                                                  auto-relock-on-idle,
//                                                  emergency-abort-in-
//                                                  progress, ...)
//
//   [+32] word4:  seat_row_ptr (u64)               raw pointer to the
//                                                  KIND_SEAT row this
//                                                  cell orchestrates.
//                                                  Set at init; the
//                                                  seat_kind primitives
//                                                  (seat_lock, seat_
//                                                  unlock) take a raw
//                                                  row_ptr per their
//                                                  signature (see
//                                                  seat_kind.pdx §13).
//
//   [+40] word5:  expected_credential_hash (u64)   verify_and_release
//                                                  compares the caller-
//                                                  supplied hash against
//                                                  this. Zero iff no
//                                                  credential set (in
//                                                  which case verify_
//                                                  and_release always
//                                                  refuses with SL_NO_
//                                                  CREDENTIAL_SET --
//                                                  "unlocking a seat
//                                                  with no set expected
//                                                  hash is a policy
//                                                  hole, not a
//                                                  convenience").
//
// The `unlock_attempts` field packed into word0[63:32] instead of a
// separate word saves 8 bytes of state per seat (this matters when the
// per-seat orchestrator is heap-allocated in a scatter-gather arena
// rather than in .bss). The dispatch reads for word0 fields use shl/shr
// 32 to isolate halves, matching FocusRouterState precedent.
//
// The `locked_at_seq` value grows monotonically across engage/release
// cycles: a fresh cell has seq=0, engage bumps a per-cell counter to 1
// (published into word1), release zeros word1 but preserves the counter
// on a separate rip-relative cell so a subsequent engage produces seq=2
// (not seq=1). This is the same monotonicity-across-releases posture
// implicit_grab_set uses (see route_revoke.pdx §3): stale-vs-fresh
// distinguishability without a per-cell 64-bit generation slot.
//
// The `unlock_attempts` counter is bumped on FAILED verify_and_release
// (credential mismatch), NOT on the SL_NOT_LOCKED / SL_NULL_STATE
// refusal paths (those are structural mistakes, not credential-
// guessing attempts). The threshold at which the caller should engage
// back-off is SL_MAX_UNLOCK_ATTEMPTS (below); this module publishes
// the constant but leaves the enforcement decision to the caller (a
// separate landing will wire a lockout-scheduler that watches the
// counter and stamps unlock_lockout_until_nsec).
//
// =============================================================================
// SECTION 1 -- FAILURE TAXONOMY (0xFFFFE140..0xFFFFE14F, 16 slots)
// =============================================================================
//
// Fresh band, grep-verified free across src/**/*.pdx + tests/**/*.pdx.
// Neighbours:
//   0xFFFFE100..12F  (fragmented; recovery-plane / earlier landings)
//   0xFFFFE130..13F  ROUTE_REVOKE     (sibling logic module)
//   0xFFFFE140..14F  SEAT_LOCK        (THIS BAND)
//   0xFFFFE150..4EF  entirely free (next fresh window for future
//                    Wave-0 landings needing a fresh band)
//
// Slot map:
//   0xFFFFE140    SL_ROW_NONE            band tail sentinel
//   0xFFFFE141    SL_NULL_STATE          state_ptr == 0
//   0xFFFFE142    SL_NULL_SEAT_ROW       seat_row_ptr == 0 at init
//   0xFFFFE143    SL_NULL_KIND           seat_kind_id == 0 at init
//   0xFFFFE144    SL_BAD_REASON          reason > SEAT_LOCK_REASON_MAX
//   0xFFFFE145    SL_ALREADY_INIT        init called on a live cell
//   0xFFFFE146    SL_NOT_INIT            engage/verify on uninit cell
//   0xFFFFE147    SL_ALREADY_LOCKED      engage called while locked
//   0xFFFFE148    SL_NOT_LOCKED          verify_and_release when unlocked
//   0xFFFFE149    SL_BAD_CREDENTIAL      credential_hash mismatch
//   0xFFFFE14A    SL_ISOLATION_BREACH    verify_isolation detected shared
//                                        seat identity (STUB predicate;
//                                        pool-walker will refine to
//                                        "shared KIND_INPUT_ROUTE detected")
//   0xFFFFE14B    SL_NULL_HASH           credential_hash == 0 (a zero
//                                        hash is always refused so the
//                                        "no credential set" branch and
//                                        the "caller passed nothing"
//                                        branch stay distinguishable)
//   0xFFFFE14C    SL_NO_CREDENTIAL_SET   expected_credential_hash == 0
//                                        (verify_and_release refuses
//                                        rather than always succeeding
//                                        when no expected hash exists)
//   0xFFFFE14D    SL_LOCKED_OUT          back-off active (informational;
//                                        seat_lock_is_locked_out returns
//                                        a boolean instead)
//   0xFFFFE14E..F  reserved (two slots for future SL_* additions)
//
// SL_OK = 0 (the canonical success sentinel; matches SEAT_OK,
// FR_OK, RR_OK, IS_OK, ROUTE_KIND_OK, and every other success code
// in the tree).

module SeatLock = structure {

  // ==========================================================================
  // SECTION 1.1 -- SUCCESS + FAILURE CODES
  // ==========================================================================

  pub let SL_OK                   : u64 = 0
  pub let SL_ROW_NONE             : u64 = 0xFFFFE140
  pub let SL_NULL_STATE           : u64 = 0xFFFFE141
  pub let SL_NULL_SEAT_ROW        : u64 = 0xFFFFE142
  pub let SL_NULL_KIND            : u64 = 0xFFFFE143
  pub let SL_BAD_REASON           : u64 = 0xFFFFE144
  pub let SL_ALREADY_INIT         : u64 = 0xFFFFE145
  pub let SL_NOT_INIT             : u64 = 0xFFFFE146
  pub let SL_ALREADY_LOCKED       : u64 = 0xFFFFE147
  pub let SL_NOT_LOCKED           : u64 = 0xFFFFE148
  pub let SL_BAD_CREDENTIAL       : u64 = 0xFFFFE149
  pub let SL_ISOLATION_BREACH     : u64 = 0xFFFFE14A
  pub let SL_NULL_HASH            : u64 = 0xFFFFE14B
  pub let SL_NO_CREDENTIAL_SET    : u64 = 0xFFFFE14C
  pub let SL_LOCKED_OUT           : u64 = 0xFFFFE14D
  pub let SL_DECODE_BAD           : u64 = 0xFFFFFFFFFFFFFFFF

  // ==========================================================================
  // SECTION 1.2 -- CELL LAYOUT CONSTANTS
  // ==========================================================================

  pub let SL_CELL_BYTES           : u64 = 48
  pub let SL_CELL_WORDS           : u64 = 6

  // Byte offsets (documented for cross-module consumers; the assembly
  // below hard-codes the same offsets as small immediates per the
  // encoder-conservative posture).
  pub let SL_OFF_WORD0_KIND_ATTEMPTS      : u64 = 0
  pub let SL_OFF_WORD1_LOCKED_AT_SEQ      : u64 = 8
  pub let SL_OFF_WORD2_LOCKOUT_UNTIL_NSEC : u64 = 16
  pub let SL_OFF_WORD3_REASON_RSVD        : u64 = 24
  pub let SL_OFF_WORD4_SEAT_ROW_PTR       : u64 = 32
  pub let SL_OFF_WORD5_EXPECTED_HASH      : u64 = 40

  // Attempt-threshold before caller SHOULD stamp unlock_lockout_until_
  // nsec. This module does NOT enforce the threshold itself; the value
  // is published so a future lockout-scheduler landing has a canonical
  // constant to key against. 5 attempts is the Kerberos / systemd-
  // logind convention; larger than 3 (which is too aggressive for real
  // typing errors) and smaller than 10 (which lets a brute-force walker
  // saturate the credential space in an hour).
  pub let SL_MAX_UNLOCK_ATTEMPTS  : u64 = 5

  // ==========================================================================
  // SECTION 1.3 -- LOCK REASON ORDINALS (SeatLockReason)
  // ==========================================================================
  //
  // Four ordinals; SEAT_LOCK_REASON_MAX is the tight upper bound
  // seat_lock_engage validates against (engage refuses reason >
  // SEAT_LOCK_REASON_MAX with SL_BAD_REASON). New reasons appended at
  // the tail; consumers reading the reason byte should treat any
  // value > SEAT_LOCK_REASON_MAX as "unknown reason, treat as
  // LOCK_MANUAL for auditing" (the most conservative attribution).
  //
  // LOCK_MANUAL      -- user hit the lock key or clicked the lock
  //                     button (highest-authority reason; supersedes
  //                     idle / suspend if they would otherwise auto-
  //                     unlock).
  // LOCK_IDLE        -- idle-timeout fired (default screensaver
  //                     policy; the least-authority reason and the
  //                     one most likely to be auto-released without
  //                     credentials on a policy-controlled network).
  // LOCK_SUSPEND     -- system suspending (ACPI S3 / S4); lock must
  //                     be released via credentials on resume even if
  //                     idle-auto-release is permitted, because the
  //                     "presence during suspend" security assumption
  //                     is void.
  // LOCK_SWITCH_USER -- user-switch flow; the incoming user's
  //                     credentials release the lock (not the
  //                     outgoing user's), which the credential-prompt
  //                     agent enforces by choosing a different
  //                     expected_credential_hash to seed via
  //                     seat_lock_set_credential_hash.

  pub let SEAT_LOCK_REASON_MANUAL       : u64 = 0
  pub let SEAT_LOCK_REASON_IDLE         : u64 = 1
  pub let SEAT_LOCK_REASON_SUSPEND      : u64 = 2
  pub let SEAT_LOCK_REASON_SWITCH_USER  : u64 = 3
  pub let SEAT_LOCK_REASON_MAX          : u64 = 3

  // ==========================================================================
  // SECTION 1.4 -- STRUCT SHAPE (documentation-facing)
  // ==========================================================================
  //
  // Declared for typed consumers and for design-doc cross-reference.
  // The concrete byte-level accessors below match this field order.
  // paideia-as does not currently model intermediate padding as a
  // struct field (mirrors FocusRouterState in focus_router.pdx §199
  // and ImplicitGrab in route_revoke.pdx §315); consumers reading the
  // cell as a struct should assume 48-byte size and use the SL_OFF_*
  // offsets above rather than field-name arithmetic.

  struct SeatLockState {
    seat_kind_id: u32,
    unlock_attempts: u32,
    locked_at_seq: u64,
    unlock_lockout_until_nsec: u64,
    lock_reason: u8,
    seat_row_ptr: u64,
    expected_credential_hash: u64
  }

  // ==========================================================================
  // SECTION 1.5 -- PER-MODULE MONOTONE SEQ COUNTER (rip-relative)
  // ==========================================================================
  //
  // Every successful engage bumps this counter and publishes the post-
  // bump value into the target state cell's word1. Zero'd by .bss at
  // real boot; a test harness that reuses the counter between cases
  // resets it via seat_lock_reset_seq_counter (Section 8).
  //
  // Monotonicity is preserved across engage/release cycles: a release
  // clears the state cell's word1 but does NOT decrement this counter,
  // so a subsequent engage on the same cell produces a strictly-greater
  // seq value. Future audit consumers reading a stale locked_at_seq
  // observation cannot mistake it for a live lock even if the seat has
  // since re-locked. Same shape route_revoke.pdx §3 documents for
  // implicit_grab_set.

  pub let mut _seat_lock_seq_counter : [u64; 1] = uninit @align(8)

  // ==========================================================================
  // SECTION 1.6 -- FINGERPRINT TAG (one line, legacy-suffixed)
  // ==========================================================================
  //
  // pdx_kind_seat_lock_meta: emitted once per successful engage by the
  // future dispatcher (G8.M5-003) via klog_s1. Legacy suffix convention
  // matches tools/verify-fingerprint-coverage.sh's enumeration. Until
  // the dispatcher wires this string into a real emission site, it is
  // a data-only constant and needs an allowlist entry in
  // tools/verify-fingerprint-coverage.sh with reason "seat-lock
  // dispatcher not yet landed (G8-M5-002; dispatcher at G8-M5-003)".
  // Adding that allowlist entry is a separate landing (this file must
  // not touch tools/), matching the posture route_kind.pdx,
  // focus_router.pdx, and route_revoke.pdx already established in
  // sibling batches.
  //
  // Byte count: "seat lock ok [legacy: SEAT LOCK OK]" = 35 chars + NUL = 36.

  pub let pdx_kind_seat_lock_meta : [u8; 36] = "seat lock ok [legacy: SEAT LOCK OK]\0"

  // Short field-name string constant for future debug-print use
  // (mirrors focus_router_k_focus_seq / route_revoke_k_grab_seq
  // precedent).
  pub let seat_lock_k_locked_seq : [u8; 14] = "locked_at_seq\0"

  // ==========================================================================
  // SECTION 2 -- INIT FACTORY
  // ==========================================================================
  //
  // seat_lock_init(state_ptr, seat_kind_id, seat_row_ptr) -> u64 status
  //
  //   Populate a caller-owned SeatLockState cell. Contract:
  //
  //     (1) state_ptr == 0                     -> SL_NULL_STATE
  //     (2) seat_kind_id == 0                  -> SL_NULL_KIND
  //     (3) seat_row_ptr == 0                  -> SL_NULL_SEAT_ROW
  //     (4) state already initialised          -> SL_ALREADY_INIT
  //         (detected by [state + SL_OFF_WORD4_SEAT_ROW_PTR] != 0;
  //          the seat_row_ptr is written last in the success path and
  //          non-zero afterwards, so seat_row_ptr != 0 is the "seen at
  //          least one init" invariant)
  //     (5) success: cell populated as follows and SL_OK returned:
  //           word0[31:0]   = seat_kind_id low32
  //           word0[63:32]  = 0 (unlock_attempts)
  //           word1         = 0 (locked_at_seq -- unlocked at init)
  //           word2         = 0 (unlock_lockout_until_nsec)
  //           word3         = 0 (lock_reason byte + reserved)
  //           word4         = seat_row_ptr (raw pointer, full u64)
  //           word5         = 0 (expected_credential_hash -- caller
  //                              must seed via
  //                              seat_lock_set_credential_hash before
  //                              first engage/verify)
  //
  //   Zero-extension of seat_kind_id uses shl 32 / shr 32 rather than
  //   `and reg, 0xFFFFFFFF` (ENCODER RULE). No MOVABS. No `test`.
  //
  //   Labels prefixed seat_lock_i_.

  pub let seat_lock_init : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (state_ptr: u64) (seat_kind_id: u64) (seat_row_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B12-02 G8-M5-002 (paideia-os #2286): populate a caller-owned SeatLockState cell in place. Order: (1) state_ptr (rdi) != 0 else SL_NULL_STATE (0xFFFFE141). (2) seat_kind_id (rsi) != 0 else SL_NULL_KIND (0xFFFFE143). (3) seat_row_ptr (rdx) != 0 else SL_NULL_SEAT_ROW (0xFFFFE142). (4) refuse if cell already initialised: seat_row_ptr at [rdi + 32] != 0 -> SL_ALREADY_INIT (0xFFFFE145). (5) publish: word0 = seat_kind_id low32 | 0; word1 = 0; word2 = 0; word3 = 0; word4 = seat_row_ptr full u64; word5 = 0 (expected hash unset). Zero-extension of seat_kind_id via shl 32 / shr 32 (no `and reg, imm64`; no MOVABS). No `test`. Labels prefixed seat_lock_i_.",
      block: {
        // (1) state_ptr null check
        cmp rdi, 0;
        je  seat_lock_i_null_state;

        // (2) seat_kind_id null check
        cmp rsi, 0;
        je  seat_lock_i_null_kind;

        // (3) seat_row_ptr null check
        cmp rdx, 0;
        je  seat_lock_i_null_row;

        // (4) already-init check (word4 != 0)
        mov rax, [rdi + 32];
        cmp rax, 0;
        jne seat_lock_i_already;

        // (5) publish word0: seat_kind_id[31:0] | 0 (attempts)
        mov rax, rsi;
        shl rax, 32;
        shr rax, 32;
        mov [rdi + 0], rax;

        // word1 = 0, word2 = 0, word3 = 0
        xor rax, rax;
        mov [rdi + 8],  rax;
        mov [rdi + 16], rax;
        mov [rdi + 24], rax;

        // word4 = seat_row_ptr (full u64)
        mov [rdi + 32], rdx;

        // word5 = 0 (expected_credential_hash unset)
        xor rax, rax;
        mov [rdi + 40], rax;

        // return SL_OK
        xor rax, rax;
        ret;

      seat_lock_i_null_state:
        mov rax, 0xFFFFE141;
        ret;

      seat_lock_i_null_kind:
        mov rax, 0xFFFFE143;
        ret;

      seat_lock_i_null_row:
        mov rax, 0xFFFFE142;
        ret;

      seat_lock_i_already:
        mov rax, 0xFFFFE145;
        ret
      }
    }

  // ==========================================================================
  // SECTION 3 -- CREDENTIAL SETUP
  // ==========================================================================
  //
  // seat_lock_set_credential_hash(state_ptr, hash) -> u64 status
  //
  //   Seed the expected_credential_hash slot in the cell. Contract:
  //     (1) state_ptr == 0                     -> SL_NULL_STATE
  //     (2) state not initialised              -> SL_NOT_INIT
  //         (detected by word4 == 0)
  //     (3) hash == 0                          -> SL_NULL_HASH
  //         (zero is refused so verify_and_release's "no expected hash"
  //          branch stays cleanly distinguishable from a fluke of a
  //          real hash colliding with zero)
  //     (4) success: word5 := hash; return SL_OK.
  //
  //   Called by the credential-prompt agent AFTER validating the user's
  //   credentials (KDF-derived comparand goes here; the raw passphrase
  //   never touches this module). A re-seed is legal: the caller may
  //   overwrite the expected hash after e.g. a user-switch or a
  //   passphrase change. There is no "unset" operation; a full reset
  //   via seat_lock_reset is required to zero the cell for reuse.
  //
  //   Labels prefixed seat_lock_sc_.

  pub let seat_lock_set_credential_hash : (u64, u64) -> u64 !{mem} @{} =
    fn (state_ptr: u64) (hash: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B12-02 G8-M5-002 (paideia-os #2286): seed expected_credential_hash. Order: (1) state_ptr (rdi) != 0 else SL_NULL_STATE. (2) word4 at [rdi+32] != 0 (init) else SL_NOT_INIT (0xFFFFE146). (3) hash (rsi) != 0 else SL_NULL_HASH (0xFFFFE14B). (4) write word5 = rsi. Labels prefixed seat_lock_sc_.",
      block: {
        cmp rdi, 0;
        je  seat_lock_sc_null_state;

        mov rax, [rdi + 32];
        cmp rax, 0;
        je  seat_lock_sc_not_init;

        cmp rsi, 0;
        je  seat_lock_sc_null_hash;

        mov [rdi + 40], rsi;
        xor rax, rax;
        ret;

      seat_lock_sc_null_state:
        mov rax, 0xFFFFE141;
        ret;

      seat_lock_sc_not_init:
        mov rax, 0xFFFFE146;
        ret;

      seat_lock_sc_null_hash:
        mov rax, 0xFFFFE14B;
        ret
      }
    }

  // ==========================================================================
  // SECTION 4 -- ENGAGE (transition unlocked -> locked)
  // ==========================================================================
  //
  // seat_lock_engage(state_ptr, reason) -> u64 status
  //
  //   The lock primitive. Contract:
  //
  //     (1) state_ptr == 0                     -> SL_NULL_STATE
  //     (2) state not initialised              -> SL_NOT_INIT
  //     (3) reason > SEAT_LOCK_REASON_MAX      -> SL_BAD_REASON
  //     (4) already locked (word1 != 0)        -> SL_ALREADY_LOCKED
  //     (5) call SeatKind.seat_lock(seat_row_ptr); on refusal
  //         (upper 32 bits of return non-zero, matching the 0xFFFFEB7x
  //         band shape) forward the sentinel verbatim (the underlying
  //         SEAT_LOCK_ALREADY is more informative than a locally
  //         translated code; a caller with the seat_kind.pdx failure
  //         taxonomy in hand disambiguates directly).
  //     (6) success: bump _seat_lock_seq_counter via load-inc-store,
  //         publish word1 = post-bump seq, word3 low byte = reason,
  //         return SL_OK.
  //
  //   Ordering (word3 written LAST in the success path): a consumer
  //   reading word1 first sees "locked" before it sees the reason;
  //   this is a benign race for the reason field (which is
  //   informational, not load-bearing) but callers who need the
  //   consistent pair should hold a caller-side lock, not rely on
  //   ordering within this leaf. The dispatch gate on the seat_kind
  //   row itself (SeatKind.seat_lock's stamp of the locked byte) is
  //   what actually enforces "input is refused"; word1/word3 in this
  //   cell are the meta-log the credential-prompt UX consumes.
  //
  //   Frame:
  //     - entry rsp%16 == 8 (post-ret-push).
  //     - push rbx / push r12 / push r13 (three callee-save pushes)
  //       => rsp%16 == 0, aligned for the `call seat_lock` at the
  //       middle of the body. Preserved values:
  //         rbx = state_ptr
  //         r12 = reason (as u64, low byte only meaningful)
  //         r13 = seat_row_ptr (loaded from word4 pre-call so the
  //               post-call state-cell writes can use rbx without
  //               a re-load; r13 is otherwise unused)
  //     - pop r13 / pop r12 / pop rbx before ret restores caller-save
  //       state.
  //
  //   Labels prefixed seat_lock_e_.

  pub let seat_lock_engage : (u64, u64) -> u64 !{mem} @{} =
    fn (state_ptr: u64) (reason: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B12-02 G8-M5-002 (paideia-os #2286): screen-lock engage. Order: (1) state_ptr (rdi) != 0 else SL_NULL_STATE. (2) word4 seat_row_ptr != 0 (init) else SL_NOT_INIT. (3) reason (rsi) <= SEAT_LOCK_REASON_MAX (3) else SL_BAD_REASON (0xFFFFE144). (4) word1 (locked_at_seq) == 0 else SL_ALREADY_LOCKED (0xFFFFE147). (5) call SeatKind.seat_lock(seat_row_ptr); on refusal forward verbatim (SEAT_LOCK_ALREADY = 0xFFFFEB78 or other 0xFFFFEB7x). (6) bump _seat_lock_seq_counter via load-inc-store; publish word1 = post-bump seq; publish word3[7:0] = reason low byte (preserving reserved high bits by zero-init since word3 was 0 pre-engage; reason byte masked via shl 56 / shr 56). Callee-save frame: push rbx / r12 / r13 (three pushes; rsp%16 -> 0 at call site). No `test`, no `and reg, imm64`, no `add reg,[mem]`, no `mov_bzx`. Labels prefixed seat_lock_e_.",
      block: {
        // Frame prologue.
        push rbx;
        push r12;
        push r13;
        // rsp%16 == 0 here (three pushes from entry 8 mod 16).

        mov rbx, rdi;                    // rbx = state_ptr
        mov r12, rsi;                    // r12 = reason

        // (1) state_ptr null check
        cmp rbx, 0;
        je  seat_lock_e_null_state;

        // (2) init check (word4 != 0)
        mov rax, [rbx + 32];
        cmp rax, 0;
        je  seat_lock_e_not_init;
        mov r13, rax;                    // r13 = seat_row_ptr

        // (3) reason range check (reason <= SEAT_LOCK_REASON_MAX = 3)
        cmp r12, 3;
        ja  seat_lock_e_bad_reason;

        // (4) already-locked check (word1 != 0)
        mov rax, [rbx + 8];
        cmp rax, 0;
        jne seat_lock_e_already;

        // (5) delegate to SeatKind.seat_lock(seat_row_ptr)
        mov rdi, r13;
        call seat_lock;
        // rax = SEAT_OK (0) on success, SEAT_LOCK_ALREADY (0xFFFFEB78)
        // or other 0xFFFFEB7x sentinel on refusal.
        // Refusal detection: upper 32 bits non-zero (matches the
        // sentinel band shape; success codes fit in u32 with upper
        // bits zero).
        mov r10, rax;
        shr r10, 32;
        cmp r10, 0;
        jne seat_lock_e_forward;
        // Forwarding refusal sentinel is only reached on the failure
        // arm; SUCCESS falls through here with rax == 0.

        // (6) bump seq counter via load-inc-store.
        lea r10, [rip + _seat_lock_seq_counter];
        mov rax, [r10];
        add rax, 1;
        mov [r10], rax;
        // rax = post-bump seq.

        // publish word1 = post-bump seq
        mov [rbx + 8], rax;

        // publish word3[7:0] = reason low byte (word3 was zero at init
        // and untouched on any prior release, so no read-modify-write
        // needed for the reserved high bits). Isolate low byte of r12
        // via shl 56 / shr 56 to avoid smearing a caller-provided
        // out-of-range value into the reserved bits. (The range check
        // at (3) already guarantees r12 <= 3, so this masking is
        // belt-and-braces; still cheap and consistent with the file's
        // encoder-conservative posture.)
        mov r11, r12;
        shl r11, 56;
        shr r11, 56;
        mov [rbx + 24], r11;

        xor rax, rax;                    // SL_OK
        jmp seat_lock_e_done;

      seat_lock_e_forward:
        // The refusal sentinel from SeatKind.seat_lock is already in
        // rax; return it verbatim so the caller can inspect the
        // underlying 0xFFFFEB7x code.
        jmp seat_lock_e_done;

      seat_lock_e_null_state:
        mov rax, 0xFFFFE141;             // SL_NULL_STATE
        jmp seat_lock_e_done;

      seat_lock_e_not_init:
        mov rax, 0xFFFFE146;             // SL_NOT_INIT
        jmp seat_lock_e_done;

      seat_lock_e_bad_reason:
        mov rax, 0xFFFFE144;             // SL_BAD_REASON
        jmp seat_lock_e_done;

      seat_lock_e_already:
        mov rax, 0xFFFFE147;             // SL_ALREADY_LOCKED
        // fallthrough

      seat_lock_e_done:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION 5 -- VERIFY AND RELEASE (transition locked -> unlocked)
  // ==========================================================================
  //
  // seat_lock_verify_and_release(state_ptr, credential_hash) -> u64 status
  //
  //   The unlock primitive. Contract:
  //
  //     (1) state_ptr == 0                     -> SL_NULL_STATE
  //     (2) state not initialised              -> SL_NOT_INIT
  //     (3) credential_hash == 0               -> SL_NULL_HASH
  //         (zero is refused unconditionally so the caller cannot
  //          accidentally match an unset expected_credential_hash)
  //     (4) not locked (word1 == 0)            -> SL_NOT_LOCKED
  //     (5) expected_credential_hash == 0      -> SL_NO_CREDENTIAL_SET
  //         (refusing rather than always-succeeding is the safe default;
  //          a caller who wants an "unlock without credential" flow
  //          must explicitly seed a MAGIC value via
  //          seat_lock_set_credential_hash first)
  //     (6) credential_hash != expected        -> SL_BAD_CREDENTIAL
  //         AND bump word0[63:32] (unlock_attempts) via load-modify-
  //         store, saturating at 0xFFFFFFFF so a wrapping counter
  //         cannot be manipulated by a very long guessing session.
  //     (7) success: call SeatKind.seat_unlock(seat_row_ptr); on
  //         refusal forward the sentinel verbatim (SEAT_UNLOCK_ALREADY
  //         = 0xFFFFEB77 or other 0xFFFFEB7x). On success zero word1
  //         (locked_at_seq) and word3[7:0] (reason); RESET
  //         unlock_attempts to 0 in word0 (a successful unlock clears
  //         the guessing counter). Return SL_OK.
  //
  //   The compare at step (6) is `cmp reg, reg` -- constant-time by
  //   x86-64 semantics (no early-exit on mismatch). The branch after
  //   the compare is data-dependent, but only on WHETHER the hashes
  //   matched, not on the pattern of bits inside the mismatch, so a
  //   timing side-channel cannot learn a partial hash from the branch
  //   itself. Future landings that need blinded credentials should
  //   compose this leaf with a KDF layer above.
  //
  //   Frame:
  //     - entry rsp%16 == 8.
  //     - push rbx / push r12 / push r13 => rsp%16 == 0, aligned for
  //       the call. Preserved:
  //         rbx = state_ptr
  //         r12 = credential_hash
  //         r13 = seat_row_ptr (loaded pre-call)
  //     - pop r13 / r12 / rbx before ret.
  //
  //   Labels prefixed seat_lock_v_.

  pub let seat_lock_verify_and_release : (u64, u64) -> u64 !{mem} @{} =
    fn (state_ptr: u64) (credential_hash: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B12-02 G8-M5-002 (paideia-os #2286): unlock primitive. Order: (1) state_ptr != 0 else SL_NULL_STATE. (2) word4 != 0 else SL_NOT_INIT. (3) credential_hash (rsi) != 0 else SL_NULL_HASH. (4) word1 != 0 (locked) else SL_NOT_LOCKED (0xFFFFE148). (5) word5 (expected_hash) != 0 else SL_NO_CREDENTIAL_SET (0xFFFFE14C). (6) cmp credential_hash vs expected; on mismatch bump word0[63:32] (attempts), saturating at 0xFFFFFFFF, and return SL_BAD_CREDENTIAL (0xFFFFE149). (7) call SeatKind.seat_unlock(seat_row_ptr); on refusal forward verbatim; on success zero word1 + word3 + attempts. Callee-save frame: push rbx / r12 / r13. Attempts bump uses load-cmp-inc-store with saturation (no `add reg,[mem]`). No `test`, no `and reg, imm64`. Labels prefixed seat_lock_v_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                    // rbx = state_ptr
        mov r12, rsi;                    // r12 = credential_hash

        // (1) state_ptr null check
        cmp rbx, 0;
        je  seat_lock_v_null_state;

        // (2) init check (word4 != 0)
        mov rax, [rbx + 32];
        cmp rax, 0;
        je  seat_lock_v_not_init;
        mov r13, rax;                    // r13 = seat_row_ptr

        // (3) credential_hash null check
        cmp r12, 0;
        je  seat_lock_v_null_hash;

        // (4) locked check (word1 != 0)
        mov rax, [rbx + 8];
        cmp rax, 0;
        je  seat_lock_v_not_locked;

        // (5) expected_hash present check (word5 != 0)
        mov rax, [rbx + 40];
        cmp rax, 0;
        je  seat_lock_v_no_cred_set;

        // (6) constant-time compare. rax = expected, r12 = supplied.
        cmp rax, r12;
        jne seat_lock_v_bad_cred;

        // (7) delegate to SeatKind.seat_unlock(seat_row_ptr).
        mov rdi, r13;
        call seat_unlock;
        // rax = SEAT_OK (0) on success, SEAT_UNLOCK_ALREADY (0xFFFFEB77)
        // or other 0xFFFFEB7x sentinel on refusal.
        mov r10, rax;
        shr r10, 32;
        cmp r10, 0;
        jne seat_lock_v_forward;

        // Success: zero word1 (locked_at_seq).
        xor rax, rax;
        mov [rbx + 8], rax;

        // Zero word3 (reason + reserved).
        mov [rbx + 24], rax;

        // Reset unlock_attempts to 0: preserve seat_kind_id at
        // word0[31:0], clear word0[63:32]. Load word0, mask low 32
        // via shl 32 / shr 32, write back.
        mov rax, [rbx + 0];
        shl rax, 32;
        shr rax, 32;
        mov [rbx + 0], rax;

        xor rax, rax;                    // SL_OK
        jmp seat_lock_v_done;

      seat_lock_v_bad_cred:
        // Bump unlock_attempts (word0[63:32]) with saturation at
        // 0xFFFFFFFF. Load word0, extract high 32 via shr 32,
        // saturate-inc, re-pack.
        mov rax, [rbx + 0];
        mov r10, rax;
        shr r10, 32;                     // r10 = current attempts
        // Saturation check: if attempts == 0xFFFFFFFF (== 2^32 - 1)
        // do not increment. Build the sentinel via shl/shr rather than
        // `mov r11, 0xFFFFFFFF` per encoder posture.
        mov r11, 1;
        shl r11, 32;
        sub r11, 1;                      // r11 = 0xFFFFFFFF
        cmp r10, r11;
        je  seat_lock_v_no_bump;
        add r10, 1;
      seat_lock_v_no_bump:
        // Re-pack: rax's low 32 (seat_kind_id) preserved, high 32 :=
        // r10 (new attempts). Mask r10 to low 32 (belt-and-braces),
        // shift to high, mask rax to low, OR.
        shl r10, 32;                     // r10 = new_attempts << 32
        // rax = word0; mask to low 32.
        shl rax, 32;
        shr rax, 32;                     // rax = seat_kind_id low32
        or  rax, r10;
        mov [rbx + 0], rax;
        mov rax, 0xFFFFE149;             // SL_BAD_CREDENTIAL
        jmp seat_lock_v_done;

      seat_lock_v_forward:
        // SeatKind.seat_unlock refusal already in rax; return verbatim.
        jmp seat_lock_v_done;

      seat_lock_v_null_state:
        mov rax, 0xFFFFE141;             // SL_NULL_STATE
        jmp seat_lock_v_done;

      seat_lock_v_not_init:
        mov rax, 0xFFFFE146;             // SL_NOT_INIT
        jmp seat_lock_v_done;

      seat_lock_v_null_hash:
        mov rax, 0xFFFFE14B;             // SL_NULL_HASH
        jmp seat_lock_v_done;

      seat_lock_v_not_locked:
        mov rax, 0xFFFFE148;             // SL_NOT_LOCKED
        jmp seat_lock_v_done;

      seat_lock_v_no_cred_set:
        mov rax, 0xFFFFE14C;             // SL_NO_CREDENTIAL_SET
        // fallthrough

      seat_lock_v_done:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION 6 -- IS_ENGAGED PREDICATE
  // ==========================================================================
  //
  // seat_lock_is_engaged(state_ptr) -> 1 iff the cell is currently
  // locked (word1 != 0), else 0. On state_ptr == 0 returns 0 (a null
  // pointer is not engaged by definition; no distinct sentinel because
  // this is a boolean query, not a status). Kept minimal (one lea, one
  // load, one compare, three-instruction branch on either arm) because
  // a future dispatcher may consult this on the hot path.
  //
  // Labels prefixed seat_lock_ie_.

  pub let seat_lock_is_engaged : (u64) -> u64 !{mem} @{} =
    fn (state_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B12-02 G8-M5-002 (paideia-os #2286): 1 iff word1 (locked_at_seq) at [state_ptr+8] is non-zero. state_ptr == 0 short-circuits to 0. Labels prefixed seat_lock_ie_.",
      block: {
        cmp rdi, 0;
        je  seat_lock_ie_no;
        mov rax, [rdi + 8];
        cmp rax, 0;
        je  seat_lock_ie_no;
        mov rax, 1;
        ret;
      seat_lock_ie_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // SECTION 7 -- INTER-SEAT ISOLATION ASSERTION
  // ==========================================================================
  //
  // seat_lock_verify_isolation(state_a_ptr, state_b_ptr) -> u64 status
  //
  //   The inter-seat isolation invariant asserter. Contract:
  //
  //     (1) state_a_ptr == 0                   -> SL_NULL_STATE
  //     (2) state_b_ptr == 0                   -> SL_NULL_STATE
  //     (3) state_a not initialised            -> SL_NOT_INIT
  //     (4) state_b not initialised            -> SL_NOT_INIT
  //     (5) state_a's seat_kind_id == state_b's seat_kind_id
  //                                            -> SL_ISOLATION_BREACH
  //         (a "peer" isolation check MUST be on different seats;
  //         a caller comparing a seat against itself is asking a
  //         nonsense question and the answer is the sharpest possible
  //         "yes, breach")
  //     (6) walk KIND_INPUT_ROUTE pool at ROUTE_KIND_OFF_SEAT_SURFACE
  //         = +16 low 32; if any live route names EITHER seat_a's OR
  //         seat_b's seat_kind_id AND has a target on the OTHER seat's
  //         window/surface -> SL_ISOLATION_BREACH.
  //         STUB: the route-pool walker is not yet published (same
  //         missing primitive route_revoke.pdx §STUB SCOPE documents);
  //         today (5) is the strongest check we can make. When the
  //         walker lands the walk body drops in without a signature
  //         change.
  //     (7) success: return SL_OK.
  //
  //   A caller that gets SL_OK today sees "the two state cells name
  //   different seats and no other obvious sharing" -- NOT a proof of
  //   full isolation. When the pool walker publishes, the assertion
  //   strengthens to "no live KIND_INPUT_ROUTE simultaneously names
  //   both seats' identifiers OR crosses their surface graphs", which
  //   IS the full P2 isolation invariant.
  //
  //   Labels prefixed seat_lock_vi_.

  pub let seat_lock_verify_isolation : (u64, u64) -> u64 !{mem} @{} =
    fn (state_a_ptr: u64) (state_b_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B12-02 G8-M5-002 (paideia-os #2286): inter-seat isolation assertion. Order: (1) state_a (rdi) != 0 else SL_NULL_STATE. (2) state_b (rsi) != 0 else SL_NULL_STATE. (3) word4 of state_a != 0 (init) else SL_NOT_INIT. (4) word4 of state_b != 0 (init) else SL_NOT_INIT. (5) seat_kind_id of a (word0[31:0]) != seat_kind_id of b (word0[31:0]) else SL_ISOLATION_BREACH (0xFFFFE14A). (6) STUB: real pool walk lands with G8-M2-004 walker primitive; today (5) is the strongest check. (7) return SL_OK. Zero-extension via shl 32 / shr 32. No `test`, no `and reg, imm64`. Labels prefixed seat_lock_vi_.",
      block: {
        // (1) state_a null check
        cmp rdi, 0;
        je  seat_lock_vi_null_state;

        // (2) state_b null check
        cmp rsi, 0;
        je  seat_lock_vi_null_state;

        // (3) state_a init check (word4 != 0)
        mov rax, [rdi + 32];
        cmp rax, 0;
        je  seat_lock_vi_not_init;

        // (4) state_b init check (word4 != 0)
        mov rax, [rsi + 32];
        cmp rax, 0;
        je  seat_lock_vi_not_init;

        // (5) compare seat_kind_ids (both stored in word0[31:0])
        mov rax, [rdi + 0];
        shl rax, 32;
        shr rax, 32;                     // rax = a.seat_kind_id
        mov r10, [rsi + 0];
        shl r10, 32;
        shr r10, 32;                     // r10 = b.seat_kind_id
        cmp rax, r10;
        je  seat_lock_vi_breach;

        // (6) STUB: pool walk deferred. Fall through to SL_OK.
        // (7) SL_OK.
        xor rax, rax;
        ret;

      seat_lock_vi_null_state:
        mov rax, 0xFFFFE141;             // SL_NULL_STATE
        ret;

      seat_lock_vi_not_init:
        mov rax, 0xFFFFE146;             // SL_NOT_INIT
        ret;

      seat_lock_vi_breach:
        mov rax, 0xFFFFE14A;             // SL_ISOLATION_BREACH
        ret
      }
    }

  // ==========================================================================
  // SECTION 8 -- QUERY HELPERS + DEFENSIVE RESET
  // ==========================================================================
  //
  // Convenience readers + a reset for the state cell and the module-
  // level seq counter. Every getter returns 0 on state_ptr == 0
  // (a null pointer reads as all-zeros for the purposes of these
  // observers; callers that need "is the cell valid?" call
  // seat_lock_is_init below).

  // seat_lock_is_init(state_ptr) -> 1 iff word4 (seat_row_ptr) != 0.
  pub let seat_lock_is_init : (u64) -> u64 !{mem} @{} =
    fn (state_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B12-02 G8-M5-002 (paideia-os #2286): 1 iff word4 (seat_row_ptr) at [state_ptr+32] is non-zero (init invariant). Labels prefixed seat_lock_ii_.",
      block: {
        cmp rdi, 0;
        je  seat_lock_ii_no;
        mov rax, [rdi + 32];
        cmp rax, 0;
        je  seat_lock_ii_no;
        mov rax, 1;
        ret;
      seat_lock_ii_no:
        xor rax, rax;
        ret
      }
    }

