      block: {
        cmp rdi, 0;
        je  seat_lock_sl_null_state;

        mov rax, [rdi + 32];
        cmp rax, 0;
        je  seat_lock_sl_not_init;

        mov [rdi + 16], rsi;
        xor rax, rax;
        ret;

      seat_lock_sl_null_state:
        mov rax, 0xFFFFE141;
        ret;

      seat_lock_sl_not_init:
        mov rax, 0xFFFFE146;
        ret
      }
    }

