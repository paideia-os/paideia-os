// src/user/input_server/accel_curve.pdx -- Wave0-B9-02 (paideia-os #2280)
//
// AccelCurve -- per-device pointer-acceleration curve interpolator, the
// value-type module the KIND_INPUT_SERVER (0x1D0, main.pdx, B8-01,
// LANDED) queries when translating a raw KIND_POINTER_DEVICE motion
// event into a compositor-facing delta. Every KIND_POINTER_DEVICE row
// carries ONE AccelCurve inline in its row body (the input server
// owns the storage; there is no cross-process handoff of a bare curve).
//
// =============================================================================
// SECTION 0  WHY THIS IS A VALUE TYPE, NOT A KIND CAP
// =============================================================================
//
// A pointer-acceleration curve is a per-device tuning knob, not a
// shareable capability. The KIND_POINTER_DEVICE cap (0x1D3, sibling to
// KIND_KEYBOARD_DEVICE 0x1D2) is the authority that names the device;
// the curve is a piece of that device's local state. Splitting the
// curve into its own KIND cap would add a rights lattice, a mint
// dispatcher, and a row pool for authority we never hand out --
// mirroring the TilingBsp posture (compositor/tiling_bsp.pdx §0):
// every KIND_WORKSPACE owns exactly one BSP tree; every KIND_POINTER_
// DEVICE owns exactly one AccelCurve.
//
// Cross-repo alignment: libinput (Peter Hutterer) publishes per-device
// pointer-acceleration curves as opaque tunables the display server
// consumes; the shape here mirrors that -- the curve lives with the
// device, the compositor never sees the interpolator, and a
// libinput-style "profile" enum picks between FLAT / ADAPTIVE /
// ACCEL_ONLY presets. The design/roadmap/next-wave-osarch.md line 656
// note ("libinput -- algorithm reuse; we lift the pointer-acceleration
// curves") pins this correspondence.
//
// =============================================================================
// SECTION 1  KIND_* SLOT ALLOCATION
// =============================================================================
//
// N/A -- this module is a VALUE TYPE. No KIND_ACCEL_CURVE slot exists.
// The parent capability that anchors ownership is KIND_POINTER_DEVICE
// (0x1D3), whose row body reserves a 32-byte AccelCurve inline (the
// row-body layout for KIND_POINTER_DEVICE is not yet frozen; when it
// is, the pointer-device_kind_id argument to accel_curve_new below is
// the reconciliation point).
//
// =============================================================================
// SECTION 2  ROW LAYOUT -- 32 BYTES / 4 U64
// =============================================================================
//
//   [+0]  ident:    device_kind_id[31:0] | profile[39:32] | reserved[63:40]
//   [+8]  sens:     sensitivity_num[31:0] | sensitivity_den[63:32]
//   [+16] dz_ct:    deadzone_delta[31:0]  | curve_point_count[63:32]
//   [+24] pts_ptr:  curve_points_ptr[63:0]
//
// Fields:
//   device_kind_id:    u32  -- the KIND_POINTER_DEVICE cap slot this
//                              curve tunes. Carried in-band so a
//                              consumer handed a bare curve pointer
//                              can cross-check against the owning row.
//   profile:           u8   -- one of ACCEL_PROFILE_FLAT (0) /
//                              _ADAPTIVE (1) / _ACCEL_ONLY (2). See
//                              §2.1 below.
//   sensitivity_num:   u32  -- numerator of the rational multiplier
//                              applied AFTER the profile shape. 0..N.
//   sensitivity_den:   u32  -- denominator; must be nonzero. Standard
//                              unity gain is num=1, den=1.
//   deadzone_delta:    u32  -- motion delta magnitude below which the
//                              output is CLAMPED TO ZERO (raw units).
//                              A common configuration is 0 (no dead
//                              zone) or a small integer that suppresses
//                              a jittery sensor's near-zero noise.
//   curve_points_ptr:  u64  -- pointer to a piecewise-linear curve
//                              table: up to 16 pairs of
//                              (input_delta: u32, output_delta: u32),
//                              sorted ascending by input_delta. May be
//                              zero when profile == FLAT (no points
//                              consulted).
//   curve_point_count: u32  -- number of live pairs in the table.
//                              Bounded 0..16. Zero means "curve is
//                              passthrough" regardless of profile.
//
// -----------------------------------------------------------------------------
// 2.1  Profile semantics
// -----------------------------------------------------------------------------
//
//   ACCEL_PROFILE_FLAT (0):
//     Output = raw_delta * sensitivity_num / sensitivity_den.
//     Curve points are NOT consulted. Deadzone still applies.
//     Corresponds to libinput's "flat" profile -- the classic
//     "sensitivity slider only" mouse for CAD, drawing tablets, and
//     users who want predictable 1:1-scaled motion.
//
//   ACCEL_PROFILE_ADAPTIVE (1):
//     Output = ac_curve_lookup(|raw_delta|) * sign(raw_delta)
//                                   * sensitivity_num / sensitivity_den.
//     The curve lookup piecewise-linearly interpolates between adjacent
//     (input_delta, output_delta) points, clamping the output to the
//     last point's output_delta when |raw_delta| exceeds the table's
//     top input_delta. This is libinput's default: slow motion is
//     precise (low output multiplier), fast motion sweeps large screen
//     distances (high output multiplier).
//
//   ACCEL_PROFILE_ACCEL_ONLY (2):
//     Like ADAPTIVE, but the curve is CLAMPED FROM BELOW to the raw
//     magnitude: the profile never DECELERATES motion (an ADAPTIVE
//     curve with output_delta < input_delta at low speeds turns into
//     a passthrough for those speeds). Useful for gaming mice where
//     the user wants precise 1:1 tracking at low speed and boost at
//     high speed -- no fine-motion slowdown.
//
// -----------------------------------------------------------------------------
// 2.2  Piecewise-linear curve table
// -----------------------------------------------------------------------------
//
// The curve table pointed to by curve_points_ptr is an array of at
// most 16 pairs:
//
//   struct AccelCurvePoint {
//     input_delta:  u32   // motion magnitude in raw device units
//     output_delta: u32   // magnitude to feed downstream
//   }
//   sizeof == 8 bytes; array occupies at most 128 bytes.
//
// Points MUST be sorted ascending by input_delta (accel_curve_bind_
// points does not verify -- callers own the invariant). Interpolation
// between p[i] and p[i+1] uses the closed form:
//
//   output = p[i].output_delta
//          + (input - p[i].input_delta)
//          * (p[i+1].output_delta - p[i].output_delta)
//          / (p[i+1].input_delta  - p[i].input_delta)
//
// For input below p[0].input_delta the lookup returns
// p[0].output_delta (clamp low); above p[count-1].input_delta it
// returns p[count-1].output_delta (clamp high). This matches
// libinput's clamped-piecewise-linear posture and avoids the
// unbounded overshoot a naive linear extrapolation would produce for
// a stray large delta.
//
// -----------------------------------------------------------------------------
// 2.3  Sign discipline for the apply path
// -----------------------------------------------------------------------------
//
// accel_curve_apply treats raw_delta_x / raw_delta_y as i32 SIGN-
// EXTENDED into u64 (the caller passes rdi/rsi with the high 32 bits
// carrying the sign fill). Internally the function extracts sign
// masks via arithmetic-shift-right by 63, computes magnitudes,
// applies the profile, then reapplies signs. Outputs are packed into
// the return u64 as:
//
//   [31:0]   -- accel_x as i32 (two's complement)
//   [63:32]  -- accel_y as i32 (two's complement)
//
// The pair-in-u64 return matches every packer/unpacker in this repo
// (window_kind's geometry, kind_framebuffer's stride/pitch, etc.) and
// avoids the SysV memory-return dance a struct-return would force.
//
// =============================================================================
// SECTION 3  FAILURE TAXONOMY -- 0xFFFFEB90..0xFFFFEB9F
// =============================================================================
//
// Repo-wide grep at landing time (grep -rhEo '0xFFFFEB[0-9A-Fa-f]{2}'
// over src/) shows the 0xFFFFEB90..0xFFFFEB9F page entirely unclaimed:
// nearest live neighbours are 0xFFFFEB80 (only referenced as
// "unclaimed" in commentary) and 0xFFFFEBEA (kind_clip_offer band).
// Adjacent to the input-server family (KIND_SEAT 0xFFFFEB70..7F,
// KIND_INPUT_ROUTE shares that band) so downstream G8-M3 rows that
// add scroll_axis / trackpad_gesture keep contiguous numeric locality.
//
// The task-brief-suggested band 0xFFFFEB90..0xFFFFEB9F holds without
// deviation; this comment records the grep verification so a future
// rebase-conflict resolver can retire the entry without re-scanning.
//
// =============================================================================
// SECTION 4  ENCODER-CONSERVATIVE DISCIPLINE
// =============================================================================
//
// Per the B9-02 spec (mirrors B8 encoder rules):
//
//   * NO `test rN, rN`. Use `cmp rN, 0` instead. paideia-as U1605
//     (test-mnemonic not in resolver).
//
//   * NO `add reg, [mem]`. Load through a scratch first, then
//     register-to-register `add`.
//
//   * NO `and r11, imm64`. r11 is internal scratch under U1615 and
//     any `and r11, imm...` shape is refused by paideia-as. Use
//     `shl r11, N` / `shr r11, N` for u32 zero-extension of r11, or
//     stage the mask through rax/r10 which do accept small-imm AND.
//
//   * NO 2-op imul-with-imm. Use 3-op `imul dst, src, imm32`. 2-op
//     reg-reg (`imul rax, rsi` == rax *= rsi) is fine and used by
//     tiling_bsp's tb_lgr_geometry for ph * ratio_num.
//
//   * u32 zero-extension via `shl 32; shr 32`. Small-imm AND
//     (`and rax, 0xFF`, `and rax, 0xFFFF`) on rax/r10 is acceptable
//     for u8/u16 field extraction (matches seat_kind.pdx seat_is_
//     locked's imm8-form AND and tiling_bsp's tb_node_axis).
//
//   * Signed abs via branchless `sar mask, 63; xor val, mask; sub
//     val, mask` -- the canonical two-instruction abs that avoids
//     the conditional-jump variant.
//
// =============================================================================
// SECTION 5  FINGERPRINT
// =============================================================================
//
// ONE data-only tag ending `[legacy: ACCEL CURVE META OK]` per softarch
// discipline. Emitted (in a future landing that wires the input
// server's motion-event path through accel_curve_apply) via klog_s1_x1
// on the first successful curve bind per boot. At THIS landing the
// string is data-only; the input server's dispatch body (B8-01,
// input_server/main.pdx) does not yet call into accel_curve_apply, so
// no emission path is live. The tag is defined here so the
// fingerprint-coverage gate (tools/verify-fingerprint-coverage.sh)
// has a stable string to allowlist against once the pointer-motion
// wire-in lands.
//
// LABEL PREFIX. Public API functions carry the full `accel_curve_`
// prefix per the batch spec. Internal helpers and jump labels use the
// shorter `ac_` prefix (safely avoids paideia-as reserved keywords
// such as `loop` / `if` / `return`; see feedback_paideia_as_reserved
// _labels). Labels within a function use a function-specific suffix
// (e.g. `ac_ap_...` in accel_curve_apply, `ac_cl_...` in
// ac_curve_lookup) to keep the branch-target namespace flat.

module AccelCurve = structure {

  // ==========================================================================
  // SECTION A  Row sizing + enum + sentinel constants.
  // ==========================================================================

  // Row size. 32 bytes = 4 u64, one half of a cache line.
  pub let ACCEL_CURVE_ROW_BYTES : u64 = 32

  // Byte offsets within the row (SECTION 2).
  pub let ACCEL_CURVE_OFF_IDENT    : u64 = 0    // device_kind_id | profile | reserved
  pub let ACCEL_CURVE_OFF_SENS     : u64 = 8    // sensitivity_num | sensitivity_den
  pub let ACCEL_CURVE_OFF_DZ_CT    : u64 = 16   // deadzone_delta  | curve_point_count
  pub let ACCEL_CURVE_OFF_PTS_PTR  : u64 = 24   // curve_points_ptr (full u64)

  // Profile enum. u8 stored at bits [39:32] of the ident word.
  pub let ACCEL_PROFILE_FLAT         : u64 = 0    // linear passthrough
  pub let ACCEL_PROFILE_ADAPTIVE     : u64 = 1    // variable curve, both directions
  pub let ACCEL_PROFILE_ACCEL_ONLY   : u64 = 2    // never decelerate (min = raw)
  pub let ACCEL_PROFILE_MAX          : u64 = 2    // accel_curve_new asserts <= this

  // Curve-table bounds.
  pub let ACCEL_CURVE_POINTS_MAX     : u64 = 16   // upper bound on curve_point_count
  pub let ACCEL_CURVE_POINT_BYTES    : u64 = 8    // sizeof AccelCurvePoint (u32 + u32)

  // u32 mask (documentary only; assembly uses shl 32 / shr 32).
  pub let ACCEL_CURVE_U32_MAX : u64 = 0xFFFFFFFF

  // ==========================================================================
  // SECTION B  Failure taxonomy -- 0xFFFFEB90..0xFFFFEB9F.
  //
  // Fresh 16-slot band verified free by repo-wide grep at landing.
  // Ordering (highest to lowest) mirrors the seat_kind / route_kind
  // convention: catch-all sentinel at the top, refusal reasons dense
  // below, low half reserved for follow-ups.
  // ==========================================================================

  pub let ACCEL_CURVE_OK               : u64 = 0
  pub let ACCEL_CURVE_BAD_ARG          : u64 = 0xFFFFEB9F  // catch-all (null row_ptr, etc.)
  pub let ACCEL_CURVE_BAD_DEVICE       : u64 = 0xFFFFEB9E  // device_kind_id == 0 or > u32
  pub let ACCEL_CURVE_BAD_PROFILE      : u64 = 0xFFFFEB9D  // profile > ACCEL_PROFILE_MAX
  pub let ACCEL_CURVE_BAD_SENS_DEN     : u64 = 0xFFFFEB9C  // sensitivity_den == 0
  pub let ACCEL_CURVE_BAD_SENS_NUM     : u64 = 0xFFFFEB9B  // sensitivity_num > u32
  pub let ACCEL_CURVE_BAD_DEADZONE     : u64 = 0xFFFFEB9A  // deadzone_delta > u32
  pub let ACCEL_CURVE_BAD_POINTS_COUNT : u64 = 0xFFFFEB99  // count > ACCEL_CURVE_POINTS_MAX
  pub let ACCEL_CURVE_BAD_POINTS_PTR   : u64 = 0xFFFFEB98  // points_ptr == 0 with count > 0
  pub let ACCEL_CURVE_ROW_NONE         : u64 = 0xFFFFEB97  // row_ptr == 0
  // 0xFFFFEB90..0xFFFFEB96 reserved for G8-M3-002/003 follow-ups
  // (scroll_axis, trackpad_gesture -- adjacent-band value types).

  // ==========================================================================
  // SECTION C  Fingerprint tag (data-only).
  //
  // pdx_kind_accel_curve_meta -- ONE tag ending [legacy: ... OK] per
  // softarch discipline. See file header §5. Wire-up path (input
  // server's motion event -> accel_curve_apply -> emission via
  // klog_s1_x1) lands with a future batch; the coverage-gate allowlist
  // entry lands at the same time.
  //
  // Byte count: "accel curve meta [legacy: ACCEL CURVE META OK]\0"
  // = 46 chars + NUL = 47.
  // ==========================================================================

  pub let pdx_kind_accel_curve_meta : [u8; 47] = "accel curve meta [legacy: ACCEL CURVE META OK]\0"

  // ==========================================================================
  // SECTION D  Validators (pure leaves).
  //
  // Every function in this section is a pure unsafe-bodied leaf with
  // small immediates, returns in rax, and clobbers only rax + one
  // scratch. No `test`, no `and r11, imm64`. Labels prefixed ac_v_ /
  // ac_dv_ / ac_pv_ / ac_sv_.
  // ==========================================================================

  // ac_device_valid(kind_id) -> 1 iff kind_id in (0, 2^32).
  // Zero is refused: a zero device_kind_id means "no device", which
  // is not a curve that a caller would ever mint. Upper 32 bits must
  // be zero so the packed ident word cannot smear device_kind_id into
  // the profile byte.
  pub let ac_device_valid : (u64) -> u64 !{} @{} =
    fn (kind_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B9-02 (paideia-os #2280): device_kind_id validator. 1 iff kind_id in (0, 2^32). Uses shr 32 rather than `and r11, 0xFFFFFFFF` per this file's encoder-conservative posture. Labels prefixed ac_dv_.",
      block: {
        cmp rdi, 0;
        je  ac_dv_no;
        mov rax, rdi;
        shr rax, 32;
        cmp rax, 0;
        jne ac_dv_no;
        mov rax, 1;
        ret;
      ac_dv_no:
        xor rax, rax;
        ret
      }
    }

  // ac_profile_valid(profile) -> 1 iff profile in [0, ACCEL_PROFILE_MAX].
  pub let ac_profile_valid : (u64) -> u64 !{} @{} =
    fn (profile: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B9-02 (paideia-os #2280): profile enum validator. 1 iff profile <= ACCEL_PROFILE_MAX (2). Small immediate cmp, no encoder concern. Labels prefixed ac_pv_.",
      block: {
        cmp rdi, 2;
        ja  ac_pv_no;
        mov rax, 1;
        ret;
      ac_pv_no:
        xor rax, rax;
        ret
      }
    }

  // ac_u32_valid(x) -> 1 iff x in [0, 2^32).
  pub let ac_u32_valid : (u64) -> u64 !{} @{} =
    fn (x: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B9-02 (paideia-os #2280): u32-fit validator. 1 iff x fits in a u32 (upper 32 bits clear). Uses shr 32 rather than a masked compare. Labels prefixed ac_uv_.",
      block: {
        mov rax, rdi;
        shr rax, 32;
        cmp rax, 0;
        jne ac_uv_no;
        mov rax, 1;
        ret;
      ac_uv_no:
        xor rax, rax;
        ret
      }
    }

  // ac_sens_den_valid(den) -> 1 iff den in (0, 2^32).
  // Zero is refused because sensitivity_den is a divisor; a zero
  // divisor is a caller bug (would trap #DE at apply time otherwise).
  pub let ac_sens_den_valid : (u64) -> u64 !{} @{} =
    fn (den: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B9-02 (paideia-os #2280): sensitivity denominator validator. Nonzero + fits u32. Labels prefixed ac_sv_.",
      block: {
        cmp rdi, 0;
        je  ac_sv_no;
        mov rax, rdi;
        shr rax, 32;
        cmp rax, 0;
        jne ac_sv_no;
        mov rax, 1;
        ret;
      ac_sv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // SECTION E  Packers.
  //
  // Every packer follows the (low_u32, high_u32) -> packed_u64 shape.
  // Masking via shl 32 / shr 32 so out-of-range arguments cannot
  // smear into a neighbour field.
  // ==========================================================================

  // ac_pack_u32_pair(lo, hi) -> lo[31:0] | hi[63:32].
  pub let ac_pack_u32_pair : (u64, u64) -> u64 !{} @{} =
    fn (lo: u64) (hi: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B9-02 (paideia-os #2280): pack (u32, u32) -> u64 with lo at [31:0], hi at [63:32]. Zero-extension via shl 32; shr 32. Labels prefixed ac_pp_.",
      block: {
        mov rax, rdi;
        shl rax, 32;
        shr rax, 32;
        mov r10, rsi;
        shl r10, 32;
        or  rax, r10;
        ret
      }
    }

  // ac_pack_ident(device_kind_id, profile) -> ident word.
  // Layout: device_kind_id[31:0] | profile[39:32] | reserved[63:40].
  // profile pre-masked to a u8 via `and rax, 0xFF` (imm8, no encoder
  // concern; rax operand accepts imm-form AND).
  pub let ac_pack_ident : (u64, u64) -> u64 !{} @{} =
    fn (device_kind_id: u64) (profile: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B9-02 (paideia-os #2280): pack (device_kind_id[31:0] | profile[39:32]) with reserved[63:40] zeroed. profile masked to u8 via `and rax, 0xFF` (imm8, rax destination -- matches tb_node_axis's shape). device_kind_id masked to u32 via shl/shr 32. Labels prefixed ac_pi_.",
      block: {
        mov rax, rsi;
        and rax, 0xFF;              // profile masked to u8 (imm8 form)
        shl rax, 32;                // profile now at [39:32]
        mov r10, rdi;
        shl r10, 32;
        shr r10, 32;                // device_kind_id zero-extended at [31:0]
        or  rax, r10;
        ret
      }
    }

  // ==========================================================================
  // SECTION F  Field accessors (readers).
  //
  // Every accessor takes a row_ptr (as returned by the parent
  // KIND_POINTER_DEVICE row body's curve-inline offset) and returns
  // the requested u32/u8 field zero-extended into rax, or the full
  // u64 pointer for curve_points_ptr.
  // ==========================================================================

  // accel_curve_device(row_ptr) -> u32.
  pub let accel_curve_device : (u64) -> u64 !{mem} @{} =
    fn (row_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-02 (paideia-os #2280): read device_kind_id from ident[31:0]. Zero-extend via shl 32; shr 32. Labels prefixed ac_gd_.",
      block: {
        mov rax, [rdi + 0];
        shl rax, 32;
        shr rax, 32;
        ret
      }
    }

  // accel_curve_profile(row_ptr) -> u8 zero-extended.
  pub let accel_curve_profile : (u64) -> u64 !{mem} @{} =
    fn (row_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-02 (paideia-os #2280): read profile from ident[39:32]. Extract via shr 32 then `and rax, 0xFF` (imm8-form AND on rax matches tb_node_axis). Labels prefixed ac_gp_.",
      block: {
        mov rax, [rdi + 0];
        shr rax, 32;
        and rax, 0xFF;
        ret
      }
    }

  // accel_curve_sensitivity_num(row_ptr) -> u32.
  pub let accel_curve_sensitivity_num : (u64) -> u64 !{mem} @{} =
    fn (row_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-02 (paideia-os #2280): read sensitivity_num from sens[31:0]. Labels prefixed ac_gsn_.",
      block: {
        mov rax, [rdi + 8];
        shl rax, 32;
        shr rax, 32;
        ret
      }
    }

  // accel_curve_sensitivity_den(row_ptr) -> u32.
  pub let accel_curve_sensitivity_den : (u64) -> u64 !{mem} @{} =
    fn (row_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-02 (paideia-os #2280): read sensitivity_den from sens[63:32]. Labels prefixed ac_gsd_.",
      block: {
        mov rax, [rdi + 8];
        shr rax, 32;
        ret
      }
    }

  // accel_curve_deadzone(row_ptr) -> u32.
  pub let accel_curve_deadzone : (u64) -> u64 !{mem} @{} =
    fn (row_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-02 (paideia-os #2280): read deadzone_delta from dz_ct[31:0]. Labels prefixed ac_gdz_.",
      block: {
        mov rax, [rdi + 16];
        shl rax, 32;
        shr rax, 32;
        ret
      }
    }

  // accel_curve_points_count(row_ptr) -> u32.
  pub let accel_curve_points_count : (u64) -> u64 !{mem} @{} =
    fn (row_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-02 (paideia-os #2280): read curve_point_count from dz_ct[63:32]. Labels prefixed ac_gpc_.",
      block: {
        mov rax, [rdi + 16];
        shr rax, 32;
        ret
      }
    }

  // accel_curve_points_ptr(row_ptr) -> u64.
  pub let accel_curve_points_ptr : (u64) -> u64 !{mem} @{} =
    fn (row_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-02 (paideia-os #2280): read curve_points_ptr (full u64). Labels prefixed ac_gpp_.",
      block: {
        mov rax, [rdi + 24];
        ret
      }
    }

  // ==========================================================================
  // SECTION G  Factory: accel_curve_new(row_ptr, device, profile) -> u64.
  //
  // Writes device_kind_id + profile into an already-allocated 32-byte
  // row, initialises sensitivity to unity (num=1, den=1), zeroes the
  // deadzone, and leaves the curve table unattached (points_ptr=0,
  // count=0). Validates device (nonzero + fits u32) and profile
  // (<= ACCEL_PROFILE_MAX); refuses on failure and leaves the row
  // untouched.
  //
  // Note: the task-brief signature `accel_curve_new(device, profile) ->
  // AccelCurve` is realised here as an out-pointer + status return --
  // the 32-byte struct does not fit in a return-register pair, and
  // every sibling factory in this repo (seat_mint, tiling_bsp_tree_
  // new, immediate_context_row_init) takes a row_ptr and returns a
  // status code. See file header §2.3 for the sign-discipline that
  // motivates the packed u64 return on the apply path.
  // ==========================================================================

  pub let accel_curve_new : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (row_ptr: u64) (device: u64) (profile: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-02 (paideia-os #2280): factory writing device_kind_id + profile + defaulted sensitivity/deadzone/curve slots into an existing 32-byte row. Validation order: row_ptr nonzero (ACCEL_CURVE_ROW_NONE); device_kind_id nonzero + fits u32 (ACCEL_CURVE_BAD_DEVICE); profile <= ACCEL_PROFILE_MAX (ACCEL_CURVE_BAD_PROFILE). All validations complete before any store, so a failed mint leaves the row byte-identical to its pre-call state. Defaults: sensitivity_num=1, sensitivity_den=1 (unity gain), deadzone=0, curve_points_ptr=0, curve_point_count=0. Scratch: rax, r8, r10, r11 (all SysV caller-saved). All u32 masking via shl 32 / shr 32; profile u8 masking via `and rax, 0xFF` (imm8 form). Labels prefixed ac_n_.",
      block: {
        // ---- Validate row_ptr nonzero. ----
        cmp rdi, 0;
        je  ac_n_bad_row;

        // ---- Validate device (nonzero + fits u32). ----
        cmp rsi, 0;
        je  ac_n_bad_device;
        mov r10, rsi;
        shr r10, 32;
        cmp r10, 0;
        jne ac_n_bad_device;

        // ---- Validate profile <= ACCEL_PROFILE_MAX. ----
        cmp rdx, 2;
        ja  ac_n_bad_profile;

        // ---- All validated. Commit the writes. ----
        // ident ([+0]): device_kind_id[31:0] | profile[39:32] | 0.
        mov rax, rdx;
        and rax, 0xFF;              // profile masked to u8
        shl rax, 32;                // profile at [39:32]
        mov r10, rsi;
        shl r10, 32;
        shr r10, 32;                // device_kind_id zero-extended
        or  rax, r10;
        mov [rdi + 0], rax;

        // sens ([+8]): num=1 | den=1.
        //   ident.low = 1, ident.high = 1 -> pack as (1 | 1 << 32).
        mov rax, 1;                 // low half num=1
        mov r10, 1;
        shl r10, 32;                // high half den=1
        or  rax, r10;
        mov [rdi + 8], rax;

        // dz_ct ([+16]): deadzone=0 | count=0. Both halves zero.
        xor rax, rax;
        mov [rdi + 16], rax;

        // pts_ptr ([+24]): points_ptr=0.
        mov [rdi + 24], rax;

        // ACCEL_CURVE_OK = 0.
        xor rax, rax;
        ret;

      ac_n_bad_row:
        mov rax, 0xFFFFEB97;        // ACCEL_CURVE_ROW_NONE
        ret;
      ac_n_bad_device:
        mov rax, 0xFFFFEB9E;        // ACCEL_CURVE_BAD_DEVICE
        ret;
      ac_n_bad_profile:
        mov rax, 0xFFFFEB9D;        // ACCEL_CURVE_BAD_PROFILE
        ret
      }
    }

  // ==========================================================================
  // SECTION H  Setters.
  //
  //   accel_curve_set_sensitivity(row_ptr, num, den) -> status
  //   accel_curve_set_deadzone(row_ptr, delta) -> status
  //   accel_curve_bind_points(row_ptr, points_ptr, count) -> status
  //   accel_curve_set_profile(row_ptr, profile) -> status
  //
  // Each setter overwrites only its target field(s), preserving the
  // other packed field in its word. Validates before writing so a
  // refused call leaves the row byte-identical to its prior state.
  // ==========================================================================

  // accel_curve_set_sensitivity(row_ptr, num, den) -> status.
  //
  // Refuses:
  //   * row_ptr == 0            -> ACCEL_CURVE_ROW_NONE
  //   * num > u32               -> ACCEL_CURVE_BAD_SENS_NUM
  //   * den == 0 or den > u32   -> ACCEL_CURVE_BAD_SENS_DEN
  //
  // Overwrites the entire sens word at [+8].
  pub let accel_curve_set_sensitivity : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (row_ptr: u64) (num: u64) (den: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-02 (paideia-os #2280): set sensitivity numerator/denominator. Validates row_ptr, num-fits-u32, den-nonzero-and-fits-u32 before writing. Overwrites the entire sens word at [+8]. Scratch: rax, r10, r11. Labels prefixed ac_ss_.",
      block: {
        // Validate row_ptr.
        cmp rdi, 0;
        je  ac_ss_bad_row;

        // Validate num fits u32.
        mov r10, rsi;
        shr r10, 32;
        cmp r10, 0;
        jne ac_ss_bad_num;

        // Validate den nonzero + fits u32.
        cmp rdx, 0;
        je  ac_ss_bad_den;
        mov r10, rdx;
        shr r10, 32;
        cmp r10, 0;
        jne ac_ss_bad_den;

        // Commit: pack (num[31:0] | den[63:32]) and store at [+8].
        mov rax, rsi;
        shl rax, 32;
        shr rax, 32;                // zero-extended num
        mov r10, rdx;
        shl r10, 32;                // den into high half
        or  rax, r10;
        mov [rdi + 8], rax;

        xor rax, rax;               // ACCEL_CURVE_OK
        ret;

      ac_ss_bad_row:
        mov rax, 0xFFFFEB97;        // ACCEL_CURVE_ROW_NONE
        ret;
      ac_ss_bad_num:
        mov rax, 0xFFFFEB9B;        // ACCEL_CURVE_BAD_SENS_NUM
        ret;
      ac_ss_bad_den:
        mov rax, 0xFFFFEB9C;        // ACCEL_CURVE_BAD_SENS_DEN
        ret
      }
    }

  // accel_curve_set_deadzone(row_ptr, delta) -> status.
  //
  // Refuses:
  //   * row_ptr == 0            -> ACCEL_CURVE_ROW_NONE
  //   * delta > u32             -> ACCEL_CURVE_BAD_DEADZONE
  //
  // Overwrites the low 32 bits of the dz_ct word at [+16], preserving
  // curve_point_count in the high half.
  pub let accel_curve_set_deadzone : (u64, u64) -> u64 !{mem} @{} =
    fn (row_ptr: u64) (delta: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-02 (paideia-os #2280): set deadzone_delta preserving curve_point_count in high half. Validates row_ptr and delta-fits-u32. Read-modify-write on the dz_ct word. Labels prefixed ac_sdz_.",
      block: {
        cmp rdi, 0;
        je  ac_sdz_bad_row;

        // Validate delta fits u32.
        mov r10, rsi;
        shr r10, 32;
        cmp r10, 0;
        jne ac_sdz_bad;

        // Load dz_ct, strip low 32, OR in new delta.
        mov rax, [rdi + 16];
        shr rax, 32;                // rax = curve_point_count (u32)
        shl rax, 32;                // now in high 32, low cleared
        mov r10, rsi;
        shl r10, 32;
        shr r10, 32;                // zero-extended new delta
        or  rax, r10;
        mov [rdi + 16], rax;

        xor rax, rax;
        ret;

      ac_sdz_bad_row:
        mov rax, 0xFFFFEB97;
        ret;
      ac_sdz_bad:
        mov rax, 0xFFFFEB9A;        // ACCEL_CURVE_BAD_DEADZONE
        ret
      }
    }

  // accel_curve_bind_points(row_ptr, points_ptr, count) -> status.
  //
  // Refuses:
  //   * row_ptr == 0                       -> ACCEL_CURVE_ROW_NONE
  //   * count > ACCEL_CURVE_POINTS_MAX (16)-> ACCEL_CURVE_BAD_POINTS_COUNT
  //   * count > 0 && points_ptr == 0       -> ACCEL_CURVE_BAD_POINTS_PTR
  //
  // Overwrites the high 32 bits of the dz_ct word (curve_point_count)
  // and the entire pts_ptr word at [+24]. deadzone_delta is preserved.
  //
  // NB: the caller owns the invariant that the pointed-to table holds
  // `count` (u32, u32) pairs sorted ascending by input_delta. This
  // function does NOT validate the pairs.
  pub let accel_curve_bind_points : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (row_ptr: u64) (points_ptr: u64) (count: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-02 (paideia-os #2280): attach a piecewise-linear curve table. Validates row_ptr, count<=16, and (count>0 -> points_ptr!=0). Writes curve_point_count into dz_ct[63:32] preserving deadzone_delta at dz_ct[31:0], and overwrites pts_ptr at [+24]. Labels prefixed ac_bp_.",
      block: {
        cmp rdi, 0;
        je  ac_bp_bad_row;

        // count <= 16?
        cmp rdx, 16;
        ja  ac_bp_bad_count;

        // count > 0 && points_ptr == 0?
        cmp rdx, 0;
        je  ac_bp_ok_zero;          // count == 0 skips points_ptr check
        cmp rsi, 0;
        je  ac_bp_bad_ptr;

      ac_bp_ok_zero:
        // Read-modify-write dz_ct: preserve deadzone, replace count.
        mov rax, [rdi + 16];
        shl rax, 32;
        shr rax, 32;                // rax = deadzone (u32)
        mov r10, rdx;
        shl r10, 32;                // new count into high 32
        or  rax, r10;
        mov [rdi + 16], rax;

        // pts_ptr: overwrite full u64.
        mov [rdi + 24], rsi;

        xor rax, rax;
        ret;

      ac_bp_bad_row:
        mov rax, 0xFFFFEB97;
        ret;
      ac_bp_bad_count:
        mov rax, 0xFFFFEB99;        // ACCEL_CURVE_BAD_POINTS_COUNT
        ret;
      ac_bp_bad_ptr:
        mov rax, 0xFFFFEB98;        // ACCEL_CURVE_BAD_POINTS_PTR
        ret
      }
    }

  // accel_curve_set_profile(row_ptr, profile) -> status.
  //
  // Refuses:
  //   * row_ptr == 0                     -> ACCEL_CURVE_ROW_NONE
  //   * profile > ACCEL_PROFILE_MAX (2)  -> ACCEL_CURVE_BAD_PROFILE
  //
  // Overwrites bits [39:32] of the ident word, preserving
  // device_kind_id at bits [31:0] and reserved bits at [63:40].
  pub let accel_curve_set_profile : (u64, u64) -> u64 !{mem} @{} =
    fn (row_ptr: u64) (profile: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-02 (paideia-os #2280): overwrite the profile byte in ident[39:32] preserving device_kind_id at ident[31:0] and reserved bits at [63:40]. Validates row_ptr and profile<=ACCEL_PROFILE_MAX. Labels prefixed ac_sp_.",
      block: {
        cmp rdi, 0;
        je  ac_sp_bad_row;

        cmp rsi, 2;
        ja  ac_sp_bad_profile;

        // Load ident, zero bits [39:32] (mask through rax), OR new profile.
        // Build mask ~(0xFF << 32) using r10 = 0xFF, shl 32, then not.
        // But `not r10` is fine and small.
        mov rax, [rdi + 0];
        mov r10, 0xFF;
        shl r10, 32;                // r10 = 0x000000FF00000000
        not r10;                    // r10 = 0xFFFFFF00FFFFFFFF
        and rax, r10;               // clear bits [39:32] (rax dest, imm-free)

        mov r10, rsi;
        and r10, 0xFF;              // imm8 mask on r10 (r10 accepts imm-form AND)
        shl r10, 32;                // profile into [39:32]
        or  rax, r10;
        mov [rdi + 0], rax;

        xor rax, rax;
        ret;

      ac_sp_bad_row:
        mov rax, 0xFFFFEB97;
        ret;
      ac_sp_bad_profile:
        mov rax, 0xFFFFEB9D;
        ret
      }
    }

  // ==========================================================================
  // SECTION I  Piecewise-linear curve lookup.
  //
  //   ac_curve_lookup(points_ptr, count, input) -> output.
  //
  // Given a table of `count` (u32 input_delta, u32 output_delta) pairs
  // sorted ascending by input_delta, and an unsigned `input`
  // magnitude, returns the piecewise-linearly interpolated output
  // magnitude with clamp-low at points[0].output and clamp-high at
  // points[count-1].output.
  //
  // Preconditions (caller-owned):
  //   count in [0, 16]
  //   if count > 0: points_ptr != 0
  //   points sorted ascending by input_delta with all pairs distinct
  //
  // Edge cases:
  //   count == 0: return input unchanged (passthrough)
  //   count == 1: return points[0].output_delta (no interpolation)
  //   input <= points[0].input: return points[0].output (clamp low)
  //   input >= points[count-1].input: return points[count-1].output (clamp high)
  //
  // Interpolation formula:
  //   output = out_lo + (input - in_lo)
  //                     * (out_hi - out_lo)
  //                     / (in_hi - in_lo)
  //
  // The multiplication `(input - in_lo) * (out_hi - out_lo)` needs at
  // most 64 bits (u32 * u32 fits in u64); the divide by `(in_hi - in_lo)`
  // uses unsigned DIV with rdx cleared.
  // ==========================================================================

  pub let ac_curve_lookup : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (points_ptr: u64) (count: u64) (input: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-02 (paideia-os #2280): piecewise-linear interp over up to 16 (u32,u32) pairs. Four callee-save pushes (rbx=points_ptr, r12=count, r13=input, r14=cursor_i) preserve caller state. This function makes NO nested CALL, so ABI-mandated 16-byte alignment before a call is not required at any point within the body -- the four-push count is chosen for register count, not alignment. All arithmetic in registers; no `test`, no `add reg, [mem]`, no `and r11, imm64`. Division uses `xor rdx, rdx; div r9` per tiling_bsp's tb_lgr_geometry pattern (line 2030). Labels prefixed ac_cl_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov  rbx, rdi;              // rbx = points_ptr
        mov  r12, rsi;              // r12 = count
        mov  r13, rdx;              // r13 = input

        // count == 0 -> return input unchanged (passthrough).
        cmp  r12, 0;
        je   ac_cl_passthrough;

        // count == 1 -> return points[0].output_delta.
        cmp  r12, 1;
        je   ac_cl_single;

        // input <= points[0].input_delta -> clamp low, return points[0].out.
        // Load points[0] (8 bytes = 1 u64: in_lo[31:0] | out_lo[63:32]).
        mov  r10, [rbx + 0];
        mov  r11, r10;
        shl  r11, 32;
        shr  r11, 32;               // r11 = points[0].input_delta
        cmp  r13, r11;
        jbe  ac_cl_clamp_low;

        // input >= points[count-1].input_delta -> clamp high.
        // last_index = count - 1; last_offset = last_index * 8.
        mov  r10, r12;
        sub  r10, 1;                // r10 = last_index
        mov  r11, r10;
        shl  r11, 3;                // r11 = last_offset = last_index * 8
        mov  r9,  rbx;
        add  r9,  r11;              // r9 = &points[last_index]
        mov  r10, [r9];
        mov  r11, r10;
        shl  r11, 32;
        shr  r11, 32;               // r11 = points[last_index].input_delta
        cmp  r13, r11;
        jae  ac_cl_clamp_high;

        // Bracket search: find i s.t. points[i].input <= input < points[i+1].input.
        // i sweeps 0 .. count-2 inclusive.
        mov  r14, 0;                // r14 = i
      ac_cl_scan:
        // Load points[i+1].input_delta at offset (i+1)*8.
        mov  r10, r14;
        add  r10, 1;                // r10 = i + 1
        shl  r10, 3;                // r10 = (i+1) * 8
        mov  r9,  rbx;
        add  r9,  r10;              // r9 = &points[i+1]
        mov  r11, [r9];
        shl  r11, 32;
        shr  r11, 32;               // r11 = points[i+1].input_delta
        cmp  r13, r11;
        jb   ac_cl_interp;          // input < points[i+1].input -> found bracket [i, i+1]

        // Advance i; if i reaches count-1 we exit the loop
        // (should not happen because clamp-high check above already
        // fired for input >= points[count-1].input, but the bound
        // check is defensive).
        add  r14, 1;
        mov  r10, r12;
        sub  r10, 1;                // r10 = count - 1
        cmp  r14, r10;
        jb   ac_cl_scan;

        // Fell off the end -- treat as clamp-high (defensive; caller-
        // invariant violation).
        jmp  ac_cl_clamp_high;

      ac_cl_interp:
        // r14 = i (the lower-bracket index).
        // Load points[i]   at offset i*8   -> r8 = in_lo[31:0] | out_lo[63:32]
        // Load points[i+1] at offset (i+1)*8 -> r9 = in_hi[31:0] | out_hi[63:32]
        mov  r10, r14;
        shl  r10, 3;
        mov  r8,  rbx;
        add  r8,  r10;
        mov  r8,  [r8];             // r8 = points[i] packed

        mov  r10, r14;
        add  r10, 1;
        shl  r10, 3;
        mov  r9,  rbx;
        add  r9,  r10;
        mov  r9,  [r9];             // r9 = points[i+1] packed

        // Extract fields into stable regs.
        //   r10 = in_lo, r11 = out_lo, rcx = in_hi, rdi = out_hi.
        mov  r10, r8;
        shl  r10, 32;
        shr  r10, 32;               // r10 = in_lo
        mov  r11, r8;
        shr  r11, 32;               // r11 = out_lo
        mov  rcx, r9;
        shl  rcx, 32;
        shr  rcx, 32;               // rcx = in_hi
        mov  rdi, r9;
        shr  rdi, 32;               // rdi = out_hi

        // dx = in_hi - in_lo (nonzero by the sorted-distinct invariant).
        mov  r9,  rcx;
        sub  r9,  r10;              // r9 = dx (divisor)

        // dy = out_hi - out_lo. Signed conceptually (curve may decrease
        // locally), but sign management is handled by the caller's
        // profile arm; here we compute unsigned magnitude and add-back.
        //
        // For a monotone curve (the common case), out_hi >= out_lo and
        // dy is nonnegative. For a curve segment where out_hi < out_lo
        // (rare; e.g. an intentional flat/dip), we subtract instead of
        // add. Discriminate on the cmp result.
        cmp  rdi, r11;
        jb   ac_cl_interp_neg;

        // Positive-slope segment:
        //   dt   = input - in_lo
        //   num  = dt * (out_hi - out_lo)          [u32 * u32 fits in u64]
        //   frac = num / dx
        //   out  = out_lo + frac
        mov  rax, r13;
        sub  rax, r10;              // rax = dt
        mov  r8,  rdi;
        sub  r8,  r11;              // r8  = dy (positive)
        imul rax, r8;               // rax = dt * dy (2-op reg-reg; SysV cavat OK)
        xor  rdx, rdx;
        div  r9;                    // rax = num / dx = frac
        add  rax, r11;              // rax = out_lo + frac
        jmp  ac_cl_out;

      ac_cl_interp_neg:
        // Negative-slope segment:
        //   dt   = input - in_lo
        //   num  = dt * (out_lo - out_hi)
        //   frac = num / dx
        //   out  = out_lo - frac
        mov  rax, r13;
        sub  rax, r10;              // rax = dt
        mov  r8,  r11;
        sub  r8,  rdi;              // r8  = out_lo - out_hi (positive)
        imul rax, r8;               // rax = dt * dy_abs
        xor  rdx, rdx;
        div  r9;                    // rax = frac
        mov  r8,  r11;
        sub  r8,  rax;              // r8 = out_lo - frac
        mov  rax, r8;
        jmp  ac_cl_out;

      ac_cl_passthrough:
        mov  rax, r13;
        jmp  ac_cl_out;

      ac_cl_single:
        // count == 1: return points[0].output_delta.
        mov  r10, [rbx + 0];
        shr  r10, 32;               // out_lo at high half
        mov  rax, r10;
        jmp  ac_cl_out;

      ac_cl_clamp_low:
        // Return points[0].output_delta.
        mov  r10, [rbx + 0];
        shr  r10, 32;
        mov  rax, r10;
        jmp  ac_cl_out;

      ac_cl_clamp_high:
        // Return points[count-1].output_delta.
        mov  r10, r12;
        sub  r10, 1;
        shl  r10, 3;
        mov  r9,  rbx;
        add  r9,  r10;
        mov  r10, [r9];
        shr  r10, 32;
        mov  rax, r10;

      ac_cl_out:
        pop  r14;
        pop  r13;
        pop  r12;
        pop  rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION J  Signed abs helper.
  //
  //   ac_abs_i64(x) -> (magnitude, sign_mask).
  //
  // Branchless magnitude extraction for a signed i64 input:
  //   sign_mask = x >> 63 (arithmetic)   -> -1 for negative, 0 for positive
  //   magnitude = (x XOR sign_mask) - sign_mask
  //
  // The return is packed:
  //   [31:0]   -- magnitude low u32
  //   [63:32]  -- sign_mask low u32 (0 or 0xFFFFFFFF; caller sign-extends)
  //
  // Callers reconstitute the sign by XOR + SUB with the returned mask.
  // A dedicated helper for a two-value return is inconvenient in the
  // pdx-value calling convention; accel_curve_apply INLINES the abs
  // sequence per-axis to avoid the pack/unpack overhead.
  //
  // This helper is left as a leaf primitive for future callers (a
  // scroll-axis apply body in G8-M3-002 that shares the sign posture).
  // ==========================================================================

  pub let ac_abs_i64 : (u64) -> u64 !{} @{} =
    fn (x: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B9-02 (paideia-os #2280): branchless abs of an i64 input. sign_mask = x sar 63; magnitude = (x xor mask) - mask. Returns (magnitude[31:0] | sign_low[63:32]) packed. Labels prefixed ac_ab_.",
      block: {
        mov  rax, rdi;              // rax = x
        mov  r10, rdi;
        sar  r10, 63;               // r10 = sign_mask (all-ones if neg, else 0)
        xor  rax, r10;
        sub  rax, r10;              // rax = |x|

        // Pack (magnitude[31:0] | sign_mask_low[63:32]).
        shl  rax, 32;
        shr  rax, 32;               // rax = magnitude zero-extended to u32
        mov  r11, r10;
        shl  r11, 32;
        shr  r11, 32;               // r11 = sign_mask (low 32; 0 or 0xFFFFFFFF)
        shl  r11, 32;               // r11 = sign_mask at [63:32]
        or   rax, r11;
        ret
      }
    }

  // ==========================================================================
  // SECTION K  Apply helper -- per-axis.
  //
  //   ac_apply_axis(row_ptr, raw_delta) -> signed_out_i32_in_u64.
  //
  // Applies the full curve pipeline to ONE axis:
  //   1. sign extraction (branchless via sar 63)
  //   2. magnitude computation
  //   3. deadzone check (magnitude < deadzone -> return 0)
  //   4. profile arm:
  //        FLAT       : mag_out = mag_in
  //        ADAPTIVE   : mag_out = ac_curve_lookup(pts, count, mag_in)
  //        ACCEL_ONLY : mag_out = max(mag_in, ac_curve_lookup(...))
  //   5. sensitivity scale: mag_out = mag_out * sens_num / sens_den
  //   6. sign reapplication: signed_out = (mag_out XOR sign_mask) - sign_mask
  //   7. return as u64 with low 32 bits carrying the i32 two's complement.
  //
  // accel_curve_apply below invokes this helper twice (once per axis)
  // and packs the two i32 results into a single u64 return.
  // ==========================================================================

  pub let ac_apply_axis : (u64, u64) -> u64 !{mem} @{} =
    fn (row_ptr: u64) (raw_delta: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-02 (paideia-os #2280): per-axis apply. Five callee-save pushes (rbx=row_ptr, r12=magnitude, r13=sign_mask, r14=sens_num, r15=sens_den) preserve caller state. Five pushes = odd, entry rsp%16==8 flips five times -> rsp%16==0, so the frame is aligned for nested calls without an additional sub. Nested calls invoke accel_curve_{deadzone,points_count,points_ptr,profile,sensitivity_num,sensitivity_den} plus ac_curve_lookup. Division uses xor-rdx-then-div per tiling_bsp pattern (tb_lgr_geometry line 2030). Labels prefixed ac_ax_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        // rsp % 16 == 0 here (5 pushes from entry rsp%16==8; parity flips 5 times -> 8 XOR (5*8) mod 16 == 0). Aligned for nested calls.

        mov  rbx, rdi;              // rbx = row_ptr

        // 1-2. Sign + magnitude.
        mov  r10, rsi;
        sar  r10, 63;               // r10 = sign_mask (all-ones or 0)
        mov  r12, rsi;
        xor  r12, r10;
        sub  r12, r10;              // r12 = |raw_delta| (still 64-bit-wide)
        mov  r13, r10;              // r13 = sign_mask

        // 3. Deadzone check: if magnitude < deadzone -> return 0.
        mov  rdi, rbx;
        call accel_curve_deadzone;  // rax = deadzone (u32 zero-extended)
        cmp  r12, rax;
        jb   ac_ax_zero;

        // 4. Profile branch.
        mov  rdi, rbx;
        call accel_curve_profile;   // rax = profile (u8)

        cmp  rax, 0;                // ACCEL_PROFILE_FLAT
        je   ac_ax_after_profile;

        // ADAPTIVE (1) or ACCEL_ONLY (2): call ac_curve_lookup.
        mov  r14, rax;              // stash profile in r14 (temporarily; sens_num overwrites later)

        mov  rdi, rbx;
        call accel_curve_points_ptr;
        mov  r10, rax;              // r10 = points_ptr

        mov  rdi, rbx;
        call accel_curve_points_count;
        mov  r11, rax;              // r11 = count

        // ac_curve_lookup(points_ptr, count, magnitude).
        mov  rdi, r10;
        mov  rsi, r11;
        mov  rdx, r12;
        call ac_curve_lookup;
        // rax = curve output magnitude

        // ACCEL_ONLY: mag_out = max(mag_in, rax).
        cmp  r14, 2;                // ACCEL_PROFILE_ACCEL_ONLY?
        jne  ac_ax_adapt_write;
        cmp  rax, r12;
        jae  ac_ax_adapt_write;
        mov  rax, r12;              // clamp: never below raw magnitude

      ac_ax_adapt_write:
        mov  r12, rax;              // r12 = new magnitude after profile

      ac_ax_after_profile:
        // 5. Sensitivity scaling: mag_out = r12 * sens_num / sens_den.
        mov  rdi, rbx;
        call accel_curve_sensitivity_num;
        mov  r14, rax;              // r14 = sens_num

        mov  rdi, rbx;
        call accel_curve_sensitivity_den;
        mov  r15, rax;              // r15 = sens_den (guaranteed nonzero by set_sensitivity)

        mov  rax, r12;
        imul rax, r14;              // rax = mag * sens_num (2-op reg-reg)
        xor  rdx, rdx;
        div  r15;                   // rax = scaled magnitude

        // 6. Reapply sign: signed_out = (rax XOR sign_mask) - sign_mask.
        xor  rax, r13;
        sub  rax, r13;

        // Bare rax carries the signed result. Truncate to i32 by
        // masking the low 32 bits (the caller's packer places this
        // in either the low or high half of the u64 return; sign
        // extension is already in the low 32 by construction because
        // shifts + XOR/SUB on a mask of 0/-1 preserve the sign in
        // bit 31).
        // No mask needed; the packer applies shl/shr.
        jmp  ac_ax_out;

      ac_ax_zero:
        xor  rax, rax;

      ac_ax_out:
        pop  r15;
        pop  r14;
        pop  r13;
        pop  r12;
        pop  rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION L  Public apply -- both axes.
  //
  //   accel_curve_apply(row_ptr, raw_delta_x, raw_delta_y)
  //     -> accel_x_i32[31:0] | accel_y_i32[63:32]
  //
  // Invokes ac_apply_axis twice (once per axis) and packs the two i32
  // results into one u64 return. The caller unpacks:
  //
  //   let packed = accel_curve_apply(row_ptr, dx, dy);
  //   let ax = (packed as i32);              // sign-extends via cast
  //   let ay = ((packed >> 32) as i32);      // ditto
  //
  // Both axes share the row's deadzone/profile/sensitivity/curve --
  // separate per-axis tuning would use two AccelCurves (one per axis,
  // held in the KIND_POINTER_DEVICE row), which the row-body layout
  // supports (the row reserves 64 bytes = two 32-byte curves).
  // ==========================================================================

  pub let accel_curve_apply : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (row_ptr: u64) (raw_delta_x: u64) (raw_delta_y: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B9-02 (paideia-os #2280): both-axes apply. Three callee-save pushes (rbx=row_ptr, r12=raw_delta_y, r13=accel_x_result) preserve caller state and leave rsp%16 == 0 for the ac_apply_axis nested calls (entry rsp%16==8 flipped three times -> 0; matches tb_node_alloc's alignment posture in tiling_bsp.pdx). Packs (accel_x[31:0] | accel_y[63:32]) as the return. Labels prefixed ac_ap_.",
      block: {
        push rbx;
        push r12;
        push r13;
        // rsp % 16 == 0 (three pushes from entry rsp%16==8 -> 0). Aligned for nested calls.

        mov  rbx, rdi;              // rbx = row_ptr
        mov  r12, rdx;              // r12 = raw_delta_y (stash for second call)

        // First axis: ac_apply_axis(row_ptr, raw_delta_x).
        // rsi already carries raw_delta_x; only rdi needs the row_ptr copy.
        mov  rdi, rbx;
        call ac_apply_axis;
        mov  r13, rax;              // r13 = accel_x (signed i64, low 32 = i32 result)

        // Second axis: ac_apply_axis(row_ptr, raw_delta_y).
        mov  rdi, rbx;
        mov  rsi, r12;
        call ac_apply_axis;
        // rax = accel_y

        // Pack (accel_x[31:0] | accel_y[63:32]).
        //   Low half:  r13 zero-extended to u32 (low 32 bits of i32).
        //   High half: rax shifted left 32 (low 32 bits of accel_y).
        mov  r10, r13;
        shl  r10, 32;
        shr  r10, 32;               // r10 = accel_x as u32 (bits 0..31 of the i32)
        shl  rax, 32;               // rax at [63:32] = accel_y as u32
        or   rax, r10;

        pop  r13;
        pop  r12;
        pop  rbx;
        ret
      }
    }
}
