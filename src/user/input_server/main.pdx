// src/user/input_server/main.pdx -- Wave0-B8-01 (paideia-os #2274)
//
// KIND_INPUT_SERVER = 0x1D0. This is the process-cap kind for the
// input-server user-space process -- the actor referenced by
// design/compositor/pwp-spec-vocabulary.md §2.10 (KIND_INPUT_ROUTE) and
// §2.9 (KIND_SEAT) as "the input server", and the holder that the
// recovery-plane reservation was forward-declared for in
// src/user/compositor/recovery_plane_reserve.pdx:203
// (RESERVATION_HOLDER_KIND). The two ordinals MUST agree; this file
// pins 0x1D0 as the concrete KIND_INPUT_SERVER value.
//
// LIFECYCLE POSITION.
//
// The input server is a process, not a resource, and it is independent
// of svc-compositor. Boot order (see design/roadmap/next-wave-osarch.md
// and design/compositor/pwp-spec-vocabulary.md §recovery-plane):
//
//    (1) kernel maps display-plane 0 of pipe 0 as the recovery plane.
//    (2) init spawns the input server BEFORE svc-compositor.
//    (3) input server calls recovery_plane_reserve_at_boot(0x1D0)
//        (see recovery_plane_reserve.pdx:424), taking the reservation
//        so a later compositor lockup CANNOT free that plane.
//    (4) input server binds its KIND_HID_STREAM read cap (from the
//        R32 HID stream landing; paideia-os #2274 depends_on chain
//        G7-M8-001).
//    (5) init spawns svc-compositor. svc-compositor talks to the
//        input server via KIND_INPUT_ROUTE caps that the input server
//        MINTS -- svc-compositor never touches the HID stream directly.
//    (6) input server main loop dispatches HID events to routes.
//
// A compositor lockup at step (6+) does not stall the input server:
// steps (1)..(4) are held on the input-server process, and the
// recovery-plane takeover flow (recovery_plane_takeover.pdx) drives
// the display source swap to the recovery console under the input
// server's authority, not the compositor's.
//
// THIS LANDING IS A LIFECYCLE SKELETON.
//
// The concrete focus-router body (which HID event goes to which route)
// lands with G8.M2-002; this file provides:
//   - KIND_INPUT_SERVER identity and rights bitmask,
//   - InputServerFields struct + singleton cell,
//   - input_server_init factory (asserts pre-conditions, wires the
//     hid_stream + recovery_reservation ids into the singleton),
//   - input_server_main_loop skeleton (infinite loop calling
//     input_server_process_event),
//   - input_server_process_event stub (returns IS_UNHANDLED so the
//     loop shape and status contract are visible now).
//
// =============================================================================
// SECTION 0  KIND_* SLOT ALLOCATION
// =============================================================================
//
// KIND_INPUT_SERVER = 0x1D0. This ordinal is not chosen fresh here --
// it was forward-reserved by src/user/compositor/recovery_plane_reserve.pdx
// (Wave-0 Batch-6, RESERVATION_HOLDER_KIND). Wave-0 Batch-6 documented
// two forward-reservation ordinals adjacent to KIND_RECOVERY_PLANE
// (0x1C8):
//
//    0x1D0  RESERVATION_HOLDER_KIND     -- input-server process kind
//                                          (this file).
//    0x1D1  RP_COMPOSITOR_KIND_FORWARD  -- compositor process kind
//                                          (future landing).
//
// A repo-wide grep for 0x1D0 (run at landing time for this file)
// returns ONLY the RESERVATION_HOLDER_KIND references in
// recovery_plane_reserve.pdx and recovery_plane_takeover.pdx -- no
// other kind claims the slot. Pinning KIND_INPUT_SERVER here closes
// the forward reservation.
//
// =============================================================================
// SECTION 1  RIGHTS
// =============================================================================
//
// Six rights, one bit each. R_IS_ALL is the tight upper bound the
// future kernel-side KIND_INPUT_SERVER dispatcher will enforce via
// subset check on mint.
//
//   RIGHT_MINT_INPUT_ROUTE     (0x001) -- authority to mint a
//                                         KIND_INPUT_ROUTE cap
//                                         (pwp-spec-vocabulary §2.10)
//                                         binding a client surface to
//                                         a focus class. Only the
//                                         input server mints these;
//                                         svc-compositor requests a
//                                         mint but does not carry
//                                         this right.
//
//   RIGHT_MINT_SEAT            (0x002) -- authority to mint a
//                                         KIND_SEAT cap
//                                         (pwp-spec-vocabulary §2.9).
//                                         The seat groups a keyboard,
//                                         pointer, and touch group
//                                         under one focus context;
//                                         the input server owns seat
//                                         allocation.
//
//   RIGHT_HOLD_RECOVERY_PLANE  (0x004) -- authority to hold the
//                                         KIND_RECOVERY_PLANE
//                                         reservation
//                                         (recovery_plane_reserve.pdx
//                                         RIGHT_HOLD_PLANE requires
//                                         the caller be the input
//                                         server; this right is the
//                                         process-side witness). A
//                                         compositor process with
//                                         RIGHT_MINT_INPUT_ROUTE but
//                                         NOT RIGHT_HOLD_RECOVERY_PLANE
//                                         is refused
//                                         recovery_plane_reserve_at_boot.
//
//   RIGHT_READ_HID_STREAM      (0x008) -- authority to read the
//                                         KIND_HID_STREAM cap
//                                         published by the HID driver
//                                         (R32 landing; paideia-os
//                                         #2274 depends_on G7-M8-001).
//                                         Restricted to the input
//                                         server so no other user
//                                         process can drain HID.
//
//   RIGHT_QUERY_STATE          (0x010) -- read-only observability on
//                                         the input server's own
//                                         state (boot_seq, pool
//                                         heads, bound ids). Safe to
//                                         hand to a debugger or
//                                         health monitor without
//                                         granting any mint or read
//                                         surface.
//
//   RIGHT_OBSERVE              (0x020) -- weakest right; permits
//                                         subscribing to the input
//                                         server's own lifecycle
//                                         notifications (boot,
//                                         re-init, quiesce). Handed
//                                         to svc-compositor so it
//                                         can re-establish routes
//                                         after an input server
//                                         restart.
//
// Deliberately ABSENT:
//
//   R_MINT_SELF                       -- the input server is spawned
//                                         by init, not derived from
//                                         itself. There is no
//                                         mint-input-server right.
//
//   R_KILL_INPUT_SERVER               -- killing the input server is
//                                         an init-level authority
//                                         (proc management), not a
//                                         cap on this kind.
//
// R_IS_ALL = 0x03F -- the six bits above.
//
// =============================================================================
// SECTION 2  FIELDS -- 24 BYTES (SINGLETON)
// =============================================================================
//
// The input server is a SINGLETON process: exactly one exists per boot
// (see BOOT-ORDER section above). InputServerFields carries the
// process's bound-at-init identities plus the pool heads and boot
// witness. Field layout (three u64 words, packed):
//
//   [+0]  word0:  hid_stream_kind_id[31:0]           (the KIND_HID_STREAM
//                                                     cap id the process
//                                                     reads)
//               | recovery_plane_reservation_id[63:32]
//                                                    (the
//                                                     KIND_RECOVERY_PLANE
//                                                     reservation cell
//                                                     id it holds; the
//                                                     process CANNOT
//                                                     start without
//                                                     this)
//
//   [+8]  word1:  seat_pool_head[31:0]              (head of the linked
//                                                    list of minted
//                                                    KIND_SEAT caps;
//                                                    zero when empty)
//               | route_pool_head[63:32]            (head of the linked
//                                                    list of minted
//                                                    KIND_INPUT_ROUTE
//                                                    caps; zero when
//                                                    empty)
//
//   [+16] word2:  boot_seq (u64)                    (monotonic boot
//                                                    sequence -- the
//                                                    post-bump value
//                                                    of the singleton
//                                                    counter at
//                                                    successful init)
//
// A companion singleton counter _input_server_boot_seq_counter (one
// u64) sits beside the cell. rdtsc is deliberately NOT used
// (user-space effect envelope; see recovery_plane_reserve.pdx §2 for
// the same argument).
//
// The cell is scrubbed to zero by .bss at real boot; input_server_init
// re-scrubs defensively before writing.
//
// =============================================================================
// SECTION 3  FACTORY / LOOP CONTRACT
// =============================================================================
//
// input_server_init(hid_stream, recovery_reservation) -> u64 status:
//   Called ONCE per boot by init after the two prerequisite caps have
//   been bound. Refuses:
//     - hid_stream == 0                 -> IS_NULL_HID_STREAM
//     - recovery_reservation == 0       -> IS_NULL_RECOVERY
//     - singleton already initialized   -> IS_ALREADY_INIT
//   On success: populates the singleton (both ids stashed low32,
//   pool heads zeroed, boot_seq set to the post-bump counter), and
//   returns IS_OK (= 0). The natural return type is InputServerFields
//   but paideia-as does not currently return structs by value from
//   asm bodies (all sibling KIND_* factories return u64 status codes
//   with the row/singleton parked in memory -- see
//   recovery_plane_reserve.pdx sig-compat note at line 411). Callers
//   reconstruct the InputServerFields view by reading the getters
//   below once IS_OK is returned.
//
// input_server_main_loop(state):
//   Entered ONCE per boot after input_server_init succeeds. state (in
//   rdi) is a pointer to the InputServerFields singleton (the caller
//   supplies the pointer explicitly so the loop is testable against a
//   scratch cell in the future). The body is a TIGHT LOOP that calls
//   input_server_process_event on a dummy event value until an
//   external termination path fires (there is none today -- the loop
//   is intended to run for the process lifetime). The real focus
//   router body arrives with G8.M2-002; until then the loop shape is
//   observable and stable.
//
// input_server_process_event(event) -> u64:
//   Stub for the G8.M2+ focus-router. Always returns IS_UNHANDLED
//   (0xFFFFEB71). Callers can already build against the u64 return
//   contract (0 = handled, non-zero = not-handled classifier code).
//
// =============================================================================
// SECTION 4  FAILURE TAXONOMY 0xFFFFEB70..0xFFFFEB7F
// =============================================================================
//
// A repo-wide grep at landing time confirms 0xFFFFEB70..0xFFFFEB7F is
// unclaimed across src/ (adjacent claimed bands: 0xFFFFEB68..0xFFFFEB6F
// and 0xFFFFEBEA..0xFFFFEBEF). The nearby-but-disjoint
// 0xFFFFEB00..0xFFFFEB0F band (KIND_SIG_KEY, kind_sig_key.pdx §3) is
// fully occupied, so codes in that range cannot be used even though
// the row assignment for this file suggested a 0xFFFFEB0x layout.
// This landing takes 0xFFFFEB70..0xFFFFEB7F and reserves the rest of
// the band for future input-server surfaces (focus router, seat mint,
// route mint) so all input-server classifier codes live in one 16-slot
// window.

module Main = structure {

  // ==========================================================================
  // Identity.
  // ==========================================================================

  pub let KIND_INPUT_SERVER : u64 = 0x1D0

  // Rights (see §1).
  pub let RIGHT_MINT_INPUT_ROUTE    : u64 = 0x001
  pub let RIGHT_MINT_SEAT           : u64 = 0x002
  pub let RIGHT_HOLD_RECOVERY_PLANE : u64 = 0x004
  pub let RIGHT_READ_HID_STREAM     : u64 = 0x008
  pub let RIGHT_QUERY_STATE         : u64 = 0x010
  pub let RIGHT_OBSERVE             : u64 = 0x020
  pub let R_IS_ALL                  : u64 = 0x03F

  // Cell layout.
  pub let IS_CELL_BYTES : u64 = 24
  pub let IS_CELL_WORDS : u64 = 3

  // Cross-reference (see recovery_plane_reserve.pdx:203). MUST equal
  // KIND_INPUT_SERVER; drift is caught by both sides because the
  // reservation factory refuses any holder value NOT equal to
  // RESERVATION_HOLDER_KIND, and the input-server init contract is
  // meaningless if this file's KIND_INPUT_SERVER does not match.
  pub let IS_MATCHES_RESERVATION_HOLDER : u64 = 0x1D0

  // Failure taxonomy -- 0xFFFFEB70..0xFFFFEB7F (see §4).
  pub let IS_OK               : u64 = 0
  pub let IS_ALREADY_INIT     : u64 = 0xFFFFEB70
  pub let IS_UNHANDLED        : u64 = 0xFFFFEB71
  pub let IS_NULL_HID_STREAM  : u64 = 0xFFFFEB72
  pub let IS_NULL_RECOVERY    : u64 = 0xFFFFEB73
  pub let IS_DECODE_BAD       : u64 = 0xFFFFFFFFFFFFFFFF

  // ==========================================================================
  // Struct shape.
  //
  // Declared for documentation and for future consumers that want to
  // load fields via a typed accessor. The singleton cell backing the
  // process state is _input_server_fields_cell below, whose byte
  // layout matches this struct's field order (two u32/u32 packed
  // words at +0 and +8, then a u64 at +16). Explicit reserved-
  // padding is NOT modelled as a struct field because paideia-as
  // structs do not currently express alignment padding at
  // intermediate offsets.
  // ==========================================================================

  struct InputServerFields {
    hid_stream_kind_id: u32,
    recovery_plane_reservation_id: u32,
    seat_pool_head: u32,
    route_pool_head: u32,
    boot_seq: u64
  }

  // ==========================================================================
  // Singleton state.
  //
  // ONE input-server process per boot. The cell is scrubbed by boot
  // to zero via .bss; input_server_init bumps the counter once and
  // stamps the singleton. A second init call sees the counter
  // non-zero and returns IS_ALREADY_INIT without touching the cell.
  //
  // in_use is implicit in boot_seq > 0 rather than a separate flag:
  // the counter is bumped BEFORE the cell is written, so a torn init
  // (counter non-zero, cell partially written) still refuses a second
  // init and the getters see zeros in unwritten fields.
  // ==========================================================================

  pub let mut _input_server_fields_cell     : [u8; 24] = uninit @align(8)
  pub let mut _input_server_boot_seq_counter : [u64; 1] = uninit @align(8)

  // ==========================================================================
  // Fingerprint tag.
  //
  // ONE tag ending [legacy: ... OK] per softarch discipline. The
  // future kernel-side dispatcher's init body will emit this string
  // via klog_s1 on the successful init path; until that landing
  // arrives the string is a data-only constant and needs an
  // allowlist entry in tools/verify-fingerprint-coverage.sh with
  // reason "input-server dispatcher not yet landed (G8.M1-001;
  // focus router at G8.M2-002)". Adding that allowlist entry is a
  // separate landing (this file must not touch tools/), and follows
  // the exact posture recovery_plane_reserve.pdx uses today.
  // ==========================================================================

  pub let pdx_kind_input_server_meta : [u8; 52] = "input server main ok [legacy: INPUT SERVER MAIN OK]\0"

  // ==========================================================================
  // Predicates.
  // ==========================================================================

  // input_server_is_init() -> 1 iff the singleton counter is non-zero.
  // The counter is bumped exactly once by a successful init, so this
  // is equivalent to "has input_server_init succeeded at least once
  // this boot". Callers that need the strong contract (init succeeded
  // AND the cell was fully written) should also read the getters
  // below; a torn init leaves the counter set but returns zero from
  // the un-written getter fields.
  pub let input_server_is_init : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B8-01 (paideia-os #2274): 1 iff _input_server_boot_seq_counter[0] is nonzero. No hardware timestamp; user-space effect envelope. Labels prefixed input_server_ii_.",
      block: {
        lea r10, [rip + _input_server_boot_seq_counter];
        mov rax, [r10];
        cmp rax, 0;
        je  input_server_ii_no;
        mov rax, 1;
        ret;
      input_server_ii_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Getters (RIGHT_QUERY_STATE surface).
  // ==========================================================================

  pub let input_server_get_hid_stream : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B8-01 (paideia-os #2274): read hid_stream_kind_id[31:0] from cell word0. Zero-extend of low 32 via shl/shr to avoid `and rN, 0xFFFFFFFF` idiom on r11 (U1615). Labels prefixed input_server_ghs_.",
      block: {
        lea r10, [rip + _input_server_fields_cell];
        mov rax, [r10 + 0];
        shl rax, 32;
        shr rax, 32;
        ret
      }
    }

  pub let input_server_get_recovery_reservation : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B8-01 (paideia-os #2274): read recovery_plane_reservation_id[63:32] from cell word0. Labels prefixed input_server_grr_.",
      block: {
        lea r10, [rip + _input_server_fields_cell];
        mov rax, [r10 + 0];
        shr rax, 32;
        ret
      }
    }

  pub let input_server_get_seat_pool_head : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B8-01 (paideia-os #2274): read seat_pool_head[31:0] from cell word1. Zero-extend via shl/shr. Labels prefixed input_server_gsp_.",
      block: {
        lea r10, [rip + _input_server_fields_cell];
        mov rax, [r10 + 8];
        shl rax, 32;
        shr rax, 32;
        ret
      }
    }

  pub let input_server_get_route_pool_head : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B8-01 (paideia-os #2274): read route_pool_head[63:32] from cell word1. Labels prefixed input_server_grp_.",
      block: {
        lea r10, [rip + _input_server_fields_cell];
        mov rax, [r10 + 8];
        shr rax, 32;
        ret
      }
    }

  pub let input_server_get_boot_seq : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B8-01 (paideia-os #2274): read boot_seq (u64) from cell word2. Labels prefixed input_server_gbs_.",
      block: {
        lea r10, [rip + _input_server_fields_cell];
        mov rax, [r10 + 16];
        ret
      }
    }

  // ==========================================================================
  // One-shot init factory.
  //
  // input_server_init(hid_stream, recovery_reservation) -> u64:
  //   IS_OK on success, else one of IS_ALREADY_INIT,
  //   IS_NULL_HID_STREAM, IS_NULL_RECOVERY.
  //
  // Called ONCE by boot code after the two prerequisite caps have
  // been bound to the input-server process. Populates the module
  // singleton. On success:
  //   - hid_stream low32 stashed into word0[31:0].
  //   - recovery_reservation low32 stashed into word0[63:32].
  //   - seat_pool_head and route_pool_head baked to 0 (both pools
  //     are empty at init; mint entry points will grow them in the
  //     G8.M2 landings).
  //   - boot_seq is the post-bump value of the singleton counter
  //     (first successful init receives 1).
  //
  // A second call sees counter non-zero and returns IS_ALREADY_INIT
  // without touching the cell.
  //
  // Sig-compat note: the natural return type is InputServerFields,
  // but paideia-as does not currently return structs by value from
  // asm bodies (mirrors recovery_plane_reserve.pdx:411 discussion).
  // Callers reconstruct the InputServerFields view via the getters
  // above once IS_OK is returned.
  //
  // Frame: no callee-save pushes needed (no nested call), so entry
  // rsp%16==8 stays through the whole body. r11 is used as scratch
  // for the singleton pointer stash (NOT for a low32 mask -- U1615
  // blocks `and r11, 0xFFFFFFFF`; the mask idiom is applied to rax
  // or r10 instead).
  // ==========================================================================

  pub let input_server_init : (u64, u64) -> u64 !{mem} @{} =
    fn (hid_stream: u64, recovery_reservation: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B8-01 (paideia-os #2274): one-shot init factory. Order: (1) refuse if hid_stream (rdi) == 0 -> IS_NULL_HID_STREAM. (2) refuse if recovery_reservation (rsi) == 0 -> IS_NULL_RECOVERY. (3) refuse if singleton counter already non-zero -> IS_ALREADY_INIT. (4) stash rdi and rsi into r8/r9 (r8 = hid_stream, r9 = recovery_reservation) before touching rax. (5) bump _input_server_boot_seq_counter via load-inc-store (no `add reg,[mem]`). (6) publish cell: word0 = hid_stream_low32 | (recovery_reservation_low32 << 32), word1 = 0 (both pool heads zero), word2 = boot_seq. Zero-extend uses `mov r10, 0xFFFFFFFF; and rN, r10` to avoid the U1615-blocked `and r11, 0xFFFFFFFF` idiom -- r11 is never masked, only used to hold pointers. No `test`, no `add reg,[mem]`, no `mov_bzx`/`mov_wzx`. Entry rsp%16==8 stays; no callee-save pushes. Labels prefixed input_server_i_.",
      block: {
        // (1) hid_stream null check.
        cmp rdi, 0;
        je  input_server_i_null_hid;

        // (2) recovery_reservation null check.
        cmp rsi, 0;
        je  input_server_i_null_rec;

        // (3) already-init check. Counter is bumped exactly once on
        //     first successful init; non-zero means we've been here.
        lea r11, [rip + _input_server_boot_seq_counter];
        mov rax, [r11];
        cmp rax, 0;
        jne input_server_i_already;

        // (4) stash the two arg registers before rax is reused.
        mov r8, rdi;                     // r8 = hid_stream
        mov r9, rsi;                     // r9 = recovery_reservation

        // (5) bump counter via load-inc-store.
        mov rax, [r11];
        add rax, 1;
        mov [r11], rax;
        mov rcx, rax;                    // rcx = boot_seq (avoids
                                          // shadowing r8/r9)

        // (6) publish cell.
        //     word0[31:0]  = hid_stream low32
        //     word0[63:32] = recovery_reservation low32 << 32
        //
        //     Build word0 in rax:
        //       rax = r8 low32
        //       rdx = r9 low32
        //       rdx <<= 32
        //       rax = rax | rdx
        mov r10, 0xFFFFFFFF;
        mov rax, r8;
        and rax, r10;                    // rax = hid_stream low32
        mov rdx, r9;
        and rdx, r10;                    // rdx = recovery low32
        shl rdx, 32;
        or  rax, rdx;                    // rax = word0

        lea r10, [rip + _input_server_fields_cell];
        mov [r10 + 0], rax;              // word0

        xor rax, rax;
        mov [r10 + 8], rax;              // word1: both pool heads 0
        mov [r10 + 16], rcx;             // word2: boot_seq

        xor rax, rax;                    // IS_OK
        ret;

      input_server_i_null_hid:
        mov rax, 0xFFFFEB72;             // IS_NULL_HID_STREAM
        ret;

      input_server_i_null_rec:
        mov rax, 0xFFFFEB73;             // IS_NULL_RECOVERY
        ret;

      input_server_i_already:
        mov rax, 0xFFFFEB70;             // IS_ALREADY_INIT
        ret
      }
    }

  // ==========================================================================
  // Event stub (G8.M2+ focus router lands the real body).
  //
  // input_server_process_event(event) -> u64:
  //   Always returns IS_UNHANDLED (0xFFFFEB71). The event value
  //   (in rdi) is intentionally unread: the stub exists so the loop
  //   above can call a real symbol with a real u64 return contract,
  //   and so a later landing can grep for this stub as the drop-in
  //   point.
  // ==========================================================================

  pub let input_server_process_event : (u64) -> u64 !{} @{} =
    fn (event: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave0-B8-01 (paideia-os #2274): stub returning IS_UNHANDLED (0xFFFFEB71). Body lands with G8.M2-002 focus router. rdi (event) is unread; no memory or hardware effect. Labels prefixed input_server_pe_.",
      block: {
        mov rax, 0xFFFFEB71;             // IS_UNHANDLED
        ret
      }
    }

  // ==========================================================================
  // Main loop skeleton.
  //
  // input_server_main_loop(state):
  //   Entered ONCE per boot after input_server_init succeeds. state
  //   (in rdi) is a pointer to the InputServerFields singleton (the
  //   caller supplies the pointer explicitly so the loop is testable
  //   against a scratch cell in the future).
  //
  //   The body is a tight infinite loop: it calls
  //   input_server_process_event(0) repeatedly. The real focus router
  //   (G8.M2-002) replaces the argument construction with a genuine
  //   HID event drain from the KIND_HID_STREAM cap addressed via the
  //   state pointer. Today, the return value from process_event is
  //   deliberately IGNORED (the stub always returns IS_UNHANDLED); the
  //   real router will branch on it.
  //
  //   Frame:
  //     - entry rsp%16 == 8 (post-ret-push).
  //     - We push rbx to save the state pointer across the call
  //       (rbx is callee-saved per SysV AMD64). Post-push rsp%16 == 0,
  //       which is the required alignment for `call`.
  //     - The pop rbx / ret tail is unreachable in normal operation
  //       (the loop never exits) but is emitted for the well-formed
  //       procedure shape the encoder expects.
  // ==========================================================================

  pub let input_server_main_loop : (u64) -> () !{mem} @{} =
    fn (state: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B8-01 (paideia-os #2274): infinite loop skeleton. push rbx (align stack for call; save state pointer across call); loop: xor rdi,rdi (event = 0 stub); call input_server_process_event; jmp loop. Unreachable pop rbx / ret tail for well-formed shape. Real HID-drain body arrives with G8.M2-002. Labels prefixed input_server_ml_.",
      block: {
        push rbx;                        // callee-save; realign to 16
        mov  rbx, rdi;                   // stash state pointer
      input_server_ml_top:
        xor  rdi, rdi;                   // event = 0 (stub)
        call input_server_process_event;
        jmp  input_server_ml_top;
        // unreachable normal exit
        pop  rbx;
        ret
      }
    }

  // ==========================================================================
  // Defensive boot-time reset (.bss is already zero at real boot).
  // ==========================================================================

  pub let input_server_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave0-B8-01 (paideia-os #2274): zero the singleton cell (three u64 words) and the boot-seq counter (one u64). Defensive re-scrub; mirrors rp_init in src/user/compositor/recovery_plane_reserve.pdx and hmk_init in src/user/color/hdr_metadata_kind.pdx. Labels prefixed input_server_r_.",
      block: {
        lea r10, [rip + _input_server_fields_cell];
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        lea r10, [rip + _input_server_boot_seq_counter];
        mov [r10 + 0],  rax;
        ret
      }
    }
}
