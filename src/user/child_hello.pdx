// src/user/child_hello.pdx — R15-M6-009 (#560) — child_hello user binary
//
// Minimal self-contained user program used by the fork/exec/wait smoke:
// prints "CHILD HELLO 42\n" via sys_write(1, msg, 15), then exits with
// status 42 via sys_exit(42).
//
// Design choice — self-contained, no syscall_shim link dependency:
//   child_hello inlines the two syscalls it needs (write, exit) directly
//   inside _start. This keeps the ELF tiny (<= 200 bytes .text), removes
//   any linker collision with the shared syscall_shim.o consumed by
//   init.elf and shell.elf, and matches the "one .pdx file, one .elf"
//   pattern used by the R15/R16 witness fixtures. build-user.sh (below)
//   classifies child_hello into its own object set for the same reason.
//
// SC+ ID discipline (frozen per R17-M1-001 / #610):
//   1  = sys_write(fd, buf, count)
//   60 = sys_exit(status)  (never returns)
//
// Fingerprint contribution (#560 acceptance criteria, deferred runtime):
//   CHILD HELLO 42
//   WAIT: pid=2 status=42
//
// Runtime landing status (this commit):
//   ELF is built + embedded in kernel .rodata.userbin + validated by a
//   kernel-side structural witness (R15 CHILD HELLO EMBED OK). The user-
//   space fork+exec+wait chain that emits the on-wire "CHILD HELLO 42\n"
//   line is deferred to the follow-up that unblocks the SC+ execve
//   dispatcher (paideia-os #671) and reverts the shell-bypass path in
//   kernel_main (#678).

module ChildHello = structure {
  // "CHILD HELLO 42\n" — 15 bytes payload + NUL terminator = 16 bytes storage.
  // NUL is not written to the wire; sys_write is length-bounded to 15.
  pub let msg : [u8; 16] = "CHILD HELLO 42\n\0"
  pub let msg_len : u64 = 15

  // _start — user program entry point. Two syscalls, then unreachable hlt.
  pub let _start : () -> () !{mem, sysreg} @{fs, sched} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {fs, sched},
      justification: "R15-M6-009 (#560): child_hello _start. Inlines the two SC+ syscalls it needs so the binary is self-contained (no syscall_shim link dependency, no collision with init.elf / shell.elf object sets). Sequence: (1) sys_write(1, msg, 15) — SC+ ID 1, SysV args rdi=fd, rsi=buf, rdx=count, no arg shuffle (arity 3 < 4). (2) sys_exit(42) — SC+ ID 60, SysV arg rdi=status. sys_exit never returns; the trailing hlt is defensive belt-and-suspenders for the impossible fallthrough. Effects/caps chosen as the union of sys_write ({mem, sysreg} @ {fs}) and sys_exit ({sysreg} @ {sched}) per the SC+ shim declarations in src/user/syscall_shim.pdx.",
      block: {
        // --- sys_write(1, msg, 15) ---
        mov rdi, 1;                     // fd = stdout
        lea rsi, [rip + msg];           // buf = &msg
        mov rdx, 15;                    // count = 15 (excludes trailing NUL)
        mov rax, 1;                     // SC+ ID 1
        syscall;

        // --- sys_exit(42) ---
        mov rdi, 42;                    // status = 42
        mov rax, 60;                    // SC+ ID 60
        syscall;

        // Unreachable. sys_exit does not return; leaving a hlt here is a
        // defensive stop in case the kernel side ever returns from ID 60
        // (which would itself be a bug, but we don't want to fall through
        // into whatever bytes the linker places next).
        hlt
      }
    }
}
