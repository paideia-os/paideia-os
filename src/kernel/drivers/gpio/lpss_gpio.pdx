// src/kernel/drivers/gpio/lpss_gpio.pdx — Wave 59 D7 (paideia-os#2524)
//
// Intel LPSS / PCH pin-control + GPIO SKELETON for Wave 59 D7. The
// R30.M6-002 (#1076) driver that already lives at
// `src/kernel/core/drivers/gpio/lpss_gpio.pdx` owns the probe path,
// the community-table pin → register-address resolver, and the window
// capability bind. THIS file is deliberately NOT that one. It is the
// Wave 59 D7 driver-facing seam the issue scope describes:
//
//   * read _CRS pin-group descriptors (the parsed form the Wave 59 I3
//     ACPI _CRS parser at `src/kernel/core/acpi/crs.pdx` hands over as
//     a `CrsInfo` pointer) and derive pin-group → function routes,
//   * expose direction / value / interrupt-mode primitives
//     (`lpss_gpio_set_direction`, `lpss_gpio_read`, `lpss_gpio_write`)
//     the KIND_INTERRUPT (Wave 65 D1) + driver-registry (Wave 64 D4)
//     callers can bind against,
//   * emit the Wave 59 `GPIO INIT OK n_pins=<n> port=<port>`
//     fingerprint one line per bring-up so a boot-witness programme
//     can count the entry.
//
// Posture: EVERY body here is a STUB per the Wave 59 D7 skeleton
// directive. The register offsets and the error taxonomy are frozen
// at this skeleton stage so the follow-up slice can land the real
// MMIO bodies without a signature or constant churn. The static
// storage, the fingerprint tag, and the counting bumps are real so
// an operator can see which seam a boot touches even before the
// hardware body lands.
//
// =============================================================================
// §0  WHY THIS FILE IS A SKELETON AT A DIFFERENT PATH
// =============================================================================
//
// The pre-existing R30.M6-002 driver at
// `src/kernel/core/drivers/gpio/lpss_gpio.pdx` is the mature probe +
// community resolver (1846 LOC) that mints the KIND_OP_REGION window
// capability and resolves an ABSOLUTE pin number into a
// (community, pad_index) pair. It does NOT consume a parsed _CRS
// buffer nor expose a flat (pin → direction/value/int-mode) surface.
// Wave 59 D7 fills exactly those two gaps as a SKELETON. The two
// drivers coexist because their `pub let` globals here are prefixed
// `lpg_d7_` / `LPG_D7_` and the five entrypoints
// (`lpss_gpio_init`, `lpss_gpio_set_direction`, `lpss_gpio_read`,
// `lpss_gpio_write`, `lpss_gpio_route_crs`) are names the sibling
// driver does not use. `module LpssGpio` reappears here because the
// paideia-as module-basename rule requires it; the linker permits
// same-named modules across files (e.g. `module Probe` × 10).
//
// =============================================================================
// §1  REGISTER MAP (Alder Lake / Raptor Lake / Meteor Lake PCH-SOC)
// =============================================================================
//
// Per-pad PADCFG window (each pin owns a 16-byte slice starting at
// PADBAR + pin * PAD_STRIDE):
//
//   +0x00  PADCFG0 — direction, output level, input-level readback,
//                     pad-mode (native function vs. GPIO)
//   +0x04  PADCFG1 — interrupt trigger-mode (edge/level), inversion,
//                     interrupt-routing (IOxAPIC vs. SCI vs. NMI),
//                     termination (pull-up / pull-down)
//   +0x08  PADCFG2 — timing (debounce) — not touched in the skeleton
//   +0x0C  PADCFG3 — scratch — never touched by the kernel driver
//
// Per-controller interrupt plumbing (community-relative; a controller
// may carry several communities each with its own GPI_IS/IE/STS set
// — this skeleton presumes exactly one community for the bring-up
// surface, which is the T14 G4 case for the eDP backlight pin group;
// the real body loops over communities derived from the probe):
//
//   +0x100 GPI_IS  — interrupt STATUS, write-1-to-clear per pad
//   +0x120 GPI_IE  — interrupt ENABLE, read-write per pad
//   +0x140 GPE0_STS — General Purpose Event status (routed to the SCI)
//
// All register accesses are 32-bit per Intel pin-control bspec §14.1
// ("any wider or narrower access is undefined").
//
// =============================================================================
// §2  CrsInfo CONSUMPTION (lpss_gpio_route_crs)
// =============================================================================
//
// The Wave 59 I3 CrsInfo struct (`src/kernel/core/acpi/crs.pdx`, 296
// bytes, 37 × u64 slots) carries bus / mmio / io windows for the PCI
// root bridge. It does NOT yet carry GPIO Connection descriptors
// (ACPI 6.5 §6.4.3.8.1) or vendor-defined pin-group blobs — those
// are the Wave 59 D5 ACPICA walker's domain (which lives in
// user-space per the Wave 71 landing). The follow-up slice extends
// CrsInfo with a `[u64; 32] pin_group_pins` array and a
// `[u64; 32] pin_group_funcs` array; this skeleton accepts the
// pointer, validates it, bumps `_lpg_d7_route_count`, and returns 0
// routes extracted. That is the correct no-op shape — a CrsInfo
// published by the current parser has no pin-group entries, so
// "zero routes" is the honest answer the current I3 parser can
// support.
//
// =============================================================================
// §3  cap_handler_gpio_pin — SLOT STATUS
// =============================================================================
//
// Grep of `src/kernel/core/cap/invoke.pdx` shows the kind dispatch
// table carries `cap_handler_gpio_line` (slot 29 call site) but NOT
// `cap_handler_gpio_pin`. No slot has been reserved for a per-pin
// IPC entrypoint; the KIND_GPIO_LINE capability
// (`src/kernel/core/cap/kind_gpio_line.pdx`) owns the single-pin
// surface today. This skeleton therefore does NOT add a
// `cap_handler_gpio_pin` symbol — doing so would be a dead-link
// decoration. The follow-up slice (if the driver-registry v2 picks
// up a per-pin kind) can land it alongside the invoke-table edit.
//
// =============================================================================
// §4  ENCODER POSTURE (paideia-as v0.36.81)
// =============================================================================
//
//   G1 (sized stores): every u32 store uses mov_d so the counter
//      fields stay 4-byte sized; every u64 is a plain mov.
//   G4 (full-register compares): every compare in this file is
//      against a full 64-bit register, no `cmp al, imm` anywhere.
//   No `test rN, rN` — equality against zero is `cmp rN, 0`.
//   No `and r, imm64` — every mask fits in imm32 (or none at all,
//      since the skeleton bodies do not read-modify-write).
//   No two-operand `imul r, imm` — pin × stride is folded with
//      `shl r, 4` because PAD_STRIDE is 0x10 (a power of two) and
//      a left-shift-by-four has one encoding form.
//   Multiline `pub let` string decls are forbidden by the pdx
//      parser; every tag below is one line.
//   Module basename matches filename basename: lpss_gpio.pdx →
//      module LpssGpio.
//   Reserved labels: every label in this file is prefixed `lpg_d7_`
//      so none collides with the `lpg_` labels in the sibling
//      R30.M6-002 driver and none accidentally spells `loop`, `if`,
//      or `let`.
//
// =============================================================================
// §5  RSP ALIGNMENT RECIPE
// =============================================================================
//
// Each leaf body ending with `klog_s1_d2` (used only by
// `lpss_gpio_init` here) carries a 3-push callee-save prologue
// (rbx, r12, r13) + one `sub rsp, 8` + one `push rax` for the
// klog_s1_d2 seventh-arg; prologue totals 32 B so entry rsp%16==8
// flips to rsp%16==0 for the call. The non-init bodies are
// register-only and single-ret, no stack adjustment at all.
//
// =============================================================================

module LpssGpio = structure {

  // ==========================================================================
  // §A  Register offsets (community-relative, Alder/Raptor/Meteor Lake PCH)
  // ==========================================================================

  pub let LPG_D7_PADCFG0     : u64 = 0x00
  pub let LPG_D7_PADCFG1     : u64 = 0x04
  pub let LPG_D7_PADCFG2     : u64 = 0x08
  pub let LPG_D7_PADCFG3     : u64 = 0x0C
  pub let LPG_D7_PAD_STRIDE  : u64 = 0x10

  pub let LPG_D7_GPI_IS      : u64 = 0x100
  pub let LPG_D7_GPI_IE      : u64 = 0x120
  pub let LPG_D7_GPE0_STS    : u64 = 0x140

  // PADCFG0 field bits (direction + output level). PADCFG0[0] is the
  // output level the pad drives when GPIOTXDIS==0; PADCFG0[1] is the
  // input level the pad reads back when GPIORXDIS==0. The direction
  // writes under PADCFG0[8] (GPIOTXDIS) and PADCFG0[9] (GPIORXDIS):
  // the two bits are CLEARED, not SET, to enable the respective
  // half, which is the trap the follow-up slice must land correctly.
  pub let LPG_D7_PADCFG0_TX_VAL    : u64 = 0x00000001
  pub let LPG_D7_PADCFG0_RX_VAL    : u64 = 0x00000002
  pub let LPG_D7_PADCFG0_GPIOTXDIS : u64 = 0x00000100
  pub let LPG_D7_PADCFG0_GPIORXDIS : u64 = 0x00000200
  pub let LPG_D7_PADCFG0_PMODE_GPIO : u64 = 0x00000000

  // ==========================================================================
  // §B  Direction + interrupt-mode constants (public ABI)
  // ==========================================================================

  pub let LPG_D7_DIR_INPUT   : u64 = 0
  pub let LPG_D7_DIR_OUTPUT  : u64 = 1

  pub let LPG_D7_INT_NONE    : u64 = 0
  pub let LPG_D7_INT_EDGE_RISING  : u64 = 1
  pub let LPG_D7_INT_EDGE_FALLING : u64 = 2
  pub let LPG_D7_INT_EDGE_BOTH    : u64 = 3
  pub let LPG_D7_INT_LEVEL_HIGH   : u64 = 4
  pub let LPG_D7_INT_LEVEL_LOW    : u64 = 5

  // Pin space bound. The real bodies read this from the probe's
  // community table; the skeleton clamps against the init-time
  // `n_pins` argument instead and refuses any pin >= it with
  // LPG_D7_ERR_BAD_PIN. 1024 is the compile-time cap purely so a
  // malformed init call that passes n_pins == 0xFFFFFFFF cannot wrap
  // the register-offset multiply.
  pub let LPG_D7_PIN_HARD_MAX : u64 = 1024

  // ==========================================================================
  // §C  Failure taxonomy — band 0xFFFFFE70..0xFFFFFE7F
  //
  // Disjoint from:
  //   GPIO_IO_*       0xFFFFFF08..0F  (sibling)
  //   GPIO_LINE_*     0xFFFFFF10..1F  (kind_gpio_line.pdx)
  //   LPSS_GPIO_*     0xFFFFFF20..2F  (R30.M6-002 probe)
  //   DW_IO_*         0xFFFFFF30..3F  (sibling)
  //   LPSS_I2C_*      0xFFFFFF40..5F  (sibling)
  //   GPIO_PAD_*      0xFFFFFEE0..EF  (gpio_pad.pdx)
  //   GPIO_PAD_SUB_*  0xFFFFFEE4..E7  (gpio_isr.pdx)
  //
  // The 0xFFFFFE70..0xFFFFFE7F band is NEW and reserved for Wave 59
  // D7. A skeleton refusal and the real-body refusal must be the
  // SAME code so an operator debugging a boot after the follow-up
  // slice lands reads the same symbol they read today.
  // ==========================================================================

  pub let LPG_D7_OK            : u64 = 0
  pub let LPG_D7_ERR_BAD_PIN   : u64 = 0xFFFFFE7F
  pub let LPG_D7_ERR_BAD_DIR   : u64 = 0xFFFFFE7E
  pub let LPG_D7_ERR_BAD_VAL   : u64 = 0xFFFFFE7D
  pub let LPG_D7_ERR_BAD_MMIO  : u64 = 0xFFFFFE7C
  pub let LPG_D7_ERR_NULL_CRS  : u64 = 0xFFFFFE7B
  pub let LPG_D7_ERR_NULL_OUT  : u64 = 0xFFFFFE7A
  pub let LPG_D7_ERR_NOT_INIT  : u64 = 0xFFFFFE79
  pub let LPG_D7_ERR_PIN_RANGE : u64 = 0xFFFFFE78

  // ==========================================================================
  // §D  Static storage — single-controller skeleton
  //
  // The skeleton presumes exactly one LPSS GPIO controller is active
  // at a time (the T14 G4 bring-up case). The follow-up slice
  // generalises these to a `[u64; N]` table keyed on controller_id
  // the same way the sibling R30.M6-002 driver does.
  //
  // Every field is a plain u64 for alignment regardless of its
  // logical width (n_pins is a count, port is an index — both fit
  // in u16s on real hardware but living in u64 slots keeps the
  // fingerprint emit sites simple).
  // ==========================================================================

  pub let mut _lpg_d7_mmio_base   : u64 = 0
  pub let mut _lpg_d7_n_pins      : u64 = 0
  pub let mut _lpg_d7_port        : u64 = 0
  pub let mut _lpg_d7_inited      : u64 = 0
  pub let mut _lpg_d7_set_dir_ct  : u64 = 0
  pub let mut _lpg_d7_read_ct     : u64 = 0
  pub let mut _lpg_d7_write_ct    : u64 = 0
  pub let mut _lpg_d7_route_ct    : u64 = 0

  // Route output — the real body writes (pin, func) pairs into the
  // caller's `out_routes` buffer. The skeleton bounds it to 32 pairs
  // (16 u64 × 2) so a follow-up slice that extends CrsInfo to carry
  // GPIO Connection descriptors has a settled contract to land
  // against. 32 pairs is twice the T14 G4 count (which is 13 at
  // Wave 59 I3 capture time).
  pub let LPG_D7_MAX_ROUTES : u64 = 32

  // ==========================================================================
  // §E  Fingerprint tag + keys
  //
  // Single INFO-level line emitted by `lpss_gpio_init` only. Shape:
  //
  //   GPIO INIT OK n_pins=<n> port=<port>
  //
  // matches `tests/fingerprints/lpss_gpio.golden`. The two KVs are
  // decimal (klog_s1_d2 wrapper); fmt_letter '0x64' is picked
  // automatically by the wrapper.
  // ==========================================================================

  pub let lpg_d7_tag_init_ok : [u8; 13] = "GPIO INIT OK\0"
  pub let lpg_d7_k_n_pins    : [u8; 7]  = "n_pins\0"
  pub let lpg_d7_k_port      : [u8; 5]  = "port\0"

  // ==========================================================================
  // §F  lpss_gpio_init(mmio_base, n_pins) -> u64
  //
  // Zero every statistic slot, record the two inputs, flip the
  // `_lpg_d7_inited` latch, and emit the Wave 59 fingerprint.
  //
  // NO HARDWARE PROBE — this is the Wave 59 D7 skeleton directive:
  // the real body (follow-up slice) does the per-community pad walk
  // via the R30.M6-002 probe's community table. The skeleton
  // satisfies the counting fingerprint discipline so the Wave 59
  // boot witness can see "GPIO INIT OK ..." even before the real
  // body lands.
  //
  // Returns LPG_D7_OK (0). Never fails — a zero `mmio_base` is a
  // VALID skeleton input (the dormant QEMU arm) and so is a zero
  // `n_pins`.
  //
  // SysV: rdi = mmio_base, rsi = n_pins.
  // Stack recipe: 3 callee-save pushes (rbx, r12, r13 = 24 B;
  // entry rsp%16 == 8 → 32, aligned); then `sub rsp, 8` + `push rax`
  // for the klog_s1_d2 seventh-arg (16 B total), %16 == 0 at the
  // nested CALL.
  // ==========================================================================

  pub let lpss_gpio_init : (u64, u64) -> u64 !{mem, sysreg} @{boot} =
    fn (mmio_base: u64, n_pins: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot},
      justification: "Wave 59 D7 (paideia-os#2524) skeleton: zero every stats slot, record (mmio_base, n_pins) into _lpg_d7_mmio_base / _lpg_d7_n_pins / _lpg_d7_port (port defaults to 0 at skeleton stage; the follow-up slice sources it from the Wave 59 I3 CrsInfo pin-group field), flip the _lpg_d7_inited latch, and emit the single 'GPIO INIT OK n_pins=<n> port=<port>' INFO fingerprint via klog_s1_d2. NO hardware probe at skeleton stage — the real body (follow-up slice) walks the R30.M6-002 driver's community table and reads REVID + PADBAR per community before admitting the controller. Register plan: 3-push callee-save prologue (rbx = mmio_base saved, r12 = n_pins saved, r13 = unused scratch for symmetry with the follow-up slice's community-walk register plan). Entry rsp%16 == 8 (SysV); after 3 pushes rsp%16 == 0, which is the pre-CALL requirement for every nested klog_s1_d2. For the klog_s1_d2 7th-arg (v2 = port) we do `sub rsp, 8` (pad) + `push rax` (stack arg); after CALL `add rsp, 16` reclaims both slots and restores body rsp%16 == 0. Zero-stat sequence: eight `mov [rip + _lpg_d7_...], 0` stores — bare u64 stores, no mov_d needed because each slot is a u64 and a REX.W mov writes exactly 8 bytes. Record sequence: two `mov [rip + ...], reg` stores for mmio_base + n_pins; the port is defaulted to 0 by the first zero-stat sweep so no explicit store needed. Returns xor rax, rax (LPG_D7_OK). Labels prefixed lpg_d7_init_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                       // rbx = mmio_base (saved)
        mov r12, rsi;                       // r12 = n_pins (saved)

        // --- Zero every stats slot before recording the new inputs.
        //
        // A re-init call must see cleared counters; otherwise a
        // bring-up witness would be unable to tell a fresh init
        // from one that reused a stale controller. Each slot is a
        // u64; a plain `mov [mem], 0` writes 8 bytes.
        xor rax, rax;
        mov [rip + _lpg_d7_mmio_base],  rax;
        mov [rip + _lpg_d7_n_pins],     rax;
        mov [rip + _lpg_d7_port],       rax;
        mov [rip + _lpg_d7_inited],     rax;
        mov [rip + _lpg_d7_set_dir_ct], rax;
        mov [rip + _lpg_d7_read_ct],    rax;
        mov [rip + _lpg_d7_write_ct],   rax;
        mov [rip + _lpg_d7_route_ct],   rax;

        // --- Record (mmio_base, n_pins). Port stays 0 at skeleton
        //     stage; the follow-up slice sources it from the Wave
        //     59 I3 CrsInfo pin-group field.
        mov [rip + _lpg_d7_mmio_base], rbx;
        mov [rip + _lpg_d7_n_pins],    r12;

        // --- Flip the inited latch.
        mov rax, 1;
        mov [rip + _lpg_d7_inited], rax;

        // --- Fingerprint: GPIO INIT OK n_pins=<n> port=<port>
        //
        // klog_s1_d2 signature (per klog/wrappers.pdx L261):
        //   rdi = level (3 = LEVEL_INFO)
        //   rsi = subsys_ptr (SUBSYS_DRV_)
        //   rdx = tag_ptr
        //   rcx = k1_ptr, r8 = v1
        //   r9  = k2_ptr
        //   [rsp+8] = v2 (seventh arg, caller pushes)
        //
        // Alignment: body rsp%16 == 0 at entry here; `sub rsp, 8`
        // pads to 8, `push rax` adds 8 for the stack arg leaving
        // rsp%16 == 0 at the CALL. After CALL, `add rsp, 16`
        // reclaims both slots.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_DRV_];
        lea rdx, [rip + lpg_d7_tag_init_ok];
        lea rcx, [rip + lpg_d7_k_n_pins];
        mov r8,  r12;                       // v1 = n_pins
        lea r9,  [rip + lpg_d7_k_port];

        sub rsp, 8;                         // pad
        mov rax, [rip + _lpg_d7_port];      // v2 = port (zero at skeleton)
        push rax;
        call klog_s1_d2;
        add rsp, 16;                        // reclaim pad + stack arg

        xor rax, rax;                       // LPG_D7_OK
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §G  lpss_gpio_pad_offset(pin) -> u64
  //
  // Compute the byte offset of the PAD's PADCFG0 inside the MMIO
  // window, with a hard pin-range refusal that returns
  // LPG_D7_ERR_PIN_RANGE for a pin at or beyond `_lpg_d7_n_pins`.
  //
  // The skeleton presumes a FLAT pin space (community 0 only); the
  // follow-up slice replaces this helper with a call through the
  // R30.M6-002 driver's `lpss_gpio_resolve_pin` so the two-dimensional
  // (community, pad_index) layout is honoured.
  //
  // Returns the byte offset on success, LPG_D7_ERR_PIN_RANGE on
  // refusal. Leaf. SysV: rdi = pin.
  // ==========================================================================

  pub let lpss_gpio_pad_offset : (u64) -> u64 !{mem} @{} =
    fn (pin: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 59 D7 (paideia-os#2524) skeleton: byte offset of PADCFG0 for `pin` relative to the LPSS GPIO MMIO base. Refuses pin >= _lpg_d7_n_pins with LPG_D7_ERR_PIN_RANGE (0xFFFFFE78), not a clamp — a wrapped index would land on a real pad belonging to a real pin and the whole point of the error band is that an operator sees the specific refusal rather than a mysterious wrong-pin write. Leaf, no callee-save pushes needed. Multiplication by PAD_STRIDE (0x10) is a `shl r, 4` so no two-operand `imul r, imm` is emitted (encoder gap). Register plan: rax = scratch, no callee-save use. Labels prefixed lpg_d7_po_.",
      block: {
        // --- Pin-range check against _lpg_d7_n_pins.
        mov rax, [rip + _lpg_d7_n_pins];
        cmp rdi, rax;
        jae lpg_d7_po_range;

        // --- offset = pin * 0x10 (PAD_STRIDE). Shift by 4 — no imul.
        mov rax, rdi;
        shl rax, 4;
        ret;

      lpg_d7_po_range:
        mov rax, 0xFFFFFE78;              // LPG_D7_ERR_PIN_RANGE
        ret
      }
    }

  // ==========================================================================
  // §H  lpss_gpio_set_direction(mmio_base, pin, dir) -> u64
  //
  // Validate (mmio_base, pin, dir) and bump the stats counter. The
  // real body (follow-up slice) reads PADCFG0, clears GPIOTXDIS +
  // GPIORXDIS per `dir`, forces PMODE to GPIO (0b0000 in bits 10:13),
  // and writes back — all via gpio_io_write32 against the window
  // capability. The skeleton stops at the validation + counter
  // bump so the ordering witness can see the entry.
  //
  // Returns LPG_D7_OK (0), LPG_D7_ERR_NOT_INIT, LPG_D7_ERR_BAD_MMIO,
  // LPG_D7_ERR_PIN_RANGE, or LPG_D7_ERR_BAD_DIR. SysV: rdi = mmio_base,
  // rsi = pin, rdx = dir.
  // ==========================================================================

  pub let lpss_gpio_set_direction : (u64, u64, u64) -> u64 !{mem, sysreg} @{boot} =
    fn (mmio_base: u64, pin: u64, dir: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot},
      justification: "Wave 59 D7 (paideia-os#2524) skeleton: validate (mmio_base, pin, dir), bump _lpg_d7_set_dir_ct, return LPG_D7_OK. Gates in order so an operator sees the first failing one: (1) _lpg_d7_inited == 0 -> LPG_D7_ERR_NOT_INIT. (2) mmio_base != _lpg_d7_mmio_base -> LPG_D7_ERR_BAD_MMIO: a caller may NOT invent a mmio_base; the init path established which window this driver owns. (3) pin >= _lpg_d7_n_pins -> LPG_D7_ERR_PIN_RANGE. (4) dir not in {LPG_D7_DIR_INPUT=0, LPG_D7_DIR_OUTPUT=1} -> LPG_D7_ERR_BAD_DIR. On success the counter is bumped via a non-REX.W mov_d (G1) so the field stays 4-byte sized — the slot is a u64 for alignment but the arithmetic surface is 32-bit at skeleton stage; the follow-up slice widens to u64 when the per-controller aggregator ships. Leaf, no callee-save pushes. Labels prefixed lpg_d7_sd_.",
      block: {
        // --- (1) inited?
        mov rax, [rip + _lpg_d7_inited];
        cmp rax, 0;
        je  lpg_d7_sd_notinit;

        // --- (2) mmio_base must match the recorded one.
        mov rax, [rip + _lpg_d7_mmio_base];
        cmp rdi, rax;
        jne lpg_d7_sd_badmmio;

        // --- (3) pin range.
        mov rax, [rip + _lpg_d7_n_pins];
        cmp rsi, rax;
        jae lpg_d7_sd_badpin;

        // --- (4) dir must be 0 or 1.
        cmp rdx, 1;
        ja  lpg_d7_sd_baddir;

        // --- Count the attempt (skeleton pass; the real body does
        //     the gpio_io_write32 of PADCFG0 here).
        mov rax, [rip + _lpg_d7_set_dir_ct];
        add rax, 1;
        mov [rip + _lpg_d7_set_dir_ct], rax;

        xor rax, rax;                     // LPG_D7_OK
        ret;

      lpg_d7_sd_notinit:
        mov rax, 0xFFFFFE79;              // LPG_D7_ERR_NOT_INIT
        ret;
      lpg_d7_sd_badmmio:
        mov rax, 0xFFFFFE7C;              // LPG_D7_ERR_BAD_MMIO
        ret;
      lpg_d7_sd_badpin:
        mov rax, 0xFFFFFE78;              // LPG_D7_ERR_PIN_RANGE
        ret;
      lpg_d7_sd_baddir:
        mov rax, 0xFFFFFE7E;              // LPG_D7_ERR_BAD_DIR
        ret
      }
    }

  // ==========================================================================
  // §I  lpss_gpio_read(mmio_base, pin) -> u64 (0 or 1 on success,
  //                                             error band on refusal)
  //
  // Validate (mmio_base, pin), bump the stats counter, return 0.
  // The real body (follow-up slice) reads PADCFG0 at the computed
  // offset via gpio_io_read32 and extracts bit 1 (RXSTATE) as the
  // input level.
  //
  // Returns 0 or 1 on success; one of LPG_D7_ERR_* on refusal.
  // Collisions with the valid return values are impossible because
  // every error code lives in the 0xFFFFFE70..0xFFFFFE7F band and
  // the valid range is {0, 1}. SysV: rdi = mmio_base, rsi = pin.
  // ==========================================================================

  pub let lpss_gpio_read : (u64, u64) -> u64 !{mem, sysreg} @{boot} =
    fn (mmio_base: u64, pin: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot},
      justification: "Wave 59 D7 (paideia-os#2524) skeleton: validate (mmio_base, pin), bump _lpg_d7_read_ct, return 0 as the stub input level. Gates in order: (1) inited (2) mmio_base match (3) pin range. The valid return range is {0, 1} and the error band lives in 0xFFFFFE70..0xFFFFFE7F so a caller can distinguish an error from a one-bit level without a second query. Return type is declared u64 (not u8) because the paideia-as type system does not carry a u8 return narrower than the system calling convention's rax width; the API-level contract 'returns 0/1 on success, error-band on refusal' is enforced by the caller's compare rather than the type. Leaf, no callee-save pushes. Labels prefixed lpg_d7_rd_.",
      block: {
        // --- (1) inited?
        mov rax, [rip + _lpg_d7_inited];
        cmp rax, 0;
        je  lpg_d7_rd_notinit;

        // --- (2) mmio_base match.
        mov rax, [rip + _lpg_d7_mmio_base];
        cmp rdi, rax;
        jne lpg_d7_rd_badmmio;

        // --- (3) pin range.
        mov rax, [rip + _lpg_d7_n_pins];
        cmp rsi, rax;
        jae lpg_d7_rd_badpin;

        // --- Count the attempt.
        mov rax, [rip + _lpg_d7_read_ct];
        add rax, 1;
        mov [rip + _lpg_d7_read_ct], rax;

        xor rax, rax;                     // stub level = 0
        ret;

      lpg_d7_rd_notinit:
        mov rax, 0xFFFFFE79;              // LPG_D7_ERR_NOT_INIT
        ret;
      lpg_d7_rd_badmmio:
        mov rax, 0xFFFFFE7C;              // LPG_D7_ERR_BAD_MMIO
        ret;
      lpg_d7_rd_badpin:
        mov rax, 0xFFFFFE78;              // LPG_D7_ERR_PIN_RANGE
        ret
      }
    }

  // ==========================================================================
  // §J  lpss_gpio_write(mmio_base, pin, val) -> u64
  //
  // Validate (mmio_base, pin, val), bump the stats counter, return
  // LPG_D7_OK. The real body (follow-up slice) reads PADCFG0 at
  // the computed offset, flips bit 0 (TXSTATE) per `val`, and
  // writes back via gpio_io_write32. Only `val in {0, 1}` is
  // accepted; `val >= 2` returns LPG_D7_ERR_BAD_VAL (0xFFFFFE7D).
  // SysV: rdi = mmio_base, rsi = pin, rdx = val.
  // ==========================================================================

  pub let lpss_gpio_write : (u64, u64, u64) -> u64 !{mem, sysreg} @{boot} =
    fn (mmio_base: u64, pin: u64, val: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot},
      justification: "Wave 59 D7 (paideia-os#2524) skeleton: validate (mmio_base, pin, val), bump _lpg_d7_write_ct, return LPG_D7_OK. Gates: (1) inited (2) mmio_base match (3) pin range (4) val in {0, 1}. val >= 2 is REFUSED rather than LSB-truncated because an API that silently drops bits of a value a caller handed in makes a write-happy-path witness lie: a tester that writes 2 and reads back 0 would mis-attribute a probe failure to the hardware when it was the API. Leaf, no callee-save pushes. Labels prefixed lpg_d7_wr_.",
      block: {
        // --- (1) inited?
        mov rax, [rip + _lpg_d7_inited];
        cmp rax, 0;
        je  lpg_d7_wr_notinit;

        // --- (2) mmio_base match.
        mov rax, [rip + _lpg_d7_mmio_base];
        cmp rdi, rax;
        jne lpg_d7_wr_badmmio;

        // --- (3) pin range.
        mov rax, [rip + _lpg_d7_n_pins];
        cmp rsi, rax;
        jae lpg_d7_wr_badpin;

        // --- (4) val in {0, 1}.
        cmp rdx, 1;
        ja  lpg_d7_wr_badval;

        // --- Count the attempt.
        mov rax, [rip + _lpg_d7_write_ct];
        add rax, 1;
        mov [rip + _lpg_d7_write_ct], rax;

        xor rax, rax;                     // LPG_D7_OK
        ret;

      lpg_d7_wr_notinit:
        mov rax, 0xFFFFFE79;              // LPG_D7_ERR_NOT_INIT
        ret;
      lpg_d7_wr_badmmio:
        mov rax, 0xFFFFFE7C;              // LPG_D7_ERR_BAD_MMIO
        ret;
      lpg_d7_wr_badpin:
        mov rax, 0xFFFFFE78;              // LPG_D7_ERR_PIN_RANGE
        ret;
      lpg_d7_wr_badval:
        mov rax, 0xFFFFFE7D;              // LPG_D7_ERR_BAD_VAL
        ret
      }
    }

  // ==========================================================================
  // §K  lpss_gpio_route_crs(crs_info, out_routes) -> u64
  //
  // Walk a parsed `CrsInfo` struct (the Wave 59 I3 output shape, 296
  // bytes at `src/kernel/core/acpi/crs.pdx` §CrsInfo) and extract
  // pin-group → function routes into `out_routes` (a caller-allocated
  // array of up to LPG_D7_MAX_ROUTES u64 pairs — one entry = 16 B;
  // layout is (pin, func), both u64).
  //
  // SKELETON RETURN: 0 routes. The current CrsInfo (296 B) carries
  // bus / mmio / io windows but NOT GPIO Connection descriptors
  // (ACPI 6.5 §6.4.3.8.1) — those arrive with the Wave 59 D5
  // ACPICA walker (user-space) which parses the raw AML buffer and
  // emits a different buffer shape. The skeleton therefore accepts
  // the CrsInfo pointer, validates it is non-null, bumps the stats
  // counter, writes a trailing-zero sentinel pair into
  // `out_routes[0]`, and returns LPG_D7_OK.
  //
  // Returns LPG_D7_OK with route-count 0 encoded as a trailing-zero
  // pair, or LPG_D7_ERR_NULL_CRS / LPG_D7_ERR_NULL_OUT on a
  // null-argument refusal. SysV: rdi = crs_info, rsi = out_routes.
  // ==========================================================================

  pub let lpss_gpio_route_crs : (u64, u64) -> u64 !{mem, sysreg} @{boot} =
    fn (crs_info: u64, out_routes: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot},
      justification: "Wave 59 D7 (paideia-os#2524) skeleton: validate (crs_info, out_routes), bump _lpg_d7_route_ct, write a trailing-zero sentinel pair into out_routes[0] (pin=0, func=0 — the caller's loop terminates on either), return LPG_D7_OK with 0 routes extracted. CrsInfo as published by the Wave 59 I3 parser does not yet carry GPIO Connection descriptors; the Wave 59 D5 ACPICA walker (user-space) will extend the shape in a follow-up slice and this body will then walk the extended field without a signature change. Encoding the empty case as a sentinel pair rather than a (route_count, routes) pair keeps the skeleton output shape compatible with the follow-up slice: `while (out[i].pin != 0) ...` works for both the empty skeleton case and the populated real case. Leaf, no callee-save pushes. Labels prefixed lpg_d7_rc_.",
      block: {
        // --- Null-arg refusals: crs_info first, then out_routes.
        //     Order matters: a caller debugging a double-null is
        //     easier served by the first error being the first arg.
        cmp rdi, 0;
        je  lpg_d7_rc_nullcrs;
        cmp rsi, 0;
        je  lpg_d7_rc_nullout;

        // --- Trailing-zero sentinel pair at out_routes[0].
        //     out_routes[0].pin  = 0
        //     out_routes[0].func = 0
        xor rax, rax;
        mov [rsi + 0], rax;
        mov [rsi + 8], rax;

        // --- Count the attempt.
        mov rax, [rip + _lpg_d7_route_ct];
        add rax, 1;
        mov [rip + _lpg_d7_route_ct], rax;

        xor rax, rax;                     // LPG_D7_OK (0 routes)
        ret;

      lpg_d7_rc_nullcrs:
        mov rax, 0xFFFFFE7B;              // LPG_D7_ERR_NULL_CRS
        ret;
      lpg_d7_rc_nullout:
        mov rax, 0xFFFFFE7A;              // LPG_D7_ERR_NULL_OUT
        ret
      }
    }

  // ==========================================================================
  // §L  Stat accessors — called by witness programmes.
  //
  // Four read-only getters so a boot-witness can assert the counts
  // bumped past zero without reaching into the module's statics
  // directly. Each getter is a single-load leaf; the function
  // exists purely so witness callers compile against a stable
  // signature even after the follow-up slice changes the storage
  // layout.
  // ==========================================================================

  pub let lpss_gpio_set_dir_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 59 D7 (paideia-os#2524) skeleton: single-load read-only getter for _lpg_d7_set_dir_ct. Exists so witness callers can assert the counter bumped without reaching for the static directly; the follow-up slice may change storage shape (per-controller aggregator) but the getter signature stays. Leaf.",
      block: { mov rax, [rip + _lpg_d7_set_dir_ct]; ret }
    }

  pub let lpss_gpio_read_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 59 D7 (paideia-os#2524) skeleton: single-load getter for _lpg_d7_read_ct. Pair for lpss_gpio_set_dir_count. Leaf.",
      block: { mov rax, [rip + _lpg_d7_read_ct]; ret }
    }

  pub let lpss_gpio_write_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 59 D7 (paideia-os#2524) skeleton: single-load getter for _lpg_d7_write_ct. Pair for lpss_gpio_set_dir_count. Leaf.",
      block: { mov rax, [rip + _lpg_d7_write_ct]; ret }
    }

  pub let lpss_gpio_route_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 59 D7 (paideia-os#2524) skeleton: single-load getter for _lpg_d7_route_ct. Pair for lpss_gpio_set_dir_count. Leaf.",
      block: { mov rax, [rip + _lpg_d7_route_ct]; ret }
    }

  pub let lpss_gpio_inited : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave 59 D7 (paideia-os#2524) skeleton: single-load getter for _lpg_d7_inited. 0 before init, 1 after. Pair for the counter getters so the witness can check 'inited AND counts > 0' as a single contract. Leaf.",
      block: { mov rax, [rip + _lpg_d7_inited]; ret }
    }

}
