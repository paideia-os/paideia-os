// src/kernel/boot/entry.pdx — B2-006: 64-bit kernel entry from boot_stub.S
//
// B2-006 simplification: boot_stub.S (GAS, tools/boot_stub.S) handles the
// complete 32→64-bit transition, including:
// - GDT setup (5 descriptors: null, code32, data32, code64, data64)
// - PML4/PDPT setup (1 GiB identity pages for 0–3 GiB)
// - CR4.PAE, EFER.LME, CR0.PG|PE
// - Long-mode far-jump with selector reloading
//
// _start (this module) receives control in 64-bit long mode.
// Minimal entry: write 'B' + LF to COM1 for smoke verification.

module Entry = structure {
  let _start : () -> () !{sysreg, PortIo} @{paideia.port_io} = fn (x: ()) -> unsafe {
    effects: {sysreg, PortIo}, capabilities: {boot, paideia.port_io},
    justification: "B3-004: 64-bit entry from boot_stub.S long-mode trampoline. Writes 'B'+LF liveness beacon, then calls kernel_main_64 to begin main kernel execution. #1567: explicitly rep-stosq-zeroes the higher-half .bss region (_bss_start..._bss_end, boot/link.ld) FIRST, before the liveness beacon and before any other kernel code runs, rather than trusting the -kernel boot chain (QEMU/SeaBIOS) to have zero-filled the .bss PT_LOAD's NOBITS tail -- that trust was misplaced: cap_table slot 12 (never written by any prior witness) was observed reading back BIOS-POST-looking bytes at kind_hw_interrupt_witness entry. RDI=_bss_start, RCX=(_bss_end-_bss_start)/8, RAX=0 per zero_bss.pdx's documented calling convention.",
    block: {
      lea rdi, [rip + _bss_start];
      lea rcx, [rip + _bss_end];
      sub rcx, rdi;
      shr rcx, 3;
      xor eax, eax;
      call zero_bss;
      mov al, 0x42;
      mov dx, 0x3F8;
      out_al al;
      mov al, 0x0A;
      out_al al;
      call kernel_main_64;
      halt:
        lea rdi, [rip + SUBSYS_BOOT];
        lea rsi, [rip + tag_kmain_returned];
        call klog_panic;
        jmp halt
    }
  }
}
