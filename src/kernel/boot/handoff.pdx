// src/kernel/boot/handoff.pdx -- R53.M3-001 (#1742) kernel-side boot handoff
//
// A single owning module for the kernel-side boot handoff record.
// Aggregates two families of slots:
//
//   1. #1604 INIT RING-3 HANDOFF (three .bss qwords).
//      Written once by kernel_main.pdx's boot_continue_after_ring3 setup
//      block; read once by the same function immediately before
//      `call enter_userland_initial`. Between the two lie six witness
//      calls into five modules that must NOT be able to reach the
//      values. Store, load and poison discipline stays in kernel_main.
//      pdx unchanged; only the storage moves here. The five-halves
//      confinement gate (`tools/verify-init-handoff.sh`) now treats
//      this file as OWNER_DECL and boot/kernel_main.pdx as OWNER_ACCESS
//      -- the split is enforced, foreign references still fail.
//      See tools/verify-init-handoff.sh's file header for the full
//      rationale.
//
//   2. R53.M3 ROOT-VOLUME UUID HINT (16-byte slot + valid flag).
//      Populated by a future R11-plus multiboot loader path with the
//      UUID of the volume to mount at slot 0; consumed by the pdxb
//      volume probe root-selection order (design/tooling/volume-
//      lifecycle-mechanism.md §4.4 step 1). The `-kernel` boot path
//      does NOT populate the slot -- the probe falls through to the
//      superblock ROOT-flag / single-volume / tmpfs-fallback tiers,
//      which is what keeps every existing smoke mode working with no
//      disk (§4.4 fallback).
//
//      Field layout matches design §4.3:
//        _root_volume_uuid       [u8; 16]  zero = no hint
//        _root_volume_uuid_valid u64       0 = ignore, 1 = binding
//
//      Written exclusively by handoff_set_root_uuid; read via
//      handoff_root_uuid_ptr. tools/build.sh's `ec_confine_one`
//      confines both symbols to this file's .o, so this module is the
//      single writer.
//
// Encoder floor:
//   - `pub let mut S : T = 0 / uninit @align(N)` -- proven .bss storage
//     shape (kernel_main.pdx L1465 _init_task, pdxfs_dir_iter.pdx L158
//     _pdxfs_dir_cursor).
//   - `lea r64, [rip + sym] + ret` (leaf) -- pubkey.pdx L124 pattern.
//   - `mov [rip + sym + IMM], r64` / `mov r64, [rip + sym + IMM]` --
//     pci/enum.pdx L153-156 for stores, net/udp.pdx L493 for loads.
//   - `cmp r64, 0; je LABEL; ret` control-flow -- kernel_main.pdx
//     L1213-1215 init_task zero-guard pattern.
//
// Audit: paideia-os#1604 (init ring-3 handoff), #1742 (R53.M3-001).

module Handoff = structure {

  // ==========================================================================
  // #1604: init's ring-3 handoff. WRITTEN ONCE, READ ONCE, BOTH IN
  // src/kernel/boot/kernel_main.pdx -- see the two blocks tagged
  // `#1604: THE INIT RING-3 HANDOFF` in boot_continue_after_ring3,
  // and tools/verify-init-handoff.sh, which fails the build if a
  // third site ever names one of these symbols.
  //
  // R53.M3-001 (#1742): factored out of kernel_main.pdx unchanged.
  // The declarations move here so a single boot/handoff module owns
  // the entire kernel-side boot handoff record (three ring-3 slots
  // + the R53 root-volume hint below). Store, load and poison sites
  // stay in kernel_main.pdx; verify-init-handoff.sh's OWNER_DECL /
  // OWNER_ACCESS split polices the arrangement.
  //
  // That confinement is the whole point, and it is what stops this
  // from being a lateral move. The values used to ride r12/r13/r14
  // across six witness calls into five modules on an unenforced
  // callee-save convention; moving them to .bss without confining
  // them would trade an unchecked register convention for an
  // unchecked GLOBAL one, which is a worse bargain -- a global is
  // reachable from anywhere in the kernel, a register at least only
  // from the call chain. It is the arrangement -- three slots, two
  // access sites, one gate -- and not the storage class that makes
  // this an improvement. Splitting the storage out to this file
  // does not weaken the arrangement: HALF 3 (one-store-one-load)
  // and HALF 5 (register poison) still live in kernel_main.pdx;
  // HALF 2 (foreign-reference ban) now admits exactly two owners
  // and no others.
  //
  // Zero-initialised, and both ends check for zero: the setup block
  // will not store a zero task slab or e_entry, and the entry site
  // refuses to iretq on one.
  // ==========================================================================
  pub let mut _init_handoff_task      : u64 = 0
  pub let mut _init_handoff_entry_rip : u64 = 0
  pub let mut _init_handoff_user_rsp  : u64 = 0

  // ==========================================================================
  // R53.M3-001 (#1742): root-volume UUID hint slot + validity flag.
  //
  // Field layout per design/tooling/volume-lifecycle-mechanism.md
  // §4.3. The slot is written exclusively by handoff_set_root_uuid;
  // tools/build.sh's `ec_confine_one` confines the two symbols to
  // boot/handoff.o. Readers use the handoff_root_uuid_ptr accessor
  // rather than the symbol directly -- the accessor is the ambient-
  // safe API and the reason ec_confine_one can hold.
  //
  // @align(8) on the 16-byte UUID: handoff_set_root_uuid writes it
  // as two aligned qword stores rather than a byte-granular rep
  // movsb (a 16-byte fixed-size copy is exactly two movs, and the
  // paired-mov idiom matches the shape used throughout the kernel
  // for tiny known-size row writes). Alignment guarantees neither
  // qword store straddles a cacheline. `uninit` is safe here
  // because the valid flag is the sole reader-side gate; a probe
  // that finds _root_volume_uuid_valid == 0 never touches the
  // UUID bytes.
  //
  // Zero-init on _root_volume_uuid_valid is load-bearing: the
  // -kernel boot path never calls handoff_set_root_uuid, so the
  // flag reading zero at probe time is the mechanism that steers
  // the probe past step 1 of the root-selection order into the
  // ROOT-flag / single-volume / tmpfs-fallback tiers (§4.4).
  // ==========================================================================
  pub let mut _root_volume_uuid       : [u8; 16] = uninit @align(8)
  pub let mut _root_volume_uuid_valid : u64      = 0

  // ==========================================================================
  // handoff_root_uuid_ptr() -> u64
  //   Returns &_root_volume_uuid (virtual address; identity-mapped
  //   to its physical address per the kernel's identity-map
  //   discipline -- see design/kernel/vfs-layout.md §5). Consumers
  //   inspect _root_volume_uuid_valid via a companion load before
  //   dereferencing the returned pointer; a zero flag means the
  //   UUID bytes are undefined.
  //
  //   Leaf: single lea + ret, no callee-save touched. Mirrors
  //   pdxfs_lite_pubkey_ptr (R25.M5-002 #930) and
  //   pdxfs_block_vops_ptr (R53.M2-005 #1740) one-for-one.
  // ==========================================================================
  pub let handoff_root_uuid_ptr : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R53.M3-001 (#1742). Return &_root_volume_uuid. Single-instruction body plus ret. lea rip-relative to the sibling label; return in rax. Leaf; no callee-save touched, no stack use, no test/mov_b, no label. `mem` effect conservative for callers that will dereference the returned pointer; the function body itself is pure address arithmetic. Mirrors pdxfs_lite_pubkey_ptr (#930) and pdxfs_block_vops_ptr (#1740) one-for-one.",
      block: {
        lea rax, [rip + _root_volume_uuid];
        ret
      }
    }

  // ==========================================================================
  // handoff_set_root_uuid(bytes_ptr : u64)
  //   Copies 16 bytes from *bytes_ptr into _root_volume_uuid and
  //   sets _root_volume_uuid_valid to 1. THE ONLY WRITER of both
  //   storage symbols; tools/build.sh's `ec_confine_one` confines
  //   the pair to boot/handoff.o so this function is the only path
  //   that mutates the slot.
  //
  //   bytes_ptr == 0 is a no-op (the slot stays zero-init /
  //   ambient-invalid). Callers are expected to pass a non-zero
  //   pointer; the null guard exists so a future loader stub that
  //   failed to compute a UUID cannot corrupt the slot with a null
  //   dereference or spuriously flip the valid flag.
  //
  //   Two 8-byte movs rather than rep_movsb: 16 bytes is exactly
  //   two qwords, and the paired-mov form is the encoder shape
  //   used throughout the kernel for tiny known-size copies
  //   (nvme_recovery.pdx L935 state-byte write, pci/enum.pdx L153-
  //   156 four-qword bus-visited init). rep_movsb is reserved for
  //   byte-granular copies of unknown length. Fifth-order effect:
  //   the two-mov shape leaves the direction flag alone, so no
  //   `cld` prelude is needed.
  //
  //   Leaf. rax used as the sole scratch for both qword loads and
  //   the valid-flag store. No callee-save touched, no stack use.
  //   Straight-line with a single forward jump to the label
  //   handoff_sru_done for the null-guard early return; frame
  //   alignment on entry is caller's responsibility (SysV).
  // ==========================================================================
  pub let handoff_set_root_uuid : (u64) -> () !{mem} @{} =
    fn (bytes_ptr: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R53.M3-001 (#1742). Copy 16 bytes from bytes_ptr (rdi) into _root_volume_uuid via two 8-byte movs, then set _root_volume_uuid_valid = 1. Null-guarded (rdi==0 -> jump to handoff_sru_done and ret without touching either slot). Leaf; no callee-save touched, no stack use. rax used as scratch for both qword loads and the valid-flag store. Two-mov paired form matches the encoder shape used for fixed-size row writes throughout the kernel (nvme_recovery.pdx L935 state-byte write, pci/enum.pdx L153-156 four-qword bus-visited init); rep_movsb is reserved for variable-length copies. Straight-line with a single forward jump to handoff_sru_done. Label prefix `handoff_sru_` per module reserved-label discipline.",
      block: {
        cmp rdi, 0;
        je handoff_sru_done;
        mov rax, [rdi];
        mov [rip + _root_volume_uuid + 0], rax;
        mov rax, [rdi + 8];
        mov [rip + _root_volume_uuid + 8], rax;
        mov rax, 1;
        mov [rip + _root_volume_uuid_valid], rax;
      handoff_sru_done:
        ret
      }
    }
}
