// src/kernel/boot/t14_g4_detect.pdx -- R104.M1-001 (paideia-os #2170)
//
// T14 G4 hardware presence probe.
//
// Publishes the ONE boot-time flag every R104 wire-up call site consults
// before invoking Iris-Xe-specific substrate:
//
//   _t14_g4_present : u64 = 0   (default -- QEMU / non-T14 hardware)
//                       = 1     (T14 G4 Iris Xe iGPU discovered)
//
// R104 does not target arbitrary Iris Xe hardware; the wave's honest
// scope is one specific silicon target (Lenovo ThinkPad T14 Gen 4).
// The presence signal is derived at boot from the PCI enumerator's
// _pci_devices table (populated by pci_enumerate_all much earlier in
// kernel_main_64) by walking every record and checking for an Intel
// vendor (0x8086) + display-controller class (0x03/0x00) + device-id
// top-byte in {0x9A (Xe1 Tiger/Alder Lake), 0x46 (Xe2 Meteor/Arrow
// Lake), 0x7D (Xe3 Lunar Lake)}.
//
// Note: the R28.M2 milestone referenced by the R104 plan intended to
// land a runtime flag distilled from a wider DMI/SMBIOS+CPUID panel;
// that flag was never wired (searched every source file 2026-09-02).
// This file supplies the minimum surface R104 needs -- a boolean flag
// keyed on "does the PCI enumerator see an Iris Xe display function" --
// so every T14-gated call site has ONE symbol to check. Widening to a
// full DMI-based board identity is out of scope for R104; the flag
// grows other predicates only when a wave demands one.
//
// The QEMU boot path has no Iris Xe device (stdvga is 0x1234/0x1111;
// virtio-gpu is 0x1AF4/0x1050/0x1051) so _t14_g4_present stays 0 and
// every R104.M1..M3 site takes its skip arm.
//
// ============================================================================
// SECTION 1  PCI RECORD LAYOUT (from src/kernel/core/pci/enum.pdx §Header)
// ============================================================================
//
// Record stride = 32 bytes (Enum.PCI_DEV_RECORD_SIZE). Fields:
//
//   +0   u16 seg
//   +2   u8  bus
//   +3   u8  dev
//   +4   u8  fn
//   +5   u8  header_type
//   +6   u8  class_code
//   +7   u8  subclass
//   +8   u16 vendor_id
//   +10  u16 device_id
//   +12  u8  cap_ptr
//   +13  u8  _pad0
//   +14  u16 bar_kinds_bitmap
//   +16..+31 reserved
//
// Match predicate (see §0 above):
//   vendor_id == 0x8086 AND
//   class_code == 0x03 AND
//   subclass == 0x00 AND
//   (device_id >> 8) in {0x9A, 0x46, 0x7D}
//
// ============================================================================
// SECTION 2  ONE WRITER OF THE FLAG
// ============================================================================
//
// _t14_g4_present is written only here (t14_g4_detect). Every consumer
// reads it via `mov rax, [rip + _t14_g4_present]` and branches on
// non-zero. There is no accessor function -- the flag is a plain u64
// cell so callers stay branchless-with-one-load. tools/build.sh's
// symbol confinement gate for one-writer state can be widened to pin
// this if a future round needs the stronger guarantee.

module T14G4Detect = structure {

  // The one flag. Zero == not present. One == present. Any other value
  // is reserved (future R104-follow-on may pack a version nibble here).
  pub let mut _t14_g4_present : u64 = 0

  // PCI predicate constants (matches IrisXeProbe.IXP_* verbatim).
  pub let T14D_PCI_CLASS_DISPLAY : u64 = 0x03
  pub let T14D_PCI_SUB_VGA       : u64 = 0x00
  pub let T14D_VENDOR_INTEL      : u64 = 0x8086
  pub let T14D_FAM_XE1           : u64 = 0x9A
  pub let T14D_FAM_XE2           : u64 = 0x46
  pub let T14D_FAM_XE3           : u64 = 0x7D

  pub let T14D_PCI_RECORD_STRIDE : u64 = 32
  pub let T14D_PCI_MAX_RECORDS   : u64 = 256

  // Fingerprint tags. Frame prologue implicit.
  pub let tag_t14_present_ok : [u8; 27] = "r104 t14_g4 present ok --\0\0"
  pub let tag_t14_absent_ok  : [u8; 26] = "r104 t14_g4 absent ok --\0\0"

  // ==========================================================================
  // t14_g4_detect() -> u64
  //
  // Walks _pci_devices[0.._pci_device_count) once, sets _t14_g4_present
  // to 1 on the first record matching the T14 iGPU predicate, else 0.
  // Emits ONE fingerprint on completion (present or absent).
  //
  // Register plan:
  //   rbx = loop cursor (0.._pci_device_count)
  //   r12 = record base pointer (recomputed per iteration; avoids
  //         relying on a callee-save across the klog emit)
  // Two callee-save pushes (rbx, r12) + sub rsp,8: entry rsp%16==8,
  //   +16+8=24, rsp%16==0 for the klog call boundary.
  // Frame prologue implicit.
  // ==========================================================================
  pub let t14_g4_detect : () -> u64 !{mem, sysreg} @{boot} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot},
      justification: "R104.M1-001: T14 G4 presence probe. Walks _pci_devices for Intel display-controller with Iris Xe device-id family; sets _t14_g4_present. Emits one fingerprint on completion. Labels prefixed t14d_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        // Default: absent.
        xor rax, rax;
        mov [rip + _t14_g4_present], rax;

        // Load _pci_device_count once.
        mov r10, [rip + _pci_device_count];
        cmp r10, 0;
        je  t14d_done_absent;

        // Cap at record ceiling (defensive; the enumerator caps at 256).
        mov r11, 256;
        cmp r10, r11;
        jbe t14d_bound_ok;
        mov r10, r11;
      t14d_bound_ok:

        xor rbx, rbx;

      t14d_scan:
        cmp rbx, r10;
        jae t14d_done_absent;

        // record_ptr = &_pci_devices + rbx * 32.
        lea r12, [rip + _pci_devices];
        mov rax, rbx;
        shl rax, 5;
        add r12, rax;

        // class_code at [+6], subclass at [+7].
        xor rax, rax;
        mov_b rax, [r12 + 6];
        cmp rax, 0x03;
        jne t14d_next;

        xor rax, rax;
        mov_b rax, [r12 + 7];
        cmp rax, 0x00;
        jne t14d_next;

        // vendor_id at [+8] (u16).
        xor rax, rax;
        mov_w rax, [r12 + 8];
        mov r11, 0x8086;
        cmp rax, r11;
        jne t14d_next;

        // device_id at [+10] (u16), family = (dev_id >> 8) & 0xFF.
        xor rax, rax;
        mov_w rax, [r12 + 10];
        shr rax, 8;
        and rax, 0xFF;

        cmp rax, 0x9A;
        je  t14d_hit;
        cmp rax, 0x46;
        je  t14d_hit;
        cmp rax, 0x7D;
        je  t14d_hit;

      t14d_next:
        add rbx, 1;
        jmp t14d_scan;

      t14d_hit:
        mov rax, 1;
        mov [rip + _t14_g4_present], rax;

        // Fingerprint (present).
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_t14_present_ok];
        call klog_s1;

        mov rax, 1;
        jmp t14d_out;

      t14d_done_absent:
        // Fingerprint (absent).
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_t14_absent_ok];
        call klog_s1;

        xor rax, rax;

      t14d_out:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }
}
