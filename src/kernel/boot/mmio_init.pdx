// src/kernel/boot/mmio_init.pdx — boot-mmio-mapping step 2
//
// platform_map_early_mmio: pre-map the firmware-fixed device MMIO windows
// (HPET, xAPIC, IOAPIC) via platform_mmio_map before any witness or driver
// touches them.
//
// Design memo: design/kernel/boot-mmio-mapping.md
//
// ==============================================================================
// Purpose
// ==============================================================================
//
// R14b through R33 witnesses execute at ring 0 on the boot stack, and many
// of them perform real MMIO reads/writes to HPET / xAPIC / IOAPIC. Today
// they land inside the boot huge-page identity map by coincidence (the
// ICH9/q35 fixed window sits inside PDPT[3]); on T14 G4 or with
// ACPI-discovered windows above 4 GiB, that coincidence breaks. This module
// walks a static three-row manifest and installs mappings for all three
// firmware-fixed windows deterministically before any consumer runs.
//
// The three rows are the boot-critical ones (§2 of the design memo). MCFG
// (PCIe ECAM) is deferred to a follow-up step because it depends on ACPI
// tables that are parsed later in the boot sequence; PCI BAR mappings for
// device drivers are the driver's own responsibility once its probe reads
// the BAR value.
//
// ==============================================================================
// Fallback behavior on PVH -kernel boots
// ==============================================================================
//
// Under `qemu -kernel` (PVH ELF entry) all three fixed PAs land inside the
// boot huge-page identity window. platform_mmio_map returns pa_base (the
// identity VA) in that case, which is exactly what current drivers already
// consume. The mapped-VA slots (_hpet_mmio_va / _xapic_mmio_va /
// _ioapic_mmio_va) still receive that value so future driver conversions
// (memo §3 step 3+) that read the slot rather than the hard-coded PA get
// a correct answer on every boot path.
//
// On UEFI/T14 (once R19+ handoff wires _boot_env_pa), the three windows
// go into PML4[321] genuinely and the slots hold higher-half VAs.
//
// ==============================================================================
// Register discipline
// ==============================================================================
//
// Three back-to-back calls to platform_mmio_map, one klog_s1_d1 emit.
//
// 2-push prologue: push rbx (count accumulator) + push r12 (padding). From
// entry rsp%16==8, two pushes land rsp%16==8 (unaligned for calls), so an
// explicit `sub rsp, 8` restores rsp%16==0 for every nested call. Epilogue
// reverses (add rsp, 8; pop r12; pop rbx). rbx is used because count must
// survive across every platform_mmio_map call; r12 is unused in the body,
// pushed for callee-save-symmetry parity.
//
// ==============================================================================
// Return value
// ==============================================================================
//
// Returns the number of successful mappings (0..3). A "successful" mapping
// is any non-zero return from platform_mmio_map, including the identity-VA
// fallback (pa_base) — the caller cannot distinguish, and does not need to.
// A zero return would indicate an aspace_map hard failure (MAP_OOM,
// MAP_OVERLAP, or a mid-way MAP_HUGE) and the corresponding _..._mmio_va
// slot stays 0.
//
// The count is emitted as `PLATFORM MMIO EARLY OK N=<n>` at LEVEL_INFO on
// SUBSYS_MM__ so a clean boot log reports n=3 on both -kernel PVH and UEFI
// boots (assuming HPET/xAPIC/IOAPIC are all present, which is true on every
// current MVP target).

module MmioInit = structure {

  // Firmware-fixed physical bases (Intel PCH / QEMU q35 defaults).
  pub let HPET_PA   : u64 = 0xFED00000
  pub let XAPIC_PA  : u64 = 0xFEE00000
  pub let IOAPIC_PA : u64 = 0xFEC00000

  pub let EARLY_MMIO_SIZE : u64 = 0x1000

  // Cache-type constants (mirror MmioMap).
  pub let EARLY_MMIO_UC : u64 = 0

  // Mapped-VA slots. Populated by platform_map_early_mmio. Non-zero after
  // successful map; 0 sentinel on failure or before init. Values are either
  // higher-half VAs (PML4[321]) or identity-VA fallbacks (pa_base itself)
  // depending on whether the boot huge-page identity map covered the range.
  pub let mut _hpet_mmio_va   : u64 = 0
  pub let mut _xapic_mmio_va  : u64 = 0
  pub let mut _ioapic_mmio_va : u64 = 0

  // ==========================================================================
  // platform_map_early_mmio: pre-populate HPET/xAPIC/IOAPIC MMIO mappings.
  // ==========================================================================
  //
  // Called from kernel_main_64 immediately after pat_init_this_cpu (so the
  // PAT slot programming is in effect on the BSP when the leaf PTEs land)
  // and before any witness or driver reaches for these MMIO addresses.
  //
  // Returns the count of successful maps (0..3).
  // ==========================================================================
  pub let platform_map_early_mmio : () -> u64 !{mem, sysreg} @{boot} =
    fn () -> unsafe {
      effects: { mem, sysreg },
      capabilities: { boot },
      justification: "boot-mmio-mapping step 2 (design/kernel/boot-mmio-mapping.md). Walk a static three-row manifest of firmware-fixed MMIO windows (HPET 0xFED00000, xAPIC 0xFEE00000, IOAPIC 0xFEC00000; all 0x1000 bytes, all UC) and install kernel-VA mappings via platform_mmio_map before any driver or witness touches these PAs. Register discipline: 2-push prologue (rbx=count, r12=padding for callee-save-symmetry) + sub rsp,8 for 16-byte alignment across the four nested calls (three platform_mmio_map + one klog_s1_d1); entry rsp%16==8 -> 2 pushes -> rsp%16==8 -> sub rsp,8 -> rsp%16==0 (aligned). rbx = success count, starts at 0. Per row: call platform_mmio_map(pa, 0x1000, 0) — arg dispatch RDI/RSI/RDX per SysV; store the returned VA (or 0 on hard failure) into the appropriate _..._mmio_va slot; if non-zero, add 1 to rbx. On PVH -kernel boots all three PAs land inside the boot huge-page identity map so platform_mmio_map returns pa (identity-VA fallback via MAP_HUGE branch) and the slots hold the identity VAs; on UEFI/T14 the three go into PML4[321] and the slots hold higher-half VAs. Either way, downstream driver conversions (memo §3 step 3+) that read the slot rather than the hard-coded PA get a correct answer. Fingerprint via klog_s1_d1(LEVEL_INFO, SUBSYS_MM__, tag_platform_mmio_early_ok, k_n, count) — SUBSYS_MM__ because the primitive is owned by the MM subsystem (parallels the pat_init_this_cpu fingerprint). Success criterion (§5 of the memo): a clean boot log shows n=3 on both -kernel and -drive paths. No callers depend on the return value at this step; the count is a fingerprint diagnostic. Instruction floor: mov r64,imm32 / mov r64,imm64 (both encode as needed for PA constants), lea r64,[rip+sym], mov [rip+sym],r64, cmp / je, add r64,imm32, sub rsp,imm32, call rel32, ret — all in paideia-as v0.11.0+ baseline.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        // rbx = success count.
        xor rbx, rbx;

        // ------------------------------------------------------------------
        // Row 1: HPET @ 0xFED00000, 0x1000 bytes, UC.
        // ------------------------------------------------------------------
        mov rdi, 0xFED00000;
        mov rsi, 0x1000;
        xor rdx, rdx;                             // MMIO_UC = 0
        call platform_mmio_map;
        mov [rip + _hpet_mmio_va], rax;
        cmp rax, 0;
        je mmio_early_hpet_skip;
        add rbx, 1;
      mmio_early_hpet_skip:

        // ------------------------------------------------------------------
        // Row 2: xAPIC @ 0xFEE00000, 0x1000 bytes, UC.
        // ------------------------------------------------------------------
        mov rdi, 0xFEE00000;
        mov rsi, 0x1000;
        xor rdx, rdx;
        call platform_mmio_map;
        mov [rip + _xapic_mmio_va], rax;
        cmp rax, 0;
        je mmio_early_xapic_skip;
        add rbx, 1;
      mmio_early_xapic_skip:

        // ------------------------------------------------------------------
        // Row 3: IOAPIC @ 0xFEC00000, 0x1000 bytes, UC.
        // ------------------------------------------------------------------
        mov rdi, 0xFEC00000;
        mov rsi, 0x1000;
        xor rdx, rdx;
        call platform_mmio_map;
        mov [rip + _ioapic_mmio_va], rax;
        cmp rax, 0;
        je mmio_early_ioapic_skip;
        add rbx, 1;
      mmio_early_ioapic_skip:

        // ------------------------------------------------------------------
        // Fingerprint: klog_s1_d1(INFO, MM__, tag, k_n, count).
        // ------------------------------------------------------------------
        mov rdi, 3;                               // LEVEL_INFO
        lea rsi, [rip + SUBSYS_MM__];
        lea rdx, [rip + tag_platform_mmio_early_ok];
        lea rcx, [rip + k_n];
        mov r8, rbx;                              // v1 = count
        call klog_s1_d1;

        // Return the count in rax.
        mov rax, rbx;

        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }
}
