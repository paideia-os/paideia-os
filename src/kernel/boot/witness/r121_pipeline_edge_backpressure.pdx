// src/kernel/boot/witness/r121_pipeline_edge_backpressure.pdx -- R121.M6
//                                              (paideia-os #2500)
//
// Boot-time witness for KIND_PIPELINE_EDGE backpressure discipline
// (R121.M6). The design plan §4 R121.M6 asks for a 5-minute QEMU run
// with a fast producer and a slow-per-record consumer, verifying that
// slot-cap economy paces the producer to the consumer's drainage rate
// and no unbounded memory growth occurs. A five-minute wall-clock run
// does not fit the fingerprint-based smoke discipline (see
// feedback_paideia_os_test_defaults + design/kernel/boot-witness.md);
// this witness ADAPTS the M6 acceptance criteria to the boot-fingerprint
// pattern by running an in-kernel adversarial schedule that exercises
// the same invariants in <100 ms wall:
//
//   * Producer half: attempts R121PBP_TARGET (1000) sends back-to-back,
//     each with a unique non-zero handle (iter+1).
//   * Consumer half: drains 1 record per 4 producer iterations (25%
//     drain rate) -- a "slow consumer" relative to the fast producer,
//     matching the plan's `yes | sleep-per-record` shape but at kernel
//     tempo. The drain runs unconditionally on every 4th iter regardless
//     of the send outcome, since a drain BOTH after a successful send
//     (ring not empty) AND after an EAGAIN-refused send (ring full, so
//     definitely not empty) is always guaranteed to succeed. This is
//     the invariant the SPSC contract §1 makes explicit.
//   * Final drain: after the main loop, a bounded (<=32) drain loop
//     empties every remaining record. Assertion: after final drain,
//     drained_main + drained_final == sent (every accepted record was
//     consumed; no leak).
//
// The R121.M2 witness (r121_pipeline_edge_transport.pdx) already exercises
// the SIMPLE backpressure arm (fill to 16, verify 17th refuses with
// PET_EAGAIN, drain 16). This M6 landing exercises the STEADY-STATE arm:
// backpressure fires REPEATEDLY as the ring saturates and re-saturates
// across the fast-producer / slow-consumer schedule, and the SPSC ring
// self-paces without kernel intervention.
//
// SLOT-CAP ECONOMY (IPC-Q8): The SPSC ring is 16 slots * 8 bytes = 128
// bytes total. This is the ENTIRE producer-side "RSS" for the transport
// path -- there is no per-record allocation, no queue growth, no per-
// iteration heap touch. The plan's "±16 KiB RSS bound" translates to
// "128-byte fixed ring" in this kernel-tempo test, which is BOUNDED BY
// CONSTRUCTION rather than measured at runtime. The witness asserts
// this bound implicitly by observing that the used-slot count stays
// within [0..16] throughout (via the eagain-fires-when-full invariant)
// and that the ring drains to empty at teardown (via the
// drained_total == sent equality).
//
// FINGERPRINTS
//
// Success rollup: `pipe backpressure ok steady=<n> sent=<n> drained=<n>`
//                 (klog_s1_d3, all decimal). `steady=<n>` is the
//                 required substring per design/terminal/semantic-shell-
//                 materialization-plan.md §4 R121.M6 acceptance;
//                 sent/drained let downstream auditors reconstruct
//                 the schedule.
// Audit line:     `pipe backpressure audit sent=<n> eagain=<n>
//                 drained=<n>` (klog_s1_d3, all decimal). Carries the
//                 three counters that prove the invariants: sent +
//                 eagain == R121PBP_TARGET, drained == sent, eagain > 0.
// Failure funnel: `boot pipe backpressure fail line=<n>` (klog_s1_d1),
//                 stage stamped into _r121pbp_stage before every step.
//
// STAGES (stamped into _r121pbp_stage before each step so a failure
// fingerprint carries a distinguishing line number):
//    1  pipeline_edge_alloc (PROD) refused
//    2  pipeline_edge_alloc (CONS) refused
//    3  pipe_edge_bind_byrow refused
//    4  main-loop send returned an unexpected non-zero non-EAGAIN
//       sentinel (should be impossible under the M2 SPSC contract --
//       the only refuse is PET_EAGAIN on ring full)
//    5  main-loop drain returned EAGAIN when the ring should not have
//       been empty (either the (iter & 3) == 3 gate is wrong or a
//       previous send silently dropped a record)
//    6  final-drain loop overran its 32-iter safety bound (ring was
//       still not empty after 32 drains -- a leak indicator)
//    7  invariant broken: sent + eagain != R121PBP_TARGET (some
//       iteration returned neither success nor PET_EAGAIN and slipped
//       past the stage-4 gate)
//    8  invariant broken: drained_main + drained_final != sent (some
//       accepted record failed to drain -- a leak)
//    9  invariant broken: eagain == 0 (backpressure never fired --
//       either R121PBP_TARGET is too small for the ring depth or the
//       consumer is too eager; this is a witness-design defect rather
//       than a transport bug, but the assertion pins the invariant
//       so a future edit that weakens the schedule surfaces here)
//
// M6 DISCIPLINE
//   * No cap-slot install (deferred to R121.M5 shell integration);
//     the witness exercises the _byrow primitives directly, matching
//     the R121.M2 witness posture.
//   * Uses synthetic u64 handles (iter+1 to distinguish from the 0
//     initial ring-cell value); the ring is opaque about payload shape.
//   * Every row minted is torn down on exit (success and every failure
//     arm) via pipeline_edge_free; the ring is freed via pet_ring_free
//     after pet_row_read_ring_id snapshots its id. Pool stays clean
//     across a re-run.
//   * The `pipe edge mint ok ...` fingerprint fires TWICE (once per
//     endpoint) from inside pipeline_edge_alloc -- the R121.M1 witness
//     already made that path reachable so tools/verify-fingerprint-
//     coverage.sh needs no allowlist entry for this landing.
//   * The `pipe edge bind ok kind=<hex> ring=<hex>` fingerprint fires
//     once from inside pipe_edge_bind_byrow.
//   * The `pipe backpressure ok steady=<n> ...` and `pipe backpressure
//     audit ...` fingerprints are NEW to this landing (allowlist entries
//     required in tools/verify-fingerprint-coverage.sh -- deferred to
//     the sibling M6 tooling round rather than this in-tree landing).
//
// LATENCY BUDGET
//
// Target: <100 ms wall. Rationale:
//   * R121PBP_TARGET = 1000 iterations.
//   * Each iteration: 1 send (~50 ns via M2's measured 47 ns/record
//     on the R121.M2 pump) + up to 1 recv (~50 ns) + 4 counter bumps
//     (~5 ns each) = ~120 ns per iter worst case.
//   * 1000 * 120 ns = 120 microseconds = 0.12 ms.
//   * Final drain: up to 16 additional recv calls (~800 ns total).
//   * Fingerprint emit overhead: ~10 microseconds per klog_s1_dN call
//     * 3 emit sites = ~30 microseconds.
//   * Total: ~0.16 ms -- three orders of magnitude under the 100 ms
//     budget. The margin covers UART emit latency + any bounded
//     retry variance without approaching the budget.
//
// ENCODER DISCIPLINE (mirror r121_pipeline_edge_transport.pdx §5):
//   No `test rN, rN`, no `add reg,[mem]`, no `cmp reg,[mem]`; every
//   value staged through a register first. Every store is a qword
//   `mov [mem], reg`. No `and reg, imm64` (0x3 fits imm32). No 2-op
//   `imul r, imm` (no multiply in this body). Every label prefixed
//   `r121pbp_` -- the `pbp` root avoids collision with pet_ / pe_ /
//   r121pet_ / r121ped_ prefixes used by the sibling M2 / M4 witnesses
//   and the transport substrate. Reserved-label discipline: no
//   `loop` / `if` / `top` / `done` bare labels.

module R121PipelineEdgeBackpressure = structure {

  pub let mut _r121pbp_stage         : u64 = 0
  pub let mut _r121pbp_sent          : u64 = 0
  pub let mut _r121pbp_eagain        : u64 = 0
  pub let mut _r121pbp_drained_main  : u64 = 0
  pub let mut _r121pbp_drained_final : u64 = 0

  // Iteration count for the fast-producer / slow-consumer schedule.
  // 1000 with a 1:4 drain rate yields exactly 250 main-loop drains
  // (iters where (iter & 3) == 3 in [0..999]) and forces the ring to
  // saturate within the first 20-odd iterations (16 sends fill it,
  // then the slow drain schedule cannot keep up).
  pub let R121PBP_TARGET   : u64 = 1000

  // Expected steady-state drain count: 250 (every 4th iter in [0..999]).
  pub let R121PBP_STEADY   : u64 = 250

  // Synthetic schema_id -- distinct from M1 (0x121E), M2 (0x121F),
  // M4 Stage A (0x121D / 0x121C), Stage B (0x1220), Stage C (0x1221).
  pub let R121PBP_SCHEMA_ID : u64 = 0x1222

  // Fail message: len("boot pipe backpressure fail") == 27 + NUL = 28.
  pub let r121pbp_fail_msg : [u8; 28] = "boot pipe backpressure fail\0"

  // ==========================================================================
  // witness_r121_pipeline_edge_backpressure() -> ()
  //
  // Register plan (5 callee-save pushes leave rsp%16 == 0 at every nested
  // call site; entry rsp%16 == 8, +40 -> %16 == 0):
  //   rbx = prod_row
  //   r12 = cons_row
  //   r13 = iter cursor (0..R121PBP_TARGET-1)
  //   r14 = scratch (drain-loop counter, invariant scratch)
  //   r15 = scratch (steady value / final-drain safety cap)
  //
  // Counters live in memory (_r121pbp_sent / _eagain / _drained_main /
  // _drained_final) because five callee-save registers do not fit
  // prod_row + cons_row + iter + four counters simultaneously; a
  // load-inc-store idiom on each bump keeps the register plan simple
  // and mirrors pet_note's own bounded-stats-bump discipline.
  // ==========================================================================
  pub let witness_r121_pipeline_edge_backpressure : () -> () !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R121.M6 (paideia-os #2500): boot witness for the KIND_PIPELINE_EDGE backpressure discipline. Adapts the design plan's 5-minute QEMU adversarial-schedule acceptance criterion to the boot-fingerprint pattern by running an in-kernel fast-producer / slow-consumer schedule over the M2 SPSC ring in <100 ms wall (see file header §LATENCY BUDGET). Sequence: (1) mint PROD row (stage 1), (2) mint CONS row (stage 2), (3) bind them (stage 3), (4) main loop R121PBP_TARGET iterations: each iter attempts one send with handle=iter+1 (stage 4 if send returns a non-zero non-PET_EAGAIN sentinel -- impossible under the M2 SPSC contract); every 4th iter (iter & 3 == 3) drains one record (stage 5 if the drain returns PET_EAGAIN -- impossible since the ring is non-empty after any send whether accepted or refused). (5) Final drain: bounded 32-iter loop (stage 6 if the bound is exceeded) drains every remaining record until pet_ring_pop returns PET_EAGAIN. (6) Invariant checks: sent + eagain == R121PBP_TARGET (stage 7); drained_main + drained_final == sent (stage 8, no-leak witness); eagain > 0 (stage 9, backpressure-fired witness). On success emit `pipe backpressure ok steady=<n> sent=<n> drained=<n>` via klog_s1_d3, then `pipe backpressure audit sent=<n> eagain=<n> drained=<n>` via klog_s1_d3 -- both all-decimal. Failure funnel emits `boot pipe backpressure fail line=<stage>` via klog_s1_d1. Cleanup teardown runs on every exit (success + every failure arm): pipeline_edge_free on both rows + pet_ring_free on the bound ring, the ring lookup routed through pet_row_read_ring_id BEFORE the row scrub (pipeline_edge_free zeros the row-header in_use marker but does NOT touch the separate _pet_row_ring_id table -- the mapping stays valid until pet_row_write_ring_id is called or pet_init runs, which is fine for teardown ordering here). Counters live in memory (_r121pbp_sent / _eagain / _drained_main / _drained_final) because five callee-save registers do not fit prod_row + cons_row + iter + four counters simultaneously; a load-inc-store idiom on each bump keeps the register plan simple and mirrors pet_note's own bounded-stats-bump discipline. Five callee-save pushes (rbx=prod_row, r12=cons_row, r13=iter, r14=scratch, r15=scratch) leave rsp%16==0 at every nested call (entry rsp%16==8, +40 -> %16==0). klog_s1_d3 caller-push idiom (matches pipeline_edge.pdx pipeline_edge_alloc L668 comment and the M2 witness's klog_s1_d2 idiom): sub rsp,8 pre-align, push v3/k3/v2 in that order, add rsp,32 tail (pop 3 + undo pre-align). klog_s1_d1 idiom: entry rsp%16==0, direct call, no push. Reserved-label discipline: all labels prefixed r121pbp_, avoiding loop/if/top/done keyword collisions.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // Reset counters at witness entry so a re-run (if the boot path
        // ever re-enters this witness) starts from a clean slate.
        xor rax, rax;
        mov [rip + _r121pbp_stage], rax;
        mov [rip + _r121pbp_sent], rax;
        mov [rip + _r121pbp_eagain], rax;
        mov [rip + _r121pbp_drained_main], rax;
        mov [rip + _r121pbp_drained_final], rax;

        // ============================================================
        // Stage 1: mint PROD endpoint.
        // ============================================================
        mov rax, 1;
        mov [rip + _r121pbp_stage], rax;

        mov rdi, 0x1222;                  // R121PBP_SCHEMA_ID
        mov rsi, 0;                       // PE_ROLE_PROD
        mov rdx, 0x001;                   // R_PE_SEND
        call pipeline_edge_alloc;
        mov r10, 32;                      // PE_MAX
        cmp rax, r10;
        jae r121pbp_fail;
        mov rbx, rax;                     // prod_row

        // ============================================================
        // Stage 2: mint CONS endpoint.
        // ============================================================
        mov rax, 2;
        mov [rip + _r121pbp_stage], rax;

        mov rdi, 0x1222;
        mov rsi, 1;                       // PE_ROLE_CONS
        mov rdx, 0x002;                   // R_PE_RECV
        call pipeline_edge_alloc;
        mov r10, 32;
        cmp rax, r10;
        jae r121pbp_fail_cleanup_prod;
        mov r12, rax;                     // cons_row

        // ============================================================
        // Stage 3: bind them.
        // ============================================================
        mov rax, 3;
        mov [rip + _r121pbp_stage], rax;

        mov rdi, rbx;
        mov rsi, r12;
        call pipe_edge_bind_byrow;
        cmp rax, 0;                       // PE_OK
        jne r121pbp_fail_cleanup_both;

        // ============================================================
        // Stage 4/5: main-loop adversarial schedule. For iter in
        // [0..R121PBP_TARGET-1]:
        //   send(prod, iter+1); classify result (OK / EAGAIN / other);
        //   if (iter & 3) == 3: drain one record.
        // ============================================================
        xor r13, r13;                     // iter cursor

      r121pbp_main:
        mov r10, 1000;                    // R121PBP_TARGET
        cmp r13, r10;
        jae r121pbp_main_done;

        // send(prod, iter+1).
        mov rax, 4;
        mov [rip + _r121pbp_stage], rax;
        mov rdi, rbx;
        mov rsi, r13;
        add rsi, 1;                       // handle = iter+1 (non-zero)
        call pipe_edge_send_byrow;

        // Classify: 0 -> sent++; PET_EAGAIN (0xFFFFFFFFFFFFFFF5) -> eagain++;
        // anything else -> stage 4 fail.
        cmp rax, 0;
        je  r121pbp_send_ok;
        mov r10, 0xFFFFFFFFFFFFFFF5;      // PET_EAGAIN
        cmp rax, r10;
        jne r121pbp_fail_cleanup_bound;
        // eagain++.
        mov rax, [rip + _r121pbp_eagain];
        add rax, 1;
        mov [rip + _r121pbp_eagain], rax;
        jmp r121pbp_maybe_drain;

      r121pbp_send_ok:
        // sent++.
        mov rax, [rip + _r121pbp_sent];
        add rax, 1;
        mov [rip + _r121pbp_sent], rax;

      r121pbp_maybe_drain:
        // Drain every 4th iter. (iter & 3) == 3.
        mov r14, r13;
        mov r10, 3;                       // mask (fits imm32)
        and r14, r10;
        cmp r14, 3;
        jne r121pbp_next;

        // drain: recv(cons); expect a non-EAGAIN handle.
        mov rax, 5;
        mov [rip + _r121pbp_stage], rax;
        mov rdi, r12;
        call pipe_edge_recv_byrow;
        mov r10, 0xFFFFFFFFFFFFFFF5;      // PET_EAGAIN
        cmp rax, r10;
        je  r121pbp_fail_cleanup_bound;
        // drained_main++.
        mov rax, [rip + _r121pbp_drained_main];
        add rax, 1;
        mov [rip + _r121pbp_drained_main], rax;

      r121pbp_next:
        add r13, 1;
        jmp r121pbp_main;

      r121pbp_main_done:
        // ============================================================
        // Final drain: bounded (<=32) loop drains every remaining
        // record. r14 = safety-cap counter, r15 = drained_final tally.
        // ============================================================
        xor r14, r14;                     // safety cap 0..32
        xor r15, r15;                     // drained_final tally

      r121pbp_fdrain:
        mov r10, 32;
        cmp r14, r10;
        jae r121pbp_fdrain_overrun;

        mov rdi, r12;
        call pipe_edge_recv_byrow;
        mov r10, 0xFFFFFFFFFFFFFFF5;      // PET_EAGAIN
        cmp rax, r10;
        je  r121pbp_fdrain_done;
        add r15, 1;
        add r14, 1;
        jmp r121pbp_fdrain;

      r121pbp_fdrain_overrun:
        // Safety cap tripped -- ring not draining. Emit stage 6.
        mov rax, 6;
        mov [rip + _r121pbp_stage], rax;
        // Commit the (partial) drained_final tally so the audit line
        // still reports what we saw before jumping to the failure
        // funnel below.
        mov [rip + _r121pbp_drained_final], r15;
        jmp r121pbp_fail_cleanup_bound;

      r121pbp_fdrain_done:
        mov [rip + _r121pbp_drained_final], r15;

        // ============================================================
        // Invariant checks (stages 7/8/9).
        //   7  sent + eagain == R121PBP_TARGET
        //   8  drained_main + drained_final == sent
        //   9  eagain > 0
        // ============================================================
        // (7) sent + eagain == TARGET.
        mov rax, 7;
        mov [rip + _r121pbp_stage], rax;
        mov rax, [rip + _r121pbp_sent];
        mov r10, [rip + _r121pbp_eagain];
        add rax, r10;
        mov r10, 1000;                    // R121PBP_TARGET
        cmp rax, r10;
        jne r121pbp_fail_cleanup_bound;

        // (8) drained_main + drained_final == sent.
        mov rax, 8;
        mov [rip + _r121pbp_stage], rax;
        mov rax, [rip + _r121pbp_drained_main];
        mov r10, [rip + _r121pbp_drained_final];
        add rax, r10;
        mov r10, [rip + _r121pbp_sent];
        cmp rax, r10;
        jne r121pbp_fail_cleanup_bound;

        // (9) eagain > 0. (Backpressure must have fired at least once.)
        mov rax, 9;
        mov [rip + _r121pbp_stage], rax;
        mov rax, [rip + _r121pbp_eagain];
        cmp rax, 0;
        je  r121pbp_fail_cleanup_bound;

        // ============================================================
        // Success emit: two fingerprints.
        //   `pipe backpressure ok steady=<n> sent=<n> drained=<n>`
        //   `pipe backpressure audit sent=<n> eagain=<n> drained=<n>`
        // Both via klog_s1_d3. Entry rsp%16 == 0 (five callee-save
        // pushes on prologue). klog_s1_d3 caller-push idiom: sub 8
        // pre-align, push v3/k3/v2, call, add 32 tail. r13 = drained
        // (main + final) staged before both emits since both lines
        // carry it.
        // ============================================================
        mov rax, [rip + _r121pbp_drained_main];
        mov r10, [rip + _r121pbp_drained_final];
        add rax, r10;
        mov r13, rax;                     // r13 = drained_total

        // --- Emit 1: `pipe backpressure ok steady=<S> sent=<T> drained=<D>` ---
        // v1 = R121PBP_STEADY (250), v2 = sent, v3 = drained_total.
        sub rsp, 8;
        mov rax, r13;                     // v3 = drained_total
        push rax;
        lea rax, [rip + k_drained];       // k3
        push rax;
        mov rax, [rip + _r121pbp_sent];   // v2 = sent
        push rax;
        mov rdi, 3;                       // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_pipe_backpressure_ok];
        lea rcx, [rip + k_steady];        // k1
        mov r8,  250;                     // v1 = R121PBP_STEADY
        lea r9,  [rip + k_sent];          // k2
        call klog_s1_d3;
        add rsp, 32;

        // --- Emit 2: `pipe backpressure audit sent=<T> eagain=<E> drained=<D>` ---
        // v1 = sent, v2 = eagain, v3 = drained_total.
        sub rsp, 8;
        mov rax, r13;                     // v3 = drained_total
        push rax;
        lea rax, [rip + k_drained];       // k3
        push rax;
        mov rax, [rip + _r121pbp_eagain]; // v2 = eagain
        push rax;
        mov rdi, 3;                       // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_pipe_backpressure_audit];
        lea rcx, [rip + k_sent];          // k1
        mov r8,  [rip + _r121pbp_sent];   // v1 = sent
        lea r9,  [rip + k_eagain];        // k2
        call klog_s1_d3;
        add rsp, 32;

        // ============================================================
        // Success cleanup: recover ring_id, free rows, free ring.
        // ============================================================
        mov rdi, rbx;
        call pet_row_read_ring_id;
        mov r15, rax;                     // ring_id

        mov rdi, rbx;
        call pipeline_edge_free;
        mov rdi, r12;
        call pipeline_edge_free;

        mov r10, 16;                      // PET_RING_MAX
        cmp r15, r10;
        jae r121pbp_out;
        mov rdi, r15;
        call pet_ring_free;
        jmp r121pbp_out;

      // ============================================================
      // Failure funnels. Cleanup varies by stage.
      // ============================================================

      r121pbp_fail_cleanup_bound:
        // Both rows live + bound to a ring.
        mov rdi, rbx;
        call pet_row_read_ring_id;
        mov r15, rax;
        mov rdi, rbx;
        call pipeline_edge_free;
        mov rdi, r12;
        call pipeline_edge_free;
        mov r10, 16;
        cmp r15, r10;
        jae r121pbp_fail;
        mov rdi, r15;
        call pet_ring_free;
        jmp r121pbp_fail;

      r121pbp_fail_cleanup_both:
        // Both rows live, unbound (bind failed).
        mov rdi, rbx;
        call pipeline_edge_free;
        mov rdi, r12;
        call pipeline_edge_free;
        jmp r121pbp_fail;

      r121pbp_fail_cleanup_prod:
        // Prod row live, cons mint failed.
        mov rdi, rbx;
        call pipeline_edge_free;

      r121pbp_fail:
        // Emit `boot pipe backpressure fail line=<stage>` via klog_s1_d1.
        mov rax, [rip + _r121pbp_stage];
        mov rdi, 3;                       // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + r121pbp_fail_msg];
        lea rcx, [rip + k_line];
        mov r8,  rax;                     // v = stage
        call klog_s1_d1;

      r121pbp_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
