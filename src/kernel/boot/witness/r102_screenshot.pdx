// src/kernel/boot/witness/r102_screenshot.pdx — R102.MON-008 skeleton
//
// R102.MON-008 (paideia-os #2215) owns the boot smoke that pins the
// compositor `screenshot-region` query cascade -- invoke the semantic-
// pipe query, verify the returned pixel region carries the expected
// BLAKE3 digest. Fires once svc-compositor.M4-004 (query surface end-
// to-end) has landed upstream and its ELF is embedded via R102.MON-003.
//
// As of this landing, svc-compositor is an empty scaffold under
// github.com/paideia-os (LICENSE + README.md only). See
// r102_first_pixel.pdx header for the full disposition.
//
// Skeleton body: emit ONE lowercase skip fingerprint and return.
//
//   Skeleton (this landing):
//     "boot r102 screenshot skip reason=no-userland"
//   Future (when the cascade fires):
//     "boot r102 screenshot ok"           (per r102-user-plan.md §4.10)
//
// Encoder discipline: same as r102_first_pixel.pdx.

module R102Screenshot = structure {

  // 45 bytes including NUL.
  pub let tag_r102_screenshot_skip : [u8; 45] =
    "boot r102 screenshot skip reason=no-userland\0"

  pub let witness_r102_screenshot : () -> () !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R102.MON-008 skeleton (paideia-os #2215). Emits the ONE-line lowercase skip fingerprint `boot r102 screenshot skip reason=no-userland` on every boot. The full cascade requires svc-compositor.M4-004 (screenshot-region query wired end-to-end) upstream and R102.MON-003's ELF embed; neither holds as of the R102 MON- wave. push rbp / pop rbp preserves the caller's rsp%16 parity and rbp guarantee across the nested klog_s1 call.",
      block: {
        push rbp;

        mov rdi, 3;                              // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_r102_screenshot_skip];
        call klog_s1;

        pop rbp;
        ret
      }
    }
}
