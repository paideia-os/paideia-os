// src/kernel/boot/witness/r16_syscalls.pdx — boot witness module
//
// Extracted verbatim from src/kernel/boot/kernel_main.pdx (which had grown
// to 24,315 lines in two functions).  R16.M3 syscall witness block — O_CREAT, sys_open/close/read/write, user_ptr_ok, sys_dup2, fd_inherit and fd_cloexec.
//
// -----------------------------------------------------------------------------
// Why the body is copied and not rewritten
// -----------------------------------------------------------------------------
//
// The goldens for this tree assert an ORDERED SUBSEQUENCE of fingerprints
// across 14 boot modes, and a witness that silently stops running still
// leaves most of that subsequence intact.  The extraction therefore moves
// the instruction stream unchanged: the only bytes this module adds around
// it are the `push rbp` / `pop rbp` / `ret` below.
//
// -----------------------------------------------------------------------------
// The push is not decoration
// -----------------------------------------------------------------------------
//
// `boot_continue_after_ring3` runs its body at `rsp % 16 == 8` — it sits two `call` levels
// below `_start`, and paideia-as emits no frame prologue for an
// `unsafe`-bodied lambda (emit_visit_lambda.rs suppresses the prologue for
// Unsafe bodies, which is also why `no-frame` is a no-op there).  Several
// witnesses in this file reason explicitly about that parity — "3 pushes from %16==8
// yields (8+3*8)%16 == 0" — and a bare `call` into a bare body would enter
// at `%16 == 0` and invert every one of those arguments.  The single
// `push rbp` restores the inline parity exactly; the matching `pop rbp`
// keeps rbp's SysV guarantee for the caller.
//
// Sections in this module, in the order boot_continue_after_ring3 ran them:
//   * #664 verification: vfs_open O_CREAT witness — new file creation
//   * R16-M3-001 (#587): sys_open witness — 5 sub-tests, 1 marker
//   * R16-M3-002 (#588): sys_close witness — 5 sub-tests, 1 marker
//   * R16-M3-003 (#589): sys_read witness — preamble + 5 sub-tests
//   * R16-M3-004 (#590): sys_write witness — preamble + 4 sub-tests
//   * R15-M4-007 (#541): user_ptr_ok witness — 2 sub-tests
//   * R16-M3-005 (#591): sys_dup2 witness — preamble + 6 sub-tests
//   * R16-M3-006 (#592): fd_inherit witness — preamble + fork + 3 sub-tests
//   * R16-M3-007 (#593): fd_cloexec witness — preamble + execve + 3 sub-tests

module R16Syscalls = structure {

  // witness_r16_syscalls() — the R16.M3 syscall witness block — O_CREAT, sys_open/close/read/write, user_ptr_ok, sys_dup2, fd_inherit and fd_cloexec.
  //
  // Effect and capability rows are the ones the enclosing
  // `boot_continue_after_ring3` declares.  They are not widened here: this
  // is the same instruction stream under a new symbol, so the authority it
  // needs is by construction the authority it already had.
  pub let witness_r16_syscalls : () -> () !{sysreg} @{} = fn () -> unsafe {
    effects: { sysreg },
    capabilities: { boot },
    justification: "Boot witness block lifted verbatim out of kernel_main.pdx's boot_continue_after_ring3 during the r16_syscalls extraction. Body bytes are unchanged from the inline form; the only additions are the entry `push rbp` and the exit `pop rbp; ret`. The push is load-bearing rather than cosmetic: boot_continue_after_ring3 executes its body at rsp%16 == 8 (two `call` levels below _start, with no frame prologue emitted for unsafe-bodied lambdas), and the witnesses inside this module compute their own nested-call alignment from that parity. Entering through a `call` without the compensating push would present rsp%16 == 0 to the body and silently invert every such argument — the failure mode of paideia-os #1192, #1195 and #1584. Effects and capabilities are copied unchanged from the enclosing function for the same reason: no authority is added, so none needs justifying beyond what boot_continue_after_ring3 already justified.",
    block: {
      push rbp;

      // ============================================================
      // #664 verification: vfs_open O_CREAT witness — new file creation
      // via tmpfs backend. 3 sub-tests, 1 marker.
      //
      // Preamble: wire root vnode's ops_ptr/backend_ptr to tmpfs. Same
      // fixup as the #589 sys_read_witness preamble below — mount()'s
      // root vnode is never permanently wired to tmpfs elsewhere in the
      // boot sequence; every witness that needs a real backend-dispatched
      // create/lookup on root must wire it locally (idempotent — safe to
      // repeat).
      //
      // Sub-test A: rax = vfs_open("/newfile", O_CREAT|O_RDWR = 0x42).
      //             Expect rax != 0 (fresh vnode idx).
      // Sub-test B: vnode_slot(rax).refcount == 1 (fresh vnode, first
      //             open increments 0 -> 1).
      // Sub-test C: tmpfs_lookup(TMPFS_INODE_IDX_ROOT=1, "newfile") != 0
      //             — confirms the tmpfs backend actually linked the new
      //             inode into root's sibling chain (not just a VFS-side
      //             vnode-pool entry).
      // Marker: "R16 OCREAT OK" on A, B, C pass.
      // ============================================================
      ocreat_witness:
          // --- Preamble: wire root vnode to tmpfs (idempotent) ---
          call mount_root_vnode                        // rax = root vnode idx
          mov  rdi, rax
          call vnode_slot                               // rax = &vnode[root]
          lea  rcx, [rip + _tmpfs_vops]
          mov  [rax + 24], rcx                          // ops_ptr = &_tmpfs_vops
          mov  rcx, 1                                   // TMPFS_INODE_IDX_ROOT
          mov  [rax + 32], rcx                          // backend_ptr = root_idx

          // --- Preamble: free slot 202 (belt+suspenders — post-#680 the pool
          //     is reset at end of vnode_pool_witness so this is redundant,
          //     but idempotent so cheap to keep as defense-in-depth. Filed as
          //     paideia-os #680; delete this call once #680 audit confirms
          //     no other witnesses depend on the saturation state) ---
          mov  rdi, 202
          call vnode_free

          // --- Sub-test A: vfs_open("/newfile", O_CREAT|O_RDWR) ---
          lea  rdi, [rip + witness_path_newfile]        // "/newfile"
          mov  rsi, 0x42                                 // O_CREAT (0x40) | O_RDWR (0x02)
          call vfs_open
          mov  r13, rax                                  // DEBUG: stash for later print
          cmp  rax, 0
          je   ocreat_witness_fail_a
          mov  r12, rax                                  // r12 = new vnode idx

          // --- Sub-test B: refcount == 1 (fresh vnode, first open) ---
          mov  rdi, r12
          call vnode_slot                                // rax = &vnode[new]
          xor  rcx, rcx
          mov_w rcx, [rax + 4]                            // refcount (u16 at +4)
          mov  r13, rcx                                   // DEBUG: stash for later print
          cmp  rcx, 1
          jne  ocreat_witness_fail_b

          // --- Sub-test C: tmpfs backend actually linked "newfile" under root ---
          mov  rdi, 1                                    // TMPFS_INODE_IDX_ROOT
          lea  rsi, [rip + witness_name_newfile]         // "newfile"
          call tmpfs_lookup
          mov  r13, rax                                   // DEBUG: stash for later print
          cmp  rax, 0
          je   ocreat_witness_fail_c

          // --- All green ---
          mov rdi, 3;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + ocreat_ok_msg];
          call klog_s1;
          jmp  ocreat_witness_done

      ocreat_witness_fail_a:
          mov rdi, 3;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + ocreat_debug_a_msg];
          call klog_s1;
          jmp  ocreat_witness_fail

      ocreat_witness_fail_b:
          mov rdi, 3;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + ocreat_debug_b_msg];
          call klog_s1;
          jmp  ocreat_witness_fail

      ocreat_witness_fail_c:
          mov rdi, 3;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + ocreat_debug_c_msg];
          call klog_s1;
          jmp  ocreat_witness_fail

      ocreat_witness_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + ocreat_fail_msg];
          call klog_s1;

      ocreat_witness_done:

      // ============================================================
      // R16-M3-001 (#587): sys_open witness — 5 sub-tests, 1 marker
      // ============================================================
      sys_open_witness:
          // --- Sub-test A: first open returns 3 ---
          lea  rdi, [rip + _sys_open_witness_task]
          lea  rsi, [rip + witness_path_slash]
          xor  rdx, rdx
          xor  rcx, rcx
          call sys_open_body
          cmp  rax, 3
          jne  sys_open_witness_fail

          // --- Sub-test B: second open returns 4 ---
          lea  rdi, [rip + _sys_open_witness_task]
          lea  rsi, [rip + witness_path_slash]
          xor  rdx, rdx
          xor  rcx, rcx
          call sys_open_body
          cmp  rax, 4
          jne  sys_open_witness_fail

          // --- Sub-test C: third open returns 5 ---
          lea  rdi, [rip + _sys_open_witness_task]
          lea  rsi, [rip + witness_path_slash]
          xor  rdx, rdx
          xor  rcx, rcx
          call sys_open_body
          cmp  rax, 5
          jne  sys_open_witness_fail

          // --- Sub-test D: fd_table[3] has valid packed entry ---
          lea  rdi, [rip + _sys_open_witness_task]
          mov  rsi, 3
          call fd_get
          mov  rcx, rax
          and  rcx, 0xFFFF                          // vnode_idx (low 16)
          cmp  rcx, 0
          je   sys_open_witness_fail
          mov  rcx, rax
          shr  rcx, 16                              // offset (high 48)
          cmp  rcx, 0
          jne  sys_open_witness_fail

          // --- Sub-test E: error path returns -ENOENT for "/nope" ---
          lea  rdi, [rip + _sys_open_witness_task]
          lea  rsi, [rip + witness_path_nope]
          xor  rdx, rdx
          xor  rcx, rcx
          call sys_open_body
          mov  rcx, 0xFFFFFFFFFFFFFFFE
          cmp  rax, rcx
          jne  sys_open_witness_fail

          // --- All green ---
          mov rdi, 3;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + sys_open_ok_msg];
          call klog_s1;
          jmp  sys_open_witness_done

      sys_open_witness_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + sys_open_fail_msg];
          call klog_s1;

      sys_open_witness_done:

      // ============================================================
      // R16-M3-002 (#588): sys_close witness — 5 sub-tests, 1 marker
      // ============================================================
      sys_close_witness:
          // --- Prep: sys_open on fresh slab to seed fd 3 ---
          lea  rdi, [rip + _sys_close_witness_task]
          lea  rsi, [rip + witness_path_slash]
          xor  rdx, rdx
          xor  rcx, rcx
          call sys_open_body
          cmp  rax, 3
          jne  sys_close_witness_fail

          // --- Sub-test A: sys_close(w, 3) → 0 ---
          lea  rdi, [rip + _sys_close_witness_task]
          mov  rsi, 3
          call sys_close_body
          cmp  rax, 0
          jne  sys_close_witness_fail

          // --- Sub-test B: fd_get(w, 3) → 0 (slot cleared) ---
          lea  rdi, [rip + _sys_close_witness_task]
          mov  rsi, 3
          call fd_get
          cmp  rax, 0
          jne  sys_close_witness_fail

          // --- Sub-test C: sys_close(w, 2) → -EBADF ---
          lea  rdi, [rip + _sys_close_witness_task]
          mov  rsi, 2
          call sys_close_body
          mov  rcx, 0xFFFFFFFFFFFFFFF7
          cmp  rax, rcx
          jne  sys_close_witness_fail

          // --- Sub-test D: sys_close(w, 32) → -EBADF ---
          lea  rdi, [rip + _sys_close_witness_task]
          mov  rsi, 32
          call sys_close_body
          mov  rcx, 0xFFFFFFFFFFFFFFF7
          cmp  rax, rcx
          jne  sys_close_witness_fail

          // --- Sub-test E: sys_close(w, 3) again → -EBADF (already closed) ---
          lea  rdi, [rip + _sys_close_witness_task]
          mov  rsi, 3
          call sys_close_body
          mov  rcx, 0xFFFFFFFFFFFFFFF7
          cmp  rax, rcx
          jne  sys_close_witness_fail

          // --- All green ---
          mov rdi, 3;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + sys_close_ok_msg];
          call klog_s1;
          jmp  sys_close_witness_done

      sys_close_witness_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + sys_close_fail_msg];
          call klog_s1;

      sys_close_witness_done:

      // ============================================================
      // R16-M3-003 (#589): sys_read witness — preamble + 5 sub-tests
      // ============================================================
      sys_read_witness:
          // --- Preamble (fixup): wire the persistent root vnode to tmpfs ---
          // The real root vnode allocated by the #574 mount() witness (via
          // vnode_alloc) has never had its ops_ptr(+24)/backend_ptr(+32)
          // fields populated. The #586 tmpfs-vops-wire witness only proved
          // dispatch through a throwaway SCRATCH vnode built on the stack;
          // it never touched the persistent tree root. Every sys_open
          // witness up to and including #587 only exercised single- or
          // zero-component paths ("/", "/nope") whose path_resolve never
          // needs a populated ops_ptr (no vops_lookup call is reached for
          // "/"; the "/nope" ENOENT case is satisfied by vops_lookup's own
          // null-ops_ptr -> VOPS_ERR_NOT_SUPPORTED short-circuit, which
          // happens to collapse to the same ENOENT outcome). #589 is the
          // first witness to resolve a real multi-component path
          // ("/tmp/x") through the actual tmpfs backend, which surfaces
          // this wiring gap: without it, vops_lookup(root_vnode, "tmp")
          // hits the null-ops_ptr guard and path_resolve fails. Wire it
          // here, once, before any lookup/open in this witness.
          call mount_root_vnode                       // rax = real root vnode idx
          mov  rdi, rax
          call vnode_slot                              // rax = &vnode[root]
          lea  rcx, [rip + _tmpfs_vops]
          mov  [rax + 24], rcx                         // ops_ptr = &_tmpfs_vops
          mov  rcx, 1                                  // TMPFS_INODE_IDX_ROOT
          mov  [rax + 32], rcx                         // backend_ptr = root_idx

          // --- Preamble: recover x_idx, re-seed data, open fd=3 ---
          mov  rdi, 1
          lea  rsi, [rip + witness_name_tmp]
          call tmpfs_lookup
          cmp  rax, 0
          je   sys_read_witness_fail
          mov  r12, rax                               // r12 = tmp_idx

          // --- Preamble (fixup, cont'd): wire /tmp's vnode-pool slot too ---
          // path_resolve's regular_lookup treats vops_lookup's returned
          // child index (a tmpfs-native inode idx, e.g. tmp_idx here) as
          // the NEXT vnode-pool index for its following vnode_slot call.
          // Nothing else in the boot sequence ever populates
          // _vnode_pool[tmp_idx] for the real (non-scratch) tree, so the
          // "x" component lookup would hit the same null-ops_ptr gap this
          // preamble just fixed for the root. Same wiring, same rationale.
          mov  rdi, r12
          call vnode_slot                              // rax = &vnode[tmp_idx]
          lea  rcx, [rip + _tmpfs_vops]
          mov  [rax + 24], rcx                         // ops_ptr = &_tmpfs_vops
          mov  rcx, r12
          mov  [rax + 32], rcx                         // backend_ptr = tmp_idx

          // /tmp/x was unlinked by the #585 tmpfs_unlink witness earlier in
          // boot (directory entry spliced out + bitmap bit cleared, proven
          // by that witness's own sub-tests B/D). A tmpfs_lookup here would
          // miss, so re-create it via tmpfs_create — same args as the #582
          // tmpfs_create witness (tmp_idx, "x", name_len=1, type=REG=1) —
          // before seeding data and opening it.
          mov  rdi, r12                               // dir_idx = tmp_idx
          lea  rsi, [rip + witness_name_any]           // name_ptr = "x\0"
          mov  rdx, 1                                  // name_len = 1
          mov  rcx, 1                                  // type = VNODE_TYPE_REG
          call tmpfs_create
          cmp  rax, 0
          je   sys_read_witness_fail
          cmp  rax, 0xFFFF
          je   sys_read_witness_fail                   // alloc-OOM sentinel
          mov  r13, rax                               // r13 = x_idx (freshly created)

          // --- Preamble (fixup, cont'd): wire x_idx's vnode-pool slot too ---
          // vfs_read (called from inside sys_read_body) resolves its
          // vnode_idx argument via vnode_slot + vops_read, same identity
          // assumption as path_resolve's regular_lookup. Without this,
          // vops_read's null-ops_ptr guard fires and sys_read_body sees
          // the VOPS_ERR_NOT_SUPPORTED sentinel, returning -EIO instead of
          // bytes_read. Same wiring, same rationale as tmp_idx above.
          mov  rdi, r13
          call vnode_slot                              // rax = &vnode[x_idx]
          lea  rcx, [rip + _tmpfs_vops]
          mov  [rax + 24], rcx                         // ops_ptr = &_tmpfs_vops
          mov  rcx, r13
          mov  [rax + 32], rcx                         // backend_ptr = x_idx

          mov  rdi, r13
          lea  rsi, [rip + tmpfs_write_src_buf]
          mov  rdx, 100
          xor  rcx, rcx
          call tmpfs_write
          cmp  rax, 100
          jne  sys_read_witness_fail

          lea  rdi, [rip + _sys_read_witness_task]
          lea  rsi, [rip + witness_path_tmp_x]
          xor  rdx, rdx
          xor  rcx, rcx
          call sys_open_body
          cmp  rax, 3
          jne  sys_read_witness_fail

          // --- Sub-test A: sys_read(w, 3, dst_buf, 100) → 100 ---
          lea  rdi, [rip + _sys_read_witness_task]
          mov  rsi, 3
          lea  rdx, [rip + tmpfs_read_dst_buf]
          mov  rcx, 100
          call sys_read_body
          cmp  rax, 100
          jne  sys_read_witness_fail

          // --- Sub-test B: dst_buf[0..8] == 0x4141414141414141 ---
          lea  r14, [rip + tmpfs_read_dst_buf]
          mov  rcx, [r14]
          mov  rdx, 0x4141414141414141
          cmp  rcx, rdx
          jne  sys_read_witness_fail

          // --- Sub-test C: fd_table[3] offset field == 100 ---
          lea  rdi, [rip + _sys_read_witness_task]
          mov  rsi, 3
          call fd_get
          mov  rcx, rax
          shr  rcx, 16
          cmp  rcx, 100
          jne  sys_read_witness_fail

          // --- Sub-test D: consecutive sys_read → 0 (EOF) ---
          lea  rdi, [rip + _sys_read_witness_task]
          mov  rsi, 3
          lea  rdx, [rip + tmpfs_read_dst_buf]
          mov  rcx, 100
          call sys_read_body
          cmp  rax, 0
          jne  sys_read_witness_fail

          // --- Sub-test E: sys_read(w, 2, ...) → -EBADF ---
          lea  rdi, [rip + _sys_read_witness_task]
          mov  rsi, 2
          lea  rdx, [rip + tmpfs_read_dst_buf]
          mov  rcx, 100
          call sys_read_body
          mov  rcx, 0xFFFFFFFFFFFFFFF7
          cmp  rax, rcx
          jne  sys_read_witness_fail

          // --- All green ---
          mov rdi, 3;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + sys_read_ok_msg];
          call klog_s1;
          jmp  sys_read_witness_done

      sys_read_witness_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + sys_read_fail_msg];
          call klog_s1;

      sys_read_witness_done:

      // ============================================================
      // R16-M3-004 (#590): sys_write witness — preamble + 4 sub-tests
      // ============================================================
      sys_write_witness:
          // --- Preamble: wire root and tmp_idx, recover x_idx, trim /tmp/x to 0;
          //               wire fresh x_idx; open fd=3 ---
          // Although root and tmp_idx wiring persisted from #589, we ensure they're
          // wired here for defensive idempotency, matching sys_read witness pattern.
          call mount_root_vnode                       // rax = real root vnode idx
          mov  rdi, rax
          call vnode_slot                              // rax = &vnode[root]
          lea  rcx, [rip + _tmpfs_vops]
          mov  [rax + 24], rcx                         // ops_ptr = &_tmpfs_vops
          mov  rcx, 1                                  // TMPFS_INODE_IDX_ROOT
          mov  [rax + 32], rcx                         // backend_ptr = root_idx

          // Recover tmp_idx via lookup
          mov  rdi, 1
          lea  rsi, [rip + witness_name_tmp]
          call tmpfs_lookup
          cmp  rax, 0
          je   sys_write_witness_fail
          mov  r12, rax                               // r12 = tmp_idx

          // Wire /tmp's vnode-pool slot
          mov  rdi, r12
          call vnode_slot                              // rax = &vnode[tmp_idx]
          lea  rcx, [rip + _tmpfs_vops]
          mov  [rax + 24], rcx                         // ops_ptr = &_tmpfs_vops
          mov  rcx, r12
          mov  [rax + 32], rcx                         // backend_ptr = tmp_idx

          // Trim /tmp/x back to fresh 0-size state: unlink + create
          mov  rdi, r12
          lea  rsi, [rip + witness_name_any]
          mov  rdx, 1
          call tmpfs_unlink
          cmp  rax, 0
          jne  sys_write_witness_fail

          mov  rdi, r12
          lea  rsi, [rip + witness_name_any]
          mov  rdx, 1
          mov  rcx, 1                                 // VNODE_TYPE_REG
          call tmpfs_create
          cmp  rax, 0
          je   sys_write_witness_fail
          cmp  rax, 0xFFFF
          je   sys_write_witness_fail
          mov  r13, rax                               // r13 = fresh x_idx

          // Defensive vnode-pool wiring for x_idx (persists from #589 unless
          // unlink+create yielded a different idx — see §4.4).
          mov  rdi, r13
          call vnode_slot
          lea  rcx, [rip + _tmpfs_vops]
          mov  [rax + 24], rcx
          mov  rcx, r13
          mov  [rax + 32], rcx

          lea  rdi, [rip + _sys_write_witness_task]
          lea  rsi, [rip + witness_path_tmp_x]
          xor  rdx, rdx
          xor  rcx, rcx
          call sys_open_body
          cmp  rax, 3
          jne  sys_write_witness_fail

          // --- Sub-test A: sys_write(w, 3, src, 100) → 100 ---
          lea  rdi, [rip + _sys_write_witness_task]
          mov  rsi, 3
          lea  rdx, [rip + tmpfs_write_src_buf]
          mov  rcx, 100
          call sys_write_body
          cmp  rax, 100
          jne  sys_write_witness_fail

          // --- Sub-test B: fd_table[3] offset field == 100 ---
          lea  rdi, [rip + _sys_write_witness_task]
          mov  rsi, 3
          call fd_get
          mov  rcx, rax
          shr  rcx, 16
          cmp  rcx, 100
          jne  sys_write_witness_fail

          // --- Sub-test C: inode.size == 100 (grew from 0 post-create) ---
          mov  rdi, r13
          call tmpfs_inode_slot
          mov  rcx, [rax + 8]
          cmp  rcx, 100
          jne  sys_write_witness_fail

          // --- Sub-test D: sys_write(w, 2, ...) → -EBADF ---
          lea  rdi, [rip + _sys_write_witness_task]
          mov  rsi, 2
          lea  rdx, [rip + tmpfs_write_src_buf]
          mov  rcx, 100
          call sys_write_body
          mov  rcx, 0xFFFFFFFFFFFFFFF7
          cmp  rax, rcx
          jne  sys_write_witness_fail

          // --- All green ---
          mov rdi, 3;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + sys_write_ok_msg];
          call klog_s1;
          jmp  sys_write_witness_done

      sys_write_witness_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + sys_write_fail_msg];
          call klog_s1;

      sys_write_witness_done:

      // ============================================================
      // R15-M4-007 (#541): user_ptr_ok witness — 2 sub-tests
      //
      // Sub-A: user_ptr_ok(0xFFFFFFFFFFFFFFFF, 4) returns 1 (fault) —
      //        pointer sits in kernel half.
      // Sub-B: user_ptr_ok(0x400000, 4) returns 0 (OK) — user half.
      // Sub-C: syscall_dispatch(1, 1, 0xFFFFFFFFFFFFFFFF, 4, 0) via
      //        dispatch.pdx's dispatch_write path returns -EFAULT
      //        (0xFFFFFFFFFFFFFFF2). This is what proves AC fidelity —
      //        the fixture cited in issue #541.
      //
      // Marker: "R15 USER PTR OK" on all three passing.
      // ============================================================
      user_ptr_witness:
          // Sub-A: bogus pointer → fault (return 1)
          mov  rdi, 0xFFFFFFFFFFFFFFFF
          mov  rsi, 4
          call user_ptr_ok
          cmp  rax, 1
          jne  user_ptr_witness_fail

          // Sub-B: good pointer → OK (return 0)
          mov  rdi, 0x400000
          mov  rsi, 4
          call user_ptr_ok
          cmp  rax, 0
          jne  user_ptr_witness_fail

          // Sub-C: AC fixture — syscall_dispatch(1, 1, 0xFFFFFFFFFFFFFFFF, 4, 0)
          //        must return -EFAULT (0xFFFFFFFFFFFFFFF2).
          // dispatch.pdx dispatch entry ABI: rdi=syscall_num, rsi=arg0, rdx=arg1, rcx=arg2, r8=arg3
          // Write is syscall 1; args: fd=1, buf=0xFFFFFFFFFFFFFFFF, len=4.
          mov  rdi, 1                     // syscall_num = write (SC+ freeze)
          mov  rsi, 1                     // fd = stdout
          mov  rdx, 0xFFFFFFFFFFFFFFFF    // buf = bogus
          mov  rcx, 4                     // len = 4
          xor  r8, r8                     // arg3 unused
          call syscall_dispatch
          mov  rcx, 0xFFFFFFFFFFFFFFF2    // -EFAULT
          cmp  rax, rcx
          jne  user_ptr_witness_fail

          mov rdi, 3;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + user_ptr_ok_msg];
          call klog_s1;
          jmp  user_ptr_witness_done

      user_ptr_witness_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + user_ptr_fail_msg];
          call klog_s1;

      user_ptr_witness_done:

      // ============================================================
      // R16-M3-005 (#591): sys_dup2 witness — preamble + 6 sub-tests
      // ============================================================
      sys_dup2_witness:
          // --- Preamble: wire root, tmp, x; reset x refcount; open fd=3 (/tmp/x) and fd=4 (/) ---
          //
          // #665 Phase 5: after Phase 4 rewired path_resolve through
          // vnode_cache_or_alloc, tmpfs_lookup/tmpfs_create returns are backend
          // inode indices — NOT vnode-pool indices. This preamble therefore
          // must go through vnode_cache_or_alloc(parent_vn_idx, backend_idx,
          // ops_ptr) to reserve the same (parent, backend, ops)-triple slot
          // that path_resolve will later dedup against when sys_open_body
          // resolves "/tmp/x". Root is exempt — mount_root_vnode() already
          // returns a vnode-pool idx.
          call mount_root_vnode
          mov  r14, rax                               // r14 = root_vnode_pool_idx (parent for /tmp)
          mov  rdi, rax
          call vnode_slot
          lea  rcx, [rip + _tmpfs_vops]
          mov  [rax + 24], rcx
          mov  rcx, 1                                 // TMPFS_INODE_IDX_ROOT
          mov  [rax + 32], rcx

          mov  rdi, 1
          lea  rsi, [rip + witness_name_tmp]
          call tmpfs_lookup
          cmp  rax, 0
          je   sys_dup2_witness_fail
          mov  r12, rax                               // r12 = tmp_backend_idx

          // Reserve /tmp's vnode-pool slot via vnode_cache_or_alloc (dedup or fresh).
          mov  rdi, r14                               // parent = root_vnode_pool_idx
          mov  rsi, r12                               // backend = tmp_backend_idx
          lea  rdx, [rip + _tmpfs_vops]               // ops = _tmpfs_vops
          call vnode_cache_or_alloc
          cmp  rax, 0xFFFF
          je   sys_dup2_witness_fail
          mov  r15, rax                               // r15 = tmp_vnode_pool_idx (parent for /tmp/x)

          mov  rdi, r12
          lea  rsi, [rip + witness_name_any]
          mov  rdx, 1
          call tmpfs_unlink
          cmp  rax, 0
          jne  sys_dup2_witness_fail

          mov  rdi, r12
          lea  rsi, [rip + witness_name_any]
          mov  rdx, 1
          mov  rcx, 1                                 // VNODE_TYPE_REG
          call tmpfs_create
          cmp  rax, 0
          je   sys_dup2_witness_fail
          cmp  rax, 0xFFFF
          je   sys_dup2_witness_fail
          mov  r13, rax                               // r13 = fresh x_backend_idx

          // Reserve /tmp/x's vnode-pool slot via vnode_cache_or_alloc.
          mov  rdi, r15                               // parent = tmp_vnode_pool_idx
          mov  rsi, r13                               // backend = x_backend_idx
          lea  rdx, [rip + _tmpfs_vops]               // ops = _tmpfs_vops
          call vnode_cache_or_alloc
          cmp  rax, 0xFFFF
          je   sys_dup2_witness_fail
          mov  r13, rax                               // r13 = x_vnode_pool_idx (was x_backend_idx)

          // CRITICAL: reset x's vnode-pool slot refcount to 0 (§4.3.1)
          mov  rdi, r13
          call vnode_slot
          xor  rcx, rcx
          mov_w [rax + 4], rcx

          // sys_open("/tmp/x", 0, 0) → fd = 3, x_idx.refcount → 1
          lea  rdi, [rip + _sys_dup2_witness_task]
          lea  rsi, [rip + witness_path_tmp_x]
          xor  rdx, rdx
          xor  rcx, rcx
          call sys_open_body
          cmp  rax, 3
          jne  sys_dup2_witness_fail

          // sys_open("/", 0, 0) → fd = 4, root_idx.refcount ++
          lea  rdi, [rip + _sys_dup2_witness_task]
          lea  rsi, [rip + witness_path_slash]
          xor  rdx, rdx
          xor  rcx, rcx
          call sys_open_body
          cmp  rax, 4
          jne  sys_dup2_witness_fail

          // --- Sub-test D: sys_dup2(w, 3, 3) → 3 (no-op) ---
          lea  rdi, [rip + _sys_dup2_witness_task]
          mov  rsi, 3
          mov  rdx, 3
          call sys_dup2_body
          cmp  rax, 3
          jne  sys_dup2_witness_fail

          // --- Sub-test A: sys_dup2(w, 3, 5) → 5 ---
          lea  rdi, [rip + _sys_dup2_witness_task]
          mov  rsi, 3
          mov  rdx, 5
          call sys_dup2_body
          cmp  rax, 5
          jne  sys_dup2_witness_fail

          // --- Sub-test B: fd_table[5] == fd_table[3] ---
          lea  rdi, [rip + _sys_dup2_witness_task]
          mov  rsi, 3
          call fd_get
          mov  r12, rax                               // r12 = src_entry

          lea  rdi, [rip + _sys_dup2_witness_task]
          mov  rsi, 5
          call fd_get
          cmp  rax, r12
          jne  sys_dup2_witness_fail

          // --- Sub-test C: shared vnode's refcount == 2 ---
          lea  rdi, [rip + _sys_dup2_witness_task]
          mov  rsi, 3
          call fd_get
          and  rax, 0xFFFF
          mov  rdi, rax
          call vnode_slot
          xor  rcx, rcx
          mov_w rcx, [rax + 4]
          cmp  rcx, 2
          jne  sys_dup2_witness_fail

          // --- Sub-test E: sys_dup2(w, 99, 5) → -EBADF ---
          lea  rdi, [rip + _sys_dup2_witness_task]
          mov  rsi, 99
          mov  rdx, 5
          call sys_dup2_body
          mov  rcx, 0xFFFFFFFFFFFFFFF7
          cmp  rax, rcx
          jne  sys_dup2_witness_fail

          // --- Sub-test F prep: sample fd_table[4]'s vnode_idx + refcount ---
          lea  rdi, [rip + _sys_dup2_witness_task]
          mov  rsi, 4
          call fd_get
          and  rax, 0xFFFF
          mov  r12, rax                               // r12 = root_idx
          mov  rdi, rax
          call vnode_slot
          xor  rcx, rcx
          mov_w rcx, [rax + 4]
          mov  r13, rcx                               // r13 = R_root_before

          // --- Sub-test F: sys_dup2(w, 3, 4) → 4 ---
          lea  rdi, [rip + _sys_dup2_witness_task]
          mov  rsi, 3
          mov  rdx, 4
          call sys_dup2_body
          cmp  rax, 4
          jne  sys_dup2_witness_fail

          // F.1: fd_table[4] == fd_table[3]
          lea  rdi, [rip + _sys_dup2_witness_task]
          mov  rsi, 3
          call fd_get
          mov  r14, rax
          lea  rdi, [rip + _sys_dup2_witness_task]
          mov  rsi, 4
          call fd_get
          cmp  rax, r14
          jne  sys_dup2_witness_fail

          // F.2: root_idx refcount decreased by 1
          mov  rdi, r12
          call vnode_slot
          xor  rcx, rcx
          mov_w rcx, [rax + 4]
          inc  rcx
          cmp  rcx, r13
          jne  sys_dup2_witness_fail

          // F.3: x_idx refcount == 3
          lea  rdi, [rip + _sys_dup2_witness_task]
          mov  rsi, 3
          call fd_get
          and  rax, 0xFFFF
          mov  rdi, rax
          call vnode_slot
          xor  rcx, rcx
          mov_w rcx, [rax + 4]
          cmp  rcx, 3
          jne  sys_dup2_witness_fail

          // --- All green ---
          mov rdi, 3;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + sys_dup2_ok_msg];
          call klog_s1;
          jmp  sys_dup2_witness_done

      sys_dup2_witness_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + sys_dup2_fail_msg];
          call klog_s1;

      sys_dup2_witness_done:

      // ============================================================
      // R16-M3-006 (#592): fd_inherit witness — preamble + fork + 3 sub-tests
      // ============================================================
      fd_inherit_witness:
          // --- Preamble: wire root, tmp, x; reset x refcount ---
          // #665 Phase 5: route backend→vnode-pool binding through
          // vnode_cache_or_alloc (see sys_dup2_witness preamble for rationale).
          // r15 must hold x's VNODE-POOL idx post-preamble (sub-test B checks
          // refcount via vnode_slot(r15)).
          call mount_root_vnode
          mov  r14, rax                               // r14 = root_vnode_pool_idx (parent for /tmp)
          mov  rdi, rax
          call vnode_slot
          lea  rcx, [rip + _tmpfs_vops]
          mov  [rax + 24], rcx
          mov  rcx, 1                                 // TMPFS_INODE_IDX_ROOT
          mov  [rax + 32], rcx

          mov  rdi, 1
          lea  rsi, [rip + witness_name_tmp]
          call tmpfs_lookup
          cmp  rax, 0
          je   fd_inherit_witness_fail
          mov  r12, rax                               // r12 = tmp_backend_idx

          // Reserve /tmp's vnode-pool slot via vnode_cache_or_alloc.
          mov  rdi, r14                               // parent = root_vnode_pool_idx
          mov  rsi, r12                               // backend = tmp_backend_idx
          lea  rdx, [rip + _tmpfs_vops]               // ops = _tmpfs_vops
          call vnode_cache_or_alloc
          cmp  rax, 0xFFFF
          je   fd_inherit_witness_fail
          mov  r13, rax                               // r13 = tmp_vnode_pool_idx (parent for /tmp/x)

          mov  rdi, r12
          lea  rsi, [rip + witness_name_any]
          mov  rdx, 1
          call tmpfs_unlink
          cmp  rax, 0
          jne  fd_inherit_witness_fail

          mov  rdi, r12
          lea  rsi, [rip + witness_name_any]
          mov  rdx, 1
          mov  rcx, 1                                 // VNODE_TYPE_REG
          call tmpfs_create
          cmp  rax, 0
          je   fd_inherit_witness_fail
          cmp  rax, 0xFFFF
          je   fd_inherit_witness_fail
          mov  r15, rax                               // r15 = fresh x_backend_idx

          // Reserve /tmp/x's vnode-pool slot via vnode_cache_or_alloc.
          mov  rdi, r13                               // parent = tmp_vnode_pool_idx
          mov  rsi, r15                               // backend = x_backend_idx
          lea  rdx, [rip + _tmpfs_vops]               // ops = _tmpfs_vops
          call vnode_cache_or_alloc
          cmp  rax, 0xFFFF
          je   fd_inherit_witness_fail
          mov  r15, rax                               // r15 = x_vnode_pool_idx (was x_backend_idx)

          // Reset x's vnode-pool slot refcount to 0 (state normalization)
          mov  rdi, r15
          call vnode_slot
          xor  rcx, rcx
          mov_w [rax + 4], rcx

          // --- task_new(NULL) → parent ---
          xor  rdi, rdi
          call task_new
          cmp  rax, 0
          je   fd_inherit_witness_fail
          mov  r14, rax                               // r14 = parent slab

          // --- sys_open_body(parent, "/tmp/x", 0, 0) → fd = 3 ---
          mov  rdi, r14
          lea  rsi, [rip + witness_path_tmp_x]
          xor  rdx, rdx
          xor  rcx, rcx
          call sys_open_body
          cmp  rax, 3
          jne  fd_inherit_witness_fail

          // --- Baseline sanity: x_idx.refcount == 1 pre-fork ---
          mov  rdi, r15
          call vnode_slot
          xor  rcx, rcx
          mov_w rcx, [rax + 4]
          cmp  rcx, 1
          jne  fd_inherit_witness_fail

          // --- Act: sys_fork_body(parent) → child_pid, rdx=0 ---
          mov  rdi, r14
          call sys_fork_body
          cmp  rax, 2                                 // child_pid >= 2
          jb   fd_inherit_witness_fail
          cmp  rdx, 0
          jne  fd_inherit_witness_fail
          mov  r12d, eax                              // r12 = child_pid (zero-ext)

          // --- Recover child slab via _pid_table[child_pid] ---
          lea  rax, [rip + _pid_table]
          mov  r13, [rax + r12*8]                     // r13 = child slab
          cmp  r13, 0
          je   fd_inherit_witness_fail

          // --- Sub-test A: parent.fd[3] == child.fd[3] ---
          mov  rax, [r14 + 24 + 168]                  // parent.fd[3]
          mov  rcx, [r13 + 24 + 168]                  // child.fd[3]
          cmp  rax, rcx
          jne  fd_inherit_witness_fail

          // --- Sub-test B: x_idx.refcount == 2 ---
          mov  rdi, r15                               // r15 = x_idx (saved from preamble)
          call vnode_slot
          xor  rcx, rcx
          mov_w rcx, [rax + 4]
          cmp  rcx, 2
          jne  fd_inherit_witness_fail

          // --- Sub-test C: child.fd[0/1/2] all zero ---
          mov  rax, [r13 + 0 + 168]
          cmp  rax, 0
          jne  fd_inherit_witness_fail
          mov  rax, [r13 + 8 + 168]
          cmp  rax, 0
          jne  fd_inherit_witness_fail
          mov  rax, [r13 + 16 + 168]
          cmp  rax, 0
          jne  fd_inherit_witness_fail

          // --- All green ---
          mov rdi, 3;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + fd_inherit_ok_msg];
          call klog_s1;
          jmp  fd_inherit_witness_done

      fd_inherit_witness_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + fd_inherit_fail_msg];
          call klog_s1;

      fd_inherit_witness_done:

      // ============================================================
      // R16-M3-007 (#593): fd_cloexec witness — preamble + execve + 3 sub-tests
      // ============================================================
      fd_cloexec_witness:
          // --- Preamble: wire root, tmp, x; reset x refcount; task_new; open fd=3;
          //               mark CLOEXEC; open fd=4 ---
          // #665 Phase 5: route backend→vnode-pool binding through
          // vnode_cache_or_alloc (see sys_dup2_witness preamble for rationale).
          // r15 must hold x's VNODE-POOL idx post-preamble (baseline + sub-test C
          // check refcount via vnode_slot(r15)).
          call mount_root_vnode
          mov  r14, rax                               // r14 = root_vnode_pool_idx (parent for /tmp)
          mov  rdi, rax
          call vnode_slot
          lea  rcx, [rip + _tmpfs_vops]
          mov  [rax + 24], rcx
          mov  rcx, 1                                 // TMPFS_INODE_IDX_ROOT
          mov  [rax + 32], rcx

          mov  rdi, 1
          lea  rsi, [rip + witness_name_tmp]
          call tmpfs_lookup
          cmp  rax, 0
          je   fd_cloexec_witness_fail
          mov  r12, rax                               // r12 = tmp_backend_idx

          // Reserve /tmp's vnode-pool slot via vnode_cache_or_alloc.
          mov  rdi, r14                               // parent = root_vnode_pool_idx
          mov  rsi, r12                               // backend = tmp_backend_idx
          lea  rdx, [rip + _tmpfs_vops]               // ops = _tmpfs_vops
          call vnode_cache_or_alloc
          cmp  rax, 0xFFFF
          je   fd_cloexec_witness_fail
          mov  r13, rax                               // r13 = tmp_vnode_pool_idx (parent for /tmp/x)

          mov  rdi, r12
          lea  rsi, [rip + witness_name_any]
          mov  rdx, 1
          call tmpfs_unlink
          cmp  rax, 0
          jne  fd_cloexec_witness_fail

          mov  rdi, r12
          lea  rsi, [rip + witness_name_any]
          mov  rdx, 1
          mov  rcx, 1                                 // VNODE_TYPE_REG
          call tmpfs_create
          cmp  rax, 0
          je   fd_cloexec_witness_fail
          cmp  rax, 0xFFFF
          je   fd_cloexec_witness_fail
          mov  r15, rax                               // r15 = fresh x_backend_idx

          // Reserve /tmp/x's vnode-pool slot via vnode_cache_or_alloc.
          mov  rdi, r13                               // parent = tmp_vnode_pool_idx
          mov  rsi, r15                               // backend = x_backend_idx
          lea  rdx, [rip + _tmpfs_vops]               // ops = _tmpfs_vops
          call vnode_cache_or_alloc
          cmp  rax, 0xFFFF
          je   fd_cloexec_witness_fail
          mov  r15, rax                               // r15 = x_vnode_pool_idx (was x_backend_idx)

          // Reset x's vnode-pool slot refcount to 0 (state normalization)
          mov  rdi, r15
          call vnode_slot
          xor  rcx, rcx
          mov_w [rax + 4], rcx

          // --- task_new(NULL) → parent ---
          xor  rdi, rdi
          call task_new
          cmp  rax, 0
          je   fd_cloexec_witness_fail
          mov  r14, rax                               // r14 = parent slab

          // --- sys_open_body(parent, "/tmp/x", 0, 0) → fd = 3 ---
          mov  rdi, r14
          lea  rsi, [rip + witness_path_tmp_x]
          xor  rdx, rdx
          xor  rcx, rcx
          call sys_open_body
          cmp  rax, 3
          jne  fd_cloexec_witness_fail

          // --- Verify fd[3] was actually populated ---
          mov  rax, [r14 + 24 + 168]                  // parent.fd[3]
          cmp  rax, 0
          je   fd_cloexec_witness_fail                // fd[3] should not be empty!

          // --- Set bit 63 of parent.fd_table[3] (CLOEXEC marker) ---
          mov  rcx, 0x8000000000000000                // CLOEXEC_MASK (bit 63)
          or   rax, rcx
          mov  [r14 + 24 + 168], rax

          // --- sys_open_body(parent, "/tmp/x", 0, 0) → fd = 4 (no CLOEXEC) ---
          mov  rdi, r14
          lea  rsi, [rip + witness_path_tmp_x]
          xor  rdx, rdx
          xor  rcx, rcx
          call sys_open_body
          cmp  rax, 4
          jne  fd_cloexec_witness_fail

          // --- Verify fd[4] was actually populated ---
          mov  rax, [r14 + 32 + 168]                  // parent.fd[4]
          cmp  rax, 0
          je   fd_cloexec_witness_fail                // fd[4] should not be empty!

          // --- Baseline sanity: x_idx.refcount == 2 pre-execve ---
          mov  rdi, r15
          call vnode_slot
          xor  rcx, rcx
          mov_w rcx, [rax + 4]
          cmp  rcx, 2
          jne  fd_cloexec_fail_setup_label

          // --- Act: sys_execve_body(parent, _shell_bin_start, image_len) ---
          // r14 = parent task (arg 1), r15 = x_idx (preserved as callee-save)
          mov  rdi, r14                               // arg 1: parent task
          lea  rsi, [rip + _shell_bin_start]         // arg 2: image_ptr
          lea  rax, [rip + _shell_bin_end]
          sub  rax, rsi
          mov  rdx, rax                               // arg 3: image_len
          call sys_execve_body
          cmp  rax, 0                                 // require ELF_OK
          jne  fd_cloexec_fail_execve_label

          // --- Sub-test A: parent.fd_table[3] == 0 ---
          mov  rax, [r14 + 24 + 168]
          cmp  rax, 0
          jne  fd_cloexec_fail_sub_a_label

          // --- Sub-test B: parent.fd_table[4] != 0 ---
          mov  rax, [r14 + 32 + 168]
          cmp  rax, 0
          je   fd_cloexec_fail_sub_b_label

          // --- Sub-test C: x_idx.refcount == 1 ---
          mov  rdi, r15
          call vnode_slot
          xor  rcx, rcx
          mov_w rcx, [rax + 4]
          cmp  rcx, 1
          jne  fd_cloexec_fail_sub_c_label

          // --- All green ---
          mov rdi, 3;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + fd_cloexec_ok_msg];
          call klog_s1;
          jmp  fd_cloexec_witness_done

      fd_cloexec_fail_setup_label:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + fd_cloexec_fail_setup];
          call klog_s1;
          jmp  fd_cloexec_witness_done

      fd_cloexec_fail_execve_label:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + fd_cloexec_fail_execve];
          call klog_s1;
          jmp  fd_cloexec_witness_done

      fd_cloexec_fail_sub_a_label:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + fd_cloexec_fail_sub_a];
          call klog_s1;
          jmp  fd_cloexec_witness_done

      fd_cloexec_fail_sub_b_label:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + fd_cloexec_fail_sub_b];
          call klog_s1;
          jmp  fd_cloexec_witness_done

      fd_cloexec_fail_sub_c_label:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + fd_cloexec_fail_sub_c];
          call klog_s1;
          jmp  fd_cloexec_witness_done

      fd_cloexec_witness_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + fd_cloexec_fail_msg];
          call klog_s1;

      fd_cloexec_witness_done:

      // R16-M3-008 (#594): FD OK — milestone closure marker.
      mov rdi, 3;
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + fd_ok_msg];
      call klog_s1;


      pop rbp;
      ret
    }
  }

  // -------------------------------------------------------------------------
  // Witness storage
  //
  // These declarations came out of kernel_main.pdx alongside the code
  // above.  Each moved only because this module is the ONLY file in the
  // tree that references it in code; storage read by the exception
  // handlers, by tests, by boot_stub.S, or by a second witness module
  // has no single owner and stayed behind.
  //
  // Declaration ORDER is preserved from kernel_main.pdx.  Several of
  // these witnesses write past the end of one buffer into the next on
  // purpose (the deliberately-511-u64 payload patterns), so relative
  // placement inside a single object is not a formatting question.
  // -------------------------------------------------------------------------

  // R16-M3-001 (#587): sys_open witness task storage.
  // Static .bss blob (2224 bytes = 278 u64s) backing a dedicated
  // witness task_struct.  Not related to _idle_tcb or _task_pool —
  // same rationale as _fd_witness_task (#549 §4.1): witness storage
  // stays independent of the scheduler init sequence so R16.M3
  // witnesses run before idle_init / runq_init without ordering hazards.
  pub let mut _sys_open_witness_task : [u64; 278] = uninit @align(8)

  // R16-M3-002 (#588): sys_close witness task storage.
  // Static .bss blob (2224 bytes = 278 u64s) backing a dedicated
  // witness task_struct.  Not related to _idle_tcb or _task_pool —
  // same rationale as _sys_open_witness_task (#587 §4.1): witness
  // storage stays independent of the scheduler init sequence so
  // R16.M3 witnesses run before idle_init / runq_init without
  // ordering hazards.
  pub let mut _sys_close_witness_task : [u64; 278] = uninit @align(8)

  // R16-M3-003 (#589): sys_read witness task storage.
  // Static .bss blob (2224 bytes = 278 u64s) backing a dedicated
  // witness task_struct.  Same rationale as _sys_open_witness_task
  // (#587 §4.1) and _sys_close_witness_task (#588 §4.1): witness
  // storage stays independent of the scheduler init sequence so
  // R16.M3 witnesses run before idle_init / runq_init without
  // ordering hazards.
  pub let mut _sys_read_witness_task : [u64; 278] = uninit @align(8)

  // R16-M3-004 (#590): sys_write witness task storage.
  // Static .bss blob (2224 bytes = 278 u64s) backing a dedicated
  // witness task_struct. Same rationale as _sys_read_witness_task
  // (#589 §4.1) and _sys_open_witness_task (#587 §4.1): witness
  // storage stays independent of the scheduler init sequence so
  // R16.M3 witnesses run before idle_init / runq_init without
  // ordering hazards.
  pub let mut _sys_write_witness_task : [u64; 278] = uninit @align(8)

  // R16-M3-005 (#591): sys_dup2 witness task storage.
  // Static .bss blob (2224 bytes = 278 u64s) backing a dedicated
  // witness task_struct. Same rationale as _sys_write_witness_task
  // (#590 §4.1): witness storage stays independent of the scheduler
  // init sequence so R16.M3 witnesses run before idle_init / runq_init
  // without ordering hazards.
  pub let mut _sys_dup2_witness_task : [u64; 278] = uninit @align(8)
}
