// src/kernel/boot/witness/r87_ap_idt.pdx — R87.M1 (#1971)
// AP-side descriptor-table bring-up witness.
//
// Extracted as its own module per the boot/witness/*.pdx convention
// (r31_spawn.pdx, r69_smp_dispatch.pdx, etc.): called from
// kernel_main.pdx immediately after the existing AP-bring-up
// post-SIPI busy-wait (ap_tsc_busy_wait), before the IOAPIC/MSI-X
// witnesses.
//
// -----------------------------------------------------------------------------
// HONEST SCOPE — read this before trusting the number this witness prints
// -----------------------------------------------------------------------------
//
// This round's brief (#1971) asked for an 8-CPU-bound-task dispatch
// smoke verifying each AP's TASK_OFF_CPU_TICKS > 0 after ~500ms. That AC
// is not achievable on this tree yet, for the same class of reason
// boot/witness/r69_smp_dispatch.pdx's header already documents for its
// own honest-scope rewrite: real per-CPU task dispatch needs an AP to
// actually run the shared preempt-tail / sched_switch_r15 path, and
// that path still consumes BSP-only global scheduler state
// (Runqueue._current_tcb, Idle._idle_tcb, Runqueue._preempt_needed,
// Tss._tss's RSP0) with no per-CPU awareness — see
// design/kernel/ap-idt-strategy.md's "blocking finding" section. R87
// deliberately does not enable `sti` or the LAPIC timer on any AP (see
// core/smp/ap_tss.pdx's ap_desc_tables_install and ap_entry.pdx's own
// comment at that call site), so no AP ever takes a timer interrupt,
// so no AP ever accrues a cpu_ticks count — building a ticks histogram
// here would mean fabricating numbers, exactly the trap R69's header
// already called out.
//
// What CAN be proven honestly, and is what this witness proves: each
// of the 3 APs' own TSS descriptor in the shared kernel GDT
// (Gdt._gdt_new, slots 8/10/12 — byte offsets 64/80/96) shows the
// "busy" access byte (0xB9) rather than the "available" byte (0x89)
// tss_install/ap_tss_install both write BEFORE their own ltr. Per the
// SDM (Vol 3A §7.2.3), the CPU flips a TSS descriptor's type field
// from available (0x9) to busy (0xB) as a side effect of successfully
// executing `ltr` against it. Reading that bit back from BSP context,
// after the busy-wait has given every AP time to reach its own
// ap_desc_tables_install call, is a real, BSP-observable,
// serial-interleaving-immune proof that all 3 APs' lgdt -> ltr
// sequence actually ran and actually succeeded — the mechanical
// substance of #1965/#1966, reported honestly as a descriptor-table
// verification rather than a fabricated dispatch fingerprint. Each
// AP ALSO emits its own `ap idt ok -- cpu=<N>` fingerprint directly
// (core/smp/ap_tss.pdx), presence-only across the 3 APs, same
// discipline as CPU_ID_XX_HELLO / GS_OK_XX — this witness's rollup is
// the ordering-safe, single-line summary a golden can pin.
//
// A future round that migrates the scheduler globals to their
// already-reserved per-CPU Percpu CB slots (CB+16/+80/+48/+64 — see
// the design doc) can replace this descriptor-table check with a real
// per-CPU cpu_ticks histogram without touching #1965/#1966 at all —
// only this witness's body would change.

module R87ApIdt = structure {
  // ============================================================================
  // witness_r87_ap_idt() — top-level entry, called from kernel_main
  // ============================================================================
  pub let witness_r87_ap_idt : () -> () !{sysreg, mem} @{boot} = fn () -> unsafe {
    effects: { sysreg, mem },
    capabilities: { boot },
    justification: "R87.M1 (#1971): AP-side descriptor-table verification witness. Reads the access byte (bits 40-47 of the low qword) of each of the 3 per-AP TSS descriptors installed by core/smp/ap_tss.pdx's ap_tss_install into Gdt._gdt_new slots 8/10/12 (byte offsets 64/80/96 -- selectors 0x40/0x50/0x60 for cpu_idx 1/2/3 respectively). Per Intel SDM Vol 3A Table 7-1, a 64-bit TSS descriptor's type field is 0x9 (available) before ltr and 0xB (busy) after -- with the present+DPL0 bits ap_tss_install writes (access byte 0x89 pre-ltr), a successful ltr flips this to 0xB9. rbx accumulates cpus_ready (0..3): for each of the 3 slots, load the low qword, shr 40 + and 0xFF to isolate the access byte, cmp 0xB9, conditionally increment. Called from kernel_main.pdx after the existing ap_bring_up_all + ap_tsc_busy_wait (~333ms), which gives every AP time to reach its own ap_desc_tables_install call (a handful of memory-only instructions plus one ltr/lgdt/lidt each -- far under the busy-wait budget). Emits the `ap idt verify ok -- cpus_ready=<N>` rollup fingerprint via klog_s1_d1, but ONLY when cpus_ready > 0 — under the default -smp 1 matrix (no APs at all) cpus_ready is always 0 and the emit is skipped, keeping this marker's real-world occurrence count at zero across the 14 default modes (tools/verify-fingerprint-coverage.sh Section-B allowlist discipline); it fires only under the opt-in -smp>1 boot_r87_ap_idt mode. Register discipline: rbx (cpus_ready accumulator, one push, callee-save across nothing here since there are no nested calls until the final klog_s1_d1); rax/rcx caller-save scratch for each slot's load/shift/mask/compare. Entry rsp%16==8 (standard SysV call-site convention, matching every sibling witness in this directory); one push (rbx) lands rsp%16==0 for the trailing klog_s1_d1 call, matching klog_s1_d1's own expected caller-side parity (see ap_tss.pdx's ap_desc_tables_install for the identical parity argument). Effects {sysreg, mem}: mem for the _gdt_new reads, sysreg transitively via klog_s1_d1's own TSC read.",
    block: {
      push rbx;
      xor rbx, rbx;                     // rbx = cpus_ready count

      lea rax, [rip + _gdt_new];

      // AP #0 (cpu_idx 1): slot 8, byte offset 64.
      mov rcx, [rax + 64];
      shr rcx, 40;
      and rcx, 0xFF;
      cmp rcx, 0xB9;
      jne r87_ap_idt_check_1_done;
      add rbx, 1;
      r87_ap_idt_check_1_done:

      // AP #1 (cpu_idx 2): slot 10, byte offset 80.
      mov rcx, [rax + 80];
      shr rcx, 40;
      and rcx, 0xFF;
      cmp rcx, 0xB9;
      jne r87_ap_idt_check_2_done;
      add rbx, 1;
      r87_ap_idt_check_2_done:

      // AP #2 (cpu_idx 3): slot 12, byte offset 96.
      mov rcx, [rax + 96];
      shr rcx, 40;
      and rcx, 0xFF;
      cmp rcx, 0xB9;
      jne r87_ap_idt_check_3_done;
      add rbx, 1;
      r87_ap_idt_check_3_done:

      // Skip the fingerprint entirely when cpus_ready == 0 — the
      // default boot matrix runs -smp 1 (no APs at all), so this
      // witness would otherwise print an always-zero rollup on every
      // one of the 14 default-mode boots. Emitting only when at least
      // one AP actually ran ap_desc_tables_install keeps this marker's
      // real-world occurrence count at zero under the default matrix
      // (verifiable against a full default-matrix boot log), matching
      // tools/verify-fingerprint-coverage.sh's Section-B allowlist
      // discipline for markers that only fire under an opt-in -smp>1
      // mode (PAIDEIA_R87_AP_IDT=1 / boot_r87_ap_idt here).
      cmp rbx, 0;
      je r87_ap_idt_skip_emit;

      mov rdi, 3;                       // LEVEL_INFO
      lea rsi, [rip + SUBSYS_APIC];
      lea rdx, [rip + tag_ap_idt_verify_ok];
      lea rcx, [rip + k_cpus_ready];
      mov r8, rbx;
      call klog_s1_d1;

      r87_ap_idt_skip_emit:
      pop rbx;
      ret
    }
  }
}
