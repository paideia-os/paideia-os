// src/kernel/boot/witness/r96_mac_spoof_refuse.pdx -- R96.M1-002
// (paideia-os #2087)
//
// MAC-address spoofing structural-refuse witness. Constructs a
// stack-local "candidate spoof" source MAC that a hostile caller
// might wish to emit on the wire, invokes l2_tx_send with a
// legitimate destination + payload (noting the API has no ABI
// position for src_mac -- see design/networking/mac-spoof-policy.md
// §4), then reads the emitted frame back out of the L2 TX buffer
// pool at bytes [6..11] (Ethernet II header src_mac field per
// net/ethernet.pdx L13) and asserts the six bytes equal the six
// bytes at &_e1000e_devices[0]+24 (the burned-in MAC populated by
// e1000e_read_mac at driver probe).
//
// =============================================================================
// SECTION 0  WHAT THIS WITNESS PROVES
// =============================================================================
//
// The MAC-spoof-refuse property is structural: l2_tx_send has six
// arguments and none of them is src_mac. eth_build sources src_mac
// from _e1000e_devices+24 verbatim (l2_tx.pdx L255-256). The witness
// does not attempt to bypass this -- it cannot, because there is no
// ABI position through which a spoof would flow. What the witness
// proves is that the OBSERVABLE emitted frame carries the expected
// src_mac bytes, i.e. the policy is enforced end-to-end and not
// undone by some downstream rewrite. If a future refactor were to
// add a src_mac argument to l2_tx_send or introduce a rewrite in
// nic_dispatch_tx / a per-NIC arm, this witness surfaces the change
// at boot rather than at first hostile use.
//
// =============================================================================
// SECTION 1  WHY IT RUNS UNCONDITIONALLY
// =============================================================================
//
// The property holds under PAIDEIA_NIC=none exactly as under a real
// NIC. Under =none, e1000e_probe never runs, so _e1000e_devices+24
// stays zero. eth_build then stamps six zero bytes into the frame's
// src_mac field. The assertion "emitted src_mac == _e1000e_devices
// +24" evaluates as "0 == 0" -- still true, still the honest answer.
// No skip discipline is needed; the witness runs on every boot in
// every NIC mode. Under =virtio / =rtl8139 / =e1000e with a live
// probe, the burned-in MAC is non-zero and the assertion tests real
// bytes; the witness is meaningful in every mode.
//
// The nic_dispatch_tx call inside l2_tx_send returns NIC_ENOSYS
// today (per l2_tx.pdx header §"R91.M1-003 cutover") -- but the
// frame has already been built into the pool buffer by eth_build
// BEFORE that dispatch call, so the src_mac bytes are inspectable
// regardless of dispatch return.
//
// =============================================================================
// SECTION 2  BUFFER-INDEX RECOVERY
// =============================================================================
//
// l2_tx_send round-robins through _l2_tx_buffers[16] using
// _l2_tx_buf_next as the cursor. On entry it reads the cursor
// (r10 = idx), advances it (idx+1 & 15), and writes back. So AFTER
// the call, _l2_tx_buf_next holds (used_idx + 1) & 15 -- which
// means: pre-call cursor = used_idx. The witness stashes
// _l2_tx_buf_next before the call and uses that value as the
// used-buffer index. Buffer address is _l2_tx_buffers + idx*2048;
// the src_mac field is at buffer[6..11].
//
// =============================================================================
// SECTION 3  COMPARISON DISCIPLINE
// =============================================================================
//
// Two 8-byte loads + one mask each:
//   emitted_mac  = ([buf+6] as u64) & 0x0000FFFFFFFFFFFF
//                  (bytes 0..5 of the 8-byte word are the src_mac;
//                   bytes 6..7 are the ethertype from htons -- masked
//                   out)
//   expected_mac = ([_e1000e_devices+24] as u64) & 0x0000FFFFFFFFFFFF
//                  (the u64 MAC field carries only 48 meaningful bits;
//                   the high 16 are documented-reserved per kind_nic.
//                   pdx nic_mac_valid; masking is defence in depth)
// cmp; jne skip. Encoder-conservative: two mov [reg], mem loads, two
// mov r10, imm, two and, one cmp.
//
// =============================================================================
// SECTION 4  FINGERPRINT
// =============================================================================
//
// Success: "boot r96 mac spoof refuse ok --" via klog_s1(LEVEL_INFO=3,
// SUBSYS_BOOT, tag_boot_r96_mac_spoof_refuse_ok). Lowercase, no
// bracketed legacy suffix, no standalone uppercase OK token -- same
// posture as `boot r92 arp pending ok`; no golden pin or allowlist
// entry needed. Assertion failure falls through to the ret without
// emitting -- a missing OK line at the expected cascade position IS
// the failure signal, matching the r92_arp_pending posture.
//
// =============================================================================
// SECTION 5  ENCODER + LABEL DISCIPLINE
// =============================================================================
//
// One callee-save push (rbx) for the buffer index. sub rsp, 32 gives
// 32 bytes of scratch (only 22 bytes used: dst_mac 6 + payload 8 +
// spoof-candidate 6, laid out with 8-byte offset granularity). Entry
// rsp%16 == 8; 1 push (8B) -> %16 == 0; sub 32 -> %16 == 0 for nested
// l2_tx_send / klog_s1 calls. Frame prologue implicit. No mov_bzx / add reg,[mem]
// / cmp reg,[mem]. Labels prefixed r96mac_.

module R96MacSpoofRefuse = structure {

  // witness_r96_mac_spoof_refuse() -> ()
  pub let witness_r96_mac_spoof_refuse : () -> () !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R96.M1-002 (paideia-os #2087). MAC-spoof structural-refuse witness. Body: (1) 1-push callee-save (rbx) + sub rsp, 32 (32 B scratch, 22 B used). Entry rsp%16==8, push (8B) -> 16, sub 32 -> 48, %16==0 for nested calls. Scratch layout: [rsp+0..5]=dst_mac (broadcast FF:FF:FF:FF:FF:FF), [rsp+8..15]=payload (8 arbitrary bytes), [rsp+16..21]=spoof-candidate src_mac (DE:AD:BE:EF:CA:FE -- the caller cannot pass it to l2_tx_send, whose 6-argument signature has no src_mac position; the scratch is here to document what a hostile caller might have wished to emit had the API accepted one). (2) Build dst broadcast at [rsp+0..5] via 6 mov_b imm stores. (3) Build payload at [rsp+8..15] via 8 mov_b imm stores (values are arbitrary; 0xAA..0xA7). (4) Build spoof candidate at [rsp+16..21] via 6 mov_b imm stores (documentation only). (5) Snapshot _l2_tx_buf_next into rbx BEFORE the call -- l2_tx_send bumps the cursor to (idx+1)&15, so pre-call value is the used index. (6) Call l2_tx_send(bar0=0, tx_ring_pa=0, dst_mac=&scratch, ethertype=0x0800 IPv4, payload_pa=&scratch+8, payload_len=8). Return value ignored: the nic_dispatch_tx arm returns NIC_ENOSYS under PAIDEIA_NIC=none, but eth_build has already stamped the frame into the pool buffer regardless -- the src_mac bytes are inspectable post-call in every mode. (7) Compute buffer addr = &_l2_tx_buffers + rbx*2048; shl rbx,11 (2048=2^11) + lea gives r10 = buf_addr. (8) Load emitted 8 bytes at [buf+6] into r11; mask with 0x0000FFFFFFFFFFFF to isolate the 48-bit src_mac (bytes 6..7 of the 8-byte word are the ethertype from htons(0x0800) = 0x0008 in BE, masked out). (9) Load expected 8 bytes at [_e1000e_devices+24] into r10; mask with the same 0x0000FFFFFFFFFFFF (high 16 bits are documented-reserved per kind_nic.pdx nic_mac_valid; masking is defence-in-depth). (10) cmp r10, r11; jne r96mac_ret -- assertion failure silently skips emit (missing OK line is the failure signal, matches r92_arp_pending). (11) Emit klog_s1(LEVEL_INFO=3, SUBSYS_BOOT, tag_boot_r96_mac_spoof_refuse_ok). (12) Teardown. Effects/capabilities: {sysreg, mem} + {boot} match the sibling witness cascade shapes. Encoder-conservative: mov_b for byte stores, [reg+imm] addressing, mov r10, imm64 for the mask, cmp reg,reg only. Labels prefixed r96mac_.",
      block: {
        push rbx;
        sub rsp, 32;

        // (2) dst_mac = FF:FF:FF:FF:FF:FF (broadcast) at [rsp+0..5].
        mov rax, 0xFF;
        mov_b [rsp + 0], rax;
        mov_b [rsp + 1], rax;
        mov_b [rsp + 2], rax;
        mov_b [rsp + 3], rax;
        mov_b [rsp + 4], rax;
        mov_b [rsp + 5], rax;

        // (3) payload = 8 arbitrary bytes at [rsp+8..15].
        mov rax, 0xAA;
        mov_b [rsp + 8], rax;
        mov rax, 0xBB;
        mov_b [rsp + 9], rax;
        mov rax, 0xCC;
        mov_b [rsp + 10], rax;
        mov rax, 0xDD;
        mov_b [rsp + 11], rax;
        mov rax, 0xA4;
        mov_b [rsp + 12], rax;
        mov rax, 0xA5;
        mov_b [rsp + 13], rax;
        mov rax, 0xA6;
        mov_b [rsp + 14], rax;
        mov rax, 0xA7;
        mov_b [rsp + 15], rax;

        // (4) spoof-candidate src_mac = DE:AD:BE:EF:CA:FE at
        //     [rsp+16..21]. Documentation only -- the l2_tx_send API
        //     has no ABI position that would let a caller pass this
        //     scratch as source MAC.
        mov rax, 0xDE;
        mov_b [rsp + 16], rax;
        mov rax, 0xAD;
        mov_b [rsp + 17], rax;
        mov rax, 0xBE;
        mov_b [rsp + 18], rax;
        mov rax, 0xEF;
        mov_b [rsp + 19], rax;
        mov rax, 0xCA;
        mov_b [rsp + 20], rax;
        mov rax, 0xFE;
        mov_b [rsp + 21], rax;

        // (5) Snapshot _l2_tx_buf_next BEFORE the call -- l2_tx_send
        //     advances it to (idx+1)&15, so this value is the used
        //     index post-call.
        mov rbx, [rip + _l2_tx_buf_next];

        // (6) Call l2_tx_send. Return value not consulted -- the frame
        //     is already in the pool buffer regardless of dispatch
        //     outcome (see file header §1).
        xor rdi, rdi;                       // bar0 (ignored per L2 header)
        xor rsi, rsi;                       // tx_ring_pa (ignored)
        lea rdx, [rsp + 0];                 // dst_mac ptr
        mov rcx, 0x0800;                    // ethertype IPv4 (host order)
        lea r8, [rsp + 8];                  // payload_pa
        mov r9, 8;                          // payload_len
        call l2_tx_send;

        // (7) Compute buffer addr = &_l2_tx_buffers + rbx*2048.
        mov r10, rbx;
        shl r10, 11;                        // rbx * 2048
        lea r11, [rip + _l2_tx_buffers];
        add r10, r11;                       // r10 = buf_addr

        // (8) Load emitted 8 bytes at [buf+6]; mask off ethertype
        //     high 16 bits.
        mov r11, [r10 + 6];
        mov rax, 0x0000FFFFFFFFFFFF;
        and r11, rax;

        // (9) Load expected 8 bytes at [_e1000e_devices+24]; mask
        //     high 16 bits (defence in depth per kind_nic.pdx).
        lea r10, [rip + _e1000e_devices];
        add r10, 24;
        mov r10, [r10];
        and r10, rax;

        // (10) Assert equality.
        cmp r10, r11;
        jne r96mac_ret;

        // (11) Emit fingerprint.
        mov rdi, 3;                         // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_boot_r96_mac_spoof_refuse_ok];
        call klog_s1;

      r96mac_ret:
        add rsp, 32;
        pop rbx;
        ret
      }
    }
}
