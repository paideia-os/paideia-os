// src/kernel/boot/witness/r29_cascade.pdx — boot witness module
//
// Extracted verbatim from src/kernel/boot/kernel_main.pdx (which had grown
// to 24,315 lines in two functions).  R29.M7 witness block — the cascade-restart witness and the chaos harness.
//
// -----------------------------------------------------------------------------
// Why the body is copied and not rewritten
// -----------------------------------------------------------------------------
//
// The goldens for this tree assert an ORDERED SUBSEQUENCE of fingerprints
// across 14 boot modes, and a witness that silently stops running still
// leaves most of that subsequence intact.  The extraction therefore moves
// the instruction stream unchanged: the only bytes this module adds around
// it are the `push rbp` / `pop rbp` / `ret` below.
//
// -----------------------------------------------------------------------------
// The push is not decoration
// -----------------------------------------------------------------------------
//
// `boot_continue_after_ring3` runs its body at `rsp % 16 == 8` — it sits two `call` levels
// below `_start`, and paideia-as emits no frame prologue for an
// `unsafe`-bodied lambda (emit_visit_lambda.rs suppresses the prologue for
// Unsafe bodies, which is also why `no-frame` is a no-op there).  Several
// witnesses in this file reason explicitly about that parity — "3 pushes from %16==8
// yields (8+3*8)%16 == 0" — and a bare `call` into a bare body would enter
// at `%16 == 0` and invert every one of those arguments.  The single
// `push rbp` restores the inline parity exactly; the matching `pop rbp`
// keeps rbp's SysV guarantee for the caller.
//
// Sections in this module, in the order boot_continue_after_ring3 ran them:
//   * R29.M7-001/004/005 (#1044/#1047/#1048): cascade-restart witness.
//   * R29.M7-002/003 (#1045/#1046): the chaos harness.

module R29Cascade = structure {

  // witness_r29_cascade() — the R29.M7 witness block — the cascade-restart witness and the chaos harness.
  //
  // Effect and capability rows are the ones the enclosing
  // `boot_continue_after_ring3` declares.  They are not widened here: this
  // is the same instruction stream under a new symbol, so the authority it
  // needs is by construction the authority it already had.
  pub let witness_r29_cascade : () -> () !{sysreg} @{} = fn () -> unsafe {
    effects: { sysreg },
    capabilities: { boot },
    justification: "Boot witness block lifted verbatim out of kernel_main.pdx's boot_continue_after_ring3 during the r29_cascade extraction. Body bytes are unchanged from the inline form; the only additions are the entry `push rbp` and the exit `pop rbp; ret`. The push is load-bearing rather than cosmetic: boot_continue_after_ring3 executes its body at rsp%16 == 8 (two `call` levels below _start, with no frame prologue emitted for unsafe-bodied lambdas), and the witnesses inside this module compute their own nested-call alignment from that parity. Entering through a `call` without the compensating push would present rsp%16 == 0 to the body and silently invert every such argument — the failure mode of paideia-os #1192, #1195 and #1584. Effects and capabilities are copied unchanged from the enclosing function for the same reason: no authority is added, so none needs justifying beyond what boot_continue_after_ring3 already justified.",
    block: {
      push rbp;

      // ============================================================
      // R29.M7-001/004/005 (#1044/#1047/#1048): cascade-restart witness.
      //
      // Closes the R29.M7 restart MECHANISM (the chaos harness #1045 and
      // the post-restart accounting #1046 are written against it next).
      // Design: design/drivers/cascade-restart.md.
      //
      // Placement — LAST witness before ring-3 entry, and deliberately
      // so. Every other R29 witness is table-level and runs in the
      // pre-scheduler block; this one is the only one that needs a live
      // scheduler, because proving that a client blocked on a dead
      // driver's endpoint is WOKEN (rather than left hanging) means
      // driving sched_wake and observing the runqueue. That is only
      // meaningful after process_init has published _current_tcb and
      // enqueued init. It also means the witness must leave the runqueue
      // exactly as it found it — sub-test 30 dequeues the fake task
      // before ring-3 entry, mirroring sys_ipc_send_witness sub-test 15.
      //
      // The tree (slots 8..11, none of which any earlier witness uses —
      // the lifecycle / registry witnesses take 0, 1 and 5, and all
      // unregister; sub-test 0 pre-cleans anyway):
      //
      //          8  (root — stands in for a bus enumerator)
      //         / \
      //        9   11   <- 9 and 11 are SIBLINGS
      //        |
      //       10        <- 10 is 9's child
      //
      // Node 9 dies. The one-for-one strategy predicts an exact outcome,
      // and the witness asserts every part of it:
      //
      //   kill set    = {9, 10}     — the subtree, because 10's authority
      //                              was derived from 9's and is already
      //                              revoked at the capability layer.
      //   restart set = {9}         — 10 is unregistered, NOT restarted;
      //                              the restarted 9 re-enumerates it.
      //   untouched   = {8, 11}     — 11 is the load-bearing assertion.
      //                              One-for-all would have killed it;
      //                              it survives because siblings share
      //                              no writable object under R29's
      //                              capability partitioning.
      //
      // Sub-tests (stage index in _r29_restart_wit_stage; any failure
      // jumps to r29_restart_witness_fail with the stage):
      //
      //   0.  Pre-clean slots 8..11 (idempotent).
      //   1.  Register 8, 9, 10, 11.
      //   2.  Build the tree: 9->8, 10->9, 11->8.
      //   3.  Cycle refusal: set_parent(8, 10) -> ERR_CYCLE (10 is a
      //       descendant of 8, so the edge would close a loop).
      //   4.  Self-edge refusal: set_parent(9, 9) -> ERR_CYCLE.
      //   5.  subtree_mask(9) == 0x600 ({9,10}); mask(8) == 0xF00.
      //   6.  parent(9) == 8; parent(8) == PARENT_NONE (forest root).
      //   7.  Start all four: Init -> Running.
      //   8.  Bind one endpoint per node to 9, 10 and 11 at incarnation 0.
      //   9.  attach_ok(ep_child, 9, 0) == 1 — the live-binding baseline.
      //   10. Park a fake TCB (state WAITING) on 9's endpoint — a client
      //       blocked in recv.
      //   11. Snapshot the audit sequence.
      //   12. driver_restart_node(9) -> DRV_RESTART_OK.
      //   13. get_state(9) == Init — re-armed.
      //   14. incarnation(9) == 1 — a NEW life, not a resurrected one.
      //   15. restart_count(9) == 1 — charged against the budget.
      //   16. slot 10 no longer in_use — descendant unregistered.
      //   17. get_state(11) == Running — THE one-for-one assertion.
      //   18. get_state(8) == Running — the supervisor is untouched.
      //   19. parent(9) == 8 — the supervision edge survives a restart.
      //   20. ep_child is dead.
      //   21. ep_child's waiter slot is detached.
      //   22. fake TCB state == RUNNABLE — the blocked client was WOKEN.
      //   23. ep_gc (10's channel) is dead — the cascade reached it.
      //   24. ep_sib (11's channel) is ALIVE — the cascade did not.
      //   25. sys_ipc_recv_body on the dead endpoint returns -ECONNRESET
      //       AND RETURNS AT ALL. Without the ChannelDead gate this call
      //       would find the endpoint empty and enter sched_block with no
      //       wake source remaining — i.e. the boot would hang here. A
      //       returning call IS the no-hang proof.
      //   26. sys_ipc_send_body likewise.
      //   27. Stale-capability refusal: bind(ep_child, 9, 1) ->
      //       EP_BIND_ERR_DEAD. The restarted incarnation cannot inherit
      //       the channel its predecessor served.
      //   28. attach_ok(ep_child, 9, 1) == 0 — the incarnation clause
      //       refuses independently of the dead latch.
      //   29. A FRESH endpoint binds and attaches at incarnation 1, and
      //       has a different id — the reconnect path.
      //   30. runq_dequeue the fake task (runqueue hygiene before ring-3).
      //   31. Restarts 2..5 all succeed; restart_count reaches 5.
      //   32. Restart 6 -> DRV_RESTART_ESCALATED.
      //   33. perm_failed(9) == 1.
      //   34. get_state(9) == Stopped — escalation left the node in the
      //       FSM's own terminal state, reached through the whitelist.
      //   35. transition(9, Running) -> ERR_INVALID_TRANSITION — Stopped
      //       is still terminal; escalation invented no state.
      //   36. rearm_incarnation(9) -> REARM_PERM_FAILED — terminality is
      //       enforced at the STORE, not merely by the restart driver.
      //   37. driver_restart_node(9) -> ERR_PERM_FAILED — refused up
      //       front, so a crash loop pays nothing after escalation.
      //   38. Audit: the sequence advanced, and the ring's gap and seal
      //       chains are both intact across the whole storm.
      //   39. Cleanup: free the four endpoints, unregister 8, 9, 11.
      //
      // Register discipline: r12 is NOT touched. The four registers pushed
      // (rbx/r13/r14/r15) are an EVEN count, which preserves kernel_main's
      // ambient stack alignment for the nested calls. r13/r14 are used as
      // scratch here and restored per SysV callee-save discipline — which
      // is now the whole reason for the pushes. Until #1604 they also
      // carried init's entry_rip / initial_rsp to the ring-3 entry below,
      // an unchecked cross-module convention; that handoff is in .bss.
      //   rbx = driver slot 9 (the node that dies)
      //   r13 = ep_child (endpoint bound to 9)
      //   r14 = ep_sib   (endpoint bound to 11)
      //   r15 = scratch / row PA / restart loop counter
      // ep_gc, the fresh endpoint id and the audit snapshot live in .bss.
      // ============================================================
      r29_cascade_restart_witness:
          push rbx;
          push r13;
          push r14;
          push r15;

          mov rbx, 9;                              // the node that dies

          // -- Sub-test 0: idempotent pre-clean of slots 8..11.
          xor rax, rax;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          mov rdi, 8;
          call driver_table_unregister;
          mov rdi, 9;
          call driver_table_unregister;
          mov rdi, 10;
          call driver_table_unregister;
          mov rdi, 11;
          call driver_table_unregister;

          // -- Sub-test 1: register the four nodes.
          mov rax, 1;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          mov rdi, 8;
          mov rsi, 800;
          lea rdx, [rip + r29_restart_wit_name];
          xor rcx, rcx;
          call driver_table_register;
          cmp rax, 0;
          jne r29_restart_witness_fail;

          mov rdi, 9;
          mov rsi, 900;
          lea rdx, [rip + r29_restart_wit_name];
          xor rcx, rcx;
          call driver_table_register;
          cmp rax, 0;
          jne r29_restart_witness_fail;

          mov rdi, 10;
          mov rsi, 1000;
          lea rdx, [rip + r29_restart_wit_name];
          xor rcx, rcx;
          call driver_table_register;
          cmp rax, 0;
          jne r29_restart_witness_fail;

          mov rdi, 11;
          mov rsi, 1100;
          lea rdx, [rip + r29_restart_wit_name];
          xor rcx, rcx;
          call driver_table_register;
          cmp rax, 0;
          jne r29_restart_witness_fail;

          // -- Sub-test 2: build the supervisor tree.
          mov rax, 2;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          mov rdi, 9;
          mov rsi, 8;
          call driver_sup_set_parent;
          cmp rax, 0;
          jne r29_restart_witness_fail;

          mov rdi, 10;
          mov rsi, 9;
          call driver_sup_set_parent;
          cmp rax, 0;
          jne r29_restart_witness_fail;

          mov rdi, 11;
          mov rsi, 8;
          call driver_sup_set_parent;
          cmp rax, 0;
          jne r29_restart_witness_fail;

          // -- Sub-test 3: an edge that would close a cycle is refused.
          //    8 -> 10 would loop, because 10 is already below 8.
          mov rax, 3;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          mov rdi, 8;
          mov rsi, 10;
          call driver_sup_set_parent;
          mov r15, 0xFFFFFFB7;                     // DRV_RESTART_ERR_CYCLE
          cmp rax, r15;
          jne r29_restart_witness_fail;

          // -- Sub-test 4: the degenerate cycle — a self-edge.
          mov rax, 4;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          mov rdi, 9;
          mov rsi, 9;
          call driver_sup_set_parent;
          mov r15, 0xFFFFFFB7;                     // DRV_RESTART_ERR_CYCLE
          cmp rax, r15;
          jne r29_restart_witness_fail;

          // -- Sub-test 5: subtree masks.
          mov rax, 5;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          mov rdi, 9;
          call driver_sup_subtree_mask;
          mov r15, 0x600;                          // {9, 10}
          cmp rax, r15;
          jne r29_restart_witness_fail;

          mov rdi, 8;
          call driver_sup_subtree_mask;
          mov r15, 0xF00;                          // {8, 9, 10, 11}
          cmp rax, r15;
          jne r29_restart_witness_fail;

          // -- Sub-test 6: parent decoding, including the forest root.
          mov rax, 6;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          mov rdi, 9;
          call driver_sup_parent;
          cmp rax, 8;
          jne r29_restart_witness_fail;

          mov rdi, 8;
          call driver_sup_parent;
          mov r15, 0xFFFFFFFFFFFFFFFF;             // DRV_RESTART_PARENT_NONE
          cmp rax, r15;
          jne r29_restart_witness_fail;

          // Detaching a node makes it a forest root and shrinks its old
          // supervisor's subtree — the inverse of sub-test 2, asserted
          // through the mask so the edge removal is observed by the same
          // walk the cascade will use rather than by reading back the
          // field we just wrote.
          mov rdi, 11;
          call driver_sup_clear_parent;

          mov rdi, 11;
          call driver_sup_parent;
          mov r15, 0xFFFFFFFFFFFFFFFF;             // DRV_RESTART_PARENT_NONE
          cmp rax, r15;
          jne r29_restart_witness_fail;

          mov rdi, 8;
          call driver_sup_subtree_mask;
          mov r15, 0x700;                          // {8, 9, 10} — 11 detached
          cmp rax, r15;
          jne r29_restart_witness_fail;

          // Re-attach for the rest of the witness.
          mov rdi, 11;
          mov rsi, 8;
          call driver_sup_set_parent;
          cmp rax, 0;
          jne r29_restart_witness_fail;

          mov rdi, 8;
          call driver_sup_subtree_mask;
          mov r15, 0xF00;                          // {8, 9, 10, 11} again
          cmp rax, r15;
          jne r29_restart_witness_fail;

          // -- Sub-test 7: start all four (Init -> Running).
          mov rax, 7;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          mov rdi, 8;
          mov rsi, 1;                              // DRIVER_STATE_RUNNING
          call driver_lifecycle_transition;
          cmp rax, 0;
          jne r29_restart_witness_fail;

          mov rdi, 9;
          mov rsi, 1;
          call driver_lifecycle_transition;
          cmp rax, 0;
          jne r29_restart_witness_fail;

          mov rdi, 10;
          mov rsi, 1;
          call driver_lifecycle_transition;
          cmp rax, 0;
          jne r29_restart_witness_fail;

          mov rdi, 11;
          mov rsi, 1;
          call driver_lifecycle_transition;
          cmp rax, 0;
          jne r29_restart_witness_fail;

          // -- Sub-test 8: one client channel per node, at incarnation 0.
          mov rax, 8;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          call endpoint_alloc;
          mov r15, 0xFFFFFFFFFFFFFFFF;             // ENDPOINT_ALLOC_NONE
          cmp rax, r15;
          je  r29_restart_witness_fail;
          mov r13, rax;                            // ep_child (driver 9)

          mov rdi, r13;
          mov rsi, 9;
          xor rdx, rdx;                            // incarnation 0
          call endpoint_bind_driver;
          cmp rax, 0;
          jne r29_restart_witness_fail;

          call endpoint_alloc;
          mov r15, 0xFFFFFFFFFFFFFFFF;
          cmp rax, r15;
          je  r29_restart_witness_fail;
          lea rcx, [rip + _r29_restart_wit_ep_gc];
          mov [rcx], rax;                          // ep_gc (driver 10)

          mov rdi, rax;
          mov rsi, 10;
          xor rdx, rdx;
          call endpoint_bind_driver;
          cmp rax, 0;
          jne r29_restart_witness_fail;

          call endpoint_alloc;
          mov r15, 0xFFFFFFFFFFFFFFFF;
          cmp rax, r15;
          je  r29_restart_witness_fail;
          mov r14, rax;                            // ep_sib (driver 11)

          mov rdi, r14;
          mov rsi, 11;
          xor rdx, rdx;
          call endpoint_bind_driver;
          cmp rax, 0;
          jne r29_restart_witness_fail;

          // -- Sub-test 9: the live-binding baseline.
          mov rax, 9;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          mov rdi, r13;
          mov rsi, 9;
          xor rdx, rdx;
          call endpoint_attach_ok;
          cmp rax, 1;
          jne r29_restart_witness_fail;

          // -- Sub-test 10: park a blocked client on 9's endpoint.
          //    Pre-flip the fake TCB to STATE_WAITING (2) so sched_wake's
          //    #663 early-exit guard does not swallow the wake.
          mov rax, 10;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          mov rdi, r13;
          call endpoint_lookup;                    // rax = row PA
          cmp rax, 0;
          je  r29_restart_witness_fail;
          mov r15, rax;

          lea r10, [rip + _r29_restart_wit_fake_tcb];
          mov rcx, 2;                              // STATE_WAITING
          mov [r10 + 8], ecx;                      // fake_tcb.state (u32 @+8)
          mov [r15 + 32], r10;                     // ENDPOINT_OFF_WAITER_TCB

          // -- Sub-test 11: snapshot the audit sequence.
          mov rax, 11;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          call drv_audit_seq;
          lea rcx, [rip + _r29_restart_wit_seq];
          mov [rcx], rax;

          // -- Sub-test 12: node 9 dies. Restart it.
          mov rax, 12;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          mov rdi, rbx;                            // slot 9
          call driver_restart_node;
          cmp rax, 0;                              // DRV_RESTART_OK
          jne r29_restart_witness_fail;

          // -- Sub-test 13: 9 is re-armed at Init.
          mov rax, 13;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          mov rdi, rbx;
          call driver_lifecycle_get_state;
          cmp rax, 0;                              // DRIVER_STATE_INIT
          jne r29_restart_witness_fail;

          // -- Sub-test 14: it is a NEW life, not a resurrected one.
          mov rax, 14;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          mov rdi, rbx;
          call driver_sup_incarnation;
          cmp rax, 1;
          jne r29_restart_witness_fail;

          // -- Sub-test 15: charged against the budget.
          mov rax, 15;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          mov rdi, rbx;
          call driver_sup_restart_count;
          cmp rax, 1;
          jne r29_restart_witness_fail;

          // -- Sub-test 16: the descendant was unregistered, not restarted.
          mov rax, 16;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          mov rdi, 10;
          call driver_table_slot_in_use;
          cmp rax, 0;
          jne r29_restart_witness_fail;

          // -- Sub-test 17: THE one-for-one assertion — the sibling lives.
          //    One-for-all would have stopped 11 here.
          mov rax, 17;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          mov rdi, 11;
          call driver_lifecycle_get_state;
          cmp rax, 1;                              // still DRIVER_STATE_RUNNING
          jne r29_restart_witness_fail;

          // -- Sub-test 18: the supervisor above is untouched.
          mov rax, 18;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          mov rdi, 8;
          call driver_lifecycle_get_state;
          cmp rax, 1;                              // DRIVER_STATE_RUNNING
          jne r29_restart_witness_fail;

          // -- Sub-test 19: the supervision edge survived the restart.
          mov rax, 19;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          mov rdi, rbx;
          call driver_sup_parent;
          cmp rax, 8;
          jne r29_restart_witness_fail;

          // -- Sub-test 20: 9's channel is dead.
          mov rax, 20;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          mov rdi, r13;
          call endpoint_is_dead;
          cmp rax, 1;
          jne r29_restart_witness_fail;

          // -- Sub-test 21: the waiter slot was detached.
          mov rax, 21;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          mov rdi, r13;
          call endpoint_lookup;
          cmp rax, 0;
          je  r29_restart_witness_fail;
          mov r15, [rax + 32];                     // ENDPOINT_OFF_WAITER_TCB
          cmp r15, 0;
          jne r29_restart_witness_fail;

          // -- Sub-test 22: the blocked client was WOKEN, not left hanging.
          mov rax, 22;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          lea r10, [rip + _r29_restart_wit_fake_tcb];
          xor rax, rax;
          mov eax, [r10 + 8];                      // fake_tcb.state (u32)
          cmp rax, 1;                              // STATE_RUNNABLE
          jne r29_restart_witness_fail;

          // -- Sub-test 23: the cascade reached the descendant's channel.
          mov rax, 23;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          lea rcx, [rip + _r29_restart_wit_ep_gc];
          mov rdi, [rcx];
          call endpoint_is_dead;
          cmp rax, 1;
          jne r29_restart_witness_fail;

          // -- Sub-test 24: and did NOT reach the sibling's.
          mov rax, 24;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          mov rdi, r14;
          call endpoint_is_dead;
          cmp rax, 0;
          jne r29_restart_witness_fail;

          // -- Sub-test 25: recv on a dead endpoint returns ChannelDead.
          //    That this call RETURNS AT ALL is the no-hang proof: the
          //    endpoint is empty, so without the ChannelDead gate the
          //    body would install a waiter and sched_block with no wake
          //    source left in the system. The user-VA arguments are zero
          //    because the gate fires before any walker touches them.
          mov rax, 25;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          mov rdi, r13;
          xor rsi, rsi;
          xor rdx, rdx;
          xor rcx, rcx;
          call sys_ipc_recv_body;
          mov r15, 0xFFFFFFFFFFFFFF98;             // -ECONNRESET
          cmp rax, r15;
          jne r29_restart_witness_fail;

          // -- Sub-test 26: send to a dead endpoint likewise — a silent
          //    OK here would leave the client believing its request was
          //    accepted by a driver that no longer exists.
          mov rax, 26;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          mov rdi, r13;
          xor rsi, rsi;
          xor rdx, rdx;
          xor rcx, rcx;
          call sys_ipc_send_body;
          mov r15, 0xFFFFFFFFFFFFFF98;             // -ECONNRESET
          cmp rax, r15;
          jne r29_restart_witness_fail;

          // -- Sub-test 27: THE stale-capability refusal. The restarted
          //    incarnation cannot re-attach the channel its predecessor
          //    served — a dead endpoint is never revived.
          mov rax, 27;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          mov rdi, r13;
          mov rsi, 9;
          mov rdx, 1;                              // the NEW incarnation
          call endpoint_bind_driver;
          cmp rax, 3;                              // EP_BIND_ERR_DEAD
          jne r29_restart_witness_fail;

          // -- Sub-test 28: and the incarnation clause refuses on its
          //    own, independently of the dead latch.
          mov rax, 28;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          mov rdi, r13;
          mov rsi, 9;
          mov rdx, 1;
          call endpoint_attach_ok;
          cmp rax, 0;
          jne r29_restart_witness_fail;

          // -- Sub-test 29: the reconnect path — a FRESH endpoint, with a
          //    different id, binds and attaches at incarnation 1.
          mov rax, 29;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          call endpoint_alloc;
          mov r15, 0xFFFFFFFFFFFFFFFF;
          cmp rax, r15;
          je  r29_restart_witness_fail;
          cmp rax, r13;
          je  r29_restart_witness_fail;            // must NOT recycle the dead id
          lea rcx, [rip + _r29_restart_wit_ep_new];
          mov [rcx], rax;

          mov rdi, rax;
          mov rsi, 9;
          mov rdx, 1;
          call endpoint_bind_driver;
          cmp rax, 0;
          jne r29_restart_witness_fail;

          lea rcx, [rip + _r29_restart_wit_ep_new];
          mov rdi, [rcx];
          mov rsi, 9;
          mov rdx, 1;
          call endpoint_attach_ok;
          cmp rax, 1;
          jne r29_restart_witness_fail;

          // -- Sub-test 30: runqueue hygiene. The woken fake task must
          //    not be pickable at ring-3 entry.
          mov rax, 30;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          lea rdi, [rip + _r29_restart_wit_fake_tcb];
          call runq_dequeue;

          // -- Sub-test 31: restarts 2..5 stay inside the budget. Each
          //    walks Init -> Stopping -> Stopped -> (re-arm) Init, which
          //    also exercises the Init -> Stopping edge this landing
          //    added to DRIVER_LIFECYCLE_TABLE.
          mov rax, 31;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          xor r15, r15;

      r29_restart_burst:
          cmp r15, 4;
          jae r29_restart_burst_done;

          mov rdi, rbx;
          call driver_restart_node;
          cmp rax, 0;                              // DRV_RESTART_OK
          jne r29_restart_witness_fail;

          add r15, 1;
          jmp r29_restart_burst;

      r29_restart_burst_done:
          mov rdi, rbx;
          call driver_sup_restart_count;
          cmp rax, 5;                              // DRV_RESTART_MAX_INTENSITY
          jne r29_restart_witness_fail;

          // -- Sub-test 32: the sixth restart inside the window escalates.
          mov rax, 32;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          mov rdi, rbx;
          call driver_restart_node;
          mov r15, 0xFFFFFFB3;                     // DRV_RESTART_ESCALATED
          cmp rax, r15;
          jne r29_restart_witness_fail;

          // -- Sub-test 33: the escalation latch is set.
          mov rax, 33;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          mov rdi, rbx;
          call driver_sup_perm_failed;
          cmp rax, 1;
          jne r29_restart_witness_fail;

          // -- Sub-test 34: escalation invented no state — the node sits
          //    in the FSM's own terminal state, reached through the
          //    whitelist by the ordinary Stopping -> Stopped edge.
          mov rax, 34;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          mov rdi, rbx;
          call driver_lifecycle_get_state;
          cmp rax, 5;                              // DRIVER_STATE_STOPPED
          jne r29_restart_witness_fail;

          // -- Sub-test 35: and Stopped is still terminal.
          mov rax, 35;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          mov rdi, rbx;
          mov rsi, 1;                              // DRIVER_STATE_RUNNING
          call driver_lifecycle_transition;
          mov r15, 0xFFFFFF03;                     // ERR_INVALID_TRANSITION
          cmp rax, r15;
          jne r29_restart_witness_fail;

          // -- Sub-test 36: terminality is enforced at the STORE. Even a
          //    caller that bypasses the restart driver entirely cannot
          //    re-arm a permanently-failed descriptor.
          mov rax, 36;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          mov rdi, rbx;
          call driver_table_rearm_incarnation;
          mov r15, 0xFFFFFEF7;                     // REARM_PERM_FAILED
          cmp rax, r15;
          jne r29_restart_witness_fail;

          // -- Sub-test 37: and the restart driver refuses up front, so a
          //    crash loop pays nothing once escalation has landed.
          mov rax, 37;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          mov rdi, rbx;
          call driver_restart_node;
          mov r15, 0xFFFFFFB2;                     // DRV_RESTART_ERR_PERM_FAILED
          cmp rax, r15;
          jne r29_restart_witness_fail;

          // -- Sub-test 38: the audit ring recorded the whole storm, and
          //    its gap + seal chains survived it.
          mov rax, 38;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          call drv_audit_seq;
          lea rcx, [rip + _r29_restart_wit_seq];
          mov r15, [rcx];
          cmp rax, r15;
          jbe r29_restart_witness_fail;            // must have advanced

          call drv_audit_gap_check;
          cmp rax, 0;
          jne r29_restart_witness_fail;

          call drv_audit_seal_check;
          cmp rax, 0;
          jne r29_restart_witness_fail;

          // -- Sub-test 39: leave no state behind for ring-3.
          mov rax, 39;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          mov rdi, r13;
          call endpoint_free;
          mov rdi, r14;
          call endpoint_free;
          lea rcx, [rip + _r29_restart_wit_ep_gc];
          mov rdi, [rcx];
          call endpoint_free;
          lea rcx, [rip + _r29_restart_wit_ep_new];
          mov rdi, [rcx];
          call endpoint_free;

          mov rdi, 8;
          call driver_table_unregister;
          mov rdi, 9;
          call driver_table_unregister;
          mov rdi, 11;
          call driver_table_unregister;

          // Success marker: R29 CASCADE RESTART OK.
          mov rdi, 3;                              // LEVEL_INFO
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + r29_restart_ok_msg];
          call klog_s1;
          jmp r29_cascade_restart_witness_done;

      r29_restart_witness_fail:
          lea rax, [rip + _r29_restart_wit_stage];
          mov r8, [rax];
          mov rdi, 1;                              // LEVEL_ERROR
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + r29_restart_fail_msg];
          lea rcx, [rip + k_line];
          call klog_s1_d1;

      r29_cascade_restart_witness_done:
          pop r15;
          pop r14;
          pop r13;
          pop rbx;

      // ============================================================
      // R29.M7-002/003 (#1045/#1046): the chaos harness.
      //
      // Under test: src/kernel/core/driver/chaos.pdx, which is itself
      // an adversary against src/kernel/core/driver/restart.pdx and
      // src/kernel/core/driver/audit_channel.pdx.
      // Design: design/drivers/cascade-restart.md §Verification.
      //
      // The witness immediately above proves the cascade-restart
      // mechanism does the right thing ONCE, from a clean table, with
      // the driver at rest. This one attacks all three of those
      // qualifiers at the same time:
      //
      //   ONCE     -> 100 kills per victim position, 300 in total, each
      //               re-sampling its own baseline so the CYCLE INDEX at
      //               which accounting first drifts is reported rather
      //               than inferred from a single end-state.
      //   CLEAN    -> descriptor conservation and audit reconciliation
      //               are re-checked after every kill, not once at the
      //               end. A leak of one row per restart is invisible in
      //               a single-shot witness and fatal in a live system.
      //   AT REST  -> every kill lands with a client parked in
      //               STATE_WAITING inside the victim's endpoint waiter
      //               slot and an undrained published message on a
      //               second victim endpoint. Killing an idle driver
      //               tests the easy case; every hazard in §6 of the
      //               design is a mid-operation hazard.
      //
      // Why it runs HERE, after the mechanism witness and before ring-3:
      // it needs the same live scheduler (proving the parked client is
      // woken means driving sched_wake and observing the runqueue), and
      // it needs the mechanism witness to have already unregistered its
      // own slots 8..11. The harness works in slots 12..15, pre-cleans
      // them per role, and leaves the driver table, endpoint table,
      // capability table and runqueue exactly as it found them — the
      // per-cycle census in phase 14 is what enforces that, not a
      // promise in this comment.
      //
      // Register discipline: NO pushes here. drv_chaos_run preserves rbx
      // and r12..r15 itself, per SysV. Before #1604 that was the only
      // thing standing between the harness and a corrupted ring-3 entry,
      // since r12/r13/r14 carried init's iretq arguments straight through
      // this call; the entry now reads .bss, so a violation here would be
      // a plain SysV bug rather than a boot-breaking one.
      //
      // Cost: the full 300-kill run is pure table churn — no MMIO, no
      // serial output inside the loop, and deliberately no DMA domain
      // on the fixture drivers (attaching one would put
      // driver_lifecycle_teardown's klog audit line inside the inner
      // loop and turn 300 restarts into 300 serial writes). It is why
      // the FULL count runs in the default smoke matrix rather than
      // behind an opt-in gate.
      //
      // On failure the log carries role, cycle and phase as three
      // decimal fields; the returned code names the invariant
      // (DRV_CHAOS_ERR_* in chaos.pdx).
      // ============================================================
      r29_chaos_witness:
          mov rdi, 100;                            // DRV_CHAOS_CYCLES_FULL
          call drv_chaos_run;
          cmp rax, 0;                              // DRV_CHAOS_OK
          jne r29_chaos_witness_fail;

          mov rdi, 3;                              // LEVEL_INFO
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + r29_chaos_ok_msg];
          call klog_s1;
          jmp r29_chaos_witness_done;

      r29_chaos_witness_fail:
          lea rax, [rip + _drv_chaos_role];
          mov r8, [rax];
          mov rdi, 1;                              // LEVEL_ERROR
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + r29_chaos_fail_msg];
          lea rcx, [rip + r29_chaos_k_role];
          call klog_s1_d1;

          lea rax, [rip + _drv_chaos_cycle_idx];
          mov r8, [rax];
          mov rdi, 1;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + r29_chaos_fail_msg];
          lea rcx, [rip + r29_chaos_k_cycle];
          call klog_s1_d1;

          lea rax, [rip + _drv_chaos_stage];
          mov r8, [rax];
          mov rdi, 1;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + r29_chaos_fail_msg];
          lea rcx, [rip + r29_chaos_k_phase];
          call klog_s1_d1;

      r29_chaos_witness_done:


      pop rbp;
      ret
    }
  }
}
