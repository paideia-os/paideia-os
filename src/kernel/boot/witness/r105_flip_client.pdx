// src/kernel/boot/witness/r105_flip_client.pdx -- R105.M6-001
//
// End-to-end R105 boot witness: opens fd 0 = KIND_FRAMEBUFFER, does 3
// flips, expects OK. Matches the spec in design/graphics/r101-kernel-
// plan.md §R105.M6 -- "does a single user-space program open a fb,
// draw a frame, page-flip, wait, and repeat, on both QEMU backends and
// (gated) T14 hardware?"
//
// -----------------------------------------------------------------------------
// What this witness does
// -----------------------------------------------------------------------------
//
//   Stage 1: Skip if no Bochs device probed (PAIDEIA_VGA=none default,
//            or non-QEMU host). Emits skip line and returns.
//   Stage 2: sys_display_enumerate against a 4-record scratch buffer.
//            Assert count >= 1 and the first record's backend_kind == 1
//            (DPYB_KIND_BOCHS_STDVGA).
//   Stage 3: Mint synthetic KIND_DISPLAY_BACKEND cap at slot 150 with
//            R_DPYB_QUERY + target_ptr = record[0].row_id (from stage 2).
//   Stage 4: sys_framebuffer_create(cap=150, 1024, 768, BGRA8888)
//            -> fb_cap_slot in [0..255]. Assert < 256.
//   Stage 5: sys_framebuffer_map(fb_cap_slot, 0, 0) -> lfb_va.
//            Assert lfb_va != 0.
//   Stage 6: Mint synthetic KIND_DISPLAY_OUTPUT parent at slot 151, then
//            mint KIND_PAGE_FLIP at slot 152 with R_FLIP_INVOKE +
//            target_ptr = pgfl_row_id.
//   Stage 7: Loop 3 times: sys_page_flip(cap=152, target=0);
//            pgfl_deliver_vblank(row_id, PGFL_SRC_SIM_TICK);
//            sys_page_flip_wait(cap=152, timeout=100). Each call must
//            return 0.
//   Stage 8: Read pgfl_row_completed(row_id); assert == 3.
//   Stage 9: Mint synthetic KIND_IPC_ENDPOINT parent at slot 154, mint
//            KIND_HOTPLUG_CHANNEL at slot 153, subscribe via
//            sys_display_hotplug_subscribe, fire
//            hotplug_channel_deliver(HPCH_EV_CONNECT), assert row
//            delivered counter == 1.
//   Stage 10: Scrub cap slots 150..154; emit fingerprint.
//
//   Fingerprint (success): "boot r105 flip client ok -- flips=3"
//   Fingerprint (skip):    "boot r105 flip client skip"
//   Fingerprint (fail):    "boot r105 flip client fail line=<N>"
//
// -----------------------------------------------------------------------------
// Cap-table slots owned by this witness
// -----------------------------------------------------------------------------
//   150 -- KIND_DISPLAY_BACKEND (synth, mirrors dpyb row)
//   151 -- KIND_DISPLAY_OUTPUT (synth parent for KIND_PAGE_FLIP mint)
//   152 -- KIND_PAGE_FLIP
//   153 -- KIND_HOTPLUG_CHANNEL
//   154 -- KIND_IPC_ENDPOINT (synth parent for KIND_HOTPLUG_CHANNEL)
//   (SYSFB_STAGING_SLOT=132 used transiently by sys_framebuffer_create;
//    that syscall scrubs it back to (0,0,0) on return.)

module R105FlipClient = structure {

  pub let mut _r105wt_stage    : u64 = 0
  pub let mut _r105wt_enum_buf : [u64; 8] = uninit @align(64)
  pub let mut _r105wt_fb_cap   : u64 = 0
  pub let mut _r105wt_pgfl_row : u64 = 0
  pub let mut _r105wt_hpch_row : u64 = 0

  pub let tag_r105_ok   : [u8; 25] = "boot r105 flip client ok\0"
  pub let tag_r105_skip : [u8; 27] = "boot r105 flip client skip\0"
  pub let tag_r105_fail : [u8; 27] = "boot r105 flip client fail\0"

  pub let r105wt_k_flips : [u8; 6] = "flips\0"
  pub let r105wt_k_line  : [u8; 5] = "line\0"

  // ==========================================================================
  // Helper: mint a synthetic cap at (slot, kind, rights, target).
  // ==========================================================================
  pub let r105wt_mint_cap : (u64, u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (kind: u64) (rights: u64) (target: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R105.M6-001: mint one synthetic cap. Labels prefixed r105wt_mc_ (none needed, tail call).",
      block: {
        call cap_mint_write;
        ret
      }
    }

  // ==========================================================================
  // Helper: scrub cap slots 150..155.
  // ==========================================================================
  pub let r105wt_scrub_slots : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R105.M6-001: scrub the six cap slots this witness owns (150..155). Also revokes the transient KIND_DISPLAY_BACKEND / KIND_PAGE_FLIP / KIND_HOTPLUG_CHANNEL rows if the witness had begun creating them. Labels prefixed r105wt_ss_.",
      block: {
        push rbx;

        // Revoke row-owning caps first (idempotent: no-op if never minted).
        mov rax, [rip + _r105wt_pgfl_row];
        cmp rax, 0;
        je  r105wt_ss_no_pgfl;
        mov rdi, rax;
        call kind_page_flip_revoke_body;
      r105wt_ss_no_pgfl:

        mov rax, [rip + _r105wt_hpch_row];
        cmp rax, 0;
        je  r105wt_ss_no_hpch;
        mov rdi, rax;
        call kind_hotplug_channel_revoke_body;
      r105wt_ss_no_hpch:

        mov rbx, 150;
      r105wt_ss_loop:
        cmp rbx, 156;
        jae r105wt_ss_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp r105wt_ss_loop;
      r105wt_ss_done:
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Main witness driver.
  // ==========================================================================
  pub let witness_r105_flip_client : () -> () !{mem, sysreg} @{boot, cap, sched} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot, cap, sched},
      justification: "R105.M6-001: end-to-end R105 flip witness. Six callee-save pushes leave rsp%16==8+48=56, sub rsp,8 -> 64%16==0 for nested calls. Stage discipline recorded in _r105wt_stage on entry to each stage so the fail-line fingerprint carries a useful location without full source-line tracking. Skip funnel emits `boot r105 flip client skip` and returns cleanly when Bochs is absent. Fail funnel emits `boot r105 flip client fail line=<stage>`. Success funnel emits `boot r105 flip client ok -- flips=3`. Labels prefixed r105wt_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;

        // ---------- Stage 1: Bochs device present? ----------
        mov rax, 1;
        mov [rip + _r105wt_stage], rax;

        // Reuse the pattern from r101_stdvga_checkerboard: check
        // _bochs_stdvga_device_count > 0 (populated by
        // bochs_stdvga_probe on QEMU stdvga boots; zero on
        // PAIDEIA_VGA=none and real T14 UEFI).
        mov rax, [rip + _bochs_stdvga_device_count];
        cmp rax, 0;
        je  r105wt_skip;

        // ---------- Stage 2: mint fresh KIND_DISPLAY_BACKEND row ----------
        //
        // The R101 witness that ran just before us revoked its own
        // display_backend row on teardown; _dpyb_table is empty. Mint
        // a fresh row targeting the same Bochs stdvga device.
        mov rax, 2;
        mov [rip + _r105wt_stage], rax;

        // Synthetic KIND_DEVICE parent at slot 155 (KIND_DEVICE = 10,
        // RIGHT_MINT = 0x200).
        mov rdi, 155;
        mov rsi, 10;
        mov rdx, 0x200;
        mov rcx, 0x1010;
        call cap_mint_write;

        // kind_display_backend_mint_body(parent=155, R_DPYB_QUERY,
        //   BOCHS_STDVGA=1, bar_pa, mmio_base, provider=0).
        lea r10, [rip + _bochs_stdvga_devices];
        mov r11, [r10 + 8];              // bar0_lfb_pa
        mov r15, [r10 + 16];             // bar2_mmio_pa

        mov rdi, 155;
        mov rsi, 0x001;
        mov rdx, 1;                      // BOCHS_STDVGA
        mov rcx, r11;
        mov r8,  r15;
        xor r9,  r9;
        call kind_display_backend_mint_body;

        cmp rax, 4;                      // DPYB_MAX
        jae r105wt_fail;
        mov r12, rax;                    // r12 = backend row_id

        // Scrub slot 155 (transient parent).
        mov rdi, 155;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        // ---------- Stage 2b: sys_display_enumerate ----------
        //
        // Pass out_buf_cap=0 so the body scans + populates its own
        // scratch but skips the user-VA walker (a boot witness runs
        // in ring 0 with kernel VAs, which user_write_bytes_via_walk
        // refuses). We verify the returned count only; the walker
        // arm is exercised by ring-3 clients in later rounds.
        xor rdi, rdi;
        xor rsi, rsi;
        call sys_display_enumerate_body;

        cmp rax, 1;
        jb  r105wt_fail;

        // ---------- Stage 3: mint KIND_DISPLAY_BACKEND cap at slot 150 ----------
        mov rax, 3;
        mov [rip + _r105wt_stage], rax;

        mov rdi, 150;
        mov rsi, 0x1AE;                  // KIND_DISPLAY_BACKEND
        mov rdx, 0x001;                  // R_DPYB_QUERY
        mov rcx, r12;                    // target = backend row_id (fresh)
        call cap_mint_write;

        // ---------- Stage 4: sys_framebuffer_create ----------
        mov rax, 4;
        mov [rip + _r105wt_stage], rax;

        mov rdi, 150;                    // backend_cap_slot
        mov rsi, 0;                      // (placeholder overwritten)
        mov rdx, 1024;                   // width
        mov rcx, 768;                    // height
        mov r8,  1;                      // fmt = FB_FMT_BGRA8888
        call sys_framebuffer_create_body;

        cmp rax, 256;
        jae r105wt_fail;
        mov rbx, rax;                    // rbx = fb_cap_slot (survives)
        mov [rip + _r105wt_fb_cap], rbx;

        // ---------- Stage 5: sys_framebuffer_map ----------
        mov rax, 5;
        mov [rip + _r105wt_stage], rax;

        mov rdi, rbx;
        xor rsi, rsi;                    // user_va = 0 (reserved)
        xor rdx, rdx;                    // len = 0
        call sys_framebuffer_map_body;

        cmp rax, 0;
        je  r105wt_fail;
        mov r10, 0xFFFFFFFFFFFFFF00;     // any negative errno has high bits
        cmp rax, r10;
        jae r105wt_fail;

        // ---------- Stage 6: mint KIND_PAGE_FLIP ----------
        mov rax, 6;
        mov [rip + _r105wt_stage], rax;

        // Extract fb_row_id from cap_table[fb_cap_slot].target_ptr.
        // Slot arithmetic: slot*24 = slot*8 + slot*16.
        lea rax, [rip + cap_table];
        mov r10, rbx;
        shl r10, 3;
        mov r11, rbx;
        shl r11, 4;
        add r10, r11;
        add rax, r10;
        mov r10, [rax + 16];
        and r10, 0xFF;                   // r10 = fb_row_id
        mov rbp, r10;                    // rbp = fb_row_id (survives)

        // Synthetic KIND_DISPLAY_OUTPUT parent at slot 151 (unused
        // semantically by kind_page_flip_mint_body -- the body validates
        // only rights, output_slot is stored verbatim).
        mov rdi, 151;
        mov rsi, 0x170;                  // KIND_DISPLAY_OUTPUT
        mov rdx, 0x200;                  // RIGHT_MINT
        xor rcx, rcx;
        call cap_mint_write;

        // kind_page_flip_mint_body(output_slot=151, rights=R_FLIP_INVOKE,
        //   active_fb_slot=fb_row_id).
        mov rdi, 151;
        mov rsi, 0x001;
        mov rdx, rbp;
        call kind_page_flip_mint_body;

        cmp rax, 4;                      // PGFL_MAX
        jae r105wt_fail;
        mov r13, rax;                    // r13 = pgfl_row_id
        mov [rip + _r105wt_pgfl_row], r13;

        // Mint KIND_PAGE_FLIP cap at slot 152.
        mov rdi, 152;
        mov rsi, 0x1B0;                  // KIND_PAGE_FLIP
        mov rdx, 0x001;                  // R_FLIP_INVOKE
        mov rcx, r13;
        call cap_mint_write;

        // ---------- Stage 7: three flips ----------
        mov rax, 7;
        mov [rip + _r105wt_stage], rax;

        xor r14, r14;                    // flip counter
      r105wt_flip_loop:
        cmp r14, 3;
        jae r105wt_flip_done;

        // Submit.
        mov rdi, 152;                    // pgfl_cap_slot
        xor rsi, rsi;                    // target_fb_slot_hint = 0 (no-change)
        call sys_page_flip_body;
        cmp rax, 0;
        jne r105wt_fail;

        // Simulate vblank on this row.
        mov rdi, r13;
        mov rsi, 1;                      // PGFL_SRC_SIM_TICK
        call pgfl_deliver_vblank;
        // Return value is 0/1; either is acceptable as long as the
        // subsequent wait finds in_flight cleared. But if the deliver
        // reported 0 (no latch) something is off; treat 0 as fail.
        cmp rax, 0;
        je  r105wt_fail;

        // Wait.
        mov rdi, 152;
        mov rsi, 100;                    // timeout_ms = 100
        call sys_page_flip_wait_body;
        cmp rax, 0;
        jne r105wt_fail;

        add r14, 1;
        jmp r105wt_flip_loop;
      r105wt_flip_done:

        // ---------- Stage 8: assert seq_completed == 3 ----------
        mov rax, 8;
        mov [rip + _r105wt_stage], rax;

        mov rdi, r13;
        call pgfl_row_completed;
        cmp rax, 3;
        jne r105wt_fail;

        // ---------- Stage 9: hotplug ----------
        mov rax, 9;
        mov [rip + _r105wt_stage], rax;

        // Synthetic KIND_IPC_ENDPOINT parent at slot 154 (target
        // endpoint_id = 0 for the mint numeric gate; nothing derefs it).
        mov rdi, 154;
        mov rsi, 5;                      // KIND_IPC_ENDPOINT
        mov rdx, 0x200;                  // RIGHT_MINT
        xor rcx, rcx;
        call cap_mint_write;

        // kind_hotplug_channel_mint_body(endpoint_id=0, rights, mask, owner_pid).
        xor rdi, rdi;                    // endpoint_id = 0
        mov rsi, 0x003;                  // R_HPCH_SUBSCRIBE | R_HPCH_REVOKE
        mov rdx, 0x007;                  // HPCH_MASK_ALL
        xor rcx, rcx;                    // owner_pid = 0
        call kind_hotplug_channel_mint_body;

        cmp rax, 4;                      // HPCH_MAX
        jae r105wt_fail;
        mov r15, rax;                    // r15 = hpch_row_id
        mov [rip + _r105wt_hpch_row], r15;

        // Mint the cap at slot 153.
        mov rdi, 153;
        mov rsi, 0x1B1;                  // KIND_HOTPLUG_CHANNEL
        mov rdx, 0x001;                  // R_HPCH_SUBSCRIBE
        mov rcx, r15;
        call cap_mint_write;

        // sys_display_hotplug_subscribe(cap_slot=153).
        mov rdi, 153;
        call sys_display_hotplug_subscribe_body;
        cmp rax, 0;
        jne r105wt_fail;

        // Fire one CONNECT event; assert delivered counter == 1.
        mov rdi, 0x01;                   // HPCH_EV_CONNECT
        call hotplug_channel_deliver;
        cmp rax, 1;
        jne r105wt_fail;

        mov rdi, r15;
        call hpch_row_delivered;
        cmp rax, 1;
        jne r105wt_fail;

        // ---------- Stage 10: cleanup + fingerprint ----------
        call r105wt_scrub_slots;

        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_r105_ok];
        lea rcx, [rip + r105wt_k_flips];
        mov r8, 3;
        call klog_s1_d1;

        jmp r105wt_out;

      r105wt_skip:
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_r105_skip];
        call klog_s1;
        jmp r105wt_out;

      r105wt_fail:
        // Preserve stage number in r15 before scrub clobbers.
        mov r15, [rip + _r105wt_stage];
        call r105wt_scrub_slots;

        mov rdi, 1;                      // LEVEL_ERROR
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_r105_fail];
        lea rcx, [rip + r105wt_k_line];
        mov r8, r15;
        call klog_s1_d1;

      r105wt_out:
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }
}
