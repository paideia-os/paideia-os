// src/kernel/boot/witness/r33_audio_crash_isolation.pdx -- R33.M5-004 (#1160)
//
// The audio_supervisor crash isolation harness. Mirrors R30.M9-002's
// acpica-bubble harness (witness/r30_crash_isolation.pdx) against the
// R33.M5 audio_supervisor userspace image and its hard-coded endpoint
// id 5. Spawns the userspace binary, kills it via sys_exit_body, and
// asserts that the whole post-crash chain runs: capability sweep,
// driver row rebind, endpoint revive.
//
// Fingerprint: R33 AUDIO SUPERVISOR CRASH ISO OK
//
// See src/kernel/boot/witness/r30_crash_isolation.pdx for the full
// header argument -- what the harness does and does not prove, why
// runq_dequeue is load-bearing, why the push at entry, why endpoint
// binding runs between death-key bind and kill. The same reasoning
// applies here with three name substitutions:
//
//   acpi_supervisor -> audio_supervisor
//   endpoint id 3   -> endpoint id 5
//   driver slot 24  -> driver slot 25
//
// The audio_supervisor sidecar seeds TWO KIND_IPC_ENDPOINT slots
// (14 for the RPC endpoint at endpoint_id 5, 15 reserved at endpoint_id
// 6), so the sweep count is 2, matching the acpi_supervisor's.

module R33AudioCrashIsolation = structure {

  pub let witness_r33_audio_crash_isolation : () -> () !{mem, sysreg} @{cap, sched} = fn () -> unsafe {
    effects: { mem, sysreg },
    capabilities: { cap, sched, boot },
    justification: "R33.M5-004 (#1160): audio_supervisor crash isolation harness. Spawns the userspace audio_supervisor image (embedded at _audio_supervisor_bin_start), binds its hard-coded endpoint id 5 to driver slot 25, hard-crashes the task via sys_exit_body with a synthetic fault status (FAULT_KILL_STATUS_BASE | EXC_GP=13), then observes the whole post-crash chain end-to-end. Sequence mirrors r30_crash_isolation.pdx step-for-step with substitutions: endpoint 5 for endpoint 3, driver slot 25 for slot 24, audio-supervisor bin for acpi-supervisor bin. The sidecar seeds TWO KIND_IPC_ENDPOINT slots (14, 15) so the sweep count is 2, matching the acpi case. Asserts (a) row rebound to fresh key; (b) new_pid != old_pid; (c) driver_sup_incarnation == 1; (d) state == Init; (e) endpoint 5 revived (endpoint_is_dead == 0); (f) registry rewritten in place. Emits R33 AUDIO SUPERVISOR CRASH ISO OK on success; stage counter in .bss so a failure prints WHICH sub-test tripped via r33_audio_crash_fail_msg + line KV. Entry push rbp restores rsp %16 == 8 parity boot_continue_after_ring3 hands off, matching r30_crash_isolation.pdx's idiom.",
    block: {
      push rbp;

      // ---- Sub-test 0: allocate endpoint 5. ----
      xor rax, rax;
      lea rcx, [rip + _r33_audio_crash_stage];
      mov [rcx], rax;

      mov rdi, 5;                                  // svc.audio_routing endpoint id
      call endpoint_alloc_at;
      cmp rax, 0;
      jne r33_audio_crash_fail;

      // Also alloc endpoint 6 (the second sidecar entry needs a live row).
      mov rdi, 6;
      call endpoint_alloc_at;
      cmp rax, 0;
      jne r33_audio_crash_fail;

      // ---- Sub-test 1: register driver slot 25. ----
      mov rax, 1;
      lea rcx, [rip + _r33_audio_crash_stage];
      mov [rcx], rax;

      mov rdi, 25;
      mov rsi, 43;                                 // decorative pid
      lea rdx, [rip + _r33_audio_crash_driver_name];
      xor rcx, rcx;
      call driver_table_register;
      cmp rax, 0;
      jne r33_audio_crash_fail;

      // ---- Sub-test 2: drive the row Init -> Running. ----
      mov rax, 2;
      lea rcx, [rip + _r33_audio_crash_stage];
      mov [rcx], rax;

      mov rdi, 25;
      mov rsi, 1;                                  // DRIVER_STATE_RUNNING
      call driver_lifecycle_transition;
      cmp rax, 0;
      jne r33_audio_crash_fail;

      // ---- Sub-test 3: spawn the userspace audio_supervisor. ----
      mov rax, 3;
      lea rcx, [rip + _r33_audio_crash_stage];
      mov [rcx], rax;

      lea rdi, [rip + _audio_supervisor_bin_start];
      lea rax, [rip + _audio_supervisor_bin_end];
      sub rax, rdi;
      mov rsi, rax;
      call boot_spawn_user_task;
      cmp rax, 0;
      je r33_audio_crash_fail;
      lea rcx, [rip + _r33_audio_crash_task_slab];
      mov [rcx], rax;

      // ---- Sub-test 4: snapshot (old_pid, old_gen). ----
      mov rax, 4;
      lea rcx, [rip + _r33_audio_crash_stage];
      mov [rcx], rax;

      lea rax, [rip + _r33_audio_crash_task_slab];
      mov rax, [rax];
      xor rcx, rcx;
      mov ecx, [rax + 0];
      lea rax, [rip + _r33_audio_crash_old_pid];
      mov [rax], rcx;

      mov rdi, rcx;
      call pid_gen_read;
      cmp rax, 0;
      je  r33_audio_crash_fail;
      lea rcx, [rip + _r33_audio_crash_old_gen];
      mov [rcx], rax;

      mov rdi, 25;
      call driver_sup_incarnation;
      cmp rax, 0;
      jne r33_audio_crash_fail;

      // ---- Sub-test 5: bind endpoint 5 to driver slot 25. ----
      mov rax, 5;
      lea rcx, [rip + _r33_audio_crash_stage];
      mov [rcx], rax;

      mov rdi, 5;                                  // endpoint id
      mov rsi, 25;                                 // driver_slot
      xor rdx, rdx;                                // incarnation = 0
      call endpoint_bind_driver;
      cmp rax, 0;
      jne r33_audio_crash_fail;

      // ---- Sub-test 6: bind the row's death key to the supervisor pid. ----
      mov rax, 6;
      lea rcx, [rip + _r33_audio_crash_stage];
      mov [rcx], rax;

      lea rax, [rip + _r33_audio_crash_old_pid];
      mov rsi, [rax];
      mov rdi, 25;
      call driver_death_bind;
      cmp rax, 0;
      jne r33_audio_crash_fail;

      // ---- Sub-test 7: kill the supervisor with a fault-status. ----
      mov rax, 7;
      lea rcx, [rip + _r33_audio_crash_stage];
      mov [rcx], rax;

      lea rax, [rip + _r33_audio_crash_task_slab];
      mov rdi, [rax];
      mov rsi, 0x10D;                              // FAULT_KILL_STATUS_BASE | 13
      call sys_exit_body;

      // ---- Sub-test 8: runq_dequeue the freshly-ZOMBIE supervisor. ----
      mov rax, 8;
      lea rcx, [rip + _r33_audio_crash_stage];
      mov [rcx], rax;

      lea rax, [rip + _r33_audio_crash_task_slab];
      mov rdi, [rax];
      call runq_dequeue;

      // ---- Sub-test 9 (a): row rebound to non-zero death key. ----
      mov rax, 9;
      lea rcx, [rip + _r33_audio_crash_stage];
      mov [rcx], rax;

      mov rdi, 25;
      call driver_table_read_pid_gen;
      cmp rax, 0;
      je  r33_audio_crash_fail;

      mov rdi, 25;
      call driver_table_read_pid;
      cmp rax, 0;
      je  r33_audio_crash_fail;
      lea rcx, [rip + _r33_audio_crash_new_pid];
      mov [rcx], rax;

      // ---- Sub-test 10 (b): new pid != old pid. ----
      mov rax, 10;
      lea rcx, [rip + _r33_audio_crash_stage];
      mov [rcx], rax;

      lea rax, [rip + _r33_audio_crash_old_pid];
      mov rcx, [rax];
      lea rax, [rip + _r33_audio_crash_new_pid];
      mov rdx, [rax];
      cmp rdx, rcx;
      je  r33_audio_crash_fail;

      // ---- Sub-test 11 (c): driver_sup_incarnation(25) == 1. ----
      mov rax, 11;
      lea rcx, [rip + _r33_audio_crash_stage];
      mov [rcx], rax;

      mov rdi, 25;
      call driver_sup_incarnation;
      cmp rax, 1;
      jne r33_audio_crash_fail;

      // ---- Sub-test 12 (d): state == Init. ----
      mov rax, 12;
      lea rcx, [rip + _r33_audio_crash_stage];
      mov [rcx], rax;

      mov rdi, 25;
      call driver_lifecycle_get_state;
      cmp rax, 0;                                  // DRIVER_STATE_INIT
      jne r33_audio_crash_fail;

      // ---- Sub-test 13 (e): endpoint 5 revived. ----
      mov rax, 13;
      lea rcx, [rip + _r33_audio_crash_stage];
      mov [rcx], rax;

      mov rdi, 5;
      call endpoint_is_dead;
      cmp rax, 0;
      jne r33_audio_crash_fail;

      // ---- Sub-test 14 (f): registry rewritten in place. ----
      mov rax, 14;
      lea rcx, [rip + _r33_audio_crash_stage];
      mov [rcx], rax;

      lea rax, [rip + _r33_audio_crash_old_pid];
      mov rdi, [rax];
      lea rax, [rip + _r33_audio_crash_old_gen];
      mov rsi, [rax];
      call boot_spawn_is_service;
      cmp rax, 0;
      jne r33_audio_crash_fail;

      lea rax, [rip + _r33_audio_crash_new_pid];
      mov rdi, [rax];
      call pid_gen_read;
      cmp rax, 0;
      je  r33_audio_crash_fail;
      lea rcx, [rip + _r33_audio_crash_new_gen];
      mov [rcx], rax;

      lea rax, [rip + _r33_audio_crash_new_pid];
      mov rdi, [rax];
      lea rax, [rip + _r33_audio_crash_new_gen];
      mov rsi, [rax];
      call boot_spawn_is_service;
      cmp rax, 0;
      je  r33_audio_crash_fail;

      // ---- Success: emit the marker. ----
      mov rdi, 3;
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + r33_audio_crash_ok_msg];
      call klog_s1;
      jmp r33_audio_crash_done;

      r33_audio_crash_fail:
      lea rax, [rip + _r33_audio_crash_stage];
      mov r8, [rax];
      mov rdi, 1;
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + r33_audio_crash_fail_msg];
      lea rcx, [rip + k_line];
      call klog_s1_d1;

      r33_audio_crash_done:
      pop rbp;
      ret
    }
  }

  pub let _r33_audio_crash_driver_name : [u8; 16] = "audio-crash-wit\0"

  pub let mut _r33_audio_crash_stage     : u64 = 0
  pub let mut _r33_audio_crash_task_slab : u64 = 0
  pub let mut _r33_audio_crash_old_pid   : u64 = 0
  pub let mut _r33_audio_crash_old_gen   : u64 = 0
  pub let mut _r33_audio_crash_new_pid   : u64 = 0
  pub let mut _r33_audio_crash_new_gen   : u64 = 0

  // "R33 AUDIO SUPERVISOR CRASH ISO OK" = 33 chars + NUL = 34 bytes.
  // "R33 AUDIO SUPERVISOR CRASH ISO FAIL" = 35 chars + NUL = 36 bytes.
  pub let r33_audio_crash_ok_msg   : [u8; 34] = "R33 AUDIO SUPERVISOR CRASH ISO OK\0"
  pub let r33_audio_crash_fail_msg : [u8; 36] = "R33 AUDIO SUPERVISOR CRASH ISO FAIL\0"
}
