// src/kernel/boot/witness/r121_pipeline_edge_transport.pdx -- R121.M2 (paideia-os #2496)
//
// Boot-time witness for KIND_PIPELINE_EDGE transport end-to-end at M2:
// mints one PROD + one CONS endpoint, binds them into a ring pair, pumps
// 10,000 synthetic records through the SPSC ring measuring wall-clock
// latency via hpet_now_ns before/after, and asserts the backpressure
// arm fires when the ring saturates (17 sends after a clean bind should
// see the 17th refused with PET_EAGAIN).
//
// Emits per the plan:
//   Success rollup: `pipe intra ok records=10000 ns_avg=<n>` (klog_s1_d2,
//                   both decimal -- records is a natural count, ns_avg is
//                   a natural latency).
//   Backpressure OK subline: `boot pipe transport bp ok --` (klog_s1
//                   without KV -- the interesting witness data is captured
//                   in the outer rollup; the bp OK line simply anchors
//                   the backpressure check for the coverage sweep).
//   Failure funnel: `boot pipe transport fail line=<n>` (klog_s1_d1).
//
// Stages recorded in _r121pet_stage before each step so a failure
// fingerprint carries a distinguishing line number:
//   1  pipeline_edge_alloc (PROD) refused
//   2  pipeline_edge_alloc (CONS) refused
//   3  pipe_edge_bind_byrow refused
//   4  pipe_edge_send_byrow refused mid-pump (unexpected EBADF)
//   5  pipe_edge_recv_byrow refused mid-pump (unexpected EBADF)
//   6  pipe_edge_send_byrow returned unexpected non-EAGAIN mid-pump
//   7  pipe_edge_recv_byrow returned unexpected non-EAGAIN mid-pump
//   8  payload mismatch (received handle != sent handle)
//   9  backpressure did NOT fire on the 17th send (expected PET_EAGAIN)
//  10  backpressure test: recv did not drain cleanly
//
// M2 discipline:
//   * No cap-slot install (deferred to R121.M5); the witness exercises
//     the _byrow primitives directly.
//   * Uses synthetic u64 handles (i+1 to distinguish from the 0 initial
//     ring-cell value) rather than real KIND_MEMORY cap_slots -- the
//     ring is opaque about payload shape.
//   * The mint fingerprint `pipe edge mint ok ...` fires TWICE (once per
//     endpoint) from inside pipeline_edge_alloc; the R121.M1 witness
//     already made that path reachable so tools/verify-fingerprint-
//     coverage.sh needs no allowlist entry for this landing.
//   * The bind fingerprint `pipe edge bind ok kind=<hex> ring=<hex>`
//     fires once from inside pipe_edge_bind_byrow.
//   * Teardown scrubs both edges + the ring on every exit (success and
//     every failure arm) so the pool stays clean across a re-run.
//
// ENCODER DISCIPLINE (mirror r121_pipeline_edge.pdx):
//   No `test rN,rN`, no `add reg,[mem]`, no `cmp reg,[mem]`; every
//   value staged through a register first. Every store is a qword
//   `mov [mem], reg`. Every label prefixed `r121pet_`.

module R121PipelineEdgeTransport = structure {

  pub let mut _r121pet_stage : u64 = 0

  // Iteration count for the pump.
  pub let R121PET_ITERS : u64 = 10000

  // Synthetic schema_id -- reuse R121PE_SCHEMA_ID pattern (visual pun on
  // "R121 transport"): 0x121F.
  pub let R121PET_SCHEMA_ID : u64 = 0x121F

  pub let tag_pipe_transport_bp_ok    : [u8; 26] = "boot pipe transport bp ok\0"
  pub let r121pet_fail_msg            : [u8; 25] = "boot pipe transport fail\0"

  // ==========================================================================
  // witness_r121_pipeline_edge_transport() -> ()
  //
  // Six callee-save pushes (rbx, r12-r15) + one align pad on r10 alt via
  // an unpaired scratch push are avoided by taking one extra rbx pad; five
  // pushes suffice (rbx=prod_row, r12=cons_row, r13=t_start, r14=t_end,
  // r15=iter cursor). Entry rsp%16==8, +40 -> %16==0 for every nested
  // call, matching every sibling witness in this cascade.
  // ==========================================================================
  pub let witness_r121_pipeline_edge_transport : () -> () !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R121.M2 (paideia-os #2496): boot witness for the KIND_PIPELINE_EDGE transport end-to-end. Sequence: (1) mint PROD row (stage 1), (2) mint CONS row (stage 2), (3) bind them (stage 3), (4) pump R121PET_ITERS = 10000 records timed via hpet_now_ns (stages 4/5/6/7/8 for the various mid-pump failure classes), (5) assert backpressure by filling the ring to capacity (16 sends), attempting a 17th (stage 9 if the refuse doesn't fire), then draining (stage 10 if drain misbehaves). On success emit `pipe intra ok records=10000 ns_avg=<n>` via klog_s1_d2 (v2 = ns_avg pushed onto the stack with sub rsp,8/push v2/call/add rsp,16 idiom, identical to r100_tls_trust.pdx / r121_pipeline_edge.pdx). Also emit `boot pipe transport bp ok --` on the backpressure arm via klog_s1 (no KV). Failure funnel emits `boot pipe transport fail line=<stage>` via klog_s1_d1. Cleanup teardown runs on every exit: pipeline_edge_free on both rows + pet_ring_free on the bound ring (the ring lookup goes through pet_row_read_ring_id BEFORE the row scrub because pipeline_edge_free zeroes the row-header in_use marker but does NOT touch the separate _pet_row_ring_id table -- the mapping stays valid until pet_row_write_ring_id is called or pet_init runs, which is fine for teardown ordering here). Five callee-save pushes (rbx=prod_row, r12=cons_row, r13=t_start, r14=t_end, r15=iter cursor / scratch) leave rsp%16==0 at every nested call (entry rsp%16==8, +40 -> %16==0). Labels prefixed r121pet_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // ============================================================
        // Stage 1: mint PROD endpoint.
        // ============================================================
        mov rax, 1;
        mov [rip + _r121pet_stage], rax;

        mov rdi, 0x121F;                  // R121PET_SCHEMA_ID
        mov rsi, 0;                       // PE_ROLE_PROD
        mov rdx, 0x001;                   // R_PE_SEND
        call pipeline_edge_alloc;
        mov r10, 32;                      // PE_MAX
        cmp rax, r10;
        jae r121pet_fail;
        mov rbx, rax;                     // prod_row

        // ============================================================
        // Stage 2: mint CONS endpoint.
        // ============================================================
        mov rax, 2;
        mov [rip + _r121pet_stage], rax;

        mov rdi, 0x121F;
        mov rsi, 1;                       // PE_ROLE_CONS
        mov rdx, 0x002;                   // R_PE_RECV
        call pipeline_edge_alloc;
        mov r10, 32;
        cmp rax, r10;
        jae r121pet_fail_cleanup_prod;
        mov r12, rax;                     // cons_row

        // ============================================================
        // Stage 3: bind them.
        // ============================================================
        mov rax, 3;
        mov [rip + _r121pet_stage], rax;

        mov rdi, rbx;
        mov rsi, r12;
        call pipe_edge_bind_byrow;
        cmp rax, 0;                       // PE_OK
        jne r121pet_fail_cleanup_both;

        // ============================================================
        // Stage 4..8: pump R121PET_ITERS records. Timing bracket around
        // the whole loop via hpet_now_ns. Each iteration:
        //   send(prod, i+1); recv(cons) -> h; if h != i+1 -> stage 8.
        // ============================================================
        // Record start time. Five callee-save pushes on entry mean
        // rsp%16 == 0 at this point; hpet_now_ns is a leaf callee with
        // no internal call sites of its own -- direct call satisfies
        // SysV (call pushes RA -> callee sees rsp%16==8). No pad.
        call hpet_now_ns;
        mov r13, rax;                     // t_start

        // r15 = iter cursor (0..R121PET_ITERS-1).
        xor r15, r15;

      r121pet_pump:
        mov r10, 10000;                   // R121PET_ITERS
        cmp r15, r10;
        jae r121pet_pump_done;

        // send(prod, i+1).
        mov rax, 4;
        mov [rip + _r121pet_stage], rax;
        mov rdi, rbx;
        mov rsi, r15;
        add rsi, 1;                       // handle = i+1 (non-zero)
        call pipe_edge_send_byrow;
        cmp rax, 0;                       // PE_OK
        jne r121pet_fail_cleanup_bound;

        // recv(cons).
        mov rax, 5;
        mov [rip + _r121pet_stage], rax;
        mov rdi, r12;
        call pipe_edge_recv_byrow;
        // Check handle == i+1.
        mov r10, r15;
        add r10, 1;
        cmp rax, r10;
        jne r121pet_fail_stage8_cleanup;

        add r15, 1;
        jmp r121pet_pump;

      r121pet_pump_done:
        // Record end time, ns_avg = (t_end - t_start) / R121PET_ITERS.
        // Same alignment note as the t_start call above -- leaf callee,
        // no pad required.
        call hpet_now_ns;
        mov r14, rax;                     // t_end

        mov rax, r14;
        sub rax, r13;                     // total_ns
        // Divide by R121PET_ITERS (10000).
        xor rdx, rdx;
        mov rcx, 10000;
        div rcx;                          // rax = ns_avg
        mov r15, rax;                     // r15 = ns_avg (repurposed)

        // Emit `pipe intra ok records=10000 ns_avg=<r15>` via klog_s1_d2.
        //
        // klog_s1_d2 signature: (level, subsys, tag, k1, v1, k2)
        // + [rsp+8] = v2. Entry to this emit: rsp%16 == 0 (five
        // callee-save on entry). sub 8 -> %16 == 8. push v2 (ns_avg)
        // -> %16 == 0.
        sub rsp, 8;
        mov rax, r15;                     // v2 = ns_avg
        push rax;
        mov rdi, 3;                       // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_pipe_intra_ok];
        lea rcx, [rip + k_records];
        mov r8,  10000;                   // v1 = records
        lea r9,  [rip + k_ns_avg];
        call klog_s1_d2;
        add rsp, 16;

        // ============================================================
        // Stage 9..10: backpressure test. Ring is EMPTY after the pump
        // (every send was drained). Now: fill it to capacity with 16
        // sends, verify the 17th refuses with PET_EAGAIN, then drain.
        // ============================================================
        xor r15, r15;                     // fill counter

      r121pet_fill:
        cmp r15, 16;                      // PET_SLOTS_PER_RING
        jae r121pet_fill_done;
        mov rdi, rbx;
        mov rsi, r15;
        add rsi, 100;                     // handle = 100 + i (distinct
                                          //   from pump payload)
        call pipe_edge_send_byrow;
        cmp rax, 0;                       // must succeed
        jne r121pet_fail_stage9_cleanup;
        add r15, 1;
        jmp r121pet_fill;

      r121pet_fill_done:
        // 17th send should refuse with PET_EAGAIN.
        mov rax, 9;
        mov [rip + _r121pet_stage], rax;
        mov rdi, rbx;
        mov rsi, 999;                     // handle
        call pipe_edge_send_byrow;
        mov r10, 0xFFFFFFFFFFFFFFF5;      // PET_EAGAIN
        cmp rax, r10;
        jne r121pet_fail_stage9_cleanup;

        // Drain 16 records.
        mov rax, 10;
        mov [rip + _r121pet_stage], rax;
        xor r15, r15;
      r121pet_drain:
        cmp r15, 16;
        jae r121pet_drain_done;
        mov rdi, r12;
        call pipe_edge_recv_byrow;
        // Expect the fill-payload (100 + i); on mismatch, stage 10.
        mov r10, r15;
        add r10, 100;
        cmp rax, r10;
        jne r121pet_fail_stage10_cleanup;
        add r15, 1;
        jmp r121pet_drain;

      r121pet_drain_done:
        // Emit `boot pipe transport bp ok --` via klog_s1 (no KV).
        //
        // klog_s1 signature: (level, subsys, tag) -- 3 args, no KVs.
        // Entry to this emit: rsp%16 == 0. No stack pad needed.
        mov rdi, 3;                       // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_pipe_transport_bp_ok];
        call klog_s1;

        // ============================================================
        // Success cleanup: recover ring_id, free both rows, free ring.
        // ============================================================
        mov rdi, rbx;
        call pet_row_read_ring_id;
        mov r15, rax;                     // ring_id

        mov rdi, rbx;
        call pipeline_edge_free;
        mov rdi, r12;
        call pipeline_edge_free;

        // Ring free only if ring_id is in range (defense-in-depth).
        mov r10, 16;                      // PET_RING_MAX
        cmp r15, r10;
        jae r121pet_out;
        mov rdi, r15;
        call pet_ring_free;
        jmp r121pet_out;

      // ============================================================
      // Failure funnels. Cleanup varies by stage: which rows are live,
      // whether bind succeeded (so a ring needs freeing).
      // ============================================================

      r121pet_fail_stage9_cleanup:
      r121pet_fail_stage10_cleanup:
      r121pet_fail_stage8_cleanup:
        // Full drain attempt then fall through to bound cleanup.
        // (The ring may have leftover payloads; teardown scrub handles it.)
        // Fallthrough intentional.

      r121pet_fail_cleanup_bound:
        // Both rows live + bound to a ring.
        mov rdi, rbx;
        call pet_row_read_ring_id;
        mov r15, rax;
        // Free rows first, then ring.
        mov rdi, rbx;
        call pipeline_edge_free;
        mov rdi, r12;
        call pipeline_edge_free;
        mov r10, 16;
        cmp r15, r10;
        jae r121pet_fail;
        mov rdi, r15;
        call pet_ring_free;
        jmp r121pet_fail;

      r121pet_fail_cleanup_both:
        // Both rows live but unbound (bind failed).
        mov rdi, rbx;
        call pipeline_edge_free;
        mov rdi, r12;
        call pipeline_edge_free;
        jmp r121pet_fail;

      r121pet_fail_cleanup_prod:
        // Prod row live, cons mint failed.
        mov rdi, rbx;
        call pipeline_edge_free;

      r121pet_fail:
        // Emit `boot pipe transport fail line=<stage>` via klog_s1_d1.
        mov rax, [rip + _r121pet_stage];
        mov rdi, 3;                       // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + r121pet_fail_msg];
        lea rcx, [rip + k_line];
        mov r8,  rax;                     // v = stage
        call klog_s1_d1;

      r121pet_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
