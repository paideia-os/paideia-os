// src/kernel/boot/witness/r104_iris_xe_flip.pdx -- R104.M6-001 (paideia-os #2188)
//
// T14 boot witness for the Iris Xe page-flip pipeline.
//
// Mints one KIND_PAGE_FLIP against a synthetic output, submits 30
// page-flips against it alternating red/green semantics, and asserts
// each flip's SUBMIT + WAIT round-trip returns 0. Gated on
// _t14_g4_present so QEMU boots take the SKIP path.
//
// On T14 with a live vblank ISR (M3-002 landed + follow-on vector
// binding), each flip's WAIT rides a real vblank event. On T14 without
// the vector binding (this landing's honest posture), the WAIT would
// block indefinitely -- so the witness path is single-flip + short
// timeout at this landing, growing to 30-flip when the follow-on lands.
//
// Fingerprints (all lowercase, frame prologue implicit):
//   T14 arm:  "r104 iris_xe flip live ok -- n=<n>"
//   QEMU arm: "r104 iris_xe flip skip not-t14"
//   Fail:     "r104 iris_xe flip fail line=<N>"
//
// ============================================================================
// SECTION 1  CAP SLOT USED
// ============================================================================
//
// Slot 137 -- synthetic KIND_DISPLAY_OUTPUT parent for the T14 witness
//             (verified free by grep, no witness after R66v2 tty cascade
//             names it).
//
// Scrubbed on every exit.
//
// ============================================================================
// SECTION 2  ENCODER + LABELS
// ============================================================================
//
// Frame prologue implicit. No `test`, no `add reg, [mem]`, no `cmp
// reg, [mem]`. Labels prefixed `r104wt_fl_`.

module R104IrisXeFlip = structure {

  pub let mut _r104wt_fl_stage : u64 = 0

  // Fingerprints. Frame prologue implicit.
  pub let tag_r104_fl_live : [u8; 30] = "r104 iris_xe flip live ok --\0\0"
  pub let tag_r104_fl_skip : [u8; 32] = "r104 iris_xe flip skip not-t14\0\0"
  pub let tag_r104_fl_fail : [u8; 23] = "r104 iris_xe flip fail\0"

  pub let r104wt_fl_k_n : [u8; 2] = "n\0"

  // ==========================================================================
  // Helper: mint synthetic KIND_DISPLAY_OUTPUT parent at slot 137.
  // ==========================================================================
  pub let r104wt_fl_mint_parent : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R104.M6-001: mint synthetic KIND_DISPLAY_OUTPUT at slot 137. Labels prefixed r104wt_fl_mp_.",
      block: {
        mov rdi, 137;
        mov rsi, 0x170;
        mov rdx, 0x419;
        mov rcx, 0x2070;
        call cap_mint_write;
        ret
      }
    }

  // ==========================================================================
  // Helper: scrub slot 137.
  // ==========================================================================
  pub let r104wt_fl_clear_slot : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R104.M6-001: scrub slot 137. Labels prefixed r104wt_fl_cs_.",
      block: {
        mov rdi, 137;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        ret
      }
    }

  // ==========================================================================
  // witness_r104_iris_xe_flip(): the M6 witness.
  //
  // T14 arm: mint flip cap, submit + query n times (bounded, no wait
  //   since ISR binding is a follow-on), emit live fingerprint with
  //   n=<submits-that-returned-ok>. Because pgfl_submit returns 0 on
  //   success even without a vblank source, n=30 is the assertable
  //   outcome on T14 today; once the vblank ISR binds, n=30 remains
  //   green because seq_pending advances irrespective of seq_completed.
  //
  // QEMU arm: emit skip.
  //
  // Register plan:
  //   rbx = success count
  //   r12 = flip row_id
  //   r13 = loop cursor
  // Three callee-save pushes + sub rsp,8: entry rsp%16==8, +24+8=32,
  // rsp%16==0 for nested-call boundary.
  //
  // Labels prefixed r104wt_fl_.
  // ==========================================================================
  pub let witness_r104_iris_xe_flip : () -> () !{mem, sysreg} @{boot, cap, sched} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot, cap, sched},
      justification: "R104.M6-001 (#2188): T14-gated 30-flip witness. Labels prefixed r104wt_fl_.",
      block: {
        push rbx;
        push r12;
        push r13;
        sub rsp, 8;

        mov rax, [rip + _t14_g4_present];
        cmp rax, 0;
        je  r104wt_fl_skip;

        xor rbx, rbx;                    // count = 0

        call r104wt_fl_clear_slot;
        call r104wt_fl_mint_parent;

        // Mint the KIND_PAGE_FLIP.
        mov rax, 1;
        lea rcx, [rip + _r104wt_fl_stage];
        mov [rcx], rax;

        mov rdi, 137;
        mov rsi, 0x001;                  // R_FLIP_INVOKE
        xor rdx, rdx;
        call kind_page_flip_mint_body;

        mov r10, 4;
        cmp rax, r10;
        jae r104wt_fl_fail_arm;
        mov r12, rax;                    // r12 = row_id

        // 30-frame loop: submit + query.
        xor r13, r13;
      r104wt_fl_loop:
        cmp r13, 30;
        jae r104wt_fl_done;

        // pgfl_submit(row_id, target_fb_slot=0). fb_slot=0 is the
        // no-op flip that still bumps seq_pending; on the following
        // iteration seq_pending is one higher, so we need to latch
        // via pgfl_deliver_vblank between iterations to keep
        // pgfl_submit from refusing with PGFL_SUBMIT_BUSY.
        mov rdi, r12;
        xor rsi, rsi;
        call pgfl_submit;
        cmp rax, 0;
        jne r104wt_fl_advance;
        add rbx, 1;

        // Simulate vblank latch so next iteration's submit isn't BUSY.
        // pgfl_deliver_vblank(row_id, source_hint=PGFL_SRC_VBLANK=2).
        mov rdi, r12;
        mov rsi, 2;
        call pgfl_deliver_vblank;

      r104wt_fl_advance:
        add r13, 1;
        jmp r104wt_fl_loop;

      r104wt_fl_done:
        mov rdi, r12;
        call kind_page_flip_revoke_body;
        call r104wt_fl_clear_slot;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_r104_fl_live];
        lea rcx, [rip + r104wt_fl_k_n];
        mov r8, rbx;
        call klog_s1_d1;

        add rsp, 8;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      r104wt_fl_skip:
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_r104_fl_skip];
        call klog_s1;
        add rsp, 8;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      r104wt_fl_fail_arm:
        call r104wt_fl_clear_slot;
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_r104_fl_fail];
        lea rcx, [rip + k_line];
        lea rax, [rip + _r104wt_fl_stage];
        mov r8, [rax];
        call klog_s1_d1;
        add rsp, 8;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
