// src/kernel/boot/witness/r72_tcp_echo.pdx — R72.M1-007 (#1929)
//
// boot_r72_tcp_echo: a kernel-side, straight-line witness that drives
// net/tcp.pdx's state machine through a full connect + echo + orderly
// close cycle against ITSELF (local_ip == remote_ip == _ipv4_my_ip,
// the only "loopback" this tree has — see tcp.pdx's module header for
// why there is no 127.0.0.0/8 interface to connect to instead).
//
// Because tcp_send_segment's loopback fast path calls tcp_rx_handle
// in-process rather than going through ipv4_tx_send/e1000e, every step
// below resolves SYNCHRONOUSLY: by the time tcp_send_segment(SYN)
// returns, the whole 3-way handshake (both TCBs) has already run.
// There is no scheduler, no IRQ, no wait — this witness is ordinary
// straight-line kernel code exercising real network-stack primitives.
//
// The two TCBs are built directly against net/tcp.pdx's primitives
// (tcp_alloc_tcb / tcp_next_iss / tcp_send_segment / tcp_accept_pending
// / tcp_close) rather than through the SC+ 87..94 syscalls — a boot
// witness runs in ring 0 before any ring-3 process exists, so there is
// no fd/cap_slot layer to go through yet (same posture every other
// kernel_main-driven witness in this tree takes toward its own
// subsystem's syscalls).
//
// Sequence witnessed, each with its own klog fingerprint:
//   1. Listener TCB bound to port 7 (RFC 862 echo, matching udp.pdx's
//      own port-7 convention) — TCP_ST_LISTEN.
//   2. Client TCB (local_port 50000, fixed rather than drawn from
//      tcp_next_ephemeral_port for a deterministic golden) SYNs to
//      itself:port 7 — "tcp syn sent". By the time tcp_send_segment
//      returns, the listener has spawned a child TCB in SYN_RCVD, the
//      client has processed SYN|ACK into ESTABLISHED, and the child has
//      processed the final ACK into ESTABLISHED.
//   3. Client state checked == TCP_ST_ESTABLISHED — "tcp handshake
//      complete".
//   4. tcp_accept_pending claims the child TCB (the moment a real
//      sys_accept would return a new fd).
//   5. Client sends "hello" (5 bytes, PSH|ACK). The child's ESTABLISHED
//      data-received path recognizes local_port==7 (net/tcp.pdx's
//      TCP_PORT_ECHO) and echoes the payload straight back — same
//      convention as udp_rx_handle's own port-7 echo. Client's rx_buf
//      is byte-compared against "hello" — "tcp echo verified".
//   6. tcp_close(client) then tcp_close(child) drive the full 4-way
//      teardown (FIN_WAIT_1/2 on the client side, CLOSE_WAIT/LAST_ACK
//      on the child's) to completion; both TCBs' in_use flags are
//      checked 0 — "tcp orderly close".
//
// A failure at any checkpoint jumps straight to the epilogue without
// emitting that checkpoint's (or any later) fingerprint — the missing
// "OK" line is the failure signal, matching this tree's fingerprint-
// diff smoke discipline throughout (see tools/verify-fingerprint-
// coverage.sh's own description of the convention).

module R72TcpEcho = structure {

  pub let _r72_hello_witness_msg : [u8; 5] = [104u8, 101u8, 108u8, 108u8, 111u8]   // "hello"

  pub let witness_r72_tcp_echo : () -> () !{sysreg, mem} @{boot} = fn () -> unsafe {
    effects: {sysreg, mem},
    capabilities: {boot},
    justification: "R72.M1-007 (#1929): the R72 round-closing boot witness. Drives net/tcp.pdx's TCB primitives directly (no cap_table/syscall layer -- boot witnesses run before any ring-3 process exists) through a self-connect handshake, a port-7 echo exchange, and a full mutual close, checking state after each phase and emitting a klog fingerprint only when that phase's check passes. 3-push callee-save (rbx=listener_tcb_idx, r12=client_tcb_idx, r13=child_tcb_idx): entry rsp%16==8, three pushes (24 bytes) land rsp%16==0 -- no alignment pad needed for any of the nested tcp_alloc_tcb/tcp_next_iss/tcp_send_segment/tcp_accept_pending/tcp_close/klog_s1 calls. Reserved labels: r72te_.",
    block: {
      push rbx;
      push r12;
      push r13;

      // ============================================================
      // (1) Listener TCB: port 7, LISTEN.
      // ============================================================
      call tcp_alloc_tcb;
      cmp rax, 0xFFFFFFFFFFFFFFFF;
      je r72te_fail;
      mov rbx, rax;

      mov rax, rbx; shl rax, 9; lea rcx, [rip + _tcp_tcb_table]; add rax, rcx;
      mov rcx, 7;
      mov [rax + 8], rcx;
      xor rcx, rcx; mov_b rcx, [rip + _ipv4_my_ip + 0]; mov_b [rax + 24], rcx;
      xor rcx, rcx; mov_b rcx, [rip + _ipv4_my_ip + 1]; mov_b [rax + 25], rcx;
      xor rcx, rcx; mov_b rcx, [rip + _ipv4_my_ip + 2]; mov_b [rax + 26], rcx;
      xor rcx, rcx; mov_b rcx, [rip + _ipv4_my_ip + 3]; mov_b [rax + 27], rcx;
      mov rcx, 1;
      mov [rax + 0], rcx;

      // ============================================================
      // (2) Client TCB: local_port 50000, remote self:7, SYN_SENT.
      // ============================================================
      call tcp_alloc_tcb;
      cmp rax, 0xFFFFFFFFFFFFFFFF;
      je r72te_fail;
      mov r12, rax;

      mov rax, r12; shl rax, 9; lea rcx, [rip + _tcp_tcb_table]; add rax, rcx;
      mov rcx, 50000;
      mov [rax + 8], rcx;
      mov rcx, 7;
      mov [rax + 16], rcx;
      xor rcx, rcx; mov_b rcx, [rip + _ipv4_my_ip + 0]; mov_b [rax + 24], rcx;
      xor rcx, rcx; mov_b rcx, [rip + _ipv4_my_ip + 1]; mov_b [rax + 25], rcx;
      xor rcx, rcx; mov_b rcx, [rip + _ipv4_my_ip + 2]; mov_b [rax + 26], rcx;
      xor rcx, rcx; mov_b rcx, [rip + _ipv4_my_ip + 3]; mov_b [rax + 27], rcx;
      xor rcx, rcx; mov_b rcx, [rip + _ipv4_my_ip + 0]; mov_b [rax + 32], rcx;
      xor rcx, rcx; mov_b rcx, [rip + _ipv4_my_ip + 1]; mov_b [rax + 33], rcx;
      xor rcx, rcx; mov_b rcx, [rip + _ipv4_my_ip + 2]; mov_b [rax + 34], rcx;
      xor rcx, rcx; mov_b rcx, [rip + _ipv4_my_ip + 3]; mov_b [rax + 35], rcx;

      call tcp_next_iss;
      mov rcx, rax;
      mov rax, r12; shl rax, 9; lea rdx, [rip + _tcp_tcb_table]; add rax, rdx;
      mov [rax + 80], rcx;
      mov [rax + 40], rcx;
      mov [rax + 48], rcx;
      mov rcx, 2;
      mov [rax + 0], rcx;

      mov rdi, 3;
      lea rsi, [rip + SUBSYS_NET_];
      lea rdx, [rip + tag_r72_syn_ok];
      call klog_s1;

      mov rdi, r12;
      mov rsi, 0x02;
      xor rdx, rdx;
      xor rcx, rcx;
      call tcp_send_segment;

      // ============================================================
      // (3) Handshake check: client must be ESTABLISHED by now.
      // ============================================================
      mov rax, r12; shl rax, 9; lea rcx, [rip + _tcp_tcb_table]; add rax, rcx;
      mov rcx, [rax + 0];
      cmp rcx, 4;
      jne r72te_fail;

      mov rdi, 3;
      lea rsi, [rip + SUBSYS_NET_];
      lea rdx, [rip + tag_r72_handshake_ok];
      call klog_s1;

      // ============================================================
      // (4) Accept the child (server-side) connection.
      // ============================================================
      mov rdi, rbx;
      call tcp_accept_pending;
      cmp rax, 0xFFFFFFFFFFFFFFFF;
      je r72te_fail;
      mov r13, rax;

      // ============================================================
      // (5) Send "hello"; verify the port-7 echo landed in client's
      //     rx_buf.
      // ============================================================
      mov rdi, r12;
      mov rsi, 0x18;
      lea rdx, [rip + _r72_hello_witness_msg];
      mov rcx, 5;
      call tcp_send_segment;

      mov rax, r12; shl rax, 12; lea rcx, [rip + _tcp_rx_buf_table]; add rcx, rax;
      xor rax, rax; mov_b rax, [rcx + 0]; cmp rax, 104; jne r72te_fail;
      xor rax, rax; mov_b rax, [rcx + 1]; cmp rax, 101; jne r72te_fail;
      xor rax, rax; mov_b rax, [rcx + 2]; cmp rax, 108; jne r72te_fail;
      xor rax, rax; mov_b rax, [rcx + 3]; cmp rax, 108; jne r72te_fail;
      xor rax, rax; mov_b rax, [rcx + 4]; cmp rax, 111; jne r72te_fail;

      mov rdi, 3;
      lea rsi, [rip + SUBSYS_NET_];
      lea rdx, [rip + tag_r72_echo_ok];
      call klog_s1;

      // ============================================================
      // (6) Orderly close: client-initiated, then child finishes.
      // ============================================================
      mov rdi, r12;
      call tcp_close;

      mov rdi, r13;
      call tcp_close;

      mov rax, r12; shl rax, 9; lea rcx, [rip + _tcp_tcb_table]; add rax, rcx;
      mov rcx, [rax + 168];
      cmp rcx, 0;
      jne r72te_fail;

      mov rax, r13; shl rax, 9; lea rcx, [rip + _tcp_tcb_table]; add rax, rcx;
      mov rcx, [rax + 168];
      cmp rcx, 0;
      jne r72te_fail;

      mov rdi, 3;
      lea rsi, [rip + SUBSYS_NET_];
      lea rdx, [rip + tag_r72_close_ok];
      call klog_s1;

    r72te_fail:
      pop r13;
      pop r12;
      pop rbx;
      ret
    }
  }
}
