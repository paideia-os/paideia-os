// src/kernel/boot/witness/rpc_servers.pdx — boot witness module
//
// Extracted verbatim from src/kernel/boot/kernel_main.pdx (which had grown
// to 24,315 lines in two functions).  Userspace RPC server witness block — the ACPI supervisor (#820) and PCI enumerator (#860) roundtrips.
//
// -----------------------------------------------------------------------------
// Why the body is copied and not rewritten
// -----------------------------------------------------------------------------
//
// The goldens for this tree assert an ORDERED SUBSEQUENCE of fingerprints
// across 14 boot modes, and a witness that silently stops running still
// leaves most of that subsequence intact.  The extraction therefore moves
// the instruction stream unchanged: the only bytes this module adds around
// it are the `push rbp` / `pop rbp` / `ret` below.
//
// -----------------------------------------------------------------------------
// The push is not decoration
// -----------------------------------------------------------------------------
//
// `boot_continue_after_ring3` runs its body at `rsp % 16 == 8` — it sits two `call` levels
// below `_start`, and paideia-as emits no frame prologue for an
// `unsafe`-bodied lambda (emit_visit_lambda.rs suppresses the prologue for
// Unsafe bodies, which is also why `@no_frame` is a no-op there).  Several
// witnesses in this file reason explicitly about that parity — "3 pushes from %16==8
// yields (8+3*8)%16 == 0" — and a bare `call` into a bare body would enter
// at `%16 == 0` and invert every one of those arguments.  The single
// `push rbp` restores the inline parity exactly; the matching `pop rbp`
// keeps rbp's SysV guarantee for the caller.
//
// Sections in this module, in the order boot_continue_after_ring3 ran them:
//   * R20-M4-002 (#820): ACPI supervisor RPC witness — closes #820.
//   * R22-M3-005 (#860): PCI enumerator RPC witness — closes #860.

module RpcServers = structure {

  // witness_rpc_servers() — the Userspace RPC server witness block — the ACPI supervisor (#820) and PCI enumerator (#860) roundtrips.
  //
  // Effect and capability rows are the ones the enclosing
  // `boot_continue_after_ring3` declares.  They are not widened here: this
  // is the same instruction stream under a new symbol, so the authority it
  // needs is by construction the authority it already had.
  pub let witness_rpc_servers : () -> () !{sysreg} @{} = fn () -> unsafe {
    effects: { sysreg },
    capabilities: { boot },
    justification: "Boot witness block lifted verbatim out of kernel_main.pdx's boot_continue_after_ring3 during the rpc_servers extraction. Body bytes are unchanged from the inline form; the only additions are the entry `push rbp` and the exit `pop rbp; ret`. The push is load-bearing rather than cosmetic: boot_continue_after_ring3 executes its body at rsp%16 == 8 (two `call` levels below _start, with no frame prologue emitted for unsafe-bodied lambdas), and the witnesses inside this module compute their own nested-call alignment from that parity. Entering through a `call` without the compensating push would present rsp%16 == 0 to the body and silently invert every such argument — the failure mode of paideia-os #1192, #1195 and #1584. Effects and capabilities are copied unchanged from the enclosing function for the same reason: no authority is added, so none needs justifying beyond what boot_continue_after_ring3 already justified.",
    block: {
      push rbp;

      // ============================================================
      // R20-M4-002 (#820): ACPI supervisor RPC witness — closes #820.
      //
      // Discharges #820's original acceptance criteria (userspace
      // acpi_supervisor server — accepts KIND_ACPI + serves parse
      // queries) via the "Option B — kernel-side witness driving the
      // RPC" posture, matching R20b.M5-001 and R20b.M6-003 discipline.
      // The acpi_supervisor userspace binary at
      // src/user/acpi_supervisor.pdx exists as the target shape; the
      // actual ring-3 spawn wires up post-R20b when multi-task boot
      // orchestration lands (per §4.4 Deferred paragraph of
      // design/ipc/userspace-server-substrate.md).
      //
      // Witness structure
      // -----------------
      // Runs after m6_rpc_witness_done + before sti / enter_userland_initial.
      // Uses init's user_pml4 as the "user" address space (same as M5/M6).
      // Loops op ∈ {1, 2, 3, 4} through the full IPC round-trip:
      //
      //   Stages per iteration (recorded in _acpi_witness_stage):
      //     10..19   op=1 ACPI_OP_ENUMERATE
      //     20..29   op=2 ACPI_OP_GET_MADT
      //     30..39   op=3 ACPI_OP_GET_MCFG
      //     40..49   op=4 ACPI_OP_GET_HPET
      //
      // Sub-stage semantic within each op iter (offset from 10*op):
      //   +0  encode request hdr (frame_encode)
      //   +1  publish request hdr to user page 0xC000 (walker write)
      //   +2  sys_ipc_send_body (client → server_ep, len=0)
      //   +3  read TSC start (rdtsc)
      //   +4  sys_ipc_recv_body (server drain @ server_ep)
      //   +5  kernel dispatch — call sup_* helper into _reply_payload_kbuf
      //   +6  encode reply hdr with reply-bit + reply_len
      //   +7  publish reply hdr + payload to user page 0xD000 (walker write)
      //   +8  sys_ipc_reply_body (server → reply_ep via dual-endpoint routing)
      //   +9  sys_ipc_recv_body (client drain @ reply_ep) + read TSC end
      //         + verify hdr op | 0x80 + payload_len match + update max_delta
      //
      // Op=1 gets an additional sub-check: verify n_tables (u16 @ payload+0) >= 4
      // (q35 firmware always publishes at least FADT/MADT/MCFG/HPET).
      //
      // Register plan
      // -------------
      //   rbx = server_ep (SysV callee-save; survives every nested call)
      //   r13 = current op (1..4)
      //   r15 = reply_ep (SysV callee-save)
      //   r12/r14 hold the loader's init boot state (task_slab / entry_rip
      //           / user_rsp_top per m6_rpc_witness comment §L13045) —
      //           MUST NOT be touched; enter_userland_initial reads them
      //           for its iretq frame. We push/pop r12/r13/r14 across our
      //           own use even though r12/r14 are re-read from the outer
      //           scope at the epilogue via the same `mov rdi, r13` etc.
      //           chain the M6 witness left intact. Simplest safe posture:
      //           push rbx/r13/r15 only (3 pushes = 24 B, entry rsp %16 == 0
      //           from m6 pop → post-push %16 == 8; sub rsp, 8 pad restores
      //           %16 == 0 for nested calls).
      //
      // Alignment: entry state at m6_rpc_witness_done + pop rbx → rsp %16
      // still matches the outer function entry (SysV %16 == 8 upon call).
      // We do 3 pushes + sub rsp, 8 = 32 B; rsp %16 == 8 + 32 = 40 → 40 %
      // 16 == 8. Wait — actually we want %16 == 0 pre-call. So 3 pushes = 24,
      // 8+24=32, 32%16=0. Good — no sub rsp,8 needed.
      // ============================================================
      m4_002_acpi_rpc_witness:
          push rbx;                                // %16 -> 0 for nested calls
          push r13;
          push r15;

          // -- Stage 0: fabricate synthetic XSDT + downstream SDTs in .bss.
          // Under `-kernel` QEMU boot there is no RSDP; the witness
          // synthesizes the minimum SDT hierarchy the sup_* helpers need
          // (see _acpi_witness_synth_* comment for the rationale). All
          // fabrication happens via direct u64/u32 stores to .bss; no
          // syscall or nested call — pure register + memory work.
          xor rax, rax;
          lea rcx, [rip + _acpi_witness_stage];
          mov [rcx], rax;                          // stage = 0

          // ---- (a) Zero all five synthetic table blobs (16 u64 each) ----
          //   Loop over each blob with a base + zero-fill pattern. Simpler
          //   inline pattern given only 5 blobs of 16 u64 each — total 640B.
          //   Emit 16 explicit u64 zero stores per blob to avoid loop
          //   overhead / paideia-as's occasional loop-encoder friction.

          // ---- (b) _synth_xsdt: build the header + 4 entries. ----
          //   Header sig "XSDT" (0x54445358) + length 68 (=36+4*8) = 0x44
          //   Combined u64 at +0: (0x44 << 32) | 0x54445358 = 0x0000004454445358
          lea rdi, [rip + _acpi_witness_synth_xsdt];
          xor rax, rax;
          mov [rdi + 0],   rax;
          mov [rdi + 8],   rax;
          mov [rdi + 16],  rax;
          mov [rdi + 24],  rax;
          mov [rdi + 32],  rax;
          mov [rdi + 40],  rax;
          mov [rdi + 48],  rax;
          mov [rdi + 56],  rax;
          mov [rdi + 64],  rax;
          mov [rdi + 72],  rax;
          mov [rdi + 80],  rax;
          mov [rdi + 88],  rax;
          mov [rdi + 96],  rax;
          mov [rdi + 104], rax;
          mov [rdi + 112], rax;
          mov [rdi + 120], rax;
          // Header sig + length at +0.
          mov rax, 0x0000004454445358;
          mov [rdi + 0], rax;
          // Revision u8 @ +8 = 1.
          mov rax, 1;
          mov_b [rdi + 8], rax;
          // Entries at +36, +44, +52, +60 → FADT, MADT, MCFG, HPET pointers.
          lea rax, [rip + _acpi_witness_synth_fadt];
          mov [rdi + 36], rax;
          lea rax, [rip + _acpi_witness_synth_madt];
          mov [rdi + 44], rax;
          lea rax, [rip + _acpi_witness_synth_mcfg];
          mov [rdi + 52], rax;
          lea rax, [rip + _acpi_witness_synth_hpet];
          mov [rdi + 60], rax;

          // ---- (c) _synth_madt: SIG "APIC", length 76 (=44 + 4*8) ----
          //   Combined u64 at +0: (0x4C << 32) | 0x43495041 = 0x0000004C43495041
          //   Note length 76 = 0x4C.
          lea rdi, [rip + _acpi_witness_synth_madt];
          xor rax, rax;
          mov [rdi + 0],   rax;
          mov [rdi + 8],   rax;
          mov [rdi + 16],  rax;
          mov [rdi + 24],  rax;
          mov [rdi + 32],  rax;
          mov [rdi + 40],  rax;
          mov [rdi + 48],  rax;
          mov [rdi + 56],  rax;
          mov [rdi + 64],  rax;
          mov [rdi + 72],  rax;
          mov [rdi + 80],  rax;
          mov [rdi + 88],  rax;
          mov [rdi + 96],  rax;
          mov [rdi + 104], rax;
          mov [rdi + 112], rax;
          mov [rdi + 120], rax;
          mov rax, 0x0000004C43495041;
          mov [rdi + 0], rax;
          mov rax, 1;
          mov_b [rdi + 8], rax;                    // revision = 1
          // MADT-specific fields at +36 (lapic_address u32) + +40 (flags u32)
          // stay zero. Sub-entries at +44 onwards.
          //
          // 4 LAPIC sub-entries. Each 8 bytes:
          //   +0 u8 type=0  +1 u8 length=8  +2 u8 acpi_uid  +3 u8 apic_id
          //   +4 u32 flags=1 (enabled)
          //
          // Pack as a u64: type|length|uid|apic_id in low 4, flags in high 4.
          //   entry 0: uid=0, apic_id=0 -> 0x00000001_00000008
          //   entry 1: uid=1, apic_id=1 -> 0x00000001_01010008
          //   entry 2: uid=2, apic_id=2 -> 0x00000001_02020008
          //   entry 3: uid=3, apic_id=3 -> 0x00000001_03030008
          mov rax, 0x0000000100000008;
          mov [rdi + 44], rax;
          mov rax, 0x0000000101010008;
          mov [rdi + 52], rax;
          mov rax, 0x0000000102020008;
          mov [rdi + 60], rax;
          mov rax, 0x0000000103030008;
          mov [rdi + 68], rax;

          // ---- (d) _synth_mcfg: SIG "MCFG", length 60 (=44 + 16) ----
          //   Not walked by any sup_* — referenced only by the XSDT list
          //   for op=1 enumerate_tables to include in its response.
          lea rdi, [rip + _acpi_witness_synth_mcfg];
          xor rax, rax;
          mov [rdi + 0],   rax;
          mov [rdi + 8],   rax;
          mov [rdi + 16],  rax;
          mov [rdi + 24],  rax;
          mov [rdi + 32],  rax;
          mov [rdi + 40],  rax;
          mov [rdi + 48],  rax;
          mov [rdi + 56],  rax;
          mov [rdi + 64],  rax;
          mov [rdi + 72],  rax;
          mov [rdi + 80],  rax;
          mov [rdi + 88],  rax;
          mov [rdi + 96],  rax;
          mov [rdi + 104], rax;
          mov [rdi + 112], rax;
          mov [rdi + 120], rax;
          mov rax, 0x0000003C4746434D;             // SIG "MCFG", length 60
          mov [rdi + 0], rax;

          // ---- (e) _synth_fadt: SIG "FACP", length 116 (arbitrary; > 44) ----
          lea rdi, [rip + _acpi_witness_synth_fadt];
          xor rax, rax;
          mov [rdi + 0],   rax;
          mov [rdi + 8],   rax;
          mov [rdi + 16],  rax;
          mov [rdi + 24],  rax;
          mov [rdi + 32],  rax;
          mov [rdi + 40],  rax;
          mov [rdi + 48],  rax;
          mov [rdi + 56],  rax;
          mov [rdi + 64],  rax;
          mov [rdi + 72],  rax;
          mov [rdi + 80],  rax;
          mov [rdi + 88],  rax;
          mov [rdi + 96],  rax;
          mov [rdi + 104], rax;
          mov [rdi + 112], rax;
          mov [rdi + 120], rax;
          mov rax, 0x0000007450434146;             // SIG "FACP", length 116
          mov [rdi + 0], rax;

          // ---- (f) _synth_hpet: SIG "HPET", length 56 (=36 + 20) ----
          lea rdi, [rip + _acpi_witness_synth_hpet];
          xor rax, rax;
          mov [rdi + 0],   rax;
          mov [rdi + 8],   rax;
          mov [rdi + 16],  rax;
          mov [rdi + 24],  rax;
          mov [rdi + 32],  rax;
          mov [rdi + 40],  rax;
          mov [rdi + 48],  rax;
          mov [rdi + 56],  rax;
          mov [rdi + 64],  rax;
          mov [rdi + 72],  rax;
          mov [rdi + 80],  rax;
          mov [rdi + 88],  rax;
          mov [rdi + 96],  rax;
          mov [rdi + 104], rax;
          mov [rdi + 112], rax;
          mov [rdi + 120], rax;
          mov rax, 0x0000003854455048;             // SIG "HPET", length 56
          mov [rdi + 0], rax;

          // ---- (g) _synth_segments: one 24-byte MCFG parser record ----
          //   {base_pa=0xE0000000, segment=0, bus_start=0, bus_end=0xFF, pad}
          //   Layout per Mcfg._mcfg_segments format:
          //     +0  u64 base_pa
          //     +8  u16 segment
          //    +10  u8  bus_start
          //    +11  u8  bus_end
          //    +12  u32 _pad
          //    +16  u64 _pad2
          //   Pack as three u64 stores:
          //     word0 = 0x00000000E0000000 (base_pa)
          //     word1 = 0x000000FF_00000000 (bus_end=0xFF at byte 11, rest 0)
          //     word2 = 0 (_pad2)
          lea rdi, [rip + _acpi_witness_synth_segments];
          mov rax, 0x00000000E0000000;
          mov [rdi + 0], rax;
          mov rax, 0x000000FF00000000;             // bus_end=0xFF @ byte 11
          mov [rdi + 8], rax;
          xor rax, rax;
          mov [rdi + 16], rax;

          // ---- (h) _synth_hpet_info: 32-byte hpet_info record ----
          //   {counter_base=0xFED00000, block_id=0x8086A701, min_tick=128,
          //    hpet_number=0, pad, pad2, pad3} per hpet.pdx §L47.
          //   Pack as four u64 stores:
          //     word0 = 0x00000000FED00000  (counter_base_pa)
          //     word1 = 0x0080_00008086A701 (block_id u32 @ +8,
          //                                   min_tick u16 @ +12 = 0x0080=128,
          //                                   hpet_number u8 @ +14 = 0,
          //                                   pad u8 @ +15 = 0)
          //       Actually the byte layout for min_tick=128 stored @ offset 12
          //       as a u16 LE is bytes 12=0x80, 13=0x00. Position within the
          //       word1 u64: byte 12 = shift 32, byte 13 = shift 40, byte 14
          //       = shift 48, byte 15 = shift 56. So min_tick=128 contributes
          //       (0x80 << 32) = 0x00000080_00000000; hpet_number = 0
          //       contributes 0. block_id 0x8086A701 at bytes 8..11 = low 32.
          //       word1 = 0x0000008000000000 | 0x000000008086A701
          //             = 0x000000808086A701
          //     word2, word3 = 0 (reserved)
          lea rdi, [rip + _acpi_witness_synth_hpet_info];
          mov rax, 0x00000000FED00000;
          mov [rdi + 0], rax;
          mov rax, 0x000000808086A701;
          mov [rdi + 8], rax;
          xor rax, rax;
          mov [rdi + 16], rax;
          mov [rdi + 24], rax;

          // ---- (i) Save xsdt_ptr + madt_ptr for the loop ----
          lea rax, [rip + _acpi_witness_synth_xsdt];
          lea rcx, [rip + _acpi_witness_xsdt_ptr];
          mov [rcx], rax;
          lea rax, [rip + _acpi_witness_synth_madt];
          lea rcx, [rip + _acpi_witness_madt_ptr];
          mov [rcx], rax;

          // -- Stage 3: pre-wipe user page 0x7FFFFFFFC000 (4 KiB).
          mov r11, 3;
          lea rcx, [rip + _acpi_witness_stage];
          mov [rcx], r11;

          mov rdi, 0x7FFFFFFFC000;
          lea rsi, [rip + _acpi_witness_zero_scratch];
          mov rdx, 4096;
          call user_write_bytes_via_walk;
          cmp rax, 0;
          jne m4_002_acpi_rpc_witness_fail;

          // -- Stage 4: pre-wipe user page 0x7FFFFFFFD000.
          mov r11, 4;
          lea rcx, [rip + _acpi_witness_stage];
          mov [rcx], r11;

          mov rdi, 0x7FFFFFFFD000;
          lea rsi, [rip + _acpi_witness_zero_scratch];
          mov rdx, 4096;
          call user_write_bytes_via_walk;
          cmp rax, 0;
          jne m4_002_acpi_rpc_witness_fail;

          // -- Stage 5: pre-wipe user page 0x7FFFFFFFE000.
          mov r11, 5;
          lea rcx, [rip + _acpi_witness_stage];
          mov [rcx], r11;

          mov rdi, 0x7FFFFFFFE000;
          lea rsi, [rip + _acpi_witness_zero_scratch];
          mov rdx, 4096;
          call user_write_bytes_via_walk;
          cmp rax, 0;
          jne m4_002_acpi_rpc_witness_fail;

          // -- Stage 6: alloc server_ep.
          mov r11, 6;
          lea rcx, [rip + _acpi_witness_stage];
          mov [rcx], r11;

          call endpoint_alloc;
          mov r10, 0xFFFFFFFFFFFFFFFF;             // ENDPOINT_ALLOC_NONE
          cmp rax, r10;
          je m4_002_acpi_rpc_witness_fail;
          mov rbx, rax;                            // rbx = server_ep

          // -- Stage 7: alloc reply_ep.
          mov r11, 7;
          lea rcx, [rip + _acpi_witness_stage];
          mov [rcx], r11;

          call endpoint_alloc;
          mov r10, 0xFFFFFFFFFFFFFFFF;
          cmp rax, r10;
          je m4_002_acpi_rpc_witness_fail;
          mov r15, rax;                            // r15 = reply_ep
          cmp r15, rbx;
          je m4_002_acpi_rpc_witness_fail;         // must be distinct

          // Init max_delta = 0.
          xor rax, rax;
          lea rcx, [rip + _acpi_witness_max_delta];
          mov [rcx], rax;

          // Init op counter r13 = 1.
          mov r13, 1;

      m4_002_acpi_rpc_op_loop:
          // Loop guard: r13 in {1..4}. Exit when r13 == 5.
          cmp r13, 5;
          jae m4_002_acpi_rpc_ops_done;

          // Sub-stage = 10*r13 + 0 → encode request hdr.
          mov rax, r13;
          shl rax, 3;                              // *8
          mov r10, rax;
          shl rax, 1;                              // *16 already? no — need *10
          mov rax, r13;
          shl rax, 3;                              // *8
          mov r10, rax;
          mov rax, r13;
          shl rax, 1;                              // *2
          add rax, r10;                            // r10 held *8, add *2 -> *10
          lea rcx, [rip + _acpi_witness_stage];
          mov [rcx], rax;

          // frame_encode(_req_hdr_scratch, op=r13, ver=1, flags=r15=reply_ep, len=0)
          lea rdi, [rip + _acpi_witness_req_hdr_scratch];
          mov rsi, r13;                            // op
          mov rdx, 1;                              // ver
          mov rcx, r15;                            // reply_endpoint_id
          xor r8,  r8;                             // payload_len = 0
          call frame_encode;
          cmp rax, 0;
          jne m4_002_acpi_rpc_witness_fail;

          // Sub-stage +1 → publish request hdr to 0x7FFFFFFFC000.
          mov rax, r13;
          shl rax, 3;
          mov r10, rax;
          mov rax, r13;
          shl rax, 1;
          add rax, r10;
          add rax, 1;
          lea rcx, [rip + _acpi_witness_stage];
          mov [rcx], rax;

          mov rdi, 0x7FFFFFFFC000;
          lea rsi, [rip + _acpi_witness_req_hdr_scratch];
          mov rdx, 8;
          call user_write_bytes_via_walk;
          cmp rax, 0;
          jne m4_002_acpi_rpc_witness_fail;

          // Sub-stage +2 → sys_ipc_send_body(server, 0xC000, 0xC008, 0).
          mov rax, r13;
          shl rax, 3;
          mov r10, rax;
          mov rax, r13;
          shl rax, 1;
          add rax, r10;
          add rax, 2;
          lea rcx, [rip + _acpi_witness_stage];
          mov [rcx], rax;

          mov rdi, rbx;                            // id = server_ep
          mov rsi, 0x7FFFFFFFC000;
          mov rdx, 0x7FFFFFFFC008;
          xor rcx, rcx;                            // payload_len = 0
          call sys_ipc_send_body;
          cmp rax, 0;
          jne m4_002_acpi_rpc_witness_fail;

          // Sub-stage +3 → read TSC start.
          mov rax, r13;
          shl rax, 3;
          mov r10, rax;
          mov rax, r13;
          shl rax, 1;
          add rax, r10;
          add rax, 3;
          lea rcx, [rip + _acpi_witness_stage];
          mov [rcx], rax;

          call kread_tsc;                          // rax = TSC start
          lea rcx, [rip + _acpi_witness_tsc_start];
          mov [rcx], rax;

          // Sub-stage +4 → sys_ipc_recv_body (server drain).
          mov rax, r13;
          shl rax, 3;
          mov r10, rax;
          mov rax, r13;
          shl rax, 1;
          add rax, r10;
          add rax, 4;
          lea rcx, [rip + _acpi_witness_stage];
          mov [rcx], rax;

          mov rdi, rbx;                            // id = server_ep
          mov rsi, 0x7FFFFFFFC020;                 // server drain hdr sink
          mov rdx, 0x7FFFFFFFC028;                 // server drain payload sink
          mov rcx, 4088;
          call sys_ipc_recv_body;
          cmp rax, 0;                              // expected payload_len = 0
          jne m4_002_acpi_rpc_witness_fail;

          // Sub-stage +5 → kernel dispatch on op (r13).
          mov rax, r13;
          shl rax, 3;
          mov r10, rax;
          mov rax, r13;
          shl rax, 1;
          add rax, r10;
          add rax, 5;
          lea rcx, [rip + _acpi_witness_stage];
          mov [rcx], rax;

          cmp r13, 1;
          je m4_002_dispatch_enum;
          cmp r13, 2;
          je m4_002_dispatch_madt;
          cmp r13, 3;
          je m4_002_dispatch_mcfg;
          cmp r13, 4;
          je m4_002_dispatch_hpet;
          jmp m4_002_acpi_rpc_witness_fail;        // unknown op — bug

      m4_002_dispatch_enum:
          // sup_enumerate_tables(xsdt, kbuf, 4088)
          mov rdi, [rip + _acpi_witness_xsdt_ptr];
          lea rsi, [rip + _acpi_witness_reply_payload_kbuf];
          mov rdx, 4088;
          call sup_enumerate_tables;
          jmp m4_002_dispatch_saved;

      m4_002_dispatch_madt:
          // sup_get_madt_lapic_list(madt, kbuf, 4088)
          mov rdi, [rip + _acpi_witness_madt_ptr];
          lea rsi, [rip + _acpi_witness_reply_payload_kbuf];
          mov rdx, 4088;
          call sup_get_madt_lapic_list;
          jmp m4_002_dispatch_saved;

      m4_002_dispatch_mcfg:
          // sup_get_mcfg_ranges(segments_ptr=&_acpi_witness_synth_segments,
          //                     count=1, kbuf, 4088)
          lea rdi, [rip + _acpi_witness_synth_segments];
          mov rsi, 1;                              // synthetic: 1 segment
          lea rdx, [rip + _acpi_witness_reply_payload_kbuf];
          mov rcx, 4088;
          call sup_get_mcfg_ranges;
          jmp m4_002_dispatch_saved;

      m4_002_dispatch_hpet:
          // sup_get_hpet(&_acpi_witness_synth_hpet_info, kbuf, 4088)
          lea rdi, [rip + _acpi_witness_synth_hpet_info];
          lea rsi, [rip + _acpi_witness_reply_payload_kbuf];
          mov rdx, 4088;
          call sup_get_hpet;

      m4_002_dispatch_saved:
          // rax = reply payload_len (bytes written by the sup_* helper).
          lea rcx, [rip + _acpi_witness_reply_len];
          mov [rcx], rax;

          // Sub-stage +6 → encode reply hdr with op|0x80 + reply_len.
          mov rax, r13;
          shl rax, 3;
          mov r10, rax;
          mov rax, r13;
          shl rax, 1;
          add rax, r10;
          add rax, 6;
          lea rcx, [rip + _acpi_witness_stage];
          mov [rcx], rax;

          lea rdi, [rip + _acpi_witness_reply_hdr_scratch];
          mov rsi, r13;
          or  rsi, 0x80;                           // op | FRAME_OP_REPLY_BIT
          mov rdx, 1;                              // ver
          mov rcx, r15;                            // reply_endpoint_id
          mov r8, [rip + _acpi_witness_reply_len]; // payload_len
          call frame_encode;
          cmp rax, 0;
          jne m4_002_acpi_rpc_witness_fail;

          // Sub-stage +7 → publish reply hdr + payload to 0xD000.
          mov rax, r13;
          shl rax, 3;
          mov r10, rax;
          mov rax, r13;
          shl rax, 1;
          add rax, r10;
          add rax, 7;
          lea rcx, [rip + _acpi_witness_stage];
          mov [rcx], rax;

          mov rdi, 0x7FFFFFFFD000;
          lea rsi, [rip + _acpi_witness_reply_hdr_scratch];
          mov rdx, 8;
          call user_write_bytes_via_walk;
          cmp rax, 0;
          jne m4_002_acpi_rpc_witness_fail;

          mov rdi, 0x7FFFFFFFD008;
          lea rsi, [rip + _acpi_witness_reply_payload_kbuf];
          mov rdx, [rip + _acpi_witness_reply_len];
          call user_write_bytes_via_walk;
          cmp rax, 0;
          jne m4_002_acpi_rpc_witness_fail;

          // Sub-stage +8 → sys_ipc_reply_body (server → reply_ep via dual-ep).
          mov rax, r13;
          shl rax, 3;
          mov r10, rax;
          mov rax, r13;
          shl rax, 1;
          add rax, r10;
          add rax, 8;
          lea rcx, [rip + _acpi_witness_stage];
          mov [rcx], rax;

          mov rdi, rbx;                            // id = server_ep
          mov rsi, 0x7FFFFFFFD000;
          mov rdx, 0x7FFFFFFFD008;
          mov rcx, [rip + _acpi_witness_reply_len];
          call sys_ipc_reply_body;
          cmp rax, 0;
          jne m4_002_acpi_rpc_witness_fail;

          // Sub-stage +9 → client drain from reply_ep + TSC end + verify.
          mov rax, r13;
          shl rax, 3;
          mov r10, rax;
          mov rax, r13;
          shl rax, 1;
          add rax, r10;
          add rax, 9;
          lea rcx, [rip + _acpi_witness_stage];
          mov [rcx], rax;

          mov rdi, r15;                            // id = reply_ep
          mov rsi, 0x7FFFFFFFE000;
          mov rdx, 0x7FFFFFFFE008;
          mov rcx, 4088;
          call sys_ipc_recv_body;

          // rax = payload_len returned; verify matches _reply_len.
          mov r10, [rip + _acpi_witness_reply_len];
          cmp rax, r10;
          jne m4_002_acpi_rpc_witness_fail;

          // Read TSC end + compute delta.
          call kread_tsc;
          mov r10, [rip + _acpi_witness_tsc_start];
          sub rax, r10;                            // rax = TSC delta
          // Update max_delta if larger.
          mov r10, [rip + _acpi_witness_max_delta];
          cmp rax, r10;
          jbe m4_002_delta_no_update;
          lea rcx, [rip + _acpi_witness_max_delta];
          mov [rcx], rax;
      m4_002_delta_no_update:

          // Verify reply hdr op == r13 | 0x80.
          lea rdi, [rip + _acpi_witness_verify_scratch];
          mov rsi, 0x7FFFFFFFE000;
          mov rdx, 8;
          call user_read_bytes_via_walk;
          cmp rax, 0;
          jne m4_002_acpi_rpc_witness_fail;

          lea r10, [rip + _acpi_witness_verify_scratch];
          mov rax, [r10];                          // received reply hdr u64
          and rax, 0xFF;                           // op byte
          mov r10, r13;
          or  r10, 0x80;                           // expected op | 0x80
          cmp rax, r10;
          jne m4_002_acpi_rpc_witness_fail;

          // Op=1 extra check: verify n_tables (u16 @ payload+0) >= 4.
          cmp r13, 1;
          jne m4_002_op_extra_done;

          lea rdi, [rip + _acpi_witness_verify_scratch];
          mov rsi, 0x7FFFFFFFE008;
          mov rdx, 2;
          call user_read_bytes_via_walk;
          cmp rax, 0;
          jne m4_002_acpi_rpc_witness_fail;

          lea r10, [rip + _acpi_witness_verify_scratch];
          xor rax, rax;
          mov_w rax, [r10];                        // rax = n_tables (u16)
          cmp rax, 4;
          jb m4_002_acpi_rpc_witness_fail;

      m4_002_op_extra_done:
          // Next op.
          add r13, 1;
          jmp m4_002_acpi_rpc_op_loop;

      m4_002_acpi_rpc_ops_done:
          // Cleanup — free both endpoints.
          mov r11, 90;
          lea rcx, [rip + _acpi_witness_stage];
          mov [rcx], r11;

          mov rdi, rbx;
          call endpoint_free;
          mov rdi, r15;
          call endpoint_free;

          // TSC delta gate: max_delta must be < 2M ticks (~1 ms @ 2 GHz TSC).
          // The AC threshold — comfortable margin above the substrate's
          // ~30 k-tick expected roundtrip cost (see witness storage
          // comment). Under QEMU TCG the TSC reflects host time; a value
          // above 2 M means either the sup_* dispatch spinlooped or the
          // walker degraded catastrophically — both are substrate bugs
          // worth failing on.
          mov r11, 91;
          lea rcx, [rip + _acpi_witness_stage];
          mov [rcx], r11;

          mov rax, [rip + _acpi_witness_max_delta];
          mov r10, 2000000;                        // ACPI_RPC_TSC_MAX
          cmp rax, r10;
          ja m4_002_acpi_rpc_witness_fail;

          // Success marker: "R20b ACPI RPC OK".
          mov rdi, 3;                              // LEVEL_INFO
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + acpi_rpc_ok_msg];
          call klog_s1;
          jmp m4_002_acpi_rpc_witness_done;

      m4_002_acpi_rpc_witness_fail:
          // Emit "R20b ACPI RPC FAIL" with the stage as a decimal KV.
          lea rax, [rip + _acpi_witness_stage];
          mov r8, [rax];                           // r8 = stage
          mov rdi, 1;                              // LEVEL_ERROR
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + acpi_rpc_fail_msg];
          lea rcx, [rip + k_line];                 // reuse "line" key
          call klog_s1_d1;

      m4_002_acpi_rpc_witness_done:
          pop r15;
          pop r13;
          pop rbx;

      // ============================================================
      // R22-M3-005 (#860): PCI enumerator RPC witness — closes #860.
      //
      // Discharges #860's acceptance criteria (userspace pci_enumerator
      // server — walks tree via KIND_DEVICE caps) via the "Option B —
      // kernel-side witness driving the RPC" posture, matching R20b.M5-001,
      // R20b.M6-003, and R20-M4-002 discipline. The pci_enumerator
      // userspace binary at src/user/pci_enumerator.pdx exists as the
      // target shape; the actual ring-3 spawn wires up post-R22 when
      // multi-task boot orchestration lands (per §4.4 Deferred paragraph
      // of design/ipc/userspace-server-substrate.md).
      //
      // Witness structure
      // -----------------
      // Runs after m4_002_acpi_rpc_witness_done + before sti /
      // enter_userland_initial. Uses init's user_pml4 as the "user"
      // address space (same as M5/M6/M4-002). Loops op ∈ {1, 2, 3}
      // through the full IPC round-trip:
      //
      //   Stages per iteration (recorded in _pci_witness_stage):
      //     10..19   op=1 PCI_OP_LIST_DEVICES
      //     20..29   op=2 PCI_OP_DEVICE_INFO
      //     30..39   op=3 PCI_OP_GET_BAR_CAP
      //
      // Sub-stage semantic within each op iter (offset from 10*op):
      //   +0  encode request hdr (frame_encode)
      //   +1  publish request hdr to user page 0xC000 (walker write)
      //   +2  sys_ipc_send_body (client → server_ep, len=0)
      //   +3  read TSC start (rdtsc)
      //   +4  sys_ipc_recv_body (server drain @ server_ep)
      //   +5  kernel dispatch — call pci_enum_* helper into
      //         _pci_witness_reply_payload_kbuf
      //   +6  encode reply hdr with reply-bit + reply_len
      //   +7  publish reply hdr + payload to user page 0xD000 (walker write)
      //   +8  sys_ipc_reply_body (server → reply_ep via dual-endpoint routing)
      //   +9  sys_ipc_recv_body (client drain @ reply_ep) + read TSC end
      //         + verify hdr op | 0x80 + payload_len match + update max_delta
      //
      // Op=1 gets an additional sub-check: verify n_devices (u16 @
      // payload+0) >= 4 (synthesized fixture publishes 4 records).
      // Op=2 verifies payload_len == 64. Op=3 verifies payload_len == 40.
      //
      // Fixture synthesis
      // -----------------
      // Under BIOS/`-kernel` boot on QEMU q35 the MCFG is absent (see
      // r22m1_mcfg_absent path above), so pci_enumerate_all short-
      // circuits with _pci_device_count=0 and _pci_devices left
      // uninitialized. The witness synthesizes a 4-entry q35-shaped
      // device tree directly in _pci_devices before the dispatch loop:
      //   record[0] = host bridge  (0,0,0)  vendor=0x8086 device=0x29C0 class=0x0600
      //   record[1] = VGA           (0,1,0)  vendor=0x1234 device=0x1111 class=0x0300
      //   record[2] = ISA bridge    (0,1F,0) vendor=0x8086 device=0x29C1 class=0x0601
      //   record[3] = AHCI          (0,1F,2) vendor=0x8086 device=0x2922 class=0x0106
      // Then sets _pci_device_count=4. The synthesis writes only records
      // and count — cap_handle (record+16) and _reserved (record+24)
      // stay zero (pci_publish_caps already ran at boot with count=0, so
      // its scaffolding mint results are irrelevant for the synthetic
      // records — get_bar_cap returns cap_handle=0 as designed).
      //
      // Op=2/op=3 use bdf=0xFA (bus=0, dev=0x1F, fn=2 = record 3 AHCI)
      // as the query key to exercise the linear-scan branch (not just
      // the first record).
      //
      // Register plan (mirrors the ACPI witness §L13472 shape)
      // ------------------------------------------------------
      //   rbx = server_ep (SysV callee-save)
      //   r13 = current op (1..3)
      //   r15 = reply_ep  (SysV callee-save)
      // r12/r14 hold the loader's init boot state (task_slab / entry_rip
      // / user_rsp_top) — MUST NOT be touched; enter_userland_initial
      // reads them post-witness. 3-push discipline: rbx/r13/r15.
      // Entry rsp %16 == 0 (m4_002_acpi_rpc_witness_done pop chain
      // restored the outer alignment); 3 pushes = 24 B → rsp %16 == 8;
      // then 0-align pad (no sub rsp,8 needed here — nested-call
      // alignment is handled per-call by the same discipline as the
      // ACPI witness).
      // ============================================================
      m3_005_pci_rpc_witness:
          push rbx;
          push r13;
          push r15;

          // -- Stage 1: synthesize _pci_devices fixture. --
          mov r11, 1;
          lea rcx, [rip + _pci_witness_stage];
          mov [rcx], r11;

          // record[0] host bridge (0,0,0) vendor=0x8086 device=0x29C0
          //   class_code=0x06 subclass=0x00 -> word0 bytes [00,00,00,00,00,00,06,00]
          //   word1 bytes [86,80,C0,29,00,00,00,00]
          lea rdi, [rip + _pci_devices];
          mov rax, 0x0006000000000000;
          mov [rdi + 0], rax;
          mov rax, 0x0000000029C08086;
          mov [rdi + 8], rax;
          xor rax, rax;
          mov [rdi + 16], rax;                     // cap_handle=0
          mov [rdi + 24], rax;                     // _reserved=0

          // record[1] VGA (0,1,0) vendor=0x1234 device=0x1111
          //   class_code=0x03 subclass=0x00 -> word0 bytes [00,00,00,01,00,00,03,00]
          //   word1 bytes [34,12,11,11,00,00,00,00]
          mov rax, 0x0003000000010000;
          mov [rdi + 32],  rax;
          mov rax, 0x0000000011111234;
          mov [rdi + 40],  rax;
          xor rax, rax;
          mov [rdi + 48],  rax;
          mov [rdi + 56],  rax;

          // record[2] ISA bridge (0,1F,0) vendor=0x8086 device=0x29C1
          //   class_code=0x06 subclass=0x01 -> word0 bytes [00,00,00,1F,00,00,06,01]
          //   word1 bytes [86,80,C1,29,00,00,00,00]
          mov rax, 0x010600001F000000;
          mov [rdi + 64],  rax;
          mov rax, 0x0000000029C18086;
          mov [rdi + 72],  rax;
          xor rax, rax;
          mov [rdi + 80],  rax;
          mov [rdi + 88],  rax;

          // record[3] AHCI (0,1F,2) vendor=0x8086 device=0x2922
          //   class_code=0x01 subclass=0x06 -> word0 bytes [00,00,00,1F,02,00,01,06]
          //   word1 bytes [86,80,22,29,00,00,00,00]
          mov rax, 0x060100021F000000;
          mov [rdi + 96],  rax;
          mov rax, 0x0000000029228086;
          mov [rdi + 104], rax;
          xor rax, rax;
          mov [rdi + 112], rax;
          mov [rdi + 120], rax;

          // Set _pci_device_count = 4.
          mov rax, 4;
          mov [rip + _pci_device_count], rax;

          // -- Stage 2: pre-wipe user page 0x7FFFFFFFC000 (4 KiB). --
          mov r11, 2;
          lea rcx, [rip + _pci_witness_stage];
          mov [rcx], r11;

          mov rdi, 0x7FFFFFFFC000;
          lea rsi, [rip + _pci_witness_zero_scratch];
          mov rdx, 4096;
          call user_write_bytes_via_walk;
          cmp rax, 0;
          jne m3_005_pci_rpc_witness_fail;

          // -- Stage 3: pre-wipe user page 0x7FFFFFFFD000. --
          mov r11, 3;
          lea rcx, [rip + _pci_witness_stage];
          mov [rcx], r11;

          mov rdi, 0x7FFFFFFFD000;
          lea rsi, [rip + _pci_witness_zero_scratch];
          mov rdx, 4096;
          call user_write_bytes_via_walk;
          cmp rax, 0;
          jne m3_005_pci_rpc_witness_fail;

          // -- Stage 4: pre-wipe user page 0x7FFFFFFFE000. --
          mov r11, 4;
          lea rcx, [rip + _pci_witness_stage];
          mov [rcx], r11;

          mov rdi, 0x7FFFFFFFE000;
          lea rsi, [rip + _pci_witness_zero_scratch];
          mov rdx, 4096;
          call user_write_bytes_via_walk;
          cmp rax, 0;
          jne m3_005_pci_rpc_witness_fail;

          // -- Stage 5: alloc server_ep. --
          mov r11, 5;
          lea rcx, [rip + _pci_witness_stage];
          mov [rcx], r11;

          call endpoint_alloc;
          mov r10, 0xFFFFFFFFFFFFFFFF;             // ENDPOINT_ALLOC_NONE
          cmp rax, r10;
          je m3_005_pci_rpc_witness_fail;
          mov rbx, rax;                            // rbx = server_ep

          // -- Stage 6: alloc reply_ep. --
          mov r11, 6;
          lea rcx, [rip + _pci_witness_stage];
          mov [rcx], r11;

          call endpoint_alloc;
          mov r10, 0xFFFFFFFFFFFFFFFF;
          cmp rax, r10;
          je m3_005_pci_rpc_witness_fail;
          mov r15, rax;                            // r15 = reply_ep
          cmp r15, rbx;
          je m3_005_pci_rpc_witness_fail;          // must be distinct

          // Init max_delta = 0.
          xor rax, rax;
          lea rcx, [rip + _pci_witness_max_delta];
          mov [rcx], rax;

          // Init op counter r13 = 1.
          mov r13, 1;

      m3_005_pci_rpc_op_loop:
          // Loop guard: r13 in {1..3}. Exit when r13 == 4.
          cmp r13, 4;
          jae m3_005_pci_rpc_ops_done;

          // Sub-stage = 10*r13 + 0 → encode request hdr.
          mov rax, r13;
          shl rax, 3;                              // *8
          mov r10, rax;
          mov rax, r13;
          shl rax, 1;                              // *2
          add rax, r10;                            // r10*8 + *2 = *10
          lea rcx, [rip + _pci_witness_stage];
          mov [rcx], rax;

          // frame_encode(_req_hdr_scratch, op=r13, ver=1, reply_ep=r15, len=0)
          lea rdi, [rip + _pci_witness_req_hdr_scratch];
          mov rsi, r13;                            // op
          mov rdx, 1;                              // ver
          mov rcx, r15;                            // reply_endpoint_id
          xor r8,  r8;                             // payload_len = 0
          call frame_encode;
          cmp rax, 0;
          jne m3_005_pci_rpc_witness_fail;

          // Sub-stage +1 → publish request hdr to 0x7FFFFFFFC000.
          mov rax, r13;
          shl rax, 3;
          mov r10, rax;
          mov rax, r13;
          shl rax, 1;
          add rax, r10;
          add rax, 1;
          lea rcx, [rip + _pci_witness_stage];
          mov [rcx], rax;

          mov rdi, 0x7FFFFFFFC000;
          lea rsi, [rip + _pci_witness_req_hdr_scratch];
          mov rdx, 8;
          call user_write_bytes_via_walk;
          cmp rax, 0;
          jne m3_005_pci_rpc_witness_fail;

          // Sub-stage +2 → sys_ipc_send_body(server, 0xC000, 0xC008, 0).
          mov rax, r13;
          shl rax, 3;
          mov r10, rax;
          mov rax, r13;
          shl rax, 1;
          add rax, r10;
          add rax, 2;
          lea rcx, [rip + _pci_witness_stage];
          mov [rcx], rax;

          mov rdi, rbx;                            // id = server_ep
          mov rsi, 0x7FFFFFFFC000;
          mov rdx, 0x7FFFFFFFC008;
          xor rcx, rcx;                            // payload_len = 0
          call sys_ipc_send_body;
          cmp rax, 0;
          jne m3_005_pci_rpc_witness_fail;

          // Sub-stage +3 → read TSC start.
          mov rax, r13;
          shl rax, 3;
          mov r10, rax;
          mov rax, r13;
          shl rax, 1;
          add rax, r10;
          add rax, 3;
          lea rcx, [rip + _pci_witness_stage];
          mov [rcx], rax;

          call kread_tsc;
          lea rcx, [rip + _pci_witness_tsc_start];
          mov [rcx], rax;

          // Sub-stage +4 → sys_ipc_recv_body (server drain).
          mov rax, r13;
          shl rax, 3;
          mov r10, rax;
          mov rax, r13;
          shl rax, 1;
          add rax, r10;
          add rax, 4;
          lea rcx, [rip + _pci_witness_stage];
          mov [rcx], rax;

          mov rdi, rbx;                            // id = server_ep
          mov rsi, 0x7FFFFFFFC020;                 // server drain hdr sink
          mov rdx, 0x7FFFFFFFC028;                 // server drain payload sink
          mov rcx, 4088;
          call sys_ipc_recv_body;
          cmp rax, 0;                              // expected payload_len = 0
          jne m3_005_pci_rpc_witness_fail;

          // Sub-stage +5 → kernel dispatch on op (r13).
          mov rax, r13;
          shl rax, 3;
          mov r10, rax;
          mov rax, r13;
          shl rax, 1;
          add rax, r10;
          add rax, 5;
          lea rcx, [rip + _pci_witness_stage];
          mov [rcx], rax;

          cmp r13, 1;
          je m3_005_dispatch_list;
          cmp r13, 2;
          je m3_005_dispatch_info;
          cmp r13, 3;
          je m3_005_dispatch_bar;
          jmp m3_005_pci_rpc_witness_fail;         // unknown op — bug

      m3_005_dispatch_list:
          // pci_enum_list_devices(kbuf, 4088)
          lea rdi, [rip + _pci_witness_reply_payload_kbuf];
          mov rsi, 4088;
          call pci_enum_list_devices;
          jmp m3_005_dispatch_saved;

      m3_005_dispatch_info:
          // pci_enum_device_info(bdf=0xFA, kbuf, 4088)
          mov rdi, 0xFA;                           // AHCI (0,1F,2) bdf_key
          lea rsi, [rip + _pci_witness_reply_payload_kbuf];
          mov rdx, 4088;
          call pci_enum_device_info;
          jmp m3_005_dispatch_saved;

      m3_005_dispatch_bar:
          // pci_enum_get_bar_cap(bdf=0xFA, idx=0, kbuf, 4088)
          mov rdi, 0xFA;
          mov rsi, 0;                              // BAR 0
          lea rdx, [rip + _pci_witness_reply_payload_kbuf];
          mov rcx, 4088;
          call pci_enum_get_bar_cap;

      m3_005_dispatch_saved:
          // rax = reply payload_len (bytes written by the pci_enum_* helper).
          lea rcx, [rip + _pci_witness_reply_len];
          mov [rcx], rax;

          // Sub-stage +6 → encode reply hdr with op|0x80 + reply_len.
          mov rax, r13;
          shl rax, 3;
          mov r10, rax;
          mov rax, r13;
          shl rax, 1;
          add rax, r10;
          add rax, 6;
          lea rcx, [rip + _pci_witness_stage];
          mov [rcx], rax;

          lea rdi, [rip + _pci_witness_reply_hdr_scratch];
          mov rsi, r13;
          or  rsi, 0x80;                           // op | FRAME_OP_REPLY_BIT
          mov rdx, 1;                              // ver
          mov rcx, r15;                            // reply_endpoint_id
          mov r8, [rip + _pci_witness_reply_len];  // payload_len
          call frame_encode;
          cmp rax, 0;
          jne m3_005_pci_rpc_witness_fail;

          // Sub-stage +7 → publish reply hdr + payload to 0xD000.
          mov rax, r13;
          shl rax, 3;
          mov r10, rax;
          mov rax, r13;
          shl rax, 1;
          add rax, r10;
          add rax, 7;
          lea rcx, [rip + _pci_witness_stage];
          mov [rcx], rax;

          mov rdi, 0x7FFFFFFFD000;
          lea rsi, [rip + _pci_witness_reply_hdr_scratch];
          mov rdx, 8;
          call user_write_bytes_via_walk;
          cmp rax, 0;
          jne m3_005_pci_rpc_witness_fail;

          mov rdi, 0x7FFFFFFFD008;
          lea rsi, [rip + _pci_witness_reply_payload_kbuf];
          mov rdx, [rip + _pci_witness_reply_len];
          call user_write_bytes_via_walk;
          cmp rax, 0;
          jne m3_005_pci_rpc_witness_fail;

          // Sub-stage +8 → sys_ipc_reply_body (server → reply_ep via dual-ep).
          mov rax, r13;
          shl rax, 3;
          mov r10, rax;
          mov rax, r13;
          shl rax, 1;
          add rax, r10;
          add rax, 8;
          lea rcx, [rip + _pci_witness_stage];
          mov [rcx], rax;

          mov rdi, rbx;                            // id = server_ep
          mov rsi, 0x7FFFFFFFD000;
          mov rdx, 0x7FFFFFFFD008;
          mov rcx, [rip + _pci_witness_reply_len];
          call sys_ipc_reply_body;
          cmp rax, 0;
          jne m3_005_pci_rpc_witness_fail;

          // Sub-stage +9 → client drain from reply_ep + TSC end + verify.
          mov rax, r13;
          shl rax, 3;
          mov r10, rax;
          mov rax, r13;
          shl rax, 1;
          add rax, r10;
          add rax, 9;
          lea rcx, [rip + _pci_witness_stage];
          mov [rcx], rax;

          mov rdi, r15;                            // id = reply_ep
          mov rsi, 0x7FFFFFFFE000;
          mov rdx, 0x7FFFFFFFE008;
          mov rcx, 4088;
          call sys_ipc_recv_body;

          // rax = payload_len returned; verify matches _reply_len.
          mov r10, [rip + _pci_witness_reply_len];
          cmp rax, r10;
          jne m3_005_pci_rpc_witness_fail;

          // Read TSC end + compute delta.
          call kread_tsc;
          mov r10, [rip + _pci_witness_tsc_start];
          sub rax, r10;                            // rax = TSC delta
          mov r10, [rip + _pci_witness_max_delta];
          cmp rax, r10;
          jbe m3_005_delta_no_update;
          lea rcx, [rip + _pci_witness_max_delta];
          mov [rcx], rax;
      m3_005_delta_no_update:

          // Verify reply hdr op == r13 | 0x80.
          lea rdi, [rip + _pci_witness_verify_scratch];
          mov rsi, 0x7FFFFFFFE000;
          mov rdx, 8;
          call user_read_bytes_via_walk;
          cmp rax, 0;
          jne m3_005_pci_rpc_witness_fail;

          lea r10, [rip + _pci_witness_verify_scratch];
          mov rax, [r10];                          // received reply hdr u64
          and rax, 0xFF;                           // op byte
          mov r10, r13;
          or  r10, 0x80;                           // expected op | 0x80
          cmp rax, r10;
          jne m3_005_pci_rpc_witness_fail;

          // Per-op payload-length + content sanity checks.
          cmp r13, 1;
          je m3_005_op1_check;
          cmp r13, 2;
          je m3_005_op2_check;
          cmp r13, 3;
          je m3_005_op3_check;
          jmp m3_005_op_extra_done;

      m3_005_op1_check:
          // Op=1 list_devices: verify n_devices (u16 @ payload+0) >= 4.
          lea rdi, [rip + _pci_witness_verify_scratch];
          mov rsi, 0x7FFFFFFFE008;
          mov rdx, 2;
          call user_read_bytes_via_walk;
          cmp rax, 0;
          jne m3_005_pci_rpc_witness_fail;

          lea r10, [rip + _pci_witness_verify_scratch];
          xor rax, rax;
          mov_w rax, [r10];                        // rax = n_devices (u16)
          cmp rax, 4;
          jb m3_005_pci_rpc_witness_fail;
          jmp m3_005_op_extra_done;

      m3_005_op2_check:
          // Op=2 device_info: verify _pci_witness_reply_len == 64.
          mov rax, [rip + _pci_witness_reply_len];
          cmp rax, 64;
          jne m3_005_pci_rpc_witness_fail;
          jmp m3_005_op_extra_done;

      m3_005_op3_check:
          // Op=3 get_bar_cap: verify _pci_witness_reply_len == 40.
          mov rax, [rip + _pci_witness_reply_len];
          cmp rax, 40;
          jne m3_005_pci_rpc_witness_fail;

      m3_005_op_extra_done:
          // Next op.
          add r13, 1;
          jmp m3_005_pci_rpc_op_loop;

      m3_005_pci_rpc_ops_done:
          // Cleanup — free both endpoints.
          mov r11, 90;
          lea rcx, [rip + _pci_witness_stage];
          mov [rcx], r11;

          mov rdi, rbx;
          call endpoint_free;
          mov rdi, r15;
          call endpoint_free;

          // TSC delta gate: max_delta must be < 2M ticks (~1 ms @ 2 GHz TSC).
          // Same threshold as the ACPI witness — comfortable margin above
          // the substrate's ~30 k-tick expected roundtrip cost. Above 2 M
          // means either the pci_enum_* dispatch spinlooped or the walker
          // degraded catastrophically — both are substrate bugs worth
          // failing on.
          mov r11, 91;
          lea rcx, [rip + _pci_witness_stage];
          mov [rcx], r11;

          mov rax, [rip + _pci_witness_max_delta];
          mov r10, 2000000;                        // PCI_RPC_TSC_MAX
          cmp rax, r10;
          ja m3_005_pci_rpc_witness_fail;

          // Success marker: "R20b PCI RPC OK".
          mov rdi, 3;                              // LEVEL_INFO
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + pci_rpc_ok_msg];
          call klog_s1;
          jmp m3_005_pci_rpc_witness_done;

      m3_005_pci_rpc_witness_fail:
          // Emit "R20b PCI RPC FAIL" with the stage as a decimal KV.
          lea rax, [rip + _pci_witness_stage];
          mov r8, [rax];                           // r8 = stage
          mov rdi, 1;                              // LEVEL_ERROR
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + pci_rpc_fail_msg];
          lea rcx, [rip + k_line];                 // reuse "line" key
          call klog_s1_d1;

      m3_005_pci_rpc_witness_done:
          pop r15;
          pop r13;
          pop rbx;


      pop rbp;
      ret
    }
  }
}
