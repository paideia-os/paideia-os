// src/kernel/boot/witness/r91_nic_probe.pdx -- R91.M5-003 (paideia-os
// #2031)
//
// Boot-time witness that reads _active_nic_kind (populated by nic_
// dispatch_probe at boot, R91.M5-001 wiring), and — when a NIC was
// found — asks the dispatch shim's MAC + LINK routers for the active
// NIC's identity, emitting a rollup fingerprint that carries the
// tuple (kind, mac, link) on the boot serial. Kind=0 (no NIC) emits
// a distinct one-KV line so the "no NIC attached" boot mode (opt-in
// PAIDEIA_NIC=none) still leaves an assertable witness in the log.
//
// =============================================================================
// SECTION 0  WHY A DEDICATED PROBE-VERIFICATION WITNESS
// =============================================================================
//
// nic_dispatch_probe already emits `nic dispatch probe ok ... kind=<n>`
// from its own nd_pb_emit tail (R91.M2-001), and every backend driver
// (e1000e, virtio-net, rtl8139) emits its own count / activation
// fingerprints from inside its probe body. The gap this witness closes
// is CROSS-DRIVER READBACK VIA THE DISPATCH ROUTER: today's boot log
// carries per-driver evidence that each of e1000e_probe / virtio_net_
// probe / rtl8139_probe ran, but no boot log line goes back through
// nic_dispatch_mac / nic_dispatch_link over `_active_nic_kind` to
// prove the router's OWN cmp/je chain resolves to the same driver the
// probe just landed on. A silent regression in nic_dispatch.pdx (e.g.
// a wrong compare immediate, a swapped arm label) would leave every
// per-driver line intact but return NIC_ENOSYS from the router at
// steady state — and no default-boot fingerprint would notice.
//
// This witness closes that gap: it asks the router for MAC and LINK,
// and its own fingerprint's presence is proof that the router agreed
// with the probe on which arm to take.
//
// =============================================================================
// SECTION 1  FINGERPRINT SHAPES
// =============================================================================
//
// kind == 0 (no NIC attached — PAIDEIA_NIC=none boot):
//   "boot r91 nic probe ok kind=0"  via klog_s1_d1
//
// kind != 0 (some NIC found and the router agrees):
//   "boot r91 nic probe ok kind=<n> mac=<packed-mac> link_up=<0|1>"
//   via klog_s1_d3 (three decimal KVs; MAC as decimal matches the
//   sibling per-driver `virtio-net mac ok mac=<n>` / `rtl8139 mac ok
//   mac=<n>` emit convention).
//
// Both shapes carry the lowercase "ok" token deliberately — no
// bracketed "[legacy: ... OK]" suffix — so verify-fingerprint-
// coverage.sh's OK_TOK extractor does not require golden coverage
// or an allowlist entry for either literal (same posture as r91_
// kind_nic.pdx's `boot nic ok --` line).
//
// =============================================================================
// SECTION 2  PLACEMENT
// =============================================================================
//
// kernel_main.pdx cascade: immediately after the R91.M5-001 post-
// probe attach step (r91_attach_done label). At that point both the
// probe AND every per-driver activation have run, so nic_dispatch_
// mac / nic_dispatch_link can return live values on every non-empty
// arm.
//
// =============================================================================
// SECTION 3  ENCODER + LABEL DISCIPLINE
// =============================================================================
//
// 5-push callee-save prologue (rbx, r12-r15) leaves rsp%16 == 0 for
// every nested SysV call. r12 holds `kind` across the mac/link calls
// (both are caller-save clobber of rax); r13 holds `mac`; r14 holds
// `link`. No `add reg, [mem]`, no `cmp reg, [mem]`, every value in a
// register before use. Labels prefixed `r91np_` (R91 nic probe --
// avoids the reserved keywords `loop`, `if`, `next`).
//
// The klog_s1_d3 call needs 3 stack-passed args (v2, k3, v3) staged
// after a compensating `sub rsp, 8` pad because the 5-push prologue
// left rsp%16 == 0 and a 3-push sequence would flip it to 8 — the
// pad restores rsp%16 == 0 before klog_s1_d3's own prologue push.
// Matches the same alignment posture as e.g. drivers/nvme/identify_
// ns.pdx's own klog_s1_x3 call sites.

module R91NicProbe = structure {

  pub let tag_boot_r91_nic_probe_ok : [u8; 22] = "boot r91 nic probe ok\0"

  // witness_r91_nic_probe() -> ()
  pub let witness_r91_nic_probe : () -> () !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R91.M5-003 (paideia-os #2031). Cross-driver readback witness for the R91.M5-001 dispatch cascade. Body: (1) 5-push callee-save (rbx, r12-r15) = 40 B; entry rsp%16==8 -> 48, %16==0 (aligned for every nested SysV call without extra pad). (2) Read _active_nic_kind via nic_dispatch_active_kind (r12 = kind). (3) If kind == 0: emit `boot r91 nic probe ok kind=0` via klog_s1_d1(LEVEL_INFO=3, SUBSYS_BOOT, tag_boot_r91_nic_probe_ok, k_kind, 0) and return -- this is the PAIDEIA_NIC=none path, still assertable. (4) Otherwise: call nic_dispatch_mac(kind, 0) -> rax = packed MAC (upper 16 bits zero per kind_nic mac_word contract); stash in r13. call nic_dispatch_link(kind) -> rax = 0 or 1; stash in r14. (5) Stage klog_s1_d3's stack args (v2=r13/mac, k3=&k_link, v3=r14/link) behind a `sub rsp,8` pad so the 3-push (odd count) sequence keeps rsp%16==0 for the call. Register args: rdi=3 (LEVEL_INFO), rsi=&SUBSYS_BOOT, rdx=&tag_boot_r91_nic_probe_ok, rcx=&k_kind, r8=r12 (v1=kind), r9=&k_mac. (6) `add rsp, 32` pops 3 pushes + pad. (7) Teardown pop the 5 callee-save regs, ret. Register discipline: r12/r13/r14 all callee-save and survive both nic_dispatch_mac and nic_dispatch_link (both preserve r12-r15 per SysV). Encoder discipline: cmp reg, imm and cmp reg, reg only, never cmp reg, [mem]; every mem read stages through rax. Labels prefixed r91np_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // ---------- (2) kind = nic_dispatch_active_kind() ----------
        call nic_dispatch_active_kind;
        mov r12, rax;                        // r12 = kind (survives nested calls)

        // ---------- (3) kind == 0 -> single-KV path ----------
        cmp r12, 0;
        jne r91np_have_nic;

        mov rdi, 3;                          // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_boot_r91_nic_probe_ok];
        lea rcx, [rip + k_kind];
        xor r8, r8;                          // kind = 0
        call klog_s1_d1;
        jmp r91np_done;

      r91np_have_nic:
        // ---------- (4) mac = nic_dispatch_mac(kind, 0) ----------
        mov rdi, r12;                        // nic_kind
        xor rsi, rsi;                        // out_mac_ptr unused at shim
        call nic_dispatch_mac;
        mov r13, rax;                        // r13 = mac (survives nested calls)

        // ---------- (4b) link = nic_dispatch_link(kind) ----------
        mov rdi, r12;                        // nic_kind
        call nic_dispatch_link;
        mov r14, rax;                        // r14 = link (0 or 1)

        // ---------- (5) klog_s1_d3(kind, mac, link) ----------
        // 5-push prologue landed rsp%16 == 0. sub rsp,8 + 3 pushes ==
        // 32 bytes -> rsp%16 == 0 preserved for klog_s1_d3's own push.
        sub rsp, 8;                          // pad: 0 -> 8
        push r14;                            // v3 = link;  8 -> 0
        lea rax, [rip + k_link_up];
        push rax;                            // k3 = k_link_up; 0 -> 8
        push r13;                            // v2 = mac;   8 -> 0

        mov rdi, 3;                          // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_boot_r91_nic_probe_ok];
        lea rcx, [rip + k_kind];
        mov r8, r12;                         // v1 = kind
        lea r9, [rip + k_mac];
        call klog_s1_d3;

        add rsp, 32;                         // pop 3 pushes + pad

      r91np_done:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
