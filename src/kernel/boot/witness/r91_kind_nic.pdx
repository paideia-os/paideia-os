// src/kernel/boot/witness/r91_kind_nic.pdx -- R91.M1-001 (paideia-os #2011)
//
// Boot-time witness for KIND_NIC end to end: mints a synthetic KIND_
// DEVICE parent, mints a KIND_NIC row over it via kind_nic_mint_body
// (nic_kind = NONE, mac = all-zero, link_state = DOWN, since no real
// NIC driver is wired at R91.M1-001), then reads back the nic_kind /
// mac / link_state values via cap_invoke through the KIND_NIC branch
// of cap_invoke_dispatch (using the R_NIC_QUERY right). The direct-
// analogue of witness_r100_tls_trust but for a KIND_DEVICE-derived
// static-identity kind -- there is no equivalent of a WRITE/REPORT op
// to exercise (§2's immutability contract means the only ops are QUERY_
// KIND / QUERY_MAC / QUERY_LINK, and this witness runs all three).
//
// =============================================================================
// PREREQUISITES THIS FILE MINTS (all private, all torn down on every exit)
// =============================================================================
//
//   Cap slot 126 -- KIND_DEVICE(10) + RIGHT_MINT(0x200), target_ptr = a
//     synthetic device-identity key (0x91DE for "R91 device"). Free by
//     construction: witness_r100_tls_trust (immediately above this
//     witness in the boot cascade) owns and scrubs slots 124+125, and
//     no other cascade-reachable file names slot 126 -- verified by
//     tree-wide grep of src/kernel/boot/witness/ at landing time.
//   Cap slot 127 -- KIND_NIC(0x1AD) + R_NIC_QUERY(0x001), target_ptr =
//     row_id returned by kind_nic_mint_body. Same free-by-construction
//     argument as slot 126.
//   KIND_NIC row (kind_nic_mint_body) -- claimed on entry, released on
//     teardown via nic_tail_free.
//
// =============================================================================
// KLOG WRAPPER CHOICE
// =============================================================================
//
// The rollup fingerprint carries two decimal KVs (kind=<n>, link=<n>),
// so this file uses klog_s1_d2 (core/klog/wrappers.pdx), matching
// r100_tls_trust.pdx's own wrapper choice for its two-KV emit. The
// stack push+pop for the 7th (v2) arg is identical.
//
// =============================================================================
// FINGERPRINT
// =============================================================================
//
// Success: "boot nic ok -- kind=<n> link=<n>" (klog_s1_d2). Deliberately
// all-lowercase with no bracketed "[legacy: ... OK]" suffix, matching
// r100_tls_trust.pdx's / r89_tui_canvas.pdx's brand-new-narrative-tag
// posture: it carries no standalone uppercase "OK" token, so tools/
// verify-fingerprint-coverage.sh's OK_TOK extractor does not require
// golden coverage or an allowlist entry for it.
//
// The uppercase-shape "nic mint ok [legacy: NIC MINT OK]" fingerprint
// is emitted from inside kind_nic_mint_body (kind_nic.pdx nic_mint_ok_
// msg), which this witness is the first-ever caller of -- it therefore
// makes that literal reachable in practice for the first time and
// requires an allowlist entry in tools/verify-fingerprint-coverage.sh
// (same "no golden pins this exact literal today; the witness's own
// lowercase rollup covers the code path" argument as the sibling
// KIND_TUI_CANVAS / KIND_TLS_TRUST mint-marker entries there).
//
// Failure: "boot nic fail line=<N>" (klog_s1_d1), stage number stamped
// into _r91nic_stage before every step. No boot_bail_or_continue call;
// failure falls through to cleanup + return, same shape as every
// sibling witness in this cascade.
//
// =============================================================================
// ENCODER DISCIPLINE
// =============================================================================
//
// No frameless-function annotations anywhere. No `add reg, [mem]`, no
// `cmp reg, [mem]` -- every value is loaded to a register before any
// arithmetic or comparison. Every store is a qword `mov [mem], reg`.
// Every label in this file is prefixed `r91nic_` (reserved-word
// discipline -- `loop`/`if` etc. are keywords).

module R91KindNic = structure {

  pub let mut _r91nic_stage : u64 = 0

  pub let tag_boot_nic_ok : [u8; 15] = "boot nic ok --\0"
  pub let r91nic_fail_msg : [u8; 14] = "boot nic fail\0"
  pub let r91nic_k_kind   : [u8; 5]  = "kind\0"
  pub let r91nic_k_link   : [u8; 5]  = "link\0"

  // A synthetic KIND_DEVICE identity key used only by this witness. Any
  // non-zero value distinguishable from the real device keys the
  // supervisor / pci_enumerator hand out is fine; 0x91DE (visual pun on
  // "R91 device") makes the origin obvious in a raw cap_table dump.
  pub let R91NIC_DEVICE_KEY : u64 = 0x91DE

  // Scrub cap slots 126 (KIND_DEVICE parent) and 127 (minted KIND_NIC
  // cap) back to (0,0,0). Called at entry (defensive) and on every exit.
  pub let r91nic_clear_slots : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R91.M1-001 (paideia-os #2011): scrub this witness's two private cap_table slots (126 KIND_DEVICE parent, 127 minted KIND_NIC cap) to (0,0,0). Labels prefixed r91nic_cs_.",
      block: {
        mov rdi, 126;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        mov rdi, 127;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        ret
      }
    }

  // witness_r91_kind_nic() -> ()
  //
  // Five callee-save pushes (rbx, r12-r15) leave rsp%16 == 0 for every
  // nested call (entry rsp%16 == 8, +40 -> %16 == 0), matching every
  // sibling witness in this cascade. Register plan (all callee-save,
  // survive every nested call by SysV convention): r12 = nic row_id,
  // r13 = scratch return-value holder across cross-checks, r14/r15/
  // rbx reserved for future extensions.
  pub let witness_r91_kind_nic : () -> () !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R91.M1-001 (paideia-os #2011): boot witness proving KIND_NIC end to end. Stage 1: reset the witness's two cap-table slots (126 KIND_DEVICE parent, 127 the freshly-minted KIND_NIC cap). Stage 2: mint the KIND_DEVICE parent at slot 126 with target_ptr = R91NIC_DEVICE_KEY. Stage 3: mint the KIND_NIC row via kind_nic_mint_body(parent_slot=126, rights=R_NIC_QUERY, nic_kind=NONE, link_state=DOWN, mac_word=0). Stage 4: cap_mint_write the returned row_id into cap_table slot 127 with kind=KIND_NIC + rights=R_NIC_QUERY. Stages 5-7: exercise every KIND_NIC op via cap_invoke through the R91.M1-001 cap_invoke_dispatch branch -- QUERY_KIND (=NIC_KIND_NONE=0), QUERY_MAC (=0), QUERY_LINK (=NIC_LINK_DOWN=0). Stage 8: denial cross-check -- re-mint slot 127 with rights=0, invoke QUERY_KIND, expect NIC_BAD_RIGHTS (0xFFFFEB28); then re-mint the real cap so the fingerprint stage below names a live cap for correlators. Stage 9: emit the rollup fingerprint. Stage 10: scrub the cap_table slots and free the row. Capabilities/effects: cap_mint_write/kind_nic_mint_body/cap_invoke/nic_tail_free all need {cap}; klog_s1_d1/klog_s1_d2 need {sysreg,mem}. 'boot' is added per this cascade's own witness-function convention. On any failure, the stage number is stamped into _r91nic_stage first so the failure klog line names which sub-test tripped; failure falls through to cap-slot + row cleanup only, matching r100_tls_trust.pdx's identical failure shape. Labels prefixed r91nic_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // ---------- Stage 1: reset cap-table slots ----------
        mov rax, 1;
        lea rcx, [rip + _r91nic_stage];
        mov [rcx], rax;
        call r91nic_clear_slots;

        // ---------- Stage 2: mint KIND_DEVICE parent at slot 126 ----------
        mov rax, 2;
        lea rcx, [rip + _r91nic_stage];
        mov [rcx], rax;
        mov rdi, 126;                    // slot
        mov rsi, 10;                     // KIND_DEVICE
        mov rdx, 0x200;                  // RIGHT_MINT
        mov rcx, 0x91DE;                 // R91NIC_DEVICE_KEY (target_ptr)
        call cap_mint_write;

        // ---------- Stage 3: mint KIND_NIC row ----------
        mov rax, 3;
        lea rcx, [rip + _r91nic_stage];
        mov [rcx], rax;
        mov rdi, 126;                    // parent_slot
        mov rsi, 0x001;                  // rights = R_NIC_QUERY
        mov rdx, 0;                      // nic_kind = NIC_KIND_NONE
        mov rcx, 0;                      // link_state = NIC_LINK_DOWN
        mov r8,  0;                      // mac_word = zero (all six MAC bytes zero)
        call kind_nic_mint_body;
        mov r10, 4;                      // NIC_MAX
        cmp rax, r10;
        jae r91nic_fail_stage;
        mov r12, rax;                    // r12 = nic row_id

        // ---------- Stage 4: cap_mint_write slot 127 = the KIND_NIC cap ----------
        mov rax, 4;
        lea rcx, [rip + _r91nic_stage];
        mov [rcx], rax;
        mov rdi, 127;                    // slot
        mov rsi, 0x1AD;                  // KIND_NIC
        mov rdx, 0x001;                  // R_NIC_QUERY
        mov rcx, r12;                    // target_ptr = row_id
        call cap_mint_write;

        // ---------- Stage 5: QUERY_KIND -> NIC_KIND_NONE (=0) ----------
        mov rax, 5;
        lea rcx, [rip + _r91nic_stage];
        mov [rcx], rax;
        mov rdi, 127;
        mov rsi, 0;                      // NIC_OP_QUERY_KIND
        call cap_invoke;
        cmp rax, 0;
        jne r91nic_fail_stage;

        // ---------- Stage 6: QUERY_MAC -> 0 ----------
        mov rax, 6;
        lea rcx, [rip + _r91nic_stage];
        mov [rcx], rax;
        mov rdi, 127;
        mov rsi, 1;                      // NIC_OP_QUERY_MAC
        call cap_invoke;
        cmp rax, 0;
        jne r91nic_fail_stage;

        // ---------- Stage 7: QUERY_LINK -> NIC_LINK_DOWN (=0) ----------
        mov rax, 7;
        lea rcx, [rip + _r91nic_stage];
        mov [rcx], rax;
        mov rdi, 127;
        mov rsi, 2;                      // NIC_OP_QUERY_LINK
        call cap_invoke;
        cmp rax, 0;
        jne r91nic_fail_stage;

        // ---------- Stage 8: denial cross-check -- rights=0 ----------
        // Prove the R_NIC_QUERY gate is live: write a cap at slot 127
        // with rights=0 (no R_NIC_QUERY), then invoke QUERY_KIND --
        // must refuse with NIC_BAD_RIGHTS (0xFFFFEB28). Re-mint the
        // real cap after so the row stays reachable through slot 127
        // for any post-witness consumer.
        mov rax, 8;
        lea rcx, [rip + _r91nic_stage];
        mov [rcx], rax;
        mov rdi, 127;
        mov rsi, 0x1AD;                  // KIND_NIC
        xor rdx, rdx;                    // rights = 0 (deny)
        mov rcx, r12;                    // target_ptr = row_id
        call cap_mint_write;

        mov rdi, 127;
        mov rsi, 0;                      // NIC_OP_QUERY_KIND
        call cap_invoke;
        mov r10, 0xFFFFEB28;             // NIC_BAD_RIGHTS
        cmp rax, r10;
        jne r91nic_fail_stage;

        // Re-mint the real cap.
        mov rdi, 127;
        mov rsi, 0x1AD;
        mov rdx, 0x001;                  // R_NIC_QUERY
        mov rcx, r12;
        call cap_mint_write;

        // ---------- Stage 9: emit "boot nic ok -- kind=0 link=0" ----------
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_boot_nic_ok];
        lea rcx, [rip + r91nic_k_kind];
        mov r8,  0;                      // kind (NIC_KIND_NONE)
        lea r9,  [rip + r91nic_k_link];
        sub rsp, 8;                      // alignment pad
        mov rax, 0;                      // link (NIC_LINK_DOWN)
        push rax;                        // 7th arg (v2) per klog_s1_d2
        call klog_s1_d2;
        add rsp, 16;

        // ---------- Stage 10: teardown ----------
        // Scrub the cap_table slots and release the row.
        mov rdi, r12;
        call nic_tail_free;
        call r91nic_clear_slots;
        jmp r91nic_witness_done;

      r91nic_fail_stage:
        mov rdi, 1;                      // LEVEL_ERROR
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + r91nic_fail_msg];
        lea rcx, [rip + k_line];
        lea rax, [rip + _r91nic_stage];
        mov r8, [rax];
        call klog_s1_d1;
        call r91nic_clear_slots;

      r91nic_witness_done:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
