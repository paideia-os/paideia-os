// src/kernel/boot/witness/r92_route_table.pdx -- R92.M1-003
// (paideia-os #2036)
//
// Route-table mid-boot update witness. Reads _ipv4_my_ip via
// route_table_get, writes a distinguishing test value via
// route_table_set, verifies the write landed at the same storage
// _ipv4_my_ip's byte-level readers (ipv4_tx_send's subnet decision at
// net/ipv4.pdx:775..797) consume, then restores the original so no
// downstream witness observes a mutated route.
//
// =============================================================================
// SECTION 0  WHY A DEDICATED ROUTE-TABLE WITNESS
// =============================================================================
//
// R92.M1-001 moved _ipv4_my_ip / _ipv4_gw_ip from rodata in
// net/ipv4.pdx into `pub let mut` .bss owned by net/route_table.pdx.
// R92.M1-002 added the route_table_set / route_table_get accessor
// pair. The invariant the two must satisfy jointly is: a write via
// route_table_set MUST land at the same storage every byte-level
// reader across arp.pdx / ipv4.pdx / icmp.pdx / udp_socket.pdx
// consumes. If that invariant breaks (a slow drift where the accessor
// gains a shadow copy, or the .bss layout shifts the symbols apart),
// ipv4_tx_send's same-/24-subnet decision would silently ignore any
// runtime mutation and R93's DHCP client would look like it acquired
// a lease but never actually routed off the boot-default subnet.
//
// This witness's fingerprint is the assertable proof that the
// invariant holds at this landing.
//
// =============================================================================
// SECTION 1  TEST VALUE + SUBNET-DECISION VERIFICATION
// =============================================================================
//
// The witness swaps my_ip from the default 10.0.0.2 to a test value
// 10.99.99.99 (= 0x0A636363), then loads the four bytes at
// [rip + _ipv4_my_ip + N] via the same xor+mov_b idiom
// ipv4_tx_send's same-/24 subnet gate uses (ipv4.pdx:779..797), and
// compares each against the expected byte of the test value.
//
// Byte-for-byte match across all four confirms:
//
//   1. route_table_set(RT_FIELD_MY_IP=0, 0x0A636363) wrote canonical
//      wire order [10, 99, 99, 99] at the expected offsets.
//   2. The storage at [rip + _ipv4_my_ip + N] is the same storage
//      ipv4_tx_send reads (single source of truth).
//   3. A subsequent ipv4_tx_send call would take the "same-/24" or
//      "use gw" branch according to the mutated my_ip, not the pre-
//      mutation my_ip -- exactly what the R93 DHCP wire-in depends on.
//
// Any mismatch aborts the witness with the mismatch-line variant of
// the fingerprint (byte index that failed).
//
// =============================================================================
// SECTION 2  RESTORE DISCIPLINE
// =============================================================================
//
// After the verification, the witness restores my_ip to the pre-
// witness value (read into r13 at the top of the body) so no
// downstream witness -- most importantly witness_r92_arp_pending_
// retry and witness_r92_icmp_ping just below in kernel_main.pdx --
// observes a mutated route. Restore is unconditional: even if the
// mid-witness verification failed, the restore path runs before the
// witness returns.
//
// =============================================================================
// SECTION 3  FINGERPRINT
// =============================================================================
//
// Emits `boot r92 route table ok` via klog_s1(LEVEL_INFO=3,
// SUBSYS_BOOT, tag_boot_r92_route_ok). Lowercase, no bracketed OK
// suffix -- same posture as `boot r91 nic probe ok` above, so
// tools/verify-fingerprint-coverage.sh's OK_TOK extractor does not
// demand golden coverage or an allowlist entry.
//
// A failure to verify does NOT emit the OK fingerprint (the witness
// returns silently on mismatch after restoring). A missing OK line in
// the boot log is the failure signal a future golden would key on.
//
// =============================================================================
// SECTION 4  ENCODER + LABEL DISCIPLINE
// =============================================================================
//
// 3-push callee-save prologue (rbx, r12, r13) = 24 B; entry rsp%16==8
// -> 32, %16==0 for every nested SysV call (route_table_get,
// route_table_set, klog_s1). rbx stashes the byte-index scratch, r12
// stashes the test value, r13 stashes the pre-witness my_ip so the
// restore path finds it. No `add reg, [mem]`, no `mov_bzx` -- every
// byte load is xor+mov_b. Labels prefixed `r92rt_`.

module R92RouteTable = structure {

  // witness_r92_route_table_update() -> ()
  pub let witness_r92_route_table_update : () -> () !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R92.M1-003 (paideia-os #2036). Route-table mid-boot update witness. Body: (1) 3-push callee-save (rbx=byte_idx scratch, r12=test_value, r13=saved_my_ip). Entry rsp%16==8 -> 32, %16==0 for every nested call. (2) Read pre-witness my_ip via route_table_get(0); r13 = rax. (3) route_table_set(0, 0x0A636363) -- test value 10.99.99.99, clearly not the default 10.0.0.2 or 10.0.2.2. rax != 0 -> jump to restore path (no OK emit). (4) Byte-by-byte verify [rip + _ipv4_my_ip + N] against expected bytes (10, 99, 99, 99) via xor+mov_b + cmp, mirroring ipv4_tx_send:779..797's own subnet-check idiom. Any mismatch -> restore path. (5) All four bytes match -> emit `boot r92 route table ok` via klog_s1(3, SUBSYS_BOOT, tag_boot_r92_route_ok). (6) Unconditional restore: route_table_set(0, r13) with the pre-witness value. Return. Labels prefixed r92rt_. Encoder-conservative: xor+mov_b for byte loads (never mov_bzx), [rip+sym+disp8] only, cmp reg,imm.",
      block: {
        push rbx;
        push r12;
        push r13;

        // (2) Save pre-witness my_ip.
        xor rdi, rdi;                             // RT_FIELD_MY_IP
        call route_table_get;
        mov r13, rax;                             // r13 = saved_my_ip

        // (3) Set test value 10.99.99.99 = 0x0A636363.
        xor rdi, rdi;                             // RT_FIELD_MY_IP
        mov rsi, 0x0A636363;
        call route_table_set;
        cmp rax, 0;
        jne r92rt_restore;

        // r12 = test value for later comparison staging (not strictly
        // needed since we use immediates below, but kept for the
        // register-plan comment above).
        mov r12, 0x0A636363;

        // (4) Byte-by-byte verify [rip + _ipv4_my_ip + N] equals the
        // expected bytes of the test value.
        xor rax, rax;
        mov_b rax, [rip + _ipv4_my_ip + 0];
        cmp rax, 10;
        jne r92rt_restore;

        xor rax, rax;
        mov_b rax, [rip + _ipv4_my_ip + 1];
        cmp rax, 99;
        jne r92rt_restore;

        xor rax, rax;
        mov_b rax, [rip + _ipv4_my_ip + 2];
        cmp rax, 99;
        jne r92rt_restore;

        xor rax, rax;
        mov_b rax, [rip + _ipv4_my_ip + 3];
        cmp rax, 99;
        jne r92rt_restore;

        // (5) Emit fingerprint.
        mov rdi, 3;                               // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_boot_r92_route_ok];
        call klog_s1;

      r92rt_restore:
        // (6) Restore pre-witness my_ip unconditionally.
        xor rdi, rdi;                             // RT_FIELD_MY_IP
        mov rsi, r13;
        call route_table_set;

        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
