// src/kernel/boot/witness/r102_input_route.pdx — R102.MON-006 skeleton
//
// R102.MON-006 (paideia-os #2213) owns the boot smoke that pins the
// HID-injection-through-compositor-to-focused-client cascade
// (`pdxpaint drag stroke shows up`). Fires once svc-compositor.M4-003
// (input pump), svc-wm.M4 (focus routing), pdxpaint.M4-001 (input-
// heavy reference app) AND R101's HID-injection fixture (§7.2.5 of the
// R102 plan) have landed upstream, and the six graphical satellite
// ELFs are embedded via R102.MON-003.
//
// As of this landing, all four preconditions are unmet. In addition to
// the nine-satellite-scaffold-only state (see r102_first_pixel.pdx
// header for the full disposition), the R101 HID-injection harness
// hook does not yet exist -- the R102 plan flags this in §7.2.5 as an
// osarch ask.
//
// Skeleton body: emit ONE lowercase skip fingerprint and return.
//
//   Skeleton (this landing):
//     "boot r102 input route skip reason=no-userland"
//   Future (when the cascade fires):
//     "boot r102 input route ok"          (per r102-user-plan.md §4.10)
//
// Encoder discipline: same as r102_first_pixel.pdx.

module R102InputRoute = structure {

  // 46 bytes including NUL.
  pub let tag_r102_input_route_skip : [u8; 46] =
    "boot r102 input route skip reason=no-userland\0"

  pub let witness_r102_input_route : () -> () !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R102.MON-006 skeleton (paideia-os #2213). Emits the ONE-line lowercase skip fingerprint `boot r102 input route skip reason=no-userland` on every boot. The full cascade requires svc-compositor.M4-003 + svc-wm.M4 + pdxpaint.M4-001 + R101 HID-injection fixture (§7.2.5 of design/graphics/r102-user-plan.md); none of those preconditions hold as of the R102 MON- wave. push rbp / pop rbp preserves the caller's rsp%16 parity and rbp guarantee across the nested klog_s1 call.",
      block: {
        push rbp;

        mov rdi, 3;                              // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_r102_input_route_skip];
        call klog_s1;

        pop rbp;
        ret
      }
    }
}
