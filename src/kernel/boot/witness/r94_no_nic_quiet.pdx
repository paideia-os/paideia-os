// src/kernel/boot/witness/r94_no_nic_quiet.pdx -- R94-FIX-003
// (paideia-os #2220).
//
// Regression witness for the R94 no-NIC boot wedge fixed by the
// tcp_poll_retransmits early-exit gate in net/tcp.pdx. Under
// PAIDEIA_NIC=none the pre-fix code walked the 64-entry TCB pool
// on every 10th LAPIC tick, drove tcp_retransmit_last on any
// stale-substrate row with snd_una != snd_nxt, and re-entered
// tcp_rx_handle via the loopback fast path (local_ip==remote_ip
// on an uninit-but-non-zero row satisfies the four-byte compare
// with zero on both sides). tcp_rx_handle emits tag_l3_tcp
// ("L3 TCP segment received [legacy: L3 RX TCP]") unconditionally
// past its 20-byte-header gate, and _tcp_rx_pkts is bumped on
// every entry regardless of the dispatch branch taken. Result:
// ~215 spurious `L3 RX TCP` fingerprints over ~23s, wedging every
// post-t=0.85s witness behind the flood.
//
// Witness shape: run only when _active_nic_kind == 0 (silent
// skip otherwise -- a NIC-attached boot legitimately produces
// tag_l3_tcp fingerprints via real inbound TCP traffic). Snapshot
// _tcp_rx_pkts, invoke tcp_poll_retransmits 100 times back-to-
// back (the direct equivalent of ~10 seconds of the ~10 Hz
// LAPIC-gated sampling the R94.M1-001 wire-in schedules), and
// assert _tcp_rx_pkts is unchanged. Success emits
// `boot r94 no nic quiet ok --`; failure is signalled by the
// missing fingerprint (same fail-by-absence convention every
// other boot witness in this tree takes).
//
// The 100-iteration budget is a deliberate over-estimate: at the
// scheduled ~10 Hz sampling rate the pre-fix code emitted ~9-10
// fingerprints per second, so 100 iterations exercises roughly
// 10x the failure interval. Straight-line calls make the test
// deterministic and independent of the boot-time timer state
// (witnesses in this tree run pre-sti, so relying on the LAPIC
// tick to drive tcp_poll_retransmits organically would deadlock
// waiting for interrupts that are not yet enabled).
//
// Frame prologue implicit: 2-push callee-save (rbx=_tcp_rx_pkts
// snapshot, r12=loop counter) + sub rsp,8 for stack alignment.
// Entry rsp%16==8, 2 pushes (16B) -> %16==8, sub 8 -> %16==0 for
// the nested tcp_poll_retransmits + klog_s1 calls.
//
// Reserved labels: r94nnq_ prefix.

module R94NoNicQuiet = structure {

  pub let witness_r94_no_nic_quiet : () -> () !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R94-FIX-003 (paideia-os #2220). Regression witness for the tcp_poll_retransmits no-NIC early-exit gate landed in net/tcp.pdx. Gate: silent skip when _active_nic_kind != 0 (a NIC-attached boot legitimately emits tag_l3_tcp via real RX). On no-NIC: snapshot _tcp_rx_pkts, call tcp_poll_retransmits 100 times back-to-back (direct equivalent of ~10s of the R94.M1-001 LAPIC-gated sampling), assert _tcp_rx_pkts unchanged. Frame prologue implicit: 2-push callee-save (rbx=snapshot, r12=counter) + sub rsp,8; entry rsp%16==8, 2 pushes 16B -> %16==8, sub 8 -> %16==0 for the nested tcp_poll_retransmits + klog_s1 calls. Fail-by-absence: missing fingerprint is the failure signal, mirroring every other boot witness's diff-golden discipline. Reserved labels: r94nnq_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        // Gate: only meaningful under PAIDEIA_NIC=none. A NIC-
        // attached boot legitimately produces tag_l3_tcp via
        // real RX, so this witness would be a false-fail there.
        mov rax, [rip + _active_nic_kind];
        cmp rax, 0;
        jne r94nnq_done;

        // Snapshot _tcp_rx_pkts. tcp_rx_handle bumps this on
        // every entry past the 20-byte-header gate (see trh_done
        // in net/tcp.pdx), regardless of malformed / no-socket
        // / established / listener branch, so it is a faithful
        // count of tag_l3_tcp fingerprint emissions.
        mov rbx, [rip + _tcp_rx_pkts];

        // 100 iterations. The pre-fix defect emitted ~10 fingerprints
        // per second at the R94.M1-001 gated sampling rate; 100
        // straight-line calls exercises ~10x that failure interval.
        mov r12, 100;

      r94nnq_loop:
        cmp r12, 0;
        je r94nnq_check;
        call tcp_poll_retransmits;
        sub r12, 1;
        jmp r94nnq_loop;

      r94nnq_check:
        mov rax, [rip + _tcp_rx_pkts];
        cmp rax, rbx;
        jne r94nnq_done;

        // Emit success fingerprint. Missing fingerprint is the
        // failure signal per this tree's fingerprint-diff smoke
        // discipline (see tools/verify-fingerprint-coverage.sh).
        mov rdi, 3;                          // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_boot_r94_no_nic_quiet_ok];
        call klog_s1;

      r94nnq_done:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }
}
