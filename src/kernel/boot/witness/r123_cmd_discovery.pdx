// src/kernel/boot/witness/r123_cmd_discovery.pdx -- R123.M5 (paideia-os #2506)
//
// Boot-time witness for the R123.M5 command discovery API stubs
// (cmd_registry_find_by_input_schema / cmd_registry_find_by_output_
// schema / cmd_registry_find_by_capability -- see src/kernel/core/
// shell/cmd_registry.pdx §16). Exercises each of the three axes with
// a nonzero query key, asserts the returned count is nonzero, and
// emits an acceptance fingerprint per axis:
//
//   `cmd discovery ok query=<hex> results=<dec>`
//
// via klog_s1_x1_d1 (SUBSYS_CAP_, tag_cmd_discovery_ok, k_query,
// query, k_results, results).
//
// Placement: runs AFTER witness_r123_cmd_invoke so the LRU cache
// already holds R123.M2's three seeds (find/0x11, where/0x22,
// sort/0x33) plus R123.M3's four seeds (l_where/l_sort/l_head/
// l_count), for a total of 7 populated rows. Each discovery
// primitive is a §16 STUB that returns the whole populated-row
// count when the query key is nonzero -- per-field filtering
// against input_schema / output_schema / capability is deferred
// until the KIND_CMD_MODULE row (frozen at R123.M1) grows those
// fields in an R123.M5.M2-followup. Today's witness asserts the
// stub returns 7 (indirectly, via a nonzero check) and emits the
// count in the fingerprint's `results` field so the follow-up's
// narrowing lands with an observable delta.
//
// =============================================================================
// FAILURE FUNNEL STAGES
// =============================================================================
//
//   1 = find_by_input_schema(0x1234)  returned 0
//   2 = find_by_output_schema(0x5678) returned 0
//   3 = find_by_capability(0xABCD)    returned 0
//
// =============================================================================
// ENCODER DISCIPLINE
// =============================================================================
//
// No `test rN, rN`; every zero-check uses `cmp reg, 0`. Every store
// to _r123cd_stage is a qword `mov [mem], reg`. Labels prefixed
// `r123cd_` (reserved-word discipline).

module R123CmdDiscovery = structure {

  // ==========================================================================
  // Stage counter + failure message.
  // ==========================================================================

  pub let mut _r123cd_stage : u64 = 0

  // "boot cmd discovery fail" = 23 chars + NUL = 24.
  pub let r123cd_fail_msg : [u8; 24] = "boot cmd discovery fail\0"

  // Query keys. Chosen distinct so the fingerprint stream reads
  // per-axis at a glance. The values are nonzero placeholders --
  // they are opaque to the stub primitive (which just returns
  // cr_count_populated for any nonzero arg). When per-field
  // narrowing lands the values will need to reference real schema
  // ids (and this witness will be renamed/extended).
  pub let R123CD_QUERY_INPUT   : u64 = 0x1234
  pub let R123CD_QUERY_OUTPUT  : u64 = 0x5678
  pub let R123CD_QUERY_CAP     : u64 = 0xABCD

  // ==========================================================================
  // witness_r123_cmd_discovery() -> ()
  //
  // Sequence:
  //   Stage 1: find_by_input_schema(0x1234)  -> expect nonzero.
  //            Emit `cmd discovery ok query=0x1234 results=<n>`.
  //   Stage 2: find_by_output_schema(0x5678) -> expect nonzero.
  //            Emit `cmd discovery ok query=0x5678 results=<n>`.
  //   Stage 3: find_by_capability(0xABCD)    -> expect nonzero.
  //            Emit `cmd discovery ok query=0xABCD results=<n>`.
  //
  // Register plan: five callee-save pushes (rbx = query key stash
  // across nested klog call, r12/r13/r14/r15 unused today but
  // preserved to match sibling R123 witness posture -- keeps the
  // rsp%16 math identical). Entry rsp%16==8, +40 -> %16==0 at every
  // nested call. klog_s1_x1_d1 caller-push idiom
  //   sub rsp, 8; push vd; call klog_s1_x1_d1; add rsp, 16
  // keeps alignment.
  //
  // Failure funnel emits `boot cmd discovery fail line=<stage>` via
  // klog_s1_d1 (LEVEL_INFO), matching sibling R123 witnesses.
  // Labels prefixed r123cd_.
  // ==========================================================================
  pub let witness_r123_cmd_discovery : () -> () !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R123.M5 (paideia-os #2506): boot witness for the command discovery API stubs. Sequence: (1) cmd_registry_find_by_input_schema(0x1234) -> expect nonzero, emit `cmd discovery ok query=0x1234 results=<n>` via klog_s1_x1_d1; (2) cmd_registry_find_by_output_schema(0x5678) -> expect nonzero, emit same shape with query=0x5678; (3) cmd_registry_find_by_capability(0xABCD) -> expect nonzero, emit same shape with query=0xABCD. Each stub returns cr_count_populated() (whole-cache populated-row count) when the query key is nonzero -- per-field narrowing deferred to R123.M5.M2-followup (KIND_CMD_MODULE row frozen at R123.M1 does not yet carry the required fields). At witness time the cache holds 7 populated rows: R123.M2 seeds (find/where/sort) + R123.M3 seeds (l_where/l_sort/l_head/l_count). Register plan: five callee-save pushes (rbx=query stash, r12-r15 unused-but-preserved for sibling-witness parity) leave rsp%16==0 at nested calls (entry rsp%16==8, +40 -> %16==0). klog_s1_x1_d1 caller-push idiom (sub rsp,8; push vd; call; add rsp,16) keeps alignment. Failure funnel emits `boot cmd discovery fail line=<stage>` via klog_s1_d1 (LEVEL_INFO, matching sibling R123 witnesses so the boot smoke does not pull a panic on golden diff). No teardown: the discovery primitives are pure reads on the shared LRU cache. Labels prefixed r123cd_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // ------------------------------------------------------------
        // Stage 1: find_by_input_schema(0x1234).
        // ------------------------------------------------------------
        mov rax, 1;
        mov [rip + _r123cd_stage], rax;

        mov rdi, 0x1234;                 // R123CD_QUERY_INPUT
        call cmd_registry_find_by_input_schema;
        cmp rax, 0;
        je  r123cd_fail;
        mov rbx, rax;                    // rbx = result count for fingerprint

        // Emit `cmd discovery ok query=0x1234 results=<rbx>`.
        // klog_s1_x1_d1 caller-push: sub 8; push vd; call; add 16.
        sub rsp, 8;
        push rbx;                        // vd = result count (dec)
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + tag_cmd_discovery_ok];
        lea rcx, [rip + k_query];
        mov r8,  0x1234;                 // vx = query key (hex)
        lea r9,  [rip + k_results];
        call klog_s1_x1_d1;
        add rsp, 16;

        // ------------------------------------------------------------
        // Stage 2: find_by_output_schema(0x5678).
        // ------------------------------------------------------------
        mov rax, 2;
        mov [rip + _r123cd_stage], rax;

        mov rdi, 0x5678;                 // R123CD_QUERY_OUTPUT
        call cmd_registry_find_by_output_schema;
        cmp rax, 0;
        je  r123cd_fail;
        mov rbx, rax;

        sub rsp, 8;
        push rbx;
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + tag_cmd_discovery_ok];
        lea rcx, [rip + k_query];
        mov r8,  0x5678;
        lea r9,  [rip + k_results];
        call klog_s1_x1_d1;
        add rsp, 16;

        // ------------------------------------------------------------
        // Stage 3: find_by_capability(0xABCD).
        // ------------------------------------------------------------
        mov rax, 3;
        mov [rip + _r123cd_stage], rax;

        mov rdi, 0xABCD;                 // R123CD_QUERY_CAP
        call cmd_registry_find_by_capability;
        cmp rax, 0;
        je  r123cd_fail;
        mov rbx, rax;

        sub rsp, 8;
        push rbx;
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + tag_cmd_discovery_ok];
        lea rcx, [rip + k_query];
        mov r8,  0xABCD;
        lea r9,  [rip + k_results];
        call klog_s1_x1_d1;
        add rsp, 16;

        jmp r123cd_out;

      // ================================================================
      // Failure funnel: emit `boot cmd discovery fail line=<stage>` via
      // klog_s1_d1 (LEVEL_INFO, matching sibling R123 witnesses so the
      // boot smoke does not pull a panic on golden diff).
      // ================================================================
      r123cd_fail:
        mov rax, [rip + _r123cd_stage];
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + r123cd_fail_msg];
        lea rcx, [rip + k_line];
        mov r8,  rax;                    // v = stage
        call klog_s1_d1;

      r123cd_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
