// src/kernel/boot/witness/rootfs_seed_policy.pdx — R90-XREPO.011.M1-004
// (paideia-os #2119). Seeds `/system/policy` — the on-disk table the
// elevate broker (svc.elevate-broker, R48b substrate; dispatch body
// #2122) consults at start-up to grant / deny each elevate request.
//
// See design/security/elevate-policy-format.md for the file grammar,
// the seeded default's byte-for-byte contents, and the fingerprint
// discipline. This module is the seeder half only; the broker's
// parser is out of scope for this issue.
//
// -----------------------------------------------------------------------------
// Placement in the boot cascade
// -----------------------------------------------------------------------------
//
// Called from `boot_continue_after_ring3` in kernel_main.pdx immediately
// AFTER `witness_rootfs_dir_seeds` (see kernel_main.pdx ~line 1100).
// That witness already creates `/system` as a real directory in the tmpfs
// tree and wires its vnode-pool slot via vnode_cache_or_alloc; this
// module therefore does NOT re-create `/system` (a second create would
// collide and return 0, tripping the same "line=5" regression #1999
// fixed for the sibling seeder). Instead it looks up the existing
// `/system` inode via tmpfs_lookup — same pattern that fix mandated.
//
// -----------------------------------------------------------------------------
// Pattern
// -----------------------------------------------------------------------------
//
// Mirrors `bin_seeds.pdx`'s `bin_child_hello_seed` sequence exactly
// (mount_root_vnode → tmpfs_lookup for the parent dir → tmpfs_create for
// the new REG file → vnode_cache_or_alloc for the fresh child →
// tmpfs_write for the payload), and mirrors `rootfs_dir_seeds.pdx`'s
// per-stage `_policy_seed_stage` stamping so the FAIL fingerprint's
// `line=<N>` KV names exactly which stage tripped (idiom borrowed from
// pdxb_ahci_probe.pdx's _pdxbap_stage). vnode_cache_or_alloc is called
// for `/system` as belt+braces even though `witness_rootfs_dir_seeds`
// already wired that slot: the dedup-on-(parent, backend, ops) discipline
// returns the same slot (idempotent), and we need `r14 = system_vn_idx`
// as the parent arg for the child bind in Stage 3.
//
// Register plan (single-function-scoped, no callee-save r12-r15
// preservation needed at this call depth — matches rootfs_dir_seeds.pdx):
//   r12 = root_inode_idx (= 1), set at Stage 1, never changes.
//   r15 = root_vn_idx (from mount_root_vnode), set at Stage 1, never
//         reassigned (used as parent for Stage 1's system bind only).
//   r13 = system_inode_idx (Stage 1 → tmpfs_lookup return, used as
//         Stage 1's vnode_cache_or_alloc backend arg + Stage 2's
//         tmpfs_create dir_idx arg); repurposed at Stage 2 to hold
//         `policy_inode_idx` (system_inode_idx dead after Stage 2 —
//         this is the same reuse discipline rootfs_dir_seeds Stage 9
//         uses to overwrite the retired system group).
//   r14 = system_vn_idx (Stage 1 → vnode_cache_or_alloc return, used
//         as Stage 3's vnode_cache_or_alloc parent arg); dead after
//         Stage 3.
//
// Fingerprint discipline (matches sibling seed witnesses):
//   OK  : klog_s1_d1(LEVEL_INFO=3, SUBSYS_BOOT, tag_policy_seed_ok,
//         k_bytes, bytes_written) → "policy seed ok [legacy: POLICY
//         SEED OK] bytes=<N>"
//   FAIL: klog_s1_d1(LEVEL_ERROR=1, SUBSYS_BOOT, tag_policy_seed_fail,
//         k_line, stage) → "policy seed fail [legacy: POLICY SEED
//         FAIL] line=<N>"
// The bracketed `[legacy: POLICY SEED OK]` / `[legacy: POLICY SEED
// FAIL]` segment is the coverage-gate tag (tools/verify-fingerprint-
// coverage.sh's OK_TOK regex fires on the uppercase OK there so this
// module's OK line is picked up as a coverage marker — same dual-form
// discipline rs_fp_ok, tag_sys_taskinfo_ok and the R100-PREP tags
// follow).
//
// Encoder conservatism: only mov / lea / cmp / je / call / xor — all
// pre-existing forms with no known encoder gap. No add-reg-[mem]
// (rootfs_dir_seeds.pdx's #1999 note flagged that as an encoder
// hazard). No 64-bit immediate loads (all constants fit in imm32
// sign-extended positive: 0, 1, 2, 3, 4, 6, 173, 0xFFFF and the
// 0xFFFFFFFFFFFFFFFF sentinel that must be loaded via `mov rcx, imm64`
// per the write.pdx sentinel-load discipline). Labels are prefixed
// `policy_seed_` to steer clear of paideia-as reserved-keyword labels
// (loop, if, ...) per feedback_paideia_as_reserved_labels.

module RootfsSeedPolicy = structure {

  // ==========================================================================
  // Data
  // ==========================================================================

  // Stage counter: bumped at the top of each of the four stages so the
  // FAIL fingerprint's `line=<N>` KV names the tripping stage. Confined
  // to this .o alone by convention (mirrors _pdxbap_stage / _rfs_stage);
  // no cross-module readers.
  pub let mut _policy_seed_stage : u64 = 0

  // Fingerprint tags. Storage is +1 for the trailing NUL. klog_emit_core
  // appends the KV(s) plus its own trailing newline, so neither literal
  // carries an embedded `\n`. The bracketed `[legacy: ...]` segment is
  // the coverage-gate marker (see file header).
  //
  // "policy seed ok [legacy: POLICY SEED OK]" = 39 bytes wire + 1 NUL.
  pub let tag_policy_seed_ok   : [u8; 40] = "policy seed ok [legacy: POLICY SEED OK]\0"
  //
  // "policy seed fail [legacy: POLICY SEED FAIL]" = 43 bytes wire + 1 NUL.
  pub let tag_policy_seed_fail : [u8; 44] = "policy seed fail [legacy: POLICY SEED FAIL]\0"

  // Directory / file name literals. NUL-terminated for tmpfs_lookup /
  // tmpfs_create (tmpfs_create takes an explicit length; tmpfs_lookup
  // reads until NUL).
  pub let policy_name_system : [u8; 7] = "system\0"
  pub let policy_name_policy : [u8; 7] = "policy\0"

  // Seeded default policy content — see design/security/elevate-policy-
  // format.md §5 for the byte-for-byte listing and its intended
  // semantics. Storage is 174 = 173 wire bytes + 1 NUL. Written to
  // /system/policy verbatim (no NUL on the wire — tmpfs_write copies
  // exactly len=173 bytes, stopping short of the trailing NUL).
  //
  // Line-by-line breakdown (must sum to 173):
  //   1. "# PaideiaOS elevate policy v1\n"         30
  //   2. "# path-prefix  role-class  action\n"     34
  //   3. "/system/  INIT  ALLOW\n"                 22
  //   4. "/system/  *     DENY\n"                  21
  //   5. "/home/    *     ALLOW\n"                 22
  //   6. "/tmp/     *     ALLOW\n"                 22
  //   7. "/var/     *     ALLOW\n"                 22
  //                                       total   173
  pub let _policy_default_bytes : [u8; 174] =
    "# PaideiaOS elevate policy v1\n# path-prefix  role-class  action\n/system/  INIT  ALLOW\n/system/  *     DENY\n/home/    *     ALLOW\n/tmp/     *     ALLOW\n/var/     *     ALLOW\n\0"

  // ==========================================================================
  // witness_rootfs_seed_policy() — top-level entry, called from
  // kernel_main immediately after witness_rootfs_dir_seeds.
  // ==========================================================================
  pub let witness_rootfs_seed_policy : () -> () !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R90-XREPO.011.M1-004 (paideia-os #2119): seeds /system/policy at boot with the v1 default elevate policy (design/security/elevate-policy-format.md §5). Four-stage sequence, each stage stamping its number into _policy_seed_stage before its own call so a FAIL fingerprint names exactly which one tripped (idiom borrowed from pdxb_ahci_probe.pdx's _pdxbap_stage / rootfs_dir_seeds.pdx's _rfs_stage): (1) mount_root_vnode -> r15=root_vn_idx, r12=root_inode_idx=1; tmpfs_lookup(1, 'system') -> r13=system_inode_idx (witness_rootfs_dir_seeds Stage 5 already tmpfs_create'd /system, so a second create here would collide and return 0 — matches that fix's precedent per #1999); vnode_cache_or_alloc(r15, r13, &_tmpfs_vops) -> r14=system_vn_idx (idempotent dedup — returns the same slot rootfs_dir_seeds bound). (2) tmpfs_create(r13, 'policy', 6, VNODE_TYPE_REG=1) -> r13=policy_inode_idx (system_inode_idx dead after this call — reuses r13, matching rootfs_dir_seeds.pdx Stage 9's own retired-group reuse discipline). Failure gate checks BOTH rax==0 (create-failed) and rax==0xFFFF (TMPFS_INODE_ALLOC_OOM), matching bin_child_hello_seed's Step 2 gate. (3) vnode_cache_or_alloc(r14, r13, &_tmpfs_vops) — fresh vnode-pool slot for /system/policy; return discarded (no downstream consumer — same discipline bin_child_hello_seed's Step 5 documents). Gate checks rax==0xFFFF (VNODE_ALLOC_OOM). (4) tmpfs_write(r13, &_policy_default_bytes, 173, 0) — single-page write (173 < 4096, so the single-page constraint per write.pdx §4.5 holds by construction; no chunking loop needed). Gate checks rax==0xFFFFFFFFFFFFFFFF (VOPS_ERR_SENTINEL, matching bin_child_hello_seed's Step 7 sentinel-load-via-rcx discipline — AND/CMP has no imm64 form). All four failure exits converge on policy_seed_fail, which reads _policy_seed_stage back into r8 and emits klog_s1_d1(LEVEL_ERROR=1, SUBSYS_BOOT, tag_policy_seed_fail, k_line, stage) -> 'policy seed fail [legacy: POLICY SEED FAIL] line=<N>'. All-green path emits klog_s1_d1(LEVEL_INFO=3, SUBSYS_BOOT, tag_policy_seed_ok, k_bytes, bytes_written) -> 'policy seed ok [legacy: POLICY SEED OK] bytes=173'. The bracketed `[legacy: POLICY SEED OK]` / `[legacy: POLICY SEED FAIL]` segment is the coverage-gate tag (tools/verify-fingerprint-coverage.sh's OK_TOK regex sees the uppercase OK there and treats the line as an asserted marker — same dual-form discipline rs_fp_ok and the R100-PREP tags follow). Single `push rbp` at entry restores the rsp%16==8 -> %16==0 parity boot_continue_after_ring3's whole call chain depends on (see bin_seeds.pdx module header); matching `pop rbp; ret` at exit. Effects/capabilities {sysreg, mem} @{boot}: mem for every mount_root_vnode / tmpfs_lookup / tmpfs_create / vnode_cache_or_alloc / tmpfs_write call (all declared !{mem} @{}), sysreg transitively via klog_s1_d1's own TSC read and tmpfs_create's !{mem, sysreg}, boot matching every sibling tmpfs-seed witness in this directory. Encoder: mov / lea / cmp / je / call / xor -- all pre-existing, no encoder gap; no add reg,[mem] anywhere (no byte-level path parsing in this module). Labels prefixed policy_seed_; stage counter prefixed _policy_seed_stage.",
      block: {
        push rbp;

        // ---------- Stage 1: recover root + system inode / vnode ----------
        mov rax, 1;
        lea rcx, [rip + _policy_seed_stage];
        mov [rcx], rax;

        call mount_root_vnode;
        cmp rax, 0;
        je policy_seed_fail;
        mov r15, rax;                             // r15 = root_vn_idx
        mov r12, 1;                               // r12 = root_inode_idx

        mov rdi, r12;
        lea rsi, [rip + policy_name_system];
        call tmpfs_lookup;                        // rax = system_inode_idx | 0 (miss)
        cmp rax, 0;
        je policy_seed_fail;
        mov r13, rax;                             // r13 = system_inode_idx

        mov rdi, r15;                             // arg1: parent = root_vn_idx
        mov rsi, r13;                             // arg2: backend = system_inode_idx
        lea rdx, [rip + _tmpfs_vops];             // arg3: ops = &_tmpfs_vops
        call vnode_cache_or_alloc;                // rax = system_vn_idx | 0xFFFF
        mov rcx, 0xFFFF;
        cmp rax, rcx;
        je policy_seed_fail;                      // VNODE_ALLOC_OOM
        mov r14, rax;                             // r14 = system_vn_idx

        // ---------- Stage 2: tmpfs_create(system_inode_idx, "policy", 6, REG=1) ----------
        mov rax, 2;
        lea rcx, [rip + _policy_seed_stage];
        mov [rcx], rax;

        mov rdi, r13;                             // dir_inode_idx = system
        lea rsi, [rip + policy_name_policy];      // "policy\0"
        mov rdx, 6;                               // name_len
        mov rcx, 1;                               // VNODE_TYPE_REG
        call tmpfs_create;                        // rax = policy_inode_idx | 0 | 0xFFFF
        cmp rax, 0;
        je policy_seed_fail;
        mov rcx, 0xFFFF;
        cmp rax, rcx;
        je policy_seed_fail;                      // TMPFS_INODE_ALLOC_OOM
        mov r13, rax;                             // r13 = policy_inode_idx (system_inode_idx retired)

        // ---------- Stage 3: bind /system/policy backend inode to fresh vnode-pool slot ----------
        mov rax, 3;
        lea rcx, [rip + _policy_seed_stage];
        mov [rcx], rax;

        mov rdi, r14;                             // arg1: parent = system_vn_idx
        mov rsi, r13;                             // arg2: backend = policy_inode_idx
        lea rdx, [rip + _tmpfs_vops];             // arg3: ops = &_tmpfs_vops
        call vnode_cache_or_alloc;                // rax = policy_vn_idx | 0xFFFF
        mov rcx, 0xFFFF;
        cmp rax, rcx;
        je policy_seed_fail;                      // VNODE_ALLOC_OOM

        // ---------- Stage 4: tmpfs_write(policy_inode_idx, &bytes, 173, 0) ----------
        // 173 < 4096, so the tmpfs_write single-page constraint
        // (write.pdx §4.5: start_page == end_page) holds by construction
        // with offset=0 — no chunking loop needed. tmpfs_write returns
        // bytes_written (= 173) on success, or 0xFFFFFFFFFFFFFFFF
        // (VOPS_ERR_SENTINEL) on any gate failure.
        mov rax, 4;
        lea rcx, [rip + _policy_seed_stage];
        mov [rcx], rax;

        mov rdi, r13;                             // arg0 = policy_inode_idx
        lea rsi, [rip + _policy_default_bytes];   // arg1 = payload base
        mov rdx, 173;                             // arg2 = len (wire bytes, excludes NUL)
        xor rcx, rcx;                             // arg3 = offset = 0
        call tmpfs_write;                         // rax = bytes_written or sentinel

        // Sentinel check: 0xFFFFFFFFFFFFFFFF (rcx-loaded because
        // AND/CMP has no imm64 form; matches bin_child_hello_seed's
        // Step 7 discipline).
        mov rcx, 0xFFFFFFFFFFFFFFFF;
        cmp rax, rcx;
        je policy_seed_fail;

        // ---------- Success: emit OK fingerprint ----------
        // klog_s1_d1(LEVEL_INFO=3, SUBSYS_BOOT, tag_policy_seed_ok,
        // k_bytes, rax=bytes_written) → composed wire line:
        //   "policy seed ok [legacy: POLICY SEED OK] bytes=<N>\n"
        // rax already holds the tmpfs_write return (bytes_written).
        mov r8, rax;                              // r8 = bytes_written
        mov rdi, 3;                               // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_policy_seed_ok];
        lea rcx, [rip + k_bytes];
        call klog_s1_d1;
        jmp policy_seed_done;

      policy_seed_fail:
        // Read stage counter back and emit:
        //   "policy seed fail [legacy: POLICY SEED FAIL] line=<N>\n"
        lea rax, [rip + _policy_seed_stage];
        mov r8, [rax];
        mov rdi, 1;                               // LEVEL_ERROR
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_policy_seed_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;

      policy_seed_done:
        pop rbp;
        ret
      }
    }
}
