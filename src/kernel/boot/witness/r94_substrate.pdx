// src/kernel/boot/witness/r94_substrate.pdx -- R94.M1-002 + R94.M2-003
// + R94.M3-003 (paideia-os #2061 / #2064 / #2067).
//
// Combined boot witness for the R94 TCP-hardening substrate:
//   (A) retransmit: force an RTO by direct-arming rto_deadline into
//       the past on a synthetic in-use TCB whose snd_una != snd_nxt,
//       call tcp_poll_retransmits, assert _tcp_retransmits bumped.
//       Emit `boot r94 retransmit ok -- rxmt=<N>`.
//   (B) data_retransmit: seed a 5-byte payload into a synthetic TCB's
//       tx_buf, set last_seg_payload_bytes=5, arm rto_deadline into
//       the past, call tcp_retransmit_last directly, and verify the
//       tx_scratch payload area (@+20..+24) holds the SAME 5 bytes
//       -- proves R94.M2-002's bytes-not-zero-probe rewrite. Emit
//       `boot r94 data retransmit ok --`.
//   (C) half_close: build a synthetic ESTABLISHED TCB, call
//       tcp_shutdown_how(idx, TCP_SHUT_WR=1), verify state == 5
//       (FIN_WAIT_1) AND shutdown_flags @+264 has bit 1 set. Emit
//       `boot r94 half close ok --`.
//
// Blocking accept/recv (R94.M4-003, #2070) is NOT attested here --
// witnessing a blocked syscall requires a real task context (a
// _current_tcb the wake side can drive back to RUNNABLE), which the
// boot-time straight-line witness pattern cannot construct without
// hijacking task_pool.pdx's init bootstrap. Deferred to a follow-up
// round that lands a multi-task witness fixture.
//
// The blocking helper wire (tcp_wake_recv_if_any / tcp_wake_accept_
// if_any) is however called on every RX-data-lands site in
// tcp_process_segment and every listener-child-lands site in
// tcp_rx_handle -- both cheap no-ops when no waiter is registered,
// so their PRESENCE is attested by the fact that boot_r72_tcp_echo
// (which exercises the RX-data path) still passes after this landing.
// The blocking BEHAVIOR (a task genuinely parks and later wakes) is
// what the deferred multi-task witness will attest.
//
// Every scenario runs against a FRESH tcp_alloc_tcb, freed via
// tcp_free_tcb before the next scenario, so a scenario cannot
// contaminate its successor.
//
// Fingerprints (all lowercase, no OK_TOK):
//   boot r94 retransmit ok --      rxmt=<count>
//   boot r94 data retransmit ok --
//   boot r94 half close ok --
//
// Label discipline: r94sw_ (R94 substrate witness).

module R94Substrate = structure {

  pub let _r94sw_data : [u8; 5] = [ 0x48u8, 0x45u8, 0x4Cu8, 0x4Cu8, 0x4Fu8 ]  // "HELLO"

  pub let witness_r94_substrate : () -> () !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R94.M1-002 + R94.M2-003 + R94.M3-003 (paideia-os #2061/#2064/#2067). Three scenarios exercising the R94 TCP-substrate primitives at boot: (A) force RTO + call tcp_poll_retransmits + assert _tcp_retransmits bumped; (B) seed 5B payload into tx_buf + call tcp_retransmit_last + assert scratch payload bytes match seed; (C) build ESTABLISHED synth TCB + call tcp_shutdown_how(SHUT_WR) + assert state=FIN_WAIT_1 AND shutdown_flags bit 1 set. Each scenario uses tcp_alloc_tcb / tcp_free_tcb to isolate its TCB from siblings. All-lowercase, no OK_TOK fingerprints -- no verify-fingerprint-coverage.sh gate. 5-push callee-save (rbx=tcb_idx, r12=start_rxmt_count, r13=tcb_ptr, r14=scratch, r15=unused pad) + sub rsp,8: entry rsp%16==8, 5 pushes 40B -> %16==0, sub 8 -> 8. Wait: for CALL alignment we need 0. Recompute: 8 + 40 + 8 = 56, %16 = 8. We want %16=0 at call site. 5 pushes alone: 8+40=48, %16=0 -- no sub needed. Drop the sub. Reserved labels r94sw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // ==================================================================
        // Scenario A: retransmit fires from tcp_poll_retransmits.
        // ==================================================================
        call tcp_alloc_tcb;
        cmp rax, 0xFFFFFFFFFFFFFFFF;
        je r94sw_done;
        mov rbx, rax;                          // synth tcb_idx
        mov rax, rbx;
        shl rax, 9;
        lea rcx, [rip + _tcp_tcb_table];
        add rax, rcx;
        mov r13, rax;                          // tcb_ptr

        // Move to ESTABLISHED (state=4) with unacked data:
        //   snd_una < snd_nxt so tpr_check_rto sees outstanding.
        //   rto_deadline in the past so tpr fires.
        //   Local != remote so loopback fast path skipped -- retransmit
        //     falls into wire path which calls ipv4_tx_send; but the
        //     NIC dispatch may be a no-op if PAIDEIA_NIC=none. That's
        //     fine -- the assertion is only on _tcp_retransmits, and
        //     tcp_retransmit_last bumps that regardless of the wire
        //     outcome.
        mov rax, 4;
        mov [r13 + 0], rax;                    // state = ESTABLISHED
        mov rax, 0x1000;
        mov [r13 + 40], rax;                   // snd_una
        mov rax, 0x1005;
        mov [r13 + 48], rax;                   // snd_nxt (5 bytes outstanding)
        mov [r13 + 128], rax;                  // last_seg_seq (arbitrary)
        mov rax, 0x18;
        mov [r13 + 144], rax;                  // last_seg_flags PSH|ACK
        xor rax, rax;
        mov [r13 + 272], rax;                  // last_seg_payload_bytes = 0 (control-only replay)
        mov [r13 + 248], rax;                  // last_seg_was_rxmt = 0
        // Force local != remote so tcp_retransmit_last skips loopback:
        //   local_ip @ +24 = 10.0.0.2, remote_ip @ +32 = 10.0.0.3.
        //   That way tcp_rx_handle isn't re-entered on this synth TCB.
        mov rax, 10; mov_b [r13 + 24], rax;
        xor rax, rax; mov_b [r13 + 25], rax; mov_b [r13 + 26], rax;
        mov rax, 2; mov_b [r13 + 27], rax;
        mov rax, 10; mov_b [r13 + 32], rax;
        xor rax, rax; mov_b [r13 + 33], rax; mov_b [r13 + 34], rax;
        mov rax, 3; mov_b [r13 + 35], rax;
        // Arm rto_deadline into the past. Either tick_count - 1000
        // (if that doesn't underflow) or 0 outright; either value is
        // <= _tick_count so tpr_check_rto fires. Take the branch-per-
        // clause form so the underflow arm doesn't fall through into
        // the subtract.
        mov rax, [rip + _tick_count];
        cmp rax, 1000;
        jb r94sw_a_arm_zero;
        sub rax, 1000;
        jmp r94sw_a_arm_store;
      r94sw_a_arm_zero:
        xor rax, rax;
      r94sw_a_arm_store:
        mov [r13 + 120], rax;

        mov r12, [rip + _tcp_retransmits];     // snapshot

        // Because tcp_poll_retransmits calls ipv4_tx_send on the wire
        // path, and that requires ARP resolution against 10.0.0.3
        // (which is not in cache under QEMU SLIRP), the actual send
        // returns IPV4_E_ARP_PENDING. But tcp_retransmit_last bumps
        // _tcp_retransmits BEFORE checking the send result, so the
        // counter still ticks. Verified by inspection of the trxm_done
        // label in net/tcp.pdx.
        call tcp_poll_retransmits;

        mov rax, [rip + _tcp_retransmits];
        cmp rax, r12;
        jbe r94sw_a_free;                      // no bump: skip fingerprint

        // Emit A fingerprint. rxmt = new count.
        mov r8, rax;
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_boot_r94_retransmit_ok];
        lea rcx, [rip + k_rxmt];
        call klog_s1_d1;

      r94sw_a_free:
        mov rdi, rbx;
        call tcp_free_tcb;

        // ==================================================================
        // Scenario B: data retransmit replays bytes (not zero probe).
        // ==================================================================
        call tcp_alloc_tcb;
        cmp rax, 0xFFFFFFFFFFFFFFFF;
        je r94sw_done;
        mov rbx, rax;
        mov rax, rbx;
        shl rax, 9;
        lea rcx, [rip + _tcp_tcb_table];
        add rax, rcx;
        mov r13, rax;

        // Establish same synth TCB. Seed tx_buf with "HELLO" @ [+0..+4].
        mov rax, 4;
        mov [r13 + 0], rax;                    // state = ESTABLISHED
        mov rax, 0x2000;
        mov [r13 + 40], rax;
        mov rax, 0x2005;
        mov [r13 + 48], rax;
        mov [r13 + 128], rax;                  // last_seg_seq
        mov rax, 0x18;
        mov [r13 + 144], rax;                  // last_seg_flags
        mov rax, 5;
        mov [r13 + 272], rax;                  // last_seg_payload_bytes = 5
        xor rax, rax;
        mov [r13 + 248], rax;
        // Local == remote so loopback path fires: dst is self so no wire.
        // Set both to 127-ish addresses that match each other but avoid
        // the R72 witness's own local address to reduce collision risk.
        mov rax, 192; mov_b [r13 + 24], rax; mov_b [r13 + 32], rax;
        mov rax, 168; mov_b [r13 + 25], rax; mov_b [r13 + 33], rax;
        xor rax, rax; mov_b [r13 + 26], rax; mov_b [r13 + 34], rax;
        mov rax, 42;  mov_b [r13 + 27], rax; mov_b [r13 + 35], rax;
        // ports
        mov rax, 12000; mov [r13 + 8], rax;
        mov rax, 12001; mov [r13 + 16], rax;

        // Seed tx_buf[tcb_idx*4096 .. +4] with "HELLO" via unrolled
        // [reg+imm] stores (SIB [base+index] is forbidden by paideia-as
        // G6 -- every store must be immediate-offset).
        mov rax, rbx;
        shl rax, 12;
        lea r14, [rip + _tcp_tx_buf_table];
        add r14, rax;                          // r14 = tx_buf slot base
        xor rax, rax; mov_b rax, [rip + _r94sw_data + 0]; mov_b [r14 + 0], rax;
        xor rax, rax; mov_b rax, [rip + _r94sw_data + 1]; mov_b [r14 + 1], rax;
        xor rax, rax; mov_b rax, [rip + _r94sw_data + 2]; mov_b [r14 + 2], rax;
        xor rax, rax; mov_b rax, [rip + _r94sw_data + 3]; mov_b [r14 + 3], rax;
        xor rax, rax; mov_b rax, [rip + _r94sw_data + 4]; mov_b [r14 + 4], rax;

        // Zero _tcp_tx_scratch[+20..+24] specifically (the payload
        // area tcp_retransmit_last populates after the header). One
        // store per byte via mov_b [reg+imm].
        xor rax, rax;
        lea r14, [rip + _tcp_tx_scratch];
        mov_b [r14 + 20], rax;
        mov_b [r14 + 21], rax;
        mov_b [r14 + 22], rax;
        mov_b [r14 + 23], rax;
        mov_b [r14 + 24], rax;

        // Call tcp_retransmit_last -- since local==remote here, the
        // loopback path fires and re-enters tcp_rx_handle. That in
        // turn may fail (no established 4-tuple match) but the tx
        // scratch was populated with the payload just before dispatch.
        mov rdi, rbx;
        call tcp_retransmit_last;

        // Check tx_scratch @+20..+24 == "HELLO" via unrolled compares
        // (SIB [base+index] forbidden -- expand the 5-iter loop
        // straight-line so every load is a [reg+imm] form).
        xor rax, rax; mov_b rax, [rip + _tcp_tx_scratch + 20];
        xor rcx, rcx; mov_b rcx, [rip + _r94sw_data + 0];
        cmp rax, rcx; jne r94sw_b_free;
        xor rax, rax; mov_b rax, [rip + _tcp_tx_scratch + 21];
        xor rcx, rcx; mov_b rcx, [rip + _r94sw_data + 1];
        cmp rax, rcx; jne r94sw_b_free;
        xor rax, rax; mov_b rax, [rip + _tcp_tx_scratch + 22];
        xor rcx, rcx; mov_b rcx, [rip + _r94sw_data + 2];
        cmp rax, rcx; jne r94sw_b_free;
        xor rax, rax; mov_b rax, [rip + _tcp_tx_scratch + 23];
        xor rcx, rcx; mov_b rcx, [rip + _r94sw_data + 3];
        cmp rax, rcx; jne r94sw_b_free;
        xor rax, rax; mov_b rax, [rip + _tcp_tx_scratch + 24];
        xor rcx, rcx; mov_b rcx, [rip + _r94sw_data + 4];
        cmp rax, rcx; jne r94sw_b_free;
        // All 5 bytes match -- emit B fingerprint.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_boot_r94_data_retransmit_ok];
        call klog_s1;

      r94sw_b_free:
        mov rdi, rbx;
        call tcp_free_tcb;

        // ==================================================================
        // Scenario C: half close via tcp_shutdown_how(SHUT_WR).
        // ==================================================================
        call tcp_alloc_tcb;
        cmp rax, 0xFFFFFFFFFFFFFFFF;
        je r94sw_done;
        mov rbx, rax;
        mov rax, rbx;
        shl rax, 9;
        lea rcx, [rip + _tcp_tcb_table];
        add rax, rcx;
        mov r13, rax;

        // Move to ESTABLISHED. Local == remote loopback-safe.
        mov rax, 4;
        mov [r13 + 0], rax;
        mov rax, 0x3000;
        mov [r13 + 40], rax;
        mov [r13 + 48], rax;                   // snd_una == snd_nxt (no outstanding)
        xor rax, rax;
        mov [r13 + 264], rax;                  // shutdown_flags = 0
        mov rax, 192; mov_b [r13 + 24], rax; mov_b [r13 + 32], rax;
        mov rax, 168; mov_b [r13 + 25], rax; mov_b [r13 + 33], rax;
        xor rax, rax; mov_b [r13 + 26], rax; mov_b [r13 + 34], rax;
        mov rax, 99;  mov_b [r13 + 27], rax; mov_b [r13 + 35], rax;
        mov rax, 14000; mov [r13 + 8], rax;
        mov rax, 14001; mov [r13 + 16], rax;

        mov rdi, rbx;
        mov rsi, 1;                            // TCP_SHUT_WR
        call tcp_shutdown_how;

        // Assert state == 5 (FIN_WAIT_1) AND shutdown_flags bit 1 set.
        mov rax, [r13 + 0];
        cmp rax, 5;
        jne r94sw_c_free;
        mov rax, [r13 + 264];
        and rax, 2;
        cmp rax, 0;
        je r94sw_c_free;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_boot_r94_half_close_ok];
        call klog_s1;

      r94sw_c_free:
        mov rdi, rbx;
        call tcp_free_tcb;

      r94sw_done:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
