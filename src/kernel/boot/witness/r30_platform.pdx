      // refusals, the AT-command FSM (DIAL -> RINGING; ANSWER ->
      // ACTIVE; DTMF side-effect; HANGUP -> IDLE), the BAD_STATE
      // refusal on illegal edges, and the SCO frame contract for
      // both codecs.  PLACEMENT AFTER a2rtx_witness_call IS
      // DELIBERATE -- HFP is a peer profile to A2DP under the same
      // R39.M2 HCI transport; the log order mirrors the round order.
      //
      // Fingerprint: R39 HFP OK
      // ============================================================
      hfp_witness_call:
          call hfp_witness

      // ============================================================
      // R39.M6-002 (#1344): BT HID (HID over L2CAP) witness.
      //
      // Body in tests/kernel/drivers/bt/bt_hid_synth.pdx.  Wires
