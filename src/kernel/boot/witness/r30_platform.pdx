      // exercises the DUP_ROW refusal, the role/codec/rate/duration/
      // direction validators, and the LC3 frame-length contract on
      // both the happy path and the min/max refusals.  PLACEMENT
      // AFTER bt_hid_witness_call IS DELIBERATE -- the role table
      // is disjoint from HFP + BT HID's tables, but the log order
      // matches the R39.M6 issue order (#1345 follows #1344).
      //
      // Like every other marker on this path, IT ASSERTS NOTHING
      // ABOUT A LIVE LC3 ENCODE OR AN ISOCHRONOUS CIS ESTABLISHMENT.
      // The scaffold's purpose is the table where real BAP/CAP will
      // mount when the R32 crypto server can back the SEALED LTK
      // path end-to-end (that milestone closes KIND_BT_PAIRING's
      // sealed row); until then the fixture reports on the
      // structural contract and NOTHING MORE.
      //
      // Fingerprint: R39 LE AUDIO OK
      // ============================================================
      le_audio_witness_call:
          call le_audio_witness

      // ============================================================
      // R40.M1-001 (#1347): IPU6 PCI probe + BAR mapping witness.
