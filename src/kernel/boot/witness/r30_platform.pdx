      // events (R31 EC, R33 SOF, R35 DMA consent, R38 WPA supplicant,
      // R39 BT pairing, R40 MBIM) SHOULD use henceforth.  Exercises
      // the validators (evt / kind / field), the pack/unpack round
      // trip for aud_pack_at + aud_pack_payload + aud_pack_principal,
      // the audit_emit end-to-end path against a live drv_audit_seq
      // snapshot (assert seq advances by exactly 1 on OK, does NOT
      // advance on refusal), and the composition through the actual
      // ring by reading field 4 (principal) back with
      // drv_audit_field(back=0, field=4) and decoding with the
      // schema's unpackers -- the property that fails silently if
      // audit_emit ever grows a private cache.
      //
      // PLACEMENT AFTER mbim_witness_call IS DELIBERATE -- the
      // unification is the R40.M5 closer, and its record in the
      // drv_audit ring must not interleave with the M4 subsystem
      // witnesses whose own driver-audit records they emit into the
      // same ring.  This witness DOES advance the ring (stages 8,
      // 12), so any witness downstream that reads the newest record
      // relatively (drv_audit_field(back=0, ...)) would see this
      // fixture's records instead of its own; no such reader exists
      // downstream of mbim_witness_call today.  The failure taxonomy
      // 0xFFFFF180..0xFFFFF18F is disjoint from every other band --
      // adjacent used band above: mbim 0xFFFFF190..9F; adjacent free
      // band below: unassigned 0xFFFFF170..7F (reserved for R41).
      //
      // The audit_schema module is pure schema (pack/unpack + one
      // stateless wrapper); it holds no .bss state, so it takes no
      // per-module confinement in tools/build.sh beyond the
      // arity-pin block matching regdomain_channel /
      // backlight_channel / sensor_read_channel.
      //
      // Fingerprint: R40 AUDIT SCHEMA OK
      // ============================================================
      audit_schema_witness_call:
          call audit_schema_witness

      // ============================================================
      // R41.M1-001 (#1365) + R41.M1-002 (#1366) + R41.M1-003 (#1367):
      // semantic-term-core -- the shared lexer + parser + query type
      // system that both the framebuffer terminal (R41.M2+) and the
      // GUI terminal (R44) will consume.
      //
      // Bodies in tests/kernel/semterm/{lexer,parser,types}_synth.pdx.
      // Out of line for the reason every schema fixture in this module
      // is: each drives its module through a shared teardown path, and
      // an inline block whose fail branch jumped past that teardown
      // would leak fixture state into the next witness. Each also
      // exercises refusals against its own failure taxonomy (lexer
      // 0xFFFFF170..7F, parser 0xFFFFF160..6F, types 0xFFFFF150..5F,
      // all pairwise disjoint from every other band in the tree).
      //
      // PLACEMENT AFTER audit_schema_witness_call IS DELIBERATE. R41
      // opens after R40 closes -- the semantic terminal is the first
      // frontend on top of the driver-closure the R40 audit-schema
      // unification finished. Each of the three witnesses is
      // self-contained (no cap slots, no shared row tables); the log
      // reads their fingerprints in issue order.
      //
      // THREE FINGERPRINTS, one per issue:
      //
      //   R41 SEMTERM LEXER OK    <- #1365
      //   R41 SEMTERM PARSER OK   <- #1366
      //   R41 SEMTERM TYPES OK    <- #1367
      //
      // Three rather than one because the three modules can fail for
      // unrelated reasons (a broken keyword dispatch, a busted AST
      // arena bound, a type-mismatch refusal that stopped biting), and
      // the ordered-subsequence golden needs the three failures
      // distinguishable in the log.
      //
      // The types witness depends on the parser's arena (it composes
      // a synthetic BIN_OP AST for stage 7) and the parser depends on
      // the lexer's cursor (it drives lex_next for every token). The
      // call order matches that dependency: lexer -> parser -> types.
      // Running them in a different order would flip the "check the
      // dependent module runs correctly against a freshly reset upper
      // module" assertion each fixture makes at its own boundary.
      //
      // Like every other marker on this path, THEY ASSERT NOTHING
      // ABOUT A LIVE KEYBOARD DELIVERY, A LIVE FRAMEBUFFER FRONTEND
      // OR A SCHEMA CATALOGUE. src/kernel/core/semterm/{lexer,
      // parser,types}.pdx §0 records the deferrals rather than
      // leaving them to be discovered.
      // ============================================================
      lexer_witness_call:
          call lexer_witness

      parser_witness_call:
          call parser_witness

      types_witness_call:
          call types_witness

      // ============================================================
      // R41.M2-001 (#1368) + R41.M2-002 (#1369) + R41.M2-003 (#1370):
      // semantic-term-core -- the query engine (evaluator), the
      // typed data-source registry it resolves FROM against, and the
      // streaming result-set buffer it pushes rows into.
      //
      // Bodies in tests/kernel/semterm/{engine,sources,resultset}_
      // synth.pdx. Same out-of-line pattern as R41.M1 for the same
      // reason: each fixture drives its module through a shared
      // teardown path, and an inline block whose fail branch jumped
      // past that teardown would leak fixture state into the next
      // witness. Each also exercises refusals against its own
      // failure taxonomy (engine 0xFFFFF0B0..BF, sources
      // 0xFFFFF0A0..AF, resultset 0xFFFFF090..9F, all pairwise
      // disjoint from every other band in the tree, and from R41.M1's
      // bands 0xFFFFF150..7F).
      //
      // PLACEMENT AFTER types_witness_call IS DELIBERATE. R41.M2
      // opens above R41.M1 -- the engine consumes the parser's arena
      // (par_node_get) and the type checker's inference
      // (tyq_infer), and the sources / result-set modules are the
      // engine's other two collaborators. Running the M2 witnesses
      // before the M1 stack was validated would collapse two
      // different failure signals into one.
      //
      // THREE FINGERPRINTS, one per issue:
      //
      //   R41 SEMTERM ENGINE OK    <- #1368
      //   R41 SEMTERM SOURCES OK   <- #1369
      //   R41 SEMTERM RESULTSET OK <- #1370
      //
      // Three rather than one because the three modules can fail
      // independently: a broken plan validator, a duplicate-slot
      // scan that stopped biting, or a pack/unpack round trip that
      // dropped the tag. The ordered-subsequence golden needs the
      // three failures distinguishable in the log.
      //
      // Call order is ENGINE -> SOURCES -> RESULTSET. Each witness
      // is self-contained (it resets every module it touches on
      // entry AND on exit) so the runtime dependency (engine calls
      // src_lookup + rs_push) does NOT dictate the call order:
      // engine_witness re-drives src_reset internally, and both
      // sources_witness and resultset_witness stand alone.
      //
      // Like every other marker on this path, THEY ASSERT NOTHING
      // ABOUT A LIVE KEYBOARD DELIVERY, A LIVE FRAMEBUFFER FRONTEND
      // OR A SCHEMA CATALOGUE. src/kernel/core/semterm/{engine,
      // sources,resultset}.pdx §0 records the deferrals rather than
      // leaving them to be discovered.
      // ============================================================
      engine_witness_call:
          call engine_witness

      sources_witness_call:
          call sources_witness

      resultset_witness_call:
          call resultset_witness

      // ============================================================
      // R41.M3-001 (#1371) + R41.M3-002 (#1372) + R41.M3-003 (#1373):
      // semantic-term chart-composition layer -- the plot compositor
      // (text-mode cell buffer + glyph primitives), the layout
      // engine (grid pane arena + splits), and the color palette
      // (default RGB + ANSI SGR + colorblind-safe series + xterm-256
      // extended).
      //
      // Bodies in tests/kernel/semterm/{plot,layout,palette}_synth.pdx.
      // Same out-of-line pattern as R41.M2: each fixture drives its
      // module through a shared teardown path, and an inline block
      // whose fail branch jumped past that teardown would leak
      // fixture state into the next witness. Each also exercises
      // refusals against its own failure taxonomy (plot
      // 0xFFFFF080..8F, layout 0xFFFFF070..7F, palette
      // 0xFFFFF060..6F, all pairwise disjoint from every other band
      // in the tree, and from R41.M1's bands 0xFFFFF150..7F and
      // R41.M2's 0xFFFFF090..BF).
      //
      // PLACEMENT AFTER resultset_witness_call IS DELIBERATE. R41.M3
      // opens above R41.M2 -- the plot compositor consumes cells the
      // result-set eventually feeds, and the layout engine carves
      // the plot canvas the compositor writes into. Running the M3
      // witnesses before the M2 stack was validated would collapse
      // two different failure signals into one.
      //
      // THREE FINGERPRINTS, one per issue:
      //
      //   R41 SEMTERM PLOT OK    <- #1371
      //   R41 SEMTERM LAYOUT OK  <- #1372
      //   R41 SEMTERM PALETTE OK <- #1373
      //
      // Three rather than one because the three modules can fail
      // independently: a broken glyph selector, a split arithmetic
      // that stopped biting, or an ANSI SGR ordinal that drifted
      // from the xterm canon. The ordered-subsequence golden needs
      // the three failures distinguishable in the log.
      //
      // Call order is PLOT -> LAYOUT -> PALETTE. Each witness is
      // self-contained (it resets its module on entry AND on exit)
      // so the compose-time dependency (compositor writes cells the
      // layout carves, formatter consults the palette) does NOT
      // dictate the call order: every witness stands alone.
      //
      // Like every other marker on this path, THEY ASSERT NOTHING
      // ABOUT A LIVE KEYBOARD DELIVERY, A LIVE FRAMEBUFFER FRONTEND
      // OR A LIVE CHART. src/kernel/core/semterm/{plot,layout,
      // palette}.pdx §0 records the deferrals rather than leaving
      // them to be discovered.
      // ============================================================
      plot_witness_call:
          call plot_witness

      layout_witness_call:
          call layout_witness

      palette_witness_call:
          call palette_witness

      // ============================================================
      // R41.M4-001 (#1374) + R41.M4-002 (#1375) + R41.M4-003 (#1376):
      // semantic-term framebuffer frontend -- the fb frontend seam
      // (cursor + render-prepare + synthetic HID input queue), the
      // line editor (readline-analog insertion + kill/yank + 32-slot
      // history + completion hook), and the pager (page arithmetic +
      // SPACE/b/q// navigation).
      //
      // Bodies in tests/kernel/semterm/{fb_frontend,line_editor,
      // pager}_synth.pdx. Same out-of-line pattern as R41.M3: each
      // fixture drives its module through a shared teardown path, and
      // an inline block whose fail branch jumped past that teardown
      // would leak fixture state into the next witness. Each also
      // exercises refusals against its own failure taxonomy
      // (fb_frontend 0xFFFFF050..5F, line_editor 0xFFFFF040..4F,
      // pager 0xFFFFF030..3F, all pairwise disjoint from every other
      // band in the tree, and from R41.M1's 0xFFFFF150..7F, R41.M2's
      // 0xFFFFF090..BF, R41.M3's 0xFFFFF060..8F).
      //
      // PLACEMENT AFTER palette_witness_call IS DELIBERATE. R41.M4
      // opens above R41.M3 -- the fb frontend consumes the plot
      // canvas (via a render-command packing that a downstream
      // blitter reads plt_get against), the line editor sources
      // bytes the fb frontend collects, and the pager paginates the
      // result-set the query engine populates. Running the M4
      // witnesses before the M3 stack was validated would collapse
      // two different failure signals into one.
      //
      // THREE FINGERPRINTS, one per issue:
      //
      //   R41 SEMTERM FB FRONTEND OK  <- #1374
      //   R41 SEMTERM LINE EDITOR OK  <- #1375
      //   R41 SEMTERM PAGER OK        <- #1376
      //
      // Three rather than one because the three modules can fail
      // independently: a broken cursor overlay, a shift-and-insert
      // that stopped biting, or a page-arithmetic drift that hid the
      // last partial page. The ordered-subsequence golden needs the
      // three failures distinguishable in the log.
      //
      // Call order is FB FRONTEND -> LINE EDITOR -> PAGER. Each
      // witness is self-contained (it resets its module on entry AND
      // on exit) so the compose-time dependency (fb frontend sources
      // keys the editor consumes, pager paginates the result-set the
      // engine populates) does NOT dictate the call order.
      //
      // Like every other marker on this path, THEY ASSERT NOTHING
      // ABOUT A LIVE KEYBOARD DELIVERY, A LIVE FRAMEBUFFER FRONTEND,
      // OR A LIVE RESULT-SET FORMATTER. src/kernel/core/semterm/{
      // fb_frontend,line_editor,pager}.pdx §0 records the deferrals
      // rather than leaving them to be discovered.
      // ============================================================
      fb_frontend_witness_call:
          call fb_frontend_witness

      line_editor_witness_call:
          call line_editor_witness

      pager_witness_call:
          call pager_witness

      // ============================================================
      // R41.M5-001 (#1377) + R41.M5-002 (#1378): semantic-term
      // recovery-mode integration + session log.
      //
      // Two modules close R41 on top of the R41.M4 framebuffer
      // frontend: recovery (arm flag + safectl (KIND, cap-slot)
      // bind + RO-by-default verb union) and session_log (per-attach
      // session id + 64-slot execution ring + audit-forward honesty
      // pin for the eventual R40.M5 audit_schema widening at
      // AUD_EV_SEMTERM_QUERY_EXEC).
      //
      // Bodies in tests/kernel/semterm/{recovery,session_log}_synth.pdx.
      // Same out-of-line pattern as R41.M4: each fixture drives its
      // module through a shared teardown path so an inline fail branch
      // cannot leak fixture state into the next witness. Each also
      // exercises refusals against its own failure taxonomy
      // (recovery 0xFFFFF020..2F, session_log 0xFFFFF010..1F, both
      // pairwise disjoint from every other band in the tree, from
      // R41.M1's 0xFFFFF150..7F, R41.M2's 0xFFFFF090..BF, R41.M3's
      // 0xFFFFF060..8F, R41.M4's 0xFFFFF030..5F).
      //
      // PLACEMENT AFTER pager_witness_call IS DELIBERATE. R41.M5
      // closes the round -- the recovery arbiter parks a safectl
      // bind the fb frontend reads at attach time, and the session
      // log records every query the pager paginates. Running the M5
      // witnesses before the M4 stack was validated would collapse
      // two different failure signals into one.
      //
      // TWO FINGERPRINTS, one per issue:
      //
      //   R41 SEMTERM RECOVERY OK     <- #1377
      //   R41 SEMTERM SESSION LOG OK  <- #1378
      //
      // Two rather than one because the two modules can fail
      // independently: a broken verb gate leaking an UPDATE past the
      // RO default, or a ring wrap that hid the oldest-first mapping.
      // The ordered-subsequence golden needs the two failures
      // distinguishable in the log.
      //
      // Call order is RECOVERY -> SESSION LOG. Each witness is self-
      // contained (it resets its module on entry AND on exit) so the
      // compose-time dependency (recovery arms the terminal, session
      // log records what the terminal executes) does NOT dictate the
      // call order: every witness stands alone.
      //
      // R41.M5-003 (#1379) is the HW-smoke placeholder at
      // tests/kernel/semterm/hw_smoke_r41_placeholder.pdx per D7
      // gated:hardware; it is NOT wired into this witness path (its
      // procedure lives in tools/hw-smoke-r41-fb-terminal.md).
      //
      // Like every other marker on this path, THESE ASSERT NOTHING
      // ABOUT A LIVE CMDLINE PARSER, A LIVE SAFECTL DISPATCHER, OR A
      // LIVE AUDIT FORWARDER. src/kernel/core/semterm/{recovery,
      // session_log}.pdx §0 records the deferrals rather than leaving
      // them to be discovered.
      // ============================================================
      recovery_witness_call:
          call recovery_witness

      session_log_witness_call:
          call session_log_witness

      // ============================================================
      // R42.M1-001 .. R42.M1-004 (#1380..#1383): PDXFS-v1 CoW walker.
      //
      // Four modules deliver the CoW skeleton the eventual NVMe write
      // path (#906) will persist: refcount (per-block 16-bit reference
      // count table), cow_read (snapshot-chain walk + direct-mapped
      // cache), cow_write (allocate + copy + link on SHARED writes,
      // in-place on UNIQUE), and cow_gc (scan + park zero-refcount
      // blocks onto an internal free list).
      //
      // Bodies in tests/kernel/fs/pdxfs/{refcount,cow_read,cow_write,
      // cow_gc}_synth.pdx. Same out-of-line pattern as R41.M4/M5:
      // each fixture drives its module through a shared teardown
      // path so an inline fail branch cannot leak fixture state
      // into the next witness. Each also exercises refusals against
      // its own failure taxonomy:
      //   refcount   0xFFFFF000..0F   (adjacent above: session_log
      //                                 0xFFFFF010..1F).
      //   cow_read   0xFFFFEFF0..FF
      //   cow_write  0xFFFFEFE0..EF
      //   cow_gc     0xFFFFEFD0..DF
      // All four disjoint from every other band already reserved on
      // this path.
      //
      // PLACEMENT AFTER session_log_witness_call IS REQUIRED. R41
      // closes the semterm stack; R42 opens the pdxfs stack. The two
      // rounds are functionally independent -- the cow walker does
      // not talk to the terminal -- but keeping the pdxfs witnesses
      // downstream of the terminal witnesses means a boot log that
      // stops mid-pdxfs still reports the terminal PASS, and the
      // ordered-subsequence golden distinguishes the two rounds.
      //
      // FOUR FINGERPRINTS, one per issue:
      //
      //   R42 PDXFS REFCOUNT OK    <- #1380
      //   R42 PDXFS COW READ OK    <- #1381
      //   R42 PDXFS COW WRITE OK   <- #1382
      //   R42 PDXFS COW GC OK      <- #1383
      //
      // Call order is REFCOUNT -> COW READ -> COW WRITE -> COW GC.
      // cow_write depends on refcount + cow_read at execution time
      // (each witness resets its dependency modules internally, so
      // the compose-time dependency does not dictate call order; the
      // order is the natural bottom-up order of the module stack).
      //
      // Like every other marker on this path, THESE ASSERT NOTHING
      // ABOUT A LIVE NVMe WRITE PATH, A LIVE MOUNT, OR A LIVE JOURNAL.
      // src/kernel/core/fs/pdxfs/{refcount,cow_read,cow_write,cow_gc}
      // .pdx §0 records the deferrals rather than leaving them to be
      // discovered.
      // ============================================================
      refcount_witness_call:
          call refcount_witness

      cow_read_witness_call:
          call cow_read_witness

      cow_write_witness_call:
          call cow_write_witness

      cow_gc_witness_call:
          call cow_gc_witness

      // ============================================================
      // R42.M2-001 .. R42.M2-004 (#1384..#1387): PDXFS-v1 JOURNAL.
      //
      // Four modules deliver the WAL + commit-ordering + replay +
      // tear-detection skeleton the eventual NVMe write path (#906)
      // will persist:
      //
      //   wal.pdx            -- ring buffer of tx records; write-ahead
      //                          invariant refusal on wal_block_write
      //                          before the covering wal_fsync.
      //   journal_fence.pdx  -- commit table naming WAL seqs; refuses
      //                          commit without a preceding fence and
      //                          duplicate commits.
      //   journal_replay.pdx -- mount-time walker classifying every
      //                          WAL record as APPLIED/DISCARDED via
      //                          jfn_is_committed lookup; idempotent.
      //   journal_csum.pdx   -- CRC32C-style expected checksum table;
      //                          refuses replay for records whose
      //                          wal_checksum_at fails to verify.
      //
      // Bodies in tests/kernel/fs/pdxfs/{wal,journal_fence,journal_
      // replay,journal_csum}_synth.pdx. Same out-of-line pattern as
      // R42.M1: each fixture drives its module through a shared
      // teardown path so an inline fail branch cannot leak fixture
      // state into the next witness. Each also exercises refusals
      // against its own failure taxonomy:
      //   wal              0xFFFFEFC0..CF
      //   journal_fence    0xFFFFEFB0..BF
      //   journal_replay   0xFFFFEFA0..AF
      //   journal_csum     0xFFFFEF90..9F
      // All four disjoint from every other band already reserved on
      // this path.
      //
      // PLACEMENT AFTER cow_gc_witness_call IS REQUIRED. R42.M1
      // closes the CoW walker; R42.M2 opens the journal above it.
      // The two sub-milestones are functionally independent -- the
      // journal does not talk to the cow walker at all today -- but
      // keeping the journal witnesses downstream of the cow walker
      // means a boot log that stops mid-journal still reports the
      // cow-walker PASS, and the ordered-subsequence golden
      // distinguishes the two sub-milestones.
      //
      // FOUR FINGERPRINTS, one per issue:
      //
      //   R42 PDXFS WAL OK                   <- #1384
      //   R42 PDXFS JOURNAL FENCE OK         <- #1385
      //   R42 PDXFS JOURNAL REPLAY OK        <- #1386
      //   R42 PDXFS JOURNAL CSUM OK          <- #1387
      //
      // Call order is WAL -> JOURNAL FENCE -> JOURNAL REPLAY ->
      // JOURNAL CSUM. journal_fence + journal_replay + journal_csum
      // each depend on wal at execution time (each witness resets
      // its dependency modules internally, so the compose-time
      // dependency does not dictate call order; the order is the
      // natural bottom-up order of the module stack).
      //
      // Like every other marker on this path, THESE ASSERT NOTHING
      // ABOUT A LIVE NVMe WRITE PATH, A LIVE MOUNT, OR A LIVE
      // CRASH-RECOVERY WALK. src/kernel/core/fs/pdxfs/{wal,journal_
      // fence,journal_replay,journal_csum}.pdx §0 records the
      // deferrals rather than leaving them to be discovered.
      // ============================================================
      wal_witness_call:
          call wal_witness

      journal_fence_witness_call:
          call journal_fence_witness

      journal_replay_witness_call:
          call journal_replay_witness

      journal_csum_witness_call:
          call journal_csum_witness

      // ============================================================
      // R42.M3-001 .. R42.M3-004 (#1388..#1391): PDXFS-v1 SNAPSHOT.
      //
      // Four modules deliver the snapshot skeleton the eventual NVMe
      // write path (#906) will persist:
      //
      //   snap_create.pdx     -- freeze-and-name registry with per-
      //                           create refbump accounting.
      //   snap_mount_ro.pdx   -- resolve name -> snap_id via
      //                           snc_lookup, park in mounts table,
      //                           refuse every write with EROFS.
      //   snap_diff.pdx       -- walk two snapshot block tables and
      //                           emit added/removed/modified per
      //                           block, cursor-resumable.
      //   snap_prune.pdx      -- retention policy (LAST N / DAILY N /
      //                           WEEKLY N); delete slots outside
      //                           policy with per-delete refdec
      //                           accounting.
      //
      // Bodies in tests/kernel/fs/pdxfs/{snap_create,snap_mount_ro,
      // snap_diff,snap_prune}_synth.pdx. Same out-of-line pattern as
      // R42.M1/M2: each fixture drives its module through a shared
      // teardown path so an inline fail branch cannot leak fixture
      // state into the next witness. Each also exercises refusals
      // against its own failure taxonomy:
      //   snap_create    0xFFFFEF80..8F
      //   snap_mount_ro  0xFFFFEF70..7F
      //   snap_diff      0xFFFFEF60..6F
      //   snap_prune     0xFFFFEF50..5F
      // All four disjoint from every other band already reserved on
      // this path.
      //
      // PLACEMENT AFTER journal_csum_witness_call IS REQUIRED. R42.M2
      // closes the journal; R42.M3 opens the snapshot layer above it.
      // The two sub-milestones are functionally independent -- the
      // snapshot walker does not talk to the journal today -- but
      // keeping the snapshot witnesses downstream of the journal
      // witnesses means a boot log that stops mid-snapshot still
      // reports the journal PASS, and the ordered-subsequence golden
      // distinguishes the two sub-milestones.
      //
      // FOUR FINGERPRINTS, one per issue:
      //
      //   R42 PDXFS SNAP CREATE OK      <- #1388
      //   R42 PDXFS SNAP MOUNT RO OK    <- #1389
      //   R42 PDXFS SNAP DIFF OK        <- #1390
      //   R42 PDXFS SNAP PRUNE OK       <- #1391
      //
      // Call order is SNAP CREATE -> SNAP MOUNT RO -> SNAP DIFF ->
      // SNAP PRUNE. snap_mount_ro depends on snap_create at execution
      // time (each witness resets its dependency modules internally,
      // so the compose-time dependency does not dictate call order;
      // the order is the natural bottom-up order of the snapshot
      // stack).
      //
      // Like every other marker on this path, THESE ASSERT NOTHING
      // ABOUT A LIVE NVMe WRITE PATH, A LIVE MOUNT, OR A LIVE
      // RETENTION PASS. src/kernel/core/fs/pdxfs/{snap_create,snap_
      // mount_ro,snap_diff,snap_prune}.pdx §0 records the deferrals
      // rather than leaving them to be discovered.
      // ============================================================
      snap_create_witness_call:
          call snap_create_witness

      snap_mount_ro_witness_call:
          call snap_mount_ro_witness

      snap_diff_witness_call:
          call snap_diff_witness

      snap_prune_witness_call:
          call snap_prune_witness

      // ============================================================
      // R42.M4-001 (#1392), R42.M4-002 (#1393), R42.M4-003 (#1394):
      // PDXFS lite -> v1 upgrade path + dry-run + read-only compat.
      //
      // Three siblings, one call site each, in the order that follows
      // the caller's likely workflow:
      //
      //   1. UPGRADE_V1     the in-place upgrade authority. Bodies
      //                     seed a fresh scaffold volume every call,
      //                     so ordering does not couple them to
      //                     dryrun or lite_reader.
      //   2. UPGRADE_DRYRUN the pre-flight walk that answers "should
      //                     I commit?" without side effects.
      //   3. LITE_READER    the "keep running against lite" read-only
      //                     path for callers who do not upgrade.
      //
      // PLACEMENT AFTER snap_prune_witness_call IS DELIBERATE. Each
      // R42.M4 witness resets its own scaffold on entry and on exit,
      // so the compose-time dependency does not dictate placement --
      // the order is the natural top-down order of the upgrade story
      // (upgrade -> dry-run -> compat), and it lands after the last
      // R42.M3 witness so the snapshot-chain state stays untouched
      // across this block.
      //
      // THREE FINGERPRINTS, one per issue:
      //
      //   R42 PDXFS UPGRADE V1 OK       <- #1392
      //   R42 PDXFS UPGRADE DRYRUN OK   <- #1393
      //   R42 PDXFS LITE READER OK      <- #1394
      //
      // Like every other marker on this path, THESE ASSERT NOTHING
      // ABOUT A LIVE NVMe WRITE PATH, A LIVE JOURNAL, OR A LIVE
      // LEGACY VOLUME. src/kernel/core/fs/pdxfs/{upgrade_v1,upgrade_
      // dryrun,lite_reader}.pdx §0 records the deferrals.
      // ============================================================
      upgrade_v1_witness_call:
          call upgrade_v1_witness

      upgrade_dryrun_witness_call:
          call upgrade_dryrun_witness

      lite_reader_witness_call:
          call lite_reader_witness

      // ============================================================
      // R42.M4-004 (#1395), R42.M5-001 (#1396), R42.M5-002 (#1397),
      // R42.M5-003 (#1398): the R42 PDXFS v1 closing quartet.
      //
      // Four siblings, one call site each, in the order the caller's
      // workflow crosses them:
      //
      //   1. FS_CHANNEL         the RPC surface between callers and the
      //                         pdxfs supervisor. Schema-only: no state
      //                         beyond the witness's own stage counter.
      //   2. NVME_WRITE         the FS-side batcher that turns cow_write
      //                         calls into NVMe submissions. Resets its
      //                         own SQ on entry and on exit.
      //   3. DURABILITY         the fsync-analog + barrier sequencer.
      //                         Resets its own per-fd level table on
      //                         entry and on exit.
      //   4. CONCURRENT_STRESS  100 handles across refcount + wal +
      //                         nvme_write, mixed sizes. Resets the
      //                         three sibling modules on entry and on
      //                         exit so downstream witnesses see clean
      //                         state.
      //
      // PLACEMENT AFTER lite_reader_witness_call IS DELIBERATE. Each
      // witness resets its own scaffold on entry and on exit, so the
      // compose-time dependency does not dictate placement -- the
      // order is the natural top-down order of the R42 story
      // (channel schema -> device path -> policy -> stress) and it
      // lands after the last R42.M4 witness so the upgrade-path
      // state stays untouched across this block.
      //
      // FOUR FINGERPRINTS, one per issue:
      //
      //   R42 FS CHAN OK                    <- #1395
      //   R42 PDXFS NVME WRITE OK           <- #1396
      //   R42 PDXFS DURABILITY OK           <- #1397
      //   R42 PDXFS CONCURRENT STRESS OK    <- #1398
      //
      // Like every other marker on this path, THESE ASSERT NOTHING
      // ABOUT A LIVE NVMe DEVICE, A LIVE JOURNAL FLUSH, OR A LIVE
      // pdxfs SUPERVISOR. src/kernel/core/ipc/fs_channel.pdx,
      // src/kernel/core/fs/pdxfs/{nvme_write,durability}.pdx §0 and
      // tests/kernel/fs/pdxfs/concurrent_stress_synth.pdx §0 record
      // the deferrals.
      // ============================================================
      fs_channel_witness_call:
          call fs_channel_witness

      nvme_write_witness_call:
          call nvme_write_witness

      durability_witness_call:
          call durability_witness

      concurrent_stress_witness_call:
          call concurrent_stress_witness

      // ============================================================
      // R44.M1-001 (#1400) + R44.M1-002 (#1401) + R44.M1-003 (#1402):
      // semantic-term GUI shell -- the R44 replacement for the R41.M4
      // fb_frontend seam. Three modules open R44.M1 on top of R41's
      // semantic-term-core: gui_shell (window shell + four named
      // regions + input event queue), gui_layout (up to 8 tabs and 16
      // panes with nested horizontal / vertical splits + focus
      // routing), and gui_theme (theme + font + font-size registry
      // with a session_log-forward persist counter).
      //
      // Bodies in tests/kernel/semterm/{gui_shell,gui_layout,
      // gui_theme}_synth.pdx. Same out-of-line pattern as R41.M4:
      // each fixture drives its module through a shared teardown
      // path so an inline fail branch cannot leak fixture state
      // into the next witness. Each also exercises refusals against
      // its own failure taxonomy (gui_shell 0xFFFFEED0..DF,
      // gui_layout 0xFFFFEEC0..CF, gui_theme 0xFFFFEEB0..BF, all
      // pairwise disjoint from every other band in the tree, and
      // from durability 0xFFFFEEF0..FF, concurrent_stress
      // 0xFFFFEEE0..EF).
      //
      // PLACEMENT AFTER concurrent_stress_witness_call IS DELIBERATE.
      // R44.M1 opens above R42's storage supervisor because the GUI
      // shell will (in R44+) mount tabs whose sessions read from
      // pdxfs-hosted queries; running the GUI witnesses before the
      // storage stack was validated would collapse two different
      // failure signals into one. It also stays inside r30_platform
      // rather than a new boot-witness file so the ordered-golden
      // does not fragment across two aggregators.
      //
      // THREE FINGERPRINTS, one per issue:
      //
      //   R44 SEMTERM GUI SHELL OK   <- #1400
      //   R44 SEMTERM GUI LAYOUT OK  <- #1401
      //   R44 SEMTERM GUI THEME OK   <- #1402
      //
      // Three rather than one because the modules can fail
      // independently: a broken region visibility gate that lets
      // focus land on a hidden region, a pane bump allocator that
      // hands out the same slot twice, or a persist counter that
      // never drains. The ordered-subsequence golden needs the
      // three failures distinguishable in the log.
      //
      // Call order is GUI SHELL -> GUI LAYOUT -> GUI THEME. Each
      // witness is self-contained (it resets its module on entry
      // AND on exit) so the compose-time dependency (the shell
      // hosts the layout, the layout's leaves render under the
      // theme) does NOT dictate call order.
      //
      // Like every other marker on this path, THESE ASSERT NOTHING
      // ABOUT A LIVE G12 TOOLKIT PAINT, A LIVE HID EVENT ROUTER, OR
      // A LIVE SESSION-LOG WRITER. src/kernel/core/semterm/{
      // gui_shell,gui_layout,gui_theme}.pdx §0 records the
      // deferrals rather than leaving them to be discovered.
      // ============================================================
      gui_shell_witness_call:
          call gui_shell_witness

      gui_layout_witness_call:
          call gui_layout_witness

      gui_theme_witness_call:
          call gui_theme_witness

      // ============================================================
      // R44.M2-001 (#1403) + R44.M2-002 (#1404) + R44.M2-003 (#1405):
      // semantic-term GUI Vello rendering + chart primitives + smooth
      // scrolling. Three modules layer atop the R44.M1 GUI shell /
      // layout / theme seams to deliver typography-quality rendering
      // (gui_vello: subpixel-aware glyph atlas + four-layer scene
      // composition, routing R41 resultset rows through the R37 GPU
      // Vello backend), chart primitives (gui_charts: bar / line /
      // scatter / heatmap records with wide-gamut color drawn from
      // the R41.M3 palette + stroke attributes for the Vello path
      // emitter), and smooth scrolling with sub-pixel positioning
      // and ease-out cubic animation (gui_scroll).
      //
      // Bodies in tests/kernel/semterm/{gui_vello,gui_charts,
      // gui_scroll}_synth.pdx. Same out-of-line pattern as R44.M1:
      // each fixture drives its module through a shared teardown
      // path so an inline fail branch cannot leak fixture state
      // into the next witness. Each also exercises refusals against
      // its own failure taxonomy (gui_vello 0xFFFFEEA0..AF,
      // gui_charts 0xFFFFEE90..9F, gui_scroll 0xFFFFEE80..8F, all
      // pairwise disjoint from every other band in the tree, and
      // from gui_theme 0xFFFFEEB0..BF just above).
      //
      // PLACEMENT AFTER gui_theme_witness_call IS DELIBERATE. R44.M2
      // opens ABOVE R44.M1's theme + shell + layout so the theme
      // module's default (DARK / IOSEVKA / 14pt) has already been
      // installed and torn down by the time the Vello backend's
      // scaffold starts routing frames. gui_charts references the
      // R41.M3 palette by ordinal but does NOT dereference it at
      // record-assembly time (the palette resolution is a downstream
      // renderer's job), so the ordering with palette_witness above
      // is neutral. gui_scroll is fully self-contained (no cross-
      // module reads); its placement mirrors gui_charts's for
      // ordered-golden legibility only.
      //
      // THREE FINGERPRINTS, one per issue:
      //
      //   R44 SEMTERM GUI VELLO OK   <- #1403
      //   R44 SEMTERM GUI CHARTS OK  <- #1404
      //   R44 SEMTERM GUI SCROLL OK  <- #1405
      //
      // Three rather than one because the modules can fail
      // independently: a broken layer visibility gate that lets a
      // downstream compositor paint an atlas that was never routed,
      // a chart bump allocator that reissues a chart id, or an
      // ease-out cubic that overshoots and lands past target. The
      // ordered-subsequence golden needs the three failures
      // distinguishable in the log.
      //
      // Call order is GUI VELLO -> GUI CHARTS -> GUI SCROLL. Each
      // witness is self-contained (it resets its module on entry
      // AND on exit) so the compose-time dependency (Vello backs
      // the chart emitter, which reprojects glyphs through the
      // scroll offset) does NOT dictate call order.
      //
      // Like every other marker on this path, THESE ASSERT NOTHING
      // ABOUT A LIVE R37 GPU BACKEND, A LIVE VELLO SCENE GRAPH, OR
      // A LIVE FRAME LOOP. src/kernel/core/semterm/{gui_vello,
      // gui_charts,gui_scroll}.pdx §0 records the deferrals rather
      // than leaving them to be discovered.
      // ============================================================
      gui_vello_witness_call:
          call gui_vello_witness

      gui_charts_witness_call:
          call gui_charts_witness

      gui_scroll_witness_call:
          call gui_scroll_witness

      // ============================================================
      // R44.M3-001 (#1406) + R44.M3-002 (#1407) + R44.M3-003 (#1408):
      // semantic-term GUI accessibility. Three modules close the R44
      // GUI accessibility axis on top of the R44.M2 rendering seams:
      // gui_ime (G11 IME binding -- routes composing code points into
      // a bounded pre-edit buffer, moves them into a committed run on
      // ime_commit, tracks a notify_pending counter the editor pump
      // drains), gui_a11y (G10 accessibility tree -- publishes each
      // widget as a rooted-tree node with role/name/value, tracks a
      // publish_pending counter the AT bridge drains), and
      // gui_kbdnav (G10 keyboard navigation -- Tab / F6 focus
      // routing, arrow-key within-panel navigation, focus-ring
      // visibility flag, skip-links for pager pages).
      //
      // Bodies in tests/kernel/semterm/{gui_ime,gui_a11y,
      // gui_kbdnav}_synth.pdx. Same out-of-line pattern as R44.M2:
      // each fixture drives its module through a shared teardown
      // path so an inline fail branch cannot leak fixture state
      // into the next witness. Each also exercises refusals against
      // its own failure taxonomy (gui_ime 0xFFFFEE70..7F, gui_a11y
      // 0xFFFFEE60..6F, gui_kbdnav 0xFFFFEE50..5F, all pairwise
      // disjoint from every other band in the tree, and from
      // gui_scroll 0xFFFFEE80..8F just above).
      //
      // PLACEMENT AFTER gui_scroll_witness_call IS DELIBERATE. R44.M3
      // sits ABOVE R44.M2 so the Vello backend / chart primitives /
      // scroll seams have already been reset and torn down by the
      // time the accessibility axis exercises its own scaffolds. The
      // ordering IME -> A11Y -> KBDNAV mirrors the accessibility
      // pipeline: an IME source feeds text into an editor whose
      // widget tree the a11y publisher walks, and the keyboard
      // router routes focus through those widgets. None of the three
      // has a live cross-module dependency (each witness resets its
      // module on entry AND on exit), so this order is documentary
      // rather than load-bearing.
      //
      // THREE FINGERPRINTS, one per issue:
      //
      //   R44 SEMTERM GUI IME OK      <- #1406
      //   R44 SEMTERM GUI A11Y OK     <- #1407
      //   R44 SEMTERM GUI KBDNAV OK   <- #1408
      //
      // Three rather than one because the modules can fail
      // independently: a broken commit that leaves the notify counter
      // unbumped (IME) is a different failure mode from a11y tree
      // that publishes a forest (multiple roots) or a keyboard
      // navigator that divides by zero on a zero-widget panel. The
      // ordered-subsequence golden needs the three failures
      // distinguishable in the log.
      //
      // Like every other marker on this path, THESE ASSERT NOTHING
      // ABOUT A LIVE G11 IME SOURCE, A LIVE AT-SPI-LIKE BRIDGE, OR
      // A LIVE G10 INPUT ROUTER. src/kernel/core/semterm/{gui_ime,
      // gui_a11y,gui_kbdnav}.pdx §0 records the deferrals rather
      // than leaving them to be discovered.
      // ============================================================
      gui_ime_witness_call:
          call gui_ime_witness

      gui_a11y_witness_call:
          call gui_a11y_witness

      gui_kbdnav_witness_call:
          call gui_kbdnav_witness

      // ============================================================
      // R44.M4-001 (#1409) + R44.M4-002 (#1410): semantic-term GUI
      // HDR / color-aware plot chooser and G9 presentation-time
      // feedback arbiter. Two modules close the R44.M4 milestone on
      // top of the R44.M3 accessibility seams: gui_hdr (routes a
      // series index to a 24-bit RGB value picked from the BT.2020
      // wide-gamut palette when the bound R36 KIND_DISPLAY_OUTPUT
      // reports HDR capability, otherwise defers to R41.M3
      // palette.pdx for the sRGB catalogue -- CIELAB delta-E >= 15
      // preserved in both modes) and gui_feedback (subscribes to G9
      // KIND_PRESENT_FEEDBACK events, latches last_latency against a
      // per-frame budget, and publishes two adaptive flags -- a
      // reduced-detail hint the chart engine reads and a scroll-
      // freeze hint the smooth-scroll integrator reads).
      //
      // Bodies in tests/kernel/semterm/{gui_hdr,gui_feedback}_synth.pdx.
      // Same out-of-line pattern as R44.M3: each fixture drives its
      // module through a shared teardown path so an inline fail
      // branch cannot leak fixture state into the next witness.
      // Each also exercises refusals against its own failure taxonomy
      // (gui_hdr 0xFFFFEE40..4F, gui_feedback 0xFFFFEE30..3F, both
      // pairwise disjoint from every other band in the tree, and
      // from gui_kbdnav 0xFFFFEE50..5F just above).
      //
      // PLACEMENT AFTER gui_kbdnav_witness_call IS DELIBERATE. R44.M4
      // sits ABOVE R44.M3 so the accessibility axis has already
      // been reset and torn down by the time HDR + feedback exercise
      // their own scaffolds. The ordering HDR -> FEEDBACK mirrors
      // the compositor pipeline: the HDR router picks chart colors
      // (chart-emit time), then the feedback arbiter records how
      // long the frame took to present. Neither has a live cross-
      // module dependency (each witness resets its module on entry
      // AND on exit) so this order is documentary rather than
      // load-bearing.
      //
      // TWO FINGERPRINTS, one per issue:
      //
      //   R44 SEMTERM GUI HDR OK       <- #1409
      //   R44 SEMTERM GUI FEEDBACK OK  <- #1410
      //
      // Two rather than one because the modules can fail
      // independently: a broken BT.2020 catalogue that regresses to
      // sRGB values under hdr_capable == 1 is a different failure
      // mode from a feedback arbiter that latches scroll_frozen
      // permanently after an underflowing subtract. The
      // ordered-subsequence golden needs the two failures
      // distinguishable in the log.
      //
      // Like every other marker on this path, THESE ASSERT NOTHING
      // ABOUT A LIVE R36 DISPLAY SUPERVISOR OR A LIVE G9
      // KIND_PRESENT_FEEDBACK SUBSCRIPTION. src/kernel/core/semterm/
      // {gui_hdr,gui_feedback}.pdx §0 records the deferrals rather
      // than leaving them to be discovered.
      // ============================================================
      gui_hdr_witness_call:
          call gui_hdr_witness

      gui_feedback_witness_call:
          call gui_feedback_witness

      // ============================================================
      // G1.M1-001..005 (#1427-#1431) + G1.M2-001..005 (#1432-#1436)
      // + G1.M3-001..006 (#1437-#1442): the G1 (GPU-native GUI)
      // display-substrate + explicit-sync primitive witnesses.
      //
      // Seven fixtures open the G1 lattice above the R44 GUI:
      // kind_display_timeline (the drm-syncobj-shaped display
      // timeline cap), display_sync_channel (the wait_scanout /
      // present_flush RPC schema), dpy_timeline (the vblank
      // signal seam + wait primitive), kind_vrr_range (the VRR
      // capability), dpy_vrr (the DPCD/EDID probe + adaptive-sync
      // arming), vrr_channel (the get_range/enable/disable RPC
      // schema), and g1_integration (M3 cross-engine + wrap +
      // present-flush integration).
      //
      // Bodies in tests/kernel/{cap,ipc,drivers/dpy}/
      // {kind_display_timeline,display_sync_channel,timeline,
      // kind_vrr_range,vrr,vrr_channel,g1_integration}_synth.pdx.
      //
      // PLACEMENT AFTER gui_feedback_witness_call IS DELIBERATE.
      // G1 opens ABOVE R44's GUI axis because a live compositor
      // (R44) is what consumes the timeline substrate.
      //
      // SEVEN FINGERPRINTS, one per fixture:
      //
      //   G1 KIND_DISPLAY_TIMELINE OK   <- #1427
      //   G1 DISPLAY SYNC CHAN OK       <- #1428
      //   G1 DPY TIMELINE OK            <- #1429 + #1430
      //   G1 KIND_VRR_RANGE OK          <- #1433
      //   G1 DPY VRR OK                 <- #1432 + #1435
      //   G1 VRR CHAN OK                <- #1434
      //   G1 INTEGRATION OK             <- #1437-#1442
      //
      // The two HW-only witnesses (G1.M2-005 #1436, G1.M3-006
      // #1442) are deferred to tools/hw-smoke-g1.md per D7
      // gated:hardware discipline.
      // ============================================================
      kind_display_timeline_witness_call:
          call kind_display_timeline_witness

      display_sync_channel_witness_call:
          call display_sync_channel_witness

      dpy_timeline_witness_call:
          call dpy_timeline_witness

      kind_vrr_range_witness_call:
          call kind_vrr_range_witness

      dpy_vrr_witness_call:
          call dpy_vrr_witness

      vrr_channel_witness_call:
          call vrr_channel_witness

      g1_integration_witness_call:
          call g1_integration_witness

      // ============================================================
      // G2.M1-001..005 (#1443-#1447) + G2.M2-001..004 (#1448-#1451)
      // + G2.M3-001..004 (#1453-#1456): the G2 (direct-scanout
      // leases + tearing-free VRR) witnesses.
      //
      // Four fixtures open the G2 lattice above G1:
      // kind_scanout_lease (the leased LINEAR authority over
      // KIND_DISPLAY_PLANE with output/timeline/expiry/state tail),
      // scanout_lease_channel (the request_lease -> present ->
      // release RPC schema), drivers/dpy/scanout (grant policy +
      // format matrix + HDR attach + expiry sweep + reserved plane),
      // and g2_integration (M3 fallback + adversarial + P7-default
      // integration).
      //
      // Bodies in tests/kernel/{cap,ipc,drivers/dpy}/
      // {kind_scanout_lease,scanout_lease_channel,scanout,
      //  g2_integration}_synth.pdx.
      //
      // PLACEMENT AFTER g1_integration_witness_call IS DELIBERATE.
      // G2 opens ABOVE G1's timeline substrate because a lease is
      // gated on a timeline_slot being nameable, and above R47
      // ordering is irrelevant (VMD and scanout use disjoint cap
      // slot ranges and disjoint state cells).
      //
      // FOUR FINGERPRINTS, one per fixture:
      //
      //   G2 KIND_SCANOUT_LEASE OK   <- #1443, #1447
      //   G2 SCANOUT LEASE CHAN OK   <- #1444
      //   G2 SCANOUT OK              <- #1445, #1446, #1448-#1451,
      //                                 #1453, #1454
      //   G2 INTEGRATION OK          <- #1453-#1456
      //
      // The one HW-only witness (G2.M2-005 #1452 fullscreen video
      // with VRR + zero tearing) is deferred to tools/hw-smoke-g2.md
      // per D7 gated:hardware discipline.
      // ============================================================
      kind_scanout_lease_witness_call:
          call kind_scanout_lease_witness

      scanout_lease_channel_witness_call:
          call scanout_lease_channel_witness

      scanout_witness_call:
          call scanout_witness

      g2_integration_witness_call:
          call g2_integration_witness

      // ============================================================
      // R47.M1-001 (#1412) + R47.M1-002 (#1413) + R47.M1-003 (#1414)
      // + R47.M2-001 (#1415) + R47.M2-002 (#1416) + R47.M2-003 (#1417)
      // + R47.M3-001 (#1418) + R47.M3-002 (#1419)
      // + R47.M4-001 (#1421) + R47.M4-002 (#1422) + R47.M4-003 (#1423)
      // + R47.M5-001 (#1424):
      // Intel VMD (Volume Management Device) driver substrate.
      //
      // R47 lifts the BIOS-off VMD quirk carried by design/hardware/
      // quirks.md §2.4 through R22..R46.  With VMD Enabled in BIOS,
      // NVMe (and other-class) endpoints live behind a virtual
      // root-complex aperture on the VMD controller rather than on
      // the primary PCI hierarchy; the R47 driver substrate names
      // those endpoints through KIND_VMD_ENDPOINT (0x187), routes
      // config-space + interrupt traffic through the virtual root
      // complex, and gives each endpoint its own IOMMU domain so
      // DMA reach cannot alias between endpoints.
      //
      // Bodies in tests/kernel/drivers/vmd/{probe, endpoint_enum,
      // root_complex, msix_remap, hotplug, nvme_bridge,
      // nvme_isolation, iommu_domain, iommu_switch,
      // iommu_adversarial, bios_off_fallback}_synth.pdx and
      // tests/kernel/cap/vmd_endpoint_synth.pdx and
      // tests/kernel/ipc/vmd_config_channel_synth.pdx.  Each fixture
      // drives its module through a shared reset path so an inline
      // fail branch cannot leak fixture state into the next witness.
      //
      // PLACEMENT AFTER g2_integration_witness_call IS DELIBERATE.
      // R47 sits ABOVE the R44 GUI axis + G1 display substrate + G2
      // scanout lattice so no
      // VMD state exists at the time the earlier witnesses reset
      // their modules.  The R47 fixtures own synthetic cap slots
      // (240..247) disjoint from every earlier witness's range.
      //
      // Fingerprints (thirteen, one per module):
      //
      //   R47 VMD PROBE OK              <- #1412
      //   R47 VMD ENUM OK               <- #1413
      //   R47 KIND_VMD_ENDPOINT OK      <- #1414
      //   R47 VMD ROOT COMPLEX OK       <- #1415
      //   R47 VMD CONFIG CHAN OK        <- #1415 (schema half)
      //   R47 VMD MSIX REMAP OK         <- #1416
      //   R47 VMD HOTPLUG OK            <- #1417
      //   R47 VMD NVME BRIDGE OK        <- #1418
      //   R47 VMD NVME ISOLATION OK     <- #1419
      //   R47 VMD IOMMU DOMAIN OK       <- #1421
      //   R47 VMD IOMMU SWITCH OK       <- #1422
      //   R47 VMD IOMMU ADVERSARIAL OK  <- #1423
      //   R47 VMD BIOS OFF OK           <- #1424
      //
      // Like every other marker on this path, THESE ASSERT NOTHING
      // ABOUT LIVE HARDWARE.  vmd_probe_arbitrated() and every
      // sibling arbitrated seam return 0 until a live PCIe VMD BAR
      // is wired to them.  The R47 HW-smokes live in
      // tools/hw-smoke-r47-vmd.md and are gated by
      // tests/kernel/drivers/vmd/hw_smoke_r47_placeholder.pdx
      // (dormant; not registered here).
      // ============================================================
      vmd_probe_witness_call:
          call vmd_probe_witness

      vmd_endpoint_enum_witness_call:
          call vmd_endpoint_enum_witness

      vmd_endpoint_witness_call:
          call vmd_endpoint_witness

      vmd_root_complex_witness_call:
          call vmd_root_complex_witness

      vmd_config_channel_witness_call:
          call vmd_config_channel_witness

      vmd_msix_remap_witness_call:
          call vmd_msix_remap_witness

      vmd_hotplug_witness_call:
          call vmd_hotplug_witness

      vmd_nvme_bridge_witness_call:
          call vmd_nvme_bridge_witness

      vmd_nvme_isolation_witness_call:
          call vmd_nvme_isolation_witness

      vmd_iommu_domain_witness_call:
          call vmd_iommu_domain_witness

      vmd_iommu_switch_witness_call:
          call vmd_iommu_switch_witness

      vmd_iommu_adversarial_witness_call:
          call vmd_iommu_adversarial_witness

      vmd_bios_off_fallback_witness_call:
          call vmd_bios_off_fallback_witness

      // ============================================================
      // G3.M1-001..005 (#1457-#1461) + G3.M2-001..005 (#1462-#1466)
      // + G3.M3-001..005 (#1467-#1471) + G3.M4-001..002 (#1472,
      // #1473): the G3 (GPU-native GUI) swapchain + presentation-
      // timing substrate.
      //
      // Nine fixtures open the G3 lattice above G1: kind_vk_surface
      // (the WSI surface cap), kind_vk_swapchain_image (the LINEAR
      // per-image handle carrying two timelines + present_id +
      // target_pts), vk_surface_channel (create_swapchain / acquire
      // _image / present_image / destroy_swapchain RPC schema), vk_
      // present_feedback_channel (VK_KHR_present_id + present_wait +
      // maintenance1 discard feedback stream), vk_icd (ICD registry
      // + VK_paideia_surface extension + SPIR-V loader magic check),
      // vk_swapchain (acquire / present / mode / resize driver), vk_
      // features (present_id + present_wait + discard-release + P3
      // fractional-scale gcd), vk_bench (acquire->present latency
      // ring + adaptive-render policy), and g3_integration (M3
      // discard + P3 acceptance integration).
      //
      // Bodies in tests/kernel/{cap,ipc,drivers/vk}/{kind_vk_surface,
      // kind_vk_swapchain_image, vk_surface_channel, vk_present_
      // feedback_channel, icd, swapchain, features, bench, g3_
      // integration}_synth.pdx.
      //
      // PLACEMENT AFTER vmd_bios_off_fallback_witness_call IS
      // DELIBERATE. G3 sits above G1 display timelines + G2
      // scanout leases; the G3 fixtures own synthetic surface /
      // image slots disjoint from every earlier witness's range.
      //
      // NINE FINGERPRINTS, one per fixture:
      //
      //   G3 KIND_VK_SURFACE OK        <- #1457
      //   G3 KIND_VK_SWAPCHAIN_IMAGE OK <- #1462
      //   G3 VK_SURFACE_CHAN OK        <- #1460
      //   G3 VK_PRESENT_FB_CHAN OK     <- #1467
      //   G3 VK_ICD OK                 <- #1458 + #1459 + #1461
      //   G3 VK_SWAPCHAIN DRIVER OK    <- #1463 + #1464 + #1465 + #1466
      //   G3 VK_FEATURES OK            <- #1468 + #1469
      //   G3 VK_BENCH OK               <- #1472 + #1473
      //   G3 INTEGRATION OK            <- #1470 + #1471
      //
      // The one HW-only witness (G3.M4-003 #1474) is deferred to
      // tools/hw-smoke-g3.md per D7 gated:hardware discipline.
      // ============================================================
      kind_vk_surface_witness_call:
          call kind_vk_surface_witness

      kind_vk_swapchain_image_witness_call:
          call kind_vk_swapchain_image_witness

      vk_surface_channel_witness_call:
          call vk_surface_channel_witness

      vk_present_feedback_channel_witness_call:
          call vk_present_feedback_channel_witness

      vk_icd_witness_call:
          call vk_icd_witness

      vk_swapchain_witness_call:
          call vk_swapchain_witness

      vk_features_witness_call:
          call vk_features_witness

      vk_bench_witness_call:
          call vk_bench_witness

      g3_integration_witness_call:
          call g3_integration_witness

      // ============================================================
      // G5.M1-001..005 (#1491-#1495) + G5.M2-001..005 (#1496-#1500)
      // + G5.M3-001..004 (#1501-#1504) + G5.M4-001..004 (#1505-#1508):
      // the G5 (SDF font + text-shape) substrate.
      //
      // Nine fixtures open the G5 lattice above G3: kind_font_atlas
      // (the on-GPU atlas texture cap), kind_text_shape (the immutable
      // shaped-run cap), sdf (SDF/MSDF generator + format-selection
      // heuristic), shaper (HarfBuzz-analogue -- OT features, BiDi,
      // Indic clustering, hinting), subpixel (fractional-scale
      // sub-pixel positioning + cache invalidation + P9 predicate),
      // color_emoji (COLR/CPAL, SBIX, CBDT strike selection), font_
      // load_channel (load / subset / evict RPC), text_shape_channel
      // (shape / invalidate / features_hash RPC), and g5_integration
      // (M1..M4 end-to-end).
      //
      // Bodies in tests/kernel/{cap,ipc,drivers/text}/{kind_font_atlas,
      // kind_text_shape, sdf, shaper, subpixel, color_emoji, font_
      // load_channel, text_shape_channel, g5_integration}_synth.pdx.
      //
      // PLACEMENT AFTER g3_integration_witness_call IS DELIBERATE.
      // G5 sits above G3 swapchain + presentation timing; the G5
      // fixtures own synthetic atlas / shape / cache slots disjoint
      // from every earlier witness's range.
      //
      // NINE FINGERPRINTS, one per fixture:
      //
      //   G5 KIND_FONT_ATLAS OK    <- #1492
      //   G5 KIND_TEXT_SHAPE OK    <- #1497
      //   G5 SDF OK                <- #1491 + #1494 + #1495
      //   G5 SHAPER OK             <- #1496 + #1499 + #1500 + #1504 + #1508
      //   G5 SUBPX OK              <- #1501 + #1502 + #1503
      //   G5 COLOR EMOJI OK        <- #1505 + #1506 + #1507
      //   G5 FONT_LOAD_CHAN OK     <- #1493
      //   G5 TEXT_SHAPE_CHAN OK    <- #1498
      //   G5 INTEGRATION OK        <- end-to-end lattice
      //
      // The one HW-only witness (G5.M3-003 #1503, P9 pixel-perfect on
      // real T14) is deferred to tools/hw-smoke-g5.md per D7
      // gated:hardware discipline; the QEMU-side dormant module lives
      // at tests/kernel/drivers/text/hw_smoke_g5_placeholder.pdx.
      // ============================================================
      kind_font_atlas_witness_call:
          call kind_font_atlas_witness

      kind_text_shape_witness_call:
          call kind_text_shape_witness

      sdf_witness_call:
          call sdf_witness

      shaper_witness_call:
          call shaper_witness

      subpixel_witness_call:
          call subpixel_witness

      color_emoji_witness_call:
          call color_emoji_witness

      font_load_channel_witness_call:
          call font_load_channel_witness

      text_shape_channel_witness_call:
          call text_shape_channel_witness

      g5_integration_witness_call:
          call g5_integration_witness

      // ============================================================
      // G6.M1-001..005 (#1509-#1513) + G6.M2-001..003 (#1514-#1516):
      // COLOR MANAGEMENT (ICC v4, CICP, HDR, wide-gamut, tone-map).
      //
      // Eight fixtures open the G6 lattice: kind_color_profile (the
      // KIND_COLOR_PROFILE = 0x18F derived-kind cap over KIND_MEMORY),
      // cicp (ITU-T H.273 CICP triplet parser + named-combo table),
      // icc (ICC v4 header + tag-table detector, matrix/TRC + LUT/
      // A-to-B0 shapes), color_management_channel (RPC schema for
      // query_output_gamut / get_tonemap_lut / set_reference_display),
      // surface_check (P5 partial: refuse a commit without exactly
      // one live KIND_COLOR_PROFILE argument), gpu_convert (matrix
      // cache for the six sRGB/P3/Rec.709/Rec.2020 conversion
      // pipelines), eotf (sRGB, PQ, HLG, DV transfer-curve tables),
      // scrgb (fp16-linear composition + gamut-boundary predicate).
      //
      // Bodies in tests/kernel/{cap,drivers/color,ipc}/{kind_color_
      // profile, cicp, icc, color_management_channel, surface_check,
      // gpu_convert, eotf, scrgb}_synth.pdx.
      //
      // PLACEMENT AFTER g5_integration_witness_call is deliberate:
      // G6 sits above G5 in the color stack (font atlas + text
      // shape land colored, per P5).
      //
      // EIGHT FINGERPRINTS, one per issue:
      //
      //   G6 KIND_COLOR_PROFILE OK  <- #1509
      //   G6 CICP OK                <- #1510
      //   G6 ICC OK                 <- #1511
      //   G6 COLOR_MGMT_CHAN OK     <- #1512
      //   G6 SURFACE_CHECK OK       <- #1513
      //   G6 GPU_CONVERT OK         <- #1514
      //   G6 EOTF OK                <- #1515
      //   G6 SCRGB OK               <- #1516
      // ============================================================
      kind_color_profile_witness_call:
          call kind_color_profile_witness

      cicp_witness_call:
          call cicp_witness

      icc_witness_call:
          call icc_witness

      color_management_channel_witness_call:
          call color_management_channel_witness

      surface_check_witness_call:
          call surface_check_witness

      gpu_convert_witness_call:
          call gpu_convert_witness

      eotf_witness_call:
          call eotf_witness

      scrgb_witness_call:
          call scrgb_witness

      // ============================================================
      // G4.M1-001..005 (#1475-#1479) + G4.M2-001..005 (#1480-#1484)
      // + G4.M3-001..003 (#1485-#1487) + G4.M4-001..002 (#1488,
      // #1489): the G4 (compute-based 2D rasterization -- Vello
      // lineage) substrate.
      //
      // Seven fixtures open the G4 lattice above G3 + G5: kind_vello
      // _scene (the encoded 2D scene cap), kind_vello_renderer (the
      // compute renderer cap), vello_render_channel (encode /
      // submit / await RPC schema), vello_scene_encoder (encoder +
      // upload seam for the paideia-as @wgsl_module gap), vello_
      // pipeline (STROKE + FILL + BLEND compute stages), vello_cpu_
      // fallback (llvmpipe-equivalent + hash equivalence gate),
      // vello_effects (gradient / blur / dash / arrow / marker
      // enqueue), vello_tiling (coarsening + occupancy heuristic),
      // and g4_integration (end-to-end encode -> submit -> tile ->
      // effect -> verify walk).
      //
      // Bodies in tests/kernel/{cap,ipc,drivers/vello}/{kind_vello_
      // scene, kind_vello_renderer, vello_render_channel, vello_
      // scene_encoder, vello_pipeline, vello_cpu_fallback, vello_
      // effects, vello_tiling, g4_integration}_synth.pdx.
      //
      // PLACEMENT AFTER g5_integration_witness_call IS DELIBERATE
      // because G4 (0x18D/0x18E) received its derived-kind slots
      // above the G5 pair (0x18B/0x18C) already in the tree; the
      // ordering here mirrors the numeric ordering.
      //
      // NINE FINGERPRINTS, one per fixture:
      //
      //   G4 KIND_VELLO_SCENE OK       <- #1476
      //   G4 KIND_VELLO_RENDERER OK    <- #1477
      //   G4 VELLO_RENDER_CHAN OK      <- #1478
      //   G4 VELLO_ENCODER OK          <- #1475 + #1479
      //   G4 VELLO_PIPELINE OK         <- #1480 + #1481 + #1482
      //   G4 VELLO_CPU_FALLBACK OK     <- #1483 + #1484
      //   G4 VELLO_EFFECTS OK          <- #1485 + #1486 + #1487
      //   G4 VELLO_TILING OK           <- #1488 + #1489
      //   G4 INTEGRATION OK            <- end-to-end
      //
      // The one HW-only witness (G4.M4-003 #1490) is deferred to
      // tools/hw-smoke-g4.md per D7 gated:hardware discipline.
      // ============================================================
      kind_vello_scene_witness_call:
          call kind_vello_scene_witness

      kind_vello_renderer_witness_call:
          call kind_vello_renderer_witness

      vello_render_channel_witness_call:
          call vello_render_channel_witness

      vello_scene_encoder_witness_call:
          call vello_scene_encoder_witness

      vello_pipeline_witness_call:
          call vello_pipeline_witness

      vello_cpu_fallback_witness_call:
          call vello_cpu_fallback_witness

      vello_effects_witness_call:
          call vello_effects_witness

      vello_tiling_witness_call:
          call vello_tiling_witness

      g4_integration_witness_call:
          call g4_integration_witness

      // ============================================================
      // R30.M6-002 (#1076): the REAL pad-controller probe.
      //
      // Consumes _pci_devices, which pci_enumerate_all populated far
      // earlier in kernel_main_64. Records every class candidate with
      // its measured BAR0 extent and stops there: identification reads a
      // register, and that needs the window capability that only a
      // holder of memory authority can mint. The probe itself performs
      // no MMIO.
      //
      // PLACEMENT AFTER BOTH WITNESSES IS REQUIRED. Each resets
      // _lpss_gpio_ctrl on entry and on exit; probing first would have
      // their teardown erase the machine's real controller rows.
      //
      // It is invisible under QEMU -- an MCFG-absent boot leaves
      // _pci_device_count at zero, so the walk iterates zero times and
      // the fingerprint reports n=0. On the T14 G4 the PCH pad
      // controller is described by platform firmware rather than
      // enumerated on PCI, and that consumer is R30's userspace
      // supervisor; this path is the PCI half, and both converge on
      // lpss_gpio_record.
      //
      // Fingerprint: "LPSS GPIO PROBE n=<count>".
      // ============================================================
      lpss_gpio_probe_call:
          call lpss_gpio_probe

      // ============================================================
      // #1582 part A: sys_clock_read_ns witness — ring-3 time source.
      //
      // Body in tests/kernel/syscall/clock_read_ns_synth.pdx.  Calls
      // sys_clock_read_ns_body twice with a `pause` between and asserts
      // (a) both reads are non-zero (hpet_init has landed, _hpet_ctx.base
      // is populated) and (b) the second read is >= the first (monotonic-
      // non-decreasing property inherited from HPET MAIN_COUNTER).
      //
      // Placement at the end of the R30 platform sequence is deliberate:
      // hpet_init runs at kernel_main.pdx L238 (well before this witness
      // fires from boot_continue_after_ring3), so both reads exercise the
      // real hpet_now_ns MMIO path rather than the _hpet_ctx.base==0
      // defensive fallback.  Placing after every other R30 witness means
      // any earlier HPET-touching probe has already reported, and a
      // regression in the fallback path would surface here rather than at
      // some incidental caller upstream.
      //
      // Unblocks #1087's wall-clock budget half of the AML performance
      // methodology: sys_clock_read_ns is what the AML executor will use
      // to convert method wall-clock in ns to the < 2 ms target, and the
      // fuel/step budget from design/acpi/perf-methodology.md §4 remains
      // the primary bound.
      //
      // Fingerprint: "R30 CLOCK READ NS OK\n" on success.
      // ============================================================
      clock_read_ns_witness_call:
          call clock_read_ns_witness

      // ============================================================
      // #1582 part B: sched_affinity witness — cpu_mask set/get/refuse
      // plus LP-E class reservation refuse.
      //
      // Body in tests/kernel/syscall/sched_affinity_synth.pdx.  Six
      // sub-tests against a standalone [u64;20] witness slab exercising
      // sys_sched_setaffinity_body / sys_sched_getaffinity_body /
      // sys_reserve_lpe_class_body.
      //
      // Placement AFTER clock_read_ns_witness_call keeps the two #1582
      // witnesses adjacent on the wire — a boot log with
      // "R30 CLOCK READ NS OK" followed by "R30 SCHED AFFINITY OK"
      // is a log in which both halves of #1582 reported in the same
      // boot.
      //
      // Leaves _reserved_lpe_task_pid == 42 on exit (no release
      // primitive at MVP; see the witness file's §LEAK NOTE).  Harmless
      // for R31.M0: no other boot-path caller consumes the reservation,
      // and the AML executor task (#1087) will do its own reservation
      // when it lands — it handles preexisting reservations by design.
      //
      // AML executor task (#1087) reserves LP-E via sys_reserve_lpe_class
      // to sidestep P-core scheduling jitter — this witness exercises the
      // reservation gate the executor depends on.
      //
      // Fingerprint: "R30 SCHED AFFINITY OK\n" on success.
      // ============================================================
      sched_affinity_witness_call:
          call sched_affinity_witness


      pop rbp;
      ret
    }
  }
}
