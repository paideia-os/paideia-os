      // slot; exercises bind + duplicate-device refusal +
      // CID-collision refusal + PSM/CID validators + report ingest
      // for both a happy path and BAD_REPORT + unbind.  PLACEMENT
      // AFTER hfp_witness_call IS DELIBERATE -- the BT HID row
      // table is disjoint from HFP's session table, but the log
      // order matches the R39.M6 issue order (#1344 follows #1343).
      //
      // Fingerprint: R39 BT HID OK
      // ============================================================
      bt_hid_witness_call:
