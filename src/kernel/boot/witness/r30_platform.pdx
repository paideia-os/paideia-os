      // latch + clear, and the underrun DRAIN / CAPPED policy.
      // PLACEMENT AFTER a2db_witness_call IS DELIBERATE -- retx
      // bookkeeping consumes the bridge's frame-epoch counter.
      //
      // Fingerprint: R39 A2DP RTX OK
      // ============================================================
      a2rtx_witness_call:
          call a2rtx_witness

      // ============================================================
      // R39.M6-001 (#1343): HFP (Hands-Free Profile) witness.
      //
      // Body in tests/kernel/drivers/bt/hfp_synth.pdx.  Opens R39.M6
      // (BT profiles that sit alongside A2DP).  Drives the session
