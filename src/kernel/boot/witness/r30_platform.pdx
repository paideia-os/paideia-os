      // + R33.M4-004 (#1155): the ALC287 CODEC DRIVER CLUSTER.
      //
      // Bodies in tests/kernel/drivers/hda/alc287_{init,hp_spk,mic,
      // jack}_synth.pdx. Each is a scaffold witness at the
      // "declare seams + refuse discipline + honesty-pin
      // arbitrated()==0" level: alc287_{init,hp_spk,mic,jack}.pdx §4
      // document the gated:hardware deferrals.
      //
      // ORDER WITHIN THE CLUSTER IS REQUIRED. alc287_init runs FIRST
      // because the three others gate on hda_alc287_init_bound
      // reporting codec+1 -- the hp_spk_bind, mic_bind and jack_arm
      // paths refuse before init has run, since HP amp writes,
      // VREF biasing and unsolicited-response arming are all
      // undefined against an unpowered codec's analog chain.
      // alc287_hp_spk runs BEFORE alc287_jack because jack_isr calls
      // alc287_hp_spk_auto_switch on the decode path, and the
      // switch's NOT_BOUND propagation would fail the isr stage.
      // alc287_mic sits between the two -- it has no dependency
      // either way but shares the init-bound gate, and reading
      // "R33 ALC287 MIC OK" between HP-SPK and JACK matches the
      // "outputs then inputs then event" narrative the compositor
      // will exercise in the same order.
      //
      // FOUR FINGERPRINTS, one per issue:
      //
      //   R33 ALC287 INIT OK        <- #1152
      //   R33 ALC287 HP-SPK OK      <- #1153
      //   R33 ALC287 MIC OK         <- #1154
      //   R33 ALC287 JACK OK        <- #1155
      //
      // Four rather than one because the four issues can fail for
      // unrelated reasons (a broken vendor coef verb, a wrong pin
      // ctl payload, a wrong VREF/amp gain, a wrong unsolicited
      // tag) and a golden asserting an ordered subsequence needs
      // the four failures distinguishable in the log.
      //
      // Like every other marker on this path, THEY ASSERT NOTHING
      // ABOUT A REAL CODEC ROUND-TRIP, A REAL AMP WRITE, A REAL VREF
      // BIAS, OR A REAL RIRB UNSOLICITED FRAME. The four
      // arbitrated() pins stay at 0 and the boot witness asserts
      // that; when a future milestone plumbs real MMIO / real RIRB
      // response consumption / a live jack_channel subscriber,
      // those pins flip and the stage 1 assertions here must be
      // rewritten in the same commit.
      // ============================================================
      alc287_init_witness_call:
          call alc287_init_witness

      alc287_hp_spk_witness_call:
          call alc287_hp_spk_witness

      alc287_mic_witness_call:
          call alc287_mic_witness

      alc287_jack_witness_call:
          call alc287_jack_witness

