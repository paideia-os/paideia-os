// src/kernel/boot/witness/r30_platform.pdx — boot witness module
//
// Extracted verbatim from src/kernel/boot/kernel_main.pdx (which had grown
// to 24,315 lines in two functions).  R30 platform witness block — SCI/GPE dispatch, ACPI event stream, I2C, LPSS, GPIO, KIND_FW_SESSION, plus the R31.M0/M1 cascade and owner-axis witnesses, and the R32.M1 I²C-HID transport cluster.
//
// -----------------------------------------------------------------------------
// Why the body is copied and not rewritten
// -----------------------------------------------------------------------------
//
// The goldens for this tree assert an ORDERED SUBSEQUENCE of fingerprints
// across 14 boot modes, and a witness that silently stops running still
// leaves most of that subsequence intact.  The extraction therefore moves
// the instruction stream unchanged: the only bytes this module adds around
// it are the `push rbp` / `pop rbp` / `ret` below.
//
// -----------------------------------------------------------------------------
// The push is not decoration
// -----------------------------------------------------------------------------
//
// `boot_continue_after_ring3` runs its body at `rsp % 16 == 8` — it sits two `call` levels
// below `_start`, and paideia-as emits no frame prologue for an
// `unsafe`-bodied lambda (emit_visit_lambda.rs suppresses the prologue for
// Unsafe bodies, which is also why `no-frame` is a no-op there).  Several
// witnesses in this file reason explicitly about that parity — "3 pushes from %16==8
// yields (8+3*8)%16 == 0" — and a bare `call` into a bare body would enter
// at `%16 == 0` and invert every one of those arguments.  The single
// `push rbp` restores the inline parity exactly; the matching `pop rbp`
// keeps rbp's SysV guarantee for the caller.
//
// Sections in this module, in the order boot_continue_after_ring3 ran them:
//   * R30.M4-001 (#1066) / R30.M4-002 (#1067): SCI/GPE dispatch
//   * R30.M4-001 (#1066): the R20.M3 synthetic FADT fixture, wired
//   * R30.M4-003 (#1068) / R30.M4-004 (#1069): ACPI event stream +
//   * R30.M5-001 (#1070) / R30.M5-002 (#1071): I²C capability-pair
//   * R30.M5-003 (#1072) / R30.M5-004 (#1073): LPSS I²C controller
//   * R30.M5-003 (#1072): the REAL LPSS I²C controller probe.
//   * R30.M6-002 (#1076): LPSS / PCH pad-controller witness — opens
//   * R30.M6-001 (#1075): KIND_GPIO_LINE capability witness.
//   * R30.M6-003 (#1077) + R30.M6-004 (#1078): the GPIO CHANNEL and
//   * R30.M8-002 (#1083) + R30.M8-003 (#1084): KIND_FW_SESSION —
//   * R31.M0-1583 (#1583): PROCESS DEATH IS WIRED TO THE CASCADE.
//   * R31.M1-1587 (#1587) + R31.M1-1589 (#1589): THE OWNER AXIS.
//   * R31.M5-002 (#1107): the backlight_channel schema.
//   * R31.M5-003 (#1108): the PWM backlight driver scaffold.
//   * R31.M5-004 (#1109): the DPAUX backlight driver scaffold.
//   * R32.M1-001 (#1115): the I²C-HID TRANSPORT scaffold.
//   * R32.M1-002 (#1116): the I²C-HID DESCRIPTOR scaffold.
//   * R32.M1-003 (#1117): the I²C-HID ISR scaffold.
//   * R32.M1-004 (#1118): the I²C-HID RESET + WAKE scaffold.
//   * R32.M1-005 (#1119): the I²C-HID QUIRK TABLE.
//   * R32.M2-001 (#1120): the HID REPORT-DESCRIPTOR PARSER scaffold.
//   * R32.M2-002 (#1121): the HID USAGE-PAGE + USAGE-ID enumeration.
//   * R32.M2-003 (#1122): the HID COLLECTION WALKER scaffold.
//   * R32.M2-004 (#1123): the HID FIELD EXTRACTOR scaffold.
//   * R32.M2-005 (#1124): the HID GET/SET_REPORT round-trip scaffold.
//   * R32.M3-001 (#1125): KIND_HID_DEVICE.
//   * R32.M3-002 (#1126): KIND_HID_EVENT.
//   * R32.M3-003 (#1127): the HID EVENT STREAM fanout scaffold.
//   * R32.M3-004 (#1128): the HID EVENT STREAM schema.
//   * R32.M4-001 (#1129): gesture recognizer — two-finger scroll.
//   * R32.M4-002 (#1130): gesture recognizer — pinch.
//   * R32.M4-003 (#1131): gesture recognizer — kinetic scroll (post-lift decay).
//   * R32.M4-004 (#1132): gesture recognizer — swipe (3+ finger).
//   * R32.M5-001 (#1133): KIND_SENSOR_CHANNEL capability.
//   * R32.M5-002 (#1134): sensor_hub driver scaffold (ALS+ACCEL+GYRO).
//   * R32.M5-003 (#1135): sensor_read_channel schema.
//   * R34.M5-001 (#1186): KIND_ISOCH_STREAM capability witness.
//   * R34.M5-002 (#1187): xHCI SOF timeline witness.
//   * R34.M5-003 (#1188): xHCI ISOCH ring witness.
//   * R34.M5-004 (#1189): UVC synth webcam witness.
//   * R36.M1-004 (#1238): KIND_DISPLAY_ENGINE capability witness.
//   * R36.M1-001 (#1235): Iris Xe display probe witness.
//   * R36.M1-002 (#1236): display power-wells witness.
//   * R36.M1-003 (#1237): DP link-clock PLL witness.
//   * R36.M2-003 (#1241): KIND_DISPLAY_OUTPUT capability witness.
//   * R36.M2-001 (#1239): display topology witness.
//   * R36.M2-002 (#1240): EDID parser witness.
//   * R36.M2-004 (#1242): display_topology_channel schema witness.
//   * R36.M2-005 (#1243): HPD ISR witness.
//   * R36.M3-001 (#1244): KIND_MODESET_TXN capability witness.
//   * R36.M3-004 (#1247): KIND_DISPLAY_MODE capability witness.
//   * R36.M3-002 (#1245): modeset_channel FSM witness.
//   * R36.M3-003 (#1246): atomic_commit driver witness.
//   * R36.M3-005 (#1248): mode enumeration admission witness.
//   * R37.M1-001 (#1253): GPU BAR + MMIO substrate witness.
//   * R37.M1-003 (#1255): GT + engine reset primitives witness.
//   * R37.M1-004 (#1256): GPU register audit + safety-region witness.
//   * R37.M2-001 (#1257): GuC firmware dual-signature verify witness.
//   * R37.M2-002 (#1258): GuC firmware load (WOPCM upload FSM) witness.
//   * R37.M2-003 (#1259): GuC handshake + version + feature negotiation witness.
//   * R37.M3-001 (#1262): KIND_GPU_BO capability witness.
//   * R37.M3-002 (#1263): GPU BO slab allocator witness.
//   * R37.M3-003 (#1264): GPU tiling-format encoder witness.
//   * R37.M3-004 (#1265): GPU cache-policy witness.
//   * R37.M3-005 (#1266): gpu_bo_alloc_channel schema witness.
//   * R37.M4-001 (#1267): KIND_GPU_VM capability witness.
//   * R37.M4-002 (#1268): PPGTT 4-level walker witness.
//   * R37.M4-003 (#1269): PPGTT bind / unbind witness.
//   * R37.M4-004 (#1270): PPGTT protection-bit composer witness.
//   * R37.M4-005 (#1271): GTT scan-out mapping witness.
//   * R37.M7-003 (#1283): GT fence + interrupt path witness.
//   * R37.M8-001 (#1285): HuC firmware dual-signature loader witness.
//   * R37.M8-002 (#1286): VCS video-decode engine substrate witness.
//   * R37.M8-003 (#1287): HEVC frame plumbing scaffold witness.
//   * R37.M8-004 (#1288): GPU stress rig (100k no-op batches) witness.
//   * R38.M6-001 (#1314): regulatory-domain loader witness.
//   * R38.M6-002 (#1315): regdomain_channel schema witness.
//   * R38.M6-003 (#1316): geo-hint discovery witness.
//   * R39.M1-002 (#1324): KIND_BT_ADAPTER capability witness.
//   * R39.M1-003 (#1325): KIND_BT_HCI_CHANNEL capability witness.
//   * R39.M1-001 (#1323): HCI transport over CNVi witness.
//   * R39.M1-004 (#1326): bt_hci_channel session type witness.
//   * R39.M2-003 (#1329): KIND_BT_L2CAP_CHANNEL capability witness.
//   * R39.M2-001 (#1327): L2CAP fixed-channel registration witness.
//   * R39.M2-002 (#1328): L2CAP dynamic-channel LE CBFC witness.
//   * R39.M2-004 (#1330): bt_l2cap_channel session type witness.
//   * R39.M3-003 (#1333): KIND_BT_GATT_CONNECTION capability witness.
//   * R39.M3-002 (#1332): GATT server + client + ATT PDU witness.
//   * R39.M3-004 (#1334): bt_gatt_channel schema witness.
//   * R39.M4-002 (#1336): KIND_BT_PAIRING capability witness.
//   * R39.M4-001 (#1335): LE SC pairing driver witness.
//   * R39.M4-003 (#1337): bt_pairing_channel schema witness.
//   * R39.M5-001 (#1339): A2DP profile (SBC/AAC codec) witness.
//   * R39.M5-002 (#1340): A2DP <-> KIND_PCM_STREAM bridge witness.
//   * R39.M5-003 (#1341): A2DP retransmission + resync witness.
//   * R39.M6-001 (#1343): HFP (Hands-Free Profile) witness.
//   * R39.M6-002 (#1344): BT HID (HID over L2CAP) witness.
//   * R39.M6-003 (#1345): LE Audio scaffolding (BAP/CAP) witness.
//   * R40.M1-001 (#1347): IPU6 PCI probe + BAR mapping witness.
//   * R40.M1-002 (#1348): IPU6 firmware dual-sig verify witness.
//   * R40.M1-003 (#1349): IPU6 firmware upload + BOOT_READY witness.
//   * R40.M2-001 (#1352): KIND_CSI_CAMERA capability witness.
//   * R40.M2-002 (#1351): MIPI-CSI D-PHY receiver init witness.
//   * R40.M2-003 (#1353): sensor _CID enumeration witness.
//   * R40.M2-004 (#1354): per-sensor init sequence witness.
//   * R40.M3-002 (#1356): KIND_IPU6_STREAM capability witness.
//   * R40.M3-001 (#1355): IPU6 imaging pipeline stages witness.
//   * R40.M3-003 (#1357): camera_capture_channel session witness.
//   * R40.M4-001 (#1360): KIND_WWAN_MODEM capability witness.
//   * R40.M4-002 (#1359): WWAN M.2 modem probe + power gating witness.
//   * R40.M4-004 (#1362): KIND_MBIM_SESSION capability witness.
//   * R40.M4-003 (#1361): MBIM (Mobile Broadband Interface Model) witness.
//   * R40.M5-001 (#1363): audit-schema unification witness.
//   * R41.M1-001 (#1365): semantic-term-core command lexer witness.
//   * R41.M1-002 (#1366): semantic-term-core parser + AST witness.
//   * R41.M1-003 (#1367): semantic-term-core query type system witness.
//   * R44.M1-001 (#1400): semantic-term GUI shell witness.
//   * R44.M1-002 (#1401): semantic-term GUI layout witness.
//   * R44.M1-003 (#1402): semantic-term GUI theme witness.
//   * G1.M1-001 (#1427): KIND_DISPLAY_TIMELINE capability witness.
//   * G1.M1-002 (#1428): display_sync_channel schema witness.
//   * G1.M1-003 (#1429) + G1.M1-004 (#1430): dpy_timeline vblank+wait witness.
//   * G1.M2-002 (#1433): KIND_VRR_RANGE capability witness.
//   * G1.M2-001 (#1432) + G1.M2-004 (#1435): dpy_vrr probe+arm witness.
//   * G1.M2-003 (#1434): vrr_channel schema witness.
//   * G1.M3-001..006 (#1437-#1442): g1 integration witness (cross-engine + wrap + integration).
//   * R30.M6-002 (#1076): the REAL pad-controller probe.

module R30Platform = structure {

  // witness_r30_platform() — the R30 platform witness block — SCI/GPE dispatch, ACPI event stream, I2C, LPSS, GPIO, KIND_FW_SESSION, plus the R31.M0/M1 cascade and owner-axis witnesses.
  //
  // Effect and capability rows are the ones the enclosing
  // `boot_continue_after_ring3` declares.  They are not widened here: this
  // is the same instruction stream under a new symbol, so the authority it
  // needs is by construction the authority it already had.
  pub let witness_r30_platform : () -> () !{sysreg} @{} = fn () -> unsafe {
    effects: { sysreg },
    capabilities: { boot },
    justification: "Boot witness block lifted verbatim out of kernel_main.pdx's boot_continue_after_ring3 during the r30_platform extraction. Body bytes are unchanged from the inline form; the only additions are the entry `push rbp` and the exit `pop rbp; ret`. The push is load-bearing rather than cosmetic: boot_continue_after_ring3 executes its body at rsp%16 == 8 (two `call` levels below _start, with no frame prologue emitted for unsafe-bodied lambdas), and the witnesses inside this module compute their own nested-call alignment from that parity. Entering through a `call` without the compensating push would present rsp%16 == 0 to the body and silently invert every such argument — the failure mode of paideia-os #1192, #1195 and #1584. Effects and capabilities are copied unchanged from the enclosing function for the same reason: no authority is added, so none needs justifying beyond what boot_continue_after_ring3 already justified.",
    block: {
      push rbp;

      // ============================================================
      // R30.M4-001 (#1066) / R30.M4-002 (#1067): SCI/GPE dispatch
      // witness — opens R30.M4, the interrupt path of the round.
      //
      // The whole body lives in tests/kernel/acpi/gpe_synth.pdx rather
      // than inline here. That is a placement decision, not a size one:
      // the fixture installs a synthetic register window through the
      // seam in core/acpi/gpe_io.pdx and MUST return the seam to real
      // port I/O on every exit, and a fixture whose setup and teardown
      // are one function cannot leave that half-done the way an inline
      // block with a jump to a shared fail label can.
      //
      // Placement AFTER drv_audit_witness_done is deliberate too. The
      // storm sub-test asserts on the most recent driver-audit record,
      // and the driver-audit witness makes assertions of its own about
      // the ring; running the GPE fixture first would interleave storm
      // records into the window that witness reads.
      //
      // Fingerprint ordering:
      //   R29 DRIVER AUDIT OK
      //   R30 GPE DISPATCH OK     <- THIS WITNESS
      //   R20b IPC BOUNCE OK
      // ============================================================
      // R30.M4-001 (#1066): the R20.M3 synthetic FADT fixture, wired
      // into the boot path for the first time. It had been compiled and
      // linked since R20 but never called, so the parser it exercises
      // had no runtime witness at all — which is why the field-offset
      // error corrected in this issue (the SDT header counted as 40
      // bytes rather than 36, displacing SCI_INT and the whole PM_*_BLK
      // run) survived four rounds. R30.M4 reads SCI_INT out of that
      // structure, so the fixture stops being optional here.
      fadt_synth_witness_call:
          call fadt_synth_witness

      gpe_dispatch_witness_call:
          call gpe_dispatch_witness

      // ============================================================
      // R30.M4-003 (#1068) / R30.M4-004 (#1069): ACPI event stream +
      // subscriber routing witness — closes R30.M4.
      //
      // Body in tests/kernel/acpi/evt_route_synth.pdx, for the same
      // placement reason gpe_synth.pdx is out of line: it installs the
      // synthetic register window through the seam in
      // core/acpi/gpe_io.pdx and MUST return that seam to real port I/O
      // on every exit, which a fixture whose setup and teardown are one
      // function cannot leave half-done.
      //
      // Placement AFTER gpe_dispatch_witness_call is required, not
      // stylistic. Sub-test D reads the MOST RECENT driver-audit record
      // and asserts it is this fixture's GPE_AUDIT_EV_UNROUTED line; the
      // GPE fixture's storm retirement writes a record of its own, so
      // running this one first would put the two witnesses' records in
      // the other order and each would read the other's.
      //
      // It writes no IOAPIC register: both sci_arm calls use an SCI_INT
      // of 2^32, whose resolved GSI is 0, and core/acpi/sci_route.pdx
      // refuses a GSI of 0 before any MMIO. That is what lets the
      // readiness gate be exercised in BOTH directions -- refused while
      // unbound, passed once bound -- without this witness reprogramming
      // the platform's own interrupt controller during boot.
      //
      // Fingerprint ordering:
      //   R29 DRIVER AUDIT OK
      //   R30 GPE DISPATCH OK
      //   R30 ACPI EVENT ROUTE OK   <- THIS WITNESS
      //   R20b IPC BOUNCE OK
      // ============================================================
      evt_route_witness_call:
          call evt_route_witness

      // ============================================================
      // R30.M5-001 (#1070) / R30.M5-002 (#1071): I²C capability-pair
      // witness — opens R30.M5 (LPSS I²C enablement).
      //
      // Body in tests/kernel/cap/i2c_cap_synth.pdx. Out of line for a
      // different reason than the two ACPI fixtures above: this one
      // installs no seam and touches no hardware at all — it is pure
      // capability structure — but it consumes twelve cap_table slots
      // and two private row tables, and a fixture whose setup and
      // teardown are one function cannot leave that half-done the way
      // an inline block with a jump to a shared fail label can.
      //
      // Placement is free: it shares no state with any other witness.
      // Slots 34..45 are disjoint from every other witness's set
      // (0..8, 10..12, 14..19, 28..33), and both exits clear them and
      // reset both row tables.
      //
      // What it establishes, in one line: on a bus where the
      // controller can address every peripheral, a capability naming
      // address A cannot be talked into addressing B — including by a
      // caller that loads B into every register an added address
      // parameter could arrive in.
      //
      // Fingerprint ordering:
      //   R30 GPE DISPATCH OK
      //   R30 ACPI EVENT ROUTE OK
      //   R30 KIND_I2C OK           <- THIS WITNESS
      //   R20b IPC BOUNCE OK
      // ============================================================
      i2c_cap_witness_call:
          call i2c_cap_witness

      // ============================================================
      // R30.M5-003 (#1072) / R30.M5-004 (#1073): LPSS I²C controller
      // probe, BAR mapping and transfer-channel witness.
      //
      // Body in tests/kernel/drivers/i2c/lpss_i2c_synth.pdx. Out of
      // line for the reason gpe_synth.pdx is: it installs the synthetic
      // register window through the seam in
      // core/drivers/i2c/dw_io.pdx and MUST return that seam to real
      // MMIO on every exit -- a fixture whose setup and teardown are
      // one function cannot leave that half-done. It also mints a live
      // KIND_OP_REGION over a fabricated physical base, which both
      // exits revoke by clearing the slot.
      //
      // PLACEMENT AFTER i2c_cap_witness_call IS REQUIRED, not
      // stylistic. Both fixtures reset _i2c_bus_table and
      // _i2c_slave_table on entry and on exit; running this one first
      // would have the capability-pair witness's own reset wipe the bus
      // and slave rows this one is transacting against. The dependency
      // is one-directional -- this fixture consumes the kinds that one
      // establishes -- so the order is the same as the issue order.
      //
      // Cap slots 46..55, disjoint from every other witness's set
      // (0..8, 10..12, 14..19, 28..33, 34..45).
      //
      // It touches no hardware. The seam is in its synthetic mode for
      // the whole fixture, and the PCI probe it exercises finds nothing
      // under QEMU's MCFG-absent boot in any case; the controller rows
      // come from lpss_i2c_record, the same allocator the probe uses.
      //
      // R30.M5-005 (#1074) extended it with sub-tests S..X: the
      // interrupt-driven transfer engine, its FSM ownership protocol
      // and the TX_EMPTY storm measurement. Those emit a SECOND
      // fingerprint from the same function, because a boot in which
      // the polled engine works and the interrupt engine does not is a
      // boot somebody needs to be able to see.
      //
      // The service routine (core/drivers/i2c/dw_isr.pdx) is driven
      // here from thread context, exactly as sci_isr_body is by the
      // GPE witness: no interrupt vector is bound to an LPSS
      // controller yet -- that needs the KIND_HW_MSIX_VECTOR plumbing
      // R30.M6 will do -- and the engine is written so that binding
      // one adds a caller rather than a code path.
      //
      // Fingerprint ordering:
      //   R30 ACPI EVENT ROUTE OK
      //   R30 KIND_I2C OK
      //   R30 LPSS I2C OK           <- THIS WITNESS
      //   R30 LPSS I2C IRQ OK       <- THIS WITNESS
      //   R20b IPC BOUNCE OK
      // ============================================================
      lpss_i2c_witness_call:
          call lpss_i2c_witness

      // ============================================================
      // R30.M5-003 (#1072): the REAL LPSS I²C controller probe.
      //
      // Consumes _pci_devices, which pci_enumerate_all populated far
      // earlier in kernel_main_64. Records every class candidate for a
      // DesignWare I²C core with its measured BAR0 extent, and stops
      // there: identification reads a register, and bringing a
      // controller up writes several, and both need the window
      // capability that only a holder of memory authority can mint.
      // The probe itself performs no MMIO.
      //
      // PLACEMENT AFTER THE WITNESS IS REQUIRED. The witness resets
      // _lpss_i2c_ctrl on entry and on exit; probing first would have
      // the fixture's own teardown erase the machine's real controller
      // rows. It is invisible under QEMU -- an MCFG-absent boot leaves
      // _pci_device_count at zero, so the walk iterates zero times and
      // the fingerprint reports n=0 -- and load-bearing on the T14 G4,
      // where it is the first thing that sees the LPSS blocks.
      //
      // Fingerprint: "LPSS I2C PROBE n=<count>".
      // ============================================================
      lpss_i2c_probe_call:
          call lpss_i2c_probe

      // ============================================================
      // R30.M6-002 (#1076): LPSS / PCH pad-controller witness — opens
      // R30.M6.
      //
      // Body in tests/kernel/drivers/gpio/lpss_gpio_synth.pdx. Out of
      // line for the reason lpss_i2c_synth.pdx is: it installs the
      // synthetic register window through the seam in
      // core/drivers/gpio/gpio_io.pdx and MUST return that seam to real
      // MMIO on every exit -- a fixture whose setup and teardown are one
      // function cannot leave that half-done. It also mints live
      // KIND_OP_REGION capabilities over fabricated physical bases,
      // which both exits revoke rather than merely unlinking, so the
      // op-region ROWS come back too.
      //
      // What it establishes, in one line: the controller's registers are
      // reachable only through a capability, the part is identified by
      // asking it rather than by a device-id table, and a community
      // description that cannot be true -- overlapping, oversized, or
      // pointing at a window with nothing behind it -- is REFUSED rather
      // than repaired.
      //
      // Cap slots 56..63, disjoint from every other witness's set
      // (0..8, 10..12, 14..19, 28..33, 34..45, 46..55).
      //
      // Fingerprint ordering:
      //   R30 LPSS I2C IRQ OK
      //   R30 LPSS GPIO OK          <- THIS WITNESS
      //   R30 KIND_GPIO OK
      //   R20b IPC BOUNCE OK
      // ============================================================
      lpss_gpio_witness_call:
          call lpss_gpio_witness

      // ============================================================
      // R30.M6-001 (#1075): KIND_GPIO_LINE capability witness.
      //
      // Body in tests/kernel/cap/gpio_cap_synth.pdx.
      //
      // PLACEMENT AFTER lpss_gpio_witness_call IS REQUIRED, not
      // stylistic, and the dependency runs the OPPOSITE way to the I²C
      // pair's. There, the capability witness ran first and the driver
      // witness consumed the kinds it established. Here the CAPABILITY
      // depends on the DRIVER: a KIND_GPIO_LINE mint resolves its pin
      // through the controller's community table, so this fixture has to
      // build a controller before it can mint anything. Both fixtures
      // reset _lpss_gpio_ctrl and _lpss_gpio_comm on entry and on exit,
      // so running them the other way round would have the driver
      // witness's teardown erase the controller this one is minting
      // against.
      //
      // What it establishes, in one line: a capability naming pin P
      // cannot be talked into acting on pin Q -- including by a caller
      // that loads Q's number, community, pad index and register offset
      // into every register an added parameter could arrive in -- and
      // the community mapping is right OUTSIDE community 0, where it is
      // not the identity and where an implementation that skipped it
      // would drive a different pin with no error anywhere.
      //
      // Cap slots 64..79, disjoint from every other witness's set; both
      // exits revoke the windows and clear them.
      //
      // Fingerprint ordering:
      //   R30 LPSS GPIO OK
      //   R30 KIND_GPIO OK          <- THIS WITNESS
      //   R20b IPC BOUNCE OK
      // ============================================================
      gpio_cap_witness_call:
          call gpio_cap_witness

      // ============================================================
      // R30.M6-003 (#1077) + R30.M6-004 (#1078): the GPIO CHANNEL and
      // the pad driver — the first code in this kernel that changes
      // physical board state.
      //
      // Body in tests/kernel/drivers/gpio/gpio_pad_synth.pdx.
      //
      // PLACEMENT AFTER BOTH R30.M6 WITNESSES IS REQUIRED for the same
      // reason gpio_cap_witness follows lpss_gpio_witness: this fixture
      // builds a controller, describes its communities and mints line
      // capabilities over it, and all three of those tables are reset by
      // the earlier fixtures' teardown. Running it first would have
      // their teardown erase the controller it drives.
      //
      // It also arms the synthetic seam's WRITE-1-TO-CLEAR registry and
      // registers an edge subscription, and its teardown clears both --
      // the subscription in particular, because a live subscription
      // outliving the fixture is an ISR entry that would re-derive a pad
      // address from a capability slot the next boot stage reuses.
      //
      // What it establishes, in one line: a pad register write preserves
      // the bits it does not own, an interrupt acknowledgement that
      // clears the status bit is DISTINGUISHABLE from one that does not,
      // a status bit that will not clear is bounded and masked rather
      // than serviced forever, and turning an input into an output is a
      // different authority from toggling one.
      //
      // Cap slots 80..95, disjoint from every other witness's set; both
      // exits revoke the window and clear them.
      //
      // Fingerprint ordering:
      //   R30 KIND_GPIO OK
      //   R30 GPIO PAD OK          <- THIS WITNESS
      //   R20b IPC BOUNCE OK
      // ============================================================
      gpio_pad_witness_call:
          call gpio_pad_witness

      // ============================================================
      // R30.M8-002 (#1083) + R30.M8-003 (#1084): KIND_FW_SESSION —
      // the authority to open an evaluation session against a
      // firmware-supplied object, and the arbitration deciding which
      // of several concurrent sessions may WRITE it.
      //
      // Placed LAST among the R30 capability witnesses because it is
      // the last entry in the R30 derived-kind block (0x155) and
      // because its stress phase is the longest-running of them; a
      // failure here is easier to localise when everything upstream of
      // it has already reported.
      //
      // It needs nothing from the pad-controller or I²C witnesses
      // above — its parent is a KIND_IPC_ENDPOINT it seeds itself —
      // so the ordering is for reporting, not for dependency.
      //
      // Cap slots 160..175, disjoint from every other witness's set
      // (46..55, 56..63, 64..79, 80..95, 110..117); every session slot
      // is revoked and the four base authorities are cleared before it
      // reports, so the next witness inherits an empty set.
      //
      // The stress phase asserts LINEARIZABILITY, defined in the
      // witness header rather than asserted by name: mutual exclusion
      // checked between every pair of adjacent steps, no lost updates
      // across ten interleaved evaluators, and a non-vacuity check that
      // the schedule actually contended.
      //
      // Fingerprint ordering:
      //   R30 GPIO PAD OK
      //   R30 KIND_FW_SESSION OK   <- THIS WITNESS
      //   R20b IPC BOUNCE OK
      // ============================================================
      fw_session_witness_call:
          call fw_session_witness

      // ============================================================
      // R31.M0-1583 (#1583): PROCESS DEATH IS WIRED TO THE CASCADE.
      //
      // Body in tests/kernel/driver/death_witness.pdx.
      //
      // What it establishes, in one line: a driver process that dies —
      // by fault or by exit — has its capabilities taken back, its
      // channels killed, its clients woken and its node restarted, and
      // none of that happens to a DIFFERENT process that later inherits
      // its pid.
      //
      // Why it is here at all. R29 (#1044/#1047/#1048) built the whole
      // cascade-restart mechanism and driver_restart_node had five call
      // sites, every one of them synthetic — the chaos harness and the
      // R29 witness itself. No fault handler and no supervisor reached
      // it. A mechanism with no trigger is not a delivered property,
      // and until this witness the system's behaviour on a driver crash
      // was: keep every capability the corpse was holding.
      //
      // PLACEMENT is unconstrained by dependency and chosen for
      // reporting. It uses driver slots 20/21/22 and endpoint ids it
      // allocates and frees, all disjoint from R29's 8..11 and from the
      // lifecycle witnesses' 0..2, so it neither reads nor writes any
      // state an earlier witness leaves behind — the two-line reason it
      // can sit anywhere in this block. It is last because it is the
      // R31 opener and a failure here should be the final thing
      // reported, not something buried mid-list.
      //
      // ONE THING IT DOES THAT NO OTHER WITNESS DOES: it substitutes
      // _current_tcb, because fault_ring3_death_check identifies the
      // faulting task the way the real handlers do — by reading it —
      // and a fixture that passed the TCB as an argument would be
      // testing a different function from the one the IDT reaches. That
      // is safe HERE and would not be safe later: every `sti` in this
      // file is at line 16135 or beyond, so no timer tick can observe
      // the substitution. Its teardown restores the saved value from
      // BOTH exits, so a failed assertion cannot leave the scheduler
      // pointed at fixture storage.
      //
      // Fingerprint ordering:
      //   R30 KIND_FW_SESSION OK
      //   R31 DEATH CASCADE OK      <- THIS WITNESS
      //   R20b IPC BOUNCE OK
      // ============================================================
      death_witness_call:
          call death_witness

      // ============================================================
      // R31.M1-1587 (#1587) + R31.M1-1589 (#1589): THE OWNER AXIS.
      //
      // Body in tests/kernel/cap/owner_sweep_synth.pdx.
      //
      // What it establishes, in one line: one process death revokes all
      // five R30 derived kinds together, because capabilities now carry
      // an OWNER — and the lineage cascades run beneath that sweep,
      // reaching three more descriptors that no process held.
      //
      // Why it is here at all. #1583 wired death to the cascade and
      // could not write the composed witness its own scope item 3 asked
      // for: cap_table carried (kind, rights, target_ptr) and no holder,
      // so "the capabilities held by process P" was not a representable
      // query. Every cascade in the kernel keys on a PARENT identity —
      // a cap slot, a bus row, a controller bdf — and a crashed ACPI
      // bubble's OpRegion windows were derived from nothing that also
      // died, so they survived it. This is the witness that was owed.
      //
      // PLACEMENT AFTER death_witness_call IS REQUIRED, and the reason
      // is the R30 tables rather than the driver rows. This fixture
      // builds a pad controller, an I²C bus and a firmware session
      // through the shipping paths, and resets all of those tables on
      // entry and on exit — so running it before the R30 capability
      // witnesses would have their teardown erase what it is minting
      // against, exactly as gpio_cap_witness must follow
      // lpss_gpio_witness. It touches no driver row, which is why it
      // can sit after death_witness rather than before it: its
      // driver_death_notify(40) answers DRV_DEATH_NO_SLOT, and that is
      // the assertion — the revocation happened on the owner sweep,
      // not as a side effect of a driver teardown.
      //
      // Cap slots 176..199, disjoint from every other witness's set;
      // both exits revoke the windows, clear the descriptors AND clear
      // the owner columns.
      //
      // ONE THING IT DOES THAT NO OTHER WITNESS DOES: it bumps
      // _pid_gen[40] and _pid_gen[41] and leaves them bumped. That is
      // deliberate. pid_gen_bump is monotonic, and un-bumping would
      // forge a LOWER incarnation for a pid — the one thing the
      // (pid, generation) key exists to make impossible. Neither pid is
      // ever allocated in any smoke mode, and a generation on a pid
      // that hosts no task names nothing.
      //
      // Fingerprint ordering:
      //   R31 DEATH CASCADE OK
      //   R31 OWNER SWEEP OK        <- THIS WITNESS
      //   R20b IPC BOUNCE OK
      // ============================================================
      owner_sweep_witness_call:
          call owner_sweep_witness

      // ============================================================
      // R31.M1-001 (#1089) + R31.M1-002 (#1090) + R31.M1-003 (#1091):
      // THE EMBEDDED CONTROLLER, kernel side.
      //
      // Body in tests/kernel/cap/ec_query_synth.pdx. Out of line for
      // the reason every capability fixture in this module is: it
      // consumes twelve cap_table slots (200..211) and three private
      // row tables, and a fixture whose setup and teardown are one
      // function cannot leave that half-done the way an inline block
      // with a jump to a shared fail label can.
      //
      // PLACEMENT AFTER owner_sweep_witness_call IS REQUIRED, not
      // stylistic. The owner-sweep witness asserts over the whole
      // cap_table looking for slots whose owner column is stamped;
      // this fixture mints and revokes twelve capabilities and the
      // audited mints leave records in the same driver-audit ring the
      // sweep witness reads. Running this one first would put both
      // witnesses' records in the other order and each would read the
      // other's -- the same hazard the R30.M4 pair documents above.
      //
      // It binds the ACPI event stream, which evt_route_witness also
      // uses. That is safe in this order and only in this order:
      // evt_route_witness runs far earlier in this same block and
      // unbinds on both of its exits, and this fixture unbinds and
      // resets the stream on both of its own.
      //
      // ONE OF ITS ASSERTIONS WAS A DELIBERATE TRIPWIRE, and R31.M6-#1580
      // TRIPPED IT. Stage 35 now pins ec_access_arbitrated() at 1 rather
      // than at 0: the FACS address, the PM1 CNT port and the PM1 STS
      // port are all plumbed through fadt_parse into fadt_info, and the
      // R31 GLOBAL LOCK OK witness immediately above this call binds
      // them into the arbitration record. See the R31.M6-#1580 header
      // block in src/kernel/core/drivers/ec/ec_access.pdx for the
      // scope-of-what-changed statement.
      //
      // Fingerprint ordering:
      //   R31 OWNER SWEEP OK
      //   R31 GLOBAL LOCK OK        <- global_lock_witness_call
      //   R31 KIND_EC_QUERY OK      <- THIS WITNESS
      //   R31 EC ACCESS OK          <- THIS WITNESS
      //   R31 EC QUERY ROUTE OK     <- THIS WITNESS
      //   R31 EC EVENT CLASS OK     <- THIS WITNESS
      //   R31 EC EVENT SHED OK      <- THIS WITNESS
      //   R17 BIN TRUE SEED OK
      //
      // The last two are R31.M1-004/005 (#1092/#1093). They assert the
      // byte-to-class meaning table and the admission rule that stops a
      // hot-key burst evicting a power-button press — and they assert
      // NOTHING about a consumer, because there is none:
      // src/kernel/core/acpi/ec_event.pdx §1 states that in full.
      // ============================================================
      // R31.M6-#1580: the FACS address and both PM1 ports are now
      // plumbed out of the FADT into an arbitration record ring 0 can
      // consult. This witness drives fadt_parse and
      // ec_access_bind_arbitration end-to-end against a synthetic FADT
      // + FACS and asserts ec_access_arbitrated() flips 0 -> 1. It
      // MUST run BEFORE ec_query_witness_call: that witness's scrub
      // resets counters but explicitly preserves the arbitration
      // binding, and stage 35 asserts arbitrated == 1 -- exactly the
      // pin this witness set.
      global_lock_witness_call:
          call global_lock_witness

      ec_query_witness_call:
          call ec_query_witness

      // ============================================================
      // R31.M2-001 (#1094) / R31.M2-002 (#1095): the thermal zone
      // capability, and the numbers behind it.
      //
      // PLACEMENT AFTER ec_query_witness IS DELIBERATE, and for once it
      // is not about shared state -- this witness touches neither the
      // platform event stream nor the meaning table, and ec_query_witness
      // scrubs both on the way out. It is about READING ORDER. The two
      // load-bearing assertions of this pair are siblings: stage E7 of
      // ec_query_synth proves that a hot-key burst cannot displace a
      // thermal TRIP, and stage B9 here proves that a single reading
      // above _CRT cannot latch a critical crossing on its own. One is
      // about not losing the event, the other about not believing it too
      // readily, and a log in which they appear adjacent is a log in
      // which an operator can see that both halves ran.
      //
      // Fingerprint ordering:
      //   R31 EC EVENT CLASS OK
      //   R31 EC EVENT SHED OK
      //   R31 KIND_THERMAL_ZONE OK   <- THIS WITNESS
      //   R31 THERMAL SCALE OK       <- THIS WITNESS
      //
      // Like every other marker on this path, they assert arithmetic,
      // refusals and state transitions and NOTHING about a fan or a
      // shutdown: src/kernel/core/cap/kind_thermal_zone.pdx §6 lists
      // what is still missing rather than leaving it to be discovered.
      // ============================================================
      thermal_zone_witness_call:
          call thermal_zone_witness

      // ============================================================
      // R31.M2-003 (#1096): the thermal-policy MAP.
      //
      // Body in tests/kernel/policy/thermal_policy_synth.pdx. Out of
      // line for the reason every capability fixture in this module is:
      // it consumes eight cap_table slots (224..231) and one .bss
      // table, and a fixture whose setup and teardown are one function
      // cannot leave that half-done the way an inline block with a jump
      // to a shared fail label can.
      //
      // PLACEMENT AFTER thermal_zone_witness IS DELIBERATE and not
      // stylistic. It is not about shared state -- this witness touches
      // neither the zone table nor its counters, and thermal_zone_witness
      // scrubs both on the way out. It is about READING ORDER. The pair
      // of assertions is: kind's stage B9 proves that one reading above
      // _CRT does not latch a critical crossing, and this fixture's S3
      // proves that a level of CRITICAL maps to INTENT_CRITICAL and
      // NOTHING BELOW IT DOES. The kind refuses to declare the fact and
      // the policy refuses to invent one, in adjacent lines of the log,
      // so an operator can see that both halves ran.
      //
      // Cap slots 224..231, disjoint from every other witness's set
      // (0..8, 10..12, 14..19, 28..33, 46..63, 64..95, 110..117,
      // 160..199, 200..211, 212..223). Both exits scrub the map and
      // clear the slots.
      //
      // Fingerprint ordering:
      //   R31 KIND_THERMAL_ZONE OK
      //   R31 THERMAL SCALE OK
      //   R31 THERMAL POLICY MAP OK   <- THIS WITNESS
      //   R17 BIN TRUE SEED OK
      //
      // Like every other marker on this path, IT ASSERTS NOTHING ABOUT
      // A FAN AND NOTHING ABOUT A SHUTDOWN.
      // src/kernel/core/policy/thermal_policy.pdx §4 lists what is
      // still missing (KIND_COOLING_DEVICE #1103, platform-shutdown
      // #1580, ring-3 subscriber #1097, ring-3 tune shim) rather than
      // leaving it to be discovered.
      // ============================================================
      thermal_policy_witness_call:
          call thermal_policy_witness

      // ============================================================
      // R31.M3-001 (#1099): the battery capability, and the small set
      // of scale invariants behind it.
      //
      // Body in tests/kernel/cap/battery_synth.pdx. Out of line for the
      // reason every capability fixture in this module is: it consumes
      // twelve cap_table slots (232..243) and one .bss table, and a
      // fixture whose setup and teardown are one function cannot leave
      // that half-done the way an inline block with a jump to a shared
      // fail label can.
      //
      // PLACEMENT AFTER thermal_policy_witness IS DELIBERATE. It is not
      // about shared state -- this witness touches neither the thermal
      // zone table, its counters, the policy map nor the platform event
      // stream, and thermal_policy_witness scrubs its map on the way
      // out. It is about READING ORDER. The battery cluster follows the
      // thermal cluster in the R31.M3 round, and a log in which
      // "R31 KIND_BATTERY OK" appears immediately after "R31 THERMAL
      // POLICY MAP OK" is a log in which an operator can see that the
      // three platform-sensor capabilities established so far -- thermal
      // zone, thermal policy, battery -- all reported in the round's
      // published order.
      //
      // Fingerprint ordering:
      //   R31 THERMAL POLICY MAP OK
      //   R31 KIND_BATTERY OK          <- THIS WITNESS
      //   R31 BATTERY SCALE OK         <- THIS WITNESS
      //   R17 BIN TRUE SEED OK
      //
      // Like every other marker on this path, IT ASSERTS NOTHING ABOUT
      // A FAN AND NOTHING ABOUT A SHUTDOWN. cap/kind_battery.pdx §4
      // lists what is still missing (no live reader, no shutdown path
      // consuming the CRITICAL state) rather than leaving it to be
      // discovered.
      // ============================================================
      battery_witness_call:
          call battery_witness

      // ============================================================
      // R31.M3-002 (#1100): the battery_channel schema.
      //
      // Body in tests/kernel/ipc/battery_channel_synth.pdx. Out of
      // line for the reason every schema fixture in this module is:
      // its stages fall into a shared teardown path, and an inline
      // block whose fail branch jumped past that teardown would leak
      // fixture state into the next witness.
      //
      // PLACEMENT AFTER battery_witness IS DELIBERATE. It is not
      // about shared state -- the schema module has no capability,
      // no row and no cap_table read, and battery_witness scrubs its
      // own tables on the way out. It is about READING ORDER. The
      // schema is the wire face of the kind_battery row, so a log in
      // which "R31 BATTERY CHANNEL OK" appears immediately after
      // "R31 BATTERY SCALE OK" is a log in which an operator can see
      // that the numbers stored in the row and the numbers packed on
      // the wire agreed at the same boot.
      //
      // Fingerprint ordering:
      //   R31 BATTERY SCALE OK
      //   R31 BATTERY CHANNEL OK       <- THIS WITNESS
      //   R31 BATTERY MONITOR OK
      //
      // Like every other marker on this path, IT ASSERTS NOTHING
      // ABOUT A SEND, A SUBSCRIBER OR AN ENDPOINT.
      // design/ipc/battery-channel-schema.md §7 lists what is still
      // missing rather than leaving it to be discovered.
      // ============================================================
      battery_channel_witness_call:
          call battery_channel_witness

      // ============================================================
      // R31.M3-003 (#1101): the battery_monitor delta detector.
      //
      // Body in tests/kernel/policy/battery_monitor_synth.pdx. Out
      // of line for the reason every capability fixture in this
      // module is: it consumes eight cap_table slots (244..251) and
      // two .bss tables, and a fixture whose setup and teardown are
      // one function cannot leave that half-done the way an inline
      // block with a jump to a shared fail label can.
      //
      // PLACEMENT AFTER battery_channel_witness IS DELIBERATE. It
      // is not about shared state -- the monitor's tables are
      // disjoint from the schema's constants, and both witnesses
      // scrub what they touch. It is about READING ORDER. The
      // monitor sits above the schema: it computes the transitions
      // the schema packs. Reading the two markers adjacently in the
      // log is how an operator sees that both halves of the wire
      // face -- the sample-to-flag half and the flag-to-payload
      // half -- ran and passed at the same boot.
      //
      // Cap slots 244..251, disjoint from every other witness's set
      // (0..8, 10..12, 14..19, 28..33, 46..63, 64..95, 110..117,
      // 160..199, 200..211, 212..223, 224..231, 232..243). Both
      // exits reset the monitor table and clear the slots.
      //
      // Fingerprint ordering:
      //   R31 BATTERY CHANNEL OK
      //   R31 BATTERY MONITOR OK       <- THIS WITNESS
      //   R17 BIN TRUE SEED OK
      //
      // Like every other marker on this path, IT ASSERTS NOTHING
      // ABOUT A SUBSCRIBER, AN _BST NOTIFICATION OR A PLATFORM
      // SHUTDOWN. src/kernel/core/policy/battery_monitor.pdx §4
      // lists what is still missing rather than leaving it to be
      // discovered.
      // ============================================================
      battery_monitor_witness_call:
          call battery_monitor_witness

      // ============================================================
      // R31.M4-001 (#1103): the cooling-device capability, and the
      // small set of range/scale invariants behind it.
      //
      // Body in tests/kernel/cap/cooling_device_synth.pdx. Out of
      // line for the reason every capability fixture in this module
      // is: it consumes four cap_table slots (252..255) and one
      // .bss table, and a fixture whose setup and teardown are one
      // function cannot leave that half-done the way an inline
      // block with a jump to a shared fail label can.
      //
      // PLACEMENT AFTER battery_monitor_witness IS DELIBERATE. It
      // is not about shared state -- this witness touches neither
      // the battery row table, the monitor tables, the thermal
      // zone table nor the platform event stream, and each of the
      // preceding witnesses scrubs what it uses. It is about
      // READING ORDER. The cooling-device cluster is the last kind
      // in the R31.M4 round, and a log in which
      // "R31 KIND_COOLING_DEVICE OK" appears immediately after
      // "R31 BATTERY MONITOR OK" is a log in which an operator can
      // see that the four platform-sensor capabilities established
      // so far -- thermal zone, thermal policy, battery, cooling
      // device -- all reported in the round's published order.
      //
      // Fingerprint ordering:
      //   R31 BATTERY MONITOR OK
      //   R31 KIND_COOLING_DEVICE OK   <- THIS WITNESS
      //   R31 COOLING SCALE OK         <- THIS WITNESS
      //   R17 BIN TRUE SEED OK
      //
      // Like every other marker on this path, IT ASSERTS NOTHING
      // ABOUT A FAN SPEED, A THROTTLE PERCENT OR A POWER
      // TRANSITION. cap/kind_cooling_device.pdx §4 lists what is
      // still missing (no live actuator, no thermal-level-to-
      // cooling-state association) rather than leaving it to be
      // discovered.
      // ============================================================
      cooling_device_witness_call:
          call cooling_device_witness

      // ============================================================
      // R31.M5-001 (#1106): the backlight capability, and the small
      // set of range/scale invariants behind it.
      //
      // Body in tests/kernel/cap/backlight_synth.pdx. Out of line for
      // the reason every capability fixture in this module is: it
      // consumes four cap_table slots (96..99) and one .bss table, and
      // a fixture whose setup and teardown are one function cannot
      // leave that half-done the way an inline block with a jump to a
      // shared fail label can.
      //
      // PLACEMENT AFTER cooling_device_witness IS DELIBERATE. It is
      // not about shared state -- this witness touches neither the
      // cooling row table, the battery table, the thermal zone table
      // nor the platform event stream, and each of the preceding
      // witnesses scrubs what it uses. It is about READING ORDER. The
      // backlight cluster opens R31.M5, and a log in which
      // "R31 KIND_BACKLIGHT OK" appears immediately after
      // "R31 COOLING SCALE OK" is a log in which an operator can see
      // that the five platform-actuator capabilities established so
      // far -- thermal zone, thermal policy, battery, cooling
      // device, backlight -- all reported in the round's published
      // order.
      //
      // Fingerprint ordering:
      //   R31 COOLING SCALE OK
      //   R31 KIND_BACKLIGHT OK   <- THIS WITNESS
      //   R31 BACKLIGHT SCALE OK  <- THIS WITNESS
      //   R17 BIN TRUE SEED OK
      //
      // Like every other marker on this path, IT ASSERTS NOTHING
      // ABOUT A PWM DUTY CYCLE, A DPAUX BYTE OR AN ACPI _BCM/_BQC
      // METHOD. cap/kind_backlight.pdx §4 lists what is still missing
      // (no live driver, no compositor consumer) rather than leaving
      // it to be discovered.
      // ============================================================
      backlight_witness_call:
          call backlight_witness

      // ============================================================
      // R31.M5-002 (#1107): the backlight_channel schema.
      //
      // Body in tests/kernel/ipc/backlight_channel_synth.pdx. Out of
      // line for the reason every schema fixture in this module is:
      // its stages fall into a shared teardown path, and an inline
      // block whose fail branch jumped past that teardown would leak
      // fixture state into the next witness.
      //
      // PLACEMENT AFTER backlight_witness IS DELIBERATE. It is not
      // about shared state -- the schema module has no capability,
      // no row and no cap_table read, and backlight_witness scrubs
      // its own tables on the way out. It is about READING ORDER.
      // The schema is the wire face of the kind_backlight row, so a
      // log in which "R31 BACKLIGHT CHANNEL OK" appears immediately
      // after "R31 BACKLIGHT SCALE OK" is a log in which an operator
      // can see that the numbers stored in the row and the numbers
      // packed on the wire agreed at the same boot.
      //
      // Fingerprint ordering:
      //   R31 BACKLIGHT SCALE OK
      //   R31 BACKLIGHT CHANNEL OK    <- THIS WITNESS
      //   R31 PWM BACKLIGHT OK
      //
      // Like every other marker on this path, IT ASSERTS NOTHING
      // ABOUT A SEND, A SUBSCRIBER OR AN ENDPOINT.
      // design/ipc/backlight-channel-schema.md §7 lists what is
      // still missing rather than leaving it to be discovered.
      // ============================================================
      backlight_channel_witness_call:
          call backlight_channel_witness

      // ============================================================
      // R31.M5-003 (#1108): the PWM backlight driver SCAFFOLD.
      //
      // Body in tests/kernel/drivers/backlight_pwm_synth.pdx. Opens
      // the two-driver cluster for the backlight backend.
      //
      // PLACEMENT AFTER backlight_channel_witness IS DELIBERATE.
      // The schema is the wire face, the driver is the actuator
      // face; the order in the log is the order a compositor would
      // exercise them, and asserts nothing about a live MMIO write,
      // only about the scaffold's refusal discipline and the
      // arbitration pin.
      //
      // Fingerprint ordering:
      //   R31 BACKLIGHT CHANNEL OK
      //   R31 PWM BACKLIGHT OK       <- THIS WITNESS
      //   R31 DPAUX BACKLIGHT OK
      //
      // Like every other marker on this path, IT ASSERTS NOTHING
      // ABOUT AN MMIO STORE. src/kernel/core/drivers/backlight_pwm.pdx
      // §4 records that the write path is gated:hardware; the
      // fingerprint here says "the scaffold refuses correctly and
      // reports DEFERRED_HARDWARE where a real driver would report
      // OK", nothing more.
      // ============================================================
      backlight_pwm_witness_call:
          call backlight_pwm_witness

      // ============================================================
      // R31.M5-004 (#1109): the DPAUX backlight driver SCAFFOLD.
      //
      // Body in tests/kernel/drivers/backlight_dpaux_synth.pdx.
      // Closes the two-driver cluster for the backlight backend.
      //
      // PLACEMENT AFTER backlight_pwm_witness IS DELIBERATE. The
      // two backends live behind the same KIND_BACKLIGHT row
      // (kind_backlight.pdx §5 backend enumeration) and the order
      // in the log is the enumeration order (PWM=1, DPAUX=2). Same
      // discipline as PWM: the honest DEFERRED_HARDWARE outcome and
      // the FALLBACK_ACPI sentinel the driver documents for a
      // panel that does not advertise AUX backlight capability.
      //
      // Fingerprint ordering:
      //   R31 PWM BACKLIGHT OK
      //   R31 DPAUX BACKLIGHT OK     <- THIS WITNESS
      //   R17 BIN TRUE SEED OK
      //
      // Like every other marker on this path, IT ASSERTS NOTHING
      // ABOUT AN AUX TRANSACTION. src/kernel/core/drivers/
      // backlight_dpaux.pdx §4 records that the write path is
      // gated:hardware.
      // ============================================================
      backlight_dpaux_witness_call:
          call backlight_dpaux_witness

      // ============================================================
      // R31.M6-001 (#1111) + R31.M6-002 (#1112) + R31.M6-003 (#1113):
      // the hot-key dispatch cluster.
      //
      // Body in tests/kernel/input/hotkey_synth.pdx. Out of line for
      // the reason every capability fixture in this module is: it
      // consumes four cap_table slots (100..103), one dispatch-table
      // .bss array and one live KIND_BACKLIGHT capability that must
      // be revoked on either exit, and a fixture whose setup and
      // teardown are one function cannot leave that half-done the
      // way an inline block with a jump to a shared fail label can.
      //
      // PLACEMENT AFTER backlight_dpaux_witness IS DELIBERATE. The
      // #1112 stage of this witness mints a KIND_BACKLIGHT and calls
      // backlight_report_install through the hot-key dispatcher's
      // composed helper; that is the actuator surface the two
      // preceding driver scaffolds prepared for. Reading
      // "R31 HOTKEY BACKLIGHT OK" immediately after "R31 DPAUX
      // BACKLIGHT OK" is how an operator sees that both the
      // driver-scaffold side (dpaux/pwm) and the intent-decoding side
      // (hot-key -> backlight_report_install) reported at the same
      // boot.
      //
      // THREE FINGERPRINTS, one per issue in the R31.M6 cluster:
      //
      //   R31 HOTKEY VOLUME OK      <- #1111
      //   R31 HOTKEY BACKLIGHT OK   <- #1112
      //   R31 HOTKEY MEDIA OK       <- #1113
      //
      // Three rather than one because the three issues can fail for
      // unrelated reasons (a broken sink enumeration, a
      // KIND_BACKLIGHT regression, a counter arithmetic bug), and a
      // golden that asserts an ordered subsequence needs the three
      // failures distinguishable in the log.
      //
      // Like every other marker on this path, IT ASSERTS NOTHING
      // ABOUT AN AUDIO STREAM, A MICROPHONE MUTE PIN OR A PLAY-PAUSE
      // HID EVENT. KIND_HID_EVENT is R32's, no audio subsystem exists
      // in this tree, and src/kernel/core/input/hotkey_dispatch.pdx
      // §0.1 records the deferrals rather than leaving them to be
      // discovered.
      // ============================================================
      hotkey_witness_call:
          call hotkey_witness

      // ============================================================
      // R32.M1-001 (#1115) + R32.M1-002 (#1116) + R32.M1-003 (#1117):
      // THE I²C-HID TRANSPORT CLUSTER — touchpad + trackpoint side.
      //
      // Body in tests/kernel/drivers/i2c_hid/{transport,descriptor,isr}
      // _synth.pdx. Out of line for the reason every scaffold fixture
      // in this module is: each consumes its own private .bss cells
      // (bind flag, stats, per-field descriptor storage) and a fixture
      // whose setup and teardown are one function cannot leave that
      // half-done the way an inline block with a jump to a shared fail
      // label can.
      //
      // PLACEMENT AFTER hotkey_witness IS DELIBERATE. The three
      // witnesses form a chain: descriptor_witness's S2 calls
      // i2c_hid_descriptor_fetch, which requires the transport bound
      // (transport_witness leaves it bound); isr_witness's S4 calls
      // i2c_hid_isr_assert, which requires the descriptor valid
      // (descriptor_witness leaves it valid). Running them in a
      // different order would invert those assertions -- fetch would
      // return NOT_BOUND, assert would return NO_DESC -- so the log
      // order is the dependency order.
      //
      // WHY THIS CLUSTER SITS AT THE END OF R31 RATHER THAN OPENING
      // R32 IN ITS OWN MODULE. R32 will get its own witness module
      // when the cluster grows past three markers (R32.M2 adds the
      // real KIND_I2C_BUS binding through the transport; R32.M3 adds
      // the HID class driver and KIND_HID_EVENT; R32.M4 the sensor
      // hub). Three markers on their own do not carry a module of
      // their own, and folding them here keeps the ORDERED-SUBSEQUENCE
      // matching in the shell-shutdown golden simple: append at the
      // end of the R31 run, before the R30 probes.
      //
      // THREE FINGERPRINTS, one per issue:
      //
      //   R32 I2C_HID TRANSPORT OK   <- #1115
      //   R32 I2C_HID DESCRIPTOR OK  <- #1116
      //   R32 I2C_HID ISR OK         <- #1117
      //
      // Three rather than one because the three issues can fail for
      // unrelated reasons (a broken bind latch, a descriptor field
      // parse error, a missed transport propagation on assert), and a
      // golden that asserts an ordered subsequence needs the three
      // failures distinguishable in the log.
      //
      // Like every other marker on this path, THEY ASSERT NOTHING
      // ABOUT A REAL I²C TRANSFER, A REAL GPIO EDGE SUBSCRIPTION, OR
      // A REAL HID EVENT DELIVERY. src/kernel/core/drivers/i2c_hid/
      // {transport,descriptor,isr}.pdx §4/§3 list the gated:hardware
      // deferrals rather than leaving them to be discovered.
      // ============================================================
      i2c_hid_transport_witness_call:
          call i2c_hid_transport_witness

      i2c_hid_descriptor_witness_call:
          call i2c_hid_descriptor_witness

      i2c_hid_isr_witness_call:
          call i2c_hid_isr_witness

      // ============================================================
      // R32.M1-004 (#1118): the I²C-HID RESET + WAKE scaffold.
      //
      // Body in tests/kernel/drivers/i2c_hid/reset_wake_synth.pdx.
      // Emits TWO fingerprints (RESET OK, WAKE OK) from one function,
      // for the same reason the hot-key cluster emits three (R31.M6):
      // reset and wake can fail for unrelated reasons -- a wrong
      // command-register index, a wrong SET_POWER opcode -- and the
      // ordered-subsequence golden needs the two failures
      // distinguishable in the log.
      //
      // PLACEMENT AFTER i2c_hid_isr_witness_call IS REQUIRED. Both
      // reset_send and wake_send propagate the transport's write
      // seam, and the seam returns NOT_BOUND unless the transport is
      // bound (transport_witness leaves it so). Running before
      // transport_witness would flip the DEFERRED_HARDWARE assertion
      // to NOT_BOUND on the happy path.
      //
      // Fingerprint ordering:
      //   R32 I2C_HID ISR OK
      //   R32 I2C_HID RESET OK     <- THIS WITNESS
      //   R32 I2C_HID WAKE OK      <- THIS WITNESS
      //   R32 I2C_HID QUIRKS OK
      //
      // Like every other marker on this path, IT ASSERTS NOTHING
      // ABOUT A REAL COMMAND WRITE. src/kernel/core/drivers/i2c_hid/
      // reset_wake.pdx §3 lists the gated:hardware deferrals.
      // ============================================================
      i2c_hid_reset_wake_witness_call:
          call i2c_hid_reset_wake_witness

      // ============================================================
      // R32.M1-005 (#1119): the I²C-HID QUIRK TABLE.
      //
      // Body in tests/kernel/drivers/i2c_hid/quirks_synth.pdx.
      // Compile-time table of two entries (Synaptics 0x06CB /
      // ELAN 0x04F3) with product-wildcard rows, and a linear
      // two-pass lookup (exact then wildcard). ONE fingerprint.
      //
      // PLACEMENT is unconstrained: the table is .rodata, the lookup
      // reads a compile-time constant count, and this witness reads
      // (but does not modify) the honesty-pin counter. Placed at the
      // end of the R32.M1 cluster because it is the last M1 issue.
      //
      // Fingerprint:
      //   R32 I2C_HID QUIRKS OK    <- THIS WITNESS
      //
      // Like every other marker on this path, IT ASSERTS NOTHING
      // ABOUT A LIVE BRING-UP DECISION. src/kernel/core/drivers/
      // i2c_hid/quirks.pdx §0 documents that no consumer exists yet;
      // the honesty pin fires when one lands.
      // ============================================================
      i2c_hid_quirks_witness_call:
          call i2c_hid_quirks_witness

      // ============================================================
      // R32.M2-001 (#1120) + R32.M2-002 (#1121) + R32.M2-003 (#1122):
      // THE HID CLASS-DRIVER SUBSTRATE — report-descriptor parser,
      // usage-page classifier, and collection walker.
      //
      // Body in tests/kernel/drivers/hid/{report_parser,usage,
      // collection_walker}_synth.pdx. Each is out of line for the reason
      // every scaffold fixture in this module is: each consumes its own
      // private .bss cells (stage counter, callback counters, parser
      // scratch) and a fixture whose setup and teardown are one function
      // cannot leave that half-done the way an inline block with a jump
      // to a shared fail label can.
      //
      // PLACEMENT AFTER i2c_hid_quirks_witness IS DELIBERATE. The R32.M2
      // cluster is the READ SIDE of the descriptor bytes R32.M1's
      // transport / descriptor / isr / reset-wake / quirks scaffolds
      // fetch and store. Reading "R32 HID PARSER OK" immediately after
      // "R32 I2C_HID QUIRKS OK" is how an operator sees that both halves
      // of the descriptor path — the TRANSPORT half (M1: get 30 bytes)
      // and the PARSE half (M2: interpret them into typed fields) —
      // reported at the same boot.
      //
      // ORDER WITHIN THE CLUSTER IS REQUIRED, not stylistic. Parser
      // witness must run FIRST: it populates _hid_report_schema (via a
      // canonical boot-mouse fixture) and ends with a re-feed so the
      // schema is left valid for whatever consumes it next. Usage
      // witness runs SECOND: it is independent (touches no schema state,
      // only the usage.pdx table), and slotting it between parser and
      // walker keeps the golden's ordered subsequence aligned with the
      // issue-number order (1120, 1121, 1122). Walker witness runs
      // THIRD: it CONSUMES the parser's schema (collection_count,
      // max_depth, type_at, depth_at, walk-callback all read
      // _hid_report_schema / _hid_report_valid / _hid_report_count),
      // and would assert against zeroed storage if the parser had not
      // populated it — the collection_count assertion would see 0
      // rather than 2, and the walk-callback checksum would sum to
      // zero, giving a false positive on a build where the walker was
      // gutted.
      //
      // THREE FINGERPRINTS, one per issue in the R32.M2 cluster:
      //
      //   R32 HID PARSER OK       <- #1120
      //   R32 HID USAGE OK        <- #1121
      //   R32 HID COLLECTION OK   <- #1122
      //
      // Three rather than one because the three issues can fail for
      // unrelated reasons (a broken item-stream walk, a mis-ordered
      // usage table row, a callback contract regression), and a golden
      // that asserts an ordered subsequence needs the three failures
      // distinguishable in the log.
      //
      // Like every other marker on this path, THEY ASSERT NOTHING
      // ABOUT A LIVE DEVICE. The parser fixture is a .rodata byte
      // array, the usage classifier's honesty pin stays at 0, and the
      // walker's callback is a witness-local counter. When R32.M3
      // wires the HID class driver, the three honesty pins
      // (hid_usage_consumed, hid_collection_walker_consumed, plus the
      // parser's implicit "no consumer" state) flip together and the
      // corresponding assertions fail — forcing the design docs to be
      // rewritten with the live consumers' shapes.
      // ============================================================
      hid_report_parser_witness_call:
          call hid_report_parser_witness

      hid_usage_witness_call:
          call hid_usage_witness

      hid_collection_walker_witness_call:
          call hid_collection_walker_witness

      // ============================================================
      // R32.M2-004 (#1123): the HID FIELD EXTRACTOR scaffold.
      //
      // Body in tests/kernel/drivers/hid/field_extract_synth.pdx. Out
      // of line for the reason every scaffold fixture in this module
      // is: it consumes its own private .bss cells (stage counter,
      // three .rodata report fixtures) and a fixture whose setup and
      // teardown are one function cannot leave that half-done the way
      // an inline block with a jump to a shared fail label can.
      //
      // PLACEMENT AFTER hid_collection_walker_witness IS DELIBERATE.
      // The extractor is the READ-SIDE consumer of the parsed schema's
      // report_size / report_count values, though it does not consult
      // the schema at its own arity (§0 of field_extract.pdx). Reading
      // "R32 HID FIELD OK" immediately after "R32 HID COLLECTION OK"
      // is how an operator sees that both halves of the schema-to-
      // value pipeline reported at the same boot -- the WALK half
      // (M2-003: iterate the schema) and the DECODE half (M2-004:
      // turn its geometry into u64 values).
      //
      // Fingerprint ordering:
      //   R32 HID COLLECTION OK
      //   R32 HID FIELD OK          <- THIS WITNESS
      //   R32 HID REPORT IO OK
      //
      // Like every other marker on this path, IT ASSERTS NOTHING
      // ABOUT A LIVE ROUTING DECISION. The consumer honesty pin
      // stays at 0. When R32.M3 wires the HID class driver, it flips
      // and the assertion fails -- forcing the design doc to be
      // rewritten with the live consumer's shape.
      // ============================================================
      hid_field_extract_witness_call:
          call hid_field_extract_witness

      // ============================================================
      // R32.M2-005 (#1124): the HID GET/SET_REPORT round-trip scaffold.
      //
      // Body in tests/kernel/drivers/hid/report_io_synth.pdx. Out of
      // line for the reason every scaffold fixture in this module is:
      // each round-trip touches two disjoint stats arrays (get / set)
      // and a fixture whose setup and teardown are one function cannot
      // leave that half-done the way an inline block with a jump to a
      // shared fail label can.
      //
      // PLACEMENT AFTER hid_field_extract_witness IS DELIBERATE. The
      // extractor is the READ SIDE of a GET_REPORT payload (decode the
      // returned bytes into a field value); this module is the
      // COMMAND-DISPATCH side (issue the GET/SET command). Reading
      // "R32 HID REPORT IO OK" immediately after "R32 HID FIELD OK"
      // is how an operator sees that both halves of the round-trip
      // reported at the same boot. It also requires the transport
      // bound (transport_witness leaves it so); the propagated
      // DEFERRED_HARDWARE assertion would invert to NOT_BOUND
      // otherwise -- placement after every R32.M1 witness holds this
      // dependency automatically.
      //
      // ONE FINGERPRINT. GET and SET are not split into two markers as
      // reset/wake are (#1118), because the two failure modes are the
      // same (a wrong opcode / register + a mistaken propagation
      // shape) and the three refusal gates (BAD_TYPE, BAD_ID) are
      // shared between the two seams. Splitting would multiply markers
      // without multiplying failure-localisation.
      //
      // Fingerprint ordering:
      //   R32 HID FIELD OK
      //   R32 HID REPORT IO OK       <- THIS WITNESS
      //   R17 BIN TRUE SEED OK
      //
      // Like every other marker on this path, IT ASSERTS NOTHING
      // ABOUT A REAL COMMAND WRITE OR A REAL PAYLOAD READ.
      // src/kernel/core/drivers/hid/report_io.pdx §3 lists the
      // gated:hardware deferrals rather than leaving them to be
      // discovered.
      // ============================================================
      hid_report_io_witness_call:
          call hid_report_io_witness

      // ============================================================
      // R32.M3-001 (#1125) + R32.M3-002 (#1126): THE HID CAPABILITY
      // CLUSTER — KIND_HID_DEVICE and KIND_HID_EVENT.
      //
      // Body in tests/kernel/cap/{hid_device,hid_event}_synth.pdx.
      // Out of line for the reason every capability fixture in this
      // module is: each consumes its own private .bss cells (stage
      // counter, row tables, statistics) and a fixture whose setup
      // and teardown are one function cannot leave that half-done
      // the way an inline block with a jump to a shared fail label
      // can.
      //
      // PLACEMENT AFTER hid_report_io_witness IS DELIBERATE. The
      // R32.M2 cluster (parser / usage / walker / field / report_io)
      // is the READ SIDE of the descriptor and report BYTES that a
      // KIND_HID_DEVICE cap will one day be handed by the class
      // driver -- the capability names the device those bytes
      // describe, so a log in which "R32 KIND_HID_DEVICE OK"
      // appears immediately after "R32 HID REPORT IO OK" is a log
      // in which an operator sees both the BYTE-STREAM half (M2)
      // and the AUTHORITY half (M3) reported at the same boot.
      //
      // WITHIN THE CLUSTER, DEVICE FIRST, EVENT SECOND. The two
      // kinds are DISJOINT storage on purpose (kind_hid_device.pdx
      // §3, kind_hid_event.pdx §3): device derives over KIND_DEVICE,
      // event derives over KIND_IPC_ENDPOINT, and the R32.M4 router
      // that will one day connect them consults BOTH. Reporting
      // device before event mirrors the issue-number order (#1125
      // before #1126) and keeps the ordered-subsequence golden
      // simple.
      //
      // FOUR FINGERPRINTS, two per issue -- STAGE A / STAGE B per
      // the split argument in each synth's header:
      //
      //   R32 KIND_HID_DEVICE OK       <- #1125 stage A
      //   R32 HID_TRANSPORT scale OK   <- #1125 stage B
      //   R32 KIND_HID_EVENT OK        <- #1126 stage A
      //   R32 HID_EVT_MASK scale OK    <- #1126 stage B
      //
      // Two per issue rather than one because A and B can fail for
      // unrelated reasons (a broken gate half vs a broken
      // enumeration), and a golden that asserts an ordered
      // subsequence needs the two failures distinguishable.
      //
      // Like every other marker on this path, THEY ASSERT NOTHING
      // ABOUT A LIVE DEVICE OR A ROUTED EVENT. The device kind
      // exposes a report_install counter but no route, and the
      // event kind is a subscription record no router yet consults.
      // See cap/kind_hid_device.pdx §4 and cap/kind_hid_event.pdx
      // §3 for the deferrals.
      // ============================================================
      hid_device_witness_call:
          call hid_device_witness

      hid_event_witness_call:
          call hid_event_witness

      // ============================================================
      // R32.M3-003 (#1127) + R32.M3-004 (#1128): THE HID EVENT STREAM
      // — the fanout that closes R32.M3.
      //
      // Body in tests/kernel/drivers/hid/event_stream_synth.pdx
      // (fanout scaffold) and tests/kernel/ipc/
      // hid_event_stream_channel_synth.pdx (schema).
      //
      // PLACEMENT AFTER hid_event_witness IS REQUIRED, not stylistic.
      // The stream witness (#1127) mints three KIND_HID_EVENT
      // capabilities through hid_event_cap_mint to test subscribe /
      // publish / unsubscribe. That requires the KIND_HID_EVENT gate
      // and row table to be valid — which they are once
      // hid_event_witness has run its scrub-on-exit. Running before
      // would collide with that fixture's slot range (118..123) and
      // with its uniqueness gate. Cap slots 124..131 for the stream
      // witness are disjoint from every other witness's set.
      //
      // ORDER WITHIN THE CLUSTER IS REQUIRED. The stream witness runs
      // FIRST because it exercises subscribe / publish / unsubscribe,
      // which is what the schema is packing bytes FOR. The schema
      // witness runs SECOND: it is pure pack/unpack arithmetic with
      // no cap_table touch, and slotting it after keeps the golden's
      // ordered subsequence aligned with the issue-number order
      // (1127, 1128).
      //
      // TWO FINGERPRINTS, one per issue:
      //
      //   R32 HID EVENT STREAM OK           <- #1127
      //   R32 HID EVENT STREAM SCHEMA OK    <- #1128
      //
      // Two rather than one because the two issues can fail for
      // unrelated reasons (a broken subscribe gate vs a broken
      // packer), and a golden that asserts an ordered subsequence
      // needs the two failures distinguishable in the log.
      //
      // Like every other marker on this path, THEY ASSERT NOTHING
      // ABOUT A REAL EVENT ENQUEUE or A REAL SUBSCRIBER RECEIVE.
      // event_stream.pdx §4 and hid_event_stream_channel.pdx §7
      // list the R32.M4-gated deferrals: no byte crosses a process
      // boundary in this tree; the honest per-subscriber delivered
      // counter is what the fanout maintains until then.
      // ============================================================
      hid_event_stream_witness_call:
          call hid_event_stream_witness

      hid_event_stream_schema_witness_call:
          call hid_event_stream_schema_witness

      // ============================================================
      // R32.M4-001..004 (#1129..1132): the FOUR GESTURE RECOGNIZERS
      // — closes R32.M4 gesture-recognition scaffolding.
      //
      // Body in tests/kernel/drivers/hid/gestures_synth.pdx.
      //
      // PLACEMENT AFTER the HID event stream witnesses is required.
      // The recognizers will (in a follow-up) subscribe to the
      // stream's POINTER / TOUCH classes; running the gesture
      // witnesses BEFORE the stream cluster would either read a
      // stream state the stream witness later scrubs or force a
      // brittle order-dependent scrub here. Running AFTER means the
      // stream witness has already returned to its clean state and
      // the four gesture recognizers touch only their own storage
      // (gestures.pdx §2), so nothing interleaves.
      //
      // ORDER WITHIN THE CLUSTER is issue-number order: 2FSCROLL
      // (#1129), PINCH (#1130), KINETIC (#1131), SWIPE (#1132).
      // The recognizers touch DISJOINT storage cells (§2) so no
      // ordering is load-bearing; issue order keeps the golden
      // subsequence aligned with git history.
      //
      // FOUR FINGERPRINTS, one per issue:
      //
      //   R32 GESTURE 2FSCROLL OK    <- #1129
      //   R32 GESTURE PINCH OK       <- #1130
      //   R32 GESTURE KINETIC OK     <- #1131
      //   R32 GESTURE SWIPE OK       <- #1132
      //
      // Four rather than one because the four recognizers can fail
      // for unrelated reasons (broken threshold vs broken direction
      // bin vs broken decay ratio) and the golden's ordered
      // subsequence needs the four distinguishable in the log.
      //
      // Like every other marker on this path, THEY ASSERT NOTHING
      // ABOUT A REAL HID EVENT SOURCE or the touchpad hardware —
      // gestures.pdx §0 lists both deferrals. The step functions
      // are exercised by synthetic touch sequences; when the
      // touchpad class driver lands it wires these step functions
      // into its pointer path without this file changing.
      // ============================================================
      gesture_scroll_witness_call:
          call gesture_scroll_witness

      gesture_pinch_witness_call:
          call gesture_pinch_witness

      gesture_kinetic_witness_call:
          call gesture_kinetic_witness

      gesture_swipe_witness_call:
          call gesture_swipe_witness

      // ============================================================
      // R32.M5-001 (#1133) + R32.M5-002 (#1134) + R32.M5-003 (#1135):
      // the SENSOR HUB CLUSTER — closes R32.M5.
      //
      // Body in tests/kernel/cap/sensor_channel_synth.pdx (the
      // KIND_SENSOR_CHANNEL capability), tests/kernel/drivers/
      // sensor_hub_synth.pdx (the three-mount scaffold driver), and
      // tests/kernel/ipc/sensor_read_channel_synth.pdx (the wire
      // schema).
      //
      // PLACEMENT AFTER THE GESTURE CLUSTER IS REQUIRED, not
      // stylistic. The hub witness mints a KIND_HID_EVENT
      // subscription on HID_EVT_SENSOR through hid_event_cap_mint,
      // subscribes it to the fanout via hid_event_stream_subscribe,
      // and asserts the three sample paths bump the subscriber's
      // delivered counter -- which requires the KIND_HID_EVENT gate,
      // the row table and the fanout in a clean state. Running
      // before the hid_event_witness / hid_event_stream_witness
      // cluster would collide with their (endpoint, mask) fixtures.
      // Both exits scrub the hub state, the KIND_SENSOR_CHANNEL row
      // table, the stream and the KIND_HID_EVENT row table.
      //
      // ORDER WITHIN THE CLUSTER IS REQUIRED. The capability witness
      // runs FIRST because it establishes the row-table / mint gate
      // invariants the hub witness's own subscription mint depends
      // on. The hub witness runs SECOND because it drives the
      // fanout (which requires the KIND_HID_EVENT plumbing to be
      // valid). The schema witness runs THIRD because it is pure
      // pack/unpack arithmetic with no cap_table touch, and slotting
      // it after keeps the golden's ordered subsequence aligned
      // with the issue-number order (1133, 1134, 1135).
      //
      // THREE FINGERPRINTS, one per issue:
      //
      //   R32 KIND_SENSOR OK      <- #1133
      //   R32 SENSOR HUB OK       <- #1134
      //   R32 SENSOR SCHEMA OK    <- #1135
      //
      // Three rather than one because the three issues can fail for
      // unrelated reasons (a broken gate half vs a broken fanout
      // path vs a broken packer), and the ordered-subsequence
      // golden needs the three failures distinguishable in the log.
      //
      // Cap slots 132..147 (132..139 for the capability witness,
      // 140..147 for the hub witness; the schema witness uses no
      // cap slots), disjoint from every other witness's set.
      //
      // Like every other marker on this path, THEY ASSERT NOTHING
      // ABOUT A LIVE I²C-HID TRANSFER FROM THE SENSOR HUB. The
      // driver's arbitrated() pin stays at 0. When a gated:hardware
      // milestone plumbs a real KIND_I2C_SLAVE + KIND_HID_DEVICE
      // through sensor_hub_bind, the pin fails and this witness'
      // stage 1 assertion must be rewritten in the same commit.
      // See src/kernel/core/drivers/sensor_hub.pdx §4 for the
      // gated:hardware deferrals and design/ipc/sensor-read-channel-
      // schema.md §7 for the schema deferrals.
      // ============================================================
      sensor_channel_witness_call:
          call sensor_channel_witness

      sensor_hub_witness_call:
          call sensor_hub_witness

      sensor_read_channel_witness_call:
          call sensor_read_channel_witness

      // ============================================================
      // R33.M1-005 (#1141): KIND_AUDIO_CONTROLLER capability witness.
      //
      // Body in tests/kernel/cap/audio_controller_synth.pdx. Asserts
      // the derivation gate over KIND_DEVICE, one-controller-per-device,
      // the ring-size refusals, the report installer's plausibility
      // gate, the revoke, and the dispatch handler.
      //
      // PLACEMENT BEFORE THE HDA CONTROLLER CLUSTER IS DELIBERATE.
      // The capability is the record of a supervisor's decision that a
      // KIND_DEVICE names an HDA controller; the scaffolds after it
      // exercise the register / ring frames. Running the capability
      // witness first keeps the fingerprint order aligned with the
      // "kind before driver" narrative in cap/kind_audio_controller.pdx
      // §2 and mirrors how sensor_channel runs before sensor_hub.
      //
      // Cap slots 100..103, disjoint from every other witness's set
      // (backlight 96..99, hid_device 108..111, sensor 132..147).
      //
      // TWO FINGERPRINTS: "R33 KIND_AUDIO_CTRL OK" (stage A: the
      // gate) then "R33 AUDIO_CTRL COUNT OK" (stage B: the count).
      // Two rather than one because the two stages fail for unrelated
      // reasons and an ordered-subsequence golden needs them
      // distinguishable.
      // ============================================================
      audio_ctrl_witness_call:
          call audio_ctrl_witness

      // ============================================================
      // R33.M1-001 (#1137) + R33.M1-002 (#1138) + R33.M1-003 (#1139)
      // + R33.M1-004 (#1140) + R33.M2-001 (#1142): the HDA CONTROLLER
      // CLUSTER -- opens R33.
      //
      // Bodies in tests/kernel/drivers/hda/{controller,reset,corb,
      // rirb}_synth.pdx. Each is a scaffold witness at the
      // "declare BAR handle + register offsets + honesty-pin
      // arbitrated()==0" level: hda/controller.pdx §4, hda/reset.pdx
      // §3, hda/corb.pdx §4 and hda/rirb.pdx §4 document the
      // gated:hardware deferrals that R33.M2 will land.
      //
      // ORDER WITHIN THE CLUSTER IS REQUIRED. controller_witness
      // runs FIRST because it establishes the bind latch every other
      // seam in the cluster gates on -- reset_witness dispatches
      // through hda_controller_write, and both corb_witness and
      // rirb_witness inherit the controller's bound state through
      // the shared BAR handle. Running reset_witness before
      // controller_witness would flip the DEFERRED_HARDWARE
      // assertion on arm/release to NOT_BOUND. CORB and RIRB are
      // independent of each other (each owns its own init latch),
      // but keeping them adjacent lets the ordered-subsequence
      // golden read the R33.M1 cluster as one block.
      //
      // FIVE FINGERPRINTS, one per issue:
      //
      //   R33 HDA CONTROLLER OK       <- #1137
      //   R33 HDA RESET OK            <- #1138
      //   R33 HDA CORB OK             <- #1139
      //   R33 HDA RIRB OK             <- #1140
      //   R33 HDA CODEC DISCOVER OK   <- #1142
      //
      // Five rather than one because the five issues can fail for
      // unrelated reasons (a broken bind latch vs a wrong GCTL
      // opcode vs a wrong CORBSIZE code vs a wrong RIRB
      // classification vs a broken verb encode), and a golden that
      // asserts an ordered subsequence needs the failures
      // distinguishable in the log.
      //
      // Like every other marker on this path, THEY ASSERT NOTHING
      // ABOUT A REAL PCI PROBE, REAL MMIO, OR A REAL CODEC VERB /
      // RESPONSE ROUND-TRIP. The four arbitrated() pins stay at 0
      // and the boot witness asserts that; when R33.M2 plumbs the
      // real BAR mapping + ring DMA + verb round-trip, those pins
      // flip and this witness's stage 1 assertion must be
      // rewritten in the same commit.
      // ============================================================
      hda_controller_witness_call:
          call hda_controller_witness

      hda_reset_witness_call:
          call hda_reset_witness

      hda_corb_witness_call:
          call hda_corb_witness

      hda_rirb_witness_call:
          call hda_rirb_witness

      hda_codec_discovery_witness_call:
          call hda_codec_discovery_witness

      // ============================================================
      // R33.M2-002 (#1143) + R33.M2-003 (#1144) + R33.M2-004 (#1145):
      // the HDA CODEC TYPED-RECORD + DECODER + VERB HELPERS cluster.
      //
      // Bodies in tests/kernel/drivers/hda/{widget_graph,pin_config,
      // verbs}_synth.pdx. Widget graph and pin config are typed
      // records / pure decoders (no MMIO, no verb round-trip); the
      // verb helpers scaffold the SET/GET dispatch and stop at
      // hda_corb_submit + hda_rirb_consume (both scaffolds).
      //
      // ORDER WITHIN THE CLUSTER: verbs_witness runs LAST because
      // it gates on hda_corb_bound() && hda_rirb_bound(), which
      // hda_corb_witness and hda_rirb_witness leave SET. Running
      // verbs_witness before either would flip its DEFERRED_HARDWARE
      // assertion to NOT_READY. widget_graph_witness and
      // pin_config_witness are independent of the ring latches and
      // may run in any order (they touch only their own state); the
      // sequence WG -> PC -> Verbs matches the narrative "the graph
      // is the record, the decoder reads a field of it, the verbs
      // act on it".
      //
      // THREE FINGERPRINTS, one per issue:
      //
      //   R33 HDA WIDGET GRAPH OK  <- #1143
      //   R33 HDA PIN CONFIG OK    <- #1144
      //   R33 HDA VERBS OK         <- #1145
      //
      // Three rather than one because the three issues can fail for
      // unrelated reasons (a wrong widget-type gate vs a shift-by-
      // wrong-count in one decoder vs a broken send_long path) and
      // a golden that asserts an ordered subsequence needs the
      // failures distinguishable in the log.
      //
      // Like the other R33 markers, THEY ASSERT NOTHING ABOUT A
      // REAL VERB RESPONSE OR A REAL CODEC ROUND-TRIP. The
      // arbitrated() pins stay at 0 and the boot witness asserts
      // that; when R33.M3 plumbs the real response reader the
      // three pins flip and the stage 1 assertions here must be
      // rewritten in the same commit.
      // ============================================================
      hda_widget_graph_witness_call:
          call hda_widget_graph_witness

      hda_pin_config_witness_call:
          call hda_pin_config_witness

      hda_verbs_witness_call:
          call hda_verbs_witness

