      // Opens the R35.M9 three-marker block (DP-tunnel bridge to R36:
      // virtual DDI shim + AUX pass-through + hot-plug bridge). This is
      // the last cluster in the r35-thunderbolt milestone; R36 opens
      // with KIND_DISPLAY_OUTPUT that consumes the placeholder events
      // this cluster emits.
      //
      // No cap slots — module owns its own rows + stats. Placement
      // after tunnel_priority_witness_call keeps the R35.M8 -> R35.M9
      // boundary contiguous in the log.
      //
      // Fingerprint: R35 TB DP DDI SHIM OK
      // ============================================================
      dp_ddi_shim_witness_call:
          call dp_ddi_shim_witness

      // ============================================================
      // R35.M9-002 (#1230): TB4 DP AUX pass-through.
      // Body in tests/kernel/drivers/tb/dp_aux_passthru_synth.pdx.
      //
      // 16-slot in-flight AUX ring with ACK/NACK/DEFER response
      // arbitration (DP 2.1 §2.4 / USB4 §10.6). Witness asserts the
      // four command types (NATIVE_R/W, I2C_R/W), 20-bit address
      // bound, 1..16 byte length bound, ring ENOSPC at slot 17, and
      // the three response terminals.
      //
      // No cap slots — module owns its own ring + stats.
      //
      // Fingerprint: R35 TB DP AUX OK
      // ============================================================
      dp_aux_passthru_witness_call:
          call dp_aux_passthru_witness

      // ============================================================
      // R35.M9-003 (#1231): TB4 DP-adapter hot-plug bridge.
      // Body in tests/kernel/drivers/tb/dp_hotplug_bridge_synth.pdx.
      //
      // Filters tb_topology_channel tunnel_established/tunnel_torn
      // events, drops non-DP tunnel types, emits placeholder
      // _dp_output_event records into a 16-slot recent-emissions ring
      // that R36's KIND_DISPLAY_OUTPUT consumer will replace with a
      // real fanout through display_topology_channel. Closes the
      // R35.M9 cluster; R35.M10 (below) closes the r35-thunderbolt
      // milestone's structural witness block.
      //
      // No cap slots — module owns its own event ring + stats.
      //
      // Fingerprint: R35 TB DP HOTPLUG BRIDGE OK
      // ============================================================
      dp_hotplug_bridge_witness_call:
          call dp_hotplug_bridge_witness

      // ============================================================
      // R35.M10-001 (#1232): USB3-tunnel virtual xHCI extension.
      // Body in tests/kernel/drivers/tb/usb3_xhci_ext_synth.pdx.
      //
      // Opens the R35.M10 three-marker block (USB3 virtual xHCI +
      // USB-PD contract + DP alt-mode). Presents a tunneled USB3 host
      // as an additional (xhci_base_port, port_count) range grafted
      // onto the local xHCI port set, and carries placeholder
      // port_added / port_removed events R34's USB supervisor will
      // consume once a live binding lands. Witness asserts BAD_*
      // taxonomy, OVERLAP + DUP invariants, ENOSPC at the fifth row,
      // and per-row port_index bounds.
      //
      // No cap slots — module owns its own rows + stats.
      //
      // Fingerprint: R35 TB USB3 XHCI EXT OK
      // ============================================================
      usb3_xhci_ext_witness_call:
          call usb3_xhci_ext_witness

      // ============================================================
      // R35.M10-002 (#1233): USB-PD contract negotiation.
      // Body in tests/kernel/drivers/tb/usbpd_contract_synth.pdx.
      //
      // Per-port PD 3.1 §6.4 state machine (IDLE -> ADVERTISED ->
      // REQUESTED -> ACCEPTED -> READY, plus a REJECTED terminal
      // for negative requests). Profiles are the five standard PDOs
      // (5V/9V/15V/20V @ 3A, plus PPS); every accepted profile's
      // wattage is capped by PDC_MAX_WATTAGE (100 W). Witness
      // exercises the four transitions, UNADVERTISED refusal,
      // BAD_STATE grammar guards, and the wattage lookup.
      //
      // No cap slots — module owns its own port table + stats.
      //
      // Fingerprint: R35 TB USBPD CONTRACT OK
      // ============================================================
      usbpd_contract_witness_call:
          call usbpd_contract_witness

      // ============================================================
      // R35.M10-003 (#1234): DP alt-mode via USB-PD SVDMs.
      // Body in tests/kernel/drivers/tb/dp_altmode_synth.pdx.
      //
      // Closes the R35.M10 cluster AND the r35-thunderbolt milestone's
      // structural witness block. Per-port DP Alt Mode 2.1 FSM
      // (INACTIVE -> ENTERED -> CONFIGURED -> EXITED) plus the DP
      // Status VDM's role/HPD bits. Pin assignments A..F validated as
      // exactly-one-bit set within the DP mask; SVID pinned at
      // 0xFF01 (VESA DP). Witness exercises Enter/Configure/Exit,
      // Status VDM, ALREADY_ENTERED / NOT_ENTERED guards, and the
      // exactly-one-bit pin validator.
      //
      // No cap slots — module owns its own port table + stats.
      //
      // Fingerprint: R35 TB DP ALTMODE OK
      // ============================================================
      dp_altmode_witness_call:
          call dp_altmode_witness

      // ============================================================
      // R36.M1-004 (#1238): KIND_DISPLAY_ENGINE capability witness.
      // Body in tests/kernel/cap/display_engine_synth.pdx.
      //
      // Cap slots 256..263 — a fresh range past every prior
      // witness's set (previous max: 252..255 consent_revoke_synth).
      // Both exits scrub the range and the row table, so nothing
      // bleeds into later witnesses.
      //
      // Opens the R36.M1 four-marker block (Iris Xe display
      // substrate: KIND_DISPLAY_ENGINE + probe + power wells +
      // DP link PLL).
      //
      // Fingerprint: R36 KIND_DISPLAY_ENGINE OK
      // ============================================================
      display_engine_witness_call:
          call display_engine_witness

      // ============================================================
      // R36.M1-001 (#1235): Iris Xe display probe witness.
      // Body in tests/kernel/drivers/dpy/iris_xe_probe_synth.pdx.
      //
      // No cap slots — module owns a private stats array only.
      // Placement AFTER display_engine_witness_call is stylistic:
      // the probe recognises the hardware the capability names.
      //
      // Fingerprint: R36 IRIS XE PROBE OK
      // ============================================================
      iris_xe_probe_witness_call:
          call iris_xe_probe_witness

      // ============================================================
      // R36.M1-002 (#1236): display power-wells witness.
      // Body in tests/kernel/drivers/dpy/pwr_wells_synth.pdx.
      //
      // No cap slots — module owns a private well-state array,
      // CDCLK setpoint slot and stats. Both exits reset all three.
      //
      // Fingerprint: R36 PWR WELLS OK
      // ============================================================
      pwr_wells_witness_call:
          call pwr_wells_witness

      // ============================================================
      // R36.M1-003 (#1237): DP link-clock PLL witness.
      // Body in tests/kernel/drivers/dpy/dpclk_config_synth.pdx.
      //
      // No cap slots — module owns a private PLL-state array and
      // stats. Both exits reset both. Closes the R36.M1 four-marker
      // block.
      //
      // Fingerprint: R36 DPCLK CONFIG OK
      // ============================================================
      dpclk_config_witness_call:
          call dpclk_config_witness

      // ============================================================
      // R36.M2-003 (#1241): KIND_DISPLAY_OUTPUT capability witness.
      // Body in tests/kernel/cap/display_output_synth.pdx.
      //
      // Cap slots 264..279 — a fresh range past display_engine's
      // 256..263. Both exits scrub the range, the output row table
      // and the engine row table (since the witness mints an engine
      // for its NO_ENGINE / happy path stages).
      //
      // Opens the R36.M2 five-marker block (display-output substrate:
      // KIND_DISPLAY_OUTPUT + topology + EDID + topo channel + HPD).
      //
      // Fingerprint: R36 KIND_DISPLAY_OUTPUT OK
      // ============================================================
      display_output_witness_call:
          call display_output_witness

      // ============================================================
      // R36.M2-001 (#1239): display topology witness.
      // Body in tests/kernel/drivers/dpy/topology_synth.pdx.
      //
      // No cap slots — module owns a private path table + stats.
      // Both exits reset both.
      //
      // Fingerprint: R36 DPY TOPOLOGY OK
      // ============================================================
      dtopo_witness_call:
          call dtopo_witness

      // ============================================================
      // R36.M2-002 (#1240): EDID parser witness.
      // Body in tests/kernel/drivers/dpy/edid_synth.pdx.
      //
      // No cap slots — module owns a private scratch + parsed cache
      // + stats. Both exits reset all three.
      //
      // Fingerprint: R36 DPY EDID OK
      // ============================================================
      edid_witness_call:
          call edid_witness

      // ============================================================
      // R36.M2-004 (#1242): display_topology_channel schema witness.
      // Body in tests/kernel/ipc/display_topology_channel_synth.pdx.
      //
      // No cap slots, no .bss state — pure packer/unpacker discipline.
      //
      // Fingerprint: R36 DPY TOPO CHAN OK
      // ============================================================
      display_topology_channel_witness_call:
          call display_topology_channel_witness

      // ============================================================
      // R36.M2-005 (#1243): HPD ISR witness.
      // Body in tests/kernel/drivers/dpy/hpd_isr_synth.pdx.
      //
      // No cap slots — module owns per-DDI debounce state + bound
      // flag + stats. Both exits reset all three. Closes the R36.M2
      // five-marker block.
      //
      // Fingerprint: R36 DPY HPD OK
      // ============================================================
      hpd_isr_witness_call:
          call hpd_isr_witness

      // ============================================================
      // R36.M3-001 (#1244): KIND_MODESET_TXN capability witness.
      // Body in tests/kernel/cap/modeset_txn_synth.pdx.
      //
      // Cap slots 280..295. LINEAR discipline asserted:
      // R_MINT-in-rights trips LINEAR_REFUSED before tail_alloc, and
      // the initial-state pin (OPEN, mode_slot=0) checks the row
      // stamp survives the mint. Both exits scrub the row table and
      // clear the slots.
      //
      // Fingerprint: R36 KIND_MODESET_TXN OK
      // ============================================================
      modeset_txn_witness_call:
          call modeset_txn_witness

      // ============================================================
      // R36.M3-004 (#1247): KIND_DISPLAY_MODE capability witness.
      // Body in tests/kernel/cap/display_mode_synth.pdx.
      //
      // Cap slots 296..311. Asserts pclk / dim / refresh / flags
      // refusals, uniqueness on mode_key, and mint / revoke
      // round-trip. Both exits scrub the row table and clear the
      // slots.
      //
      // Fingerprint: R36 KIND_DISPLAY_MODE OK
      // ============================================================
      display_mode_witness_call:
          call display_mode_witness

      // ============================================================
      // R36.M3-002 (#1245): modeset_channel FSM witness.
      // Body in tests/kernel/ipc/modeset_channel_synth.pdx.
      //
      // PLACEMENT AFTER modeset_txn_witness_call IS REQUIRED: this
      // fixture mints a live KIND_MODESET_TXN through the shipping
      // path and walks the transition table against it, so the
      // txn's own witness has to have exercised its mint gate first
      // (any regression there is easier to localise when its own
      // marker precedes this one).
      //
      // Cap slots 312..319. Both exits scrub the row table and
      // clear the slots.
      //
      // Fingerprint: R36 MODESET CHAN OK
      // ============================================================
      modeset_channel_witness_call:
          call modeset_channel_witness

      // ============================================================
      // R36.M3-003 (#1246): atomic_commit driver witness.
      // Body in tests/kernel/drivers/dpy/atomic_commit_synth.pdx.
      //
      // No cap slots — module owns per-pipe staging state + stats.
      // Both exits reset both.
      //
      // Fingerprint: R36 ATOMIC COMMIT OK
      // ============================================================
      atomic_commit_witness_call:
          call atomic_commit_witness

      // ============================================================
      // R36.M3-005 (#1248): mode enumeration admission witness.
      // Body in tests/kernel/drivers/dpy/mode_enum_synth.pdx.
      //
      // No cap slots — module owns only counters. Both exits reset
      // them. Closes the R36.M3 five-marker block.
      //
      // Fingerprint: R36 MODE ENUM OK
      // ============================================================
      mode_enum_witness_call:
          call mode_enum_witness

      // ============================================================
      // R36.M4-001 (#1249): KIND_DISPLAY_PLANE capability witness.
      // Body in tests/kernel/cap/display_plane_synth.pdx.
      //
      // Cap slots 320..335 — a fresh range past every prior R36
      // witness's set (previous max: 312..319 modeset_channel).
      // Both exits scrub the range and the row table.
      //
      // Opens the R36.M4 four-marker block (display plane substrate:
      // KIND_DISPLAY_PLANE + primary + overlay + cursor).
      //
      // Fingerprint: R36 KIND_DISPLAY_PLANE OK
      // ============================================================
      display_plane_witness_call:
          call display_plane_witness

      // ============================================================
      // R36.M4-002 (#1250): plane_primary driver witness.
      // Body in tests/kernel/drivers/dpy/plane_primary_synth.pdx.
      //
      // Cap slots 336..351. Both exits scrub the range, the plane
      // row table AND the per-pipe primary state.
      //
      // PLACEMENT AFTER display_plane_witness_call IS REQUIRED: this
      // fixture mints live KIND_DISPLAY_PLANE rows through the
      // shipping path and asserts primary-role gates against them,
      // so the plane kind's own mint witness must have exercised its
      // mint gate first.
      //
      // Fingerprint: R36 PLANE PRIMARY OK
      // ============================================================
      plane_primary_witness_call:
          call plane_primary_witness

      // ============================================================
      // R36.M4-003 (#1251): plane_overlay driver witness.
      // Body in tests/kernel/drivers/dpy/plane_overlay_synth.pdx.
      //
      // Cap slots 352..367. Both exits scrub the range, the plane
      // row table AND the per-plane overlay state.
      //
      // Fingerprint: R36 PLANE OVERLAY OK
      // ============================================================
      plane_overlay_witness_call:
          call plane_overlay_witness

      // ============================================================
      // R36.M4-004 (#1252): plane_cursor driver witness.
      // Body in tests/kernel/drivers/dpy/plane_cursor_synth.pdx.
      //
      // Cap slots 368..383. Both exits scrub the range, the plane
      // row table AND the per-pipe cursor state. Closes the R36.M4
      // four-marker block.
      //
      // Fingerprint: R36 PLANE CURSOR OK
      // ============================================================
      plane_cursor_witness_call:
          call plane_cursor_witness

      // ============================================================
      // R30.M6-002 (#1076): the REAL pad-controller probe.
      //
      // Consumes _pci_devices, which pci_enumerate_all populated far
      // earlier in kernel_main_64. Records every class candidate with
      // its measured BAR0 extent and stops there: identification reads a
      // register, and that needs the window capability that only a
      // holder of memory authority can mint. The probe itself performs
      // no MMIO.
      //
      // PLACEMENT AFTER BOTH WITNESSES IS REQUIRED. Each resets
      // _lpss_gpio_ctrl on entry and on exit; probing first would have
      // their teardown erase the machine's real controller rows.
      //
      // It is invisible under QEMU -- an MCFG-absent boot leaves
      // _pci_device_count at zero, so the walk iterates zero times and
      // the fingerprint reports n=0. On the T14 G4 the PCH pad
      // controller is described by platform firmware rather than
      // enumerated on PCI, and that consumer is R30's userspace
      // supervisor; this path is the PCI half, and both converge on
      // lpss_gpio_record.
      //
      // Fingerprint: "LPSS GPIO PROBE n=<count>".
      // ============================================================
      lpss_gpio_probe_call:
          call lpss_gpio_probe


      pop rbp;
      ret
    }
  }
}
