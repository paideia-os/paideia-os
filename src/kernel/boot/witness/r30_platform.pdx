      // Fingerprint: R40 IPU6 PROBE OK
      // ============================================================
      ipu6_probe_witness_call:
          call ipu6_probe_witness

      // ============================================================
      // R40.M1-002 (#1348): IPU6 firmware DUAL-SIGNATURE verify
