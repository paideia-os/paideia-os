      // Body in tests/kernel/ipc/wifi_data_channel_synth.pdx.
      // Exercises the two verbs (TX_FRAME / RX_FRAME) and their
      // pack/unpack round-trips against the untyped byte-buffer
      // payload (KIND_NET_L2_FRAME is R40/R41 work; today the
      // payload is a {vif, buf_ref, buf_len} tuple).
      //
      // Fingerprint: R38 WIFI DATA CHAN OK
      // ============================================================
      wifi_data_channel_witness_call:
          call wifi_data_channel_witness

      // ============================================================
      // R38.M4-001 (#1304): net80211 class driver -- MANAGEMENT
      // FRAME encode/decode.  Opens R38.M4.
      //
      // Body in tests/kernel/drivers/wifi/net80211_mgmt_synth.pdx.
      // Exercises the frame-type validator, the 24-byte MAC-header
      // encoder for all five recognised subtypes (Beacon, ProbeReq,
      // ProbeResp, AssocReq, Deauth), the IE TLV append/walk/find
      // path (SSID + Rates + RSN), and the refuse-gates (BAD_TYPE,
      // NO_HDR before hdr_encode, IE_TRUNCATED via BAD_ARG,
      // FRAME_FULL when capped, IE_NOT_FOUND for missing type).
      //
      // PLACEMENT AFTER wifi_data_channel_witness_call IS DELIBERATE.
      // The three R38.M3 channel + kind witnesses build the wire
      // face for a ring-3 supervisor; this fixture builds the wire
      // face for the class driver itself.  A log in which
      // "R38 NET80211 MGMT OK" appears immediately after "R38 WIFI
      // DATA CHAN OK" is a log in which an operator can see that
      // both the DATA path (M3: schema over KIND_WIFI_VIF) and the
      // MGMT path (M4: 802.11 mgmt frames) reported at the same
      // boot.
      //
      // Fingerprint: R38 NET80211 MGMT OK
      // ============================================================
      nmg_witness_call:
          call nmg_witness

      // ============================================================
      // R38.M4-002 (#1305): net80211 -- ASSOCIATION state machine.
      //
      // Body in tests/kernel/drivers/wifi/net80211_assoc_synth.pdx.
      // Exercises UNAUTH -> AUTH -> ASSOC -> CONNECTED, roaming via
      // nas_reassoc, deauth from every state clearing BSSID, ASSOC
      // timeout falling back to AUTH, and every INVALID_TRANSITION
      // pair the table refuses.
      //
      // PLACEMENT AFTER nmg_witness_call IS REQUIRED, not stylistic.
      // The two modules share no writer -- nas_step never touches
      // _nmg_frame and nmg_hdr_encode never touches _nas_state --
      // but the dependency runs at the level of DESCRIPTION: this
      // state machine is what nmg_hdr_encode's staged frames drive.
      // Reading "R38 NET80211 ASSOC OK" immediately after the mgmt
      // marker is how an operator sees that the frame-format layer
      // and the transition layer both reported at the same boot.
      //
      // Fingerprint: R38 NET80211 ASSOC OK
      // ============================================================
      nas_witness_call:
          call nas_witness

      // ============================================================
      // R38.M4-003 (#1306): net80211 -- MLME + PMF (Protected
      // Management Frames, 802.11w).
      //
      // Body in tests/kernel/drivers/wifi/net80211_mlme_synth.pdx.
      // Exercises PMF mode setter + admit gate (DISABLED / CAPABLE
      // / REQUIRED), and the SA Query state machine (IDLE / PENDING
      // / TIMEOUT) end-to-end including MISMATCH, BUSY,
      // NOT_PENDING, TIMEOUT_STATE, ZERO_ID and ZERO_TICKS
      // refusals.
      //
      // PLACEMENT AFTER nas_witness_call IS DELIBERATE.  This
      // module's admit gate is what a REQUIRED-PMF station uses to
      // refuse an unprotected Deauth that would otherwise drive
      // net80211_assoc's nas_step(DEAUTH) to UNAUTH; the order in
      // the log reflects the composition order (assoc consults
      // MLME on receipt).
      //
      // Fingerprint: R38 NET80211 MLME OK
      // ============================================================
      nml_witness_call:
          call nml_witness

      // ============================================================
      // R38.M4-005 (#1308): net80211 -- REGULATORY-DOMAIN gating.
      //
      // Body in tests/kernel/drivers/wifi/net80211_regdom_synth.pdx.
      // Exercises: unbound refuses, direct bind (US/EU/JP),
      // UNKNOWN_REGDOM refused, bind_from_phy against an out-of-
      // range PHY row (UNKNOWN via caps-layer sentinel translated
      // internally so the API surfaces no foreign sentinel),
      // channel_allowed matrix per domain, tx_check + switch_check
      // refusals (NOT_BOUND / BAD_CHANNEL / CHANNEL_FORBIDDEN),
      // ALREADY_BOUND, double unbind, counter fanout.
      //
      // PLACEMENT AFTER nml_witness_call IS DELIBERATE.  The MLME
      // gate refuses unauthenticated mgmt; the regdom gate refuses
      // an OUT-OF-DOMAIN transmit.  Both are refuse-gates a live
      // tx path composes above tx_dma; the log order names the
      // policies in the order 802.11 asks a station to enforce them
      // (protection first, regulatory second).
      //
      // Fingerprint: R38 NET80211 REGDOM OK
      // ============================================================
      nrd_witness_call:
          call nrd_witness

      // ============================================================
      // R38.M5-001 (#1309): KIND_WIFI_KEY (SEALED) capability witness.
      //
      // Body in tests/kernel/cap/wifi_key_synth.pdx.  Opens the R38.M5
      // (WPA3 + key-management) cluster.  The kind derives over
      // KIND_MEMORY (slot 4) and is SEALED -- an application can hold
      // the cap without the material; only the R32 crypto server can
      // unseal.  The witness exercises the SEALED triple-check:
      // R_READ absent from R_WKEY_ALL, no op exposes material,
      // sealed_flag reads back as 1 on the live row.
      //
      // Fingerprint: R38 KIND_WIFI_KEY OK
      // ============================================================
      wifi_key_witness_call:
          call wifi_key_witness

      // ============================================================
      // R38.M5-002 (#1310): WPA3-SAE state-machine witness.
      //
      // Body in tests/kernel/drivers/wifi/wpa3_sae_synth.pdx.
      // Exercises INIT -> COMMITTED -> CONFIRMED -> ACCEPTED plus
      // the FAILED path when a peer's confirm value does not match
      // the KCK-derived expected value, and the BUSY refusal when
      // sae_start is called from a non-INIT state (caller must reset
      // first).  PLACEMENT AFTER wifi_key_witness_call IS DELIBERATE
      // -- SAE derives the PMK that R38.M5-003's 4-way handshake then
      // records into a KIND_WIFI_KEY.
      //
      // Fingerprint: R38 WPA3 SAE OK
      // ============================================================
      wpa3_sae_witness_call:
          call wpa3_sae_witness

      // ============================================================
      // R38.M5-003 (#1311): WPA 4-way handshake witness.
      //
      // Body in tests/kernel/drivers/wifi/wpa_4way_synth.pdx.
      // Exercises arm(pmk, ep) -> AWAIT_M1, m1_recv(anonce, snonce,
      // ptk) -> AWAIT_M3 (delegates PTK derive to the R32 crypto
      // endpoint slot), m3_recv(mic_ok, gtk) -> AWAIT_M4 (with the
      // mic_ok=0 -> FAILED path exercised), m4_sent -> DONE, and the
      // invalid-transition refusals.  PLACEMENT AFTER wpa3_sae_
      // witness_call IS DELIBERATE -- the 4-way handshake consumes
      // the PMK that SAE produced.
      //
      // Fingerprint: R38 WPA 4WAY OK
      // ============================================================
      wpa_4way_witness_call:
          call wpa_4way_witness

      // ============================================================
      // R38.M5-004 (#1312): KRACK-safe replay counter witness.
      //
      // Body in tests/kernel/drivers/wifi/replay_counter_synth.pdx.
      // Exercises the two central refuse-gates: install_guard REFUSES
      // a second install for a live key_id (RC_ALREADY -- the KRACK
      // bug), and recv_guard REFUSES any PN <= the last one seen
      // (RC_REPLAY).  PLACEMENT AFTER wpa_4way_witness_call IS
      // DELIBERATE -- the counter is what an install path composes
      // BEFORE handing a PTK/GTK to the crypto server; separating the
      // gate from the derivation is the KRACK-safe posture.
      //
      // Fingerprint: R38 REPLAY COUNTER OK
      // ============================================================
      replay_counter_witness_call:
          call replay_counter_witness

      // ============================================================
      // R38.M5-005 (#1313): wpa_supplicant_channel schema witness.
      //
      // Body in tests/kernel/ipc/wpa_supplicant_channel_synth.pdx.
      // Exercises the three RPC verb packers (DERIVE_PTK,
      // INSTALL_GTK, INSTALL_PTK) that a ring-3 wpa_supervisor uses
      // to talk to the R32 crypto server.  The RPC carries KIND_WIFI_
      // KEY SEALED slot references -- never raw material -- and this
      // witness asserts the pack/unpack symmetry plus the refuse
      // gates.  PLACEMENT AFTER replay_counter_witness_call IS
      // DELIBERATE: the channel is the WIRE face of every operation
      // the four preceding M5 witnesses exercised in isolation.
      //
      // Fingerprint: R38 WPA SUPP CHAN OK
      // ============================================================
      wpa_supplicant_channel_witness_call:
          call wpa_supplicant_channel_witness

      // ============================================================
      // R38.M6-001 (#1314): regulatory-domain loader witness.
      //
      // Body in tests/kernel/drivers/wifi/regdom_loader_synth.pdx.
      // Opens R38.M6 (regdomain resolution + geo-hint discovery).
      // The loader carries a country_code -> NRD_DOMAIN mapping and
      // publishes to net80211_regdom (R38.M4-005) via nrd_bind.
      //
      // PLACEMENT AFTER wpa_supplicant_channel_witness_call IS
      // DELIBERATE.  R38.M6 opens on the wire face the four
      // preceding M5 witnesses exercised in isolation; this is the
      // COMPOSITION LAYER that turns a discovered country code into
      // a bound regdom.  The witness resets both rdl_ state and
      // nrd_ state on entry and on exit so a live nrd_bind here
      // does not leak into a subsequent boot stage.
      //
      // Fingerprint: R38 REGDOM LOADER OK
      // ============================================================
      rdl_witness_call:
          call rdl_witness

      // ============================================================
      // R38.M6-002 (#1315): regdomain_channel schema witness.
      //
      // Body in tests/kernel/ipc/regdomain_channel_synth.pdx.
      // Exercises the periodic-hint packer with the three known
      // sources (EEPROM / GNSS / DEFAULT), the two structural
      // validators (source, cc), and the four refuse gates
      // (cc=0, source=0/4, ts=0, ts>=2^40).
      //
      // PLACEMENT AFTER rdl_witness_call IS DELIBERATE.  The
      // channel is the WIRE face of the two discovery paths (loader
      // + geo_hint) the composition drives.  Reading "R38 REGDOM
      // CHAN OK" between "R38 REGDOM LOADER OK" and "R38 GEO HINT
      // OK" is how an operator sees the wire between the two
      // discovery halves reported at the same boot.
      //
      // Fingerprint: R38 REGDOM CHAN OK
      // ============================================================
      regdomain_channel_witness_call:
          call regdomain_channel_witness

      // ============================================================
      // R38.M6-003 (#1316): geo-hint discovery witness.
      //
      // Body in tests/kernel/drivers/wifi/geo_hint_synth.pdx.
      // Exercises the two-tier discovery: R40 GNSS stub first, WW
      // fallback second.  gh_arbitrated() returns 0 until R40 wires
      // a real USB modem CDC-ACM / MBIM transport into
      // gh_query_gnss_stub -- the stub argument path exists only
      // for this witness to exercise the branch structure.
      //
      // PLACEMENT AFTER regdomain_channel_witness_call IS
      // DELIBERATE.  The wire is the composition boundary; the
      // discovery is what feeds it.  Reading "R38 GEO HINT OK"
      // after "R38 REGDOM CHAN OK" is how an operator sees that
      // both discovery-source halves (loader-EEPROM in #1314 and
      // GNSS/DEFAULT here) reported at the same boot.
      //
      // Fingerprint: R38 GEO HINT OK
      // ============================================================
      gh_witness_call:
          call gh_witness

      // ============================================================
      // R38.M7-001 (#1318): HE-MCS + MU-MIMO framework witness.
      //
      // Body in tests/kernel/drivers/wifi/he_mcs_synth.pdx.  Opens
      // R38.M7 (WiFi feature composition: HE MCS 0..11 rate table +
      // MU-MIMO group/user metadata rows).
      //
      // PLACEMENT AFTER gh_witness_call IS DELIBERATE.  R38.M7 opens
      // once the R38.M6 discovery/regulatory-domain wire has
      // reported.  HE MCS is the RATE ARITHMETIC the rest of the
      // R38.M7 cluster (rate control, roaming, rekey) composes
      // against.  The witness resets its own tables on entry and
      // exit so lookups here do not leak into subsequent stages.
      //
      // Fingerprint: R38 HE MCS OK
      // ============================================================
      hem_witness_call:
          call hem_witness

      // ============================================================
      // R38.M7-002 (#1319): PER-driven rate-control witness.
      //
      // Body in tests/kernel/drivers/wifi/rate_control_synth.pdx.
      // Exercises the per-peer PER window: 16 clean samples step
      // MCS up, 16 lossy samples step it down.  Both the up and
      // the down transitions are asserted so a boot in which one
      // ladder direction works and the other does not is
      // distinguishable in the log.
      //
      // PLACEMENT AFTER hem_witness_call IS DELIBERATE.  The two
      // modules split "how fast does (mcs, bw, gi, nss) run" (HE
      // MCS) from "which MCS should peer P run" (rate control); a
      // log in which "R38 RATE CONTROL OK" follows "R38 HE MCS OK"
      // is a log in which an operator sees both halves reported in
      // the same boot.
      //
      // Fingerprint: R38 RATE CONTROL OK
      // ============================================================
      rc2_witness_call:
          call rc2_witness

      // ============================================================
      // R38.M7-003 (#1320): scan-while-connected roaming witness.
      //
      // Body in tests/kernel/drivers/wifi/roaming_synth.pdx.
      // Exercises off-channel tick cadence, candidate scoring
      // (RSSI + speed - load), and the reassoc trigger against
      // net80211_assoc.  A weak candidate does NOT dislodge the
      // current AP (margin gate); a strong candidate DOES.
      //
      // PLACEMENT AFTER rc2_witness_call IS DELIBERATE.  Rate
      // control is a decision per fixed peer; roaming is a decision
      // between peers.  Reading "R38 ROAMING OK" after "R38 RATE
      // CONTROL OK" is how an operator sees both mobile-station
      // decision loops reported at the same boot.
      //
      // Fingerprint: R38 ROAMING OK
      // ============================================================
      rm_witness_call:
          call rm_witness

      // ============================================================
      // R38.M7-004 (#1321): PTK/GTK rekey witness.
      //
      // Body in tests/kernel/drivers/wifi/rekey_synth.pdx.  Drives
      // the rekey FSM from IDLE through TRIGGERED / ARMED /
      // ROTATING / DONE, composing wpa_4way through a full M1..M4
      // exchange.  Asserts that a rotated key install picks a
      // FRESH slot (KRACK-safe -- no re-installation of the old
      // slot) and that the old slot is retained BRIEFLY for
      // in-flight decrypt before rk_retire_old drops it.
      //
      // PLACEMENT AFTER rm_witness_call IS DELIBERATE.  The four
      // R38.M7 witnesses report in the order: rate table, rate
      // decision, roam decision, rekey rotation -- the order a
      // mobile station consumes them.  Rekey is last because it is
      // the deepest composition (rk + w4h + implicit KIND_WIFI_KEY
      // slot manager) and a failure here is easier to localise
      // when everything upstream of it has already reported.
      //
      // The witness resets both rk_ state and w4h_ state on entry
      // and on exit so a partially-driven handshake here does not
      // leak into a subsequent boot stage.
      //
      // Fingerprint: R38 REKEY OK
      // ============================================================
      rk_witness_call:
          call rk_witness

      // ============================================================
      // R39.M1-002 (#1324): KIND_BT_ADAPTER capability witness.
      //
      // Body in tests/kernel/cap/bt_adapter_synth.pdx.  Opens R39.M1
      // (Bluetooth HCI substrate over CNVi) in this witness tree --
      // a backfill for the R39.M3..M6 GATT / pairing / A2DP / HFP /
      // HID / LE Audio witnesses that already registered above.  The
      // kind derives over KIND_DEVICE and names one adapter's static
      // identity (adapter_key, device_slot, controller_vendor,
      // interface_num, FSM state, hci_version).  Refuses malformed
      // mint inputs across the failure taxonomy 0xFFFFF140..4F.
      //
      // PLACEMENT AFTER rk_witness_call IS DELIBERATE -- R38 closes
      // its WiFi / rekey substrate on the CNVi bus before R39 opens
      // its Bluetooth substrate on the same bus.
      //
      // Fingerprint: R39 KIND_BT_ADAPTER OK
      // ============================================================
      bt_adapter_witness_call:
          call bt_adapter_witness

      // ============================================================
      // R39.M1-003 (#1325): KIND_BT_HCI_CHANNEL capability witness.
      //
      // Body in tests/kernel/cap/bt_hci_channel_synth.pdx.  Opens
      // the HCI-channel capability layer above the R39.M1-002
      // KIND_BT_ADAPTER row.  The kind derives over
      // KIND_IPC_ENDPOINT and names one channel's identity (chan_key,
      // endpoint_slot, adapter_slot, direction, packet_type).
      // Refuses malformed mint inputs across the failure taxonomy
      // 0xFFFFF130..3F.  PLACEMENT AFTER bt_adapter_witness_call IS
      // DELIBERATE -- a channel binds an adapter, and reading the
      // channel witness after the adapter witness is how an operator
      // sees the two halves reported in the same boot.
      //
      // Fingerprint: R39 KIND_BT_HCI_CHANNEL OK
      // ============================================================
      bt_hci_chan_cap_witness_call:
          call bt_hci_chan_cap_witness

      // ============================================================
      // R39.M1-001 (#1323): HCI transport over CNVi witness.
      //
      // Body in tests/kernel/drivers/bt/hci_cnvi_synth.pdx.  Exercises
      // packet-type validator, CMD / EVT / ACL framing packer + unpack
      // symmetry, TX enqueue with free-running counter fullness
      // discipline, and RX slot write + dequeue.  Refuses malformed
      // packets across the failure taxonomy 0xFFFFF120..2F.  PLACEMENT
      // AFTER bt_hci_chan_cap_witness_call IS DELIBERATE -- the
      // capability names WHICH channel the transport moves bytes on,
      // and reading the transport witness after the channel witness
      // is how an operator sees the substrate reported in the layered
      // order it composes in.
      //
      // Fingerprint: R39 HCI CNVI OK
      // ============================================================
      hci_cnvi_witness_call:
          call hci_cnvi_witness

      // ============================================================
      // R39.M1-004 (#1326): bt_hci_channel schema witness.
      //
      // Body in tests/kernel/ipc/bt_hci_channel_synth.pdx.  Asserts
      // opcode OGF/OCF pack + unpack symmetry against the canonical
      // M1 corpus (RESET / READ_LOCAL_VERSION / LE_SET_SCAN_ENABLE),
      // and the session FSM open -> send_cmd -> recv_evt -> close
      // with the two illegal transitions refused.  Refuses malformed
      // sessions across the failure taxonomy 0xFFFFF110..1F.
      // PLACEMENT AFTER hci_cnvi_witness_call IS DELIBERATE -- the
      // schema is the SESSION TYPE for the RPCs the transport carries,
      // and reading the schema witness after the transport witness is
      // how an operator sees the wire and the session layer both
      // agree.
      //
      // Fingerprint: R39 BT HCI CHAN OK
      // ============================================================
      bt_hci_channel_witness_call:
          call bt_hci_channel_witness

      // ============================================================
      // R39.M2-003 (#1329): KIND_BT_L2CAP_CHANNEL capability witness.
      //
      // Body in tests/kernel/cap/bt_l2cap_channel_synth.pdx.  Opens the
      // L2CAP-channel capability layer above the R39.M1-003 KIND_BT_
      // HCI_CHANNEL row.  The kind derives over KIND_IPC_ENDPOINT and
      // names one channel's identity (chan_key, endpoint_slot,
      // hci_chan_slot, cid, psm, mtu, credits).  Refuses malformed
      // mint inputs across the failure taxonomy 0xFFFFF100..0F.
      // PLACEMENT AFTER bt_hci_channel_witness_call IS DELIBERATE --
      // an L2CAP channel rides an HCI transport channel, and reading
      // the L2CAP capability witness after the HCI schema witness is
      // how an operator sees the two layers reported in the same boot
      // in the order they compose.
      //
      // Fingerprint: R39 KIND_BT_L2CAP_CHANNEL OK
      // ============================================================
      bt_l2cap_chan_cap_witness_call:
          call bt_l2cap_chan_cap_witness

      // ============================================================
      // R39.M2-001 (#1327): L2CAP fixed-channel registration witness.
      //
      // Body in tests/kernel/drivers/bt/l2cap_fixed_synth.pdx.
      // Exercises the small registration table for the three fixed
      // CIDs (ATT 0x0004, LE signalling 0x0005, Security Manager
      // 0x0006 per BT §3.2), including register / lookup / hci_chan
      // / unregister round-trip and the ALREADY_REGISTERED, BAD_HANDLER,
      // BAD_CHAN_SLOT, UNKNOWN_CID, and RX_NO_HANDLER refuse paths.
      // Refuses malformed inputs across the failure taxonomy
      // 0xFFFFF0F0..FF.  PLACEMENT AFTER bt_l2cap_chan_cap_witness_call
      // IS DELIBERATE -- the capability names WHICH L2CAP channel a
      // subscriber holds; the fixed-channel driver is the registration
      // surface for the always-live CIDs above that capability.
      //
      // Fingerprint: R39 L2CAP FIXED OK
      // ============================================================
      l2cap_fixed_witness_call:
          call l2cap_fixed_witness

      // ============================================================
      // R39.M2-002 (#1328): L2CAP dynamic-channel + LE CBFC witness.
      //
      // Body in tests/kernel/drivers/bt/l2cap_dyn_synth.pdx.  Exercises
      // dynamic CID allocation from 0x0040+, CONNECT_REQ / CONNECT_RSP
      // and the FLOW_CONTROL_CREDIT_IND path per BT §3.4, including
      // the ENOSPC session-table refuse, BAD_STATE for out-of-phase
      // send, NO_CREDITS when balance hits zero, CREDIT_OVERFLOW past
      // u16, UNKNOWN_CID for every verb, BAD_RSP_CODE, and the
      // CONNECT_REFUSED refusal path advancing to CLOSED.  Refuses
      // malformed inputs across the failure taxonomy 0xFFFFF0E0..EF.
      // PLACEMENT AFTER l2cap_fixed_witness_call IS DELIBERATE -- the
      // fixed-CID surface is always live; the dynamic-CID surface is
      // negotiated on top, and reading the two in that order is how
      // an operator sees the always-live and negotiated halves report
      // side by side.
      //
      // Fingerprint: R39 L2CAP DYN OK
      // ============================================================
      l2cap_dyn_witness_call:
          call l2cap_dyn_witness

      // ============================================================
      // R39.M2-004 (#1330): bt_l2cap_channel schema witness.
      //
      // Body in tests/kernel/ipc/bt_l2cap_channel_synth.pdx.  Asserts
      // verb-validator, session FSM connect -> send -> recv ->
      // disconnect with the three illegal transitions refused
      // (double-disconnect, send-after-disconnect, recv-after-
      // disconnect), and every parameter-validation refuse
      // (BAD_ARG on chan_slot=0, BAD_PSM on psm=0, BAD_MTU on
      // mtu<23, BAD_LEN on len==0 or len>mtu).  Refuses malformed
      // sessions across the failure taxonomy 0xFFFFF0D0..DF.
      // PLACEMENT AFTER l2cap_dyn_witness_call IS DELIBERATE -- the
      // schema is the SESSION TYPE for the RPCs the dynamic-channel
      // surface carries, and reading the schema witness after the
      // dynamic-channel witness is how an operator sees the wire and
      // the session layer both agree.
      //
      // Fingerprint: R39 BT L2CAP CHAN OK
      // ============================================================
      bt_l2cap_channel_witness_call:
          call bt_l2cap_channel_witness

      // ============================================================
      // R39.M3-001 (#1331): ATT (Attribute Protocol) codec + server
      // dispatch witness.
      //
      // Body in tests/kernel/drivers/bt/att_synth.pdx.  Exercises
      // the ATT PDU codec for the opcodes gatt.pdx does NOT already
      // handle (Error Response 0x01, Exchange MTU Req/Rsp 0x02/0x03,
      // Find Info Req/Rsp 0x04/0x05, Write Response 0x13), the MTU
      // negotiation gate (default 23 -> BAD_MTU below the LE
      // minimum, clamp above 517), and the SERVER-SIDE DISPATCHER
      // that reads an inbound opcode, delegates read/write to the
      // R39.M3-002 gatt.pdx attribute database, and packs the
      // matching response (Read Rsp / Write Rsp / Error Rsp with
      // INVALID_HANDLE / READ_NOT_PERM / WRITE_NOT_PERM /
      // REQ_NOT_SUPP).  Refuses malformed inputs across the failure
      // taxonomy 0xFFFFF0C0..CF.  PLACEMENT BETWEEN
      // bt_l2cap_channel_witness_call AND bt_gatt_conn_witness_call
      // IS DELIBERATE -- ATT sits atop L2CAP fixed CID 0x0004 and
      // BELOW every GATT surface, and reading "R39 ATT OK" between
      // the L2CAP-schema witness and the GATT-connection kind
      // witness is how an operator sees the wire protocol carrying
      // GATT reported before the GATT connection kind itself.
      //
      // Fingerprint: R39 ATT OK
      // ============================================================
      att_witness_call:
          call att_witness

      // ============================================================
      // R39.M3-003 (#1333): KIND_BT_GATT_CONNECTION capability witness.
      //
      // Body in tests/kernel/cap/bt_gatt_connection_synth.pdx.  Opens
      // R39 (Bluetooth over CNVi) in this witness tree.  The kind
      // derives over KIND_IPC_ENDPOINT and names ONE GATT session
      // over an L2CAP fixed channel with ONE remote BD_ADDR at ONE
      // negotiated ATT MTU plus an FSM (disconnected / connecting /
      // connected / encrypted) and a security_level ordinal.
      //
      // Fingerprint: R39 KIND_BT_GATT_CONNECTION OK
      // ============================================================
      bt_gatt_conn_witness_call:
          call bt_gatt_conn_witness

      // ============================================================
      // R39.M3-002 (#1332): GATT server + client + ATT PDU codec.
      //
      // Body in tests/kernel/drivers/bt/gatt_synth.pdx.  Exercises
      // attribute-table insert / remove / read / write under the
      // permission gate, ATT PDU pack/unpack symmetry for the four
      // supported opcodes (Read Req 0x0A, Read Rsp 0x0B, Write Req
      // 0x12, Notify 0x1B, Indicate 0x1D), and the discovery walker
      // (begin -> step -> end) lifecycle.  PLACEMENT AFTER
      // bt_gatt_conn_witness_call IS DELIBERATE -- the GATT protocol
      // is what a KIND_BT_GATT_CONNECTION carries; reading "R39 GATT
      // OK" after "R39 KIND_BT_GATT_CONNECTION OK" is how an operator
      // sees both halves reported in the same boot.
      //
      // Fingerprint: R39 GATT OK
      // ============================================================
      gatt_witness_call:
          call gatt_witness

      // ============================================================
      // R39.M3-004 (#1334): bt_gatt_channel schema witness.
      //
      // Body in tests/kernel/ipc/bt_gatt_channel_synth.pdx.  Asserts
      // pack + unpack symmetry for the four RPC verbs (read_char,
      // write_char, subscribe, notify), and the reserved-field /
      // out-of-range refusals.  PLACEMENT AFTER gatt_witness_call IS
      // DELIBERATE -- the channel schema is the WIRE for the GATT
      // protocol above.
      //
      // Fingerprint: R39 BT GATT CHAN OK
      // ============================================================
      bt_gatt_channel_witness_call:
          call bt_gatt_channel_witness

      // ============================================================
      // R39.M4-002 (#1336): KIND_BT_PAIRING capability witness.
      //
      // Body in tests/kernel/cap/bt_pairing_synth.pdx.  Opens R39.M4
      // (LE Secure Connections pairing) in this witness tree.  The
      // kind derives over KIND_MEMORY and names ONE LE SC pairing
      // record (pair_key, memory_slot, peer BD_ADDR, ltk_algo,
      // bond_flag, sealed_flag=1).  SEALED: no op exposes LTK
      // material.  PLACEMENT AFTER bt_gatt_channel_witness_call IS
      // DELIBERATE -- pairing is what a KIND_BT_GATT_CONNECTION
      // needs before it can encrypt.
      //
      // Fingerprint: R39 KIND_BT_PAIRING OK
      // ============================================================
      bt_pairing_witness_call:
          call bt_pairing_witness

      // ============================================================
      // R39.M4-001 (#1335): LE SC pairing driver witness.
      //
      // Body in tests/kernel/drivers/bt/le_sc_synth.pdx.  Drives the
      // pairing FSM through IDLE -> PAIRING_INIT -> ECDH_EXCHANGE
      // -> LTK_DERIVED -> DONE, asserts AuthReq validator rejects
      // reserved bits, asserts (0,0) peer point-at-infinity refused,
      // asserts backward FSM edges refused.  PLACEMENT AFTER
      // bt_pairing_witness_call IS DELIBERATE -- the SEALED cap is
      // the AUTHORITY the pairing driver hands out.
      //
      // Fingerprint: R39 LE SC PAIRING OK
      // ============================================================
      le_sc_witness_call:
          call le_sc_witness

      // ============================================================
      // R39.M4-003 (#1337): bt_pairing_channel schema witness.
      //
      // Body in tests/kernel/ipc/bt_pairing_channel_synth.pdx.
      // Asserts the three-verb schema (begin_pairing, confirm_passkey,
      // complete), the STUB consent broker returns 1, the passkey
      // range check refuses > 999999, and repeated complete returns
      // ALREADY_COMPLETE.  PLACEMENT AFTER le_sc_witness_call IS
      // DELIBERATE -- the channel is the RPC surface for the FSM.
      //
      // Fingerprint: R39 BT PAIRING CHAN OK
      // ============================================================
      bt_pairing_channel_witness_call:
          call bt_pairing_channel_witness

      // ============================================================
      // R39.M5-001 (#1339): A2DP profile (SBC/AAC codec) witness.
      //
