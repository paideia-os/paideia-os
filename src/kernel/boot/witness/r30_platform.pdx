      //   R33 SOF EFFECTS OK     <- #1164
      //
      // Four rather than one because the four issues can fail for
      // unrelated reasons (a wrong dual-sig composition, a broken
      // stage machine, a wrong tuple decoder, a wrong pipeline
      // gate) and a golden asserting an ordered subsequence needs
      // the four failures distinguishable in the log.
      //
      // Like every other marker on this path, THEY ASSERT NOTHING
      // ABOUT A REAL FIRMWARE UPLOAD, A REAL ADSP HANDSHAKE, A REAL
      // TOPOLOGY DISPATCH, OR A REAL ML-DSA-65 SIGNATURE
      // VERIFICATION. The four arbitrated() pins stay at 0 and the
      // boot witnesses assert that; when a future milestone plumbs
      // real ADSP MMIO / real IPC / real lattice crypto, those pins
      // flip and the arbitration assertions here must be rewritten
      // in the same commit.
      // ============================================================
      sof_verify_witness_call:
          call sof_verify_witness

