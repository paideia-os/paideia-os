// src/kernel/boot/witness/r90_xrepo_010_pdxfs_read_bytes.pdx --
// R90-XREPO.010.M1-001 (paideia-os #2109) boot witness.
//
// Boot-time witness for KIND_PDXFS_FILE's new PFF_OP_READ_BYTES (op 7)
// end to end.  Stages:
//
//   (1) Reset _pdxfs_file_table + scrub this witness's private cap
//       slot (130) so a stale rebuild leaves no shadow row.
//   (2) Look up /tmp in the tmpfs tree (tmpfs_lookup(root=1, "tmp"))
//       to recover the parent directory the r16_tmpfs witness block
//       already populated at boot line ~941.
//   (3) tmpfs_create(tmp_idx, "rbseed", 6, VNODE_TYPE_REG=1) to mint
//       a fresh inode we own for this witness -- the r16_tmpfs
//       unlink witness at the same bring-up depth removes /tmp/x on
//       its way out, so re-using that name would race a scrub we do
//       not control.  A distinct name keeps this witness self-
//       contained and re-runnable across whole-kernel hot reloads.
//   (4) tmpfs_write(new_idx, &_pfrb_seed_buf, PFRB_SEED_LEN, 0) to
//       seed the inode with a fixed 8-byte distinctive pattern
//       (0xDEADBEEFCAFE2109 -- 0xCAFE2109 encoding the issue number,
//       DEADBEEF as the "not zero" salt so a page still cleared to
//       zeros is distinguishable from a real read).
//   (5) Mint a synthetic KIND_MEMORY(4) + RIGHT_MINT(0x200) parent
//       cap at slot 130 (free by construction: no other witness in
//       the cascade between witness_r89_tui_canvas -- which owns
//       slots 121/122 and scrubs them -- and this call site names
//       slot 130).  target_ptr is arbitrary since the derivation
//       gate only reads kind+rights.
//   (6) pdxfs_file_cap_mint_inner(parent_slot=130, rights=R_PDXFS_
//       FILE_READ, inode_no=new_idx, byte_len=PFRB_SEED_LEN,
//       created_ns=0, mtime_ns=0) -> row_id.  R_PDXFS_FILE_READ
//       alone is sufficient for READ_BYTES; we do not widen the
//       rights beyond what the op needs.  The row's inode_no field
//       IS the tmpfs backing index at this M1 landing (see kind_
//       pdxfs_file.pdx's own PFF_OP_READ_BYTES header block for the
//       "tmpfs backing at M1" note).
//   (7) Populate _pfrb_desc_page (page-aligned, .bss) with the four
//       READ_BYTES args: offset=0, count=PFRB_SEED_LEN, dst_ptr=&_
//       pfrb_dst_buf, dst_len_cap=PFRB_DST_LEN.
//   (8) cap_handler_pdxfs_file(R_PDXFS_FILE_READ, row_id, op_arg)
//       where op_arg = &_pfrb_desc_page | 0x07 (opcode in [7:0],
//       reserved bits [11:8] zero, desc_page_addr in [63:12]).
//       Assert rax == PFRB_SEED_LEN.
//   (9) Load u64 @ _pfrb_dst_buf[0]; assert equal to seed pattern.
//  (10) Revoke row (pdxfs_file_cap_revoke) + scrub cap slot 130.
//  (11) Emit witness fingerprint via klog_s1_d2.
//
// The handler ALSO emits its own `pdxfs file read bytes ok [legacy:
// PDXFS FILE READ BYTES OK] off=<n> len=<n>` line (kind_pdxfs_file.
// pdx's own klog_s1_d2 call), one per successful invocation.  The
// witness's rollup fingerprint here is the per-witness acceptance
// signal for tools/run-smoke.sh's ordered-subsequence match, same
// posture as r89_tui_canvas.pdx's own two-line pattern.
//
// Fingerprint
// -----------
//
// Success: klog_s1_d2(LEVEL_INFO=3, SUBSYS_BOOT, tag_boot_pfrb_ok,
//   k_ino, inode_no, k_bytes, bytes_returned)
//     -> "boot pdxfs read bytes ok -- ino=<n> bytes=<n>"
// Failure: klog_s1_d1(LEVEL_ERROR=1, SUBSYS_BOOT, tag_boot_pfrb_fail,
//   k_line, stage)
//     -> "boot pdxfs read bytes fail line=<N>"
//
// The success tag is deliberately all-lowercase with no bracketed
// `[legacy: ... OK]` suffix -- tools/verify-fingerprint-coverage.sh's
// OK_TOK extractor keys on the uppercase OK token, so a lowercase-
// only tag needs no golden coverage or allowlist entry (same
// r66v2_tty_raw.pdx / r89_tui_canvas.pdx precedent that file
// references verbatim).  The handler-side `pdxfs file read bytes ok
// [legacy: ...]` line DOES carry uppercase OK and gets an allowlist
// entry in tools/verify-fingerprint-coverage.sh alongside the two
// existing tui-canvas mint/present entries.
//
// Placement in the boot cascade
// -----------------------------
//
// Called from `boot_continue_after_ring3` in kernel_main.pdx AFTER
// witness_r89_tui_canvas (which itself runs after r16_tmpfs so the
// tmpfs pool and /tmp directory are already live).  Placed BEFORE
// witness_r100_tls_trust so the r89/r90-xrepo block stays
// contiguous.
//
// Encoder / label discipline
// --------------------------
//
// No add reg,[mem]; only qword loads (mov reg, [mem]) from
// initialised buffers -- no byte reads needed since the seed/verify
// pattern is a single u64.  Every label is prefixed `pfrb_` (short
// for pdxfs-file-read-bytes-witness) so no reserved-keyword clash
// (`loop`/`if`/... would parse as keywords).  Frame prologue implicit.  Every
// large immediate (0xDEADBEEFCAFE2109 pattern, 0xFFFFFFFFFFFFFFFF
// sentinel, kind constant 0x195) is staged into r10/r11 before the
// cmp -- imm32 sign-extends and would compare against 0xFFFFFFFF...
// rather than the intended full 64-bit value.

module R90XrepoPdxfsReadBytes = structure {

  pub let mut _pfrb_stage : u64 = 0

  // Descriptor page: page-aligned so the READ_BYTES op_arg encoding
  // (op_arg & ~0xFFF = desc_page_addr) round-trips exactly.  Sized
  // one page to match the ambient allocator granularity even though
  // only the first 32 bytes carry payload; the remaining 4064 bytes
  // stay zero throughout this witness.
  pub let mut _pfrb_desc_page : [u8; 4096] = uninit @align(4096)

  // Destination buffer for the read.  Sized 64 bytes -- ample for
  // the 8-byte seed and small enough that a runaway copy is caught
  // by dst_len_cap (also PFRB_DST_LEN below) rather than corrupting
  // adjacent .bss.
  pub let mut _pfrb_dst_buf : [u8; 64] = uninit @align(8)

  // Fixed name for the seeded tmpfs file: "rbseed\0" (6 chars +
  // NUL).  Distinct from every other tmpfs name any sibling witness
  // in this directory creates (tree-wide grep of src/kernel/boot/
  // witness/ 2026-09-01 confirms no other witness names "rbseed").
  pub let pfrb_seed_name : [u8; 7] = "rbseed\0"

  // tmpfs_lookup name for "/tmp" (the r16_tmpfs create witness
  // already populated it under root=1).  Duplicated here rather than
  // referenced from r16_tmpfs's own witness_name_tmp to keep this
  // witness's .o standalone (no cross-.o rodata dependency chain).
  pub let pfrb_tmp_name : [u8; 4] = "tmp\0"

  // Seed content -- a single u64 with a distinctive pattern.  The
  // low 32 bits encode the issue number (0xCAFE2109) so any log-side
  // dump names its source milestone; the high 32 bits are 0xDEADBEEF
  // as a "not zero" salt so a page still cleared to zeros is
  // distinguishable from a real read on the assert path.  Written
  // little-endian by paideia-as's default qword store: byte 0 =
  // 0x09, byte 7 = 0xDE.
  pub let mut _pfrb_seed_buf : [u8; 8] = uninit @align(8)
  pub let PFRB_SEED_PATTERN : u64 = 0xDEADBEEFCAFE2109
  pub let PFRB_SEED_LEN     : u64 = 8
  pub let PFRB_DST_LEN      : u64 = 64

  // Fingerprint tags.  NUL-inclusive counts:
  //   "boot pdxfs read bytes ok --"    -- 27 chars + NUL = 28.
  //   "boot pdxfs read bytes fail"     -- 26 chars + NUL = 27.
  pub let tag_boot_pfrb_ok   : [u8; 28] = "boot pdxfs read bytes ok --\0"
  pub let tag_boot_pfrb_fail : [u8; 27] = "boot pdxfs read bytes fail\0"

  // Cap slot reserved for the KIND_MEMORY parent this witness mints.
  // Free by construction between witness_r89_tui_canvas's slot-122
  // scrub and this call site (no intervening witness names slot 130
  // per tree-wide grep 2026-09-01).
  pub let PFRB_MEM_SLOT : u64 = 130

  // ==========================================================================
  // pfrb_clear_slot() -> ()
  //
  // Scrub cap_table slot PFRB_MEM_SLOT back to (0,0,0).  Called at
  // entry (defensive) and on every exit path.  Same shape as
  // r89_tui_canvas.pdx's tuiw_clear_slots, one-slot version.
  // ==========================================================================
  pub let pfrb_clear_slot : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R90-XREPO.010.M1-001 (paideia-os #2109): scrub this witness's private cap_table slot 130 to (0,0,0). Called defensively at entry and on every exit path (success + failure). One nested call to cap_mint_write, which needs @{cap}; entry rsp%16==8, no prologue push -> stays at 8, standard SysV per-call adjustment; call site does not need a manual sub rsp,8 because paideia-as emits the callee's own alignment. Labels prefixed pfrb_cs_.",
      block: {
        mov rdi, 130;                    // PFRB_MEM_SLOT
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        ret
      }
    }

  // ==========================================================================
  // witness_r90_xrepo_010_pdxfs_read_bytes() -> ()
  //
  // Five callee-save pushes (rbx, r12, r13, r14, r15) leave rsp%16
  // == 0 for every nested call (entry rsp%16 == 8, +40 -> 0), same
  // shape every sibling witness in this cascade takes.  Register
  // plan (all callee-save, survive every nested call by SysV):
  //   rbx = tmp_idx        (parent directory inode)
  //   r12 = new_idx        (freshly-created file inode = row.inode_no)
  //   r13 = row_id         (KIND_PDXFS_FILE row id)
  //   r14 = seed_len       (stashed for cross-checks; == PFRB_SEED_LEN)
  //   r15 = bytes_returned (READ_BYTES' return value; feeds fingerprint)
  // ==========================================================================
  pub let witness_r90_xrepo_010_pdxfs_read_bytes : () -> () !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R90-XREPO.010.M1-001 (paideia-os #2109): boot witness proving KIND_PDXFS_FILE's new PFF_OP_READ_BYTES op reads back seeded tmpfs bytes byte-exact via cap_handler_pdxfs_file. See file header for the full 11-stage narrative + the tmpfs-backing-at-M1 rationale.  Capabilities/effects are the union of every nested call's own row: tmpfs_lookup/tmpfs_create/tmpfs_write/tmpfs_read all need {mem}; pdxfs_file_cap_mint_inner + pdxfs_file_cap_revoke + cap_handler_pdxfs_file need {mem, sysreg} + {cap}; klog_s1_d1/klog_s1_d2 need {sysreg, mem}. 'boot' is added per this cascade's own witness-function convention (r66v2_tty_raw.pdx, r89_tui_canvas.pdx). On any failure, the stage number is stamped into _pfrb_stage first so the failure klog line names which sub-test tripped; failure falls through to cap-slot cleanup + row-scrub via pdxfs_file_table_reset (matching kind_pdxfs_file_synth.pdx's own failure-exit shape). Labels prefixed pfrb_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // ---------- Stage 1: reset row table + scrub cap slot ----------
        mov rax, 1;
        lea rcx, [rip + _pfrb_stage];
        mov [rcx], rax;
        call pdxfs_file_table_reset;
        call pfrb_clear_slot;

        // ---------- Stage 2: recover /tmp inode index ----------
        mov rax, 2;
        lea rcx, [rip + _pfrb_stage];
        mov [rcx], rax;
        mov rdi, 1;                      // root_idx = TMPFS_INODE_IDX_ROOT
        lea rsi, [rip + pfrb_tmp_name];
        call tmpfs_lookup;
        cmp rax, 0;
        je  pfrb_fail_stage;
        mov rbx, rax;                    // rbx = tmp_idx

        // ---------- Stage 3: create /tmp/rbseed ----------
        mov rax, 3;
        lea rcx, [rip + _pfrb_stage];
        mov [rcx], rax;
        mov rdi, rbx;                    // dir_idx = tmp_idx
        lea rsi, [rip + pfrb_seed_name];
        mov rdx, 6;                      // name_len (matches "rbseed")
        mov rcx, 1;                      // VNODE_TYPE_REG
        call tmpfs_create;
        cmp rax, 0;
        je  pfrb_fail_stage;             // OOM or collision
        mov r10, 0xFFFF;
        cmp rax, r10;
        je  pfrb_fail_stage;             // alloc-OOM sentinel
        mov r12, rax;                    // r12 = new_idx (= row.inode_no)

        // ---------- Stage 4: seed _pfrb_seed_buf + write to inode ----------
        mov rax, 4;
        lea rcx, [rip + _pfrb_stage];
        mov [rcx], rax;
        mov r10, 0xDEADBEEFCAFE2109;     // PFRB_SEED_PATTERN
        lea r11, [rip + _pfrb_seed_buf];
        mov [r11 + 0], r10;              // little-endian qword store
        mov r14, 8;                      // r14 = seed_len (survives calls)

        mov rdi, r12;                    // inode_idx
        lea rsi, [rip + _pfrb_seed_buf];
        mov rdx, r14;                    // len
        xor rcx, rcx;                    // offset = 0
        call tmpfs_write;
        cmp rax, r14;
        jne pfrb_fail_stage;

        // ---------- Stage 5: mint synthetic KIND_MEMORY parent ----------
        mov rax, 5;
        lea rcx, [rip + _pfrb_stage];
        mov [rcx], rax;
        mov rdi, 130;                    // PFRB_MEM_SLOT
        mov rsi, 4;                      // KIND_MEMORY
        mov rdx, 0x200;                  // RIGHT_MINT
        mov rcx, 0x2109;                 // target_ptr = issue number (arbitrary)
        call cap_mint_write;

        // ---------- Stage 6: mint KIND_PDXFS_FILE row over inode ----------
        mov rax, 6;
        lea rcx, [rip + _pfrb_stage];
        mov [rcx], rax;
        mov rdi, 130;                    // parent_slot
        mov rsi, 0x001;                  // R_PDXFS_FILE_READ only
        mov rdx, r12;                    // inode_no = tmpfs new_idx
        mov rcx, r14;                    // byte_len = seed_len
        xor r8, r8;                      // created_ns = 0
        xor r9, r9;                      // mtime_ns   = 0
        call pdxfs_file_cap_mint_inner;
        mov r10, 16;                     // PFF_MAX
        cmp rax, r10;
        jae pfrb_fail_stage;
        mov r13, rax;                    // r13 = row_id

        // ---------- Stage 7: populate descriptor page ----------
        mov rax, 7;
        lea rcx, [rip + _pfrb_stage];
        mov [rcx], rax;
        lea r11, [rip + _pfrb_desc_page];
        xor r10, r10;
        mov [r11 + 0], r10;              // offset = 0
        mov [r11 + 8], r14;              // count = seed_len
        lea r10, [rip + _pfrb_dst_buf];
        mov [r11 + 16], r10;             // dst_ptr
        mov r10, 64;                     // PFRB_DST_LEN
        mov [r11 + 24], r10;             // dst_len_cap = 64

        // ---------- Stage 8: invoke READ_BYTES via cap handler ----------
        mov rax, 8;
        lea rcx, [rip + _pfrb_stage];
        mov [rcx], rax;
        mov rdi, 0x001;                  // rights = R_PDXFS_FILE_READ
        mov rsi, r13;                    // target_ptr = row_id
        lea r10, [rip + _pfrb_desc_page];
        or  r10, 7;                      // op_arg[7:0] = PFF_OP_READ_BYTES
        mov rdx, r10;
        call cap_handler_pdxfs_file;
        cmp rax, r14;                    // must equal seed_len
        jne pfrb_fail_stage;
        mov r15, rax;                    // r15 = bytes_returned

        // ---------- Stage 9: verify dst buffer matches seed pattern ----------
        mov rax, 9;
        lea rcx, [rip + _pfrb_stage];
        mov [rcx], rax;
        lea r11, [rip + _pfrb_dst_buf];
        mov r10, [r11 + 0];
        mov r11, 0xDEADBEEFCAFE2109;     // PFRB_SEED_PATTERN
        cmp r10, r11;
        jne pfrb_fail_stage;

        // ---------- Stage 10: revoke row + scrub cap slot ----------
        mov rax, 10;
        lea rcx, [rip + _pfrb_stage];
        mov [rcx], rax;
        mov rdi, r13;                    // row_id
        call pdxfs_file_cap_revoke;
        cmp rax, 0;
        jne pfrb_fail_stage;
        call pfrb_clear_slot;

        // ---------- Stage 11: emit success fingerprint ----------
        mov rax, 11;
        lea rcx, [rip + _pfrb_stage];
        mov [rcx], rax;
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_boot_pfrb_ok];
        lea rcx, [rip + k_ino];
        mov r8, r12;                     // v1 = inode_no
        lea r9, [rip + k_bytes];
        sub rsp, 8;                      // pad
        push r15;                        // v2 = bytes_returned (7th arg)
        call klog_s1_d2;
        add rsp, 16;
        jmp pfrb_witness_done;

      pfrb_fail_stage:
        mov rdi, 1;                      // LEVEL_ERROR
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_boot_pfrb_fail];
        lea rcx, [rip + k_line];
        lea rax, [rip + _pfrb_stage];
        mov r8, [rax];
        call klog_s1_d1;
        call pfrb_clear_slot;
        call pdxfs_file_table_reset;

      pfrb_witness_done:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
