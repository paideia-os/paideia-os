// src/kernel/boot/witness/r123_cmd_registry.pdx -- R123.M2 (paideia-os #2504)
//
// Boot-time witness for the R123.M2 command-registry LRU cache. The
// R123.M2 substrate (src/kernel/core/shell/cmd_registry.pdx) lands
// the 256-entry LRU cache + on-disk load pipeline (vfs_open ->
// vfs_read -> cr_parse_toml). This witness exercises the IN-MEMORY
// path directly: it seeds three synthetic entries via
// cmd_registry_insert, verifies cmd_registry_lookup returns the
// stashed cap_handle for a seeded name and CR_MISS for a name that
// was never seeded, and emits the acceptance fingerprint:
//
//   `cmd registry loaded system=3 user=0`
//
// via klog_s1_x2 (SUBSYS_CAP_, tag_cmd_registry_loaded_ok).
//
// The on-disk load path (cmd_registry_load) is exercised too, but
// only as a compile-and-run smoke: the CoW FS is empty at first
// boot so both calls return 0. The fingerprint's `system=3`
// reflects the seed count, not the load count (per parent briefing:
// "seed 3 commands directly in-memory (skip the TOML file for the
// witness -- invoke cmd_registry_insert 3 times with names 'find',
// 'where', 'sort' and dummy functor_ids)").
//
// =============================================================================
// PREREQUISITES THIS FILE MINTS (all torn down on every exit)
// =============================================================================
//
// Three LRU cache entries via cmd_registry_insert. No cap_table
// slots consumed at M2 (R123.M3 owns the cap_table install for the
// KIND_CMD_MODULE handles); the insert API takes an opaque cap_
// handle placeholder. No teardown: the cache entries stay live for
// the remainder of the boot (subsequent shell code can inspect
// them; they are overwritten on next insert if the cache fills).
//
// =============================================================================
// FINGERPRINT
// =============================================================================
//
// Substrate fingerprint (emitted from THIS witness at stage 4,
// once every seed / lookup / miss check has passed):
//   `cmd registry loaded system=3 user=0`
//   via klog_s1_x2 (SUBSYS_CAP_, tag_cmd_registry_loaded_ok).
//
// Failure: `boot cmd registry fail line=<n>` (klog_s1_d1) with the
// stage stamped into _r123cr_stage before every step. No boot_
// bail_or_continue call; failure falls through to return, matching
// the R123.M1 sibling.
//
// =============================================================================
// ENCODER DISCIPLINE
// =============================================================================
//
// No `test rN, rN`; every zero-check uses `cmp reg, 0`. No `add reg,
// [mem]`, no `cmp reg, [mem]`. Every store to _r123cr_stage is a
// qword `mov [mem], reg`. Every label prefixed `r123cr_` (reserved-
// word discipline).

module R123CmdRegistry = structure {

  pub let mut _r123cr_stage : u64 = 0

  // Failure funnel: "boot cmd registry fail" = 22 chars + NUL = 23.
  pub let r123cr_fail_msg : [u8; 23] = "boot cmd registry fail\0"

  // Three synthetic command names, NUL-terminated. Each length
  // counted below.
  pub let r123cr_name_find  : [u8; 5] = "find\0"
  pub let r123cr_name_where : [u8; 6] = "where\0"
  pub let r123cr_name_sort  : [u8; 5] = "sort\0"

  // A name that MUST NOT match any seeded entry (used for the
  // miss-path assertion). "unknown" = 7 chars + NUL = 8.
  pub let r123cr_name_unknown : [u8; 8] = "unknown\0"

  // Placeholder cap_handles. Any nonzero u32 works; using 0x11 /
  // 0x22 / 0x33 makes the seed order easy to eyeball in a memory
  // dump. R123.M3 wires the real cap_table install; at M2 these
  // are opaque tokens for the cache round-trip.
  pub let R123CR_CAP_FIND  : u64 = 0x11
  pub let R123CR_CAP_WHERE : u64 = 0x22
  pub let R123CR_CAP_SORT  : u64 = 0x33

  // Seeded count -- emitted as `system=<n>` in the acceptance
  // fingerprint. `user=0` is a literal 0 (no user-override seeded
  // at M2).
  pub let R123CR_SEED_COUNT : u64 = 3

  // ==========================================================================
  // witness_r123_cmd_registry() -> ()
  //
  // Five callee-save pushes (rbx, r12-r15) leave rsp%16 == 0 at
  // every nested call (entry rsp%16 == 8, -40 -> %16 == 0). Every
  // nested call site is 16-byte aligned; klog_s1_x2's caller-push
  // idiom (sub rsp,8; push v2; call klog_s1_x2; add rsp,16) also
  // keeps alignment.
  //
  // Stages recorded in _r123cr_stage before each step so a failure
  // fingerprint carries a distinguishing line number:
  //   1  = cmd_registry_load(system_root) returned non-zero (unexpected
  //        at M2 boot -- file must be absent)
  //   2  = cmd_registry_load(user_root) returned non-zero (same)
  //   10 = insert("find")  returned an unexpected code
  //   11 = insert("where") returned an unexpected code
  //   12 = insert("sort")  returned an unexpected code
  //   20 = lookup("find")  returned != R123CR_CAP_FIND
  //   21 = lookup("where") returned != R123CR_CAP_WHERE
  //   22 = lookup("sort")  returned != R123CR_CAP_SORT
  //   30 = lookup("unknown") returned != CR_MISS (0)
  // ==========================================================================
  pub let witness_r123_cmd_registry : () -> () !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R123.M2 (paideia-os #2504): boot witness for the command-registry LRU cache. Sequence: (1) cmd_registry_load(system_root, 7) -> expect 0 (file absent); (2) cmd_registry_load(user_root, 6) -> expect 0; (3) seed three entries via cmd_registry_insert('find'/1, 'where'/1, 'sort'/1) -- each returns CR_INSERT_OK on a freshly-scrubbed cache; (4) verify cmd_registry_lookup('find') -> R123CR_CAP_FIND (0x11), cmd_registry_lookup('where') -> R123CR_CAP_WHERE (0x22), cmd_registry_lookup('sort') -> R123CR_CAP_SORT (0x33), cmd_registry_lookup('unknown') -> 0 (CR_MISS). On success emit `cmd registry loaded system=3 user=0` via klog_s1_x2 (SUBSYS_CAP_, tag_cmd_registry_loaded_ok, k_system=3, k_user=0). Failure funnel emits `boot cmd registry fail line=<stage>` via klog_s1_d1 (LEVEL_INFO, matching sibling witnesses so the boot smoke does not pull a panic on golden diff). Five callee-save pushes (rbx=scratch, r12/r13/r14/r15=stash across nested calls) leave rsp%16==0 at every nested call (entry rsp%16==8, +40 -> %16==0). klog_s1_x2 caller-push (sub rsp,8; push v2; call; add rsp,16) keeps alignment. Labels prefixed r123cr_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // ------------------------------------------------------------
        // Stage 1: cmd_registry_load(system_root).
        // Expect 0 (file absent at M2 boot).
        // ------------------------------------------------------------
        mov rax, 1;
        mov [rip + _r123cr_stage], rax;

        lea rdi, [rip + cr_system_root];
        mov rsi, 7;                      // CR_SYSTEM_ROOT_LEN
        call cmd_registry_load;
        cmp rax, 0;
        jne r123cr_fail;

        // ------------------------------------------------------------
        // Stage 2: cmd_registry_load(user_root).
        // ------------------------------------------------------------
        mov rax, 2;
        mov [rip + _r123cr_stage], rax;

        lea rdi, [rip + cr_user_root];
        mov rsi, 6;                      // CR_USER_ROOT_LEN
        call cmd_registry_load;
        cmp rax, 0;
        jne r123cr_fail;

        // ------------------------------------------------------------
        // Stage 10: seed "find" -> R123CR_CAP_FIND (0x11).
        // insert(cap_handle=0x11, name_ptr=&r123cr_name_find, len=4)
        // expects CR_INSERT_OK (0).
        // ------------------------------------------------------------
        mov rax, 10;
        mov [rip + _r123cr_stage], rax;

        mov rdi, 0x11;                   // R123CR_CAP_FIND
        lea rsi, [rip + r123cr_name_find];
        mov rdx, 4;
        call cmd_registry_insert;
        cmp rax, 0;                      // CR_INSERT_OK
        jne r123cr_fail;

        // ------------------------------------------------------------
        // Stage 11: seed "where" -> R123CR_CAP_WHERE (0x22).
        // ------------------------------------------------------------
        mov rax, 11;
        mov [rip + _r123cr_stage], rax;

        mov rdi, 0x22;                   // R123CR_CAP_WHERE
        lea rsi, [rip + r123cr_name_where];
        mov rdx, 5;
        call cmd_registry_insert;
        cmp rax, 0;
        jne r123cr_fail;

        // ------------------------------------------------------------
        // Stage 12: seed "sort" -> R123CR_CAP_SORT (0x33).
        // ------------------------------------------------------------
        mov rax, 12;
        mov [rip + _r123cr_stage], rax;

        mov rdi, 0x33;                   // R123CR_CAP_SORT
        lea rsi, [rip + r123cr_name_sort];
        mov rdx, 4;
        call cmd_registry_insert;
        cmp rax, 0;
        jne r123cr_fail;

        // ------------------------------------------------------------
        // Stage 20: lookup "find" -> R123CR_CAP_FIND (0x11).
        // ------------------------------------------------------------
        mov rax, 20;
        mov [rip + _r123cr_stage], rax;

        lea rdi, [rip + r123cr_name_find];
        mov rsi, 4;
        call cmd_registry_lookup;
        cmp rax, 0x11;
        jne r123cr_fail;

        // ------------------------------------------------------------
        // Stage 21: lookup "where" -> R123CR_CAP_WHERE (0x22).
        // ------------------------------------------------------------
        mov rax, 21;
        mov [rip + _r123cr_stage], rax;

        lea rdi, [rip + r123cr_name_where];
        mov rsi, 5;
        call cmd_registry_lookup;
        cmp rax, 0x22;
        jne r123cr_fail;

        // ------------------------------------------------------------
        // Stage 22: lookup "sort" -> R123CR_CAP_SORT (0x33).
        // ------------------------------------------------------------
        mov rax, 22;
        mov [rip + _r123cr_stage], rax;

        lea rdi, [rip + r123cr_name_sort];
        mov rsi, 4;
        call cmd_registry_lookup;
        cmp rax, 0x33;
        jne r123cr_fail;

        // ------------------------------------------------------------
        // Stage 30: lookup "unknown" -> CR_MISS (0).
        // ------------------------------------------------------------
        mov rax, 30;
        mov [rip + _r123cr_stage], rax;

        lea rdi, [rip + r123cr_name_unknown];
        mov rsi, 7;
        call cmd_registry_lookup;
        cmp rax, 0;
        jne r123cr_fail;

        // ------------------------------------------------------------
        // Emit the acceptance fingerprint:
        //   `cmd registry loaded system=3 user=0`
        // via klog_s1_x2 (SUBSYS_CAP_, tag_cmd_registry_loaded_ok,
        // k_system=3, k_user=0).
        //
        // klog_s1_x2 idiom: sub rsp,8; push v2; call; add rsp,16.
        // ------------------------------------------------------------
        sub rsp, 8;
        mov rax, 0;                      // v2 = user count = 0
        push rax;
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + tag_cmd_registry_loaded_ok];
        lea rcx, [rip + k_system];
        mov r8,  3;                      // v1 = system count = 3
        lea r9,  [rip + k_user];
        call klog_s1_x2;
        add rsp, 16;

        jmp r123cr_out;

      // ============================================================
      // Failure funnel.
      // ============================================================
      r123cr_fail:
        // Emit `boot cmd registry fail line=<stage>` via klog_s1_d1.
        mov rax, [rip + _r123cr_stage];
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + r123cr_fail_msg];
        lea rcx, [rip + k_line];
        mov r8,  rax;                    // v = stage
        call klog_s1_d1;

      r123cr_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
