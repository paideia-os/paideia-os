// src/kernel/boot/witness/r90_tty_termios.pdx -- R90-XREPO.004 (#1998)
//
// Boot-time witness for the KIND_TTY termios/ioctl-equivalent control
// surface: mints a KIND_TTY sink, exercises TTY_OP_SET_ECHO_ON /
// SET_ECHO_OFF, TTY_OP_SET_VMIN, TTY_OP_SET_VTIME, TTY_OP_GET_ATTR --
// verifying via tty_row_mode that each op stores exactly the packed bit
// field claimed in kind_tty.pdx Section 1 -- then flips SET_RAW,
// enqueues a single byte 'K' into the raw UART RX ring and drains it
// via TTY_OP_READ (proving a non-canonical single-keypress read
// without waiting for '\n', which is the fingerprint the issue's
// motivating consumers -- doc pager and shell line editor -- require),
// restores SET_ECHO_ON / SET_COOKED, and revokes the row.
//
// Distinct from R66v2.POS-002 (#1987, witness_r66v2_tty_raw): that
// witness proves the RAW-mode ring-drain baseline (SET_RAW + three
// TTY_OP_READ calls returning ring bytes byte-exact + TTY_READ_EMPTY
// on drain); THIS witness proves the ATTR-set/GET_ATTR round trip
// (echo, VMIN, VTIME) that is meaningless without #1987 having proved
// the baseline read path first, and adds a distinct single-keypress
// fingerprint the issue text calls out ("toggle raw mode and read a
// single keypress without waiting for newline").
//
// Placement: called from kernel_main.pdx's boot_continue_after_ring3
// cascade immediately after witness_r66v2_tty_raw. That witness
// explicitly leaves the raw UART RX ring drained on its documented
// success exit (Sub-test 8 confirms head==tail before restoring
// COOKED); this witness therefore starts with a known-empty ring, and
// enqueues its own single byte in Stage 8 below.
//
// Cap slot 121 -- one above the slot R66v2 witness owns (120), so that
// even if some future edit to r66v2 changes its scrub-on-exit posture
// this witness stays independent. Slot 121 is untouched by any prior
// witness in the boot cascade (verified by grep of every witness
// file's cap_mint_write calls); the witness scrubs it back to (0,0,0)
// on both success and failure exits.
//
// Fingerprint: "boot tty termios ok -- attr=0x<hex>" (klog_s1_x1, key
// k_attr module-scoped below). Deliberately all-lowercase with no
// bracketed "[legacy: ... OK]" suffix -- same posture as
// tag_boot_tty_raw_ok (r66v2_tty_raw.pdx) and tag_tsc_narrative
// (core/time/tsc.pdx): tools/verify-fingerprint-coverage.sh's OK_TOK
// extractor requires a whole-word uppercase 'OK', so a lowercase-only
// tag needs neither a golden line nor an allowlist entry. The `attr=`
// suffix carries the packed mode_flags word so a future perturbation
// (e.g. an SET_VMIN encoder that silently mis-shifts) would produce a
// wrong hex and be caught by any mode that pins the exact line.

module R90TtyTermios = structure {

  pub let mut _r90tt_stage : u64 = 0

  pub let tag_boot_tty_termios_ok : [u8; 23] = "boot tty termios ok --\0"
  pub let r90tt_fail_msg          : [u8; 22] = "boot tty termios fail\0"
  pub let r90tt_k_attr            : [u8; 5]  = "attr\0"

  // Mint a synthetic KIND_IPC_ENDPOINT parent at the given cap slot.
  // Same shape as r66v2_tty_raw.pdx's ttyr_ep: the tty derivation gate
  // (tty_check_parent_endpoint) only checks kind, so any nonzero
  // rights / target_ptr on the parent is fine. rdi (slot) is untouched
  // by the rsi/rdx/rcx setup below, so it still holds the caller's
  // argument when cap_mint_write is called.
  pub let r90tt_ep : (u64) -> () !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R90-XREPO.004 (#1998): mint a synthetic KIND_IPC_ENDPOINT parent for the tty mint gate. R_IPC_ALL (0x00B) rights; target_ptr = 0x1998 (issue number, arbitrary nonzero id). Same shape as r66v2_tty_raw.pdx's ttyr_ep. rdi (slot) is never overwritten by the rsi/rdx/rcx setup, so it survives untouched into the tail call. Labels prefixed r90tt_e_.",
      block: {
        mov rsi, 5;                      // KIND_IPC_ENDPOINT
        mov rdx, 0x00B;                  // R_IPC_ALL
        mov rcx, 0x1998;                 // target_ptr = endpoint_id
        call cap_mint_write;
        ret
      }
    }

  // Scrub cap slot 121 back to (0,0,0).
  pub let r90tt_clear_slot : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R90-XREPO.004 (#1998): scrub cap_table slot 121 (this witness's private parent-endpoint slot) back to (0,0,0). Called at entry (defensive) and on every exit. Labels prefixed r90tt_c_.",
      block: {
        mov rdi, 121;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        ret
      }
    }

  // witness_r90_tty_termios() -> ()
  //
  // Boot witness. Five callee-save pushes leave rsp%16 == 0 for every
  // nested call (entry rsp%16 == 8, the standard post-`call` parity
  // every sibling witness in the boot_continue_after_ring3 cascade
  // observes).
  //
  // Sub-tests (each stamps _r90tt_stage before any op that could fail
  // so a klog-on-failure carries the stage number):
  //
  //   Stage  1 -- reset (scrub slot 121; mint synthetic parent).
  //   Stage  2 -- tty_cap_mint_inner (R_TTY_ALL rights, 24x80 sink).
  //   Stage  3 -- SET_ECHO_ON: bit 1 of mode_flags == 2.
  //   Stage  4 -- SET_ECHO_OFF: bit 1 clear.
  //   Stage  5 -- SET_VMIN with value 5: bits 8..15 == 5.
  //   Stage  6 -- SET_VTIME with value 20: bits 16..23 == 20.
  //   Stage  7 -- GET_ATTR: returns the packed mode_flags word;
  //               cross-checks against tty_row_mode's value and against
  //               the individually-set bits (bit 1 clear, VMIN=5,
  //               VTIME=20). Captures the attr word in r15 for the
  //               success-line emission at the end.
  //   Stage  8 -- SET_RAW: bit 0 == 1.
  //   Stage  9 -- Push one byte ('K' = 0x4B) into the raw UART RX ring
  //               and read it back via TTY_OP_READ. The read must
  //               return the byte immediately with no wait for a
  //               newline -- this is the "single keypress raw-mode
  //               read" fingerprint the issue text calls out (distinct
  //               from #1987's three-byte drain baseline).
  //   Stage 10 -- SET_ECHO_ON + SET_COOKED restore.
  //   Stage 11 -- Revoke row.
  //
  // The `attr` value emitted on success is the mode_flags word after
  // Stages 5+6 landed (raw bit not yet set, echo cleared, VMIN=5,
  // VTIME=20). Expected packed value: 0x140500 -- i.e.
  //   bits 16..23 = 0x14 (VTIME = 20)
  //   bits  8..15 = 0x05 (VMIN  =  5)
  //   bits  0..7  = 0x00 (raw=0, echo=0)
  pub let witness_r90_tty_termios : () -> () !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R90-XREPO.004 (#1998): boot witness proving the KIND_TTY termios/ioctl-equivalent control surface -- SET_ECHO_ON/OFF, SET_VMIN, SET_VTIME, GET_ATTR -- plus a single-keypress raw-mode read that returns immediately without waiting for a newline (the fingerprint the issue's motivating consumers, doc pager and shell line editor, require). Distinct from #1987 (witness_r66v2_tty_raw), which proved the three-byte ring-drain baseline. Exercises kind_tty.pdx's public surface only; mints its own KIND_TTY row via tty_cap_mint_inner and drives every op through cap_handler_tty directly (bypassing cap_table/cap_invoke for the TTY cap itself), mirroring the r66v2_tty_raw.pdx witness shape. Five callee-save pushes (rbx, r12-r15) leave rsp%16 == 0 for every nested call. r12 = row_id; r13 unused (kept for pushed alignment); r14 unused; r15 = captured attr word (for the emit at end). On any failure, stage number is stamped into _r90tt_stage first so the failure klog line carries which sub-test tripped. Labels prefixed r90tt_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // ---------- Stage 1: reset ----------
        mov rax, 1;
        lea rcx, [rip + _r90tt_stage];
        mov [rcx], rax;
        call r90tt_clear_slot;
        mov rdi, 121;
        call r90tt_ep;

        // ---------- Stage 2: mint KIND_TTY row, R_TTY_ALL rights ----------
        mov rax, 2;
        lea rcx, [rip + _r90tt_stage];
        mov [rcx], rax;
        mov rdi, 121;                    // parent_slot
        mov rsi, 0x69A;                  // R_TTY_ALL
        mov rdx, 1998;                   // tty_id (issue number, nonzero)
        mov rcx, 24;                     // rows
        mov r8,  80;                     // cols
        call tty_cap_mint_inner;
        mov r10, 16;
        cmp rax, r10;
        jae r90tt_fail_stage;
        mov r12, rax;                    // r12 = row_id, survives to end

        // ---------- Stage 3: SET_ECHO_ON, verify bit 1 == 1 ----------
        mov rax, 3;
        lea rcx, [rip + _r90tt_stage];
        mov [rcx], rax;
        mov rdi, 0x69A;                  // rights = R_TTY_ALL
        mov rsi, r12;                    // target_ptr = row_id
        mov rdx, 9;                      // TTY_OP_SET_ECHO_ON
        call cap_handler_tty;
        cmp rax, 0;
        jne r90tt_fail_stage;
        mov rdi, r12;
        call tty_row_mode;
        mov r11, rax;
        and r11, 2;                      // bit 1
        cmp r11, 2;
        jne r90tt_fail_stage;

        // ---------- Stage 4: SET_ECHO_OFF, verify bit 1 == 0 ----------
        mov rax, 4;
        lea rcx, [rip + _r90tt_stage];
        mov [rcx], rax;
        mov rdi, 0x69A;
        mov rsi, r12;
        mov rdx, 10;                     // TTY_OP_SET_ECHO_OFF
        call cap_handler_tty;
        cmp rax, 0;
        jne r90tt_fail_stage;
        mov rdi, r12;
        call tty_row_mode;
        mov r11, rax;
        and r11, 2;
        cmp r11, 0;
        jne r90tt_fail_stage;

        // ---------- Stage 5: SET_VMIN=5, verify bits 8..15 == 5 ----------
        mov rax, 5;
        lea rcx, [rip + _r90tt_stage];
        mov [rcx], rax;
        mov rdi, 0x69A;
        mov rsi, r12;
        // op_arg: byte value 5 in bits 8..15, op 12 in bits 0..7
        //   (5 << 8) | 12 = 0x050C
        mov rdx, 0x050C;
        call cap_handler_tty;
        cmp rax, 0;
        jne r90tt_fail_stage;
        mov rdi, r12;
        call tty_row_mode;
        mov r11, rax;
        shr r11, 8;
        and r11, 0xFF;                   // extract VMIN byte
        cmp r11, 5;
        jne r90tt_fail_stage;

        // ---------- Stage 6: SET_VTIME=20, verify bits 16..23 == 20 ----------
        mov rax, 6;
        lea rcx, [rip + _r90tt_stage];
        mov [rcx], rax;
        mov rdi, 0x69A;
        mov rsi, r12;
        // op_arg: byte value 20 (0x14) in bits 8..15, op 13 in bits 0..7
        //   (20 << 8) | 13 = 0x140D
        mov rdx, 0x140D;
        call cap_handler_tty;
        cmp rax, 0;
        jne r90tt_fail_stage;
        mov rdi, r12;
        call tty_row_mode;
        mov r11, rax;
        shr r11, 16;
        and r11, 0xFF;                   // extract VTIME byte
        cmp r11, 20;
        jne r90tt_fail_stage;

        // ---------- Stage 7: GET_ATTR, cross-check against tty_row_mode ----------
        mov rax, 7;
        lea rcx, [rip + _r90tt_stage];
        mov [rcx], rax;
        mov rdi, 0x69A;
        mov rsi, r12;
        mov rdx, 11;                     // TTY_OP_GET_ATTR
        call cap_handler_tty;
        mov r15, rax;                    // capture attr for the emit line
        mov rdi, r12;
        call tty_row_mode;
        cmp rax, r15;                    // GET_ATTR must equal tty_row_mode
        jne r90tt_fail_stage;
        // Cross-check individual fields on the returned word:
        //   bit 1     == 0 (echo off after Stage 4)
        //   bits 8..15 == 5  (VMIN)
        //   bits 16..23 == 20 (VTIME)
        mov r11, r15;
        and r11, 2;
        cmp r11, 0;
        jne r90tt_fail_stage;
        mov r11, r15;
        shr r11, 8;
        and r11, 0xFF;
        cmp r11, 5;
        jne r90tt_fail_stage;
        mov r11, r15;
        shr r11, 16;
        and r11, 0xFF;
        cmp r11, 20;
        jne r90tt_fail_stage;

        // ---------- Stage 8: SET_RAW, verify bit 0 == 1 ----------
        mov rax, 8;
        lea rcx, [rip + _r90tt_stage];
        mov [rcx], rax;
        mov rdi, 0x69A;
        mov rsi, r12;
        mov rdx, 7;                      // TTY_OP_SET_RAW
        call cap_handler_tty;
        cmp rax, 0;
        jne r90tt_fail_stage;
        mov rdi, r12;
        call tty_row_mode;
        mov r11, rax;
        and r11, 1;
        cmp r11, 1;
        jne r90tt_fail_stage;

        // ---------- Stage 9: single-keypress raw-mode read ----------
        // Push one byte 'K' (0x4B) into the raw UART RX ring; TTY_OP_
        // READ must return it immediately, with no wait for a newline
        // and no line-buffered accumulation. This is the exact
        // fingerprint the issue text calls out: "toggle raw mode and
        // read a single keypress without waiting for newline".
        //
        // Precondition: witness_r66v2_tty_raw (the immediately-prior
        // slot in kernel_main.pdx's cascade) drains the ring on its
        // documented success exit (Sub-test 8 asserts TTY_READ_EMPTY
        // on the 4th read before restoring COOKED). The ring is
        // therefore empty here by construction.
        mov rax, 9;
        lea rcx, [rip + _r90tt_stage];
        mov [rcx], rax;
        mov rdi, 0x4B;                   // 'K'
        call uart_rx_enqueue;
        cmp rax, 0;
        jne r90tt_fail_stage;
        mov rdi, 0x69A;
        mov rsi, r12;
        mov rdx, 6;                      // TTY_OP_READ
        call cap_handler_tty;
        cmp rax, 0x4B;                   // must be 'K', not TTY_READ_EMPTY
        jne r90tt_fail_stage;

        // ---------- Stage 10: SET_ECHO_ON + SET_COOKED restore ----------
        mov rax, 10;
        lea rcx, [rip + _r90tt_stage];
        mov [rcx], rax;
        mov rdi, 0x69A;
        mov rsi, r12;
        mov rdx, 9;                      // TTY_OP_SET_ECHO_ON
        call cap_handler_tty;
        cmp rax, 0;
        jne r90tt_fail_stage;
        mov rdi, 0x69A;
        mov rsi, r12;
        mov rdx, 8;                      // TTY_OP_SET_COOKED
        call cap_handler_tty;
        cmp rax, 0;
        jne r90tt_fail_stage;

        // ---------- All green: emit "boot tty termios ok -- attr=0x<hex>" ----------
        // r15 holds the mode_flags snapshot captured at Stage 7
        // (before SET_RAW and before Stage 10 restored ECHO_ON), so
        // it reads as 0x140500 (VTIME=0x14, VMIN=0x05, echo=0,
        // raw=0). A future perturbation that mis-shifts SET_VMIN or
        // SET_VTIME would produce a wrong hex here.
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_boot_tty_termios_ok];
        lea rcx, [rip + r90tt_k_attr];
        mov r8, r15;
        call klog_s1_x1;

        // ---------- Stage 11: revoke + teardown ----------
        mov rax, 11;
        lea rcx, [rip + _r90tt_stage];
        mov [rcx], rax;
        mov rdi, r12;
        call tty_cap_revoke;
        cmp rax, 0;
        jne r90tt_fail_stage;

        call r90tt_clear_slot;
        jmp r90tt_witness_done;

      r90tt_fail_stage:
        mov rdi, 1;                      // LEVEL_ERROR
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + r90tt_fail_msg];
        lea rcx, [rip + k_line];
        lea rax, [rip + _r90tt_stage];
        mov r8, [rax];
        call klog_s1_d1;
        call r90tt_clear_slot;

      r90tt_witness_done:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
