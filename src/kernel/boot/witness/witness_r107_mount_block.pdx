// src/kernel/boot/witness/witness_r107_mount_block.pdx -- R107.M1 (#2345)
//
// Boot-time smoke for the sys_mount block-arm resolver landed at
// core/syscall/sys_mount.pdx R107.M1.  Proves the arm is no longer a
// two-instruction stub (returning SYS_MOUNT_UNIMPL_PDXFS_BLOCK
// 0xFFFFED63) by driving two calls that both traverse the new
// dev_path parser + volume-registry gate + cap-slot allocator + folded
// diagnostic band.  The witness makes NO assumption about NVMe live
// state -- it runs in every boot mode (substrate + LIVE) with the same
// deterministic outcome, so a single unconditional fingerprint suffices
// for the coverage gate.
//
// -----------------------------------------------------------------------------
// Two-call contract
// -----------------------------------------------------------------------------
//
// (1) MALFORMED dev_path.  A 12-byte scratch that DOES NOT begin with
//     "/dev/pdxvol" (this witness uses the ASCII bytes
//     "XYZ//badpath").  sys_mount_body's prefix compare must reject
//     it in step (b) with SYS_MOUNT_ENODEV (0xFFFFED66).  Distinct
//     from SYS_MOUNT_EINVAL_DEV_LEN because the length gate passes
//     (12 bytes), so a bug that skipped the prefix compare would
//     surface as either "call reached mount_pdxfs_block anyway"
//     (rax < 8 or 0xFFFFED64) or "returned an old stub sentinel"
//     (0xFFFFED63) -- both distinct from the expected 0xFFFFED66.
//
// (2) WELL-FORMED dev_path referencing a row that no probe has
//     registered.  The witness uses "/dev/pdxvolf" (row_id 15).
//     VOL_MAX is 16 and every real probe (probe.pdx / probe_all_
//     bdevs, mount_bootstrap) registers row 0 first, so row 15 is
//     guaranteed empty in every default boot mode -- the witness
//     never has to reason about what a prior witness might have
//     left in the registry.  sys_mount_body's volume_tail_valid
//     check must return SYS_MOUNT_ENODEV in step (d).  Distinct
//     from case (1) because the prefix + length + hex-digit parse
//     all pass; a bug in volume_tail_valid's live-check surfaces
//     here specifically as `case (2) mismatch`, isolating the
//     diagnostic to the runtime gate rather than the syntactic
//     shape.
//
// Both cases MUST return 0xFFFFED66 (SYS_MOUNT_ENODEV).  On both
// passing, the witness emits its single fingerprint line:
//
//     R107 SYS MOUNT BLOCK RESOLVER OK
//
// A single fingerprint (not per-case) is the minimum the coverage
// gate needs (tools/verify-fingerprint-coverage.sh + a golden entry
// in tests/r17/shell-shutdown.golden) and matches the existing
// pattern (`ALLOC WITNESS OK` / `INODE TABLE WITNESS OK` /
// `PDXFS BOOT MOUNT SUBSTRATE OK` -- one closer line per witness
// even when the body checks several invariants).
//
// -----------------------------------------------------------------------------
// Why no mount_pdxfs_block call in this witness
// -----------------------------------------------------------------------------
//
// pdxfs_boot_mount_smoke.pdx (#1722) ALREADY covers mount_pdxfs_block
// end-to-end in both LIVE and SUBSTRATE modes, minting a synth NVMe
// cap chain (172..175) and driving the full mount + sb_read + inode_
// read chain.  Re-running that chain here would duplicate the earlier
// witness's coverage without proving anything the pbms_ witness does
// not already prove -- the ONLY new surface at R107.M1 is the sys_
// mount block-arm shim itself (dev_path parse + cap-slot allocation +
// mount_pdxfs_block dispatch).  Testing the shim through its own
// error surface (both diagnostic paths for SYS_MOUNT_ENODEV) exercises
// every net-new instruction in the arm without seeding runtime state
// that other witnesses would trip over.
//
// The LIVE-arm proof (a real /dev/pdxvol<H> mount reaching a mount_
// slot in [0..8) and a subsequent read succeeding) is the job of the
// R107.M2/M5 witnesses (devfs backend + file-bdev variants), per the
// R107 milestone plan in design/roadmap/persistent-home-wave.md §R107.
// R107.M1's contract is narrow: replace the stub with a resolver that
// COULD reach mount_pdxfs_block if a live volume were present; the
// deferred-to-M2 devfs shim is what turns "could" into "does" for the
// user-facing /dev/nvme0 style path.
//
// -----------------------------------------------------------------------------
// Register plan + alignment
// -----------------------------------------------------------------------------
//
// Entry rsp%16 == 8 (invoked from r30_platform.pdx's boot_continue_
// after_ring3 body via `call witness_r107_mount_block_run`, itself
// running at %16==0 after r30_platform's own `push rbp`).  Single-
// argument callees only (sys_mount_body takes 5 args in the SysV arg
// regs -- rdi/rsi/rdx/rcx/r8 -- and returns u64 in rax); no varargs,
// no stack-passed args.
//
// Callee-save usage:
//   rbx = pass_count (0, 1, or 2 by the end of the witness)
//
// One-push prologue (rbx) + `sub rsp, 8` pad lands rsp%16 == 0 at the
// sys_mount_body / klog_s1 call sites (entry %16 == 8, push -> %16 ==
// 0, sub 8 -> %16 == 8; wait, no -- entry %16 == 8, push -> %16 == 0
// which IS the pre-call requirement for SysV).  So NO pad needed;
// the single push alone lands the correct alignment.  Symmetric pop
// on every return path.
//
// -----------------------------------------------------------------------------
// Label discipline
// -----------------------------------------------------------------------------
//
// All local labels prefixed `wr107mb_` per reserved-label discipline
// (`if`, `loop`, `match`, `for` are compiler keywords -- see feedback_
// paideia_as_reserved_labels.md; a bare `check_case2` would be fine
// but the wr107mb_ prefix keeps the witness's label namespace grouped
// alongside its symbol namespace and matches every other witness's
// prefix convention).  grep audit (2026-09-06): no `wr107mb_` hits
// anywhere else in src/kernel/.

module WitnessR107MountBlock = structure {

  // ==========================================================================
  // Fingerprint bytes.
  //
  // "R107 SYS MOUNT BLOCK RESOLVER OK\n\0" = 32 payload + \n + \0 = 34 bytes.  Output-strip-
  // clean per design/policy/output-provenance-strip.md (round tag R107
  // is retained because the marker names the milestone landing point,
  // matching r54_/r55_/r56_ witnesses' identical pattern; the raw
  // issue number 2345 is NOT in the string).  Length count includes
  // the trailing "\n\0" pair.
  // ==========================================================================

  pub let wr107mb_ok_msg : [u8; 34] = "R107 SYS MOUNT BLOCK RESOLVER OK\n\0"

  // ==========================================================================
  // Fixed scratches for the two sys_mount_body dev_path arguments AND
  // the mount_point argument the body's audit-emit hash loop reads
  // (rd path only when the block arm hits smb_success -- both of this
  // witness's calls take the ENODEV early-exit path, so mount_point is
  // never actually walked by the body; it is passed anyway to keep the
  // call shape identical to a real caller so the length gate for
  // mount_point runs and the outer 5-push register load is exercised).
  //
  // A single 12-byte kernel-VA scratch per case avoids the KPTI shim
  // (we call sys_mount_body directly, not sys_mount_shim).  The bytes
  // are inline string literals rather than `[u8; N] = uninit @align(8)`
  // + a per-boot fill loop so the constants are visible in the
  // disassembly and no runtime init-order dependency is needed.
  //
  // Case (1) bytes: "XYZ//badpath" -- 12 bytes exactly, wrong prefix.
  // Case (2) bytes: "/dev/pdxvolf" -- 12 bytes exactly, prefix OK,
  //                 hex digit 'f' -> row_id 15 (guaranteed empty per
  //                 module header case-(2) rationale).
  // mount_point:    "/home/persist\0" -- 14 bytes; witness passes 13
  //                 as the length arg (the NUL is not counted, matching
  //                 sys_mount_body's contract on the mount_point_len
  //                 arg -- length-in-bytes with NO NUL requirement).
  // ==========================================================================

  pub let wr107mb_bad_dev  : [u8; 12] = "XYZ//badpath"
  pub let wr107mb_good_dev : [u8; 12] = "/dev/pdxvolf"
  pub let wr107mb_mp_path  : [u8; 14] = "/home/persist\0"

  // ==========================================================================
  // witness_r107_mount_block_run() -> u64
  //
  // Exit code:
  //   0  both cases returned SYS_MOUNT_ENODEV (0xFFFFED66).
  //   1  either case returned a different value -- silent w.r.t. the
  //      OK-token coverage gate (no fingerprint emitted); the value
  //      itself is not klog'd here (the failure is diagnosable by
  //      absence-of-fingerprint plus the caller's own audit of the
  //      preceding witness sequence; a subsequent revision may extend
  //      this witness to emit a per-case `R107 SYS MOUNT BLOCK
  //      RESOLVER FAIL case=<n>` via klog_s1_d1 once a k_case wire
  //      arg exists in core/klog/keys.pdx -- deferred to a follow-up
  //      to keep this landing's key-table churn minimal).
  //
  // Body per the module header two-call contract:
  //   (1) rdi = &wr107mb_bad_dev,  rsi = 12, rdx = &mp_path, rcx = 13,
  //       r8 = 5; call sys_mount_body; cmp rax, 0xFFFFED66; jne fail.
  //   (2) rdi = &wr107mb_good_dev, rsi = 12, rdx = &mp_path, rcx = 13,
  //       r8 = 5; call sys_mount_body; cmp rax, 0xFFFFED66; jne fail.
  //   Both passing: emit `R107 SYS MOUNT BLOCK RESOLVER OK` via
  //   klog_s1(LEVEL_INFO=3, SUBSYS_FS__, wr107mb_ok_msg); return 0.
  //   Fail: return 1 (silent -- no fingerprint).
  //
  // Effect row {sysreg, mem} matches klog_s1's + sys_mount_body's
  // union (sysreg for klog's underlying uart_putc + mem for ring
  // append; sys_mount_body's own {mem, sysreg}).  Capability row
  // {boot, cap} matches sys_mount_body's own @{cap} + the caller's
  // @{boot} row (r30_platform_run's own capability set inherited
  // into every boot-witness dispatch site).
  //
  // The 0xFFFFED66 comparison is staged through r10 per bit-63-set
  // imm discipline (0xFFFFED66 fits imm32 fine as 0xFFFFED66 =
  // 4294962534 which is bit-31-set, sign-extending to a distinct
  // negative 64-bit value under a bare cmp; staging via r10 keeps
  // the compare an unsigned 64-bit == against the actual raw value
  // sys_mount_body returns).  This matches the identical staging
  // pdxfs_boot_mount_smoke uses for its INODE_INVALID_INDEX +
  // INODE_HEADER_INUSE_BAD checks.
  //
  // Alignment ledger: entry rsp%16 == 8 (caller %16==0 + retaddr),
  // one push (rbx) -> %16 == 0 which IS the SysV pre-call
  // requirement.  Every nested `call sys_mount_body` / `call klog_s1`
  // therefore sees %16 == 0 pre-CALL, callee sees %16 == 8 at body
  // entry.  No `sub rsp, N` pad needed.
  // ==========================================================================
  pub let witness_r107_mount_block_run : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R107.M1 (#2345): boot-time witness for the sys_mount block-arm resolver landed at core/syscall/sys_mount.pdx R107.M1. Drives two sys_mount_body calls against the new dev_path parser -- (1) malformed dev_path (bytes 'XYZ//badpath', 12 bytes, wrong prefix) MUST return SYS_MOUNT_ENODEV (0xFFFFED66); (2) well-formed dev_path ('/dev/pdxvolf', row_id 15, guaranteed empty per module header) MUST return SYS_MOUNT_ENODEV. Both passing -> emit 'R107 SYS MOUNT BLOCK RESOLVER OK' via klog_s1(3, SUBSYS_FS__, wr107mb_ok_msg). Either failing -> return 1 silently (no fingerprint, coverage gate rejects the golden line's absence). One-push prologue (rbx = pass count) lands rsp%16 == 0 at the sys_mount_body + klog_s1 call sites (entry %16 == 8, push -> %16 == 0). 0xFFFFED66 staged via r10 per bit-63-set imm discipline (bit 31 set sign-extends under a bare cmp). Effect row {sysreg, mem} matches klog_s1 union sys_mount_body; capability row {boot, cap} matches sys_mount_body's own @{cap} + the boot caller's @{boot}. Labels prefixed wr107mb_ -- grep audit 2026-09-06: no wr107mb_ hits anywhere else in src/kernel/. No test instruction anywhere; no mov_b (all whole-qword access, no per-byte reads in this witness). The exhaustive LIVE-arm proof (a real mount reaching a mount_slot + a subsequent read) is R107.M2/M5's job per design/roadmap/persistent-home-wave.md §R107; R107.M1 lands the resolver seam and this witness pins the two diagnostic paths that prove it is no longer a two-instruction stub.",
      block: {
        push rbx;

        xor rbx, rbx;                        // pass_count = 0

        // -----------------------------------------------------------
        // Case (1): malformed dev_path.
        // -----------------------------------------------------------
        lea rdi, [rip + wr107mb_bad_dev];    // dev_path_ptr
        mov rsi, 12;                         // dev_path_len
        lea rdx, [rip + wr107mb_mp_path];    // mount_point_ptr
        mov rcx, 13;                         // mount_point_len (excl. NUL)
        mov r8,  5;                          // backend_id = pdxfs_block
        call sys_mount_body;
        mov r10, 0xFFFFED66;                 // SYS_MOUNT_ENODEV
        cmp rax, r10;
        jne wr107mb_fail;
        add rbx, 1;

        // -----------------------------------------------------------
        // Case (2): well-formed dev_path, empty row 15.
        // -----------------------------------------------------------
        lea rdi, [rip + wr107mb_good_dev];
        mov rsi, 12;
        lea rdx, [rip + wr107mb_mp_path];
        mov rcx, 13;
        mov r8,  5;
        call sys_mount_body;
        mov r10, 0xFFFFED66;                 // SYS_MOUNT_ENODEV
        cmp rax, r10;
        jne wr107mb_fail;
        add rbx, 1;

        // -----------------------------------------------------------
        // Both cases passed -> emit ordered fingerprint.
        // -----------------------------------------------------------
        cmp rbx, 2;
        jne wr107mb_fail;

        mov rdi, 3;                          // LEVEL_INFO
        lea rsi, [rip + SUBSYS_FS__];
        lea rdx, [rip + wr107mb_ok_msg];
        call klog_s1;

        xor rax, rax;
        pop rbx;
        ret;

      wr107mb_fail:
        mov rax, 1;
        pop rbx;
        ret
      }
    }
}
