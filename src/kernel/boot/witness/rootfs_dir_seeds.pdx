// src/kernel/boot/witness/rootfs_dir_seeds.pdx — R90-XREPO.005 (#1999)
// Seeds the tmpfs directory tree several satellite-repo tools expect to
// exist at boot but that rootfs_seed.pdx / bin_seeds.pdx never create:
//
//   /share/doc        (nested under new /share)
//   /pkgs
//   /system/packages   (nested under existing /system)
//   /system/keys
//   /system/trash
//   /journal/pkg       (nested under new /journal)
//
// Called from kernel_main.pdx immediately after witness_bin_seeds, so
// /bin, /etc, /tmp and the root vnode are already wired by the time this
// runs (this module never touches those three). /system itself is ALSO
// already wired by then: witness_r20b_substrate's audit_bridge_witness
// (r20b_substrate.pdx, ~line 949) creates /system under root earlier in
// the kernel_main_64 cascade for the audit-log bridge. Stage 5 below
// therefore looks /system up via tmpfs_lookup instead of tmpfs_create'ing
// it a second time (a second create collides on the existing dentry and
// returns 0 — the root cause of the #1999 "dir seeds fail line=5"
// regression) — matching r29_registry.pdx's own "Stage 0: locate /system"
// precedent. /share, /pkgs and /journal are the three genuinely-new
// top-level directories this module creates from scratch.
//
// -----------------------------------------------------------------------------
// Pattern
// -----------------------------------------------------------------------------
//
// Mirrors bin_seeds.pdx's bin_child_hello_seed / bs_ls_seed directory-
// creation half exactly (mount_root_vnode → tmpfs_create(parent_inode,
// name, len, VNODE_TYPE_DIR=2) → vnode_cache_or_alloc(parent_vn_idx,
// new_inode, &_tmpfs_vops)), minus the file-content write phase — every
// entry here is a directory, and this module creates directories only
// (no files). vnode_cache_or_alloc is called for EVERY directory,
// including the four top-level ones with children (share, system,
// journal), because each one's own vnode-pool idx becomes the
// parent_vn_idx argument for its children's own bind — the same role
// bin_vn_idx plays for /bin/child_hello in bin_seeds.pdx. Leaf
// directories (pkgs, share/doc, system/packages, system/keys,
// system/trash, journal/pkg) still bind into the vnode pool for
// consistency with that precedent, even though core/fs/path.pdx's
// path_resolve is fully capable of lazily allocating an equivalent
// vnode-pool entry itself via its own vnode_cache_or_alloc call at
// lookup time (dedup on (parent, backend, ops) makes the two paths
// converge on the same slot) — the eager bind here is belt-and-
// suspenders, not load-bearing for `ls` to later succeed.
//
// Register plan (held across the whole 10-stage sequence):
//   r12 = root_inode_idx (= 1), set once, never changes.
//   r15 = root_vn_idx (from mount_root_vnode), set once, never changes.
//   r13 = the CURRENT top-level directory's own tmpfs inode idx,
//         reassigned at the top of each of the four top-level blocks
//         (share / system / journal — pkgs has no children so never
//         lands in r13) and consumed by that directory's own children.
//   r14 = the CURRENT top-level directory's own vnode-pool idx, same
//         reassignment/consumption pattern as r13.
// A leaf directory's own (inode, vn_idx) pair is never saved past its
// own two calls — nothing downstream needs it, matching bin_seeds'
// child_hello step 5 comment ("return value not stored — no downstream
// consumer").
//
// Stage counter `_rfs_stage` names which of the 10 stages (1 =
// mount_root_vnode; 2..10 = the nine directories in the order listed
// above) tripped, for the `dir seeds fail line=<N>` fingerprint —
// same idiom as pdxb_ahci_probe.pdx's `_pdxbap_stage` / pdxbap_fail_stage.
//
// Fingerprint: "dir seeds ok -- count=9" on success (klog_s1_d1, all-
// lowercase so tools/verify-fingerprint-coverage.sh's OK_TOK extractor
// (which matches only the uppercase, standalone token `OK`) never picks
// this literal up at all — same discipline as r66v2_tty_raw.pdx's
// "boot tty raw ok --" and r89_tui_canvas.pdx's "boot tui canvas ok --",
// neither of which carries a tools/verify-fingerprint-coverage.sh
// allowlist entry either. "dir seeds fail line=<N>" on the first
// failed stage (klog_s1_d1, LEVEL_ERROR).
//
// See design/kernel/kind-tui-canvas.md's sibling witnesses for the
// general boot/witness/*.pdx module-extraction convention this follows.

module RootfsDirSeeds = structure {

  // Stage counter: bumped at the top of each of the 10 stages so the
  // FAIL fingerprint's `line=N` KV names the tripping stage. Confined
  // to this .o alone by tools/build.sh's ec_confine_one convention
  // (mirrors _pdxbap_stage / _pms_stage / _pkgi_stage).
  pub let mut _rfs_stage : u64 = 0

  // Fingerprint tags. All-lowercase, no embedded "OK"/"FAIL" token, no
  // trailing "\n" (klog_emit_core appends the KV(s) plus its own
  // trailing newline — see emit.pdx step (10)/(11)).
  pub let tag_rfs_dir_seeds_ok   : [u8; 16] = "dir seeds ok --\0"
  pub let tag_rfs_dir_seeds_fail : [u8; 15] = "dir seeds fail\0"

  // Directory name literals, in creation order.
  pub let rfs_name_share    : [u8; 6] = "share\0"
  pub let rfs_name_doc      : [u8; 4] = "doc\0"
  pub let rfs_name_pkgs     : [u8; 5] = "pkgs\0"
  pub let rfs_name_system   : [u8; 7] = "system\0"
  pub let rfs_name_packages : [u8; 9] = "packages\0"
  pub let rfs_name_keys     : [u8; 5] = "keys\0"
  pub let rfs_name_trash    : [u8; 6] = "trash\0"
  pub let rfs_name_journal  : [u8; 8] = "journal\0"
  pub let rfs_name_pkg      : [u8; 4] = "pkg\0"

  // ============================================================================
  // witness_rootfs_dir_seeds() — top-level entry, called from kernel_main
  // immediately after witness_bin_seeds.
  // ============================================================================
  pub let witness_rootfs_dir_seeds : () -> () !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R90-XREPO.005 (#1999): seeds /share/doc, /pkgs, /system/{packages,keys,trash} and /journal/pkg into tmpfs at boot, for satellite-repo tool consumers (v1.x audit) that stat/list these paths but that rootfs_seed.pdx and bin_seeds.pdx never create. Ten-stage sequence, each stage stamping its number into _rfs_stage before its own tmpfs_create/vnode_cache_or_alloc call so a FAIL fingerprint names exactly which one tripped: (1) mount_root_vnode -> r15=root_vn_idx, r12=root_inode_idx=1 (both held for the whole function, never reassigned). (2) tmpfs_create(r12, 'share', 5, DIR) -> r13=share_inode; vnode_cache_or_alloc(r15, r13, &_tmpfs_vops) -> r14=share_vn_idx. (3) tmpfs_create(r13, 'doc', 3, DIR) -> inode (leaf, discarded after its own bind); vnode_cache_or_alloc(r14, inode, &_tmpfs_vops) (leaf, return discarded — path_resolve can reconstruct an equivalent vnode-pool entry lazily via its own dedup-or-alloc call, so this bind is defensive consistency with bin_seeds.pdx's precedent, not load-bearing). (4) tmpfs_create(r12, 'pkgs', 4, DIR) + vnode_cache_or_alloc(r15, ..., &_tmpfs_vops) (leaf, top-level). (5) tmpfs_lookup(r12, 'system') -> r13=system_inode (#1999 fix: witness_r20b_substrate's audit_bridge_witness already tmpfs_create'd /system under root earlier in the kernel_main_64 cascade for the audit-log bridge, so a second tmpfs_create here collided on the existing dentry and returned 0 -- the 'dir seeds fail line=5' regression; lookup instead of create matches r29_registry.pdx's own precedent for the same pre-existing /system); vnode_cache_or_alloc(r15, r13, &_tmpfs_vops) -> r14=system_vn_idx (r13/r14 reused from the share group, which is fully retired by the time stage 5 runs). (6)-(8) tmpfs_create(r13, name, len, DIR) + vnode_cache_or_alloc(r14, ..., &_tmpfs_vops) for 'packages'/'keys'/'trash' in turn (each leaf). (9) tmpfs_create(r12, 'journal', 7, DIR) -> r13=journal_inode; vnode_cache_or_alloc(r15, r13, &_tmpfs_vops) -> r14=journal_vn_idx (r13/r14 reused again). (10) tmpfs_create(r13, 'pkg', 3, DIR) + vnode_cache_or_alloc(r14, ..., &_tmpfs_vops) (leaf). tmpfs_create failure gate checks BOTH rax==0 (create-failed) and rax==0xFFFF (TMPFS_INODE_ALLOC_OOM), matching bin_child_hello_seed's step 2 gate; vnode_cache_or_alloc's gate checks only rax==0xFFFF (VNODE_ALLOC_OOM), matching that same seed's step 3/5 gates. All ten failure exits converge on rfs_seed_fail, which reads _rfs_stage back into r8 and emits klog_s1_d1(LEVEL_ERROR=1, SUBSYS_BOOT, tag_rfs_dir_seeds_fail, k_line, stage) -> 'dir seeds fail line=<N>', matching pdxb_ahci_probe.pdx's pdxbap_fail_stage shape. All-green path emits klog_s1_d1(LEVEL_INFO=3, SUBSYS_BOOT, tag_rfs_dir_seeds_ok, k_count, 9) -> 'dir seeds ok -- count=9'. Single `push rbp` at entry restores the rsp%16==8 -> %16==0 parity boot_continue_after_ring3's whole call chain depends on (see bin_seeds.pdx module header); matching `pop rbp; ret` at exit. Effects/capabilities {sysreg, mem} @{boot}: mem for every tmpfs_create/vnode_cache_or_alloc/mount_root_vnode call (all declared !{mem} @{}), sysreg transitively via klog_s1_d1's own TSC read, boot matching every sibling tmpfs-seed witness in this directory. Encoder: mov / lea / cmp / je / call -- all pre-existing, no encoder gap; no add reg,[mem] anywhere (no byte-level path parsing in this module, unlike path.pdx). Labels prefixed rfs_seed_; stage counter prefixed _rfs_stage.",
      block: {
        push rbp;

        // ---------- Stage 1: recover root vnode + root inode idx ----------
        mov rax, 1;
        lea rcx, [rip + _rfs_stage];
        mov [rcx], rax;

        call mount_root_vnode;
        cmp rax, 0;
        je rfs_seed_fail;
        mov r15, rax;                            // r15 = root_vn_idx (held for whole function)
        mov r12, 1;                               // r12 = root_inode_idx (held for whole function)

        // ---------- Stage 2: /share (DIR, has one child) ----------
        mov rax, 2;
        lea rcx, [rip + _rfs_stage];
        mov [rcx], rax;

        mov rdi, r12;
        lea rsi, [rip + rfs_name_share];
        mov rdx, 5;
        mov rcx, 2;
        call tmpfs_create;                       // rax = share_inode_idx | 0 | 0xFFFF
        cmp rax, 0;
        je rfs_seed_fail;
        mov rcx, 0xFFFF;
        cmp rax, rcx;
        je rfs_seed_fail;
        mov r13, rax;                             // r13 = share_inode_idx

        mov rdi, r15;
        mov rsi, r13;
        lea rdx, [rip + _tmpfs_vops];
        call vnode_cache_or_alloc;                // rax = share_vn_idx | 0xFFFF
        mov rcx, 0xFFFF;
        cmp rax, rcx;
        je rfs_seed_fail;
        mov r14, rax;                             // r14 = share_vn_idx

        // ---------- Stage 3: /share/doc (DIR, leaf) ----------
        mov rax, 3;
        lea rcx, [rip + _rfs_stage];
        mov [rcx], rax;

        mov rdi, r13;
        lea rsi, [rip + rfs_name_doc];
        mov rdx, 3;
        mov rcx, 2;
        call tmpfs_create;                       // rax = doc_inode_idx | 0 | 0xFFFF
        cmp rax, 0;
        je rfs_seed_fail;
        mov rcx, 0xFFFF;
        cmp rax, rcx;
        je rfs_seed_fail;

        mov rsi, rax;                             // arg2: backend = doc_inode_idx
        mov rdi, r14;                             // arg1: parent = share_vn_idx
        lea rdx, [rip + _tmpfs_vops];
        call vnode_cache_or_alloc;                // rax = doc_vn_idx | 0xFFFF
        mov rcx, 0xFFFF;
        cmp rax, rcx;
        je rfs_seed_fail;

        // ---------- Stage 4: /pkgs (DIR, leaf, top-level) ----------
        mov rax, 4;
        lea rcx, [rip + _rfs_stage];
        mov [rcx], rax;

        mov rdi, r12;
        lea rsi, [rip + rfs_name_pkgs];
        mov rdx, 4;
        mov rcx, 2;
        call tmpfs_create;                       // rax = pkgs_inode_idx | 0 | 0xFFFF
        cmp rax, 0;
        je rfs_seed_fail;
        mov rcx, 0xFFFF;
        cmp rax, rcx;
        je rfs_seed_fail;

        mov rsi, rax;                             // arg2: backend = pkgs_inode_idx
        mov rdi, r15;                             // arg1: parent = root_vn_idx
        lea rdx, [rip + _tmpfs_vops];
        call vnode_cache_or_alloc;                // rax = pkgs_vn_idx | 0xFFFF
        mov rcx, 0xFFFF;
        cmp rax, rcx;
        je rfs_seed_fail;

        // ---------- Stage 5: /system (DIR, has three children) ----------
        // #1999 fix: witness_r20b_substrate's audit_bridge_witness (see
        // r20b_substrate.pdx ~line 949) ALREADY creates /system under root
        // earlier in the kernel_main_64 boot cascade (called at line ~957,
        // well before witness_bin_seeds/witness_rootfs_dir_seeds at
        // ~1029/1038). A second tmpfs_create(root, "system", ...) here
        // collides (tmpfs_lookup inside tmpfs_create finds the existing
        // dentry) and returns 0, tripping the `je rfs_seed_fail` gate --
        // this was the exact "dir seeds fail line=5" regression. Fixed by
        // looking the existing inode up instead of re-creating it, matching
        // r29_registry.pdx's established precedent for the same collision
        // (see its "Stage 0: locate /system" comment).
        mov rax, 5;
        lea rcx, [rip + _rfs_stage];
        mov [rcx], rax;

        mov rdi, r12;
        lea rsi, [rip + rfs_name_system];
        call tmpfs_lookup;                       // rax = system_inode_idx | 0 (miss)
        cmp rax, 0;
        je rfs_seed_fail;
        mov r13, rax;                             // r13 = system_inode_idx (share group retired)

        mov rdi, r15;
        mov rsi, r13;
        lea rdx, [rip + _tmpfs_vops];
        call vnode_cache_or_alloc;                // rax = system_vn_idx | 0xFFFF
        mov rcx, 0xFFFF;
        cmp rax, rcx;
        je rfs_seed_fail;
        mov r14, rax;                             // r14 = system_vn_idx

        // ---------- Stage 6: /system/packages (DIR, leaf) ----------
        mov rax, 6;
        lea rcx, [rip + _rfs_stage];
        mov [rcx], rax;

        mov rdi, r13;
        lea rsi, [rip + rfs_name_packages];
        mov rdx, 8;
        mov rcx, 2;
        call tmpfs_create;                       // rax = packages_inode_idx | 0 | 0xFFFF
        cmp rax, 0;
        je rfs_seed_fail;
        mov rcx, 0xFFFF;
        cmp rax, rcx;
        je rfs_seed_fail;

        mov rsi, rax;                             // arg2: backend = packages_inode_idx
        mov rdi, r14;                             // arg1: parent = system_vn_idx
        lea rdx, [rip + _tmpfs_vops];
        call vnode_cache_or_alloc;                // rax = packages_vn_idx | 0xFFFF
        mov rcx, 0xFFFF;
        cmp rax, rcx;
        je rfs_seed_fail;

        // ---------- Stage 7: /system/keys (DIR, leaf) ----------
        mov rax, 7;
        lea rcx, [rip + _rfs_stage];
        mov [rcx], rax;

        mov rdi, r13;
        lea rsi, [rip + rfs_name_keys];
        mov rdx, 4;
        mov rcx, 2;
        call tmpfs_create;                       // rax = keys_inode_idx | 0 | 0xFFFF
        cmp rax, 0;
        je rfs_seed_fail;
        mov rcx, 0xFFFF;
        cmp rax, rcx;
        je rfs_seed_fail;

        mov rsi, rax;                             // arg2: backend = keys_inode_idx
        mov rdi, r14;                             // arg1: parent = system_vn_idx
        lea rdx, [rip + _tmpfs_vops];
        call vnode_cache_or_alloc;                // rax = keys_vn_idx | 0xFFFF
        mov rcx, 0xFFFF;
        cmp rax, rcx;
        je rfs_seed_fail;

        // ---------- Stage 8: /system/trash (DIR, leaf) ----------
        mov rax, 8;
        lea rcx, [rip + _rfs_stage];
        mov [rcx], rax;

        mov rdi, r13;
        lea rsi, [rip + rfs_name_trash];
        mov rdx, 5;
        mov rcx, 2;
        call tmpfs_create;                       // rax = trash_inode_idx | 0 | 0xFFFF
        cmp rax, 0;
        je rfs_seed_fail;
        mov rcx, 0xFFFF;
        cmp rax, rcx;
        je rfs_seed_fail;

        mov rsi, rax;                             // arg2: backend = trash_inode_idx
        mov rdi, r14;                             // arg1: parent = system_vn_idx
        lea rdx, [rip + _tmpfs_vops];
        call vnode_cache_or_alloc;                // rax = trash_vn_idx | 0xFFFF
        mov rcx, 0xFFFF;
        cmp rax, rcx;
        je rfs_seed_fail;

        // ---------- Stage 9: /journal (DIR, has one child) ----------
        mov rax, 9;
        lea rcx, [rip + _rfs_stage];
        mov [rcx], rax;

        mov rdi, r12;
        lea rsi, [rip + rfs_name_journal];
        mov rdx, 7;
        mov rcx, 2;
        call tmpfs_create;                       // rax = journal_inode_idx | 0 | 0xFFFF
        cmp rax, 0;
        je rfs_seed_fail;
        mov rcx, 0xFFFF;
        cmp rax, rcx;
        je rfs_seed_fail;
        mov r13, rax;                             // r13 = journal_inode_idx (system group retired)

        mov rdi, r15;
        mov rsi, r13;
        lea rdx, [rip + _tmpfs_vops];
        call vnode_cache_or_alloc;                // rax = journal_vn_idx | 0xFFFF
        mov rcx, 0xFFFF;
        cmp rax, rcx;
        je rfs_seed_fail;
        mov r14, rax;                             // r14 = journal_vn_idx

        // ---------- Stage 10: /journal/pkg (DIR, leaf) ----------
        mov rax, 10;
        lea rcx, [rip + _rfs_stage];
        mov [rcx], rax;

        mov rdi, r13;
        lea rsi, [rip + rfs_name_pkg];
        mov rdx, 3;
        mov rcx, 2;
        call tmpfs_create;                       // rax = pkg_inode_idx | 0 | 0xFFFF
        cmp rax, 0;
        je rfs_seed_fail;
        mov rcx, 0xFFFF;
        cmp rax, rcx;
        je rfs_seed_fail;

        mov rsi, rax;                             // arg2: backend = pkg_inode_idx
        mov rdi, r14;                             // arg1: parent = journal_vn_idx
        lea rdx, [rip + _tmpfs_vops];
        call vnode_cache_or_alloc;                // rax = pkg_vn_idx | 0xFFFF
        mov rcx, 0xFFFF;
        cmp rax, rcx;
        je rfs_seed_fail;

        // ---------- All nine directories created: emit OK ----------
        mov rdi, 3;                               // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_rfs_dir_seeds_ok];
        lea rcx, [rip + k_count];
        mov r8, 9;
        call klog_s1_d1;
        jmp rfs_seed_done;

      rfs_seed_fail:
        lea rax, [rip + _rfs_stage];
        mov r8, [rax];
        mov rdi, 1;                               // LEVEL_ERROR
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_rfs_dir_seeds_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;

      rfs_seed_done:
        pop rbp;
        ret
      }
    }
}
