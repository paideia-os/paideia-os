// src/kernel/boot/witness/r113_m8_kbd_qemu_witness.pdx
// -- Wave ν (α–τ plan, deferred): paideia-os #2418 QEMU proxy.
//
// -----------------------------------------------------------------------------
// What this witness proves (and what it CANNOT prove)
// -----------------------------------------------------------------------------
//
// paideia-os#2418 -- "External-USB-keyboard input smoke on T14" -- is
// gated on physical T14 G4 hardware for the honest end-to-end story
// (real USB HID class enumeration + sys_read from init actually
// receiving a keycode).  It CANNOT be closed by any QEMU session.
//
// This witness is the QEMU-approximation code-path exerciser Wave ν
// commits to landing so that the code side of the issue is genuinely
// done and only the "run on real T14" remains.  Its stance is:
//
//   * Under `PAIDEIA_VGA=none tools/run-qemu.sh -device qemu-xhci
//     -device usb-kbd`, QEMU synthesises a real xHCI controller
//     (class 0x0C / subclass 0x03 / prog_if 0x30) with a HID
//     boot-keyboard device connected on one of its root-hub ports.
//   * kernel_main.pdx's existing pci_enumerate_all_segments +
//     xhci_attach_all cascade discovers the controller, populates
//     _xhci_devices[0], maps BAR0, and mints a KIND_XHCI_CTRL cap at
//     slot XHCI_ATTACH_PUB_SLOT_BASE (196) whose target_ptr is the
//     mapped bar0_va.
//   * This witness reads cap_table[196] directly (kind gate +
//     target_ptr extract), then walks all reported root-hub ports
//     via xhci_port_read + PORTSC.CCS extraction.  If any port
//     reports CCS=1 (connected device), the qemu-xhci + usb-kbd
//     enumeration reached the port-status layer end-to-end.
//
// What this witness does NOT do (and honestly cannot, until the USB
// enumeration substrate lands a call site above hid_keyboard_attach_
// all -- see src/kernel/core/drivers/xhci/hid_kbd_attach.pdx §Substrate
// posture): it does not descend USB device / configuration / interface
// / HID-class descriptors, it does not fire a Configure Endpoint on
// the interrupt-IN EP, and it does not read a HID Boot Keyboard
// report.  Those layers require _hid_kbd_devices populated by a
// worker that is not yet wired.  The "USB HID Boot Keyboard reaches
// sys_read" claim is deferred to real T14 hardware; this witness
// carries the PORTSC-observable half of the same code path.
//
// -----------------------------------------------------------------------------
// Fingerprint
// -----------------------------------------------------------------------------
//
//   Emits on success (>= 1 xHCI controller + >= 1 connected port):
//     "R113 M8-038 KBD QEMU OK"
//   Skip (no xHCI probed OR cap slot 196 wrong kind):
//     "R113 M8-038 KBD QEMU SKIP"
//   Fail (xHCI present, port_count > 0, but no CCS=1 port found):
//     "R113 M8-038 KBD QEMU FAIL"
//
// The OK marker is picked up by the fingerprint-coverage gate; a
// matching Wave-ν ALLOWLIST entry lands in tools/verify-fingerprint-
// coverage.sh (reason: QEMU-only smoke; real-HW golden pending T14
// boot session).  SKIP / FAIL carry no OK token so they need no
// allowlist.
//
// -----------------------------------------------------------------------------
// Encoder / SysV discipline
// -----------------------------------------------------------------------------
//
// Frame prologue implicit.  Every nested call boundary at rsp%16==0.
// No `test rN, rN`; no `and r11, imm64`; no 2-op `imul r, imm`; no
// `qword ptr`; no `[reg + N*1]`; no `mov r, -N` (hex sentinels
// staged via `mov r10, imm64`); no `mov_d reg, reg`.  Labels prefixed
// `r113kbd_`.

module R113M8KbdQemuWitness = structure {

  // ==========================================================================
  // Fingerprint tags.  Sized to include the trailing NUL (klog_s1
  // reads a C-string).  The OK tag alone contains an OK token per
  // the coverage gate's word-boundary regex.
  // ==========================================================================

  pub let tag_r113_m8_kbd_ok   : [u8; 24] = "R113 M8-038 KBD QEMU OK\0"
  pub let tag_r113_m8_kbd_skip : [u8; 26] = "R113 M8-038 KBD QEMU SKIP\0"
  pub let tag_r113_m8_kbd_fail : [u8; 26] = "R113 M8-038 KBD QEMU FAIL\0"

  // Stage marker for FAIL emission line=<N>.
  pub let mut _r113kbd_stage : u64 = 0

  // Local key for the CCS-connected-port count decimal KV on the OK
  // line.  Namespaced so it does not collide with any keys.pdx entry.
  pub let r113kbd_k_ccs : [u8; 4] = "ccs\0"

  // ==========================================================================
  // witness_r113_m8_kbd_qemu() -> ()
  //
  // Placement: called from kernel_main's post-init witness cascade,
  // after witness_r104_iris_xe_flip and before the R100-PREP-* block.
  //
  // Register plan:
  //   rbx = xhci device count (latched once)
  //   r12 = cap_slot 196 descriptor base VA (cap_table + 196*24)
  //   r13 = bar0_va extracted from cap_table[196]+16
  //   r14 = port_count (xhci_port_read upper bound)
  //   r15 = ccs_hits (count of ports with PORTSC.CCS=1)
  //   rbp = current port index (1-based)
  //
  // Six callee-save pushes (48 B) + sub rsp,8 = 56 B; entry rsp%16==8
  // -> 64, %16==0 for every nested call boundary (xhci_port_read,
  // klog_s1, klog_s1_d1).
  // ==========================================================================

  pub let witness_r113_m8_kbd_qemu : () -> () !{mem, sysreg} @{boot, cap} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot, cap},
      justification: "Wave ν (α–τ plan, deferred): paideia-os #2418 QEMU-proxy witness. Skips cleanly when no xHCI was probed. When active: reads cap_table[196] directly (24-byte stride per cap/mint.pdx: kind@+0, rights@+8, target_ptr@+16), validates kind == KIND_XHCI_CTRL(0x19C), extracts bar0_va, calls xhci_port_count to get MaxPorts, walks ports 1..N via xhci_port_read, extracts PORTSC.CCS (bit 0) via `and rax, 1`. If any port reports CCS=1, emits the OK fingerprint with ccs=<count>. Zero-CCS with non-zero port_count emits FAIL (unexpected under -device qemu-xhci -device usb-kbd). Six callee-save pushes + sub rsp,8: entry rsp%16==8 -> 64, %16==0 for every nested call. Labels prefixed r113kbd_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;

        // ---------- Stage 1: xHCI probe count guard ----------
        mov rax, 1;
        lea rcx, [rip + _r113kbd_stage];
        mov [rcx], rax;

        mov rbx, [rip + _xhci_device_count];
        cmp rbx, 0;
        je  r113kbd_skip;

        // ---------- Stage 2: cap_table[196] kind + target_ptr ----------
        // cap_table stride = 24 (mint.pdx §cap_mint_write body).
        // 196*24 = 4704.  r12 = cap_table + 4704.
        mov rax, 2;
        lea rcx, [rip + _r113kbd_stage];
        mov [rcx], rax;

        lea r12, [rip + cap_table];
        mov r10, 4704;
        add r12, r10;

        // kind at +0.  Require KIND_XHCI_CTRL(0x19C).  If xhci_attach_
        // all failed to mint (e.g. platform_mmio_map returned 0) the
        // slot is 0 and we skip: no fault of this witness.
        mov rax, [r12 + 0];
        mov r10, 0x19C;
        cmp rax, r10;
        jne r113kbd_skip;

        // bar0_va at +16.
        mov r13, [r12 + 16];
        cmp r13, 0;
        je  r113kbd_skip;

        // ---------- Stage 3: port count ----------
        mov rax, 3;
        lea rcx, [rip + _r113kbd_stage];
        mov [rcx], rax;

        mov rdi, r13;
        call xhci_port_count;
        mov r14, rax;                             // r14 = MaxPorts
        cmp r14, 0;
        je  r113kbd_skip;                         // no ports -> nothing to observe

        // ---------- Stage 4: port scan ----------
        mov rax, 4;
        lea rcx, [rip + _r113kbd_stage];
        mov [rcx], rax;

        xor r15, r15;                             // ccs_hits = 0
        mov rbp, 1;                               // port_1based = 1

      r113kbd_port_loop:
        cmp rbp, r14;
        ja  r113kbd_port_done;

        mov rdi, r13;                             // bar0_va
        mov rsi, rbp;                             // port_1based
        call xhci_port_read;
        // rax = PORTSC (u32 zero-extended).  CCS = bit 0.
        and rax, 1;
        cmp rax, 1;
        jne r113kbd_port_next;
        add r15, 1;

      r113kbd_port_next:
        add rbp, 1;
        jmp r113kbd_port_loop;

      r113kbd_port_done:
        // ---------- Stage 5: verdict ----------
        mov rax, 5;
        lea rcx, [rip + _r113kbd_stage];
        mov [rcx], rax;

        cmp r15, 0;
        je  r113kbd_fail;

        // Success: emit `R113 M8-038 KBD QEMU OK ccs=<n>`.
        mov rdi, 3;                               // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_r113_m8_kbd_ok];
        lea rcx, [rip + r113kbd_k_ccs];
        mov r8, r15;
        call klog_s1_d1;
        jmp r113kbd_done;

      r113kbd_skip:
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_r113_m8_kbd_skip];
        call klog_s1;
        jmp r113kbd_done;

      r113kbd_fail:
        // FAIL emission carries line=<stage> so operator can tell
        // "no xHCI" (skip) from "xHCI present, no connected device"
        // (fail).  The tag itself has no OK token so no allowlist is
        // needed on this arm.
        mov rdi, 1;                               // LEVEL_ERROR
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_r113_m8_kbd_fail];
        lea rcx, [rip + k_line];
        lea rax, [rip + _r113kbd_stage];
        mov r8, [rax];
        call klog_s1_d1;

      r113kbd_done:
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }
}
