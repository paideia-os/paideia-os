// src/kernel/boot/witness/r20b_substrate.pdx — boot witness module
//
// Extracted verbatim from src/kernel/boot/kernel_main.pdx (which had grown
// to 24,315 lines in two functions).  R20b.M1/M2 IPC substrate witness block, plus the M9 dmesg-body and audit-bridge witnesses.
//
// -----------------------------------------------------------------------------
// Why the body is copied and not rewritten
// -----------------------------------------------------------------------------
//
// The goldens for this tree assert an ORDERED SUBSEQUENCE of fingerprints
// across 14 boot modes, and a witness that silently stops running still
// leaves most of that subsequence intact.  The extraction therefore moves
// the instruction stream unchanged: the only bytes this module adds around
// it are the `push rbp` / `pop rbp` / `ret` below.
//
// -----------------------------------------------------------------------------
// The push is not decoration
// -----------------------------------------------------------------------------
//
// `boot_continue_after_ring3` runs its body at `rsp % 16 == 8` — it sits two `call` levels
// below `_start`, and paideia-as emits no frame prologue for an
// `unsafe`-bodied lambda (emit_visit_lambda.rs suppresses the prologue for
// Unsafe bodies, which is also why `@no_frame` is a no-op there).  Several
// witnesses in this file reason explicitly about that parity — "3 pushes from %16==8
// yields (8+3*8)%16 == 0" — and a bare `call` into a bare body would enter
// at `%16 == 0` and invert every one of those arguments.  The single
// `push rbp` restores the inline parity exactly; the matching `pop rbp`
// keeps rbp's SysV guarantee for the caller.
//
// Sections in this module, in the order boot_continue_after_ring3 ran them:
//   * R20b.M1-002 (#1553): endpoint_table + payload_arena witness.
//   * R20b.M1-003 (#1554): svc_broker table + register/lookup witness.
//   * R20b.M2-001 (#1555): 8-byte message header + frame primitives
//   * R20b.M2-002 (#1556): pending-msg primitives witness.
//   * logging-m9-002 (#709): sys_dmesg body witness.
//   * logging-m9-003 (#710): audit-log bridge witness.

module R20bSubstrate = structure {

  // witness_r20b_substrate() — the R20b.M1/M2 IPC substrate witness block, plus the M9 dmesg-body and audit-bridge witnesses.
  //
  // Effect and capability rows are the ones the enclosing
  // `boot_continue_after_ring3` declares.  They are not widened here: this
  // is the same instruction stream under a new symbol, so the authority it
  // needs is by construction the authority it already had.
  pub let witness_r20b_substrate : () -> () !{sysreg} @{} = fn () -> unsafe {
    effects: { sysreg },
    capabilities: { boot },
    justification: "Boot witness block lifted verbatim out of kernel_main.pdx's boot_continue_after_ring3 during the r20b_substrate extraction. Body bytes are unchanged from the inline form; the only additions are the entry `push rbp` and the exit `pop rbp; ret`. The push is load-bearing rather than cosmetic: boot_continue_after_ring3 executes its body at rsp%16 == 8 (two `call` levels below _start, with no frame prologue emitted for unsafe-bodied lambdas), and the witnesses inside this module compute their own nested-call alignment from that parity. Entering through a `call` without the compensating push would present rsp%16 == 0 to the body and silently invert every such argument — the failure mode of paideia-os #1192, #1195 and #1584. Effects and capabilities are copied unchanged from the enclosing function for the same reason: no authority is added, so none needs justifying beyond what boot_continue_after_ring3 already justified.",
    block: {
      push rbp;

      // ============================================================
      // R20b.M1-002 (#1553): endpoint_table + payload_arena witness.
      //
      // Second sub-issue of the R20b userspace-server substrate cluster.
      // Exercises the endpoint_alloc/endpoint_free/endpoint_lookup
      // primitives on _ipc_endpoint_table (src/kernel/core/ipc/
      // endpoint_table.pdx) and payload_buf_pa_for on _ipc_payload_arena
      // (src/kernel/core/ipc/payload_arena.pdx). Both storage regions
      // sit in .bss and are freshly zero-initialized at this point in
      // boot (no earlier code touches them; this witness introduces
      // them).
      //
      // Sub-tests (executed in order; any failure jumps to fail marker):
      //   A. Alloc 128 endpoints; assert each returned id == i (low-first
      //      scan over fresh .bss must hand out 0, 1, ..., 127 in order).
      //      Proves 128-slot capacity + distinctness.
      //   B. One more alloc returns ENDPOINT_ALLOC_NONE (0xFFFFFFFFFFFFFFFF)
      //      — table exhausted.
      //   C. endpoint_lookup(0) != 0 — live endpoint returns row PA.
      //   D. endpoint_lookup(200) == 0 — out-of-range returns NULL.
      //   E. Free all 128 endpoints; endpoint_lookup(id) == 0 after each
      //      free — proves free discipline reopens the slot.
      //   F. Alloc 128 again; assert each returned id == i — proves the
      //      round-trip (alloc-all -> free-all -> alloc-all) works.
      //   G. Cleanup: free all 128 endpoints so downstream tests see a
      //      clean table.
      //   H. payload_buf_pa_for(0) is 4 KiB-aligned (low 12 bits == 0).
      //   I. payload_buf_pa_for(127) is 4 KiB-aligned.
      //   J. Adjacent contiguity: pa(1) - pa(0) == 4096.
      //   K. Long-range contiguity: pa(64) - pa(0) == 64 * 4096 = 0x40000.
      //
      // Register plan across sub-tests:
      //   r15 = loop counter (id in fill/free/refill/cleanup loops)
      //   r14 = temp for exhaustion sentinel / alignment mask
      //   r13 = temp for pa(0) reference in contiguity checks
      //   r12 = temp for expected delta in sub-test K
      // ============================================================
      endpoint_alloc_witness:
          // -- Sub-test A: alloc 128, each returns i.
          xor  r15, r15                            // i = 0
      eaw_fill_loop:
          call endpoint_alloc
          cmp  rax, r15
          jne  endpoint_alloc_witness_fail
          add  r15, 1
          cmp  r15, 128
          jne  eaw_fill_loop

          // -- Sub-test B: alloc once more -> ENDPOINT_ALLOC_NONE.
          call endpoint_alloc
          mov  r14, 0xFFFFFFFFFFFFFFFF             // ENDPOINT_ALLOC_NONE
          cmp  rax, r14
          jne  endpoint_alloc_witness_fail

          // -- Sub-test C: lookup(0) != 0.
          xor  rdi, rdi
          call endpoint_lookup
          cmp  rax, 0
          je   endpoint_alloc_witness_fail

          // -- Sub-test D: lookup(200) == 0 (out of range).
          mov  rdi, 200
          call endpoint_lookup
          cmp  rax, 0
          jne  endpoint_alloc_witness_fail

          // -- Sub-test E: free all 128; lookup(id) == 0 after each free.
          xor  r15, r15
      eaw_free_loop:
          mov  rdi, r15
          call endpoint_free
          mov  rdi, r15
          call endpoint_lookup
          cmp  rax, 0
          jne  endpoint_alloc_witness_fail
          add  r15, 1
          cmp  r15, 128
          jne  eaw_free_loop

          // -- Sub-test F: alloc 128 again; each returns i.
          xor  r15, r15
      eaw_refill_loop:
          call endpoint_alloc
          cmp  rax, r15
          jne  endpoint_alloc_witness_fail
          add  r15, 1
          cmp  r15, 128
          jne  eaw_refill_loop

          // -- Sub-test G: cleanup — free all so downstream tests see clean state.
          xor  r15, r15
      eaw_cleanup_loop:
          mov  rdi, r15
          call endpoint_free
          add  r15, 1
          cmp  r15, 128
          jne  eaw_cleanup_loop

          // -- Sub-test H: payload_buf_pa_for(0) is 4 KiB-aligned.
          xor  rdi, rdi
          call payload_buf_pa_for
          mov  r14, rax
          mov  r13, 0xFFF                          // 4 KiB alignment mask
          and  r14, r13
          cmp  r14, 0
          jne  endpoint_alloc_witness_fail

          // -- Sub-test I: payload_buf_pa_for(127) is 4 KiB-aligned.
          mov  rdi, 127
          call payload_buf_pa_for
          mov  r14, rax
          mov  r13, 0xFFF
          and  r14, r13
          cmp  r14, 0
          jne  endpoint_alloc_witness_fail

          // -- Sub-test J: pa(1) - pa(0) == 4096.
          xor  rdi, rdi
          call payload_buf_pa_for
          mov  r13, rax                            // r13 = pa(0)
          mov  rdi, 1
          call payload_buf_pa_for
          sub  rax, r13
          cmp  rax, 4096
          jne  endpoint_alloc_witness_fail

          // -- Sub-test K: pa(64) - pa(0) == 64 * 4096 = 0x40000.
          xor  rdi, rdi
          call payload_buf_pa_for
          mov  r13, rax                            // r13 = pa(0)
          mov  rdi, 64
          call payload_buf_pa_for
          sub  rax, r13
          mov  r12, 0x40000                        // 64 * 4096
          cmp  rax, r12
          jne  endpoint_alloc_witness_fail

          // Success marker: R20b ENDPOINT ALLOC OK
          mov  rdi, 3                              // LEVEL_INFO
          lea  rsi, [rip + SUBSYS_BOOT]
          lea  rdx, [rip + endpoint_alloc_ok_msg]
          call klog_s1
          jmp  endpoint_alloc_witness_done

      endpoint_alloc_witness_fail:
          mov  rdi, 1                              // LEVEL_ERROR
          lea  rsi, [rip + SUBSYS_BOOT]
          lea  rdx, [rip + endpoint_alloc_fail_msg]
          call klog_s1

      endpoint_alloc_witness_done:

      // ============================================================
      // R20b.M1-003 (#1554): svc_broker table + register/lookup witness.
      //
      // Third + final sub-issue of the R20b.M1 cluster — closes M1.
      // Exercises the name-resolution layer (svc_register / svc_lookup)
      // built on top of _svc_broker_table (32 rows × 48 B) in
      // src/kernel/core/ipc/svc_broker.pdx. Per design/ipc/
      // userspace-server-substrate.md §3.3, the broker publishes
      // svc.<name> → endpoint_id bindings so downstream clients can
      // find named endpoints without hard-coding numeric ids.
      //
      // Sub-tests (executed in order; any failure jumps to fail marker):
      //   A. svc_register("svc.test", len=8, endpoint_id=7) →
      //      SVC_REGISTER_OK (0). Fresh table, first row claim.
      //   B. svc_register("svc.test", len=8, endpoint_id=9) →
      //      SVC_REGISTER_ERR_DUPLICATE (2). Same name, different
      //      endpoint_id → refused with distinct error.
      //   C. svc_register("svc.test", len=0, endpoint_id=5) →
      //      SVC_REGISTER_ERR_NAME_LEN (1). Zero length rejected.
      //   D. svc_register("<32-byte name>", len=32, endpoint_id=5) →
      //      SVC_REGISTER_ERR_NAME_LEN (1). Over-31 length rejected.
      //      Buffer is exactly 32 bytes to keep the read safe if a
      //      future implementation reads before gating (belt-and-braces).
      //   E. svc_lookup("svc.test", len=8) → 7 (endpoint_id from A).
      //      Round-trip register → lookup.
      //   F. svc_lookup("svc.other", len=9) → SVC_LOOKUP_NONE
      //      (0xFFFFFFFFFFFFFFFF). Not-registered name → distinct
      //      sentinel.
      //   G. svc_register("svc.a", len=5, endpoint_id=42) →
      //      SVC_REGISTER_OK (0), then svc_lookup("svc.a", len=5) →
      //      42. Proves the table supports > 1 registration and the
      //      lookup discipline discriminates between overlapping
      //      names ("svc.a" not aliased to "svc.test").
      //   H. svc_lookup("svc.test", len=0) → SVC_LOOKUP_NONE.
      //      Symmetric zero-length gate on the lookup side.
      //
      // Register plan across sub-tests: no persistent state carried
      // across sub-tests — each loads its own rdi/rsi/rdx and checks
      // rax immediately. r14 holds the SVC_LOOKUP_NONE sentinel for
      // the imm64 comparisons in sub-tests F/H.
      //
      // Placement: runs right after endpoint_alloc_witness (closes M1
      // in order M1-001 → M1-002 → M1-003) and before sys_dmesg_witness.
      // ============================================================
      broker_witness:
          // -- Sub-test A: register("svc.test", 8, 7) == 0.
          lea  rdi, [rip + _svc_broker_witness_name_test]
          mov  rsi, 8
          mov  rdx, 7
          call svc_register
          cmp  rax, 0                              // SVC_REGISTER_OK
          jne  broker_witness_fail

          // -- Sub-test B: register(same name, 8, 9) == 2 (DUP).
          lea  rdi, [rip + _svc_broker_witness_name_test]
          mov  rsi, 8
          mov  rdx, 9
          call svc_register
          cmp  rax, 2                              // SVC_REGISTER_ERR_DUPLICATE
          jne  broker_witness_fail

          // -- Sub-test C: register(name, 0, 5) == 1 (NAME_LEN).
          lea  rdi, [rip + _svc_broker_witness_name_test]
          mov  rsi, 0
          mov  rdx, 5
          call svc_register
          cmp  rax, 1                              // SVC_REGISTER_ERR_NAME_LEN
          jne  broker_witness_fail

          // -- Sub-test D: register(32-byte name, 32, 5) == 1 (NAME_LEN).
          lea  rdi, [rip + _svc_broker_witness_name_long]
          mov  rsi, 32
          mov  rdx, 5
          call svc_register
          cmp  rax, 1                              // SVC_REGISTER_ERR_NAME_LEN
          jne  broker_witness_fail

          // -- Sub-test E: lookup("svc.test", 8) == 7.
          lea  rdi, [rip + _svc_broker_witness_name_test]
          mov  rsi, 8
          call svc_lookup
          cmp  rax, 7
          jne  broker_witness_fail

          // -- Sub-test F: lookup("svc.other", 9) == SVC_LOOKUP_NONE.
          lea  rdi, [rip + _svc_broker_witness_name_other]
          mov  rsi, 9
          call svc_lookup
          mov  r14, 0xFFFFFFFFFFFFFFFF             // SVC_LOOKUP_NONE
          cmp  rax, r14
          jne  broker_witness_fail

          // -- Sub-test G: register("svc.a", 5, 42) then lookup returns 42.
          lea  rdi, [rip + _svc_broker_witness_name_short]
          mov  rsi, 5
          mov  rdx, 42
          call svc_register
          cmp  rax, 0                              // SVC_REGISTER_OK
          jne  broker_witness_fail

          lea  rdi, [rip + _svc_broker_witness_name_short]
          mov  rsi, 5
          call svc_lookup
          cmp  rax, 42
          jne  broker_witness_fail

          // -- Sub-test H: lookup with len=0 -> SVC_LOOKUP_NONE.
          lea  rdi, [rip + _svc_broker_witness_name_test]
          mov  rsi, 0
          call svc_lookup
          mov  r14, 0xFFFFFFFFFFFFFFFF
          cmp  rax, r14
          jne  broker_witness_fail

          // Success marker: R20b BROKER OK.
          mov  rdi, 3                              // LEVEL_INFO
          lea  rsi, [rip + SUBSYS_BOOT]
          lea  rdx, [rip + broker_ok_msg]
          call klog_s1
          jmp  broker_witness_done

      broker_witness_fail:
          mov  rdi, 1                              // LEVEL_ERROR
          lea  rsi, [rip + SUBSYS_BOOT]
          lea  rdx, [rip + broker_fail_msg]
          call klog_s1

      broker_witness_done:

      // ============================================================
      // R20b.M2-001 (#1555): 8-byte message header + frame primitives
      // witness — opens the R20b.M2 (framed variable-length IPC) branch
      // on top of the M1 substrate.
      //
      // Exercises frame_encode / frame_decode / frame_hdr_{op,ver,flags,
      // payload_len} in src/kernel/core/ipc/frame.pdx. Per
      // design/ipc/acpi-supervisor-schema.md §3 + design/ipc/userspace-
      // server-substrate.md §4.1, the header layout is:
      //   +0  op          u8
      //   +1  ver         u8
      //   +2  flags       u16 LE
      //   +4  payload_len u32 LE  (<= 4088)
      //
      // Because x86-64 stores u64 in native LE, the packed header IS
      // byte-identical to a single u64 store at buf. frame_encode
      // composes the packed u64 in rax and writes once; frame_decode
      // is `mov rax, [buf]`. The witness proves this shape at three
      // levels: (a) byte-level field placement via direct u8/u16/u32
      // reads out of the scratch buf, (b) packed-u64 round-trip via
      // frame_decode, (c) field-level round-trip via the frame_hdr_*
      // accessors.
      //
      // Sub-tests (executed in order; any failure jumps to fail marker):
      //
      //   A. Pre-fill _frame_witness_buf with 0xDEADBEEFCAFEBABE (sentinel).
      //      frame_encode(buf, op=0x03, ver=1, flags=0, payload_len=0x100)
      //      → FRAME_ENCODE_OK (0). 0x100 = 256, well inside the 4088-byte
      //      FRAME_MAX_PAYLOAD gate.
      //
      //   B. Byte-level field placement — direct u8/u16/u32 reads from
      //      the scratch buf must match §3 byte layout:
      //        [+0] u8  == 0x03    (op)
      //        [+1] u8  == 0x01    (ver)
      //        [+2] u16 == 0x0000  (flags LE)
      //        [+4] u32 == 0x0000_0100 (payload_len LE)
      //      Proves the encoder writes each field at its declared offset.
      //
      //   C. Packed-u64 round-trip: frame_decode(buf) returns the exact
      //      packed u64 = (0x0000_0100 << 32) | 0x0103 = 0x0000_0100_0000_0103.
      //      Single 8-byte load recovers the composed header bit-exact —
      //      the property that lets the M2 send path cache pending_hdr as
      //      a single u64 field.
      //
      //   D. Field-level round-trip via accessors:
      //        frame_hdr_op(hdr)          == 0x03
      //        frame_hdr_ver(hdr)         == 0x01
      //        frame_hdr_flags(hdr)       == 0x0000
      //        frame_hdr_payload_len(hdr) == 0x0000_0100
      //      Proves each field can be extracted independently from the
      //      packed u64 with the right shift/mask.
      //
      //   E. Boundary case: payload_len == FRAME_MAX_PAYLOAD (4088)
      //      succeeds. Re-encode with (op=0x83, ver=2, flags=0xABCD,
      //      payload_len=4088) → FRAME_ENCODE_OK (0). Reply-side op with
      //      bit 7 set (0x83 = 0x03 | FRAME_OP_REPLY_BIT) demonstrates
      //      the request/reply symmetry of the header layout.
      //
      //   F. Boundary round-trip: frame_hdr_payload_len(decode(buf)) ==
      //      4088. Confirms the u32-max-valid boundary encodes and
      //      decodes without truncation.
      //
      //   G. Over-limit rejection: frame_encode with payload_len = 4089
      //      → FRAME_ENCODE_ERR_PAYLOAD_LEN (1). Distinct error code per
      //      the design doc convention (§5.11 -E2BIG).
      //
      //   H. buf-not-modified property: after the G rejection, the buf
      //      still holds the E-boundary header (op=0x83, ver=2,
      //      flags=0xABCD, payload_len=4088). Rejected encodes MUST NOT
      //      touch the buffer — callers must be able to hand the same
      //      buf to a retry without cleanup. Verified via frame_decode
      //      returning the boundary-case packed u64.
      //
      // Register plan across sub-tests:
      //   r15 = scratch for decoded values / expected values.
      //   r14 = temp for large imm constants (packed u64 expected,
      //         0xDEAD sentinel).
      //   No callee-save preserved across sub-tests — each loads its own
      //   rdi..r8 and checks rax immediately.
      //
      // Placement: runs right after broker_witness (closes M1) and
      // before sys_dmesg_witness. Opens the M2 milestone.
      // ============================================================
      frame_witness:
          // Record most-recent sub-test index in _frame_witness_stage so
          // the fail path can log which sub-test tripped. Numeric stages:
          //   0 = A (encode ok)                    5 = D3 (accessor flags)
          //   1 = B1..B4 (byte-level layout)       6 = D4 (accessor payload_len)
          //   2 = C (packed-u64 round-trip)        7 = E (boundary encode)
          //   3 = D1 (accessor op)                 8 = F (boundary decode)
          //   4 = D2 (accessor ver)                9 = G (over-limit reject)
          //                                       10 = H (buf-not-modified)

          // -- Sub-test A: pre-fill buf with sentinel, then encode.
          mov  r13, 0                              // stage 0
          lea  rax, [rip + _frame_witness_stage]
          mov  [rax], r13

          lea  rdi, [rip + _frame_witness_buf]
          mov  r14, 0xDEADBEEFCAFEBABE
          mov  [rdi], r14

          lea  rdi, [rip + _frame_witness_buf]
          mov  rsi, 0x03                           // op   = ACPI_OP_GET_MCFG
          mov  rdx, 1                              // ver  = 1
          mov  rcx, 0                              // flags = 0
          mov  r8,  0x0100                         // payload_len (256 <= 4088)
          call frame_encode
          cmp  rax, 0                              // FRAME_ENCODE_OK
          jne  frame_witness_fail

          // -- Sub-test B: byte-level field placement.
          mov  r13, 1
          lea  rax, [rip + _frame_witness_stage]
          mov  [rax], r13

          lea  rdi, [rip + _frame_witness_buf]

          // [+0] u8 op == 0x03
          xor  rax, rax
          mov_b rax, [rdi + 0]
          cmp  rax, 0x03
          jne  frame_witness_fail

          // [+1] u8 ver == 0x01
          xor  rax, rax
          mov_b rax, [rdi + 1]
          cmp  rax, 0x01
          jne  frame_witness_fail

          // [+2] u16 flags == 0x0000
          xor  rax, rax
          mov_w rax, [rdi + 2]
          cmp  rax, 0
          jne  frame_witness_fail

          // [+4] u32 payload_len == 0x0000_0100
          xor  rax, rax
          mov eax, [rdi + 4]
          cmp  rax, 0x0100
          jne  frame_witness_fail

          // -- Sub-test C: packed-u64 round-trip via frame_decode.
          mov  r13, 2
          lea  rax, [rip + _frame_witness_stage]
          mov  [rax], r13

          lea  rdi, [rip + _frame_witness_buf]
          call frame_decode
          mov  r15, rax                            // r15 = decoded hdr
          mov  r14, 0x0000010000000103             // expected packed u64
          cmp  r15, r14
          jne  frame_witness_fail

          // -- Sub-test D: field-level round-trip via accessors.
          //    hdr still in r15; each accessor takes hdr as arg.

          //    frame_hdr_op(hdr) == 0x03
          mov  r13, 3
          lea  rax, [rip + _frame_witness_stage]
          mov  [rax], r13

          mov  rdi, r15
          call frame_hdr_op
          cmp  rax, 0x03
          jne  frame_witness_fail

          //    frame_hdr_ver(hdr) == 0x01
          mov  r13, 4
          lea  rax, [rip + _frame_witness_stage]
          mov  [rax], r13

          mov  rdi, r15
          call frame_hdr_ver
          cmp  rax, 0x01
          jne  frame_witness_fail

          //    frame_hdr_flags(hdr) == 0x0000
          mov  r13, 5
          lea  rax, [rip + _frame_witness_stage]
          mov  [rax], r13

          mov  rdi, r15
          call frame_hdr_flags
          cmp  rax, 0
          jne  frame_witness_fail

          //    frame_hdr_payload_len(hdr) == 0x0000_0100
          mov  r13, 6
          lea  rax, [rip + _frame_witness_stage]
          mov  [rax], r13

          mov  rdi, r15
          call frame_hdr_payload_len
          cmp  rax, 0x0100
          jne  frame_witness_fail

          // -- Sub-test E: boundary encode (payload_len == FRAME_MAX_PAYLOAD).
          mov  r13, 7
          lea  rax, [rip + _frame_witness_stage]
          mov  [rax], r13

          lea  rdi, [rip + _frame_witness_buf]
          mov  rsi, 0x83                           // op | FRAME_OP_REPLY_BIT
          mov  rdx, 2                              // ver
          mov  rcx, 0xABCD                         // flags
          mov  r8,  4088                           // FRAME_MAX_PAYLOAD
          call frame_encode
          cmp  rax, 0                              // FRAME_ENCODE_OK
          jne  frame_witness_fail

          // -- Sub-test F: boundary round-trip via payload_len accessor.
          mov  r13, 8
          lea  rax, [rip + _frame_witness_stage]
          mov  [rax], r13

          lea  rdi, [rip + _frame_witness_buf]
          call frame_decode
          mov  r15, rax                            // r15 = boundary hdr
          mov  rdi, r15
          call frame_hdr_payload_len
          cmp  rax, 4088
          jne  frame_witness_fail

          // -- Sub-test G: over-limit rejection.
          mov  r13, 9
          lea  rax, [rip + _frame_witness_stage]
          mov  [rax], r13

          lea  rdi, [rip + _frame_witness_buf]
          mov  rsi, 0x03
          mov  rdx, 1
          mov  rcx, 0
          mov  r8,  4089                           // FRAME_MAX_PAYLOAD + 1
          call frame_encode
          cmp  rax, 1                              // FRAME_ENCODE_ERR_PAYLOAD_LEN
          jne  frame_witness_fail

          // -- Sub-test H: buf-not-modified after rejection.
          //    Decode again; must still be the sub-test E boundary hdr.
          mov  r13, 10
          lea  rax, [rip + _frame_witness_stage]
          mov  [rax], r13

          lea  rdi, [rip + _frame_witness_buf]
          call frame_decode
          mov  r15, rax

          //    op still 0x83
          mov  rdi, r15
          call frame_hdr_op
          cmp  rax, 0x83
          jne  frame_witness_fail

          //    ver still 0x02
          mov  rdi, r15
          call frame_hdr_ver
          cmp  rax, 0x02
          jne  frame_witness_fail

          //    flags still 0xABCD
          mov  rdi, r15
          call frame_hdr_flags
          cmp  rax, 0xABCD
          jne  frame_witness_fail

          //    payload_len still 4088
          mov  rdi, r15
          call frame_hdr_payload_len
          cmp  rax, 4088
          jne  frame_witness_fail

          // Success marker: R20b FRAME HDR OK.
          mov  rdi, 3                              // LEVEL_INFO
          lea  rsi, [rip + SUBSYS_BOOT]
          lea  rdx, [rip + frame_hdr_ok_msg]
          call klog_s1
          jmp  frame_witness_done

      frame_witness_fail:
          // Emit "R20b FRAME HDR FAIL" with the sub-test stage as a
          // decimal KV so the debugger can see which sub-test tripped.
          //   klog_s1_d1(LEVEL_ERROR, SUBSYS_BOOT, frame_hdr_fail_msg,
          //              k_stage, stage_value)
          lea  rax, [rip + _frame_witness_stage]
          mov  r8, [rax]                           // r8 = stage value
          mov  rdi, 1                              // LEVEL_ERROR
          lea  rsi, [rip + SUBSYS_BOOT]
          lea  rdx, [rip + frame_hdr_fail_msg]
          lea  rcx, [rip + k_line]                 // reuse "line" key
          call klog_s1_d1

      frame_witness_done:

      // ============================================================
      // R20b.M2-002 (#1556): pending-msg primitives witness.
      //
      // Second M2 sub-issue — builds on M2-001's frame_encode (packed
      // u64 header) to prove the endpoint_write_pending /
      // endpoint_take_pending / endpoint_is_full round-trip on the
      // single-slot pending-msg semantics from
      // design/ipc/userspace-server-substrate.md §4.3.
      //
      // Sub-tests (executed in order; any failure jumps to fail marker
      // with the numeric stage in _pending_witness_stage):
      //
      //   0. Mint an endpoint (endpoint_alloc -> id in [0..127]). The
      //      endpoint_alloc_witness (R20b.M1-002) freed all 128 rows in
      //      its cleanup phase, so this alloc returns 0.
      //   1. endpoint_is_full(id) == 0 — fresh endpoint has no pending
      //      msg (pending_hdr slot is zero-initialized by .bss).
      //   2. Fill _pending_witness_src with 32 known bytes (0x11..0x30
      //      via a byte-fill loop) so the payload round-trip can be
      //      byte-compared. 32 bytes is well under the 4088-byte cap
      //      and exercises both a header store AND a real memcpy.
      //   3. frame_encode(scratch_hdr_buf, op=0x05, ver=2, flags=0x0007,
      //      payload_len=32) — build a packed hdr. Load it back via
      //      frame_decode to get the u64 to pass into write_pending.
      //   4. endpoint_write_pending(id, hdr, src, 32) == 0 — first
      //      write succeeds (slot was empty).
      //   5. endpoint_is_full(id) == 1 — post-write, endpoint is full.
      //   6. endpoint_write_pending(id, hdr, src, 32) == 1 (EAGAIN) —
      //      second write on full endpoint is rejected.
      //   7. Pre-fill dst hdr scratch with a sentinel (0xDEAD..CAFE)
      //      and dst payload buf with 0xAA bytes so a wrong-length or
      //      wrong-content copy is easily distinguished from a valid
      //      round-trip.
      //   8. endpoint_take_pending(id, &dst_hdr, &dst_payload) == 32
      //      — returns the u32 payload_len that was in the header.
      //   9. dst_hdr (u64 at _pending_witness_dst_hdr) equals the
      //      packed hdr from step 3. Verifies hdr round-trip through
      //      the endpoint row's pending_hdr slot.
      //  10. dst_payload[0] == 0x11 AND dst_payload[31] == 0x30 —
      //      verifies memcpy in-and-out preserves payload bytes at
      //      both ends of the copied range.
      //  11. endpoint_is_full(id) == 0 — post-take, endpoint is empty
      //      again (pending_hdr cleared as the release barrier).
      //  12. endpoint_take_pending(id, ...) == PENDING_TAKE_EMPTY
      //      (0xFFFFFFFFFFFFFFFF) — second take on empty endpoint
      //      returns the empty sentinel, not a stale payload_len.
      //  13. Cleanup: endpoint_free(id) so the id is reusable and the
      //      pending_hdr slot returns to its zero-init state.
      //
      // Register plan:
      //   r15 = allocated endpoint id (survives across all sub-tests).
      //   r14 = packed hdr from step 3 (survives to step 9 comparison).
      //   r13 = loop counter for the fill loop in step 2.
      //   Sentinels loaded into r14 fresh where needed.
      //
      // Placement: opens with the M2-002 sub-issue right after the
      // M2-001 frame_witness closes. sys_dmesg_witness follows.
      // ============================================================
      pending_msg_witness:
          // -- Sub-test 0: mint an endpoint.
          xor  r13, r13                            // stage 0
          lea  rax, [rip + _pending_witness_stage]
          mov  [rax], r13

          call endpoint_alloc
          mov  r14, 0xFFFFFFFFFFFFFFFF             // ENDPOINT_ALLOC_NONE
          cmp  rax, r14
          je   pending_msg_witness_fail
          mov  r15, rax                            // r15 = id

          // -- Sub-test 1: endpoint_is_full(id) == 0 (fresh row).
          mov  r13, 1
          lea  rax, [rip + _pending_witness_stage]
          mov  [rax], r13

          mov  rdi, r15
          call endpoint_is_full
          cmp  rax, 0
          jne  pending_msg_witness_fail

          // -- Sub-test 2: fill src with 32 known bytes (0x11..0x30).
          mov  r13, 2
          lea  rax, [rip + _pending_witness_stage]
          mov  [rax], r13

          lea  r10, [rip + _pending_witness_src]
          xor  r11, r11                            // i = 0
      pmw_fill_loop:
          cmp  r11, 32
          je   pmw_fill_done
          mov  rax, 0x11
          add  rax, r11                            // value = 0x11 + i
          mov_b [r10 + r11*1], rax
          add  r11, 1
          jmp  pmw_fill_loop
      pmw_fill_done:

          // -- Sub-test 3: build packed hdr via frame_encode + frame_decode.
          mov  r13, 3
          lea  rax, [rip + _pending_witness_stage]
          mov  [rax], r13

          lea  rdi, [rip + _pending_witness_hdr_buf]
          mov  rsi, 0x05                           // op
          mov  rdx, 2                              // ver (>= 1 so hdr != 0)
          mov  rcx, 0x0007                         // flags
          mov  r8,  32                             // payload_len
          call frame_encode
          cmp  rax, 0                              // FRAME_ENCODE_OK
          jne  pending_msg_witness_fail

          lea  rdi, [rip + _pending_witness_hdr_buf]
          call frame_decode
          mov  r14, rax                            // r14 = packed hdr

          // -- Sub-test 4: endpoint_write_pending(id, hdr, src, 32) == OK.
          mov  r13, 4
          lea  rax, [rip + _pending_witness_stage]
          mov  [rax], r13

          mov  rdi, r15                            // id
          mov  rsi, r14                            // hdr
          lea  rdx, [rip + _pending_witness_src]   // payload_ptr
          mov  rcx, 32                             // payload_len
          call endpoint_write_pending
          cmp  rax, 0                              // PENDING_WRITE_OK
          jne  pending_msg_witness_fail

          // -- Sub-test 5: endpoint_is_full(id) == 1 (post-write).
          mov  r13, 5
          lea  rax, [rip + _pending_witness_stage]
          mov  [rax], r13

          mov  rdi, r15
          call endpoint_is_full
          cmp  rax, 1
          jne  pending_msg_witness_fail

          // -- Sub-test 6: second write returns EAGAIN.
          mov  r13, 6
          lea  rax, [rip + _pending_witness_stage]
          mov  [rax], r13

          mov  rdi, r15
          mov  rsi, r14
          lea  rdx, [rip + _pending_witness_src]
          mov  rcx, 32
          call endpoint_write_pending
          cmp  rax, 1                              // PENDING_WRITE_ERR_EAGAIN
          jne  pending_msg_witness_fail

          // -- Sub-test 7: pre-fill dst scratches with sentinels.
          mov  r13, 7
          lea  rax, [rip + _pending_witness_stage]
          mov  [rax], r13

          lea  rax, [rip + _pending_witness_dst_hdr]
          mov  r11, 0xDEADBEEFCAFEBABE
          mov  [rax], r11

          lea  r10, [rip + _pending_witness_dst]
          xor  r11, r11
      pmw_dst_prefill_loop:
          cmp  r11, 32
          je   pmw_dst_prefill_done
          mov  rax, 0xAA
          mov_b [r10 + r11*1], rax
          add  r11, 1
          jmp  pmw_dst_prefill_loop
      pmw_dst_prefill_done:

          // -- Sub-test 8: endpoint_take_pending returns payload_len == 32.
          mov  r13, 8
          lea  rax, [rip + _pending_witness_stage]
          mov  [rax], r13

          mov  rdi, r15                            // id
          lea  rsi, [rip + _pending_witness_dst_hdr]
          lea  rdx, [rip + _pending_witness_dst]
          call endpoint_take_pending
          cmp  rax, 32
          jne  pending_msg_witness_fail

          // -- Sub-test 9: dst_hdr equals the packed hdr from step 3.
          mov  r13, 9
          lea  rax, [rip + _pending_witness_stage]
          mov  [rax], r13

          lea  rax, [rip + _pending_witness_dst_hdr]
          mov  rax, [rax]
          cmp  rax, r14
          jne  pending_msg_witness_fail

          // -- Sub-test 10: dst_payload[0] == 0x11, dst_payload[31] == 0x30.
          mov  r13, 10
          lea  rax, [rip + _pending_witness_stage]
          mov  [rax], r13

          lea  r10, [rip + _pending_witness_dst]
          xor  rax, rax
          mov_b rax, [r10]
          cmp  rax, 0x11
          jne  pending_msg_witness_fail

          xor  rax, rax
          mov_b rax, [r10 + 31]
          cmp  rax, 0x30
          jne  pending_msg_witness_fail

          // -- Sub-test 11: endpoint_is_full(id) == 0 (post-take).
          mov  r13, 11
          lea  rax, [rip + _pending_witness_stage]
          mov  [rax], r13

          mov  rdi, r15
          call endpoint_is_full
          cmp  rax, 0
          jne  pending_msg_witness_fail

          // -- Sub-test 12: second take returns PENDING_TAKE_EMPTY.
          mov  r13, 12
          lea  rax, [rip + _pending_witness_stage]
          mov  [rax], r13

          mov  rdi, r15
          lea  rsi, [rip + _pending_witness_dst_hdr]
          lea  rdx, [rip + _pending_witness_dst]
          call endpoint_take_pending
          mov  r11, 0xFFFFFFFFFFFFFFFF             // PENDING_TAKE_EMPTY
          cmp  rax, r11
          jne  pending_msg_witness_fail

          // -- Sub-test 13: cleanup — free the endpoint.
          mov  r13, 13
          lea  rax, [rip + _pending_witness_stage]
          mov  [rax], r13

          mov  rdi, r15
          call endpoint_free

          // Success marker: R20b PENDING MSG OK.
          mov  rdi, 3                              // LEVEL_INFO
          lea  rsi, [rip + SUBSYS_BOOT]
          lea  rdx, [rip + pending_msg_ok_msg]
          call klog_s1
          jmp  pending_msg_witness_done

      pending_msg_witness_fail:
          // Emit "R20b PENDING MSG FAIL" with sub-test stage as decimal KV.
          lea  rax, [rip + _pending_witness_stage]
          mov  r8, [rax]                           // r8 = stage
          mov  rdi, 1                              // LEVEL_ERROR
          lea  rsi, [rip + SUBSYS_BOOT]
          lea  rdx, [rip + pending_msg_fail_msg]
          lea  rcx, [rip + k_line]                 // reuse "line" key
          call klog_s1_d1

      pending_msg_witness_done:

      // ============================================================
      // logging-m9-002 (#709): sys_dmesg body witness.
      //
      // Kernel-side call of sys_dmesg_body — the syscall trampoline
      // (dispatch_dmesg) is exercised end-to-end from userspace only
      // once a user program invokes SYS_DMESG=13. At the boot-witness
      // level we validate the body directly (parallel to sys_read_witness,
      // sys_write_witness, sys_open_witness precedent — kernel VA scratch,
      // no KPTI walk exercised at boot witness time). A pass here proves
      // the wiring from the syscall body through klog_ring_read_tail into
      // ring state is intact; the dispatch_dmesg trampoline is verified
      // structurally by tools/verify-syscall-dispatch.sh (sysno 13 gate).
      // ============================================================
      sys_dmesg_witness:
          lea  rdi, [rip + _dmesg_cap_witness_scratch]  // reuse cap-witness scratch
          mov  rsi, 256                                 // len
          call sys_dmesg_body
          cmp  rax, 0
          je   sys_dmesg_witness_fail

          mov  rdi, 3
          lea  rsi, [rip + SUBSYS_BOOT]
          lea  rdx, [rip + sys_dmesg_ok_msg]
          call klog_s1
          jmp  sys_dmesg_witness_done

      sys_dmesg_witness_fail:
          mov  rdi, 1
          lea  rsi, [rip + SUBSYS_BOOT]
          lea  rdx, [rip + sys_dmesg_fail_msg]
          call klog_s1

      sys_dmesg_witness_done:

      // ============================================================
      // logging-m9-003 (#710): audit-log bridge witness.
      //
      // Per design/kernel/kernel-logging-substrate.md §12.10 +
      // design/audit/log-structure.md: a subset of PANIC + ERROR klog
      // lines is forwarded to the persistent audit log at
      // /system/audit/log.pdaudit. The bridge maintains an in-kernel
      // ring (klog_audit_forward, wired into klog_emit_core) and a
      // flush primitive (klog_audit_flush) that drains the ring into
      // the log inode via tmpfs_write.
      //
      // Steps:
      //   1. tmpfs_create /system as DIR under root.
      //   2. tmpfs_create /system/audit as DIR.
      //   3. tmpfs_create /system/audit/log.pdaudit as REG.
      //   4. Publish log inode into _klog_audit_log_inode.
      //   5. Arm the bridge (_klog_audit_ready = 1).
      //   6. Emit an ERROR-level klog line — klog_emit_core's post-
      //      ring-write hook forwards it into _klog_audit_buf.
      //   7. Call klog_audit_flush — drains buf → log inode.
      //   8. tmpfs_read the log back — assert non-empty.
      //   9. Emit R18 AUDIT BRIDGE OK marker.
      //
      // Register plan across tmpfs_create chain:
      //   r12 = system_inode_idx, r13 = audit_inode_idx,
      //   r14 = log_inode_idx.
      // ============================================================
      audit_bridge_witness:
          // Step 1: tmpfs_create(root_idx=1, "system", 6, DIR=2)
          mov  rdi, 1                              // dir_idx = ROOT
          lea  rsi, [rip + system_dir_name]
          mov  rdx, 6                              // len("system")
          mov  rcx, 2                              // VNODE_TYPE_DIR
          call tmpfs_create
          cmp  rax, 0
          je   audit_bridge_witness_fail
          mov  rcx, 0xFFFF
          cmp  rax, rcx
          je   audit_bridge_witness_fail
          mov  r12, rax                            // r12 = system_idx

          // Step 2: tmpfs_create(system_idx, "audit", 5, DIR=2)
          mov  rdi, r12
          lea  rsi, [rip + audit_dir_name]
          mov  rdx, 5
          mov  rcx, 2                              // VNODE_TYPE_DIR
          call tmpfs_create
          cmp  rax, 0
          je   audit_bridge_witness_fail
          mov  rcx, 0xFFFF
          cmp  rax, rcx
          je   audit_bridge_witness_fail
          mov  r13, rax                            // r13 = audit_idx

          // Step 3: tmpfs_create(audit_idx, "log.pdaudit", 11, REG=1)
          mov  rdi, r13
          lea  rsi, [rip + audit_log_name]
          mov  rdx, 11
          mov  rcx, 1                              // VNODE_TYPE_REG
          call tmpfs_create
          cmp  rax, 0
          je   audit_bridge_witness_fail
          mov  rcx, 0xFFFF
          cmp  rax, rcx
          je   audit_bridge_witness_fail
          mov  r14, rax                            // r14 = log_inode_idx

          // Step 4 + 5: publish inode + arm the bridge. Order matters:
          // klog_audit_forward reads _klog_audit_ready first, so
          // storing the inode BEFORE flipping ready avoids the
          // (ready=1, inode=0) window.
          mov  [rip + _klog_audit_log_inode], r14
          mov  rax, 1
          mov  [rip + _klog_audit_ready], rax

          // Step 6: emit an ERROR-level klog line with a recognizable
          // tag ("AUDIT TEST"). Level 1 = ERROR passes the audit
          // filter; the line lands in the audit ring via the
          // klog_emit_core → klog_audit_forward hook.
          mov  rdi, 1                              // LEVEL_ERROR
          lea  rsi, [rip + SUBSYS_BOOT]
          lea  rdx, [rip + audit_test_tag]
          call klog_s1

          // Step 7: drain the audit buffer into the log inode.
          call klog_audit_flush
          cmp  rax, 0
          je   audit_bridge_witness_fail          // nothing flushed → bridge broken

          // Step 8: read the log inode back and assert non-empty.
          // The bytes are dominated by the klog_emit_core header (TSC
          // hex, CPU id, level letter 'E', subsystem "BOOT|", tag
          // "AUDIT TEST"); any non-zero read confirms the round-trip.
          mov  rdi, r14                            // inode_idx
          lea  rsi, [rip + _audit_bridge_witness_scratch]
          mov  rdx, 4096                           // len
          xor  rcx, rcx                            // offset = 0
          call tmpfs_read
          cmp  rax, 0
          je   audit_bridge_witness_fail

          // Step 9: success marker.
          mov  rdi, 3
          lea  rsi, [rip + SUBSYS_BOOT]
          lea  rdx, [rip + audit_bridge_ok_msg]
          call klog_s1
          jmp  audit_bridge_witness_done

      audit_bridge_witness_fail:
          mov  rdi, 1
          lea  rsi, [rip + SUBSYS_BOOT]
          lea  rdx, [rip + audit_bridge_fail_msg]
          call klog_s1

      audit_bridge_witness_done:


      pop rbp;
      ret
    }
  }

  // -------------------------------------------------------------------------
  // Witness storage
  //
  // These declarations came out of kernel_main.pdx alongside the code
  // above.  Each moved only because this module is the ONLY file in the
  // tree that references it in code; storage read by the exception
  // handlers, by tests, by boot_stub.S, or by a second witness module
  // has no single owner and stayed behind.
  //
  // Declaration ORDER is preserved from kernel_main.pdx.  Several of
  // these witnesses write past the end of one buffer into the next on
  // purpose (the deliberately-511-u64 payload patterns), so relative
  // placement inside a single object is not a formatting question.
  // -------------------------------------------------------------------------

  // R20b.M2-001 (#1555): 8-byte scratch buffer for frame_encode / frame_decode
  // round-trip witness. Sized as [u64; 1] @align(8) — one u64 covers the full
  // 8-byte header per acpi-supervisor-schema §3, and 8-byte alignment matches
  // the natural x86-64 u64 store/load frame_encode/frame_decode use. Lives in
  // .bss (uninit); the witness's first sub-test pre-fills a sentinel before
  // any encode so an accidental read-before-encode would produce a distinct
  // failure signature.
  pub let mut _frame_witness_buf : [u64; 1] = uninit @align(8)

  // R20b.M2-001 (#1555): sub-test stage tracker for the frame_witness.
  // Written at the start of each sub-test; if the fail label fires, the
  // last-written value identifies which sub-test tripped. Zero-init in
  // .bss; overwritten before any fail can fire.
  pub let mut _frame_witness_stage : u64 = 0

  // R20b.M2-002 (#1556): pending-msg witness scratches.
  //
  // _pending_witness_hdr_buf: 8-byte scratch used by the witness to
  //   frame_encode a real packed header before feeding it into
  //   endpoint_write_pending. One u64 covers the full 8-byte hdr per
  //   acpi-supervisor-schema §3.
  // _pending_witness_src: 32 bytes of "source" payload filled with a
  //   known pattern (0x11..0x30) so the take-side memcpy can be byte-
  //   compared. Sized as [u64; 4] = 32 B, natural alignment.
  // _pending_witness_dst_hdr: 8-byte scratch for endpoint_take_pending's
  //   dst_hdr_ptr output. Pre-filled with a sentinel by the witness so
  //   an incorrect store is easy to spot.
  // _pending_witness_dst: 32 bytes of "destination" payload for take's
  //   copy-out; pre-filled with 0xAA sentinel bytes so a wrong-length or
  //   wrong-content copy produces a distinct failure signature.
  // _pending_witness_stage: sub-test index (0..13); written before every
  //   sub-test so a failure exit prints which one tripped.
  pub let mut _pending_witness_hdr_buf : [u64; 1] = uninit @align(8)
  pub let mut _pending_witness_src     : [u64; 4] = uninit @align(8)
  pub let mut _pending_witness_dst_hdr : [u64; 1] = uninit @align(8)
  pub let mut _pending_witness_dst     : [u64; 4] = uninit @align(8)
  pub let mut _pending_witness_stage   : u64 = 0
}
