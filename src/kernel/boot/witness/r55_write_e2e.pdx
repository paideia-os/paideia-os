// src/kernel/boot/witness/r55_write_e2e.pdx -- R55.M2-005 (#1787)
//
// Two-phase pdxfs-block write-then-reboot-then-read-back witness.  Runs
// immediately after the R54.M1-003 r54_bdev_round_trip witness (r30_
// platform.pdx r54_bdev_round_trip_witness_call site) in the boot chain,
// itself the terminal FS witness after pdxfs_round_trip_phased_call.
// Same shape as sibling r54_bdev_round_trip.pdx one-for-one: 3-push
// prologue, defensive nvme/ns/cap-slot reset, substrate cap-chain mint,
// mount_pdxfs_block, sb_read + sb_flags-bit-0 discrimination for phase 1
// vs phase 2 -- BUT instead of driving a raw NVMe payload round-trip
// via nvme_write_blocking / nvme_read_blocking directly against LBA 16,
// this witness DRIVES the R55.M2-004 composed end-to-end write path
// (pdxfs_block_write, cow_write.pdx #1786) in phase 1 and reads the
// stored payload back via the inode's own extent[0] LBA in phase 2:
//
//   * Phase 1 (bit 0 CLEAR -- fresh mkfs, not yet cleanly umounted):
//       stage the 13-byte payload "hello world\n" (backslash+n as two
//       literal bytes, per file header re: readable serial output)
//       into a page-aligned scratch, then
//       pdxfs_block_write(vol_row=0, ino=2, offset=0, len=13,
//                         in_pa=&_r55we_payload_scratch)
//       and rely on pdxfs_block_write's OWN emit of tag_pdxb_write_ok
//       (cow_write.pdx step 14, klog_s1_x3 with ino/offset/len k=v
//       pairs) to satisfy the phase-1 golden fingerprint. This witness
//       does not emit a separate phase-1 tag -- the composed write's
//       own fingerprint IS the phase-1 wire event.
//
//   * Phase 2 (bit 0 SET -- clean-unmount preserved from a prior boot):
//       itable_init(sb_ptr) so inode_read succeeds, then
//       inode_read(bdev_cap=175, ino=2) -> inode_ptr (into
//       _itable_row_scratch, per inode_table.pdx). Extract data_lba =
//       inode_ptr[+48] & 0x0000FFFFFFFFFFFF (low 48 bits per allocator.
//       pdx §"Extent slot 0 stamping"). Zero _r55we_readback_scratch
//       first 16 bytes, then nvme_read_blocking(nsid=1, lba=data_lba,
//       count=1, buf_pa=&_r55we_readback_scratch). Compare the first
//       two qwords against the expected pattern (0x6F77206F6C6C6568,
//       0x0000006E5C646C72 = little-endian encoding of the 13 payload
//       bytes zero-padded to 16). On both matches, emit tag_pdxb_
//       persist_ok exactly once via klog_s1. Any mismatch or upstream
//       error takes r55we_fail_stage (silent w.r.t. the OK-token gate).
//
// -----------------------------------------------------------------------------
// LIVE vs SUBSTRATE gate (same posture as r54_bdev_round_trip.pdx)
// -----------------------------------------------------------------------------
//
// Substrate boots (every QEMU-TCG -kernel run today -- MCFG absent ->
// nvme_probe drains empty -> _nvme_io_queue_count stays 0) MUST NOT
// call pdxfs_block_write's LIVE path or nvme_read_blocking directly --
// pdxfs_block_write's own substrate branch would still emit tag_pdxb_
// write_ok (see cow_write.pdx §Composed flow step (2)), which would
// spuriously add a wire event to every default-matrix boot log and
// force an allowlist entry against the release-mode line-budget /
// R-tag gates for a witness that structurally CANNOT verify a round-
// trip on a machine without an NVMe device. The gate is `_nvme_io_
// queue_count == 0 -> silent return 0` (no mount, no IO, no wire
// event, no side effect) -- same shape r54_bdev_round_trip.pdx uses.
//
// The gate fires BEFORE the mount + sb_flags branch so a substrate
// boot never touches the FS-plumbing either -- the whole witness is a
// silent no-op in substrate mode. That silence keeps the default-
// matrix boot log unchanged for every existing golden and keeps the
// release-mode `\bR[0-9]+\b` + line-budget gates pristine (design/
// kernel/boot-presentation.md §6) without an allowlist entry. When
// --with-disk is present the gate opens and the mount + sb_flags +
// composed write / read-back run against the live namespace,
// producing the tag_pdxb_write_ok (phase 1) / tag_pdxb_persist_ok
// (phase 2) fingerprints the two goldens (tests/r55/expected-r55-
// write-e2e-phase{1,2}.txt) pin.
//
// -----------------------------------------------------------------------------
// Why pdxfs_block_write composed, not raw nvme_write_blocking
// -----------------------------------------------------------------------------
//
// Sibling r54_bdev_round_trip.pdx already exercises the raw payload
// round-trip via nvme_write_blocking / nvme_read_blocking directly
// against a fixed LBA. This witness's contract is different: it
// verifies the R55.M2-004 COMPOSED write path -- the eleven-step
// pdxfs_block_write flow that threads volume_row_device_slot,
// sb_read, itable_init, inode_read, alloc_extent_run, wal_append_
// write, wal_fsync_bdev, bdev_write_at, inode_table_write, and
// klog_s1_x3 together into one end-to-end write. Phase 2's read-back
// reads through the inode's stamped extent[0] LBA rather than a
// hardcoded LBA number, which is what proves the allocator + inode-
// row writeback survived a reboot -- the piece R54's fixed-LBA
// round-trip does not verify.
//
// -----------------------------------------------------------------------------
// Substrate-mode NVMe cap trick (identical to r54_bdev_round_trip.pdx)
// -----------------------------------------------------------------------------
//
// Cap slots 172..176 (same fixed range every R52/R53/R54 PdxFS witness
// already claims). Every prior witness scrubs the range on entry and
// on every exit path, and boot witnesses run strictly sequentially,
// so no two witnesses' cap rows are ever live at once.
//
//   172 = synthetic KIND_PCI_DEV parent
//   173 = KIND_NVME_CONTROLLER (row 0)
//   174 = KIND_NVME_NAMESPACE (row 0, dual-kind with slot 175)
//   175 = KIND_BLKDEV, family NVME -- the bdev_cap for mount_pdxfs_block
//   176 = KIND_VOLUME target slot for mount_pdxfs_block's cap_slot argument
//
// -----------------------------------------------------------------------------
// vol_row = 0 (hardcoded first-mount assumption)
// -----------------------------------------------------------------------------
//
// pdxfs_block_write's first argument is a `vol_row` (0..15), the
// volume-registry row id that indexes _volume_table (kind_volume.pdx
// #1703) and _wal_bdev_state (wal.pdx #1785). Every prior LIVE-arm
// mount in the boot chain (M8-002 pdxfs_boot_mount_smoke,
// pdxfs_round_trip_phased, r54_bdev_round_trip, plus this witness's
// own mount) resolves through probe_one_bdev -> volume_registry_
// register(device_slot=175, uuid=...), which is UUID-keyed and
// idempotent (volume_registry.pdx). Every one of those calls sees
// the same UUID (the disk image is one PDXB volume) so every call
// returns the SAME row_id, which for a fresh registry is 0. Hardcoding
// vol_row = 0 here is exactly the same latch every prior witness's
// KIND_VOLUME @176 cap-mint uses (their target_ptr = row_id = 0).
//
// If a future witness ever mounts a SECOND volume before this one runs
// (registry row 1 would be that volume, our row 0 is the shared image),
// this constant stays correct as long as the shared image is registered
// first -- which the M8 chain guarantees by construction. A widening
// that inverts that order will need to inspect the KIND_VOLUME cap at
// slot 176's target_ptr rather than hardcoding 0; flagged here rather
// than papered over.
//
// -----------------------------------------------------------------------------
// inode 2 (hardcoded per ticket)
// -----------------------------------------------------------------------------
//
// The ticket pins ino=2 as the write target. A freshly-mkfs'd volume
// (per mkfs.pdxfs, #1688) writes a superblock with root_inode=1 and
// zeros the inode table, so every inode index within [0, num_inodes)
// is readable via inode_read (all-zero header => in_use=0 => passes
// hdr_ok gate). pdxfs_block_write's step 7 detects the zero extent[0]
// and calls alloc_extent_run to stamp a fresh data LBA into slot 0 --
// the same allocation deterministically produces the same data LBA
// on every fresh-mkfs boot, so phase 2's inode_read + extent[0]
// extraction lands on the same LBA the phase-1 write targeted.
//
// itable_bcount defaults to ceil(total_blocks/256/32), floor 1 (per
// mkfs-pdxb's layout row), so for the 128 MiB default image
// (32768 blocks) itable_bcount = ceil(128/32) = 4, giving inodes
// [0, 128). Inode 2 is well within range.
//
// -----------------------------------------------------------------------------
// Payload = "hello world\n" (13 bytes, backslash-n literal)
// -----------------------------------------------------------------------------
//
// The 13-byte payload is h,e,l,l,o,SP,w,o,r,l,d,\,n -- the `\n` is
// the literal two-byte sequence backslash + `n` (NOT an interpreted
// newline). The rationale is that the serial-visible portion of
// tag_pdxb_persist_ok includes the payload as a readable string, so
// the on-wire fingerprint stays on one line the operator can grep by
// eye (`payload="hello world\n"`) rather than injecting a real 0x0A
// newline that would break the wire line at the em-dash. The source
// literal below uses `\\n` per the .pdx string-escape convention.
//
// The little-endian qword encoding of the 13 bytes zero-padded to 16:
//
//   qword 0 (bytes 0..7):  "hello wo" = 0x6F77206F6C6C6568
//   qword 1 (bytes 8..15): "rld\n"+3*0x00 = 0x0000006E5C646C72
//
// Both immediates exceed the sign-extended imm32 range and MUST be
// staged via `mov r10, <imm>; mov [mem], r10` / `mov r10, <imm>; cmp
// reg, r10` per G4 encoder-gap discipline (identical shape to r54_
// bdev_round_trip.pdx's 0xDEADBEEFCAFEBABE staging).
//
// -----------------------------------------------------------------------------
// Fingerprint dictionary
// -----------------------------------------------------------------------------
//
//   Substrate:  (silent -- no wire event; see LIVE vs SUBSTRATE gate)
//   Phase 1:    tag_pdxb_write_ok (emitted by pdxfs_block_write's own
//               step 14 -- this witness does NOT emit an additional
//               phase-1 tag; the composed write's fingerprint IS the
//               phase-1 wire event. Wire: "pdxb write ok [legacy:
//               PDXB WRITE OK] ino=0x0000000000000002 offset=0x00...
//               len=0x000000000000000d")
//   Phase 2:    tag_pdxb_persist_ok emitted by this witness's own
//               klog_s1 call -- wire: "pdxb read match ok -- bytes=13
//               [legacy: PDXB PERSIST OK]". (The readable payload
//               string was dropped from the tag literal per keys.pdx
//               §tag_pdxb_persist_ok's own header re: verify-
//               fingerprint-coverage.sh's unesc() collapse of
//               backslash+n to LF; the memcmp gate below is the
//               byte-for-byte truth, and the on-wire `bytes=13`
//               parallels sibling tag_pdxb_bdev_rt_readback_ok's
//               `match=1` visualization.)
//   Fail line:  silent -- no OK token, no additional tag. The fail
//               arm scrubs cap state and returns 1 without emitting
//               anything, keeping the fingerprint-coverage gate
//               honest (fail path bypasses the ok-emit).
//
// -----------------------------------------------------------------------------
// Fingerprint-coverage discipline
// -----------------------------------------------------------------------------
//
// Phase 1 fires tag_pdxb_write_ok exactly once (via pdxfs_block_write's
// own step 14). Phase 2 fires tag_pdxb_persist_ok exactly once (via
// this witness's klog_s1). Substrate + fail paths fire nothing. No
// double firings.
//
// -----------------------------------------------------------------------------
// Register plan
// -----------------------------------------------------------------------------
//
//   3-push prologue (rbx unused/reserved for future bdev_cap parity
//   with r54_bdev_round_trip.pdx, r12 = sb_ptr set in LIVE stage 6,
//   r13 = inode_ptr set in LIVE phase-2 stage 8). Entry rsp%16 == 8;
//   after 3 pushes rsp%16 == 32 mod 16 == 0. Aligned for every
//   nested call.
//
//   The `sub rsp, 32` / `add rsp, 32` bracket around nvme_ns_dual_
//   kind_mint's params_ptr staging is 16-byte aligned, so rsp%16
//   stays 0 across it (identical to r54_bdev_round_trip.pdx stage 4).
//
// -----------------------------------------------------------------------------
// mov_b / no-test / label-prefix discipline
// -----------------------------------------------------------------------------
//
// No byte-granularity access anywhere -- every touched field is a
// u64 (via `mov`) or is extracted register-level via `and rax, <mask>`
// over an already-loaded qword. No `test` instruction; every compare
// uses `cmp` + `je`/`jne`/`jae`/`jb`. Every label prefixed `r55we_`
// (R55 Write End-to-End) per reserved-label discipline. Grep audit
// 2026-08-24: no `r55we_` hits anywhere else in src/kernel/ or
// tests/.
//
// Every sentinel compare against a bit-63-set (or otherwise imm32-
// overflowing) value is staged through `mov r10, <imm>; cmp reg, r10`
// rather than a bare `cmp reg, <imm>` -- identical G4 encoder-gap
// posture r54_bdev_round_trip.pdx / pdxfs_round_trip_phased.pdx
// headers document.
//
// -----------------------------------------------------------------------------
// Wire posture
// -----------------------------------------------------------------------------
//
// Wired into src/kernel/boot/witness/r30_platform.pdx immediately
// AFTER `r54_bdev_round_trip_witness_call` (the R54.M1-003 witness
// site). Placement AFTER that call keeps every prior R52/R53/R54
// PdxFS golden intact (this witness's own output lands as an
// unpinned extra line under contains-in-order); the R55 phase1/phase2
// goldens pin their respective ordered closer.
//
// Two-phase orchestrator: tools/run-smoke.sh boot_r55_write_e2e
// (recursive --wipe phase1 -> preserved phase2 with the R53.M4-005
// rc-0-or-33 handling).

module R55WriteE2e = structure {

  // 4 KiB payload buffer for phase 1's pdxfs_block_write in_pa source
  // page. Page-aligned so the downstream bdev_write_at PRP1 satisfies
  // NVMe §4.5.2 single-page transfer constraint. Single-writer per
  // this witness (only the phase-1 arm's two-qword stager touches it)
  // -- confined via ec_confine_one in tools/build.sh scoped to
  // boot/witness/r55_write_e2e.o.
  pub let mut _r55we_payload_scratch : [u64; 512] = uninit @align(4096)

  // 4 KiB readback destination for phase 2's nvme_read_blocking.
  // Zeroed by the witness before the read (first two qwords stored
  // as zero) so a stale-buffer false-positive is impossible. Single-
  // writer per this witness (only phase-2 stores touch it) -- confined
  // via ec_confine_one in tools/build.sh scoped to boot/witness/
  // r55_write_e2e.o.
  pub let mut _r55we_readback_scratch : [u64; 512] = uninit @align(4096)

  // Stage counter (informational -- unlike sibling witnesses this
  // witness's fail arm does NOT emit a stage line, so the counter is
  // only useful under a debugger, but kept for parity with the
  // established pattern and future extension. Confined via
  // ec_confine_one to boot/witness/r55_write_e2e.o.
  pub let mut _r55we_stage : u64 = 0

  // ==========================================================================
  // r55we_clear() -- scrub cap_table slots 172..176 inclusive.
  //
  // Same shape as prtp_clear / r54rt_clear -- upper bound is 177
  // (exclusive), matching this witness's own slot claim.
  // ==========================================================================
  pub let r55we_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R55.M2-005 (#1787): clear cap_table slots 172..176 (this witness's whole fixed slot claim: 172..175 shared with prior R52/R53/R54 PdxFS witnesses per established practice, 176 this witness's own KIND_VOLUME target). Same shape as prtp_clear/r54rt_clear, upper bound is 177 (exclusive). Labels prefixed r55we_cl_.",
      block: {
        push rbx;
        mov rbx, 172;
      r55we_cl_loop:
        cmp rbx, 177;
        jae r55we_cl_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp r55we_cl_loop;
      r55we_cl_done:
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // r55_write_e2e_witness() -> u64
  //
  // Entry rsp%16 == 8 (invoked from r30_platform.pdx's boot_continue_
  // after_ring3 body via `call r55_write_e2e_witness`, which itself
  // runs at %16==0 after r30_platform.pdx's own `push rbp`). 3-push
  // prologue lands rsp%16 == 0 for every nested call.
  //
  // See module header for the full LIVE vs SUBSTRATE gate, the phase-
  // discrimination semantic, and the substrate-mode NVMe cap trick.
  // ==========================================================================
  pub let r55_write_e2e_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R55.M2-005 (#1787): boot-time pdxfs-block composed write-then-reboot-then-read-back witness. 3-push prologue (rbx unused/reserved for future bdev_cap parity, r12=sb_ptr set in LIVE stage 6, r13=inode_ptr set in LIVE phase-2 stage 8) lands rsp%16==0 for every nested call. Body: (0) SUBSTRATE gate: load _nvme_io_queue_count; if 0 -> silent return 0. (1) defensive reset (nvme_ctrl_table_reset, nvme_ns_table_reset, r55we_clear). (2)-(4) mint substrate NVMe cap chain identical to r54_bdev_round_trip.pdx stages 2-4. (5) mount_pdxfs_block(cap_slot=176, bdev_cap=175, uuid_hint_lo=0, uuid_hint_hi=0); jae 8 -> r55we_fail_stage. (6) sb_read(175); jb KERNEL_VMA_BASE -> r55we_fail_stage; r12 = sb_ptr. (7) sb_flags(sb_ptr); extract bit 0; je -> r55we_phase1. (8) phase 2 arm: itable_init(sb_ptr); inode_read(bdev_cap=175, ino=2); jb KERNEL_VMA_BASE (sentinel) -> r55we_fail_stage; r13 = inode_ptr. Zero readback_scratch[0..15] (two qword stores). Load data_lba = [r13+48] & 0x0000FFFFFFFFFFFF. nvme_read_blocking(nsid=1, lba=data_lba, count=1, buf_pa=&_r55we_readback_scratch); jne 0 -> r55we_fail_stage. Compare readback_scratch[0] against 0x6F77206F6C6C6568 (staged via r10); jne -> r55we_fail_stage. Compare readback_scratch[8] against 0x0000006E5C646C72 (staged via r10); jne -> r55we_fail_stage. klog_s1(3, SUBSYS_BOOT, tag_pdxb_persist_ok). cleanup; return 0. r55we_phase1 arm: stage two qwords 0x6F77206F6C6C6568, 0x0000006E5C646C72 into payload_scratch[0], payload_scratch[8] via r10. pdxfs_block_write(vol_row=0, ino=2, offset=0, len=13, in_pa=&_r55we_payload_scratch); cmp rax, 0; jne r55we_fail_stage. tag_pdxb_write_ok already fired inside pdxfs_block_write step 14. cleanup; return 0. r55we_fail_stage: silent cleanup; return 1. Every cleanup path calls r55we_clear + nvme_ctrl_table_reset + nvme_ns_table_reset before returning. Labels prefixed r55we_.",
      block: {
        push rbx;
        push r12;
        push r13;

        // -----------------------------------------------------------
        // (0) SUBSTRATE gate. Silent return 0 -- no mount, no IO,
        // no wire event -- so the release-mode line-budget / R-tag
        // gates stay pristine on the default matrix, no allowlist
        // entry needed, and no coverage row required for a "witness
        // ran but did nothing" line.
        // -----------------------------------------------------------
        mov rax, [rip + _nvme_io_queue_count];
        cmp rax, 0;
        jne r55we_have_live;
        xor rax, rax;
        jmp r55we_out;

      r55we_have_live:
        // -----------------------------------------------------------
        // (1) Defensive reset.
        // -----------------------------------------------------------
        mov rax, 1;
        lea rcx, [rip + _r55we_stage];
        mov [rcx], rax;

        call nvme_ctrl_table_reset;
        call nvme_ns_table_reset;
        call r55we_clear;

        // -----------------------------------------------------------
        // (2) Synthetic KIND_PCI_DEV parent (slot 172).
        // -----------------------------------------------------------
        mov rax, 2;
        lea rcx, [rip + _r55we_stage];
        mov [rcx], rax;

        mov rdi, 172;
        mov rsi, 0x30;                    // KIND_PCI_DEV
        mov rdx, 0x21F;                   // R_DEV_ALL | RIGHT_MINT
        mov rcx, 0xFACEFEED;              // synthetic bdf
        call cap_mint_write;

        // -----------------------------------------------------------
        // (3) KIND_NVME_CONTROLLER (slot 173, row 0).
        // -----------------------------------------------------------
        mov rax, 3;
        lea rcx, [rip + _r55we_stage];
        mov [rcx], rax;

        mov rdi, 172;                     // parent_slot (KIND_PCI_DEV)
        mov rsi, 0x61F;                   // R_NVMEC_ALL
        xor rdx, rdx;                     // ctrl_idx = 0
        mov rcx, 0x400000;                // bar0_pa (synthetic)
        call nvme_ctrl_cap_mint_inner;
        cmp rax, 0;                       // expect row 0
        jne r55we_fail_stage;

        mov rdi, 173;
        mov rsi, 0x198;                   // KIND_NVME_CONTROLLER
        mov rdx, 0x61F;
        xor rcx, rcx;                     // target_ptr = ctrl_row_id = 0
        call cap_mint_write;

        // -----------------------------------------------------------
        // (4) Dual-kind KIND_NVME_NAMESPACE/KIND_BLKDEV (slots
        // 174/175, row 0). nsid=1 aligns with pdxfs_block_write's
        // own downstream bdev_write_at nsid=1 hardcode.
        // -----------------------------------------------------------
        mov rax, 4;
        lea rcx, [rip + _r55we_stage];
        mov [rcx], rax;

        sub rsp, 32;
        mov rax, 1;
        mov [rsp + 0], rax;                // nsid
        mov rax, 4096;
        mov [rsp + 8], rax;                // lba_size
        mov rax, 100;
        mov [rsp + 16], rax;               // block_count
        xor rax, rax;
        mov [rsp + 24], rax;               // parent_ctrl_row = 0
        mov rdi, 174;                      // ns_slot
        mov rsi, 175;                      // blk_slot
        mov rdx, 173;                      // parent_slot (KIND_NVME_CONTROLLER)
        mov rcx, 0x41F;                    // ns_rights (R_NVMEN_ALL)
        mov r8,  0x1F;                     // blk_rights (R_BLK_ALL)
        mov r9,  rsp;                      // params_ptr
        call nvme_ns_dual_kind_mint;
        add rsp, 32;
        cmp rax, 0;                        // expect row 0
        jne r55we_fail_stage;

        // -----------------------------------------------------------
        // (5) mount_pdxfs_block(cap_slot=176, bdev_cap=175,
        //     uuid_hint_lo=0, uuid_hint_hi=0). Under the LIVE gate
        // the mount MUST succeed (rax < 8 == MOUNT_MAX).
        // -----------------------------------------------------------
        mov rax, 5;
        lea rcx, [rip + _r55we_stage];
        mov [rcx], rax;

        mov rdi, 176;                      // cap_slot (KIND_VOLUME target)
        mov rsi, 175;                      // bdev_cap
        xor rdx, rdx;                      // uuid_hint_lo = 0 (no hint)
        xor rcx, rcx;                      // uuid_hint_hi = 0 (no hint)
        call mount_pdxfs_block;

        cmp rax, 8;
        jae r55we_fail_stage;

        // -----------------------------------------------------------
        // (6) sb_read(175) -> sb_ptr. Verify >= KERNEL_VMA_BASE via
        // r10-staged compare.
        // -----------------------------------------------------------
        mov rax, 6;
        lea rcx, [rip + _r55we_stage];
        mov [rcx], rax;

        mov rdi, 175;
        call sb_read;
        mov r10, 0xFFFF800000000000;       // KERNEL_VMA_BASE
        cmp rax, r10;
        jb r55we_fail_stage;
        mov r12, rax;                      // r12 = sb_ptr

        // -----------------------------------------------------------
        // (7) sb_flags(sb_ptr) -> flags. Extract bit 0 (PDXB_SB_FLAG_
        // CLEAN_UNMOUNT). rax holds the extracted bit for the branch.
        // -----------------------------------------------------------
        mov rax, 7;
        lea rcx, [rip + _r55we_stage];
        mov [rcx], rax;

        mov rdi, r12;
        call sb_flags;
        and rax, 1;                        // extract bit 0
        cmp rax, 0;
        je r55we_phase1;                   // bit CLEAR -> phase 1 arm

        // -----------------------------------------------------------
        // (8) LIVE bit-SET arm: this is phase 2 (persisted volume
        // from a prior boot's clean umount). Re-seed itable via
        // itable_init (sb_ptr in r12 still live), then inode_read
        // to fetch inode 2's row, extract extent[0] data LBA, read
        // the LBA back into readback_scratch, byte-compare against
        // the expected payload qwords.
        // -----------------------------------------------------------
        mov rax, 8;
        lea rcx, [rip + _r55we_stage];
        mov [rcx], rax;

        // (8a) itable_init(sb_ptr). Returns 0 unconditionally; no
        // status check needed (see itable_init header). Seeds
        // _itable_state so the subsequent inode_read succeeds.
        mov rdi, r12;                      // sb_ptr
        call itable_init;

        // (8b) inode_read(bdev_cap=175, ino=2) -> inode_ptr (into
        // _itable_row_scratch, cross-module -- .o boundary crossed
        // via the return-value pointer path, not a direct symbol
        // reference from this .o, matching cow_write.pdx §"Cross-
        // module scratch access"). Sentinel-band values are < 2^32
        // (INODE_INVALID_INDEX / ALLOC_BITMAP_TORN / INODE_HEADER_
        // INUSE_BAD all in 0xFFFFED1x band); a valid inode_ptr is
        // >= KERNEL_VMA_BASE.
        mov rdi, 175;                      // bdev_cap
        mov rsi, 2;                        // ino
        call inode_read;
        mov r10, 0xFFFF800000000000;       // KERNEL_VMA_BASE
        cmp rax, r10;
        jb r55we_fail_stage;               // any sentinel -> fail
        mov r13, rax;                      // r13 = inode_ptr

        // (8c) Zero readback_scratch first two qwords -- poison the
        // compare cells so a stale buffer cannot false-positive.
        lea rax, [rip + _r55we_readback_scratch];
        xor rcx, rcx;
        mov [rax + 0], rcx;
        mov [rax + 8], rcx;

        // (8d) Extract data_lba from inode.extent[0] (offset +48).
        // Packed as (granted_len << 48) | start_lba; low 48 bits =
        // start_lba (see allocator.pdx §"Extent slot 0 stamping").
        // Mask via r10-staged 0x0000FFFFFFFFFFFF.
        mov rax, [r13 + 48];
        mov r10, 0x0000FFFFFFFFFFFF;
        and rax, r10;
        mov rsi, rax;                      // lba -> rsi (arg2 for nvme_read_blocking)

        // (8e) nvme_read_blocking(nsid=1, lba=rsi, count=1,
        //                          buf_pa=&_r55we_readback_scratch).
        mov rdi, 1;                        // nsid = 1
        mov rdx, 1;                        // count = 1 block
        lea rcx, [rip + _r55we_readback_scratch];  // buf_pa
        call nvme_read_blocking;
        cmp rax, 0;
        jne r55we_fail_stage;

        // (8f) Compare readback_scratch[0..7] against expected qword 0
        // = 0x6F77206F6C6C6568 (little-endian "hello wo").
        lea rax, [rip + _r55we_readback_scratch];
        mov rax, [rax + 0];
        mov r10, 0x6F77206F6C6C6568;
        cmp rax, r10;
        jne r55we_fail_stage;

        // (8g) Compare readback_scratch[8..15] against expected qword 1
        // = 0x0000006E5C646C72 (little-endian "rld\n" + 3 zero pad).
        lea rax, [rip + _r55we_readback_scratch];
        mov rax, [rax + 8];
        mov r10, 0x0000006E5C646C72;
        cmp rax, r10;
        jne r55we_fail_stage;

        // (8h) Payload matches -- emit tag_pdxb_persist_ok exactly
        // once via klog_s1 (no k=v pairs; the payload literal is
        // baked into the tag string itself).
        mov rdi, 3;                        // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_pdxb_persist_ok];
        call klog_s1;

        call r55we_clear;
        call nvme_ctrl_table_reset;
        call nvme_ns_table_reset;
        xor rax, rax;
        jmp r55we_out;

      r55we_phase1:
        // -----------------------------------------------------------
        // LIVE bit-CLEAR arm: this is phase 1 (freshly-mkfs'd volume
        // that has not yet been through a clean-umount + reboot
        // cycle). Stage the 13-byte payload into payload_scratch as
        // two qwords, then call pdxfs_block_write which itself emits
        // tag_pdxb_write_ok (cow_write.pdx step 14) on success --
        // that emit IS the phase-1 fingerprint, no additional tag
        // from this witness.
        // -----------------------------------------------------------
        mov rax, 9;
        lea rcx, [rip + _r55we_stage];
        mov [rcx], rax;

        // (9a) Stage payload qword 0 = 0x6F77206F6C6C6568.
        mov r10, 0x6F77206F6C6C6568;
        lea rax, [rip + _r55we_payload_scratch];
        mov [rax + 0], r10;

        // (9b) Stage payload qword 1 = 0x0000006E5C646C72.
        mov r10, 0x0000006E5C646C72;
        lea rax, [rip + _r55we_payload_scratch];
        mov [rax + 8], r10;

        // (9c) pdxfs_block_write(vol_row=0, ino=2, offset=0, len=13,
        //                         in_pa=&_r55we_payload_scratch).
        // vol_row=0 per module header §"vol_row = 0 (hardcoded)";
        // ino=2 per ticket; offset=0/len=13 satisfy the M2-004
        // arg-gate (0 < len <= 4096, offset == 0). Success (rax == 0)
        // means the composed 11-step flow completed AND the step-14
        // klog_s1_x3 emit fired tag_pdxb_write_ok with ino/offset/len
        // k=v pairs -- that emit is the phase-1 golden fingerprint.
        xor rdi, rdi;                      // vol_row = 0
        mov rsi, 2;                        // ino = 2
        xor rdx, rdx;                      // offset = 0
        mov rcx, 13;                       // len = 13
        lea r8,  [rip + _r55we_payload_scratch]; // in_pa
        call pdxfs_block_write;
        cmp rax, 0;
        jne r55we_fail_stage;

        call r55we_clear;
        call nvme_ctrl_table_reset;
        call nvme_ns_table_reset;
        xor rax, rax;
        jmp r55we_out;

      r55we_fail_stage:
        // Silent fail: no OK-token emit, no additional tag. Cleanup
        // and return 1 -- the phase golden fails at the missing
        // ok-line rather than a spurious extra fail-line.
        call r55we_clear;
        call nvme_ctrl_table_reset;
        call nvme_ns_table_reset;
        mov rax, 1;

      r55we_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
