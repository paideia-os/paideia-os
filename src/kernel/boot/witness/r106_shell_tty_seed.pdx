// src/kernel/boot/witness/r106_shell_tty_seed.pdx -- R106.SHELL (paideia-os #2425)
//
// Boot-time seed of the KIND_TTY row the interactive shell (and any
// other userspace tool that declares KIND_TTY(write) in its caps.decl)
// can be handed at load time through the _init_caps sidecar.
//
// The blocker paideia-os#2425 exists to remove: kind_tty.pdx's mint
// gate requires a KIND_IPC_ENDPOINT parent, and until this landing the
// only holders of that shape were three kernel boot witnesses
// (r66v2_tty_raw.pdx, r89_tui_canvas.pdx, r90_tty_termios.pdx). A
// delegated ring-3 shell had no path to acquire a stdin/stdout sink.
//
// TWO PIECES LAND TOGETHER for #2425:
//
//   1. cap/kind.pdx adds KIND_TTY (0x197) to KIND_SEEDABLE_TABLE and
//      bumps KIND_SEEDABLE_COUNT 5 -> 6. init_caps_validate (through
//      kind_is_loader_seedable) now accepts a sidecar row naming
//      KIND_TTY. tools/verify-user-cap-sidecars.sh already policed
//      "every declared kind is seedable" -- with the table widened, a
//      shell caps.decl carrying KIND_TTY(write) links clean and the
//      loader stops refusing it as INIT_CAPS_BAD_KIND at spawn.
//
//   2. This file mints ONE persistent KIND_TTY row on the ordinary
//      boot cascade (via tty_cap_mint_inner over a synthetic KIND_IPC
//      _ENDPOINT parent -- same shape r66v2_tty_raw.pdx uses) and
//      publishes it as a live cap in cap_table slot 129 so a
//      downstream reader (verify-user-cap-sidecars.sh, a debugger
//      dumping cap_table, or the future per-task cspace migration
//      pass) sees the row is actually present after boot rather than
//      only accepted-by-the-table on paper.  The row is DELIBERATELY
//      not revoked -- persistence IS the seed property the issue is
//      filed to establish (mirror of the r100_tls_trust.pdx "row
//      stays live -- kernel_main's tls_trust_table_reset at boot
//      handles teardown" posture).
//
// =============================================================================
// PREREQUISITES THIS FILE MINTS (all private, torn down only on failure)
// =============================================================================
//
//   Cap slot 128 -- synthetic KIND_IPC_ENDPOINT parent, existing only
//     to satisfy tty_check_parent_endpoint (kind_tty.pdx).  Free by
//     construction: tree-wide grep of src/kernel/boot/witness/ and
//     src/kernel/ (2026-09-12) confirms no other cascade-reachable
//     file names slot 128 -- the R30 hid_event fixture owns 118..123,
//     the r89/r90/r100 cluster owns 121..127, r103 owns 132..134,
//     r91 owns 126..127.  Nothing between witness_r90_tty_termios
//     (this witness's immediate predecessor in the cascade) and this
//     call site touches slot 128.
//
//   Cap slot 129 -- KIND_TTY(0x197) + R_TTY_ALL(0x69A), target_ptr =
//     the KIND_TTY row_id returned by tty_cap_mint_inner.  Same
//     free-by-construction argument as slot 128.  This is the live
//     cap the future migration hands to the shell task.  For the
//     present boot cascade it serves as the observability handle
//     ("cap_table[129].kind == KIND_TTY, target_ptr in [0,15]")
//     confirming the seeded row is reachable by ordinal.
//
// =============================================================================
// ORACLE: kind_is_loader_seedable(KIND_TTY) MUST answer 1
// =============================================================================
//
// The witness's Stage 0 calls kind_is_loader_seedable(0x197) BEFORE
// touching cap_table, so a build that accidentally reverted the
// KIND_SEEDABLE_TABLE half of #2425 fails here loudly rather than
// spawning the shell and getting INIT_CAPS_BAD_KIND at load time --
// exactly the failure mode #1597's build-time gate exists to make
// loud, but scoped to this specific kind so a downstream regression
// in the table's own contents is caught even before verify-user-cap-
// sidecars.sh runs.
//
// =============================================================================
// FINGERPRINT
// =============================================================================
//
// Success: "boot kind_tty seed ok -- row=<idx> fd=0" (klog_s1_d2 with
//   k_row + k_fd, both decimal).  fd=0 names the POSIX stdin
//   convention every shell inherits -- the shell's line_reader.pdx
//   (paideia-os/shell#46) reads its first byte from that fd.  <idx>
//   is the KIND_TTY row_id tty_cap_mint_inner returned; a shell
//   sidecar row is expected to name the same integer.
//
//   Deliberately all-lowercase with no bracketed "[legacy: ... OK]"
//   suffix -- follows r66v2_tty_raw.pdx / r89_tui_canvas.pdx's
//   brand-new-narrative-tag posture: the string carries no standalone
//   uppercase "OK" token, so tools/verify-fingerprint-coverage.sh's
//   OK_TOK extractor skips it and no allowlist entry or golden line
//   is required.
//
// Failure: "boot kind_tty seed fail line=<N>" (klog_s1_d1), with the
//   stage number stamped into _shts_stage before every step so the
//   emitted line names exactly which sub-test tripped.
//
// =============================================================================
// ENCODER DISCIPLINE
// =============================================================================
//
// No `test rN,rN` (every zero test loads 0 into a register then cmp).
// No `and rN, imm64` (never used).  No 2-op `imul r,imm` (never used).
// No `cmp reg, [mem]` (every memory value is loaded to a register
// first).  Fingerprint tag sizes include the trailing NUL byte per
// #699 discipline.  Every label prefixed `shts_` -- grep audit
// (2026-09-12) confirms no other file in src/kernel/ uses that prefix.

module R106ShellTtySeed = structure {

  pub let mut _shts_stage : u64 = 0

  // 24 chars "boot kind_tty seed ok --" + NUL = 25 bytes.
  pub let tag_boot_kind_tty_seed_ok : [u8; 25] = "boot kind_tty seed ok --\0"
  // 23 chars "boot kind_tty seed fail" + NUL = 24 bytes.
  pub let shts_fail_msg             : [u8; 24] = "boot kind_tty seed fail\0"

  // Mint a synthetic KIND_IPC_ENDPOINT parent at the given cap slot.
  // Mirrors r66v2_tty_raw.pdx's ttyr_ep and r89_tui_canvas.pdx's
  // tuiw_ep one-for-one. rdi (slot) is untouched by the rsi/rdx/rcx
  // setup below, so it survives into the tail call to cap_mint_write.
  pub let shts_ep : (u64) -> () !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R106.SHELL (paideia-os #2425): mint a synthetic KIND_IPC_ENDPOINT parent for the KIND_TTY mint gate (tty_check_parent_endpoint only checks kind). R_IPC_ALL (0x00B) rights; target_ptr = 0x2425 (issue number, arbitrary nonzero id). Mirrors r66v2_tty_raw.pdx ttyr_ep exactly. cap_mint_write is a leaf function with no prologue, no nested calls and no rsp-alignment prerequisite, so this helper's non-16-aligned call site (entry rsp%16 == 8, no pushes) is safe -- same shape r66v2 already ships. Labels prefixed shts_e_.",
      block: {
        mov rsi, 5;                      // KIND_IPC_ENDPOINT
        mov rdx, 0x00B;                  // R_IPC_ALL
        mov rcx, 0x2425;                 // target_ptr = issue number
        call cap_mint_write;
        ret
      }
    }

  // Scrub cap slots 128 (parent ep) and 129 (KIND_TTY cap) back to
  // (0,0,0). Called ONLY on failure -- the success path leaves both
  // slots live so the seeded row and its parent chain remain
  // queryable for the rest of the boot.
  pub let shts_clear_slots : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R106.SHELL (paideia-os #2425): scrub cap_table slots 128 (KIND_IPC_ENDPOINT parent) and 129 (KIND_TTY cap) back to (0,0,0) on failure. Success path deliberately leaves both live -- persistence is the seed property #2425 is filed to establish. Two cap_mint_write calls with zero (kind, rights, target_ptr). Same leaf-safe posture as shts_ep. Labels prefixed shts_c_.",
      block: {
        mov rdi, 128;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        mov rdi, 129;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        ret
      }
    }

  // witness_r106_shell_tty_seed() -> ()
  //
  // Five callee-save pushes (rbx, r12-r15) leave rsp%16 == 0 for every
  // nested call (entry rsp%16 == 8, +40 -> %16 == 0), matching every
  // sibling witness in boot_continue_after_ring3. Register plan (all
  // callee-save, survive every nested call by SysV convention):
  //   r12 = KIND_TTY row_id (persistent -- returned by tty_cap_mint_
  //         inner, published into cap_table[129].target_ptr, carried
  //         into the fingerprint's row= KV).
  //   rbx, r13, r14, r15 = reserved / unused at this landing (kept
  //         pushed for prologue-arity uniformity with the sibling
  //         witnesses, and as scratch for any future stage additions).
  pub let witness_r106_shell_tty_seed : () -> () !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R106.SHELL (paideia-os #2425): boot-time seed of a persistent KIND_TTY row bound to shell stdin (fd 0) plus a live KIND_TTY cap at cap_table[129] over it. Stage plan: (0) kind_is_loader_seedable(KIND_TTY) oracle -- expects 1; (1) scrub slots 128+129 for a re-run-safe start, then mint synthetic KIND_IPC_ENDPOINT parent at slot 128; (2) tty_cap_mint_inner(parent=128, rights=R_TTY_ALL, tty_id=2425, rows=24, cols=80) -> r12=row_id, expect row_id in [0,15]; (3) cap_mint_write(slot=129, kind=KIND_TTY=0x197, rights=R_TTY_ALL=0x69A, target_ptr=row_id) so the seeded row is reachable by ordinal; (4) emit 'boot kind_tty seed ok -- row=<idx> fd=0'. Row is DELIBERATELY not revoked -- persistence IS the seed property #2425 exists to establish (mirror of r100_tls_trust.pdx's own row-stays-live posture; kernel_main's tty_table_reset at boot handles teardown across reboots). Five callee-save pushes (rbx, r12-r15) leave rsp%16 == 0 for every nested call (entry rsp%16 == 8, +40 = %16 == 0). Capabilities/effects: kind_is_loader_seedable is !{mem} @{} (leaf, no authority); cap_mint_write and tty_cap_mint_inner both need @{cap}; klog_s1_d1/klog_s1_d2 need !{sysreg, mem}. 'boot' is added per this cascade's own witness-function convention (r66v2_tty_raw.pdx). On any failure, _shts_stage is stamped first so the failure klog line names the tripping sub-test; failure falls through to shts_clear_slots + return, matching r66v2_tty_raw.pdx's identical failure shape. Labels prefixed shts_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // ---------- Stage 0: oracle -- KIND_TTY must be loader-seedable ----------
        xor rax, rax;
        lea rcx, [rip + _shts_stage];
        mov [rcx], rax;
        mov rdi, 0x197;                  // KIND_TTY
        call kind_is_loader_seedable;
        cmp rax, 1;
        jne shts_fail_stage;

        // ---------- Stage 1: reset + mint synthetic KIND_IPC parent ----------
        mov rax, 1;
        lea rcx, [rip + _shts_stage];
        mov [rcx], rax;
        call shts_clear_slots;
        mov rdi, 128;
        call shts_ep;

        // ---------- Stage 2: mint the persistent KIND_TTY row ----------
        mov rax, 2;
        lea rcx, [rip + _shts_stage];
        mov [rcx], rax;
        mov rdi, 128;                    // parent_slot
        mov rsi, 0x69A;                  // R_TTY_ALL
        mov rdx, 2425;                   // tty_id (issue number, nonzero)
        mov rcx, 24;                     // rows (VT100 default)
        mov r8,  80;                     // cols (VT100 default)
        call tty_cap_mint_inner;
        mov r10, 16;                     // TTY_TABLE_ROWS ceiling
        cmp rax, r10;
        jae shts_fail_stage;
        mov r12, rax;                    // r12 = row_id, survives to fingerprint

        // ---------- Stage 3: publish live KIND_TTY cap at cap_table[129] ----------
        mov rax, 3;
        lea rcx, [rip + _shts_stage];
        mov [rcx], rax;
        mov rdi, 129;                    // slot
        mov rsi, 0x197;                  // kind = KIND_TTY
        mov rdx, 0x69A;                  // rights = R_TTY_ALL
        mov rcx, r12;                    // target_ptr = row_id
        call cap_mint_write;

        // ---------- Stage 4: emit 'boot kind_tty seed ok -- row=<idx> fd=0' ----------
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_boot_kind_tty_seed_ok];
        lea rcx, [rip + k_row];
        mov r8, r12;                     // v1 = row_id (decimal)
        lea r9, [rip + k_fd];
        sub rsp, 8;                      // alignment pad for klog_s1_d2 v2 push
        xor rax, rax;                    // v2 = 0 (POSIX stdin fd)
        push rax;                        // 7th arg per klog_s1_d2 ABI
        call klog_s1_d2;
        add rsp, 16;
        jmp shts_witness_done;

      shts_fail_stage:
        mov rdi, 1;                      // LEVEL_ERROR
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + shts_fail_msg];
        lea rcx, [rip + k_line];
        lea rax, [rip + _shts_stage];
        mov r8, [rax];
        call klog_s1_d1;
        call shts_clear_slots;

      shts_witness_done:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
