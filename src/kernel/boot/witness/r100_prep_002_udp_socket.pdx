// src/kernel/boot/witness/r100_prep_002_udp_socket.pdx --
// R100-PREP-002 (paideia-os #2135).
//
// Boot-time witness proving the connected-UDP socket substrate end to
// end.  Mints one KIND_UDP_SOCKET cap via udp_socket_new (root mint,
// no parent needed -- see net/udp_socket.pdx module header: `Root mint
// -- no parent-capability argument, matching sys_open/sys_socket's own
// no-authority-required posture`), resolves the underlying sock_idx
// from cap_table (stride 24, target_ptr @+16), binds to local port
// 5555, connects to _ipv4_my_ip:5555 (SELF-LOOPBACK -- the only
// loopback this tree has today; there is no 127.0.0.0/8 interface,
// same posture r72_tcp_echo takes for TCP), sends one 4-byte datagram
// "PING", receives it, asserts message-boundary preservation
// (recv-returned length == send-passed length == 4) AND byte-for-byte
// payload equality.
//
// PEER IP DISCIPLINE (departure from the naive "loopback = 127.0.0.1"
// intuition): net/udp_socket.pdx's udp_socket_send_body loopback fast
// path is gated on peer_ip == _ipv4_my_ip (byte-for-byte match against
// the 4-byte _ipv4_my_ip global set in net/ipv4.pdx to 10.0.0.2 at
// R27.M4).  A peer of 127.0.0.1 would fall through to the WIRE PATH
// arm which is DEFERRED to R93.M2 (returns len as fake success -- so
// the recv would find an empty rx ring and this witness's length
// assertion would trip).  Encoding the peer as 0x0A000002 in the
// packed-u32 shape udp_socket_connect_body's unpack expects (byte 24
// = high, byte 27 = low: 10, 0, 0, 2) drives the loopback fast path
// which synchronously invokes udp_socket_find_by_local_port +
// udp_socket_deliver_dgram -- by the time udp_socket_send_body
// returns, the datagram is already sitting in our own socket's rx
// ring (local_port == peer_port == 5555 -- the finder returns our
// own socket since it is the only in-use non-CLOSED socket bound to
// 5555, and delivery lands in its own rx ring per the header's
// "recursion depth is bounded at 1 by the enqueue itself" contract).
//
// PORT_A == PORT_B == 5555 (self-loopback with one socket): the
// existing tag_boot_udp_sock_ok fingerprint declared in core/klog/
// keys.pdx carries two decimal KVs (k_port_a, k_port_b) -- with one
// socket both name the same physical port.  Two-socket A->B was the
// original keys.pdx design sketch; single-socket self-loopback
// exercises exactly the same loopback fast path (find_by_local_port
// + deliver_dgram) at less setup cost and with a smaller cap-table
// footprint (one mint instead of two).  If a future round wants two
// distinct ports, the values passed to klog_s1_d2 below become 5555
// / 5556 and the mint + bind + connect stages fork correspondingly.
//
// KIND_MEMORY PARENT SKIPPED (departure from the pdxfs witness idiom):
// r90_xrepo_010_004_pdxfs_undo_write.pdx et al. mint a KIND_MEMORY
// parent at a synthetic slot because sys_pdxfs_txn_open's parent gate
// requires one.  udp_socket_new has no such gate -- it is authority-
// free per its own docstring.  So we skip the parent-mint stage
// entirely; the cap_table slot used by udp_socket_new is whatever its
// free-slot scan picks (typically low), and that slot is not scrubbed
// on exit (matches r72_tcp_echo's "leave the TCB rows allocated"
// posture per net/udp_socket.pdx's own header: `The minted cap and
// socket row persist for the boot; boot witness leaves both
// allocated`).
//
// Sequence witnessed (nine stages; a failure in any stage jumps to
// the skip funnel emitting `boot udp sock skip -- reason=1 stage=<S>`
// via klog_s1_d2, mirroring pxuw_skip's shape exactly):
//
//   (1) udp_socket_new() -> rbx = cap_slot.  Reject any errno-shaped
//       return (>= 256 -- the mint's -ENOBUFS/-ENFILE encode as huge
//       u64s with bit 63 set, easily distinguished from a valid slot
//       index in [0, 256)).
//   (2) Resolve sock_idx from cap_table[cap_slot*24 + 16] into r12.
//       Bounds-check r12 < UDP_SOCKET_MAX (16).
//   (3) udp_socket_bind_body(sock_idx, 5555) must return 0.
//   (4) udp_socket_connect_body(sock_idx, 0x0A000002, 5555) must
//       return 0 -- transitions the socket into CONNECTED, records
//       peer_ip = 10.0.0.2, peer_port = 5555 in the row.
//   (5) udp_socket_send_body(sock_idx, &_r100pep2_ping, 4) must
//       return 4 (bytes-sent == bytes-passed).  Loopback fast path
//       enqueues the "PING" bytes into our own rx ring.
//   (6) udp_socket_recv_body(sock_idx, &_r100pep2_recv, 16) must
//       return 4 -- MESSAGE-BOUNDARY PRESERVATION: exactly one
//       datagram per call, even though the caller's 16-byte buffer
//       has room for 4x that.  A return of 0 would signal an empty
//       ring (loopback fast path failed to deliver); a return of 16
//       would signal boundary-preservation broken (recv coalesced
//       or padded).
//   (7) Byte-compare _r100pep2_recv[0..4] against
//       _r100pep2_ping[0..4] via a single 4-byte compare (loaded
//       as u32 masked from u64) -- must be equal.
//   (8) Emit `boot udp sock ok -- port_a=5555 port_b=5555` via
//       klog_s1_d2(LEVEL_INFO=3, SUBSYS_BOOT, tag_boot_udp_sock_ok,
//       k_port_a, 5555, k_port_b, 5555).  All three tag strings
//       (tag_boot_udp_sock_ok, k_port_a, k_port_b) live in core/
//       klog/keys.pdx already (R100-PREP-002 block at line 1408).
//
// FINGERPRINTS: one on success (`boot udp sock ok -- port_a=5555
// port_b=5555`).  On failure `boot udp sock skip -- reason=1
// stage=<S>` names the tripping stage.  No standalone uppercase "OK"
// token in the tag text so verify-fingerprint-coverage.sh's OK_TOK
// extractor does not gate on it (matching the r89_tui_canvas /
// r100_tls_trust / r100_prep_003_icmp_echo brand-new-tag posture in
// the same keys.pdx block).
//
// PLACEMENT (kernel_main.pdx): after witness_r100_prep_003_icmp_echo
// in the R100-PREP witness block.  The R100-PREP-002 kernel-side
// substrate (net/udp_socket.pdx, #2008) landed independently of the
// R100-PREP-003 ICMP substrate (net/icmp.pdx), and neither UDP nor
// ICMP takes an ordering dependency on the other -- placing this
// witness after ICMP just keeps the R100-PREP block contiguous.
// Depends on the R27 network substrate (_ipv4_my_ip initialization
// in ipv4.pdx) being live, which every witness in the R100-PREP
// block already assumes.
//
// Reserved-label discipline: labels prefixed `wudp_` (witness UDP).
// `loop`, `if` etc. are keywords and never used as labels.
//
// Frame prologue: manual push/pop (same as every other witness_r*.pdx).
// Encoder-conservative: mov / mov_b / xor / and / cmp / je / jne /
// jae / lea / push / pop / call / sub / add / shl / shr / ret only --
// every form already proven in the sibling r100_prep_003_icmp_echo /
// r90_xrepo_010_004_pdxfs_undo_write witnesses.

module R100PrepUdpSocket = structure {

  // ============================================================================
  // Payload + scratch buffers
  // ============================================================================

  // 4-byte "PING" payload (bytes 0x50, 0x49, 0x4E, 0x47).  Stored as
  // a compile-time constant so the send_body's rep_movsb has a
  // stable source; the recv_body will copy exactly these bytes back
  // to _r100pep2_recv via its own rep_movsb.
  pub let _r100pep2_ping : [u8; 4] = [ 80u8, 73u8, 78u8, 71u8 ]

  // 16-byte recv scratch.  Larger than the 4-byte send payload so
  // the MSG_TRUNC / message-boundary discipline is exercised: recv
  // MUST return exactly 4 (the actual datagram length), not 16
  // (the buffer capacity) -- the excess 12 bytes would only be
  // touched by a broken recv that padded to len.  Aligned @8 so the
  // stage-7 byte compare can read the first 4 bytes as a masked
  // u64 load without an alignment fault.
  pub let mut _r100pep2_recv : [u8; 16] = uninit @align(8)

  // ============================================================================
  // Skip-path fingerprint tag + KV keys (locally scoped -- no other
  // witness needs them, and the text carries no standalone uppercase
  // OK token so verify-fingerprint-coverage.sh's OK_TOK extractor
  // does not gate on it).  Byte counts NUL-inclusive per #699
  // discipline:
  //   wudp_skip_msg   = "boot udp sock skip " -> 19 chars + NUL = 20
  //   wudp_k_reason   =                          6 chars + NUL =  7
  //   wudp_k_stage    =                          5 chars + NUL =  6
  // ============================================================================
  pub let wudp_skip_msg : [u8; 20] = "boot udp sock skip \0"
  pub let wudp_k_reason : [u8;  7] = "reason\0"
  pub let wudp_k_stage  : [u8;  6] = "stage\0"

  // ============================================================================
  // Named constants (documentation; the values are inlined at every
  // use site since paideia-as does not fold cross-module constants,
  // same posture UdpSocket takes for its own KIND_UDP_SOCKET=0x1A8).
  // ============================================================================
  pub let WUDP_LOCAL_PORT   : u64 = 5555
  pub let WUDP_PEER_PORT    : u64 = 5555
  pub let WUDP_PEER_IP      : u64 = 0x0A000002   // 10.0.0.2, packed MSB-first
  pub let WUDP_PAYLOAD_LEN  : u64 = 4
  pub let WUDP_RECV_CAP     : u64 = 16
  pub let WUDP_SOCK_MAX     : u64 = 16           // matches UDP_SOCKET_MAX

  // ============================================================================
  // witness_r100_prep_002_udp_socket() -> ()
  // ============================================================================
  //
  // Register plan (5 callee-save pushes -- entry rsp%16==8, 5 pushes
  // = 40 bytes, (8+40)%16 == 0, aligned for every nested call
  // udp_socket_new / udp_socket_bind_body / udp_socket_connect_body /
  // udp_socket_send_body / udp_socket_recv_body / klog_s1_d2):
  //   rbx = cap_slot (survives every stage; used for the sock_idx
  //         resolution at stage 2 and the eventual cleanup-free
  //         path if one is added in a later round).
  //   r12 = sock_idx (survives stages 3..7 for every body call).
  //   r13 = unused today (present for the fixed 5-push shape every
  //         sibling witness in this cascade takes; reserved for
  //         future assertion state, e.g. rx_count snapshot).
  //   r14 = current stage code (1..8) for the skip funnel.  Named
  //         identically to r90_xrepo_010_004_pdxfs_undo_write.pdx's
  //         own r14 stage-counter so an eyeballing of skip lines
  //         across witnesses reads uniformly.
  //   r15 = unused today (pushed for alignment symmetry with the
  //         r90_xrepo pattern; reserved for future scratch).
  //
  // klog_s1_d2 emit alignment: from rsp%16 == 0 after the 5 pushes,
  // `sub rsp, 8` -> %16==8, then `push v2` (5555 or stage) -> %16==0
  // (call-site aligned), then `add rsp, 16` unwinds pad + pushed v2.
  // Identical shape pxuw_skip uses one file over.

  pub let witness_r100_prep_002_udp_socket : () -> () !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R100-PREP-002 (paideia-os #2135): boot witness for the connected-UDP socket substrate (net/udp_socket.pdx, #2008). Five callee-save pushes (rbx=cap_slot, r12=sock_idx, r13=unused pad, r14=stage counter, r15=unused pad) leave rsp%16 == 0 for every nested call from entry rsp%16 == 8 SysV (matches every sibling witness in this cascade). One end-to-end scenario in one boot: udp_socket_new (root mint, no parent required -- see file header) -> resolve sock_idx from cap_table[slot*24+16] (stride 24 per cap/mint.pdx; used by every derived-kind file in this tree) -> udp_socket_bind_body(sock, 5555) -> udp_socket_connect_body(sock, 0x0A000002, 5555) [peer_ip = _ipv4_my_ip = 10.0.0.2, packed MSB-first per udp_socket_connect_body's unpack; NOT 127.0.0.1, see file header on why the tree has no 127/8 interface] -> udp_socket_send_body(sock, &_r100pep2_ping, 4) [loopback fast path enqueues into our own rx ring; local_port == peer_port == 5555 -- the finder returns our own socket] -> udp_socket_recv_body(sock, &_r100pep2_recv, 16) must return exactly 4 (MESSAGE-BOUNDARY PRESERVATION: caller's 16-byte buffer does NOT coalesce or pad; excess capacity discarded per MSG_TRUNC posture) -> byte-compare _r100pep2_recv[0..4] against _r100pep2_ping[0..4] via masked u64 load. Any deviation jumps to the skip funnel emitting `boot udp sock skip -- reason=1 stage=<S>` via klog_s1_d2. All-green emits `boot udp sock ok -- port_a=5555 port_b=5555` via klog_s1_d2 -- the R100-PREP-002 fingerprint declared in core/klog/keys.pdx (tag_boot_udp_sock_ok + k_port_a + k_port_b, R100-PREP-002 block). Bypasses the sys_socket / sys_bind / sys_connect / sys_send / sys_recv dispatch shims (boot context runs in ring 0 before any ring-3 process exists, matching r72_tcp_echo's identical posture). Effects/capabilities: {sysreg,mem}@{boot,cap} matches every network-touching witness in this cascade (sysreg transitive via klog_s1_d2's TSC read, mem for every row touch, boot for the fingerprint, cap for udp_socket_new's cap_mint_write). Encoder-conservative: mov / mov_b / xor / and / cmp / je / jne / jae / lea / push / pop / call / sub / add / shl / shr / ret only -- every form already proven in the sibling r100_prep_003_icmp_echo / r90_xrepo_010_004 witnesses. Labels prefixed wudp_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // ==================================================================
        // (1) Mint the UDP socket cap (root mint -- no parent required).
        //     Any errno-shaped return encodes as huge u64 (>= 256);
        //     a valid cap slot is in [0, 256).
        // ==================================================================
        mov r14, 1;                        // stage 1
        call udp_socket_new;
        mov r10, 256;                      // cap_table capacity
        cmp rax, r10;
        jae wudp_skip;
        mov rbx, rax;                      // rbx = cap_slot

        // ==================================================================
        // (2) Resolve sock_idx from cap_table.  Row stride is 24 bytes:
        //     addr = cap_table + slot*24 = cap_table + (slot<<3) + (slot<<4)
        //     Then target_ptr sits at @+16 in every phase1_capability
        //     record (see cap/descriptor.pdx).
        // ==================================================================
        mov r14, 2;                        // stage 2
        mov rax, rbx;
        shl rax, 3;                        // slot * 8
        mov rcx, rbx;
        shl rcx, 4;                        // slot * 16
        add rax, rcx;                      // slot * 24
        lea rdx, [rip + cap_table];
        add rdx, rax;                      // row ptr
        mov r12, [rdx + 16];               // sock_idx = target_ptr

        // Bounds-check sock_idx < UDP_SOCKET_MAX (16).  A negative /
        // huge u64 would trip here; a valid alloc returns 0..15.
        mov r10, 16;
        cmp r12, r10;
        jae wudp_skip;

        // ==================================================================
        // (3) Bind to local port 5555 -- CLOSED -> BOUND transition.
        //     udp_socket_bind_body returns 0 on success, -EINVAL
        //     (0xFFFFFFFFFFFFFFEA) on state error or port==0.
        // ==================================================================
        mov r14, 3;                        // stage 3
        mov rdi, r12;                      // sock_idx
        mov rsi, 5555;                     // WUDP_LOCAL_PORT
        call udp_socket_bind_body;
        cmp rax, 0;
        jne wudp_skip;

        // ==================================================================
        // (4) Connect to _ipv4_my_ip:5555 (10.0.0.2:5555, packed MSB-first
        //     as 0x0A000002 for udp_socket_connect_body's unpack).
        //     BOUND -> CONNECTED transition; no packet is transmitted
        //     (UDP is connectionless -- "connect" is purely a record of
        //     the default send peer).
        // ==================================================================
        mov r14, 4;                        // stage 4
        mov rdi, r12;                      // sock_idx
        mov rsi, 0x0A000002;               // WUDP_PEER_IP = 10.0.0.2 packed
        mov rdx, 5555;                     // WUDP_PEER_PORT
        call udp_socket_connect_body;
        cmp rax, 0;
        jne wudp_skip;

        // ==================================================================
        // (5) Send "PING" (4 bytes) via the loopback fast path.
        //     udp_socket_send_body returns len on success (message
        //     boundaries preserved: exactly one datagram per call, no
        //     coalescing).
        // ==================================================================
        mov r14, 5;                        // stage 5
        mov rdi, r12;                      // sock_idx
        lea rsi, [rip + _r100pep2_ping];   // buf_ptr
        mov rdx, 4;                        // WUDP_PAYLOAD_LEN
        call udp_socket_send_body;
        cmp rax, 4;
        jne wudp_skip;

        // ==================================================================
        // (6) Receive one datagram into the 16-byte scratch.  MUST
        //     return exactly 4 (MESSAGE-BOUNDARY PRESERVATION): the
        //     caller's 16-byte buffer has room for 4x the payload, but
        //     recv delivers exactly one datagram at its actual length
        //     regardless.  A return of 0 -> empty ring (loopback fast
        //     path failed).  A return of 16 -> boundary-preservation
        //     broken.
        // ==================================================================
        mov r14, 6;                        // stage 6
        mov rdi, r12;                      // sock_idx
        lea rsi, [rip + _r100pep2_recv];   // buf_ptr (kernel-space)
        mov rdx, 16;                       // WUDP_RECV_CAP
        call udp_socket_recv_body;
        cmp rax, 4;
        jne wudp_skip;

        // ==================================================================
        // (7) Byte-compare _r100pep2_recv[0..4] against _r100pep2_ping
        //     [0..4].  Both buffers are @8-aligned so a single 8-byte
        //     load lets us mask the low 4 bytes for a single cmp
        //     (the high 4 bytes of the recv scratch are undefined
        //     .bss zero -- untouched by a well-behaved recv -- while
        //     the ping constant's high 4 bytes read as whatever
        //     follows the [u8;4] in .rodata; mask them out).
        // ==================================================================
        mov r14, 7;                        // stage 7
        lea r8, [rip + _r100pep2_recv];
        lea r9, [rip + _r100pep2_ping];
        mov rax, [r8 + 0];                 // recv[0..8]
        mov rcx, [r9 + 0];                 // ping[0..8]
        mov r10, 0xFFFFFFFF;               // low-4-bytes mask
        and rax, r10;
        and rcx, r10;
        cmp rax, rcx;
        jne wudp_skip;

        // ==================================================================
        // (8) Emit success fingerprint:
        //       `boot udp sock ok -- port_a=5555 port_b=5555`
        //     via klog_s1_d2 (2 decimal KVs).  v2 (port_b) is stack-
        //     passed at [rsp+8] per klog_s1_d2's caller-push contract:
        //     `sub rsp, 8` aligns %16 -> 8, then `push port_b` -> %16
        //     == 0 for the call, `add rsp, 16` undoes both.
        // ==================================================================
        mov r14, 8;                        // stage 8 (informational)
        mov rdi, 3;                        // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_boot_udp_sock_ok];
        lea rcx, [rip + k_port_a];
        mov r8, 5555;                      // v1 = port_a
        lea r9, [rip + k_port_b];
        sub rsp, 8;                        // alignment pad
        mov rax, 5555;                     // v2 = port_b
        push rax;
        call klog_s1_d2;
        add rsp, 16;
        jmp wudp_done;

      wudp_skip:
        // Skip funnel.  reason=1 today (single failure class);
        // stage=<r14> names which of stages 1..7 tripped.  Emits
        // `boot udp sock skip -- reason=1 stage=<S>` via klog_s1_d2.
        // Same v2-caller-push alignment shape as the success path.
        mov rdi, 3;                        // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + wudp_skip_msg];
        lea rcx, [rip + wudp_k_reason];
        mov r8, 1;                         // v1 = reason
        lea r9, [rip + wudp_k_stage];
        sub rsp, 8;                        // alignment pad
        push r14;                          // v2 = stage
        call klog_s1_d2;
        add rsp, 16;

      wudp_done:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
