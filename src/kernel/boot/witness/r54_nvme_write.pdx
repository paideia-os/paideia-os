// src/kernel/boot/witness/r54_nvme_write.pdx — R54.M1-001 (#1778)
//
// Real-HW smoke witness for nvme_write_blocking (OPC=0x01).
//
// -----------------------------------------------------------------------------
// What this witness proves
// -----------------------------------------------------------------------------
//
//   (A) The `r54_nvme_write_witness` symbol links into build/kernel.elf
//       and is reachable as a `call r54_nvme_write_witness` target from
//       GDB or from a future kernel_main wire-up on real hardware.
//
//   (B) When invoked in a boot posture that has a live NVMe SQ pair
//       (nvme_probe -> nvme_create_all_io_cqs / _sqs succeeded and
//       `_nvme_io_queue_count > 0`), the witness performs a full
//       write/read round-trip:
//         (1) stage a 64-bit pattern into `_r54w_write_buf[0]`,
//         (2) `nvme_write_blocking(nsid=1, lba=0x10, count=1,
//              buf_pa=&_r54w_write_buf)` — expect status == 0,
//         (3) zero the readback buffer,
//         (4) `nvme_read_blocking(nsid=1, lba=0x10, count=1,
//              buf_pa=&_r54w_read_buf)` — expect status == 0,
//         (5) `cmp _r54w_write_buf[0], _r54w_read_buf[0]` — expect equal,
//         (6) emit the two OK fingerprints (NVME WRITE OK, NVME READBACK
//              OK) in that order.
//
//   (C) When invoked in a substrate posture (`_nvme_io_queue_count == 0`,
//       which is every current QEMU-TCG -kernel boot mode: MCFG absent
//       -> `_pci_device_count == 0` -> `_nvme_device_count == 0` even
//       with `-device nvme` attached, per drivers/nvme/probe.pdx's own
//       drain-empty guard), the witness short-circuits with a SKIP line
//       BEFORE calling nvme_write_blocking, preventing a stray memcpy
//       into a zero `sq_pa` (a boot-critical page hazard). This
//       protective path fires only if the witness is invoked via GDB in
//       an unhealthy state; the witness is deliberately NOT wired into
//       the default `kernel_main` chain, matching pdxfs_lite_e2e_
//       witness's precedent (its own header §"Wire posture at R25.M7").
//
// -----------------------------------------------------------------------------
// What this witness does NOT prove
// -----------------------------------------------------------------------------
//
//   - Multi-block / PRP-list writes (mkfs / pkg install traffic > 4 KiB).
//     Composes with `nvme_io_build_and_submit_one` (mdts.pdx) — R55+.
//   - Persistence across reboot. Full E2E recipe lives at
//     tools/pdxfs-lite-e2e-smoke.md § write-verify path, gated on this
//     symbol landing AND the driver-attach ceremony surfacing a real
//     bdev on the default boot path.
//
// -----------------------------------------------------------------------------
// Fingerprint dictionary
// -----------------------------------------------------------------------------
//
//   Probe banner: "NVME WRITE PROBE nsid=1 lba=0x0000000000000010 count=1\n"
//   Write ok:     "NVME WRITE OK\n"
//   Readback ok:  "NVME READBACK OK\n"
//   Skip:         "NVME WRITE SKIP not-live\n"   (no OK token; not a
//                                                 fingerprint the coverage
//                                                 gate polices)
//   Fail:         "NVME WRITE FAIL\n"            (no OK token)
//
// Every OK-bearing line is output-strip-clean (design/policy/output-
// provenance-strip.md).
//
// -----------------------------------------------------------------------------
// Wire posture at R54.M1
// -----------------------------------------------------------------------------
//
// NOT wired into kernel_main. Symbol existence + build-time link
// verification are the R54.M1 acceptance criterion; live invocation is
// R55+ once the driver-attach ceremony surfaces a real NVMe controller
// on the default boot path. Run-smoke mode `boot_r54_nvme_write` is a
// SKIP-echo, matching pdxfs_lite_e2e / concurrent_io / msix_ir_round_
// robin precedent.
//
// -----------------------------------------------------------------------------
// Register plan
// -----------------------------------------------------------------------------
//
//   rbx = write_buf pattern (loaded once, compared once).
//
//   1 push = 8 B; entry rsp%16==8 + 8 = 16, %16==0 — aligned for
//   nested uart_puts / nvme_write_blocking / nvme_read_blocking calls.
//   No pad required.
//
// -----------------------------------------------------------------------------
// Reserved-label discipline
// -----------------------------------------------------------------------------
//
// Labels prefixed `r54w_` throughout. Grep audit: no `r54w_` hits
// anywhere else in src/kernel/ or tests/.

module R54NvmeWrite = structure {

  // 4 KiB pattern buffer (write source). Page-aligned so PRP1 satisfies
  // NVMe §4.5.2 single-page transfer constraint at any lba_size <= 4096.
  pub let mut _r54w_write_buf : [u64; 512] = uninit @align(4096)

  // 4 KiB readback destination. Zeroed by the witness before the read
  // so a stale-buffer false-positive is impossible.
  pub let mut _r54w_read_buf  : [u64; 512] = uninit @align(4096)

  // Fingerprint strings. Length counts include the trailing "\n\0".
  pub let _r54w_probe_msg     : [u8; 56] = "NVME WRITE PROBE nsid=1 lba=0x0000000000000010 count=1\n\0"
  pub let _r54w_write_ok_msg  : [u8; 15] = "NVME WRITE OK\n\0"
  pub let _r54w_read_ok_msg   : [u8; 18] = "NVME READBACK OK\n\0"
  pub let _r54w_skip_msg      : [u8; 26] = "NVME WRITE SKIP not-live\n\0"
  pub let _r54w_fail_msg      : [u8; 17] = "NVME WRITE FAIL\n\0"

  // ==========================================================================
  // r54_nvme_write_witness() -> u64
  //
  //   Returns:
  //     0 — SKIP (no live SQ pair) or full OK round-trip.
  //     1 — FAIL (write status non-zero, read status non-zero, or
  //         readback pattern mismatch).
  //
  //   Body per module header. Every code path emits at most one OK
  //   fingerprint pair; the SKIP + FAIL paths emit their own strings
  //   which contain no OK token (so the fingerprint-coverage gate does
  //   not police them).
  // ==========================================================================
  pub let r54_nvme_write_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R54.M1-001 (#1778). Symbol-existence + optional live-HW round-trip witness for nvme_write_blocking. Body: (1) 1-push callee-save prologue (rbx = write_buf pattern). Entry rsp%16==8 + 8 pushed = 16, %16==0 — aligned for nested uart_puts / nvme_write_blocking / nvme_read_blocking calls. (2) Emit probe banner via lea rdi + call uart_puts (probe banner has no OK token so is not a fingerprint the coverage gate polices; it is a golden line for the R54 smoke recipe). (3) Substrate short-circuit: load _nvme_io_queue_count; if 0 -> emit SKIP line, return 0. This guards against a stray DMA-to-PA=0 hazard if the witness is invoked via GDB in an unhealthy state; the primary posture is that this witness is not wired into kernel_main so this branch protects real HW / GDB invocations only. (4) Stage 0xDEADBEEFCAFEBABE into _r54w_write_buf[0] as the round-trip pattern. Save in rbx for the post-read comparison. (5) nvme_write_blocking(nsid=1, lba=0x10, count=1, buf_pa=&_r54w_write_buf). Expect rax == 0 (bit 0 of the CQE status is Phase, always set on completion; the (status & 0xFFFE) == 0 idiom nvme_read_blocking's own header describes fires the same way here — but for the M1 witness with a real successful NVMe Write the full 16-bit status is 0 including Phase since Phase is stripped by irq_handler_qid). If non-zero -> emit FAIL, return 1. (6) Zero _r54w_read_buf[0] so a stale-buffer false-positive is impossible. (7) nvme_read_blocking(nsid=1, lba=0x10, count=1, buf_pa=&_r54w_read_buf). Expect rax == 0. If non-zero -> emit FAIL, return 1. (8) Compare _r54w_read_buf[0] against rbx (staged pattern). If not equal -> emit FAIL, return 1. (9) Emit NVME WRITE OK + NVME READBACK OK fingerprints via uart_puts. (10) Epilogue: xor rax, rax; pop rbx; ret. Reserved labels: r54w_. Encoder: lea / mov / call / cmp / je / jne / xor / push / pop — all pre-existing (used by pdxfs_lite_e2e_witness and concurrent_io_witness).",
      block: {
        push rbx;

        // -----------------------------------------------------------
        // (2) Emit probe banner.
        // -----------------------------------------------------------
        lea rdi, [rip + _r54w_probe_msg];
        call uart_puts;

        // -----------------------------------------------------------
        // (3) Substrate short-circuit — no live SQ pair, no DMA.
        // -----------------------------------------------------------
        mov rax, [rip + _nvme_io_queue_count];
        cmp rax, 0;
        jne r54w_have_live;

        lea rdi, [rip + _r54w_skip_msg];
        call uart_puts;
        xor rax, rax;
        pop rbx;
        ret;

      r54w_have_live:
        // -----------------------------------------------------------
        // (4) Stage pattern into write_buf[0].
        // -----------------------------------------------------------
        mov rbx, 0xDEADBEEFCAFEBABE;
        lea rax, [rip + _r54w_write_buf];
        mov [rax + 0], rbx;

        // -----------------------------------------------------------
        // (5) nvme_write_blocking(nsid=1, lba=0x10, count=1,
        //                        buf_pa=&_r54w_write_buf).
        // -----------------------------------------------------------
        mov rdi, 1;
        mov rsi, 0x10;
        mov rdx, 1;
        lea rcx, [rip + _r54w_write_buf];
        call nvme_write_blocking;

        cmp rax, 0;
        jne r54w_fail;

        // -----------------------------------------------------------
        // (6) Zero read_buf[0] — poison the compare cell.
        // -----------------------------------------------------------
        lea rax, [rip + _r54w_read_buf];
        xor rcx, rcx;
        mov [rax + 0], rcx;

        // -----------------------------------------------------------
        // (7) nvme_read_blocking(nsid=1, lba=0x10, count=1,
        //                       buf_pa=&_r54w_read_buf).
        // -----------------------------------------------------------
        mov rdi, 1;
        mov rsi, 0x10;
        mov rdx, 1;
        lea rcx, [rip + _r54w_read_buf];
        call nvme_read_blocking;

        cmp rax, 0;
        jne r54w_fail;

        // -----------------------------------------------------------
        // (8) Compare readback[0] against staged pattern in rbx.
        // -----------------------------------------------------------
        lea rax, [rip + _r54w_read_buf];
        mov rax, [rax + 0];
        cmp rax, rbx;
        jne r54w_fail;

        // -----------------------------------------------------------
        // (9) Success — emit both OK fingerprints.
        // -----------------------------------------------------------
        lea rdi, [rip + _r54w_write_ok_msg];
        call uart_puts;

        lea rdi, [rip + _r54w_read_ok_msg];
        call uart_puts;

        xor rax, rax;
        pop rbx;
        ret;

      r54w_fail:
        lea rdi, [rip + _r54w_fail_msg];
        call uart_puts;
        mov rax, 1;
        pop rbx;
        ret
      }
    }
}
