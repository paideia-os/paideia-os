// src/kernel/boot/witness/fd_hygiene.pdx — R119.M1 (paideia-os #2471)
//
// fd-hygiene witness bringup — gate + populator for the R119 fd-witness
// cascade (design/terminal/semantic-shell-materialization-plan.md §R119).
//
// This file exports two things:
//
//   1. `_fd_hygiene_witness_active : u64` (mut, .bss zero)
//      A global gate.  Every fd-hygiene witness emit site reads it
//      first and short-circuits when it is 0.  The witnesses live in:
//         src/kernel/core/syscall/handlers/sys_dup2.pdx  (entry + exit)
//         src/kernel/core/syscall/handlers/sys_pipe.pdx  (entry + exit)
//         src/kernel/core/fs/fd_cloexec.pdx              (per-slot decision)
//         src/kernel/core/fs/fd_inherit.pdx              (per-slot decision)
//      They ALL default to silent — boot brings the gate up at 0, and
//      the R119.M2 / M3 rounds (and downstream R121..R141) flip the
//      gate to 1 before running the scenarios they want to trace, then
//      back to 0 afterward.  This keeps the boot transcript free of
//      dup2/fork/execve noise while still letting a targeted round
//      grep the fingerprints deterministically.
//
//   2. `fd_hygiene_witness_bringup() -> u64`
//      A leaf populator invoked once from kernel_main during the
//      normal witness cascade (after `witness_r16_syscalls`).  It:
//        (a) Calls pipe_vops_init to populate _pipe_vops with real
//            read/write/close adapters — mirrors tmpfs_vops_init's
//            role for the tmpfs backend.
//        (b) Zeros _fd_hygiene_witness_active as a defensive stamp
//            (redundant with .bss but keeps the "gate defaults to
//            off" invariant explicit in one place).
//      Returns 0 unconditionally.
//
// A round that needs the fingerprints does:
//    lea rcx, [rip + _fd_hygiene_witness_active]
//    mov rax, 1
//    mov [rcx], rax
//    ... exercise the scenario ...
//    xor rax, rax
//    mov [rcx], rax
//
// Encoder posture (feedback_pdx_encoder_pitfalls):
//   * No `test rN,rN` — every gate is `cmp reg, 0`.
//   * No 2-op `imul r,imm` — nothing here needs multiply.
//   * Reserved-label prefix `fdh_` avoids `loop`/`done`/`top` collisions.
//
// The gate lives in this file rather than in one of the fd_* modules so
// every witness emit site imports a single symbol — otherwise fd_cloexec
// / fd_inherit / sys_dup2 / sys_pipe would each need to reach into some
// other module's namespace, and the "one owner per state cell" review
// discipline gets muddled.  Symmetric with _cow_witness_active and
// _ring3_witness_active which live in kernel_main.pdx (bss-side) but
// are consumed from every #PF / #UD handler.

module FdHygiene = structure {
  // ==========================================================================
  // Gate storage
  // ==========================================================================
  //
  // Defaults to 0 (.bss zero); explicit `= 0` initializer keeps the
  // "off at boot" contract visible.  Type u64 rather than u8 because
  // paideia-as's memory model works best with 8-byte aligned loads;
  // no wire cost either way since every emit site reads it once per
  // iteration.
  pub let mut _fd_hygiene_witness_active : u64 = 0

  // ==========================================================================
  // fd_hygiene_witness_bringup() -> u64
  //
  // Boot-time populator.  Called once from kernel_main.pdx immediately
  // after the existing witness_r16_syscalls block (which already covers
  // O_CREAT, sys_open/close/read/write, user_ptr_ok, sys_dup2,
  // fd_inherit, fd_cloexec — see r16_syscalls.pdx).  This bringup
  // wires the pipe backend's vops table so a first sys_pipe caller has
  // a real read/write/close dispatch to land on, and zeros the gate
  // defensively.
  //
  // Leaf caller (no recursion into this bringup); however
  // pipe_vops_init is a leaf itself so this whole entry is 1-deep.
  // rsp%16 at entry is 8 (per SysV post-CALL); no push needed because
  // we never spill a callee-save reg.  `sub rsp, 8` around the nested
  // call satisfies pipe_vops_init's SysV entry (which itself is a
  // leaf so any alignment is fine, but we keep the discipline uniform
  // with the tmpfs_vops_init call site at r16_tmpfs.pdx L540).
  // ==========================================================================
  pub let fd_hygiene_witness_bringup : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem},
      capabilities: {},
      justification: "R119.M1 (paideia-os #2471): fd-hygiene witness bringup — populate _pipe_vops via pipe_vops_init and zero-stamp _fd_hygiene_witness_active. The gate stays 0 across boot; downstream rounds flip it to 1 before running the fingerprint scenarios they need (see file header). pipe_vops_init is a leaf populator (byte-symmetric with tmpfs_vops_init at core/fs/tmpfs/vops.pdx L1006) — the bringup exists here rather than being folded into r16_syscalls.pdx or r16_tmpfs.pdx because pipe is a distinct backend with a distinct vops table and its own dispatch surface (sys_pipe body), and the two other fd-hygiene witnesses (sys_dup2, fd_cloexec/inherit walkers) already exist and just need the gate that this file exports. sub rsp,8/add rsp,8 around the nested call keeps SysV alignment uniform with the tmpfs_vops_init call site at r16_tmpfs.pdx L540. Returns 0 unconditionally; no failure modes at this landing (pipe_vops_init is deterministic; the gate stamp cannot fail). Encoder posture: `mov [mem], reg` for the gate zero (avoids `mov [mem], imm` which the encoder rejects for a fresh-load-then-store rewrite pass); leaf-clean register discipline (no callee-save touched).",
      block: {
        // (a) Populate the pipe vops table.
        sub rsp, 8;                       // SysV alignment pad for the call
        call pipe_vops_init;
        add rsp, 8;

        // (b) Defensive zero-stamp of the gate.
        xor rax, rax;
        mov [rip + _fd_hygiene_witness_active], rax;

        xor rax, rax;                     // return 0
        ret
      }
    }
}
