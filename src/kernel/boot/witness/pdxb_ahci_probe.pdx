// src/kernel/boot/witness/pdxb_ahci_probe.pdx -- R53.M5-005 (#1758)
//
// R51 AHCI parity for the PDXB volume-probe walker (#1706's
// `probe_all_bdevs`, R52.M5-004).  Proves that a KIND_BLKDEV cap
// stamped with family = BLK_CAP_FAMILY_AHCI (2) reaches the family-
// aware branch #1758 lands in `probe_all_bdevs`, matching the pre-
// existing NVMe (family 0/1) coverage every previous R52.M5 witness
// exercised.
//
// =============================================================================
// SCOPE
// =============================================================================
//
// #1758's own task text:
//
//   (1) probe.pdx walks both NVMe and AHCI bdevs, respecting the
//       family byte (family 0/1 -> NVMe, family 2 -> AHCI);
//   (2) verify AHCI KIND_BLOCK_DEVICE caps get their PDXB probe
//       attempted; in substrate mode, both return NVMEIO_PICK_NONE
//       (or the AHCI equivalent) gracefully;
//   (3) emit `PDXB AHCI PROBE OK` (or a substrate variant).
//
// Item (1) is landed as the family-byte demux the sibling probe.pdx
// edit adds to `probe_all_bdevs`.  This witness proves (2) and (3):
// it mints a real KIND_AHCI_CONTROLLER + dual-kind KIND_AHCI_PORT /
// KIND_BLKDEV (family = AHCI) row, snapshots the pre-probe value of
// the new PBP_ST_SCANNED_AHCI counter (index 4 in _pdxfs_probe_stats),
// calls `probe_all_bdevs`, and asserts the counter advanced -- proof
// that the walker's family-byte branch reached the AHCI arm at least
// once.  The graceful failure of the substrate-mode BDEV_OP_READ_LBA
// path is proven by side-effect: `probe_all_bdevs` returns 0 volumes
// registered even though it walked the AHCI slot (sb_read forwarded
// AHCIIO_PORT_NOT_READY 0xFFFFECA6 -> cap_handler_blkdev -> sb_read
// -> PDXB_SB_READ_BDEV_ERR 0xFFFFED08 -> probe_one_bdev emits PDXB
// PROBE SKIP; see the graceful-fail chain in the sibling probe.pdx
// header § "Failure modes are non-fatal").
//
// =============================================================================
// Substrate posture (identical to bdev_cross_family_soak_synth.pdx / ahci_hot_
// remove_write_synth.pdx)
// =============================================================================
//
// Mints a real KIND_AHCI_CONTROLLER + dual-kind row that never
// advances beyond AHCIP_STATE_MINTED (no per-port bring-up /
// IDENTIFY orchestration is exercised).  Under this posture every
// BDEV_OP_READ_LBA reaches cap_handler_blkdev's family=2 path,
// which routes to ahci_io_submit_rw -> step (3) `ahci_port_row_state
// != AHCIP_STATE_IDENTIFIED` -> AHCIIO_PORT_NOT_READY (0xFFFFECA6);
// cap_handler_blkdev forwards that verbatim; sb_read receives non-
// zero from cap_invoke -> PDXB_SB_READ_BDEV_ERR (0xFFFFED08);
// probe_one_bdev's fingerprint hook (R53.M3-005) emits "PDXB PROBE
// SKIP" and bumps PBP_ST_SKIPPED.  No MMIO register is read or
// written against the synthetic abar_pa -- same safety posture
// every other AHCI synth fixture in this tree already relies on.
//
// Cap slots 172..175 are the same fixed range every R52 PdxFS
// witness (pdxfs_round_trip_phased.pdx, pdxfs_boot_mount_smoke.pdx,
// pdxfs_reboot_verify_smoke.pdx) already claims for its own
// substrate mint, tolerated per this tree's established practice:
// every witness clears its own range on entry AND on every exit
// path, and boot witnesses run strictly sequentially, so no two
// witnesses' cap rows are ever live at the same moment.  This
// witness follows the same discipline.
//
//   172 = synthetic KIND_PCI_DEV parent for the AHCI controller
//   173 = KIND_AHCI_CONTROLLER (row 0)
//   174 = KIND_AHCI_PORT (row 0, dual-kind with slot 175)
//   175 = KIND_BLKDEV, family AHCI (2) -- the slot probe_all_bdevs
//         sees inside its cap_table scan
//
// =============================================================================
// Fingerprint contract
// =============================================================================
//
//   PDXB AHCI PROBE OK   -- OK tag, output-strip-clean per design/
//                           policy/output-provenance-strip.md.  A
//                           decimal `count=<N>` KV rides the same
//                           line, naming the observed delta on
//                           PBP_ST_SCANNED_AHCI (>= 1 on the
//                           substrate mint; the equivalent line
//                           under a live disk would carry the count
//                           of AHCI KIND_BLKDEV caps the R51 driver
//                           family had minted).
//   PDXB AHCI PROBE FAIL -- FAIL tag with `line=<N>` decimal KV
//                           naming which stage tripped.
//
// The `count` KV is deliberately taken from the counter DELTA, not
// from probe_all_bdevs's own return (which is the number of volumes
// REGISTERED; 0 in substrate since no real PDXB superblock exists on
// the synthetic abar_pa).  The delta proves the family-byte branch
// fired regardless of whether a real superblock was found.
//
// =============================================================================
// Register plan
// =============================================================================
//
// 3-push callee-save prologue (rbx = baseline PBP_ST_SCANNED_AHCI
// snapshot, carried across the probe_all_bdevs call; r12/r13 pushed
// for pattern uniformity with pdxfs_round_trip_phased.pdx's own 3-
// push shape).  Entry rsp%16 == 8 + 24 = 32 -> rsp%16 == 0 for every
// nested call this function makes directly (matches pdxfs_round_
// trip_phased.pdx / pdxfs_reboot_verify_smoke.pdx documented shape).
//
// The one `sub rsp, 32` / `add rsp, 32` bracket around ahci_port_
// dual_kind_mint's params_ptr staging is 16-byte-aligned, so rsp%16
// stays 0 across it (identical bracket to every sibling AHCI-minting
// synth fixture, e.g. ahci_hot_remove_write_synth.pdx L276).
//
// klog_s1_d1 is a 5-arg wrapper -- level, subsys, tag, key, value
// all fit registers, no extra stack push.
//
// =============================================================================
// mov_b / no-test / label-prefix discipline
// =============================================================================
//
// No byte-granularity access anywhere (every field touched is a
// full u64 call return or slot index literal).  No `test` instruction
// anywhere; every comparison uses `cmp` + `je`/`jne`.  Every label
// is prefixed `pdxbap_` (PDXB AHCI Probe) per the reserved-label
// discipline; grep audit 2026-08-23: no `pdxbap_` hits anywhere else
// in src/kernel/ or tests/.
//
// =============================================================================
// Wire posture
// =============================================================================
//
// Wired into src/kernel/boot/witness/r30_platform.pdx immediately
// after `pdxb_no_disk_witness_call` and before `pdxb_root_select_
// fingerprint_call`, keeping the PDXB volume-probe cluster
// contiguous.  Fingerprint ordering:
//
//   PDXB NO DISK FALLBACK OK
//   PDXB AHCI PROBE OK       <- THIS WITNESS
//   PDXB ROOT FALLBACK
//
// Fingerprint appended to tests/r17/shell-shutdown.golden between
// "PDXB NO DISK FALLBACK OK" and "PDXB ROOT FALLBACK".
//
// `_pdxbap_stage` is confined to this .o alone by tools/build.sh's
// ec_confine_one, mirroring the _pkgi_stage / _pms_stage / _pdxbnd_
// stage discipline every sibling boot witness in this cluster
// established.

module PdxbAhciProbe = structure {

  // Stage counter: bumped at the top of each block that could fail
  // so the FAIL fingerprint's `line=N` KV names WHICH stage tripped.
  // Only mutable static in this module.
  pub let mut _pdxbap_stage : u64 = 0

  // Fingerprint bytes.  Output-strip clean per design/policy/output-
  // provenance-strip.md (no round/milestone/issue reference in the
  // emitted string).  Length count includes the trailing "\n\0" pair.
  pub let pdxbap_ok   : [u8; 20] = "PDXB AHCI PROBE OK\n\0"
  pub let pdxbap_fail : [u8; 22] = "PDXB AHCI PROBE FAIL\n\0"

  pub let pdxbap_k_count : [u8; 6] = "count\0"

  // ==========================================================================
  // pdxbap_clear() -- scrub cap_table slots 172..175 inclusive.
  //
  // Same shape as pdxfs_round_trip_phased.pdx's prtp_clear /
  // ahci_hot_remove_write_synth.pdx's hrw_clear, upper bound is 176
  // (exclusive), matching this witness's own slot claim.
  // ==========================================================================
  pub let pdxbap_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R53.M5-005 (#1758): clear cap_table slots 172..175 (this witness's whole fixed slot claim, matching every sibling AHCI/PdxFS synth fixture's own on-entry+on-exit scrub discipline). Same shape as prtp_clear (pdxfs_round_trip_phased.pdx) / hrw_clear (ahci_hot_remove_write_synth.pdx), upper bound is 176 (exclusive). One callee-save push (rbx) leaves rsp%16 == 0 for the nested cap_mint_write. Labels prefixed pdxbap_cl_.",
      block: {
        push rbx;
        mov rbx, 172;
      pdxbap_cl_loop:
        cmp rbx, 176;
        jae pdxbap_cl_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp pdxbap_cl_loop;
      pdxbap_cl_done:
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // wit_pdxb_ahci_probe() -> 0 (OK) | 1 (FAIL)
  //
  // Body:
  //   (1) Defensive scrub: pdxbap_clear + ahci_ctrl_table_reset +
  //       ahci_port_table_reset (matches every AHCI-touching synth
  //       fixture's own entry posture).
  //   (2) Mint synthetic KIND_PCI_DEV parent at slot 172.
  //   (3) Mint KIND_AHCI_CONTROLLER at slot 173 via ahci_ctrl_cap_
  //       mint_inner, then stamp the descriptor via cap_mint_write.
  //       Expect ctrl row 0.
  //   (4) Mint dual-kind KIND_AHCI_PORT + KIND_BLKDEV(family=2) at
  //       slots 174/175 via ahci_port_dual_kind_mint (this is the
  //       cap the probe walker will find).  Expect port row 0.
  //   (5) Snapshot the pre-probe value of PBP_ST_SCANNED_AHCI
  //       (pdxfs_probe_stat(4)) into rbx.
  //   (6) Call probe_all_bdevs -- walks all 256 cap_table slots,
  //       finds the KIND_BLKDEV at 175 with family=2 in target_ptr
  //       [23:16], bumps PBP_ST_SCANNED_AHCI, then calls probe_one_
  //       bdev which forwards through the substrate AHCI I/O chain
  //       to a graceful PDXB_SB_READ_BDEV_ERR (probe_one_bdev
  //       emits "PDXB PROBE SKIP", returns the sentinel).  The
  //       walker's own return (rax) is the count of REGISTERED
  //       volumes, expected 0 in substrate.
  //   (7) Read PBP_ST_SCANNED_AHCI again; delta = post - rbx.
  //       Assert delta >= 1 -- proof the family-byte branch reached
  //       the AHCI arm at least once.
  //   (8) Emit "PDXB AHCI PROBE OK" + count=<delta> decimal KV via
  //       klog_s1_d1.  Cleanup + return 0.
  //
  // Fail path (any stage tripped): emit "PDXB AHCI PROBE FAIL" +
  // line=<stage> and return 1.  Cleanup runs on every exit path so
  // cap_table slots 172..175 and the ahci ctrl/port tables never
  // leak past this witness.
  // ==========================================================================
  pub let wit_pdxb_ahci_probe : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R53.M5-005 (#1758): R51 AHCI parity boot witness for probe.pdx's family-byte demux. 3-push callee-save prologue (rbx = pre-probe PBP_ST_SCANNED_AHCI snapshot carried across the probe_all_bdevs call and re-read to compute the delta; r12/r13 pushed for pattern uniformity with pdxfs_round_trip_phased.pdx's own 3-push shape). Entry rsp%16==8 + 24 = 32 -> rsp%16==0 for every nested call. Body per module header: (1) defensive scrub (pdxbap_clear + ahci_ctrl_table_reset + ahci_port_table_reset). (2)-(4) mint the substrate AHCI cap chain identical to ahci_hot_remove_write_synth.pdx's stages 2-3 but at slots 172/173/174/175 instead of 168/169/170/171 (the R52 PdxFS-witness range): KIND_PCI_DEV @172 via cap_mint_write, KIND_AHCI_CONTROLLER @173 via ahci_ctrl_cap_mint_inner (expect row 0) + cap_mint_write to stamp the descriptor, KIND_AHCI_PORT/KIND_BLKDEV @174/175 via ahci_port_dual_kind_mint (expect row 0). Each stage number is stashed to _pdxbap_stage before the call so the FAIL fingerprint's `line=N` KV names the tripping stage. (5) rbx = pdxfs_probe_stat(PBP_ST_SCANNED_AHCI=4) -- the pre-probe baseline. (6) call probe_all_bdevs -- return value (rax) is the count of REGISTERED volumes, expected 0 in substrate (the sb_read chain forwards AHCIIO_PORT_NOT_READY -> PDXB_SB_READ_BDEV_ERR, so probe_one_bdev emits PDXB PROBE SKIP), but the counter delta is what proves the family-byte branch reached the AHCI arm. (7) rax = pdxfs_probe_stat(4) again; sub rax, rbx -- delta of the AHCI-scanned counter across the probe call. cmp rax, 0; je pdxbap_fail_stage (delta must be >= 1 -- if the family-byte demux failed the AHCI branch was never taken). rbx = rax (rbx now holds the delta for the emit line, replacing the baseline value that is no longer needed). (8) klog_s1_d1(LEVEL_INFO=3, SUBSYS_BOOT, pdxbap_ok, pdxbap_k_count, rbx) -- emits 'PDXB AHCI PROBE OK count=<delta>'. Cleanup + return 0. pdxbap_fail_stage: read _pdxbap_stage back into r8, klog_s1_d1(LEVEL_ERROR=1, SUBSYS_BOOT, pdxbap_fail, k_line, stage) matching pdxbnd_fail_stage's shape. Every cleanup path calls pdxbap_clear + ahci_ctrl_table_reset + ahci_port_table_reset before returning so no cap row and no ctrl/port row leaks past this witness (matches ahci_hot_remove_write_synth.pdx's own on-exit scrub discipline). Effects/capabilities widen to match the widest nested call (probe_one_bdev's {mem, sysreg} @{cap} plus boot for klog_s1_d1). Encoder: mov / cmp / je / jne / lea / xor / sub / call -- all pre-existing, no encoder gap. Labels prefixed pdxbap_.",
      block: {
        push rbx;
        push r12;
        push r13;

        // -----------------------------------------------------------
        // (1) Defensive scrub.
        // -----------------------------------------------------------
        mov rax, 1;
        lea rcx, [rip + _pdxbap_stage];
        mov [rcx], rax;

        call pdxbap_clear;
        call ahci_ctrl_table_reset;
        call ahci_port_table_reset;

        // -----------------------------------------------------------
        // (2) Synthetic KIND_PCI_DEV parent (slot 172).
        // -----------------------------------------------------------
        mov rax, 2;
        lea rcx, [rip + _pdxbap_stage];
        mov [rcx], rax;

        mov rdi, 172;
        mov rsi, 0x30;                    // KIND_PCI_DEV
        mov rdx, 0x21F;                   // R_DEV_ALL | RIGHT_MINT
        mov rcx, 0xABCDEF01;              // synthetic bdf
        call cap_mint_write;

        // -----------------------------------------------------------
        // (3) KIND_AHCI_CONTROLLER (slot 173, row 0). Never advanced
        // past AHCIP_STATE_MINTED -- no MMIO touch on the synthetic
        // abar_pa, matching every sibling AHCI synth fixture.
        // -----------------------------------------------------------
        mov rax, 3;
        lea rcx, [rip + _pdxbap_stage];
        mov [rcx], rax;

        mov rdi, 172;                     // parent_slot (KIND_PCI_DEV)
        mov rsi, 0x43F;                   // R_AHCIC_ALL
        xor rdx, rdx;                     // ctrl_idx = 0
        mov rcx, 0x600000;                // abar_pa (synthetic)
        call ahci_ctrl_cap_mint_inner;
        cmp rax, 0;                       // expect row 0
        jne pdxbap_fail_stage;

        mov rdi, 173;
        mov rsi, 0x19A;                   // KIND_AHCI_CONTROLLER
        mov rdx, 0x43F;
        xor rcx, rcx;                     // target_ptr = ctrl_row_id = 0
        call cap_mint_write;

        // -----------------------------------------------------------
        // (4) Dual-kind KIND_AHCI_PORT / KIND_BLKDEV (slots 174/175,
        // row 0). The KIND_BLKDEV at slot 175 has family = AHCI (2)
        // stamped into target_ptr[23:16] by blkdev_cap_mint_ahci
        // (via ahci_port_dual_kind_mint) -- the cap the probe walker
        // will find and family-demux.
        // -----------------------------------------------------------
        mov rax, 4;
        lea rcx, [rip + _pdxbap_stage];
        mov [rcx], rax;

        sub rsp, 32;
        xor rax, rax;
        mov [rsp + 0], rax;               // port_index = 0
        mov rax, 512;
        mov [rsp + 8], rax;               // sector_size
        mov rax, 100;
        mov [rsp + 16], rax;              // block_count
        xor rax, rax;
        mov [rsp + 24], rax;              // parent_ctrl_row = 0
        mov rdi, 174;                     // port_slot
        mov rsi, 175;                     // blk_slot
        mov rdx, 173;                     // parent_slot (KIND_AHCI_CONTROLLER)
        mov rcx, 0x41F;                   // port_rights (R_AHCIP_ALL)
        mov r8,  0x1F;                    // blk_rights (R_BLK_ALL)
        mov r9,  rsp;                     // params_ptr
        call ahci_port_dual_kind_mint;
        add rsp, 32;
        cmp rax, 0;                       // expect row 0
        jne pdxbap_fail_stage;

        // -----------------------------------------------------------
        // (5) Snapshot PBP_ST_SCANNED_AHCI baseline.
        // -----------------------------------------------------------
        mov rax, 5;
        lea rcx, [rip + _pdxbap_stage];
        mov [rcx], rax;

        mov rdi, 4;                       // PBP_ST_SCANNED_AHCI
        call pdxfs_probe_stat;
        mov rbx, rax;                     // baseline

        // -----------------------------------------------------------
        // (6) probe_all_bdevs -- walks cap_table, family-byte demuxes,
        // hits our AHCI slot (175), bumps PBP_ST_SCANNED_AHCI, then
        // calls probe_one_bdev which gracefully skips on substrate.
        // -----------------------------------------------------------
        mov rax, 6;
        lea rcx, [rip + _pdxbap_stage];
        mov [rcx], rax;

        call probe_all_bdevs;
        // rax = count of REGISTERED volumes; ignored (0 expected in
        // substrate). The counter delta below is what proves the
        // family-byte branch reached AHCI.

        // -----------------------------------------------------------
        // (7) Delta check: post - baseline >= 1.
        // -----------------------------------------------------------
        mov rax, 7;
        lea rcx, [rip + _pdxbap_stage];
        mov [rcx], rax;

        mov rdi, 4;                       // PBP_ST_SCANNED_AHCI
        call pdxfs_probe_stat;
        sub rax, rbx;                     // delta
        cmp rax, 0;
        je  pdxbap_fail_stage;            // delta == 0 -> AHCI branch never fired
        mov rbx, rax;                     // rbx = delta (for the emit line)

        // -----------------------------------------------------------
        // (8) Emit OK + count=<delta> decimal KV.
        // -----------------------------------------------------------
        mov rax, 8;
        lea rcx, [rip + _pdxbap_stage];
        mov [rcx], rax;

        mov rdi, 3;                       // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + pdxbap_ok];
        lea rcx, [rip + pdxbap_k_count];
        mov r8, rbx;                      // count (delta)
        call klog_s1_d1;

        call pdxbap_clear;
        call ahci_ctrl_table_reset;
        call ahci_port_table_reset;
        xor rax, rax;
        jmp pdxbap_out;

      pdxbap_fail_stage:
        lea rax, [rip + _pdxbap_stage];
        mov r8, [rax];
        mov rdi, 1;                       // LEVEL_ERROR
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + pdxbap_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;

        call pdxbap_clear;
        call ahci_ctrl_table_reset;
        call ahci_port_table_reset;
        mov rax, 1;

      pdxbap_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
