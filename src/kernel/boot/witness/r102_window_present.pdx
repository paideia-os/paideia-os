// src/kernel/boot/witness/r102_window_present.pdx — R102.MON-005 skeleton
//
// R102.MON-005 (paideia-os #2212) owns the boot smoke that pins the
// pdxclock-window-visible cascade. Fires once svc-compositor.M4-002
// (client-window commit path) AND pdxclock.M4-* (spawnable clock ELF)
// have landed upstream and their ELFs are embedded in the boot image
// via R102.MON-003.
//
// As of this landing, svc-compositor and pdxclock exist as empty
// scaffolds under github.com/paideia-os (LICENSE + README.md only).
// See the r102_first_pixel.pdx header for the full disposition of the
// nine-satellite scaffold state.
//
// Skeleton body: emit ONE lowercase skip fingerprint and return.
//
//   Skeleton (this landing):
//     "boot r102 window present skip reason=no-userland"
//   Future (when the cascade fires):
//     "boot r102 window present ok"      (per r102-user-plan.md §4.10)
//
// Encoder discipline: same as r102_first_pixel.pdx (frame prologue
// implicit; ONE-line lowercase fingerprint tag; labels prefixed
// r102wp_ if ever needed).

module R102WindowPresent = structure {

  // 49 bytes including NUL.
  pub let tag_r102_window_present_skip : [u8; 49] =
    "boot r102 window present skip reason=no-userland\0"

  pub let witness_r102_window_present : () -> () !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R102.MON-005 skeleton (paideia-os #2212). Emits the ONE-line lowercase skip fingerprint `boot r102 window present skip reason=no-userland` on every boot. The full cascade this witness will eventually drive (spawn pdxclock, wait for its SurfaceCommitRecord to reach svc-compositor, verify a nonzero window count via the compositor's list-windows query) requires svc-compositor.M4-002 and pdxclock.M4-002 upstream plus R102.MON-003's ELF embed; none of those preconditions hold as of the R102 MON- wave, so the body would fail to link if it named those symbols. push rbp / pop rbp preserves the caller's rsp%16 parity and rbp guarantee across the nested klog_s1 call.",
      block: {
        push rbp;

        mov rdi, 3;                              // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_r102_window_present_skip];
        call klog_s1;

        pop rbp;
        ret
      }
    }
}
