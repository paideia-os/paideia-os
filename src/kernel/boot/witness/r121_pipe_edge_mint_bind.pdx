// src/kernel/boot/witness/r121_pipe_edge_mint_bind.pdx --
//   R121.M5-followup (paideia-os #2501)
//
// Boot-time witness for the CAP-MINT GAP closure end-to-end at the
// syscall surface: enables the fd-hygiene witness gate so both
// sys_pipe_edge_mint and sys_pipe_edge_bind emit their new "sc ok"
// fingerprints, mints a PROD endpoint via sys_pipe_edge_mint_body,
// mints a CONS endpoint via the same body, binds them via
// sys_pipe_edge_bind_body, and asserts the bind returned 0. Emits
// a rollup `boot pipe mint bind ok -- kind=<hex> ring=<hex>` on
// success and `boot pipe mint bind fail line=<n>` on any step
// refusal.
//
// This witness DOES NOT go through the SYSCALL instruction path --
// it invokes the syscall bodies directly (bypassing the SysV
// left-rotate the dispatch arm does) so it can drive the caller
// side of the CAP-MINT GAP without a userland task in flight. The
// dispatch arm itself is exercised at boot by the R121.M5
// exec_child_pipeline_typed_entry path (src/user/dispatch.pdx §L2295)
// which invokes sys_pipe_edge_mint / sys_pipe_edge_bind trampolines
// via the SYSCALL instruction; this witness is the kernel-side
// counterpart that verifies the body wire independent of userland
// scheduling.
//
// =============================================================================
// PREREQUISITES THIS FILE MINTS (all torn down on every exit)
// =============================================================================
//
// Two KIND_PIPELINE_EDGE rows (via pipeline_edge_alloc, called
// transitively through sys_pipe_edge_mint_body) and two cap_table
// slots (published via cap_mint_write). On every exit path (success
// and every failure arm) both cap_table slots are scrubbed by
// cap_mint_write(slot, 0, 0, 0) and both rows are freed via
// pipeline_edge_free -- byte-identical to entry.
//
// The synthetic schema_id (0x1223 -- next above the R121.M6
// backpressure witness's 0x1222) keeps this witness's row-pool
// entries distinguishable from the sibling R121 witnesses in a raw
// dump.
//
// =============================================================================
// GATE POSTURE
// =============================================================================
//
// The sys_pipe_edge_mint / sys_pipe_edge_bind fingerprints
// (`pipe edge mint sc ok`, `pipe edge bind sc ok`) are gated on
// _fd_hygiene_witness_active. This witness flips the gate to 1
// before invoking the syscall bodies, then restores it to its
// prior value on exit. Same pattern R119 fd-hygiene witnesses use
// (their teardown likewise restores).
//
// =============================================================================
// FINGERPRINT
// =============================================================================
//
// Success: "boot pipe mint bind ok --" (klog_s1, 0 KVs). Kept
// deliberately KV-less; the syscall-body emits themselves
// (pipe edge mint sc ok slot=<n> row=<n>, pipe edge bind sc ok
// prod_slot=<n> cons_slot=<n>) carry the substantive keys and
// values -- so this rollup is a boolean acceptance marker rather
// than a repeat of substrate detail.
//
// Failure: "boot pipe mint bind fail line=<n>" (klog_s1_d1), where
// <n> is the stage that refused. No boot_bail_or_continue call;
// failure falls through to cleanup + return, matching sibling
// witnesses in this cascade.
//
// =============================================================================
// ENCODER DISCIPLINE
// =============================================================================
//
// No `test rN, rN` -- every zero-check uses `cmp reg, 0`. No `add
// reg, [mem]`, no `cmp reg, [mem]` -- every value staged through a
// register first. Every store is a qword `mov [mem], reg`. Every
// label prefixed `r121mb_` (reserved-word discipline).
//
// Design: cited by design/terminal/semantic-shell-materialization-
// plan.md §R121.M5. Companion paideia-os#2501 briefing.

module R121PipeEdgeMintBind = structure {

  pub let mut _r121mb_stage             : u64 = 0
  pub let mut _r121mb_saved_witness_gate : u64 = 0

  pub let tag_boot_pipe_mint_bind_ok : [u8; 26] = "boot pipe mint bind ok --\0"
  pub let r121mb_fail_msg            : [u8; 25] = "boot pipe mint bind fail\0"

  // Synthetic schema_id: any non-zero u32 distinguishable from the
  // sibling R121 witnesses' schemas (M1=0x121E, M2=0x121F/0x121C/
  // 0x121D, M4=0x1220/0x1221, M6=0x1222). 0x1223 keeps the R121
  // range contiguous.
  pub let R121MB_SCHEMA_ID : u64 = 0x1223

  // ==========================================================================
  // witness_r121_pipe_edge_mint_bind() -> ()
  //
  // Five callee-save pushes (rbx, r12-r15) leave rsp%16 == 0 for every
  // nested call (entry rsp%16 == 8, -40 -> %16 == 0), matching every
  // sibling witness in this cascade.
  //
  // Register plan (all callee-save-preserved through nested calls):
  //   r12 = prod_cap_slot (from first sys_pipe_edge_mint_body call)
  //   r13 = cons_cap_slot (from second sys_pipe_edge_mint_body call)
  //   r14 = prod_row_id   (walked back via pipeline_edge_row_of_slot
  //                        so teardown can pipeline_edge_free even if
  //                        cap_mint_write's target_ptr encoding shifts
  //                        in the future)
  //   r15 = cons_row_id   (same)
  //   rbx = scratch (kept in prologue for symmetry with sibling
  //                  witnesses' 5-push count)
  //
  // Stages recorded in _r121mb_stage before each step so a failure
  // fingerprint carries a distinguishing line number:
  //   1 = sys_pipe_edge_mint_body(PROD) refused
  //   2 = sys_pipe_edge_mint_body(CONS) refused
  //   3 = sys_pipe_edge_bind_body(prod, cons) refused
  //   4 = post-bind row walk-back failed (defensive assertion)
  // ==========================================================================
  pub let witness_r121_pipe_edge_mint_bind : () -> () !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R121.M5-followup (paideia-os #2501): boot witness for the CAP-MINT GAP closure end-to-end at the syscall surface. Sequence: (a) save the current _fd_hygiene_witness_active value into _r121mb_saved_witness_gate and flip the gate to 1 so the new `pipe edge mint sc ok` and `pipe edge bind sc ok` fingerprints emit. (b) Stage=1: sys_pipe_edge_mint_body(R121MB_SCHEMA_ID=0x1223, PE_ROLE_PROD=0, R_PE_ALL=0x007) -> prod_cap_slot. Fold to r121mb_fail if the return is a high-sentinel errno (rax >= 256 means either the cap_slot is out-of-range or an SPM_ERR_* signed errno; both are stage-1 failures). (c) Stage=2: same call with role=1 (CONS) -> cons_cap_slot. (d) Stage=3: sys_pipe_edge_bind_body(prod_cap_slot, cons_cap_slot). Success returns 0; any non-zero is an SPB_ERR_* errno. (e) Stage=4: walk both cap_slots back through pipeline_edge_row_of_slot to recover their row_ids for the teardown call -- defensive assertion the bind did not silently corrupt the cap_table descriptors. (f) Success emit: `boot pipe mint bind ok --` via klog_s1 (KV-less, so the caller-side substrate fingerprints carry the substantive detail). (g) Restore the witness gate to its saved value. (h) Teardown: cap_mint_write(cap_slot, 0, 0, 0) for both slots (scrub the descriptor back to KIND_NULL) and pipeline_edge_free(row_id) for both rows -- byte-identical-to-entry cleanup so a re-run sees the same free pool posture. Every failure arm converges on the same teardown so leaked state cannot escape a refused stage. Five callee-save pushes (rbx=scratch, r12=prod_cap_slot, r13=cons_cap_slot, r14=prod_row_id, r15=cons_row_id) deliver rsp%16==0 at every nested call. Encoder posture: no `test rN,rN`; imm64 walks stage through r10 register first; no `and reg, imm64` (0x007 / 0x121F fit imm32); reserved labels prefixed `r121mb_`. Effects (sysreg, mem) because every syscall body's klog emit path touches UART port-IO. Capabilities (boot, cap) because this witness runs from the boot cascade and mutates cap_table.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // ------------------------------------------------------------
        // (a) Save + flip the witness gate so the new syscall-surface
        // fingerprints emit.
        // ------------------------------------------------------------
        mov rax, [rip + _fd_hygiene_witness_active];
        mov [rip + _r121mb_saved_witness_gate], rax;
        mov rax, 1;
        mov [rip + _fd_hygiene_witness_active], rax;

        // ------------------------------------------------------------
        // Stage 1: mint PROD endpoint via the syscall body.
        // ------------------------------------------------------------
        mov rax, 1;
        mov [rip + _r121mb_stage], rax;

        mov rdi, 0x1223;                 // R121MB_SCHEMA_ID
        mov rsi, 0;                      // PE_ROLE_PROD
        mov rdx, 0x007;                  // R_PE_ALL
        call sys_pipe_edge_mint_body;

        // Success: rax in [0..255]. Failure: SPM_ERR_ENOMEM
        // (0xFFFFFFFFFFFFFFF4) or SPM_ERR_EINVAL (0xFFFFFFFFFFFFFFEA),
        // both >= 256.
        mov r10, 256;
        cmp rax, r10;
        jae r121mb_fail;

        mov r12, rax;                    // r12 = prod_cap_slot

        // ------------------------------------------------------------
        // Stage 2: mint CONS endpoint.
        // ------------------------------------------------------------
        mov rax, 2;
        mov [rip + _r121mb_stage], rax;

        mov rdi, 0x1223;
        mov rsi, 1;                      // PE_ROLE_CONS
        mov rdx, 0x007;
        call sys_pipe_edge_mint_body;

        mov r10, 256;
        cmp rax, r10;
        jae r121mb_fail_free_prod;       // teardown only the PROD side

        mov r13, rax;                    // r13 = cons_cap_slot

        // ------------------------------------------------------------
        // Stage 3: bind the pair.
        // ------------------------------------------------------------
        mov rax, 3;
        mov [rip + _r121mb_stage], rax;

        mov rdi, r12;
        mov rsi, r13;
        call sys_pipe_edge_bind_body;
        cmp rax, 0;
        jne r121mb_fail_free_both;

        // ------------------------------------------------------------
        // Stage 4: recover row_ids for teardown.
        // ------------------------------------------------------------
        mov rax, 4;
        mov [rip + _r121mb_stage], rax;

        mov rdi, r12;
        call pipeline_edge_row_of_slot;  // rax = row or PE_ROW_NONE (0xFF)
        cmp rax, 0xFF;
        je  r121mb_fail_free_both;
        mov r14, rax;                    // r14 = prod_row_id

        mov rdi, r13;
        call pipeline_edge_row_of_slot;
        cmp rax, 0xFF;
        je  r121mb_fail_free_both;
        mov r15, rax;                    // r15 = cons_row_id

        // ------------------------------------------------------------
        // Success emit: `boot pipe mint bind ok --` (KV-less).
        // The syscall-body emits (pipe edge mint sc ok, pipe edge
        // bind sc ok) already carried slot/row/prod_slot/cons_slot
        // to the wire, so this rollup is a boolean marker.
        // ------------------------------------------------------------
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_boot_pipe_mint_bind_ok];
        call klog_s1;

        jmp r121mb_out;

      // ============================================================
      // Failure funnel + teardown.
      // ============================================================

      r121mb_fail_free_both:
        // Both cap_slots are installed (r12/r13) and both rows exist.
        // Walk back to get row_ids for pipeline_edge_free (r14/r15
        // may not have been populated yet if bind failed at stage 3).
        mov rdi, r12;
        call pipeline_edge_row_of_slot;
        mov r14, rax;                    // may be PE_ROW_NONE; guarded below

        mov rdi, r13;
        call pipeline_edge_row_of_slot;
        mov r15, rax;

        // Scrub the CONS cap slot first (LIFO teardown).
        mov rdi, r13;
        xor rsi, rsi;                    // kind = KIND_NULL (0)
        xor rdx, rdx;                    // rights = 0
        xor rcx, rcx;                    // target_ptr = 0
        call cap_mint_write;

        // Scrub the PROD cap slot.
        mov rdi, r12;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        // Free rows if we recovered a valid row_id (< PE_MAX = 32).
        mov r10, 32;
        cmp r15, r10;
        jae r121mb_ffb_skip_cons;
        mov rdi, r15;
        call pipeline_edge_free;
      r121mb_ffb_skip_cons:
        mov r10, 32;
        cmp r14, r10;
        jae r121mb_fail;
        mov rdi, r14;
        call pipeline_edge_free;
        jmp r121mb_fail;

      r121mb_fail_free_prod:
        // Only PROD cap_slot is installed (r12); its row lives via
        // walk-back.
        mov rdi, r12;
        call pipeline_edge_row_of_slot;
        mov r14, rax;

        mov rdi, r12;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        mov r10, 32;
        cmp r14, r10;
        jae r121mb_fail;
        mov rdi, r14;
        call pipeline_edge_free;
        // fall through to r121mb_fail

      r121mb_fail:
        // Emit `boot pipe mint bind fail line=<stage>` via klog_s1_d1.
        mov rax, [rip + _r121mb_stage];
        mov rdi, 3;                      // LEVEL_INFO (INFO not ERR;
                                         //   sibling witnesses use INFO
                                         //   so the boot smoke does not
                                         //   pull a panic on a golden
                                         //   diff)
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + r121mb_fail_msg];
        lea rcx, [rip + k_line];
        mov r8,  rax;                    // v = stage
        call klog_s1_d1;
        jmp r121mb_restore_gate;

      r121mb_out:
        // Success teardown: scrub cap_slots + free rows.
        mov rdi, r13;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        mov rdi, r12;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        mov rdi, r15;
        call pipeline_edge_free;

        mov rdi, r14;
        call pipeline_edge_free;

      r121mb_restore_gate:
        // Restore the fd_hygiene witness gate to its saved value.
        mov rax, [rip + _r121mb_saved_witness_gate];
        mov [rip + _fd_hygiene_witness_active], rax;

        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
