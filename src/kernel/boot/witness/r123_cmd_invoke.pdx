// src/kernel/boot/witness/r123_cmd_invoke.pdx -- R123.M3 (paideia-os #2505)
//
// Boot-time witness for the R123.M3 in-process invoke ABI. Exercises
// the full mint -> register -> lookup -> invoke path for four light
// commands, one per functor_id in [100..103]:
//   functor_id 100 -> light_where  (LIGHT_WHERE_RET=100)
//   functor_id 101 -> light_sort   (LIGHT_SORT_RET =101)
//   functor_id 102 -> light_head   (LIGHT_HEAD_RET =102)
//   functor_id 103 -> light_count  (LIGHT_COUNT_RET=103)
//
// Wire fingerprint (four times, once per light command):
//   `cmd invoke inproc ok name=<packed-hex> ns=<dec>`
// emitted via klog_s1_x1_d1 (SUBSYS_CAP_, tag_cmd_invoke_inproc_ok).
// `name` renders the first 8 packed bytes of the module name (from
// the cmd_module row's inline name slot); `ns` renders the invoke's
// return value in decimal.
//
// =============================================================================
// SECTION 0  NAME COLLISION WITH R123.M2 SEEDS
// =============================================================================
//
// The R123.M2 witness (r123_cmd_registry.pdx) unconditionally seeds
// three synthetic entries into the LRU cache -- "find"/0x11,
// "where"/0x22, "sort"/0x33 -- and comments "No teardown: the cache
// entries stay live for the remainder of the boot". Those cap_handles
// are NON-ROW-INDEX placeholders (0x11 = 17, > CI_CM_MAX = 16), so
// they invoke as CI_BAD_CAP.
//
// cmd_registry_insert refuses to overwrite on name-collision (returns
// CR_INSERT_DUP, keeps the OLD cap_handle) and no evict/update API
// exists yet. If this M3 witness inserted under the plan's names
// ("where", "sort") the registry would keep the M2 placeholders and
// the M3 invoke path would fail with CI_BAD_CAP.
//
// DEVIATION FROM PARENT BRIEFING: this witness registers the four
// entries under M3-namespaced names ("l_where", "l_sort", "l_head",
// "l_count" -- the "l_" prefix mirrors the CmdLight module's
// light_XXX function-name convention). The FUNCTIONS themselves
// (light_where etc.) and their functor_ids (100..103) are unchanged.
// The alternative (touching M2 substrate to unseed placeholder names)
// violates the R123.M2 freeze; the alternative (adding a registry
// evict/update API here) exceeds M3 scope. A follow-up either grows
// the evict API and the M2 witness cleans up after itself, or the M2
// witness moves to a scratch namespace that never collides with real
// command names.
//
// =============================================================================
// SECTION 1  ROW LAYOUT PREREQUISITES
// =============================================================================
//
// This witness runs AFTER r123_cmd_module (which mints then FREES row
// 0 for "find") and r123_cmd_registry (which touches no cmd_module
// rows). At entry all 16 rows are free. Our four cmd_module_alloc
// calls will claim rows 0, 1, 2, 3 in mint order (where/sort/head/
// count). Registry cap_handle for each is `row_idx + 1` per the
// CmdInvoke §1 "+1 offset discipline".
//
// =============================================================================
// SECTION 2  FAILURE FUNNEL STAGES
// =============================================================================
//
//    1..4  = cmd_module_alloc  refused for where/sort/head/count
//   11..14 = cmd_registry_insert refused / DUP for where/sort/head/count
//   21..24 = cmd_registry_lookup returned wrong cap_handle
//   31..34 = cmd_invoke_inproc  returned wrong value
//
// =============================================================================
// SECTION 3  ENCODER DISCIPLINE
// =============================================================================
//
// No `test rN, rN`; every zero-check uses `cmp reg, 0`. Every store
// to _r123ci_stage is a qword `mov [mem], reg`. Labels prefixed
// `r123ci_` (reserved-word discipline).

module R123CmdInvoke = structure {

  // =========================================================================
  // SECTION 4  STAGE COUNTER + FAILURE MESSAGE
  // =========================================================================

  pub let mut _r123ci_stage : u64 = 0

  // "boot cmd invoke fail" = 20 chars + NUL = 21.
  pub let r123ci_fail_msg : [u8; 21] = "boot cmd invoke fail\0"

  // =========================================================================
  // SECTION 5  COMMAND NAMES (M3-namespaced -- see §0)
  // =========================================================================

  // "l_where" = 7 chars + NUL = 8.
  pub let r123ci_name_where : [u8; 8] = "l_where\0"
  // "l_sort"  = 6 chars + NUL = 7.
  pub let r123ci_name_sort  : [u8; 7] = "l_sort\0"
  // "l_head"  = 6 chars + NUL = 7.
  pub let r123ci_name_head  : [u8; 7] = "l_head\0"
  // "l_count" = 7 chars + NUL = 8.
  pub let r123ci_name_count : [u8; 8] = "l_count\0"

  pub let R123CI_NAME_LEN_WHERE : u64 = 7
  pub let R123CI_NAME_LEN_SORT  : u64 = 6
  pub let R123CI_NAME_LEN_HEAD  : u64 = 6
  pub let R123CI_NAME_LEN_COUNT : u64 = 7

  // Synthetic argv buffer (marshalled through invoke ABI; the light
  // stubs read the first byte only, discard it). "arg1" = 4 chars +
  // NUL = 5; passed with argv_len = 4.
  pub let r123ci_argv : [u8; 5] = "arg1\0"

  // Expected functor-id-derived return values (must match cmd_light
  // .pdx §3 LIGHT_*_RET).
  pub let R123CI_EXPECT_WHERE : u64 = 100
  pub let R123CI_EXPECT_SORT  : u64 = 101
  pub let R123CI_EXPECT_HEAD  : u64 = 102
  pub let R123CI_EXPECT_COUNT : u64 = 103

  // vers_func packing helper values. vers_func layout (matches
  // cmd_module.pdx §2 [+24]):
  //   [15:0]  = version_maj = 1
  //   [31:16] = version_min = 0
  //   [63:32] = functor_id
  // Precomputed constants: (functor_id << 32) | 1.
  pub let R123CI_VF_WHERE : u64 = 0x0000006400000001    // 100 = 0x64
  pub let R123CI_VF_SORT  : u64 = 0x0000006500000001    // 101 = 0x65
  pub let R123CI_VF_HEAD  : u64 = 0x0000006600000001    // 102 = 0x66
  pub let R123CI_VF_COUNT : u64 = 0x0000006700000001    // 103 = 0x67

  // =========================================================================
  // SECTION 6  witness_r123_cmd_invoke() -> ()
  //
  // Sequence:
  //   Stage  1..4  MINT   four rows via cmd_module_alloc. Row indices
  //                stashed in r12/r13/r14/r15.
  //   Stage 11..14 REGISTER via cmd_registry_insert with
  //                cap_handle = row_idx + 1. Each expects
  //                CR_INSERT_OK (0).
  //   Stage 21/31, 22/32, 23/33, 24/34: per-command LOOKUP + INVOKE.
  //                Each lookup returns cap_handle; invoke calls
  //                cmd_invoke_inproc(cap, 0, &r123ci_argv, 4, 0, 0);
  //                return value asserted; fingerprint emitted.
  //
  // Register plan: five callee-save pushes leave rsp%16==0 at every
  // nested call (entry rsp%16==8, +40 -> %16==0). rbx = per-loop
  // scratch (expected cap_handle across per-command sequence); r12
  // /r13/r14/r15 stash row indices for where/sort/head/count.
  // klog_s1_x1_d1 caller-push idiom (sub rsp,8; push v2; call; add
  // rsp,16) keeps alignment. Labels prefixed r123ci_.
  // =========================================================================

  pub let witness_r123_cmd_invoke : () -> () !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R123.M3 (paideia-os #2505): boot witness for the in-process invoke ABI. Sequence: (1) mint 4 KIND_CMD_MODULE rows via cmd_module_alloc (l_where/l_sort/l_head/l_count with functor_ids 100/101/102/103, ver=1.0, in_process=1, cap_env=0); (2) insert each into cmd_registry with cap_handle=row_idx+1 per the CmdInvoke §1 +1 offset discipline (0 stays reserved as the registry's free-slot sentinel); (3) for each: cmd_registry_lookup returns the stashed cap_handle, cmd_invoke_inproc(cap, 0, &r123ci_argv, 4, 0, 0) returns the functor-id-derived value (100/101/102/103), fingerprint `cmd invoke inproc ok name=<packed hex> ns=<dec>` emits via klog_s1_x1_d1 (SUBSYS_CAP_, tag_cmd_invoke_inproc_ok). Command names carry an `l_` M3-namespace prefix (l_where etc.) to avoid the R123.M2 witness's placeholder-cap_handle seeds (where/0x22, sort/0x33) which would otherwise fail cmd_registry_insert with CR_INSERT_DUP and leak stale non-row-index cap_handles into invoke -- see §0 for the design deviation. Register plan: 5 callee-save pushes (rbx=scratch, r12=row_where, r13=row_sort, r14=row_head, r15=row_count) leave rsp%16==0 at nested calls (entry %16==8, +40 -> %16==0). klog_s1_x1_d1 caller-push (sub rsp,8; push v2; call; add rsp,16) keeps alignment. Failure funnel emits `boot cmd invoke fail line=<stage>` via klog_s1_d1 (LEVEL_INFO). No teardown: the four cmd_module rows and four registry entries stay live for the remainder of boot (matches R123.M2 witness posture). Labels prefixed r123ci_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // ==============================================================
        // Stage 1: mint "l_where" (functor_id 100).
        // ==============================================================
        mov rax, 1;
        mov [rip + _r123ci_stage], rax;

        lea rdi, [rip + r123ci_name_where];
        mov rsi, 7;                      // R123CI_NAME_LEN_WHERE
        mov rdx, 0x0000006400000001;     // R123CI_VF_WHERE
        mov rcx, 1;                      // in_process = 1
        xor r8,  r8;                     // cap_env = 0
        call cmd_module_alloc;
        // Success returns row_idx in [0..CM_MAX-1]=[0..15]; failure
        // codes live in the 0xFFFFEBB* band (all >= 16).
        mov r10, 16;
        cmp rax, r10;
        jae r123ci_fail;
        mov r12, rax;                    // r12 = row_where

        // ==============================================================
        // Stage 2: mint "l_sort" (functor_id 101).
        // ==============================================================
        mov rax, 2;
        mov [rip + _r123ci_stage], rax;

        lea rdi, [rip + r123ci_name_sort];
        mov rsi, 6;                      // R123CI_NAME_LEN_SORT
        mov rdx, 0x0000006500000001;     // R123CI_VF_SORT
        mov rcx, 1;
        xor r8,  r8;
        call cmd_module_alloc;
        mov r10, 16;
        cmp rax, r10;
        jae r123ci_fail;
        mov r13, rax;                    // r13 = row_sort

        // ==============================================================
        // Stage 3: mint "l_head" (functor_id 102).
        // ==============================================================
        mov rax, 3;
        mov [rip + _r123ci_stage], rax;

        lea rdi, [rip + r123ci_name_head];
        mov rsi, 6;                      // R123CI_NAME_LEN_HEAD
        mov rdx, 0x0000006600000001;     // R123CI_VF_HEAD
        mov rcx, 1;
        xor r8,  r8;
        call cmd_module_alloc;
        mov r10, 16;
        cmp rax, r10;
        jae r123ci_fail;
        mov r14, rax;                    // r14 = row_head

        // ==============================================================
        // Stage 4: mint "l_count" (functor_id 103).
        // ==============================================================
        mov rax, 4;
        mov [rip + _r123ci_stage], rax;

        lea rdi, [rip + r123ci_name_count];
        mov rsi, 7;                      // R123CI_NAME_LEN_COUNT
        mov rdx, 0x0000006700000001;     // R123CI_VF_COUNT
        mov rcx, 1;
        xor r8,  r8;
        call cmd_module_alloc;
        mov r10, 16;
        cmp rax, r10;
        jae r123ci_fail;
        mov r15, rax;                    // r15 = row_count

        // ==============================================================
        // Stage 11: register "l_where" cap_handle = row_where + 1.
        // ==============================================================
        mov rax, 11;
        mov [rip + _r123ci_stage], rax;

        mov rdi, r12;
        add rdi, 1;                      // cap_handle
        lea rsi, [rip + r123ci_name_where];
        mov rdx, 7;
        call cmd_registry_insert;
        cmp rax, 0;                      // CR_INSERT_OK
        jne r123ci_fail;

        // Stage 12: register "l_sort".
        mov rax, 12;
        mov [rip + _r123ci_stage], rax;

        mov rdi, r13;
        add rdi, 1;
        lea rsi, [rip + r123ci_name_sort];
        mov rdx, 6;
        call cmd_registry_insert;
        cmp rax, 0;
        jne r123ci_fail;

        // Stage 13: register "l_head".
        mov rax, 13;
        mov [rip + _r123ci_stage], rax;

        mov rdi, r14;
        add rdi, 1;
        lea rsi, [rip + r123ci_name_head];
        mov rdx, 6;
        call cmd_registry_insert;
        cmp rax, 0;
        jne r123ci_fail;

        // Stage 14: register "l_count".
        mov rax, 14;
        mov [rip + _r123ci_stage], rax;

        mov rdi, r15;
        add rdi, 1;
        lea rsi, [rip + r123ci_name_count];
        mov rdx, 7;
        call cmd_registry_insert;
        cmp rax, 0;
        jne r123ci_fail;

        // ==============================================================
        // Stage 21 + 31: lookup + invoke "l_where" -> expect 100.
        // ==============================================================
        mov rax, 21;
        mov [rip + _r123ci_stage], rax;

        lea rdi, [rip + r123ci_name_where];
        mov rsi, 7;
        call cmd_registry_lookup;
        mov rbx, r12;
        add rbx, 1;                      // expected cap = row_where + 1
        cmp rax, rbx;
        jne r123ci_fail;

        mov rax, 31;
        mov [rip + _r123ci_stage], rax;

        mov rdi, rbx;                    // cap_handle
        xor rsi, rsi;                    // stream_in_edge
        lea rdx, [rip + r123ci_argv];    // argv_ptr
        mov rcx, 4;                      // argv_len
        xor r8,  r8;                     // cap_env
        xor r9,  r9;                     // stream_out_edge
        call cmd_invoke_inproc;
        cmp rax, 100;                    // R123CI_EXPECT_WHERE
        jne r123ci_fail;

        // Fingerprint: read packed name qword from the row via
        // cmd_module_get_name_ptr, emit via klog_s1_x1_d1.
        mov rdi, r12;
        call cmd_module_get_name_ptr;
        mov r10, [rax + 0];              // packed name qword

        sub rsp, 8;
        mov rax, 100;                    // vd = ns value
        push rax;
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + tag_cmd_invoke_inproc_ok];
        lea rcx, [rip + k_name];
        mov r8,  r10;                    // packed name (hex)
        lea r9,  [rip + k_ns];
        call klog_s1_x1_d1;
        add rsp, 16;

        // ==============================================================
        // Stage 22 + 32: lookup + invoke "l_sort" -> expect 101.
        // ==============================================================
        mov rax, 22;
        mov [rip + _r123ci_stage], rax;

        lea rdi, [rip + r123ci_name_sort];
        mov rsi, 6;
        call cmd_registry_lookup;
        mov rbx, r13;
        add rbx, 1;
        cmp rax, rbx;
        jne r123ci_fail;

        mov rax, 32;
        mov [rip + _r123ci_stage], rax;

        mov rdi, rbx;
        xor rsi, rsi;
        lea rdx, [rip + r123ci_argv];
        mov rcx, 4;
        xor r8,  r8;
        xor r9,  r9;
        call cmd_invoke_inproc;
        cmp rax, 101;
        jne r123ci_fail;

        mov rdi, r13;
        call cmd_module_get_name_ptr;
        mov r10, [rax + 0];

        sub rsp, 8;
        mov rax, 101;
        push rax;
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + tag_cmd_invoke_inproc_ok];
        lea rcx, [rip + k_name];
        mov r8,  r10;
        lea r9,  [rip + k_ns];
        call klog_s1_x1_d1;
        add rsp, 16;

        // ==============================================================
        // Stage 23 + 33: lookup + invoke "l_head" -> expect 102.
        // ==============================================================
        mov rax, 23;
        mov [rip + _r123ci_stage], rax;

        lea rdi, [rip + r123ci_name_head];
        mov rsi, 6;
        call cmd_registry_lookup;
        mov rbx, r14;
        add rbx, 1;
        cmp rax, rbx;
        jne r123ci_fail;

        mov rax, 33;
        mov [rip + _r123ci_stage], rax;

        mov rdi, rbx;
        xor rsi, rsi;
        lea rdx, [rip + r123ci_argv];
        mov rcx, 4;
        xor r8,  r8;
        xor r9,  r9;
        call cmd_invoke_inproc;
        cmp rax, 102;
        jne r123ci_fail;

        mov rdi, r14;
        call cmd_module_get_name_ptr;
        mov r10, [rax + 0];

        sub rsp, 8;
        mov rax, 102;
        push rax;
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + tag_cmd_invoke_inproc_ok];
        lea rcx, [rip + k_name];
        mov r8,  r10;
        lea r9,  [rip + k_ns];
        call klog_s1_x1_d1;
        add rsp, 16;

        // ==============================================================
        // Stage 24 + 34: lookup + invoke "l_count" -> expect 103.
        // ==============================================================
        mov rax, 24;
        mov [rip + _r123ci_stage], rax;

        lea rdi, [rip + r123ci_name_count];
        mov rsi, 7;
        call cmd_registry_lookup;
        mov rbx, r15;
        add rbx, 1;
        cmp rax, rbx;
        jne r123ci_fail;

        mov rax, 34;
        mov [rip + _r123ci_stage], rax;

        mov rdi, rbx;
        xor rsi, rsi;
        lea rdx, [rip + r123ci_argv];
        mov rcx, 4;
        xor r8,  r8;
        xor r9,  r9;
        call cmd_invoke_inproc;
        cmp rax, 103;
        jne r123ci_fail;

        mov rdi, r15;
        call cmd_module_get_name_ptr;
        mov r10, [rax + 0];

        sub rsp, 8;
        mov rax, 103;
        push rax;
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + tag_cmd_invoke_inproc_ok];
        lea rcx, [rip + k_name];
        mov r8,  r10;
        lea r9,  [rip + k_ns];
        call klog_s1_x1_d1;
        add rsp, 16;

        jmp r123ci_out;

      // ================================================================
      // Failure funnel: emit `boot cmd invoke fail line=<stage>` via
      // klog_s1_d1 (LEVEL_INFO, matching sibling R123 witnesses so the
      // boot smoke does not pull a panic on golden diff).
      // ================================================================
      r123ci_fail:
        mov rax, [rip + _r123ci_stage];
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + r123ci_fail_msg];
        lea rcx, [rip + k_line];
        mov r8,  rax;                    // v = stage
        call klog_s1_d1;

      r123ci_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
