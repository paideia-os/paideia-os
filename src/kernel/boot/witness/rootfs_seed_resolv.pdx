// src/kernel/boot/witness/rootfs_seed_resolv.pdx — R100-PREP-004
// (paideia-os #2010). Seeds `/system/net/resolv.conf` — the single-
// line resolver config libpdx-net's resolver M2 reads at process
// startup to learn the DNS server address.
//
// Contract (this issue's v1 grammar):
//   * One `nameserver <ipv4>` line per file line.
//   * Lines beginning with `#` reserved for comments (parser
//     convention, not exercised at v1 seed).
//   * No `search`, `options`, or IPv6 directives at v1 — parser
//     will treat unrecognised keywords as errors, but the seeded
//     content stays inside that narrow grammar so a M2-side parser
//     landing in a later PR will parse this file cleanly.
//   * Address `10.0.2.3` = QEMU SLIRP's default DNS gateway; matches
//     the R100 wave's assumed dev-topology (see design/net/dev-
//     topology.md when it lands). Real-hardware / bare-metal boot
//     will require a different seed or a runtime rewrite; that is
//     out of scope for this issue.
//
// -----------------------------------------------------------------------------
// Placement in the boot cascade
// -----------------------------------------------------------------------------
//
// Called from `boot_continue_after_ring3` in kernel_main.pdx immediately
// AFTER `witness_rootfs_seed_policy` (~line 1211). By that point
// `/system` is already a real directory in the tmpfs tree and its
// vnode-pool slot is wired, but `/system/net` does NOT yet exist —
// rootfs_dir_seeds.pdx creates `/system/{packages,keys,trash}` only.
// This witness therefore CREATES `/system/net` before creating the
// resolv.conf child, following the same discipline
// rootfs_dir_seeds.pdx uses for its own new intermediate directories.
//
// -----------------------------------------------------------------------------
// Pattern
// -----------------------------------------------------------------------------
//
// Structure lifted from rootfs_seed_policy.pdx, with one extra stage
// inserted between "recover system" and "create the file" to
// tmpfs_create /system/net as a DIR:
//
//   Stage 1: mount_root_vnode + tmpfs_lookup("system") +
//            vnode_cache_or_alloc for /system.
//   Stage 2: tmpfs_create /system/net (DIR) +
//            vnode_cache_or_alloc for /system/net.
//   Stage 3: tmpfs_create /system/net/resolv.conf (REG) +
//            vnode_cache_or_alloc for the fresh child (return
//            discarded — no downstream consumer inside this witness,
//            same discipline bin_child_hello_seed's Step 5 documents).
//   Stage 4: tmpfs_write single-page payload
//            (`nameserver 10.0.2.3\n`, 20 bytes < 4096 so no chunking
//            loop needed — write.pdx §4.5's start_page == end_page
//            constraint holds by construction with offset=0).
//
// Register plan (matches rootfs_seed_policy.pdx's discipline):
//   r12 = root_inode_idx (= 1), set at Stage 1, never changes.
//   r15 = root_vn_idx (from mount_root_vnode), set at Stage 1, used
//         only as Stage 1's vnode_cache_or_alloc parent arg.
//   r13 = system_inode_idx at Stage 1 end; repurposed at Stage 2 to
//         hold net_inode_idx (system_inode_idx dead after Stage 2);
//         repurposed again at Stage 3 to hold resolv_inode_idx
//         (net_inode_idx dead after Stage 3).
//   r14 = system_vn_idx at Stage 1 end; repurposed at Stage 2 to
//         hold net_vn_idx (system_vn_idx dead after Stage 2); dead
//         after Stage 3.
//
// Fingerprint discipline (matches sibling seed witnesses):
//   OK  : klog_s1_d1(LEVEL_INFO=3, SUBSYS_BOOT, tag_resolv_seed_ok,
//         k_bytes, bytes_written) → "resolv seed ok [legacy: RESOLV
//         SEED OK] bytes=<N>"
//   FAIL: klog_s1_d1(LEVEL_ERROR=1, SUBSYS_BOOT, tag_resolv_seed_fail,
//         k_line, stage) → "resolv seed fail [legacy: RESOLV SEED
//         FAIL] line=<N>"
// The bracketed `[legacy: RESOLV SEED OK]` / `[legacy: RESOLV SEED
// FAIL]` segment is the coverage-gate tag (tools/verify-fingerprint-
// coverage.sh's OK_TOK regex fires on the uppercase OK there so this
// module's OK line is picked up as a coverage marker — same dual-form
// discipline rootfs_seed_policy.pdx / r100_prep_003_icmp_echo.pdx
// follow).
//
// Encoder conservatism: only mov / lea / cmp / je / jmp / call / xor
// / push / pop / ret — all pre-existing forms with no known encoder
// gap. No add-reg-[mem] (rootfs_dir_seeds.pdx's #1999 note flagged
// that as an encoder hazard). No 64-bit immediate loads (all
// constants fit in imm32 sign-extended positive: 0, 1, 2, 3, 4, 11,
// 20, 0xFFFF, plus the 0xFFFFFFFFFFFFFFFF sentinel that must be
// loaded via `mov rcx, imm64` per the write.pdx sentinel-load
// discipline). Labels are prefixed `resolv_seed_` to steer clear of
// paideia-as reserved-keyword labels (loop, if, ...) per
// feedback_paideia_as_reserved_labels.

module RootfsSeedResolv = structure {

  // ==========================================================================
  // Data
  // ==========================================================================

  // Stage counter: bumped at the top of each of the four stages so the
  // FAIL fingerprint's `line=<N>` KV names the tripping stage. Confined
  // to this .o alone by convention (mirrors _policy_seed_stage /
  // _rfs_stage); no cross-module readers.
  pub let mut _resolv_seed_stage : u64 = 0

  // Fingerprint tags. Storage is +1 for the trailing NUL. klog_emit_core
  // appends the KV(s) plus its own trailing newline, so neither literal
  // carries an embedded `\n`. The bracketed `[legacy: ...]` segment is
  // the coverage-gate marker (see file header).
  //
  // "resolv seed ok [legacy: RESOLV SEED OK]" = 39 bytes wire + 1 NUL.
  pub let tag_resolv_seed_ok   : [u8; 40] = "resolv seed ok [legacy: RESOLV SEED OK]\0"
  //
  // "resolv seed fail [legacy: RESOLV SEED FAIL]" = 43 bytes wire + 1 NUL.
  pub let tag_resolv_seed_fail : [u8; 44] = "resolv seed fail [legacy: RESOLV SEED FAIL]\0"

  // Directory / file name literals. NUL-terminated for tmpfs_lookup /
  // tmpfs_create (tmpfs_create takes an explicit length; tmpfs_lookup
  // reads until NUL).
  pub let resolv_name_system : [u8; 7]  = "system\0"
  pub let resolv_name_net    : [u8; 4]  = "net\0"
  pub let resolv_name_file   : [u8; 12] = "resolv.conf\0"

  // Seeded default resolver content — see file header for the byte-
  // for-byte listing and its intended semantics. Storage is 21 = 20
  // wire bytes + 1 NUL. Written to /system/net/resolv.conf verbatim
  // (no NUL on the wire — tmpfs_write copies exactly len=20 bytes,
  // stopping short of the trailing NUL).
  //
  //   "nameserver 10.0.2.3\n"                              20
  //                                              total    20
  pub let _resolv_default_bytes : [u8; 21] = "nameserver 10.0.2.3\n\0"

  // ==========================================================================
  // witness_rootfs_seed_resolv() — top-level entry, called from
  // kernel_main immediately after witness_rootfs_seed_policy.
  // ==========================================================================
  pub let witness_rootfs_seed_resolv : () -> () !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R100-PREP-004 (paideia-os #2010): seeds /system/net/resolv.conf at boot with the single-line dev-topology default `nameserver 10.0.2.3\\n` (20 wire bytes; QEMU SLIRP default DNS gateway). Four-stage sequence, each stage stamping its number into _resolv_seed_stage before its own call so a FAIL fingerprint names exactly which one tripped (idiom borrowed from rootfs_seed_policy.pdx's _policy_seed_stage): (1) mount_root_vnode -> r15=root_vn_idx, r12=root_inode_idx=1; tmpfs_lookup(1, 'system') -> r13=system_inode_idx (witness_rootfs_dir_seeds Stage 5 already tmpfs_create'd /system, so a second create here would collide and return 0 -- matches rootfs_seed_policy.pdx's precedent per #1999 / #2119); vnode_cache_or_alloc(r15, r13, &_tmpfs_vops) -> r14=system_vn_idx (idempotent dedup returns the same slot rootfs_dir_seeds bound). (2) tmpfs_create(r13, 'net', 3, VNODE_TYPE_DIR=2) -> r13=net_inode_idx (system_inode_idx dead after this call -- reuses r13, matching rootfs_seed_policy.pdx Stage 2's own retired-inode reuse discipline). Failure gate checks BOTH rax==0 (create-failed) and rax==0xFFFF (TMPFS_INODE_ALLOC_OOM). Then vnode_cache_or_alloc(r14, r13, &_tmpfs_vops) -> r14=net_vn_idx (system_vn_idx dead after this call). Gate checks rax==0xFFFF (VNODE_ALLOC_OOM). (3) tmpfs_create(r13, 'resolv.conf', 11, VNODE_TYPE_REG=1) -> r13=resolv_inode_idx (net_inode_idx dead after this call). Same 0 / 0xFFFF failure gate. vnode_cache_or_alloc(r14, r13, &_tmpfs_vops) -- fresh vnode-pool slot for /system/net/resolv.conf; return discarded (no downstream consumer inside this witness -- same discipline bin_child_hello_seed's Step 5 documents). Gate checks rax==0xFFFF (VNODE_ALLOC_OOM). (4) tmpfs_write(r13, &_resolv_default_bytes, 20, 0) -- single-page write (20 << 4096, single-page constraint per write.pdx §4.5 holds by construction; no chunking loop needed). Gate checks rax==0xFFFFFFFFFFFFFFFF (VOPS_ERR_SENTINEL, matching bin_child_hello_seed's Step 7 sentinel-load-via-rcx discipline -- AND/CMP has no imm64 form). All failure exits converge on resolv_seed_fail, which reads _resolv_seed_stage back into r8 and emits klog_s1_d1(LEVEL_ERROR=1, SUBSYS_BOOT, tag_resolv_seed_fail, k_line, stage) -> 'resolv seed fail [legacy: RESOLV SEED FAIL] line=<N>'. All-green path emits klog_s1_d1(LEVEL_INFO=3, SUBSYS_BOOT, tag_resolv_seed_ok, k_bytes, bytes_written) -> 'resolv seed ok [legacy: RESOLV SEED OK] bytes=20'. Single `push rbp` at entry restores the rsp%16==8 -> %16==0 parity boot_continue_after_ring3's whole call chain depends on (see bin_seeds.pdx module header); matching `pop rbp; ret` at exit. Effects/capabilities {sysreg, mem} @{boot}: mem for every mount_root_vnode / tmpfs_lookup / tmpfs_create / vnode_cache_or_alloc / tmpfs_write call (all declared !{mem} @{}), sysreg transitively via klog_s1_d1's own TSC read and tmpfs_create's !{mem, sysreg}, boot matching every sibling tmpfs-seed witness in this directory. Encoder: mov / lea / cmp / je / jmp / call / xor / push / pop / ret -- all pre-existing, no encoder gap; no add reg,[mem] anywhere (no byte-level path parsing in this module). Labels prefixed resolv_seed_; stage counter prefixed _resolv_seed_stage.",
      block: {
        push rbp;

        // ---------- Stage 1: recover root + system inode / vnode ----------
        mov rax, 1;
        lea rcx, [rip + _resolv_seed_stage];
        mov [rcx], rax;

        call mount_root_vnode;
        cmp rax, 0;
        je resolv_seed_fail;
        mov r15, rax;                             // r15 = root_vn_idx
        mov r12, 1;                               // r12 = root_inode_idx

        mov rdi, r12;
        lea rsi, [rip + resolv_name_system];
        call tmpfs_lookup;                        // rax = system_inode_idx | 0 (miss)
        cmp rax, 0;
        je resolv_seed_fail;
        mov r13, rax;                             // r13 = system_inode_idx

        mov rdi, r15;                             // arg1: parent = root_vn_idx
        mov rsi, r13;                             // arg2: backend = system_inode_idx
        lea rdx, [rip + _tmpfs_vops];             // arg3: ops = &_tmpfs_vops
        call vnode_cache_or_alloc;                // rax = system_vn_idx | 0xFFFF
        mov rcx, 0xFFFF;
        cmp rax, rcx;
        je resolv_seed_fail;                      // VNODE_ALLOC_OOM
        mov r14, rax;                             // r14 = system_vn_idx

        // ---------- Stage 2: tmpfs_create(system_inode_idx, "net", 3, DIR=2) ----------
        mov rax, 2;
        lea rcx, [rip + _resolv_seed_stage];
        mov [rcx], rax;

        mov rdi, r13;                             // dir_inode_idx = system
        lea rsi, [rip + resolv_name_net];         // "net\0"
        mov rdx, 3;                               // name_len
        mov rcx, 2;                               // VNODE_TYPE_DIR
        call tmpfs_create;                        // rax = net_inode_idx | 0 | 0xFFFF
        cmp rax, 0;
        je resolv_seed_fail;
        mov rcx, 0xFFFF;
        cmp rax, rcx;
        je resolv_seed_fail;                      // TMPFS_INODE_ALLOC_OOM
        mov r13, rax;                             // r13 = net_inode_idx (system_inode_idx retired)

        mov rdi, r14;                             // arg1: parent = system_vn_idx
        mov rsi, r13;                             // arg2: backend = net_inode_idx
        lea rdx, [rip + _tmpfs_vops];             // arg3: ops = &_tmpfs_vops
        call vnode_cache_or_alloc;                // rax = net_vn_idx | 0xFFFF
        mov rcx, 0xFFFF;
        cmp rax, rcx;
        je resolv_seed_fail;                      // VNODE_ALLOC_OOM
        mov r14, rax;                             // r14 = net_vn_idx (system_vn_idx retired)

        // ---------- Stage 3: tmpfs_create(net_inode_idx, "resolv.conf", 11, REG=1) ----------
        mov rax, 3;
        lea rcx, [rip + _resolv_seed_stage];
        mov [rcx], rax;

        mov rdi, r13;                             // dir_inode_idx = net
        lea rsi, [rip + resolv_name_file];        // "resolv.conf\0"
        mov rdx, 11;                              // name_len
        mov rcx, 1;                               // VNODE_TYPE_REG
        call tmpfs_create;                        // rax = resolv_inode_idx | 0 | 0xFFFF
        cmp rax, 0;
        je resolv_seed_fail;
        mov rcx, 0xFFFF;
        cmp rax, rcx;
        je resolv_seed_fail;                      // TMPFS_INODE_ALLOC_OOM
        mov r13, rax;                             // r13 = resolv_inode_idx (net_inode_idx retired)

        mov rdi, r14;                             // arg1: parent = net_vn_idx
        mov rsi, r13;                             // arg2: backend = resolv_inode_idx
        lea rdx, [rip + _tmpfs_vops];             // arg3: ops = &_tmpfs_vops
        call vnode_cache_or_alloc;                // rax = resolv_vn_idx | 0xFFFF
        mov rcx, 0xFFFF;
        cmp rax, rcx;
        je resolv_seed_fail;                      // VNODE_ALLOC_OOM

        // ---------- Stage 4: tmpfs_write(resolv_inode_idx, &bytes, 20, 0) ----------
        // 20 < 4096, so the tmpfs_write single-page constraint
        // (write.pdx §4.5: start_page == end_page) holds by construction
        // with offset=0 -- no chunking loop needed. tmpfs_write returns
        // bytes_written (= 20) on success, or 0xFFFFFFFFFFFFFFFF
        // (VOPS_ERR_SENTINEL) on any gate failure.
        mov rax, 4;
        lea rcx, [rip + _resolv_seed_stage];
        mov [rcx], rax;

        mov rdi, r13;                             // arg0 = resolv_inode_idx
        lea rsi, [rip + _resolv_default_bytes];   // arg1 = payload base
        mov rdx, 20;                              // arg2 = len (wire bytes, excludes NUL)
        xor rcx, rcx;                             // arg3 = offset = 0
        call tmpfs_write;                         // rax = bytes_written or sentinel

        // Sentinel check: 0xFFFFFFFFFFFFFFFF (rcx-loaded because
        // AND/CMP has no imm64 form; matches bin_child_hello_seed's
        // Step 7 discipline).
        mov rcx, 0xFFFFFFFFFFFFFFFF;
        cmp rax, rcx;
        je resolv_seed_fail;

        // ---------- Success: emit OK fingerprint ----------
        // klog_s1_d1(LEVEL_INFO=3, SUBSYS_BOOT, tag_resolv_seed_ok,
        // k_bytes, rax=bytes_written) → composed wire line:
        //   "resolv seed ok [legacy: RESOLV SEED OK] bytes=<N>\n"
        // rax already holds the tmpfs_write return (bytes_written).
        mov r8, rax;                              // r8 = bytes_written
        mov rdi, 3;                               // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_resolv_seed_ok];
        lea rcx, [rip + k_bytes];
        call klog_s1_d1;
        jmp resolv_seed_done;

      resolv_seed_fail:
        // Read stage counter back and emit:
        //   "resolv seed fail [legacy: RESOLV SEED FAIL] line=<N>\n"
        lea rax, [rip + _resolv_seed_stage];
        mov r8, [rax];
        mov rdi, 1;                               // LEVEL_ERROR
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_resolv_seed_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;

      resolv_seed_done:
        pop rbp;
        ret
      }
    }
}
