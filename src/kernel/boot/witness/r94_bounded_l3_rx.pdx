// src/kernel/boot/witness/r94_bounded_l3_rx.pdx -- paideia-os #2221 D4
// (companion to D1/D2/D3 defect fixes for the R94 tag_l3_tcp spam that
// wedged boot at t~0.85s under stale-substrate carryover).
//
// Regression witness for the D4 rate-limit gate on tag_l3_tcp emission.
// Post-fix, the tcp_rx_handle wire-entry wrapper (see net/tcp.pdx) is
// the single source of tag_l3_tcp emissions AND _tcp_rx_pkts bumps
// (retransmit-loopback re-injection now goes through tcp_rx_deliver
// directly and neither emits nor bumps). The wrapper's D4 gate skips
// the klog_s1 call unless _tick_count - _tcp_rx_emit_last_tick >= 100,
// capping wire-side spam at 1 line per second even under a sustained
// inbound flow.
//
// This witness bounds the RX-side traffic ceiling over a ~500ms sti
// window (matching the urxw pattern: sti; rdtsc-bounded poll; cli).
// Under PAIDEIA_NIC=none there is no NIC and no inbound TCP: _tcp_rx_
// pkts delta MUST stay 0. Under PAIDEIA_NIC=virtio the DHCP handshake
// + DNS query + R94 TCP offbox roundtrip together produce fewer than
// 20 real RX packets in that window; the assertion catches any future
// regression that re-introduces the loopback re-entry into
// tcp_rx_handle (which under D2 would count each retransmit against
// _tcp_rx_pkts and blow the ceiling) OR any future substrate leak
// that lets tcp_poll_retransmits fire spurious retransmits without
// legitimate corresponding wire traffic.
//
// Timing: rdtsc-bounded 1_500_000_000 TSC ticks (~500ms at 3GHz,
// ~650ms at 2.3GHz -- host-frequency-dependent, same tolerance
// window urxw itself accepts). rdtsc is always alive regardless of
// LAPIC timer state; LAPIC timer LVT may still be masked at this
// point in the boot cascade (lapic_timer_init runs later per the
// urxw comment cluster at ~line 1795), but NIC IRQs come through
// IOAPIC/MSI and DO fire under our brief sti window, letting real
// virtio-net RX packets land in the ring and drive
// virtio_net_rx_drain -> ipv4_rx_handle -> tcp_rx_handle over the
// span.
//
// Fingerprint (all-lowercase, no OK_TOK -- not gated by
// verify-fingerprint-coverage.sh):
//   boot r94 bounded l3 rx ok -- delta=<n>
//
// Failure signal: missing fingerprint. Matches every other R94
// witness's fail-by-absence discipline (see tools/verify-fingerprint-
// coverage.sh's own description of the convention).
//
// Frame prologue: 4-push callee-save (rbx=_tcp_rx_pkts snapshot,
// r12=start_tsc, r13=delta once computed, r14=unused) + sub rsp,8
// for stack alignment. Entry rsp%16==8, 4 pushes (32B) -> rsp%16==8,
// sub 8 -> rsp%16==0 for the nested klog_s1_d1 call.
//
// Reserved labels: r94blr_ (R94 bounded l3 rx).

module R94BoundedL3Rx = structure {

  pub let witness_r94_bounded_l3_rx : () -> () !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "paideia-os #2221 D4 companion regression witness. Snapshot _tcp_rx_pkts, sti + rdtsc-bounded 1_500_000_000-tick poll (~500ms wall time at 3GHz, host-frequency-dependent per urxw precedent), cli, compute delta, emit tag_boot_r94_bounded_l3_rx_ok with delta=<n> iff delta<20. Fail-by-absence per every-R94-witness discipline. Bounds the RX-side traffic ceiling: under PAIDEIA_NIC=none delta MUST be 0 (no NIC, no inbound); under PAIDEIA_NIC=virtio DHCP + DNS + TCP offbox handshake together stay well below 20 in the window. Regression-catches any future re-emergence of the pre-D2 retransmit-loopback re-entry into tcp_rx_handle (which counted every retransmit against _tcp_rx_pkts) OR a future substrate leak that lets tcp_poll_retransmits fire spurious retransmits with no legitimate wire correspondent. Frame prologue implicit: 4-push callee-save (rbx=snapshot, r12=start_tsc, r13=delta, r14=unused pad) + sub rsp,8; entry rsp%16==8, 4 pushes 32B -> %16==8, sub 8 -> %16==0 for the nested klog_s1_d1 call. Reserved labels: r94blr_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        sub rsp, 8;

        // Snapshot _tcp_rx_pkts BEFORE arming sti so any pre-existing
        // wire packets from earlier in the boot cascade do NOT count
        // against our window's delta.
        mov rbx, [rip + _tcp_rx_pkts];

        // Capture start TSC as a wall-clock reference. rdtsc writes
        // edx:eax; assemble into rax by shl rdx,32 + or.
        rdtsc;
        shl rdx, 32;
        or rax, rdx;
        mov r12, rax;

        sti;

      r94blr_wait:
        rdtsc;
        shl rdx, 32;
        or rax, rdx;
        sub rax, r12;
        mov rcx, 1500000000;               // ~500ms at 3GHz (urxw uses 2G for ~0.68s)
        cmp rax, rcx;
        jb r94blr_wait;

        cli;

        // Compute delta = now - snapshot. Store in r13 so it survives
        // the branch + klog_s1_d1 call.
        mov rax, [rip + _tcp_rx_pkts];
        sub rax, rbx;
        mov r13, rax;

        // Assertion: delta < 20. On failure (delta >= 20) skip emit.
        // The missing fingerprint is the failure signal per this
        // tree's fingerprint-diff smoke discipline.
        cmp r13, 20;
        jae r94blr_done;

        // Emit fingerprint with delta=<n>. Uses klog_s1_d1 which
        // appends " delta=<n>" to the tag literal, matching the
        // sibling `boot r94 retransmit ok -- rxmt=<N>` shape.
        mov r8, r13;
        mov rdi, 3;                        // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_boot_r94_bounded_l3_rx_ok];
        lea rcx, [rip + k_delta];
        call klog_s1_d1;

      r94blr_done:
        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
