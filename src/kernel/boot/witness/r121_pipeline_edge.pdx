// src/kernel/boot/witness/r121_pipeline_edge.pdx -- R121.M1 (paideia-os #2495)
//
// Boot-time witness for KIND_PIPELINE_EDGE end-to-end at M1: mints one
// endpoint via pipeline_edge_alloc (which itself emits the plan's
// mandated `pipe edge mint ok kind=<hex> schema_id=<hex> role=<hex>`
// fingerprint from inside the mint body -- see cap/pipeline_edge.pdx
// §12), reads the role back through the row accessor (proof-of-life
// that the row substrate landed correctly), then frees the row via
// pipeline_edge_free. Emits a rollup `boot pipe edge ok kind=<hex>
// row=<hex>` on success, `boot pipe edge fail line=<n>` on any step
// refusal.
//
// M1 discipline: no cap-slot install (deferred to R121.M5 shell
// integration); no bind (deferred to R121.M4 duality checker); no
// SEND/RECV (deferred to R121.M2 transport). The mint fingerprint is
// the only R121.M1 acceptance anchor per the plan's own criterion.
//
// =============================================================================
// PREREQUISITES THIS FILE MINTS (all torn down on every exit)
// =============================================================================
//
// A single KIND_PIPELINE_EDGE row (pipeline_edge_alloc), freed on
// success and on every refusal arm. No cap_table slots consumed:
// R121.M1's mint helper returns a bare row_idx (not a cap_slot); a
// cap_table install at this landing would prejudge R121.M5 shell-side
// slot allocation.
//
// The witness's synthetic schema_id (0x121E for "R121 edge") is any
// non-zero u32; the schema-registry is not consulted at M1, so the
// witness does not need a live SREG row for this id.
//
// =============================================================================
// KLOG WRAPPER CHOICE
// =============================================================================
//
// The rollup fingerprint carries two hex KVs (kind, row), so this file
// uses klog_s1_x2 (core/klog/wrappers.pdx), matching r100_tls_trust /
// r91_kind_nic's own wrapper choice for their two-KV emits. The stack
// push+pop for the 7th (v2) arg is identical.
//
// The mint fingerprint itself (`pipe edge mint ok kind=<hex> schema_id
// =<hex> role=<hex>`) is emitted from INSIDE pipeline_edge_alloc via
// klog_s1_x3; this witness is the first-ever caller of that path, so
// tools/verify-fingerprint-coverage.sh will need an allowlist entry
// for `pipe edge mint ok` naming this witness as its sole gold-file
// coverage source (same "no golden pins the exact literal; the witness's
// own lowercase rollup covers the code path" argument the sibling
// KIND_NIC / KIND_TUI_CANVAS mint-marker entries take there).
//
// =============================================================================
// FINGERPRINT
// =============================================================================
//
// Success: "boot pipe edge ok -- kind=<hex> row=<hex>" (klog_s1_x2).
// Deliberately all-lowercase with no bracketed "[legacy: ... OK]"
// suffix, matching r91_kind_nic / r100_tls_trust posture.
//
// Failure: "boot pipe edge fail line=<n>" (klog_s1_d1), stage stamped
// into _r121pe_stage before every step. No boot_bail_or_continue call;
// failure falls through to cleanup + return, matching sibling witnesses.
//
// =============================================================================
// ENCODER DISCIPLINE
// =============================================================================
//
// No `test rN, rN`; every zero-check uses `cmp reg, 0`. No `add reg,
// [mem]`, no `cmp reg, [mem]` -- every value staged through a register
// first. Every store is a qword `mov [mem], reg`. Every label prefixed
// `r121pe_` (reserved-word discipline -- `loop`/`if`/`top`/`done` are
// keywords).

module R121PipelineEdge = structure {

  pub let mut _r121pe_stage : u64 = 0

  pub let tag_boot_pipe_edge_ok : [u8; 21] = "boot pipe edge ok --\0"
  pub let r121pe_fail_msg       : [u8; 20] = "boot pipe edge fail\0"
  pub let r121pe_k_row          : [u8; 4]  = "row\0"

  // Synthetic schema_id for the M1 witness. Any non-zero u32
  // distinguishable from schemas the R90-XREPO.012 wave registered;
  // 0x121E (visual pun on "R121 edge") makes the origin obvious in a
  // raw pool dump.
  pub let R121PE_SCHEMA_ID : u64 = 0x121E

  // ==========================================================================
  // witness_r121_pipeline_edge() -> ()
  //
  // Five callee-save pushes (rbx, r12-r15) leave rsp%16 == 0 for every
  // nested call (entry rsp%16 == 8, -40 -> %16 == 0), matching sibling
  // witnesses in this cascade. Register plan (all callee-save, survive
  // every nested call by SysV convention):
  //   r12 = row_idx returned by pipeline_edge_alloc
  //   r13 = role byte read back through pe_row_role
  //   rbx / r14 / r15 reserved for future extensions.
  //
  // Stages recorded in _r121pe_stage before each step so a failure
  // fingerprint carries a distinguishing line number:
  //   1 = pipeline_edge_alloc refused (any PE_MINT_BAD_* / PE_TAIL_ENOSPC)
  //   2 = pe_row_role read-back mismatch (expected PE_ROLE_PROD = 0)
  //   3 = pipeline_edge_free refused (PE_FREE_BAD_SLOT)
  // ==========================================================================
  pub let witness_r121_pipeline_edge : () -> () !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R121.M1 (paideia-os #2495): boot witness for KIND_PIPELINE_EDGE M1 end-to-end. Sequence: (1) pipeline_edge_alloc(R121PE_SCHEMA_ID, PE_ROLE_PROD=0, R_PE_SEND=0x001) -> row_idx; stage=1 on refusal. (2) pe_row_role(row_idx) -> role byte; expected PE_ROLE_PROD (0); stage=2 on mismatch. (3) pipeline_edge_free(row_idx) -> 0; stage=3 on PE_FREE_BAD_SLOT. On success emit rollup `boot pipe edge ok -- kind=<hex> row=<hex>` via klog_s1_x2 (v2 = row_idx pushed onto the stack with the standard `sub rsp,8; push v2; call; add rsp,16` idiom, identical to r100_tls_trust). The mint fingerprint itself (pipe edge mint ok kind=<hex> schema_id=<hex> role=<hex>) is emitted from INSIDE pipeline_edge_alloc, so this witness makes that emit path reachable for the first time at boot. Failure funnel emits `boot pipe edge fail line=<stage>` via klog_s1_d1. Row cleanup runs on every exit (success and every failure arm) via pipeline_edge_free before return -- a refused mint leaves no row live so the cleanup call is a no-op in that case (pipeline_edge_free returns PE_FREE_BAD_SLOT which we swallow at teardown; PE_ST_FREES is not double-bumped). Five callee-save pushes (rbx=scratch, r12=row_idx, r13=role, r14/r15=scratch) leave rsp%16==0 at every nested call (entry rsp%16==8, +40 -> %16==0), matching every sibling witness in this cascade. Labels prefixed r121pe_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // ------------------------------------------------------------
        // Stage 1: mint one endpoint (schema=R121PE_SCHEMA_ID, role=PROD,
        // rights=R_PE_SEND). pipeline_edge_alloc emits the mint
        // fingerprint on success from inside its body.
        // ------------------------------------------------------------
        mov rax, 1;
        mov [rip + _r121pe_stage], rax;

        mov rdi, 0x121E;                 // R121PE_SCHEMA_ID
        mov rsi, 0;                      // PE_ROLE_PROD
        mov rdx, 0x001;                  // R_PE_SEND
        call pipeline_edge_alloc;

        // Refusal detected: rax >= PE_MAX (32) means an error sentinel.
        mov r10, 32;
        cmp rax, r10;
        jae r121pe_fail;

        mov r12, rax;                    // r12 = row_idx (live)

        // ------------------------------------------------------------
        // Stage 2: read the role back through the accessor. Verifies
        // the row substrate is coherent (the mint's role byte at
        // [row+8][7:0] round-trips through pe_row_role).
        // ------------------------------------------------------------
        mov rax, 2;
        mov [rip + _r121pe_stage], rax;

        mov rdi, r12;
        call pe_row_role;                // rax = role or PE_DECODE_BAD

        mov r13, rax;                    // r13 = role read-back

        // Expected: PE_ROLE_PROD (0).
        cmp r13, 0;
        jne r121pe_fail_cleanup;

        // ------------------------------------------------------------
        // Stage 3: free the row. Verifies the free path clears the
        // in_use marker cleanly (pipeline_edge_free returns 0 on
        // success, PE_FREE_BAD_SLOT on any refusal).
        // ------------------------------------------------------------
        mov rax, 3;
        mov [rip + _r121pe_stage], rax;

        mov rdi, r12;
        call pipeline_edge_free;
        cmp rax, 0;
        jne r121pe_fail;

        // Emit rollup: `boot pipe edge ok -- kind=<hex> row=<hex>`.
        //
        // klog_s1_x2 caller-push idiom (verbatim from
        // r100_tls_trust.pdx):
        //   sub rsp, 8;   pad to keep rsp%16==0 after push
        //   push v2;      seventh klog arg
        //   call klog_s1_x2;
        //   add rsp, 16;  undo pad + push
        //
        // Entry to this emit block: rsp%16 == 0 (five callee-save
        // pushes on entry). Sub 8 -> %16 == 8. Push v2 -> %16 == 0.
        // Call is aligned per SysV.
        sub rsp, 8;
        mov rax, r12;                    // v2 = row_idx
        push rax;
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_boot_pipe_edge_ok];
        lea rcx, [rip + k_kind];
        mov r8,  0x1F0;                  // KIND_PIPELINE_EDGE
        lea r9,  [rip + r121pe_k_row];
        call klog_s1_x2;
        add rsp, 16;

        jmp r121pe_out;

      // ============================================================
      // Failure funnel.
      // ============================================================

      r121pe_fail_cleanup:
        // Row was minted; free it before falling through to the fail
        // emit so the pool stays clean across a re-run.
        mov rdi, r12;
        call pipeline_edge_free;
        // Ignore free's return -- we are already on the failure path.

      r121pe_fail:
        // Emit `boot pipe edge fail line=<stage>` via klog_s1_d1.
        mov rax, [rip + _r121pe_stage];
        mov rdi, 3;                      // LEVEL_INFO (INFO not ERR;
                                         //   sibling witnesses use INFO
                                         //   so the boot smoke does not
                                         //   pull a panic on a golden
                                         //   diff)
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + r121pe_fail_msg];
        lea rcx, [rip + k_line];
        mov r8,  rax;                    // v = stage
        call klog_s1_d1;

      r121pe_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
