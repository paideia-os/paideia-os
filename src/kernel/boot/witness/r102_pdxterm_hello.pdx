// src/kernel/boot/witness/r102_pdxterm_hello.pdx — R102.MON-007 skeleton
//
// R102.MON-007 (paideia-os #2214) owns the boot smoke that pins the
// pdxterm-hello cascade (spawn pdxterm, wait for its `hello` output on
// the framebuffer via a client-connected shell). Fires once
// pdxterm.M4-002 (shell echo round-trip) plus every downstream
// pdxterm dep (libpdx-gfx.M2, libpdx-event.M2, libpdx-font.M2,
// svc-compositor.M3+, svc-wm.M3+) have landed upstream and the
// pdxterm ELF is embedded via R102.MON-003.
//
// As of this landing all of pdxterm, libpdx-gfx, libpdx-event,
// libpdx-font, svc-compositor and svc-wm exist as empty scaffolds
// under github.com/paideia-os (LICENSE + README.md only). See
// r102_first_pixel.pdx header for the full disposition.
//
// Skeleton body: emit ONE lowercase skip fingerprint and return.
//
//   Skeleton (this landing):
//     "boot r102 pdxterm hello skip reason=no-userland"
//   Future (when the cascade fires):
//     "boot r102 pdxterm hello ok"        (per r102-user-plan.md §4.10)
//
// Encoder discipline: same as r102_first_pixel.pdx.

module R102PdxtermHello = structure {

  // 48 bytes including NUL.
  pub let tag_r102_pdxterm_hello_skip : [u8; 48] =
    "boot r102 pdxterm hello skip reason=no-userland\0"

  pub let witness_r102_pdxterm_hello : () -> () !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R102.MON-007 skeleton (paideia-os #2214). Emits the ONE-line lowercase skip fingerprint `boot r102 pdxterm hello skip reason=no-userland` on every boot. The full cascade requires pdxterm.M4-002 (plus libpdx-gfx.M2, libpdx-event.M2, libpdx-font.M2, svc-compositor.M3+, svc-wm.M3+) upstream and R102.MON-003's ELF embed; none hold as of the R102 MON- wave. push rbp / pop rbp preserves the caller's rsp%16 parity and rbp guarantee across the nested klog_s1 call.",
      block: {
        push rbp;

        mov rdi, 3;                              // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_r102_pdxterm_hello_skip];
        call klog_s1;

        pop rbp;
        ret
      }
    }
}
