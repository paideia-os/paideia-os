// src/kernel/boot/witness/r102_first_pixel.pdx — R102.MON-004 skeleton
//
// R102 userland graphical-display-stack SMOKE witness (skeleton).
//
// -----------------------------------------------------------------------------
// Round-level context
// -----------------------------------------------------------------------------
//
// R102 is the userland half of the graphical-display wave whose plan
// lives at `design/graphics/r102-user-plan.md`. It spawns nine
// satellite repos (libpdx-font, libpdx-gfx, libpdx-event, svc-
// compositor, svc-wm, pdxterm, pdxclock, pdxwatch, pdxpaint), each of
// which sequences its own M1..M5 milestones inside its own repo. The
// monorepo integration that stitches those satellites into the boot
// image is the R102 MON- sub-scope (issues #2208..#2217).
//
// R102.MON-004 (paideia-os #2211) owns the boot smoke that pins the
// end-to-end "first pixel on screen from an svc-compositor mint" path.
// That path can only fire once svc-compositor.M4-001 has landed
// upstream and its ELF has been staged into build/user/svc-compositor.elf
// by the r102-tools stage of tools/build.sh (R102.MON-002 #2209). As of
// this landing NEITHER of those preconditions holds:
//
//   1. svc-compositor exists on github.com/paideia-os/svc-compositor
//      as an empty scaffold (LICENSE + README.md only, no source, no
//      caps.decl, no find-paideia-as.sh, no tools/build.sh). The repo's
//      M1-001 scaffold issue is open but unfilled. `git submodule add`
//      against it would land a directory that this monorepo's build.sh
//      cannot invoke -- no build script to call, no .elf to embed.
//   2. tools/userbin_embed.S therefore has no `.incbin
//      "build/user/svc-compositor.elf"` line, and bin_seeds.pdx has no
//      /bin/svc-compositor tmpfs seed. Adding either would hard-fail
//      the kernel link with an undefined-reference on
//      `_svc_compositor_bin_start`.
//
// This witness therefore lands as a SKELETON: it fires unconditionally
// on every boot, emits ONE lowercase skip fingerprint naming the
// reason, and returns. When svc-compositor.M4-001 lands and its ELF
// starts being embedded (a future MON-003 follow-up), the body swaps
// from `emit skip` to the real cascade documented in §4.10 of the plan
// (mint synthetic scanout parent, drive compositor's first-frame emit
// path, read back a nonzero pixel from the LFB / scanout cap target).
// The fingerprint at that point flips to `boot r102 first pixel ok`.
//
// -----------------------------------------------------------------------------
// Fingerprint
// -----------------------------------------------------------------------------
//
//   Skeleton (this landing):
//     "boot r102 first pixel skip reason=no-userland"
//
//   Future (when the satellite ELF is embedded and the cascade fires):
//     "boot r102 first pixel ok"          (per r102-user-plan.md §4.10)
//
// The golden `tests/expected-r102-first-pixel.golden` pins the SKIP
// line today. When the OK cascade lands, the golden line flips.
//
// -----------------------------------------------------------------------------
// Encoder discipline
// -----------------------------------------------------------------------------
//
// No frame-prologue annotations (tree convention). Fingerprint tag is
// ONE line, all-lowercase, NUL-terminated (klog_emit_core reads a C
// string). Labels prefixed `r102fp_`. Frame prologue implicit under
// the tree's `unsafe`-lambda emit convention (see bin_seeds.pdx
// header for the parity discussion).

module R102FirstPixel = structure {

  // Fingerprint. 46 bytes including NUL:
  //   b-o-o-t- -r-1-0-2- -f-i-r-s-t- -p-i-x-e-l- -s-k-i-p- -
  //   r-e-a-s-o-n-=-n-o---u-s-e-r-l-a-n-d-\0
  pub let tag_r102_first_pixel_skip : [u8; 46] =
    "boot r102 first pixel skip reason=no-userland\0"

  // ==========================================================================
  // witness_r102_first_pixel() -> ()
  //
  // Skeleton body: emit the skip fingerprint and return. Frame prologue
  // implicit for the unsafe-bodied lambda; the `push rbp` / `pop rbp`
  // pair keeps the caller's SysV rbp guarantee intact and preserves the
  // caller's rsp%16 parity across the klog_s1 nested call.
  // ==========================================================================
  pub let witness_r102_first_pixel : () -> () !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R102.MON-004 skeleton (paideia-os #2211). Fires unconditionally on every boot and emits the ONE-line lowercase skip fingerprint `boot r102 first pixel skip reason=no-userland`. The full first-pixel cascade this witness will eventually drive (mint synthetic scanout parent, invoke svc-compositor's first-frame path, read back a nonzero pixel) requires svc-compositor.M4-001 upstream AND R102.MON-003 (bin_seeds embed of the svc-compositor ELF); neither has landed as of this MON- wave, so the body would emit undefined-reference errors at link time if it named any of those symbols. Kept a pure klog_s1 call so the witness compiles under the current monorepo, participates in the golden pinning discipline, and flips to `boot r102 first pixel ok` in place when the preconditions arrive. push rbp / pop rbp preserves the caller's rsp%16 parity and rbp guarantee across the nested klog_s1 call (identical shape to witness_bin_seeds).",
      block: {
        push rbp;

        mov rdi, 3;                              // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_r102_first_pixel_skip];
        call klog_s1;

        pop rbp;
        ret
      }
    }
}
