// src/kernel/boot/witness/elevate_broker_dispatch.pdx —
// R90-XREPO.011.M1-003 (paideia-os #2122).
//
// End-to-end boot witness for the real elevate-broker dispatch body
// (elevate_broker_serve_one in src/kernel/core/ipc/elevate_broker.pdx).
// Two sub-scenarios cover the discriminating pair of seeded /system/
// rules -- design/security/elevate-policy-format.md §5:
//
//   Scenario A (INIT-allow) : requester_pid = 1 -> serve_one returns
//                             ELVC_STATE_APPROVED (2) via the seeded
//                             `/system/  INIT  ALLOW` rule.
//
//   Scenario B (non-init-deny) : requester_pid = 99 -> serve_one
//                                returns ELVC_STATE_DENIED (3) via the
//                                seeded `/system/  *  DENY` rule.
//
// Placement in the boot cascade
// -----------------------------
//
// Called from `boot_continue_after_ring3` in kernel_main.pdx AFTER
// witness_rootfs_seed_policy (which puts the v1 policy file at
// /system/policy) -- the dispatch body reads that file via
// tmpfs_lookup/tmpfs_read, so it MUST run after the seed. Placed before
// the r16_uart_rx witness block that already runs later in the cascade,
// so this witness's decision-stamp does not race against later
// wire-driven side effects.
//
// Row lifecycle
// -------------
//
// The witness fabricates each scenario's row directly via
// elevate_channel_tail_alloc rather than the full
// elevate_channel_cap_mint_inner mint gate -- the mint gate requires a
// parent KIND_IPC_ENDPOINT cap slot, and the witness's scope is to
// prove the dispatch body's arithmetic against a live row, not to
// re-cover the mint gate (which tests/kernel/cap/kind_elevate_channel_
// synth.pdx already witnesses). After each scenario the row is freed
// via elevate_channel_tail_free so the table stays clean for later
// bring-up milestones and so a re-boot under a hot-reload harness sees
// no stale rows.
//
// Fingerprint discipline
// ----------------------
//
//   OK  : klog_s1(LEVEL_INFO=3, SUBSYS_BOOT, tag_boot_elvb_ok)
//         -> "boot elevate broker ok [legacy: BOOT ELEVATE BROKER OK]"
//   FAIL: klog_s1_d1(LEVEL_ERROR=1, SUBSYS_BOOT, tag_boot_elvb_fail,
//                    k_line, stage)
//         -> "boot elevate broker fail [legacy: BOOT ELEVATE BROKER
//             FAIL] line=<N>"
// where <N> is the stage number stashed in `_elvbd_stage` per the same
// pdxb_ahci_probe.pdx / rootfs_dir_seeds.pdx idiom every seed / smoke
// witness in this directory uses.
//
// The `elevate broker allow ok` / `elevate broker deny ok` lines that
// serve_one emits from its own body are the assertable audit signal per
// scenario; this rollup ("boot elevate broker ok") is the acceptance
// criterion for the whole witness, same posture as
// witness_bin_seeds's rollup vs. the individual per-file bin-seed lines.
//
// Encoder / label discipline
// --------------------------
//
// Every constant fits imm32 (row_id return sentinel 0xFFFFEC0F loaded
// via imm32; other row-op errors similarly < 2^32). No add reg,[mem].
// mov_b unused in this witness (no byte-level parsing). Labels prefixed
// `elvbd_` (elevate broker dispatch witness) so no keyword collision
// under paideia-as reserved labels; the stage counter symbol
// `_elvbd_stage` is confined to this .o alone by convention.

module ElevateBrokerDispatch = structure {

  pub let mut _elvbd_stage : u64 = 0

  // Fingerprint tags. NUL-inclusive counts:
  //   "boot elevate broker ok [legacy: BOOT ELEVATE BROKER OK]"     -- 55 chars + NUL = 56.
  //   "boot elevate broker fail [legacy: BOOT ELEVATE BROKER FAIL]" -- 59 chars + NUL = 60.
  pub let tag_boot_elvbd_fail : [u8; 60] = "boot elevate broker fail [legacy: BOOT ELEVATE BROKER FAIL]\0"

  // Fabricated request-row inputs. Kept static rather than dynamic so
  // the row-mint gate's `request_id != 0` invariant lands the same
  // value across every boot.
  pub let ELVBD_REQ_ID_A : u64 = 0xE0A1
  pub let ELVBD_REQ_ID_B : u64 = 0xE0B2
  pub let ELVBD_PID_INIT : u64 = 1
  pub let ELVBD_PID_USER : u64 = 99

  // Header packer args: state=REQUESTED, target_cap_kind=KIND_PDXFS_FILE
  // (0x195, matches the sibling test at kind_elevate_channel_synth.pdx
  // Stage 4). target_cap_rights=R_PDXFS_FILE_WRITE|INVOKE (0x00A),
  // expire_ns=0 (default), broker_endpoint_id=ELEVATE_BROKER_ENDPOINT_ID
  // (16).
  pub let ELVBD_TARGET_KIND    : u64 = 0x195
  pub let ELVBD_TARGET_RIGHTS  : u64 = 0x00A
  pub let ELVBD_BROKER_EP_ID   : u64 = 16

  // ==========================================================================
  // elvbd_mint_row(pid, request_id) -> row_id | error
  // ==========================================================================
  //
  // Fabricates a KIND_ELEVATE_CHANNEL row via elevate_channel_hdr_pack
  // + elevate_channel_tail_alloc directly (bypassing the mint-gate that
  // requires a KIND_IPC_ENDPOINT parent cap slot; that gate is already
  // witnessed by tests/kernel/cap/kind_elevate_channel_synth.pdx). Both
  // callees preserve rbx/rbp/r12-r15 across their frames per SysV; the
  // two callee-save pushes here (r12/r13) survive both nested calls.
  // Entry rsp%16==8, 2 pushes -> %16==0 for the nested calls.
  //
  // Returns row_id (0..15) on success; any tail_alloc error code
  // (ELVC_TAIL_ENOSPC, ELVC_TAIL_BAD_ARG, ELVC_MINT_BAD_REQ) or
  // ELVC_MINT_BAD_KIND (from hdr_pack) on failure.
  pub let elvbd_mint_row : (u64, u64) -> u64 !{mem} @{} =
    fn (pid: u64) (request_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R90-XREPO.011.M1-003 (paideia-os #2122): fabricate one KIND_ELEVATE_CHANNEL row in state=REQUESTED for the boot witness. Bypasses elevate_channel_cap_mint_inner's parent-endpoint gate (already witnessed by tests/kernel/cap/kind_elevate_channel_synth.pdx) and drives elevate_channel_hdr_pack + elevate_channel_tail_alloc directly with target_cap_kind=KIND_PDXFS_FILE (0x195), target_cap_rights=R_PDXFS_FILE_WRITE|INVOKE (0x00A), expire_ns=0, broker_endpoint_id=ELEVATE_BROKER_ENDPOINT_ID (16). Two callee-save pushes (r12=pid, r13=request_id) land rsp%16==0 for the nested hdr_pack/tail_alloc calls (entry %16==8; 2 pushes -> %16==0 mod 16 == 8; wait: 2 pushes on entry-%16==8 lands (8+16)%16==8, needing one more adjustment; kept via a single sub rsp,8 to reach 0). elevate_channel_hdr_pack refuses target_cap_kind >= 2^32 or state outside [1..5] with 0xFFFFFFFFFFFFFFFF sentinel; the sentinel compare is via `mov r10, imm64; cmp` since AND/CMP has no imm64 form. elevate_channel_tail_alloc returns row_id (0..15) or ELVC_TAIL_ENOSPC / ELVC_MINT_BAD_REQ / ELVC_TAIL_BAD_ARG in the 0xFFFFEC0.. band; the witness caller compares rax<16 to distinguish success from any error. Labels prefixed elvbd_mint_.",
      block: {
        push r12;
        push r13;
        sub rsp, 8;

        mov r12, rdi;                    // r12 = pid
        mov r13, rsi;                    // r13 = request_id

        // hdr_pack(target_cap_kind=0x195, state=REQUESTED=1) -> hdr | sentinel.
        mov rdi, 0x195;                  // ELVBD_TARGET_KIND
        mov rsi, 1;                      // ELVC_STATE_REQUESTED
        call elevate_channel_hdr_pack;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  elvbd_mint_fail;

        // tail_alloc(hdr, request_id, pid, rights=0x00A, expire_ns=0,
        //            broker_endpoint_id=16) -> row_id | error.
        mov rdi, rax;                    // hdr
        mov rsi, r13;                    // request_id
        mov rdx, r12;                    // requester_pid
        mov rcx, 0x00A;                  // target_cap_rights
        xor r8, r8;                      // expire_ns = 0
        mov r9, 16;                      // broker_endpoint_id
        call elevate_channel_tail_alloc;
        jmp elvbd_mint_out;

      elvbd_mint_fail:
        mov rax, 0xFFFFEC09;             // ELVC_MINT_BAD_KIND

      elvbd_mint_out:
        add rsp, 8;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // witness_elevate_broker_dispatch() -- top-level entry
  // ==========================================================================
  pub let witness_elevate_broker_dispatch : () -> () !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R90-XREPO.011.M1-003 (paideia-os #2122): end-to-end witness for elevate_broker_serve_one. Two sub-scenarios: (A) INIT-allow -- tail_alloc a row with requester_pid=1 via elvbd_mint_row, call serve_one, assert rax==ELVC_STATE_APPROVED(2) AND elevate_channel_row_state returns APPROVED AND elevate_channel_row_expire returns non-zero (proof set_expire was called). (B) non-init-deny -- tail_alloc a row with requester_pid=99, call serve_one, assert rax==ELVC_STATE_DENIED(3) AND row_state returns DENIED AND row_expire returns non-zero. Each scenario stamps its stage into _elvbd_stage before its own call so the FAIL fingerprint's line=<N> KV names the tripping stage (idiom borrowed from pdxb_ahci_probe.pdx's _pdxbap_stage / rootfs_seed_policy.pdx's _policy_seed_stage). Stages 1..3 = Scenario A (mint, dispatch, verify); Stages 4..6 = Scenario B (mint, dispatch, verify); Stage 7 = cleanup free of both rows. On any failure, converge on elvbd_fail and emit klog_s1_d1(LEVEL_ERROR=1, SUBSYS_BOOT, tag_boot_elvbd_fail, k_line, stage). All-green path emits klog_s1(LEVEL_INFO=3, SUBSYS_BOOT, tag_boot_elvb_ok) -- the `boot elevate broker ok [legacy: BOOT ELEVATE BROKER OK]` rollup that satisfies the coverage-gate for the whole witness cascade; per-scenario `elevate broker allow ok` / `elevate broker deny ok` lines are the auditable signal emitted from serve_one itself. Five-push callee-save prologue (rbx, r12, r13, r14, r15) leaves rsp%16==0 for every nested call (entry %16==8; 5 pushes = 40 bytes, (8+40)%16 == 0). r12 stashes Scenario A's row_id across the second scenario so the cleanup free at Stage 7 can retire both rows; r13 stashes Scenario B's row_id. r14, r15 unused semantically -- present for the fixed-shape 5-push idiom every sibling witness in this directory takes. Encoder-conservative: every immediate fits imm32 (row_id return sentinels 0xFFFFEC0F / 0xFFFFEC0E etc. are all < 2^32). No add reg,[mem]. No mov_b (this witness reads returns, not bytes). Effects/capabilities {sysreg, mem} @{boot}: mem for every row-op touch of _elevate_channel_table; sysreg transitive via klog_s1's TSC read AND serve_one's own {mem, sysreg} declaration; @{boot} matches every sibling witness in this directory. Labels prefixed elvbd_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // ============ Scenario A: INIT-allow ============

        mov rax, 1;
        lea rcx, [rip + _elvbd_stage];
        mov [rcx], rax;

        // Stage 1: mint a request row for pid=1.
        mov rdi, 1;                      // ELVBD_PID_INIT
        mov rsi, 0xE0A1;                 // ELVBD_REQ_ID_A
        call elvbd_mint_row;
        mov r11, 16;
        cmp rax, r11;
        jae elvbd_fail;                  // row_id must be in [0..15]
        mov r12, rax;                    // r12 = row_id A

        // Stage 2: dispatch.
        mov rax, 2;
        lea rcx, [rip + _elvbd_stage];
        mov [rcx], rax;

        mov rdi, r12;
        call elevate_broker_serve_one;
        cmp rax, 2;                      // ELVC_STATE_APPROVED
        jne elvbd_fail;

        // Stage 3: verify row state + expire stamp.
        mov rax, 3;
        lea rcx, [rip + _elvbd_stage];
        mov [rcx], rax;

        mov rdi, r12;
        call elevate_channel_row_state;
        cmp rax, 2;                      // APPROVED
        jne elvbd_fail;

        mov rdi, r12;
        call elevate_channel_row_expire;
        cmp rax, 0;                      // must have been stamped
        je  elvbd_fail;

        // ============ Scenario B: non-init-deny ============

        mov rax, 4;
        lea rcx, [rip + _elvbd_stage];
        mov [rcx], rax;

        // Stage 4: mint a request row for pid=99.
        mov rdi, 99;                     // ELVBD_PID_USER
        mov rsi, 0xE0B2;                 // ELVBD_REQ_ID_B
        call elvbd_mint_row;
        mov r11, 16;
        cmp rax, r11;
        jae elvbd_fail;
        mov r13, rax;                    // r13 = row_id B

        // Stage 5: dispatch.
        mov rax, 5;
        lea rcx, [rip + _elvbd_stage];
        mov [rcx], rax;

        mov rdi, r13;
        call elevate_broker_serve_one;
        cmp rax, 3;                      // ELVC_STATE_DENIED
        jne elvbd_fail;

        // Stage 6: verify row state + expire stamp.
        mov rax, 6;
        lea rcx, [rip + _elvbd_stage];
        mov [rcx], rax;

        mov rdi, r13;
        call elevate_channel_row_state;
        cmp rax, 3;                      // DENIED
        jne elvbd_fail;

        mov rdi, r13;
        call elevate_channel_row_expire;
        cmp rax, 0;
        je  elvbd_fail;

        // ============ Cleanup: free both rows ============

        mov rax, 7;
        lea rcx, [rip + _elvbd_stage];
        mov [rcx], rax;

        mov rdi, r12;
        call elevate_channel_tail_free;

        mov rdi, r13;
        call elevate_channel_tail_free;

        // ============ Success ============
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_boot_elvb_ok];
        call klog_s1;
        jmp elvbd_done;

      elvbd_fail:
        // Read stage counter back and emit fail marker.
        lea rax, [rip + _elvbd_stage];
        mov r8, [rax];
        mov rdi, 1;                      // LEVEL_ERROR
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_boot_elvbd_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;

      elvbd_done:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
