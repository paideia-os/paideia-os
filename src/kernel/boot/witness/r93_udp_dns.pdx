// src/kernel/boot/witness/r93_udp_dns.pdx -- R93.M4-001 (paideia-os
// #2058)
//
// Boot witness: after DHCP settles, resolve a hardcoded hostname
// against the DHCP-installed DNS server (QEMU SLIRP's 10.0.2.3) and
// emit the "boot r93 dns resolve ok --" fingerprint carrying the
// resolved A-record IP as 4 decimal KVs.
//
// =============================================================================
// SECTION 0  SKIP DISCIPLINE
// =============================================================================
//
// This witness silently skips (no fingerprint) when:
//   * nic_dispatch_active_kind() == 0 (PAIDEIA_NIC=none)
//   * _dhcp_lease_acquired == 0 (DHCP timed out and static defaults
//     are in place -- resolving against 0.0.0.0 is guaranteed to
//     fail, no assertion worth emitting).
//
// It emits nothing on refusal (NXDOMAIN, timeout, malformed reply)
// -- the missing OK line in the boot log is the failure signal a
// future golden would key on. Same posture as R92 route_table
// witness (silent on mismatch).
//
// =============================================================================
// SECTION 1  HOSTNAME
// =============================================================================
//
// "example.com" -- a stable, well-known RFC 2606 reserved name
// guaranteed to resolve under any working DNS. QEMU SLIRP's 10.0.2.3
// forwards to the host's resolver, which answers with example.com's
// current IANA-managed A record.
//
// =============================================================================
// SECTION 2  ENCODER + LABEL DISCIPLINE
// =============================================================================
//
// Frame prologue implicit (paideia-as #1606). Labels prefixed
// `r93wt_`. Encoder-conservative: [reg+imm] only, xor+mov_b byte
// loads. Same klog_s1_d4 caller convention as dhcp_acquire's
// fingerprint stage (5 stack slots + 1 alignment pad; see
// wrappers.pdx §klog_s1_d4).

module R93UdpDns = structure {

  // "example.com" without NUL terminator (dns_encode_qname does not
  // read past hostname_len). 11 bytes.
  pub let _r93wt_hostname : [u8; 11] = [
    0x65u8, 0x78u8, 0x61u8, 0x6Du8, 0x70u8, 0x6Cu8, 0x65u8,
    0x2Eu8, 0x63u8, 0x6Fu8, 0x6Du8
  ]

  pub let R93WT_HOSTNAME_LEN : u64 = 11

  pub let witness_r93_udp_dns : () -> () !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R93.M4-001 (paideia-os #2058). Boot witness: post-DHCP DNS resolution against the DHCP-installed DNS server. 1-push callee-save (rbx=resolved_ip): 8 bytes shift; entry rsp%16==8 -> 16, %16==0 aligned for the nested nic_dispatch_active_kind / dns_resolve / klog_s1_d4 calls (odd push count self-aligns). Skip discipline: nic_dispatch_active_kind==0 -> silent skip; _dhcp_lease_acquired==0 -> silent skip (resolving against 0.0.0.0 is guaranteed to fail). dns_resolve(&_r93wt_hostname, 11) -> ip. Zero -> silent skip (refused / timeout). Non-zero -> emit `boot r93 dns resolve ok --` via klog_s1_d4 with 4 KVs k_ip_b0..k_ip_b3 (unpacked wire-order bytes of the resolved IP). klog_s1_d4 caller convention identical to dhcp_acquire's fingerprint stage: sub rsp,48 (5 slot args + 8-byte pad) to keep rsp%16==0 across the call. Reserved labels r93wt_.",
      block: {
        push rbx;

        // Skip: NIC?
        call nic_dispatch_active_kind;
        cmp rax, 0;
        je r93wt_ret;

        // Skip: DHCP lease?
        mov rax, [rip + _dhcp_lease_acquired];
        cmp rax, 0;
        je r93wt_ret;

        // Resolve.
        lea rdi, [rip + _r93wt_hostname];
        mov rsi, 11;
        call dns_resolve;
        cmp rax, 0;
        je r93wt_ret;

        mov rbx, rax;                            // resolved_ip packed

        // Emit fingerprint. Current rsp%16==0. sub rsp,48 = 48 bytes
        // shift => rsp%16 = -48%16 = 0. Aligned for CALL.
        sub rsp, 48;

        mov rdi, 3;                              // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_boot_r93_dns_resolve_ok];
        lea rcx, [rip + k_ip_b0];
        lea r9, [rip + k_ip_b1];
        mov rax, rbx;
        shr rax, 24;
        and rax, 0xFF;
        mov r8, rax;                             // v1 = ip_b0

        mov rax, rbx;
        shr rax, 16;
        and rax, 0xFF;
        mov [rsp + 0], rax;                      // v2 = ip_b1
        lea rax, [rip + k_ip_b2];
        mov [rsp + 8], rax;                      // k3
        mov rax, rbx;
        shr rax, 8;
        and rax, 0xFF;
        mov [rsp + 16], rax;                     // v3 = ip_b2
        lea rax, [rip + k_ip_b3];
        mov [rsp + 24], rax;                     // k4
        mov rax, rbx;
        and rax, 0xFF;
        mov [rsp + 32], rax;                     // v4 = ip_b3

        call klog_s1_d4;

        add rsp, 48;

      r93wt_ret:
        pop rbx;
        ret
      }
    }
}
