// src/kernel/boot/witness/r29_dma_opregion.pdx — boot witness module
//
// Extracted verbatim from src/kernel/boot/kernel_main.pdx (which had grown
// to 24,315 lines in two functions).  R29.M5 / R30.M3 witness block — KIND_DMA_DOMAIN and KIND_OP_REGION.
//
// -----------------------------------------------------------------------------
// Why the body is copied and not rewritten
// -----------------------------------------------------------------------------
//
// The goldens for this tree assert an ORDERED SUBSEQUENCE of fingerprints
// across 14 boot modes, and a witness that silently stops running still
// leaves most of that subsequence intact.  The extraction therefore moves
// the instruction stream unchanged: the only bytes this module adds around
// it are the `push rbp` / `pop rbp` / `ret` below.
//
// -----------------------------------------------------------------------------
// The push is not decoration
// -----------------------------------------------------------------------------
//
// `boot_continue_after_ring3` runs its body at `rsp % 16 == 8` — it sits two `call` levels
// below `_start`, and paideia-as emits no frame prologue for an
// `unsafe`-bodied lambda (emit_visit_lambda.rs suppresses the prologue for
// Unsafe bodies, which is also why `@no_frame` is a no-op there).  Several
// witnesses in this file reason explicitly about that parity — "3 pushes from %16==8
// yields (8+3*8)%16 == 0" — and a bare `call` into a bare body would enter
// at `%16 == 0` and invert every one of those arguments.  The single
// `push rbp` restores the inline parity exactly; the matching `pop rbp`
// keeps rbp's SysV guarantee for the caller.
//
// Sections in this module, in the order boot_continue_after_ring3 ran them:
//   * R29.M5-001 (#1036) + R29.M5-002 (#1037): KIND_DMA_DOMAIN
//   * R30.M3-001 (#1061): KIND_OP_REGION witness — opens R30.M3, the

module R29DmaOpregion = structure {

  // witness_r29_dma_opregion() — the R29.M5 / R30.M3 witness block — KIND_DMA_DOMAIN and KIND_OP_REGION.
  //
  // Effect and capability rows are the ones the enclosing
  // `boot_continue_after_ring3` declares.  They are not widened here: this
  // is the same instruction stream under a new symbol, so the authority it
  // needs is by construction the authority it already had.
  pub let witness_r29_dma_opregion : () -> () !{sysreg} @{} = fn () -> unsafe {
    effects: { sysreg },
    capabilities: { boot },
    justification: "Boot witness block lifted verbatim out of kernel_main.pdx's boot_continue_after_ring3 during the r29_dma_opregion extraction. Body bytes are unchanged from the inline form; the only additions are the entry `push rbp` and the exit `pop rbp; ret`. The push is load-bearing rather than cosmetic: boot_continue_after_ring3 executes its body at rsp%16 == 8 (two `call` levels below _start, with no frame prologue emitted for unsafe-bodied lambdas), and the witnesses inside this module compute their own nested-call alignment from that parity. Entering through a `call` without the compensating push would present rsp%16 == 0 to the body and silently invert every such argument — the failure mode of paideia-os #1192, #1195 and #1584. Effects and capabilities are copied unchanged from the enclosing function for the same reason: no authority is added, so none needs justifying beyond what boot_continue_after_ring3 already justified.",
    block: {
      push rbp;

      // ============================================================
      // R29.M5-001 (#1036) + R29.M5-002 (#1037): KIND_DMA_DOMAIN
      // derived-kind witness — opens R29.M5 (IOMMU-per-device DMA
      // domains + blob-policy closure).
      //
      // KIND_DMA_DOMAIN (0x142) is the third entry in the R29 derived-
      // kind block but the FIRST one that does not ride KIND_HW: it is
      // derived over KIND_MEMORY (= KIND_PAGE, base slot 4), because a
      // DMA domain is a memory-access scope, not a device-authority
      // handle. See src/kernel/core/cap/kind_dma_domain.pdx for the full
      // naming reconciliation against the catalog's former
      // `KIND_HW_DMA_DOMAIN` planning skeleton.
      //
      // Granularity is one domain per DRIVER PROCESS (D1.b), shared
      // across every device the driver owns. This witness mints two
      // domains under one memory parent to model two driver processes
      // sharing a common memory root, and proves the cascade tears down
      // both when that root goes away.
      //
      // Cap-table slot allocation (all fresh in the pre-scheduler
      // bring-up window; distinct from slot 12 / 14 / 15 / 16..19 used
      // by the R29.M1 witnesses above):
      //   Slot 24 — KIND_MEMORY parent (kind=4, rights=0x618).
      //   Slot 25 — KIND_DMA_DOMAIN, ctx=0xDEADBEEF, bdf=0x0308,
      //             capacity=0x40000000 (1 GiB), coherency=1
      //             (non-coherent).
      //   Slot 26 — KIND_DMA_DOMAIN, ctx=0x00C0FFEE, bdf=0x00F8,
      //             capacity=0x00001000 (4 KiB), coherency=0
      //             (coherent).
      //   Slot 27 — failure-edge mint target; every mint aimed here is
      //             expected to fail, so the slot must read back null at
      //             the end.
      //
      // The two tuples differ in EVERY field (including coherency, which
      // takes both legal values) so a decode that silently read the
      // wrong row could not pass.
      //
      // Sub-tests (any failure jumps to the fail marker, which reports
      // the stage number from _kind_dma_witness_stage):
      //   A. Pre-clean slots 24..27.
      //   B. Canonical tail-word encoder round-trip (#1037), table-free:
      //      dma_tail_pack(0xDEADBEEF, 0x0308, 1) == 0x00010308DEADBEEF,
      //      and dma_tail_word_{ctx_id,bdf,coherency} recover each field.
      //   C. Encoder failure edges: ctx >= 2^32, bdf >= 2^16, and
      //      coherency = 2 each return DMA_DECODE_BAD.
      //   D. Mint the KIND_MEMORY parent at slot 24 via cap_mint_write.
      //   E. dma_cap_mint slot 25 (tuple 1) -> DMA_MINT_OK.
      //   F. dma_cap_mint slot 26 (tuple 2) -> DMA_MINT_OK.
      //   G. Read back cap_table[25] / cap_table[26]: kind == 0x142,
      //      rights == 0x618.
      //   H. Full tail round-trip through cap_invoke_dispatch on slot
      //      25: OP_QUERY_CTX_ID / BDF / CAPACITY / COHERENCY / PARENT.
      //   I. Same five ops on slot 26 — proves per-row persistence, and
      //      that coherency=0 decodes as 0 rather than as a failure.
      //   J. Failure edge — BAD PARENT KIND: mint at slot 27 with
      //      parent_slot=25 (a KIND_DMA_DOMAIN, kind 0x142, not
      //      KIND_MEMORY) -> DMA_MINT_BAD_PARENT.
      //   K. Failure edge — INSUFFICIENT/ILLEGAL RIGHTS: rights=0x004
      //      (RIGHT_EXEC, not in R_DMA_ALL) -> DMA_MINT_BAD_RIGHTS;
      //      plus dma_rights_valid(0x800) -> 0.
      //   L. Failure edge — OUT-OF-RANGE COHERENCY: hand-built tail word
      //      with coherency field = 2 -> DMA_MINT_BAD_COHERENCY.
      //   M. Failure edge — ZERO CAPACITY: capacity_bytes=0 ->
      //      DMA_MINT_BAD_ARG.
      //   N. Failure edge — ROW EXHAUSTION: rows 0 and 1 are held by
      //      slots 25/26, so allocate the remaining 30 rows directly via
      //      dma_tail_alloc (asserting low-first row ids 2..31), then a
      //      dma_cap_mint must return DMA_MINT_ENOSPC. Rows 2..31 are
      //      freed again immediately so the table is left exactly as the
      //      two live domains found it.
      //   O. Slot 27 must still read back null — no failed mint wrote a
      //      descriptor.
      //   P. Canonical debug printer (#1037) through dispatch:
      //      OP_DEBUG_PRINT on slot 25 -> DMA_TAIL_OK.
      //   Q. Rights denial through dispatch: OP_MAP (needs RIGHT_MINT)
      //      is reached with full rights and must report
      //      INVOKE_UNSUPPORTED, proving the gate precedes — and does
      //      not swallow — the unimplemented-op return.
      //   R. Cascade revoke: dma_cascade_revoke_by_parent(24) -> 2.
      //   S. cap_table[25] and cap_table[26] cleared; rows 0 and 1
      //      freed (dma_tail_valid -> 0 for both).
      //   T. Revoke failure edges: dma_cap_revoke(25) on the now-null
      //      slot -> DMA_REVOKE_ALREADY; dma_cap_revoke(24) on the
      //      KIND_MEMORY parent -> DMA_REVOKE_WRONG_KIND (a revoke for
      //      one kind must never clear another kind's descriptor);
      //      cap_table[24] still intact afterwards.
      //   U. Clean up slot 24 so the witness leaves no residue.
      //
      // Fingerprint ordering (post-M5-001/002 landing):
      //   R29 KIND_HW OK             (R29.M0-001)
      //   R29 KIND_INTERRUPT OK      (R29.M1-001..003)
      //   R29 KIND_MSIX_VECTOR OK    (R29.M1-004)
      //   R29 KIND_DMA_DOMAIN OK     <- THIS WITNESS
      //   R29 LIFECYCLE FSM OK       (R29.M2-001)
      //   ...
      //
      // Stage tracker: memory-backed in _kind_dma_witness_stage; the
      // exhaustion loop cursor is likewise memory-backed in
      // _kind_dma_witness_cursor rather than held in a callee-save
      // register, so no assumption about which registers the helper
      // chain preserves leaks into the witness.
      // ============================================================
      kind_dma_domain_witness:
          // -- Sub-test A: pre-clean slots 24..27 (4 slots * 24 bytes,
          //    starting at offset 576 = 24 * 24).
          mov  rax, 1
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rax, cap_table
          add  rax, 576                            // slot 24 * 24
          xor  rcx, rcx
          mov  [rax + 0],  rcx                     // slot 24
          mov  [rax + 8],  rcx
          mov  [rax + 16], rcx
          mov  [rax + 24], rcx                     // slot 25
          mov  [rax + 32], rcx
          mov  [rax + 40], rcx
          mov  [rax + 48], rcx                     // slot 26
          mov  [rax + 56], rcx
          mov  [rax + 64], rcx
          mov  [rax + 72], rcx                     // slot 27
          mov  [rax + 80], rcx
          mov  [rax + 88], rcx

          // -- Sub-test B: canonical tail-word encoder round-trip.
          //    dma_tail_pack(0xDEADBEEF, 0x0308, 1)
          //      = 0xDEADBEEF | (0x0308 << 32) | (1 << 48)
          //      = 0x0001_0308_DEAD_BEEF
          mov  rax, 2
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rdi, 0xDEADBEEF
          mov  rsi, 0x0308
          mov  rdx, 1
          call dma_tail_pack
          mov  rcx, 0x00010308DEADBEEF
          cmp  rax, rcx
          jne  kind_dma_witness_fail

          //    ctx field recovers 0xDEADBEEF.
          mov  rax, 3
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rdi, 0x00010308DEADBEEF
          call dma_tail_word_ctx_id
          mov  rcx, 0xDEADBEEF
          cmp  rax, rcx
          jne  kind_dma_witness_fail

          //    bdf field recovers 0x0308.
          mov  rax, 4
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rdi, 0x00010308DEADBEEF
          call dma_tail_word_bdf
          cmp  rax, 0x0308
          jne  kind_dma_witness_fail

          //    coherency field recovers 1.
          mov  rax, 5
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rdi, 0x00010308DEADBEEF
          call dma_tail_word_coherency
          cmp  rax, 1
          jne  kind_dma_witness_fail

          // -- Sub-test C: encoder failure edges.
          //    ctx >= 2^32.
          mov  rax, 6
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rdi, 0x100000000
          mov  rsi, 0x0308
          mov  rdx, 0
          call dma_tail_pack
          mov  rcx, 0xFFFFFFFFFFFFFFFF             // DMA_DECODE_BAD
          cmp  rax, rcx
          jne  kind_dma_witness_fail

          //    bdf >= 2^16.
          mov  rax, 7
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rdi, 0x1000
          mov  rsi, 0x10000
          mov  rdx, 0
          call dma_tail_pack
          mov  rcx, 0xFFFFFFFFFFFFFFFF
          cmp  rax, rcx
          jne  kind_dma_witness_fail

          //    coherency = 2 (out of range).
          mov  rax, 8
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rdi, 0x1000
          mov  rsi, 0x0100
          mov  rdx, 2
          call dma_tail_pack
          mov  rcx, 0xFFFFFFFFFFFFFFFF
          cmp  rax, rcx
          jne  kind_dma_witness_fail

          // -- Sub-test D: mint the KIND_MEMORY parent at slot 24.
          //    cap_mint_write ABI: rdi=slot, rsi=kind, rdx=rights,
          //    rcx=target_ptr. rights 0x618 includes RIGHT_MINT (0x200),
          //    which is what dma_check_parent_kind_memory demands.
          mov  rax, 9
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rdi, 24
          mov  rsi, 4                              // KIND_MEMORY (= KIND_PAGE)
          mov  rdx, 0x618
          mov  rcx, 0x200000                       // notional region base
          call cap_mint_write

          // -- Sub-test E: mint domain 1 at slot 25.
          //    dma_cap_mint ABI: rdi=slot, rsi=parent_slot, rdx=rights,
          //    rcx=tail_word, r8=capacity_bytes.
          mov  rax, 10
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rdi, 25
          mov  rsi, 24
          mov  rdx, 0x618                          // R_DMA_ALL
          mov  rcx, 0x00010308DEADBEEF             // ctx/bdf/coh tuple 1
          mov  r8,  0x40000000                     // 1 GiB window ceiling
          call dma_cap_mint
          cmp  rax, 0                              // DMA_MINT_OK
          jne  kind_dma_witness_fail

          // -- Sub-test F: mint domain 2 at slot 26.
          //    tail word for (ctx=0x00C0FFEE, bdf=0x00F8, coh=0)
          //      = 0x00C0FFEE | (0x00F8 << 32) | (0 << 48)
          //      = 0x0000_00F8_00C0_FFEE
          mov  rax, 11
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rdi, 26
          mov  rsi, 24
          mov  rdx, 0x618
          mov  rcx, 0x000000F800C0FFEE             // ctx/bdf/coh tuple 2
          mov  r8,  0x1000                         // 4 KiB window ceiling
          call dma_cap_mint
          cmp  rax, 0
          jne  kind_dma_witness_fail

          // -- Sub-test G: descriptor read-back for slots 25 and 26.
          mov  rax, 12
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rax, cap_table
          add  rax, 600                            // slot 25 * 24
          //    slot 25:
          mov  rcx, [rax + 0]
          mov  rdx, 0x142
          cmp  rcx, rdx
          jne  kind_dma_witness_fail
          mov  rcx, [rax + 8]
          mov  rdx, 0x618
          cmp  rcx, rdx
          jne  kind_dma_witness_fail
          //    slot 26:
          mov  rcx, [rax + 24]
          mov  rdx, 0x142
          cmp  rcx, rdx
          jne  kind_dma_witness_fail
          mov  rcx, [rax + 32]
          mov  rdx, 0x618
          cmp  rcx, rdx
          jne  kind_dma_witness_fail

          // -- Sub-test H: full tail round-trip on slot 25 through the
          //    dispatcher. All four spec fields plus parent_slot.
          mov  rax, 13
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rdi, 25
          mov  rsi, 0                              // OP_QUERY_CTX_ID
          call cap_invoke_dispatch
          mov  rcx, 0xDEADBEEF
          cmp  rax, rcx
          jne  kind_dma_witness_fail

          mov  rax, 14
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rdi, 25
          mov  rsi, 1                              // OP_QUERY_BDF
          call cap_invoke_dispatch
          cmp  rax, 0x0308
          jne  kind_dma_witness_fail

          mov  rax, 15
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rdi, 25
          mov  rsi, 2                              // OP_QUERY_CAPACITY
          call cap_invoke_dispatch
          mov  rcx, 0x40000000
          cmp  rax, rcx
          jne  kind_dma_witness_fail

          mov  rax, 16
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rdi, 25
          mov  rsi, 3                              // OP_QUERY_COHERENCY
          call cap_invoke_dispatch
          cmp  rax, 1                              // non-coherent
          jne  kind_dma_witness_fail

          mov  rax, 17
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rdi, 25
          mov  rsi, 4                              // OP_QUERY_PARENT
          call cap_invoke_dispatch
          cmp  rax, 24
          jne  kind_dma_witness_fail

          // -- Sub-test I: same five ops on slot 26. Distinct values in
          //    every field; coherency 0 must decode as 0, not as a
          //    decode failure.
          mov  rax, 18
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rdi, 26
          mov  rsi, 0
          call cap_invoke_dispatch
          mov  rcx, 0x00C0FFEE
          cmp  rax, rcx
          jne  kind_dma_witness_fail

          mov  rax, 19
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rdi, 26
          mov  rsi, 1
          call cap_invoke_dispatch
          cmp  rax, 0x00F8
          jne  kind_dma_witness_fail

          mov  rax, 20
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rdi, 26
          mov  rsi, 2
          call cap_invoke_dispatch
          cmp  rax, 0x1000
          jne  kind_dma_witness_fail

          mov  rax, 21
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rdi, 26
          mov  rsi, 3
          call cap_invoke_dispatch
          cmp  rax, 0                              // coherent
          jne  kind_dma_witness_fail

          mov  rax, 22
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rdi, 26
          mov  rsi, 4
          call cap_invoke_dispatch
          cmp  rax, 24
          jne  kind_dma_witness_fail

          // -- Sub-test J: BAD PARENT KIND. Slot 25 is a
          //    KIND_DMA_DOMAIN (0x142), not a KIND_MEMORY (4).
          mov  rax, 23
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rdi, 27
          mov  rsi, 25                             // wrong parent kind
          mov  rdx, 0x618
          mov  rcx, 0x000000010000A000
          mov  r8,  0x1000
          call dma_cap_mint
          mov  rcx, 0xFFFFFFDC                     // DMA_MINT_BAD_PARENT
          cmp  rax, rcx
          jne  kind_dma_witness_fail

          // -- Sub-test K: ILLEGAL RIGHTS. 0x004 (RIGHT_EXEC) is not a
          //    member of R_DMA_ALL (0x618).
          mov  rax, 24
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rdi, 27
          mov  rsi, 24                             // correct parent this time
          mov  rdx, 0x004
          mov  rcx, 0x000000010000A000
          mov  r8,  0x1000
          call dma_cap_mint
          mov  rcx, 0xFFFFFFDB                     // DMA_MINT_BAD_RIGHTS
          cmp  rax, rcx
          jne  kind_dma_witness_fail

          //    Direct validator check on a bit outside R_DMA_ALL.
          mov  rax, 25
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rdi, 0x800
          call dma_rights_valid
          cmp  rax, 0
          jne  kind_dma_witness_fail

          // -- Sub-test L: OUT-OF-RANGE COHERENCY. Hand-built tail word
          //    with the coherency field (bits [55:48]) set to 2 —
          //    dma_tail_pack would have refused to build this, so it is
          //    constructed literally to prove the allocator re-checks
          //    rather than trusting its caller.
          //      0x0002_0000_0000_1234 = ctx 0x1234, bdf 0, coh 2
          mov  rax, 26
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rdi, 27
          mov  rsi, 24
          mov  rdx, 0x618
          mov  rcx, 0x0002000000001234
          mov  r8,  0x1000
          call dma_cap_mint
          mov  rcx, 0xFFFFFFD8                     // DMA_MINT_BAD_COHERENCY
          cmp  rax, rcx
          jne  kind_dma_witness_fail

          // -- Sub-test M: ZERO CAPACITY -> BAD_ARG.
          mov  rax, 27
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rdi, 27
          mov  rsi, 24
          mov  rdx, 0x618
          mov  rcx, 0x000000010000A000
          mov  r8,  0
          call dma_cap_mint
          mov  rcx, 0xFFFFFFD9                     // DMA_MINT_BAD_ARG
          cmp  rax, rcx
          jne  kind_dma_witness_fail

          // -- Sub-test N: ROW EXHAUSTION. Rows 0/1 belong to slots
          //    25/26; fill rows 2..31 directly, assert low-first row-id
          //    allocation, then prove dma_cap_mint reports ENOSPC.
          mov  rax, 28
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rax, 2
          lea  rcx, [rip + _kind_dma_witness_cursor]
          mov  [rcx], rax

      kind_dma_exhaust_loop:
          lea  rcx, [rip + _kind_dma_witness_cursor]
          mov  rax, [rcx]
          cmp  rax, 32                             // DMA_DOMAIN_MAX
          jae  kind_dma_exhaust_full
          mov  rdi, 0x000000010000B000             // ctx 0xB000, bdf 1, coh 0
          mov  rsi, 0x1000
          mov  rdx, 24
          call dma_tail_alloc
          lea  rcx, [rip + _kind_dma_witness_cursor]
          mov  rdx, [rcx]
          cmp  rax, rdx                            // low-first row ids
          jne  kind_dma_witness_fail
          add  rdx, 1
          mov  [rcx], rdx
          jmp  kind_dma_exhaust_loop

      kind_dma_exhaust_full:
          //    Table is full: a real mint must now report ENOSPC.
          mov  rax, 29
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rdi, 27
          mov  rsi, 24
          mov  rdx, 0x618
          mov  rcx, 0x000000010000A000
          mov  r8,  0x1000
          call dma_cap_mint
          mov  rcx, 0xFFFFFFDA                     // DMA_MINT_ENOSPC
          cmp  rax, rcx
          jne  kind_dma_witness_fail

          //    Release rows 2..31 so the table is left holding exactly
          //    the two live domains.
          mov  rax, 30
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rax, 2
          lea  rcx, [rip + _kind_dma_witness_cursor]
          mov  [rcx], rax

      kind_dma_release_loop:
          lea  rcx, [rip + _kind_dma_witness_cursor]
          mov  rax, [rcx]
          cmp  rax, 32
          jae  kind_dma_release_done
          mov  rdi, rax
          call dma_tail_free
          lea  rcx, [rip + _kind_dma_witness_cursor]
          mov  rax, [rcx]
          add  rax, 1
          mov  [rcx], rax
          jmp  kind_dma_release_loop

      kind_dma_release_done:
          //    Rows 0/1 must still be live — the release loop started at
          //    row 2 and must not have touched the domains in use.
          mov  rax, 31
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rdi, 0
          call dma_tail_valid
          cmp  rax, 1
          jne  kind_dma_witness_fail
          mov  rdi, 1
          call dma_tail_valid
          cmp  rax, 1
          jne  kind_dma_witness_fail

          // -- Sub-test O: slot 27 must still be null. Five failed mints
          //    were aimed at it; not one may have written a descriptor.
          mov  rax, 32
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rax, cap_table
          add  rax, 648                            // slot 27 * 24
          mov  rcx, [rax + 0]
          cmp  rcx, 0
          jne  kind_dma_witness_fail
          mov  rcx, [rax + 8]
          cmp  rcx, 0
          jne  kind_dma_witness_fail
          mov  rcx, [rax + 16]
          cmp  rcx, 0
          jne  kind_dma_witness_fail

          // -- Sub-test P: canonical debug printer through dispatch.
          //    OP_DEBUG_PRINT (9) needs RIGHT_OBSERVE, which slot 25
          //    holds; emits the five-line DMA DOMAIN ROW record under
          //    SUBSYS_CAP_ and returns DMA_TAIL_OK.
          mov  rax, 33
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rdi, 25
          mov  rsi, 9                              // OP_DEBUG_PRINT
          call cap_invoke_dispatch
          cmp  rax, 0                              // DMA_TAIL_OK
          jne  kind_dma_witness_fail

          // -- Sub-test Q: OP_MAP gates on RIGHT_MINT (held) and then
          //    reports INVOKE_UNSUPPORTED — the rights gate runs before
          //    the unimplemented-op return, so an authorized caller sees
          //    UNSUPPORTED rather than DENIED.
          mov  rax, 34
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rdi, 25
          mov  rsi, 5                              // OP_MAP
          call cap_invoke_dispatch
          mov  rcx, 0xFFFFFFFFFFFFFFFC             // INVOKE_UNSUPPORTED
          cmp  rax, rcx
          jne  kind_dma_witness_fail

          // -- Sub-test R: cascade revoke through the KIND_MEMORY
          //    ancestor. Both domains name slot 24 as parent, so the
          //    scan must revoke exactly two.
          mov  rax, 35
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rdi, 24
          call dma_cascade_revoke_by_parent
          cmp  rax, 2
          jne  kind_dma_witness_fail

          // -- Sub-test S: both descriptors cleared and both rows freed.
          mov  rax, 36
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rax, cap_table
          add  rax, 600                            // slot 25 * 24
          mov  rcx, [rax + 0]
          cmp  rcx, 0
          jne  kind_dma_witness_fail
          mov  rcx, [rax + 8]
          cmp  rcx, 0
          jne  kind_dma_witness_fail
          mov  rcx, [rax + 16]
          cmp  rcx, 0
          jne  kind_dma_witness_fail
          mov  rcx, [rax + 24]                     // slot 26
          cmp  rcx, 0
          jne  kind_dma_witness_fail
          mov  rcx, [rax + 32]
          cmp  rcx, 0
          jne  kind_dma_witness_fail
          mov  rcx, [rax + 40]
          cmp  rcx, 0
          jne  kind_dma_witness_fail

          mov  rax, 37
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rdi, 0
          call dma_tail_valid
          cmp  rax, 0
          jne  kind_dma_witness_fail
          mov  rdi, 1
          call dma_tail_valid
          cmp  rax, 0
          jne  kind_dma_witness_fail

          // -- Sub-test T: revoke failure edges.
          //    Double revoke of an already-cleared slot.
          mov  rax, 38
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rdi, 25
          call dma_cap_revoke
          mov  rcx, 0xFFFFFFD5                     // DMA_REVOKE_ALREADY
          cmp  rax, rcx
          jne  kind_dma_witness_fail

          //    Revoking the KIND_MEMORY parent through the DMA revoke
          //    path must refuse — one kind's revoke may never clear
          //    another kind's descriptor.
          mov  rax, 39
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rdi, 24
          call dma_cap_revoke
          mov  rcx, 0xFFFFFFD6                     // DMA_REVOKE_WRONG_KIND
          cmp  rax, rcx
          jne  kind_dma_witness_fail

          //    ... and the parent descriptor is untouched.
          mov  rax, 40
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rax, cap_table
          add  rax, 576                            // slot 24 * 24
          mov  rcx, [rax + 0]
          cmp  rcx, 4                              // still KIND_MEMORY
          jne  kind_dma_witness_fail
          mov  rcx, [rax + 8]
          mov  rdx, 0x618
          cmp  rcx, rdx
          jne  kind_dma_witness_fail

          // -- Sub-test U: clean up slot 24 — the witness leaves the
          //    cap table exactly as it found it.
          mov  rax, cap_table
          add  rax, 576
          xor  rcx, rcx
          mov  [rax + 0],  rcx
          mov  [rax + 8],  rcx
          mov  [rax + 16], rcx

          // Success marker: R29 KIND_DMA_DOMAIN OK.
          mov  rdi, 3                              // LEVEL_INFO
          lea  rsi, [rip + SUBSYS_BOOT]
          lea  rdx, [rip + kind_dma_domain_ok_msg]
          call klog_s1
          jmp  kind_dma_domain_witness_done

      kind_dma_witness_fail:
          // Emit fail marker with the _kind_dma_witness_stage number as
          // a decimal KV — same discipline as kind_hw_msix_witness_fail.
          lea  rax, [rip + _kind_dma_witness_stage]
          mov  r8,  [rax]                          // r8 = stage value (arg 4)
          mov  rdi, 1                              // LEVEL_ERROR
          lea  rsi, [rip + SUBSYS_BOOT]
          lea  rdx, [rip + kind_dma_domain_fail_msg]
          lea  rcx, [rip + k_line]
          call klog_s1_d1

      kind_dma_domain_witness_done:

      // ============================================================
      // R30.M3-001 (#1061): KIND_OP_REGION witness — opens R30.M3, the
      // OpRegion / address-space milestone, and exercises the security
      // boundary of the whole round.
      //
      // Everything R30 landed before this milestone parsed and evaluated
      // firmware bytecode in a sandbox. KIND_OP_REGION is the capability
      // that authorises touching a physical address named by a
      // vendor-supplied, unsigned table. Per design/roadmap/
      // next-wave-softarch.md §3 R30: the OperationRegion abstraction
      // becomes a cap, and no other component of the system can silently
      // poke a hardware address.
      //
      // Sub-tests (any failure jumps to the fail marker with the stage
      // number from _kind_opreg_witness_stage):
      //   A. Pre-clean cap slots 28..33.
      //   B. Seed slot 28 = KIND_MEMORY (4) and slot 29 = KIND_IO_PORT
      //      (11), both with full rights. These are the two BASE
      //      authorities a root window may derive over.
      //   C. Containment arithmetic, including the OVERFLOW case: a
      //      request at 0xFFFFFFFFFFFFFFFF of length 2 must NOT be
      //      reported as contained. The naive `i_base + i_len <=
      //      o_base + o_len` form wraps and says yes.
      //   D. Root mint of a SystemMemory window over the KIND_MEMORY
      //      parent -> OPREG_MINT_OK, slot 33.
      //
      //      SLOT ORDERING IS PART OF THE FIXTURE, not an accident. The
      //      window chain is root=33 -> child=32 -> grandchild=30, i.e.
      //      DESCENDING, while the cascade walks the cap table
      //      ASCENDING. One pass therefore reaches only the root; the
      //      grandchild is not orphaned until the pass after its parent
      //      is revoked. Laid out the other way round (root at the
      //      lowest slot) a single-pass cascade would happen to finish
      //      the job in one sweep, and the fixed-point loop would be
      //      untested while looking tested. Mutation confirmed exactly
      //      that: with the ascending layout, neutralising the loop left
      //      the witness green.
      //   E. THE DERIVATION ASYMMETRY. The same SystemMemory root over
      //      the KIND_IO_PORT parent -> OPREG_MINT_BAD_PARENT. Without
      //      this, a holder of port authority could manufacture memory
      //      reach.
      //   F. And the converse: a SystemIO root over the KIND_IO_PORT
      //      parent -> OPREG_MINT_OK, slot 31. Both directions are
      //      asserted, because a gate that refused everything would pass
      //      a one-sided test.
      //   G. A BUS space (SMBus) is refused -> OPREG_MINT_BAD_SPACE.
      //   H. Derive a CONTAINED sub-window of slot 33 -> OK, slot 32.
      //   I. THE HEADLINE REFUSAL. Derive a window OUTSIDE slot 33's
      //      extent -> OPREG_MINT_NO_COVER, with slot 30 still null: the
      //      request was refused, not clipped to the covered part.
      //   J. Derive a grandchild of slot 33 through slot 32 -> OK,
      //      slot 30. This is the transitive-cascade fixture.
      //   K. Query ops through cap_invoke_dispatch: QUERY_BASE and
      //      QUERY_LEN on slot 32 return the derived window, not the
      //      parent's.
      //   L. Rights denial through the handler: a QUERY with no
      //      RIGHT_INVOKE -> INVOKE_DENIED.
      //   M. An unknown op -> INVOKE_UNSUPPORTED.
      //   N. TRANSITIVE CASCADE. Revoking by the KIND_MEMORY parent
      //      (slot 28) must reach slot 33 (its direct child), slot 32
      //      (child of 33) and slot 30 (child of 32) -> 3. A single-pass
      //      cascade returns 1 and leaves two live handles to addresses
      //      whose justification is gone.
      //   O. Slots 30 / 32 / 33 null; their rows freed.
      //   P. Revoke failure edges: revoke(33) on the now-null slot ->
      //      OPREG_REVOKE_ALREADY; revoke(28) on the KIND_MEMORY parent
      //      -> OPREG_REVOKE_WRONG_KIND, and slot 28 still intact.
      //   Q. Clean up: revoke slot 31 and clear slots 28/29, so the
      //      witness leaves the cap table exactly as it found it.
      //
      // Fingerprint ordering:
      //   R29 KIND_DMA_DOMAIN OK     (R29.M5-001/002)
      //   R30 KIND_OP_REGION OK      <- THIS WITNESS
      //   R29 LIFECYCLE FSM OK       (R29.M2-001)
      // ============================================================
      kind_op_region_witness:
          // -- A: pre-clean slots 28..33 (offset 28*24 = 672).
          mov  rax, 1
          lea  rcx, [rip + _kind_opreg_witness_stage]
          mov  [rcx], rax
          mov  rax, cap_table
          add  rax, 672
          xor  rcx, rcx
          mov  [rax + 0],   rcx
          mov  [rax + 8],   rcx
          mov  [rax + 16],  rcx
          mov  [rax + 24],  rcx
          mov  [rax + 32],  rcx
          mov  [rax + 40],  rcx
          mov  [rax + 48],  rcx
          mov  [rax + 56],  rcx
          mov  [rax + 64],  rcx
          mov  [rax + 72],  rcx
          mov  [rax + 80],  rcx
          mov  [rax + 88],  rcx
          mov  [rax + 96],  rcx
          mov  [rax + 104], rcx
          mov  [rax + 112], rcx
          mov  [rax + 120], rcx
          mov  [rax + 128], rcx
          mov  [rax + 136], rcx

          // -- B: seed the two base authorities.
          mov  rax, 2
          lea  rcx, [rip + _kind_opreg_witness_stage]
          mov  [rcx], rax
          mov  rax, cap_table
          add  rax, 672
          mov  rcx, 4                              // KIND_MEMORY
          mov  [rax + 0], rcx
          mov  rcx, 0x61B                          // R_OPREG_ALL
          mov  [rax + 8], rcx
          xor  rcx, rcx
          mov  [rax + 16], rcx
          mov  rcx, 11                             // KIND_IO_PORT
          mov  [rax + 24], rcx
          mov  rcx, 0x61B
          mov  [rax + 32], rcx
          xor  rcx, rcx
          mov  [rax + 40], rcx

          // -- C: containment arithmetic, including the wrap case.
          mov  rax, 3
          lea  rcx, [rip + _kind_opreg_witness_stage]
          mov  [rcx], rax
          mov  rdi, 0x1000
          mov  rsi, 0x1000
          mov  rdx, 0x1400
          mov  rcx, 0x400
          call opregion_range_contains
          cmp  rax, 1
          jne  kind_opreg_witness_fail

          mov  rax, 4
          lea  rcx, [rip + _kind_opreg_witness_stage]
          mov  [rcx], rax
          mov  rdi, 0x1000
          mov  rsi, 0x1000
          mov  rdx, 0x1C00
          mov  rcx, 0x800                          // runs past the end
          call opregion_range_contains
          cmp  rax, 0
          jne  kind_opreg_witness_fail

          mov  rax, 5
          lea  rcx, [rip + _kind_opreg_witness_stage]
          mov  [rcx], rax
          mov  rdi, 0x1000
          mov  rsi, 0x1000
          mov  rdx, 0xFFFFFFFFFFFFFFFF             // the wrap probe
          mov  rcx, 2
          call opregion_range_contains
          cmp  rax, 0
          jne  kind_opreg_witness_fail

          // -- D: SystemMemory root over KIND_MEMORY -> OK.
          mov  rax, 6
          lea  rcx, [rip + _kind_opreg_witness_stage]
          mov  [rcx], rax
          mov  rdi, 33                             // slot -- see the
                                                   //   slot-ordering note
          mov  rsi, 28                             // KIND_MEMORY parent
          mov  rdx, 0x61B                          // rights
          mov  rcx, 0                              // SystemMemory
          mov  r8,  0xE0000000                     // base
          mov  r9,  0x10000                        // len
          call opregion_cap_mint_root
          cmp  rax, 0
          jne  kind_opreg_witness_fail

          // -- E: the SAME space over the WRONG base kind -> BAD_PARENT.
          mov  rax, 7
          lea  rcx, [rip + _kind_opreg_witness_stage]
          mov  [rcx], rax
          mov  rdi, 31
          mov  rsi, 29                             // KIND_IO_PORT parent
          mov  rdx, 0x61B
          mov  rcx, 0                              // SystemMemory
          mov  r8,  0xE0000000
          mov  r9,  0x1000
          call opregion_cap_mint_root
          mov  rcx, 0xFFFFFFCB                     // OPREG_MINT_BAD_PARENT
          cmp  rax, rcx
          jne  kind_opreg_witness_fail

          // ... and the refused mint wrote no descriptor.
          mov  rax, 8
          lea  rcx, [rip + _kind_opreg_witness_stage]
          mov  [rcx], rax
          mov  rax, cap_table
          add  rax, 744                            // slot 31 * 24
          mov  rcx, [rax + 0]
          cmp  rcx, 0
          jne  kind_opreg_witness_fail

          // -- F: the converse direction is permitted.
          mov  rax, 9
          lea  rcx, [rip + _kind_opreg_witness_stage]
          mov  [rcx], rax
          mov  rdi, 31
          mov  rsi, 29                             // KIND_IO_PORT parent
          mov  rdx, 0x61B
          mov  rcx, 1                              // SystemIO
          mov  r8,  0x62                           // the EC port pair
          mov  r9,  5
          call opregion_cap_mint_root
          cmp  rax, 0
          jne  kind_opreg_witness_fail

          // -- G: a bus space is not an address space.
          mov  rax, 10
          lea  rcx, [rip + _kind_opreg_witness_stage]
          mov  [rcx], rax
          mov  rdi, 32
          mov  rsi, 28
          mov  rdx, 0x61B
          mov  rcx, 4                              // SMBus
          mov  r8,  0x100
          mov  r9,  0x10
          call opregion_cap_mint_root
          mov  rcx, 0xFFFFFFC7                     // OPREG_MINT_BAD_SPACE
          cmp  rax, rcx
          jne  kind_opreg_witness_fail

          // -- H: derive a CONTAINED sub-window.
          mov  rax, 11
          lea  rcx, [rip + _kind_opreg_witness_stage]
          mov  [rcx], rax
          mov  rdi, 32                             // child slot
          mov  rsi, 33                             // parent window
          mov  rdx, 0x61B
          mov  rcx, 0xE0001000
          mov  r8,  0x100
          call opregion_cap_derive
          cmp  rax, 0
          jne  kind_opreg_witness_fail

          // -- I: THE HEADLINE. A window outside the parent's extent.
          mov  rax, 12
          lea  rcx, [rip + _kind_opreg_witness_stage]
          mov  [rcx], rax
          mov  rdi, 30
          mov  rsi, 33
          mov  rdx, 0x61B
          mov  rcx, 0xF0000000                     // nowhere near the root
          mov  r8,  0x100
          call opregion_cap_derive
          mov  rcx, 0xFFFFFFC5                     // OPREG_MINT_NO_COVER
          cmp  rax, rcx
          jne  kind_opreg_witness_fail

          // Refused, NOT clipped: slot 33 must still be null. A handler
          // that had truncated to the covered part would have written a
          // perfectly valid-looking descriptor here.
          mov  rax, 13
          lea  rcx, [rip + _kind_opreg_witness_stage]
          mov  [rcx], rax
          mov  rax, cap_table
          add  rax, 720                            // slot 30 * 24
          mov  rcx, [rax + 0]
          cmp  rcx, 0
          jne  kind_opreg_witness_fail

          // -- J: a grandchild, for the transitive cascade.
          mov  rax, 14
          lea  rcx, [rip + _kind_opreg_witness_stage]
          mov  [rcx], rax
          mov  rdi, 30                             // BELOW its ancestors
          mov  rsi, 32                             // child of the root
          mov  rdx, 0x61B
          mov  rcx, 0xE0001040
          mov  r8,  0x40
          call opregion_cap_derive
          cmp  rax, 0
          jne  kind_opreg_witness_fail

          // -- K: query ops through dispatch return the DERIVED window.
          mov  rax, 15
          lea  rcx, [rip + _kind_opreg_witness_stage]
          mov  [rcx], rax
          mov  rdi, 32
          mov  rsi, 1                              // OPREG_OP_QUERY_BASE
          call cap_invoke_dispatch
          mov  rcx, 0xE0001000
          cmp  rax, rcx
          jne  kind_opreg_witness_fail

          mov  rax, 16
          lea  rcx, [rip + _kind_opreg_witness_stage]
          mov  [rcx], rax
          mov  rdi, 32
          mov  rsi, 2                              // OPREG_OP_QUERY_LEN
          call cap_invoke_dispatch
          cmp  rax, 0x100
          jne  kind_opreg_witness_fail

          // -- L: rights denial. Reached with the row live, so the gate
          //    is proven to precede the work rather than to follow it.
          mov  rax, 17
          lea  rcx, [rip + _kind_opreg_witness_stage]
          mov  [rcx], rax
          xor  rdi, rdi                            // no rights at all
          xor  rsi, rsi                            // row 0
          xor  rdx, rdx                            // OPREG_OP_QUERY_SPACE
          call cap_handler_op_region
          mov  rcx, 0xFFFFFFFFFFFFFFFD             // INVOKE_DENIED
          cmp  rax, rcx
          jne  kind_opreg_witness_fail

          // -- M: an unknown op.
          mov  rax, 18
          lea  rcx, [rip + _kind_opreg_witness_stage]
          mov  [rcx], rax
          mov  rdi, 0x61B
          xor  rsi, rsi
          mov  rdx, 9
          call cap_handler_op_region
          mov  rcx, 0xFFFFFFFFFFFFFFFC             // INVOKE_UNSUPPORTED
          cmp  rax, rcx
          jne  kind_opreg_witness_fail

          // -- N: TRANSITIVE cascade from the KIND_MEMORY parent.
          mov  rax, 19
          lea  rcx, [rip + _kind_opreg_witness_stage]
          mov  [rcx], rax
          mov  rdi, 28
          call opregion_cascade_revoke_by_parent
          cmp  rax, 3
          jne  kind_opreg_witness_fail

          // -- O: all three descriptors cleared.
          mov  rax, 20
          lea  rcx, [rip + _kind_opreg_witness_stage]
          mov  [rcx], rax
          mov  rax, cap_table
          add  rax, 720
          mov  rcx, [rax + 0]                      // slot 30 (grandchild)
          cmp  rcx, 0
          jne  kind_opreg_witness_fail
          mov  rcx, [rax + 48]                     // slot 32 (child)
          cmp  rcx, 0
          jne  kind_opreg_witness_fail
          mov  rcx, [rax + 72]                     // slot 33 (root)
          cmp  rcx, 0
          jne  kind_opreg_witness_fail

          // ... and their rows are free (row 0 was the memory root).
          mov  rax, 21
          lea  rcx, [rip + _kind_opreg_witness_stage]
          mov  [rcx], rax
          xor  rdi, rdi
          call opregion_tail_valid
          cmp  rax, 0
          jne  kind_opreg_witness_fail

          // -- P: revoke failure edges.
          mov  rax, 22
          lea  rcx, [rip + _kind_opreg_witness_stage]
          mov  [rcx], rax
          mov  rdi, 33
          call opregion_cap_revoke
          mov  rcx, 0xFFFFFFC2                     // OPREG_REVOKE_ALREADY
          cmp  rax, rcx
          jne  kind_opreg_witness_fail

          mov  rax, 23
          lea  rcx, [rip + _kind_opreg_witness_stage]
          mov  [rcx], rax
          mov  rdi, 28                             // the KIND_MEMORY parent
          call opregion_cap_revoke
          mov  rcx, 0xFFFFFFC3                     // OPREG_REVOKE_WRONG_KIND
          cmp  rax, rcx
          jne  kind_opreg_witness_fail

          mov  rax, 24
          lea  rcx, [rip + _kind_opreg_witness_stage]
          mov  [rcx], rax
          mov  rax, cap_table
          add  rax, 672
          mov  rcx, [rax + 0]
          cmp  rcx, 4                              // still KIND_MEMORY
          jne  kind_opreg_witness_fail

          // -- Q: leave the table as we found it.
          mov  rdi, 31
          call opregion_cap_revoke
          mov  rax, cap_table
          add  rax, 672
          xor  rcx, rcx
          mov  [rax + 0],  rcx
          mov  [rax + 8],  rcx
          mov  [rax + 16], rcx
          mov  [rax + 24], rcx
          mov  [rax + 32], rcx
          mov  [rax + 40], rcx

          mov  rdi, 3                              // LEVEL_INFO
          lea  rsi, [rip + SUBSYS_BOOT]
          lea  rdx, [rip + kind_op_region_ok_msg]
          call klog_s1
          jmp  kind_op_region_witness_done

      kind_opreg_witness_fail:
          lea  rax, [rip + _kind_opreg_witness_stage]
          mov  r8,  [rax]
          mov  rdi, 1                              // LEVEL_ERROR
          lea  rsi, [rip + SUBSYS_BOOT]
          lea  rdx, [rip + kind_op_region_fail_msg]
          lea  rcx, [rip + k_line]
          call klog_s1_d1

      kind_op_region_witness_done:


      pop rbp;
      ret
    }
  }
}
