// src/kernel/boot/witness/r54_bdev_flush.pdx — R54.M1-002 (#1779)
//
// Real-HW smoke witness for nvw_batch_flush's live submit path
// (bdev_write.pdx §nvw_batch_flush, R54.M1-002 rewrite over
// nvme_write_blocking OPC=0x01, sync.pdx R54.M1-001 / #1778).
//
// -----------------------------------------------------------------------------
// What this witness proves
// -----------------------------------------------------------------------------
//
//   (A) The `r54_bdev_flush_witness` symbol links into build/kernel.elf
//       and is reachable as a `call r54_bdev_flush_witness` target from
//       GDB or from a future kernel_main wire-up on real hardware.
//
//   (B) When invoked, the witness drives one submit + flush + completion
//       cycle through the module's public API:
//         (1) nvw_reset — clean queue and counters,
//         (2) nvw_submit(lba=0x10, len=0x1000) — expect cid=1,
//         (3) nvw_batch_flush() — expect 1 newly-submitted; emits the
//             R54.M1-002 fingerprint `pdxb bdev flush ok [legacy: BDEV
//             FLUSH OK] pending=0x1 submitted=0x1` via klog_s1_x2,
//         (4) nvw_completion(cid=1) — expect 1 (accepted),
//         (5) emit local witness fingerprint R54 BDEV FLUSH OK.
//
//   (C) The witness runs BOTH under a substrate posture (no live NVMe
//       IO SQ pair, _nvme_io_queue_count == 0) AND under a live NVMe
//       controller. The nvw_batch_flush branch on _nvme_io_queue_count
//       is the load-bearing invariant: substrate takes the mark-only
//       path (no driver call); live calls nvme_write_blocking against
//       _nvw_flush_scratch (a page-aligned .bss zero page) and stamps
//       SUBMITTED only when status == 0. Either way, on success the
//       fingerprint records pending=1 submitted=1.
//
// -----------------------------------------------------------------------------
// What this witness does NOT prove
// -----------------------------------------------------------------------------
//
//   - Multi-entry flushes (batching 2..NVW_SQ_DEPTH entries). Composes
//     with the existing tests/kernel/fs/pdxfs/nvme_write_synth.pdx
//     substrate-mode witness (S4 flushes 3 entries).
//   - Caller-supplied source page. R54.M1-002 uses the module-private
//     _nvw_flush_scratch as a stand-in; the widening lands buf_pa into
//     the SQ entry format (NVW_ENTRY_WORDS 4 -> wider stride).
//   - WAL-fsync sequencing. bdev_write.pdx §0 records that the WAL
//     invariant stays at the call site (wal.pdx) and this module is
//     the plumbing.
//
// -----------------------------------------------------------------------------
// Fingerprint dictionary
// -----------------------------------------------------------------------------
//
//   Probe banner: "R54 BDEV FLUSH PROBE\n"
//   Flush ok:     (emitted by nvw_batch_flush itself, not this witness)
//                 "pdxb bdev flush ok [legacy: BDEV FLUSH OK] pending=0x1 submitted=0x1"
//   Witness ok:   "R54 BDEV FLUSH OK\n"
//   Witness fail: "R54 BDEV FLUSH FAIL\n"
//
// The "pdxb bdev flush ok" line is emitted by bdev_write.pdx's own
// nvw_batch_flush klog_s1_x2 call; this witness does NOT re-emit it.
//
// -----------------------------------------------------------------------------
// Wire posture at R54.M1
// -----------------------------------------------------------------------------
//
// NOT wired into kernel_main. Symbol existence + build-time link
// verification are the R54.M1 acceptance criterion; live invocation is
// R55+ once the driver-attach ceremony surfaces a real NVMe controller
// on the default boot path. Run-smoke mode `boot_r54_bdev_flush` is a
// SKIP-echo, matching the R54.M1-001 nvme_write / pdxfs_lite_e2e /
// concurrent_io / msix_ir_round_robin precedent.
//
// -----------------------------------------------------------------------------
// Register plan
// -----------------------------------------------------------------------------
//
//   1 push (rbx) = 8 B; entry rsp%16==8 + 8 = 16, %16==0 — aligned for
//   nested uart_puts / nvw_reset / nvw_submit / nvw_batch_flush /
//   nvw_completion calls.
//
// -----------------------------------------------------------------------------
// Reserved-label discipline
// -----------------------------------------------------------------------------
//
// Labels prefixed `r54bf_` throughout. Grep audit: no `r54bf_` hits
// anywhere else in src/kernel/ or tests/.

module R54BdevFlush = structure {

  // Fingerprint strings. Length counts include the trailing "\n\0".
  pub let _r54bf_probe_msg   : [u8; 22] = "R54 BDEV FLUSH PROBE\n\0"
  pub let _r54bf_ok_msg      : [u8; 19] = "R54 BDEV FLUSH OK\n\0"
  pub let _r54bf_fail_msg    : [u8; 21] = "R54 BDEV FLUSH FAIL\n\0"

  // ==========================================================================
  // r54_bdev_flush_witness() -> u64
  //
  //   Returns:
  //     0 — full OK path (submit, flush, complete all succeeded).
  //     1 — FAIL (any stage returned an unexpected value).
  //
  //   Body per module header. The nvw_batch_flush fingerprint on the
  //   wire is emitted by nvw_batch_flush itself, not this witness.
  // ==========================================================================
  pub let r54_bdev_flush_witness : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R54.M1-002 (#1779). Symbol-existence + optional live-HW submit + flush + complete witness for nvw_batch_flush's R54.M1-002 rewrite. Body: (1) 1-push callee-save prologue (rbx = staging). Entry rsp%16==8 + 8 pushed = 16, %16==0 — aligned for nested uart_puts / nvw_* calls. (2) Emit probe banner. (3) nvw_reset — always succeeds (leaf, no error). (4) nvw_submit(lba=0x10, len=0x1000) — expect cid == 1 (nvw_reset primed next_cid to 1). On mismatch -> emit FAIL, return 1. (5) nvw_batch_flush() — expect 1 newly-submitted; this call also emits the R54.M1-002 fingerprint on the wire (pdxb bdev flush ok [legacy: BDEV FLUSH OK] pending=0x1 submitted=0x1) via klog_s1_x2. On mismatch -> FAIL. (6) nvw_completion(cid=1) — expect 1 (accepted). On mismatch -> FAIL. (7) emit R54 BDEV FLUSH OK, return 0. Reserved labels: r54bf_.",
      block: {
        push rbx;

        // -----------------------------------------------------------
        // (2) Emit probe banner.
        // -----------------------------------------------------------
        lea rdi, [rip + _r54bf_probe_msg];
        call uart_puts;

        // -----------------------------------------------------------
        // (3) nvw_reset — leaf, no failure return.
        // -----------------------------------------------------------
        call nvw_reset;

        // -----------------------------------------------------------
        // (4) nvw_submit(lba=0x10, len=0x1000) -> cid=1.
        // -----------------------------------------------------------
        mov rdi, 0x10;
        mov rsi, 0x1000;
        call nvw_submit;
        cmp rax, 1;
        jne r54bf_fail;

        // -----------------------------------------------------------
        // (5) nvw_batch_flush() -> 1. Emits the R54.M1-002 fingerprint
        //     from inside nvw_batch_flush's own klog_s1_x2 call.
        // -----------------------------------------------------------
        call nvw_batch_flush;
        cmp rax, 1;
        jne r54bf_fail;

        // -----------------------------------------------------------
        // (6) nvw_completion(cid=1) -> 1 (accepted).
        // -----------------------------------------------------------
        mov rdi, 1;
        call nvw_completion;
        cmp rax, 1;
        jne r54bf_fail;

        // -----------------------------------------------------------
        // (7) Success — emit local witness fingerprint.
        // -----------------------------------------------------------
        lea rdi, [rip + _r54bf_ok_msg];
        call uart_puts;

        xor rax, rax;
        pop rbx;
        ret;

      r54bf_fail:
        lea rdi, [rip + _r54bf_fail_msg];
        call uart_puts;
        mov rax, 1;
        pop rbx;
        ret
      }
    }
}
