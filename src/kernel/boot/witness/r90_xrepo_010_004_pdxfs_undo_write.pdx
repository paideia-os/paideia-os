// src/kernel/boot/witness/r90_xrepo_010_004_pdxfs_undo_write.pdx --
// R90-XREPO.010.M1-004 (paideia-os #2112).
//
// Boot-time witness proving the sys_pdxfs_undo_write (sysno 107) +
// sys_pdxfs_txn_abort (sysno 105) end-to-end undo-replay path in the
// same boot.  Ten stages:
//
//   (1)  pdxfs_txn_table_reset + pdxfs_txn_undo_reset.  Fresh substrate.
//   (2)  Scrub cap slots 168..175 for a predictable window.
//   (3)  Mint the KIND_MEMORY parent at slot 168 carrying RIGHT_MINT so
//        pdxfs_txn_cap_mint_inner's parent gate accepts it.
//   (4)  sys_pdxfs_txn_open_body(parent=168, mode=PXT_MODE_MODIFY,
//        txn_id=0xE400, wal_off=0x9200) -> cap_slot.  Resolve to row_id.
//   (5)  Allocate a fresh tmpfs inode via tmpfs_inode_alloc; stamp
//        type=VNODE_TYPE_REG (1) at +0 and flags=TMPFS_INODE_FLAG_VALID
//        (1) at +1.  The rest of the 256-byte slot stays zero -- size=0,
//        page_ptrs[16] all NULL (lazy allocation via tmpfs_write), no
//        dentry linkage (this inode is orphan/private to the witness so
//        no tmpfs_lookup path ever reaches it -- exactly the shape we
//        want: no interference with the /bin seed inodes that run
//        earlier in the boot cascade).
//   (6)  tmpfs_write(inode, pxuw_original_bytes, 16, 0) -- writes the
//        pre-image ('A' bytes) at offset 0.  A 16-byte payload is a
//        small but load-bearing size: two u64 slots + one for a false-
//        positive-guard tail.
//   (7)  sys_pdxfs_undo_write_body(cap_slot, inode, offset=0, len=16,
//        kbuf=pxuw_original_bytes) -- persists the pre-image into the
//        row's undo buffer.  Return must be 0.
//   (8)  tmpfs_write(inode, pxuw_overwrite_bytes, 16, 0) -- overwrites
//        with 'B' bytes at the same offset.  A subsequent tmpfs_read
//        must observe the 'B' pattern for the witness to have any
//        force -- if this fails the whole test is meaningless.
//   (9)  Read back via tmpfs_read into _pxuw_readback_scratch; assert
//        the current file contents match pxuw_overwrite_bytes.  This
//        pins the "we actually mutated the file after staging undo"
//        precondition.
//   (10) sys_pdxfs_txn_abort_body(cap_slot) -- must return 0.  Internal
//        pdxfs_txn_undo_replay call restores the pre-image via
//        tmpfs_write against the same (inode, offset, len).  Two
//        fingerprints emit here: the existing `sys pdxfs txn abort ok`
//        line AND the new `sys pdxfs undo replay ok -- txn=<row>
//        entries=1` line.
//   (11) Read back via tmpfs_read; assert current file contents match
//        pxuw_original_bytes.  THIS IS THE LOAD-BEARING ASSERTION: the
//        undo record was persisted, the abort walked it, and the
//        pre-image was restored via tmpfs_write.
//   (12) Emit `boot pdxfs undo ok -- count=1` rollup fingerprint via
//        klog_s1_d1(SUBSYS_BOOT, tag_boot_pdxfs_undo_ok, k_count, 1).
//        One rollup covers the whole scenario since a failure in any
//        of stages (1)..(11) short-circuits to the skip funnel.
//
// FINGERPRINTS: five total per successful boot from this witness:
//   `sys pdxfs undo write ok  -- txn=<row> len=16`      (from sys_pdxfs_undo_write_body)
//   `sys pdxfs txn abort ok   -- txn=<row>`             (from sys_pdxfs_txn_abort_body, existing)
//   `sys pdxfs undo replay ok -- txn=<row> entries=1`   (from sys_pdxfs_txn_abort_body, new #2112)
//   `boot pdxfs undo ok -- count=1`                     (this witness's own rollup)
//
// Failure funnel emits `boot pdxfs undo skip -- reason=1 stage=S`
// via klog_s1_d2 with stage in [1..11] naming the failure point.
//
// SLOT-RANGE HYGIENE: cap_table slots 168..175 (disjoint from the
// established ranges: 116..127 = pdxfs_txn_ops_synth, 128..135 =
// pdxfs_txn_ops_real_synth, 136..143 = pdxfs_pkg_install_smoke,
// 144..151 = pdxfs_pkg_install_pipeline's future range, 160..167 =
// r90_xrepo_010_003_pdxfs_txn_lifecycle).  Only slot 168 is actively
// used (the KIND_MEMORY parent); the remainder are scrubbed for
// symmetry.  sys_pdxfs_txn_open_body's free-slot scan may land the
// KIND_PDXFS_TXN cap in any slot outside this range -- that's fine, we
// resolve via pdxfs_txn_row_of_slot which is slot-independent.
//
// PLACEMENT (kernel_main.pdx): after witness_r90_xrepo_010_003_pdxfs_
// txn_lifecycle (last of the R90-XREPO.010 witness block) and before
// witness_r17_init_sched, so the pdxfs txn / undo tables + cap table
// + tmpfs inode pool are in a predictable pre-init state.  Depends on
// witness_r20b_substrate having wired the KIND_PDXFS_TXN dispatch bank
// already (yes, that lands at the very start of the R15/R20b substrate
// block above the R100-PREP wave).
//
// LEGACY OK TOKEN: the two `sys pdxfs undo {write,replay} ok` tags
// carry standalone uppercase "OK" tokens in their bracketed legacy-
// alias suffixes and so require allowlist entries in tools/verify-
// fingerprint-coverage.sh (landed alongside this witness).  The rollup
// `boot pdxfs undo ok --` is all-lowercase and so bypasses the OK-token
// gate entirely (same posture as the boot_pdxfs_stat_ok / boot_pfrb_ok
// precedents one milestone up).
//
// Reserved-label discipline: labels prefixed `pxuw_` (PdXfs Undo
// Write).  `loop`, `if` etc. are keywords and never used as labels.
//
// Frame prologue: manual push/pop (same as every other witness_*.pdx).

module R90XrepoPdxfsUndoWrite = structure {

  // ==========================================================================
  // Static test vectors.  16-byte payloads split as two u64 slots so
  // the assertion loop is two `cmp qword` per check (not 16 mov_b).
  // ==========================================================================
  pub let pxuw_original_bytes  : [u64; 2] = [0x4141414141414141, 0x4141414141414141]
  pub let pxuw_overwrite_bytes : [u64; 2] = [0x4242424242424242, 0x4242424242424242]

  pub let mut _pxuw_readback_scratch : [u64; 2] = uninit @align(8)

  // Skip-path fingerprint tag.  Locally scoped -- no other witness
  // needs it, and the text carries no standalone uppercase OK token
  // so verify-fingerprint-coverage.sh's OK_TOK extractor does not
  // gate on it.  Byte count NUL-inclusive per #699 discipline:
  // "boot pdxfs undo skip " = 21 chars + NUL = 22.
  pub let pxuw_skip_msg : [u8; 22] = "boot pdxfs undo skip \0"
  pub let pxuw_k_reason : [u8;  7] = "reason\0"
  pub let pxuw_k_stage  : [u8;  6] = "stage\0"

  pub let PXUW_PAYLOAD_LEN  : u64 = 16
  pub let PXUW_PARENT_SLOT  : u64 = 168
  pub let PXUW_TXN_ID       : u64 = 0xE400
  pub let PXUW_WAL_OFF      : u64 = 0x9200
  pub let PXUW_MODE_MODIFY  : u64 = 2      // PXT_MODE_MODIFY

  // ==========================================================================
  // pxuw_clear() -> ()
  //
  // Scrub cap_table slots 168..175 for the witness window.  Same shape
  // as pxtl_clear one slot-range up.  One callee-save push (rbx) leaves
  // rsp%16 == 0 for the nested cap_mint_write call from entry rsp%16
  // == 8 SysV.
  // ==========================================================================
  pub let pxuw_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R90-XREPO.010.M1-004 (paideia-os #2112) boot witness helper: scrub cap_table slots 168..175 for the undo-write witness. Same shape as pxtl_clear in r90_xrepo_010_003_pdxfs_txn_lifecycle.pdx (one slot-range up). One callee-save push (rbx) leaves rsp%16 == 0 for the nested cap_mint_write call from entry rsp%16 == 8. Labels prefixed pxuw_c_.",
      block: {
        push rbx;
        mov rbx, 168;
      pxuw_c_loop:
        cmp rbx, 176;
        jae pxuw_c_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp pxuw_c_loop;
      pxuw_c_done:
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // pxuw_mem(slot, key, rights) -> ()
  //
  // Mint a synthetic KIND_MEMORY parent at `slot`.  Same shape as
  // pxtl_mem across the sibling ops witnesses.  Three callee-save
  // pushes align rsp%16 == 0 for the nested cap_mint_write call.
  // ==========================================================================
  pub let pxuw_mem : (u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (key: u64) (rights: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R90-XREPO.010.M1-004 (paideia-os #2112) boot witness helper: mint synthetic KIND_MEMORY parent for the undo-write witness. Kind=4 (KIND_MEMORY); rights per caller (typically RIGHT_MINT = 0x200). Mirrors pxtl_mem shape one-for-one. Three callee-save pushes (r12/r13/r14) leave rsp%16 == 0 for the nested cap_mint_write call. Labels prefixed pxuw_m_.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;                    // slot
        mov r13, rsi;                    // key
        mov r14, rdx;                    // rights
        mov rdi, r12;
        mov rsi, 4;                      // KIND_MEMORY
        mov rdx, r14;                    // rights
        mov rcx, r13;                    // target_ptr = key
        call cap_mint_write;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // pxuw_init_reg_inode(inode_idx) -> ()
  //
  // Stamp a freshly-allocated tmpfs inode as a valid REG inode:
  // type=VNODE_TYPE_REG (1) at +0, flags=TMPFS_INODE_FLAG_VALID (1) at
  // +1.  Every other field stays at .bss zero -- size=0 lets
  // tmpfs_write establish content at any offset, page_ptrs[16] all
  // NULL means tmpfs_write's lazy-allocation path takes over, no
  // dentry linkage means the inode is orphan/private to this witness.
  //
  // Leaf helper -- one nested call (tmpfs_inode_slot).  Single push
  // (rbx) leaves rsp%16 == 0 for that call from entry rsp%16 == 8.
  // ==========================================================================
  pub let pxuw_init_reg_inode : (u64) -> () !{mem} @{} =
    fn (inode_idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R90-XREPO.010.M1-004 (paideia-os #2112) boot witness helper: stamp type=1 (VNODE_TYPE_REG) and flags=1 (TMPFS_INODE_FLAG_VALID) into a fresh tmpfs inode slot so tmpfs_write's type gate accepts it. The remaining 254 bytes of the 256-byte slot stay at .bss zero -- size=0, page_ptrs[16] all NULL (lazy allocation via tmpfs_write), no dentry linkage (the inode is orphan/private to the witness so no tmpfs_lookup path ever reaches it). Single callee-save push (rbx) preserves inode_idx across the tmpfs_inode_slot call from entry rsp%16 == 8 SysV. mov_b for the byte stores per the frozen tmpfs inode layout (init.pdx L52/L57 precedent). Labels prefixed pxuw_ir_.",
      block: {
        push rbx;
        mov rbx, rdi;                    // save inode_idx
        mov rdi, rbx;
        call tmpfs_inode_slot;           // rax = &inode
        mov rcx, 1;
        mov_b [rax + 0], rcx;            // type = VNODE_TYPE_REG
        mov_b [rax + 1], rcx;            // flags = TMPFS_INODE_FLAG_VALID
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // witness_r90_xrepo_010_004_pdxfs_undo_write() -> ()
  //
  // Register plan (6 callee-save pushes + `sub rsp, 8` pad = 56 bytes
  // -> rsp%16 == 0 for every nested call from entry rsp%16 == 8 SysV):
  //   rbx = cap_slot     (survives sys_pdxfs_undo_write + tmpfs_write +
  //                        sys_pdxfs_txn_abort_body)
  //   r12 = row_id       (survives every scenario stage)
  //   r13 = inode_idx    (allocated in step (5), survives every write)
  //   r14 = current stage code (1..12) for the skip funnel
  //   r15 = unused (pushed for alignment symmetry)
  //   rbp = unused (pushed for alignment symmetry)
  //
  // Six pushes on entry rsp%16==8 land rsp%16==8 (each push subtracts 8;
  // 6*8=48 == 0 mod 16 delta, so the parity stays). The `sub rsp, 8` pad
  // brings %16 to 0 for the nested calls (matches the sibling r003
  // witness's 5-push discipline scaled to a wider register set here).
  // ==========================================================================
  pub let witness_r90_xrepo_010_004_pdxfs_undo_write : () -> () !{mem, sysreg} @{boot, cap} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot, cap},
      justification: "R90-XREPO.010.M1-004 (paideia-os #2112): boot witness for sys_pdxfs_undo_write (sysno 107) + the sys_pdxfs_txn_abort (sysno 105) undo-replay extension. Six callee-save pushes (rbx/r12/r13/r14/r15/rbp) leave rsp%16 == 0 for every nested call from entry rsp%16 == 8 (matches every sibling witness in this cascade). One end-to-end scenario in one boot: open txn -> allocate a REG tmpfs inode -> write pre-image ('A' pattern, 16 bytes) -> stage undo record -> overwrite with 'B' pattern -> verify current content is 'B' -> abort txn -> verify current content restored to 'A' pattern. Bypasses the dispatch shims (boot context, no ring-3 cap check applies) and calls the new sys_pdxfs_undo_write_body + existing sys_pdxfs_txn_abort_body directly, which internally exercise pdxfs_txn_undo_append + pdxfs_txn_undo_replay + tmpfs_write + klog. Reset _pdxfs_txn_table (via pdxfs_txn_table_reset) AND _pdxfs_txn_undo_state (via pdxfs_txn_undo_reset) before the scenario so a re-run lands in a clean pool -- CRITICAL because the boot cascade above already runs r90_xrepo_010_003_pdxfs_txn_lifecycle which leaves rows and (if that witness ever grew an undo record) state behind. tmpfs_inode_alloc + pxuw_init_reg_inode produce a private/orphan REG inode disjoint from every /bin seed inode; the witness's own tmpfs_write / tmpfs_read pair reaches that inode by explicit inode_idx (never via tmpfs_lookup) so no dentry-linkage state matters. Effects/capabilities: {mem,sysreg}@{boot,cap} matches every substrate-mutating witness. Encoder-conservative: cmp/je/jne/jae/mov/lea/xor/push/pop/call/sub/add/ret only -- every form already proven at this exact shape in the sibling r90_xrepo_010_003 witness. Labels prefixed pxuw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;
        sub rsp, 8;                      // align rsp%16 == 0 for nested calls

        mov r14, 1;                      // stage counter

        // ==================================================================
        // (1) Reset the txn table + undo state + scrub cap slots.
        // ==================================================================
        call pdxfs_txn_table_reset;
        call pdxfs_txn_undo_reset;

        // ==================================================================
        // (2) Scrub cap_table slots 168..175.
        // ==================================================================
        mov r14, 2;
        call pxuw_clear;

        // ==================================================================
        // (3) Mint the KIND_MEMORY parent at slot 168 with RIGHT_MINT.
        // ==================================================================
        mov r14, 3;
        mov rdi, 168;                    // PXUW_PARENT_SLOT
        mov rsi, 0xF168;                 // opaque parent key
        mov rdx, 0x200;                  // RIGHT_MINT
        call pxuw_mem;

        // ==================================================================
        // (4) Open the transaction; resolve to row_id.
        // ==================================================================
        mov r14, 4;
        mov rdi, 168;                    // parent_slot
        mov rsi, 2;                      // PXT_MODE_MODIFY
        mov rdx, 0xE400;                 // txn_id
        mov rcx, 0x9200;                 // wal_off
        call sys_pdxfs_txn_open_body;
        mov r10, 256;
        cmp rax, r10;
        jae pxuw_skip;
        mov rbx, rax;                    // rbx = cap_slot

        mov rdi, rbx;
        call pdxfs_txn_row_of_slot;
        mov r10, 16;                     // PXT_MAX
        cmp rax, r10;
        jae pxuw_skip;                   // PXT_ROW_NONE(0xFF) is >= 16
        mov r12, rax;                    // r12 = row_id

        // ==================================================================
        // (5) Allocate a fresh REG tmpfs inode.
        // ==================================================================
        mov r14, 5;
        call tmpfs_inode_alloc;
        mov r10, 0xFFFF;                 // TMPFS_INODE_ALLOC_OOM
        cmp rax, r10;
        je  pxuw_skip;
        mov r13, rax;                    // r13 = inode_idx

        mov rdi, r13;
        call pxuw_init_reg_inode;

        // ==================================================================
        // (6) tmpfs_write pre-image bytes ('A' pattern, 16 bytes).
        // ==================================================================
        mov r14, 6;
        mov rdi, r13;                    // inode_idx
        lea rsi, [rip + pxuw_original_bytes];
        mov rdx, 16;                     // len
        xor rcx, rcx;                    // offset = 0
        call tmpfs_write;
        cmp rax, 16;                     // must return len on success
        jne pxuw_skip;

        // ==================================================================
        // (7) sys_pdxfs_undo_write_body -- stage the pre-image.
        // ==================================================================
        mov r14, 7;
        mov rdi, rbx;                    // cap_slot
        mov rsi, r13;                    // inode_no
        xor rdx, rdx;                    // offset = 0
        mov rcx, 16;                     // len
        lea r8, [rip + pxuw_original_bytes];
        call sys_pdxfs_undo_write_body;
        cmp rax, 0;
        jne pxuw_skip;

        // ==================================================================
        // (8) tmpfs_write overwrite bytes ('B' pattern, 16 bytes) at
        //     the same (inode, offset).
        // ==================================================================
        mov r14, 8;
        mov rdi, r13;
        lea rsi, [rip + pxuw_overwrite_bytes];
        mov rdx, 16;
        xor rcx, rcx;
        call tmpfs_write;
        cmp rax, 16;
        jne pxuw_skip;

        // ==================================================================
        // (9) Read back; verify current content matches 'B' pattern.
        //     tmpfs_read(inode, buf, len, offset) returns bytes-read.
        // ==================================================================
        mov r14, 9;
        mov rdi, r13;
        lea rsi, [rip + _pxuw_readback_scratch];
        mov rdx, 16;
        xor rcx, rcx;
        call tmpfs_read;
        cmp rax, 16;
        jne pxuw_skip;

        // Compare _pxuw_readback_scratch[0..2] == pxuw_overwrite_bytes[0..2].
        lea r10, [rip + _pxuw_readback_scratch];
        lea r11, [rip + pxuw_overwrite_bytes];
        mov r9, [r10 + 0];
        mov r8, [r11 + 0];
        cmp r9, r8;
        jne pxuw_skip;
        mov r9, [r10 + 8];
        mov r8, [r11 + 8];
        cmp r9, r8;
        jne pxuw_skip;

        // ==================================================================
        // (10) sys_pdxfs_txn_abort_body -- must return 0 and internally
        //      replay the undo record via tmpfs_write.
        // ==================================================================
        mov r14, 10;
        mov rdi, rbx;                    // cap_slot
        call sys_pdxfs_txn_abort_body;
        cmp rax, 0;
        jne pxuw_skip;

        // ==================================================================
        // (11) Read back; verify current content restored to 'A' pattern.
        //      This is the LOAD-BEARING assertion.
        // ==================================================================
        mov r14, 11;
        mov rdi, r13;
        lea rsi, [rip + _pxuw_readback_scratch];
        mov rdx, 16;
        xor rcx, rcx;
        call tmpfs_read;
        cmp rax, 16;
        jne pxuw_skip;

        // Compare _pxuw_readback_scratch[0..2] == pxuw_original_bytes[0..2].
        lea r10, [rip + _pxuw_readback_scratch];
        lea r11, [rip + pxuw_original_bytes];
        mov r9, [r10 + 0];
        mov r8, [r11 + 0];
        cmp r9, r8;
        jne pxuw_skip;
        mov r9, [r10 + 8];
        mov r8, [r11 + 8];
        cmp r9, r8;
        jne pxuw_skip;

        // ==================================================================
        // (12) Emit rollup fingerprint.
        //      `boot pdxfs undo ok -- count=1`
        // ==================================================================
        mov r14, 12;
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_boot_pdxfs_undo_ok];
        lea rcx, [rip + k_count];
        mov r8, 1;                       // count = 1 scenario exercised
        call klog_s1_d1;
        jmp pxuw_done;

      pxuw_skip:
        // Skip funnel.  reason=1 today (single failure class); stage=<r14>
        // names which of the 11 stages tripped.  Emits `boot pdxfs undo
        // skip -- reason=1 stage=<S>` via klog_s1_d2.  klog_s1_d2's v2
        // (7th arg) is stack-passed: `sub rsp, 8` aligns %16 -> 8, then
        // `push r14` -> %16 == 0 for the call, `add rsp, 16` undoes both.
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + pxuw_skip_msg];
        lea rcx, [rip + pxuw_k_reason];
        mov r8, 1;                       // v1 = reason
        lea r9, [rip + pxuw_k_stage];
        sub rsp, 8;                      // alignment pad
        push r14;                        // v2 = stage
        call klog_s1_d2;
        add rsp, 16;

      pxuw_done:
        add rsp, 8;                      // undo pad
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
