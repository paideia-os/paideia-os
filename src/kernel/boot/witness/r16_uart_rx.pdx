// src/kernel/boot/witness/r16_uart_rx.pdx — boot witness module
//
// Extracted verbatim from src/kernel/boot/kernel_main.pdx (which had grown
// to 24,315 lines in two functions).  R16.M4 UART RX witness block — uart_rx_init, ring, isr, IDT vector 0x24, IOAPIC IRQ 4, notify and the M4 closer.
//
// -----------------------------------------------------------------------------
// Why the body is copied and not rewritten
// -----------------------------------------------------------------------------
//
// The goldens for this tree assert an ORDERED SUBSEQUENCE of fingerprints
// across 14 boot modes, and a witness that silently stops running still
// leaves most of that subsequence intact.  The extraction therefore moves
// the instruction stream unchanged: the only bytes this module adds around
// it are the `push rbp` / `pop rbp` / `ret` below.
//
// -----------------------------------------------------------------------------
// The push is not decoration
// -----------------------------------------------------------------------------
//
// `boot_continue_after_ring3` runs its body at `rsp % 16 == 8` — it sits two `call` levels
// below `_start`, and paideia-as emits no frame prologue for an
// `unsafe`-bodied lambda (emit_visit_lambda.rs suppresses the prologue for
// Unsafe bodies, which is also why `no-frame` is a no-op there).  Several
// witnesses in this file reason explicitly about that parity — "3 pushes from %16==8
// yields (8+3*8)%16 == 0" — and a bare `call` into a bare body would enter
// at `%16 == 0` and invert every one of those arguments.  The single
// `push rbp` restores the inline parity exactly; the matching `pop rbp`
// keeps rbp's SysV guarantee for the caller.
//
// Sections in this module, in the order boot_continue_after_ring3 ran them:
//   * R16-M4-001 (#595): uart_rx_init witness — 1 sub-test
//   * R16-M4-002 (#596): uart_rx_ring witness — 4 sub-tests
//   * R16-M4-003 (#597): uart_rx_isr witness — 1 sub-test
//   * R16-M4-004 (#598): idt vector 0x24 wire — 3 sub-tests
//   * R16-M4-005 (#599): ioapic irq4 witness — 2 sub-tests
//   * R16-M4-006 (#600): uart_rx_notify witness — 3 sub-tests
//   * R16-M4-007 (#601): uart_rx_smoke witness — R16.M4 CLOSER

module R16UartRx = structure {

  // witness_r16_uart_rx() — the R16.M4 UART RX witness block — uart_rx_init, ring, isr, IDT vector 0x24, IOAPIC IRQ 4, notify and the M4 closer.
  //
  // Effect and capability rows are the ones the enclosing
  // `boot_continue_after_ring3` declares.  They are not widened here: this
  // is the same instruction stream under a new symbol, so the authority it
  // needs is by construction the authority it already had.
  pub let witness_r16_uart_rx : () -> () !{sysreg, PortIo} @{paideia.port_io} = fn () -> unsafe {
    effects: {sysreg, PortIo},
    capabilities: {boot, paideia.port_io},
    justification: "Boot witness block lifted verbatim out of kernel_main.pdx's boot_continue_after_ring3 during the r16_uart_rx extraction. Body bytes are unchanged from the inline form; the only additions are the entry `push rbp` and the exit `pop rbp; ret`. The push is load-bearing rather than cosmetic: boot_continue_after_ring3 executes its body at rsp%16 == 8 (two `call` levels below _start, with no frame prologue emitted for unsafe-bodied lambdas), and the witnesses inside this module compute their own nested-call alignment from that parity. Entering through a `call` without the compensating push would present rsp%16 == 0 to the body and silently invert every such argument — the failure mode of paideia-os #1192, #1195 and #1584. Effects and capabilities are copied unchanged from the enclosing function for the same reason: no authority is added, so none needs justifying beyond what boot_continue_after_ring3 already justified.",
    block: {
      push rbp;

      // ============================================================
      // R16-M4-001 (#595): uart_rx_init witness — 1 sub-test
      // ============================================================
      uart_rx_init_witness:
          // Sub-test A: after uart_rx_init, port 0x3F9 read returns 0x01
          call uart_rx_init;

          mov  dx, 0x3F9;
          in_al al;
          and  rax, 0xFF;                         // isolate AL (in_al leaves upper 56 bits untouched)
          cmp  rax, 1;
          jne  uart_rx_init_witness_fail;

          // All green
          mov rdi, 3;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + uart_rx_init_ok_msg];
          call klog_s1;
          jmp  uart_rx_init_witness_done;

      uart_rx_init_witness_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + uart_rx_init_fail_msg];
          call klog_s1;

      uart_rx_init_witness_done:

      // ============================================================
      // R16-M4-002 (#596): uart_rx_ring witness — 4 sub-tests
      // ============================================================
      uart_rx_ring_witness:
          push r12;                              // callee-save loop counter

          // ---------- Sub-test A: virgin ring is empty ----------
          call uart_rx_dequeue;
          cmp  rax, 0xFFFF;
          jne  uart_rx_ring_witness_fail;

          // ---------- Sub-test B: single-byte round-trip ----------
          mov  rdi, 0x41;
          call uart_rx_enqueue;
          cmp  rax, 0;
          jne  uart_rx_ring_witness_fail;
          call uart_rx_dequeue;
          cmp  rax, 0x41;
          jne  uart_rx_ring_witness_fail;

          // ---------- Sub-test C: multi-byte FIFO ("hello") ----------
          mov rdi, 0x68;
          call uart_rx_enqueue;
          cmp rax, 0;
          jne uart_rx_ring_witness_fail;
          mov rdi, 0x65;
          call uart_rx_enqueue;
          cmp rax, 0;
          jne uart_rx_ring_witness_fail;
          mov rdi, 0x6C;
          call uart_rx_enqueue;
          cmp rax, 0;
          jne uart_rx_ring_witness_fail;
          mov rdi, 0x6C;
          call uart_rx_enqueue;
          cmp rax, 0;
          jne uart_rx_ring_witness_fail;
          mov rdi, 0x6F;
          call uart_rx_enqueue;
          cmp rax, 0;
          jne uart_rx_ring_witness_fail;

          call uart_rx_dequeue;
          cmp rax, 0x68;
          jne uart_rx_ring_witness_fail;
          call uart_rx_dequeue;
          cmp rax, 0x65;
          jne uart_rx_ring_witness_fail;
          call uart_rx_dequeue;
          cmp rax, 0x6C;
          jne uart_rx_ring_witness_fail;
          call uart_rx_dequeue;
          cmp rax, 0x6C;
          jne uart_rx_ring_witness_fail;
          call uart_rx_dequeue;
          cmp rax, 0x6F;
          jne uart_rx_ring_witness_fail;

          // ---------- Sub-test D: capacity + full + drain + empty ----------
          xor r12, r12;
        urrw_fill_loop:
          mov rdi, r12;
          call uart_rx_enqueue;
          cmp rax, 0;
          jne uart_rx_ring_witness_fail;
          add r12, 1;
          cmp r12, 256;
          jb  urrw_fill_loop;

          mov rdi, 0x99;
          call uart_rx_enqueue;
          cmp rax, 1;
          jne uart_rx_ring_witness_fail;

          xor r12, r12;
        urrw_drain_loop:
          call uart_rx_dequeue;
          cmp rax, r12;
          jne uart_rx_ring_witness_fail;
          add r12, 1;
          cmp r12, 256;
          jb  urrw_drain_loop;

          call uart_rx_dequeue;
          cmp rax, 0xFFFF;
          jne uart_rx_ring_witness_fail;

          // --- All green ---
          mov rdi, 3;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + uart_rx_ring_ok_msg];
          call klog_s1;
          jmp  uart_rx_ring_witness_done;

      uart_rx_ring_witness_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + uart_rx_ring_fail_msg];
          call klog_s1;

      uart_rx_ring_witness_done:
          pop  r12;

      // ============================================================
      // R16-M4-003 (#597): uart_rx_isr witness — 1 sub-test
      // ============================================================
      uart_rx_isr_witness:
          push r12;                              // callee-save head snapshot

          // Sub-test A: with no bytes at COM1 (LSR.DR=0), calling
          // uart_rx_isr must not enqueue any bytes into the ring.
          // Snapshot _uart_rx_head; call ISR; verify head unchanged.
          mov  rax, [rip + _uart_rx_head];
          mov  r12, rax;                         // head_before survives the call

          call uart_rx_isr;                      // drains what's available (nothing) + EOI

          mov  rax, [rip + _uart_rx_head];
          cmp  rax, r12;                         // head_after must equal head_before
          jne  uart_rx_isr_witness_fail;

          // --- All green ---
          mov rdi, 3;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + uart_rx_isr_ok_msg];
          call klog_s1;
          jmp  uart_rx_isr_witness_done;

      uart_rx_isr_witness_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + uart_rx_isr_fail_msg];
          call klog_s1;

      uart_rx_isr_witness_done:
          pop  r12;

      // ============================================================
      // R16-M4-004 (#598): idt vector 0x24 wire — 3 sub-tests
      // ============================================================
      //
      // IDT entry layout (Intel SDM Vol 3A §6.14.1, 64-bit interrupt gate):
      //   Bytes 0-1:  offset_lo (u16)
      //   Bytes 2-3:  segment selector (u16, = 0x08 KERNEL_CS)
      //   Byte  4:    IST (bits 0-2) + reserved (bits 3-7); = 0 for vec 36
      //   Byte  5:    type_attr (u8): P=1 | DPL=0 | 0 | type=0xE → 0x8E
      //   Bytes 6-7:  offset_mid (u16)
      //   Bytes 8-11: offset_hi (u32)
      //   Bytes 12-15: reserved (u32, = 0)
      //
      // word0 (u64 at offset 0):
      //   bits  0-15: offset_lo
      //   bits 16-31: selector (0x08)
      //   bits 32-39: IST
      //   bits 40-47: type_attr (0x8E)
      //   bits 48-63: offset_mid
      //
      // word1 (u64 at offset 8):
      //   bits  0-31: offset_hi
      //   bits 32-63: reserved (0)

      idt_vec24_witness:
          push r12;                                 // callee-save: trampoline address survives all sub-tests
          push r13;                                 // callee-save: word0 survives sub-tests B and C

          // Load trampoline address once; used by sub-tests A and C.
          lea  r12, [rip + _isr_stub_36];

          // Compute base address of IDT entry 36 (byte offset = 36 * 16 = 576).
          lea  rax, [rip + _idt_storage];
          add  rax, 576;                            // rax = &_idt_storage[36]

          // Load word0 into r13 for sub-tests A and B.
          mov  r13, [rax];

          // --------- Sub-test A: offset_lo (word0 bits 0-15) == trampoline & 0xFFFF ---------
          mov  rcx, r13;
          mov  rdx, 0xFFFF;
          and  rcx, rdx;                            // rcx = offset_lo from packed entry
          mov  rsi, r12;
          and  rsi, rdx;                            // rsi = trampoline low16
          cmp  rcx, rsi;
          jne  idt_vec24_witness_fail;

          // --------- Sub-test B: type_attr (word0 bits 40-47) == 0x8E ---------
          mov  rcx, r13;
          shr  rcx, 40;                             // rcx = type_attr | offset_mid<<8 | ...
          mov  rdx, 0xFF;
          and  rcx, rdx;                            // rcx = type_attr byte
          cmp  rcx, 0x8E;
          jne  idt_vec24_witness_fail;

          // --------- Sub-test C: reassembled handler offset == trampoline ---------
          //   reassembled = (word0 & 0xFFFF)                       ; offset_lo
          //               | ((word0 >> 48) & 0xFFFF) << 16         ; offset_mid
          //               | (word1 & 0xFFFFFFFF) << 32             ; offset_hi

          // offset_lo → rcx (low 16 bits of reassembled)
          mov  rcx, r13;
          mov  rdx, 0xFFFF;
          and  rcx, rdx;                            // rcx = offset_lo (positions 0-15)

          // offset_mid → rdi, then shift to positions 16-31, OR into rcx
          mov  rdi, r13;
          shr  rdi, 48;                             // rdi = offset_mid (positions 0-15)
          and  rdi, rdx;                            // explicit mask (defensive)
          shl  rdi, 16;                             // rdi = offset_mid (positions 16-31)
          or   rcx, rdi;

          // offset_hi from word1 → rdi, shift to positions 32-63, OR
          mov  rdi, [rax + 8];                      // rdi = word1
          mov  rdx, 0xFFFFFFFF;
          and  rdi, rdx;                            // rdi = offset_hi (positions 0-31)
          shl  rdi, 32;                             // rdi = offset_hi (positions 32-63)
          or   rcx, rdi;

          // Compare reassembled offset against trampoline address.
          cmp  rcx, r12;
          jne  idt_vec24_witness_fail;

          // --- All green ---
          mov rdi, 3;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + idt_vec24_ok_msg];
          call klog_s1;
          jmp  idt_vec24_witness_done;

      idt_vec24_witness_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + idt_vec24_fail_msg];
          call klog_s1;

      idt_vec24_witness_done:
          pop  r13;
          pop  r12;

      // ============================================================
      // R16-M4-005 (#599): ioapic irq4 witness — 2 sub-tests
      // ============================================================
      //
      // IOAPIC internal registers 0x18 (RTE #4 LO) and 0x19 (RTE #4 HI)
      // encode the routing of ISA IRQ 4 to a CPU vector via IOREGSEL/IOWIN.
      //
      // After ioapic_irq4_init:
      //   RTE #4 LO (0x18) = 0x00000024  (vector = 0x24, mask = 0, everything else 0)
      //   RTE #4 HI (0x19) = 0x00000000  (dest APIC ID = 0 in bits 24-31)

      ioapic_irq4_witness:
          push r12;                                 // callee-save: LO value survives A→B

          // ---------- Program IRQ 4 → vec 0x24 → CPU 0 ----------
          call ioapic_irq4_init;

          // ---------- Sub-test A: RTE 4 LO ----------
          mov  rdi, 0x18;                           // RTE 4 LO register index
          call ioapic_read;                         // rax = LO value (32-bit zero-extended)
          mov  r12, rax;                            // save for A2

          // A1: vector byte (bits 0-7) == 0x24
          mov  rcx, r12;
          and  rcx, 0xFF;
          cmp  rcx, 0x24;
          jne  ioapic_irq4_witness_fail;

          // A2: mask bit (bit 16) == 0
          mov  rcx, r12;
          shr  rcx, 16;
          and  rcx, 1;
          cmp  rcx, 0;
          jne  ioapic_irq4_witness_fail;

          // ---------- Sub-test B: RTE 4 HI ----------
          mov  rdi, 0x19;                           // RTE 4 HI register index
          call ioapic_read;                         // rax = HI value (32-bit zero-extended)

          // B1: dest_apic_id byte (bits 24-31) == 0
          shr  rax, 24;
          and  rax, 0xFF;
          cmp  rax, 0;
          jne  ioapic_irq4_witness_fail;

          // --- All green ---
          mov rdi, 3;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + ioapic_irq4_ok_msg];
          call klog_s1;
          jmp  ioapic_irq4_witness_done;

      ioapic_irq4_witness_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + ioapic_irq4_fail_msg];
          call klog_s1;

      ioapic_irq4_witness_done:
          pop  r12;

      // ============================================================
      // R16-M4-006 (#600): uart_rx_notify witness — 3 sub-tests
      // ============================================================
      uart_rx_notify_witness:
          push r12;                                // callee-save: fake-TCB address
          push r13;                                // callee-save: waiter slot address

          // R18-M4-003 (#773): precondition — the runqueue must be empty
          // before Sub-test A's single-element enqueue assertion (CB.head
          // == r12).  Under pre-#773 sentinel semantics the assert was
          // `task.next != 0` (proxy for on-runq that also happened to be
          // true when other tasks were pre-present); post-#773 the sole-
          // element assert only passes if CB.head is exactly r12, which
          // demands an empty starting runq.  Earlier witnesses (notably
          // fd_inherit_witness at ~5155 via sys_fork_body) leave child
          // slabs on the runqueue without a matching runq_dequeue —
          // runq_init here scrubs CB.head/tail per its documented
          // "safe to re-call, orphans linked tasks" idempotency
          // (runqueue.pdx §runq_init).  Mirrors the pattern in
          // sys_exit_witness (line ~2114) and sys_fork_witness
          // (line ~2648).
          call runq_init;

          lea  r12, [rip + _block_witness_task_x];  // fake TCB (reuse #563 slab)
          lea  r13, [rip + _uart_rx_notify_waiter]; // waiter slot address

          // -------- Setup: zero the fake TCB (defensive, .bss = 0 at boot) --------
          xor  rcx, rcx;
          mov  [r12 + 8],   ecx;                    // state (u32) = 0 (NEW)
          mov  [r12 + 432], rcx;                    // runq_next = 0
          mov  [r12 + 440], rcx;                    // runq_prev = 0

          // -------- Sub-test A: direct wake_if_waiter proof --------
          // Set state=WAITING (2); install waiter; call wake; verify.
          mov  ecx, 2;
          mov  [r12 + 8], ecx;                      // state = WAITING

          mov  rdi, r12;
          call uart_rx_notify_set_waiter;           // slot := &TCB

          mov  rax, [r13];
          cmp  rax, r12;
          jne  urxn_witness_fail;                   // slot must equal our TCB

          call uart_rx_notify_wake_if_waiter;       // slot -> 0; sched_wake(TCB)

          // Assert: slot cleared to 0
          mov  rax, [r13];
          cmp  rax, 0;
          jne  urxn_witness_fail;

          // Assert: TCB.state == RUNNABLE (1)
          mov  ecx, [r12 + 8];
          cmp  ecx, 1;
          jne  urxn_witness_fail;

          // Assert: TCB on runq (rewired for #773): sole element on runq
          // means CB.runqueue_head (@ +32) == r12.  Pre-#773 "runq_next
          // != 0" (proxy for on-runq) fails under head/tail-pair — the
          // sole task's runq_next is 0 because it IS the tail.
          mov  rcx, 0xC0000101;
          rdmsr;
          shl  rdx, 32;
          or   rax, rdx;
          mov  rcx, [rax + 32];                     // CB.runqueue_head
          cmp  rcx, r12;
          jne  urxn_witness_fail;

          // -------- Drain between A and B: dequeue TCB, re-zero fields --------
          mov  rdi, r12;
          call runq_dequeue;                        // runq back to empty
          xor  rcx, rcx;
          mov  [r12 + 8],   ecx;                    // state = NEW (defensive)
          mov  [r12 + 432], rcx;
          mov  [r12 + 440], rcx;

          // -------- Sub-test B: ISR-tail wake propagation --------
          mov  ecx, 2;
          mov  [r12 + 8], ecx;                      // state = WAITING
          mov  rdi, r12;
          call uart_rx_notify_set_waiter;           // slot := &TCB

          call uart_rx_isr;                         // empty drain + wake_if_waiter + EOI

          // Assert: slot cleared to 0 (wake propagated through ISR tail)
          mov  rax, [r13];
          cmp  rax, 0;
          jne  urxn_witness_fail;

          // Assert: TCB.state == RUNNABLE (1)
          mov  ecx, [r12 + 8];
          cmp  ecx, 1;
          jne  urxn_witness_fail;

          // Assert: TCB on runq (rewired for #773): sole element on runq
          // means CB.runqueue_head (@ +32) == r12.  See sub-test A above
          // for the rationale (post-head/tail-pair the pre-#773 runq_next
          // proxy no longer distinguishes on/off for a sole element).
          mov  rcx, 0xC0000101;
          rdmsr;
          shl  rdx, 32;
          or   rax, rdx;
          mov  rcx, [rax + 32];                     // CB.runqueue_head
          cmp  rcx, r12;
          jne  urxn_witness_fail;

          // -------- Drain between B and C: dequeue TCB, re-zero fields --------
          mov  rdi, r12;
          call runq_dequeue;
          xor  rcx, rcx;
          mov  [r12 + 8],   ecx;
          mov  [r12 + 432], rcx;
          mov  [r12 + 440], rcx;

          // -------- Sub-test C: no-waiter fast path --------
          // Slot is now 0. wake_if_waiter must be a no-op: TCB state
          // stays 0 (NEW), TCB stays off runq, slot stays 0.
          call uart_rx_notify_wake_if_waiter;

          mov  rax, [r13];
          cmp  rax, 0;
          jne  urxn_witness_fail;

          mov  ecx, [r12 + 8];
          cmp  ecx, 0;
          jne  urxn_witness_fail;                   // state must be NEW (untouched)

          mov  rcx, [r12 + 432];
          cmp  rcx, 0;
          jne  urxn_witness_fail;                   // runq_next must be 0

          // -------- All green --------
          mov rdi, 3;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + uart_rx_notify_ok_msg];
          call klog_s1;
          jmp  urxn_witness_done;

      urxn_witness_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + uart_rx_notify_fail_msg];
          call klog_s1;

      urxn_witness_done:
          pop  r13;
          pop  r12;

      // ============================================================
      // R16-M4-007 (#601): uart_rx_smoke witness — R16.M4 CLOSER
      // Round-trips 'a','b','c' through the RX ring and emits
      // UART RX: abc as the fingerprint AC.
      // ============================================================
      uart_rx_smoke_witness:
          push r12                                 // callee-save: buffer base
          lea  r12, [rip + _uart_rx_smoke_buf]     // r12 = &buf[0]

          // ---------- Sub-test A: enqueue 'a','b','c' ----------
          mov  rdi, 0x61                           // 'a'
          call uart_rx_enqueue
          cmp  rax, 0                              // ENQUEUE_OK
          jne  uart_rx_smoke_witness_fail

          mov  rdi, 0x62                           // 'b'
          call uart_rx_enqueue
          cmp  rax, 0
          jne  uart_rx_smoke_witness_fail

          mov  rdi, 0x63                           // 'c'
          call uart_rx_enqueue
          cmp  rax, 0
          jne  uart_rx_smoke_witness_fail

          // ---------- Sub-test B: dequeue 3 bytes into buf[0..3] ----------
          call uart_rx_dequeue
          cmp  rax, 0xFF                           // upper bound of a real byte
          ja   uart_rx_smoke_witness_fail          // 0xFFFF sentinel > 0xFF → empty
          mov_b [r12 + 0], rax                     // buf[0] = dequeued byte #1

          call uart_rx_dequeue
          cmp  rax, 0xFF
          ja   uart_rx_smoke_witness_fail
          mov_b [r12 + 1], rax                     // buf[1] = dequeued byte #2

          call uart_rx_dequeue
          cmp  rax, 0xFF
          ja   uart_rx_smoke_witness_fail
          mov_b [r12 + 2], rax                     // buf[2] = dequeued byte #3

          // ---------- Sub-test C: ring must be empty now ----------
          call uart_rx_dequeue
          cmp  rax, 0xFFFF                         // DEQUEUE_EMPTY sentinel
          jne  uart_rx_smoke_witness_fail

          // ---------- Sub-test D: terminate the buffer and emit ----------
          mov  rax, 0x0A                           // '\n'
          mov_b [r12 + 3], rax
          xor  rax, rax
          mov_b [r12 + 4], rax                     // '\0' string terminator

          // --- Emit prefix ("UART RX: ") then buffer ("abc\n") ---
          // #704: prefix stays as raw uart_puts (NOT klog_s1) so it lands
          // adjacent to the buffer emission on the wire. klog_s1 would append
          // its own newline after "UART RX: ", splitting "UART RX: abc" into
          // two lines and breaking the fingerprint's contiguity check.
          lea  rdi, [rip + uart_rx_smoke_prefix_msg]; // klog-migrate: skip — #704 wire fingerprint (see comment above); paideia-as#1275
          call uart_puts;

          mov  rdi, r12                            // &_uart_rx_smoke_buf
          call uart_puts

          jmp  uart_rx_smoke_witness_done

      uart_rx_smoke_witness_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + uart_rx_smoke_fail_msg];
          call klog_s1;

      uart_rx_smoke_witness_done:
          pop  r12


      pop rbp;
      ret
    }
  }
}
