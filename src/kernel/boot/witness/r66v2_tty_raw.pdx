// src/kernel/boot/witness/r66v2_tty_raw.pdx -- R66v2.POS-002 (#1987)
//
// Boot-time witness for the KIND_TTY raw-mode round trip: mints a
// KIND_TTY sink, pushes bytes into the raw UART RX ring, flips the
// sink to raw mode via TTY_OP_SET_RAW, drains exactly those bytes
// back out via TTY_OP_READ with no kernel-side echo or line
// buffering, confirms the ring goes empty on a fourth read, restores
// TTY_OP_SET_COOKED, and revokes the row.
//
// Depends on R66v2.POS-001 (#1986), which landed TTY_OP_READ,
// TTY_OP_SET_RAW, TTY_OP_SET_COOKED and mode_flags on KIND_TTY
// (src/kernel/core/cap/kind_tty.pdx, cap_handler_tty). This module
// does not modify either of those frozen files; it only drives the
// public surface they already export -- tty_cap_mint_inner,
// cap_handler_tty, tty_row_mode, tty_cap_revoke -- exactly the shape
// tests/kernel/cap/kind_tty_synth.pdx already established for the
// R30-PREP KIND_TTY witness.
//
// Placement: called from kernel_main.pdx's boot_continue_after_ring3
// cascade immediately after witness_r16_tty. That module's own
// tty_stdin_bridge_witness sub-test (#748, R17-M5) explicitly leaves
// the raw UART RX ring drained (head == tail) as its documented post-
// condition -- exactly the empty-ring precondition this witness's
// Sub-test C (raw enqueue) needs before its own first byte lands.
//
// Cap slot 120 -- reused from tests/kernel/cap/kind_tty_synth.pdx's
// own KIND_TTY witness (called much earlier in the cascade, from
// witness_r30_platform, and scrubbed back to (0,0,0) on both its
// success and failure exits). No witness between witness_r30_platform
// and this call site touches cap_table, so slot 120 is free by
// construction at this point in boot.
//
// Fingerprint: "boot tty raw ok -- bytes=<N>" (klog_s1_d1, key
// k_bytes, core/klog/keys.pdx). Deliberately all-lowercase with no
// bracketed "[legacy: ... OK]" suffix -- unlike tag_tty_mode_ok /
// tag_tty_read_ok (kind_tty.pdx), this is a brand-new narrative-style
// tag, same posture as tag_tsc_narrative (core/time/tsc.pdx): it
// carries no standalone uppercase "OK" token, so tools/verify-
// fingerprint-coverage.sh's OK_TOK extractor does not treat it as a
// marker requiring golden coverage or an allowlist entry (see that
// file's header + tsc.pdx's own comment for the precedent). This
// keeps the emitted text exactly the issue's literal spec rather than
// folding it into the legacy-bridge convention, which would have
// inserted a bracketed clause in the middle of that exact phrase.

module R66v2TtyRaw = structure {

  pub let mut _ttyr_stage : u64 = 0

  pub let tag_boot_tty_raw_ok : [u8; 19] = "boot tty raw ok --\0"
  pub let ttyr_fail_msg       : [u8; 18] = "boot tty raw fail\0"

  // Mint a synthetic KIND_IPC_ENDPOINT parent at the given cap slot.
  // Mirrors tests/kernel/cap/kind_tty_synth.pdx's ttyw_ep: the tty
  // derivation gate (tty_check_parent_endpoint) only checks kind, so
  // any nonzero rights / target_ptr on the parent is fine. rdi (slot)
  // is untouched by the rsi/rdx/rcx setup below, so it still holds
  // the caller's argument when cap_mint_write is called.
  pub let ttyr_ep : (u64) -> () !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R66v2.POS-002 (#1987): mint a synthetic KIND_IPC_ENDPOINT parent for the tty mint gate. R_IPC_ALL (0x00B) rights; target_ptr = 0x1987 (issue number, arbitrary nonzero id). rdi (slot) is never overwritten by the rsi/rdx/rcx setup, so it survives untouched into the tail call. Labels prefixed ttyr_e_.",
      block: {
        mov rsi, 5;                      // KIND_IPC_ENDPOINT
        mov rdx, 0x00B;                  // R_IPC_ALL
        mov rcx, 0x1987;                 // target_ptr = endpoint_id
        call cap_mint_write;
        ret
      }
    }

  // Scrub cap slot 120 back to (0,0,0).
  pub let ttyr_clear_slot : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R66v2.POS-002 (#1987): scrub cap_table slot 120 (this witness's private parent-endpoint slot) back to (0,0,0). Called at entry (defensive) and on every exit. Labels prefixed ttyr_c_.",
      block: {
        mov rdi, 120;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        ret
      }
    }

  // witness_r66v2_tty_raw() -> ()
  //
  // Boot witness. Five callee-save pushes leave rsp%16 == 0 for every
  // nested call (entry rsp%16 == 8, the standard post-`call` parity
  // every sibling witness in the boot_continue_after_ring3 cascade
  // observes).
  pub let witness_r66v2_tty_raw : () -> () !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R66v2.POS-002 (#1987): boot witness proving the KIND_TTY raw-mode round trip end to end -- TTY_OP_SET_RAW, three TTY_OP_READ calls returning exactly the bytes pushed into the raw UART RX ring beforehand with no kernel-side echo/line-buffering, a fourth TTY_OP_READ observing TTY_READ_EMPTY once the ring is drained, then TTY_OP_SET_COOKED restoring prior behavior. Exercises kind_tty.pdx / cap_handler_tty's public surface only (both frozen post-#1986); mints its own KIND_TTY row via tty_cap_mint_inner and drives every op through cap_handler_tty directly (bypassing cap_table/cap_invoke for the TTY cap itself), mirroring tests/kernel/cap/kind_tty_synth.pdx's own witness shape. Five callee-save pushes (rbx, r12-r15) leave rsp%16 == 0 for every nested call. r12 holds row_id across the whole body; r13 counts successfully-read raw bytes (the fourth, EMPTY-sentinel read is deliberately not counted). On any failure, stage number is stamped into _ttyr_stage first so the failure klog line carries which sub-test tripped. Labels prefixed ttyr_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // ---------- Stage 1: reset ----------
        mov rax, 1;
        lea rcx, [rip + _ttyr_stage];
        mov [rcx], rax;
        call ttyr_clear_slot;
        mov rdi, 120;
        call ttyr_ep;

        // ---------- Stage 2: mint KIND_TTY row, R_TTY_ALL rights ----------
        mov rax, 2;
        lea rcx, [rip + _ttyr_stage];
        mov [rcx], rax;
        mov rdi, 120;                    // parent_slot
        mov rsi, 0x69A;                  // R_TTY_ALL
        mov rdx, 1987;                   // tty_id (issue number, nonzero)
        mov rcx, 24;                     // rows
        mov r8,  80;                     // cols
        call tty_cap_mint_inner;
        mov r10, 16;
        cmp rax, r10;
        jae ttyr_fail_stage;
        mov r12, rax;                    // r12 = row_id, survives to the end

        // ---------- Stage 3: push "ABC" into the raw UART RX ring ----------
        // Precondition: witness_r16_tty's tty_stdin_bridge_witness
        // (#748) leaves the ring drained (head == tail) -- see this
        // file's own header comment and that witness's own post-
        // condition note (src/kernel/boot/witness/r16_tty.pdx).
        mov rax, 3;
        lea rcx, [rip + _ttyr_stage];
        mov [rcx], rax;
        mov rdi, 0x41;                   // 'A'
        call uart_rx_enqueue;
        cmp rax, 0;
        jne ttyr_fail_stage;
        mov rdi, 0x42;                   // 'B'
        call uart_rx_enqueue;
        cmp rax, 0;
        jne ttyr_fail_stage;
        mov rdi, 0x43;                   // 'C'
        call uart_rx_enqueue;
        cmp rax, 0;
        jne ttyr_fail_stage;

        // ---------- Stage 4: TTY_OP_SET_RAW ----------
        mov rax, 4;
        lea rcx, [rip + _ttyr_stage];
        mov [rcx], rax;
        mov rdi, 0x69A;                  // rights = R_TTY_ALL
        mov rsi, r12;                    // target_ptr = row_id
        mov rdx, 7;                      // TTY_OP_SET_RAW
        call cap_handler_tty;
        cmp rax, 0;
        jne ttyr_fail_stage;
        mov rdi, r12;
        call tty_row_mode;
        cmp rax, 1;                      // mode_flags bit0 == 1 (raw)
        jne ttyr_fail_stage;

        // ---------- Stage 5..7: TTY_OP_READ x3, in order, byte-exact ----------
        xor r13, r13;                    // r13 = read_bytes counter

        mov rax, 5;
        lea rcx, [rip + _ttyr_stage];
        mov [rcx], rax;
        mov rdi, 0x69A;
        mov rsi, r12;
        mov rdx, 6;                      // TTY_OP_READ
        call cap_handler_tty;
        cmp rax, 0x41;                   // 'A'
        jne ttyr_fail_stage;
        add r13, 1;

        mov rax, 6;
        lea rcx, [rip + _ttyr_stage];
        mov [rcx], rax;
        mov rdi, 0x69A;
        mov rsi, r12;
        mov rdx, 6;
        call cap_handler_tty;
        cmp rax, 0x42;                   // 'B'
        jne ttyr_fail_stage;
        add r13, 1;

        mov rax, 7;
        lea rcx, [rip + _ttyr_stage];
        mov [rcx], rax;
        mov rdi, 0x69A;
        mov rsi, r12;
        mov rdx, 6;
        call cap_handler_tty;
        cmp rax, 0x43;                   // 'C'
        jne ttyr_fail_stage;
        add r13, 1;

        // ---------- Stage 8: ring now empty; TTY_OP_READ -> TTY_READ_EMPTY ----------
        mov rax, 8;
        lea rcx, [rip + _ttyr_stage];
        mov [rcx], rax;
        mov rdi, 0x69A;
        mov rsi, r12;
        mov rdx, 6;                      // TTY_OP_READ
        call cap_handler_tty;
        mov r10, 0xFFFFEC35;             // TTY_READ_EMPTY
        cmp rax, r10;
        jne ttyr_fail_stage;             // NOT counted into r13

        // ---------- Stage 9: TTY_OP_SET_COOKED ----------
        mov rax, 9;
        lea rcx, [rip + _ttyr_stage];
        mov [rcx], rax;
        mov rdi, 0x69A;
        mov rsi, r12;
        mov rdx, 8;                      // TTY_OP_SET_COOKED
        call cap_handler_tty;
        cmp rax, 0;
        jne ttyr_fail_stage;
        mov rdi, r12;
        call tty_row_mode;
        cmp rax, 0;                      // mode_flags bit0 == 0 (cooked)
        jne ttyr_fail_stage;

        // ---------- All green: emit "boot tty raw ok -- bytes=3" ----------
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_boot_tty_raw_ok];
        lea rcx, [rip + k_bytes];
        mov r8, r13;
        call klog_s1_d1;

        // ---------- Stage 10: revoke + teardown ----------
        mov rax, 10;
        lea rcx, [rip + _ttyr_stage];
        mov [rcx], rax;
        mov rdi, r12;
        call tty_cap_revoke;
        cmp rax, 0;
        jne ttyr_fail_stage;

        call ttyr_clear_slot;
        jmp ttyr_witness_done;

      ttyr_fail_stage:
        mov rdi, 1;                      // LEVEL_ERROR
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + ttyr_fail_msg];
        lea rcx, [rip + k_line];
        lea rax, [rip + _ttyr_stage];
        mov r8, [rax];
        call klog_s1_d1;
        call ttyr_clear_slot;

      ttyr_witness_done:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
