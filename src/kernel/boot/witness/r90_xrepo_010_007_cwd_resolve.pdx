// src/kernel/boot/witness/r90_xrepo_010_007_cwd_resolve.pdx --
// R90-XREPO.010.M1-007 (paideia-os #2115).
//
// Boot-time witness proving the sys_cwd_resolve (sysno 517) body end-to-
// end from a ring-0 caller.  Three scenarios, all against init's TCB
// with TASK_OFF_CWD == VNODE_IDX_ROOT (1) -- the task_new default,
// stamped for init by task_new's step 6.5d (core/sched/task_pool.pdx
// L305-338, "TASK_OFF_CWD -- WHY THE STAMP IS THE LITERAL CONSTANT 1"):
//
//   Scenario A: "."      -> "/"    len=1
//     Relative path, resolves to cwd (root) via path_resolve's `.` fast-
//     path at path.pdx L207-214.  Composed absolute is the bare root.
//
//   Scenario B: "./tmp"  -> "/tmp" len=4
//     Relative path, walks past "./" (`.` fast-path) then vops_lookup's
//     "tmp" against the tmpfs root.  /tmp is seeded early in the boot
//     cascade by witness_r16_tmpfs (kernel_main.pdx L941), so the
//     lookup succeeds.  The parent-chain walk from /tmp back to root
//     yields depth=1, composition yields "/tmp".
//
//   Scenario C: "../"    -> "/"    len=1
//     Relative path, ".." from root stays at root (path_resolve L228-235:
//     when parent_idx == VNODE_IDX_NONE the walker jumps back to
//     component_loop without mutating cur).  Same composed output as
//     scenario A.
//
// The body is invoked DIRECTLY (bypassing dispatch_cwd_resolve's KPTI
// bounce) with .rodata path strings + a witness-owned .bss output
// scratch, matching the sys_pdxfs_undo_write / sys_pdxfs_fault_inject
// witness precedent one milestone up (r90_xrepo_010_004 / r90_xrepo_
// 010_005).  Because sys_cwd_resolve_body was deliberately built to take
// KERNEL VAs (dispatch shim owns the user-VA walk), this ring-0 exercise
// avoids the r86_relative_path_witness "no user aspace at boot" caveat
// that made THAT witness dormant.
//
// FINGERPRINTS: four total per successful boot from this witness:
//   `sys cwd resolve ok [legacy: SYS CWD RESOLVE OK] len=1`  (stage 2/A)
//   `sys cwd resolve ok [legacy: SYS CWD RESOLVE OK] len=4`  (stage 3/B)
//   `sys cwd resolve ok [legacy: SYS CWD RESOLVE OK] len=1`  (stage 4/C)
//   `boot cwd resolve ok -- count=3`                          (this
//                                                              witness's
//                                                              own rollup)
//
// Failure funnel emits `boot cwd resolve skip -- reason=1 stage=S`
// via klog_s1_d2 with stage in [1..4] naming the failure point.  reason
// is currently monotone (1); future ranges can grow it if new failure
// classes arise.
//
// PLACEMENT (kernel_main.pdx): after r86_relative_path_witness (last in
// the R86 substrate block) and before r64v2_tools_witness, so the whole
// R86/R90 relative-path family sits contiguously.  Depends on
// witness_r16_tmpfs (line 941, seeds /tmp), witness_bin_seeds (line
// 1175, seeds /bin), and witness_r17_init_sched (line 1171, which
// eventually causes _current_tcb to point at init with TASK_OFF_CWD ==
// VNODE_IDX_ROOT) -- all satisfied by the placement.
//
// LEGACY OK TOKEN: `sys cwd resolve ok` carries a standalone uppercase
// "OK" token in its bracketed legacy-alias suffix and so requires an
// allowlist entry in tools/verify-fingerprint-coverage.sh (landed
// alongside this witness).  The rollup `boot cwd resolve ok --` is all-
// lowercase and bypasses the OK-token gate entirely (same posture as
// tag_boot_pdxfs_fault_inject_ok / tag_boot_pdxfs_undo_ok above).
//
// Reserved-label discipline: labels prefixed `wcr_` (Witness Cwd
// Resolve).  Prefix chosen distinct from the pdxfs cow_read module's
// `pxcr_*` function namespace (core/fs/pdxfs/cow_read.pdx) to avoid
// any cross-module symbol collision at link time.  `loop`, `if` etc.
// are keywords and never used as labels.
//
// Frame prologue: manual push/pop (same as every other witness_*.pdx).

module R90XrepoCwdResolve = structure {

  // ==========================================================================
  // Static test vectors -- three NUL-terminated ASCII paths and their
  // expected canonical resolutions.  Sized u8; N includes the NUL.
  // ==========================================================================
  pub let wcr_path_dot     : [u8; 2] = ".\0"
  pub let wcr_path_dot_tmp : [u8; 6] = "./tmp\0"
  pub let wcr_path_dotdot  : [u8; 4] = "../\0"

  pub let wcr_expect_root  : [u8; 2] = "/\0"
  pub let wcr_expect_tmp   : [u8; 5] = "/tmp\0"

  // Witness-owned output buffer.  Sized PATH_MAX (matches every other
  // per-syscall path scratch); the body writes content bytes + trailing
  // NUL into this and returns strlen (excl. NUL).
  pub let mut _wcr_out_scratch : [u8; 256] = uninit @align(8)

  // Skip-path fingerprint tag.  Locally scoped -- no other witness needs
  // it, and the text carries no standalone uppercase OK token so
  // verify-fingerprint-coverage.sh's OK_TOK extractor does not gate on
  // it.  Byte count NUL-inclusive per #699 discipline: "boot cwd
  // resolve skip " = 22 chars + NUL = 23.
  pub let wcr_skip_msg : [u8; 23] = "boot cwd resolve skip \0"
  pub let wcr_k_reason : [u8;  7] = "reason\0"
  pub let wcr_k_stage  : [u8;  6] = "stage\0"

  // ==========================================================================
  // wcr_check_bytes(scratch_ptr, expected_ptr, len) -> u64
  //
  // Compare `len` bytes at scratch_ptr against expected_ptr byte-for-
  // byte.  Returns 0 on mismatch, 1 on match.  Leaf helper -- no nested
  // call, callee-save clean (rax/rcx/rdx/r8/r9 caller-save only).  Used
  // by the witness main body to compare the composed output content
  // against the static expected strings.
  //
  // Why not memcmp: no memcmp helper exists at this layer, and the
  // three-byte-max comparisons the witness does don't earn a shared
  // helper.
  // ==========================================================================
  pub let wcr_check_bytes : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (scratch_ptr: u64) (expected_ptr: u64) (len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R90-XREPO.010.M1-007 (#2115) boot witness helper: compare `len` bytes at scratch_ptr against expected_ptr. Leaf, no nested call, callee-save clean. Returns 1 if every byte matches, 0 on the first mismatch (or immediately if len == 0, which the witness never passes -- defensive). Every mov_b load is preceded by `xor rax, rax` / `xor r8, r8` (mov_b does not zero-extend on its own -- same discipline as path.pdx's copy_char loop). Encoder-conservative: cmp/je/jne/jae/mov/mov_b/xor/add/ret only. Labels prefixed wcr_cb_.",
      block: {
        xor rcx, rcx;                    // rcx = byte index
      wcr_cb_top:
        cmp rcx, rdx;                    // rcx == len?
        jae wcr_cb_match;
        xor rax, rax;
        mov_b rax, [rdi + rcx*1];        // scratch[i]
        xor r8, r8;
        mov_b r8, [rsi + rcx*1];         // expected[i]
        cmp rax, r8;
        jne wcr_cb_mismatch;
        add rcx, 1;
        jmp wcr_cb_top;
      wcr_cb_match:
        mov rax, 1;
        ret;
      wcr_cb_mismatch:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // witness_r90_xrepo_010_007_cwd_resolve() -> ()
  //
  // Register plan (5 callee-save pushes + `sub rsp, 8` pad = 48 bytes
  // -> rsp%16 == 0 for every nested call from entry rsp%16 == 8 SysV):
  //   rbx = unused (pushed for symmetry with sibling r90-xrepo witnesses)
  //   r12 = unused (pushed for symmetry)
  //   r13 = unused (pushed for symmetry)
  //   r14 = current stage code (1..4) for the skip funnel
  //   r15 = unused (pushed for symmetry)
  //
  // Five pushes on entry rsp%16==8 land rsp%16==8 (5*8 mod 16 = 8),
  // the `sub rsp, 8` pad brings it to 0.  Matches the sibling
  // r90_xrepo_010_005_pdxfs_fault_inject witness's 5-push discipline.
  // ==========================================================================
  pub let witness_r90_xrepo_010_007_cwd_resolve : () -> () !{mem, sysreg} @{boot} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot},
      justification: "R90-XREPO.010.M1-007 (paideia-os #2115): boot witness for sys_cwd_resolve (sysno 517). Five callee-save pushes + `sub rsp, 8` pad leaves rsp%16 == 0 for every nested call from entry rsp%16 == 8 SysV. Bypasses the dispatch shim (boot context, no ring-3 user aspace to walk against) and calls sys_cwd_resolve_body directly with .rodata path strings + a witness-owned .bss output scratch, matching the sys_pdxfs_undo_write / sys_pdxfs_fault_inject boot witness precedent one milestone up. Three scenarios in one boot: (A) '.' -> '/' len=1 exercises path_resolve's `.` fast-path from cwd=root; (B) './tmp' -> '/tmp' len=4 exercises the `.` fast-path + vops_lookup + the parent-chain walk composing one component back to root; (C) '../' -> '/' len=1 exercises `..` from root staying at root (path_resolve L228-235 when parent_idx == VNODE_IDX_NONE). Each stage asserts (rax == expected_len) AND (memcmp against the expected static string succeeds), so a lookup that returns the wrong vnode OR a composition that produces the wrong bytes both trip the skip funnel. Depends on witness_r16_tmpfs having seeded /tmp (kernel_main.pdx L941) and on _current_tcb pointing at init with TASK_OFF_CWD == VNODE_IDX_ROOT (both true at the placement point in kernel_main.pdx, after L1585 sets _current_tcb = init and task_new stamped init's cwd at construction time). Effects/capabilities: {mem,sysreg}@{boot} matches every substrate-mutating witness (mem for the .bss output writes, sysreg for the fingerprint's klog_s1_d1 TSC read, boot for the boot-witness capability marker). Encoder-conservative: cmp/je/jne/mov/lea/xor/push/pop/call/sub/add/ret only -- every form already proven at this exact shape in the sibling r90_xrepo_010_005 witness. Labels prefixed wcr_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;                      // align rsp%16 == 0 for nested calls

        mov r14, 1;                      // stage counter

        // ==================================================================
        // (2) Scenario A: sys_cwd_resolve_body(".") -> "/" len=1
        // ==================================================================
        mov r14, 2;
        lea rdi, [rip + wcr_path_dot];
        lea rsi, [rip + _wcr_out_scratch];
        mov rdx, 256;                    // abs_out_cap
        call sys_cwd_resolve_body;
        cmp rax, 1;                      // strlen must == 1
        jne wcr_skip;

        // Compare _wcr_out_scratch[0..1] against "/"
        lea rdi, [rip + _wcr_out_scratch];
        lea rsi, [rip + wcr_expect_root];
        mov rdx, 1;
        call wcr_check_bytes;
        cmp rax, 1;
        jne wcr_skip;

        // ==================================================================
        // (3) Scenario B: sys_cwd_resolve_body("./tmp") -> "/tmp" len=4
        // ==================================================================
        mov r14, 3;
        lea rdi, [rip + wcr_path_dot_tmp];
        lea rsi, [rip + _wcr_out_scratch];
        mov rdx, 256;
        call sys_cwd_resolve_body;
        cmp rax, 4;                      // strlen must == 4
        jne wcr_skip;

        // Compare _wcr_out_scratch[0..4] against "/tmp"
        lea rdi, [rip + _wcr_out_scratch];
        lea rsi, [rip + wcr_expect_tmp];
        mov rdx, 4;
        call wcr_check_bytes;
        cmp rax, 1;
        jne wcr_skip;

        // ==================================================================
        // (4) Scenario C: sys_cwd_resolve_body("../") -> "/" len=1
        // ==================================================================
        mov r14, 4;
        lea rdi, [rip + wcr_path_dotdot];
        lea rsi, [rip + _wcr_out_scratch];
        mov rdx, 256;
        call sys_cwd_resolve_body;
        cmp rax, 1;                      // strlen must == 1
        jne wcr_skip;

        lea rdi, [rip + _wcr_out_scratch];
        lea rsi, [rip + wcr_expect_root];
        mov rdx, 1;
        call wcr_check_bytes;
        cmp rax, 1;
        jne wcr_skip;

        // ==================================================================
        // (5) Emit rollup fingerprint.  `boot cwd resolve ok -- count=3`
        // ==================================================================
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_boot_cwd_resolve_ok];
        lea rcx, [rip + k_count];
        mov r8, 3;                       // count = 3 scenarios exercised
        call klog_s1_d1;
        jmp wcr_done;

      wcr_skip:
        // Skip funnel.  reason=1 today (single failure class); stage=<r14>
        // names which stage tripped.  Emits `boot cwd resolve skip --
        // reason=1 stage=<S>` via klog_s1_d2.  klog_s1_d2's v2 (7th
        // arg) is stack-passed: `sub rsp, 8` aligns %16 -> 8, then
        // `push r14` -> %16 == 0 for the call, `add rsp, 16` undoes both.
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + wcr_skip_msg];
        lea rcx, [rip + wcr_k_reason];
        mov r8, 1;                       // v1 = reason
        lea r9, [rip + wcr_k_stage];
        sub rsp, 8;                      // alignment pad
        push r14;                        // v2 = stage
        call klog_s1_d2;
        add rsp, 16;

      wcr_done:
        add rsp, 8;                      // undo pad
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
