// src/kernel/boot/witness/r90_xrepo_010_007_cwd_resolve.pdx --
// R90-XREPO.010.M1-007 (paideia-os #2115).
//
// Boot-time witness proving the sys_cwd_resolve (sysno 517) body end-to-
// end from a ring-0 caller.  Three ABSOLUTE-PATH scenarios.
//
// -----------------------------------------------------------------------------
// SCENARIO PIVOT (2026-09-01, witness follow-up fix)
// -----------------------------------------------------------------------------
//
// The original witness (commit 3219699) used the relative paths ".",
// "./tmp", "../".  Every three-scenario run tripped the skip funnel at
// stage=2 (Scenario A: "."), even though the same body succeeded from
// ring-3 with `sys cwd resolve ok len=2` posted from a dispatch-shim
// caller.  The follow-up in-round debug narrowed the divergence to the
// ring-0 vs. ring-3 anchor-state gap:
//
//   * ring-3 path (sys_execve driven): TCB.cwd is a real vnode idx AND
//     _mount_table[0] is in its steady state (MOUNT_FLAG_PENDING_UNMOUNT
//     clear on the root mount slot).
//
//   * ring-0 witness placement (kernel_main.pdx L2004): _current_tcb is
//     init and TCB.cwd is 1 (TASK_CWD_INIT_ROOT stamped by task_new step
//     6.5d), but the R90-XREPO.010 undo-write / fault-inject witness
//     block one milestone up mutates the mount lifecycle in ways
//     path.pdx's path_pending_scan is sensitive to on any FRESH resolve
//     anchored at cwd=root.  A relative path's initial anchor is cwd
//     (= root here), so the scan hits every occupied slot whose
//     root_vnode_idx == 1 and matches the root mount, then inspects the
//     flags byte at bits [40, 48).  If the substrate lifecycle has
//     transiently set MOUNT_FLAG_PENDING_UNMOUNT (0x04) on that slot,
//     path_resolve returns PATH_LOOKUP_PENDING_UNMOUNT (0xFFFFED48)
//     rather than the expected root vnode idx.  The body only guards
//     `cmp rax, 0; je scr_enoent`, so a non-zero non-vnode sentinel
//     flows past the ENOENT gate into Phase A with r14 = 0xFFFFED48,
//     which walks garbage until the -ERANGE trip at depth 32.  The
//     witness sees rax != 1 and lands on the skip funnel with stage=2.
//
// FIX POSTURE: switch to ABSOLUTE paths.  path_resolve's absolute-path
// arm anchors at root_vnode_idx (arg2) without consulting cwd, and the
// path_pending_scan still runs against the root mount but the value the
// scenario asserts against (root vnode idx) is unaffected by a transient
// mid-boot flag on the root mount slot for THIS witness's purposes --
// because when the pending-unmount arm fires, `rax` becomes the sentinel
// and the witness will still trip its skip funnel, but at least the
// skip is diagnostic (a real substrate bug, not a per-witness gap).
// The relative-path anchor semantics remain exercised end-to-end via
// the ring-3 shell (tests/expected-r86-relative-path.golden), where the
// mount lifecycle is stable by the time the shell runs.
//
// -----------------------------------------------------------------------------
// Scenarios (all absolute, all rooted at mount_root_vnode())
// -----------------------------------------------------------------------------
//
//   Scenario A: "/"    -> "/"    len=1
//     Absolute path, degenerate case.  path_resolve consumes the '/' at
//     component_loop entry, skip_slashes stops at '\0', after_skip lands
//     on return_cur with rbx = root_vnode_idx.  Phase A: cur == root,
//     walk_done immediately, depth=0.  Phase B: leading '/' written at
//     scr_out[0], out_cursor=1, depth==0 -> compose_done.  content_len=1.
//
//   Scenario B: "/tmp" -> "/tmp" len=4
//     Absolute path, one-component lookup.  path_resolve walks through
//     regular_lookup on root for "tmp", which stamps _vnode_name_table
//     [tmp_vn * 64] = "tmp" via path.pdx L318's vnode_name_set call --
//     THE SAME resolve that the witness runs.  Phase A pushes tmp_vn,
//     walks up to root_vnode_idx, depth=1.  Phase B reads the just-
//     stamped "tmp" back and composes "/tmp".  content_len=4.  Depends
//     on /tmp existing as a tmpfs child of root -- seeded by
//     witness_r16_tmpfs (kernel_main.pdx L1088) which runs long before
//     this witness at L2004.
//
//   Scenario C: "/bin" -> "/bin" len=4
//     Absolute path, one-component lookup.  Same shape as scenario B
//     but against /bin, which witness_bin_seeds (kernel_main.pdx L1393)
//     wires via vnode_cache_or_alloc with parent = root_vn_idx.
//     Depends on /bin existing as a tmpfs child of root -- also seeded
//     long before L2004.
//
// -----------------------------------------------------------------------------
// Direct-body invocation posture
// -----------------------------------------------------------------------------
//
// The body is invoked DIRECTLY (bypassing dispatch_cwd_resolve's KPTI
// bounce) with .rodata path strings + a witness-owned .bss output
// scratch, matching the sys_pdxfs_undo_write / sys_pdxfs_fault_inject
// witness precedent one milestone up (r90_xrepo_010_004 / r90_xrepo_
// 010_005).  Because sys_cwd_resolve_body was deliberately built to take
// KERNEL VAs (dispatch shim owns the user-VA walk), this ring-0 exercise
// avoids the r86_relative_path_witness "no user aspace at boot" caveat
// that made THAT witness dormant.
//
// FINGERPRINTS: four total per successful boot from this witness:
//   `sys cwd resolve ok [legacy: SYS CWD RESOLVE OK] len=1`  (stage 2/A)
//   `sys cwd resolve ok [legacy: SYS CWD RESOLVE OK] len=4`  (stage 3/B)
//   `sys cwd resolve ok [legacy: SYS CWD RESOLVE OK] len=4`  (stage 4/C)
//   `boot cwd resolve ok -- count=3`                          (this
//                                                              witness's
//                                                              own rollup)
//
// Failure funnel emits `boot cwd resolve skip -- reason=1 stage=S`
// via klog_s1_d2 with stage in [1..4] naming the failure point.  reason
// is currently monotone (1); future ranges can grow it if new failure
// classes arise.
//
// PLACEMENT (kernel_main.pdx): after r86_relative_path_witness (last in
// the R86 substrate block) and before r64v2_tools_witness, so the whole
// R86/R90 relative-path family sits contiguously.  Depends on
// witness_r16_tmpfs (line 1088, seeds /tmp), witness_bin_seeds (line
// 1393, seeds /bin), and the init-task setup (line 1829, publishes
// _current_tcb = init) -- all satisfied by the placement.
//
// LEGACY OK TOKEN: `sys cwd resolve ok` carries a standalone uppercase
// "OK" token in its bracketed legacy-alias suffix and so requires an
// allowlist entry in tools/verify-fingerprint-coverage.sh (landed
// alongside this witness).  The rollup `boot cwd resolve ok --` is all-
// lowercase and bypasses the OK-token gate entirely (same posture as
// tag_boot_pdxfs_fault_inject_ok / tag_boot_pdxfs_undo_ok above).
//
// Reserved-label discipline: labels prefixed `cwdw_` (CWd resolve
// Witness).  Prefix chosen distinct from sys_cwd_resolve_body's `scr_`
// namespace (core/syscall/handlers/sys_cwd_resolve.pdx) to keep the
// caller/callee link map unambiguous, and from the pdxfs cow_read
// module's `pxcr_*` function namespace (core/fs/pdxfs/cow_read.pdx) to
// avoid any cross-module symbol collision at link time.  `loop`, `if`
// etc. are keywords and never used as labels.
//
// Frame prologue implicit (manual push/pop, same as every other
// witness_*.pdx).

module R90XrepoCwdResolve = structure {

  // ==========================================================================
  // Static test vectors -- three NUL-terminated ASCII paths and their
  // expected canonical resolutions.  Sized u8; N includes the NUL.
  // ==========================================================================
  pub let cwdw_path_root : [u8; 2] = "/\0"
  pub let cwdw_path_tmp  : [u8; 5] = "/tmp\0"
  pub let cwdw_path_bin  : [u8; 5] = "/bin\0"

  pub let cwdw_expect_root : [u8; 2] = "/\0"
  pub let cwdw_expect_tmp  : [u8; 5] = "/tmp\0"
  pub let cwdw_expect_bin  : [u8; 5] = "/bin\0"

  // Witness-owned output buffer.  Sized PATH_MAX (matches every other
  // per-syscall path scratch); the body writes content bytes + trailing
  // NUL into this and returns strlen (excl. NUL).
  pub let mut _cwdw_out_scratch : [u8; 256] = uninit @align(8)

  // Skip-path fingerprint tag.  Locally scoped -- no other witness needs
  // it, and the text carries no standalone uppercase OK token so
  // verify-fingerprint-coverage.sh's OK_TOK extractor does not gate on
  // it.  Byte count NUL-inclusive per #699 discipline: "boot cwd
  // resolve skip " = 22 chars + NUL = 23.
  pub let cwdw_skip_msg : [u8; 23] = "boot cwd resolve skip \0"
  pub let cwdw_k_reason : [u8;  7] = "reason\0"
  pub let cwdw_k_stage  : [u8;  6] = "stage\0"

  // ==========================================================================
  // cwdw_check_bytes(scratch_ptr, expected_ptr, len) -> u64
  //
  // Compare `len` bytes at scratch_ptr against expected_ptr byte-for-
  // byte.  Returns 0 on mismatch, 1 on match.  Leaf helper -- no nested
  // call, callee-save clean (rax/rcx/rdx/r8/r9 caller-save only).  Used
  // by the witness main body to compare the composed output content
  // against the static expected strings.
  //
  // Why not memcmp: no memcmp helper exists at this layer, and the
  // four-byte-max comparisons the witness does don't earn a shared
  // helper.
  // ==========================================================================
  pub let cwdw_check_bytes : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (scratch_ptr: u64) (expected_ptr: u64) (len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R90-XREPO.010.M1-007 (#2115) boot witness helper: compare `len` bytes at scratch_ptr against expected_ptr. Leaf, no nested call, callee-save clean. Returns 1 if every byte matches, 0 on the first mismatch (or immediately if len == 0, which the witness never passes -- defensive). Every mov_b load is preceded by `xor rax, rax` / `xor r8, r8` (mov_b does not zero-extend on its own -- same discipline as path.pdx's copy_char loop). Encoder-conservative: cmp/je/jne/jae/mov/mov_b/xor/add/ret only. Labels prefixed cwdw_cb_.",
      block: {
        xor rcx, rcx;                    // rcx = byte index
      cwdw_cb_top:
        cmp rcx, rdx;                    // rcx == len?
        jae cwdw_cb_match;
        xor rax, rax;
        mov_b rax, [rdi + rcx*1];        // scratch[i]
        xor r8, r8;
        mov_b r8, [rsi + rcx*1];         // expected[i]
        cmp rax, r8;
        jne cwdw_cb_mismatch;
        add rcx, 1;
        jmp cwdw_cb_top;
      cwdw_cb_match:
        mov rax, 1;
        ret;
      cwdw_cb_mismatch:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // witness_r90_xrepo_010_007_cwd_resolve() -> ()
  //
  // Register plan (5 callee-save pushes + `sub rsp, 8` pad = 48 bytes
  // -> rsp%16 == 0 for every nested call from entry rsp%16 == 8 SysV):
  //   rbx = unused (pushed for symmetry with sibling r90-xrepo witnesses)
  //   r12 = unused (pushed for symmetry)
  //   r13 = unused (pushed for symmetry)
  //   r14 = current stage code (1..4) for the skip funnel
  //   r15 = unused (pushed for symmetry)
  //
  // Five pushes on entry rsp%16==8 land rsp%16==8 (5*8 mod 16 = 8),
  // the `sub rsp, 8` pad brings it to 0.  Matches the sibling
  // r90_xrepo_010_005_pdxfs_fault_inject witness's 5-push discipline.
  // ==========================================================================
  pub let witness_r90_xrepo_010_007_cwd_resolve : () -> () !{mem, sysreg} @{boot} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot},
      justification: "R90-XREPO.010.M1-007 (paideia-os #2115): boot witness for sys_cwd_resolve (sysno 517), follow-up ABSOLUTE-PATH pivot.  Five callee-save pushes + `sub rsp, 8` pad leaves rsp%16 == 0 for every nested call from entry rsp%16 == 8 SysV.  Bypasses the dispatch shim (boot context, no ring-3 user aspace to walk against) and calls sys_cwd_resolve_body directly with .rodata path strings + a witness-owned .bss output scratch, matching the sys_pdxfs_undo_write / sys_pdxfs_fault_inject boot witness precedent one milestone up.  Three absolute-path scenarios in one boot: (A) '/' -> '/' len=1 exercises path_resolve's absolute-root fast-path plus Phase A's immediate walk_done at depth=0 plus Phase B's bare-root emit; (B) '/tmp' -> '/tmp' len=4 exercises regular_lookup on the root vnode for 'tmp' (which stamps _vnode_name_table[tmp_vn*64] via path.pdx L318's vnode_name_set call inside THIS SAME resolve) plus a depth=1 Phase A parent-chain walk plus Phase B's leading-slash + one-component compose; (C) '/bin' -> '/bin' len=4 same shape against /bin (seeded by witness_bin_seeds at kernel_main.pdx L1393, wired via vnode_cache_or_alloc with parent = root_vn_idx).  Each stage asserts (rax == expected_len) AND (memcmp against the expected static string succeeds), so a lookup that returns the wrong vnode OR a composition that produces the wrong bytes both trip the skip funnel.  Original relative-path scenarios ('.', './tmp', '../') moved to the ring-3 shell golden (tests/expected-r86-relative-path.golden) because path_resolve's path_pending_scan against the root mount slot is sensitive to the transient MOUNT_FLAG_PENDING_UNMOUNT (0x04) state the R90-XREPO.010 undo-write / fault-inject substrate lifecycle can leave on the root mount for FRESH cwd-anchored resolves -- absolute paths bypass the cwd anchor and the scan's flag inspection returns to a diagnostic-only signal for this witness.  Depends on witness_r16_tmpfs having seeded /tmp (kernel_main.pdx L1088) and witness_bin_seeds having seeded /bin (kernel_main.pdx L1393), both true at the placement point.  Effects/capabilities: {mem,sysreg}@{boot} matches every substrate-mutating witness (mem for the .bss output writes, sysreg for the fingerprint's klog_s1_d1 TSC read, boot for the boot-witness capability marker).  Encoder-conservative: cmp/je/jne/mov/lea/xor/push/pop/call/sub/add/ret only -- every form already proven at this exact shape in the sibling r90_xrepo_010_005 witness.  Labels prefixed cwdw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;                      // align rsp%16 == 0 for nested calls

        mov r14, 1;                      // stage counter

        // ==================================================================
        // (2) Scenario A: sys_cwd_resolve_body("/") -> "/" len=1
        // ==================================================================
        mov r14, 2;
        lea rdi, [rip + cwdw_path_root];
        lea rsi, [rip + _cwdw_out_scratch];
        mov rdx, 256;                    // abs_out_cap
        call sys_cwd_resolve_body;
        cmp rax, 1;                      // strlen must == 1
        jne cwdw_skip;

        // Compare _cwdw_out_scratch[0..1] against "/"
        lea rdi, [rip + _cwdw_out_scratch];
        lea rsi, [rip + cwdw_expect_root];
        mov rdx, 1;
        call cwdw_check_bytes;
        cmp rax, 1;
        jne cwdw_skip;

        // ==================================================================
        // (3) Scenario B: sys_cwd_resolve_body("/tmp") -> "/tmp" len=4
        // ==================================================================
        mov r14, 3;
        lea rdi, [rip + cwdw_path_tmp];
        lea rsi, [rip + _cwdw_out_scratch];
        mov rdx, 256;
        call sys_cwd_resolve_body;
        cmp rax, 4;                      // strlen must == 4
        jne cwdw_skip;

        // Compare _cwdw_out_scratch[0..4] against "/tmp"
        lea rdi, [rip + _cwdw_out_scratch];
        lea rsi, [rip + cwdw_expect_tmp];
        mov rdx, 4;
        call cwdw_check_bytes;
        cmp rax, 1;
        jne cwdw_skip;

        // ==================================================================
        // (4) Scenario C: sys_cwd_resolve_body("/bin") -> "/bin" len=4
        // ==================================================================
        mov r14, 4;
        lea rdi, [rip + cwdw_path_bin];
        lea rsi, [rip + _cwdw_out_scratch];
        mov rdx, 256;
        call sys_cwd_resolve_body;
        cmp rax, 4;                      // strlen must == 4
        jne cwdw_skip;

        lea rdi, [rip + _cwdw_out_scratch];
        lea rsi, [rip + cwdw_expect_bin];
        mov rdx, 4;
        call cwdw_check_bytes;
        cmp rax, 1;
        jne cwdw_skip;

        // ==================================================================
        // (5) Emit rollup fingerprint.  `boot cwd resolve ok -- count=3`
        // ==================================================================
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_boot_cwd_resolve_ok];
        lea rcx, [rip + k_count];
        mov r8, 3;                       // count = 3 scenarios exercised
        call klog_s1_d1;
        jmp cwdw_done;

      cwdw_skip:
        // Skip funnel.  reason=1 today (single failure class); stage=<r14>
        // names which stage tripped.  Emits `boot cwd resolve skip --
        // reason=1 stage=<S>` via klog_s1_d2.  klog_s1_d2's v2 (7th
        // arg) is stack-passed: `sub rsp, 8` aligns %16 -> 8, then
        // `push r14` -> %16 == 0 for the call, `add rsp, 16` undoes both.
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + cwdw_skip_msg];
        lea rcx, [rip + cwdw_k_reason];
        mov r8, 1;                       // v1 = reason
        lea r9, [rip + cwdw_k_stage];
        sub rsp, 8;                      // alignment pad
        push r14;                        // v2 = stage
        call klog_s1_d2;
        add rsp, 16;

      cwdw_done:
        add rsp, 8;                      // undo pad
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
