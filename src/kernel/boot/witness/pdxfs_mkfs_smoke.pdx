// src/kernel/boot/witness/pdxfs_mkfs_smoke.pdx -- R52.M8-001 (#1721)
//
// Boot witness for the PDXFS-on-block v1 `mkfs.pdxfs` path: mints a
// substrate-mode NVMe cap chain (same 172..175 slot claim every prior
// R52 PdxFS witness uses, per pdxfs_boot_mount_smoke.pdx / inode_
// table_witness_synth.pdx / mount_replay_witness_synth.pdx / block_
// cache_synth.pdx precedent), attempts `mkfs_run` (src/kernel/core/fs/
// pdxfs/mkfs.pdx, #1688) against that chain, and either verifies the
// resulting on-disk superblock via `sb_read` (superblock_read.pdx,
// #1686) + `sb_magic` (superblock.pdx, #1682) round-trip (LIVE arm) or
// accepts the NVMEIO_PICK_NONE cascade as SUBSTRATE mode (every boot
// mode the smoke matrix drives today).
//
// -----------------------------------------------------------------------------
// LIVE vs SUBSTRATE arm
// -----------------------------------------------------------------------------
//
// Every boot mode the smoke matrix drives today runs against
// NVMEIO_PICK_NONE-refused bdevs (see block_cache_synth.pdx /
// mount_replay_witness_synth.pdx / pdxfs_boot_mount_smoke.pdx headers
// for the identical substrate posture). Under that posture, `mkfs_run`'s
// first `mkfs_zero_region` call (BDEV_OP_WRITE_LBA for the inode-table
// region) fans out into `cap_invoke` -> `cap_handler_blkdev` ->
// `nvme_io_submit_rw` -> `nvme_io_pick_pair`, which returns
// NVMEIO_PICK_NONE (no live SQ pair on the synthetic controller). The
// pick-none code propagates back verbatim through `cap_invoke`;
// `mkfs_zero_region`'s `cmp rax, 0; jne fail` then forwards
// MKFS_ZERO_FAIL (0xFFFFED0D) as `mkfs_run`'s return.
//
// This witness distinguishes the two arms by inspecting `mkfs_run`'s
// return value directly, mirroring pdxfs_boot_mount_smoke.pdx's own
// `cmp rax, 8; jae` idiom (adapted to mkfs_run's own zero-on-success
// contract):
//
//   * rax == 0 -> LIVE mkfs succeeded. Proceed to sb_read + sb_magic
//                 verify. Emit "PDXFS MKFS SMOKE OK".
//   * rax != 0 -> No live SQ pair on this boot (substrate mode); the
//                 mkfs attempt bounced off NVMEIO_PICK_NONE inside its
//                 first region-zero write. Emit "PDXFS MKFS SMOKE
//                 SUBSTRATE OK".
//
// Both fingerprints are output-strip-clean (design/policy/output-
// provenance-strip.md); the golden pins the SUBSTRATE arm today (that
// is what every boot mode reaches without a real NVMe device visible
// to the -kernel boot path -- MCFG absent -> `_pci_device_count` == 0
// -> `_nvme_device_count` == 0 even with `-device nvme` attached to
// QEMU, per drivers/nvme/probe.pdx's own drain-empty guard) and can
// gain the LIVE arm as a second ordered line once UEFI/OVMF makes MCFG
// available AND the driver-attach ceremony that brings a controller to
// SQ_LIVE runs boot-side, without disturbing the SUBSTRATE line's
// placement immediately after "BLOCK CACHE SUBSTRATE OK".
//
// -----------------------------------------------------------------------------
// Substrate-mode NVMe cap trick (identical to pdxfs_boot_mount_smoke.
// pdx / mount_replay_witness_synth.pdx / inode_table_witness_synth.pdx
// / alloc_free_hint_witness_synth.pdx / block_cache_synth.pdx)
// -----------------------------------------------------------------------------
//
// Mints a real KIND_NVME_CONTROLLER + dual-kind KIND_NVME_NAMESPACE/
// KIND_BLKDEV row that never advances to a live SQ pair, so every
// WRITE_LBA `mkfs_run` issues through `mkfs_zero_region` /
// `sb_write` forwards NVMEIO_PICK_NONE verbatim. Cap slots 172..175
// are the same fixed range every R52 PdxFS witness already claims
// (tolerated per this tree's established practice: every witness
// clears its own range on entry AND on every exit path, and boot
// witnesses run strictly sequentially, so no two witnesses' cap rows
// are ever live at once).
//
//   172 = synthetic KIND_PCI_DEV parent for the NVMe controller
//   173 = KIND_NVME_CONTROLLER (row 0)
//   174 = KIND_NVME_NAMESPACE (row 0, dual-kind with slot 175)
//   175 = KIND_BLKDEV, family NVME -- the bdev_cap passed to mkfs_run
//         and sb_read
//
// -----------------------------------------------------------------------------
// Why this is meaningful in substrate mode too
// -----------------------------------------------------------------------------
//
// The SUBSTRATE arm still exercises the whole call-stack shape:
// `mkfs_run` is invoked with a live-looking KIND_BLKDEV cap; its 5-push
// prologue and its `mkfs_layout_compute` leg run to completion (a full
// nine-field geometry stamp into `_mkfs_layout_row` from the passed
// {total_blocks=100, block_size=4096, inode_ratio=10, journal_size_hint=5}
// tuple -- see the `wit_mkfs_probe` witness at tests/kernel/fs/pdxfs/
// mkfs_probe_witness_synth.pdx for the same geometry in an in-memory-only
// posture). What DOES NOT execute is any real BDEV write: the very
// first `mkfs_zero_region` call short-circuits at the pick-none refusal.
// This is the same "primitive is wired, substrate has nothing to give
// it" degradation `pdxfs_boot_mount_smoke.pdx` documents at length for
// its own #1722 witness -- and this witness's own LIVE arm below is
// structured so it lights up automatically the first boot mode that
// HAS a live PdxFS-block device visible from the boot path.
//
// -----------------------------------------------------------------------------
// What the LIVE arm proves
// -----------------------------------------------------------------------------
//
// (a) `mkfs_run(175, 100, 4096, 10, 5)` returned 0. This is the strong
//     proof point: it means the full layout+zero+populate+sb_write
//     chain reached the device -- `mkfs_layout_compute` computed a
//     valid nine-field geometry, `mkfs_zero_region` succeeded three
//     times (inode-table, allocator, journal regions each written as
//     all-zero blocks), `mkfs_sb_populate` stamped the in-memory
//     superblock with magic + a fresh uuid + region-layout fields, and
//     `sb_write` persisted that scratch buffer to LBA 0 through
//     `cap_invoke` BDEV_OP_WRITE_LBA.
// (b) `sb_read(175)` returned a real KERNEL_VMA_BASE-relative sb_ptr
//     (>= 0xFFFF800000000000) -- the same distinguishing-idiom
//     pdxfs_boot_mount_smoke.pdx uses at its own stage (9). Any
//     validation-code sentinel (PDXB_SB_READ_BDEV_ERR/PDXB_SB_MAGIC_
//     BAD/...) is a < 2^32 value, which fails the KERNEL_VMA_BASE
//     compare below.
// (c) `sb_magic(sb_ptr)` returned exactly 0x42584450 ("PDXB", the
//     PDXFS_SB_MAGIC constant `superblock_fmt.pdx` #1681 froze). This
//     confirms the round-trip: what `mkfs_sb_populate` stamped into
//     `_mkfs_sb_scratch`'s magic field @+0 is what `sb_write`
//     persisted, is what `sb_read` fetched back into `_sb_read_buf`,
//     is what `sb_magic` reads back verbatim.
//
// -----------------------------------------------------------------------------
// Failure taxonomy
// -----------------------------------------------------------------------------
//
// The SUBSTRATE arm is not a failure; only the LIVE arm can fail. In
// the LIVE arm every sub-check is monotonic: if (b) or (c) does not
// hold after (a) succeeded, that is a real breakage in the mkfs/sb
// round trip -- either `mkfs_sb_populate`'s magic offset, `sb_write`'s
// LBA-0 write, `sb_read`'s LBA-0 read, `sb_validate_magic`'s
// acceptance path, or `sb_magic`'s field offset. Any such divergence
// hits `pms_fail_stage`, which logs the stage number via
// `klog_s1_d1(k_line)` mirroring pdxfs_boot_mount_smoke.pdx's own
// `pbms_fail_stage`, then runs the same cleanup and returns 1.
//
// -----------------------------------------------------------------------------
// Register plan
// -----------------------------------------------------------------------------
//
// 3-push prologue (rbx = sb_ptr set in the LIVE arm's stage 6, r12 =
// unused but pushed for pattern uniformity with the mount smoke
// sibling, r13 = unused/pattern) lands rsp%16 == 0 (entry rsp%16 == 8
// + 24 = 32) for every nested call this function makes directly,
// matching pdxfs_boot_mount_smoke.pdx's own 3-push shape. `bdev_cap`
// (175) and every immediate argument are compile-time-constant
// literals -- no register needs to carry them across calls beyond the
// LIVE-arm sb_ptr save. Stage number lives in `_pms_stage` (memory,
// not a register), matching inode_table_witness_synth.pdx's `_itw_
// stage` / mount_replay_witness_synth.pdx's `_mrw_stage` /
// pdxfs_boot_mount_smoke.pdx's `_pbms_stage` idiom. The one `sub rsp,
// 32` / `add rsp, 32` bracket around `nvme_ns_dual_kind_mint`'s
// params_ptr staging is 16-byte-aligned, so rsp%16 stays 0 across it
// (identical bracket to every sibling witness).
//
// -----------------------------------------------------------------------------
// mov_b / no-test / label-prefix discipline
// -----------------------------------------------------------------------------
//
// No byte-granularity access anywhere -- every field touched is a u64
// (via `mov`) or a u32 read through `sb_magic` (which itself does the
// mov_d zero-extension per its own header). No `test` instruction
// anywhere; every comparison uses `cmp` + `je`/`jne`/`jae`/`jb`. Every
// label is prefixed `pms_` (Pdxfs Mkfs Smoke) per the reserved-label
// discipline. Grep audit 2026-08-23: no `pms_` hits anywhere else in
// src/kernel/.
//
// Every sentinel compare against a value with bit 31/63 set (0x42584450
// for the PDXB magic, 0xFFFF800000000000 for KERNEL_VMA_BASE) is
// staged through `mov r10, <imm>; cmp reg, r10` rather than a bare
// `cmp reg, <imm>` -- identical G4 encoder-gap posture pdxfs_boot_
// mount_smoke.pdx's / inode_table_witness_synth.pdx's / mount_block.
// pdx's own headers document.
//
// -----------------------------------------------------------------------------
// Wire posture
// -----------------------------------------------------------------------------
//
// Wired into src/kernel/boot/witness/r30_platform.pdx immediately after
// `block_cache_witness_call` and immediately before `pdxfs_boot_mount_
// smoke_call`, closing the "mkfs -> mount" ordering the M8 plan text
// describes (pdxfs_boot_mount_smoke.pdx's own header explicitly names
// this as the future re-ordering that preserves the "mount witness
// observes the mkfs'd device" story). Golden: tests/r17/shell-
// shutdown.golden ("PDXFS MKFS SMOKE SUBSTRATE OK" appended right
// after "BLOCK CACHE SUBSTRATE OK" and right before "PDXFS BOOT MOUNT
// SUBSTRATE OK", matching every prior PdxFS witness's own golden-
// placement precedent). The new opt-in smoke variant `boot_r52_pdxfs_
// mkfs_nvme` (tools/run-smoke.sh) attaches `-device nvme` to prove the
// QEMU wiring works; MCFG remains absent under -kernel boot so the
// SUBSTRATE arm still fires, and a dedicated golden
// tests/r52/expected-pdxfs-mkfs-nvme.txt pins that same SUBSTRATE line
// (the LIVE fingerprint gains ordered presence once UEFI/OVMF wire-up
// lands, per the sibling issue chain #1722-#1726).

module PdxfsMkfsSmoke = structure {

  pub let mut _pms_stage : u64 = 0

  // Fingerprints. All three are output-strip-clean (no round/milestone/
  // issue tag). Length count includes the trailing "\n\0" pair.
  pub let pms_live_ok      : [u8; 21] = "PDXFS MKFS SMOKE OK\n\0"
  pub let pms_substrate_ok : [u8; 31] = "PDXFS MKFS SMOKE SUBSTRATE OK\n\0"
  pub let pms_fail         : [u8; 23] = "PDXFS MKFS SMOKE FAIL\n\0"

  // ==========================================================================
  // pms_clear() -- scrub cap_table slots 172..175 inclusive.
  //
  // Same shape as pdxfs_boot_mount_smoke.pdx's pbms_clear /
  // inode_table_witness_synth.pdx's itw_clear /
  // mount_replay_witness_synth.pdx's mrw_clear, restricted to 172..175
  // (this witness owns no additional slot beyond that shared range --
  // mkfs_run's cap_slot argument is the bdev_cap itself, 175).
  // ==========================================================================
  pub let pms_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R52.M8-001 (#1721): clear cap_table slots 172..175 (this witness's whole fixed slot claim: 172..175 shared with prior R52 PdxFS witnesses per established practice). Same shape as pbms_clear/itw_clear/mrw_clear, upper bound is 176 (exclusive). Labels prefixed pms_cl_.",
      block: {
        push rbx;
        mov rbx, 172;
      pms_cl_loop:
        cmp rbx, 176;
        jae pms_cl_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp pms_cl_loop;
      pms_cl_done:
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // pdxfs_mkfs_smoke_witness() -> u64
  //
  // Entry rsp%16 == 8 (invoked from r30_platform.pdx's boot_continue_
  // after_ring3 body via `call pdxfs_mkfs_smoke_witness`, which itself
  // runs at %16==0 after r30_platform.pdx's own `push rbp`). 3-push
  // prologue lands rsp%16 == 0 for every nested call.
  //
  // See module header for the full LIVE vs SUBSTRATE branching, the
  // substrate-mode NVMe cap trick, and the three-check LIVE arm scope
  // note.
  // ==========================================================================
  pub let pdxfs_mkfs_smoke_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R52.M8-001 (#1721): boot-time PDXFS mkfs.pdxfs smoke witness. 3-push prologue (rbx=sb_ptr set in LIVE stage 6, r12/r13 unused/pattern-uniformity with pdxfs_boot_mount_smoke.pdx) lands rsp%16==0 for every nested call. Body per module header: (1) defensive reset (nvme_ctrl_table_reset, nvme_ns_table_reset, pms_clear). (2)-(4) mint substrate NVMe cap chain identical to pdxfs_boot_mount_smoke.pdx's / mount_replay_witness_synth.pdx's stages 2-4 (KIND_PCI_DEV @172, KIND_NVME_CONTROLLER @173, dual-kind KIND_NVME_NAMESPACE/KIND_BLKDEV @174/175, all synthetic bar0=0x400000, block geometry {nsid=1, lba_size=4096, block_count=100, parent_ctrl_row=0}). (5) mkfs_run(bdev_cap=175, total_blocks=100, block_size=4096, inode_ratio=10, journal_size_hint=5). (6) Branch: cmp rax, 0; jne pms_substrate (any non-zero mkfs_run return under substrate posture is the expected NVMEIO_PICK_NONE cascade forwarded as MKFS_ZERO_FAIL, per module header). LIVE arm: (7) sb_read(175) -> rax = sb_ptr; verify rax >= KERNEL_VMA_BASE (0xFFFF800000000000, staged via r10, cmp rax, r10, jb pms_fail_stage); rbx = rax (sb_ptr). (8) sb_magic(sb_ptr): expect rax == PDXFS_SB_MAGIC (0x42584450, staged via r10, cmp rax, r10, jne pms_fail_stage per this codebase's G4 discipline). (9) All LIVE checks passed -> klog_s1(3, SUBSYS_BOOT, pms_live_ok); cleanup; return 0. SUBSTRATE arm: klog_s1(3, SUBSYS_BOOT, pms_substrate_ok); cleanup; return 0. pms_fail_stage: log stage number via klog_s1_d1(k_line) matching pbms_fail_stage; cleanup; return 1. Every cleanup path calls pms_clear + nvme_ctrl_table_reset + nvme_ns_table_reset before returning. Labels prefixed pms_.",
      block: {
        push rbx;
        push r12;
        push r13;

        // -----------------------------------------------------------
        // (1) Defensive reset.
        // -----------------------------------------------------------
        mov rax, 1;
        lea rcx, [rip + _pms_stage];
        mov [rcx], rax;

        call nvme_ctrl_table_reset;
        call nvme_ns_table_reset;
        call pms_clear;

        // -----------------------------------------------------------
        // (2) Synthetic KIND_PCI_DEV parent (slot 172).
        // -----------------------------------------------------------
        mov rax, 2;
        lea rcx, [rip + _pms_stage];
        mov [rcx], rax;

        mov rdi, 172;
        mov rsi, 0x30;                    // KIND_PCI_DEV
        mov rdx, 0x21F;                   // R_DEV_ALL | RIGHT_MINT
        mov rcx, 0xFACEFEED;              // synthetic bdf
        call cap_mint_write;

        // -----------------------------------------------------------
        // (3) KIND_NVME_CONTROLLER (slot 173, row 0). Never advanced
        // to a live SQ pair -- substrate-mode posture.
        // -----------------------------------------------------------
        mov rax, 3;
        lea rcx, [rip + _pms_stage];
        mov [rcx], rax;

        mov rdi, 172;                     // parent_slot (KIND_PCI_DEV)
        mov rsi, 0x61F;                   // R_NVMEC_ALL
        xor rdx, rdx;                     // ctrl_idx = 0
        mov rcx, 0x400000;                // bar0_pa (synthetic)
        call nvme_ctrl_cap_mint_inner;
        cmp rax, 0;                       // expect row 0
        jne pms_fail_stage;

        mov rdi, 173;
        mov rsi, 0x198;                   // KIND_NVME_CONTROLLER
        mov rdx, 0x61F;
        xor rcx, rcx;                     // target_ptr = ctrl_row_id = 0
        call cap_mint_write;

        // -----------------------------------------------------------
        // (4) Dual-kind KIND_NVME_NAMESPACE/KIND_BLKDEV (slots
        // 174/175, row 0).
        // -----------------------------------------------------------
        mov rax, 4;
        lea rcx, [rip + _pms_stage];
        mov [rcx], rax;

        sub rsp, 32;
        mov rax, 1;
        mov [rsp + 0], rax;                // nsid
        mov rax, 4096;
        mov [rsp + 8], rax;                // lba_size
        mov rax, 100;
        mov [rsp + 16], rax;               // block_count
        xor rax, rax;
        mov [rsp + 24], rax;               // parent_ctrl_row = 0
        mov rdi, 174;                      // ns_slot
        mov rsi, 175;                      // blk_slot
        mov rdx, 173;                      // parent_slot (KIND_NVME_CONTROLLER)
        mov rcx, 0x41F;                    // ns_rights (R_NVMEN_ALL)
        mov r8,  0x1F;                     // blk_rights (R_BLK_ALL)
        mov r9,  rsp;                      // params_ptr
        call nvme_ns_dual_kind_mint;
        add rsp, 32;
        cmp rax, 0;                        // expect row 0
        jne pms_fail_stage;

        // -----------------------------------------------------------
        // (5) mkfs_run(bdev_cap=175, total_blocks=100, block_size=4096,
        //     inode_ratio=10, journal_size_hint=5).
        //
        // Same {100, 4096, 10, 5} geometry the in-memory-only
        // wit_mkfs_probe witness at tests/kernel/fs/pdxfs/mkfs_probe_
        // witness_synth.pdx uses -- which produces the region layout
        // itable_lba=1/itable_bcount=1, alloc_lba=2/alloc_bcount=1,
        // journal_lba=3/journal_bcount=5, data_lba=8/data_bcount=92
        // (all comfortably within `sb_validate_regions`' geometry
        // discipline; see mkfs_layout_compute's own header proof).
        // -----------------------------------------------------------
        mov rax, 5;
        lea rcx, [rip + _pms_stage];
        mov [rcx], rax;

        mov rdi, 175;                      // bdev_cap
        mov rsi, 100;                      // total_blocks
        mov rdx, 4096;                     // block_size
        mov rcx, 10;                       // inode_ratio
        mov r8,  5;                        // journal_size_hint
        call mkfs_run;

        // -----------------------------------------------------------
        // (6) Branch on mkfs result. mkfs_run returns 0 on success
        // and one of MKFS_LAYOUT_FAIL/MKFS_ZERO_FAIL/PDXB_SB_WRITE_
        // BDEV_ERR on any failure. Under substrate posture the first
        // mkfs_zero_region call catches NVMEIO_PICK_NONE from cap_
        // invoke and forwards MKFS_ZERO_FAIL (0xFFFFED0D).
        // -----------------------------------------------------------
        cmp rax, 0;
        jne pms_substrate;

        // -----------------------------------------------------------
        // (7) LIVE arm: sb_read(175) -> sb_ptr. Verify >= KERNEL_VMA_
        // BASE via r10-staged compare (bit 63 set, per G4 discipline).
        // -----------------------------------------------------------
        mov rax, 7;
        lea rcx, [rip + _pms_stage];
        mov [rcx], rax;

        mov rdi, 175;
        call sb_read;
        mov r10, 0xFFFF800000000000;       // KERNEL_VMA_BASE
        cmp rax, r10;
        jb pms_fail_stage;
        mov rbx, rax;                      // rbx = sb_ptr

        // -----------------------------------------------------------
        // (8) LIVE arm: sb_magic(sb_ptr) == PDXFS_SB_MAGIC
        // (0x42584450). Staged via r10 per G4 discipline (imm32 cmp
        // operand sign-extends; 0x42584450 fits u32 but we keep the
        // shape uniform with the sibling witnesses' sentinel checks).
        // -----------------------------------------------------------
        mov rax, 8;
        lea rcx, [rip + _pms_stage];
        mov [rcx], rax;

        mov rdi, rbx;
        call sb_magic;
        mov r10, 0x42584450;               // PDXFS_SB_MAGIC (PDXB)
        cmp rax, r10;
        jne pms_fail_stage;

        // -----------------------------------------------------------
        // (9) LIVE arm success.
        // -----------------------------------------------------------
        mov rdi, 3;                        // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + pms_live_ok];
        call klog_s1;

        call pms_clear;
        call nvme_ctrl_table_reset;
        call nvme_ns_table_reset;
        xor rax, rax;
        jmp pms_out;

      pms_substrate:
        mov rdi, 3;                        // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + pms_substrate_ok];
        call klog_s1;

        call pms_clear;
        call nvme_ctrl_table_reset;
        call nvme_ns_table_reset;
        xor rax, rax;
        jmp pms_out;

      pms_fail_stage:
        lea rax, [rip + _pms_stage];
        mov r8, [rax];
        mov rdi, 1;                        // LEVEL_ERROR
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + pms_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;

        call pms_clear;
        call nvme_ctrl_table_reset;
        call nvme_ns_table_reset;
        mov rax, 1;

      pms_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
