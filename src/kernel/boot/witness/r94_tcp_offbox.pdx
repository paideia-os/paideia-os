// src/kernel/boot/witness/r94_tcp_offbox.pdx -- R94.M6-001/002
// (paideia-os #2073/#2074).
//
// Boot witness: real off-box TCP connect through QEMU SLIRP's
// virtio-net TX/RX rings, one-round-trip echo, orderly close. First
// evidence that net/tcp.pdx's state machine actually cycles
// SYN_SENT -> ESTABLISHED against a peer synthesized by a foreign
// TCP stack (SLIRP's host-forwarded netcat), not the R72 self-
// addressed loopback fast path.
//
// =============================================================================
// SECTION 0  TARGET
// =============================================================================
//
// SLIRP's guest-visible gateway 10.0.2.2 forwards a chosen host TCP
// port (default 5555) to the SAME port on the host loopback. The
// witness connects to 10.0.2.2:5555, transmits a 4-byte "PING",
// polls the RX ring until any reply lands in the client TCB's
// rx_buf, and emits the roundtrip-ok fingerprint.
//
// Under PAIDEIA_HOSTFWD='tcp::5555-:5555' the smoke harness starts a
// host-side responder (e.g. `nc -l 5555 -q 1`) BEFORE invoking QEMU;
// SLIRP's TCP stack completes the SYN + payload + FIN sequence and
// the responder either echoes the bytes back (netcat's default when
// stdin is redirected from the same socket) or writes a stock
// greeting. Any non-zero byte count on RX is the assertable event.
//
// =============================================================================
// SECTION 1  SKIP DISCIPLINE
// =============================================================================
//
// The witness silently skips (emits `boot r94 offbox skip -- stage=<n>`)
// on the same three preconditions R92's off-box ping witness does:
//   stage=1 : no active NIC (PAIDEIA_NIC=none).
//   stage=2 : sys_socket returned an error (TCB pool exhaustion).
//   stage=3 : sys_connect failed AND state did not reach ESTABLISHED
//             within the poll budget.
//   stage=4 : sys_send returned an error.
//   stage=5 : reply never landed within the RX budget.
//   stage=6 : sys_shutdown returned an error.
//
// A skip is not a failure per se -- it is a "the substrate is not in a
// posture where this witness can attest against QEMU SLIRP right now".
// The R94.M6-003 smoke golden pins the substring "boot r94 offbox" so
// EITHER the ok line or a skip line satisfies the smoke, matching the
// R92 icmp witness precedent.
//
// =============================================================================
// SECTION 2  BUDGET
// =============================================================================
//
// TCP handshake through SLIRP typically completes in the same tick;
// R94 keeps the poll_budget generous (8M iterations, ~40ms at 200MHz
// effective throughput) so a slow host does not falsely skip. Same
// budget applied to the reply drain.
//
// =============================================================================
// SECTION 3  LABEL + ENCODER DISCIPLINE
// =============================================================================
//
// Frame prologue implicit. Labels prefixed `r94wt_`. Encoder
// conservative: [reg+imm] only, xor+mov_b for byte loads.

module R94TcpOffbox = structure {

  // "PING" -- 4 bytes, no NUL.
  pub let _r94wt_ping : [u8; 4] = [ 0x50u8, 0x49u8, 0x4Eu8, 0x47u8 ]

  pub let R94WT_TARGET_PORT       : u64 = 5555
  // 10.0.2.2 packed as (10<<24)|(0<<16)|(2<<8)|2 = 0x0A000202.
  pub let R94WT_TARGET_IP_PACKED  : u64 = 0x0A000202
  pub let R94WT_HANDSHAKE_BUDGET  : u64 = 8000000
  pub let R94WT_REPLY_BUDGET      : u64 = 8000000

  pub let witness_r94_tcp_offbox : () -> () !{sysreg, mem} @{boot, cap, sched} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap, sched},
      justification: "R94.M6-001/002 (paideia-os #2073/#2074). Boot witness: real off-box TCP connect + echo via QEMU SLIRP's virtio-net rings + host hostfwd port 5555. Body: (1) 6-push callee-save (rbx=cap_slot, rbp=tcb_idx, r12=handshake_budget, r13=reply_budget, r14=rx_bytes, r15=nic_kind) + sub rsp,8: entry rsp%16==8, 6 pushes 48B -> %16==8, sub 8 -> 0 for the many nested calls. (2) Gate: nic_dispatch_active_kind == 0 -> skip stage=1. (3) tcp_socket_new -> cap_slot in rbx; sentinel high-bit -> skip stage=2. (4) Resolve tcb_idx via cap_table[slot*24+16] load (matches R95Poll witness idiom). (5) sys_connect_body(cap_slot, R94WT_TARGET_IP_PACKED=0x0A000202, R94WT_TARGET_PORT=5555). rax==0 -> ESTABLISHED synchronously (SLIRP fast path). Otherwise poll _tcb_ptr[+0]==4 with handshake_budget nic_dispatch_rx_poll calls. Not reached -> skip stage=3. Emit `boot r94 offbox handshake ok --` fingerprint. (6) sys_send_body(cap_slot, &_r94wt_ping, 4). rax != 4 -> skip stage=4. (7) Poll rx_tail > rx_head with reply_budget nic_dispatch_rx_poll iterations. Not reached -> skip stage=5. Read rx_tail - rx_head into r14. Emit `boot r94 offbox roundtrip ok -- bytes=<n>` via klog_s1_d1. (8) sys_shutdown_body(cap_slot, TCP_SHUT_RDWR=2). rax != 0 -> skip stage=6 (defensive). Return. Reserved labels r94wt_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;

        // (2) Active NIC gate.
        call nic_dispatch_active_kind;
        mov r15, rax;
        cmp r15, 0;
        jne r94wt_have_nic;
        mov r14, 1;
        jmp r94wt_skip;

      r94wt_have_nic:
        // (3) tcp_socket_new.
        call tcp_socket_new;
        // Any high-bit-set return is an error sentinel (0xFFFF...*).
        mov rcx, rax;
        shr rcx, 63;
        cmp rcx, 0;
        jne r94wt_skip_stage2;
        mov rbx, rax;                        // cap_slot

        // (4) Resolve tcb_idx via cap_table[slot*24+16].
        mov rax, rbx;
        shl rax, 3;
        mov rcx, rbx;
        shl rcx, 4;
        add rax, rcx;
        lea rdx, [rip + cap_table];
        add rdx, rax;
        mov rbp, [rdx + 16];                 // tcb_idx

        // (5) sys_connect.
        mov rdi, rbx;
        mov rsi, 0x0A000202;                 // R94WT_TARGET_IP_PACKED
        mov rdx, 5555;                       // R94WT_TARGET_PORT
        call sys_connect_body;
        cmp rax, 0;
        je r94wt_est;                        // loopback / synchronous OK

        // Poll RX ring for ESTABLISHED.
        mov r12, 8000000;                    // R94WT_HANDSHAKE_BUDGET
      r94wt_hs_loop:
        cmp r12, 0;
        je r94wt_skip_stage3;
        mov rdi, r15;
        call nic_dispatch_rx_poll;
        mov rax, rbp;
        shl rax, 9;
        lea rcx, [rip + _tcp_tcb_table];
        add rax, rcx;
        mov rcx, [rax + 0];
        cmp rcx, 4;                          // TCP_ST_ESTABLISHED
        je r94wt_est;
        sub r12, 1;
        jmp r94wt_hs_loop;

      r94wt_est:
        // Emit handshake_ok.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_boot_r94_offbox_hs_ok];
        call klog_s1;

        // (6) sys_send "PING".
        mov rdi, rbx;
        lea rsi, [rip + _r94wt_ping];
        mov rdx, 4;
        call sys_send_body;
        cmp rax, 4;
        jne r94wt_skip_stage4;

        // (7) Poll for reply bytes in rx_buf.
        mov r13, 8000000;                    // R94WT_REPLY_BUDGET
      r94wt_rx_loop:
        cmp r13, 0;
        je r94wt_skip_stage5;
        mov rdi, r15;
        call nic_dispatch_rx_poll;
        mov rax, rbp;
        shl rax, 9;
        lea rcx, [rip + _tcp_tcb_table];
        add rax, rcx;
        mov r14, [rax + 184];                // rx_tail
        mov rdx, [rax + 176];                // rx_head
        cmp r14, rdx;
        ja r94wt_have_reply;
        sub r13, 1;
        jmp r94wt_rx_loop;

      r94wt_have_reply:
        mov rax, rbp;
        shl rax, 9;
        lea rcx, [rip + _tcp_tcb_table];
        add rax, rcx;
        mov rdx, [rax + 184];
        mov r14, rdx;
        mov rcx, [rax + 176];
        sub r14, rcx;                        // bytes in rx_buf

        // Emit roundtrip_ok -- bytes=r14.
        mov r8, r14;
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_boot_r94_offbox_rt_ok];
        lea rcx, [rip + k_bytes];
        call klog_s1_d1;

        // (8) sys_shutdown(cap_slot, SHUT_RDWR=2).
        mov rdi, rbx;
        mov rsi, 2;
        call sys_shutdown_body;
        // Ignore rax -- shutdown is best-effort for teardown.
        jmp r94wt_done;

      r94wt_skip_stage2:
        mov r14, 2;
        jmp r94wt_skip;
      r94wt_skip_stage3:
        mov r14, 3;
        jmp r94wt_skip;
      r94wt_skip_stage4:
        mov r14, 4;
        jmp r94wt_skip;
      r94wt_skip_stage5:
        mov r14, 5;
        jmp r94wt_skip;

      r94wt_skip:
        // klog_s1_d1(LEVEL_INFO, SUBSYS_BOOT, tag_boot_r94_offbox_skip,
        //            k_stage_r94, r14).
        mov r8, r14;
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_boot_r94_offbox_skip];
        lea rcx, [rip + k_stage_r94];
        call klog_s1_d1;

      r94wt_done:
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }
}
