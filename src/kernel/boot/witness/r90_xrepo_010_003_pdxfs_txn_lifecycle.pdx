// src/kernel/boot/witness/r90_xrepo_010_003_pdxfs_txn_lifecycle.pdx --
// R90-XREPO.010.M1-003 (paideia-os #2111)
//
// Boot-time witness proving both new pdxfs txn lifecycle syscalls end to
// end in the same boot:
//
//   Scenario A -- commit path
//     (1) Reset the _pdxfs_txn_table free pool; scrub cap slots
//         160..167 for a predictable window.
//     (2) Mint a synthetic KIND_MEMORY parent at slot 160 carrying
//         RIGHT_MINT so sys_pdxfs_txn_open_body's parent gate accepts
//         it (same shape as pdxfs_pkg_install_smoke.pdx / pdxfs_txn_
//         ops_real_synth.pdx one slot-range up).
//     (3) Call sys_pdxfs_txn_open_body(parent=160, mode=PXT_MODE_
//         MODIFY=2, txn_id=0xE300, wal_off=0x9000) -> cap_slot_a.
//     (4) Resolve cap_slot_a -> row_a via pdxfs_txn_row_of_slot and
//         verify it lands in [0, PXT_MAX=16).
//     (5) Call the NEW sys_pdxfs_txn_commit_body(cap_slot_a) -- must
//         return 0. This is what proves sysno 104's OK path lives.
//     (6) Read row_a's state via pdxfs_txn_row_state; assert it
//         advanced OPEN -> COMMITTED (2). Mount-agnostic: commit_wal's
//         no-mount arm short-circuits to 0 (see #1712 header), so the
//         row transition is what pins the observable effect on every
//         boot regardless of whether a real PdxFS-block volume is
//         mounted at the root.
//
//   Scenario B -- abort path
//     (7) Call sys_pdxfs_txn_open_body against the same parent (parent
//         still lives; each open claims a fresh row) with mode=PXT_
//         MODE_DELETE=3, txn_id=0xE301, wal_off=0x9100 -> cap_slot_b.
//     (8) Resolve cap_slot_b -> row_b via pdxfs_txn_row_of_slot,
//         assert row_b < PXT_MAX and row_b != row_a (each open must
//         claim a distinct row).
//     (9) Call sys_pdxfs_txn_abort_body(cap_slot_b) -- must return 0.
//         This is what proves sysno 105's OK path lives.
//    (10) Read row_b's state via pdxfs_txn_row_state; assert it
//         advanced OPEN -> ABORTED (3). Same mount-agnostic invariant
//         holds for abort_wal (see #1713 header).
//
//   Rollup
//    (11) Emit `boot pdxfs txn lifecycle ok [legacy: BOOT PDXFS TXN
//         LIFECYCLE OK] -- count=2` via klog_s1_d1(SUBSYS_BOOT, tag_
//         boot_pdxfs_txn_lc_ok, k_count, 2). One rollup fingerprint
//         covers both scenarios since a failure in either arm short-
//         circuits to the skip funnel below. count=2 names "2 lifecycle
//         scenarios exercised".
//
// Failure funnel -- emits `boot pdxfs txn lifecycle skip -- reason=N
// stage=S` via klog_s1_d2 with distinct stage codes so a regression
// names which of the ten stages tripped. reason=1 always today (the
// witness is a straight-line assert; a future refinement could split
// reason by class of failure).
//
// SLOT-RANGE HYGIENE: cap_table slots 160..167 (disjoint from the
// established ranges 116..127 = pdxfs_txn_ops_synth, 128..135 = pdxfs_
// txn_ops_real_synth, 136..143 = pdxfs_pkg_install_smoke, 144..151 =
// pdxfs_pkg_install_pipeline's own future range). Only slot 160 is
// actively used (the KIND_MEMORY parent); the remainder are scrubbed
// for symmetry. sys_pdxfs_txn_open_body's free-slot scan may land the
// KIND_PDXFS_TXN cap in any slot outside this range -- that's fine, we
// resolve via pdxfs_txn_row_of_slot which is slot-independent.
//
// FINGERPRINT: `boot pdxfs txn lifecycle ok [legacy: BOOT PDXFS TXN
// LIFECYCLE OK] -- count=2`. The syscall bodies themselves (sys_
// pdxfs_txn_commit_body / sys_pdxfs_txn_abort_body) emit their own
// per-call fingerprints `sys pdxfs txn commit ok -- txn=<row_a>` and
// `sys pdxfs txn abort ok -- txn=<row_b>` before this rollup lands;
// three fingerprints total per successful boot.
//
// PLACEMENT (kernel_main.pdx): after witness_r100_prep_003_icmp_echo
// (last of the R100-PREP witness block) and before witness_r17_init_
// sched, so the pdxfs txn table + cap table are in a predictable
// pre-init state and the fingerprint stream stays in boot phase.
// Depends on witness_r20b_substrate having wired the KIND_PDXFS_TXN
// dispatch bank already (yes, that lands at the very start of the R15/
// R20b substrate block above the R100-PREP wave).
//
// LEGACY OK TOKEN: the rollup tag carries a standalone uppercase "OK"
// in its bracketed legacy-alias suffix (BOOT PDXFS TXN LIFECYCLE OK),
// so tools/verify-fingerprint-coverage.sh demands either a golden line
// or an allowlist entry. Allowlist entry lands with this milestone
// alongside the R73 `sys kill ok` / R100-PREP-003 `sys icmp echo ok`
// precedents (no golden file pins the exact byte stream at this
// landing; the witness's own passing is the assertable signal).
//
// Reserved-label discipline: labels prefixed `pxtl_` (PdXfsTxn
// Lifecycle). `loop`, `if` etc. are keywords and never used as labels.
//
// Frame prologue: manual push/pop (same as every other witness_*.pdx).

module R90XrepoPdxfsTxnLifecycle = structure {

  // Skip-path fingerprint tag. Locally scoped -- no other witness
  // needs it, and the text carries no standalone uppercase OK token so
  // verify-fingerprint-coverage.sh's OK_TOK extractor does not gate on
  // it. Byte count NUL-inclusive per #699 discipline: "boot pdxfs txn
  // lifecycle skip" = 30 chars + NUL = 31.
  pub let pxtl_skip_msg : [u8; 31] = "boot pdxfs txn lifecycle skip \0"
  pub let pxtl_k_reason : [u8;  7] = "reason\0"
  pub let pxtl_k_stage  : [u8;  6] = "stage\0"

  // Constants for the two-scenario invariants (kept as named literals
  // so a future refactor can grep the numeric values back to a name).
  pub let PXTL_MODE_MODIFY   : u64 = 2   // PXT_MODE_MODIFY
  pub let PXTL_MODE_DELETE   : u64 = 3   // PXT_MODE_DELETE
  pub let PXTL_TXN_ID_A      : u64 = 0xE300
  pub let PXTL_TXN_ID_B      : u64 = 0xE301
  pub let PXTL_WAL_OFF_A     : u64 = 0x9000
  pub let PXTL_WAL_OFF_B     : u64 = 0x9100
  pub let PXTL_PARENT_SLOT   : u64 = 160
  pub let PXTL_STATE_COMMITTED : u64 = 2   // PXT_STATE_COMMITTED
  pub let PXTL_STATE_ABORTED   : u64 = 3   // PXT_STATE_ABORTED
  pub let PXTL_PXT_MAX       : u64 = 16    // PXT_MAX

  // ==========================================================================
  // pxtl_clear() -> ()
  //
  // Scrub cap_table slots 160..167 for a predictable witness window.
  // Same shape as pkgi_clear / pxor_clear in the sibling witnesses,
  // one slot-range up. One callee-save push (rbx) leaves rsp%16 == 0
  // for the nested cap_mint_write call.
  // ==========================================================================
  pub let pxtl_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R90-XREPO.010.M1-003 (paideia-os #2111) boot witness helper: scrub cap_table slots 160..167 for the txn lifecycle witness. Same shape as pkgi_clear in pdxfs_pkg_install_smoke.pdx (one slot-range up). One callee-save push (rbx) leaves rsp%16 == 0 for the nested cap_mint_write call from entry rsp%16 == 8. Labels prefixed pxtl_c_.",
      block: {
        push rbx;
        mov rbx, 160;
      pxtl_c_loop:
        cmp rbx, 168;
        jae pxtl_c_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp pxtl_c_loop;
      pxtl_c_done:
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // pxtl_mem(slot, key, rights) -> ()
  //
  // Mint a synthetic KIND_MEMORY parent at `slot` so pdxfs_txn_cap_
  // mint_inner's parent gate accepts it. Same shape as pkgi_mem /
  // pxor_mem across the sibling ops witnesses. Three callee-save
  // pushes align rsp%16 == 0 for the nested cap_mint_write call.
  // ==========================================================================
  pub let pxtl_mem : (u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (key: u64) (rights: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R90-XREPO.010.M1-003 (paideia-os #2111) boot witness helper: mint synthetic KIND_MEMORY parent for the txn lifecycle witness. Kind=4 (KIND_MEMORY); rights per caller (typically RIGHT_MINT = 0x200). Mirrors pkgi_mem/pxor_mem shape one-for-one. Three callee-save pushes (r12/r13/r14) leave rsp%16 == 0 for the nested cap_mint_write call. Labels prefixed pxtl_m_.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;                    // slot
        mov r13, rsi;                    // key
        mov r14, rdx;                    // rights
        mov rdi, r12;
        mov rsi, 4;                      // KIND_MEMORY
        mov rdx, r14;                    // rights
        mov rcx, r13;                    // target_ptr = key
        call cap_mint_write;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // witness_r90_xrepo_010_003_pdxfs_txn_lifecycle() -> ()
  //
  // Register plan (5 callee-save pushes leave rsp%16==0 for every
  // nested call from entry rsp%16==8):
  //   rbx = row_a (Scenario A row_id -- survives Scenario B)
  //   r12 = cap_slot_a (Scenario A cap slot -- survives commit call)
  //   r13 = cap_slot_b (Scenario B cap slot -- survives abort call)
  //   r14 = row_b (Scenario B row_id -- survives state check)
  //   r15 = current stage (1..11; used by the skip funnel)
  // ==========================================================================
  pub let witness_r90_xrepo_010_003_pdxfs_txn_lifecycle : () -> () !{mem, sysreg} @{boot, cap} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot, cap},
      justification: "R90-XREPO.010.M1-003 (paideia-os #2111): boot witness for sys_pdxfs_txn_commit (sysno 104) + sys_pdxfs_txn_abort (sysno 105). Five callee-save pushes leave rsp%16==0 for every nested call from entry rsp%16==8 (matches every sibling witness in this cascade). Two independent lifecycle scenarios in one boot: (A) open->commit->verify-COMMITTED against a fresh row; (B) open->abort->verify-ABORTED against a second fresh row. Each open claims a distinct row (row_a != row_b) since pdxfs_txn_tail_alloc scans for the first in_use==0 slot. Both scenarios call the NEW syscall bodies directly (bypassing dispatch shim -- boot context, no ring-3 shim needed), which internally exercise pdxfs_txn_commit_wal / pdxfs_txn_abort_wal + pdxfs_txn_row_transition + pdxfs_txn_note + klog. Mount-agnostic: both commit_wal and abort_wal short-circuit to PXT_OK when no PdxFS-block root is mounted (see their headers), so the row transition is what pins the observable OPEN->COMMITTED/ABORTED effect on every boot regardless of whether a real block device is present. Reset _pdxfs_txn_table (via pdxfs_txn_table_reset) before Scenario A so a re-run lands in a clean pool -- CRITICAL because the boot cascade above already exercises pdxfs_txn_open through the pkg-install / round-trip / synth witnesses, leaving rows in the pool. The parent KIND_MEMORY cap at slot 160 carries RIGHT_MINT (0x200) so the mint gate accepts it. Effects/capabilities: {mem,sysreg}@{boot,cap} matches every substrate-mutating witness (mem for the txn table + cap table + stats + klog ring; sysreg transitively from klog_s1_d1's TSC read + pdxfs_txn_commit_wal's MMIO writes through jnl_bdev_flush when a mount happens to be live). Encoder-conservative: cmp/je/jne/jae/mov/lea/xor/push/pop/call/sub/add/ret only -- every form already proven at this exact shape in the sibling witnesses (pdxfs_pkg_install_smoke, r100_prep_003_icmp_echo). Labels prefixed pxtl_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // Stage counter (kept in r15 for the skip funnel).
        mov r15, 1;

        // ==================================================================
        // (1) Reset the txn table + scrub the cap slots.
        // ==================================================================
        call pdxfs_txn_table_reset;
        call pxtl_clear;

        // ==================================================================
        // (2) Mint the KIND_MEMORY parent at slot 160 with RIGHT_MINT.
        // ==================================================================
        mov r15, 2;
        mov rdi, 160;                    // PXTL_PARENT_SLOT
        mov rsi, 0xF160;                 // opaque parent key
        mov rdx, 0x200;                  // RIGHT_MINT
        call pxtl_mem;

        // ==================================================================
        // (3) Open Scenario A's transaction (MODIFY / txn_id 0xE300).
        // ==================================================================
        mov r15, 3;
        mov rdi, 160;                    // parent_slot
        mov rsi, 2;                      // PXT_MODE_MODIFY
        mov rdx, 0xE300;                 // txn_id A
        mov rcx, 0x9000;                 // wal_off A
        call sys_pdxfs_txn_open_body;
        // sys_pdxfs_txn_open_body returns a cap_slot in [0, 256) on
        // success or an error >= 256. Cap slot == valid range check.
        mov r10, 256;
        cmp rax, r10;
        jae pxtl_skip;
        mov r12, rax;                    // r12 = cap_slot_a

        // ==================================================================
        // (4) Resolve cap_slot_a -> row_a and bound-check row_a < 16.
        // ==================================================================
        mov r15, 4;
        mov rdi, r12;
        call pdxfs_txn_row_of_slot;
        mov r10, 16;                     // PXT_MAX
        cmp rax, r10;
        jae pxtl_skip;                   // PXT_ROW_NONE(0xFF) is >= 16
        mov rbx, rax;                    // rbx = row_a (survives Scenario B)

        // ==================================================================
        // (5) Call the NEW sys_pdxfs_txn_commit_body(cap_slot_a).
        //     Must return 0. Any non-zero (sentinel forward or -EBADF)
        //     names a regression in the commit body.
        // ==================================================================
        mov r15, 5;
        mov rdi, r12;                    // cap_slot_a
        call sys_pdxfs_txn_commit_body;
        cmp rax, 0;
        jne pxtl_skip;

        // ==================================================================
        // (6) Read row_a's state; must be COMMITTED (2).
        //     Mount-agnostic invariant (commit_wal's no-mount arm
        //     short-circuits to PXT_OK, so the row transition is the
        //     observable effect).
        // ==================================================================
        mov r15, 6;
        mov rdi, rbx;                    // row_a
        call pdxfs_txn_row_state;
        cmp rax, 2;                      // PXT_STATE_COMMITTED
        jne pxtl_skip;

        // ==================================================================
        // (7) Open Scenario B's transaction (DELETE / txn_id 0xE301).
        //     Same parent slot -- each open claims a fresh row via
        //     pdxfs_txn_tail_alloc's first-free scan.
        // ==================================================================
        mov r15, 7;
        mov rdi, 160;                    // parent_slot
        mov rsi, 3;                      // PXT_MODE_DELETE
        mov rdx, 0xE301;                 // txn_id B
        mov rcx, 0x9100;                 // wal_off B
        call sys_pdxfs_txn_open_body;
        mov r10, 256;
        cmp rax, r10;
        jae pxtl_skip;
        mov r13, rax;                    // r13 = cap_slot_b

        // ==================================================================
        // (8) Resolve cap_slot_b -> row_b; bound-check row_b < 16 and
        //     row_b != row_a (each open claims a distinct row -- proves
        //     the free-scan advanced past the still-in-use row_a).
        // ==================================================================
        mov r15, 8;
        mov rdi, r13;
        call pdxfs_txn_row_of_slot;
        mov r10, 16;
        cmp rax, r10;
        jae pxtl_skip;
        mov r14, rax;                    // r14 = row_b
        cmp r14, rbx;                    // row_b == row_a?
        je  pxtl_skip;

        // ==================================================================
        // (9) Call the NEW sys_pdxfs_txn_abort_body(cap_slot_b).
        //     Must return 0.
        // ==================================================================
        mov r15, 9;
        mov rdi, r13;                    // cap_slot_b
        call sys_pdxfs_txn_abort_body;
        cmp rax, 0;
        jne pxtl_skip;

        // ==================================================================
        // (10) Read row_b's state; must be ABORTED (3).
        // ==================================================================
        mov r15, 10;
        mov rdi, r14;                    // row_b
        call pdxfs_txn_row_state;
        cmp rax, 3;                      // PXT_STATE_ABORTED
        jne pxtl_skip;

        // ==================================================================
        // (11) Emit success rollup.
        //      `boot pdxfs txn lifecycle ok [legacy: BOOT PDXFS TXN
        //       LIFECYCLE OK] -- count=2`
        // ==================================================================
        mov r15, 11;
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_boot_pdxfs_txn_lc_ok];
        lea rcx, [rip + k_count];
        mov r8, 2;                       // count = 2 scenarios exercised
        call klog_s1_d1;
        jmp pxtl_done;

      pxtl_skip:
        // Skip funnel. reason=1 today (single failure class);
        // stage=<r15> names which of the 10 stages tripped.
        // Emits `boot pdxfs txn lifecycle skip -- reason=1 stage=<S>`
        // via klog_s1_d2 (two decimal KVs).
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + pxtl_skip_msg];
        lea rcx, [rip + pxtl_k_reason];
        mov r8, 1;                       // v1 = reason
        lea r9, [rip + pxtl_k_stage];
        sub rsp, 8;                      // alignment pad (rsp%16: 0 -> 8)
        push r15;                        // v2 = stage;   rsp%16: 8 -> 0
        call klog_s1_d2;
        add rsp, 16;                     // undo pad + push

      pxtl_done:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
