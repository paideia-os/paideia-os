// src/kernel/boot/witness/r90_xrepo_010_002_stat_by_inode.pdx --
// R90-XREPO.010.M1-002 (paideia-os #2110) boot witness.
//
// Boot-time witness for sys_pdxfs_stat_by_inode (sysno 106). Stages:
//
//   (1) Look up /tmp in the tmpfs tree (tmpfs_lookup(root=1, "tmp"))
//       to recover the parent directory the r16_tmpfs witness block
//       already populated at boot line ~941. Same posture as the
//       sibling R90XrepoPdxfsReadBytes witness at
//       src/kernel/boot/witness/r90_xrepo_010_pdxfs_read_bytes.pdx.
//
//   (2) tmpfs_create(tmp_idx, "statseed", 8, VNODE_TYPE_REG=1) to
//       mint a fresh inode we own for this witness. A distinct name
//       vs. the /tmp/rbseed the M1-001 witness owns keeps this
//       witness self-contained.
//
//   (3) tmpfs_write(new_idx, &_spsi_seed_buf, PSPSI_SEED_LEN=16, 0)
//       to seed the inode with a fixed 16-byte payload so the size
//       assertion in stage (5) sees a non-zero, non-trivial value.
//       The seed content itself is not read back -- only the size is
//       relevant to this witness -- but a distinctive pattern
//       (0xCAFE2110_00000010 twice) keeps the byte stream
//       recognisable in a hex-dump if a future landing needs it.
//
//   (4) Call sys_pdxfs_stat_by_inode_scratch_fill(new_idx) directly
//       (bypassing sys_pdxfs_stat_by_inode_body's user_ptr_ok gate
//       since a boot witness has no user-half address to hand to it
//       -- the .bss scratch used by every witness lives in the
//       kernel half and user_ptr_ok would refuse it with -EFAULT
//       every time). Assert rax == 0 -- the helper is fingerprint-
//       silent on success, so this witness's own rollup fingerprint
//       below is the only serial signal for the fill-path exercise.
//
//   (5) Read _sys_pdxfs_stat_by_inode_out_scratch's four fields and
//       cross-check:
//         mode_bits (+0)  == 0x81A4     (S_IFREG | 0o644)
//         size      (+8)  == PSPSI_SEED_LEN (16)
//         mtime_ns  (+16) == _tick_count * 10_000_000 (recomputed
//                            inline here so the assertion tracks the
//                            fill helper's own formula regardless of
//                            when _tick_count first ticks -- this
//                            witness runs BEFORE lapic_timer_init +
//                            sti in the current boot cascade, so
//                            _tick_count is 0 and mtime_ns is 0 at
//                            witness time; a future landing that
//                            moves this witness after sti recovers a
//                            non-zero expected value automatically)
//         ctime_ns  (+24) == 0          (reserved field, must stay 0)
//
//   (6) Emit witness fingerprint via klog_s1_d2(SUBSYS_BOOT,
//       tag_boot_pdxfs_stat_ok, k_ino=new_idx, k_size=PSPSI_SEED_LEN)
//         -> "boot pdxfs stat ok -- ino=<n> size=16"
//       All-lowercase, no bracketed legacy-alias suffix, so
//       tools/verify-fingerprint-coverage.sh's OK_TOK extractor does
//       not gate on it (same posture as r89_tui_canvas.pdx /
//       r90_xrepo_010_pdxfs_read_bytes.pdx).
//
// The syscall body's per-call fingerprint (`sys pdxfs stat by inode
// ok [legacy: SYS PDXFS STAT BY INODE OK] ino=<n> size=<n>`) is NOT
// emitted here since the witness bypasses the body (see stage 4
// rationale). A future landing that exercises the full body via a
// user-mapped scratch (or the ring-3 shell path once one exists)
// will emit that per-call fingerprint on every OK call; today it is
// only reachable via the ring-3 syscall path and the coverage
// allowlist entry in tools/verify-fingerprint-coverage.sh reflects
// that.
//
// Placement in the boot cascade
// -----------------------------
//
// Called from `boot_continue_after_ring3` in kernel_main.pdx AFTER
// witness_r90_xrepo_010_pdxfs_read_bytes (which itself creates
// /tmp/rbseed and thus proves the tmpfs pool + /tmp are live) and
// BEFORE witness_r90_xrepo_010_003_pdxfs_txn_lifecycle so the
// R90-XREPO.010 witness block stays contiguous and monotonic in
// milestone number (M1-001 -> M1-002 -> M1-003).
//
// Encoder / label discipline
// --------------------------
//
// Every label is prefixed `spsw_` (short for sys pdxfs stat by inode
// witness) so no reserved-keyword clash (`loop`/`if`/... would parse
// as keywords). Frame prologue implicit. Every large immediate
// (0xCAFE211000000010 seed pattern, 0x81A4 mode value) is staged
// into r10/r11 before the cmp -- imm32 sign-extends and would
// compare against 0xFFFFFFFF... rather than the intended full 64-bit
// value. Follows the R90XrepoPdxfsReadBytes witness's own encoder
// discipline byte-for-byte.

module R90XrepoStatByInode = structure {

  // Stage tracker for the failure-emit funnel. Set at the start of
  // each stage so a failure klog line names which sub-test tripped.
  pub let mut _spsw_stage : u64 = 0

  // Seed content: two copies of the 64-bit pattern
  // 0xCAFE2110_00000010 written as one qword each. Low 32 bits of
  // the pattern encode the issue number + payload length; the high
  // 32 bits are the "milestone tag" so a hex-dump names the source
  // milestone. Written little-endian by paideia-as's default qword
  // store: byte 0 = 0x10, byte 15 = 0xCA.
  pub let mut _spsw_seed_buf : [u8; 16] = uninit @align(8)
  pub let PSPSI_SEED_PATTERN : u64 = 0xCAFE211000000010
  pub let PSPSI_SEED_LEN     : u64 = 16

  // Fixed name for the seeded tmpfs file: "statseed\0" (8 chars +
  // NUL). Distinct from every other tmpfs name any sibling witness
  // in this directory creates (grep of src/kernel/boot/witness/
  // 2026-09-01 confirms no other witness names "statseed").
  pub let spsw_seed_name : [u8; 9] = "statseed\0"

  // tmpfs_lookup name for "/tmp" (the r16_tmpfs create witness
  // already populated it under root=1). Duplicated here rather than
  // referenced from r16_tmpfs's own witness_name_tmp to keep this
  // witness's .o standalone (no cross-.o rodata dependency chain).
  pub let spsw_tmp_name  : [u8; 4] = "tmp\0"

  // Expected mode value on the assert path: S_IFREG (0o100000) |
  // 0o644 = 0o100644 = 0x81A4. Must match SYS_PDXFS_STAT_BY_INODE_
  // MODE_REG in sys_pdxfs_stat_by_inode.pdx.
  pub let PSPSI_EXPECTED_MODE : u64 = 0x81A4

  // Failure-path fingerprint tag. Locally scoped -- no other witness
  // needs it, and the text carries no standalone uppercase OK token
  // so verify-fingerprint-coverage.sh's OK_TOK extractor does not
  // gate on it. Byte count NUL-inclusive per #699 discipline: "boot
  // pdxfs stat fail" = 20 chars + NUL = 21.
  pub let spsw_fail_msg : [u8; 21] = "boot pdxfs stat fail\0"

  // ==========================================================================
  // witness_r90_xrepo_010_002_stat_by_inode() -> ()
  //
  // Five callee-save pushes (rbx, r12, r13, r14, r15) leave rsp%16
  // == 0 for every nested call (entry rsp%16 == 8, +40 -> 0), same
  // shape every sibling witness in this cascade takes.  Register
  // plan (all callee-save, survive every nested call by SysV):
  //   rbx = tmp_idx        (parent directory inode; survives across
  //                         tmpfs_create)
  //   r12 = new_idx        (freshly-created file inode; feeds
  //                         fingerprint as ino)
  //   r13 = seed_len       (== PSPSI_SEED_LEN; feeds tmpfs_write as
  //                         len and fingerprint as size)
  //   r14 = <spare>        (kept for symmetry with sibling witnesses)
  //   r15 = <spare>        (kept for symmetry with sibling witnesses)
  // ==========================================================================
  pub let witness_r90_xrepo_010_002_stat_by_inode : () -> () !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem},
      capabilities: {boot, cap},
      justification: "R90-XREPO.010.M1-002 (paideia-os #2110): boot witness for sys_pdxfs_stat_by_inode (sysno 106). See file header for the full 6-stage narrative + the scratch_fill-bypass rationale. Capabilities/effects are the union of every nested call's own row: tmpfs_lookup/tmpfs_create/tmpfs_write need {mem} + transitively {sysreg} via tmpfs_create's klog fingerprint; sys_pdxfs_stat_by_inode_scratch_fill needs {mem}; klog_s1_d1/klog_s1_d2 need {sysreg, mem}. 'boot' + 'cap' are added per this cascade's witness-function convention (matches r90_xrepo_010_pdxfs_read_bytes.pdx L186 verbatim). On any failure, the stage number is stamped into _spsw_stage first so the failure klog line names which sub-test tripped; failure falls through to the fail-emit funnel that emits `boot pdxfs stat fail line=<S>` via klog_s1_d1. Five callee-save pushes match every sibling witness's alignment discipline (entry rsp%16==8, +40==0 at every nested call site). Labels prefixed spsw_. Encoder-conservative: cmp/je/jne/jae/mov/lea/xor/push/pop/call/sub/add/ret only -- every form already proven at this exact shape in r90_xrepo_010_pdxfs_read_bytes.pdx + r90_xrepo_010_003_pdxfs_txn_lifecycle.pdx.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // ---------- Stage 1: recover /tmp inode index ----------
        mov rax, 1;
        lea rcx, [rip + _spsw_stage];
        mov [rcx], rax;
        mov rdi, 1;                      // root_idx = TMPFS_INODE_IDX_ROOT
        lea rsi, [rip + spsw_tmp_name];
        call tmpfs_lookup;
        cmp rax, 0;
        je  spsw_fail_stage;
        mov rbx, rax;                    // rbx = tmp_idx

        // ---------- Stage 2: create /tmp/statseed ----------
        mov rax, 2;
        lea rcx, [rip + _spsw_stage];
        mov [rcx], rax;
        mov rdi, rbx;                    // dir_idx = tmp_idx
        lea rsi, [rip + spsw_seed_name];
        mov rdx, 8;                      // name_len (matches "statseed")
        mov rcx, 1;                      // VNODE_TYPE_REG
        call tmpfs_create;
        cmp rax, 0;
        je  spsw_fail_stage;             // OOM or collision
        mov r10, 0xFFFF;
        cmp rax, r10;
        je  spsw_fail_stage;             // alloc-OOM sentinel
        mov r12, rax;                    // r12 = new_idx

        // ---------- Stage 3: seed the file with 16 bytes ----------
        mov rax, 3;
        lea rcx, [rip + _spsw_stage];
        mov [rcx], rax;
        // Populate _spsw_seed_buf with two copies of the pattern.
        mov r10, 0xCAFE211000000010;     // PSPSI_SEED_PATTERN
        lea r11, [rip + _spsw_seed_buf];
        mov [r11 + 0], r10;              // little-endian qword store
        mov [r11 + 8], r10;
        mov r13, 16;                     // r13 = seed_len (survives calls)

        mov rdi, r12;                    // inode_idx
        lea rsi, [rip + _spsw_seed_buf];
        mov rdx, r13;                    // len
        xor rcx, rcx;                    // offset = 0
        call tmpfs_write;
        cmp rax, r13;
        jne spsw_fail_stage;

        // ---------- Stage 4: fill kernel-side stat scratch ----------
        mov rax, 4;
        lea rcx, [rip + _spsw_stage];
        mov [rcx], rax;
        mov rdi, r12;                    // arg0 = inode_no
        call sys_pdxfs_stat_by_inode_scratch_fill;
        cmp rax, 0;
        jne spsw_fail_stage;             // -ENOENT here means the fill
                                         //   rejected our own freshly-
                                         //   created inode -- a
                                         //   regression in scratch_fill.

        // ---------- Stage 5: cross-check scratch fields ----------
        // Reload the scratch base once; every field cross-check is a
        // straight load-then-compare against a staged expected value.
        mov rax, 5;
        lea rcx, [rip + _spsw_stage];
        mov [rcx], rax;

        lea r11, [rip + _sys_pdxfs_stat_by_inode_out_scratch];

        // 5a. mode_bits (+0) == 0x81A4 (S_IFREG | 0o644)
        mov r10, [r11 + 0];
        mov r9, 0x81A4;                  // PSPSI_EXPECTED_MODE
        cmp r10, r9;
        jne spsw_fail_stage;

        // 5b. size_bytes (+8) == PSPSI_SEED_LEN (16)
        mov r10, [r11 + 8];
        cmp r10, r13;
        jne spsw_fail_stage;

        // 5c. mtime_ns (+16) == _tick_count * 10_000_000. This
        //     runs in boot_continue_after_ring3 BEFORE lapic_timer_
        //     init + sti (see kernel_main.pdx L1197/L1241), so
        //     _tick_count is 0 at witness time and mtime_ns must be
        //     0 too. A `> 0` assertion here would false-fire on
        //     every boot at the current placement. When a future
        //     landing moves this witness after sti (or seeds
        //     _tick_count from HPET pre-witness), the compute
        //     recovers a non-zero expected value automatically.
        //     Recompute expected value inline so witness stays
        //     correct regardless of when _tick_count first ticks.
        mov r10, [r11 + 16];             // observed mtime_ns
        mov r9, [rip + _tick_count];     // current tick_count
        mov r8, 10000000;                // SYS_PDXFS_STAT_BY_INODE_TICK_NS
        imul r9, r8;                     // expected mtime_ns
        cmp r10, r9;
        jne spsw_fail_stage;

        // 5d. ctime_ns (+24) == 0 (reserved field; must stay zero
        //     until a future landing populates it -- if this fires
        //     the layout has drifted from the record contract in
        //     sys_pdxfs_stat_by_inode.pdx §Output record).
        mov r10, [r11 + 24];
        cmp r10, 0;
        jne spsw_fail_stage;

        // ---------- Stage 6: emit success fingerprint ----------
        mov rax, 6;
        lea rcx, [rip + _spsw_stage];
        mov [rcx], rax;
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_boot_pdxfs_stat_ok];
        lea rcx, [rip + k_ino];
        mov r8, r12;                     // v1 = inode_no
        lea r9, [rip + k_size];
        sub rsp, 8;                      // pad (rsp%16: 0 -> 8)
        push r13;                        // v2 = seed_len (rsp%16: 8 -> 0)
        call klog_s1_d2;
        add rsp, 16;
        jmp spsw_done;

      spsw_fail_stage:
        // Fail funnel. Emits `boot pdxfs stat fail line=<S>` via
        // klog_s1_d1 with the stage number the failure tripped at.
        mov rdi, 1;                      // LEVEL_ERROR
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + spsw_fail_msg];
        lea rcx, [rip + k_line];
        lea rax, [rip + _spsw_stage];
        mov r8, [rax];
        call klog_s1_d1;

      spsw_done:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
