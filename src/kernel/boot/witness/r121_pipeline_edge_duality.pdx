// src/kernel/boot/witness/r121_pipeline_edge_duality.pdx -- R121.M4 (paideia-os #2498)
//
// Boot-time witness for KIND_PIPELINE_EDGE session-type duality (R121.M4).
// Exercises the three M4 refuse arms added to pipe_edge_bind_byrow:
//   (A) schema mismatch: mints PROD schema=0x121D + CONS schema=0x121C,
//       attempts bind, asserts PET_BIND_SCHEMA_MISMATCH.
//   (B) role conflict:   mints two PROD-role rows with schema=0x1220,
//       attempts bind, asserts PET_BIND_ROLE_CONFLICT.
//   (C) valid bind:      mints PROD schema=0x1221 + CONS schema=0x1221,
//       binds successfully (PE_OK), then verifies the buddy_edge_id
//       symmetry invariant via pet_row_read_buddy on both rows so the
//       success arm covers the buddy-symmetry positive check even
//       though the BUDDY_ASYMMETRIC refuse arm is only reachable when
//       a future caller stitches rows outside pipe_edge_bind_byrow.
//
// A separate M4 witness (rather than an in-place edit of the M2 witness)
// so the M2 pump/backpressure witness stays a focused benchmark of the
// SPSC transport, and the M4 duality-gate coverage is a distinct boot
// audit line the fingerprint-coverage tool can pin to `pipe bind
// rejected` (schema_mismatch + role_conflict arms fire once here each).
//
// M4 discipline:
//   * No cap-slot install (deferred to R121.M5 shell integration); the
//     witness exercises pipe_edge_bind_byrow directly.
//   * Every row minted is torn down on exit (success and every failure
//     arm) via pipeline_edge_free -- pool stays clean across a re-run.
//     No ring is created in stages A/B (bind refused pre-alloc); the
//     stage-C success creates one ring which is freed via pet_ring_free
//     after pet_row_read_ring_id snapshots its id.
//   * Two `pipe edge mint ok ...` fingerprints fire per stage (from
//     inside pipeline_edge_alloc, one per endpoint) -- the R121.M1
//     witness already made that path reachable so no coverage
//     allowlist churn.
//   * The `pipe bind rejected reason=<hex> ...` fingerprint fires
//     TWICE (once from stage A schema_mismatch, once from stage B
//     role_conflict). This witness is the sole gold-file coverage
//     source for the SCHEMA_MISMATCH and ROLE_CONFLICT arms; the
//     BUDDY_ASYMMETRIC arm is not exercised (would require poking a
//     row externally, which contradicts M4's in-band posture).
//   * The stage-C bind fires the M2 `pipe edge bind ok kind=<hex>
//     ring=<hex>` fingerprint via the shared pipe_edge_bind_byrow
//     success path.
//
// Stages recorded in _r121ped_stage before each step so a failure
// fingerprint carries a distinguishing line number:
//   1  pipeline_edge_alloc (stage-A PROD) refused
//   2  pipeline_edge_alloc (stage-A CONS) refused
//   3  stage-A bind did NOT refuse with SCHEMA_MISMATCH (unexpected result)
//   4  pipeline_edge_alloc (stage-B PROD #1) refused
//   5  pipeline_edge_alloc (stage-B PROD #2) refused
//   6  stage-B bind did NOT refuse with ROLE_CONFLICT (unexpected result)
//   7  pipeline_edge_alloc (stage-C PROD) refused
//   8  pipeline_edge_alloc (stage-C CONS) refused
//   9  stage-C bind did NOT succeed (unexpected refusal)
//  10  stage-C buddy_edge_id symmetry invariant broken (prod.buddy !=
//      cons.edge_id OR cons.buddy != prod.edge_id -- reachable only if
//      pipe_edge_bind_byrow's step-8 defensive verify has a bug of its
//      own that the arm nevertheless allowed to slip through)
//
// FINGERPRINT
//
// Success: `boot pipe duality ok -- kind=<hex> ring=<hex>` (klog_s1_x2).
// Failure: `boot pipe duality fail line=<n>` (klog_s1_d1), stage stamped
//          into _r121ped_stage before every step.
//
// ENCODER DISCIPLINE (mirror r121_pipeline_edge_transport.pdx):
//   No `test rN, rN`, no `add reg,[mem]`, no `cmp reg,[mem]`. Every
//   value staged through a register first. Every store is a qword
//   `mov [mem], reg`. Every label prefixed `r121ped_` (reserved-word
//   discipline -- `loop`/`if`/`top`/`done` are keywords; the `ped_`
//   root also avoids collision with the pet_ / pe_ prefixes used by
//   the transport substrate).

module R121PipelineEdgeDuality = structure {

  pub let mut _r121ped_stage : u64 = 0

  // Synthetic schema_ids -- non-zero u32 values distinguishable from
  // sibling waves (R121PE = 0x121E, R121PET = 0x121F). Chosen contiguous
  // to make origin obvious in a raw pool dump.
  pub let R121PED_SCHEMA_A_PROD : u64 = 0x121D
  pub let R121PED_SCHEMA_A_CONS : u64 = 0x121C
  pub let R121PED_SCHEMA_B      : u64 = 0x1220
  pub let R121PED_SCHEMA_C      : u64 = 0x1221

  pub let tag_boot_pipe_duality_ok : [u8; 24] = "boot pipe duality ok --\0"
  pub let r121ped_fail_msg         : [u8; 23] = "boot pipe duality fail\0"

  // ==========================================================================
  // witness_r121_pipeline_edge_duality() -> ()
  //
  // Six callee-save slots needed across stages (prod/cons rows across
  // three sequential stages, ring_id post-stage-C). Reuse pattern: rbx +
  // r12 hold "current stage's prod_row + cons_row"; freed and re-minted
  // between stages so only two rows are live at a time.
  //
  // Five callee-save pushes (rbx, r12-r15) leave rsp%16==0 for every
  // nested call (entry rsp%16==8, +40 -> %16==0). Register plan:
  //   rbx = current-stage prod_row (Stage A/B/C)
  //   r12 = current-stage cons_row (Stage A/B/C) OR second-PROD in B
  //   r13 = stage-C ring_id (for teardown)
  //   r14 = stage-C prod_edge_id (for buddy symmetry check)
  //   r15 = stage-C cons_edge_id (for buddy symmetry check)
  // ==========================================================================
  pub let witness_r121_pipeline_edge_duality : () -> () !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R121.M4 (paideia-os #2498): boot witness for the KIND_PIPELINE_EDGE session-type duality checker. Sequence: (Stage A: schema_mismatch) mint PROD (schema=0x121D) + CONS (schema=0x121C); attempt bind; expect PET_BIND_SCHEMA_MISMATCH (0xFFFFEBAF); tear both down. (Stage B: role_conflict) mint two PROD endpoints (schema=0x1220 on both); attempt bind; expect PET_BIND_ROLE_CONFLICT (0xFFFFEBAE); tear both down. (Stage C: valid) mint PROD + CONS (schema=0x1221 on both); attempt bind; expect PE_OK (0); read back both buddy_edge_ids via pet_row_read_buddy and assert prod.buddy == cons.edge_id AND cons.buddy == prod.edge_id; tear ring + both rows down. On success emit `boot pipe duality ok -- kind=<hex> ring=<hex>` via klog_s1_x2 (v2=ring_id pushed with sub rsp,8/push v2/call/add rsp,16 idiom, identical to r100_tls_trust.pdx). Failure funnel emits `boot pipe duality fail line=<stage>` via klog_s1_d1. Cleanup varies by stage: stage-A/B refusals leave two rows live (no ring), stage-C success leaves ring + two rows live (all torn down before emit). The M4 refuse fingerprints (`pipe bind rejected reason=1 prod_sid=<hex> cons_sid=<hex>` for Stage A; `pipe bind rejected reason=2 role_a=<hex> role_b=<hex>` for Stage B) fire from INSIDE pipe_edge_bind_byrow's M4 refuse arms, so this witness is the sole gold-file coverage source for those two emit paths. Five callee-save pushes (rbx=prod_row, r12=cons_row/second-PROD, r13=stage-C ring_id, r14=stage-C prod_edge_id, r15=stage-C cons_edge_id) leave rsp%16==0 at every nested call (entry rsp%16==8, +40 -> %16==0). Labels prefixed r121ped_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // ============================================================
        // Stage A: SCHEMA_MISMATCH refuse arm.
        // ============================================================

        // Stage 1: mint PROD (schema A_PROD).
        mov rax, 1;
        mov [rip + _r121ped_stage], rax;
        mov rdi, 0x121D;                  // R121PED_SCHEMA_A_PROD
        mov rsi, 0;                       // PE_ROLE_PROD
        mov rdx, 0x001;                   // R_PE_SEND
        call pipeline_edge_alloc;
        mov r10, 32;                      // PE_MAX
        cmp rax, r10;
        jae r121ped_fail;
        mov rbx, rax;                     // prod_row

        // Stage 2: mint CONS (schema A_CONS -- distinct from PROD).
        mov rax, 2;
        mov [rip + _r121ped_stage], rax;
        mov rdi, 0x121C;                  // R121PED_SCHEMA_A_CONS
        mov rsi, 1;                       // PE_ROLE_CONS
        mov rdx, 0x002;                   // R_PE_RECV
        call pipeline_edge_alloc;
        mov r10, 32;
        cmp rax, r10;
        jae r121ped_fail_cleanup_prod;
        mov r12, rax;                     // cons_row

        // Stage 3: bind must refuse with SCHEMA_MISMATCH.
        mov rax, 3;
        mov [rip + _r121ped_stage], rax;
        mov rdi, rbx;
        mov rsi, r12;
        call pipe_edge_bind_byrow;
        mov r10, 0xFFFFEBAF;              // PET_BIND_SCHEMA_MISMATCH
        cmp rax, r10;
        jne r121ped_fail_cleanup_both;

        // Stage A teardown: both rows live, no ring (bind refused pre-alloc).
        mov rdi, rbx;
        call pipeline_edge_free;
        mov rdi, r12;
        call pipeline_edge_free;

        // ============================================================
        // Stage B: ROLE_CONFLICT refuse arm.
        // ============================================================

        // Stage 4: mint first PROD (schema B).
        mov rax, 4;
        mov [rip + _r121ped_stage], rax;
        mov rdi, 0x1220;                  // R121PED_SCHEMA_B
        mov rsi, 0;                       // PE_ROLE_PROD
        mov rdx, 0x001;                   // R_PE_SEND
        call pipeline_edge_alloc;
        mov r10, 32;
        cmp rax, r10;
        jae r121ped_fail;
        mov rbx, rax;                     // first PROD row

        // Stage 5: mint second PROD (same schema, same role).
        mov rax, 5;
        mov [rip + _r121ped_stage], rax;
        mov rdi, 0x1220;
        mov rsi, 0;                       // PE_ROLE_PROD (again -- the conflict)
        mov rdx, 0x001;                   // R_PE_SEND
        call pipeline_edge_alloc;
        mov r10, 32;
        cmp rax, r10;
        jae r121ped_fail_cleanup_prod;
        mov r12, rax;                     // second PROD row

        // Stage 6: bind must refuse with ROLE_CONFLICT.
        mov rax, 6;
        mov [rip + _r121ped_stage], rax;
        mov rdi, rbx;
        mov rsi, r12;
        call pipe_edge_bind_byrow;
        mov r10, 0xFFFFEBAE;              // PET_BIND_ROLE_CONFLICT
        cmp rax, r10;
        jne r121ped_fail_cleanup_both;

        // Stage B teardown.
        mov rdi, rbx;
        call pipeline_edge_free;
        mov rdi, r12;
        call pipeline_edge_free;

        // ============================================================
        // Stage C: valid bind + buddy symmetry positive check.
        // ============================================================

        // Stage 7: mint PROD (schema C).
        mov rax, 7;
        mov [rip + _r121ped_stage], rax;
        mov rdi, 0x1221;                  // R121PED_SCHEMA_C
        mov rsi, 0;                       // PE_ROLE_PROD
        mov rdx, 0x001;                   // R_PE_SEND
        call pipeline_edge_alloc;
        mov r10, 32;
        cmp rax, r10;
        jae r121ped_fail;
        mov rbx, rax;                     // prod_row

        // Stage 8: mint CONS (same schema).
        mov rax, 8;
        mov [rip + _r121ped_stage], rax;
        mov rdi, 0x1221;
        mov rsi, 1;                       // PE_ROLE_CONS
        mov rdx, 0x002;                   // R_PE_RECV
        call pipeline_edge_alloc;
        mov r10, 32;
        cmp rax, r10;
        jae r121ped_fail_cleanup_prod;
        mov r12, rax;                     // cons_row

        // Stage 9: valid bind must succeed (PE_OK == 0).
        mov rax, 9;
        mov [rip + _r121ped_stage], rax;
        mov rdi, rbx;
        mov rsi, r12;
        call pipe_edge_bind_byrow;
        cmp rax, 0;                       // PE_OK
        jne r121ped_fail_cleanup_both;

        // Stage 10: buddy symmetry positive check. Snapshot both
        // edge_ids into r14/r15, then read back both buddy slots and
        // cross-check. This mirrors pipe_edge_bind_byrow's own step-8
        // defensive verify from the outside so the boot audit line
        // covers the symmetry invariant even for callers that trust
        // bind_byrow's own internal check.
        mov rax, 10;
        mov [rip + _r121ped_stage], rax;

        mov rdi, rbx;
        call pe_row_edge_id;
        mov r14, rax;                     // prod_edge_id
        mov rdi, r12;
        call pe_row_edge_id;
        mov r15, rax;                     // cons_edge_id

        mov rdi, rbx;
        call pet_row_read_buddy;
        cmp rax, r15;                     // expect cons_edge_id
        jne r121ped_fail_cleanup_bound;
        mov rdi, r12;
        call pet_row_read_buddy;
        cmp rax, r14;                     // expect prod_edge_id
        jne r121ped_fail_cleanup_bound;

        // Snapshot ring_id for the success emit + teardown.
        mov rdi, rbx;
        call pet_row_read_ring_id;
        mov r13, rax;                     // ring_id

        // Stage C teardown: free rows first, then ring.
        mov rdi, rbx;
        call pipeline_edge_free;
        mov rdi, r12;
        call pipeline_edge_free;
        mov r10, 16;                      // PET_RING_MAX
        cmp r13, r10;
        jae r121ped_emit_ok;
        mov rdi, r13;
        call pet_ring_free;

      r121ped_emit_ok:
        // Emit `boot pipe duality ok -- kind=<hex> ring=<hex>` via klog_s1_x2.
        // Entry: rsp%16==0 (five pushes on prologue). sub 8 -> %16==8.
        // push v2 -> %16==0.
        sub rsp, 8;
        mov rax, r13;                     // v2 = ring_id
        push rax;
        mov rdi, 3;                       // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_boot_pipe_duality_ok];
        lea rcx, [rip + k_kind];
        mov r8,  0x1F0;                   // KIND_PIPELINE_EDGE
        lea r9,  [rip + k_ring];
        call klog_s1_x2;
        add rsp, 16;

        jmp r121ped_out;

      // ============================================================
      // Failure funnels. Cleanup varies by stage.
      // ============================================================

      r121ped_fail_cleanup_bound:
        // Stage-C bound state: both rows live + bound. Recover ring_id
        // BEFORE freeing rows (pipeline_edge_free zeroes the row header
        // but does not touch _pet_row_ring_id; the mapping stays valid
        // until pet_row_write_ring_id or pet_init runs).
        mov rdi, rbx;
        call pet_row_read_ring_id;
        mov r13, rax;
        mov rdi, rbx;
        call pipeline_edge_free;
        mov rdi, r12;
        call pipeline_edge_free;
        mov r10, 16;
        cmp r13, r10;
        jae r121ped_fail;
        mov rdi, r13;
        call pet_ring_free;
        jmp r121ped_fail;

      r121ped_fail_cleanup_both:
        // Both rows live, no ring (bind refused pre-alloc, OR the
        // stage-C bind returned a non-zero non-taxonomy value).
        mov rdi, rbx;
        call pipeline_edge_free;
        mov rdi, r12;
        call pipeline_edge_free;
        jmp r121ped_fail;

      r121ped_fail_cleanup_prod:
        // Only first mint succeeded; second mint refused.
        mov rdi, rbx;
        call pipeline_edge_free;

      r121ped_fail:
        // Emit `boot pipe duality fail line=<stage>` via klog_s1_d1.
        mov rax, [rip + _r121ped_stage];
        mov rdi, 3;                       // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + r121ped_fail_msg];
        lea rcx, [rip + k_line];
        mov r8,  rax;                     // v = stage
        call klog_s1_d1;

      r121ped_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
