// src/kernel/boot/witness/r100_prep_003_icmp_echo.pdx --
// R100-PREP-003 (paideia-os #2009)
//
// Boot-time witness proving the sys_icmp_echo path end to end:
//
//   (1) Initialize an 8-byte payload with a deterministic recognizable
//       pattern (so a future addition of round-trip payload verification
//       has non-null bytes to compare).
//   (2) Call sys_icmp_echo_body directly (bypassing the dispatch shim,
//       so no capability check applies -- the body permits _current_tcb
//       == 0 as "kernel/boot context" per cap_check_r_net_privileged_
//       protocol's file header) with:
//         dst_addr_ptr = &_r100pep3_dst_loopback (bytes: 127, 0, 0, 1)
//         seq          = 1
//         payload_ptr  = &_r100pep3_payload
//         payload_len  = 8
//         timeout_ms   = 1000
//   (3) Assert rtt_ns >= 0 (always true for u64, but semantically we
//       reject an errno-shaped return: the OK path returns a small
//       positive integer; -EPERM/-EINVAL return 0xFFFFFFFF... which is
//       observably greater than 1_000_000_000 and thus fails the upper
//       bound check below).
//   (4) Assert rtt_ns <= 1_000_000_000 (1 second cap). Both HPET
//       readings straddle a kernel-internal ICMP send + (loopback) rx
//       chain that runs in far less than a second on any real hardware
//       or QEMU host; a value above 1 s indicates a broken hpet_now_ns
//       (0 return means HPET was not initialized -- in which case
//       t2==t1==0 and rtt_ns==0, which passes) or a run-away receive
//       loop.
//   (5) Emit fingerprint `boot icmp echo ok -- [legacy: BOOT ICMP ECHO
//       OK] rtt_ns=<n>` via klog_s1_d1 on success. On failure emit
//       `boot icmp echo skip -- reason=<code>`: reason=1 => rtt_ns >
//       1 s (probable HPET regression), reason=2 => rtt_ns encodes an
//       errno (return was 0xFFFFFFFF...). No skip=loopback_unavailable
//       is emitted here today because the icmp_send_echo_request
//       primitive routes 127.0.0.1 through the off-box ipv4_tx_send
//       path (no 127/8 short-circuit yet -- see the icmp.pdx header
//       comment on the loopback path); the ipv4_tx_send call returns
//       IPV4_E_ARP_PENDING(3) which the body deliberately ignores, so
//       the fingerprint still fires. When real 127.0.0.0/8 loopback
//       lands, the send primitive will demux dst[0]==127 into the
//       icmp_rx_handle synchronous fast path (mirroring the
//       _ipv4_my_ip byte-compare arm) and the rtt will drop by orders
//       of magnitude -- the assertion range in this witness holds
//       across both regimes.
//
// KLOG WRAPPER CHOICE: klog_s1_d1 (one decimal KV: rtt_ns) mirrors
// r89_tui_canvas's pattern for a single-metric fingerprint.
//
// PLACEMENT (kernel_main.pdx): after witness_r100_tls_trust in the
// R100-PREP witness block, before witness_r17_init_sched runs. This
// preserves the "network primitives before init spawns" ordering that
// witness_r72_tcp_echo already relies on -- and this witness reuses
// exactly the same ICMP primitives (icmp_send_echo_request +
// icmp_rx_handle) that witness_r72_tcp_echo does not touch, so ordering
// versus that witness does not matter.
//
// Reserved-label discipline: labels prefixed `r100pep3_` (R100-PREP-003).
// `loop`, `if` etc. are keywords and never used as labels.
//
// Frame prologue: manual push/pop (same as every other witness_r*.pdx).

module R100PrepIcmpEcho = structure {

  // 8-byte payload with a deterministic recognizable pattern (the same
  // shape r100_tls_trust.pdx uses for its key-material buffer, but at
  // a single-qword scale). Aligned @8 so a future addition of qword
  // load/compare has natural alignment.
  pub let mut _r100pep3_payload      : [u8; 8] = uninit @align(8)

  // 4-byte IPv4 destination: 127.0.0.1 (loopback per RFC 1122). At
  // this landing icmp_send_echo_request's loopback demux compares only
  // against _ipv4_my_ip, so this address routes through the off-box
  // path (bumping counters + attempting an ARP lookup that misses --
  // and the send primitive absorbs that miss silently). When real
  // 127/8 loopback lands, this same buffer routes through the
  // synchronous icmp_rx_handle path with no witness edit needed.
  pub let mut _r100pep3_dst_loopback : [u8; 4] = uninit @align(8)

  // Success and skip fingerprint tags. tag_boot_icmp_echo_ok is
  // declared in core/klog/keys.pdx (see the R100-PREP-003 block there
  // for the fingerprint contract + byte-count reasoning); the skip tag
  // is local because no other witness needs it. No OK token in the
  // skip text so verify-fingerprint-coverage.sh's OK_TOK extractor
  // does not require golden coverage or an allowlist entry for it.
  pub let r100pep3_skip_msg     : [u8; 21] = "boot icmp echo skip \0"
  pub let r100pep3_k_reason     : [u8;  7] = "reason\0"

  // Upper bound for a plausible rtt on a loopback / near-loopback
  // path: 1 second (10^9 ns). See file header §"Assert rtt_ns <=".
  pub let R100PEP3_RTT_MAX_NS : u64 = 1000000000

  // witness_r100_prep_003_icmp_echo() -> ()
  //
  // Register plan (5 callee-save pushes leave rsp%16==0 for every
  // nested call from entry rsp%16==8 -- matches every sibling witness
  // in this cascade):
  //   rbx = rtt_ns (raw sys_icmp_echo_body return, live through the
  //         validation + fingerprint calls -- callee-save survives
  //         klog_s1_d1's caller-save clobber set).
  //   r12..r15 unused today; reserved for future assertion state.
  pub let witness_r100_prep_003_icmp_echo : () -> () !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R100-PREP-003 (paideia-os #2009): boot witness for sys_icmp_echo. Five callee-save pushes leave rsp%16==0 for every nested call (entry rsp%16==8, +40 -> %16==0), matching every sibling witness in this cascade (r89_tui_canvas / r100_tls_trust). Stage 1: initialize _r100pep3_payload with the qword pattern 0xDEADBEEFCAFEBABE (single mov; the exact value is diagnostic, only its non-zero-ness matters -- so a future addition of round-trip payload verification has a distinctive pattern to compare). Stage 2: initialize _r100pep3_dst_loopback with the 4 bytes 127, 0, 0, 1 in canonical wire order via four mov_b stores (BE for the octet stream, matching every other IPv4 address literal in the tree). Stage 3: call sys_icmp_echo_body(dst_addr_ptr, seq=1, payload_ptr, payload_len=8, timeout_ms=1000). This bypasses the dispatch shim so the cap gate sees _current_tcb; in boot context _current_tcb is 0 (see cap_net_privileged.pdx's Arm 1 rationale), so the gate passes. rax = rtt_ns on success (small positive integer, typically < 10^6 ns for the loopback path) or -EPERM/-EINVAL (large u64 with bit 63 set) on failure. Save rax into rbx. Stage 4: validate rtt_ns range. rbx > R100PEP3_RTT_MAX_NS (10^9) -> skip with reason=1 (either an errno-shaped return, which encodes as huge u64, OR a broken HPET reading -- both are single-code failures for this witness's purposes). Stage 5: emit `boot icmp echo ok -- [legacy: BOOT ICMP ECHO OK] rtt_ns=<n>` via klog_s1_d1(LEVEL_INFO=3, SUBSYS_BOOT, tag_boot_icmp_echo_ok, k_rtt_ns, rbx). Failure funnel emits `boot icmp echo skip -- reason=<code>` via klog_s1_d1 with k_reason. Effects/capabilities: {sysreg,mem}@{boot,cap} matches every network-touching witness in this cascade. Encoder-conservative: cmp/jbe/ja/mov/mov_b/lea/xor/push/pop/call/ret only. Labels prefixed r100pep3_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // ---------- Stage 1: initialize payload ----------
        lea r12, [rip + _r100pep3_payload];
        mov rax, 0xDEADBEEFCAFEBABE;
        mov [r12 + 0], rax;

        // ---------- Stage 2: initialize dst = 127.0.0.1 ----------
        lea r12, [rip + _r100pep3_dst_loopback];
        mov rax, 127;
        mov_b [r12 + 0], rax;
        xor rax, rax;
        mov_b [r12 + 1], rax;
        mov_b [r12 + 2], rax;
        mov rax, 1;
        mov_b [r12 + 3], rax;

        // ---------- Stage 3: call sys_icmp_echo_body ----------
        lea rdi, [rip + _r100pep3_dst_loopback];   // dst_addr_ptr
        mov rsi, 1;                                // seq
        lea rdx, [rip + _r100pep3_payload];        // payload_ptr
        mov rcx, 8;                                // payload_len
        mov r8,  1000;                             // timeout_ms
        call sys_icmp_echo_body;
        mov rbx, rax;                              // rbx = rtt_ns (or errno-shaped u64)

        // ---------- Stage 4: validate rtt_ns range ----------
        mov rax, 1000000000;                       // R100PEP3_RTT_MAX_NS = 10^9
        cmp rbx, rax;
        ja  r100pep3_skip;

        // ---------- Stage 5: emit success fingerprint ----------
        mov rdi, 3;                                // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_boot_icmp_echo_ok];
        lea rcx, [rip + k_rtt_ns];
        mov r8,  rbx;                              // v1 = rtt_ns
        call klog_s1_d1;
        jmp r100pep3_done;

      r100pep3_skip:
        // Skip path: rtt_ns > 1 s means either errno-shaped return or
        // broken HPET reading. reason=1 covers both classes today; a
        // future refinement can split them (e.g. by testing the sign
        // bit of rbx and emitting reason=2 for the errno arm).
        mov rdi, 3;                                // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + r100pep3_skip_msg];
        lea rcx, [rip + r100pep3_k_reason];
        mov r8,  1;                                // reason=1
        call klog_s1_d1;

      r100pep3_done:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
