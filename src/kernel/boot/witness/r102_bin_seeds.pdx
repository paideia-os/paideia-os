// src/kernel/boot/witness/r102_bin_seeds.pdx — R102.MON-003 skeleton
//
// R102.MON-003 (paideia-os #2210) owns the six new /bin/<name> tmpfs
// seed rows and the six matching `.incbin` lines in tools/userbin_
// embed.S for the six graphical satellite apps: svc-compositor, svc-wm,
// pdxterm, pdxclock, pdxwatch, pdxpaint. The three graphical
// LIBRARIES (libpdx-font, libpdx-gfx, libpdx-event) are NOT embedded
// as /bin entries -- they link into the apps at their own repos'
// build-time, matching the R64v2 satellite-tool posture (libpdx-audit,
// libpdx-volume, libpdx-elevate are lib-only, mkfs.pdxfs / mount.pdxfs
// / umount.pdxfs are the /bin-embedded apps).
//
// -----------------------------------------------------------------------------
// Why the six .incbin + six seed stanzas are NOT in this landing
// -----------------------------------------------------------------------------
//
// A `.incbin "build/user/svc-compositor.elf"` line demands that
// build/user/svc-compositor.elf exist by the time tools/build.sh
// invokes `as` on tools/userbin_embed.S. That ELF exists only when
// R102.MON-002's r102-tools stage successfully invokes svc-compositor's
// own tools/build.sh and copies the resulting ELF into build/user/.
// svc-compositor's tools/build.sh does not exist -- the repo is a bare
// scaffold on GitHub (LICENSE + README.md only, no src/, no caps.decl,
// no build script). Every one of the nine R102 satellite repos is in
// the same state.
//
// Landing the six `.incbin` lines now would hard-fail every build
// with a `as: no such file: build/user/svc-compositor.elf` line
// before any downstream witness runs. Landing the six seed stanzas
// (which reference `_svc_compositor_bin_start` / `_end` symbols) would
// hard-fail the kernel link with undefined-reference errors on those
// six pairs of symbols.
//
// This module therefore ships a SKELETON witness that fires on every
// boot and emits ONE lowercase skip fingerprint documenting the
// reason. When the satellite ELFs start being embedded (a follow-up
// MON-003 hoist per the r102-closure retrospective), this witness's
// body is retired and the real seed cascade moves into
// `src/kernel/boot/witness/bin_seeds.pdx` alongside the existing
// child_hello / sh / true / elevate_broker_daemon / ls / cat / ...
// seed stanzas, structurally mirroring bs_ls_seed line-for-line for
// each of the six R102 apps.
//
// -----------------------------------------------------------------------------
// Reserved userbin symbol names (documented here for the future hoist)
// -----------------------------------------------------------------------------
//
//   _svc_compositor_bin_start / _svc_compositor_bin_end
//   _svc_wm_bin_start         / _svc_wm_bin_end
//   _pdxterm_bin_start        / _pdxterm_bin_end
//   _pdxclock_bin_start       / _pdxclock_bin_end
//   _pdxwatch_bin_start       / _pdxwatch_bin_end
//   _pdxpaint_bin_start       / _pdxpaint_bin_end
//
// Matching /bin paths:
//
//   /bin/svc-compositor  len=15
//   /bin/svc-wm          len=9
//   /bin/pdxterm         len=11
//   /bin/pdxclock        len=12
//   /bin/pdxwatch        len=12
//   /bin/pdxpaint        len=12
//
// -----------------------------------------------------------------------------
// Fingerprint
// -----------------------------------------------------------------------------
//
//   Skeleton (this landing):
//     "boot r102 bin seeds skip reason=no-elf"
//   Future (once the six ELFs are embedded and the six seeds fire):
//     "boot r102 bin seeds ok"        (per r102-user-plan.md §4.10 MON-003)
//
// Encoder discipline: same as r102_first_pixel.pdx.

module R102BinSeeds = structure {

  // 39 bytes including NUL.
  pub let tag_r102_bin_seeds_skip : [u8; 39] =
    "boot r102 bin seeds skip reason=no-elf\0"

  pub let witness_r102_bin_seeds : () -> () !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R102.MON-003 skeleton (paideia-os #2210). Emits the ONE-line lowercase skip fingerprint `boot r102 bin seeds skip reason=no-elf` on every boot. Owns the six /bin/<name> tmpfs seed rows and the six .incbin lines that will eventually embed svc-compositor, svc-wm, pdxterm, pdxclock, pdxwatch, pdxpaint into the boot image; neither the `.incbin` targets nor the seed-referenced userbin symbols exist as of the R102 MON- wave (all nine satellite repos are LICENSE+README-only scaffolds on github.com/paideia-os). Landing either the six .incbin lines or the six seed stanzas now would hard-fail the build; kept as this pure klog_s1 skeleton until the R102-M1 wave lands per-repo scaffold code and the r102-tools stage of tools/build.sh (MON-002) starts copying ELFs into build/user/. push rbp / pop rbp preserves the caller's rsp%16 parity and rbp guarantee across the nested klog_s1 call.",
      block: {
        push rbp;

        mov rdi, 3;                              // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_r102_bin_seeds_skip];
        call klog_s1;

        pop rbp;
        ret
      }
    }
}
