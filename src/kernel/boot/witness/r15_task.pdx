// src/kernel/boot/witness/r15_task.pdx — boot witness module
//
// Extracted verbatim from src/kernel/boot/kernel_main.pdx (which had grown
// to 24,315 lines in two functions).  R15 task/process witness block — fd_table, task_free, task-pool bounds, task_new, sys_exit, sys_wait, sys_execve, orphan_adopt, sys_fork.
//
// -----------------------------------------------------------------------------
// Why the body is copied and not rewritten
// -----------------------------------------------------------------------------
//
// The goldens for this tree assert an ORDERED SUBSEQUENCE of fingerprints
// across 14 boot modes, and a witness that silently stops running still
// leaves most of that subsequence intact.  The extraction therefore moves
// the instruction stream unchanged: the only bytes this module adds around
// it are the `push rbp` / `pop rbp` / `ret` below.
//
// -----------------------------------------------------------------------------
// The push is not decoration
// -----------------------------------------------------------------------------
//
// `boot_continue_after_ring3` runs its body at `rsp % 16 == 8` — it sits two `call` levels
// below `_start`, and paideia-as emits no frame prologue for an
// `unsafe`-bodied lambda (emit_visit_lambda.rs suppresses the prologue for
// Unsafe bodies, which is also why `@no_frame` is a no-op there).  Several
// witnesses in this file reason explicitly about that parity — "3 pushes from %16==8
// yields (8+3*8)%16 == 0" — and a bare `call` into a bare body would enter
// at `%16 == 0` and invert every one of those arguments.  The single
// `push rbp` restores the inline parity exactly; the matching `pop rbp`
// keeps rbp's SysV guarantee for the caller.
//
// Sections in this module, in the order boot_continue_after_ring3 ran them:
//   * R15-M5-007 (#549): fd_table witness — three one-liners.
//   * R15-M5-008 (#550): task_free witness — 100-iter round-trip
//   * R31.M2-1594 (#1594): THE POOL CONTAINS EVERY SLAB THE CEILING
//   * R15-M5-006 (#548): task_new witness — single-call construction
//   * R15-M6-006 (#557) + R17-M0-724-D5b (#724): sys_exit witness — 2 sub-tests, 1 marker
//   * R15-M6-005 (#556): sys_wait witness — 3 sub-tests, 1 marker
//   * R15-M6-004 (#555): sys_execve witness — 2 sub-tests, 1 marker
//   * R15-M6-007 (#558): orphan_adopt witness — 3-gen cascade, 1 marker
//   * R15-M6-003 (#554) + R17-M0-724-D6 (#724): sys_fork witness — testable happy path
//   * #724-D6: sys_fork_body now materializes child regs_save and calls

module R15Task = structure {

  // witness_r15_task() — the R15 task/process witness block — fd_table, task_free, task-pool bounds, task_new, sys_exit, sys_wait, sys_execve, orphan_adopt, sys_fork.
  //
  // Effect and capability rows are the ones the enclosing
  // `boot_continue_after_ring3` declares.  They are not widened here: this
  // is the same instruction stream under a new symbol, so the authority it
  // needs is by construction the authority it already had.
  pub let witness_r15_task : () -> () !{sysreg} @{} = fn () -> unsafe {
    effects: { sysreg },
    capabilities: { boot },
    justification: "Boot witness block lifted verbatim out of kernel_main.pdx's boot_continue_after_ring3 during the r15_task extraction. Body bytes are unchanged from the inline form; the only additions are the entry `push rbp` and the exit `pop rbp; ret`. The push is load-bearing rather than cosmetic: boot_continue_after_ring3 executes its body at rsp%16 == 8 (two `call` levels below _start, with no frame prologue emitted for unsafe-bodied lambdas), and the witnesses inside this module compute their own nested-call alignment from that parity. Entering through a `call` without the compensating push would present rsp%16 == 0 to the body and silently invert every such argument — the failure mode of paideia-os #1192, #1195 and #1584. Effects and capabilities are copied unchanged from the enclosing function for the same reason: no authority is added, so none needs justifying beyond what boot_continue_after_ring3 already justified.",
    block: {
      push rbp;

      // ============================================================
      // R15-M5-007 (#549): fd_table witness — three one-liners.
      // ============================================================

      // Zero the witness task (uninit .bss is zero on ELF load, but be explicit).
      lea rdi, [rip + _fd_witness_task];

      // --- (1) fd_alloc should return 3 on a fresh task ---
      call fd_alloc;
      cmp  rax, 3;
      jne  fd_witness_fail;

      // --- (2) fd_set(t, 5, 0xDEADBEEFCAFEBABE) then fd_get(t, 5) round-trip ---
      lea rdi, [rip + _fd_witness_task];
      mov rsi, 5;
      mov rdx, 0xDEADBEEFCAFEBABE;
      call fd_set;

      lea rdi, [rip + _fd_witness_task];
      mov rsi, 5;
      call fd_get;
      mov rcx, 0xDEADBEEFCAFEBABE;
      cmp rax, rcx;
      jne fd_witness_fail;

      // --- (3) fd_alloc after fd_set(5, x) still returns 3 (first hole is 3) ---
      lea rdi, [rip + _fd_witness_task];
      call fd_alloc;
      cmp rax, 3;
      jne fd_witness_fail;

      // --- (4) fd_set(t, 3, x) → fd_alloc returns 4 (first free slot moved up) ---
      lea rdi, [rip + _fd_witness_task];
      mov rsi, 3;
      mov rdx, 0x1;                                // non-zero → allocated marker
      call fd_set;

      lea rdi, [rip + _fd_witness_task];
      call fd_alloc;
      cmp rax, 4;
      jne fd_witness_fail;

      // --- All four checks passed. Emit marker. ---
      mov rdi, 3;
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + fd_witness_ok_msg];
      call klog_s1;
      jmp  fd_witness_done;

      fd_witness_fail:
      mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + fd_witness_fail_msg];
      call klog_s1;

      fd_witness_done:

      // ============================================================
      // R15-M5-008 (#550): task_free witness — 100-iter round-trip
      // ============================================================
      xor r15, r15;                        // counter
      call phys_alloc_free_count;
      mov r14, rax;                        // free_count snapshot

task_free_witness_loop:
      cmp r15, 100;
      jae task_free_witness_pool_check;    // explicit exit — H1 guard

      xor rdi, rdi;                        // parent = NULL (init)
      call task_new;
      cmp rax, 0;
      je task_free_witness_fail;
      mov r12, rax;

      // assert pid == 1
      mov eax, [r12 + 0];
      cmp eax, 1;
      jne task_free_witness_fail;

      // free
      mov rdi, r12;
      call task_free;

      // post: pid_table[1] == NULL
      lea rax, [rip + _pid_table];
      mov rcx, [rax + 8];
      cmp rcx, 0;
      jne task_free_witness_fail;

      // post: slab zeroed (probe pml4 slot at +16)
      mov rcx, [r12 + 16];
      cmp rcx, 0;
      jne task_free_witness_fail;

      add r15, 1;                          // increment — H1 guard
      jmp task_free_witness_loop;

task_free_witness_pool_check:
      call phys_alloc_free_count;
      cmp rax, r14;
      jne task_free_witness_fail;

      mov rdi, 3;
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + task_free_witness_ok_msg];
      call klog_s1;
      jmp task_free_witness_exit;

task_free_witness_fail:
      mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + task_free_witness_fail_msg];
      call klog_s1;

task_free_witness_exit:                   // UNIQUE label — H3 guard

      // ============================================================
      // R31.M2-1594 (#1594): THE POOL CONTAINS EVERY SLAB THE CEILING
      // CAN NAME.
      //
      // Body in tests/kernel/sched/task_pool_bounds.pdx.
      //
      // What it establishes, in one line: task_new can construct a task
      // at EVERY pid pid_alloc is willing to hand out, and none of those
      // constructions reaches a byte outside _task_pool.
      //
      // Why it is here at all. `_task_pool` was `[u64; 17792]` — 64 *
      // 2224, the STRUCT size — while task_new strides 4096, the SLOT
      // size. The array held 34.75 slots and pid_alloc hands out 63, so
      // every pid from 36 up wrote a complete task_struct past the end
      // of the array, into `_task_kernel_stacks`. Roughly 23 boot
      // witnesses and a 14-mode smoke matrix never saw it because the
      // boot path uses four pids. NOTHING IN THE TREE HAD EVER ASKED FOR
      // A THIRTY-SIXTH, and a bound that only the untravelled part of
      // the range violates cannot be found by travelling the ordinary
      // part. The fixture drives the range deliberately.
      //
      // PLACEMENT HERE IS CHOSEN AND MATTERS. It sits between the
      // task_free witness and the task_new witness because that is the
      // one point where the pid table is provably empty: task_free's
      // witness has just run 100 task_new/task_free round trips and
      // asserted _pid_table[1] came back to 0 and the physical free
      // count returned to its snapshot. Sub-test E needs a nearly-empty
      // table to force an allocation at PID_MAX, and it restores exactly
      // the entries it forced, so the task_new witness that follows
      // still sees pid 1 handed out first — which it asserts.
      //
      // Fingerprint ordering:
      //   R15 TASK FREE OK
      //   R31 TASK POOL BOUNDS OK   <- THIS WITNESS
      //   R15 TASK NEW OK
      // ============================================================
      task_pool_bounds_witness_call:
          call task_pool_bounds_witness

      // ============================================================
      // R15-M5-006 (#548): task_new witness — single-call construction
      // ============================================================

      // task_new(NULL) — construct init.
      xor rdi, rdi;                              // parent = NULL sentinel
      call task_new;
      cmp rax, 0;
      je  task_new_witness_fail;                 // 0 = OOM = bug at boot

      mov r12, rax;                              // r12 = task_struct*

      // Check 1: pid == 1
      mov eax, [r12 + 0];                        // pid @ 0 (u32)
      cmp eax, 1;
      jne task_new_witness_fail;

      // Check 2: parent_pid == 0
      mov eax, [r12 + 4];                        // parent_pid @ 4 (u32)
      cmp eax, 0;
      jne task_new_witness_fail;

      // Check 3: state == STATE_NEW (0)
      mov eax, [r12 + 8];                        // state @ 8 (u32)
      cmp eax, 0;
      jne task_new_witness_fail;

      // Check 4: user_pml4_pa != 0
      mov rax, [r12 + 16];                       // user_pml4_pa @ 16 (u64)
      cmp rax, 0;
      je  task_new_witness_fail;

      // Check 5: pid_table[1] == r12
      lea rax, [rip + _pid_table];
      mov rcx, [rax + 8];                        // pid_table[1] (index 1 * 8 = 8)
      cmp rcx, r12;
      jne task_new_witness_fail;

      // All checks green
      mov rdi, 3;
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + task_new_witness_ok_msg];
      call klog_s1;
      jmp task_new_witness_exit;

      task_new_witness_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + task_new_witness_fail_msg];
          call klog_s1;

      task_new_witness_exit:

      // R15-M5-009 (#551): 3-task pool witness. Verify pid_alloc advances
      // densely (1→2→3), each task_new succeeds (slab != 0), and
      // pid_table publishes correctly at indices 2, 3.
      // Precondition: r12 = slab_1 from #548 witness (or 0 if task 1 failed).
      // Register use: r12=slab_1, r13=slab_2, r14=slab_3 (all callee-saved across task_new).

      pool_witness:
          // Step 1: guard — bail if task 1 witness failed (r12 = 0)
          cmp r12, 0;
          je pool_witness_fail;

          // Step 2: construct task 2 → verify pid == 2 → save slab in r13
          xor rdi, rdi;                         // parent = NULL
          call task_new;
          cmp rax, 0;
          je pool_witness_fail;
          mov r13, rax;                         // r13 = slab_2
          mov eax, [r13 + 0];                   // pid @ offset 0 (u32)
          cmp eax, 2;
          jne pool_witness_fail;

          // Step 3: construct task 3 → verify pid == 3 → save slab in r14
          xor rdi, rdi;
          call task_new;
          cmp rax, 0;
          je pool_witness_fail;
          mov r14, rax;                         // r14 = slab_3
          mov eax, [r14 + 0];                   // pid @ offset 0 (u32)
          cmp eax, 3;
          jne pool_witness_fail;

          // Step 4: publish check — pid_table[2] == r13, pid_table[3] == r14
          lea rax, [rip + _pid_table];
          mov rcx, [rax + 16];                  // pid_table[2] @ index 2*8 = 16
          cmp rcx, r13;
          jne pool_witness_fail;
          mov rcx, [rax + 24];                  // pid_table[3] @ index 3*8 = 24
          cmp rcx, r14;
          jne pool_witness_fail;

          // All checks green
          mov rdi, 3;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + pool_witness_ok_msg];
          call klog_s1;
          jmp pool_witness_exit;

      pool_witness_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + pool_witness_fail_msg];
          call klog_s1;

      pool_witness_exit:

      // ============================================================
      // R15-M6-006 (#557) + R17-M0-724-D5b (#724): sys_exit witness — 2 sub-tests, 1 marker
      // ============================================================
      sys_exit_witness:
          // #724 D5b precondition: sys_exit_body's step 6.5 now calls
          // runq_enqueue(parent) on the wake path. That requires the
          // runqueue sentinel to be initialized (else the writes into
          // head.prev + 432 fault). Call runq_init here — idempotent
          // per runqueue.pdx §runq_init "safe to re-call", so the real
          // runq_init at kernel_main.pdx:6317 (scheduler bootstrap)
          // still succeeds. Mirrors the pattern in sys_fork_witness
          // (kernel_main.pdx:2375) for #724 D6's own runq_enqueue.
          call runq_init;

          // ---------- Sub-test 1: non-WAITING parent, no reap ----------
          // parent = task_new(NULL)
          xor rdi, rdi;
          call task_new;
          cmp rax, 0;
          je  sys_exit_witness_fail;
          mov r12, rax;                                // r12 = parent (pid 4)

          // child = task_new(parent)
          mov rdi, r12;
          call task_new;
          cmp rax, 0;
          je  sys_exit_witness_fail;
          mov r13, rax;                                // r13 = child (pid 5)

          // Set child->state = STATE_RUNNABLE (1) — simulate running
          // Not strictly required (NEW→ZOMBIE is a legal transition
          // per §3.4 — task_new default), but documents intent.
          mov rax, 1;
          mov [r13 + 8], eax;                          // child->state = RUNNABLE

          // sys_exit_body(child, 42)
          mov rdi, r13;
          mov rsi, 42;
          call sys_exit_body;

          // Assert: child->state == STATE_ZOMBIE (3)
          mov eax, [r13 + 8];
          cmp rax, 3;
          jne sys_exit_witness_fail;

          // Assert: child->exit_status == 42
          mov eax, [r13 + 12];
          cmp rax, 42;
          jne sys_exit_witness_fail;

          // Assert: parent->state unchanged (NEW = 0)
          mov eax, [r12 + 8];
          cmp rax, 0;
          jne sys_exit_witness_fail;

          // Assert: parent->wait_result_pid unchanged (0)
          mov eax, [r12 + 1704];
          cmp rax, 0;
          jne sys_exit_witness_fail;

          // ---------- Sub-test 2: WAITING parent, reap wakeup ----------
          // parent2 = task_new(NULL)
          xor rdi, rdi;
          call task_new;
          cmp rax, 0;
          je  sys_exit_witness_fail;
          mov r12, rax;                                // r12 = parent2 (pid 6)

          // Set parent2->state = STATE_WAITING (2) — simulate parked in sys_wait
          mov rax, 2;
          mov [r12 + 8], eax;

          // child2 = task_new(parent2)
          mov rdi, r12;
          call task_new;
          cmp rax, 0;
          je  sys_exit_witness_fail;
          mov r13, rax;                                // r13 = child2 (pid 7)

          // sys_exit_body(child2, 99)
          mov rdi, r13;
          mov rsi, 99;
          call sys_exit_body;

          // Assert: child2->state == STATE_ZOMBIE
          mov eax, [r13 + 8];
          cmp rax, 3;
          jne sys_exit_witness_fail;

          // Assert: child2->exit_status == 99
          mov eax, [r13 + 12];
          cmp rax, 99;
          jne sys_exit_witness_fail;

          // Assert: parent2->state == STATE_RUNNABLE (1) — was 2, wakeup transition
          mov eax, [r12 + 8];
          cmp rax, 1;
          jne sys_exit_witness_fail;

          // Assert: parent2->wait_result_pid == child2->pid (7)
          mov eax, [r13 + 0];                          // child2->pid
          mov ecx, [r12 + 1704];                       // parent2->wait_result_pid
          cmp rax, rcx;
          jne sys_exit_witness_fail;

          // Assert: parent2->wait_result_status == 99
          mov eax, [r12 + 1708];
          cmp rax, 99;
          jne sys_exit_witness_fail;

          // #724 D5b assertion (rewired for #773): parent2 is now on the
          // runqueue.  Post-#773 the runqueue lives at PERCPU_OFF_RUNQUEUE_HEAD
          // (+32) in this CPU's Percpu CB (no more `_runq_head_slot`
          // sentinel).  Single-element enqueue leaves CB.head == parent2, so
          // we deref [gs:32] (via rdmsr IA32_GS_BASE + [rax+32]) and compare.
          mov rcx, 0xC0000101;
          rdmsr;
          shl rdx, 32;
          or  rax, rdx;
          mov rcx, [rax + 32];                          // CB.runqueue_head
          cmp rcx, r12;
          jne sys_exit_witness_fail;

          // ---------- Cleanup: dequeue parent2, then retire it (#562 fix) ----------
          // Two-part cleanup:
          // (1) runq_dequeue(parent2) — parent2 was placed on the runqueue
          //     by sys_exit_body's D5b step 6.5. Left dangling, it would
          //     survive across the real runq_init call at kernel_main.pdx:6317
          //     (which just re-writes the head sentinel; existing dangling
          //     next/prev pointers are orphaned but harmless). Explicit
          //     dequeue keeps the witness's contract crisp — we started
          //     empty (via the runq_init at the top of this witness), we
          //     end empty. Mirrors sys_fork_witness's cleanup at
          //     kernel_main.pdx:2516.
          mov rdi, r12;
          call runq_dequeue;

          // (2) Retire parent2 to STATE_ZOMBIE (3) so idle_witness's
          //     pick_next sub-test (#562) doesn't stop on it. See original
          //     comment: parent2 exists solely to demonstrate the
          //     WAITING->RUNNABLE wakeup transition above; without this
          //     retirement, the pick_next linear scan of _pid_table stops
          //     on parent2's slot (state RUNNABLE) instead of falling
          //     through to _idle_tcb, and the idle witness spuriously fails.
          mov rax, 3;                                   // STATE_ZOMBIE
          mov [r12 + 8], eax;                           // parent2->state = STATE_ZOMBIE

          // ---------- All checks green ----------
          mov rdi, 3;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + sys_exit_witness_ok_msg];
          call klog_s1;
          jmp sys_exit_witness_exit;

      sys_exit_witness_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + sys_exit_witness_fail_msg];
          call klog_s1;

      sys_exit_witness_exit:

      // ============================================================
      // R15-M6-005 (#556): sys_wait witness — 3 sub-tests, 1 marker
      // ============================================================
      sys_wait_witness:
          // ---------- Sub-test A: zombie found, reap ----------
          // parent_a = task_new(NULL)
          xor rdi, rdi;
          call task_new;
          cmp rax, 0;
          je  sys_wait_witness_fail;
          mov r12, rax;                                // r12 = parent_a (pid 8)

          // child_a = task_new(parent_a)
          mov rdi, r12;
          call task_new;
          cmp rax, 0;
          je  sys_wait_witness_fail;
          mov r13, rax;                                // r13 = child_a (pid 9)

          // Manually mark child_a as ZOMBIE with exit_status = 42
          mov rax, 3;                                  // STATE_ZOMBIE
          mov [r13 + 8], eax;
          mov rax, 42;
          mov [r13 + 12], eax;                         // exit_status = 42

          // sys_wait_body(parent_a)
          mov rdi, r12;
          call sys_wait_body;

          // Assert: rax == child_a->pid (9)
          // NOTE: `and rcx, 0xFFFFFFFF` after a 64-bit load is a no-op on
          // x86-64 — AND r64, imm32 sign-extends 0xFFFFFFFF (== -1 as i32)
          // to 0xFFFFFFFFFFFFFFFF, an identity mask, not a truncation mask.
          // Use a genuine zero-extending 32-bit load instead (mov ecx, ...
          // zero-extends the upper 32 bits of rcx per x86-64 semantics).
          mov ecx, [r13 + 0];                          // child_a->pid (u32, zero-ext)
          cmp rax, rcx;
          jne sys_wait_witness_fail;

          // Assert: rdx == 42
          cmp rdx, 42;
          jne sys_wait_witness_fail;

          // Assert: _pid_table[child_a->pid] == 0 (child slot reaped)
          // NOTE: use the actual pid (still in rcx from the check above,
          // dynamic SIB index) rather than a hardcoded slot literal — see
          // the sub-test B note below for why a literal is fragile here.
          lea rax, [rip + _pid_table];
          mov rax, [rax + rcx*8];
          cmp rax, 0;
          jne sys_wait_witness_fail;

          // Assert: parent_a->state unchanged (NEW = 0)
          mov eax, [r12 + 8];
          cmp rax, 0;
          jne sys_wait_witness_fail;

          // ---------- Sub-test B: no zombie, block ----------
          // parent_b = task_new(NULL)
          xor rdi, rdi;
          call task_new;
          cmp rax, 0;
          je  sys_wait_witness_fail;
          mov r12, rax;                                // r12 = parent_b (reuses pid 9,
                                                        // freed by sub-test A's reap —
                                                        // pid_alloc is dense-low-first)

          // child_b = task_new(parent_b)  — state stays at NEW (=0)
          mov rdi, r12;
          call task_new;
          cmp rax, 0;
          je  sys_wait_witness_fail;
          mov r13, rax;                                // r13 = child_b (pid 10)

          // sys_wait_body(parent_b)
          mov rdi, r12;
          call sys_wait_body;

          // Assert: rax == 0 (would-block signal — dispatch layer must invoke sched_block)
          cmp rax, 0;
          jne sys_wait_witness_fail;

          // Assert: parent_b->state == STATE_NEW (0) — UNCHANGED by the body.
          // #724 D5a change: sys_wait_body no longer writes STATE_WAITING on
          // the would-block path. The RUNNABLE→WAITING transition is now
          // performed by sched_block, which is invoked by dispatch_wait4 on
          // the rax==0 signal (not exercised in this boot witness — sched_block
          // would swap kernel stacks; separately verified by block_wake_witness
          // at kernel_main.pdx:6679). Asserting state is UNCHANGED here proves
          // sys_wait_body is a pure "check + reap-or-signal" leaf, with no
          // scheduler side-effect. See
          // design/kernel/r17-m0-724-d5-sys-wait-block.md §9.1.
          mov eax, [r12 + 8];
          cmp rax, 0;
          jne sys_wait_witness_fail;

          // Assert: child_b->state unchanged (NEW = 0)
          mov eax, [r13 + 8];
          cmp rax, 0;
          jne sys_wait_witness_fail;

          // Assert: _pid_table[child_b->pid] != 0 (child NOT reaped)
          // NOTE: a hardcoded slot literal (originally "slot 11") is fragile
          // here — sub-test A's reap (pid_free(9)) frees pid 9, so pid_alloc
          // (dense-low-first scan) hands parent_b pid 9 (reused) instead of
          // the naively-expected pid 10, and child_b becomes pid 10 instead
          // of pid 11. Index _pid_table dynamically via the actual pid
          // (u32 zero-ext load, then SIB scale-8), matching the addressing
          // idiom sys_wait_body itself uses, instead of assuming a fixed
          // allocation-order slot.
          mov ecx, [r13 + 0];                          // child_b->pid (u32, zero-ext)
          lea rax, [rip + _pid_table];
          mov rax, [rax + rcx*8];
          cmp rax, 0;
          je  sys_wait_witness_fail;

          // ---------- Sub-test C: no children, ECHILD ----------
          // parent_c = task_new(NULL)
          xor rdi, rdi;
          call task_new;
          cmp rax, 0;
          je  sys_wait_witness_fail;
          mov r12, rax;                                // r12 = parent_c (pid 11)

          // sys_wait_body(parent_c) — no children exist for parent_c's pid
          mov rdi, r12;
          call sys_wait_body;

          // Assert: rax == -ECHILD (0xFFFFFFFFFFFFFFF6)
          mov rcx, 0xFFFFFFFFFFFFFFF6;
          cmp rax, rcx;
          jne sys_wait_witness_fail;

          // Assert: parent_c->state unchanged (NEW = 0)
          mov eax, [r12 + 8];
          cmp rax, 0;
          jne sys_wait_witness_fail;

          // ---------- All checks green ----------
          mov rdi, 3;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + sys_wait_witness_ok_msg];
          call klog_s1;
          jmp sys_wait_witness_exit;

      sys_wait_witness_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + sys_wait_witness_fail_msg];
          call klog_s1;

      sys_wait_witness_exit:

      // ============================================================
      // R15-M6-004 (#555): sys_execve witness — 2 sub-tests, 1 marker
      // ============================================================
      sys_execve_witness:
          // ---------- Sub-test A: valid ELF, success + swap ----------
          // t_a = task_new(NULL) — provides a live user_pml4_pa @ 16
          xor rdi, rdi;
          call task_new;
          cmp rax, 0;
          je  sys_execve_witness_fail;
          mov r12, rax;                                // r12 = t_a slab

          // Save t_a->user_pml4_pa (old_pml4), pid, state for later compare
          mov rax, [r12 + 16];
          mov r13, rax;                                // r13 = old_pml4
          mov eax, [r12 + 0];
          mov r14d, eax;                               // r14 = t_a->pid (u32)
          mov eax, [r12 + 8];
          mov r15d, eax;                               // r15 = t_a->state (u32)

          // sys_execve_body(t_a, _shell_bin_start, image_len)
          mov rdi, r12;
          lea rsi, [rip + _shell_bin_start];
          lea rax, [rip + _shell_bin_end];
          sub rax, rsi;                                // rax = image_len
          mov rdx, rax;
          call sys_execve_body;

          // Assert: rax == 0 (ELF_OK)
          cmp rax, 0;
          jne sys_execve_witness_fail;

          // Assert: rdx == *(u64 *)(_shell_bin_start + 24) (ELF e_entry)
          lea rcx, [rip + _shell_bin_start];
          mov rax, [rcx + 24];                         // expected entry_rip
          cmp rdx, rax;
          jne sys_execve_witness_fail;

          // Assert: t_a->user_pml4_pa != old_pml4 (swap happened)
          mov rax, [r12 + 16];
          cmp rax, r13;
          je  sys_execve_witness_fail;

          // Assert: t_a->pid unchanged
          mov eax, [r12 + 0];
          cmp eax, r14d;
          jne sys_execve_witness_fail;

          // Assert: t_a->state unchanged
          mov eax, [r12 + 8];
          cmp eax, r15d;
          jne sys_execve_witness_fail;

          // ---------- Sub-test B: invalid ELF, rollback ----------
          // t_b = task_new(NULL) — fresh user_pml4_pa
          xor rdi, rdi;
          call task_new;
          cmp rax, 0;
          je  sys_execve_witness_fail;
          mov r12, rax;                                // r12 = t_b slab

          // Save t_b->user_pml4_pa (old_pml4_b), pid, state
          mov rax, [r12 + 16];
          mov r13, rax;                                // r13 = old_pml4_b
          mov eax, [r12 + 0];
          mov r14d, eax;                               // r14 = t_b->pid
          mov eax, [r12 + 8];
          mov r15d, eax;                               // r15 = t_b->state

          // sys_execve_body(t_b, _bad_elf_stub_start, 64)
          mov rdi, r12;
          lea rsi, [rip + _bad_elf_stub_start];
          mov rdx, 64;
          call sys_execve_body;

          // Assert: rax != 0 (some error code)
          cmp rax, 0;
          je  sys_execve_witness_fail;

          // Assert: rax == 0xFFFFFFFF (ELF_BAD_HDR — magic gate rejected the stub)
          mov rcx, 0xFFFFFFFF;
          cmp rax, rcx;
          jne sys_execve_witness_fail;

          // Assert: t_b->user_pml4_pa == old_pml4_b (unchanged — rollback preserved)
          mov rax, [r12 + 16];
          cmp rax, r13;
          jne sys_execve_witness_fail;

          // Assert: t_b->pid unchanged
          mov eax, [r12 + 0];
          cmp eax, r14d;
          jne sys_execve_witness_fail;

          // Assert: t_b->state unchanged
          mov eax, [r12 + 8];
          cmp eax, r15d;
          jne sys_execve_witness_fail;

          // ---------- All checks green ----------
          mov rdi, 3;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + sys_execve_witness_ok_msg];
          call klog_s1;
          jmp sys_execve_witness_exit;

      sys_execve_witness_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + sys_execve_witness_fail_msg];
          call klog_s1;

      sys_execve_witness_exit:

      // ============================================================
      // R15-M6-007 (#558): orphan_adopt witness — 3-gen cascade, 1 marker
      // ============================================================
      orphan_adoption_witness:
          // ---------- Setup: build A → B → C chain ----------
          // Load pid-1 slab (fake init from task_new_witness) into rdi as A's parent.
          // task_new(parent) sets child->parent_pid = parent->pid, so passing the
          // pid-1 slab makes A->parent_pid = 1. This avoids the parent_pid == 0
          // case (which sys_exit's step-3 guard treats as "init exiting").
          lea rax, [rip + _pid_table];
          mov rdi, [rax + 8];                          // _pid_table[1] (SIB scale-8)
          cmp rdi, 0;
          je  orphan_adoption_witness_fail;            // pid 1 not populated (bug in earlier witness)

          // A = task_new(_pid_table[1])
          call task_new;
          cmp rax, 0;
          je  orphan_adoption_witness_fail;
          mov r12, rax;                                // r12 = A slab

          // B = task_new(A)
          mov rdi, r12;
          call task_new;
          cmp rax, 0;
          je  orphan_adoption_witness_fail;
          mov r13, rax;                                // r13 = B slab

          // C = task_new(B)
          mov rdi, r13;
          call task_new;
          cmp rax, 0;
          je  orphan_adoption_witness_fail;
          mov r14, rax;                                // r14 = C slab

          // ---------- Pre-exit assertions ----------
          // Assert: B->parent_pid == A->pid
          mov eax, [r12 + 0];                          // A->pid
          mov ecx, [r13 + 4];                          // B->parent_pid
          cmp eax, ecx;
          jne orphan_adoption_witness_fail;

          // Assert: C->parent_pid == B->pid
          mov eax, [r13 + 0];                          // B->pid
          mov ecx, [r14 + 4];                          // C->parent_pid
          cmp eax, ecx;
          jne orphan_adoption_witness_fail;

          // ---------- Phase 1: A exits ----------
          // sys_exit_body(A, 0)
          mov rdi, r12;
          xor rsi, rsi;                                 // status = 0
          call sys_exit_body;

          // Assert: A->state == STATE_ZOMBIE (3)
          mov eax, [r12 + 8];
          cmp rax, 3;
          jne orphan_adoption_witness_fail;

          // Assert: B->parent_pid == 1 (adopted)
          mov eax, [r13 + 4];
          cmp rax, 1;
          jne orphan_adoption_witness_fail;

          // Assert: C->parent_pid == B->pid (unchanged — B still alive)
          mov eax, [r13 + 0];                          // B->pid
          mov ecx, [r14 + 4];                          // C->parent_pid
          cmp eax, ecx;
          jne orphan_adoption_witness_fail;

          // ---------- Phase 2: B exits ----------
          // sys_exit_body(B, 0)
          mov rdi, r13;
          xor rsi, rsi;
          call sys_exit_body;

          // Assert: B->state == STATE_ZOMBIE (3)
          mov eax, [r13 + 8];
          cmp rax, 3;
          jne orphan_adoption_witness_fail;

          // Assert: C->parent_pid == 1 (now adopted)
          mov eax, [r14 + 4];
          cmp rax, 1;
          jne orphan_adoption_witness_fail;

          // ---------- All checks green ----------
          mov rdi, 3;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + orphan_adoption_witness_ok_msg];
          call klog_s1;
          jmp orphan_adoption_witness_exit;

      orphan_adoption_witness_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + orphan_adoption_witness_fail_msg];
          call klog_s1;

      orphan_adoption_witness_exit:

      // ============================================================
      // R15-M6-003 (#554) + R17-M0-724-D6 (#724): sys_fork witness — testable happy path
      // ============================================================
      // #724-D6: sys_fork_body now materializes child regs_save and calls
      // runq_enqueue. Preconditions this witness must establish:
      //   (a) runq_init has been called — else the enqueue writes through a
      //       NULL head.prev, faulting. The real runq_init call happens at
      //       kernel_main.pdx:6317 during scheduler bootstrap, which is
      //       AFTER this witness runs; calling it here is idempotent (see
      //       runqueue.pdx §runq_init "Idempotent: safe to re-call") and
      //       the later real init still succeeds (it just re-writes the
      //       same two head slots).
      //   (b) The state assertion must expect STATE_RUNNABLE (1), not the
      //       old STATE_NEW (0). See design/kernel/r17-m0-724-d6-fork-enqueue.md
      //       §4 for the "state=RUNNABLE before enqueue" invariant rationale.
      //   (c) After validation, runq_dequeue(child) cleans the witness's
      //       child out of the runqueue so it doesn't linger past the real
      //       runq_init at :6317 (which would orphan the pointer anyway, but
      //       explicit dequeue is defensive and reads cleanly).
      sys_fork_witness:
          // ---------- Precondition: initialize runqueue (see (a) above) ----------
          call runq_init;

          // ---------- Setup: parent = task_new(NULL) ----------
          xor rdi, rdi;
          call task_new;
          cmp rax, 0;
          je  sys_fork_witness_fail;
          mov rbx, rax;                              // rbx = parent slab

          // Save parent_pid (u32 @ 0) for later comparison
          mov eax, [rbx + 0];
          mov r15d, eax;                             // r15 = parent_pid

          // ---------- Seed parent's fd_table with known values ----------
          mov rax, 0xDEADBEEFCAFEBABE;
          mov [rbx + 192], rax;                      // fd[3] @ 168 + 24
          mov rax, 0x1122334455667788;
          mov [rbx + 208], rax;                      // fd[5] @ 168 + 40
          mov rax, 0xF00DBEEF00000001;
          mov [rbx + 416], rax;                      // fd[31] @ 168 + 248

          // ---------- Act: sys_fork_body(parent) --- empty aspace ---
          mov rdi, rbx;
          call sys_fork_body;

          // ---------- Assertions on returned {rax, rdx} ----------
          // Assert: rax >= 2 (child pid must be a valid allocated slot)
          cmp rax, 2;
          jb  sys_fork_witness_fail;                 // child_pid < 2 → bug

          // Assert: rax != parent_pid
          cmp rax, r15;
          je  sys_fork_witness_fail;

          // Save child_pid for lookup
          mov r12d, eax;                             // r12 = child_pid (zero-ext)

          // Assert: rdx == 0 (reserved slot)
          cmp rdx, 0;
          jne sys_fork_witness_fail;

          // ---------- Look up child via _pid_table[child_pid] ----------
          lea rax, [rip + _pid_table];
          mov r10, [rax + r12*8];                    // r10 = child slab
          cmp r10, 0;
          je  sys_fork_witness_fail;                 // pid_table not published

          // ---------- Assertions on child task_struct ----------
          // Assert: child->pid == child_pid (matches what fork returned)
          mov eax, [r10 + 0];
          cmp eax, r12d;
          jne sys_fork_witness_fail;

          // Assert: child->parent_pid == parent_pid (task_new did this)
          mov eax, [r10 + 4];
          cmp eax, r15d;
          jne sys_fork_witness_fail;

          // Assert: child->state == STATE_RUNNABLE (1)
          // #724-D6: sys_fork_body now sets state=RUNNABLE before
          // runq_enqueue so the runqueue invariant "everything on
          // _runq_head_slot is RUNNABLE" holds at publish time.
          mov eax, [r10 + 8];
          cmp rax, 1;
          jne sys_fork_witness_fail;

          // Assert: child->user_pml4_pa != parent->user_pml4_pa (fresh aspace)
          mov rax, [rbx + 16];                       // parent_pml4
          mov rcx, [r10 + 16];                       // child_pml4
          cmp rcx, rax;
          je  sys_fork_witness_fail;
          cmp rcx, 0;
          je  sys_fork_witness_fail;                 // must be non-null

          // ---------- Assertions on fd_table copy ----------
          // child.fd[3] == parent.fd[3]
          mov rax, [r10 + 192];                      // fd[3] @ 168 + 24
          mov rcx, 0xDEADBEEFCAFEBABE;
          cmp rax, rcx;
          jne sys_fork_witness_fail;

          // child.fd[5] == parent.fd[5]
          mov rax, [r10 + 208];                      // fd[5] @ 168 + 40
          mov rcx, 0x1122334455667788;
          cmp rax, rcx;
          jne sys_fork_witness_fail;

          // child.fd[31] == parent.fd[31]
          mov rax, [r10 + 416];                      // fd[31] @ 168 + 248
          mov rcx, 0xF00DBEEF00000001;
          cmp rax, rcx;
          jne sys_fork_witness_fail;

          // child.fd[0] == 0 (unused slot, copied zero)
          mov rax, [r10 + 168];                      // fd[0] @ 168
          cmp rax, 0;
          jne sys_fork_witness_fail;

          // ---------- #724-D6: assertions on fresh-schedule materialization ----------
          // Assert: child.regs_save.rip @ +40 == &sched_switch_r15_continuation
          //         (uniform trampoline convention — see switch.pdx §6.2).
          mov rax, [r10 + 40];
          lea rcx, [rip + sched_switch_r15_continuation];
          cmp rax, rcx;
          jne sys_fork_witness_fail;

          // Assert: child.regs_save.rflags @ +48 == 0x2 (IF=0, reserved=1).
          //         See sys_fork.pdx FRESH_CHILD_RFLAGS and design §6.1.
          mov rax, [r10 + 48];
          cmp rax, 2;
          jne sys_fork_witness_fail;

          // Assert: child.regs_save.rsp @ +32 == child + 2216 (top-of-slab
          //         landing-stack anchor).
          mov rax, [r10 + 32];
          mov rcx, r10;
          add rcx, 2216;
          cmp rax, rcx;
          jne sys_fork_witness_fail;

          // Assert: [child + 2216] == &sys_fork_child_landing (landing RA
          //         consumed by continuation.ret).
          mov rax, [r10 + 2216];
          lea rcx, [rip + sys_fork_child_landing];
          cmp rax, rcx;
          jne sys_fork_witness_fail;

          // Assert (rewired for #773): child is on the runqueue.
          // Post-#773 the runqueue head lives at PERCPU_OFF_RUNQUEUE_HEAD
          // (+32) in this CPU's Percpu CB.  Single-element enqueue leaves
          // CB.head == child, so we deref [gs:32] via rdmsr IA32_GS_BASE.
          mov rcx, 0xC0000101;
          rdmsr;
          shl rdx, 32;
          or  rax, rdx;
          mov rcx, [rax + 32];                       // CB.runqueue_head
          cmp rcx, r10;
          jne sys_fork_witness_fail;

          // ---------- Cleanup: runq_dequeue(child) so it doesn't linger ----------
          // Even though the real runq_init at :6317 would orphan any dangling
          // pointer, explicit dequeue keeps the witness's contract crisp:
          // we started with runq_init (empty), we end with the runqueue
          // empty of witness-owned tasks.
          mov rdi, r10;
          call runq_dequeue;

          // ---------- All checks green ----------
          mov rdi, 3;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + sys_fork_witness_ok_msg];
          call klog_s1;
          jmp sys_fork_witness_exit;

      sys_fork_witness_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + sys_fork_witness_fail_msg];
          call klog_s1;

      sys_fork_witness_exit:


      pop rbp;
      ret
    }
  }
}
