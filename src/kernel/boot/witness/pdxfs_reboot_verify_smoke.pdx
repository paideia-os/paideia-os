// src/kernel/boot/witness/pdxfs_reboot_verify_smoke.pdx -- R52.M8-005 (#1725)
//
// Boot witness for the PDXFS-on-block v1 REBOOT + REMOUNT + BYTE-
// VERIFY + SIGNATURE-VERIFY path: after any sibling M8 witness has
// mkfs'd (M8-001 / #1721), mounted (M8-002 / #1722), pkg-installed
// (M8-003 / #1723), and cleanly umounted (M8-004 / #1724) the QEMU-
// attached NVMe device, THIS witness fires on the SECOND boot with
// the same disk image, remounts the volume via the REAL
// `mount_pdxfs_block` entry point (core/fs/pdxfs/mount_block.pdx,
// #1707), reads the superblock's `flags` field through the REAL
// `sb_flags` accessor (superblock.pdx, #1682), and BRANCHES on
// PDXB_SB_FLAG_CLEAN_UNMOUNT (bit 0, superblock_fmt.pdx, #1681):
//
//   * bit 0 CLEAR  ->  This is the FIRST boot after mkfs. Nothing to
//                      verify (no prior session's pkgs to check byte-
//                      for-byte). Emit "PDXFS REBOOT VERIFY FIRST OK"
//                      and return -- the M8-004 (#1724) sibling toggles
//                      this bit on clean umount, so this arm is the
//                      "expected pre-reboot" outcome, not a failure.
//   * bit 0 SET    ->  This is a REMOUNT after a clean umount. Walk
//                      the installed pkgs (M8-003 / #1723's payload),
//                      byte-verify their contents against known-good
//                      hashes embedded in this witness, and verify
//                      each pkg's ML-DSA-65 signature via sig_verify.
//                      pdx's public API (sig_tail_read + sig_prefix_
//                      tear_detect + sig_hash_verify_stub -- the last
//                      is fail-closed today per #1701's own header,
//                      which this witness accepts as the documented
//                      "verify not yet wired end-to-end" outcome per
//                      this issue's own scope note). Emit "PDXFS
//                      REBOOT VERIFY OK".
//
// -----------------------------------------------------------------------------
// LIVE vs SUBSTRATE arm
// -----------------------------------------------------------------------------
//
// Every boot mode the smoke matrix drives today runs against
// NVMEIO_PICK_NONE-refused bdevs (see block_cache_synth.pdx /
// mount_replay_witness_synth.pdx / pdxfs_boot_mount_smoke.pdx headers
// for the identical substrate posture). Under that posture,
// `mount_pdxfs_block`'s first nested call (`probe_one_bdev` ->
// `sb_read` -> `cap_invoke` BDEV_OP_READ_LBA) forwards a <2^32
// sentinel (PDXB_SB_READ_BDEV_ERR or one of the four validation
// codes) rather than a KERNEL_VMA_BASE-relative sb_ptr;
// `mount_pdxfs_block`'s `mpb_done` fall-through then returns rax >= 16
// (every failure sentinel is >= 0xFFFFED00, well beyond MOUNT_MAX=8).
//
// This witness distinguishes the two arms by inspecting the return
// value directly, mirroring the sibling `pdxfs_boot_mount_smoke.pdx`
// (#1722)'s own `cmp rax, 8; jae <substrate>` idiom (probe.pdx
// header, "row ids are 0..15; every failure sentinel it can produce
// is far larger" -- MOUNT_MAX=8 uses the same bound conservatively):
//
//   * rax < 8  -> LIVE remount landed at slot rax. Proceed to sb_read
//                 + sb_flags + branch on PDXB_SB_FLAG_CLEAN_UNMOUNT.
//                 Emit "PDXFS REBOOT VERIFY FIRST OK" (bit CLEAR) or
//                 "PDXFS REBOOT VERIFY OK" (bit SET after the pkg
//                 sig-verify walk).
//   * rax >= 8 -> No live bdev on this boot (substrate mode); the
//                 mount attempt bounced off NVMEIO_PICK_NONE. Emit
//                 "PDXFS REBOOT VERIFY SUBSTRATE OK".
//
// All three fingerprints are output-strip-clean (design/policy/
// output-provenance-strip.md); the golden pins the SUBSTRATE arm
// today (that is what every boot mode reaches without a real NVMe
// device) and can gain either of the two LIVE variants as a later
// ordered line once run-smoke.sh (#1721) attaches the real device +
// two-boot dispatcher, without disturbing the SUBSTRATE line's
// placement immediately after "PDXFS BOOT MOUNT SUBSTRATE OK".
//
// -----------------------------------------------------------------------------
// Substrate-mode NVMe cap trick (identical to mount_replay_witness_
// synth.pdx / inode_table_witness_synth.pdx / alloc_free_hint_witness_
// synth.pdx / block_cache_synth.pdx / pdxfs_boot_mount_smoke.pdx)
// -----------------------------------------------------------------------------
//
// Mints a real KIND_NVME_CONTROLLER + dual-kind KIND_NVME_NAMESPACE/
// KIND_BLKDEV row that never advances to a live SQ pair, so every
// READ_LBA/WRITE_LBA/FLUSH `mount_pdxfs_block` issues through
// `probe_one_bdev`/`sb_read`/`journal_replay` forwards NVMEIO_PICK_
// NONE verbatim. Cap slots 172..176 are the same fixed range every
// R52 PdxFS witness already claims (tolerated per this tree's
// established practice: every witness clears its own range on entry
// AND on every exit path, and boot witnesses run strictly
// sequentially, so no two witnesses' cap rows are ever live at once).
// Slot 176 is this witness's own KIND_VOLUME target for
// `mount_pdxfs_block`'s cap_slot argument -- also cleared on entry
// and on every exit path.
//
//   172 = synthetic KIND_PCI_DEV parent for the NVMe controller
//   173 = KIND_NVME_CONTROLLER (row 0)
//   174 = KIND_NVME_NAMESPACE (row 0, dual-kind with slot 175)
//   175 = KIND_BLKDEV, family NVME -- the bdev_cap passed to
//         mount_pdxfs_block
//   176 = KIND_VOLUME target slot for mount_pdxfs_block's cap_slot
//         argument (only stamped by the LIVE arm; the SUBSTRATE arm
//         never reaches cap_mint_write inside mount_pdxfs_block)
//
// -----------------------------------------------------------------------------
// What the LIVE arm proves
// -----------------------------------------------------------------------------
//
// (a) `mount_pdxfs_block(176, 175, 0, 0)` returned a valid mount_slot
//     in [0, 8). Every nested call along the mount path succeeded
//     end to end -- same strong-proof-point pdxfs_boot_mount_smoke.
//     pdx already enumerates in detail for its own LIVE arm.
// (b) `sb_read(175)` returned a real KERNEL_VMA_BASE-relative sb_ptr
//     (>= 0xFFFF800000000000) -- the same distinguishing-idiom
//     mount_pdxfs_block's own step (3) uses.
// (c) `sb_flags(sb_ptr)` decoded PDXB_SB_FLAG_CLEAN_UNMOUNT (bit 0).
//     The M8-004 (#1724) sibling toggles this bit on clean umount, so
//     its value at boot cleanly discriminates first-boot-post-mkfs
//     from remount-after-clean-umount without any out-of-band state.
// (d) On the remount arm (bit 0 SET): for each of two synthetic
//     "pkg" inode rows the witness owns outright (`_prv_inode_row_a`
//     and `_prv_inode_row_b`, stamped with known-good sig_prefix +
//     sig_hash values under this witness's own control -- see the
//     "synthetic pkg fixture" note below for why this is meaningful
//     even without a real dentry table), the REAL `sig_tail_read`
//     copy runs (7-qword scratch fill), the REAL `sig_prefix_tear_
//     detect` returns 0 (no tear, prefix matches), and the REAL
//     `sig_hash_verify_stub` returns INODE_TAIL_HASH_MISMATCH
//     (0xFFFFED1C -- fail-closed by design per #1701's own header,
//     accepted here as the documented "verify not yet end-to-end"
//     outcome this issue's own scope note allows).
//
// -----------------------------------------------------------------------------
// Synthetic pkg fixture (why bit-SET arm proves anything in substrate)
// -----------------------------------------------------------------------------
//
// The bit-SET arm cannot reach a real dentry-walk today (no `pkg
// install` primitive lands the two payload files on disk -- that is
// sibling M8-003 / #1723, not this issue), and the SUBSTRATE arm
// short-circuits before this walk ever runs. What the bit-SET arm
// therefore proves in the LIVE arm is that the sig-verify PUBLIC
// API (sig_tail_read / sig_prefix_tear_detect / sig_hash_verify_stub
// in sig_verify.pdx, #1701) is CALLABLE, its arity survives the
// call-site 5-push shape mount_block.pdx's own header documents,
// and its fail-closed sentinel INODE_TAIL_HASH_MISMATCH (0xFFFFED1C)
// is the outcome the witness is expected to accept until
// paideia-as's BLAKE3-hash-32 primitive lands (see sig_verify.pdx
// header for that specific cross-repo blocker). This mirrors
// block_cache_synth.pdx's own posture for M7-006: "primitive is
// wired, substrate has nothing to give it" degrades cleanly to
// "arm this witness would light up on real HW is scaffolded".
//
// -----------------------------------------------------------------------------
// Failure taxonomy
// -----------------------------------------------------------------------------
//
// The SUBSTRATE arm is not a failure; only the LIVE arm can fail.
// In the LIVE arm every sub-check is monotonic: if any of (b)-(d)
// does not hold after (a) succeeded, that is a real breakage --
// either mount_pdxfs_block's own entry-pack, sb_read's pointer-vs-
// sentinel contract, sb_flags's field offset, or one of the three
// sig_verify.pdx entry points. Any such divergence hits
// `prv_fail_stage`, which logs the stage number via
// klog_s1_d1(k_line) mirroring pbms_fail_stage / itw_fail_stage /
// mrw_fail_stage, then runs the same cleanup and returns 1.
//
// -----------------------------------------------------------------------------
// Register plan
// -----------------------------------------------------------------------------
//
// 3-push prologue (rbx = bdev_cap 175, r12 = sb_ptr set in the LIVE
// arm's stage 7, r13 = flags value set in the LIVE arm's stage 8)
// lands rsp%16 == 0 (entry rsp%16 == 8 + 24 = 32) for every nested
// call this function makes directly, matching pdxfs_boot_mount_
// smoke.pdx / mount_block.pdx's own 3-push shape. `bdev_cap` (175),
// `cap_slot` (176), and every immediate argument are compile-time-
// constant literals -- no register needs to carry them across
// calls. Stage number lives in `_prv_stage` (memory, not a
// register), matching pbms_stage / _itw_stage / _mrw_stage. The one
// `sub rsp, 32` / `add rsp, 32` bracket around `nvme_ns_dual_kind_
// mint`'s params_ptr staging is 16-byte-aligned, so rsp%16 stays 0
// across it (identical bracket to the sibling witnesses).
//
// -----------------------------------------------------------------------------
// mov_b / no-test / label-prefix discipline
// -----------------------------------------------------------------------------
//
// No byte-granularity access anywhere -- every field touched is a
// u64 (via `mov`) or is extracted register-level via `and rax, 1`
// over an already-loaded qword (the bit-0 CLEAN_UNMOUNT extraction
// from the u32 flags value sb_flags returns zero-extended). No
// `test` instruction anywhere; every comparison uses `cmp` +
// `je`/`jne`/`jae`/`jb`. Every label is prefixed `prv_` (Pdxfs
// Reboot Verify) per the reserved-label discipline. Grep audit
// 2026-08-23: no `prv_` hits anywhere else in src/kernel/.
//
// Every sentinel compare against a value with bit 31/63 set (the
// KERNEL_VMA_BASE constant 0xFFFF800000000000 in step 7 and the
// fail-closed INODE_TAIL_HASH_MISMATCH constant 0xFFFFED1C in the
// remount arm's sig walk) is staged through `mov r10, <imm>; cmp
// reg, r10` rather than a bare `cmp reg, <imm>` -- identical G4
// encoder-gap posture pdxfs_boot_mount_smoke.pdx / mount_block.pdx
// headers document.
//
// -----------------------------------------------------------------------------
// Wire posture
// -----------------------------------------------------------------------------
//
// Wired into src/kernel/boot/witness/r30_platform.pdx immediately
// after `pdxfs_boot_mount_smoke_call` (the most recent M8-cluster
// addition to that file at the time of this landing). Sibling
// issues #1723 (pkg install, M8-003) and #1724 (umount clean,
// M8-004) may add their own witness calls between
// `pdxfs_boot_mount_smoke_call` and this witness's call; a future
// re-ordering to place this witness AFTER those preserves the
// mkfs -> mount -> install -> umount -> reboot verify sequence the
// M8 plan text describes and the tests/r52/round-trip.golden pins.
// Golden: tests/r17/shell-shutdown.golden ("PDXFS REBOOT VERIFY
// SUBSTRATE OK" appended right after "PDXFS BOOT MOUNT SUBSTRATE
// OK" -- the LIVE variants join later once the two-boot dispatcher
// (#1721) and clean-umount witness (#1724) land).

module PdxfsRebootVerifySmoke = structure {

  pub let mut _prv_stage : u64 = 0

  // Synthetic pkg inode rows the LIVE bit-SET arm exercises. Each is
  // 256 bytes (32 qwords) with sig_prefix at +72 (3 qwords) and
  // sig_hash at +96 (4 qwords) per sig_verify.pdx's frozen offsets.
  // The bytes at those offsets are stamped at witness entry with
  // deterministic bit patterns so sig_prefix_tear_detect's compare
  // returns 0 (matching prefix) and sig_hash_verify_stub's fail-
  // closed sentinel is the terminal reachable value.
  pub let mut _prv_inode_row_a : [u64; 32] = uninit @align(64)
  pub let mut _prv_inode_row_b : [u64; 32] = uninit @align(64)

  // Synthetic sig block (matching the size sig_verify.pdx's
  // sig_hash_verify_stub declares in its header, 3400 bytes = 425
  // qwords), whose first 24 bytes match the sig_prefix stamped at
  // _prv_inode_row_{a,b}+72 so sig_prefix_tear_detect returns 0.
  pub let mut _prv_sig_block : [u64; 425] = uninit @align(64)

  // Output scratch for sig_tail_read (7 qwords = 56 bytes per its
  // signature: 3 qwords sig_prefix + 4 qwords sig_hash).
  pub let mut _prv_sig_scratch : [u64; 7] = uninit @align(64)

  // Fingerprints. All four are output-strip-clean (no round/
  // milestone/issue tag). Length count includes the trailing
  // "\n\0" pair.
  pub let prv_first_ok     : [u8; 30] = "PDXFS REBOOT VERIFY FIRST OK\n\0"
  pub let prv_live_ok      : [u8; 24] = "PDXFS REBOOT VERIFY OK\n\0"
  pub let prv_substrate_ok : [u8; 34] = "PDXFS REBOOT VERIFY SUBSTRATE OK\n\0"
  pub let prv_fail         : [u8; 26] = "PDXFS REBOOT VERIFY FAIL\n\0"

  // ==========================================================================
  // prv_clear() -- scrub cap_table slots 172..176 inclusive.
  //
  // Same shape as pdxfs_boot_mount_smoke.pdx's pbms_clear -- upper
  // bound is 177 (exclusive), matching this witness's own slot claim.
  // ==========================================================================
  pub let prv_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R52.M8-005 (#1725): clear cap_table slots 172..176 (this witness's whole fixed slot claim: 172..175 shared with prior R52 PdxFS witnesses per established practice, 176 this witness's own KIND_VOLUME target). Same shape as pbms_clear/itw_clear/mrw_clear, upper bound is 177 (exclusive). Labels prefixed prv_cl_.",
      block: {
        push rbx;
        mov rbx, 172;
      prv_cl_loop:
        cmp rbx, 177;
        jae prv_cl_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp prv_cl_loop;
      prv_cl_done:
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // pdxfs_reboot_verify_smoke() -> u64
  //
  // Entry rsp%16 == 8 (invoked from r30_platform.pdx's boot_continue_
  // after_ring3 body via `call pdxfs_reboot_verify_smoke`, which
  // itself runs at %16==0 after r30_platform.pdx's own `push rbp`).
  // 3-push prologue lands rsp%16 == 0 for every nested call.
  //
  // See module header for the full LIVE vs SUBSTRATE branching, the
  // substrate-mode NVMe cap trick, and the (a)-(d) LIVE-arm scope
  // note.
  // ==========================================================================
  pub let pdxfs_reboot_verify_smoke : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R52.M8-005 (#1725): boot-time PDXFS reboot + remount + byte + sig verify witness. 3-push prologue (rbx=bdev_cap 175, r12=sb_ptr set in LIVE stage 7, r13=flags value set in LIVE stage 8) lands rsp%16==0 for every nested call. Body per module header: (1) defensive reset (nvme_ctrl_table_reset, nvme_ns_table_reset, prv_clear). (2)-(4) mint substrate NVMe cap chain identical to pdxfs_boot_mount_smoke.pdx's / mount_replay_witness_synth.pdx's stages 2-4 (KIND_PCI_DEV @172, KIND_NVME_CONTROLLER @173, dual-kind KIND_NVME_NAMESPACE/KIND_BLKDEV @174/175). (5) stamp synthetic pkg fixture: for each of _prv_inode_row_a and _prv_inode_row_b, zero the row then write 3 qwords at +72 (sig_prefix, deterministic pattern) and 4 qwords at +96 (sig_hash, arbitrary distinct pattern); zero _prv_sig_block then write the first 3 qwords to match each row's sig_prefix (matching the second row overwrites the first, and the walk in stage 9 re-writes the pattern for each iteration -- the buffer is reused, not per-pkg). (6) mount_pdxfs_block(cap_slot=176, bdev_cap=175, uuid_hint_lo=0, uuid_hint_hi=0); branch on rax >= 8 to prv_substrate. LIVE arm: (7) sb_read(175) -> rax = sb_ptr; verify rax >= KERNEL_VMA_BASE (0xFFFF800000000000, staged via r10, cmp rax, r10, jb prv_fail_stage); r12 = rax. (8) sb_flags(sb_ptr) -> rax = flags; r13 = rax; extract bit 0 (and rax, 1); branch on rax == 0 to prv_first (bit CLEAR -- first boot post-mkfs, no work). (9) bit SET remount arm: for each of _prv_inode_row_a and _prv_inode_row_b: (9a) re-stamp _prv_sig_block's first 3 qwords to match this iteration's sig_prefix; (9b) sig_tail_read(&row, &_prv_sig_scratch) -- always returns 0, no branch; (9c) sig_prefix_tear_detect(&row, &_prv_sig_block); expect 0 (no tear); (9d) sig_hash_verify_stub(&_prv_sig_block, &row+96); expect INODE_TAIL_HASH_MISMATCH (0xFFFFED1C, staged via r10, cmp rax, r10, jne prv_fail_stage -- accepting fail-closed as documented per #1701 and this issue's scope note). (10) All remount checks passed -> klog_s1(3, SUBSYS_BOOT, prv_live_ok); cleanup; return 0. prv_first arm (bit 0 CLEAR): klog_s1(3, SUBSYS_BOOT, prv_first_ok); cleanup; return 0. prv_substrate arm: klog_s1(3, SUBSYS_BOOT, prv_substrate_ok); cleanup; return 0. prv_fail_stage: log stage number via klog_s1_d1(k_line) matching pbms_fail_stage; cleanup; return 1. Every cleanup path calls prv_clear + nvme_ctrl_table_reset + nvme_ns_table_reset before returning. Labels prefixed prv_.",
      block: {
        push rbx;
        push r12;
        push r13;

        // -----------------------------------------------------------
        // (1) Defensive reset.
        // -----------------------------------------------------------
        mov rax, 1;
        lea rcx, [rip + _prv_stage];
        mov [rcx], rax;

        call nvme_ctrl_table_reset;
        call nvme_ns_table_reset;
        call prv_clear;

        // -----------------------------------------------------------
        // (2) Synthetic KIND_PCI_DEV parent (slot 172).
        // -----------------------------------------------------------
        mov rax, 2;
        lea rcx, [rip + _prv_stage];
        mov [rcx], rax;

        mov rdi, 172;
        mov rsi, 0x30;                    // KIND_PCI_DEV
        mov rdx, 0x21F;                   // R_DEV_ALL | RIGHT_MINT
        mov rcx, 0xFACEFEED;              // synthetic bdf
        call cap_mint_write;

        // -----------------------------------------------------------
        // (3) KIND_NVME_CONTROLLER (slot 173, row 0). Never advanced
        // to a live SQ pair -- substrate-mode posture.
        // -----------------------------------------------------------
        mov rax, 3;
        lea rcx, [rip + _prv_stage];
        mov [rcx], rax;

        mov rdi, 172;                     // parent_slot (KIND_PCI_DEV)
        mov rsi, 0x61F;                   // R_NVMEC_ALL
        xor rdx, rdx;                     // ctrl_idx = 0
        mov rcx, 0x400000;                // bar0_pa (synthetic)
        call nvme_ctrl_cap_mint_inner;
        cmp rax, 0;                       // expect row 0
        jne prv_fail_stage;

        mov rdi, 173;
        mov rsi, 0x198;                   // KIND_NVME_CONTROLLER
        mov rdx, 0x61F;
        xor rcx, rcx;                     // target_ptr = ctrl_row_id = 0
        call cap_mint_write;

        // -----------------------------------------------------------
        // (4) Dual-kind KIND_NVME_NAMESPACE/KIND_BLKDEV (slots
        // 174/175, row 0).
        // -----------------------------------------------------------
        mov rax, 4;
        lea rcx, [rip + _prv_stage];
        mov [rcx], rax;

        sub rsp, 32;
        mov rax, 1;
        mov [rsp + 0], rax;                // nsid
        mov rax, 4096;
        mov [rsp + 8], rax;                // lba_size
        mov rax, 100;
        mov [rsp + 16], rax;               // block_count
        xor rax, rax;
        mov [rsp + 24], rax;               // parent_ctrl_row = 0
        mov rdi, 174;                      // ns_slot
        mov rsi, 175;                      // blk_slot
        mov rdx, 173;                      // parent_slot (KIND_NVME_CONTROLLER)
        mov rcx, 0x41F;                    // ns_rights (R_NVMEN_ALL)
        mov r8,  0x1F;                     // blk_rights (R_BLK_ALL)
        mov r9,  rsp;                      // params_ptr
        call nvme_ns_dual_kind_mint;
        add rsp, 32;
        cmp rax, 0;                        // expect row 0
        jne prv_fail_stage;

        // -----------------------------------------------------------
        // (5) Stamp synthetic pkg fixture. Zero both inode rows +
        // the sig block, then write matching sig_prefix bytes into
        // each pair. This is scratch preparation only; the LIVE
        // bit-SET arm re-writes _prv_sig_block per iteration in
        // stage 9. No branches -- straight-line qword stores.
        // -----------------------------------------------------------
        mov rax, 5;
        lea rcx, [rip + _prv_stage];
        mov [rcx], rax;

        // Zero row a (32 qwords).
        lea r10, [rip + _prv_inode_row_a];
        xor rax, rax;
        xor rcx, rcx;
      prv_za_top:
        cmp rcx, 32;
        jae prv_za_done;
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        jmp prv_za_top;
      prv_za_done:

        // Stamp sig_prefix @+72 (3 qwords) for row a.
        mov rax, 0xA1A1A1A1A1A1A1A1;
        mov [r10 + 72], rax;
        mov rax, 0xA2A2A2A2A2A2A2A2;
        mov [r10 + 80], rax;
        mov rax, 0xA3A3A3A3A3A3A3A3;
        mov [r10 + 88], rax;

        // Stamp sig_hash @+96 (4 qwords) for row a.
        mov rax, 0xA4A4A4A4A4A4A4A4;
        mov [r10 + 96], rax;
        mov rax, 0xA5A5A5A5A5A5A5A5;
        mov [r10 + 104], rax;
        mov rax, 0xA6A6A6A6A6A6A6A6;
        mov [r10 + 112], rax;
        mov rax, 0xA7A7A7A7A7A7A7A7;
        mov [r10 + 120], rax;

        // Zero row b (32 qwords).
        lea r10, [rip + _prv_inode_row_b];
        xor rax, rax;
        xor rcx, rcx;
      prv_zb_top:
        cmp rcx, 32;
        jae prv_zb_done;
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        jmp prv_zb_top;
      prv_zb_done:

        // Stamp sig_prefix @+72 (3 qwords) for row b (distinct pattern).
        mov rax, 0xB1B1B1B1B1B1B1B1;
        mov [r10 + 72], rax;
        mov rax, 0xB2B2B2B2B2B2B2B2;
        mov [r10 + 80], rax;
        mov rax, 0xB3B3B3B3B3B3B3B3;
        mov [r10 + 88], rax;

        // Stamp sig_hash @+96 (4 qwords) for row b.
        mov rax, 0xB4B4B4B4B4B4B4B4;
        mov [r10 + 96], rax;
        mov rax, 0xB5B5B5B5B5B5B5B5;
        mov [r10 + 104], rax;
        mov rax, 0xB6B6B6B6B6B6B6B6;
        mov [r10 + 112], rax;
        mov rax, 0xB7B7B7B7B7B7B7B7;
        mov [r10 + 120], rax;

        // Zero the shared sig block (425 qwords = 3400 bytes).
        lea r10, [rip + _prv_sig_block];
        xor rax, rax;
        xor rcx, rcx;
      prv_zs_top:
        cmp rcx, 425;
        jae prv_zs_done;
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        jmp prv_zs_top;
      prv_zs_done:

        // -----------------------------------------------------------
        // (6) mount_pdxfs_block(cap_slot=176, bdev_cap=175,
        //     uuid_hint_lo=0, uuid_hint_hi=0). Then branch: rax >= 8
        // <=> substrate arm (per module header discussion of the
        // MOUNT_MAX=8 vs 0xFFFFED00-band sentinel disambiguation).
        // -----------------------------------------------------------
        mov rax, 6;
        lea rcx, [rip + _prv_stage];
        mov [rcx], rax;

        mov rdi, 176;                      // cap_slot (KIND_VOLUME target)
        mov rsi, 175;                      // bdev_cap
        xor rdx, rdx;                      // uuid_hint_lo = 0 (no hint)
        xor rcx, rcx;                      // uuid_hint_hi = 0 (no hint)
        call mount_pdxfs_block;

        cmp rax, 8;
        jae prv_substrate;

        // -----------------------------------------------------------
        // (7) LIVE arm: sb_read(175) -> sb_ptr. Verify
        // >= KERNEL_VMA_BASE via r10-staged compare (bit 63 set, per
        // G4 discipline).
        // -----------------------------------------------------------
        mov rax, 7;
        lea rcx, [rip + _prv_stage];
        mov [rcx], rax;

        mov rdi, 175;
        call sb_read;
        mov r10, 0xFFFF800000000000;       // KERNEL_VMA_BASE
        cmp rax, r10;
        jb prv_fail_stage;
        mov r12, rax;                      // r12 = sb_ptr

        // -----------------------------------------------------------
        // (8) LIVE arm: sb_flags(sb_ptr) -> flags. Extract bit 0
        // (PDXB_SB_FLAG_CLEAN_UNMOUNT). r13 holds the raw u32 flags
        // value for any future extension (r13 is dead thereafter);
        // rax holds the extracted bit for the branch.
        // -----------------------------------------------------------
        mov rax, 8;
        lea rcx, [rip + _prv_stage];
        mov [rcx], rax;

        mov rdi, r12;
        call sb_flags;
        mov r13, rax;                      // r13 = flags (informational)
        and rax, 1;                        // extract bit 0
        cmp rax, 0;
        je prv_first;                      // bit CLEAR -> first-boot arm

        // -----------------------------------------------------------
        // (9) LIVE bit-SET arm: for each of two synthetic pkg inode
        // rows, drive sig_tail_read + sig_prefix_tear_detect +
        // sig_hash_verify_stub. Fail-closed sentinel (0xFFFFED1C)
        // from sig_hash_verify_stub is accepted per this issue's own
        // scope note ("sig_verify.pdx (#1701 stub -- fail-closed
        // acceptable)").
        //
        // Iteration A over _prv_inode_row_a.
        // -----------------------------------------------------------
        mov rax, 9;
        lea rcx, [rip + _prv_stage];
        mov [rcx], rax;

        // (9a) re-stamp sig_block first 24 bytes to match row a's
        // sig_prefix (deterministic bytes from stage 5).
        lea r10, [rip + _prv_sig_block];
        mov rax, 0xA1A1A1A1A1A1A1A1;
        mov [r10 + 0], rax;
        mov rax, 0xA2A2A2A2A2A2A2A2;
        mov [r10 + 8], rax;
        mov rax, 0xA3A3A3A3A3A3A3A3;
        mov [r10 + 16], rax;

        // (9b) sig_tail_read(&row_a, &_prv_sig_scratch).
        lea rdi, [rip + _prv_inode_row_a];
        lea rsi, [rip + _prv_sig_scratch];
        call sig_tail_read;

        // (9c) sig_prefix_tear_detect(&row_a, &_prv_sig_block); expect 0.
        lea rdi, [rip + _prv_inode_row_a];
        lea rsi, [rip + _prv_sig_block];
        call sig_prefix_tear_detect;
        cmp rax, 0;
        jne prv_fail_stage;

        // (9d) sig_hash_verify_stub(&_prv_sig_block, &row_a+96);
        // expect INODE_TAIL_HASH_MISMATCH (0xFFFFED1C, staged via r10).
        lea rdi, [rip + _prv_sig_block];
        lea rsi, [rip + _prv_inode_row_a];
        add rsi, 96;
        call sig_hash_verify_stub;
        mov r10, 0xFFFFED1C;
        cmp rax, r10;
        jne prv_fail_stage;

        // Iteration B over _prv_inode_row_b.
        // (9a') re-stamp sig_block first 24 bytes to match row b.
        lea r10, [rip + _prv_sig_block];
        mov rax, 0xB1B1B1B1B1B1B1B1;
        mov [r10 + 0], rax;
        mov rax, 0xB2B2B2B2B2B2B2B2;
        mov [r10 + 8], rax;
        mov rax, 0xB3B3B3B3B3B3B3B3;
        mov [r10 + 16], rax;

        // (9b') sig_tail_read(&row_b, &_prv_sig_scratch).
        lea rdi, [rip + _prv_inode_row_b];
        lea rsi, [rip + _prv_sig_scratch];
        call sig_tail_read;

        // (9c') sig_prefix_tear_detect(&row_b, &_prv_sig_block); expect 0.
        lea rdi, [rip + _prv_inode_row_b];
        lea rsi, [rip + _prv_sig_block];
        call sig_prefix_tear_detect;
        cmp rax, 0;
        jne prv_fail_stage;

        // (9d') sig_hash_verify_stub(&_prv_sig_block, &row_b+96);
        // expect INODE_TAIL_HASH_MISMATCH (0xFFFFED1C).
        lea rdi, [rip + _prv_sig_block];
        lea rsi, [rip + _prv_inode_row_b];
        add rsi, 96;
        call sig_hash_verify_stub;
        mov r10, 0xFFFFED1C;
        cmp rax, r10;
        jne prv_fail_stage;

        // -----------------------------------------------------------
        // (10) LIVE bit-SET arm success: remount + sig walk both
        // completed cleanly.
        // -----------------------------------------------------------
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + prv_live_ok];
        call klog_s1;

        call prv_clear;
        call nvme_ctrl_table_reset;
        call nvme_ns_table_reset;
        xor rax, rax;
        jmp prv_out;

      prv_first:
        // LIVE bit-CLEAR arm: first boot post-mkfs, no verify work.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + prv_first_ok];
        call klog_s1;

        call prv_clear;
        call nvme_ctrl_table_reset;
        call nvme_ns_table_reset;
        xor rax, rax;
        jmp prv_out;

      prv_substrate:
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + prv_substrate_ok];
        call klog_s1;

        call prv_clear;
        call nvme_ctrl_table_reset;
        call nvme_ns_table_reset;
        xor rax, rax;
        jmp prv_out;

      prv_fail_stage:
        lea rax, [rip + _prv_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + prv_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;

        call prv_clear;
        call nvme_ctrl_table_reset;
        call nvme_ns_table_reset;
        mov rax, 1;

      prv_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
