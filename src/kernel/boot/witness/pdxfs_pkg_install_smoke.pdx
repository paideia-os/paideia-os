// src/kernel/boot/witness/pdxfs_pkg_install_smoke.pdx -- R52.M8-003 (#1723)
//
// Boot witness for the pkg-install-pkg round-trip step: a single
// KIND_PDXFS_TXN row is opened once, four simulated pkg-file names
// (bin/lib/man/etc -- the four canonical directories every pkg lands
// under) are journaled through PXT_OP_CREATE one at a time, then the
// whole transaction is closed with PXT_OP_COMMIT. This is the M8
// "every file write flows through JOP_INODE_WRITE + JOP_DENTRY_ADD,
// terminated by JOP_COMMIT" contract, exercised end to end against
// the REAL M6 write-side bodies wired at #1709/#1712.
//
// Design authority: design/filesystem/volume-fs-substrate.md §4.5
// (transaction shape for a pkg install) and §7.M8 (M8 milestone
// scope: mkfs -> boot mount -> pkg install -> umount -> reboot verify).
//
// -----------------------------------------------------------------------------
// Fingerprint contract (live vs substrate)
// -----------------------------------------------------------------------------
//
//   * LIVE arm       -> "PDXFS PKG INSTALL OK"           (root PdxFS-block
//                                                          volume is mounted;
//                                                          every CREATE
//                                                          landed rax == 0
//                                                          against real
//                                                          journal + inode
//                                                          allocator wiring)
//
//   * SUBSTRATE arm  -> "PDXFS PKG INSTALL SUBSTRATE OK" (no root PdxFS-
//                                                          block mount is
//                                                          present; each
//                                                          CREATE refused
//                                                          with PXT_TAIL_
//                                                          BAD_ARG per
//                                                          pdxfs_txn_do_
//                                                          create's own
//                                                          header, but the
//                                                          txn seams still
//                                                          hold and COMMIT
//                                                          still advances
//                                                          the row OPEN ->
//                                                          COMMITTED)
//
// Both fingerprints are output-strip-clean (no round/milestone/issue
// tag in the runtime bytes, per design/policy/output-provenance-strip.md
// and the sibling M5/M6/M7 witness convention).
//
// The M8 round-trip golden (tests/r52/round-trip.golden) pins the LIVE
// arm; the regular boot smoke goldens (tests/r17/shell-shutdown.golden)
// pin the SUBSTRATE arm -- the pattern block_cache_synth.pdx and mount_
// replay_witness_synth.pdx already established for the M7 / M5 pair.
//
// -----------------------------------------------------------------------------
// Substrate posture -- why PXT_TAIL_BAD_ARG on CREATE is accepted
// -----------------------------------------------------------------------------
//
// pdxfs_txn_do_create (kind_pdxfs_txn.pdx, #1709) refuses with PXT_
// TAIL_BAD_ARG (0xFFFFEC1E) when the root PdxFS-block mount is absent
// -- CREATE has no meaningful "nothing to journal" fallback (an inode
// allocation with no volume to allocate against would be a lie), so
// the refusal is a REAL well-typed outcome per that function's own
// header. Every boot mode the shell-shutdown smoke drives runs with
// no live NVMe device (NVMEIO_PICK_NONE substrate), so the mount slot
// stays empty and this witness lands in the SUBSTRATE arm; the sibling
// #1722 witness lands the mount only in the round-trip mode where
// #1721's mkfs actually staged one, and only there does this witness
// land in the LIVE arm.
//
// COMMIT (PXT_OP_COMMIT via pdxfs_txn_commit_wal, #1712) does NOT
// share that refusal posture: commit's mount-absent short-circuit
// returns PXT_OK (== 0) per its own header and pdxfs_txn_ops_real_
// synth.pdx stage (2) pins that OPEN -> COMMITTED transition in
// substrate mode. This witness relies on that: the SUBSTRATE arm's
// fingerprint is only emitted after COMMIT has advanced the row and
// pdxfs_txn_row_state has read PXT_STATE_COMMITTED (2) back.
//
// -----------------------------------------------------------------------------
// Slot-range hygiene
// -----------------------------------------------------------------------------
//
// cap_table slots 136..143 (disjoint from pdxfs_txn_ops_synth.pdx's
// 116..127 and pdxfs_txn_ops_real_synth.pdx's 128..135). Only slot
// 136 is actively used (the KIND_MEMORY parent minted for every
// sys_pdxfs_txn_open_body call); the remainder are scrubbed for
// symmetry with the pxor_clear pattern the sibling witness
// establishes. sys_pdxfs_txn_open_body's own free-slot scan may land
// the KIND_PDXFS_TXN cap in any slot outside this range -- this
// witness bypasses cap_invoke_dispatch and calls cap_handler_pdxfs_
// txn directly with target_ptr = row_id (the sibling witness's
// established pattern), so the exact cap-slot outcome does not
// matter to the assertions below.
//
// -----------------------------------------------------------------------------
// Label reservation
// -----------------------------------------------------------------------------
//
// All local labels prefixed `pkgi_` (per reserved-label discipline;
// the pkg-install witness namespace is otherwise unclaimed). Prefix
// reserved so a future extension (a JOP_UNLINK-based pkg REMOVE
// witness under the same milestone arc, or a second-txn "upgrade"
// variant) can reuse it without collision with any sibling witness.

module PdxfsPkgInstallSmoke = structure {

  // Stage counter: bumped at the top of each block that could fail so
  // the FAIL fingerprint's `line=N` KV names WHICH stage tripped.
  // Only mutable static in this module.
  pub let mut _pkgi_stage : u64 = 0

  // Fingerprint bytes. Both OK forms are output-strip-clean.
  pub let pkgi_ok        : [u8; 22] = "PDXFS PKG INSTALL OK\n\0"
  pub let pkgi_subst_ok  : [u8; 32] = "PDXFS PKG INSTALL SUBSTRATE OK\n\0"
  pub let pkgi_fail      : [u8; 24] = "PDXFS PKG INSTALL FAIL\n\0"

  // Four simulated pkg-file names, each 3 bytes of ASCII with no NUL
  // (pdxfs_txn_stage_create_name takes name_ptr + name_len as separate
  // args, matching the sibling witness's own pxor_name_hello/_foo/_bar
  // convention). These four are the canonical directories every pkg
  // lands under and give the CREATE + COMMIT path four distinct
  // journal-record pairs to shepherd through the transaction.
  pub let pkgi_n1 : [u8; 3] = "bin"
  pub let pkgi_n2 : [u8; 3] = "lib"
  pub let pkgi_n3 : [u8; 3] = "man"
  pub let pkgi_n4 : [u8; 3] = "etc"

  // ==========================================================================
  // pkgi_mem(slot, key, rights) -> ()
  //
  // Mint a synthetic KIND_MEMORY parent at `slot` so pdxfs_txn_cap_
  // mint_inner's parent gate accepts it. Same shape as pxor_mem/pxow_
  // mem across the sibling ops witnesses. Three callee-save pushes
  // align rsp%16 == 0 for the nested call.
  // ==========================================================================
  pub let pkgi_mem : (u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (key: u64) (rights: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R52.M8-003 (#1723) boot witness helper: mint a synthetic KIND_MEMORY parent for the pkg-install witness. Kind = 4 (KIND_MEMORY), rights per caller (typically RIGHT_MINT = 0x200). Mirrors pxor_mem in tests/kernel/pdxfs_txn/pdxfs_txn_ops_real_synth.pdx one-for-one, one slot-range up. Three callee-save pushes (r12/r13/r14) leave rsp%16 == 0 for the nested cap_mint_write call (entry parity rsp%16 == 8 per boot_continue_after_ring3's own alignment discipline). Labels prefixed pkgi_m_.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov rdi, r12;
        mov rsi, 4;                          // KIND_MEMORY
        mov rdx, r14;                        // rights
        mov rcx, r13;                        // target_ptr = key
        call cap_mint_write;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // pkgi_clear() -> ()
  //
  // Scrub cap slots 136..143 so a witness re-run lands within a
  // predictable window. sys_pdxfs_txn_open_body's own free-slot scan
  // starts at slot 0, so the returned cap_slot for the txn cap may
  // fall outside 136..143 depending on the rest of boot state -- this
  // witness bypasses cap_invoke_dispatch entirely, so the exact slot
  // does not matter to the assertions below. Same shape as pxor_clear
  // in pdxfs_txn_ops_real_synth.pdx, one slot-range up.
  // ==========================================================================
  pub let pkgi_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R52.M8-003 (#1723) boot witness helper: clear cap_table slots 136..143 for the pkg-install witness. Same shape as pxor_clear in pdxfs_txn_ops_real_synth.pdx (one slot-range up). One callee-save push (rbx) leaves rsp%16 == 0 for the nested cap_mint_write call. Labels prefixed pkgi_c_.",
      block: {
        push rbx;
        mov rbx, 136;
      pkgi_c_loop:
        cmp rbx, 144;
        jae pkgi_c_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp pkgi_c_loop;
      pkgi_c_done:
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // pkgi_open(mode, txn_id, wal_off) -> row_id (bounded < PXT_MAX = 16)
  //
  // Mint a fresh txn cap over the KIND_MEMORY parent at slot 136 via
  // the real sys_pdxfs_txn_open_body syscall entry, then resolve its
  // row_id via pdxfs_txn_row_of_slot. Returns 0xFF (PXT_ROW_NONE) or
  // any >= PXT_MAX sentinel on any failure so the caller can range-
  // check with the same `jae pkgi_fail_stage` pattern the sibling
  // witness uses. Three callee-save pushes align rsp%16 == 0 across
  // the two nested cross-file calls.
  // ==========================================================================
  pub let pkgi_open : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (mode: u64) (txn_id: u64) (wal_off: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R52.M8-003 (#1723) boot witness helper: compose sys_pdxfs_txn_open_body + pdxfs_txn_row_of_slot into a single row_id-returning primitive. Parent slot pinned at 136 (this witness's own KIND_MEMORY parent, minted in stage 1 of pdxfs_pkg_install_witness). Mirrors pxor_open in pdxfs_txn_ops_real_synth.pdx one-for-one, one slot-range up. Three callee-save pushes (r12/r13/r14) leave rsp%16 == 0. Effect widening ({mem, sysreg}) matches sys_pdxfs_txn_open_body's own row so no authority is added beyond what the callee already justified. Labels prefixed pkgi_o_.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;                        // mode
        mov r13, rsi;                        // txn_id
        mov r14, rdx;                        // wal_off

        mov rdi, 136;                        // parent_slot
        mov rsi, r12;                        // mode
        mov rdx, r13;                        // txn_id
        mov rcx, r14;                        // wal_off
        call sys_pdxfs_txn_open_body;

        // sys_pdxfs_txn_open_body returns a cap_slot in [0, 256) on
        // success; any error is >= 0xFFFFEC10 (in particular ENFILE,
        // encoded as -33 = 0xFFFFFFFFFFFFFFDF, is >= 256).
        mov r10, 256;
        cmp rax, r10;
        jae pkgi_o_out;                      // forward the error verbatim

        // Resolve cap_slot -> row_id.
        mov rdi, rax;
        call pdxfs_txn_row_of_slot;
        // row_of_slot returns PXT_ROW_NONE (0xFF) on any failure; that
        // is >= PXT_MAX (16), so the same bound check the caller uses
        // catches it. Success (row < 16) falls through.

      pkgi_o_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // pdxfs_pkg_install_witness() -> 0 (OK) | 1 (FAIL)
  //
  // Five callee-save pushes leave rsp%16 == 0 at every nested call.
  // Register plan:
  //   rbx = the single txn row_id under exercise (stable across all
  //         four CREATE invocations and the terminal COMMIT)
  //   r15 = substrate-mode flag: 0 until any CREATE returns PXT_TAIL_
  //         BAD_ARG, then 1 for the remainder of the run -- selects
  //         which fingerprint the emit stage lands
  //   r12..r14 = scratch, freshly loaded before each use
  //
  // Every CREATE accepts EITHER 0 (live, mount-backed inode allocator
  // + journal wrote a JOP_INODE_WRITE + JOP_DENTRY_ADD pair) OR
  // 0xFFFFEC1E (PXT_TAIL_BAD_ARG, the substrate refusal each real M6
  // body documents for a boot with no PdxFS-block root mount). Any
  // other value is a hard failure (a stray tail code would name a
  // regression in either the txn seam or the M6 write-side body it
  // dispatched into).
  //
  // COMMIT is single-arm: rax == 0 required. commit_wal short-circuits
  // to PXT_OK when no root is mounted (pdxfs_txn_commit_wal's own
  // header), and the OPEN -> COMMITTED row transition is what this
  // stage pins in either mode -- it is the closest thing this witness
  // has to a mount-agnostic invariant, and it is what makes the
  // SUBSTRATE fingerprint meaningful (a run where COMMIT itself
  // regressed would fail here rather than emit a false-positive).
  // ==========================================================================
  pub let pdxfs_pkg_install_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R52.M8-003 (#1723) pkg-install boot witness. Opens ONE KIND_PDXFS_TXN row (mode PXT_MODE_CREATE = 1, txn_id 0xE010, wal_off 0x7000), then for each of four simulated pkg-file names (bin/lib/man/etc -- the four canonical directories every pkg install lands under) stages the name via pdxfs_txn_stage_create_name and invokes PXT_OP_CREATE via cap_handler_pdxfs_txn with target_ptr = row_id. Each CREATE accepts EITHER 0 (live -- a mounted PdxFS-block root wired the journal + inode allocator through) OR PXT_TAIL_BAD_ARG (0xFFFFEC1E -- the documented substrate refusal per pdxfs_txn_do_create's own header when no PdxFS-block root mount is present). Any other value is a hard failure. If ANY create returned PXT_TAIL_BAD_ARG the witness records substrate mode via r15 = 1 and will emit the substrate fingerprint after commit; otherwise all four landed live and it emits the live fingerprint. PXT_OP_COMMIT runs unconditionally afterwards (commit_wal short-circuits to PXT_OK when no root is mounted, matching pdxfs_txn_commit_wal's own header -- the OPEN -> COMMITTED transition is what the fingerprint pins), and the row state is read back and verified == PXT_STATE_COMMITTED (2). Direct call to cap_handler_pdxfs_txn bypasses cap_invoke_dispatch so a failure names the M6 op-code seam without dragging in the kind-dispatch cascade, matching the sibling pdxfs_txn_ops_real_synth.pdx's own precedent. Five callee-save pushes (rbx/r12/r13/r14/r15) leave rsp%16 == 0. Effects/capabilities widen to match the widest nested call (sys_pdxfs_txn_open_body -> {mem, sysreg} @ {cap} plus boot for klog_s1). Labels prefixed pkgi_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // ==================================================================
        // (1) Reset. Scrub cap slots 136..143, reset the transaction
        //     table, mint a KIND_MEMORY parent at slot 136 carrying
        //     RIGHT_MINT so sys_pdxfs_txn_open_body has a valid parent
        //     to land against.
        // ==================================================================
        mov rax, 1;
        lea rcx, [rip + _pkgi_stage];
        mov [rcx], rax;
        call pkgi_clear;
        call pdxfs_txn_table_reset;
        mov rdi, 136;
        mov rsi, 0xF140;                     // opaque parent key
        mov rdx, 0x200;                      // RIGHT_MINT
        call pkgi_mem;

        // ==================================================================
        // (2) Open ONE transaction that will hold the whole pkg install.
        //     Mode CREATE (PXT_MODE_CREATE = 1). Bound-check row < PXT_
        //     MAX (16) -- the mint walker's error taxonomy encodes every
        //     failure at >= 0xFFFFEC10 and pdxfs_txn_row_of_slot returns
        //     0xFF (PXT_ROW_NONE) on any failure; both are >= 16 so the
        //     same `jae` catches them.
        // ==================================================================
        mov rax, 2;
        lea rcx, [rip + _pkgi_stage];
        mov [rcx], rax;
        mov rdi, 1;                          // PXT_MODE_CREATE
        mov rsi, 0xE010;                     // txn_id
        mov rdx, 0x7000;                     // wal_off
        call pkgi_open;
        mov r10, 16;                         // PXT_MAX
        cmp rax, r10;
        jae pkgi_fail_stage;
        mov rbx, rax;                        // rbx = row_id (survives loop)

        // r15 = 0 = live-assumed; any CREATE returning PXT_TAIL_BAD_ARG
        // flips it to 1 and selects the substrate fingerprint below.
        xor r15, r15;

        // ==================================================================
        // (3) Journal pkg file (a): stage "bin" -> PXT_OP_CREATE.
        //     Accept {0 | PXT_TAIL_BAD_ARG}. Same row (rbx) is reused
        //     for every create in this transaction; pdxfs_txn_stage_
        //     create_name's per-row staging slot is repeatedly
        //     overwritten with the next name -- see that function's
        //     own header (name lookup is row-indexed, one target at a
        //     time, valid until the next stage on the same row).
        // ==================================================================
        mov rax, 3;
        lea rcx, [rip + _pkgi_stage];
        mov [rcx], rax;

        mov rdi, rbx;                        // row_id
        lea rsi, [rip + pkgi_n1];
        mov rdx, 3;                          // name_len
        call pdxfs_txn_stage_create_name;

        mov rdi, 0x008;                      // R_PDXFS_TXN_INVOKE
        mov rsi, rbx;                        // target_ptr = row_id
        mov rdx, 9;                          // PXT_OP_CREATE
        call cap_handler_pdxfs_txn;
        cmp rax, 0;
        je  pkgi_c1_ok;
        mov r11, 0xFFFFEC1E;                 // PXT_TAIL_BAD_ARG
        cmp rax, r11;
        jne pkgi_fail_stage;
        mov r15, 1;                          // substrate mode
      pkgi_c1_ok:

        // ==================================================================
        // (4) Journal pkg file (b): stage "lib" -> PXT_OP_CREATE.
        // ==================================================================
        mov rax, 4;
        lea rcx, [rip + _pkgi_stage];
        mov [rcx], rax;

        mov rdi, rbx;
        lea rsi, [rip + pkgi_n2];
        mov rdx, 3;
        call pdxfs_txn_stage_create_name;

        mov rdi, 0x008;
        mov rsi, rbx;
        mov rdx, 9;
        call cap_handler_pdxfs_txn;
        cmp rax, 0;
        je  pkgi_c2_ok;
        mov r11, 0xFFFFEC1E;
        cmp rax, r11;
        jne pkgi_fail_stage;
        mov r15, 1;
      pkgi_c2_ok:

        // ==================================================================
        // (5) Journal pkg file (c): stage "man" -> PXT_OP_CREATE.
        // ==================================================================
        mov rax, 5;
        lea rcx, [rip + _pkgi_stage];
        mov [rcx], rax;

        mov rdi, rbx;
        lea rsi, [rip + pkgi_n3];
        mov rdx, 3;
        call pdxfs_txn_stage_create_name;

        mov rdi, 0x008;
        mov rsi, rbx;
        mov rdx, 9;
        call cap_handler_pdxfs_txn;
        cmp rax, 0;
        je  pkgi_c3_ok;
        mov r11, 0xFFFFEC1E;
        cmp rax, r11;
        jne pkgi_fail_stage;
        mov r15, 1;
      pkgi_c3_ok:

        // ==================================================================
        // (6) Journal pkg file (d): stage "etc" -> PXT_OP_CREATE.
        // ==================================================================
        mov rax, 6;
        lea rcx, [rip + _pkgi_stage];
        mov [rcx], rax;

        mov rdi, rbx;
        lea rsi, [rip + pkgi_n4];
        mov rdx, 3;
        call pdxfs_txn_stage_create_name;

        mov rdi, 0x008;
        mov rsi, rbx;
        mov rdx, 9;
        call cap_handler_pdxfs_txn;
        cmp rax, 0;
        je  pkgi_c4_ok;
        mov r11, 0xFFFFEC1E;
        cmp rax, r11;
        jne pkgi_fail_stage;
        mov r15, 1;
      pkgi_c4_ok:

        // ==================================================================
        // (7) Commit the whole transaction. commit_wal short-circuits
        //     to PXT_OK when no root PdxFS-block mount is present, so
        //     the row-transition arm (OPEN -> COMMITTED) is what this
        //     stage pins in either mode. Anything other than 0 fails
        //     (a stray tail code would name a regression in either the
        //     txn seam or pdxfs_txn_commit_wal).
        // ==================================================================
        mov rax, 7;
        lea rcx, [rip + _pkgi_stage];
        mov [rcx], rax;

        mov rdi, 0x008;
        mov rsi, rbx;
        mov rdx, 7;                          // PXT_OP_COMMIT
        call cap_handler_pdxfs_txn;
        cmp rax, 0;
        jne pkgi_fail_stage;

        // ==================================================================
        // (8) Verify state advanced OPEN -> COMMITTED. This is the
        //     mount-agnostic invariant that makes the SUBSTRATE
        //     fingerprint meaningful.
        // ==================================================================
        mov rax, 8;
        lea rcx, [rip + _pkgi_stage];
        mov [rcx], rax;

        mov rdi, rbx;
        call pdxfs_txn_row_state;
        cmp rax, 2;                          // PXT_STATE_COMMITTED
        jne pkgi_fail_stage;

        // ==================================================================
        // (9) Emit the winning fingerprint. r15 selects live (0) vs
        //     substrate (1).
        // ==================================================================
        mov rdi, 3;                          // klog level INFO
        lea rsi, [rip + SUBSYS_BOOT];
        cmp r15, 0;
        jne pkgi_emit_substrate;
        lea rdx, [rip + pkgi_ok];
        jmp pkgi_emit_call;
      pkgi_emit_substrate:
        lea rdx, [rip + pkgi_subst_ok];
      pkgi_emit_call:
        call klog_s1;

        call pkgi_clear;
        call pdxfs_txn_table_reset;
        xor rax, rax;
        jmp pkgi_out;

      pkgi_fail_stage:
        lea rax, [rip + _pkgi_stage];
        mov r8, [rax];
        mov rdi, 1;                          // klog level PANIC
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + pkgi_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        call pkgi_clear;
        call pdxfs_txn_table_reset;
        mov rax, 1;

      pkgi_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
