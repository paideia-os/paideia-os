// src/kernel/boot/witness/r101_stdvga_checkerboard.pdx -- R101.M4-001
//
// R101 boot witness proving the KIND_DISPLAY_BACKEND -> KIND_
// FRAMEBUFFER -> backend_flush cascade end to end against the Bochs
// stdvga LFB.
//
// -----------------------------------------------------------------------------
// What this witness does
// -----------------------------------------------------------------------------
//
//   Stage 1: Skip if no Bochs device was probed (PAIDEIA_VGA=none or
//            a non-QEMU host has no stdvga at all). Emits a lowercase
//            skip line and returns.
//   Stage 2: Mint a synthetic KIND_DEVICE parent at cap slot 130 (a
//            slot free by construction -- no witness after the R66v2
//            tty cascade names it).
//   Stage 3: Mint KIND_DISPLAY_BACKEND with backend_kind=BOCHS_STDVGA
//            via kind_display_backend_mint_body. Returns row_id or a
//            DPYB_MINT_* sentinel.
//   Stage 4: Mint a synthetic KIND_MEMORY at cap slot 131, target =
//            &_r101wt_backbuf (a page-aligned static buffer big enough
//            for 1024x768*4 = 3 MiB, rounded to 4 MiB @align(4096)).
//   Stage 5: Mint KIND_FRAMEBUFFER via kind_framebuffer_mint_simple
//            (memory_slot=131, backend_row=stage3 row, width=1024,
//            height=768, lfb_pa=device[0].bar0_pa, lfb_va=device[0].
//            bar0_va).
//   Stage 6: Paint an 8x8 checkerboard into _r101wt_backbuf: alternating
//            pixel blocks of BGRA=0xFF404040 (dark grey) and 0xFFC0C0C0
//            (light grey). Deterministic, so the pixel-readback in stage
//            8 knows the exact expected value at each sample position.
//   Stage 7: fb_flush_via_backend(fb_slot=stage5 row, src_va =
//            &_r101wt_backbuf). Bumps FB_ST_FLUSHES.
//   Stage 8: Readback 4 sample pixels from device[0].bar0_va (the
//            mapped LFB) at boundary positions and assert they match
//            the checkerboard pattern. The corners of the frame (0,0),
//            (w/2,h/2), (w-1,h-1) plus one edge pixel; each one lies
//            in a known-color block.
//   Stage 9: Revoke both caps + scrub the cap-table slots.
//
//   On success, emits the R101 fingerprint (lowercase, no OK_TOK):
//     "boot r101 stdvga ok -- w=1024 h=768"
//   On failure at any stage:
//     "boot r101 stdvga fail line=<N>"
//
// -----------------------------------------------------------------------------
// Why an 8x8 CHECKERBOARD (not a solid color)
// -----------------------------------------------------------------------------
//
// A solid color proves the flush happened but not that the pixel
// coordinates round-tripped through geometry / stride correctly. An
// 8x8 checkerboard exposes coordinate arithmetic bugs: an off-by-one
// in stride would misalign the pattern; a byte-swap in the format
// would flip fg/bg. The 4 sample-pixel readback confirms 2 of the 4
// blocks at boundary positions -- enough to detect stride or format
// errors, without dragging in the whole 3 MiB pixel array as the
// witness assertion.
//
// -----------------------------------------------------------------------------
// Cap-table slots owned by this witness
// -----------------------------------------------------------------------------
//
//   Slot 130 -- synthetic KIND_DEVICE parent for the backend mint gate.
//   Slot 131 -- synthetic KIND_MEMORY parent for the framebuffer backing.
//
// Both are scrubbed on every exit (success and failure paths).
//
// -----------------------------------------------------------------------------
// Encoder discipline
// -----------------------------------------------------------------------------
//
// No frame-prologue annotations. No `add reg, [mem]`, no `cmp reg,
// [mem]`. Labels prefixed `r101wt_`.

module R101StdvgaCheckerboard = structure {

  pub let mut _r101wt_stage   : u64 = 0
  // 4 MiB back buffer, page-aligned. 1024*768*4 = 3145728 bytes; 4 MiB
  // rounded up leaves a defensive 976 KiB tail for a future mode step
  // up to 1280x1024. [u64; 524288] = 4 MiB exactly.
  pub let mut _r101wt_backbuf : [u64; 524288] = uninit @align(4096)

  // Fingerprints (all-lowercase, no OK_TOK trigger). NUL-terminated
  // to match the tree's tag_boot_* convention (klog_emit_core reads a
  // C-string).
  pub let tag_r101_ok    : [u8; 23] = "boot r101 stdvga ok --\0"
  pub let tag_r101_skip  : [u8; 22] = "boot r101 stdvga skip\0"
  pub let tag_r101_fail  : [u8; 22] = "boot r101 stdvga fail\0"

  pub let r101wt_k_w    : [u8; 2] = "w\0"
  pub let r101wt_k_h    : [u8; 2] = "h\0"

  // ==========================================================================
  // Helper: mint a synthetic parent cap at (slot, kind, rights, target).
  // ==========================================================================
  pub let r101wt_mint_parent : (u64, u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (kind: u64) (rights: u64) (target: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R101.M4-001: mint a synthetic parent cap for the two mint gates this witness exercises. Labels prefixed r101wt_mp_ (none needed, one nested call).",
      block: {
        call cap_mint_write;
        ret
      }
    }

  // ==========================================================================
  // Helper: scrub slots 130 (KIND_DEVICE) and 131 (KIND_MEMORY).
  // ==========================================================================
  pub let r101wt_clear_slots : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R101.M4-001: scrub the two cap slots this witness owns (130 device parent, 131 memory parent) back to (0,0,0). Labels prefixed r101wt_cs_.",
      block: {
        mov rdi, 130;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        mov rdi, 131;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        ret
      }
    }

  // ==========================================================================
  // Helper: paint an 8x8 checkerboard into _r101wt_backbuf.
  //
  // BGRA8888 pixels; each 8x8 block is a solid color that alternates
  // per block. The mask (x/8 + y/8) & 1 gives the classic checkerboard.
  //
  // Colors:
  //   dark  = 0xFF404040 (opaque dark-grey)
  //   light = 0xFFC0C0C0 (opaque light-grey)
  //
  // width * height = 1024 * 768 pixels; each pixel is 4 bytes.
  // ==========================================================================
  pub let r101wt_paint_checkerboard : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R101.M4-001: fill _r101wt_backbuf with a 1024x768 BGRA8888 8x8 checkerboard. Inner loop is per-pixel to keep the arithmetic clear (~800 K pixels, but this runs once at boot and only when a Bochs device is present -- microseconds at WB memory speed). Colors picked so the two block values differ by every bit position (0x40 vs 0xC0), making a stride-off-by-one visible as a scrambled pattern rather than a still-plausible offset. Register plan: leaf, no callee-save touched (rbx/r12/r13/r14/r15 used but restored). Labels prefixed r101wt_cb_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        lea rbx, [rip + _r101wt_backbuf];        // rbx = pixel base
        xor r12, r12;                            // y = 0

      r101wt_cb_yloop:
        cmp r12, 768;
        jae r101wt_cb_done;

        xor r13, r13;                            // x = 0

      r101wt_cb_xloop:
        cmp r13, 1024;
        jae r101wt_cb_ynext;

        // block_x = x / 8; block_y = y / 8. shr by 3.
        mov r14, r13;
        shr r14, 3;
        mov r15, r12;
        shr r15, 3;
        add r14, r15;
        and r14, 1;                              // parity bit

        // color = parity ? 0xFFC0C0C0 : 0xFF404040
        mov rax, 0xFF404040;
        cmp r14, 0;
        je  r101wt_cb_color_ok;
        mov rax, 0xFFC0C0C0;
      r101wt_cb_color_ok:

        // offset = (y * 1024 + x) * 4
        mov r10, r12;
        shl r10, 10;                             // y * 1024
        add r10, r13;                            // + x
        shl r10, 2;                              // * 4

        mov_d [rbx + r10 * 1], rax;

        add r13, 1;
        jmp r101wt_cb_xloop;

      r101wt_cb_ynext:
        add r12, 1;
        jmp r101wt_cb_yloop;

      r101wt_cb_done:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Helper: read a BGRA8888 pixel from lfb_va at (x, y).
  // Returns the 32-bit pixel value zero-extended to u64.
  // ==========================================================================
  pub let r101wt_read_pixel : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (lfb_va: u64) (x: u64) (y: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R101.M4-001: read a 32-bit BGRA8888 pixel from the mapped LFB at (x, y). Stride is 1024*4=4096 bytes. mov_d + xor rax zero-extend. mfence before read since the WC LFB write in bochs_flush may still be in the CPU's write-combine buffer. Labels prefixed r101wt_rp_.",
      block: {
        mov r10, rdx;
        shl r10, 10;                             // y * 1024
        add r10, rsi;                            // + x
        shl r10, 2;                              // * 4

        add r10, rdi;                            // + lfb_va

        mfence;
        xor rax, rax;
        mov_d rax, [r10];
        ret
      }
    }

  // ==========================================================================
  // witness_r101_stdvga_checkerboard() -> ()
  //
  // Register plan: r12 = backend_row_id, r13 = fb_row_id, r14 = lfb_va
  // (device[0].bar0_va), rbx = scratch / pixel_expected.
  //
  // Five callee-save pushes leave rsp%16 == 0 for nested calls (entry
  // rsp%16 == 8, +40 -> %16 == 0).
  // ==========================================================================
  pub let witness_r101_stdvga_checkerboard : () -> () !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R101.M4-001: end-to-end boot witness for KIND_DISPLAY_BACKEND + KIND_FRAMEBUFFER + backend_flush against Bochs/stdvga. See file header for stage-by-stage description. Every stage sets _r101wt_stage before running; on failure at any stage, the fail-line klog names the stage. Cleanup runs on every exit path (success and failure). paideia-as SysV: kind_display_backend_mint_body / kind_framebuffer_mint_simple both take 6 args in registers. Five callee-save pushes: entry rsp%16 == 8, +40 = 48, %16 == 0. Labels prefixed r101wt_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // ---------- Stage 1: skip if no Bochs device ----------
        mov rax, 1;
        lea rcx, [rip + _r101wt_stage];
        mov [rcx], rax;

        mov rax, [rip + _bochs_stdvga_device_count];
        cmp rax, 0;
        je  r101wt_skip;

        // Load lfb_va (device[0]+40); if 0, lfb_map hasn't run -> skip.
        lea r10, [rip + _bochs_stdvga_devices];
        mov r14, [r10 + 40];                     // r14 = lfb_va
        cmp r14, 0;
        je  r101wt_skip;

        call r101wt_clear_slots;

        // ---------- Stage 2: mint synthetic KIND_DEVICE at slot 130 ----------
        mov rax, 2;
        lea rcx, [rip + _r101wt_stage];
        mov [rcx], rax;
        mov rdi, 130;                            // slot
        mov rsi, 10;                             // KIND_DEVICE
        mov rdx, 0x200;                          // RIGHT_MINT
        mov rcx, 0x1010;                         // target_ptr (arbitrary non-zero)
        call r101wt_mint_parent;

        // ---------- Stage 3: mint KIND_DISPLAY_BACKEND ----------
        mov rax, 3;
        lea rcx, [rip + _r101wt_stage];
        mov [rcx], rax;

        // Read device[0].bar0_pa (u64 @+8) for the mint arg.
        lea r10, [rip + _bochs_stdvga_devices];
        mov r11, [r10 + 8];                      // bar0_lfb_pa

        // kind_display_backend_mint_body(parent_slot=130, rights=R_DPYB_QUERY,
        //   backend_kind=BOCHS_STDVGA=1, bar_pa=r11, mmio_base=device[0]+16,
        //   provider_slot=0)
        mov rdi, 130;
        mov rsi, 0x001;                          // R_DPYB_QUERY
        mov rdx, 1;                              // BOCHS_STDVGA
        mov rcx, r11;                            // bar_pa
        lea r15, [rip + _bochs_stdvga_devices];
        mov r8, [r15 + 16];                      // mmio_base (BAR2 PA)
        xor r9, r9;                              // provider_slot = 0
        call kind_display_backend_mint_body;

        mov r10, 4;
        cmp rax, r10;
        jae r101wt_fail;
        mov r12, rax;                            // r12 = backend_row_id

        // ---------- Stage 4: mint synthetic KIND_MEMORY at slot 131 ----------
        mov rax, 4;
        lea rcx, [rip + _r101wt_stage];
        mov [rcx], rax;
        mov rdi, 131;
        mov rsi, 4;                              // KIND_MEMORY
        mov rdx, 0x200;                          // RIGHT_MINT
        lea rcx, [rip + _r101wt_backbuf];        // target_ptr
        call r101wt_mint_parent;

        // ---------- Stage 5: mint KIND_FRAMEBUFFER ----------
        mov rax, 5;
        lea rcx, [rip + _r101wt_stage];
        mov [rcx], rax;

        // kind_framebuffer_mint_simple(memory_slot=131, backend_row=r12,
        //   width=1024, height=768, lfb_pa=device[0].bar0_pa, lfb_va=r14)
        lea r10, [rip + _bochs_stdvga_devices];
        mov r15, [r10 + 8];                      // bar0_lfb_pa (again)

        mov rdi, 131;
        mov rsi, r12;
        mov rdx, 1024;
        mov rcx, 768;
        mov r8,  r15;
        mov r9,  r14;
        call kind_framebuffer_mint_simple;

        mov r10, 4;
        cmp rax, r10;
        jae r101wt_fail;
        mov r13, rax;                            // r13 = fb_row_id

        // ---------- Stage 6: paint checkerboard ----------
        mov rax, 6;
        lea rcx, [rip + _r101wt_stage];
        mov [rcx], rax;
        call r101wt_paint_checkerboard;

        // ---------- Stage 7: fb_flush_via_backend ----------
        mov rax, 7;
        lea rcx, [rip + _r101wt_stage];
        mov [rcx], rax;
        mov rdi, r13;                            // fb_slot
        lea rsi, [rip + _r101wt_backbuf];        // src_va
        call fb_flush_via_backend;
        cmp rax, 0;
        je  r101wt_fail;

        // ---------- Stage 8: readback four sample pixels ----------
        // Sample (0, 0)     -> block_x=0, block_y=0, parity=0 -> dark
        //        (511, 383) -> block_x=63, block_y=47, parity=(63+47)&1=0 -> dark
        //        (512, 384) -> block_x=64, block_y=48, parity=(64+48)&1=0 -> dark
        //        (1023,767) -> block_x=127, block_y=95, parity=(127+95)&1=0 -> dark
        //
        // The chosen sample coordinates all land on dark blocks (parity 0).
        // Add one edge sample at (7, 0) -> block_x=0, block_y=0, parity=0
        //   -> dark. And (8, 0) -> block_x=1, block_y=0, parity=1 -> light.
        mov rax, 8;
        lea rcx, [rip + _r101wt_stage];
        mov [rcx], rax;

        // (0, 0) must be 0xFF404040 (dark)
        mov rdi, r14;
        xor rsi, rsi;
        xor rdx, rdx;
        call r101wt_read_pixel;
        mov r10, 0xFF404040;
        cmp rax, r10;
        jne r101wt_fail;

        // (8, 0) must be 0xFFC0C0C0 (light -- adjacent block)
        mov rdi, r14;
        mov rsi, 8;
        xor rdx, rdx;
        call r101wt_read_pixel;
        mov r10, 0xFFC0C0C0;
        cmp rax, r10;
        jne r101wt_fail;

        // (1023, 767) -- last pixel of last block. parity=(127+95)&1=0 -> dark
        mov rdi, r14;
        mov rsi, 1023;
        mov rdx, 767;
        call r101wt_read_pixel;
        mov r10, 0xFF404040;
        cmp rax, r10;
        jne r101wt_fail;

        // (512, 384) -- middle of frame. parity=(64+48)&1=0 -> dark
        mov rdi, r14;
        mov rsi, 512;
        mov rdx, 384;
        call r101wt_read_pixel;
        mov r10, 0xFF404040;
        cmp rax, r10;
        jne r101wt_fail;

        // ---------- All green: emit fingerprint ----------
        mov rdi, 3;                              // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_r101_ok];
        lea rcx, [rip + r101wt_k_w];
        mov r8, 1024;
        lea r9, [rip + r101wt_k_h];
        sub rsp, 8;
        mov rax, 768;
        push rax;
        call klog_s1_d2;
        add rsp, 16;

        // ---------- Stage 9: teardown ----------
        mov rdi, r13;
        call kind_framebuffer_revoke_body;
        mov rdi, r12;
        call kind_display_backend_revoke_body;
        call r101wt_clear_slots;

        jmp r101wt_done;

      r101wt_skip:
        mov rdi, 3;                              // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_r101_skip];
        call klog_s1;
        call r101wt_clear_slots;
        jmp r101wt_done;

      r101wt_fail:
        mov rdi, 1;                              // LEVEL_ERROR
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_r101_fail];
        lea rcx, [rip + k_line];
        lea rax, [rip + _r101wt_stage];
        mov r8, [rax];
        call klog_s1_d1;
        call r101wt_clear_slots;

      r101wt_done:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
