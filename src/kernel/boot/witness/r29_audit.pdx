// src/kernel/boot/witness/r29_audit.pdx — boot witness module
//
// Extracted verbatim from src/kernel/boot/kernel_main.pdx (which had grown
// to 24,315 lines in two functions).  R29.M6 witness block — the driver audit channel.
//
// -----------------------------------------------------------------------------
// Why the body is copied and not rewritten
// -----------------------------------------------------------------------------
//
// The goldens for this tree assert an ORDERED SUBSEQUENCE of fingerprints
// across 14 boot modes, and a witness that silently stops running still
// leaves most of that subsequence intact.  The extraction therefore moves
// the instruction stream unchanged: the only bytes this module adds around
// it are the `push rbp` / `pop rbp` / `ret` below.
//
// -----------------------------------------------------------------------------
// The push is not decoration
// -----------------------------------------------------------------------------
//
// `boot_continue_after_ring3` runs its body at `rsp % 16 == 8` — it sits two `call` levels
// below `_start`, and paideia-as emits no frame prologue for an
// `unsafe`-bodied lambda (emit_visit_lambda.rs suppresses the prologue for
// Unsafe bodies, which is also why `@no_frame` is a no-op there).  Several
// witnesses in this file reason explicitly about that parity — "3 pushes from %16==8
// yields (8+3*8)%16 == 0" — and a bare `call` into a bare body would enter
// at `%16 == 0` and invert every one of those arguments.  The single
// `push rbp` restores the inline parity exactly; the matching `pop rbp`
// keeps rbp's SysV guarantee for the caller.
//
// Sections in this module, in the order boot_continue_after_ring3 ran them:
//   * R29.M6-001..004 (#1040/#1041/#1042/#1043): driver_audit_channel

module R29Audit = structure {

  // witness_r29_audit() — the R29.M6 witness block — the driver audit channel.
  //
  // Effect and capability rows are the ones the enclosing
  // `boot_continue_after_ring3` declares.  They are not widened here: this
  // is the same instruction stream under a new symbol, so the authority it
  // needs is by construction the authority it already had.
  pub let witness_r29_audit : () -> () !{sysreg} @{} = fn () -> unsafe {
    effects: { sysreg },
    capabilities: { boot },
    justification: "Boot witness block lifted verbatim out of kernel_main.pdx's boot_continue_after_ring3 during the r29_audit extraction. Body bytes are unchanged from the inline form; the only additions are the entry `push rbp` and the exit `pop rbp; ret`. The push is load-bearing rather than cosmetic: boot_continue_after_ring3 executes its body at rsp%16 == 8 (two `call` levels below _start, with no frame prologue emitted for unsafe-bodied lambdas), and the witnesses inside this module compute their own nested-call alignment from that parity. Entering through a `call` without the compensating push would present rsp%16 == 0 to the body and silently invert every such argument — the failure mode of paideia-os #1192, #1195 and #1584. Effects and capabilities are copied unchanged from the enclosing function for the same reason: no authority is added, so none needs justifying beyond what boot_continue_after_ring3 already justified.",
    block: {
      push rbp;

      // ============================================================
      // R29.M6-001..004 (#1040/#1041/#1042/#1043): driver_audit_channel
      // — sealed one-way stream, emission inside the mint/revoke/handoff
      // primitives, descriptor-count reconciliation, and blob-driver
      // audit parity.
      //
      // Under test:
      //   src/kernel/core/driver/audit_channel.pdx       (#1040/#1042)
      //   src/kernel/core/cap/kind_hw_interrupt.pdx      (#1041 wrappers)
      //   src/kernel/core/cap/kind_hw_msix_vector.pdx    (#1041 wrappers)
      //   src/kernel/core/cap/kind_dma_domain.pdx        (#1041 wrappers)
      //   src/kernel/core/driver/lifecycle.pdx           (#1041 handoff)
      // Schema: design/ipc/driver-audit-schema.md
      // Policy: design/drivers/blob-policy.md §3 (D1.c).
      //
      // The claims this witness exists to pin, in order of how easy
      // they would be to leave as adjectives:
      //
      //   "sealed"      — stages 13..16 CORRUPT retained records and
      //                   require the checks to trip. A gap check that
      //                   never trips and a seal check that never trips
      //                   are indistinguishable from `return 0`, and a
      //                   witness that only ever feeds them clean input
      //                   proves exactly nothing about either.
      //   "unforgeable
      //    ordering"    — stage 3 and stage 6 pin that each record
      //                   carries its OWN sequence number, which is what
      //                   makes a hole detectable by position.
      //   "emission is
      //    in the
      //    primitive"   — stage 7 mints through a path that FAILS and
      //                   still finds a record. A call-site instrument
      //                   would have recorded only the successes.
      //   "conservable" — stages 8..11 and 18..20 reconcile the audit
      //                   stream's account of mint/revoke against an
      //                   independently scanned live descriptor count,
      //                   across a cascade that destroys three
      //                   descriptors from one call.
      //   "blob parity" — stages 23..24 run identical capability work on
      //                   a path that has produced a blob-signature
      //                   verdict and a path that has not, and require
      //                   the audit records to be indistinguishable.
      //
      // Cap slots used (all above anything an earlier witness touches):
      //   110  KIND_HW ancestor, minted here, cleared at the end
      //   111  KIND_HW_INTERRUPT (mint/revoke pair)
      //   112  KIND_HW_INTERRUPT (mint/revoke pair)
      //   113  KIND_HW_INTERRUPT (cascade parent)
      //   114  KIND_HW_MSIX_VECTOR (cascade child)
      //   115  KIND_HW_MSIX_VECTOR (cascade child)
      //   116  KIND_HW_INTERRUPT (native path, stage 23)
      //   117  KIND_HW_INTERRUPT (blob path, stage 23)
      // Driver table slot 5 carries the handoff (stages 21..22).
      //
      // Register plan: r12..r15 only. Every function this witness calls
      // preserves them (the audit wrappers push r12/r13/r14,
      // drv_audit_emit pushes rbx and r12..r15), so they survive nested
      // calls; anything that must outlive more than one stage goes to
      // _drv_audit_wit_* in .data rather than depending on that.
      //
      // Marker ordering in the golden log:
      //   R29 BLOB DUALSIG OK
      //   R29 DRIVER AUDIT OK     <- THIS WITNESS
      // ============================================================
      drv_audit_witness:
          // --- Stage 0: KIND_HW ancestor + baseline snapshots ---
          xor  rax, rax
          lea  rcx, [rip + _drv_audit_wit_stage]
          mov  [rcx + 0], rax

          mov  rdi, 110                            // slot
          mov  rsi, 14                             // KIND_HW
          mov  rdx, 0x600                          // RIGHT_OBSERVE|RIGHT_MINT
          mov  rcx, 0xDEADBEEF
          call cap_mint_write

          call drv_audit_seq
          lea  rcx, [rip + _drv_audit_wit_seq0]
          mov  [rcx + 0], rax
          mov  r15, rax                            // r15 = seq0

          mov  rdi, 0x140
          call drv_audit_live_count
          lea  rcx, [rip + _drv_audit_wit_live0]
          mov  [rcx + 0], rax
          mov  r14, rax                            // r14 = live0 for 0x140

          // --- Stage 1: mint slot 111; the stream grows by exactly one ---
          mov  rax, 1
          lea  rcx, [rip + _drv_audit_wit_stage]
          mov  [rcx + 0], rax

          mov  rdi, 111
          mov  rsi, 110
          mov  rdx, 0x618                          // R_HW_INT_ALL
          mov  rcx, 0x50                           // gsi
          mov  r8,  0x01                           // affinity
          mov  r9,  0                              // edge
          call hw_int_cap_mint
          cmp  rax, 0
          jne  drv_audit_witness_fail

          call drv_audit_seq
          mov  rcx, r15
          add  rcx, 1
          cmp  rax, rcx
          jne  drv_audit_witness_fail

          // --- Stage 2: the newest record says what happened ---
          mov  rax, 2
          lea  rcx, [rip + _drv_audit_wit_stage]
          mov  [rcx + 0], rax

          xor  rdi, rdi
          mov  rsi, 1                              // F_EVENT
          call drv_audit_field
          cmp  rax, 1                              // EV_MINT
          jne  drv_audit_witness_fail

          xor  rdi, rdi
          mov  rsi, 2                              // F_KIND
          call drv_audit_field
          mov  rcx, 0x140
          cmp  rax, rcx
          jne  drv_audit_witness_fail

          xor  rdi, rdi
          mov  rsi, 3                              // F_SUBJECT
          call drv_audit_field
          cmp  rax, 111
          jne  drv_audit_witness_fail

          xor  rdi, rdi
          mov  rsi, 4                              // F_PRINCIPAL
          call drv_audit_field
          cmp  rax, 110
          jne  drv_audit_witness_fail

          xor  rdi, rdi
          mov  rsi, 5                              // F_OUTCOME
          call drv_audit_field
          cmp  rax, 0
          jne  drv_audit_witness_fail

          // --- Stage 3: the record carries its OWN sequence number.
          //     This is what makes a hole detectable by position rather
          //     than by trusting the ring's write order ---
          mov  rax, 3
          lea  rcx, [rip + _drv_audit_wit_stage]
          mov  [rcx + 0], rax

          xor  rdi, rdi
          mov  rsi, 0                              // F_SEQ
          call drv_audit_field
          cmp  rax, r15
          jne  drv_audit_witness_fail

          // --- Stage 4: gap check clean ---
          mov  rax, 4
          lea  rcx, [rip + _drv_audit_wit_stage]
          mov  [rcx + 0], rax
          call drv_audit_gap_check
          cmp  rax, 0
          jne  drv_audit_witness_fail

          // --- Stage 5: seal check clean ---
          mov  rax, 5
          lea  rcx, [rip + _drv_audit_wit_stage]
          mov  [rcx + 0], rax
          call drv_audit_seal_check
          cmp  rax, 0
          jne  drv_audit_witness_fail

          // --- Stage 6: second mint; the stored seq advances by one ---
          mov  rax, 6
          lea  rcx, [rip + _drv_audit_wit_stage]
          mov  [rcx + 0], rax

          mov  rdi, 112
          mov  rsi, 110
          mov  rdx, 0x618
          mov  rcx, 0x51
          mov  r8,  0x01
          mov  r9,  0
          call hw_int_cap_mint
          cmp  rax, 0
          jne  drv_audit_witness_fail

          xor  rdi, rdi
          mov  rsi, 0                              // F_SEQ
          call drv_audit_field
          mov  rcx, r15
          add  rcx, 1
          cmp  rax, rcx
          jne  drv_audit_witness_fail

          // --- Stage 7: a REFUSED mint is recorded.
          //     slot 999 fails the bounds gate, so no descriptor is
          //     created and no state-based check could ever see this
          //     attempt. The record exists because the emission lives in
          //     the primitive, not at the call site ---
          mov  rax, 7
          lea  rcx, [rip + _drv_audit_wit_stage]
          mov  [rcx + 0], rax

          call drv_audit_seq
          mov  r13, rax                            // seq before the refusal

          mov  rdi, 999
          mov  rsi, 110
          mov  rdx, 0x618
          mov  rcx, 0x52
          mov  r8,  0x01
          mov  r9,  0
          call hw_int_cap_mint
          mov  rcx, 0xFFFFFFFA                     // HW_INT_MINT_BAD_ARG
          cmp  rax, rcx
          jne  drv_audit_witness_fail

          call drv_audit_seq
          mov  rcx, r13
          add  rcx, 1
          cmp  rax, rcx
          jne  drv_audit_witness_fail

          xor  rdi, rdi
          mov  rsi, 5                              // F_OUTCOME
          call drv_audit_field
          cmp  rax, 0
          je   drv_audit_witness_fail              // must be non-zero

          xor  rdi, rdi
          mov  rsi, 1                              // F_EVENT
          call drv_audit_field
          cmp  rax, 1                              // still an EV_MINT
          jne  drv_audit_witness_fail

          // --- Stage 8: balance counts the two successes and NOT the
          //     refusal. Counting refusals would make the balance
          //     disagree with the live descriptor count by exactly the
          //     number of times the supervisor was correctly told no ---
          mov  rax, 8
          lea  rcx, [rip + _drv_audit_wit_stage]
          mov  [rcx + 0], rax

          mov  rdi, 0x140
          mov  rsi, r15
          call drv_audit_balance_since
          cmp  rax, 2
          jne  drv_audit_witness_fail

          // --- Stage 9: revoke one -> balance 1 ---
          mov  rax, 9
          lea  rcx, [rip + _drv_audit_wit_stage]
          mov  [rcx + 0], rax

          mov  rdi, 111
          call hw_int_cap_revoke
          cmp  rax, 0
          jne  drv_audit_witness_fail

          mov  rdi, 0x140
          mov  rsi, r15
          call drv_audit_balance_since
          cmp  rax, 1
          jne  drv_audit_witness_fail

          // --- Stage 10: revoke the other -> balance 0 ---
          mov  rax, 10
          lea  rcx, [rip + _drv_audit_wit_stage]
          mov  [rcx + 0], rax

          mov  rdi, 112
          call hw_int_cap_revoke
          cmp  rax, 0
          jne  drv_audit_witness_fail

          mov  rdi, 0x140
          mov  rsi, r15
          call drv_audit_balance_since
          cmp  rax, 0
          jne  drv_audit_witness_fail

          // --- Stage 11: reconcile. The audit-derived balance and the
          //     independently scanned live count agree ---
          mov  rax, 11
          lea  rcx, [rip + _drv_audit_wit_stage]
          mov  [rcx + 0], rax

          mov  rdi, 0x140
          mov  rsi, r15
          mov  rdx, r14
          call drv_audit_reconcile
          cmp  rax, 0
          jne  drv_audit_witness_fail

          // --- Stage 12: gap + seal still clean after the churn ---
          mov  rax, 12
          lea  rcx, [rip + _drv_audit_wit_stage]
          mov  [rcx + 0], rax

          call drv_audit_gap_check
          cmp  rax, 0
          jne  drv_audit_witness_fail
          call drv_audit_seal_check
          cmp  rax, 0
          jne  drv_audit_witness_fail

          // --- Stage 13: TAMPER. Flip a bit in a retained record's
          //     outcome field and require the seal check to notice.
          //     Without this stage the seal is an adjective ---
          mov  rax, 13
          lea  rcx, [rip + _drv_audit_wit_stage]
          mov  [rcx + 0], rax

          mov  rdi, 1                              // one back from the head
          call drv_audit_rec_base
          cmp  rax, 0
          je   drv_audit_witness_fail
          mov  r12, rax                            // r12 = record base

          mov  rax, [r12 + 40]                     // F_OUTCOME
          lea  rcx, [rip + _drv_audit_wit_snap]
          mov  [rcx + 0], rax
          mov  rcx, 1
          xor  rax, rcx
          mov  [r12 + 40], rax

          call drv_audit_seal_check
          cmp  rax, 0
          je   drv_audit_witness_fail              // MUST trip

          // --- Stage 14: restore -> seal clean again. Proves the check
          //     tracks the data rather than latching a failure ---
          mov  rax, 14
          lea  rcx, [rip + _drv_audit_wit_stage]
          mov  [rcx + 0], rax

          lea  rcx, [rip + _drv_audit_wit_snap]
          mov  rax, [rcx + 0]
          mov  [r12 + 40], rax

          call drv_audit_seal_check
          cmp  rax, 0
          jne  drv_audit_witness_fail

          // --- Stage 15: TAMPER the stored sequence number and require
          //     the gap check to notice. This is the deletion /
          //     reordering signature: a record whose seq no longer
          //     matches the position it occupies ---
          mov  rax, 15
          lea  rcx, [rip + _drv_audit_wit_stage]
          mov  [rcx + 0], rax

          mov  rax, [r12 + 0]                      // F_SEQ
          lea  rcx, [rip + _drv_audit_wit_snap]
          mov  [rcx + 0], rax
          add  rax, 1
          mov  [r12 + 0], rax

          call drv_audit_gap_check
          cmp  rax, 0
          je   drv_audit_witness_fail              // MUST trip

          // --- Stage 16: restore -> gap and seal both clean ---
          mov  rax, 16
          lea  rcx, [rip + _drv_audit_wit_stage]
          mov  [rcx + 0], rax

          lea  rcx, [rip + _drv_audit_wit_snap]
          mov  rax, [rcx + 0]
          mov  [r12 + 0], rax

          call drv_audit_gap_check
          cmp  rax, 0
          jne  drv_audit_witness_fail
          call drv_audit_seal_check
          cmp  rax, 0
          jne  drv_audit_witness_fail

          // --- Stage 17: window bounds. A "since" query outside the
          //     retained window must be refused, not answered wrongly ---
          mov  rax, 17
          lea  rcx, [rip + _drv_audit_wit_stage]
          mov  [rcx + 0], rax

          mov  rdi, r15
          call drv_audit_window_ok
          cmp  rax, 1
          jne  drv_audit_witness_fail

          call drv_audit_seq
          add  rax, 1
          mov  rdi, rax
          call drv_audit_window_ok
          cmp  rax, 0
          jne  drv_audit_witness_fail

          // --- Stage 18: cascade churn. One revoke call destroys three
          //     descriptors (parent + two MSI-X children) ---
          mov  rax, 18
          lea  rcx, [rip + _drv_audit_wit_stage]
          mov  [rcx + 0], rax

          call drv_audit_seq
          lea  rcx, [rip + _drv_audit_wit_snap]
          mov  [rcx + 0], rax                      // seqC
          mov  r13, rax

          mov  rdi, 0x140
          call drv_audit_live_count
          lea  rcx, [rip + _drv_audit_wit_snap2]
          mov  [rcx + 0], rax                      // live count for 0x140

          mov  rdi, 0x141
          call drv_audit_live_count
          lea  rcx, [rip + _drv_audit_wit_snap3]
          mov  [rcx + 0], rax                      // live count for 0x141

          mov  rdi, 113
          mov  rsi, 110
          mov  rdx, 0x618
          mov  rcx, 0x53
          mov  r8,  0x01
          mov  r9,  0
          call hw_int_cap_mint
          cmp  rax, 0
          jne  drv_audit_witness_fail

          mov  rdi, 114
          mov  rsi, 113
          mov  rdx, 0x218                          // R_MSIX_ALL
          mov  rcx, 0x00
          mov  r8,  0x9001
          call msix_cap_mint
          cmp  rax, 0
          jne  drv_audit_witness_fail

          mov  rdi, 115
          mov  rsi, 113
          mov  rdx, 0x218
          mov  rcx, 0x10
          mov  r8,  0x9002
          call msix_cap_mint
          cmp  rax, 0
          jne  drv_audit_witness_fail

          mov  rdi, 113
          call hw_int_cap_revoke
          cmp  rax, 0
          jne  drv_audit_witness_fail

          // --- Stage 19: the cascade left ONE revoke record per child.
          //     If msix_cascade_revoke_by_parent had called the inner
          //     body instead of the audited symbol, this balance would
          //     read +2 and the leak would be invisible ---
          mov  rax, 19
          lea  rcx, [rip + _drv_audit_wit_stage]
          mov  [rcx + 0], rax

          mov  rdi, 0x141
          mov  rsi, r13
          call drv_audit_balance_since
          cmp  rax, 0
          jne  drv_audit_witness_fail

          mov  rdi, 0x140
          mov  rsi, r13
          call drv_audit_balance_since
          cmp  rax, 0
          jne  drv_audit_witness_fail

          // --- Stage 20: reconcile BOTH kinds against their own live
          //     counts. Conservation across a full mint/cascade cycle ---
          mov  rax, 20
          lea  rcx, [rip + _drv_audit_wit_stage]
          mov  [rcx + 0], rax

          lea  rcx, [rip + _drv_audit_wit_snap2]
          mov  rdx, [rcx + 0]
          mov  rdi, 0x140
          mov  rsi, r13
          call drv_audit_reconcile
          cmp  rax, 0
          jne  drv_audit_witness_fail

          lea  rcx, [rip + _drv_audit_wit_snap3]
          mov  rdx, [rcx + 0]
          mov  rdi, 0x141
          mov  rsi, r13
          call drv_audit_reconcile
          cmp  rax, 0
          jne  drv_audit_witness_fail

          // --- Stage 21: HANDOFF. Register driver slot 5, drive it
          //     Init -> Running -> Handoff, and require the committed
          //     Handoff edge to leave a record carrying the from-state ---
          mov  rax, 21
          lea  rcx, [rip + _drv_audit_wit_stage]
          mov  [rcx + 0], rax

          mov  rdi, 5
          call driver_table_unregister             // idempotent pre-clean

          mov  rdi, 5
          mov  rsi, 77                             // pid
          lea  rdx, [rip + _registry_v2_witness_name0]
          mov  rcx, 0x300
          call driver_table_register
          cmp  rax, 0
          jne  drv_audit_witness_fail

          mov  rdi, 5
          mov  rsi, 1                              // DRIVER_STATE_RUNNING
          call driver_lifecycle_transition
          cmp  rax, 0
          jne  drv_audit_witness_fail

          call drv_audit_seq
          mov  r13, rax                            // seq before the handoff

          mov  rdi, 5
          mov  rsi, 3                              // DRIVER_STATE_HANDOFF
          call driver_lifecycle_transition
          cmp  rax, 0
          jne  drv_audit_witness_fail

          call drv_audit_seq
          mov  rcx, r13
          add  rcx, 1
          cmp  rax, rcx
          jne  drv_audit_witness_fail

          xor  rdi, rdi
          mov  rsi, 1                              // F_EVENT
          call drv_audit_field
          cmp  rax, 3                              // EV_HANDOFF
          jne  drv_audit_witness_fail

          xor  rdi, rdi
          mov  rsi, 2                              // F_KIND
          call drv_audit_field
          cmp  rax, 0                              // not a capability event
          jne  drv_audit_witness_fail

          xor  rdi, rdi
          mov  rsi, 3                              // F_SUBJECT
          call drv_audit_field
          cmp  rax, 5                              // driver_table slot
          jne  drv_audit_witness_fail

          xor  rdi, rdi
          mov  rsi, 4                              // F_PRINCIPAL
          call drv_audit_field
          cmp  rax, 1                              // from-state = Running
          jne  drv_audit_witness_fail

          // --- Stage 22: a REFUSED transition emits nothing. Handoff ->
          //     Running is not in the whitelist; recording refusals here
          //     would let the lifecycle fuzzer bury the real history ---
          mov  rax, 22
          lea  rcx, [rip + _drv_audit_wit_stage]
          mov  [rcx + 0], rax

          call drv_audit_seq
          mov  r13, rax

          mov  rdi, 5
          mov  rsi, 1                              // Handoff -> Running
          call driver_lifecycle_transition
          cmp  rax, 0
          je   drv_audit_witness_fail              // must be refused

          call drv_audit_seq
          cmp  rax, r13
          jne  drv_audit_witness_fail              // and must be silent

          // --- Stage 23: BLOB PARITY (D1.c). Mint through the native
          //     path, then run a real blob-signature verification and
          //     mint through the SAME primitive, and require the two
          //     records to be indistinguishable in event / kind /
          //     outcome. A provenance gate anywhere in the audit layer
          //     — in the emitter or in a reader — breaks this ---
          mov  rax, 23
          lea  rcx, [rip + _drv_audit_wit_stage]
          mov  [rcx + 0], rax

          call drv_audit_seq
          mov  r13, rax                            // seqN
          lea  rcx, [rip + _drv_audit_wit_snap]
          mov  [rcx + 0], rax

          mov  rdi, 0x140
          call drv_audit_live_count
          lea  rcx, [rip + _drv_audit_wit_snap2]
          mov  [rcx + 0], rax                      // live0 for the pair

          // native path: no blob verification in front of it
          mov  rdi, 116
          mov  rsi, 110
          mov  rdx, 0x618
          mov  rcx, 0x54
          mov  r8,  0x01
          mov  r9,  0
          call hw_int_cap_mint
          cmp  rax, 0
          jne  drv_audit_witness_fail

          xor  rdi, rdi
          mov  rsi, 1
          call drv_audit_field
          mov  r12, rax                            // native event

          xor  rdi, rdi
          mov  rsi, 2
          call drv_audit_field
          mov  r14, rax                            // native kind

          // blob path: produce a genuine blob-signature verdict first.
          // A null manifest is the ordinary shape of the
          // BAD_MANIFEST_PTR rejection and needs no manifest fixture —
          // and a REJECTED blob is precisely the case someone would be
          // tempted to special-case in the audit layer.
          call blob_audit_seq
          mov  r13, rax

          lea  rdi, [rip + _blob_witness_blob]
          mov  rsi, 64
          xor  rdx, rdx                            // manifest_ptr = 0
          xor  rcx, rcx                            // manifest_len = 0
          call blob_load_verify
          cmp  rax, 0
          je   drv_audit_witness_fail              // must be a rejection

          call blob_audit_seq
          mov  rcx, r13
          add  rcx, 1
          cmp  rax, rcx
          jne  drv_audit_witness_fail              // blob event really happened

          mov  rdi, 117
          mov  rsi, 110
          mov  rdx, 0x618
          mov  rcx, 0x55
          mov  r8,  0x01
          mov  r9,  0
          call hw_int_cap_mint
          cmp  rax, 0
          jne  drv_audit_witness_fail

          xor  rdi, rdi
          mov  rsi, 1
          call drv_audit_field
          cmp  rax, r12                            // same event as native
          jne  drv_audit_witness_fail

          xor  rdi, rdi
          mov  rsi, 2
          call drv_audit_field
          cmp  rax, r14                            // same kind as native
          jne  drv_audit_witness_fail

          xor  rdi, rdi
          mov  rsi, 5
          call drv_audit_field
          cmp  rax, 0                              // same outcome as native
          jne  drv_audit_witness_fail

          // --- Stage 24: both paths revoke and reconcile identically.
          //     Read access is as unfiltered as write access ---
          mov  rax, 24
          lea  rcx, [rip + _drv_audit_wit_stage]
          mov  [rcx + 0], rax

          mov  rdi, 116
          call hw_int_cap_revoke
          cmp  rax, 0
          jne  drv_audit_witness_fail

          mov  rdi, 117
          call hw_int_cap_revoke
          cmp  rax, 0
          jne  drv_audit_witness_fail

          lea  rcx, [rip + _drv_audit_wit_snap]
          mov  rsi, [rcx + 0]                      // seqN
          mov  rdi, 0x140
          call drv_audit_balance_since
          cmp  rax, 0
          jne  drv_audit_witness_fail

          lea  rcx, [rip + _drv_audit_wit_snap]
          mov  rsi, [rcx + 0]
          lea  rcx, [rip + _drv_audit_wit_snap2]
          mov  rdx, [rcx + 0]
          mov  rdi, 0x140
          call drv_audit_reconcile
          cmp  rax, 0
          jne  drv_audit_witness_fail

          // --- Teardown: leave no state for later witnesses. The
          //     KIND_HW ancestor at slot 110 is cleared and driver slot
          //     5 unregistered; the audit records of everything above
          //     stay, which is the point ---
          mov  rdi, 5
          call driver_table_unregister

          mov  rdi, 110
          xor  rsi, rsi
          xor  rdx, rdx
          xor  rcx, rcx
          call cap_mint_write

          // Success marker: R29 DRIVER AUDIT OK.
          mov  rdi, 3                              // LEVEL_INFO
          lea  rsi, [rip + SUBSYS_BOOT]
          lea  rdx, [rip + drv_audit_ok_msg]
          call klog_s1
          jmp  drv_audit_witness_done

      drv_audit_witness_fail:
          lea  rax, [rip + _drv_audit_wit_stage]
          mov  r8,  [rax + 0]
          mov  rdi, 1                              // LEVEL_ERROR
          lea  rsi, [rip + SUBSYS_BOOT]
          lea  rdx, [rip + drv_audit_fail_msg]
          lea  rcx, [rip + k_line]
          call klog_s1_d1

      drv_audit_witness_done:


      pop rbp;
      ret
    }
  }

  // -------------------------------------------------------------------------
  // Witness storage
  //
  // These declarations came out of kernel_main.pdx alongside the code
  // above.  Each moved only because this module is the ONLY file in the
  // tree that references it in code; storage read by the exception
  // handlers, by tests, by boot_stub.S, or by a second witness module
  // has no single owner and stayed behind.
  //
  // Declaration ORDER is preserved from kernel_main.pdx.  Several of
  // these witnesses write past the end of one buffer into the next on
  // purpose (the deliberately-511-u64 payload patterns), so relative
  // placement inside a single object is not a formatting question.
  // -------------------------------------------------------------------------

  // R29.M6-001..004 (#1040/#1041/#1042/#1043): driver_audit_channel
  // witness scratch.
  //
  // _drv_audit_wit_stage: sub-test index 0..24, written before every
  //   gate so the failure path names the stage that tripped (map at the
  //   witness site).
  // _drv_audit_wit_seq0 / _live0: the baseline pair the reconciliation
  //   is computed against — the audit sequence number and the live
  //   KIND_HW_INTERRUPT descriptor count sampled at the same instant.
  //   Sampling them together is what makes the later equality
  //   `base_live + balance == live_count` meaningful.
  // _drv_audit_wit_snap / _snap2 / _snap3: per-stage snapshots (a saved
  //   record field across a tamper/restore pair, a sequence number, two
  //   per-kind live counts). Kept in .data rather than callee-save
  //   registers for the same reason the blob witness does it: the
  //   assertions must not depend on any callee's register discipline,
  //   least of all the discipline of the code under test.
  pub let mut _drv_audit_wit_stage : u64 = 0
}
