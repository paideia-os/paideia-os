// src/kernel/boot/witness/r90_xrepo_010_005_pdxfs_fault_inject.pdx --
// R90-XREPO.010.M1-005 (paideia-os #2113).
//
// Boot-time witness proving the sys_pdxfs_fault_inject (sysno 527)
// arm/disarm switchboard AND the FAULT_CLASS_INODE_ALLOC_FAIL hook site
// (tmpfs_inode_alloc) end-to-end in the same boot.  Six stages:
//
//   (1)  pdxfs_fault_enable() -- set the boot flag so subsequent arm
//        and fire calls take effect.  kernel_main is expected to call
//        this itself before invoking the witness; the witness's own
//        call is a defence-in-depth idempotent second setter.
//   (2)  sys_pdxfs_fault_inject_body(1) -- arm FAULT_CLASS_WAL_WRITE_FAIL.
//        Assert 0 (OK).  The syscall body emits `sys pdxfs fault inject
//        armed [legacy: SYS PDXFS FAULT INJECT ARMED] class=1`.
//   (3)  pdxfs_fault_check_and_consume(1) -- assert 1 (fired) and
//        pdxfs_fault_armed_get() -- assert 0 (consumed).  The helper
//        emits `sys pdxfs fault fired [legacy: SYS PDXFS FAULT FIRED]
//        class=1` on the fired path.
//   (4)  pdxfs_fault_check_and_consume(1) again -- assert 0 (already
//        consumed, no second fire).
//   (5)  sys_pdxfs_fault_inject_body(2) -- arm FAULT_CLASS_INODE_ALLOC_
//        FAIL.  Call tmpfs_inode_alloc -- assert 0xFFFF (synthetic OOM
//        via the in-substrate hook site).  Call tmpfs_inode_alloc again
//        -- assert < 0xFFFF (real allocator, real inode).  tmpfs_inode_
//        free(idx) -- restore pool inventory so post-witness diagnostics
//        (e.g. tmpfs_inode_alloc_count) are byte-identical to a no-
//        witness boot.
//   (6)  Emit `boot pdxfs fault inject ok -- count=2` rollup via
//        klog_s1_d1(SUBSYS_BOOT, tag_boot_pdxfs_fault_inject_ok,
//        k_count, 2).  A failure in any of stages (1)..(5) short-circuits
//        to the skip funnel, which emits `boot pdxfs fault inject skip
//        -- reason=1 stage=<S>` with S in [1..5].
//
// FINGERPRINTS: three total per successful boot from this witness:
//   `sys pdxfs fault inject armed ... class=1`  (stage 2, via syscall body)
//   `sys pdxfs fault fired ... class=1`         (stage 3, via check_and_consume)
//   `sys pdxfs fault inject armed ... class=2`  (stage 5, via syscall body)
//   `sys pdxfs fault fired ... class=2`         (stage 5, via check_and_consume
//                                                 inside tmpfs_inode_alloc)
//   `boot pdxfs fault inject ok -- count=2`     (this witness's own rollup)
//
// PLACEMENT (kernel_main.pdx): after witness_r90_xrepo_010_004_pdxfs_
// undo_write (last of the R90-XREPO.010 witness block) and before
// witness_r17_init_sched, so the PdxFS substrate is fully seeded and
// the fault-inject enable can happen without disturbing later boot
// paths (init's own sys_open path runs long after the witness disarms).
//
// Reserved-label discipline: labels prefixed `pxfi_` (PdXfs Fault
// Inject).  `loop`, `if` etc. are keywords and never used as labels.
//
// Frame prologue: manual push/pop (same as every other witness_*.pdx).

module R90XrepoPdxfsFaultInject = structure {

  // Skip-path fingerprint tag.  Locally scoped -- no other witness needs
  // it, and the text carries no standalone uppercase OK token so
  // verify-fingerprint-coverage.sh does not gate on it.  Byte count
  // NUL-inclusive per #699 discipline: "boot pdxfs fault inject skip "
  // = 29 chars + NUL = 30.
  pub let pxfi_skip_msg : [u8; 30] = "boot pdxfs fault inject skip \0"
  pub let pxfi_k_reason : [u8;  7] = "reason\0"
  pub let pxfi_k_stage  : [u8;  6] = "stage\0"

  // ==========================================================================
  // witness_r90_xrepo_010_005_pdxfs_fault_inject() -> ()
  //
  // Register plan (5 callee-save pushes + `sub rsp, 8` pad = 48 bytes
  // -> rsp%16 == 0 for every nested call from entry rsp%16 == 8 SysV):
  //   rbx = allocated inode idx (stage 5 -- survives across the free call)
  //   r12 = unused (pushed for symmetry)
  //   r13 = unused (pushed for symmetry)
  //   r14 = current stage code (1..5) for the skip funnel
  //   r15 = unused (pushed for symmetry)
  //
  // Five pushes on entry rsp%16 == 8 land rsp%16 == 8 (5*8 mod 16 = 8),
  // the `sub rsp, 8` pad brings it to 0.
  // ==========================================================================
  pub let witness_r90_xrepo_010_005_pdxfs_fault_inject : () -> () !{mem, sysreg} @{boot} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot},
      justification: "R90-XREPO.010.M1-005 (paideia-os #2113): boot witness for sys_pdxfs_fault_inject (sysno 527) + the tmpfs_inode_alloc hook site. Five callee-save pushes + `sub rsp, 8` pad leaves rsp%16 == 0 for every nested call from entry rsp%16 == 8 SysV.  Bypasses the dispatch shim (boot context, no ring-3 cap check applies) and calls sys_pdxfs_fault_inject_body / pdxfs_fault_check_and_consume / pdxfs_fault_armed_get / tmpfs_inode_alloc / tmpfs_inode_free directly.  Two arm/fire scenarios in one boot: (A) WAL_WRITE_FAIL via the substrate primitive (proves single-shot consume + re-check returns 0); (B) INODE_ALLOC_FAIL via the tmpfs_inode_alloc hook (proves the in-substrate hook returns 0xFFFF on arm and succeeds on the next call).  The allocated inode from the second tmpfs_inode_alloc is freed via tmpfs_inode_free before the rollup emit so post-witness inventory diagnostics (e.g. tmpfs_inode_alloc_count) match a no-witness boot byte-for-byte.  pdxfs_fault_enable() is called defensively at stage 1 (kernel_main should already have called it once; the double-set is idempotent, matching the pdxfs_txn_undo_reset defensive-reset shape one milestone up).  Encoder-conservative: cmp/je/jne/jb/ja/mov/lea/xor/push/pop/call/sub/add/ret only -- every form already proven at this exact shape in the sibling r90_xrepo_010_004 witness.  Labels prefixed pxfi_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;                      // align rsp%16 == 0 for nested calls

        mov r14, 1;                      // stage counter

        // ==================================================================
        // (1) Set boot flag (idempotent second setter -- kernel_main
        //     is the primary caller).
        // ==================================================================
        call pdxfs_fault_enable;

        // ==================================================================
        // (2) Arm FAULT_CLASS_WAL_WRITE_FAIL (== 1) via the syscall body.
        // ==================================================================
        mov r14, 2;
        mov rdi, 1;
        call sys_pdxfs_fault_inject_body;
        cmp rax, 0;
        jne pxfi_skip;

        // ==================================================================
        // (3) Fire once; assert consumed.
        // ==================================================================
        mov r14, 3;
        mov rdi, 1;
        call pdxfs_fault_check_and_consume;
        cmp rax, 1;
        jne pxfi_skip;                   // must have fired

        call pdxfs_fault_armed_get;
        cmp rax, 0;
        jne pxfi_skip;                   // must be consumed

        // ==================================================================
        // (4) Second fire attempt -- must return 0 (already consumed).
        // ==================================================================
        mov r14, 4;
        mov rdi, 1;
        call pdxfs_fault_check_and_consume;
        cmp rax, 0;
        jne pxfi_skip;

        // ==================================================================
        // (5) Arm FAULT_CLASS_INODE_ALLOC_FAIL (== 2); exercise the
        //     tmpfs_inode_alloc hook end-to-end.
        // ==================================================================
        mov r14, 5;
        mov rdi, 2;
        call sys_pdxfs_fault_inject_body;
        cmp rax, 0;
        jne pxfi_skip;

        // First call must return 0xFFFF (synthetic OOM via the hook).
        call tmpfs_inode_alloc;
        mov r10, 0xFFFF;
        cmp rax, r10;
        jne pxfi_skip;

        // Second call must succeed (arm was consumed by the first call).
        call tmpfs_inode_alloc;
        mov r10, 0xFFFF;
        cmp rax, r10;
        je  pxfi_skip;                   // must NOT be OOM
        mov rbx, rax;                    // rbx = real inode idx

        // Restore pool inventory: free the inode we just allocated so
        // post-witness diagnostics (tmpfs_inode_alloc_count) match a
        // no-witness boot byte-for-byte.
        mov rdi, rbx;
        call tmpfs_inode_free;

        // ==================================================================
        // (6) Emit rollup fingerprint.  `boot pdxfs fault inject ok
        //     -- count=2` (count = scenarios exercised).
        // ==================================================================
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_boot_pdxfs_fault_inject_ok];
        lea rcx, [rip + k_count];
        mov r8, 2;                       // count = 2 scenarios exercised
        call klog_s1_d1;
        jmp pxfi_done;

      pxfi_skip:
        // Skip funnel.  reason=1 today (single failure class); stage
        // = <r14> in [1..5] names which stage tripped.  Emits `boot
        // pdxfs fault inject skip -- reason=1 stage=<S>` via
        // klog_s1_d2.  klog_s1_d2's v2 (7th arg) is stack-passed:
        // `sub rsp, 8` aligns %16 -> 8, then `push r14` -> %16 == 0
        // for the call, `add rsp, 16` undoes both.
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + pxfi_skip_msg];
        lea rcx, [rip + pxfi_k_reason];
        mov r8, 1;                       // v1 = reason
        lea r9, [rip + pxfi_k_stage];
        sub rsp, 8;                      // alignment pad
        push r14;                        // v2 = stage
        call klog_s1_d2;
        add rsp, 16;

      pxfi_done:
        add rsp, 8;                      // undo pad
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
