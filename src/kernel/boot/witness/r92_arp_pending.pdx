// src/kernel/boot/witness/r92_arp_pending.pdx -- R92.M2-002
// (paideia-os #2038)
//
// ARP-pending retry-path witness. Sends an IPv4 packet to an IP whose
// MAC is guaranteed absent from the ARP cache and verifies that
// ipv4_tx_send returns IPV4_E_ARP_PENDING (3) rather than crashing,
// blocking, or silently succeeding.
//
// =============================================================================
// SECTION 0  WHAT THIS WITNESS PROVES
// =============================================================================
//
// The R27.M5 ipv4_tx_send body has always had an ARP-miss arm at
// ipvts_arp_miss (net/ipv4.pdx:906..918) that bumps _ipv4_tx_arp_
// pending, kicks arp_send_request, and returns IPV4_E_ARP_PENDING=3.
// The R27 self-loopback fast path never exercises that arm (loopback
// dst == my_ip means the arp_cache_lookup hits the module-fixture
// entry ipv4_rx_handle installs for self). Every off-box send would
// exercise it -- but no off-box send has ever run against a real NIC
// in this tree.
//
// This witness is the first assertion that the arm actually returns
// what the code says it returns, on the ONE-hop path from the caller
// to the guard, without any downstream execution.
//
// The witness does NOT wait for an ARP reply to arrive and does NOT
// retry until the packet lands -- both depend on a live NIC RX ring
// with driver polling infrastructure that R91 landed partial and R92
// does not extend. The retry-until-landed variant is deferred to R93
// once the DHCP client is the first real caller of the full send-
// retry-succeed cycle.
//
// =============================================================================
// SECTION 1  SKIP DISCIPLINE
// =============================================================================
//
// Under PAIDEIA_NIC=none the R91 dispatch cascade leaves
// _active_nic_kind = 0 and l2_tx_send's nic_dispatch_tx call returns
// NIC_ENOSYS. In that state ipv4_tx_send's l2_tx_send call still
// forwards the frame to nic_dispatch_tx (which returns NIC_ENOSYS)
// AFTER the arp_cache_lookup gate -- so the ARP-miss arm still fires
// and still returns IPV4_E_ARP_PENDING. In principle the assertion
// holds under both PAIDEIA_NIC=none and =virtio / =e1000e / =rtl8139;
// in practice the witness skips cleanly on kind==0 to keep the "no
// NIC attached" boot mode's fingerprint stream free of a line that
// suggests off-box send worked.
//
// =============================================================================
// SECTION 2  TEST TARGET IP
// =============================================================================
//
// The witness sends to 10.0.2.222 (canonical wire order: 0x0A0002DE).
// Rationale:
//
//   * Same-/24 as the DHCP-time default route (10.0.2.0/24) so
//     ipv4_tx_send takes the "dst_ip is the next hop" arm, NOT the
//     "use gw" arm -- the arp_cache_lookup query is against the test
//     IP itself, not the gateway. This is the harder-to-hit ARP-miss
//     arm because the gateway IP is warm in the cache after any
//     preceding boot activity (e.g. an ARP announce).
//
//   * .222 is far enough from anything QEMU SLIRP's built-in DHCP
//     hands out (10.0.2.15 is the default lease) that a coincidental
//     cache hit is impossible.
//
// The IP is a stack-local 4-byte scratch built from immediate bytes
// -- no rodata symbol added.
//
// =============================================================================
// SECTION 3  ASSERTED RETURN CODE
// =============================================================================
//
// ipv4_tx_send's rax on the ARP-miss arm is 3 (IPV4_E_ARP_PENDING,
// declared at net/ipv4.pdx:103). The witness compares rax to 3
// exactly. Any other value -> skip path (no OK emit).
//
// =============================================================================
// SECTION 4  FINGERPRINT
// =============================================================================
//
// Emits `boot r92 arp pending ok --` via klog_s1(LEVEL_INFO=3,
// SUBSYS_BOOT, tag_boot_r92_arp_pending_ok). Lowercase, no bracketed
// OK suffix -- same posture as `boot r91 nic probe ok`.
//
// =============================================================================
// SECTION 5  ENCODER + LABEL DISCIPLINE
// =============================================================================
//
// No callee-save pushes needed (no callee-save state consumed).
// `sub rsp, 24` = 16 B test-IP scratch region + 8 B alignment pad.
// Entry rsp%16==8; sub 24 -> rsp%16==0 for every nested call
// (nic_dispatch_active_kind, ipv4_tx_send, klog_s1). No `add reg,
// [mem]`, no `mov_bzx`. Labels prefixed `r92ap_`.

module R92ArpPending = structure {

  // witness_r92_arp_pending_retry() -> ()
  pub let witness_r92_arp_pending_retry : () -> () !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R92.M2-002 (paideia-os #2038). ARP-pending retry-path witness. Body: (1) sub rsp,24 (16 B test-IP scratch + 8 B alignment pad). Entry rsp%16==8 -> 24, %16==0 for nested calls. No callee-save pushes -- no callee-save state consumed. (2) nic_dispatch_active_kind() -- rax == 0 -> silent skip (no OK emit, no skip fingerprint on this witness -- the arp-pending path is a probe rather than a rollup so a skip is not observable, matching sibling witnesses' silent-on-precondition-miss discipline). (3) Build test IP 10.0.2.222 at [rsp+0..3] via 4 mov_b immediate stores. (4) ipv4_tx_send(bar0=0, tx_ring_pa=0, protocol=IPV4_PROTO_ICMP=1, dst_ip=&test_ip_scratch, payload_pa=0, payload_len=0). rax != 3 -> silent skip. (5) rax == 3 (IPV4_E_ARP_PENDING) -> emit `boot r92 arp pending ok --` via klog_s1. (6) Teardown. Labels prefixed r92ap_. Encoder-conservative: mov_b for byte stores, [reg+imm] addressing, cmp reg,imm.",
      block: {
        sub rsp, 24;

        // (2) Skip on no-NIC boot.
        call nic_dispatch_active_kind;
        cmp rax, 0;
        je  r92ap_ret;

        // (3) Build test IP 10.0.2.222 in wire order at [rsp+0..3].
        mov rax, 10;
        mov_b [rsp + 0], rax;
        xor rax, rax;
        mov_b [rsp + 1], rax;
        mov rax, 2;
        mov_b [rsp + 2], rax;
        mov rax, 222;
        mov_b [rsp + 3], rax;

        // (4) ipv4_tx_send(0, 0, IPV4_PROTO_ICMP=1, &test_ip, 0, 0).
        xor rdi, rdi;                             // bar0 (ignored)
        xor rsi, rsi;                             // tx_ring_pa (ignored)
        mov rdx, 1;                               // IPV4_PROTO_ICMP
        mov rcx, rsp;                             // dst_ip ptr
        xor r8, r8;                               // payload_pa
        xor r9, r9;                               // payload_len
        call ipv4_tx_send;

        // (5) rax must equal IPV4_E_ARP_PENDING (3) exactly.
        cmp rax, 3;
        jne r92ap_ret;

        // Emit fingerprint.
        mov rdi, 3;                               // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_boot_r92_arp_pending_ok];
        call klog_s1;

      r92ap_ret:
        add rsp, 24;
        ret
      }
    }
}
