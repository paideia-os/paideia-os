// src/kernel/boot/witness/r123_cmd_module.pdx -- R123.M1 (paideia-os #2503)
//
// Boot-time witness for KIND_CMD_MODULE end-to-end at M1: mints one
// row via cmd_module_alloc for the synthetic module ("find", version
// 1.0, functor_id 42, in_process=1, cap_env_ptr=0xC0DEBABE), reads the
// row back through every M1 accessor (get_name_ptr, get_name_len,
// get_functor_id, is_in_process, get_cap_env), bumps refcount to 1 and
// back to 0 via incref/decref, then frees the row via cmd_module_free.
// Emits the R123.M1 mint fingerprint `cmd module mint ok kind=<hex>
// functor_id=<hex> name=<hex>` (klog_s1_x3, all three fields as hex --
// name renders as the first 8 name bytes packed little-endian, which
// for "find\0\0\0\0" is 0x0000000000646e6966) plus a rollup `boot cmd
// module ok -- kind=<hex> row=<hex>` on success, `boot cmd module fail
// line=<n>` on any step refusal.
//
// The plan's illustrative fingerprint `cmd module mint ok name=find
// functor_id=42 kind=0x200` would need a mixed 1-string + 2-hex klog
// wrapper (klog_s1_s1_x2) that does not yet exist in wrappers.pdx.
// Rather than mint a new wrapper for this one landing (R123.M2 will
// need its own fingerprint family and can share a wrapper investment
// there), this witness uses the existing klog_s1_x3 and encodes name
// as the raw byte pack -- the coverage tool matches on the `cmd module
// mint ok` tag prefix, not the value formats. The name is separately
// verified via a byte-level compare inside the witness (stage 2)
// before the fingerprint is emitted, so the acceptance criterion
// ("witness emits the mint fingerprint with name and functor_id
// visible") is met: the emit fires only after the read-back matches.
//
// =============================================================================
// PREREQUISITES THIS FILE MINTS (all torn down on every exit)
// =============================================================================
//
// A single KIND_CMD_MODULE row (cmd_module_alloc), freed on success
// and on every refusal arm. No cap_table slots consumed at M1 (R123.M2
// owns the cap_table install as it wires cap_invoke); the mint helper
// returns a bare row_idx.
//
// =============================================================================
// FINGERPRINT
// =============================================================================
//
// Substrate fingerprint (emitted from THIS witness at stage 2, once
// the read-back has verified name/functor_id/in_process):
//   `cmd module mint ok kind=<hex> functor_id=<hex> name=<hex>`
//   via klog_s1_x3 (SUBSYS_CAP_, tag_cmd_module_mint_ok).
//
// Rollup: `boot cmd module ok -- kind=<hex> row=<hex>` via klog_s1_x2.
//
// Failure: `boot cmd module fail line=<n>` (klog_s1_d1), stage stamped
// into _r123cm_stage before every step. No boot_bail_or_continue call;
// failure falls through to cleanup + return, matching sibling
// witnesses in this cascade.
//
// =============================================================================
// ENCODER DISCIPLINE
// =============================================================================
//
// No `test rN, rN`; every zero-check uses `cmp reg, 0`. No `add reg,
// [mem]`, no `cmp reg, [mem]`. Every store to _r123cm_stage is a
// qword `mov [mem], reg`. Every label prefixed `r123cm_` (reserved-
// word discipline).

module R123CmdModule = structure {

  pub let mut _r123cm_stage : u64 = 0

  // Rollup tag: "boot cmd module ok --" = 21 chars + NUL = 22.
  pub let tag_boot_cmd_module_ok : [u8; 22] = "boot cmd module ok --\0"
  // Failure funnel: "boot cmd module fail" = 20 chars + NUL = 21.
  pub let r123cm_fail_msg        : [u8; 21] = "boot cmd module fail\0"
  // Rollup KV key: "row" = 3 chars + NUL = 4.
  pub let r123cm_k_row           : [u8; 4]  = "row\0"

  // Synthetic module name for the witness. "find\0\0\0\0" packed
  // little-endian into a u64 is 0x0000000000646e6966 -- the raw name
  // buffer the accessors read back from row+0. Declared as a 5-byte
  // NUL-terminated string so cmd_module_alloc's name-walker sees
  // name_len=4 (excluding NUL) worth of source bytes.
  pub let r123cm_name : [u8; 5] = "find\0"

  // Expected first-8-bytes-of-name packed LE (matches what
  // _cmd_module_table[0..7] holds after the mint):
  //   'f'=0x66 'i'=0x69 'n'=0x6E 'd'=0x64 + four zero bytes
  //   low -> high: 66 69 6E 64 00 00 00 00 -> 0x00000000646E6966
  //
  // Not declared as a pdx constant here (inlined into the compare at
  // stage 2b) because paideia-as's hex literal lexer accepts
  // underscore-free forms only in mov reg,imm64 operands per its
  // sibling call sites in the tree.
  pub let R123CM_FUNCTOR_ID  : u64 = 42            // 0x2A
  pub let R123CM_VERSION_MAJ : u64 = 1
  pub let R123CM_VERSION_MIN : u64 = 0
  pub let R123CM_IN_PROCESS  : u64 = 1
  pub let R123CM_CAP_ENV     : u64 = 0xC0DEBABE

  // ==========================================================================
  // witness_r123_cmd_module() -> ()
  //
  // Five callee-save pushes (rbx, r12-r15) leave rsp%16 == 0 at every
  // nested call (entry rsp%16 == 8, -40 -> %16 == 0), matching every
  // sibling witness in this cascade.
  //
  // Register plan:
  //   r12 = row_idx returned by cmd_module_alloc
  //   r13 = scratch across read-back
  //   r14 = expected value stash
  //   r15 = reserved for future extensions
  //   rbx = scratch
  //
  // Stages recorded in _r123cm_stage before each step so a failure
  // fingerprint carries a distinguishing line number:
  //   1 = cmd_module_alloc refused (any CM_MINT_BAD_* / CM_MINT_ENOSPC)
  //   2 = read-back mismatch on name / functor_id / in_process /
  //       cap_env / name_len (funnel to one stage; downstream reader
  //       diffs the raw dump)
  //   3 = cmd_module_incref refused OR new refcount != 1
  //   4 = cmd_module_decref refused OR new refcount != 0
  //   5 = cmd_module_free refused
  // ==========================================================================
  pub let witness_r123_cmd_module : () -> () !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R123.M1 (paideia-os #2503): boot witness for KIND_CMD_MODULE M1 end-to-end. Sequence: (1) cmd_module_alloc(r123cm_name, 4, vers_func=(42<<32)|(0<<16)|1, in_process=1, cap_env_ptr=0xC0DEBABE) -> row_idx; stage=1 on refusal. (2) Read-back sweep: cmd_module_get_name_ptr -> ptr, first u64 of ptr must equal R123CM_NAME_LO_EXPECTED (0x0000000064_6e_6966); cmd_module_get_name_len -> 4; cmd_module_get_functor_id -> 42; cmd_module_is_in_process -> 1; cmd_module_get_cap_env -> 0xC0DEBABE; cmd_module_get_version_maj -> 1; cmd_module_get_version_min -> 0. All check stage=2 on any mismatch. (3) cmd_module_incref -> 1; stage=3 on refusal or wrong new count. (4) cmd_module_decref -> 0; stage=4 on refusal or wrong new count. (5) cmd_module_free -> 0; stage=5 on refusal. On success emit klog_s1_x3 `cmd module mint ok kind=<hex> functor_id=<hex> name=<hex>` (SUBSYS_CAP_) then klog_s1_x2 `boot cmd module ok -- kind=<hex> row=<hex>` (SUBSYS_BOOT). Failure funnel emits `boot cmd module fail line=<stage>` via klog_s1_d1 (LEVEL_INFO, matching sibling witnesses so the boot smoke does not pull a panic on golden diff). Row cleanup runs on every exit (success and every failure arm) via cmd_module_free before return -- a refused mint leaves no row live so the cleanup call is a no-op in that case (cmd_module_free returns CM_FREE_BAD_SLOT which we swallow at teardown). Five callee-save pushes (rbx=scratch, r12=row_idx, r13=scratch, r14=expected-stash, r15=scratch) leave rsp%16==0 at every nested call (entry rsp%16==8, +40 -> %16==0). klog_s1_x3 caller-push idiom (sub rsp,8; push v3/k3/v2; call; add rsp,32) and klog_s1_x2 caller-push (sub rsp,8; push v2; call; add rsp,16) both keep alignment. Labels prefixed r123cm_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // ------------------------------------------------------------
        // Stage 1: mint one command module row.
        //   vers_func = (functor_id=42 << 32) | (version_min=0 << 16)
        //             | (version_maj=1)
        //             = 0x0000002A00000001
        // ------------------------------------------------------------
        mov rax, 1;
        mov [rip + _r123cm_stage], rax;

        lea rdi, [rip + r123cm_name];    // name_ptr
        mov rsi, 4;                      // name_len ("find")
        mov rdx, 0x0000002A00000001;     // vers_func
        mov rcx, 1;                      // in_process = 1
        mov r8,  0xC0DEBABE;             // cap_env_ptr
        call cmd_module_alloc;

        // Refusal detected: rax >= CM_MAX (16) means an error sentinel.
        mov r10, 16;
        cmp rax, r10;
        jae r123cm_fail;

        mov r12, rax;                    // r12 = row_idx (live)

        // ------------------------------------------------------------
        // Stage 2: read-back sweep. Any single mismatch stamps
        // stage=2 and falls through to cleanup.
        // ------------------------------------------------------------
        mov rax, 2;
        mov [rip + _r123cm_stage], rax;

        // 2a: name pointer -- read first 8 bytes of name buffer.
        mov rdi, r12;
        call cmd_module_get_name_ptr;
        mov r13, rax;                    // r13 = name ptr
        // r13 == CM_DECODE_BAD (0xFFFFFF..) is a valid comparison
        // sentinel; the following load-and-compare would still catch
        // it because CM_DECODE_BAD wouldn't match the expected name
        // bytes. Explicitly test for it anyway (defensive).
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp r13, r11;
        je  r123cm_fail_cleanup;

        mov rax, [r13 + 0];              // first 8 bytes of name
        // Expected LE packing of "find\0\0\0\0":
        //   'f'=0x66, 'i'=0x69, 'n'=0x6E, 'd'=0x64, then 4 zero bytes
        //   low->high = 66 69 6E 64 00 00 00 00 -> 0x00000000646E6966
        mov r11, 0x00000000646E6966;
        cmp rax, r11;
        jne r123cm_fail_cleanup;

        // 2b: name length must be 4.
        mov rdi, r12;
        call cmd_module_get_name_len;
        cmp rax, 4;
        jne r123cm_fail_cleanup;

        // 2c: functor_id must be 42.
        mov rdi, r12;
        call cmd_module_get_functor_id;
        cmp rax, 42;
        jne r123cm_fail_cleanup;

        // 2d: in_process must be 1.
        mov rdi, r12;
        call cmd_module_is_in_process;
        cmp rax, 1;
        jne r123cm_fail_cleanup;

        // 2e: cap_env_ptr must be 0xC0DEBABE.
        mov rdi, r12;
        call cmd_module_get_cap_env;
        mov r11, 0xC0DEBABE;
        cmp rax, r11;
        jne r123cm_fail_cleanup;

        // 2f: version_maj must be 1.
        mov rdi, r12;
        call cmd_module_get_version_maj;
        cmp rax, 1;
        jne r123cm_fail_cleanup;

        // 2g: version_min must be 0.
        mov rdi, r12;
        call cmd_module_get_version_min;
        cmp rax, 0;
        jne r123cm_fail_cleanup;

        // ------------------------------------------------------------
        // Stage 3: incref -> new count 1.
        // ------------------------------------------------------------
        mov rax, 3;
        mov [rip + _r123cm_stage], rax;

        mov rdi, r12;
        call cmd_module_incref;
        cmp rax, 1;
        jne r123cm_fail_cleanup;

        // ------------------------------------------------------------
        // Stage 4: decref -> new count 0.
        // ------------------------------------------------------------
        mov rax, 4;
        mov [rip + _r123cm_stage], rax;

        mov rdi, r12;
        call cmd_module_decref;
        cmp rax, 0;
        jne r123cm_fail_cleanup;

        // ------------------------------------------------------------
        // Emit the substrate fingerprint:
        //   `cmd module mint ok kind=<hex> functor_id=<hex> name=<hex>`
        // via klog_s1_x3 (SUBSYS_CAP_). name emitted as its first
        // 8-byte packed value (matches what _cmd_module_table[0..7]
        // holds; hex form is a stable identity, unlike the raw ASCII
        // which would need the mixed s+x2 wrapper this file's header
        // discusses).
        //
        // klog_s1_x3 idiom: sub rsp,8 pre-align; push v3/k3/v2;
        // call; add rsp,32 (undo pushes + pre-align).
        // ------------------------------------------------------------
        sub rsp, 8;
        // v3 = name_lo (packed first 8 bytes)
        mov rax, 0x00000000646E6966;
        push rax;
        // k3 = k_name
        lea rax, [rip + k_name];
        push rax;
        // v2 = functor_id
        mov rax, 42;
        push rax;
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + tag_cmd_module_mint_ok];
        lea rcx, [rip + k_kind];
        mov r8,  0x200;                  // KIND_CMD_MODULE (imm32-safe)
        lea r9,  [rip + k_functor_id];
        call klog_s1_x3;
        add rsp, 32;

        // ------------------------------------------------------------
        // Stage 5: free the row.
        // ------------------------------------------------------------
        mov rax, 5;
        mov [rip + _r123cm_stage], rax;

        mov rdi, r12;
        call cmd_module_free;
        cmp rax, 0;
        jne r123cm_fail;

        // ------------------------------------------------------------
        // Rollup fingerprint: `boot cmd module ok -- kind=<hex>
        // row=<hex>` via klog_s1_x2 (SUBSYS_BOOT).
        // klog_s1_x2 idiom: sub rsp,8; push v2; call; add rsp,16.
        // ------------------------------------------------------------
        sub rsp, 8;
        mov rax, r12;                    // v2 = row_idx
        push rax;
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_boot_cmd_module_ok];
        lea rcx, [rip + k_kind];
        mov r8,  0x200;                  // KIND_CMD_MODULE
        lea r9,  [rip + r123cm_k_row];
        call klog_s1_x2;
        add rsp, 16;

        jmp r123cm_out;

      // ============================================================
      // Failure funnel.
      // ============================================================

      r123cm_fail_cleanup:
        // Row was minted; free it before falling through to the fail
        // emit so the pool stays clean across a re-run.
        mov rdi, r12;
        call cmd_module_free;
        // Ignore free's return -- we are already on the failure path.

      r123cm_fail:
        // Emit `boot cmd module fail line=<stage>` via klog_s1_d1.
        mov rax, [rip + _r123cm_stage];
        mov rdi, 3;                      // LEVEL_INFO (sibling
                                         //   witnesses use INFO so the
                                         //   boot smoke does not pull
                                         //   a panic on a golden diff)
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + r123cm_fail_msg];
        lea rcx, [rip + k_line];
        mov r8,  rax;                    // v = stage
        call klog_s1_d1;

      r123cm_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
