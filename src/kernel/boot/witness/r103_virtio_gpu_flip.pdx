// src/kernel/boot/witness/r103_virtio_gpu_flip.pdx -- R103.M5-001
//                                                     (paideia-os #2167)
//
// R103 double-flip witness: proves the virtio-gpu 2D backend pipeline
// end-to-end -- probe -> handshake -> control-queue -> RESOURCE_CREATE_2D
// -> ATTACH_BACKING -> SET_SCANOUT -> paint red -> TRANSFER + FLUSH ->
// paint green (into the paired buffer) -> TRANSFER + FLUSH -> readback
// verify.
//
// -----------------------------------------------------------------------------
// What this witness does
// -----------------------------------------------------------------------------
//
//   Stage 1: Skip if no virtio-gpu device was probed OR ctrlq_init did
//            not run.
//   Stage 2: Mint synthetic KIND_DEVICE + KIND_MEMORY parents (cap
//            slots 132 + 133 -- disjoint from R101's 130/131).
//   Stage 3: Mint KIND_DISPLAY_BACKEND with backend_kind=VIRTIO_GPU_2D.
//   Stage 4: Allocate two host resources via
//            virtio_gpu_resource_create_2d(w=1024, h=768). Store IDs
//            in _r103wt_res_id_a / _b.
//   Stage 5: Mint two KIND_FRAMEBUFFER rows (buffer A and buffer B) via
//            kind_framebuffer_mint_simple; wire fb_row_pair_set both
//            directions.
//   Stage 6: Attach each fb's backing memory to its resource via
//            virtio_gpu_resource_attach_backing.
//   Stage 7: Set scanout 0 = resource A (initial armed resource).
//   Stage 8: Paint solid red (0xFFFF0000 BGRA) into buffer A.
//   Stage 9: Set active resource = A + call virtio_gpu_backend_flush.
//            Verify vblank timeline advanced.
//   Stage 10: Paint solid green (0xFF00FF00 BGRA) into buffer B.
//   Stage 11: SET_SCANOUT to resource B; set active resource = B;
//             call virtio_gpu_backend_flush again.
//   Stage 12: Read back one pixel from each fb backing and assert the
//             colours match (buffer A stayed red, buffer B is green).
//   Stage 13: Teardown (unref resources + revoke caps).
//
// Fingerprints (all-lowercase, no OK_TOK):
//   Success: "boot r103 virtio_gpu double_flip ok"
//   Skip:    "boot r103 virtio_gpu skip"
//   Fail:    "boot r103 virtio_gpu fail line=<N>"

module R103VirtioGpuFlip = structure {

  pub let mut _r103wt_stage : u64 = 0

  // 4 MiB back buffer for buffer A (1024*768*4 = 3 MiB).
  pub let mut _r103wt_buf_a : [u64; 524288] = uninit @align(4096)
  pub let mut _r103wt_buf_b : [u64; 524288] = uninit @align(4096)

  pub let mut _r103wt_res_id_a : u64 = 0
  pub let mut _r103wt_res_id_b : u64 = 0

  pub let tag_r103_ok    : [u8; 36] = "boot r103 virtio_gpu double_flip ok\0"
  pub let tag_r103_skip  : [u8; 26] = "boot r103 virtio_gpu skip\0"
  pub let tag_r103_fail  : [u8; 26] = "boot r103 virtio_gpu fail\0"

  pub let r103wt_k_n     : [u8; 2] = "n\0"

  // ==========================================================================
  // Helper: mint a synthetic parent cap at (slot, kind, rights, target).
  // ==========================================================================
  pub let r103wt_mint_parent : (u64, u64, u64, u64) -> () !{mem} @{cap} =
    fn (slot: u64) (kind: u64) (rights: u64) (target: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R103.M5-001: thin forwarder to cap_mint_write; witness synthetic parents. Labels prefixed r103wt_mp_.",
      block: {
        call cap_mint_write;
        ret
      }
    }

  // ==========================================================================
  // Helper: scrub cap slots 132 (device) and 133 (memory-A) and 134 (memory-B).
  // ==========================================================================
  pub let r103wt_clear_slots : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R103.M5-001: scrub the 3 cap slots this witness owns. Labels prefixed r103wt_cs_.",
      block: {
        mov rdi, 132;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        mov rdi, 133;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        mov rdi, 134;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        ret
      }
    }

  // ==========================================================================
  // Helper: paint a solid BGRA colour into a buffer.
  //
  // paint_solid(buf_va, color, pixel_count) -> ()
  // ==========================================================================
  pub let r103wt_paint_solid : (u64, u64, u64) -> () !{mem} @{} =
    fn (buf_va: u64, color: u64, pixel_count: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R103.M5-001: fill `pixel_count` u32 BGRA pixels at buf_va with `color`. Simple linear loop; only runs once per stage. Labels prefixed r103wt_ps_.",
      block: {
        push rbx;
        mov rbx, rdi;
        xor rcx, rcx;
      r103wt_ps_loop:
        cmp rcx, rdx;
        jae r103wt_ps_done;
        // Store 32-bit color at buf + rcx*4.
        mov rax, rcx;
        shl rax, 2;
        add rax, rbx;
        mov_d [rax], rsi;
        add rcx, 1;
        jmp r103wt_ps_loop;
      r103wt_ps_done:
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // witness_r103_virtio_gpu_flip() -> ()
  //
  // See file header for stage-by-stage description.
  //
  // Register plan: r12 = backend_row, r13 = fb_row_a, r14 = fb_row_b,
  // r15 = res_a, rbx = res_b, rbp = timeline_value snapshot for
  // advance-check.
  //
  // Six callee-save pushes + rsp,8 for alignment (entry rsp%16 == 8,
  // + 48 + 8 = 56, %16 == 0).
  // ==========================================================================

  pub let witness_r103_virtio_gpu_flip : () -> () !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R103.M5-001: end-to-end virtio-gpu 2D double-flip witness. Skips cleanly when no virtio-gpu device is probed (default boot / PAIDEIA_VGA!=virtio). Full body per file header. Labels prefixed r103wt_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;

        // ---------- Stage 1: skip guard ----------
        mov rax, 1;
        lea rcx, [rip + _r103wt_stage];
        mov [rcx], rax;

        mov rax, [rip + _virtio_gpu_device_count];
        cmp rax, 0;
        je  r103wt_skip;

        mov rax, [rip + _vgpu_ctrl_doorbell_va];
        cmp rax, 0;
        je  r103wt_skip;

        call r103wt_clear_slots;

        // ---------- Stage 2: mint synthetic parents ----------
        mov rax, 2;
        lea rcx, [rip + _r103wt_stage];
        mov [rcx], rax;

        mov rdi, 132;
        mov rsi, 10;                             // KIND_DEVICE
        mov rdx, 0x200;                          // RIGHT_MINT
        mov rcx, 0x2010;
        call r103wt_mint_parent;

        mov rdi, 133;
        mov rsi, 4;                              // KIND_MEMORY
        mov rdx, 0x200;
        lea rcx, [rip + _r103wt_buf_a];
        call r103wt_mint_parent;

        mov rdi, 134;
        mov rsi, 4;                              // KIND_MEMORY
        mov rdx, 0x200;
        lea rcx, [rip + _r103wt_buf_b];
        call r103wt_mint_parent;

        // ---------- Stage 3: mint KIND_DISPLAY_BACKEND (VIRTIO_GPU_2D) ----------
        mov rax, 3;
        lea rcx, [rip + _r103wt_stage];
        mov [rcx], rax;

        lea r10, [rip + _virtio_gpu_devices];
        mov r11, [r10 + 8];                      // bar4_pa

        mov rdi, 132;
        mov rsi, 0x001;                          // R_DPYB_QUERY
        mov rdx, 2;                              // VIRTIO_GPU_2D
        mov rcx, r11;                            // bar_pa
        xor r8, r8;
        xor r9, r9;
        call kind_display_backend_mint_body;

        mov r10, 4;
        cmp rax, r10;
        jae r103wt_fail;
        mov r12, rax;

        // ---------- Stage 4: allocate 2 host resources ----------
        mov rax, 4;
        lea rcx, [rip + _r103wt_stage];
        mov [rcx], rax;

        mov rdi, 1024;
        mov rsi, 768;
        call virtio_gpu_resource_create_2d;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  r103wt_fail;
        mov r15, rax;                            // res_a
        mov [rip + _r103wt_res_id_a], r15;

        mov rdi, 1024;
        mov rsi, 768;
        call virtio_gpu_resource_create_2d;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  r103wt_fail;
        mov rbx, rax;                            // res_b
        mov [rip + _r103wt_res_id_b], rbx;

        // ---------- Stage 5: mint 2 KIND_FRAMEBUFFERs ----------
        mov rax, 5;
        lea rcx, [rip + _r103wt_stage];
        mov [rcx], rax;

        // fb_a over buf_a. lfb_pa = &buf_a, lfb_va = &buf_a (identity).
        mov rdi, 133;
        mov rsi, r12;                            // backend_row
        mov rdx, 1024;
        mov rcx, 768;
        lea r8,  [rip + _r103wt_buf_a];          // lfb_pa
        lea r9,  [rip + _r103wt_buf_a];          // lfb_va
        call kind_framebuffer_mint_simple;
        mov r10, 4;
        cmp rax, r10;
        jae r103wt_fail;
        mov r13, rax;                            // fb_row_a

        // fb_b over buf_b.
        mov rdi, 134;
        mov rsi, r12;
        mov rdx, 1024;
        mov rcx, 768;
        lea r8,  [rip + _r103wt_buf_b];
        lea r9,  [rip + _r103wt_buf_b];
        call kind_framebuffer_mint_simple;
        mov r10, 4;
        cmp rax, r10;
        jae r103wt_fail;
        mov r14, rax;                            // fb_row_b

        // Wire pair slots both directions.
        mov rdi, r13;
        mov rsi, r14;
        call fb_row_pair_set;
        mov rdi, r14;
        mov rsi, r13;
        call fb_row_pair_set;

        // ---------- Stage 6: attach backing for both resources ----------
        mov rax, 6;
        lea rcx, [rip + _r103wt_stage];
        mov [rcx], rax;

        // buffer_bytes = 1024 * 768 * 4 = 3145728
        mov rdi, r15;                            // res_a
        lea rsi, [rip + _r103wt_buf_a];          // pa
        mov rdx, 3145728;                        // len
        call virtio_gpu_resource_attach_backing;
        cmp rax, 0;
        jne r103wt_fail;

        mov rdi, rbx;                            // res_b
        lea rsi, [rip + _r103wt_buf_b];
        mov rdx, 3145728;
        call virtio_gpu_resource_attach_backing;
        cmp rax, 0;
        jne r103wt_fail;

        // ---------- Stage 7: set scanout 0 = res_a ----------
        mov rax, 7;
        lea rcx, [rip + _r103wt_stage];
        mov [rcx], rax;

        xor rdi, rdi;                            // scanout_id
        mov rsi, r15;                            // resource_id
        xor rdx, rdx;                            // x
        xor rcx, rcx;                            // y
        mov r8, 1024;                            // w
        mov r9, 768;                             // h
        call virtio_gpu_set_scanout;
        cmp rax, 0;
        jne r103wt_fail;

        // ---------- Stage 8: paint red into buffer A ----------
        mov rax, 8;
        lea rcx, [rip + _r103wt_stage];
        mov [rcx], rax;

        lea rdi, [rip + _r103wt_buf_a];
        mov rsi, 0xFFFF0000;                     // BGRA red
        mov rdx, 786432;                         // 1024*768 pixels
        call r103wt_paint_solid;

        // ---------- Stage 9: TRANSFER + FLUSH resource A ----------
        mov rax, 9;
        lea rcx, [rip + _r103wt_stage];
        mov [rcx], rax;

        // Set active resource A so backend_flush knows what to publish.
        mov rdi, r15;
        mov rsi, 1024;
        mov rdx, 768;
        call virtio_gpu_set_active_resource;

        // Direct-flush via the backend (drives TRANSFER + FLUSH +
        // vblank signal internally).
        lea rdi, [rip + _r103wt_buf_a];          // src_va
        xor rsi, rsi;                            // dst_va unused
        mov rdx, 1024;
        mov rcx, 768;
        mov r8, 4096;                            // stride
        call virtio_gpu_backend_flush;
        cmp rax, 0;
        je  r103wt_fail;

        // ---------- Stage 10: paint green into buffer B ----------
        mov rax, 10;
        lea rcx, [rip + _r103wt_stage];
        mov [rcx], rax;

        lea rdi, [rip + _r103wt_buf_b];
        mov rsi, 0xFF00FF00;                     // BGRA green
        mov rdx, 786432;
        call r103wt_paint_solid;

        // ---------- Stage 11: SET_SCANOUT to res_b + backend_flush ----------
        mov rax, 11;
        lea rcx, [rip + _r103wt_stage];
        mov [rcx], rax;

        xor rdi, rdi;
        mov rsi, rbx;
        xor rdx, rdx;
        xor rcx, rcx;
        mov r8, 1024;
        mov r9, 768;
        call virtio_gpu_set_scanout;
        cmp rax, 0;
        jne r103wt_fail;

        mov rdi, rbx;
        mov rsi, 1024;
        mov rdx, 768;
        call virtio_gpu_set_active_resource;

        lea rdi, [rip + _r103wt_buf_b];
        xor rsi, rsi;
        mov rdx, 1024;
        mov rcx, 768;
        mov r8, 4096;
        call virtio_gpu_backend_flush;
        cmp rax, 0;
        je  r103wt_fail;

        // ---------- Stage 12: readback verify buffer contents ----------
        mov rax, 12;
        lea rcx, [rip + _r103wt_stage];
        mov [rcx], rax;

        // Buffer A pixel 0 should still be 0xFFFF0000 (red).
        lea r10, [rip + _r103wt_buf_a];
        xor rax, rax;
        mov eax, [r10];
        mov r11, 0xFFFF0000;
        cmp rax, r11;
        jne r103wt_fail;

        // Buffer B pixel 0 should be 0xFF00FF00 (green).
        lea r10, [rip + _r103wt_buf_b];
        xor rax, rax;
        mov eax, [r10];
        mov r11, 0xFF00FF00;
        cmp rax, r11;
        jne r103wt_fail;

        // ---------- Success: emit fingerprint ----------
        mov rdi, 3;                              // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_r103_ok];
        lea rcx, [rip + r103wt_k_n];
        mov r8, 2;
        call klog_s1_d1;

        // ---------- Stage 13: teardown ----------
        mov rdi, r15;                            // res_a
        call virtio_gpu_resource_unref;
        mov rdi, rbx;                            // res_b
        call virtio_gpu_resource_unref;

        mov rdi, r13;
        call kind_framebuffer_revoke_body;
        mov rdi, r14;
        call kind_framebuffer_revoke_body;
        mov rdi, r12;
        call kind_display_backend_revoke_body;
        call r103wt_clear_slots;

        jmp r103wt_done;

      r103wt_skip:
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_r103_skip];
        call klog_s1;
        call r103wt_clear_slots;
        jmp r103wt_done;

      r103wt_fail:
        mov rdi, 1;                              // LEVEL_ERROR
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_r103_fail];
        lea rcx, [rip + k_line];
        lea rax, [rip + _r103wt_stage];
        mov r8, [rax];
        call klog_s1_d1;
        call r103wt_clear_slots;

      r103wt_done:
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }
}
