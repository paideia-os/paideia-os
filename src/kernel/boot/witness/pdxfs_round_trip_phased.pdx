// src/kernel/boot/witness/pdxfs_round_trip_phased.pdx -- R53.M4-004 (#1751)
//
// Boot witness for the TWO-PHASE PDXFS round-trip smoke (sibling
// dispatcher modes `boot_r53_round_trip_phase1` and `boot_r53_round_
// trip_phase2` in tools/run-smoke.sh, meta-orchestrator in sibling
// #1752). Emits ONE of three output-strip-clean fingerprints per
// boot, discriminated by the persisted PDXB superblock's PDXB_SB_
// FLAG_CLEAN_UNMOUNT (bit 0 of the u32 flags field, superblock_fmt.
// pdx #1681) as read at witness-entry time via the REAL `sb_read`
// accessor (superblock.pdx, #1682) against a mount taken through the
// REAL `mount_pdxfs_block` entry point (mount_block.pdx, #1707).
//
// -----------------------------------------------------------------------------
// PHASE DISCRIMINATION
// -----------------------------------------------------------------------------
//
// The two `boot_r53_round_trip_phase{1,2}` dispatcher modes both
// boot the SAME kernel binary against the SAME persisted NVMe
// backing image. The dispatcher modes differ only in host-side disk
// lifecycle:
//
//   * Phase 1  ->  wipe the backing image, host-side mkfs (via
//                  tools/mkfs-pdxb.sh, R53.M1) or kernel-side mkfs_
//                  smoke witness (M8-001 / #1721) on a freshly-
//                  zeroed device.  The persisted superblock at
//                  witness-entry time has PDXB_SB_FLAG_CLEAN_UNMOUNT
//                  in the "not-yet-cleanly-umounted" state that this
//                  witness treats as PHASE1.
//   * Phase 2  ->  reuse the SAME backing image the prior phase's
//                  clean-umount witness (M8-004 / #1724) left with
//                  PDXB_SB_FLAG_CLEAN_UNMOUNT set on disk.  The
//                  witness sees the flag SET at witness-entry time
//                  and treats that as PHASE2.
//
// The three LIVE-arm outcomes are:
//
//   * bit 0 CLEAR  ->  "ROUND TRIP PHASE1 OK"
//                      (phase 1 discriminator -- freshly-mkfs'd
//                       volume that has NOT yet been through a
//                       clean-umount + reboot cycle)
//   * bit 0 SET    ->  "ROUND TRIP PHASE2 OK"
//                      (phase 2 discriminator -- persisted volume
//                       from a prior boot's clean umount)
//
// The mkfs.pdxfs.blk primitive writes flags=0x3 (CLEAN|ROOT_VOLUME)
// on a freshly-formatted volume today (mkfs.pdx L454 mkfs_sb_
// populate, R52.M2-003 #1688).  Sibling issue #1752 is the two-
// phase orchestrator meta-mode and carries the reciprocal
// adjustment: either the phase 1 dispatcher clears bit 0 on the
// host-side mkfs image (mkfs-pdxb.sh --set-root-flag equivalent),
// or the phase 1 kernel witness path clears bit 0 as its first act
// after mkfs -- either way this witness reads the semantic the
// header describes ("not cleanly umounted yet" for phase 1, "cleanly
// umounted from prior boot" for phase 2).  This witness does not
// own that policy choice; it only observes the flag as read.
//
// -----------------------------------------------------------------------------
// LIVE vs SUBSTRATE arm
// -----------------------------------------------------------------------------
//
// Every boot mode the smoke matrix drives WITHOUT the `--with-disk`
// wire-up (which #1752 lands via dispatcher glue) runs against
// NVMEIO_PICK_NONE-refused bdevs -- see the identical substrate
// posture already documented at length in pdxfs_reboot_verify_
// smoke.pdx (R52.M8-005 / #1725) and pdxfs_boot_mount_smoke.pdx
// (R52.M8-002 / #1722).  Under that posture, `mount_pdxfs_block`'s
// first nested call (`probe_one_bdev` -> `sb_read` -> `cap_invoke`
// BDEV_OP_READ_LBA) forwards a <2^32 sentinel rather than a
// KERNEL_VMA_BASE-relative sb_ptr, and `mount_pdxfs_block`'s
// `mpb_done` fall-through returns rax >= 16 (every failure sentinel
// is >= 0xFFFFED00, well beyond MOUNT_MAX=8).
//
// This witness distinguishes the two arms by inspecting the return
// value directly, mirroring pdxfs_reboot_verify_smoke.pdx's own
// `cmp rax, 8; jae <substrate>` idiom (identical probe.pdx-header
// bound):
//
//   * rax < 8  -> LIVE remount landed at slot rax.  Proceed to
//                 sb_read + sb_flags + branch on PDXB_SB_FLAG_CLEAN_
//                 UNMOUNT.  Emit PHASE1 or PHASE2 fingerprint.
//   * rax >= 8 -> No live bdev on this boot (substrate mode); the
//                 mount attempt bounced off NVMEIO_PICK_NONE.  Emit
//                 "ROUND TRIP PHASED SUBSTRATE OK".
//
// All three fingerprints are output-strip-clean (design/policy/
// output-provenance-strip.md); the sibling tests/r53/round-trip-
// phase1.golden and tests/r53/round-trip-phase2.golden pin the two
// LIVE arms respectively.  The SUBSTRATE arm is what every boot
// mode reaches today without --with-disk and is unpinned by any
// existing golden -- it is a "witness ran, no live device was
// available" line that would appear as an extra unpinned line in
// existing goldens (contains-in-order does not fail on unpinned
// extra lines).
//
// -----------------------------------------------------------------------------
// Substrate-mode NVMe cap trick (identical to pdxfs_reboot_verify_
// smoke.pdx / pdxfs_boot_mount_smoke.pdx / mount_replay_witness_
// synth.pdx / inode_table_witness_synth.pdx / block_cache_synth.pdx)
// -----------------------------------------------------------------------------
//
// Mints a real KIND_NVME_CONTROLLER + dual-kind KIND_NVME_NAMESPACE/
// KIND_BLKDEV row that never advances to a live SQ pair, so every
// READ_LBA `mount_pdxfs_block` issues through `probe_one_bdev`/
// `sb_read` forwards NVMEIO_PICK_NONE verbatim.  Cap slots 172..176
// are the same fixed range every R52 PdxFS witness already claims
// (tolerated per this tree's established practice: every witness
// clears its own range on entry AND on every exit path, and boot
// witnesses run strictly sequentially, so no two witnesses' cap
// rows are ever live at once).
//
//   172 = synthetic KIND_PCI_DEV parent for the NVMe controller
//   173 = KIND_NVME_CONTROLLER (row 0)
//   174 = KIND_NVME_NAMESPACE (row 0, dual-kind with slot 175)
//   175 = KIND_BLKDEV, family NVME -- the bdev_cap passed to
//         mount_pdxfs_block
//   176 = KIND_VOLUME target slot for mount_pdxfs_block's cap_slot
//         argument (only stamped by the LIVE arm; the SUBSTRATE arm
//         never reaches cap_mint_write inside mount_pdxfs_block)
//
// -----------------------------------------------------------------------------
// Reuse posture (M8 fingerprint reuse per this issue's own constraint)
// -----------------------------------------------------------------------------
//
// This witness intentionally does NOT re-emit any of the M8 stage
// fingerprints (MKFS SMOKE / BOOT MOUNT / PKG INSTALL / UMOUNT
// CLEAN / REBOOT VERIFY) -- those already fire from their own
// sibling witnesses (M8-001..005 / #1721..1725) earlier in the
// r30_platform_run boot chain and are pinned by the phase1/phase2
// goldens as ordered lines that appear BEFORE this witness's own
// terminal PHASE1/PHASE2 OK line.  Any regression that drops or
// reorders one of those upstream lines fails the golden at THAT
// line, not here -- the ordered-subsequence smoke check enforces
// the precedence, matching the same "diagnostic-locality" argument
// pdxfs_round_trip_final.pdx (R52.M8-006) documents at length.
//
// -----------------------------------------------------------------------------
// Failure taxonomy
// -----------------------------------------------------------------------------
//
// The SUBSTRATE arm is not a failure; only the LIVE arm can fail.
// In the LIVE arm any of (a) mount_pdxfs_block landing at an
// unexpected slot, (b) sb_read returning a sentinel, or (c) the
// (a)-(b) call sequence breaking down is a real breakage -- the
// same shape reboot_verify's own failure taxonomy documents.  Any
// such divergence hits `prtp_fail_stage`, which logs the stage
// number via klog_s1_d1(k_line) mirroring prv_fail_stage /
// pbms_fail_stage / itw_fail_stage, then runs the same cleanup and
// returns 1.
//
// -----------------------------------------------------------------------------
// Register plan
// -----------------------------------------------------------------------------
//
// 3-push prologue (rbx = bdev_cap 175, r12 = sb_ptr set in LIVE
// stage 7, r13 = flags value set in LIVE stage 8) lands rsp%16 == 0
// (entry rsp%16 == 8 + 24 = 32) for every nested call this function
// makes directly, matching pdxfs_reboot_verify_smoke.pdx /
// pdxfs_boot_mount_smoke.pdx / mount_block.pdx's own 3-push shape.
// `bdev_cap` (175), `cap_slot` (176), and every immediate argument
// are compile-time-constant literals -- no register needs to carry
// them across calls.  Stage number lives in `_prtp_stage` (memory,
// not a register), matching prv_stage / pbms_stage.  The one
// `sub rsp, 32` / `add rsp, 32` bracket around `nvme_ns_dual_kind_
// mint`'s params_ptr staging is 16-byte-aligned, so rsp%16 stays 0
// across it (identical bracket to the sibling witnesses).
//
// -----------------------------------------------------------------------------
// mov_b / no-test / label-prefix discipline
// -----------------------------------------------------------------------------
//
// No byte-granularity access anywhere -- every field touched is a
// u64 (via `mov`) or is extracted register-level via `and rax, 1`
// over an already-loaded qword (the bit-0 CLEAN_UNMOUNT extraction
// from the u32 flags value sb_flags returns zero-extended).  No
// `test` instruction anywhere; every comparison uses `cmp` +
// `je`/`jne`/`jae`/`jb`.  Every label is prefixed `prtp_` (Pdxfs
// Round Trip Phased) per the reserved-label discipline; grep audit
// 2026-08-23: no `prtp_` hits anywhere else in src/kernel/.
//
// Every sentinel compare against a value with bit 31/63 set (the
// KERNEL_VMA_BASE constant 0xFFFF800000000000 in step 7) is staged
// through `mov r10, <imm>; cmp reg, r10` rather than a bare `cmp
// reg, <imm>` -- identical G4 encoder-gap posture pdxfs_reboot_
// verify_smoke.pdx / pdxfs_boot_mount_smoke.pdx / mount_block.pdx
// headers document.
//
// -----------------------------------------------------------------------------
// Wire posture
// -----------------------------------------------------------------------------
//
// Wired into src/kernel/boot/witness/r30_platform.pdx immediately
// after `pdxfs_round_trip_final_call` (the terminal M8 fingerprint
// emitter, R52.M8-006).  Placement AFTER `pdxfs_round_trip_final_
// call` keeps the R52 round-trip golden (tests/r52/round-trip.
// golden) intact -- that golden's terminal "ROUND TRIP OK" line
// stays the ordered closer for the R52 sequence; this witness's
// own PHASE1/PHASE2/SUBSTRATE line lands AFTER it as an unpinned
// extra (fine under contains-in-order).  The R53 phase1/phase2
// goldens pin the PHASE1/PHASE2 line as their terminal ordered
// closer without depending on "ROUND TRIP OK" being present or
// absent.

module PdxfsRoundTripPhased = structure {

  pub let mut _prtp_stage : u64 = 0

  // Fingerprints. All three are output-strip-clean (no round/
  // milestone/issue tag). Length count includes the trailing
  // "\n\0" pair.
  pub let prtp_phase1_ok    : [u8; 22] = "ROUND TRIP PHASE1 OK\n\0"
  pub let prtp_phase2_ok    : [u8; 22] = "ROUND TRIP PHASE2 OK\n\0"
  pub let prtp_substrate_ok : [u8; 32] = "ROUND TRIP PHASED SUBSTRATE OK\n\0"
  pub let prtp_fail         : [u8; 23] = "ROUND TRIP PHASE FAIL\n\0"

  // ==========================================================================
  // prtp_clear() -- scrub cap_table slots 172..176 inclusive.
  //
  // Same shape as pdxfs_reboot_verify_smoke.pdx's prv_clear /
  // pdxfs_boot_mount_smoke.pdx's pbms_clear -- upper bound is 177
  // (exclusive), matching this witness's own slot claim.
  // ==========================================================================
  pub let prtp_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R53.M4-004 (#1751): clear cap_table slots 172..176 (this witness's whole fixed slot claim: 172..175 shared with prior R52 PdxFS witnesses per established practice, 176 this witness's own KIND_VOLUME target). Same shape as prv_clear/pbms_clear/itw_clear/mrw_clear, upper bound is 177 (exclusive). Labels prefixed prtp_cl_.",
      block: {
        push rbx;
        mov rbx, 172;
      prtp_cl_loop:
        cmp rbx, 177;
        jae prtp_cl_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp prtp_cl_loop;
      prtp_cl_done:
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // pdxfs_round_trip_phased() -> u64
  //
  // Entry rsp%16 == 8 (invoked from r30_platform.pdx's boot_continue_
  // after_ring3 body via `call pdxfs_round_trip_phased`, which
  // itself runs at %16==0 after r30_platform.pdx's own `push rbp`).
  // 3-push prologue lands rsp%16 == 0 for every nested call.
  //
  // See module header for the full LIVE vs SUBSTRATE branching, the
  // phase-discrimination semantic, and the substrate-mode NVMe cap
  // trick.
  // ==========================================================================
  pub let pdxfs_round_trip_phased : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R53.M4-004 (#1751): boot-time PDXFS two-phase round-trip discriminator witness. 3-push prologue (rbx=bdev_cap 175, r12=sb_ptr set in LIVE stage 7, r13=flags value set in LIVE stage 8) lands rsp%16==0 for every nested call. Body per module header: (1) defensive reset (nvme_ctrl_table_reset, nvme_ns_table_reset, prtp_clear). (2)-(4) mint substrate NVMe cap chain identical to pdxfs_reboot_verify_smoke.pdx's / pdxfs_boot_mount_smoke.pdx's stages 2-4 (KIND_PCI_DEV @172, KIND_NVME_CONTROLLER @173, dual-kind KIND_NVME_NAMESPACE/KIND_BLKDEV @174/175). (5) mount_pdxfs_block(cap_slot=176, bdev_cap=175, uuid_hint_lo=0, uuid_hint_hi=0); branch on rax >= 8 to prtp_substrate. LIVE arm: (6) sb_read(175) -> rax = sb_ptr; verify rax >= KERNEL_VMA_BASE (0xFFFF800000000000, staged via r10, cmp rax, r10, jb prtp_fail_stage); r12 = rax. (7) sb_flags(sb_ptr) -> rax = flags; r13 = rax; extract bit 0 (and rax, 1); cmp rax, 0; je prtp_phase1 (bit CLEAR -> phase 1) else fall through to phase 2. (8) phase 2 arm: klog_s1(3, SUBSYS_BOOT, prtp_phase2_ok); cleanup; return 0. prtp_phase1 arm: klog_s1(3, SUBSYS_BOOT, prtp_phase1_ok); cleanup; return 0. prtp_substrate arm: klog_s1(3, SUBSYS_BOOT, prtp_substrate_ok); cleanup; return 0. prtp_fail_stage: log stage number via klog_s1_d1(k_line) matching prv_fail_stage / pbms_fail_stage; cleanup; return 1. Every cleanup path calls prtp_clear + nvme_ctrl_table_reset + nvme_ns_table_reset before returning. Labels prefixed prtp_.",
      block: {
        push rbx;
        push r12;
        push r13;

        // -----------------------------------------------------------
        // (1) Defensive reset.
        // -----------------------------------------------------------
        mov rax, 1;
        lea rcx, [rip + _prtp_stage];
        mov [rcx], rax;

        call nvme_ctrl_table_reset;
        call nvme_ns_table_reset;
        call prtp_clear;

        // -----------------------------------------------------------
        // (2) Synthetic KIND_PCI_DEV parent (slot 172).
        // -----------------------------------------------------------
        mov rax, 2;
        lea rcx, [rip + _prtp_stage];
        mov [rcx], rax;

        mov rdi, 172;
        mov rsi, 0x30;                    // KIND_PCI_DEV
        mov rdx, 0x21F;                   // R_DEV_ALL | RIGHT_MINT
        mov rcx, 0xFACEFEED;              // synthetic bdf
        call cap_mint_write;

        // -----------------------------------------------------------
        // (3) KIND_NVME_CONTROLLER (slot 173, row 0). Never advanced
        // to a live SQ pair -- substrate-mode posture.
        // -----------------------------------------------------------
        mov rax, 3;
        lea rcx, [rip + _prtp_stage];
        mov [rcx], rax;

        mov rdi, 172;                     // parent_slot (KIND_PCI_DEV)
        mov rsi, 0x61F;                   // R_NVMEC_ALL
        xor rdx, rdx;                     // ctrl_idx = 0
        mov rcx, 0x400000;                // bar0_pa (synthetic)
        call nvme_ctrl_cap_mint_inner;
        cmp rax, 0;                       // expect row 0
        jne prtp_fail_stage;

        mov rdi, 173;
        mov rsi, 0x198;                   // KIND_NVME_CONTROLLER
        mov rdx, 0x61F;
        xor rcx, rcx;                     // target_ptr = ctrl_row_id = 0
        call cap_mint_write;

        // -----------------------------------------------------------
        // (4) Dual-kind KIND_NVME_NAMESPACE/KIND_BLKDEV (slots
        // 174/175, row 0).
        // -----------------------------------------------------------
        mov rax, 4;
        lea rcx, [rip + _prtp_stage];
        mov [rcx], rax;

        sub rsp, 32;
        mov rax, 1;
        mov [rsp + 0], rax;                // nsid
        mov rax, 4096;
        mov [rsp + 8], rax;                // lba_size
        mov rax, 100;
        mov [rsp + 16], rax;               // block_count
        xor rax, rax;
        mov [rsp + 24], rax;               // parent_ctrl_row = 0
        mov rdi, 174;                      // ns_slot
        mov rsi, 175;                      // blk_slot
        mov rdx, 173;                      // parent_slot (KIND_NVME_CONTROLLER)
        mov rcx, 0x41F;                    // ns_rights (R_NVMEN_ALL)
        mov r8,  0x1F;                     // blk_rights (R_BLK_ALL)
        mov r9,  rsp;                      // params_ptr
        call nvme_ns_dual_kind_mint;
        add rsp, 32;
        cmp rax, 0;                        // expect row 0
        jne prtp_fail_stage;

        // -----------------------------------------------------------
        // (5) mount_pdxfs_block(cap_slot=176, bdev_cap=175,
        //     uuid_hint_lo=0, uuid_hint_hi=0). Then branch: rax >= 8
        // <=> substrate arm (per module header discussion of the
        // MOUNT_MAX=8 vs 0xFFFFED00-band sentinel disambiguation).
        // -----------------------------------------------------------
        mov rax, 5;
        lea rcx, [rip + _prtp_stage];
        mov [rcx], rax;

        mov rdi, 176;                      // cap_slot (KIND_VOLUME target)
        mov rsi, 175;                      // bdev_cap
        xor rdx, rdx;                      // uuid_hint_lo = 0 (no hint)
        xor rcx, rcx;                      // uuid_hint_hi = 0 (no hint)
        call mount_pdxfs_block;

        cmp rax, 8;
        jae prtp_substrate;

        // -----------------------------------------------------------
        // (6) LIVE arm: sb_read(175) -> sb_ptr. Verify
        // >= KERNEL_VMA_BASE via r10-staged compare (bit 63 set, per
        // G4 discipline).
        // -----------------------------------------------------------
        mov rax, 6;
        lea rcx, [rip + _prtp_stage];
        mov [rcx], rax;

        mov rdi, 175;
        call sb_read;
        mov r10, 0xFFFF800000000000;       // KERNEL_VMA_BASE
        cmp rax, r10;
        jb prtp_fail_stage;
        mov r12, rax;                      // r12 = sb_ptr

        // -----------------------------------------------------------
        // (7) LIVE arm: sb_flags(sb_ptr) -> flags. Extract bit 0
        // (PDXB_SB_FLAG_CLEAN_UNMOUNT). r13 holds the raw u32 flags
        // value for any future extension (r13 is dead thereafter);
        // rax holds the extracted bit for the branch.
        // -----------------------------------------------------------
        mov rax, 7;
        lea rcx, [rip + _prtp_stage];
        mov [rcx], rax;

        mov rdi, r12;
        call sb_flags;
        mov r13, rax;                      // r13 = flags (informational)
        and rax, 1;                        // extract bit 0
        cmp rax, 0;
        je prtp_phase1;                    // bit CLEAR -> phase 1 arm

        // -----------------------------------------------------------
        // (8) LIVE bit-SET arm: this is phase 2 (persisted volume
        // from a prior boot's clean umount).
        // -----------------------------------------------------------
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + prtp_phase2_ok];
        call klog_s1;

        call prtp_clear;
        call nvme_ctrl_table_reset;
        call nvme_ns_table_reset;
        xor rax, rax;
        jmp prtp_out;

      prtp_phase1:
        // LIVE bit-CLEAR arm: this is phase 1 (freshly-mkfs'd
        // volume that has not yet been through a clean-umount +
        // reboot cycle).
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + prtp_phase1_ok];
        call klog_s1;

        call prtp_clear;
        call nvme_ctrl_table_reset;
        call nvme_ns_table_reset;
        xor rax, rax;
        jmp prtp_out;

      prtp_substrate:
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + prtp_substrate_ok];
        call klog_s1;

        call prtp_clear;
        call nvme_ctrl_table_reset;
        call nvme_ns_table_reset;
        xor rax, rax;
        jmp prtp_out;

      prtp_fail_stage:
        lea rax, [rip + _prtp_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + prtp_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;

        call prtp_clear;
        call nvme_ctrl_table_reset;
        call nvme_ns_table_reset;
        mov rax, 1;

      prtp_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
