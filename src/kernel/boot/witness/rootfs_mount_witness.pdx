// src/kernel/boot/witness/rootfs_mount_witness.pdx -- R111.M3-013 (#2365)
//
// Kernel-side witness for the ESP-embedded PdxFS-lite rootfs blob path
// landed in the sibling changes to src/boot/uefi_env.pdx +
// src/boot/uefi_stub.pdx.  Runs from r30_platform.pdx's tail (last call
// before pop rbp) at every boot in every mode; emits one of two
// fingerprints depending on whether the UEFI stub found and staged a
// blob:
//
//   * OK   (initrd_pa != 0 in boot_env @ +104):
//         "ROOTFS MOUNT OK type=pdxfs pa=0x<pa> size=<n>"
//         via klog_s1_x1_d1 with tag "ROOTFS MOUNT OK type=pdxfs" plus
//         KV[0]=k_pa (hex), KV[1]=k_size (decimal).  UEFI-only —
//         allowlisted in tools/verify-fingerprint-coverage.sh under
//         the same "no OVMF smoke mode boots past ExitBootServices yet"
//         posture as UEFI BRIDGE OK / UEFI PML4 OK / UEFI EBS OK.
//
//   * NONE (initrd_pa == 0 in boot_env, OR _boot_env_pa == 0 on the
//         PVH -kernel boot path where the UEFI stub never ran):
//         "ROOTFS MOUNT NONE" via klog_s1.  No OK token → invisible
//         to the fingerprint-coverage extractor; asserted in
//         tests/r17/shell-shutdown.golden as an ordered-substring line
//         to pin the ordinary -kernel matrix outcome.
//
// =============================================================================
// SCOPE — this witness is fingerprint-only
// =============================================================================
//
// The parent milestone (#2365) explicitly caps this landing at
// "fingerprint witnesses only -- no functional change to pre-existing
// tmpfs behavior".  The follow-up milestone (R111.M3 continuation)
// lands the file-bdev wrapper over the blob and the vfs_mount("/",
// "pdxfs", file_bdev) call site that actually swaps out tmpfs; this
// witness's role is to prove the plumbing that FEEDS that mount
// (UEFI-side load + boot_env slot carry + kernel-side read) works
// end-to-end, so the mount-site landing has nothing to prove about
// blob provenance and can focus on the mount arm itself.
//
// The kernel-side witness deliberately does NOT dereference the blob
// or attempt to validate its contents.  A malformed blob (wrong magic,
// truncated tail) is a downstream mount-arm concern; this witness's
// contract is "did the loader hand us bytes?", not "is what it handed
// us a valid PdxFS-lite volume?".  This keeps the witness's failure
// mode narrow: absence of the OK fingerprint means the load chain
// broke somewhere in the UEFI stub or the boot_env carry; presence of
// OK with a garbage blob is the mount arm's job to catch.
//
// =============================================================================
// WHERE _boot_env_pa COMES FROM
// =============================================================================
//
// _boot_env_pa (src/kernel/kernel_main_uefi.pdx L156) is a .bss u64
// latched from RDI on entry to kernel_main_uefi (the UEFI-path
// entrypoint).  Under the PVH -kernel boot path (14-mode default
// matrix), kernel_main_uefi is never called — control enters
// kernel_main_64 directly from src/kernel/boot/entry.pdx `_start`, and
// _boot_env_pa stays at its .bss zero-init value.  This witness's
// zero-check for _boot_env_pa therefore does double duty: on -kernel
// it steers to the NONE arm before ever touching (env+104), and on
// UEFI it gates against a hypothetical future refactor where the
// finalizer skips its latch step (defensive).
//
// =============================================================================
// REGISTER + ALIGNMENT LEDGER
// =============================================================================
//
// Caller (r30_platform_run's boot-witness tail) invokes via `call
// rootfs_mount_witness_run` with rsp%16 == 8 (the same parity every
// other witness in that function relies on, per r30_platform.pdx file
// header on inline parity restoration).  Body:
//
//   push rbx           ; entry %16==8 -> %16==0
//   push r12           ; %16==0 -> %16==8
//
// After the two callee-save pushes, rsp%16 == 8.  Two branches:
//
//   OK path: klog_s1_x1_d1 takes 7 args (v2 spills to [rsp+8]):
//     push r12         ; place initrd_size on stack -> %16==0
//     ; set up 6 arg regs (rdi/rsi/rdx/rcx/r8/r9)
//     call klog_s1_x1_d1
//     add rsp, 8       ; -> %16==8
//
//   NONE path: klog_s1 takes 3 args (all regs):
//     sub rsp, 8       ; pad -> %16==0
//     ; set up 3 arg regs (rdi/rsi/rdx)
//     call klog_s1
//     add rsp, 8       ; -> %16==8
//
// Both paths converge at pop r12; pop rbx; ret with %16==8 at entry
// to ret (return-addr pop -> %16==0 in caller).
//
// Callee-save usage:
//   rbx = initrd_pa  (survives across klog call in OK path;
//                     preserved for the (unused) return value in both)
//   r12 = initrd_size (survives; consumed by push+add on OK path)
//
// =============================================================================
// LABEL DISCIPLINE
// =============================================================================
//
// All local labels prefixed `rmw_` — grep audit 2026-09-07: no `rmw_`
// hits anywhere else in src/kernel/.  Reserved so that a future
// enhancement (e.g. actual mount at this site, or a variant that
// checks the blob's PdxFS-lite magic before emit) can extend the
// witness's label namespace without collision.

module RootfsMountWitness = structure {

  // ==========================================================================
  // Fingerprint tags
  //
  // Both tags NUL-terminated but WITHOUT a trailing \n (the klog
  // emitter appends its own \n\0 at line-end; a \n inside the tag
  // would land in the middle of the emit for the OK path, before the
  // KV loop appends " pa=... size=...").
  //
  // OK tag: "ROOTFS MOUNT OK type=pdxfs\0"  — 26 chars + NUL = 27 B.
  //   Contains the OK fingerprint token; verify-fingerprint-coverage.sh
  //   will see it and require an allowlist entry (added at this
  //   landing under the same "UEFI-only" posture as UEFI BRIDGE OK).
  //
  // NONE tag: "ROOTFS MOUNT NONE\0"  — 17 chars + NUL = 18 B.
  //   No OK token → invisible to the coverage extractor; asserted in
  //   tests/r17/shell-shutdown.golden as an ordered substring line so
  //   the default -kernel matrix pins the every-boot NONE outcome.
  // ==========================================================================

  pub let tag_rootfs_mount_ok   : [u8; 27] = "ROOTFS MOUNT OK type=pdxfs\0"
  pub let tag_rootfs_mount_none : [u8; 18] = "ROOTFS MOUNT NONE\0"

  // ==========================================================================
  // rootfs_mount_witness_run() -> u64
  //
  //   Reads _boot_env_pa (src/kernel/kernel_main_uefi.pdx's u64 latch);
  //   if zero, or if boot_env->initrd_pa @ +104 is zero, emits ROOTFS
  //   MOUNT NONE and returns 0.  Otherwise reads boot_env->initrd_size
  //   @ +112 and emits ROOTFS MOUNT OK with the pair via klog_s1_x1_d1.
  //   Return value always 0 (caller does not consume; matches the sibling
  //   closer-witness convention of pdxfs_first_mount_witness et al).
  //
  //   Cross-module references: _boot_env_pa (KernelMainUefi module),
  //   klog_s1 / klog_s1_x1_d1 / k_pa / k_size / SUBSYS_BOOT (klog
  //   subsystem).  All standard, no new confinement gate needed.
  //
  //   Encoder posture per parent-issue #2365 pitfall list:
  //     * No test rN,rN — every branch is `cmp reg,0; je/jne`.
  //     * No 2-op imul r,imm — no multiplication here at all.
  //     * No and reg,imm64 — no masking here.
  //     * No cmp reg,[mem] — every memory read is staged through rax
  //       before the compare (see rmw_load_env / rmw_load_pa idiom).
  // ==========================================================================
  pub let rootfs_mount_witness_run : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R111.M3-013 (paideia-os #2365): kernel-side witness for the ESP-embedded PdxFS-lite rootfs blob load. Reads _boot_env_pa (src/kernel/kernel_main_uefi.pdx L156); a zero (PVH -kernel boot, UEFI finalizer skipped latch) steers to the NONE arm. Otherwise reads boot_env->initrd_pa @ +104 (R111.M3-013 slot per src/boot/uefi_env.pdx BOOT_ENV_OFFSET_INITRD_PA); a zero (UEFI boot on an ESP that does not carry L\"\\EFI\\PAIDEIA\\rootfs.pdxfs\", or any failure along the SFS/Open/GetInfo/AllocatePool/Read chain in efi_load_initrd) also steers to NONE. On the OK path (both non-zero) reads boot_env->initrd_size @ +112 and emits `ROOTFS MOUNT OK type=pdxfs pa=0x<pa> size=<n>` via klog_s1_x1_d1 (tag_rootfs_mount_ok + KV[0]=k_pa hex + KV[1]=k_size decimal). NONE arm emits `ROOTFS MOUNT NONE` via klog_s1 (tag_rootfs_mount_none). Return value always 0. Register plan: rbx = initrd_pa (also gates the KV emit), r12 = initrd_size (consumed by the push+add v2-spill on the OK path). Alignment ledger: entry rsp%16==8 (r30_platform_run boot-witness convention); 2 callee-save pushes -> %16==8. OK path: `push r12` (v2 spill) -> %16==0, call klog_s1_x1_d1, add rsp, 8 -> %16==8. NONE path: `sub rsp, 8` pad -> %16==0, call klog_s1, add rsp, 8 -> %16==8. Both paths converge at pop r12; pop rbx; xor rax, rax; ret. Encoder pitfalls: no test rN,rN (all cmp reg,0), no imul r,imm (no multiply), no and reg,imm64, no cmp reg,[mem] (every memory read staged through rax before compare). Cross-module refs: _boot_env_pa (KernelMainUefi), klog_s1 + klog_s1_x1_d1 + k_pa + k_size + SUBSYS_BOOT (klog). Fingerprint policy: OK tag carries the OK token so verify-fingerprint-coverage.sh sees it and requires the sibling ALLOWLIST entry (added at this landing under the same 'UEFI-only reachability' posture as UEFI BRIDGE OK / UEFI PML4 OK / UEFI EBS OK); NONE tag carries no OK token so the coverage gate ignores it, and tests/r17/shell-shutdown.golden pins it as an ordered substring line for the -kernel matrix. Labels prefixed rmw_ (grep audit 2026-09-07: no rmw_ hits elsewhere in src/kernel/).",
      block: {
        push rbx;
        push r12;

        // Load _boot_env_pa (staged through rax before compare per the
        // no-cmp-reg-[mem] encoder discipline).  Zero => PVH -kernel
        // boot or UEFI finalizer never latched the pointer; both mean
        // "no boot_env to read from" => NONE.
        mov rax, [rip + _boot_env_pa];
        cmp rax, 0;
        je rmw_none;

        // Load boot_env->initrd_pa @ +104 into rbx.  Zero => no blob
        // was loaded (either no rootfs.pdxfs on the ESP, or the load
        // chain in efi_load_initrd failed at some step).
        mov rbx, [rax + 104];
        cmp rbx, 0;
        je rmw_none;

        // Load boot_env->initrd_size @ +112 into r12.  Not gated on
        // zero: the UEFI-side load already guards against zero-length
        // blobs (see efi_load_initrd Step 4 zero-length check), so if
        // initrd_pa is non-zero here initrd_size is guaranteed
        // non-zero.  If a future loader ever violates that invariant
        // this witness will emit `size=0` on the wire, which is a
        // clearer diagnostic than silent NONE-fallback.
        mov r12, [rax + 112];

        // OK path: klog_s1_x1_d1(3, SUBSYS_BOOT, tag_rootfs_mount_ok,
        //                        k_pa, rbx, k_size, [rsp+8]=r12).
        // Push r12 first — the wrapper reads v2 as its 7th arg from
        // [rbp+16] after its own push rbp (per klog_s1_x1_d1's own
        // justification in src/kernel/core/klog/wrappers.pdx).
        push r12;
        mov rdi, 3;                              // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_rootfs_mount_ok];
        lea rcx, [rip + k_pa];                   // k1 hex key
        mov r8, rbx;                             // v1 = initrd_pa
        lea r9, [rip + k_size];                  // k2 dec key
        call klog_s1_x1_d1;
        add rsp, 8;

        jmp rmw_done;

      rmw_none:
        // NONE path: klog_s1(3, SUBSYS_BOOT, tag_rootfs_mount_none).
        // sub rsp, 8 pad to reach %16==0 for the call (post-prologue
        // rsp%16==8; sub 8 -> %16==0).
        sub rsp, 8;
        mov rdi, 3;                              // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_rootfs_mount_none];
        call klog_s1;
        add rsp, 8;

      rmw_done:
        xor rax, rax;
        pop r12;
        pop rbx;
        ret
      }
    }
}
