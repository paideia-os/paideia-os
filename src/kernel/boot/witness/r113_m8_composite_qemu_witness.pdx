// src/kernel/boot/witness/r113_m8_composite_qemu_witness.pdx
// -- Wave ν (α–τ plan, deferred): paideia-os #2420 QEMU proxy.
//
// -----------------------------------------------------------------------------
// What this witness proves (and what it CANNOT prove)
// -----------------------------------------------------------------------------
//
// paideia-os#2420 -- "Multi-surface composite witness on Iris Xe" --
// is gated on real T14 G4 silicon executing GPU BLEND / SF stages
// with three concurrent scanout planes.  It CANNOT be closed by any
// QEMU session (QEMU has no Iris Xe blend pipeline).
//
// This witness is the QEMU-approximation code-path exerciser Wave ν
// commits to landing so that the code side of the issue is genuinely
// done and only the "run on real T14" remains.  Its stance is:
//
//   * Under `PAIDEIA_VGA=std tools/run-qemu.sh`, QEMU synthesises a
//     Bochs stdvga LFB the R101 cascade already maps at
//     _bochs_stdvga_devices[0]+40.
//   * This witness exercises the KIND_SURFACE R113.M1-001 mint
//     substrate directly, minting three surfaces (each 100x100 with
//     format=1).  Success proves the row-pool low-first scan, LAM
//     header stamp, and stats.mints bump all run for three back-to-
//     back mints (each returning a fresh row_id in [0, 3)).
//   * It then CPU-side-composites three non-overlapping 100x100
//     regions into the LFB with distinctive sentinels 0x11111111,
//     0x22222222, 0x33333333.  A single mfence drains WC.  It reads
//     back one pixel from the interior of each region and asserts
//     the pattern matches -- proof that "all three surfaces reached
//     the framebuffer" at the pixel-visibility layer.
//   * Finally, all three KIND_SURFACE rows are destroyed so a re-run
//     (e.g. a chaos-restart cycle in a follow-on wave) finds the pool
//     clean.
//
// The mint substrate is real (calls into src/kernel/core/cap/kind_
// surface.pdx).  The compositing IS CPU-side because
// src/user/compositor/damage_aggregate.pdx is a user-space module
// that does not link into kernel.elf.  Wave ν deliberately publishes
// this asymmetry rather than fake a call into a user-space module
// the kernel binary does not contain -- honesty about the surface it
// exercises (row-pool + framebuffer) vs the surface it can't (GPU
// blend / SF) is exactly the point of the ALLOWLIST entry that lands
// alongside.
//
// What this witness does NOT do (and honestly cannot on QEMU): it
// does not invoke Iris Xe SF (source-flow) or the GPU BLEND pipeline,
// does not compose via KIND_PAGE_FLIP, and does not exercise the
// user-space compositor's damage_aggregate_from_tree.  Those are the
// "run on real T14" half of #2420.
//
// -----------------------------------------------------------------------------
// Fingerprint
// -----------------------------------------------------------------------------
//
//   Emits on success (3 mints + 3 blits + 3 readbacks + 3 destroys):
//     "R113 M8-040 COMPOSITE QEMU OK"
//   Skip (no bochs stdvga device probed OR lfb_va unmapped):
//     "R113 M8-040 COMPOSITE QEMU SKIP"
//   Fail (any mint / readback / destroy misbehaves):
//     "R113 M8-040 COMPOSITE QEMU FAIL line=<N>"
//
// -----------------------------------------------------------------------------
// Region layout (non-overlapping, all inside the 1024x768 stdvga LFB)
// -----------------------------------------------------------------------------
//
//   Region 1: origin ( 50,  50), 100x100, sentinel 0x11111111
//   Region 2: origin (300, 300), 100x100, sentinel 0x22222222
//   Region 3: origin (600, 500), 100x100, sentinel 0x33333333
//
// Read-back pixel is the region's origin+50 (i.e. dead center of the
// 100x100 tile) so a stride slip of even a few pixels stays inside
// the region.
//
// -----------------------------------------------------------------------------
// Encoder / SysV discipline
// -----------------------------------------------------------------------------
//
// Labels prefixed `r113co_`.  Every nested call boundary at
// rsp%16==0.  No `test rN, rN`; no 2-op `imul r, imm`; no `mov_d
// reg, reg`; sentinels 0x1111.../0x2222.../0x3333... loaded via
// `mov r64, imm64` (fit imm32 zero-extended, but staged in a
// register before the LFB store).

module R113M8CompositeQemuWitness = structure {

  pub let tag_r113_m8_co_ok   : [u8; 30] = "R113 M8-040 COMPOSITE QEMU OK\0"
  pub let tag_r113_m8_co_skip : [u8; 32] = "R113 M8-040 COMPOSITE QEMU SKIP\0"
  pub let tag_r113_m8_co_fail : [u8; 32] = "R113 M8-040 COMPOSITE QEMU FAIL\0"

  pub let mut _r113co_stage : u64 = 0

  // Persist the three row_ids across nested calls so both the
  // populate step and the destroy step address the same slots.
  pub let mut _r113co_row_1 : u64 = 0
  pub let mut _r113co_row_2 : u64 = 0
  pub let mut _r113co_row_3 : u64 = 0

  // ==========================================================================
  // Helper: blit one 100x100 tile of a solid sentinel into the LFB
  // at (ox, oy).  Stride 4096 (bochs 1024*4).  No callee-save touched.
  //
  // r113co_tile_blit(lfb_va, ox, oy, sentinel) -> ()
  // ==========================================================================

  pub let r113co_tile_blit : (u64, u64, u64, u64) -> () !{mem} @{} =
    fn (lfb_va: u64, ox: u64, oy: u64, sentinel: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave ν: fill a 100x100 tile at (ox, oy) with `sentinel` (u32 written via mov_d [mem], r). Row byte offset = (oy+row)*1024*4 + (ox+col)*4. Inner loop is per-pixel to keep arithmetic transparent (~10000 pixels; runs 3 times per boot when active). Six callee-save pushes (rbx=lfb_va base+row_off, rbp=col, r12=row, r13=ox, r14=oy, r15=sentinel) leave rsp%16==0 (entry rsp%16==8, +48 -> 56, %16==8 -> sub rsp,8 -> 64, %16==0). Labels prefixed r113co_tb_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;

        mov rbx, rdi;                             // lfb_va
        mov r13, rsi;                             // ox
        mov r14, rdx;                             // oy
        mov r15, rcx;                             // sentinel

        xor r12, r12;                             // row = 0

      r113co_tb_yloop:
        cmp r12, 100;
        jae r113co_tb_done;

        xor rbp, rbp;                             // col = 0

      r113co_tb_xloop:
        cmp rbp, 100;
        jae r113co_tb_ynext;

        // pixel_addr = lfb + ((oy+row)*1024 + (ox+col)) * 4
        mov r10, r14;
        add r10, r12;                             // r10 = oy+row
        shl r10, 10;                              // * 1024
        mov r11, r13;
        add r11, rbp;                             // r11 = ox+col
        add r10, r11;                             // r10 = (oy+row)*1024 + (ox+col)
        shl r10, 2;                               // * 4
        add r10, rbx;                             // + lfb_va

        mov_d [r10], r15;

        add rbp, 1;
        jmp r113co_tb_xloop;

      r113co_tb_ynext:
        add r12, 1;
        jmp r113co_tb_yloop;

      r113co_tb_done:
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Helper: read one pixel from (lfb_va, x, y), zero-extended to u64.
  // Mirrors r113so_pixel_round_trip but read-only (no store, no
  // sentinel).  Leaf, no callee-save.
  //
  // r113co_pixel_read(lfb_va, x, y) -> u64
  // ==========================================================================

  pub let r113co_pixel_read : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (lfb_va: u64, x: u64, y: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave ν: mfence-fenced read of one 32-bit BGRA pixel from (x, y). Stride 4096. Zero-extended into rax via `xor rax, rax; mov_d rax, [mem]`. Labels prefixed r113co_pr_.",
      block: {
        mov r10, rdx;
        shl r10, 10;                              // y * 1024
        add r10, rsi;                             // + x
        shl r10, 2;                               // * 4
        add r10, rdi;                             // + lfb_va

        mfence;
        xor rax, rax;
        mov_d rax, [r10];
        ret
      }
    }

  // ==========================================================================
  // witness_r113_m8_composite_qemu() -> ()
  //
  // Placement: called from kernel_main after witness_r113_m8_scanout_
  // qemu.
  //
  // Register plan:
  //   rbx = lfb_va (survives every nested call)
  //   r12/r13/r14 = row_id 1, 2, 3 (spilled to _r113co_row_{1,2,3})
  //
  // Four callee-save pushes (32 B); entry rsp%16==8 -> 40, %16==8 ->
  // sub rsp,8 -> 48, %16==0 for every nested call.
  // ==========================================================================

  pub let witness_r113_m8_composite_qemu : () -> () !{mem, sysreg} @{boot, cap} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot, cap},
      justification: "Wave ν (α–τ plan, deferred): paideia-os #2420 QEMU-proxy witness. Skips cleanly when no Bochs stdvga device was probed OR lfb_va unmapped. When active: (Stage 2) three back-to-back surface_mint(owner=1, w=100, h=100, format=1) calls exercising the R113 M1-001 substrate; each must return a row_id < SURFACE_ROW_MAX(16). (Stage 3) three tile blits into non-overlapping LFB regions with sentinels 0x11111111 / 0x22222222 / 0x33333333. (Stage 4) three center-pixel readbacks assert the sentinel round-trips. (Stage 5) three surface_destroy calls scrub the pool. Any refusal jumps fail. Four callee-save pushes + sub rsp,8: entry rsp%16==8 -> 48, %16==0 for every nested call. Labels prefixed r113co_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        sub rsp, 8;

        // ---------- Stage 1: skip guard ----------
        mov rax, 1;
        lea rcx, [rip + _r113co_stage];
        mov [rcx], rax;

        mov rax, [rip + _bochs_stdvga_device_count];
        cmp rax, 0;
        je  r113co_skip;

        lea r10, [rip + _bochs_stdvga_devices];
        mov rbx, [r10 + 40];
        cmp rbx, 0;
        je  r113co_skip;

        // ---------- Stage 2: three KIND_SURFACE mints ----------
        mov rax, 2;
        lea rcx, [rip + _r113co_stage];
        mov [rcx], rax;

        // surface_mint(owner_task=1, w=100, h=100, format=1)
        mov rdi, 1;
        mov rsi, 100;
        mov rdx, 100;
        mov rcx, 1;
        call surface_mint;
        // Any return >= SURFACE_ROW_MAX(16) is a sentinel (0xFFFFE11x).
        mov r10, 16;
        cmp rax, r10;
        jae r113co_fail;
        mov r12, rax;
        mov [rip + _r113co_row_1], r12;

        mov rdi, 1;
        mov rsi, 100;
        mov rdx, 100;
        mov rcx, 1;
        call surface_mint;
        mov r10, 16;
        cmp rax, r10;
        jae r113co_fail_after_1;
        mov r13, rax;
        mov [rip + _r113co_row_2], r13;

        mov rdi, 1;
        mov rsi, 100;
        mov rdx, 100;
        mov rcx, 1;
        call surface_mint;
        mov r10, 16;
        cmp rax, r10;
        jae r113co_fail_after_2;
        mov r14, rax;
        mov [rip + _r113co_row_3], r14;

        // ---------- Stage 3: three tile blits into LFB ----------
        mov rax, 3;
        lea rcx, [rip + _r113co_stage];
        mov [rcx], rax;

        mov rdi, rbx;                             // lfb_va
        mov rsi, 50;                              // ox
        mov rdx, 50;                              // oy
        mov rcx, 0x11111111;                      // sentinel
        call r113co_tile_blit;

        mov rdi, rbx;
        mov rsi, 300;
        mov rdx, 300;
        mov rcx, 0x22222222;
        call r113co_tile_blit;

        mov rdi, rbx;
        mov rsi, 600;
        mov rdx, 500;
        mov rcx, 0x33333333;
        call r113co_tile_blit;

        // Drain the WC buffer before any readback so a still-buffered
        // store cannot leak into a "read of what I just wrote" false
        // green.  r113co_pixel_read fences internally too; this fence
        // is belt-and-braces at the end of the write burst.
        mfence;

        // ---------- Stage 4: three center-pixel readbacks ----------
        mov rax, 4;
        lea rcx, [rip + _r113co_stage];
        mov [rcx], rax;

        // Region 1 center = (100, 100)
        mov rdi, rbx;
        mov rsi, 100;
        mov rdx, 100;
        call r113co_pixel_read;
        mov r11, 0x11111111;
        cmp rax, r11;
        jne r113co_fail_after_3;

        // Region 2 center = (350, 350)
        mov rdi, rbx;
        mov rsi, 350;
        mov rdx, 350;
        call r113co_pixel_read;
        mov r11, 0x22222222;
        cmp rax, r11;
        jne r113co_fail_after_3;

        // Region 3 center = (650, 550)
        mov rdi, rbx;
        mov rsi, 650;
        mov rdx, 550;
        call r113co_pixel_read;
        mov r11, 0x33333333;
        cmp rax, r11;
        jne r113co_fail_after_3;

        // ---------- Stage 5: destroy all three surfaces ----------
        mov rax, 5;
        lea rcx, [rip + _r113co_stage];
        mov [rcx], rax;

        mov rdi, [rip + _r113co_row_1];
        call surface_destroy;
        mov rdi, [rip + _r113co_row_2];
        call surface_destroy;
        mov rdi, [rip + _r113co_row_3];
        call surface_destroy;

        // ---------- All stages green: emit OK ----------
        mov rdi, 3;                               // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_r113_m8_co_ok];
        call klog_s1;
        jmp r113co_done;

      r113co_skip:
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_r113_m8_co_skip];
        call klog_s1;
        jmp r113co_done;

        // Fail funnels: each destroys whichever rows had been minted
        // before the failure so the pool is not left with dangling
        // in_use bits on a re-run.
      r113co_fail_after_3:
        mov rdi, [rip + _r113co_row_3];
        call surface_destroy;
      r113co_fail_after_2:
        mov rdi, [rip + _r113co_row_2];
        call surface_destroy;
      r113co_fail_after_1:
        mov rdi, [rip + _r113co_row_1];
        call surface_destroy;
      r113co_fail:
        mov rdi, 1;                               // LEVEL_ERROR
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_r113_m8_co_fail];
        lea rcx, [rip + k_line];
        lea rax, [rip + _r113co_stage];
        mov r8, [rax];
        call klog_s1_d1;

      r113co_done:
        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
