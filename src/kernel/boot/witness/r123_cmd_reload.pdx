// src/kernel/boot/witness/r123_cmd_reload.pdx -- R123.M6 (paideia-os #2507)
//
// Boot-time witness for the R123.M6 command-registry hot-reload
// primitive (cmd_registry_reload -- see src/kernel/core/shell/cmd_
// registry.pdx §17). Exercises the file-absent branch: passes a
// nonexistent root ("/nonexistent/commands.toml") which drives the
// inner cmd_registry_load through its vfs_open==0 arm, leaving the
// LRU cache unchanged. Asserts:
//   (a) the returned delta is 0 (nothing loaded from a missing
//       file), AND
//   (b) cr_count_populated() is unchanged (pre_count == post_count).
//
// The substrate emits the acceptance fingerprint itself as part of
// cmd_registry_reload's tail:
//   `cmd registry reloaded old=<pre_count> new=0`
// via klog_s1_x2 (SUBSYS_CAP_, tag_cmd_registry_reloaded, k_old,
// k_new). This witness does NOT re-emit the fingerprint -- one
// authoritative emission from the substrate keeps the wire clean.
//
// Placement: runs AFTER witness_r123_cmd_discovery so the LRU cache
// already holds the R123.M2 + R123.M3 seeds (7 rows). pre_count at
// witness time is expected to be 7, but the witness does NOT hard-
// code that number -- it asserts the DELTA (== 0) and the post-
// snapshot invariant (post == pre), so a future witness that seeds
// additional rows earlier in the cascade does not break this one.
//
// =============================================================================
// FAILURE FUNNEL STAGES
// =============================================================================
//
//   1 = cmd_registry_reload returned a nonzero delta (unexpected --
//       the target path does not exist, so nothing should have been
//       loaded)
//   2 = post-reload cr_count_populated() != pre_count (unexpected --
//       the file-absent branch must not mutate the cache)
//
// =============================================================================
// R123.M6-FOLLOWUP HOOKS
// =============================================================================
//
// When the true atomic-swap semantics + FS-watch (KIND_FS_WATCH)
// integration land, this witness is the reference site for asserting
// that the reload observes a self-consistent cache snapshot even
// while concurrent lookups run. Today's witness runs single-threaded
// at boot so that concern is dormant.
//
// =============================================================================
// ENCODER DISCIPLINE
// =============================================================================
//
// No `test rN, rN`; every zero-check uses `cmp reg, 0`. Every store
// to _r123crl_stage is a qword `mov [mem], reg`. Labels prefixed
// `r123crl_` (reserved-word discipline; distinct from the R123.M2
// witness's `r123cr_` prefix).

module R123CmdReload = structure {

  // ==========================================================================
  // Stage counter + failure message.
  // ==========================================================================

  pub let mut _r123crl_stage : u64 = 0

  // "boot cmd reload fail" = 20 chars + NUL = 21.
  pub let r123crl_fail_msg : [u8; 21] = "boot cmd reload fail\0"

  // Nonexistent root path. cr_build_path composes <root>/shell/
  // commands.toml onto the caller's root, so the file the vfs
  // ultimately opens is "/nonexistent/commands.toml/shell/commands.
  // toml" -- guaranteed absent under the R123.M6 CoW FS.
  //   "/nonexistent/commands.toml" = 26 chars + NUL = 27.
  pub let r123crl_nonexistent_path : [u8; 27] = "/nonexistent/commands.toml\0"
  pub let R123CRL_NONEXISTENT_LEN  : u64 = 26

  // ==========================================================================
  // witness_r123_cmd_reload() -> ()
  //
  // Sequence:
  //   Stage 1: snapshot pre_count via cr_count_populated().
  //            call cmd_registry_reload(nonexistent_path, 26);
  //            assert returned delta == 0.
  //   Stage 2: snapshot post_count via cr_count_populated();
  //            assert post_count == pre_count.
  //
  // The acceptance fingerprint is emitted by cmd_registry_reload
  // itself as part of the primitive's tail (SUBSYS_CAP_,
  // tag_cmd_registry_reloaded). No re-emit here.
  //
  // Register plan: five callee-save pushes (rbx = pre_count stash
  // across nested calls, r12/r13/r14/r15 unused-but-preserved for
  // sibling-witness parity -- keeps the rsp%16 math identical to
  // witness_r123_cmd_discovery / witness_r123_cmd_registry). Entry
  // rsp%16==8, +40 -> %16==0 at every nested call. No klog_s1_x2
  // caller-push idiom in this witness (the substrate owns the
  // emit); only the failure funnel uses klog_s1_d1 which does not
  // spill args to the caller frame.
  //
  // Failure funnel emits `boot cmd reload fail line=<stage>` via
  // klog_s1_d1 (LEVEL_INFO, matching sibling R123 witnesses so the
  // boot smoke does not pull a panic on golden diff). Labels
  // prefixed r123crl_.
  // ==========================================================================
  pub let witness_r123_cmd_reload : () -> () !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R123.M6 (paideia-os #2507): boot witness for the command-registry hot-reload primitive. Sequence: (Stage 1) snapshot pre_count via cr_count_populated; call cmd_registry_reload with a nonexistent root ('/nonexistent/commands.toml', len=26); assert returned delta == 0 (file absent -> load returned 0 -> cache unchanged -> delta = 0). (Stage 2) snapshot post_count; assert post_count == pre_count (the file-absent branch must not mutate the cache). The acceptance fingerprint `cmd registry reloaded old=<pre_count> new=0` is emitted by cmd_registry_reload itself as part of the primitive's tail (SUBSYS_CAP_, tag_cmd_registry_reloaded, k_old, k_new) so this witness does NOT re-emit. Register plan: five callee-save pushes (rbx=pre_count stash across nested calls, r12-r15 unused-but-preserved for sibling-witness parity) leave rsp%16==0 at nested calls (entry rsp%16==8, +40 -> %16==0). Failure funnel emits `boot cmd reload fail line=<stage>` via klog_s1_d1 (LEVEL_INFO, matching sibling R123 witnesses). No teardown: the reload primitive is idempotent on the shared LRU cache; a file-absent reload adds nothing to tear down. Labels prefixed r123crl_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // ------------------------------------------------------------
        // Stage 1: snapshot pre_count + call reload with a nonexistent
        // path + assert returned delta == 0.
        // ------------------------------------------------------------
        mov rax, 1;
        mov [rip + _r123crl_stage], rax;

        // Snapshot pre_count.
        call cr_count_populated;
        mov rbx, rax;                    // rbx = pre_count

        // Invoke reload with the nonexistent path. cmd_registry_
        // reload will emit its own fingerprint on return.
        lea rdi, [rip + r123crl_nonexistent_path];
        mov rsi, 26;                     // R123CRL_NONEXISTENT_LEN
        call cmd_registry_reload;

        // Assert delta == 0.
        cmp rax, 0;
        jne r123crl_fail;

        // ------------------------------------------------------------
        // Stage 2: snapshot post_count + assert post == pre.
        // ------------------------------------------------------------
        mov rax, 2;
        mov [rip + _r123crl_stage], rax;

        call cr_count_populated;
        cmp rax, rbx;
        jne r123crl_fail;

        jmp r123crl_out;

      // ================================================================
      // Failure funnel: emit `boot cmd reload fail line=<stage>` via
      // klog_s1_d1 (LEVEL_INFO, matching sibling R123 witnesses so the
      // boot smoke does not pull a panic on golden diff).
      // ================================================================
      r123crl_fail:
        mov rax, [rip + _r123crl_stage];
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + r123crl_fail_msg];
        lea rcx, [rip + k_line];
        mov r8,  rax;                    // v = stage
        call klog_s1_d1;

      r123crl_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
