// src/kernel/boot/witness/pdxfs_boot_mount_smoke.pdx -- R52.M8-002 (#1722)
//
// Boot witness for the PDXFS-on-block v1 ROOT MOUNT path: after any
// earlier mkfs step (the R52.M8-001 sibling, #1721, extends tools/
// run-smoke.sh to mkfs.pdxfs the QEMU-attached blank NVMe device), this
// witness attempts to mount that device via the REAL
// `mount_pdxfs_block` entry point (core/fs/pdxfs/mount_block.pdx, #1707),
// verifies the resulting `_mount_table[MOUNT_ROOT_SLOT]` row cleanly
// packs backend=MOUNT_BACKEND_PDXFS_BLOCK (5) + MOUNT_FLAG_VALID + a
// KIND_VOLUME row_id, reads the root inode number back through the
// REAL `sb_root_inode` accessor (superblock.pdx, #1682), and proves the
// row it names fetches cleanly through the REAL `inode_read`
// (inode_table.pdx, #1698) with the row's own `inode_no` field
// round-tripping exactly.
//
// -----------------------------------------------------------------------------
// LIVE vs SUBSTRATE arm
// -----------------------------------------------------------------------------
//
// Every boot mode the smoke matrix drives today runs against
// NVMEIO_PICK_NONE-refused bdevs (see block_cache_synth.pdx /
// mount_replay_witness_synth.pdx headers for the identical substrate
// posture). Under that posture, `mount_pdxfs_block`'s first nested
// call (`probe_one_bdev` -> `sb_read` -> `cap_invoke` BDEV_OP_READ_LBA)
// forwards a <2^32 sentinel (PDXB_SB_READ_BDEV_ERR or one of the
// four validation codes) rather than a KERNEL_VMA_BASE-relative sb_ptr;
// `mount_pdxfs_block`'s `mpb_done` fall-through then returns rax >= 16
// (every failure sentinel is >= 0xFFFFED00, well beyond MOUNT_MAX=8).
//
// This witness distinguishes the two arms by inspecting the return
// value directly, mirroring `probe_one_bdev`'s / `probe_all_bdevs`'s
// own `cmp rax, 16; jae <not a row_id>` idiom (probe.pdx header, "row
// ids are 0..15; every failure sentinel it can produce is far larger"
// -- MOUNT_MAX=8 uses the same bound conservatively):
//
//   * rax < 8  -> LIVE mount landed at slot rax. Proceed to _mount_
//                 table[0] verification + sb_root_inode + inode_read.
//                 Emit "PDXFS BOOT MOUNT OK".
//   * rax >= 8 -> No live bdev on this boot (substrate mode); the
//                 mount attempt bounced off NVMEIO_PICK_NONE. Emit
//                 "PDXFS BOOT MOUNT SUBSTRATE OK".
//
// Both fingerprints are output-strip-clean (design/policy/output-
// provenance-strip.md); the golden pins the SUBSTRATE arm today (that
// is what every boot mode reaches without a real NVMe device) and can
// gain the LIVE arm as a second ordered line once run-smoke.sh (#1721)
// attaches the real device, without disturbing the SUBSTRATE line's
// placement immediately after "BLOCK CACHE SUBSTRATE OK".
//
// -----------------------------------------------------------------------------
// Substrate-mode NVMe cap trick (identical to mount_replay_witness_
// synth.pdx / inode_table_witness_synth.pdx / alloc_free_hint_witness_
// synth.pdx / block_cache_synth.pdx)
// -----------------------------------------------------------------------------
//
// Mints a real KIND_NVME_CONTROLLER + dual-kind KIND_NVME_NAMESPACE/
// KIND_BLKDEV row that never advances to a live SQ pair, so every
// READ_LBA/WRITE_LBA/FLUSH `mount_pdxfs_block` issues through
// `probe_one_bdev`/`sb_read`/`journal_replay` forwards NVMEIO_PICK_
// NONE verbatim. Cap slots 172..175 are the same fixed range every
// R52 PdxFS witness already claims (tolerated per this tree's
// established practice: every witness clears its own range on entry
// AND on every exit path, and boot witnesses run strictly
// sequentially, so no two witnesses' cap rows are ever live at once).
// Slot 176 is this witness's own KIND_VOLUME target for
// `mount_pdxfs_block`'s cap_slot argument -- also cleared on entry
// and on every exit path.
//
//   172 = synthetic KIND_PCI_DEV parent for the NVMe controller
//   173 = KIND_NVME_CONTROLLER (row 0)
//   174 = KIND_NVME_NAMESPACE (row 0, dual-kind with slot 175)
//   175 = KIND_BLKDEV, family NVME -- the bdev_cap passed to
//         mount_pdxfs_block
//   176 = KIND_VOLUME target slot for mount_pdxfs_block's cap_slot
//         argument (only stamped by the LIVE arm; the SUBSTRATE arm
//         never reaches cap_mint_write inside mount_pdxfs_block)
//
// -----------------------------------------------------------------------------
// Why this is meaningful in substrate mode too
// -----------------------------------------------------------------------------
//
// The SUBSTRATE arm still exercises the whole call-stack shape:
// `mount_pdxfs_block` is invoked with a live-looking KIND_BLKDEV cap;
// its 3-push prologue and its own `sb_read` argument staging execute;
// `probe_one_bdev`'s stats table is bumped once for SCANNED and once
// for SKIPPED. What DOES NOT execute is the mount-table write, the
// `cap_mint_write` for KIND_VOLUME slot 176, and the journal_replay
// path. This is the same "primitive is wired, substrate has nothing
// to give it" degradation `block_cache_synth.pdx` documents at
// length for its own M7-006 witness -- and this witness's own LIVE
// arm below is structured so it lights up automatically the first
// boot mode that HAS a live PdxFS-block device.
//
// -----------------------------------------------------------------------------
// What the LIVE arm proves
// -----------------------------------------------------------------------------
//
// (a) `mount_pdxfs_block(176, 175, 0, 0)` returned a valid mount_slot
//     in [0, 8). This is the strong proof point: it means every
//     nested call along the mount path succeeded end to end --
//     `probe_one_bdev` (validates + registers), the second
//     `sb_read`, uuid-hint pass-through (both hints 0), journal
//     region readback, `journal_replay` (returned non-BEYOND_HEAD),
//     `journal_writer_set_checkpoint`, mount-table free-slot scan,
//     `volume_row_mount_slot_set`, `cap_mint_write` at slot 176,
//     and the mount-table entry pack.
// (b) `_mount_table[0]` decoded: backend byte at bits [32,40) == 5
//     (MOUNT_BACKEND_PDXFS_BLOCK), flags byte at bits [40,48) has
//     bit 0 (MOUNT_FLAG_VALID) set, reserved u16 at bits [48,64) is
//     the KIND_VOLUME row_id (0..15) `mount_pdxfs_block` stamped
//     there (§3.2 of design/filesystem/volume-fs-substrate.md).
// (c) `sb_read(175)` returned a real KERNEL_VMA_BASE-relative sb_ptr
//     (>= 0xFFFF800000000000) -- the same distinguishing-idiom
//     mount_pdxfs_block's own step (3) uses.
// (d) `itable_init(sb_ptr)` returned 0 (always does, but stamped to
//     seed `_itable_state` from the mounted volume's own superblock
//     regions -- `inode_read`'s own precondition, inode_table.pdx
//     header gap 2).
// (e) `sb_root_inode(sb_ptr)` returned a non-zero inode number
//     (inode 0 is the permanent sentinel per inode_table.pdx §7).
//     v0 discipline fixes root_inode at 1 (PDXB_SB_ROOT_INODE_
//     DEFAULT); the check is >= 1 rather than == 1 so this witness
//     survives a future multi-root design bump without a golden
//     churn.
// (f) `inode_read(175, root_ino)` returned neither
//     INODE_INVALID_INDEX (0xFFFFED18) nor INODE_HEADER_INUSE_BAD
//     (0xFFFFED19) nor the reused ALLOC_BITMAP_TORN (0xFFFFED11) --
//     the three sentinels inode_table_witness_synth.pdx's own
//     header enumerates -- and the returned row's `inode_no` field
//     (@+8) round-tripped exactly to the value sb_root_inode named.
//
// -----------------------------------------------------------------------------
// Failure taxonomy
// -----------------------------------------------------------------------------
//
// The SUBSTRATE arm is not a failure; only the LIVE arm can fail. In
// the LIVE arm every sub-check is monotonic: if any of (b)-(f) does
// not hold after (a) succeeded, that is a real breakage in the mount
// path -- either mount_pdxfs_block's own entry-pack, sb_read's
// pointer-vs-sentinel contract, itable_init's precondition wiring,
// sb_root_inode's field offset, or inode_read's row round-trip. Any
// such divergence hits `pbms_fail_stage`, which logs the stage
// number via klog_s1_d1(k_line) mirroring
// inode_table_witness_synth.pdx's own itw_fail_stage, then runs the
// same cleanup and returns 1.
//
// -----------------------------------------------------------------------------
// Register plan
// -----------------------------------------------------------------------------
//
// 3-push prologue (rbx = bdev_cap 175, r12 = sb_ptr set in the LIVE
// arm's stage 9, r13 = root_ino set in the LIVE arm's stage 11) lands
// rsp%16 == 0 (entry rsp%16 == 8 + 24 = 32) for every nested call
// this function makes directly, matching mount_block.pdx's own 3-push
// shape. `bdev_cap` (175), `cap_slot` (176), and every immediate
// argument are compile-time-constant literals -- no register needs to
// carry them across calls. Stage number lives in `_pbms_stage`
// (memory, not a register), matching inode_table_witness_synth.pdx's
// `_itw_stage` / mount_replay_witness_synth.pdx's `_mrw_stage` idiom.
// The one `sub rsp, 32` / `add rsp, 32` bracket around
// `nvme_ns_dual_kind_mint`'s params_ptr staging is 16-byte-aligned,
// so rsp%16 stays 0 across it (identical bracket to
// inode_table_witness_synth.pdx / mount_replay_witness_synth.pdx).
//
// -----------------------------------------------------------------------------
// mov_b / no-test / label-prefix discipline
// -----------------------------------------------------------------------------
//
// No byte-granularity access anywhere -- every field touched is a u64
// (via `mov`) or is extracted register-level via `shr`+`and` over an
// already-loaded qword (backend/flag/row_id extraction from the packed
// mount-table entry, and in_use byte extraction from the inode row).
// No `test` instruction anywhere; every comparison uses `cmp` +
// `je`/`jne`/`jae`/`jb`. Every label is prefixed `pbms_` (PdxFS Boot
// Mount Smoke) per the reserved-label discipline. Grep audit
// 2026-08-23: no `pbms_` hits anywhere else in src/kernel/.
//
// Every sentinel compare against a value with bit 31/63 set (the three
// M4 failure codes 0xFFFFED18/19/11 and the KERNEL_VMA_BASE constant
// 0xFFFF800000000000) is staged through `mov r10, <imm>; cmp reg, r10`
// rather than a bare `cmp reg, <imm>` -- identical G4 encoder-gap
// posture inode_table_witness_synth.pdx's / mount_block.pdx's own
// headers document.
//
// -----------------------------------------------------------------------------
// Wire posture
// -----------------------------------------------------------------------------
//
// Wired into src/kernel/boot/witness/r30_platform.pdx immediately after
// `block_cache_witness_call` (the most recent PdxFS-cluster addition
// to that file at the time of this landing). Sibling issue #1721
// (R52.M8-001, run-smoke.sh mkfs.pdxfs on QEMU-attached blank NVMe)
// may add its own `pdxfs_mkfs_smoke_witness_call` between
// `block_cache_witness_call` and this witness's call; a future
// re-ordering to place this witness AFTER that one preserves the
// "mount witness observes the mkfs'd device" story the M8 plan
// text describes. Golden: tests/r17/shell-shutdown.golden ("PDXFS
// BOOT MOUNT SUBSTRATE OK" appended right after "BLOCK CACHE
// SUBSTRATE OK", matching every prior PdxFS witness's own golden-
// placement precedent).

module PdxfsBootMountSmoke = structure {

  pub let mut _pbms_stage : u64 = 0

  // Fingerprints. All three are output-strip-clean (no round/milestone/
  // issue tag). Length count includes the trailing "\n\0" pair.
  pub let pbms_live_ok      : [u8; 21] = "PDXFS BOOT MOUNT OK\n\0"
  pub let pbms_substrate_ok : [u8; 31] = "PDXFS BOOT MOUNT SUBSTRATE OK\n\0"
  pub let pbms_fail         : [u8; 23] = "PDXFS BOOT MOUNT FAIL\n\0"

  // ==========================================================================
  // pbms_clear() -- scrub cap_table slots 172..176 inclusive.
  //
  // Same shape as inode_table_witness_synth.pdx's itw_clear /
  // mount_replay_witness_synth.pdx's mrw_clear, extended by one slot
  // (176) for this witness's own KIND_VOLUME target.
  // ==========================================================================
  pub let pbms_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R52.M8-002 (#1722): clear cap_table slots 172..176 (this witness's whole fixed slot claim: 172..175 shared with prior R52 PdxFS witnesses per established practice, 176 this witness's own KIND_VOLUME target). Same shape as itw_clear/mrw_clear, upper bound is 177 (exclusive). Labels prefixed pbms_cl_.",
      block: {
        push rbx;
        mov rbx, 172;
      pbms_cl_loop:
        cmp rbx, 177;
        jae pbms_cl_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp pbms_cl_loop;
      pbms_cl_done:
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // pdxfs_boot_mount_smoke() -> u64
  //
  // Entry rsp%16 == 8 (invoked from r30_platform.pdx's boot_continue_
  // after_ring3 body via `call pdxfs_boot_mount_smoke`, which itself
  // runs at %16==0 after r30_platform.pdx's own `push rbp`). 3-push
  // prologue lands rsp%16 == 0 for every nested call.
  //
  // See module header for the full LIVE vs SUBSTRATE branching, the
  // substrate-mode NVMe cap trick, and the six-check LIVE arm scope
  // note.
  // ==========================================================================
  pub let pdxfs_boot_mount_smoke : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R52.M8-002 (#1722): boot-time PDXFS root mount smoke witness. 3-push prologue (rbx=bdev_cap 175, r12=sb_ptr set in LIVE stage 9, r13=root_ino set in LIVE stage 11) lands rsp%16==0 for every nested call. Body per module header: (1) defensive reset (nvme_ctrl_table_reset, nvme_ns_table_reset, pbms_clear). (2)-(4) mint substrate NVMe cap chain identical to mount_replay_witness_synth.pdx's / inode_table_witness_synth.pdx's stages 2-4 (KIND_PCI_DEV @172, KIND_NVME_CONTROLLER @173, dual-kind KIND_NVME_NAMESPACE/KIND_BLKDEV @174/175). (5) mount_pdxfs_block(cap_slot=176, bdev_cap=175, uuid_hint_lo=0, uuid_hint_hi=0). (6) Branch: cmp rax, 8; jae pbms_substrate (per module header, mount_slot ids are 0..7 and every failure sentinel is >= 0xFFFFED00 > 8). LIVE arm: (7) load _mount_table[0], verify backend byte at bits [32,40) == 5 (MOUNT_BACKEND_PDXFS_BLOCK). (8) verify flags byte at bits [40,48) has bit 0 (MOUNT_FLAG_VALID) set. (9) sb_read(175) -> rax = sb_ptr; verify rax >= KERNEL_VMA_BASE (0xFFFF800000000000, staged via r10, cmp rax, r10, jb pbms_fail_stage); r12 = rax. (10) itable_init(r12); expect rax == 0 (always does, but the call is required by inode_read's precondition per inode_table.pdx header gap 2). (11) sb_root_inode(r12) -> rax = root_ino; verify rax >= 1 (inode 0 is the permanent sentinel, v0 discipline fixes root at 1 but the check is >= to survive a future multi-root bump); r13 = rax. (12) inode_read(175, r13): rax must be neither of INODE_INVALID_INDEX (0xFFFFED18) / INODE_HEADER_INUSE_BAD (0xFFFFED19) / the reused ALLOC_BITMAP_TORN (0xFFFFED11) -- all three staged via mov r10, <imm>; cmp rax, r10; je pbms_fail_stage per this codebase's G4 discipline. Then [rax+8] (inode_no field) must equal r13 (round-trip). (13) All LIVE checks passed -> klog_s1(3, SUBSYS_BOOT, pbms_live_ok); cleanup; return 0. SUBSTRATE arm: klog_s1(3, SUBSYS_BOOT, pbms_substrate_ok); cleanup; return 0. pbms_fail_stage: log stage number via klog_s1_d1(k_line) matching itw_fail_stage / mrw_fail_stage; cleanup; return 1. Every cleanup path calls pbms_clear + nvme_ctrl_table_reset + nvme_ns_table_reset before returning. Labels prefixed pbms_.",
      block: {
        push rbx;
        push r12;
        push r13;

        // -----------------------------------------------------------
        // (1) Defensive reset.
        // -----------------------------------------------------------
        mov rax, 1;
        lea rcx, [rip + _pbms_stage];
        mov [rcx], rax;

        call nvme_ctrl_table_reset;
        call nvme_ns_table_reset;
        call pbms_clear;

        // -----------------------------------------------------------
        // (2) Synthetic KIND_PCI_DEV parent (slot 172).
        // -----------------------------------------------------------
        mov rax, 2;
        lea rcx, [rip + _pbms_stage];
        mov [rcx], rax;

        mov rdi, 172;
        mov rsi, 0x30;                    // KIND_PCI_DEV
        mov rdx, 0x21F;                   // R_DEV_ALL | RIGHT_MINT
        mov rcx, 0xFACEFEED;              // synthetic bdf
        call cap_mint_write;

        // -----------------------------------------------------------
        // (3) KIND_NVME_CONTROLLER (slot 173, row 0). Never advanced
        // to a live SQ pair -- substrate-mode posture.
        // -----------------------------------------------------------
        mov rax, 3;
        lea rcx, [rip + _pbms_stage];
        mov [rcx], rax;

        mov rdi, 172;                     // parent_slot (KIND_PCI_DEV)
        mov rsi, 0x61F;                   // R_NVMEC_ALL
        xor rdx, rdx;                     // ctrl_idx = 0
        mov rcx, 0x400000;                // bar0_pa (synthetic)
        call nvme_ctrl_cap_mint_inner;
        cmp rax, 0;                       // expect row 0
        jne pbms_fail_stage;

        mov rdi, 173;
        mov rsi, 0x198;                   // KIND_NVME_CONTROLLER
        mov rdx, 0x61F;
        xor rcx, rcx;                     // target_ptr = ctrl_row_id = 0
        call cap_mint_write;

        // -----------------------------------------------------------
        // (4) Dual-kind KIND_NVME_NAMESPACE/KIND_BLKDEV (slots
        // 174/175, row 0).
        // -----------------------------------------------------------
        mov rax, 4;
        lea rcx, [rip + _pbms_stage];
        mov [rcx], rax;

        sub rsp, 32;
        mov rax, 1;
        mov [rsp + 0], rax;                // nsid
        mov rax, 4096;
        mov [rsp + 8], rax;                // lba_size
        mov rax, 100;
        mov [rsp + 16], rax;               // block_count
        xor rax, rax;
        mov [rsp + 24], rax;               // parent_ctrl_row = 0
        mov rdi, 174;                      // ns_slot
        mov rsi, 175;                      // blk_slot
        mov rdx, 173;                      // parent_slot (KIND_NVME_CONTROLLER)
        mov rcx, 0x41F;                    // ns_rights (R_NVMEN_ALL)
        mov r8,  0x1F;                     // blk_rights (R_BLK_ALL)
        mov r9,  rsp;                      // params_ptr
        call nvme_ns_dual_kind_mint;
        add rsp, 32;
        cmp rax, 0;                        // expect row 0
        jne pbms_fail_stage;

        // -----------------------------------------------------------
        // (5) mount_pdxfs_block(cap_slot=176, bdev_cap=175,
        //     uuid_hint_lo=0, uuid_hint_hi=0).
        // -----------------------------------------------------------
        mov rax, 5;
        lea rcx, [rip + _pbms_stage];
        mov [rcx], rax;

        mov rdi, 176;                      // cap_slot (KIND_VOLUME target)
        mov rsi, 175;                      // bdev_cap
        xor rdx, rdx;                      // uuid_hint_lo = 0 (no hint)
        xor rcx, rcx;                      // uuid_hint_hi = 0 (no hint)
        call mount_pdxfs_block;

        // -----------------------------------------------------------
        // (6) Branch on mount result. Every failure sentinel is
        // >= 0xFFFFED00, and mount_slot ids are 0..7 (MOUNT_MAX=8);
        // >= 8 therefore unambiguously identifies the SUBSTRATE arm.
        // -----------------------------------------------------------
        cmp rax, 8;
        jae pbms_substrate;

        // -----------------------------------------------------------
        // (7) LIVE arm: verify _mount_table[0] backend byte == 5
        // (MOUNT_BACKEND_PDXFS_BLOCK).
        // -----------------------------------------------------------
        mov rax, 7;
        lea rcx, [rip + _pbms_stage];
        mov [rcx], rax;

        lea r10, [rip + _mount_table];
        mov rax, [r10 + 0];                // _mount_table[MOUNT_ROOT_SLOT]
        mov rcx, rax;
        shr rcx, 32;
        and rcx, 0xFF;                     // backend byte
        cmp rcx, 5;                        // MOUNT_BACKEND_PDXFS_BLOCK
        jne pbms_fail_stage;

        // -----------------------------------------------------------
        // (8) LIVE arm: verify flags byte has bit 0 (MOUNT_FLAG_VALID)
        // set. rax still holds the packed entry from step (7).
        // -----------------------------------------------------------
        mov rax, 8;
        lea rcx, [rip + _pbms_stage];
        mov [rcx], rax;

        lea r10, [rip + _mount_table];
        mov rax, [r10 + 0];
        mov rcx, rax;
        shr rcx, 40;
        and rcx, 0xFF;                     // flags byte
        mov rdx, rcx;
        and rdx, 1;                        // MOUNT_FLAG_VALID
        cmp rdx, 1;
        jne pbms_fail_stage;

        // -----------------------------------------------------------
        // (9) LIVE arm: sb_read(175) -> sb_ptr. Verify >= KERNEL_VMA_
        // BASE via r10-staged compare (bit 63 set, per G4 discipline).
        // -----------------------------------------------------------
        mov rax, 9;
        lea rcx, [rip + _pbms_stage];
        mov [rcx], rax;

        mov rdi, 175;
        call sb_read;
        mov r10, 0xFFFF800000000000;       // KERNEL_VMA_BASE
        cmp rax, r10;
        jb pbms_fail_stage;
        mov r12, rax;                      // r12 = sb_ptr

        // -----------------------------------------------------------
        // (10) LIVE arm: itable_init(sb_ptr) == 0. inode_read's
        // precondition per inode_table.pdx header gap 2.
        // -----------------------------------------------------------
        mov rax, 10;
        lea rcx, [rip + _pbms_stage];
        mov [rcx], rax;

        mov rdi, r12;
        call itable_init;
        cmp rax, 0;
        jne pbms_fail_stage;

        // -----------------------------------------------------------
        // (11) LIVE arm: sb_root_inode(sb_ptr) -> root_ino; verify
        // >= 1 (inode 0 is the permanent sentinel).
        // -----------------------------------------------------------
        mov rax, 11;
        lea rcx, [rip + _pbms_stage];
        mov [rcx], rax;

        mov rdi, r12;
        call sb_root_inode;
        cmp rax, 1;
        jb pbms_fail_stage;
        mov r13, rax;                      // r13 = root_ino

        // -----------------------------------------------------------
        // (12) LIVE arm: inode_read(175, root_ino) is not a sentinel,
        // and the returned row's inode_no field (@+8) round-trips.
        // -----------------------------------------------------------
        mov rax, 12;
        lea rcx, [rip + _pbms_stage];
        mov [rcx], rax;

        mov rdi, 175;
        mov rsi, r13;
        call inode_read;
        mov r10, 0xFFFFED18;               // INODE_INVALID_INDEX
        cmp rax, r10;
        je pbms_fail_stage;
        mov r10, 0xFFFFED19;               // INODE_HEADER_INUSE_BAD
        cmp rax, r10;
        je pbms_fail_stage;
        mov r10, 0xFFFFED11;               // ALLOC_BITMAP_TORN (reused)
        cmp rax, r10;
        je pbms_fail_stage;

        mov rcx, [rax + 8];                // inode_no field
        cmp rcx, r13;
        jne pbms_fail_stage;

        // -----------------------------------------------------------
        // (13) LIVE arm success.
        // -----------------------------------------------------------
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + pbms_live_ok];
        call klog_s1;

        call pbms_clear;
        call nvme_ctrl_table_reset;
        call nvme_ns_table_reset;
        xor rax, rax;
        jmp pbms_out;

      pbms_substrate:
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + pbms_substrate_ok];
        call klog_s1;

        call pbms_clear;
        call nvme_ctrl_table_reset;
        call nvme_ns_table_reset;
        xor rax, rax;
        jmp pbms_out;

      pbms_fail_stage:
        lea rax, [rip + _pbms_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + pbms_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;

        call pbms_clear;
        call nvme_ctrl_table_reset;
        call nvme_ns_table_reset;
        mov rax, 1;

      pbms_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
