// src/kernel/boot/witness/r92_icmp_ping.pdx -- R92.M3-001
// (paideia-os #2039)
//
// Boot-time off-box ICMP-ping witness: ARP-resolve QEMU SLIRP's
// gateway (10.0.2.2), send an ICMP Echo Request through the real
// NIC's TX ring, poll the RX path until an Echo Reply arrives (or a
// bounded budget expires), emit a rollup fingerprint.
//
// =============================================================================
// SECTION 0  WHY A DEDICATED OFF-BOX ICMP WITNESS
// =============================================================================
//
// R27.M6 landed icmp_rx_handle (the Echo REPLY responder). R100-PREP-
// 003 (net/icmp.pdx:347+) landed icmp_send_echo_request (the Echo
// REQUEST originator). But neither has ever run against a real NIC
// TX/RX ring in this tree: the R72 TCP witness uses the self-loopback
// fast path (local_ip == remote_ip); the R100-PREP-003 loopback
// witness synchronously invokes icmp_rx_handle without hitting the
// wire; every off-box send-path exists only as callable code.
//
// This witness is the FIRST evidence that:
//
//   1. arp_send_request actually queues an ARP request into a live
//      NIC's TX ring (not the R27 e1000e-hardcoded path -- routes
//      through nic_dispatch_tx under R91.M1-003).
//   2. The receive side (nic_dispatch_rx_poll into l2_rx_handle into
//      arp_rx_handle) reaps the QEMU SLIRP reply and populates the
//      ARP cache with a legal MAC for 10.0.2.2.
//   3. icmp_send_echo_request's off-box arm (iser_offbox at
//      net/icmp.pdx:479..488) actually reaches ipv4_tx_send with a
//      cache-warm arp_cache_lookup, so it does NOT return
//      IPV4_E_ARP_PENDING (which would leave the packet un-sent).
//   4. QEMU SLIRP synthesises the Echo Reply and the receive-poll
//      path drains it through l2_rx_handle -> ipv4_rx_handle ->
//      icmp_rx_handle, whose "not Echo Request" arm bumps
//      _icmp_rx_other (icmp.pdx §icrh_other).
//
// The bump on _icmp_rx_other is the assertable observation the
// witness keys on.
//
// =============================================================================
// SECTION 1  SKIP DISCIPLINE
// =============================================================================
//
// Under PAIDEIA_NIC=none the R91 probe cascade leaves
// _active_nic_kind = 0 and no NIC TX/RX ring exists. The witness
// emits `boot r92 icmp skip -- reason=no-nic` and returns without
// touching any net-stack primitive. Under the polling budgets below
// exhausting without any observed ARP reply or ICMP reply, the
// witness emits `boot r92 icmp skip -- reason=no-link` -- the RX
// polling path is real but no reply arrived, so treating this as
// success would suggest a working round-trip that did not happen.
//
// Under PAIDEIA_NIC=virtio (the R91.M5-002 default) QEMU SLIRP
// answers both the ARP request and the ICMP Echo Request
// synchronously (the emulated NIC's TX ring wake-up drives the SLIRP
// backend before the guest gets to sleep), and virtio_net_rx_poll_
// and_dispatch reaps both replies in short order. The polling budgets
// (ARP_POLL_BUDGET and ICMP_POLL_BUDGET below) are sized for that
// same-thread-of-execution response pattern with generous slack.
//
// =============================================================================
// SECTION 2  RTT MEASUREMENT
// =============================================================================
//
// Round-trip time is measured via kread_tsc (rdtsc + shl/or) at two
// points:
//   * `start_tsc` = kread_tsc() taken IMMEDIATELY BEFORE the
//     icmp_send_echo_request call.
//   * `end_tsc`   = kread_tsc() taken as soon as we see
//     _icmp_rx_other bump.
//
// The reported `rtt_us` is (end_tsc - start_tsc) / TSC_HZ_PER_US.
// TSC_HZ_PER_US is a fixed 2500 (a 2.5 GHz CPU is a reasonable
// default for the target -c1 QEMU host; on wildly different hosts
// the reported number is off proportional to the host clock but the
// signal is intact -- a non-zero rtt_us is the assertion). A future
// landing that lands real TSC calibration (design/kernel/tsc-cal.md,
// not yet written) will replace this constant.
//
// =============================================================================
// SECTION 3  FINGERPRINTS
// =============================================================================
//
// Success:  `boot r92 icmp ping ok -- rtt_us=<n>` via
//           klog_s1_d1(3, SUBSYS_BOOT, tag_boot_r92_icmp_ping_ok,
//                     k_rtt_us, rtt_us).
// Skip:     `boot r92 icmp skip -- reason=<code>` via
//           klog_s1_d1(3, SUBSYS_BOOT, tag_boot_r92_icmp_skip,
//                     k_reason, code).
//           code = 1: no-nic (active_kind == 0).
//           code = 2: no-link (arp/icmp poll budget exhausted).
//
// Both lowercase, no bracketed OK suffix -- OK_TOK extractor at
// tools/verify-fingerprint-coverage.sh does not gate on them.
// tests/expected-r92-icmp.golden pins the substring `boot r92 icmp`,
// which matches both -- the smoke passes whichever the boot emitted.
//
// =============================================================================
// SECTION 4  ENCODER + LABEL + POLLING-BUDGET DISCIPLINE
// =============================================================================
//
// 6-push callee-save (rbx=kind, rbp=start_tsc, r12=arp_iter, r13=icmp_
// iter, r14=start_icmp_rx_other, r15=end_tsc) + sub rsp,40 (16 B
// target_ip scratch @ [rsp+0..3] + 8 B out_mac @ [rsp+8..13] + 16 B
// alignment pad) = 48 + 40 = 88. Entry rsp%16==8 -> 96, %16==0 for
// every nested SysV call (an even push count needs the extra 8 B
// pad to land on 16-byte alignment; 6 pushes alone would leave
// rsp%16==8).
//
// ARP_POLL_BUDGET = 8_000_000 (~ 40 ms at 200 MHz per-iter effective
// throughput). Enough for QEMU SLIRP's synchronous ARP reply.
// ICMP_POLL_BUDGET = 8_000_000 (same, for the Echo Reply arrival).
//
// TSC_HZ_PER_US = 2500 (fixed placeholder pending real TSC-cal).
//
// Labels prefixed `r92ip_` (R92 icmp ping).

module R92IcmpPing = structure {

  pub let R92IP_TARGET_B0        : u64 = 10
  pub let R92IP_TARGET_B1        : u64 = 0
  pub let R92IP_TARGET_B2        : u64 = 2
  pub let R92IP_TARGET_B3        : u64 = 2

  pub let R92IP_ARP_POLL_BUDGET  : u64 = 8000000
  pub let R92IP_ICMP_POLL_BUDGET : u64 = 8000000
  pub let R92IP_TSC_HZ_PER_US    : u64 = 2500

  pub let R92IP_ECHO_IDENT       : u64 = 0xBEEF
  pub let R92IP_ECHO_SEQ         : u64 = 1

  pub let R92IP_SKIP_NO_NIC      : u64 = 1
  pub let R92IP_SKIP_NO_LINK     : u64 = 2

  // 7-byte "paideia" ping payload. NOT NUL-terminated; the payload
  // is opaque bytes, not a C string.
  pub let _r92ip_payload : [u8; 7] = [
    0x70u8, 0x61u8, 0x69u8, 0x64u8, 0x65u8, 0x69u8, 0x61u8
  ]

  // witness_r92_icmp_ping() -> ()
  pub let witness_r92_icmp_ping : () -> () !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot},
      justification: "R92.M3-001 (paideia-os #2039). Off-box ICMP-ping witness. Body: (1) 6-push callee-save (rbx=kind, rbp=start_tsc, r12=arp_iter, r13=icmp_iter, r14=start_icmp_rx_other, r15=end_tsc) + sub rsp,40 (target_ip @[rsp+0..3], out_mac @[rsp+8..13], 16 B alignment pad -- even push count needs 8 more bytes to land on 16-byte alignment). Entry rsp%16==8 -> 96, %16==0 for every nested SysV call. (2) nic_dispatch_active_kind -> rbx. If 0 -> emit `boot r92 icmp skip -- reason=1` via klog_s1_d1 and return. (3) Build target_ip 10.0.2.2 at [rsp+0..3] via 4 mov_b immediate stores. (4) arp_send_request(0, 0, &target_ip). (5) ARP poll loop (arp_iter budget = 8M): each iter calls nic_dispatch_rx_poll(kind), then arp_cache_lookup((10<<24)|(0<<16)|(2<<8)|2 = 0x0A000202, &out_mac). Hit -> break to icmp send; miss -> decrement budget; exhaust -> emit skip reason=2. (6) start_tsc = kread_tsc. Snapshot _icmp_rx_other into r14. (7) icmp_send_echo_request(&target_ip, R92IP_ECHO_IDENT=0xBEEF, R92IP_ECHO_SEQ=1, &_r92ip_payload, 7). (8) ICMP poll loop (icmp_iter budget = 8M): each iter calls nic_dispatch_rx_poll(kind), reloads _icmp_rx_other, cmp against snapshot. Bump seen -> break to success; equal -> decrement budget; exhaust -> emit skip reason=2. (9) end_tsc = kread_tsc. rtt_us = (end_tsc - start_tsc) / TSC_HZ_PER_US (fixed 2500). (10) Emit `boot r92 icmp ping ok -- rtt_us=<n>` via klog_s1_d1(3, SUBSYS_BOOT, tag_boot_r92_icmp_ping_ok, k_rtt_us, rtt_us). (11) Teardown. Labels prefixed r92ip_. Encoder-conservative: xor+mov_b for byte loads (never mov_bzx), div for the rtt_us divide (xor rdx before div), [reg+imm] addressing.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 40;

        // (2) Active NIC gate.
        call nic_dispatch_active_kind;
        mov rbx, rax;
        cmp rbx, 0;
        jne r92ip_have_nic;

        // Skip: no-nic.
        mov rdi, 3;                               // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_boot_r92_icmp_skip];
        lea rcx, [rip + k_reason];
        mov r8, 1;                                // R92IP_SKIP_NO_NIC
        call klog_s1_d1;
        jmp r92ip_ret;

      r92ip_have_nic:
        // (3) Build target_ip 10.0.2.2 at [rsp+0..3].
        mov rax, 10;
        mov_b [rsp + 0], rax;
        xor rax, rax;
        mov_b [rsp + 1], rax;
        mov rax, 2;
        mov_b [rsp + 2], rax;
        mov rax, 2;
        mov_b [rsp + 3], rax;

        // (4) arp_send_request(0, 0, &target_ip).
        xor rdi, rdi;
        xor rsi, rsi;
        mov rdx, rsp;                             // &target_ip
        call arp_send_request;

        // (5) ARP poll loop.
        mov r12, 8000000;                         // ARP_POLL_BUDGET

      r92ip_arp_loop:
        cmp r12, 0;
        je  r92ip_skip_no_link;

        // nic_dispatch_rx_poll(kind).
        mov rdi, rbx;
        call nic_dispatch_rx_poll;

        // arp_cache_lookup(0x0A000202, &out_mac @ [rsp+8]).
        mov rdi, 0x0A000202;
        mov rsi, rsp;
        add rsi, 8;
        call arp_cache_lookup;
        cmp rax, 1;
        je  r92ip_arp_resolved;

        sub r12, 1;
        jmp r92ip_arp_loop;

      r92ip_arp_resolved:
        // (6) Snapshot start_tsc + _icmp_rx_other.
        call kread_tsc;
        mov rbp, rax;                             // start_tsc

        mov r14, [rip + _icmp_rx_other];          // baseline

        // (7) icmp_send_echo_request(&target_ip, 0xBEEF, 1, &payload, 7).
        mov rdi, rsp;                             // dst_addr_ptr
        mov rsi, 0xBEEF;                          // ident
        mov rdx, 1;                               // seq
        lea rcx, [rip + _r92ip_payload];          // payload_ptr
        mov r8,  7;                               // payload_len
        call icmp_send_echo_request;

        // (8) ICMP poll loop.
        mov r13, 8000000;                         // ICMP_POLL_BUDGET

      r92ip_icmp_loop:
        cmp r13, 0;
        je  r92ip_skip_no_link;

        // nic_dispatch_rx_poll(kind).
        mov rdi, rbx;
        call nic_dispatch_rx_poll;

        // Reload _icmp_rx_other; compare to baseline r14.
        mov rax, [rip + _icmp_rx_other];
        cmp rax, r14;
        jne r92ip_icmp_reply;

        sub r13, 1;
        jmp r92ip_icmp_loop;

      r92ip_icmp_reply:
        // (9) end_tsc; rtt_us = (end - start) / 2500.
        call kread_tsc;
        mov r15, rax;                             // end_tsc

        mov rax, r15;
        sub rax, rbp;                             // delta_tsc
        xor rdx, rdx;
        mov rcx, 2500;                            // TSC_HZ_PER_US
        div rcx;                                  // rax = rtt_us

        // (10) Emit ok fingerprint.
        mov r8, rax;                              // v1 = rtt_us
        mov rdi, 3;                               // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_boot_r92_icmp_ping_ok];
        lea rcx, [rip + k_rtt_us];
        call klog_s1_d1;
        jmp r92ip_ret;

      r92ip_skip_no_link:
        // Skip: no-link (ARP or ICMP poll budget exhausted).
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_boot_r92_icmp_skip];
        lea rcx, [rip + k_reason];
        mov r8, 2;                                // R92IP_SKIP_NO_LINK
        call klog_s1_d1;

      r92ip_ret:
        add rsp, 40;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }
}
