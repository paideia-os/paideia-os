// src/kernel/boot/witness/r54_bdev_round_trip.pdx -- R54.M1-003 (#1780)
//
// Two-phase NVMe-block round-trip witness. Runs immediately after the
// R53.M4-004 pdxfs_round_trip_phased discriminator (r30_platform.pdx
// pdxfs_round_trip_phased_call site). Discriminates the same way that
// witness does: by inspecting the persisted PDXB superblock's PDXB_
// SB_FLAG_CLEAN_UNMOUNT (bit 0 of the u32 flags field, superblock_
// fmt.pdx #1681) via the real `sb_read` accessor against a fresh
// `mount_pdxfs_block` (mount_block.pdx, #1707) on this witness's own
// substrate-mode NVMe cap chain -- but instead of emitting a phase-
// label fingerprint, this witness DRIVES a payload round-trip against
// the underlying block device:
//
//   * Phase 1 (bit 0 CLEAR -- fresh mkfs, not yet cleanly umounted):
//       stage 0xDEADBEEFCAFEBABE into a page-aligned scratch, then
//       nvme_write_blocking(nsid=1, lba=16, count=1,
//                           buf_pa=&_r54rt_write_scratch)
//       and emit the R54.M1-003 write-ok fingerprint via klog_s1.
//
//   * Phase 2 (bit 0 SET -- clean-unmount preserved from a prior boot):
//       zero the readback scratch, then
//       nvme_read_blocking(nsid=1, lba=16, count=1,
//                          buf_pa=&_r54rt_read_scratch)
//       cmp _r54rt_read_scratch[0] against 0xDEADBEEFCAFEBABE, and
//       emit the R54.M1-003 readback-ok fingerprint (match=1) via
//       klog_s1. On mismatch (match=0) the witness intentionally
//       does NOT emit the ok fingerprint -- the coverage gate would
//       fail-open on a mismatched round-trip if the ok line still
//       fired.
//
// -----------------------------------------------------------------------------
// LIVE vs SUBSTRATE gate (same posture as bdev_write.pdx nvw_batch_flush)
// -----------------------------------------------------------------------------
//
// Substrate boots (every QEMU-TCG -kernel run today -- MCFG absent ->
// nvme_probe drains empty -> _nvme_io_queue_count stays 0) MUST NOT
// call nvme_write_blocking / nvme_read_blocking -- either would land
// a memcpy against sq_pa == 0 (boot-critical hazard identical to the
// one r54_nvme_write.pdx and bdev_write.pdx's nvw_batch_flush both
// guard against). The gate is `_nvme_io_queue_count == 0 -> emit
// SUBSTRATE line, return 0`. The SUBSTRATE line contains no OK token
// so verify-fingerprint-coverage.sh's OK_TOK scan ignores it.
//
// The gate fires BEFORE the mount + sb_flags branch so a substrate
// boot never touches the FS-plumbing either -- the whole witness is a
// silent no-op in substrate mode (no wire event). That silence keeps
// the default-matrix boot log unchanged for every existing golden
// and keeps the release-mode `\bR[0-9]+\b` + line-budget gates
// pristine (design/kernel/boot-presentation.md §6) without an
// allowlist entry. When the R55+ driver-attach ceremony lands (see
// design/kernel/nvme-write-blocking.md), the gate opens and the
// mount + sb_flags + payload round-trip runs against the live
// namespace, producing the R54.M1-003 write-ok / readback-ok
// fingerprints the two goldens (tests/r54/expected-r54-bdev-round-
// trip-phase{1,2}.txt) pin.
//
// -----------------------------------------------------------------------------
// Why nvme_write_blocking direct, not nvw_submit + nvw_batch_flush
// -----------------------------------------------------------------------------
//
// nvw_batch_flush is hardwired to _nvw_flush_scratch (all-zero .bss
// page, single-writer per tools/build.sh ec_confine_one). That path
// cannot carry a distinctive payload -- every flush writes zeros --
// so a nvw_submit + nvw_batch_flush -> LBA 16 sequence would leave
// LBA 16 == 0, and phase 2's readback compare against
// 0xDEADBEEFCAFEBABE would always mismatch. The R54.M1-003
// acceptance criterion is a PAYLOAD round-trip; direct
// nvme_write_blocking against this witness's own scratch buffer is
// the only path today that satisfies it. The nvw_* API is proven
// separately by r54_bdev_flush.pdx (R54.M1-002 #1779).
//
// -----------------------------------------------------------------------------
// Substrate-mode NVMe cap trick (identical to pdxfs_round_trip_phased.pdx)
// -----------------------------------------------------------------------------
//
// Cap slots 172..176 (same fixed range every R52/R53 PdxFS witness
// already claims -- see pdxfs_round_trip_phased.pdx §"Substrate-mode
// NVMe cap trick"). Every prior R52/R53 PdxFS witness scrubs the
// range on entry and on every exit path, and boot witnesses run
// strictly sequentially, so no two witnesses' cap rows are ever live
// at once.
//
//   172 = synthetic KIND_PCI_DEV parent
//   173 = KIND_NVME_CONTROLLER (row 0)
//   174 = KIND_NVME_NAMESPACE (row 0, dual-kind with slot 175)
//   175 = KIND_BLKDEV, family NVME -- the bdev_cap for mount_pdxfs_block
//   176 = KIND_VOLUME target slot for mount_pdxfs_block's cap_slot argument
//
// -----------------------------------------------------------------------------
// Fingerprint dictionary
// -----------------------------------------------------------------------------
//
//   Substrate:  (silent -- no wire event; see LIVE vs SUBSTRATE gate
//               above for the rationale)
//   Write ok:   emitted from klog_s1 with tag_pdxb_bdev_rt_write_ok --
//               wire: "pdxb bdev round-trip write ok - lba=16
//               payload=deadbeefcafebabe [legacy: PDXB BDEV WROTE OK]"
//   Read ok:    emitted from klog_s1 with tag_pdxb_bdev_rt_readback_ok --
//               wire: "pdxb bdev round-trip readback ok - lba=16 match=1
//               [legacy: PDXB BDEV READBACK OK]"
//   Fail line:  emitted via klog_s1_d1(_r54rt_fail_msg, k_line, stage)
//               for a mount / sb_flags mishap, an nvme_write/read
//               status miscompare, OR a readback payload mismatch
//               (match=0). Carries stage number so the failure is
//               diagnostically local. Tag string has no OK token and
//               no R__ round-tag prefix -- verify-fingerprint-
//               coverage.sh's OK_TOK scan ignores it, and the
//               release-mode `\bR[0-9]+\b` gate stays clean if a
//               regression ever unmuted klog under
//               PAIDEIA_BUILD_MODE=release.
//
// All ok-bearing tags fold the R51 Phase C option-B bracketed legacy
// suffix into a single tag string (identical shape to
// tag_pdxb_bdev_flush_ok in keys.pdx §R54.M1-002). Coverage gate
// OK_TOK regex passes both -- `WROTE OK` and `READBACK OK` each
// carry a space-delimited `OK` before the closing `]`.
//
// -----------------------------------------------------------------------------
// Fingerprint-coverage discipline
// -----------------------------------------------------------------------------
//
// Each ok fingerprint fires EXACTLY ONCE per successful path. Phase 1
// emits only the write-ok tag; phase 2 emits only the readback-ok
// tag. The substrate / fail arms emit no ok token. No repeated
// firings.
//
// -----------------------------------------------------------------------------
// Register plan
// -----------------------------------------------------------------------------
//
//   3-push prologue (rbx = bdev_cap 175 for pattern uniformity,
//   r12 = sb_ptr set in LIVE stage 6, r13 unused / pattern uniformity
//   with pdxfs_round_trip_phased.pdx's own 3-push shape). Entry
//   rsp%16 == 8; after 3 pushes rsp%16 == 32 mod 16 == 0. Aligned
//   for every nested call.
//
//   The `sub rsp, 32` / `add rsp, 32` bracket around
//   nvme_ns_dual_kind_mint's params_ptr staging is 16-byte aligned,
//   so rsp%16 stays 0 across it (identical to pdxfs_round_trip_
//   phased.pdx stage 4).
//
// -----------------------------------------------------------------------------
// mov_b / no-test / label-prefix discipline
// -----------------------------------------------------------------------------
//
// No byte-granularity access anywhere -- every touched field is a
// u64 (via `mov`) or is extracted register-level via `and rax, 1`
// over an already-loaded qword. No `test` instruction; every compare
// uses `cmp` + `je`/`jne`/`jae`/`jb`. Every label prefixed `r54rt_`
// (R54 Round Trip) per reserved-label discipline. Grep audit
// 2026-08-24: no `r54rt_` hits anywhere else in src/kernel/ or
// tests/.
//
// Every sentinel compare against a bit-63-set value (the
// KERNEL_VMA_BASE constant 0xFFFF800000000000 in stage 6) is staged
// through `mov r10, <imm>; cmp reg, r10` rather than a bare `cmp
// reg, <imm>` -- identical G4 encoder-gap posture pdxfs_round_trip_
// phased.pdx / mount_block.pdx headers document.
//
// -----------------------------------------------------------------------------
// Wire posture
// -----------------------------------------------------------------------------
//
// Wired into src/kernel/boot/witness/r30_platform.pdx immediately
// AFTER `pdxfs_round_trip_phased_call` (the R53.M4-004 discriminator
// site, R53.M4-004 #1751). Placement AFTER that call keeps every
// prior R52/R53 PdxFS golden intact (this witness's own output lands
// as an unpinned extra line under contains-in-order); the R54
// phase1/phase2 goldens pin the write-ok / readback-ok line as the
// only ordered check they perform.

module R54BdevRoundTrip = structure {

  // 4 KiB payload buffer for phase 1's nvme_write_blocking source page.
  // Page-aligned so PRP1 satisfies NVMe §4.5.2 single-page transfer
  // constraint at any lba_size <= 4096. Single-writer per this
  // witness (staged with the round-trip pattern on entry to the
  // phase 1 arm) -- confined via ec_confine_one in tools/build.sh
  // scoped to boot/witness/r54_bdev_round_trip.o.
  pub let mut _r54rt_write_scratch : [u64; 512] = uninit @align(4096)

  // 4 KiB readback destination for phase 2's nvme_read_blocking. Zeroed
  // by the witness before the read so a stale-buffer false-positive is
  // impossible. Single-writer per this witness (only stage-6 stores
  // touch it) -- confined via ec_confine_one in tools/build.sh scoped
  // to boot/witness/r54_bdev_round_trip.o.
  pub let mut _r54rt_read_scratch  : [u64; 512] = uninit @align(4096)

  // Stage counter for the FAIL fingerprint's `line=N` KV.
  pub let mut _r54rt_stage : u64 = 0

  // Fail-line tag (klog-side; length count includes trailing NUL).
  // No OK token -- verify-fingerprint-coverage.sh's OK_TOK scan
  // ignores it, so the fail line does not require a golden assertion.
  // No `R54` round-tag prefix so the release-mode `\bR[0-9]+\b` gate
  // stays clean if a regression ever unmuted klog under
  // PAIDEIA_BUILD_MODE=release (design/kernel/boot-presentation.md §6).
  pub let _r54rt_fail_msg : [u8; 26] = "pdxb bdev round-trip fail\0"

  // ==========================================================================
  // r54rt_clear() -- scrub cap_table slots 172..176 inclusive.
  //
  // Same shape as prtp_clear (pdxfs_round_trip_phased.pdx) /
  // pbms_clear (pdxfs_boot_mount_smoke.pdx) -- upper bound is 177
  // (exclusive), matching this witness's own slot claim.
  // ==========================================================================
  pub let r54rt_clear : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R54.M1-003 (#1780): clear cap_table slots 172..176 (this witness's whole fixed slot claim: 172..175 shared with prior R52/R53 PdxFS witnesses per established practice, 176 this witness's own KIND_VOLUME target). Same shape as prtp_clear/prv_clear/pbms_clear, upper bound is 177 (exclusive). Labels prefixed r54rt_cl_.",
      block: {
        push rbx;
        mov rbx, 172;
      r54rt_cl_loop:
        cmp rbx, 177;
        jae r54rt_cl_done;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        add rbx, 1;
        jmp r54rt_cl_loop;
      r54rt_cl_done:
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // r54_bdev_round_trip_witness() -> u64
  //
  // Entry rsp%16 == 8 (invoked from r30_platform.pdx's boot_continue_
  // after_ring3 body via `call r54_bdev_round_trip_witness`, which
  // itself runs at %16==0 after r30_platform.pdx's own `push rbp`).
  // 3-push prologue lands rsp%16 == 0 for every nested call.
  //
  // See module header for the full LIVE vs SUBSTRATE gate, the phase-
  // discrimination semantic, and the substrate-mode NVMe cap trick.
  // ==========================================================================
  pub let r54_bdev_round_trip_witness : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R54.M1-003 (#1780): boot-time NVMe-block payload round-trip witness. 3-push prologue (rbx=bdev_cap 175, r12=sb_ptr set in LIVE stage 6, r13 unused/pattern-uniformity with pdxfs_round_trip_phased.pdx's own 3-push shape) lands rsp%16==0 for every nested call. Body: (0) SUBSTRATE gate: load _nvme_io_queue_count; if 0 -> silent return 0 (no mount, no IO, no wire event -- keeps the default-matrix log unchanged and the release-mode line-budget / R-tag gates clean without an allowlist entry). (1) defensive reset (nvme_ctrl_table_reset, nvme_ns_table_reset, r54rt_clear). (2)-(4) mint substrate NVMe cap chain identical to pdxfs_round_trip_phased.pdx stages 2-4 (KIND_PCI_DEV @172, KIND_NVME_CONTROLLER @173, dual-kind KIND_NVME_NAMESPACE/KIND_BLKDEV @174/175). (5) mount_pdxfs_block(cap_slot=176, bdev_cap=175, uuid_hint_lo=0, uuid_hint_hi=0); mount MUST succeed here (rax < 8) because the LIVE gate passed at stage 0; a substrate cascade at this point is a real breakage -> jae r54rt_fail_stage. (6) sb_read(175) -> sb_ptr; verify rax >= KERNEL_VMA_BASE (0xFFFF800000000000, staged via r10, cmp rax, r10, jb r54rt_fail_stage); r12 = sb_ptr. (7) sb_flags(sb_ptr) -> flags; extract bit 0 (and rax, 1); cmp rax, 0; je r54rt_phase1 (bit CLEAR -> fresh mkfs, phase 1) else fall through to phase 2. (8) phase 2 arm: zero _r54rt_read_scratch[0]; nvme_read_blocking(nsid=1, lba=16, count=1, buf_pa=&_r54rt_read_scratch); cmp rax, 0; jne r54rt_fail_stage. cmp _r54rt_read_scratch[0] against 0xDEADBEEFCAFEBABE (staged via r10); jne r54rt_fail_stage. klog_s1(3, SUBSYS_BOOT, tag_pdxb_bdev_rt_readback_ok); cleanup; return 0. r54rt_phase1 arm: stage 0xDEADBEEFCAFEBABE into _r54rt_write_scratch[0] via r10 stager; nvme_write_blocking(nsid=1, lba=16, count=1, buf_pa=&_r54rt_write_scratch); cmp rax, 0; jne r54rt_fail_stage. klog_s1(3, SUBSYS_BOOT, tag_pdxb_bdev_rt_write_ok); cleanup; return 0. r54rt_fail_stage: log stage via klog_s1_d1(k_line) matching prtp_fail_stage; cleanup; return 1. Every cleanup path calls r54rt_clear + nvme_ctrl_table_reset + nvme_ns_table_reset before returning. Labels prefixed r54rt_.",
      block: {
        push rbx;
        push r12;
        push r13;

        // -----------------------------------------------------------
        // (0) SUBSTRATE gate. Same posture as bdev_write.pdx's
        // nvw_batch_flush: _nvme_io_queue_count == 0 means no live
        // NVMe IO SQ pair; nvme_write/read_blocking would DMA to
        // sq_pa == 0 (boot-critical page hazard). Substrate boots
        // return silently -- no wire event -- so (a) the release-
        // mode `\bR[0-9]+\b` and line-budget gates stay pristine on
        // the default matrix, and (b) no coverage row is required
        // for a "witness ran but did nothing" line.
        // -----------------------------------------------------------
        mov rax, [rip + _nvme_io_queue_count];
        cmp rax, 0;
        jne r54rt_have_live;
        xor rax, rax;
        jmp r54rt_out;

      r54rt_have_live:
        // -----------------------------------------------------------
        // (1) Defensive reset.
        // -----------------------------------------------------------
        mov rax, 1;
        lea rcx, [rip + _r54rt_stage];
        mov [rcx], rax;

        call nvme_ctrl_table_reset;
        call nvme_ns_table_reset;
        call r54rt_clear;

        // -----------------------------------------------------------
        // (2) Synthetic KIND_PCI_DEV parent (slot 172).
        // -----------------------------------------------------------
        mov rax, 2;
        lea rcx, [rip + _r54rt_stage];
        mov [rcx], rax;

        mov rdi, 172;
        mov rsi, 0x30;                    // KIND_PCI_DEV
        mov rdx, 0x21F;                   // R_DEV_ALL | RIGHT_MINT
        mov rcx, 0xFACEFEED;              // synthetic bdf
        call cap_mint_write;

        // -----------------------------------------------------------
        // (3) KIND_NVME_CONTROLLER (slot 173, row 0).
        // -----------------------------------------------------------
        mov rax, 3;
        lea rcx, [rip + _r54rt_stage];
        mov [rcx], rax;

        mov rdi, 172;                     // parent_slot (KIND_PCI_DEV)
        mov rsi, 0x61F;                   // R_NVMEC_ALL
        xor rdx, rdx;                     // ctrl_idx = 0
        mov rcx, 0x400000;                // bar0_pa (synthetic)
        call nvme_ctrl_cap_mint_inner;
        cmp rax, 0;                       // expect row 0
        jne r54rt_fail_stage;

        mov rdi, 173;
        mov rsi, 0x198;                   // KIND_NVME_CONTROLLER
        mov rdx, 0x61F;
        xor rcx, rcx;                     // target_ptr = ctrl_row_id = 0
        call cap_mint_write;

        // -----------------------------------------------------------
        // (4) Dual-kind KIND_NVME_NAMESPACE/KIND_BLKDEV (slots
        // 174/175, row 0). nsid=1 aligns with nvme_read_blocking /
        // nvme_write_blocking's own nsid argument below.
        // -----------------------------------------------------------
        mov rax, 4;
        lea rcx, [rip + _r54rt_stage];
        mov [rcx], rax;

        sub rsp, 32;
        mov rax, 1;
        mov [rsp + 0], rax;                // nsid
        mov rax, 4096;
        mov [rsp + 8], rax;                // lba_size
        mov rax, 100;
        mov [rsp + 16], rax;               // block_count
        xor rax, rax;
        mov [rsp + 24], rax;               // parent_ctrl_row = 0
        mov rdi, 174;                      // ns_slot
        mov rsi, 175;                      // blk_slot
        mov rdx, 173;                      // parent_slot (KIND_NVME_CONTROLLER)
        mov rcx, 0x41F;                    // ns_rights (R_NVMEN_ALL)
        mov r8,  0x1F;                     // blk_rights (R_BLK_ALL)
        mov r9,  rsp;                      // params_ptr
        call nvme_ns_dual_kind_mint;
        add rsp, 32;
        cmp rax, 0;                        // expect row 0
        jne r54rt_fail_stage;

        // -----------------------------------------------------------
        // (5) mount_pdxfs_block(cap_slot=176, bdev_cap=175,
        //     uuid_hint_lo=0, uuid_hint_hi=0). Under a LIVE gate the
        // mount MUST succeed (rax < 8 == MOUNT_MAX). Any substrate
        // sentinel (rax >= 8) here is a real breakage because the
        // stage-0 gate promised us a live NVMe IO SQ pair.
        // -----------------------------------------------------------
        mov rax, 5;
        lea rcx, [rip + _r54rt_stage];
        mov [rcx], rax;

        mov rdi, 176;                      // cap_slot (KIND_VOLUME target)
        mov rsi, 175;                      // bdev_cap
        xor rdx, rdx;                      // uuid_hint_lo = 0 (no hint)
        xor rcx, rcx;                      // uuid_hint_hi = 0 (no hint)
        call mount_pdxfs_block;

        cmp rax, 8;
        jae r54rt_fail_stage;

        // -----------------------------------------------------------
        // (6) sb_read(175) -> sb_ptr. Verify >= KERNEL_VMA_BASE via
        // r10-staged compare (bit 63 set, per G4 discipline).
        // -----------------------------------------------------------
        mov rax, 6;
        lea rcx, [rip + _r54rt_stage];
        mov [rcx], rax;

        mov rdi, 175;
        call sb_read;
        mov r10, 0xFFFF800000000000;       // KERNEL_VMA_BASE
        cmp rax, r10;
        jb r54rt_fail_stage;
        mov r12, rax;                      // r12 = sb_ptr

        // -----------------------------------------------------------
        // (7) sb_flags(sb_ptr) -> flags. Extract bit 0 (PDXB_SB_FLAG_
        // CLEAN_UNMOUNT). rax holds the extracted bit for the branch.
        // -----------------------------------------------------------
        mov rax, 7;
        lea rcx, [rip + _r54rt_stage];
        mov [rcx], rax;

        mov rdi, r12;
        call sb_flags;
        and rax, 1;                        // extract bit 0
        cmp rax, 0;
        je r54rt_phase1;                   // bit CLEAR -> phase 1 arm

        // -----------------------------------------------------------
        // (8) LIVE bit-SET arm: this is phase 2 (persisted volume
        // from a prior boot's clean umount). Zero the readback
        // scratch cell, issue nvme_read_blocking, cmp against the
        // staged pattern.
        // -----------------------------------------------------------
        mov rax, 8;
        lea rcx, [rip + _r54rt_stage];
        mov [rcx], rax;

        // Zero read_scratch[0] -- poison the compare cell so a stale
        // buffer cannot false-positive.
        lea rax, [rip + _r54rt_read_scratch];
        xor rcx, rcx;
        mov [rax + 0], rcx;

        mov rdi, 1;                        // nsid = 1
        mov rsi, 16;                       // lba = 16
        mov rdx, 1;                        // count = 1 block
        lea rcx, [rip + _r54rt_read_scratch]; // buf_pa
        call nvme_read_blocking;
        cmp rax, 0;
        jne r54rt_fail_stage;

        // Compare read_scratch[0] against staged pattern. Bit 63 set
        // in the imm -> stage via r10, per G4 discipline.
        lea rax, [rip + _r54rt_read_scratch];
        mov rax, [rax + 0];
        mov r10, 0xDEADBEEFCAFEBABE;
        cmp rax, r10;
        jne r54rt_fail_stage;

        // Payload match -- emit the readback-ok tag exactly once.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_pdxb_bdev_rt_readback_ok];
        call klog_s1;

        call r54rt_clear;
        call nvme_ctrl_table_reset;
        call nvme_ns_table_reset;
        xor rax, rax;
        jmp r54rt_out;

      r54rt_phase1:
        // -----------------------------------------------------------
        // LIVE bit-CLEAR arm: this is phase 1 (freshly-mkfs'd volume
        // that has not yet been through a clean-umount + reboot
        // cycle). Stage the pattern into write_scratch[0], issue
        // nvme_write_blocking, emit the write-ok tag on success.
        // -----------------------------------------------------------
        mov rax, 9;
        lea rcx, [rip + _r54rt_stage];
        mov [rcx], rax;

        // Stage pattern into write_scratch[0]. Bit 63 set in the imm
        // -> stage via r10, per G4 discipline.
        mov r10, 0xDEADBEEFCAFEBABE;
        lea rax, [rip + _r54rt_write_scratch];
        mov [rax + 0], r10;

        mov rdi, 1;                        // nsid = 1
        mov rsi, 16;                       // lba = 16
        mov rdx, 1;                        // count = 1 block
        lea rcx, [rip + _r54rt_write_scratch]; // buf_pa
        call nvme_write_blocking;
        cmp rax, 0;
        jne r54rt_fail_stage;

        // Success -- emit the write-ok tag exactly once.
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_pdxb_bdev_rt_write_ok];
        call klog_s1;

        call r54rt_clear;
        call nvme_ctrl_table_reset;
        call nvme_ns_table_reset;
        xor rax, rax;
        jmp r54rt_out;

      r54rt_fail_stage:
        lea rax, [rip + _r54rt_stage];
        mov r8, [rax];
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + _r54rt_fail_msg];
        lea rcx, [rip + k_line];
        call klog_s1_d1;

        call r54rt_clear;
        call nvme_ctrl_table_reset;
        call nvme_ns_table_reset;
        mov rax, 1;

      r54rt_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
