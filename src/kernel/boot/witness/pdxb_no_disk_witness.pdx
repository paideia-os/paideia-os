// src/kernel/boot/witness/pdxb_no_disk_witness.pdx -- R53.M3-006 (#1747)
//
// Boot witness for the no-disk configuration of the PDXB volume-probe
// path.  Under the current -kernel/BIOS smoke boot no KIND_BLKDEV caps
// have been minted (nvme_probe / ahci_probe are landed as bodies in
// core/drivers/{nvme,ahci}/probe.pdx but neither is wired into
// kernel_main yet; a following R51.M* / R53.M* milestone lands their
// call sites right above pdxb_volume_probe_all_bdev in kernel_main).
// probe_all_bdevs's 256-slot cap_table scan therefore finds nothing,
// registers nothing, and returns 0 -- which is precisely the input
// signal design/tooling/volume-lifecycle-mechanism.md §4.4 pins as
// the "no valid volume, fall back to tmpfs" precondition (§4.4 rule
// 4: "if no volume was probed OR more than one was probed with no
// root-flag disambiguator, fall back to the R16 tmpfs bootstrap and
// emit fingerprint PDXB ROOT FALLBACK TMPFS").
//
// -----------------------------------------------------------------------------
// What this witness proves
// -----------------------------------------------------------------------------
//
// Substrate-mode assertions (always run on -kernel/BIOS boot; the
// only mode any golden pins today):
//
// (1) pdxb_volume_probe_all_bdev() (thin wrapper for probe_all_bdevs,
//     landed at #1743) returns 0 -- no KIND_BLKDEV caps are live, so
//     no PDXB volume was registered into the KIND_VOLUME table.
// (2) volume_registry_find(0, 0) returns 0xFF (VREG_ROW_NONE) -- the
//     registry lookup that root_select (#1744, sibling in flight)
//     will call inside its "single-device disambiguation" branch
//     (design §4.4 rule 3) misses on every uuid pair, matching the
//     "root_select returns -1" contract this witness's task refers
//     to.  Choice of (0,0) as the query uuid is deliberate: a valid
//     PDXB superblock's uuid is stamped from a non-zero seed by
//     mkfs (mkfs.pdx §uuid-derivation), and volume_hdr_pack refuses
//     a (0,0) uuid at claim time (kind_volume.pdx L399 justification:
//     "uuid_lo == uuid_hi == 0 -> VOL_TAIL_BAD_ARG"), so any live
//     row is guaranteed non-zero and (0,0) can only ever miss.  The
//     witness therefore proves the empty-registry state without
//     depending on any specific probed-uuid content.
// (3) The observed row count is 0 -- pinned as the decimal detail
//     line count=0 next to the OK tag, giving a boot log grep an
//     inspectable value beyond the tag itself.
//
// Both (1) and (2) together are exactly the precondition
// mount_bootstrap (#1745, sibling in flight) reads before it lands
// on the tmpfs fallback branch: probe returned 0 => registry is
// empty => root_select returns -1 => mount_bootstrap uses the R16
// tmpfs bootstrap (design §4.1: "if it finds none, mount bootstrap
// falls back to tmpfs"), which is the exact code path R16.M1
// witness_r16_tmpfs already exercises later in the boot sequence.
// This witness therefore proves the fall-through condition at the
// point pdxb_volume_probe_all_bdev returns, without duplicating the
// tmpfs setup R16 already witnesses.
//
// -----------------------------------------------------------------------------
// Why the wrapper + registry call, not root_select / mount_bootstrap
// -----------------------------------------------------------------------------
//
// R53.M3-003 (root_select, #1744), R53.M3-004 (mount_bootstrap
// branch, #1745), and R53.M3-005 (fingerprint emit for PDXB PROBE /
// VOLUME MOUNTED / ROOT SELECTED / ROOT FALLBACK, #1746) are
// sibling in-flight issues that will land above this one.  This
// witness deliberately asserts only against symbols that exist
// today (#1706's probe_all_bdevs via #1743's pdxb_volume_probe_all_
// bdev alias, and #1706's volume_registry_find), so it lands
// self-contained under the R30.M3 loop-shape rule
// (feedback_paideia_os_loop_shape.md: softarch implements without
// build).  Once #1744/#1745/#1746 land, a follow-up landing can
// extend this witness with two extra stages (a live root_select
// call expecting -1, and a mount_bootstrap-branch inspection
// stage) at the same fingerprint tag -- the fingerprint contract
// this file freezes is stable across those extensions.
//
// -----------------------------------------------------------------------------
// Fingerprint contract
// -----------------------------------------------------------------------------
//
//   PDXB NO DISK FALLBACK OK  -- OK tag, output-strip-clean per
//                                design/policy/output-provenance-
//                                strip.md (no round/milestone/issue
//                                reference in the emitted string).
//   PDXB NO DISK FALLBACK FAIL -- FAIL tag with `line=<N>` decimal
//                                KV naming which stage tripped.
//
// -----------------------------------------------------------------------------
// Register plan
// -----------------------------------------------------------------------------
//
// Three-push callee-save prologue (rbx, r12, r13).  rbx holds the
// probe-return count across stage 2 (the volume_registry_find call)
// and stage 3 (the emit call, where it becomes the decimal detail
// value).  r12/r13 are pushed for pattern uniformity with the
// PdxFS-cluster witnesses (kind_pdxfs_mount_table_synth.pdx,
// pdxfs_pkg_install_smoke.pdx).  Three pushes from SysV-entry
// rsp%16 == 8 land rsp%16 == 8 -- pdxfs_txn_ops_real_synth.pdx's
// documented odd-count rule.  A `sub rsp, 8` inside each pre-call
// window would land rsp%16 == 0 but the two nested calls here
// (pdxb_volume_probe_all_bdev and volume_registry_find) both live
// inside their own subs with even/odd push counts of their own
// (probe_all_bdevs uses 2-push+sub-rsp-8; volume_registry_find
// uses 3-push, no pad), so an extra outer pad would break the
// arithmetic.  The three-push (odd) shape leaves rsp%16 == 8 at
// every call site here, matching sys entry parity and the callee
// alignment discipline.  klog_s1_d1 is a 6-arg wrapper -- the
// seventh arg (value2) rides via [rsp+8], so its caller pushes an
// extra qword before call, restoring rsp%16 == 8 for the wrapper
// entry.  Here klog_s1_d1 is called with only 5 args (level,
// subsys, tag, key, value) -- fits registers, no extra push.
//
// -----------------------------------------------------------------------------
// mov_b / no-test / label-prefix discipline
// -----------------------------------------------------------------------------
//
// No byte-granularity access anywhere (every read is a full-qword
// call return).  No `test` instruction anywhere -- every comparison
// uses `cmp` + `je`/`jne`.  Every label is prefixed `pdxbnd_`
// (PDXB No Disk) per the reserved-label discipline.
//
// -----------------------------------------------------------------------------
// Wire posture
// -----------------------------------------------------------------------------
//
// Wired into src/kernel/boot/witness/r30_platform.pdx immediately
// after `kind_pdxfs_mount_table_witness_call` and before
// `pdxfs_round_trip_final_call`, closing out the PDXFS-block /
// PdxFS-mount-table cluster with the no-disk fallback assertion.
// Fingerprint appended to tests/r17/shell-shutdown.golden between
// "KIND PDXFS MOUNT TABLE OK" and "ROUND TRIP OK".
//
// _pdxbnd_stage is confined by tools/build.sh's ec_confine_one to
// this .o alone (matches the _pkgi_stage / _pms_stage discipline
// M8-003/M8-001 established for sibling boot witnesses).

module PdxbNoDiskWitness = structure {

  // Stage counter: bumped at the top of each block that could fail
  // so the FAIL fingerprint's `line=N` KV names WHICH stage tripped.
  // Only mutable static in this module.
  pub let mut _pdxbnd_stage : u64 = 0

  // Fingerprint bytes.  Output-strip clean per design/policy/output-
  // provenance-strip.md (no round/milestone/issue reference in the
  // emitted string).
  pub let pdxbnd_ok   : [u8; 26] = "PDXB NO DISK FALLBACK OK\n\0"
  pub let pdxbnd_fail : [u8; 28] = "PDXB NO DISK FALLBACK FAIL\n\0"

  pub let pdxbnd_k_count : [u8; 6] = "count\0"

  // ============================================================================
  // wit_pdxb_no_disk_fallback() -> 0 (OK) | 1 (FAIL)
  //
  // Body:
  //   (0) Three-push prologue.
  //   (1) rax = pdxb_volume_probe_all_bdev().  Expect rax == 0 on the
  //       -kernel/BIOS substrate boot (no KIND_BLKDEV caps live).
  //       Store into rbx so it survives the next call and lands in
  //       the emit as the decimal count.
  //   (2) rax = volume_registry_find(0, 0).  Expect rax == 0xFF
  //       (VREG_ROW_NONE) -- the empty-registry miss root_select
  //       reads as "no root candidate".
  //   (3) Emit "PDXB NO DISK FALLBACK OK" + count=rbx decimal KV
  //       (rbx == 0 on the substrate path).
  //
  // Fail path emits "PDXB NO DISK FALLBACK FAIL" + line=<stage>.
  // ============================================================================

  pub let wit_pdxb_no_disk_fallback : () -> u64 !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R53.M3-006 (#1747): no-disk fallback boot witness. Asserts the two preconditions design/tooling/volume-lifecycle-mechanism.md §4.4 pins as the root_select-returns-none + mount_bootstrap-falls-to-tmpfs branch: (1) pdxb_volume_probe_all_bdev() returns 0 (no KIND_BLKDEV caps live under -kernel/BIOS boot -- probe.pdx L296 substrate posture), and (2) volume_registry_find(0, 0) returns 0xFF (VREG_ROW_NONE) -- the empty-registry miss any root_select cascade will read as 'no root candidate'. Query uuid (0, 0) is chosen because volume_hdr_pack refuses a (0, 0) uuid at claim time (kind_volume.pdx L399 justification), so any live row is guaranteed non-zero and (0, 0) can only ever miss regardless of what probed uuids might exist. Three-push callee-save discipline (rbx = probe-return count carried across the registry call and into the emit's decimal detail line; r12/r13 pushed for pattern uniformity with kind_pdxfs_mount_table_synth.pdx / pdxfs_pkg_install_smoke.pdx). Three pushes from SysV-entry rsp%16 == 8 land rsp%16 == 8, matching pdxfs_txn_ops_real_synth.pdx's documented odd-count rule; the two nested calls (pdxb_volume_probe_all_bdev, volume_registry_find) each handle their own alignment internally per their own headers. Effects/capabilities widen to match the widest nested call (probe_one_bdev's {mem, sysreg} @{cap} plus boot for klog_s1). Encoder: mov / cmp / je / jne / lea / xor / call -- all pre-existing. Labels prefixed pdxbnd_.",
      block: {
        push rbx;
        push r12;
        push r13;

        // -- Stage 1: pdxb_volume_probe_all_bdev(). --
        mov rax, 1;
        lea rcx, [rip + _pdxbnd_stage];
        mov [rcx], rax;

        call pdxb_volume_probe_all_bdev;
        cmp rax, 0;
        jne pdxbnd_fail_stage;
        mov rbx, rax;                            // rbx = 0 (probe count)

        // -- Stage 2: volume_registry_find(0, 0) -> VREG_ROW_NONE. --
        mov rax, 2;
        lea rcx, [rip + _pdxbnd_stage];
        mov [rcx], rax;

        xor rdi, rdi;                            // uuid_lo = 0
        xor rsi, rsi;                            // uuid_hi = 0
        call volume_registry_find;
        mov r10, 0xFF;                           // VREG_ROW_NONE
        cmp rax, r10;
        jne pdxbnd_fail_stage;

        // -- Stage 3: emit OK + count=<rbx> decimal KV. --
        mov rax, 3;
        lea rcx, [rip + _pdxbnd_stage];
        mov [rcx], rax;

        mov rdi, 3;                              // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + pdxbnd_ok];
        lea rcx, [rip + pdxbnd_k_count];
        mov r8, rbx;                             // count (0)
        call klog_s1_d1;

        xor rax, rax;
        jmp pdxbnd_out;

      pdxbnd_fail_stage:
        lea rax, [rip + _pdxbnd_stage];
        mov r8, [rax];
        mov rdi, 1;                              // LEVEL_ERROR
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + pdxbnd_fail];
        lea rcx, [rip + k_line];
        call klog_s1_d1;
        mov rax, 1;

      pdxbnd_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
