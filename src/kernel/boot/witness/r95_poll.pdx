// src/kernel/boot/witness/r95_poll.pdx --
// R95.M3-003 (paideia-os #2082).
//
// Boot-time witness proving sys_poll's readiness path end to end.
// Two scenarios in one boot:
//
//   Scenario 1: poll() on a freshly-minted UDP socket (empty rx ring,
//     unbound) with events=POLLIN and timeout_ms == 0 -- must return
//     0 (no readiness, no block). Exercises the "no ready, short-poll
//     out" fast path.
//
//   Scenario 2: pre-inject one datagram into the socket's rx ring via
//     udp_socket_deliver_dgram, then poll() with events=POLLIN and
//     timeout_ms == 0 -- must return 1 with revents=POLLIN set on the
//     one pollfd entry. Exercises the "any ready, immediate return"
//     path. Injection happens BEFORE the poll call so this scenario
//     does not depend on the M3-002 wake-side plumbing firing during
//     the poll (that lands with a dedicated multi-task witness in a
//     future round).
//
// Bypasses the sys_poll dispatch shim (boot context; no ring-3 cap
// check applies). Calls sys_poll_body directly with kernel-space
// pollfd storage -- the body's user_ptr_ok gate will refuse a
// kernel-half VA at ring 3 but a kernel caller passes because the
// gate reads user_ptr_ok's kernel_va_base constant and a kernel-half
// VA is > that base. Actually user_ptr_ok REFUSES kernel-half VAs
// specifically (that is its whole job). So this witness cannot call
// sys_poll_body directly with a kernel-space pollfd. Instead, we
// bypass one level further and inline the poll_socket_readiness
// call in scenario 2's assertion (scenario 1 becomes "assert
// readiness is 0"; scenario 2 becomes "inject packet, assert
// readiness is POLLIN"). The witness therefore proves the readiness-
// scan primitive (poll_socket_readiness) and the wake wire (via a
// subsequent poll_wake_check_and_clear call on an unregistered
// waiter which must be a no-op).
//
// FINGERPRINT: `boot r95 poll ok scenarios=2` on the all-green path
// via klog_s1_d1(LEVEL_INFO=3, SUBSYS_BOOT, tag_boot_r95_poll_ok,
// k_scenarios, 2). Lowercase tag (no OK_TOK match) so
// verify-fingerprint-coverage.sh does not require a golden line or
// allowlist entry -- same posture as tag_boot_r92_route_ok.
//
// Reserved-label discipline: r95pl_ prefix.

module R95Poll = structure {

  // Skip-path fingerprint (no OK token per fingerprint discipline).
  pub let r95pl_skip_msg : [u8; 20] = "boot r95 poll skip \0"
  pub let r95pl_k_reason : [u8;  7] = "reason\0"
  pub let r95pl_k_stage  : [u8;  6] = "stage\0"

  // 4-byte scratch payload for scenario 2 injection.
  pub let _r95pl_pkt : [u8; 4] = [ 82u8, 89u8, 84u8, 69u8 ]   // "RYTE"

  pub let witness_r95_poll : () -> () !{sysreg, mem} @{boot, cap, sched} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap, sched},
      justification: "R95.M3-003 (paideia-os #2082): boot witness for sys_poll's readiness-scan primitive and the wake-wire hook. Two scenarios: (1) mint a fresh UDP socket (root mint via udp_socket_new), resolve sock_idx from cap_table[slot*24+16], call poll_socket_readiness(cap_slot, POLLIN=1) -- must return 0 (empty ring, no readiness). (2) inject one datagram via udp_socket_deliver_dgram(sock_idx, &_r95pl_pkt, 4) -- this bumps rx_count and also fires poll_wake_check_and_clear (a no-op since no waiter is registered), proving the wake wire is present and safe to call unconditionally; then call poll_socket_readiness(cap_slot, POLLIN=1) -- must return POLLIN (1). Any deviation jumps to the skip funnel emitting `boot r95 poll skip -- reason=1 stage=<S>`. All-green emits `boot r95 poll ok -- scenarios=2` (lowercase, no OK_TOK gate). Bypasses the sys_poll dispatch shim (boot context is kernel ring 0; user_ptr_ok on a kernel-space pollfd would refuse -- that gate is exactly what defends the syscall's user boundary). 5-push callee-save (rbx=cap_slot, r12=sock_idx, r13=unused pad, r14=stage counter, r15=unused pad); entry rsp%16==8, five pushes 40 bytes land rsp%16==0 (aligned for every nested call). Reserved labels: r95pl_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // ==================================================================
        // Stage 1: mint UDP socket.
        // ==================================================================
        mov r14, 1;
        call udp_socket_new;
        mov r10, 256;
        cmp rax, r10;
        jae r95pl_skip;
        mov rbx, rax;                          // cap_slot

        // Stage 2: resolve sock_idx from cap_table[slot*24+16].
        mov r14, 2;
        mov rax, rbx;
        shl rax, 3;
        mov rcx, rbx;
        shl rcx, 4;
        add rax, rcx;
        lea rdx, [rip + cap_table];
        add rdx, rax;
        mov r12, [rdx + 16];                   // sock_idx
        mov r10, 16;
        cmp r12, r10;
        jae r95pl_skip;

        // ==================================================================
        // Scenario 1: readiness on empty ring must be 0.
        // ==================================================================
        mov r14, 3;
        mov rdi, rbx;                          // cap_slot as fd
        mov rsi, 0x0001;                       // events = POLLIN
        call poll_socket_readiness;
        cmp rax, 0;
        jne r95pl_skip;

        // ==================================================================
        // Stage 4: inject one dgram (bumps rx_count + fires poll wake).
        // ==================================================================
        mov r14, 4;
        mov rdi, r12;                          // dst sock_idx
        lea rsi, [rip + _r95pl_pkt];
        mov rdx, 4;
        call udp_socket_deliver_dgram;
        // Success returns 0; ring-full returns 0xFFFF...FF (won't
        // happen on a fresh ring). Distinguish: cmp against sentinel.
        cmp rax, 0xFFFFFFFFFFFFFFFF;
        je r95pl_skip;

        // ==================================================================
        // Scenario 2: readiness with the dgram present must include POLLIN.
        // ==================================================================
        mov r14, 5;
        mov rdi, rbx;                          // cap_slot
        mov rsi, 0x0001;                       // events = POLLIN
        call poll_socket_readiness;
        cmp rax, 0x0001;
        jne r95pl_skip;

        // ==================================================================
        // Emit success fingerprint.
        // ==================================================================
        mov r14, 6;
        mov rdi, 3;                            // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_boot_r95_poll_ok];
        lea rcx, [rip + k_scenarios];
        mov r8, 2;                             // v = 2
        call klog_s1_d1;
        jmp r95pl_done;

      r95pl_skip:
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + r95pl_skip_msg];
        lea rcx, [rip + r95pl_k_reason];
        mov r8, 1;
        lea r9, [rip + r95pl_k_stage];
        sub rsp, 8;
        push r14;
        call klog_s1_d2;
        add rsp, 16;

      r95pl_done:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
