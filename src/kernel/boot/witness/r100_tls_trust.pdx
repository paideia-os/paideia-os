// src/kernel/boot/witness/r100_tls_trust.pdx -- R100-PREP-001 (#2007)
//
// Boot-time witness for KIND_TLS_TRUST end to end: mints a trust
// anchor over a static ed25519-shaped pubkey buffer, then reads back
// the algo tag and the four key words via cap_invoke through the
// KIND_TLS_TRUST branch of cap_invoke_dispatch (using the R_TLS_TRUST_
// READ right), cross-checking every returned word against the source
// bytes. This is the direct-analogue of witness_r89_tui_canvas but for
// an inert descriptor kind -- there is no equivalent of PRESENT to
// exercise (§2's immutability contract means the only ops are
// READ/QUERY, and this witness runs all eight).
//
// =============================================================================
// PREREQUISITES THIS FILE MINTS (all private, all torn down on every exit)
// =============================================================================
//
//   Cap slot 124 -- KIND_MEMORY(4) + RIGHT_MINT(0x200), target_ptr =
//     &_tlstw_pubkey. Free by construction: witness_r89_tui_canvas
//     (immediately above this witness in the boot cascade) owns and
//     scrubs slots 121+122, and no other cascade-reachable file names
//     slot 124 -- verified by tree-wide grep of src/kernel/boot/witness/
//     at landing time. Two slots up from the TUI-canvas witness to make
//     the disjoint ownership obvious.
//   Cap slot 125 -- KIND_TLS_TRUST(0x1A7) + R_TLS_TRUST_READ(0x001),
//     target_ptr = row_id returned by kind_tls_trust_mint_body. Same
//     free-by-construction argument as slot 124.
//   KIND_TLS_TRUST row (kind_tls_trust_mint_body) -- claimed on entry,
//     left in place at teardown per §2's immutability contract (the
//     cap_table slot is scrubbed, the row itself stays live -- a
//     future teardown pass belongs in tls_trust_table_reset, which
//     kernel_main.pdx wires alongside the other cap-substrate resets
//     at boot).
//   _tlstw_pubkey  : [u8; 32] @align(8) -- a static .bss buffer sized
//     exactly the Ed25519 public-key length (32 bytes = 4 u64 words).
//     Initialized in-line at witness entry with a deterministic
//     recognizable pattern so the readback cross-check is not fooled
//     by an all-zero row.
//   _tlstw_label   : [u8; 16] @align(8) -- a static .bss buffer sized
//     to the design doc's label width. Also initialized deterministically
//     to a printable ASCII pattern.
//
// =============================================================================
// KEY-MATERIAL CONTENT -- 32 identical-per-word recognizable bytes
// =============================================================================
//
// Word0 = 0x1122334455667788 (bytes 88 77 66 55 44 33 22 11 little-endian)
// Word1 = 0x99AABBCCDDEEFF00
// Word2 = 0xDEADBEEFCAFEBABE
// Word3 = 0x1A71A71A71A71A71  (issue reference: KIND_TLS_TRUST = 0x1A7)
//
// LABEL CONTENT -- 16 bytes of printable ASCII
//
// Word0 = 0x2074736579734F58 ("XOsyst " in bytes, but really the
//   underlying content is opaque -- the label is diagnostic only, §1).
// Word1 = 0x000000006E696B73 ("skin\0\0\0\0" bytes)
//
// The witness reads these back via QUERY_KEY_W0..3 / QUERY_LABEL_W0..1
// and refuses any mismatch. QUERY_ALGO returns TLS_TRUST_ALGO_ED25519
// = 1.
//
// =============================================================================
// KLOG WRAPPER CHOICE
// =============================================================================
//
// The fingerprint carries two decimal KVs (row=<id>, algo=<n>), so
// this file uses klog_s1_d2 (core/klog/wrappers.pdx), matching
// r89_tui_canvas.pdx's own wrapper choice for its two-KV emit. The
// stack push+pop for the 7th (v2) arg is identical.
//
// =============================================================================
// FINGERPRINT
// =============================================================================
//
// Success: "boot tls trust ok -- row=<id> algo=<n>" (klog_s1_d2).
// Deliberately all-lowercase with no bracketed "[legacy: ... OK]"
// suffix, matching r89_tui_canvas.pdx's own brand-new-narrative-tag
// posture: it carries no standalone uppercase "OK" token, so tools/
// verify-fingerprint-coverage.sh's OK_TOK extractor does not require
// golden coverage or an allowlist entry for it (see that tool's
// header and r89_tui_canvas.pdx's own comment for the precedent).
//
// The R100-PREP-001 issue's "`... ok [legacy: ... OK]` shape"
// discipline applies to the MINT fingerprint emitted from inside
// kind_tls_trust_mint_body ("tls trust mint ok [legacy: TLS TRUST
// MINT OK]", kind_tls_trust.pdx tls_trust_mint_ok_msg), not to this
// boot witness's own OUTER line -- exactly the split R89.M1 uses,
// where kind_tui_canvas.pdx carries the legacy-shape mint marker and
// r89_tui_canvas.pdx's own fingerprint is the lowercase narrative
// line. This witness is ALSO the first-ever caller of kind_tls_trust_
// mint_body, so it makes the allowlist entry in tools/verify-
// fingerprint-coverage.sh for "tls trust mint ok" reachable in
// practice for the first time (see the R89.M1-005 note there for the
// TUI-canvas precedent).
//
// Failure: "boot tls trust fail line=<N>" (klog_s1_d1), stage number
// stamped into _tlstw_stage before every step. No boot_bail_or_continue
// call; failure falls through to cleanup + return, same shape as every
// sibling witness in this cascade.
//
// =============================================================================
// ENCODER DISCIPLINE
// =============================================================================
//
// No frameless-function annotations anywhere. No `add reg, [mem]`, no
// `cmp reg, [mem]` -- every value is loaded to a register before any
// arithmetic or comparison. Every store is a qword `mov [mem], reg` --
// no byte loads are needed since every content word is a compile-time
// constant. Every label in this file is prefixed `tlstw_` (reserved-
// word discipline -- `loop`/`if` etc. are keywords).

module R100TlsTrust = structure {

  pub let mut _tlstw_stage  : u64      = 0
  pub let mut _tlstw_pubkey : [u8; 32] = uninit @align(8)
  pub let mut _tlstw_label  : [u8; 16] = uninit @align(8)

  pub let tag_boot_tls_trust_ok : [u8; 21] = "boot tls trust ok --\0"
  pub let tlstw_fail_msg        : [u8; 20] = "boot tls trust fail\0"
  pub let tlstw_k_row           : [u8; 4]  = "row\0"
  pub let tlstw_k_algo          : [u8; 5]  = "algo\0"

  // Expected key words (see file header §"KEY-MATERIAL CONTENT").
  pub let TLSTW_KEY_W0    : u64 = 0x1122334455667788
  pub let TLSTW_KEY_W1    : u64 = 0x99AABBCCDDEEFF00
  pub let TLSTW_KEY_W2    : u64 = 0xDEADBEEFCAFEBABE
  pub let TLSTW_KEY_W3    : u64 = 0x1A71A71A71A71A71
  pub let TLSTW_LABEL_W0  : u64 = 0x2074736579734F58
  pub let TLSTW_LABEL_W1  : u64 = 0x000000006E696B73

  // Scrub cap slots 124 (KIND_MEMORY parent) and 125 (minted KIND_TLS_
  // TRUST cap) back to (0,0,0). Called at entry (defensive) and on
  // every exit.
  pub let tlstw_clear_slots : () -> () !{mem} @{cap} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R100-PREP-001 (#2007): scrub this witness's two private cap_table slots (124 KIND_MEMORY parent, 125 minted KIND_TLS_TRUST cap) to (0,0,0). Labels prefixed tlstw_cs_.",
      block: {
        mov rdi, 124;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        mov rdi, 125;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;
        ret
      }
    }

  // witness_r100_tls_trust() -> ()
  //
  // Five callee-save pushes (rbx, r12-r15) leave rsp%16 == 0 for every
  // nested call (entry rsp%16 == 8, +40 -> %16 == 0), matching every
  // sibling witness in this cascade. Register plan (all callee-save,
  // survive every nested call by SysV convention): r12 = trust row_id,
  // r13 = scratch return-value holder across cross-checks, r14 =
  // &_tlstw_pubkey, r15 = &_tlstw_label, rbx = mint-body's own hdr /
  // reused as scratch after mint completes.
  pub let witness_r100_tls_trust : () -> () !{sysreg, mem} @{boot, cap} =
    fn () -> unsafe {
      effects: {sysreg, mem}, capabilities: {boot, cap},
      justification: "R100-PREP-001 (#2007): boot witness proving KIND_TLS_TRUST end to end. Stage 1: reset the witness's two cap-table slots (124 KIND_MEMORY parent, 125 the freshly-minted KIND_TLS_TRUST cap). Stage 2: initialize _tlstw_pubkey (4 u64 words) and _tlstw_label (2 u64 words) with recognizable patterns. Stage 3: mint the KIND_MEMORY parent at slot 124 pointing at _tlstw_pubkey. Stage 4: mint the KIND_TLS_TRUST row via kind_tls_trust_mint_body(parent_slot=124, algo=1, &_tlstw_pubkey, &_tlstw_label). Stage 5: cap_mint_write the returned row_id into cap_table slot 125 with kind=KIND_TLS_TRUST + rights=R_TLS_TRUST_READ. Stages 6-14: exercise every KIND_TLS_TRUST op via cap_invoke through the R100-PREP-001 cap_invoke_dispatch branch -- READ (=1 iff live), QUERY_ALGO (=1=Ed25519), QUERY_KEY_W0..3 (byte-for-byte match against _tlstw_pubkey), QUERY_LABEL_W0..1 (match against _tlstw_label). Stage 15: emit the mint-and-read fingerprint. Stage 16: scrub the cap_table slots (immutability contract §2 means the row itself stays live -- kernel_main's tls_trust_table_reset at boot handles teardown). Capabilities/effects: cap_mint_write/kind_tls_trust_mint_body/cap_invoke all need {cap}; klog_s1_d1/klog_s1_d2 need {sysreg,mem}. 'boot' is added per this cascade's own witness-function convention. On any failure, the stage number is stamped into _tlstw_stage first so the failure klog line names which sub-test tripped; failure falls through to cap-slot cleanup only, matching r89_tui_canvas.pdx's identical failure shape. Labels prefixed tlstw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // ---------- Stage 1: reset cap-table slots ----------
        mov rax, 1;
        lea rcx, [rip + _tlstw_stage];
        mov [rcx], rax;
        call tlstw_clear_slots;

        // ---------- Stage 2: initialize source buffers ----------
        mov rax, 2;
        lea rcx, [rip + _tlstw_stage];
        mov [rcx], rax;

        lea r14, [rip + _tlstw_pubkey];
        mov rax, 0x1122334455667788;     // TLSTW_KEY_W0
        mov [r14 + 0],  rax;
        mov rax, 0x99AABBCCDDEEFF00;     // TLSTW_KEY_W1
        mov [r14 + 8],  rax;
        mov rax, 0xDEADBEEFCAFEBABE;     // TLSTW_KEY_W2
        mov [r14 + 16], rax;
        mov rax, 0x1A71A71A71A71A71;     // TLSTW_KEY_W3
        mov [r14 + 24], rax;

        lea r15, [rip + _tlstw_label];
        mov rax, 0x2074736579734F58;     // TLSTW_LABEL_W0
        mov [r15 + 0],  rax;
        mov rax, 0x000000006E696B73;     // TLSTW_LABEL_W1
        mov [r15 + 8],  rax;

        // ---------- Stage 3: mint KIND_MEMORY parent at slot 124 ----------
        mov rax, 3;
        lea rcx, [rip + _tlstw_stage];
        mov [rcx], rax;
        mov rdi, 124;                    // slot
        mov rsi, 4;                      // KIND_MEMORY
        mov rdx, 0x200;                  // RIGHT_MINT
        lea rcx, [rip + _tlstw_pubkey];  // target_ptr
        call cap_mint_write;

        // ---------- Stage 4: mint KIND_TLS_TRUST row ----------
        mov rax, 4;
        lea rcx, [rip + _tlstw_stage];
        mov [rcx], rax;
        mov rdi, 124;                    // parent_slot
        mov rsi, 1;                      // algo = TLS_TRUST_ALGO_ED25519
        lea rdx, [rip + _tlstw_pubkey];  // key_ptr
        lea rcx, [rip + _tlstw_label];   // label_ptr
        call kind_tls_trust_mint_body;
        mov r10, 8;                      // TLS_TRUST_MAX
        cmp rax, r10;
        jae tlstw_fail_stage;
        mov r12, rax;                    // r12 = trust row_id

        // ---------- Stage 5: cap_mint_write slot 125 = the KIND_TLS_TRUST cap ----------
        mov rax, 5;
        lea rcx, [rip + _tlstw_stage];
        mov [rcx], rax;
        mov rdi, 125;                    // slot
        mov rsi, 0x1A7;                  // KIND_TLS_TRUST
        mov rdx, 0x001;                  // R_TLS_TRUST_READ
        mov rcx, r12;                    // target_ptr = row_id
        call cap_mint_write;

        // ---------- Stage 6: cap_invoke(125, TLS_TRUST_OP_READ) -> 1 ----------
        mov rax, 6;
        lea rcx, [rip + _tlstw_stage];
        mov [rcx], rax;
        mov rdi, 125;
        mov rsi, 0;                      // TLS_TRUST_OP_READ
        call cap_invoke;
        cmp rax, 1;
        jne tlstw_fail_stage;

        // ---------- Stage 7: QUERY_ALGO -> 1 (Ed25519) ----------
        mov rax, 7;
        lea rcx, [rip + _tlstw_stage];
        mov [rcx], rax;
        mov rdi, 125;
        mov rsi, 1;                      // TLS_TRUST_OP_QUERY_ALGO
        call cap_invoke;
        cmp rax, 1;
        jne tlstw_fail_stage;

        // ---------- Stage 8: QUERY_KEY_W0 -> TLSTW_KEY_W0 ----------
        mov rax, 8;
        lea rcx, [rip + _tlstw_stage];
        mov [rcx], rax;
        mov rdi, 125;
        mov rsi, 2;                      // TLS_TRUST_OP_QUERY_KEY_W0
        call cap_invoke;
        mov r10, 0x1122334455667788;
        cmp rax, r10;
        jne tlstw_fail_stage;

        // ---------- Stage 9: QUERY_KEY_W1 -> TLSTW_KEY_W1 ----------
        mov rax, 9;
        lea rcx, [rip + _tlstw_stage];
        mov [rcx], rax;
        mov rdi, 125;
        mov rsi, 3;                      // TLS_TRUST_OP_QUERY_KEY_W1
        call cap_invoke;
        mov r10, 0x99AABBCCDDEEFF00;
        cmp rax, r10;
        jne tlstw_fail_stage;

        // ---------- Stage 10: QUERY_KEY_W2 -> TLSTW_KEY_W2 ----------
        mov rax, 10;
        lea rcx, [rip + _tlstw_stage];
        mov [rcx], rax;
        mov rdi, 125;
        mov rsi, 4;                      // TLS_TRUST_OP_QUERY_KEY_W2
        call cap_invoke;
        mov r10, 0xDEADBEEFCAFEBABE;
        cmp rax, r10;
        jne tlstw_fail_stage;

        // ---------- Stage 11: QUERY_KEY_W3 -> TLSTW_KEY_W3 ----------
        mov rax, 11;
        lea rcx, [rip + _tlstw_stage];
        mov [rcx], rax;
        mov rdi, 125;
        mov rsi, 5;                      // TLS_TRUST_OP_QUERY_KEY_W3
        call cap_invoke;
        mov r10, 0x1A71A71A71A71A71;
        cmp rax, r10;
        jne tlstw_fail_stage;

        // ---------- Stage 12: QUERY_LABEL_W0 -> TLSTW_LABEL_W0 ----------
        mov rax, 12;
        lea rcx, [rip + _tlstw_stage];
        mov [rcx], rax;
        mov rdi, 125;
        mov rsi, 6;                      // TLS_TRUST_OP_QUERY_LABEL_W0
        call cap_invoke;
        mov r10, 0x2074736579734F58;
        cmp rax, r10;
        jne tlstw_fail_stage;

        // ---------- Stage 13: QUERY_LABEL_W1 -> TLSTW_LABEL_W1 ----------
        mov rax, 13;
        lea rcx, [rip + _tlstw_stage];
        mov [rcx], rax;
        mov rdi, 125;
        mov rsi, 7;                      // TLS_TRUST_OP_QUERY_LABEL_W1
        call cap_invoke;
        mov r10, 0x000000006E696B73;
        cmp rax, r10;
        jne tlstw_fail_stage;

        // ---------- Stage 14: denial cross-check -- cap_invoke with no rights ----------
        // Prove the R_TLS_TRUST_READ gate is live: write a cap at slot
        // 125 with rights=0 (no R_TLS_TRUST_READ), then invoke -> must
        // refuse with TLS_TRUST_BAD_RIGHTS (0xFFFFEB20). Re-mint the
        // real cap after so the fingerprint stage below still names a
        // live cap for readers who correlate `row=<id>` against the
        // cap-slot state.
        mov rax, 14;
        lea rcx, [rip + _tlstw_stage];
        mov [rcx], rax;
        mov rdi, 125;
        mov rsi, 0x1A7;                  // KIND_TLS_TRUST
        xor rdx, rdx;                    // rights = 0 (deny)
        mov rcx, r12;                    // target_ptr = row_id
        call cap_mint_write;

        mov rdi, 125;
        mov rsi, 0;                      // TLS_TRUST_OP_READ
        call cap_invoke;
        mov r10, 0xFFFFEB20;             // TLS_TRUST_BAD_RIGHTS
        cmp rax, r10;
        jne tlstw_fail_stage;

        // Re-mint the real cap so the row stays reachable through slot
        // 125 for whatever a future consumer wires against this witness.
        mov rdi, 125;
        mov rsi, 0x1A7;
        mov rdx, 0x001;                  // R_TLS_TRUST_READ
        mov rcx, r12;
        call cap_mint_write;

        // ---------- Stage 15: emit "boot tls trust ok ..." ----------
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_boot_tls_trust_ok];
        lea rcx, [rip + tlstw_k_row];
        mov r8,  r12;                    // row_id
        lea r9,  [rip + tlstw_k_algo];
        sub rsp, 8;                      // alignment pad
        mov rax, 1;                      // algo (Ed25519)
        push rax;                        // 7th arg (v2) per klog_s1_d2
        call klog_s1_d2;
        add rsp, 16;

        // ---------- Stage 16: teardown ----------
        // §2 immutability contract: leave the row live; scrub only the
        // cap_table slots this witness minted.
        call tlstw_clear_slots;
        jmp tlstw_witness_done;

      tlstw_fail_stage:
        mov rdi, 1;                      // LEVEL_ERROR
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tlstw_fail_msg];
        lea rcx, [rip + k_line];
        lea rax, [rip + _tlstw_stage];
        mov r8, [rax];
        call klog_s1_d1;
        call tlstw_clear_slots;

      tlstw_witness_done:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
