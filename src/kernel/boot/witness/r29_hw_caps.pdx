// src/kernel/boot/witness/r29_hw_caps.pdx — boot witness module
//
// Extracted verbatim from src/kernel/boot/kernel_main.pdx (which had grown
// to 24,315 lines in two functions).  Capability-kind witness block — KIND_DMESG, KIND_IPC_ENDPOINT, KIND_HW, KIND_HW_INTERRUPT and KIND_HW_MSIX_VECTOR.
//
// -----------------------------------------------------------------------------
// Why the body is copied and not rewritten
// -----------------------------------------------------------------------------
//
// The goldens for this tree assert an ORDERED SUBSEQUENCE of fingerprints
// across 14 boot modes, and a witness that silently stops running still
// leaves most of that subsequence intact.  The extraction therefore moves
// the instruction stream unchanged: the only bytes this module adds around
// it are the `push rbp` / `pop rbp` / `ret` below.
//
// -----------------------------------------------------------------------------
// The push is not decoration
// -----------------------------------------------------------------------------
//
// `boot_continue_after_ring3` runs its body at `rsp % 16 == 8` — it sits two `call` levels
// below `_start`, and paideia-as emits no frame prologue for an
// `unsafe`-bodied lambda (emit_visit_lambda.rs suppresses the prologue for
// Unsafe bodies, which is also why `no-frame` is a no-op there).  Several
// witnesses in this file reason explicitly about that parity — "3 pushes from %16==8
// yields (8+3*8)%16 == 0" — and a bare `call` into a bare body would enter
// at `%16 == 0` and invert every one of those arguments.  The single
// `push rbp` restores the inline parity exactly; the matching `pop rbp`
// keeps rbp's SysV guarantee for the caller.
//
// Sections in this module, in the order boot_continue_after_ring3 ran them:
//   * logging-m9-001 (#708): KIND_DMESG cap witness — post-R18 dmesg
//   * R20b.M1-001 (#1552): KIND_IPC_ENDPOINT capability witness.
//   * R29.M0-001 (#1017): KIND_HW base-kind witness — opens R29
//   * R29.M1-001..003 (#1019/#1020/#1021): KIND_HW_INTERRUPT
//   * R29.M1-004 (#1022): KIND_HW_MSIX_VECTOR derived-kind witness —

module R29HwCaps = structure {

  // witness_r29_hw_caps() — the Capability-kind witness block — KIND_DMESG, KIND_IPC_ENDPOINT, KIND_HW, KIND_HW_INTERRUPT and KIND_HW_MSIX_VECTOR.
  //
  // Effect and capability rows are the ones the enclosing
  // `boot_continue_after_ring3` declares.  They are not widened here: this
  // is the same instruction stream under a new symbol, so the authority it
  // needs is by construction the authority it already had.
  pub let witness_r29_hw_caps : () -> () !{sysreg} @{} = fn () -> unsafe {
    effects: { sysreg },
    capabilities: { boot },
    justification: "Boot witness block lifted verbatim out of kernel_main.pdx's boot_continue_after_ring3 during the r29_hw_caps extraction. Body bytes are unchanged from the inline form; the only additions are the entry `push rbp` and the exit `pop rbp; ret`. The push is load-bearing rather than cosmetic: boot_continue_after_ring3 executes its body at rsp%16 == 8 (two `call` levels below _start, with no frame prologue emitted for unsafe-bodied lambdas), and the witnesses inside this module compute their own nested-call alignment from that parity. Entering through a `call` without the compensating push would present rsp%16 == 0 to the body and silently invert every such argument — the failure mode of paideia-os #1192, #1195 and #1584. Effects and capabilities are copied unchanged from the enclosing function for the same reason: no authority is added, so none needs justifying beyond what boot_continue_after_ring3 already justified.",
    block: {
      push rbp;

      // ============================================================
      // logging-m9-001 (#708): KIND_DMESG cap witness — post-R18 dmesg
      // observability handle. Per design/kernel/kernel-logging-substrate.md
      // §12.10 + §14 Q6.
      //
      // Placement: AFTER tmpfs_vops_witness_done (tmpfs is live for any
      // future sibling witnesses in the same block) and BEFORE the #664
      // vfs_open O_CREAT witness (which does not depend on cap state).
      // Runs in the SINGLE-CPU pre-scheduler bring-up window.
      // ============================================================

      // Mint a KIND_DMESG cap in cap_table[10] with rights=RIGHT_READ,
      // target_ptr = &_dmesg_cap_witness_scratch. Then exercise both
      // ops via cap_invoke_dispatch:
      //   OP_STAT (op_arg=1)                : expect rax lo32 == 65536.
      //   OP_READ_TAIL (op_arg=(256<<8)|0) : expect rax > 0 (ring has
      //                                       boot marker content by
      //                                       now — VFS/BOOT/tmpfs OK
      //                                       lines already emitted).
      //
      // Slot 10 chosen to avoid collision with cap_smoke (slot 0),
      // cap_dispatch_smoke (slots 1..8), and future bring-up expansions.
      dmesg_cap_witness:
          // cap_mint_write(slot=10, kind=22 KIND_DMESG, rights=RIGHT_READ=0x01, target_ptr=&scratch)
          mov  rdi, 10
          mov  rsi, 22                             // KIND_DMESG
          mov  rdx, 1                              // RIGHT_READ
          lea  rcx, [rip + _dmesg_cap_witness_scratch]
          call cap_mint_write

          // Sub-test 1: cap_invoke_dispatch(slot=10, op_arg=1=OP_STAT)
          mov  rdi, 10
          mov  rsi, 1                              // OP_STAT
          call cap_invoke_dispatch
          // Extract low 32 bits — must equal KLOG_RING_SIZE (65536).
          mov  rcx, rax
          mov  rdx, 0xFFFFFFFF
          and  rcx, rdx
          mov  rdx, 65536
          cmp  rcx, rdx
          jne  dmesg_cap_witness_fail

          // Sub-test 2: cap_invoke_dispatch(slot=10, op_arg=(256<<8)|0)
          //   OP_READ_TAIL, length = 256.
          mov  rdi, 10
          mov  rsi, 65536                          // (256 << 8) | OP_READ_TAIL(0)
          // 256 << 8 = 65536 exactly. OP_READ_TAIL = 0 → op_arg[7:0] = 0.
          call cap_invoke_dispatch
          // rax = bytes copied. The ring has BOOT / VFS / tmpfs OK lines
          // already, so a peek of 256 must return > 0.
          cmp  rax, 0
          je   dmesg_cap_witness_fail

          // Success marker.
          mov  rdi, 3
          lea  rsi, [rip + SUBSYS_BOOT]
          lea  rdx, [rip + dmesg_cap_ok_msg]
          call klog_s1
          jmp  dmesg_cap_witness_done

      dmesg_cap_witness_fail:
          mov  rdi, 1
          lea  rsi, [rip + SUBSYS_BOOT]
          lea  rdx, [rip + dmesg_cap_fail_msg]
          call klog_s1

      dmesg_cap_witness_done:

      // ============================================================
      // R20b.M1-001 (#1552): KIND_IPC_ENDPOINT capability witness.
      //
      // First sub-issue of the R20b userspace-server substrate cluster.
      // Exercises the KIND_IPC_ENDPOINT descriptor tail encoding
      // formalized in src/kernel/core/cap/kind_endpoint.pdx (per
      // design/ipc/userspace-server-substrate.md §3.1).
      //
      // Sub-tests (executed in order; any failure jumps to fail marker):
      //   A. endpoint_tail_encode(eid=7, dir=BIDI=2) → decode-id == 7,
      //      decode-dir == 2.
      //   B. endpoint_tail_valid on the above tail returns 1.
      //   C. endpoint_tail_valid on a malformed tail (eid=200 > 127)
      //      returns 0.
      //   D. endpoint_tail_valid on a malformed tail (dir=3 RESERVED)
      //      returns 0.
      //   E. endpoint_cap_mint(good_tail, rights=R_IPC_ALL=0x0B)
      //      returns ENDPOINT_MINT_OK (0).
      //   F. endpoint_cap_mint(good_tail, rights=0x04 = EXEC bit not
      //      in R_IPC_ALL) returns ENDPOINT_MINT_BAD_RIGHTS (0xFFFFFFFF).
      //   G. cap_mint_write a witness endpoint cap into slot 11
      //      (chosen distinct from slot 10 used by dmesg_cap_witness).
      //      kind=5 (KIND_IPC_ENDPOINT), rights=R_IPC_ALL, target_ptr
      //      = encoded (eid=7, dir=BIDI). Read back the descriptor and
      //      verify kind/rights/target_ptr match.
      //
      // Placement: runs in the SINGLE-CPU pre-scheduler bring-up window,
      // after dmesg_cap_witness (uses cap_table[10]) and before
      // sys_dmesg_witness. Slot 11 chosen distinct from cap_smoke
      // (slot 0) and cap_dispatch_smoke (slots 1..8) and dmesg (slot 10).
      // ============================================================
      endpoint_cap_witness:
          // -- Sub-test A: encode(eid=7, dir=BIDI=2), decode both fields.
          mov  rdi, 7
          mov  rsi, 2                              // ENDPOINT_DIR_BIDI
          call endpoint_tail_encode
          // rax = tail. Expected: 0x00020007 (dir=2 in bits [17:16] | eid=7).
          mov  r15, rax                            // r15 = good_tail

          // decode_id(good_tail) must equal 7.
          mov  rdi, r15
          call endpoint_tail_decode_id
          cmp  rax, 7
          jne  endpoint_cap_witness_fail

          // decode_dir(good_tail) must equal 2.
          mov  rdi, r15
          call endpoint_tail_decode_dir
          cmp  rax, 2
          jne  endpoint_cap_witness_fail

          // -- Sub-test B: tail_valid(good_tail) == 1.
          mov  rdi, r15
          call endpoint_tail_valid
          cmp  rax, 1
          jne  endpoint_cap_witness_fail

          // -- Sub-test C: tail_valid(eid=200, dir=0) == 0.
          mov  rdi, 200                            // out-of-range eid (>= 128)
          mov  rsi, 0                              // dir = SEND
          call endpoint_tail_encode
          mov  rdi, rax
          call endpoint_tail_valid
          cmp  rax, 0
          jne  endpoint_cap_witness_fail

          // -- Sub-test D: tail_valid(eid=1, dir=3=RESERVED) == 0.
          mov  rdi, 1
          mov  rsi, 3                              // ENDPOINT_DIR_RESERVED
          call endpoint_tail_encode
          mov  rdi, rax
          call endpoint_tail_valid
          cmp  rax, 0
          jne  endpoint_cap_witness_fail

          // -- Sub-test E: endpoint_cap_mint(good_tail, R_IPC_ALL=0x0B) == 0.
          mov  rdi, r15                            // tail
          mov  rsi, 0x0B                           // R_IPC_ALL
          call endpoint_cap_mint
          cmp  rax, 0                              // ENDPOINT_MINT_OK
          jne  endpoint_cap_witness_fail

          // -- Sub-test F: endpoint_cap_mint(good_tail, 0x04) rejects (EXEC not in R_IPC_ALL).
          mov  rdi, r15                            // tail
          mov  rsi, 0x04                           // RIGHT_EXEC — not in R_IPC_ALL
          call endpoint_cap_mint
          mov  r14, 0xFFFFFFFF                     // ENDPOINT_MINT_BAD_RIGHTS
          cmp  rax, r14
          jne  endpoint_cap_witness_fail

          // -- Sub-test G: cap_mint_write slot 11 + read-back verify.
          //    kind=5 (KIND_IPC_ENDPOINT), rights=0x0B, target_ptr=good_tail.
          mov  rdi, 11                             // slot
          mov  rsi, 5                              // KIND_IPC_ENDPOINT
          mov  rdx, 0x0B                           // R_IPC_ALL
          mov  rcx, r15                            // target_ptr = good_tail
          call cap_mint_write

          // Read-back: cap_table[11] descriptor is at base + 11*24 = +264.
          // Layout: [+0]=kind, [+8]=rights, [+16]=target_ptr.
          lea  rax, [rip + cap_table]
          add  rax, 264                            // slot 11 * 24 bytes
          mov  rcx, [rax + 0]                      // kind
          cmp  rcx, 5
          jne  endpoint_cap_witness_fail
          mov  rcx, [rax + 8]                      // rights
          cmp  rcx, 0x0B
          jne  endpoint_cap_witness_fail
          mov  rcx, [rax + 16]                     // target_ptr
          cmp  rcx, r15
          jne  endpoint_cap_witness_fail

          // Success marker.
          mov  rdi, 3                              // LEVEL_INFO
          lea  rsi, [rip + SUBSYS_BOOT]
          lea  rdx, [rip + endpoint_cap_ok_msg]
          call klog_s1
          jmp  endpoint_cap_witness_done

      endpoint_cap_witness_fail:
          mov  rdi, 1                              // LEVEL_ERROR
          lea  rsi, [rip + SUBSYS_BOOT]
          lea  rdx, [rip + endpoint_cap_fail_msg]
          call klog_s1

      endpoint_cap_witness_done:

      // ============================================================
      // R29.M0-001 (#1017): KIND_HW base-kind witness — opens R29
      // (driver-framework maturation round).
      //
      // Promotes slot 14 of the 16-slot base_kind enum from its prior
      // "fault" placeholder to KIND_HW per
      // design/roadmap/next-wave-synthesis.md §10 D6. See also
      // design/capabilities/linearity-and-tags.md §3.1a and
      // design/architecture/next-wave-derived-kinds.md.
      //
      // R29.M1 (#1019-#1022) derives KIND_HW_INTERRUPT and
      // KIND_HW_MSIX_VECTOR over this base kind; KIND_HW_TIMELINE
      // remains reserved. KIND_DMA_DOMAIN (R29.M5, #1036) landed over
      // KIND_MEMORY rather than KIND_HW — a DMA domain is a memory-access
      // scope, not a device-authority handle — so the planning skeleton's
      // `KIND_HW_DMA_DOMAIN` name is retired; see
      // src/kernel/core/cap/kind_dma_domain.pdx §"Naming reconciliation".
      // This iteration only enshrines the base slot — no dispatch branch,
      // no derived tail encoders yet.
      //
      // Sub-tests:
      //   A. cap_mint_write(slot=14, kind=14 KIND_HW,
      //         rights=RIGHT_OBSERVE|RIGHT_MINT = 0x400|0x200 = 0x600,
      //         target_ptr=0xDEADBEEF (sentinel)).
      //   B. Read-back cap_table[14] descriptor: kind == 14, rights ==
      //      0x600, target_ptr == 0xDEADBEEF.
      //   C. cap_invoke_dispatch(slot=14, op_arg=0) → identity
      //      fallthrough returns target_ptr == 0xDEADBEEF (KIND_HW has
      //      no dispatch branch yet — the R8 MVP fallthrough applies).
      //
      // Slot 14 chosen to match the KIND_HW numeric value for
      // aesthetics + auditability (grep for `slot=14` returns the
      // KIND_HW witness). Distinct from cap_smoke (slot 0),
      // cap_dispatch_smoke (slots 1..8), dmesg_cap_witness (slot 10),
      // endpoint_cap_witness (slot 11). Descriptor address:
      //   cap_table + 14 * 24 = cap_table + 336.
      //
      // Placement: SINGLE-CPU pre-scheduler bring-up window, after
      // endpoint_cap_witness (M1-001 close) and before endpoint_alloc
      // witness (M1-002 open). Keeps the R18/R20b base-kind block
      // contiguous and matches the golden-fingerprint ordering:
      //   R18 DMESG CAP OK
      //   R20b ENDPOINT CAP OK
      //   R29 KIND_HW OK        ← this witness
      //   R20b ENDPOINT ALLOC OK
      //   ...
      //
      // No dedicated scratch storage needed — the witness uses only
      // caller-save registers and the cap_table itself.
      // ============================================================
      kind_hw_witness:
          // -- Sub-test A: cap_mint_write(slot=14, KIND_HW=14,
          //    rights=0x600, target_ptr=0xDEADBEEF).
          mov  rdi, 14                             // slot
          mov  rsi, 14                             // KIND_HW
          mov  rdx, 0x600                          // RIGHT_OBSERVE|RIGHT_MINT
          mov  rcx, 0xDEADBEEF                     // sentinel target_ptr
          call cap_mint_write

          // -- Sub-test B: read-back cap_table[14].
          //    Descriptor at cap_table + 14 * 24 = +336.
          //    Layout: [+0]=kind, [+8]=rights, [+16]=target_ptr.
          lea  rax, [rip + cap_table]
          add  rax, 336
          mov  rcx, [rax + 0]                      // kind
          cmp  rcx, 14
          jne  kind_hw_witness_fail
          mov  rcx, [rax + 8]                      // rights
          mov  rdx, 0x600
          cmp  rcx, rdx
          jne  kind_hw_witness_fail
          mov  rcx, [rax + 16]                     // target_ptr
          mov  rdx, 0xDEADBEEF
          cmp  rcx, rdx
          jne  kind_hw_witness_fail

          // -- Sub-test C: cap_invoke_dispatch(slot=14, op_arg=0) —
          //    identity fallthrough returns target_ptr (KIND_HW has no
          //    per-kind handler yet; the R8 MVP fallthrough applies
          //    per src/kernel/core/cap/invoke.pdx).
          mov  rdi, 14                             // slot
          mov  rsi, 0                              // op_arg (unused for fallthrough)
          call cap_invoke_dispatch
          mov  rdx, 0xDEADBEEF
          cmp  rax, rdx
          jne  kind_hw_witness_fail

          // Success marker: R29 KIND_HW OK.
          mov  rdi, 3                              // LEVEL_INFO
          lea  rsi, [rip + SUBSYS_BOOT]
          lea  rdx, [rip + kind_hw_ok_msg]
          call klog_s1
          jmp  kind_hw_witness_done

      kind_hw_witness_fail:
          mov  rdi, 1                              // LEVEL_ERROR
          lea  rsi, [rip + SUBSYS_BOOT]
          lea  rdx, [rip + kind_hw_fail_msg]
          call klog_s1

      kind_hw_witness_done:

      // ============================================================
      // R29.M1-001..003 (#1019/#1020/#1021): KIND_HW_INTERRUPT
      // derived-kind witness — first R29.M1 landing.
      //
      // Derives over KIND_HW (base slot 14, minted immediately above at
      // kind_hw_witness slot 14 with rights=RIGHT_OBSERVE|RIGHT_MINT).
      // Exercises the full lifecycle: tail-alloc, mint, dispatch (three
      // OP_QUERY_* ops), revoke, verify slot is null. Uses the just-
      // minted KIND_HW cap at slot 14 as the "ancestor" required by
      // hw_int_cap_mint's parent gate.
      //
      // Sub-tests (any failure jumps to fail marker):
      //   A. hw_int_tail_alloc(gsi=0x30, affinity=0x01, edge_or_level=0)
      //      returns row_id in [0..HW_INT_MAX). Also probes tail_valid
      //      on the freshly-allocated row_id == 1.
      //   B. hw_int_tail_decode_{gsi,affinity,edge_or_level}(row_id)
      //      round-trip (gsi=0x30, affinity=0x01, edge=0).
      //   C. Failure edge: hw_int_tail_alloc(gsi=0x40, affinity=0,
      //      edge_or_level=2) returns HW_INT_TAIL_BAD_ARG (edge_or_level
      //      out of range).
      //   D. Failure edge: hw_int_rights_valid(0x04 EXEC — not in
      //      R_HW_INT_ALL=0x618) returns 0.
      //   E. hw_int_cap_revoke on unused slot 12 returns
      //      HW_INT_REVOKE_ALREADY (idempotent path — slot 12 has never
      //      been minted so kind==0).
      //   F. Restore: free the row from sub-test A so the mint below
      //      starts on a clean table.
      //   G. hw_int_cap_mint(slot=12, parent_slot=14,
      //         rights=R_HW_INT_ALL=0x618, gsi=0x30, affinity=0x01,
      //         edge_or_level=0) returns HW_INT_MINT_OK (0).
      //   H. Read-back cap_table[12]: kind == 0x140, rights == 0x618,
      //      target_ptr < HW_INT_MAX (row_id in valid range).
      //   I. cap_invoke_dispatch(slot=12, op_arg=0 OP_QUERY_GSI) returns
      //      0x30. Same for OP_QUERY_AFFINITY (0x01) and OP_QUERY_TRIGGER
      //      (0x00).
      //   J. Failure edge: mint with parent_slot=0 (cap_smoke, kind==1
      //      KIND_PROCESS, not KIND_HW) returns HW_INT_MINT_BAD_PARENT.
      //   K. hw_int_cap_revoke(slot=12) returns HW_INT_REVOKE_OK.
      //   L. Read-back cap_table[12] verifies descriptor is cleared
      //      (kind=0, rights=0, target_ptr=0). hw_int_tail_valid(row_id
      //      from sub-test G) returns 0 (row freed as part of revoke).
      //
      // Placement: runs immediately after kind_hw_witness_done (slot 14
      // already holds the KIND_HW ancestor). Slot 12 chosen distinct
      // from every other cap_table user: cap_smoke (0), cap_dispatch_smoke
      // (1..8), dmesg (10), endpoint_cap (11), kind_hw (14). Row_id 0
      // is used by sub-test A; sub-tests G/H/K use whichever row_id the
      // allocator hands out (should be 0 after sub-test F frees it).
      //
      // Fingerprint ordering (post-M1 landing):
      //   R20b ENDPOINT CAP OK
      //   R29 KIND_HW OK           (R29.M0-001)
      //   R29 KIND_INTERRUPT OK    ← THIS WITNESS
      //   R20b ENDPOINT ALLOC OK
      //   ...
      // ============================================================
      kind_hw_interrupt_witness:
          // Stage counter is memory-backed in _kind_hw_int_witness_stage
          // rather than a callee-save register — matches the discipline
          // of _frame_witness_stage / _pending_witness_stage above, so
          // the tracker survives any helper-call clobber pattern (any
          // caller-save write inside a helper would trash a register).
          //
          // #1567: the pre-clean of cap_table[12] that used to live here
          // is REMOVED. It was a workaround for slot 12's 24-byte
          // descriptor region empirically NOT reading clean .bss zero at
          // this point in boot on the boot_r17_shell_shutdown fixture —
          // root-caused to entry.pdx's _start never actually zeroing the
          // kernel's .bss region at all (boot/zero_bss.pdx was written at
          // Phase 1 P1-005 but was neither `pub` nor `ret`-terminated, so
          // it was unreachable and unreachable-if-reached; the kernel
          // depended entirely on the -kernel boot chain's zero-fill of
          // the .bss PT_LOAD's NOBITS tail, which is not reliable). Now
          // that entry.pdx's _start explicitly rep-stosq-zeroes
          // [_bss_start, _bss_end) as its first act, sub-test E's
          // idempotent-revoke assertion below depends on genuine
          // bss-zero-init like every other untouched cap_table slot.

          // -- Sub-test A: hw_int_tail_alloc(gsi=0x30, affinity=0x01, edge=0).
          mov  rax, 1
          lea  rcx, [rip + _kind_hw_int_witness_stage]
          mov  [rcx], rax
          mov  rdi, 0x30                           // gsi
          mov  rsi, 0x01                           // cpu_affinity_mask
          mov  rdx, 0                              // edge_or_level (0=edge)
          call hw_int_tail_alloc
          // rax = row_id; must be < 64.
          mov  r15, rax                            // r15 = probe_row_id
          mov  rcx, 64
          cmp  r15, rcx
          jae  kind_hw_int_witness_fail

          // hw_int_tail_valid(probe_row_id) == 1.
          mov  rax, 2
          lea  rcx, [rip + _kind_hw_int_witness_stage]
          mov  [rcx], rax
          mov  rdi, r15
          call hw_int_tail_valid
          cmp  rax, 1
          jne  kind_hw_int_witness_fail

          // -- Sub-test B: decode round-trip.
          mov  rax, 3
          lea  rcx, [rip + _kind_hw_int_witness_stage]
          mov  [rcx], rax
          mov  rdi, r15
          call hw_int_tail_decode_gsi
          cmp  rax, 0x30
          jne  kind_hw_int_witness_fail

          mov  rax, 4
          lea  rcx, [rip + _kind_hw_int_witness_stage]
          mov  [rcx], rax
          mov  rdi, r15
          call hw_int_tail_decode_affinity
          cmp  rax, 0x01
          jne  kind_hw_int_witness_fail

          mov  rax, 5
          lea  rcx, [rip + _kind_hw_int_witness_stage]
          mov  [rcx], rax
          mov  rdi, r15
          call hw_int_tail_decode_edge_or_level
          cmp  rax, 0
          jne  kind_hw_int_witness_fail

          // -- Sub-test C: tail_alloc with edge_or_level=2 -> BAD_ARG.
          mov  rax, 6
          lea  rcx, [rip + _kind_hw_int_witness_stage]
          mov  [rcx], rax
          mov  rdi, 0x40
          mov  rsi, 0
          mov  rdx, 2
          call hw_int_tail_alloc
          mov  rcx, 0xFFFFFFFE                    // HW_INT_TAIL_BAD_ARG
          cmp  rax, rcx
          jne  kind_hw_int_witness_fail

          // -- Sub-test D: rights_valid(0x04 EXEC) -> 0.
          mov  rax, 7
          lea  rcx, [rip + _kind_hw_int_witness_stage]
          mov  [rcx], rax
          mov  rdi, 0x04
          call hw_int_rights_valid
          cmp  rax, 0
          jne  kind_hw_int_witness_fail

          // -- Sub-test E: revoke never-minted slot 12 -> REVOKE_ALREADY.
          //    #1567: this now relies on genuine .bss zero-init (entry.pdx's
          //    _start rep-stosq-zeroes [_bss_start, _bss_end) before any
          //    other kernel code runs) rather than the witness-entry
          //    pre-clean this preamble used to do — that pre-clean was
          //    working around _start never zeroing .bss at all. Exercises
          //    the idempotent already-null revoke path.
          mov  rax, 8
          lea  rcx, [rip + _kind_hw_int_witness_stage]
          mov  [rcx], rax
          mov  rdi, 12
          call hw_int_cap_revoke
          mov  rcx, 0xFFFFFFF7                    // HW_INT_REVOKE_ALREADY
          cmp  rax, rcx
          jne  kind_hw_int_witness_fail

          // -- Sub-test F: free the sub-test A row so mint below reuses it.
          mov  rdi, r15
          call hw_int_tail_free

          // -- Sub-test G: hw_int_cap_mint(slot=12, parent_slot=14,
          //    rights=R_HW_INT_ALL=0x618, gsi=0x30, affinity=0x01, edge=0).
          //    SysV: rdi=slot, rsi=parent_slot, rdx=rights, rcx=gsi, r8=affinity, r9=edge.
          mov  rax, 9
          lea  rcx, [rip + _kind_hw_int_witness_stage]
          mov  [rcx], rax
          mov  rdi, 12
          mov  rsi, 14
          mov  rdx, 0x618
          mov  rcx, 0x30
          mov  r8,  0x01
          mov  r9,  0
          call hw_int_cap_mint
          cmp  rax, 0                             // HW_INT_MINT_OK
          jne  kind_hw_int_witness_fail

          // -- Sub-test H: read-back cap_table[12] (three field checks
          //    all guarded by the same stage=10; a failure at any of
          //    the three fields reports "stage 10" — enough to
          //    identify sub-test H). Stage set uses r8/rdi as scratch
          //    (both are caller-save and about to be overwritten by
          //    the next call anyway); rax stays live as the descriptor
          //    base pointer throughout.
          mov  r8, 10
          lea  rdi, [rip + _kind_hw_int_witness_stage]
          mov  [rdi], r8
          lea  rax, [rip + cap_table]
          add  rax, 288
          mov  rcx, [rax + 0]                     // kind
          mov  rdx, 0x140
          cmp  rcx, rdx
          jne  kind_hw_int_witness_fail
          mov  rcx, [rax + 8]                     // rights
          mov  rdx, 0x618
          cmp  rcx, rdx
          jne  kind_hw_int_witness_fail
          mov  rcx, [rax + 16]                    // target_ptr = row_id
          mov  r14, rcx                           // save row_id for sub-test L
          mov  rdx, 64                            // HW_INT_MAX
          cmp  rcx, rdx
          jae  kind_hw_int_witness_fail

          // -- Sub-test I: cap_invoke_dispatch(slot=12, op) round-trip.
          //    OP_QUERY_GSI (0) -> 0x30
          mov  rax, 13
          lea  rcx, [rip + _kind_hw_int_witness_stage]
          mov  [rcx], rax
          mov  rdi, 12
          mov  rsi, 0
          call cap_invoke_dispatch
          cmp  rax, 0x30
          jne  kind_hw_int_witness_fail

          //    OP_QUERY_AFFINITY (1) -> 0x01
          mov  rax, 14
          lea  rcx, [rip + _kind_hw_int_witness_stage]
          mov  [rcx], rax
          mov  rdi, 12
          mov  rsi, 1
          call cap_invoke_dispatch
          cmp  rax, 0x01
          jne  kind_hw_int_witness_fail

          //    OP_QUERY_TRIGGER (2) -> 0
          mov  rax, 15
          lea  rcx, [rip + _kind_hw_int_witness_stage]
          mov  [rcx], rax
          mov  rdi, 12
          mov  rsi, 2
          call cap_invoke_dispatch
          cmp  rax, 0
          jne  kind_hw_int_witness_fail

          // -- Sub-test J: mint with parent_slot=0 (KIND_PROCESS, not KIND_HW)
          //    -> HW_INT_MINT_BAD_PARENT. Target slot 13 (unused).
          mov  rax, 16
          lea  rcx, [rip + _kind_hw_int_witness_stage]
          mov  [rcx], rax
          mov  rdi, 13
          mov  rsi, 0                             // parent = cap_smoke slot 0 (KIND_PROCESS)
          mov  rdx, 0x618
          mov  rcx, 0x40
          mov  r8,  0x02
          mov  r9,  1
          call hw_int_cap_mint
          mov  rcx, 0xFFFFFFFD                    // HW_INT_MINT_BAD_PARENT
          cmp  rax, rcx
          jne  kind_hw_int_witness_fail

          // -- Sub-test K: hw_int_cap_revoke(slot=12) -> REVOKE_OK.
          mov  rax, 17
          lea  rcx, [rip + _kind_hw_int_witness_stage]
          mov  [rcx], rax
          mov  rdi, 12
          call hw_int_cap_revoke
          cmp  rax, 0                             // HW_INT_REVOKE_OK
          jne  kind_hw_int_witness_fail

          // -- Sub-test L: verify descriptor cleared + row freed.
          mov  rax, 18
          lea  rcx, [rip + _kind_hw_int_witness_stage]
          mov  [rcx], rax
          lea  rax, [rip + cap_table]
          add  rax, 288
          mov  rcx, [rax + 0]
          cmp  rcx, 0
          jne  kind_hw_int_witness_fail
          mov  rcx, [rax + 8]
          cmp  rcx, 0
          jne  kind_hw_int_witness_fail
          mov  rcx, [rax + 16]
          cmp  rcx, 0
          jne  kind_hw_int_witness_fail

          // hw_int_tail_valid(row_id from mint) == 0 (row was freed).
          mov  rax, 19
          lea  rcx, [rip + _kind_hw_int_witness_stage]
          mov  [rcx], rax
          mov  rdi, r14
          call hw_int_tail_valid
          cmp  rax, 0
          jne  kind_hw_int_witness_fail

          // Success marker: R29 KIND_INTERRUPT OK.
          mov  rdi, 3                             // LEVEL_INFO
          lea  rsi, [rip + SUBSYS_BOOT]
          lea  rdx, [rip + kind_hw_int_ok_msg]
          call klog_s1
          jmp  kind_hw_interrupt_witness_done

      kind_hw_int_witness_fail:
          // Emit fail marker with the _kind_hw_int_witness_stage number
          // as decimal KV. Stage is memory-backed (not r12) because any
          // callee-save-clobber in our helper chain would corrupt a
          // register-backed counter. Matches _frame_witness_stage pattern.
          //   klog_s1_d1(LEVEL_ERROR, SUBSYS_BOOT, kind_hw_int_fail_msg,
          //              k_line, stage)
          lea  rax, [rip + _kind_hw_int_witness_stage]
          mov  r8,  [rax]                          // r8 = stage value (arg 4)
          mov  rdi, 1                              // LEVEL_ERROR
          lea  rsi, [rip + SUBSYS_BOOT]
          lea  rdx, [rip + kind_hw_int_fail_msg]
          lea  rcx, [rip + k_line]
          call klog_s1_d1

      kind_hw_interrupt_witness_done:

      // ============================================================
      // R29.M1-004 (#1022): KIND_HW_MSIX_VECTOR derived-kind witness —
      // second derived-kind landing under KIND_HW. Closes R29.M1.
      //
      // Semantically layered atop KIND_HW_INTERRUPT: a KIND_HW_INTERRUPT
      // cap authorizes a line/GSI and MINTS N KIND_HW_MSIX_VECTOR
      // children (one per MSI-X vector on the underlying device). This
      // witness mints one parent + 4 children (typical NVMe / virtio-
      // net vector-count baseline), verifies each tail decode, then
      // revokes the parent and asserts all four children are auto-
      // revoked via msix_cascade_revoke_by_parent.
      //
      // Cap-table slot allocation:
      //   Slot 15 — KIND_HW_INTERRUPT parent (gsi=0x40, affinity=0x03,
      //             edge_or_level=1). Fresh (unused by any prior witness
      //             in the pre-scheduler bring-up window). Distinct
      //             from slot 12 (kind_hw_interrupt_witness, cleared
      //             at sub-test K), slot 14 (kind_hw_witness, holds
      //             KIND_HW base cap).
      //   Slots 16..19 — KIND_HW_MSIX_VECTOR children. Distinct
      //             {msix_table_offset, msix_data} tuples per child:
      //               slot 16: offset=0x00, data=0x8001
      //               slot 17: offset=0x10, data=0x8002
      //               slot 18: offset=0x20, data=0x8003
      //               slot 19: offset=0x30, data=0x8004
      //             Offsets are 16-byte-aligned per the MSI-X table
      //             entry stride; data payloads are distinct so the
      //             decode round-trip proves per-child persistence.
      //
      // Sub-tests (any failure jumps to fail marker):
      //   A. Pre-clean slots 15..19 (28 * 3 bytes cap-table state) so
      //      the witness runs from a known-null state regardless of
      //      any prior code path that may have touched a slot.
      //   B. hw_int_cap_mint(slot=15, parent_slot=14, rights=0x618,
      //      gsi=0x40, affinity=0x03, edge=1) -> HW_INT_MINT_OK.
      //   C. msix_cap_mint 4 children at slots 16..19 with distinct
      //      (offset, data) tuples -> each returns MSIX_MINT_OK.
      //   D. Read-back cap_table[16..19]: each kind == 0x141,
      //      rights == 0x218.
      //   E. cap_invoke_dispatch each child with OP_QUERY_TABLE_OFFSET
      //      -> returns the child's minted offset.
      //   F. cap_invoke_dispatch each child with OP_QUERY_DATA
      //      -> returns the child's minted data.
      //   G. cap_invoke_dispatch each child with OP_QUERY_PARENT
      //      -> returns 15 (the parent slot).
      //   H. Failure edge: msix_cap_mint(slot=20, parent_slot=14
      //      KIND_HW — not KIND_HW_INTERRUPT) -> MSIX_MINT_BAD_PARENT.
      //   I. Failure edge: msix_rights_valid(0x800 — bit not in
      //      R_MSIX_ALL=0x218) -> 0.
      //   J. hw_int_cap_revoke(slot=15) -> HW_INT_REVOKE_OK. Internally
      //      calls msix_cascade_revoke_by_parent(15) which revokes all
      //      four children.
      //   K. Verify each of cap_table[16..19] is cleared (kind=0,
      //      rights=0, target_ptr=0). Proves the cascade path fired.
      //   L. Verify cap_table[15] is cleared. Proves parent revoke
      //      itself completed after cascade.
      //
      // Fingerprint ordering (post-M1-004 landing):
      //   R29 KIND_HW OK             (R29.M0-001)
      //   R29 KIND_INTERRUPT OK      (R29.M1-001..003)
      //   R29 KIND_MSIX_VECTOR OK    ← THIS WITNESS
      //   R20b ENDPOINT ALLOC OK
      //   ...
      //
      // Stage tracker: memory-backed in _kind_hw_msix_witness_stage
      // (declared alongside _kind_hw_int_witness_stage in the .bss
      // block below). Same discipline: written before each sub-test,
      // reported on the fail path via klog_s1_d1.
      // ============================================================
      kind_hw_msix_vector_witness:
          // -- Sub-test A: pre-clean slots 15..19 (5 slots * 24 bytes
          //    each), belt-and-suspenders on top of the #1567 fix that
          //    makes entry.pdx's _start genuinely zero .bss up front
          //    (see kind_hw_interrupt_witness above, which used to carry
          //    the equivalent pre-clean for slot 12 and no longer needs
          //    to). Left in place here defensively; ensures the
          //    mint/revoke assertions depend only on state THIS witness
          //    installs regardless.
          //    Descriptor stride = 24 bytes; slot 15 at offset 360,
          //    slot 19 at offset 456 -> clears 120 bytes total.
          mov  rax, 1
          lea  rcx, [rip + _kind_hw_msix_witness_stage]
          mov  [rcx], rax
          lea  rax, [rip + cap_table]                      // [cap-stride-ok: hw-caps MSI-X preamble multi-slot pre-clean from slot 15 across four adjacent descriptors]
          add  rax, 360                            // slot 15 * 24
          xor  rcx, rcx
          mov  [rax + 0],   rcx                    // slot 15
          mov  [rax + 8],   rcx
          mov  [rax + 16],  rcx
          mov  [rax + 24],  rcx                    // slot 16
          mov  [rax + 32],  rcx
          mov  [rax + 40],  rcx
          mov  [rax + 48],  rcx                    // slot 17
          mov  [rax + 56],  rcx
          mov  [rax + 64],  rcx
          mov  [rax + 72],  rcx                    // slot 18
          mov  [rax + 80],  rcx
          mov  [rax + 88],  rcx
          mov  [rax + 96],  rcx                    // slot 19
          mov  [rax + 104], rcx
          mov  [rax + 112], rcx

          // -- Sub-test B: hw_int_cap_mint(slot=15, parent_slot=14,
          //    rights=0x618, gsi=0x40, affinity=0x03, edge=1).
          //    SysV: rdi=slot, rsi=parent_slot, rdx=rights, rcx=gsi,
          //          r8=affinity, r9=edge.
          mov  rax, 2
          lea  rcx, [rip + _kind_hw_msix_witness_stage]
          mov  [rcx], rax
          mov  rdi, 15                             // parent slot
          mov  rsi, 14                             // KIND_HW ancestor
          mov  rdx, 0x618                          // R_HW_INT_ALL
          mov  rcx, 0x40                           // gsi
          mov  r8,  0x03                           // affinity
          mov  r9,  1                              // edge_or_level=level
          call hw_int_cap_mint
          cmp  rax, 0                              // HW_INT_MINT_OK
          jne  kind_hw_msix_witness_fail

          // -- Sub-test C: mint 4 children at slots 16..19.
          //    child 0: slot=16, offset=0x00, data=0x8001
          mov  rax, 3
          lea  rcx, [rip + _kind_hw_msix_witness_stage]
          mov  [rcx], rax
          mov  rdi, 16                             // child slot
          mov  rsi, 15                             // parent slot (KIND_HW_INTERRUPT)
          mov  rdx, 0x218                          // R_MSIX_ALL
          mov  rcx, 0x00                           // msix_table_offset
          mov  r8,  0x8001                         // msix_data
          call msix_cap_mint
          cmp  rax, 0                              // MSIX_MINT_OK
          jne  kind_hw_msix_witness_fail

          //    child 1: slot=17, offset=0x10, data=0x8002
          mov  rax, 4
          lea  rcx, [rip + _kind_hw_msix_witness_stage]
          mov  [rcx], rax
          mov  rdi, 17
          mov  rsi, 15
          mov  rdx, 0x218
          mov  rcx, 0x10
          mov  r8,  0x8002
          call msix_cap_mint
          cmp  rax, 0
          jne  kind_hw_msix_witness_fail

          //    child 2: slot=18, offset=0x20, data=0x8003
          mov  rax, 5
          lea  rcx, [rip + _kind_hw_msix_witness_stage]
          mov  [rcx], rax
          mov  rdi, 18
          mov  rsi, 15
          mov  rdx, 0x218
          mov  rcx, 0x20
          mov  r8,  0x8003
          call msix_cap_mint
          cmp  rax, 0
          jne  kind_hw_msix_witness_fail

          //    child 3: slot=19, offset=0x30, data=0x8004
          mov  rax, 6
          lea  rcx, [rip + _kind_hw_msix_witness_stage]
          mov  [rcx], rax
          mov  rdi, 19
          mov  rsi, 15
          mov  rdx, 0x218
          mov  rcx, 0x30
          mov  r8,  0x8004
          call msix_cap_mint
          cmp  rax, 0
          jne  kind_hw_msix_witness_fail

          // -- Sub-test D: read-back each of cap_table[16..19].
          //    Verify kind == 0x141 and rights == 0x218. Skip
          //    target_ptr shape here (row_id 0..HW_MSIX_MAX; witness
          //    sub-tests E/F/G exercise the row-decode round-trip).
          mov  rax, 7
          lea  rcx, [rip + _kind_hw_msix_witness_stage]
          mov  [rcx], rax
          lea  rax, [rip + cap_table]                      // [cap-stride-ok: hw-caps MSI-X descriptor read-back across slots 16..17 from a constant-slot base]
          add  rax, 384                            // slot 16 * 24
          //    slot 16:
          mov  rcx, [rax + 0]
          mov  rdx, 0x141
          cmp  rcx, rdx
          jne  kind_hw_msix_witness_fail
          mov  rcx, [rax + 8]
          mov  rdx, 0x218
          cmp  rcx, rdx
          jne  kind_hw_msix_witness_fail
          //    slot 17:
          mov  rcx, [rax + 24]
          mov  rdx, 0x141
          cmp  rcx, rdx
          jne  kind_hw_msix_witness_fail
          mov  rcx, [rax + 32]
          mov  rdx, 0x218
          cmp  rcx, rdx
          jne  kind_hw_msix_witness_fail
          //    slot 18:
          mov  rcx, [rax + 48]
          mov  rdx, 0x141
          cmp  rcx, rdx
          jne  kind_hw_msix_witness_fail
          mov  rcx, [rax + 56]
          mov  rdx, 0x218
          cmp  rcx, rdx
          jne  kind_hw_msix_witness_fail
          //    slot 19:
          mov  rcx, [rax + 72]
          mov  rdx, 0x141
          cmp  rcx, rdx
          jne  kind_hw_msix_witness_fail
          mov  rcx, [rax + 80]
          mov  rdx, 0x218
          cmp  rcx, rdx
          jne  kind_hw_msix_witness_fail

          // -- Sub-test E: OP_QUERY_TABLE_OFFSET on each child.
          mov  rax, 8
          lea  rcx, [rip + _kind_hw_msix_witness_stage]
          mov  [rcx], rax
          mov  rdi, 16
          mov  rsi, 0                              // OP_QUERY_TABLE_OFFSET
          call cap_invoke_dispatch
          cmp  rax, 0x00
          jne  kind_hw_msix_witness_fail

          mov  rax, 9
          lea  rcx, [rip + _kind_hw_msix_witness_stage]
          mov  [rcx], rax
          mov  rdi, 17
          mov  rsi, 0
          call cap_invoke_dispatch
          cmp  rax, 0x10
          jne  kind_hw_msix_witness_fail

          mov  rax, 10
          lea  rcx, [rip + _kind_hw_msix_witness_stage]
          mov  [rcx], rax
          mov  rdi, 18
          mov  rsi, 0
          call cap_invoke_dispatch
          cmp  rax, 0x20
          jne  kind_hw_msix_witness_fail

          mov  rax, 11
          lea  rcx, [rip + _kind_hw_msix_witness_stage]
          mov  [rcx], rax
          mov  rdi, 19
          mov  rsi, 0
          call cap_invoke_dispatch
          cmp  rax, 0x30
          jne  kind_hw_msix_witness_fail

          // -- Sub-test F: OP_QUERY_DATA on each child.
          mov  rax, 12
          lea  rcx, [rip + _kind_hw_msix_witness_stage]
          mov  [rcx], rax
          mov  rdi, 16
          mov  rsi, 1                              // OP_QUERY_DATA
          call cap_invoke_dispatch
          cmp  rax, 0x8001
          jne  kind_hw_msix_witness_fail

          mov  rax, 13
          lea  rcx, [rip + _kind_hw_msix_witness_stage]
          mov  [rcx], rax
          mov  rdi, 17
          mov  rsi, 1
          call cap_invoke_dispatch
          cmp  rax, 0x8002
          jne  kind_hw_msix_witness_fail

          mov  rax, 14
          lea  rcx, [rip + _kind_hw_msix_witness_stage]
          mov  [rcx], rax
          mov  rdi, 18
          mov  rsi, 1
          call cap_invoke_dispatch
          cmp  rax, 0x8003
          jne  kind_hw_msix_witness_fail

          mov  rax, 15
          lea  rcx, [rip + _kind_hw_msix_witness_stage]
          mov  [rcx], rax
          mov  rdi, 19
          mov  rsi, 1
          call cap_invoke_dispatch
          cmp  rax, 0x8004
          jne  kind_hw_msix_witness_fail

          // -- Sub-test G: OP_QUERY_PARENT on each child (all four
          //    should return 15, the parent slot recorded at mint).
          mov  rax, 16
          lea  rcx, [rip + _kind_hw_msix_witness_stage]
          mov  [rcx], rax
          mov  rdi, 16
          mov  rsi, 2                              // OP_QUERY_PARENT
          call cap_invoke_dispatch
          cmp  rax, 15
          jne  kind_hw_msix_witness_fail

          mov  rax, 17
          lea  rcx, [rip + _kind_hw_msix_witness_stage]
          mov  [rcx], rax
          mov  rdi, 17
          mov  rsi, 2
          call cap_invoke_dispatch
          cmp  rax, 15
          jne  kind_hw_msix_witness_fail

          mov  rax, 18
          lea  rcx, [rip + _kind_hw_msix_witness_stage]
          mov  [rcx], rax
          mov  rdi, 18
          mov  rsi, 2
          call cap_invoke_dispatch
          cmp  rax, 15
          jne  kind_hw_msix_witness_fail

          mov  rax, 19
          lea  rcx, [rip + _kind_hw_msix_witness_stage]
          mov  [rcx], rax
          mov  rdi, 19
          mov  rsi, 2
          call cap_invoke_dispatch
          cmp  rax, 15
          jne  kind_hw_msix_witness_fail

          // -- Sub-test H: mint with wrong-kind parent (slot 14 is
          //    KIND_HW base, not KIND_HW_INTERRUPT) -> BAD_PARENT.
          //    Target slot 20 (unused).
          mov  rax, 20
          lea  rcx, [rip + _kind_hw_msix_witness_stage]
          mov  [rcx], rax
          mov  rdi, 20
          mov  rsi, 14                             // KIND_HW, not 0x140
          mov  rdx, 0x218
          mov  rcx, 0x40
          mov  r8,  0x9000
          call msix_cap_mint
          mov  rcx, 0xFFFFFFED                     // MSIX_MINT_BAD_PARENT
          cmp  rax, rcx
          jne  kind_hw_msix_witness_fail

          // -- Sub-test I: rights_valid(0x800) -> 0 (bit not in R_MSIX_ALL).
          mov  rax, 21
          lea  rcx, [rip + _kind_hw_msix_witness_stage]
          mov  [rcx], rax
          mov  rdi, 0x800
          call msix_rights_valid
          cmp  rax, 0
          jne  kind_hw_msix_witness_fail

          // -- Sub-test J: hw_int_cap_revoke(slot=15) -> HW_INT_REVOKE_OK.
          //    Internally cascades: msix_cascade_revoke_by_parent(15)
          //    revokes all 4 children before the parent frees its own
          //    row/descriptor.
          mov  rax, 22
          lea  rcx, [rip + _kind_hw_msix_witness_stage]
          mov  [rcx], rax
          mov  rdi, 15
          call hw_int_cap_revoke
          cmp  rax, 0                              // HW_INT_REVOKE_OK
          jne  kind_hw_msix_witness_fail

          // -- Sub-test K: verify each child slot is cleared. Any
          //    non-zero kind/rights/target_ptr means the cascade
          //    missed that slot.
          mov  rax, 23
          lea  rcx, [rip + _kind_hw_msix_witness_stage]
          mov  [rcx], rax
          lea  rax, [rip + cap_table]                      // [cap-stride-ok: hw-caps MSI-X post-revoke read-back across slots 16..17 from a constant-slot base]
          add  rax, 384                            // slot 16 * 24
          //    slot 16 (offsets 0, 8, 16):
          mov  rcx, [rax + 0]
          cmp  rcx, 0
          jne  kind_hw_msix_witness_fail
          mov  rcx, [rax + 8]
          cmp  rcx, 0
          jne  kind_hw_msix_witness_fail
          mov  rcx, [rax + 16]
          cmp  rcx, 0
          jne  kind_hw_msix_witness_fail
          //    slot 17 (offsets 24, 32, 40):
          mov  rcx, [rax + 24]
          cmp  rcx, 0
          jne  kind_hw_msix_witness_fail
          mov  rcx, [rax + 32]
          cmp  rcx, 0
          jne  kind_hw_msix_witness_fail
          mov  rcx, [rax + 40]
          cmp  rcx, 0
          jne  kind_hw_msix_witness_fail
          //    slot 18 (offsets 48, 56, 64):
          mov  rcx, [rax + 48]
          cmp  rcx, 0
          jne  kind_hw_msix_witness_fail
          mov  rcx, [rax + 56]
          cmp  rcx, 0
          jne  kind_hw_msix_witness_fail
          mov  rcx, [rax + 64]
          cmp  rcx, 0
          jne  kind_hw_msix_witness_fail
          //    slot 19 (offsets 72, 80, 88):
          mov  rcx, [rax + 72]
          cmp  rcx, 0
          jne  kind_hw_msix_witness_fail
          mov  rcx, [rax + 80]
          cmp  rcx, 0
          jne  kind_hw_msix_witness_fail
          mov  rcx, [rax + 88]
          cmp  rcx, 0
          jne  kind_hw_msix_witness_fail

          // -- Sub-test L: verify parent slot 15 is cleared.
          mov  rax, 24
          lea  rcx, [rip + _kind_hw_msix_witness_stage]
          mov  [rcx], rax
          lea  rax, [rip + cap_table]
          add  rax, 360                            // slot 15 * 24
          mov  rcx, [rax + 0]
          cmp  rcx, 0
          jne  kind_hw_msix_witness_fail
          mov  rcx, [rax + 8]
          cmp  rcx, 0
          jne  kind_hw_msix_witness_fail
          mov  rcx, [rax + 16]
          cmp  rcx, 0
          jne  kind_hw_msix_witness_fail

          // Success marker: R29 KIND_MSIX_VECTOR OK.
          mov  rdi, 3                              // LEVEL_INFO
          lea  rsi, [rip + SUBSYS_BOOT]
          lea  rdx, [rip + kind_hw_msix_ok_msg]
          call klog_s1
          jmp  kind_hw_msix_vector_witness_done

      kind_hw_msix_witness_fail:
          // Emit fail marker with the _kind_hw_msix_witness_stage
          // number as decimal KV. Same pattern as
          // kind_hw_int_witness_fail — memory-backed stage counter
          // survives any callee-save-clobber pattern in the helper
          // chain (msix_cap_mint / msix_cap_revoke /
          // hw_int_cap_revoke → msix_cascade_revoke_by_parent all
          // touch multiple callee-save regs).
          lea  rax, [rip + _kind_hw_msix_witness_stage]
          mov  r8,  [rax]                          // r8 = stage value (arg 4)
          mov  rdi, 1                              // LEVEL_ERROR
          lea  rsi, [rip + SUBSYS_BOOT]
          lea  rdx, [rip + kind_hw_msix_fail_msg]
          lea  rcx, [rip + k_line]
          call klog_s1_d1

      kind_hw_msix_vector_witness_done:


      pop rbp;
      ret
    }
  }

  // -------------------------------------------------------------------------
  // Witness storage
  //
  // These declarations came out of kernel_main.pdx alongside the code
  // above.  Each moved only because this module is the ONLY file in the
  // tree that references it in code; storage read by the exception
  // handlers, by tests, by boot_stub.S, or by a second witness module
  // has no single owner and stayed behind.
  //
  // Declaration ORDER is preserved from kernel_main.pdx.  Several of
  // these witnesses write past the end of one buffer into the next on
  // purpose (the deliberately-511-u64 payload patterns), so relative
  // placement inside a single object is not a formatting question.
  // -------------------------------------------------------------------------

  // R29.M1-001..003 (#1019/#1020/#1021): sub-test stage tracker for the
  // kind_hw_interrupt_witness. Same posture as _frame_witness_stage above
  // — memory-backed rather than register-backed so its value survives any
  // helper-call clobber pattern. Zero-init in .bss; overwritten before
  // every jne-to-fail throughout the witness.
  pub let mut _kind_hw_int_witness_stage : u64 = 0

  // R29.M1-004 (#1022): sub-test stage tracker for the
  // kind_hw_msix_vector_witness. Same discipline as
  // _kind_hw_int_witness_stage above — memory-backed so it survives
  // any callee-save-clobber pattern inside msix_cap_mint /
  // msix_cap_revoke / hw_int_cap_revoke's cascade path.
  pub let mut _kind_hw_msix_witness_stage : u64 = 0
}
