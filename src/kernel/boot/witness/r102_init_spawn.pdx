// src/kernel/boot/witness/r102_init_spawn.pdx — R102.MON-009 skeleton
//
// R102.MON-009 (paideia-os #2216) owns the init cascade that spawns
// svc-compositor first, then svc-wm, then any graphical seed app
// (pdxclock as the M4 canary, per r102-user-plan.md §4.10). The
// compositor blocks on scanout-cap arrival; the WM blocks on the
// compositor's `svc.compositor` broker registration; graphical apps
// block on the WM's registration.
//
// In steady state this cascade lives inside `src/user/init.pdx` (the
// ring-3 init process), extending the existing fork+execve chain
// (child_hello -> sh -> elevate_broker_daemon -> ...) with the three
// R102 spawns.
//
// -----------------------------------------------------------------------------
// Why the init cascade is a kernel-side skip witness right now
// -----------------------------------------------------------------------------
//
// Adding the real spawn calls to src/user/init.pdx today would require
// naming three new `bin_<name>_path` constants pointing at /bin/svc-
// compositor, /bin/svc-wm, and (M4) /bin/pdxclock -- none of which
// resolve because R102.MON-003 (bin_seeds) has not been able to seed
// those paths (see r102_bin_seeds.pdx header for why -- the underlying
// ELFs are not embedded because the satellite repos are empty scaffolds).
//
// Every prior init spawn (child_hello, sh, elevate_broker_daemon,
// mkfs.pdxfs) landed in init.pdx only AFTER its /bin/<name> seed
// landed, because a spawn into a non-seeded path produces a silent
// -ENOENT that init falls through and skips -- observable only by the
// absence of a downstream fingerprint. To keep the R102 init-spawn
// pattern observable AS a skip line (not a missing marker), MON-009
// lands here as a kernel-side witness that emits ONE lowercase skip
// fingerprint naming the reason on every boot.
//
// When R102.MON-003 fills in the six /bin seeds and the three R102
// apps become spawnable, this witness is retired and the compositor +
// WM spawn stanzas migrate into src/user/init.pdx immediately after
// the elevate_broker_daemon spawn (see init.pdx §justification for the
// existing chain shape). At that point the OK fingerprint
// `r102 init sequence ok` is emitted by init itself right before the
// pdxclock spawn.
//
// -----------------------------------------------------------------------------
// Fingerprint
// -----------------------------------------------------------------------------
//
//   Skeleton (this landing):
//     "boot r102 init spawn skip reason=no-elf"
//   Future (once compositor + wm spawn from init in ring-3):
//     "r102 init sequence ok"           (per r102-user-plan.md §4.10 MON-009)
//
// Encoder discipline: same as r102_first_pixel.pdx.

module R102InitSpawn = structure {

  // 40 bytes including NUL.
  pub let tag_r102_init_spawn_skip : [u8; 40] =
    "boot r102 init spawn skip reason=no-elf\0"

  pub let witness_r102_init_spawn : () -> () !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R102.MON-009 skeleton (paideia-os #2216). Emits the ONE-line lowercase skip fingerprint `boot r102 init spawn skip reason=no-elf` on every boot. Owns the eventual svc-compositor + svc-wm + pdxclock spawn cascade that ring-3 init will run once the underlying ELFs are seeded into /bin (blocked on R102.MON-003, itself blocked on the nine empty satellite scaffolds). Kept in kernel-space as a klog_s1 skeleton so the skip line is observable in the boot transcript AS a positive line, not by the ABSENCE of an init-side line -- matches the tree's existing skip discipline for bin_child_hello_seed_fail / bin_sh_seed_fail. Migrates into src/user/init.pdx's fork+execve chain when the preconditions arrive. push rbp / pop rbp preserves the caller's rsp%16 parity and rbp guarantee across the nested klog_s1 call.",
      block: {
        push rbp;

        mov rdi, 3;                              // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_r102_init_spawn_skip];
        call klog_s1;

        pop rbp;
        ret
      }
    }
}
