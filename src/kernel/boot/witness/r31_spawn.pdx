// src/kernel/boot/witness/r31_spawn.pdx — boot witness module
//
// Extracted verbatim from src/kernel/boot/kernel_main.pdx (which had grown
// to 24,315 lines in two functions).  R31.M2 witness block — the loader-side multi-task boot spawn and its owner-axis assertions, through `r31_spawn_done`.
//
// -----------------------------------------------------------------------------
// Why the body is copied and not rewritten
// -----------------------------------------------------------------------------
//
// The goldens for this tree assert an ORDERED SUBSEQUENCE of fingerprints
// across 14 boot modes, and a witness that silently stops running still
// leaves most of that subsequence intact.  The extraction therefore moves
// the instruction stream unchanged: the only bytes this module adds around
// it are the `push rbp` / `pop rbp` / `ret` below.
//
// -----------------------------------------------------------------------------
// The push is not decoration
// -----------------------------------------------------------------------------
//
// `boot_continue_after_ring3` runs its body at `rsp % 16 == 8` — it sits two `call` levels
// below `_start`, and paideia-as emits no frame prologue for an
// `unsafe`-bodied lambda (emit_visit_lambda.rs suppresses the prologue for
// Unsafe bodies, which is also why `no-frame` is a no-op there).  Several
// witnesses in this file reason explicitly about that parity — "3 pushes from %16==8
// yields (8+3*8)%16 == 0" — and a bare `call` into a bare body would enter
// at `%16 == 0` and invert every one of those arguments.  The single
// `push rbp` restores the inline parity exactly; the matching `pop rbp`
// keeps rbp's SysV guarantee for the caller.
//
// Sections in this module, in the order boot_continue_after_ring3 ran them:
//   * R31.M2-1590 (#1590): the loader-side multi-task boot spawn.

module R31Spawn = structure {

  // witness_r31_spawn() — the R31.M2 witness block — the loader-side multi-task boot spawn and its owner-axis assertions, through `r31_spawn_done`.
  //
  // Effect and capability rows are the ones the enclosing
  // `boot_continue_after_ring3` declares.  They are not widened here: this
  // is the same instruction stream under a new symbol, so the authority it
  // needs is by construction the authority it already had.
  pub let witness_r31_spawn : () -> () !{sysreg} @{} = fn () -> unsafe {
    effects: { sysreg },
    capabilities: { boot },
    justification: "Boot witness block lifted verbatim out of kernel_main.pdx's boot_continue_after_ring3 during the r31_spawn extraction. Body bytes are unchanged from the inline form; the only additions are the entry `push rbp` and the exit `pop rbp; ret`. The push is load-bearing rather than cosmetic: boot_continue_after_ring3 executes its body at rsp%16 == 8 (two `call` levels below _start, with no frame prologue emitted for unsafe-bodied lambdas), and the witnesses inside this module compute their own nested-call alignment from that parity. Entering through a `call` without the compensating push would present rsp%16 == 0 to the body and silently invert every such argument — the failure mode of paideia-os #1192, #1195 and #1584. Effects and capabilities are copied unchanged from the enclosing function for the same reason: no authority is added, so none needs justifying beyond what boot_continue_after_ring3 already justified.",
    block: {
      push rbp;

      // ============================================================
      // R31.M2-1590 (#1590): the loader-side multi-task boot spawn.
      //
      // Everything above this line that calls itself a userspace-server
      // witness is the kernel talking to itself: sys_ipc_send_body,
      // sys_ipc_recv_body and sys_ipc_reply_body driven from ring 0
      // against init's address space, with both halves of the
      // conversation synthesized. That posture proved the substrate
      // honestly and is deliberately left in place — see the closing
      // note below on which of those witnesses are now redundant.
      //
      // This block spawns two REAL ring-3 processes and lets the
      // scheduler drive them.
      //
      // Placement — LAST, immediately before sti + enter_userland_initial:
      //   * after every structural witness, so none of their task_new /
      //     task_free traffic perturbs the pids these two receive;
      //   * before sti, so the runqueue is fully built with interrupts
      //     off and no timer tick can land mid-spawn;
      //   * before enter_userland_initial, which never returns.
      //
      // Pid consequence, stated plainly: echo_server and echo_client
      // take pids 2 and 3 and hold them for the life of the boot (the
      // server loops forever; the client becomes a zombie no one reaps,
      // because its parent is 0 by design). init's own fork children
      // therefore start at pid 4 instead of 2. The four boot_r17_shell_*
      // goldens and expected-boot-r17-init.txt are updated to match.
      // That is a real behavioural change being recorded, not a golden
      // being relaxed: the boot genuinely runs two more processes now.
      //
      // Register discipline: every value this block needs across a call
      // lives in .bss, exactly as m6_symtab_witness does. The original
      // reason was that r12/r13/r14 carried init's boot state (task slab /
      // e_entry / user_rsp) into enter_userland_initial and had to
      // survive — a rule stated only in comments, and the one the
      // verifying debugger broke by inserting `mov r13, 0xdeadbeef` at
      // the top of this very function, which silently dropped `R31 ECHO
      // CLIENT RING3 OK`. #1604 moved the handoff into .bss slots that
      // this module cannot name, so the rule is now enforced rather than
      // asserted. The .bss storage below stays as written.
      //
      // rsp alignment: entry here is rsp %16 == 8 (the outer prologue's
      // pushes were popped at ipc_bounce_witness_done), so nested calls
      // land at %16 == 8 -> aligned.
      // ============================================================

      // ---- Sub-test 0: claim the two well-known endpoint rows. ----
      //
      // echo_server's sidecar names endpoint_id 1; echo_client's names 1
      // (send) and 2 (reply). Those numbers are baked into the images at
      // build time, so the rows must be claimed by ID, not by whatever
      // endpoint_alloc's free-list cursor happens to return after the
      // preceding witnesses' alloc/free arithmetic. endpoint_alloc_at
      // exists for exactly this and refuses a row that is already taken.
      xor rax, rax;
      lea rcx, [rip + _r31_spawn_stage];
      mov [rcx], rax;                          // stage = 0

      mov rdi, 1;                              // svc.echo server endpoint
      call endpoint_alloc_at;
      cmp rax, 0;                              // EP_ALLOC_AT_OK
      jne r31_spawn_fail;

      mov rax, 1;
      lea rcx, [rip + _r31_spawn_stage];
      mov [rcx], rax;                          // stage = 1

      mov rdi, 2;                              // client reply endpoint
      call endpoint_alloc_at;
      cmp rax, 0;
      jne r31_spawn_fail;

      // ---- Sub-test 2: SERVICE ORDERING — witness the LOSING order. ----
      //
      // sys_svc_lookup resolves a name to an endpoint and mints a client
      // capability for it. A client that looks up before its server has
      // registered must fail cleanly; the failure mode that would matter
      // is a lookup that succeeds against an unpopulated row and hands
      // back authority over endpoint 0.
      //
      // So the losing order is witnessed FIRST and explicitly: look up
      // "svc.echo" BEFORE svc_register, and require -ENOENT
      // (0xFFFFFFFFFFFFFFFE). A test that only ever registers first
      // proves nothing about a race that arrives the moment scheduling
      // changes.
      //
      // Note this is the ordering hazard that is REAL for this pair. The
      // spawn-order hazard is not: both endpoint rows are claimed by the
      // kernel above, before either task exists, so a client that runs
      // to completion before the server is ever scheduled still succeeds
      // — its send lands in a live endpoint buffer and its recv blocks
      // until the server drains it. The pair is spawned client-first
      // below precisely so that the harder order is the one shipped,
      // rather than the one that happens to work.
      mov rax, 2;
      lea rcx, [rip + _r31_spawn_stage];
      mov [rcx], rax;                          // stage = 2

      // Resolved through svc_lookup_row rather than sys_svc_lookup_body,
      // and the distinction is worth stating rather than glossing:
      // sys_svc_lookup_body reads its name through the KPTI-safe USER
      // walker, so a kernel-VA name returns -EFAULT and never reaches the
      // resolution step at all. svc_lookup_row IS that resolution step —
      // sys_svc_lookup_body calls it, and it is precisely its returning 0
      // that drives the syscall's -ENOENT tail. Asserting here is therefore
      // asserting the predicate, one layer below the copy-in that would
      // otherwise be the only thing under test.
      lea rdi, [rip + _r31_svc_spawn_name];
      mov rsi, 9;                              // len("svc.spawn")
      call svc_lookup_row;
      cmp rax, 0;                              // no row == the ENOENT case
      jne r31_spawn_fail;

      // ---- Sub-test 3: register, then the WINNING order resolves. ----
      mov rax, 3;
      lea rcx, [rip + _r31_spawn_stage];
      mov [rcx], rax;                          // stage = 3

      lea rdi, [rip + _r31_svc_spawn_name];
      mov rsi, 9;
      mov rdx, 1;                              // endpoint_id 1
      call svc_register;
      cmp rax, 0;                              // SVC_REGISTER_OK
      jne r31_spawn_fail;

      mov rax, 4;
      lea rcx, [rip + _r31_spawn_stage];
      mov [rcx], rax;                          // stage = 4

      lea rdi, [rip + _r31_svc_spawn_name];
      mov rsi, 9;
      call svc_lookup_row;
      cmp rax, 0;
      je r31_spawn_fail;                       // now it must resolve
      // …and to the endpoint we registered, not merely to something.
      // endpoint_id is a u16 at row+32 (svc_broker.pdx §row layout).
      xor rcx, rcx;
      mov_w rcx, [rax + 32];
      cmp rcx, 1;                              // endpoint_id 1
      jne r31_spawn_fail;

      mov rdi, 3;                              // LEVEL_INFO
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + r31_svc_order_ok_msg];
      call klog_s1;

      // ---- Sub-test 4.5 (R31.M2-1599 / #1599): A SPAWN THAT FAILS AFTER
      //      CLAIMING MUST NOT POISON THE SLOTS IT CLAIMED. ----
      //
      // Until this sub-test existed the matrix had no failing spawn in it
      // at all — every spawn in every mode succeeded — which is precisely
      // why task_free's missing owner sweep survived two milestones. The
      // path is not exotic: boot_spawn_user_task tears a task back down
      // through task_free on elf-load and stack failures, both of which
      // can occur after loader_seed_caps has already stamped cap_owner
      // with this task's (pid, generation).
      //
      // The failure is injected rather than provoked because the
      // post-claim window is one step wide and only frame exhaustion can
      // reach it — see boot_spawn.pdx §_boot_spawn_inject_stack_fail for
      // the enumeration. The injection takes the EXISTING bspawn_err_stack
      // path, so what is under test is the production teardown.
      //
      // WHAT THIS ASSERTS, IN ORDER:
      //   (a) the spawn actually failed — a knob that silently did nothing
      //       would make (b) and (c) vacuous, which is the whole class of
      //       defect this loop keeps finding;
      //   (b) it failed for the reason claimed (BOOT_SPAWN_ERR_STACK, 6),
      //       not for some earlier reason that never claimed anything;
      //   (c) the injection was consumed, so it cannot arm a later spawn;
      //   (d) BOTH slots the failed spawn claimed read CAP_OWNER_NONE
      //       through cap_owner_live_key — the same predicate #1596's
      //       ownership pre-pass uses, so this asks the question in the
      //       exact terms the next spawn will ask it.
      //
      // (d) IS THE GUARDRAIL, AND THE DOWNSTREAM SPAWN IS NOT. The
      // tempting simplification — drop (d), let sub-test 5's refusal be
      // the whole test — was measured and does NOT work: with the sweep
      // removed from task_free AND (d) neutered, this boot PASSES.
      //
      // Why: the failed spawn releases its pid, and the real spawn right
      // after it gets that same pid back (pid_alloc is dense-low-first
      // with no aging), which makes task_new bump _pid_gen. The stale
      // key's generation then no longer matches, cap_owner_live_key
      // answers CAP_OWNER_NONE, and the pre-pass admits the seed. The
      // poison is masked by the very reuse that would otherwise expose
      // it — which is precisely why this defect is intermittent, and why
      // the observable symptom lands on whichever spawn happens NOT to
      // inherit the poisoned pid.
      //
      // So (d) asks the pre-pass predicate at the one moment the answer
      // is unambiguous: after the teardown, before any allocation can
      // mask it. See design/kernel/r31-m2-1599-task-free-owner-sweep.md
      // §4.5, where the measurement is recorded.
      mov rax, 45;                             // stage 45 == sub-test 4.5
      lea rcx, [rip + _r31_spawn_stage];
      mov [rcx], rax;

      lea rcx, [rip + _boot_spawn_inject_stack_fail];
      mov rax, 1;
      mov [rcx], rax;                          // arm the one-shot

      lea rdi, [rip + _echo_client_bin_start];
      lea rax, [rip + _echo_client_bin_end];
      sub rax, rdi;
      mov rsi, rax;                            // image_len
      call boot_spawn_user_task;
      cmp rax, 0;                              // (a) it MUST have failed
      jne r31_spawn_fail;

      lea rax, [rip + _boot_spawn_last_error];
      mov rax, [rax];
      cmp rax, 6;                              // (b) BOOT_SPAWN_ERR_STACK
      jne r31_spawn_fail;

      lea rax, [rip + _boot_spawn_inject_stack_fail];
      mov rax, [rax];
      cmp rax, 0;                              // (c) one-shot was consumed
      jne r31_spawn_fail;

      // (d) The client sidecar seeds slots 0 and 1. cap_owner_live_key is
      //     the #1596 pre-pass predicate: it answers CAP_OWNER_NONE for an
      //     unowned slot AND for a key whose incarnation has ended, and a
      //     packed key otherwise. Note that a bare cap_owner_get would NOT
      //     do here — the column can hold a stale key that is genuinely
      //     dead — and equally that liveness alone is not the whole story:
      //     because pid_gen_bump stamps at ALLOCATION, the freed task's
      //     key still reads live until its pid is reused, which is exactly
      //     what made the stale key block the next spawn.
      xor rdi, rdi;                            // slot 0
      call cap_owner_live_key;
      cmp rax, 0;                              // CAP_OWNER_NONE
      jne r31_spawn_fail;

      mov rdi, 1;                              // slot 1
      call cap_owner_live_key;
      cmp rax, 0;
      jne r31_spawn_fail;

      mov rdi, 3;                              // LEVEL_INFO
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + r31_spawn_failsweep_ok_msg];
      call klog_s1;

      // ---- Sub-test 5: spawn the CLIENT first (the losing order). ----
      //
      // R31.M2-1599 (#1599): this now also runs immediately after a spawn
      // of the SAME image failed post-claim, so it exercises the seed path
      // against slots a failed spawn had already claimed. It is NOT the
      // detector for a missing sweep — see the note on sub-test 4.5 above
      // for the measurement showing why — but it is the end-to-end check
      // that a failed spawn leaves the loader able to try again.
      mov rax, 5;
      lea rcx, [rip + _r31_spawn_stage];
      mov [rcx], rax;                          // stage = 5

      lea rdi, [rip + _echo_client_bin_start];
      lea rax, [rip + _echo_client_bin_end];
      sub rax, rdi;
      mov rsi, rax;                            // image_len
      call boot_spawn_user_task;
      cmp rax, 0;
      je r31_spawn_fail;
      lea rcx, [rip + _r31_client_task];
      mov [rcx], rax;

      // ---- Sub-test 6: spawn the server. ----
      mov rax, 6;
      lea rcx, [rip + _r31_spawn_stage];
      mov [rcx], rax;                          // stage = 6

      lea rdi, [rip + _echo_server_bin_start];
      lea rax, [rip + _echo_server_bin_end];
      sub rax, rdi;
      mov rsi, rax;                            // image_len
      call boot_spawn_user_task;
      cmp rax, 0;
      je r31_spawn_fail;
      lea rcx, [rip + _r31_server_task];
      mov [rcx], rax;

      mov rdi, 3;                              // LEVEL_INFO
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + r31_boot_spawn_ok_msg];
      call klog_s1;

      // ---- Sub-test 7: the OWNER COLUMN, for both tasks. ----
      //
      // This is the assertion #1590 is really about. Each spawned task
      // carries an _init_caps sidecar; loader_seed_caps minted those
      // entries into the cap_table AND, because elf_lite_load now
      // forwards the owning task, stamped cap_owner[slot] with the
      // task's (pid, generation). Without that stamp the sweep on the
      // task's death matches nothing, clears nothing, and reports
      // success — a leak that is silent by construction.
      //
      // Checked against cap_owner_pack(pid, pid_gen_read(pid)) computed
      // here rather than against a literal, so a change to the key
      // packing moves both sides together.
      //
      // R31.M2-1596 (#1596): WHICH SLOTS, AND WHY THE ANSWER CHANGED.
      //
      // This used to check server slot 0 and client slot 1, with a note
      // explaining that the client's OWN slot 0 was gone -- the server,
      // spawned second, had re-minted it, and cap_mint_write clears the
      // owner column on every mint. The note called that "checked
      // implicitly". It was not a check. It was a description of a silent
      // authority overwrite, recorded because there was nothing better to
      // do with it.
      //
      // The images now sit on disjoint slot windows
      // (design/capabilities/loader-seeded-slot-allocation.md): client 0-1,
      // server 2. So all three seeded capabilities survive their own load,
      // and the witness checks all three rather than two-plus-an-excuse.
      //
      // The client's slot 0 is the one that matters. Before #1596 it
      // carried the SERVER's key by the time this ran. If the slot
      // allocation ever regresses, or the pre-pass refusal is removed and
      // the overwrite returns, this assertion is what fails.
      mov rax, 7;
      lea rcx, [rip + _r31_spawn_stage];
      mov [rcx], rax;                          // stage = 7

      lea rax, [rip + _r31_server_task];
      mov rax, [rax];
      xor rcx, rcx;
      mov ecx, [rax + 0];                      // server pid
      lea rax, [rip + _r31_scratch_pid];
      mov [rax], rcx;
      mov rdi, rcx;
      call pid_gen_read;
      cmp rax, 0;
      je r31_spawn_fail;
      mov rsi, rax;                            // generation
      lea rax, [rip + _r31_scratch_pid];
      mov rdi, [rax];                          // pid
      call cap_owner_pack;
      cmp rax, 0;
      je r31_spawn_fail;
      lea rcx, [rip + _r31_scratch_key];
      mov [rcx], rax;                          // expected server key

      mov rdi, 2;                              // slot 2 — server's endpoint cap (#1596)
      call cap_owner_get;
      lea rcx, [rip + _r31_scratch_key];
      mov rcx, [rcx];
      cmp rax, rcx;
      jne r31_spawn_fail;

      mov rax, 8;
      lea rcx, [rip + _r31_spawn_stage];
      mov [rcx], rax;                          // stage = 8

      lea rax, [rip + _r31_client_task];
      mov rax, [rax];
      xor rcx, rcx;
      mov ecx, [rax + 0];                      // client pid
      lea rax, [rip + _r31_scratch_pid];
      mov [rax], rcx;
      mov rdi, rcx;
      call pid_gen_read;
      cmp rax, 0;
      je r31_spawn_fail;
      mov rsi, rax;
      lea rax, [rip + _r31_scratch_pid];
      mov rdi, [rax];
      call cap_owner_pack;
      cmp rax, 0;
      je r31_spawn_fail;
      lea rcx, [rip + _r31_scratch_key];
      mov [rcx], rax;                          // expected client key

      mov rdi, 1;                              // slot 1 — client's reply cap
      call cap_owner_get;
      lea rcx, [rip + _r31_scratch_key];
      mov rcx, [rcx];
      cmp rax, rcx;
      jne r31_spawn_fail;

      // R31.M2-1596 (#1596): the client's slot 0, which the server used to
      // take. Same expected key as slot 1 above -- still in
      // _r31_scratch_key, and cap_owner_get preserves it.
      mov rax, 9;
      lea rcx, [rip + _r31_spawn_stage];
      mov [rcx], rax;                          // stage = 9

      xor rdi, rdi;                            // slot 0 — client's server-endpoint cap
      call cap_owner_get;
      lea rcx, [rip + _r31_scratch_key];
      mov rcx, [rcx];
      cmp rax, rcx;
      jne r31_spawn_fail;

      mov rdi, 3;                              // LEVEL_INFO
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + r31_spawn_owner_ok_msg];
      call klog_s1;
      jmp r31_spawn_done;

      r31_spawn_fail:
      // Emit "R31 BOOT SPAWN FAIL line=<stage>". Non-fatal: the boot
      // continues into ring-3 so a broken spawn is diagnosed from init's
      // wire output rather than by a silent hang before it.
      lea rax, [rip + _r31_spawn_stage];
      mov r8, [rax];
      mov rdi, 1;                              // LEVEL_ERROR
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + r31_boot_spawn_fail_msg];
      lea rcx, [rip + k_line];
      call klog_s1_d1;

      // Second line carrying boot_spawn_user_task's own refusal reason
      // (BOOT_SPAWN_ERR_*). The stage alone says WHICH spawn failed; this
      // says why, and the two most interesting answers — 2 (frame budget
      // exhausted, refused before allocating) and 5 (elf_lite_load, which
      // includes a rejected _init_caps sidecar) — are otherwise
      // indistinguishable from the outside.
      lea rax, [rip + _boot_spawn_last_error];
      mov r8, [rax];
      mov rdi, 1;                              // LEVEL_ERROR
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + r31_boot_spawn_err_msg];
      lea rcx, [rip + k_count];
      call klog_s1_d1;

      r31_spawn_done:

      pop rbp;
      ret
    }
  }

  // -------------------------------------------------------------------------
  // Witness storage
  //
  // These declarations came out of kernel_main.pdx alongside the code
  // above.  Each moved only because this module is the ONLY file in the
  // tree that references it in code; storage read by the exception
  // handlers, by tests, by boot_stub.S, or by a second witness module
  // has no single owner and stayed behind.
  //
  // Declaration ORDER is preserved from kernel_main.pdx.  Several of
  // these witnesses write past the end of one buffer into the next on
  // purpose (the deliberately-511-u64 payload patterns), so relative
  // placement inside a single object is not a formatting question.
  // -------------------------------------------------------------------------

  // ==========================================================================
  // R31.M2-1590 (#1590): loader-side multi-task boot spawn witness state.
  //
  // All of it lives in .bss rather than in registers because the witness
  // runs between the last structural witness and enter_userland_initial.
  // Until #1604 that position also meant r12/r13/r14 carried init's boot
  // state (task slab / e_entry / user_rsp) through this function and had
  // to survive untouched; that handoff now has .bss slots of its own in
  // kernel_main.pdx, which this module deliberately cannot name (see
  // tools/verify-init-handoff.sh). Same discipline as
  // m6_symtab_witness's §Register discipline note.
  //
  // _r31_svc_echo_name is the broker key the ordering sub-test resolves.
  // 8 chars + NUL; svc_register and sys_svc_lookup_body are both length-
  // bounded and never read the terminator, which is present only so the
  // literal reads as a string at the declaration site.
  // ==========================================================================
  pub let _r31_svc_spawn_name : [u8; 10] = "svc.spawn\0"
  pub let mut _r31_spawn_stage  : u64 = 0
  pub let mut _r31_server_task  : u64 = 0
  pub let mut _r31_client_task  : u64 = 0
  pub let mut _r31_scratch_pid  : u64 = 0
  pub let mut _r31_scratch_key  : u64 = 0

  // No trailing newline: klog_emit_core appends the KV list and the line
  // terminator itself, so a tag that already ends in "\n" pushes its own
  // key=value onto a second line (as the pre-existing *_FAIL tags do).
  // Matching the "PAT INIT OK slot4=WC" shape keeps marker and value on one
  // line, which is what lets a golden assert the value.
  pub let r31_svc_order_ok_msg    : [u8; 17] = "R31 SVC ORDER OK\0"
  pub let r31_boot_spawn_ok_msg   : [u8; 18] = "R31 BOOT SPAWN OK\0"
  pub let r31_boot_spawn_fail_msg : [u8; 20] = "R31 BOOT SPAWN FAIL\0"
  pub let r31_spawn_owner_ok_msg  : [u8; 19] = "R31 SPAWN OWNER OK\0"
  pub let r31_boot_spawn_err_msg  : [u8; 19] = "R31 BOOT SPAWN ERR\0"

  // R31.M2-1599 (#1599): the failing-spawn sub-test's marker. Emitted only
  // after a spawn was made to fail past the point its capabilities were
  // claimed AND both of the slots it claimed were observed free again.
  pub let r31_spawn_failsweep_ok_msg : [u8; 24] = "R31 SPAWN FAIL SWEEP OK\0"
}
