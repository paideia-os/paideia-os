// src/kernel/boot/witness/r20b_loader.pdx — boot witness module
//
// Extracted verbatim from src/kernel/boot/kernel_main.pdx (which had grown
// to 24,315 lines in two functions).  R20b.M4/M6 loader witness block — InitCap sidecar validator, loader_seed_caps, and the phase-2 ELF-symbol walker.
//
// -----------------------------------------------------------------------------
// Why the body is copied and not rewritten
// -----------------------------------------------------------------------------
//
// The goldens for this tree assert an ORDERED SUBSEQUENCE of fingerprints
// across 14 boot modes, and a witness that silently stops running still
// leaves most of that subsequence intact.  The extraction therefore moves
// the instruction stream unchanged: the only bytes this module adds around
// it are the `push rbp` / `pop rbp` / `ret` below.
//
// -----------------------------------------------------------------------------
// The push is not decoration
// -----------------------------------------------------------------------------
//
// `boot_continue_after_ring3` runs its body at `rsp % 16 == 8` — it sits two `call` levels
// below `_start`, and paideia-as emits no frame prologue for an
// `unsafe`-bodied lambda (emit_visit_lambda.rs suppresses the prologue for
// Unsafe bodies, which is also why `@no_frame` is a no-op there).  Several
// witnesses in this file reason explicitly about that parity — "3 pushes from %16==8
// yields (8+3*8)%16 == 0" — and a bare `call` into a bare body would enter
// at `%16 == 0` and invert every one of those arguments.  The single
// `push rbp` restores the inline parity exactly; the matching `pop rbp`
// keeps rbp's SysV guarantee for the caller.
//
// Sections in this module, in the order boot_continue_after_ring3 ran them:
//   * R20b.M4-001 (#1561): InitCap sidecar format + validator witness.
//   * R20b.M4-002 (#1562): loader_seed_caps hook witness — closes M4.
//   * R20b.M6-001 (#1564): loader phase-2 ELF-symbol walker witness.

module R20bLoader = structure {

  // witness_r20b_loader() — the R20b.M4/M6 loader witness block — InitCap sidecar validator, loader_seed_caps, and the phase-2 ELF-symbol walker.
  //
  // Effect and capability rows are the ones the enclosing
  // `boot_continue_after_ring3` declares.  They are not widened here: this
  // is the same instruction stream under a new symbol, so the authority it
  // needs is by construction the authority it already had.
  pub let witness_r20b_loader : () -> () !{sysreg} @{} = fn () -> unsafe {
    effects: { sysreg },
    capabilities: { boot },
    justification: "Boot witness block lifted verbatim out of kernel_main.pdx's boot_continue_after_ring3 during the r20b_loader extraction. Body bytes are unchanged from the inline form; the only additions are the entry `push rbp` and the exit `pop rbp; ret`. The push is load-bearing rather than cosmetic: boot_continue_after_ring3 executes its body at rsp%16 == 8 (two `call` levels below _start, with no frame prologue emitted for unsafe-bodied lambdas), and the witnesses inside this module compute their own nested-call alignment from that parity. Entering through a `call` without the compensating push would present rsp%16 == 0 to the body and silently invert every such argument — the failure mode of paideia-os #1192, #1195 and #1584. Effects and capabilities are copied unchanged from the enclosing function for the same reason: no authority is added, so none needs justifying beyond what boot_continue_after_ring3 already justified.",
    block: {
      push rbp;

      // ============================================================
      // R20b.M4-001 (#1561): InitCap sidecar format + validator witness.
      //
      // First sub-issue of the R20b.M4 (loader capability-seed hook)
      // branch — opens M4. Exercises init_caps_validate
      // (src/kernel/core/loader/init_caps.pdx) against a hand-authored
      // 2-entry sidecar synthesized in kernel .bss
      // (_init_caps_witness_sidecar). Runs AFTER ipc_bounce_witness_done
      // pops r12/r13/r14 to their outer init-bootstrap values (needed
      // by the enter_userland_initial call below) and BEFORE `sti`
      // (still safe kernel state).
      //
      // Sidecar layout (48 bytes = 16 header + 2 * 16 entries; see
      // design/loader/init-caps-sidecar.md §3):
      //   [+ 0] header word 0: count = 2 (u16 in low 16 bits) + pad
      //   [+ 8] header word 1: 14-byte padding (upper part) + last 8
      //   [+16] entry 0 word 0: (rights<<32) | (kind<<16) | slot
      //   [+24] entry 0 word 1: target_ptr
      //   [+32] entry 1 word 0
      //   [+40] entry 1 word 1
      //
      // Sub-tests (stage tracked in _init_caps_witness_stage; any
      // failure jumps to init_caps_witness_fail with the stage):
      //
      //   0. Populate sidecar with two well-formed entries:
      //        entry 0: slot=1,  kind=KIND_IPC_ENDPOINT(5), rights=R_IPC_ALL(0x0B)
      //        entry 1: slot=10, kind=KIND_DMESG(0x16),     rights=RIGHT_READ(0x01)
      //      Call init_caps_validate(sidecar, 48) — expect 0.
      //
      //   1. Malformed count (BAD_COUNT): call with image_len=8, which
      //      is less than the 16-byte header — validator's header-bounds
      //      gate fires. Expect 0xFFFFFFFF.
      //
      //   2. Out-of-range slot (BAD_SLOT): repack entry 0's word 0 with
      //      slot=256 (== INIT_CAP_SLOT_MAX; first out-of-range value).
      //      Expect 0xFFFFFFFE. Restore entry 0 for sub-test 3.
      //
      //   3. Unknown kind (BAD_KIND): repack entry 0's word 0 with
      //      kind=17 (0x11 — not in {0..15, 0x15 KIND_DRIVER,
      //      0x16 KIND_DMESG}). Expect 0xFFFFFFFD.
      //
      // Register discipline: init_caps_validate + klog_s1 both preserve
      // SysV callee-save regs (r12-r15), so r12/r13/r14 stay live for
      // the enter_userland_initial call below without push/pop. Uses
      // rax/rcx/rdx/rdi/rsi/r8/r10/r11 (caller-save) as scratch; r15
      // untouched. Every sub-test writes _init_caps_witness_stage
      // before doing anything else so a fail path prints which sub-test
      // tripped via klog_s1_d1's "line" key.
      // ============================================================
      init_caps_witness:
          // -- Sub-test 0: accept path — 2 well-formed entries.
          xor rax, rax;
          lea rcx, [rip + _init_caps_witness_stage];
          mov [rcx], rax;                          // stage = 0

          // Populate sidecar in-place. All stores are aligned u64
          // writes into a [u64; 6] buffer; no unaligned traffic.
          lea r10, [rip + _init_caps_witness_sidecar];
          mov rax, 2;                              // count = 2 (low 16 bits of word 0)
          mov [r10 + 0], rax;                      // header word 0
          xor rax, rax;
          mov [r10 + 8], rax;                      // header word 1 (padding)

          // Entry 0: slot=1, kind=5 (KIND_IPC_ENDPOINT), rights=0x0B (R_IPC_ALL)
          //   pack = (0x0B << 32) | (5 << 16) | 1 = 0x0000000B00050001
          mov rax, 0x0000000B00050001;
          mov [r10 + 16], rax;
          xor rax, rax;
          mov [r10 + 24], rax;                     // target_ptr = 0

          // Entry 1: slot=10, kind=0x16 (KIND_DMESG), rights=0x01 (RIGHT_READ)
          //   pack = (0x01 << 32) | (0x16 << 16) | 10 = 0x000000010016000A
          mov rax, 0x000000010016000A;
          mov [r10 + 32], rax;
          xor rax, rax;
          mov [r10 + 40], rax;                     // target_ptr = 0

          // init_caps_validate(sidecar, 48) — expect INIT_CAPS_OK (0).
          lea rdi, [rip + _init_caps_witness_sidecar];
          mov rsi, 48;                             // 16 header + 2 * 16 entries
          call init_caps_validate;
          cmp rax, 0;
          jne init_caps_witness_fail;

          // -- Sub-test 1: BAD_COUNT (image_len < 16 header).
          mov rax, 1;
          lea rcx, [rip + _init_caps_witness_stage];
          mov [rcx], rax;

          lea rdi, [rip + _init_caps_witness_sidecar];
          mov rsi, 8;                              // header truncated
          call init_caps_validate;
          mov r10, 0xFFFFFFFF;                     // INIT_CAPS_BAD_COUNT
          cmp rax, r10;
          jne init_caps_witness_fail;

          // -- Sub-test 2: BAD_SLOT (patch entry 0 slot -> 256).
          mov rax, 2;
          lea rcx, [rip + _init_caps_witness_stage];
          mov [rcx], rax;

          // Repack entry 0 word 0 with slot=256:
          //   (0x0B << 32) | (5 << 16) | 256 = 0x0000000B00050100
          lea r10, [rip + _init_caps_witness_sidecar];
          mov rax, 0x0000000B00050100;
          mov [r10 + 16], rax;

          lea rdi, [rip + _init_caps_witness_sidecar];
          mov rsi, 48;
          call init_caps_validate;
          mov r10, 0xFFFFFFFE;                     // INIT_CAPS_BAD_SLOT
          cmp rax, r10;
          jne init_caps_witness_fail;

          // Restore entry 0 for sub-test 3.
          lea r10, [rip + _init_caps_witness_sidecar];
          mov rax, 0x0000000B00050001;
          mov [r10 + 16], rax;

          // -- Sub-test 3: BAD_KIND (patch entry 0 kind -> 17).
          mov rax, 3;
          lea rcx, [rip + _init_caps_witness_stage];
          mov [rcx], rax;

          // Repack entry 0 word 0 with kind=17 (0x11 — not in accept set):
          //   (0x0B << 32) | (0x11 << 16) | 1 = 0x0000000B00110001
          lea r10, [rip + _init_caps_witness_sidecar];
          mov rax, 0x0000000B00110001;
          mov [r10 + 16], rax;

          lea rdi, [rip + _init_caps_witness_sidecar];
          mov rsi, 48;
          call init_caps_validate;
          mov r10, 0xFFFFFFFD;                     // INIT_CAPS_BAD_KIND
          cmp rax, r10;
          jne init_caps_witness_fail;

          // -- Sub-test 4: R31.M2-1597 (#1597) THE WIDENING.
          //    KIND_ACPI (0x20) must now be ACCEPTED.
          //
          //    This is the assertion that #1086 was blocked on. acpi_supervisor
          //    declares a sidecar entry naming 0x20; until #1597 the validator
          //    rejected it with INIT_CAPS_BAD_KIND, which became
          //    LOADER_SEED_FAILED, then ELF_CAP_SEED_FAILED, and
          //    boot_spawn_user_task refused the spawn. The image could not be
          //    loaded at all, so "kill acpi_supervisor mid-evaluation" had no
          //    process to kill.
          mov rax, 4;
          lea rcx, [rip + _init_caps_witness_stage];
          mov [rcx], rax;

          // Repack entry 0 word 0 with kind=0x20 (KIND_ACPI):
          //   (0x0B << 32) | (0x20 << 16) | 1 = 0x0000000B00200001
          lea r10, [rip + _init_caps_witness_sidecar];
          mov rax, 0x0000000B00200001;
          mov [r10 + 16], rax;

          lea rdi, [rip + _init_caps_witness_sidecar];
          mov rsi, 48;
          call init_caps_validate;
          cmp rax, 0;                              // INIT_CAPS_OK
          jne init_caps_witness_fail;

          // -- Sub-test 5: R31.M2-1597 (#1597) THE NARROWING.
          //    KIND_PAGE_TABLE (3) must now be REFUSED.
          //
          //    #1597 was not only a widening. The old gate was
          //    `kind <= 15 || kind == 0x15 || kind == 0x16`, and `<= 15` is
          //    the closed 4-bit BASE enum -- which contains KIND_PROCESS,
          //    KIND_THREAD, KIND_PAGE_TABLE, KIND_PAGE and KIND_SCHED_CTX,
          //    whose descriptors carry a KERNEL POINTER in target_ptr that
          //    nothing on this path validates, supplied by untrusted image
          //    bytes.
          //
          //    Kind 3 is chosen deliberately over the kind=17 case in
          //    sub-test 3: 17 was ALWAYS refused and proves only that the
          //    gate exists. 3 was ACCEPTED before this commit. A witness that
          //    tested only 17 would stay green if the narrowing were reverted.
          mov rax, 5;
          lea rcx, [rip + _init_caps_witness_stage];
          mov [rcx], rax;

          // Repack entry 0 word 0 with kind=3 (KIND_PAGE_TABLE):
          //   (0x0B << 32) | (3 << 16) | 1 = 0x0000000B00030001
          lea r10, [rip + _init_caps_witness_sidecar];
          mov rax, 0x0000000B00030001;
          mov [r10 + 16], rax;

          lea rdi, [rip + _init_caps_witness_sidecar];
          mov rsi, 48;
          call init_caps_validate;
          mov r10, 0xFFFFFFFD;                     // INIT_CAPS_BAD_KIND
          cmp rax, r10;
          jne init_caps_witness_fail;

          // Success marker: R20b INIT CAPS FMT OK.
          mov rdi, 3;                              // LEVEL_INFO
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + init_caps_ok_msg];
          call klog_s1;
          jmp init_caps_witness_done;

      init_caps_witness_fail:
          // Emit "R20b INIT CAPS FMT FAIL" with the sub-test stage
          // as a decimal KV. Falls through into init_caps_witness_done
          // so the boot still proceeds to enter_userland_initial (a
          // broken format-validator surfaces via the FAIL fingerprint
          // but does not halt the boot).
          lea rax, [rip + _init_caps_witness_stage];
          mov r8, [rax];                           // r8 = stage (u64)
          mov rdi, 1;                              // LEVEL_ERROR
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + init_caps_fail_msg];
          lea rcx, [rip + k_line];                 // reuse "line" key
          call klog_s1_d1;

      init_caps_witness_done:

      // ============================================================
      // R20b.M4-002 (#1562): loader_seed_caps hook witness — closes M4.
      //
      // Exercises loader_seed_caps (src/kernel/core/loader/seed_caps.pdx)
      // — the caller that binds init_caps_validate (M4-001) to
      // cap_mint_write (cap/mint.pdx). Synthesizes a fake task struct
      // + a 1-entry sidecar directly in .bss (bypasses ELF walking;
      // the elf_lite_load wire-in itself uses the empty
      // _loader_seed_empty_sidecar).
      //
      // Sub-tests (numeric stage tracked in _loader_seed_witness_stage;
      // any failure jumps to loader_seed_witness_fail with the stage):
      //
      //   0. ACCEPT path — 1-entry sidecar:
      //        slot   = 5
      //        kind   = KIND_TIMER (8)
      //        rights = RIGHT_INVOKE (0x08)
      //        target_ptr = 0
      //      Call loader_seed_caps(fake_task, sidecar, 32). Expect
      //      LOADER_SEED_OK (0). Read back cap_table[5] and assert
      //      kind == 8, rights == 0x08, target_ptr == 0.
      //
      //   1. REJECT path — malformed count (0xFFFF too large):
      //      Patch sidecar header word 0 to count=0xFFFF. Call
      //      loader_seed_caps(fake_task, sidecar, 32). Expect
      //      LOADER_SEED_FAILED (0xFFFFFFF9). Verify cap_table[5]
      //      remained unchanged from sub-test 0 (kind still == 8) —
      //      proves fail-fast: no partial mint occurred.
      //
      // Slot 5 chosen distinct from every existing witness slot:
      //   0=cap_smoke, 1..8=cap_dispatch_smoke, 10=dmesg_cap_witness,
      //   11=endpoint_cap_witness. Slot 5 is clean.
      //
      // Placement: AFTER init_caps_witness_done (M4-001 close) and
      // BEFORE sti (still safe kernel state, no ISR racing). Uses
      // caller-save scratch only so r12/r13/r14 (init boot state)
      // stay live for the enter_userland_initial call below.
      //
      // Register discipline: loader_seed_caps + klog_s1 both preserve
      // SysV callee-save regs (r12-r15). Uses rax/rcx/rdx/rdi/rsi/r8
      // (caller-save) as scratch; r15 untouched.
      // ============================================================
      loader_seed_witness:
          // -- Sub-test 0: ACCEPT path.
          xor rax, rax;
          lea rcx, [rip + _loader_seed_witness_stage];
          mov [rcx], rax;                          // stage = 0

          // Populate sidecar. 4 u64s = 32 bytes = 16 header + 1 entry.
          // Header: count=1 in low 16 bits of word 0; word 1 padding.
          lea r10, [rip + _loader_seed_witness_sidecar];
          mov rax, 1;                              // count = 1
          mov [r10 + 0], rax;                      // header word 0
          xor rax, rax;
          mov [r10 + 8], rax;                      // header word 1 (padding)

          // Entry 0: slot=5, kind=0x16 (KIND_DMESG), rights=0x01 (RIGHT_READ)
          //   pack = (0x01 << 32) | (0x16 << 16) | 5 = 0x0000000100160005
          //
          // R31.M2-1597 (#1597): this entry named KIND_TIMER (8) until the
          // loader-seedable set was narrowed off the kernel-object base
          // kinds. It was retired to KIND_DMESG -- a kind that IS seedable,
          // and one this witness's sibling (init_caps_witness) already uses
          // -- rather than the set being widened to keep the fixture green.
          // Sub-test 2 below then asserts that KIND_TIMER is REFUSED, so the
          // change is a gain in coverage rather than an accommodation.
          mov rax, 0x0000000100160005;
          mov [r10 + 16], rax;
          xor rax, rax;
          mov [r10 + 24], rax;                     // target_ptr = 0

          // loader_seed_caps(fake_task, sidecar, 32).
          //   task_ptr unused at R20b — pass address of fake TCB blob
          //   so a per-task-cap_table forward-port sees a live pointer
          //   (rather than 0) in the witness log if it lands later.
          lea rdi, [rip + _loader_seed_witness_fake_task];
          lea rsi, [rip + _loader_seed_witness_sidecar];
          mov rdx, 32;                             // 16 header + 1 * 16 entry
          call loader_seed_caps;
          cmp rax, 0;                              // LOADER_SEED_OK
          jne loader_seed_witness_fail;

          // Read-back: cap_table[5] descriptor at base + 5*24 = +120.
          // Layout: [+0]=kind, [+8]=rights, [+16]=target_ptr.
          mov rax, cap_table;
          add rax, 120;                            // slot 5 * 24 bytes
          mov rcx, [rax + 0];                      // kind
          cmp rcx, 0x16;                           // KIND_DMESG
          jne loader_seed_witness_fail;
          mov rcx, [rax + 8];                      // rights
          cmp rcx, 0x01;                           // RIGHT_READ
          jne loader_seed_witness_fail;
          mov rcx, [rax + 16];                     // target_ptr
          cmp rcx, 0;
          jne loader_seed_witness_fail;

          // -- Sub-test 1: REJECT path (BAD_COUNT via count=0xFFFF).
          mov rax, 1;
          lea rcx, [rip + _loader_seed_witness_stage];
          mov [rcx], rax;                          // stage = 1

          // Patch header word 0 to count=0xFFFF: 0xFFFF entries would
          // need 16 + 0xFFFF*16 = 0xFFFF0 bytes >> sidecar_len=32.
          // init_caps_validate's array-bounds gate returns
          // INIT_CAPS_BAD_COUNT -> loader_seed_caps returns
          // LOADER_SEED_FAILED. No cap_mint_write executes.
          lea r10, [rip + _loader_seed_witness_sidecar];
          mov rax, 0xFFFF;
          mov [r10 + 0], rax;

          lea rdi, [rip + _loader_seed_witness_fake_task];
          lea rsi, [rip + _loader_seed_witness_sidecar];
          mov rdx, 32;
          call loader_seed_caps;
          mov r10, 0xFFFFFFF9;                     // LOADER_SEED_FAILED
          cmp rax, r10;
          jne loader_seed_witness_fail;

          // Fail-fast invariant: cap_table[5] must still hold sub-test
          // 0's descriptor (kind=8). If sub-test 1 had partially minted
          // before failing, kind would be overwritten (or cleared to 0
          // by a KIND_NULL rewrite path). Sub-test 1's REJECT path
          // never reaches cap_mint_write, so kind stays 8.
          mov rax, cap_table;
          add rax, 120;
          mov rcx, [rax + 0];
          cmp rcx, 0x16;                           // KIND_DMESG, unchanged
          jne loader_seed_witness_fail;

          // -- Sub-test 2: R31.M2-1597 (#1597) an UN-SEEDABLE kind is refused
          //    at the MINT layer, not merely at the format layer.
          //
          // init_caps_witness sub-test 5 proves init_caps_validate refuses
          // KIND_PAGE_TABLE. This proves the refusal survives the delegation
          // -- that loader_seed_caps propagates it as LOADER_SEED_FAILED and,
          // critically, that it mints NOTHING on the way to failing.
          //
          // KIND_TIMER (8) is used because this witness's own sub-test 0
          // seeded exactly that kind until #1597, so the case being refused
          // here is a case that USED TO SUCCEED at this very call site.
          mov rax, 2;
          lea rcx, [rip + _loader_seed_witness_stage];
          mov [rcx], rax;                          // stage = 2

          // Restore a well-formed header (sub-test 1 left count = 0xFFFF)
          // and repack entry 0 as slot=5, kind=8 (KIND_TIMER), rights=0x08:
          //   (0x08 << 32) | (8 << 16) | 5 = 0x0000000800080005
          lea r10, [rip + _loader_seed_witness_sidecar];
          mov rax, 1;
          mov [r10 + 0], rax;
          mov rax, 0x0000000800080005;
          mov [r10 + 16], rax;

          lea rdi, [rip + _loader_seed_witness_fake_task];
          lea rsi, [rip + _loader_seed_witness_sidecar];
          mov rdx, 32;
          call loader_seed_caps;
          mov r10, 0xFFFFFFF9;                     // LOADER_SEED_FAILED
          cmp rax, r10;
          jne loader_seed_witness_fail;

          // NOTHING WAS MINTED. cap_table[5] must still carry sub-test 0's
          // KIND_DMESG descriptor. Had the refusal happened after the mint
          // rather than before it, this slot would now read KIND_TIMER --
          // which is the difference between a validator and a regret.
          mov rax, cap_table;
          add rax, 120;
          mov rcx, [rax + 0];
          cmp rcx, 0x16;                           // KIND_DMESG, unchanged
          jne loader_seed_witness_fail;

          // Success marker: R20b LOADER SEED OK.
          mov rdi, 3;                              // LEVEL_INFO
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + loader_seed_ok_msg];
          call klog_s1;
          jmp loader_seed_witness_done;

      loader_seed_witness_fail:
          // Emit "R20b LOADER SEED FAIL" with the sub-test stage
          // as a decimal KV. Falls through into loader_seed_witness_done
          // so the boot still proceeds to enter_userland_initial (a
          // broken seed hook surfaces via the FAIL fingerprint but
          // does not halt the boot). Matches the init_caps_witness_fail
          // idiom immediately above.
          lea rax, [rip + _loader_seed_witness_stage];
          mov r8, [rax];                           // r8 = stage (u64)
          mov rdi, 1;                              // LEVEL_ERROR
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + loader_seed_fail_msg];
          lea rcx, [rip + k_line];                 // reuse "line" key
          call klog_s1_d1;

      loader_seed_witness_done:

      // ============================================================
      // R20b.M6-001 (#1564): loader phase-2 ELF-symbol walker witness.
      //
      // Retires the M4-002 (#1562) deferral by driving a REAL
      // elf_lite_load call against echo_server.elf — the only image
      // currently embedded that declares an `_init_caps` /
      // `_init_caps_count` sidecar (src/user/echo_server.pdx §_init_caps
      // sidecar) — and asserting the walker resolved the two symbols,
      // colocated them into loader_seed_caps_from_symtab's sidecar
      // scratch, and delegated to loader_seed_caps for the mint.
      //
      // Sub-tests 0..6 (numeric stage tracked in _m6_symtab_witness_stage;
      // any failure jumps to m6_symtab_witness_fail with the stage):
      //
      //   0. task_new(NULL) -> fresh task slab (spilled to
      //      _m6_symtab_witness_task .bss so r12/r13/r14 stay live for
      //      the downstream m5_echo_witness + enter_userland_initial).
      //   1. Pre-clean cap_table[0] (kind=0/rights=0/target=0) so a
      //      broken walker (that would fail to mint) is distinguishable
      //      from a working walker (that mints kind=5). Without the
      //      pre-clean, cap_smoke's kind=15 (already in slot 0 from B5-005
      //      boot) would be indistinguishable from a no-op walker
      //      followed by a KIND_IPC_ENDPOINT read of the wrong bytes.
      //   2. elf_lite_load(fresh_pml4, _echo_server_bin_start,
      //      _echo_server_bin_end - _echo_server_bin_start) -> ELF_OK (0).
      //      This EXERCISES the new elf_load_done -> loader_seed_caps_from_symtab
      //      wire-in for the first time in the boot chain (init.elf was
      //      loaded earlier by init_bootstrap and hits the "no _init_caps"
      //      no-mint branch since init declares no sidecar).
      //   3. Assert cap_table[0].kind == 5 (KIND_IPC_ENDPOINT per
      //      cap/kind.pdx). Proves the walker resolved _init_caps,
      //      colocated correctly, and loader_seed_caps ran cap_mint_write.
      //   4. Assert cap_table[0].rights == 0x0B (R_IPC_ALL = READ|WRITE|
      //      INVOKE per kind_endpoint.pdx and echo_server.pdx L72). Proves
      //      the rights field survived the colocate memcpy at the right
      //      byte offset (+4 within the entry, +20 within the scratch).
      //   5. Assert cap_table[0].target_ptr == 0x20001. Proves the u64
      //      target survived at entry+8 / scratch+24, natural alignment.
      //      Value = endpoint_id 1 (bits 0..15) | direction BIDI 2
      //      (bits 16..17) per echo_server.pdx L76-88 packing.
      //
      // Design context
      // --------------
      // Placement: AFTER loader_seed_witness_done (M4-002 close, verifies
      // the loader_seed_caps primitive in isolation) and BEFORE
      // m5_echo_witness (which does its own svc_lookup mint into
      // cap_table). If this witness didn't mint into slot 0, the M5
      // witness's free-slot scan would pick slot 0 for its svc.echo cap;
      // WITH this witness landed, cap_table[0] holds echo_server's
      // seeded endpoint cap and M5's svc_lookup skips to slot 1. Both
      // ordering shapes are OK by construction: M5's witness only
      // checks `slot_id < 256` (kernel_main.pdx §m5_echo_witness §sub-test 2),
      // not a specific slot number, so a shifted allocation still passes.
      //
      // Task teardown
      // -------------
      // The fresh task is intentionally NOT enqueued: no runq_enqueue
      // call, and the task slab holder is scoped to .bss dead storage
      // (_m6_symtab_witness_task). sched_pick_next_r15 therefore cannot
      // return this task; the aspace it holds is inert until the R21+
      // task recycler lands. Same "witness allocates but never schedules"
      // discipline as init_bootstrap_witness's r12 slab (before init is
      // explicitly enqueued at kernel_main.pdx L10373).
      //
      // Register discipline
      // -------------------
      // r12/r13/r14 MUST stay untouched (init boot state; see
      // m5_echo_witness's §Register discipline comment at kernel_main.pdx
      // §12122). All uses of "task slab" go via the .bss holder rather
      // than a callee-save register. Nested calls (task_new, elf_lite_load,
      // klog_s1) all preserve r12-r15 + rbx per SysV; caller-save
      // scratch (rax/rcx/rdx/rdi/rsi/r8/r10) is fair game.
      //
      // rsp alignment: entry to m6_symtab_witness is at rsp %16 == 8
      // (SysV entry state; outer prologue's 3 pushes were popped at
      // ipc_bounce_witness_done). Nested `call`s from here therefore
      // land in their callees at rsp %16 == 8 -> aligned.
      // ============================================================
      m6_symtab_witness:
          // -- Sub-test 0: task_new(NULL) — fresh task slab.
          xor rax, rax;
          lea rcx, [rip + _m6_symtab_witness_stage];
          mov [rcx], rax;                          // stage = 0

          xor rdi, rdi;                            // parent = NULL
          call task_new;
          cmp rax, 0;
          je m6_symtab_witness_fail;
          // Spill fresh task slab to .bss (r12/r13/r14 must stay = init
          // state — see §Register discipline above).
          lea rcx, [rip + _m6_symtab_witness_task];
          mov [rcx], rax;

          // -- Sub-test 1: pre-clean cap_table[2] (kind/rights/target = 0).
          //
          // R31.M2-1596 (#1596): SLOT 2, not slot 0. echo_server.pdx's
          // sidecar now names slot 2, because every sidecar-carrying image
          // in this tree named slot 0 and one global cap_table meant they
          // silently overwrote each other. See
          // design/capabilities/loader-seeded-slot-allocation.md.
          //
          // This witness asserted slot 0 and therefore failed at sub-test 3
          // the moment the allocation changed -- and its FAILURE PATH SKIPS
          // THE task_free CLEANUP BELOW, which left a live task permanently
          // owning slot 2 and made the real echo_server spawn refuse with
          // LOADER_SEED_SLOT_TAKEN several thousand lines later. That
          // cascade is worth recording: the refusal #1596 added did not
          // merely restate a known collision, it found an unrelated one
          // between a witness fixture and a real task that had been
          // invisible for as long as the overwrite was silent.
          mov rax, 1;
          lea rcx, [rip + _m6_symtab_witness_stage];
          mov [rcx], rax;

          mov rax, cap_table;
          add rax, 48;                             // slot 2 * 24 bytes
          xor rcx, rcx;
          mov [rax + 0], rcx;                      // kind = 0
          mov [rax + 8], rcx;                      // rights = 0
          mov [rax + 16], rcx;                     // target_ptr = 0

          // -- Sub-test 2: elf_lite_load(fresh_pml4, echo_server.elf).
          mov rax, 2;
          lea rcx, [rip + _m6_symtab_witness_stage];
          mov [rcx], rax;

          lea rcx, [rip + _m6_symtab_witness_task];
          mov rcx, [rcx];                          // rcx = fresh task slab
          mov rdi, [rcx + 16];                     // rdi = user_pml4_pa (VA form)
          lea rsi, [rip + _echo_server_bin_start];
          lea rax, [rip + _echo_server_bin_end];
          sub rax, rsi;
          mov rdx, rax;                            // rdx = image_len
          // R31.M2-1590 (#1590): pass the fresh task as owner_task. Before
          // #1590 this was implicitly 0 and sub-test 6 below could not have
          // been written — cap_owner[0] was CAP_OWNER_NONE after every real
          // image load, and nothing noticed.
          call elf_lite_load;
          cmp rax, 0;                              // ELF_OK
          jne m6_symtab_witness_fail;

          // -- Sub-test 3: assert cap_table[2].kind == 5 (KIND_IPC_ENDPOINT).
          mov rax, 3;
          lea rcx, [rip + _m6_symtab_witness_stage];
          mov [rcx], rax;

          mov rax, cap_table;
          add rax, 48;                             // slot 2 base (#1596)
          mov rcx, [rax + 0];                      // kind (u64 @+0)
          cmp rcx, 5;                              // KIND_IPC_ENDPOINT
          jne m6_symtab_witness_fail;

          // -- Sub-test 4: assert cap_table[2].rights == 0x0B (R_IPC_ALL).
          mov rax, 4;
          lea rcx, [rip + _m6_symtab_witness_stage];
          mov [rcx], rax;

          mov rax, cap_table;
          add rax, 48;                             // slot 2 (#1596)
          mov rcx, [rax + 8];                      // rights (u64 @+8)
          cmp rcx, 0x0B;                           // R_IPC_ALL
          jne m6_symtab_witness_fail;

          // -- Sub-test 5: assert cap_table[2].target_ptr == 0x20001.
          mov rax, 5;
          lea rcx, [rip + _m6_symtab_witness_stage];
          mov [rcx], rax;

          mov rax, cap_table;
          add rax, 48;                             // slot 2 (#1596)
          mov rcx, [rax + 16];                     // target_ptr (u64 @+16)
          mov r10, 0x20001;                        // endpoint_id 1 | dir BIDI (2)
          cmp rcx, r10;
          jne m6_symtab_witness_fail;

          // -- Sub-test 6 (R31.M2-1590 / #1590): assert the seeded cap was
          //    CLAIMED for the loading task, not merely minted.
          //
          //    This is the unit-level half of #1590's central invariant.
          //    Sub-tests 3..5 prove the descriptor bytes arrived; they say
          //    nothing about whose capability it is. Before #1590,
          //    elf_lite_load passed a constant 0 owner and cap_owner[0] was
          //    CAP_OWNER_NONE here — a value cap_owner_sweep_revoke refuses
          //    to match by construction (it returns 0 before reading a
          //    single slot when the packed key is 0). So the leak was not
          //    "the sweep missed it"; the sweep could not have found it, and
          //    would have reported success either way.
          //
          //    Expected value: cap_owner_pack(task->pid, pid_gen_read(pid)),
          //    computed here from the same two primitives rather than from a
          //    literal, so a change to the packing shape moves both sides
          //    together and this assertion keeps meaning what it says.
          //    Every callee-save register here belongs to init's boot state,
          //    and rax/rcx/r8-r11 do not survive a nested call, so the
          //    observed key is spilled to .bss between the two calls rather
          //    than parked in a register.
          mov rax, 6;
          lea rcx, [rip + _m6_symtab_witness_stage];
          mov [rcx], rax;

          mov rdi, 2;                              // slot 2 (#1596)
          call cap_owner_get;                      // rax = cap_owner[2]
          lea rcx, [rip + _m6_symtab_witness_owner];
          mov [rcx], rax;                          // spill observed key

          lea rax, [rip + _m6_symtab_witness_task];
          mov rax, [rax];
          xor rcx, rcx;
          mov ecx, [rax + 0];                      // task->pid (u32 zero-ext)
          lea rax, [rip + _m6_symtab_witness_pid];
          mov [rax], rcx;                          // spill pid
          mov rdi, rcx;
          call pid_gen_read;                       // rax = generation
          cmp rax, 0;
          je m6_symtab_witness_fail;               // a live task must have a gen

          mov rsi, rax;                            // rsi = generation
          lea rax, [rip + _m6_symtab_witness_pid];
          mov rdi, [rax];                          // rdi = pid
          call cap_owner_pack;                     // rax = expected key
          cmp rax, 0;
          je m6_symtab_witness_fail;               // pack must not refuse

          lea rcx, [rip + _m6_symtab_witness_owner];
          mov rcx, [rcx];                          // observed
          cmp rcx, rax;
          jne m6_symtab_witness_fail;

          // -- Cleanup: task_free(fresh_task) — release the pid slot,
          //    tear down the aspace, zero the slab. Without this, init's
          //    first fork picks up the NEXT free PID (== 3 instead of the
          //    expected 2), which the boot_r17_shell_* fingerprints assert
          //    against. Same discipline as sys_wait_body's pid_free after
          //    reaping a zombie: the task never runs, but its PID slot
          //    stays allocated until explicitly freed, contaminating the
          //    dense-low-first pid_alloc scan for every subsequent
          //    task_new. task_free (task_pool.pdx §task_free) is the
          //    thorough teardown primitive: aspace_teardown -> rep stosq
          //    slab-zero -> pid_free(pid). We ignore its rax (always 0
          //    at R15.M5).
          //    R31.M2-1596 (#1596) / R31.M2-1599 (#1599): THE SWEEP MOVED
          //    INTO task_free, AND THIS LOCAL COPY IS GONE.
          //
          //    #1596 landed a sweep-then-free HERE, as a patch: this
          //    witness claims cap_owner[2] for its synthetic task, and if
          //    that claim outlived the task then the real echo_server spawn
          //    -- which wants the same slot -- was refused with
          //    LOADER_SEED_SLOT_TAKEN thousands of lines later. The note
          //    that shipped with it said the general question (task_free is
          //    also boot_spawn's failure-teardown path) was filed
          //    separately. That is #1599, and it is fixed: task_free now
          //    reads the generation and sweeps the owner column itself,
          //    before aspace_teardown, exactly as a real death does.
          //
          //    So the local copy is reverted rather than kept alongside.
          //    Keeping both would leave a second sweep that is harmless
          //    (the sweep is idempotent -- the column is cleared on every
          //    matched slot, so the second pass matches zero and emits no
          //    audit record) but that would also mean this witness passes
          //    whether or not task_free does its job. A witness that
          //    survives the removal of the mechanism it depends on is the
          //    class of defect #1577/#1578/#1585/#1592 are all instances
          //    of. The cleanup is now the general primitive's, and this
          //    witness -- like boot_spawn's failure path -- depends on it.
          lea rax, [rip + _m6_symtab_witness_task];
          mov rdi, [rax];
          call task_free;

          // Success marker: R20b LOADER SYMTAB SEED OK.
          mov rdi, 3;                              // LEVEL_INFO
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + loader_symtab_seed_ok_msg];
          call klog_s1;
          jmp m6_symtab_witness_done;

      m6_symtab_witness_fail:
          // Emit "R20b LOADER SYMTAB SEED FAIL line=<stage>" — same
          // fingerprint idiom as loader_seed_witness_fail (M4-002)
          // and m5_echo_witness_fail (M5-001) directly below.
          lea rax, [rip + _m6_symtab_witness_stage];
          mov r8, [rax];                           // r8 = stage
          mov rdi, 1;                              // LEVEL_ERROR
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + loader_symtab_seed_fail_msg];
          lea rcx, [rip + k_line];                 // reuse "line" key
          call klog_s1_d1;

      m6_symtab_witness_done:


      pop rbp;
      ret
    }
  }

  // -------------------------------------------------------------------------
  // Witness storage
  //
  // These declarations came out of kernel_main.pdx alongside the code
  // above.  Each moved only because this module is the ONLY file in the
  // tree that references it in code; storage read by the exception
  // handlers, by tests, by boot_stub.S, or by a second witness module
  // has no single owner and stayed behind.
  //
  // Declaration ORDER is preserved from kernel_main.pdx.  Several of
  // these witnesses write past the end of one buffer into the next on
  // purpose (the deliberately-511-u64 payload patterns), so relative
  // placement inside a single object is not a formatting question.
  // -------------------------------------------------------------------------

  // R20b.M4-001 (#1561): InitCap sidecar format + validator witness storage.
  //
  // _init_caps_witness_sidecar: 48-byte scratch backing the synthesized
  //   sidecar blob. Layout follows design/loader/init-caps-sidecar.md §3
  //   — 16 header (count in low 16 bits of word 0 + 14 bytes padding)
  //   + 2 * 16 InitCap entries. Sized as [u64; 6] @align(8) since paideia-as
  //   ships every InitCap store as an aligned qword. Lives in .bss (uninit);
  //   the witness's sub-test 0 fills every word before any validate call,
  //   so any read-before-populate would surface as an entry-shape mismatch,
  //   not a UB read of stale bytes.
  pub let mut _init_caps_witness_sidecar : [u64; 6] = uninit @align(8)

  // _init_caps_witness_stage: 0..3 sub-test index; written before every
  //   sub-test so a fail exit prints which one tripped via the
  //   init_caps_fail_msg + line KV. Matches the sys_svc_lookup_witness_stage
  //   idiom immediately above.
  pub let mut _init_caps_witness_stage : u64 = 0

  // R20b.M6-001 (#1564): loader phase-2 ELF-symbol walker witness storage.
  //
  // _m6_symtab_witness_task: 8-byte (1 u64) holder for the fresh task
  //   slab returned by task_new(NULL). Lives in .bss (uninit); the
  //   witness's sub-test 0 populates it before any elf_lite_load call.
  //   Spilled to .bss (rather than held in r12) because r12/r13/r14
  //   already carry init boot state (init task_slab / entry_rip /
  //   user_rsp_top) that the downstream m5_echo_witness +
  //   enter_userland_initial call chain relies on; a scratch reg holder
  //   would clobber that state. The task slab is not enqueued (no
  //   runq_enqueue call in the M6 witness), so sched_pick_next_r15
  //   cannot return it; the aspace it holds is inert until the R21+
  //   task recycler lands. Matches the "witness allocates but never
  //   schedules" discipline of init_bootstrap's r12 slab (pre-runq_enqueue).
  //
  // _m6_symtab_witness_stage: 0..6 sub-test index; written before every
  //   sub-test so a fail exit prints which one tripped via the
  //   loader_symtab_seed_fail_msg + line KV. Matches the
  //   _loader_seed_witness_stage / _m5_echo_witness_stage idiom above.
  pub let mut _m6_symtab_witness_task  : [u64; 1] = uninit @align(8)
  pub let mut _m6_symtab_witness_stage : u64 = 0

  // R31.M2-1590 (#1590): sub-test 6 spills. The observed cap_owner[0] key
  // and the loading task's pid have to survive nested calls (pid_gen_read,
  // cap_owner_pack) while every callee-save register is committed to init's
  // boot state — see the §Register discipline note on m6_symtab_witness.
  pub let mut _m6_symtab_witness_owner : u64 = 0
  pub let mut _m6_symtab_witness_pid   : u64 = 0
}
