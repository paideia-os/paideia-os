          mov  r12, rax                             // r12 = image_len
          xor  r13, r13                             // r13 = offset

          // ---------- Step 5: write in single-page (<=4096-byte) chunks ----------
      bs_dmesg_seed_write_loop:
          cmp  r13, r12
          jae  bs_dmesg_seed_write_done            // offset >= image_len

          // chunk_len = min(4096, image_len - offset)
          mov  rax, r12
          sub  rax, r13                             // rax = remaining
          mov  rcx, 4096
          cmp  rax, rcx
          jbe  bs_dmesg_seed_chunk_ok
          mov  rax, rcx                             // clamp to 4096
      bs_dmesg_seed_chunk_ok:

          // tmpfs_write(inode_idx=r14, buf=r15+r13, len=rax, offset=r13)
          mov  rdi, r14                             // arg0 = dmesg_inode_idx
          mov  rsi, r15
          add  rsi, r13                             // arg1 = image_base + offset
          mov  rdx, rax                             // arg2 = chunk_len
          mov  rcx, r13                             // arg3 = offset
          call tmpfs_write                          // rax = bytes_written or sentinel

          mov  rcx, 0xFFFFFFFFFFFFFFFF
          cmp  rax, rcx
          je   bs_dmesg_seed_fail

          add  r13, rax                             // offset += bytes_written
          jmp  bs_dmesg_seed_write_loop

      bs_dmesg_seed_write_done:
          // klog_s1_d1(LEVEL_INFO=3, SUBSYS_BOOT, bin_dmesg_seed_ok_msg,
          // k_bytes, image_len=r12) -> "bin seed ok -- file=/bin/dmesg bytes=<N>"
          mov  rdi, 3;
          lea  rsi, [rip + SUBSYS_BOOT];
          lea  rdx, [rip + bin_dmesg_seed_ok_msg];
          lea  rcx, [rip + k_bytes];
          mov  r8, r12;                             // r8 = image_len (bytes written)
          call klog_s1_d1;
          jmp  bs_dmesg_seed_done

      bs_dmesg_seed_fail:
          mov  rdi, 1;                              // LEVEL_ERROR
          lea  rsi, [rip + SUBSYS_BOOT];
          lea  rdx, [rip + bin_dmesg_seed_fail_msg];
          call klog_s1;

      bs_dmesg_seed_done:


      pop rbp;
      ret
    }
  }
}
