// src/kernel/boot/witness/bin_seeds.pdx — boot witness module
//
// Extracted verbatim from src/kernel/boot/kernel_main.pdx (which had grown
// to 24,315 lines in two functions).  tmpfs seed block — /bin/child_hello, /bin/sh and /bin/true are written into tmpfs here.
//
// -----------------------------------------------------------------------------
// Why the body is copied and not rewritten
// -----------------------------------------------------------------------------
//
// The goldens for this tree assert an ORDERED SUBSEQUENCE of fingerprints
// across 14 boot modes, and a witness that silently stops running still
// leaves most of that subsequence intact.  The extraction therefore moves
// the instruction stream unchanged: the only bytes this module adds around
// it are the `push rbp` / `pop rbp` / `ret` below.
//
// -----------------------------------------------------------------------------
// The push is not decoration
// -----------------------------------------------------------------------------
//
// `boot_continue_after_ring3` runs its body at `rsp % 16 == 8` — it sits two `call` levels
// below `_start`, and paideia-as emits no frame prologue for an
// `unsafe`-bodied lambda (emit_visit_lambda.rs suppresses the prologue for
// Unsafe bodies, which is also why `no-frame` is a no-op there).  Several
// witnesses in this file reason explicitly about that parity — "3 pushes from %16==8
// yields (8+3*8)%16 == 0" — and a bare `call` into a bare body would enter
// at `%16 == 0` and invert every one of those arguments.  The single
// `push rbp` restores the inline parity exactly; the matching `pop rbp`
// keeps rbp's SysV guarantee for the caller.
//
// Sections in this module, in the order boot_continue_after_ring3 ran them:
//   * R17-M0-730 D10a (#730): /bin/child_hello tmpfs seed.
//   * R17-M5-636 partial (paideia-os #636): /bin/sh tmpfs seed.
//   * R17.M5 #638 (paideia-os): /bin/true tmpfs seed.
//   * R48-PREP-005.M2: /bin/elevate_broker_daemon tmpfs seed.
//   * R61.M1-002 (#1821): /bin/{ls,cat,ps,rm,mv,cp,mkdir,touch,dmesg}
//     tmpfs seeds (nine R57/R58/R60 tool ELFs, in that order), each
//     fingerprinted per R61.M1-003 (#1822) via klog_s1_d1.

module BinSeeds = structure {

  // witness_bin_seeds() — the tmpfs seed block — /bin/child_hello, /bin/sh and /bin/true are written into tmpfs here.
  //
  // Effect and capability rows are the ones the enclosing
  // `boot_continue_after_ring3` declares.  They are not widened here: this
  // is the same instruction stream under a new symbol, so the authority it
  // needs is by construction the authority it already had.
  pub let witness_bin_seeds : () -> () !{sysreg} @{} = fn () -> unsafe {
    effects: { sysreg },
    capabilities: { boot },
    justification: "Boot witness block lifted verbatim out of kernel_main.pdx's boot_continue_after_ring3 during the bin_seeds extraction. Body bytes are unchanged from the inline form; the only additions are the entry `push rbp` and the exit `pop rbp; ret`. The push is load-bearing rather than cosmetic: boot_continue_after_ring3 executes its body at rsp%16 == 8 (two `call` levels below _start, with no frame prologue emitted for unsafe-bodied lambdas), and the witnesses inside this module compute their own nested-call alignment from that parity. Entering through a `call` without the compensating push would present rsp%16 == 0 to the body and silently invert every such argument — the failure mode of paideia-os #1192, #1195 and #1584. Effects and capabilities are copied unchanged from the enclosing function for the same reason: no authority is added, so none needs justifying beyond what boot_continue_after_ring3 already justified.",
    block: {
      push rbp;

      // ============================================================
      // R17-M0-730 D10a (#730): /bin/child_hello tmpfs seed.
      //
      // Creates /bin as a directory child of the tmpfs root, then
      // creates /bin/child_hello as a REG file inside /bin, then
      // writes the embedded child_hello.elf bytes (from
      // _child_hello_bin_start.._child_hello_bin_end, established by
      // tools/userbin_embed.S per R15-M6-009 / #560) into the file
      // using page-sized tmpfs_write chunks (tmpfs_write is single-
      // page constrained per tmpfs/write.pdx §4.5).
      //
      // Enables init's execve("/bin/child_hello") to actually resolve
      // via vfs_open → path_resolve → tmpfs_lookup and load the ELF.
      // Before D10a, /bin/child_hello did not exist and sys_execve_shim
      // returned -ENOENT to init, which fell through to init_error and
      // printed a second "INIT OK" then sys_exit(0) — never the AC line.
      //
      // Vnode-pool wiring pattern — R17-M5-754 (paideia-os #754) fix.
      //
      // ORIGINAL (buggy) pattern per #587's sys_open witness
      // (kernel_main L4237-4245): tmpfs_create returned a fresh tmpfs
      // inode idx; the seed wrote ops_ptr = &_tmpfs_vops and
      // backend_ptr = inode_idx directly into `_vnode_pool[inode_idx]`
      // via `vnode_slot(inode_idx)`. This CONFLATED two disjoint index
      // spaces (tmpfs inode idx from `tmpfs_inode_alloc`'s bitmap over
      // `_tmpfs_inode_pool`, vs vnode-pool idx from `vnode_alloc`'s
      // bitmap over `_vnode_pool`), silently CLOBBERING any vnode-pool
      // slot at the same numeric index. Wave-3 debug of #754 caught
      // `_tty0` (a `vnode_alloc`'d chrdev at vnode-pool idx 6) being
      // overwritten by `bin_sh_seed`'s write at `vnode_slot(sh_inode_idx=6)`,
      // which retargeted every shell `sys_read(fd=0)` through
      // `_tmpfs_read_adapter` on the wrong backend.
      //
      // FIXED pattern (this commit): use the canonical
      // `vnode_cache_or_alloc(parent_vn_idx, backend_inode_idx,
      // &_tmpfs_vops)` helper from `core/fs/vnode_pool.pdx:164` (added
      // by #665 Phase 1 as the sanctioned dedup+alloc helper for
      // exactly this bind-backend-to-vnode operation). Returns a
      // FRESH vnode-pool slot, wired with the correct fields — never
      // aliases an unrelated allocator's slot. Same pattern used by
      // `vfs_open.pdx:204` Step 7 (the reference application).
      //
      // Register plan:
      //   r12 = root_inode_idx (=1) for step 2's tmpfs_create; then
      //         bin_vn_idx (from vnode_cache_or_alloc at step 3) held
      //         across step 4's nested tmpfs_create call so step 5's
      //         vnode_cache_or_alloc has bin_vn_idx as its parent arg;
      //         then image_len (step 6+, matches original)
      //   r13 = bin_inode_idx (steps 2-4 as tmpfs dir_idx for
      //         child_hello); repurposed to `offset` at step 6+
      //   r14 = child_hello_inode_idx (steps 4-end)
      //   r15 = root_vn_idx (from mount_root_vnode at step 1, held
      //         across step 3's vnode_cache_or_alloc as parent arg;
      //         DEAD after step 3); repurposed to _child_hello_bin_start
      //         at step 6+ (matches original, since r15 was unused in
      //         steps 1-5 originally)
      //
      // See design/kernel/r17-m0-730-d10-execve-complete.md §D10a and
      // design/kernel/r17-m0-665-vnode-conflation-fix.md.
      // ============================================================
      bin_child_hello_seed:
          // ---------- Step 1: recover + wire root vnode ----------
          // mount_root_vnode returns the ROOT VNODE idx (a real
          // vnode-pool idx from vnode_alloc during mount, NOT a tmpfs
          // INODE idx). Calling vnode_slot on it is CORRECT usage
          // (this is NOT the flawed pattern fixed at steps 3/5).
          // The subsequent ops_ptr/backend_ptr writes are redundant
          // with mount()'s own Phase 3 wire (#665) via
          // backend_registry, but idempotent (writing the same values)
          // and preserved as belt+suspenders per Phase 3 landing note.
          //
          // r15 = saved root_vn_idx across step 3's
          // vnode_cache_or_alloc call (needed as its parent_idx arg).
          call mount_root_vnode
          cmp rax, 0
          je bin_child_hello_seed_fail
          mov r15, rax                             // r15 = root_vn_idx (saved for step 3)
          mov rdi, rax                             // rdi = root_vnode_idx
          call vnode_slot                          // rax = &vnode[root_vn]
          lea rcx, [rip + _tmpfs_vops]
          mov [rax + 24], rcx                      // ops_ptr = &_tmpfs_vops
          mov rcx, 1                               // TMPFS_INODE_IDX_ROOT
          mov [rax + 32], rcx                      // backend_ptr = root INODE idx

          // r12 tracks root INODE idx (= 1) for the tmpfs_create call below.
          // Kept in a register (not just an immediate) so subsequent steps
          // can address `mov rdi, r12` uniformly with steps 2/4's patterns.
          mov r12, 1                               // r12 = root_inode_idx

          // ---------- Step 2: tmpfs_create(root_inode, "bin", 3, DIR=2) ----------
          mov rdi, r12                             // dir_inode_idx = 1
          lea rsi, [rip + bin_seed_name]           // "bin\0"
          mov rdx, 3                               // name_len
          mov rcx, 2                               // VNODE_TYPE_DIR
          call tmpfs_create                        // rax = bin_inode_idx | 0 | 0xFFFF
          cmp rax, 0
          je bin_child_hello_seed_fail
          mov rcx, 0xFFFF
          cmp rax, rcx
          je bin_child_hello_seed_fail             // TMPFS_INODE_ALLOC_OOM
          mov r13, rax                             // r13 = bin_inode_idx

          // ---------- Step 3: bind /bin backend inode to fresh vnode-pool slot ----------
          // #754 FIX: use vnode_cache_or_alloc — allocates a FRESH
          // vnode-pool slot (via internal vnode_alloc if no dedup
          // match) and populates parent_idx/ops_ptr/backend_ptr in
          // one call. Never aliases the tmpfs inode idx into the
          // vnode-pool address space (which was the pre-#754 bug).
          //
          // r15 = root_vn_idx (parent, from step 1). r13 = bin_inode_idx
          // (backend, from step 2's tmpfs_create). ops_ptr = _tmpfs_vops.
          // Returns bin_vn_idx in rax, or 0xFFFF on vnode-pool OOM.
          //
          // bin_vn_idx is saved to r12 (repurposing r12 from root_inode_idx=1
          // which is dead after step 2's tmpfs_create). r12 must survive
          // step 4's nested tmpfs_create call (SysV callee-save) so step 5's
          // vnode_cache_or_alloc has the correct parent_idx arg.
          mov rdi, r15                             // arg1: parent = root_vn_idx
          mov rsi, r13                             // arg2: backend = bin_inode_idx
          lea rdx, [rip + _tmpfs_vops]             // arg3: ops = &_tmpfs_vops
          call vnode_cache_or_alloc                // rax = bin_vn_idx or 0xFFFF
          mov rcx, 0xFFFF
          cmp rax, rcx
          je bin_child_hello_seed_fail             // VNODE_ALLOC_OOM
          mov r12, rax                             // r12 = bin_vn_idx (parent for step 5)

          // ---------- Step 4: tmpfs_create(bin, "child_hello", 11, REG=1) ----------
          mov rdi, r13                             // dir_idx = bin
          lea rsi, [rip + child_hello_seed_name]   // "child_hello\0"
          mov rdx, 11                              // name_len
          mov rcx, 1                               // VNODE_TYPE_REG
          call tmpfs_create                        // rax = child_hello_inode_idx | 0 | 0xFFFF
          cmp rax, 0
          je bin_child_hello_seed_fail
          mov rcx, 0xFFFF
          cmp rax, rcx
          je bin_child_hello_seed_fail
          mov r14, rax                             // r14 = child_hello_inode_idx

          // ---------- Step 5: bind /bin/child_hello backend inode to fresh vnode-pool slot ----------
          // #754 FIX: symmetric with step 3 — vnode_cache_or_alloc
          // with parent = bin_vn_idx (r12, from step 3), backend =
          // child_hello_inode_idx (r14, from step 4's tmpfs_create),
          // ops = _tmpfs_vops. Return value (fresh child_hello vnode
          // idx) is not stored — no downstream consumer within this
          // seed (tmpfs_write in step 7 addresses via r14 inode idx
          // directly at the tmpfs primitive level, bypassing the
          // vnode-pool layer).
          mov rdi, r12                             // arg1: parent = bin_vn_idx
          mov rsi, r14                             // arg2: backend = child_hello_inode_idx
          lea rdx, [rip + _tmpfs_vops]             // arg3: ops = &_tmpfs_vops
          call vnode_cache_or_alloc                // rax = child_hello_vn_idx or 0xFFFF
          mov rcx, 0xFFFF
          cmp rax, rcx
          je bin_child_hello_seed_fail             // VNODE_ALLOC_OOM

          // ---------- Step 6: compute image base + length ----------
          //
          // r15 = _child_hello_bin_start (kernel VA; the ELF blob lives in
          // .rodata.userbin, mapped in the kernel higher half by the
          // loader). r15 was root_vn_idx (dead after step 3 — its only
          // consumer was step 3's vnode_cache_or_alloc parent arg).
          // image_len = _child_hello_bin_end - _child_hello_bin_start;
          // at R17.M0 build time this is ~4784 bytes (well under the
          // tmpfs 64 KiB per-file cap). r12 was bin_vn_idx (from #754
          // fix, dead after step 5 — its only consumer was step 5's
          // vnode_cache_or_alloc parent arg) — repurposed to image_len.
          // r13 was bin_inode_idx, now dead — repurposed to offset
          // (start = 0).
          lea r15, [rip + _child_hello_bin_start]
          lea rax, [rip + _child_hello_bin_end]
          sub rax, r15                             // rax = image_len
          mov r12, rax                             // r12 = image_len
          xor r13, r13                             // r13 = offset

          // ---------- Step 7: write in single-page (<=4096-byte) chunks ----------
          //
          // tmpfs_write enforces single-page constraint (write.pdx §4.5:
          // start_page == end_page).  Each iteration writes min(4096,
          // image_len - offset) bytes at page-aligned offset, so both
          // start_page and end_page are `offset >> 12` and the constraint
          // holds by construction.
          //
          // Return value handling: tmpfs_write returns bytes_written (=len)
          // on success, or 0xFFFFFFFFFFFFFFFF (VOPS_ERR_SENTINEL / fail)
          // on any of the gates.  On success we add to offset; on failure
          // we abort the seed (init.pdx's execve will then return -ENOENT
          // or similar, and the fingerprint will show the failure marker).
      bin_child_hello_seed_write_loop:
          cmp r13, r12
          jae bin_child_hello_seed_write_done      // offset >= image_len

          // chunk_len = min(4096, image_len - offset), computed in rax
          mov rax, r12
          sub rax, r13                             // rax = remaining bytes
          mov rcx, 4096
          cmp rax, rcx
          jbe bin_child_hello_seed_chunk_ok
          mov rax, rcx                             // clamp to 4096
      bin_child_hello_seed_chunk_ok:

          // tmpfs_write(inode_idx=r14, buf=r15+r13, len=rax, offset=r13)
          mov rdi, r14                             // arg0 = child_hello_inode_idx
          mov rsi, r15
          add rsi, r13                             // arg1 = image_base + offset
          mov rdx, rax                             // arg2 = chunk_len
          mov rcx, r13                             // arg3 = offset
          call tmpfs_write                         // rax = bytes_written or sentinel

          // Sentinel check: 0xFFFFFFFFFFFFFFFF (rcx-loaded because AND/CMP
          // has no imm64 form).
          mov rcx, 0xFFFFFFFFFFFFFFFF
          cmp rax, rcx
          je  bin_child_hello_seed_fail

          // Advance by bytes_written (== chunk_len for a well-formed
          // single-page write; tmpfs_write does not short-write on success).
          add r13, rax                             // offset += bytes_written
          jmp bin_child_hello_seed_write_loop

      bin_child_hello_seed_write_done:
          mov rdi, 3;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + bin_seed_ok_msg];
          call klog_s1;
          jmp bin_child_hello_seed_done

      bin_child_hello_seed_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + bin_seed_fail_msg];
          call klog_s1;

      bin_child_hello_seed_done:

      // ============================================================
      // R17-M5-636 partial (paideia-os #636): /bin/sh tmpfs seed.
      //
      // Mirrors D10a's bin_child_hello_seed pattern but for shell.elf
      // (embedded via tools/userbin_embed.S at _shell_bin_start /
      // _shell_bin_end). D10a already created /bin as a DIR under root
      // and wired its vnode-pool slot; here we tmpfs_lookup(1, "bin")
      // to recover bin's inode idx, create /bin/sh as a REG file inside
      // it, wire the new vnode-pool slot, and write shell.elf bytes in
      // single-page (<=4096-byte) chunks (tmpfs_write single-page
      // constraint per write.pdx §4.5).
      //
      // This partial does NOT wire init to fork+exec /bin/sh — that is
      // deferred to a follow-up sub-issue (see design doc §6 prereq #4)
      // so #723's AC (CHILD HELLO 42 / WAIT: pid=2 status=42 / REAPED)
      // stays byte-identical.
      //
      // Register plan (mirrors D10a with #754 fix additions):
      //   r13 = bin_inode_idx (steps 1-3 as tmpfs dir_idx / backend for
      //         bin_vn_idx dedup); repurposed to `offset` (steps 4-5)
      //   r14 = sh_inode_idx (steps 2-5)
      //   r15 = root_vn_idx (step 1b, dead after step 1c); then
      //         _shell_bin_start (image base, steps 4-5)
      //   r12 = bin_vn_idx (step 1c-3, dead after step 3 — its only
      //         consumer was step 3's vnode_cache_or_alloc parent arg);
      //         then image_len (steps 4-5)
      //
      // See design/kernel/r17-m5-636-shell-binary-seed.md and
      // design/kernel/r17-m0-665-vnode-conflation-fix.md.
      // ============================================================
      bin_sh_seed:
          // ---------- Step 1: recover /bin's inode idx via tmpfs_lookup ----------
          // Reuses bin_seed_name ("bin\0") already defined by D10a in
          // tools/boot_stub.S. Returns 0 on miss (which would mean D10a
          // failed silently — if seed_ok fired above, /bin must exist).
          mov  rdi, 1                              // root_inode_idx
          lea  rsi, [rip + bin_seed_name]          // "bin\0"
          call tmpfs_lookup                        // rax = bin_idx or 0 on miss
          cmp  rax, 0
          je   bin_sh_seed_fail
          mov  r13, rax                            // r13 = bin_inode_idx

          // ---------- Step 1b: recover root vnode-pool idx ----------
          // #754 FIX: needed as parent arg for step 1c's dedup call.
          // mount_root_vnode returns a real vnode-pool idx (from
          // mount()'s vnode_alloc, wired via #665 Phase 3
          // backend_registry — includes ops_ptr=&_tmpfs_vops and
          // backend_ptr=1).
          call mount_root_vnode                    // rax = root_vn_idx
          cmp  rax, 0
          je   bin_sh_seed_fail
          mov  r15, rax                            // r15 = root_vn_idx (temp, dead after step 1c)

          // ---------- Step 1c: recover /bin vnode-pool idx via dedup ----------
          // #754 FIX: bin_sh_seed does not inherit register state
          // from bin_child_hello_seed (D10a), so we must re-derive
          // /bin's vnode-pool idx here. vnode_cache_or_alloc dedupes
          // on (parent_idx, backend_idx, ops_ptr) — with identical
          // args to D10a step 3, it returns the SAME slot D10a
          // allocated (idempotent). No new slot allocated if D10a
          // ran successfully above; new slot allocated only if D10a
          // failed to seed /bin (in which case tmpfs_lookup at
          // step 1 would have already returned 0, and we'd have
          // bailed at bin_sh_seed_fail).
          mov  rdi, r15                            // arg1: parent = root_vn_idx
          mov  rsi, r13                            // arg2: backend = bin_inode_idx
          lea  rdx, [rip + _tmpfs_vops]            // arg3: ops = &_tmpfs_vops
          call vnode_cache_or_alloc                // rax = bin_vn_idx or 0xFFFF
          mov  rcx, 0xFFFF
          cmp  rax, rcx
          je   bin_sh_seed_fail                    // VNODE_ALLOC_OOM
          mov  r12, rax                            // r12 = bin_vn_idx (parent for step 3)

          // ---------- Step 2: tmpfs_create(bin, "sh", 2, REG=1) ----------
          mov  rdi, r13                            // dir_inode_idx = bin
          lea  rsi, [rip + sh_seed_name]           // "sh\0"
          mov  rdx, 2                              // name_len
          mov  rcx, 1                              // VNODE_TYPE_REG
          call tmpfs_create                        // rax = sh_inode_idx | 0 | 0xFFFF
          cmp  rax, 0
          je   bin_sh_seed_fail
          mov  rcx, 0xFFFF
          cmp  rax, rcx
          je   bin_sh_seed_fail                    // TMPFS_INODE_ALLOC_OOM
          mov  r14, rax                            // r14 = sh_inode_idx

          // ---------- Step 3: bind /bin/sh backend inode to fresh vnode-pool slot ----------
          // #754 FIX: replaces the pre-#754 pattern
          //   `mov rdi, r14; call vnode_slot; store ops_ptr; store
          //    backend_ptr = r14`
          // which conflated tmpfs inode idx (r14) with vnode-pool idx,
          // CLOBBERING whatever legitimate vnode-pool slot lived at
          // that numeric index — most visibly _tty0 (allocated at
          // vnode-pool idx 6 by tty_init) when sh_inode_idx also
          // happened to be 6. See wave-3 diagnosis of #754 for the
          // byte-identity proof.
          //
          // vnode_cache_or_alloc allocates a FRESH vnode-pool slot
          // (or dedups) — never aliases the tmpfs inode number as a
          // vnode-pool index.
          mov  rdi, r12                            // arg1: parent = bin_vn_idx
          mov  rsi, r14                            // arg2: backend = sh_inode_idx
          lea  rdx, [rip + _tmpfs_vops]            // arg3: ops = &_tmpfs_vops
          call vnode_cache_or_alloc                // rax = sh_vn_idx or 0xFFFF
          mov  rcx, 0xFFFF
          cmp  rax, rcx
          je   bin_sh_seed_fail                    // VNODE_ALLOC_OOM

          // ---------- Step 4: compute image base + length ----------
          // r15 = _shell_bin_start (kernel VA; .rodata.userbin — mapped
          // in the higher half by the loader). r15 was root_vn_idx
          // (dead after step 1c). image_len =
          // _shell_bin_end - _shell_bin_start; ~9856 bytes at R17.M5,
          // well under the tmpfs 64 KiB per-file cap. r12 was
          // bin_vn_idx (dead after step 3 — its only consumer was
          // step 3's vnode_cache_or_alloc parent arg); repurposed to
          // image_len. r13 was bin_inode_idx, now dead — repurposed
          // to offset (start = 0).
          lea  r15, [rip + _shell_bin_start]
          lea  rax, [rip + _shell_bin_end]
          sub  rax, r15                            // rax = image_len
          mov  r12, rax                            // r12 = image_len
          xor  r13, r13                            // r13 = offset

          // ---------- Step 5: write in single-page (<=4096-byte) chunks ----------
          // tmpfs_write enforces single-page constraint (write.pdx §4.5:
          // start_page == end_page). Each iteration writes
          // min(4096, image_len - offset) bytes at page-aligned offset,
          // so both start_page and end_page are `offset >> 12` and the
          // constraint holds by construction (offset starts at 0 and is
          // incremented by bytes_written each iteration).
      bin_sh_seed_write_loop:
          cmp  r13, r12
          jae  bin_sh_seed_write_done              // offset >= image_len

          // chunk_len = min(4096, image_len - offset)
          mov  rax, r12
          sub  rax, r13                            // rax = remaining bytes
          mov  rcx, 4096
          cmp  rax, rcx
          jbe  bin_sh_seed_chunk_ok
          mov  rax, rcx                            // clamp to 4096
      bin_sh_seed_chunk_ok:

          // tmpfs_write(inode_idx=r14, buf=r15+r13, len=rax, offset=r13)
          mov  rdi, r14                            // arg0 = sh_inode_idx
          mov  rsi, r15
          add  rsi, r13                            // arg1 = image_base + offset
          mov  rdx, rax                            // arg2 = chunk_len
          mov  rcx, r13                            // arg3 = offset
          call tmpfs_write                         // rax = bytes_written or sentinel

          // Sentinel check: 0xFFFFFFFFFFFFFFFF (rcx-loaded because AND/CMP
          // has no imm64 form). Matches D10a's error handling.
          mov  rcx, 0xFFFFFFFFFFFFFFFF
          cmp  rax, rcx
          je   bin_sh_seed_fail

          // Advance by bytes_written (= chunk_len for a well-formed
          // single-page write; tmpfs_write does not short-write on
          // success).
          add  r13, rax                            // offset += bytes_written
          jmp  bin_sh_seed_write_loop

      bin_sh_seed_write_done:
          mov  rdi, 3;
          lea  rsi, [rip + SUBSYS_BOOT];
          lea  rdx, [rip + bin_sh_seed_ok_msg];
          call klog_s1;
          jmp  bin_sh_seed_done

      bin_sh_seed_fail:
          mov  rdi, 1;                             // LEVEL_ERROR
          lea  rsi, [rip + SUBSYS_BOOT];
          lea  rdx, [rip + bin_sh_seed_fail_msg];
          call klog_s1;

      bin_sh_seed_done:

      // ============================================================
      // R17.M5 #638 (paideia-os): /bin/true tmpfs seed.
      //
      // Mirrors bin_sh_seed structurally (which mirrors D10a's
      // bin_child_hello_seed) but for true.elf (embedded via
      // tools/userbin_embed.S at _true_bin_start / _true_bin_end).
      // /bin already exists as a DIR under root (created by D10a
      // above, whose success is a hard prerequisite of reaching this
      // seed — bin_child_hello_seed_fail short-circuits past both
      // bin_sh_seed and bin_true_seed via the failure branch). Here
      // we tmpfs_lookup(root, "bin") to recover /bin's inode idx,
      // create /bin/true as a REG file inside it, wire the new
      // vnode-pool slot via vnode_cache_or_alloc (mandatory per #754
      // fix — never conflate tmpfs inode idx with vnode-pool idx),
      // and write true.elf bytes in single-page (<=4096-byte) chunks
      // (tmpfs_write single-page constraint per write.pdx §4.5).
      //
      // Placement rationale: after bin_sh_seed so the seed order is
      // deterministic (child_hello, sh, true — chronological by
      // introduction). Marker emitted last, so its absence would
      // indicate any of the seven prior seed steps failed silently.
      //
      // Enables the shell's fork+execve("/bin/true") chain in
      // boot_r17_shell_child_process (R17.M5 #638): shell reads
      // "true\n", dispatch misses, exec_child calls resolve_path
      // (prepends "/bin/" — no slash in argv[0]) → sys_execve
      // ("/bin/true", ...). Before this seed, /bin/true did not
      // exist and execve returned -ENOENT; shell would exit(127)
      // and no "TRUE OK" line would land on the wire.
      //
      // Register plan (mirrors bin_sh_seed line-for-line):
      //   r13 = bin_inode_idx (steps 1-3); repurposed to offset (4-5)
      //   r14 = true_inode_idx (steps 2-5)
      //   r15 = root_vn_idx (step 1b, dead after step 1c); then
      //         _true_bin_start (image base, steps 4-5)
      //   r12 = bin_vn_idx (step 1c-3, dead after step 3); then
      //         image_len (steps 4-5)
      //
      // See design/kernel/r17-m0-665-vnode-conflation-fix.md and
      // design/milestones/r14b-tactical-plan.md §Subsystem 20 item 4.
      // ============================================================
      bin_true_seed:
          // ---------- Step 1: recover /bin's inode idx via tmpfs_lookup ----------
          // Reuses bin_seed_name ("bin\0") already defined by D10a in
          // tools/boot_stub.S. Returns 0 on miss (unreachable if D10a
          // and bin_sh_seed above both succeeded — /bin must exist).
          mov  rdi, 1                              // root_inode_idx
          lea  rsi, [rip + bin_seed_name]          // "bin\0"
          call tmpfs_lookup                        // rax = bin_idx or 0
          cmp  rax, 0
          je   bin_true_seed_fail
          mov  r13, rax                            // r13 = bin_inode_idx

          // ---------- Step 1b: recover root vnode-pool idx ----------
          // #754 discipline: needed as parent arg for step 1c's dedup
          // call. mount_root_vnode returns a real vnode-pool idx.
          call mount_root_vnode                    // rax = root_vn_idx
          cmp  rax, 0
          je   bin_true_seed_fail
          mov  r15, rax                            // r15 = root_vn_idx (temp)

          // ---------- Step 1c: recover /bin vnode-pool idx via dedup ----------
          // #754 discipline: vnode_cache_or_alloc with identical args
          // to D10a step 3 / bin_sh_seed step 1c is idempotent — it
          // returns the SAME slot D10a allocated for /bin. This is
          // the sanctioned pattern for re-deriving a vnode-pool idx
          // from a tmpfs inode idx across independent seed sites.
          mov  rdi, r15                            // arg1: parent = root_vn_idx
          mov  rsi, r13                            // arg2: backend = bin_inode_idx
          lea  rdx, [rip + _tmpfs_vops]            // arg3: ops = &_tmpfs_vops
          call vnode_cache_or_alloc                // rax = bin_vn_idx or 0xFFFF
          mov  rcx, 0xFFFF
          cmp  rax, rcx
          je   bin_true_seed_fail                  // VNODE_ALLOC_OOM
          mov  r12, rax                            // r12 = bin_vn_idx

          // ---------- Step 2: tmpfs_create(bin, "true", 4, REG=1) ----------
          mov  rdi, r13                            // dir_inode_idx = bin
          lea  rsi, [rip + true_seed_name]         // "true\0"
          mov  rdx, 4                              // name_len
          mov  rcx, 1                              // VNODE_TYPE_REG
          call tmpfs_create                        // rax = true_inode_idx | 0 | 0xFFFF
          cmp  rax, 0
          je   bin_true_seed_fail
          mov  rcx, 0xFFFF
          cmp  rax, rcx
          je   bin_true_seed_fail                  // TMPFS_INODE_ALLOC_OOM
          mov  r14, rax                            // r14 = true_inode_idx

          // ---------- Step 3: bind /bin/true backend inode to fresh vnode-pool slot ----------
          // #754 FIX (see bin_sh_seed step 3 for full rationale):
          // vnode_cache_or_alloc allocates a FRESH vnode-pool slot,
          // never aliases the tmpfs inode number as a vnode-pool idx.
          mov  rdi, r12                            // arg1: parent = bin_vn_idx
          mov  rsi, r14                            // arg2: backend = true_inode_idx
          lea  rdx, [rip + _tmpfs_vops]            // arg3: ops = &_tmpfs_vops
          call vnode_cache_or_alloc                // rax = true_vn_idx or 0xFFFF
          mov  rcx, 0xFFFF
          cmp  rax, rcx
          je   bin_true_seed_fail                  // VNODE_ALLOC_OOM

          // ---------- Step 4: compute image base + length ----------
          // r15 = _true_bin_start (kernel VA; .rodata.userbin). image_len
          // = _true_bin_end - _true_bin_start; a handful of bytes for
          // the two-syscall + "TRUE OK\n" payload, well under tmpfs's
          // 64 KiB per-file cap and even under a single 4096-byte page
          // (so the write loop makes exactly one iteration in practice).
          // r12 was bin_vn_idx (dead after step 3); repurposed to
          // image_len. r13 was bin_inode_idx, now dead; repurposed to
          // offset (start = 0).
          lea  r15, [rip + _true_bin_start]
          lea  rax, [rip + _true_bin_end]
          sub  rax, r15                            // rax = image_len
          mov  r12, rax                            // r12 = image_len
          xor  r13, r13                            // r13 = offset

          // ---------- Step 5: write in single-page (<=4096-byte) chunks ----------
          // Same shape as bin_sh_seed step 5 / bin_child_hello_seed
          // step 7. tmpfs_write single-page constraint holds because
          // offset is 4096-aligned every iteration (starts at 0, is
          // incremented by chunk_len which is min(4096, remaining)).
      bin_true_seed_write_loop:
          cmp  r13, r12
          jae  bin_true_seed_write_done            // offset >= image_len

          // chunk_len = min(4096, image_len - offset)
          mov  rax, r12
          sub  rax, r13                            // rax = remaining
          mov  rcx, 4096
          cmp  rax, rcx
          jbe  bin_true_seed_chunk_ok
          mov  rax, rcx                            // clamp to 4096
      bin_true_seed_chunk_ok:

          // tmpfs_write(inode_idx=r14, buf=r15+r13, len=rax, offset=r13)
          mov  rdi, r14                            // arg0 = true_inode_idx
          mov  rsi, r15
          add  rsi, r13                            // arg1 = image_base + offset
          mov  rdx, rax                            // arg2 = chunk_len
          mov  rcx, r13                            // arg3 = offset
          call tmpfs_write                         // rax = bytes_written or sentinel

          // Sentinel check: 0xFFFFFFFFFFFFFFFF (rcx-loaded because
          // AND/CMP has no imm64 form). Matches bin_sh_seed.
          mov  rcx, 0xFFFFFFFFFFFFFFFF
          cmp  rax, rcx
          je   bin_true_seed_fail

          add  r13, rax                            // offset += bytes_written
          jmp  bin_true_seed_write_loop

      bin_true_seed_write_done:
          mov  rdi, 3;
          lea  rsi, [rip + SUBSYS_BOOT];
          lea  rdx, [rip + bin_true_seed_ok_msg];
          call klog_s1;
          jmp  bin_true_seed_done

      bin_true_seed_fail:
          mov  rdi, 1;                             // LEVEL_ERROR
          lea  rsi, [rip + SUBSYS_BOOT];
          lea  rdx, [rip + bin_true_seed_fail_msg];
          call klog_s1;

      bin_true_seed_done:

      // ============================================================
      // R48-PREP-005.M2 (design/services/svc-elevate-broker-registration.md
      // §4.M2): /bin/elevate_broker_daemon tmpfs seed.
      //
      // Mirrors bin_true_seed structurally (which mirrors bin_sh_seed /
      // D10a's bin_child_hello_seed) but for elevate_broker_daemon.elf
      // (embedded via tools/userbin_embed.S at
      // _elevate_broker_daemon_bin_start / _end). /bin already exists as
      // a DIR under root (created by D10a above). Here we
      // tmpfs_lookup(root, "bin") to recover /bin's inode idx, create
      // /bin/elevate_broker_daemon as a REG file inside it, wire the new
      // vnode-pool slot via vnode_cache_or_alloc (mandatory per #754 fix
      // — never conflate tmpfs inode idx with vnode-pool idx), and write
      // elevate_broker_daemon.elf bytes in single-page (<=4096-byte)
      // chunks (tmpfs_write single-page constraint per write.pdx §4.5).
      //
      // Enables init's third fork+exec cycle (src/user/init.pdx) to
      // execve("/bin/elevate_broker_daemon") successfully — before this
      // seed, the path does not exist and sys_execve_shim returns
      // -ENOENT.
      //
      // Register plan (mirrors bin_true_seed line-for-line):
      //   r13 = bin_inode_idx (steps 1-3); repurposed to offset (4-5)
      //   r14 = elevate_broker_daemon_inode_idx (steps 2-5)
      //   r15 = root_vn_idx (step 1b, dead after step 1c); then
      //         _elevate_broker_daemon_bin_start (image base, steps 4-5)
      //   r12 = bin_vn_idx (step 1c-3, dead after step 3); then
      //         image_len (steps 4-5)
      // ============================================================
      bin_elevate_broker_daemon_seed:
          // ---------- Step 1: recover /bin's inode idx via tmpfs_lookup ----------
          mov  rdi, 1                              // root_inode_idx
          lea  rsi, [rip + bin_seed_name]          // "bin\0"
          call tmpfs_lookup                        // rax = bin_idx or 0
          cmp  rax, 0
          je   bin_elevate_broker_daemon_seed_fail
          mov  r13, rax                            // r13 = bin_inode_idx

          // ---------- Step 1b: recover root vnode-pool idx ----------
          call mount_root_vnode                    // rax = root_vn_idx
          cmp  rax, 0
          je   bin_elevate_broker_daemon_seed_fail
          mov  r15, rax                            // r15 = root_vn_idx (temp)

          // ---------- Step 1c: recover /bin vnode-pool idx via dedup ----------
          mov  rdi, r15                            // arg1: parent = root_vn_idx
          mov  rsi, r13                            // arg2: backend = bin_inode_idx
          lea  rdx, [rip + _tmpfs_vops]            // arg3: ops = &_tmpfs_vops
          call vnode_cache_or_alloc                // rax = bin_vn_idx or 0xFFFF
          mov  rcx, 0xFFFF
          cmp  rax, rcx
          je   bin_elevate_broker_daemon_seed_fail // VNODE_ALLOC_OOM
          mov  r12, rax                            // r12 = bin_vn_idx

          // ---------- Step 2: tmpfs_create(bin, "elevate_broker_daemon", 21, REG=1) ----------
          mov  rdi, r13                            // dir_inode_idx = bin
          lea  rsi, [rip + elevate_broker_daemon_seed_name] // "elevate_broker_daemon\0"
          mov  rdx, 21                             // name_len
          mov  rcx, 1                              // VNODE_TYPE_REG
          call tmpfs_create                        // rax = ebd_inode_idx | 0 | 0xFFFF
          cmp  rax, 0
          je   bin_elevate_broker_daemon_seed_fail
          mov  rcx, 0xFFFF
          cmp  rax, rcx
          je   bin_elevate_broker_daemon_seed_fail // TMPFS_INODE_ALLOC_OOM
          mov  r14, rax                            // r14 = ebd_inode_idx

          // ---------- Step 3: bind /bin/elevate_broker_daemon backend inode to fresh vnode-pool slot ----------
          mov  rdi, r12                            // arg1: parent = bin_vn_idx
          mov  rsi, r14                            // arg2: backend = ebd_inode_idx
          lea  rdx, [rip + _tmpfs_vops]            // arg3: ops = &_tmpfs_vops
          call vnode_cache_or_alloc                // rax = ebd_vn_idx or 0xFFFF
          mov  rcx, 0xFFFF
          cmp  rax, rcx
          je   bin_elevate_broker_daemon_seed_fail // VNODE_ALLOC_OOM

          // ---------- Step 4: compute image base + length ----------
          lea  r15, [rip + _elevate_broker_daemon_bin_start]
          lea  rax, [rip + _elevate_broker_daemon_bin_end]
          sub  rax, r15                            // rax = image_len
          mov  r12, rax                            // r12 = image_len
          xor  r13, r13                            // r13 = offset

          // ---------- Step 5: write in single-page (<=4096-byte) chunks ----------
      bin_elevate_broker_daemon_seed_write_loop:
          cmp  r13, r12
          jae  bin_elevate_broker_daemon_seed_write_done // offset >= image_len

          // chunk_len = min(4096, image_len - offset)
          mov  rax, r12
          sub  rax, r13                            // rax = remaining
          mov  rcx, 4096
          cmp  rax, rcx
          jbe  bin_elevate_broker_daemon_seed_chunk_ok
          mov  rax, rcx                            // clamp to 4096
      bin_elevate_broker_daemon_seed_chunk_ok:

          // tmpfs_write(inode_idx=r14, buf=r15+r13, len=rax, offset=r13)
          mov  rdi, r14                            // arg0 = ebd_inode_idx
          mov  rsi, r15
          add  rsi, r13                            // arg1 = image_base + offset
          mov  rdx, rax                            // arg2 = chunk_len
          mov  rcx, r13                            // arg3 = offset
          call tmpfs_write                         // rax = bytes_written or sentinel

          mov  rcx, 0xFFFFFFFFFFFFFFFF
          cmp  rax, rcx
          je   bin_elevate_broker_daemon_seed_fail

          add  r13, rax                            // offset += bytes_written
          jmp  bin_elevate_broker_daemon_seed_write_loop

      bin_elevate_broker_daemon_seed_write_done:
          mov  rdi, 3;
          lea  rsi, [rip + SUBSYS_BOOT];
          lea  rdx, [rip + bin_elevate_broker_daemon_seed_ok_msg];
          call klog_s1;
          jmp  bin_elevate_broker_daemon_seed_done

      bin_elevate_broker_daemon_seed_fail:
          mov  rdi, 1;                             // LEVEL_ERROR
          lea  rsi, [rip + SUBSYS_BOOT];
          lea  rdx, [rip + bin_elevate_broker_daemon_seed_fail_msg];
          call klog_s1;

      bin_elevate_broker_daemon_seed_done:

      // ============================================================
      // R61.M1-002 (#1821): /bin/ls tmpfs seed.
      //
      // Mirrors bin_elevate_broker_daemon_seed structurally (which
      // mirrors bin_true_seed / bin_sh_seed / D10a's bin_child_hello_seed)
      // but for ls.elf (embedded via tools/userbin_embed.S at
      // _ls_bin_start / _ls_bin_end, added by R61.M1-001 #1820).
      // /bin already exists as a DIR under root (created by D10a above).
      // Here we tmpfs_lookup(root, "bin") to recover /bin's inode idx,
      // create /bin/ls as a REG file inside it, wire the new
      // vnode-pool slot via vnode_cache_or_alloc (mandatory per #754 fix
      // -- never conflate tmpfs inode idx with vnode-pool idx), and write
      // ls.elf bytes in single-page (<=4096-byte) chunks (tmpfs_write
      // single-page constraint per write.pdx Section 4.5).
      //
      // Enables the shell's fork+execve("/bin/ls") chain to succeed --
      // before this seed, the path does not exist and sys_execve_shim
      // returns -ENOENT.
      //
      // Fingerprint (R61.M1-003 #1822): klog_s1_d1(LEVEL_INFO, SUBSYS_BOOT,
      // bin_ls_seed_ok_msg, k_bytes, image_len) emits exactly one line
      // `bin seed ok -- file=/bin/ls bytes=<N>` (klog_emit_core appends
      // the KV's " bytes=<N>" plus its own trailing newline; the tag
      // literal carries no embedded \n -- see tools/boot_stub.S header
      // note above the R61 string block).
      //
      // Register plan (mirrors bin_elevate_broker_daemon_seed line-for-line):
      //   r13 = bin_inode_idx (steps 1-3); repurposed to offset (4-5)
      //   r14 = ls_inode_idx (steps 2-5)
      //   r15 = root_vn_idx (step 1b, dead after step 1c); then
      //         _ls_bin_start (image base, steps 4-5)
      //   r12 = bin_vn_idx (step 1c-3, dead after step 3); then
      //         image_len (steps 4-5) -- also the k_bytes value at emit
      // ============================================================
      bs_ls_seed:
          // ---------- Step 1: recover /bin's inode idx via tmpfs_lookup ----------
          mov  rdi, 1                              // root_inode_idx
          lea  rsi, [rip + bin_seed_name]          // "bin\0"
          call tmpfs_lookup                        // rax = bin_idx or 0
          cmp  rax, 0
          je   bs_ls_seed_fail
          mov  r13, rax                            // r13 = bin_inode_idx

          // ---------- Step 1b: recover root vnode-pool idx ----------
          call mount_root_vnode                    // rax = root_vn_idx
          cmp  rax, 0
          je   bs_ls_seed_fail
          mov  r15, rax                            // r15 = root_vn_idx (temp)

          // ---------- Step 1c: recover /bin vnode-pool idx via dedup ----------
          mov  rdi, r15                            // arg1: parent = root_vn_idx
          mov  rsi, r13                            // arg2: backend = bin_inode_idx
          lea  rdx, [rip + _tmpfs_vops]            // arg3: ops = &_tmpfs_vops
          call vnode_cache_or_alloc                // rax = bin_vn_idx or 0xFFFF
          mov  rcx, 0xFFFF
          cmp  rax, rcx
          je   bs_ls_seed_fail                 // VNODE_ALLOC_OOM
          mov  r12, rax                            // r12 = bin_vn_idx

          // ---------- Step 2: tmpfs_create(bin, "ls", 2, REG=1) ----------
          mov  rdi, r13                             // dir_inode_idx = bin
          lea  rsi, [rip + ls_seed_name]        // "ls\0"
          mov  rdx, 2                       // name_len
          mov  rcx, 1                               // VNODE_TYPE_REG
          call tmpfs_create                        // rax = ls_inode_idx | 0 | 0xFFFF
          cmp  rax, 0
          je   bs_ls_seed_fail
          mov  rcx, 0xFFFF
          cmp  rax, rcx
          je   bs_ls_seed_fail                 // TMPFS_INODE_ALLOC_OOM
          mov  r14, rax                             // r14 = ls_inode_idx

          // ---------- Step 3: bind /bin/ls backend inode to fresh vnode-pool slot ----------
          mov  rdi, r12                             // arg1: parent = bin_vn_idx
          mov  rsi, r14                             // arg2: backend = ls_inode_idx
          lea  rdx, [rip + _tmpfs_vops]             // arg3: ops = &_tmpfs_vops
          call vnode_cache_or_alloc                // rax = ls_vn_idx or 0xFFFF
          mov  rcx, 0xFFFF
          cmp  rax, rcx
          je   bs_ls_seed_fail                 // VNODE_ALLOC_OOM

          // ---------- Step 4: compute image base + length ----------
          lea  r15, [rip + _ls_bin_start]
          lea  rax, [rip + _ls_bin_end]
          sub  rax, r15                             // rax = image_len
          mov  r12, rax                             // r12 = image_len
          xor  r13, r13                             // r13 = offset

          // ---------- Step 5: write in single-page (<=4096-byte) chunks ----------
      bs_ls_seed_write_loop:
          cmp  r13, r12
          jae  bs_ls_seed_write_done            // offset >= image_len

          // chunk_len = min(4096, image_len - offset)
          mov  rax, r12
          sub  rax, r13                             // rax = remaining
          mov  rcx, 4096
          cmp  rax, rcx
          jbe  bs_ls_seed_chunk_ok
          mov  rax, rcx                             // clamp to 4096
      bs_ls_seed_chunk_ok:

          // tmpfs_write(inode_idx=r14, buf=r15+r13, len=rax, offset=r13)
          mov  rdi, r14                             // arg0 = ls_inode_idx
          mov  rsi, r15
          add  rsi, r13                             // arg1 = image_base + offset
          mov  rdx, rax                             // arg2 = chunk_len
          mov  rcx, r13                             // arg3 = offset
          call tmpfs_write                          // rax = bytes_written or sentinel

          mov  rcx, 0xFFFFFFFFFFFFFFFF
          cmp  rax, rcx
          je   bs_ls_seed_fail

          add  r13, rax                             // offset += bytes_written
          jmp  bs_ls_seed_write_loop

      bs_ls_seed_write_done:
          // klog_s1_d1(LEVEL_INFO=3, SUBSYS_BOOT, bin_ls_seed_ok_msg,
          // k_bytes, image_len=r12) -> "bin seed ok -- file=/bin/ls bytes=<N>"
          mov  rdi, 3;
          lea  rsi, [rip + SUBSYS_BOOT];
          lea  rdx, [rip + bin_ls_seed_ok_msg];
          lea  rcx, [rip + k_bytes];
          mov  r8, r12;                             // r8 = image_len (bytes written)
          call klog_s1_d1;
          jmp  bs_ls_seed_done

      bs_ls_seed_fail:
          mov  rdi, 1;                              // LEVEL_ERROR
          lea  rsi, [rip + SUBSYS_BOOT];
          lea  rdx, [rip + bin_ls_seed_fail_msg];
          call klog_s1;

      bs_ls_seed_done:

      // ============================================================
      // R61.M1-002 (#1821): /bin/cat tmpfs seed.
      //
      // Mirrors bin_elevate_broker_daemon_seed structurally (which
      // mirrors bin_true_seed / bin_sh_seed / D10a's bin_child_hello_seed)
      // but for cat.elf (embedded via tools/userbin_embed.S at
      // _cat_bin_start / _cat_bin_end, added by R61.M1-001 #1820).
      // /bin already exists as a DIR under root (created by D10a above).
      // Here we tmpfs_lookup(root, "bin") to recover /bin's inode idx,
      // create /bin/cat as a REG file inside it, wire the new
      // vnode-pool slot via vnode_cache_or_alloc (mandatory per #754 fix
      // -- never conflate tmpfs inode idx with vnode-pool idx), and write
      // cat.elf bytes in single-page (<=4096-byte) chunks (tmpfs_write
      // single-page constraint per write.pdx Section 4.5).
      //
      // Enables the shell's fork+execve("/bin/cat") chain to succeed --
      // before this seed, the path does not exist and sys_execve_shim
      // returns -ENOENT.
      //
      // Fingerprint (R61.M1-003 #1822): klog_s1_d1(LEVEL_INFO, SUBSYS_BOOT,
      // bin_cat_seed_ok_msg, k_bytes, image_len) emits exactly one line
      // `bin seed ok -- file=/bin/cat bytes=<N>` (klog_emit_core appends
      // the KV's " bytes=<N>" plus its own trailing newline; the tag
      // literal carries no embedded \n -- see tools/boot_stub.S header
      // note above the R61 string block).
      //
      // Register plan (mirrors bin_elevate_broker_daemon_seed line-for-line):
      //   r13 = bin_inode_idx (steps 1-3); repurposed to offset (4-5)
      //   r14 = cat_inode_idx (steps 2-5)
      //   r15 = root_vn_idx (step 1b, dead after step 1c); then
      //         _cat_bin_start (image base, steps 4-5)
      //   r12 = bin_vn_idx (step 1c-3, dead after step 3); then
      //         image_len (steps 4-5) -- also the k_bytes value at emit
      // ============================================================
      bs_cat_seed:
          // ---------- Step 1: recover /bin's inode idx via tmpfs_lookup ----------
          mov  rdi, 1                              // root_inode_idx
          lea  rsi, [rip + bin_seed_name]          // "bin\0"
          call tmpfs_lookup                        // rax = bin_idx or 0
          cmp  rax, 0
          je   bs_cat_seed_fail
          mov  r13, rax                            // r13 = bin_inode_idx

          // ---------- Step 1b: recover root vnode-pool idx ----------
          call mount_root_vnode                    // rax = root_vn_idx
          cmp  rax, 0
          je   bs_cat_seed_fail
          mov  r15, rax                            // r15 = root_vn_idx (temp)

          // ---------- Step 1c: recover /bin vnode-pool idx via dedup ----------
          mov  rdi, r15                            // arg1: parent = root_vn_idx
          mov  rsi, r13                            // arg2: backend = bin_inode_idx
          lea  rdx, [rip + _tmpfs_vops]            // arg3: ops = &_tmpfs_vops
          call vnode_cache_or_alloc                // rax = bin_vn_idx or 0xFFFF
