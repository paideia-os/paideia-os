// src/kernel/boot/witness/r113_m8_scanout_qemu_witness.pdx
// -- Wave ν (α–τ plan, deferred): paideia-os #2419 QEMU proxy.
//
// -----------------------------------------------------------------------------
// What this witness proves (and what it CANNOT prove)
// -----------------------------------------------------------------------------
//
// paideia-os#2419 -- "Direct-scanout witness on Iris Xe" -- is gated
// on real T14 G4 silicon programming the Iris Xe DDI + PIPE + PLANE
// blocks to project a compositor buffer.  It CANNOT be closed by any
// QEMU session (QEMU has no Iris Xe rendering pipeline).
//
// This witness is the QEMU-approximation code-path exerciser Wave ν
// commits to landing so that the code side of the issue is genuinely
// done and only the "run on real T14" remains.  Its stance is:
//
//   * Under `PAIDEIA_VGA=std tools/run-qemu.sh`, QEMU synthesises a
//     Bochs stdvga LFB the kernel maps as WC through
//     bochs_stdvga_probe + bochs_stdvga_modeset + bochs_lfb_map
//     (kernel_main.pdx §R101.M2-005 cascade).  The resulting linear
//     framebuffer VA lands in _bochs_stdvga_devices[0]+40.
//   * This witness writes a distinctive u32 sentinel (0xDEADBEEF) at
//     four spatially separated pixel positions in the LFB, mfences
//     to drain the WC write buffer, then reads each position back
//     and asserts equality.  A round-trip failure at any position
//     jumps to the fail arm.
//
// The write-then-mfence-then-readback shape mirrors the R101 stdvga
// checkerboard witness's own readback discipline (its file header
// §Encoder discipline "mfence before read since the WC LFB write ...
// may still be in the CPU's write-combine buffer").
//
// What this witness does NOT do (and honestly cannot on QEMU): it
// does not program the Iris Xe DDI / TRANS / PIPE / PLANE registers,
// does not attach a real T14 panel EDID, and does not verify that a
// physical display column shows the sentinel.  Those are the "run on
// real T14" half of #2419.
//
// -----------------------------------------------------------------------------
// Fingerprint
// -----------------------------------------------------------------------------
//
//   Emits on success (LFB round-trip verified at 4 positions):
//     "R113 M8-039 SCANOUT QEMU OK"
//   Skip (no bochs stdvga device probed OR lfb_va unmapped):
//     "R113 M8-039 SCANOUT QEMU SKIP"
//   Fail (LFB present but round-trip mismatched at some position):
//     "R113 M8-039 SCANOUT QEMU FAIL line=<N>"
//
// -----------------------------------------------------------------------------
// Positions probed
// -----------------------------------------------------------------------------
//
// Framebuffer geometry: 1024x768x32 BGRA, stride 4096 (bochs_stdvga_
// modeset in kernel_main.pdx §R101.M2-005 cascade programs exactly
// this mode).  The four sentinel positions bracket the LFB span so a
// stride miscount, an off-by-one, or a truncated map surfaces here:
//
//   (0, 0)         -- pixel 0 of the frame.
//   (1023, 0)      -- last pixel of first scanline (stride edge).
//   (0, 767)       -- first pixel of last scanline (bottom edge).
//   (1023, 767)    -- last pixel of the frame (bottom-right corner).
//
// -----------------------------------------------------------------------------
// Encoder / SysV discipline
// -----------------------------------------------------------------------------
//
// Labels prefixed `r113so_`.  No `test rN, rN`; no 2-op `imul r, imm`
// (offsets computed by shl + add); no `mov_d reg, reg` (mem writes /
// reads only); mfence around every WC-buffer boundary.  Every nested
// call boundary at rsp%16==0.

module R113M8ScanoutQemuWitness = structure {

  pub let tag_r113_m8_so_ok   : [u8; 28] = "R113 M8-039 SCANOUT QEMU OK\0"
  pub let tag_r113_m8_so_skip : [u8; 30] = "R113 M8-039 SCANOUT QEMU SKIP\0"
  pub let tag_r113_m8_so_fail : [u8; 30] = "R113 M8-039 SCANOUT QEMU FAIL\0"

  pub let mut _r113so_stage : u64 = 0

  // ==========================================================================
  // Helper: LFB pixel round-trip at (lfb_va, x, y) with sentinel 0xDEADBEEF.
  //
  // Returns 0 on match, 1 on mismatch.  Stride 4096 (bochs modeset).
  // No callee-save touched.
  // ==========================================================================

  pub let r113so_pixel_round_trip : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (lfb_va: u64, x: u64, y: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave ν: WC-fenced round-trip check at (x,y). Compute byte offset = (y*1024 + x)*4 via shl 10 + add + shl 2. Store 0xDEADBEEF, mfence, load, cmp -- return 0 on match, 1 on mismatch. Leaf; caller-save only. Labels prefixed r113so_prt_.",
      block: {
        // rdi = lfb_va, rsi = x, rdx = y.
        mov r10, rdx;
        shl r10, 10;                          // y * 1024
        add r10, rsi;                         // + x
        shl r10, 2;                           // * 4 (BGRA)

        add r10, rdi;                         // r10 = LFB byte addr

        mov r11, 0xDEADBEEF;
        mfence;
        mov_d [r10], r11;
        mfence;
        xor rax, rax;
        mov_d rax, [r10];
        mfence;

        mov r11, 0xDEADBEEF;
        cmp rax, r11;
        je  r113so_prt_ok;
        mov rax, 1;
        ret

      r113so_prt_ok:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // witness_r113_m8_scanout_qemu() -> ()
  //
  // Placement: called from kernel_main after witness_r104_iris_xe_flip
  // and witness_r113_m8_kbd_qemu.
  //
  // Register plan:
  //   rbx = lfb_va (survives every nested call)
  //
  // One callee-save push = 8 B; entry rsp%16==8 -> 16 (post-push),
  // %16==0 for every nested call boundary (no additional pad needed;
  // adding one would MISALIGN, mirroring bdev_barrier_flush's own
  // "1*8==16, 16 mod 16==0, no pad needed" idiom).
  // ==========================================================================

  pub let witness_r113_m8_scanout_qemu : () -> () !{mem, sysreg} @{boot, cap} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot, cap},
      justification: "Wave ν (α–τ plan, deferred): paideia-os #2419 QEMU-proxy witness. Skips cleanly when no Bochs stdvga device was probed OR lfb_va unmapped. When active: writes 0xDEADBEEF at 4 spatially-bracketed positions in the LFB, mfences, reads back, asserts equality. Any mismatch jumps fail. One callee-save push (rbx=lfb_va): entry rsp%16==8, post-push rsp%16==0 -- an additional sub rsp,8 would misalign, mirroring bdev_barrier_flush's own 1-push discipline. Labels prefixed r113so_.",
      block: {
        push rbx;

        // ---------- Stage 1: skip guard ----------
        mov rax, 1;
        lea rcx, [rip + _r113so_stage];
        mov [rcx], rax;

        mov rax, [rip + _bochs_stdvga_device_count];
        cmp rax, 0;
        je  r113so_skip;

        // lfb_va at _bochs_stdvga_devices[0]+40; if 0, lfb_map did
        // not run (either the modeset failed or the mmio_map path
        // returned 0 -- both already emit their own fingerprints so
        // this witness only observes, does not re-diagnose).
        lea r10, [rip + _bochs_stdvga_devices];
        mov rbx, [r10 + 40];
        cmp rbx, 0;
        je  r113so_skip;

        // ---------- Stage 2: (0, 0) ----------
        mov rax, 2;
        lea rcx, [rip + _r113so_stage];
        mov [rcx], rax;
        mov rdi, rbx;
        xor rsi, rsi;
        xor rdx, rdx;
        call r113so_pixel_round_trip;
        cmp rax, 0;
        jne r113so_fail;

        // ---------- Stage 3: (1023, 0) ----------
        mov rax, 3;
        lea rcx, [rip + _r113so_stage];
        mov [rcx], rax;
        mov rdi, rbx;
        mov rsi, 1023;
        xor rdx, rdx;
        call r113so_pixel_round_trip;
        cmp rax, 0;
        jne r113so_fail;

        // ---------- Stage 4: (0, 767) ----------
        mov rax, 4;
        lea rcx, [rip + _r113so_stage];
        mov [rcx], rax;
        mov rdi, rbx;
        xor rsi, rsi;
        mov rdx, 767;
        call r113so_pixel_round_trip;
        cmp rax, 0;
        jne r113so_fail;

        // ---------- Stage 5: (1023, 767) ----------
        mov rax, 5;
        lea rcx, [rip + _r113so_stage];
        mov [rcx], rax;
        mov rdi, rbx;
        mov rsi, 1023;
        mov rdx, 767;
        call r113so_pixel_round_trip;
        cmp rax, 0;
        jne r113so_fail;

        // ---------- All four positions verified: emit OK ----------
        mov rdi, 3;                               // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_r113_m8_so_ok];
        call klog_s1;
        jmp r113so_done;

      r113so_skip:
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_r113_m8_so_skip];
        call klog_s1;
        jmp r113so_done;

      r113so_fail:
        mov rdi, 1;                               // LEVEL_ERROR
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_r113_m8_so_fail];
        lea rcx, [rip + k_line];
        lea rax, [rip + _r113so_stage];
        mov r8, [rax];
        call klog_s1_d1;

      r113so_done:
        pop rbx;
        ret
      }
    }
}
