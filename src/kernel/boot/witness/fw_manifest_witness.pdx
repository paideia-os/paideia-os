// src/kernel/boot/witness/fw_manifest_witness.pdx -- R111.M6-022 (#2374)
//
// Kernel-side witness for the ESP-embedded firmware-manifest load
// path landed in the sibling changes to src/boot/uefi_env.pdx +
// src/boot/uefi_stub.pdx.  Runs from r30_platform.pdx's tail (last
// call before pop rbp) at every boot in every mode; emits one of two
// fingerprints depending on whether the UEFI stub found and staged
// the manifest:
//
//   * OK   (fw_manifest_pa != 0 in boot_env @ +120):
//         "FW MANIFEST OK pa=0x<pa> size=<n>"
//         via klog_s1_x1_d1 with tag "FW MANIFEST OK" plus
//         KV[0]=k_pa (hex), KV[1]=k_size (decimal).  UEFI-only --
//         allowlisted in tools/verify-fingerprint-coverage.sh under
//         the same "no OVMF smoke mode boots past ExitBootServices
//         yet" posture as UEFI BRIDGE OK / UEFI PML4 OK / UEFI EBS
//         OK / ROOTFS MOUNT OK type=pdxfs.
//
//   * NONE (fw_manifest_pa == 0 in boot_env, OR _boot_env_pa == 0 on
//         the PVH -kernel boot path where the UEFI stub never ran):
//         "FW MANIFEST NONE" via klog_s1.  No OK token -> invisible
//         to the fingerprint-coverage extractor; asserted in
//         tests/r17/shell-shutdown.golden as an ordered-substring
//         line to pin the ordinary -kernel matrix outcome.
//
// =============================================================================
// SCOPE -- this witness is fingerprint-only
// =============================================================================
//
// R111.M6-022 caps this landing at "fingerprint witness + ESP layout +
// boot_env carry -- no manifest parse, no signature verify, no per-
// blob loader wire-up".  The follow-up milestones land the actual
// consumers: R111.M6-023 (Intel microcode WRMSR path) reads the
// manifest to find the authoritative microcode blob; R111.M6-024
// (GuC/HuC blob staging) reads it to find the GPU firmware pair.
// This witness's role is to prove the plumbing that FEEDS those
// consumers (UEFI-side load + boot_env slot carry + kernel-side
// read) works end-to-end, so the consumer landings have nothing to
// prove about "did the loader hand us bytes?".
//
// The kernel-side witness deliberately does NOT dereference the
// manifest or attempt to validate its contents.  A malformed
// manifest (wrong envelope, truncated tail, missing signature) is a
// downstream consumer concern; this witness's contract is "did the
// loader hand us bytes?", not "is what it handed us a valid signed
// manifest?".  This keeps the witness's failure mode narrow:
// absence of the OK fingerprint means the load chain broke somewhere
// in the UEFI stub or the boot_env carry; presence of OK with a
// garbage manifest is a follow-up milestone's job to catch.
//
// =============================================================================
// WHERE _boot_env_pa COMES FROM
// =============================================================================
//
// Same as rootfs_mount_witness.pdx: _boot_env_pa
// (src/kernel/kernel_main_uefi.pdx L156) is a .bss u64 latched from
// RDI on entry to kernel_main_uefi (the UEFI-path entrypoint).
// Under the PVH -kernel boot path (14-mode default matrix),
// kernel_main_uefi is never called -- control enters kernel_main_64
// directly from src/kernel/boot/entry.pdx `_start`, and _boot_env_pa
// stays at its .bss zero-init value.  This witness's zero-check for
// _boot_env_pa steers to the NONE arm before ever touching
// (env+120).
//
// =============================================================================
// REGISTER + ALIGNMENT LEDGER
// =============================================================================
//
// Caller (r30_platform_run's boot-witness tail) invokes via `call
// fw_manifest_witness_run` with rsp%16 == 8 (the same parity every
// other witness in that function relies on, per r30_platform.pdx
// file header on inline parity restoration).  Body identical in
// shape to rootfs_mount_witness_run:
//
//   push rbx           ; entry %16==8 -> %16==0
//   push r12           ; %16==0 -> %16==8
//
// After the two callee-save pushes, rsp%16 == 8.  Two branches:
//
//   OK path: klog_s1_x1_d1 takes 7 args (v2 spills to [rsp+8]):
//     push r12         ; place fw_manifest_size on stack -> %16==0
//     ; set up 6 arg regs (rdi/rsi/rdx/rcx/r8/r9)
//     call klog_s1_x1_d1
//     add rsp, 8       ; -> %16==8
//
//   NONE path: klog_s1 takes 3 args (all regs):
//     sub rsp, 8       ; pad -> %16==0
//     ; set up 3 arg regs (rdi/rsi/rdx)
//     call klog_s1
//     add rsp, 8       ; -> %16==8
//
// Both paths converge at pop r12; pop rbx; ret with %16==8 at entry
// to ret (return-addr pop -> %16==0 in caller).
//
// Callee-save usage:
//   rbx = fw_manifest_pa    (survives across klog call in OK path)
//   r12 = fw_manifest_size  (survives; consumed by push+add on OK path)
//
// =============================================================================
// LABEL DISCIPLINE
// =============================================================================
//
// All local labels prefixed `fmw_` -- grep audit 2026-09-07: no
// `fmw_` hits anywhere else in src/kernel/.  Reserved so that a
// future enhancement (e.g. actual manifest parse + verify at this
// site, or a variant that reports parsed blob count) can extend the
// witness's label namespace without collision.

module FwManifestWitness = structure {

  // ==========================================================================
  // Fingerprint tags
  //
  // Both tags NUL-terminated but WITHOUT a trailing \n (the klog
  // emitter appends its own \n\0 at line-end; a \n inside the tag
  // would land in the middle of the emit for the OK path, before the
  // KV loop appends " pa=... size=...").
  //
  // OK tag: "FW MANIFEST OK\0"  -- 14 chars + NUL = 15 B.
  //   Contains the OK fingerprint token; verify-fingerprint-coverage.sh
  //   will see it and require an allowlist entry (added at this
  //   landing under the same "UEFI-only" posture as UEFI BRIDGE OK).
  //
  // NONE tag: "FW MANIFEST NONE\0"  -- 16 chars + NUL = 17 B.
  //   No OK token -> invisible to the coverage extractor; asserted in
  //   tests/r17/shell-shutdown.golden as an ordered substring line so
  //   the default -kernel matrix pins the every-boot NONE outcome.
  // ==========================================================================

  pub let tag_fw_manifest_ok   : [u8; 15] = "FW MANIFEST OK\0"
  pub let tag_fw_manifest_none : [u8; 17] = "FW MANIFEST NONE\0"

  // ==========================================================================
  // fw_manifest_witness_run() -> u64
  //
  //   Reads _boot_env_pa (src/kernel/kernel_main_uefi.pdx's u64 latch);
  //   if zero, or if boot_env->fw_manifest_pa @ +120 is zero, emits
  //   FW MANIFEST NONE and returns 0.  Otherwise reads
  //   boot_env->fw_manifest_size @ +128 and emits FW MANIFEST OK with
  //   the pair via klog_s1_x1_d1.  Return value always 0 (caller does
  //   not consume; matches the sibling closer-witness convention of
  //   rootfs_mount_witness et al).
  //
  //   Cross-module references: _boot_env_pa (KernelMainUefi module),
  //   klog_s1 / klog_s1_x1_d1 / k_pa / k_size / SUBSYS_BOOT (klog
  //   subsystem).  All standard, no new confinement gate needed.
  //
  //   Encoder posture per parent-issue #2374 pitfall list:
  //     * No test rN,rN -- every branch is `cmp reg,0; je/jne`.
  //     * No 2-op imul r,imm -- no multiplication here at all.
  //     * No and reg,imm64 -- no masking here.
  //     * No cmp reg,[mem] -- every memory read is staged through rax
  //       before the compare (see fmw_load_env / fmw_load_pa idiom).
  // ==========================================================================
  pub let fw_manifest_witness_run : () -> u64 !{sysreg, mem} @{boot} =
    fn () -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R111.M6-022 (paideia-os #2374): kernel-side witness for the ESP-embedded firmware-manifest load. Reads _boot_env_pa (src/kernel/kernel_main_uefi.pdx L156); a zero (PVH -kernel boot, UEFI finalizer skipped latch) steers to the NONE arm. Otherwise reads boot_env->fw_manifest_pa @ +120 (R111.M6-022 slot per src/boot/uefi_env.pdx BOOT_ENV_OFFSET_FW_MANIFEST_PA); a zero (UEFI boot on an ESP that does not carry /paideia/firmware/manifest.pdxsig, or any failure along the SFS/Open/GetInfo/AllocatePool/Read chain in efi_load_fw_manifest) also steers to NONE. On the OK path (both non-zero) reads boot_env->fw_manifest_size @ +128 and emits `FW MANIFEST OK pa=0x<pa> size=<n>` via klog_s1_x1_d1 (tag_fw_manifest_ok + KV[0]=k_pa hex + KV[1]=k_size decimal). NONE arm emits `FW MANIFEST NONE` via klog_s1 (tag_fw_manifest_none). Return value always 0. Register plan: rbx = fw_manifest_pa (also gates the KV emit), r12 = fw_manifest_size (consumed by the push+add v2-spill on the OK path). Alignment ledger: entry rsp%16==8 (r30_platform_run boot-witness convention); 2 callee-save pushes -> %16==8. OK path: `push r12` (v2 spill) -> %16==0, call klog_s1_x1_d1, add rsp, 8 -> %16==8. NONE path: `sub rsp, 8` pad -> %16==0, call klog_s1, add rsp, 8 -> %16==8. Both paths converge at pop r12; pop rbx; xor rax, rax; ret. Encoder pitfalls: no test rN,rN (all cmp reg,0), no imul r,imm (no multiply), no and reg,imm64, no cmp reg,[mem] (every memory read staged through rax before compare). Cross-module refs: _boot_env_pa (KernelMainUefi), klog_s1 + klog_s1_x1_d1 + k_pa + k_size + SUBSYS_BOOT (klog). Fingerprint policy: OK tag carries the OK token so verify-fingerprint-coverage.sh sees it and requires the sibling ALLOWLIST entry (added at this landing under the same 'UEFI-only reachability' posture as UEFI BRIDGE OK / UEFI PML4 OK / UEFI EBS OK / ROOTFS MOUNT OK type=pdxfs); NONE tag carries no OK token so the coverage gate ignores it, and tests/r17/shell-shutdown.golden pins it as an ordered substring line for the -kernel matrix. Byte-for-byte parallel to rootfs_mount_witness.pdx (R111.M3-013). Labels prefixed fmw_ (grep audit 2026-09-07: no fmw_ hits elsewhere in src/kernel/).",
      block: {
        push rbx;
        push r12;

        // Load _boot_env_pa (staged through rax before compare per the
        // no-cmp-reg-[mem] encoder discipline).  Zero => PVH -kernel
        // boot or UEFI finalizer never latched the pointer; both mean
        // "no boot_env to read from" => NONE.
        mov rax, [rip + _boot_env_pa];
        cmp rax, 0;
        je fmw_none;

        // Load boot_env->fw_manifest_pa @ +120 into rbx.  Zero => no
        // manifest was loaded (either no manifest.pdxsig on the ESP,
        // or the load chain in efi_load_fw_manifest failed at some
        // step).
        mov rbx, [rax + 120];
        cmp rbx, 0;
        je fmw_none;

        // Load boot_env->fw_manifest_size @ +128 into r12.  Not gated
        // on zero: the UEFI-side load already guards against zero-
        // length manifests (see efi_load_fw_manifest Step 4 zero-
        // length check), so if fw_manifest_pa is non-zero here
        // fw_manifest_size is guaranteed non-zero.  If a future
        // loader ever violates that invariant this witness will emit
        // `size=0` on the wire, which is a clearer diagnostic than
        // silent NONE-fallback.
        mov r12, [rax + 128];

        // OK path: klog_s1_x1_d1(3, SUBSYS_BOOT, tag_fw_manifest_ok,
        //                        k_pa, rbx, k_size, [rsp+8]=r12).
        // Push r12 first -- the wrapper reads v2 as its 7th arg from
        // [rbp+16] after its own push rbp (per klog_s1_x1_d1's own
        // justification in src/kernel/core/klog/wrappers.pdx).
        push r12;
        mov rdi, 3;                              // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_fw_manifest_ok];
        lea rcx, [rip + k_pa];                   // k1 hex key
        mov r8, rbx;                             // v1 = fw_manifest_pa
        lea r9, [rip + k_size];                  // k2 dec key
        call klog_s1_x1_d1;
        add rsp, 8;

        jmp fmw_done;

      fmw_none:
        // NONE path: klog_s1(3, SUBSYS_BOOT, tag_fw_manifest_none).
        // sub rsp, 8 pad to reach %16==0 for the call (post-prologue
        // rsp%16==8; sub 8 -> %16==0).
        sub rsp, 8;
        mov rdi, 3;                              // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + tag_fw_manifest_none];
        call klog_s1;
        add rsp, 8;

      fmw_done:
        xor rax, rax;
        pop r12;
        pop rbx;
        ret
      }
    }
}
