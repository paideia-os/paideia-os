  // _stage    — sub-test index 1..40; written before every jne-to-fail.
  // _tail_a   — driver A's canonical tail word (ctx 0x1111, bdf 0x0310,
  //             coherent), built once through dma_tail_pack and reused
  //             across both spawn cycles so the second cycle provably
  //             re-mints the SAME domain shape.
  // _tail_b   — driver B's tail word (ctx 0x2222, bdf 0x0400,
  //             non-coherent). Differs from A in every field.
  // _cursor   — loop cursor for the final residue sweep over all 32
  //             domain rows.
  pub let mut _dma_sw_witness_stage  : u64 = 0
  pub let mut _dma_sw_witness_tail_a : u64 = 0
  pub let mut _dma_sw_witness_tail_b : u64 = 0
  pub let mut _dma_sw_witness_cursor : u64 = 0

  // 16-byte NUL-padded driver name for both fake driver processes.
