  // .bss; overwritten before every jne-to-fail throughout the witness.
  pub let mut _driver_lifecycle_witness_stage : u64 = 0

  // Immutable [u8; 16] rodata name — passed to driver_table_register as
  // the name_ptr argument. 14 printable bytes + 2 NUL bytes so the row
  // rendering ends cleanly if a future op formats it as a C string.
  // Never mutated at runtime; a `let` (not `let mut`) lives in .rodata
  // — the register helper reads two u64s from name_ptr and stores them
  // into the row's [+16] / [+24] slots, so pointer stability across
  // the witness lifetime is all that matters.
  pub let _driver_lifecycle_witness_name : [u8; 16] = "lifecycle-test\0\0"

  // R29.M2-004 (#1026): sub-test stage tracker for the
