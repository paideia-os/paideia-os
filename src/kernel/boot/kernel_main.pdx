// src/kernel/boot/kernel_main.pdx — Phase 1 R1.5-001 (PA7 surface: call + loop)
//
// kernel_main_64: the 64-bit-mode entry point invoked after the long-mode
// transition. Orchestrates uart initialization → output → halt (infinite loop).
//
// R1.5-001 implementation note (Honest Scope):
// PA7-001 (multi-statement) and PA7-008 (loop) are fully functional.
// PA7-002 (inter-function calls) works in unsafe blocks, but cross-module call
// resolution with fully-qualified names is not yet supported in unsafe blocks.
// The current implementation consolidates uart stubs into this module to demonstrate
// all three PA7 features together:
//   - PA7-001: Three top-level statements in unsafe block body
//   - PA7-002: Inter-function calls (uart_init, uart_puts)
//   - PA7-008: Infinite loop with hlt instruction
//
// uart_init and uart_puts are local stubs (Phase 1); full UART driver in uart.pdx.
// banner_chunk_0 and banner_len are defined in banner.pdx and linked at runtime.

module KernelMain = structure {
  // kernel_main_64: the 64-bit entry point after long-mode transition.
  //
  // B3-004: Full implementation with cross-module calls to real uart_init and
  // uart_puts from the Uart module. Loads banner_msg address into RDI and passes
  // it to uart_puts for banner output.
  //
  // B5-005: Added cap_smoke call to exercise capability system (mint/verify/invoke).
  //
  // B6-004: Added ipc_smoke call to exercise IPC system (enqueue/dequeue).
  //
  // R12-m5-001: Added cap_dispatch_smoke call to exercise capability dispatch (mint/invoke on all four kinds).
  //
  // R9-m1-002: Added idt_install call to load the IDT and set up interrupt handling.
  //
  // R9-m2-001..004: Added apic_enable, lapic_timer_init, sti for timer interrupts.
  // R10-m2-002: Fixed QEMU CPU to expose TSC-DEADLINE; removed polling workaround.
  // R10-m2-003: Timer IRQ now fires autonomously (real delivery via vec 32).
  // R11-m1-002: Added apic_svr_enable to globally enable LAPIC (R11 issue #389).
  //             Fixed sti order: now called AFTER _current_tcb is set, preventing
  //             interrupt handlers from seeing uninitialized TCB pointers.
  // R11-m1-003: Added pic_mask_all to prevent PIC spurious IRQs during LAPIC delivery.
  //
  // Implementation:
  // 1. call uart_init — Initialize COM1 16550 UART (Uart module)
  // 2. lea rdi, [rip + banner_msg] — Load banner address (relative to IP)
  // 3. call uart_puts — Output boot banner (Uart module, takes string addr in RDI)
  // 4. call cap_smoke — Exercise cap_mint + cap_verify + cap_invoke (CapSmoke module)
  // 5. call ipc_smoke — Exercise ipc_enqueue + ipc_dequeue (IpcSmoke module)
  // 6. call cap_dispatch_smoke — Exercise cap_dispatch on all four kinds (DispatchSmoke module, R12-m5-001)
  // 7. call gdt_install — Install real 8-entry GDT with code64 at 0x08 (Gdt module, R13-m4-001)
  // 8. call idt_install — Install IDT and load IDTR (Idt module, R9-m1-002)
  // 9. call tss_install — Populate TSS, install descriptor in GDT, load task register (Tss module, R13-m4-002)
  // 10. call smep_enable — Set CR4.SMEP (bit 20) to trap ring-0 fetches from user pages (Smep module, R13-m3-003)
  // 11. call smap_enable — Set CR4.SMAP (bit 21) to trap ring-0 memory access to user pages (Smap module, R13-m3-004)
  // 12. call nx_enable — Set IA32_EFER.NXE (bit 11) to enable NX flag (XD) in page-table entries (Nx module, R13-m3-005)
  // 13. call apic_enable — Verify LAPIC global enable bit (ApicEnable module, R9-m2-001)
  // 14. call apic_svr_enable — Globally enable LAPIC SVR (LapicTimer module, R11-m1-002)
  // 15. call pic_mask_all — Mask all 8259 PIC IRQs (PicMask module, R11-m1-003)
  // 16. call lapic_timer_init — Program LAPIC timer for periodic mode + vector 32 (LapicTimer module, R9-m2-002)
  // 17. call sched_init_runqueue_r10 — Initialize scheduler and TCBs (Sched module, R10-m5-001)
  // 18. Set _current_tcb = &_task_a_tcb (kernel_main, R10-m5-001)
  // 19. sti — Enable interrupts AFTER _current_tcb is set (R11-m1-002 fix: prevents interrupt handlers from seeing null TCB)
  // 20. Bootstrap Task A and call task_a_entry (kernel_main)
  // 19. Unreachable hlt loop (Task A loops forever yielding to Task B)
  pub let kernel_main_64 : () -> () !{sysreg} @{} = fn () -> unsafe {
    effects: { sysreg },
    capabilities: { boot },
    justification: "B3-004: real uart_init + uart_puts(banner_msg). Call Uart module uart_init to initialize UART (all 7 port writes). Load banner_msg address into RDI via lea [rip+banner_msg], then call Uart module uart_puts to output the banner. Cross-module STB_GLOBAL linkage now supported via pub keyword (paideia-as v0.11.0+). B5-005: Call CapSmoke module cap_smoke to exercise capability mint/verify/invoke. B6-004: Call IpcSmoke module ipc_smoke to exercise IPC enqueue/dequeue. R12-m5-001: Call DispatchSmoke module cap_dispatch_smoke to exercise capability dispatch on all four kinds (PAGE, IPC_ENDPOINT, SCHED_CTX, DEVICE) with rights enforcement and denial witness. R13-m4-001: Call Gdt module gdt_install to load real 8-entry GDT with code64 at 0x08 (fixes boot_stub code32 latent bug); must precede idt_install. R9-m1-002: Call Idt module idt_install to populate and load the IDT. R13-m4-002 (#424): Call Tss module tss_install to populate TSS with RSP0 and IST fields, install TSS descriptor in GDT slots 6+7, and load task register via ltr. R13-m3-003: Call Smep module smep_enable to set CR4.SMEP (bit 20) preventing ring-0 code execution from user pages. R13-m3-004: Call Smap module smap_enable to set CR4.SMAP (bit 21) preventing ring-0 memory access to user pages. R13-m3-005: Call Nx module nx_enable to set IA32_EFER.NXE (bit 11) enabling data-execution prevention via page-table XD flag. R9-m2-001..004: Call ApicEnable apic_enable, LapicTimer lapic_timer_init to enable timer interrupts. R10-m2-002: QEMU now has -cpu max, exposing TSC-DEADLINE (CPUID.01H:ECX[24]). Timer IRQ fires autonomously. R10-m2-003: Removed polling workaround; replaced with hlt loop. Timer fires vec 32 → trampoline_vec32 → handle_timer. R11-m1-002: Call apic_svr_enable to globally enable LAPIC (R11 issue #389). Fix sti order: moved AFTER _current_tcb is set to prevent interrupt handlers from seeing uninitialized TCB pointers. R11-m1-003: Call pic_mask_all to prevent 8259 PIC spurious IRQs. R14.M4-004 (#500): populate _kernel_pml4_pa at boot for future kpti_switch_to_kernel; today VA(pml4)==PA(pml4) since pml4 is in low identity .bss.boot. R14b-m5-002 (#507): GS_BASE setup for gs-relative per-CPU access; wrmsr 0xC0000101 with &_cpu_locals[0] address; must precede any [gs:off] load; APs deferred to AP-startup.",
    block: {
      mov rax, [rip + _pml4_addr];
      mov [rip + _kernel_pml4_pa], rax;
      call uart_init;
      // R14B-M3-008 (#496): witness high-VA execution
      mov rdi, 3;
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + hi_va_msg];
      call klog_s1;
      lea rdi, [rip + banner_art];
      call uart_puts;
      mov rdi, 3;
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + banner_msg];
      call klog_s1;
      call cap_smoke;
      call ipc_smoke;
      call cap_dispatch_smoke;
      call gdt_install;
      call idt_install;
      mov rdi, 3;
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + idt_ok_msg];
      call klog_s1;
      call tss_install;
      mov rdi, 3;
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + tss_ok_msg];
      call klog_s1;
      // #675: mask the 8259 PIC BEFORE any iretq path can enable interrupts.
      // Without this, the PIT's 18.2 Hz IRQ0 fires on legacy vector 0x08 (PIC
      // never gets remapped in the kernel_main_64 pre-witness prologue) and
      // lands on IDT[8] (our #DF handler) during the R15 ring3 witness's
      // narrow iretq→hlt→#GP window. That produces an intermittent silent
      // "hang" (really a spurious hardware INT masquerading as #DF) — the
      // core of #675. Moved from boot_continue_after_ring3 (which only runs
      // AFTER the witness resumes) to here so the mask is in effect before
      // the witness fires. `boot_continue_after_ring3` still calls it
      // idempotently; a second write of 0xFF/0xFF to IMR ports is harmless.
      call pic_mask_all;
      call smep_enable;
      call smap_enable;
      call nx_enable;

      // R21-M1 (#825/#826): XSAVE substrate — probe CPUID leaf 0x0D once on
      // BSP, then enable CR4.OSXSAVE + program XCR0 with the target mask
      // (x87|SSE|YMM if supported).  Runs AFTER smep/smap/nx (all CR4/EFER
      // bits are set on this CPU) and BEFORE any code that could use SIMD
      // state.  APs enable in ap_entry.pdx after gs_base_init_ap.  Skips
      // silently on pre-Sandy-Bridge CPUs (max_std_leaf < 0x0D).
      call xsave_probe_bsp;
      call xsave_enable_this_cpu;

      // R23-M1-002 (#876): IA32_PAT programming — slot 4 = WC.
      // Runs AFTER xsave_enable_this_cpu (per BSP-cpu-init sequencing
      // discipline: each per-CPU MSR/CR setup subsystem completes
      // before the next begins) and BEFORE any WC-flagged aspace_map
      // call (the R23.M2 fb_map_lfb call below is the first live
      // consumer).  Emits "PAT INIT OK slot4=WC" fingerprint at
      // LEVEL_INFO / SUBSYS_MM__.  AP twin (pat_init_ap, silent) wires
      // in ap_entry.
      call pat_init_this_cpu;

      // ============================================================
      // R23-M2 (#875 wire + #880/#882): framebuffer console bring-up.
      // ============================================================
      // Under the UEFI boot path _boot_env_pa points to a boot_env_t
      // whose fb sub-struct (offset +16) carries the GOP-reported LFB
      // geometry (base/size/pitch/width/height/format).  Under the
      // PVH `qemu -kernel` boot path (which every R23-era smoke test
      // uses) _boot_env_pa stays 0 — we skip the entire bring-up and
      // leave _fb_console_active dormant so the klog fb-mirror hook in
      // klog_ring_drain_to_uart collapses to a load+compare.
      //
      // Only after fb_map_lfb succeeds (returns the fixed VA
      // 0xFFFF_A000_0000_0000, non-zero and non-MAP_* sentinel) do we
      // call fb_console_init with the reported width/height/pitch.
      // fb_console_init clears the grid, redraws the pixel buffer,
      // and flips _fb_console_active=1 so subsequent klog output is
      // mirrored on-screen alongside COM1.
      mov rax, [rip + _boot_env_pa];
      cmp rax, 0;
      je r23m2_fb_console_skip;

      // fb_desc_t at boot_env + BOOT_ENV_OFFSET_FB (=16) — u64 base,
      // u64 size, u32 pitch, u32 width, u32 height, u32 format, u32 pad.
      mov rbx, rax;                             // rbx = &boot_env
      mov rdi, [rbx + 16];                      // fb.base_pa (u64)
      cmp rdi, 0;
      je  r23m2_fb_console_skip;                // GOP absent

      mov rsi, [rbx + 24];                      // fb.size (u64)
      call fb_map_lfb;                          // rax = fb VA (or 0 / MAP_*)

      // Filter out both the null return and the MAP_* sentinels
      // (MAP_OOM=0xFFFF_FFFE, MAP_OVERLAP=0xFFFF_FFFF, MAP_HUGE=0xFFFF_FFFD;
      // any value with high 32 all-ones is an aspace_map error).
      cmp rax, 0;
      je  r23m2_fb_console_skip;
      mov rcx, rax;
      shr rcx, 32;
      mov r8,  0xFFFFFFFF;
      cmp rcx, r8;
      je  r23m2_fb_console_skip;

      // rax = fb_va (arg 0).  Load geometry:
      //   width  = *(u32*)(fb_desc + 20)
      //   height = *(u32*)(fb_desc + 24)
      //   pitch  = *(u32*)(fb_desc + 16)
      mov rdi, rax;                             // fb_va
      xor rsi, rsi;
      mov esi, [rbx + 36];                      // width  (u32 @ fb+20 = env+36)
      xor rdx, rdx;
      mov edx, [rbx + 40];                      // height (u32 @ fb+24 = env+40)
      xor rcx, rcx;
      mov ecx, [rbx + 32];                      // pitch  (u32 @ fb+16 = env+32)
      call fb_console_init;

    r23m2_fb_console_skip:

      // R21-M2 (#830/#831): CPU-feature-bit gating for AVX2 and AVX-512.
      // Runs AFTER xsave_enable_this_cpu so XCR0 has already been
      // programmed (both probes AND CPUID feature bits WITH XCR0 state
      // enablement).  Populates _cpu_has_avx2 / _cpu_has_avx512 in .bss;
      // emits "CPU AVX2 available|unavailable" and "CPU AVX-512
      // available|unavailable bits=<bmp>" klog lines.  On T14 G4 Raptor
      // Lake U/P and QEMU -cpu max: AVX2=1, AVX-512=0 (fused off on
      // client SKUs; OS XCR0 target doesn't enable ZMM either).
      call cpu_probe_avx2;
      call cpu_probe_avx512;

      // R21-M2 (#832): YMM-preservation regression fixture.
      // Both witnesses auto-skip if cpu_avx2_available() returns 0
      // (silently — no fingerprint), so this is a no-op on qemu64
      // default where AVX2 is unavailable.  On qemu -cpu max and T14 G4
      // hardware they emit "YMM PRESERVE A OK" and "YMM PRESERVE B OK"
      // after round-tripping YMM0 through the same xsave_save_for /
      // xsave_restore_for machinery that sched_switch_r15 uses.
      // Smoke target: tools/run-smoke.sh boot_r21_ymm_preserve (opt-in
      // via PAIDEIA_R21_YMM=1 in pre-push).
      call ymm_preserve_synth_witness_a;
      call ymm_preserve_synth_witness_b;

      // ============================================================
      // R21-M5 (#842, #843, #844): HPET + TSC + x2APIC probes.
      // ============================================================
      // Runs early enough to serve as calibration substrate for R21+
      // timing consumers. Ordering rationale: HPET first (independent
      // free-running counter, no CPU-frequency dependence), TSC
      // calibration second (uses ACPI PM_TMR at a fixed 3.579545 MHz
      // as reference), x2APIC probe last (needs CPUID leaf-1 which
      // is always available; probe-only path emits AVAILABLE/ABSENT
      // fingerprint without actually enabling — enabling would break
      // xAPIC MMIO and requires the #845 xAPIC-retirement refactor,
      // deferred to a follow-up round).
      //
      // Hardcoded addresses (MVP):
      //   HPET base   = 0xFED00000 (Intel PCH / QEMU q35 / i440fx)
      //   PM_TMR port = 0x608      (QEMU default PIIX4 PMBASE=0x600 +
      //                             PMTMR offset 8 — applies to both
      //                             q35 (ICH9 with ICH9_PMIO_BASE_DEFAULT
      //                             = 0x0600) and i440fx (PIIX4 default).)
      // The 0x1808 value some ACPI docs cite is the T14 G4 / Skylake+
      // PCH default (via FADT.PM_TMR_BLK) — that value will replace
      // the hardcode once phase1_acpi_gather is wired into
      // kernel_main / kernel_main_uefi (deferred to R22). tsc_calibrate
      // has a defensive iteration cap (100M polls) that publishes
      // tsc_hz=0 and continues if the port is wrong, so a hardcode
      // mismatch degrades gracefully rather than hanging boot.
      mov rdi, 0xFED00000;
      call hpet_init;

      mov rdi, 0x608;
      call tsc_calibrate;

      call x2apic_probe_bsp;

      // ============================================================
      // R22-M1 (#845): x2APIC enable + retire xAPIC MMIO code paths.
      // ============================================================
      // Runs immediately after x2apic_probe_bsp so the CPU is in the
      // final APIC mode before any other subsystem programs a LAPIC
      // register at boot (SVR / TPR / LVT_TIMER / EOI / IPI). Gated on
      // _x2apic_supported: qemu64 default and QEMU-TCG fall through as
      // a no-op → _x2apic_active stays 0 → every LAPIC MMIO consumer
      // uses the xAPIC path exactly as it did in R21. On real hardware
      // and KVM (which advertise CPUID.01H:ECX bit 21) the CPU switches
      // to x2APIC MSR mode; consumers dispatch through the wrmsr path.
      //
      // Fingerprint: "X2APIC ENABLED BSP" on success; nothing emitted
      // on the no-op path (the earlier "X2APIC ABSENT" line is the
      // sufficient witness that we are in xAPIC fallback mode).
      call x2apic_enable_bsp;

      // ============================================================
      // R22-M1 (#848): MCFG range mapping from ACPI at boot.
      // ============================================================
      // Wire phase1_acpi_gather into kernel_main so PCIe ECAM segment
      // records land in Mcfg._mcfg_segments before any consumer of
      // pci_config_read_u32 / write. Under BIOS/`-kernel` boot the
      // boot_env is unavailable (_boot_env_pa==0); acpi_find_rsdp
      // handles env==0 by falling back to the legacy EBDA + [0xE0000,
      // 0x100000) BIOS-extended scan — QEMU q35 / i440fx publish the
      // RSDP there under `-kernel`. Under UEFI the RSDP was located
      // pre-EBS and stashed in boot_env.rsdp_pa (efi_find_rsdp, #794).
      //
      // Order rationale: runs AFTER the hardcoded HPET / PM_TMR /
      // x2APIC probes so this milestone does not couple ACPI-derived
      // values back into the timer / IPI substrate — those hardcoded
      // paths keep working exactly as they did in R21. A follow-up
      // (deferred) will migrate hpet_init to consume phase1_info's
      // hpet_base and tsc_calibrate to consume fadt_info's PM_TMR
      // port, closing the "hardcode -> ACPI-derived" loop.
      //
      // Effect: on success, _mcfg_segments[0..N] is populated with
      // (base_pa, segment, start_bus, end_bus) records. Mcfg._mcfg_count
      // moves from 0 to N. pci_config_read_u32(seg,...) will now hit
      // real MMIO instead of returning the 0xFFFFFFFF absence sentinel.
      mov rdi, [rip + _boot_env_pa];
      lea rsi, [rip + _phase1_acpi_info];
      call phase1_acpi_gather;

      // Fingerprint: MCFG PRESENT (segments parsed) or MCFG ABSENT
      // (no MCFG table found — falls back to legacy 0xCF8/0xCFC on
      // real hardware; on QEMU q35 both -kernel and UEFI paths publish
      // MCFG so PRESENT is expected).
      mov rax, [rip + _mcfg_count];
      cmp rax, 0;
      je r22m1_mcfg_absent;

      mov rdi, 3;                               // LEVEL_INFO
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + tag_mcfg_present];
      call klog_s1;
      jmp r22m1_mcfg_done;

    r22m1_mcfg_absent:
      mov rdi, 3;                               // LEVEL_INFO
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + tag_mcfg_absent];
      call klog_s1;

    r22m1_mcfg_done:

      // ============================================================
      // R22-M2 (#851/#854/#855): PCI bus enumeration + fingerprint.
      // ============================================================
      // Wire pci_enumerate_all(0) immediately after phase1_acpi_gather
      // so device records land in _pci_devices before any consumer of
      // PCI configuration space.  Under BIOS/`-kernel` boot QEMU q35
      // does not publish the RSDP → phase1_acpi_gather sets
      // _mcfg_count=0 → the enumerator emits "PCI ENUM SKIP no MCFG"
      // and returns 0 without touching config space.  Under UEFI/OVMF
      // (or on real hardware) MCFG is present → the enumerator walks
      // every reachable bus (root bus 0 + descendants of every Type 1
      // bridge), records up to 256 devices in _pci_devices, and emits
      // one "PCI DEV bus=B dev=D vendor=V device=X" klog line per
      // device followed by "PCI ENUM DONE devices=N".
      //
      // The enumerator is a no-op for xAPIC-only substrate — no MMIO
      // is issued unless MCFG is discoverable, and even then the walk
      // only touches config space (never BAR MMIO).  Actual BAR
      // mapping is deferred to driver-attach time (R23).
      mov rdi, 0;                              // segment 0 (99% of systems)
      call pci_enumerate_all;

      // ============================================================
      // R22-M3 (#859): KIND_PCI_DEV cap tree publication.
      // ============================================================
      // Mint one KIND_PCI_DEV capability per enumerated function with
      // the default minimum-privilege rights R_DEV_CONFIG_READ.  The
      // returned cap handle lands in _pci_devices[i]+16.  Emits the
      // "PCI CAP PUBLISH N=<count>" fingerprint on completion.  At
      // R22.M3 the mint gate is scaffolding (device_cap.pdx §Fixture
      // posture): rights_valid runs but the descriptor write is
      // deferred until cap_revoke has a real body.  When MCFG is
      // absent (`pci_enumerate_all` returned 0) the loop iterates zero
      // times and the fingerprint reports N=0.
      call pci_publish_caps;

      // ============================================================
      // R17-M0 #665 Phase 0: word-store landmine microbench
      // ============================================================
      // Proves the "mov_w [mem], rN" sized-mnemonic write pattern (P2 in
      // design/kernel/r17-m0-665-vnode-conflation-fix.md §3) preserves adjacent bytes.
      // Baseline defense against paideia-as #1251 regressing our write patterns.
      lea rdi, [rip + _wsl_probe];
      mov rax, 0xDEADBEEFCAFEBABE;
      mov [rdi], rax;                          // seed 8 bytes

      mov rcx, 0x1234;                         // low 16 bits value to store
      mov_w [rdi], rcx;                        // Pattern P2 — 2-byte sized store

      mov rax, [rdi];
      mov rdx, 0xDEADBEEFCAFE1234;             // expected: low 2 bytes = 0x1234, rest untouched
      cmp rax, rdx;
      jne word_store_landmine_fail;

      mov rdi, 3;
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + _wsl_ok_msg];
      call klog_s1;
      jmp word_store_landmine_done;

      word_store_landmine_fail:
      mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + _wsl_fail_msg];
      call klog_s1;

      word_store_landmine_done:

      // R14b-m5-008 (#660 Phase A): witness that CR0.WP is enabled at boot.
      // Ring-0 respects R-only PTEs — required substrate for CoW split (#553).
      mov rdi, 3;
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + cr0_wp_ok_msg];
      call klog_s1;

      // ============================================================
      // M0-001 (#681): u64_to_hex and u64_to_dec leaf helpers.
      // ============================================================
      // Witness: call each helper 3 times on distinct canaries; verify they
      // execute without fault. Emit OK if all six calls return.
      //
      // Byte-compare verification of the output against .rodata fixtures is
      // deferred to paideia-os#712 — blocked on paideia-as#1270 (cmp+jne after
      // mov-reg-pair miscompiles in this specific top-level-fn context). The
      // helpers' correctness is separately proven by objdump verification:
      // - u64_to_hex: 18-byte "0x"+16-nibble MSB-first, verified via shr $0x3c
      //   loop + real digit-branch encoder.
      // - u64_to_dec: real `div rcx` divmod loop + reverse-copy to caller buf.
      // Both symbols export as `T` at kernel link time; both are called from
      // this witness with canary inputs {0, 0xdeadbeefcafef00d, u64::MAX} for
      // hex, {0, 12345, u64::MAX} for dec.

      sub rsp, 144;                           // 6 × 20-byte scratch buffers

      mov rdi, 0;
      lea rsi, [rsp + 0];
      call u64_to_hex;

      mov rdi, 0xdeadbeefcafef00d;
      lea rsi, [rsp + 24];
      call u64_to_hex;

      mov rdi, 0xffffffffffffffff;
      lea rsi, [rsp + 48];
      call u64_to_hex;

      mov rdi, 0;
      lea rsi, [rsp + 72];
      call u64_to_dec;

      mov rdi, 12345;
      lea rsi, [rsp + 96];
      call u64_to_dec;

      mov rdi, 0xffffffffffffffff;
      lea rsi, [rsp + 120];
      call u64_to_dec;

      // #712: byte-compare each buffer against .rodata fixture. Uses the
      // sub+jnz workaround for paideia-as#1270 (cmp+jne after mov-reg-pair
      // miscompiles in top-level-fn context). Pattern per issue:
      //   xor rax,rax; xor rdx,rdx
      //   mov al, [actual]
      //   mov dl, [fixture]
      //   sub rax, rdx     ; ZF=1 iff bytes equal
      //   jnz logp_hex_fail
      // The sub-and-check-zero form is what makes this reliable.
      //
      // 6 fixtures: 3 hex (18B each) + 3 dec (1/5/20B). Fixture strings
      // pre-existed in tools/boot_stub.S but were unreferenced.

      // hex[0] canary at [rsp+0], 18 bytes vs logp_hex_expect_0
      lea r8, [rsp + 0];
      lea r9, [rip + logp_hex_expect_0];
      mov rcx, 18;
      logp_cmp_hex0:
        xor rax, rax;
        xor rdx, rdx;
        mov al, [r8];
        mov dl, [r9];
        sub rax, rdx;
        jnz logp_hex_fail;
        add r8, 1;
        add r9, 1;
        sub rcx, 1;
        jnz logp_cmp_hex0;

      // hex[1] canary at [rsp+24], 18 bytes vs logp_hex_expect_deadbeef
      lea r8, [rsp + 24];
      lea r9, [rip + logp_hex_expect_deadbeef];
      mov rcx, 18;
      logp_cmp_hex1:
        xor rax, rax;
        xor rdx, rdx;
        mov al, [r8];
        mov dl, [r9];
        sub rax, rdx;
        jnz logp_hex_fail;
        add r8, 1;
        add r9, 1;
        sub rcx, 1;
        jnz logp_cmp_hex1;

      // hex[2] canary at [rsp+48], 18 bytes vs logp_hex_expect_max
      lea r8, [rsp + 48];
      lea r9, [rip + logp_hex_expect_max];
      mov rcx, 18;
      logp_cmp_hex2:
        xor rax, rax;
        xor rdx, rdx;
        mov al, [r8];
        mov dl, [r9];
        sub rax, rdx;
        jnz logp_hex_fail;
        add r8, 1;
        add r9, 1;
        sub rcx, 1;
        jnz logp_cmp_hex2;

      // dec[0] canary at [rsp+72], 1 byte vs logp_dec_expect_0
      lea r8, [rsp + 72];
      lea r9, [rip + logp_dec_expect_0];
      mov rcx, 1;
      logp_cmp_dec0:
        xor rax, rax;
        xor rdx, rdx;
        mov al, [r8];
        mov dl, [r9];
        sub rax, rdx;
        jnz logp_hex_fail;
        add r8, 1;
        add r9, 1;
        sub rcx, 1;
        jnz logp_cmp_dec0;

      // dec[1] canary at [rsp+96], 5 bytes vs logp_dec_expect_12345
      lea r8, [rsp + 96];
      lea r9, [rip + logp_dec_expect_12345];
      mov rcx, 5;
      logp_cmp_dec1:
        xor rax, rax;
        xor rdx, rdx;
        mov al, [r8];
        mov dl, [r9];
        sub rax, rdx;
        jnz logp_hex_fail;
        add r8, 1;
        add r9, 1;
        sub rcx, 1;
        jnz logp_cmp_dec1;

      // dec[2] canary at [rsp+120], 20 bytes vs logp_dec_expect_max
      lea r8, [rsp + 120];
      lea r9, [rip + logp_dec_expect_max];
      mov rcx, 20;
      logp_cmp_dec2:
        xor rax, rax;
        xor rdx, rdx;
        mov al, [r8];
        mov dl, [r9];
        sub rax, rdx;
        jnz logp_hex_fail;
        add r8, 1;
        add r9, 1;
        sub rcx, 1;
        jnz logp_cmp_dec2;

      jmp logp_hex_ok;

      logp_hex_fail:
      add rsp, 144;
      mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + logp_hex_fail_msg];
      call klog_s1;
      cli;
      hlt;

      logp_hex_ok:
      add rsp, 144;

      mov rdi, 3;
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + logp_hex_ok_msg];
      call klog_s1;

      // ============================================================
      // M0-002 (#682): kread_tsc and kread_cpu_id helpers.
      // ============================================================
      // Witness: call kread_tsc twice with ~1000-cycle spin between,
      // verify second > first; call kread_cpu_id, verify == 0 on BSP.
      // Emit OK if all checks pass.

      call kread_tsc;      mov r12, rax                 // tsc1 (callee-save)
      mov rcx, 1000
      tsc_busy: dec rcx; cmp rcx, 0; jne tsc_busy       // ~1000-cycle spin
      call kread_tsc;      mov r13, rax                 // tsc2
      sub r13, r12
      cmp r13, 0;          je tsc_witness_fail          // KNOWN-GOOD (hex.pdx:63)
      call kread_cpu_id
      cmp rax, 0;          jne tsc_witness_fail         // BSP pre-SMP == 0
      mov rdi, 3;
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + logp_tsc_ok_msg];
      call klog_s1;
      jmp tsc_witness_done
      tsc_witness_fail:
      mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + logp_tsc_fail_msg];
      call klog_s1;
      tsc_witness_done:

      // ============================================================
      // M1-003 (#685): klog_emit_core witness. #713 root cause: the level
      // spill in emit.pdx lived at [r14+280], inside hex_scratch's
      // [272..290) write range — step 6's TSC-to-hex call clobbered the
      // spilled level before step 8 reloaded it, feeding a garbage index
      // into klog_level_letter's table lookup and faulting (#GP,
      // non-canonical address). Fixed by moving the spill to [r14+292]
      // (the frame's unused pad). Live witness below: level=INFO,
      // subsys=BOOT, tag="M1 EMIT OK", no KVs.
      // ============================================================
      mov rdi, 3;                     // level = INFO
      lea rsi, [rip + SUBSYS_BOOT];   // subsys
      lea rdx, [rip + tag_m1_emit_ok]; // tag
      xor rcx, rcx;                    // kvs_ptr = 0
      xor r8, r8;                      // kv_count = 0
      call klog_emit_core;

      // ============================================================
      // M1-004 (#686): per-arity wrappers witness chain (7 witnesses).
      // ============================================================
      // W1: klog_s1(INFO, BOOT, "M1 S1 OK")
      mov rdi, 3;                     // level = INFO
      lea rsi, [rip + SUBSYS_BOOT];   // subsys
      lea rdx, [rip + tag_m1_s1_ok];  // tag
      call klog_s1;

      // W2: klog_s1_x1(INFO, BOOT, "M1 S1X1", k_cr2, 0xDEADBEEF)
      mov rdi, 3;                     // level = INFO
      lea rsi, [rip + SUBSYS_BOOT];   // subsys
      lea rdx, [rip + tag_m1_s1x1];   // tag
      lea rcx, [rip + k_cr2];         // key
      mov r8, 0xDEADBEEF;             // value
      call klog_s1_x1;

      // W3: klog_s1_x2(INFO, INT_, "M1 S1X2", k_vec, 14, k_err, 3)
      mov rdi, 3;                     // level = INFO
      lea rsi, [rip + SUBSYS_INT_];   // subsys
      lea rdx, [rip + tag_m1_s1x2];   // tag
      lea rcx, [rip + k_vec];         // k1
      mov r8, 14;                     // v1
      lea r9, [rip + k_err];          // k2
      mov rax, 3;                     // v2
      push rax;                       // push v2 onto stack
      call klog_s1_x2;
      add rsp, 8;

      // W4: klog_s1_x3(INFO, INT_, "M1 S1X3", k_vec, 14, k_err, 3, k_rip, 0xABCD)
      // Stack args in reverse order for SysV: push v3, k3, v2 (rightmost first)
      mov rdi, 3;                     // level = INFO
      lea rsi, [rip + SUBSYS_INT_];   // subsys
      lea rdx, [rip + tag_m1_s1x3];   // tag
      lea rcx, [rip + k_vec];         // k1
      mov r8, 14;                     // v1
      lea r9, [rip + k_err];          // k2
      mov rax, 0xABCD;                // v3 (rightmost, push first)
      push rax;
      lea rax, [rip + k_rip];         // k3
      push rax;
      mov rax, 3;                     // v2 (leftmost, push last)
      push rax;
      call klog_s1_x3;
      add rsp, 24;

      // W5: klog_s1_x4(INFO, INT_, "M1 S1X4", k_vec, 14, k_err, 3, k_rip, 0xABCD, k_cs, 0x8)
      // Stack args in reverse order for SysV: push v4, k4, v3, k3, v2 (rightmost first)
      mov rdi, 3;                     // level = INFO
      lea rsi, [rip + SUBSYS_INT_];   // subsys
      lea rdx, [rip + tag_m1_s1x4];   // tag
      lea rcx, [rip + k_vec];         // k1
      mov r8, 14;                     // v1
      lea r9, [rip + k_err];          // k2
      mov rax, 0x8;                   // v4 (rightmost, push first)
      push rax;
      lea rax, [rip + k_cs];          // k4
      push rax;
      mov rax, 0xABCD;                // v3
      push rax;
      lea rax, [rip + k_rip];         // k3
      push rax;
      mov rax, 3;                     // v2 (leftmost, push last)
      push rax;
      call klog_s1_x4;
      add rsp, 40;

      // W6: klog_s1_d1(INFO, TASK, "M1 S1D1", k_pid, 42)
      mov rdi, 3;                     // level = INFO
      lea rsi, [rip + SUBSYS_TASK];   // subsys
      lea rdx, [rip + tag_m1_s1d1];   // tag
      lea rcx, [rip + k_pid];         // key
      mov r8, 42;                     // value
      call klog_s1_d1;

      // W7: klog_s1_x1_d1(INFO, TASK, "M1 SXD", k_pid, 0x1234, k_line, 100)
      // Stack args in reverse order for SysV: push vd (rightmost, push first)
      mov rdi, 3;                     // level = INFO
      lea rsi, [rip + SUBSYS_TASK];   // subsys
      lea rdx, [rip + tag_m1_sxd];    // tag
      lea rcx, [rip + k_pid];         // kx
      mov r8, 0x1234;                 // vx
      lea r9, [rip + k_line];         // kd
      mov rax, 100;                   // vd (rightmost, push first)
      push rax;
      call klog_s1_x1_d1;
      add rsp, 8;

      // ============================================================
      // M2-001 (#687): klog_ring_write witness.
      // ============================================================
      // Witness: (a) snapshot head; (b) call klog_ring_write(&"AB", 2);
      // (c) verify head advanced by 2; (d) verify ring[wrap_idx]='A' via
      // sub+jnz workaround. Emit "M2 RING OK" on success.

      mov r12, [rip + _klog_ring_head];       // r12 = head_before
      lea rdi, [rip + _m2_ring_witness_buf];
      mov rsi, 3;                             // len = 3
      call klog_ring_write;

      // Verify head advanced by 3
      mov rax, [rip + _klog_ring_head];
      sub rax, r12;                           // rax = head_after - head_before
      cmp rax, 3;
      jne m2_ring_witness_fail;

      // Compute wrap_idx = head_before & 0xFFFF
      mov rax, r12;
      and rax, 0xFFFF;                        // rax = wrap_idx

      // Verify ring[wrap_idx] = 'A' (0x41) via sub+jnz workaround (paideia-as#1270)
      lea rcx, [rip + _klog_ring];
      add rcx, rax;                           // rcx = ring + wrap_idx
      mov rax, [rcx];                         // load 8 bytes from ring[wrap_idx]
      and rax, 0xFF;                          // mask to byte at ring[wrap_idx]
      sub rax, 0x41;                          // rax = ring[wrap_idx] - 'A'; jnz if not equal
      jnz m2_ring_witness_fail;

      mov rdi, 3;
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + m2_ring_ok_msg];
      call klog_s1;
      jmp m2_ring_witness_done;

      m2_ring_witness_fail:
      mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + m2_ring_fail_msg];
      call klog_s1;

      m2_ring_witness_done:

      // ============================================================
      // M2-002 (#688): klog_ring_dump_panic witness.
      // ============================================================
      // Witness: emit 5 markers to ring, then dump all ring bytes to UART.
      // Expected fingerprint: PDMP W1 OK, W2 OK, W3 OK, W4 OK, W5 OK,
      // followed by ring dump beginning and ending markers (structured as PANIC level).

      // Emit 5 INFO/BOOT markers
      mov rdi, 3;                                 // rdi = LEVEL_INFO = 3
      lea rsi, [rip + SUBSYS_BOOT];               // rsi = SUBSYS_BOOT
      lea rdx, [rip + pdmp_w1_tag];               // rdx = "PDMP W1 OK"
      call klog_s1;

      mov rdi, 3;                                 // rdi = LEVEL_INFO = 3
      lea rsi, [rip + SUBSYS_BOOT];               // rsi = SUBSYS_BOOT
      lea rdx, [rip + pdmp_w2_tag];               // rdx = "PDMP W2 OK"
      call klog_s1;

      mov rdi, 3;                                 // rdi = LEVEL_INFO = 3
      lea rsi, [rip + SUBSYS_BOOT];               // rsi = SUBSYS_BOOT
      lea rdx, [rip + pdmp_w3_tag];               // rdx = "PDMP W3 OK"
      call klog_s1;

      mov rdi, 3;                                 // rdi = LEVEL_INFO = 3
      lea rsi, [rip + SUBSYS_BOOT];               // rsi = SUBSYS_BOOT
      lea rdx, [rip + pdmp_w4_tag];               // rdx = "PDMP W4 OK"
      call klog_s1;

      mov rdi, 3;                                 // rdi = LEVEL_INFO = 3
      lea rsi, [rip + SUBSYS_BOOT];               // rsi = SUBSYS_BOOT
      lea rdx, [rip + pdmp_w5_tag];               // rdx = "PDMP W5 OK"
      call klog_s1;

      // Dump panic ring (emits BEGIN marker, all bytes, END marker)
      call klog_ring_dump_panic;

      // ============================================================
      // M8-002 (#707): max-line witness — 10× MAX LEN CANARY + head delta
      // ============================================================
      // Witness: Emit 10 identical klog_s1_x4 lines with tag "MAX LEN CANARY",
      // snapshot ring head before/after, compute delta, emit via klog_s1_x1_d1.
      // Canary magic: 0xC0FFEEDEADBEEF12 stored at [rbp-8] and verified
      // after each loop iteration (debugger trap to detect corruption).

      push rbp;
      mov rbp, rsp;
      sub rsp, 48;                       // Frame space (48 = 40 + 8, keeps rsp 16-aligned)

      // Initialize canary magic
      mov rax, 0xC0FFEEDEADBEEF12;
      mov [rbp - 8], rax;
      mov r12, 10;                       // Loop counter (callee-save)

      // Snapshot ring head before loop
      mov r13, [rip + _klog_ring_head];

      max_line_loop:

      // Emit klog_s1_x4(INFO, BOOT, "MAX LEN CANARY", k_vec, 0, k_err, 0, k_rip, 0, k_cs, 0)
      // Stack args in reverse order: push v4, k4, v3, k3, v2 (rightmost first)
      mov rdi, 3;                        // level = INFO
      lea rsi, [rip + SUBSYS_BOOT];      // subsys
      lea rdx, [rip + tag_max_len_canary]; // tag
      lea rcx, [rip + k_vec];            // k1
      mov r8, 0;                         // v1
      lea r9, [rip + k_err];             // k2
      mov rax, 0;                        // v4 (rightmost, push first)
      push rax;
      lea rax, [rip + k_cs];             // k4
      push rax;
      mov rax, 0;                        // v3
      push rax;
      lea rax, [rip + k_rip];            // k3
      push rax;
      mov rax, 0;                        // v2 (leftmost, push last)
      push rax;
      call klog_s1_x4;
      add rsp, 40;

      // Reload and verify canary (MUST be an imm64 mov, NOT register-copy)
      mov rax, 0xC0FFEEDEADBEEF12;
      mov rcx, [rbp - 8];
      cmp rax, rcx;
      jne max_line_witness_fail;

      // Decrement loop counter
      dec r12;
      jnz max_line_loop;

      // After loop: compute ring head delta
      mov rax, [rip + _klog_ring_head];
      sub rax, r13;                      // rax = head_after - head_before

      // Emit via klog_s1_x1_d1(INFO, BOOT, "M8 MAXLINE OK", k_len, head_delta)
      // Caller must push vd (second value) before call
      mov rdi, 3;                        // level = INFO
      lea rsi, [rip + SUBSYS_BOOT];      // subsys
      lea rdx, [rip + tag_max_len_measured]; // tag
      lea rcx, [rip + k_len];            // kx (hex)
      mov r8, rax;                       // vx = head_delta (hex format)
      lea r9, [rip + k_pid];             // kd (decimal)
      mov rax, 10;                       // vd = 10 (decimal, loop count)
      push rax;
      call klog_s1_x1_d1;
      add rsp, 8;

      // Frame epilogue
      add rsp, 48;
      pop rbp;
      jmp max_line_witness_done;

      max_line_witness_fail:
      mov rdi, 1;                        // level = PANIC
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + tag_max_len_canary];
      call klog_panic;
      // UNREACHABLE, but belt-and-braces jmp to label:
      jmp max_line_witness_fail;

      max_line_witness_done:

      // ============================================================
      // M3-001 (#689): klog_dump_trap_frame witness.
      // ============================================================
      // Witness 1: fake trap frame with vec=0xaaaa..., err=0xbbbb...
      sub rsp, 176;                                // frame space (16-byte aligned)

      mov rax, 0xaaaaaaaaaaaaaaaa;
      mov [rsp + 120], rax;                        // vec = 0xaaaa...

      mov rax, 0xbbbbbbbbbbbbbbbb;
      mov [rsp + 128], rax;                        // err = 0xbbbb...

      mov rax, 0xdeadbeefdeadbeef;
      mov [rsp + 136], rax;                        // rip = 0xdeadbeef...

      mov rax, 0x0000000000000008;
      mov [rsp + 144], rax;                        // cs = 0x8

      mov rax, 0x0000000000000202;
      mov [rsp + 152], rax;                        // rfl = 0x202

      mov rax, 0xcafe0000cafe0000;
      mov [rsp + 160], rax;                        // rsp = 0xcafe0000...

      mov rax, 0x0000000000000010;
      mov [rsp + 168], rax;                        // ss = 0x10

      mov rdi, rsp;
      call klog_dump_trap_frame;

      add rsp, 176;

      // Witness 2: fake trap frame with vec=14 (exercises CR2 branch)
      sub rsp, 176;

      mov rax, 0x000000000000000e;
      mov [rsp + 120], rax;                        // vec = 14

      mov rax, 0x0000000000000000;
      mov [rsp + 128], rax;                        // err = 0

      mov rax, 0x1234567890abcdef;
      mov [rsp + 136], rax;                        // rip

      mov rax, 0x0000000000000008;
      mov [rsp + 144], rax;                        // cs

      mov rax, 0x0000000000000202;
      mov [rsp + 152], rax;                        // rfl

      mov rax, 0xffffffffffffffff;
      mov [rsp + 160], rax;                        // rsp

      mov rax, 0x0000000000000010;
      mov [rsp + 168], rax;                        // ss

      mov rdi, rsp;
      call klog_dump_trap_frame;

      add rsp, 176;

      // ============================================================
      // M3-003 (#691): fake-panic emission chain (no real trap, no halt).
      // ============================================================
      mov rdi, 3;
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + ud_panic_witness_msg];
      call klog_s1;   // "UD PANIC WITNESS\n"
      mov rdi, 3;
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + exc_halt_msg];
      call klog_s1;   // reuse existing symbol
      sub rsp, 176;
      mov rax, 0x0000000000000006; mov [rsp + 120], rax;       // vec = 6 (#UD)
      mov rax, 0x0000000000000000; mov [rsp + 128], rax;       // err
      mov rax, 0xfeedfacefeedface; mov [rsp + 136], rax;       // rip
      mov rax, 0x0000000000000008; mov [rsp + 144], rax;       // cs
      mov rax, 0x0000000000000202; mov [rsp + 152], rax;       // rfl
      mov rax, 0x0badc0de0badc0de; mov [rsp + 160], rax;       // rsp
      mov rax, 0x0000000000000010; mov [rsp + 168], rax;       // ss
      mov rdi, rsp; call klog_dump_trap_frame;
      add rsp, 176;

      // ============================================================
      // M5-001 (#695): klog_walk_rbp stack walker witness.
      // ============================================================
      // Build a 2-deep synthetic rbp chain in _stack_walk_buf (.bss, high-VA
      // — rsp at witness time is low-VA identity-mapped and would fail the
      // walker's canonical-VA guard). Chain structure:
      //   buf[0]=0           (frame 0 rbp: chain terminator)
      //   buf[1]=0xAAAA      (frame 0 saved rip)
      //   buf[2]=&buf[0]     (frame 1 rbp → frame 0)
      //   buf[3]=0xBBBB      (frame 1 saved rip)
      //   buf[4]=&buf[2]     (frame 2 rbp → frame 1)
      //   buf[5]=0xCCCC      (frame 2 saved rip)
      // Call klog_walk_rbp(&buf[4], 5). NULL check happens BEFORE emit, so
      // frame 0 (rbp=0) never emits — expected 2 FRAME lines: 0xcccc, 0xbbbb.

      lea rcx, [rip + _stack_walk_buf];      // rcx = &buf[0]

      // Frame 0: rbp=0, saved_rip=0xAAAA
      mov rax, 0;
      mov [rcx + 0], rax;                    // buf[0] = 0
      mov rax, 0xAAAA;
      mov [rcx + 8], rax;                    // buf[1] = 0xAAAA

      // Frame 1: rbp=&buf[0], saved_rip=0xBBBB
      mov [rcx + 16], rcx;                   // buf[2] = &buf[0] (== rcx)
      mov rax, 0xBBBB;
      mov [rcx + 24], rax;                   // buf[3] = 0xBBBB

      // Frame 2: rbp=&buf[2], saved_rip=0xCCCC
      mov rax, rcx;
      add rax, 16;
      mov [rcx + 32], rax;                   // buf[4] = &buf[2]
      mov rax, 0xCCCC;
      mov [rcx + 40], rax;                   // buf[5] = 0xCCCC

      // Call klog_walk_rbp(&buf[4], 5)
      lea rdi, [rip + _stack_walk_buf];
      add rdi, 32;                           // rdi = &buf[4]
      mov rsi, 5;                            // rsi = max_frames
      call klog_walk_rbp;

      // Emit OK marker on completion (proves walker returned; earlier bug
      // silently emitted OK even when the canonical guard rejected every
      // frame — now the walker actually walks, verified by FRAME lines).
      mov rdi, 3;
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + m5_walk_ok_msg];
      call klog_s1;

      // ============================================================
      // R15-M1-010 (#649): phys_free bitmap release witness.
      // ============================================================

      // 1. Snapshot initial free count.
      call phys_alloc_free_count;
      mov r12, rax;                       // r12 = initial free

      // 2. Allocate 4 pages.
      mov rdi, 0; call phys_alloc; mov r13, rax; cmp rax, 0; je pfr_fail;
      mov rdi, 0; call phys_alloc; mov r14, rax; cmp rax, 0; je pfr_fail;
      mov rdi, 0; call phys_alloc; mov r15, rax; cmp rax, 0; je pfr_fail;
      mov rdi, 0; call phys_alloc; mov rbx, rax; cmp rax, 0; je pfr_fail;

      // 3. Check free went down by 4.
      call phys_alloc_free_count;
      mov rcx, r12;
      sub rcx, 4;
      cmp rax, rcx;
      jne pfr_fail;

      // 4. Free all 4, in reverse order.
      mov rdi, rbx; xor rsi, rsi; call phys_free;
      mov rdi, r15; xor rsi, rsi; call phys_free;
      mov rdi, r14; xor rsi, rsi; call phys_free;
      mov rdi, r13; xor rsi, rsi; call phys_free;

      // 5. Free count must return to initial.
      call phys_alloc_free_count;
      cmp rax, r12;
      jne pfr_fail;

      // 6. Emit marker.
      mov rdi, 3;
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + phys_free_ok_msg];
      call klog_s1;
      jmp pfr_done;

      pfr_fail:
      mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + phys_free_fail_msg];
      call klog_s1;

      pfr_done:

      // ============================================================
      // R15-M6-008 (#559): frame_meta refcount witness.
      // ============================================================

      // Check 1: Snapshot initial free count.
      call phys_alloc_free_count;
      mov r12, rax;                       // r12 = initial free count

      // Check 2: Alloc a frame, verify refcount == 1 and free count -= 1.
      mov rdi, 0; call phys_alloc;
      mov r13, rax;                       // r13 = frame VA
      cmp rax, 0;
      je fm_fail;

      mov rdi, r13; call frame_meta_get;
      cmp rax, 1;                         // refcount must be exactly 1
      jne fm_fail;

      call phys_alloc_free_count;
      mov rcx, r12;
      sub rcx, 1;
      cmp rax, rcx;                       // free count decreased by exactly 1
      jne fm_fail;

      // Check 3: Incref, verify refcount == 2, free count unchanged.
      mov rdi, r13; call frame_meta_incref;
      cmp rax, 2;                         // incref returns new count = 2
      jne fm_fail;

      mov rdi, r13; call frame_meta_get;
      cmp rax, 2;
      jne fm_fail;

      call phys_alloc_free_count;
      mov rcx, r12;
      sub rcx, 1;
      cmp rax, rcx;                       // still down by only 1 (bit not cleared)
      jne fm_fail;

      // Check 4: First phys_free — refcount drops to 1, frame STAYS allocated.
      mov rdi, r13; xor rsi, rsi; call phys_free;
      cmp rax, 0;                         // PHYS_FREE_OK
      jne fm_fail;

      mov rdi, r13; call frame_meta_get;
      cmp rax, 1;                         // refcount now 1
      jne fm_fail;

      call phys_alloc_free_count;
      mov rcx, r12;
      sub rcx, 1;
      cmp rax, rcx;                       // free count STILL down by 1 (bit stayed set)
      jne fm_fail;

      // Check 5: Second phys_free — refcount hits 0, frame RETURNS to pool.
      mov rdi, r13; xor rsi, rsi; call phys_free;
      cmp rax, 0;                         // PHYS_FREE_OK
      jne fm_fail;

      mov rdi, r13; call frame_meta_get;
      cmp rax, 0;                         // refcount now 0
      jne fm_fail;

      call phys_alloc_free_count;
      cmp rax, r12;                       // free count restored to initial
      jne fm_fail;

      // All checks green.
      mov rdi, 3;
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + frame_meta_ok_msg];
      call klog_s1;
      jmp fm_done;

      fm_fail:
      mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + frame_meta_fail_msg];
      call klog_s1;

      fm_done:

      // ============================================================
      // R15-M6-001 (#552): aspace_clone_cow witness (3 phases).
      // ============================================================
      //
      // Phase 1: empty src (baseline control flow)
      // Phase 2: src with 1 mapped page (single-leaf shape check)
      // Phase 3: src with 5 mapped pages across distinct levels (tree navigation)
      //
      // Each phase creates fresh src/dst aspaces and verifies post-clone state.
      // Phases are independent; failure in one skips remaining phases.

      // === PHASE 1: Empty src ===
      call phys_alloc_free_count;
      mov r12, rax;                       // r12 = initial free count

      call aspace_create_user;
      mov rcx, 0xFFFFFFFF;
      cmp rax, rcx;
      je clone_phase1_fail;
      mov r13, rax;                       // r13 = src_pml4_va

      call aspace_create_user;
      cmp rax, rcx;
      je clone_phase1_fail;
      mov r14, rax;                       // r14 = dst_pml4_va

      // Act: clone empty src into dst
      mov rdi, r13;
      mov rsi, r14;
      call aspace_clone_cow;

      // Assert: rax == ASPACE_CLONE_OK (0)
      cmp rax, 0;
      jne clone_phase1_fail;

      // Assert: dst PML4[0..255] are all zero (walker touched nothing)
      xor r15, r15;
      clone_p1_check_loop:
        cmp r15, 256;
        jge clone_p1_check_done;
        mov rax, [r14 + r15*8];
        cmp rax, 0;
        jne clone_phase1_fail;
        add r15, 1;
        jmp clone_p1_check_loop;

      clone_p1_check_done:
      mov rdi, 3;
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + clone_cow_empty_ok_msg];
      call klog_s1;
      jmp clone_phase2_setup;

      clone_phase1_fail:
      mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + clone_cow_empty_fail_msg];
      call klog_s1;
      jmp clone_phases_done;

      // === PHASE 2: One page ===
      clone_phase2_setup:
      call phys_alloc_free_count;
      mov r12, rax;                       // r12 = initial free count

      call aspace_create_user;
      mov rcx, 0xFFFFFFFF;
      cmp rax, rcx;
      je clone_phase2_fail;
      mov r13, rax;                       // r13 = src_pml4_va

      call aspace_create_user;
      cmp rax, rcx;
      je clone_phase2_fail;
      mov r14, rax;                       // r14 = dst_pml4_va

      // Allocate one frame
      mov rdi, 0;
      call phys_alloc;
      cmp rax, 0;
      je clone_phase2_fail;
      mov r15, rax;                       // r15 = frame_va

      // Map at TEST_VA_1 = 0x0000_0000_0040_0000 (PML4[0], PDPT[0], PD[2], PT[0])
      mov rdi, r13;                       // rdi = src_pml4_va
      mov rsi, 0x0000000000400000;        // rsi = TEST_VA_1
      mov rdx, r15;                       // rdx = frame_va
      mov rcx, 6;                         // rcx = PTE_US | PTE_RW (0x4 | 0x2 = 0x6)
      call aspace_map;
      cmp rax, 0;
      jne clone_phase2_fail;

      // Save frame_pa = frame_va - KERNEL_VMA_BASE
      mov rbx, r15;
      mov r11, 0xFFFF800000000000;
      sub rbx, r11;                       // rbx = frame_pa

      // Act: clone src into dst
      mov rdi, r13;
      mov rsi, r14;
      call aspace_clone_cow;
      cmp rax, 0;
      jne clone_phase2_fail;

      // Assert on src: walk to TEST_VA_1 and read leaf PTE
      mov rdi, r13;
      mov rsi, 0x0000000000400000;
      call pt_lookup_leaf_pte;
      mov r10, rax;                       // r10 = src leaf PTE

      // Assert PRESENT set
      mov rcx, r10;
      and rcx, 1;
      cmp rcx, 0;
      je clone_phase2_fail;

      // Assert RW clear
      mov rcx, r10;
      shr rcx, 1;
      and rcx, 1;
      cmp rcx, 1;
      je clone_phase2_fail;               // RW should be 0

      // Assert COW set
      mov rcx, r10;
      shr rcx, 9;
      and rcx, 1;
      cmp rcx, 1;
      jne clone_phase2_fail;              // COW should be 1

      // Assert frame field matches
      mov r11, 0x000FFFFFFFFFF000;
      mov rcx, r10;
      and rcx, r11;
      cmp rcx, rbx;
      jne clone_phase2_fail;

      // Assert on dst: walk to TEST_VA_1 and read leaf PTE
      mov rdi, r14;
      mov rsi, 0x0000000000400000;
      call pt_lookup_leaf_pte;
      mov r10, rax;                       // r10 = dst leaf PTE

      // Assert PRESENT set
      mov rcx, r10;
      and rcx, 1;
      cmp rcx, 0;
      je clone_phase2_fail;

      // Assert RW clear
      mov rcx, r10;
      shr rcx, 1;
      and rcx, 1;
      cmp rcx, 1;
      je clone_phase2_fail;

      // Assert COW set
      mov rcx, r10;
      shr rcx, 9;
      and rcx, 1;
      cmp rcx, 1;
      jne clone_phase2_fail;

      // Assert frame field matches
      mov r11, 0x000FFFFFFFFFF000;
      mov rcx, r10;
      and rcx, r11;
      cmp rcx, rbx;
      jne clone_phase2_fail;

      // Assert refcount == 2
      mov rdi, rbx;
      call frame_meta_get;
      cmp rax, 2;
      jne clone_phase2_fail;

      mov rdi, 3;
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + clone_cow_1page_ok_msg];
      call klog_s1;
      jmp clone_phase3_setup;

      clone_phase2_fail:
      mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + clone_cow_1page_fail_msg];
      call klog_s1;
      jmp clone_phases_done;

      // === PHASE 3: Five pages across levels ===
      clone_phase3_setup:
      call phys_alloc_free_count;
      mov r12, rax;                       // r12 = initial free count

      call aspace_create_user;
      mov rcx, 0xFFFFFFFF;
      cmp rax, rcx;
      je clone_phase3_fail;
      mov r13, rax;                       // r13 = src_pml4_va

      call aspace_create_user;
      cmp rax, rcx;
      je clone_phase3_fail;
      mov r14, rax;                       // r14 = dst_pml4_va

      // Allocate and map 5 frames at distinct VAs
      // Store frame_vas on stack: [rsp], [rsp+8], [rsp+16], [rsp+24], [rsp+32]
      sub rsp, 40;                        // Allocate 5 × u64 on stack

      // Frame 0 (TEST_VA_A)
      mov rdi, 0; call phys_alloc;
      cmp rax, 0; je clone_phase3_fail;
      mov r8, 0; mov [rsp + r8*8], rax;  // Save frame_va
      mov rdi, r13; mov rsi, 0x0000000000400000;
      mov rdx, rax; mov rcx, 6; call aspace_map;
      cmp rax, 0; jne clone_phase3_fail;

      // Frame 1 (TEST_VA_B)
      mov rdi, 0; call phys_alloc;
      cmp rax, 0; je clone_phase3_fail;
      mov r8, 1; mov [rsp + r8*8], rax;
      mov rdi, r13; mov rsi, 0x0000000040000000;
      mov rdx, rax; mov rcx, 6; call aspace_map;
      cmp rax, 0; jne clone_phase3_fail;

      // Frame 2 (TEST_VA_C)
      mov rdi, 0; call phys_alloc;
      cmp rax, 0; je clone_phase3_fail;
      mov r8, 2; mov [rsp + r8*8], rax;
      mov rdi, r13; mov rsi, 0x0000000080001000;
      mov rdx, rax; mov rcx, 6; call aspace_map;
      cmp rax, 0; jne clone_phase3_fail;

      // Frame 3 (TEST_VA_D)
      mov rdi, 0; call phys_alloc;
      cmp rax, 0; je clone_phase3_fail;
      mov r8, 3; mov [rsp + r8*8], rax;
      mov rdi, r13; mov rsi, 0x0000008000002000;
      mov rdx, rax; mov rcx, 6; call aspace_map;
      cmp rax, 0; jne clone_phase3_fail;

      // Frame 4 (TEST_VA_E)
      mov rdi, 0; call phys_alloc;
      cmp rax, 0; je clone_phase3_fail;
      mov r8, 4; mov [rsp + r8*8], rax;
      mov rdi, r13; mov rsi, 0x0000010000003000;
      mov rdx, rax; mov rcx, 6; call aspace_map;
      cmp rax, 0; jne clone_phase3_fail;

      // Act: clone src into dst
      mov rdi, r13;
      mov rsi, r14;
      call aspace_clone_cow;
      cmp rax, 0;
      jne clone_phase3_fail;

      // Assert each of 5 leaves in src and dst
      // Loop over VAs and frames (stored on stack at [rsp+0..32])
      xor r15, r15;                       // loop counter
      mov r8, 5;                          // loop limit

      clone_p3_verify_loop:
        cmp r15, r8;
        jge clone_p3_verify_done;

        // Load frame_va from stack [rsp + r15*8]
        mov r9, [rsp + r15*8];            // r9 = frame_va

        // Compute frame_pa = frame_va - KERNEL_VMA_BASE
        mov r10, r9;
        mov rcx, 0xFFFF800000000000;
        sub r10, rcx;                     // r10 = frame_pa

        // Compute VA based on r15 index (inline, no relocation issues)
        // [0] = 0x0000_0000_0040_0000, [1] = 0x0000_0000_4000_0000,
        // [2] = 0x0000_0000_8000_1000, [3] = 0x0000_0080_0000_2000,
        // [4] = 0x0000_0100_0000_3000
        cmp r15, 0; je clone_p3_va_0;
        cmp r15, 1; je clone_p3_va_1;
        cmp r15, 2; je clone_p3_va_2;
        cmp r15, 3; je clone_p3_va_3;
        mov rsi, 0x0000010000003000;
        jmp clone_p3_va_done;
        clone_p3_va_0: mov rsi, 0x0000000000400000; jmp clone_p3_va_done;
        clone_p3_va_1: mov rsi, 0x0000000040000000; jmp clone_p3_va_done;
        clone_p3_va_2: mov rsi, 0x0000000080001000; jmp clone_p3_va_done;
        clone_p3_va_3: mov rsi, 0x0000008000002000; jmp clone_p3_va_done;
        clone_p3_va_done:

        // Check src leaf PTE
        mov rdi, r13;
        push r15; push r8; push r9; push r10; push r11;
        call pt_lookup_leaf_pte;
        pop r11; pop r10; pop r9; pop r8; pop r15;

        mov rdx, rax;                     // rdx = src leaf PTE

        // Assert PRESENT + RW clear + COW set + frame matches
        mov rcx, rdx;
        and rcx, 1;
        cmp rcx, 0;
        je clone_phase3_fail;             // not present

        mov rcx, rdx;
        shr rcx, 1; and rcx, 1;
        cmp rcx, 1;
        je clone_phase3_fail;             // RW set (should be 0)

        mov rcx, rdx;
        shr rcx, 9; and rcx, 1;
        cmp rcx, 1;
        jne clone_phase3_fail;            // COW not set

        mov rcx, rdx;
        mov r12, 0x000FFFFFFFFFF000;
        and rcx, r12;
        cmp rcx, r10;
        jne clone_phase3_fail;            // frame mismatch

        // Check dst leaf PTE
        mov rdi, r14;
        push r15; push r8; push r9; push r10; push r11;
        call pt_lookup_leaf_pte;
        pop r11; pop r10; pop r9; pop r8; pop r15;

        mov rdx, rax;                     // rdx = dst leaf PTE

        // Assert PRESENT + RW clear + COW set + frame matches
        mov rcx, rdx;
        and rcx, 1;
        cmp rcx, 0;
        je clone_phase3_fail;

        mov rcx, rdx;
        shr rcx, 1; and rcx, 1;
        cmp rcx, 1;
        je clone_phase3_fail;

        mov rcx, rdx;
        shr rcx, 9; and rcx, 1;
        cmp rcx, 1;
        jne clone_phase3_fail;

        mov rcx, rdx;
        mov r12, 0x000FFFFFFFFFF000;
        and rcx, r12;
        cmp rcx, r10;
        jne clone_phase3_fail;

        // Check refcount == 2
        mov rdi, r10;
        push r15; push r8; push r11;
        call frame_meta_get;
        pop r11; pop r8; pop r15;

        cmp rax, 2;
        jne clone_phase3_fail;

        add r15, 1;
        jmp clone_p3_verify_loop;

      clone_p3_verify_done:
      mov rdi, 3;
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + clone_cow_multi_ok_msg];
      call klog_s1;
      add rsp, 40;                        // Clean up stack (5 frame_vas)
      jmp clone_phases_done;

      clone_phase3_fail:
      mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + clone_cow_multi_fail_msg];
      call klog_s1;
      add rsp, 40;                        // Clean up stack (5 frame_vas)

      clone_phases_done:

      // ============================================================
      // R16-M0-D11a: aspace_teardown leak-plug witness.
      // ============================================================
      //
      // Direct proof that the D11a register-discipline fix restores
      // aspace_teardown to a zero-leak state on non-empty aspaces.
      // Deliberately avoids aspace_create_user because that path also
      // populates PML4[256+] (kernel-half kpti stacks/GDT/IDT/TSS/ISR
      // intermediates) which the walker skips at the L1 loop's `cmp
      // r13, 256; jge` — those intermediates are a separate leak
      // filed as D11a-1 follow-up. This witness uses a hand-rolled
      // PML4 (phys_alloc + user-half zero) + aspace_map for a single
      // user-half leaf to exercise the full L1..L4 walker cleanly.
      //
      // Steps:
      //   1. Snapshot phys_alloc_free_count()          → r12
      //   2. phys_alloc(0) → PML4 root                 → r13
      //   3. Zero PML4[0..255] (user half must be pristine — pool
      //      frames contain leftover CoW data from earlier witnesses)
      //   4. phys_alloc(0) → leaf frame                → r14
      //   5. aspace_map(r13, TEST_VA, r14, US|RW|P)    (allocates 3
      //      intermediates: PDPT/PD/PT)
      //   6. aspace_teardown(r13)                      (frees PML4 +
      //      3 intermediates + leaf = 5 frames)
      //   7. Verify phys_alloc_free_count() == r12 (initial)
      //
      // Frames accounted for:
      //   Allocated:  1 (PML4) + 1 (leaf) + 3 (intermediates via
      //                aspace_map) = 5
      //   Freed:     phys_free(leaf) + phys_free(PT) + phys_free(PD)
      //             + phys_free(PDPT) + phys_free(PML4) = 5
      //   Net delta: 0 ← this is what the witness asserts.
      //
      // TEST_VA = 0x0000_0000_0040_0000 (PML4[0], PDPT[0], PD[2],
      // PT[0]). Same VA the R15-M6 CoW witnesses use — well below
      // the 128 TiB user boundary and distinct from any kpti mapping.

      // Step 1: snapshot initial free count.
      call phys_alloc_free_count;
      mov r12, rax;                       // r12 = initial free count

      // Step 2: allocate PML4 root.
      mov rdi, 0;
      call phys_alloc;
      cmp rax, 0;
      je aspace_teardown_witness_fail;
      mov r13, rax;                       // r13 = pml4_va (phys_alloc-form)

      // Step 3: zero user half PML4[0..255].
      xor rcx, rcx;                       // rcx = index
      xor rax, rax;                       // rax = 0 (fill value)
      aspace_teardown_witness_zero_loop:
        cmp rcx, 256;
        jge aspace_teardown_witness_zero_done;
        mov [r13 + rcx*8], rax;
        add rcx, 1;
        jmp aspace_teardown_witness_zero_loop;
      aspace_teardown_witness_zero_done:

      // Step 4: allocate leaf frame.
      mov rdi, 0;
      call phys_alloc;
      cmp rax, 0;
      je aspace_teardown_witness_fail;
      mov r14, rax;                       // r14 = leaf_va

      // Step 5: aspace_map(r13, 0x400000, r14, US|RW=0x6).
      //   PTE_PRESENT (bit 0) is set by aspace_map itself.
      //   PTE_RW (bit 1) + PTE_US (bit 2) = 0x6.
      //   Teardown checks (P & U) → both must be set for phys_free.
      mov rdi, r13;                       // as_root
      mov rsi, 0x0000000000400000;        // vaddr
      mov rdx, r14;                       // paddr (phys_alloc-form)
      mov rcx, 6;                         // flags
      call aspace_map;
      cmp rax, 0;
      jne aspace_teardown_witness_fail;

      // Step 6: teardown.
      mov rdi, r13;
      call aspace_teardown;

      // Step 7: verify free count restored.
      call phys_alloc_free_count;
      cmp rax, r12;
      jne aspace_teardown_witness_fail;

      // Success marker.
      mov rdi, 3;
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + aspace_teardown_ok_msg];
      call klog_s1;
      jmp aspace_teardown_witness_done;

      aspace_teardown_witness_fail:
      mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + aspace_teardown_fail_msg];
      call klog_s1;

      aspace_teardown_witness_done:

      // ============================================================
      // R14b-M5-008 (#661): pf_handle_cow sub-test B — CoW fast-flip
      // ============================================================
      //
      // CR3-flip-free witness: install a fresh CoW-marked mapping into
      // PML4[1] of the current live kernel_pml4 (an empty slot; only
      // PML4[0] and PML4[256] are set by boot_stub), trigger a ring-0
      // write, verify pf_handle_cow flips PTE_RW/clears PTE_COW, and the
      // iretq-retried write lands the canary in the frame.
      //
      // Address layout:
      //   WITNESS_VA = 0x0000_0080_0000_0000
      //     = PML4[1], PDPT[0], PD[0], PT[0]
      //   No huge-page collision (PML4[1] is empty).
      //
      // Fault chain (all runs at CPL=0 on kernel CR3):
      //   mov [WITNESS_VA], rax
      //     → CPU sees present + RW=0 + CR0.WP=1 → #PF with err=P|W
      //     → IDT vec 14 → IST3 (post-d9cdc70 IST fix; was IST=1
      //       shared with #DF, causing frame stomping)
      //     → _isr_stub_14 (RPL=0 → no swapgs, no CR3 flip)
      //     → trampoline_vec14 (push errcode/vec/GPRs, mov rdi, rsp)
      //     → _typed_handler_14 (checks _cow_witness_active=1)
      //     → pf_handle_cow: walk PT, verify P|W errcode + PTE shape,
      //       frame_meta refcount==1, then OR RW / AND ~COW / invlpg,
      //       return PF_HANDLE_OK
      //     → typed14 ret → trampoline_vec14 pops GPRs → _isr_return
      //     → iretq → CPU re-executes the write, now RW=1, succeeds
      //
      // Verification: canary at frame_va == 0xCAFEBABE12345678 AND leaf
      // PTE has RW=1 and COW=0. Both conditions gate PF FLIP OK vs FAIL.
      //
      // Frame's initial refcount is 1 (born via #559 in phys_alloc).

      // Step 1: allocate a fresh frame (refcount = 1 per #559)
      mov rdi, 0;
      call phys_alloc;
      cmp rax, 0;
      je pf_flip_fail;
      mov r15, rax;                       // r15 = frame_va (surviving)

      // Step 2: seed the frame with an initial canary. This proves the
      // retried write lands in *this* frame (not some other page). We do
      // this via the frame's high-half VA (r15) before installing the
      // WITNESS_VA mapping.
      mov rcx, 0xDEADBEEF01020304;
      mov [r15], rcx;

      // Step 3: install the mapping into current kernel_pml4.
      //   flags = 0  →  aspace_map ORs PTE_PRESENT; leaf is P|RW=0|US=0
      //   aspace_map allocates PDPT/PD/PT chain for empty PML4[1]
      mov rdi, [rip + _kernel_pml4_pa];   // as_root (VA==PA, identity map)
      mov rsi, 0x0000008000000000;        // WITNESS_VA (PML4[1])
      mov rdx, r15;                       // frame_va (phys_alloc form)
      mov rcx, 0;                         // flags: no RW, no US
      call aspace_map;
      cmp rax, 0;
      jne pf_flip_fail;

      // Step 4: walk the freshly-installed PT chain to the leaf slot and
      // OR PTE_COW (bit 9 = 0x200). Store back + invlpg. r13 survives to
      // the post-flip PTE re-read below.
      mov r14, 0xFFFF800000000000;        // KERNEL_VMA_BASE (imm64 helper)
      mov r11, 0x000FFFFFFFFFF000;        // PTE_FRAME_MASK
      mov rax, [rip + _kernel_pml4_pa];   // pml4_va
      // PML4[1] → PDPT VA
      mov rcx, [rax + 8];
      and rcx, r11;
      add rcx, r14;                       // rcx = pdpt_va
      // PDPT[0] → PD VA
      mov rcx, [rcx];
      and rcx, r11;
      add rcx, r14;                       // rcx = pd_va
      // PD[0] → PT VA
      mov rcx, [rcx];
      and rcx, r11;
      add rcx, r14;                       // rcx = pt_va
      // r13 = &PT[0] slot (surviving through the trigger for re-read)
      mov r13, rcx;
      mov rax, [r13];                     // rax = raw leaf PTE
      or  rax, 0x200;                     // set PTE_COW
      mov [r13], rax;
      mov rdi, 0x0000008000000000;
      invlpg [rdi];

      // Step 5: arm _typed_handler_14 to dispatch to pf_handle_cow, and
      // enable pf_handle_cow's klog bisection markers.
      mov rax, 1;
      mov [rip + _cow_witness_active], rax;
      mov [rip + _cow_witness_verbose], rax;

      // Step 6: trigger the CoW write. This #PFs, pf_handle_cow flips
      // the leaf, iretq re-executes the write. The store lands if the
      // fault chain is sound end-to-end.
      mov rbx, 0x0000008000000000;        // WITNESS_VA
      mov rax, 0xCAFEBABE12345678;
      mov [rbx], rax;

      // Step 7: disarm the witness (survived the fault + iretq retry).
      xor rax, rax;
      mov [rip + _cow_witness_active], rax;
      mov [rip + _cow_witness_verbose], rax;

      // Step 8: verify the canary landed in the frame (read through the
      // just-flipped mapping via WITNESS_VA).
      mov rbx, 0x0000008000000000;
      mov rax, [rbx];
      mov rcx, 0xCAFEBABE12345678;
      cmp rax, rcx;
      jne pf_flip_fail;

      // Step 9: re-read the leaf PTE and assert RW=1 and COW=0.
      mov rax, [r13];
      mov rcx, rax;
      and rcx, 0x2;                       // PTE_RW
      cmp rcx, 0;
      je pf_flip_fail;
      mov rcx, rax;
      and rcx, 0x200;                     // PTE_COW
      cmp rcx, 0;
      jne pf_flip_fail;

      // Step 10: success — emit witness marker.
      mov rdi, 3;
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + pf_flip_ok_msg];
      call klog_s1;
      jmp pf_flip_done;

      pf_flip_fail:
      // Disarm (safe on all failure paths, incl. pre-arm ones).
      xor rax, rax;
      mov [rip + _cow_witness_active], rax;
      mov [rip + _cow_witness_verbose], rax;
      mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + pf_flip_fail_msg];
      call klog_s1;

      pf_flip_done:

      // R14.M4-009 (#505): KPTI structural witness (no CR3 flip)
      mov rdi, [rip + _kernel_pml4_pa];
      call aspace_create_user_pgd;
      mov rdx, 0xFFFFFFFF;
      cmp rax, rdx;
      je kpti_fail;
      mov r15, rax;

      mov rdi, r15;
      call kpti_build_user_pml4;
      cmp rax, rdx;
      je kpti_fail;

      // Assert PML4[256] present bit
      mov rax, r15;
      add rax, 2048;
      mov rax, [rax];
      mov rcx, rax;
      and rcx, 1;
      cmp rcx, 0;
      je kpti_fail;

      // Assert singleton PDPT phys cached
      lea rcx, [rip + _kpti_trampoline_pdpt_pa];
      mov rcx, [rcx];
      cmp rcx, 0;
      je kpti_fail;

      // R14b-m4-006b (#645): KPTI scratch-slot round-trip witness.
      // Walk user PML4 -> PDPT -> PD -> PT[261] and verify trampoline data page is present + RW + U=0.
      mov rax, r15;
      add rax, 2048;
      mov rax, [rax];
      and rax, 0x000FFFFFFFFFF000;             // Mask to PDPT phys (40-bit PA per Intel SDM Vol 3A §4.5)
      mov r9, rax;                             // r9 = PDPT phys

      // Check PT[261] (offset 2088) in the trampoline PT
      add r9, 0;                               // r9 = PDPT[0] location (PDPT+0 for PD[0] entry)
      mov rax, [r9];
      and rax, 0x000FFFFFFFFFF000;             // Mask to PD phys (40-bit PA per Intel SDM Vol 3A §4.5)
      mov r10, rax;                            // r10 = PD phys

      add r10, 0;                              // r10 = PD[0] location (PD+0 for PT entry)
      mov rax, [r10];
      and rax, 0x000FFFFFFFFFF000;             // Mask to PT phys (40-bit PA per Intel SDM Vol 3A §4.5)
      mov r11, rax;                            // r11 = PT phys

      add r11, 2088;                           // r11 = PT[261] slot
      mov rax, [r11];
      mov rcx, rax;
      and rcx, 1;
      cmp rcx, 0;
      je kpti_fail;                            // PT[261] not present

      // Check RW bit (bit 1)
      mov rcx, rax;
      shr rcx, 1;
      and rcx, 1;
      cmp rcx, 0;
      je kpti_fail;                            // PT[261] not writable

      // Check U=0 (bit 2 should be 0)
      mov rcx, rax;
      shr rcx, 2;
      and rcx, 1;
      cmp rcx, 0;
      jne kpti_fail;                           // PT[261] has U=1 (user-accessible)

      // Test scratch slot round-trip: write canary to _saved_user_rsp, read it back
      mov rax, 0xDEADBEEFCAFEF00D;
      lea rcx, [rip + _saved_user_rsp];
      mov [rcx], rax;
      mov rdx, [rcx];
      mov r8, 0xDEADBEEFCAFEF00D;
      cmp rdx, r8;
      jne kpti_fail;

      // Test _kernel_pml4_pa survives section move
      lea rcx, [rip + _kernel_pml4_pa];
      mov rdx, [rcx];
      cmp rdx, 0;
      je kpti_fail;

      mov rdi, 3;
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + kpti_ok_msg];
      call klog_s1;
      mov rdi, 3;
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + kpti_scratch_ok_msg];
      call klog_s1;
      mov rdi, 3;
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + tag_kpti_stacks_ok];
      call klog_s1;
      mov rdi, 3;
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + tag_kpti_isr_ok];
      call klog_s1;
      mov rdi, 3;
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + tag_kpti_desc_ok];
      call klog_s1;

      // R15-M2-005-followup (#651): enter_userland_initial relocation witness.
      // Assert enter_userland_initial in .text.syscall_trampoline
      lea rax, [rip + enter_userland_initial];
      lea rcx, [rip + _syscall_trampoline_start];
      cmp rax, rcx;
      jb  enter_reloc_fail;
      lea rcx, [rip + _syscall_trampoline_end];
      cmp rax, rcx;
      jae enter_reloc_fail;

      // Assert _iretq_frame_scratch in .data.syscall_trampoline
      lea rax, [rip + _iretq_frame_scratch];
      lea rcx, [rip + _syscall_trampoline_data_start];
      cmp rax, rcx;
      jb  enter_reloc_fail;
      lea rcx, [rip + _syscall_trampoline_data_end];
      cmp rax, rcx;
      jae enter_reloc_fail;

      // Round-trip write to the five iretq slots
      lea r8, [rip + _iretq_frame_scratch];
      mov rax, 0xDEAD;      mov [r8 + 0],  rax;
      mov rax, 0x2B;        mov [r8 + 8],  rax;
      mov rax, 0x202;       mov [r8 + 16], rax;
      mov rax, 0xBEEF;      mov [r8 + 24], rax;
      mov rax, 0x23;        mov [r8 + 32], rax;

      mov rax, [r8 + 0];    mov rcx, 0xDEAD;  cmp rax, rcx;  jne enter_reloc_fail;
      mov rax, [r8 + 32];   mov rcx, 0x23;    cmp rax, rcx;  jne enter_reloc_fail;

      mov rdi, 3;
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + enter_reloc_ok_msg];
      call klog_s1;
      jmp enter_reloc_done;

      enter_reloc_fail:
      mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + enter_reloc_fail_msg];
      call klog_s1;

      enter_reloc_done:

      // ============================================================
      // R15-M2-006b (#652): first ring-3 witness — user _start = hlt.
      // ============================================================

      mov rdi, 3;
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + ring3_start_msg];
      call klog_s1;

      // 1. Save kernel resume state (for #GP handler trap-frame surgery).
      mov rax, rsp;
      lea rcx, [rip + _kernel_resume_rsp];
      mov [rcx], rax;

      mov rdi, 3;
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + ring3_saved_rsp_msg];
      call klog_s1;

      // 2. Build witness PML4 (kernel higher-half copy + zero user half).
      mov rdi, 3;
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + ring3_create_pml4_msg];
      call klog_s1;

      mov rdi, [rip + _kernel_pml4_pa];
      call aspace_create;
      // #652 latent bug: save aspace_create's result (rax) into r12 BEFORE
      // the debug uart_puts below runs — uart_puts's char-copy loop leaves
      // rax=0 at exit (last byte read is the string's null terminator), so
      // calling it before checking/saving rax silently clobbered the real
      // return value, making witness_pml4_pa always 0 (which then loaded
      // CR3 with 0, causing the immediate #PF this witness was meant to
      // avoid). The very next block (phys_alloc below) already avoids this
      // exact trap via its "Save phys_alloc result... Check saved result,
      // not clobbered rax" comment; this site had been missed.
      mov r12, rax;                            // r12 = witness_pml4_pa

      mov rdi, 3;
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + ring3_aspace_done_msg];
      call klog_s1;

      mov rcx, 0xFFFFFFFF;
      cmp r12, rcx;
      je  ring3_witness_fail;

      // 3. Allocate a phys frame + write 0xF4 (hlt) + map at 0x400000.
      mov rdi, 3;
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + ring3_phys_alloc_msg];
      call klog_s1;

      mov rdi, 0;
      call phys_alloc;
      mov r13, rax;                            // Save phys_alloc result in r13
      mov r8, rax;                             // Also save in r8 for later check

      mov rdi, 3;
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + ring3_phys_done_msg];
      call klog_s1;

      cmp r8, 0;                               // Check saved result, not clobbered rax
      je  ring3_witness_fail;

      mov rdi, 3;
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + ring3_calc_va_msg];
      call klog_s1;

      // #652 fix: r13 (phys_alloc's result) is ALREADY a directly-writable
      // kernel VA (phys_alloc computes &_phys_page_pool + offset via a
      // RIP-relative lea, which resolves to the pool's high-half-linked
      // runtime address, not a genuine low physical address — see the
      // matching fix + full explanation in aspace_map.pdx). Adding
      // KERNEL_VMA_BASE again here produced a non-canonical address; write
      // through r13 directly instead.
      mov rdi, 3;
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + ring3_write_hlt_msg];
      call klog_s1;

      // #650: Write 3 bytes: 0x0F 0x0B 0xF4 (ud2 then hlt)
      mov rax, 0x0F;
      mov [r13], al;                           // ud2 byte 1
      mov rax, 0x0B;
      mov [r13 + 1], al;                       // ud2 byte 2
      mov rax, 0xF4;
      mov [r13 + 2], al;                       // hlt

      mov rdi, 3;
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + ring3_wrote_hlt_msg];
      call klog_s1;

      mov rdi, r12;                            // aspace
      mov rsi, 0x400000;                       // user VA
      mov rdx, r13;                            // phys
      mov rcx, 0x05;                           // P | U (X=1 via cleared NX)

      lea rsi, [rip + ring3_aspace_map_msg];
      mov rdi, rsi;
      call uart_puts;

      mov rdi, r12;                            // aspace (reload since uart_puts clobbered rdi)
      mov rsi, 0x400000;                       // user VA
      mov rdx, r13;                            // phys
      mov rcx, 0x05;                           // P | U (X=1 via cleared NX)
      call aspace_map;
      cmp rax, 0;
      jne ring3_witness_fail;                  // MAP_OOM = 0xFFFFFFFE, non-zero

      // 4. Allocate user stack in witness PML4.
      // Allocate physical frame for user stack
      mov rdi, 3;
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + ring3_stack_alloc_msg];
      call klog_s1;

      mov rdi, 0;
      call phys_alloc;
      cmp rax, 0;
      je  ring3_witness_fail;
      mov r8, rax;                             // r8 = stack_page_pa

      // Map at 0x7FFFFFFFF000 with R+W+U+NX
      mov rdi, r12;                            // aspace (witness PML4)
      mov rsi, 0x7FFFFFFFF000;                 // user stack VA
      mov rdx, r8;                             // phys
      mov rcx, 0x8000000000000007;             // R+W+U+NX (bit 63=1 for NX, bits 2,1,0 for U,W,P)
      call aspace_map;
      cmp rax, 0;
      jne ring3_witness_fail;

      mov rdi, 3;
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + ring3_stack_done_msg];
      call klog_s1;

      mov r14, 0x7FFFFFFFF000;                 // r14 = user_rsp

      // 5. Arm the witness flags (read by _typed_handler_6 and _typed_handler_13).
      mov rax, 1;
      lea rcx, [rip + _ring3_witness_active];
      mov [rcx], rax;
      lea rcx, [rip + _ud_witness_active];
      mov [rcx], rax;

      // 6. Enter userland. iretq → ring-3 → hlt → #GP → handler resumes below.
      mov rdi, 3;
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + ring3_enter_msg];
      call klog_s1;

      mov rdi, 0x400000;                       // entry_rip
      mov rsi, r14;                            // initial_rsp
      mov rdx, r12;                            // witness_pml4_pa (VA form, from aspace_create)
      // #652 fix: r12 is aspace_create's VA-style return value (needed as-is
      // for the aspace_map calls above, which index it as a pointer). CR3
      // needs a genuine physical address; convert here, at the last possible
      // point, so the aspace_map calls above keep using the VA form. (SUB
      // has no imm64 form, so movabs the constant into a register first.)
      mov rax, 0xFFFF800000000000;             // KERNEL_VMA_BASE
      sub rdx, rax;                             // rdx = genuine PA for CR3
      call enter_userland_initial;

      // UNREACHABLE — enter_userland_initial iretq's into ring-3. Fall-through
      // here would only happen if the primitive returned normally, which its
      // ud2 sentinel forbids. Belt-and-braces sentinel:
      mov rdi, 3;
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + ring3_returned_msg];
      call klog_s1;
      lea rdi, [rip + SUBSYS_BOOT];
      lea rsi, [rip + tag_ring3_returned];
      call klog_panic;
      jmp ring3_witness_fail;

      ring3_witness_fail:
      mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + ring3_fail_msg];
      call klog_s1;

      ring3_witness_done:
      jmp kpti_done;

      kpti_fail:
      mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + kpti_fail_msg];
      call klog_s1;

      kpti_done:

      // M3-002 (#690): the exception-handler wire-up to klog_dump_trap_frame
      // lives in src/kernel/core/int/exceptions.pdx; #689's fake-frame witnesses
      // already exercise the primitive end-to-end. A runtime int3 witness that
      // fires vec 3 and halts requires either a compile-time gate or a
      // dedicated boot target to avoid halting every other smoke mode's boot;
      // tracked as #715 followup.

      // ============================================================
      // M6-001 (#696) Phase A: dormant kassert_fail symbol witness
      // ============================================================
      // Linker-retained reference to kassert_fail (real body landing now,
      // invocation gated in Phase B by boot_panic_smoke mode). Prevents symbol
      // from being stripped. No panic fires; witness is read-only.
      lea rax, [rip + kassert_fail];
      xor rax, rax;

      call boot_continue_after_ring3;
    }
  } @no_frame

  // R15-M2-006b (#652): boot_continue_after_ring3 — the remainder of the
  // boot sequence (GS_BASE setup through Task A bootstrap), extracted into
  // its own top-level (pub) function so it is a real, lea/call-addressable
  // ELF symbol. paideia-as does not support taking the address of a bare
  // block-local label (see justification below and
  // design/kernel/r15-m2-006b-boot-r15-ring3-hello.md) — only `jmp`/`jcc`
  // may target local labels, so _typed_handler_13's ring-3 witness resume
  // path (a different module, exceptions.pdx) can only transfer control
  // into "the rest of boot" via an ordinary cross-module `call` to a real
  // top-level symbol. Both kernel_main_64's own kpti_done fallthrough and
  // the exception handler's resume path now call this function.
  pub let boot_continue_after_ring3 : () -> () !{sysreg} @{} = fn () -> unsafe {
    effects: { sysreg }, capabilities: { boot },
    justification: "R15-M2-006b (#652) + R18-M4-003 (#773): extracted tail of kernel_main_64 (GS_BASE setup, process_init, syscall_msr_init, apic_enable/apic_svr_enable/pic_mask_all, IPI structural witness, loader structural witness, LAPIC timer init, scheduler init, Task A bootstrap, and the unreachable cooperative-yield loop) so it is callable both from kernel_main_64's own kpti_done fallthrough and from _typed_handler_13's ring-3 witness resume path (paideia-as cannot `lea` a bare local label, only a top-level pub symbol). #773: added an EARLY gs_base_init_bsp call at the top so the per-CPU runqueue primitives (runq_init/enqueue/dequeue, sched_pick_next_r15 — all rdmsr IA32_GS_BASE-driven post-#773) work in every downstream witness (sys_exit_witness at ~2114, sys_fork_witness at ~2648, uart_rx_notify_witness at ~5741, etc.).  The late gs_base_init_bsp call at ~7116 is left in place to re-write IA32_KERNEL_GS_BASE after syscall_msr_init clobbers it with a placeholder (this second call is a no-op for IA32_GS_BASE — its concern is KERNEL_GS_BASE).",
    block: {
      // ============================================================
      // R18-M4-003 (#773): EARLY gs_base_init_bsp — program IA32_GS_BASE
      // to point at the BSP's Percpu CB[0] before any downstream witness
      // touches the runqueue.  Post-#773 runq_init/enqueue/dequeue and
      // sched_pick_next_r15 all reach their per-CPU head/tail via rdmsr
      // IA32_GS_BASE + deref, so without this early call the sys_exit /
      // sys_fork / uart_rx_notify witnesses below would deref a zero
      // GS_BASE and page-fault.  gs_base_init_bsp is self-contained
      // (percpu_init + percpu_cb_for are pure .bss writes / arithmetic
      // — no scheduler / mm / syscall dependency), so calling it here
      // is safe.  Idempotent: the second call at ~7116 (after
      // syscall_msr_init) still runs to fix up IA32_KERNEL_GS_BASE
      // which syscall_msr_init clobbers with a placeholder.
      // ============================================================
      call gs_base_init_bsp;

      // ============================================================
      // R18-M6-001 (#779) + R18-M6-002 (#780): per-CPU CPUID topology
      // sweep. Reads CPUID 0x1A (hybrid class) and walks CPUID 0x1F /
      // 0x0B (package / core / thread) into CB[+120..+128) on the BSP.
      // Runs immediately after gs_base_init_bsp so all downstream
      // witnesses can rely on the topology fields being populated.
      // On QEMU (no hybrid) hybrid_class lands as 0 (Unknown), matching
      // #779 AC #3. See core/smp/topology.pdx for the CPUID decode.
      // ============================================================
      call topology_init;

      // ============================================================
      // R15-M5-007 (#549): fd_table witness — three one-liners.
      // ============================================================

      // Zero the witness task (uninit .bss is zero on ELF load, but be explicit).
      lea rdi, [rip + _fd_witness_task];

      // --- (1) fd_alloc should return 3 on a fresh task ---
      call fd_alloc;
      cmp  rax, 3;
      jne  fd_witness_fail;

      // --- (2) fd_set(t, 5, 0xDEADBEEFCAFEBABE) then fd_get(t, 5) round-trip ---
      lea rdi, [rip + _fd_witness_task];
      mov rsi, 5;
      mov rdx, 0xDEADBEEFCAFEBABE;
      call fd_set;

      lea rdi, [rip + _fd_witness_task];
      mov rsi, 5;
      call fd_get;
      mov rcx, 0xDEADBEEFCAFEBABE;
      cmp rax, rcx;
      jne fd_witness_fail;

      // --- (3) fd_alloc after fd_set(5, x) still returns 3 (first hole is 3) ---
      lea rdi, [rip + _fd_witness_task];
      call fd_alloc;
      cmp rax, 3;
      jne fd_witness_fail;

      // --- (4) fd_set(t, 3, x) → fd_alloc returns 4 (first free slot moved up) ---
      lea rdi, [rip + _fd_witness_task];
      mov rsi, 3;
      mov rdx, 0x1;                                // non-zero → allocated marker
      call fd_set;

      lea rdi, [rip + _fd_witness_task];
      call fd_alloc;
      cmp rax, 4;
      jne fd_witness_fail;

      // --- All four checks passed. Emit marker. ---
      mov rdi, 3;
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + fd_witness_ok_msg];
      call klog_s1;
      jmp  fd_witness_done;

      fd_witness_fail:
      mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + fd_witness_fail_msg];
      call klog_s1;

      fd_witness_done:

      // ============================================================
      // R15-M5-008 (#550): task_free witness — 100-iter round-trip
      // ============================================================
      xor r15, r15;                        // counter
      call phys_alloc_free_count;
      mov r14, rax;                        // free_count snapshot

task_free_witness_loop:
      cmp r15, 100;
      jae task_free_witness_pool_check;    // explicit exit — H1 guard

      xor rdi, rdi;                        // parent = NULL (init)
      call task_new;
      cmp rax, 0;
      je task_free_witness_fail;
      mov r12, rax;

      // assert pid == 1
      mov eax, [r12 + 0];
      cmp eax, 1;
      jne task_free_witness_fail;

      // free
      mov rdi, r12;
      call task_free;

      // post: pid_table[1] == NULL
      lea rax, [rip + _pid_table];
      mov rcx, [rax + 8];
      cmp rcx, 0;
      jne task_free_witness_fail;

      // post: slab zeroed (probe pml4 slot at +16)
      mov rcx, [r12 + 16];
      cmp rcx, 0;
      jne task_free_witness_fail;

      add r15, 1;                          // increment — H1 guard
      jmp task_free_witness_loop;

task_free_witness_pool_check:
      call phys_alloc_free_count;
      cmp rax, r14;
      jne task_free_witness_fail;

      mov rdi, 3;
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + task_free_witness_ok_msg];
      call klog_s1;
      jmp task_free_witness_exit;

task_free_witness_fail:
      mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + task_free_witness_fail_msg];
      call klog_s1;

task_free_witness_exit:                   // UNIQUE label — H3 guard

      // ============================================================
      // R15-M5-006 (#548): task_new witness — single-call construction
      // ============================================================

      // task_new(NULL) — construct init.
      xor rdi, rdi;                              // parent = NULL sentinel
      call task_new;
      cmp rax, 0;
      je  task_new_witness_fail;                 // 0 = OOM = bug at boot

      mov r12, rax;                              // r12 = task_struct*

      // Check 1: pid == 1
      mov eax, [r12 + 0];                        // pid @ 0 (u32)
      cmp eax, 1;
      jne task_new_witness_fail;

      // Check 2: parent_pid == 0
      mov eax, [r12 + 4];                        // parent_pid @ 4 (u32)
      cmp eax, 0;
      jne task_new_witness_fail;

      // Check 3: state == STATE_NEW (0)
      mov eax, [r12 + 8];                        // state @ 8 (u32)
      cmp eax, 0;
      jne task_new_witness_fail;

      // Check 4: user_pml4_pa != 0
      mov rax, [r12 + 16];                       // user_pml4_pa @ 16 (u64)
      cmp rax, 0;
      je  task_new_witness_fail;

      // Check 5: pid_table[1] == r12
      lea rax, [rip + _pid_table];
      mov rcx, [rax + 8];                        // pid_table[1] (index 1 * 8 = 8)
      cmp rcx, r12;
      jne task_new_witness_fail;

      // All checks green
      mov rdi, 3;
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + task_new_witness_ok_msg];
      call klog_s1;
      jmp task_new_witness_exit;

      task_new_witness_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + task_new_witness_fail_msg];
          call klog_s1;

      task_new_witness_exit:

      // R15-M5-009 (#551): 3-task pool witness. Verify pid_alloc advances
      // densely (1→2→3), each task_new succeeds (slab != 0), and
      // pid_table publishes correctly at indices 2, 3.
      // Precondition: r12 = slab_1 from #548 witness (or 0 if task 1 failed).
      // Register use: r12=slab_1, r13=slab_2, r14=slab_3 (all callee-saved across task_new).

      pool_witness:
          // Step 1: guard — bail if task 1 witness failed (r12 = 0)
          cmp r12, 0;
          je pool_witness_fail;

          // Step 2: construct task 2 → verify pid == 2 → save slab in r13
          xor rdi, rdi;                         // parent = NULL
          call task_new;
          cmp rax, 0;
          je pool_witness_fail;
          mov r13, rax;                         // r13 = slab_2
          mov eax, [r13 + 0];                   // pid @ offset 0 (u32)
          cmp eax, 2;
          jne pool_witness_fail;

          // Step 3: construct task 3 → verify pid == 3 → save slab in r14
          xor rdi, rdi;
          call task_new;
          cmp rax, 0;
          je pool_witness_fail;
          mov r14, rax;                         // r14 = slab_3
          mov eax, [r14 + 0];                   // pid @ offset 0 (u32)
          cmp eax, 3;
          jne pool_witness_fail;

          // Step 4: publish check — pid_table[2] == r13, pid_table[3] == r14
          lea rax, [rip + _pid_table];
          mov rcx, [rax + 16];                  // pid_table[2] @ index 2*8 = 16
          cmp rcx, r13;
          jne pool_witness_fail;
          mov rcx, [rax + 24];                  // pid_table[3] @ index 3*8 = 24
          cmp rcx, r14;
          jne pool_witness_fail;

          // All checks green
          mov rdi, 3;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + pool_witness_ok_msg];
          call klog_s1;
          jmp pool_witness_exit;

      pool_witness_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + pool_witness_fail_msg];
          call klog_s1;

      pool_witness_exit:

      // ============================================================
      // R15-M6-006 (#557) + R17-M0-724-D5b (#724): sys_exit witness — 2 sub-tests, 1 marker
      // ============================================================
      sys_exit_witness:
          // #724 D5b precondition: sys_exit_body's step 6.5 now calls
          // runq_enqueue(parent) on the wake path. That requires the
          // runqueue sentinel to be initialized (else the writes into
          // head.prev + 432 fault). Call runq_init here — idempotent
          // per runqueue.pdx §runq_init "safe to re-call", so the real
          // runq_init at kernel_main.pdx:6317 (scheduler bootstrap)
          // still succeeds. Mirrors the pattern in sys_fork_witness
          // (kernel_main.pdx:2375) for #724 D6's own runq_enqueue.
          call runq_init;

          // ---------- Sub-test 1: non-WAITING parent, no reap ----------
          // parent = task_new(NULL)
          xor rdi, rdi;
          call task_new;
          cmp rax, 0;
          je  sys_exit_witness_fail;
          mov r12, rax;                                // r12 = parent (pid 4)

          // child = task_new(parent)
          mov rdi, r12;
          call task_new;
          cmp rax, 0;
          je  sys_exit_witness_fail;
          mov r13, rax;                                // r13 = child (pid 5)

          // Set child->state = STATE_RUNNABLE (1) — simulate running
          // Not strictly required (NEW→ZOMBIE is a legal transition
          // per §3.4 — task_new default), but documents intent.
          mov rax, 1;
          mov [r13 + 8], eax;                          // child->state = RUNNABLE

          // sys_exit_body(child, 42)
          mov rdi, r13;
          mov rsi, 42;
          call sys_exit_body;

          // Assert: child->state == STATE_ZOMBIE (3)
          mov eax, [r13 + 8];
          cmp rax, 3;
          jne sys_exit_witness_fail;

          // Assert: child->exit_status == 42
          mov eax, [r13 + 12];
          cmp rax, 42;
          jne sys_exit_witness_fail;

          // Assert: parent->state unchanged (NEW = 0)
          mov eax, [r12 + 8];
          cmp rax, 0;
          jne sys_exit_witness_fail;

          // Assert: parent->wait_result_pid unchanged (0)
          mov eax, [r12 + 1704];
          cmp rax, 0;
          jne sys_exit_witness_fail;

          // ---------- Sub-test 2: WAITING parent, reap wakeup ----------
          // parent2 = task_new(NULL)
          xor rdi, rdi;
          call task_new;
          cmp rax, 0;
          je  sys_exit_witness_fail;
          mov r12, rax;                                // r12 = parent2 (pid 6)

          // Set parent2->state = STATE_WAITING (2) — simulate parked in sys_wait
          mov rax, 2;
          mov [r12 + 8], eax;

          // child2 = task_new(parent2)
          mov rdi, r12;
          call task_new;
          cmp rax, 0;
          je  sys_exit_witness_fail;
          mov r13, rax;                                // r13 = child2 (pid 7)

          // sys_exit_body(child2, 99)
          mov rdi, r13;
          mov rsi, 99;
          call sys_exit_body;

          // Assert: child2->state == STATE_ZOMBIE
          mov eax, [r13 + 8];
          cmp rax, 3;
          jne sys_exit_witness_fail;

          // Assert: child2->exit_status == 99
          mov eax, [r13 + 12];
          cmp rax, 99;
          jne sys_exit_witness_fail;

          // Assert: parent2->state == STATE_RUNNABLE (1) — was 2, wakeup transition
          mov eax, [r12 + 8];
          cmp rax, 1;
          jne sys_exit_witness_fail;

          // Assert: parent2->wait_result_pid == child2->pid (7)
          mov eax, [r13 + 0];                          // child2->pid
          mov ecx, [r12 + 1704];                       // parent2->wait_result_pid
          cmp rax, rcx;
          jne sys_exit_witness_fail;

          // Assert: parent2->wait_result_status == 99
          mov eax, [r12 + 1708];
          cmp rax, 99;
          jne sys_exit_witness_fail;

          // #724 D5b assertion (rewired for #773): parent2 is now on the
          // runqueue.  Post-#773 the runqueue lives at PERCPU_OFF_RUNQUEUE_HEAD
          // (+32) in this CPU's Percpu CB (no more `_runq_head_slot`
          // sentinel).  Single-element enqueue leaves CB.head == parent2, so
          // we deref [gs:32] (via rdmsr IA32_GS_BASE + [rax+32]) and compare.
          mov rcx, 0xC0000101;
          rdmsr;
          shl rdx, 32;
          or  rax, rdx;
          mov rcx, [rax + 32];                          // CB.runqueue_head
          cmp rcx, r12;
          jne sys_exit_witness_fail;

          // ---------- Cleanup: dequeue parent2, then retire it (#562 fix) ----------
          // Two-part cleanup:
          // (1) runq_dequeue(parent2) — parent2 was placed on the runqueue
          //     by sys_exit_body's D5b step 6.5. Left dangling, it would
          //     survive across the real runq_init call at kernel_main.pdx:6317
          //     (which just re-writes the head sentinel; existing dangling
          //     next/prev pointers are orphaned but harmless). Explicit
          //     dequeue keeps the witness's contract crisp — we started
          //     empty (via the runq_init at the top of this witness), we
          //     end empty. Mirrors sys_fork_witness's cleanup at
          //     kernel_main.pdx:2516.
          mov rdi, r12;
          call runq_dequeue;

          // (2) Retire parent2 to STATE_ZOMBIE (3) so idle_witness's
          //     pick_next sub-test (#562) doesn't stop on it. See original
          //     comment: parent2 exists solely to demonstrate the
          //     WAITING->RUNNABLE wakeup transition above; without this
          //     retirement, the pick_next linear scan of _pid_table stops
          //     on parent2's slot (state RUNNABLE) instead of falling
          //     through to _idle_tcb, and the idle witness spuriously fails.
          mov rax, 3;                                   // STATE_ZOMBIE
          mov [r12 + 8], eax;                           // parent2->state = STATE_ZOMBIE

          // ---------- All checks green ----------
          mov rdi, 3;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + sys_exit_witness_ok_msg];
          call klog_s1;
          jmp sys_exit_witness_exit;

      sys_exit_witness_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + sys_exit_witness_fail_msg];
          call klog_s1;

      sys_exit_witness_exit:

      // ============================================================
      // R15-M6-005 (#556): sys_wait witness — 3 sub-tests, 1 marker
      // ============================================================
      sys_wait_witness:
          // ---------- Sub-test A: zombie found, reap ----------
          // parent_a = task_new(NULL)
          xor rdi, rdi;
          call task_new;
          cmp rax, 0;
          je  sys_wait_witness_fail;
          mov r12, rax;                                // r12 = parent_a (pid 8)

          // child_a = task_new(parent_a)
          mov rdi, r12;
          call task_new;
          cmp rax, 0;
          je  sys_wait_witness_fail;
          mov r13, rax;                                // r13 = child_a (pid 9)

          // Manually mark child_a as ZOMBIE with exit_status = 42
          mov rax, 3;                                  // STATE_ZOMBIE
          mov [r13 + 8], eax;
          mov rax, 42;
          mov [r13 + 12], eax;                         // exit_status = 42

          // sys_wait_body(parent_a)
          mov rdi, r12;
          call sys_wait_body;

          // Assert: rax == child_a->pid (9)
          // NOTE: `and rcx, 0xFFFFFFFF` after a 64-bit load is a no-op on
          // x86-64 — AND r64, imm32 sign-extends 0xFFFFFFFF (== -1 as i32)
          // to 0xFFFFFFFFFFFFFFFF, an identity mask, not a truncation mask.
          // Use a genuine zero-extending 32-bit load instead (mov ecx, ...
          // zero-extends the upper 32 bits of rcx per x86-64 semantics).
          mov ecx, [r13 + 0];                          // child_a->pid (u32, zero-ext)
          cmp rax, rcx;
          jne sys_wait_witness_fail;

          // Assert: rdx == 42
          cmp rdx, 42;
          jne sys_wait_witness_fail;

          // Assert: _pid_table[child_a->pid] == 0 (child slot reaped)
          // NOTE: use the actual pid (still in rcx from the check above,
          // dynamic SIB index) rather than a hardcoded slot literal — see
          // the sub-test B note below for why a literal is fragile here.
          lea rax, [rip + _pid_table];
          mov rax, [rax + rcx*8];
          cmp rax, 0;
          jne sys_wait_witness_fail;

          // Assert: parent_a->state unchanged (NEW = 0)
          mov eax, [r12 + 8];
          cmp rax, 0;
          jne sys_wait_witness_fail;

          // ---------- Sub-test B: no zombie, block ----------
          // parent_b = task_new(NULL)
          xor rdi, rdi;
          call task_new;
          cmp rax, 0;
          je  sys_wait_witness_fail;
          mov r12, rax;                                // r12 = parent_b (reuses pid 9,
                                                        // freed by sub-test A's reap —
                                                        // pid_alloc is dense-low-first)

          // child_b = task_new(parent_b)  — state stays at NEW (=0)
          mov rdi, r12;
          call task_new;
          cmp rax, 0;
          je  sys_wait_witness_fail;
          mov r13, rax;                                // r13 = child_b (pid 10)

          // sys_wait_body(parent_b)
          mov rdi, r12;
          call sys_wait_body;

          // Assert: rax == 0 (would-block signal — dispatch layer must invoke sched_block)
          cmp rax, 0;
          jne sys_wait_witness_fail;

          // Assert: parent_b->state == STATE_NEW (0) — UNCHANGED by the body.
          // #724 D5a change: sys_wait_body no longer writes STATE_WAITING on
          // the would-block path. The RUNNABLE→WAITING transition is now
          // performed by sched_block, which is invoked by dispatch_wait4 on
          // the rax==0 signal (not exercised in this boot witness — sched_block
          // would swap kernel stacks; separately verified by block_wake_witness
          // at kernel_main.pdx:6679). Asserting state is UNCHANGED here proves
          // sys_wait_body is a pure "check + reap-or-signal" leaf, with no
          // scheduler side-effect. See
          // design/kernel/r17-m0-724-d5-sys-wait-block.md §9.1.
          mov eax, [r12 + 8];
          cmp rax, 0;
          jne sys_wait_witness_fail;

          // Assert: child_b->state unchanged (NEW = 0)
          mov eax, [r13 + 8];
          cmp rax, 0;
          jne sys_wait_witness_fail;

          // Assert: _pid_table[child_b->pid] != 0 (child NOT reaped)
          // NOTE: a hardcoded slot literal (originally "slot 11") is fragile
          // here — sub-test A's reap (pid_free(9)) frees pid 9, so pid_alloc
          // (dense-low-first scan) hands parent_b pid 9 (reused) instead of
          // the naively-expected pid 10, and child_b becomes pid 10 instead
          // of pid 11. Index _pid_table dynamically via the actual pid
          // (u32 zero-ext load, then SIB scale-8), matching the addressing
          // idiom sys_wait_body itself uses, instead of assuming a fixed
          // allocation-order slot.
          mov ecx, [r13 + 0];                          // child_b->pid (u32, zero-ext)
          lea rax, [rip + _pid_table];
          mov rax, [rax + rcx*8];
          cmp rax, 0;
          je  sys_wait_witness_fail;

          // ---------- Sub-test C: no children, ECHILD ----------
          // parent_c = task_new(NULL)
          xor rdi, rdi;
          call task_new;
          cmp rax, 0;
          je  sys_wait_witness_fail;
          mov r12, rax;                                // r12 = parent_c (pid 11)

          // sys_wait_body(parent_c) — no children exist for parent_c's pid
          mov rdi, r12;
          call sys_wait_body;

          // Assert: rax == -ECHILD (0xFFFFFFFFFFFFFFF6)
          mov rcx, 0xFFFFFFFFFFFFFFF6;
          cmp rax, rcx;
          jne sys_wait_witness_fail;

          // Assert: parent_c->state unchanged (NEW = 0)
          mov eax, [r12 + 8];
          cmp rax, 0;
          jne sys_wait_witness_fail;

          // ---------- All checks green ----------
          mov rdi, 3;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + sys_wait_witness_ok_msg];
          call klog_s1;
          jmp sys_wait_witness_exit;

      sys_wait_witness_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + sys_wait_witness_fail_msg];
          call klog_s1;

      sys_wait_witness_exit:

      // ============================================================
      // R15-M6-004 (#555): sys_execve witness — 2 sub-tests, 1 marker
      // ============================================================
      sys_execve_witness:
          // ---------- Sub-test A: valid ELF, success + swap ----------
          // t_a = task_new(NULL) — provides a live user_pml4_pa @ 16
          xor rdi, rdi;
          call task_new;
          cmp rax, 0;
          je  sys_execve_witness_fail;
          mov r12, rax;                                // r12 = t_a slab

          // Save t_a->user_pml4_pa (old_pml4), pid, state for later compare
          mov rax, [r12 + 16];
          mov r13, rax;                                // r13 = old_pml4
          mov eax, [r12 + 0];
          mov r14d, eax;                               // r14 = t_a->pid (u32)
          mov eax, [r12 + 8];
          mov r15d, eax;                               // r15 = t_a->state (u32)

          // sys_execve_body(t_a, _shell_bin_start, image_len)
          mov rdi, r12;
          lea rsi, [rip + _shell_bin_start];
          lea rax, [rip + _shell_bin_end];
          sub rax, rsi;                                // rax = image_len
          mov rdx, rax;
          call sys_execve_body;

          // Assert: rax == 0 (ELF_OK)
          cmp rax, 0;
          jne sys_execve_witness_fail;

          // Assert: rdx == *(u64 *)(_shell_bin_start + 24) (ELF e_entry)
          lea rcx, [rip + _shell_bin_start];
          mov rax, [rcx + 24];                         // expected entry_rip
          cmp rdx, rax;
          jne sys_execve_witness_fail;

          // Assert: t_a->user_pml4_pa != old_pml4 (swap happened)
          mov rax, [r12 + 16];
          cmp rax, r13;
          je  sys_execve_witness_fail;

          // Assert: t_a->pid unchanged
          mov eax, [r12 + 0];
          cmp eax, r14d;
          jne sys_execve_witness_fail;

          // Assert: t_a->state unchanged
          mov eax, [r12 + 8];
          cmp eax, r15d;
          jne sys_execve_witness_fail;

          // ---------- Sub-test B: invalid ELF, rollback ----------
          // t_b = task_new(NULL) — fresh user_pml4_pa
          xor rdi, rdi;
          call task_new;
          cmp rax, 0;
          je  sys_execve_witness_fail;
          mov r12, rax;                                // r12 = t_b slab

          // Save t_b->user_pml4_pa (old_pml4_b), pid, state
          mov rax, [r12 + 16];
          mov r13, rax;                                // r13 = old_pml4_b
          mov eax, [r12 + 0];
          mov r14d, eax;                               // r14 = t_b->pid
          mov eax, [r12 + 8];
          mov r15d, eax;                               // r15 = t_b->state

          // sys_execve_body(t_b, _bad_elf_stub_start, 64)
          mov rdi, r12;
          lea rsi, [rip + _bad_elf_stub_start];
          mov rdx, 64;
          call sys_execve_body;

          // Assert: rax != 0 (some error code)
          cmp rax, 0;
          je  sys_execve_witness_fail;

          // Assert: rax == 0xFFFFFFFF (ELF_BAD_HDR — magic gate rejected the stub)
          mov rcx, 0xFFFFFFFF;
          cmp rax, rcx;
          jne sys_execve_witness_fail;

          // Assert: t_b->user_pml4_pa == old_pml4_b (unchanged — rollback preserved)
          mov rax, [r12 + 16];
          cmp rax, r13;
          jne sys_execve_witness_fail;

          // Assert: t_b->pid unchanged
          mov eax, [r12 + 0];
          cmp eax, r14d;
          jne sys_execve_witness_fail;

          // Assert: t_b->state unchanged
          mov eax, [r12 + 8];
          cmp eax, r15d;
          jne sys_execve_witness_fail;

          // ---------- All checks green ----------
          mov rdi, 3;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + sys_execve_witness_ok_msg];
          call klog_s1;
          jmp sys_execve_witness_exit;

      sys_execve_witness_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + sys_execve_witness_fail_msg];
          call klog_s1;

      sys_execve_witness_exit:

      // ============================================================
      // R15-M6-007 (#558): orphan_adopt witness — 3-gen cascade, 1 marker
      // ============================================================
      orphan_adoption_witness:
          // ---------- Setup: build A → B → C chain ----------
          // Load pid-1 slab (fake init from task_new_witness) into rdi as A's parent.
          // task_new(parent) sets child->parent_pid = parent->pid, so passing the
          // pid-1 slab makes A->parent_pid = 1. This avoids the parent_pid == 0
          // case (which sys_exit's step-3 guard treats as "init exiting").
          lea rax, [rip + _pid_table];
          mov rdi, [rax + 8];                          // _pid_table[1] (SIB scale-8)
          cmp rdi, 0;
          je  orphan_adoption_witness_fail;            // pid 1 not populated (bug in earlier witness)

          // A = task_new(_pid_table[1])
          call task_new;
          cmp rax, 0;
          je  orphan_adoption_witness_fail;
          mov r12, rax;                                // r12 = A slab

          // B = task_new(A)
          mov rdi, r12;
          call task_new;
          cmp rax, 0;
          je  orphan_adoption_witness_fail;
          mov r13, rax;                                // r13 = B slab

          // C = task_new(B)
          mov rdi, r13;
          call task_new;
          cmp rax, 0;
          je  orphan_adoption_witness_fail;
          mov r14, rax;                                // r14 = C slab

          // ---------- Pre-exit assertions ----------
          // Assert: B->parent_pid == A->pid
          mov eax, [r12 + 0];                          // A->pid
          mov ecx, [r13 + 4];                          // B->parent_pid
          cmp eax, ecx;
          jne orphan_adoption_witness_fail;

          // Assert: C->parent_pid == B->pid
          mov eax, [r13 + 0];                          // B->pid
          mov ecx, [r14 + 4];                          // C->parent_pid
          cmp eax, ecx;
          jne orphan_adoption_witness_fail;

          // ---------- Phase 1: A exits ----------
          // sys_exit_body(A, 0)
          mov rdi, r12;
          xor rsi, rsi;                                 // status = 0
          call sys_exit_body;

          // Assert: A->state == STATE_ZOMBIE (3)
          mov eax, [r12 + 8];
          cmp rax, 3;
          jne orphan_adoption_witness_fail;

          // Assert: B->parent_pid == 1 (adopted)
          mov eax, [r13 + 4];
          cmp rax, 1;
          jne orphan_adoption_witness_fail;

          // Assert: C->parent_pid == B->pid (unchanged — B still alive)
          mov eax, [r13 + 0];                          // B->pid
          mov ecx, [r14 + 4];                          // C->parent_pid
          cmp eax, ecx;
          jne orphan_adoption_witness_fail;

          // ---------- Phase 2: B exits ----------
          // sys_exit_body(B, 0)
          mov rdi, r13;
          xor rsi, rsi;
          call sys_exit_body;

          // Assert: B->state == STATE_ZOMBIE (3)
          mov eax, [r13 + 8];
          cmp rax, 3;
          jne orphan_adoption_witness_fail;

          // Assert: C->parent_pid == 1 (now adopted)
          mov eax, [r14 + 4];
          cmp rax, 1;
          jne orphan_adoption_witness_fail;

          // ---------- All checks green ----------
          mov rdi, 3;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + orphan_adoption_witness_ok_msg];
          call klog_s1;
          jmp orphan_adoption_witness_exit;

      orphan_adoption_witness_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + orphan_adoption_witness_fail_msg];
          call klog_s1;

      orphan_adoption_witness_exit:

      // ============================================================
      // R15-M6-003 (#554) + R17-M0-724-D6 (#724): sys_fork witness — testable happy path
      // ============================================================
      // #724-D6: sys_fork_body now materializes child regs_save and calls
      // runq_enqueue. Preconditions this witness must establish:
      //   (a) runq_init has been called — else the enqueue writes through a
      //       NULL head.prev, faulting. The real runq_init call happens at
      //       kernel_main.pdx:6317 during scheduler bootstrap, which is
      //       AFTER this witness runs; calling it here is idempotent (see
      //       runqueue.pdx §runq_init "Idempotent: safe to re-call") and
      //       the later real init still succeeds (it just re-writes the
      //       same two head slots).
      //   (b) The state assertion must expect STATE_RUNNABLE (1), not the
      //       old STATE_NEW (0). See design/kernel/r17-m0-724-d6-fork-enqueue.md
      //       §4 for the "state=RUNNABLE before enqueue" invariant rationale.
      //   (c) After validation, runq_dequeue(child) cleans the witness's
      //       child out of the runqueue so it doesn't linger past the real
      //       runq_init at :6317 (which would orphan the pointer anyway, but
      //       explicit dequeue is defensive and reads cleanly).
      sys_fork_witness:
          // ---------- Precondition: initialize runqueue (see (a) above) ----------
          call runq_init;

          // ---------- Setup: parent = task_new(NULL) ----------
          xor rdi, rdi;
          call task_new;
          cmp rax, 0;
          je  sys_fork_witness_fail;
          mov rbx, rax;                              // rbx = parent slab

          // Save parent_pid (u32 @ 0) for later comparison
          mov eax, [rbx + 0];
          mov r15d, eax;                             // r15 = parent_pid

          // ---------- Seed parent's fd_table with known values ----------
          mov rax, 0xDEADBEEFCAFEBABE;
          mov [rbx + 192], rax;                      // fd[3] @ 168 + 24
          mov rax, 0x1122334455667788;
          mov [rbx + 208], rax;                      // fd[5] @ 168 + 40
          mov rax, 0xF00DBEEF00000001;
          mov [rbx + 416], rax;                      // fd[31] @ 168 + 248

          // ---------- Act: sys_fork_body(parent) --- empty aspace ---
          mov rdi, rbx;
          call sys_fork_body;

          // ---------- Assertions on returned {rax, rdx} ----------
          // Assert: rax >= 2 (child pid must be a valid allocated slot)
          cmp rax, 2;
          jb  sys_fork_witness_fail;                 // child_pid < 2 → bug

          // Assert: rax != parent_pid
          cmp rax, r15;
          je  sys_fork_witness_fail;

          // Save child_pid for lookup
          mov r12d, eax;                             // r12 = child_pid (zero-ext)

          // Assert: rdx == 0 (reserved slot)
          cmp rdx, 0;
          jne sys_fork_witness_fail;

          // ---------- Look up child via _pid_table[child_pid] ----------
          lea rax, [rip + _pid_table];
          mov r10, [rax + r12*8];                    // r10 = child slab
          cmp r10, 0;
          je  sys_fork_witness_fail;                 // pid_table not published

          // ---------- Assertions on child task_struct ----------
          // Assert: child->pid == child_pid (matches what fork returned)
          mov eax, [r10 + 0];
          cmp eax, r12d;
          jne sys_fork_witness_fail;

          // Assert: child->parent_pid == parent_pid (task_new did this)
          mov eax, [r10 + 4];
          cmp eax, r15d;
          jne sys_fork_witness_fail;

          // Assert: child->state == STATE_RUNNABLE (1)
          // #724-D6: sys_fork_body now sets state=RUNNABLE before
          // runq_enqueue so the runqueue invariant "everything on
          // _runq_head_slot is RUNNABLE" holds at publish time.
          mov eax, [r10 + 8];
          cmp rax, 1;
          jne sys_fork_witness_fail;

          // Assert: child->user_pml4_pa != parent->user_pml4_pa (fresh aspace)
          mov rax, [rbx + 16];                       // parent_pml4
          mov rcx, [r10 + 16];                       // child_pml4
          cmp rcx, rax;
          je  sys_fork_witness_fail;
          cmp rcx, 0;
          je  sys_fork_witness_fail;                 // must be non-null

          // ---------- Assertions on fd_table copy ----------
          // child.fd[3] == parent.fd[3]
          mov rax, [r10 + 192];                      // fd[3] @ 168 + 24
          mov rcx, 0xDEADBEEFCAFEBABE;
          cmp rax, rcx;
          jne sys_fork_witness_fail;

          // child.fd[5] == parent.fd[5]
          mov rax, [r10 + 208];                      // fd[5] @ 168 + 40
          mov rcx, 0x1122334455667788;
          cmp rax, rcx;
          jne sys_fork_witness_fail;

          // child.fd[31] == parent.fd[31]
          mov rax, [r10 + 416];                      // fd[31] @ 168 + 248
          mov rcx, 0xF00DBEEF00000001;
          cmp rax, rcx;
          jne sys_fork_witness_fail;

          // child.fd[0] == 0 (unused slot, copied zero)
          mov rax, [r10 + 168];                      // fd[0] @ 168
          cmp rax, 0;
          jne sys_fork_witness_fail;

          // ---------- #724-D6: assertions on fresh-schedule materialization ----------
          // Assert: child.regs_save.rip @ +40 == &sched_switch_r15_continuation
          //         (uniform trampoline convention — see switch.pdx §6.2).
          mov rax, [r10 + 40];
          lea rcx, [rip + sched_switch_r15_continuation];
          cmp rax, rcx;
          jne sys_fork_witness_fail;

          // Assert: child.regs_save.rflags @ +48 == 0x2 (IF=0, reserved=1).
          //         See sys_fork.pdx FRESH_CHILD_RFLAGS and design §6.1.
          mov rax, [r10 + 48];
          cmp rax, 2;
          jne sys_fork_witness_fail;

          // Assert: child.regs_save.rsp @ +32 == child + 2216 (top-of-slab
          //         landing-stack anchor).
          mov rax, [r10 + 32];
          mov rcx, r10;
          add rcx, 2216;
          cmp rax, rcx;
          jne sys_fork_witness_fail;

          // Assert: [child + 2216] == &sys_fork_child_landing (landing RA
          //         consumed by continuation.ret).
          mov rax, [r10 + 2216];
          lea rcx, [rip + sys_fork_child_landing];
          cmp rax, rcx;
          jne sys_fork_witness_fail;

          // Assert (rewired for #773): child is on the runqueue.
          // Post-#773 the runqueue head lives at PERCPU_OFF_RUNQUEUE_HEAD
          // (+32) in this CPU's Percpu CB.  Single-element enqueue leaves
          // CB.head == child, so we deref [gs:32] via rdmsr IA32_GS_BASE.
          mov rcx, 0xC0000101;
          rdmsr;
          shl rdx, 32;
          or  rax, rdx;
          mov rcx, [rax + 32];                       // CB.runqueue_head
          cmp rcx, r10;
          jne sys_fork_witness_fail;

          // ---------- Cleanup: runq_dequeue(child) so it doesn't linger ----------
          // Even though the real runq_init at :6317 would orphan any dangling
          // pointer, explicit dequeue keeps the witness's contract crisp:
          // we started with runq_init (empty), we end with the runqueue
          // empty of witness-owned tasks.
          mov rdi, r10;
          call runq_dequeue;

          // ---------- All checks green ----------
          mov rdi, 3;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + sys_fork_witness_ok_msg];
          call klog_s1;
          jmp sys_fork_witness_exit;

      sys_fork_witness_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + sys_fork_witness_fail_msg];
          call klog_s1;

      sys_fork_witness_exit:

      // ============================================================
      // R16-M1-002 (#571): vnode_pool witness — 4 composed sub-tests.
      // bsf_q/bts_q/btr_q register-form bit-scan (see
      // design/kernel/r16-m1-002-vnode-pool.md and
      // src/kernel/core/fs/vnode_pool.pdx justifications for the
      // paideia-as encoder verification that made this possible without
      // any variable-shift / CL idiom).
      // ============================================================

      // --- Sub-test A: initial state -> first alloc returns 1 (slot 0 reserved) ---
      call vnode_alloc;
      cmp  rax, 1;
      jne  vnode_pool_witness_fail;

      // --- Sub-test B: two more allocs return 2 and 3 (distinct, monotone) ---
      call vnode_alloc;
      cmp  rax, 2;
      jne  vnode_pool_witness_fail;
      call vnode_alloc;
      cmp  rax, 3;
      jne  vnode_pool_witness_fail;

      // --- Sub-test C: free middle (slot 2); next alloc returns 2 (bitmap reuse) ---
      mov  rdi, 2;
      call vnode_free;
      call vnode_alloc;
      cmp  rax, 2;
      jne  vnode_pool_witness_fail;

      // --- Sub-test D: fill until OOM.
      //     State entering D: slots {0,1,2,3} allocated; 252 free slots remain.
      //     Loop-alloc must return 0xFFFF after exactly 252 successful allocs.
      //     Guard uses `ja` (strictly-above), not `jae`: r12 == 252 is the
      //     expected in-range terminal count (the 253rd call is the one
      //     that returns OOM) — `jae` would reject the correct count as
      //     "too many" one iteration early (debugger-caught off-by-one). ---
      xor  r12, r12;                              // counter (callee-save; safe — never returns)
      vnode_pool_fill_loop:
          call vnode_alloc;
          cmp  rax, 0xFFFF;
          je   vnode_pool_fill_done;
          add  r12, 1;
          cmp  r12, 252;
          ja   vnode_pool_witness_fail;           // too many allocs before OOM
          jmp  vnode_pool_fill_loop;
      vnode_pool_fill_done:
          cmp  r12, 252;
          jne  vnode_pool_witness_fail;           // wrong free-count on OOM

      // --- All four checks passed. Emit marker. ---
      mov rdi, 3;
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + vnode_pool_ok_msg];
      call klog_s1;
      jmp  vnode_pool_witness_done;

      vnode_pool_witness_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + vnode_pool_fail_msg];
          call klog_s1;

      vnode_pool_witness_done:

      // ============================================================
      // R17-M0 #680: vnode_pool reset after saturation witness.
      //
      // vnode_pool_witness Sub-test D deliberately fills all 256 slots
      // to prove OOM at 0xFFFF. Leaving that state in place makes every
      // downstream vnode_alloc caller trip OOM unless they pre-vnode_free
      // a specific slot — a discipline #664 debugger surfaced as the
      // "landmine" that any real userland O_CREAT will hit identically.
      //
      // Reset: free slots 1..255 (idx=0 is reserved sentinel; vnode_free
      // refuses it). vnode_free is idempotent (btr_q on already-cleared
      // bit is a no-op), so existing witnesses that pre-vnode_free a
      // specific hardcoded slot (100, 200, 201, …) still work — their
      // free becomes a no-op.
      //
      // Slot-memory zeroing side-effect: vnode_free zeroes the 64-byte
      // slot as part of the free operation. Witnesses that "reuse" a
      // fixed slot idx (e.g. path_witness at :1895 uses 1/2/3 without
      // vnode_alloc) still work because they write their own contents.
      //
      // See paideia-os #680 for the audit trail.
      // ============================================================
      mov  r12, 1;                         // start at slot 1
      vnode_pool_reset_loop:
          cmp  r12, 256;                   // VNODE_MAX
          jae  vnode_pool_reset_done;
          mov  rdi, r12;
          call vnode_free;                 // idempotent per vnode_pool.pdx:102
          add  r12, 1;
          jmp  vnode_pool_reset_loop;
      vnode_pool_reset_done:

      // ============================================================
      // R16-M1-003 (#572): vops dispatch witness — 3 composed sub-tests.
      //
      // Storage: _vops_witness_vnode (64 B) + _vops_witness_table (56 B),
      //          both `.bss` from src/kernel/core/fs/vops.pdx.
      // Stub:    _vops_witness_read_stub returns 0xDEADBEEFCAFEBABE.
      //
      // Sub-test A: install stub in table[+0]; install &table in vnode[+24];
      //             vops_read(vn, 0, 0, 0) must return 0xDEADBEEFCAFEBABE.
      // Sub-test B: table[+8] (write slot) is null;
      //             vops_write(vn, 0, 0, 0) must return VOPS_ERR_NOT_SUPPORTED.
      // Sub-test C: zero vnode's ops_ptr (+24);
      //             vops_read(vn, 0, 0, 0) must return VOPS_ERR_NOT_SUPPORTED.
      //
      // See design/kernel/r16-m1-003-vops.md §5 for the full contract.
      // ============================================================

      // --- Zero the witness vnode (8 x 8 = 64 bytes) ---
      lea  rdi, [rip + _vops_witness_vnode];
      xor  rax, rax;
      mov  [rdi + 0],  rax;
      mov  [rdi + 8],  rax;
      mov  [rdi + 16], rax;
      mov  [rdi + 24], rax;
      mov  [rdi + 32], rax;
      mov  [rdi + 40], rax;
      mov  [rdi + 48], rax;
      mov  [rdi + 56], rax;

      // --- Zero the witness vops table (7 x 8 = 56 bytes) ---
      lea  rdi, [rip + _vops_witness_table];
      xor  rax, rax;
      mov  [rdi + 0],  rax;
      mov  [rdi + 8],  rax;
      mov  [rdi + 16], rax;
      mov  [rdi + 24], rax;
      mov  [rdi + 32], rax;
      mov  [rdi + 40], rax;
      mov  [rdi + 48], rax;

      // --- Install stub in read slot (+0) of the table ---
      lea  rax, [rip + _vops_witness_read_stub];
      lea  rdi, [rip + _vops_witness_table];
      mov  [rdi + 0], rax;

      // --- Install &table into vnode's ops_ptr (+24) ---
      lea  rax, [rip + _vops_witness_table];
      lea  rdi, [rip + _vops_witness_vnode];
      mov  [rdi + 24], rax;

      // --- Sub-test A: vops_read → stub's magic constant ---
      lea  rdi, [rip + _vops_witness_vnode];
      xor  rsi, rsi;
      xor  rdx, rdx;
      xor  rcx, rcx;
      call vops_read;
      mov  rcx, 0xDEADBEEFCAFEBABE;
      cmp  rax, rcx;
      jne  vops_witness_fail;

      // --- Sub-test B: vops_write → E_NOT_SUPPORTED (write slot is null) ---
      lea  rdi, [rip + _vops_witness_vnode];
      xor  rsi, rsi;
      xor  rdx, rdx;
      xor  rcx, rcx;
      call vops_write;
      mov  rcx, 0xFFFFFFFFFFFFFFFF;
      cmp  rax, rcx;
      jne  vops_witness_fail;

      // --- Sub-test C: zero vnode.ops_ptr; vops_read → E_NOT_SUPPORTED ---
      lea  rdi, [rip + _vops_witness_vnode];
      xor  rax, rax;
      mov  [rdi + 24], rax;
      lea  rdi, [rip + _vops_witness_vnode];
      xor  rsi, rsi;
      xor  rdx, rdx;
      xor  rcx, rcx;
      call vops_read;
      mov  rcx, 0xFFFFFFFFFFFFFFFF;
      cmp  rax, rcx;
      jne  vops_witness_fail;

      // --- All three checks passed. Emit marker. ---
      mov rdi, 3;
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + vops_ok_msg];
      call klog_s1;
      jmp  vops_witness_done;

      vops_witness_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + vops_fail_msg];
          call klog_s1;

      vops_witness_done:

      // ============================================================
      // R16-M1-004 (#573): path_resolve witness — 6 sub-tests.
      //
      // Storage: 3 vnodes + witness vops table + lookup stub (all from
      //          src/kernel/core/fs/path.pdx).
      // Fixture: Allocate vnodes 1,2,3 (root, foo, bar). Populate fields.
      //          Install stub at vops_table[+32] (VOPS_LOOKUP_OFFSET).
      //
      // Sub-tests A-F: resolve "/", ".", "..", "/foo/bar", "/nope", "//foo//bar"
      // Marker: "R16 PATH RESOLVE OK" on all green.
      //
      // See design/kernel/r16-m1-004-path-resolver.md §5 for full contract.
      // ============================================================

      // --- Use fixed vnode indices 1, 2, 3 for witness tree ---
      // (vnode_pool witness fills the pool to OOM, so can't allocate new slots here)
      // The witness tree uses indices that are within the valid range but their
      // actual contents will be populated below. Since the pool is zero-initialized,
      // this is sufficient for testing path_resolve logic.
      mov r8, 1;                            // r8 = root vnode idx (1)
      mov r9, 2;                            // r9 = foo vnode idx (2)
      mov r10, 3;                           // r10 = bar vnode idx (3)

      skip_to_vops_setup:

      // --- Zero the witness vops table (7 x 8 = 56 bytes) ---
      lea  rdi, [rip + _path_witness_vops_table];
      xor  rax, rax;
      mov  [rdi + 0],  rax;
      mov  [rdi + 8],  rax;
      mov  [rdi + 16], rax;
      mov  [rdi + 24], rax;
      mov  [rdi + 32], rax;
      mov  [rdi + 40], rax;
      mov  [rdi + 48], rax;

      // --- Install stub in lookup slot (+32 = VOPS_LOOKUP_OFFSET) ---
      lea  rax, [rip + _path_witness_lookup_stub];
      lea  rdi, [rip + _path_witness_vops_table];
      mov  [rdi + 32], rax;

      // --- Populate root vnode (idx=1) ---
      // type (+0) = VNODE_TYPE_DIR = 2
      // parent_idx (+8) = 0xFFFF (root has no parent)
      // ops_ptr (+24) = &_path_witness_vops_table
      // backend_ptr (+32) = 1 (#665 Phase 4 / #754: path_resolve now
      //   routes lookup results through vnode_cache_or_alloc, which
      //   dedups on (parent, backend, ops). The witness stub returns
      //   backend_idx 2 for 'foo' and 3 for 'bar'; pre-wiring backend
      //   fields to 1/2/3 for root/foo/bar makes vnode_cache_or_alloc's
      //   scan match slots 1/2/3 on the first hit, so sub-tests D & F
      //   still assert `cmp rax, 3` cleanly. Without this wire, the
      //   scan would miss and vnode_alloc would return a fresh slot.)
      mov  rdi, r8;
      call vnode_slot;                      // rax = &vnode[root]
      mov  rdi, rax;                        // rdi = &vnode[root]
      mov  rax, 2;
      mov  [rdi + 0], rax;                  // type = VNODE_TYPE_DIR
      mov  rax, 0xFFFF;
      mov  [rdi + 8], rax;                  // parent_idx = 0xFFFF (write low 16 bits via u64)
      lea  rax, [rip + _path_witness_vops_table];
      mov  [rdi + 24], rax;                 // ops_ptr = table
      mov  rax, 1;
      mov  [rdi + 32], rax;                 // backend_ptr = 1 (root's backend inode)

      // --- Populate foo vnode (idx=2) ---
      // type (+0) = VNODE_TYPE_DIR = 2
      // parent_idx (+8) = 1 (root)
      // ops_ptr (+24) = &_path_witness_vops_table
      // backend_ptr (+32) = 2 (see root's comment above)
      mov  rdi, r9;
      call vnode_slot;                      // rax = &vnode[foo]
      mov  rdi, rax;                        // rdi = &vnode[foo]
      mov  rax, 2;
      mov  [rdi + 0], rax;                  // type = VNODE_TYPE_DIR
      mov  rax, 1;
      mov  [rdi + 8], rax;                  // parent_idx = 1 (root)
      lea  rax, [rip + _path_witness_vops_table];
      mov  [rdi + 24], rax;                 // ops_ptr = table
      mov  rax, 2;
      mov  [rdi + 32], rax;                 // backend_ptr = 2 (foo's backend inode)

      // --- Populate bar vnode (idx=3) ---
      // type (+0) = VNODE_TYPE_REG = 1
      // parent_idx (+8) = 2 (foo)
      // ops_ptr (+24) = &_path_witness_vops_table
      // backend_ptr (+32) = 3 (see root's comment above)
      mov  rdi, r10;
      call vnode_slot;                      // rax = &vnode[bar]
      mov  rdi, rax;                        // rdi = &vnode[bar]
      mov  rax, 1;
      mov  [rdi + 0], rax;                  // type = VNODE_TYPE_REG
      mov  rax, 2;
      mov  [rdi + 8], rax;                  // parent_idx = 2 (foo)
      lea  rax, [rip + _path_witness_vops_table];
      mov  [rdi + 24], rax;                 // ops_ptr = table
      mov  rax, 3;
      mov  [rdi + 32], rax;                 // backend_ptr = 3 (bar's backend inode)

      // --- Sub-test A: resolve "/" from root returns root ---
      lea  rdi, [rip + witness_path_slash];  // "/"
      mov  rsi, 1;                           // root_vnode_idx
      xor  rdx, rdx;                         // cwd = 0 (unused for absolute)
      call path_resolve;
      // DEBUG: Check return value
      mov  rcx, 1;
      cmp  rax, rcx;
      jne  path_witness_fail;

      // --- Sub-test B: resolve "." from cwd returns cwd ---
      lea  rdi, [rip + witness_path_dot];    // "."
      mov  rsi, 1;                           // root_vnode_idx (unused)
      mov  rdx, 2;                           // cwd = foo
      call path_resolve;
      cmp  rax, 2;
      jne  path_witness_fail;

      // --- Sub-test C.1: ".." from foo returns root ---
      lea  rdi, [rip + witness_path_dotdot]; // ".."
      mov  rsi, 1;                           // root_vnode_idx (unused)
      mov  rdx, 2;                           // cwd = foo (parent = root = 1)
      call path_resolve;
      cmp  rax, 1;
      jne  path_witness_fail;

      // --- Sub-test C.2: ".." from root stays at root ---
      lea  rdi, [rip + witness_path_dotdot]; // ".."
      mov  rsi, 1;                           // root_vnode_idx (unused)
      mov  rdx, 1;                           // cwd = root (parent_idx = 0xFFFF)
      call path_resolve;
      cmp  rax, 1;
      jne  path_witness_fail;

      // --- Sub-test D: resolve "/foo/bar" walks two components ---
      lea  rdi, [rip + witness_path_foo_bar]; // "/foo/bar"
      mov  rsi, 1;                            // root_vnode_idx
      xor  rdx, rdx;                          // cwd = 0 (unused for absolute)
      call path_resolve;
      cmp  rax, 3;
      jne  path_witness_fail;

      // --- Sub-test E: non-existent component returns 0 ---
      lea  rdi, [rip + witness_path_nope];    // "/nope"
      mov  rsi, 1;                            // root_vnode_idx
      xor  rdx, rdx;                          // cwd = 0 (unused for absolute)
      call path_resolve;
      cmp  rax, 0;
      jne  path_witness_fail;

      // --- Bonus F: "//foo//bar" collapse returns bar (idx=3) ---
      lea  rdi, [rip + witness_path_double_slash]; // "//foo//bar"
      mov  rsi, 1;                            // root_vnode_idx
      xor  rdx, rdx;                          // cwd = 0 (unused for absolute)
      call path_resolve;
      cmp  rax, 3;
      jne  path_witness_fail;

      // --- All checks passed. Emit marker. ---
      mov rdi, 3;
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + path_resolve_ok_msg];
      call klog_s1;
      jmp  path_witness_done;

      path_witness_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + path_resolve_fail_msg];
          call klog_s1;

      path_witness_done:

      // ============================================================
      // R16-M1-005 (#574): mount_table witness — 4 sub-tests, 1 marker.
      //
      // Storage: 8-entry mount table + 3 primitives (from
      //          src/kernel/core/fs/mount.pdx).
      //
      // Preamble: Free vnode slot 100 to make room for mount()'s vnode_alloc.
      //           (vnode_pool witness fills the pool to OOM as its final step)
      //
      // Sub-test A: _mount_table[0] initially zero
      // Sub-test B: mount("/", TMPFS) succeeds, returns slot idx 0
      // Sub-test C: mount_root_vnode() returns fresh root vnode idx
      // Sub-test D: mount_lookup(root_idx) returns root_idx (self-loop)
      // Marker: "R16 MOUNT TABLE OK" on all green.
      //
      // See design/kernel/r16-m1-005-mount-table.md §6 for full contract.
      // ============================================================

      // --- Preamble: Free slot 100 to make room for mount()'s vnode_alloc ---
      mov  rdi, 100;
      call vnode_free;

      // --- Sub-test A: _mount_table[0] initially zero ---
      lea  rax, [rip + _mount_table];
      mov  rax, [rax];
      cmp  rax, 0;
      jne  mount_witness_fail;

      // --- Sub-test B: mount("/", TMPFS) returns slot 0 ---
      lea  rdi, [rip + witness_path_slash];   // "/" (reused from #573)
      mov  rsi, 1;                            // MOUNT_BACKEND_TMPFS
      call mount;
      cmp  rax, 0;                            // MOUNT_ROOT_SLOT
      jne  mount_witness_fail;

      // --- Sub-test C: mount_root_vnode() returns fresh root vnode idx ---
      call mount_root_vnode;
      mov  r12, rax;                          // save for sub-test D
      cmp  rax, 0;
      je   mount_witness_fail;                // must be a real vnode idx
      cmp  rax, 0xFFFF;
      je   mount_witness_fail;                // not the OOM sentinel

      // Verify it equals _mount_table[0].root_idx directly
      lea  rax, [rip + _mount_table];
      mov  rax, [rax];
      shr  rax, 16;
      and  rax, 0xFFFF;
      cmp  rax, r12;
      jne  mount_witness_fail;

      // --- Sub-test D: mount_lookup(root_idx) returns root_idx (self-loop) ---
      mov  rdi, r12;
      call mount_lookup;
      cmp  rax, r12;
      jne  mount_witness_fail;

      // --- Sub-test E: After mount(), root vnode has ops_ptr (@+24) = &_tmpfs_vops
      //                  and backend_ptr (@+32) low16 = 1 (TMPFS_INODE_IDX_ROOT) ---
      // Call mount_root_vnode() → rax = root_vnode_idx
      call mount_root_vnode;

      // Load slot pointer via vnode_slot
      mov  rdi, rax;
      call vnode_slot;                         // rax = &slot

      // Check ops_ptr @ +24 == &_tmpfs_vops
      mov  rcx, [rax + 24];
      lea  rdx, [rip + _tmpfs_vops];
      cmp  rcx, rdx;
      jne  mount_witness_e_fail;

      // Check backend_ptr @ +32 low16 == 1
      mov  rcx, [rax + 32];
      and  rcx, 0xFFFF;
      cmp  rcx, 1;
      jne  mount_witness_e_fail;

      // Sub-test E pass — fall through to success
      jmp  mount_witness_e_done;

      mount_witness_e_fail:
      mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + mount_witness_e_fail_msg];
      call klog_s1;
      // Fall through — don't halt

      mount_witness_e_done:

      // --- All checks passed. Emit marker. ---
      mov rdi, 3;
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + mount_table_ok_msg];
      call klog_s1;
      jmp  mount_witness_done;

      mount_witness_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + mount_table_fail_msg];
          call klog_s1;

      mount_witness_done:

      // ============================================================
      // R17-M0-665 Phase 1: vnode_cache_or_alloc witness — 4 sub-tests, 1 marker.
      //
      // Preamble: Free slots 1, 2, 3 (used by path_witness) to reset pool
      //           to a known baseline for dedup testing.
      //
      // Sub-test A: vca(parent=10, backend=20, ops=0xDEAD) → returns idx N ∈ [1,256).
      //             Verify _vnode_pool[N].parent_idx@+8 == 10,
      //                    _vnode_pool[N].backend_ptr@+32 low16 == 20,
      //                    _vnode_pool[N].ops_ptr@+24 == 0xDEAD.
      // Sub-test B: Repeat A with same args → returns SAME N (dedup hit).
      // Sub-test C: vca(parent=10, backend=21, ops=0xDEAD) → returns fresh M, M != N.
      // Sub-test D: vca(parent=10, backend=20, ops=0xBEEF) → returns fresh P, P != N && P != M.
      // Marker: "R17 VCACHE OK" on all pass.
      //
      // Scan uses u64-load+AND 0xFFFF (#1251 safe). Populate uses u64 stores
      // (Pattern P1: fresh zeroed slot from vnode_alloc).
      // ============================================================

      // --- Preamble: Free slots 1, 2, 3 (path_witness residue) ---
      mov  rdi, 1;
      call vnode_free;
      mov  rdi, 2;
      call vnode_free;
      mov  rdi, 3;
      call vnode_free;

      // --- Sub-test A: vca(10, 20, 0xDEAD) ---
      mov  rdi, 10;           // parent_idx
      mov  rsi, 20;           // backend_idx
      mov  rdx, 0xDEAD;       // ops_ptr
      call vnode_cache_or_alloc;
      cmp  rax, 0xFFFF;
      je   vcache_witness_fail;
      mov  r12, rax;          // save idx N for sub-tests B, C, D

      // Verify parent_idx@+8 == 10
      mov  rdi, rax;
      call vnode_slot;        // rax = &slot
      mov  rcx, [rax + 8];
      and  rcx, 0xFFFF;
      cmp  rcx, 10;
      jne  vcache_witness_fail;

      // Verify backend_ptr@+32 low16 == 20
      mov  rcx, [rax + 32];
      and  rcx, 0xFFFF;
      cmp  rcx, 20;
      jne  vcache_witness_fail;

      // Verify ops_ptr@+24 == 0xDEAD
      mov  rcx, [rax + 24];
      cmp  rcx, 0xDEAD;
      jne  vcache_witness_fail;

      // --- Sub-test B: Same call → dedup hit, returns same N ---
      mov  rdi, 10;
      mov  rsi, 20;
      mov  rdx, 0xDEAD;
      call vnode_cache_or_alloc;
      cmp  rax, r12;
      jne  vcache_witness_fail;

      // --- Sub-test C: vca(10, 21, 0xDEAD) → fresh M, M != N ---
      mov  rdi, 10;
      mov  rsi, 21;           // different backend_idx
      mov  rdx, 0xDEAD;
      call vnode_cache_or_alloc;
      cmp  rax, 0xFFFF;
      je   vcache_witness_fail;
      cmp  rax, r12;          // M != N
      je   vcache_witness_fail;
      mov  r13, rax;          // save idx M

      // --- Sub-test D: vca(10, 20, 0xBEEF) → fresh P, P != N && P != M ---
      mov  rdi, 10;
      mov  rsi, 20;
      mov  rdx, 0xBEEF;       // different ops_ptr
      call vnode_cache_or_alloc;
      cmp  rax, 0xFFFF;
      je   vcache_witness_fail;
      cmp  rax, r12;          // P != N
      je   vcache_witness_fail;
      cmp  rax, r13;          // P != M
      je   vcache_witness_fail;

      // --- All four checks passed. Emit marker. ---
      mov rdi, 3;
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + vcache_witness_ok_msg];
      call klog_s1;
      jmp  vcache_witness_done;

      vcache_witness_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + vcache_witness_fail_msg];
          call klog_s1;

      vcache_witness_done:

      // ============================================================
      // R17-M0-665 Phase 2: backend_registry witness — 5 sub-tests, 1 marker.
      //
      // Sub-test A: backend_ops_table(1) → returns non-zero (should be &_tmpfs_vops).
      // Sub-test B: backend_ops_table(0) → returns 0.
      // Sub-test C: backend_ops_table(99) → returns 0.
      // Sub-test D: backend_root_inode(1) → returns 1 (TMPFS_INODE_IDX_ROOT).
      // Sub-test E: backend_root_inode(0) → returns 0.
      // Marker: "R17 BACKEND REG OK" on all pass.
      // ============================================================

      // --- Sub-test A: backend_ops_table(1) → non-zero (should be &_tmpfs_vops) ---
      mov rdi, 1;
      call backend_ops_table;
      cmp rax, 0;
      je backend_reg_witness_fail;
      mov r12, rax;                                // r12 = returned ops_table

      // Verify by comparing to _tmpfs_vops symbol address
      lea rcx, [rip + _tmpfs_vops];
      cmp rax, rcx;
      jne backend_reg_witness_fail;

      // --- Sub-test B: backend_ops_table(0) → 0 ---
      mov rdi, 0;
      call backend_ops_table;
      cmp rax, 0;
      jne backend_reg_witness_fail;

      // --- Sub-test C: backend_ops_table(99) → 0 ---
      mov rdi, 99;
      call backend_ops_table;
      cmp rax, 0;
      jne backend_reg_witness_fail;

      // --- Sub-test D: backend_root_inode(1) → 1 ---
      mov rdi, 1;
      call backend_root_inode;
      cmp rax, 1;
      jne backend_reg_witness_fail;

      // --- Sub-test E: backend_root_inode(0) → 0 ---
      mov rdi, 0;
      call backend_root_inode;
      cmp rax, 0;
      jne backend_reg_witness_fail;

      // --- All checks passed. Emit marker. ---
      mov rdi, 3;
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + backend_reg_ok_msg];
      call klog_s1;
      jmp backend_reg_witness_done;

      backend_reg_witness_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + backend_reg_fail_msg];
          call klog_s1;

      backend_reg_witness_done:

      // ============================================================
      // R16-M1-006 (#575): vfs_open witness — 4 sub-tests, 1 marker.
      //
      // Preamble: mount is already done by #574 witness with fresh root
      //           vnode at index N.
      //
      // Sub-test A: rax = vfs_open("/", 0). Expect rax != 0 (root vnode found).
      // Sub-test B: vnode_slot(rax).refcount now 1 (was 0 after mount — mount()
      //             never writes the refcount field; vfs_open is the first ++).
      // Sub-test C: rax = vfs_open("/nonexistent", 0). Expect rax == 0.
      // Sub-test D: rax = vfs_open("/nonexistent", 0x40). For R16.M1, expect
      //            rax == 0 (real create in R16.M2). O_CREAT path is REACHED.
      // Marker: "R16 VFS OPEN OK" on A, B, C pass.
      //
      // See design/kernel/r16-m1-006-vfs-open.md §4 for full contract.
      // ============================================================

      // --- Sub-test A: vfs_open("/", 0) must return non-zero ---
      lea  rdi, [rip + witness_path_slash];    // "/"
      xor  rsi, rsi;                           // flags = 0
      call vfs_open;
      cmp  rax, 0;
      je   vfs_open_witness_fail;
      mov  r12, rax;                           // save root vnode idx for sub-test B

      // --- Sub-test B: vnode_slot(rax).refcount now 1 (was 0 after mount, inc by vfs_open) ---
      mov  rdi, rax;
      call vnode_slot;                         // rax = &vnode
      xor  rcx, rcx;
      mov_w rcx, [rax + 4];                    // load refcount (u16 at +4)
      cmp  rcx, 1;                             // expect refcount == 1
      jne  vfs_open_witness_fail;

      // --- Sub-test C: vfs_open("/nonexistent", 0) must return 0 ---
      lea  rdi, [rip + witness_path_nope];     // "/nope"
      xor  rsi, rsi;                           // flags = 0
      call vfs_open;
      cmp  rax, 0;
      jne  vfs_open_witness_fail;              // expect 0 for non-existent path

      // --- Sub-test D: vfs_open("/nonexistent", 0x40) exercises O_CREAT path ---
      lea  rdi, [rip + witness_path_nope];     // "/nope"
      mov  rsi, 0x40;                          // flags = O_CREAT
      call vfs_open;
      // For R16.M1, O_CREAT returns 0 (stub). Real create in R16.M2.
      // Sub-test D just checks that the flag-check branch is REACHED;
      // any return value acceptable per design §4.7.

      // --- All checks passed. Emit marker. ---
      mov rdi, 3;
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + vfs_open_ok_msg];
      call klog_s1;
      jmp  vfs_open_witness_done;

      vfs_open_witness_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + vfs_open_fail_msg];
          call klog_s1;

      vfs_open_witness_done:

      // ============================================================
      // R16-M1-007 (#576): vfs_close witness — 2 sub-tests, 1 marker.
      //
      // Preamble: root vnode is at index N with refcount = 1 (left there by
      //           #575 sub-test A, which did vfs_open("/", 0) then never closed).
      //
      // Sub-test A: refcount transitions + conditional vops_close.
      //   1. vfs_open("/", 0) → refcount now 2.
      //   2. Load refcount; assert == 2.
      //   3. vfs_close(N) → returns 0, refcount now 1. vops_close NOT called.
      //   4. Load refcount; assert == 1.
      //   5. vfs_close(N) → returns 0, refcount now 0. vops_close IS called;
      //      null ops_ptr returns ERR sentinel (ignored).
      //   6. Load refcount; assert == 0.
      //
      // Sub-test B: invalid idx rejection.
      //   1. vfs_close(0) → assert rax == 0xFFFFFFFFFFFFFFFF.
      //   2. vfs_close(0xFFFF) → assert rax == 0xFFFFFFFFFFFFFFFF.
      //
      // Marker: "R16 VFS CLOSE OK" on A + B pass.
      //
      // See design/kernel/r16-m1-007-vfs-close.md for full contract.
      // ============================================================

      // --- Sub-test A, step 1: vfs_open("/", 0) (refcount will be 2) ---
      lea  rdi, [rip + witness_path_slash];     // "/"
      xor  rsi, rsi;                            // flags = 0
      call vfs_open;
      cmp  rax, 0;
      je   vfs_close_witness_fail;
      mov  r12, rax;                            // r12 = root vnode idx

      // --- Sub-test A, step 2: Load refcount, assert == 2 ---
      mov  rdi, r12;
      call vnode_slot;                          // rax = &vnode
      xor  rcx, rcx;
      mov_w rcx, [rax + 4];                     // rcx = refcount (u16)
      cmp  rcx, 2;                              // expect refcount == 2 (1 from mount + 1 from vfs_open)
      jne  vfs_close_witness_fail;

      // --- Sub-test A, step 3: vfs_close(r12) → refcount now 1 ---
      mov  rdi, r12;
      call vfs_close;
      cmp  rax, 0;                              // expect success (return 0)
      jne  vfs_close_witness_fail;

      // --- Sub-test A, step 4: Load refcount, assert == 1 ---
      mov  rdi, r12;
      call vnode_slot;                          // rax = &vnode
      xor  rcx, rcx;
      mov_w rcx, [rax + 4];                     // rcx = refcount
      cmp  rcx, 1;                              // expect refcount == 1 (vops_close NOT called)
      jne  vfs_close_witness_fail;

      // --- Sub-test A, step 5: vfs_close(r12) → refcount now 0, vops_close IS called ---
      mov  rdi, r12;
      call vfs_close;
      cmp  rax, 0;                              // expect success (return 0)
      jne  vfs_close_witness_fail;

      // --- Sub-test A, step 6: Load refcount, assert == 0 ---
      mov  rdi, r12;
      call vnode_slot;                          // rax = &vnode
      xor  rcx, rcx;
      mov_w rcx, [rax + 4];                     // rcx = refcount
      cmp  rcx, 0;                              // expect refcount == 0 (vops_close was called)
      jne  vfs_close_witness_fail;

      // --- Sub-test B, step 1: vfs_close(0) returns error sentinel ---
      xor  rdi, rdi;                            // rdi = 0
      call vfs_close;
      cmp  rax, 0xFFFFFFFFFFFFFFFF;             // expect error sentinel
      jne  vfs_close_witness_fail;

      // --- Sub-test B, step 2: vfs_close(0xFFFF) returns error sentinel ---
      mov  rdi, 0xFFFF;
      call vfs_close;
      cmp  rax, 0xFFFFFFFFFFFFFFFF;             // expect error sentinel (0xFFFF >= 256)
      jne  vfs_close_witness_fail;

      // --- All checks passed. Emit marker. ---
      mov rdi, 3;
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + vfs_close_ok_msg];
      call klog_s1;
      jmp  vfs_close_witness_done;

      vfs_close_witness_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + vfs_close_fail_msg];
          call klog_s1;

      vfs_close_witness_done:

      // ============================================================
      // R16-M1-008 (#577): vfs_read/vfs_write witness — 3 sub-tests, 1 marker.
      //
      // Preamble: the vnode pool is fully allocated at this point in boot
      //           (the #571 vnode_pool witness fills all 256 slots to OOM;
      //           the #574 mount witness frees slot 100 and mount_root_vnode()
      //           immediately reclaims it, leaving the pool at OOM again).
      //           Free slot 200 so this witness's vnode_alloc has a bit to
      //           find. Slot 200 was only ever touched by the #571 fill-loop
      //           (which just sets its bitmap bit — vnode_alloc never writes
      //           slot storage), so its 64 bytes are still zero from the
      //           .bss uninit; freeing it recycles the bitmap bit without
      //           disturbing any live vnode (root vnode lives at slot 100).
      //
      // Sub-test A: install the RW witness stub as ops_ptr(read+write);
      //             vfs_read(idx,0,0,0) forwards the stub's rax == 42.
      // Sub-test B: vfs_write(idx,0,0,0) forwards the same stub's rax == 42.
      // Sub-test C: zero ops_ptr; vfs_read(idx,0,0,0) returns the
      //             VOPS_ERR_NOT_SUPPORTED sentinel (0xFFFFFFFFFFFFFFFF).
      //
      // Marker: "R16 VFS READ WRITE OK" on A + B + C pass.
      //
      // See design/kernel/r16-m1-008-vfs-read-write.md §Witness for the
      // full contract.
      // ============================================================

      // --- Preamble: free slot 200 to make room for this witness's vnode_alloc ---
      mov  rdi, 200;
      call vnode_free;

      // --- Fixture: allocate witness vnode, resolve pointer ---
      call vnode_alloc;
      cmp  rax, 0;
      je   vfs_rw_witness_fail;                 // must not be the reserved sentinel
      cmp  rax, 0xFFFF;
      je   vfs_rw_witness_fail;                 // must not be the OOM sentinel
      mov  r12, rax;                             // r12 = witness vnode idx

      mov  rdi, r12;
      call vnode_slot;                           // rax = &vnode[idx]
      mov  r13, rax;                             // r13 = witness vnode ptr

      // --- Zero the 64-byte slot (belt-and-braces per design §Witness step 4) ---
      xor  rax, rax;
      mov  [r13 + 0],  rax;
      mov  [r13 + 8],  rax;
      mov  [r13 + 16], rax;
      mov  [r13 + 24], rax;
      mov  [r13 + 32], rax;
      mov  [r13 + 40], rax;
      mov  [r13 + 48], rax;
      mov  [r13 + 56], rax;

      // --- Install witness ops table pointer at vnode + 24 (ops_ptr) ---
      lea  rax, [rip + _vops_witness_table];
      mov  [r13 + 24], rax;

      // --- Install the RW stub at table+0 (read slot) and table+8 (write slot) ---
      lea  rax, [rip + _vops_witness_rw_stub];
      lea  rcx, [rip + _vops_witness_table];
      mov  [rcx + 0], rax;
      mov  [rcx + 8], rax;

      // --- Sub-test A: vfs_read(idx, 0, 0, 0) forwards stub's rax == 42 ---
      mov  rdi, r12;
      xor  rsi, rsi;
      xor  rdx, rdx;
      xor  rcx, rcx;
      call vfs_read;
      cmp  rax, 42;
      jne  vfs_rw_witness_fail;

      // --- Sub-test B: vfs_write(idx, 0, 0, 0) forwards stub's rax == 42 ---
      mov  rdi, r12;
      xor  rsi, rsi;
      xor  rdx, rdx;
      xor  rcx, rcx;
      call vfs_write;
      cmp  rax, 42;
      jne  vfs_rw_witness_fail;

      // --- Sub-test C: zero ops_ptr; vfs_read returns error sentinel ---
      xor  rax, rax;
      mov  [r13 + 24], rax;

      mov  rdi, r12;
      xor  rsi, rsi;
      xor  rdx, rdx;
      xor  rcx, rcx;
      call vfs_read;
      cmp  rax, 0xFFFFFFFFFFFFFFFF;
      jne  vfs_rw_witness_fail;

      // --- All checks passed. Emit marker. ---
      mov rdi, 3;
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + vfs_rw_ok_msg];
      call klog_s1;
      jmp  vfs_rw_witness_done;

      vfs_rw_witness_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + vfs_rw_fail_msg];
          call klog_s1;

      vfs_rw_witness_done:

      // R16-M1-001 (#578): Emit VFS OK marker (R16.M1 integration checkpoint)
      mov rdi, 3;
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + vfs_ok_msg];
      call klog_s1;

      // ============================================================
      // R16-M2-001 (#579): tmpfs inode pool witness — 3 sub-tests, 1 marker
      // ============================================================
      tmpfs_inode_pool_witness:
          // ---------- Sub-test A: bitmap slot-0 sentinel is set ----------
          mov rax, [rip + _tmpfs_inode_bitmap];
          and rax, 1;
          cmp rax, 1;
          jne tmpfs_inode_pool_witness_fail;

          // ---------- Sub-test B: slot 0's type is FREE (0) ----------
          lea rax, [rip + _tmpfs_inode_pool];
          mov rcx, [rax + 0];               // load full qword at slot 0 offset 0
          and rcx, 0xFF;                    // extract type byte (offset 0)
          cmp rcx, 0;                       // VNODE_TYPE_FREE
          jne tmpfs_inode_pool_witness_fail;

          // ---------- Sub-test C: slot 63 is addressable via shl 8 indexing ----------
          mov rdi, 63;
          call tmpfs_inode_slot;            // rax = &_tmpfs_inode_pool[63]
          mov rcx, [rax + 0];               // load full qword at slot 63 offset 0
          and rcx, 0xFF;                    // extract type byte (offset 0)
          cmp rcx, 0;                       // VNODE_TYPE_FREE
          jne tmpfs_inode_pool_witness_fail;

          // ---------- All checks passed. Emit marker. ----------
          mov rdi, 3;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + tmpfs_inode_pool_ok_msg];
          call klog_s1;
          jmp tmpfs_inode_pool_witness_done;

      tmpfs_inode_pool_witness_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + tmpfs_inode_pool_fail_msg];
          call klog_s1;

      tmpfs_inode_pool_witness_done:

      // ============================================================
      // R16-M2-002 (#580): tmpfs_init witness — 4 sub-tests, 1 marker
      // ============================================================
      tmpfs_init_witness:
          // ---------- Sub-test A: tmpfs_init returns a non-zero root idx ----------
          call tmpfs_init;
          mov r12, rax;                       // save root_idx for sub-tests B-D
          cmp rax, 0;
          je tmpfs_init_witness_fail;
          cmp rax, 0xFFFF;                    // alloc OOM sentinel
          je tmpfs_init_witness_fail;

          // ---------- Sub-test B: root inode type==DIR, first_child!=0 ----------
          mov rdi, r12;                       // root_idx
          call tmpfs_inode_slot;              // rax = &root_inode
          mov r13, rax;

          // type byte at +0 must be VNODE_TYPE_DIR = 2
          mov rcx, [r13 + 0];                 // load u64 at +0
          and rcx, 0xFF;                      // extract type byte
          cmp rcx, 2;
          jne tmpfs_init_witness_fail;

          // first_child at +180 (u16) must be non-zero (a real /tmp idx)
          mov rcx, [r13 + 176];               // load u64 at +176 covering
                                              // parent_idx / next_sib / first_child / pad
          shr rcx, 32;                        // first_child at bits [32, 48)
          and rcx, 0xFFFF;
          cmp rcx, 0;
          je tmpfs_init_witness_fail;
          cmp rcx, 0xFFFF;
          je tmpfs_init_witness_fail;         // must not be the empty sentinel
          mov r14, rcx;                       // r14 = tmp_idx for sub-tests C-D

          // ---------- Sub-test C: /tmp inode type==DIR, parent_idx==root_idx ----------
          mov rdi, r14;                       // tmp_idx
          call tmpfs_inode_slot;              // rax = &tmp_inode
          mov r13, rax;

          // type byte at +0 must be VNODE_TYPE_DIR = 2
          mov rcx, [r13 + 0];
          and rcx, 0xFF;
          cmp rcx, 2;
          jne tmpfs_init_witness_fail;

          // parent_idx at +176 (u16) must equal root_idx (r12)
          mov rcx, [r13 + 176];
          and rcx, 0xFFFF;                    // extract parent_idx (bits [0, 16))
          cmp rcx, r12;
          jne tmpfs_init_witness_fail;

          // ---------- Sub-test D: /tmp name field == "tmp\0" ----------
          // name[0..8] as u64: byte layout expected is
          //   { 0x74('t'), 0x6D('m'), 0x70('p'), 0x00, 0x00, 0x00, 0x00, 0x00 }
          //   = little-endian u64 0x0000000000706D74
          mov rcx, [r13 + 144];               // load u64 at name[0..8]
          mov rdx, 0x706D74;                  // expected 'tmp\0' + zero pad
          cmp rcx, rdx;
          jne tmpfs_init_witness_fail;

          // ---------- All checks passed. Emit marker. ----------
          mov rdi, 3;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + tmpfs_init_ok_msg];
          call klog_s1;
          jmp tmpfs_init_witness_done;

      tmpfs_init_witness_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + tmpfs_init_fail_msg];
          call klog_s1;

      tmpfs_init_witness_done:

      // ============================================================
      // R16-M2-003 (#581): tmpfs_lookup witness — 3 sub-tests, 1 marker
      // ============================================================
      tmpfs_lookup_witness:
          // ---------- Sub-test A: hit — tmpfs_lookup(root, "tmp") returns /tmp idx ----------
          mov  r12, 1                          // root_idx = TMPFS_INODE_IDX_ROOT
          lea  rsi, [rip + witness_name_tmp]   // name = "tmp\0"
          mov  rdi, r12
          call tmpfs_lookup
          cmp  rax, 0
          je   tmpfs_lookup_witness_fail       // miss where hit was expected
          cmp  rax, 0xFFFF
          je   tmpfs_lookup_witness_fail       // sentinel — shouldn't happen
          mov  r13, rax                        // r13 = tmp_idx (for cross-check)

          // Cross-check: returned idx must be a DIR inode whose name = "tmp\0"
          mov  rdi, r13
          call tmpfs_inode_slot                // rax = &tmp_inode
          mov  rcx, [rax + 144]                // load name[0..8] as u64
          mov  rdx, 0x706D74                   // expected 'tmp\0' + zero pad
          cmp  rcx, rdx
          jne  tmpfs_lookup_witness_fail

          // ---------- Sub-test B: miss — tmpfs_lookup(root, "missing") returns 0 ----------
          lea  rsi, [rip + witness_name_missing]  // name = "missing\0"
          mov  rdi, 1                             // root_idx
          call tmpfs_lookup
          cmp  rax, 0
          jne  tmpfs_lookup_witness_fail          // miss expected → non-zero is wrong

          // ---------- Sub-test C: not-a-dir — set slot 63 type=REG, lookup returns 0 ----------
          // Set up slot 63 as a non-DIR (REG) scratch inode
          mov  rdi, 63
          call tmpfs_inode_slot                // rax = &_tmpfs_inode_pool[63]
          mov  r13, rax
          mov  rcx, 1                          // VNODE_TYPE_REG (non-DIR)
          mov_b [r13 + 0], rcx

          // Lookup on the non-DIR inode
          lea  rsi, [rip + witness_name_any]   // any name — should not matter
          mov  rdi, 63                         // non-DIR inode idx
          call tmpfs_lookup
          cmp  rax, 0
          jne  tmpfs_lookup_witness_fail       // type-gate should have short-circuited

          // Restore slot 63 to FREE (leave no state behind)
          mov  rdi, 63
          call tmpfs_inode_slot                // rax = &pool[63]
          mov  r13, rax
          xor  rcx, rcx
          mov_b [r13 + 0], rcx                 // type = VNODE_TYPE_FREE

          // All checks passed. Emit marker.
          mov rdi, 3;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + tmpfs_lookup_ok_msg];
          call klog_s1;
          jmp  tmpfs_lookup_witness_done

      tmpfs_lookup_witness_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + tmpfs_lookup_fail_msg];
          call klog_s1;

      tmpfs_lookup_witness_done:

      // ============================================================
      // R16-M2-004 (#582): tmpfs_create witness — 4 sub-tests, 1 marker
      // ============================================================
      tmpfs_create_witness:

          // ---------- Sub-test A: create returns non-zero new_idx ----------
          // Recover tmp_idx via tmpfs_lookup on root (proven working at this
          // boot point by the tmpfs_lookup witness immediately above).
          mov  rdi, 1                             // root_idx = TMPFS_INODE_IDX_ROOT
          lea  rsi, [rip + witness_name_tmp]      // name = "tmp\0"
          call tmpfs_lookup
          cmp  rax, 0
          je   tmpfs_create_witness_fail          // can't proceed — /tmp missing
          mov  r12, rax                           // r12 = tmp_idx (for later cross-checks)

          // tmpfs_create(tmp_idx, "x", 1, REG=1)
          mov  rdi, r12                           // dir_idx = tmp_idx
          lea  rsi, [rip + witness_name_any]      // name_ptr = "x\0"
          mov  rdx, 1                             // name_len = 1 (just 'x')
          mov  rcx, 1                             // type = VNODE_TYPE_REG
          call tmpfs_create
          cmp  rax, 0
          je   tmpfs_create_witness_fail          // expected non-zero new_idx
          cmp  rax, 0xFFFF
          je   tmpfs_create_witness_fail          // alloc-OOM sentinel — shouldn't happen
          mov  r13, rax                           // r13 = new_idx (for cross-checks)

          // ---------- Sub-test B: lookup returns the created idx ----------
          // The whole point of tmpfs_create's acceptance criterion:
          // "create /tmp/x; subsequent lookup returns it."
          mov  rdi, r12                           // tmp_idx
          lea  rsi, [rip + witness_name_any]      // "x\0"
          call tmpfs_lookup
          cmp  rax, r13                           // expect returned idx == new_idx
          jne  tmpfs_create_witness_fail

          // ---------- Sub-test C: /tmp.first_child == new_idx ----------
          // Load /tmp's u64 @+176; extract first_child from bits [32, 48)
          mov  rdi, r12                           // tmp_idx
          call tmpfs_inode_slot                   // rax = &tmp_inode
          mov  rcx, [rax + 176]
          shr  rcx, 32
          and  rcx, 0xFFFF                        // rcx = tmp.first_child
          cmp  rcx, r13                           // expect == new_idx
          jne  tmpfs_create_witness_fail

          // ---------- Sub-test D: new inode fields are correctly populated ----------
          // Get new_ptr
          mov  rdi, r13                           // new_idx
          call tmpfs_inode_slot                   // rax = &new_inode
          mov  r14, rax                           // r14 = new_ptr

          // Check type == VNODE_TYPE_REG (1)
          xor  rcx, rcx
          mov_b rcx, [r14 + 0]
          cmp  rcx, 1
          jne  tmpfs_create_witness_fail

          // Check parent_idx == tmp_idx: extract from bits [0, 16) of u64 @+176
          mov  rcx, [r14 + 176]
          and  rcx, 0xFFFF
          cmp  rcx, r12                           // expect == tmp_idx
          jne  tmpfs_create_witness_fail

          // Check name field: u64 @+144 == 0x78 ('x' + 7 zero pad bytes)
          mov  rcx, [r14 + 144]
          mov  rdx, 0x78                          // expected: 'x' at byte 0, zeros elsewhere
          cmp  rcx, rdx
          jne  tmpfs_create_witness_fail

          // All checks passed. Emit marker.
          mov rdi, 3;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + tmpfs_create_ok_msg];
          call klog_s1;
          jmp  tmpfs_create_witness_done

      tmpfs_create_witness_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + tmpfs_create_fail_msg];
          call klog_s1;

      tmpfs_create_witness_done:

      // ============================================================
      // R16-M2-005 (#583): tmpfs_write witness — 4 sub-tests, 1 marker
      // ============================================================
      tmpfs_write_witness:
          // ---------- Preamble: recover tmp_idx, x_idx ----------
          mov  rdi, 1                             // root_idx = TMPFS_INODE_IDX_ROOT
          lea  rsi, [rip + witness_name_tmp]      // "tmp\0"
          call tmpfs_lookup
          cmp  rax, 0
          je   tmpfs_write_witness_fail
          mov  r12, rax                           // r12 = tmp_idx

          mov  rdi, r12                           // tmp_idx
          lea  rsi, [rip + witness_name_any]      // "x\0"
          call tmpfs_lookup
          cmp  rax, 0
          je   tmpfs_write_witness_fail
          mov  r13, rax                           // r13 = x_idx (target of the write)

          // ---------- Sub-test A: tmpfs_write returns 100 ----------
          mov  rdi, r13                           // x_idx
          lea  rsi, [rip + tmpfs_write_src_buf]   // buf_ptr = &src[0]
          mov  rdx, 100                           // len = 100
          xor  rcx, rcx                           // offset = 0
          call tmpfs_write
          cmp  rax, 100
          jne  tmpfs_write_witness_fail

          // ---------- Sub-test B: inode.size == 100 ----------
          mov  rdi, r13                           // x_idx
          call tmpfs_inode_slot                   // rax = &x_inode
          mov  r14, rax                           // r14 = x_inode_ptr
          mov  rcx, [r14 + 8]                     // rcx = inode.size
          cmp  rcx, 100
          jne  tmpfs_write_witness_fail

          // ---------- Sub-test C: inode.page_ptrs[0] != 0 ----------
          mov  rcx, [r14 + 16]                    // rcx = page_ptrs[0]
          cmp  rcx, 0
          je   tmpfs_write_witness_fail
          mov  r15, rcx                           // r15 = page_va (for sub-test D)

          // ---------- Sub-test D: content match (u64 @page_va == 0x4141414141414141) ----------
          mov  rcx, [r15]                         // rcx = u64 at page start
          mov  rdx, 0x4141414141414141            // expected: 8 x 'A'
          cmp  rcx, rdx
          jne  tmpfs_write_witness_fail

          mov rdi, 3;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + tmpfs_write_ok_msg];
          call klog_s1;
          jmp  tmpfs_write_witness_done

      tmpfs_write_witness_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + tmpfs_write_fail_msg];
          call klog_s1;

      tmpfs_write_witness_done:

      // ============================================================
      // R16-M2-006 (#584): tmpfs_read witness — 4 sub-tests, 1 marker
      // ============================================================
      tmpfs_read_witness:
          // ---------- Preamble: recover tmp_idx, x_idx ----------
          mov  rdi, 1                             // root_idx = TMPFS_INODE_IDX_ROOT
          lea  rsi, [rip + witness_name_tmp]      // "tmp\0"
          call tmpfs_lookup
          cmp  rax, 0
          je   tmpfs_read_witness_fail
          mov  r12, rax                           // r12 = tmp_idx

          mov  rdi, r12                           // tmp_idx
          lea  rsi, [rip + witness_name_any]      // "x\0"
          call tmpfs_lookup
          cmp  rax, 0
          je   tmpfs_read_witness_fail
          mov  r13, rax                           // r13 = x_idx (source of the reads)

          // ---------- Sub-test A: tmpfs_read(x_idx, dst_buf, 100, 0) → expect rax = 100 ----------
          mov  rdi, r13                           // x_idx
          lea  rsi, [rip + tmpfs_read_dst_buf]    // buf_ptr = &dst[0]
          mov  rdx, 100                           // len = 100
          xor  rcx, rcx                           // offset = 0
          call tmpfs_read
          cmp  rax, 100
          jne  tmpfs_read_witness_fail

          // ---------- Sub-test B: dst_buf content = 8 x 'A' (0x4141414141414141) ----------
          lea  r14, [rip + tmpfs_read_dst_buf]
          mov  rcx, [r14]                         // rcx = u64 at dst_buf[0]
          mov  rdx, 0x4141414141414141            // expected: 8 x 'A'
          cmp  rcx, rdx
          jne  tmpfs_read_witness_fail

          // ---------- Sub-test C: tmpfs_read(x_idx, dst_buf, 10, 100) → expect rax = 0 (EOF) ----------
          mov  rdi, r13                           // x_idx
          lea  rsi, [rip + tmpfs_read_dst_buf]    // buf_ptr
          mov  rdx, 10                            // len = 10
          mov  rcx, 100                           // offset = 100 (== size)
          call tmpfs_read
          cmp  rax, 0
          jne  tmpfs_read_witness_fail

          // ---------- Sub-test D: tmpfs_read(x_idx, dst_buf, 100, 50) → expect rax = 50 (clamped) ----------
          mov  rdi, r13                           // x_idx
          lea  rsi, [rip + tmpfs_read_dst_buf]    // buf_ptr
          mov  rdx, 100                           // len = 100 (requested)
          mov  rcx, 50                            // offset = 50
          call tmpfs_read
          cmp  rax, 50                            // expect clamp to size - offset
          jne  tmpfs_read_witness_fail

          mov rdi, 3;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + tmpfs_read_ok_msg];
          call klog_s1;
          jmp  tmpfs_read_witness_done

      tmpfs_read_witness_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + tmpfs_read_fail_msg];
          call klog_s1;

      tmpfs_read_witness_done:

      // ============================================================
      // R16-M2-007 (#585): tmpfs_unlink witness — 4 sub-tests, 1 marker
      // ============================================================
      tmpfs_unlink_witness:
          // ---------- Preamble: recover tmp_idx, snapshot x_idx ----------
          // Recover tmp_idx via tmpfs_lookup on root
          mov  rdi, 1                             // root_idx = TMPFS_INODE_IDX_ROOT
          lea  rsi, [rip + witness_name_tmp]      // "tmp\0"
          call tmpfs_lookup
          cmp  rax, 0
          je   tmpfs_unlink_witness_fail
          mov  r12, rax                           // r12 = tmp_idx

          // Save x_idx BEFORE unlink for sub-test D bitmap check
          mov  rdi, r12                           // tmp_idx
          lea  rsi, [rip + witness_name_any]      // "x\0"
          call tmpfs_lookup
          cmp  rax, 0
          je   tmpfs_unlink_witness_fail
          mov  r13, rax                           // r13 = x_idx (pre-unlink snapshot)

          // ---------- Sub-test A: unlink returns 0 ----------
          // tmpfs_unlink(tmp_idx, "x") — expect rax = 0
          mov  rdi, r12
          lea  rsi, [rip + witness_name_any]
          call tmpfs_unlink
          cmp  rax, 0
          jne  tmpfs_unlink_witness_fail

          // ---------- Sub-test B: lookup misses ----------
          // Post-unlink lookup should miss
          mov  rdi, r12                           // tmp_idx
          lea  rsi, [rip + witness_name_any]      // "x\0"
          call tmpfs_lookup
          cmp  rax, 0
          jne  tmpfs_unlink_witness_fail          // expected miss

          // ---------- Sub-test C: /tmp.first_child == 0xFFFF ----------
          // Load /tmp's u64 @+176; extract first_child from bits [32, 48)
          mov  rdi, r12                           // tmp_idx
          call tmpfs_inode_slot                   // rax = &tmp_inode
          mov  rcx, [rax + 176]
          shr  rcx, 32
          and  rcx, 0xFFFF                        // rcx = tmp.first_child
          mov  rdx, 0xFFFF
          cmp  rcx, rdx
          jne  tmpfs_unlink_witness_fail          // expected empty-chain sentinel

          // ---------- Sub-test D: bitmap bit for x_idx is now 0 ----------
          // Verify _tmpfs_inode_bitmap[0] bit (r13 = x_idx) is 0
          lea  rax, [rip + _tmpfs_inode_bitmap]
          mov  r8, [rax]                          // bitmap word
          mov  rcx, r13                           // shift count = x_idx
          mov  rdx, 1
          shl  rdx, cl                            // rdx = 1 << x_idx
          and  r8, rdx                            // isolate bit
          cmp  r8, 0                              // must be zero (bit cleared)
          jne  tmpfs_unlink_witness_fail

          mov rdi, 3;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + tmpfs_unlink_ok_msg];
          call klog_s1;
          jmp  tmpfs_unlink_witness_done

      tmpfs_unlink_witness_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + tmpfs_unlink_fail_msg];
          call klog_s1;

      tmpfs_unlink_witness_done:

      // ============================================================
      // R16-M2-008 (#586): tmpfs vops table wire-up
      // ============================================================
      // Populate _tmpfs_vops with 7 adapter/stub pointers and verify
      // table integrity via pointer-identity checks + end-to-end dispatch.

      call tmpfs_vops_init                   // populates 7 slots

      // ---------- Sub-test A: read slot pointer identity ----------
      lea  rax, [rip + _tmpfs_vops]
      mov  rcx, [rax + 0]                    // VOPS_READ_OFFSET
      lea  rdx, [rip + _tmpfs_read_adapter]
      cmp  rcx, rdx
      jne  tmpfs_vops_witness_fail

      // ---------- Sub-test B: write slot pointer identity ----------
      lea  rax, [rip + _tmpfs_vops]
      mov  rcx, [rax + 8]                    // VOPS_WRITE_OFFSET
      lea  rdx, [rip + _tmpfs_write_adapter]
      cmp  rcx, rdx
      jne  tmpfs_vops_witness_fail

      // ---------- Sub-test C: open slot pointer identity ----------
      lea  rax, [rip + _tmpfs_vops]
      mov  rcx, [rax + 16]                   // VOPS_OPEN_OFFSET
      lea  rdx, [rip + _tmpfs_open_stub]
      cmp  rcx, rdx
      jne  tmpfs_vops_witness_fail

      // ---------- Sub-test D: close slot pointer identity ----------
      lea  rax, [rip + _tmpfs_vops]
      mov  rcx, [rax + 24]                   // VOPS_CLOSE_OFFSET
      lea  rdx, [rip + _tmpfs_close_stub]
      cmp  rcx, rdx
      jne  tmpfs_vops_witness_fail

      // ---------- Sub-test E: lookup slot pointer identity ----------
      lea  rax, [rip + _tmpfs_vops]
      mov  rcx, [rax + 32]                   // VOPS_LOOKUP_OFFSET
      lea  rdx, [rip + _tmpfs_lookup_adapter]
      cmp  rcx, rdx
      jne  tmpfs_vops_witness_fail

      // ---------- Sub-test F: create slot pointer identity ----------
      lea  rax, [rip + _tmpfs_vops]
      mov  rcx, [rax + 40]                   // VOPS_CREATE_OFFSET
      lea  rdx, [rip + _tmpfs_create_adapter]
      cmp  rcx, rdx
      jne  tmpfs_vops_witness_fail

      // ---------- Sub-test G: unlink slot pointer identity ----------
      lea  rax, [rip + _tmpfs_vops]
      mov  rcx, [rax + 48]                   // VOPS_UNLINK_OFFSET
      lea  rdx, [rip + _tmpfs_unlink_adapter]
      cmp  rcx, rdx
      jne  tmpfs_vops_witness_fail

      // ---------- Sub-test H: end-to-end dispatch via vops_lookup ----------
      // Construct scratch vnode on stack (64 bytes = VNODE_SIZE)
      sub  rsp, 64                            // allocate scratch vnode

      mov  rax, rsp                           // rax = vnode base
      xor  rcx, rcx
      mov  [rax + 0], rcx                     // zero first 8 bytes (type=FREE)
      mov  [rax + 8], rcx                     // zero next 8 bytes
      mov  [rax + 16], rcx                    // zero next 8 bytes

      lea  rcx, [rip + _tmpfs_vops]
      mov  [rax + 24], rcx                    // ops_ptr = &_tmpfs_vops

      mov  rcx, 1                             // TMPFS_INODE_IDX_ROOT
      mov  [rax + 32], rcx                    // backend_ptr = root_idx

      xor  rcx, rcx
      mov  [rax + 40], rcx                    // zero next 8 bytes
      mov  [rax + 48], rcx                    // zero next 8 bytes
      mov  [rax + 56], rcx                    // zero last 8 bytes

      // Dispatch vops_lookup(&scratch_vnode, "tmp")
      mov  rdi, rax                           // rdi = scratch vnode
      lea  rsi, [rip + tmpfs_vops_witness_name_tmp]  // rsi = "tmp\0"
      call vops_lookup                        // dispatch through _tmpfs_vops[+32]
                                              // -> _tmpfs_lookup_adapter
                                              // -> tmpfs_lookup(root_idx=1, "tmp")
                                              // returns /tmp inode idx (== 2)

      add  rsp, 64                            // unwind scratch vnode

      // Assert: rax is non-zero (child found) and != 0xFFFF (error)
      cmp  rax, 0
      je   tmpfs_vops_witness_fail
      cmp  rax, 0xFFFF
      je   tmpfs_vops_witness_fail

      // ---------- Success: emit marker ----------
      mov rdi, 3;
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + tmpfs_vops_ok_msg];
      call klog_s1;
      jmp  tmpfs_vops_witness_done

      tmpfs_vops_witness_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + tmpfs_vops_fail_msg];
          call klog_s1;

      tmpfs_vops_witness_done:

      // ============================================================
      // logging-m9-001 (#708): KIND_DMESG cap witness — post-R18 dmesg
      // observability handle. Per design/kernel/kernel-logging-substrate.md
      // §12.10 + §14 Q6.
      //
      // Placement: AFTER tmpfs_vops_witness_done (tmpfs is live for any
      // future sibling witnesses in the same block) and BEFORE the #664
      // vfs_open O_CREAT witness (which does not depend on cap state).
      // Runs in the SINGLE-CPU pre-scheduler bring-up window.
      // ============================================================

      // Mint a KIND_DMESG cap in cap_table[10] with rights=RIGHT_READ,
      // target_ptr = &_dmesg_cap_witness_scratch. Then exercise both
      // ops via cap_invoke_dispatch:
      //   OP_STAT (op_arg=1)                : expect rax lo32 == 65536.
      //   OP_READ_TAIL (op_arg=(256<<8)|0) : expect rax > 0 (ring has
      //                                       boot marker content by
      //                                       now — VFS/BOOT/tmpfs OK
      //                                       lines already emitted).
      //
      // Slot 10 chosen to avoid collision with cap_smoke (slot 0),
      // cap_dispatch_smoke (slots 1..8), and future bring-up expansions.
      dmesg_cap_witness:
          // cap_mint_write(slot=10, kind=22 KIND_DMESG, rights=RIGHT_READ=0x01, target_ptr=&scratch)
          mov  rdi, 10
          mov  rsi, 22                             // KIND_DMESG
          mov  rdx, 1                              // RIGHT_READ
          lea  rcx, [rip + _dmesg_cap_witness_scratch]
          call cap_mint_write

          // Sub-test 1: cap_invoke_dispatch(slot=10, op_arg=1=OP_STAT)
          mov  rdi, 10
          mov  rsi, 1                              // OP_STAT
          call cap_invoke_dispatch
          // Extract low 32 bits — must equal KLOG_RING_SIZE (65536).
          mov  rcx, rax
          mov  rdx, 0xFFFFFFFF
          and  rcx, rdx
          mov  rdx, 65536
          cmp  rcx, rdx
          jne  dmesg_cap_witness_fail

          // Sub-test 2: cap_invoke_dispatch(slot=10, op_arg=(256<<8)|0)
          //   OP_READ_TAIL, length = 256.
          mov  rdi, 10
          mov  rsi, 65536                          // (256 << 8) | OP_READ_TAIL(0)
          // 256 << 8 = 65536 exactly. OP_READ_TAIL = 0 → op_arg[7:0] = 0.
          call cap_invoke_dispatch
          // rax = bytes copied. The ring has BOOT / VFS / tmpfs OK lines
          // already, so a peek of 256 must return > 0.
          cmp  rax, 0
          je   dmesg_cap_witness_fail

          // Success marker.
          mov  rdi, 3
          lea  rsi, [rip + SUBSYS_BOOT]
          lea  rdx, [rip + dmesg_cap_ok_msg]
          call klog_s1
          jmp  dmesg_cap_witness_done

      dmesg_cap_witness_fail:
          mov  rdi, 1
          lea  rsi, [rip + SUBSYS_BOOT]
          lea  rdx, [rip + dmesg_cap_fail_msg]
          call klog_s1

      dmesg_cap_witness_done:

      // ============================================================
      // R20b.M1-001 (#1552): KIND_IPC_ENDPOINT capability witness.
      //
      // First sub-issue of the R20b userspace-server substrate cluster.
      // Exercises the KIND_IPC_ENDPOINT descriptor tail encoding
      // formalized in src/kernel/core/cap/kind_endpoint.pdx (per
      // design/ipc/userspace-server-substrate.md §3.1).
      //
      // Sub-tests (executed in order; any failure jumps to fail marker):
      //   A. endpoint_tail_encode(eid=7, dir=BIDI=2) → decode-id == 7,
      //      decode-dir == 2.
      //   B. endpoint_tail_valid on the above tail returns 1.
      //   C. endpoint_tail_valid on a malformed tail (eid=200 > 127)
      //      returns 0.
      //   D. endpoint_tail_valid on a malformed tail (dir=3 RESERVED)
      //      returns 0.
      //   E. endpoint_cap_mint(good_tail, rights=R_IPC_ALL=0x0B)
      //      returns ENDPOINT_MINT_OK (0).
      //   F. endpoint_cap_mint(good_tail, rights=0x04 = EXEC bit not
      //      in R_IPC_ALL) returns ENDPOINT_MINT_BAD_RIGHTS (0xFFFFFFFF).
      //   G. cap_mint_write a witness endpoint cap into slot 11
      //      (chosen distinct from slot 10 used by dmesg_cap_witness).
      //      kind=5 (KIND_IPC_ENDPOINT), rights=R_IPC_ALL, target_ptr
      //      = encoded (eid=7, dir=BIDI). Read back the descriptor and
      //      verify kind/rights/target_ptr match.
      //
      // Placement: runs in the SINGLE-CPU pre-scheduler bring-up window,
      // after dmesg_cap_witness (uses cap_table[10]) and before
      // sys_dmesg_witness. Slot 11 chosen distinct from cap_smoke
      // (slot 0) and cap_dispatch_smoke (slots 1..8) and dmesg (slot 10).
      // ============================================================
      endpoint_cap_witness:
          // -- Sub-test A: encode(eid=7, dir=BIDI=2), decode both fields.
          mov  rdi, 7
          mov  rsi, 2                              // ENDPOINT_DIR_BIDI
          call endpoint_tail_encode
          // rax = tail. Expected: 0x00020007 (dir=2 in bits [17:16] | eid=7).
          mov  r15, rax                            // r15 = good_tail

          // decode_id(good_tail) must equal 7.
          mov  rdi, r15
          call endpoint_tail_decode_id
          cmp  rax, 7
          jne  endpoint_cap_witness_fail

          // decode_dir(good_tail) must equal 2.
          mov  rdi, r15
          call endpoint_tail_decode_dir
          cmp  rax, 2
          jne  endpoint_cap_witness_fail

          // -- Sub-test B: tail_valid(good_tail) == 1.
          mov  rdi, r15
          call endpoint_tail_valid
          cmp  rax, 1
          jne  endpoint_cap_witness_fail

          // -- Sub-test C: tail_valid(eid=200, dir=0) == 0.
          mov  rdi, 200                            // out-of-range eid (>= 128)
          mov  rsi, 0                              // dir = SEND
          call endpoint_tail_encode
          mov  rdi, rax
          call endpoint_tail_valid
          cmp  rax, 0
          jne  endpoint_cap_witness_fail

          // -- Sub-test D: tail_valid(eid=1, dir=3=RESERVED) == 0.
          mov  rdi, 1
          mov  rsi, 3                              // ENDPOINT_DIR_RESERVED
          call endpoint_tail_encode
          mov  rdi, rax
          call endpoint_tail_valid
          cmp  rax, 0
          jne  endpoint_cap_witness_fail

          // -- Sub-test E: endpoint_cap_mint(good_tail, R_IPC_ALL=0x0B) == 0.
          mov  rdi, r15                            // tail
          mov  rsi, 0x0B                           // R_IPC_ALL
          call endpoint_cap_mint
          cmp  rax, 0                              // ENDPOINT_MINT_OK
          jne  endpoint_cap_witness_fail

          // -- Sub-test F: endpoint_cap_mint(good_tail, 0x04) rejects (EXEC not in R_IPC_ALL).
          mov  rdi, r15                            // tail
          mov  rsi, 0x04                           // RIGHT_EXEC — not in R_IPC_ALL
          call endpoint_cap_mint
          mov  r14, 0xFFFFFFFF                     // ENDPOINT_MINT_BAD_RIGHTS
          cmp  rax, r14
          jne  endpoint_cap_witness_fail

          // -- Sub-test G: cap_mint_write slot 11 + read-back verify.
          //    kind=5 (KIND_IPC_ENDPOINT), rights=0x0B, target_ptr=good_tail.
          mov  rdi, 11                             // slot
          mov  rsi, 5                              // KIND_IPC_ENDPOINT
          mov  rdx, 0x0B                           // R_IPC_ALL
          mov  rcx, r15                            // target_ptr = good_tail
          call cap_mint_write

          // Read-back: cap_table[11] descriptor is at base + 11*24 = +264.
          // Layout: [+0]=kind, [+8]=rights, [+16]=target_ptr.
          mov  rax, cap_table
          add  rax, 264                            // slot 11 * 24 bytes
          mov  rcx, [rax + 0]                      // kind
          cmp  rcx, 5
          jne  endpoint_cap_witness_fail
          mov  rcx, [rax + 8]                      // rights
          cmp  rcx, 0x0B
          jne  endpoint_cap_witness_fail
          mov  rcx, [rax + 16]                     // target_ptr
          cmp  rcx, r15
          jne  endpoint_cap_witness_fail

          // Success marker.
          mov  rdi, 3                              // LEVEL_INFO
          lea  rsi, [rip + SUBSYS_BOOT]
          lea  rdx, [rip + endpoint_cap_ok_msg]
          call klog_s1
          jmp  endpoint_cap_witness_done

      endpoint_cap_witness_fail:
          mov  rdi, 1                              // LEVEL_ERROR
          lea  rsi, [rip + SUBSYS_BOOT]
          lea  rdx, [rip + endpoint_cap_fail_msg]
          call klog_s1

      endpoint_cap_witness_done:

      // ============================================================
      // R29.M0-001 (#1017): KIND_HW base-kind witness — opens R29
      // (driver-framework maturation round).
      //
      // Promotes slot 14 of the 16-slot base_kind enum from its prior
      // "fault" placeholder to KIND_HW per
      // design/roadmap/next-wave-synthesis.md §10 D6. See also
      // design/capabilities/linearity-and-tags.md §3.1a and
      // design/architecture/next-wave-derived-kinds.md.
      //
      // R29.M1 (#1019-#1022) derives KIND_HW_INTERRUPT and
      // KIND_HW_MSIX_VECTOR over this base kind; KIND_HW_TIMELINE
      // remains reserved. KIND_DMA_DOMAIN (R29.M5, #1036) landed over
      // KIND_MEMORY rather than KIND_HW — a DMA domain is a memory-access
      // scope, not a device-authority handle — so the planning skeleton's
      // `KIND_HW_DMA_DOMAIN` name is retired; see
      // src/kernel/core/cap/kind_dma_domain.pdx §"Naming reconciliation".
      // This iteration only enshrines the base slot — no dispatch branch,
      // no derived tail encoders yet.
      //
      // Sub-tests:
      //   A. cap_mint_write(slot=14, kind=14 KIND_HW,
      //         rights=RIGHT_OBSERVE|RIGHT_MINT = 0x400|0x200 = 0x600,
      //         target_ptr=0xDEADBEEF (sentinel)).
      //   B. Read-back cap_table[14] descriptor: kind == 14, rights ==
      //      0x600, target_ptr == 0xDEADBEEF.
      //   C. cap_invoke_dispatch(slot=14, op_arg=0) → identity
      //      fallthrough returns target_ptr == 0xDEADBEEF (KIND_HW has
      //      no dispatch branch yet — the R8 MVP fallthrough applies).
      //
      // Slot 14 chosen to match the KIND_HW numeric value for
      // aesthetics + auditability (grep for `slot=14` returns the
      // KIND_HW witness). Distinct from cap_smoke (slot 0),
      // cap_dispatch_smoke (slots 1..8), dmesg_cap_witness (slot 10),
      // endpoint_cap_witness (slot 11). Descriptor address:
      //   cap_table + 14 * 24 = cap_table + 336.
      //
      // Placement: SINGLE-CPU pre-scheduler bring-up window, after
      // endpoint_cap_witness (M1-001 close) and before endpoint_alloc
      // witness (M1-002 open). Keeps the R18/R20b base-kind block
      // contiguous and matches the golden-fingerprint ordering:
      //   R18 DMESG CAP OK
      //   R20b ENDPOINT CAP OK
      //   R29 KIND_HW OK        ← this witness
      //   R20b ENDPOINT ALLOC OK
      //   ...
      //
      // No dedicated scratch storage needed — the witness uses only
      // caller-save registers and the cap_table itself.
      // ============================================================
      kind_hw_witness:
          // -- Sub-test A: cap_mint_write(slot=14, KIND_HW=14,
          //    rights=0x600, target_ptr=0xDEADBEEF).
          mov  rdi, 14                             // slot
          mov  rsi, 14                             // KIND_HW
          mov  rdx, 0x600                          // RIGHT_OBSERVE|RIGHT_MINT
          mov  rcx, 0xDEADBEEF                     // sentinel target_ptr
          call cap_mint_write

          // -- Sub-test B: read-back cap_table[14].
          //    Descriptor at cap_table + 14 * 24 = +336.
          //    Layout: [+0]=kind, [+8]=rights, [+16]=target_ptr.
          mov  rax, cap_table
          add  rax, 336
          mov  rcx, [rax + 0]                      // kind
          cmp  rcx, 14
          jne  kind_hw_witness_fail
          mov  rcx, [rax + 8]                      // rights
          mov  rdx, 0x600
          cmp  rcx, rdx
          jne  kind_hw_witness_fail
          mov  rcx, [rax + 16]                     // target_ptr
          mov  rdx, 0xDEADBEEF
          cmp  rcx, rdx
          jne  kind_hw_witness_fail

          // -- Sub-test C: cap_invoke_dispatch(slot=14, op_arg=0) —
          //    identity fallthrough returns target_ptr (KIND_HW has no
          //    per-kind handler yet; the R8 MVP fallthrough applies
          //    per src/kernel/core/cap/invoke.pdx).
          mov  rdi, 14                             // slot
          mov  rsi, 0                              // op_arg (unused for fallthrough)
          call cap_invoke_dispatch
          mov  rdx, 0xDEADBEEF
          cmp  rax, rdx
          jne  kind_hw_witness_fail

          // Success marker: R29 KIND_HW OK.
          mov  rdi, 3                              // LEVEL_INFO
          lea  rsi, [rip + SUBSYS_BOOT]
          lea  rdx, [rip + kind_hw_ok_msg]
          call klog_s1
          jmp  kind_hw_witness_done

      kind_hw_witness_fail:
          mov  rdi, 1                              // LEVEL_ERROR
          lea  rsi, [rip + SUBSYS_BOOT]
          lea  rdx, [rip + kind_hw_fail_msg]
          call klog_s1

      kind_hw_witness_done:

      // ============================================================
      // R29.M1-001..003 (#1019/#1020/#1021): KIND_HW_INTERRUPT
      // derived-kind witness — first R29.M1 landing.
      //
      // Derives over KIND_HW (base slot 14, minted immediately above at
      // kind_hw_witness slot 14 with rights=RIGHT_OBSERVE|RIGHT_MINT).
      // Exercises the full lifecycle: tail-alloc, mint, dispatch (three
      // OP_QUERY_* ops), revoke, verify slot is null. Uses the just-
      // minted KIND_HW cap at slot 14 as the "ancestor" required by
      // hw_int_cap_mint's parent gate.
      //
      // Sub-tests (any failure jumps to fail marker):
      //   A. hw_int_tail_alloc(gsi=0x30, affinity=0x01, edge_or_level=0)
      //      returns row_id in [0..HW_INT_MAX). Also probes tail_valid
      //      on the freshly-allocated row_id == 1.
      //   B. hw_int_tail_decode_{gsi,affinity,edge_or_level}(row_id)
      //      round-trip (gsi=0x30, affinity=0x01, edge=0).
      //   C. Failure edge: hw_int_tail_alloc(gsi=0x40, affinity=0,
      //      edge_or_level=2) returns HW_INT_TAIL_BAD_ARG (edge_or_level
      //      out of range).
      //   D. Failure edge: hw_int_rights_valid(0x04 EXEC — not in
      //      R_HW_INT_ALL=0x618) returns 0.
      //   E. hw_int_cap_revoke on unused slot 12 returns
      //      HW_INT_REVOKE_ALREADY (idempotent path — slot 12 has never
      //      been minted so kind==0).
      //   F. Restore: free the row from sub-test A so the mint below
      //      starts on a clean table.
      //   G. hw_int_cap_mint(slot=12, parent_slot=14,
      //         rights=R_HW_INT_ALL=0x618, gsi=0x30, affinity=0x01,
      //         edge_or_level=0) returns HW_INT_MINT_OK (0).
      //   H. Read-back cap_table[12]: kind == 0x140, rights == 0x618,
      //      target_ptr < HW_INT_MAX (row_id in valid range).
      //   I. cap_invoke_dispatch(slot=12, op_arg=0 OP_QUERY_GSI) returns
      //      0x30. Same for OP_QUERY_AFFINITY (0x01) and OP_QUERY_TRIGGER
      //      (0x00).
      //   J. Failure edge: mint with parent_slot=0 (cap_smoke, kind==1
      //      KIND_PROCESS, not KIND_HW) returns HW_INT_MINT_BAD_PARENT.
      //   K. hw_int_cap_revoke(slot=12) returns HW_INT_REVOKE_OK.
      //   L. Read-back cap_table[12] verifies descriptor is cleared
      //      (kind=0, rights=0, target_ptr=0). hw_int_tail_valid(row_id
      //      from sub-test G) returns 0 (row freed as part of revoke).
      //
      // Placement: runs immediately after kind_hw_witness_done (slot 14
      // already holds the KIND_HW ancestor). Slot 12 chosen distinct
      // from every other cap_table user: cap_smoke (0), cap_dispatch_smoke
      // (1..8), dmesg (10), endpoint_cap (11), kind_hw (14). Row_id 0
      // is used by sub-test A; sub-tests G/H/K use whichever row_id the
      // allocator hands out (should be 0 after sub-test F frees it).
      //
      // Fingerprint ordering (post-M1 landing):
      //   R20b ENDPOINT CAP OK
      //   R29 KIND_HW OK           (R29.M0-001)
      //   R29 KIND_INTERRUPT OK    ← THIS WITNESS
      //   R20b ENDPOINT ALLOC OK
      //   ...
      // ============================================================
      kind_hw_interrupt_witness:
          // Stage counter is memory-backed in _kind_hw_int_witness_stage
          // rather than a callee-save register — matches the discipline
          // of _frame_witness_stage / _pending_witness_stage above, so
          // the tracker survives any helper-call clobber pattern (any
          // caller-save write inside a helper would trash a register).
          //
          // Pre-clean cap_table[12] to (0,0,0). Empirically slot 12's
          // 24-byte descriptor region is NOT clean .bss zero at this
          // point in boot on the boot_r17_shell_shutdown fixture — some
          // upstream code path (unrelated to any prior witness that
          // consumes a cap_table slot; grep-confirmed slots {0..8, 10,
          // 11, 14} are the only ones written) leaves a non-zero
          // pattern at cap_table + 288. Rather than depend on
          // bss-zero-init for our idempotent-revoke sub-test E, we
          // explicitly zero the descriptor before the round-trip so
          // the mint/revoke assertions depend only on state THIS
          // witness itself installs. This mirrors the "always start
          // from a known state" discipline used by frame_witness /
          // pending_witness for their .bss scratch buffers. The three
          // stores are 24 bytes (kind + rights + target_ptr) — the
          // exact descriptor shape from cap/mint.pdx §cap_mint_write.
          mov  rax, cap_table
          add  rax, 288
          xor  rcx, rcx
          mov  [rax + 0],  rcx
          mov  [rax + 8],  rcx
          mov  [rax + 16], rcx

          // -- Sub-test A: hw_int_tail_alloc(gsi=0x30, affinity=0x01, edge=0).
          mov  rax, 1
          lea  rcx, [rip + _kind_hw_int_witness_stage]
          mov  [rcx], rax
          mov  rdi, 0x30                           // gsi
          mov  rsi, 0x01                           // cpu_affinity_mask
          mov  rdx, 0                              // edge_or_level (0=edge)
          call hw_int_tail_alloc
          // rax = row_id; must be < 64.
          mov  r15, rax                            // r15 = probe_row_id
          mov  rcx, 64
          cmp  r15, rcx
          jae  kind_hw_int_witness_fail

          // hw_int_tail_valid(probe_row_id) == 1.
          mov  rax, 2
          lea  rcx, [rip + _kind_hw_int_witness_stage]
          mov  [rcx], rax
          mov  rdi, r15
          call hw_int_tail_valid
          cmp  rax, 1
          jne  kind_hw_int_witness_fail

          // -- Sub-test B: decode round-trip.
          mov  rax, 3
          lea  rcx, [rip + _kind_hw_int_witness_stage]
          mov  [rcx], rax
          mov  rdi, r15
          call hw_int_tail_decode_gsi
          cmp  rax, 0x30
          jne  kind_hw_int_witness_fail

          mov  rax, 4
          lea  rcx, [rip + _kind_hw_int_witness_stage]
          mov  [rcx], rax
          mov  rdi, r15
          call hw_int_tail_decode_affinity
          cmp  rax, 0x01
          jne  kind_hw_int_witness_fail

          mov  rax, 5
          lea  rcx, [rip + _kind_hw_int_witness_stage]
          mov  [rcx], rax
          mov  rdi, r15
          call hw_int_tail_decode_edge_or_level
          cmp  rax, 0
          jne  kind_hw_int_witness_fail

          // -- Sub-test C: tail_alloc with edge_or_level=2 -> BAD_ARG.
          mov  rax, 6
          lea  rcx, [rip + _kind_hw_int_witness_stage]
          mov  [rcx], rax
          mov  rdi, 0x40
          mov  rsi, 0
          mov  rdx, 2
          call hw_int_tail_alloc
          mov  rcx, 0xFFFFFFFE                    // HW_INT_TAIL_BAD_ARG
          cmp  rax, rcx
          jne  kind_hw_int_witness_fail

          // -- Sub-test D: rights_valid(0x04 EXEC) -> 0.
          mov  rax, 7
          lea  rcx, [rip + _kind_hw_int_witness_stage]
          mov  [rcx], rax
          mov  rdi, 0x04
          call hw_int_rights_valid
          cmp  rax, 0
          jne  kind_hw_int_witness_fail

          // -- Sub-test E: revoke pre-cleaned slot 12 -> REVOKE_ALREADY.
          //    We pre-cleaned slot 12 at witness entry (see the
          //    "Pre-clean cap_table[12]" preamble above). This
          //    exercises the idempotent already-null revoke path
          //    without depending on .bss zero-init behaviour that has
          //    proven unreliable at this exact slot mid-boot.
          mov  rax, 8
          lea  rcx, [rip + _kind_hw_int_witness_stage]
          mov  [rcx], rax
          mov  rdi, 12
          call hw_int_cap_revoke
          mov  rcx, 0xFFFFFFF7                    // HW_INT_REVOKE_ALREADY
          cmp  rax, rcx
          jne  kind_hw_int_witness_fail

          // -- Sub-test F: free the sub-test A row so mint below reuses it.
          mov  rdi, r15
          call hw_int_tail_free

          // -- Sub-test G: hw_int_cap_mint(slot=12, parent_slot=14,
          //    rights=R_HW_INT_ALL=0x618, gsi=0x30, affinity=0x01, edge=0).
          //    SysV: rdi=slot, rsi=parent_slot, rdx=rights, rcx=gsi, r8=affinity, r9=edge.
          mov  rax, 9
          lea  rcx, [rip + _kind_hw_int_witness_stage]
          mov  [rcx], rax
          mov  rdi, 12
          mov  rsi, 14
          mov  rdx, 0x618
          mov  rcx, 0x30
          mov  r8,  0x01
          mov  r9,  0
          call hw_int_cap_mint
          cmp  rax, 0                             // HW_INT_MINT_OK
          jne  kind_hw_int_witness_fail

          // -- Sub-test H: read-back cap_table[12] (three field checks
          //    all guarded by the same stage=10; a failure at any of
          //    the three fields reports "stage 10" — enough to
          //    identify sub-test H). Stage set uses r8/rdi as scratch
          //    (both are caller-save and about to be overwritten by
          //    the next call anyway); rax stays live as the descriptor
          //    base pointer throughout.
          mov  r8, 10
          lea  rdi, [rip + _kind_hw_int_witness_stage]
          mov  [rdi], r8
          mov  rax, cap_table
          add  rax, 288
          mov  rcx, [rax + 0]                     // kind
          mov  rdx, 0x140
          cmp  rcx, rdx
          jne  kind_hw_int_witness_fail
          mov  rcx, [rax + 8]                     // rights
          mov  rdx, 0x618
          cmp  rcx, rdx
          jne  kind_hw_int_witness_fail
          mov  rcx, [rax + 16]                    // target_ptr = row_id
          mov  r14, rcx                           // save row_id for sub-test L
          mov  rdx, 64                            // HW_INT_MAX
          cmp  rcx, rdx
          jae  kind_hw_int_witness_fail

          // -- Sub-test I: cap_invoke_dispatch(slot=12, op) round-trip.
          //    OP_QUERY_GSI (0) -> 0x30
          mov  rax, 13
          lea  rcx, [rip + _kind_hw_int_witness_stage]
          mov  [rcx], rax
          mov  rdi, 12
          mov  rsi, 0
          call cap_invoke_dispatch
          cmp  rax, 0x30
          jne  kind_hw_int_witness_fail

          //    OP_QUERY_AFFINITY (1) -> 0x01
          mov  rax, 14
          lea  rcx, [rip + _kind_hw_int_witness_stage]
          mov  [rcx], rax
          mov  rdi, 12
          mov  rsi, 1
          call cap_invoke_dispatch
          cmp  rax, 0x01
          jne  kind_hw_int_witness_fail

          //    OP_QUERY_TRIGGER (2) -> 0
          mov  rax, 15
          lea  rcx, [rip + _kind_hw_int_witness_stage]
          mov  [rcx], rax
          mov  rdi, 12
          mov  rsi, 2
          call cap_invoke_dispatch
          cmp  rax, 0
          jne  kind_hw_int_witness_fail

          // -- Sub-test J: mint with parent_slot=0 (KIND_PROCESS, not KIND_HW)
          //    -> HW_INT_MINT_BAD_PARENT. Target slot 13 (unused).
          mov  rax, 16
          lea  rcx, [rip + _kind_hw_int_witness_stage]
          mov  [rcx], rax
          mov  rdi, 13
          mov  rsi, 0                             // parent = cap_smoke slot 0 (KIND_PROCESS)
          mov  rdx, 0x618
          mov  rcx, 0x40
          mov  r8,  0x02
          mov  r9,  1
          call hw_int_cap_mint
          mov  rcx, 0xFFFFFFFD                    // HW_INT_MINT_BAD_PARENT
          cmp  rax, rcx
          jne  kind_hw_int_witness_fail

          // -- Sub-test K: hw_int_cap_revoke(slot=12) -> REVOKE_OK.
          mov  rax, 17
          lea  rcx, [rip + _kind_hw_int_witness_stage]
          mov  [rcx], rax
          mov  rdi, 12
          call hw_int_cap_revoke
          cmp  rax, 0                             // HW_INT_REVOKE_OK
          jne  kind_hw_int_witness_fail

          // -- Sub-test L: verify descriptor cleared + row freed.
          mov  rax, 18
          lea  rcx, [rip + _kind_hw_int_witness_stage]
          mov  [rcx], rax
          mov  rax, cap_table
          add  rax, 288
          mov  rcx, [rax + 0]
          cmp  rcx, 0
          jne  kind_hw_int_witness_fail
          mov  rcx, [rax + 8]
          cmp  rcx, 0
          jne  kind_hw_int_witness_fail
          mov  rcx, [rax + 16]
          cmp  rcx, 0
          jne  kind_hw_int_witness_fail

          // hw_int_tail_valid(row_id from mint) == 0 (row was freed).
          mov  rax, 19
          lea  rcx, [rip + _kind_hw_int_witness_stage]
          mov  [rcx], rax
          mov  rdi, r14
          call hw_int_tail_valid
          cmp  rax, 0
          jne  kind_hw_int_witness_fail

          // Success marker: R29 KIND_INTERRUPT OK.
          mov  rdi, 3                             // LEVEL_INFO
          lea  rsi, [rip + SUBSYS_BOOT]
          lea  rdx, [rip + kind_hw_int_ok_msg]
          call klog_s1
          jmp  kind_hw_interrupt_witness_done

      kind_hw_int_witness_fail:
          // Emit fail marker with the _kind_hw_int_witness_stage number
          // as decimal KV. Stage is memory-backed (not r12) because any
          // callee-save-clobber in our helper chain would corrupt a
          // register-backed counter. Matches _frame_witness_stage pattern.
          //   klog_s1_d1(LEVEL_ERROR, SUBSYS_BOOT, kind_hw_int_fail_msg,
          //              k_line, stage)
          lea  rax, [rip + _kind_hw_int_witness_stage]
          mov  r8,  [rax]                          // r8 = stage value (arg 4)
          mov  rdi, 1                              // LEVEL_ERROR
          lea  rsi, [rip + SUBSYS_BOOT]
          lea  rdx, [rip + kind_hw_int_fail_msg]
          lea  rcx, [rip + k_line]
          call klog_s1_d1

      kind_hw_interrupt_witness_done:

      // ============================================================
      // R29.M1-004 (#1022): KIND_HW_MSIX_VECTOR derived-kind witness —
      // second derived-kind landing under KIND_HW. Closes R29.M1.
      //
      // Semantically layered atop KIND_HW_INTERRUPT: a KIND_HW_INTERRUPT
      // cap authorizes a line/GSI and MINTS N KIND_HW_MSIX_VECTOR
      // children (one per MSI-X vector on the underlying device). This
      // witness mints one parent + 4 children (typical NVMe / virtio-
      // net vector-count baseline), verifies each tail decode, then
      // revokes the parent and asserts all four children are auto-
      // revoked via msix_cascade_revoke_by_parent.
      //
      // Cap-table slot allocation:
      //   Slot 15 — KIND_HW_INTERRUPT parent (gsi=0x40, affinity=0x03,
      //             edge_or_level=1). Fresh (unused by any prior witness
      //             in the pre-scheduler bring-up window). Distinct
      //             from slot 12 (kind_hw_interrupt_witness, cleared
      //             at sub-test K), slot 14 (kind_hw_witness, holds
      //             KIND_HW base cap).
      //   Slots 16..19 — KIND_HW_MSIX_VECTOR children. Distinct
      //             {msix_table_offset, msix_data} tuples per child:
      //               slot 16: offset=0x00, data=0x8001
      //               slot 17: offset=0x10, data=0x8002
      //               slot 18: offset=0x20, data=0x8003
      //               slot 19: offset=0x30, data=0x8004
      //             Offsets are 16-byte-aligned per the MSI-X table
      //             entry stride; data payloads are distinct so the
      //             decode round-trip proves per-child persistence.
      //
      // Sub-tests (any failure jumps to fail marker):
      //   A. Pre-clean slots 15..19 (28 * 3 bytes cap-table state) so
      //      the witness runs from a known-null state regardless of
      //      any prior code path that may have touched a slot.
      //   B. hw_int_cap_mint(slot=15, parent_slot=14, rights=0x618,
      //      gsi=0x40, affinity=0x03, edge=1) -> HW_INT_MINT_OK.
      //   C. msix_cap_mint 4 children at slots 16..19 with distinct
      //      (offset, data) tuples -> each returns MSIX_MINT_OK.
      //   D. Read-back cap_table[16..19]: each kind == 0x141,
      //      rights == 0x218.
      //   E. cap_invoke_dispatch each child with OP_QUERY_TABLE_OFFSET
      //      -> returns the child's minted offset.
      //   F. cap_invoke_dispatch each child with OP_QUERY_DATA
      //      -> returns the child's minted data.
      //   G. cap_invoke_dispatch each child with OP_QUERY_PARENT
      //      -> returns 15 (the parent slot).
      //   H. Failure edge: msix_cap_mint(slot=20, parent_slot=14
      //      KIND_HW — not KIND_HW_INTERRUPT) -> MSIX_MINT_BAD_PARENT.
      //   I. Failure edge: msix_rights_valid(0x800 — bit not in
      //      R_MSIX_ALL=0x218) -> 0.
      //   J. hw_int_cap_revoke(slot=15) -> HW_INT_REVOKE_OK. Internally
      //      calls msix_cascade_revoke_by_parent(15) which revokes all
      //      four children.
      //   K. Verify each of cap_table[16..19] is cleared (kind=0,
      //      rights=0, target_ptr=0). Proves the cascade path fired.
      //   L. Verify cap_table[15] is cleared. Proves parent revoke
      //      itself completed after cascade.
      //
      // Fingerprint ordering (post-M1-004 landing):
      //   R29 KIND_HW OK             (R29.M0-001)
      //   R29 KIND_INTERRUPT OK      (R29.M1-001..003)
      //   R29 KIND_MSIX_VECTOR OK    ← THIS WITNESS
      //   R20b ENDPOINT ALLOC OK
      //   ...
      //
      // Stage tracker: memory-backed in _kind_hw_msix_witness_stage
      // (declared alongside _kind_hw_int_witness_stage in the .bss
      // block below). Same discipline: written before each sub-test,
      // reported on the fail path via klog_s1_d1.
      // ============================================================
      kind_hw_msix_vector_witness:
          // -- Sub-test A: pre-clean slots 15..19 (5 slots * 24 bytes
          //    each). Empirically some upstream code path may leave
          //    non-zero patterns in cap_table above the actively-used
          //    range at boot; explicit pre-clean matches the kind_hw_
          //    interrupt_witness posture (slot 12 pre-clean at line
          //    ~4931 of this file) and ensures the mint/revoke
          //    assertions depend only on state THIS witness installs.
          //    Descriptor stride = 24 bytes; slot 15 at offset 360,
          //    slot 19 at offset 456 -> clears 120 bytes total.
          mov  rax, 1
          lea  rcx, [rip + _kind_hw_msix_witness_stage]
          mov  [rcx], rax
          mov  rax, cap_table
          add  rax, 360                            // slot 15 * 24
          xor  rcx, rcx
          mov  [rax + 0],   rcx                    // slot 15
          mov  [rax + 8],   rcx
          mov  [rax + 16],  rcx
          mov  [rax + 24],  rcx                    // slot 16
          mov  [rax + 32],  rcx
          mov  [rax + 40],  rcx
          mov  [rax + 48],  rcx                    // slot 17
          mov  [rax + 56],  rcx
          mov  [rax + 64],  rcx
          mov  [rax + 72],  rcx                    // slot 18
          mov  [rax + 80],  rcx
          mov  [rax + 88],  rcx
          mov  [rax + 96],  rcx                    // slot 19
          mov  [rax + 104], rcx
          mov  [rax + 112], rcx

          // -- Sub-test B: hw_int_cap_mint(slot=15, parent_slot=14,
          //    rights=0x618, gsi=0x40, affinity=0x03, edge=1).
          //    SysV: rdi=slot, rsi=parent_slot, rdx=rights, rcx=gsi,
          //          r8=affinity, r9=edge.
          mov  rax, 2
          lea  rcx, [rip + _kind_hw_msix_witness_stage]
          mov  [rcx], rax
          mov  rdi, 15                             // parent slot
          mov  rsi, 14                             // KIND_HW ancestor
          mov  rdx, 0x618                          // R_HW_INT_ALL
          mov  rcx, 0x40                           // gsi
          mov  r8,  0x03                           // affinity
          mov  r9,  1                              // edge_or_level=level
          call hw_int_cap_mint
          cmp  rax, 0                              // HW_INT_MINT_OK
          jne  kind_hw_msix_witness_fail

          // -- Sub-test C: mint 4 children at slots 16..19.
          //    child 0: slot=16, offset=0x00, data=0x8001
          mov  rax, 3
          lea  rcx, [rip + _kind_hw_msix_witness_stage]
          mov  [rcx], rax
          mov  rdi, 16                             // child slot
          mov  rsi, 15                             // parent slot (KIND_HW_INTERRUPT)
          mov  rdx, 0x218                          // R_MSIX_ALL
          mov  rcx, 0x00                           // msix_table_offset
          mov  r8,  0x8001                         // msix_data
          call msix_cap_mint
          cmp  rax, 0                              // MSIX_MINT_OK
          jne  kind_hw_msix_witness_fail

          //    child 1: slot=17, offset=0x10, data=0x8002
          mov  rax, 4
          lea  rcx, [rip + _kind_hw_msix_witness_stage]
          mov  [rcx], rax
          mov  rdi, 17
          mov  rsi, 15
          mov  rdx, 0x218
          mov  rcx, 0x10
          mov  r8,  0x8002
          call msix_cap_mint
          cmp  rax, 0
          jne  kind_hw_msix_witness_fail

          //    child 2: slot=18, offset=0x20, data=0x8003
          mov  rax, 5
          lea  rcx, [rip + _kind_hw_msix_witness_stage]
          mov  [rcx], rax
          mov  rdi, 18
          mov  rsi, 15
          mov  rdx, 0x218
          mov  rcx, 0x20
          mov  r8,  0x8003
          call msix_cap_mint
          cmp  rax, 0
          jne  kind_hw_msix_witness_fail

          //    child 3: slot=19, offset=0x30, data=0x8004
          mov  rax, 6
          lea  rcx, [rip + _kind_hw_msix_witness_stage]
          mov  [rcx], rax
          mov  rdi, 19
          mov  rsi, 15
          mov  rdx, 0x218
          mov  rcx, 0x30
          mov  r8,  0x8004
          call msix_cap_mint
          cmp  rax, 0
          jne  kind_hw_msix_witness_fail

          // -- Sub-test D: read-back each of cap_table[16..19].
          //    Verify kind == 0x141 and rights == 0x218. Skip
          //    target_ptr shape here (row_id 0..HW_MSIX_MAX; witness
          //    sub-tests E/F/G exercise the row-decode round-trip).
          mov  rax, 7
          lea  rcx, [rip + _kind_hw_msix_witness_stage]
          mov  [rcx], rax
          mov  rax, cap_table
          add  rax, 384                            // slot 16 * 24
          //    slot 16:
          mov  rcx, [rax + 0]
          mov  rdx, 0x141
          cmp  rcx, rdx
          jne  kind_hw_msix_witness_fail
          mov  rcx, [rax + 8]
          mov  rdx, 0x218
          cmp  rcx, rdx
          jne  kind_hw_msix_witness_fail
          //    slot 17:
          mov  rcx, [rax + 24]
          mov  rdx, 0x141
          cmp  rcx, rdx
          jne  kind_hw_msix_witness_fail
          mov  rcx, [rax + 32]
          mov  rdx, 0x218
          cmp  rcx, rdx
          jne  kind_hw_msix_witness_fail
          //    slot 18:
          mov  rcx, [rax + 48]
          mov  rdx, 0x141
          cmp  rcx, rdx
          jne  kind_hw_msix_witness_fail
          mov  rcx, [rax + 56]
          mov  rdx, 0x218
          cmp  rcx, rdx
          jne  kind_hw_msix_witness_fail
          //    slot 19:
          mov  rcx, [rax + 72]
          mov  rdx, 0x141
          cmp  rcx, rdx
          jne  kind_hw_msix_witness_fail
          mov  rcx, [rax + 80]
          mov  rdx, 0x218
          cmp  rcx, rdx
          jne  kind_hw_msix_witness_fail

          // -- Sub-test E: OP_QUERY_TABLE_OFFSET on each child.
          mov  rax, 8
          lea  rcx, [rip + _kind_hw_msix_witness_stage]
          mov  [rcx], rax
          mov  rdi, 16
          mov  rsi, 0                              // OP_QUERY_TABLE_OFFSET
          call cap_invoke_dispatch
          cmp  rax, 0x00
          jne  kind_hw_msix_witness_fail

          mov  rax, 9
          lea  rcx, [rip + _kind_hw_msix_witness_stage]
          mov  [rcx], rax
          mov  rdi, 17
          mov  rsi, 0
          call cap_invoke_dispatch
          cmp  rax, 0x10
          jne  kind_hw_msix_witness_fail

          mov  rax, 10
          lea  rcx, [rip + _kind_hw_msix_witness_stage]
          mov  [rcx], rax
          mov  rdi, 18
          mov  rsi, 0
          call cap_invoke_dispatch
          cmp  rax, 0x20
          jne  kind_hw_msix_witness_fail

          mov  rax, 11
          lea  rcx, [rip + _kind_hw_msix_witness_stage]
          mov  [rcx], rax
          mov  rdi, 19
          mov  rsi, 0
          call cap_invoke_dispatch
          cmp  rax, 0x30
          jne  kind_hw_msix_witness_fail

          // -- Sub-test F: OP_QUERY_DATA on each child.
          mov  rax, 12
          lea  rcx, [rip + _kind_hw_msix_witness_stage]
          mov  [rcx], rax
          mov  rdi, 16
          mov  rsi, 1                              // OP_QUERY_DATA
          call cap_invoke_dispatch
          cmp  rax, 0x8001
          jne  kind_hw_msix_witness_fail

          mov  rax, 13
          lea  rcx, [rip + _kind_hw_msix_witness_stage]
          mov  [rcx], rax
          mov  rdi, 17
          mov  rsi, 1
          call cap_invoke_dispatch
          cmp  rax, 0x8002
          jne  kind_hw_msix_witness_fail

          mov  rax, 14
          lea  rcx, [rip + _kind_hw_msix_witness_stage]
          mov  [rcx], rax
          mov  rdi, 18
          mov  rsi, 1
          call cap_invoke_dispatch
          cmp  rax, 0x8003
          jne  kind_hw_msix_witness_fail

          mov  rax, 15
          lea  rcx, [rip + _kind_hw_msix_witness_stage]
          mov  [rcx], rax
          mov  rdi, 19
          mov  rsi, 1
          call cap_invoke_dispatch
          cmp  rax, 0x8004
          jne  kind_hw_msix_witness_fail

          // -- Sub-test G: OP_QUERY_PARENT on each child (all four
          //    should return 15, the parent slot recorded at mint).
          mov  rax, 16
          lea  rcx, [rip + _kind_hw_msix_witness_stage]
          mov  [rcx], rax
          mov  rdi, 16
          mov  rsi, 2                              // OP_QUERY_PARENT
          call cap_invoke_dispatch
          cmp  rax, 15
          jne  kind_hw_msix_witness_fail

          mov  rax, 17
          lea  rcx, [rip + _kind_hw_msix_witness_stage]
          mov  [rcx], rax
          mov  rdi, 17
          mov  rsi, 2
          call cap_invoke_dispatch
          cmp  rax, 15
          jne  kind_hw_msix_witness_fail

          mov  rax, 18
          lea  rcx, [rip + _kind_hw_msix_witness_stage]
          mov  [rcx], rax
          mov  rdi, 18
          mov  rsi, 2
          call cap_invoke_dispatch
          cmp  rax, 15
          jne  kind_hw_msix_witness_fail

          mov  rax, 19
          lea  rcx, [rip + _kind_hw_msix_witness_stage]
          mov  [rcx], rax
          mov  rdi, 19
          mov  rsi, 2
          call cap_invoke_dispatch
          cmp  rax, 15
          jne  kind_hw_msix_witness_fail

          // -- Sub-test H: mint with wrong-kind parent (slot 14 is
          //    KIND_HW base, not KIND_HW_INTERRUPT) -> BAD_PARENT.
          //    Target slot 20 (unused).
          mov  rax, 20
          lea  rcx, [rip + _kind_hw_msix_witness_stage]
          mov  [rcx], rax
          mov  rdi, 20
          mov  rsi, 14                             // KIND_HW, not 0x140
          mov  rdx, 0x218
          mov  rcx, 0x40
          mov  r8,  0x9000
          call msix_cap_mint
          mov  rcx, 0xFFFFFFED                     // MSIX_MINT_BAD_PARENT
          cmp  rax, rcx
          jne  kind_hw_msix_witness_fail

          // -- Sub-test I: rights_valid(0x800) -> 0 (bit not in R_MSIX_ALL).
          mov  rax, 21
          lea  rcx, [rip + _kind_hw_msix_witness_stage]
          mov  [rcx], rax
          mov  rdi, 0x800
          call msix_rights_valid
          cmp  rax, 0
          jne  kind_hw_msix_witness_fail

          // -- Sub-test J: hw_int_cap_revoke(slot=15) -> HW_INT_REVOKE_OK.
          //    Internally cascades: msix_cascade_revoke_by_parent(15)
          //    revokes all 4 children before the parent frees its own
          //    row/descriptor.
          mov  rax, 22
          lea  rcx, [rip + _kind_hw_msix_witness_stage]
          mov  [rcx], rax
          mov  rdi, 15
          call hw_int_cap_revoke
          cmp  rax, 0                              // HW_INT_REVOKE_OK
          jne  kind_hw_msix_witness_fail

          // -- Sub-test K: verify each child slot is cleared. Any
          //    non-zero kind/rights/target_ptr means the cascade
          //    missed that slot.
          mov  rax, 23
          lea  rcx, [rip + _kind_hw_msix_witness_stage]
          mov  [rcx], rax
          mov  rax, cap_table
          add  rax, 384                            // slot 16 * 24
          //    slot 16 (offsets 0, 8, 16):
          mov  rcx, [rax + 0]
          cmp  rcx, 0
          jne  kind_hw_msix_witness_fail
          mov  rcx, [rax + 8]
          cmp  rcx, 0
          jne  kind_hw_msix_witness_fail
          mov  rcx, [rax + 16]
          cmp  rcx, 0
          jne  kind_hw_msix_witness_fail
          //    slot 17 (offsets 24, 32, 40):
          mov  rcx, [rax + 24]
          cmp  rcx, 0
          jne  kind_hw_msix_witness_fail
          mov  rcx, [rax + 32]
          cmp  rcx, 0
          jne  kind_hw_msix_witness_fail
          mov  rcx, [rax + 40]
          cmp  rcx, 0
          jne  kind_hw_msix_witness_fail
          //    slot 18 (offsets 48, 56, 64):
          mov  rcx, [rax + 48]
          cmp  rcx, 0
          jne  kind_hw_msix_witness_fail
          mov  rcx, [rax + 56]
          cmp  rcx, 0
          jne  kind_hw_msix_witness_fail
          mov  rcx, [rax + 64]
          cmp  rcx, 0
          jne  kind_hw_msix_witness_fail
          //    slot 19 (offsets 72, 80, 88):
          mov  rcx, [rax + 72]
          cmp  rcx, 0
          jne  kind_hw_msix_witness_fail
          mov  rcx, [rax + 80]
          cmp  rcx, 0
          jne  kind_hw_msix_witness_fail
          mov  rcx, [rax + 88]
          cmp  rcx, 0
          jne  kind_hw_msix_witness_fail

          // -- Sub-test L: verify parent slot 15 is cleared.
          mov  rax, 24
          lea  rcx, [rip + _kind_hw_msix_witness_stage]
          mov  [rcx], rax
          mov  rax, cap_table
          add  rax, 360                            // slot 15 * 24
          mov  rcx, [rax + 0]
          cmp  rcx, 0
          jne  kind_hw_msix_witness_fail
          mov  rcx, [rax + 8]
          cmp  rcx, 0
          jne  kind_hw_msix_witness_fail
          mov  rcx, [rax + 16]
          cmp  rcx, 0
          jne  kind_hw_msix_witness_fail

          // Success marker: R29 KIND_MSIX_VECTOR OK.
          mov  rdi, 3                              // LEVEL_INFO
          lea  rsi, [rip + SUBSYS_BOOT]
          lea  rdx, [rip + kind_hw_msix_ok_msg]
          call klog_s1
          jmp  kind_hw_msix_vector_witness_done

      kind_hw_msix_witness_fail:
          // Emit fail marker with the _kind_hw_msix_witness_stage
          // number as decimal KV. Same pattern as
          // kind_hw_int_witness_fail — memory-backed stage counter
          // survives any callee-save-clobber pattern in the helper
          // chain (msix_cap_mint / msix_cap_revoke /
          // hw_int_cap_revoke → msix_cascade_revoke_by_parent all
          // touch multiple callee-save regs).
          lea  rax, [rip + _kind_hw_msix_witness_stage]
          mov  r8,  [rax]                          // r8 = stage value (arg 4)
          mov  rdi, 1                              // LEVEL_ERROR
          lea  rsi, [rip + SUBSYS_BOOT]
          lea  rdx, [rip + kind_hw_msix_fail_msg]
          lea  rcx, [rip + k_line]
          call klog_s1_d1

      kind_hw_msix_vector_witness_done:

      // ============================================================
      // R29.M5-001 (#1036) + R29.M5-002 (#1037): KIND_DMA_DOMAIN
      // derived-kind witness — opens R29.M5 (IOMMU-per-device DMA
      // domains + blob-policy closure).
      //
      // KIND_DMA_DOMAIN (0x142) is the third entry in the R29 derived-
      // kind block but the FIRST one that does not ride KIND_HW: it is
      // derived over KIND_MEMORY (= KIND_PAGE, base slot 4), because a
      // DMA domain is a memory-access scope, not a device-authority
      // handle. See src/kernel/core/cap/kind_dma_domain.pdx for the full
      // naming reconciliation against the catalog's former
      // `KIND_HW_DMA_DOMAIN` planning skeleton.
      //
      // Granularity is one domain per DRIVER PROCESS (D1.b), shared
      // across every device the driver owns. This witness mints two
      // domains under one memory parent to model two driver processes
      // sharing a common memory root, and proves the cascade tears down
      // both when that root goes away.
      //
      // Cap-table slot allocation (all fresh in the pre-scheduler
      // bring-up window; distinct from slot 12 / 14 / 15 / 16..19 used
      // by the R29.M1 witnesses above):
      //   Slot 24 — KIND_MEMORY parent (kind=4, rights=0x618).
      //   Slot 25 — KIND_DMA_DOMAIN, ctx=0xDEADBEEF, bdf=0x0308,
      //             capacity=0x40000000 (1 GiB), coherency=1
      //             (non-coherent).
      //   Slot 26 — KIND_DMA_DOMAIN, ctx=0x00C0FFEE, bdf=0x00F8,
      //             capacity=0x00001000 (4 KiB), coherency=0
      //             (coherent).
      //   Slot 27 — failure-edge mint target; every mint aimed here is
      //             expected to fail, so the slot must read back null at
      //             the end.
      //
      // The two tuples differ in EVERY field (including coherency, which
      // takes both legal values) so a decode that silently read the
      // wrong row could not pass.
      //
      // Sub-tests (any failure jumps to the fail marker, which reports
      // the stage number from _kind_dma_witness_stage):
      //   A. Pre-clean slots 24..27.
      //   B. Canonical tail-word encoder round-trip (#1037), table-free:
      //      dma_tail_pack(0xDEADBEEF, 0x0308, 1) == 0x00010308DEADBEEF,
      //      and dma_tail_word_{ctx_id,bdf,coherency} recover each field.
      //   C. Encoder failure edges: ctx >= 2^32, bdf >= 2^16, and
      //      coherency = 2 each return DMA_DECODE_BAD.
      //   D. Mint the KIND_MEMORY parent at slot 24 via cap_mint_write.
      //   E. dma_cap_mint slot 25 (tuple 1) -> DMA_MINT_OK.
      //   F. dma_cap_mint slot 26 (tuple 2) -> DMA_MINT_OK.
      //   G. Read back cap_table[25] / cap_table[26]: kind == 0x142,
      //      rights == 0x618.
      //   H. Full tail round-trip through cap_invoke_dispatch on slot
      //      25: OP_QUERY_CTX_ID / BDF / CAPACITY / COHERENCY / PARENT.
      //   I. Same five ops on slot 26 — proves per-row persistence, and
      //      that coherency=0 decodes as 0 rather than as a failure.
      //   J. Failure edge — BAD PARENT KIND: mint at slot 27 with
      //      parent_slot=25 (a KIND_DMA_DOMAIN, kind 0x142, not
      //      KIND_MEMORY) -> DMA_MINT_BAD_PARENT.
      //   K. Failure edge — INSUFFICIENT/ILLEGAL RIGHTS: rights=0x004
      //      (RIGHT_EXEC, not in R_DMA_ALL) -> DMA_MINT_BAD_RIGHTS;
      //      plus dma_rights_valid(0x800) -> 0.
      //   L. Failure edge — OUT-OF-RANGE COHERENCY: hand-built tail word
      //      with coherency field = 2 -> DMA_MINT_BAD_COHERENCY.
      //   M. Failure edge — ZERO CAPACITY: capacity_bytes=0 ->
      //      DMA_MINT_BAD_ARG.
      //   N. Failure edge — ROW EXHAUSTION: rows 0 and 1 are held by
      //      slots 25/26, so allocate the remaining 30 rows directly via
      //      dma_tail_alloc (asserting low-first row ids 2..31), then a
      //      dma_cap_mint must return DMA_MINT_ENOSPC. Rows 2..31 are
      //      freed again immediately so the table is left exactly as the
      //      two live domains found it.
      //   O. Slot 27 must still read back null — no failed mint wrote a
      //      descriptor.
      //   P. Canonical debug printer (#1037) through dispatch:
      //      OP_DEBUG_PRINT on slot 25 -> DMA_TAIL_OK.
      //   Q. Rights denial through dispatch: OP_MAP (needs RIGHT_MINT)
      //      is reached with full rights and must report
      //      INVOKE_UNSUPPORTED, proving the gate precedes — and does
      //      not swallow — the unimplemented-op return.
      //   R. Cascade revoke: dma_cascade_revoke_by_parent(24) -> 2.
      //   S. cap_table[25] and cap_table[26] cleared; rows 0 and 1
      //      freed (dma_tail_valid -> 0 for both).
      //   T. Revoke failure edges: dma_cap_revoke(25) on the now-null
      //      slot -> DMA_REVOKE_ALREADY; dma_cap_revoke(24) on the
      //      KIND_MEMORY parent -> DMA_REVOKE_WRONG_KIND (a revoke for
      //      one kind must never clear another kind's descriptor);
      //      cap_table[24] still intact afterwards.
      //   U. Clean up slot 24 so the witness leaves no residue.
      //
      // Fingerprint ordering (post-M5-001/002 landing):
      //   R29 KIND_HW OK             (R29.M0-001)
      //   R29 KIND_INTERRUPT OK      (R29.M1-001..003)
      //   R29 KIND_MSIX_VECTOR OK    (R29.M1-004)
      //   R29 KIND_DMA_DOMAIN OK     <- THIS WITNESS
      //   R29 LIFECYCLE FSM OK       (R29.M2-001)
      //   ...
      //
      // Stage tracker: memory-backed in _kind_dma_witness_stage; the
      // exhaustion loop cursor is likewise memory-backed in
      // _kind_dma_witness_cursor rather than held in a callee-save
      // register, so no assumption about which registers the helper
      // chain preserves leaks into the witness.
      // ============================================================
      kind_dma_domain_witness:
          // -- Sub-test A: pre-clean slots 24..27 (4 slots * 24 bytes,
          //    starting at offset 576 = 24 * 24).
          mov  rax, 1
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rax, cap_table
          add  rax, 576                            // slot 24 * 24
          xor  rcx, rcx
          mov  [rax + 0],  rcx                     // slot 24
          mov  [rax + 8],  rcx
          mov  [rax + 16], rcx
          mov  [rax + 24], rcx                     // slot 25
          mov  [rax + 32], rcx
          mov  [rax + 40], rcx
          mov  [rax + 48], rcx                     // slot 26
          mov  [rax + 56], rcx
          mov  [rax + 64], rcx
          mov  [rax + 72], rcx                     // slot 27
          mov  [rax + 80], rcx
          mov  [rax + 88], rcx

          // -- Sub-test B: canonical tail-word encoder round-trip.
          //    dma_tail_pack(0xDEADBEEF, 0x0308, 1)
          //      = 0xDEADBEEF | (0x0308 << 32) | (1 << 48)
          //      = 0x0001_0308_DEAD_BEEF
          mov  rax, 2
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rdi, 0xDEADBEEF
          mov  rsi, 0x0308
          mov  rdx, 1
          call dma_tail_pack
          mov  rcx, 0x00010308DEADBEEF
          cmp  rax, rcx
          jne  kind_dma_witness_fail

          //    ctx field recovers 0xDEADBEEF.
          mov  rax, 3
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rdi, 0x00010308DEADBEEF
          call dma_tail_word_ctx_id
          mov  rcx, 0xDEADBEEF
          cmp  rax, rcx
          jne  kind_dma_witness_fail

          //    bdf field recovers 0x0308.
          mov  rax, 4
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rdi, 0x00010308DEADBEEF
          call dma_tail_word_bdf
          cmp  rax, 0x0308
          jne  kind_dma_witness_fail

          //    coherency field recovers 1.
          mov  rax, 5
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rdi, 0x00010308DEADBEEF
          call dma_tail_word_coherency
          cmp  rax, 1
          jne  kind_dma_witness_fail

          // -- Sub-test C: encoder failure edges.
          //    ctx >= 2^32.
          mov  rax, 6
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rdi, 0x100000000
          mov  rsi, 0x0308
          mov  rdx, 0
          call dma_tail_pack
          mov  rcx, 0xFFFFFFFFFFFFFFFF             // DMA_DECODE_BAD
          cmp  rax, rcx
          jne  kind_dma_witness_fail

          //    bdf >= 2^16.
          mov  rax, 7
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rdi, 0x1000
          mov  rsi, 0x10000
          mov  rdx, 0
          call dma_tail_pack
          mov  rcx, 0xFFFFFFFFFFFFFFFF
          cmp  rax, rcx
          jne  kind_dma_witness_fail

          //    coherency = 2 (out of range).
          mov  rax, 8
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rdi, 0x1000
          mov  rsi, 0x0100
          mov  rdx, 2
          call dma_tail_pack
          mov  rcx, 0xFFFFFFFFFFFFFFFF
          cmp  rax, rcx
          jne  kind_dma_witness_fail

          // -- Sub-test D: mint the KIND_MEMORY parent at slot 24.
          //    cap_mint_write ABI: rdi=slot, rsi=kind, rdx=rights,
          //    rcx=target_ptr. rights 0x618 includes RIGHT_MINT (0x200),
          //    which is what dma_check_parent_kind_memory demands.
          mov  rax, 9
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rdi, 24
          mov  rsi, 4                              // KIND_MEMORY (= KIND_PAGE)
          mov  rdx, 0x618
          mov  rcx, 0x200000                       // notional region base
          call cap_mint_write

          // -- Sub-test E: mint domain 1 at slot 25.
          //    dma_cap_mint ABI: rdi=slot, rsi=parent_slot, rdx=rights,
          //    rcx=tail_word, r8=capacity_bytes.
          mov  rax, 10
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rdi, 25
          mov  rsi, 24
          mov  rdx, 0x618                          // R_DMA_ALL
          mov  rcx, 0x00010308DEADBEEF             // ctx/bdf/coh tuple 1
          mov  r8,  0x40000000                     // 1 GiB window ceiling
          call dma_cap_mint
          cmp  rax, 0                              // DMA_MINT_OK
          jne  kind_dma_witness_fail

          // -- Sub-test F: mint domain 2 at slot 26.
          //    tail word for (ctx=0x00C0FFEE, bdf=0x00F8, coh=0)
          //      = 0x00C0FFEE | (0x00F8 << 32) | (0 << 48)
          //      = 0x0000_00F8_00C0_FFEE
          mov  rax, 11
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rdi, 26
          mov  rsi, 24
          mov  rdx, 0x618
          mov  rcx, 0x000000F800C0FFEE             // ctx/bdf/coh tuple 2
          mov  r8,  0x1000                         // 4 KiB window ceiling
          call dma_cap_mint
          cmp  rax, 0
          jne  kind_dma_witness_fail

          // -- Sub-test G: descriptor read-back for slots 25 and 26.
          mov  rax, 12
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rax, cap_table
          add  rax, 600                            // slot 25 * 24
          //    slot 25:
          mov  rcx, [rax + 0]
          mov  rdx, 0x142
          cmp  rcx, rdx
          jne  kind_dma_witness_fail
          mov  rcx, [rax + 8]
          mov  rdx, 0x618
          cmp  rcx, rdx
          jne  kind_dma_witness_fail
          //    slot 26:
          mov  rcx, [rax + 24]
          mov  rdx, 0x142
          cmp  rcx, rdx
          jne  kind_dma_witness_fail
          mov  rcx, [rax + 32]
          mov  rdx, 0x618
          cmp  rcx, rdx
          jne  kind_dma_witness_fail

          // -- Sub-test H: full tail round-trip on slot 25 through the
          //    dispatcher. All four spec fields plus parent_slot.
          mov  rax, 13
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rdi, 25
          mov  rsi, 0                              // OP_QUERY_CTX_ID
          call cap_invoke_dispatch
          mov  rcx, 0xDEADBEEF
          cmp  rax, rcx
          jne  kind_dma_witness_fail

          mov  rax, 14
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rdi, 25
          mov  rsi, 1                              // OP_QUERY_BDF
          call cap_invoke_dispatch
          cmp  rax, 0x0308
          jne  kind_dma_witness_fail

          mov  rax, 15
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rdi, 25
          mov  rsi, 2                              // OP_QUERY_CAPACITY
          call cap_invoke_dispatch
          mov  rcx, 0x40000000
          cmp  rax, rcx
          jne  kind_dma_witness_fail

          mov  rax, 16
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rdi, 25
          mov  rsi, 3                              // OP_QUERY_COHERENCY
          call cap_invoke_dispatch
          cmp  rax, 1                              // non-coherent
          jne  kind_dma_witness_fail

          mov  rax, 17
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rdi, 25
          mov  rsi, 4                              // OP_QUERY_PARENT
          call cap_invoke_dispatch
          cmp  rax, 24
          jne  kind_dma_witness_fail

          // -- Sub-test I: same five ops on slot 26. Distinct values in
          //    every field; coherency 0 must decode as 0, not as a
          //    decode failure.
          mov  rax, 18
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rdi, 26
          mov  rsi, 0
          call cap_invoke_dispatch
          mov  rcx, 0x00C0FFEE
          cmp  rax, rcx
          jne  kind_dma_witness_fail

          mov  rax, 19
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rdi, 26
          mov  rsi, 1
          call cap_invoke_dispatch
          cmp  rax, 0x00F8
          jne  kind_dma_witness_fail

          mov  rax, 20
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rdi, 26
          mov  rsi, 2
          call cap_invoke_dispatch
          cmp  rax, 0x1000
          jne  kind_dma_witness_fail

          mov  rax, 21
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rdi, 26
          mov  rsi, 3
          call cap_invoke_dispatch
          cmp  rax, 0                              // coherent
          jne  kind_dma_witness_fail

          mov  rax, 22
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rdi, 26
          mov  rsi, 4
          call cap_invoke_dispatch
          cmp  rax, 24
          jne  kind_dma_witness_fail

          // -- Sub-test J: BAD PARENT KIND. Slot 25 is a
          //    KIND_DMA_DOMAIN (0x142), not a KIND_MEMORY (4).
          mov  rax, 23
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rdi, 27
          mov  rsi, 25                             // wrong parent kind
          mov  rdx, 0x618
          mov  rcx, 0x000000010000A000
          mov  r8,  0x1000
          call dma_cap_mint
          mov  rcx, 0xFFFFFFDC                     // DMA_MINT_BAD_PARENT
          cmp  rax, rcx
          jne  kind_dma_witness_fail

          // -- Sub-test K: ILLEGAL RIGHTS. 0x004 (RIGHT_EXEC) is not a
          //    member of R_DMA_ALL (0x618).
          mov  rax, 24
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rdi, 27
          mov  rsi, 24                             // correct parent this time
          mov  rdx, 0x004
          mov  rcx, 0x000000010000A000
          mov  r8,  0x1000
          call dma_cap_mint
          mov  rcx, 0xFFFFFFDB                     // DMA_MINT_BAD_RIGHTS
          cmp  rax, rcx
          jne  kind_dma_witness_fail

          //    Direct validator check on a bit outside R_DMA_ALL.
          mov  rax, 25
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rdi, 0x800
          call dma_rights_valid
          cmp  rax, 0
          jne  kind_dma_witness_fail

          // -- Sub-test L: OUT-OF-RANGE COHERENCY. Hand-built tail word
          //    with the coherency field (bits [55:48]) set to 2 —
          //    dma_tail_pack would have refused to build this, so it is
          //    constructed literally to prove the allocator re-checks
          //    rather than trusting its caller.
          //      0x0002_0000_0000_1234 = ctx 0x1234, bdf 0, coh 2
          mov  rax, 26
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rdi, 27
          mov  rsi, 24
          mov  rdx, 0x618
          mov  rcx, 0x0002000000001234
          mov  r8,  0x1000
          call dma_cap_mint
          mov  rcx, 0xFFFFFFD8                     // DMA_MINT_BAD_COHERENCY
          cmp  rax, rcx
          jne  kind_dma_witness_fail

          // -- Sub-test M: ZERO CAPACITY -> BAD_ARG.
          mov  rax, 27
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rdi, 27
          mov  rsi, 24
          mov  rdx, 0x618
          mov  rcx, 0x000000010000A000
          mov  r8,  0
          call dma_cap_mint
          mov  rcx, 0xFFFFFFD9                     // DMA_MINT_BAD_ARG
          cmp  rax, rcx
          jne  kind_dma_witness_fail

          // -- Sub-test N: ROW EXHAUSTION. Rows 0/1 belong to slots
          //    25/26; fill rows 2..31 directly, assert low-first row-id
          //    allocation, then prove dma_cap_mint reports ENOSPC.
          mov  rax, 28
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rax, 2
          lea  rcx, [rip + _kind_dma_witness_cursor]
          mov  [rcx], rax

      kind_dma_exhaust_loop:
          lea  rcx, [rip + _kind_dma_witness_cursor]
          mov  rax, [rcx]
          cmp  rax, 32                             // DMA_DOMAIN_MAX
          jae  kind_dma_exhaust_full
          mov  rdi, 0x000000010000B000             // ctx 0xB000, bdf 1, coh 0
          mov  rsi, 0x1000
          mov  rdx, 24
          call dma_tail_alloc
          lea  rcx, [rip + _kind_dma_witness_cursor]
          mov  rdx, [rcx]
          cmp  rax, rdx                            // low-first row ids
          jne  kind_dma_witness_fail
          add  rdx, 1
          mov  [rcx], rdx
          jmp  kind_dma_exhaust_loop

      kind_dma_exhaust_full:
          //    Table is full: a real mint must now report ENOSPC.
          mov  rax, 29
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rdi, 27
          mov  rsi, 24
          mov  rdx, 0x618
          mov  rcx, 0x000000010000A000
          mov  r8,  0x1000
          call dma_cap_mint
          mov  rcx, 0xFFFFFFDA                     // DMA_MINT_ENOSPC
          cmp  rax, rcx
          jne  kind_dma_witness_fail

          //    Release rows 2..31 so the table is left holding exactly
          //    the two live domains.
          mov  rax, 30
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rax, 2
          lea  rcx, [rip + _kind_dma_witness_cursor]
          mov  [rcx], rax

      kind_dma_release_loop:
          lea  rcx, [rip + _kind_dma_witness_cursor]
          mov  rax, [rcx]
          cmp  rax, 32
          jae  kind_dma_release_done
          mov  rdi, rax
          call dma_tail_free
          lea  rcx, [rip + _kind_dma_witness_cursor]
          mov  rax, [rcx]
          add  rax, 1
          mov  [rcx], rax
          jmp  kind_dma_release_loop

      kind_dma_release_done:
          //    Rows 0/1 must still be live — the release loop started at
          //    row 2 and must not have touched the domains in use.
          mov  rax, 31
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rdi, 0
          call dma_tail_valid
          cmp  rax, 1
          jne  kind_dma_witness_fail
          mov  rdi, 1
          call dma_tail_valid
          cmp  rax, 1
          jne  kind_dma_witness_fail

          // -- Sub-test O: slot 27 must still be null. Five failed mints
          //    were aimed at it; not one may have written a descriptor.
          mov  rax, 32
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rax, cap_table
          add  rax, 648                            // slot 27 * 24
          mov  rcx, [rax + 0]
          cmp  rcx, 0
          jne  kind_dma_witness_fail
          mov  rcx, [rax + 8]
          cmp  rcx, 0
          jne  kind_dma_witness_fail
          mov  rcx, [rax + 16]
          cmp  rcx, 0
          jne  kind_dma_witness_fail

          // -- Sub-test P: canonical debug printer through dispatch.
          //    OP_DEBUG_PRINT (9) needs RIGHT_OBSERVE, which slot 25
          //    holds; emits the five-line DMA DOMAIN ROW record under
          //    SUBSYS_CAP_ and returns DMA_TAIL_OK.
          mov  rax, 33
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rdi, 25
          mov  rsi, 9                              // OP_DEBUG_PRINT
          call cap_invoke_dispatch
          cmp  rax, 0                              // DMA_TAIL_OK
          jne  kind_dma_witness_fail

          // -- Sub-test Q: OP_MAP gates on RIGHT_MINT (held) and then
          //    reports INVOKE_UNSUPPORTED — the rights gate runs before
          //    the unimplemented-op return, so an authorized caller sees
          //    UNSUPPORTED rather than DENIED.
          mov  rax, 34
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rdi, 25
          mov  rsi, 5                              // OP_MAP
          call cap_invoke_dispatch
          mov  rcx, 0xFFFFFFFFFFFFFFFC             // INVOKE_UNSUPPORTED
          cmp  rax, rcx
          jne  kind_dma_witness_fail

          // -- Sub-test R: cascade revoke through the KIND_MEMORY
          //    ancestor. Both domains name slot 24 as parent, so the
          //    scan must revoke exactly two.
          mov  rax, 35
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rdi, 24
          call dma_cascade_revoke_by_parent
          cmp  rax, 2
          jne  kind_dma_witness_fail

          // -- Sub-test S: both descriptors cleared and both rows freed.
          mov  rax, 36
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rax, cap_table
          add  rax, 600                            // slot 25 * 24
          mov  rcx, [rax + 0]
          cmp  rcx, 0
          jne  kind_dma_witness_fail
          mov  rcx, [rax + 8]
          cmp  rcx, 0
          jne  kind_dma_witness_fail
          mov  rcx, [rax + 16]
          cmp  rcx, 0
          jne  kind_dma_witness_fail
          mov  rcx, [rax + 24]                     // slot 26
          cmp  rcx, 0
          jne  kind_dma_witness_fail
          mov  rcx, [rax + 32]
          cmp  rcx, 0
          jne  kind_dma_witness_fail
          mov  rcx, [rax + 40]
          cmp  rcx, 0
          jne  kind_dma_witness_fail

          mov  rax, 37
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rdi, 0
          call dma_tail_valid
          cmp  rax, 0
          jne  kind_dma_witness_fail
          mov  rdi, 1
          call dma_tail_valid
          cmp  rax, 0
          jne  kind_dma_witness_fail

          // -- Sub-test T: revoke failure edges.
          //    Double revoke of an already-cleared slot.
          mov  rax, 38
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rdi, 25
          call dma_cap_revoke
          mov  rcx, 0xFFFFFFD5                     // DMA_REVOKE_ALREADY
          cmp  rax, rcx
          jne  kind_dma_witness_fail

          //    Revoking the KIND_MEMORY parent through the DMA revoke
          //    path must refuse — one kind's revoke may never clear
          //    another kind's descriptor.
          mov  rax, 39
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rdi, 24
          call dma_cap_revoke
          mov  rcx, 0xFFFFFFD6                     // DMA_REVOKE_WRONG_KIND
          cmp  rax, rcx
          jne  kind_dma_witness_fail

          //    ... and the parent descriptor is untouched.
          mov  rax, 40
          lea  rcx, [rip + _kind_dma_witness_stage]
          mov  [rcx], rax
          mov  rax, cap_table
          add  rax, 576                            // slot 24 * 24
          mov  rcx, [rax + 0]
          cmp  rcx, 4                              // still KIND_MEMORY
          jne  kind_dma_witness_fail
          mov  rcx, [rax + 8]
          mov  rdx, 0x618
          cmp  rcx, rdx
          jne  kind_dma_witness_fail

          // -- Sub-test U: clean up slot 24 — the witness leaves the
          //    cap table exactly as it found it.
          mov  rax, cap_table
          add  rax, 576
          xor  rcx, rcx
          mov  [rax + 0],  rcx
          mov  [rax + 8],  rcx
          mov  [rax + 16], rcx

          // Success marker: R29 KIND_DMA_DOMAIN OK.
          mov  rdi, 3                              // LEVEL_INFO
          lea  rsi, [rip + SUBSYS_BOOT]
          lea  rdx, [rip + kind_dma_domain_ok_msg]
          call klog_s1
          jmp  kind_dma_domain_witness_done

      kind_dma_witness_fail:
          // Emit fail marker with the _kind_dma_witness_stage number as
          // a decimal KV — same discipline as kind_hw_msix_witness_fail.
          lea  rax, [rip + _kind_dma_witness_stage]
          mov  r8,  [rax]                          // r8 = stage value (arg 4)
          mov  rdi, 1                              // LEVEL_ERROR
          lea  rsi, [rip + SUBSYS_BOOT]
          lea  rdx, [rip + kind_dma_domain_fail_msg]
          lea  rcx, [rip + k_line]
          call klog_s1_d1

      kind_dma_domain_witness_done:

      // ============================================================
      // R30.M3-001 (#1061): KIND_OP_REGION witness — opens R30.M3, the
      // OpRegion / address-space milestone, and exercises the security
      // boundary of the whole round.
      //
      // Everything R30 landed before this milestone parsed and evaluated
      // firmware bytecode in a sandbox. KIND_OP_REGION is the capability
      // that authorises touching a physical address named by a
      // vendor-supplied, unsigned table. Per design/roadmap/
      // next-wave-softarch.md §3 R30: the OperationRegion abstraction
      // becomes a cap, and no other component of the system can silently
      // poke a hardware address.
      //
      // Sub-tests (any failure jumps to the fail marker with the stage
      // number from _kind_opreg_witness_stage):
      //   A. Pre-clean cap slots 28..33.
      //   B. Seed slot 28 = KIND_MEMORY (4) and slot 29 = KIND_IO_PORT
      //      (11), both with full rights. These are the two BASE
      //      authorities a root window may derive over.
      //   C. Containment arithmetic, including the OVERFLOW case: a
      //      request at 0xFFFFFFFFFFFFFFFF of length 2 must NOT be
      //      reported as contained. The naive `i_base + i_len <=
      //      o_base + o_len` form wraps and says yes.
      //   D. Root mint of a SystemMemory window over the KIND_MEMORY
      //      parent -> OPREG_MINT_OK, slot 33.
      //
      //      SLOT ORDERING IS PART OF THE FIXTURE, not an accident. The
      //      window chain is root=33 -> child=32 -> grandchild=30, i.e.
      //      DESCENDING, while the cascade walks the cap table
      //      ASCENDING. One pass therefore reaches only the root; the
      //      grandchild is not orphaned until the pass after its parent
      //      is revoked. Laid out the other way round (root at the
      //      lowest slot) a single-pass cascade would happen to finish
      //      the job in one sweep, and the fixed-point loop would be
      //      untested while looking tested. Mutation confirmed exactly
      //      that: with the ascending layout, neutralising the loop left
      //      the witness green.
      //   E. THE DERIVATION ASYMMETRY. The same SystemMemory root over
      //      the KIND_IO_PORT parent -> OPREG_MINT_BAD_PARENT. Without
      //      this, a holder of port authority could manufacture memory
      //      reach.
      //   F. And the converse: a SystemIO root over the KIND_IO_PORT
      //      parent -> OPREG_MINT_OK, slot 31. Both directions are
      //      asserted, because a gate that refused everything would pass
      //      a one-sided test.
      //   G. A BUS space (SMBus) is refused -> OPREG_MINT_BAD_SPACE.
      //   H. Derive a CONTAINED sub-window of slot 33 -> OK, slot 32.
      //   I. THE HEADLINE REFUSAL. Derive a window OUTSIDE slot 33's
      //      extent -> OPREG_MINT_NO_COVER, with slot 30 still null: the
      //      request was refused, not clipped to the covered part.
      //   J. Derive a grandchild of slot 33 through slot 32 -> OK,
      //      slot 30. This is the transitive-cascade fixture.
      //   K. Query ops through cap_invoke_dispatch: QUERY_BASE and
      //      QUERY_LEN on slot 32 return the derived window, not the
      //      parent's.
      //   L. Rights denial through the handler: a QUERY with no
      //      RIGHT_INVOKE -> INVOKE_DENIED.
      //   M. An unknown op -> INVOKE_UNSUPPORTED.
      //   N. TRANSITIVE CASCADE. Revoking by the KIND_MEMORY parent
      //      (slot 28) must reach slot 33 (its direct child), slot 32
      //      (child of 33) and slot 30 (child of 32) -> 3. A single-pass
      //      cascade returns 1 and leaves two live handles to addresses
      //      whose justification is gone.
      //   O. Slots 30 / 32 / 33 null; their rows freed.
      //   P. Revoke failure edges: revoke(33) on the now-null slot ->
      //      OPREG_REVOKE_ALREADY; revoke(28) on the KIND_MEMORY parent
      //      -> OPREG_REVOKE_WRONG_KIND, and slot 28 still intact.
      //   Q. Clean up: revoke slot 31 and clear slots 28/29, so the
      //      witness leaves the cap table exactly as it found it.
      //
      // Fingerprint ordering:
      //   R29 KIND_DMA_DOMAIN OK     (R29.M5-001/002)
      //   R30 KIND_OP_REGION OK      <- THIS WITNESS
      //   R29 LIFECYCLE FSM OK       (R29.M2-001)
      // ============================================================
      kind_op_region_witness:
          // -- A: pre-clean slots 28..33 (offset 28*24 = 672).
          mov  rax, 1
          lea  rcx, [rip + _kind_opreg_witness_stage]
          mov  [rcx], rax
          mov  rax, cap_table
          add  rax, 672
          xor  rcx, rcx
          mov  [rax + 0],   rcx
          mov  [rax + 8],   rcx
          mov  [rax + 16],  rcx
          mov  [rax + 24],  rcx
          mov  [rax + 32],  rcx
          mov  [rax + 40],  rcx
          mov  [rax + 48],  rcx
          mov  [rax + 56],  rcx
          mov  [rax + 64],  rcx
          mov  [rax + 72],  rcx
          mov  [rax + 80],  rcx
          mov  [rax + 88],  rcx
          mov  [rax + 96],  rcx
          mov  [rax + 104], rcx
          mov  [rax + 112], rcx
          mov  [rax + 120], rcx
          mov  [rax + 128], rcx
          mov  [rax + 136], rcx

          // -- B: seed the two base authorities.
          mov  rax, 2
          lea  rcx, [rip + _kind_opreg_witness_stage]
          mov  [rcx], rax
          mov  rax, cap_table
          add  rax, 672
          mov  rcx, 4                              // KIND_MEMORY
          mov  [rax + 0], rcx
          mov  rcx, 0x61B                          // R_OPREG_ALL
          mov  [rax + 8], rcx
          xor  rcx, rcx
          mov  [rax + 16], rcx
          mov  rcx, 11                             // KIND_IO_PORT
          mov  [rax + 24], rcx
          mov  rcx, 0x61B
          mov  [rax + 32], rcx
          xor  rcx, rcx
          mov  [rax + 40], rcx

          // -- C: containment arithmetic, including the wrap case.
          mov  rax, 3
          lea  rcx, [rip + _kind_opreg_witness_stage]
          mov  [rcx], rax
          mov  rdi, 0x1000
          mov  rsi, 0x1000
          mov  rdx, 0x1400
          mov  rcx, 0x400
          call opregion_range_contains
          cmp  rax, 1
          jne  kind_opreg_witness_fail

          mov  rax, 4
          lea  rcx, [rip + _kind_opreg_witness_stage]
          mov  [rcx], rax
          mov  rdi, 0x1000
          mov  rsi, 0x1000
          mov  rdx, 0x1C00
          mov  rcx, 0x800                          // runs past the end
          call opregion_range_contains
          cmp  rax, 0
          jne  kind_opreg_witness_fail

          mov  rax, 5
          lea  rcx, [rip + _kind_opreg_witness_stage]
          mov  [rcx], rax
          mov  rdi, 0x1000
          mov  rsi, 0x1000
          mov  rdx, 0xFFFFFFFFFFFFFFFF             // the wrap probe
          mov  rcx, 2
          call opregion_range_contains
          cmp  rax, 0
          jne  kind_opreg_witness_fail

          // -- D: SystemMemory root over KIND_MEMORY -> OK.
          mov  rax, 6
          lea  rcx, [rip + _kind_opreg_witness_stage]
          mov  [rcx], rax
          mov  rdi, 33                             // slot -- see the
                                                   //   slot-ordering note
          mov  rsi, 28                             // KIND_MEMORY parent
          mov  rdx, 0x61B                          // rights
          mov  rcx, 0                              // SystemMemory
          mov  r8,  0xE0000000                     // base
          mov  r9,  0x10000                        // len
          call opregion_cap_mint_root
          cmp  rax, 0
          jne  kind_opreg_witness_fail

          // -- E: the SAME space over the WRONG base kind -> BAD_PARENT.
          mov  rax, 7
          lea  rcx, [rip + _kind_opreg_witness_stage]
          mov  [rcx], rax
          mov  rdi, 31
          mov  rsi, 29                             // KIND_IO_PORT parent
          mov  rdx, 0x61B
          mov  rcx, 0                              // SystemMemory
          mov  r8,  0xE0000000
          mov  r9,  0x1000
          call opregion_cap_mint_root
          mov  rcx, 0xFFFFFFCB                     // OPREG_MINT_BAD_PARENT
          cmp  rax, rcx
          jne  kind_opreg_witness_fail

          // ... and the refused mint wrote no descriptor.
          mov  rax, 8
          lea  rcx, [rip + _kind_opreg_witness_stage]
          mov  [rcx], rax
          mov  rax, cap_table
          add  rax, 744                            // slot 31 * 24
          mov  rcx, [rax + 0]
          cmp  rcx, 0
          jne  kind_opreg_witness_fail

          // -- F: the converse direction is permitted.
          mov  rax, 9
          lea  rcx, [rip + _kind_opreg_witness_stage]
          mov  [rcx], rax
          mov  rdi, 31
          mov  rsi, 29                             // KIND_IO_PORT parent
          mov  rdx, 0x61B
          mov  rcx, 1                              // SystemIO
          mov  r8,  0x62                           // the EC port pair
          mov  r9,  5
          call opregion_cap_mint_root
          cmp  rax, 0
          jne  kind_opreg_witness_fail

          // -- G: a bus space is not an address space.
          mov  rax, 10
          lea  rcx, [rip + _kind_opreg_witness_stage]
          mov  [rcx], rax
          mov  rdi, 32
          mov  rsi, 28
          mov  rdx, 0x61B
          mov  rcx, 4                              // SMBus
          mov  r8,  0x100
          mov  r9,  0x10
          call opregion_cap_mint_root
          mov  rcx, 0xFFFFFFC7                     // OPREG_MINT_BAD_SPACE
          cmp  rax, rcx
          jne  kind_opreg_witness_fail

          // -- H: derive a CONTAINED sub-window.
          mov  rax, 11
          lea  rcx, [rip + _kind_opreg_witness_stage]
          mov  [rcx], rax
          mov  rdi, 32                             // child slot
          mov  rsi, 33                             // parent window
          mov  rdx, 0x61B
          mov  rcx, 0xE0001000
          mov  r8,  0x100
          call opregion_cap_derive
          cmp  rax, 0
          jne  kind_opreg_witness_fail

          // -- I: THE HEADLINE. A window outside the parent's extent.
          mov  rax, 12
          lea  rcx, [rip + _kind_opreg_witness_stage]
          mov  [rcx], rax
          mov  rdi, 30
          mov  rsi, 33
          mov  rdx, 0x61B
          mov  rcx, 0xF0000000                     // nowhere near the root
          mov  r8,  0x100
          call opregion_cap_derive
          mov  rcx, 0xFFFFFFC5                     // OPREG_MINT_NO_COVER
          cmp  rax, rcx
          jne  kind_opreg_witness_fail

          // Refused, NOT clipped: slot 33 must still be null. A handler
          // that had truncated to the covered part would have written a
          // perfectly valid-looking descriptor here.
          mov  rax, 13
          lea  rcx, [rip + _kind_opreg_witness_stage]
          mov  [rcx], rax
          mov  rax, cap_table
          add  rax, 720                            // slot 30 * 24
          mov  rcx, [rax + 0]
          cmp  rcx, 0
          jne  kind_opreg_witness_fail

          // -- J: a grandchild, for the transitive cascade.
          mov  rax, 14
          lea  rcx, [rip + _kind_opreg_witness_stage]
          mov  [rcx], rax
          mov  rdi, 30                             // BELOW its ancestors
          mov  rsi, 32                             // child of the root
          mov  rdx, 0x61B
          mov  rcx, 0xE0001040
          mov  r8,  0x40
          call opregion_cap_derive
          cmp  rax, 0
          jne  kind_opreg_witness_fail

          // -- K: query ops through dispatch return the DERIVED window.
          mov  rax, 15
          lea  rcx, [rip + _kind_opreg_witness_stage]
          mov  [rcx], rax
          mov  rdi, 32
          mov  rsi, 1                              // OPREG_OP_QUERY_BASE
          call cap_invoke_dispatch
          mov  rcx, 0xE0001000
          cmp  rax, rcx
          jne  kind_opreg_witness_fail

          mov  rax, 16
          lea  rcx, [rip + _kind_opreg_witness_stage]
          mov  [rcx], rax
          mov  rdi, 32
          mov  rsi, 2                              // OPREG_OP_QUERY_LEN
          call cap_invoke_dispatch
          cmp  rax, 0x100
          jne  kind_opreg_witness_fail

          // -- L: rights denial. Reached with the row live, so the gate
          //    is proven to precede the work rather than to follow it.
          mov  rax, 17
          lea  rcx, [rip + _kind_opreg_witness_stage]
          mov  [rcx], rax
          xor  rdi, rdi                            // no rights at all
          xor  rsi, rsi                            // row 0
          xor  rdx, rdx                            // OPREG_OP_QUERY_SPACE
          call cap_handler_op_region
          mov  rcx, 0xFFFFFFFFFFFFFFFD             // INVOKE_DENIED
          cmp  rax, rcx
          jne  kind_opreg_witness_fail

          // -- M: an unknown op.
          mov  rax, 18
          lea  rcx, [rip + _kind_opreg_witness_stage]
          mov  [rcx], rax
          mov  rdi, 0x61B
          xor  rsi, rsi
          mov  rdx, 9
          call cap_handler_op_region
          mov  rcx, 0xFFFFFFFFFFFFFFFC             // INVOKE_UNSUPPORTED
          cmp  rax, rcx
          jne  kind_opreg_witness_fail

          // -- N: TRANSITIVE cascade from the KIND_MEMORY parent.
          mov  rax, 19
          lea  rcx, [rip + _kind_opreg_witness_stage]
          mov  [rcx], rax
          mov  rdi, 28
          call opregion_cascade_revoke_by_parent
          cmp  rax, 3
          jne  kind_opreg_witness_fail

          // -- O: all three descriptors cleared.
          mov  rax, 20
          lea  rcx, [rip + _kind_opreg_witness_stage]
          mov  [rcx], rax
          mov  rax, cap_table
          add  rax, 720
          mov  rcx, [rax + 0]                      // slot 30 (grandchild)
          cmp  rcx, 0
          jne  kind_opreg_witness_fail
          mov  rcx, [rax + 48]                     // slot 32 (child)
          cmp  rcx, 0
          jne  kind_opreg_witness_fail
          mov  rcx, [rax + 72]                     // slot 33 (root)
          cmp  rcx, 0
          jne  kind_opreg_witness_fail

          // ... and their rows are free (row 0 was the memory root).
          mov  rax, 21
          lea  rcx, [rip + _kind_opreg_witness_stage]
          mov  [rcx], rax
          xor  rdi, rdi
          call opregion_tail_valid
          cmp  rax, 0
          jne  kind_opreg_witness_fail

          // -- P: revoke failure edges.
          mov  rax, 22
          lea  rcx, [rip + _kind_opreg_witness_stage]
          mov  [rcx], rax
          mov  rdi, 33
          call opregion_cap_revoke
          mov  rcx, 0xFFFFFFC2                     // OPREG_REVOKE_ALREADY
          cmp  rax, rcx
          jne  kind_opreg_witness_fail

          mov  rax, 23
          lea  rcx, [rip + _kind_opreg_witness_stage]
          mov  [rcx], rax
          mov  rdi, 28                             // the KIND_MEMORY parent
          call opregion_cap_revoke
          mov  rcx, 0xFFFFFFC3                     // OPREG_REVOKE_WRONG_KIND
          cmp  rax, rcx
          jne  kind_opreg_witness_fail

          mov  rax, 24
          lea  rcx, [rip + _kind_opreg_witness_stage]
          mov  [rcx], rax
          mov  rax, cap_table
          add  rax, 672
          mov  rcx, [rax + 0]
          cmp  rcx, 4                              // still KIND_MEMORY
          jne  kind_opreg_witness_fail

          // -- Q: leave the table as we found it.
          mov  rdi, 31
          call opregion_cap_revoke
          mov  rax, cap_table
          add  rax, 672
          xor  rcx, rcx
          mov  [rax + 0],  rcx
          mov  [rax + 8],  rcx
          mov  [rax + 16], rcx
          mov  [rax + 24], rcx
          mov  [rax + 32], rcx
          mov  [rax + 40], rcx

          mov  rdi, 3                              // LEVEL_INFO
          lea  rsi, [rip + SUBSYS_BOOT]
          lea  rdx, [rip + kind_op_region_ok_msg]
          call klog_s1
          jmp  kind_op_region_witness_done

      kind_opreg_witness_fail:
          lea  rax, [rip + _kind_opreg_witness_stage]
          mov  r8,  [rax]
          mov  rdi, 1                              // LEVEL_ERROR
          lea  rsi, [rip + SUBSYS_BOOT]
          lea  rdx, [rip + kind_op_region_fail_msg]
          lea  rcx, [rip + k_line]
          call klog_s1_d1

      kind_op_region_witness_done:

      // ============================================================
      // R29.M2-001 (#1023): driver lifecycle FSM witness — opens R29.M2
      // (Lifecycle FSM real bodies + regression corpus).
      //
      // Exercises the six-state FSM defined in src/kernel/core/driver/
      // lifecycle.pdx (Init → Running → Suspended → Handoff → Stopping
      // → Stopped) atop the descriptor storage in src/kernel/core/
      // driver/driver_table.pdx (32-slot .bss table, 48 B per row).
      // Per design/roadmap/next-wave-softarch.md §3 R29 (Milestones)
      // this is the substrate every downstream R29.M2..M7 issue
      // (#1024..#1027 lifecycle plumbing, #1028..#1030 registry v2,
      // #1031..#1034 signing, #1035..#1038 DMA domains, #1039..#1042
      // audit surface, #1043..#1047 chaos-restart) reads/writes.
      //
      // Sub-tests (any failure jumps to fail marker with _stage KV):
      //   A. driver_table_register(slot=0, pid=42, name="lifecycle-test",
      //        caps_offset=0x100) -> DRIVER_TABLE_REGISTER_OK (0). Row
      //      populated; state byte = DRIVER_STATE_INIT (0), in_use = 1.
      //   B. driver_lifecycle_get_state(0) -> 0 (DRIVER_STATE_INIT).
      //   C. Duplicate register: driver_table_register(0, ...) ->
      //      DRIVER_TABLE_REGISTER_ALREADY_USED (0xFFFFFEFE).
      //   D. Out-of-range register: driver_table_register(64, ...) ->
      //      DRIVER_TABLE_REGISTER_BAD_SLOT (0xFFFFFEFF).
      //   E. driver_lifecycle_transition(0, RUNNING) -> OK; get_state=1.
      //   F. driver_lifecycle_transition(0, SUSPENDED) -> OK; get_state=2.
      //   G. driver_lifecycle_transition(0, RUNNING) -> OK (loop back);
      //      get_state=1.
      //   H. driver_lifecycle_transition(0, SUSPENDED) -> OK; get_state=2.
      //   I. driver_lifecycle_transition(0, HANDOFF) -> OK; get_state=3.
      //   J. driver_lifecycle_transition(0, STOPPING) -> OK; get_state=4.
      //   K. driver_lifecycle_transition(0, STOPPED) -> OK; get_state=5.
      //   L. Rejection: driver_lifecycle_transition(0, RUNNING) ->
      //      ERR_INVALID_TRANSITION (0xFFFFFF03). Stopped is terminal;
      //      no transition out.
      //   M. Rejection: driver_lifecycle_transition(0, 99) ->
      //      ERR_UNKNOWN_STATE (0xFFFFFF02). new_state out of range
      //      (>= DRIVER_STATE_COUNT).
      //   N. Rejection: driver_lifecycle_transition(64, RUNNING) ->
      //      ERR_BAD_SLOT (0xFFFFFF01). Slot out of range.
      //   O. Rejection: driver_lifecycle_get_state(64) -> ERR_BAD_SLOT.
      //   P. Rejection: driver_lifecycle_transition(1, RUNNING) ->
      //      ERR_BAD_SLOT (slot in range but never registered — in_use=0).
      //   Q. Rejection sample from mid-FSM: transition_valid(INIT,
      //      SUSPENDED) -> 0 (only INIT->RUNNING is on the whitelist
      //      out of INIT). Cross-checks the pure predicate too.
      //   R. Cleanup: driver_table_unregister(0). Follow with
      //      driver_lifecycle_get_state(0) -> ERR_BAD_SLOT — confirms
      //      the row is free for a downstream witness to re-register.
      //
      // Uses slot 0 (freshly-zeroed in .bss at this point in boot; no
      // earlier code touches _driver_table). Slot 64 is used for both
      // out-of-range register AND out-of-range transition/get_state
      // tests. Slot 1 for the "in-range but unregistered" gate.
      //
      // Sub-test stage is memory-backed in _driver_lifecycle_witness_stage
      // (declared in the KernelMain module's .bss block) so a fail exit
      // logs which sub-test tripped via the driver_lifecycle_fail_msg +
      // line KV. Matches the _kind_hw_int_witness_stage discipline.
      //
      // Placement: runs after kind_hw_msix_vector_witness_done (last
      // R29.M1 witness) and before endpoint_alloc_witness (R20b.M1-002),
      // preserving the R29-family boot ordering in the golden log:
      //   R29 KIND_HW OK           (R29.M0-001)
      //   R29 KIND_INTERRUPT OK    (R29.M1-001..003)
      //   R29 KIND_MSIX_VECTOR OK  (R29.M1-004)
      //   R29 LIFECYCLE FSM OK     ← THIS WITNESS
      //   R20b ENDPOINT ALLOC OK   (R20b.M1-002)
      //   ...
      // ============================================================
      driver_lifecycle_witness:
          // -- Sub-test A: driver_table_register(0, 42, name_ptr, 0x100).
          mov  rax, 1
          lea  rcx, [rip + _driver_lifecycle_witness_stage]
          mov  [rcx], rax
          mov  rdi, 0                              // slot
          mov  rsi, 42                             // pid
          lea  rdx, [rip + _driver_lifecycle_witness_name]
          mov  rcx, 0x100                          // caps_manifest_offset
          call driver_table_register
          cmp  rax, 0                              // DRIVER_TABLE_REGISTER_OK
          jne  driver_lifecycle_witness_fail

          // -- Sub-test B: get_state(0) == DRIVER_STATE_INIT (0).
          mov  rax, 2
          lea  rcx, [rip + _driver_lifecycle_witness_stage]
          mov  [rcx], rax
          mov  rdi, 0
          call driver_lifecycle_get_state
          cmp  rax, 0                              // DRIVER_STATE_INIT
          jne  driver_lifecycle_witness_fail

          // -- Sub-test C: duplicate register -> ALREADY_USED.
          mov  rax, 3
          lea  rcx, [rip + _driver_lifecycle_witness_stage]
          mov  [rcx], rax
          mov  rdi, 0
          mov  rsi, 99
          lea  rdx, [rip + _driver_lifecycle_witness_name]
          mov  rcx, 0
          call driver_table_register
          mov  r14, 0xFFFFFEFE                     // DRIVER_TABLE_REGISTER_ALREADY_USED
          cmp  rax, r14
          jne  driver_lifecycle_witness_fail

          // -- Sub-test D: out-of-range register -> BAD_SLOT.
          mov  rax, 4
          lea  rcx, [rip + _driver_lifecycle_witness_stage]
          mov  [rcx], rax
          mov  rdi, 64
          mov  rsi, 0
          lea  rdx, [rip + _driver_lifecycle_witness_name]
          mov  rcx, 0
          call driver_table_register
          mov  r14, 0xFFFFFEFF                     // DRIVER_TABLE_REGISTER_BAD_SLOT
          cmp  rax, r14
          jne  driver_lifecycle_witness_fail

          // -- Sub-test E: transition Init -> Running.
          mov  rax, 5
          lea  rcx, [rip + _driver_lifecycle_witness_stage]
          mov  [rcx], rax
          mov  rdi, 0
          mov  rsi, 1                              // DRIVER_STATE_RUNNING
          call driver_lifecycle_transition
          cmp  rax, 0                              // DRIVER_LIFECYCLE_OK
          jne  driver_lifecycle_witness_fail
          mov  rdi, 0
          call driver_lifecycle_get_state
          cmp  rax, 1
          jne  driver_lifecycle_witness_fail

          // -- Sub-test F: Running -> Suspended.
          mov  rax, 6
          lea  rcx, [rip + _driver_lifecycle_witness_stage]
          mov  [rcx], rax
          mov  rdi, 0
          mov  rsi, 2                              // DRIVER_STATE_SUSPENDED
          call driver_lifecycle_transition
          cmp  rax, 0
          jne  driver_lifecycle_witness_fail
          mov  rdi, 0
          call driver_lifecycle_get_state
          cmp  rax, 2
          jne  driver_lifecycle_witness_fail

          // -- Sub-test G: Suspended -> Running (loop back).
          mov  rax, 7
          lea  rcx, [rip + _driver_lifecycle_witness_stage]
          mov  [rcx], rax
          mov  rdi, 0
          mov  rsi, 1
          call driver_lifecycle_transition
          cmp  rax, 0
          jne  driver_lifecycle_witness_fail
          mov  rdi, 0
          call driver_lifecycle_get_state
          cmp  rax, 1
          jne  driver_lifecycle_witness_fail

          // -- Sub-test H: Running -> Suspended (again).
          mov  rax, 8
          lea  rcx, [rip + _driver_lifecycle_witness_stage]
          mov  [rcx], rax
          mov  rdi, 0
          mov  rsi, 2
          call driver_lifecycle_transition
          cmp  rax, 0
          jne  driver_lifecycle_witness_fail
          mov  rdi, 0
          call driver_lifecycle_get_state
          cmp  rax, 2
          jne  driver_lifecycle_witness_fail

          // -- Sub-test I: Suspended -> Handoff.
          mov  rax, 9
          lea  rcx, [rip + _driver_lifecycle_witness_stage]
          mov  [rcx], rax
          mov  rdi, 0
          mov  rsi, 3                              // DRIVER_STATE_HANDOFF
          call driver_lifecycle_transition
          cmp  rax, 0
          jne  driver_lifecycle_witness_fail
          mov  rdi, 0
          call driver_lifecycle_get_state
          cmp  rax, 3
          jne  driver_lifecycle_witness_fail

          // -- Sub-test J: Handoff -> Stopping.
          mov  rax, 10
          lea  rcx, [rip + _driver_lifecycle_witness_stage]
          mov  [rcx], rax
          mov  rdi, 0
          mov  rsi, 4                              // DRIVER_STATE_STOPPING
          call driver_lifecycle_transition
          cmp  rax, 0
          jne  driver_lifecycle_witness_fail
          mov  rdi, 0
          call driver_lifecycle_get_state
          cmp  rax, 4
          jne  driver_lifecycle_witness_fail

          // -- Sub-test K: Stopping -> Stopped (terminal).
          mov  rax, 11
          lea  rcx, [rip + _driver_lifecycle_witness_stage]
          mov  [rcx], rax
          mov  rdi, 0
          mov  rsi, 5                              // DRIVER_STATE_STOPPED
          call driver_lifecycle_transition
          cmp  rax, 0
          jne  driver_lifecycle_witness_fail
          mov  rdi, 0
          call driver_lifecycle_get_state
          cmp  rax, 5
          jne  driver_lifecycle_witness_fail

          // -- Sub-test L: rejection Stopped -> Running (terminal, no
          //    transition out).
          mov  rax, 12
          lea  rcx, [rip + _driver_lifecycle_witness_stage]
          mov  [rcx], rax
          mov  rdi, 0
          mov  rsi, 1                              // Running
          call driver_lifecycle_transition
          mov  r14, 0xFFFFFF03                     // ERR_INVALID_TRANSITION
          cmp  rax, r14
          jne  driver_lifecycle_witness_fail
          // Verify state was NOT mutated on rejection.
          mov  rdi, 0
          call driver_lifecycle_get_state
          cmp  rax, 5                              // still Stopped
          jne  driver_lifecycle_witness_fail

          // -- Sub-test M: rejection new_state out of range -> UNKNOWN_STATE.
          mov  rax, 13
          lea  rcx, [rip + _driver_lifecycle_witness_stage]
          mov  [rcx], rax
          mov  rdi, 0
          mov  rsi, 99                             // >= DRIVER_STATE_COUNT
          call driver_lifecycle_transition
          mov  r14, 0xFFFFFF02                     // ERR_UNKNOWN_STATE
          cmp  rax, r14
          jne  driver_lifecycle_witness_fail

          // -- Sub-test N: rejection slot out of range -> BAD_SLOT.
          mov  rax, 14
          lea  rcx, [rip + _driver_lifecycle_witness_stage]
          mov  [rcx], rax
          mov  rdi, 64
          mov  rsi, 1
          call driver_lifecycle_transition
          mov  r14, 0xFFFFFF01                     // ERR_BAD_SLOT
          cmp  rax, r14
          jne  driver_lifecycle_witness_fail

          // -- Sub-test O: get_state slot out of range -> BAD_SLOT.
          mov  rax, 15
          lea  rcx, [rip + _driver_lifecycle_witness_stage]
          mov  [rcx], rax
          mov  rdi, 64
          call driver_lifecycle_get_state
          mov  r14, 0xFFFFFF01                     // ERR_BAD_SLOT
          cmp  rax, r14
          jne  driver_lifecycle_witness_fail

          // -- Sub-test P: transition on unregistered slot -> BAD_SLOT.
          mov  rax, 16
          lea  rcx, [rip + _driver_lifecycle_witness_stage]
          mov  [rcx], rax
          mov  rdi, 1                              // slot 1 never registered
          mov  rsi, 1
          call driver_lifecycle_transition
          mov  r14, 0xFFFFFF01                     // ERR_BAD_SLOT
          cmp  rax, r14
          jne  driver_lifecycle_witness_fail

          // -- Sub-test Q: transition_valid(INIT, SUSPENDED) == 0.
          //    INIT can ONLY transition to RUNNING; every other target
          //    must be rejected by the pure predicate.
          mov  rax, 17
          lea  rcx, [rip + _driver_lifecycle_witness_stage]
          mov  [rcx], rax
          mov  rdi, 0                              // cur = INIT
          mov  rsi, 2                              // new = SUSPENDED (illegal from INIT)
          call driver_lifecycle_transition_valid
          cmp  rax, 0
          jne  driver_lifecycle_witness_fail
          // Cross-check: transition_valid(INIT, RUNNING) == 1.
          mov  rdi, 0
          mov  rsi, 1
          call driver_lifecycle_transition_valid
          cmp  rax, 1
          jne  driver_lifecycle_witness_fail

          // -- Sub-test R: unregister + subsequent get_state -> BAD_SLOT.
          mov  rax, 18
          lea  rcx, [rip + _driver_lifecycle_witness_stage]
          mov  [rcx], rax
          mov  rdi, 0
          call driver_table_unregister
          mov  rdi, 0
          call driver_lifecycle_get_state
          mov  r14, 0xFFFFFF01                     // ERR_BAD_SLOT
          cmp  rax, r14
          jne  driver_lifecycle_witness_fail

          // Success marker: R29 LIFECYCLE FSM OK.
          mov  rdi, 3                              // LEVEL_INFO
          lea  rsi, [rip + SUBSYS_BOOT]
          lea  rdx, [rip + driver_lifecycle_ok_msg]
          call klog_s1
          jmp  driver_lifecycle_witness_done

      driver_lifecycle_witness_fail:
          // Emit fail marker with stage KV.
          lea  rax, [rip + _driver_lifecycle_witness_stage]
          mov  r8,  [rax]                          // stage value (arg 4)
          mov  rdi, 1                              // LEVEL_ERROR
          lea  rsi, [rip + SUBSYS_BOOT]
          lea  rdx, [rip + driver_lifecycle_fail_msg]
          lea  rcx, [rip + k_line]
          call klog_s1_d1

      driver_lifecycle_witness_done:

      // ============================================================
      // R29.M2-004 (#1026): driver lifecycle FSM fuzz witness.
      //
      // Property-tester complement to the deterministic FSM witness
      // above. Walks 1000 random (cur, new) state-pairs derived from
      // a fixed-seed Knuth LCG and asserts the pure transition-whitelist
      // predicate (driver_lifecycle_transition_valid) agrees with the
      // stateful transition primitive (driver_lifecycle_transition) on
      // every outcome. Kernel-side half of the "every ack correlates
      // with a valid FSM edge" invariant documented in
      // design/ipc/driver-lifecycle-schema.md §6.
      //
      // LCG parameters (Knuth / Numerical Recipes):
      //   state_{n+1} = state_n * A + C   (mod 2^64)
      //   A = 0x5851F42D4C957F2D (6364136223846793005)
      //   C = 0x14057B7EF767814F (1442695040888963407)
      //   seed = 0x0BADBEEFC0FFEE01 (reproducible; no HW entropy)
      //
      // Per-iter (cur, new) extraction: 3-bit slices from bits [42:40]
      // and [50:48] of the advanced state — both from upper bits where
      // LCG output mixes well. Values in [0..8) cover legal FSM states
      // (0..5 = INIT..STOPPED) plus 6, 7 which are out-of-range —
      // forcing ~25% of iters to exercise ERR_UNKNOWN_STATE (new >= 6
      // at the transition entry gate) and ~25% to exercise
      // ERR_INVALID_TRANSITION with cur >= 6 (the transition_valid
      // predicate rejects then the transition primitive's stateful
      // reject cascades).
      //
      // Per-iter check (r14 = predicate, rax = rc):
      //   predicate == 1  ->  rc == 0  AND  get_state == new
      //   predicate == 0  ->  rc != 0  AND  get_state == cur (unchanged)
      //
      // The "state unchanged on rejection" half of the invariant is
      // load-bearing: the R29.M6 audit surface will emit a transition
      // audit record only on the OK path, so a rejected transition
      // silently mutating the row would corrupt every downstream
      // audit-count invariant.
      //
      // Sub-tests (single stage 0 = setup; stages 1..1000 = iter+1):
      //   Setup: driver_table_register(slot=0, pid=42, name=
      //          "lifecycle-test", caps_offset=0) -> REGISTER_OK.
      //          (Prior witness's cleanup unregistered slot 0 so this
      //          re-register succeeds.)
      //   Iter i (0..999):
      //     Stage <- i + 1
      //     LCG advance; cur = (state >> 40) & 7; new = (state >> 48) & 7
      //     driver_table_write_state_byte(0, cur)   ; seed row.state = cur
      //     r14 <- driver_lifecycle_transition_valid(cur, new)
      //     rax <- driver_lifecycle_transition(0, new)
      //     if r14 == 1: assert rax == 0 AND get_state(0) == new
      //     if r14 == 0: assert rax != 0 AND get_state(0) == cur
      //
      // Register plan (all callee-save across sub-calls):
      //   rbx = LCG state (seed 0x0BADBEEFC0FFEE01)
      //   r15 = iter counter (0..999)
      //   r14 = per-iter predicate (0 or 1)
      //   r13 = per-iter cur
      //   r12 = per-iter new
      //
      // driver_lifecycle_transition pushes r12/r13 (preserves them),
      // uses r14/r15/rbx not-at-all; driver_lifecycle_transition_valid
      // is a leaf (no pushes) touching only rax/rcx/r10/r11 plus its
      // arg regs; driver_lifecycle_get_state pushes r12 (preserves it);
      // driver_table_write_state_byte is a leaf touching rax/r8/r9/
      // r10/r11 plus arg regs. So r12/r13/r14/r15/rbx round-trip clean
      // across every helper the loop calls.
      //
      // Placement: runs immediately after driver_lifecycle_witness_done
      // (deterministic FSM witness) and before endpoint_alloc_witness
      // (R20b.M1-002), preserving the R29-family boot ordering in the
      // golden log:
      //   R29 KIND_HW OK           (R29.M0-001)
      //   R29 KIND_INTERRUPT OK    (R29.M1-001..003)
      //   R29 KIND_MSIX_VECTOR OK  (R29.M1-004)
      //   R29 LIFECYCLE FSM OK     (R29.M2-001)
      //   R29 LIFECYCLE FUZZ OK    <- THIS WITNESS
      //   R20b ENDPOINT ALLOC OK   (R20b.M1-002)
      //   ...
      // ============================================================
      driver_lifecycle_fuzz_witness:
          // -- Setup: re-register slot 0 (the deterministic FSM witness
          //    unregistered it in its sub-test R). Stage 0 marks setup.
          xor  rax, rax
          lea  rcx, [rip + _driver_lifecycle_fuzz_witness_stage]
          mov  [rcx], rax
          mov  rdi, 0                              // slot
          mov  rsi, 42                             // pid
          lea  rdx, [rip + _driver_lifecycle_witness_name]
          mov  rcx, 0                              // caps_manifest_offset
          call driver_table_register
          cmp  rax, 0                              // DRIVER_TABLE_REGISTER_OK
          jne  driver_lifecycle_fuzz_witness_fail

          // -- Initialize LCG state (rbx) and iter counter (r15).
          mov  rbx, 0x0BADBEEFC0FFEE01             // LCG seed
          xor  r15, r15                            // iter = 0

      drv_lc_fuzz_loop:
          // Record stage = iter + 1 for fail diagnostics (1..1000).
          mov  rax, r15
          add  rax, 1
          lea  rcx, [rip + _driver_lifecycle_fuzz_witness_stage]
          mov  [rcx], rax

          // LCG advance: rbx = rbx * A + C.
          mov  r10, 0x5851F42D4C957F2D             // A (Knuth LCG multiplier)
          imul rbx, r10
          mov  r10, 0x14057B7EF767814F             // C (Knuth LCG increment)
          add  rbx, r10

          // Extract cur = (state >> 40) & 7  and  new = (state >> 48) & 7.
          // Both slices are 3-bit -> values in [0..8), so 6/7 land in
          // the "out-of-range" bucket that exercises the FSM's reject
          // paths without ever writing a fully-random byte pattern.
          mov  r13, rbx
          shr  r13, 40
          mov  r10, 7
          and  r13, r10                            // r13 = cur in [0..8)
          mov  r12, rbx
          shr  r12, 48
          and  r12, r10                            // r12 = new in [0..8)

          // Seed row state = cur. write_state_byte preserves in_use=1
          // and only touches the low byte of the header; passing cur
          // in [0..8) writes bytes 0..7 (including the out-of-range
          // values 6, 7 which the transition primitive will then read
          // and reject via its stateful path).
          mov  rdi, 0
          mov  rsi, r13                            // new_state = cur to seed
          call driver_table_write_state_byte

          // predicate = driver_lifecycle_transition_valid(cur, new)
          mov  rdi, r13
          mov  rsi, r12
          call driver_lifecycle_transition_valid
          mov  r14, rax                            // save predicate

          // rc = driver_lifecycle_transition(0, new)
          mov  rdi, 0
          mov  rsi, r12
          call driver_lifecycle_transition
          // rax = rc; 0 == OK; any non-zero == ERR_BAD_SLOT /
          //   ERR_UNKNOWN_STATE / ERR_INVALID_TRANSITION.

          // Branch on predicate.
          cmp  r14, 0
          je   drv_lc_fuzz_expect_err

          // predicate == 1: rc must be 0, state must == new.
          cmp  rax, 0
          jne  driver_lifecycle_fuzz_witness_fail
          mov  rdi, 0
          call driver_lifecycle_get_state
          cmp  rax, r12                            // state == new?
          jne  driver_lifecycle_fuzz_witness_fail
          jmp  drv_lc_fuzz_iter_end

      drv_lc_fuzz_expect_err:
          // predicate == 0: rc must be non-zero, state must == cur.
          cmp  rax, 0
          je   driver_lifecycle_fuzz_witness_fail
          mov  rdi, 0
          call driver_lifecycle_get_state
          cmp  rax, r13                            // state == cur (unchanged)?
          jne  driver_lifecycle_fuzz_witness_fail

      drv_lc_fuzz_iter_end:
          add  r15, 1
          mov  r10, 1000
          cmp  r15, r10
          jne  drv_lc_fuzz_loop

          // Cleanup: unregister slot 0 so downstream witnesses see a
          // fresh row (mirrors the deterministic FSM witness's sub-test R).
          mov  rdi, 0
          call driver_table_unregister

          // Success marker: R29 LIFECYCLE FUZZ OK.
          mov  rdi, 3                              // LEVEL_INFO
          lea  rsi, [rip + SUBSYS_BOOT]
          lea  rdx, [rip + driver_lifecycle_fuzz_ok_msg]
          call klog_s1
          jmp  driver_lifecycle_fuzz_witness_done

      driver_lifecycle_fuzz_witness_fail:
          // Emit fail marker with stage KV. stage encodes iter+1
          // (or 0 for the setup failure).
          lea  rax, [rip + _driver_lifecycle_fuzz_witness_stage]
          mov  r8,  [rax]                          // stage value (arg 4)
          mov  rdi, 1                              // LEVEL_ERROR
          lea  rsi, [rip + SUBSYS_BOOT]
          lea  rdx, [rip + driver_lifecycle_fuzz_fail_msg]
          lea  rcx, [rip + k_line]
          call klog_s1_d1

      driver_lifecycle_fuzz_witness_done:

      // ============================================================
      // R29.M5-003 (#1038) + R29.M5-004 (#1039): per-driver-process DMA
      // domain + IOMMU domain-switching contract witness — closes R29.M5.
      //
      // Two claims are under test here, and they are joined at the hip:
      //
      //   D1.b CARDINALITY (#1038). Exactly ONE KIND_DMA_DOMAIN per
      //   driver process, minted on the lifecycle FSM's single Init ->
      //   Running entry edge (driver_lifecycle_start) and revoked after
      //   the terminal Stopped state (driver_lifecycle_teardown). A
      //   second mint against the same driver slot must be REFUSED with
      //   a distinct code, not silently satisfied — a driver that could
      //   hold two domains would escape the shared-blast-radius
      //   accounting design/drivers/blob-policy.md §2.3 deliberately
      //   accepted, because the policy's whole safety argument is that a
      //   compromised blob's reach is bounded by ONE domain's mapped set.
      //
      //   SWITCHING CONTRACT (#1039). The kernel — not the driver — owns
      //   the transition from "I hold a domain capability" to "this PCI
      //   function's IOMMU context entry belongs to that domain". Seven
      //   gates, each with its own refusal code, and a three-state
      //   machine in row [+24] that #1036 reserved for exactly this.
      //
      // Real VT-d programming: NOT performed, and deliberately so. The
      // hardware path is wired to the real R22 primitive
      // vtd_context_program but stays dormant because R22 left its
      // tables unbuilt (Features.IOMMU_ENABLED = 0; vtd_root_init is
      // never called at boot; no context-table page or SLPT root is
      // allocated anywhere in the tree). iommu_ctx_commit_hw therefore
      // returns IOMMU_HW_GATED and the switch completes as a software-
      // only ownership record with hw_committed = 0 — which sub-test J
      // asserts explicitly, so the day R22.M5 calls
      // iommu_hw_backing_set the assertion flips and tells us.
      //
      // Cap-table slot allocation (fresh; distinct from 12/14/15/16..19
      // used by the R29.M1 witnesses and 24..27 used by the R29.M5-001
      // witness, all of which cleaned up after themselves):
      //   Slot 28 — KIND_MEMORY root of driver process A.
      //   Slot 29 — KIND_MEMORY root of driver process B. Separate roots
      //             are the point: teardown cascades through the dying
      //             process's memory root, and a shared root would make
      //             "A's teardown left B alone" untestable.
      //   Slot 30 — driver A's KIND_DMA_DOMAIN.
      //   Slot 31 — driver B's KIND_DMA_DOMAIN.
      //   Slot 32 — duplicate-mint target. Every mint aimed here is
      //             expected to be refused BEFORE it allocates, so the
      //             slot must read back null at the end.
      //
      // Driver-table slots 0 and 1. Slot 0 is the one the lifecycle-fuzz
      // witness above unregistered, so both start .bss-fresh.
      //
      // Sub-tests (any failure jumps to the fail marker, which reports
      // the stage number from _dma_sw_witness_stage):
      //   A. Pre-clean cap slots 28..32 and driver slots 0..1.
      //   B. Mint the two KIND_MEMORY process roots.
      //   C. Register driver A (slot 0) and driver B (slot 1); both land
      //      in Init with no domain.
      //   D. driver_lifecycle_start(A) -> OK. Asserts the whole spawn
      //      contract: state is Running, the descriptor carries a domain,
      //      the row id is 0 (low-first allocation over a table the
      //      previous witness left empty), the cap slot is 30, and
      //      cap_table[30] is a KIND_DMA_DOMAIN with R_DMA_ALL.
      //   E. CARDINALITY at the storage layer: driver_table_set_domain on
      //      a slot that already has one -> DRIVER_TABLE_DOMAIN_EXISTS,
      //      with the existing field left byte-for-byte intact.
      //   F. CARDINALITY at the lifecycle layer: hand-attach a domain to
      //      driver B (still Init), then driver_lifecycle_start(B) ->
      //      DRIVER_LIFECYCLE_ERR_DOMAIN_EXISTS. Asserts cap slot 32 is
      //      still null and NO row was consumed — the check precedes the
      //      allocation, so a refused duplicate costs nothing.
      //   G. driver_lifecycle_start(B) for real -> OK, row 1.
      //   H. Binding defaults: base == the minted BDF, mask == 0xFFFF, so
      //      the domain starts bound to exactly one function.
      //   I. First switch -> IOMMU_SW_OK; state PROGRAMMED, ctx_bdf set,
      //      hw_committed 0 (the R22 gate).
      //   J. Idempotent re-switch onto the same BDF -> IOMMU_SW_OK_NOOP.
      //   K. REFUSAL — BDF outside the binding -> ERR_BDF_UNBOUND.
      //   L. Widen the binding to the whole device (mask 0xFFF8); the
      //      same BDF is now a member and the switch re-points the domain
      //      onto it (PROGRAMMED -> PENDING -> PROGRAMMED).
      //   M. REFUSAL — context entry owned by another domain: point B's
      //      binding at the function A owns -> ERR_CTX_OWNED. Then B
      //      switches onto its own function successfully.
      //   N. REFUSAL — holder and authority: a KIND_MEMORY cap slot ->
      //      ERR_NOT_HELD; a domain cap naming a different row ->
      //      ERR_NOT_HELD; out-of-range row and out-of-range BDF ->
      //      ERR_BAD_ARG; a domain cap stripped of RIGHT_MINT ->
      //      ERR_NO_RIGHT.
      //   O. Unswitch -> OK, state NONE; unswitch again ->
      //      ERR_NOT_PROGRAMMED; re-switch so teardown has an entry to
      //      release.
      //   P. Teardown A: Running -> Stopping -> Stopped, then
      //      driver_lifecycle_teardown. Asserts the descriptor field is
      //      cleared, row 0 is freed, cap_table[30] is null — AND that
      //      driver B's row survived untouched, which is what proves the
      //      teardown cascade is scoped to the dying process's memory
      //      root rather than sweeping the table.
      //   Q. NO LEAK ACROSS CYCLES: register + start driver A again and
      //      assert it is handed row 0 back. A row that leaked would push
      //      the second spawn to row 2. Switch, stop, tear down again.
      //   R. Teardown B; row 1 freed, cap_table[31] null.
      //   S. Residue: every one of the 32 domain rows reads free, cap
      //      slot 32 never received a descriptor, and slots 28/29/32 are
      //      cleaned so the witness leaves the cap table as it found it.
      //
      // Fingerprint ordering (post-M5-003/004 landing):
      //   R29 KIND_DMA_DOMAIN OK      (R29.M5-001/002)
      //   R29 LIFECYCLE FSM OK        (R29.M2-001)
      //   R29 LIFECYCLE FUZZ OK       (R29.M2-004)
      //   R29 DMA DOMAIN SWITCH OK    <- THIS WITNESS
      // ============================================================

          // -- Sub-test A: pre-clean cap slots 28..32 (5 slots x 24 B,
          //    base = 28 * 24 = 672) and driver slots 0..1.
          mov  rax, 1
          lea  rcx, [rip + _dma_sw_witness_stage]
          mov  [rcx], rax

          mov  rax, cap_table
          add  rax, 672
          xor  rcx, rcx
          mov  [rax + 0],   rcx
          mov  [rax + 8],   rcx
          mov  [rax + 16],  rcx
          mov  [rax + 24],  rcx
          mov  [rax + 32],  rcx
          mov  [rax + 40],  rcx
          mov  [rax + 48],  rcx
          mov  [rax + 56],  rcx
          mov  [rax + 64],  rcx
          mov  [rax + 72],  rcx
          mov  [rax + 80],  rcx
          mov  [rax + 88],  rcx
          mov  [rax + 96],  rcx
          mov  [rax + 104], rcx
          mov  [rax + 112], rcx

          mov  rdi, 0
          call driver_table_unregister
          mov  rdi, 1
          call driver_table_unregister

          // -- Sub-test B: the two KIND_MEMORY process roots.
          mov  rax, 2
          lea  rcx, [rip + _dma_sw_witness_stage]
          mov  [rcx], rax

          mov  rdi, 28
          mov  rsi, 4                              // KIND_MEMORY
          mov  rdx, 0x618                          // R_DMA_ALL superset
          mov  rcx, 0
          call cap_mint_write

          mov  rdi, 29
          mov  rsi, 4
          mov  rdx, 0x618
          mov  rcx, 0
          call cap_mint_write

          // -- Sub-test C: register both driver processes.
          mov  rax, 3
          lea  rcx, [rip + _dma_sw_witness_stage]
          mov  [rcx], rax

          mov  rdi, 0
          mov  rsi, 101                            // pid
          lea  rdx, [rip + _dma_sw_witness_name]
          mov  rcx, 0
          call driver_table_register
          cmp  rax, 0
          jne  dma_sw_witness_fail

          mov  rdi, 1
          mov  rsi, 102
          lea  rdx, [rip + _dma_sw_witness_name]
          mov  rcx, 0
          call driver_table_register
          cmp  rax, 0
          jne  dma_sw_witness_fail

          // Neither slot carries a domain yet.
          mov  rax, 4
          lea  rcx, [rip + _dma_sw_witness_stage]
          mov  [rcx], rax
          mov  rdi, 0
          call driver_table_has_domain
          cmp  rax, 0
          jne  dma_sw_witness_fail
          mov  rdi, 1
          call driver_table_has_domain
          cmp  rax, 0
          jne  dma_sw_witness_fail

          // Build the two tail words through the canonical encoder.
          //   A: ctx 0x1111, bdf 0x0310 (bus 3, dev 2, fn 0), coherent.
          //   B: ctx 0x2222, bdf 0x0400 (bus 4, dev 0, fn 0), non-coherent.
          mov  rax, 5
          lea  rcx, [rip + _dma_sw_witness_stage]
          mov  [rcx], rax

          mov  rdi, 0x1111
          mov  rsi, 0x0310
          mov  rdx, 0
          call dma_tail_pack
          mov  rcx, 0xFFFFFFFFFFFFFFFF
          cmp  rax, rcx
          je   dma_sw_witness_fail
          lea  rcx, [rip + _dma_sw_witness_tail_a]
          mov  [rcx], rax

          mov  rdi, 0x2222
          mov  rsi, 0x0400
          mov  rdx, 1
          call dma_tail_pack
          mov  rcx, 0xFFFFFFFFFFFFFFFF
          cmp  rax, rcx
          je   dma_sw_witness_fail
          lea  rcx, [rip + _dma_sw_witness_tail_b]
          mov  [rcx], rax

          // -- Sub-test D: spawn driver A.
          mov  rax, 6
          lea  rcx, [rip + _dma_sw_witness_stage]
          mov  [rcx], rax

          mov  rdi, 0                              // driver slot
          mov  rsi, 30                             // cap slot for the domain
          mov  rdx, 28                             // KIND_MEMORY root
          lea  rcx, [rip + _dma_sw_witness_tail_a]
          mov  rcx, [rcx]                          // tail_word
          mov  r8,  0x100000                       // 1 MiB window ceiling
          call driver_lifecycle_start
          cmp  rax, 0
          jne  dma_sw_witness_fail

          // State is Running.
          mov  rax, 7
          lea  rcx, [rip + _dma_sw_witness_stage]
          mov  [rcx], rax
          mov  rdi, 0
          call driver_lifecycle_get_state
          cmp  rax, 1                              // DRIVER_STATE_RUNNING
          jne  dma_sw_witness_fail

          // Descriptor carries exactly one domain, row 0, cap slot 30.
          mov  rax, 8
          lea  rcx, [rip + _dma_sw_witness_stage]
          mov  [rcx], rax
          mov  rdi, 0
          call driver_table_has_domain
          cmp  rax, 1
          jne  dma_sw_witness_fail
          mov  rdi, 0
          call driver_table_read_domain_row
          cmp  rax, 0
          jne  dma_sw_witness_fail
          mov  rdi, 0
          call driver_table_read_domain_cap
          cmp  rax, 30
          jne  dma_sw_witness_fail

          // cap_table[30] is a KIND_DMA_DOMAIN with the full right set.
          mov  rax, 9
          lea  rcx, [rip + _dma_sw_witness_stage]
          mov  [rcx], rax
          mov  rax, cap_table
          add  rax, 720                            // slot 30 * 24
          mov  rcx, [rax + 0]
          mov  rdx, 0x142
          cmp  rcx, rdx
          jne  dma_sw_witness_fail
          mov  rcx, [rax + 8]
          mov  rdx, 0x618
          cmp  rcx, rdx
          jne  dma_sw_witness_fail
          mov  rcx, [rax + 16]
          cmp  rcx, 0                              // target_ptr = row 0
          jne  dma_sw_witness_fail

          // -- Sub-test E: cardinality at the storage layer.
          mov  rax, 10
          lea  rcx, [rip + _dma_sw_witness_stage]
          mov  [rcx], rax
          mov  rdi, 0
          mov  rsi, 5                              // some other row
          mov  rdx, 31                             // some other cap slot
          call driver_table_set_domain
          mov  rcx, 0xFFFFFEFC                     // DRIVER_TABLE_DOMAIN_EXISTS
          cmp  rax, rcx
          jne  dma_sw_witness_fail

          // ... and the refusal left the field untouched.
          mov  rax, 11
          lea  rcx, [rip + _dma_sw_witness_stage]
          mov  [rcx], rax
          mov  rdi, 0
          call driver_table_read_domain_row
          cmp  rax, 0
          jne  dma_sw_witness_fail
          mov  rdi, 0
          call driver_table_read_domain_cap
          cmp  rax, 30
          jne  dma_sw_witness_fail

          // -- Sub-test F: cardinality at the lifecycle layer. Driver B
          //    is still Init, so the FSM gate cannot mask the domain
          //    gate — this is the only arrangement in which the
          //    duplicate-mint refusal is observable on its own.
          mov  rax, 12
          lea  rcx, [rip + _dma_sw_witness_stage]
          mov  [rcx], rax
          mov  rdi, 1
          mov  rsi, 0                              // pretend it already has row 0
          mov  rdx, 30
          call driver_table_set_domain
          cmp  rax, 0
          jne  dma_sw_witness_fail

          mov  rdi, 1
          mov  rsi, 32                             // duplicate-mint target
          mov  rdx, 29
          lea  rcx, [rip + _dma_sw_witness_tail_b]
          mov  rcx, [rcx]
          mov  r8,  0x2000
          call driver_lifecycle_start
          mov  rcx, 0xFFFFFF05                     // ERR_DOMAIN_EXISTS
          cmp  rax, rcx
          jne  dma_sw_witness_fail

          // No descriptor was written at slot 32 and no row consumed.
          mov  rax, 13
          lea  rcx, [rip + _dma_sw_witness_stage]
          mov  [rcx], rax
          mov  rax, cap_table
          add  rax, 768                            // slot 32 * 24
          mov  rcx, [rax + 0]
          cmp  rcx, 0
          jne  dma_sw_witness_fail
          mov  rcx, [rax + 8]
          cmp  rcx, 0
          jne  dma_sw_witness_fail
          mov  rcx, [rax + 16]
          cmp  rcx, 0
          jne  dma_sw_witness_fail

          mov  rdi, 1
          call dma_tail_valid
          cmp  rax, 0
          jne  dma_sw_witness_fail

          // Undo the hand-attached field and start B for real.
          mov  rdi, 1
          call driver_table_clear_domain

          // -- Sub-test G: spawn driver B.
          mov  rax, 14
          lea  rcx, [rip + _dma_sw_witness_stage]
          mov  [rcx], rax
          mov  rdi, 1
          mov  rsi, 31
          mov  rdx, 29
          lea  rcx, [rip + _dma_sw_witness_tail_b]
          mov  rcx, [rcx]
          mov  r8,  0x2000
          call driver_lifecycle_start
          cmp  rax, 0
          jne  dma_sw_witness_fail

          mov  rdi, 1
          call driver_table_read_domain_row
          cmp  rax, 1
          jne  dma_sw_witness_fail
          mov  rdi, 1
          call driver_lifecycle_get_state
          cmp  rax, 1                              // Running
          jne  dma_sw_witness_fail

          // -- Sub-test H: binding defaults to exactly the minted BDF.
          mov  rax, 15
          lea  rcx, [rip + _dma_sw_witness_stage]
          mov  [rcx], rax
          mov  rdi, 0
          call dma_tail_decode_bind_base
          mov  rcx, 0x0310
          cmp  rax, rcx
          jne  dma_sw_witness_fail
          mov  rdi, 0
          call dma_tail_decode_bind_mask
          mov  rcx, 0xFFFF
          cmp  rax, rcx
          jne  dma_sw_witness_fail

          mov  rdi, 0
          mov  rsi, 0x0310
          call dma_bdf_in_binding
          cmp  rax, 1
          jne  dma_sw_witness_fail
          mov  rdi, 0
          mov  rsi, 0x0311
          call dma_bdf_in_binding
          cmp  rax, 0
          jne  dma_sw_witness_fail

          // Fresh row: no context entry yet.
          mov  rax, 16
          lea  rcx, [rip + _dma_sw_witness_stage]
          mov  [rcx], rax
          mov  rdi, 0
          call dma_ctx_state
          cmp  rax, 0                              // DMA_CTX_NONE
          jne  dma_sw_witness_fail

          // -- Sub-test I: the first switch.
          mov  rax, 17
          lea  rcx, [rip + _dma_sw_witness_stage]
          mov  [rcx], rax
          mov  rdi, 30                             // cap slot
          mov  rsi, 0                              // row id
          mov  rdx, 0x0310                         // bdf
          call iommu_domain_switch
          cmp  rax, 0                              // IOMMU_SW_OK
          jne  dma_sw_witness_fail

          mov  rdi, 0
          call dma_ctx_state
          cmp  rax, 2                              // DMA_CTX_PROGRAMMED
          jne  dma_sw_witness_fail
          mov  rdi, 0
          call dma_ctx_bdf
          mov  rcx, 0x0310
          cmp  rax, rcx
          jne  dma_sw_witness_fail

          // hw_committed is 0: the VT-d write is gated on the R22.M5
          // backing registration, which nothing calls yet. When R22.M5
          // lands, this assertion is what tells us the path went live.
          mov  rdi, 0
          call dma_ctx_hw
          cmp  rax, 0
          jne  dma_sw_witness_fail

          // The gate itself reports IOMMU_HW_GATED, not a failure.
          mov  rax, 18
          lea  rcx, [rip + _dma_sw_witness_stage]
          mov  [rcx], rax
          mov  rdi, 0
          mov  rsi, 0x0310
          call iommu_ctx_commit_hw
          cmp  rax, 2                              // IOMMU_HW_GATED
          jne  dma_sw_witness_fail

          // -- Sub-test J: idempotent re-switch.
          mov  rax, 19
          lea  rcx, [rip + _dma_sw_witness_stage]
          mov  [rcx], rax
          mov  rdi, 30
          mov  rsi, 0
          mov  rdx, 0x0310
          call iommu_domain_switch
          cmp  rax, 1                              // IOMMU_SW_OK_NOOP
          jne  dma_sw_witness_fail

          // -- Sub-test K: REFUSAL — BDF outside the binding.
          mov  rax, 20
          lea  rcx, [rip + _dma_sw_witness_stage]
          mov  [rcx], rax
          mov  rdi, 30
          mov  rsi, 0
          mov  rdx, 0x0311
          call iommu_domain_switch
          mov  rcx, 0xFFFFFFCB                     // ERR_BDF_UNBOUND
          cmp  rax, rcx
          jne  dma_sw_witness_fail

          // The refused switch left the row exactly as it was.
          mov  rdi, 0
          call dma_ctx_bdf
          mov  rcx, 0x0310
          cmp  rax, rcx
          jne  dma_sw_witness_fail

          // -- Sub-test L: widen the binding to the whole device, then
          //    re-point the domain onto the sibling function.
          mov  rax, 21
          lea  rcx, [rip + _dma_sw_witness_stage]
          mov  [rcx], rax
          mov  rdi, 0
          mov  rsi, 0x0310
          mov  rdx, 0xFFF8                         // all functions of dev
          call dma_domain_set_binding
          cmp  rax, 0
          jne  dma_sw_witness_fail

          mov  rdi, 0
          mov  rsi, 0x0311
          call dma_bdf_in_binding
          cmp  rax, 1
          jne  dma_sw_witness_fail

          // parent_slot must have survived the binding rewrite — the
          // cascade walk reads it, and losing it would orphan the row.
          mov  rdi, 0
          call dma_tail_decode_parent
          cmp  rax, 28
          jne  dma_sw_witness_fail

          mov  rax, 22
          lea  rcx, [rip + _dma_sw_witness_stage]
          mov  [rcx], rax
          mov  rdi, 30
          mov  rsi, 0
          mov  rdx, 0x0311
          call iommu_domain_switch
          cmp  rax, 0
          jne  dma_sw_witness_fail
          mov  rdi, 0
          call dma_ctx_state
          cmp  rax, 2                              // PROGRAMMED again
          jne  dma_sw_witness_fail
          mov  rdi, 0
          call dma_ctx_bdf
          mov  rcx, 0x0311
          cmp  rax, rcx
          jne  dma_sw_witness_fail

          // -- Sub-test M: REFUSAL — context entry owned by another
          //    domain. Point B's binding at the function A owns.
          mov  rax, 23
          lea  rcx, [rip + _dma_sw_witness_stage]
          mov  [rcx], rax
          mov  rdi, 1
          mov  rsi, 0x0311
          mov  rdx, 0xFFFF
          call dma_domain_set_binding
          cmp  rax, 0
          jne  dma_sw_witness_fail

          mov  rdi, 31
          mov  rsi, 1
          mov  rdx, 0x0311
          call iommu_domain_switch
          mov  rcx, 0xFFFFFFCA                     // ERR_CTX_OWNED
          cmp  rax, rcx
          jne  dma_sw_witness_fail

          // B's own row is untouched by the refusal.
          mov  rdi, 1
          call dma_ctx_state
          cmp  rax, 0                              // still DMA_CTX_NONE
          jne  dma_sw_witness_fail

          // Restore B's binding and switch it onto its own function.
          mov  rax, 24
          lea  rcx, [rip + _dma_sw_witness_stage]
          mov  [rcx], rax
          mov  rdi, 1
          mov  rsi, 0x0400
          mov  rdx, 0xFFFF
          call dma_domain_set_binding
          cmp  rax, 0
          jne  dma_sw_witness_fail

          mov  rdi, 31
          mov  rsi, 1
          mov  rdx, 0x0400
          call iommu_domain_switch
          cmp  rax, 0
          jne  dma_sw_witness_fail
          mov  rdi, 1
          call dma_ctx_state
          cmp  rax, 2
          jne  dma_sw_witness_fail

          // -- Sub-test N: REFUSAL — holder and authority.
          //    (a) A KIND_MEMORY cap is not a domain cap.
          mov  rax, 25
          lea  rcx, [rip + _dma_sw_witness_stage]
          mov  [rcx], rax
          mov  rdi, 28
          mov  rsi, 0
          mov  rdx, 0x0310
          call iommu_domain_switch
          mov  rcx, 0xFFFFFFCE                     // ERR_NOT_HELD
          cmp  rax, rcx
          jne  dma_sw_witness_fail

          //    (b) A domain cap that names a different row.
          mov  rax, 26
          lea  rcx, [rip + _dma_sw_witness_stage]
          mov  [rcx], rax
          mov  rdi, 30                             // cap for row 0
          mov  rsi, 1                              // asked about row 1
          mov  rdx, 0x0400
          call iommu_domain_switch
          mov  rcx, 0xFFFFFFCE
          cmp  rax, rcx
          jne  dma_sw_witness_fail

          //    (c) Out-of-range row id and out-of-range BDF.
          mov  rax, 27
          lea  rcx, [rip + _dma_sw_witness_stage]
          mov  [rcx], rax
          mov  rdi, 30
          mov  rsi, 99
          mov  rdx, 0x0310
          call iommu_domain_switch
          mov  rcx, 0xFFFFFFCF                     // ERR_BAD_ARG
          cmp  rax, rcx
          jne  dma_sw_witness_fail

          mov  rdi, 30
          mov  rsi, 0
          mov  rdx, 0x10000                        // >= 2^16
          call iommu_domain_switch
          mov  rcx, 0xFFFFFFCF
          cmp  rax, rcx
          jne  dma_sw_witness_fail

          //    (d) A domain cap stripped of RIGHT_MINT. Switching is a
          //        MINT-class authority; an INVOKE-only holder may read
          //        the domain but may not re-point hardware with it.
          mov  rax, 28
          lea  rcx, [rip + _dma_sw_witness_stage]
          mov  [rcx], rax
          mov  rax, cap_table
          add  rax, 720                            // slot 30
          mov  rcx, 0x418                          // R_DMA_ALL minus MINT
          mov  [rax + 8], rcx

          mov  rdi, 30
          mov  rsi, 0
          mov  rdx, 0x0310
          call iommu_domain_switch
          mov  rcx, 0xFFFFFFCD                     // ERR_NO_RIGHT
          cmp  rax, rcx
          jne  dma_sw_witness_fail

          mov  rax, cap_table
          add  rax, 720
          mov  rcx, 0x618                          // restore
          mov  [rax + 8], rcx

          // -- Sub-test O: unswitch, double-unswitch, re-switch.
          mov  rax, 29
          lea  rcx, [rip + _dma_sw_witness_stage]
          mov  [rcx], rax
          mov  rdi, 30
          mov  rsi, 0
          call iommu_domain_unswitch
          cmp  rax, 0
          jne  dma_sw_witness_fail
          mov  rdi, 0
          call dma_ctx_state
          cmp  rax, 0                              // DMA_CTX_NONE
          jne  dma_sw_witness_fail
          mov  rdi, 0
          call dma_ctx_bdf
          cmp  rax, 0                              // cleared, not stale
          jne  dma_sw_witness_fail

          mov  rax, 30
          lea  rcx, [rip + _dma_sw_witness_stage]
          mov  [rcx], rax
          mov  rdi, 30
          mov  rsi, 0
          call iommu_domain_unswitch
          mov  rcx, 0xFFFFFFC8                     // ERR_NOT_PROGRAMMED
          cmp  rax, rcx
          jne  dma_sw_witness_fail

          // Re-switch so teardown has a live context entry to release.
          mov  rdi, 30
          mov  rsi, 0
          mov  rdx, 0x0310
          call iommu_domain_switch
          cmp  rax, 0
          jne  dma_sw_witness_fail

          // -- Sub-test P: tear driver A down.
          //    Teardown before the terminal state must be refused.
          mov  rax, 31
          lea  rcx, [rip + _dma_sw_witness_stage]
          mov  [rcx], rax
          mov  rdi, 0
          call driver_lifecycle_teardown
          mov  rcx, 0xFFFFFF06                     // ERR_NOT_STOPPED
          cmp  rax, rcx
          jne  dma_sw_witness_fail

          mov  rdi, 0
          mov  rsi, 4                              // Stopping
          call driver_lifecycle_transition
          cmp  rax, 0
          jne  dma_sw_witness_fail
          mov  rdi, 0
          mov  rsi, 5                              // Stopped
          call driver_lifecycle_transition
          cmp  rax, 0
          jne  dma_sw_witness_fail

          mov  rax, 32
          lea  rcx, [rip + _dma_sw_witness_stage]
          mov  [rcx], rax
          mov  rdi, 0
          call driver_lifecycle_teardown
          cmp  rax, 0
          jne  dma_sw_witness_fail

          // Descriptor field cleared, row freed, capability gone.
          mov  rax, 33
          lea  rcx, [rip + _dma_sw_witness_stage]
          mov  [rcx], rax
          mov  rdi, 0
          call driver_table_has_domain
          cmp  rax, 0
          jne  dma_sw_witness_fail
          mov  rdi, 0
          call dma_tail_valid
          cmp  rax, 0
          jne  dma_sw_witness_fail

          mov  rax, cap_table
          add  rax, 720                            // slot 30
          mov  rcx, [rax + 0]
          cmp  rcx, 0
          jne  dma_sw_witness_fail
          mov  rcx, [rax + 8]
          cmp  rcx, 0
          jne  dma_sw_witness_fail
          mov  rcx, [rax + 16]
          cmp  rcx, 0
          jne  dma_sw_witness_fail

          // Driver B is untouched — the cascade is scoped to A's memory
          // root (slot 28), not to the domain table at large.
          mov  rax, 34
          lea  rcx, [rip + _dma_sw_witness_stage]
          mov  [rcx], rax
          mov  rdi, 1
          call dma_tail_valid
          cmp  rax, 1
          jne  dma_sw_witness_fail
          mov  rdi, 1
          call dma_ctx_state
          cmp  rax, 2                              // still PROGRAMMED
          jne  dma_sw_witness_fail
          mov  rdi, 1
          call driver_table_has_domain
          cmp  rax, 1
          jne  dma_sw_witness_fail

          mov  rdi, 0
          call driver_table_unregister

          // -- Sub-test Q: second spawn/exit cycle — no row leak.
          mov  rax, 35
          lea  rcx, [rip + _dma_sw_witness_stage]
          mov  [rcx], rax
          mov  rdi, 0
          mov  rsi, 103                            // new pid, same slot
          lea  rdx, [rip + _dma_sw_witness_name]
          mov  rcx, 0
          call driver_table_register
          cmp  rax, 0
          jne  dma_sw_witness_fail

          mov  rdi, 0
          mov  rsi, 30
          mov  rdx, 28
          lea  rcx, [rip + _dma_sw_witness_tail_a]
          mov  rcx, [rcx]
          mov  r8,  0x100000
          call driver_lifecycle_start
          cmp  rax, 0
          jne  dma_sw_witness_fail

          // Row 0 handed back. A leaked row would push this to 2.
          mov  rax, 36
          lea  rcx, [rip + _dma_sw_witness_stage]
          mov  [rcx], rax
          mov  rdi, 0
          call driver_table_read_domain_row
          cmp  rax, 0
          jne  dma_sw_witness_fail

          // The recycled row starts with a clean context-entry state.
          mov  rdi, 0
          call dma_ctx_state
          cmp  rax, 0
          jne  dma_sw_witness_fail

          mov  rdi, 30
          mov  rsi, 0
          mov  rdx, 0x0310
          call iommu_domain_switch
          cmp  rax, 0
          jne  dma_sw_witness_fail

          mov  rax, 37
          lea  rcx, [rip + _dma_sw_witness_stage]
          mov  [rcx], rax
          mov  rdi, 0
          mov  rsi, 4
          call driver_lifecycle_transition
          cmp  rax, 0
          jne  dma_sw_witness_fail
          mov  rdi, 0
          mov  rsi, 5
          call driver_lifecycle_transition
          cmp  rax, 0
          jne  dma_sw_witness_fail
          mov  rdi, 0
          call driver_lifecycle_teardown
          cmp  rax, 0
          jne  dma_sw_witness_fail

          mov  rdi, 0
          call dma_tail_valid
          cmp  rax, 0
          jne  dma_sw_witness_fail
          mov  rdi, 0
          call driver_table_has_domain
          cmp  rax, 0
          jne  dma_sw_witness_fail

          mov  rdi, 0
          call driver_table_unregister

          // -- Sub-test R: tear driver B down.
          mov  rax, 38
          lea  rcx, [rip + _dma_sw_witness_stage]
          mov  [rcx], rax
          mov  rdi, 1
          mov  rsi, 4
          call driver_lifecycle_transition
          cmp  rax, 0
          jne  dma_sw_witness_fail
          mov  rdi, 1
          mov  rsi, 5
          call driver_lifecycle_transition
          cmp  rax, 0
          jne  dma_sw_witness_fail
          mov  rdi, 1
          call driver_lifecycle_teardown
          cmp  rax, 0
          jne  dma_sw_witness_fail

          mov  rdi, 1
          call dma_tail_valid
          cmp  rax, 0
          jne  dma_sw_witness_fail

          mov  rax, cap_table
          add  rax, 744                            // slot 31
          mov  rcx, [rax + 0]
          cmp  rcx, 0
          jne  dma_sw_witness_fail
          mov  rcx, [rax + 8]
          cmp  rcx, 0
          jne  dma_sw_witness_fail
          mov  rcx, [rax + 16]
          cmp  rcx, 0
          jne  dma_sw_witness_fail

          mov  rdi, 1
          call driver_table_unregister

          // -- Sub-test S: residue. Every domain row must read free.
          mov  rax, 39
          lea  rcx, [rip + _dma_sw_witness_stage]
          mov  [rcx], rax
          lea  rcx, [rip + _dma_sw_witness_cursor]
          xor  rax, rax
          mov  [rcx], rax

      dma_sw_residue_loop:
          lea  rcx, [rip + _dma_sw_witness_cursor]
          mov  rdi, [rcx]
          cmp  rdi, 32                             // DMA_DOMAIN_MAX
          jae  dma_sw_residue_done
          call dma_tail_valid
          cmp  rax, 0
          jne  dma_sw_witness_fail
          lea  rcx, [rip + _dma_sw_witness_cursor]
          mov  rax, [rcx]
          add  rax, 1
          mov  [rcx], rax
          jmp  dma_sw_residue_loop

      dma_sw_residue_done:
          // Slot 32 never received a descriptor.
          mov  rax, 40
          lea  rcx, [rip + _dma_sw_witness_stage]
          mov  [rcx], rax
          mov  rax, cap_table
          add  rax, 768
          mov  rcx, [rax + 0]
          cmp  rcx, 0
          jne  dma_sw_witness_fail

          // Leave the cap table as we found it.
          mov  rax, cap_table
          add  rax, 672
          xor  rcx, rcx
          mov  [rax + 0],  rcx
          mov  [rax + 8],  rcx
          mov  [rax + 16], rcx
          mov  [rax + 24], rcx
          mov  [rax + 32], rcx
          mov  [rax + 40], rcx

          // Success marker: R29 DMA DOMAIN SWITCH OK.
          mov  rdi, 3                              // LEVEL_INFO
          lea  rsi, [rip + SUBSYS_BOOT]
          lea  rdx, [rip + dma_domain_switch_ok_msg]
          call klog_s1
          jmp  dma_sw_witness_done

      dma_sw_witness_fail:
          // Emit fail marker with the _dma_sw_witness_stage number as a
          // decimal KV — same discipline as kind_dma_witness_fail.
          lea  rax, [rip + _dma_sw_witness_stage]
          mov  r8,  [rax]                          // r8 = stage value (arg 4)
          mov  rdi, 1                              // LEVEL_ERROR
          lea  rsi, [rip + SUBSYS_BOOT]
          lea  rdx, [rip + dma_domain_switch_fail_msg]
          lea  rcx, [rip + k_line]
          call klog_s1_d1

      dma_sw_witness_done:

      // ============================================================
      // R20b.M1-002 (#1553): endpoint_table + payload_arena witness.
      //
      // Second sub-issue of the R20b userspace-server substrate cluster.
      // Exercises the endpoint_alloc/endpoint_free/endpoint_lookup
      // primitives on _ipc_endpoint_table (src/kernel/core/ipc/
      // endpoint_table.pdx) and payload_buf_pa_for on _ipc_payload_arena
      // (src/kernel/core/ipc/payload_arena.pdx). Both storage regions
      // sit in .bss and are freshly zero-initialized at this point in
      // boot (no earlier code touches them; this witness introduces
      // them).
      //
      // Sub-tests (executed in order; any failure jumps to fail marker):
      //   A. Alloc 128 endpoints; assert each returned id == i (low-first
      //      scan over fresh .bss must hand out 0, 1, ..., 127 in order).
      //      Proves 128-slot capacity + distinctness.
      //   B. One more alloc returns ENDPOINT_ALLOC_NONE (0xFFFFFFFFFFFFFFFF)
      //      — table exhausted.
      //   C. endpoint_lookup(0) != 0 — live endpoint returns row PA.
      //   D. endpoint_lookup(200) == 0 — out-of-range returns NULL.
      //   E. Free all 128 endpoints; endpoint_lookup(id) == 0 after each
      //      free — proves free discipline reopens the slot.
      //   F. Alloc 128 again; assert each returned id == i — proves the
      //      round-trip (alloc-all -> free-all -> alloc-all) works.
      //   G. Cleanup: free all 128 endpoints so downstream tests see a
      //      clean table.
      //   H. payload_buf_pa_for(0) is 4 KiB-aligned (low 12 bits == 0).
      //   I. payload_buf_pa_for(127) is 4 KiB-aligned.
      //   J. Adjacent contiguity: pa(1) - pa(0) == 4096.
      //   K. Long-range contiguity: pa(64) - pa(0) == 64 * 4096 = 0x40000.
      //
      // Register plan across sub-tests:
      //   r15 = loop counter (id in fill/free/refill/cleanup loops)
      //   r14 = temp for exhaustion sentinel / alignment mask
      //   r13 = temp for pa(0) reference in contiguity checks
      //   r12 = temp for expected delta in sub-test K
      // ============================================================
      endpoint_alloc_witness:
          // -- Sub-test A: alloc 128, each returns i.
          xor  r15, r15                            // i = 0
      eaw_fill_loop:
          call endpoint_alloc
          cmp  rax, r15
          jne  endpoint_alloc_witness_fail
          add  r15, 1
          cmp  r15, 128
          jne  eaw_fill_loop

          // -- Sub-test B: alloc once more -> ENDPOINT_ALLOC_NONE.
          call endpoint_alloc
          mov  r14, 0xFFFFFFFFFFFFFFFF             // ENDPOINT_ALLOC_NONE
          cmp  rax, r14
          jne  endpoint_alloc_witness_fail

          // -- Sub-test C: lookup(0) != 0.
          xor  rdi, rdi
          call endpoint_lookup
          cmp  rax, 0
          je   endpoint_alloc_witness_fail

          // -- Sub-test D: lookup(200) == 0 (out of range).
          mov  rdi, 200
          call endpoint_lookup
          cmp  rax, 0
          jne  endpoint_alloc_witness_fail

          // -- Sub-test E: free all 128; lookup(id) == 0 after each free.
          xor  r15, r15
      eaw_free_loop:
          mov  rdi, r15
          call endpoint_free
          mov  rdi, r15
          call endpoint_lookup
          cmp  rax, 0
          jne  endpoint_alloc_witness_fail
          add  r15, 1
          cmp  r15, 128
          jne  eaw_free_loop

          // -- Sub-test F: alloc 128 again; each returns i.
          xor  r15, r15
      eaw_refill_loop:
          call endpoint_alloc
          cmp  rax, r15
          jne  endpoint_alloc_witness_fail
          add  r15, 1
          cmp  r15, 128
          jne  eaw_refill_loop

          // -- Sub-test G: cleanup — free all so downstream tests see clean state.
          xor  r15, r15
      eaw_cleanup_loop:
          mov  rdi, r15
          call endpoint_free
          add  r15, 1
          cmp  r15, 128
          jne  eaw_cleanup_loop

          // -- Sub-test H: payload_buf_pa_for(0) is 4 KiB-aligned.
          xor  rdi, rdi
          call payload_buf_pa_for
          mov  r14, rax
          mov  r13, 0xFFF                          // 4 KiB alignment mask
          and  r14, r13
          cmp  r14, 0
          jne  endpoint_alloc_witness_fail

          // -- Sub-test I: payload_buf_pa_for(127) is 4 KiB-aligned.
          mov  rdi, 127
          call payload_buf_pa_for
          mov  r14, rax
          mov  r13, 0xFFF
          and  r14, r13
          cmp  r14, 0
          jne  endpoint_alloc_witness_fail

          // -- Sub-test J: pa(1) - pa(0) == 4096.
          xor  rdi, rdi
          call payload_buf_pa_for
          mov  r13, rax                            // r13 = pa(0)
          mov  rdi, 1
          call payload_buf_pa_for
          sub  rax, r13
          cmp  rax, 4096
          jne  endpoint_alloc_witness_fail

          // -- Sub-test K: pa(64) - pa(0) == 64 * 4096 = 0x40000.
          xor  rdi, rdi
          call payload_buf_pa_for
          mov  r13, rax                            // r13 = pa(0)
          mov  rdi, 64
          call payload_buf_pa_for
          sub  rax, r13
          mov  r12, 0x40000                        // 64 * 4096
          cmp  rax, r12
          jne  endpoint_alloc_witness_fail

          // Success marker: R20b ENDPOINT ALLOC OK
          mov  rdi, 3                              // LEVEL_INFO
          lea  rsi, [rip + SUBSYS_BOOT]
          lea  rdx, [rip + endpoint_alloc_ok_msg]
          call klog_s1
          jmp  endpoint_alloc_witness_done

      endpoint_alloc_witness_fail:
          mov  rdi, 1                              // LEVEL_ERROR
          lea  rsi, [rip + SUBSYS_BOOT]
          lea  rdx, [rip + endpoint_alloc_fail_msg]
          call klog_s1

      endpoint_alloc_witness_done:

      // ============================================================
      // R20b.M1-003 (#1554): svc_broker table + register/lookup witness.
      //
      // Third + final sub-issue of the R20b.M1 cluster — closes M1.
      // Exercises the name-resolution layer (svc_register / svc_lookup)
      // built on top of _svc_broker_table (32 rows × 48 B) in
      // src/kernel/core/ipc/svc_broker.pdx. Per design/ipc/
      // userspace-server-substrate.md §3.3, the broker publishes
      // svc.<name> → endpoint_id bindings so downstream clients can
      // find named endpoints without hard-coding numeric ids.
      //
      // Sub-tests (executed in order; any failure jumps to fail marker):
      //   A. svc_register("svc.test", len=8, endpoint_id=7) →
      //      SVC_REGISTER_OK (0). Fresh table, first row claim.
      //   B. svc_register("svc.test", len=8, endpoint_id=9) →
      //      SVC_REGISTER_ERR_DUPLICATE (2). Same name, different
      //      endpoint_id → refused with distinct error.
      //   C. svc_register("svc.test", len=0, endpoint_id=5) →
      //      SVC_REGISTER_ERR_NAME_LEN (1). Zero length rejected.
      //   D. svc_register("<32-byte name>", len=32, endpoint_id=5) →
      //      SVC_REGISTER_ERR_NAME_LEN (1). Over-31 length rejected.
      //      Buffer is exactly 32 bytes to keep the read safe if a
      //      future implementation reads before gating (belt-and-braces).
      //   E. svc_lookup("svc.test", len=8) → 7 (endpoint_id from A).
      //      Round-trip register → lookup.
      //   F. svc_lookup("svc.other", len=9) → SVC_LOOKUP_NONE
      //      (0xFFFFFFFFFFFFFFFF). Not-registered name → distinct
      //      sentinel.
      //   G. svc_register("svc.a", len=5, endpoint_id=42) →
      //      SVC_REGISTER_OK (0), then svc_lookup("svc.a", len=5) →
      //      42. Proves the table supports > 1 registration and the
      //      lookup discipline discriminates between overlapping
      //      names ("svc.a" not aliased to "svc.test").
      //   H. svc_lookup("svc.test", len=0) → SVC_LOOKUP_NONE.
      //      Symmetric zero-length gate on the lookup side.
      //
      // Register plan across sub-tests: no persistent state carried
      // across sub-tests — each loads its own rdi/rsi/rdx and checks
      // rax immediately. r14 holds the SVC_LOOKUP_NONE sentinel for
      // the imm64 comparisons in sub-tests F/H.
      //
      // Placement: runs right after endpoint_alloc_witness (closes M1
      // in order M1-001 → M1-002 → M1-003) and before sys_dmesg_witness.
      // ============================================================
      broker_witness:
          // -- Sub-test A: register("svc.test", 8, 7) == 0.
          lea  rdi, [rip + _svc_broker_witness_name_test]
          mov  rsi, 8
          mov  rdx, 7
          call svc_register
          cmp  rax, 0                              // SVC_REGISTER_OK
          jne  broker_witness_fail

          // -- Sub-test B: register(same name, 8, 9) == 2 (DUP).
          lea  rdi, [rip + _svc_broker_witness_name_test]
          mov  rsi, 8
          mov  rdx, 9
          call svc_register
          cmp  rax, 2                              // SVC_REGISTER_ERR_DUPLICATE
          jne  broker_witness_fail

          // -- Sub-test C: register(name, 0, 5) == 1 (NAME_LEN).
          lea  rdi, [rip + _svc_broker_witness_name_test]
          mov  rsi, 0
          mov  rdx, 5
          call svc_register
          cmp  rax, 1                              // SVC_REGISTER_ERR_NAME_LEN
          jne  broker_witness_fail

          // -- Sub-test D: register(32-byte name, 32, 5) == 1 (NAME_LEN).
          lea  rdi, [rip + _svc_broker_witness_name_long]
          mov  rsi, 32
          mov  rdx, 5
          call svc_register
          cmp  rax, 1                              // SVC_REGISTER_ERR_NAME_LEN
          jne  broker_witness_fail

          // -- Sub-test E: lookup("svc.test", 8) == 7.
          lea  rdi, [rip + _svc_broker_witness_name_test]
          mov  rsi, 8
          call svc_lookup
          cmp  rax, 7
          jne  broker_witness_fail

          // -- Sub-test F: lookup("svc.other", 9) == SVC_LOOKUP_NONE.
          lea  rdi, [rip + _svc_broker_witness_name_other]
          mov  rsi, 9
          call svc_lookup
          mov  r14, 0xFFFFFFFFFFFFFFFF             // SVC_LOOKUP_NONE
          cmp  rax, r14
          jne  broker_witness_fail

          // -- Sub-test G: register("svc.a", 5, 42) then lookup returns 42.
          lea  rdi, [rip + _svc_broker_witness_name_short]
          mov  rsi, 5
          mov  rdx, 42
          call svc_register
          cmp  rax, 0                              // SVC_REGISTER_OK
          jne  broker_witness_fail

          lea  rdi, [rip + _svc_broker_witness_name_short]
          mov  rsi, 5
          call svc_lookup
          cmp  rax, 42
          jne  broker_witness_fail

          // -- Sub-test H: lookup with len=0 -> SVC_LOOKUP_NONE.
          lea  rdi, [rip + _svc_broker_witness_name_test]
          mov  rsi, 0
          call svc_lookup
          mov  r14, 0xFFFFFFFFFFFFFFFF
          cmp  rax, r14
          jne  broker_witness_fail

          // Success marker: R20b BROKER OK.
          mov  rdi, 3                              // LEVEL_INFO
          lea  rsi, [rip + SUBSYS_BOOT]
          lea  rdx, [rip + broker_ok_msg]
          call klog_s1
          jmp  broker_witness_done

      broker_witness_fail:
          mov  rdi, 1                              // LEVEL_ERROR
          lea  rsi, [rip + SUBSYS_BOOT]
          lea  rdx, [rip + broker_fail_msg]
          call klog_s1

      broker_witness_done:

      // ============================================================
      // R20b.M2-001 (#1555): 8-byte message header + frame primitives
      // witness — opens the R20b.M2 (framed variable-length IPC) branch
      // on top of the M1 substrate.
      //
      // Exercises frame_encode / frame_decode / frame_hdr_{op,ver,flags,
      // payload_len} in src/kernel/core/ipc/frame.pdx. Per
      // design/ipc/acpi-supervisor-schema.md §3 + design/ipc/userspace-
      // server-substrate.md §4.1, the header layout is:
      //   +0  op          u8
      //   +1  ver         u8
      //   +2  flags       u16 LE
      //   +4  payload_len u32 LE  (<= 4088)
      //
      // Because x86-64 stores u64 in native LE, the packed header IS
      // byte-identical to a single u64 store at buf. frame_encode
      // composes the packed u64 in rax and writes once; frame_decode
      // is `mov rax, [buf]`. The witness proves this shape at three
      // levels: (a) byte-level field placement via direct u8/u16/u32
      // reads out of the scratch buf, (b) packed-u64 round-trip via
      // frame_decode, (c) field-level round-trip via the frame_hdr_*
      // accessors.
      //
      // Sub-tests (executed in order; any failure jumps to fail marker):
      //
      //   A. Pre-fill _frame_witness_buf with 0xDEADBEEFCAFEBABE (sentinel).
      //      frame_encode(buf, op=0x03, ver=1, flags=0, payload_len=0x100)
      //      → FRAME_ENCODE_OK (0). 0x100 = 256, well inside the 4088-byte
      //      FRAME_MAX_PAYLOAD gate.
      //
      //   B. Byte-level field placement — direct u8/u16/u32 reads from
      //      the scratch buf must match §3 byte layout:
      //        [+0] u8  == 0x03    (op)
      //        [+1] u8  == 0x01    (ver)
      //        [+2] u16 == 0x0000  (flags LE)
      //        [+4] u32 == 0x0000_0100 (payload_len LE)
      //      Proves the encoder writes each field at its declared offset.
      //
      //   C. Packed-u64 round-trip: frame_decode(buf) returns the exact
      //      packed u64 = (0x0000_0100 << 32) | 0x0103 = 0x0000_0100_0000_0103.
      //      Single 8-byte load recovers the composed header bit-exact —
      //      the property that lets the M2 send path cache pending_hdr as
      //      a single u64 field.
      //
      //   D. Field-level round-trip via accessors:
      //        frame_hdr_op(hdr)          == 0x03
      //        frame_hdr_ver(hdr)         == 0x01
      //        frame_hdr_flags(hdr)       == 0x0000
      //        frame_hdr_payload_len(hdr) == 0x0000_0100
      //      Proves each field can be extracted independently from the
      //      packed u64 with the right shift/mask.
      //
      //   E. Boundary case: payload_len == FRAME_MAX_PAYLOAD (4088)
      //      succeeds. Re-encode with (op=0x83, ver=2, flags=0xABCD,
      //      payload_len=4088) → FRAME_ENCODE_OK (0). Reply-side op with
      //      bit 7 set (0x83 = 0x03 | FRAME_OP_REPLY_BIT) demonstrates
      //      the request/reply symmetry of the header layout.
      //
      //   F. Boundary round-trip: frame_hdr_payload_len(decode(buf)) ==
      //      4088. Confirms the u32-max-valid boundary encodes and
      //      decodes without truncation.
      //
      //   G. Over-limit rejection: frame_encode with payload_len = 4089
      //      → FRAME_ENCODE_ERR_PAYLOAD_LEN (1). Distinct error code per
      //      the design doc convention (§5.11 -E2BIG).
      //
      //   H. buf-not-modified property: after the G rejection, the buf
      //      still holds the E-boundary header (op=0x83, ver=2,
      //      flags=0xABCD, payload_len=4088). Rejected encodes MUST NOT
      //      touch the buffer — callers must be able to hand the same
      //      buf to a retry without cleanup. Verified via frame_decode
      //      returning the boundary-case packed u64.
      //
      // Register plan across sub-tests:
      //   r15 = scratch for decoded values / expected values.
      //   r14 = temp for large imm constants (packed u64 expected,
      //         0xDEAD sentinel).
      //   No callee-save preserved across sub-tests — each loads its own
      //   rdi..r8 and checks rax immediately.
      //
      // Placement: runs right after broker_witness (closes M1) and
      // before sys_dmesg_witness. Opens the M2 milestone.
      // ============================================================
      frame_witness:
          // Record most-recent sub-test index in _frame_witness_stage so
          // the fail path can log which sub-test tripped. Numeric stages:
          //   0 = A (encode ok)                    5 = D3 (accessor flags)
          //   1 = B1..B4 (byte-level layout)       6 = D4 (accessor payload_len)
          //   2 = C (packed-u64 round-trip)        7 = E (boundary encode)
          //   3 = D1 (accessor op)                 8 = F (boundary decode)
          //   4 = D2 (accessor ver)                9 = G (over-limit reject)
          //                                       10 = H (buf-not-modified)

          // -- Sub-test A: pre-fill buf with sentinel, then encode.
          mov  r13, 0                              // stage 0
          lea  rax, [rip + _frame_witness_stage]
          mov  [rax], r13

          lea  rdi, [rip + _frame_witness_buf]
          mov  r14, 0xDEADBEEFCAFEBABE
          mov  [rdi], r14

          lea  rdi, [rip + _frame_witness_buf]
          mov  rsi, 0x03                           // op   = ACPI_OP_GET_MCFG
          mov  rdx, 1                              // ver  = 1
          mov  rcx, 0                              // flags = 0
          mov  r8,  0x0100                         // payload_len (256 <= 4088)
          call frame_encode
          cmp  rax, 0                              // FRAME_ENCODE_OK
          jne  frame_witness_fail

          // -- Sub-test B: byte-level field placement.
          mov  r13, 1
          lea  rax, [rip + _frame_witness_stage]
          mov  [rax], r13

          lea  rdi, [rip + _frame_witness_buf]

          // [+0] u8 op == 0x03
          xor  rax, rax
          mov_b rax, [rdi + 0]
          cmp  rax, 0x03
          jne  frame_witness_fail

          // [+1] u8 ver == 0x01
          xor  rax, rax
          mov_b rax, [rdi + 1]
          cmp  rax, 0x01
          jne  frame_witness_fail

          // [+2] u16 flags == 0x0000
          xor  rax, rax
          mov_w rax, [rdi + 2]
          cmp  rax, 0
          jne  frame_witness_fail

          // [+4] u32 payload_len == 0x0000_0100
          xor  rax, rax
          mov eax, [rdi + 4]
          cmp  rax, 0x0100
          jne  frame_witness_fail

          // -- Sub-test C: packed-u64 round-trip via frame_decode.
          mov  r13, 2
          lea  rax, [rip + _frame_witness_stage]
          mov  [rax], r13

          lea  rdi, [rip + _frame_witness_buf]
          call frame_decode
          mov  r15, rax                            // r15 = decoded hdr
          mov  r14, 0x0000010000000103             // expected packed u64
          cmp  r15, r14
          jne  frame_witness_fail

          // -- Sub-test D: field-level round-trip via accessors.
          //    hdr still in r15; each accessor takes hdr as arg.

          //    frame_hdr_op(hdr) == 0x03
          mov  r13, 3
          lea  rax, [rip + _frame_witness_stage]
          mov  [rax], r13

          mov  rdi, r15
          call frame_hdr_op
          cmp  rax, 0x03
          jne  frame_witness_fail

          //    frame_hdr_ver(hdr) == 0x01
          mov  r13, 4
          lea  rax, [rip + _frame_witness_stage]
          mov  [rax], r13

          mov  rdi, r15
          call frame_hdr_ver
          cmp  rax, 0x01
          jne  frame_witness_fail

          //    frame_hdr_flags(hdr) == 0x0000
          mov  r13, 5
          lea  rax, [rip + _frame_witness_stage]
          mov  [rax], r13

          mov  rdi, r15
          call frame_hdr_flags
          cmp  rax, 0
          jne  frame_witness_fail

          //    frame_hdr_payload_len(hdr) == 0x0000_0100
          mov  r13, 6
          lea  rax, [rip + _frame_witness_stage]
          mov  [rax], r13

          mov  rdi, r15
          call frame_hdr_payload_len
          cmp  rax, 0x0100
          jne  frame_witness_fail

          // -- Sub-test E: boundary encode (payload_len == FRAME_MAX_PAYLOAD).
          mov  r13, 7
          lea  rax, [rip + _frame_witness_stage]
          mov  [rax], r13

          lea  rdi, [rip + _frame_witness_buf]
          mov  rsi, 0x83                           // op | FRAME_OP_REPLY_BIT
          mov  rdx, 2                              // ver
          mov  rcx, 0xABCD                         // flags
          mov  r8,  4088                           // FRAME_MAX_PAYLOAD
          call frame_encode
          cmp  rax, 0                              // FRAME_ENCODE_OK
          jne  frame_witness_fail

          // -- Sub-test F: boundary round-trip via payload_len accessor.
          mov  r13, 8
          lea  rax, [rip + _frame_witness_stage]
          mov  [rax], r13

          lea  rdi, [rip + _frame_witness_buf]
          call frame_decode
          mov  r15, rax                            // r15 = boundary hdr
          mov  rdi, r15
          call frame_hdr_payload_len
          cmp  rax, 4088
          jne  frame_witness_fail

          // -- Sub-test G: over-limit rejection.
          mov  r13, 9
          lea  rax, [rip + _frame_witness_stage]
          mov  [rax], r13

          lea  rdi, [rip + _frame_witness_buf]
          mov  rsi, 0x03
          mov  rdx, 1
          mov  rcx, 0
          mov  r8,  4089                           // FRAME_MAX_PAYLOAD + 1
          call frame_encode
          cmp  rax, 1                              // FRAME_ENCODE_ERR_PAYLOAD_LEN
          jne  frame_witness_fail

          // -- Sub-test H: buf-not-modified after rejection.
          //    Decode again; must still be the sub-test E boundary hdr.
          mov  r13, 10
          lea  rax, [rip + _frame_witness_stage]
          mov  [rax], r13

          lea  rdi, [rip + _frame_witness_buf]
          call frame_decode
          mov  r15, rax

          //    op still 0x83
          mov  rdi, r15
          call frame_hdr_op
          cmp  rax, 0x83
          jne  frame_witness_fail

          //    ver still 0x02
          mov  rdi, r15
          call frame_hdr_ver
          cmp  rax, 0x02
          jne  frame_witness_fail

          //    flags still 0xABCD
          mov  rdi, r15
          call frame_hdr_flags
          cmp  rax, 0xABCD
          jne  frame_witness_fail

          //    payload_len still 4088
          mov  rdi, r15
          call frame_hdr_payload_len
          cmp  rax, 4088
          jne  frame_witness_fail

          // Success marker: R20b FRAME HDR OK.
          mov  rdi, 3                              // LEVEL_INFO
          lea  rsi, [rip + SUBSYS_BOOT]
          lea  rdx, [rip + frame_hdr_ok_msg]
          call klog_s1
          jmp  frame_witness_done

      frame_witness_fail:
          // Emit "R20b FRAME HDR FAIL" with the sub-test stage as a
          // decimal KV so the debugger can see which sub-test tripped.
          //   klog_s1_d1(LEVEL_ERROR, SUBSYS_BOOT, frame_hdr_fail_msg,
          //              k_stage, stage_value)
          lea  rax, [rip + _frame_witness_stage]
          mov  r8, [rax]                           // r8 = stage value
          mov  rdi, 1                              // LEVEL_ERROR
          lea  rsi, [rip + SUBSYS_BOOT]
          lea  rdx, [rip + frame_hdr_fail_msg]
          lea  rcx, [rip + k_line]                 // reuse "line" key
          call klog_s1_d1

      frame_witness_done:

      // ============================================================
      // R20b.M2-002 (#1556): pending-msg primitives witness.
      //
      // Second M2 sub-issue — builds on M2-001's frame_encode (packed
      // u64 header) to prove the endpoint_write_pending /
      // endpoint_take_pending / endpoint_is_full round-trip on the
      // single-slot pending-msg semantics from
      // design/ipc/userspace-server-substrate.md §4.3.
      //
      // Sub-tests (executed in order; any failure jumps to fail marker
      // with the numeric stage in _pending_witness_stage):
      //
      //   0. Mint an endpoint (endpoint_alloc -> id in [0..127]). The
      //      endpoint_alloc_witness (R20b.M1-002) freed all 128 rows in
      //      its cleanup phase, so this alloc returns 0.
      //   1. endpoint_is_full(id) == 0 — fresh endpoint has no pending
      //      msg (pending_hdr slot is zero-initialized by .bss).
      //   2. Fill _pending_witness_src with 32 known bytes (0x11..0x30
      //      via a byte-fill loop) so the payload round-trip can be
      //      byte-compared. 32 bytes is well under the 4088-byte cap
      //      and exercises both a header store AND a real memcpy.
      //   3. frame_encode(scratch_hdr_buf, op=0x05, ver=2, flags=0x0007,
      //      payload_len=32) — build a packed hdr. Load it back via
      //      frame_decode to get the u64 to pass into write_pending.
      //   4. endpoint_write_pending(id, hdr, src, 32) == 0 — first
      //      write succeeds (slot was empty).
      //   5. endpoint_is_full(id) == 1 — post-write, endpoint is full.
      //   6. endpoint_write_pending(id, hdr, src, 32) == 1 (EAGAIN) —
      //      second write on full endpoint is rejected.
      //   7. Pre-fill dst hdr scratch with a sentinel (0xDEAD..CAFE)
      //      and dst payload buf with 0xAA bytes so a wrong-length or
      //      wrong-content copy is easily distinguished from a valid
      //      round-trip.
      //   8. endpoint_take_pending(id, &dst_hdr, &dst_payload) == 32
      //      — returns the u32 payload_len that was in the header.
      //   9. dst_hdr (u64 at _pending_witness_dst_hdr) equals the
      //      packed hdr from step 3. Verifies hdr round-trip through
      //      the endpoint row's pending_hdr slot.
      //  10. dst_payload[0] == 0x11 AND dst_payload[31] == 0x30 —
      //      verifies memcpy in-and-out preserves payload bytes at
      //      both ends of the copied range.
      //  11. endpoint_is_full(id) == 0 — post-take, endpoint is empty
      //      again (pending_hdr cleared as the release barrier).
      //  12. endpoint_take_pending(id, ...) == PENDING_TAKE_EMPTY
      //      (0xFFFFFFFFFFFFFFFF) — second take on empty endpoint
      //      returns the empty sentinel, not a stale payload_len.
      //  13. Cleanup: endpoint_free(id) so the id is reusable and the
      //      pending_hdr slot returns to its zero-init state.
      //
      // Register plan:
      //   r15 = allocated endpoint id (survives across all sub-tests).
      //   r14 = packed hdr from step 3 (survives to step 9 comparison).
      //   r13 = loop counter for the fill loop in step 2.
      //   Sentinels loaded into r14 fresh where needed.
      //
      // Placement: opens with the M2-002 sub-issue right after the
      // M2-001 frame_witness closes. sys_dmesg_witness follows.
      // ============================================================
      pending_msg_witness:
          // -- Sub-test 0: mint an endpoint.
          xor  r13, r13                            // stage 0
          lea  rax, [rip + _pending_witness_stage]
          mov  [rax], r13

          call endpoint_alloc
          mov  r14, 0xFFFFFFFFFFFFFFFF             // ENDPOINT_ALLOC_NONE
          cmp  rax, r14
          je   pending_msg_witness_fail
          mov  r15, rax                            // r15 = id

          // -- Sub-test 1: endpoint_is_full(id) == 0 (fresh row).
          mov  r13, 1
          lea  rax, [rip + _pending_witness_stage]
          mov  [rax], r13

          mov  rdi, r15
          call endpoint_is_full
          cmp  rax, 0
          jne  pending_msg_witness_fail

          // -- Sub-test 2: fill src with 32 known bytes (0x11..0x30).
          mov  r13, 2
          lea  rax, [rip + _pending_witness_stage]
          mov  [rax], r13

          lea  r10, [rip + _pending_witness_src]
          xor  r11, r11                            // i = 0
      pmw_fill_loop:
          cmp  r11, 32
          je   pmw_fill_done
          mov  rax, 0x11
          add  rax, r11                            // value = 0x11 + i
          mov_b [r10 + r11*1], rax
          add  r11, 1
          jmp  pmw_fill_loop
      pmw_fill_done:

          // -- Sub-test 3: build packed hdr via frame_encode + frame_decode.
          mov  r13, 3
          lea  rax, [rip + _pending_witness_stage]
          mov  [rax], r13

          lea  rdi, [rip + _pending_witness_hdr_buf]
          mov  rsi, 0x05                           // op
          mov  rdx, 2                              // ver (>= 1 so hdr != 0)
          mov  rcx, 0x0007                         // flags
          mov  r8,  32                             // payload_len
          call frame_encode
          cmp  rax, 0                              // FRAME_ENCODE_OK
          jne  pending_msg_witness_fail

          lea  rdi, [rip + _pending_witness_hdr_buf]
          call frame_decode
          mov  r14, rax                            // r14 = packed hdr

          // -- Sub-test 4: endpoint_write_pending(id, hdr, src, 32) == OK.
          mov  r13, 4
          lea  rax, [rip + _pending_witness_stage]
          mov  [rax], r13

          mov  rdi, r15                            // id
          mov  rsi, r14                            // hdr
          lea  rdx, [rip + _pending_witness_src]   // payload_ptr
          mov  rcx, 32                             // payload_len
          call endpoint_write_pending
          cmp  rax, 0                              // PENDING_WRITE_OK
          jne  pending_msg_witness_fail

          // -- Sub-test 5: endpoint_is_full(id) == 1 (post-write).
          mov  r13, 5
          lea  rax, [rip + _pending_witness_stage]
          mov  [rax], r13

          mov  rdi, r15
          call endpoint_is_full
          cmp  rax, 1
          jne  pending_msg_witness_fail

          // -- Sub-test 6: second write returns EAGAIN.
          mov  r13, 6
          lea  rax, [rip + _pending_witness_stage]
          mov  [rax], r13

          mov  rdi, r15
          mov  rsi, r14
          lea  rdx, [rip + _pending_witness_src]
          mov  rcx, 32
          call endpoint_write_pending
          cmp  rax, 1                              // PENDING_WRITE_ERR_EAGAIN
          jne  pending_msg_witness_fail

          // -- Sub-test 7: pre-fill dst scratches with sentinels.
          mov  r13, 7
          lea  rax, [rip + _pending_witness_stage]
          mov  [rax], r13

          lea  rax, [rip + _pending_witness_dst_hdr]
          mov  r11, 0xDEADBEEFCAFEBABE
          mov  [rax], r11

          lea  r10, [rip + _pending_witness_dst]
          xor  r11, r11
      pmw_dst_prefill_loop:
          cmp  r11, 32
          je   pmw_dst_prefill_done
          mov  rax, 0xAA
          mov_b [r10 + r11*1], rax
          add  r11, 1
          jmp  pmw_dst_prefill_loop
      pmw_dst_prefill_done:

          // -- Sub-test 8: endpoint_take_pending returns payload_len == 32.
          mov  r13, 8
          lea  rax, [rip + _pending_witness_stage]
          mov  [rax], r13

          mov  rdi, r15                            // id
          lea  rsi, [rip + _pending_witness_dst_hdr]
          lea  rdx, [rip + _pending_witness_dst]
          call endpoint_take_pending
          cmp  rax, 32
          jne  pending_msg_witness_fail

          // -- Sub-test 9: dst_hdr equals the packed hdr from step 3.
          mov  r13, 9
          lea  rax, [rip + _pending_witness_stage]
          mov  [rax], r13

          lea  rax, [rip + _pending_witness_dst_hdr]
          mov  rax, [rax]
          cmp  rax, r14
          jne  pending_msg_witness_fail

          // -- Sub-test 10: dst_payload[0] == 0x11, dst_payload[31] == 0x30.
          mov  r13, 10
          lea  rax, [rip + _pending_witness_stage]
          mov  [rax], r13

          lea  r10, [rip + _pending_witness_dst]
          xor  rax, rax
          mov_b rax, [r10]
          cmp  rax, 0x11
          jne  pending_msg_witness_fail

          xor  rax, rax
          mov_b rax, [r10 + 31]
          cmp  rax, 0x30
          jne  pending_msg_witness_fail

          // -- Sub-test 11: endpoint_is_full(id) == 0 (post-take).
          mov  r13, 11
          lea  rax, [rip + _pending_witness_stage]
          mov  [rax], r13

          mov  rdi, r15
          call endpoint_is_full
          cmp  rax, 0
          jne  pending_msg_witness_fail

          // -- Sub-test 12: second take returns PENDING_TAKE_EMPTY.
          mov  r13, 12
          lea  rax, [rip + _pending_witness_stage]
          mov  [rax], r13

          mov  rdi, r15
          lea  rsi, [rip + _pending_witness_dst_hdr]
          lea  rdx, [rip + _pending_witness_dst]
          call endpoint_take_pending
          mov  r11, 0xFFFFFFFFFFFFFFFF             // PENDING_TAKE_EMPTY
          cmp  rax, r11
          jne  pending_msg_witness_fail

          // -- Sub-test 13: cleanup — free the endpoint.
          mov  r13, 13
          lea  rax, [rip + _pending_witness_stage]
          mov  [rax], r13

          mov  rdi, r15
          call endpoint_free

          // Success marker: R20b PENDING MSG OK.
          mov  rdi, 3                              // LEVEL_INFO
          lea  rsi, [rip + SUBSYS_BOOT]
          lea  rdx, [rip + pending_msg_ok_msg]
          call klog_s1
          jmp  pending_msg_witness_done

      pending_msg_witness_fail:
          // Emit "R20b PENDING MSG FAIL" with sub-test stage as decimal KV.
          lea  rax, [rip + _pending_witness_stage]
          mov  r8, [rax]                           // r8 = stage
          mov  rdi, 1                              // LEVEL_ERROR
          lea  rsi, [rip + SUBSYS_BOOT]
          lea  rdx, [rip + pending_msg_fail_msg]
          lea  rcx, [rip + k_line]                 // reuse "line" key
          call klog_s1_d1

      pending_msg_witness_done:

      // ============================================================
      // logging-m9-002 (#709): sys_dmesg body witness.
      //
      // Kernel-side call of sys_dmesg_body — the syscall trampoline
      // (dispatch_dmesg) is exercised end-to-end from userspace only
      // once a user program invokes SYS_DMESG=13. At the boot-witness
      // level we validate the body directly (parallel to sys_read_witness,
      // sys_write_witness, sys_open_witness precedent — kernel VA scratch,
      // no KPTI walk exercised at boot witness time). A pass here proves
      // the wiring from the syscall body through klog_ring_read_tail into
      // ring state is intact; the dispatch_dmesg trampoline is verified
      // structurally by tools/verify-syscall-dispatch.sh (sysno 13 gate).
      // ============================================================
      sys_dmesg_witness:
          lea  rdi, [rip + _dmesg_cap_witness_scratch]  // reuse cap-witness scratch
          mov  rsi, 256                                 // len
          call sys_dmesg_body
          cmp  rax, 0
          je   sys_dmesg_witness_fail

          mov  rdi, 3
          lea  rsi, [rip + SUBSYS_BOOT]
          lea  rdx, [rip + sys_dmesg_ok_msg]
          call klog_s1
          jmp  sys_dmesg_witness_done

      sys_dmesg_witness_fail:
          mov  rdi, 1
          lea  rsi, [rip + SUBSYS_BOOT]
          lea  rdx, [rip + sys_dmesg_fail_msg]
          call klog_s1

      sys_dmesg_witness_done:

      // ============================================================
      // logging-m9-003 (#710): audit-log bridge witness.
      //
      // Per design/kernel/kernel-logging-substrate.md §12.10 +
      // design/audit/log-structure.md: a subset of PANIC + ERROR klog
      // lines is forwarded to the persistent audit log at
      // /system/audit/log.pdaudit. The bridge maintains an in-kernel
      // ring (klog_audit_forward, wired into klog_emit_core) and a
      // flush primitive (klog_audit_flush) that drains the ring into
      // the log inode via tmpfs_write.
      //
      // Steps:
      //   1. tmpfs_create /system as DIR under root.
      //   2. tmpfs_create /system/audit as DIR.
      //   3. tmpfs_create /system/audit/log.pdaudit as REG.
      //   4. Publish log inode into _klog_audit_log_inode.
      //   5. Arm the bridge (_klog_audit_ready = 1).
      //   6. Emit an ERROR-level klog line — klog_emit_core's post-
      //      ring-write hook forwards it into _klog_audit_buf.
      //   7. Call klog_audit_flush — drains buf → log inode.
      //   8. tmpfs_read the log back — assert non-empty.
      //   9. Emit R18 AUDIT BRIDGE OK marker.
      //
      // Register plan across tmpfs_create chain:
      //   r12 = system_inode_idx, r13 = audit_inode_idx,
      //   r14 = log_inode_idx.
      // ============================================================
      audit_bridge_witness:
          // Step 1: tmpfs_create(root_idx=1, "system", 6, DIR=2)
          mov  rdi, 1                              // dir_idx = ROOT
          lea  rsi, [rip + system_dir_name]
          mov  rdx, 6                              // len("system")
          mov  rcx, 2                              // VNODE_TYPE_DIR
          call tmpfs_create
          cmp  rax, 0
          je   audit_bridge_witness_fail
          mov  rcx, 0xFFFF
          cmp  rax, rcx
          je   audit_bridge_witness_fail
          mov  r12, rax                            // r12 = system_idx

          // Step 2: tmpfs_create(system_idx, "audit", 5, DIR=2)
          mov  rdi, r12
          lea  rsi, [rip + audit_dir_name]
          mov  rdx, 5
          mov  rcx, 2                              // VNODE_TYPE_DIR
          call tmpfs_create
          cmp  rax, 0
          je   audit_bridge_witness_fail
          mov  rcx, 0xFFFF
          cmp  rax, rcx
          je   audit_bridge_witness_fail
          mov  r13, rax                            // r13 = audit_idx

          // Step 3: tmpfs_create(audit_idx, "log.pdaudit", 11, REG=1)
          mov  rdi, r13
          lea  rsi, [rip + audit_log_name]
          mov  rdx, 11
          mov  rcx, 1                              // VNODE_TYPE_REG
          call tmpfs_create
          cmp  rax, 0
          je   audit_bridge_witness_fail
          mov  rcx, 0xFFFF
          cmp  rax, rcx
          je   audit_bridge_witness_fail
          mov  r14, rax                            // r14 = log_inode_idx

          // Step 4 + 5: publish inode + arm the bridge. Order matters:
          // klog_audit_forward reads _klog_audit_ready first, so
          // storing the inode BEFORE flipping ready avoids the
          // (ready=1, inode=0) window.
          mov  [rip + _klog_audit_log_inode], r14
          mov  rax, 1
          mov  [rip + _klog_audit_ready], rax

          // Step 6: emit an ERROR-level klog line with a recognizable
          // tag ("AUDIT TEST"). Level 1 = ERROR passes the audit
          // filter; the line lands in the audit ring via the
          // klog_emit_core → klog_audit_forward hook.
          mov  rdi, 1                              // LEVEL_ERROR
          lea  rsi, [rip + SUBSYS_BOOT]
          lea  rdx, [rip + audit_test_tag]
          call klog_s1

          // Step 7: drain the audit buffer into the log inode.
          call klog_audit_flush
          cmp  rax, 0
          je   audit_bridge_witness_fail          // nothing flushed → bridge broken

          // Step 8: read the log inode back and assert non-empty.
          // The bytes are dominated by the klog_emit_core header (TSC
          // hex, CPU id, level letter 'E', subsystem "BOOT|", tag
          // "AUDIT TEST"); any non-zero read confirms the round-trip.
          mov  rdi, r14                            // inode_idx
          lea  rsi, [rip + _audit_bridge_witness_scratch]
          mov  rdx, 4096                           // len
          xor  rcx, rcx                            // offset = 0
          call tmpfs_read
          cmp  rax, 0
          je   audit_bridge_witness_fail

          // Step 9: success marker.
          mov  rdi, 3
          lea  rsi, [rip + SUBSYS_BOOT]
          lea  rdx, [rip + audit_bridge_ok_msg]
          call klog_s1
          jmp  audit_bridge_witness_done

      audit_bridge_witness_fail:
          mov  rdi, 1
          lea  rsi, [rip + SUBSYS_BOOT]
          lea  rdx, [rip + audit_bridge_fail_msg]
          call klog_s1

      audit_bridge_witness_done:

      // ============================================================
      // R29.M3-001 (#1028) + R29.M3-002 (#1029): driver registry v2
      // witness — versioned schema encode/seal/fsck + persisted
      // round-trip through the tmpfs-backed on-disk layout.
      //
      // Per design/drivers/registry-v2.md: the registry is the durable
      // artifact recording, for each installed driver, its name,
      // semantic version, KIND_HW-family capability manifest and the
      // effect row the elaborator proved (the row the cap-vs-effect
      // walker C1301 enforces at compile time). It is versioned at the
      // head so a schema change is a migration, and signed at the tail
      // so a tampered registry is detectable before any capability is
      // minted from it.
      //
      // Placed AFTER audit_bridge_witness because that witness is what
      // creates /system on tmpfs; this witness looks it up rather than
      // re-creating it (tmpfs_create has no create-or-open mode, so a
      // second create of "system" would collide and return 0).
      //
      // Sequence:
      //   Stage  0  tmpfs_lookup(root, "system")            -> /system
      //   Stage  1  tmpfs_create(/system, "registry", DIR)
      //   Stage  2  tmpfs_create(registry, "drivers.pdxreg", REG)
      //   Stage  3  tmpfs_create(registry, "drivers.pdxreg.new", REG)
      //   Stage  4  registry_persist_bind(live, shadow)
      //   Stage  5  driver_table_register(slot 0, pid 7, "uart-16550")
      //   Stage  6  driver_lifecycle_transition(0, RUNNING)
      //   Stage  7  driver_table_register(slot 1, pid 9, "nvme-pcie")
      //   Stage  8  registry_v2_header_init(2)
      //   Stage  9  registry_v2_record_encode(0, slot 0, ...)
      //   Stage 10  registry_v2_record_encode(1, slot 1, ...)
      //   Stage 11  registry_v2_seal(2)
      //   Stage 12  registry_v2_validate(live image)         -> OK
      //   Stage 13  registry_persist_publish(2)              -> OK
      //   Stage 14  registry_persist_load(2)                 -> OK
      //   Stage 15  registry_persist_compare(live, scratch, 3549) == 0
      //             — BYTE-EXACT round-trip, the core assertion
      //   Stage 16  registry_v2_image_count(scratch) == 2
      //   Stage 17  decode record 0: slot/state/pid/version/caps/effects
      //   Stage 18  decode record 1: slot/pid/version/caps/effects
      //   Stage 19  decode record 0 name_lo == "uart-165" qword
      //   Stage 20  signature block present: 'PDSG' magic, alg 1,
      //             declared length 3309, body byte zero
      //   Stage 21  failure edge A: corrupt magic  -> ERR_BAD_MAGIC
      //   Stage 22  failure edge B: corrupt record -> ERR_REC_CHECKSUM
      //   Stage 23  failure edge C: nonzero sig    -> ERR_SIG_NOT_ZERO
      //   Stage 24  restored image re-validates    -> OK
      //   Stage 25  failure edge D: encode index 32 -> ERR_BAD_INDEX
      //   Stage 26  failure edge E: publish count 33 -> ERR_TOO_MANY
      //
      // Image geometry for the two-record witness:
      //   total = 32 (header) + 2*96 (records) + 3325 (sig block) = 3549
      // which crosses the 4 KiB page boundary check in tmpfs_write only
      // by staying under it — but registry_persist_write chunks
      // regardless, so the 32-record 6429 B case exercises the same code.
      //
      // Register plan (callee-saved across every nested call):
      //   r12 = /system inode idx, then live image VA
      //   r13 = registry dir inode idx, then scratch image VA
      //   r14 = live file inode idx
      //   r15 = shadow file inode idx
      //
      // Marker ordering in the golden log:
      //   R18 AUDIT BRIDGE OK   (logging-m9-003)
      //   R29 REGISTRY V2 OK    <- THIS WITNESS
      // ============================================================
      registry_v2_witness:
          // --- Stage 0: locate /system ---
          xor  rax, rax
          lea  rcx, [rip + _registry_v2_witness_stage]
          mov  [rcx + 0], rax
          mov  rdi, 1                              // TMPFS_INODE_IDX_ROOT
          lea  rsi, [rip + system_dir_name]
          call tmpfs_lookup
          cmp  rax, 0
          je   registry_v2_witness_fail
          mov  r12, rax                            // r12 = /system idx

          // --- Stage 1: tmpfs_create(/system, "registry", DIR) ---
          mov  rax, 1
          lea  rcx, [rip + _registry_v2_witness_stage]
          mov  [rcx + 0], rax
          mov  rdi, r12
          lea  rsi, [rip + registry_dir_name]
          mov  rdx, 8                              // len("registry")
          mov  rcx, 2                              // VNODE_TYPE_DIR
          call tmpfs_create
          cmp  rax, 0
          je   registry_v2_witness_fail
          mov  rcx, 0xFFFF
          cmp  rax, rcx
          je   registry_v2_witness_fail
          mov  r13, rax                            // r13 = registry dir idx

          // --- Stage 2: tmpfs_create(registry, "drivers.pdxreg", REG) ---
          mov  rax, 2
          lea  rcx, [rip + _registry_v2_witness_stage]
          mov  [rcx + 0], rax
          mov  rdi, r13
          lea  rsi, [rip + registry_file_name]
          mov  rdx, 14                             // len("drivers.pdxreg")
          mov  rcx, 1                              // VNODE_TYPE_REG
          call tmpfs_create
          cmp  rax, 0
          je   registry_v2_witness_fail
          mov  rcx, 0xFFFF
          cmp  rax, rcx
          je   registry_v2_witness_fail
          mov  r14, rax                            // r14 = live inode

          // --- Stage 3: tmpfs_create(registry, "drivers.pdxreg.new", REG) ---
          mov  rax, 3
          lea  rcx, [rip + _registry_v2_witness_stage]
          mov  [rcx + 0], rax
          mov  rdi, r13
          lea  rsi, [rip + registry_shadow_name]
          mov  rdx, 18                             // len("drivers.pdxreg.new")
          mov  rcx, 1                              // VNODE_TYPE_REG
          call tmpfs_create
          cmp  rax, 0
          je   registry_v2_witness_fail
          mov  rcx, 0xFFFF
          cmp  rax, rcx
          je   registry_v2_witness_fail
          mov  r15, rax                            // r15 = shadow inode

          // --- Stage 4: bind both inodes into the persistence module ---
          mov  rax, 4
          lea  rcx, [rip + _registry_v2_witness_stage]
          mov  [rcx + 0], rax
          mov  rdi, r14
          mov  rsi, r15
          call registry_persist_bind
          cmp  rax, 0
          jne  registry_v2_witness_fail

          // --- Stage 5: register driver slot 0 (uart-16550, pid 7) ---
          mov  rax, 5
          lea  rcx, [rip + _registry_v2_witness_stage]
          mov  [rcx + 0], rax
          xor  rdi, rdi                            // slot 0
          mov  rsi, 7                              // pid
          lea  rdx, [rip + _registry_v2_witness_name0]
          mov  rcx, 0x100                          // caps_manifest_offset
          call driver_table_register
          cmp  rax, 0
          jne  registry_v2_witness_fail

          // --- Stage 6: drive slot 0 Init -> Running so the persisted
          //     lifecycle_state byte is a non-default value (a record
          //     that only ever captured state 0 would not prove the
          //     state byte is projected at all) ---
          mov  rax, 6
          lea  rcx, [rip + _registry_v2_witness_stage]
          mov  [rcx + 0], rax
          xor  rdi, rdi
          mov  rsi, 1                              // DRIVER_STATE_RUNNING
          call driver_lifecycle_transition
          cmp  rax, 0
          jne  registry_v2_witness_fail

          // --- Stage 7: register driver slot 1 (nvme-pcie, pid 9) ---
          mov  rax, 7
          lea  rcx, [rip + _registry_v2_witness_stage]
          mov  [rcx + 0], rax
          mov  rdi, 1                              // slot 1
          mov  rsi, 9                              // pid
          lea  rdx, [rip + _registry_v2_witness_name1]
          mov  rcx, 0x200                          // caps_manifest_offset
          call driver_table_register
          cmp  rax, 0
          jne  registry_v2_witness_fail

          // --- Stage 8: header_init(2) ---
          mov  rax, 8
          lea  rcx, [rip + _registry_v2_witness_stage]
          mov  [rcx + 0], rax
          mov  rdi, 2
          call registry_v2_header_init
          cmp  rax, 0
          jne  registry_v2_witness_fail

          // --- Stage 9: encode record 0 from driver_table slot 0.
          //     version 1.4.2, caps = KIND_HW|KIND_HW_INTERRUPT
          //     (bits 14,15 = 0xC000), effects = mem|mmio|io|irq (0x0F) ---
          mov  rax, 9
          lea  rcx, [rip + _registry_v2_witness_stage]
          mov  [rcx + 0], rax
          xor  rdi, rdi                            // record index 0
          xor  rsi, rsi                            // driver_table slot 0
          mov  rdx, 0x0000000100040002             // major 1, minor 4, patch 2
          mov  rcx, 0xC000                         // cap_manifest_lo
          mov  r8,  0x0F                           // effect_row
          call registry_v2_record_encode
          cmp  rax, 0
          jne  registry_v2_witness_fail

          // --- Stage 10: encode record 1 from driver_table slot 1.
          //     version 2.1.0, caps = KIND_HW|KIND_HW_MSIX_VECTOR|
          //     KIND_DMA_DOMAIN (bits 14,16,17 = 0x34000),
          //     effects = mem|mmio|dma (0x13) ---
          mov  rax, 10
          lea  rcx, [rip + _registry_v2_witness_stage]
          mov  [rcx + 0], rax
          mov  rdi, 1                              // record index 1
          mov  rsi, 1                              // driver_table slot 1
          mov  rdx, 0x0000000200010000             // major 2, minor 1, patch 0
          mov  rcx, 0x34000                        // cap_manifest_lo
          mov  r8,  0x13                           // effect_row
          call registry_v2_record_encode
          cmp  rax, 0
          jne  registry_v2_witness_fail

          // --- Stage 11: seal (content checksum + signature block) ---
          mov  rax, 11
          lea  rcx, [rip + _registry_v2_witness_stage]
          mov  [rcx + 0], rax
          mov  rdi, 2
          call registry_v2_seal
          cmp  rax, 0
          jne  registry_v2_witness_fail

          // --- Stage 12: fsck the freshly-sealed live image ---
          mov  rax, 12
          lea  rcx, [rip + _registry_v2_witness_stage]
          mov  [rcx + 0], rax
          call registry_v2_buf_addr
          mov  r12, rax                            // r12 = live image VA
          mov  rdi, r12
          call registry_v2_validate
          cmp  rax, 0
          jne  registry_v2_witness_fail

          // --- Stage 13: shadow-write publish to the on-disk layout ---
          mov  rax, 13
          lea  rcx, [rip + _registry_v2_witness_stage]
          mov  [rcx + 0], rax
          mov  rdi, 2
          call registry_persist_publish
          cmp  rax, 0
          jne  registry_v2_witness_fail

          // --- Stage 14: read the live file back + fsck ---
          mov  rax, 14
          lea  rcx, [rip + _registry_v2_witness_stage]
          mov  [rcx + 0], rax
          mov  rdi, 2
          call registry_persist_load
          cmp  rax, 0
          jne  registry_v2_witness_fail

          call registry_persist_scratch_addr
          mov  r13, rax                            // r13 = scratch image VA

          // --- Stage 15: BYTE-EXACT round-trip over all 3549 bytes ---
          mov  rax, 15
          lea  rcx, [rip + _registry_v2_witness_stage]
          mov  [rcx + 0], rax
          mov  rdi, r12
          mov  rsi, r13
          mov  rdx, 3549                           // 32 + 2*96 + 3325
          call registry_persist_compare
          cmp  rax, 0
          jne  registry_v2_witness_fail

          // --- Stage 16: decoded record count ---
          mov  rax, 16
          lea  rcx, [rip + _registry_v2_witness_stage]
          mov  [rcx + 0], rax
          mov  rdi, r13
          call registry_v2_image_count
          cmp  rax, 2
          jne  registry_v2_witness_fail

          // --- Stage 17: decode record 0 from the read-back image ---
          mov  rax, 17
          lea  rcx, [rip + _registry_v2_witness_stage]
          mov  [rcx + 0], rax
          mov  rdi, r13
          xor  rsi, rsi
          xor  rdx, rdx                            // REC_OFF_HEADER
          call registry_v2_field
          mov  r8, rax                             // r8 = record 0 header
          mov  rax, r8
          mov  rcx, 0xFF
          and  rax, rcx
          cmp  rax, 0                              // slot == 0
          jne  registry_v2_witness_fail
          mov  rax, r8
          shr  rax, 8
          mov  rcx, 0xFF
          and  rax, rcx
          cmp  rax, 1                              // state == RUNNING
          jne  registry_v2_witness_fail
          mov  rax, r8
          shr  rax, 16
          mov  rcx, 0xFF
          and  rax, rcx
          cmp  rax, 1                              // record_flags bit0 = valid
          jne  registry_v2_witness_fail
          mov  rax, r8
          shr  rax, 32
          cmp  rax, 7                              // pid == 7
          jne  registry_v2_witness_fail

          mov  rdi, r13
          xor  rsi, rsi
          mov  rdx, 24                             // REC_OFF_VERSION
          call registry_v2_field
          mov  rcx, 0x0000000100040002
          cmp  rax, rcx
          jne  registry_v2_witness_fail

          mov  rdi, r13
          xor  rsi, rsi
          mov  rdx, 32                             // REC_OFF_CAP_LO
          call registry_v2_field
          mov  rcx, 0xC000
          cmp  rax, rcx
          jne  registry_v2_witness_fail

          mov  rdi, r13
          xor  rsi, rsi
          mov  rdx, 48                             // REC_OFF_EFFECT_ROW
          call registry_v2_field
          cmp  rax, 0x0F
          jne  registry_v2_witness_fail

          mov  rdi, r13
          xor  rsi, rsi
          mov  rdx, 56                             // REC_OFF_CAPS_OFFSET
          call registry_v2_field
          mov  rcx, 0x100
          cmp  rax, rcx
          jne  registry_v2_witness_fail

          // --- Stage 18: decode record 1 from the read-back image ---
          mov  rax, 18
          lea  rcx, [rip + _registry_v2_witness_stage]
          mov  [rcx + 0], rax
          mov  rdi, r13
          mov  rsi, 1
          xor  rdx, rdx                            // REC_OFF_HEADER
          call registry_v2_field
          mov  r8, rax
          mov  rax, r8
          mov  rcx, 0xFF
          and  rax, rcx
          cmp  rax, 1                              // slot == 1
          jne  registry_v2_witness_fail
          mov  rax, r8
          shr  rax, 32
          cmp  rax, 9                              // pid == 9
          jne  registry_v2_witness_fail

          mov  rdi, r13
          mov  rsi, 1
          mov  rdx, 24
          call registry_v2_field
          mov  rcx, 0x0000000200010000
          cmp  rax, rcx
          jne  registry_v2_witness_fail

          mov  rdi, r13
          mov  rsi, 1
          mov  rdx, 32
          call registry_v2_field
          mov  rcx, 0x34000
          cmp  rax, rcx
          jne  registry_v2_witness_fail

          mov  rdi, r13
          mov  rsi, 1
          mov  rdx, 48
          call registry_v2_field
          cmp  rax, 0x13
          jne  registry_v2_witness_fail

          mov  rdi, r13
          mov  rsi, 1
          mov  rdx, 56
          call registry_v2_field
          mov  rcx, 0x200
          cmp  rax, rcx
          jne  registry_v2_witness_fail

          // --- Stage 19: the driver name survived the round trip.
          //     Record 0's name_lo must equal the first 8 bytes of the
          //     16-byte NUL-padded name handed to driver_table_register,
          //     proving the projection is byte-faithful and not merely
          //     self-consistent ---
          mov  rax, 19
          lea  rcx, [rip + _registry_v2_witness_stage]
          mov  [rcx + 0], rax
          mov  rdi, r13
          xor  rsi, rsi
          mov  rdx, 8                              // REC_OFF_NAME_LO
          call registry_v2_field
          lea  rcx, [rip + _registry_v2_witness_name0]
          mov  rcx, [rcx + 0]
          cmp  rax, rcx
          jne  registry_v2_witness_fail

          // --- Stage 20: signature block present + well-formed.
          //     sig base = scratch + 32 + 2*96 = scratch + 224 ---
          mov  rax, 20
          lea  rcx, [rip + _registry_v2_witness_stage]
          mov  [rcx + 0], rax
          mov  rdi, r13
          mov  rsi, 2
          call registry_v2_sig_addr
          // r15 (callee-saved, and free once registry_persist_bind has
          // consumed the shadow inode idx) holds &sig_block: stages 21
          // and 22 each call registry_v2_validate, which clobbers every
          // caller-saved register, so the address must survive in a
          // callee-saved slot to still be valid at stage 23.
          mov  r15, rax                            // r15 = &sig_block

          mov  rax, [r15 + 0]
          mov  rcx, 0xFFFFFFFF
          and  rax, rcx
          mov  rcx, 0x47534450                     // 'P','D','S','G'
          cmp  rax, rcx
          jne  registry_v2_witness_fail

          mov  rax, [r15 + 0]
          shr  rax, 32
          mov  rcx, 0xFFFF
          and  rax, rcx
          cmp  rax, 1                              // ML-DSA-65
          jne  registry_v2_witness_fail

          mov  rax, [r15 + 8]
          mov  rcx, 3309                           // declared sig length
          cmp  rax, rcx
          jne  registry_v2_witness_fail

          mov  rax, [r15 + 16]                     // first 8 body bytes
          cmp  rax, 0                              // all-zero scaffold epoch
          jne  registry_v2_witness_fail

          // --- Stage 21: failure edge A — corrupt the magic byte of the
          //     read-back image and confirm the fsck names the stage.
          //     The scratch image is a throwaway verification target, so
          //     mutating it is safe; every edge restores the byte and
          //     stage 24 re-validates to prove the restoration ---
          mov  rax, 21
          lea  rcx, [rip + _registry_v2_witness_stage]
          mov  [rcx + 0], rax
          mov  rax, 0xEE
          mov_b [r13 + 0], al
          mov  rdi, r13
          call registry_v2_validate
          mov  rcx, 0xFFFFFD04                     // ERR_BAD_MAGIC
          cmp  rax, rcx
          jne  registry_v2_witness_fail
          mov  rax, 0x50                           // restore 'P'
          mov_b [r13 + 0], al

          // --- Stage 22: failure edge B — corrupt record 0's slot byte
          //     (image + 32) and confirm the per-record checksum fires ---
          mov  rax, 22
          lea  rcx, [rip + _registry_v2_witness_stage]
          mov  [rcx + 0], rax
          mov  rax, 0xEE
          mov_b [r13 + 32], al
          mov  rdi, r13
          call registry_v2_validate
          mov  rcx, 0xFFFFFD07                     // ERR_REC_CHECKSUM
          cmp  rax, rcx
          jne  registry_v2_witness_fail
          xor  rax, rax                            // restore slot byte 0
          mov_b [r13 + 32], al

          // --- Stage 23: failure edge C — set a signature body byte
          //     non-zero and confirm the scaffold-epoch assertion fires.
          //     This is the check that will flip from assert-zero to
          //     assert-verify when real ML-DSA-65 signing lands ---
          mov  rax, 23
          lea  rcx, [rip + _registry_v2_witness_stage]
          mov  [rcx + 0], rax
          mov  rax, 1
          mov_b [r15 + 16], al
          mov  rdi, r13
          call registry_v2_validate
          mov  rcx, 0xFFFFFD0C                     // ERR_SIG_NOT_ZERO
          cmp  rax, rcx
          jne  registry_v2_witness_fail
          xor  rax, rax
          mov_b [r15 + 16], al                     // restore zero

          // --- Stage 24: the restored image validates clean again ---
          mov  rax, 24
          lea  rcx, [rip + _registry_v2_witness_stage]
          mov  [rcx + 0], rax
          mov  rdi, r13
          call registry_v2_validate
          cmp  rax, 0
          jne  registry_v2_witness_fail

          // --- Stage 25: failure edge D — encode past the record cap ---
          mov  rax, 25
          lea  rcx, [rip + _registry_v2_witness_stage]
          mov  [rcx + 0], rax
          mov  rdi, 32                             // index == MAX_RECORDS
          xor  rsi, rsi
          xor  rdx, rdx
          xor  rcx, rcx
          xor  r8,  r8
          call registry_v2_record_encode
          mov  rcx, 0xFFFFFD01                     // ERR_BAD_INDEX
          cmp  rax, rcx
          jne  registry_v2_witness_fail

          // --- Stage 26: failure edge E — publish past the record cap ---
          mov  rax, 26
          lea  rcx, [rip + _registry_v2_witness_stage]
          mov  [rcx + 0], rax
          mov  rdi, 33
          call registry_persist_publish
          mov  rcx, 0xFFFFFD23                     // ERR_TOO_MANY
          cmp  rax, rcx
          jne  registry_v2_witness_fail

          // --- Cleanup: release both driver rows so downstream
          //     witnesses see a fresh table (mirrors the R29.M2
          //     lifecycle witnesses' unregister tails) ---
          xor  rdi, rdi
          call driver_table_unregister
          mov  rdi, 1
          call driver_table_unregister

          // Success marker: R29 REGISTRY V2 OK.
          mov  rdi, 3                              // LEVEL_INFO
          lea  rsi, [rip + SUBSYS_BOOT]
          lea  rdx, [rip + registry_v2_ok_msg]
          call klog_s1
          jmp  registry_v2_witness_done

      registry_v2_witness_fail:
          // Emit fail marker with the stage KV so a boot-log triage
          // names the failing sub-test without a debugger.
          lea  rax, [rip + _registry_v2_witness_stage]
          mov  r8,  [rax + 0]
          mov  rdi, 1                              // LEVEL_ERROR
          lea  rsi, [rip + SUBSYS_BOOT]
          lea  rdx, [rip + registry_v2_fail_msg]
          lea  rcx, [rip + k_line]
          call klog_s1_d1

      registry_v2_witness_done:

      // ============================================================
      // R29.M3-003 (#1030) + R29.M3-004 (#1031): registry lookup,
      // hot-reload, snapshot + rollback witness. 36 sub-tests, 1 marker.
      //
      // Runs immediately after registry_v2_witness, which left
      // /system/registry/{drivers.pdxreg,drivers.pdxreg.new} created and
      // both inode indices bound into registry_persist. It does NOT
      // inherit that witness's driver rows (they were unregistered in its
      // cleanup tail) or trust its live image: it re-registers both
      // drivers and rebuilds/seals/publishes the two-record image from
      // scratch, so it stands alone and its failures are attributable to
      // this issue's code.
      //
      // Design: design/drivers/registry-v2.md §8 (lookup + hot-reload),
      // §9 (snapshot ring + rollback).
      //
      // Stage map (written to _registry_lookup_witness_stage before every
      // gate, so a failure names its sub-test without a debugger):
      //
      //   Setup
      //    0  driver_table_register(slot 0, uart-16550, pid 7)
      //    1  driver_lifecycle_transition(slot 0 -> RUNNING)
      //    2  driver_table_register(slot 1, nvme-pcie, pid 9)  [stays INIT]
      //    3  registry_snapshot_init()
      //    4  registry_v2_header_init(2)
      //    5  record_encode(0, slot 0, v1.4.2, caps 0xC000,  eff 0x0F)
      //    6  record_encode(1, slot 1, v2.1.0, caps 0x34000, eff 0x13)
      //    7  seal(2) + validate(live)
      //    8  publish(2)
      //   Lookup by name
      //    9  by_name("uart-16550", 10) == 0
      //   10  by_name("nvme-pcie",   9) == 1
      //   11  by_name("uart",        4) == ERR_NOT_FOUND   [prefix != name]
      //   12  by_name("e1000e",      6) == ERR_NOT_FOUND   [absent]
      //   13  by_name(_, 17)             == ERR_BAD_NAME   [key wider than field]
      //   Lookup by slot
      //   14  by_slot(0)  == 0
      //   15  by_slot(1)  == 1
      //   16  by_slot(5)  == ERR_NOT_FOUND   [slot valid, no record]
      //   17  by_slot(32) == ERR_NOT_FOUND   [slot out of range]
      //   Hot-reload, no-op path
      //   18  reload(2) == OK and reload_changed() == 0
      //   Snapshot + rollback
      //   19  snapshot() -> id (stashed in _registry_lookup_witness_snap)
      //   20  mutate record 1's cap manifest to 0x40000, reseal, publish
      //   21  field(live, 1, cap_lo) == 0x40000   [mutation present]
      //   22  rollback(id) == OK
      //   23  field(live, 1, cap_lo) == 0x34000   [mutation gone in memory]
      //   24  validate(live) == 0                 [post-rollback fsck clean]
      //   25  persist_load(2) == 0 and field(scratch, 1, cap_lo) == 0x34000
      //                                           [mutation gone on disk too]
      //   26  rollback(id + 100) == ERR_BAD_SNAPSHOT   [never existed]
      //   27  rollback(0)        == ERR_BAD_SNAPSHOT   [id 0 is not an id]
      //   Hot-reload, RUNNING-conflict path
      //   28  publish a divergent record 0 (caps 0xF000) to disk
      //   29  restore record 0 in memory only (caps 0xC000), reseal, fsck
      //   30  reload(2) == ERR_RELOAD_CONFLICT   [slot 0 is RUNNING]
      //   31  field(live, 0, cap_lo) == 0xC000   [live image untouched]
      //   Hot-reload, adopt path
      //   32  publish a divergent record 1 (caps 0x54000) to disk
      //   33  restore record 1 in memory only (caps 0x34000), reseal
      //   34  reload(2) == OK, reload_changed() == 1,
      //       field(live, 1, cap_lo) == 0x54000  [adopted: slot 1 is INIT]
      //   35  gen_id() == 2                      [rollback + adopt, no more]
      //
      // Stage 29/33 are the load-bearing trick: encode + seal are
      // memory-only, so they produce a live image that deliberately
      // disagrees with the file WITHOUT going through publish. That is the
      // only way to hand registry_reload a candidate that differs from the
      // live view, which is exactly what a real out-of-band registry edit
      // would look like.
      //
      // Register plan (across nested calls):
      //   r12 = live image VA
      //   r13 = read-back scratch VA (candidate image)
      //   r14 = snapshot id
      //
      // Marker ordering in the golden log:
      //   R29 REGISTRY V2 OK      (#1028/#1029)
      //   R29 REGISTRY LOOKUP OK  <- THIS WITNESS
      // ============================================================
      registry_lookup_witness:
          // --- Stage 0: register driver slot 0 (uart-16550, pid 7) ---
          xor  rax, rax
          lea  rcx, [rip + _registry_lookup_witness_stage]
          mov  [rcx + 0], rax
          xor  rdi, rdi
          mov  rsi, 7
          lea  rdx, [rip + _registry_v2_witness_name0]
          mov  rcx, 0x100
          call driver_table_register
          cmp  rax, 0
          jne  registry_lookup_witness_fail

          // --- Stage 1: drive slot 0 Init -> Running. This is the state
          //     the hot-reload conflict rule keys on ---
          mov  rax, 1
          lea  rcx, [rip + _registry_lookup_witness_stage]
          mov  [rcx + 0], rax
          xor  rdi, rdi
          mov  rsi, 1                              // DRIVER_STATE_RUNNING
          call driver_lifecycle_transition
          cmp  rax, 0
          jne  registry_lookup_witness_fail

          // --- Stage 2: register driver slot 1 (nvme-pcie, pid 9).
          //     Left at DRIVER_STATE_INIT — the reload rule must let its
          //     record change freely ---
          mov  rax, 2
          lea  rcx, [rip + _registry_lookup_witness_stage]
          mov  [rcx + 0], rax
          mov  rdi, 1
          mov  rsi, 9
          lea  rdx, [rip + _registry_v2_witness_name1]
          mov  rcx, 0x200
          call driver_table_register
          cmp  rax, 0
          jne  registry_lookup_witness_fail

          // --- Stage 3: clear the snapshot ring's bookkeeping ---
          mov  rax, 3
          lea  rcx, [rip + _registry_lookup_witness_stage]
          mov  [rcx + 0], rax
          call registry_snapshot_init
          cmp  rax, 0
          jne  registry_lookup_witness_fail

          // --- Stage 4: header_init(2) ---
          mov  rax, 4
          lea  rcx, [rip + _registry_lookup_witness_stage]
          mov  [rcx + 0], rax
          mov  rdi, 2
          call registry_v2_header_init
          cmp  rax, 0
          jne  registry_lookup_witness_fail

          // --- Stage 5: encode record 0 from slot 0 ---
          mov  rax, 5
          lea  rcx, [rip + _registry_lookup_witness_stage]
          mov  [rcx + 0], rax
          xor  rdi, rdi
          xor  rsi, rsi
          mov  rdx, 0x0000000100040002             // 1.4.2
          mov  rcx, 0xC000
          mov  r8,  0x0F
          call registry_v2_record_encode
          cmp  rax, 0
          jne  registry_lookup_witness_fail

          // --- Stage 6: encode record 1 from slot 1 ---
          mov  rax, 6
          lea  rcx, [rip + _registry_lookup_witness_stage]
          mov  [rcx + 0], rax
          mov  rdi, 1
          mov  rsi, 1
          mov  rdx, 0x0000000200010000             // 2.1.0
          mov  rcx, 0x34000
          mov  r8,  0x13
          call registry_v2_record_encode
          cmp  rax, 0
          jne  registry_lookup_witness_fail

          // --- Stage 7: seal + fsck the live image ---
          mov  rax, 7
          lea  rcx, [rip + _registry_lookup_witness_stage]
          mov  [rcx + 0], rax
          mov  rdi, 2
          call registry_v2_seal
          cmp  rax, 0
          jne  registry_lookup_witness_fail
          call registry_v2_buf_addr
          mov  r12, rax                            // r12 = live image VA
          mov  rdi, r12
          call registry_v2_validate
          cmp  rax, 0
          jne  registry_lookup_witness_fail

          // --- Stage 8: publish, so the file and the live view agree ---
          mov  rax, 8
          lea  rcx, [rip + _registry_lookup_witness_stage]
          mov  [rcx + 0], rax
          mov  rdi, 2
          call registry_persist_publish
          cmp  rax, 0
          jne  registry_lookup_witness_fail

          // --- Stage 9: lookup_by_name("uart-16550") -> record 0 ---
          mov  rax, 9
          lea  rcx, [rip + _registry_lookup_witness_stage]
          mov  [rcx + 0], rax
          mov  rdi, r12
          lea  rsi, [rip + _registry_v2_witness_name0]
          mov  rdx, 10                             // len("uart-16550")
          call registry_lookup_by_name
          cmp  rax, 0
          jne  registry_lookup_witness_fail

          // --- Stage 10: lookup_by_name("nvme-pcie") -> record 1 ---
          mov  rax, 10
          lea  rcx, [rip + _registry_lookup_witness_stage]
          mov  [rcx + 0], rax
          mov  rdi, r12
          lea  rsi, [rip + _registry_v2_witness_name1]
          mov  rdx, 9                              // len("nvme-pcie")
          call registry_lookup_by_name
          cmp  rax, 1
          jne  registry_lookup_witness_fail

          // --- Stage 11: a PREFIX of a stored name must miss. Without
          //     the terminator check in registry_lookup_by_name this
          //     would return record 0 and hand the caller another
          //     driver's entitlements ---
          mov  rax, 11
          lea  rcx, [rip + _registry_lookup_witness_stage]
          mov  [rcx + 0], rax
          mov  rdi, r12
          lea  rsi, [rip + _registry_v2_witness_name0]
          mov  rdx, 4                              // "uart"
          call registry_lookup_by_name
          mov  rcx, 0xFFFFFD40                     // ERR_NOT_FOUND
          cmp  rax, rcx
          jne  registry_lookup_witness_fail

          // --- Stage 12: a name no record carries misses ---
          mov  rax, 12
          lea  rcx, [rip + _registry_lookup_witness_stage]
          mov  [rcx + 0], rax
          mov  rdi, r12
          lea  rsi, [rip + _registry_lookup_witness_miss]
          mov  rdx, 6                              // "e1000e"
          call registry_lookup_by_name
          mov  rcx, 0xFFFFFD40                     // ERR_NOT_FOUND
          cmp  rax, rcx
          jne  registry_lookup_witness_fail

          // --- Stage 13: a key wider than the 16-byte name field is a
          //     malformed request, not a miss ---
          mov  rax, 13
          lea  rcx, [rip + _registry_lookup_witness_stage]
          mov  [rcx + 0], rax
          mov  rdi, r12
          lea  rsi, [rip + _registry_v2_witness_name0]
          mov  rdx, 17
          call registry_lookup_by_name
          mov  rcx, 0xFFFFFD41                     // ERR_BAD_NAME
          cmp  rax, rcx
          jne  registry_lookup_witness_fail

          // --- Stage 14: lookup_by_slot(0) -> record 0 ---
          mov  rax, 14
          lea  rcx, [rip + _registry_lookup_witness_stage]
          mov  [rcx + 0], rax
          mov  rdi, r12
          xor  rsi, rsi
          call registry_lookup_by_slot
          cmp  rax, 0
          jne  registry_lookup_witness_fail

          // --- Stage 15: lookup_by_slot(1) -> record 1 ---
          mov  rax, 15
          lea  rcx, [rip + _registry_lookup_witness_stage]
          mov  [rcx + 0], rax
          mov  rdi, r12
          mov  rsi, 1
          call registry_lookup_by_slot
          cmp  rax, 1
          jne  registry_lookup_witness_fail

          // --- Stage 16: an in-range slot with no record misses ---
          mov  rax, 16
          lea  rcx, [rip + _registry_lookup_witness_stage]
          mov  [rcx + 0], rax
          mov  rdi, r12
          mov  rsi, 5
          call registry_lookup_by_slot
          mov  rcx, 0xFFFFFD40                     // ERR_NOT_FOUND
          cmp  rax, rcx
          jne  registry_lookup_witness_fail

          // --- Stage 17: an out-of-range slot misses rather than
          //     erroring — "is there a record for slot 32" has the honest
          //     answer "no" ---
          mov  rax, 17
          lea  rcx, [rip + _registry_lookup_witness_stage]
          mov  [rcx + 0], rax
          mov  rdi, r12
          mov  rsi, 32
          call registry_lookup_by_slot
          mov  rcx, 0xFFFFFD40                     // ERR_NOT_FOUND
          cmp  rax, rcx
          jne  registry_lookup_witness_fail

          // --- Stage 18: hot-reload against an unchanged file. The
          //     polling fast path: OK, nothing adopted, no generation
          //     bump ---
          mov  rax, 18
          lea  rcx, [rip + _registry_lookup_witness_stage]
          mov  [rcx + 0], rax
          mov  rdi, 2
          call registry_reload
          cmp  rax, 0
          jne  registry_lookup_witness_fail
          call registry_reload_changed
          cmp  rax, 0
          jne  registry_lookup_witness_fail

          // --- Stage 19: snapshot the known-good image ---
          mov  rax, 19
          lea  rcx, [rip + _registry_lookup_witness_stage]
          mov  [rcx + 0], rax
          call registry_snapshot
          cmp  rax, 0
          je   registry_lookup_witness_fail        // id 0 is never valid
          mov  rcx, 0xFFFFFD00
          cmp  rax, rcx
          jae  registry_lookup_witness_fail        // an error code, not an id
          mov  r14, rax                            // r14 = snapshot id
          lea  rcx, [rip + _registry_lookup_witness_snap]
          mov  [rcx + 0], r14

          // --- Stage 20: mutate record 1's capability manifest and
          //     publish it, so both memory and disk carry the mutation ---
          mov  rax, 20
          lea  rcx, [rip + _registry_lookup_witness_stage]
          mov  [rcx + 0], rax
          mov  rdi, 1
          mov  rsi, 1
          mov  rdx, 0x0000000200010000
          mov  rcx, 0x40000                        // mutated manifest
          mov  r8,  0x13
          call registry_v2_record_encode
          cmp  rax, 0
          jne  registry_lookup_witness_fail
          mov  rdi, 2
          call registry_v2_seal
          cmp  rax, 0
          jne  registry_lookup_witness_fail
          mov  rdi, 2
          call registry_persist_publish
          cmp  rax, 0
          jne  registry_lookup_witness_fail

          // --- Stage 21: the mutation is really there ---
          mov  rax, 21
          lea  rcx, [rip + _registry_lookup_witness_stage]
          mov  [rcx + 0], rax
          mov  rdi, r12
          mov  rsi, 1
          mov  rdx, 32                             // REC_OFF_CAP_LO
          call registry_v2_field
          mov  rcx, 0x40000
          cmp  rax, rcx
          jne  registry_lookup_witness_fail

          // --- Stage 22: roll back to the snapshot ---
          mov  rax, 22
          lea  rcx, [rip + _registry_lookup_witness_stage]
          mov  [rcx + 0], rax
          mov  rdi, r14
          call registry_rollback
          cmp  rax, 0
          jne  registry_lookup_witness_fail

          // --- Stage 23: the mutation is gone from the live image ---
          mov  rax, 23
          lea  rcx, [rip + _registry_lookup_witness_stage]
          mov  [rcx + 0], rax
          mov  rdi, r12
          mov  rsi, 1
          mov  rdx, 32
          call registry_v2_field
          mov  rcx, 0x34000
          cmp  rax, rcx
          jne  registry_lookup_witness_fail

          // --- Stage 24: post-rollback fsck is clean ---
          mov  rax, 24
          lea  rcx, [rip + _registry_lookup_witness_stage]
          mov  [rcx + 0], rax
          mov  rdi, r12
          call registry_v2_validate
          cmp  rax, 0
          jne  registry_lookup_witness_fail

          // --- Stage 25: and the FILE carries the rollback too, which is
          //     what proves rollback went through the publish path rather
          //     than only touching memory ---
          mov  rax, 25
          lea  rcx, [rip + _registry_lookup_witness_stage]
          mov  [rcx + 0], rax
          mov  rdi, 2
          call registry_persist_load
          cmp  rax, 0
          jne  registry_lookup_witness_fail
          call registry_persist_scratch_addr
          mov  r13, rax                            // r13 = candidate VA
          mov  rdi, r13
          mov  rsi, 1
          mov  rdx, 32
          call registry_v2_field
          mov  rcx, 0x34000
          cmp  rax, rcx
          jne  registry_lookup_witness_fail

          // --- Stage 26: an id that was never issued is rejected ---
          mov  rax, 26
          lea  rcx, [rip + _registry_lookup_witness_stage]
          mov  [rcx + 0], rax
          mov  rdi, r14
          add  rdi, 100
          call registry_rollback
          mov  rcx, 0xFFFFFD50                     // ERR_BAD_SNAPSHOT
          cmp  rax, rcx
          jne  registry_lookup_witness_fail

          // --- Stage 27: id 0 is the empty-slot marker, never an id ---
          mov  rax, 27
          lea  rcx, [rip + _registry_lookup_witness_stage]
          mov  [rcx + 0], rax
          xor  rdi, rdi
          call registry_rollback
          mov  rcx, 0xFFFFFD50                     // ERR_BAD_SNAPSHOT
          cmp  rax, rcx
          jne  registry_lookup_witness_fail

          // --- Stage 28: write a divergent record 0 (the RUNNING
          //     driver's) to the FILE ---
          mov  rax, 28
          lea  rcx, [rip + _registry_lookup_witness_stage]
          mov  [rcx + 0], rax
          xor  rdi, rdi
          xor  rsi, rsi
          mov  rdx, 0x0000000100040002
          mov  rcx, 0xF000                         // divergent manifest
          mov  r8,  0x0F
          call registry_v2_record_encode
          cmp  rax, 0
          jne  registry_lookup_witness_fail
          mov  rdi, 2
          call registry_v2_seal
          cmp  rax, 0
          jne  registry_lookup_witness_fail
          mov  rdi, 2
          call registry_persist_publish
          cmp  rax, 0
          jne  registry_lookup_witness_fail

          // --- Stage 29: restore record 0 IN MEMORY ONLY (encode + seal
          //     never touch the file), so the live view and the file now
          //     disagree exactly the way an out-of-band registry edit
          //     would make them disagree ---
          mov  rax, 29
          lea  rcx, [rip + _registry_lookup_witness_stage]
          mov  [rcx + 0], rax
          xor  rdi, rdi
          xor  rsi, rsi
          mov  rdx, 0x0000000100040002
          mov  rcx, 0xC000                         // original manifest
          mov  r8,  0x0F
          call registry_v2_record_encode
          cmp  rax, 0
          jne  registry_lookup_witness_fail
          mov  rdi, 2
          call registry_v2_seal
          cmp  rax, 0
          jne  registry_lookup_witness_fail
          mov  rdi, r12
          call registry_v2_validate
          cmp  rax, 0
          jne  registry_lookup_witness_fail

          // --- Stage 30: the reload is refused: record 0 belongs to
          //     driver_table slot 0, which is RUNNING, and the candidate
          //     changes its capability manifest ---
          mov  rax, 30
          lea  rcx, [rip + _registry_lookup_witness_stage]
          mov  [rcx + 0], rax
          mov  rdi, 2
          call registry_reload
          mov  rcx, 0xFFFFFD42                     // ERR_RELOAD_CONFLICT
          cmp  rax, rcx
          jne  registry_lookup_witness_fail

          // --- Stage 31: and the refusal left the live image alone ---
          mov  rax, 31
          lea  rcx, [rip + _registry_lookup_witness_stage]
          mov  [rcx + 0], rax
          mov  rdi, r12
          xor  rsi, rsi
          mov  rdx, 32
          call registry_v2_field
          mov  rcx, 0xC000
          cmp  rax, rcx
          jne  registry_lookup_witness_fail

          // --- Stage 32: same experiment against the NON-running driver.
          //     Publishing here also repairs the file's record 0, so the
          //     only remaining divergence is record 1 ---
          mov  rax, 32
          lea  rcx, [rip + _registry_lookup_witness_stage]
          mov  [rcx + 0], rax
          mov  rdi, 1
          mov  rsi, 1
          mov  rdx, 0x0000000200010000
          mov  rcx, 0x54000                        // new manifest
          mov  r8,  0x13
          call registry_v2_record_encode
          cmp  rax, 0
          jne  registry_lookup_witness_fail
          mov  rdi, 2
          call registry_v2_seal
          cmp  rax, 0
          jne  registry_lookup_witness_fail
          mov  rdi, 2
          call registry_persist_publish
          cmp  rax, 0
          jne  registry_lookup_witness_fail

          // --- Stage 33: put record 1 back in memory only ---
          mov  rax, 33
          lea  rcx, [rip + _registry_lookup_witness_stage]
          mov  [rcx + 0], rax
          mov  rdi, 1
          mov  rsi, 1
          mov  rdx, 0x0000000200010000
          mov  rcx, 0x34000
          mov  r8,  0x13
          call registry_v2_record_encode
          cmp  rax, 0
          jne  registry_lookup_witness_fail
          mov  rdi, 2
          call registry_v2_seal
          cmp  rax, 0
          jne  registry_lookup_witness_fail

          // --- Stage 34: this reload IS adopted — slot 1 is INIT, so
          //     nothing is executing against the old manifest. Exactly
          //     one record differed ---
          mov  rax, 34
          lea  rcx, [rip + _registry_lookup_witness_stage]
          mov  [rcx + 0], rax
          mov  rdi, 2
          call registry_reload
          cmp  rax, 0
          jne  registry_lookup_witness_fail
          call registry_reload_changed
          cmp  rax, 1
          jne  registry_lookup_witness_fail
          mov  rdi, r12
          mov  rsi, 1
          mov  rdx, 32
          call registry_v2_field
          mov  rcx, 0x54000
          cmp  rax, rcx
          jne  registry_lookup_witness_fail

          // --- Stage 35: exactly two adoptions happened — the rollback
          //     at stage 22 and the reload at stage 34. The no-op reload
          //     at stage 18 and the refused reload at stage 30 must not
          //     have moved the generation ---
          mov  rax, 35
          lea  rcx, [rip + _registry_lookup_witness_stage]
          mov  [rcx + 0], rax
          call registry_gen_id
          cmp  rax, 2
          jne  registry_lookup_witness_fail

          // --- Cleanup: release both driver rows so downstream witnesses
          //     see a fresh table ---
          xor  rdi, rdi
          call driver_table_unregister
          mov  rdi, 1
          call driver_table_unregister

          // Success marker: R29 REGISTRY LOOKUP OK.
          mov  rdi, 3                              // LEVEL_INFO
          lea  rsi, [rip + SUBSYS_BOOT]
          lea  rdx, [rip + registry_lookup_ok_msg]
          call klog_s1
          jmp  registry_lookup_witness_done

      registry_lookup_witness_fail:
          lea  rax, [rip + _registry_lookup_witness_stage]
          mov  r8,  [rax + 0]
          mov  rdi, 1                              // LEVEL_ERROR
          lea  rsi, [rip + SUBSYS_BOOT]
          lea  rdx, [rip + registry_lookup_fail_msg]
          lea  rcx, [rip + k_line]
          call klog_s1_d1

      registry_lookup_witness_done:

      // ============================================================
      // R29.M4-001/002 (#1032/#1033): pinned keyring + driver-artifact
      // signature verifier witness.
      //
      // Modules under test:
      //   src/kernel/core/driver/keyring.pdx     (#1033)
      //   src/kernel/core/driver/sig_verify.pdx  (#1032)
      // Policy: design/drivers/blob-policy.md §1.7 (verdict taxonomy),
      //         §1.8 (keyring layout + embedding).
      //
      // The single most important assertion in this witness is stage 15.
      // The whole tree is in the all-zero-signature scaffold epoch, so
      // every signature field the build produces is 1952/3309 zero bytes.
      // The failure mode that would matter — the one that survives to
      // R32 and quietly defeats the trust root — is a zero signature
      // being read as a valid one. Stage 14 proves a well-formed
      // artifact with an all-zero signature yields SIG_UNSIGNED_SCAFFOLD
      // (1), and stage 15 proves driver_sig_verdict_is_ok rejects that
      // verdict. SIG_OK (0) is not returned by any path in sig_verify.pdx
      // at R29; stage 16 pins the predicate's positive arm so the two
      // halves of the contract are both nailed down.
      //
      // Stage map (written to _sig_witness_stage before every gate):
      //   Keyring
      //    0  keyring_fsck() == KEYRING_OK
      //    1  keyring_fsck_bad_role() == 3            ["none recorded"]
      //    2  keyring_role_count() == 3
      //    3  keyring_lookup(PAIDEIA_ROOT) -> address   [r12]
      //    4  keyring_lookup(VENDOR_INTEL) -> address   [r13]
      //    5  keyring_lookup(VENDOR_REALTEK) -> address [r14]
      //    6  the three addresses are pairwise distinct
      //    7  all three addresses are 64-byte aligned
      //    8  keyring_lookup(3) == ERR_NO_SUCH_KEY      [miss, off end]
      //    9  keyring_lookup(0x1000) == ERR_NO_SUCH_KEY [miss, far]
      //   10  keyring_meta_field(INTEL, 2) == 1952      [declared pk_len]
      //   11  keyring_meta_field(ROOT, 4) == ERR_BAD_ROLE_ID [field OOR]
      //   12  fingerprint(ROOT) != 0 and == fingerprint(INTEL)
      //       [scaffold epoch: all three keys are the same 1952 zeros]
      //   13  keyring_keys_distinct() == 0              [same reason]
      //   Verifier
      //   14  driver_sig_scaffold_epoch() == 1
      //   15  verify(artifact, 64, zero_sig, 3309, pk) == 1
      //       == SIG_UNSIGNED_SCAFFOLD                  [NOT SIG_OK]
      //   16  driver_sig_verdict_is_ok(SIG_UNSIGNED_SCAFFOLD) == 0
      //       <- THE assertion this whole witness exists for
      //   17  driver_sig_verdict_is_ok(SIG_OK) == 1
      //   18  verify(..., sig_len = 3308, ...) == SIG_BAD_LENGTH
      //   19  verify(..., sig_len = 0, ...)    == SIG_BAD_LENGTH
      //   20  verify(artifact = 0, ...)        == SIG_BAD_ARTIFACT
      //   21  verify(artifact_len = 0, ...)    == SIG_BAD_ARTIFACT_LEN
      //   22  verify(sig_ptr = 0, ...)         == SIG_BAD_SIG_PTR
      //   23  verify(pk_ptr = 0, ...)          == SIG_BAD_PK_PTR
      //   24  verify(pk_ptr = pk + 1, ...)     == SIG_BAD_PK_ALIGN
      //   25  verify_algo(algo = 2, ...)       == SIG_BAD_ALGO
      //   26  dirty the LAST byte of the signature buffer, then
      //       verify(...) == SIG_UNVERIFIABLE            [NOT SIG_OK]
      //   27  restore that byte; verify(...) == SIG_UNSIGNED_SCAFFOLD
      //       again — proves stage 26 flipped on the buffer content and
      //       that the all-zero scan really does reach byte 3308
      //   28  driver_sig_all_zero(sig, 0) == 0
      //       ["nothing examined" must not read as "clean"]
      //
      // Stage 26 dirties byte 3308 rather than byte 0 deliberately: a
      // scan with an off-by-one bound would still catch a first-byte
      // change, and would still be wrong. The last byte is the only one
      // that distinguishes a correct bound from a short one.
      //
      // Register plan (across nested calls):
      //   r12 = paideia_root pk address
      //   r13 = vendor_intel pk address
      //   r14 = vendor_realtek pk address
      //   r15 = signature-buffer base
      //
      // Marker ordering in the golden log:
      //   R29 REGISTRY LOOKUP OK  (#1030/#1031)
      //   R29 SIG KEYRING OK      <- THIS WITNESS
      // ============================================================
      sig_keyring_witness:
          // --- Stage 0: the keyring is internally consistent ---
          xor  rax, rax
          lea  rcx, [rip + _sig_witness_stage]
          mov  [rcx + 0], rax
          call keyring_fsck
          cmp  rax, 0                              // KEYRING_OK
          jne  sig_keyring_witness_fail

          // --- Stage 1: a clean fsck records no offending role ---
          mov  rax, 1
          lea  rcx, [rip + _sig_witness_stage]
          mov  [rcx + 0], rax
          call keyring_fsck_bad_role
          cmp  rax, 3                              // KEYRING_ROLE_COUNT
          jne  sig_keyring_witness_fail

          // --- Stage 2: three roles ---
          mov  rax, 2
          lea  rcx, [rip + _sig_witness_stage]
          mov  [rcx + 0], rax
          call keyring_role_count
          cmp  rax, 3
          jne  sig_keyring_witness_fail

          // --- Stage 3: paideia_root resolves ---
          mov  rax, 3
          lea  rcx, [rip + _sig_witness_stage]
          mov  [rcx + 0], rax
          xor  rdi, rdi                            // KEYRING_ROLE_PAIDEIA_ROOT
          call keyring_lookup
          cmp  rax, 0
          je   sig_keyring_witness_fail
          mov  rcx, 0xFFFFFD60                     // ERR_NO_SUCH_KEY
          cmp  rax, rcx
          je   sig_keyring_witness_fail
          mov  r12, rax

          // --- Stage 4: vendor_intel resolves ---
          mov  rax, 4
          lea  rcx, [rip + _sig_witness_stage]
          mov  [rcx + 0], rax
          mov  rdi, 1                              // KEYRING_ROLE_VENDOR_INTEL
          call keyring_lookup
          cmp  rax, 0
          je   sig_keyring_witness_fail
          mov  rcx, 0xFFFFFD60
          cmp  rax, rcx
          je   sig_keyring_witness_fail
          mov  r13, rax

          // --- Stage 5: vendor_realtek resolves ---
          mov  rax, 5
          lea  rcx, [rip + _sig_witness_stage]
          mov  [rcx + 0], rax
          mov  rdi, 2                              // KEYRING_ROLE_VENDOR_REALTEK
          call keyring_lookup
          cmp  rax, 0
          je   sig_keyring_witness_fail
          mov  rcx, 0xFFFFFD60
          cmp  rax, rcx
          je   sig_keyring_witness_fail
          mov  r14, rax

          // --- Stage 6: three roles, three distinct blobs. The key
          //     BYTES are identical at this epoch, but the storage must
          //     not be aliased — R32 replaces the files one at a time ---
          mov  rax, 6
          lea  rcx, [rip + _sig_witness_stage]
          mov  [rcx + 0], rax
          cmp  r12, r13
          je   sig_keyring_witness_fail
          cmp  r12, r14
          je   sig_keyring_witness_fail
          cmp  r13, r14
          je   sig_keyring_witness_fail

          // --- Stage 7: every key is 64-byte aligned. sig_verify gate 7
          //     uses alignment as the proxy for keyring provenance, so a
          //     keyring that handed out an unaligned key would make its
          //     own keys unusable ---
          mov  rax, 7
          lea  rcx, [rip + _sig_witness_stage]
          mov  [rcx + 0], rax
          mov  rax, r12
          and  rax, 63
          cmp  rax, 0
          jne  sig_keyring_witness_fail
          mov  rax, r13
          and  rax, 63
          cmp  rax, 0
          jne  sig_keyring_witness_fail
          mov  rax, r14
          and  rax, 63
          cmp  rax, 0
          jne  sig_keyring_witness_fail

          // --- Stage 8: the first role id past the end misses ---
          mov  rax, 8
          lea  rcx, [rip + _sig_witness_stage]
          mov  [rcx + 0], rax
          mov  rdi, 3
          call keyring_lookup
          mov  rcx, 0xFFFFFD60                     // ERR_NO_SUCH_KEY
          cmp  rax, rcx
          jne  sig_keyring_witness_fail

          // --- Stage 9: a far out-of-range role misses the same way,
          //     rather than indexing off the metadata table ---
          mov  rax, 9
          lea  rcx, [rip + _sig_witness_stage]
          mov  [rcx + 0], rax
          mov  rdi, 0x1000
          call keyring_lookup
          mov  rcx, 0xFFFFFD60
          cmp  rax, rcx
          jne  sig_keyring_witness_fail

          // --- Stage 10: the declared public-key length is ML-DSA-65's ---
          mov  rax, 10
          lea  rcx, [rip + _sig_witness_stage]
          mov  [rcx + 0], rax
          mov  rdi, 1                              // VENDOR_INTEL
          mov  rsi, 2                              // field 2 = pk_len
          call keyring_meta_field
          mov  rcx, 1952                           // KEYRING_PK_BYTES
          cmp  rax, rcx
          jne  sig_keyring_witness_fail

          // --- Stage 11: an out-of-range FIELD index is rejected, not
          //     read. The 96-byte table abuts 5856 bytes of key
          //     material; an unchecked index would return key bytes ---
          mov  rax, 11
          lea  rcx, [rip + _sig_witness_stage]
          mov  [rcx + 0], rax
          xor  rdi, rdi
          mov  rsi, 4
          call keyring_meta_field
          mov  rcx, 0xFFFFFD61                     // ERR_BAD_ROLE_ID
          cmp  rax, rcx
          jne  sig_keyring_witness_fail

          // --- Stage 12: fingerprints. At the scaffold epoch all three
          //     keys are the same 1952 zero bytes, so root and intel
          //     MUST hash alike; the hash must still be non-zero,
          //     because an FNV-1a of zeros is the mixed offset basis,
          //     not zero. R32 flips the equality ---
          mov  rax, 12
          lea  rcx, [rip + _sig_witness_stage]
          mov  [rcx + 0], rax
          xor  rdi, rdi
          call keyring_fingerprint
          cmp  rax, 0
          je   sig_keyring_witness_fail
          mov  r13, rax
          mov  rdi, 1
          call keyring_fingerprint
          cmp  rax, r13
          jne  sig_keyring_witness_fail

          // --- Stage 13: and therefore the ring is NOT distinct yet.
          //     Pinned so the R32 key drop is forced to update it ---
          mov  rax, 13
          lea  rcx, [rip + _sig_witness_stage]
          mov  [rcx + 0], rax
          call keyring_keys_distinct
          cmp  rax, 0
          jne  sig_keyring_witness_fail

          // --- Stage 14: the scaffold epoch is live ---
          mov  rax, 14
          lea  rcx, [rip + _sig_witness_stage]
          mov  [rcx + 0], rax
          call driver_sig_scaffold_epoch
          cmp  rax, 1
          jne  sig_keyring_witness_fail

          // r15 = signature buffer base (414 qwords = 3312 B).
          //
          // The witness constructs its own all-zero signature field
          // rather than trusting the declared initializer, so stage 15
          // tests the verifier and not the toolchain's data emission —
          // which is exactly how the paideia-as repeat-literal defect
          // noted at _sig_witness_sig was first mistaken for a verifier
          // bug. It also gives stage 27's restore a known baseline.
          lea  r15, [rip + _sig_witness_sig]
          mov  r8,  r15
          mov  rcx, 414

      sig_keyring_witness_zero:
          cmp  rcx, 0
          je   sig_keyring_witness_zeroed
          xor  rax, rax
          mov  [r8 + 0], rax
          add  r8,  8
          sub  rcx, 1
          jmp  sig_keyring_witness_zero

      sig_keyring_witness_zeroed:

          // --- Stage 15: a well-formed artifact with an all-zero
          //     signature yields SIG_UNSIGNED_SCAFFOLD (1), NOT SIG_OK ---
          mov  rax, 15
          lea  rcx, [rip + _sig_witness_stage]
          mov  [rcx + 0], rax
          lea  rdi, [rip + _sig_witness_artifact]
          mov  rsi, 64
          mov  rdx, r15
          mov  rcx, 3309
          mov  r8,  r12
          call driver_sig_verify
          cmp  rax, 1                              // SIG_UNSIGNED_SCAFFOLD
          jne  sig_keyring_witness_fail

          // --- Stage 16: THE assertion. That verdict is not a pass.
          //     If this ever holds the other way, an unsigned driver
          //     artifact loads as a signed one ---
          mov  rax, 16
          lea  rcx, [rip + _sig_witness_stage]
          mov  [rcx + 0], rax
          mov  rdi, 1                              // SIG_UNSIGNED_SCAFFOLD
          call driver_sig_verdict_is_ok
          cmp  rax, 0
          jne  sig_keyring_witness_fail

          // --- Stage 17: the predicate's positive arm still works, so
          //     stage 16 is not passing by being uniformly false ---
          mov  rax, 17
          lea  rcx, [rip + _sig_witness_stage]
          mov  [rcx + 0], rax
          xor  rdi, rdi                            // SIG_OK
          call driver_sig_verdict_is_ok
          cmp  rax, 1
          jne  sig_keyring_witness_fail

          // --- Stage 18: a signature one byte short of ML-DSA-65's
          //     3309 is a malformed request ---
          mov  rax, 18
          lea  rcx, [rip + _sig_witness_stage]
          mov  [rcx + 0], rax
          lea  rdi, [rip + _sig_witness_artifact]
          mov  rsi, 64
          mov  rdx, r15
          mov  rcx, 3308
          mov  r8,  r12
          call driver_sig_verify
          mov  rcx, 0xFFFFFD84                     // SIG_BAD_LENGTH
          cmp  rax, rcx
          jne  sig_keyring_witness_fail

          // --- Stage 19: and a zero-length signature is the same
          //     failure, not an empty-therefore-zero pass ---
          mov  rax, 19
          lea  rcx, [rip + _sig_witness_stage]
          mov  [rcx + 0], rax
          lea  rdi, [rip + _sig_witness_artifact]
          mov  rsi, 64
          mov  rdx, r15
          xor  rcx, rcx
          mov  r8,  r12
          call driver_sig_verify
          mov  rcx, 0xFFFFFD84                     // SIG_BAD_LENGTH
          cmp  rax, rcx
          jne  sig_keyring_witness_fail

          // --- Stage 20: null artifact ---
          mov  rax, 20
          lea  rcx, [rip + _sig_witness_stage]
          mov  [rcx + 0], rax
          xor  rdi, rdi
          mov  rsi, 64
          mov  rdx, r15
          mov  rcx, 3309
          mov  r8,  r12
          call driver_sig_verify
          mov  rcx, 0xFFFFFD81                     // SIG_BAD_ARTIFACT
          cmp  rax, rcx
          jne  sig_keyring_witness_fail

          // --- Stage 21: empty artifact. Signing nothing is not a
          //     degenerate success ---
          mov  rax, 21
          lea  rcx, [rip + _sig_witness_stage]
          mov  [rcx + 0], rax
          lea  rdi, [rip + _sig_witness_artifact]
          xor  rsi, rsi
          mov  rdx, r15
          mov  rcx, 3309
          mov  r8,  r12
          call driver_sig_verify
          mov  rcx, 0xFFFFFD82                     // SIG_BAD_ARTIFACT_LEN
          cmp  rax, rcx
          jne  sig_keyring_witness_fail

          // --- Stage 22: null signature pointer ---
          mov  rax, 22
          lea  rcx, [rip + _sig_witness_stage]
          mov  [rcx + 0], rax
          lea  rdi, [rip + _sig_witness_artifact]
          mov  rsi, 64
          xor  rdx, rdx
          mov  rcx, 3309
          mov  r8,  r12
          call driver_sig_verify
          mov  rcx, 0xFFFFFD83                     // SIG_BAD_SIG_PTR
          cmp  rax, rcx
          jne  sig_keyring_witness_fail

          // --- Stage 23: null public key ---
          mov  rax, 23
          lea  rcx, [rip + _sig_witness_stage]
          mov  [rcx + 0], rax
          lea  rdi, [rip + _sig_witness_artifact]
          mov  rsi, 64
          mov  rdx, r15
          mov  rcx, 3309
          xor  r8,  r8
          call driver_sig_verify
          mov  rcx, 0xFFFFFD85                     // SIG_BAD_PK_PTR
          cmp  rax, rcx
          jne  sig_keyring_witness_fail

          // --- Stage 24: a key one byte off the keyring's alignment did
          //     not come from the keyring ---
          mov  rax, 24
          lea  rcx, [rip + _sig_witness_stage]
          mov  [rcx + 0], rax
          lea  rdi, [rip + _sig_witness_artifact]
          mov  rsi, 64
          mov  rdx, r15
          mov  rcx, 3309
          mov  r8,  r12
          add  r8,  1
          call driver_sig_verify
          mov  rcx, 0xFFFFFD86                     // SIG_BAD_PK_ALIGN
          cmp  rax, rcx
          jne  sig_keyring_witness_fail

          // --- Stage 25: an algorithm this verifier does not implement
          //     is refused at the door, not verified under ML-DSA-65's
          //     parameter set ---
          mov  rax, 25
          lea  rcx, [rip + _sig_witness_stage]
          mov  [rcx + 0], rax
          mov  rdi, 2                              // not SIG_ALGO_ML_DSA_65
          lea  rsi, [rip + _sig_witness_artifact]
          mov  rdx, 64
          mov  rcx, r15
          mov  r8,  3309
          mov  r9,  r12
          call driver_sig_verify_algo
          mov  rcx, 0xFFFFFD80                     // SIG_BAD_ALGO
          cmp  rax, rcx
          jne  sig_keyring_witness_fail

          // --- Stage 26: dirty the LAST byte of the 3309-byte field.
          //     Real signature material with no substrate to judge it is
          //     SIG_UNVERIFIABLE — still not a pass. Byte 3308 rather
          //     than byte 0 because only the last byte distinguishes a
          //     correct scan bound from a short one ---
          mov  rax, 26
          lea  rcx, [rip + _sig_witness_stage]
          mov  [rcx + 0], rax
          mov  r8,  r15
          add  r8,  3308
          mov  rax, 0xA5
          mov_b [r8 + 0], rax
          lea  rdi, [rip + _sig_witness_artifact]
          mov  rsi, 64
          mov  rdx, r15
          mov  rcx, 3309
          mov  r8,  r12
          call driver_sig_verify
          mov  rcx, 0xFFFFFD87                     // SIG_UNVERIFIABLE
          cmp  rax, rcx
          jne  sig_keyring_witness_fail

          // --- Stage 27: restore it and the verdict returns to
          //     SIG_UNSIGNED_SCAFFOLD, proving stage 26 turned on the
          //     buffer content and not on some other difference ---
          mov  rax, 27
          lea  rcx, [rip + _sig_witness_stage]
          mov  [rcx + 0], rax
          mov  r8,  r15
          add  r8,  3308
          xor  rax, rax
          mov_b [r8 + 0], rax
          lea  rdi, [rip + _sig_witness_artifact]
          mov  rsi, 64
          mov  rdx, r15
          mov  rcx, 3309
          mov  r8,  r12
          call driver_sig_verify
          cmp  rax, 1                              // SIG_UNSIGNED_SCAFFOLD
          jne  sig_keyring_witness_fail

          // --- Stage 28: an empty buffer is not "all zero". Nothing
          //     examined must never read as examined and clean ---
          mov  rax, 28
          lea  rcx, [rip + _sig_witness_stage]
          mov  [rcx + 0], rax
          mov  rdi, r15
          xor  rsi, rsi
          call driver_sig_all_zero
          cmp  rax, 0
          jne  sig_keyring_witness_fail

          // Success marker: R29 SIG KEYRING OK.
          mov  rdi, 3                              // LEVEL_INFO
          lea  rsi, [rip + SUBSYS_BOOT]
          lea  rdx, [rip + sig_keyring_ok_msg]
          call klog_s1
          jmp  sig_keyring_witness_done

      sig_keyring_witness_fail:
          lea  rax, [rip + _sig_witness_stage]
          mov  r8,  [rax + 0]
          mov  rdi, 1                              // LEVEL_ERROR
          lea  rsi, [rip + SUBSYS_BOOT]
          lea  rdx, [rip + sig_keyring_fail_msg]
          lea  rcx, [rip + k_line]
          call klog_s1_d1

      sig_keyring_witness_done:

      // ============================================================
      // R29.M4-003/004 (#1034/#1035): blob-driver DUAL-SIGNATURE
      // enforcement + signing-failure telemetry witness.
      //
      // Under test:
      //   src/kernel/core/driver/blob_load.pdx      (#1034)
      //   src/kernel/core/driver/sig_telemetry.pdx  (#1035)
      // Policy: design/drivers/blob-policy.md §1.1 (two-key rule),
      //         §1.3.1 (parsed manifest), §1.9 (combined verdict table),
      //         §1.10 (audit record schema).
      //
      // The D1.a rule this witness exists to pin: a firmware blob is
      // trusted only if BOTH the vendor signature AND the Paideia
      // manifest re-sign verify. A blob with one valid signature is
      // REJECTED — stages 25 and 26 assert that in both directions,
      // which is the case an attacker constructs and the one a
      // single-signature verifier would wave through.
      //
      // At R29 sig_verify returns SIG_OK on no path, so both gates
      // answer SIG_UNSIGNED_SCAFFOLD and the combined verdict is
      // BLOB_UNSIGNED_SCAFFOLD (1) — never BLOB_OK (0). Stage 2 is the
      // assertion the whole witness exists for; stage 24 shows the
      // BLOB_OK arm is reachable ONLY from synthetic (SIG_OK, SIG_OK)
      // arguments no verifier path can produce today.
      //
      // Stage map (written to _blob_witness_stage before every gate):
      //    0  build a clean, well-formed manifest in .data
      //    1  clean load -> BLOB_UNSIGNED_SCAFFOLD              [NOT OK]
      //    2  blob_verdict_is_ok(BLOB_UNSIGNED_SCAFFOLD) == 0
      //       <- THE assertion
      //    3  blob_verdict_is_ok(BLOB_OK) == 1  [predicate not vacuous]
      //    4  dirty the LAST byte of vendor_sig  -> VENDOR_SIG_BAD
      //    5  restore -> BLOB_UNSIGNED_SCAFFOLD again
      //    6  dirty the LAST byte of paideia_sig -> PAIDEIA_SIG_BAD
      //    7  restore -> BLOB_UNSIGNED_SCAFFOLD again
      //    8  dirty BOTH                         -> BOTH_SIG_BAD
      //    9  restore both
      //   10  vendor_sig_len = 3308 -> VENDOR_SIG_BAD, and the raw
      //       per-gate verdicts read SIG_BAD_LENGTH / SCAFFOLD
      //   11  paideia_sig_len = 0   -> PAIDEIA_SIG_BAD
      //   12  blob_len 63 vs manifest 64 -> LEN_MISMATCH
      //   13  supplied digest != manifest.blob_hash -> HASH_MISMATCH
      //   14  supplied digest == manifest.blob_hash -> gate passes,
      //       pipeline continues, verdict is SCAFFOLD again
      //   15  magic          -> BAD_MAGIC
      //   16  version        -> BAD_VERSION
      //   17  hash_algo      -> BAD_HASH_ALGO
      //   18  vendor_role 0  -> BAD_VENDOR_ROLE  [paideia_root refused
      //       as a VENDOR key: it would collapse both gates onto one
      //       anchor and turn the dual signature into a single one]
      //   19  vendor_role 3  -> BAD_VENDOR_ROLE
      //   20  manifest_len 6783 -> BAD_MANIFEST_LEN
      //   21  manifest_ptr 0    -> BAD_MANIFEST_PTR
      //   22  blob_ptr 0        -> BAD_BLOB_PTR
      //   23  blob_len 0        -> BAD_BLOB_LEN
      //   24  combine(SIG_OK, SIG_OK)       == BLOB_OK
      //   25  combine(SIG_OK, SCAFFOLD)     == PAIDEIA_SIG_BAD
      //       <- single valid signature, REJECTED
      //   26  combine(SCAFFOLD, SIG_OK)     == VENDOR_SIG_BAD
      //       <- single valid signature, REJECTED (other direction)
      //   27  combine(SCAFFOLD, SCAFFOLD)   == BLOB_UNSIGNED_SCAFFOLD
      //   28  blob_hash_available() == 0 and blob_hash_compute ==
      //       BLOB_ERR_HASH_UNAVAILABLE   [SHA3-256 is an R32 dependency,
      //       reported rather than hand-rolled or skipped]
      //   29  blob_failed_gate maps each verdict to its gate id
      //   30  telemetry: a failing load appends exactly one record, and
      //       its verdict / gate / role / blob_len fields are right
      //   31  a failing load increments the ERROR-level counter
      //   32  a failing load grows the klog audit ring — the record
      //       reached the audit bridge and thus /system/audit/log.pdaudit
      //   33  a scaffold load increments WARN and NOT ERROR
      //   34  blob_audit_level maps OK/SCAFFOLD/failure to 3/2/1
      //
      // Stages 4 and 6 dirty the LAST byte of each 3309-byte field
      // rather than the first, for the reason sig_keyring_witness stage
      // 26 does: only the last byte distinguishes a correct scan bound
      // from a short one.
      //
      // Register plan (across nested calls):
      //   r15 = parsed-manifest base
      //   r14 = blob base
      //   r13 = scratch address for byte pokes
      // Snapshots live in _blob_witness_snap rather than a register, so
      // the assertions do not depend on klog's callee-save discipline.
      //
      // Marker ordering in the golden log:
      //   R29 SIG KEYRING OK      (#1032/#1033)
      //   R29 BLOB DUALSIG OK     <- THIS WITNESS
      // ============================================================
      blob_dualsig_witness:
          // --- Stage 0: build a clean, well-formed parsed manifest ---
          xor  rax, rax
          lea  rcx, [rip + _blob_witness_stage]
          mov  [rcx + 0], rax

          lea  r15, [rip + _blob_witness_manifest]
          lea  r14, [rip + _blob_witness_blob]

          // Zero all 848 qwords, then fill the header. Built at runtime
          // rather than trusted from an initializer for the same reason
          // sig_keyring_witness builds its signature buffer: the test is
          // of the verifier, not of the toolchain's data emission.
          mov  r8,  r15
          mov  rcx, 848
      blob_dualsig_witness_zero:
          cmp  rcx, 0
          je   blob_dualsig_witness_zeroed
          xor  rax, rax
          mov  [r8 + 0], rax
          add  r8,  8
          sub  rcx, 1
          jmp  blob_dualsig_witness_zero

      blob_dualsig_witness_zeroed:
          mov  rax, 0x50445853                     // 'PDXS'
          mov  [r15 + 0], rax
          mov  rax, 1
          mov  [r15 + 8], rax                      // version
          mov  [r15 + 16], rax                     // paideia_algo = ML-DSA-65
          mov  [r15 + 24], rax                     // vendor_algo  = ML-DSA-65
          mov  [r15 + 32], rax                     // vendor_role  = INTEL
          mov  [r15 + 40], rax                     // hash_algo    = SHA3-256
          mov  rax, 64
          mov  [r15 + 48], rax                     // blob_len
          mov  rax, 3309
          mov  [r15 + 64], rax                     // vendor_sig_len
          mov  [r15 + 72], rax                     // paideia_sig_len
          // blob_hash, signer/vendor pk ids and both signature fields
          // stay all-zero: the scaffold-epoch shape.

          // --- Stage 1: the clean load is UNSIGNED, not OK ---
          mov  rax, 1
          lea  rcx, [rip + _blob_witness_stage]
          mov  [rcx + 0], rax
          mov  rdi, r14
          mov  rsi, 64
          mov  rdx, r15
          mov  rcx, 6784
          call blob_load_verify
          cmp  rax, 1                              // BLOB_UNSIGNED_SCAFFOLD
          jne  blob_dualsig_witness_fail

          // --- Stage 2: THE assertion. That verdict is not a pass. If
          //     this ever holds the other way, an unsigned firmware blob
          //     loads as a dual-signed one ---
          mov  rax, 2
          lea  rcx, [rip + _blob_witness_stage]
          mov  [rcx + 0], rax
          mov  rdi, 1                              // BLOB_UNSIGNED_SCAFFOLD
          call blob_verdict_is_ok
          cmp  rax, 0
          jne  blob_dualsig_witness_fail

          // --- Stage 3: the predicate's positive arm still works, so
          //     stage 2 is not passing by being uniformly false ---
          mov  rax, 3
          lea  rcx, [rip + _blob_witness_stage]
          mov  [rcx + 0], rax
          xor  rdi, rdi                            // BLOB_OK
          call blob_verdict_is_ok
          cmp  rax, 1
          jne  blob_dualsig_witness_fail

          // --- Stage 4: vendor half malformed. The paideia half is
          //     still a clean scaffold, so the verdict must name the
          //     VENDOR gate and not collapse to "both bad" ---
          mov  rax, 4
          lea  rcx, [rip + _blob_witness_stage]
          mov  [rcx + 0], rax
          mov  r13, r15
          add  r13, 3468                           // vendor_sig + 3308
          mov  rax, 0xA5
          mov_b [r13 + 0], rax
          mov  rdi, r14
          mov  rsi, 64
          mov  rdx, r15
          mov  rcx, 6784
          call blob_load_verify
          mov  rcx, 0xFFFFFDAB                     // BLOB_ERR_VENDOR_SIG_BAD
          cmp  rax, rcx
          jne  blob_dualsig_witness_fail

          // --- Stage 5: restore; the verdict returns to the scaffold
          //     value, proving stage 4 turned on that one byte ---
          mov  rax, 5
          lea  rcx, [rip + _blob_witness_stage]
          mov  [rcx + 0], rax
          mov  r13, r15
          add  r13, 3468
          xor  rax, rax
          mov_b [r13 + 0], rax
          mov  rdi, r14
          mov  rsi, 64
          mov  rdx, r15
          mov  rcx, 6784
          call blob_load_verify
          cmp  rax, 1
          jne  blob_dualsig_witness_fail

          // --- Stage 6: paideia half malformed -> the PAIDEIA gate.
          //     Operationally distinct from stage 4: an unreviewed blob,
          //     not a tampered one ---
          mov  rax, 6
          lea  rcx, [rip + _blob_witness_stage]
          mov  [rcx + 0], rax
          mov  r13, r15
          add  r13, 6780                           // paideia_sig + 3308
          mov  rax, 0xA5
          mov_b [r13 + 0], rax
          mov  rdi, r14
          mov  rsi, 64
          mov  rdx, r15
          mov  rcx, 6784
          call blob_load_verify
          mov  rcx, 0xFFFFFDAC                     // BLOB_ERR_PAIDEIA_SIG_BAD
          cmp  rax, rcx
          jne  blob_dualsig_witness_fail

          // --- Stage 7: restore ---
          mov  rax, 7
          lea  rcx, [rip + _blob_witness_stage]
          mov  [rcx + 0], rax
          mov  r13, r15
          add  r13, 6780
          xor  rax, rax
          mov_b [r13 + 0], rax
          mov  rdi, r14
          mov  rsi, 64
          mov  rdx, r15
          mov  rcx, 6784
          call blob_load_verify
          cmp  rax, 1
          jne  blob_dualsig_witness_fail

          // --- Stage 8: both halves malformed -> BOTH_SIG_BAD. §1.5
          //     calls this catastrophic and alert-worthy ---
          mov  rax, 8
          lea  rcx, [rip + _blob_witness_stage]
          mov  [rcx + 0], rax
          mov  r13, r15
          add  r13, 3468
          mov  rax, 0xA5
          mov_b [r13 + 0], rax
          mov  r13, r15
          add  r13, 6780
          mov  rax, 0x5A
          mov_b [r13 + 0], rax
          mov  rdi, r14
          mov  rsi, 64
          mov  rdx, r15
          mov  rcx, 6784
          call blob_load_verify
          mov  rcx, 0xFFFFFDAD                     // BLOB_ERR_BOTH_SIG_BAD
          cmp  rax, rcx
          jne  blob_dualsig_witness_fail

          // --- Stage 9: restore both ---
          mov  rax, 9
          lea  rcx, [rip + _blob_witness_stage]
          mov  [rcx + 0], rax
          mov  r13, r15
          add  r13, 3468
          xor  rax, rax
          mov_b [r13 + 0], rax
          mov  r13, r15
          add  r13, 6780
          xor  rax, rax
          mov_b [r13 + 0], rax
          mov  rdi, r14
          mov  rsi, 64
          mov  rdx, r15
          mov  rcx, 6784
          call blob_load_verify
          cmp  rax, 1
          jne  blob_dualsig_witness_fail

          // --- Stage 10: a wrong-sized VENDOR signature field. The
          //     length is not checked in blob_manifest_check on purpose
          //     (see its header) precisely so the failure lands on the
          //     right half; the per-gate verdicts prove it did ---
          mov  rax, 10
          lea  rcx, [rip + _blob_witness_stage]
          mov  [rcx + 0], rax
          mov  rax, 3308
          mov  [r15 + 64], rax
          mov  rdi, r14
          mov  rsi, 64
          mov  rdx, r15
          mov  rcx, 6784
          call blob_load_verify
          mov  rcx, 0xFFFFFDAB                     // BLOB_ERR_VENDOR_SIG_BAD
          cmp  rax, rcx
          jne  blob_dualsig_witness_fail
          call blob_last_vendor_verdict
          mov  rcx, 0xFFFFFD84                     // SIG_BAD_LENGTH
          cmp  rax, rcx
          jne  blob_dualsig_witness_fail
          call blob_last_paideia_verdict
          cmp  rax, 1                              // SIG_UNSIGNED_SCAFFOLD
          jne  blob_dualsig_witness_fail
          mov  rax, 3309
          mov  [r15 + 64], rax

          // --- Stage 11: a zero-length PAIDEIA signature field ---
          mov  rax, 11
          lea  rcx, [rip + _blob_witness_stage]
          mov  [rcx + 0], rax
          xor  rax, rax
          mov  [r15 + 72], rax
          mov  rdi, r14
          mov  rsi, 64
          mov  rdx, r15
          mov  rcx, 6784
          call blob_load_verify
          mov  rcx, 0xFFFFFDAC                     // BLOB_ERR_PAIDEIA_SIG_BAD
          cmp  rax, rcx
          jne  blob_dualsig_witness_fail
          mov  rax, 3309
          mov  [r15 + 72], rax

          // --- Stage 12: the blob the caller holds is not the length
          //     the manifest describes ---
          mov  rax, 12
          lea  rcx, [rip + _blob_witness_stage]
          mov  [rcx + 0], rax
          mov  rdi, r14
          mov  rsi, 63
          mov  rdx, r15
          mov  rcx, 6784
          call blob_load_verify
          mov  rcx, 0xFFFFFDA8                     // BLOB_ERR_LEN_MISMATCH
          cmp  rax, rcx
          jne  blob_dualsig_witness_fail

          // --- Stage 13: a supplied digest that disagrees with
          //     manifest.blob_hash. This is the path R32's SHA3-256 will
          //     feed; the comparison and the verdict exist today ---
          mov  rax, 13
          lea  rcx, [rip + _blob_witness_stage]
          mov  [rcx + 0], rax
          lea  r13, [rip + _blob_witness_hash]
          mov  rax, 0xDEADBEEFCAFEF00D
          mov  [r13 + 0], rax
          mov  [r13 + 8], rax
          mov  [r13 + 16], rax
          mov  [r13 + 24], rax
          mov  rdi, r14
          mov  rsi, 64
          mov  rdx, r15
          mov  rcx, 6784
          mov  r8,  r13
          call blob_load_verify_with_hash
          mov  rcx, 0xFFFFFDA9                     // BLOB_ERR_HASH_MISMATCH
          cmp  rax, rcx
          jne  blob_dualsig_witness_fail

          // --- Stage 14: a digest that AGREES lets the pipeline run on
          //     to the two signature gates. Without this the hash gate
          //     could be a blanket reject and stage 13 would still pass ---
          mov  rax, 14
          lea  rcx, [rip + _blob_witness_stage]
          mov  [rcx + 0], rax
          lea  r13, [rip + _blob_witness_hash]
          xor  rax, rax
          mov  [r13 + 0], rax
          mov  [r13 + 8], rax
          mov  [r13 + 16], rax
          mov  [r13 + 24], rax
          mov  rdi, r14
          mov  rsi, 64
          mov  rdx, r15
          mov  rcx, 6784
          mov  r8,  r13
          call blob_load_verify_with_hash
          cmp  rax, 1                              // BLOB_UNSIGNED_SCAFFOLD
          jne  blob_dualsig_witness_fail

          // --- Stage 15: manifest magic ---
          mov  rax, 15
          lea  rcx, [rip + _blob_witness_stage]
          mov  [rcx + 0], rax
          xor  rax, rax
          mov  [r15 + 0], rax
          mov  rdi, r14
          mov  rsi, 64
          mov  rdx, r15
          mov  rcx, 6784
          call blob_load_verify
          mov  rcx, 0xFFFFFDA4                     // BLOB_ERR_BAD_MAGIC
          cmp  rax, rcx
          jne  blob_dualsig_witness_fail
          mov  rax, 0x50445853
          mov  [r15 + 0], rax

          // --- Stage 16: manifest version ---
          mov  rax, 16
          lea  rcx, [rip + _blob_witness_stage]
          mov  [rcx + 0], rax
          mov  rax, 2
          mov  [r15 + 8], rax
          mov  rdi, r14
          mov  rsi, 64
          mov  rdx, r15
          mov  rcx, 6784
          call blob_load_verify
          mov  rcx, 0xFFFFFDA5                     // BLOB_ERR_BAD_VERSION
          cmp  rax, rcx
          jne  blob_dualsig_witness_fail
          mov  rax, 1
          mov  [r15 + 8], rax

          // --- Stage 17: hash algorithm id ---
          mov  rax, 17
          lea  rcx, [rip + _blob_witness_stage]
          mov  [rcx + 0], rax
          xor  rax, rax
          mov  [r15 + 40], rax
          mov  rdi, r14
          mov  rsi, 64
          mov  rdx, r15
          mov  rcx, 6784
          call blob_load_verify
          mov  rcx, 0xFFFFFDA6                     // BLOB_ERR_BAD_HASH_ALGO
          cmp  rax, rcx
          jne  blob_dualsig_witness_fail
          mov  rax, 1
          mov  [r15 + 40], rax

          // --- Stage 18: naming paideia_root as the VENDOR key. If this
          //     were admitted both gates would verify against the same
          //     anchor and D1.a would be one signature wearing two hats ---
          mov  rax, 18
          lea  rcx, [rip + _blob_witness_stage]
          mov  [rcx + 0], rax
          xor  rax, rax
          mov  [r15 + 32], rax                     // KEYRING_ROLE_PAIDEIA_ROOT
          mov  rdi, r14
          mov  rsi, 64
          mov  rdx, r15
          mov  rcx, 6784
          call blob_load_verify
          mov  rcx, 0xFFFFFDA7                     // BLOB_ERR_BAD_VENDOR_ROLE
          cmp  rax, rcx
          jne  blob_dualsig_witness_fail

          // --- Stage 19: a role that does not exist at all ---
          mov  rax, 19
          lea  rcx, [rip + _blob_witness_stage]
          mov  [rcx + 0], rax
          mov  rax, 3
          mov  [r15 + 32], rax
          mov  rdi, r14
          mov  rsi, 64
          mov  rdx, r15
          mov  rcx, 6784
          call blob_load_verify
          mov  rcx, 0xFFFFFDA7
          cmp  rax, rcx
          jne  blob_dualsig_witness_fail
          mov  rax, 1                              // back to VENDOR_INTEL
          mov  [r15 + 32], rax

          // --- Stage 20: a manifest one byte short of the parsed size.
          //     Rejected before any field is read ---
          mov  rax, 20
          lea  rcx, [rip + _blob_witness_stage]
          mov  [rcx + 0], rax
          mov  rdi, r14
          mov  rsi, 64
          mov  rdx, r15
          mov  rcx, 6783
          call blob_load_verify
          mov  rcx, 0xFFFFFDA3                     // BLOB_ERR_BAD_MANIFEST_LEN
          cmp  rax, rcx
          jne  blob_dualsig_witness_fail

          // --- Stage 21: no manifest at all. §1.5's first row: a blob
          //     without a .pdxsig never loads ---
          mov  rax, 21
          lea  rcx, [rip + _blob_witness_stage]
          mov  [rcx + 0], rax
          mov  rdi, r14
          mov  rsi, 64
          xor  rdx, rdx
          mov  rcx, 6784
          call blob_load_verify
          mov  rcx, 0xFFFFFDA2                     // BLOB_ERR_BAD_MANIFEST_PTR
          cmp  rax, rcx
          jne  blob_dualsig_witness_fail

          // --- Stage 22: null blob ---
          mov  rax, 22
          lea  rcx, [rip + _blob_witness_stage]
          mov  [rcx + 0], rax
          xor  rdi, rdi
          mov  rsi, 64
          mov  rdx, r15
          mov  rcx, 6784
          call blob_load_verify
          mov  rcx, 0xFFFFFDA0                     // BLOB_ERR_BAD_BLOB_PTR
          cmp  rax, rcx
          jne  blob_dualsig_witness_fail

          // --- Stage 23: empty blob. Signing nothing is not a
          //     degenerate success ---
          mov  rax, 23
          lea  rcx, [rip + _blob_witness_stage]
          mov  [rcx + 0], rax
          mov  rdi, r14
          xor  rsi, rsi
          mov  rdx, r15
          mov  rcx, 6784
          call blob_load_verify
          mov  rcx, 0xFFFFFDA1                     // BLOB_ERR_BAD_BLOB_LEN
          cmp  rax, rcx
          jne  blob_dualsig_witness_fail

          // --- Stage 24: the combination table, driven directly. Two
          //     verified halves is the ONLY way to reach BLOB_OK, and
          //     these arguments cannot arise from the verifier at R29 ---
          mov  rax, 24
          lea  rcx, [rip + _blob_witness_stage]
          mov  [rcx + 0], rax
          xor  rdi, rdi                            // SIG_OK
          xor  rsi, rsi                            // SIG_OK
          call blob_combine_verdicts
          cmp  rax, 0                              // BLOB_OK
          jne  blob_dualsig_witness_fail

          // --- Stage 25: vendor verified, Paideia never signed it.
          //     THE single-valid-signature case. Must be refused ---
          mov  rax, 25
          lea  rcx, [rip + _blob_witness_stage]
          mov  [rcx + 0], rax
          xor  rdi, rdi                            // SIG_OK
          mov  rsi, 1                              // SIG_UNSIGNED_SCAFFOLD
          call blob_combine_verdicts
          mov  rcx, 0xFFFFFDAC                     // BLOB_ERR_PAIDEIA_SIG_BAD
          cmp  rax, rcx
          jne  blob_dualsig_witness_fail

          // --- Stage 26: Paideia verified, the vendor never signed it.
          //     The other direction of the same rule ---
          mov  rax, 26
          lea  rcx, [rip + _blob_witness_stage]
          mov  [rcx + 0], rax
          mov  rdi, 1                              // SIG_UNSIGNED_SCAFFOLD
          xor  rsi, rsi                            // SIG_OK
          call blob_combine_verdicts
          mov  rcx, 0xFFFFFDAB                     // BLOB_ERR_VENDOR_SIG_BAD
          cmp  rax, rcx
          jne  blob_dualsig_witness_fail

          // --- Stage 27: both absent is the scaffold verdict, and only
          //     both absent ---
          mov  rax, 27
          lea  rcx, [rip + _blob_witness_stage]
          mov  [rcx + 0], rax
          mov  rdi, 1
          mov  rsi, 1
          call blob_combine_verdicts
          cmp  rax, 1                              // BLOB_UNSIGNED_SCAFFOLD
          jne  blob_dualsig_witness_fail

          // --- Stage 28: SHA3-256 is an R32 dependency. It is reported,
          //     not hand-rolled and not silently skipped ---
          mov  rax, 28
          lea  rcx, [rip + _blob_witness_stage]
          mov  [rcx + 0], rax
          call blob_hash_available
          cmp  rax, 0
          jne  blob_dualsig_witness_fail
          mov  rdi, r14
          mov  rsi, 64
          lea  rdx, [rip + _blob_witness_hash]
          call blob_hash_compute
          mov  rcx, 0xFFFFFDAA                     // BLOB_ERR_HASH_UNAVAILABLE
          cmp  rax, rcx
          jne  blob_dualsig_witness_fail

          // --- Stage 29: the verdict -> gate mapping an operator reads ---
          mov  rax, 29
          lea  rcx, [rip + _blob_witness_stage]
          mov  [rcx + 0], rax
          mov  rdi, 0xFFFFFDAB
          call blob_failed_gate
          cmp  rax, 4                              // BLOB_GATE_VENDOR
          jne  blob_dualsig_witness_fail
          mov  rdi, 0xFFFFFDAC
          call blob_failed_gate
          cmp  rax, 5                              // BLOB_GATE_PAIDEIA
          jne  blob_dualsig_witness_fail
          mov  rdi, 0xFFFFFDAD
          call blob_failed_gate
          cmp  rax, 6                              // BLOB_GATE_BOTH
          jne  blob_dualsig_witness_fail
          mov  rdi, 0xFFFFFDA9
          call blob_failed_gate
          cmp  rax, 3                              // BLOB_GATE_HASH
          jne  blob_dualsig_witness_fail
          mov  rdi, 0xFFFFFDA4
          call blob_failed_gate
          cmp  rax, 2                              // BLOB_GATE_MANIFEST
          jne  blob_dualsig_witness_fail
          mov  rdi, 1                              // BLOB_UNSIGNED_SCAFFOLD
          call blob_failed_gate
          cmp  rax, 0                              // BLOB_GATE_NONE
          jne  blob_dualsig_witness_fail

          // --- Stage 30: telemetry. One failing load, one record, and
          //     the record says which half and about which blob ---
          mov  rax, 30
          lea  rcx, [rip + _blob_witness_stage]
          mov  [rcx + 0], rax
          call blob_audit_seq
          lea  rcx, [rip + _blob_witness_snap]
          mov  [rcx + 0], rax
          mov  r13, r15
          add  r13, 3468
          mov  rax, 0xA5
          mov_b [r13 + 0], rax
          mov  rdi, r14
          mov  rsi, 64
          mov  rdx, r15
          mov  rcx, 6784
          call blob_load_verify
          mov  rcx, 0xFFFFFDAB
          cmp  rax, rcx
          jne  blob_dualsig_witness_fail
          call blob_audit_seq
          lea  rcx, [rip + _blob_witness_snap]
          mov  rcx, [rcx + 0]
          add  rcx, 1
          cmp  rax, rcx
          jne  blob_dualsig_witness_fail
          xor  rdi, rdi                            // newest record
          mov  rsi, 1                              // field 1: verdict
          call blob_audit_field
          mov  rcx, 0xFFFFFDAB
          cmp  rax, rcx
          jne  blob_dualsig_witness_fail
          xor  rdi, rdi
          mov  rsi, 2                              // field 2: gate
          call blob_audit_field
          cmp  rax, 4                              // BLOB_GATE_VENDOR
          jne  blob_dualsig_witness_fail
          xor  rdi, rdi
          mov  rsi, 3                              // field 3: vendor role
          call blob_audit_field
          cmp  rax, 1                              // KEYRING_ROLE_VENDOR_INTEL
          jne  blob_dualsig_witness_fail
          xor  rdi, rdi
          mov  rsi, 4                              // field 4: blob_len
          call blob_audit_field
          cmp  rax, 64
          jne  blob_dualsig_witness_fail

          // --- Stage 31: a rejection is an ERROR-level event ---
          mov  rax, 31
          lea  rcx, [rip + _blob_witness_stage]
          mov  [rcx + 0], rax
          call blob_audit_error_count
          lea  rcx, [rip + _blob_witness_snap]
          mov  [rcx + 0], rax
          mov  rdi, r14
          mov  rsi, 64
          mov  rdx, r15
          mov  rcx, 6784
          call blob_load_verify
          call blob_audit_error_count
          lea  rcx, [rip + _blob_witness_snap]
          mov  rcx, [rcx + 0]
          add  rcx, 1
          cmp  rax, rcx
          jne  blob_dualsig_witness_fail

          // --- Stage 32: and ERROR level is what carries it across
          //     klog_audit_forward's filter into the durable audit log.
          //     Without this the telemetry would be dmesg-only ---
          mov  rax, 32
          lea  rcx, [rip + _blob_witness_stage]
          mov  [rcx + 0], rax
          lea  rcx, [rip + _klog_audit_head]
          mov  rax, [rcx + 0]
          lea  rcx, [rip + _blob_witness_snap]
          mov  [rcx + 0], rax
          mov  rdi, r14
          mov  rsi, 64
          mov  rdx, r15
          mov  rcx, 6784
          call blob_load_verify
          lea  rcx, [rip + _klog_audit_head]
          mov  rax, [rcx + 0]
          lea  rcx, [rip + _blob_witness_snap]
          mov  rcx, [rcx + 0]
          cmp  rax, rcx
          jbe  blob_dualsig_witness_fail

          // --- Stage 33: the scaffold verdict is WARN, not ERROR — it
          //     belongs in dmesg, not in the tamper-evident log, or R29
          //     would bury every real rejection under routine noise ---
          mov  rax, 33
          lea  rcx, [rip + _blob_witness_stage]
          mov  [rcx + 0], rax
          mov  r13, r15
          add  r13, 3468
          xor  rax, rax
          mov_b [r13 + 0], rax                     // restore the clean blob
          call blob_audit_error_count
          lea  rcx, [rip + _blob_witness_snap]
          mov  [rcx + 0], rax
          call blob_audit_warn_count
          lea  rcx, [rip + _blob_witness_snap2]
          mov  [rcx + 0], rax
          mov  rdi, r14
          mov  rsi, 64
          mov  rdx, r15
          mov  rcx, 6784
          call blob_load_verify
          cmp  rax, 1                              // BLOB_UNSIGNED_SCAFFOLD
          jne  blob_dualsig_witness_fail
          call blob_audit_error_count
          lea  rcx, [rip + _blob_witness_snap]
          mov  rcx, [rcx + 0]
          cmp  rax, rcx
          jne  blob_dualsig_witness_fail           // ERROR must NOT move
          call blob_audit_warn_count
          lea  rcx, [rip + _blob_witness_snap2]
          mov  rcx, [rcx + 0]
          add  rcx, 1
          cmp  rax, rcx
          jne  blob_dualsig_witness_fail

          // --- Stage 34: the level map itself. This function IS the
          //     audit-bridge filter, so it is pinned explicitly ---
          mov  rax, 34
          lea  rcx, [rip + _blob_witness_stage]
          mov  [rcx + 0], rax
          xor  rdi, rdi                            // BLOB_OK
          call blob_audit_level
          cmp  rax, 3                              // LEVEL_INFO
          jne  blob_dualsig_witness_fail
          mov  rdi, 1                              // BLOB_UNSIGNED_SCAFFOLD
          call blob_audit_level
          cmp  rax, 2                              // LEVEL_WARN
          jne  blob_dualsig_witness_fail
          mov  rdi, 0xFFFFFDAB
          call blob_audit_level
          cmp  rax, 1                              // LEVEL_ERROR
          jne  blob_dualsig_witness_fail

          // Success marker: R29 BLOB DUALSIG OK.
          mov  rdi, 3                              // LEVEL_INFO
          lea  rsi, [rip + SUBSYS_BOOT]
          lea  rdx, [rip + blob_dualsig_ok_msg]
          call klog_s1
          jmp  blob_dualsig_witness_done

      blob_dualsig_witness_fail:
          lea  rax, [rip + _blob_witness_stage]
          mov  r8,  [rax + 0]
          mov  rdi, 1                              // LEVEL_ERROR
          lea  rsi, [rip + SUBSYS_BOOT]
          lea  rdx, [rip + blob_dualsig_fail_msg]
          lea  rcx, [rip + k_line]
          call klog_s1_d1

      blob_dualsig_witness_done:

      // ============================================================
      // R29.M6-001..004 (#1040/#1041/#1042/#1043): driver_audit_channel
      // — sealed one-way stream, emission inside the mint/revoke/handoff
      // primitives, descriptor-count reconciliation, and blob-driver
      // audit parity.
      //
      // Under test:
      //   src/kernel/core/driver/audit_channel.pdx       (#1040/#1042)
      //   src/kernel/core/cap/kind_hw_interrupt.pdx      (#1041 wrappers)
      //   src/kernel/core/cap/kind_hw_msix_vector.pdx    (#1041 wrappers)
      //   src/kernel/core/cap/kind_dma_domain.pdx        (#1041 wrappers)
      //   src/kernel/core/driver/lifecycle.pdx           (#1041 handoff)
      // Schema: design/ipc/driver-audit-schema.md
      // Policy: design/drivers/blob-policy.md §3 (D1.c).
      //
      // The claims this witness exists to pin, in order of how easy
      // they would be to leave as adjectives:
      //
      //   "sealed"      — stages 13..16 CORRUPT retained records and
      //                   require the checks to trip. A gap check that
      //                   never trips and a seal check that never trips
      //                   are indistinguishable from `return 0`, and a
      //                   witness that only ever feeds them clean input
      //                   proves exactly nothing about either.
      //   "unforgeable
      //    ordering"    — stage 3 and stage 6 pin that each record
      //                   carries its OWN sequence number, which is what
      //                   makes a hole detectable by position.
      //   "emission is
      //    in the
      //    primitive"   — stage 7 mints through a path that FAILS and
      //                   still finds a record. A call-site instrument
      //                   would have recorded only the successes.
      //   "conservable" — stages 8..11 and 18..20 reconcile the audit
      //                   stream's account of mint/revoke against an
      //                   independently scanned live descriptor count,
      //                   across a cascade that destroys three
      //                   descriptors from one call.
      //   "blob parity" — stages 23..24 run identical capability work on
      //                   a path that has produced a blob-signature
      //                   verdict and a path that has not, and require
      //                   the audit records to be indistinguishable.
      //
      // Cap slots used (all above anything an earlier witness touches):
      //   110  KIND_HW ancestor, minted here, cleared at the end
      //   111  KIND_HW_INTERRUPT (mint/revoke pair)
      //   112  KIND_HW_INTERRUPT (mint/revoke pair)
      //   113  KIND_HW_INTERRUPT (cascade parent)
      //   114  KIND_HW_MSIX_VECTOR (cascade child)
      //   115  KIND_HW_MSIX_VECTOR (cascade child)
      //   116  KIND_HW_INTERRUPT (native path, stage 23)
      //   117  KIND_HW_INTERRUPT (blob path, stage 23)
      // Driver table slot 5 carries the handoff (stages 21..22).
      //
      // Register plan: r12..r15 only. Every function this witness calls
      // preserves them (the audit wrappers push r12/r13/r14,
      // drv_audit_emit pushes rbx and r12..r15), so they survive nested
      // calls; anything that must outlive more than one stage goes to
      // _drv_audit_wit_* in .data rather than depending on that.
      //
      // Marker ordering in the golden log:
      //   R29 BLOB DUALSIG OK
      //   R29 DRIVER AUDIT OK     <- THIS WITNESS
      // ============================================================
      drv_audit_witness:
          // --- Stage 0: KIND_HW ancestor + baseline snapshots ---
          xor  rax, rax
          lea  rcx, [rip + _drv_audit_wit_stage]
          mov  [rcx + 0], rax

          mov  rdi, 110                            // slot
          mov  rsi, 14                             // KIND_HW
          mov  rdx, 0x600                          // RIGHT_OBSERVE|RIGHT_MINT
          mov  rcx, 0xDEADBEEF
          call cap_mint_write

          call drv_audit_seq
          lea  rcx, [rip + _drv_audit_wit_seq0]
          mov  [rcx + 0], rax
          mov  r15, rax                            // r15 = seq0

          mov  rdi, 0x140
          call drv_audit_live_count
          lea  rcx, [rip + _drv_audit_wit_live0]
          mov  [rcx + 0], rax
          mov  r14, rax                            // r14 = live0 for 0x140

          // --- Stage 1: mint slot 111; the stream grows by exactly one ---
          mov  rax, 1
          lea  rcx, [rip + _drv_audit_wit_stage]
          mov  [rcx + 0], rax

          mov  rdi, 111
          mov  rsi, 110
          mov  rdx, 0x618                          // R_HW_INT_ALL
          mov  rcx, 0x50                           // gsi
          mov  r8,  0x01                           // affinity
          mov  r9,  0                              // edge
          call hw_int_cap_mint
          cmp  rax, 0
          jne  drv_audit_witness_fail

          call drv_audit_seq
          mov  rcx, r15
          add  rcx, 1
          cmp  rax, rcx
          jne  drv_audit_witness_fail

          // --- Stage 2: the newest record says what happened ---
          mov  rax, 2
          lea  rcx, [rip + _drv_audit_wit_stage]
          mov  [rcx + 0], rax

          xor  rdi, rdi
          mov  rsi, 1                              // F_EVENT
          call drv_audit_field
          cmp  rax, 1                              // EV_MINT
          jne  drv_audit_witness_fail

          xor  rdi, rdi
          mov  rsi, 2                              // F_KIND
          call drv_audit_field
          mov  rcx, 0x140
          cmp  rax, rcx
          jne  drv_audit_witness_fail

          xor  rdi, rdi
          mov  rsi, 3                              // F_SUBJECT
          call drv_audit_field
          cmp  rax, 111
          jne  drv_audit_witness_fail

          xor  rdi, rdi
          mov  rsi, 4                              // F_PRINCIPAL
          call drv_audit_field
          cmp  rax, 110
          jne  drv_audit_witness_fail

          xor  rdi, rdi
          mov  rsi, 5                              // F_OUTCOME
          call drv_audit_field
          cmp  rax, 0
          jne  drv_audit_witness_fail

          // --- Stage 3: the record carries its OWN sequence number.
          //     This is what makes a hole detectable by position rather
          //     than by trusting the ring's write order ---
          mov  rax, 3
          lea  rcx, [rip + _drv_audit_wit_stage]
          mov  [rcx + 0], rax

          xor  rdi, rdi
          mov  rsi, 0                              // F_SEQ
          call drv_audit_field
          cmp  rax, r15
          jne  drv_audit_witness_fail

          // --- Stage 4: gap check clean ---
          mov  rax, 4
          lea  rcx, [rip + _drv_audit_wit_stage]
          mov  [rcx + 0], rax
          call drv_audit_gap_check
          cmp  rax, 0
          jne  drv_audit_witness_fail

          // --- Stage 5: seal check clean ---
          mov  rax, 5
          lea  rcx, [rip + _drv_audit_wit_stage]
          mov  [rcx + 0], rax
          call drv_audit_seal_check
          cmp  rax, 0
          jne  drv_audit_witness_fail

          // --- Stage 6: second mint; the stored seq advances by one ---
          mov  rax, 6
          lea  rcx, [rip + _drv_audit_wit_stage]
          mov  [rcx + 0], rax

          mov  rdi, 112
          mov  rsi, 110
          mov  rdx, 0x618
          mov  rcx, 0x51
          mov  r8,  0x01
          mov  r9,  0
          call hw_int_cap_mint
          cmp  rax, 0
          jne  drv_audit_witness_fail

          xor  rdi, rdi
          mov  rsi, 0                              // F_SEQ
          call drv_audit_field
          mov  rcx, r15
          add  rcx, 1
          cmp  rax, rcx
          jne  drv_audit_witness_fail

          // --- Stage 7: a REFUSED mint is recorded.
          //     slot 999 fails the bounds gate, so no descriptor is
          //     created and no state-based check could ever see this
          //     attempt. The record exists because the emission lives in
          //     the primitive, not at the call site ---
          mov  rax, 7
          lea  rcx, [rip + _drv_audit_wit_stage]
          mov  [rcx + 0], rax

          call drv_audit_seq
          mov  r13, rax                            // seq before the refusal

          mov  rdi, 999
          mov  rsi, 110
          mov  rdx, 0x618
          mov  rcx, 0x52
          mov  r8,  0x01
          mov  r9,  0
          call hw_int_cap_mint
          mov  rcx, 0xFFFFFFFA                     // HW_INT_MINT_BAD_ARG
          cmp  rax, rcx
          jne  drv_audit_witness_fail

          call drv_audit_seq
          mov  rcx, r13
          add  rcx, 1
          cmp  rax, rcx
          jne  drv_audit_witness_fail

          xor  rdi, rdi
          mov  rsi, 5                              // F_OUTCOME
          call drv_audit_field
          cmp  rax, 0
          je   drv_audit_witness_fail              // must be non-zero

          xor  rdi, rdi
          mov  rsi, 1                              // F_EVENT
          call drv_audit_field
          cmp  rax, 1                              // still an EV_MINT
          jne  drv_audit_witness_fail

          // --- Stage 8: balance counts the two successes and NOT the
          //     refusal. Counting refusals would make the balance
          //     disagree with the live descriptor count by exactly the
          //     number of times the supervisor was correctly told no ---
          mov  rax, 8
          lea  rcx, [rip + _drv_audit_wit_stage]
          mov  [rcx + 0], rax

          mov  rdi, 0x140
          mov  rsi, r15
          call drv_audit_balance_since
          cmp  rax, 2
          jne  drv_audit_witness_fail

          // --- Stage 9: revoke one -> balance 1 ---
          mov  rax, 9
          lea  rcx, [rip + _drv_audit_wit_stage]
          mov  [rcx + 0], rax

          mov  rdi, 111
          call hw_int_cap_revoke
          cmp  rax, 0
          jne  drv_audit_witness_fail

          mov  rdi, 0x140
          mov  rsi, r15
          call drv_audit_balance_since
          cmp  rax, 1
          jne  drv_audit_witness_fail

          // --- Stage 10: revoke the other -> balance 0 ---
          mov  rax, 10
          lea  rcx, [rip + _drv_audit_wit_stage]
          mov  [rcx + 0], rax

          mov  rdi, 112
          call hw_int_cap_revoke
          cmp  rax, 0
          jne  drv_audit_witness_fail

          mov  rdi, 0x140
          mov  rsi, r15
          call drv_audit_balance_since
          cmp  rax, 0
          jne  drv_audit_witness_fail

          // --- Stage 11: reconcile. The audit-derived balance and the
          //     independently scanned live count agree ---
          mov  rax, 11
          lea  rcx, [rip + _drv_audit_wit_stage]
          mov  [rcx + 0], rax

          mov  rdi, 0x140
          mov  rsi, r15
          mov  rdx, r14
          call drv_audit_reconcile
          cmp  rax, 0
          jne  drv_audit_witness_fail

          // --- Stage 12: gap + seal still clean after the churn ---
          mov  rax, 12
          lea  rcx, [rip + _drv_audit_wit_stage]
          mov  [rcx + 0], rax

          call drv_audit_gap_check
          cmp  rax, 0
          jne  drv_audit_witness_fail
          call drv_audit_seal_check
          cmp  rax, 0
          jne  drv_audit_witness_fail

          // --- Stage 13: TAMPER. Flip a bit in a retained record's
          //     outcome field and require the seal check to notice.
          //     Without this stage the seal is an adjective ---
          mov  rax, 13
          lea  rcx, [rip + _drv_audit_wit_stage]
          mov  [rcx + 0], rax

          mov  rdi, 1                              // one back from the head
          call drv_audit_rec_base
          cmp  rax, 0
          je   drv_audit_witness_fail
          mov  r12, rax                            // r12 = record base

          mov  rax, [r12 + 40]                     // F_OUTCOME
          lea  rcx, [rip + _drv_audit_wit_snap]
          mov  [rcx + 0], rax
          mov  rcx, 1
          xor  rax, rcx
          mov  [r12 + 40], rax

          call drv_audit_seal_check
          cmp  rax, 0
          je   drv_audit_witness_fail              // MUST trip

          // --- Stage 14: restore -> seal clean again. Proves the check
          //     tracks the data rather than latching a failure ---
          mov  rax, 14
          lea  rcx, [rip + _drv_audit_wit_stage]
          mov  [rcx + 0], rax

          lea  rcx, [rip + _drv_audit_wit_snap]
          mov  rax, [rcx + 0]
          mov  [r12 + 40], rax

          call drv_audit_seal_check
          cmp  rax, 0
          jne  drv_audit_witness_fail

          // --- Stage 15: TAMPER the stored sequence number and require
          //     the gap check to notice. This is the deletion /
          //     reordering signature: a record whose seq no longer
          //     matches the position it occupies ---
          mov  rax, 15
          lea  rcx, [rip + _drv_audit_wit_stage]
          mov  [rcx + 0], rax

          mov  rax, [r12 + 0]                      // F_SEQ
          lea  rcx, [rip + _drv_audit_wit_snap]
          mov  [rcx + 0], rax
          add  rax, 1
          mov  [r12 + 0], rax

          call drv_audit_gap_check
          cmp  rax, 0
          je   drv_audit_witness_fail              // MUST trip

          // --- Stage 16: restore -> gap and seal both clean ---
          mov  rax, 16
          lea  rcx, [rip + _drv_audit_wit_stage]
          mov  [rcx + 0], rax

          lea  rcx, [rip + _drv_audit_wit_snap]
          mov  rax, [rcx + 0]
          mov  [r12 + 0], rax

          call drv_audit_gap_check
          cmp  rax, 0
          jne  drv_audit_witness_fail
          call drv_audit_seal_check
          cmp  rax, 0
          jne  drv_audit_witness_fail

          // --- Stage 17: window bounds. A "since" query outside the
          //     retained window must be refused, not answered wrongly ---
          mov  rax, 17
          lea  rcx, [rip + _drv_audit_wit_stage]
          mov  [rcx + 0], rax

          mov  rdi, r15
          call drv_audit_window_ok
          cmp  rax, 1
          jne  drv_audit_witness_fail

          call drv_audit_seq
          add  rax, 1
          mov  rdi, rax
          call drv_audit_window_ok
          cmp  rax, 0
          jne  drv_audit_witness_fail

          // --- Stage 18: cascade churn. One revoke call destroys three
          //     descriptors (parent + two MSI-X children) ---
          mov  rax, 18
          lea  rcx, [rip + _drv_audit_wit_stage]
          mov  [rcx + 0], rax

          call drv_audit_seq
          lea  rcx, [rip + _drv_audit_wit_snap]
          mov  [rcx + 0], rax                      // seqC
          mov  r13, rax

          mov  rdi, 0x140
          call drv_audit_live_count
          lea  rcx, [rip + _drv_audit_wit_snap2]
          mov  [rcx + 0], rax                      // live count for 0x140

          mov  rdi, 0x141
          call drv_audit_live_count
          lea  rcx, [rip + _drv_audit_wit_snap3]
          mov  [rcx + 0], rax                      // live count for 0x141

          mov  rdi, 113
          mov  rsi, 110
          mov  rdx, 0x618
          mov  rcx, 0x53
          mov  r8,  0x01
          mov  r9,  0
          call hw_int_cap_mint
          cmp  rax, 0
          jne  drv_audit_witness_fail

          mov  rdi, 114
          mov  rsi, 113
          mov  rdx, 0x218                          // R_MSIX_ALL
          mov  rcx, 0x00
          mov  r8,  0x9001
          call msix_cap_mint
          cmp  rax, 0
          jne  drv_audit_witness_fail

          mov  rdi, 115
          mov  rsi, 113
          mov  rdx, 0x218
          mov  rcx, 0x10
          mov  r8,  0x9002
          call msix_cap_mint
          cmp  rax, 0
          jne  drv_audit_witness_fail

          mov  rdi, 113
          call hw_int_cap_revoke
          cmp  rax, 0
          jne  drv_audit_witness_fail

          // --- Stage 19: the cascade left ONE revoke record per child.
          //     If msix_cascade_revoke_by_parent had called the inner
          //     body instead of the audited symbol, this balance would
          //     read +2 and the leak would be invisible ---
          mov  rax, 19
          lea  rcx, [rip + _drv_audit_wit_stage]
          mov  [rcx + 0], rax

          mov  rdi, 0x141
          mov  rsi, r13
          call drv_audit_balance_since
          cmp  rax, 0
          jne  drv_audit_witness_fail

          mov  rdi, 0x140
          mov  rsi, r13
          call drv_audit_balance_since
          cmp  rax, 0
          jne  drv_audit_witness_fail

          // --- Stage 20: reconcile BOTH kinds against their own live
          //     counts. Conservation across a full mint/cascade cycle ---
          mov  rax, 20
          lea  rcx, [rip + _drv_audit_wit_stage]
          mov  [rcx + 0], rax

          lea  rcx, [rip + _drv_audit_wit_snap2]
          mov  rdx, [rcx + 0]
          mov  rdi, 0x140
          mov  rsi, r13
          call drv_audit_reconcile
          cmp  rax, 0
          jne  drv_audit_witness_fail

          lea  rcx, [rip + _drv_audit_wit_snap3]
          mov  rdx, [rcx + 0]
          mov  rdi, 0x141
          mov  rsi, r13
          call drv_audit_reconcile
          cmp  rax, 0
          jne  drv_audit_witness_fail

          // --- Stage 21: HANDOFF. Register driver slot 5, drive it
          //     Init -> Running -> Handoff, and require the committed
          //     Handoff edge to leave a record carrying the from-state ---
          mov  rax, 21
          lea  rcx, [rip + _drv_audit_wit_stage]
          mov  [rcx + 0], rax

          mov  rdi, 5
          call driver_table_unregister             // idempotent pre-clean

          mov  rdi, 5
          mov  rsi, 77                             // pid
          lea  rdx, [rip + _registry_v2_witness_name0]
          mov  rcx, 0x300
          call driver_table_register
          cmp  rax, 0
          jne  drv_audit_witness_fail

          mov  rdi, 5
          mov  rsi, 1                              // DRIVER_STATE_RUNNING
          call driver_lifecycle_transition
          cmp  rax, 0
          jne  drv_audit_witness_fail

          call drv_audit_seq
          mov  r13, rax                            // seq before the handoff

          mov  rdi, 5
          mov  rsi, 3                              // DRIVER_STATE_HANDOFF
          call driver_lifecycle_transition
          cmp  rax, 0
          jne  drv_audit_witness_fail

          call drv_audit_seq
          mov  rcx, r13
          add  rcx, 1
          cmp  rax, rcx
          jne  drv_audit_witness_fail

          xor  rdi, rdi
          mov  rsi, 1                              // F_EVENT
          call drv_audit_field
          cmp  rax, 3                              // EV_HANDOFF
          jne  drv_audit_witness_fail

          xor  rdi, rdi
          mov  rsi, 2                              // F_KIND
          call drv_audit_field
          cmp  rax, 0                              // not a capability event
          jne  drv_audit_witness_fail

          xor  rdi, rdi
          mov  rsi, 3                              // F_SUBJECT
          call drv_audit_field
          cmp  rax, 5                              // driver_table slot
          jne  drv_audit_witness_fail

          xor  rdi, rdi
          mov  rsi, 4                              // F_PRINCIPAL
          call drv_audit_field
          cmp  rax, 1                              // from-state = Running
          jne  drv_audit_witness_fail

          // --- Stage 22: a REFUSED transition emits nothing. Handoff ->
          //     Running is not in the whitelist; recording refusals here
          //     would let the lifecycle fuzzer bury the real history ---
          mov  rax, 22
          lea  rcx, [rip + _drv_audit_wit_stage]
          mov  [rcx + 0], rax

          call drv_audit_seq
          mov  r13, rax

          mov  rdi, 5
          mov  rsi, 1                              // Handoff -> Running
          call driver_lifecycle_transition
          cmp  rax, 0
          je   drv_audit_witness_fail              // must be refused

          call drv_audit_seq
          cmp  rax, r13
          jne  drv_audit_witness_fail              // and must be silent

          // --- Stage 23: BLOB PARITY (D1.c). Mint through the native
          //     path, then run a real blob-signature verification and
          //     mint through the SAME primitive, and require the two
          //     records to be indistinguishable in event / kind /
          //     outcome. A provenance gate anywhere in the audit layer
          //     — in the emitter or in a reader — breaks this ---
          mov  rax, 23
          lea  rcx, [rip + _drv_audit_wit_stage]
          mov  [rcx + 0], rax

          call drv_audit_seq
          mov  r13, rax                            // seqN
          lea  rcx, [rip + _drv_audit_wit_snap]
          mov  [rcx + 0], rax

          mov  rdi, 0x140
          call drv_audit_live_count
          lea  rcx, [rip + _drv_audit_wit_snap2]
          mov  [rcx + 0], rax                      // live0 for the pair

          // native path: no blob verification in front of it
          mov  rdi, 116
          mov  rsi, 110
          mov  rdx, 0x618
          mov  rcx, 0x54
          mov  r8,  0x01
          mov  r9,  0
          call hw_int_cap_mint
          cmp  rax, 0
          jne  drv_audit_witness_fail

          xor  rdi, rdi
          mov  rsi, 1
          call drv_audit_field
          mov  r12, rax                            // native event

          xor  rdi, rdi
          mov  rsi, 2
          call drv_audit_field
          mov  r14, rax                            // native kind

          // blob path: produce a genuine blob-signature verdict first.
          // A null manifest is the ordinary shape of the
          // BAD_MANIFEST_PTR rejection and needs no manifest fixture —
          // and a REJECTED blob is precisely the case someone would be
          // tempted to special-case in the audit layer.
          call blob_audit_seq
          mov  r13, rax

          lea  rdi, [rip + _blob_witness_blob]
          mov  rsi, 64
          xor  rdx, rdx                            // manifest_ptr = 0
          xor  rcx, rcx                            // manifest_len = 0
          call blob_load_verify
          cmp  rax, 0
          je   drv_audit_witness_fail              // must be a rejection

          call blob_audit_seq
          mov  rcx, r13
          add  rcx, 1
          cmp  rax, rcx
          jne  drv_audit_witness_fail              // blob event really happened

          mov  rdi, 117
          mov  rsi, 110
          mov  rdx, 0x618
          mov  rcx, 0x55
          mov  r8,  0x01
          mov  r9,  0
          call hw_int_cap_mint
          cmp  rax, 0
          jne  drv_audit_witness_fail

          xor  rdi, rdi
          mov  rsi, 1
          call drv_audit_field
          cmp  rax, r12                            // same event as native
          jne  drv_audit_witness_fail

          xor  rdi, rdi
          mov  rsi, 2
          call drv_audit_field
          cmp  rax, r14                            // same kind as native
          jne  drv_audit_witness_fail

          xor  rdi, rdi
          mov  rsi, 5
          call drv_audit_field
          cmp  rax, 0                              // same outcome as native
          jne  drv_audit_witness_fail

          // --- Stage 24: both paths revoke and reconcile identically.
          //     Read access is as unfiltered as write access ---
          mov  rax, 24
          lea  rcx, [rip + _drv_audit_wit_stage]
          mov  [rcx + 0], rax

          mov  rdi, 116
          call hw_int_cap_revoke
          cmp  rax, 0
          jne  drv_audit_witness_fail

          mov  rdi, 117
          call hw_int_cap_revoke
          cmp  rax, 0
          jne  drv_audit_witness_fail

          lea  rcx, [rip + _drv_audit_wit_snap]
          mov  rsi, [rcx + 0]                      // seqN
          mov  rdi, 0x140
          call drv_audit_balance_since
          cmp  rax, 0
          jne  drv_audit_witness_fail

          lea  rcx, [rip + _drv_audit_wit_snap]
          mov  rsi, [rcx + 0]
          lea  rcx, [rip + _drv_audit_wit_snap2]
          mov  rdx, [rcx + 0]
          mov  rdi, 0x140
          call drv_audit_reconcile
          cmp  rax, 0
          jne  drv_audit_witness_fail

          // --- Teardown: leave no state for later witnesses. The
          //     KIND_HW ancestor at slot 110 is cleared and driver slot
          //     5 unregistered; the audit records of everything above
          //     stay, which is the point ---
          mov  rdi, 5
          call driver_table_unregister

          mov  rdi, 110
          xor  rsi, rsi
          xor  rdx, rdx
          xor  rcx, rcx
          call cap_mint_write

          // Success marker: R29 DRIVER AUDIT OK.
          mov  rdi, 3                              // LEVEL_INFO
          lea  rsi, [rip + SUBSYS_BOOT]
          lea  rdx, [rip + drv_audit_ok_msg]
          call klog_s1
          jmp  drv_audit_witness_done

      drv_audit_witness_fail:
          lea  rax, [rip + _drv_audit_wit_stage]
          mov  r8,  [rax + 0]
          mov  rdi, 1                              // LEVEL_ERROR
          lea  rsi, [rip + SUBSYS_BOOT]
          lea  rdx, [rip + drv_audit_fail_msg]
          lea  rcx, [rip + k_line]
          call klog_s1_d1

      drv_audit_witness_done:

      // ============================================================
      // R30.M4-001 (#1066) / R30.M4-002 (#1067): SCI/GPE dispatch
      // witness — opens R30.M4, the interrupt path of the round.
      //
      // The whole body lives in tests/kernel/acpi/gpe_synth.pdx rather
      // than inline here. That is a placement decision, not a size one:
      // the fixture installs a synthetic register window through the
      // seam in core/acpi/gpe_io.pdx and MUST return the seam to real
      // port I/O on every exit, and a fixture whose setup and teardown
      // are one function cannot leave that half-done the way an inline
      // block with a jump to a shared fail label can.
      //
      // Placement AFTER drv_audit_witness_done is deliberate too. The
      // storm sub-test asserts on the most recent driver-audit record,
      // and the driver-audit witness makes assertions of its own about
      // the ring; running the GPE fixture first would interleave storm
      // records into the window that witness reads.
      //
      // Fingerprint ordering:
      //   R29 DRIVER AUDIT OK
      //   R30 GPE DISPATCH OK     <- THIS WITNESS
      //   R20b IPC BOUNCE OK
      // ============================================================
      // R30.M4-001 (#1066): the R20.M3 synthetic FADT fixture, wired
      // into the boot path for the first time. It had been compiled and
      // linked since R20 but never called, so the parser it exercises
      // had no runtime witness at all — which is why the field-offset
      // error corrected in this issue (the SDT header counted as 40
      // bytes rather than 36, displacing SCI_INT and the whole PM_*_BLK
      // run) survived four rounds. R30.M4 reads SCI_INT out of that
      // structure, so the fixture stops being optional here.
      fadt_synth_witness_call:
          call fadt_synth_witness

      gpe_dispatch_witness_call:
          call gpe_dispatch_witness

      // ============================================================
      // R30.M4-003 (#1068) / R30.M4-004 (#1069): ACPI event stream +
      // subscriber routing witness — closes R30.M4.
      //
      // Body in tests/kernel/acpi/evt_route_synth.pdx, for the same
      // placement reason gpe_synth.pdx is out of line: it installs the
      // synthetic register window through the seam in
      // core/acpi/gpe_io.pdx and MUST return that seam to real port I/O
      // on every exit, which a fixture whose setup and teardown are one
      // function cannot leave half-done.
      //
      // Placement AFTER gpe_dispatch_witness_call is required, not
      // stylistic. Sub-test D reads the MOST RECENT driver-audit record
      // and asserts it is this fixture's GPE_AUDIT_EV_UNROUTED line; the
      // GPE fixture's storm retirement writes a record of its own, so
      // running this one first would put the two witnesses' records in
      // the other order and each would read the other's.
      //
      // It writes no IOAPIC register: both sci_arm calls use an SCI_INT
      // of 2^32, whose resolved GSI is 0, and core/acpi/sci_route.pdx
      // refuses a GSI of 0 before any MMIO. That is what lets the
      // readiness gate be exercised in BOTH directions -- refused while
      // unbound, passed once bound -- without this witness reprogramming
      // the platform's own interrupt controller during boot.
      //
      // Fingerprint ordering:
      //   R29 DRIVER AUDIT OK
      //   R30 GPE DISPATCH OK
      //   R30 ACPI EVENT ROUTE OK   <- THIS WITNESS
      //   R20b IPC BOUNCE OK
      // ============================================================
      evt_route_witness_call:
          call evt_route_witness

      // ============================================================
      // R30.M5-001 (#1070) / R30.M5-002 (#1071): I²C capability-pair
      // witness — opens R30.M5 (LPSS I²C enablement).
      //
      // Body in tests/kernel/cap/i2c_cap_synth.pdx. Out of line for a
      // different reason than the two ACPI fixtures above: this one
      // installs no seam and touches no hardware at all — it is pure
      // capability structure — but it consumes twelve cap_table slots
      // and two private row tables, and a fixture whose setup and
      // teardown are one function cannot leave that half-done the way
      // an inline block with a jump to a shared fail label can.
      //
      // Placement is free: it shares no state with any other witness.
      // Slots 34..45 are disjoint from every other witness's set
      // (0..8, 10..12, 14..19, 28..33), and both exits clear them and
      // reset both row tables.
      //
      // What it establishes, in one line: on a bus where the
      // controller can address every peripheral, a capability naming
      // address A cannot be talked into addressing B — including by a
      // caller that loads B into every register an added address
      // parameter could arrive in.
      //
      // Fingerprint ordering:
      //   R30 GPE DISPATCH OK
      //   R30 ACPI EVENT ROUTE OK
      //   R30 KIND_I2C OK           <- THIS WITNESS
      //   R20b IPC BOUNCE OK
      // ============================================================
      i2c_cap_witness_call:
          call i2c_cap_witness

      // ============================================================
      // R30.M5-003 (#1072) / R30.M5-004 (#1073): LPSS I²C controller
      // probe, BAR mapping and transfer-channel witness.
      //
      // Body in tests/kernel/drivers/i2c/lpss_i2c_synth.pdx. Out of
      // line for the reason gpe_synth.pdx is: it installs the synthetic
      // register window through the seam in
      // core/drivers/i2c/dw_io.pdx and MUST return that seam to real
      // MMIO on every exit -- a fixture whose setup and teardown are
      // one function cannot leave that half-done. It also mints a live
      // KIND_OP_REGION over a fabricated physical base, which both
      // exits revoke by clearing the slot.
      //
      // PLACEMENT AFTER i2c_cap_witness_call IS REQUIRED, not
      // stylistic. Both fixtures reset _i2c_bus_table and
      // _i2c_slave_table on entry and on exit; running this one first
      // would have the capability-pair witness's own reset wipe the bus
      // and slave rows this one is transacting against. The dependency
      // is one-directional -- this fixture consumes the kinds that one
      // establishes -- so the order is the same as the issue order.
      //
      // Cap slots 46..55, disjoint from every other witness's set
      // (0..8, 10..12, 14..19, 28..33, 34..45).
      //
      // It touches no hardware. The seam is in its synthetic mode for
      // the whole fixture, and the PCI probe it exercises finds nothing
      // under QEMU's MCFG-absent boot in any case; the controller rows
      // come from lpss_i2c_record, the same allocator the probe uses.
      //
      // R30.M5-005 (#1074) extended it with sub-tests S..X: the
      // interrupt-driven transfer engine, its FSM ownership protocol
      // and the TX_EMPTY storm measurement. Those emit a SECOND
      // fingerprint from the same function, because a boot in which
      // the polled engine works and the interrupt engine does not is a
      // boot somebody needs to be able to see.
      //
      // The service routine (core/drivers/i2c/dw_isr.pdx) is driven
      // here from thread context, exactly as sci_isr_body is by the
      // GPE witness: no interrupt vector is bound to an LPSS
      // controller yet -- that needs the KIND_HW_MSIX_VECTOR plumbing
      // R30.M6 will do -- and the engine is written so that binding
      // one adds a caller rather than a code path.
      //
      // Fingerprint ordering:
      //   R30 ACPI EVENT ROUTE OK
      //   R30 KIND_I2C OK
      //   R30 LPSS I2C OK           <- THIS WITNESS
      //   R30 LPSS I2C IRQ OK       <- THIS WITNESS
      //   R20b IPC BOUNCE OK
      // ============================================================
      lpss_i2c_witness_call:
          call lpss_i2c_witness

      // ============================================================
      // R30.M5-003 (#1072): the REAL LPSS I²C controller probe.
      //
      // Consumes _pci_devices, which pci_enumerate_all populated far
      // earlier in kernel_main_64. Records every class candidate for a
      // DesignWare I²C core with its measured BAR0 extent, and stops
      // there: identification reads a register, and bringing a
      // controller up writes several, and both need the window
      // capability that only a holder of memory authority can mint.
      // The probe itself performs no MMIO.
      //
      // PLACEMENT AFTER THE WITNESS IS REQUIRED. The witness resets
      // _lpss_i2c_ctrl on entry and on exit; probing first would have
      // the fixture's own teardown erase the machine's real controller
      // rows. It is invisible under QEMU -- an MCFG-absent boot leaves
      // _pci_device_count at zero, so the walk iterates zero times and
      // the fingerprint reports n=0 -- and load-bearing on the T14 G4,
      // where it is the first thing that sees the LPSS blocks.
      //
      // Fingerprint: "LPSS I2C PROBE n=<count>".
      // ============================================================
      lpss_i2c_probe_call:
          call lpss_i2c_probe

      // ============================================================
      // R30.M6-002 (#1076): LPSS / PCH pad-controller witness — opens
      // R30.M6.
      //
      // Body in tests/kernel/drivers/gpio/lpss_gpio_synth.pdx. Out of
      // line for the reason lpss_i2c_synth.pdx is: it installs the
      // synthetic register window through the seam in
      // core/drivers/gpio/gpio_io.pdx and MUST return that seam to real
      // MMIO on every exit -- a fixture whose setup and teardown are one
      // function cannot leave that half-done. It also mints live
      // KIND_OP_REGION capabilities over fabricated physical bases,
      // which both exits revoke rather than merely unlinking, so the
      // op-region ROWS come back too.
      //
      // What it establishes, in one line: the controller's registers are
      // reachable only through a capability, the part is identified by
      // asking it rather than by a device-id table, and a community
      // description that cannot be true -- overlapping, oversized, or
      // pointing at a window with nothing behind it -- is REFUSED rather
      // than repaired.
      //
      // Cap slots 56..63, disjoint from every other witness's set
      // (0..8, 10..12, 14..19, 28..33, 34..45, 46..55).
      //
      // Fingerprint ordering:
      //   R30 LPSS I2C IRQ OK
      //   R30 LPSS GPIO OK          <- THIS WITNESS
      //   R30 KIND_GPIO OK
      //   R20b IPC BOUNCE OK
      // ============================================================
      lpss_gpio_witness_call:
          call lpss_gpio_witness

      // ============================================================
      // R30.M6-001 (#1075): KIND_GPIO_LINE capability witness.
      //
      // Body in tests/kernel/cap/gpio_cap_synth.pdx.
      //
      // PLACEMENT AFTER lpss_gpio_witness_call IS REQUIRED, not
      // stylistic, and the dependency runs the OPPOSITE way to the I²C
      // pair's. There, the capability witness ran first and the driver
      // witness consumed the kinds it established. Here the CAPABILITY
      // depends on the DRIVER: a KIND_GPIO_LINE mint resolves its pin
      // through the controller's community table, so this fixture has to
      // build a controller before it can mint anything. Both fixtures
      // reset _lpss_gpio_ctrl and _lpss_gpio_comm on entry and on exit,
      // so running them the other way round would have the driver
      // witness's teardown erase the controller this one is minting
      // against.
      //
      // What it establishes, in one line: a capability naming pin P
      // cannot be talked into acting on pin Q -- including by a caller
      // that loads Q's number, community, pad index and register offset
      // into every register an added parameter could arrive in -- and
      // the community mapping is right OUTSIDE community 0, where it is
      // not the identity and where an implementation that skipped it
      // would drive a different pin with no error anywhere.
      //
      // Cap slots 64..79, disjoint from every other witness's set; both
      // exits revoke the windows and clear them.
      //
      // Fingerprint ordering:
      //   R30 LPSS GPIO OK
      //   R30 KIND_GPIO OK          <- THIS WITNESS
      //   R20b IPC BOUNCE OK
      // ============================================================
      gpio_cap_witness_call:
          call gpio_cap_witness

      // ============================================================
      // R30.M6-003 (#1077) + R30.M6-004 (#1078): the GPIO CHANNEL and
      // the pad driver — the first code in this kernel that changes
      // physical board state.
      //
      // Body in tests/kernel/drivers/gpio/gpio_pad_synth.pdx.
      //
      // PLACEMENT AFTER BOTH R30.M6 WITNESSES IS REQUIRED for the same
      // reason gpio_cap_witness follows lpss_gpio_witness: this fixture
      // builds a controller, describes its communities and mints line
      // capabilities over it, and all three of those tables are reset by
      // the earlier fixtures' teardown. Running it first would have
      // their teardown erase the controller it drives.
      //
      // It also arms the synthetic seam's WRITE-1-TO-CLEAR registry and
      // registers an edge subscription, and its teardown clears both --
      // the subscription in particular, because a live subscription
      // outliving the fixture is an ISR entry that would re-derive a pad
      // address from a capability slot the next boot stage reuses.
      //
      // What it establishes, in one line: a pad register write preserves
      // the bits it does not own, an interrupt acknowledgement that
      // clears the status bit is DISTINGUISHABLE from one that does not,
      // a status bit that will not clear is bounded and masked rather
      // than serviced forever, and turning an input into an output is a
      // different authority from toggling one.
      //
      // Cap slots 80..95, disjoint from every other witness's set; both
      // exits revoke the window and clear them.
      //
      // Fingerprint ordering:
      //   R30 KIND_GPIO OK
      //   R30 GPIO PAD OK          <- THIS WITNESS
      //   R20b IPC BOUNCE OK
      // ============================================================
      gpio_pad_witness_call:
          call gpio_pad_witness

      // ============================================================
      // R30.M6-002 (#1076): the REAL pad-controller probe.
      //
      // Consumes _pci_devices, which pci_enumerate_all populated far
      // earlier in kernel_main_64. Records every class candidate with
      // its measured BAR0 extent and stops there: identification reads a
      // register, and that needs the window capability that only a
      // holder of memory authority can mint. The probe itself performs
      // no MMIO.
      //
      // PLACEMENT AFTER BOTH WITNESSES IS REQUIRED. Each resets
      // _lpss_gpio_ctrl on entry and on exit; probing first would have
      // their teardown erase the machine's real controller rows.
      //
      // It is invisible under QEMU -- an MCFG-absent boot leaves
      // _pci_device_count at zero, so the walk iterates zero times and
      // the fingerprint reports n=0. On the T14 G4 the PCH pad
      // controller is described by platform firmware rather than
      // enumerated on PCI, and that consumer is R30's userspace
      // supervisor; this path is the PCI half, and both converge on
      // lpss_gpio_record.
      //
      // Fingerprint: "LPSS GPIO PROBE n=<count>".
      // ============================================================
      lpss_gpio_probe_call:
          call lpss_gpio_probe

      // ============================================================
      // #664 verification: vfs_open O_CREAT witness — new file creation
      // via tmpfs backend. 3 sub-tests, 1 marker.
      //
      // Preamble: wire root vnode's ops_ptr/backend_ptr to tmpfs. Same
      // fixup as the #589 sys_read_witness preamble below — mount()'s
      // root vnode is never permanently wired to tmpfs elsewhere in the
      // boot sequence; every witness that needs a real backend-dispatched
      // create/lookup on root must wire it locally (idempotent — safe to
      // repeat).
      //
      // Sub-test A: rax = vfs_open("/newfile", O_CREAT|O_RDWR = 0x42).
      //             Expect rax != 0 (fresh vnode idx).
      // Sub-test B: vnode_slot(rax).refcount == 1 (fresh vnode, first
      //             open increments 0 -> 1).
      // Sub-test C: tmpfs_lookup(TMPFS_INODE_IDX_ROOT=1, "newfile") != 0
      //             — confirms the tmpfs backend actually linked the new
      //             inode into root's sibling chain (not just a VFS-side
      //             vnode-pool entry).
      // Marker: "R16 OCREAT OK" on A, B, C pass.
      // ============================================================
      ocreat_witness:
          // --- Preamble: wire root vnode to tmpfs (idempotent) ---
          call mount_root_vnode                        // rax = root vnode idx
          mov  rdi, rax
          call vnode_slot                               // rax = &vnode[root]
          lea  rcx, [rip + _tmpfs_vops]
          mov  [rax + 24], rcx                          // ops_ptr = &_tmpfs_vops
          mov  rcx, 1                                   // TMPFS_INODE_IDX_ROOT
          mov  [rax + 32], rcx                          // backend_ptr = root_idx

          // --- Preamble: free slot 202 (belt+suspenders — post-#680 the pool
          //     is reset at end of vnode_pool_witness so this is redundant,
          //     but idempotent so cheap to keep as defense-in-depth. Filed as
          //     paideia-os #680; delete this call once #680 audit confirms
          //     no other witnesses depend on the saturation state) ---
          mov  rdi, 202
          call vnode_free

          // --- Sub-test A: vfs_open("/newfile", O_CREAT|O_RDWR) ---
          lea  rdi, [rip + witness_path_newfile]        // "/newfile"
          mov  rsi, 0x42                                 // O_CREAT (0x40) | O_RDWR (0x02)
          call vfs_open
          mov  r13, rax                                  // DEBUG: stash for later print
          cmp  rax, 0
          je   ocreat_witness_fail_a
          mov  r12, rax                                  // r12 = new vnode idx

          // --- Sub-test B: refcount == 1 (fresh vnode, first open) ---
          mov  rdi, r12
          call vnode_slot                                // rax = &vnode[new]
          xor  rcx, rcx
          mov_w rcx, [rax + 4]                            // refcount (u16 at +4)
          mov  r13, rcx                                   // DEBUG: stash for later print
          cmp  rcx, 1
          jne  ocreat_witness_fail_b

          // --- Sub-test C: tmpfs backend actually linked "newfile" under root ---
          mov  rdi, 1                                    // TMPFS_INODE_IDX_ROOT
          lea  rsi, [rip + witness_name_newfile]         // "newfile"
          call tmpfs_lookup
          mov  r13, rax                                   // DEBUG: stash for later print
          cmp  rax, 0
          je   ocreat_witness_fail_c

          // --- All green ---
          mov rdi, 3;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + ocreat_ok_msg];
          call klog_s1;
          jmp  ocreat_witness_done

      ocreat_witness_fail_a:
          mov rdi, 3;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + ocreat_debug_a_msg];
          call klog_s1;
          jmp  ocreat_witness_fail

      ocreat_witness_fail_b:
          mov rdi, 3;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + ocreat_debug_b_msg];
          call klog_s1;
          jmp  ocreat_witness_fail

      ocreat_witness_fail_c:
          mov rdi, 3;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + ocreat_debug_c_msg];
          call klog_s1;
          jmp  ocreat_witness_fail

      ocreat_witness_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + ocreat_fail_msg];
          call klog_s1;

      ocreat_witness_done:

      // ============================================================
      // R16-M3-001 (#587): sys_open witness — 5 sub-tests, 1 marker
      // ============================================================
      sys_open_witness:
          // --- Sub-test A: first open returns 3 ---
          lea  rdi, [rip + _sys_open_witness_task]
          lea  rsi, [rip + witness_path_slash]
          xor  rdx, rdx
          xor  rcx, rcx
          call sys_open_body
          cmp  rax, 3
          jne  sys_open_witness_fail

          // --- Sub-test B: second open returns 4 ---
          lea  rdi, [rip + _sys_open_witness_task]
          lea  rsi, [rip + witness_path_slash]
          xor  rdx, rdx
          xor  rcx, rcx
          call sys_open_body
          cmp  rax, 4
          jne  sys_open_witness_fail

          // --- Sub-test C: third open returns 5 ---
          lea  rdi, [rip + _sys_open_witness_task]
          lea  rsi, [rip + witness_path_slash]
          xor  rdx, rdx
          xor  rcx, rcx
          call sys_open_body
          cmp  rax, 5
          jne  sys_open_witness_fail

          // --- Sub-test D: fd_table[3] has valid packed entry ---
          lea  rdi, [rip + _sys_open_witness_task]
          mov  rsi, 3
          call fd_get
          mov  rcx, rax
          and  rcx, 0xFFFF                          // vnode_idx (low 16)
          cmp  rcx, 0
          je   sys_open_witness_fail
          mov  rcx, rax
          shr  rcx, 16                              // offset (high 48)
          cmp  rcx, 0
          jne  sys_open_witness_fail

          // --- Sub-test E: error path returns -ENOENT for "/nope" ---
          lea  rdi, [rip + _sys_open_witness_task]
          lea  rsi, [rip + witness_path_nope]
          xor  rdx, rdx
          xor  rcx, rcx
          call sys_open_body
          mov  rcx, 0xFFFFFFFFFFFFFFFE
          cmp  rax, rcx
          jne  sys_open_witness_fail

          // --- All green ---
          mov rdi, 3;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + sys_open_ok_msg];
          call klog_s1;
          jmp  sys_open_witness_done

      sys_open_witness_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + sys_open_fail_msg];
          call klog_s1;

      sys_open_witness_done:

      // ============================================================
      // R16-M3-002 (#588): sys_close witness — 5 sub-tests, 1 marker
      // ============================================================
      sys_close_witness:
          // --- Prep: sys_open on fresh slab to seed fd 3 ---
          lea  rdi, [rip + _sys_close_witness_task]
          lea  rsi, [rip + witness_path_slash]
          xor  rdx, rdx
          xor  rcx, rcx
          call sys_open_body
          cmp  rax, 3
          jne  sys_close_witness_fail

          // --- Sub-test A: sys_close(w, 3) → 0 ---
          lea  rdi, [rip + _sys_close_witness_task]
          mov  rsi, 3
          call sys_close_body
          cmp  rax, 0
          jne  sys_close_witness_fail

          // --- Sub-test B: fd_get(w, 3) → 0 (slot cleared) ---
          lea  rdi, [rip + _sys_close_witness_task]
          mov  rsi, 3
          call fd_get
          cmp  rax, 0
          jne  sys_close_witness_fail

          // --- Sub-test C: sys_close(w, 2) → -EBADF ---
          lea  rdi, [rip + _sys_close_witness_task]
          mov  rsi, 2
          call sys_close_body
          mov  rcx, 0xFFFFFFFFFFFFFFF7
          cmp  rax, rcx
          jne  sys_close_witness_fail

          // --- Sub-test D: sys_close(w, 32) → -EBADF ---
          lea  rdi, [rip + _sys_close_witness_task]
          mov  rsi, 32
          call sys_close_body
          mov  rcx, 0xFFFFFFFFFFFFFFF7
          cmp  rax, rcx
          jne  sys_close_witness_fail

          // --- Sub-test E: sys_close(w, 3) again → -EBADF (already closed) ---
          lea  rdi, [rip + _sys_close_witness_task]
          mov  rsi, 3
          call sys_close_body
          mov  rcx, 0xFFFFFFFFFFFFFFF7
          cmp  rax, rcx
          jne  sys_close_witness_fail

          // --- All green ---
          mov rdi, 3;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + sys_close_ok_msg];
          call klog_s1;
          jmp  sys_close_witness_done

      sys_close_witness_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + sys_close_fail_msg];
          call klog_s1;

      sys_close_witness_done:

      // ============================================================
      // R16-M3-003 (#589): sys_read witness — preamble + 5 sub-tests
      // ============================================================
      sys_read_witness:
          // --- Preamble (fixup): wire the persistent root vnode to tmpfs ---
          // The real root vnode allocated by the #574 mount() witness (via
          // vnode_alloc) has never had its ops_ptr(+24)/backend_ptr(+32)
          // fields populated. The #586 tmpfs-vops-wire witness only proved
          // dispatch through a throwaway SCRATCH vnode built on the stack;
          // it never touched the persistent tree root. Every sys_open
          // witness up to and including #587 only exercised single- or
          // zero-component paths ("/", "/nope") whose path_resolve never
          // needs a populated ops_ptr (no vops_lookup call is reached for
          // "/"; the "/nope" ENOENT case is satisfied by vops_lookup's own
          // null-ops_ptr -> VOPS_ERR_NOT_SUPPORTED short-circuit, which
          // happens to collapse to the same ENOENT outcome). #589 is the
          // first witness to resolve a real multi-component path
          // ("/tmp/x") through the actual tmpfs backend, which surfaces
          // this wiring gap: without it, vops_lookup(root_vnode, "tmp")
          // hits the null-ops_ptr guard and path_resolve fails. Wire it
          // here, once, before any lookup/open in this witness.
          call mount_root_vnode                       // rax = real root vnode idx
          mov  rdi, rax
          call vnode_slot                              // rax = &vnode[root]
          lea  rcx, [rip + _tmpfs_vops]
          mov  [rax + 24], rcx                         // ops_ptr = &_tmpfs_vops
          mov  rcx, 1                                  // TMPFS_INODE_IDX_ROOT
          mov  [rax + 32], rcx                         // backend_ptr = root_idx

          // --- Preamble: recover x_idx, re-seed data, open fd=3 ---
          mov  rdi, 1
          lea  rsi, [rip + witness_name_tmp]
          call tmpfs_lookup
          cmp  rax, 0
          je   sys_read_witness_fail
          mov  r12, rax                               // r12 = tmp_idx

          // --- Preamble (fixup, cont'd): wire /tmp's vnode-pool slot too ---
          // path_resolve's regular_lookup treats vops_lookup's returned
          // child index (a tmpfs-native inode idx, e.g. tmp_idx here) as
          // the NEXT vnode-pool index for its following vnode_slot call.
          // Nothing else in the boot sequence ever populates
          // _vnode_pool[tmp_idx] for the real (non-scratch) tree, so the
          // "x" component lookup would hit the same null-ops_ptr gap this
          // preamble just fixed for the root. Same wiring, same rationale.
          mov  rdi, r12
          call vnode_slot                              // rax = &vnode[tmp_idx]
          lea  rcx, [rip + _tmpfs_vops]
          mov  [rax + 24], rcx                         // ops_ptr = &_tmpfs_vops
          mov  rcx, r12
          mov  [rax + 32], rcx                         // backend_ptr = tmp_idx

          // /tmp/x was unlinked by the #585 tmpfs_unlink witness earlier in
          // boot (directory entry spliced out + bitmap bit cleared, proven
          // by that witness's own sub-tests B/D). A tmpfs_lookup here would
          // miss, so re-create it via tmpfs_create — same args as the #582
          // tmpfs_create witness (tmp_idx, "x", name_len=1, type=REG=1) —
          // before seeding data and opening it.
          mov  rdi, r12                               // dir_idx = tmp_idx
          lea  rsi, [rip + witness_name_any]           // name_ptr = "x\0"
          mov  rdx, 1                                  // name_len = 1
          mov  rcx, 1                                  // type = VNODE_TYPE_REG
          call tmpfs_create
          cmp  rax, 0
          je   sys_read_witness_fail
          cmp  rax, 0xFFFF
          je   sys_read_witness_fail                   // alloc-OOM sentinel
          mov  r13, rax                               // r13 = x_idx (freshly created)

          // --- Preamble (fixup, cont'd): wire x_idx's vnode-pool slot too ---
          // vfs_read (called from inside sys_read_body) resolves its
          // vnode_idx argument via vnode_slot + vops_read, same identity
          // assumption as path_resolve's regular_lookup. Without this,
          // vops_read's null-ops_ptr guard fires and sys_read_body sees
          // the VOPS_ERR_NOT_SUPPORTED sentinel, returning -EIO instead of
          // bytes_read. Same wiring, same rationale as tmp_idx above.
          mov  rdi, r13
          call vnode_slot                              // rax = &vnode[x_idx]
          lea  rcx, [rip + _tmpfs_vops]
          mov  [rax + 24], rcx                         // ops_ptr = &_tmpfs_vops
          mov  rcx, r13
          mov  [rax + 32], rcx                         // backend_ptr = x_idx

          mov  rdi, r13
          lea  rsi, [rip + tmpfs_write_src_buf]
          mov  rdx, 100
          xor  rcx, rcx
          call tmpfs_write
          cmp  rax, 100
          jne  sys_read_witness_fail

          lea  rdi, [rip + _sys_read_witness_task]
          lea  rsi, [rip + witness_path_tmp_x]
          xor  rdx, rdx
          xor  rcx, rcx
          call sys_open_body
          cmp  rax, 3
          jne  sys_read_witness_fail

          // --- Sub-test A: sys_read(w, 3, dst_buf, 100) → 100 ---
          lea  rdi, [rip + _sys_read_witness_task]
          mov  rsi, 3
          lea  rdx, [rip + tmpfs_read_dst_buf]
          mov  rcx, 100
          call sys_read_body
          cmp  rax, 100
          jne  sys_read_witness_fail

          // --- Sub-test B: dst_buf[0..8] == 0x4141414141414141 ---
          lea  r14, [rip + tmpfs_read_dst_buf]
          mov  rcx, [r14]
          mov  rdx, 0x4141414141414141
          cmp  rcx, rdx
          jne  sys_read_witness_fail

          // --- Sub-test C: fd_table[3] offset field == 100 ---
          lea  rdi, [rip + _sys_read_witness_task]
          mov  rsi, 3
          call fd_get
          mov  rcx, rax
          shr  rcx, 16
          cmp  rcx, 100
          jne  sys_read_witness_fail

          // --- Sub-test D: consecutive sys_read → 0 (EOF) ---
          lea  rdi, [rip + _sys_read_witness_task]
          mov  rsi, 3
          lea  rdx, [rip + tmpfs_read_dst_buf]
          mov  rcx, 100
          call sys_read_body
          cmp  rax, 0
          jne  sys_read_witness_fail

          // --- Sub-test E: sys_read(w, 2, ...) → -EBADF ---
          lea  rdi, [rip + _sys_read_witness_task]
          mov  rsi, 2
          lea  rdx, [rip + tmpfs_read_dst_buf]
          mov  rcx, 100
          call sys_read_body
          mov  rcx, 0xFFFFFFFFFFFFFFF7
          cmp  rax, rcx
          jne  sys_read_witness_fail

          // --- All green ---
          mov rdi, 3;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + sys_read_ok_msg];
          call klog_s1;
          jmp  sys_read_witness_done

      sys_read_witness_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + sys_read_fail_msg];
          call klog_s1;

      sys_read_witness_done:

      // ============================================================
      // R16-M3-004 (#590): sys_write witness — preamble + 4 sub-tests
      // ============================================================
      sys_write_witness:
          // --- Preamble: wire root and tmp_idx, recover x_idx, trim /tmp/x to 0;
          //               wire fresh x_idx; open fd=3 ---
          // Although root and tmp_idx wiring persisted from #589, we ensure they're
          // wired here for defensive idempotency, matching sys_read witness pattern.
          call mount_root_vnode                       // rax = real root vnode idx
          mov  rdi, rax
          call vnode_slot                              // rax = &vnode[root]
          lea  rcx, [rip + _tmpfs_vops]
          mov  [rax + 24], rcx                         // ops_ptr = &_tmpfs_vops
          mov  rcx, 1                                  // TMPFS_INODE_IDX_ROOT
          mov  [rax + 32], rcx                         // backend_ptr = root_idx

          // Recover tmp_idx via lookup
          mov  rdi, 1
          lea  rsi, [rip + witness_name_tmp]
          call tmpfs_lookup
          cmp  rax, 0
          je   sys_write_witness_fail
          mov  r12, rax                               // r12 = tmp_idx

          // Wire /tmp's vnode-pool slot
          mov  rdi, r12
          call vnode_slot                              // rax = &vnode[tmp_idx]
          lea  rcx, [rip + _tmpfs_vops]
          mov  [rax + 24], rcx                         // ops_ptr = &_tmpfs_vops
          mov  rcx, r12
          mov  [rax + 32], rcx                         // backend_ptr = tmp_idx

          // Trim /tmp/x back to fresh 0-size state: unlink + create
          mov  rdi, r12
          lea  rsi, [rip + witness_name_any]
          mov  rdx, 1
          call tmpfs_unlink
          cmp  rax, 0
          jne  sys_write_witness_fail

          mov  rdi, r12
          lea  rsi, [rip + witness_name_any]
          mov  rdx, 1
          mov  rcx, 1                                 // VNODE_TYPE_REG
          call tmpfs_create
          cmp  rax, 0
          je   sys_write_witness_fail
          cmp  rax, 0xFFFF
          je   sys_write_witness_fail
          mov  r13, rax                               // r13 = fresh x_idx

          // Defensive vnode-pool wiring for x_idx (persists from #589 unless
          // unlink+create yielded a different idx — see §4.4).
          mov  rdi, r13
          call vnode_slot
          lea  rcx, [rip + _tmpfs_vops]
          mov  [rax + 24], rcx
          mov  rcx, r13
          mov  [rax + 32], rcx

          lea  rdi, [rip + _sys_write_witness_task]
          lea  rsi, [rip + witness_path_tmp_x]
          xor  rdx, rdx
          xor  rcx, rcx
          call sys_open_body
          cmp  rax, 3
          jne  sys_write_witness_fail

          // --- Sub-test A: sys_write(w, 3, src, 100) → 100 ---
          lea  rdi, [rip + _sys_write_witness_task]
          mov  rsi, 3
          lea  rdx, [rip + tmpfs_write_src_buf]
          mov  rcx, 100
          call sys_write_body
          cmp  rax, 100
          jne  sys_write_witness_fail

          // --- Sub-test B: fd_table[3] offset field == 100 ---
          lea  rdi, [rip + _sys_write_witness_task]
          mov  rsi, 3
          call fd_get
          mov  rcx, rax
          shr  rcx, 16
          cmp  rcx, 100
          jne  sys_write_witness_fail

          // --- Sub-test C: inode.size == 100 (grew from 0 post-create) ---
          mov  rdi, r13
          call tmpfs_inode_slot
          mov  rcx, [rax + 8]
          cmp  rcx, 100
          jne  sys_write_witness_fail

          // --- Sub-test D: sys_write(w, 2, ...) → -EBADF ---
          lea  rdi, [rip + _sys_write_witness_task]
          mov  rsi, 2
          lea  rdx, [rip + tmpfs_write_src_buf]
          mov  rcx, 100
          call sys_write_body
          mov  rcx, 0xFFFFFFFFFFFFFFF7
          cmp  rax, rcx
          jne  sys_write_witness_fail

          // --- All green ---
          mov rdi, 3;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + sys_write_ok_msg];
          call klog_s1;
          jmp  sys_write_witness_done

      sys_write_witness_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + sys_write_fail_msg];
          call klog_s1;

      sys_write_witness_done:

      // ============================================================
      // R15-M4-007 (#541): user_ptr_ok witness — 2 sub-tests
      //
      // Sub-A: user_ptr_ok(0xFFFFFFFFFFFFFFFF, 4) returns 1 (fault) —
      //        pointer sits in kernel half.
      // Sub-B: user_ptr_ok(0x400000, 4) returns 0 (OK) — user half.
      // Sub-C: syscall_dispatch(1, 1, 0xFFFFFFFFFFFFFFFF, 4, 0) via
      //        dispatch.pdx's dispatch_write path returns -EFAULT
      //        (0xFFFFFFFFFFFFFFF2). This is what proves AC fidelity —
      //        the fixture cited in issue #541.
      //
      // Marker: "R15 USER PTR OK" on all three passing.
      // ============================================================
      user_ptr_witness:
          // Sub-A: bogus pointer → fault (return 1)
          mov  rdi, 0xFFFFFFFFFFFFFFFF
          mov  rsi, 4
          call user_ptr_ok
          cmp  rax, 1
          jne  user_ptr_witness_fail

          // Sub-B: good pointer → OK (return 0)
          mov  rdi, 0x400000
          mov  rsi, 4
          call user_ptr_ok
          cmp  rax, 0
          jne  user_ptr_witness_fail

          // Sub-C: AC fixture — syscall_dispatch(1, 1, 0xFFFFFFFFFFFFFFFF, 4, 0)
          //        must return -EFAULT (0xFFFFFFFFFFFFFFF2).
          // dispatch.pdx dispatch entry ABI: rdi=syscall_num, rsi=arg0, rdx=arg1, rcx=arg2, r8=arg3
          // Write is syscall 1; args: fd=1, buf=0xFFFFFFFFFFFFFFFF, len=4.
          mov  rdi, 1                     // syscall_num = write (SC+ freeze)
          mov  rsi, 1                     // fd = stdout
          mov  rdx, 0xFFFFFFFFFFFFFFFF    // buf = bogus
          mov  rcx, 4                     // len = 4
          xor  r8, r8                     // arg3 unused
          call syscall_dispatch
          mov  rcx, 0xFFFFFFFFFFFFFFF2    // -EFAULT
          cmp  rax, rcx
          jne  user_ptr_witness_fail

          mov rdi, 3;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + user_ptr_ok_msg];
          call klog_s1;
          jmp  user_ptr_witness_done

      user_ptr_witness_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + user_ptr_fail_msg];
          call klog_s1;

      user_ptr_witness_done:

      // ============================================================
      // R16-M3-005 (#591): sys_dup2 witness — preamble + 6 sub-tests
      // ============================================================
      sys_dup2_witness:
          // --- Preamble: wire root, tmp, x; reset x refcount; open fd=3 (/tmp/x) and fd=4 (/) ---
          //
          // #665 Phase 5: after Phase 4 rewired path_resolve through
          // vnode_cache_or_alloc, tmpfs_lookup/tmpfs_create returns are backend
          // inode indices — NOT vnode-pool indices. This preamble therefore
          // must go through vnode_cache_or_alloc(parent_vn_idx, backend_idx,
          // ops_ptr) to reserve the same (parent, backend, ops)-triple slot
          // that path_resolve will later dedup against when sys_open_body
          // resolves "/tmp/x". Root is exempt — mount_root_vnode() already
          // returns a vnode-pool idx.
          call mount_root_vnode
          mov  r14, rax                               // r14 = root_vnode_pool_idx (parent for /tmp)
          mov  rdi, rax
          call vnode_slot
          lea  rcx, [rip + _tmpfs_vops]
          mov  [rax + 24], rcx
          mov  rcx, 1                                 // TMPFS_INODE_IDX_ROOT
          mov  [rax + 32], rcx

          mov  rdi, 1
          lea  rsi, [rip + witness_name_tmp]
          call tmpfs_lookup
          cmp  rax, 0
          je   sys_dup2_witness_fail
          mov  r12, rax                               // r12 = tmp_backend_idx

          // Reserve /tmp's vnode-pool slot via vnode_cache_or_alloc (dedup or fresh).
          mov  rdi, r14                               // parent = root_vnode_pool_idx
          mov  rsi, r12                               // backend = tmp_backend_idx
          lea  rdx, [rip + _tmpfs_vops]               // ops = _tmpfs_vops
          call vnode_cache_or_alloc
          cmp  rax, 0xFFFF
          je   sys_dup2_witness_fail
          mov  r15, rax                               // r15 = tmp_vnode_pool_idx (parent for /tmp/x)

          mov  rdi, r12
          lea  rsi, [rip + witness_name_any]
          mov  rdx, 1
          call tmpfs_unlink
          cmp  rax, 0
          jne  sys_dup2_witness_fail

          mov  rdi, r12
          lea  rsi, [rip + witness_name_any]
          mov  rdx, 1
          mov  rcx, 1                                 // VNODE_TYPE_REG
          call tmpfs_create
          cmp  rax, 0
          je   sys_dup2_witness_fail
          cmp  rax, 0xFFFF
          je   sys_dup2_witness_fail
          mov  r13, rax                               // r13 = fresh x_backend_idx

          // Reserve /tmp/x's vnode-pool slot via vnode_cache_or_alloc.
          mov  rdi, r15                               // parent = tmp_vnode_pool_idx
          mov  rsi, r13                               // backend = x_backend_idx
          lea  rdx, [rip + _tmpfs_vops]               // ops = _tmpfs_vops
          call vnode_cache_or_alloc
          cmp  rax, 0xFFFF
          je   sys_dup2_witness_fail
          mov  r13, rax                               // r13 = x_vnode_pool_idx (was x_backend_idx)

          // CRITICAL: reset x's vnode-pool slot refcount to 0 (§4.3.1)
          mov  rdi, r13
          call vnode_slot
          xor  rcx, rcx
          mov_w [rax + 4], rcx

          // sys_open("/tmp/x", 0, 0) → fd = 3, x_idx.refcount → 1
          lea  rdi, [rip + _sys_dup2_witness_task]
          lea  rsi, [rip + witness_path_tmp_x]
          xor  rdx, rdx
          xor  rcx, rcx
          call sys_open_body
          cmp  rax, 3
          jne  sys_dup2_witness_fail

          // sys_open("/", 0, 0) → fd = 4, root_idx.refcount ++
          lea  rdi, [rip + _sys_dup2_witness_task]
          lea  rsi, [rip + witness_path_slash]
          xor  rdx, rdx
          xor  rcx, rcx
          call sys_open_body
          cmp  rax, 4
          jne  sys_dup2_witness_fail

          // --- Sub-test D: sys_dup2(w, 3, 3) → 3 (no-op) ---
          lea  rdi, [rip + _sys_dup2_witness_task]
          mov  rsi, 3
          mov  rdx, 3
          call sys_dup2_body
          cmp  rax, 3
          jne  sys_dup2_witness_fail

          // --- Sub-test A: sys_dup2(w, 3, 5) → 5 ---
          lea  rdi, [rip + _sys_dup2_witness_task]
          mov  rsi, 3
          mov  rdx, 5
          call sys_dup2_body
          cmp  rax, 5
          jne  sys_dup2_witness_fail

          // --- Sub-test B: fd_table[5] == fd_table[3] ---
          lea  rdi, [rip + _sys_dup2_witness_task]
          mov  rsi, 3
          call fd_get
          mov  r12, rax                               // r12 = src_entry

          lea  rdi, [rip + _sys_dup2_witness_task]
          mov  rsi, 5
          call fd_get
          cmp  rax, r12
          jne  sys_dup2_witness_fail

          // --- Sub-test C: shared vnode's refcount == 2 ---
          lea  rdi, [rip + _sys_dup2_witness_task]
          mov  rsi, 3
          call fd_get
          and  rax, 0xFFFF
          mov  rdi, rax
          call vnode_slot
          xor  rcx, rcx
          mov_w rcx, [rax + 4]
          cmp  rcx, 2
          jne  sys_dup2_witness_fail

          // --- Sub-test E: sys_dup2(w, 99, 5) → -EBADF ---
          lea  rdi, [rip + _sys_dup2_witness_task]
          mov  rsi, 99
          mov  rdx, 5
          call sys_dup2_body
          mov  rcx, 0xFFFFFFFFFFFFFFF7
          cmp  rax, rcx
          jne  sys_dup2_witness_fail

          // --- Sub-test F prep: sample fd_table[4]'s vnode_idx + refcount ---
          lea  rdi, [rip + _sys_dup2_witness_task]
          mov  rsi, 4
          call fd_get
          and  rax, 0xFFFF
          mov  r12, rax                               // r12 = root_idx
          mov  rdi, rax
          call vnode_slot
          xor  rcx, rcx
          mov_w rcx, [rax + 4]
          mov  r13, rcx                               // r13 = R_root_before

          // --- Sub-test F: sys_dup2(w, 3, 4) → 4 ---
          lea  rdi, [rip + _sys_dup2_witness_task]
          mov  rsi, 3
          mov  rdx, 4
          call sys_dup2_body
          cmp  rax, 4
          jne  sys_dup2_witness_fail

          // F.1: fd_table[4] == fd_table[3]
          lea  rdi, [rip + _sys_dup2_witness_task]
          mov  rsi, 3
          call fd_get
          mov  r14, rax
          lea  rdi, [rip + _sys_dup2_witness_task]
          mov  rsi, 4
          call fd_get
          cmp  rax, r14
          jne  sys_dup2_witness_fail

          // F.2: root_idx refcount decreased by 1
          mov  rdi, r12
          call vnode_slot
          xor  rcx, rcx
          mov_w rcx, [rax + 4]
          inc  rcx
          cmp  rcx, r13
          jne  sys_dup2_witness_fail

          // F.3: x_idx refcount == 3
          lea  rdi, [rip + _sys_dup2_witness_task]
          mov  rsi, 3
          call fd_get
          and  rax, 0xFFFF
          mov  rdi, rax
          call vnode_slot
          xor  rcx, rcx
          mov_w rcx, [rax + 4]
          cmp  rcx, 3
          jne  sys_dup2_witness_fail

          // --- All green ---
          mov rdi, 3;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + sys_dup2_ok_msg];
          call klog_s1;
          jmp  sys_dup2_witness_done

      sys_dup2_witness_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + sys_dup2_fail_msg];
          call klog_s1;

      sys_dup2_witness_done:

      // ============================================================
      // R16-M3-006 (#592): fd_inherit witness — preamble + fork + 3 sub-tests
      // ============================================================
      fd_inherit_witness:
          // --- Preamble: wire root, tmp, x; reset x refcount ---
          // #665 Phase 5: route backend→vnode-pool binding through
          // vnode_cache_or_alloc (see sys_dup2_witness preamble for rationale).
          // r15 must hold x's VNODE-POOL idx post-preamble (sub-test B checks
          // refcount via vnode_slot(r15)).
          call mount_root_vnode
          mov  r14, rax                               // r14 = root_vnode_pool_idx (parent for /tmp)
          mov  rdi, rax
          call vnode_slot
          lea  rcx, [rip + _tmpfs_vops]
          mov  [rax + 24], rcx
          mov  rcx, 1                                 // TMPFS_INODE_IDX_ROOT
          mov  [rax + 32], rcx

          mov  rdi, 1
          lea  rsi, [rip + witness_name_tmp]
          call tmpfs_lookup
          cmp  rax, 0
          je   fd_inherit_witness_fail
          mov  r12, rax                               // r12 = tmp_backend_idx

          // Reserve /tmp's vnode-pool slot via vnode_cache_or_alloc.
          mov  rdi, r14                               // parent = root_vnode_pool_idx
          mov  rsi, r12                               // backend = tmp_backend_idx
          lea  rdx, [rip + _tmpfs_vops]               // ops = _tmpfs_vops
          call vnode_cache_or_alloc
          cmp  rax, 0xFFFF
          je   fd_inherit_witness_fail
          mov  r13, rax                               // r13 = tmp_vnode_pool_idx (parent for /tmp/x)

          mov  rdi, r12
          lea  rsi, [rip + witness_name_any]
          mov  rdx, 1
          call tmpfs_unlink
          cmp  rax, 0
          jne  fd_inherit_witness_fail

          mov  rdi, r12
          lea  rsi, [rip + witness_name_any]
          mov  rdx, 1
          mov  rcx, 1                                 // VNODE_TYPE_REG
          call tmpfs_create
          cmp  rax, 0
          je   fd_inherit_witness_fail
          cmp  rax, 0xFFFF
          je   fd_inherit_witness_fail
          mov  r15, rax                               // r15 = fresh x_backend_idx

          // Reserve /tmp/x's vnode-pool slot via vnode_cache_or_alloc.
          mov  rdi, r13                               // parent = tmp_vnode_pool_idx
          mov  rsi, r15                               // backend = x_backend_idx
          lea  rdx, [rip + _tmpfs_vops]               // ops = _tmpfs_vops
          call vnode_cache_or_alloc
          cmp  rax, 0xFFFF
          je   fd_inherit_witness_fail
          mov  r15, rax                               // r15 = x_vnode_pool_idx (was x_backend_idx)

          // Reset x's vnode-pool slot refcount to 0 (state normalization)
          mov  rdi, r15
          call vnode_slot
          xor  rcx, rcx
          mov_w [rax + 4], rcx

          // --- task_new(NULL) → parent ---
          xor  rdi, rdi
          call task_new
          cmp  rax, 0
          je   fd_inherit_witness_fail
          mov  r14, rax                               // r14 = parent slab

          // --- sys_open_body(parent, "/tmp/x", 0, 0) → fd = 3 ---
          mov  rdi, r14
          lea  rsi, [rip + witness_path_tmp_x]
          xor  rdx, rdx
          xor  rcx, rcx
          call sys_open_body
          cmp  rax, 3
          jne  fd_inherit_witness_fail

          // --- Baseline sanity: x_idx.refcount == 1 pre-fork ---
          mov  rdi, r15
          call vnode_slot
          xor  rcx, rcx
          mov_w rcx, [rax + 4]
          cmp  rcx, 1
          jne  fd_inherit_witness_fail

          // --- Act: sys_fork_body(parent) → child_pid, rdx=0 ---
          mov  rdi, r14
          call sys_fork_body
          cmp  rax, 2                                 // child_pid >= 2
          jb   fd_inherit_witness_fail
          cmp  rdx, 0
          jne  fd_inherit_witness_fail
          mov  r12d, eax                              // r12 = child_pid (zero-ext)

          // --- Recover child slab via _pid_table[child_pid] ---
          lea  rax, [rip + _pid_table]
          mov  r13, [rax + r12*8]                     // r13 = child slab
          cmp  r13, 0
          je   fd_inherit_witness_fail

          // --- Sub-test A: parent.fd[3] == child.fd[3] ---
          mov  rax, [r14 + 24 + 168]                  // parent.fd[3]
          mov  rcx, [r13 + 24 + 168]                  // child.fd[3]
          cmp  rax, rcx
          jne  fd_inherit_witness_fail

          // --- Sub-test B: x_idx.refcount == 2 ---
          mov  rdi, r15                               // r15 = x_idx (saved from preamble)
          call vnode_slot
          xor  rcx, rcx
          mov_w rcx, [rax + 4]
          cmp  rcx, 2
          jne  fd_inherit_witness_fail

          // --- Sub-test C: child.fd[0/1/2] all zero ---
          mov  rax, [r13 + 0 + 168]
          cmp  rax, 0
          jne  fd_inherit_witness_fail
          mov  rax, [r13 + 8 + 168]
          cmp  rax, 0
          jne  fd_inherit_witness_fail
          mov  rax, [r13 + 16 + 168]
          cmp  rax, 0
          jne  fd_inherit_witness_fail

          // --- All green ---
          mov rdi, 3;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + fd_inherit_ok_msg];
          call klog_s1;
          jmp  fd_inherit_witness_done

      fd_inherit_witness_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + fd_inherit_fail_msg];
          call klog_s1;

      fd_inherit_witness_done:

      // ============================================================
      // R16-M3-007 (#593): fd_cloexec witness — preamble + execve + 3 sub-tests
      // ============================================================
      fd_cloexec_witness:
          // --- Preamble: wire root, tmp, x; reset x refcount; task_new; open fd=3;
          //               mark CLOEXEC; open fd=4 ---
          // #665 Phase 5: route backend→vnode-pool binding through
          // vnode_cache_or_alloc (see sys_dup2_witness preamble for rationale).
          // r15 must hold x's VNODE-POOL idx post-preamble (baseline + sub-test C
          // check refcount via vnode_slot(r15)).
          call mount_root_vnode
          mov  r14, rax                               // r14 = root_vnode_pool_idx (parent for /tmp)
          mov  rdi, rax
          call vnode_slot
          lea  rcx, [rip + _tmpfs_vops]
          mov  [rax + 24], rcx
          mov  rcx, 1                                 // TMPFS_INODE_IDX_ROOT
          mov  [rax + 32], rcx

          mov  rdi, 1
          lea  rsi, [rip + witness_name_tmp]
          call tmpfs_lookup
          cmp  rax, 0
          je   fd_cloexec_witness_fail
          mov  r12, rax                               // r12 = tmp_backend_idx

          // Reserve /tmp's vnode-pool slot via vnode_cache_or_alloc.
          mov  rdi, r14                               // parent = root_vnode_pool_idx
          mov  rsi, r12                               // backend = tmp_backend_idx
          lea  rdx, [rip + _tmpfs_vops]               // ops = _tmpfs_vops
          call vnode_cache_or_alloc
          cmp  rax, 0xFFFF
          je   fd_cloexec_witness_fail
          mov  r13, rax                               // r13 = tmp_vnode_pool_idx (parent for /tmp/x)

          mov  rdi, r12
          lea  rsi, [rip + witness_name_any]
          mov  rdx, 1
          call tmpfs_unlink
          cmp  rax, 0
          jne  fd_cloexec_witness_fail

          mov  rdi, r12
          lea  rsi, [rip + witness_name_any]
          mov  rdx, 1
          mov  rcx, 1                                 // VNODE_TYPE_REG
          call tmpfs_create
          cmp  rax, 0
          je   fd_cloexec_witness_fail
          cmp  rax, 0xFFFF
          je   fd_cloexec_witness_fail
          mov  r15, rax                               // r15 = fresh x_backend_idx

          // Reserve /tmp/x's vnode-pool slot via vnode_cache_or_alloc.
          mov  rdi, r13                               // parent = tmp_vnode_pool_idx
          mov  rsi, r15                               // backend = x_backend_idx
          lea  rdx, [rip + _tmpfs_vops]               // ops = _tmpfs_vops
          call vnode_cache_or_alloc
          cmp  rax, 0xFFFF
          je   fd_cloexec_witness_fail
          mov  r15, rax                               // r15 = x_vnode_pool_idx (was x_backend_idx)

          // Reset x's vnode-pool slot refcount to 0 (state normalization)
          mov  rdi, r15
          call vnode_slot
          xor  rcx, rcx
          mov_w [rax + 4], rcx

          // --- task_new(NULL) → parent ---
          xor  rdi, rdi
          call task_new
          cmp  rax, 0
          je   fd_cloexec_witness_fail
          mov  r14, rax                               // r14 = parent slab

          // --- sys_open_body(parent, "/tmp/x", 0, 0) → fd = 3 ---
          mov  rdi, r14
          lea  rsi, [rip + witness_path_tmp_x]
          xor  rdx, rdx
          xor  rcx, rcx
          call sys_open_body
          cmp  rax, 3
          jne  fd_cloexec_witness_fail

          // --- Verify fd[3] was actually populated ---
          mov  rax, [r14 + 24 + 168]                  // parent.fd[3]
          cmp  rax, 0
          je   fd_cloexec_witness_fail                // fd[3] should not be empty!

          // --- Set bit 63 of parent.fd_table[3] (CLOEXEC marker) ---
          mov  rcx, 0x8000000000000000                // CLOEXEC_MASK (bit 63)
          or   rax, rcx
          mov  [r14 + 24 + 168], rax

          // --- sys_open_body(parent, "/tmp/x", 0, 0) → fd = 4 (no CLOEXEC) ---
          mov  rdi, r14
          lea  rsi, [rip + witness_path_tmp_x]
          xor  rdx, rdx
          xor  rcx, rcx
          call sys_open_body
          cmp  rax, 4
          jne  fd_cloexec_witness_fail

          // --- Verify fd[4] was actually populated ---
          mov  rax, [r14 + 32 + 168]                  // parent.fd[4]
          cmp  rax, 0
          je   fd_cloexec_witness_fail                // fd[4] should not be empty!

          // --- Baseline sanity: x_idx.refcount == 2 pre-execve ---
          mov  rdi, r15
          call vnode_slot
          xor  rcx, rcx
          mov_w rcx, [rax + 4]
          cmp  rcx, 2
          jne  fd_cloexec_fail_setup_label

          // --- Act: sys_execve_body(parent, _shell_bin_start, image_len) ---
          // r14 = parent task (arg 1), r15 = x_idx (preserved as callee-save)
          mov  rdi, r14                               // arg 1: parent task
          lea  rsi, [rip + _shell_bin_start]         // arg 2: image_ptr
          lea  rax, [rip + _shell_bin_end]
          sub  rax, rsi
          mov  rdx, rax                               // arg 3: image_len
          call sys_execve_body
          cmp  rax, 0                                 // require ELF_OK
          jne  fd_cloexec_fail_execve_label

          // --- Sub-test A: parent.fd_table[3] == 0 ---
          mov  rax, [r14 + 24 + 168]
          cmp  rax, 0
          jne  fd_cloexec_fail_sub_a_label

          // --- Sub-test B: parent.fd_table[4] != 0 ---
          mov  rax, [r14 + 32 + 168]
          cmp  rax, 0
          je   fd_cloexec_fail_sub_b_label

          // --- Sub-test C: x_idx.refcount == 1 ---
          mov  rdi, r15
          call vnode_slot
          xor  rcx, rcx
          mov_w rcx, [rax + 4]
          cmp  rcx, 1
          jne  fd_cloexec_fail_sub_c_label

          // --- All green ---
          mov rdi, 3;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + fd_cloexec_ok_msg];
          call klog_s1;
          jmp  fd_cloexec_witness_done

      fd_cloexec_fail_setup_label:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + fd_cloexec_fail_setup];
          call klog_s1;
          jmp  fd_cloexec_witness_done

      fd_cloexec_fail_execve_label:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + fd_cloexec_fail_execve];
          call klog_s1;
          jmp  fd_cloexec_witness_done

      fd_cloexec_fail_sub_a_label:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + fd_cloexec_fail_sub_a];
          call klog_s1;
          jmp  fd_cloexec_witness_done

      fd_cloexec_fail_sub_b_label:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + fd_cloexec_fail_sub_b];
          call klog_s1;
          jmp  fd_cloexec_witness_done

      fd_cloexec_fail_sub_c_label:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + fd_cloexec_fail_sub_c];
          call klog_s1;
          jmp  fd_cloexec_witness_done

      fd_cloexec_witness_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + fd_cloexec_fail_msg];
          call klog_s1;

      fd_cloexec_witness_done:

      // R16-M3-008 (#594): FD OK — milestone closure marker.
      mov rdi, 3;
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + fd_ok_msg];
      call klog_s1;

      // ============================================================
      // R16-M4-001 (#595): uart_rx_init witness — 1 sub-test
      // ============================================================
      uart_rx_init_witness:
          // Sub-test A: after uart_rx_init, port 0x3F9 read returns 0x01
          call uart_rx_init;

          mov  dx, 0x3F9;
          in_al al;
          and  rax, 0xFF;                         // isolate AL (in_al leaves upper 56 bits untouched)
          cmp  rax, 1;
          jne  uart_rx_init_witness_fail;

          // All green
          mov rdi, 3;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + uart_rx_init_ok_msg];
          call klog_s1;
          jmp  uart_rx_init_witness_done;

      uart_rx_init_witness_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + uart_rx_init_fail_msg];
          call klog_s1;

      uart_rx_init_witness_done:

      // ============================================================
      // R16-M4-002 (#596): uart_rx_ring witness — 4 sub-tests
      // ============================================================
      uart_rx_ring_witness:
          push r12;                              // callee-save loop counter

          // ---------- Sub-test A: virgin ring is empty ----------
          call uart_rx_dequeue;
          cmp  rax, 0xFFFF;
          jne  uart_rx_ring_witness_fail;

          // ---------- Sub-test B: single-byte round-trip ----------
          mov  rdi, 0x41;
          call uart_rx_enqueue;
          cmp  rax, 0;
          jne  uart_rx_ring_witness_fail;
          call uart_rx_dequeue;
          cmp  rax, 0x41;
          jne  uart_rx_ring_witness_fail;

          // ---------- Sub-test C: multi-byte FIFO ("hello") ----------
          mov rdi, 0x68;
          call uart_rx_enqueue;
          cmp rax, 0;
          jne uart_rx_ring_witness_fail;
          mov rdi, 0x65;
          call uart_rx_enqueue;
          cmp rax, 0;
          jne uart_rx_ring_witness_fail;
          mov rdi, 0x6C;
          call uart_rx_enqueue;
          cmp rax, 0;
          jne uart_rx_ring_witness_fail;
          mov rdi, 0x6C;
          call uart_rx_enqueue;
          cmp rax, 0;
          jne uart_rx_ring_witness_fail;
          mov rdi, 0x6F;
          call uart_rx_enqueue;
          cmp rax, 0;
          jne uart_rx_ring_witness_fail;

          call uart_rx_dequeue;
          cmp rax, 0x68;
          jne uart_rx_ring_witness_fail;
          call uart_rx_dequeue;
          cmp rax, 0x65;
          jne uart_rx_ring_witness_fail;
          call uart_rx_dequeue;
          cmp rax, 0x6C;
          jne uart_rx_ring_witness_fail;
          call uart_rx_dequeue;
          cmp rax, 0x6C;
          jne uart_rx_ring_witness_fail;
          call uart_rx_dequeue;
          cmp rax, 0x6F;
          jne uart_rx_ring_witness_fail;

          // ---------- Sub-test D: capacity + full + drain + empty ----------
          xor r12, r12;
        urrw_fill_loop:
          mov rdi, r12;
          call uart_rx_enqueue;
          cmp rax, 0;
          jne uart_rx_ring_witness_fail;
          add r12, 1;
          cmp r12, 256;
          jb  urrw_fill_loop;

          mov rdi, 0x99;
          call uart_rx_enqueue;
          cmp rax, 1;
          jne uart_rx_ring_witness_fail;

          xor r12, r12;
        urrw_drain_loop:
          call uart_rx_dequeue;
          cmp rax, r12;
          jne uart_rx_ring_witness_fail;
          add r12, 1;
          cmp r12, 256;
          jb  urrw_drain_loop;

          call uart_rx_dequeue;
          cmp rax, 0xFFFF;
          jne uart_rx_ring_witness_fail;

          // --- All green ---
          mov rdi, 3;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + uart_rx_ring_ok_msg];
          call klog_s1;
          jmp  uart_rx_ring_witness_done;

      uart_rx_ring_witness_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + uart_rx_ring_fail_msg];
          call klog_s1;

      uart_rx_ring_witness_done:
          pop  r12;

      // ============================================================
      // R16-M4-003 (#597): uart_rx_isr witness — 1 sub-test
      // ============================================================
      uart_rx_isr_witness:
          push r12;                              // callee-save head snapshot

          // Sub-test A: with no bytes at COM1 (LSR.DR=0), calling
          // uart_rx_isr must not enqueue any bytes into the ring.
          // Snapshot _uart_rx_head; call ISR; verify head unchanged.
          mov  rax, [rip + _uart_rx_head];
          mov  r12, rax;                         // head_before survives the call

          call uart_rx_isr;                      // drains what's available (nothing) + EOI

          mov  rax, [rip + _uart_rx_head];
          cmp  rax, r12;                         // head_after must equal head_before
          jne  uart_rx_isr_witness_fail;

          // --- All green ---
          mov rdi, 3;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + uart_rx_isr_ok_msg];
          call klog_s1;
          jmp  uart_rx_isr_witness_done;

      uart_rx_isr_witness_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + uart_rx_isr_fail_msg];
          call klog_s1;

      uart_rx_isr_witness_done:
          pop  r12;

      // ============================================================
      // R16-M4-004 (#598): idt vector 0x24 wire — 3 sub-tests
      // ============================================================
      //
      // IDT entry layout (Intel SDM Vol 3A §6.14.1, 64-bit interrupt gate):
      //   Bytes 0-1:  offset_lo (u16)
      //   Bytes 2-3:  segment selector (u16, = 0x08 KERNEL_CS)
      //   Byte  4:    IST (bits 0-2) + reserved (bits 3-7); = 0 for vec 36
      //   Byte  5:    type_attr (u8): P=1 | DPL=0 | 0 | type=0xE → 0x8E
      //   Bytes 6-7:  offset_mid (u16)
      //   Bytes 8-11: offset_hi (u32)
      //   Bytes 12-15: reserved (u32, = 0)
      //
      // word0 (u64 at offset 0):
      //   bits  0-15: offset_lo
      //   bits 16-31: selector (0x08)
      //   bits 32-39: IST
      //   bits 40-47: type_attr (0x8E)
      //   bits 48-63: offset_mid
      //
      // word1 (u64 at offset 8):
      //   bits  0-31: offset_hi
      //   bits 32-63: reserved (0)

      idt_vec24_witness:
          push r12;                                 // callee-save: trampoline address survives all sub-tests
          push r13;                                 // callee-save: word0 survives sub-tests B and C

          // Load trampoline address once; used by sub-tests A and C.
          lea  r12, [rip + _isr_stub_36];

          // Compute base address of IDT entry 36 (byte offset = 36 * 16 = 576).
          lea  rax, [rip + _idt_storage];
          add  rax, 576;                            // rax = &_idt_storage[36]

          // Load word0 into r13 for sub-tests A and B.
          mov  r13, [rax];

          // --------- Sub-test A: offset_lo (word0 bits 0-15) == trampoline & 0xFFFF ---------
          mov  rcx, r13;
          mov  rdx, 0xFFFF;
          and  rcx, rdx;                            // rcx = offset_lo from packed entry
          mov  rsi, r12;
          and  rsi, rdx;                            // rsi = trampoline low16
          cmp  rcx, rsi;
          jne  idt_vec24_witness_fail;

          // --------- Sub-test B: type_attr (word0 bits 40-47) == 0x8E ---------
          mov  rcx, r13;
          shr  rcx, 40;                             // rcx = type_attr | offset_mid<<8 | ...
          mov  rdx, 0xFF;
          and  rcx, rdx;                            // rcx = type_attr byte
          cmp  rcx, 0x8E;
          jne  idt_vec24_witness_fail;

          // --------- Sub-test C: reassembled handler offset == trampoline ---------
          //   reassembled = (word0 & 0xFFFF)                       ; offset_lo
          //               | ((word0 >> 48) & 0xFFFF) << 16         ; offset_mid
          //               | (word1 & 0xFFFFFFFF) << 32             ; offset_hi

          // offset_lo → rcx (low 16 bits of reassembled)
          mov  rcx, r13;
          mov  rdx, 0xFFFF;
          and  rcx, rdx;                            // rcx = offset_lo (positions 0-15)

          // offset_mid → rdi, then shift to positions 16-31, OR into rcx
          mov  rdi, r13;
          shr  rdi, 48;                             // rdi = offset_mid (positions 0-15)
          and  rdi, rdx;                            // explicit mask (defensive)
          shl  rdi, 16;                             // rdi = offset_mid (positions 16-31)
          or   rcx, rdi;

          // offset_hi from word1 → rdi, shift to positions 32-63, OR
          mov  rdi, [rax + 8];                      // rdi = word1
          mov  rdx, 0xFFFFFFFF;
          and  rdi, rdx;                            // rdi = offset_hi (positions 0-31)
          shl  rdi, 32;                             // rdi = offset_hi (positions 32-63)
          or   rcx, rdi;

          // Compare reassembled offset against trampoline address.
          cmp  rcx, r12;
          jne  idt_vec24_witness_fail;

          // --- All green ---
          mov rdi, 3;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + idt_vec24_ok_msg];
          call klog_s1;
          jmp  idt_vec24_witness_done;

      idt_vec24_witness_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + idt_vec24_fail_msg];
          call klog_s1;

      idt_vec24_witness_done:
          pop  r13;
          pop  r12;

      // ============================================================
      // R16-M4-005 (#599): ioapic irq4 witness — 2 sub-tests
      // ============================================================
      //
      // IOAPIC internal registers 0x18 (RTE #4 LO) and 0x19 (RTE #4 HI)
      // encode the routing of ISA IRQ 4 to a CPU vector via IOREGSEL/IOWIN.
      //
      // After ioapic_irq4_init:
      //   RTE #4 LO (0x18) = 0x00000024  (vector = 0x24, mask = 0, everything else 0)
      //   RTE #4 HI (0x19) = 0x00000000  (dest APIC ID = 0 in bits 24-31)

      ioapic_irq4_witness:
          push r12;                                 // callee-save: LO value survives A→B

          // ---------- Program IRQ 4 → vec 0x24 → CPU 0 ----------
          call ioapic_irq4_init;

          // ---------- Sub-test A: RTE 4 LO ----------
          mov  rdi, 0x18;                           // RTE 4 LO register index
          call ioapic_read;                         // rax = LO value (32-bit zero-extended)
          mov  r12, rax;                            // save for A2

          // A1: vector byte (bits 0-7) == 0x24
          mov  rcx, r12;
          and  rcx, 0xFF;
          cmp  rcx, 0x24;
          jne  ioapic_irq4_witness_fail;

          // A2: mask bit (bit 16) == 0
          mov  rcx, r12;
          shr  rcx, 16;
          and  rcx, 1;
          cmp  rcx, 0;
          jne  ioapic_irq4_witness_fail;

          // ---------- Sub-test B: RTE 4 HI ----------
          mov  rdi, 0x19;                           // RTE 4 HI register index
          call ioapic_read;                         // rax = HI value (32-bit zero-extended)

          // B1: dest_apic_id byte (bits 24-31) == 0
          shr  rax, 24;
          and  rax, 0xFF;
          cmp  rax, 0;
          jne  ioapic_irq4_witness_fail;

          // --- All green ---
          mov rdi, 3;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + ioapic_irq4_ok_msg];
          call klog_s1;
          jmp  ioapic_irq4_witness_done;

      ioapic_irq4_witness_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + ioapic_irq4_fail_msg];
          call klog_s1;

      ioapic_irq4_witness_done:
          pop  r12;

      // ============================================================
      // R16-M4-006 (#600): uart_rx_notify witness — 3 sub-tests
      // ============================================================
      uart_rx_notify_witness:
          push r12;                                // callee-save: fake-TCB address
          push r13;                                // callee-save: waiter slot address

          // R18-M4-003 (#773): precondition — the runqueue must be empty
          // before Sub-test A's single-element enqueue assertion (CB.head
          // == r12).  Under pre-#773 sentinel semantics the assert was
          // `task.next != 0` (proxy for on-runq that also happened to be
          // true when other tasks were pre-present); post-#773 the sole-
          // element assert only passes if CB.head is exactly r12, which
          // demands an empty starting runq.  Earlier witnesses (notably
          // fd_inherit_witness at ~5155 via sys_fork_body) leave child
          // slabs on the runqueue without a matching runq_dequeue —
          // runq_init here scrubs CB.head/tail per its documented
          // "safe to re-call, orphans linked tasks" idempotency
          // (runqueue.pdx §runq_init).  Mirrors the pattern in
          // sys_exit_witness (line ~2114) and sys_fork_witness
          // (line ~2648).
          call runq_init;

          lea  r12, [rip + _block_witness_task_x];  // fake TCB (reuse #563 slab)
          lea  r13, [rip + _uart_rx_notify_waiter]; // waiter slot address

          // -------- Setup: zero the fake TCB (defensive, .bss = 0 at boot) --------
          xor  rcx, rcx;
          mov  [r12 + 8],   ecx;                    // state (u32) = 0 (NEW)
          mov  [r12 + 432], rcx;                    // runq_next = 0
          mov  [r12 + 440], rcx;                    // runq_prev = 0

          // -------- Sub-test A: direct wake_if_waiter proof --------
          // Set state=WAITING (2); install waiter; call wake; verify.
          mov  ecx, 2;
          mov  [r12 + 8], ecx;                      // state = WAITING

          mov  rdi, r12;
          call uart_rx_notify_set_waiter;           // slot := &TCB

          mov  rax, [r13];
          cmp  rax, r12;
          jne  urxn_witness_fail;                   // slot must equal our TCB

          call uart_rx_notify_wake_if_waiter;       // slot -> 0; sched_wake(TCB)

          // Assert: slot cleared to 0
          mov  rax, [r13];
          cmp  rax, 0;
          jne  urxn_witness_fail;

          // Assert: TCB.state == RUNNABLE (1)
          mov  ecx, [r12 + 8];
          cmp  ecx, 1;
          jne  urxn_witness_fail;

          // Assert: TCB on runq (rewired for #773): sole element on runq
          // means CB.runqueue_head (@ +32) == r12.  Pre-#773 "runq_next
          // != 0" (proxy for on-runq) fails under head/tail-pair — the
          // sole task's runq_next is 0 because it IS the tail.
          mov  rcx, 0xC0000101;
          rdmsr;
          shl  rdx, 32;
          or   rax, rdx;
          mov  rcx, [rax + 32];                     // CB.runqueue_head
          cmp  rcx, r12;
          jne  urxn_witness_fail;

          // -------- Drain between A and B: dequeue TCB, re-zero fields --------
          mov  rdi, r12;
          call runq_dequeue;                        // runq back to empty
          xor  rcx, rcx;
          mov  [r12 + 8],   ecx;                    // state = NEW (defensive)
          mov  [r12 + 432], rcx;
          mov  [r12 + 440], rcx;

          // -------- Sub-test B: ISR-tail wake propagation --------
          mov  ecx, 2;
          mov  [r12 + 8], ecx;                      // state = WAITING
          mov  rdi, r12;
          call uart_rx_notify_set_waiter;           // slot := &TCB

          call uart_rx_isr;                         // empty drain + wake_if_waiter + EOI

          // Assert: slot cleared to 0 (wake propagated through ISR tail)
          mov  rax, [r13];
          cmp  rax, 0;
          jne  urxn_witness_fail;

          // Assert: TCB.state == RUNNABLE (1)
          mov  ecx, [r12 + 8];
          cmp  ecx, 1;
          jne  urxn_witness_fail;

          // Assert: TCB on runq (rewired for #773): sole element on runq
          // means CB.runqueue_head (@ +32) == r12.  See sub-test A above
          // for the rationale (post-head/tail-pair the pre-#773 runq_next
          // proxy no longer distinguishes on/off for a sole element).
          mov  rcx, 0xC0000101;
          rdmsr;
          shl  rdx, 32;
          or   rax, rdx;
          mov  rcx, [rax + 32];                     // CB.runqueue_head
          cmp  rcx, r12;
          jne  urxn_witness_fail;

          // -------- Drain between B and C: dequeue TCB, re-zero fields --------
          mov  rdi, r12;
          call runq_dequeue;
          xor  rcx, rcx;
          mov  [r12 + 8],   ecx;
          mov  [r12 + 432], rcx;
          mov  [r12 + 440], rcx;

          // -------- Sub-test C: no-waiter fast path --------
          // Slot is now 0. wake_if_waiter must be a no-op: TCB state
          // stays 0 (NEW), TCB stays off runq, slot stays 0.
          call uart_rx_notify_wake_if_waiter;

          mov  rax, [r13];
          cmp  rax, 0;
          jne  urxn_witness_fail;

          mov  ecx, [r12 + 8];
          cmp  ecx, 0;
          jne  urxn_witness_fail;                   // state must be NEW (untouched)

          mov  rcx, [r12 + 432];
          cmp  rcx, 0;
          jne  urxn_witness_fail;                   // runq_next must be 0

          // -------- All green --------
          mov rdi, 3;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + uart_rx_notify_ok_msg];
          call klog_s1;
          jmp  urxn_witness_done;

      urxn_witness_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + uart_rx_notify_fail_msg];
          call klog_s1;

      urxn_witness_done:
          pop  r13;
          pop  r12;

      // ============================================================
      // R16-M4-007 (#601): uart_rx_smoke witness — R16.M4 CLOSER
      // Round-trips 'a','b','c' through the RX ring and emits
      // UART RX: abc as the fingerprint AC.
      // ============================================================
      uart_rx_smoke_witness:
          push r12                                 // callee-save: buffer base
          lea  r12, [rip + _uart_rx_smoke_buf]     // r12 = &buf[0]

          // ---------- Sub-test A: enqueue 'a','b','c' ----------
          mov  rdi, 0x61                           // 'a'
          call uart_rx_enqueue
          cmp  rax, 0                              // ENQUEUE_OK
          jne  uart_rx_smoke_witness_fail

          mov  rdi, 0x62                           // 'b'
          call uart_rx_enqueue
          cmp  rax, 0
          jne  uart_rx_smoke_witness_fail

          mov  rdi, 0x63                           // 'c'
          call uart_rx_enqueue
          cmp  rax, 0
          jne  uart_rx_smoke_witness_fail

          // ---------- Sub-test B: dequeue 3 bytes into buf[0..3] ----------
          call uart_rx_dequeue
          cmp  rax, 0xFF                           // upper bound of a real byte
          ja   uart_rx_smoke_witness_fail          // 0xFFFF sentinel > 0xFF → empty
          mov_b [r12 + 0], rax                     // buf[0] = dequeued byte #1

          call uart_rx_dequeue
          cmp  rax, 0xFF
          ja   uart_rx_smoke_witness_fail
          mov_b [r12 + 1], rax                     // buf[1] = dequeued byte #2

          call uart_rx_dequeue
          cmp  rax, 0xFF
          ja   uart_rx_smoke_witness_fail
          mov_b [r12 + 2], rax                     // buf[2] = dequeued byte #3

          // ---------- Sub-test C: ring must be empty now ----------
          call uart_rx_dequeue
          cmp  rax, 0xFFFF                         // DEQUEUE_EMPTY sentinel
          jne  uart_rx_smoke_witness_fail

          // ---------- Sub-test D: terminate the buffer and emit ----------
          mov  rax, 0x0A                           // '\n'
          mov_b [r12 + 3], rax
          xor  rax, rax
          mov_b [r12 + 4], rax                     // '\0' string terminator

          // --- Emit prefix ("UART RX: ") then buffer ("abc\n") ---
          // #704: prefix stays as raw uart_puts (NOT klog_s1) so it lands
          // adjacent to the buffer emission on the wire. klog_s1 would append
          // its own newline after "UART RX: ", splitting "UART RX: abc" into
          // two lines and breaking the fingerprint's contiguity check.
          lea  rdi, [rip + uart_rx_smoke_prefix_msg]; // klog-migrate: skip — #704 wire fingerprint (see comment above); paideia-as#1275
          call uart_puts;

          mov  rdi, r12                            // &_uart_rx_smoke_buf
          call uart_puts

          jmp  uart_rx_smoke_witness_done

      uart_rx_smoke_witness_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + uart_rx_smoke_fail_msg];
          call klog_s1;

      uart_rx_smoke_witness_done:
          pop  r12

      // ============================================================
      // R16-M5-001 (#602): tty_init witness — 3 sub-tests, 1 marker
      //
      // Preamble: the vnode pool is fully allocated at this point in boot
      //           (the #571 vnode_pool witness fills all 256 slots to OOM;
      //           #574's mount witness and #577's vfs_read/write witness
      //           each free-then-immediately-reclaim one scratch slot,
      //           per their own preambles — net pool occupancy stays at
      //           256/256 throughout). Free slot 201 (untouched by any
      //           prior witness; distinct from #574's slot 100, which now
      //           holds the live mount root vnode, and #577's slot 200,
      //           which holds that witness's now-orphaned but still-
      //           allocated fixture vnode) so tty_init's vnode_alloc has a
      //           bit to find. Slot 201 was only ever touched by the #571
      //           fill-loop (which just sets its bitmap bit — vnode_alloc
      //           never writes slot storage), so its 64 bytes are still
      //           zero from the .bss uninit; freeing it recycles the
      //           bitmap bit without disturbing any live vnode.
      // ============================================================
      tty_init_witness:
          push r12                              // callee-save: carries tty_idx
                                                // across uart_puts calls

          // --- Preamble: free slot 201 to make room for tty_init's vnode_alloc ---
          mov  rdi, 201
          call vnode_free

          // ---------- Sub-test A: tty_init returns a valid idx ----------
          call tty_init
          cmp  rax, 0                           // slot 0 is reserved — never returned
          je   tty_init_witness_fail
          cmp  rax, 0xFFFF                      // VNODE_ALLOC_OOM sentinel
          je   tty_init_witness_fail
          mov  r12, rax                         // r12 = tty_idx for sub-tests B/C

          // ---------- Sub-test B: _tty0 slot contains the returned idx ----------
          mov  rax, [rip + _tty0]
          and  rax, 0xFFFF                      // extract u16 idx from u64 slot
          cmp  rax, r12
          jne  tty_init_witness_fail

          // ---------- Sub-test C: vnode.type at +0 == CHRDEV (4) ----------
          mov  rdi, r12                         // vnode idx
          call vnode_slot                       // rax = &_vnode_pool[tty_idx]
          mov  rcx, [rax + 0]                   // load u64 covering type/flags/mode/refcount/link_count
          and  rcx, 0xFF                        // extract type byte (+0)
          cmp  rcx, 4                           // VNODE_TYPE_CHRDEV
          jne  tty_init_witness_fail

          // ---------- All green ----------
          mov rdi, 3;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + tty_ok_msg];
          call klog_s1;
          jmp  tty_init_witness_done

      tty_init_witness_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + tty_fail_msg];
          call klog_s1;

      tty_init_witness_done:
          pop  r12

      // ============================================================
      // R16-M5-002 (#603): tty_vops_init call + witness
      // ============================================================
      call tty_vops_init                          // populate _tty_vops + wire _tty0.ops_ptr

      tty_vops_witness:
          push r12                              // callee-save: carries &_tty0_vnode
                                                // across uart_puts and vops_* calls

          // ---- Recover &_tty0's vnode (used by all 3 sub-tests) ----
          mov  rax, [rip + _tty0]               // load u64 slot
          and  rax, 0xFFFF                      // extract u16 idx
          mov  rdi, rax
          call vnode_slot                       // rax = &_vnode_pool[tty_idx]
          mov  r12, rax                         // r12 = &_tty0_vnode

          // ---- Sub-test A: vops_lookup on null slot returns E_NOT_SUPPORTED ----
          mov  rdi, r12                         // dir_vn = &_tty0_vnode
          xor  rsi, rsi                         // name_ptr = 0 (unused; dispatcher
                                                //   short-circuits on null slot)
          call vops_lookup                      // -> _tty_vops[+32] == 0
                                                // -> VOPS_ERR_NOT_SUPPORTED
          mov  rcx, 0xFFFFFFFFFFFFFFFF          // E_NOT_SUPPORTED sentinel
          cmp  rax, rcx
          jne  tty_vops_witness_fail

          // ---- Sub-test B: vops_open on wired slot returns 0 ----
          mov  rdi, r12                         // vn = &_tty0_vnode
          xor  rsi, rsi                         // flags = 0
          call vops_open                        // -> _tty_vops[+16] == &tty_open
                                                // -> tty_open returns 0
          cmp  rax, 0
          jne  tty_vops_witness_fail

          // ---- Sub-test C: vops_read on wired slot returns 3 ----
          // #667 prefill: inject "hi\n" so tty_read_try returns 3 and wrapper skips sched_block
          // (pre-process_init _current_tcb == 0; sched_block's #663 guard would fault)
          mov  rdi, 0x68;  call tty_line_append    // 'h'
          mov  rdi, 0x69;  call tty_line_append    // 'i'
          mov  rdi, 0x0A;  call tty_line_append    // '\n' — commits line_complete

          // Sub-test C: call vops_read with buf/len so tty_read_try can return the 3 bytes
          sub  rsp, 8                             // allocate 8-byte temp buffer
          mov  rdi, r12                           // vn = &_tty0_vnode
          lea  rsi, [rsp + 0]                     // buf = temp buffer on stack
          mov  rdx, 8                             // len = 8 (enough for "hi\n")
          xor  rcx, rcx                           // off = 0
          call vops_read                          // -> _tty_vops[+0] == &tty_read
                                                  // -> tty_read returns 3
          add  rsp, 8                             // deallocate temp buffer
          cmp  rax, 3
          jne  tty_vops_witness_fail

          // ---- All green ----
          mov rdi, 3;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + tty_vops_ok_msg];
          call klog_s1;
          jmp  tty_vops_witness_done

      tty_vops_witness_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + tty_vops_fail_msg];
          call klog_s1;

      tty_vops_witness_done:
          pop  r12

      // ============================================================
      // R16-M5-003 (#604): tty_line_buffer witness - 5 sub-tests
      // ============================================================
      tty_line_witness:
          push r12

          // Sub-test A: fresh state
          mov  rax, [rip + _tty_line_head]
          cmp  rax, 0
          jne  tty_line_witness_fail
          call tty_line_available
          cmp  rax, 0
          jne  tty_line_witness_fail

          // Sub-test B: append a,b,c -> head=3, complete=0
          mov  rdi, 0x61
          call tty_line_append
          cmp  rax, 0
          jne  tty_line_witness_fail
          mov  rdi, 0x62
          call tty_line_append
          cmp  rax, 0
          jne  tty_line_witness_fail
          mov  rdi, 0x63
          call tty_line_append
          cmp  rax, 0
          jne  tty_line_witness_fail

          mov  rax, [rip + _tty_line_head]
          cmp  rax, 3
          jne  tty_line_witness_fail
          call tty_line_available
          cmp  rax, 0
          jne  tty_line_witness_fail

          // Sub-test C: append newline -> head=4, complete=1
          mov  rdi, 0x0A
          call tty_line_append
          cmp  rax, 0
          jne  tty_line_witness_fail

          mov  rax, [rip + _tty_line_head]
          cmp  rax, 4
          jne  tty_line_witness_fail
          call tty_line_available
          cmp  rax, 1
          jne  tty_line_witness_fail

          // Sub-test D: reset -> head=0, complete=0
          call tty_line_reset
          cmp  rax, 0
          jne  tty_line_witness_fail

          mov  rax, [rip + _tty_line_head]
          cmp  rax, 0
          jne  tty_line_witness_fail
          call tty_line_available
          cmp  rax, 0
          jne  tty_line_witness_fail

          // Sub-test E: overflow - fill 256 X, 257th returns 1
          xor r12, r12
        tlw_fill_loop:
          mov rdi, 0x58
          call tty_line_append
          cmp rax, 0
          jne tty_line_witness_fail
          add r12, 1
          cmp r12, 256
          jb  tlw_fill_loop

          // State check: head == 256, complete == 0
          mov  rax, [rip + _tty_line_head]
          cmp  rax, 256
          jne  tty_line_witness_fail
          call tty_line_available
          cmp  rax, 0
          jne  tty_line_witness_fail

          // 257th append must return 1 with no state change
          mov  rdi, 0x59
          call tty_line_append
          cmp  rax, 1
          jne  tty_line_witness_fail

          // Verify state unchanged post-overflow
          mov  rax, [rip + _tty_line_head]
          cmp  rax, 256
          jne  tty_line_witness_fail
          call tty_line_available
          cmp  rax, 0
          jne  tty_line_witness_fail

          // All green
          mov rdi, 3;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + tty_line_ok_msg];
          call klog_s1;
          jmp  tty_line_witness_done

      tty_line_witness_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + tty_line_fail_msg];
          call klog_s1;

      tty_line_witness_done:
          pop  r12

      // ============================================================
      // R16-M5-004 (#605): tty_process_input witness - 5 sub-tests
      // ============================================================
      tty_input_witness:
          push r12;                               // callee-save loop counter

          // ---------- Sub-test A: type "hello\r" -> buffer "hello\n" ----------
          call tty_line_reset;

          mov  rdi, 0x68;                         // 'h'
          call tty_process_input;
          mov  rdi, 0x65;                         // 'e'
          call tty_process_input;
          mov  rdi, 0x6C;                         // 'l'
          call tty_process_input;
          mov  rdi, 0x6C;                         // 'l'
          call tty_process_input;
          mov  rdi, 0x6F;                         // 'o'
          call tty_process_input;
          mov  rdi, 0x0D;                         // '\r' (Enter)
          call tty_process_input;

          // State assertions
          mov  rax, [rip + _tty_line_head];
          cmp  rax, 6;
          jne  tty_input_witness_fail;
          call tty_line_available;
          cmp  rax, 1;
          jne  tty_input_witness_fail;

          // Byte-by-byte buffer verification: "hello\n"
          lea  r12, [rip + _tty_line_buf];
          xor  rax, rax;
          mov_b rax, [r12 + 0];
          cmp  rax, 0x68;                         // 'h'
          jne  tty_input_witness_fail;
          xor  rax, rax;
          mov_b rax, [r12 + 1];
          cmp  rax, 0x65;                         // 'e'
          jne  tty_input_witness_fail;
          xor  rax, rax;
          mov_b rax, [r12 + 2];
          cmp  rax, 0x6C;                         // 'l'
          jne  tty_input_witness_fail;
          xor  rax, rax;
          mov_b rax, [r12 + 3];
          cmp  rax, 0x6C;                         // 'l'
          jne  tty_input_witness_fail;
          xor  rax, rax;
          mov_b rax, [r12 + 4];
          cmp  rax, 0x6F;                         // 'o'
          jne  tty_input_witness_fail;
          xor  rax, rax;
          mov_b rax, [r12 + 5];
          cmp  rax, 0x0A;                         // '\n' translated from CR
          jne  tty_input_witness_fail;

          // ---------- Sub-test B: LF-as-raw-input ----------
          call tty_line_reset;

          mov  rdi, 0x0A;                         // '\n' raw
          call tty_process_input;

          mov  rax, [rip + _tty_line_head];
          cmp  rax, 1;
          jne  tty_input_witness_fail;
          call tty_line_available;
          cmp  rax, 1;
          jne  tty_input_witness_fail;

          xor  rax, rax;
          mov_b rax, [r12 + 0];                   // r12 still holds &_tty_line_buf
          cmp  rax, 0x0A;
          jne  tty_input_witness_fail;

          // ---------- Sub-test C: printable-only, no newline ----------
          call tty_line_reset;

          mov  rdi, 0x61;                         // 'a'
          call tty_process_input;
          mov  rdi, 0x62;                         // 'b'
          call tty_process_input;
          mov  rdi, 0x63;                         // 'c'
          call tty_process_input;

          mov  rax, [rip + _tty_line_head];
          cmp  rax, 3;
          jne  tty_input_witness_fail;
          call tty_line_available;
          cmp  rax, 0;                            // complete must not be set
          jne  tty_input_witness_fail;

          // ---------- Sub-test D: backspace (composed with C state) ----------
          mov  rdi, 0x08;                         // BS
          call tty_process_input;
          mov  rax, [rip + _tty_line_head];
          cmp  rax, 2;
          jne  tty_input_witness_fail;

          mov  rdi, 0x7F;                         // DEL (same handler)
          call tty_process_input;
          mov  rax, [rip + _tty_line_head];
          cmp  rax, 1;
          jne  tty_input_witness_fail;

          mov  rdi, 0x08;                         // BS to head 0
          call tty_process_input;
          mov  rax, [rip + _tty_line_head];
          cmp  rax, 0;
          jne  tty_input_witness_fail;

          mov  rdi, 0x08;                         // BS on empty is no-op
          call tty_process_input;
          mov  rax, [rip + _tty_line_head];
          cmp  rax, 0;
          jne  tty_input_witness_fail;

          // ---------- Sub-test E: overflow-bell path ----------
          call tty_line_reset;

          xor  r12, r12;                          // i = 0
        tiw_fill_loop:
          mov  rdi, 0x58;                         // 'X'
          call tty_process_input;
          add  r12, 1;
          cmp  r12, 256;
          jb   tiw_fill_loop;

          // State assertion after fill: head=256, complete=0
          mov  rax, [rip + _tty_line_head];
          cmp  rax, 256;
          jne  tty_input_witness_fail;
          call tty_line_available;
          cmp  rax, 0;
          jne  tty_input_witness_fail;

          // Byte 257: append returns 1, process_input emits BEL, state unchanged
          mov  rdi, 0x59;                         // 'Y' overflowed
          call tty_process_input;

          mov  rax, [rip + _tty_line_head];
          cmp  rax, 256;
          jne  tty_input_witness_fail;
          call tty_line_available;
          cmp  rax, 0;
          jne  tty_input_witness_fail;

          // ---------- All green ----------
          mov rdi, 3;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + tty_input_ok_msg];
          call klog_s1;
          jmp  tty_input_witness_done;

      tty_input_witness_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + tty_input_fail_msg];
          call klog_s1;

      tty_input_witness_done:
          pop  r12;

      // ============================================================
      // R16-M5-005 (#606): tty_read witness — 5 sub-tests
      // ============================================================
      tty_read_witness:
          push r12                                   // callee-save fixture-base cache

          lea  r12, [rip + _tty_read_witness_buf]   // r12 = &witness buf (survives all calls)

          // ---------- Sub-test A: complete line "hello\n" → 6 bytes ----------
          call tty_line_reset

          mov  rdi, 0x68
          call tty_line_append                      // 'h'
          mov  rdi, 0x65
          call tty_line_append                      // 'e'
          mov  rdi, 0x6C
          call tty_line_append                      // 'l'
          mov  rdi, 0x6C
          call tty_line_append                      // 'l'
          mov  rdi, 0x6F
          call tty_line_append                      // 'o'
          mov  rdi, 0x0A
          call tty_line_append                      // '\n' → sets complete

          // Sanity: line buffer state ready for read.
          mov  rax, [rip + _tty_line_head]
          cmp  rax, 6
          jne  tty_read_witness_fail
          call tty_line_available
          cmp  rax, 1
          jne  tty_read_witness_fail

          // Read.
          xor  rdi, rdi                              // vn = 0
          mov  rsi, r12                              // buf
          mov  rdx, 64                               // len
          xor  rcx, rcx                              // off = 0
          call tty_read_try

          // Assert return value.
          cmp  rax, 6
          jne  tty_read_witness_fail

          // Assert post-read state: head=0, complete=0.
          mov  rax, [rip + _tty_line_head]
          cmp  rax, 0
          jne  tty_read_witness_fail
          call tty_line_available
          cmp  rax, 0
          jne  tty_read_witness_fail

          // Assert buf contents byte-by-byte: "hello\n".
          xor  rax, rax
          mov_b rax, [r12 + 0]
          cmp  rax, 0x68
          jne  tty_read_witness_fail                 // 'h'
          xor  rax, rax
          mov_b rax, [r12 + 1]
          cmp  rax, 0x65
          jne  tty_read_witness_fail                 // 'e'
          xor  rax, rax
          mov_b rax, [r12 + 2]
          cmp  rax, 0x6C
          jne  tty_read_witness_fail                 // 'l'
          xor  rax, rax
          mov_b rax, [r12 + 3]
          cmp  rax, 0x6C
          jne  tty_read_witness_fail                 // 'l'
          xor  rax, rax
          mov_b rax, [r12 + 4]
          cmp  rax, 0x6F
          jne  tty_read_witness_fail                 // 'o'
          xor  rax, rax
          mov_b rax, [r12 + 5]
          cmp  rax, 0x0A
          jne  tty_read_witness_fail                 // '\n'

          // ---------- Sub-test B: empty (no complete line) → 0 ----------
          // State from A: head=0, complete=0 already (fast path reset).
          // Extra sanity: reset explicitly.
          call tty_line_reset

          xor  rdi, rdi
          mov  rsi, r12
          mov  rdx, 64
          xor  rcx, rcx
          call tty_read_try

          cmp  rax, 0
          jne  tty_read_witness_fail

          // Assert buf unchanged (byte [0] still 'h' from A).
          xor  rax, rax
          mov_b rax, [r12 + 0]
          cmp  rax, 0x68
          jne  tty_read_witness_fail

          // ---------- Sub-test C: partial line (head>0, complete==0) → 0 ----------
          call tty_line_reset
          mov  rdi, 0x61
          call tty_line_append                      // 'a'
          mov  rdi, 0x62
          call tty_line_append                      // 'b'
          mov  rdi, 0x63
          call tty_line_append                      // 'c'

          // Confirm setup: head=3, complete=0.
          mov  rax, [rip + _tty_line_head]
          cmp  rax, 3
          jne  tty_read_witness_fail
          call tty_line_available
          cmp  rax, 0
          jne  tty_read_witness_fail

          xor  rdi, rdi
          mov  rsi, r12
          mov  rdx, 64
          xor  rcx, rcx
          call tty_read_try

          cmp  rax, 0
          jne  tty_read_witness_fail

          // Assert state unchanged.
          mov  rax, [rip + _tty_line_head]
          cmp  rax, 3
          jne  tty_read_witness_fail
          call tty_line_available
          cmp  rax, 0
          jne  tty_read_witness_fail

          // ---------- Sub-test D: double read; second returns 0 ----------
          call tty_line_reset
          mov  rdi, 0x68
          call tty_line_append                      // 'h'
          mov  rdi, 0x69
          call tty_line_append                      // 'i'
          mov  rdi, 0x0A
          call tty_line_append                      // '\n'

          // First read.
          xor  rdi, rdi
          mov  rsi, r12
          mov  rdx, 64
          xor  rcx, rcx
          call tty_read_try
          cmp  rax, 3
          jne  tty_read_witness_fail

          // Second read on now-empty buffer.
          xor  rdi, rdi
          mov  rsi, r12
          mov  rdx, 64
          xor  rcx, rcx
          call tty_read_try
          cmp  rax, 0
          jne  tty_read_witness_fail

          // ---------- Sub-test E: partial-read cursor (len < head) ----------
          // #756 revision: prior semantics were "unconditional reset,
          // drop tail". New semantics per design §6.6: advance
          // _tty_line_read_cursor; reset only when cursor == head.
          // This sub-test now exercises the two-call drain of a
          // "hello\n" line via len=3 reads and asserts that (1) the
          // first call returns "hel" while leaving head/complete/cursor
          // in the mid-drain state, and (2) the second call returns
          // "lo\n" and triggers the reset once cursor catches up to
          // head. This is the exact invariant the shell relies on when
          // it issues sys_read(0, buf, 1) six times to consume a
          // "hello\n" prompt line.
          call tty_line_reset
          mov  rdi, 0x68
          call tty_line_append                      // 'h'
          mov  rdi, 0x65
          call tty_line_append                      // 'e'
          mov  rdi, 0x6C
          call tty_line_append                      // 'l'
          mov  rdi, 0x6C
          call tty_line_append                      // 'l'
          mov  rdi, 0x6F
          call tty_line_append                      // 'o'
          mov  rdi, 0x0A
          call tty_line_append                      // '\n'

          // First partial read: len=3 out of head=6.
          xor  rdi, rdi
          mov  rsi, r12
          mov  rdx, 3                                // len = 3 (< head=6)
          xor  rcx, rcx
          call tty_read_try

          cmp  rax, 3
          jne  tty_read_witness_fail

          // Assert buf[0..3] == "hel".
          xor  rax, rax
          mov_b rax, [r12 + 0]
          cmp  rax, 0x68
          jne  tty_read_witness_fail
          xor  rax, rax
          mov_b rax, [r12 + 1]
          cmp  rax, 0x65
          jne  tty_read_witness_fail
          xor  rax, rax
          mov_b rax, [r12 + 2]
          cmp  rax, 0x6C
          jne  tty_read_witness_fail

          // #756: mid-drain state. head/complete unchanged; cursor
          // has advanced to 3. tty_line_reset has NOT fired yet.
          mov  rax, [rip + _tty_line_head]
          cmp  rax, 6
          jne  tty_read_witness_fail
          call tty_line_available
          cmp  rax, 1
          jne  tty_read_witness_fail
          mov  rax, [rip + _tty_line_read_cursor]
          cmp  rax, 3
          jne  tty_read_witness_fail

          // Second partial read: len=3, drains remaining "lo\n".
          xor  rdi, rdi
          mov  rsi, r12
          mov  rdx, 3
          xor  rcx, rcx
          call tty_read_try

          cmp  rax, 3
          jne  tty_read_witness_fail

          // Assert buf[0..3] == "lo\n".
          xor  rax, rax
          mov_b rax, [r12 + 0]
          cmp  rax, 0x6C
          jne  tty_read_witness_fail                 // 'l'
          xor  rax, rax
          mov_b rax, [r12 + 1]
          cmp  rax, 0x6F
          jne  tty_read_witness_fail                 // 'o'
          xor  rax, rax
          mov_b rax, [r12 + 2]
          cmp  rax, 0x0A
          jne  tty_read_witness_fail                 // '\n'

          // #756: post-full-drain reset. cursor caught up to head so
          // tty_line_reset fired inside tty_read_try. head=0,
          // complete=0, cursor=0.
          mov  rax, [rip + _tty_line_head]
          cmp  rax, 0
          jne  tty_read_witness_fail
          call tty_line_available
          cmp  rax, 0
          jne  tty_read_witness_fail
          mov  rax, [rip + _tty_line_read_cursor]
          cmp  rax, 0
          jne  tty_read_witness_fail

          // ---------- All green ----------
          mov rdi, 3;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + tty_read_ok_msg];
          call klog_s1;
          jmp  tty_read_witness_done

      tty_read_witness_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + tty_read_fail_msg];
          call klog_s1;

      tty_read_witness_done:
          pop  r12

      // ============================================================
      // R17-M5 (#748): tty stdin bridge witness — 3 sub-tests
      //
      // Proves that _uart_rx_ring bytes reach _tty_line_buf via the new
      // tty_stdin_drain bridge, which is called from tty_read's cli-guarded
      // slow path. Also validates the empty-ring fast-path (drain is a
      // no-op when ring is empty).
      //
      // Sub-tests:
      //   A. Fresh state: reset line_buf; call tty_stdin_drain on an
      //      empty ring; assert head=0, complete=0 (drain must not
      //      spuriously mutate line_buf when ring is empty).
      //   B. Single byte: reset; enqueue 'x' via uart_rx_enqueue; drain;
      //      assert head=1, buf[0]='x', complete=0 (single byte routes
      //      through tty_process_input's normal path — appended, echoed,
      //      no newline yet).
      //   C. Complete line via ring: reset; enqueue 'y' + '\n'; drain;
      //      assert head=2, buf[0]='y', buf[1]='\n', complete=1 (the
      //      '\n' commits the line — the exact condition tty_read_try
      //      needs to return non-zero, which is what sys_read(0, ...)
      //      ultimately dispatches to).
      //
      // Post-witness ring state: head==tail (all enqueued bytes drained).
      //   This preserves uart_rx_wire_witness's precondition at ~L8140
      //   ("ring is empty at entry") — see design/kernel/r16-m4-666.md §7.
      //
      // Post-witness line_buf state: sub-test C leaves head=2, complete=1.
      //   tty_write_witness (next block) does not touch line_buf. But the
      //   later tty_smoke_witness/tty_connect witnesses may. If any of
      //   those expects a clean line_buf, we reset it here before emitting
      //   the OK marker for safety.
      //
      // Register discipline: no callee-save spills needed — every check
      //   uses only rax/rcx/rdi (all caller-save). Fixture-free.
      //
      // TX-echo note: sub-tests B and C invoke tty_process_input which
      //   echoes 1..2 bytes per input to COM1 THR (uart_putc). Those
      //   echoes appear on the wire between tty_read_witness_done's
      //   R16 TTY READ OK klog line and this witness's marker. They
      //   are raw single-byte writes (not full klog lines), so the
      //   contains-in-order fingerprint scan tolerates them — every
      //   expected line still appears in order. Verified against
      //   tests/r16/expected-boot-r16-uart-rx.txt and
      //   tests/r17/expected-boot-r17-init.txt.
      // ============================================================
      tty_stdin_bridge_witness:

          // ---------- Sub-test A: empty-ring drain is a no-op ----------
          call tty_line_reset                        // baseline: head=0, complete=0
          call tty_stdin_drain                       // ring is empty from boot
          mov  rax, [rip + _tty_line_head]
          cmp  rax, 0
          jne  tty_stdin_bridge_witness_fail
          call tty_line_available
          cmp  rax, 0
          jne  tty_stdin_bridge_witness_fail

          // ---------- Sub-test B: single-byte round-trip ----------
          call tty_line_reset
          mov  rdi, 0x78                             // 'x'
          call uart_rx_enqueue                       // -> ring[head++] = 'x'
          cmp  rax, 0                                // 0 = ENQUEUE_OK
          jne  tty_stdin_bridge_witness_fail
          call tty_stdin_drain                       // ring → line_buf via tty_process_input
          mov  rax, [rip + _tty_line_head]
          cmp  rax, 1                                // head==1: exactly one byte appended
          jne  tty_stdin_bridge_witness_fail
          xor  rax, rax
          mov_b rax, [rip + _tty_line_buf]           // buf[0] should be 'x'
          cmp  rax, 0x78
          jne  tty_stdin_bridge_witness_fail
          call tty_line_available                    // no newline yet → 0
          cmp  rax, 0
          jne  tty_stdin_bridge_witness_fail

          // ---------- Sub-test C: complete-line round-trip ----------
          call tty_line_reset
          mov  rdi, 0x79                             // 'y'
          call uart_rx_enqueue
          cmp  rax, 0
          jne  tty_stdin_bridge_witness_fail
          mov  rdi, 0x0A                             // '\n' — commits line_complete
          call uart_rx_enqueue
          cmp  rax, 0
          jne  tty_stdin_bridge_witness_fail
          call tty_stdin_drain

          mov  rax, [rip + _tty_line_head]
          cmp  rax, 2                                // 'y' + '\n' (LF stays LF, not doubled)
          jne  tty_stdin_bridge_witness_fail
          xor  rax, rax
          mov_b rax, [rip + _tty_line_buf + 0]
          cmp  rax, 0x79                             // buf[0] == 'y'
          jne  tty_stdin_bridge_witness_fail
          xor  rax, rax
          mov_b rax, [rip + _tty_line_buf + 1]
          cmp  rax, 0x0A                             // buf[1] == '\n'
          jne  tty_stdin_bridge_witness_fail
          call tty_line_available                    // complete flag set → 1
          cmp  rax, 1
          jne  tty_stdin_bridge_witness_fail

          // Reset line_buf so downstream witnesses see a clean state.
          call tty_line_reset

          // ---------- All green ----------
          mov rdi, 3;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + tty_stdin_bridge_ok_msg];
          call klog_s1;
          jmp  tty_stdin_bridge_witness_done

      tty_stdin_bridge_witness_fail:
          mov rdi, 1;                                // LEVEL_ERROR
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + tty_stdin_bridge_fail_msg];
          call klog_s1;

      tty_stdin_bridge_witness_done:

      // ============================================================
      // R16-M5-006 (#607): tty_write witness — 3 sub-tests
      // ============================================================
      tty_write_witness:
          push r12                                   // callee-save fixture-base cache

          // ---------- Sub-test A: tty_write(0, "hi\n", 3, 0) returns 3 ----------
          lea  r12, [rip + _tty_write_witness_a]    // r12 = "hi\n"
          xor  rdi, rdi                              // vn = 0
          mov  rsi, r12                              // buf = "hi\n"
          mov  rdx, 3                                // len = 3
          xor  rcx, rcx                              // off = 0
          call tty_write

          // Assert return value == 3
          cmp  rax, 3
          jne  tty_write_witness_fail

          // ---------- Sub-test B: tty_write(0, "abc", 3, 0) returns 3 ----------
          lea  r12, [rip + _tty_write_witness_b]    // r12 = "abc"
          xor  rdi, rdi                              // vn = 0
          mov  rsi, r12                              // buf = "abc"
          mov  rdx, 3                                // len = 3
          xor  rcx, rcx                              // off = 0
          call tty_write

          // Assert return value == 3
          cmp  rax, 3
          jne  tty_write_witness_fail

          // ---------- Sub-test C: tty_write(0, "", 0, 0) returns 0 ----------
          xor  rdi, rdi                              // vn = 0
          xor  rsi, rsi                              // buf = (empty, not dereferenced)
          xor  rdx, rdx                              // len = 0
          xor  rcx, rcx                              // off = 0
          call tty_write

          // Assert return value == 0
          cmp  rax, 0
          jne  tty_write_witness_fail

          // ---------- All checks green ----------
          mov rdi, 3;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + tty_write_ok_msg];
          call klog_s1;
          jmp  tty_write_witness_done

      tty_write_witness_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + tty_write_fail_msg];
          call klog_s1;

      tty_write_witness_done:
          pop  r12

      // ============================================================
      // R16-M5-007 (#608): tty_connect_init witness — 4 sub-tests, 1 marker
      // ============================================================
      tty_connect_witness:
          push r15;                             // callee-save: carries R (pre-refcount)

          // ---------- Preamble: snapshot _tty0.refcount ----------
          mov  rax, [rip + _tty0];
          and  rax, 0xFFFF;
          mov  rdi, rax;
          call vnode_slot;
          xor  rcx, rcx;
          mov_w rcx, [rax + 4];
          mov  r15, rcx;                        // r15 = R (survives sub-tests)

          // ---------- Call the primitive under test ----------
          lea  rdi, [rip + _tty_connect_witness_task];
          call tty_connect_init;
          cmp  rax, 0;
          jne  tty_connect_witness_fail;

          // ---------- Sub-test A: fd_table[0] == packed _tty0 ----------
          lea  rdi, [rip + _tty_connect_witness_task];
          xor  rsi, rsi;
          call fd_get;
          and  rax, 0xFFFF;
          mov  rcx, [rip + _tty0];
          and  rcx, 0xFFFF;
          cmp  rax, rcx;
          jne  tty_connect_witness_fail;

          // ---------- Sub-test B: fd_table[1] == packed _tty0 ----------
          lea  rdi, [rip + _tty_connect_witness_task];
          mov  rsi, 1;
          call fd_get;
          and  rax, 0xFFFF;
          mov  rcx, [rip + _tty0];
          and  rcx, 0xFFFF;
          cmp  rax, rcx;
          jne  tty_connect_witness_fail;

          // ---------- Sub-test D: fd_table[2] == packed _tty0 ----------
          lea  rdi, [rip + _tty_connect_witness_task];
          mov  rsi, 2;
          call fd_get;
          and  rax, 0xFFFF;
          mov  rcx, [rip + _tty0];
          and  rcx, 0xFFFF;
          cmp  rax, rcx;
          jne  tty_connect_witness_fail;

          // ---------- Sub-test C: _tty0.refcount == R + 3 ----------
          mov  rax, [rip + _tty0];
          and  rax, 0xFFFF;
          mov  rdi, rax;
          call vnode_slot;
          xor  rcx, rcx;
          mov_w rcx, [rax + 4];
          mov  rax, r15;
          add  rax, 3;
          cmp  rcx, rax;
          jne  tty_connect_witness_fail;

          // ---------- All green ----------
          mov rdi, 3;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + tty_connect_ok_msg];
          call klog_s1;
          jmp  tty_connect_witness_done;

      tty_connect_witness_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + tty_connect_fail_msg];
          call klog_s1;

      tty_connect_witness_done:
          pop  r15;

      // ============================================================
      // R16-M5-009 (#609): tty_smoke integration witness — inline manually-fed input
      // ============================================================
      // Structural closer using in-kernel simulation (no real IRQ).
      // Feed "hello\n" via tty_process_input, read it back via tty_read_try,
      // verify output, then call tty_write("hi\n") to exercise the full stack.

      tty_smoke_witness:
          // Reset line buffer state before feeding input
          xor rax, rax;
          mov [rip + _tty_line_head], rax;
          mov [rip + _tty_line_complete], rax;

          // Feed 'h' (0x68) through tty_process_input
          mov rdi, 0x68;
          call tty_process_input;

          // Feed 'e' (0x65)
          mov rdi, 0x65;
          call tty_process_input;

          // Feed 'l' (0x6C)
          mov rdi, 0x6C;
          call tty_process_input;

          // Feed 'l' (0x6C)
          mov rdi, 0x6C;
          call tty_process_input;

          // Feed 'o' (0x6F)
          mov rdi, 0x6F;
          call tty_process_input;

          // Feed '\n' (0x0A) - this sets _tty_line_complete = 1
          mov rdi, 0x0A;
          call tty_process_input;

          // Call tty_read_try(0, _tty_smoke_dst_buf, 10, 0)
          xor rdi, rdi;                              // vn = 0
          lea rsi, [rip + _tty_smoke_dst_buf];       // buf
          mov rdx, 10;                               // len
          xor rcx, rcx;                              // off = 0
          call tty_read_try;

          // Verify rax == 6 (should have read 6 bytes: "hello\n")
          cmp rax, 6;
          jne tty_smoke_witness_fail;

          // Verify dst_buf[0..5] contains "hello\n"
          lea r8, [rip + _tty_smoke_dst_buf];

          // Check [0] == 'h' (0x68)
          mov r9, r8;
          xor rax, rax;
          mov_b rax, [r9 + 0];
          cmp rax, 0x68;
          jne tty_smoke_witness_fail;

          // Check [1] == 'e' (0x65)
          mov r9, r8;
          xor rax, rax;
          mov_b rax, [r9 + 1];
          cmp rax, 0x65;
          jne tty_smoke_witness_fail;

          // Check [2] == 'l' (0x6C)
          mov r9, r8;
          xor rax, rax;
          mov_b rax, [r9 + 2];
          cmp rax, 0x6C;
          jne tty_smoke_witness_fail;

          // Check [3] == 'l' (0x6C)
          mov r9, r8;
          xor rax, rax;
          mov_b rax, [r9 + 3];
          cmp rax, 0x6C;
          jne tty_smoke_witness_fail;

          // Check [4] == 'o' (0x6F)
          mov r9, r8;
          xor rax, rax;
          mov_b rax, [r9 + 4];
          cmp rax, 0x6F;
          jne tty_smoke_witness_fail;

          // Check [5] == '\n' (0x0A)
          mov r9, r8;
          xor rax, rax;
          mov_b rax, [r9 + 5];
          cmp rax, 0x0A;
          jne tty_smoke_witness_fail;

          // Call tty_write(0, "hi\n", 3, 0)
          // We need to build the "hi\n" string temporarily or use a constant
          // Let's use a small inline buffer for this
          xor rdi, rdi;                              // vn = 0
          lea rsi, [rip + _tty_write_witness_a];    // buf = &"hi\n"
          mov rdx, 3;                                // len = 3
          xor rcx, rcx;                              // off = 0
          call tty_write;

          // All checks passed
          mov rdi, 3;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + tty_smoke_ok_msg];
          call klog_s1;
          jmp tty_smoke_witness_done;

      tty_smoke_witness_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + tty_smoke_fail_msg];
          call klog_s1;

      tty_smoke_witness_done:

      // ============================================================
      // R17-M1-006 (#615): libc_test witness — E2E user libc-lite
      // ============================================================

      mov rdi, 3;
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + libc_test_start_msg];
      call klog_s1;

      call libc_test_witness;
      cmp rax, 0;
      jne libc_test_witness_fail;

      mov rdi, 3;
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + libc_test_ok_msg];
      call klog_s1;
      jmp libc_test_witness_done;

      libc_test_witness_fail:
      mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + libc_test_fail_msg];
      call klog_s1;

      libc_test_witness_done:

      // ============================================================
      // R15-M5-735 (#735): boot-witness pid_table cleanup
      // ============================================================
      // Reset _pid_table[0..63] before init_bootstrap_witness so init
      // gets pid=1 (and its subsequent fork child gets pid=2 — the
      // published AC line "WAIT: pid=2 status=42").
      //
      // Rationale: ~21 preceding structural witnesses (task_new_witness,
      // pool_witness, sys_exit_witness ×2, sys_wait_witness ×3, sys_execve
      // ×2, orphan_adoption ×3, sys_fork ×2 inc. body, fd_inherit ×2
      // inc. body, fd_cloexec ×1) call task_new but never task_free /
      // pid_free on their allocations. `_pid_table` accumulates those
      // stale slab pointers, and pid_alloc's dense-low-first scan then
      // hands init pid=22, and init's fork child pid=23. Wire pre-fix:
      // "WAIT: pid=23 status=42". See
      // design/kernel/r15-m5-735-boot-witness-pid-leak.md for the full
      // enumeration + safety analysis.
      //
      // Safety: no witness-allocated task_struct is live-referenced past
      // this point — witness TCBs are unenqueued (or dequeued explicitly),
      // never assigned to _current_tcb, and never published globally.
      // The subsequent runq_init at :6419 tears down any stale runqueue
      // links from witness fork_body enqueues (fd_inherit / fd_cloexec).
      // The _task_pool slabs themselves are left in place (rep-stosq at
      // the head of task_new zeros the slab on next allocation).
      //
      // Register discipline: r12 is callee-save under SysV; pid_free
      // preserves callee-save regs (see task_pool.pdx §pid_free
      // "callee-save clean"). No other regs touched.
      xor r12, r12;                              // r12 = pid counter (0..63)
      pid_table_reset_loop:
          mov rdi, r12;
          call pid_free;                         // _pid_table[r12] = 0
          add r12, 1;
          cmp r12, 64;                           // MAX_PIDS (array size)
          jb  pid_table_reset_loop;

      // ============================================================
      // R17-M2-005 (#620): init_bootstrap — structural witness.
      //
      // Tier 1 scope: task_new(NULL) → elf_lite_load(init.elf) →
      // capture e_entry → emit R17 INIT LOAD OK.
      //
      // Tier 2 (blocked on #665, #668, #662): enter_userland_initial
      // with (entry_rip=e_entry, initial_rsp=user_stack_top, cr3=user_pml4).
      // ============================================================
      init_bootstrap_witness:
          // Step 1: allocate init task_struct (fresh user aspace inside).
          xor rdi, rdi;                     // parent = NULL
          call task_new;
          cmp rax, 0;
          je  init_bootstrap_fail;
          mov r12, rax;                     // r12 = init task slab

          // Step 2: load init.elf into init's aspace.
          mov rdi, [r12 + 16];              // rdi = init->user_pml4_pa (VA-form, per #652)
          lea rsi, [rip + _init_bin_start];
          lea rax, [rip + _init_bin_end];
          sub rax, rsi;
          mov rdx, rax;                     // rdx = image_len
          call elf_lite_load;               // rax = ELF_OK (0) or error code
          cmp rax, 0;
          jne init_bootstrap_fail;

          // Step 3: extract e_entry (u64 @ ELF header offset 24) and stash
          // it in the task slab at a well-known offset for Tier 2 pickup.
          // For Tier 1 we only *witness* that the read succeeds.
          lea rax, [rip + _init_bin_start];
          mov rax, [rax + 24];              // ELF64 e_entry
          cmp rax, 0;
          je  init_bootstrap_fail;          // guard: entry must be non-zero
          mov [r12 + 1712], rax;            // stash for Tier 2 @ offset 1712

          // Step 4: publish init's slab pointer to _init_task for Tier 2.
          lea rcx, [rip + _init_task];
          mov [rcx], r12;

          mov rdi, 3;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + init_load_ok_msg];
          call klog_s1;
          jmp init_bootstrap_done;

      init_bootstrap_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + init_load_fail_msg];
          call klog_s1;

      init_bootstrap_done:

      // R18-M2-002 (#766): IA32_GS_BASE + IA32_KERNEL_GS_BASE point at
      // the BSP's Percpu control block (_percpu_cbs[0]) via
      // gs_base_init_bsp. Retires the R14b-m5-002 (#507) wrmsr against
      // _cpu_locals (the pre-#765 storage) — the R18 CB layout is the
      // one every subsequent [gs:off] access in the tree targets.
      //
      // Placement: BEFORE syscall_msr_init would leave IA32_KERNEL_GS_BASE
      // = &_cpu0_kernel_gs (the R13-m5-001 placeholder syscall_msr_init
      // writes at core/syscall/msr.pdx L58-63); calling gs_base_init_bsp
      // AFTER syscall_msr_init lets the #766 write win, so on the first
      // user→kernel swapgs the value moved into GS_BASE is the per-CPU
      // CB, not the placeholder.  process_init has no [gs:off] read so
      // the temporary window between kernel_main entry and the wrmsr
      // below is inert.
      call process_init;
      call syscall_msr_init;
      call gs_base_init_bsp;
      call apic_enable;
      call apic_svr_enable;
      // #646: TPR = 0 (accept all priority classes). Defensive against
      // QEMU-TCG shipping non-zero TPR states across warm reloads; also
      // a hard precondition for the self-IPI runtime witness below.
      // Architecturally a no-op if TPR is already 0.
      call apic_tpr_init;
      call pic_mask_all;

      // ============================================================
      // R15-M7-002 (#563): runqueue initialization
      // ============================================================
      call runq_init;

      // ============================================================
      // R15-M7-001 (#562): idle-task witness — 4 sub-tests, 1 marker
      // ============================================================
      idle_witness:
          // ---------- Sub-test 1: _idle_tcb is published + non-zero ----------
          call idle_init;                          // idempotent — safe to re-call
          mov rax, [rip + _idle_tcb];
          cmp rax, 0;
          je  idle_witness_fail;
          mov r12, rax;                            // r12 = &_idle_task_slot

          // Assert: _idle_tcb == &_idle_task_slot (identity)
          lea rax, [rip + _idle_task_slot];
          cmp rax, r12;
          jne idle_witness_fail;

          // ---------- Sub-test 2: state == STATE_RUNNABLE ----------
          mov eax, [r12 + 8];                      // state (u32) @ +8
          cmp rax, 1;                              // STATE_RUNNABLE
          jne idle_witness_fail;

          // ---------- Sub-test 3: regs_save.rip == &idle_code ----------
          mov rax, [r12 + 40];                     // regs_save.rip @ +40
          lea rcx, [rip + idle_code];
          cmp rax, rcx;
          jne idle_witness_fail;

          // Assert: regs_save.rsp is inside _idle_kernel_stack
          mov rax, [r12 + 32];                     // regs_save.rsp @ +32
          lea rcx, [rip + _idle_kernel_stack];
          cmp rax, rcx;
          jb  idle_witness_fail;                   // rsp < stack base → bad
          add rcx, 4096;
          cmp rax, rcx;
          ja  idle_witness_fail;                   // rsp > stack top → bad

          // ---------- Sub-test 4: pick_next returns idle when nothing RUNNABLE ----------
          // Precondition: no earlier witness left a task in RUNNABLE state.
          //   task_new witnesses all leave state=STATE_NEW (0);
          //   sys_exit witnesses leave state=STATE_ZOMBIE (3);
          //   sys_wait sub-test B leaves parent_b in STATE_WAITING (2);
          //   sys_wait sub-test A reaped its child (slot cleared).
          // No RUNNABLE tasks exist → pick_next must return _idle_tcb.
          call sched_pick_next_r15;
          cmp rax, r12;                            // must == &_idle_task_slot
          jne idle_witness_fail;

          // ---------- All checks green ----------
          mov rdi, 3;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + idle_witness_ok_msg];
          call klog_s1;
          jmp idle_witness_exit;

      idle_witness_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + idle_witness_fail_msg];
          call klog_s1;

      idle_witness_exit:

      // ============================================================
      // R15-M7-002 (#563): runqueue witness — 3 sub-tests, 1 marker
      // ============================================================
      runq_witness:
          // Precondition: runq_init has been called (see kernel_main
          // insertion §4). _runq_head_slot.next == _runq_head_slot.prev
          // == &_runq_head_slot (empty circular list).

          // ---------- Sub-test A: empty runqueue → sched_pick_next_r15 returns _idle_tcb ----------
          call sched_pick_next_r15;
          mov r12, [rip + _idle_tcb];
          cmp rax, r12;
          jne runq_witness_fail;

          // ---------- Sub-test B: enqueue 5 tasks; 5 picks round-robin ----------
          // Use 5 dedicated bss stubs (see storage §8.1). Enqueue in
          // order 1..5; pick_next must return them in the same order.
          lea rdi, [rip + _runq_witness_task_1];
          call runq_enqueue;
          lea rdi, [rip + _runq_witness_task_2];
          call runq_enqueue;
          lea rdi, [rip + _runq_witness_task_3];
          call runq_enqueue;
          lea rdi, [rip + _runq_witness_task_4];
          call runq_enqueue;
          lea rdi, [rip + _runq_witness_task_5];
          call runq_enqueue;

          // Pick #1 must return _runq_witness_task_1
          call sched_pick_next_r15;
          lea rcx, [rip + _runq_witness_task_1];
          cmp rax, rcx;
          jne runq_witness_fail;

          // Pick #2 must return _runq_witness_task_2
          call sched_pick_next_r15;
          lea rcx, [rip + _runq_witness_task_2];
          cmp rax, rcx;
          jne runq_witness_fail;

          // Pick #3 must return _runq_witness_task_3
          call sched_pick_next_r15;
          lea rcx, [rip + _runq_witness_task_3];
          cmp rax, rcx;
          jne runq_witness_fail;

          // Pick #4 must return _runq_witness_task_4
          call sched_pick_next_r15;
          lea rcx, [rip + _runq_witness_task_4];
          cmp rax, rcx;
          jne runq_witness_fail;

          // Pick #5 must return _runq_witness_task_5
          call sched_pick_next_r15;
          lea rcx, [rip + _runq_witness_task_5];
          cmp rax, rcx;
          jne runq_witness_fail;

          // After 5 picks, the list has rotated a full cycle — order
          // is (task_1, task_2, task_3, task_4, task_5) again from head.

          // ---------- Sub-test C: dequeue task_3, 4 picks skip it ----------
          lea rdi, [rip + _runq_witness_task_3];
          call runq_dequeue;

          // Assert: task_3's runq_next and runq_prev are NULL
          lea rcx, [rip + _runq_witness_task_3];
          mov rax, [rcx + 432];
          cmp rax, 0;
          jne runq_witness_fail;
          mov rax, [rcx + 440];
          cmp rax, 0;
          jne runq_witness_fail;

          // Pick #6 must return task_1 (task_3 skipped)
          call sched_pick_next_r15;
          lea rcx, [rip + _runq_witness_task_1];
          cmp rax, rcx;
          jne runq_witness_fail;

          // Pick #7 must return task_2
          call sched_pick_next_r15;
          lea rcx, [rip + _runq_witness_task_2];
          cmp rax, rcx;
          jne runq_witness_fail;

          // Pick #8 must return task_4 (task_3 not in list)
          call sched_pick_next_r15;
          lea rcx, [rip + _runq_witness_task_4];
          cmp rax, rcx;
          jne runq_witness_fail;

          // Pick #9 must return task_5
          call sched_pick_next_r15;
          lea rcx, [rip + _runq_witness_task_5];
          cmp rax, rcx;
          jne runq_witness_fail;

          // ---------- Drain: dequeue remaining 4, verify empty ----------
          lea rdi, [rip + _runq_witness_task_1];
          call runq_dequeue;
          lea rdi, [rip + _runq_witness_task_2];
          call runq_dequeue;
          lea rdi, [rip + _runq_witness_task_4];
          call runq_dequeue;
          lea rdi, [rip + _runq_witness_task_5];
          call runq_dequeue;

          // Assert empty (rewired for #773): CB.runqueue_head (@ +32) == 0.
          // Post-#773 the runqueue's empty invariant is head == tail == 0
          // in this CPU's Percpu CB (was head.next == &head under the
          // pre-#773 circular sentinel).
          mov rcx, 0xC0000101;
          rdmsr;
          shl rdx, 32;
          or  rax, rdx;
          mov rcx, [rax + 32];
          cmp rcx, 0;
          jne runq_witness_fail;

          // Post-drain: pick returns idle again
          call sched_pick_next_r15;
          mov r12, [rip + _idle_tcb];
          cmp rax, r12;
          jne runq_witness_fail;

          // ---------- All checks green ----------
          mov rdi, 3;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + runq_witness_ok_msg];
          call klog_s1;
          jmp runq_witness_exit;

      runq_witness_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + runq_witness_fail_msg];
          call klog_s1;

      runq_witness_exit:

      // ============================================================
      // R15-M7-003 (#564): sched_switch witness — 2 sub-tests, 1 marker
      // ============================================================
      sched_switch_witness:

          // ---------- Sub-test 1: static — prep TCBs, verify structural invariants ----------

          // Prep boot TCB: only regs_save.rip needs to be plausible; the
          // rest is populated by sched_switch_r15's save side on the
          // outbound leg. Set rip to continuation as a defensive default.
          lea rax, [rip + _sched_witness_boot_tcb];
          lea rcx, [rip + sched_switch_r15_continuation];
          mov [rax + 40], rcx;                    // boot.regs_save.rip = continuation

          // Prep task A: stack, rsp, rip=continuation, rflags=0x202.
          //   stack_top = &stack + 4096; stack[top-8] = &task_a_entry (fake RA)
          lea rax, [rip + _sched_witness_task_a_stack];
          add rax, 4096;                          // stack_top (past the last usable byte)
          sub rax, 8;                             // rsp target = stack_top - 8
          lea rcx, [rip + _sched_witness_task_a_entry];
          mov [rax], rcx;                         // *rsp = entry_point (trampoline ret pops this)

          lea rdi, [rip + _sched_witness_task_a_tcb];
          mov [rdi + 32], rax;                    // task_a.regs_save.rsp = rsp
          lea rcx, [rip + sched_switch_r15_continuation];
          mov [rdi + 40], rcx;                    // task_a.regs_save.rip = continuation
          mov rcx, 0x202;
          mov [rdi + 48], rcx;                    // task_a.regs_save.rflags = IF=1

          // Prep task B: same shape.
          lea rax, [rip + _sched_witness_task_b_stack];
          add rax, 4096;
          sub rax, 8;
          lea rcx, [rip + _sched_witness_task_b_entry];
          mov [rax], rcx;

          lea rdi, [rip + _sched_witness_task_b_tcb];
          mov [rdi + 32], rax;                    // task_b.regs_save.rsp = rsp
          lea rcx, [rip + sched_switch_r15_continuation];
          mov [rdi + 40], rcx;                    // task_b.regs_save.rip = continuation
          mov rcx, 0x202;
          mov [rdi + 48], rcx;                    // task_b.regs_save.rflags

          // Point _current_tcb at the boot fake TCB — this is what
          // sched_switch_r15 will save into on the outbound leg.
          lea rax, [rip + _current_tcb];
          lea rcx, [rip + _sched_witness_boot_tcb];
          mov [rax], rcx;

          // Static invariants: visit counters start at 0.
          xor rcx, rcx;
          lea rax, [rip + _sched_witness_a_visits];
          mov [rax], rcx;
          lea rax, [rip + _sched_witness_b_visits];
          mov [rax], rcx;

          // ---------- Sub-test 2: dynamic — 3-hop round-trip ----------

          // Load a witness value into r14 (callee-save; must survive the
          // round-trip through 3 switches: boot→A→B→A→boot).
          mov r14, 0xCAFEBABEDEADBEEF;

          // Outbound: boot → task A. sched_switch_r15 saves boot's state
          // (including our r14) into _sched_witness_boot_tcb, then jumps
          // to task_a's continuation, which rets to task_a_entry.
          lea rdi, [rip + _sched_witness_task_a_tcb];
          call sched_switch_r15;

          // Resumed. Control returns here when task A's exit-path
          // sched_switch_r15(boot_tcb) fires. Task A ran 2 times; task B
          // ran 1 time. Verify:
          //   (a) r14 is intact — callee-save preserved through 3 switches.
          //   (b) _sched_witness_a_visits == 2.
          //   (c) _sched_witness_b_visits == 1.

          mov rax, 0xCAFEBABEDEADBEEF;
          cmp r14, rax;
          jne sched_switch_witness_fail;

          lea rax, [rip + _sched_witness_a_visits];
          mov ecx, [rax];
          cmp ecx, 2;
          jne sched_switch_witness_fail;

          lea rax, [rip + _sched_witness_b_visits];
          mov ecx, [rax];
          cmp ecx, 1;
          jne sched_switch_witness_fail;

          // ---------- All checks green ----------
          mov rdi, 3;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + sched_switch_witness_ok_msg];
          call klog_s1;
          jmp sched_switch_witness_exit;

      sched_switch_witness_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + sched_switch_witness_fail_msg];
          call klog_s1;

      sched_switch_witness_exit:

      // ============================================================
      // R15-M7-006 (#567): sched_block / sched_wake witness — 3 sub-tests, 1 marker
      // ============================================================
      block_wake_witness:

          // ---------- Precondition: witness TCB fully zeroed ----------
          // (bss default is zero, but we defensively re-zero so re-runs
          // of the boot flow — e.g. via a warm reset — start clean.)
          lea rax, [rip + _block_witness_task_x];
          xor rcx, rcx;
          mov [rax + 8],   ecx;      // state (u32)   = 0 (NEW)
          mov [rax + 432], rcx;      // runq_next     = 0
          mov [rax + 440], rcx;      // runq_prev     = 0

          // ---------- Setup: X becomes RUNNABLE and joins runq ----------
          mov ecx, 1;
          mov [rax + 8], ecx;        // state = RUNNABLE
          mov rdi, rax;
          call runq_enqueue;         // runq now contains X only

          // ---------- Sub-test A: simulate sched_block on X ----------
          // (equivalent to sched_block's steps 2 + 3 — see §5.1 of design doc.
          //  We do NOT call sched_block itself — see §8.1 for why.)
          lea rax, [rip + _block_witness_task_x];
          mov ecx, 2;
          mov [rax + 8], ecx;        // state = WAITING
          mov rdi, rax;
          call runq_dequeue;         // runq empty again

          // Assert X.state == WAITING
          lea rax, [rip + _block_witness_task_x];
          mov ecx, [rax + 8];
          cmp ecx, 2;
          jne block_wake_witness_fail;

          // Assert X.runq_next == 0 (off runq)
          mov rcx, [rax + 432];
          cmp rcx, 0;
          jne block_wake_witness_fail;

          // Assert X.runq_prev == 0 (off runq)
          mov rcx, [rax + 440];
          cmp rcx, 0;
          jne block_wake_witness_fail;

          // Assert sched_pick_next_r15 returns _idle_tcb (empty runq fallback)
          call sched_pick_next_r15;
          mov rcx, [rip + _idle_tcb];
          cmp rax, rcx;
          jne block_wake_witness_fail;

          // ---------- Sub-test B: real sched_wake(X) ----------
          lea rdi, [rip + _block_witness_task_x];
          call sched_wake;

          // Assert X.state == RUNNABLE
          lea rax, [rip + _block_witness_task_x];
          mov ecx, [rax + 8];
          cmp ecx, 1;
          jne block_wake_witness_fail;

          // Assert X on runq (rewired for #773): CB.runqueue_head (@ +32)
          // must equal &X.  Post-#773 the sole runnable task's runq_next
          // is 0 (it IS the tail), so the pre-#773 "runq_next != 0" proxy
          // no longer distinguishes on-runq from off-runq for a single-
          // element list.  Cross-check against CB.head instead.
          mov rcx, 0xC0000101;
          rdmsr;
          shl rdx, 32;
          or  rax, rdx;
          mov rcx, [rax + 32];                      // CB.runqueue_head
          lea r8, [rip + _block_witness_task_x];
          cmp rcx, r8;
          jne block_wake_witness_fail;

          // ---------- Sub-test C: pick_next returns X ----------
          call sched_pick_next_r15;
          lea rcx, [rip + _block_witness_task_x];
          cmp rax, rcx;
          jne block_wake_witness_fail;

          // ---------- Sub-test D: double-wake early-exit (#663 guard) ----------
          // X is still RUNNABLE + on runq from Sub-test C. Snapshot runq_next,
          // call sched_wake again, confirm state + link untouched.
          lea rax, [rip + _block_witness_task_x];
          mov r8, [rax + 432];           // r8 = baseline X.runq_next

          lea rdi, [rip + _block_witness_task_x];
          call sched_wake;               // guard hits — early return

          // Assert X.state still RUNNABLE
          lea rax, [rip + _block_witness_task_x];
          mov ecx, [rax + 8];
          cmp ecx, 1;
          jne block_wake_witness_fail;

          // Assert X.runq_next unchanged (no re-enqueue — no figure-8)
          mov rcx, [rax + 432];
          cmp rcx, r8;
          jne block_wake_witness_fail;

          // ---------- Drain: dequeue X so runq is empty for the next witness ----------
          lea rdi, [rip + _block_witness_task_x];
          call runq_dequeue;

          // Assert empty (rewired for #773): CB.runqueue_head (@ +32) == 0.
          // Post-#773 the runqueue's empty invariant is head == tail == 0
          // in this CPU's Percpu CB (was head.next == &head under the
          // pre-#773 circular sentinel).
          mov rcx, 0xC0000101;
          rdmsr;
          shl rdx, 32;
          or  rax, rdx;
          mov rcx, [rax + 32];
          cmp rcx, 0;
          jne block_wake_witness_fail;

          // ---------- All checks green ----------
          mov rdi, 3;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + block_wake_witness_ok_msg];
          call klog_s1;
          jmp block_wake_witness_exit;

      block_wake_witness_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + block_wake_witness_fail_msg];
          call klog_s1;

      block_wake_witness_exit:

      // ============================================================
      // R15-M7-566 (#566) + R15-M7-745 (#745): Timer-preempt witness —
      // two ring-0 tasks whose interleaving on the wire proves that
      // the LAPIC timer really does preempt a running task and rotate
      // the runqueue via sched_pick_next_r15 + sched_switch_r15.
      // ============================================================
      //
      // #745 completes the AC of #566 ("3 tasks; output alternates
      // roughly evenly"): at #566 landing, the LAPIC timer had not
      // been armed by this program point (lapic_timer_init lived
      // below at L7565), so the sti/hlt path in the witness bodies
      // was dead code and only the boot → task_a → boot cooperative
      // path was exercised — with `cmp rcx, 1` hardcoded, task_a
      // exited on its first iteration before ever reaching sti/hlt.
      //
      // #745 fix: (a) arm LAPIC timer here BEFORE sti+switch (Δ from
      // #566: two `call lapic_timer_init*` invocations moved into
      // the witness prep — see block below); (b) witness bodies load
      // target from PREEMPT_WITNESS_TARGET (=3) instead of hardcoded
      // 1, and reset OWN sched_budget=1 immediately before sti+hlt
      // to override handle_timer's default reset to 1M (see tasks.pdx
      // §preempt_witness comment and design §5); (c) verify BOTH
      // task_a and task_b visits reached ≥3 and ≥2 respectively —
      // task_b's count proves preempt fired at least once (task_a
      // could not increment task_b's counter cooperatively).
      //
      // Deterministic wire interleaving with target=3:
      //   PA TICK (a=1) → PB TICK (b=1) → PA TICK (a=2) →
      //   PB TICK (b=2) → PA TICK (a=3, exit) → R15 PREEMPT OK
      // Fingerprint checks (PA TICK, PB TICK, PA TICK, R15 PREEMPT
      // OK) — the smallest ordered subset that proves round-trip
      // preempt (task_a ran, switched to task_b, task_b ran,
      // switched back to task_a).
      //
      // Why ring-0: preemption from ring-3 needs per-task TSS.RSP0
      // (delivered by #744, 3b51985).  Ring-0 preemption pushes the
      // iretq frame on the CURRENT kernel stack (no TSS.RSP0 lookup),
      // so each witness task's ISR context lands on its own 4 KiB
      // kstack and no cross-task corruption is possible.  This keeps
      // the witness self-contained: it exercises pick_next + switch's
      // ring-0 → ring-0 preempt path independently of ring-3 machinery.
      //
      // Ordering rationale for the moved lapic_timer_init: after the
      // witness completes the LVT is RE-MASKED at preempt_witness_exit
      // (3-instruction MMIO write, LVT_TIMER = 0x30020) so the
      // downstream IPI / self-IPI / uart_rx_wire witnesses run
      // without ~100 kHz timer ISR overhead — leaving the LVT armed
      // through uart_rx_wire's ~2 s poll starved the r17_init AC
      // enough to miss the 8 s smoke timeout.  The pre-existing
      // `call lapic_timer_init` at ~L7633 (kept intact) rewrites
      // LVT_TIMER = 0x20020 (mask=0) → un-masks the timer before
      // init boots.  See design/kernel/r15-m7-745-preempt-witness-
      // runtime.md §4 for the arm/mask/re-arm sequence and §6 for
      // AC-safety of the intra-witness LVT arm.
      preempt_witness:

          // Prep witness TCBs — same layout as sched_switch_witness at
          // L6759+ but for the two dedicated preempt witness slabs.
          // Both TCBs need: regs_save.rsp pointing at a stack slot
          // pre-populated with the entry point, regs_save.rip =
          // continuation, regs_save.rflags = 0x202 (IF=1 — kernel
          // preemption requires interrupts enabled on resume).

          // Task A prep
          lea rax, [rip + _preempt_witness_task_a_stack];
          add rax, 4096;                          // stack_top
          sub rax, 8;                             // rsp = top - 8
          lea rcx, [rip + _preempt_witness_task_a_entry];
          mov [rax], rcx;                         // *rsp = entry_point

          lea rdi, [rip + _preempt_witness_task_a_tcb];
          mov [rdi + 32], rax;                    // task_a.regs_save.rsp
          lea rcx, [rip + sched_switch_r15_continuation];
          mov [rdi + 40], rcx;                    // task_a.regs_save.rip
          mov rcx, 0x202;
          mov [rdi + 48], rcx;                    // task_a.regs_save.rflags (IF=1)

          // Task A sched_budget = SCHED_BUDGET_DEFAULT (1M). #745: the
          // body resets its own budget to 1 immediately BEFORE sti+hlt
          // on every iteration (task_pool.pdx L91 defines the constant;
          // tasks.pdx §4 comments explain the after-klog placement).
          // Starting at 1M ensures klog_s1 completes on the very first
          // iteration without preempt firing during klog's popfq→gate-
          // clear window (which would silently drop the incoming task's
          // klog output).  See design §5.
          mov rcx, 1000000;                       // SCHED_BUDGET_DEFAULT
          mov_d [rdi + 112], rcx;                 // task_a.sched_budget

          // Task A state = STATE_RUNNABLE (u32 = 1) — required by
          // runq_enqueue and by sched_pick_next_r15's iteration rules.
          mov ecx, 1;
          mov [rdi + 8], ecx;                     // task_a.state

          // Task B prep (symmetric to task A)
          lea rax, [rip + _preempt_witness_task_b_stack];
          add rax, 4096;
          sub rax, 8;
          lea rcx, [rip + _preempt_witness_task_b_entry];
          mov [rax], rcx;

          lea rdi, [rip + _preempt_witness_task_b_tcb];
          mov [rdi + 32], rax;
          lea rcx, [rip + sched_switch_r15_continuation];
          mov [rdi + 40], rcx;
          mov rcx, 0x202;
          mov [rdi + 48], rcx;

          mov rcx, 1000000;                       // SCHED_BUDGET_DEFAULT
          mov_d [rdi + 112], rcx;                 // task_b.sched_budget

          mov ecx, 1;
          mov [rdi + 8], ecx;                     // task_b.state

          // Zero visit counters (defensive against warm reset)
          xor rcx, rcx;
          lea rax, [rip + _preempt_witness_a_visits];
          mov [rax], rcx;
          lea rax, [rip + _preempt_witness_b_visits];
          mov [rax], rcx;

          // Point _current_tcb at boot fake TCB (already the case from
          // sched_switch_witness above, but defensive re-publish).
          lea rax, [rip + _current_tcb];
          lea rcx, [rip + _sched_witness_boot_tcb];
          mov [rax], rcx;

          // Enqueue both witness tasks on the runqueue so that
          // sched_pick_next_r15 (called from trampoline_vec32 preempt
          // tail) can rotate between them.  #745 ordering: enqueue
          // task_b FIRST, then task_a — this places task_b at
          // _runq_head_slot.next.  sched_pick_next_r15 returns
          // head.next AND rotates it to the tail, so on the FIRST
          // timer preempt from task_a (=_current_tcb after our
          // sched_switch_r15 below) pick_next returns task_b (≠
          // current) and the trampoline's `next == current` guard
          // does NOT trip → real switch fires.  If enqueued in the
          // opposite order (task_a first) the first pick_next would
          // return task_a itself, the guard would skip, and only the
          // side-effect rotation would let the SECOND tick preempt.
          // The wire under the wrong ordering shows PA PA PB PA
          // (task_a effectively runs a double-slice on entry); the
          // corrected wire is PA PB PA PB PA — see design/kernel/
          // r15-m7-745-preempt-witness-runtime.md §5.
          lea rdi, [rip + _preempt_witness_task_b_tcb];
          call runq_enqueue;
          lea rdi, [rip + _preempt_witness_task_a_tcb];
          call runq_enqueue;

          // #745: arm the LAPIC timer NOW so real preempt fires during
          // the witness. Was formerly only at L7565 (after every other
          // witness), which meant handle_timer never ran during the
          // preempt witness — the sti/hlt path was structurally dead.
          // These two calls are idempotent w.r.t. the later ones: they
          // rewrite the LVT_TIMER MMIO (0xFEE00320) with the same value
          // and reload the Initial Count Register (0xFEE00380 = 10000);
          // both LAPIC registers accept repeated writes without side
          // effect beyond re-arming the countdown.  See design §4.
          call lapic_timer_init;
          mov rdi, 10000;                         // periodic count (same as L7568)
          call lapic_timer_init_periodic_count;

          // Enable interrupts — timer will now preempt.  sti + sched_
          // switch_r15 happen in sequence so boot's saved rflags in
          // _sched_witness_boot_tcb captures IF=1; on resume from
          // task A's exit-switch, popfq inside continuation restores
          // IF=1 (matching boot's state at call time).
          sti;

          // Switch to task A.  Task_a runs its loop (PA TICK ×3), is
          // preempted after each iteration to task_b (PB TICK ×2), and
          // finally exits via sched_switch_r15(_sched_witness_boot_tcb)
          // on its 3rd visit — control returns here.
          lea rdi, [rip + _preempt_witness_task_a_tcb];
          call sched_switch_r15;

          // Resumed.  cli first to close the race window against
          // another timer preemption picking task A/B (both still
          // enqueued) before we can dequeue them.
          cli;

          // Dequeue both witness tasks from the runqueue so subsequent
          // code (idle, init, etc.) does not accidentally schedule
          // them.  Also flip their state to something not RUNNABLE so
          // any residual pointer would fail sched_pick_next's
          // enumeration invariants.
          lea rdi, [rip + _preempt_witness_task_a_tcb];
          call runq_dequeue;
          lea rax, [rip + _preempt_witness_task_a_tcb];
          xor rcx, rcx;
          mov [rax + 8], ecx;                     // state = 0 (STATE_NEW)

          lea rdi, [rip + _preempt_witness_task_b_tcb];
          call runq_dequeue;
          lea rax, [rip + _preempt_witness_task_b_tcb];
          xor rcx, rcx;
          mov [rax + 8], ecx;

          // Verify: task_a reached target (visits >= 3) AND task_b ran
          // at least twice (proves preempt fired at least twice — task_a
          // could not increment task_b's counter cooperatively, so any
          // b_visits > 0 mathematically requires the timer preempt path).
          // With target=3 the deterministic count is (a=3, b=2).
          lea rax, [rip + _preempt_witness_a_visits];
          mov rcx, [rax];
          cmp rcx, 3;
          jb preempt_witness_fail;

          lea rax, [rip + _preempt_witness_b_visits];
          mov rcx, [rax];
          cmp rcx, 2;
          jb preempt_witness_fail;

          mov rdi, 3;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + preempt_witness_ok_msg];
          call klog_s1;
          jmp preempt_witness_exit;

      preempt_witness_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + preempt_witness_fail_msg];
          call klog_s1;

      preempt_witness_exit:
          // #745: mask LAPIC timer LVT so subsequent boot witnesses
          // (IPI, self-IPI, uart_rx_wire_witness) run without timer
          // ISR overhead.  Rationale: the timer we armed at the top
          // of preempt_witness fires at ~100 kHz on QEMU TCG
          // (initial_count=10000, bus_clock≈1 GHz) — during the
          // uart_rx_wire_witness's ~2 s poll, that's 200 000 ISR
          // entries, whose cumulative overhead (each ISR: decrement
          // budget + LAPIC MMIO EOI + iretq) starves the poll loop
          // enough to prevent progress to init_boot within the 8 s
          // r17_init smoke timeout.  Restore mask=1 by writing
          // LVT_TIMER = 0x30020 (mask=bit 16 | periodic=bit 17 |
          // vec 32); the later `call lapic_timer_init` at L7633
          // rewrites 0x20020 (mask=0) to unmask before init boot.
          // Idempotent: only affects LVT_TIMER register.
          mov rax, 0xFEE00320;
          mov rcx, 0x30020;                       // mask=1 | periodic | vec 32
          mov_d [rax], rcx;

      // R14b-m5-007 (#512): IPI structural witness.
      // Verifies vec 0xF0/0xF1 trampolines + handlers are linked and reachable.
      // Runtime self-IPI delivery test deferred (needs LAPIC SVR/priority
      // initialization order investigation — filed as followup #646).
      lea rax, [rip + _ipi_trampoline_f0];
      cmp rax, 0;
      je ipi_fail;
      lea rax, [rip + _ipi_trampoline_f1];
      cmp rax, 0;
      je ipi_fail;
      lea rax, [rip + _ipi_f0_count];
      cmp rax, 0;
      je ipi_fail;
      lea rax, [rip + _ipi_f1_count];
      cmp rax, 0;
      je ipi_fail;
      mov rdi, 3;
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + ipi_ok_msg];
      call klog_s1;
      jmp ipi_done;
      ipi_fail:
      mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + ipi_fail_msg];
      call klog_s1;
      ipi_done:

      // R14b-M5-007b (#646): self-IPI runtime delivery witness.
      // Preconditions at this program point:
      //   - LAPIC SVR (0xFEE000F0) has bit 8 set (apic_svr_enable @ L6548).
      //   - LAPIC TPR (0xFEE00080) = 0 (apic_tpr_init @ L6549).
      //   - 8259 PIC IMR masked (pic_mask_all @ L96 in kernel_main_64 prologue).
      //   - IDT vec 240 wired to _isr_stub_240 -> _ipi_trampoline_f0 ->
      //     _ipi_handler_f0 (increments _ipi_f0_count).
      //   - LAPIC timer LVT still MASKED at power-on default (lapic_timer_init
      //     lives at L7500-ish, below this witness). Only vec 240 can fire in
      //     our narrow sti window.
      //   - RFLAGS.IF = 0 (preempt_witness cli'd at L7070 before exiting).
      //
      // Sequence (see design/kernel/r14b-m5-646-self-ipi-runtime-delivery.md §3.3):
      //   1. Zero _ipi_f0_count defensively (defends against a rerun scenario).
      //   2. apic_send_self_ipi(240) — write ICR_LO with SELF shorthand.
      //      IPI queued in LAPIC IRR while IF=0.
      //   3. sti — after the sti-shadow closes on the NEXT instruction, CPU
      //      dispatches the pending IPI: _isr_stub_240 -> _ipi_trampoline_f0
      //      -> apic_eoi -> _ipi_handler_f0 (counter++) -> iretq.
      //   4. Bounded poll of _ipi_f0_count for > 0.
      //   5. cli — close the IF window BEFORE the loader / lapic_timer_init
      //      code below; those want a quiet CPU.
      //   6. Emit "SELF IPI OK\n" or "SELF IPI FAIL\n".
      //
      // Register discipline:
      //   r15 = bounded poll countdown. r15 is callee-save (SysV): the
      //   trampoline saves/restores all 15 GPRs, and uart_puts honours the
      //   SysV callee-save set. A mid-poll dispatch of vec 240 preserves r15.
      //   apic_send_self_ipi clobbers rax/rcx/rdx; that is fine — we reload
      //   from _ipi_f0_count via lea on every poll iteration.
      //
      // Failure mode: if the counter stays 0 for the whole poll budget we
      // emit "SELF IPI FAIL\n" but do NOT halt — the downstream loader /
      // scheduler / init witnesses proceed. This matches the discipline of
      // every other boot witness (KPTI OK / IPI OK / LOADER OK / etc.).
      lea rax, [rip + _ipi_f0_count];
      xor rcx, rcx;
      mov [rax], rcx;                          // reset counter (defensive)

      mov rdi, 240;                            // vec 0xF0
      call apic_send_self_ipi;                 // ICR write; IPI queued in IRR

      sti;                                     // sti-shadow -> CPU dispatch

      mov r15, 1000000;                        // ~ms of TCG spin budget
      self_ipi_poll:
          lea rax, [rip + _ipi_f0_count];
          mov rax, [rax];
          cmp rax, 0;
          jne self_ipi_ok;
          sub r15, 1;
          jnz self_ipi_poll;

      // Timeout — close IF window and emit fail marker (non-fatal).
      cli;
      mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + self_ipi_fail_msg];
      call klog_s1;
      jmp self_ipi_done;

      self_ipi_ok:
          // Delivery observed — close IF window before continuing.
          cli;
          mov rdi, 3;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + self_ipi_ok_msg];
          call klog_s1;

      self_ipi_done:

      // R15-M1-008 (#520): loader structural witness.
      // Verifies aspace_create_user, elf_lite_load, user_stack_alloc symbols
      // resolve and _shell_bin_start/_end bracket the embed. Runtime end-to-end
      // load deferred to #648 (elf_lite_load HIGH_HALF false-positive fix).
      lea rax, [rip + aspace_create_user];
      cmp rax, 0;
      je loader_fail;
      lea rax, [rip + elf_lite_load];
      cmp rax, 0;
      je loader_fail;
      lea rax, [rip + user_stack_alloc];
      cmp rax, 0;
      je loader_fail;
      lea rax, [rip + _shell_bin_start];
      cmp rax, 0;
      je loader_fail;
      lea rax, [rip + _shell_bin_end];
      cmp rax, 0;
      je loader_fail;
      mov rdi, 3;
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + loader_ok_msg];
      call klog_s1;

      // R15-M1-008b (#648): loader RUNTIME witness — actually call elf_lite_load.
      // Precondition: aspace_create_user + phys_alloc + aspace_map work (proven
      // upstream by the ring3 witness at #652); phys_free bitmap release lands
      // (#649). Leaks the user aspace on success — matches every other boot-time
      // structural witness (KPTI, ring3, IPI).

      call aspace_create_user;      // rax = user_pml4_pa (VA form — same as #652)
      mov rdx, 0xFFFFFFFF;
      cmp rax, rdx;
      je  loader_runtime_fail;
      mov rdi, rax;                 // rdi = user_pml4_pa

      lea rsi, [rip + _shell_bin_start];
      lea rax, [rip + _shell_bin_end];
      sub rax, rsi;                 // rax = image_len
      mov rdx, rax;                 // rdx = image_len

      call elf_lite_load;           // (rdi, rsi, rdx) -> rax = ELF_OK | error code
      cmp rax, 0;                   // ELF_OK == 0
      jne loader_runtime_fail;

      mov rdi, 3;
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + elf_load_ok_msg];
      call klog_s1;
      jmp loader_done;

      loader_runtime_fail:
      mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + elf_load_fail_msg];
      call klog_s1;

      jmp loader_done;

      loader_fail:
      mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + loader_fail_msg];
      call klog_s1;
      loader_done:

      // R15-M6-009 (#560): child_hello ELF embed structural witness.
      // Precondition: aspace_create_user + phys_alloc + aspace_map work
      // (same preconditions as the #648 loader-runtime witness above).
      // What we prove:
      //   1. _child_hello_bin_start / _child_hello_bin_end resolve and bracket
      //      a nonzero image (userbin_embed.S actually included the .elf).
      //   2. The kernel's elf_lite_load accepts child_hello.elf's header,
      //      segment layout, and W^X policy (returns ELF_OK == 0). This is
      //      the same predicate the runtime execve path will need to satisfy
      //      once #671 (SC+ execve dispatcher) unblocks.
      // What we do NOT prove here (deferred to the runtime landing):
      //   - user-space fork() from init actually runs (blocked by #678: kernel
      //     currently bootstraps shell as initial ring-3 task, bypassing init).
      //   - sys_execve syscall dispatch reaches sys_execve_body (blocked by
      //     #671: sysno 59 routes to dispatch_enosys; needs vfs_open+read+load
      //     shim to bridge SC+ (path,argv,envp) → sys_execve_body (image_ptr)).
      //   - "CHILD HELLO 42\n" and "WAIT: pid=2 status=42" appear on the wire.
      // Leaks the user aspace on success — matches every other boot-time
      // structural witness (KPTI, ring3, IPI, LOADER, ELF LOAD).
      call aspace_create_user;
      mov rdx, 0xFFFFFFFF;
      cmp rax, rdx;
      je  child_hello_embed_fail_label;
      mov rdi, rax;                 // rdi = user_pml4_pa (VA form)

      lea rsi, [rip + _child_hello_bin_start];
      lea rax, [rip + _child_hello_bin_end];
      sub rax, rsi;                 // rax = image_len
      cmp rax, 0;                   // guard: nonzero embed
      jle child_hello_embed_fail_label;
      mov rdx, rax;                 // rdx = image_len

      call elf_lite_load;           // (user_pml4, image, len) -> ELF_OK | error
      cmp rax, 0;                   // ELF_OK == 0
      jne child_hello_embed_fail_label;

      mov rdi, 3;
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + child_hello_embed_ok_msg];
      call klog_s1;
      jmp child_hello_embed_done;

      child_hello_embed_fail_label:
      mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + child_hello_embed_fail_msg];
      call klog_s1;

      child_hello_embed_done:

      // ============================================================
      // R17-M0-730 D10a (#730): /bin/child_hello tmpfs seed.
      //
      // Creates /bin as a directory child of the tmpfs root, then
      // creates /bin/child_hello as a REG file inside /bin, then
      // writes the embedded child_hello.elf bytes (from
      // _child_hello_bin_start.._child_hello_bin_end, established by
      // tools/userbin_embed.S per R15-M6-009 / #560) into the file
      // using page-sized tmpfs_write chunks (tmpfs_write is single-
      // page constrained per tmpfs/write.pdx §4.5).
      //
      // Enables init's execve("/bin/child_hello") to actually resolve
      // via vfs_open → path_resolve → tmpfs_lookup and load the ELF.
      // Before D10a, /bin/child_hello did not exist and sys_execve_shim
      // returned -ENOENT to init, which fell through to init_error and
      // printed a second "INIT OK" then sys_exit(0) — never the AC line.
      //
      // Vnode-pool wiring pattern — R17-M5-754 (paideia-os #754) fix.
      //
      // ORIGINAL (buggy) pattern per #587's sys_open witness
      // (kernel_main L4237-4245): tmpfs_create returned a fresh tmpfs
      // inode idx; the seed wrote ops_ptr = &_tmpfs_vops and
      // backend_ptr = inode_idx directly into `_vnode_pool[inode_idx]`
      // via `vnode_slot(inode_idx)`. This CONFLATED two disjoint index
      // spaces (tmpfs inode idx from `tmpfs_inode_alloc`'s bitmap over
      // `_tmpfs_inode_pool`, vs vnode-pool idx from `vnode_alloc`'s
      // bitmap over `_vnode_pool`), silently CLOBBERING any vnode-pool
      // slot at the same numeric index. Wave-3 debug of #754 caught
      // `_tty0` (a `vnode_alloc`'d chrdev at vnode-pool idx 6) being
      // overwritten by `bin_sh_seed`'s write at `vnode_slot(sh_inode_idx=6)`,
      // which retargeted every shell `sys_read(fd=0)` through
      // `_tmpfs_read_adapter` on the wrong backend.
      //
      // FIXED pattern (this commit): use the canonical
      // `vnode_cache_or_alloc(parent_vn_idx, backend_inode_idx,
      // &_tmpfs_vops)` helper from `core/fs/vnode_pool.pdx:164` (added
      // by #665 Phase 1 as the sanctioned dedup+alloc helper for
      // exactly this bind-backend-to-vnode operation). Returns a
      // FRESH vnode-pool slot, wired with the correct fields — never
      // aliases an unrelated allocator's slot. Same pattern used by
      // `vfs_open.pdx:204` Step 7 (the reference application).
      //
      // Register plan:
      //   r12 = root_inode_idx (=1) for step 2's tmpfs_create; then
      //         bin_vn_idx (from vnode_cache_or_alloc at step 3) held
      //         across step 4's nested tmpfs_create call so step 5's
      //         vnode_cache_or_alloc has bin_vn_idx as its parent arg;
      //         then image_len (step 6+, matches original)
      //   r13 = bin_inode_idx (steps 2-4 as tmpfs dir_idx for
      //         child_hello); repurposed to `offset` at step 6+
      //   r14 = child_hello_inode_idx (steps 4-end)
      //   r15 = root_vn_idx (from mount_root_vnode at step 1, held
      //         across step 3's vnode_cache_or_alloc as parent arg;
      //         DEAD after step 3); repurposed to _child_hello_bin_start
      //         at step 6+ (matches original, since r15 was unused in
      //         steps 1-5 originally)
      //
      // See design/kernel/r17-m0-730-d10-execve-complete.md §D10a and
      // design/kernel/r17-m0-665-vnode-conflation-fix.md.
      // ============================================================
      bin_child_hello_seed:
          // ---------- Step 1: recover + wire root vnode ----------
          // mount_root_vnode returns the ROOT VNODE idx (a real
          // vnode-pool idx from vnode_alloc during mount, NOT a tmpfs
          // INODE idx). Calling vnode_slot on it is CORRECT usage
          // (this is NOT the flawed pattern fixed at steps 3/5).
          // The subsequent ops_ptr/backend_ptr writes are redundant
          // with mount()'s own Phase 3 wire (#665) via
          // backend_registry, but idempotent (writing the same values)
          // and preserved as belt+suspenders per Phase 3 landing note.
          //
          // r15 = saved root_vn_idx across step 3's
          // vnode_cache_or_alloc call (needed as its parent_idx arg).
          call mount_root_vnode
          cmp rax, 0
          je bin_child_hello_seed_fail
          mov r15, rax                             // r15 = root_vn_idx (saved for step 3)
          mov rdi, rax                             // rdi = root_vnode_idx
          call vnode_slot                          // rax = &vnode[root_vn]
          lea rcx, [rip + _tmpfs_vops]
          mov [rax + 24], rcx                      // ops_ptr = &_tmpfs_vops
          mov rcx, 1                               // TMPFS_INODE_IDX_ROOT
          mov [rax + 32], rcx                      // backend_ptr = root INODE idx

          // r12 tracks root INODE idx (= 1) for the tmpfs_create call below.
          // Kept in a register (not just an immediate) so subsequent steps
          // can address `mov rdi, r12` uniformly with steps 2/4's patterns.
          mov r12, 1                               // r12 = root_inode_idx

          // ---------- Step 2: tmpfs_create(root_inode, "bin", 3, DIR=2) ----------
          mov rdi, r12                             // dir_inode_idx = 1
          lea rsi, [rip + bin_seed_name]           // "bin\0"
          mov rdx, 3                               // name_len
          mov rcx, 2                               // VNODE_TYPE_DIR
          call tmpfs_create                        // rax = bin_inode_idx | 0 | 0xFFFF
          cmp rax, 0
          je bin_child_hello_seed_fail
          mov rcx, 0xFFFF
          cmp rax, rcx
          je bin_child_hello_seed_fail             // TMPFS_INODE_ALLOC_OOM
          mov r13, rax                             // r13 = bin_inode_idx

          // ---------- Step 3: bind /bin backend inode to fresh vnode-pool slot ----------
          // #754 FIX: use vnode_cache_or_alloc — allocates a FRESH
          // vnode-pool slot (via internal vnode_alloc if no dedup
          // match) and populates parent_idx/ops_ptr/backend_ptr in
          // one call. Never aliases the tmpfs inode idx into the
          // vnode-pool address space (which was the pre-#754 bug).
          //
          // r15 = root_vn_idx (parent, from step 1). r13 = bin_inode_idx
          // (backend, from step 2's tmpfs_create). ops_ptr = _tmpfs_vops.
          // Returns bin_vn_idx in rax, or 0xFFFF on vnode-pool OOM.
          //
          // bin_vn_idx is saved to r12 (repurposing r12 from root_inode_idx=1
          // which is dead after step 2's tmpfs_create). r12 must survive
          // step 4's nested tmpfs_create call (SysV callee-save) so step 5's
          // vnode_cache_or_alloc has the correct parent_idx arg.
          mov rdi, r15                             // arg1: parent = root_vn_idx
          mov rsi, r13                             // arg2: backend = bin_inode_idx
          lea rdx, [rip + _tmpfs_vops]             // arg3: ops = &_tmpfs_vops
          call vnode_cache_or_alloc                // rax = bin_vn_idx or 0xFFFF
          mov rcx, 0xFFFF
          cmp rax, rcx
          je bin_child_hello_seed_fail             // VNODE_ALLOC_OOM
          mov r12, rax                             // r12 = bin_vn_idx (parent for step 5)

          // ---------- Step 4: tmpfs_create(bin, "child_hello", 11, REG=1) ----------
          mov rdi, r13                             // dir_idx = bin
          lea rsi, [rip + child_hello_seed_name]   // "child_hello\0"
          mov rdx, 11                              // name_len
          mov rcx, 1                               // VNODE_TYPE_REG
          call tmpfs_create                        // rax = child_hello_inode_idx | 0 | 0xFFFF
          cmp rax, 0
          je bin_child_hello_seed_fail
          mov rcx, 0xFFFF
          cmp rax, rcx
          je bin_child_hello_seed_fail
          mov r14, rax                             // r14 = child_hello_inode_idx

          // ---------- Step 5: bind /bin/child_hello backend inode to fresh vnode-pool slot ----------
          // #754 FIX: symmetric with step 3 — vnode_cache_or_alloc
          // with parent = bin_vn_idx (r12, from step 3), backend =
          // child_hello_inode_idx (r14, from step 4's tmpfs_create),
          // ops = _tmpfs_vops. Return value (fresh child_hello vnode
          // idx) is not stored — no downstream consumer within this
          // seed (tmpfs_write in step 7 addresses via r14 inode idx
          // directly at the tmpfs primitive level, bypassing the
          // vnode-pool layer).
          mov rdi, r12                             // arg1: parent = bin_vn_idx
          mov rsi, r14                             // arg2: backend = child_hello_inode_idx
          lea rdx, [rip + _tmpfs_vops]             // arg3: ops = &_tmpfs_vops
          call vnode_cache_or_alloc                // rax = child_hello_vn_idx or 0xFFFF
          mov rcx, 0xFFFF
          cmp rax, rcx
          je bin_child_hello_seed_fail             // VNODE_ALLOC_OOM

          // ---------- Step 6: compute image base + length ----------
          //
          // r15 = _child_hello_bin_start (kernel VA; the ELF blob lives in
          // .rodata.userbin, mapped in the kernel higher half by the
          // loader). r15 was root_vn_idx (dead after step 3 — its only
          // consumer was step 3's vnode_cache_or_alloc parent arg).
          // image_len = _child_hello_bin_end - _child_hello_bin_start;
          // at R17.M0 build time this is ~4784 bytes (well under the
          // tmpfs 64 KiB per-file cap). r12 was bin_vn_idx (from #754
          // fix, dead after step 5 — its only consumer was step 5's
          // vnode_cache_or_alloc parent arg) — repurposed to image_len.
          // r13 was bin_inode_idx, now dead — repurposed to offset
          // (start = 0).
          lea r15, [rip + _child_hello_bin_start]
          lea rax, [rip + _child_hello_bin_end]
          sub rax, r15                             // rax = image_len
          mov r12, rax                             // r12 = image_len
          xor r13, r13                             // r13 = offset

          // ---------- Step 7: write in single-page (<=4096-byte) chunks ----------
          //
          // tmpfs_write enforces single-page constraint (write.pdx §4.5:
          // start_page == end_page).  Each iteration writes min(4096,
          // image_len - offset) bytes at page-aligned offset, so both
          // start_page and end_page are `offset >> 12` and the constraint
          // holds by construction.
          //
          // Return value handling: tmpfs_write returns bytes_written (=len)
          // on success, or 0xFFFFFFFFFFFFFFFF (VOPS_ERR_SENTINEL / fail)
          // on any of the gates.  On success we add to offset; on failure
          // we abort the seed (init.pdx's execve will then return -ENOENT
          // or similar, and the fingerprint will show the failure marker).
      bin_child_hello_seed_write_loop:
          cmp r13, r12
          jae bin_child_hello_seed_write_done      // offset >= image_len

          // chunk_len = min(4096, image_len - offset), computed in rax
          mov rax, r12
          sub rax, r13                             // rax = remaining bytes
          mov rcx, 4096
          cmp rax, rcx
          jbe bin_child_hello_seed_chunk_ok
          mov rax, rcx                             // clamp to 4096
      bin_child_hello_seed_chunk_ok:

          // tmpfs_write(inode_idx=r14, buf=r15+r13, len=rax, offset=r13)
          mov rdi, r14                             // arg0 = child_hello_inode_idx
          mov rsi, r15
          add rsi, r13                             // arg1 = image_base + offset
          mov rdx, rax                             // arg2 = chunk_len
          mov rcx, r13                             // arg3 = offset
          call tmpfs_write                         // rax = bytes_written or sentinel

          // Sentinel check: 0xFFFFFFFFFFFFFFFF (rcx-loaded because AND/CMP
          // has no imm64 form).
          mov rcx, 0xFFFFFFFFFFFFFFFF
          cmp rax, rcx
          je  bin_child_hello_seed_fail

          // Advance by bytes_written (== chunk_len for a well-formed
          // single-page write; tmpfs_write does not short-write on success).
          add r13, rax                             // offset += bytes_written
          jmp bin_child_hello_seed_write_loop

      bin_child_hello_seed_write_done:
          mov rdi, 3;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + bin_seed_ok_msg];
          call klog_s1;
          jmp bin_child_hello_seed_done

      bin_child_hello_seed_fail:
          mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + bin_seed_fail_msg];
          call klog_s1;

      bin_child_hello_seed_done:

      // ============================================================
      // R17-M5-636 partial (paideia-os #636): /bin/sh tmpfs seed.
      //
      // Mirrors D10a's bin_child_hello_seed pattern but for shell.elf
      // (embedded via tools/userbin_embed.S at _shell_bin_start /
      // _shell_bin_end). D10a already created /bin as a DIR under root
      // and wired its vnode-pool slot; here we tmpfs_lookup(1, "bin")
      // to recover bin's inode idx, create /bin/sh as a REG file inside
      // it, wire the new vnode-pool slot, and write shell.elf bytes in
      // single-page (<=4096-byte) chunks (tmpfs_write single-page
      // constraint per write.pdx §4.5).
      //
      // This partial does NOT wire init to fork+exec /bin/sh — that is
      // deferred to a follow-up sub-issue (see design doc §6 prereq #4)
      // so #723's AC (CHILD HELLO 42 / WAIT: pid=2 status=42 / REAPED)
      // stays byte-identical.
      //
      // Register plan (mirrors D10a with #754 fix additions):
      //   r13 = bin_inode_idx (steps 1-3 as tmpfs dir_idx / backend for
      //         bin_vn_idx dedup); repurposed to `offset` (steps 4-5)
      //   r14 = sh_inode_idx (steps 2-5)
      //   r15 = root_vn_idx (step 1b, dead after step 1c); then
      //         _shell_bin_start (image base, steps 4-5)
      //   r12 = bin_vn_idx (step 1c-3, dead after step 3 — its only
      //         consumer was step 3's vnode_cache_or_alloc parent arg);
      //         then image_len (steps 4-5)
      //
      // See design/kernel/r17-m5-636-shell-binary-seed.md and
      // design/kernel/r17-m0-665-vnode-conflation-fix.md.
      // ============================================================
      bin_sh_seed:
          // ---------- Step 1: recover /bin's inode idx via tmpfs_lookup ----------
          // Reuses bin_seed_name ("bin\0") already defined by D10a in
          // tools/boot_stub.S. Returns 0 on miss (which would mean D10a
          // failed silently — if seed_ok fired above, /bin must exist).
          mov  rdi, 1                              // root_inode_idx
          lea  rsi, [rip + bin_seed_name]          // "bin\0"
          call tmpfs_lookup                        // rax = bin_idx or 0 on miss
          cmp  rax, 0
          je   bin_sh_seed_fail
          mov  r13, rax                            // r13 = bin_inode_idx

          // ---------- Step 1b: recover root vnode-pool idx ----------
          // #754 FIX: needed as parent arg for step 1c's dedup call.
          // mount_root_vnode returns a real vnode-pool idx (from
          // mount()'s vnode_alloc, wired via #665 Phase 3
          // backend_registry — includes ops_ptr=&_tmpfs_vops and
          // backend_ptr=1).
          call mount_root_vnode                    // rax = root_vn_idx
          cmp  rax, 0
          je   bin_sh_seed_fail
          mov  r15, rax                            // r15 = root_vn_idx (temp, dead after step 1c)

          // ---------- Step 1c: recover /bin vnode-pool idx via dedup ----------
          // #754 FIX: bin_sh_seed does not inherit register state
          // from bin_child_hello_seed (D10a), so we must re-derive
          // /bin's vnode-pool idx here. vnode_cache_or_alloc dedupes
          // on (parent_idx, backend_idx, ops_ptr) — with identical
          // args to D10a step 3, it returns the SAME slot D10a
          // allocated (idempotent). No new slot allocated if D10a
          // ran successfully above; new slot allocated only if D10a
          // failed to seed /bin (in which case tmpfs_lookup at
          // step 1 would have already returned 0, and we'd have
          // bailed at bin_sh_seed_fail).
          mov  rdi, r15                            // arg1: parent = root_vn_idx
          mov  rsi, r13                            // arg2: backend = bin_inode_idx
          lea  rdx, [rip + _tmpfs_vops]            // arg3: ops = &_tmpfs_vops
          call vnode_cache_or_alloc                // rax = bin_vn_idx or 0xFFFF
          mov  rcx, 0xFFFF
          cmp  rax, rcx
          je   bin_sh_seed_fail                    // VNODE_ALLOC_OOM
          mov  r12, rax                            // r12 = bin_vn_idx (parent for step 3)

          // ---------- Step 2: tmpfs_create(bin, "sh", 2, REG=1) ----------
          mov  rdi, r13                            // dir_inode_idx = bin
          lea  rsi, [rip + sh_seed_name]           // "sh\0"
          mov  rdx, 2                              // name_len
          mov  rcx, 1                              // VNODE_TYPE_REG
          call tmpfs_create                        // rax = sh_inode_idx | 0 | 0xFFFF
          cmp  rax, 0
          je   bin_sh_seed_fail
          mov  rcx, 0xFFFF
          cmp  rax, rcx
          je   bin_sh_seed_fail                    // TMPFS_INODE_ALLOC_OOM
          mov  r14, rax                            // r14 = sh_inode_idx

          // ---------- Step 3: bind /bin/sh backend inode to fresh vnode-pool slot ----------
          // #754 FIX: replaces the pre-#754 pattern
          //   `mov rdi, r14; call vnode_slot; store ops_ptr; store
          //    backend_ptr = r14`
          // which conflated tmpfs inode idx (r14) with vnode-pool idx,
          // CLOBBERING whatever legitimate vnode-pool slot lived at
          // that numeric index — most visibly _tty0 (allocated at
          // vnode-pool idx 6 by tty_init) when sh_inode_idx also
          // happened to be 6. See wave-3 diagnosis of #754 for the
          // byte-identity proof.
          //
          // vnode_cache_or_alloc allocates a FRESH vnode-pool slot
          // (or dedups) — never aliases the tmpfs inode number as a
          // vnode-pool index.
          mov  rdi, r12                            // arg1: parent = bin_vn_idx
          mov  rsi, r14                            // arg2: backend = sh_inode_idx
          lea  rdx, [rip + _tmpfs_vops]            // arg3: ops = &_tmpfs_vops
          call vnode_cache_or_alloc                // rax = sh_vn_idx or 0xFFFF
          mov  rcx, 0xFFFF
          cmp  rax, rcx
          je   bin_sh_seed_fail                    // VNODE_ALLOC_OOM

          // ---------- Step 4: compute image base + length ----------
          // r15 = _shell_bin_start (kernel VA; .rodata.userbin — mapped
          // in the higher half by the loader). r15 was root_vn_idx
          // (dead after step 1c). image_len =
          // _shell_bin_end - _shell_bin_start; ~9856 bytes at R17.M5,
          // well under the tmpfs 64 KiB per-file cap. r12 was
          // bin_vn_idx (dead after step 3 — its only consumer was
          // step 3's vnode_cache_or_alloc parent arg); repurposed to
          // image_len. r13 was bin_inode_idx, now dead — repurposed
          // to offset (start = 0).
          lea  r15, [rip + _shell_bin_start]
          lea  rax, [rip + _shell_bin_end]
          sub  rax, r15                            // rax = image_len
          mov  r12, rax                            // r12 = image_len
          xor  r13, r13                            // r13 = offset

          // ---------- Step 5: write in single-page (<=4096-byte) chunks ----------
          // tmpfs_write enforces single-page constraint (write.pdx §4.5:
          // start_page == end_page). Each iteration writes
          // min(4096, image_len - offset) bytes at page-aligned offset,
          // so both start_page and end_page are `offset >> 12` and the
          // constraint holds by construction (offset starts at 0 and is
          // incremented by bytes_written each iteration).
      bin_sh_seed_write_loop:
          cmp  r13, r12
          jae  bin_sh_seed_write_done              // offset >= image_len

          // chunk_len = min(4096, image_len - offset)
          mov  rax, r12
          sub  rax, r13                            // rax = remaining bytes
          mov  rcx, 4096
          cmp  rax, rcx
          jbe  bin_sh_seed_chunk_ok
          mov  rax, rcx                            // clamp to 4096
      bin_sh_seed_chunk_ok:

          // tmpfs_write(inode_idx=r14, buf=r15+r13, len=rax, offset=r13)
          mov  rdi, r14                            // arg0 = sh_inode_idx
          mov  rsi, r15
          add  rsi, r13                            // arg1 = image_base + offset
          mov  rdx, rax                            // arg2 = chunk_len
          mov  rcx, r13                            // arg3 = offset
          call tmpfs_write                         // rax = bytes_written or sentinel

          // Sentinel check: 0xFFFFFFFFFFFFFFFF (rcx-loaded because AND/CMP
          // has no imm64 form). Matches D10a's error handling.
          mov  rcx, 0xFFFFFFFFFFFFFFFF
          cmp  rax, rcx
          je   bin_sh_seed_fail

          // Advance by bytes_written (= chunk_len for a well-formed
          // single-page write; tmpfs_write does not short-write on
          // success).
          add  r13, rax                            // offset += bytes_written
          jmp  bin_sh_seed_write_loop

      bin_sh_seed_write_done:
          mov  rdi, 3;
          lea  rsi, [rip + SUBSYS_BOOT];
          lea  rdx, [rip + bin_sh_seed_ok_msg];
          call klog_s1;
          jmp  bin_sh_seed_done

      bin_sh_seed_fail:
          mov  rdi, 1;                             // LEVEL_ERROR
          lea  rsi, [rip + SUBSYS_BOOT];
          lea  rdx, [rip + bin_sh_seed_fail_msg];
          call klog_s1;

      bin_sh_seed_done:

      // ============================================================
      // R17.M5 #638 (paideia-os): /bin/true tmpfs seed.
      //
      // Mirrors bin_sh_seed structurally (which mirrors D10a's
      // bin_child_hello_seed) but for true.elf (embedded via
      // tools/userbin_embed.S at _true_bin_start / _true_bin_end).
      // /bin already exists as a DIR under root (created by D10a
      // above, whose success is a hard prerequisite of reaching this
      // seed — bin_child_hello_seed_fail short-circuits past both
      // bin_sh_seed and bin_true_seed via the failure branch). Here
      // we tmpfs_lookup(root, "bin") to recover /bin's inode idx,
      // create /bin/true as a REG file inside it, wire the new
      // vnode-pool slot via vnode_cache_or_alloc (mandatory per #754
      // fix — never conflate tmpfs inode idx with vnode-pool idx),
      // and write true.elf bytes in single-page (<=4096-byte) chunks
      // (tmpfs_write single-page constraint per write.pdx §4.5).
      //
      // Placement rationale: after bin_sh_seed so the seed order is
      // deterministic (child_hello, sh, true — chronological by
      // introduction). Marker emitted last, so its absence would
      // indicate any of the seven prior seed steps failed silently.
      //
      // Enables the shell's fork+execve("/bin/true") chain in
      // boot_r17_shell_child_process (R17.M5 #638): shell reads
      // "true\n", dispatch misses, exec_child calls resolve_path
      // (prepends "/bin/" — no slash in argv[0]) → sys_execve
      // ("/bin/true", ...). Before this seed, /bin/true did not
      // exist and execve returned -ENOENT; shell would exit(127)
      // and no "TRUE OK" line would land on the wire.
      //
      // Register plan (mirrors bin_sh_seed line-for-line):
      //   r13 = bin_inode_idx (steps 1-3); repurposed to offset (4-5)
      //   r14 = true_inode_idx (steps 2-5)
      //   r15 = root_vn_idx (step 1b, dead after step 1c); then
      //         _true_bin_start (image base, steps 4-5)
      //   r12 = bin_vn_idx (step 1c-3, dead after step 3); then
      //         image_len (steps 4-5)
      //
      // See design/kernel/r17-m0-665-vnode-conflation-fix.md and
      // design/milestones/r14b-tactical-plan.md §Subsystem 20 item 4.
      // ============================================================
      bin_true_seed:
          // ---------- Step 1: recover /bin's inode idx via tmpfs_lookup ----------
          // Reuses bin_seed_name ("bin\0") already defined by D10a in
          // tools/boot_stub.S. Returns 0 on miss (unreachable if D10a
          // and bin_sh_seed above both succeeded — /bin must exist).
          mov  rdi, 1                              // root_inode_idx
          lea  rsi, [rip + bin_seed_name]          // "bin\0"
          call tmpfs_lookup                        // rax = bin_idx or 0
          cmp  rax, 0
          je   bin_true_seed_fail
          mov  r13, rax                            // r13 = bin_inode_idx

          // ---------- Step 1b: recover root vnode-pool idx ----------
          // #754 discipline: needed as parent arg for step 1c's dedup
          // call. mount_root_vnode returns a real vnode-pool idx.
          call mount_root_vnode                    // rax = root_vn_idx
          cmp  rax, 0
          je   bin_true_seed_fail
          mov  r15, rax                            // r15 = root_vn_idx (temp)

          // ---------- Step 1c: recover /bin vnode-pool idx via dedup ----------
          // #754 discipline: vnode_cache_or_alloc with identical args
          // to D10a step 3 / bin_sh_seed step 1c is idempotent — it
          // returns the SAME slot D10a allocated for /bin. This is
          // the sanctioned pattern for re-deriving a vnode-pool idx
          // from a tmpfs inode idx across independent seed sites.
          mov  rdi, r15                            // arg1: parent = root_vn_idx
          mov  rsi, r13                            // arg2: backend = bin_inode_idx
          lea  rdx, [rip + _tmpfs_vops]            // arg3: ops = &_tmpfs_vops
          call vnode_cache_or_alloc                // rax = bin_vn_idx or 0xFFFF
          mov  rcx, 0xFFFF
          cmp  rax, rcx
          je   bin_true_seed_fail                  // VNODE_ALLOC_OOM
          mov  r12, rax                            // r12 = bin_vn_idx

          // ---------- Step 2: tmpfs_create(bin, "true", 4, REG=1) ----------
          mov  rdi, r13                            // dir_inode_idx = bin
          lea  rsi, [rip + true_seed_name]         // "true\0"
          mov  rdx, 4                              // name_len
          mov  rcx, 1                              // VNODE_TYPE_REG
          call tmpfs_create                        // rax = true_inode_idx | 0 | 0xFFFF
          cmp  rax, 0
          je   bin_true_seed_fail
          mov  rcx, 0xFFFF
          cmp  rax, rcx
          je   bin_true_seed_fail                  // TMPFS_INODE_ALLOC_OOM
          mov  r14, rax                            // r14 = true_inode_idx

          // ---------- Step 3: bind /bin/true backend inode to fresh vnode-pool slot ----------
          // #754 FIX (see bin_sh_seed step 3 for full rationale):
          // vnode_cache_or_alloc allocates a FRESH vnode-pool slot,
          // never aliases the tmpfs inode number as a vnode-pool idx.
          mov  rdi, r12                            // arg1: parent = bin_vn_idx
          mov  rsi, r14                            // arg2: backend = true_inode_idx
          lea  rdx, [rip + _tmpfs_vops]            // arg3: ops = &_tmpfs_vops
          call vnode_cache_or_alloc                // rax = true_vn_idx or 0xFFFF
          mov  rcx, 0xFFFF
          cmp  rax, rcx
          je   bin_true_seed_fail                  // VNODE_ALLOC_OOM

          // ---------- Step 4: compute image base + length ----------
          // r15 = _true_bin_start (kernel VA; .rodata.userbin). image_len
          // = _true_bin_end - _true_bin_start; a handful of bytes for
          // the two-syscall + "TRUE OK\n" payload, well under tmpfs's
          // 64 KiB per-file cap and even under a single 4096-byte page
          // (so the write loop makes exactly one iteration in practice).
          // r12 was bin_vn_idx (dead after step 3); repurposed to
          // image_len. r13 was bin_inode_idx, now dead; repurposed to
          // offset (start = 0).
          lea  r15, [rip + _true_bin_start]
          lea  rax, [rip + _true_bin_end]
          sub  rax, r15                            // rax = image_len
          mov  r12, rax                            // r12 = image_len
          xor  r13, r13                            // r13 = offset

          // ---------- Step 5: write in single-page (<=4096-byte) chunks ----------
          // Same shape as bin_sh_seed step 5 / bin_child_hello_seed
          // step 7. tmpfs_write single-page constraint holds because
          // offset is 4096-aligned every iteration (starts at 0, is
          // incremented by chunk_len which is min(4096, remaining)).
      bin_true_seed_write_loop:
          cmp  r13, r12
          jae  bin_true_seed_write_done            // offset >= image_len

          // chunk_len = min(4096, image_len - offset)
          mov  rax, r12
          sub  rax, r13                            // rax = remaining
          mov  rcx, 4096
          cmp  rax, rcx
          jbe  bin_true_seed_chunk_ok
          mov  rax, rcx                            // clamp to 4096
      bin_true_seed_chunk_ok:

          // tmpfs_write(inode_idx=r14, buf=r15+r13, len=rax, offset=r13)
          mov  rdi, r14                            // arg0 = true_inode_idx
          mov  rsi, r15
          add  rsi, r13                            // arg1 = image_base + offset
          mov  rdx, rax                            // arg2 = chunk_len
          mov  rcx, r13                            // arg3 = offset
          call tmpfs_write                         // rax = bytes_written or sentinel

          // Sentinel check: 0xFFFFFFFFFFFFFFFF (rcx-loaded because
          // AND/CMP has no imm64 form). Matches bin_sh_seed.
          mov  rcx, 0xFFFFFFFFFFFFFFFF
          cmp  rax, rcx
          je   bin_true_seed_fail

          add  r13, rax                            // offset += bytes_written
          jmp  bin_true_seed_write_loop

      bin_true_seed_write_done:
          mov  rdi, 3;
          lea  rsi, [rip + SUBSYS_BOOT];
          lea  rdx, [rip + bin_true_seed_ok_msg];
          call klog_s1;
          jmp  bin_true_seed_done

      bin_true_seed_fail:
          mov  rdi, 1;                             // LEVEL_ERROR
          lea  rsi, [rip + SUBSYS_BOOT];
          lea  rdx, [rip + bin_true_seed_fail_msg];
          call klog_s1;

      bin_true_seed_done:

      // ============================================================
      // R16-M4-666 (#666): real-IRQ-driven end-to-end UART RX smoke.
      //
      // Proves the full 16550 RX interrupt chain on the wire:
      //   QEMU host --> chardev pipe --> 16550 RBR --> IOAPIC RTE 4
      //     --> LAPIC --> vec 0x24 IDT gate --> _uart_rx_trampoline
      //     --> uart_rx_isr --> uart_rx_enqueue --> _uart_rx_ring
      //     --> our poll --> emit "UART RX: abc\n" on serial TX.
      //
      // Mode-gated by external byte injection (see tools/run-smoke.sh
      // boot_r16_uart_rx mode). Non-driven boot modes see no bytes,
      // poll times out silently, and no fingerprint line is emitted —
      // every existing mode's fingerprint stays byte-identical (AC
      // preservation matrix: design/kernel/r16-m4-666-uart-rx-e2e-smoke.md §8).
      //
      // Placement rationale: this slot is immediately BEFORE
      // lapic_timer_init so the LAPIC timer LVT is still masked at
      // power-on default during our brief `sti` window — only IRQ 4
      // (the RX line we care about) can be delivered. Once
      // lapic_timer_init runs and _current_tcb is published, timer
      // IRQs fire and any concurrent `sti` witness would race with
      // sched_switch. See design §3.
      //
      // Reuses #601's _uart_rx_smoke_buf slab and uart_rx_smoke_prefix_msg
      // rodata per issue's Design constraints. The ring is empty at
      // entry (#601 left head=tail=3 in balanced state — see design §7).
      //
      // Register discipline:
      //   r12 = &_uart_rx_smoke_buf (survives leaf calls)
      //   r13 = captured byte count 0..3
      //   r14 = start_tsc (rdtsc snapshot, wall-clock reference — #747)
      //   r8, rax, rcx, rdx = scratch, reloaded each iteration
      //
      // #747 (paideia-os): the previous incarnation used r14 as a fixed
      // 200_000_000-iteration countdown. That's cycle-count-bound, not
      // wall-clock-bound — under host CPU contention (load-avg > ~4/8
      // cores on the smoke box) the poll consumed several seconds of
      // wall time, starving boot_r17_init's 8s TIMEOUT budget. See
      // paideia-os commit ce3a17f (temporary TIMEOUT=20 workaround now
      // reverted alongside this fix). Replacing with rdtsc + delta
      // caps the poll's wall time regardless of host load:
      // when a byte arrives, the loop exits fast; when it doesn't, the
      // delta check bails when the host TSC has moved 2_000_000_000
      // ticks. Duration is host-CPU-frequency-dependent because QEMU TCG
      // exposes the host TSC directly (no --icount): empirically
      // ~0.68 s on a ~2.95 GHz host, ~0.87 s on a ~2.3 GHz i7-10510U
      // (paideia-os #747 verify: 2e9 / freq → shorter at higher freq),
      // and would take longer on slower silicon.
      // The point is that the poll STAYS wall-clock bounded; the exact
      // duration slides with host frequency but never goes unbounded.
      // Real-hardware calibration is out of scope for this witness
      // (no bytes ever arrive on non-boot_r16 modes).
      //
      // rdtsc clobbers rax/rdx only; r12/r13/r14/r15 are preserved.
      // uart_rx_dequeue clobbers rax/rcx/rdx/r9/r10 (SysV caller-save
      // per src/kernel/core/uart/rx_ring.pdx:94-95) — safe to trample
      // rax/rdx here since we re-read the TSC every iteration and
      // r14 (start_tsc) survives the call.
      // ============================================================
      uart_rx_wire_witness:
          sti;                                       // arm real IRQ delivery

          lea  r12, [rip + _uart_rx_smoke_buf];      // reuse #601 buf
          xor  r13, r13;                             // captured byte count

          // #747: capture start TSC as wall-clock reference.
          rdtsc;
          shl  rdx, 32;
          or   rax, rdx;
          mov  r14, rax;                             // r14 = start_tsc

      urxw_poll_loop:
          call uart_rx_dequeue;                      // rax = byte | 0xFFFF
          mov  rcx, 0xFF;
          cmp  rax, rcx;
          ja   urxw_no_byte;                         // 0xFFFF > 0xFF => empty

          // Got a byte — store at buf[r13].
          mov  r8, r12;
          add  r8, r13;
          mov_b [r8 + 0], rax;
          add  r13, 1;
          cmp  r13, 3;
          je   urxw_have_three;

      urxw_no_byte:
          // #747: wall-clock check — elapsed_tsc = now - start_tsc.
          // 2_000_000_000 ticks is host-frequency-dependent (~0.68s at
          // 2.95GHz, ~0.87s at 2.3GHz; would be ~2s only at ~1GHz).
          // See #747 verify comment above for full duration analysis.
          rdtsc;
          shl  rdx, 32;
          or   rax, rdx;
          sub  rax, r14;                              // rax = elapsed_tsc
          mov  rcx, 2000000000;                       // ~2s TSC on TCG
          cmp  rax, rcx;
          jb   urxw_poll_loop;                        // still within budget
          // Timeout — bail silently. Ring stays at its current head/tail;
          // any late-arriving bytes are ignored by this witness but remain
          // readable by future consumers.
          cli;
          jmp  urxw_done;

      urxw_have_three:
          cli;                                       // stop IRQ delivery
          // Terminate buffer: buf[3]='\n', buf[4]='\0'.
          mov  rax, 0x0A;
          mov  r8, r12;
          add  r8, 3;
          mov_b [r8 + 0], rax;
          xor  rax, rax;
          mov  r8, r12;
          add  r8, 4;
          mov_b [r8 + 0], rax;

          // Emit "UART RX: " then "abc\n" — same two-call shape as #601.
          // #704: prefix stays as raw uart_puts (NOT klog_s1) so it lands
          // adjacent to the buffer emission on the wire. klog_s1 would append
          // its own newline after "UART RX: ", splitting "UART RX: abc" into
          // two lines and breaking the fingerprint's contiguity check.
          lea  rdi, [rip + uart_rx_smoke_prefix_msg]; // klog-migrate: skip — #704 wire fingerprint (see comment above); paideia-as#1275
          call uart_puts;
          mov  rdi, r12;
          call uart_puts;

      urxw_done:

      call lapic_timer_init;
      // R10-m2-002: For periodic mode (QEMU TCG), set initial count to 10000 cycles.
      mov rdi, 10000;
      call lapic_timer_init_periodic_count;

      // ============================================================
      // R18-M1-005 (#764): boot_smp AP bring-up wire-in.
      //
      // Call ap_bring_up_all with the hard-coded AP list from
      // core/smp/ap_list.pdx (_ap_apic_ids = [1,2,3], _ap_count = 3).
      // Each AP enters _ap_entry (core/smp/ap_entry.pdx) after the
      // real -> protected -> long-mode transition, emits
      // `CPU_ID_XX_HELLO\n` on COM1 (unlocked; grep-scan tolerates
      // torn lines per ap_entry.pdx concurrency note), then parks
      // in a cli/hlt loop.
      //
      // BSP-side START/DONE bookends make the fingerprint order-
      // anchorable regardless of the AP interleave order in the
      // middle. The boot_smp smoke's fingerprint checker uses
      // SMP_UNORDERED_HELLO=1 to treat CPU_ID_XX_HELLO lines as
      // presence-only (no cross-AP ordering).
      //
      // Placement rationale: this slot is AFTER lapic_timer_init +
      // lapic_timer_init_periodic_count (BSP LAPIC fully configured)
      // and BEFORE the init bootstrap (sti + enter_userland_initial
      // never returns). ap_bring_up_all internally uses
      // ap_tsc_busy_wait (rdtsc-based, no interrupts) so it is safe
      // to run with IF=0.
      //
      // Non-boot_smp modes are unaffected in behavior — they see the
      // same START / CPU_ID / DONE lines land on serial, but their
      // fingerprints do not assert them, so they pass unchanged.
      // Only the QEMU launch topology (`-smp 4` vs default `-smp 1`)
      // changes what actually boots: on `-smp 1` the SIPI is a no-op
      // (no APs exist) and only START/DONE will appear.
      //
      // Post-bring-up busy-wait: after ap_bring_up_all returns, the
      // last AP has just been SIPI'd and needs a few ms to boot
      // through real -> prot -> long and reach the uart_puts call
      // in _ap_entry. 1_000_000_000 TSC ticks = ~333 ms at 3 GHz
      // (~1 s at 1 GHz) — comfortably covers the slowest-host case
      // while staying inside the boot_smp smoke's TIMEOUT budget.
      // Serves double duty as a quiet window that lets the AP
      // HELLOs land before the BSP resumes serial traffic for init.
      lea rdi, [rip + smp_bringup_start_msg];
      call uart_puts;

      // R20-M2-005 (#813): MADT-driven AP list, with the R18 hard-coded
      // _ap_apic_ids/_ap_count as fallback.
      //
      // topology_seed_from_madt(env) walks RSDP → XSDT → MADT and
      // fills _madt_ap_list / _madt_ap_count with the APIC IDs of every
      // enabled AP the firmware advertised (BSP filtered). On any early
      // bailout (env==0 without a legacy-scannable RSDP, ACPI < 2.0,
      // no XSDT, no MADT), it returns 0 with _madt_ap_count still 0 —
      // we then fall back to _ap_apic_ids[3]={1,2,3} for QEMU-`-kernel`
      // and other RSDP-less paths (matches R18's boot_smp posture).
      //
      // _boot_env_pa is populated by kernel_main_uefi (UEFI path only);
      // on the BIOS/`-kernel` path it stays 0 — acpi_find_rsdp handles
      // env=0 via its legacy EBDA + [0xE0000,0x100000) scanner path,
      // so passing 0 is safe by construction.
      mov rdi, [rip + _boot_env_pa];
      call topology_seed_from_madt;

      mov rsi, [rip + _madt_ap_count];
      cmp rsi, 0;
      je smp_use_hardcoded_ap_list;

      // MADT-derived list wins.
      lea rdi, [rip + _madt_ap_list];
      jmp smp_do_ap_bring_up;

    smp_use_hardcoded_ap_list:
      lea rdi, [rip + _ap_apic_ids];
      mov rsi, [rip + _ap_count];

    smp_do_ap_bring_up:
      call ap_bring_up_all;

      // Quiet window: let APs finish their real->long transition and
      // emit CPU_ID_XX_HELLO before BSP proceeds to sti + init.
      mov rdi, 1000000000;
      call ap_tsc_busy_wait;

      lea rdi, [rip + smp_bringup_done_msg];
      call uart_puts;

      // R21.M3-004 (#836): IOAPIC re-route structural witness — exercises
      // ioapic_read_at / ioapic_write_at / ioapic_program_redir end-to-end
      // against real MMIO at 0xFEC00000. Saves + reprograms + restores
      // RTE #4; runs inside the boot cli window so the transient dest=1
      // window is inert. See tests/kernel/apic/ioapic_reroute_synth.pdx
      // for the safety argument and the fingerprint contract.
      call ioapic_reroute_witness;

      // R21.M4-005 (#841): MSI-X round-robin structural witness — exercises
      // vector_alloc_for_cpu × 4 + msix_program_entry × 4 against a fake
      // 16-entry .bss-backed MSI-X table. Verifies the per-CPU vector pool
      // hands out DISTINCT vectors and that the 4×u32 entry programming
      // lands the correct bytes via mov_d (G1 sized store). Zero side
      // effects on real MMIO — writes only to _fake_msix_table. See
      // tests/kernel/apic/msix_round_robin.pdx for the full witness.
      call msix_round_robin_witness;

      // #723 blocker #2 — revert of #678: init is the initial ring-3 task.
      // The shell-bypass shortcut landed in d9393d4 (#678) reloaded shell.elf
      // directly to work around sys_execve ENOSYS, bypassing init entirely.
      // Now that #554 (sys_fork), #555 (sys_execve body), #671 (execve dispatch
      // shim), #661 (CoW fast-flip), and #553 (CoW split) all land, init.pdx
      // can fork+exec its children (shell, child_hello) via sys_execve.
      //
      // Reuses the init task_struct published by init_bootstrap_witness above
      // (L6260-6299): _init_task = task_new(NULL) + elf_lite_load(init.elf) +
      // stash e_entry at [+1712]. Here we finish the bootstrap: allocate init's
      // user stack → pre-wire fd_table[0/1/2] to _tty0 (so init inherits stdio
      // without needing /dev/tty0 as a real vfs mount) → publish _current_tcb
      // → runq_enqueue → enter_userland_initial iretq's into init _start.
      //
      // Reference pattern: #652 ring3 witness (kernel_main.pdx:855-879) and the
      // former shell bootstrap (this site, pre-revert).
      //
      // Callee-clobber discipline: r12=_init_task, r13=e_entry, r14=user_rsp
      // preserved across the internal calls (they're callee-save per SysV,
      // and user_stack_alloc/tty_connect_init/runq_enqueue all honor that).
      mov r12, [rip + _init_task];        // r12 = init task_slab (published by init_bootstrap_witness)
      cmp r12, 0;
      je init_boot_fail;

      // e_entry stashed at [_init_task + 1712] by init_bootstrap_witness step 3.
      mov r13, [r12 + 1712];              // r13 = e_entry (user VA)
      cmp r13, 0;
      je init_boot_fail;

      // Allocate 4-page user stack in init's aspace. Returns 0x7FFFFFFFF000
      // (fixed top) on success, 0 on OOM.
      mov rdi, [r12 + 16];                // aspace = user_pml4_pa (VA form)
      mov rsi, 4;                         // 4 pages
      call user_stack_alloc;
      cmp rax, 0;
      je init_boot_fail;
      mov r14, rax;                       // r14 = user_rsp_top

      // Pre-wire init's fd_table[0/1/2] to _tty0 so init has stdio without
      // needing /dev/tty0 to resolve via vfs. Contract per #608 tty_connect_init:
      // rdi = task_ptr, returns 0 on success or -1 if _tty0 uninitialized.
      // Non-fatal if it fails — init still runs, but its stdio syscalls will
      // error out (which is fine for the INIT BOOT OK smoke fingerprint).
      mov rdi, r12;
      call tty_connect_init;

      // Publish _current_tcb = init BEFORE sti — #388 discipline.
      mov ecx, 1;                         // STATE_RUNNABLE (u32 at +8)
      mov [r12 + 8], ecx;
      lea rcx, [rip + _current_tcb];
      mov [rcx], r12;

      // Enqueue on runqueue so sched_pick_next_r15 can find init later.
      mov rdi, r12;
      call runq_enqueue;

      mov rdi, 3;
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + init_boot_ok_msg];
      call klog_s1;

      // ============================================================
      // R20b.M2-003 (#1557): KPTI-safe user<->kernel payload bounce witness.
      //
      // Third + final sub-issue of R20b.M2 (framed variable-length IPC);
      // closes M2. Exercises user_bounce_send / user_bounce_recv (see
      // src/kernel/core/ipc/user_bounce.pdx) end-to-end through the
      // strict-KPTI-safe per-byte walkers (user_read_bytes_via_walk /
      // user_write_bytes_via_walk from src/kernel/core/syscall/user_read.pdx,
      // the #737/#738 precedent used by dispatch_read/write).
      //
      // Placement — after `_current_tcb = init` AND after
      // `user_stack_alloc` mapped init's 4-page user stack at
      // [0x7FFFFFFFB000, 0x7FFFFFFFF000), AND after `INIT BOOT OK` emits
      // (so a broken init boot fails BEFORE this witness runs and we
      // don't chase a false negative). Runs BEFORE `sti` — no timer
      // interrupt can race with the walker's kernel-side scratch state,
      // and no runq switch can flip _current_tcb away from init mid-
      // witness. Runs BEFORE `enter_userland_initial` which never
      // returns.
      //
      // Witness caveat (per #1557 task description) — the witness runs
      // in kernel context but MUST exercise the walker path (otherwise
      // the KPTI witness is meaningless). Option (b) chosen: init's
      // freshly-mapped user stack IS a real user_pml4-mapped page, so
      // walking through it EXACTLY reproduces what a ring-3 sys_ipc_send
      // will do. The deepest stack page (0x7FFFFFFFB000..0x7FFFFFFFC000)
      // is used as the "user" buffer — init's cooperative _start starts
      // at rsp = TOP (0x7FFFFFFFF000) and grows downward; the AC never
      // consumes 4 KiB of stack before its first sys_debug_puts, so the
      // deepest page is unused by init and safe to borrow as scratch.
      //
      // Sub-tests (numeric stage tracked in _ipc_bounce_witness_stage;
      // any failure jumps to ipc_bounce_witness_fail with the stage):
      //
      //   0. endpoint_alloc → r15 = id (fresh, all prior R20b witnesses
      //      cleaned up their allocations — endpoint_alloc_witness's
      //      cleanup loop freed all 128 rows, pending_msg_witness freed
      //      the one it minted, so this alloc returns id=0).
      //   1. frame_encode(hdr_scratch, op=0x05, ver=2, flags=0x0007,
      //      payload_len=4088) — build a real packed header (ver >= 1
      //      per acpi-supervisor-schema §3 ensures hdr != 0 so
      //      endpoint_write_pending's discriminator gate accepts it).
      //   2. Fill _ipc_bounce_witness_pattern[0..4087] with
      //      (i + 1) & 0xFF — non-zero pattern distinguishable from the
      //      zero-fill sentinel used in sub-test 5. Byte 0 = 1, byte
      //      4087 = 4088 & 0xFF = 0xF8.
      //   3. user_write_bytes_via_walk(user_va=0x7FFFFFFFB000, src=hdr,
      //      len=8) — walker-write the encoded hdr to init's user page
      //      at offset 0. Proves walker WRITE direction works against
      //      init's real mapping.
      //   4. user_write_bytes_via_walk(user_va=0x7FFFFFFFB008,
      //      src=pattern, len=4088) — walker-write the 4088-byte payload
      //      to init's user page at offset 8. hdr@[0..7] + payload@[8..
      //      4095] uses the full 4 KiB page — no cross-page walk.
      //   5. user_bounce_send(id, hdr_va=0x7FFFFFFFB000,
      //      payload_va=0x7FFFFFFFB008, payload_len=4088) → 0 (OK).
      //      Round-trips the bounce primitive: reads hdr + 4088-byte
      //      payload through user_read_bytes_via_walk, publishes to
      //      endpoint row 0 via endpoint_write_pending.
      //   6. endpoint_is_full(id) == 1 — post-send, endpoint holds a msg.
      //   7. Wipe user page: user_write_bytes_via_walk(user_va=0x7FFFF
      //      FFFB000, src=_ipc_bounce_witness_zero_scratch, len=4096).
      //      Zeros the entire user page so a subsequent recv that fails
      //      silently would show as all-zero on verify (distinct from
      //      the non-zero pattern).
      //   8. user_bounce_recv(id, hdr_va=0x7FFFFFFFB000,
      //      payload_va=0x7FFFFFFFB008, payload_max=4088) → 4088.
      //      Consumes the pending msg via endpoint_take_pending, walks
      //      hdr + payload back out to the (now-zeroed) user page.
      //   9. endpoint_is_full(id) == 0 — post-take, empty (pending_hdr
      //      cleared as the release barrier per M2-002).
      //  10. Verify: user_read_bytes_via_walk pulls back the hdr byte-
      //      pattern (8 bytes) + first payload byte (offset 8) + last
      //      payload byte (offset 4095) — expect encoded hdr u64 match
      //      + payload[0]=1 + payload[4087]=0xF8. Byte-exact match
      //      proves the round-trip preserved data across two walker
      //      copies + the endpoint's rep_movsb into/out of the arena.
      //  11. endpoint_free(id) so the id is reusable and pending_hdr
      //      returns to its zero-init state.
      //
      // Register discipline: r12/r13/r14 hold init boot state live to
      // enter_userland_initial (r12=_init_task, r13=e_entry, r14=user_rsp);
      // they are pushed at witness entry and popped at exit so the
      // downstream enter_userland_initial sees them unchanged. r15 is
      // the survivor for the endpoint id across every sub-test. Nested
      // calls to walker + endpoint primitives + endpoint_alloc/free +
      // klog_s1_d1 all follow SysV callee-save discipline — 3 pushes at
      // entry take rsp from %16 == 8 (per boot_continue_after_ring3's
      // top-level state, matching every other nested call at this
      // depth like `call runq_enqueue` above) to %16 == 8 -> 0 -> 8
      // ... actually 3 pushes from %16==8 yields (8+3*8)%16 = 32%16 = 0,
      // which is exactly what a nested `call` requires. Same reasoning
      // as pending_msg_witness's nested-call pattern (kernel_main.pdx
      // L5389-L5588).
      // ============================================================
      push r12;
      push r13;
      push r14;

      ipc_bounce_witness:
          // -- Sub-test 0: alloc a fresh endpoint.
          xor rax, rax;
          lea rcx, [rip + _ipc_bounce_witness_stage];
          mov [rcx], rax;                          // stage = 0

          call endpoint_alloc;
          mov r10, 0xFFFFFFFFFFFFFFFF;             // ENDPOINT_ALLOC_NONE
          cmp rax, r10;
          je ipc_bounce_witness_fail;
          mov r15, rax;                            // r15 = id (survives all sub-tests)

          // -- Sub-test 1: build a real packed hdr via frame_encode.
          //    op=0x05, ver=2, flags=0x0007, payload_len=4088 (BOUNCE_MAX_PAYLOAD).
          mov rax, 1;
          lea rcx, [rip + _ipc_bounce_witness_stage];
          mov [rcx], rax;

          lea rdi, [rip + _ipc_bounce_witness_hdr_scratch];
          mov rsi, 0x05;                           // op
          mov rdx, 2;                              // ver (>= 1 so hdr != 0)
          mov rcx, 0x0007;                         // flags
          mov r8, 4088;                            // payload_len
          call frame_encode;
          cmp rax, 0;                              // FRAME_ENCODE_OK
          jne ipc_bounce_witness_fail;

          // -- Sub-test 2: fill the 4088-byte pattern with (i+1) & 0xFF.
          //    Non-zero at every byte so a "did recv actually write?"
          //    check can distinguish real data from the zero-fill wipe.
          mov rax, 2;
          lea rcx, [rip + _ipc_bounce_witness_stage];
          mov [rcx], rax;

          lea r10, [rip + _ipc_bounce_witness_pattern];
          xor r11, r11;                            // i = 0
      ibw_pattern_loop:
          cmp r11, 4088;
          je ibw_pattern_done;
          mov rax, r11;
          add rax, 1;                              // value = (i + 1) & 0xFF
          and rax, 0xFF;
          mov_b [r10 + r11*1], rax;
          add r11, 1;
          jmp ibw_pattern_loop;
      ibw_pattern_done:

          // -- Sub-test 3: walk-write hdr (8 bytes) to init's user page @ 0x7FFFFFFFB000.
          //    Uses user_write_bytes_via_walk directly (not via bounce) so the
          //    SETUP data lands correctly before we test the bounce primitive.
          mov rax, 3;
          lea rcx, [rip + _ipc_bounce_witness_stage];
          mov [rcx], rax;

          mov rdi, 0x7FFFFFFFB000;                 // user_va (init stack page 0, offset 0)
          lea rsi, [rip + _ipc_bounce_witness_hdr_scratch];
          mov rdx, 8;
          call user_write_bytes_via_walk;
          cmp rax, 0;
          jne ipc_bounce_witness_fail;

          // -- Sub-test 4: walk-write payload (4088 bytes) to 0x7FFFFFFFB008.
          //    hdr@[0..7] + payload@[8..4095] fits exactly in one 4 KiB page —
          //    no cross-page walk to complicate the verify.
          mov rax, 4;
          lea rcx, [rip + _ipc_bounce_witness_stage];
          mov [rcx], rax;

          mov rdi, 0x7FFFFFFFB008;                 // user_va (offset 8)
          lea rsi, [rip + _ipc_bounce_witness_pattern];
          mov rdx, 4088;
          call user_write_bytes_via_walk;
          cmp rax, 0;
          jne ipc_bounce_witness_fail;

          // -- Sub-test 5: user_bounce_send round-trips hdr + payload into arena.
          mov rax, 5;
          lea rcx, [rip + _ipc_bounce_witness_stage];
          mov [rcx], rax;

          mov rdi, r15;                            // id
          mov rsi, 0x7FFFFFFFB000;                 // user_hdr_va
          mov rdx, 0x7FFFFFFFB008;                 // user_payload_va
          mov rcx, 4088;                           // payload_len
          call user_bounce_send;
          cmp rax, 0;                              // BOUNCE_SEND_OK
          jne ipc_bounce_witness_fail;

          // -- Sub-test 6: endpoint_is_full(id) == 1.
          mov rax, 6;
          lea rcx, [rip + _ipc_bounce_witness_stage];
          mov [rcx], rax;

          mov rdi, r15;
          call endpoint_is_full;
          cmp rax, 1;
          jne ipc_bounce_witness_fail;

          // -- Sub-test 7: wipe user page so recv-writeback is verifiable.
          //    Zero-fill the entire 4 KiB page via the walker (uses the
          //    .bss zero-init'd _ipc_bounce_witness_zero_scratch as src).
          mov rax, 7;
          lea rcx, [rip + _ipc_bounce_witness_stage];
          mov [rcx], rax;

          mov rdi, 0x7FFFFFFFB000;                 // user_va (page start)
          lea rsi, [rip + _ipc_bounce_witness_zero_scratch];
          mov rdx, 4096;
          call user_write_bytes_via_walk;
          cmp rax, 0;
          jne ipc_bounce_witness_fail;

          // -- Sub-test 8: user_bounce_recv pulls hdr + payload back to user page.
          mov rax, 8;
          lea rcx, [rip + _ipc_bounce_witness_stage];
          mov [rcx], rax;

          mov rdi, r15;                            // id
          mov rsi, 0x7FFFFFFFB000;                 // user_hdr_va
          mov rdx, 0x7FFFFFFFB008;                 // user_payload_va
          mov rcx, 4088;                           // user_payload_max
          call user_bounce_recv;
          cmp rax, 4088;                           // true payload_len
          jne ipc_bounce_witness_fail;

          // -- Sub-test 9: endpoint_is_full(id) == 0 (post-take, empty).
          mov rax, 9;
          lea rcx, [rip + _ipc_bounce_witness_stage];
          mov [rcx], rax;

          mov rdi, r15;
          call endpoint_is_full;
          cmp rax, 0;
          jne ipc_bounce_witness_fail;

          // -- Sub-test 10: verify hdr u64 at user_va 0x7FFFFFFFB000 == encoded hdr.
          //    user_read_bytes_via_walk contract: rdi = kernel_dst,
          //    rsi = user_va, rdx = len. See user_read.pdx L562-565.
          mov rax, 10;
          lea rcx, [rip + _ipc_bounce_witness_stage];
          mov [rcx], rax;

          lea rdi, [rip + _ipc_bounce_witness_verify_scratch];  // kernel_dst
          mov rsi, 0x7FFFFFFFB000;                              // user_va
          mov rdx, 8;                                           // len
          call user_read_bytes_via_walk;
          cmp rax, 0;
          jne ipc_bounce_witness_fail;

          lea r10, [rip + _ipc_bounce_witness_verify_scratch];
          mov rax, [r10];                          // rax = read-back hdr u64
          lea r10, [rip + _ipc_bounce_witness_hdr_scratch];
          mov r11, [r10];                          // r11 = original encoded hdr
          cmp rax, r11;
          jne ipc_bounce_witness_fail;

          // -- Sub-test 11: verify payload byte 0 (user_va 0x7FFFFFFFB008) == 1.
          mov rax, 11;
          lea rcx, [rip + _ipc_bounce_witness_stage];
          mov [rcx], rax;

          lea rdi, [rip + _ipc_bounce_witness_verify_scratch];  // kernel_dst
          mov rsi, 0x7FFFFFFFB008;                              // user_va
          mov rdx, 1;                                           // len
          call user_read_bytes_via_walk;
          cmp rax, 0;
          jne ipc_bounce_witness_fail;

          lea r10, [rip + _ipc_bounce_witness_verify_scratch];
          xor rax, rax;
          mov_b rax, [r10];
          cmp rax, 1;                              // pattern[0] = (0+1) & 0xFF = 1
          jne ipc_bounce_witness_fail;

          // -- Sub-test 12: verify payload byte 4087 (user_va 0x7FFFFFFFB008 + 4087
          //    = 0x7FFFFFFFBFFF) == 0xF8. Same page — no cross-page walk.
          mov rax, 12;
          lea rcx, [rip + _ipc_bounce_witness_stage];
          mov [rcx], rax;

          lea rdi, [rip + _ipc_bounce_witness_verify_scratch];  // kernel_dst
          mov rsi, 0x7FFFFFFFBFFF;                              // user_va
          mov rdx, 1;                                           // len
          call user_read_bytes_via_walk;
          cmp rax, 0;
          jne ipc_bounce_witness_fail;

          lea r10, [rip + _ipc_bounce_witness_verify_scratch];
          xor rax, rax;
          mov_b rax, [r10];
          cmp rax, 0xF8;                           // pattern[4087] = 4088 & 0xFF = 0xF8
          jne ipc_bounce_witness_fail;

          // -- Sub-test 13: cleanup — free the endpoint.
          mov rax, 13;
          lea rcx, [rip + _ipc_bounce_witness_stage];
          mov [rcx], rax;

          mov rdi, r15;
          call endpoint_free;

          // Success marker: R20b IPC BOUNCE OK.
          mov rdi, 3;                              // LEVEL_INFO
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + ipc_bounce_ok_msg];
          call klog_s1;
          jmp sys_ipc_recv_witness;

      // ============================================================
      // R20b.M3-001 (#1558): sys_ipc_recv syscall witness.
      //
      // Opens the R20b.M3 (server-process model) branch. Exercises
      // sys_ipc_recv_body (src/kernel/core/syscall/handlers/sys_ipc_recv.pdx)
      // by (a) pre-loading a pending message on a freshly-allocated endpoint
      // via endpoint_write_pending (the R20b.M2-002 kernel-side primitive),
      // (b) calling sys_ipc_recv_body directly with a raw endpoint_id
      // (bypassing the dispatch-shim cap-check gate per the witness
      // constraint in the sub-issue task — cap-check is exercised by a
      // future syscall-shim smoke once R20b.M4 seeds real caps into
      // ring-3), and (c) verifying that the drained hdr + payload landed
      // byte-exactly in init's user-VA-mapped page via user_read_bytes_via_walk.
      //
      // Placement — inside the ipc_bounce_witness push/pop scope so init
      // boot state (r12/r13/r14) stays saved for the downstream
      // enter_userland_initial call. Runs AFTER "R20b IPC BOUNCE OK" so
      // the prior witnesses' cleanup completed (they all endpoint_free'd
      // their allocations, so this witness's endpoint_alloc returns a
      // low id like 0).
      //
      // Path exercised — the NON-EMPTY (immediate-drain) path only. The
      // empty-endpoint / sched_block / retry path is present in the body
      // (see sys_ipc_recv.pdx §sys_ipc_recv_block) but not driven from
      // this witness because no producer (sys_ipc_send, R20b.M3-002)
      // exists yet to wake us. Empty-path testability is documented in
      // the M3-001 acceptance criteria as a future send-wakeup fixture.
      //
      // Sub-tests (numeric stage tracked in _sys_ipc_recv_witness_stage;
      // any failure jumps to sys_ipc_recv_witness_fail with the stage):
      //
      //   0. endpoint_alloc → r15 = id (fresh; prior witnesses freed all
      //      their endpoints so this returns id=0).
      //   1. frame_encode(hdr_scratch, op=0x10, ver=2, flags=0x0003,
      //      payload_len=64) — build a real packed hdr (ver >= 1 so
      //      pending_hdr discriminator gate accepts it).
      //   2. Fill kernel-side _sys_ipc_recv_witness_src with pattern
      //      (i + 2) & 0xFF, i in 0..63. Non-zero base (2, not 1)
      //      distinguishes from ipc_bounce_witness's pattern.
      //   3. endpoint_write_pending(id, hdr, src, 64) publishes the msg
      //      onto endpoint row `id`.
      //   4. Pre-wipe init's user page at 0x7FFFFFFFB000 via a walker
      //      write from _sys_ipc_recv_witness_zero_scratch — so a broken
      //      recv that skipped the writeback shows as all-zero.
      //   5. sys_ipc_recv_body(id, 0x7FFFFFFFB000, 0x7FFFFFFFB008, 64)
      //      → 64. Drains via user_bounce_recv (which itself walks the
      //      writeback through init's user_pml4).
      //   6. endpoint_is_full(id) == 0 — post-drain, endpoint cleared.
      //   7. Verify hdr u64 at user_va 0x7FFFFFFFB000 matches the
      //      encoded hdr (byte-exact — proves walker WRITE + endpoint
      //      arena copy-out preserved the 8-byte header).
      //   8. Verify payload[0] at user_va 0x7FFFFFFFB008 == 2 (pattern
      //      base 0 → 0+2 & 0xFF).
      //   9. Verify payload[63] at user_va 0x7FFFFFFFB047 == 0x41
      //      (63+2 & 0xFF = 65).
      //  10. endpoint_free(id) — cleanup.
      //
      // Register discipline: reuses r15 (endpoint id, survives every
      // sub-test) — same idiom as ipc_bounce_witness. r12/r13/r14 remain
      // saved from the outer ipc_bounce_witness push/pop; enter_userland_
      // initial after ipc_bounce_witness_done sees them unchanged. All
      // nested calls (endpoint_alloc / endpoint_write_pending /
      // endpoint_is_full / endpoint_free / user_write_bytes_via_walk /
      // user_read_bytes_via_walk / sys_ipc_recv_body / frame_encode /
      // klog_s1 / klog_s1_d1) follow SysV callee-save discipline; rsp
      // was at %16==0 for nested calls on entry to sys_ipc_recv_witness
      // (inherited from the outer 3-push prologue: 8 + 3*8 = 32; 32%16=0),
      // and we make no additional pushes, so nested calls see the
      // required %16==8 on entry per SysV.
      // ============================================================
      sys_ipc_recv_witness:
          // -- Sub-test 0: alloc a fresh endpoint.
          xor rax, rax;
          lea rcx, [rip + _sys_ipc_recv_witness_stage];
          mov [rcx], rax;                          // stage = 0

          call endpoint_alloc;
          mov r10, 0xFFFFFFFFFFFFFFFF;             // ENDPOINT_ALLOC_NONE
          cmp rax, r10;
          je sys_ipc_recv_witness_fail;
          mov r15, rax;                            // r15 = id

          // -- Sub-test 1: build a real packed hdr via frame_encode.
          //    op=0x10, ver=2, flags=0x0003, payload_len=64.
          mov rax, 1;
          lea rcx, [rip + _sys_ipc_recv_witness_stage];
          mov [rcx], rax;

          lea rdi, [rip + _sys_ipc_recv_witness_hdr_scratch];
          mov rsi, 0x10;                           // op
          mov rdx, 2;                              // ver (>= 1 so hdr != 0)
          mov rcx, 0x0003;                         // flags
          mov r8, 64;                              // payload_len
          call frame_encode;
          cmp rax, 0;                              // FRAME_ENCODE_OK
          jne sys_ipc_recv_witness_fail;

          // -- Sub-test 2: fill 64-byte src with pattern (i+2) & 0xFF.
          //    Base 2 (not 1) distinguishes from ipc_bounce_witness's
          //    pattern so a mis-wired witness firing the wrong path is
          //    trivially spotted.
          mov rax, 2;
          lea rcx, [rip + _sys_ipc_recv_witness_stage];
          mov [rcx], rax;

          lea r10, [rip + _sys_ipc_recv_witness_src];
          xor r11, r11;                            // i = 0
      sirw_src_loop:
          cmp r11, 64;
          je sirw_src_done;
          mov rax, r11;
          add rax, 2;                              // value = (i + 2) & 0xFF
          and rax, 0xFF;
          mov_b [r10 + r11*1], rax;
          add r11, 1;
          jmp sirw_src_loop;
      sirw_src_done:

          // -- Sub-test 3: publish via endpoint_write_pending.
          mov rax, 3;
          lea rcx, [rip + _sys_ipc_recv_witness_stage];
          mov [rcx], rax;

          mov rdi, r15;                            // id
          lea r10, [rip + _sys_ipc_recv_witness_hdr_scratch];
          mov rsi, [r10];                          // hdr (u64)
          lea rdx, [rip + _sys_ipc_recv_witness_src];  // payload_ptr (kernel VA)
          mov rcx, 64;                             // payload_len
          call endpoint_write_pending;
          cmp rax, 0;                              // PENDING_WRITE_OK
          jne sys_ipc_recv_witness_fail;

          // -- Sub-test 4: pre-wipe init's user page @ 0x7FFFFFFFB000.
          //    Guarantees that a broken recv (skipped writeback) shows
          //    as all-zero at the verify step.
          mov rax, 4;
          lea rcx, [rip + _sys_ipc_recv_witness_stage];
          mov [rcx], rax;

          mov rdi, 0x7FFFFFFFB000;                 // user_va (page start)
          lea rsi, [rip + _sys_ipc_recv_witness_zero_scratch];
          mov rdx, 4096;
          call user_write_bytes_via_walk;
          cmp rax, 0;
          jne sys_ipc_recv_witness_fail;

          // -- Sub-test 5: sys_ipc_recv_body drains hdr + payload.
          //    Called directly with a raw endpoint_id per the witness-
          //    constraint option (a): the dispatch shim's cap-lookup
          //    gate is exercised by a future syscall-shim smoke once
          //    userspace has been seeded real caps.
          mov rax, 5;
          lea rcx, [rip + _sys_ipc_recv_witness_stage];
          mov [rcx], rax;

          mov rdi, r15;                            // id
          mov rsi, 0x7FFFFFFFB000;                 // user_hdr_va
          mov rdx, 0x7FFFFFFFB008;                 // user_payload_va
          mov rcx, 64;                             // user_payload_max
          call sys_ipc_recv_body;
          cmp rax, 64;                             // expected payload_len
          jne sys_ipc_recv_witness_fail;

          // -- Sub-test 6: endpoint_is_full(id) == 0 (post-drain).
          mov rax, 6;
          lea rcx, [rip + _sys_ipc_recv_witness_stage];
          mov [rcx], rax;

          mov rdi, r15;
          call endpoint_is_full;
          cmp rax, 0;
          jne sys_ipc_recv_witness_fail;

          // -- Sub-test 7: hdr byte-exact at user_va 0x7FFFFFFFB000.
          mov rax, 7;
          lea rcx, [rip + _sys_ipc_recv_witness_stage];
          mov [rcx], rax;

          lea rdi, [rip + _sys_ipc_recv_witness_verify_scratch];
          mov rsi, 0x7FFFFFFFB000;
          mov rdx, 8;
          call user_read_bytes_via_walk;
          cmp rax, 0;
          jne sys_ipc_recv_witness_fail;

          lea r10, [rip + _sys_ipc_recv_witness_verify_scratch];
          mov rax, [r10];                          // read-back hdr u64
          lea r10, [rip + _sys_ipc_recv_witness_hdr_scratch];
          mov r11, [r10];                          // original encoded hdr
          cmp rax, r11;
          jne sys_ipc_recv_witness_fail;

          // -- Sub-test 8: payload[0] == 2 at user_va 0x7FFFFFFFB008.
          mov rax, 8;
          lea rcx, [rip + _sys_ipc_recv_witness_stage];
          mov [rcx], rax;

          lea rdi, [rip + _sys_ipc_recv_witness_verify_scratch];
          mov rsi, 0x7FFFFFFFB008;
          mov rdx, 1;
          call user_read_bytes_via_walk;
          cmp rax, 0;
          jne sys_ipc_recv_witness_fail;

          lea r10, [rip + _sys_ipc_recv_witness_verify_scratch];
          xor rax, rax;
          mov_b rax, [r10];
          cmp rax, 2;                              // pattern[0] = (0+2) & 0xFF = 2
          jne sys_ipc_recv_witness_fail;

          // -- Sub-test 9: payload[63] == 0x41 at user_va 0x7FFFFFFFB047.
          //    (0x7FFFFFFFB008 + 63 = 0x7FFFFFFFB047; still same page).
          mov rax, 9;
          lea rcx, [rip + _sys_ipc_recv_witness_stage];
          mov [rcx], rax;

          lea rdi, [rip + _sys_ipc_recv_witness_verify_scratch];
          mov rsi, 0x7FFFFFFFB047;
          mov rdx, 1;
          call user_read_bytes_via_walk;
          cmp rax, 0;
          jne sys_ipc_recv_witness_fail;

          lea r10, [rip + _sys_ipc_recv_witness_verify_scratch];
          xor rax, rax;
          mov_b rax, [r10];
          cmp rax, 0x41;                           // pattern[63] = 65 = 0x41
          jne sys_ipc_recv_witness_fail;

          // -- Sub-test 10: cleanup — free the endpoint.
          mov rax, 10;
          lea rcx, [rip + _sys_ipc_recv_witness_stage];
          mov [rcx], rax;

          mov rdi, r15;
          call endpoint_free;

          // Success marker: R20b SYS IPC RECV OK.
          mov rdi, 3;                              // LEVEL_INFO
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + sys_ipc_recv_ok_msg];
          call klog_s1;
          jmp sys_ipc_send_witness;

      sys_ipc_recv_witness_fail:
          // Emit "R20b SYS IPC RECV FAIL" with sub-test stage as decimal KV.
          lea rax, [rip + _sys_ipc_recv_witness_stage];
          mov r8, [rax];                           // r8 = stage (u64)
          mov rdi, 1;                              // LEVEL_ERROR
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + sys_ipc_recv_fail_msg];
          lea rcx, [rip + k_line];                 // reuse "line" key
          call klog_s1_d1;
          jmp ipc_bounce_witness_done;

      // ============================================================
      // R20b.M3-002 (#1559): sys_ipc_send / sys_ipc_reply witness.
      //
      // Second sub-issue of the R20b.M3 branch — the producer paired
      // with sys_ipc_recv. Exercises sys_ipc_send_body and
      // sys_ipc_reply_body (src/kernel/core/syscall/handlers/) directly
      // with all four acceptance-criteria scenarios:
      //
      //   A. Send with NO waiter → msg queued, no wake, rax=0.
      //   B. Send to full endpoint → rax=1 (BOUNCE_SEND_ERR_EAGAIN,
      //      passed through from user_bounce_send).
      //   C. Send with waiter present → msg queued, waiter runq_enqueue'd,
      //      endpoint.waiter_tcb cleared, rax=0.
      //   D. Reply with hdr.op bit 7 set → same wake+publish semantics.
      //   E. Reply with hdr.op bit 7 CLEAR → rax=-EINVAL (distinct
      //      rejection sentinel).
      //
      // Placement — inside the ipc_bounce_witness push/pop scope
      // (init's r12/r13/r14 remain saved for the downstream
      // enter_userland_initial call). Runs AFTER "R20b SYS IPC RECV OK"
      // so all prior R20b witnesses have completed their endpoint_free
      // cleanup — this witness's endpoint_alloc returns a low id (0).
      //
      // Witness constraint — the fake TCB used in scenario C is a
      // .bss-zero'd blob, NOT a real running task. sys_ipc_send_body's
      // wake path calls sched_wake which sets fake_tcb.state = RUNNABLE
      // and runq_enqueue's it — we verify the wake by inspecting BOTH
      // (a) endpoint.waiter_tcb cleared (the primary side effect the
      // task specified) AND (b) the fake TCB's state slot flipped to
      // RUNNABLE AND (c) the fake TCB was linked into the runqueue
      // (fake_tcb.prev at +440 is non-null OR CB.tail == &fake_tcb
      // in the multi-element case — we check via CB.tail from IA32_GS_BASE).
      // We NEVER call sched_switch on the fake TCB, and we runq_dequeue
      // it BEFORE returning to the enter_userland_initial path so it
      // cannot be picked by sched_pick_next_r15 at ring-3 entry.
      //
      // Sub-tests (numeric stage tracked in _sys_ipc_send_witness_stage;
      // any failure jumps to sys_ipc_send_witness_fail with the stage):
      //
      //   0. endpoint_alloc → r15 = id (fresh; prior witnesses freed
      //      all endpoints so this returns a low id).
      //   1. frame_encode(hdr_scratch, op=0x11, ver=1, flags=0x0000,
      //      payload_len=32) — request-style hdr (bit 7 CLEAR).
      //   2. Fill kernel-side _sys_ipc_send_witness_src with pattern
      //      (i + 5) & 0xFF, i in 0..31.
      //   3. Pre-wipe init's user page @ 0x7FFFFFFFB000 via walker write
      //      from _sys_ipc_send_witness_zero_scratch (4096 bytes).
      //   4. Publish hdr (8 bytes) to user_va 0x7FFFFFFFB000 via
      //      user_write_bytes_via_walk — the send body will read this
      //      back through user_bounce_send.
      //   5. Publish payload (32 bytes) to user_va 0x7FFFFFFFB008.
      //   6. Scenario A: sys_ipc_send_body(id, 0x7FFFFFFFB000,
      //      0x7FFFFFFFB008, 32) with waiter_tcb=0 → rax==0.
      //   7. endpoint_is_full(id) == 1 — msg queued.
      //   8. Scenario B: second sys_ipc_send_body on the still-full
      //      endpoint → rax==1 (BOUNCE_SEND_ERR_EAGAIN pass-through).
      //   9. Drain: endpoint_take_pending(id, hdr_take_scratch,
      //      payload_take_scratch) → 32 (endpoint back to empty).
      //  10. Scenario C setup: arm the fake waiter — write
      //      &_sys_ipc_send_witness_fake_tcb into [row+32]
      //      (ENDPOINT_OFF_WAITER_TCB), pre-flip fake_tcb.state to
      //      STATE_WAITING (2) so sched_wake's #663 guard proceeds.
      //  11. Scenario C fire: sys_ipc_send_body(...) → rax==0.
      //  12. Scenario C verify (a): endpoint.waiter_tcb at [row+32] == 0.
      //  13. Scenario C verify (b): fake_tcb.state at +8 == STATE_RUNNABLE (1).
      //  14. Scenario C verify (c): fake_tcb.prev at +440 == 0 (head
      //      marker — fake was the ONLY task enqueued by our wake;
      //      init's own TCB was NOT re-enqueued because sched_wake
      //      early-exits on already-RUNNABLE per its #663 guard).
      //  15. Scenario C cleanup: runq_dequeue(&fake_tcb) — unlinks
      //      from the runqueue so it cannot be picked at ring-3 entry.
      //      Also drains the pending msg.
      //  16. Scenario D: frame_encode with op=0x91 (0x11 | 0x80, bit
      //      7 SET), republish hdr + payload, sys_ipc_reply_body → rax==0.
      //      Drain.
      //  17. Scenario E: frame_encode with op=0x11 (bit 7 CLEAR),
      //      republish hdr, sys_ipc_reply_body → rax == -EINVAL
      //      (0xFFFFFFFFFFFFFFEA). Endpoint stays empty (rejection
      //      happens before user_bounce_send touches the endpoint).
      //  18. endpoint_free(id) — final cleanup.
      //
      // Register discipline: reuses r15 (endpoint id, survives every
      // sub-test) — same idiom as sys_ipc_recv_witness. r12/r13/r14
      // remain saved from the outer ipc_bounce_witness push/pop;
      // enter_userland_initial after ipc_bounce_witness_done sees them
      // unchanged. rsp %16 == 0 for nested calls holds from the outer
      // 3-push prologue (8 + 3*8 = 32; %16 = 0); nested calls thus see
      // %16 == 8 on entry per SysV.
      // ============================================================
      sys_ipc_send_witness:
          // -- Sub-test 0: alloc a fresh endpoint.
          xor rax, rax;
          lea rcx, [rip + _sys_ipc_send_witness_stage];
          mov [rcx], rax;                          // stage = 0

          call endpoint_alloc;
          mov r10, 0xFFFFFFFFFFFFFFFF;             // ENDPOINT_ALLOC_NONE
          cmp rax, r10;
          je sys_ipc_send_witness_fail;
          mov r15, rax;                            // r15 = id

          // -- Sub-test 1: build request-style hdr (op=0x11, bit 7 CLEAR).
          mov rax, 1;
          lea rcx, [rip + _sys_ipc_send_witness_stage];
          mov [rcx], rax;

          lea rdi, [rip + _sys_ipc_send_witness_hdr_scratch];
          mov rsi, 0x11;                           // op (no bit 7)
          mov rdx, 1;                              // ver
          mov rcx, 0x0000;                         // flags
          mov r8, 32;                              // payload_len
          call frame_encode;
          cmp rax, 0;                              // FRAME_ENCODE_OK
          jne sys_ipc_send_witness_fail;

          // -- Sub-test 2: fill 32-byte src with pattern (i+5) & 0xFF.
          mov rax, 2;
          lea rcx, [rip + _sys_ipc_send_witness_stage];
          mov [rcx], rax;

          lea r10, [rip + _sys_ipc_send_witness_src];
          xor r11, r11;                            // i = 0
      siss_src_loop:
          cmp r11, 32;
          je siss_src_done;
          mov rax, r11;
          add rax, 5;
          and rax, 0xFF;
          mov_b [r10 + r11*1], rax;
          add r11, 1;
          jmp siss_src_loop;
      siss_src_done:

          // -- Sub-test 3: pre-wipe init's user page @ 0x7FFFFFFFB000.
          mov rax, 3;
          lea rcx, [rip + _sys_ipc_send_witness_stage];
          mov [rcx], rax;

          mov rdi, 0x7FFFFFFFB000;                 // user_va (page start)
          lea rsi, [rip + _sys_ipc_send_witness_zero_scratch];
          mov rdx, 4096;
          call user_write_bytes_via_walk;
          cmp rax, 0;
          jne sys_ipc_send_witness_fail;

          // -- Sub-test 4: publish hdr to user_va 0x7FFFFFFFB000 (8 bytes).
          mov rax, 4;
          lea rcx, [rip + _sys_ipc_send_witness_stage];
          mov [rcx], rax;

          mov rdi, 0x7FFFFFFFB000;
          lea rsi, [rip + _sys_ipc_send_witness_hdr_scratch];
          mov rdx, 8;
          call user_write_bytes_via_walk;
          cmp rax, 0;
          jne sys_ipc_send_witness_fail;

          // -- Sub-test 5: publish payload to user_va 0x7FFFFFFFB008 (32 bytes).
          mov rax, 5;
          lea rcx, [rip + _sys_ipc_send_witness_stage];
          mov [rcx], rax;

          mov rdi, 0x7FFFFFFFB008;
          lea rsi, [rip + _sys_ipc_send_witness_src];
          mov rdx, 32;
          call user_write_bytes_via_walk;
          cmp rax, 0;
          jne sys_ipc_send_witness_fail;

          // -- Sub-test 6: SCENARIO A — send with no waiter.
          mov rax, 6;
          lea rcx, [rip + _sys_ipc_send_witness_stage];
          mov [rcx], rax;

          mov rdi, r15;                            // id
          mov rsi, 0x7FFFFFFFB000;                 // user_hdr_va
          mov rdx, 0x7FFFFFFFB008;                 // user_payload_va
          mov rcx, 32;                             // payload_len
          call sys_ipc_send_body;
          cmp rax, 0;                              // SYS_IPC_SEND_OK
          jne sys_ipc_send_witness_fail;

          // -- Sub-test 7: endpoint_is_full == 1 (msg queued).
          mov rax, 7;
          lea rcx, [rip + _sys_ipc_send_witness_stage];
          mov [rcx], rax;

          mov rdi, r15;
          call endpoint_is_full;
          cmp rax, 1;
          jne sys_ipc_send_witness_fail;

          // -- Sub-test 8: SCENARIO B — second send on full endpoint → EAGAIN.
          mov rax, 8;
          lea rcx, [rip + _sys_ipc_send_witness_stage];
          mov [rcx], rax;

          mov rdi, r15;
          mov rsi, 0x7FFFFFFFB000;
          mov rdx, 0x7FFFFFFFB008;
          mov rcx, 32;
          call sys_ipc_send_body;
          cmp rax, 1;                              // BOUNCE_SEND_ERR_EAGAIN
          jne sys_ipc_send_witness_fail;

          // -- Sub-test 9: drain the pending msg.
          mov rax, 9;
          lea rcx, [rip + _sys_ipc_send_witness_stage];
          mov [rcx], rax;

          mov rdi, r15;
          lea rsi, [rip + _sys_ipc_send_witness_hdr_take_scratch];
          lea rdx, [rip + _sys_ipc_send_witness_payload_take_scratch];
          call endpoint_take_pending;
          cmp rax, 32;                             // payload_len returned
          jne sys_ipc_send_witness_fail;

          // -- Sub-test 10: SCENARIO C setup — arm fake waiter.
          //    Endpoint row PA: endpoint_lookup(id).
          //    Store &_sys_ipc_send_witness_fake_tcb into [row+32].
          //    Pre-flip fake_tcb.state to STATE_WAITING (2) so
          //    sched_wake's early-exit guard is not tripped.
          mov rax, 10;
          lea rcx, [rip + _sys_ipc_send_witness_stage];
          mov [rcx], rax;

          mov rdi, r15;
          call endpoint_lookup;                    // rax = row PA
          cmp rax, 0;
          je sys_ipc_send_witness_fail;
          mov r14, rax;                            // r14 = row PA (survives)

          // fake_tcb.state (+8, u32) = STATE_WAITING (2)
          lea r10, [rip + _sys_ipc_send_witness_fake_tcb];
          mov rcx, 2;
          mov [r10 + 8], ecx;

          // endpoint.waiter_tcb (+32, u64) = &fake_tcb
          mov [r14 + 32], r10;

          // -- Sub-test 11: SCENARIO C fire — send with waiter → rax==0.
          mov rax, 11;
          lea rcx, [rip + _sys_ipc_send_witness_stage];
          mov [rcx], rax;

          mov rdi, r15;
          mov rsi, 0x7FFFFFFFB000;
          mov rdx, 0x7FFFFFFFB008;
          mov rcx, 32;
          call sys_ipc_send_body;
          cmp rax, 0;
          jne sys_ipc_send_witness_fail;

          // -- Sub-test 12: verify (a) endpoint.waiter_tcb cleared.
          //    Re-look up the row (r14 may have been clobbered by nested
          //    calls' caller-save discipline; r14 is callee-save so
          //    survives, but re-lookup is cheap defensive practice).
          mov rax, 12;
          lea rcx, [rip + _sys_ipc_send_witness_stage];
          mov [rcx], rax;

          mov rdi, r15;
          call endpoint_lookup;
          cmp rax, 0;
          je sys_ipc_send_witness_fail;
          mov r14, rax;                            // refresh r14

          mov r10, [r14 + 32];                     // waiter_tcb
          cmp r10, 0;
          jne sys_ipc_send_witness_fail;           // must be cleared

          // -- Sub-test 13: verify (b) fake_tcb.state == STATE_RUNNABLE (1).
          mov rax, 13;
          lea rcx, [rip + _sys_ipc_send_witness_stage];
          mov [rcx], rax;

          lea r10, [rip + _sys_ipc_send_witness_fake_tcb];
          xor rax, rax;
          mov eax, [r10 + 8];                      // fake_tcb.state (u32)
          cmp rax, 1;                              // STATE_RUNNABLE
          jne sys_ipc_send_witness_fail;

          // -- Sub-test 14: verify (c) fake_tcb is on the runq via
          //    CB.tail == &fake_tcb. Direct positive evidence of
          //    runq_enqueue: sched_wake -> runq_enqueue inserts at the
          //    tail of the calling CPU's per-CPU runqueue, so CB.tail
          //    (Percpu +40, PERCPU_OFF_RUNQUEUE_TAIL per runqueue.pdx)
          //    must equal the fake TCB's kernel VA.
          //
          //    Init is already on the runq at witness time — the boot
          //    path at kernel_main.pdx L10373 calls runq_enqueue(init)
          //    BEFORE ipc_bounce_witness runs. So the runqueue at
          //    witness entry is [init]. Post-sched_wake(fake) it's
          //    [init, fake] with CB.head = &init, CB.tail = &fake.
          //    (Prior sub-tests 6..11 issued sys_ipc_send_body calls
          //    that DID NOT touch the runq — no waiter, so no wake —
          //    so init's position on the runq is preserved.)
          //
          //    Read CB.tail via rdmsr IA32_GS_BASE + [rax + 40] —
          //    same idiom as runq_enqueue itself (runqueue.pdx §L250
          //    "rdmsr; shl rdx, 32; or rax, rdx"). MSR 0xC0000101 =
          //    IA32_GS_BASE.
          mov rax, 14;
          lea rcx, [rip + _sys_ipc_send_witness_stage];
          mov [rcx], rax;

          mov rcx, 0xC0000101;                     // IA32_GS_BASE
          rdmsr;
          shl rdx, 32;
          or  rax, rdx;                            // rax = Percpu CB VA

          mov r10, [rax + 40];                     // r10 = CB.tail
          lea r11, [rip + _sys_ipc_send_witness_fake_tcb];
          cmp r10, r11;
          jne sys_ipc_send_witness_fail;

          // -- Sub-test 15: cleanup — runq_dequeue(fake_tcb) + drain msg.
          //    runq_dequeue unlinks fake from the runq AND nulls
          //    fake.next/prev (per runqueue.pdx §runq_dequeue) so
          //    sched_pick_next_r15 cannot return it at ring-3 entry.
          mov rax, 15;
          lea rcx, [rip + _sys_ipc_send_witness_stage];
          mov [rcx], rax;

          lea rdi, [rip + _sys_ipc_send_witness_fake_tcb];
          call runq_dequeue;

          // Drain the still-pending msg to reset the endpoint to empty
          // for scenarios D + E.
          mov rdi, r15;
          lea rsi, [rip + _sys_ipc_send_witness_hdr_take_scratch];
          lea rdx, [rip + _sys_ipc_send_witness_payload_take_scratch];
          call endpoint_take_pending;
          cmp rax, 32;
          jne sys_ipc_send_witness_fail;

          // -- Sub-test 16: SCENARIO D — sys_ipc_reply with bit 7 SET.
          //    Rebuild hdr with op = 0x11 | 0x80 = 0x91.
          mov rax, 16;
          lea rcx, [rip + _sys_ipc_send_witness_stage];
          mov [rcx], rax;

          lea rdi, [rip + _sys_ipc_send_witness_hdr_scratch];
          mov rsi, 0x91;                           // op with FRAME_OP_REPLY_BIT
          mov rdx, 1;
          mov rcx, 0x0000;
          mov r8, 32;
          call frame_encode;
          cmp rax, 0;
          jne sys_ipc_send_witness_fail;

          // Re-publish hdr to user_va (payload is unchanged from before,
          // still at 0x7FFFFFFFB008; only the hdr needs a rewrite).
          mov rdi, 0x7FFFFFFFB000;
          lea rsi, [rip + _sys_ipc_send_witness_hdr_scratch];
          mov rdx, 8;
          call user_write_bytes_via_walk;
          cmp rax, 0;
          jne sys_ipc_send_witness_fail;

          // Fire sys_ipc_reply_body — bit 7 SET → delegates to send body.
          mov rdi, r15;
          mov rsi, 0x7FFFFFFFB000;
          mov rdx, 0x7FFFFFFFB008;
          mov rcx, 32;
          call sys_ipc_reply_body;
          cmp rax, 0;
          jne sys_ipc_send_witness_fail;

          // Drain to reset endpoint.
          mov rdi, r15;
          lea rsi, [rip + _sys_ipc_send_witness_hdr_take_scratch];
          lea rdx, [rip + _sys_ipc_send_witness_payload_take_scratch];
          call endpoint_take_pending;
          cmp rax, 32;
          jne sys_ipc_send_witness_fail;

          // -- Sub-test 17: SCENARIO E — sys_ipc_reply with bit 7 CLEAR.
          //    Rebuild hdr with op = 0x11 (no reply bit).
          mov rax, 17;
          lea rcx, [rip + _sys_ipc_send_witness_stage];
          mov [rcx], rax;

          lea rdi, [rip + _sys_ipc_send_witness_hdr_scratch];
          mov rsi, 0x11;                           // op with NO reply bit
          mov rdx, 1;
          mov rcx, 0x0000;
          mov r8, 32;
          call frame_encode;
          cmp rax, 0;
          jne sys_ipc_send_witness_fail;

          // Re-publish the (bit-7-clear) hdr to user_va.
          mov rdi, 0x7FFFFFFFB000;
          lea rsi, [rip + _sys_ipc_send_witness_hdr_scratch];
          mov rdx, 8;
          call user_write_bytes_via_walk;
          cmp rax, 0;
          jne sys_ipc_send_witness_fail;

          // Fire sys_ipc_reply_body — expect -EINVAL (0xFFFFFFFFFFFFFFEA).
          mov rdi, r15;
          mov rsi, 0x7FFFFFFFB000;
          mov rdx, 0x7FFFFFFFB008;
          mov rcx, 32;
          call sys_ipc_reply_body;
          mov r10, 0xFFFFFFFFFFFFFFEA;             // -EINVAL sentinel
          cmp rax, r10;
          jne sys_ipc_send_witness_fail;

          // Endpoint MUST still be empty (rejection happened before
          // any endpoint mutation).
          mov rdi, r15;
          call endpoint_is_full;
          cmp rax, 0;
          jne sys_ipc_send_witness_fail;

          // -- Sub-test 18: cleanup — free the endpoint.
          mov rax, 18;
          lea rcx, [rip + _sys_ipc_send_witness_stage];
          mov [rcx], rax;

          mov rdi, r15;
          call endpoint_free;

          // Success marker: R20b SYS IPC SEND OK.
          mov rdi, 3;                              // LEVEL_INFO
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + sys_ipc_send_ok_msg];
          call klog_s1;
          jmp sys_svc_lookup_witness;

      sys_ipc_send_witness_fail:
          // Emit "R20b SYS IPC SEND FAIL" with sub-test stage as decimal KV.
          lea rax, [rip + _sys_ipc_send_witness_stage];
          mov r8, [rax];                           // r8 = stage (u64)
          mov rdi, 1;                              // LEVEL_ERROR
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + sys_ipc_send_fail_msg];
          lea rcx, [rip + k_line];                 // reuse "line" key
          call klog_s1_d1;
          jmp ipc_bounce_witness_done;

      // ============================================================
      // R20b.M3-003 (#1560): sys_svc_lookup syscall witness.
      //
      // Fourth (and closing) sub-issue of the R20b.M3 branch — closes
      // the server-process model milestone. Exercises sys_svc_lookup_body
      // (src/kernel/core/syscall/handlers/sys_svc_lookup.pdx) end-to-end:
      // walker-bounce a user-VA name into the body's kernel scratch,
      // look up the broker row, mint a KIND_IPC_ENDPOINT cap in a free
      // cap_table slot with the row's rights_gate + a direction derived
      // from those rights bits.
      //
      // Placement — inside the ipc_bounce_witness push/pop scope
      // (init's r12/r13/r14 remain saved for the downstream
      // enter_userland_initial call). Runs AFTER "R20b SYS IPC SEND OK"
      // so all prior R20b endpoint allocations have been freed.
      //
      // Broker prerequisite state: the M1-003 broker_witness at boot
      // (kernel_main.pdx §broker_witness) already registered "svc.test"
      // -> endpoint_id=7 with rights_gate=0 (the M1-003 svc_register
      // signature does not accept a rights_gate arg — the pack at row+32
      // zeros bytes +33..+39 by construction, per svc_broker.pdx L249-251).
      // This witness patches the existing row in place:
      //   (a) Set endpoint_id to a fresh id from endpoint_alloc so the
      //       minted cap's tail resolves to an actual live endpoint;
      //   (b) Set rights_gate to R_IPC_ALL (0x0B) so the derived
      //       direction is BIDI (both READ and WRITE bits present) and
      //       the minted cap is fully rights-authoritative.
      //
      // The patch uses a single 64-bit store at [row+32], packing
      // endpoint_id in low 16 + rights_gate << 32 in high 32 (matches
      // the paideia-as encoder-pinned "single u64 store covers all
      // three fields" pattern that svc_register itself uses; see
      // svc_broker.pdx L242-248).
      //
      // Sub-tests (numeric stage tracked in _sys_svc_lookup_witness_stage;
      // any failure jumps to sys_svc_lookup_witness_fail with the stage):
      //
      //   0. endpoint_alloc -> r15 = fresh id (post the prior witnesses'
      //      free cleanup, this returns a low id like 0).
      //   1. svc_lookup_row("svc.test", 8) -> r14 = row_pa (from the
      //      M1-003 broker_witness). Non-zero row PA required.
      //   2. Patch row: pack (rights_gate=R_IPC_ALL << 32) | (r15 & 0xFFFF)
      //      into [row+32]. Overwrites endpoint_id (was 7) and
      //      rights_gate (was 0) atomically.
      //   3. Copy "svc.test" (8 bytes) from _svc_broker_witness_name_test
      //      into init's user page @ 0x7FFFFFFFB000 via walker write.
      //   4. sys_svc_lookup_body(0x7FFFFFFFB000, 8) -> r13 = slot id
      //      (must be < 256, else errno).
      //   5. Verify cap_table[slot].kind == 5 (KIND_IPC_ENDPOINT).
      //   6. Verify cap_table[slot].rights == 0x0B (R_IPC_ALL).
      //   7. Verify cap_table[slot].target_ptr's endpoint_id (low 16)
      //      == r15 (fresh id we packed into the row).
      //   8. Verify cap_table[slot].target_ptr's direction (bits 17:16)
      //      == 2 (BIDI, derived from rights_gate = R_IPC_ALL).
      //   9. Negative case: copy "svc.other" (9 bytes; not registered)
      //      into user page, sys_svc_lookup_body(user_va, 9) ->
      //      -ENOENT (0xFFFFFFFFFFFFFFFE).
      //  10. Cleanup: zero the cap slot (kind = KIND_NULL) so subsequent
      //      code sees the slot as free. Also endpoint_free(r15).
      //
      // Register discipline: reuses r15 (fresh endpoint id, survives
      // every sub-test after alloc) — same idiom as sys_ipc_send_witness.
      // r14 stashes the broker row PA across sub-tests 1..2 then is
      // freed. r13 stashes the minted slot id across sub-tests 4..8+10.
      // r12/r13/r14 outside this witness remain saved from the outer
      // ipc_bounce_witness push/pop (r12=r12_outer, etc.); we
      // temporarily reuse r13/r14 within this witness and don't rely
      // on their outer values (init boot state r13=entry_rip and
      // r14=initial_rsp are re-read from r12 via [r12+8]/[r12+24] at
      // enter_userland_initial time, not carried directly). Wait —
      // that's not accurate. Let me re-check: at witness time r12 = init
      // TCB (r12=r12_outer=init), r13 = entry_rip (r13=r13_outer), r14 =
      // initial_rsp (r14=r14_outer). Those are used at
      // enter_userland_initial (line ~11408). This witness clobbers
      // r13/r14 in-place and MUST restore them before returning to the
      // ipc_bounce_witness_done epilogue. Simplest: save/restore
      // r13/r14 via push/pop around this witness.
      // ============================================================
      sys_svc_lookup_witness:
          // Save outer r13/r14 (entry_rip / initial_rsp) which we clobber
          // as scratch within this witness. r15 is also clobbered (holds
          // the fresh endpoint_id here); the outer code doesn't consume
          // r15 after the witness block, so no save needed. r12 (init
          // TCB) stays untouched throughout.
          //
          // Alignment: 2 pushes (r13 + r14) = 16 bytes → %16 == 0 for
          // nested calls (entry was %16 == 0 from the outer 3-push
          // prologue: 8 + 3*8 = 32; 32 + 16 = 48; 48 % 16 == 0). 2 pops
          // restore alignment for the ipc_bounce_witness_done ret path.
          push r13;
          push r14;

          // -- Sub-test 0: alloc a fresh endpoint.
          xor rax, rax;
          lea rcx, [rip + _sys_svc_lookup_witness_stage];
          mov [rcx], rax;                          // stage = 0

          call endpoint_alloc;
          mov r10, 0xFFFFFFFFFFFFFFFF;             // ENDPOINT_ALLOC_NONE
          cmp rax, r10;
          je sys_svc_lookup_witness_fail;
          mov r15, rax;                            // r15 = fresh endpoint_id

          // -- Sub-test 1: locate the existing "svc.test" broker row.
          //    The M1-003 broker_witness (line ~4952) already registered
          //    "svc.test" -> 7 at boot; svc_lookup_row returns its row PA.
          mov rax, 1;
          lea rcx, [rip + _sys_svc_lookup_witness_stage];
          mov [rcx], rax;

          lea rdi, [rip + _svc_broker_witness_name_test];
          mov rsi, 8;                              // name_len
          call svc_lookup_row;                     // rax = row_pa or 0
          cmp rax, 0;
          je sys_svc_lookup_witness_fail;
          mov r14, rax;                            // r14 = row_pa

          // -- Sub-test 2: patch (endpoint_id, rights_gate) via single u64 store.
          //    Pack: (rights_gate=R_IPC_ALL=0x0B) << 32 | (endpoint_id=r15) & 0xFFFF
          //    Same "single u64 store covers +32..+39" pattern svc_register
          //    itself uses (svc_broker.pdx L249-251); reserved u16 at +34
          //    stays zero from the pack.
          mov rax, 2;
          lea rcx, [rip + _sys_svc_lookup_witness_stage];
          mov [rcx], rax;

          mov rax, r15;
          and rax, 0xFFFF;                         // endpoint_id in low 16
          mov r10, 0x0B;                           // R_IPC_ALL
          shl r10, 32;                             // rights_gate in bits 32..63
          or rax, r10;                             // combined pack
          mov [r14 + 32], rax;                     // patch row (endpoint_id | rights_gate)

          // -- Sub-test 3: copy "svc.test" (8 bytes) into init's user page.
          //    Uses the same user_va (0x7FFFFFFFB000) that prior R20b
          //    witnesses have already established as mapped by init's
          //    user_pml4 (user_stack_alloc mapped [0x7FFFFFFFB000,
          //    0x7FFFFFFFF000) — see ipc_bounce_witness for the full
          //    established mapping).
          mov rax, 3;
          lea rcx, [rip + _sys_svc_lookup_witness_stage];
          mov [rcx], rax;

          mov rdi, 0x7FFFFFFFB000;                 // user_va (page start)
          lea rsi, [rip + _svc_broker_witness_name_test];
          mov rdx, 8;                              // "svc.test" is 8 bytes
          call user_write_bytes_via_walk;
          cmp rax, 0;
          jne sys_svc_lookup_witness_fail;

          // -- Sub-test 4: sys_svc_lookup_body(user_va, 8) -> slot id (< 256).
          mov rax, 4;
          lea rcx, [rip + _sys_svc_lookup_witness_stage];
          mov [rcx], rax;

          mov rdi, 0x7FFFFFFFB000;                 // user_name_va
          mov rsi, 8;                              // name_len
          call sys_svc_lookup_body;
          // rax = slot [0..255] on success, or an errno (all with bit 63 set).
          mov r10, 256;
          cmp rax, r10;
          jae sys_svc_lookup_witness_fail;         // errno path
          mov r13, rax;                            // r13 = minted slot id

          // -- Sub-test 5: verify cap_table[slot].kind == KIND_IPC_ENDPOINT (5).
          //    slot_pa = cap_table + slot*24 = cap_table + slot*8 + slot*16
          //    (avoids imul, matches sys_svc_lookup_body's scan pattern).
          mov rax, 5;
          lea rcx, [rip + _sys_svc_lookup_witness_stage];
          mov [rcx], rax;

          mov r10, r13;
          shl r10, 3;                              // slot*8
          mov r11, r13;
          shl r11, 4;                              // slot*16
          add r10, r11;                            // slot*24
          mov rax, cap_table;
          add rax, r10;                            // rax = &cap_table[slot]
          // Save descriptor addr in r11 for the follow-up verifies.
          mov r11, rax;

          mov rax, [r11 + 0];                      // kind
          cmp rax, 5;                              // KIND_IPC_ENDPOINT
          jne sys_svc_lookup_witness_fail;

          // -- Sub-test 6: verify rights == R_IPC_ALL (0x0B).
          mov rax, 6;
          lea rcx, [rip + _sys_svc_lookup_witness_stage];
          mov [rcx], rax;

          mov rax, [r11 + 8];                      // rights
          cmp rax, 0x0B;                           // R_IPC_ALL
          jne sys_svc_lookup_witness_fail;

          // -- Sub-test 7: verify target_ptr's endpoint_id (low 16) == r15.
          mov rax, 7;
          lea rcx, [rip + _sys_svc_lookup_witness_stage];
          mov [rcx], rax;

          mov rax, [r11 + 16];                     // target_ptr (tail)
          and rax, 0xFFFF;                         // endpoint_id
          cmp rax, r15;
          jne sys_svc_lookup_witness_fail;

          // -- Sub-test 8: verify target_ptr's direction (bits 17:16) == BIDI (2).
          //    rights_gate = R_IPC_ALL has both READ (0x01) and WRITE (0x02),
          //    so sys_svc_lookup_body derives ENDPOINT_DIR_BIDI (2).
          mov rax, 8;
          lea rcx, [rip + _sys_svc_lookup_witness_stage];
          mov [rcx], rax;

          mov rax, [r11 + 16];                     // reload tail
          shr rax, 16;                             // direction now in low 2 bits
          and rax, 0x03;
          cmp rax, 2;                              // ENDPOINT_DIR_BIDI
          jne sys_svc_lookup_witness_fail;

          // -- Sub-test 9: negative case — unknown name "svc.other" -> -ENOENT.
          //    _svc_broker_witness_name_other is 9 bytes; not registered
          //    (sub-test F of the M1-003 broker_witness proved it
          //    returns SVC_LOOKUP_NONE).
          mov rax, 9;
          lea rcx, [rip + _sys_svc_lookup_witness_stage];
          mov [rcx], rax;

          // Copy "svc.other" into user page (overwrites the prior "svc.test").
          mov rdi, 0x7FFFFFFFB000;
          lea rsi, [rip + _svc_broker_witness_name_other];
          mov rdx, 9;
          call user_write_bytes_via_walk;
          cmp rax, 0;
          jne sys_svc_lookup_witness_fail;

          mov rdi, 0x7FFFFFFFB000;
          mov rsi, 9;
          call sys_svc_lookup_body;
          mov r10, 0xFFFFFFFFFFFFFFFE;             // -ENOENT sentinel
          cmp rax, r10;
          jne sys_svc_lookup_witness_fail;

          // -- Sub-test 10: cleanup — zero the cap slot + endpoint_free(r15).
          //    Zeroing the descriptor's kind (u64 at +0) marks the slot
          //    as free (kind == KIND_NULL) so any subsequent scan
          //    treats it as available. Zero rights + target_ptr too
          //    for hygiene (a future revoke_cap primitive uses the same
          //    3-word zero pattern).
          mov rax, 10;
          lea rcx, [rip + _sys_svc_lookup_witness_stage];
          mov [rcx], rax;

          // Recompute the descriptor address (r11 may be clobbered by
          // caller-save discipline in the just-completed body call).
          mov r10, r13;
          shl r10, 3;
          mov r11, r13;
          shl r11, 4;
          add r10, r11;                            // slot*24
          mov rax, cap_table;
          add rax, r10;                            // &cap_table[slot]

          xor rcx, rcx;
          mov [rax + 0], rcx;                      // kind = 0 (KIND_NULL)
          mov [rax + 8], rcx;                      // rights = 0
          mov [rax + 16], rcx;                     // target_ptr = 0

          // Free the endpoint. endpoint_free is a leaf primitive
          // (endpoint_table.pdx §endpoint_free) that just zeroes the
          // row; no interaction with cap-table state.
          mov rdi, r15;
          call endpoint_free;

          // Success marker: R20b SVC LOOKUP OK.
          mov rdi, 3;                              // LEVEL_INFO
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + sys_svc_lookup_ok_msg];
          call klog_s1;

          // Restore outer r13/r14 (entry_rip / initial_rsp) before
          // falling into sys_ipc_cap_slot_witness (which does not touch
          // r13/r14 — see R20b.M6-002 witness header). After that witness
          // returns, the ipc_bounce_witness_done epilogue pops the outer
          // r12/r13/r14 saved by ipc_bounce_witness's push scope.
          pop r14;
          pop r13;
          jmp sys_ipc_cap_slot_witness;

      sys_svc_lookup_witness_fail:
          // Emit "R20b SVC LOOKUP FAIL" with sub-test stage as decimal KV.
          lea rax, [rip + _sys_svc_lookup_witness_stage];
          mov r8, [rax];                           // r8 = stage (u64)
          mov rdi, 1;                              // LEVEL_ERROR
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + sys_svc_lookup_fail_msg];
          lea rcx, [rip + k_line];                 // reuse "line" key
          call klog_s1_d1;
          // Restore outer r13/r14 before joining sys_ipc_cap_slot_witness
          // — the enter_userland_initial call after the ipc_bounce_witness_done
          // epilogue expects them intact even on the fail path (a broken
          // SVC LOOKUP witness surfaces via the FAIL fingerprint but does
          // not halt the boot). The downstream witness never blocks or
          // consumes r13/r14; a FAIL there is likewise non-halting.
          pop r14;
          pop r13;
          jmp sys_ipc_cap_slot_witness;

      // ============================================================
      // R20b.M6-002 (#1565): dispatch cap_slot lookup witness.
      //
      // Fifth sub-issue of the R20b.M6 branch — closes the syscall-shim
      // cap-lookup gate that was scaffolded away at R20b.M3-001..003 (see
      // src/kernel/core/syscall/handlers/sys_ipc_recv.pdx §Layer split
      // and the M3-001 witness constraint). Exercises the ipc_slot_to_endpoint
      // helper (src/kernel/core/syscall/dispatch.pdx) via the modified
      // dispatch_ipc_recv shim end-to-end, driving the shim directly via
      // syscall_dispatch (sysno 40) rather than the body — this is the
      // FIRST kernel-side witness that fires the full user_ptr_ok +
      // cap-lookup pipeline on a real cap.
      //
      // Sub-tests (numeric stage tracked in _sys_ipc_cap_slot_witness_stage;
      // any failure jumps to sys_ipc_cap_slot_witness_fail with the stage):
      //
      //   0. endpoint_alloc -> r15 = fresh endpoint id.
      //   1. frame_encode(hdr_scratch, op=0x22, ver=3, flags=0x0007,
      //      payload_len=32) — build a valid packed hdr distinct from the
      //      prior R20b witnesses (op 0x22, ver 3, base pattern 7 — none of
      //      the M3 witnesses use these values, so a mis-wired cross-witness
      //      collision is trivial to spot).
      //   2. Fill 32-byte payload src with (i+7) & 0xFF pattern.
      //   3. endpoint_write_pending(id, hdr, src, 32) — pre-load the message
      //      so the SUCCESS path drains immediately (no sched_block round-
      //      trip; this witness cannot spawn a producer to wake us).
      //   4. cap_mint_write(slot=100, kind=5=KIND_IPC_ENDPOINT, rights=0x0B
      //      = R_IPC_ALL, target_ptr=endpoint_tail_encode(id, BIDI=2))
      //      — install the "good" cap under test at cap_table[100].
      //   5. Pre-wipe init's user page @ 0x7FFFFFFFB000 so a broken shim
      //      that skips writeback surfaces as all-zero on verify.
      //   6. SUCCESS PATH: syscall_dispatch(sysno=40, cap_slot=100,
      //      user_hdr_va=0x7FFFFFFFB000, user_payload_va=0x7FFFFFFFB008,
      //      user_payload_max=32) -> rax == 32. This drives the full
      //      shim: Gate 0 (cap-slot lookup) resolves 100 -> id,
      //      Gate A/B (user_ptr_ok) pass user-half VAs, sys_ipc_recv_body
      //      drains the pending msg via user_bounce_recv (walker
      //      writeback to init's user_pml4).
      //   7. endpoint_is_full(id) == 0 — post-drain, endpoint cleared
      //      (proves the drain reached the endpoint substrate, not just
      //      the cap-lookup helper).
      //   8. NEGATIVE PATH A (empty slot -> -EBADF): cap_table[200] was
      //      never minted (KIND_NULL == 0 from .bss zero-init).
      //      syscall_dispatch(40, 200, ...) -> -EBADF (0xFFFFFFFFFFFFFFF7).
      //   9. NEGATIVE PATH B (wrong-kind slot -> -EBADF): cap_mint_write
      //      slot 101 with kind=8 (KIND_TIMER — an arbitrary non-IPC kind).
      //      syscall_dispatch(40, 101, ...) -> -EBADF.
      //  10. NEGATIVE PATH C (insufficient rights -> -EACCES): cap_mint_write
      //      slot 102 with kind=5 (KIND_IPC_ENDPOINT) but rights=0x02
      //      (R_IPC_WRITE only — missing both R_IPC_READ and R_IPC_INVOKE
      //      that dispatch_ipc_recv requires as R_IPC_READ | R_IPC_INVOKE
      //      = 0x09). syscall_dispatch(40, 102, ...) -> -EACCES
      //      (0xFFFFFFFFFFFFFFF3).
      //  11. Cleanup: zero cap_table[100/101/102] descriptors + endpoint_free(id).
      //
      // Register discipline: r13/r14 (entry_rip / initial_rsp for the
      // downstream enter_userland_initial call) are ALREADY restored to
      // their outer values by the sys_svc_lookup_witness pop-then-jmp
      // that fell into us (both OK and FAIL paths pop r14/r13 before the
      // jump). This witness clobbers only caller-save regs (rax/rcx/rdx/
      // rdi/rsi/r8/r10/r11) plus r15 (endpoint id, holds across sub-tests).
      // r15 is not consumed by init or the ipc_bounce_witness_done epilogue,
      // matching the sys_ipc_recv_witness / sys_ipc_send_witness /
      // sys_svc_lookup_witness convention. No push/pop needed.
      //
      // Alignment: entry rsp %16 == 0 (the outer 3-push at ipc_bounce_witness
      // + sys_svc_lookup_witness's 2-push/2-pop pair leaves rsp at the same
      // offset as entry). Nested calls see %16 == 8 per SysV.
      //
      // Design cross-refs:
      //   design/ipc/userspace-server-substrate.md §5.1 (cap-lookup at sysno layer)
      //   src/kernel/core/syscall/dispatch.pdx §ipc_slot_to_endpoint (the helper)
      //   src/kernel/core/cap/kind_endpoint.pdx §endpoint_tail_encode (target_ptr layout)
      //   src/kernel/core/cap/mint.pdx §cap_mint_write (descriptor write ABI)
      // ============================================================
      sys_ipc_cap_slot_witness:
          // -- Sub-test 0: alloc a fresh endpoint.
          xor rax, rax;
          lea rcx, [rip + _sys_ipc_cap_slot_witness_stage];
          mov [rcx], rax;                          // stage = 0

          call endpoint_alloc;
          mov r10, 0xFFFFFFFFFFFFFFFF;             // ENDPOINT_ALLOC_NONE
          cmp rax, r10;
          je sys_ipc_cap_slot_witness_fail;
          mov r15, rax;                            // r15 = fresh endpoint id

          // -- Sub-test 1: build hdr via frame_encode.
          //    op=0x22, ver=3, flags=0x0007, payload_len=32. Values chosen
          //    distinct from every prior R20b witness's hdr to make cross-
          //    witness contamination obvious in the wire trace.
          mov rax, 1;
          lea rcx, [rip + _sys_ipc_cap_slot_witness_stage];
          mov [rcx], rax;

          lea rdi, [rip + _sys_ipc_cap_slot_witness_hdr_scratch];
          mov rsi, 0x22;                           // op
          mov rdx, 3;                              // ver (>= 1 so hdr != 0)
          mov rcx, 0x0007;                         // flags
          mov r8, 32;                              // payload_len
          call frame_encode;
          cmp rax, 0;                              // FRAME_ENCODE_OK
          jne sys_ipc_cap_slot_witness_fail;

          // -- Sub-test 2: fill 32-byte src with (i+7) & 0xFF pattern.
          mov rax, 2;
          lea rcx, [rip + _sys_ipc_cap_slot_witness_stage];
          mov [rcx], rax;

          lea r10, [rip + _sys_ipc_cap_slot_witness_src];
          xor r11, r11;
      sicsw_src_loop:
          cmp r11, 32;
          je sicsw_src_done;
          mov rax, r11;
          add rax, 7;                              // pattern base 7
          and rax, 0xFF;
          mov_b [r10 + r11*1], rax;
          add r11, 1;
          jmp sicsw_src_loop;
      sicsw_src_done:

          // -- Sub-test 3: publish via endpoint_write_pending (kernel-VA
          //    primitive; no walker on this side, mirrors the sys_ipc_recv_
          //    witness §sub-test 3 pattern).
          mov rax, 3;
          lea rcx, [rip + _sys_ipc_cap_slot_witness_stage];
          mov [rcx], rax;

          mov rdi, r15;                            // id
          lea r10, [rip + _sys_ipc_cap_slot_witness_hdr_scratch];
          mov rsi, [r10];                          // hdr (u64)
          lea rdx, [rip + _sys_ipc_cap_slot_witness_src];
          mov rcx, 32;                             // payload_len
          call endpoint_write_pending;
          cmp rax, 0;                              // PENDING_WRITE_OK
          jne sys_ipc_cap_slot_witness_fail;

          // -- Sub-test 4: mint KIND_IPC_ENDPOINT cap at slot 100.
          //    tail = endpoint_tail_encode(id, ENDPOINT_DIR_BIDI = 2).
          //    rights = R_IPC_ALL (0x0B) so the shim's required mask
          //    R_IPC_READ | R_IPC_INVOKE (0x09) is a strict subset — the
          //    (rights & required) == required check trivially passes.
          mov rax, 4;
          lea rcx, [rip + _sys_ipc_cap_slot_witness_stage];
          mov [rcx], rax;

          mov rdi, r15;                            // arg0 = endpoint_id
          mov rsi, 2;                              // arg1 = ENDPOINT_DIR_BIDI
          call endpoint_tail_encode;               // rax = tail
          mov r11, rax;                            // r11 = tail (across mint call)

          mov rdi, 100;                            // slot
          mov rsi, 5;                              // KIND_IPC_ENDPOINT
          mov rdx, 0x0B;                           // rights = R_IPC_ALL
          mov rcx, r11;                            // target_ptr = tail
          call cap_mint_write;                     // void return

          // -- Sub-test 5: pre-wipe init's user page @ 0x7FFFFFFFB000.
          mov rax, 5;
          lea rcx, [rip + _sys_ipc_cap_slot_witness_stage];
          mov [rcx], rax;

          mov rdi, 0x7FFFFFFFB000;                 // user_va (page start)
          lea rsi, [rip + _sys_ipc_cap_slot_witness_zero_scratch];
          mov rdx, 4096;
          call user_write_bytes_via_walk;
          cmp rax, 0;
          jne sys_ipc_cap_slot_witness_fail;

          // -- Sub-test 6: SUCCESS PATH — drive syscall_dispatch(40, 100, ...).
          //    This is the first witness that exercises the shim (not the
          //    body). SysV: rdi=sysno=40, rsi=cap_slot=100, rdx=user_hdr_va,
          //    rcx=user_payload_va, r8=user_payload_max. Expected rax == 32
          //    (payload_len of the pre-loaded msg).
          mov rax, 6;
          lea rcx, [rip + _sys_ipc_cap_slot_witness_stage];
          mov [rcx], rax;

          mov rdi, 40;                             // SYS_IPC_RECV
          mov rsi, 100;                            // cap_slot
          mov rdx, 0x7FFFFFFFB000;                 // user_hdr_va
          mov rcx, 0x7FFFFFFFB008;                 // user_payload_va
          mov r8, 32;                              // user_payload_max
          call syscall_dispatch;
          cmp rax, 32;                             // expected payload_len
          jne sys_ipc_cap_slot_witness_fail;

          // -- Sub-test 7: endpoint_is_full(id) == 0 post-drain.
          mov rax, 7;
          lea rcx, [rip + _sys_ipc_cap_slot_witness_stage];
          mov [rcx], rax;

          mov rdi, r15;
          call endpoint_is_full;
          cmp rax, 0;
          jne sys_ipc_cap_slot_witness_fail;

          // -- Sub-test 8: NEGATIVE PATH A — empty slot -> -EBADF.
          //    cap_table[200] is untouched by any prior mint; its .bss
          //    zero-init leaves kind == KIND_NULL == 0, which the helper's
          //    "kind != 5" gate rejects with -EBADF (matches POSIX EBADF
          //    for "fd not open"). User pointers are still valid so the
          //    error unambiguously comes from Gate 0, not user_ptr_ok.
          mov rax, 8;
          lea rcx, [rip + _sys_ipc_cap_slot_witness_stage];
          mov [rcx], rax;

          mov rdi, 40;
          mov rsi, 200;                            // empty cap slot
          mov rdx, 0x7FFFFFFFB000;
          mov rcx, 0x7FFFFFFFB008;
          mov r8, 32;
          call syscall_dispatch;
          mov r10, 0xFFFFFFFFFFFFFFF7;             // -EBADF
          cmp rax, r10;
          jne sys_ipc_cap_slot_witness_fail;

          // -- Sub-test 9: NEGATIVE PATH B — wrong-kind slot -> -EBADF.
          //    Mint KIND_TIMER (8) at slot 101. Timer caps aren't IPC
          //    endpoints, so the helper's kind check rejects with -EBADF.
          //    rights = 0x0B is generous (would satisfy any IPC required
          //    mask), so ONLY the kind branch fires — proves kind check
          //    is upstream of rights check in the helper.
          mov rax, 9;
          lea rcx, [rip + _sys_ipc_cap_slot_witness_stage];
          mov [rcx], rax;

          mov rdi, 101;                            // slot
          mov rsi, 8;                              // KIND_TIMER
          mov rdx, 0x0B;                           // rights (irrelevant here)
          xor rcx, rcx;                            // target_ptr = 0
          call cap_mint_write;

          mov rdi, 40;
          mov rsi, 101;
          mov rdx, 0x7FFFFFFFB000;
          mov rcx, 0x7FFFFFFFB008;
          mov r8, 32;
          call syscall_dispatch;
          mov r10, 0xFFFFFFFFFFFFFFF7;             // -EBADF
          cmp rax, r10;
          jne sys_ipc_cap_slot_witness_fail;

          // -- Sub-test 10: NEGATIVE PATH C — insufficient rights -> -EACCES.
          //    Mint KIND_IPC_ENDPOINT at slot 102 with rights = R_IPC_WRITE
          //    (0x02) only. dispatch_ipc_recv requires R_IPC_READ |
          //    R_IPC_INVOKE = 0x09. (0x02 & 0x09) == 0x00 != 0x09 -> the
          //    (rights & required) == required check fails -> -EACCES.
          //    Proves the rights branch is reachable (kind is valid, only
          //    rights fails).
          mov rax, 10;
          lea rcx, [rip + _sys_ipc_cap_slot_witness_stage];
          mov [rcx], rax;

          // Reuse the tail encoding — direction bits are irrelevant to
          // this witness (the helper does not check direction).
          mov rdi, r15;
          mov rsi, 1;                              // ENDPOINT_DIR_RECV (arbitrary)
          call endpoint_tail_encode;
          mov r11, rax;

          mov rdi, 102;                            // slot
          mov rsi, 5;                              // KIND_IPC_ENDPOINT
          mov rdx, 0x02;                           // rights = R_IPC_WRITE only
          mov rcx, r11;                            // target_ptr = tail
          call cap_mint_write;

          mov rdi, 40;
          mov rsi, 102;
          mov rdx, 0x7FFFFFFFB000;
          mov rcx, 0x7FFFFFFFB008;
          mov r8, 32;
          call syscall_dispatch;
          mov r10, 0xFFFFFFFFFFFFFFF3;             // -EACCES
          cmp rax, r10;
          jne sys_ipc_cap_slot_witness_fail;

          // -- Sub-test 11: cleanup — zero cap_table[100..102] descriptors
          //    (3 * 24 bytes = 72 bytes starting at cap_table + 100*24 =
          //    cap_table + 2400) and endpoint_free(r15).
          mov rax, 11;
          lea rcx, [rip + _sys_ipc_cap_slot_witness_stage];
          mov [rcx], rax;

          mov rax, cap_table;
          add rax, 2400;                           // = 100 * 24
          xor rcx, rcx;
          mov [rax + 0], rcx;                      // slot 100 kind
          mov [rax + 8], rcx;                      // slot 100 rights
          mov [rax + 16], rcx;                     // slot 100 target_ptr
          mov [rax + 24], rcx;                     // slot 101 kind
          mov [rax + 32], rcx;                     // slot 101 rights
          mov [rax + 40], rcx;                     // slot 101 target_ptr
          mov [rax + 48], rcx;                     // slot 102 kind
          mov [rax + 56], rcx;                     // slot 102 rights
          mov [rax + 64], rcx;                     // slot 102 target_ptr

          mov rdi, r15;
          call endpoint_free;

          // Success marker: R20b IPC CAP SLOT OK.
          mov rdi, 3;                              // LEVEL_INFO
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + sys_ipc_cap_slot_ok_msg];
          call klog_s1;
          jmp ipc_bounce_witness_done;

      sys_ipc_cap_slot_witness_fail:
          // Emit "R20b IPC CAP SLOT FAIL" with sub-test stage as decimal KV.
          lea rax, [rip + _sys_ipc_cap_slot_witness_stage];
          mov r8, [rax];                           // r8 = stage (u64)
          mov rdi, 1;                              // LEVEL_ERROR
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + sys_ipc_cap_slot_fail_msg];
          lea rcx, [rip + k_line];                 // reuse "line" key
          call klog_s1_d1;
          jmp ipc_bounce_witness_done;

      ipc_bounce_witness_fail:
          // Emit "R20b IPC BOUNCE FAIL" with the sub-test stage as decimal KV.
          lea rax, [rip + _ipc_bounce_witness_stage];
          mov r8, [rax];                           // r8 = stage (u64)
          mov rdi, 1;                              // LEVEL_ERROR
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + ipc_bounce_fail_msg];
          lea rcx, [rip + k_line];                 // reuse "line" key
          call klog_s1_d1;

      ipc_bounce_witness_done:
      pop r14;
      pop r13;
      pop r12;

      // ============================================================
      // R20b.M4-001 (#1561): InitCap sidecar format + validator witness.
      //
      // First sub-issue of the R20b.M4 (loader capability-seed hook)
      // branch — opens M4. Exercises init_caps_validate
      // (src/kernel/core/loader/init_caps.pdx) against a hand-authored
      // 2-entry sidecar synthesized in kernel .bss
      // (_init_caps_witness_sidecar). Runs AFTER ipc_bounce_witness_done
      // pops r12/r13/r14 to their outer init-bootstrap values (needed
      // by the enter_userland_initial call below) and BEFORE `sti`
      // (still safe kernel state).
      //
      // Sidecar layout (48 bytes = 16 header + 2 * 16 entries; see
      // design/loader/init-caps-sidecar.md §3):
      //   [+ 0] header word 0: count = 2 (u16 in low 16 bits) + pad
      //   [+ 8] header word 1: 14-byte padding (upper part) + last 8
      //   [+16] entry 0 word 0: (rights<<32) | (kind<<16) | slot
      //   [+24] entry 0 word 1: target_ptr
      //   [+32] entry 1 word 0
      //   [+40] entry 1 word 1
      //
      // Sub-tests (stage tracked in _init_caps_witness_stage; any
      // failure jumps to init_caps_witness_fail with the stage):
      //
      //   0. Populate sidecar with two well-formed entries:
      //        entry 0: slot=1,  kind=KIND_IPC_ENDPOINT(5), rights=R_IPC_ALL(0x0B)
      //        entry 1: slot=10, kind=KIND_DMESG(0x16),     rights=RIGHT_READ(0x01)
      //      Call init_caps_validate(sidecar, 48) — expect 0.
      //
      //   1. Malformed count (BAD_COUNT): call with image_len=8, which
      //      is less than the 16-byte header — validator's header-bounds
      //      gate fires. Expect 0xFFFFFFFF.
      //
      //   2. Out-of-range slot (BAD_SLOT): repack entry 0's word 0 with
      //      slot=256 (== INIT_CAP_SLOT_MAX; first out-of-range value).
      //      Expect 0xFFFFFFFE. Restore entry 0 for sub-test 3.
      //
      //   3. Unknown kind (BAD_KIND): repack entry 0's word 0 with
      //      kind=17 (0x11 — not in {0..15, 0x15 KIND_DRIVER,
      //      0x16 KIND_DMESG}). Expect 0xFFFFFFFD.
      //
      // Register discipline: init_caps_validate + klog_s1 both preserve
      // SysV callee-save regs (r12-r15), so r12/r13/r14 stay live for
      // the enter_userland_initial call below without push/pop. Uses
      // rax/rcx/rdx/rdi/rsi/r8/r10/r11 (caller-save) as scratch; r15
      // untouched. Every sub-test writes _init_caps_witness_stage
      // before doing anything else so a fail path prints which sub-test
      // tripped via klog_s1_d1's "line" key.
      // ============================================================
      init_caps_witness:
          // -- Sub-test 0: accept path — 2 well-formed entries.
          xor rax, rax;
          lea rcx, [rip + _init_caps_witness_stage];
          mov [rcx], rax;                          // stage = 0

          // Populate sidecar in-place. All stores are aligned u64
          // writes into a [u64; 6] buffer; no unaligned traffic.
          lea r10, [rip + _init_caps_witness_sidecar];
          mov rax, 2;                              // count = 2 (low 16 bits of word 0)
          mov [r10 + 0], rax;                      // header word 0
          xor rax, rax;
          mov [r10 + 8], rax;                      // header word 1 (padding)

          // Entry 0: slot=1, kind=5 (KIND_IPC_ENDPOINT), rights=0x0B (R_IPC_ALL)
          //   pack = (0x0B << 32) | (5 << 16) | 1 = 0x0000000B00050001
          mov rax, 0x0000000B00050001;
          mov [r10 + 16], rax;
          xor rax, rax;
          mov [r10 + 24], rax;                     // target_ptr = 0

          // Entry 1: slot=10, kind=0x16 (KIND_DMESG), rights=0x01 (RIGHT_READ)
          //   pack = (0x01 << 32) | (0x16 << 16) | 10 = 0x000000010016000A
          mov rax, 0x000000010016000A;
          mov [r10 + 32], rax;
          xor rax, rax;
          mov [r10 + 40], rax;                     // target_ptr = 0

          // init_caps_validate(sidecar, 48) — expect INIT_CAPS_OK (0).
          lea rdi, [rip + _init_caps_witness_sidecar];
          mov rsi, 48;                             // 16 header + 2 * 16 entries
          call init_caps_validate;
          cmp rax, 0;
          jne init_caps_witness_fail;

          // -- Sub-test 1: BAD_COUNT (image_len < 16 header).
          mov rax, 1;
          lea rcx, [rip + _init_caps_witness_stage];
          mov [rcx], rax;

          lea rdi, [rip + _init_caps_witness_sidecar];
          mov rsi, 8;                              // header truncated
          call init_caps_validate;
          mov r10, 0xFFFFFFFF;                     // INIT_CAPS_BAD_COUNT
          cmp rax, r10;
          jne init_caps_witness_fail;

          // -- Sub-test 2: BAD_SLOT (patch entry 0 slot -> 256).
          mov rax, 2;
          lea rcx, [rip + _init_caps_witness_stage];
          mov [rcx], rax;

          // Repack entry 0 word 0 with slot=256:
          //   (0x0B << 32) | (5 << 16) | 256 = 0x0000000B00050100
          lea r10, [rip + _init_caps_witness_sidecar];
          mov rax, 0x0000000B00050100;
          mov [r10 + 16], rax;

          lea rdi, [rip + _init_caps_witness_sidecar];
          mov rsi, 48;
          call init_caps_validate;
          mov r10, 0xFFFFFFFE;                     // INIT_CAPS_BAD_SLOT
          cmp rax, r10;
          jne init_caps_witness_fail;

          // Restore entry 0 for sub-test 3.
          lea r10, [rip + _init_caps_witness_sidecar];
          mov rax, 0x0000000B00050001;
          mov [r10 + 16], rax;

          // -- Sub-test 3: BAD_KIND (patch entry 0 kind -> 17).
          mov rax, 3;
          lea rcx, [rip + _init_caps_witness_stage];
          mov [rcx], rax;

          // Repack entry 0 word 0 with kind=17 (0x11 — not in accept set):
          //   (0x0B << 32) | (0x11 << 16) | 1 = 0x0000000B00110001
          lea r10, [rip + _init_caps_witness_sidecar];
          mov rax, 0x0000000B00110001;
          mov [r10 + 16], rax;

          lea rdi, [rip + _init_caps_witness_sidecar];
          mov rsi, 48;
          call init_caps_validate;
          mov r10, 0xFFFFFFFD;                     // INIT_CAPS_BAD_KIND
          cmp rax, r10;
          jne init_caps_witness_fail;

          // Success marker: R20b INIT CAPS FMT OK.
          mov rdi, 3;                              // LEVEL_INFO
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + init_caps_ok_msg];
          call klog_s1;
          jmp init_caps_witness_done;

      init_caps_witness_fail:
          // Emit "R20b INIT CAPS FMT FAIL" with the sub-test stage
          // as a decimal KV. Falls through into init_caps_witness_done
          // so the boot still proceeds to enter_userland_initial (a
          // broken format-validator surfaces via the FAIL fingerprint
          // but does not halt the boot).
          lea rax, [rip + _init_caps_witness_stage];
          mov r8, [rax];                           // r8 = stage (u64)
          mov rdi, 1;                              // LEVEL_ERROR
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + init_caps_fail_msg];
          lea rcx, [rip + k_line];                 // reuse "line" key
          call klog_s1_d1;

      init_caps_witness_done:

      // ============================================================
      // R20b.M4-002 (#1562): loader_seed_caps hook witness — closes M4.
      //
      // Exercises loader_seed_caps (src/kernel/core/loader/seed_caps.pdx)
      // — the caller that binds init_caps_validate (M4-001) to
      // cap_mint_write (cap/mint.pdx). Synthesizes a fake task struct
      // + a 1-entry sidecar directly in .bss (bypasses ELF walking;
      // the elf_lite_load wire-in itself uses the empty
      // _loader_seed_empty_sidecar).
      //
      // Sub-tests (numeric stage tracked in _loader_seed_witness_stage;
      // any failure jumps to loader_seed_witness_fail with the stage):
      //
      //   0. ACCEPT path — 1-entry sidecar:
      //        slot   = 5
      //        kind   = KIND_TIMER (8)
      //        rights = RIGHT_INVOKE (0x08)
      //        target_ptr = 0
      //      Call loader_seed_caps(fake_task, sidecar, 32). Expect
      //      LOADER_SEED_OK (0). Read back cap_table[5] and assert
      //      kind == 8, rights == 0x08, target_ptr == 0.
      //
      //   1. REJECT path — malformed count (0xFFFF too large):
      //      Patch sidecar header word 0 to count=0xFFFF. Call
      //      loader_seed_caps(fake_task, sidecar, 32). Expect
      //      LOADER_SEED_FAILED (0xFFFFFFF9). Verify cap_table[5]
      //      remained unchanged from sub-test 0 (kind still == 8) —
      //      proves fail-fast: no partial mint occurred.
      //
      // Slot 5 chosen distinct from every existing witness slot:
      //   0=cap_smoke, 1..8=cap_dispatch_smoke, 10=dmesg_cap_witness,
      //   11=endpoint_cap_witness. Slot 5 is clean.
      //
      // Placement: AFTER init_caps_witness_done (M4-001 close) and
      // BEFORE sti (still safe kernel state, no ISR racing). Uses
      // caller-save scratch only so r12/r13/r14 (init boot state)
      // stay live for the enter_userland_initial call below.
      //
      // Register discipline: loader_seed_caps + klog_s1 both preserve
      // SysV callee-save regs (r12-r15). Uses rax/rcx/rdx/rdi/rsi/r8
      // (caller-save) as scratch; r15 untouched.
      // ============================================================
      loader_seed_witness:
          // -- Sub-test 0: ACCEPT path.
          xor rax, rax;
          lea rcx, [rip + _loader_seed_witness_stage];
          mov [rcx], rax;                          // stage = 0

          // Populate sidecar. 4 u64s = 32 bytes = 16 header + 1 entry.
          // Header: count=1 in low 16 bits of word 0; word 1 padding.
          lea r10, [rip + _loader_seed_witness_sidecar];
          mov rax, 1;                              // count = 1
          mov [r10 + 0], rax;                      // header word 0
          xor rax, rax;
          mov [r10 + 8], rax;                      // header word 1 (padding)

          // Entry 0: slot=5, kind=8 (KIND_TIMER), rights=0x08 (RIGHT_INVOKE)
          //   pack = (0x08 << 32) | (8 << 16) | 5 = 0x0000000800080005
          mov rax, 0x0000000800080005;
          mov [r10 + 16], rax;
          xor rax, rax;
          mov [r10 + 24], rax;                     // target_ptr = 0

          // loader_seed_caps(fake_task, sidecar, 32).
          //   task_ptr unused at R20b — pass address of fake TCB blob
          //   so a per-task-cap_table forward-port sees a live pointer
          //   (rather than 0) in the witness log if it lands later.
          lea rdi, [rip + _loader_seed_witness_fake_task];
          lea rsi, [rip + _loader_seed_witness_sidecar];
          mov rdx, 32;                             // 16 header + 1 * 16 entry
          call loader_seed_caps;
          cmp rax, 0;                              // LOADER_SEED_OK
          jne loader_seed_witness_fail;

          // Read-back: cap_table[5] descriptor at base + 5*24 = +120.
          // Layout: [+0]=kind, [+8]=rights, [+16]=target_ptr.
          mov rax, cap_table;
          add rax, 120;                            // slot 5 * 24 bytes
          mov rcx, [rax + 0];                      // kind
          cmp rcx, 8;                              // KIND_TIMER
          jne loader_seed_witness_fail;
          mov rcx, [rax + 8];                      // rights
          cmp rcx, 0x08;                           // RIGHT_INVOKE
          jne loader_seed_witness_fail;
          mov rcx, [rax + 16];                     // target_ptr
          cmp rcx, 0;
          jne loader_seed_witness_fail;

          // -- Sub-test 1: REJECT path (BAD_COUNT via count=0xFFFF).
          mov rax, 1;
          lea rcx, [rip + _loader_seed_witness_stage];
          mov [rcx], rax;                          // stage = 1

          // Patch header word 0 to count=0xFFFF: 0xFFFF entries would
          // need 16 + 0xFFFF*16 = 0xFFFF0 bytes >> sidecar_len=32.
          // init_caps_validate's array-bounds gate returns
          // INIT_CAPS_BAD_COUNT -> loader_seed_caps returns
          // LOADER_SEED_FAILED. No cap_mint_write executes.
          lea r10, [rip + _loader_seed_witness_sidecar];
          mov rax, 0xFFFF;
          mov [r10 + 0], rax;

          lea rdi, [rip + _loader_seed_witness_fake_task];
          lea rsi, [rip + _loader_seed_witness_sidecar];
          mov rdx, 32;
          call loader_seed_caps;
          mov r10, 0xFFFFFFF9;                     // LOADER_SEED_FAILED
          cmp rax, r10;
          jne loader_seed_witness_fail;

          // Fail-fast invariant: cap_table[5] must still hold sub-test
          // 0's descriptor (kind=8). If sub-test 1 had partially minted
          // before failing, kind would be overwritten (or cleared to 0
          // by a KIND_NULL rewrite path). Sub-test 1's REJECT path
          // never reaches cap_mint_write, so kind stays 8.
          mov rax, cap_table;
          add rax, 120;
          mov rcx, [rax + 0];
          cmp rcx, 8;                              // KIND_TIMER, unchanged
          jne loader_seed_witness_fail;

          // Success marker: R20b LOADER SEED OK.
          mov rdi, 3;                              // LEVEL_INFO
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + loader_seed_ok_msg];
          call klog_s1;
          jmp loader_seed_witness_done;

      loader_seed_witness_fail:
          // Emit "R20b LOADER SEED FAIL" with the sub-test stage
          // as a decimal KV. Falls through into loader_seed_witness_done
          // so the boot still proceeds to enter_userland_initial (a
          // broken seed hook surfaces via the FAIL fingerprint but
          // does not halt the boot). Matches the init_caps_witness_fail
          // idiom immediately above.
          lea rax, [rip + _loader_seed_witness_stage];
          mov r8, [rax];                           // r8 = stage (u64)
          mov rdi, 1;                              // LEVEL_ERROR
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + loader_seed_fail_msg];
          lea rcx, [rip + k_line];                 // reuse "line" key
          call klog_s1_d1;

      loader_seed_witness_done:

      // ============================================================
      // R20b.M6-001 (#1564): loader phase-2 ELF-symbol walker witness.
      //
      // Retires the M4-002 (#1562) deferral by driving a REAL
      // elf_lite_load call against echo_server.elf — the only image
      // currently embedded that declares an `_init_caps` /
      // `_init_caps_count` sidecar (src/user/echo_server.pdx §_init_caps
      // sidecar) — and asserting the walker resolved the two symbols,
      // colocated them into loader_seed_caps_from_symtab's sidecar
      // scratch, and delegated to loader_seed_caps for the mint.
      //
      // Sub-tests (numeric stage tracked in _m6_symtab_witness_stage;
      // any failure jumps to m6_symtab_witness_fail with the stage):
      //
      //   0. task_new(NULL) -> fresh task slab (spilled to
      //      _m6_symtab_witness_task .bss so r12/r13/r14 stay live for
      //      the downstream m5_echo_witness + enter_userland_initial).
      //   1. Pre-clean cap_table[0] (kind=0/rights=0/target=0) so a
      //      broken walker (that would fail to mint) is distinguishable
      //      from a working walker (that mints kind=5). Without the
      //      pre-clean, cap_smoke's kind=15 (already in slot 0 from B5-005
      //      boot) would be indistinguishable from a no-op walker
      //      followed by a KIND_IPC_ENDPOINT read of the wrong bytes.
      //   2. elf_lite_load(fresh_pml4, _echo_server_bin_start,
      //      _echo_server_bin_end - _echo_server_bin_start) -> ELF_OK (0).
      //      This EXERCISES the new elf_load_done -> loader_seed_caps_from_symtab
      //      wire-in for the first time in the boot chain (init.elf was
      //      loaded earlier by init_bootstrap and hits the "no _init_caps"
      //      no-mint branch since init declares no sidecar).
      //   3. Assert cap_table[0].kind == 5 (KIND_IPC_ENDPOINT per
      //      cap/kind.pdx). Proves the walker resolved _init_caps,
      //      colocated correctly, and loader_seed_caps ran cap_mint_write.
      //   4. Assert cap_table[0].rights == 0x0B (R_IPC_ALL = READ|WRITE|
      //      INVOKE per kind_endpoint.pdx and echo_server.pdx L72). Proves
      //      the rights field survived the colocate memcpy at the right
      //      byte offset (+4 within the entry, +20 within the scratch).
      //   5. Assert cap_table[0].target_ptr == 0x20001. Proves the u64
      //      target survived at entry+8 / scratch+24, natural alignment.
      //      Value = endpoint_id 1 (bits 0..15) | direction BIDI 2
      //      (bits 16..17) per echo_server.pdx L76-88 packing.
      //
      // Design context
      // --------------
      // Placement: AFTER loader_seed_witness_done (M4-002 close, verifies
      // the loader_seed_caps primitive in isolation) and BEFORE
      // m5_echo_witness (which does its own svc_lookup mint into
      // cap_table). If this witness didn't mint into slot 0, the M5
      // witness's free-slot scan would pick slot 0 for its svc.echo cap;
      // WITH this witness landed, cap_table[0] holds echo_server's
      // seeded endpoint cap and M5's svc_lookup skips to slot 1. Both
      // ordering shapes are OK by construction: M5's witness only
      // checks `slot_id < 256` (kernel_main.pdx §m5_echo_witness §sub-test 2),
      // not a specific slot number, so a shifted allocation still passes.
      //
      // Task teardown
      // -------------
      // The fresh task is intentionally NOT enqueued: no runq_enqueue
      // call, and the task slab holder is scoped to .bss dead storage
      // (_m6_symtab_witness_task). sched_pick_next_r15 therefore cannot
      // return this task; the aspace it holds is inert until the R21+
      // task recycler lands. Same "witness allocates but never schedules"
      // discipline as init_bootstrap_witness's r12 slab (before init is
      // explicitly enqueued at kernel_main.pdx L10373).
      //
      // Register discipline
      // -------------------
      // r12/r13/r14 MUST stay untouched (init boot state; see
      // m5_echo_witness's §Register discipline comment at kernel_main.pdx
      // §12122). All uses of "task slab" go via the .bss holder rather
      // than a callee-save register. Nested calls (task_new, elf_lite_load,
      // klog_s1) all preserve r12-r15 + rbx per SysV; caller-save
      // scratch (rax/rcx/rdx/rdi/rsi/r8/r10) is fair game.
      //
      // rsp alignment: entry to m6_symtab_witness is at rsp %16 == 8
      // (SysV entry state; outer prologue's 3 pushes were popped at
      // ipc_bounce_witness_done). Nested `call`s from here therefore
      // land in their callees at rsp %16 == 8 -> aligned.
      // ============================================================
      m6_symtab_witness:
          // -- Sub-test 0: task_new(NULL) — fresh task slab.
          xor rax, rax;
          lea rcx, [rip + _m6_symtab_witness_stage];
          mov [rcx], rax;                          // stage = 0

          xor rdi, rdi;                            // parent = NULL
          call task_new;
          cmp rax, 0;
          je m6_symtab_witness_fail;
          // Spill fresh task slab to .bss (r12/r13/r14 must stay = init
          // state — see §Register discipline above).
          lea rcx, [rip + _m6_symtab_witness_task];
          mov [rcx], rax;

          // -- Sub-test 1: pre-clean cap_table[0] (kind/rights/target = 0).
          mov rax, 1;
          lea rcx, [rip + _m6_symtab_witness_stage];
          mov [rcx], rax;

          mov rax, cap_table;                      // &cap_table[0]
          xor rcx, rcx;
          mov [rax + 0], rcx;                      // kind = 0
          mov [rax + 8], rcx;                      // rights = 0
          mov [rax + 16], rcx;                     // target_ptr = 0

          // -- Sub-test 2: elf_lite_load(fresh_pml4, echo_server.elf).
          mov rax, 2;
          lea rcx, [rip + _m6_symtab_witness_stage];
          mov [rcx], rax;

          lea rcx, [rip + _m6_symtab_witness_task];
          mov rcx, [rcx];                          // rcx = fresh task slab
          mov rdi, [rcx + 16];                     // rdi = user_pml4_pa (VA form)
          lea rsi, [rip + _echo_server_bin_start];
          lea rax, [rip + _echo_server_bin_end];
          sub rax, rsi;
          mov rdx, rax;                            // rdx = image_len
          call elf_lite_load;
          cmp rax, 0;                              // ELF_OK
          jne m6_symtab_witness_fail;

          // -- Sub-test 3: assert cap_table[0].kind == 5 (KIND_IPC_ENDPOINT).
          mov rax, 3;
          lea rcx, [rip + _m6_symtab_witness_stage];
          mov [rcx], rax;

          mov rax, cap_table;                      // slot 0 base
          mov rcx, [rax + 0];                      // kind (u64 @+0)
          cmp rcx, 5;                              // KIND_IPC_ENDPOINT
          jne m6_symtab_witness_fail;

          // -- Sub-test 4: assert cap_table[0].rights == 0x0B (R_IPC_ALL).
          mov rax, 4;
          lea rcx, [rip + _m6_symtab_witness_stage];
          mov [rcx], rax;

          mov rax, cap_table;
          mov rcx, [rax + 8];                      // rights (u64 @+8)
          cmp rcx, 0x0B;                           // R_IPC_ALL
          jne m6_symtab_witness_fail;

          // -- Sub-test 5: assert cap_table[0].target_ptr == 0x20001.
          mov rax, 5;
          lea rcx, [rip + _m6_symtab_witness_stage];
          mov [rcx], rax;

          mov rax, cap_table;
          mov rcx, [rax + 16];                     // target_ptr (u64 @+16)
          mov r10, 0x20001;                        // endpoint_id 1 | dir BIDI (2)
          cmp rcx, r10;
          jne m6_symtab_witness_fail;

          // -- Cleanup: task_free(fresh_task) — release the pid slot,
          //    tear down the aspace, zero the slab. Without this, init's
          //    first fork picks up the NEXT free PID (== 3 instead of the
          //    expected 2), which the boot_r17_shell_* fingerprints assert
          //    against. Same discipline as sys_wait_body's pid_free after
          //    reaping a zombie: the task never runs, but its PID slot
          //    stays allocated until explicitly freed, contaminating the
          //    dense-low-first pid_alloc scan for every subsequent
          //    task_new. task_free (task_pool.pdx §task_free) is the
          //    thorough teardown primitive: aspace_teardown -> rep stosq
          //    slab-zero -> pid_free(pid). We ignore its rax (always 0
          //    at R15.M5).
          lea rax, [rip + _m6_symtab_witness_task];
          mov rdi, [rax];
          call task_free;

          // Success marker: R20b LOADER SYMTAB SEED OK.
          mov rdi, 3;                              // LEVEL_INFO
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + loader_symtab_seed_ok_msg];
          call klog_s1;
          jmp m6_symtab_witness_done;

      m6_symtab_witness_fail:
          // Emit "R20b LOADER SYMTAB SEED FAIL line=<stage>" — same
          // fingerprint idiom as loader_seed_witness_fail (M4-002)
          // and m5_echo_witness_fail (M5-001) directly below.
          lea rax, [rip + _m6_symtab_witness_stage];
          mov r8, [rax];                           // r8 = stage
          mov rdi, 1;                              // LEVEL_ERROR
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + loader_symtab_seed_fail_msg];
          lea rcx, [rip + k_line];                 // reuse "line" key
          call klog_s1_d1;

      m6_symtab_witness_done:

      // ============================================================
      // R20b.M5-001 (#1563): echo-server end-to-end closure witness — closes R20b.M5.
      //
      // This witness proves M1..M4 compose correctly by driving a full
      // request/reply roundtrip over the substrate. Kernel-driven against
      // init's user_pml4 (same discipline as R20b.M2/M3 witnesses) rather
      // than spawning src/user/echo_server.pdx as a userspace task at
      // R20b.M5, because:
      //
      //   (a) The loader-side symbol walker for `_init_caps` /
      //       `_init_caps_count` is deferred (design/loader/init-caps-
      //       sidecar.md §5 phase-1 + src/kernel/core/loader/seed_caps.pdx
      //       §Phase-1 sidecar placement); without it a spawned echo_server
      //       cannot receive its endpoint cap.
      //   (b) The M3 dispatch shims treat their first arg as a raw
      //       endpoint_id, not a cap_slot (per dispatch.pdx §dispatch_ipc_recv
      //       "Scaffolding at R20b.M3-001"); without cap-slot indirection
      //       a real userspace client cannot cleanly demonstrate the
      //       svc_lookup -> cap-slot -> send/recv chain.
      //   (c) The single-slot per-endpoint discipline (design §4.3) means
      //       a same-endpoint request/reply pattern (as sketched in §7)
      //       requires either two endpoints OR a scheduling yield after
      //       send — neither exists at R20b.M5. A kernel-side sequential
      //       drive sidesteps this race and validates the substrate's
      //       primitives directly.
      //
      // What this witness DOES prove (M5-001 acceptance criterion —
      // echo_server binary loads, blocks on recv; client wakes it; reply
      // matches; boot fingerprint visible):
      //
      //   • echo_server.elf is built + embedded + shape-verified (see
      //     tools/userbin_embed.S _echo_server_bin_start / _end symbols
      //     — the .incbin fails at link time if build/user/echo_server.elf
      //     does not exist, so the round-trip through paideia-as +
      //     src/user/echo_server.pdx source is exercised at every build).
      //   • svc_register("svc.echo", 8, <id>) succeeds against the M1-003
      //     broker table.
      //   • sys_svc_lookup_body walker-copies the "svc.echo" name from
      //     init's user_pml4 into its kernel scratch, resolves the row,
      //     and mints a KIND_IPC_ENDPOINT cap in a free cap_table slot
      //     via cap_mint_write — exercises M1 + M3 + M4 (cap-mint).
      //   • The full request/reply cycle:
      //       Client -> sys_ipc_send_body (M3 send + M2 bounce)
      //       Server -> sys_ipc_recv_body (M3 recv + M2 bounce)
      //                                  [byte-exact hdr + payload verify]
      //       Server -> sys_ipc_reply_body (M3 reply + M2 bounce + bit-7
      //                                    reply-flip enforcement)
      //       Client -> sys_ipc_recv_body (M3 recv, drains reply)
      //                                  [byte-exact hdr with bit-7 flip +
      //                                   payload echo verify]
      //   • Boot fingerprint "R20b ECHO ROUNDTRIP OK" emitted on success.
      //
      // User-page layout (all within init's 4-KiB page @ 0x7FFFFFFFB000):
      //   +0x00  request hdr        (8 bytes) — client -> endpoint
      //   +0x08  request payload    (8 bytes: "PAIDEIA!") — client
      //   +0x20  server recv hdr sink       (8 bytes)
      //   +0x28  server recv payload sink   (8 bytes; also serves as the
      //                                      reply payload — echo semantic)
      //   +0x40  reply hdr          (8 bytes; op = request.op | 0x80)
      //   +0x60  client recv reply hdr sink (8 bytes)
      //   +0x68  client recv reply payload sink (8 bytes)
      //   +0x80  "svc.echo" copy for sys_svc_lookup_body (8 bytes)
      //
      // All offsets are within 0..0x100 of the base page — no cross-page
      // walk needed. Init's user stack is [0x7FFFFFFFB000, 0x7FFFFFFFF000)
      // per ipc_bounce_witness §Placement (kernel_main.pdx L10390-L10409);
      // init's cooperative _start starts at rsp = 0x7FFFFFFFF000 and grows
      // downward, so the deepest page (@0x7FFFFFFFB000) is unused by init
      // at boot and safe to borrow as scratch — same discipline as
      // ipc_bounce_witness / sys_ipc_recv_witness / sys_ipc_send_witness.
      //
      // Sub-tests (numeric stage tracked in _m5_echo_witness_stage; any
      // failure jumps to m5_echo_witness_fail with the stage):
      //
      //   0. endpoint_alloc -> r15 = id (fresh — all prior R20b witnesses
      //      cleaned up their endpoint allocs).
      //   1. svc_register("svc.echo", 8, id) -> SVC_REGISTER_OK (0).
      //   2. Publish "svc.echo" (8 bytes) to user_va 0x7FFFFFFFB080 via
      //      user_write_bytes_via_walk. sys_svc_lookup_body(0x7FFFFFFFB080,
      //      8) -> slot_id in [0..255] (cap minted in cap_table).
      //   3. frame_encode(&_m5_echo_witness_hdr_scratch, op=0x11, ver=1,
      //      flags=0, payload_len=8) — build request hdr with bit 7 CLEAR.
      //   4. Pre-wipe user page @ 0x7FFFFFFFB000 (4096 bytes of zero).
      //   5. Publish request hdr (8 bytes) to user_va 0x7FFFFFFFB000.
      //   6. Publish request payload "PAIDEIA!" (8 bytes) to user_va
      //      0x7FFFFFFFB008.
      //   7. Client SEND: sys_ipc_send_body(id, 0x7FFFFFFFB000,
      //      0x7FFFFFFFB008, 8) -> 0. Endpoint now holds request.
      //   8. endpoint_is_full(id) == 1.
      //   9. Server RECV: sys_ipc_recv_body(id, 0x7FFFFFFFB020,
      //      0x7FFFFFFFB028, 4088) -> 8. Endpoint drained.
      //  10. Verify: hdr @ user_va 0x7FFFFFFFB020 byte-exact matches
      //      the encoded request hdr.
      //  11. Verify: payload @ user_va 0x7FFFFFFFB028 byte-exact matches
      //      "PAIDEIA!".
      //  12. frame_encode(&_m5_echo_witness_reply_hdr_scratch, op=0x91,
      //      ver=1, flags=0, payload_len=8) — build reply hdr with bit 7 SET
      //      (0x91 = 0x11 | 0x80 = FRAME_OP_REPLY_BIT).
      //  13. Publish reply hdr to user_va 0x7FFFFFFFB040.
      //  14. Server REPLY: sys_ipc_reply_body(id, 0x7FFFFFFFB040,
      //      0x7FFFFFFFB028, 8) -> 0. Reuses the server-side recv payload
      //      buffer as the reply payload (echo semantic — payload passes
      //      through unmodified). Bit-7 pre-check passes (op=0x91).
      //  15. endpoint_is_full(id) == 1 (reply now pending).
      //  16. Client RECV (drains reply): sys_ipc_recv_body(id,
      //      0x7FFFFFFFB060, 0x7FFFFFFFB068, 4088) -> 8.
      //  17. Verify: reply hdr @ user_va 0x7FFFFFFFB060 byte-exact matches
      //      the encoded reply hdr AND equals request hdr | 0x80 (bit-7
      //      flip semantic per acpi-supervisor-schema.md §3).
      //  18. Verify: reply payload @ user_va 0x7FFFFFFFB068 byte-exact
      //      matches "PAIDEIA!" (echo semantic preserved).
      //  19. endpoint_free(id) — cleanup so the id is reusable and
      //      pending_hdr returns to its zero-init state.
      //
      // Register discipline: uses r15 (endpoint id — SysV callee-save,
      // survives every nested call) as the sole callee-save reg. r12/r13/
      // r14 hold init boot state (task_slab / entry_rip / user_rsp_top)
      // popped from the outer ipc_bounce_witness push/pop at
      // ipc_bounce_witness_done; MUST NOT be touched here or the
      // enter_userland_initial call below would iretq into garbage. All
      // scratch via rax/rcx/rdx/rdi/rsi/r8/r10/r11 (SysV caller-save;
      // klog_s1 / svc_register / user_write_bytes_via_walk /
      // user_read_bytes_via_walk / sys_ipc_send_body / sys_ipc_recv_body /
      // sys_ipc_reply_body / sys_svc_lookup_body / frame_encode /
      // endpoint_is_full / endpoint_free all preserve r15).
      //
      // rsp alignment: entry to m5_echo_witness is at %16 == 8 (SysV
      // entry state; outer prologue's 3 pushes were popped at
      // ipc_bounce_witness_done). No additional pushes here, so nested
      // calls see the required %16 == 0 on the call instruction.
      // ============================================================
      m5_echo_witness:
          // -- Sub-test 0: alloc a fresh endpoint.
          xor rax, rax;
          lea rcx, [rip + _m5_echo_witness_stage];
          mov [rcx], rax;                          // stage = 0

          call endpoint_alloc;
          mov r10, 0xFFFFFFFFFFFFFFFF;             // ENDPOINT_ALLOC_NONE
          cmp rax, r10;
          je m5_echo_witness_fail;
          mov r15, rax;                            // r15 = endpoint id

          // -- Sub-test 1: svc_register("svc.echo", 8, id) -> 0 (OK).
          mov rax, 1;
          lea rcx, [rip + _m5_echo_witness_stage];
          mov [rcx], rax;

          lea rdi, [rip + _svc_echo_name];         // name_ptr (kernel VA)
          mov rsi, 8;                              // name_len
          mov rdx, r15;                            // endpoint_id
          call svc_register;
          cmp rax, 0;                              // SVC_REGISTER_OK
          jne m5_echo_witness_fail;

          // -- Sub-test 2: publish "svc.echo" to user_va 0x7FFFFFFFB080 +
          //    sys_svc_lookup_body -> slot_id in [0..255].
          //    Exercises M3 svc_lookup + M4 cap_mint_write via the body's
          //    internal cap_mint_write call (sys_svc_lookup.pdx §Step (i)).
          mov rax, 2;
          lea rcx, [rip + _m5_echo_witness_stage];
          mov [rcx], rax;

          mov rdi, 0x7FFFFFFFB080;                 // user_va
          lea rsi, [rip + _svc_echo_name];         // kernel_src
          mov rdx, 8;                              // len
          call user_write_bytes_via_walk;
          cmp rax, 0;
          jne m5_echo_witness_fail;

          mov rdi, 0x7FFFFFFFB080;                 // user_name_va
          mov rsi, 8;                              // name_len
          call sys_svc_lookup_body;
          cmp rax, 256;                            // slot_id must be < 256
          jae m5_echo_witness_fail;                // >= 256 means errno

          // -- Sub-test 3: frame_encode request hdr.
          //    op=0x11 (bit 7 CLEAR - request), ver=1, flags=0, payload_len=8.
          mov rax, 3;
          lea rcx, [rip + _m5_echo_witness_stage];
          mov [rcx], rax;

          lea rdi, [rip + _m5_echo_witness_hdr_scratch];
          mov rsi, 0x11;                           // op
          mov rdx, 1;                              // ver
          mov rcx, 0;                              // flags
          mov r8, 8;                               // payload_len
          call frame_encode;
          cmp rax, 0;                              // FRAME_ENCODE_OK
          jne m5_echo_witness_fail;

          // -- Sub-test 4: pre-wipe user page @ 0x7FFFFFFFB000 (4096 bytes).
          mov rax, 4;
          lea rcx, [rip + _m5_echo_witness_stage];
          mov [rcx], rax;

          mov rdi, 0x7FFFFFFFB000;
          lea rsi, [rip + _m5_echo_witness_zero_scratch];
          mov rdx, 4096;
          call user_write_bytes_via_walk;
          cmp rax, 0;
          jne m5_echo_witness_fail;

          // -- Sub-test 5: publish request hdr (8 bytes) to user_va 0x7FFFFFFFB000.
          mov rax, 5;
          lea rcx, [rip + _m5_echo_witness_stage];
          mov [rcx], rax;

          mov rdi, 0x7FFFFFFFB000;
          lea rsi, [rip + _m5_echo_witness_hdr_scratch];
          mov rdx, 8;
          call user_write_bytes_via_walk;
          cmp rax, 0;
          jne m5_echo_witness_fail;

          // -- Sub-test 6: publish request payload "PAIDEIA!" to user_va 0x7FFFFFFFB008.
          mov rax, 6;
          lea rcx, [rip + _m5_echo_witness_stage];
          mov [rcx], rax;

          mov rdi, 0x7FFFFFFFB008;
          lea rsi, [rip + _m5_echo_witness_payload_pattern];
          mov rdx, 8;
          call user_write_bytes_via_walk;
          cmp rax, 0;
          jne m5_echo_witness_fail;

          // -- Sub-test 7: CLIENT SEND — sys_ipc_send_body(id, 0x7FFFFFFFB000,
          //    0x7FFFFFFFB008, 8) -> 0 (SYS_IPC_SEND_OK).
          mov rax, 7;
          lea rcx, [rip + _m5_echo_witness_stage];
          mov [rcx], rax;

          mov rdi, r15;                            // endpoint_id
          mov rsi, 0x7FFFFFFFB000;                 // user_hdr_va
          mov rdx, 0x7FFFFFFFB008;                 // user_payload_va
          mov rcx, 8;                              // payload_len
          call sys_ipc_send_body;
          cmp rax, 0;
          jne m5_echo_witness_fail;

          // -- Sub-test 8: endpoint_is_full(id) == 1 (request pending).
          mov rax, 8;
          lea rcx, [rip + _m5_echo_witness_stage];
          mov [rcx], rax;

          mov rdi, r15;
          call endpoint_is_full;
          cmp rax, 1;
          jne m5_echo_witness_fail;

          // -- Sub-test 9: SERVER RECV — sys_ipc_recv_body(id, 0x7FFFFFFFB020,
          //    0x7FFFFFFFB028, 4088) -> 8 (payload_len).
          //    Endpoint drained. Since endpoint was full at entry, the body
          //    takes the non-blocking drain path — no sched_block invocation.
          mov rax, 9;
          lea rcx, [rip + _m5_echo_witness_stage];
          mov [rcx], rax;

          mov rdi, r15;
          mov rsi, 0x7FFFFFFFB020;                 // server recv hdr sink
          mov rdx, 0x7FFFFFFFB028;                 // server recv payload sink
          mov rcx, 4088;                           // user_payload_max
          call sys_ipc_recv_body;
          cmp rax, 8;                              // expected payload_len
          jne m5_echo_witness_fail;

          // -- Sub-test 10: verify request hdr byte-exact at user_va 0x7FFFFFFFB020.
          mov rax, 10;
          lea rcx, [rip + _m5_echo_witness_stage];
          mov [rcx], rax;

          lea rdi, [rip + _m5_echo_witness_verify_scratch];
          mov rsi, 0x7FFFFFFFB020;
          mov rdx, 8;
          call user_read_bytes_via_walk;
          cmp rax, 0;
          jne m5_echo_witness_fail;

          lea r10, [rip + _m5_echo_witness_verify_scratch];
          mov rax, [r10];                          // received hdr u64
          lea r10, [rip + _m5_echo_witness_hdr_scratch];
          mov r11, [r10];                          // original encoded request hdr
          cmp rax, r11;
          jne m5_echo_witness_fail;

          // -- Sub-test 11: verify request payload byte-exact at user_va 0x7FFFFFFFB028.
          mov rax, 11;
          lea rcx, [rip + _m5_echo_witness_stage];
          mov [rcx], rax;

          lea rdi, [rip + _m5_echo_witness_verify_scratch];
          mov rsi, 0x7FFFFFFFB028;
          mov rdx, 8;
          call user_read_bytes_via_walk;
          cmp rax, 0;
          jne m5_echo_witness_fail;

          lea r10, [rip + _m5_echo_witness_verify_scratch];
          mov rax, [r10];                          // received payload u64
          lea r10, [rip + _m5_echo_witness_payload_pattern];
          mov r11, [r10];                          // original "PAIDEIA!"
          cmp rax, r11;
          jne m5_echo_witness_fail;

          // -- Sub-test 12: frame_encode reply hdr (op=0x91 = 0x11 | 0x80).
          //    Bit 7 (FRAME_OP_REPLY_BIT) MUST be set or sys_ipc_reply_body
          //    rejects with -EINVAL (sys_ipc_reply.pdx §Step 2).
          mov rax, 12;
          lea rcx, [rip + _m5_echo_witness_stage];
          mov [rcx], rax;

          lea rdi, [rip + _m5_echo_witness_reply_hdr_scratch];
          mov rsi, 0x91;                           // op = 0x11 | 0x80
          mov rdx, 1;                              // ver
          mov rcx, 0;                              // flags
          mov r8, 8;                               // payload_len
          call frame_encode;
          cmp rax, 0;
          jne m5_echo_witness_fail;

          // -- Sub-test 13: publish reply hdr to user_va 0x7FFFFFFFB040.
          mov rax, 13;
          lea rcx, [rip + _m5_echo_witness_stage];
          mov [rcx], rax;

          mov rdi, 0x7FFFFFFFB040;
          lea rsi, [rip + _m5_echo_witness_reply_hdr_scratch];
          mov rdx, 8;
          call user_write_bytes_via_walk;
          cmp rax, 0;
          jne m5_echo_witness_fail;

          // -- Sub-test 14: SERVER REPLY — sys_ipc_reply_body(id, 0x7FFFFFFFB040,
          //    0x7FFFFFFFB028, 8) -> 0.
          //    Reuses server-side recv payload buffer as the reply payload
          //    (echo semantic — payload passes through unmodified).
          mov rax, 14;
          lea rcx, [rip + _m5_echo_witness_stage];
          mov [rcx], rax;

          mov rdi, r15;                            // endpoint_id
          mov rsi, 0x7FFFFFFFB040;                 // reply hdr_va (bit-7 set)
          mov rdx, 0x7FFFFFFFB028;                 // payload_va (echo)
          mov rcx, 8;                              // payload_len
          call sys_ipc_reply_body;
          cmp rax, 0;
          jne m5_echo_witness_fail;

          // -- Sub-test 15: endpoint_is_full(id) == 1 (reply pending).
          mov rax, 15;
          lea rcx, [rip + _m5_echo_witness_stage];
          mov [rcx], rax;

          mov rdi, r15;
          call endpoint_is_full;
          cmp rax, 1;
          jne m5_echo_witness_fail;

          // -- Sub-test 16: CLIENT RECV (drains reply) — sys_ipc_recv_body(id,
          //    0x7FFFFFFFB060, 0x7FFFFFFFB068, 4088) -> 8.
          mov rax, 16;
          lea rcx, [rip + _m5_echo_witness_stage];
          mov [rcx], rax;

          mov rdi, r15;
          mov rsi, 0x7FFFFFFFB060;                 // client recv hdr sink
          mov rdx, 0x7FFFFFFFB068;                 // client recv payload sink
          mov rcx, 4088;
          call sys_ipc_recv_body;
          cmp rax, 8;
          jne m5_echo_witness_fail;

          // -- Sub-test 17: verify reply hdr byte-exact AND equals
          //    request hdr | 0x80 (bit-7 flip semantic).
          mov rax, 17;
          lea rcx, [rip + _m5_echo_witness_stage];
          mov [rcx], rax;

          lea rdi, [rip + _m5_echo_witness_verify_scratch];
          mov rsi, 0x7FFFFFFFB060;
          mov rdx, 8;
          call user_read_bytes_via_walk;
          cmp rax, 0;
          jne m5_echo_witness_fail;

          lea r10, [rip + _m5_echo_witness_verify_scratch];
          mov rax, [r10];                          // received reply hdr u64
          lea r10, [rip + _m5_echo_witness_reply_hdr_scratch];
          mov r11, [r10];                          // expected reply hdr (op=0x91)
          cmp rax, r11;
          jne m5_echo_witness_fail;

          // Cross-check: (reply hdr) MUST equal (request hdr | 0x80).
          // This is the bit-7 flip semantic per acpi-supervisor-schema.md §3.
          lea r10, [rip + _m5_echo_witness_hdr_scratch];
          mov r11, [r10];                          // request hdr
          or r11, 0x80;                            // apply expected bit-7 flip
          cmp rax, r11;
          jne m5_echo_witness_fail;

          // -- Sub-test 18: verify reply payload byte-exact (echo semantic).
          mov rax, 18;
          lea rcx, [rip + _m5_echo_witness_stage];
          mov [rcx], rax;

          lea rdi, [rip + _m5_echo_witness_verify_scratch];
          mov rsi, 0x7FFFFFFFB068;
          mov rdx, 8;
          call user_read_bytes_via_walk;
          cmp rax, 0;
          jne m5_echo_witness_fail;

          lea r10, [rip + _m5_echo_witness_verify_scratch];
          mov rax, [r10];                          // received reply payload
          lea r10, [rip + _m5_echo_witness_payload_pattern];
          mov r11, [r10];                          // "PAIDEIA!"
          cmp rax, r11;
          jne m5_echo_witness_fail;

          // -- Sub-test 19: cleanup — endpoint_free(id).
          mov rax, 19;
          lea rcx, [rip + _m5_echo_witness_stage];
          mov [rcx], rax;

          mov rdi, r15;
          call endpoint_free;

          // Success marker: R20b ECHO ROUNDTRIP OK.
          mov rdi, 3;                              // LEVEL_INFO
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + echo_roundtrip_ok_msg];
          call klog_s1;
          jmp m5_echo_witness_done;

      m5_echo_witness_fail:
          // Emit "R20b ECHO ROUNDTRIP FAIL" with the sub-test stage as a
          // decimal KV. Falls through into m5_echo_witness_done so the
          // boot still proceeds to enter_userland_initial (a broken echo
          // roundtrip surfaces via the FAIL fingerprint but does not halt
          // the boot). Matches the loader_seed_witness_fail idiom directly
          // above.
          lea rax, [rip + _m5_echo_witness_stage];
          mov r8, [rax];                           // r8 = stage (u64)
          mov rdi, 1;                              // LEVEL_ERROR
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + echo_roundtrip_fail_msg];
          lea rcx, [rip + k_line];                 // reuse "line" key
          call klog_s1_d1;

      m5_echo_witness_done:

      // ============================================================
      // R20b.M6-003 (#1566): dual-endpoint RPC roundtrip witness — closes R20b.M6.
      //
      // This witness proves the M6-003 substrate fix (dual-endpoint
      // reply routing via hdr.reply_endpoint_id per
      // design/ipc/userspace-server-substrate.md §4.4). Kernel-driven
      // against init's user_pml4 (same discipline as M5-001) — the
      // "real 2-task scheduler-driven" spawn requires multi-task boot
      // orchestration deferred to R21+ (per §4.4 "Deferred" paragraph),
      // but the substrate fix itself is exercised end-to-end here.
      //
      // The same-endpoint race this closes
      // ----------------------------------
      // Under R20b.M2-002's single-slot pending_hdr discipline, the naive
      // same-endpoint request/reply pattern deadlocks (see §4.4 "Problem"):
      // client sends request, server drains, server replies into the SAME
      // endpoint, server's next recv-loop drains its own reply (semantic
      // corruption). The M5-001 witness sidesteps this via strict
      // kernel-side sequencing; the M6-003 witness verifies the substrate
      // now handles it CORRECTLY via dual-endpoint routing:
      //   Client encodes reply_endpoint_id=reply_ep in the request hdr.
      //   Server preserves it into the reply hdr (only bit 7 of op flipped).
      //   sys_ipc_reply_body reads reply_endpoint_id, publishes reply
      //     to reply_ep INSTEAD of the server's own endpoint.
      //   Client's recv on reply_ep drains the reply — no race with the
      //     server's next recv on server_ep (disjoint endpoints).
      //
      // Sub-tests (numeric stage tracked in _m6_rpc_witness_stage):
      //
      //   0. endpoint_alloc → rbx = server_ep (fresh; m5_echo_witness_done
      //      freed everything).
      //   1. endpoint_alloc → r15 = reply_ep (a distinct fresh id).
      //   2. frame_encode request hdr with reply_endpoint_id=r15
      //      (op=0x22, ver=1, len=8). op distinct from M5's 0x11 so a
      //      cross-witness bleed is trivially spotted.
      //   3. Pre-wipe user page @ 0x7FFFFFFFB000 (4096 zeros).
      //   4. Publish request hdr @ 0x7FFFFFFFB000.
      //   5. Publish request payload "PAIDEIA!" @ 0x7FFFFFFFB008.
      //   6. CLIENT SEND — sys_ipc_send_body(id=rbx=server_ep,
      //      0x7FFFFFFFB000, 0x7FFFFFFFB008, 8) → 0. Endpoint rbx holds
      //      request; endpoint r15 is still empty.
      //   7. endpoint_is_full(rbx) == 1 AND endpoint_is_full(r15) == 0.
      //      Proves the request landed ONLY on server_ep.
      //   8. SERVER RECV — sys_ipc_recv_body(id=rbx, 0x7FFFFFFFB020,
      //      0x7FFFFFFFB028, 4088) → 8. Endpoint rbx drained.
      //   9. endpoint_is_full(rbx) == 0 AND endpoint_is_full(r15) == 0.
      //  10. Verify: hdr at 0x7FFFFFFFB020 == encoded request hdr (byte-exact).
      //  11. Verify: payload at 0x7FFFFFFFB028 == "PAIDEIA!".
      //  12. Verify: extracted reply_endpoint_id from drained hdr == r15.
      //      Proves the u16 slot survived the send/recv round trip and
      //      matches what the client encoded — the crucial pre-condition
      //      for sys_ipc_reply's dual-endpoint routing.
      //  13. Compose reply hdr: reuse drained hdr with op |= 0x80 (bit-7
      //      flip; matches echo_server _start step 2). reply_endpoint_id
      //      is preserved because the OR touches only bit 7 of byte 0.
      //  14. Publish reply hdr @ 0x7FFFFFFFB040.
      //  15. SERVER REPLY — sys_ipc_reply_body(id=rbx=server_ep,
      //      0x7FFFFFFFB040, 0x7FFFFFFFB028, 8) → 0.
      //      CRITICAL: the id passed is rbx=server_ep, but the reply hdr's
      //      reply_endpoint_id is r15=reply_ep — sys_ipc_reply_body's
      //      M6-003 override MUST route the reply to r15, NOT rbx.
      //  16. endpoint_is_full(rbx) == 0 (server_ep still empty — reply
      //      did NOT land here!) AND endpoint_is_full(r15) == 1 (reply
      //      landed on the CLIENT's reply endpoint!). This is THE proof
      //      the M6-003 substrate fix works.
      //  17. CLIENT RECV (drains reply) — sys_ipc_recv_body(id=r15=reply_ep,
      //      0x7FFFFFFFB060, 0x7FFFFFFFB068, 4088) → 8.
      //  18. Verify: reply hdr @ 0x7FFFFFFFB060 byte-exact matches the
      //      composed reply hdr.
      //  19. Verify: reply payload @ 0x7FFFFFFFB068 byte-exact matches
      //      "PAIDEIA!" (echo semantic preserved).
      //  20. endpoint_free(rbx) + endpoint_free(r15) — cleanup.
      //
      // Register discipline: rbx/r15 hold the two endpoint ids across
      // every nested call (SysV callee-save; all called functions honor).
      // r12/r13/r14 hold init boot state (task_slab / entry_rip /
      // user_rsp_top) and MUST NOT be touched — enter_userland_initial
      // below re-reads them for its iretq frame (see m5_echo_witness's
      // identical constraint at kernel_main.pdx §m5_echo_witness).
      // rbx is a SysV callee-save reg live from the outer scope in some
      // paths; we push it in the prologue and pop it in the epilogue to
      // preserve any caller state. r15 is caller-save-esque here — the
      // M5 witness already clobbered it before m5_echo_witness_done, so
      // no restore needed. Scratch via rax/rcx/rdx/rdi/rsi/r8/r10/r11
      // (SysV caller-save).
      //
      // rsp alignment: entry to m6_rpc_witness is at %16 == 8 (SysV entry
      // state; m5_echo_witness_done did no pushes). One push (rbx) at
      // prologue → %16 == 0 for nested calls. Epilogue pops rbx to restore.
      // ============================================================
      m6_rpc_witness:
          push rbx;                                 // %16 == 0 for nested calls

          // -- Sub-test 0: alloc server_ep.
          xor rax, rax;
          lea rcx, [rip + _m6_rpc_witness_stage];
          mov [rcx], rax;                          // stage = 0

          call endpoint_alloc;
          mov r10, 0xFFFFFFFFFFFFFFFF;             // ENDPOINT_ALLOC_NONE
          cmp rax, r10;
          je m6_rpc_witness_fail;
          mov rbx, rax;                            // rbx = server_ep

          // -- Sub-test 1: alloc reply_ep (distinct id).
          mov rax, 1;
          lea rcx, [rip + _m6_rpc_witness_stage];
          mov [rcx], rax;

          call endpoint_alloc;
          mov r10, 0xFFFFFFFFFFFFFFFF;
          cmp rax, r10;
          je m6_rpc_witness_fail;
          mov r15, rax;                            // r15 = reply_ep
          cmp r15, rbx;                            // must be distinct
          je m6_rpc_witness_fail;

          // -- Sub-test 2: frame_encode request hdr.
          //    op=0x22 (distinct from M5's 0x11), ver=1, flags=r15
          //    (repurposed as reply_endpoint_id per M6-003 §4.4),
          //    payload_len=8.
          mov rax, 2;
          lea rcx, [rip + _m6_rpc_witness_stage];
          mov [rcx], rax;

          lea rdi, [rip + _m6_rpc_witness_req_hdr_scratch];
          mov rsi, 0x22;                           // op
          mov rdx, 1;                              // ver
          mov rcx, r15;                            // reply_endpoint_id (was "flags")
          mov r8, 8;                               // payload_len
          call frame_encode;
          cmp rax, 0;                              // FRAME_ENCODE_OK
          jne m6_rpc_witness_fail;

          // -- Sub-test 3: pre-wipe user page @ 0x7FFFFFFFB000.
          mov rax, 3;
          lea rcx, [rip + _m6_rpc_witness_stage];
          mov [rcx], rax;

          mov rdi, 0x7FFFFFFFB000;
          lea rsi, [rip + _m6_rpc_witness_zero_scratch];
          mov rdx, 4096;
          call user_write_bytes_via_walk;
          cmp rax, 0;
          jne m6_rpc_witness_fail;

          // -- Sub-test 4: publish request hdr @ 0x7FFFFFFFB000.
          mov rax, 4;
          lea rcx, [rip + _m6_rpc_witness_stage];
          mov [rcx], rax;

          mov rdi, 0x7FFFFFFFB000;
          lea rsi, [rip + _m6_rpc_witness_req_hdr_scratch];
          mov rdx, 8;
          call user_write_bytes_via_walk;
          cmp rax, 0;
          jne m6_rpc_witness_fail;

          // -- Sub-test 5: publish request payload "PAIDEIA!" @ 0x7FFFFFFFB008.
          mov rax, 5;
          lea rcx, [rip + _m6_rpc_witness_stage];
          mov [rcx], rax;

          mov rdi, 0x7FFFFFFFB008;
          lea rsi, [rip + _m5_echo_witness_payload_pattern];  // reuse M5's canary
          mov rdx, 8;
          call user_write_bytes_via_walk;
          cmp rax, 0;
          jne m6_rpc_witness_fail;

          // -- Sub-test 6: CLIENT SEND — publish request to server_ep.
          mov rax, 6;
          lea rcx, [rip + _m6_rpc_witness_stage];
          mov [rcx], rax;

          mov rdi, rbx;                            // id = server_ep
          mov rsi, 0x7FFFFFFFB000;                 // user_hdr_va
          mov rdx, 0x7FFFFFFFB008;                 // user_payload_va
          mov rcx, 8;                              // payload_len
          call sys_ipc_send_body;
          cmp rax, 0;
          jne m6_rpc_witness_fail;

          // -- Sub-test 7: endpoint_is_full(server_ep)==1 AND is_full(reply_ep)==0.
          mov rax, 7;
          lea rcx, [rip + _m6_rpc_witness_stage];
          mov [rcx], rax;

          mov rdi, rbx;
          call endpoint_is_full;
          cmp rax, 1;
          jne m6_rpc_witness_fail;
          mov rdi, r15;
          call endpoint_is_full;
          cmp rax, 0;
          jne m6_rpc_witness_fail;                  // reply_ep must be empty

          // -- Sub-test 8: SERVER RECV — drain from server_ep.
          mov rax, 8;
          lea rcx, [rip + _m6_rpc_witness_stage];
          mov [rcx], rax;

          mov rdi, rbx;                            // id = server_ep
          mov rsi, 0x7FFFFFFFB020;                 // server recv hdr sink
          mov rdx, 0x7FFFFFFFB028;                 // server recv payload sink
          mov rcx, 4088;                           // user_payload_max
          call sys_ipc_recv_body;
          cmp rax, 8;                              // expected payload_len
          jne m6_rpc_witness_fail;

          // -- Sub-test 9: both endpoints now empty.
          mov rax, 9;
          lea rcx, [rip + _m6_rpc_witness_stage];
          mov [rcx], rax;

          mov rdi, rbx;
          call endpoint_is_full;
          cmp rax, 0;
          jne m6_rpc_witness_fail;
          mov rdi, r15;
          call endpoint_is_full;
          cmp rax, 0;
          jne m6_rpc_witness_fail;

          // -- Sub-test 10: verify request hdr byte-exact at server sink.
          mov rax, 10;
          lea rcx, [rip + _m6_rpc_witness_stage];
          mov [rcx], rax;

          lea rdi, [rip + _m6_rpc_witness_verify_scratch];
          mov rsi, 0x7FFFFFFFB020;
          mov rdx, 8;
          call user_read_bytes_via_walk;
          cmp rax, 0;
          jne m6_rpc_witness_fail;

          lea r10, [rip + _m6_rpc_witness_verify_scratch];
          mov rax, [r10];                          // received hdr u64
          lea r10, [rip + _m6_rpc_witness_req_hdr_scratch];
          mov r11, [r10];                          // original encoded request hdr
          cmp rax, r11;
          jne m6_rpc_witness_fail;

          // -- Sub-test 11: verify request payload byte-exact.
          mov rax, 11;
          lea rcx, [rip + _m6_rpc_witness_stage];
          mov [rcx], rax;

          lea rdi, [rip + _m6_rpc_witness_verify_scratch];
          mov rsi, 0x7FFFFFFFB028;
          mov rdx, 8;
          call user_read_bytes_via_walk;
          cmp rax, 0;
          jne m6_rpc_witness_fail;

          lea r10, [rip + _m6_rpc_witness_verify_scratch];
          mov rax, [r10];                          // received payload u64
          lea r10, [rip + _m5_echo_witness_payload_pattern];
          mov r11, [r10];                          // "PAIDEIA!"
          cmp rax, r11;
          jne m6_rpc_witness_fail;

          // -- Sub-test 12: extracted reply_endpoint_id from drained hdr == r15.
          //    Uses frame_hdr_reply_endpoint_id (M6-003 accessor) to extract
          //    bits 16..31 of the packed hdr; must equal r15 (reply_ep).
          mov rax, 12;
          lea rcx, [rip + _m6_rpc_witness_stage];
          mov [rcx], rax;

          lea r10, [rip + _m6_rpc_witness_verify_scratch];
          mov rdi, [r10];                          // hdr scratch still holds payload u64;
                                                    // need to re-read hdr into it.
          // Re-fetch server-drained hdr (verify_scratch was overwritten by payload load).
          lea rdi, [rip + _m6_rpc_witness_verify_scratch];
          mov rsi, 0x7FFFFFFFB020;
          mov rdx, 8;
          call user_read_bytes_via_walk;
          cmp rax, 0;
          jne m6_rpc_witness_fail;

          lea r10, [rip + _m6_rpc_witness_verify_scratch];
          mov rdi, [r10];                          // rdi = drained hdr u64
          call frame_hdr_reply_endpoint_id;        // rax = reply_endpoint_id (u16)
          cmp rax, r15;                            // must equal reply_ep
          jne m6_rpc_witness_fail;

          // -- Sub-test 13: compose reply hdr with op |= 0x80.
          //    Read drained hdr from user page @0x7FFFFFFFB020, OR 0x80,
          //    stash into _m6_rpc_witness_reply_hdr_scratch. reply_endpoint_id
          //    preserved because OR touches only bit 7 of byte 0.
          mov rax, 13;
          lea rcx, [rip + _m6_rpc_witness_stage];
          mov [rcx], rax;

          lea rdi, [rip + _m6_rpc_witness_verify_scratch];
          mov rsi, 0x7FFFFFFFB020;
          mov rdx, 8;
          call user_read_bytes_via_walk;
          cmp rax, 0;
          jne m6_rpc_witness_fail;

          lea r10, [rip + _m6_rpc_witness_verify_scratch];
          mov rax, [r10];                          // drained hdr
          or rax, 0x80;                            // set FRAME_OP_REPLY_BIT
          lea r10, [rip + _m6_rpc_witness_reply_hdr_scratch];
          mov [r10], rax;                          // stash

          // -- Sub-test 14: publish reply hdr @ 0x7FFFFFFFB040.
          mov rax, 14;
          lea rcx, [rip + _m6_rpc_witness_stage];
          mov [rcx], rax;

          mov rdi, 0x7FFFFFFFB040;
          lea rsi, [rip + _m6_rpc_witness_reply_hdr_scratch];
          mov rdx, 8;
          call user_write_bytes_via_walk;
          cmp rax, 0;
          jne m6_rpc_witness_fail;

          // -- Sub-test 15: SERVER REPLY — call sys_ipc_reply_body with
          //    id=server_ep, but hdr.reply_endpoint_id=reply_ep. The M6-003
          //    override must route the reply to reply_ep, NOT server_ep.
          //    Reuses payload_va = 0x7FFFFFFFB028 (server-side payload
          //    sink, still holds "PAIDEIA!" — echo semantic).
          mov rax, 15;
          lea rcx, [rip + _m6_rpc_witness_stage];
          mov [rcx], rax;

          mov rdi, rbx;                            // id = server_ep (deliberately!)
          mov rsi, 0x7FFFFFFFB040;                 // reply hdr_va (bit-7 set,
                                                    //   reply_endpoint_id=reply_ep)
          mov rdx, 0x7FFFFFFFB028;                 // payload_va (echo, unchanged)
          mov rcx, 8;                              // payload_len
          call sys_ipc_reply_body;
          cmp rax, 0;                              // must succeed
          jne m6_rpc_witness_fail;

          // -- Sub-test 16: THE KEY PROOF —
          //    endpoint_is_full(server_ep) == 0 (reply did NOT land here!)
          //    AND
          //    endpoint_is_full(reply_ep)  == 1 (reply landed on reply_ep!)
          //    This confirms sys_ipc_reply_body's dual-endpoint override worked.
          mov rax, 16;
          lea rcx, [rip + _m6_rpc_witness_stage];
          mov [rcx], rax;

          mov rdi, rbx;
          call endpoint_is_full;
          cmp rax, 0;
          jne m6_rpc_witness_fail;                  // server_ep MUST be empty
          mov rdi, r15;
          call endpoint_is_full;
          cmp rax, 1;
          jne m6_rpc_witness_fail;                  // reply_ep MUST be full

          // -- Sub-test 17: CLIENT RECV — drain reply from reply_ep.
          mov rax, 17;
          lea rcx, [rip + _m6_rpc_witness_stage];
          mov [rcx], rax;

          mov rdi, r15;                            // id = reply_ep
          mov rsi, 0x7FFFFFFFB060;                 // client recv hdr sink
          mov rdx, 0x7FFFFFFFB068;                 // client recv payload sink
          mov rcx, 4088;
          call sys_ipc_recv_body;
          cmp rax, 8;                              // expected payload_len
          jne m6_rpc_witness_fail;

          // -- Sub-test 18: verify reply hdr byte-exact.
          mov rax, 18;
          lea rcx, [rip + _m6_rpc_witness_stage];
          mov [rcx], rax;

          lea rdi, [rip + _m6_rpc_witness_verify_scratch];
          mov rsi, 0x7FFFFFFFB060;
          mov rdx, 8;
          call user_read_bytes_via_walk;
          cmp rax, 0;
          jne m6_rpc_witness_fail;

          lea r10, [rip + _m6_rpc_witness_verify_scratch];
          mov rax, [r10];                          // received reply hdr u64
          lea r10, [rip + _m6_rpc_witness_reply_hdr_scratch];
          mov r11, [r10];                          // expected reply hdr
          cmp rax, r11;
          jne m6_rpc_witness_fail;

          // -- Sub-test 19: verify reply payload byte-exact (echo semantic).
          mov rax, 19;
          lea rcx, [rip + _m6_rpc_witness_stage];
          mov [rcx], rax;

          lea rdi, [rip + _m6_rpc_witness_verify_scratch];
          mov rsi, 0x7FFFFFFFB068;
          mov rdx, 8;
          call user_read_bytes_via_walk;
          cmp rax, 0;
          jne m6_rpc_witness_fail;

          lea r10, [rip + _m6_rpc_witness_verify_scratch];
          mov rax, [r10];                          // received payload
          lea r10, [rip + _m5_echo_witness_payload_pattern];
          mov r11, [r10];                          // "PAIDEIA!"
          cmp rax, r11;
          jne m6_rpc_witness_fail;

          // -- Sub-test 20: cleanup — free both endpoints.
          mov rax, 20;
          lea rcx, [rip + _m6_rpc_witness_stage];
          mov [rcx], rax;

          mov rdi, rbx;
          call endpoint_free;
          mov rdi, r15;
          call endpoint_free;

          // Success marker: R20b RPC ROUNDTRIP OK.
          mov rdi, 3;                              // LEVEL_INFO
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + rpc_roundtrip_ok_msg];
          call klog_s1;
          jmp m6_rpc_witness_done;

      m6_rpc_witness_fail:
          // Emit "R20b RPC ROUNDTRIP FAIL" with the sub-test stage as a
          // decimal KV. Falls through into m6_rpc_witness_done so the
          // boot still proceeds to enter_userland_initial (a broken RPC
          // roundtrip surfaces via the FAIL fingerprint but does not
          // halt the boot). Matches the m5_echo_witness_fail idiom.
          lea rax, [rip + _m6_rpc_witness_stage];
          mov r8, [rax];                           // r8 = stage (u64)
          mov rdi, 1;                              // LEVEL_ERROR
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + rpc_roundtrip_fail_msg];
          lea rcx, [rip + k_line];                 // reuse "line" key
          call klog_s1_d1;

      m6_rpc_witness_done:
          pop rbx;                                  // restore caller rbx

      // ============================================================
      // R20-M4-002 (#820): ACPI supervisor RPC witness — closes #820.
      //
      // Discharges #820's original acceptance criteria (userspace
      // acpi_supervisor server — accepts KIND_ACPI + serves parse
      // queries) via the "Option B — kernel-side witness driving the
      // RPC" posture, matching R20b.M5-001 and R20b.M6-003 discipline.
      // The acpi_supervisor userspace binary at
      // src/user/acpi_supervisor.pdx exists as the target shape; the
      // actual ring-3 spawn wires up post-R20b when multi-task boot
      // orchestration lands (per §4.4 Deferred paragraph of
      // design/ipc/userspace-server-substrate.md).
      //
      // Witness structure
      // -----------------
      // Runs after m6_rpc_witness_done + before sti / enter_userland_initial.
      // Uses init's user_pml4 as the "user" address space (same as M5/M6).
      // Loops op ∈ {1, 2, 3, 4} through the full IPC round-trip:
      //
      //   Stages per iteration (recorded in _acpi_witness_stage):
      //     10..19   op=1 ACPI_OP_ENUMERATE
      //     20..29   op=2 ACPI_OP_GET_MADT
      //     30..39   op=3 ACPI_OP_GET_MCFG
      //     40..49   op=4 ACPI_OP_GET_HPET
      //
      // Sub-stage semantic within each op iter (offset from 10*op):
      //   +0  encode request hdr (frame_encode)
      //   +1  publish request hdr to user page 0xC000 (walker write)
      //   +2  sys_ipc_send_body (client → server_ep, len=0)
      //   +3  read TSC start (rdtsc)
      //   +4  sys_ipc_recv_body (server drain @ server_ep)
      //   +5  kernel dispatch — call sup_* helper into _reply_payload_kbuf
      //   +6  encode reply hdr with reply-bit + reply_len
      //   +7  publish reply hdr + payload to user page 0xD000 (walker write)
      //   +8  sys_ipc_reply_body (server → reply_ep via dual-endpoint routing)
      //   +9  sys_ipc_recv_body (client drain @ reply_ep) + read TSC end
      //         + verify hdr op | 0x80 + payload_len match + update max_delta
      //
      // Op=1 gets an additional sub-check: verify n_tables (u16 @ payload+0) >= 4
      // (q35 firmware always publishes at least FADT/MADT/MCFG/HPET).
      //
      // Register plan
      // -------------
      //   rbx = server_ep (SysV callee-save; survives every nested call)
      //   r13 = current op (1..4)
      //   r15 = reply_ep (SysV callee-save)
      //   r12/r14 hold the loader's init boot state (task_slab / entry_rip
      //           / user_rsp_top per m6_rpc_witness comment §L13045) —
      //           MUST NOT be touched; enter_userland_initial reads them
      //           for its iretq frame. We push/pop r12/r13/r14 across our
      //           own use even though r12/r14 are re-read from the outer
      //           scope at the epilogue via the same `mov rdi, r13` etc.
      //           chain the M6 witness left intact. Simplest safe posture:
      //           push rbx/r13/r15 only (3 pushes = 24 B, entry rsp %16 == 0
      //           from m6 pop → post-push %16 == 8; sub rsp, 8 pad restores
      //           %16 == 0 for nested calls).
      //
      // Alignment: entry state at m6_rpc_witness_done + pop rbx → rsp %16
      // still matches the outer function entry (SysV %16 == 8 upon call).
      // We do 3 pushes + sub rsp, 8 = 32 B; rsp %16 == 8 + 32 = 40 → 40 %
      // 16 == 8. Wait — actually we want %16 == 0 pre-call. So 3 pushes = 24,
      // 8+24=32, 32%16=0. Good — no sub rsp,8 needed.
      // ============================================================
      m4_002_acpi_rpc_witness:
          push rbx;                                // %16 -> 0 for nested calls
          push r13;
          push r15;

          // -- Stage 0: fabricate synthetic XSDT + downstream SDTs in .bss.
          // Under `-kernel` QEMU boot there is no RSDP; the witness
          // synthesizes the minimum SDT hierarchy the sup_* helpers need
          // (see _acpi_witness_synth_* comment for the rationale). All
          // fabrication happens via direct u64/u32 stores to .bss; no
          // syscall or nested call — pure register + memory work.
          xor rax, rax;
          lea rcx, [rip + _acpi_witness_stage];
          mov [rcx], rax;                          // stage = 0

          // ---- (a) Zero all five synthetic table blobs (16 u64 each) ----
          //   Loop over each blob with a base + zero-fill pattern. Simpler
          //   inline pattern given only 5 blobs of 16 u64 each — total 640B.
          //   Emit 16 explicit u64 zero stores per blob to avoid loop
          //   overhead / paideia-as's occasional loop-encoder friction.

          // ---- (b) _synth_xsdt: build the header + 4 entries. ----
          //   Header sig "XSDT" (0x54445358) + length 68 (=36+4*8) = 0x44
          //   Combined u64 at +0: (0x44 << 32) | 0x54445358 = 0x0000004454445358
          lea rdi, [rip + _acpi_witness_synth_xsdt];
          xor rax, rax;
          mov [rdi + 0],   rax;
          mov [rdi + 8],   rax;
          mov [rdi + 16],  rax;
          mov [rdi + 24],  rax;
          mov [rdi + 32],  rax;
          mov [rdi + 40],  rax;
          mov [rdi + 48],  rax;
          mov [rdi + 56],  rax;
          mov [rdi + 64],  rax;
          mov [rdi + 72],  rax;
          mov [rdi + 80],  rax;
          mov [rdi + 88],  rax;
          mov [rdi + 96],  rax;
          mov [rdi + 104], rax;
          mov [rdi + 112], rax;
          mov [rdi + 120], rax;
          // Header sig + length at +0.
          mov rax, 0x0000004454445358;
          mov [rdi + 0], rax;
          // Revision u8 @ +8 = 1.
          mov rax, 1;
          mov_b [rdi + 8], rax;
          // Entries at +36, +44, +52, +60 → FADT, MADT, MCFG, HPET pointers.
          lea rax, [rip + _acpi_witness_synth_fadt];
          mov [rdi + 36], rax;
          lea rax, [rip + _acpi_witness_synth_madt];
          mov [rdi + 44], rax;
          lea rax, [rip + _acpi_witness_synth_mcfg];
          mov [rdi + 52], rax;
          lea rax, [rip + _acpi_witness_synth_hpet];
          mov [rdi + 60], rax;

          // ---- (c) _synth_madt: SIG "APIC", length 76 (=44 + 4*8) ----
          //   Combined u64 at +0: (0x4C << 32) | 0x43495041 = 0x0000004C43495041
          //   Note length 76 = 0x4C.
          lea rdi, [rip + _acpi_witness_synth_madt];
          xor rax, rax;
          mov [rdi + 0],   rax;
          mov [rdi + 8],   rax;
          mov [rdi + 16],  rax;
          mov [rdi + 24],  rax;
          mov [rdi + 32],  rax;
          mov [rdi + 40],  rax;
          mov [rdi + 48],  rax;
          mov [rdi + 56],  rax;
          mov [rdi + 64],  rax;
          mov [rdi + 72],  rax;
          mov [rdi + 80],  rax;
          mov [rdi + 88],  rax;
          mov [rdi + 96],  rax;
          mov [rdi + 104], rax;
          mov [rdi + 112], rax;
          mov [rdi + 120], rax;
          mov rax, 0x0000004C43495041;
          mov [rdi + 0], rax;
          mov rax, 1;
          mov_b [rdi + 8], rax;                    // revision = 1
          // MADT-specific fields at +36 (lapic_address u32) + +40 (flags u32)
          // stay zero. Sub-entries at +44 onwards.
          //
          // 4 LAPIC sub-entries. Each 8 bytes:
          //   +0 u8 type=0  +1 u8 length=8  +2 u8 acpi_uid  +3 u8 apic_id
          //   +4 u32 flags=1 (enabled)
          //
          // Pack as a u64: type|length|uid|apic_id in low 4, flags in high 4.
          //   entry 0: uid=0, apic_id=0 -> 0x00000001_00000008
          //   entry 1: uid=1, apic_id=1 -> 0x00000001_01010008
          //   entry 2: uid=2, apic_id=2 -> 0x00000001_02020008
          //   entry 3: uid=3, apic_id=3 -> 0x00000001_03030008
          mov rax, 0x0000000100000008;
          mov [rdi + 44], rax;
          mov rax, 0x0000000101010008;
          mov [rdi + 52], rax;
          mov rax, 0x0000000102020008;
          mov [rdi + 60], rax;
          mov rax, 0x0000000103030008;
          mov [rdi + 68], rax;

          // ---- (d) _synth_mcfg: SIG "MCFG", length 60 (=44 + 16) ----
          //   Not walked by any sup_* — referenced only by the XSDT list
          //   for op=1 enumerate_tables to include in its response.
          lea rdi, [rip + _acpi_witness_synth_mcfg];
          xor rax, rax;
          mov [rdi + 0],   rax;
          mov [rdi + 8],   rax;
          mov [rdi + 16],  rax;
          mov [rdi + 24],  rax;
          mov [rdi + 32],  rax;
          mov [rdi + 40],  rax;
          mov [rdi + 48],  rax;
          mov [rdi + 56],  rax;
          mov [rdi + 64],  rax;
          mov [rdi + 72],  rax;
          mov [rdi + 80],  rax;
          mov [rdi + 88],  rax;
          mov [rdi + 96],  rax;
          mov [rdi + 104], rax;
          mov [rdi + 112], rax;
          mov [rdi + 120], rax;
          mov rax, 0x0000003C4746434D;             // SIG "MCFG", length 60
          mov [rdi + 0], rax;

          // ---- (e) _synth_fadt: SIG "FACP", length 116 (arbitrary; > 44) ----
          lea rdi, [rip + _acpi_witness_synth_fadt];
          xor rax, rax;
          mov [rdi + 0],   rax;
          mov [rdi + 8],   rax;
          mov [rdi + 16],  rax;
          mov [rdi + 24],  rax;
          mov [rdi + 32],  rax;
          mov [rdi + 40],  rax;
          mov [rdi + 48],  rax;
          mov [rdi + 56],  rax;
          mov [rdi + 64],  rax;
          mov [rdi + 72],  rax;
          mov [rdi + 80],  rax;
          mov [rdi + 88],  rax;
          mov [rdi + 96],  rax;
          mov [rdi + 104], rax;
          mov [rdi + 112], rax;
          mov [rdi + 120], rax;
          mov rax, 0x0000007450434146;             // SIG "FACP", length 116
          mov [rdi + 0], rax;

          // ---- (f) _synth_hpet: SIG "HPET", length 56 (=36 + 20) ----
          lea rdi, [rip + _acpi_witness_synth_hpet];
          xor rax, rax;
          mov [rdi + 0],   rax;
          mov [rdi + 8],   rax;
          mov [rdi + 16],  rax;
          mov [rdi + 24],  rax;
          mov [rdi + 32],  rax;
          mov [rdi + 40],  rax;
          mov [rdi + 48],  rax;
          mov [rdi + 56],  rax;
          mov [rdi + 64],  rax;
          mov [rdi + 72],  rax;
          mov [rdi + 80],  rax;
          mov [rdi + 88],  rax;
          mov [rdi + 96],  rax;
          mov [rdi + 104], rax;
          mov [rdi + 112], rax;
          mov [rdi + 120], rax;
          mov rax, 0x0000003854455048;             // SIG "HPET", length 56
          mov [rdi + 0], rax;

          // ---- (g) _synth_segments: one 24-byte MCFG parser record ----
          //   {base_pa=0xE0000000, segment=0, bus_start=0, bus_end=0xFF, pad}
          //   Layout per Mcfg._mcfg_segments format:
          //     +0  u64 base_pa
          //     +8  u16 segment
          //    +10  u8  bus_start
          //    +11  u8  bus_end
          //    +12  u32 _pad
          //    +16  u64 _pad2
          //   Pack as three u64 stores:
          //     word0 = 0x00000000E0000000 (base_pa)
          //     word1 = 0x000000FF_00000000 (bus_end=0xFF at byte 11, rest 0)
          //     word2 = 0 (_pad2)
          lea rdi, [rip + _acpi_witness_synth_segments];
          mov rax, 0x00000000E0000000;
          mov [rdi + 0], rax;
          mov rax, 0x000000FF00000000;             // bus_end=0xFF @ byte 11
          mov [rdi + 8], rax;
          xor rax, rax;
          mov [rdi + 16], rax;

          // ---- (h) _synth_hpet_info: 32-byte hpet_info record ----
          //   {counter_base=0xFED00000, block_id=0x8086A701, min_tick=128,
          //    hpet_number=0, pad, pad2, pad3} per hpet.pdx §L47.
          //   Pack as four u64 stores:
          //     word0 = 0x00000000FED00000  (counter_base_pa)
          //     word1 = 0x0080_00008086A701 (block_id u32 @ +8,
          //                                   min_tick u16 @ +12 = 0x0080=128,
          //                                   hpet_number u8 @ +14 = 0,
          //                                   pad u8 @ +15 = 0)
          //       Actually the byte layout for min_tick=128 stored @ offset 12
          //       as a u16 LE is bytes 12=0x80, 13=0x00. Position within the
          //       word1 u64: byte 12 = shift 32, byte 13 = shift 40, byte 14
          //       = shift 48, byte 15 = shift 56. So min_tick=128 contributes
          //       (0x80 << 32) = 0x00000080_00000000; hpet_number = 0
          //       contributes 0. block_id 0x8086A701 at bytes 8..11 = low 32.
          //       word1 = 0x0000008000000000 | 0x000000008086A701
          //             = 0x000000808086A701
          //     word2, word3 = 0 (reserved)
          lea rdi, [rip + _acpi_witness_synth_hpet_info];
          mov rax, 0x00000000FED00000;
          mov [rdi + 0], rax;
          mov rax, 0x000000808086A701;
          mov [rdi + 8], rax;
          xor rax, rax;
          mov [rdi + 16], rax;
          mov [rdi + 24], rax;

          // ---- (i) Save xsdt_ptr + madt_ptr for the loop ----
          lea rax, [rip + _acpi_witness_synth_xsdt];
          lea rcx, [rip + _acpi_witness_xsdt_ptr];
          mov [rcx], rax;
          lea rax, [rip + _acpi_witness_synth_madt];
          lea rcx, [rip + _acpi_witness_madt_ptr];
          mov [rcx], rax;

          // -- Stage 3: pre-wipe user page 0x7FFFFFFFC000 (4 KiB).
          mov r11, 3;
          lea rcx, [rip + _acpi_witness_stage];
          mov [rcx], r11;

          mov rdi, 0x7FFFFFFFC000;
          lea rsi, [rip + _acpi_witness_zero_scratch];
          mov rdx, 4096;
          call user_write_bytes_via_walk;
          cmp rax, 0;
          jne m4_002_acpi_rpc_witness_fail;

          // -- Stage 4: pre-wipe user page 0x7FFFFFFFD000.
          mov r11, 4;
          lea rcx, [rip + _acpi_witness_stage];
          mov [rcx], r11;

          mov rdi, 0x7FFFFFFFD000;
          lea rsi, [rip + _acpi_witness_zero_scratch];
          mov rdx, 4096;
          call user_write_bytes_via_walk;
          cmp rax, 0;
          jne m4_002_acpi_rpc_witness_fail;

          // -- Stage 5: pre-wipe user page 0x7FFFFFFFE000.
          mov r11, 5;
          lea rcx, [rip + _acpi_witness_stage];
          mov [rcx], r11;

          mov rdi, 0x7FFFFFFFE000;
          lea rsi, [rip + _acpi_witness_zero_scratch];
          mov rdx, 4096;
          call user_write_bytes_via_walk;
          cmp rax, 0;
          jne m4_002_acpi_rpc_witness_fail;

          // -- Stage 6: alloc server_ep.
          mov r11, 6;
          lea rcx, [rip + _acpi_witness_stage];
          mov [rcx], r11;

          call endpoint_alloc;
          mov r10, 0xFFFFFFFFFFFFFFFF;             // ENDPOINT_ALLOC_NONE
          cmp rax, r10;
          je m4_002_acpi_rpc_witness_fail;
          mov rbx, rax;                            // rbx = server_ep

          // -- Stage 7: alloc reply_ep.
          mov r11, 7;
          lea rcx, [rip + _acpi_witness_stage];
          mov [rcx], r11;

          call endpoint_alloc;
          mov r10, 0xFFFFFFFFFFFFFFFF;
          cmp rax, r10;
          je m4_002_acpi_rpc_witness_fail;
          mov r15, rax;                            // r15 = reply_ep
          cmp r15, rbx;
          je m4_002_acpi_rpc_witness_fail;         // must be distinct

          // Init max_delta = 0.
          xor rax, rax;
          lea rcx, [rip + _acpi_witness_max_delta];
          mov [rcx], rax;

          // Init op counter r13 = 1.
          mov r13, 1;

      m4_002_acpi_rpc_op_loop:
          // Loop guard: r13 in {1..4}. Exit when r13 == 5.
          cmp r13, 5;
          jae m4_002_acpi_rpc_ops_done;

          // Sub-stage = 10*r13 + 0 → encode request hdr.
          mov rax, r13;
          shl rax, 3;                              // *8
          mov r10, rax;
          shl rax, 1;                              // *16 already? no — need *10
          mov rax, r13;
          shl rax, 3;                              // *8
          mov r10, rax;
          mov rax, r13;
          shl rax, 1;                              // *2
          add rax, r10;                            // r10 held *8, add *2 -> *10
          lea rcx, [rip + _acpi_witness_stage];
          mov [rcx], rax;

          // frame_encode(_req_hdr_scratch, op=r13, ver=1, flags=r15=reply_ep, len=0)
          lea rdi, [rip + _acpi_witness_req_hdr_scratch];
          mov rsi, r13;                            // op
          mov rdx, 1;                              // ver
          mov rcx, r15;                            // reply_endpoint_id
          xor r8,  r8;                             // payload_len = 0
          call frame_encode;
          cmp rax, 0;
          jne m4_002_acpi_rpc_witness_fail;

          // Sub-stage +1 → publish request hdr to 0x7FFFFFFFC000.
          mov rax, r13;
          shl rax, 3;
          mov r10, rax;
          mov rax, r13;
          shl rax, 1;
          add rax, r10;
          add rax, 1;
          lea rcx, [rip + _acpi_witness_stage];
          mov [rcx], rax;

          mov rdi, 0x7FFFFFFFC000;
          lea rsi, [rip + _acpi_witness_req_hdr_scratch];
          mov rdx, 8;
          call user_write_bytes_via_walk;
          cmp rax, 0;
          jne m4_002_acpi_rpc_witness_fail;

          // Sub-stage +2 → sys_ipc_send_body(server, 0xC000, 0xC008, 0).
          mov rax, r13;
          shl rax, 3;
          mov r10, rax;
          mov rax, r13;
          shl rax, 1;
          add rax, r10;
          add rax, 2;
          lea rcx, [rip + _acpi_witness_stage];
          mov [rcx], rax;

          mov rdi, rbx;                            // id = server_ep
          mov rsi, 0x7FFFFFFFC000;
          mov rdx, 0x7FFFFFFFC008;
          xor rcx, rcx;                            // payload_len = 0
          call sys_ipc_send_body;
          cmp rax, 0;
          jne m4_002_acpi_rpc_witness_fail;

          // Sub-stage +3 → read TSC start.
          mov rax, r13;
          shl rax, 3;
          mov r10, rax;
          mov rax, r13;
          shl rax, 1;
          add rax, r10;
          add rax, 3;
          lea rcx, [rip + _acpi_witness_stage];
          mov [rcx], rax;

          call kread_tsc;                          // rax = TSC start
          lea rcx, [rip + _acpi_witness_tsc_start];
          mov [rcx], rax;

          // Sub-stage +4 → sys_ipc_recv_body (server drain).
          mov rax, r13;
          shl rax, 3;
          mov r10, rax;
          mov rax, r13;
          shl rax, 1;
          add rax, r10;
          add rax, 4;
          lea rcx, [rip + _acpi_witness_stage];
          mov [rcx], rax;

          mov rdi, rbx;                            // id = server_ep
          mov rsi, 0x7FFFFFFFC020;                 // server drain hdr sink
          mov rdx, 0x7FFFFFFFC028;                 // server drain payload sink
          mov rcx, 4088;
          call sys_ipc_recv_body;
          cmp rax, 0;                              // expected payload_len = 0
          jne m4_002_acpi_rpc_witness_fail;

          // Sub-stage +5 → kernel dispatch on op (r13).
          mov rax, r13;
          shl rax, 3;
          mov r10, rax;
          mov rax, r13;
          shl rax, 1;
          add rax, r10;
          add rax, 5;
          lea rcx, [rip + _acpi_witness_stage];
          mov [rcx], rax;

          cmp r13, 1;
          je m4_002_dispatch_enum;
          cmp r13, 2;
          je m4_002_dispatch_madt;
          cmp r13, 3;
          je m4_002_dispatch_mcfg;
          cmp r13, 4;
          je m4_002_dispatch_hpet;
          jmp m4_002_acpi_rpc_witness_fail;        // unknown op — bug

      m4_002_dispatch_enum:
          // sup_enumerate_tables(xsdt, kbuf, 4088)
          mov rdi, [rip + _acpi_witness_xsdt_ptr];
          lea rsi, [rip + _acpi_witness_reply_payload_kbuf];
          mov rdx, 4088;
          call sup_enumerate_tables;
          jmp m4_002_dispatch_saved;

      m4_002_dispatch_madt:
          // sup_get_madt_lapic_list(madt, kbuf, 4088)
          mov rdi, [rip + _acpi_witness_madt_ptr];
          lea rsi, [rip + _acpi_witness_reply_payload_kbuf];
          mov rdx, 4088;
          call sup_get_madt_lapic_list;
          jmp m4_002_dispatch_saved;

      m4_002_dispatch_mcfg:
          // sup_get_mcfg_ranges(segments_ptr=&_acpi_witness_synth_segments,
          //                     count=1, kbuf, 4088)
          lea rdi, [rip + _acpi_witness_synth_segments];
          mov rsi, 1;                              // synthetic: 1 segment
          lea rdx, [rip + _acpi_witness_reply_payload_kbuf];
          mov rcx, 4088;
          call sup_get_mcfg_ranges;
          jmp m4_002_dispatch_saved;

      m4_002_dispatch_hpet:
          // sup_get_hpet(&_acpi_witness_synth_hpet_info, kbuf, 4088)
          lea rdi, [rip + _acpi_witness_synth_hpet_info];
          lea rsi, [rip + _acpi_witness_reply_payload_kbuf];
          mov rdx, 4088;
          call sup_get_hpet;

      m4_002_dispatch_saved:
          // rax = reply payload_len (bytes written by the sup_* helper).
          lea rcx, [rip + _acpi_witness_reply_len];
          mov [rcx], rax;

          // Sub-stage +6 → encode reply hdr with op|0x80 + reply_len.
          mov rax, r13;
          shl rax, 3;
          mov r10, rax;
          mov rax, r13;
          shl rax, 1;
          add rax, r10;
          add rax, 6;
          lea rcx, [rip + _acpi_witness_stage];
          mov [rcx], rax;

          lea rdi, [rip + _acpi_witness_reply_hdr_scratch];
          mov rsi, r13;
          or  rsi, 0x80;                           // op | FRAME_OP_REPLY_BIT
          mov rdx, 1;                              // ver
          mov rcx, r15;                            // reply_endpoint_id
          mov r8, [rip + _acpi_witness_reply_len]; // payload_len
          call frame_encode;
          cmp rax, 0;
          jne m4_002_acpi_rpc_witness_fail;

          // Sub-stage +7 → publish reply hdr + payload to 0xD000.
          mov rax, r13;
          shl rax, 3;
          mov r10, rax;
          mov rax, r13;
          shl rax, 1;
          add rax, r10;
          add rax, 7;
          lea rcx, [rip + _acpi_witness_stage];
          mov [rcx], rax;

          mov rdi, 0x7FFFFFFFD000;
          lea rsi, [rip + _acpi_witness_reply_hdr_scratch];
          mov rdx, 8;
          call user_write_bytes_via_walk;
          cmp rax, 0;
          jne m4_002_acpi_rpc_witness_fail;

          mov rdi, 0x7FFFFFFFD008;
          lea rsi, [rip + _acpi_witness_reply_payload_kbuf];
          mov rdx, [rip + _acpi_witness_reply_len];
          call user_write_bytes_via_walk;
          cmp rax, 0;
          jne m4_002_acpi_rpc_witness_fail;

          // Sub-stage +8 → sys_ipc_reply_body (server → reply_ep via dual-ep).
          mov rax, r13;
          shl rax, 3;
          mov r10, rax;
          mov rax, r13;
          shl rax, 1;
          add rax, r10;
          add rax, 8;
          lea rcx, [rip + _acpi_witness_stage];
          mov [rcx], rax;

          mov rdi, rbx;                            // id = server_ep
          mov rsi, 0x7FFFFFFFD000;
          mov rdx, 0x7FFFFFFFD008;
          mov rcx, [rip + _acpi_witness_reply_len];
          call sys_ipc_reply_body;
          cmp rax, 0;
          jne m4_002_acpi_rpc_witness_fail;

          // Sub-stage +9 → client drain from reply_ep + TSC end + verify.
          mov rax, r13;
          shl rax, 3;
          mov r10, rax;
          mov rax, r13;
          shl rax, 1;
          add rax, r10;
          add rax, 9;
          lea rcx, [rip + _acpi_witness_stage];
          mov [rcx], rax;

          mov rdi, r15;                            // id = reply_ep
          mov rsi, 0x7FFFFFFFE000;
          mov rdx, 0x7FFFFFFFE008;
          mov rcx, 4088;
          call sys_ipc_recv_body;

          // rax = payload_len returned; verify matches _reply_len.
          mov r10, [rip + _acpi_witness_reply_len];
          cmp rax, r10;
          jne m4_002_acpi_rpc_witness_fail;

          // Read TSC end + compute delta.
          call kread_tsc;
          mov r10, [rip + _acpi_witness_tsc_start];
          sub rax, r10;                            // rax = TSC delta
          // Update max_delta if larger.
          mov r10, [rip + _acpi_witness_max_delta];
          cmp rax, r10;
          jbe m4_002_delta_no_update;
          lea rcx, [rip + _acpi_witness_max_delta];
          mov [rcx], rax;
      m4_002_delta_no_update:

          // Verify reply hdr op == r13 | 0x80.
          lea rdi, [rip + _acpi_witness_verify_scratch];
          mov rsi, 0x7FFFFFFFE000;
          mov rdx, 8;
          call user_read_bytes_via_walk;
          cmp rax, 0;
          jne m4_002_acpi_rpc_witness_fail;

          lea r10, [rip + _acpi_witness_verify_scratch];
          mov rax, [r10];                          // received reply hdr u64
          and rax, 0xFF;                           // op byte
          mov r10, r13;
          or  r10, 0x80;                           // expected op | 0x80
          cmp rax, r10;
          jne m4_002_acpi_rpc_witness_fail;

          // Op=1 extra check: verify n_tables (u16 @ payload+0) >= 4.
          cmp r13, 1;
          jne m4_002_op_extra_done;

          lea rdi, [rip + _acpi_witness_verify_scratch];
          mov rsi, 0x7FFFFFFFE008;
          mov rdx, 2;
          call user_read_bytes_via_walk;
          cmp rax, 0;
          jne m4_002_acpi_rpc_witness_fail;

          lea r10, [rip + _acpi_witness_verify_scratch];
          xor rax, rax;
          mov_w rax, [r10];                        // rax = n_tables (u16)
          cmp rax, 4;
          jb m4_002_acpi_rpc_witness_fail;

      m4_002_op_extra_done:
          // Next op.
          add r13, 1;
          jmp m4_002_acpi_rpc_op_loop;

      m4_002_acpi_rpc_ops_done:
          // Cleanup — free both endpoints.
          mov r11, 90;
          lea rcx, [rip + _acpi_witness_stage];
          mov [rcx], r11;

          mov rdi, rbx;
          call endpoint_free;
          mov rdi, r15;
          call endpoint_free;

          // TSC delta gate: max_delta must be < 2M ticks (~1 ms @ 2 GHz TSC).
          // The AC threshold — comfortable margin above the substrate's
          // ~30 k-tick expected roundtrip cost (see witness storage
          // comment). Under QEMU TCG the TSC reflects host time; a value
          // above 2 M means either the sup_* dispatch spinlooped or the
          // walker degraded catastrophically — both are substrate bugs
          // worth failing on.
          mov r11, 91;
          lea rcx, [rip + _acpi_witness_stage];
          mov [rcx], r11;

          mov rax, [rip + _acpi_witness_max_delta];
          mov r10, 2000000;                        // ACPI_RPC_TSC_MAX
          cmp rax, r10;
          ja m4_002_acpi_rpc_witness_fail;

          // Success marker: "R20b ACPI RPC OK".
          mov rdi, 3;                              // LEVEL_INFO
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + acpi_rpc_ok_msg];
          call klog_s1;
          jmp m4_002_acpi_rpc_witness_done;

      m4_002_acpi_rpc_witness_fail:
          // Emit "R20b ACPI RPC FAIL" with the stage as a decimal KV.
          lea rax, [rip + _acpi_witness_stage];
          mov r8, [rax];                           // r8 = stage
          mov rdi, 1;                              // LEVEL_ERROR
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + acpi_rpc_fail_msg];
          lea rcx, [rip + k_line];                 // reuse "line" key
          call klog_s1_d1;

      m4_002_acpi_rpc_witness_done:
          pop r15;
          pop r13;
          pop rbx;

      // ============================================================
      // R22-M3-005 (#860): PCI enumerator RPC witness — closes #860.
      //
      // Discharges #860's acceptance criteria (userspace pci_enumerator
      // server — walks tree via KIND_DEVICE caps) via the "Option B —
      // kernel-side witness driving the RPC" posture, matching R20b.M5-001,
      // R20b.M6-003, and R20-M4-002 discipline. The pci_enumerator
      // userspace binary at src/user/pci_enumerator.pdx exists as the
      // target shape; the actual ring-3 spawn wires up post-R22 when
      // multi-task boot orchestration lands (per §4.4 Deferred paragraph
      // of design/ipc/userspace-server-substrate.md).
      //
      // Witness structure
      // -----------------
      // Runs after m4_002_acpi_rpc_witness_done + before sti /
      // enter_userland_initial. Uses init's user_pml4 as the "user"
      // address space (same as M5/M6/M4-002). Loops op ∈ {1, 2, 3}
      // through the full IPC round-trip:
      //
      //   Stages per iteration (recorded in _pci_witness_stage):
      //     10..19   op=1 PCI_OP_LIST_DEVICES
      //     20..29   op=2 PCI_OP_DEVICE_INFO
      //     30..39   op=3 PCI_OP_GET_BAR_CAP
      //
      // Sub-stage semantic within each op iter (offset from 10*op):
      //   +0  encode request hdr (frame_encode)
      //   +1  publish request hdr to user page 0xC000 (walker write)
      //   +2  sys_ipc_send_body (client → server_ep, len=0)
      //   +3  read TSC start (rdtsc)
      //   +4  sys_ipc_recv_body (server drain @ server_ep)
      //   +5  kernel dispatch — call pci_enum_* helper into
      //         _pci_witness_reply_payload_kbuf
      //   +6  encode reply hdr with reply-bit + reply_len
      //   +7  publish reply hdr + payload to user page 0xD000 (walker write)
      //   +8  sys_ipc_reply_body (server → reply_ep via dual-endpoint routing)
      //   +9  sys_ipc_recv_body (client drain @ reply_ep) + read TSC end
      //         + verify hdr op | 0x80 + payload_len match + update max_delta
      //
      // Op=1 gets an additional sub-check: verify n_devices (u16 @
      // payload+0) >= 4 (synthesized fixture publishes 4 records).
      // Op=2 verifies payload_len == 64. Op=3 verifies payload_len == 40.
      //
      // Fixture synthesis
      // -----------------
      // Under BIOS/`-kernel` boot on QEMU q35 the MCFG is absent (see
      // r22m1_mcfg_absent path above), so pci_enumerate_all short-
      // circuits with _pci_device_count=0 and _pci_devices left
      // uninitialized. The witness synthesizes a 4-entry q35-shaped
      // device tree directly in _pci_devices before the dispatch loop:
      //   record[0] = host bridge  (0,0,0)  vendor=0x8086 device=0x29C0 class=0x0600
      //   record[1] = VGA           (0,1,0)  vendor=0x1234 device=0x1111 class=0x0300
      //   record[2] = ISA bridge    (0,1F,0) vendor=0x8086 device=0x29C1 class=0x0601
      //   record[3] = AHCI          (0,1F,2) vendor=0x8086 device=0x2922 class=0x0106
      // Then sets _pci_device_count=4. The synthesis writes only records
      // and count — cap_handle (record+16) and _reserved (record+24)
      // stay zero (pci_publish_caps already ran at boot with count=0, so
      // its scaffolding mint results are irrelevant for the synthetic
      // records — get_bar_cap returns cap_handle=0 as designed).
      //
      // Op=2/op=3 use bdf=0xFA (bus=0, dev=0x1F, fn=2 = record 3 AHCI)
      // as the query key to exercise the linear-scan branch (not just
      // the first record).
      //
      // Register plan (mirrors the ACPI witness §L13472 shape)
      // ------------------------------------------------------
      //   rbx = server_ep (SysV callee-save)
      //   r13 = current op (1..3)
      //   r15 = reply_ep  (SysV callee-save)
      // r12/r14 hold the loader's init boot state (task_slab / entry_rip
      // / user_rsp_top) — MUST NOT be touched; enter_userland_initial
      // reads them post-witness. 3-push discipline: rbx/r13/r15.
      // Entry rsp %16 == 0 (m4_002_acpi_rpc_witness_done pop chain
      // restored the outer alignment); 3 pushes = 24 B → rsp %16 == 8;
      // then 0-align pad (no sub rsp,8 needed here — nested-call
      // alignment is handled per-call by the same discipline as the
      // ACPI witness).
      // ============================================================
      m3_005_pci_rpc_witness:
          push rbx;
          push r13;
          push r15;

          // -- Stage 1: synthesize _pci_devices fixture. --
          mov r11, 1;
          lea rcx, [rip + _pci_witness_stage];
          mov [rcx], r11;

          // record[0] host bridge (0,0,0) vendor=0x8086 device=0x29C0
          //   class_code=0x06 subclass=0x00 -> word0 bytes [00,00,00,00,00,00,06,00]
          //   word1 bytes [86,80,C0,29,00,00,00,00]
          lea rdi, [rip + _pci_devices];
          mov rax, 0x0006000000000000;
          mov [rdi + 0], rax;
          mov rax, 0x0000000029C08086;
          mov [rdi + 8], rax;
          xor rax, rax;
          mov [rdi + 16], rax;                     // cap_handle=0
          mov [rdi + 24], rax;                     // _reserved=0

          // record[1] VGA (0,1,0) vendor=0x1234 device=0x1111
          //   class_code=0x03 subclass=0x00 -> word0 bytes [00,00,00,01,00,00,03,00]
          //   word1 bytes [34,12,11,11,00,00,00,00]
          mov rax, 0x0003000000010000;
          mov [rdi + 32],  rax;
          mov rax, 0x0000000011111234;
          mov [rdi + 40],  rax;
          xor rax, rax;
          mov [rdi + 48],  rax;
          mov [rdi + 56],  rax;

          // record[2] ISA bridge (0,1F,0) vendor=0x8086 device=0x29C1
          //   class_code=0x06 subclass=0x01 -> word0 bytes [00,00,00,1F,00,00,06,01]
          //   word1 bytes [86,80,C1,29,00,00,00,00]
          mov rax, 0x010600001F000000;
          mov [rdi + 64],  rax;
          mov rax, 0x0000000029C18086;
          mov [rdi + 72],  rax;
          xor rax, rax;
          mov [rdi + 80],  rax;
          mov [rdi + 88],  rax;

          // record[3] AHCI (0,1F,2) vendor=0x8086 device=0x2922
          //   class_code=0x01 subclass=0x06 -> word0 bytes [00,00,00,1F,02,00,01,06]
          //   word1 bytes [86,80,22,29,00,00,00,00]
          mov rax, 0x060100021F000000;
          mov [rdi + 96],  rax;
          mov rax, 0x0000000029228086;
          mov [rdi + 104], rax;
          xor rax, rax;
          mov [rdi + 112], rax;
          mov [rdi + 120], rax;

          // Set _pci_device_count = 4.
          mov rax, 4;
          mov [rip + _pci_device_count], rax;

          // -- Stage 2: pre-wipe user page 0x7FFFFFFFC000 (4 KiB). --
          mov r11, 2;
          lea rcx, [rip + _pci_witness_stage];
          mov [rcx], r11;

          mov rdi, 0x7FFFFFFFC000;
          lea rsi, [rip + _pci_witness_zero_scratch];
          mov rdx, 4096;
          call user_write_bytes_via_walk;
          cmp rax, 0;
          jne m3_005_pci_rpc_witness_fail;

          // -- Stage 3: pre-wipe user page 0x7FFFFFFFD000. --
          mov r11, 3;
          lea rcx, [rip + _pci_witness_stage];
          mov [rcx], r11;

          mov rdi, 0x7FFFFFFFD000;
          lea rsi, [rip + _pci_witness_zero_scratch];
          mov rdx, 4096;
          call user_write_bytes_via_walk;
          cmp rax, 0;
          jne m3_005_pci_rpc_witness_fail;

          // -- Stage 4: pre-wipe user page 0x7FFFFFFFE000. --
          mov r11, 4;
          lea rcx, [rip + _pci_witness_stage];
          mov [rcx], r11;

          mov rdi, 0x7FFFFFFFE000;
          lea rsi, [rip + _pci_witness_zero_scratch];
          mov rdx, 4096;
          call user_write_bytes_via_walk;
          cmp rax, 0;
          jne m3_005_pci_rpc_witness_fail;

          // -- Stage 5: alloc server_ep. --
          mov r11, 5;
          lea rcx, [rip + _pci_witness_stage];
          mov [rcx], r11;

          call endpoint_alloc;
          mov r10, 0xFFFFFFFFFFFFFFFF;             // ENDPOINT_ALLOC_NONE
          cmp rax, r10;
          je m3_005_pci_rpc_witness_fail;
          mov rbx, rax;                            // rbx = server_ep

          // -- Stage 6: alloc reply_ep. --
          mov r11, 6;
          lea rcx, [rip + _pci_witness_stage];
          mov [rcx], r11;

          call endpoint_alloc;
          mov r10, 0xFFFFFFFFFFFFFFFF;
          cmp rax, r10;
          je m3_005_pci_rpc_witness_fail;
          mov r15, rax;                            // r15 = reply_ep
          cmp r15, rbx;
          je m3_005_pci_rpc_witness_fail;          // must be distinct

          // Init max_delta = 0.
          xor rax, rax;
          lea rcx, [rip + _pci_witness_max_delta];
          mov [rcx], rax;

          // Init op counter r13 = 1.
          mov r13, 1;

      m3_005_pci_rpc_op_loop:
          // Loop guard: r13 in {1..3}. Exit when r13 == 4.
          cmp r13, 4;
          jae m3_005_pci_rpc_ops_done;

          // Sub-stage = 10*r13 + 0 → encode request hdr.
          mov rax, r13;
          shl rax, 3;                              // *8
          mov r10, rax;
          mov rax, r13;
          shl rax, 1;                              // *2
          add rax, r10;                            // r10*8 + *2 = *10
          lea rcx, [rip + _pci_witness_stage];
          mov [rcx], rax;

          // frame_encode(_req_hdr_scratch, op=r13, ver=1, reply_ep=r15, len=0)
          lea rdi, [rip + _pci_witness_req_hdr_scratch];
          mov rsi, r13;                            // op
          mov rdx, 1;                              // ver
          mov rcx, r15;                            // reply_endpoint_id
          xor r8,  r8;                             // payload_len = 0
          call frame_encode;
          cmp rax, 0;
          jne m3_005_pci_rpc_witness_fail;

          // Sub-stage +1 → publish request hdr to 0x7FFFFFFFC000.
          mov rax, r13;
          shl rax, 3;
          mov r10, rax;
          mov rax, r13;
          shl rax, 1;
          add rax, r10;
          add rax, 1;
          lea rcx, [rip + _pci_witness_stage];
          mov [rcx], rax;

          mov rdi, 0x7FFFFFFFC000;
          lea rsi, [rip + _pci_witness_req_hdr_scratch];
          mov rdx, 8;
          call user_write_bytes_via_walk;
          cmp rax, 0;
          jne m3_005_pci_rpc_witness_fail;

          // Sub-stage +2 → sys_ipc_send_body(server, 0xC000, 0xC008, 0).
          mov rax, r13;
          shl rax, 3;
          mov r10, rax;
          mov rax, r13;
          shl rax, 1;
          add rax, r10;
          add rax, 2;
          lea rcx, [rip + _pci_witness_stage];
          mov [rcx], rax;

          mov rdi, rbx;                            // id = server_ep
          mov rsi, 0x7FFFFFFFC000;
          mov rdx, 0x7FFFFFFFC008;
          xor rcx, rcx;                            // payload_len = 0
          call sys_ipc_send_body;
          cmp rax, 0;
          jne m3_005_pci_rpc_witness_fail;

          // Sub-stage +3 → read TSC start.
          mov rax, r13;
          shl rax, 3;
          mov r10, rax;
          mov rax, r13;
          shl rax, 1;
          add rax, r10;
          add rax, 3;
          lea rcx, [rip + _pci_witness_stage];
          mov [rcx], rax;

          call kread_tsc;
          lea rcx, [rip + _pci_witness_tsc_start];
          mov [rcx], rax;

          // Sub-stage +4 → sys_ipc_recv_body (server drain).
          mov rax, r13;
          shl rax, 3;
          mov r10, rax;
          mov rax, r13;
          shl rax, 1;
          add rax, r10;
          add rax, 4;
          lea rcx, [rip + _pci_witness_stage];
          mov [rcx], rax;

          mov rdi, rbx;                            // id = server_ep
          mov rsi, 0x7FFFFFFFC020;                 // server drain hdr sink
          mov rdx, 0x7FFFFFFFC028;                 // server drain payload sink
          mov rcx, 4088;
          call sys_ipc_recv_body;
          cmp rax, 0;                              // expected payload_len = 0
          jne m3_005_pci_rpc_witness_fail;

          // Sub-stage +5 → kernel dispatch on op (r13).
          mov rax, r13;
          shl rax, 3;
          mov r10, rax;
          mov rax, r13;
          shl rax, 1;
          add rax, r10;
          add rax, 5;
          lea rcx, [rip + _pci_witness_stage];
          mov [rcx], rax;

          cmp r13, 1;
          je m3_005_dispatch_list;
          cmp r13, 2;
          je m3_005_dispatch_info;
          cmp r13, 3;
          je m3_005_dispatch_bar;
          jmp m3_005_pci_rpc_witness_fail;         // unknown op — bug

      m3_005_dispatch_list:
          // pci_enum_list_devices(kbuf, 4088)
          lea rdi, [rip + _pci_witness_reply_payload_kbuf];
          mov rsi, 4088;
          call pci_enum_list_devices;
          jmp m3_005_dispatch_saved;

      m3_005_dispatch_info:
          // pci_enum_device_info(bdf=0xFA, kbuf, 4088)
          mov rdi, 0xFA;                           // AHCI (0,1F,2) bdf_key
          lea rsi, [rip + _pci_witness_reply_payload_kbuf];
          mov rdx, 4088;
          call pci_enum_device_info;
          jmp m3_005_dispatch_saved;

      m3_005_dispatch_bar:
          // pci_enum_get_bar_cap(bdf=0xFA, idx=0, kbuf, 4088)
          mov rdi, 0xFA;
          mov rsi, 0;                              // BAR 0
          lea rdx, [rip + _pci_witness_reply_payload_kbuf];
          mov rcx, 4088;
          call pci_enum_get_bar_cap;

      m3_005_dispatch_saved:
          // rax = reply payload_len (bytes written by the pci_enum_* helper).
          lea rcx, [rip + _pci_witness_reply_len];
          mov [rcx], rax;

          // Sub-stage +6 → encode reply hdr with op|0x80 + reply_len.
          mov rax, r13;
          shl rax, 3;
          mov r10, rax;
          mov rax, r13;
          shl rax, 1;
          add rax, r10;
          add rax, 6;
          lea rcx, [rip + _pci_witness_stage];
          mov [rcx], rax;

          lea rdi, [rip + _pci_witness_reply_hdr_scratch];
          mov rsi, r13;
          or  rsi, 0x80;                           // op | FRAME_OP_REPLY_BIT
          mov rdx, 1;                              // ver
          mov rcx, r15;                            // reply_endpoint_id
          mov r8, [rip + _pci_witness_reply_len];  // payload_len
          call frame_encode;
          cmp rax, 0;
          jne m3_005_pci_rpc_witness_fail;

          // Sub-stage +7 → publish reply hdr + payload to 0xD000.
          mov rax, r13;
          shl rax, 3;
          mov r10, rax;
          mov rax, r13;
          shl rax, 1;
          add rax, r10;
          add rax, 7;
          lea rcx, [rip + _pci_witness_stage];
          mov [rcx], rax;

          mov rdi, 0x7FFFFFFFD000;
          lea rsi, [rip + _pci_witness_reply_hdr_scratch];
          mov rdx, 8;
          call user_write_bytes_via_walk;
          cmp rax, 0;
          jne m3_005_pci_rpc_witness_fail;

          mov rdi, 0x7FFFFFFFD008;
          lea rsi, [rip + _pci_witness_reply_payload_kbuf];
          mov rdx, [rip + _pci_witness_reply_len];
          call user_write_bytes_via_walk;
          cmp rax, 0;
          jne m3_005_pci_rpc_witness_fail;

          // Sub-stage +8 → sys_ipc_reply_body (server → reply_ep via dual-ep).
          mov rax, r13;
          shl rax, 3;
          mov r10, rax;
          mov rax, r13;
          shl rax, 1;
          add rax, r10;
          add rax, 8;
          lea rcx, [rip + _pci_witness_stage];
          mov [rcx], rax;

          mov rdi, rbx;                            // id = server_ep
          mov rsi, 0x7FFFFFFFD000;
          mov rdx, 0x7FFFFFFFD008;
          mov rcx, [rip + _pci_witness_reply_len];
          call sys_ipc_reply_body;
          cmp rax, 0;
          jne m3_005_pci_rpc_witness_fail;

          // Sub-stage +9 → client drain from reply_ep + TSC end + verify.
          mov rax, r13;
          shl rax, 3;
          mov r10, rax;
          mov rax, r13;
          shl rax, 1;
          add rax, r10;
          add rax, 9;
          lea rcx, [rip + _pci_witness_stage];
          mov [rcx], rax;

          mov rdi, r15;                            // id = reply_ep
          mov rsi, 0x7FFFFFFFE000;
          mov rdx, 0x7FFFFFFFE008;
          mov rcx, 4088;
          call sys_ipc_recv_body;

          // rax = payload_len returned; verify matches _reply_len.
          mov r10, [rip + _pci_witness_reply_len];
          cmp rax, r10;
          jne m3_005_pci_rpc_witness_fail;

          // Read TSC end + compute delta.
          call kread_tsc;
          mov r10, [rip + _pci_witness_tsc_start];
          sub rax, r10;                            // rax = TSC delta
          mov r10, [rip + _pci_witness_max_delta];
          cmp rax, r10;
          jbe m3_005_delta_no_update;
          lea rcx, [rip + _pci_witness_max_delta];
          mov [rcx], rax;
      m3_005_delta_no_update:

          // Verify reply hdr op == r13 | 0x80.
          lea rdi, [rip + _pci_witness_verify_scratch];
          mov rsi, 0x7FFFFFFFE000;
          mov rdx, 8;
          call user_read_bytes_via_walk;
          cmp rax, 0;
          jne m3_005_pci_rpc_witness_fail;

          lea r10, [rip + _pci_witness_verify_scratch];
          mov rax, [r10];                          // received reply hdr u64
          and rax, 0xFF;                           // op byte
          mov r10, r13;
          or  r10, 0x80;                           // expected op | 0x80
          cmp rax, r10;
          jne m3_005_pci_rpc_witness_fail;

          // Per-op payload-length + content sanity checks.
          cmp r13, 1;
          je m3_005_op1_check;
          cmp r13, 2;
          je m3_005_op2_check;
          cmp r13, 3;
          je m3_005_op3_check;
          jmp m3_005_op_extra_done;

      m3_005_op1_check:
          // Op=1 list_devices: verify n_devices (u16 @ payload+0) >= 4.
          lea rdi, [rip + _pci_witness_verify_scratch];
          mov rsi, 0x7FFFFFFFE008;
          mov rdx, 2;
          call user_read_bytes_via_walk;
          cmp rax, 0;
          jne m3_005_pci_rpc_witness_fail;

          lea r10, [rip + _pci_witness_verify_scratch];
          xor rax, rax;
          mov_w rax, [r10];                        // rax = n_devices (u16)
          cmp rax, 4;
          jb m3_005_pci_rpc_witness_fail;
          jmp m3_005_op_extra_done;

      m3_005_op2_check:
          // Op=2 device_info: verify _pci_witness_reply_len == 64.
          mov rax, [rip + _pci_witness_reply_len];
          cmp rax, 64;
          jne m3_005_pci_rpc_witness_fail;
          jmp m3_005_op_extra_done;

      m3_005_op3_check:
          // Op=3 get_bar_cap: verify _pci_witness_reply_len == 40.
          mov rax, [rip + _pci_witness_reply_len];
          cmp rax, 40;
          jne m3_005_pci_rpc_witness_fail;

      m3_005_op_extra_done:
          // Next op.
          add r13, 1;
          jmp m3_005_pci_rpc_op_loop;

      m3_005_pci_rpc_ops_done:
          // Cleanup — free both endpoints.
          mov r11, 90;
          lea rcx, [rip + _pci_witness_stage];
          mov [rcx], r11;

          mov rdi, rbx;
          call endpoint_free;
          mov rdi, r15;
          call endpoint_free;

          // TSC delta gate: max_delta must be < 2M ticks (~1 ms @ 2 GHz TSC).
          // Same threshold as the ACPI witness — comfortable margin above
          // the substrate's ~30 k-tick expected roundtrip cost. Above 2 M
          // means either the pci_enum_* dispatch spinlooped or the walker
          // degraded catastrophically — both are substrate bugs worth
          // failing on.
          mov r11, 91;
          lea rcx, [rip + _pci_witness_stage];
          mov [rcx], r11;

          mov rax, [rip + _pci_witness_max_delta];
          mov r10, 2000000;                        // PCI_RPC_TSC_MAX
          cmp rax, r10;
          ja m3_005_pci_rpc_witness_fail;

          // Success marker: "R20b PCI RPC OK".
          mov rdi, 3;                              // LEVEL_INFO
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + pci_rpc_ok_msg];
          call klog_s1;
          jmp m3_005_pci_rpc_witness_done;

      m3_005_pci_rpc_witness_fail:
          // Emit "R20b PCI RPC FAIL" with the stage as a decimal KV.
          lea rax, [rip + _pci_witness_stage];
          mov r8, [rax];                           // r8 = stage
          mov rdi, 1;                              // LEVEL_ERROR
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + pci_rpc_fail_msg];
          lea rcx, [rip + k_line];                 // reuse "line" key
          call klog_s1_d1;

      m3_005_pci_rpc_witness_done:
          pop r15;
          pop r13;
          pop rbx;

      // ============================================================
      // R29.M7-001/004/005 (#1044/#1047/#1048): cascade-restart witness.
      //
      // Closes the R29.M7 restart MECHANISM (the chaos harness #1045 and
      // the post-restart accounting #1046 are written against it next).
      // Design: design/drivers/cascade-restart.md.
      //
      // Placement — LAST witness before ring-3 entry, and deliberately
      // so. Every other R29 witness is table-level and runs in the
      // pre-scheduler block; this one is the only one that needs a live
      // scheduler, because proving that a client blocked on a dead
      // driver's endpoint is WOKEN (rather than left hanging) means
      // driving sched_wake and observing the runqueue. That is only
      // meaningful after process_init has published _current_tcb and
      // enqueued init. It also means the witness must leave the runqueue
      // exactly as it found it — sub-test 30 dequeues the fake task
      // before ring-3 entry, mirroring sys_ipc_send_witness sub-test 15.
      //
      // The tree (slots 8..11, none of which any earlier witness uses —
      // the lifecycle / registry witnesses take 0, 1 and 5, and all
      // unregister; sub-test 0 pre-cleans anyway):
      //
      //          8  (root — stands in for a bus enumerator)
      //         / \
      //        9   11   <- 9 and 11 are SIBLINGS
      //        |
      //       10        <- 10 is 9's child
      //
      // Node 9 dies. The one-for-one strategy predicts an exact outcome,
      // and the witness asserts every part of it:
      //
      //   kill set    = {9, 10}     — the subtree, because 10's authority
      //                              was derived from 9's and is already
      //                              revoked at the capability layer.
      //   restart set = {9}         — 10 is unregistered, NOT restarted;
      //                              the restarted 9 re-enumerates it.
      //   untouched   = {8, 11}     — 11 is the load-bearing assertion.
      //                              One-for-all would have killed it;
      //                              it survives because siblings share
      //                              no writable object under R29's
      //                              capability partitioning.
      //
      // Sub-tests (stage index in _r29_restart_wit_stage; any failure
      // jumps to r29_restart_witness_fail with the stage):
      //
      //   0.  Pre-clean slots 8..11 (idempotent).
      //   1.  Register 8, 9, 10, 11.
      //   2.  Build the tree: 9->8, 10->9, 11->8.
      //   3.  Cycle refusal: set_parent(8, 10) -> ERR_CYCLE (10 is a
      //       descendant of 8, so the edge would close a loop).
      //   4.  Self-edge refusal: set_parent(9, 9) -> ERR_CYCLE.
      //   5.  subtree_mask(9) == 0x600 ({9,10}); mask(8) == 0xF00.
      //   6.  parent(9) == 8; parent(8) == PARENT_NONE (forest root).
      //   7.  Start all four: Init -> Running.
      //   8.  Bind one endpoint per node to 9, 10 and 11 at incarnation 0.
      //   9.  attach_ok(ep_child, 9, 0) == 1 — the live-binding baseline.
      //   10. Park a fake TCB (state WAITING) on 9's endpoint — a client
      //       blocked in recv.
      //   11. Snapshot the audit sequence.
      //   12. driver_restart_node(9) -> DRV_RESTART_OK.
      //   13. get_state(9) == Init — re-armed.
      //   14. incarnation(9) == 1 — a NEW life, not a resurrected one.
      //   15. restart_count(9) == 1 — charged against the budget.
      //   16. slot 10 no longer in_use — descendant unregistered.
      //   17. get_state(11) == Running — THE one-for-one assertion.
      //   18. get_state(8) == Running — the supervisor is untouched.
      //   19. parent(9) == 8 — the supervision edge survives a restart.
      //   20. ep_child is dead.
      //   21. ep_child's waiter slot is detached.
      //   22. fake TCB state == RUNNABLE — the blocked client was WOKEN.
      //   23. ep_gc (10's channel) is dead — the cascade reached it.
      //   24. ep_sib (11's channel) is ALIVE — the cascade did not.
      //   25. sys_ipc_recv_body on the dead endpoint returns -ECONNRESET
      //       AND RETURNS AT ALL. Without the ChannelDead gate this call
      //       would find the endpoint empty and enter sched_block with no
      //       wake source remaining — i.e. the boot would hang here. A
      //       returning call IS the no-hang proof.
      //   26. sys_ipc_send_body likewise.
      //   27. Stale-capability refusal: bind(ep_child, 9, 1) ->
      //       EP_BIND_ERR_DEAD. The restarted incarnation cannot inherit
      //       the channel its predecessor served.
      //   28. attach_ok(ep_child, 9, 1) == 0 — the incarnation clause
      //       refuses independently of the dead latch.
      //   29. A FRESH endpoint binds and attaches at incarnation 1, and
      //       has a different id — the reconnect path.
      //   30. runq_dequeue the fake task (runqueue hygiene before ring-3).
      //   31. Restarts 2..5 all succeed; restart_count reaches 5.
      //   32. Restart 6 -> DRV_RESTART_ESCALATED.
      //   33. perm_failed(9) == 1.
      //   34. get_state(9) == Stopped — escalation left the node in the
      //       FSM's own terminal state, reached through the whitelist.
      //   35. transition(9, Running) -> ERR_INVALID_TRANSITION — Stopped
      //       is still terminal; escalation invented no state.
      //   36. rearm_incarnation(9) -> REARM_PERM_FAILED — terminality is
      //       enforced at the STORE, not merely by the restart driver.
      //   37. driver_restart_node(9) -> ERR_PERM_FAILED — refused up
      //       front, so a crash loop pays nothing after escalation.
      //   38. Audit: the sequence advanced, and the ring's gap and seal
      //       chains are both intact across the whole storm.
      //   39. Cleanup: free the four endpoints, unregister 8, 9, 11.
      //
      // Register discipline: r12 is init's TCB and is NOT touched. The
      // four registers pushed (rbx/r13/r14/r15) are an EVEN count, which
      // preserves kernel_main's ambient stack alignment for the nested
      // calls; r13/r14 additionally carry init's entry_rip / initial_rsp
      // for the enter_userland_initial call below and MUST be restored.
      //   rbx = driver slot 9 (the node that dies)
      //   r13 = ep_child (endpoint bound to 9)
      //   r14 = ep_sib   (endpoint bound to 11)
      //   r15 = scratch / row PA / restart loop counter
      // ep_gc, the fresh endpoint id and the audit snapshot live in .bss.
      // ============================================================
      r29_cascade_restart_witness:
          push rbx;
          push r13;
          push r14;
          push r15;

          mov rbx, 9;                              // the node that dies

          // -- Sub-test 0: idempotent pre-clean of slots 8..11.
          xor rax, rax;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          mov rdi, 8;
          call driver_table_unregister;
          mov rdi, 9;
          call driver_table_unregister;
          mov rdi, 10;
          call driver_table_unregister;
          mov rdi, 11;
          call driver_table_unregister;

          // -- Sub-test 1: register the four nodes.
          mov rax, 1;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          mov rdi, 8;
          mov rsi, 800;
          lea rdx, [rip + r29_restart_wit_name];
          xor rcx, rcx;
          call driver_table_register;
          cmp rax, 0;
          jne r29_restart_witness_fail;

          mov rdi, 9;
          mov rsi, 900;
          lea rdx, [rip + r29_restart_wit_name];
          xor rcx, rcx;
          call driver_table_register;
          cmp rax, 0;
          jne r29_restart_witness_fail;

          mov rdi, 10;
          mov rsi, 1000;
          lea rdx, [rip + r29_restart_wit_name];
          xor rcx, rcx;
          call driver_table_register;
          cmp rax, 0;
          jne r29_restart_witness_fail;

          mov rdi, 11;
          mov rsi, 1100;
          lea rdx, [rip + r29_restart_wit_name];
          xor rcx, rcx;
          call driver_table_register;
          cmp rax, 0;
          jne r29_restart_witness_fail;

          // -- Sub-test 2: build the supervisor tree.
          mov rax, 2;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          mov rdi, 9;
          mov rsi, 8;
          call driver_sup_set_parent;
          cmp rax, 0;
          jne r29_restart_witness_fail;

          mov rdi, 10;
          mov rsi, 9;
          call driver_sup_set_parent;
          cmp rax, 0;
          jne r29_restart_witness_fail;

          mov rdi, 11;
          mov rsi, 8;
          call driver_sup_set_parent;
          cmp rax, 0;
          jne r29_restart_witness_fail;

          // -- Sub-test 3: an edge that would close a cycle is refused.
          //    8 -> 10 would loop, because 10 is already below 8.
          mov rax, 3;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          mov rdi, 8;
          mov rsi, 10;
          call driver_sup_set_parent;
          mov r15, 0xFFFFFFB7;                     // DRV_RESTART_ERR_CYCLE
          cmp rax, r15;
          jne r29_restart_witness_fail;

          // -- Sub-test 4: the degenerate cycle — a self-edge.
          mov rax, 4;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          mov rdi, 9;
          mov rsi, 9;
          call driver_sup_set_parent;
          mov r15, 0xFFFFFFB7;                     // DRV_RESTART_ERR_CYCLE
          cmp rax, r15;
          jne r29_restart_witness_fail;

          // -- Sub-test 5: subtree masks.
          mov rax, 5;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          mov rdi, 9;
          call driver_sup_subtree_mask;
          mov r15, 0x600;                          // {9, 10}
          cmp rax, r15;
          jne r29_restart_witness_fail;

          mov rdi, 8;
          call driver_sup_subtree_mask;
          mov r15, 0xF00;                          // {8, 9, 10, 11}
          cmp rax, r15;
          jne r29_restart_witness_fail;

          // -- Sub-test 6: parent decoding, including the forest root.
          mov rax, 6;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          mov rdi, 9;
          call driver_sup_parent;
          cmp rax, 8;
          jne r29_restart_witness_fail;

          mov rdi, 8;
          call driver_sup_parent;
          mov r15, 0xFFFFFFFFFFFFFFFF;             // DRV_RESTART_PARENT_NONE
          cmp rax, r15;
          jne r29_restart_witness_fail;

          // Detaching a node makes it a forest root and shrinks its old
          // supervisor's subtree — the inverse of sub-test 2, asserted
          // through the mask so the edge removal is observed by the same
          // walk the cascade will use rather than by reading back the
          // field we just wrote.
          mov rdi, 11;
          call driver_sup_clear_parent;

          mov rdi, 11;
          call driver_sup_parent;
          mov r15, 0xFFFFFFFFFFFFFFFF;             // DRV_RESTART_PARENT_NONE
          cmp rax, r15;
          jne r29_restart_witness_fail;

          mov rdi, 8;
          call driver_sup_subtree_mask;
          mov r15, 0x700;                          // {8, 9, 10} — 11 detached
          cmp rax, r15;
          jne r29_restart_witness_fail;

          // Re-attach for the rest of the witness.
          mov rdi, 11;
          mov rsi, 8;
          call driver_sup_set_parent;
          cmp rax, 0;
          jne r29_restart_witness_fail;

          mov rdi, 8;
          call driver_sup_subtree_mask;
          mov r15, 0xF00;                          // {8, 9, 10, 11} again
          cmp rax, r15;
          jne r29_restart_witness_fail;

          // -- Sub-test 7: start all four (Init -> Running).
          mov rax, 7;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          mov rdi, 8;
          mov rsi, 1;                              // DRIVER_STATE_RUNNING
          call driver_lifecycle_transition;
          cmp rax, 0;
          jne r29_restart_witness_fail;

          mov rdi, 9;
          mov rsi, 1;
          call driver_lifecycle_transition;
          cmp rax, 0;
          jne r29_restart_witness_fail;

          mov rdi, 10;
          mov rsi, 1;
          call driver_lifecycle_transition;
          cmp rax, 0;
          jne r29_restart_witness_fail;

          mov rdi, 11;
          mov rsi, 1;
          call driver_lifecycle_transition;
          cmp rax, 0;
          jne r29_restart_witness_fail;

          // -- Sub-test 8: one client channel per node, at incarnation 0.
          mov rax, 8;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          call endpoint_alloc;
          mov r15, 0xFFFFFFFFFFFFFFFF;             // ENDPOINT_ALLOC_NONE
          cmp rax, r15;
          je  r29_restart_witness_fail;
          mov r13, rax;                            // ep_child (driver 9)

          mov rdi, r13;
          mov rsi, 9;
          xor rdx, rdx;                            // incarnation 0
          call endpoint_bind_driver;
          cmp rax, 0;
          jne r29_restart_witness_fail;

          call endpoint_alloc;
          mov r15, 0xFFFFFFFFFFFFFFFF;
          cmp rax, r15;
          je  r29_restart_witness_fail;
          lea rcx, [rip + _r29_restart_wit_ep_gc];
          mov [rcx], rax;                          // ep_gc (driver 10)

          mov rdi, rax;
          mov rsi, 10;
          xor rdx, rdx;
          call endpoint_bind_driver;
          cmp rax, 0;
          jne r29_restart_witness_fail;

          call endpoint_alloc;
          mov r15, 0xFFFFFFFFFFFFFFFF;
          cmp rax, r15;
          je  r29_restart_witness_fail;
          mov r14, rax;                            // ep_sib (driver 11)

          mov rdi, r14;
          mov rsi, 11;
          xor rdx, rdx;
          call endpoint_bind_driver;
          cmp rax, 0;
          jne r29_restart_witness_fail;

          // -- Sub-test 9: the live-binding baseline.
          mov rax, 9;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          mov rdi, r13;
          mov rsi, 9;
          xor rdx, rdx;
          call endpoint_attach_ok;
          cmp rax, 1;
          jne r29_restart_witness_fail;

          // -- Sub-test 10: park a blocked client on 9's endpoint.
          //    Pre-flip the fake TCB to STATE_WAITING (2) so sched_wake's
          //    #663 early-exit guard does not swallow the wake.
          mov rax, 10;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          mov rdi, r13;
          call endpoint_lookup;                    // rax = row PA
          cmp rax, 0;
          je  r29_restart_witness_fail;
          mov r15, rax;

          lea r10, [rip + _r29_restart_wit_fake_tcb];
          mov rcx, 2;                              // STATE_WAITING
          mov [r10 + 8], ecx;                      // fake_tcb.state (u32 @+8)
          mov [r15 + 32], r10;                     // ENDPOINT_OFF_WAITER_TCB

          // -- Sub-test 11: snapshot the audit sequence.
          mov rax, 11;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          call drv_audit_seq;
          lea rcx, [rip + _r29_restart_wit_seq];
          mov [rcx], rax;

          // -- Sub-test 12: node 9 dies. Restart it.
          mov rax, 12;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          mov rdi, rbx;                            // slot 9
          call driver_restart_node;
          cmp rax, 0;                              // DRV_RESTART_OK
          jne r29_restart_witness_fail;

          // -- Sub-test 13: 9 is re-armed at Init.
          mov rax, 13;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          mov rdi, rbx;
          call driver_lifecycle_get_state;
          cmp rax, 0;                              // DRIVER_STATE_INIT
          jne r29_restart_witness_fail;

          // -- Sub-test 14: it is a NEW life, not a resurrected one.
          mov rax, 14;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          mov rdi, rbx;
          call driver_sup_incarnation;
          cmp rax, 1;
          jne r29_restart_witness_fail;

          // -- Sub-test 15: charged against the budget.
          mov rax, 15;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          mov rdi, rbx;
          call driver_sup_restart_count;
          cmp rax, 1;
          jne r29_restart_witness_fail;

          // -- Sub-test 16: the descendant was unregistered, not restarted.
          mov rax, 16;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          mov rdi, 10;
          call driver_table_slot_in_use;
          cmp rax, 0;
          jne r29_restart_witness_fail;

          // -- Sub-test 17: THE one-for-one assertion — the sibling lives.
          //    One-for-all would have stopped 11 here.
          mov rax, 17;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          mov rdi, 11;
          call driver_lifecycle_get_state;
          cmp rax, 1;                              // still DRIVER_STATE_RUNNING
          jne r29_restart_witness_fail;

          // -- Sub-test 18: the supervisor above is untouched.
          mov rax, 18;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          mov rdi, 8;
          call driver_lifecycle_get_state;
          cmp rax, 1;                              // DRIVER_STATE_RUNNING
          jne r29_restart_witness_fail;

          // -- Sub-test 19: the supervision edge survived the restart.
          mov rax, 19;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          mov rdi, rbx;
          call driver_sup_parent;
          cmp rax, 8;
          jne r29_restart_witness_fail;

          // -- Sub-test 20: 9's channel is dead.
          mov rax, 20;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          mov rdi, r13;
          call endpoint_is_dead;
          cmp rax, 1;
          jne r29_restart_witness_fail;

          // -- Sub-test 21: the waiter slot was detached.
          mov rax, 21;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          mov rdi, r13;
          call endpoint_lookup;
          cmp rax, 0;
          je  r29_restart_witness_fail;
          mov r15, [rax + 32];                     // ENDPOINT_OFF_WAITER_TCB
          cmp r15, 0;
          jne r29_restart_witness_fail;

          // -- Sub-test 22: the blocked client was WOKEN, not left hanging.
          mov rax, 22;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          lea r10, [rip + _r29_restart_wit_fake_tcb];
          xor rax, rax;
          mov eax, [r10 + 8];                      // fake_tcb.state (u32)
          cmp rax, 1;                              // STATE_RUNNABLE
          jne r29_restart_witness_fail;

          // -- Sub-test 23: the cascade reached the descendant's channel.
          mov rax, 23;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          lea rcx, [rip + _r29_restart_wit_ep_gc];
          mov rdi, [rcx];
          call endpoint_is_dead;
          cmp rax, 1;
          jne r29_restart_witness_fail;

          // -- Sub-test 24: and did NOT reach the sibling's.
          mov rax, 24;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          mov rdi, r14;
          call endpoint_is_dead;
          cmp rax, 0;
          jne r29_restart_witness_fail;

          // -- Sub-test 25: recv on a dead endpoint returns ChannelDead.
          //    That this call RETURNS AT ALL is the no-hang proof: the
          //    endpoint is empty, so without the ChannelDead gate the
          //    body would install a waiter and sched_block with no wake
          //    source left in the system. The user-VA arguments are zero
          //    because the gate fires before any walker touches them.
          mov rax, 25;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          mov rdi, r13;
          xor rsi, rsi;
          xor rdx, rdx;
          xor rcx, rcx;
          call sys_ipc_recv_body;
          mov r15, 0xFFFFFFFFFFFFFF98;             // -ECONNRESET
          cmp rax, r15;
          jne r29_restart_witness_fail;

          // -- Sub-test 26: send to a dead endpoint likewise — a silent
          //    OK here would leave the client believing its request was
          //    accepted by a driver that no longer exists.
          mov rax, 26;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          mov rdi, r13;
          xor rsi, rsi;
          xor rdx, rdx;
          xor rcx, rcx;
          call sys_ipc_send_body;
          mov r15, 0xFFFFFFFFFFFFFF98;             // -ECONNRESET
          cmp rax, r15;
          jne r29_restart_witness_fail;

          // -- Sub-test 27: THE stale-capability refusal. The restarted
          //    incarnation cannot re-attach the channel its predecessor
          //    served — a dead endpoint is never revived.
          mov rax, 27;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          mov rdi, r13;
          mov rsi, 9;
          mov rdx, 1;                              // the NEW incarnation
          call endpoint_bind_driver;
          cmp rax, 3;                              // EP_BIND_ERR_DEAD
          jne r29_restart_witness_fail;

          // -- Sub-test 28: and the incarnation clause refuses on its
          //    own, independently of the dead latch.
          mov rax, 28;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          mov rdi, r13;
          mov rsi, 9;
          mov rdx, 1;
          call endpoint_attach_ok;
          cmp rax, 0;
          jne r29_restart_witness_fail;

          // -- Sub-test 29: the reconnect path — a FRESH endpoint, with a
          //    different id, binds and attaches at incarnation 1.
          mov rax, 29;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          call endpoint_alloc;
          mov r15, 0xFFFFFFFFFFFFFFFF;
          cmp rax, r15;
          je  r29_restart_witness_fail;
          cmp rax, r13;
          je  r29_restart_witness_fail;            // must NOT recycle the dead id
          lea rcx, [rip + _r29_restart_wit_ep_new];
          mov [rcx], rax;

          mov rdi, rax;
          mov rsi, 9;
          mov rdx, 1;
          call endpoint_bind_driver;
          cmp rax, 0;
          jne r29_restart_witness_fail;

          lea rcx, [rip + _r29_restart_wit_ep_new];
          mov rdi, [rcx];
          mov rsi, 9;
          mov rdx, 1;
          call endpoint_attach_ok;
          cmp rax, 1;
          jne r29_restart_witness_fail;

          // -- Sub-test 30: runqueue hygiene. The woken fake task must
          //    not be pickable at ring-3 entry.
          mov rax, 30;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          lea rdi, [rip + _r29_restart_wit_fake_tcb];
          call runq_dequeue;

          // -- Sub-test 31: restarts 2..5 stay inside the budget. Each
          //    walks Init -> Stopping -> Stopped -> (re-arm) Init, which
          //    also exercises the Init -> Stopping edge this landing
          //    added to DRIVER_LIFECYCLE_TABLE.
          mov rax, 31;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          xor r15, r15;

      r29_restart_burst:
          cmp r15, 4;
          jae r29_restart_burst_done;

          mov rdi, rbx;
          call driver_restart_node;
          cmp rax, 0;                              // DRV_RESTART_OK
          jne r29_restart_witness_fail;

          add r15, 1;
          jmp r29_restart_burst;

      r29_restart_burst_done:
          mov rdi, rbx;
          call driver_sup_restart_count;
          cmp rax, 5;                              // DRV_RESTART_MAX_INTENSITY
          jne r29_restart_witness_fail;

          // -- Sub-test 32: the sixth restart inside the window escalates.
          mov rax, 32;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          mov rdi, rbx;
          call driver_restart_node;
          mov r15, 0xFFFFFFB3;                     // DRV_RESTART_ESCALATED
          cmp rax, r15;
          jne r29_restart_witness_fail;

          // -- Sub-test 33: the escalation latch is set.
          mov rax, 33;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          mov rdi, rbx;
          call driver_sup_perm_failed;
          cmp rax, 1;
          jne r29_restart_witness_fail;

          // -- Sub-test 34: escalation invented no state — the node sits
          //    in the FSM's own terminal state, reached through the
          //    whitelist by the ordinary Stopping -> Stopped edge.
          mov rax, 34;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          mov rdi, rbx;
          call driver_lifecycle_get_state;
          cmp rax, 5;                              // DRIVER_STATE_STOPPED
          jne r29_restart_witness_fail;

          // -- Sub-test 35: and Stopped is still terminal.
          mov rax, 35;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          mov rdi, rbx;
          mov rsi, 1;                              // DRIVER_STATE_RUNNING
          call driver_lifecycle_transition;
          mov r15, 0xFFFFFF03;                     // ERR_INVALID_TRANSITION
          cmp rax, r15;
          jne r29_restart_witness_fail;

          // -- Sub-test 36: terminality is enforced at the STORE. Even a
          //    caller that bypasses the restart driver entirely cannot
          //    re-arm a permanently-failed descriptor.
          mov rax, 36;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          mov rdi, rbx;
          call driver_table_rearm_incarnation;
          mov r15, 0xFFFFFEF7;                     // REARM_PERM_FAILED
          cmp rax, r15;
          jne r29_restart_witness_fail;

          // -- Sub-test 37: and the restart driver refuses up front, so a
          //    crash loop pays nothing once escalation has landed.
          mov rax, 37;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          mov rdi, rbx;
          call driver_restart_node;
          mov r15, 0xFFFFFFB2;                     // DRV_RESTART_ERR_PERM_FAILED
          cmp rax, r15;
          jne r29_restart_witness_fail;

          // -- Sub-test 38: the audit ring recorded the whole storm, and
          //    its gap + seal chains survived it.
          mov rax, 38;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          call drv_audit_seq;
          lea rcx, [rip + _r29_restart_wit_seq];
          mov r15, [rcx];
          cmp rax, r15;
          jbe r29_restart_witness_fail;            // must have advanced

          call drv_audit_gap_check;
          cmp rax, 0;
          jne r29_restart_witness_fail;

          call drv_audit_seal_check;
          cmp rax, 0;
          jne r29_restart_witness_fail;

          // -- Sub-test 39: leave no state behind for ring-3.
          mov rax, 39;
          lea rcx, [rip + _r29_restart_wit_stage];
          mov [rcx], rax;

          mov rdi, r13;
          call endpoint_free;
          mov rdi, r14;
          call endpoint_free;
          lea rcx, [rip + _r29_restart_wit_ep_gc];
          mov rdi, [rcx];
          call endpoint_free;
          lea rcx, [rip + _r29_restart_wit_ep_new];
          mov rdi, [rcx];
          call endpoint_free;

          mov rdi, 8;
          call driver_table_unregister;
          mov rdi, 9;
          call driver_table_unregister;
          mov rdi, 11;
          call driver_table_unregister;

          // Success marker: R29 CASCADE RESTART OK.
          mov rdi, 3;                              // LEVEL_INFO
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + r29_restart_ok_msg];
          call klog_s1;
          jmp r29_cascade_restart_witness_done;

      r29_restart_witness_fail:
          lea rax, [rip + _r29_restart_wit_stage];
          mov r8, [rax];
          mov rdi, 1;                              // LEVEL_ERROR
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + r29_restart_fail_msg];
          lea rcx, [rip + k_line];
          call klog_s1_d1;

      r29_cascade_restart_witness_done:
          pop r15;
          pop r14;
          pop r13;
          pop rbx;

      // ============================================================
      // R29.M7-002/003 (#1045/#1046): the chaos harness.
      //
      // Under test: src/kernel/core/driver/chaos.pdx, which is itself
      // an adversary against src/kernel/core/driver/restart.pdx and
      // src/kernel/core/driver/audit_channel.pdx.
      // Design: design/drivers/cascade-restart.md §Verification.
      //
      // The witness immediately above proves the cascade-restart
      // mechanism does the right thing ONCE, from a clean table, with
      // the driver at rest. This one attacks all three of those
      // qualifiers at the same time:
      //
      //   ONCE     -> 100 kills per victim position, 300 in total, each
      //               re-sampling its own baseline so the CYCLE INDEX at
      //               which accounting first drifts is reported rather
      //               than inferred from a single end-state.
      //   CLEAN    -> descriptor conservation and audit reconciliation
      //               are re-checked after every kill, not once at the
      //               end. A leak of one row per restart is invisible in
      //               a single-shot witness and fatal in a live system.
      //   AT REST  -> every kill lands with a client parked in
      //               STATE_WAITING inside the victim's endpoint waiter
      //               slot and an undrained published message on a
      //               second victim endpoint. Killing an idle driver
      //               tests the easy case; every hazard in §6 of the
      //               design is a mid-operation hazard.
      //
      // Why it runs HERE, after the mechanism witness and before ring-3:
      // it needs the same live scheduler (proving the parked client is
      // woken means driving sched_wake and observing the runqueue), and
      // it needs the mechanism witness to have already unregistered its
      // own slots 8..11. The harness works in slots 12..15, pre-cleans
      // them per role, and leaves the driver table, endpoint table,
      // capability table and runqueue exactly as it found them — the
      // per-cycle census in phase 14 is what enforces that, not a
      // promise in this comment.
      //
      // Register discipline: NO pushes here. drv_chaos_run preserves
      // rbx and r12..r15 itself, so init's TCB (r12), entry_rip (r13)
      // and initial_rsp (r14) survive the call untouched. That is a
      // property of the SysV contract the harness observes, and the
      // ring-3 entry immediately below is what would notice if it did
      // not.
      //
      // Cost: the full 300-kill run is pure table churn — no MMIO, no
      // serial output inside the loop, and deliberately no DMA domain
      // on the fixture drivers (attaching one would put
      // driver_lifecycle_teardown's klog audit line inside the inner
      // loop and turn 300 restarts into 300 serial writes). It is why
      // the FULL count runs in the default smoke matrix rather than
      // behind an opt-in gate.
      //
      // On failure the log carries role, cycle and phase as three
      // decimal fields; the returned code names the invariant
      // (DRV_CHAOS_ERR_* in chaos.pdx).
      // ============================================================
      r29_chaos_witness:
          mov rdi, 100;                            // DRV_CHAOS_CYCLES_FULL
          call drv_chaos_run;
          cmp rax, 0;                              // DRV_CHAOS_OK
          jne r29_chaos_witness_fail;

          mov rdi, 3;                              // LEVEL_INFO
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + r29_chaos_ok_msg];
          call klog_s1;
          jmp r29_chaos_witness_done;

      r29_chaos_witness_fail:
          lea rax, [rip + _drv_chaos_role];
          mov r8, [rax];
          mov rdi, 1;                              // LEVEL_ERROR
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + r29_chaos_fail_msg];
          lea rcx, [rip + r29_chaos_k_role];
          call klog_s1_d1;

          lea rax, [rip + _drv_chaos_cycle_idx];
          mov r8, [rax];
          mov rdi, 1;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + r29_chaos_fail_msg];
          lea rcx, [rip + r29_chaos_k_cycle];
          call klog_s1_d1;

          lea rax, [rip + _drv_chaos_stage];
          mov r8, [rax];
          mov rdi, 1;
          lea rsi, [rip + SUBSYS_BOOT];
          lea rdx, [rip + r29_chaos_fail_msg];
          lea rcx, [rip + r29_chaos_k_phase];
          call klog_s1_d1;

      r29_chaos_witness_done:

      // Interrupts on — safe now that _current_tcb points at a valid TCB.
      // sti last so no ISR can race with the INIT BOOT OK emit.
      sti;

      // Enter ring-3. Same pattern as #652 witness: VA→PA convert user_pml4_pa
      // at the last possible point (mov cr3 needs a real physical address).
      // enter_userland_initial takes (entry_rip, initial_rsp, user_pml4_pa)
      // in rdi/rsi/rdx per SysV. It iretq's into ring-3 and never returns.
      mov rdi, r13;                       // entry_rip
      mov rsi, r14;                       // initial_rsp
      mov rdx, [r12 + 16];                // user_pml4_pa (VA form)
      mov rax, 0xFFFF800000000000;        // KERNEL_VMA_BASE
      sub rdx, rax;                       // rdx = genuine PA for CR3
      call enter_userland_initial;

      // UNREACHABLE — enter_userland_initial iretq's away and never returns.
      mov rdi, 3;
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + init_boot_returned_msg];
      call klog_s1;
      jmp init_boot_hang;

      init_boot_fail:
      mov rdi, 1;                        // level = LEVEL_ERROR = 1 (#704 fix: was 5=TRACE, filtered by KLOG_COMPILE_LEVEL=3, silently dropping all fail-witness output)
      lea rsi, [rip + SUBSYS_BOOT];
      lea rdx, [rip + init_boot_fail_msg];
      call klog_s1;

      init_boot_hang:
      lea rdi, [rip + SUBSYS_BOOT];
      lea rsi, [rip + tag_init_boot_hang];
      call klog_panic;
      jmp init_boot_hang;
    }
  } @no_frame

  // M5-001 (#695): stack-walker witness — 6-slot .bss buf for a synthetic
  // 3-deep rbp chain. Must live in .bss (high-VA, past KERNEL_VMA_BASE
  // 0xFFFF800000000000) so it passes klog_walk_rbp's canonical-VA guard;
  // rsp at witness time is low-VA identity-mapped and would be rejected.
  pub let mut _stack_walk_buf : [u64; 6] = uninit @align(8)

  // R15-M5-007 (#549): fd_table witness task storage
  // Static .bss blob (2224 bytes = 278 u64s) backing the witness task.
  pub let mut _fd_witness_task : [u64; 278] = uninit @align(8)

  // R16-M3-001 (#587): sys_open witness task storage.
  // Static .bss blob (2224 bytes = 278 u64s) backing a dedicated
  // witness task_struct.  Not related to _idle_tcb or _task_pool —
  // same rationale as _fd_witness_task (#549 §4.1): witness storage
  // stays independent of the scheduler init sequence so R16.M3
  // witnesses run before idle_init / runq_init without ordering hazards.
  pub let mut _sys_open_witness_task : [u64; 278] = uninit @align(8)

  // R16-M3-002 (#588): sys_close witness task storage.
  // Static .bss blob (2224 bytes = 278 u64s) backing a dedicated
  // witness task_struct.  Not related to _idle_tcb or _task_pool —
  // same rationale as _sys_open_witness_task (#587 §4.1): witness
  // storage stays independent of the scheduler init sequence so
  // R16.M3 witnesses run before idle_init / runq_init without
  // ordering hazards.
  pub let mut _sys_close_witness_task : [u64; 278] = uninit @align(8)

  // R16-M3-003 (#589): sys_read witness task storage.
  // Static .bss blob (2224 bytes = 278 u64s) backing a dedicated
  // witness task_struct.  Same rationale as _sys_open_witness_task
  // (#587 §4.1) and _sys_close_witness_task (#588 §4.1): witness
  // storage stays independent of the scheduler init sequence so
  // R16.M3 witnesses run before idle_init / runq_init without
  // ordering hazards.
  pub let mut _sys_read_witness_task : [u64; 278] = uninit @align(8)

  // R16-M3-004 (#590): sys_write witness task storage.
  // Static .bss blob (2224 bytes = 278 u64s) backing a dedicated
  // witness task_struct. Same rationale as _sys_read_witness_task
  // (#589 §4.1) and _sys_open_witness_task (#587 §4.1): witness
  // storage stays independent of the scheduler init sequence so
  // R16.M3 witnesses run before idle_init / runq_init without
  // ordering hazards.
  pub let mut _sys_write_witness_task : [u64; 278] = uninit @align(8)

