  // _driver_lifecycle_witness_stage above; the fuzz witness writes
  // (iter + 1) into this slot before every inner check so a failure
  // exit prints which iteration tripped (values 1..1000). Zero-init
  // in .bss; overwritten before every jne-to-fail throughout the
  // fuzz loop.
  pub let mut _driver_lifecycle_fuzz_witness_stage : u64 = 0

  // R29.M5-003 (#1038) / R29.M5-004 (#1039): state for the
  // dma_domain_switch_witness. Same memory-backed posture as the
  // trackers above — every value here has to survive the callee-save
  // clobber patterns inside driver_lifecycle_start / _teardown and
  // iommu_domain_switch / _unswitch, all of which spill five callee-save
  // registers.
  //
  // _stage    — sub-test index 1..40; written before every jne-to-fail.
  // _tail_a   — driver A's canonical tail word (ctx 0x1111, bdf 0x0310,
  //             coherent), built once through dma_tail_pack and reused
  //             across both spawn cycles so the second cycle provably
  //             re-mints the SAME domain shape.
  // _tail_b   — driver B's tail word (ctx 0x2222, bdf 0x0400,
  //             non-coherent). Differs from A in every field.
  // _cursor   — loop cursor for the final residue sweep over all 32
  //             domain rows.
  pub let mut _dma_sw_witness_stage  : u64 = 0
  pub let mut _dma_sw_witness_tail_a : u64 = 0
  pub let mut _dma_sw_witness_tail_b : u64 = 0
  pub let mut _dma_sw_witness_cursor : u64 = 0

  // 16-byte NUL-padded driver name for both fake driver processes.
  // driver_table_register reads exactly 16 bytes as two qwords, so the
  // padding is load-bearing — a shorter literal would splice adjacent
  // .rodata into the row's name field.
  pub let _dma_sw_witness_name : [u8; 16] = "dma-domain-sw\0\0\0"

  // R29.M3-001/002 (#1028/#1029): driver registry v2 witness data.
  //
  // _registry_v2_witness_stage: sub-test index 0..26, written before
  //   every gate so the failure path prints which stage tripped (the
  //   stage list is documented at the witness site).
  // _registry_v2_witness_name0 / _name1: 16-byte NUL-padded driver
  //   names handed to driver_table_register. driver_table_register
  //   reads exactly 16 bytes as two qwords, so the padding is
  //   load-bearing, not cosmetic — a shorter literal would splice
  //   adjacent .rodata into the row's name field. Stage 19 reloads
  //   the first qword of _name0 and compares it against the decoded
  //   record's name_lo, which is what makes the round-trip assertion
  //   about the ORIGINAL name rather than merely self-consistent.
  pub let mut _registry_v2_witness_stage : u64 = 0
  pub let _registry_v2_witness_name0 : [u8; 16] = "uart-16550\0\0\0\0\0\0"
  pub let _registry_v2_witness_name1 : [u8; 16] = "nvme-pcie\0\0\0\0\0\0\0"

