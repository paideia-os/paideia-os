  // Static .bss slot (8 bytes) used to test the "mov_w [mem], rN" write pattern.
  // Seeded to 0xDEADBEEFCAFEBABE, then a 2-byte store writes 0x1234 at offset +0.
  // Expected result: 0xDEADBEEFCAFE1234 (top 6 bytes unchanged).
  pub let mut _wsl_probe : u64 = uninit @align(8)

  // R17-M2-005 (#620): published by init_bootstrap for Tier 2 pickup.
  // Holds the slab pointer to init task_struct (output of task_new(NULL)).
  pub let mut _init_task : u64 = 0

  // R20b.M2-001 (#1555): 8-byte scratch buffer for frame_encode / frame_decode
  // round-trip witness. Sized as [u64; 1] @align(8) — one u64 covers the full
  // 8-byte header per acpi-supervisor-schema §3, and 8-byte alignment matches
  // the natural x86-64 u64 store/load frame_encode/frame_decode use. Lives in
  // .bss (uninit); the witness's first sub-test pre-fills a sentinel before
  // any encode so an accidental read-before-encode would produce a distinct
  // failure signature.
  pub let mut _frame_witness_buf : [u64; 1] = uninit @align(8)

  // R20b.M2-001 (#1555): sub-test stage tracker for the frame_witness.
