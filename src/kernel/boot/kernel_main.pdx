  // R29.M4-003/004 (#1034/#1035): blob dual-signature witness data.
  //
  // _blob_witness_stage: sub-test index 0..34, written before every gate
  //   so the failure path names the stage that tripped (map at the
  //   witness site).
  // _blob_witness_blob: 64 bytes standing in for a firmware blob.
  //   Deliberately NON-zero, for the same reason _sig_witness_artifact
  //   is: the verifier's terminal branches key on SIGNATURE fields being
  //   all zero, and an all-zero blob would leave open the question of
  //   which buffer a scan actually read.
  // _blob_witness_manifest: the parsed manifest, 848 u64 = 6784 bytes
  //   (blob-policy §1.3.1). Uninitialised and built field-by-field at
  //   witness entry: the point is to test the verifier, not the
  //   toolchain's data emission, and several stages mutate it in place
  //   and restore it.
  // _blob_witness_hash: 32 bytes standing in for a computed SHA3-256
  //   digest. Driven to a non-matching value (stage 13) and to the
  //   manifest's all-zero blob_hash (stage 14) so both arms of the hash
  //   gate are exercised without a hash primitive existing — SHA3-256 is
  //   an R32 dependency and hand-rolling one here would be the same
  //   mistake sig_verify.pdx refuses to make with the lattice verifier.
  // _blob_witness_snap / _snap2: counter snapshots taken across nested
  //   calls. Kept in .data rather than callee-save registers so the
  //   telemetry assertions do not silently depend on klog's register
  //   discipline.
  //
  // `[0; N]` is used for the zero-filled arrays: paideia-as c036289
  // fixed the repeat-literal defect described above _sig_witness_sig
  // (it emitted a single element), and T0576 now rejects hand-listed
  // arrays whose element count disagrees with the declared arity, which
  // makes the repeat form the safest spelling rather than the dangerous
  // one. _sig_witness_sig above is left hand-listed on purpose — it is
  // the regression marker for that defect.
  pub let mut _blob_witness_stage : u64 = 0

  pub let _blob_witness_blob : [u64; 8] = [
    0x7766554433221100, 0xFFEEDDCCBBAA9988,
    0x78695A4B3C2D1E0F, 0x8877665544332211,
    0x1032547698BADCFE, 0xEFCDAB8967452301,
    0x5A5A5A5A5A5A5A5A, 0xA5A5A5A5A5A5A5A5
  ]

  pub let mut _blob_witness_manifest : [u64; 848] = uninit @align(64)

  pub let mut _blob_witness_hash : [u64; 4] = [0; 4] @align(8)

  pub let mut _blob_witness_snap  : u64 = 0
  pub let mut _blob_witness_snap2 : u64 = 0

  // R29.M6-001..004 (#1040/#1041/#1042/#1043): driver_audit_channel
  // witness scratch.
  //
  // _drv_audit_wit_stage: sub-test index 0..24, written before every
  //   gate so the failure path names the stage that tripped (map at the
  //   witness site).
  // _drv_audit_wit_seq0 / _live0: the baseline pair the reconciliation
  //   is computed against — the audit sequence number and the live
  //   KIND_HW_INTERRUPT descriptor count sampled at the same instant.
  //   Sampling them together is what makes the later equality
  //   `base_live + balance == live_count` meaningful.
  // _drv_audit_wit_snap / _snap2 / _snap3: per-stage snapshots (a saved
  //   record field across a tamper/restore pair, a sequence number, two
  //   per-kind live counts). Kept in .data rather than callee-save
  //   registers for the same reason the blob witness does it: the
  //   assertions must not depend on any callee's register discipline,
  //   least of all the discipline of the code under test.
  pub let mut _drv_audit_wit_stage : u64 = 0

  // R29.M7-001/004/005 (#1044/#1047/#1048): cascade-restart witness storage.
  //
  // The witness runs at the very end of boot, immediately before ring-3
  // entry, because it is the only R29 witness that needs a LIVE
  // scheduler: proving that a blocked client is woken with ChannelDead
  // rather than left hanging means driving sched_wake and observing the
  // runqueue, which is only meaningful after process_init has published
  // _current_tcb and enqueued init. Every earlier R29 witness is
  // table-level and runs in the pre-scheduler block.
  //
  // _r29_restart_wit_fake_tcb mirrors _sys_ipc_send_witness_fake_tcb's
  // 2224-byte (278 u64) TCB shape — the same fixture that witness uses
  // to prove sched_wake's WAITING -> RUNNABLE flip. Reusing the shape
  // rather than the buffer keeps the two witnesses independent: this
  // one runs long after that one has dequeued its own fake task, and
  // sharing storage would couple their cleanup order.
  //
  // Endpoint ids and the pre-witness audit sequence live in .bss rather
  // than callee-save registers because the witness body may only push an
  // EVEN number of registers (kernel_main's ambient stack alignment) and
  // already spends its four on the driver slot and three endpoint ids.
  pub let mut _r29_restart_wit_stage    : u64 = 0
  pub let mut _r29_restart_wit_ep_gc    : u64 = 0
  pub let mut _r29_restart_wit_ep_new   : u64 = 0
  pub let mut _r29_restart_wit_seq      : u64 = 0
  pub let mut _r29_restart_wit_fake_tcb : [u64; 278] = uninit @align(8)
  pub let mut _drv_audit_wit_seq0  : u64 = 0
  pub let mut _drv_audit_wit_live0 : u64 = 0
  pub let mut _drv_audit_wit_snap  : u64 = 0
  pub let mut _drv_audit_wit_snap2 : u64 = 0
  pub let mut _drv_audit_wit_snap3 : u64 = 0

  // R20b.M2-002 (#1556): pending-msg witness scratches.
  //
  // _pending_witness_hdr_buf: 8-byte scratch used by the witness to
  //   frame_encode a real packed header before feeding it into
  //   endpoint_write_pending. One u64 covers the full 8-byte hdr per
  //   acpi-supervisor-schema §3.
  // _pending_witness_src: 32 bytes of "source" payload filled with a
  //   known pattern (0x11..0x30) so the take-side memcpy can be byte-
  //   compared. Sized as [u64; 4] = 32 B, natural alignment.
  // _pending_witness_dst_hdr: 8-byte scratch for endpoint_take_pending's
  //   dst_hdr_ptr output. Pre-filled with a sentinel by the witness so
  //   an incorrect store is easy to spot.
  // _pending_witness_dst: 32 bytes of "destination" payload for take's
  //   copy-out; pre-filled with 0xAA sentinel bytes so a wrong-length or
  //   wrong-content copy produces a distinct failure signature.
  // _pending_witness_stage: sub-test index (0..13); written before every
  //   sub-test so a failure exit prints which one tripped.
  pub let mut _pending_witness_hdr_buf : [u64; 1] = uninit @align(8)
  pub let mut _pending_witness_src     : [u64; 4] = uninit @align(8)
  pub let mut _pending_witness_dst_hdr : [u64; 1] = uninit @align(8)
  pub let mut _pending_witness_dst     : [u64; 4] = uninit @align(8)
  pub let mut _pending_witness_stage   : u64 = 0

  // R20b.M2-003 (#1557): KPTI-safe user<->kernel payload bounce witness
  // scratches. Exercises user_bounce_send / user_bounce_recv against
  // init's REAL user_pml4 mapping, so the walker path (per-byte 4-level
  // walk of _current_tcb.user_pml4_va -> PDPT -> PD -> PT -> frame) is
  // engaged end-to-end. The witness fires after init boot has set
  // _current_tcb = init AND after user_stack_alloc has mapped init's
  // 4-page user stack at [0x7FFFFFFFB000, 0x7FFFFFFFF000).
  //
  // _ipc_bounce_witness_hdr_scratch: 8-byte scratch used by the witness
  //   to frame_encode a real packed header BEFORE walker-writing it out
  //   to the user page. One u64 covers the full 8-byte hdr per
  //   acpi-supervisor-schema.md §3.
  // _ipc_bounce_witness_pattern: 4088 bytes of "source" payload filled
  //   with a known non-zero pattern ((i + 1) & 0xFF, i in 0..4087) so
  //   the take-side memcpy is byte-comparable and distinguishable from
  //   the zero-fill sentinel used to wipe the user page between send
  //   and recv. 511 u64s = 4088 bytes exactly (matches BOUNCE_MAX_PAYLOAD).
  //   Pattern byte 0 = 1, pattern byte 4087 = 4088 & 0xFF = 0xF8 — both
  //   non-zero so a "did recv actually write?" check is unambiguous.
  // _ipc_bounce_witness_zero_scratch: 4096 bytes of zeros (.bss zero-init)
  //   used to wipe the user page between send + recv. Verifies the
  //   subsequent recv actually WRITES hdr + payload BACK (if we skipped
  //   the wipe, the user page would still have the sent pattern and we
  //   couldn't distinguish a working recv from a no-op recv).
  // _ipc_bounce_witness_verify_scratch: 4096 bytes for reading back user
  //   page contents post-recv via user_read_bytes_via_walk so the witness
  //   can byte-compare against the expected hdr + pattern.
  // _ipc_bounce_witness_stage: sub-test index (0..10); written before
  //   every sub-test so a failure exit prints which one tripped.
  pub let mut _ipc_bounce_witness_hdr_scratch    : [u64; 1]   = uninit @align(8)
  pub let mut _ipc_bounce_witness_pattern        : [u64; 511] = uninit @align(8)
  pub let mut _ipc_bounce_witness_zero_scratch   : [u64; 512] = uninit @align(8)
  pub let mut _ipc_bounce_witness_verify_scratch : [u64; 512] = uninit @align(8)
  pub let mut _ipc_bounce_witness_stage          : u64 = 0

  // R20b.M3-001 (#1558): sys_ipc_recv syscall witness scratches. Exercises
  // sys_ipc_recv_body (src/kernel/core/syscall/handlers/sys_ipc_recv.pdx)
  // by pre-loading a pending message via endpoint_write_pending (which is
  // a kernel-VA primitive; no walker on the send-side write path) then
  // calling sys_ipc_recv_body with a raw endpoint_id and init's real
  // user_pml4-mapped VA for hdr + payload sinks. Payload size is 64 bytes
  // (small; distinguishes from ipc_bounce_witness's 4088-byte max-size
  // stress path — a size regression on either witness would surface with
  // distinct sub-test IDs).
  //
  // _sys_ipc_recv_witness_hdr_scratch: 8 bytes for frame_encode's output;
  //   loaded as a u64 into rsi before endpoint_write_pending.
  // _sys_ipc_recv_witness_src: 64-byte kernel-VA payload src filled with
  //   (i + 2) & 0xFF pattern (base 2 not 1 to distinguish from
  //   ipc_bounce_witness's pattern). 8 u64s = 64 bytes exactly.
  // _sys_ipc_recv_witness_zero_scratch: 4096 bytes of zeros used to wipe
  //   init's user page between publish and recv so the verify step
  //   reliably detects a broken writeback.
  // _sys_ipc_recv_witness_verify_scratch: 4096-byte kernel scratch that
  //   user_read_bytes_via_walk copies user-page bytes back into for the
  //   byte-comparison sub-tests.
  // _sys_ipc_recv_witness_stage: 0..10 sub-test index; written before
  //   every sub-test so a fail exit prints which one tripped.
  pub let mut _sys_ipc_recv_witness_hdr_scratch    : [u64; 1]   = uninit @align(8)
  pub let mut _sys_ipc_recv_witness_src            : [u64; 8]   = uninit @align(8)
  pub let mut _sys_ipc_recv_witness_zero_scratch   : [u64; 512] = uninit @align(8)
  pub let mut _sys_ipc_recv_witness_verify_scratch : [u64; 512] = uninit @align(8)
  pub let mut _sys_ipc_recv_witness_stage          : u64 = 0

  // R20b.M3-002 (#1559): sys_ipc_send / sys_ipc_reply witness storage.
  //
  // Exercises the SEND direction — the kernel-side witness prepares the
  // user page with an encoded hdr + payload, invokes sys_ipc_send_body /
  // sys_ipc_reply_body directly with init's real user_pml4-mapped VAs,
  // and verifies the send/reply publish + wake semantics against the
  // acceptance criteria. Payload size is 32 bytes (smaller than the
  // sys_ipc_recv witness's 64 to preserve sub-test-ID discrimination).
  //
  // _sys_ipc_send_witness_hdr_scratch: 8 bytes for frame_encode's output;
  //   the byte pattern is copied to user_va 0x7FFFFFFFB000 before the
  //   send/reply call and re-encoded twice (once for the reply-bit-SET
  //   scenario D, once for the reply-bit-CLEAR scenario E).
  // _sys_ipc_send_witness_src: 32-byte kernel-VA payload src filled with
  //   (i + 5) & 0xFF pattern (base 5 distinguishes from ipc_bounce_witness
  //   base 1 and sys_ipc_recv_witness base 2). 4 u64s = 32 bytes exactly.
  // _sys_ipc_send_witness_zero_scratch: 4096 bytes of zeros used to wipe
  //   init's user page @ 0x7FFFFFFFB000 before publishing hdr + payload.
  // _sys_ipc_send_witness_hdr_take_scratch: 8 bytes for endpoint_take_pending
  //   to write the drained hdr into during the reset-between-scenarios steps.
  // _sys_ipc_send_witness_payload_take_scratch: 4088-byte kernel scratch
  //   for endpoint_take_pending to drain into. Sized to FRAME_MAX_PAYLOAD
  //   (a maximal-legal msg fits) though scenarios A/B/D/E use only 32 bytes.
  // _sys_ipc_send_witness_fake_tcb: 2224-byte (278 u64) blob shaped as a
  //   task_struct slab, used as the fake waiter for scenario C. Zero-init
  //   from .bss; the witness pre-flips state@+8 to STATE_WAITING (2) before
  //   arming endpoint.waiter_tcb so sched_wake's #663 guard proceeds to
  //   the state=RUNNABLE + runq_enqueue path. Size matches the existing
  //   witness-task convention (_fd_witness_task, _sys_open_witness_task,
  //   etc. — all [u64; 278] per task_pool.pdx's 2224-byte slab freeze).
  //   MUST be runq_dequeue'd before enter_userland_initial fires or
  //   sched_pick_next_r15 would return it during ring-3 dispatch and
  //   sched_switch_r15 would try to resume a garbage rip/rsp.
  // _sys_ipc_send_witness_stage: 0..18 sub-test index; written before
  //   every sub-test so a fail exit prints which one tripped via the
  //   sys_ipc_send_fail_msg + line KV.
  pub let mut _sys_ipc_send_witness_hdr_scratch         : [u64; 1]   = uninit @align(8)
  pub let mut _sys_ipc_send_witness_src                 : [u64; 4]   = uninit @align(8)
  pub let mut _sys_ipc_send_witness_zero_scratch        : [u64; 512] = uninit @align(8)
  pub let mut _sys_ipc_send_witness_hdr_take_scratch    : [u64; 1]   = uninit @align(8)
  pub let mut _sys_ipc_send_witness_payload_take_scratch: [u64; 511] = uninit @align(8)
  pub let mut _sys_ipc_send_witness_fake_tcb            : [u64; 278] = uninit @align(8)
  pub let mut _sys_ipc_send_witness_stage               : u64 = 0

  // R20b.M3-003 (#1560): sys_svc_lookup syscall witness storage.
  //
  // Just a single stage tracker — the witness reuses existing broker
  // witness name strings (_svc_broker_witness_name_test /
  // _svc_broker_witness_name_other from boot_stub.S), the existing
  // 4-page user-VA mapping @ 0x7FFFFFFFB000 (established by
  // ipc_bounce_witness via user_stack_alloc), and the body-owned
  // kernel scratch (_sys_svc_lookup_name_scratch in
  // sys_svc_lookup.pdx). No per-witness payload buffers needed —
  // sys_svc_lookup deals only with the 8-char "svc.test" and 9-char
  // "svc.other" names and returns a cap slot id (no bulk transfer).
  //
  // _sys_svc_lookup_witness_stage: 0..10 sub-test index; written before
  //   every sub-test so a fail exit prints which one tripped via the
  //   sys_svc_lookup_fail_msg + line KV.
  pub let mut _sys_svc_lookup_witness_stage             : u64 = 0

  // R20b.M6-002 (#1565): dispatch cap_slot lookup witness storage.
  //
  // Exercises the ipc_slot_to_endpoint helper via the modified
  // dispatch_ipc_recv shim; runs after sys_svc_lookup_witness (which
  // restores the outer r13/r14 pair before jumping into this witness).
  // Reuses init's user-VA mapping @ 0x7FFFFFFFB000 (established by
  // ipc_bounce_witness via user_stack_alloc) for the hdr + payload
  // sink; only the kernel-side hdr / src / wipe scratches are private.
  //
  // _sys_ipc_cap_slot_witness_hdr_scratch: 8 bytes for frame_encode's
  //   packed header output; loaded as u64 into rsi before
  //   endpoint_write_pending.
  // _sys_ipc_cap_slot_witness_src: 32-byte kernel-VA payload src filled
  //   with (i + 7) & 0xFF pattern. Base 7 distinguishes from
  //   ipc_bounce_witness (base 1), sys_ipc_recv_witness (base 2), and
  //   sys_ipc_send_witness (base 5) — a cross-witness bleed on the
  //   verify path shows up immediately as a mismatched leading byte.
  //   4 u64s = 32 bytes exactly.
  // _sys_ipc_cap_slot_witness_zero_scratch: 4096 bytes of zeros used to
  //   wipe init's user page @ 0x7FFFFFFFB000 before the shim call — a
  //   broken shim that skipped writeback surfaces as all-zero on the
  //   endpoint_is_full-driven follow-through check.
  // _sys_ipc_cap_slot_witness_stage: 0..11 sub-test index; written before
  //   every sub-test so a fail exit prints which one tripped via the
  //   sys_ipc_cap_slot_fail_msg + line KV.
  pub let mut _sys_ipc_cap_slot_witness_hdr_scratch  : [u64; 1]   = uninit @align(8)
  pub let mut _sys_ipc_cap_slot_witness_src          : [u64; 4]   = uninit @align(8)
  pub let mut _sys_ipc_cap_slot_witness_zero_scratch : [u64; 512] = uninit @align(8)
  pub let mut _sys_ipc_cap_slot_witness_stage        : u64 = 0

  // R20b.M4-001 (#1561): InitCap sidecar format + validator witness storage.
  //
  // _init_caps_witness_sidecar: 48-byte scratch backing the synthesized
  //   sidecar blob. Layout follows design/loader/init-caps-sidecar.md §3
  //   — 16 header (count in low 16 bits of word 0 + 14 bytes padding)
  //   + 2 * 16 InitCap entries. Sized as [u64; 6] @align(8) since paideia-as
  //   ships every InitCap store as an aligned qword. Lives in .bss (uninit);
  //   the witness's sub-test 0 fills every word before any validate call,
  //   so any read-before-populate would surface as an entry-shape mismatch,
  //   not a UB read of stale bytes.
  pub let mut _init_caps_witness_sidecar : [u64; 6] = uninit @align(8)

  // _init_caps_witness_stage: 0..3 sub-test index; written before every
  //   sub-test so a fail exit prints which one tripped via the
  //   init_caps_fail_msg + line KV. Matches the sys_svc_lookup_witness_stage
  //   idiom immediately above.
  pub let mut _init_caps_witness_stage : u64 = 0

  // R20b.M4-002 (#1562): loader_seed_caps hook witness storage.
  //
  // _loader_seed_witness_sidecar: 32-byte scratch backing the synthesized
  //   1-entry sidecar blob (16 header + 1 * 16 InitCap). Sized as
  //   [u64; 4] @align(8) — same alignment idiom as
  //   _init_caps_witness_sidecar above. Lives in .bss (uninit); the
  //   witness's sub-test 0 populates every word before any
  //   loader_seed_caps call.
  //
  // _loader_seed_witness_fake_task: 8-byte (1 u64) placeholder for the
  //   task_ptr argument. task_ptr is unused at R20b (single global
  //   cap_table per cap/table.pdx §Table); the placeholder ensures a
  //   forward-port to per-task cap_tables (design/capabilities/
  //   per-task-cspace.md) sees a distinct live pointer instead of NULL
  //   in the witness's logs.
  //
  // _loader_seed_witness_stage: 0..1 sub-test index; written before
  //   every sub-test so a fail exit prints which one tripped via the
  //   loader_seed_fail_msg + line KV. Matches the init_caps_witness_stage
  //   idiom immediately above.
  pub let mut _loader_seed_witness_sidecar   : [u64; 4] = uninit @align(8)
  pub let mut _loader_seed_witness_fake_task : [u64; 1] = uninit @align(8)
  pub let mut _loader_seed_witness_stage     : u64 = 0

  // R20b.M6-001 (#1564): loader phase-2 ELF-symbol walker witness storage.
  //
  // _m6_symtab_witness_task: 8-byte (1 u64) holder for the fresh task
  //   slab returned by task_new(NULL). Lives in .bss (uninit); the
  //   witness's sub-test 0 populates it before any elf_lite_load call.
  //   Spilled to .bss (rather than held in r12) because r12/r13/r14
  //   already carry init boot state (init task_slab / entry_rip /
  //   user_rsp_top) that the downstream m5_echo_witness +
  //   enter_userland_initial call chain relies on; a scratch reg holder
  //   would clobber that state. The task slab is not enqueued (no
  //   runq_enqueue call in the M6 witness), so sched_pick_next_r15
  //   cannot return it; the aspace it holds is inert until the R21+
  //   task recycler lands. Matches the "witness allocates but never
  //   schedules" discipline of init_bootstrap's r12 slab (pre-runq_enqueue).
  //
  // _m6_symtab_witness_stage: 0..5 sub-test index; written before every
  //   sub-test so a fail exit prints which one tripped via the
  //   loader_symtab_seed_fail_msg + line KV. Matches the
  //   _loader_seed_witness_stage / _m5_echo_witness_stage idiom above.
  pub let mut _m6_symtab_witness_task  : [u64; 1] = uninit @align(8)
  pub let mut _m6_symtab_witness_stage : u64 = 0

  // R20b.M5-001 (#1563): echo-server end-to-end closure witness storage.
  //
  // _m5_echo_witness_hdr_scratch: 8 bytes for frame_encode's output when
  //   building the request hdr (op=0x11, ver=1, flags=0, payload_len=8).
  //   Loaded once, published to user_va 0x7FFFFFFFB000 via
  //   user_write_bytes_via_walk, then re-loaded on the verify step for the
  //   byte-exact compare against the server-drained hdr.
  //
  // _m5_echo_witness_reply_hdr_scratch: 8 bytes for frame_encode's output
  //   when building the reply hdr (op=0x91=0x11|0x80, ver=1, flags=0,
  //   payload_len=8). Same lifecycle as the request hdr scratch: encoded,
  //   published to user_va 0x7FFFFFFFB040, re-loaded on the verify step
  //   against the client-drained reply hdr.
  //
  // _m5_echo_witness_payload_pattern: 8-byte "PAIDEIA!" canary — the
  //   request payload the client publishes AND the expected reply payload
  //   (echo semantic). Immutable rodata via `pub let` (matches the R20b
  //   design that ver/op/flags constants live in rodata). Byte layout LE:
  //     [0]='P'(0x50) [1]='A'(0x41) [2]='I'(0x49) [3]='D'(0x44)
  //     [4]='E'(0x45) [5]='I'(0x49) [6]='A'(0x41) [7]='!'(0x21)
  //   Read as a single u64 for byte-compare via `mov rax, [rip + ...]`.
  //   Distinct from the (i+1)/(i+2)/(i+5) numeric patterns other R20b
  //   witnesses use — printable ASCII makes a misfired verify trivially
  //   spotted in a hex dump of the user page.
  //
  // _m5_echo_witness_zero_scratch: 4096 bytes of zeros used to pre-wipe
  //   init's user page @ 0x7FFFFFFFB000 before publishing the request +
  //   reply hdr/payload. Guarantees that a broken send/recv (skipped
  //   writeback) surfaces as all-zero on the verify step, distinct from
  //   the non-zero "PAIDEIA!" pattern. Same idiom as
  //   _ipc_bounce_witness_zero_scratch / _sys_ipc_recv_witness_zero_scratch.
  //   Sized as [u64; 512] (512 * 8 = 4096) @align(8).
  //
  // _m5_echo_witness_verify_scratch: 8-byte kernel scratch that
  //   user_read_bytes_via_walk copies user-page bytes back into for the
  //   byte-comparison sub-tests. Reused across the 4 verify steps (steps
  //   10, 11, 17, 18) — each read overwrites the prior contents. Sized as
  //   [u64; 1] @align(8) since every verify reads exactly 8 bytes.
  //
  // _m5_echo_witness_stage: 0..19 sub-test index; written before every
  //   sub-test so a fail exit prints which one tripped via the
  //   echo_roundtrip_fail_msg + line KV. Matches the
  //   _loader_seed_witness_stage / _init_caps_witness_stage idiom above.
  pub let mut _m5_echo_witness_hdr_scratch       : [u64; 1]   = uninit @align(8)
  pub let mut _m5_echo_witness_reply_hdr_scratch : [u64; 1]   = uninit @align(8)
  pub let mut _m5_echo_witness_zero_scratch      : [u64; 512] = uninit @align(8)
  pub let mut _m5_echo_witness_verify_scratch    : [u64; 1]   = uninit @align(8)
  pub let mut _m5_echo_witness_stage             : u64 = 0

  // Payload canary — immutable [u8; 8] rodata "PAIDEIA!" (no NUL terminator;
  // the M5 witness uses len=8 exclusively for both publish + verify).
  // Loaded as a single u64 via `mov rax, [rip + ...]` — x86-64 native LE
  // reconstructs bytes 0..7 into the low..high positions of the u64.
  // R20b.M6-003 (#1566) reuses this canary for the dual-endpoint RPC
  // witness's request/reply payload (echo semantic; a shared canary
  // guarantees mismatch surfaces from a substrate bug, not a witness
  // typo).
  pub let _m5_echo_witness_payload_pattern : [u8; 8] = "PAIDEIA!"

  // R20b.M6-003 (#1566): dual-endpoint RPC roundtrip witness storage.
  //
  // Proves the M6-003 substrate fix (dual-endpoint reply routing via
  // hdr.reply_endpoint_id per userspace-server-substrate.md §4.4). Runs
  // after m5_echo_witness_done in kernel_main.pdx §m6_rpc_witness.
  //
  // Scratch layout mirrors _m5_echo_witness_* storage for consistency;
  // the payload canary and zero_scratch are reused from M5-001 (see
  // the m6_rpc_witness sub-test 3 for the wipe pattern and sub-test 5
  // for the payload canary reuse).
  //
  // _m6_rpc_witness_req_hdr_scratch: 8 bytes for frame_encode's output
  //   when building the request hdr (op=0x22 — distinct from M5's 0x11
  //   so a cross-witness bleed on the verify path shows up trivially;
  //   ver=1; reply_endpoint_id=<runtime> — filled with r15 from
  //   endpoint_alloc during sub-test 1; payload_len=8).
  //
  // _m6_rpc_witness_reply_hdr_scratch: 8 bytes for the composed reply
  //   hdr (drained request hdr with op |= 0x80). reply_endpoint_id is
  //   preserved from the drained hdr — the OR touches only bit 7 of
  //   byte 0.
  //
  // _m6_rpc_witness_zero_scratch: 4096 bytes of zeros used to pre-wipe
  //   init's user page @ 0x7FFFFFFFB000 before the roundtrip (sub-test 3).
  //   Guarantees a broken send/recv (skipped writeback) surfaces as
  //   all-zero on the verify step, distinct from the non-zero "PAIDEIA!"
  //   pattern. Same idiom as _m5_echo_witness_zero_scratch.
  //
  // _m6_rpc_witness_verify_scratch: 8-byte kernel scratch that
  //   user_read_bytes_via_walk copies user-page bytes back into for the
  //   byte-comparison sub-tests (10, 11, 12, 13, 18, 19). Reused across
  //   verifies; each read overwrites prior contents.
  //
  // _m6_rpc_witness_stage: 0..20 sub-test index; written before every
  //   sub-test so a fail exit prints which one tripped via the
  //   rpc_roundtrip_fail_msg + line KV. Matches the
  //   _m5_echo_witness_stage / _init_caps_witness_stage idiom above.
  pub let mut _m6_rpc_witness_req_hdr_scratch    : [u64; 1]   = uninit @align(8)
  pub let mut _m6_rpc_witness_reply_hdr_scratch  : [u64; 1]   = uninit @align(8)
  pub let mut _m6_rpc_witness_zero_scratch       : [u64; 512] = uninit @align(8)
  pub let mut _m6_rpc_witness_verify_scratch     : [u64; 1]   = uninit @align(8)
  pub let mut _m6_rpc_witness_stage              : u64 = 0

  // ============================================================================
  // R20-M4-002 (#820): ACPI supervisor RPC witness storage.
  //
  // Discharges #820's acceptance criteria (userspace acpi_supervisor
  // server — accepts KIND_ACPI + serves parse queries) via the
  // "Option B — kernel-side witness driving the RPC" posture. The
  // witness in kernel_main.pdx §m4_002_acpi_rpc_witness allocates a
  // server_ep + reply_ep pair, then loops op ∈ {1, 2, 3, 4} through
  // the full IPC round-trip against init's user_pml4:
  //
  //   sys_ipc_send_body (client → server_ep)     [M3 send + M2 bounce]
  //   sys_ipc_recv_body (server drain @ server_ep) [M3 recv + M2 bounce]
  //   kernel dispatch to sup_* helpers (build payload) [M4-002 body]
  //   sys_ipc_reply_body (server → reply_ep)     [M3 reply + M6 dual-endpoint]
  //   sys_ipc_recv_body (client drain @ reply_ep) [M3 recv + M2 bounce]
  //
  // TSC delta measured with kread_tsc bracketing each roundtrip; the max
  // observed delta across the 4 ops is stashed in _acpi_witness_max_delta
  // and asserted < ACPI_RPC_TSC_MAX (~2M ticks @ 2 GHz TSC = 1 ms — the
  // AC threshold; comfortable margin over the substrate's expected
  // ~30k-tick roundtrip cost per iteration).
  //
  // Scratches (mirror the M5/M6 storage layout for consistency):
  //
  //   _acpi_witness_req_hdr_scratch    — 8 B  request hdr (frame_encode output)
  //   _acpi_witness_reply_hdr_scratch  — 8 B  reply hdr (frame_encode output)
  //   _acpi_witness_reply_payload_kbuf — 4088 B kernel-side reply payload
  //                                     builder (sup_* helpers write here
  //                                     before user_write_bytes_via_walk
  //                                     copies to the user page).
  //   _acpi_witness_zero_scratch       — 4096 B zeros for pre-wipe of the
  //                                     three user pages (0xC000/0xD000/0xE000).
  //   _acpi_witness_verify_scratch     — 8 B  kernel read-back for the
  //                                     per-iteration hdr byte-compare.
  //   _acpi_witness_tsc_start          — 8 B  spilled TSC start (kread_tsc
  //                                     clobbers rax so callee-save regs
  //                                     don't survive the send/recv chain
  //                                     without a memory spill).
  //   _acpi_witness_reply_len          — 8 B  spilled reply payload_len
  //                                     (sup_* return; needed for the
  //                                     frame_encode reply hdr call and
  //                                     the sys_ipc_reply_body arg).
  //   _acpi_witness_max_delta          — 8 B  max observed TSC delta over
  //                                     the 4 iterations (asserted against
  //                                     ACPI_RPC_TSC_MAX at loop exit).
  //   _acpi_witness_stage              — 0..30 sub-test index; written
  //                                     before every sub-test so the fail
  //                                     path logs which one tripped.
  //   _acpi_witness_xsdt_ptr           — 8 B  spilled XSDT pointer (walked
  //                                     from RSDP at witness start; reused
  //                                     across the 4 op iterations for the
  //                                     enumerate + MADT-lookup calls).
  //   _acpi_witness_madt_ptr           — 8 B  spilled MADT pointer (looked
  //                                     up via acpi_xsdt_find at witness
  //                                     start; reused for the op=2 iter).
  //
  // Storage sizing rationale: 512 u64 = 4088 B payload buffer matches the
  // FRAME_MAX_PAYLOAD constant so the worst-case sup_enumerate_tables
  // response (2 + 24*32 = 770 B) fits comfortably.
  // ============================================================================

  pub let mut _acpi_witness_req_hdr_scratch     : [u64; 1]   = uninit @align(8)
  pub let mut _acpi_witness_reply_hdr_scratch   : [u64; 1]   = uninit @align(8)
  pub let mut _acpi_witness_reply_payload_kbuf  : [u64; 512] = uninit @align(8)
  pub let mut _acpi_witness_zero_scratch        : [u64; 512] = uninit @align(8)
  pub let mut _acpi_witness_verify_scratch      : [u64; 1]   = uninit @align(8)
  pub let mut _acpi_witness_tsc_start           : u64 = 0
  pub let mut _acpi_witness_reply_len           : u64 = 0
  pub let mut _acpi_witness_max_delta           : u64 = 0
  pub let mut _acpi_witness_stage               : u64 = 0
  pub let mut _acpi_witness_xsdt_ptr            : u64 = 0
  pub let mut _acpi_witness_madt_ptr            : u64 = 0

  // ============================================================================
  // R20-M4-002 (#820): Synthetic ACPI fixture blobs for the RPC witness.
  //
  // Rationale
  // ---------
  // Under `-kernel` QEMU q35 boot (the default smoke path — see run-smoke.sh
  // §argv-parser and kernel_main.pdx §L316 comment), SeaBIOS does not run
  // and no RSDP is published to any of the BIOS-scanned regions (EBDA @
  // *(u16*)0x40E, [0xE0000, 0x100000)). acpi_find_rsdp returns 0 and
  // phase1_acpi_gather bails, leaving _phase1_acpi_info fully zero and
  // _mcfg_count = 0. This is why boot_min / boot_smp etc. logs show
  // "MCFG ABSENT" — the ACPI subsystem has no data to work with under
  // BIOS -kernel.
  //
  // The ACPI RPC witness cannot rely on real ACPI discovery under this
  // boot mode, so it fabricates the minimum SDT hierarchy it needs to
  // exercise the sup_* helpers end-to-end:
  //
  //   _acpi_witness_synth_xsdt  — 128 B  synthetic XSDT with 4 entries
  //                                pointing at the 4 synthetic SDTs below.
  //   _acpi_witness_synth_madt  — 128 B  synthetic MADT (SIG "APIC") with
  //                                4 Type-0 LAPIC sub-entries.
  //   _acpi_witness_synth_mcfg  — 128 B  synthetic MCFG (SIG "MCFG") — not
  //                                walked by any sup_* helper (see below)
  //                                but referenced by the XSDT so
  //                                sup_enumerate_tables lists it.
  //   _acpi_witness_synth_fadt  — 128 B  synthetic FADT (SIG "FACP") —
  //                                similarly referenced but not parsed.
  //   _acpi_witness_synth_hpet  — 128 B  synthetic HPET (SIG "HPET").
  //   _acpi_witness_synth_segments — 24 B ONE 24-byte mcfg parser record
  //                                ({base=0xE0000000, seg=0, bus[0..0xFF]})
  //                                — passed directly as segments_ptr arg
  //                                to sup_get_mcfg_ranges (no _mcfg_segments
  //                                write, so no side effect on the real
  //                                MCFG state).
  //   _acpi_witness_synth_hpet_info — 32 B synthetic hpet_info record
  //                                (counter_base=0xFED00000, block_id=..,
  //                                min_tick=..) — passed as hpet_info arg
  //                                to sup_get_hpet (no _phase1_acpi_info
  //                                write, so no side effect).
  //
  // Under UEFI/OVMF boot (opt-in via PAIDEIA_UEFI_OVMF=1) real ACPI IS
  // published; a future R21+ upgrade could switch this witness to prefer
  // real ACPI when phase1_acpi_gather returned non-zero and fall back to
  // the synthetic fixture only under BIOS. For R20-M4-002 the synthetic
  // path is unconditional to keep the smoke deterministic.
  //
  // Blob layout notes (see fill helpers in the witness body):
  //   - All SDT headers use OEMID "PAIDOS", revision=1, checksum=0 (the
  //     sup_* helpers do NOT re-verify checksums — that's the caller's
  //     responsibility per xsdt.pdx §L60 doc; the witness driver is
  //     kernel-side so checksum validation is elided).
  //   - Entries laid out at natural offsets: XSDT entries at [36, 44,
  //     52, 60]; MADT sub-entries at [44, 52, 60, 68] (each 8 B, type=0).
  // ============================================================================

  pub let mut _acpi_witness_synth_xsdt      : [u64; 16] = uninit @align(8)
  pub let mut _acpi_witness_synth_madt      : [u64; 16] = uninit @align(8)
  pub let mut _acpi_witness_synth_mcfg      : [u64; 16] = uninit @align(8)
  pub let mut _acpi_witness_synth_fadt      : [u64; 16] = uninit @align(8)
  pub let mut _acpi_witness_synth_hpet      : [u64; 16] = uninit @align(8)
  pub let mut _acpi_witness_synth_segments  : [u64; 4]  = uninit @align(8)
  pub let mut _acpi_witness_synth_hpet_info : [u64; 4]  = uninit @align(8)

  // ============================================================================
  // R22-M3-005 (#860): PCI enumerator RPC witness storage.
  //
  // Discharges #860's acceptance criteria (userspace pci_enumerator
  // server — walks tree via KIND_DEVICE caps) via the "Option B —
  // kernel-side witness driving the RPC" posture. The witness in
  // kernel_main.pdx §m3_005_pci_rpc_witness allocates a server_ep +
  // reply_ep pair, then loops op ∈ {1, 2, 3} through the full IPC
  // round-trip against init's user_pml4:
  //
  //   sys_ipc_send_body (client → server_ep)     [M3 send + M2 bounce]
  //   sys_ipc_recv_body (server drain @ server_ep) [M3 recv + M2 bounce]
  //   kernel dispatch to pci_enum_* helpers (build payload) [M3-005 body]
  //   sys_ipc_reply_body (server → reply_ep)     [M3 reply + M6 dual-endpoint]
  //   sys_ipc_recv_body (client drain @ reply_ep) [M3 recv + M2 bounce]
  //
  // TSC delta measured with kread_tsc bracketing each roundtrip; the max
  // observed delta across the 3 ops is stashed in _pci_witness_max_delta
  // and asserted < PCI_RPC_TSC_MAX (~2M ticks @ 2 GHz TSC = 1 ms — the
  // same AC threshold as the ACPI witness; comfortable margin over the
  // substrate's expected ~30k-tick roundtrip cost per iteration).
  //
  // No synthetic ACPI blobs required — the fixture the pci_enum_*
  // helpers walk (_pci_devices) is populated directly by the witness
  // prologue with 4 q35-shaped records (see witness §Stage 1) before
  // the dispatch loop. This is simpler than the ACPI witness which
  // synthesizes 5 SDTs plus 2 parser records — pci_enumerate_all's
  // output format (32-byte records at _pci_devices[i]) is what the
  // pci_enum_* helpers consume.
  //
  // Scratches (mirror the ACPI M4-002 storage layout for consistency):
  //
  //   _pci_witness_req_hdr_scratch    — 8 B  request hdr (frame_encode output)
  //   _pci_witness_reply_hdr_scratch  — 8 B  reply hdr (frame_encode output)
  //   _pci_witness_reply_payload_kbuf — 4088 B kernel-side reply payload
  //                                     builder (pci_enum_* helpers write
  //                                     here before user_write_bytes_via_walk
  //                                     copies to the user page).
  //   _pci_witness_zero_scratch       — 4096 B zeros for pre-wipe of the
  //                                     three user pages (0xC000/0xD000/0xE000).
  //   _pci_witness_verify_scratch     — 8 B  kernel read-back for the
  //                                     per-iteration hdr byte-compare.
  //   _pci_witness_tsc_start          — 8 B  spilled TSC start (kread_tsc
  //                                     clobbers rax so callee-save regs
  //                                     don't survive the send/recv chain
  //                                     without a memory spill).
  //   _pci_witness_reply_len          — 8 B  spilled reply payload_len
  //                                     (pci_enum_* return; needed for the
  //                                     frame_encode reply hdr call and
  //                                     the sys_ipc_reply_body arg).
  //   _pci_witness_max_delta          — 8 B  max observed TSC delta over
  //                                     the 3 iterations (asserted against
  //                                     PCI_RPC_TSC_MAX at loop exit).
  //   _pci_witness_stage              — 0..99 sub-test index; written
  //                                     before every sub-test so the fail
  //                                     path logs which one tripped.
  //
  // Storage sizing rationale: 512 u64 = 4088 B payload buffer matches the
  // FRAME_MAX_PAYLOAD constant so the worst-case pci_enum_list_devices
  // response (2 + 16*256 = 4098 → capped at 4088 = 255 records) fits.
  // ============================================================================

  pub let mut _pci_witness_req_hdr_scratch     : [u64; 1]   = uninit @align(8)
  pub let mut _pci_witness_reply_hdr_scratch   : [u64; 1]   = uninit @align(8)
  pub let mut _pci_witness_reply_payload_kbuf  : [u64; 512] = uninit @align(8)
  pub let mut _pci_witness_zero_scratch        : [u64; 512] = uninit @align(8)
  pub let mut _pci_witness_verify_scratch      : [u64; 1]   = uninit @align(8)
  pub let mut _pci_witness_tsc_start           : u64 = 0
  pub let mut _pci_witness_reply_len           : u64 = 0
  pub let mut _pci_witness_max_delta           : u64 = 0
  pub let mut _pci_witness_stage               : u64 = 0

  // M3-003 (#691) + M4-001 (#692): panic witness tag string
  // NUL-terminated tag for klog_panic witness. Appears in panic-level log line.
  pub let tag_panic_witness : [u8; 14] = "PANIC WITNESS\0"

  // R18-M1-005 (#764): boot_smp bring-up bookends.
  // Emitted via raw uart_puts (not klog_s1) so the exact bytes hit COM1
  // without a level/subsystem prefix — the boot_smp fingerprint asserts
  // literal `SMP BRINGUP START` / `SMP BRINGUP DONE` lines. Trailing
  // `\n` gives the fingerprint checker a line-boundary; trailing `\0`
  // terminates uart_puts's char-copy loop.
  //   "SMP BRINGUP START\n\0" = 17 chars + \n + \0 = 19 bytes
  //   "SMP BRINGUP DONE\n\0"  = 16 chars + \n + \0 = 18 bytes
  pub let smp_bringup_start_msg : [u8; 19] = "SMP BRINGUP START\n\0"
  pub let smp_bringup_done_msg  : [u8; 18] = "SMP BRINGUP DONE\n\0"
}
