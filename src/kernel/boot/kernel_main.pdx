  //   names handed to driver_table_register. driver_table_register
  //   reads exactly 16 bytes as two qwords, so the padding is
  //   load-bearing, not cosmetic — a shorter literal would splice
  //   adjacent .rodata into the row's name field. Stage 19 reloads
  //   the first qword of _name0 and compares it against the decoded
  //   record's name_lo, which is what makes the round-trip assertion
  //   about the ORIGINAL name rather than merely self-consistent.
  pub let mut _registry_v2_witness_stage : u64 = 0
  pub let _registry_v2_witness_name0 : [u8; 16] = "uart-16550\0\0\0\0\0\0"
  pub let _registry_v2_witness_name1 : [u8; 16] = "nvme-pcie\0\0\0\0\0\0\0"

