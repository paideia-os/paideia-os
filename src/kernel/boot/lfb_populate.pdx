// src/kernel/boot/lfb_populate.pdx -- Wave β β-03 (paideia-os compositor
// QEMU bring-up)
//
// Real boot-time KIND_FRAMEBUFFER row-0 population from the EFI GOP
// descriptor the UEFI stub already captured. Before this landing,
// kind_framebuffer_init (src/kernel/core/cap/kind_framebuffer.pdx) only
// called fb_table_reset -- the KIND_FRAMEBUFFER row pool stayed
// entirely empty at boot; nothing ever claimed row 0 with the real
// GOP-reported geometry. This file is the missing writer.
//
// -----------------------------------------------------------------------------
// Where the raw GOP data already lives
// -----------------------------------------------------------------------------
//
// src/boot/uefi_stub.pdx's efi_gop_capture (R19-M3-002 #793) reads
// EFI_GRAPHICS_OUTPUT_PROTOCOL Mode/Mode->Info and stashes base/size/
// pitch/width/height/format into _efi_fb_desc; the R19.M4 finalizer
// copies that verbatim into boot_env_t.fb (offset +16, 32 bytes,
// layout in src/boot/uefi_env.pdx UefiEnv.FB_DESC_OFFSET_*). kernel_
// main_uefi latches the boot_env physical address into the pub global
// _boot_env_pa (src/kernel/kernel_main_uefi.pdx).
//
// src/kernel/boot/kernel_main.pdx's R23-M2 block (the "framebuffer
// console bring-up" section, just after platform_map_early_mmio) is
// the FIRST consumer: it reads _boot_env_pa, extracts fb.base_pa /
// fb.size, calls fb_map_lfb to get a mapped kernel VA, then calls
// fb_console_init(fb_va, width, height, pitch) which populates
// _fb_console_ctx (fb_va at +0, pitch at +8, ...) and sets
// _fb_console_active = 1 on success. That block runs UNDER PVH
// `qemu -kernel` boots too, but _boot_env_pa stays 0 there (no UEFI
// stub ran), so the whole bring-up -- and this file's population --
// is a no-op skip on every existing QEMU smoke, matching fb_map_lfb's
// own documented PVH posture.
//
// This file does NOT re-run fb_map_lfb (calling aspace_map twice for
// the same VA/PA would return MAP_OVERLAP the second time) -- it reads
// the ALREADY-mapped fb_va back out of _fb_console_ctx, and re-reads
// the raw width/height/pitch/base_pa/format straight from boot_env
// (static once the UEFI finalizer wrote it pre-ExitBootServices, so
// re-reading later is always safe).
//
// -----------------------------------------------------------------------------
// Call-site placement
// -----------------------------------------------------------------------------
//
// Called from kernel_main.pdx immediately after `call
// kind_framebuffer_init;` (which resets the row pool -- calling this
// BEFORE that reset would have its write wiped). Gated on
// _fb_console_active == 1, so it only ever claims row 0 when the R23-M2
// block already succeeded (mapped VA + initialised console) -- this
// file adds no NEW GOP-availability logic of its own, it just projects
// state that block already proved live into the KIND_FRAMEBUFFER cap
// substrate.
//
// -----------------------------------------------------------------------------
// Backend-kind honesty note
// -----------------------------------------------------------------------------
//
// fb_hdr_pack requires backend_kind in [1, DPYB_KIND_MAX=4]
// (kind_display_backend.pdx's DPYB_KIND_* enum: 1=BOCHS_STDVGA,
// 2=VIRTIO_GPU_2D, 3=VIRTIO_GPU_3D, 4=IRIS_XE) -- there is no
// "firmware GOP, no concrete driver behind it" kind. _boot_env_pa is
// populated ONLY by the real UEFI boot path (src/boot/uefi_stub.pdx),
// which per this repo's own vision (design/project-vision.md) targets
// the T14 G4's Iris Xe integrated GPU -- so DPYB_KIND_IRIS_XE (4) is
// used here. This is honestly imprecise for a hypothetical future
// OVMF+QEMU UEFI-GOP boot on non-Iris-Xe virtual hardware (no such
// smoke exists in this tree today); a dedicated DPYB_KIND_GOP_GENERIC
// kind is a reasonable follow-up if that scenario is ever added.
//
// -----------------------------------------------------------------------------
// Pixel-format honesty note
// -----------------------------------------------------------------------------
//
// UefiEnv's EFI_GRAPHICS_PIXEL_FORMAT enum (UEFI 2.10 §12.9) has four
// values; KindFramebuffer's own FB_FMT_* enum has only two (NONE=0,
// BGRA8888=1). Only EFI_PIXEL_BGR_8888 (=1) maps onto FB_FMT_BGRA8888
// (=1) -- RGB_8888 (0), BITMASK (2), and BLT_ONLY (3) framebuffers are
// not representable in this cap kind today. This file skips row
// population entirely (leaving row 0 unclaimed, an already-legal state
// every consumer of fb_row_valid already handles) rather than
// mislabeling an unsupported format as BGRA8888.

module LfbPopulate = structure {

  // Fingerprint (all-lowercase, no OK_TOK -- narrative marker, matches
  // fb_mint_ok_msg's own style). NUL-terminated.
  pub let lfb_populate_ok_msg   : [u8; 22] = "r101 lfb populate ok\0"
  pub let lfb_populate_fail_msg : [u8; 24] = "r101 lfb populate fail\0"

  // lfb_populate_run() -- called once from kernel_main.pdx, right after
  // kind_framebuffer_init.
  pub let lfb_populate_run : () -> () !{mem, sysreg} @{} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "Wave β β-03: projects the already-captured EFI GOP descriptor into KIND_FRAMEBUFFER row 0. 5-push prologue (rbx, r12, r13, r14, r15) mirrors fb_map_lfb's own shape -- from entry rsp%16==8 (post-CALL return address), five pushes land rsp%16==0 so nested calls (fb_pack_wh, fb_hdr_pack, fb_tail_alloc, klog_s1) see the required alignment; this is called from a boot-cascade call site kernel_main.pdx itself documents as needing r12/r13/r14 preserved across it, so the full callee-save discipline (not just a leaf's caller-saved scratch) is used deliberately here even though the body could in principle fit in caller-saved registers alone. Sequence: (1) load _fb_console_active; 0 -> lfb_pop_skip (PVH boot or GOP absent -- the R23-M2 block in kernel_main.pdx already decided this, this file just reads its verdict). (2) load _boot_env_pa into rbx; 0 -> lfb_pop_skip (defensive; should be non-zero whenever _fb_console_active is 1). (3) r14 = boot_env.fb.base_pa (u64 @ rbx+16); 0 -> lfb_pop_skip. (4) rdi=width (u32 zero-extended @ rbx+36), rsi=height (u32 zero-extended @ rbx+40), call fb_pack_wh -> r12 = wh_packed. (5) rdi=efi_format (u32 zero-extended @ rbx+44 = fb_desc+28, UefiEnv.FB_DESC_OFFSET_FORMAT); cmp against EFI_PIXEL_BGR_8888=1; not equal -> lfb_pop_skip (pixel-format honesty note in the file header -- RGB_8888/BITMASK/BLT_ONLY are not representable in KindFramebuffer's FB_FMT_* enum). (6) r13 = pitch (u32 zero-extended @ rbx+32). (7) r15 = fb_va, loaded directly from _fb_console_ctx+0 (populated by fb_console_init earlier in the same kernel_main.pdx cascade -- NOT re-derived via a second fb_map_lfb call, which would hit aspace_map's MAP_OVERLAP guard on the already-mapped VA). (8) rdi=DPYB_KIND_IRIS_XE(4), rsi=FB_FMT_BGRA8888(1), call fb_hdr_pack -> rax = hdr (backend-kind honesty note in the file header explains the IRIS_XE choice). (9) call fb_tail_alloc(hdr=rax, wh_packed=r12, stride=r13, lfb_pa=r14, lfb_va=r15, owner_pid=0) -> rax = row_id (expected 0, the freshly-reset table's first free row) or an FB_TAIL_* error sentinel (>=4, since valid row ids are always < FB_MAX=4). (10) cmp rax,4; jae lfb_pop_fail; else emit lfb_populate_ok_msg via klog_s1(LEVEL_INFO=3, SUBSYS_BOOT, ...) and fall through to lfb_pop_done. lfb_pop_fail emits lfb_populate_fail_msg via klog_s1(LEVEL_ERROR=1, ...). lfb_pop_skip falls straight to lfb_pop_done with no emission (an unclaimed row 0 under PVH/no-GOP boots is already the universally-handled default state -- every fb_row_* accessor already treats an unclaimed row as invalid via fb_row_valid, so silence here matches every other belt-and-braces reset call this cascade already makes). Effects/capabilities: {mem,sysreg} is the union of fb_pack_wh/fb_hdr_pack (both `!{} @{}`, contribute nothing), fb_tail_alloc (`!{mem} @{}`), and klog_s1 (`!{mem,sysreg} @{}` per its own declaration, transitively via its TSC read) -- no `cap` capability needed since fb_tail_alloc is the direct row-pool writer, not the rights-gated kind_framebuffer_mint_simple syscall path. Reserved labels: prefixed lfb_pop_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rax, [rip + _fb_console_active];
        cmp rax, 0;
        je lfb_pop_done;

        mov rbx, [rip + _boot_env_pa];
        cmp rbx, 0;
        je lfb_pop_done;

        mov r14, [rbx + 16];                  // base_pa (fb_desc +0)
        cmp r14, 0;
        je lfb_pop_done;

        xor rdi, rdi;
        mov edi, [rbx + 36];                  // width (fb_desc +20)
        xor rsi, rsi;
        mov esi, [rbx + 40];                  // height (fb_desc +24)
        call fb_pack_wh;
        mov r12, rax;                         // wh_packed

        xor rdi, rdi;
        mov edi, [rbx + 44];                  // format (fb_desc +28)
        cmp rdi, 1;                           // EFI_PIXEL_BGR_8888
        jne lfb_pop_done;

        xor rax, rax;
        mov eax, [rbx + 32];                  // pitch (fb_desc +16)
        mov r13, rax;

        mov r15, [rip + _fb_console_ctx];     // fb_va (ctx field +0)

        mov rdi, 4;                           // DPYB_KIND_IRIS_XE
        mov rsi, 1;                           // FB_FMT_BGRA8888
        call fb_hdr_pack;

        mov rdi, rax;                         // hdr
        mov rsi, r12;                         // wh_packed
        mov rdx, r13;                         // stride
        mov rcx, r14;                         // lfb_pa
        mov r8,  r15;                         // lfb_va
        xor r9,  r9;                          // owner_pid = 0
        call fb_tail_alloc;

        mov r10, 4;
        cmp rax, r10;
        jae lfb_pop_fail;

        mov rdi, 3;                           // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + lfb_populate_ok_msg];
        call klog_s1;
        jmp lfb_pop_done;

      lfb_pop_fail:
        mov rdi, 1;                           // LEVEL_ERROR
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + lfb_populate_fail_msg];
        call klog_s1;
        jmp lfb_pop_done;

      lfb_pop_done:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
