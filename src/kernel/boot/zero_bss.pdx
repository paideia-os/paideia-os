// src/kernel/boot/zero_bss.pdx — Phase 1 P1-005
// Zero the .bss section from _bss_start to _bss_end via rep stosq.
//
// Caller discipline (per x86_64 ABI for rep stosq):
//   RDI = destination address (set to _bss_start by caller).
//   RAX = value to write (set to 0 by caller).
//   RCX = count of qwords (set to (_bss_end - _bss_start) / 8 by caller).
//
// #1567: fix for the ".bss zeroing regression" — this function was written
// at P1-005 but NEVER WIRED into the boot path (no call site existed
// anywhere in the tree) and was missing both `pub` (so it linked as a
// file-local symbol, unreachable from entry.pdx's _start in a different
// object file) and a trailing `ret` (so a call would have fallen through
// into whatever code the linker placed next in .text). The kernel has
// therefore always depended entirely on the -kernel boot chain (QEMU /
// SeaBIOS) to zero-fill the .bss PT_LOAD's NOBITS tail, and empirically
// that dependency is not reliable: cap_table slot 12 (cap_table + 288,
// never written by any prior witness) read back BIOS-POST-looking bytes
// (0xF000FF53F000FF53) at kind_hw_interrupt_witness entry. entry.pdx's
// _start now calls this function explicitly, first thing, so the kernel
// no longer trusts the loader for this guarantee.
module ZeroBss = structure {
  pub let zero_bss : (u64) -> () !{sysreg} @{} = fn (start_addr: u64) -> unsafe {
    effects: { sysreg },
    capabilities: { },
    justification: "rep stosq: bulk-zero .bss prior to kernel runtime startup; classic ABI: RDI=dst, RAX=val, RCX=qword_count. #1567: made `pub` (previously file-local, unreachable from entry.pdx) and given an explicit `ret` (previously fell through into whatever the linker placed next in .text) so entry.pdx's _start can actually call it. Also added `cld` before rep_stosq: this is now called as the very first raw-asm act of entry.pdx's _start, straight out of boot_stub.S's 16/32/64-bit transition, which never issues its own cld -- DF is not guaranteed clear on entry the way it would be at any normal SysV call boundary. A set DF would run rep_stosq backwards from _bss_start, corrupting memory below it rather than zeroing .bss. Matches the cld-before-rep_stos{q,b} discipline used at every other rep_stos call site in the tree (e.g. pdxfs_lite/create.pdx, tmpfs/inode.pdx).",
    block: {
      cld;
      rep_stosq;
      ret
    }
  }
}
