// src/kernel/boot/gdt.pdx — Phase 6 / R13-m4-001
// 8-entry GDT install for real kernel + SYSRET-compatible user layout
// Issue: R13-m4-001 (#423)
// [unsafe] — lgdt (privileged)
// Audit: design/audit/entries/r13-m4-001-gdt-install.md
//
// Slots 0-5 real; slots 6-7 reserved for TSS install (m4-002).
// Layout:
//   0x00 (slot 0): null
//   0x08 (slot 1): kernel code64 (RPL 0, default operand 64-bit)
//   0x10 (slot 2): kernel data (RPL 0)
//   0x18 (slot 3): reserved
//   0x20 (slot 4): user data (RPL 3) — for SYSRET at offset STAR[63:48]+8
//   0x28 (slot 5): user code64 (RPL 3) — for SYSRET at offset STAR[63:48]+16
//   0x30 (slot 6): TSS low qword (deferred to m4-002)
//   0x38 (slot 7): TSS high qword (deferred to m4-002)
//
// CRITICAL: The boot_stub.S GDT used at entry has code32 at 0x08; this real GDT
// replaces it with code64 at 0x08, fixing the latent bug where IDT trampolines
// were using CS=0x08 (which was code32 in boot GDT, now code64).
//
// #661-followup (softarch 2026-08-06): CS/SS reload after lgdt.
// boot_stub enters long mode with CS=0x18 and SS=0x20 (indices in the boot
// GDT). Once gdt_install swaps the GDT, those cached selector *values* no
// longer describe valid kernel segments: slot 0x18 becomes null, and slot
// 0x20 is repurposed as user-data DPL=3. Regular kernel execution keeps
// running on the (still-valid) cached descriptors, but any iretq path that
// tries to reload CS/SS from a trap frame — kernel→kernel or ring-3→ring-0
// — reads those stale selectors and faults (#NP on CS=null, #GP on
// SS.DPL != CPL). The first such path to be exercised was #661's CoW fast-
// flip, which papered over it by patching the pushed CS/SS in the trap
// frame. The proper fix is to reload the cached selectors here, once,
// while interrupts are still masked and no fault frame is in flight.
//
// Reload strategy: build a 5-slot iretq frame (RIP, CS=0x08, RFLAGS, RSP,
// SS=0x10) in .bss, point RSP at it, and iretq. iretq atomically loads
// CS+SS+RFLAGS+RIP+RSP from the frame. The RIP field targets a tiny
// `_gdt_reload_land` shim that simply returns to gdt_install's caller;
// the frame's RSP is the pre-reload RSP (which still has the caller's
// return address on top), so the shim's `ret` unwinds correctly back to
// kernel_main. paideia-as does not accept `retfq`/`lretq` or segment-
// register moves (`mov ss, ax`), so this iretq idiom is the encodable
// path. DS/ES/FS/GS are left alone: long-mode ignores their bases (GS
// uses IA32_GS_BASE MSR set by kernel_main afterwards), so their stale
// selector values are inert until a future ring transition — none of
// which fire before those selectors get set correctly by other paths.

module Gdt = structure {
  // Storage for 8-entry GDT (8 slots × 8 bytes = 64 bytes).
  pub let mut _gdt_new : [u64; 8] = uninit

  // GDTR descriptor: 10 bytes (limit:u16 + base:u64), padded to 16 for alignment.
  pub let mut _gdt_ptr : [u64; 2] = uninit

  // #661-followup: 5-slot iretq frame used to reload CS/SS after lgdt.
  //   +0  RIP    = &_gdt_reload_land
  //   +8  CS     = 0x08 (kernel code64)
  //   +16 RFLAGS = current (preserved via pushfq/pop; keeps IF=0)
  //   +24 RSP    = pre-reload RSP (kernel_main's return address on top)
  //   +32 SS     = 0x10 (kernel data)
  pub let mut _gdt_reload_iretq_frame : [u64; 5] = uninit

  // #661-followup: iretq lands here with CS=0x08 / SS=0x10 freshly loaded
  // and RSP restored to the pre-reload value. `ret` pops kernel_main's
  // return address (the CALL gdt_install that got us here) and resumes
  // execution there — from kernel_main's perspective gdt_install just
  // returned normally.
  pub let _gdt_reload_land : () -> () !{} @{boot} = fn () -> unsafe {
    effects: { },
    capabilities: { boot },
    justification: "R13-m4-001 (#423) / #661-followup: iretq landing pad for gdt_install's CS/SS reload. Runs with freshly loaded CS=0x08 and SS=0x10; RSP was restored to gdt_install's pre-reload value by iretq (slot +24 in _gdt_reload_iretq_frame). A single `ret` pops kernel_main's return address (the caller of gdt_install) and resumes there, so gdt_install appears to have returned normally.",
    block: {
      ret
    }
  } @no_frame

  // gdt_install(): Populate _gdt_new with 8-entry layout, construct GDTR descriptor,
  // load via lgdt, then reload CS/SS via iretq to refresh cached selector state.
  pub let gdt_install : () -> () !{sysreg, mem} @{boot} = fn () -> unsafe {
    effects: { sysreg, mem },
    capabilities: { boot },
    justification: "R13-m4-001 (#423): 8-entry GDT SYSRET layout with kernel code64 at 0x08 (fixes boot_stub code32 latent bug). Populate _gdt_new slots 0-5 with byte-exact encodings (null/kernel-code64/kernel-data/reserved/user-data/user-code64), slots 6-7 as zero (deferred). Build GDTR descriptor with limit=0x3F (7*8+7), base=&_gdt_new. Load GDTR via lgdt. #661-followup (softarch 2026-08-06): after lgdt, reload cached CS/SS via a same-privilege iretq to a shim (_gdt_reload_land): build a 5-slot iretq frame (RIP=&_gdt_reload_land, CS=0x08, RFLAGS=current-via-pushfq, RSP=current, SS=0x10) at module-level _gdt_reload_iretq_frame BSS, point RSP at the frame, iretq. The CPU atomically loads new CS/SS/RIP/RSP/RFLAGS, jumps to _gdt_reload_land which returns to gdt_install's caller. Removes the pf_handle_cow trap-frame CS/SS patch: any future kernel→kernel iretq now finds the cached selectors already correct.",
    block: {
      lea rdi, [rip + _gdt_new];

      // Slot 0: null descriptor
      mov rax, 0;
      mov [rdi + 0], rax;

      // Slot 1 (0x08): kernel code64 (0x00AF9A000000FFFF)
      // Byte layout: 0x00AF9A000000FFFF
      //   bits [0:15]   = 0xFFFF (limit low)
      //   bits [16:39]  = 0x0000 (base[0:23])
      //   bits [40:47]  = 0x9A   (type=1011 access=1010, P=1, DPL=00)
      //   bits [48:51]  = 0xF    (limit high)
      //   bits [52:55]  = 0x0    (AVL/L/D/G = 0001 for 64-bit code)
      //   bits [56:63]  = 0x00   (base[24:31])
      mov rax, 0x00AF9A000000FFFF;
      mov [rdi + 8], rax;

      // Slot 2 (0x10): kernel data (0x00AF92000000FFFF)
      // Byte layout: 0x00AF92000000FFFF
      //   bits [40:47]  = 0x92   (type=1001 access=0010, P=1, DPL=00)
      //   bits [52:55]  = 0xF    (limit high, G bit for 64-bit consistency)
      mov rax, 0x00AF92000000FFFF;
      mov [rdi + 16], rax;

      // Slot 3 (0x18): reserved
      mov rax, 0;
      mov [rdi + 24], rax;

      // Slot 4 (0x20): user data (0x00AFF2000000FFFF)
      // Byte layout: 0x00AFF2000000FFFF
      //   bits [40:47]  = 0xF2   (type=1111 access=0010, P=1, DPL=11)
      //   bits [52:55]  = 0xF    (limit high, G bit)
      mov rax, 0x00AFF2000000FFFF;
      mov [rdi + 32], rax;

      // Slot 5 (0x28): user code64 (0x00AFFA000000FFFF)
      // Byte layout: 0x00AFFA000000FFFF
      //   bits [40:47]  = 0xFA   (type=1111 access=1010, P=1, DPL=11, L=1 for 64-bit)
      //   bits [52:55]  = 0xF    (limit high, G bit)
      mov rax, 0x00AFFA000000FFFF;
      mov [rdi + 40], rax;

      // Slot 6 (0x30): TSS lo (deferred, zero for now)
      mov rax, 0;
      mov [rdi + 48], rax;

      // Slot 7 (0x38): TSS hi (deferred, zero for now)
      mov rax, 0;
      mov [rdi + 56], rax;

      // Build GDTR descriptor at _gdt_ptr.
      // Descriptor format: [0:1] = limit (u16), [2:9] = base (u64).
      // Limit = 8*8-1 = 63 = 0x3F (covers all 8 slots).
      lea rsi, [rip + _gdt_ptr];

      // Store limit (0x3F = 63) at offset 0 (u16).
      mov rax, 0x3F;
      mov [rsi], rax;

      // Store base address (&_gdt_new) at offset 2 (u64 boundary).
      // Note: mov to [rsi + imm] not supported; add to rsi first, then mov.
      lea rsi, [rsi + 2];
      lea rdx, [rip + _gdt_new];
      mov [rsi], rdx;

      // Load GDTR via lgdt. Compute _gdt_ptr address again for lgdt operand.
      lea rdi, [rip + _gdt_ptr];
      lgdt [rdi];

      // ---- #661-followup: reload cached CS/SS via same-privilege iretq ----
      // Build the 5-slot iretq frame at _gdt_reload_iretq_frame:
      //   +0  RIP    = &_gdt_reload_land
      //   +8  CS     = 0x08 (kernel code64, DPL=0)
      //   +16 RFLAGS = current (preserves IF=0 — interrupts stay masked)
      //   +24 RSP    = current rsp (kernel_main's return address on top)
      //   +32 SS     = 0x10 (kernel data, DPL=0)
      lea rdi, [rip + _gdt_reload_iretq_frame];

      // Slot 0 — target RIP after iretq.
      lea rax, [rip + _gdt_reload_land];
      mov [rdi + 0], rax;

      // Slot 1 — new CS = 0x08 (kernel code64).
      mov rax, 0x8;
      mov [rdi + 8], rax;

      // Slot 2 — RFLAGS: capture the live value via pushfq/pop so IF, DF,
      // and any other flag state we entered gdt_install with is preserved
      // across the iretq. pushfq/pop are net-zero on the stack, so kernel_
      // main's return address stays put.
      pushfq;
      pop rax;
      mov [rdi + 16], rax;

      // Slot 3 — RSP: capture current stack pointer. iretq will restore
      // RSP to this value, so the ret in _gdt_reload_land pops kernel_
      // main's return address (which sits at [rsp] right now).
      mov [rdi + 24], rsp;

      // Slot 4 — new SS = 0x10 (kernel data). Matches CPL=0 → passes the
      // iretq CS/SS coherency check (SDM Vol 3A §6.14.3).
      mov rax, 0x10;
      mov [rdi + 32], rax;

      // Point RSP at the frame and iretq. iretq pops all five slots
      // atomically and jumps to _gdt_reload_land with fresh CS/SS.
      lea rsp, [rip + _gdt_reload_iretq_frame];
      iretq
    }
  } @no_frame
}
