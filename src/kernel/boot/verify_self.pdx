// src/kernel/boot/verify_self.pdx — R28-M1-004 (#1001)
//
// Kernel-side self-verification of the loaded UEFI PE32+ image (the
// paideia UEFI stub, uefi_stub.efi / PAIDEIA.EFI). Consumes the .pdxsgn
// / .pdxpk / .pdxsig sections that tools/sign-efi.sh appended at fixed
// RVAs (0xd000 / 0xe000 / 0xf000) and decides whether the running
// image is signed under the R28 dev-bypass convention.
//
// -----------------------------------------------------------------------------
// Why this exists at R28 given no crypto substrate is built yet
// -----------------------------------------------------------------------------
//
// The R32 milestone lands the real ML-DSA-65 sign + verify primitives.
// Before that, this file provides the STRUCTURAL half of the pipeline:
//
//   * The `.pdxsgn` trailer (32 B) MUST be present at RVA 0xd000 with
//     magic "PDXSGN01" — a signal that tools/sign-efi.sh has run.
//   * The `.pdxsig` payload (3309 B) MUST be present at RVA 0xf000.
//   * Under the R25.M5 dev-bypass discipline (mirrored from
//     src/kernel/core/fs/pdxfs_lite/verify.pdx pdxfs_sb_verify_sig),
//     the 3309-byte sig field must be bytewise all zeros — a
//     scaffolded "signed" state that lets us prove the pipeline shape
//     without the crypto substrate. Any non-zero byte in that field
//     under R25.M5 means either (a) a corrupted image, or (b) R32
//     landed real ML-DSA-65 bytes but this file was not updated to
//     verify them — either way the safe R28 answer is "UNSIGNED".
//
// When R32 lands:
//   * verify_self_sig_all_zero is replaced with a call into the ML-DSA-65
//     verify primitive at src/kernel/core/crypto/ml_dsa/verify.pdx
//     over the Authenticode PE image hash + embedded public key.
//   * The R28 dev-bypass branch is retired in the same commit; a
//     non-zero sig field then means REAL crypto and drives the real
//     verify path.
//   * At R33 the enforcement flag flips from "log-only" to "halt on
//     verify fail" (VERIFY_SELF_ENFORCE = 1) with KEK enrollment.
//
// -----------------------------------------------------------------------------
// Log lines (per issue #1001 acceptance criteria)
// -----------------------------------------------------------------------------
//
//   OK:       "EFI SIGNATURE OK\r\n"                        (18 bytes)
//   UNSIGNED: "EFI UNSIGNED (enforcement off)\r\n"          (32 bytes)
//
// Emitted on COM1 (0x3F8) via the same inline 16550 THRE-poll pattern
// kernel_main_uefi uses for its own banner (kernel_main_uefi.pdx L152).
// UART is assumed already initialised by kernel_main_uefi before we run.
//
// -----------------------------------------------------------------------------
// Section layout — kept in lockstep with tools/sign-efi.sh
// -----------------------------------------------------------------------------
//
//   .pdxsgn  VMA = image_base + 0xd000  size = 32 B
//   .pdxpk   VMA = image_base + 0xe000  size = 1952 B (ML-DSA-65 pk_bytes)
//   .pdxsig  VMA = image_base + 0xf000  size = 3309 B (ML-DSA-65 sig_bytes)
//
// PE SectionAlignment for the stub is 0x1000, so firmware LoadImage maps
// each section into a fresh 4 KiB page. Reading the tail qword (3 bytes
// past the 3309-byte sig into the SectionAlignment padding) is safe: the
// padding was zero-filled at objcopy time (verified: file bytes 0x24e0+
// are all zero for the signed stub) and firmware pads sections to their
// SectionAlignment boundary in memory too.
//
// -----------------------------------------------------------------------------
// Bounds gate
// -----------------------------------------------------------------------------
//
// The signed stub grows from ~3 KiB unsigned to ~10 KiB signed, and the
// PE header's SizeOfImage grows from 0xd000 (unsigned) to 0x10000
// (signed — because the last section .pdxsig ends at RVA 0xfced which
// rounds up to 0x10000 under SectionAlignment=0x1000). Any image_size <
// 0x10000 CANNOT carry the three signing sections; verify_self short-
// circuits to "UNSIGNED" without touching memory past image_size. This
// gates the whole verify path — no matter what nonsense a caller passes
// in RDI, we never read past image_base + image_size.
//
// -----------------------------------------------------------------------------
// Reserved-label discipline
// -----------------------------------------------------------------------------
//
// Labels prefixed `verify_self_` (avoids `if`, `loop`, `end` per
// feedback_paideia_as_version_discipline.md).

module VerifySelf = structure {

  // ============================================================================
  // Constants — MUST stay in lockstep with tools/sign-efi.sh
  // ============================================================================

  // Fixed section RVAs (see tools/sign-efi.sh PDXSGN_VMA / PDXPK_VMA / PDXSIG_VMA).
  pub let VERIFY_SELF_PDXSGN_RVA : u64 = 0xd000
  pub let VERIFY_SELF_PDXPK_RVA  : u64 = 0xe000
  pub let VERIFY_SELF_PDXSIG_RVA : u64 = 0xf000

  // ML-DSA-65 blob sizes per NIST FIPS 204 §5.4.
  pub let VERIFY_SELF_PDXPK_LEN  : u64 = 1952
  pub let VERIFY_SELF_PDXSIG_LEN : u64 = 3309

  // 3309 bytes ceil-divided by 8 = 414 qwords (3312 bytes). The extra
  // 3 tail bytes read into the SectionAlignment-padding zero region.
  pub let VERIFY_SELF_PDXSIG_QWORDS : u64 = 414

  // Minimum image_size that could possibly carry the three signing
  // sections at their fixed RVAs. See file preamble "Bounds gate".
  pub let VERIFY_SELF_MIN_IMAGE_SIZE : u64 = 0x10000

  // boot_env_t field offsets (mirror src/boot/uefi_env.pdx §"boot_env_t").
  pub let VERIFY_SELF_ENV_IMAGE_BASE_OFF : u64 = 56
  pub let VERIFY_SELF_ENV_IMAGE_SIZE_OFF : u64 = 64

  // "PDXSGN01" as a little-endian u64.
  //   byte[0]='P'=0x50  byte[4]='G'=0x47
  //   byte[1]='D'=0x44  byte[5]='N'=0x4E
  //   byte[2]='X'=0x58  byte[6]='0'=0x30
  //   byte[3]='S'=0x53  byte[7]='1'=0x31
  //   u64 LE = 0x31304E4753584450.
  pub let VERIFY_SELF_MAGIC : u64 = 0x31304E4753584450

  // Return codes (informational — verify_self also emits its own log line).
  pub let VERIFY_SELF_RC_OK       : u64 = 1
  pub let VERIFY_SELF_RC_UNSIGNED : u64 = 0

  // Enforcement flag — at R28 this is 0 (log-only). R33 flips to 1
  // when the KEK-enrollment ceremony lands + the operator has bound
  // the paideia PK into their firmware db. This constant is documented
  // rather than consulted at runtime — verify_self at R28 always
  // returns and never halts, so a runtime read is not needed.
  pub let VERIFY_SELF_ENFORCE : u64 = 0

  // ============================================================================
  // Message strings — raw ASCII (post-EBS, we drive the 16550 THR directly).
  // ============================================================================

  //   "EFI SIGNATURE OK\r\n"  (18 bytes)
  pub let _verify_self_msg_ok : [u8; 18] = [
    0x45u8, 0x46u8, 0x49u8, 0x20u8,             // "EFI "
    0x53u8, 0x49u8, 0x47u8, 0x4Eu8, 0x41u8,     // "SIGNA"
    0x54u8, 0x55u8, 0x52u8, 0x45u8, 0x20u8,     // "TURE "
    0x4Fu8, 0x4Bu8,                             // "OK"
    0x0Du8, 0x0Au8                              // \r\n
  ]

  //   "EFI UNSIGNED (enforcement off)\r\n"  (32 bytes)
  pub let _verify_self_msg_unsigned : [u8; 32] = [
    0x45u8, 0x46u8, 0x49u8, 0x20u8,             // "EFI "
    0x55u8, 0x4Eu8, 0x53u8, 0x49u8, 0x47u8,     // "UNSIG"
    0x4Eu8, 0x45u8, 0x44u8, 0x20u8,             // "NED "
    0x28u8, 0x65u8, 0x6Eu8, 0x66u8, 0x6Fu8,     // "(enfo"
    0x72u8, 0x63u8, 0x65u8, 0x6Du8, 0x65u8,     // "rceme"
    0x6Eu8, 0x74u8, 0x20u8,                     // "nt "
    0x6Fu8, 0x66u8, 0x66u8, 0x29u8,             // "off)"
    0x0Du8, 0x0Au8                              // \r\n
  ]

  // ============================================================================
  // _verify_self_pdxpk_expected — 1952-byte embedded ML-DSA-65 public-key
  // fixture, mirrored from tools/sign-efi.sh's --pk default.
  //
  // Present so the R32 upgrade can add "PK match" verification without
  // moving the fixture around. Not consulted at R28 — the dev-bypass
  // check on the sig field is the R28 gate (see file preamble).
  //
  // Path from src/kernel/boot/verify_self.pdx to
  // assets/keys/paideia-root-dev.pub: three ../ steps
  // (boot -> kernel -> src -> repo root).
  //
  // @align(64) matches pdxfs_lite/pubkey.pdx discipline — the R32 verify
  // path will burst-load key words in aligned 64-byte chunks.
  // ============================================================================
  pub let _verify_self_pdxpk_expected : [u8; 1952] =
    @include_bytes("../../../assets/keys/paideia-root-dev.pub") @align(64)

  // ============================================================================
  // verify_self_puts(msg_ptr: u64, len: u64) -> ()
  //
  //   rdi = msg_ptr, rsi = len.
  //
  // Emits `len` bytes from msg_ptr to COM1 (0x3F8) with 16550 THRE-poll
  // between bytes. UART must already be initialised (kernel_main_uefi
  // Phase 2 handles that before calling verify_self).
  //
  // Register plan (SysV caller-save only; no no-frame push/pop needed):
  //   rbx = byte pointer (walks msg_ptr)
  //   rcx = bytes remaining
  //   rax = per-byte scratch
  //   rdx = port immediate load target
  //
  // rbx is SysV callee-saved — we push it on entry / pop on return.
  // ============================================================================
  pub let verify_self_puts : (u64, u64) -> () !{sysreg, mem, PortIo} @{paideia.port_io} =
    fn (msg_ptr: u64, len: u64) -> unsafe {
      effects: {sysreg, mem, PortIo},
      capabilities: {boot, paideia.port_io},
      justification: "R28-M1-004 (#1001). Emit `len` bytes from RDI to COM1 (0x3F8) with 16550D §3.4 THRE-poll (LSR@0x3FD bit 5) between bytes. Byte-identical polling shape to kernel_main_uefi.pdx Phase 3 (L148 kernel_main_uefi_tx_loop). rbx is SysV callee-saved; pushed/popped around the loop so the caller (verify_self) can rely on it across our call. Zero-length input returns immediately without any port I/O. Labels prefixed verify_self_puts_ to satisfy reserved-label discipline.",
      block: {
        push rbx;

        mov rbx, rdi;
        mov rcx, rsi;

      verify_self_puts_top:
        cmp rcx, 0;
        je  verify_self_puts_done;

      verify_self_puts_poll:
        mov dx, 0x3FD;
        in_al al;
        and rax, 0x20;
        jz  verify_self_puts_poll;

        mov al, [rbx];
        mov dx, 0x3F8;
        out_al al;

        add rbx, 1;
        sub rcx, 1;
        jmp verify_self_puts_top;

      verify_self_puts_done:
        pop rbx;
        ret
      }
    }

  // ============================================================================
  // verify_self(env_pa: u64) -> u64
  //
  //   rdi = env_pa (physical address of the boot_env_t built by the
  //                 UEFI stub finalizer — see src/boot/uefi_env.pdx).
  //
  //   Returns rax = 1 (VERIFY_SELF_RC_OK) on structural sign-and-verify
  //                 pass under the R28 dev-bypass rule.
  //           rax = 0 (VERIFY_SELF_RC_UNSIGNED) on missing/malformed
  //                 signing sections or a non-zero sig field.
  //
  //   Also emits the acceptance-criteria log line via verify_self_puts
  //   ("EFI SIGNATURE OK" or "EFI UNSIGNED (enforcement off)").
  //
  // Verify flow:
  //
  //   (1) Load image_base into rbp (callee-save) and image_size into rbx
  //       from env_pa + {56, 64}. Push rbp/rbx on entry.
  //
  //   (2) Bounds gate: if image_size < VERIFY_SELF_MIN_IMAGE_SIZE
  //       (0x10000) then the three signing sections cannot fit —
  //       jump to verify_self_unsigned without any further memory
  //       reads.
  //
  //   (3) Magic check: read u64 at image_base + PDXSGN_RVA (0xd000);
  //       compare to VERIFY_SELF_MAGIC (0x31304E4753584450 = "PDXSGN01"
  //       LE). Mismatch -> verify_self_unsigned.
  //
  //   (4) Sig-all-zero check (R25.M5 dev-bypass): OR-fold 414 qwords
  //       starting at image_base + PDXSIG_RVA (0xf000). Any non-zero
  //       qword -> verify_self_unsigned. The 414th qword extends 3
  //       bytes past the 3309-byte sig into SectionAlignment padding
  //       (zero-filled by objcopy — see file preamble).
  //
  //   (5) All pass: emit _verify_self_msg_ok + return 1.
  //
  // Register plan:
  //   rbp = image_base (callee-save; pushed on entry)
  //   rbx = image_size (callee-save; pushed on entry) then repurposed
  //         as byte-pointer walker after the bounds gate
  //   r11 = OR accumulator for sig-all-zero
  //   r10 = qword walker for sig scan
  //   rcx = qword counter (414)
  //   rax = per-load scratch + return value
  //   rdx = temp for magic compare
  //
  // Non-leaf: calls verify_self_puts. Standard prologue/epilogue.
  // ============================================================================
  pub let verify_self : (u64) -> u64 !{sysreg, mem} @{} =
    fn (env_pa: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "R28-M1-004 (#1001). Kernel-side self-verify of the loaded UEFI PE32+ image under the R25.M5 dev-bypass convention (mirrored from pdxfs_lite/verify.pdx pdxfs_sb_verify_sig). Reads image_base/image_size from boot_env_t at env_pa + {56, 64}, gates on image_size >= 0x10000 (else the three signing sections cannot fit at their fixed RVAs 0xd000/0xe000/0xf000), verifies the .pdxsgn magic u64 at image_base + 0xd000 matches 'PDXSGN01' LE, then OR-folds 414 qwords starting at image_base + 0xf000 (3312 bytes; the 3-byte tail past sig_len=3309 lands in SectionAlignment padding which objcopy zero-fills). Any failure emits 'EFI UNSIGNED (enforcement off)' (32 bytes) via verify_self_puts and returns 0; success emits 'EFI SIGNATURE OK' (18 bytes) and returns 1. R28 is log-only (VERIFY_SELF_ENFORCE=0); R33 flips the flag when KEK enrollment lands and the R32 real ML-DSA-65 verify primitive replaces this file's step (4) with a call into src/kernel/core/crypto/ml_dsa/verify.pdx. rbp holds image_base (callee-save; pushed on entry); rbx starts holding image_size then walks nothing (repurposed to nothing after the gate — the sig scan uses r10). r11 = OR accumulator, r10 = qword walker, rcx = 414-count, rax = load/return. All labels prefixed verify_self_ to satisfy the reserved-label discipline.",
      block: {
        push rbp;
        push rbx;

        // (1) Latch image_base + image_size from boot_env_t.
        mov rbp, [rdi + 56];
        mov rbx, [rdi + 64];

        // (2) Bounds gate: image_size >= 0x10000 required.
        mov rax, 0x10000;
        cmp rbx, rax;
        jb  verify_self_unsigned;

        // (3) Magic check: [image_base + 0xd000] == "PDXSGN01" LE.
        mov rax, rbp;
        add rax, 0xd000;
        mov rdx, [rax];
        mov rax, 0x31304E4753584450;
        cmp rdx, rax;
        jne verify_self_unsigned;

        // (4) Sig-all-zero check: OR-fold 414 qwords starting at
        //     image_base + 0xf000.
        mov r10, rbp;
        add r10, 0xf000;
        xor r11, r11;
        mov rcx, 414;

      verify_self_sig_next:
        mov rax, [r10];
        or  r11, rax;
        add r10, 8;
        dec rcx;
        jne verify_self_sig_next;

        cmp r11, 0;
        jne verify_self_unsigned;

        // (5) All checks pass — emit OK banner and return 1.
        lea rdi, [rip + _verify_self_msg_ok];
        mov rsi, 18;
        call verify_self_puts;

        mov rax, 1;
        pop rbx;
        pop rbp;
        ret;

      verify_self_unsigned:
        // Any failure path (bounds, magic, non-zero sig) — emit the
        // UNSIGNED warning and return 0. R28 is log-only per
        // VERIFY_SELF_ENFORCE; R33 will halt here when enforcement
        // lands + KEK enrollment is complete.
        lea rdi, [rip + _verify_self_msg_unsigned];
        mov rsi, 32;
        call verify_self_puts;

        xor eax, eax;
        pop rbx;
        pop rbp;
        ret
      }
    }
}
