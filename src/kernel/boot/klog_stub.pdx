// src/kernel/boot/klog_stub.pdx — paideia-os #2227 pre-klog witness framing
//
// klog_stub_puts: a minimal composer that reproduces the human-readable klog
// prefix (`[    0.000000] INFO  cpu0 <subsys>  : `) for the small handful of
// boot-time witness lines that MUST fire BEFORE the klog subsystem is fully
// operational.
//
// -----------------------------------------------------------------------------
// Motivation
// -----------------------------------------------------------------------------
// The boot audit that closed #2226 flagged a residual cluster of witness
// lines that reach COM1 without the standard klog framing:
//
//   SMP BRINGUP START            <- kernel_main.pdx (this repo)
//   SMP BRINGUP DONE             <- kernel_main.pdx (this repo)
//   IOAPIC REROUTE STRUCT OK     <- tests/kernel/apic/ioapic_reroute_synth
//   MSIX ROUND ROBIN OK          <- tests/kernel/apic/msix_round_robin
//
// All four are emitted from ring-0 sites at boot time whose exact placement
// forbids a klog_s1 call — SMP BRINGUP START/DONE bracket ap_bring_up_all
// where the AP interleave has no ordered claim on the emit ring, and the
// two APIC synth witnesses ran through raw uart_puts by convention since
// their inception (R21.M3-004 / R21.M4-005) so the exact bytes reach COM1
// with no timestamp jitter that would perturb the SMP-adjacency window the
// r21 goldens assert.
//
// The RIGHT answer is not to elide framing, and not to route these lines
// through the full klog composer (which drags the HPET-timestamp path, the
// re-entrancy gate, the ring-buffer drain, and the audit forward -- none of
// which these sites need or should share).  The right answer is a tiny
// stand-alone composer that stamps the shape klog would produce, using a
// fixed `[    0.000000]` timestamp (the audit reader wants only the token
// framing -- see design/kernel/boot-transcript.md) and a hardcoded `cpu0`
// (all four sites run on BSP inside a boot cli window pre- or immediately
// post- the AP wake), then delegates to the same uart_puts / uart_putc
// primitives the raw emissions already used.
//
// The stub is DELIBERATELY not exported into module Klog -- it shares no
// code with the composer and would create a false dependency edge if it
// lived alongside emit.pdx / format.pdx / wrappers.pdx.  Its home is
// src/kernel/boot/ where the raw-uart_puts callers already lived.
//
// -----------------------------------------------------------------------------
// Wire format
// -----------------------------------------------------------------------------
// Byte-identical to what klog_emit_core (core/klog/emit.pdx) produces on a
// synthetic INFO/cpu0/boot/<msg> row at the very first tick:
//
//   [    0.000000] INFO  cpu0 boot    : <msg>
//   \_______________________/\________/\____/\___________/
//         26-byte prefix        subsys   sep   caller-owned
//                              (padded)         (trailing \n)
//
// Prefix breakdown (26 bytes, matches emit.pdx steps 6-8):
//   '['                          -> 1 byte
//   "    0"                      -> 5 bytes  (right-padded seconds)
//   '.'                          -> 1 byte
//   "000000"                     -> 6 bytes  (zero-padded microseconds)
//   "] "                         -> 2 bytes
//   "INFO "                      -> 5 bytes  (LEVEL_WORDS row for LEVEL_INFO)
//   ' '                          -> 1 byte   (level-column trailing space)
//   "cpu0"                       -> 4 bytes  (literal "cpu" + '0')
//   ' '                          -> 1 byte   (cpu-column trailing space)
// = 26 bytes.
//
// The subsys column is composed at runtime by copying the caller-supplied
// subsys tag (NUL-terminated, up to KLOG_SUBSYS_COLUMN_WIDTH=8 bytes) then
// right-padding with spaces to reach column 8.  This mirrors emit.pdx
// step 9 exactly, so a SUBSYS_BOOT ("boot\0", 4 bytes) prints as
// "boot    " and a longer subsys grows the field only within its 8-column
// budget -- symmetric with the composer's behaviour today.
//
// The message is emitted last via uart_puts, which stops on the caller-
// provided NUL terminator; every existing witness message already ends in
// "\n\0" so the wire line finishes on a proper line boundary.
//
// -----------------------------------------------------------------------------
// Release-mode gate (#1572 posture)
// -----------------------------------------------------------------------------
// Uart.uart_puts is muted when `_kernel_build_mode != 0` (R49.M1-002
// #1572) so release builds emit only what the Present module posts via
// uart_putc directly.  This stub goes through BOTH uart_puts (prefix +
// msg) AND uart_putc (per-byte subsys copy + padding + ": " separator);
// the uart_puts halves would mute themselves but the uart_putc halves
// would bypass the mute, producing partial "boot    : " fragments in
// release output.  The gate at the top of klog_stub_puts closes that
// window -- release mode emits ZERO bytes, matching the pre-#2227
// bare-uart_puts semantics for these lines.
//
// -----------------------------------------------------------------------------
// Register / alignment plan
// -----------------------------------------------------------------------------
// Three-push callee-save prologue (rbx, r12, r13):
//   rbx  <- subsys-column pad counter (0..8)
//   r12  <- subsys_tag_ptr (arg0, saved across uart_puts/uart_putc)
//   r13  <- msg_ptr        (arg1, saved across uart_puts/uart_putc)
// SysV entry rsp%16 == 8; 3 pushes -> (8+24)%16 == 0, so every nested
// call inside the body sees rsp%16 == 0 -- matches the discipline the
// two APIC synth witnesses (5-push, 3-push respectively) already keep.
//
// -----------------------------------------------------------------------------
// Encoder discipline
// -----------------------------------------------------------------------------
// Byte-loads use `mov rax, [rsi]; and rax, 0xff; jz` -- the proven idiom
// from Uart.uart_puts and Emit.klog_emit_core (subsys_copy_loop /
// tag_copy_loop / kv_key_copy).  No `test`, no `mov_bzx`, no
// `add reg,[mem]`.  Immediates fit imm8/imm32.  Labels prefixed with
// `klog_stub_` (reserved-label discipline per the paideia-as reserved-
// word note in project memory).

module KlogStub = structure {
  // 26-byte fixed prefix.  See "Wire format" above for the byte layout.
  // Trailing NUL terminates the uart_puts walk.
  pub let _klog_stub_prefix : [u8; 27] = "[    0.000000] INFO  cpu0 \0"

  pub let klog_stub_puts : (u64, u64) -> () !{sysreg, mem} @{boot} =
    fn (subsys_tag_ptr: u64) (msg_ptr: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "paideia-os #2227 pre-klog witness framing composer. Emits the byte-identical shape klog_emit_core produces at t=0 (`[    0.000000] INFO  cpu0 <subsys>  : <msg>`) without invoking any of the klog machinery -- no HPET read, no re-entrancy gate, no ring drain, no audit forward. Every emission path is uart_puts (for the fixed prefix and the caller's already-\\n\\0-terminated message) or uart_putc (for the subsys copy, the space padding to 8 columns, and the `: ` separator). Release-mode gate at the top of the body checks _kernel_build_mode == 0 and early-returns otherwise: without this gate the uart_puts halves would mute themselves (Uart.uart_puts's #1572 gate) but the uart_putc halves would bypass, producing partial `boot    : ` fragments on the wire in release builds. Register plan: 3-push (rbx = subsys pad counter, r12 = subsys_tag_ptr, r13 = msg_ptr). Entry rsp%16==8 + 3*push == (8+24)%16 == 0, so every internal call sees rsp%16 == 0 (SysV pre-call). Subsys copy is the proven `mov rax, [rsi]; and rax, 0xff; jz` idiom from Uart.uart_puts and Emit.klog_emit_core -- no `test`, no `mov_bzx`. Subsys padding loop compares rbx to 8 (KLOG_SUBSYS_COLUMN_WIDTH from core/klog/subsys.pdx) and emits one space per iteration until saturated -- identical semantics to emit.pdx subsys_pad_loop. ':' (0x3A) then ' ' (0x20) close the prefix, then uart_puts on the caller message emits the free-form body and its trailing '\\n'. Effects {sysreg, mem}: sysreg for uart_putc's I/O-port write, mem for the [rip+_kernel_build_mode] load and the byte-load walk of the subsys tag. @{boot} matches every ring-0 caller in this repo (kernel_main.pdx and tests/kernel/apic/*).",
      block: {
        // Release-mode mute -- matches Uart.uart_puts's #1572 posture so
        // release builds emit no fragments for the sites that migrate to
        // this stub.  All internal emission paths (uart_puts prefix,
        // uart_putc subsys/pad/sep, uart_puts msg) are downstream of this
        // early-return.
        mov rax, [rip + _kernel_build_mode];
        cmp rax, 0;
        jne klog_stub_puts_muted;

        // Prologue: 3-push callee-save.
        push rbx;
        push r12;
        push r13;

        // Stash args in callee-save slots; rdi/rsi are clobbered by every
        // nested call below.
        mov r12, rdi;                              // r12 = subsys_tag_ptr
        mov r13, rsi;                              // r13 = msg_ptr

        // Step 1: emit the 26-byte fixed prefix "[    0.000000] INFO  cpu0 ".
        lea rdi, [rip + _klog_stub_prefix];
        call uart_puts;

        // Step 2: subsys copy with column-count tracking in rbx.
        xor rbx, rbx;                              // rbx = printed subsys count
        mov rsi, r12;                              // rsi = subsys cursor

      klog_stub_subsys_copy:
        mov rax, [rsi];
        and rax, 0xff;                             // isolate low byte
        jz klog_stub_subsys_pad;
        mov rdi, rax;
        call uart_putc;
        add rsi, 1;
        add rbx, 1;
        jmp klog_stub_subsys_copy;

        // Step 3: right-pad subsys column with spaces to reach
        // KLOG_SUBSYS_COLUMN_WIDTH (8, per core/klog/subsys.pdx).
      klog_stub_subsys_pad:
        cmp rbx, 8;
        jae klog_stub_after_subsys;
        mov rdi, 0x20;                             // ' '
        call uart_putc;
        add rbx, 1;
        jmp klog_stub_subsys_pad;

      klog_stub_after_subsys:
        // Step 4: emit the ': ' separator (colon + space) between the
        // fixed-column prefix and the free-form message body.  Matches
        // emit.pdx step 10 byte-for-byte.
        mov rdi, 0x3A;                             // ':'
        call uart_putc;
        mov rdi, 0x20;                             // ' '
        call uart_putc;

        // Step 5: emit the caller-owned message (already terminated by
        // '\n\0' at every existing call site).
        mov rdi, r13;
        call uart_puts;

        // Epilogue.
        pop r13;
        pop r12;
        pop rbx;
        ret;

      klog_stub_puts_muted:
        ret
      }
    }
}
