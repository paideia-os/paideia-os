// src/kernel/boot/root_select.pdx -- R53.M3-003 (#1744)
//
// PDXFS-ON-BLOCK v1 -- ROOT-VOLUME SELECTION ORDER.
//
// -----------------------------------------------------------------------------
// Scope
// -----------------------------------------------------------------------------
//
// Per design/tooling/volume-lifecycle-mechanism.md §4.4 (restatement of
// design/filesystem/volume-fs-substrate.md §3.3), the kernel picks the
// bootstrap root volume by walking a fixed precedence:
//
//   1. Bootloader UUID hint         -- volume-registry lookup by uuid
//   2. Boot cmdline `root=UUID=...` -- same lookup, different source
//   3. Single-device disambiguation -- one probed volume, no ambiguity
//   4. Fallback: no PDXFS_BLOCK root -- caller mounts tmpfs at slot 0
//
// The sibling issue for mount_bootstrap (R53.M3-004) is what actually
// installs slot 0 from this decision; this file is the decision proper
// and holds no mount-table authority of its own -- it never writes any
// KIND_VOLUME row, never mints any capability, never touches
// _mount_table. The caller does all of that.
//
// -----------------------------------------------------------------------------
// Design-doc note: simplified relative to §4.4
// -----------------------------------------------------------------------------
//
// The design doc's steps 1 and 2 both PANIC when the source names a
// uuid that the volume registry does not know (a signed loader named a
// volume the probe did not find; a cmdline flag likewise). The R53.M3
// issue #1744 as written simplifies both: a miss falls through to the
// next step and eventually to the tmpfs fallback -- not a panic. The
// panic-on-miss variant lives in the follow-up milestone that also
// wires the signed-loader path end to end. This file's behaviour is
// therefore "search, and on miss keep going" for all three lookup
// steps, and the tmpfs fallback is the terminal answer when nothing
// resolves. That policy is intentional so the current -kernel smoke
// mode (which passes no --with-disk and thus registers zero volumes)
// keeps booting into the tmpfs bootstrap unchanged; a stricter panic
// path would break every existing smoke line the moment this file was
// wired in.
//
// -----------------------------------------------------------------------------
// Stub bindings pending sibling issues
// -----------------------------------------------------------------------------
//
// Steps 1 and 2 both consume a POINTER to a 16-byte uuid (lo @+0,
// hi @+8), or 0 if that source did not produce a hint. The producers
// live outside this file and land in later sibling issues:
//
//   * R53.M3-001 (#1742) factors the boot-time handoff record into its
//     own module (src/kernel/boot/handoff.pdx) and exports
//     `handoff_root_uuid_ptr() -> u64` -- the step-1 source.
//   * The cmdline flag parser (not yet issue-tracked here) parses
//     `root=UUID=xxxx-...` and stashes the parsed uuid at
//     `_boot_flag_root_uuid` -- the step-2 source.
//
// Neither producer has landed. To keep this file buildable in advance
// of them, the two lookups go through in-file leaf placeholders
// `_root_sel_hint_uuid_ptr` and `_root_sel_flag_uuid_ptr`, both of
// which return 0 today (i.e. no hint, no flag). When #1742 lands, its
// migration is a one-line swap in root_select's step-1 arm:
//     `call _root_sel_hint_uuid_ptr` -> `call handoff_root_uuid_ptr`
// and the local placeholder is deleted in the same commit. Same shape
// for the flag parser when that lands. The task brief for #1744
// explicitly permits leaving these as stubs pending their producers,
// mirroring the same discipline this codebase already applies to
// probe/mount wire-ups whose producers land in later milestones.
//
// -----------------------------------------------------------------------------
// Signature (#1744 brief)
// -----------------------------------------------------------------------------
//
//   root_select(volume_table_ptr, count) -> u64
//     rdi = volume_table_ptr  (reserved for future direct-table access;
//                              this file walks the registry through the
//                              kind_volume.pdx / volume_registry.pdx
//                              exported accessors, matching the same
//                              one-writer-per-table discipline
//                              volume_registry.pdx's own header
//                              documents; the caller's pointer is
//                              accepted and unused today)
//     rsi = count             (upper bound on rows to scan; capped at
//                              VOL_MAX=16, so a caller passing a larger
//                              or garbage value is clamped rather than
//                              trusted)
//     rax = row_id (0..15) on success
//         = 0xFFFFFFFFFFFFFFFF (-1) on fallback -- caller mounts tmpfs
//
// The row_id return value is the SAME identifier kind_volume.pdx's
// accessors take (0..VOL_MAX). The caller (mount_bootstrap in
// R53.M3-004 / #1745) is the module that turns that row_id into a
// MOUNT_BACKEND_PDXFS_BLOCK slot-0 install.
//
// -----------------------------------------------------------------------------
// Arity discipline (design/filesystem/r52-implementation-plan.md §5.1)
// -----------------------------------------------------------------------------
//
// `root_select` is arity 2 (volume_table_ptr, count). Both stub leaves
// `_root_sel_hint_uuid_ptr` and `_root_sel_flag_uuid_ptr` are arity 0.
// Comfortably under the 6-arg SysV ceiling.
//
// -----------------------------------------------------------------------------
// Register discipline
// -----------------------------------------------------------------------------
//
// `root_select` needs to keep four values live across nested calls into
// `volume_registry_find` and `volume_tail_valid`:
//
//   rbx = count_cap        (min(count, VOL_MAX), computed once at entry)
//   r12 = loop_index       (step-3 counter, 0..count_cap)
//   r13 = live_count       (step-3 accumulator)
//   r14 = last_seen_row    (step-3 witness -- the row_id from the
//                           latest tail_valid == 1 iteration)
//
// 4 pushes = 32 B. SysV entry rsp%16 == 8, so after 4 pushes rsp%16 is
// still 8; `sub rsp, 8` brings it to 0, matching
// volume_registry_register's own 4-push + pad shape (this file's peer
// in the volume-lifecycle chain).
//
// The two placeholder leaves have no nested call, no callee-save reg
// use, and thus need no prologue (matching volume_registry_stat's own
// leaf shape).
//
// -----------------------------------------------------------------------------
// mov_b / no-test / label-prefix discipline
// -----------------------------------------------------------------------------
//
// No byte-granularity access anywhere in this file (every field
// touched is a whole qword: uuid halves at [ptr+0] / [ptr+8], row_id,
// bounded counters). No `test` instruction; every branch uses
// `cmp reg, imm` / `cmp reg, reg` + `je`/`jne`/`jae`/`jb`. Every label
// is prefixed `rsel_` (root-select) -- distinct from `vol_*`
// (kind_volume.pdx), `vreg_*` (volume_registry.pdx), `rs_*`
// (semterm/resultset.pdx), and `bm_rs_*` (policy/battery_monitor.pdx).
// grep audit at authoring time: no `rsel_` hits elsewhere under
// src/kernel/.
//
// -----------------------------------------------------------------------------
// Runtime output
// -----------------------------------------------------------------------------
//
// R53.M3-005 (#1746) task brief pins the fingerprint emission for the
// two root-select outcomes on THIS file (not the mount_bootstrap call
// site as the earlier landing anticipated): `PDXB ROOT SELECTED` fires
// on every non-fallback exit (hint hit, flag hit, or single-device
// disambiguation win); `PDXB ROOT FALLBACK` fires on the terminal
// fallback exit. Both are output-strip-clean per design/policy/output-
// provenance-strip.md (no release, milestone, or issue reference in the
// emitted string). The two emit sites live at the shared `rsel_done`
// tail and the `rsel_fallback` block respectively -- see the register
// discipline note below for why the callee-save rax spill goes through
// r13 (dead by that point in both paths).

module RootSelect = structure {

  // ============================================================================
  // ROOT_SEL_NONE -- the -1 sentinel returned to the caller when no
  // pdxfs_block volume was selected and the caller must fall back to the
  // R16 tmpfs bootstrap. Re-declared here rather than aliased across
  // files, matching this codebase's "constants are re-declared, not
  // cross-file-imported" convention (see superblock.pdx / volume_registry.pdx
  // for the same discipline). The value is the 64-bit two's-complement of
  // -1 (unsigned 0xFFFFFFFFFFFFFFFF); callers compare with `cmp rax, -1`
  // or against this constant.
  // ============================================================================
  pub let ROOT_SEL_NONE : u64 = 0xFFFFFFFFFFFFFFFF

  // ROOT_SEL_MAX -- upper bound on scan; equal to kind_volume.pdx's
  // VOL_MAX (16 rows). Re-declared here so a caller passing a garbage
  // `count` argument gets clamped rather than trusted, and so this file
  // does not depend on a header-import of kind_volume constants.
  pub let ROOT_SEL_MAX : u64 = 16

  // ============================================================================
  // R53.M3-005 (#1746) fingerprint strings.  Length count includes the
  // trailing "\n\0" pair.  Output-strip-clean per design/policy/output-
  // provenance-strip.md (no round/milestone/issue reference in either
  // string).  The shell-shutdown golden pins the FALLBACK line (the
  // only outcome the substrate boot ever reaches); the SELECTED line
  // becomes reachable once a live PdxFS-block volume is present, at
  // which point it lands in a live-mode golden separately.
  // ============================================================================

  pub let pdxb_root_selected_msg : [u8; 20] = "PDXB ROOT SELECTED\n\0"
  pub let pdxb_root_fallback_msg : [u8; 20] = "PDXB ROOT FALLBACK\n\0"

  // ============================================================================
  // _root_sel_hint_uuid_ptr() -> u64
  //
  // STUB pending R53.M3-001 (#1742). Returns 0 today: no bootloader
  // hint is available until the handoff.pdx factor-out lands and its
  // `handoff_root_uuid_ptr` export replaces this call site. When it
  // does, delete this leaf and rewrite `call _root_sel_hint_uuid_ptr`
  // in root_select below to `call handoff_root_uuid_ptr`. Contract of
  // the future exported function is identical to this stub's contract:
  // returns a pointer to a 16-byte uuid buffer (lo @+0, hi @+8), or 0
  // if the loader did not populate the hint.
  //
  // No prologue (leaf, no callee-save use, no nested call).
  // ============================================================================
  let _root_sel_hint_uuid_ptr : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R53.M3-003 (#1744): stub pending R53.M3-001 (#1742). Returns 0 (no hint). Leaf; no prologue, no nested call, no callee-save register use.",
      block: {
        xor rax, rax;
        ret
      }
    }

  // ============================================================================
  // _root_sel_flag_uuid_ptr() -> u64
  //
  // STUB pending the boot cmdline flag parser (not yet issue-tracked
  // here). Returns 0 today: no `root=UUID=...` flag is parsed until
  // that parser lands and its `_boot_flag_root_uuid` slot (or a
  // dedicated `boot_flag_root_uuid_ptr` accessor if the parser exports
  // one) replaces this call site. Contract is identical to the hint
  // stub above: pointer to a 16-byte uuid buffer, or 0.
  //
  // No prologue.
  // ============================================================================
  let _root_sel_flag_uuid_ptr : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R53.M3-003 (#1744): stub pending boot cmdline flag parser. Returns 0 (no flag). Leaf; no prologue, no nested call, no callee-save register use.",
      block: {
        xor rax, rax;
        ret
      }
    }

  // ============================================================================
  // root_select(volume_table_ptr, count) -> row_id | ROOT_SEL_NONE
  //
  // Walks the four-step precedence documented in the file header.
  // Returns 0..15 on hit (the row_id in kind_volume.pdx's _volume_table),
  // or ROOT_SEL_NONE (0xFFFFFFFFFFFFFFFF, i.e. -1) on fallback.
  //
  // 4-push prologue (rbx=count_cap, r12=loop_index, r13=live_count,
  // r14=last_seen_row) + sub rsp,8 pad -- lands rsp%16==0 (SysV entry
  // rsp%16==8, 4 pushes + 8-byte pad = 40 bytes = 0 mod 16). The pad
  // matches volume_registry_register's own 4-push shape.
  // ============================================================================
  pub let root_select : (u64, u64) -> u64 !{mem, sysreg} @{} =
    fn (volume_table_ptr: u64) (count: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "R53.M3-003 (#1744) + R53.M3-005 (#1746) fingerprint hook: four-step root-volume selection (hint > flag > single > tmpfs-fallback). 4-push prologue (rbx=count_cap, r12=loop_index, r13=live_count, r14=last_seen_row) + sub rsp,8 pad lands rsp%16==0 (even count). volume_table_ptr (rdi) is accepted and unused today per file header -- the walk goes through kind_volume.pdx / volume_registry.pdx exported accessors, matching the one-writer-per-table discipline volume_registry.pdx already documents. Body: (0) compute count_cap = min(count, ROOT_SEL_MAX=16) into rbx via branchy min (paideia-as may not encode cmovb per io_queue.pdx's own note). (1) HINT: call _root_sel_hint_uuid_ptr (stub returns 0 pending #1742); on nonzero, load uuid_lo/hi from [ptr+0]/[ptr+8], call volume_registry_find; miss (rax==0xFF) falls through to step 2, hit converges on rsel_selected with rax holding the row_id. (2) FLAG: identical shape via _root_sel_flag_uuid_ptr (stub returns 0 pending cmdline flag parser). (3) SINGLE: xor r12/r13/r14 to zero; loop r12=0..count_cap, calling volume_tail_valid(r12); on rax!=0 bump r13 and mov r14,r12; on loop end cmp r13,1 with je -> converge on rsel_selected with rax=r14. Any other live_count (0 or >=2) falls through. (4) FALLBACK (rsel_fallback): emit 'PDXB ROOT FALLBACK' via klog_s1 first (rax is already dead once we know we are falling back), then mov rax, ROOT_SEL_NONE (0xFFFFFFFFFFFFFFFF), then jmp rsel_ret. (5) SELECTED (rsel_selected): spill rax through r13 (dead after the step-3 loop since live_count is no longer needed once the selection is made -- and r13 is callee-save, so it survives klog_s1's SysV clobber), emit 'PDXB ROOT SELECTED', restore rax from r13, fall through to rsel_ret. Both fingerprint strings are output-strip-clean per design/policy/output-provenance-strip.md. Note: this file does NOT panic on hint-miss / multi-flag-ambiguous, deviating from design/tooling/volume-lifecycle-mechanism.md §4.4's stricter variant per this file's own header design-doc-gap note -- the panic-on-miss variant follows in the milestone that wires the signed-loader path end to end. Reserved labels: rsel_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        sub rsp, 8;

        // ------------------------------------------------------------
        // (0) count_cap = min(count, ROOT_SEL_MAX) -- clamp caller's
        //     count against the hard ceiling. Branchy min: paideia-as
        //     may not encode cmovb (see io_queue.pdx's own note).
        // ------------------------------------------------------------
        mov rbx, 16;                     // ROOT_SEL_MAX
        cmp rsi, rbx;
        jae rsel_cap_ok;
        mov rbx, rsi;
      rsel_cap_ok:

        // ------------------------------------------------------------
        // (1) HINT: bootloader UUID via _root_sel_hint_uuid_ptr.
        //     Stub returns 0 pending R53.M3-001 (#1742).
        // ------------------------------------------------------------
        call _root_sel_hint_uuid_ptr;
        cmp rax, 0;
        je rsel_step_flag;
        mov rdi, [rax + 0];              // uuid_lo
        mov rsi, [rax + 8];              // uuid_hi
        call volume_registry_find;
        mov r10, 0xFF;                   // VREG_ROW_NONE (per volume_registry.pdx)
        cmp rax, r10;
        je rsel_step_flag;
        jmp rsel_selected;               // hit -- rax holds row_id

      rsel_step_flag:
        // ------------------------------------------------------------
        // (2) FLAG: cmdline `root=UUID=...` via _root_sel_flag_uuid_ptr.
        //     Stub returns 0 pending the boot cmdline flag parser.
        // ------------------------------------------------------------
        call _root_sel_flag_uuid_ptr;
        cmp rax, 0;
        je rsel_step_single;
        mov rdi, [rax + 0];              // uuid_lo
        mov rsi, [rax + 8];              // uuid_hi
        call volume_registry_find;
        mov r10, 0xFF;                   // VREG_ROW_NONE
        cmp rax, r10;
        je rsel_step_single;
        jmp rsel_selected;               // hit -- rax holds row_id

      rsel_step_single:
        // ------------------------------------------------------------
        // (3) SINGLE-DEVICE DISAMBIGUATION: exactly one live row in
        //     the volume registry, we pick it. Iterate 0..count_cap,
        //     count via volume_tail_valid, remember the last hit; on
        //     loop end, if live_count == 1, return last_seen_row.
        // ------------------------------------------------------------
        xor r12, r12;                    // loop_index = 0
        xor r13, r13;                    // live_count = 0
        xor r14, r14;                    // last_seen_row = 0

      rsel_cnt_top:
        cmp r12, rbx;
        jae rsel_cnt_end;
        mov rdi, r12;
        call volume_tail_valid;
        cmp rax, 0;
        je rsel_cnt_next;
        add r13, 1;
        mov r14, r12;
      rsel_cnt_next:
        add r12, 1;
        jmp rsel_cnt_top;

      rsel_cnt_end:
        cmp r13, 1;
        jne rsel_fallback;
        mov rax, r14;                    // single winner
        jmp rsel_selected;

      rsel_fallback:
        // ------------------------------------------------------------
        // (4) FALLBACK: no pdxfs_block volume selected. Caller mounts
        //     tmpfs at slot 0 via the R16 bootstrap path.  R53.M3-005
        //     (#1746) fingerprint hook: emit 'PDXB ROOT FALLBACK'
        //     before stamping the sentinel return.  rax is caller-save
        //     under SysV so klog_s1 may clobber it; we deliberately
        //     emit BEFORE stamping ROOT_SEL_NONE so nothing needs
        //     spilling.  Output-strip-clean per design/policy/output-
        //     provenance-strip.md.
        // ------------------------------------------------------------
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + pdxb_root_fallback_msg];
        call klog_s1;
        mov rax, 0xFFFFFFFFFFFFFFFF;     // ROOT_SEL_NONE (-1)
        jmp rsel_ret;

      rsel_selected:
        // ------------------------------------------------------------
        // R53.M3-005 (#1746) fingerprint hook: every non-fallback exit
        // converges here with rax = row_id (0..15).  Spill through r13
        // (callee-save; dead after the step-3 loop -- live_count is no
        // longer needed once the selection is made) so the row_id
        // survives klog_s1's SysV caller-save clobber.  Output-strip-
        // clean per design/policy/output-provenance-strip.md.
        // ------------------------------------------------------------
        mov r13, rax;                    // spill row_id
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + pdxb_root_selected_msg];
        call klog_s1;
        mov rax, r13;                    // restore row_id

      rsel_ret:
        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
