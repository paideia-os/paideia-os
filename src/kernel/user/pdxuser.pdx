// src/kernel/user/pdxuser.pdx -- R48.M2-001..004 (#1522-#1525)
//
// The `.pdxuser` on-disk user record: format constants, parser +
// writer, supervisor-signature verification seam, and revoked-record
// blacklist.
//
// Per design/user/model.md §9.1 every user in the machine's roster
// is materialised on disk as one supervisor-countersigned
// `.pdxuser` record under `/system/users/<pk_fingerprint>.pdxuser`.
// The supervisor reads them at boot to populate the runtime user map
// (which mints KIND_USER caps via kind_user.pdx); `user list` reads
// them to display the roster; `user remove` marks them revoked
// (kind = 1) rather than deleting them so the fingerprint stays
// blacklisted against future re-submission.
//
// =============================================================================
// SECTION 0  WHY A KERNEL-SIDE PARSER FOR A USERSPACE RECORD
// =============================================================================
//
// The full user model in the design (§10) places the user supervisor
// entirely in ring-3, but the SEAMS the supervisor delegates to --
// signature verification of a record, the revoked-fingerprint
// blacklist consulted before minting a KIND_USER cap -- must be
// callable from the same kernel that owns the KIND_USER row table
// (cap/kind_user.pdx).  Landing the seams here today, with the
// crypto operations gated behind `pdxuser_arbitrated()` returning 0
// on the software-only path, keeps the shape of the future
// supervisor's calling convention fixed even before the paideia-as
// v0.33 ML-DSA-65 verify primitive lands.  When it lands, exactly
// one function in this file flips its return from OK-on-arbitrated-
// zero to a real signature check.
//
// =============================================================================
// SECTION 1  RECORD LAYOUT -- 5432 BYTES FIXED
// =============================================================================
//
//   [+0]     version:u16               = 1 (PDXUSER_VERSION_1)
//   [+2]     kind:u8                   0 = active, 1 = revoked
//   [+3]     mfa_required:u8           bitmask: 0x01 passphrase, 0x02
//                                      hardware, 0x04 biometric
//   [+4]     delegated_by_present:u8   0 = founder (no parent), 1 = parent
//                                      fingerprint valid at [+56..+88]
//   [+5..+8] reserved:[u8;3]           must be zero
//   [+8]     created_ns:u64
//   [+16]    quota_bytes:u64
//   [+24]    pk_fingerprint:[u8;32]    SHA3-256(user_pk)
//   [+56]    delegated_by:[u8;32]      parent fingerprint (all-zero if
//                                      delegated_by_present == 0)
//   [+88]    login_name:[u8;32]        UTF-8, null-padded, lowercase
//   [+120]   display_name:[u8;64]      UTF-8, null-padded
//   [+184]   user_pk:[u8;1952]         ML-DSA-65 public key bytes
//   [+2136]  supervisor_sig:[u8;3293]  ML-DSA-65 signature over the
//                                      preceding 2136 bytes
//
//   PDXUSER_RECORD_LEN = 5429; padded to 5432 for the 8-byte
//   alignment discipline the on-disk record header uses.
//
// The signature is computed over EVERY BYTE FROM +0 TO +2136 (the
// SIGNED region), so a supervisor forging a record post-hoc must
// re-sign it -- the sig cannot be lifted from another record and
// reused.  §3 states this more precisely.
//
// =============================================================================
// SECTION 2  ENDIANNESS + WORD-ALIGNMENT
// =============================================================================
//
// x86_64 little-endian, matches the in-memory layout the kernel uses
// for KIND_USER rows.  Reads and writes go through byte-granular
// offsets because the record is on-disk-first (PdxFS v1 stores it as
// a signed inode); the parser MUST NOT rely on the record being
// word-aligned when it lands in memory, so every multi-byte read
// goes through a byte-shifted sequence rather than a direct u64
// load.  All offsets in §1 pretend the record IS aligned so the code
// reads clean; the actual reads use mov r/m64.
//
// =============================================================================
// SECTION 3  SUPERVISOR SIGNATURE (#1524)
// =============================================================================
//
// `pdxuser_sig_verify(record_ptr)` is the seam.  Its shape is fixed:
// one argument (the record), two failure codes (OK / BAD_SIG) and no
// second-order state.  The body today:
//
//   if pdxuser_arbitrated() == 0:  return PDXUSER_OK   (software-only)
//   else:                          call ml_dsa_65_verify(...)  (unbound)
//
// The `arbitrated()` seam is the same discipline used by
// tarb_arbitrated / tb_nhi_probe_arbitrated / ec_access_arbitrated:
// a witness that returns 0 until the real primitive binds it.  This
// keeps the software-only witness green on any q35 boot while
// refusing to lie -- calling the seam confirms that the SHAPE of a
// signature check was invoked, and the code path a real binding will
// take is the code path the software path exercised.
//
// =============================================================================
// SECTION 4  REVOKED BLACKLIST (#1525)
// =============================================================================
//
// A 32-entry table of fingerprint words (fp_word 0, the user_key
// used elsewhere in this file family) that name records the operator
// has explicitly revoked.  `user remove alice` writes alice's
// pdxuser record kind = 1 and calls `pdxuser_blacklist_add`.  Every
// subsequent `pdxuser_blacklist_check` on that fp_word returns 1 =
// blacklisted, and the KIND_USER mint refuses to mint a fresh row
// for it (§7.1 of the model).
//
// The blacklist is the runtime shadow of the kind = 1 on-disk
// records: on boot the supervisor scans `/system/users/*.pdxuser`
// and calls pdxuser_blacklist_add for every record whose kind == 1.
// Losing the runtime blacklist across a reboot is not a loss of
// enforcement -- the on-disk records are the ground truth.
//
// =============================================================================

module Pdxuser = structure {

  // ==========================================================================
  // §1 record format constants.
  // ==========================================================================

  pub let PDXUSER_VERSION_1        : u64 = 1
  pub let PDXUSER_KIND_ACTIVE      : u64 = 0
  pub let PDXUSER_KIND_REVOKED     : u64 = 1

  pub let PDXUSER_MFA_PASSPHRASE   : u64 = 0x01
  pub let PDXUSER_MFA_HARDWARE     : u64 = 0x02
  pub let PDXUSER_MFA_BIOMETRIC    : u64 = 0x04
  pub let PDXUSER_MFA_ALL          : u64 = 0x07

  pub let PDXUSER_OFF_VERSION      : u64 = 0
  pub let PDXUSER_OFF_KIND         : u64 = 2
  pub let PDXUSER_OFF_MFA          : u64 = 3
  pub let PDXUSER_OFF_DBY_PRESENT  : u64 = 4
  pub let PDXUSER_OFF_CREATED_NS   : u64 = 8
  pub let PDXUSER_OFF_QUOTA_BYTES  : u64 = 16
  pub let PDXUSER_OFF_PK_FP        : u64 = 24
  pub let PDXUSER_OFF_DELEGATED_BY : u64 = 56
  pub let PDXUSER_OFF_LOGIN_NAME   : u64 = 88
  pub let PDXUSER_OFF_DISPLAY_NAME : u64 = 120
  pub let PDXUSER_OFF_USER_PK      : u64 = 184
  pub let PDXUSER_OFF_SUPER_SIG    : u64 = 2136

  pub let PDXUSER_SIGNED_LEN       : u64 = 2136    // bytes signed
  pub let PDXUSER_SIG_LEN          : u64 = 3293    // ML-DSA-65 sig
  pub let PDXUSER_RECORD_LEN       : u64 = 5432    // padded total

  pub let PDXUSER_PK_LEN           : u64 = 1952    // ML-DSA-65 pk
  pub let PDXUSER_FP_LEN           : u64 = 32      // SHA3-256

  // Failure taxonomy 0xFFFFEC10..0xFFFFEC1F.
  pub let PDXUSER_OK               : u64 = 0
  pub let PDXUSER_BAD_VERSION      : u64 = 0xFFFFEC1F
  pub let PDXUSER_BAD_KIND         : u64 = 0xFFFFEC1E
  pub let PDXUSER_BAD_MFA          : u64 = 0xFFFFEC1D
  pub let PDXUSER_BAD_DBY_FLAG     : u64 = 0xFFFFEC1C
  pub let PDXUSER_BAD_RESERVED     : u64 = 0xFFFFEC1B
  pub let PDXUSER_BAD_SIG          : u64 = 0xFFFFEC1A
  pub let PDXUSER_NULL_ARG         : u64 = 0xFFFFEC19
  pub let PDXUSER_BLACKLISTED      : u64 = 0xFFFFEC18
  pub let PDXUSER_BLACKLIST_FULL   : u64 = 0xFFFFEC17

  // ==========================================================================
  // §4 blacklist state cell (32 fp_word entries).
  // ==========================================================================

  pub let PDXUSER_BL_MAX : u64 = 32

  pub let mut _pdxuser_blacklist : [u64; 32] = uninit @align(64)
  pub let mut _pdxuser_stats     : [u64; 8]  = uninit @align(64)

  pub let PDXUSER_ST_PARSED       : u64 = 0
  pub let PDXUSER_ST_REFUSED      : u64 = 1
  pub let PDXUSER_ST_SIG_OK       : u64 = 2
  pub let PDXUSER_ST_SIG_BAD      : u64 = 3
  pub let PDXUSER_ST_BL_HITS      : u64 = 4
  pub let PDXUSER_ST_BL_ADDS      : u64 = 5
  pub let PDXUSER_ST_MAX          : u64 = 8

  // ==========================================================================
  // pdxuser_reset() -- boot / teardown scrub.
  // ==========================================================================

  pub let pdxuser_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48.M2-004 (#1525): zero blacklist and counters. Two separate loops so the arrays' adjacency in .bss is not encoded as a fact the code depends on. Labels prefixed pdxu_rs_.",
      block: {
        lea r10, [rip + _pdxuser_blacklist];
        xor rax, rax;
        xor rcx, rcx;
      pdxu_rs_bl:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  pdxu_rs_bl;

        lea r10, [rip + _pdxuser_stats];
        xor rcx, rcx;
      pdxu_rs_st:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  pdxu_rs_st;
        ret
      }
    }

  pub let pdxuser_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48.M2-001: bounded increment. Labels prefixed pdxu_nt_.",
      block: {
        cmp rdi, 8;
        jae pdxu_nt_out;
        lea r10, [rip + _pdxuser_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      pdxu_nt_out:
        ret
      }
    }

  pub let pdxuser_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48.M2-001: bounded counter read. Labels prefixed pdxu_st_.",
      block: {
        cmp rdi, 8;
        jae pdxu_st_z;
        lea r10, [rip + _pdxuser_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      pdxu_st_z:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // pdxuser_arbitrated() -- §3 seam.
  //
  // Returns 0 while no live ML-DSA-65 verify primitive is bound. When
  // paideia-as v0.33 crypto-kdf lands and the verify function is
  // wired here, this seam flips to 1 and pdxuser_sig_verify's OK-on-
  // arbitrated-zero shortcut disappears.
  // ==========================================================================

  pub let pdxuser_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R48.M2-003 (#1524): honesty pin. Returns 0 until paideia-as v0.33 ML-DSA-65 verify binds real crypto against real records. Same shape as tarb_arbitrated / ec_access_arbitrated. Labels prefixed pdxu_ar_.",
      block: {
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // pdxuser_read_u16(buf, off) -> u16 (zero-extended)
  // pdxuser_read_u64(buf, off) -> u64
  // ==========================================================================

  pub let pdxuser_read_u16 : (u64, u64) -> u64 !{mem} @{} =
    fn (buf: u64) (off: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48.M2-002 (#1523): little-endian u16 read from an untrusted byte buffer. Two byte loads + shift because the record is on-disk-first and its base pointer is not guaranteed word-aligned by the filesystem; a plain 16-bit MMIO load across a misaligned boundary is legal on x86 but obscures the byte discipline the caller has to reason about (§2). Uses paideia-as's mov_b primitive (see acpi/fadt.pdx) with a pre-zero of rax to guarantee upper bits clear -- mov_b writes only 8 bits. Labels prefixed pdxu_r16_.",
      block: {
        add rdi, rsi;
        xor rax, rax;
        mov_b rax, [rdi + 0];
        xor r10, r10;
        mov_b r10, [rdi + 1];
        shl r10, 8;
        or  rax, r10;
        ret
      }
    }

  pub let pdxuser_read_u8 : (u64, u64) -> u64 !{mem} @{} =
    fn (buf: u64) (off: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48.M2-002 (#1523): unsigned byte read. Pre-zero rax before mov_b so upper bits are guaranteed zero (mov_b writes 8 bits only). Labels prefixed pdxu_r8_.",
      block: {
        add rdi, rsi;
        xor rax, rax;
        mov_b rax, [rdi + 0];
        ret
      }
    }

  pub let pdxuser_read_u64 : (u64, u64) -> u64 !{mem} @{} =
    fn (buf: u64) (off: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48.M2-002 (#1523): little-endian u64 read. Uses mov r64, [r/m64] and relies on x86 tolerating unaligned reads within a cache line; the record layout in §1 places every u64 at an 8-byte-aligned offset from the record base, so a caller supplying an 8-byte-aligned base ptr never touches an unaligned load. Labels prefixed pdxu_r64_.",
      block: {
        add rdi, rsi;
        mov rax, [rdi + 0];
        ret
      }
    }

  // ==========================================================================
  // pdxuser_validate(record_ptr) -> PDXUSER_OK | error
  //
  // Structural validation only.  Checks version, kind, mfa, reserved
  // bytes, delegated_by flag consistency.  Does NOT touch the sig --
  // that is pdxuser_sig_verify's job (kept separate so a caller
  // parsing a witnessed-good record repeatedly does not re-invoke
  // the expensive crypto path).
  // ==========================================================================

  pub let pdxuser_validate : (u64) -> u64 !{mem} @{} =
    fn (record_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48.M2-002 (#1523): structural validation of a .pdxuser record. Null ptr -> NULL_ARG. version != 1 -> BAD_VERSION. kind not in {0,1} -> BAD_KIND. mfa outside PDXUSER_MFA_ALL bits -> BAD_MFA. delegated_by_present not in {0,1} -> BAD_DBY_FLAG. Reserved bytes [5..8] non-zero -> BAD_RESERVED. Every refusal bumps PDXUSER_ST_REFUSED; success bumps PDXUSER_ST_PARSED. THREE callee-save pushes leave rsp%16 == 0 at every nested call. Labels prefixed pdxu_v_.",
      block: {
        push rbx;
        push r12;
        push r13;

        cmp rdi, 0;
        je  pdxu_v_null;
        mov rbx, rdi;

        // version.
        mov rdi, rbx;
        mov rsi, 0;                      // PDXUSER_OFF_VERSION
        call pdxuser_read_u16;
        cmp rax, 1;                      // PDXUSER_VERSION_1
        jne pdxu_v_bad_ver;

        // kind in {0,1}.
        mov rdi, rbx;
        mov rsi, 2;                      // PDXUSER_OFF_KIND
        call pdxuser_read_u8;
        cmp rax, 1;
        ja  pdxu_v_bad_kind;

        // mfa subset of 0x07.
        mov rdi, rbx;
        mov rsi, 3;                      // PDXUSER_OFF_MFA
        call pdxuser_read_u8;
        mov r10, rax;
        and r10, 0x07;
        cmp r10, rax;
        jne pdxu_v_bad_mfa;

        // delegated_by_present in {0,1}.
        mov rdi, rbx;
        mov rsi, 4;                      // PDXUSER_OFF_DBY_PRESENT
        call pdxuser_read_u8;
        cmp rax, 1;
        ja  pdxu_v_bad_dby;

        // Reserved bytes at [5..8] must be zero.
        mov rdi, rbx;
        mov rsi, 5;
        call pdxuser_read_u8;
        cmp rax, 0;
        jne pdxu_v_bad_res;
        mov rdi, rbx;
        mov rsi, 6;
        call pdxuser_read_u8;
        cmp rax, 0;
        jne pdxu_v_bad_res;
        mov rdi, rbx;
        mov rsi, 7;
        call pdxuser_read_u8;
        cmp rax, 0;
        jne pdxu_v_bad_res;

        // Success.
        mov rdi, 0;                      // PDXUSER_ST_PARSED
        call pdxuser_note;
        xor rax, rax;
        jmp pdxu_v_out;

      pdxu_v_null:
        mov rax, 0xFFFFEC19;             // PDXUSER_NULL_ARG
        jmp pdxu_v_refused;
      pdxu_v_bad_ver:
        mov rax, 0xFFFFEC1F;
        jmp pdxu_v_refused;
      pdxu_v_bad_kind:
        mov rax, 0xFFFFEC1E;
        jmp pdxu_v_refused;
      pdxu_v_bad_mfa:
        mov rax, 0xFFFFEC1D;
        jmp pdxu_v_refused;
      pdxu_v_bad_dby:
        mov rax, 0xFFFFEC1C;
        jmp pdxu_v_refused;
      pdxu_v_bad_res:
        mov rax, 0xFFFFEC1B;

      pdxu_v_refused:
        push rax;
        mov rdi, 1;                      // PDXUSER_ST_REFUSED
        call pdxuser_note;
        pop rax;

      pdxu_v_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // pdxuser_fp_word0(record_ptr) -> u64 | PDXUSER_NULL_ARG
  //
  // Extract fp_word 0 -- the user_key kind_user.pdx uses.
  // ==========================================================================

  pub let pdxuser_fp_word0 : (u64) -> u64 !{mem} @{} =
    fn (record_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48.M2-002 (#1523): read pk_fingerprint word 0 from a validated record. Callers MUST have paired this with a preceding pdxuser_validate that returned OK -- the read here is unconditional. Null ptr returns PDXUSER_NULL_ARG. Labels prefixed pdxu_fp0_.",
      block: {
        cmp rdi, 0;
        je  pdxu_fp0_null;
        mov rsi, 24;                     // PDXUSER_OFF_PK_FP
        call pdxuser_read_u64;
        ret;
      pdxu_fp0_null:
        mov rax, 0xFFFFEC19;
        ret
      }
    }

  pub let pdxuser_quota : (u64) -> u64 !{mem} @{} =
    fn (record_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48.M2-002 (#1523): read quota_bytes from a validated record. Labels prefixed pdxu_q_.",
      block: {
        cmp rdi, 0;
        je  pdxu_q_null;
        mov rsi, 16;                     // PDXUSER_OFF_QUOTA_BYTES
        call pdxuser_read_u64;
        ret;
      pdxu_q_null:
        mov rax, 0xFFFFEC19;
        ret
      }
    }

  pub let pdxuser_created_ns : (u64) -> u64 !{mem} @{} =
    fn (record_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48.M2-002 (#1523): read created_ns from a validated record. Labels prefixed pdxu_c_.",
      block: {
        cmp rdi, 0;
        je  pdxu_c_null;
        mov rsi, 8;                      // PDXUSER_OFF_CREATED_NS
        call pdxuser_read_u64;
        ret;
      pdxu_c_null:
        mov rax, 0xFFFFEC19;
        ret
      }
    }

  pub let pdxuser_kind : (u64) -> u64 !{mem} @{} =
    fn (record_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48.M2-002 (#1523): read the kind byte (0=active, 1=revoked). Labels prefixed pdxu_k_.",
      block: {
        cmp rdi, 0;
        je  pdxu_k_null;
        mov rsi, 2;
        call pdxuser_read_u8;
        ret;
      pdxu_k_null:
        mov rax, 0xFFFFEC19;
        ret
      }
    }

  // ==========================================================================
  // pdxuser_sig_verify(record_ptr) -> PDXUSER_OK | PDXUSER_BAD_SIG
  //                                 | PDXUSER_NULL_ARG
  //
  // The §3 seam. On the software-only path pdxuser_arbitrated returns
  // 0, so this succeeds without touching bytes past the signed
  // region -- the shape of a verify is what the caller has invoked.
  // When paideia-as v0.33 binds ML-DSA-65 verify, this function calls
  // it against the record's SIGNED region (bytes 0..2136) with the
  // sig at [+2136..+2136+3293] and the user_pk at [+184..+184+1952].
  // ==========================================================================

  pub let pdxuser_sig_verify : (u64) -> u64 !{mem} @{} =
    fn (record_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48.M2-003 (#1524): supervisor-signature verification seam. Structure: (1) null-guard; (2) arbitrated? no => OK-and-count-SIG_OK; (3) yes => call the bound verifier (unbound today, so the arbitrated branch is unreachable and the SIG_BAD counter tracks the eventual real-verify failure path). Not landing the real verify here today is documented: the paideia-as v0.33 crypto bundle carries the primitive and this seam calls it via a stable name (`ml_dsa_65_verify_record`) once the primitive lands. THIS FUNCTION MUST NOT DECIDE WHICH FIELDS ARE SIGNED: the signed region is a byte range (0..PDXUSER_SIGNED_LEN) chosen at design time (§1), and the verifier reads it as bytes -- not as parsed fields -- so a future addition of a new field inside the signed region does not require re-issuing signatures on existing records. Labels prefixed pdxu_sv_.",
      block: {
        push r12;
        cmp rdi, 0;
        je  pdxu_sv_null;
        mov r12, rdi;
        call pdxuser_arbitrated;
        cmp rax, 0;
        jne pdxu_sv_real;

        // Software-only witness path.
        mov rdi, 2;                      // PDXUSER_ST_SIG_OK
        call pdxuser_note;
        xor rax, rax;
        jmp pdxu_sv_out;

      pdxu_sv_real:
        // Real path -- unreachable today. When bound: rdi = record,
        // rsi = signed_len, rdx = &sig, rcx = &user_pk; return 0 =
        // OK or non-zero = fail.  For now, mirror the failure path
        // so future breakage of the binding is visible.
        mov rdi, 3;                      // PDXUSER_ST_SIG_BAD
        call pdxuser_note;
        mov rax, 0xFFFFEC1A;             // PDXUSER_BAD_SIG
        jmp pdxu_sv_out;

      pdxu_sv_null:
        mov rax, 0xFFFFEC19;             // PDXUSER_NULL_ARG

      pdxu_sv_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // pdxuser_write_header_bytes(record_ptr, kind, mfa, dby_present) -> ()
  // pdxuser_write_header_words(record_ptr, created_ns, quota_bytes) -> ()
  //
  // Two calls rather than one seven-arg call: 7 registers exceeds the
  // SysV ceiling. Version is written unconditionally as 1 inside
  // _bytes because §1 declares PDXUSER_VERSION_1 = 1 and no caller
  // has any business claiming otherwise.  Everything after the first
  // 24 bytes is written by pdxuser_write_bytes (blob writer --
  // fingerprint, delegated_by, login/display names, user_pk,
  // supervisor_sig).
  // ==========================================================================

  pub let pdxuser_write_header_bytes : (u64, u64, u64, u64) -> () !{mem} @{} =
    fn (record_ptr: u64) (kind: u64) (mfa: u64) (dby_present: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48.M2-002 (#1523): write the byte-granular fields of a .pdxuser record header: version = 1 (u16 at +0), kind at +2, mfa at +3, dby_present at +4, reserved bytes at +5..+7 = 0. Version is hard-coded to 1 rather than parameterised so a caller cannot silently claim a different format on write and expect this writer's field layout to travel with it. No pushes: the register plan uses rdi/rsi/rdx/rcx and clobbers rax only. Labels prefixed pdxu_whb_.",
      block: {
        // version = 1 -> [+0..2].
        mov rax, 1;
        mov [rdi + 0], al;
        xor rax, rax;
        mov [rdi + 1], al;

        // kind -> [+2].
        mov rax, rsi;
        mov [rdi + 2], al;

        // mfa -> [+3].
        mov rax, rdx;
        mov [rdi + 3], al;

        // dby_present -> [+4].
        mov rax, rcx;
        mov [rdi + 4], al;

        // Reserved [+5..+8] = 0.
        xor rax, rax;
        mov [rdi + 5], al;
        mov [rdi + 6], al;
        mov [rdi + 7], al;
        ret
      }
    }

  pub let pdxuser_write_header_words : (u64, u64, u64) -> () !{mem} @{} =
    fn (record_ptr: u64) (created_ns: u64) (quota_bytes: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48.M2-002 (#1523): write created_ns at +8 and quota_bytes at +16. Both are u64 stores; the record base's alignment discipline (§2) delivers both at word-aligned offsets when the caller supplies a word-aligned base. Labels prefixed pdxu_whw_.",
      block: {
        mov [rdi + 8],  rsi;
        mov [rdi + 16], rdx;
        ret
      }
    }

  // ==========================================================================
  // pdxuser_write_bytes(record_ptr, offset, src_ptr, len) -> ()
  //
  // Byte-granular blob copy into a record.  Used for pk_fingerprint,
  // delegated_by, login_name, display_name, user_pk, supervisor_sig.
  // Bounds-checks offset + len <= PDXUSER_RECORD_LEN.
  // ==========================================================================

  pub let pdxuser_write_bytes : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (record_ptr: u64) (offset: u64) (src_ptr: u64) (len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48.M2-002 (#1523): copy `len` bytes from src_ptr into record_ptr+offset. THE ONE writer path for every fixed blob past the 24-byte header; concentrating writes here is what makes the record-size discipline reachable to a single bound check. offset + len > PDXUSER_RECORD_LEN (5432) -> PDXUSER_NULL_ARG (the same failure bucket as a null ptr because in both cases the caller has handed us storage that cannot receive the write). Null src or record -> same. Loop is byte-at-a-time; the caller pays microseconds for a supervisor's occasional record write, not the cycles this loop takes for a 3293-byte signature. Labels prefixed pdxu_wb_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov rbx, rdi;                    // record_ptr
        mov r12, rsi;                    // offset
        mov r13, rdx;                    // src_ptr
        mov r14, rcx;                    // len

        cmp rbx, 0;
        je  pdxu_wb_bad;
        cmp r13, 0;
        je  pdxu_wb_bad;

        // Bounds: offset + len <= 5432. Stage 5432 in r11.
        mov r11, 5432;                   // PDXUSER_RECORD_LEN
        mov rax, r12;
        add rax, r14;
        cmp rax, r11;
        ja  pdxu_wb_bad;

        add rbx, r12;                    // dst = record_ptr + offset
        xor rcx, rcx;
      pdxu_wb_loop:
        cmp rcx, r14;
        jae pdxu_wb_done;
        xor rax, rax;
        mov_b rax, [r13 + rcx*1];
        mov_b [rbx + rcx*1], rax;
        add rcx, 1;
        jmp pdxu_wb_loop;

      pdxu_wb_done:
        xor rax, rax;                    // PDXUSER_OK
        jmp pdxu_wb_out;
      pdxu_wb_bad:
        mov rax, 0xFFFFEC19;             // PDXUSER_NULL_ARG

      pdxu_wb_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // §4 blacklist.
  //
  // pdxuser_blacklist_add(fp_word)     -> OK | BLACKLIST_FULL
  // pdxuser_blacklist_check(fp_word)   -> 1 iff blacklisted
  // ==========================================================================

  pub let pdxuser_blacklist_add : (u64) -> u64 !{mem} @{} =
    fn (fp_word: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48.M2-004 (#1525): record fp_word as blacklisted. Refuses fp_word == 0 with BLACKLIST_FULL to disambiguate 'never added' from 'occupies slot 0'. If the fp_word is already present the call is idempotent-OK (a supervisor reboot rescans /system/users/*.pdxuser and re-adds every revoked record, so duplicate-add is the common case). If every slot is full and the fp_word is new -> BLACKLIST_FULL. Two pushes + sub rsp, 8 = 24 bytes: post-prologue rsp % 16 == 0 for the nested pdxuser_note call. Labels prefixed pdxu_bla_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        mov r12, rdi;
        cmp r12, 0;
        je  pdxu_bla_full;

        // Scan for existing hit.
        xor rbx, rbx;
      pdxu_bla_scan:
        cmp rbx, 32;
        jae pdxu_bla_no_hit;
        lea r10, [rip + _pdxuser_blacklist];
        mov rax, [r10 + rbx * 8];
        cmp rax, r12;
        je  pdxu_bla_ok;
        add rbx, 1;
        jmp pdxu_bla_scan;

      pdxu_bla_no_hit:
        // Insert into first empty slot.
        xor rbx, rbx;
      pdxu_bla_ins:
        cmp rbx, 32;
        jae pdxu_bla_full;
        lea r10, [rip + _pdxuser_blacklist];
        mov rax, [r10 + rbx * 8];
        cmp rax, 0;
        je  pdxu_bla_write;
        add rbx, 1;
        jmp pdxu_bla_ins;

      pdxu_bla_write:
        mov [r10 + rbx * 8], r12;
        mov rdi, 5;                      // PDXUSER_ST_BL_ADDS
        call pdxuser_note;

      pdxu_bla_ok:
        xor rax, rax;
        jmp pdxu_bla_out;

      pdxu_bla_full:
        mov rax, 0xFFFFEC17;             // PDXUSER_BLACKLIST_FULL

      pdxu_bla_out:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let pdxuser_blacklist_check : (u64) -> u64 !{mem} @{} =
    fn (fp_word: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48.M2-004 (#1525): 1 iff fp_word is on the revoked list. Zero is refused (0 is the founder sentinel for delegated_by_key; putting founder on the blacklist would make the machine unbootable, which is a graver failure than a leaked revocation). Bumps PDXUSER_ST_BL_HITS on a hit for diagnosis. Labels prefixed pdxu_blc_.",
      block: {
        push r12;
        mov r12, rdi;
        cmp r12, 0;
        je  pdxu_blc_no;

        xor rcx, rcx;
      pdxu_blc_scan:
        cmp rcx, 32;
        jae pdxu_blc_no;
        lea r10, [rip + _pdxuser_blacklist];
        mov rax, [r10 + rcx * 8];
        cmp rax, r12;
        je  pdxu_blc_hit;
        add rcx, 1;
        jmp pdxu_blc_scan;

      pdxu_blc_hit:
        mov rdi, 4;                      // PDXUSER_ST_BL_HITS
        call pdxuser_note;
        mov rax, 1;
        jmp pdxu_blc_out;
      pdxu_blc_no:
        xor rax, rax;

      pdxu_blc_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // pdxuser_admit(record_ptr) -> PDXUSER_OK | error
  //
  // The COMPOSITE gate every supervisor call site uses before minting
  // a KIND_USER row from a record: validate structure, verify sig,
  // check blacklist. If any refuses the mint MUST NOT proceed.
  //
  // The blacklist check runs even when the record's kind == active,
  // because a supervisor scanning `/system/users` picks up records
  // whose kind byte was flipped to revoked by a previous `user
  // remove` and did NOT re-issue the sig -- pdxuser_admit rejects a
  // record whose fp_word is blacklisted regardless of its kind byte,
  // which is what makes `user remove` a one-way operation the
  // operator cannot undo by hand-editing the record's kind field.
  // ==========================================================================

  pub let pdxuser_admit : (u64) -> u64 !{mem} @{} =
    fn (record_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R48.M2-004 (#1525): the composite admission gate every KIND_USER mint from a .pdxuser record MUST pass through. Order: validate -> sig_verify -> blacklist. Blacklist last so a corrupt record fails on the cheaper structural checks first; blacklist BEFORE the mint so the on-disk revoke propagates before authority is minted. If kind == revoked the record itself is unusable -> BAD_KIND (bad_kind is repurposed here because a caller admitting a record it means to activate must not be handed a revoked one). Two pushes + sub rsp, 8 = 24 bytes so nested calls land at rsp % 16 == 0. Labels prefixed pdxu_adm_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        mov rbx, rdi;
        mov rdi, rbx;
        call pdxuser_validate;
        cmp rax, 0;
        jne pdxu_adm_out;

        // Kind must be active.
        mov rdi, rbx;
        call pdxuser_kind;
        cmp rax, 0;                      // PDXUSER_KIND_ACTIVE
        jne pdxu_adm_revoked;

        mov rdi, rbx;
        call pdxuser_sig_verify;
        cmp rax, 0;
        jne pdxu_adm_out;

        mov rdi, rbx;
        call pdxuser_fp_word0;
        mov r12, rax;
        mov rdi, r12;
        call pdxuser_blacklist_check;
        cmp rax, 1;
        je  pdxu_adm_bl;

        xor rax, rax;
        jmp pdxu_adm_out;

      pdxu_adm_revoked:
        mov rax, 0xFFFFEC1E;             // PDXUSER_BAD_KIND
        jmp pdxu_adm_out;
      pdxu_adm_bl:
        mov rax, 0xFFFFEC18;             // PDXUSER_BLACKLISTED

      pdxu_adm_out:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }
}
