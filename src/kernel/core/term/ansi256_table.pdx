// src/kernel/core/term/ansi256_table.pdx -- Wave UMB-W17 R129.M3
//
// ANSI-256 tabular fallback renderer (paideia-os#2606).
//
// Lands:  2026-10-13
//
// Overview
// ========
//
// The paideia-os terminal substrate is text first.  R129.M2 (Wave
// UMB-W16, paideia-os#2605) landed the Kitty graphics APC emitter
// for the three terminals that answer the RGB cap: iTerm2, Kitty,
// WezTerm.  M3 answers the other half of the universe -- xterm,
// gnome-terminal, foot, konsole, Windows Terminal, early-boot EFI
// consoles -- which cannot paint bitmaps but DO support ANSI-256
// colour (xterm-style `\e[38;5;Nm` / `\e[48;5;Nm`) and UTF-8 box-
// drawing (U+2500 .. U+257F).  The common case this helper is built
// for is a `jobs` listing or any tabular stream the shell wants to
// render legibly without a bitmap round-trip:
//
//      ┌─────┬──────────────┬──────────┐
//      │ PID │ COMMAND      │  STATE   │
//      ├─────┼──────────────┼──────────┤
//      │ 142 │ ls -la       │ RUNNING  │
//      │ 143 │ grep foo     │ WAITING  │
//      │ 144 │ cat big.log  │ RUNNING  │
//      └─────┴──────────────┴──────────┘
//
// R129.M1 (xtgettcap.pdx, Wave UMB-W15) landed the capability probe.
// The caller is expected to probe once per session (e.g. the `Co`
// termcap -> number of colours, 8 / 16 / 256 / 24-bit) and to pass
// AT_FLAG_ASCII / AT_FLAG_NO_COLOR to this renderer as appropriate.
// M3 does NOT re-probe; it reads only the flags passed in.  See
// design/shell/ansi256-tabular-fallback.md section 4 for the
// probe-and-dispatch recipe.
//
// Scope
// -----
//   * fixed-width columns (caller supplies width per column)
//   * three alignments: left (0), right (1), centre (2)
//   * header row wrapped in AT_DEFAULT_HEADER_BG + HEADER_FG SGR
//   * data rows: optional alternating AT_DEFAULT_ALT_BG under
//     AT_FLAG_ALT_ROWS (chosen by row-index parity)
//   * UTF-8 heavy-box-drawing default (U+2500 family); ASCII fallback
//     ('+', '-', '|') under AT_FLAG_ASCII
//   * cap: 32 columns x 128 rows per render
//   * every byte funnels through uart_putc (parity with M1 and M2)
//
// Explicit non-scope at M3
// ------------------------
//   * no per-column fg/bg SGR emission.  The descriptor reserves
//     fg_color and bg_color bytes for an M4 wave; M3 ignores them
//     and uses the row-level defaults only.
//   * no proportional / auto-fit widths.  Caller sizes columns.
//   * no truncation glyph.  Over-long cells are hard-cut at the
//     column width; M4 can add an ellipsis.
//   * no multi-line cells.  Each cell is exactly one glyph row.
//   * no 24-bit RGB variant.  The 24-bit path lives next to the
//     Kitty graphics emitter and belongs to a future R129.M4+.
//   * no streaming / incremental build-up.  The entire table is
//     emitted inside one call; the caller marshals rows first.
//   * no raw-mode flip.  Like the Kitty emitter, the TX-only path
//     is cooked-mode safe; the TTY line discipline inspects RX
//     only, not TX.
//
// See design/shell/ansi256-tabular-fallback.md for the full contract.
//
// Encoder-pitfall notes
// ---------------------
//   * no `test rN, rN` -- always `cmp rN, 0; j{e,ne}`
//   * no 2-op `imul rN, imm` -- reg-reg `imul rN, rN` only
//   * no `and rN, imm64` -- every mask fits in imm8 or imm32
//   * labels prefixed `atb_` / `atc_` / `atd_` / `ate_` / `atf_` /
//     `atG_` / `atH_` / `ati_` / `atp_` / `atR_` to avoid collisions
//     with sibling-module labels (`xt_` / `kg_` family) and to avoid
//     pdx reserved keywords (`loop`, `if`, `let`, `fn`, `else`, ...)
//   * module basename `Ansi256Table` matches `ansi256_table.pdx`
//   * single-line `pub let X : T = ...`
//   * every RIP-relative load is `lea rN, [rip + sym]` followed by a
//     byte-wise `mov_b` / wide `mov` through rN
//   * cross-module symbol (uart_putc) accessed as direct RIP-relative
//     call; linker resolves

module Ansi256Table = structure {
  // =========================================================================
  // Section 1 -- public constants
  // =========================================================================

  // Return-status codes.  M3 bands them in 0x18xx; the band is otherwise
  // unused and leaves room for AT_ERR_BAD_FD, AT_ERR_IO, etc. at
  // R129.M4+.
  pub let AT_OK                 : u64 = 0
  pub let AT_ERR_TOO_MANY_COLS  : u64 = 0x1800
  pub let AT_ERR_TOO_MANY_ROWS  : u64 = 0x1801
  pub let AT_ERR_BAD_DESC       : u64 = 0x1802

  // Dimension caps.  See design-doc section 7 for the rationale: 32
  // columns is wider than any realistic tabular shell listing and
  // keeps the descriptor table at 512 bytes; 128 rows is one full
  // screen on a tall pager and matches SJ_MAX_JOBS x historical
  // snapshot count on the shell-session job table.
  pub let AT_MAX_COLS           : u64 = 32
  pub let AT_MAX_ROWS           : u64 = 128

  // Flag bits for the sixth argument to _ansi256_table_render.
  //
  //   AT_FLAG_ASCII       emit '+', '-', '|' instead of UTF-8 box-
  //                        drawing glyphs (for VT100-tier terminals
  //                        that do not render UTF-8)
  //   AT_FLAG_NO_COLOR    suppress all \e[...m escapes (plain-ASCII
  //                        output for serial-log capture, old EFI
  //                        consoles, pipe to grep)
  //   AT_FLAG_ALT_ROWS    alternate the background on data rows for
  //                        legibility (uses AT_DEFAULT_ALT_BG on
  //                        odd-indexed rows)
  //   AT_FLAG_NO_HEADER_BG  skip the header's background highlight
  //                        (header still gets its own fg colour)
  pub let AT_FLAG_ASCII         : u64 = 0x01
  pub let AT_FLAG_NO_COLOR      : u64 = 0x02
  pub let AT_FLAG_ALT_ROWS      : u64 = 0x04
  pub let AT_FLAG_NO_HEADER_BG  : u64 = 0x08

  // Alignment selectors stored in the column descriptor's `align_flags`
  // field.  LEFT is the default (any value >= 3 falls through to LEFT).
  pub let AT_ALIGN_LEFT         : u64 = 0
  pub let AT_ALIGN_RIGHT        : u64 = 1
  pub let AT_ALIGN_CENTER       : u64 = 2

  // Box-drawing table indices.  Each index selects one glyph; the
  // glyph is rendered as either 3 UTF-8 bytes (default) or 1 ASCII
  // byte (under AT_FLAG_ASCII).  The 11 glyphs cover the full
  // rectangle vocabulary needed for a bordered table.
  pub let AT_BX_HORIZ   : u64 = 0            // U+2500 ─   or  '-'
  pub let AT_BX_VERT    : u64 = 1            // U+2502 │   or  '|'
  pub let AT_BX_TL      : u64 = 2            // U+250C ┌   or  '+'
  pub let AT_BX_TR      : u64 = 3            // U+2510 ┐   or  '+'
  pub let AT_BX_BL      : u64 = 4            // U+2514 └   or  '+'
  pub let AT_BX_BR      : u64 = 5            // U+2518 ┘   or  '+'
  pub let AT_BX_T_DOWN  : u64 = 6            // U+252C ┬   or  '+'
  pub let AT_BX_T_UP    : u64 = 7            // U+2534 ┴   or  '+'
  pub let AT_BX_T_LEFT  : u64 = 8            // U+2524 ┤   or  '+'
  pub let AT_BX_T_RIGHT : u64 = 9            // U+251C ├   or  '+'
  pub let AT_BX_CROSS   : u64 = 10           // U+253C ┼   or  '+'

  // Default colour selections (ANSI-256).
  //
  //   15    bright white      -- header foreground (readable on 24)
  //   24    deep blue         -- header background
  //   236   dark grey         -- alt-row subtle background
  pub let AT_DEFAULT_HEADER_FG : u64 = 15
  pub let AT_DEFAULT_HEADER_BG : u64 = 24
  pub let AT_DEFAULT_ALT_BG    : u64 = 236

  // =========================================================================
  // Section 2 -- immutable box-drawing tables
  // =========================================================================

  // UTF-8 encoding of each box-drawing glyph.  Flat 11 x 3 = 33-byte
  // table, indexed as `_at_box_utf8[idx*3 + k]` where k is the byte
  // position within the glyph (0..2) and idx is one of the AT_BX_*
  // constants above.
  pub let _at_box_utf8 : [u8; 33] = [
    0xE2u8, 0x94u8, 0x80u8,
    0xE2u8, 0x94u8, 0x82u8,
    0xE2u8, 0x94u8, 0x8Cu8,
    0xE2u8, 0x94u8, 0x90u8,
    0xE2u8, 0x94u8, 0x94u8,
    0xE2u8, 0x94u8, 0x98u8,
    0xE2u8, 0x94u8, 0xACu8,
    0xE2u8, 0x94u8, 0xB4u8,
    0xE2u8, 0x94u8, 0xA4u8,
    0xE2u8, 0x94u8, 0x9Cu8,
    0xE2u8, 0x94u8, 0xBCu8
  ]

  // ASCII fallback: all corners / intersections collapse to '+',
  // horizontal to '-', vertical to '|'.  Indexed as
  // `_at_box_ascii[idx]`.
  pub let _at_box_ascii : [u8; 11] = [
    0x2Du8, 0x7Cu8, 0x2Bu8, 0x2Bu8, 0x2Bu8, 0x2Bu8,
    0x2Bu8, 0x2Bu8, 0x2Bu8, 0x2Bu8, 0x2Bu8
  ]

  // =========================================================================
  // Section 3 -- static scratch
  // =========================================================================

  // Decimal-digit reversal scratch for _at_tx_u64_dec.  32 bytes is
  // sufficient for any u64 (max 20 decimal digits).  Mirrors the
  // layout in kitty_graphics.pdx::_kg_dec_scratch so the two modules
  // keep the same itoa shape; isolated per module so sibling helpers
  // never contend on the slot.
  pub let mut _at_dec_scratch : [u8; 32] = uninit @align(8)

  // =========================================================================
  // Section 4 -- _at_tx_byte(byte) -> ()
  // =========================================================================
  //
  // Single-byte TX shim over uart_putc.  Same shape as
  // kitty_graphics.pdx::_kg_tx_byte and xtgettcap.pdx::_xt_tx_byte --
  // isolated per module so a future wave can route by tty_fd without
  // touching the renderer body.
  //
  // SysV: rdi = byte on entry, passes straight through to uart_putc.
  pub let _at_tx_byte : (u64) -> () !{sysreg, PortIo} @{paideia.port_io} =
    fn (byte: u64) -> unsafe {
      effects: {sysreg, PortIo},
      capabilities: {paideia.port_io},
      justification: "R129.M3 (paideia-os#2606, Wave UMB-W17): single-byte TX shim over uart_putc. SysV: rdi carries the byte through; no re-marshalling. `sub rsp,8; call uart_putc; add rsp,8` keeps rsp%16==0 at the nested call site (entry rsp%16==8 + 8-byte pad -> rsp%16==0). No prologue needed; uart_putc preserves rbx and r12-r15. Mirrors term/kitty_graphics.pdx::_kg_tx_byte and term/xtgettcap.pdx::_xt_tx_byte exactly so the three terminal modules share the same byte-emit shape.",
      block: {
        sub rsp, 8;
        call uart_putc;
        add rsp, 8;
        ret
      }
    }

  // =========================================================================
  // Section 5 -- _at_tx_u64_dec(val) -> ()
  // =========================================================================
  //
  // Emits `val` as its unsigned decimal representation via _at_tx_byte.
  // Zero prints as "0", not empty.  Used by the ANSI-256 escape emitter
  // to render the colour code (0..255).
  //
  // Mechanism: collect digits LSB-first into _at_dec_scratch via
  // repeated `div rcx` with rcx=10, then walk the scratch in reverse
  // to emit MSB-first.  Identical shape to kitty_graphics.pdx::
  // _kg_tx_u64_dec; isolated per module.
  //
  // Registers:
  //   rbx = val (callee-save; div clobbers rax/rdx)
  //   r12 = digit count (callee-save; survives _at_tx_byte call)
  //
  // Preserves (SysV callee-save): rbx, rbp, r12-r15.
  // Clobbers (SysV caller-save):  rax, rcx, rdx, rsi, rdi, r8-r11.
  pub let _at_tx_u64_dec : (u64) -> () !{sysreg, PortIo} @{paideia.port_io} =
    fn (val: u64) -> unsafe {
      effects: {sysreg, PortIo},
      capabilities: {paideia.port_io},
      justification: "R129.M3: unsigned-decimal itoa + per-digit emit. 2-push callee-save prologue (rbx=val, r12=digit-count) -- entry rsp%16==8, +16 pushes -> rsp%16==8 steady state. Before each nested _at_tx_byte call, `sub rsp,8` lands rsp%16==0; `add rsp,8` after restores. r12 is callee-save in SysV so _at_tx_byte (and uart_putc inside it) preserves it across the call -- no spill needed. Collect-phase: `xor rdx,rdx; mov rax,rbx; mov rcx,10; div rcx` -> remainder in rdx is the next LSB digit; add 0x30 for ASCII; store at _at_dec_scratch[r12]; bump r12; replace rbx with quotient; loop while rbx>0 (runs at least once so val=0 produces one '0' digit). Emit-phase walks r12 downward, loading each byte via mov_b and routing through _at_tx_byte. Encoder: mov / xor / div / add / mov_b / lea / cmp / je / jne / sub / jmp / push / pop / call -- all pre-existing. Reserved-label discipline: atd_ prefix.",
      block: {
        push rbx;
        push r12;

        mov rbx, rdi;                      // rbx = val
        xor r12, r12;                      // r12 = digit count

      atd_collect:
        xor rdx, rdx;
        mov rax, rbx;
        mov rcx, 10;
        div rcx;                           // rax = quot, rdx = rem
        add rdx, 0x30;                     // rem -> ASCII digit
        lea r10, [rip + _at_dec_scratch];
        add r10, r12;
        mov_b [r10 + 0], rdx;
        add r12, 1;
        mov rbx, rax;                      // val = quot
        cmp rbx, 0;
        jne atd_collect;

      atd_emit:
        cmp r12, 0;
        je  atd_done;
        sub r12, 1;
        lea r10, [rip + _at_dec_scratch];
        add r10, r12;
        xor rax, rax;
        mov_b rax, [r10 + 0];
        mov rdi, rax;
        sub rsp, 8;                        // 2 pushes steady state %16==8;
                                           //   +8 pad -> %16==0 for call
        call _at_tx_byte;
        add rsp, 8;
        jmp atd_emit;

      atd_done:
        pop r12;
        pop rbx;
        ret
      }
    }

  // =========================================================================
  // Section 6 -- _at_tx_box(idx, flags) -> ()
  // =========================================================================
  //
  // Emits one box-drawing glyph.  Reads AT_FLAG_ASCII to decide
  // between the UTF-8 (3 bytes) and ASCII (1 byte) tables.  Keeps idx
  // and flags in rbx and r12 so they survive the nested _at_tx_byte
  // calls; recomputes the table pointer per emitted byte because
  // uart_putc does not preserve r10 (caller-save in SysV).
  //
  // Preserves (SysV callee-save): rbx, rbp, r12-r15.
  pub let _at_tx_box : (u64, u64) -> () !{sysreg, mem, PortIo} @{paideia.port_io} =
    fn (idx: u64) (flags: u64) -> unsafe {
      effects: {sysreg, mem, PortIo},
      capabilities: {paideia.port_io},
      justification: "R129.M3: emit one box-drawing glyph via _at_tx_byte. 2 callee-save pushes (rbx=idx, r12=flags) -> rsp%16==8 steady; `sub rsp,8` before each nested call lands rsp%16==0. ASCII branch (AT_FLAG_ASCII set): single mov_b from _at_box_ascii[idx], one _at_tx_byte call, done. UTF-8 branch: offset = idx*3 computed as `mov rax,idx; add rax,idx; add rax,idx` (strictly within the pdx encoder's reg-reg add subset -- avoids any `lea rN,[rN*2+rN]` scaled-base form that pdx has not been exercised with). Each of three bytes recomputes `lea r10,[rip+_at_box_utf8]; add r10, offset+k` because uart_putc clobbers r10 (caller-save). Encoder: mov / xor / and / cmp / je / jne / jmp / add / sub / lea / mov_b / push / pop / call -- all pre-existing. Reserved-label discipline: atb_ prefix.",
      block: {
        push rbx;
        push r12;

        mov rbx, rdi;                      // rbx = idx
        mov r12, rsi;                      // r12 = flags

        // ASCII branch?
        mov rax, r12;
        and rax, 0x01;                     // AT_FLAG_ASCII
        cmp rax, 0;
        je  atb_utf8;

      atb_ascii:
        lea r10, [rip + _at_box_ascii];
        add r10, rbx;
        xor rax, rax;
        mov_b rax, [r10 + 0];
        mov rdi, rax;
        sub rsp, 8;
        call _at_tx_byte;
        add rsp, 8;
        jmp atb_done;

      atb_utf8:
        // offset = idx*3 (byte position within the flat 33-byte table).
        // Byte 0:
        mov rax, rbx;
        add rax, rbx;
        add rax, rbx;
        lea r10, [rip + _at_box_utf8];
        add r10, rax;
        xor rax, rax;
        mov_b rax, [r10 + 0];
        mov rdi, rax;
        sub rsp, 8;
        call _at_tx_byte;
        add rsp, 8;

        // Byte 1 -- recompute pointer (uart_putc clobbers r10).
        mov rax, rbx;
        add rax, rbx;
        add rax, rbx;
        lea r10, [rip + _at_box_utf8];
        add r10, rax;
        xor rax, rax;
        mov_b rax, [r10 + 1];
        mov rdi, rax;
        sub rsp, 8;
        call _at_tx_byte;
        add rsp, 8;

        // Byte 2.
        mov rax, rbx;
        add rax, rbx;
        add rax, rbx;
        lea r10, [rip + _at_box_utf8];
        add r10, rax;
        xor rax, rax;
        mov_b rax, [r10 + 2];
        mov rdi, rax;
        sub rsp, 8;
        call _at_tx_byte;
        add rsp, 8;

      atb_done:
        pop r12;
        pop rbx;
        ret
      }
    }

  // =========================================================================
  // Section 7 -- _at_tx_set_color(code, color, flags) -> ()
  // =========================================================================
  //
  // Emits `\e[<code>;5;<color>m` where <code> is 38 (foreground) or 48
  // (background).  Suppressed entirely when AT_FLAG_NO_COLOR is set.
  //
  // SysV: rdi = code (38 or 48), rsi = color (0..255), rdx = flags.
  //
  // Registers:
  //   rbx = code (callee-save; needed twice for tens/ones digit splits)
  //   r12 = color (callee-save; passed to _at_tx_u64_dec)
  //
  // Preserves (SysV callee-save): rbx, rbp, r12-r15.
  pub let _at_tx_set_color : (u64, u64, u64) -> () !{sysreg, mem, PortIo} @{paideia.port_io} =
    fn (code: u64) (color: u64) (flags: u64) -> unsafe {
      effects: {sysreg, mem, PortIo},
      capabilities: {paideia.port_io},
      justification: "R129.M3: emit ANSI-256 colour SGR escape `\\e[<code>;5;<color>m`. 2 callee-save pushes (rbx=code, r12=colour) -> rsp%16==8 steady; `sub rsp,8` before each nested call lands rsp%16==0. First guards on AT_FLAG_NO_COLOR -- `mov rax,rdx; and rax,0x02; cmp rax,0; jne atc_done` -- returns immediately with no bytes emitted when the caller wants plain output. Then emits ESC '[' and splits `code` (always 38 or 48 at M3 callsites) into two decimal digits via two separate `div rcx` operations (the first retrieves the tens digit in rax, the second the ones in rdx; a single division is sufficient but we repeat because `rax/rdx` are caller-save and get clobbered by each nested _at_tx_byte call between digit emissions). Then ';' '5' ';', _at_tx_u64_dec(colour), 'm'. Encoder: mov / xor / and / cmp / je / jne / jmp / div / add / push / pop / call -- all pre-existing. Reserved-label discipline: atc_ prefix.",
      block: {
        push rbx;
        push r12;

        mov rbx, rdi;                      // code (38 or 48)
        mov r12, rsi;                      // colour

        // Honour AT_FLAG_NO_COLOR.
        mov rax, rdx;
        and rax, 0x02;                     // AT_FLAG_NO_COLOR
        cmp rax, 0;
        jne atc_done;

        // ESC '['
        mov rdi, 0x1B;
        sub rsp, 8;
        call _at_tx_byte;
        add rsp, 8;
        mov rdi, 0x5B;
        sub rsp, 8;
        call _at_tx_byte;
        add rsp, 8;

        // Emit `code` tens digit (code / 10).
        xor rdx, rdx;
        mov rax, rbx;
        mov rcx, 10;
        div rcx;                           // rax = tens
        add rax, 0x30;
        mov rdi, rax;
        sub rsp, 8;
        call _at_tx_byte;
        add rsp, 8;

        // Emit `code` ones digit (code mod 10) -- recomputed because
        // the first div's rdx was clobbered by the intervening call.
        xor rdx, rdx;
        mov rax, rbx;
        mov rcx, 10;
        div rcx;
        add rdx, 0x30;
        mov rdi, rdx;
        sub rsp, 8;
        call _at_tx_byte;
        add rsp, 8;

        // ';' '5' ';'
        mov rdi, 0x3B;
        sub rsp, 8;
        call _at_tx_byte;
        add rsp, 8;
        mov rdi, 0x35;
        sub rsp, 8;
        call _at_tx_byte;
        add rsp, 8;
        mov rdi, 0x3B;
        sub rsp, 8;
        call _at_tx_byte;
        add rsp, 8;

        // Decimal colour value (0..255).
        mov rdi, r12;
        sub rsp, 8;
        call _at_tx_u64_dec;
        add rsp, 8;

        // 'm'
        mov rdi, 0x6D;
        sub rsp, 8;
        call _at_tx_byte;
        add rsp, 8;

      atc_done:
        pop r12;
        pop rbx;
        ret
      }
    }

  // =========================================================================
  // Section 8 -- _at_tx_reset(flags) -> ()
  // =========================================================================
  //
  // Emits `\e[0m` (SGR reset).  Suppressed under AT_FLAG_NO_COLOR.
  //
  // No callee-save pushes.  rax used only for the flag test; nested
  // calls use `sub rsp,8; call; add rsp,8` for alignment.
  pub let _at_tx_reset : (u64) -> () !{sysreg, mem, PortIo} @{paideia.port_io} =
    fn (flags: u64) -> unsafe {
      effects: {sysreg, mem, PortIo},
      capabilities: {paideia.port_io},
      justification: "R129.M3: emit SGR reset `\\e[0m`. Zero callee-save pushes: entry rsp%16==8; `sub rsp,8` before each nested call lands %16==0. The AT_FLAG_NO_COLOR guard uses `mov rax,rdi; and rax,0x02; cmp rax,0; jne atC_done` (via scratch rax so rdi is left intact in case a later wave extends this helper). Then emits the 4-byte sequence ESC '[' '0' 'm'. Encoder: mov / and / cmp / jne / sub / add / call / ret -- all pre-existing. Reserved-label discipline: atC_ prefix (uppercase C to disambiguate from atc_ used by _at_tx_set_color's local labels).",
      block: {
        // AT_FLAG_NO_COLOR fast-exit.
        mov rax, rdi;
        and rax, 0x02;
        cmp rax, 0;
        jne atC_done;

        mov rdi, 0x1B;
        sub rsp, 8;
        call _at_tx_byte;
        add rsp, 8;
        mov rdi, 0x5B;
        sub rsp, 8;
        call _at_tx_byte;
        add rsp, 8;
        mov rdi, 0x30;
        sub rsp, 8;
        call _at_tx_byte;
        add rsp, 8;
        mov rdi, 0x6D;
        sub rsp, 8;
        call _at_tx_byte;
        add rsp, 8;

      atC_done:
        ret
      }
    }

  // =========================================================================
  // Section 9 -- _at_tx_pad(count) -> ()
  // =========================================================================
  //
  // Emits `count` space characters.
  //
  // 1 push rbx -> rsp%16==0 steady state; no extra pad needed per call.
  pub let _at_tx_pad : (u64) -> () !{sysreg, PortIo} @{paideia.port_io} =
    fn (count: u64) -> unsafe {
      effects: {sysreg, PortIo},
      capabilities: {paideia.port_io},
      justification: "R129.M3: emit `count` ASCII spaces (0x20). 1 callee-save push (rbx=count): entry rsp%16==8, +push -> rsp%16==0 steady state. Nested _at_tx_byte calls need rsp%16==0 which is already satisfied; no additional pad per call. Loop decrements rbx until zero; each iteration calls _at_tx_byte with rdi=0x20. Encoder: mov / cmp / je / sub / jmp / push / pop / call -- all pre-existing. Reserved-label discipline: atp_ prefix.",
      block: {
        push rbx;

        mov rbx, rdi;                      // count

      atp_loop:
        cmp rbx, 0;
        je  atp_done;
        mov rdi, 0x20;                     // ' '
        call _at_tx_byte;
        sub rbx, 1;
        jmp atp_loop;

      atp_done:
        pop rbx;
        ret
      }
    }

  // =========================================================================
  // Section 10 -- _at_emit_cell(data_ptr, data_len, cell_width,
  //                              align_flags, flags) -> ()
  // =========================================================================
  //
  // Emits a single cell: left/right/centre-pads `data_len` bytes from
  // `data_ptr` within a `cell_width`-wide field.  Over-long data is
  // hard-cut at `cell_width`; the `flags` argument is reserved for
  // future truncation-glyph behaviour.
  //
  // SysV: rdi=data_ptr, rsi=data_len, rdx=cell_width, rcx=align,
  //       r8=flags.
  //
  // Registers (6 callee-save pushes, rsp%16==8 steady, +8 pad per
  // nested call):
  //   rbx = data_ptr
  //   rbp = data_len (clamped)
  //   r12 = cell_width
  //   r13 = align
  //   r14 = left padding (computed per align)
  //   r15 = loop counter (walking rbx[0..rbp])
  pub let _at_emit_cell : (u64, u64, u64, u64, u64) -> ()
                          !{sysreg, mem, PortIo} @{paideia.port_io} =
    fn (data_ptr: u64) (data_len: u64) (cell_width: u64)
       (align_flags: u64) (flags: u64) -> unsafe {
      effects: {sysreg, mem, PortIo},
      capabilities: {paideia.port_io},
      justification: "R129.M3: emit one aligned, padded cell. 6 callee-save pushes (rbx=data_ptr, rbp=data_len_clamped, r12=cell_width, r13=align, r14=left_pad, r15=data_loop_counter) -> rsp%16==8 steady (entry %16==8, +48 pushes -> %16==8); `sub rsp,8` before each nested call lands %16==0. Clamp: `cmp rbp,r12; jbe keep; mov rbp,r12`. Compute left_pad into r14 via switch on r13: AT_ALIGN_RIGHT -> r14=total_pad=r12-rbp; AT_ALIGN_CENTER -> r14=total_pad/2 via shr 1; default (LEFT or unknown) -> r14=0. Then emit left_pad spaces via _at_tx_pad; walk rbx[0..rbp] one byte per _at_tx_byte call using r15 as the index; finally compute right_pad = r12 - rbp - r14 inline (all three operands still live in callee-save slots) and emit that many spaces. Encoder: mov / cmp / je / jne / jbe / ja / jae / jmp / sub / shr / xor / lea / mov_b / push / pop / call -- all pre-existing. Reserved-label discipline: ate_ prefix.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                      // data_ptr
        mov rbp, rsi;                      // data_len
        mov r12, rdx;                      // cell_width
        mov r13, rcx;                      // align

        // Clamp data_len to cell_width.
        cmp rbp, r12;
        jbe ate_clamped;
        mov rbp, r12;
      ate_clamped:

        // Compute left_pad into r14 based on align.
        xor r14, r14;
        cmp r13, 1;                        // AT_ALIGN_RIGHT
        je  ate_align_right;
        cmp r13, 2;                        // AT_ALIGN_CENTER
        je  ate_align_center;
        jmp ate_align_done;                // default: LEFT -> r14 = 0

      ate_align_right:
        mov r14, r12;
        sub r14, rbp;                      // r14 = total_pad
        jmp ate_align_done;

      ate_align_center:
        mov r14, r12;
        sub r14, rbp;                      // total_pad
        shr r14, 1;                        // /2 -> left half
        jmp ate_align_done;

      ate_align_done:
        // Emit left padding (r14 spaces).
        cmp r14, 0;
        je  ate_data_phase;
        mov rdi, r14;
        sub rsp, 8;
        call _at_tx_pad;
        add rsp, 8;

      ate_data_phase:
        xor r15, r15;                      // i = 0

      ate_data_loop:
        cmp r15, rbp;
        jae ate_right_phase;
        mov r10, rbx;
        add r10, r15;
        xor rax, rax;
        mov_b rax, [r10 + 0];
        mov rdi, rax;
        sub rsp, 8;
        call _at_tx_byte;
        add rsp, 8;
        add r15, 1;
        jmp ate_data_loop;

      ate_right_phase:
        // right_pad = cell_width - data_len - left_pad.
        mov rax, r12;
        sub rax, rbp;
        sub rax, r14;
        cmp rax, 0;
        je  ate_done;
        mov rdi, rax;
        sub rsp, 8;
        call _at_tx_pad;
        add rsp, 8;

      ate_done:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }

  // =========================================================================
  // Section 11 -- _at_emit_border(desc_ptr, col_count, left_idx,
  //                                mid_idx, right_idx, flags) -> ()
  // =========================================================================
  //
  // Emits one horizontal border row:
  //
  //    <left_idx> HORIZ*(w0+2) <mid_idx> HORIZ*(w1+2) ... <right_idx> \n
  //
  // The +2 absorbs the one-char lead and one-char trail that every
  // data / header cell carries.  `flags` is forwarded to _at_tx_box so
  // the UTF-8 / ASCII choice tracks the renderer-level flag.
  //
  // SysV: rdi=desc_ptr, rsi=col_count, rdx=left, rcx=mid, r8=right,
  //       r9=flags.
  //
  // Registers (6 callee-save pushes + 16-byte local scratch:
  //   rbx = desc_ptr
  //   rbp = col_count
  //   r12 = left_idx (consumed early)
  //   r13 = mid_idx
  //   r14 = right_idx
  //   r15 = flags
  //   [rsp +  0] = col_index
  //   [rsp +  8] = horiz_counter
  pub let _at_emit_border : (u64, u64, u64, u64, u64, u64) -> ()
                             !{sysreg, mem, PortIo} @{paideia.port_io} =
    fn (desc_ptr: u64) (col_count: u64) (left_idx: u64)
       (mid_idx: u64) (right_idx: u64) (flags: u64) -> unsafe {
      effects: {sysreg, mem, PortIo},
      capabilities: {paideia.port_io},
      justification: "R129.M3: emit one horizontal border row (top, mid-separator, or bottom). 6 callee-save pushes (rbx=desc, rbp=col_count, r12=left_idx, r13=mid_idx, r14=right_idx, r15=flags) + `sub rsp,16` for two local scratch slots: entry rsp%16==8, +48 pushes -> %16==8, +16 scratch -> %16==8. Each nested call therefore needs `sub rsp,8` to land %16==0. Flow: emit left_idx glyph; loop col_index in 0..col_count { if col_index>0: emit mid_idx glyph; load col_width = low 16 bits of [desc + col_index*16 + 8]; emit HORIZ (col_width+2) times via a cmp-sub inner loop that calls _at_tx_box each iteration }; emit right_idx glyph; emit '\\n'. Column counter and horiz counter live in the stack scratch, not callee-save slots, so they survive the nested _at_tx_box calls without any additional preservation discipline. Encoder: mov / xor / add / sub / shl / and / cmp / je / jne / jae / jmp / lea / push / pop / call -- all pre-existing. Reserved-label discipline: atH_ prefix.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 16;                       // 2 scratch slots

        mov rbx, rdi;                      // desc_ptr
        mov rbp, rsi;                      // col_count
        mov r12, rdx;                      // left_idx
        mov r13, rcx;                      // mid_idx
        mov r14, r8;                       // right_idx
        mov r15, r9;                       // flags

        // Emit left corner glyph.
        mov rdi, r12;
        mov rsi, r15;
        sub rsp, 8;
        call _at_tx_box;
        add rsp, 8;

        // col_index = 0
        xor rax, rax;
        mov [rsp + 0], rax;

      atH_col_loop:
        mov rax, [rsp + 0];
        cmp rax, rbp;
        jae atH_cols_done;

        // If col_index > 0, emit mid_idx separator.
        cmp rax, 0;
        je  atH_skip_mid;
        mov rdi, r13;
        mov rsi, r15;
        sub rsp, 8;
        call _at_tx_box;
        add rsp, 8;

      atH_skip_mid:
        // r11 = desc_ptr + col_index * 16
        mov rax, [rsp + 0];
        shl rax, 4;                        // *16
        mov r11, rbx;
        add r11, rax;

        // col_width = low 16 bits of [r11 + 8], +2 for lead/trail spaces
        mov rax, [r11 + 8];
        and rax, 0xFFFF;                   // imm32 mask, OK
        add rax, 2;
        mov [rsp + 8], rax;                // horiz_counter

      atH_horiz_loop:
        mov rax, [rsp + 8];
        cmp rax, 0;
        je  atH_horiz_done;
        mov rdi, 0;                        // AT_BX_HORIZ
        mov rsi, r15;
        sub rsp, 8;
        call _at_tx_box;
        add rsp, 8;
        mov rax, [rsp + 8];
        sub rax, 1;
        mov [rsp + 8], rax;
        jmp atH_horiz_loop;

      atH_horiz_done:
        // col_index++
        mov rax, [rsp + 0];
        add rax, 1;
        mov [rsp + 0], rax;
        jmp atH_col_loop;

      atH_cols_done:
        // Right-corner glyph.
        mov rdi, r14;
        mov rsi, r15;
        sub rsp, 8;
        call _at_tx_box;
        add rsp, 8;

        // Newline.
        mov rdi, 0x0A;
        sub rsp, 8;
        call _at_tx_byte;
        add rsp, 8;

        add rsp, 16;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }

  // =========================================================================
  // Section 12 -- _at_emit_header_row(desc_ptr, col_count, flags) -> ()
  // =========================================================================
  //
  // Emits the single header row -- one vertical bar, one space, the
  // header-text aligned per the column's align_flags, one space,
  // repeated per column, closed by a trailing vertical bar + newline.
  // The entire row is wrapped in `\e[48;5;<AT_DEFAULT_HEADER_BG>m` +
  // `\e[38;5;<AT_DEFAULT_HEADER_FG>m` and closed with `\e[0m` so the
  // header reads as a solid-colour bar at the top of the table.
  // AT_FLAG_NO_HEADER_BG suppresses only the background highlight;
  // AT_FLAG_NO_COLOR suppresses the whole SGR dance.
  pub let _at_emit_header_row : (u64, u64, u64) -> ()
                                 !{sysreg, mem, PortIo} @{paideia.port_io} =
    fn (desc_ptr: u64) (col_count: u64) (flags: u64) -> unsafe {
      effects: {sysreg, mem, PortIo},
      capabilities: {paideia.port_io},
      justification: "R129.M3: emit the header row with default fg/bg SGR wrapping. 4 callee-save pushes (rbx=desc, rbp=col_count, r12=flags, r13=col_index) + `sub rsp,8` scratch pad -> rsp%16==0 steady (entry %16==8, +32 pushes = %16==8, +8 sub = %16==0). Nested calls need rsp%16==0, which is already true -- NO additional pad per call. Flow: (1) emit AT_DEFAULT_HEADER_BG via _at_tx_set_color(48, 24, flags) unless AT_FLAG_NO_HEADER_BG is set; (2) emit AT_DEFAULT_HEADER_FG via _at_tx_set_color(38, 15, flags); (3) for each column emit VERT + ' ' + aligned-header-text + ' '; the header-text pointer and length decoded from the descriptor's first 8 bytes: low 48 bits are the ptr, high 16 bits are the length; (4) emit the final VERT; (5) _at_tx_reset(flags); (6) '\\n'. Pointer extract: `mov rax,[r11+0]; mov rdx,rax; shr rdx,48; shl rax,16; shr rax,16` -- rdx=length, rax=48-bit ptr. Column width extracted from [r11+8] low 16 bits. Align extracted from [r11+8] bits 16..31. Encoder: mov / xor / shl / shr / and / cmp / je / jne / jmp / add / sub / lea / push / pop / call -- all pre-existing. Reserved-label discipline: atf_ prefix.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        sub rsp, 8;

        mov rbx, rdi;                      // desc_ptr
        mov rbp, rsi;                      // col_count
        mov r12, rdx;                      // flags

        // --- Header background (unless NO_HEADER_BG) ---
        mov rax, r12;
        and rax, 0x08;                     // AT_FLAG_NO_HEADER_BG
        cmp rax, 0;
        jne atf_skip_bg;
        mov rdi, 48;
        mov rsi, 24;                       // AT_DEFAULT_HEADER_BG
        mov rdx, r12;
        call _at_tx_set_color;
      atf_skip_bg:

        // --- Header foreground ---
        mov rdi, 38;
        mov rsi, 15;                       // AT_DEFAULT_HEADER_FG
        mov rdx, r12;
        call _at_tx_set_color;

        // --- Per-column emission ---
        xor r13, r13;                      // col_index

      atf_col_loop:
        cmp r13, rbp;
        jae atf_cols_done;

        // Emit opening VERT.
        mov rdi, 1;                        // AT_BX_VERT
        mov rsi, r12;
        call _at_tx_box;

        // Emit leading space.
        mov rdi, 0x20;
        call _at_tx_byte;

        // r11 = desc + col_index * 16
        mov rax, r13;
        shl rax, 4;
        mov r11, rbx;
        add r11, rax;

        // Load descriptor row 0 (header ptr lo 48 | header len hi 16).
        mov rax, [r11 + 0];
        mov rdx, rax;
        shr rdx, 48;                       // header_len
        shl rax, 16;
        shr rax, 16;                       // header_ptr (48-bit)

        // Load descriptor row 1 (width | align | fg | bg | reserved).
        mov rcx, [r11 + 8];
        mov r8, rcx;
        and r8, 0xFFFF;                    // width
        mov r9, rcx;
        shr r9, 16;
        and r9, 0xFFFF;                    // align

        // _at_emit_cell(data_ptr=rax, data_len=rdx, cell_width=r8,
        //                align_flags=r9, flags=r12)
        mov rdi, rax;
        mov rsi, rdx;
        mov rdx, r8;
        mov rcx, r9;
        mov r8, r12;
        call _at_emit_cell;

        // Trailing space.
        mov rdi, 0x20;
        call _at_tx_byte;

        add r13, 1;
        jmp atf_col_loop;

      atf_cols_done:
        // Closing VERT.
        mov rdi, 1;                        // AT_BX_VERT
        mov rsi, r12;
        call _at_tx_box;

        // Reset SGR.
        mov rdi, r12;
        call _at_tx_reset;

        // Newline.
        mov rdi, 0x0A;
        call _at_tx_byte;

        add rsp, 8;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }

  // =========================================================================
  // Section 13 -- _at_emit_data_row(row_ptr, desc_ptr, col_count,
  //                                 alt, flags) -> ()
  // =========================================================================
  //
  // Emits one data row.  `alt` is 0 for the default row background, 1
  // for the alternating-shade background (AT_DEFAULT_ALT_BG), chosen
  // by the caller via row_index parity when AT_FLAG_ALT_ROWS is set.
  //
  // Per-column: emit VERT, space, cell_data (sliced from the row
  // bytes at the running offset), space.  Cell data length is the
  // column width; the renderer trusts the caller to NUL-pad or
  // space-pad short strings.
  //
  // Per-column fg/bg from the descriptor is NOT emitted at M3 (M4
  // ticket).  The row-level alt-bg is set once at the start of the
  // row and reset once at the end.
  pub let _at_emit_data_row : (u64, u64, u64, u64, u64) -> ()
                               !{sysreg, mem, PortIo} @{paideia.port_io} =
    fn (row_ptr: u64) (desc_ptr: u64) (col_count: u64)
       (alt: u64) (flags: u64) -> unsafe {
      effects: {sysreg, mem, PortIo},
      capabilities: {paideia.port_io},
      justification: "R129.M3: emit one data row. 6 callee-save pushes (rbx=row, rbp=desc, r12=col_count, r13=flags, r14=col_index, r15=cell_offset) -> rsp%16==8 steady (entry %16==8, +48 -> %16==8); `sub rsp,8` before each nested call lands %16==0. If `alt`!=0: emit AT_DEFAULT_ALT_BG via _at_tx_set_color(48, 236, flags) once at the top of the row. For each column c: emit VERT + ' '; read col width = low 16 bits of [desc + c*16 + 8]; read align = bits 16..31; _at_emit_cell(row+cell_offset, width, width, align, flags); emit ' '; advance cell_offset by width. After cols: reset SGR; emit VERT + '\\n'. The `alt` arg lands in rcx on entry (SysV 4th register) and is tested before the register map is finalised. Encoder: mov / xor / shl / shr / and / cmp / je / jne / jae / jmp / add / sub / lea / push / pop / call -- all pre-existing. Reserved-label discipline: ati_ prefix.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                      // row_ptr
        mov rbp, rsi;                      // desc_ptr
        mov r12, rdx;                      // col_count
        mov r13, r8;                       // flags

        // alt-row background: if (alt != 0) set bg to AT_DEFAULT_ALT_BG.
        cmp rcx, 0;
        je  ati_no_alt;
        mov rdi, 48;
        mov rsi, 236;                      // AT_DEFAULT_ALT_BG
        mov rdx, r13;
        sub rsp, 8;
        call _at_tx_set_color;
        add rsp, 8;
      ati_no_alt:

        xor r14, r14;                      // col_index
        xor r15, r15;                      // cell_offset

      ati_col_loop:
        cmp r14, r12;
        jae ati_cols_done;

        // Opening VERT.
        mov rdi, 1;                        // AT_BX_VERT
        mov rsi, r13;
        sub rsp, 8;
        call _at_tx_box;
        add rsp, 8;

        // Leading space.
        mov rdi, 0x20;
        sub rsp, 8;
        call _at_tx_byte;
        add rsp, 8;

        // r11 = desc + col_index * 16; read width and align.
        mov rax, r14;
        shl rax, 4;
        mov r11, rbp;
        add r11, rax;
        mov r9, [r11 + 8];
        mov r8, r9;
        and r8, 0xFFFF;                    // width
        mov rcx, r9;
        shr rcx, 16;
        and rcx, 0xFFFF;                   // align

        // Cell data pointer: row + cell_offset.
        mov r10, rbx;
        add r10, r15;

        // _at_emit_cell(data_ptr=r10, data_len=r8, cell_width=r8,
        //                align_flags=rcx, flags=r13).
        //   data_len == width so the whole slice is read; the caller
        //   NUL/space-pads shorter strings.
        mov rdi, r10;
        mov rsi, r8;                       // data_len
        mov rdx, r8;                       // cell_width
                                           // rcx = align (already set)
        mov r8, r13;                       // flags
        sub rsp, 8;
        call _at_emit_cell;
        add rsp, 8;

        // Reload width (r8 was overwritten with flags, and the call
        // clobbered caller-save regs); re-extract from the same slot.
        mov rax, r14;
        shl rax, 4;
        mov r11, rbp;
        add r11, rax;
        mov r9, [r11 + 8];
        mov r8, r9;
        and r8, 0xFFFF;

        // Trailing space.
        mov rdi, 0x20;
        sub rsp, 8;
        call _at_tx_byte;
        add rsp, 8;

        // Advance cell_offset by column width.
        add r15, r8;

        // Advance col_index.
        add r14, 1;
        jmp ati_col_loop;

      ati_cols_done:
        // Closing VERT.  Kept inside the alt-bg SGR scope so that
        // the row's opening VERT and closing VERT render with the
        // same background (the alt-bg bar is contiguous across the
        // full row width).  The reset emits AFTER the closing VERT
        // so the newline terminates a plain line.
        mov rdi, 1;
        mov rsi, r13;
        sub rsp, 8;
        call _at_tx_box;
        add rsp, 8;

        // Reset SGR.
        mov rdi, r13;
        sub rsp, 8;
        call _at_tx_reset;
        add rsp, 8;

        // Newline.
        mov rdi, 0x0A;
        sub rsp, 8;
        call _at_tx_byte;
        add rsp, 8;

        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }

  // =========================================================================
  // Section 14 -- _ansi256_table_render (public entry) -> errno
  // =========================================================================
  //
  // SysV register map:
  //     rdi = tty_fd        (M3: forwarded identity, uart_putc only)
  //     rsi = rows_ptr      (packed byte records; row stride = sum of
  //                           col widths)
  //     rdx = row_count     (0..AT_MAX_ROWS=128)
  //     rcx = cols_desc_ptr (array of 16-byte descriptors)
  //     r8  = col_count     (1..AT_MAX_COLS=32)
  //     r9  = flags         (bit-mask of AT_FLAG_*)
  //     ret = errno (AT_OK or AT_ERR_*)
  //
  // Flow:
  //   1. Validate counts and non-null descriptor.
  //   2. Compute row_stride = sum of column widths.
  //   3. Emit top border (TL ─...─ TDN ─...─ TR).
  //   4. Emit header row (coloured by defaults).
  //   5. Emit mid-separator (TRI ─...─ CROSS ─...─ TLE).
  //   6. Emit each data row.
  //   7. Emit bottom border (BL ─...─ TUP ─...─ BR).
  //
  // No row-stride cache is written to .bss: the stride is held in r15
  // for the lifetime of the call and multiplied by the row index at
  // every data-row emit.
  pub let _ansi256_table_render : (u64, u64, u64, u64, u64, u64) -> u64
                                   !{sysreg, mem, PortIo}
                                   @{paideia.port_io} =
    fn (tty_fd: u64) (rows_ptr: u64) (row_count: u64)
       (cols_desc_ptr: u64) (col_count: u64) (flags: u64) -> unsafe {
      effects: {sysreg, mem, PortIo},
      capabilities: {paideia.port_io},
      justification: "R129.M3: the public tabular render entry point. 6 callee-save pushes (rbx=rows_ptr, rbp=desc_ptr, r12=col_count, r13=row_count, r14=flags, r15=row_stride) + `sub rsp,8` for one scratch slot (row_index) -> rsp%16==0 steady state (entry %16==8, +48 pushes = %16==8, +8 sub = %16==0). Nested calls need %16==0: no additional pad required per call. Validation: cmp r12,0/je bad_desc; cmp r12,32/ja too_many_cols; cmp r13,128/ja too_many_rows; cmp rbp,0/je bad_desc. row_stride computed by walking the descriptor table once and summing the low 16 bits of [desc + c*16 + 8] for c in 0..col_count. Borders then step through _at_emit_border with (TL=2, TDN=6, TR=3) for top, (TRI=9, CROSS=10, TLE=8) for mid-separator, (BL=4, TUP=7, BR=5) for bottom. Header row via _at_emit_header_row. Data rows looped with row index in [rsp+0]; cell_offset = row_idx * row_stride via a 2-op reg-reg `imul rax,r15` (proven in time/tsc.pdx L190); alt flag derived from (row_idx & 1) if AT_FLAG_ALT_ROWS is set in r14. Error codes: 0x1800 TOO_MANY_COLS, 0x1801 TOO_MANY_ROWS, 0x1802 BAD_DESC, 0 AT_OK. Encoder: mov / xor / shl / shr / and / cmp / je / jne / ja / jbe / jae / jmp / add / sub / imul / lea / push / pop / call -- all pre-existing. Reserved-label discipline: atR_ prefix.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;                        // one scratch slot: row_index

        mov rbx, rsi;                      // rows_ptr
        mov rbp, rcx;                      // cols_desc_ptr
        mov r12, r8;                       // col_count
        mov r13, rdx;                      // row_count
        mov r14, r9;                       // flags

        // --- Validation ---
        cmp r12, 0;
        je  atR_bad_desc;
        cmp r12, 32;                       // AT_MAX_COLS
        ja  atR_too_many_cols;
        cmp r13, 128;                      // AT_MAX_ROWS
        ja  atR_too_many_rows;
        cmp rbp, 0;
        je  atR_bad_desc;

        // --- Compute row_stride = sum of column widths ---
        xor r15, r15;                      // row_stride accumulator
        xor rcx, rcx;                      // c = 0

      atR_stride_loop:
        cmp rcx, r12;
        jae atR_stride_done;
        mov rax, rcx;
        shl rax, 4;                        // *16
        mov r11, rbp;
        add r11, rax;
        mov rax, [r11 + 8];
        and rax, 0xFFFF;                   // width (low 16 bits)
        add r15, rax;
        add rcx, 1;
        jmp atR_stride_loop;

      atR_stride_done:

        // --- Top border: TL(2) ─ TDN(6) ─ TR(3) ---
        mov rdi, rbp;
        mov rsi, r12;
        mov rdx, 2;                        // AT_BX_TL
        mov rcx, 6;                        // AT_BX_T_DOWN
        mov r8, 3;                         // AT_BX_TR
        mov r9, r14;
        call _at_emit_border;

        // --- Header row ---
        mov rdi, rbp;
        mov rsi, r12;
        mov rdx, r14;
        call _at_emit_header_row;

        // --- Mid-separator: T_RIGHT(9) CROSS(10) T_LEFT(8) ---
        mov rdi, rbp;
        mov rsi, r12;
        mov rdx, 9;                        // AT_BX_T_RIGHT
        mov rcx, 10;                       // AT_BX_CROSS
        mov r8, 8;                         // AT_BX_T_LEFT
        mov r9, r14;
        call _at_emit_border;

        // --- Data rows ---
        xor rax, rax;                      // row_index = 0
        mov [rsp + 0], rax;

      atR_row_loop:
        mov rax, [rsp + 0];
        cmp rax, r13;
        jae atR_rows_done;

        // row_ptr = rows + row_index * row_stride
        //   reg-reg `imul rax, r15` is in the proven subset.
        mov rax, [rsp + 0];
        imul rax, r15;
        mov rdi, rbx;
        add rdi, rax;                      // rdi = row_ptr

        mov rsi, rbp;                      // desc_ptr
        mov rdx, r12;                      // col_count

        // alt = (row_index & 1) if AT_FLAG_ALT_ROWS set, else 0.
        xor rcx, rcx;
        mov rax, r14;
        and rax, 0x04;                     // AT_FLAG_ALT_ROWS
        cmp rax, 0;
        je  atR_no_alt_flag;
        mov rax, [rsp + 0];
        and rax, 0x01;
        mov rcx, rax;
      atR_no_alt_flag:

        mov r8, r14;                       // flags
        call _at_emit_data_row;

        // row_index++
        mov rax, [rsp + 0];
        add rax, 1;
        mov [rsp + 0], rax;
        jmp atR_row_loop;

      atR_rows_done:

        // --- Bottom border: BL(4) TUP(7) BR(5) ---
        mov rdi, rbp;
        mov rsi, r12;
        mov rdx, 4;                        // AT_BX_BL
        mov rcx, 7;                        // AT_BX_T_UP
        mov r8, 5;                         // AT_BX_BR
        mov r9, r14;
        call _at_emit_border;

        // --- Success ---
        xor rax, rax;                      // AT_OK
        jmp atR_epilogue;

      atR_too_many_cols:
        mov rax, 0x1800;
        jmp atR_epilogue;

      atR_too_many_rows:
        mov rax, 0x1801;
        jmp atR_epilogue;

      atR_bad_desc:
        mov rax, 0x1802;
        jmp atR_epilogue;

      atR_epilogue:
        add rsp, 8;                        // drop row_index scratch
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }
}
