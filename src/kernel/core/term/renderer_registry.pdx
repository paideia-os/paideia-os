// src/kernel/core/term/renderer_registry.pdx -- Wave UMB-W19 R129.M5
//
// Renderer-override `as` registry (paideia-os#2608).
//
// Lands:  2026-10-14
//
// Overview
// ========
//
// R129.M1 (xtgettcap.pdx)      landed the DEC/VT capability probe.
// R129.M2 (kitty_graphics.pdx) landed the Kitty APC-G bitmap emitter.
// R129.M3 (ansi256_table.pdx)  landed the ANSI-256 tabular fallback.
// R129.M4 (schema_fmt.pdx)     landed the schema-driven formatter.
//
// R129.M5 adds the `as` renderer-override surface.  A shell command's
// tail may read `as <name>`, selecting a specific renderer:
//
//     ls -l       as table    -> M3 ANSI-256
//     img.png     as kitty    -> M2 Kitty APC-G
//     jobs        as schema   -> M4 schema formatter
//     log.jsonl   as raw      -> uart_putc byte stream
//     metrics     as plot     -> reserved; falls through table
//     events.ndjn as json     -> reserved; falls through raw
//     rows.csv    as csv      -> reserved; falls through raw
//
// This module is NOT a renderer; it is a thin substrate:
//
//   1. Name registry: `_rr_lookup(name_ptr, name_len) -> id | 0xFF`
//      and `_rr_name(id) -> {name_ptr | len_hi16} | 0`.
//
//   2. Dispatch router: `_renderer_dispatch(rid, tty_fd, data_ptr,
//      data_len, schema_ptr) -> errno` that routes to the matching
//      M-module entry point under a per-renderer fallback matrix.
//
// Shell-side parser landing is deferred; see
// design/shell/renderer-override-as-syntax.md section 2.1 for the
// parser contract this module expects.
//
// Scope at M5
// -----------
//   * 7-entry static registry: table, kitty, schema, raw, plot, json, csv
//   * `_rr_lookup`, `_rr_name`, `_renderer_dispatch` public API
//   * table / kitty / schema / raw wired to M2/M3/M4 backends
//   * plot / json / csv reserved; fall back through the matrix
//     (never return RR_ERR_INCOMPATIBLE at M5 because every chain
//      terminates at `raw`)
//   * per-renderer fallback matrix: kitty -> schema -> table -> raw
//     (see section 5 of the design doc for every chain)
//
// Explicit non-scope at M5
// ------------------------
//   * no shell parser (deferred; module specifies the contract only)
//   * no KIND_RENDERER capability wiring (deferred to R129.M6)
//   * no per-column SGR (color_hint) -- pushed to R129.M7
//   * no fallback-decision logging to stderr (R129.M10)
//   * no multi-renderer fan-out (`as table,json`)
//
// See design/shell/renderer-override-as-syntax.md for the full contract.
//
// Encoder-pitfall notes
// ---------------------
//   * no `test rN, rN` -- always `cmp rN, 0; j{e,ne}`
//   * no 2-op `imul rN, imm` -- `shl rN, k` for the one multiplication
//     (i * 8 in the entry-stride step uses `shl rax, 3`)
//   * no `and rN, imm64` -- masks fit in imm8 or imm32 with bit 31
//     clear (so sign-extension at imm32 encoding is harmless).
//     `and rN, 0xFFFFFFFF` is a no-op because sign-extension fills
//     bits 32..63 with 1; use `shl rN, 32; shr rN, 32` to clear the
//     high half of a register.  All uses: `and rN, 0xFF` and
//     `and rN, 0xFFFF`, both safe (bit 31 clear).
//   * labels prefixed `rr_` (registry helpers) / `rr_d_` (dispatcher
//     sub-labels, one per renderer).  None collide with M1 (`xt_`),
//     M2 (`kg_`, `kga_`, `kgi_`), M3 (`at*_`), M4 (`sf*_`), and
//     avoid pdx reserved keywords (`loop`, `if`, `let`, `fn`, ...)
//   * module basename `RendererRegistry` matches
//     `renderer_registry.pdx`
//   * single-line `pub let X : T = ...`
//   * every RIP-relative load uses `lea rN, [rip + sym]` followed by
//     a byte-wise `mov_b` / wide `mov` through rN
//   * cross-module symbols (`_kitty_graphics_available`,
//     `_kitty_image_rgba`, `_ansi256_table_render`,
//     `_schema_fmt_render`, `uart_putc`) resolve as RIP-relative;
//     the linker emits R_X86_64_PC32

module RendererRegistry = structure {

  // =========================================================================
  // Section 1 -- public constants
  // =========================================================================

  // Return-status codes.  M5 owns the 0x1B00..0x1BFF band; the 0x1A00
  // band is deliberately reserved for a future R125/R127 shell-parser
  // layer so the three bands (parser -> registry -> backend) stay
  // disjoint.
  pub let RR_OK                  : u64 = 0
  pub let RR_ERR_UNKNOWN         : u64 = 0x1B00
  pub let RR_ERR_INCOMPATIBLE    : u64 = 0x1B01

  // Renderer-id enum.  Ids 0..6 are the seven at M5; id 0xFF is the
  // "no such name" sentinel returned by _rr_lookup on a miss.  The
  // 0..6 band is contiguous -- a new renderer appends id 7, not an
  // interior reservation.
  pub let RR_RENDERER_TABLE      : u64 = 0
  pub let RR_RENDERER_KITTY      : u64 = 1
  pub let RR_RENDERER_SCHEMA     : u64 = 2
  pub let RR_RENDERER_RAW        : u64 = 3
  pub let RR_RENDERER_PLOT       : u64 = 4
  pub let RR_RENDERER_JSON       : u64 = 5
  pub let RR_RENDERER_CSV        : u64 = 6

  pub let RR_RENDERER_COUNT      : u64 = 7
  pub let RR_ID_NONE             : u64 = 0xFF

  // Hard cap on any name a caller submits to _rr_lookup.  Longer
  // inputs short-circuit to RR_ID_NONE without touching the entry
  // table.  "schema" (6) is the longest registered name at M5; the
  // 16-byte budget leaves slack for a future "24bit" / "compact".
  pub let RR_NAME_MAX            : u64 = 16

  // =========================================================================
  // Section 2 -- immutable registry tables
  // =========================================================================

  // Packed name blob.  Byte offsets:
  //     table    [0 .. 5)
  //     kitty    [5 .. 10)
  //     schema   [10 .. 16)
  //     raw      [16 .. 19)
  //     plot     [19 .. 23)
  //     json     [23 .. 27)
  //     csv      [27 .. 30)
  //
  // All seven names are 7-bit ASCII lowercase, no NUL terminator.
  // One contiguous .rodata region keeps the loader map clean and the
  // L1-D touch pattern linear during lookup.
  pub let _rr_name_blob : [u8; 30] = "tablekittyschemarawplotjsoncsv"

  // Entry table.  7 x u64, each entry is `(len << 48) | offset`,
  // where `offset` is the byte offset into _rr_name_blob and `len`
  // is the name length.  The encoding leaves the ptr-fetch to the
  // consumer (`lea r_, [rip + _rr_name_blob]; add r_, offset`),
  // which dodges relocations for the inline string pointers.
  //
  //                                       len   offset
  //                                       ----  ------
  //     table    (5 << 48) |  0  = 0x0005000000000000
  //     kitty    (5 << 48) |  5  = 0x0005000000000005
  //     schema   (6 << 48) | 10  = 0x000600000000000A
  //     raw      (3 << 48) | 16  = 0x0003000000000010
  //     plot     (4 << 48) | 19  = 0x0004000000000013
  //     json     (4 << 48) | 23  = 0x0004000000000017
  //     csv      (3 << 48) | 27  = 0x000300000000001B
  //
  // The low 16 bits of each entry hold `offset` (fits in u16 since
  // the blob is 30 bytes); the high 16 bits of the low 32 are zero;
  // bits 48..63 hold `len` (max 16, fits in u8).  This layout mirrors
  // M4's `{ptr48 | len16}` convention closely enough that an operator
  // reading both tables side by side will not be surprised.
  pub let _rr_entries : [u64; 7] = [
    0x0005000000000000,
    0x0005000000000005,
    0x000600000000000A,
    0x0003000000000010,
    0x0004000000000013,
    0x0004000000000017,
    0x000300000000001B
  ]

  // =========================================================================
  // Section 3 -- _rr_memcmp(a_ptr, b_ptr, n) -> eq_flag
  // =========================================================================
  //
  // Byte-wise equality compare.  Returns 1 iff all `n` bytes match,
  // 0 otherwise.  Zero-length input returns 1 (vacuously equal).
  //
  // Leaf; no callee-save pushes.  Entry rsp%16==8 is untouched.
  //
  // SysV: rdi=a_ptr, rsi=b_ptr, rdx=n.  Return rax.
  pub let _rr_memcmp : (u64, u64, u64) -> u64 !{sysreg, mem} @{} =
    fn (a_ptr: u64) (b_ptr: u64) (n: u64) -> unsafe {
      effects: {sysreg, mem},
      capabilities: {},
      justification: "R129.M5 (paideia-os#2608, Wave UMB-W19): byte-wise memcmp for the name registry's lookup. Leaf -- no callee-save pushes, no nested calls -- so entry rsp%16==8 is untouched. Walks rcx (i) upward through rdx (n); each iteration loads a_ptr[i] into r10 via `mov_b r10, [r11+0]` (where r11 = a_ptr + i) and b_ptr[i] into r9 the same way, compares, branches to rr_memcmp_ne on mismatch. The compare is byte-wide which is sufficient at this cardinality (names up to 16 bytes). Returns 1 (equal) or 0 (unequal) in rax. The ==0 branch at the top handles the n==0 case correctly (returns 1 vacuously). Encoder: mov / xor / cmp / je / jne / jae / jmp / add / mov_b -- all pre-existing. Reserved-label discipline: rr_memcmp_ prefix.",
      block: {
        xor rcx, rcx;                      // i = 0
      rr_memcmp_loop:
        cmp rcx, rdx;
        jae rr_memcmp_eq;                  // reached n -> all matched
        mov r11, rdi;
        add r11, rcx;
        xor r10, r10;
        mov_b r10, [r11 + 0];
        mov r11, rsi;
        add r11, rcx;
        xor r9, r9;
        mov_b r9, [r11 + 0];
        cmp r10, r9;
        jne rr_memcmp_ne;
        add rcx, 1;
        jmp rr_memcmp_loop;
      rr_memcmp_eq:
        mov rax, 1;
        ret
      rr_memcmp_ne:
        xor rax, rax;
        ret
      }
    }

  // =========================================================================
  // Section 4 -- _rr_lookup(name_ptr, name_len) -> renderer_id | 0xFF
  // =========================================================================
  //
  // Linear scan over the 7-entry registry.  Returns the renderer id
  // on hit, or 0xFF (RR_ID_NONE) on miss.
  //
  // Short-circuit: name_len > RR_NAME_MAX (16) returns RR_ID_NONE
  // without touching the entry table.
  //
  // Mechanism: for each candidate id in 0..7, decode `entry_i`:
  //     offset = entry_i & 0xFFFF
  //     len    = entry_i >> 48
  // If `len != name_len`, skip.  Else `name_blob_ptr = &_rr_name_blob
  // + offset` and call _rr_memcmp(name_ptr, name_blob_ptr, len).  On
  // 1 return the id in rax; on 0 move to the next candidate.
  //
  // Registers (4 callee-save pushes, rsp%16==8 steady; nested
  // _rr_memcmp call wrapped in `sub rsp, 8` / `add rsp, 8` to land
  // rsp%16==0 at the call site):
  //   rbx = name_ptr
  //   rbp = name_len
  //   r12 = i (0..7)
  //   r13 = tmp (entry decode)
  pub let _rr_lookup : (u64, u64) -> u64 !{sysreg, mem} @{} =
    fn (name_ptr: u64) (name_len: u64) -> unsafe {
      effects: {sysreg, mem},
      capabilities: {},
      justification: "R129.M5: linear-scan lookup over the 7-entry name registry. 4 callee-save pushes (rbx=name_ptr, rbp=name_len, r12=i, r13=entry) -> rsp%16==8 steady (entry %16==8, +32 pushes = (8+32)%16 == 8). An even push count leaves alignment unchanged, so each nested _rr_memcmp call is wrapped in `sub rsp, 8` / `add rsp, 8` to land rsp%16==0 at the call site. Short-circuit: `cmp rbp, 16; ja rr_lk_miss` on entry (RR_NAME_MAX) avoids a scan with an oversize input. Per iteration: `lea r_, [rip + _rr_entries]; mov rax, r12; shl rax, 3; add r_, rax; mov r13, [r_+0]` (no scaled-index addressing form used -- stays in the pre-existing pdx encoder subset). Decode len via `shr 48` and offset via `and rN, 0xFFFF` (imm32 mask, in the pdx-accepted subset). Compare len to rbp; on mismatch, bump r12 and continue. On match, compute name_blob_ptr via `lea r_, [rip + _rr_name_blob]; add r_, offset`; call _rr_memcmp(rbx, r_, len) wrapped in the 8-byte pad. If equal (rax==1), return i in rax. If not, bump r12 and continue. On loop exhaustion, return RR_ID_NONE (0xFF). Encoder: mov / xor / shl / shr / and / cmp / je / jne / ja / jae / jmp / add / sub / lea / push / pop / call -- all pre-existing. Reserved-label discipline: rr_lk_ prefix.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;

        mov rbx, rdi;                      // name_ptr
        mov rbp, rsi;                      // name_len

        // Short-circuit: oversize names cannot match any entry.
        cmp rbp, 16;                       // RR_NAME_MAX
        ja  rr_lk_miss;

        xor r12, r12;                      // i = 0

      rr_lk_loop:
        cmp r12, 7;                        // RR_RENDERER_COUNT
        jae rr_lk_miss;

        // r13 = _rr_entries[i]
        lea r10, [rip + _rr_entries];
        mov rax, r12;
        shl rax, 3;                        // i * 8
        add r10, rax;
        mov r13, [r10 + 0];

        // entry_len = r13 >> 48; must equal name_len.
        mov rax, r13;
        shr rax, 48;
        cmp rax, rbp;
        jne rr_lk_next;

        // entry_offset = r13 & 0xFFFF  (imm32 mask).
        mov rcx, r13;
        and rcx, 0xFFFF;

        // name_blob_ptr = &_rr_name_blob + offset
        lea rdx, [rip + _rr_name_blob];
        add rdx, rcx;

        // call _rr_memcmp(name_ptr, blob_ptr, len) with 8-byte pad.
        mov rdi, rbx;
        mov rsi, rdx;
        mov rdx, rbp;
        sub rsp, 8;
        call _rr_memcmp;
        add rsp, 8;

        cmp rax, 1;
        jne rr_lk_next;

        // Match: return i in rax.
        mov rax, r12;
        jmp rr_lk_done;

      rr_lk_next:
        add r12, 1;
        jmp rr_lk_loop;

      rr_lk_miss:
        mov rax, 0xFF;                     // RR_ID_NONE

      rr_lk_done:
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }

  // =========================================================================
  // Section 5 -- _rr_name(renderer_id) -> {ptr48 | len_hi16} | 0
  // =========================================================================
  //
  // Reverse lookup.  Returns the packed `{name_ptr | len_hi16}`
  // 8-byte word for a valid id (0..6), or 0 for an out-of-range id
  // (>= RR_RENDERER_COUNT, including the 0xFF sentinel).
  //
  // The packed word's shape matches M3/M4's header-text pointers so a
  // diagnostic emitter can consume it with the same unpack idiom:
  //     ptr = word & ((1 << 48) - 1)  == (word << 16) >> 16 via idiom
  //     len = word >> 48
  //
  // Leaf; no callee-save pushes.
  //
  // SysV: rdi = renderer_id.  Return rax.
  pub let _rr_name : (u64) -> u64 !{sysreg, mem} @{} =
    fn (renderer_id: u64) -> unsafe {
      effects: {sysreg, mem},
      capabilities: {},
      justification: "R129.M5: reverse lookup from renderer id to packed {ptr48 | len16} word. Leaf -- no callee-save pushes, no nested calls -- so entry rsp%16==8 is untouched. Range check: `cmp rdi, 7; jae rr_name_zero` short-circuits any id outside 0..6 (including 0xFF). Load the entry word via `lea r_, [rip + _rr_entries]; shl rax, 3; add r_, rax; mov r_, [r_+0]`. Decode offset = entry & 0xFFFF, len = entry >> 48. Compute abs_ptr = &_rr_name_blob + offset (lea + add). Pack as (len << 48) | abs_ptr; the resulting word has len in bits 48..63 and ptr in bits 0..47 (the ptr always fits in 48 bits because the kernel code lives below the canonical 2^47 boundary). Encoder: mov / xor / shl / shr / and / cmp / jae / jmp / add / lea / or -- all pre-existing. Reserved-label discipline: rr_name_ prefix.",
      block: {
        cmp rdi, 7;                        // RR_RENDERER_COUNT
        jae rr_name_zero;

        // r11 = _rr_entries[id]
        lea r11, [rip + _rr_entries];
        mov rax, rdi;
        shl rax, 3;
        add r11, rax;
        mov r11, [r11 + 0];

        // offset = r11 & 0xFFFF
        mov rcx, r11;
        and rcx, 0xFFFF;

        // len = r11 >> 48
        mov rdx, r11;
        shr rdx, 48;

        // abs_ptr = &_rr_name_blob + offset
        lea rax, [rip + _rr_name_blob];
        add rax, rcx;

        // return (len << 48) | abs_ptr
        shl rdx, 48;
        or  rax, rdx;
        ret

      rr_name_zero:
        xor rax, rax;
        ret
      }
    }

  // =========================================================================
  // Section 6 -- _renderer_dispatch public entry
  // =========================================================================
  //
  //   _renderer_dispatch(renderer_id, tty_fd, data_ptr, data_len,
  //                      schema_ptr) -> errno
  //
  // SysV mapping:
  //     rdi = renderer_id        (0..6; 0xFF-safe)
  //     rsi = tty_fd             (forwarded to every backend)
  //     rdx = data_ptr           (renderer-specific; see 4.1 of doc)
  //     rcx = data_len           (packed per renderer; see 4.1)
  //     r8  = schema_ptr         (only used by schema; 0 otherwise)
  //
  // Per-renderer data_ptr / data_len / schema_ptr shape:
  //
  //   table    data_ptr = rows byte block (M3 layout)
  //            data_len = (row_count << 32) | col_count
  //            schema_ptr = column-descriptor ptr
  //
  //   kitty    data_ptr = RGBA pixel block
  //            data_len = (width << 32) | height
  //            schema_ptr = 0 (ignored)
  //
  //   schema   data_ptr = typed-record byte block
  //            data_len = record_count (low 32 bits)
  //            schema_ptr = schema descriptor ptr
  //
  //   raw      data_ptr = byte stream
  //            data_len = byte count
  //            schema_ptr = 0 (ignored)
  //
  //   plot     reserved; falls back through table
  //   json     reserved; falls back through raw
  //   csv      reserved; falls back through raw
  //
  // Fallback matrix (walked inline per renderer):
  //
  //     kitty  -> schema -> table -> raw
  //     schema -> table  -> raw
  //     table  -> raw
  //     plot   -> table  -> raw
  //     json   -> raw
  //     csv    -> raw
  //     raw    -> <terminal>
  //
  // Each transition's trigger is per-renderer:
  //
  //     kitty  : _kitty_graphics_available(tty_fd) == 0
  //     schema : schema_ptr == 0
  //     table  : data_ptr == 0 or (data_len & 0xFFFFFFFF) == 0
  //     plot   : backend not landed (always falls back at M5)
  //     json   : backend not landed (always falls back at M5)
  //     csv    : backend not landed (always falls back at M5)
  //     raw    : never falls back
  //
  // Return bands (disjoint across the whole substrate):
  //     RR_OK                  (0)
  //     RR_ERR_UNKNOWN         (0x1B00)  -- id >= 7 or == 0xFF
  //     RR_ERR_INCOMPATIBLE    (0x1B01)  -- cannot happen at M5
  //     AT_ERR_*               (0x1800..0x18FF) -- M3 passthrough
  //     SF_ERR_*               (0x1900..0x19FF) -- M4 passthrough
  //     KG_ERR_*               (0x1700..0x17FF) -- M2 passthrough
  //
  // Registers (6 callee-save pushes, rsp%16==8 steady; nested backend
  // calls take `sub rsp, 8` before and `add rsp, 8` after):
  //   rbx = renderer_id (current, mutated by fallback transitions)
  //   rbp = tty_fd
  //   r12 = data_ptr
  //   r13 = data_len
  //   r14 = schema_ptr
  //   r15 = flags (always 0 at M5; reserved for M7+ warn-fallback)
  pub let _renderer_dispatch : (u64, u64, u64, u64, u64) -> u64
                                !{sysreg, mem, PortIo}
                                @{paideia.port_io} =
    fn (renderer_id: u64) (tty_fd: u64) (data_ptr: u64)
       (data_len: u64) (schema_ptr: u64) -> unsafe {
      effects: {sysreg, mem, PortIo},
      capabilities: {paideia.port_io},
      justification: "R129.M5: public dispatch entry. 6 callee-save pushes (rbx=rid, rbp=tty_fd, r12=data_ptr, r13=data_len, r14=schema_ptr, r15=flags) -> rsp%16==8 steady (entry %16==8, +48 pushes = %16==8); each nested backend call wraps in `sub rsp, 8` / `add rsp, 8` to land %16==0 at the call site. Validation first: `cmp rbx, 7; jae rr_d_unknown` short-circuits an out-of-range or 0xFF id with RR_ERR_UNKNOWN. Then a `cmp rbx, N; je rr_d_<name>` ladder jumps to the per-renderer path. Fallback transitions are implicit: a path that cannot run jumps to the next renderer's path with rbx updated to the fallback id (so a trace that walks rbx reflects the final choice). The kitty path probes capabilities via `_kitty_graphics_available(tty_fd)`; a zero return falls through to rr_d_schema. The schema path tests schema_ptr != 0; else falls through to rr_d_table. The table path tests data_ptr != 0 AND (data_len low 32) != 0; else falls through to rr_d_raw. The raw path is terminal: a bytewise loop over data_ptr for the low-32-bit length via uart_putc. Backend calls preserve rbx/rbp/r12-r15 (SysV callee-save) so the fallback accounting is intact across them. Return paths: every backend's rax propagates verbatim; the dispatcher never masks a backend error. Encoder: mov / xor / shl / shr / and / cmp / je / jne / ja / jae / jbe / jmp / add / sub / lea / mov_b / push / pop / call -- all pre-existing. Reserved-label discipline: rr_d_ prefix (rr_d_table, rr_d_kitty, rr_d_schema, rr_d_raw, rr_d_plot, rr_d_json, rr_d_csv, rr_d_unknown, rr_d_done, rr_d_raw_loop).",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                      // renderer_id (mutable)
        mov rbp, rsi;                      // tty_fd
        mov r12, rdx;                      // data_ptr
        mov r13, rcx;                      // data_len (packed)
        mov r14, r8;                       // schema_ptr
        xor r15, r15;                      // flags = 0 (reserved)

        // --- Validation: id must be in 0..6 ---
        cmp rbx, 7;                        // RR_RENDERER_COUNT
        jae rr_d_unknown;

        // --- Jump ladder ---
        cmp rbx, 0;                        // RR_RENDERER_TABLE
        je  rr_d_table;
        cmp rbx, 1;                        // RR_RENDERER_KITTY
        je  rr_d_kitty;
        cmp rbx, 2;                        // RR_RENDERER_SCHEMA
        je  rr_d_schema;
        cmp rbx, 3;                        // RR_RENDERER_RAW
        je  rr_d_raw;
        cmp rbx, 4;                        // RR_RENDERER_PLOT
        je  rr_d_plot;
        cmp rbx, 5;                        // RR_RENDERER_JSON
        je  rr_d_json;
        cmp rbx, 6;                        // RR_RENDERER_CSV
        je  rr_d_csv;
        // Unreachable (jae covered it) -- defensive tail.
        jmp rr_d_unknown;

        // -------------------------------------------------------------
        //  rr_d_kitty: capability-gated image emit
        // -------------------------------------------------------------
      rr_d_kitty:
        // Probe: _kitty_graphics_available(tty_fd).
        mov rdi, rbp;
        sub rsp, 8;
        call _kitty_graphics_available;
        add rsp, 8;
        cmp rax, 0;
        je  rr_d_kitty_fallback;

        // Available: emit via _kitty_image_rgba(tty_fd, pixels, w, h).
        // data_len packed: width = r13 >> 32; height = r13 low 32 bits
        // (isolated via shl 32; shr 32 to dodge the imm32 sign-extend
        // hazard that would otherwise flip `and rN, 0xFFFFFFFF` into a
        // no-op mask).
        mov rdi, rbp;                      // tty_fd
        mov rsi, r12;                      // pixels_ptr
        mov rdx, r13;
        shr rdx, 32;                       // width
        mov rcx, r13;
        shl rcx, 32;
        shr rcx, 32;                       // height = low 32 bits
        sub rsp, 8;
        call _kitty_image_rgba;
        add rsp, 8;
        jmp rr_d_done;

      rr_d_kitty_fallback:
        // kitty -> schema (operator still sees structured data)
        mov rbx, 2;                        // RR_RENDERER_SCHEMA
        jmp rr_d_schema;

        // -------------------------------------------------------------
        //  rr_d_schema: schema-driven dispatch (M4)
        // -------------------------------------------------------------
      rr_d_schema:
        cmp r14, 0;
        je  rr_d_schema_fallback;

        // _schema_fmt_render(tty_fd, schema_ptr, records_ptr,
        //                    record_count, flags).
        // record_count = r13 low 32 bits via shl 32; shr 32 (dodges
        // the imm32 sign-extend hazard of `and rN, 0xFFFFFFFF`).
        mov rdi, rbp;                      // tty_fd
        mov rsi, r14;                      // schema_ptr
        mov rdx, r12;                      // records_ptr
        mov rcx, r13;
        shl rcx, 32;
        shr rcx, 32;                       // record_count
        mov r8,  r15;                      // flags (0)
        sub rsp, 8;
        call _schema_fmt_render;
        add rsp, 8;
        jmp rr_d_done;

      rr_d_schema_fallback:
        // schema -> table
        mov rbx, 0;                        // RR_RENDERER_TABLE
        jmp rr_d_table;

        // -------------------------------------------------------------
        //  rr_d_table: ANSI-256 tabular (M3)
        // -------------------------------------------------------------
      rr_d_table:
        cmp r12, 0;
        je  rr_d_table_fallback;
        mov rcx, r13;
        shl rcx, 32;
        shr rcx, 32;                       // col_count low 32
        cmp rcx, 0;
        je  rr_d_table_fallback;

        // _ansi256_table_render(tty_fd, rows_ptr, row_count,
        //                       cols_desc_ptr, col_count, flags).
        // row_count = r13 >> 32; col_count = r13 low 32 bits
        // (isolated via shl 32; shr 32 to dodge the imm32 sign-extend
        // hazard of `and rN, 0xFFFFFFFF`).
        mov rdi, rbp;                      // tty_fd
        mov rsi, r12;                      // rows_ptr
        mov rdx, r13;
        shr rdx, 32;                       // row_count
        mov rcx, r14;                      // cols_desc_ptr
        mov r8,  r13;
        shl r8,  32;
        shr r8,  32;                       // col_count
        mov r9,  r15;                      // flags (0)
        sub rsp, 8;
        call _ansi256_table_render;
        add rsp, 8;
        jmp rr_d_done;

      rr_d_table_fallback:
        // table -> raw
        mov rbx, 3;                        // RR_RENDERER_RAW
        jmp rr_d_raw;

        // -------------------------------------------------------------
        //  rr_d_plot: reserved; falls back to table
        // -------------------------------------------------------------
      rr_d_plot:
        mov rbx, 0;                        // RR_RENDERER_TABLE
        jmp rr_d_table;

        // -------------------------------------------------------------
        //  rr_d_json / rr_d_csv: reserved; fall back to raw
        // -------------------------------------------------------------
      rr_d_json:
        mov rbx, 3;                        // RR_RENDERER_RAW
        jmp rr_d_raw;

      rr_d_csv:
        mov rbx, 3;                        // RR_RENDERER_RAW
        jmp rr_d_raw;

        // -------------------------------------------------------------
        //  rr_d_raw: byte-stream passthrough via uart_putc
        // -------------------------------------------------------------
        // Loop i in 0..data_len_low32: uart_putc(data_ptr[i]).
        // Preserves rbx..r15 across uart_putc (SysV callee-save).
        // On entry data_ptr may be 0 if we fell through from the table
        // path with an empty frame; a zero data_len results in no
        // bytes emitted, which is the correct observable behaviour.
      rr_d_raw:
        xor rcx, rcx;                      // i = 0
        mov r9,  r13;
        shl r9,  32;
        shr r9,  32;                       // n = data_len low 32

      rr_d_raw_loop:
        cmp rcx, r9;
        jae rr_d_raw_done;

        mov r11, r12;
        add r11, rcx;
        xor rdi, rdi;
        mov_b rdi, [r11 + 0];              // byte in rdi for uart_putc

        // Save loop state across uart_putc.  rbx..r15 are SysV
        // callee-save and preserved by uart_putc, so rcx (loop index)
        // and r9 (length cache) -- both caller-save -- are the live
        // values clobbered by the call.  Spill them to the stack.
        // After 6 pushes rsp%16==8 steady; `sub rsp, 24` lands
        // rsp%16==0 at the call site (8 + 24 = 32, 32%16 == 0).
        // Layout: [rsp+0]=rcx, [rsp+8]=r9, [rsp+16]=pad.
        sub rsp, 24;
        mov [rsp + 0], rcx;
        mov [rsp + 8], r9;
        call uart_putc;
        mov rcx, [rsp + 0];
        mov r9,  [rsp + 8];
        add rsp, 24;

        add rcx, 1;
        jmp rr_d_raw_loop;

      rr_d_raw_done:
        xor rax, rax;                      // RR_OK (0)
        jmp rr_d_done;

        // -------------------------------------------------------------
        //  rr_d_unknown: id out of band
        // -------------------------------------------------------------
      rr_d_unknown:
        mov rax, 0x1B00;                   // RR_ERR_UNKNOWN

      rr_d_done:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }
}
