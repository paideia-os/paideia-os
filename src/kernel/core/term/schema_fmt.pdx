// src/kernel/core/term/schema_fmt.pdx -- Wave UMB-W18 R129.M4
//
// Schema-driven formatter (paideia-os#2607).
//
// Lands:  2026-10-14
//
// Overview
// ========
//
// R129.M1 (xtgettcap.pdx)      landed the DEC/VT capability probe.
// R129.M2 (kitty_graphics.pdx) landed the Kitty APC-G bitmap emitter.
// R129.M3 (ansi256_table.pdx)  landed the ANSI-256 tabular fallback.
//
// M4 sits a layer above M3: given a typed-record stream and a schema
// (per-field name, type, align, width, colour hint), it marshals each
// record into the packed byte-grid M3 consumes and dispatches to
// _ansi256_table_render.  The caller does NOT touch M3 directly.
//
// Dispatch is per-field, keyed on `field_type`:
//
//    SF_TYPE_U64 (1)    8-byte unsigned decimal   -> _sf_itoa_u64
//    SF_TYPE_I64 (2)    8-byte signed decimal      -> _sf_itoa_i64
//    SF_TYPE_STR (3)    8-byte {ptr48|len16}        -> inline copy
//    SF_TYPE_HEX (4)    8-byte "0x" + 16 hex chars  -> _sf_itoa_hex
//    SF_TYPE_HASH32 (5) 32-byte raw hash -> 64 hex  -> _sf_itoa_hash32
//    SF_TYPE_TSC (6)    8-byte TSC ticks            -> _sf_fmt_tsc
//                                                       ("<ms>.<frac3> ms"
//                                                        or "<ticks> t"
//                                                        if _tsc_hz == 0)
//
// A future wave will add SF_TYPE_IMAGE (7) that dispatches to M2's
// _kitty_image_rgba when the terminal advertises Kitty graphics and
// falls back to a `<WxH>` placeholder cell on an ANSI-256-only terminal.
// M4 reserves the type-id 7 for that landing and the formatter's
// dispatch ladder leaves a comment at that position; adding the case is
// a two-line change plus a Kitty-graphics capability probe at render
// time.
//
// The schema descriptor is 32 bytes per field, up to 32 fields.  The
// end of the schema is signalled by a sentinel field with
// `field_type == 0` (SF_TYPE_END) or by consuming all 32 slots:
//
//       offset  size  field              notes
//       -----   ----  ------------------  --------------------------
//          0    6     name_ptr (u48)      low-48-bit pointer
//          6    2     name_len (u16)      header text length
//          8    1     field_type (u8)     0 = END, 1..6 = SF_TYPE_*
//          9    1     align      (u8)     AT_ALIGN_LEFT/RIGHT/CENTER
//         10    2     width      (u16)    cell width, 1..32
//         12    2     color_hint (u16)    reserved for M5 colour wiring
//         14    2     pad        (u16)    (zero at caller)
//         16    8     reserved   [u8; 8]  reserved for M5+
//         24    8     pad        [u8; 8]  (zero at caller)
//
// The record stream is a flat byte block, record_count records, each
// `rec_stride` bytes wide, where `rec_stride` = sum of per-type
// in-record sizes:
//
//       SF_TYPE_U64     -> 8  bytes
//       SF_TYPE_I64     -> 8  bytes
//       SF_TYPE_STR     -> 8  bytes (ptr48|len16 packed)
//       SF_TYPE_HEX     -> 8  bytes
//       SF_TYPE_HASH32  -> 32 bytes
//       SF_TYPE_TSC     -> 8  bytes
//
// R135.M4 (paideia-os#2629) will land the typed-record stream helper
// that produces exactly this layout.  Shells and daemons that already
// own typed records (jobs, perf-sink, trace-stream) can feed them
// directly without a conversion pass -- see design/shell/schema-driven-
// formatter.md section 7 for the producer-side recipe.
//
// Scope at M4
// -----------
//   * dispatch over the six base types above
//   * marshal into M3's packed-row byte grid (sum-of-widths stride)
//   * one monolithic render call per invocation (M3 is monolithic)
//   * cap: SF_MAX_FIELDS = 32, SF_MAX_RECORDS = 128,
//     SF_MAX_CELL_WIDTH = 32
//   * same AT_FLAG_* flags; this wave forwards them unchanged to M3
//
// Explicit non-scope at M4
// ------------------------
//   * no SF_TYPE_IMAGE dispatch (future wave; see M2 interaction note)
//   * no proportional / auto-fit widths; caller sizes each column
//   * no truncation glyph; over-long cells are hard-cut at `width`
//   * no multi-line cells; one glyph row per record
//   * no streaming / incremental render; the renderer marshals the
//     full packed grid before calling M3
//   * no per-field fg/bg SGR emission; `color_hint` is reserved for M5
//
// See design/shell/schema-driven-formatter.md for the full contract.
//
// Encoder-pitfall notes
// ---------------------
//   * no `test rN, rN` -- always `cmp rN, 0; j{e,ne}`
//   * no 2-op `imul rN, imm` -- reg-reg `imul rN, rN` only
//   * no `and rN, imm64` -- every mask fits in imm8 or imm32
//   * labels prefixed `sfu_` / `sfi_` / `sfh_` / `sfhh_` / `sft_` /
//     `sfp_` / `sfd_` / `sfbc_` / `sfr_` to avoid collisions with
//     sibling-module labels (M3's `at_` family, M2's `kg_` family,
//     M1's `xt_` family) and to avoid pdx reserved keywords
//     (`loop`, `if`, `let`, `fn`, `else`, ...)
//   * module basename `SchemaFmt` matches `schema_fmt.pdx`
//   * single-line `pub let X : T = ...`
//   * every RIP-relative load is `lea rN, [rip + sym]` followed by a
//     byte-wise `mov_b` / wide `mov` through rN
//   * cross-module references (`_tsc_hz`, `_ansi256_table_render`)
//     resolve as RIP-relative; the linker emits R_X86_64_PC32

module SchemaFmt = structure {

  // =========================================================================
  // Section 1 -- public constants
  // =========================================================================

  // Return-status codes.  M4 owns the 0x19xx band; room above for
  // SF_ERR_BAD_FD, SF_ERR_IO, etc. at M5+.
  pub let SF_OK                   : u64 = 0
  pub let SF_ERR_SCHEMA_TOO_WIDE  : u64 = 0x1900
  pub let SF_ERR_UNKNOWN_TYPE     : u64 = 0x1901
  pub let SF_ERR_BAD_RECORD       : u64 = 0x1902

  // Field-type codes.  Type 0 is reserved as the end-of-schema sentinel.
  // Types 1..6 are the base dispatch set; type 7 is reserved for a
  // future SF_TYPE_IMAGE wave that will route to M2's Kitty graphics
  // emitter.
  pub let SF_TYPE_END             : u64 = 0
  pub let SF_TYPE_U64             : u64 = 1
  pub let SF_TYPE_I64             : u64 = 2
  pub let SF_TYPE_STR             : u64 = 3
  pub let SF_TYPE_HEX             : u64 = 4
  pub let SF_TYPE_HASH32          : u64 = 5
  pub let SF_TYPE_TSC             : u64 = 6

  // Dimension caps.  SF_MAX_FIELDS matches the schema descriptor's 32-
  // slot ceiling and lines up with M3's AT_MAX_COLS.  SF_MAX_RECORDS
  // matches M3's AT_MAX_ROWS so a worst-case schema can still consume
  // the full M3 budget.  SF_MAX_CELL_WIDTH keeps the row-scratch at
  // 128 * 32 * 32 = 128 KiB and bounds u64-decimal formatting (max
  // 20 digits) with slack for a sign and a unit suffix.
  pub let SF_MAX_FIELDS           : u64 = 32
  pub let SF_MAX_RECORDS          : u64 = 128
  pub let SF_MAX_CELL_WIDTH       : u64 = 32

  // Byte sizes of the descriptors.  SF_FIELD_DESC_BYTES mirrors the
  // on-the-wire layout documented at the top of this file.
  // SF_COL_DESC_BYTES tracks M3's descriptor stride.
  pub let SF_FIELD_DESC_BYTES     : u64 = 32
  pub let SF_COL_DESC_BYTES       : u64 = 16

  // HASH32 raw byte width.  Hard-wired at this wave; a parametric
  // SF_TYPE_HASHN can land later if needed.
  pub let SF_HASH32_BYTES         : u64 = 32

  // =========================================================================
  // Section 2 -- static scratch
  // =========================================================================

  // M3 column-descriptor table built from the schema.  32 fields x 16
  // bytes = 512 bytes.  Rebuilt per _schema_fmt_render call; never
  // read outside the call.
  pub let mut _sf_col_desc : [u8; 512] = uninit @align(16)

  // Packed-row byte scratch handed to M3.  128 records x 32 columns x
  // 32 bytes per cell = 131072 bytes.  Each row is laid out as a
  // tightly packed byte block of width `row_stride` (sum of per-column
  // widths); M3 reads cell n of row r at `row + r*row_stride + sum of
  // widths[0..n]`.  Space-pads fill short formatter outputs so cell
  // boundaries land exactly where M3 expects.
  pub let mut _sf_row_scratch : [u8; 131072] = uninit @align(16)

  // Decimal / hex itoa scratch.  32 bytes is enough for a 20-digit
  // u64 and for the 16-nibble buffer used by _sf_itoa_hex when
  // reversing the collection order.  Mirrors the M3 _at_dec_scratch
  // shape; isolated per module so sibling helpers never contend.
  pub let mut _sf_itoa_scratch : [u8; 32] = uninit @align(8)

  // =========================================================================
  // Section 3 -- _sf_space_pad(buf_ptr, start_off, width) -> ()
  // =========================================================================
  //
  // Writes 0x20 (' ') to buf_ptr[start_off..width].  No-op when
  // start_off >= width.  Leaf; no callee-save pushes.
  //
  // Called at the tail of every cell write to fill the gap between the
  // formatter's returned length and the column width M3 expects.
  pub let _sf_space_pad : (u64, u64, u64) -> () !{sysreg, mem} @{} =
    fn (buf_ptr: u64) (start_off: u64) (width: u64) -> unsafe {
      effects: {sysreg, mem},
      capabilities: {},
      justification: "R129.M4 (paideia-os#2607, Wave UMB-W18): space-pad helper. Leaf -- zero callee-save pushes, zero nested calls, no stack discipline needed; entry rsp%16==8 is untouched. Walks rsi (start_off) upward through rdx (width), storing 0x20 at rdi[i] each iteration. Guard `cmp rax, rdx; jae done` as the loop condition handles both the typical case (start < width) and the degenerate equal / exceeding case uniformly. Encoder: mov / cmp / jae / add / jmp / mov_b -- all pre-existing. Reserved-label discipline: sfp_ prefix.",
      block: {
        mov rax, rsi;
      sfp_loop:
        cmp rax, rdx;
        jae sfp_done;
        mov r10, rdi;
        add r10, rax;
        mov rcx, 0x20;
        mov_b [r10 + 0], rcx;
        add rax, 1;
        jmp sfp_loop;
      sfp_done:
        ret
      }
    }

  // =========================================================================
  // Section 4 -- _sf_itoa_u64(val, buf_ptr, buf_cap) -> len
  // =========================================================================
  //
  // Writes `val` as its unsigned decimal representation into `buf_ptr`,
  // MSB-first.  Returns the number of bytes written, capped at
  // `buf_cap`.  Zero prints as "0" (len=1).  When the natural length
  // exceeds buf_cap the output is MSB-first truncated to buf_cap chars.
  //
  // Mechanism: collect digits LSB-first into _sf_itoa_scratch via
  // `div rcx` with rcx=10, then copy MSB-first into the caller's
  // buffer.  No nested calls.
  //
  // Registers (6 callee-save pushes, rsp%16==8 steady):
  //   rbx = val (shifts to quot each iteration)
  //   rbp = buf_ptr
  //   r12 = buf_cap
  //   r13 = digit_count (collect phase) / preserved into emit phase
  //   r14 = out_idx (emit phase)
  //   r15 = scratch for byte load
  pub let _sf_itoa_u64 : (u64, u64, u64) -> u64 !{sysreg, mem} @{} =
    fn (val: u64) (buf_ptr: u64) (buf_cap: u64) -> unsafe {
      effects: {sysreg, mem},
      capabilities: {},
      justification: "R129.M4: unsigned-decimal itoa into a caller buffer. 6 callee-save pushes (rbx=val, rbp=buf_ptr, r12=buf_cap, r13=digit_count, r14=out_idx, r15=byte_scratch) -> entry rsp%16==8, +48 pushes -> %16==8 steady. No nested calls -- all work is loads, divs, mov_b stores, and jumps -- so no additional per-call stack pad is needed. Collect phase: `xor rdx,rdx; mov rax,rbx; mov rcx,10; div rcx` captures the next LSB digit in rdx; `add rdx,0x30` converts to ASCII; store at _sf_itoa_scratch[r13]; bump r13; replace rbx with the quotient; loop while rbx!=0 (runs at least once so val=0 produces a '0' digit). Emit phase walks out_idx 0 upward, loading scratch[r13-1-out_idx] and storing to buf_ptr[out_idx], stopping when either out_idx == buf_cap (truncate at caller width) or out_idx == digit_count (natural end). Return rax = out_idx (bytes actually written). Encoder: mov / xor / div / add / mov_b / lea / cmp / jne / jae / sub / jmp / push / pop -- all pre-existing. Reserved-label discipline: sfu_ prefix.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                      // val
        mov rbp, rsi;                      // buf_ptr
        mov r12, rdx;                      // buf_cap
        xor r13, r13;                      // digit_count = 0

      sfu_collect:
        xor rdx, rdx;
        mov rax, rbx;
        mov rcx, 10;
        div rcx;                           // rax = quot, rdx = rem
        add rdx, 0x30;                     // rem -> ASCII
        lea r10, [rip + _sf_itoa_scratch];
        add r10, r13;
        mov_b [r10 + 0], rdx;
        add r13, 1;
        mov rbx, rax;
        cmp rbx, 0;
        jne sfu_collect;

        xor r14, r14;                      // out_idx = 0
      sfu_emit:
        cmp r14, r12;
        jae sfu_done;
        cmp r14, r13;
        jae sfu_done;
        // src_idx = digit_count - 1 - out_idx
        mov rax, r13;
        sub rax, 1;
        sub rax, r14;
        lea r10, [rip + _sf_itoa_scratch];
        add r10, rax;
        xor r15, r15;
        mov_b r15, [r10 + 0];
        mov r11, rbp;
        add r11, r14;
        mov_b [r11 + 0], r15;
        add r14, 1;
        jmp sfu_emit;

      sfu_done:
        mov rax, r14;                      // return len
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }

  // =========================================================================
  // Section 5 -- _sf_itoa_i64(val, buf_ptr, buf_cap) -> len
  // =========================================================================
  //
  // Signed-decimal variant.  When val's bit 63 is set, writes '-' at
  // buf_ptr[0], negates val via `0 - val` (two's-complement), and
  // delegates the remaining digits to _sf_itoa_u64 writing at
  // buf_ptr+1 with buf_cap-1.  Returns the total length (sign byte
  // plus unsigned-digit count).  When buf_cap == 0 for the negative
  // branch, returns 0 (no room for even the sign).
  //
  // Registers (3 callee-save pushes, rsp%16==0 steady -> nested call
  // alignment satisfied):
  //   rbx = buf_ptr (and advances past the sign byte on the negative path)
  //   rbp = buf_cap
  //   r12 = val
  pub let _sf_itoa_i64 : (u64, u64, u64) -> u64 !{sysreg, mem} @{} =
    fn (val: u64) (buf_ptr: u64) (buf_cap: u64) -> unsafe {
      effects: {sysreg, mem},
      capabilities: {},
      justification: "R129.M4: signed-decimal itoa. 3 callee-save pushes (rbx=buf_ptr-advancing, rbp=buf_cap-decrementing, r12=val) -> rsp%16==0 steady state (entry %16==8, +24 pushes -> %16==0). Nested call to _sf_itoa_u64 therefore needs no extra pad. Sign test uses bit-63 trick (`shr rax, 63; cmp rax, 0; jne negative`) rather than signed `jl` so we never leave the proven unsigned-compare subset. Negative branch: `cmp rbp, 0; je zero_cap` returns 0 when the caller sized the cell too tightly to even hold '-'; otherwise emits '-' (0x2D) at rbx[0], bumps rbx, decrements rbp, computes `0 - val` into r12 via `xor rax,rax; sub rax,r12; mov r12,rax` (avoids any encoder-fragile `neg` form), then calls _sf_itoa_u64(r12, rbx, rbp) and returns rax+1 to include the sign. Positive branch: direct passthrough. Encoder: mov / xor / shr / cmp / je / jne / sub / add / mov_b / push / pop / call / jmp -- all pre-existing. Reserved-label discipline: sfi_ prefix.",
      block: {
        push rbx;
        push rbp;
        push r12;

        mov r12, rdi;                      // val
        mov rbx, rsi;                      // buf_ptr
        mov rbp, rdx;                      // buf_cap

        // Negative?  Test bit 63 via unsigned shift.
        mov rax, r12;
        shr rax, 63;
        cmp rax, 0;
        je  sfi_pos;

        // Negative path: emit '-' + unsigned(-val).
        cmp rbp, 0;
        je  sfi_zero_cap;
        mov r10, rbx;
        mov rax, 0x2D;                     // '-'
        mov_b [r10 + 0], rax;
        add rbx, 1;
        sub rbp, 1;
        // r12 = 0 - r12  (two's-complement negate)
        xor rax, rax;
        sub rax, r12;
        mov r12, rax;

        mov rdi, r12;
        mov rsi, rbx;
        mov rdx, rbp;
        call _sf_itoa_u64;
        add rax, 1;                        // +1 for the sign byte
        jmp sfi_done;

      sfi_pos:
        mov rdi, r12;
        mov rsi, rbx;
        mov rdx, rbp;
        call _sf_itoa_u64;
        jmp sfi_done;

      sfi_zero_cap:
        xor rax, rax;

      sfi_done:
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }

  // =========================================================================
  // Section 6 -- _sf_itoa_hex(val, buf_ptr, buf_cap) -> len
  // =========================================================================
  //
  // Writes "0x" + 16 lowercase hex digits of `val` into `buf_ptr`,
  // MSB-first.  Natural length is always 18.  When buf_cap < 18 the
  // output is truncated from the right.  No `0x` suppression when
  // buf_cap < 2.
  //
  // Mechanism: collect 16 nibbles LSB-first into _sf_itoa_scratch via
  // `and 0xF; shr 4` per iteration, then emit "0x" and walk the
  // scratch in reverse, inline-converting each nibble to ASCII.
  //
  // Registers (6 callee-save pushes, rsp%16==8 steady):
  //   rbx = val (shifted right 4 per nibble)
  //   rbp = buf_ptr
  //   r12 = buf_cap
  //   r13 = out_idx (steps up to min(18, cap))
  //   r14 = nibble index (collect loop 0..15, emit loop 0..15)
  //   r15 = unused
  pub let _sf_itoa_hex : (u64, u64, u64) -> u64 !{sysreg, mem} @{} =
    fn (val: u64) (buf_ptr: u64) (buf_cap: u64) -> unsafe {
      effects: {sysreg, mem},
      capabilities: {},
      justification: "R129.M4: lowercase hex itoa with '0x' prefix. 6 callee-save pushes (rbx=val, rbp=buf, r12=cap, r13=out_idx, r14=nibble_idx, r15=unused) -> entry rsp%16==8, +48 pushes -> %16==8 steady. No nested calls -- the hex-digit lookup is inlined as `cmp 10; jb; add 0x30; else add 0x57`. Collect phase runs 16 iterations: `mov rax, rbx; and rax, 0xF` (imm8 OK) extracts a nibble, stored at _sf_itoa_scratch[nibble_idx]; `shr rbx, 4` advances the source. Emit phase guards on both the natural end (16 nibbles) and the caller cap, writing '0' then 'x' then nibble digits in reverse index order (scratch[15-nibble_idx]). The `0x` prefix is emitted inside the same out_idx accounting so caller caps < 2 drop the suffix cleanly. Encoder: mov / xor / and / shr / cmp / jae / jb / je / jmp / add / sub / lea / mov_b / push / pop -- all pre-existing. Reserved-label discipline: sfh_ prefix.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                      // val
        mov rbp, rsi;                      // buf_ptr
        mov r12, rdx;                      // buf_cap
        xor r13, r13;                      // out_idx = 0

        // Emit '0'.
        cmp r13, r12;
        jae sfh_done;
        mov r11, rbp;
        add r11, r13;
        mov rax, 0x30;
        mov_b [r11 + 0], rax;
        add r13, 1;

        // Emit 'x'.
        cmp r13, r12;
        jae sfh_done;
        mov r11, rbp;
        add r11, r13;
        mov rax, 0x78;
        mov_b [r11 + 0], rax;
        add r13, 1;

        // Collect 16 nibbles LSB-first into _sf_itoa_scratch.
        xor r14, r14;
      sfh_collect:
        cmp r14, 16;
        jae sfh_collect_done;
        mov rax, rbx;
        and rax, 0xF;
        lea r10, [rip + _sf_itoa_scratch];
        add r10, r14;
        mov_b [r10 + 0], rax;
        shr rbx, 4;
        add r14, 1;
        jmp sfh_collect;
      sfh_collect_done:

        // Emit from MSB nibble downward.
        xor r14, r14;
      sfh_emit:
        cmp r13, r12;
        jae sfh_done;
        cmp r14, 16;
        jae sfh_done;
        // src_idx = 15 - nibble_idx
        mov rax, 15;
        sub rax, r14;
        lea r10, [rip + _sf_itoa_scratch];
        add r10, rax;
        xor rax, rax;
        mov_b rax, [r10 + 0];
        // Inline hex-digit conversion.
        cmp rax, 10;
        jb  sfh_dec;
        add rax, 0x57;                     // 10 -> 'a' (0x61)
        jmp sfh_store;
      sfh_dec:
        add rax, 0x30;
      sfh_store:
        mov r11, rbp;
        add r11, r13;
        mov_b [r11 + 0], rax;
        add r13, 1;
        add r14, 1;
        jmp sfh_emit;

      sfh_done:
        mov rax, r13;                      // return bytes written
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }

  // =========================================================================
  // Section 7 -- _sf_itoa_hash32(src_ptr, buf_ptr, buf_cap) -> len
  // =========================================================================
  //
  // Writes up to 64 lowercase hex characters representing the 32-byte
  // hash at src_ptr, high-nibble first per byte.  Truncates from the
  // right when buf_cap < 64.  Returns bytes actually written.
  //
  // No "0x" prefix: hash columns are typically wide and the prefix
  // would consume two of the sixty-four significant chars.
  //
  // Registers (5 callee-save pushes, rsp%16==0 steady):
  //   rbx = src_ptr
  //   rbp = buf_ptr
  //   r12 = buf_cap
  //   r13 = out_idx
  //   r14 = i (byte index 0..32)
  pub let _sf_itoa_hash32 : (u64, u64, u64) -> u64 !{sysreg, mem} @{} =
    fn (src_ptr: u64) (buf_ptr: u64) (buf_cap: u64) -> unsafe {
      effects: {sysreg, mem},
      capabilities: {},
      justification: "R129.M4: 32-byte hash -> up to 64 lowercase hex characters. 5 callee-save pushes (rbx=src, rbp=buf, r12=cap, r13=out_idx, r14=byte_i) -> entry rsp%16==8, +40 pushes = %16==0 steady. No nested calls so no extra per-call pad is needed; however the %16==0 state also means that if a future wave adds one it is already alignment-ready. For each byte i in 0..32: load byte via `mov_b rax, [src+i]`; compute high nibble `mov rcx, rax; shr rcx, 4`; convert inline (`cmp 10; jb; add 0x30; else add 0x57`); store to buf[out_idx]; bump out_idx; same for low nibble (`and rax, 0xF`). Guard against buf_cap on each store so an odd cap (e.g. 15) writes exactly 15 hex chars (7 bytes' high nibble + 1 byte's low nibble + 7 more chars equivalently, by walking strictly byte-by-byte). Encoder: mov / xor / and / shr / cmp / jae / jb / je / jmp / add / mov_b / lea / push / pop -- all pre-existing. Reserved-label discipline: sfhh_ prefix.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;

        mov rbx, rdi;                      // src_ptr
        mov rbp, rsi;                      // buf_ptr
        mov r12, rdx;                      // buf_cap
        xor r13, r13;                      // out_idx
        xor r14, r14;                      // byte i

      sfhh_loop:
        cmp r14, 32;
        jae sfhh_done;
        cmp r13, r12;
        jae sfhh_done;

        // Load src byte.
        mov r11, rbx;
        add r11, r14;
        xor rax, rax;
        mov_b rax, [r11 + 0];

        // High nibble: rcx = rax >> 4.
        mov rcx, rax;
        shr rcx, 4;
        cmp rcx, 10;
        jb  sfhh_hi_dec;
        add rcx, 0x57;
        jmp sfhh_hi_store;
      sfhh_hi_dec:
        add rcx, 0x30;
      sfhh_hi_store:
        mov r11, rbp;
        add r11, r13;
        mov_b [r11 + 0], rcx;
        add r13, 1;

        cmp r13, r12;
        jae sfhh_done;

        // Low nibble.
        and rax, 0xF;
        cmp rax, 10;
        jb  sfhh_lo_dec;
        add rax, 0x57;
        jmp sfhh_lo_store;
      sfhh_lo_dec:
        add rax, 0x30;
      sfhh_lo_store:
        mov r11, rbp;
        add r11, r13;
        mov_b [r11 + 0], rax;
        add r13, 1;

        add r14, 1;
        jmp sfhh_loop;

      sfhh_done:
        mov rax, r13;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }

  // =========================================================================
  // Section 8 -- _sf_fmt_tsc(ticks, buf_ptr, buf_cap) -> len
  // =========================================================================
  //
  // Formats a TSC tick count as "<ms_int>.<frac3> ms" where frac3 is
  // zero-padded to exactly three digits.  Reads _tsc_hz (published by
  // src/kernel/core/time/tsc.pdx).  Fallback when _tsc_hz == 0:
  // emits "<ticks> t" using plain unsigned decimal of the raw tick
  // count, which keeps the diagnostic value visible even before TSC
  // calibration has completed (early-boot shell listings).
  //
  // Formula (ticks * 1_000_000) / tsc_hz computes microseconds; then
  // us / 1000 and us % 1000 split into integer ms and fractional ms.
  // Overflow bound: `ticks * 1_000_000` truncates at 2^63 / 10^6 ~=
  // 9.2e12 ticks (~ 3000 s at 3 GHz TSC) -- well above anything a
  // shell table legitimately prints.
  //
  // Registers (6 callee-save pushes + 8-byte scratch slot for the
  // tsc_hz-decode remainder, rsp%16==0 steady):
  //   rbx = ticks
  //   rbp = buf_ptr
  //   r12 = buf_cap
  //   r13 = out_idx (incremented after each append)
  //   r14 = _tsc_hz (loaded once at entry)
  //   r15 = us / scratch for intermediates
  //   [rsp + 0] = ms_frac working slot
  pub let _sf_fmt_tsc : (u64, u64, u64) -> u64 !{sysreg, mem} @{} =
    fn (ticks: u64) (buf_ptr: u64) (buf_cap: u64) -> unsafe {
      effects: {sysreg, mem},
      capabilities: {},
      justification: "R129.M4: TSC tick -> `<ms>.<frac3> ms` or `<ticks> t` fallback. 6 callee-save pushes + `sub rsp, 8` for a working ms_frac slot -> rsp%16==0 steady (entry %16==8, +48 pushes = %16==8, +8 scratch -> %16==0). Nested calls to _sf_itoa_u64 therefore need no extra pad. Fallback path (tsc_hz == 0): calls _sf_itoa_u64(ticks, buf, cap) to lay down the raw count, then appends ' t' via two cap-guarded mov_b stores. Calibrated path: `mov rax, ticks; mov rcx, 1_000_000; imul rax, rcx` is the proven reg-reg 2-op imul form (M3 cites `imul rax, r15` as proven); `xor rdx, rdx; div r14` yields microseconds; a second `div rcx` with rcx=1000 splits ms_int and ms_frac. ms_frac is stashed on the stack slot across the _sf_itoa_u64 call (which clobbers rdx), then its hundreds / tens / ones digits are extracted via two further `div rcx` passes with rcx=100 and rcx=10 (the raw remainder of each `div` is used before the next clobber). The trailing ' ms' suffix is three cap-guarded mov_b stores. All intermediate 64-bit products stay inside the ticks < 9.2e12 safe window. Encoder: mov / xor / and / shr / cmp / jae / je / jne / jmp / imul / div / add / mov_b / lea / push / pop / call -- all pre-existing. Reserved-label discipline: sft_ prefix.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;

        mov rbx, rdi;                      // ticks
        mov rbp, rsi;                      // buf_ptr
        mov r12, rdx;                      // buf_cap
        xor r13, r13;                      // out_idx

        // Load tsc_hz (published by src/kernel/core/time/tsc.pdx).
        mov r14, [rip + _tsc_hz];
        cmp r14, 0;
        jne sft_calibrated;

        // -------- Fallback: "<ticks> t" --------
        mov rdi, rbx;
        mov rsi, rbp;
        mov rdx, r12;
        call _sf_itoa_u64;
        mov r13, rax;

        cmp r13, r12;
        jae sft_done;
        mov r11, rbp;
        add r11, r13;
        mov rax, 0x20;                     // ' '
        mov_b [r11 + 0], rax;
        add r13, 1;

        cmp r13, r12;
        jae sft_done;
        mov r11, rbp;
        add r11, r13;
        mov rax, 0x74;                     // 't'
        mov_b [r11 + 0], rax;
        add r13, 1;
        jmp sft_done;

      sft_calibrated:
        // us = ticks * 1_000_000 / tsc_hz
        mov rax, rbx;
        mov rcx, 1000000;
        imul rax, rcx;                     // reg-reg 2-op imul (proven)
        xor rdx, rdx;
        div r14;                           // rax = us
        mov r15, rax;                      // save us

        // ms_int = us / 1000, ms_frac = us % 1000
        mov rax, r15;
        xor rdx, rdx;
        mov rcx, 1000;
        div rcx;                           // rax = ms_int, rdx = ms_frac
        mov [rsp + 0], rdx;                // stash frac for later

        // Emit ms_int via _sf_itoa_u64.
        mov rdi, rax;
        mov rsi, rbp;
        mov rdx, r12;
        call _sf_itoa_u64;
        mov r13, rax;

        // '.'
        cmp r13, r12;
        jae sft_done;
        mov r11, rbp;
        add r11, r13;
        mov rax, 0x2E;
        mov_b [r11 + 0], rax;
        add r13, 1;

        // Hundreds digit of ms_frac.
        mov r15, [rsp + 0];                // frac
        xor rdx, rdx;
        mov rax, r15;
        mov rcx, 100;
        div rcx;                           // rax = hundreds, rdx = remainder
        mov [rsp + 0], rdx;                // save remainder for tens+ones

        cmp r13, r12;
        jae sft_done;
        add rax, 0x30;
        mov r11, rbp;
        add r11, r13;
        mov_b [r11 + 0], rax;
        add r13, 1;

        // Tens digit of (ms_frac mod 100).
        mov r15, [rsp + 0];
        xor rdx, rdx;
        mov rax, r15;
        mov rcx, 10;
        div rcx;                           // rax = tens, rdx = ones
        mov [rsp + 0], rdx;                // save ones

        cmp r13, r12;
        jae sft_done;
        add rax, 0x30;
        mov r11, rbp;
        add r11, r13;
        mov_b [r11 + 0], rax;
        add r13, 1;

        // Ones digit.
        mov rax, [rsp + 0];

        cmp r13, r12;
        jae sft_done;
        add rax, 0x30;
        mov r11, rbp;
        add r11, r13;
        mov_b [r11 + 0], rax;
        add r13, 1;

        // ' '
        cmp r13, r12;
        jae sft_done;
        mov r11, rbp;
        add r11, r13;
        mov rax, 0x20;
        mov_b [r11 + 0], rax;
        add r13, 1;

        // 'm'
        cmp r13, r12;
        jae sft_done;
        mov r11, rbp;
        add r11, r13;
        mov rax, 0x6D;
        mov_b [r11 + 0], rax;
        add r13, 1;

        // 's'
        cmp r13, r12;
        jae sft_done;
        mov r11, rbp;
        add r11, r13;
        mov rax, 0x73;
        mov_b [r11 + 0], rax;
        add r13, 1;

      sft_done:
        mov rax, r13;
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }

  // =========================================================================
  // Section 9 -- _sf_fmt_cell(type, src, buf, width, flags) -> len
  // =========================================================================
  //
  // Per-cell dispatch.  Reads `type` and routes to the right formatter.
  // The six supported types all share the same (data_in, buf, cap) ->
  // len tail-call shape; SF_TYPE_STR is handled inline because its
  // input is a packed {ptr48|len16} word that no sibling formatter
  // consumes.
  //
  // `flags` is reserved; current wave forwards nothing from it to the
  // formatters (they share no SGR concerns, since all output is plain
  // ASCII / UTF-8 going into the row scratch).  A future wave may wire
  // AT_FLAG_NO_COLOR, AT_FLAG_ASCII, etc. through for per-type
  // behaviour (e.g. uppercase vs lowercase hex).
  //
  // SF_TYPE_HASH32 passes `src` directly (the 32 raw bytes live in the
  // record at that offset); every other type dereferences one 8-byte
  // word at `src`.
  //
  // Registers (5 callee-save pushes, rsp%16==0 steady):
  //   rbx = type
  //   rbp = src_ptr
  //   r12 = buf_ptr
  //   r13 = width (buf_cap)
  //   r14 = flags (reserved)
  pub let _sf_fmt_cell : (u64, u64, u64, u64, u64) -> u64
                          !{sysreg, mem} @{} =
    fn (field_type: u64) (src_ptr: u64) (buf_ptr: u64)
       (width: u64) (flags: u64) -> unsafe {
      effects: {sysreg, mem},
      capabilities: {},
      justification: "R129.M4: per-cell dispatcher. 5 callee-save pushes (rbx=type, rbp=src, r12=buf, r13=width, r14=flags) -> entry rsp%16==8, +40 pushes = %16==0 steady. Nested formatter calls therefore need no additional pad. A single `cmp rbx, N; je sfd_<name>` ladder dispatches types 1..6. SF_TYPE_STR is inlined because its argument is a packed {ptr48 | len16} 8-byte word and the byte-copy loop is small enough to avoid a dedicated helper; it uses the same ptr-unpacking idiom as M3's _at_emit_header_row (`shl rax,16; shr rax,16` for the low-48 ptr, `shr raw, 48` for the length). Unknown types fall through to `xor rax, rax` returning length 0 -- the caller should have caught this during the schema-validation pass, so this is a defence-in-depth tail. Encoder: mov / xor / and / shl / shr / cmp / je / jbe / jae / jmp / add / mov_b / push / pop / call -- all pre-existing. Reserved-label discipline: sfd_ prefix.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;

        mov rbx, rdi;                      // type
        mov rbp, rsi;                      // src
        mov r12, rdx;                      // buf
        mov r13, rcx;                      // width (= buf_cap)
        mov r14, r8;                       // flags (reserved)

        // Dispatch ladder.
        cmp rbx, 1;
        je  sfd_u64;
        cmp rbx, 2;
        je  sfd_i64;
        cmp rbx, 3;
        je  sfd_str;
        cmp rbx, 4;
        je  sfd_hex;
        cmp rbx, 5;
        je  sfd_hash32;
        cmp rbx, 6;
        je  sfd_tsc;
        // Future: SF_TYPE_IMAGE (7) -> dispatch to M2 _kitty_image_rgba.
        // Falls through to the defensive zero return for M4.
        xor rax, rax;
        jmp sfd_done;

      sfd_u64:
        mov rdi, [rbp + 0];
        mov rsi, r12;
        mov rdx, r13;
        call _sf_itoa_u64;
        jmp sfd_done;

      sfd_i64:
        mov rdi, [rbp + 0];
        mov rsi, r12;
        mov rdx, r13;
        call _sf_itoa_i64;
        jmp sfd_done;

      sfd_str:
        // raw = *(u64*)src; ptr = raw lo48; slen = raw hi16.
        mov rax, [rbp + 0];
        mov rcx, rax;
        shl rax, 16;
        shr rax, 16;                       // rax = ptr (48-bit)
        shr rcx, 48;                       // rcx = slen
        // len = min(slen, width)
        cmp rcx, r13;
        jbe sfd_str_use_slen;
        mov rcx, r13;
      sfd_str_use_slen:
        xor r9, r9;                        // i = 0
      sfd_str_loop:
        cmp r9, rcx;
        jae sfd_str_end;
        mov r11, rax;
        add r11, r9;
        xor r10, r10;
        mov_b r10, [r11 + 0];
        mov r11, r12;
        add r11, r9;
        mov_b [r11 + 0], r10;
        add r9, 1;
        jmp sfd_str_loop;
      sfd_str_end:
        mov rax, rcx;                      // bytes copied
        jmp sfd_done;

      sfd_hex:
        mov rdi, [rbp + 0];
        mov rsi, r12;
        mov rdx, r13;
        call _sf_itoa_hex;
        jmp sfd_done;

      sfd_hash32:
        mov rdi, rbp;                      // src = raw bytes
        mov rsi, r12;
        mov rdx, r13;
        call _sf_itoa_hash32;
        jmp sfd_done;

      sfd_tsc:
        mov rdi, [rbp + 0];
        mov rsi, r12;
        mov rdx, r13;
        call _sf_fmt_tsc;
        jmp sfd_done;

      sfd_done:
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }

  // =========================================================================
  // Section 10 -- _sf_build_col_desc(schema_ptr, field_count) -> ()
  // =========================================================================
  //
  // Walks the schema and lays down M3's 16-byte column descriptor per
  // field into _sf_col_desc.
  //
  // Mapping (per field i in 0..field_count):
  //
  //    M3 row 0 (bytes [0..8]) = schema[0..8]
  //        -- the schema and M3 share the same {ptr48 | len16} layout,
  //           so this is a straight 8-byte copy.
  //
  //    M3 row 1 (bytes [8..16]):
  //        [0..2]  width (u16, from schema[10..12])
  //        [2..4]  align (u16, zero-widened from schema[9])
  //        [4..6]  reserved (zero at M4; color_hint pass-through lands
  //                 at M5+ when M3 starts honouring per-column fg/bg)
  //        [6..8]  reserved
  //
  // Registers (3 callee-save pushes, rsp%16==0 steady; no nested calls
  // but the trailing _schema_fmt_render -> _ansi256_table_render path
  // reads this scratch so the function must complete before that call):
  //   rbx = schema_ptr
  //   rbp = field_count
  //   r12 = i (0..field_count)
  pub let _sf_build_col_desc : (u64, u64) -> () !{sysreg, mem} @{} =
    fn (schema_ptr: u64) (field_count: u64) -> unsafe {
      effects: {sysreg, mem},
      capabilities: {},
      justification: "R129.M4: build M3 column descriptor from the schema. 3 callee-save pushes (rbx=schema, rbp=field_count, r12=i) -> rsp%16==0 steady (entry %16==8, +24 pushes = %16==0). No nested calls so no extra pad required. Per iteration: compute `r11 = schema + i*32` (`shl rax, 5` for *32), compute `r10 = _sf_col_desc + i*16` (`shl rax, 4` for *16, rooted via `lea r10, [rip + _sf_col_desc]`); copy `[r11 + 0]` to `[r10 + 0]` (the shared ptr48|len16 word); then build the width|align word by extracting `[r11 + 8]`'s width (bits 16..31) and align (bits 8..15), re-packing as width lo16 | align hi16 << 16 and storing to `[r10 + 8]`. The `shr .. 16; and .. 0xFFFF` and `shr .. 8; and .. 0xFF; shl .. 16; or` idioms mirror M3's _at_emit_header_row descriptor decode exactly. Encoder: mov / xor / and / shl / shr / cmp / jae / jmp / add / lea / or / push / pop -- all pre-existing. Reserved-label discipline: sfbc_ prefix.",
      block: {
        push rbx;
        push rbp;
        push r12;

        mov rbx, rdi;                      // schema_ptr
        mov rbp, rsi;                      // field_count
        xor r12, r12;                      // i = 0

      sfbc_loop:
        cmp r12, rbp;
        jae sfbc_done;

        // src = schema + i * 32
        mov rax, r12;
        shl rax, 5;                        // * 32
        mov r11, rbx;
        add r11, rax;

        // dst = _sf_col_desc + i * 16
        mov rax, r12;
        shl rax, 4;                        // * 16
        lea r10, [rip + _sf_col_desc];
        add r10, rax;

        // Row 0: direct copy of {name_ptr lo48 | name_len hi16}.
        mov rax, [r11 + 0];
        mov [r10 + 0], rax;

        // Row 1: build {width lo16 | align hi16 << 16}.
        mov rax, [r11 + 8];
        mov rcx, rax;
        shr rcx, 16;
        and rcx, 0xFFFF;                   // rcx = width
        mov rdx, rax;
        shr rdx, 8;
        and rdx, 0xFF;                     // rdx = align
        shl rdx, 16;
        mov rax, rcx;
        or  rax, rdx;
        mov [r10 + 8], rax;

        add r12, 1;
        jmp sfbc_loop;

      sfbc_done:
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }

  // =========================================================================
  // Section 11 -- _schema_fmt_render (public entry) -> errno
  // =========================================================================
  //
  // SysV register map:
  //     rdi = tty_fd        (forwarded to M3; this wave uses uart_putc)
  //     rsi = schema_ptr    (32-byte-per-field descriptor table)
  //     rdx = records_ptr   (packed byte block, rec_stride per record)
  //     rcx = record_count  (0..SF_MAX_RECORDS=128)
  //     r8  = flags         (AT_FLAG_* bit-mask, passed through to M3)
  //     ret = errno (SF_OK, SF_ERR_*, or an AT_ERR_* in the 0x18xx band
  //                 propagated from M3)
  //
  // Flow:
  //   1. Validate schema in a single pass: walk fields 0..32 until an
  //      SF_TYPE_END sentinel or the 32-slot ceiling is hit.  Per
  //      field: type must be 1..6; width must be 1..SF_MAX_CELL_WIDTH;
  //      otherwise return SF_ERR_UNKNOWN_TYPE or SF_ERR_SCHEMA_TOO_WIDE.
  //      Accumulate row_stride (sum widths) and rec_stride (sum per-
  //      type in-record sizes) during the same pass.
  //   2. Validate record_count <= SF_MAX_RECORDS and field_count > 0;
  //      else return SF_ERR_BAD_RECORD.
  //   3. Build the M3 column descriptor via _sf_build_col_desc.
  //   4. For each record r in 0..record_count: walk the schema again,
  //      dispatch each field via _sf_fmt_cell into
  //      _sf_row_scratch[r * row_stride + dst_off], then space-pad
  //      with _sf_space_pad to the full column width.
  //   5. Call _ansi256_table_render(tty_fd, _sf_row_scratch,
  //      record_count, _sf_col_desc, field_count, flags) and
  //      propagate its return value verbatim.
  //
  // Register map (6 callee-save pushes + 56-byte scratch, rsp%16==0
  // steady):
  //   rbx = schema_ptr
  //   rbp = records_ptr
  //   r12 = field_count (set during validation)
  //   r13 = row_stride  (set during validation)
  //   r14 = rec_stride  (set during validation)
  //   r15 = record_count
  //   [rsp +  0] = r (outer record idx)
  //   [rsp +  8] = f (inner field idx)
  //   [rsp + 16] = src_off (within current record)
  //   [rsp + 24] = dst_off (within current row)
  //   [rsp + 32] = tty_fd
  //   [rsp + 40] = flags
  //   [rsp + 48] = alignment pad (unused)
  pub let _schema_fmt_render : (u64, u64, u64, u64, u64) -> u64
                                !{sysreg, mem, PortIo}
                                @{paideia.port_io} =
    fn (tty_fd: u64) (schema_ptr: u64) (records_ptr: u64)
       (record_count: u64) (flags: u64) -> unsafe {
      effects: {sysreg, mem, PortIo},
      capabilities: {paideia.port_io},
      justification: "R129.M4: schema-driven formatter public entry. 6 callee-save pushes + `sub rsp, 56` for 7 slot scratch (r / f / src_off / dst_off / tty_fd / flags / pad) -> rsp%16==0 steady (entry %16==8, +48 pushes = %16==8, +56 scratch -> 112 total, 112%16==0). Nested calls (_sf_build_col_desc, _sf_fmt_cell, _sf_space_pad, _ansi256_table_render) therefore need no extra per-call pad. Validation pass sums widths into r13 (row_stride) and per-type in-record sizes into r14 (rec_stride) while walking schema[0..32] once, breaking on SF_TYPE_END (type==0); the per-type in-record size is 32 for SF_TYPE_HASH32 (type==5) and 8 for every other valid type, so a single `cmp .. 5; jne .. ; mov 32; else mov 8` branch suffices. The marshal loop re-walks the schema per record so that type/width extraction uses the same `[r11 + 8]` load path as validation; src and dst base pointers are recomputed inline each cell via reg-reg `imul rax, r14` (rec_stride) / `imul rax, r13` (row_stride) -- both are in M3's proven subset -- and the running src_off / dst_off live on the stack across nested calls which clobber the caller-save temps. After each _sf_fmt_cell call the length return value feeds _sf_space_pad to zero-fill the cell's tail with 0x20; width is re-extracted after each call since the caller-save r9 slot was clobbered. Error returns use pure jumps to the shared epilogue so the stack unwinds cleanly from any point. The trailing _ansi256_table_render call propagates both AT_OK (0) and any AT_ERR_* in the 0x18xx band back to the caller unchanged; the SF_* and AT_* bands do not overlap. Encoder: mov / xor / and / shl / shr / cmp / je / jne / ja / jae / jbe / jmp / add / sub / imul / lea / or / push / pop / call -- all pre-existing. Reserved-label discipline: sfr_ prefix.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 56;

        mov rbx, rsi;                      // schema_ptr
        mov rbp, rdx;                      // records_ptr
        mov r15, rcx;                      // record_count
        mov [rsp + 32], rdi;               // tty_fd
        mov [rsp + 40], r8;                // flags
        xor r12, r12;                      // field_count = 0
        xor r13, r13;                      // row_stride = 0
        xor r14, r14;                      // rec_stride = 0

        // -------- Validation + stride computation --------
        xor rcx, rcx;                      // c = 0

      sfr_v_loop:
        cmp rcx, 32;                       // SF_MAX_FIELDS
        jae sfr_v_done;
        mov rax, rcx;
        shl rax, 5;                        // * 32
        mov r11, rbx;
        add r11, rax;
        mov rax, [r11 + 8];                // type|align|width|color|pad
        // Extract type (byte 0 of the word).
        mov rdx, rax;
        and rdx, 0xFF;
        cmp rdx, 0;
        je  sfr_v_done;                    // SF_TYPE_END sentinel
        cmp rdx, 6;
        ja  sfr_bad_type;
        // Extract width (bytes 2..3 of the word -> bits 16..31).
        mov r9, rax;
        shr r9, 16;
        and r9, 0xFFFF;
        cmp r9, 0;
        je  sfr_too_wide;
        cmp r9, 32;                        // SF_MAX_CELL_WIDTH
        ja  sfr_too_wide;
        // in_rec_size: 32 for HASH32 (type == 5); else 8.
        mov r10, 8;
        cmp rdx, 5;
        jne sfr_v_use_small;
        mov r10, 32;
      sfr_v_use_small:
        add r13, r9;                       // row_stride += width
        add r14, r10;                      // rec_stride += in_rec_size
        add r12, 1;                        // field_count++
        add rcx, 1;
        jmp sfr_v_loop;

      sfr_v_done:
        cmp r12, 0;
        je  sfr_bad_record;
        cmp r15, 128;                      // SF_MAX_RECORDS
        ja  sfr_bad_record;

        // -------- Build column descriptor --------
        mov rdi, rbx;
        mov rsi, r12;
        call _sf_build_col_desc;

        // -------- Marshal records --------
        xor rax, rax;
        mov [rsp + 0], rax;                // r = 0

      sfr_r_loop:
        mov rax, [rsp + 0];
        cmp rax, r15;
        jae sfr_r_done;

        xor rax, rax;
        mov [rsp + 8], rax;                // f = 0
        mov [rsp + 16], rax;               // src_off = 0
        mov [rsp + 24], rax;               // dst_off = 0

      sfr_f_loop:
        mov rax, [rsp + 8];
        cmp rax, r12;
        jae sfr_f_done;

        // schema[f*32] into r11
        mov rax, [rsp + 8];
        shl rax, 5;
        mov r11, rbx;
        add r11, rax;
        mov rax, [r11 + 8];                // type|align|width|...
        mov rdx, rax;
        and rdx, 0xFF;                     // type
        mov r9, rax;
        shr r9, 16;
        and r9, 0xFFFF;                    // width

        // src_ptr = records + r*rec_stride + src_off
        mov rax, [rsp + 0];
        imul rax, r14;                     // reg-reg (proven)
        mov r10, rbp;
        add r10, rax;
        mov rcx, [rsp + 16];
        add r10, rcx;
        mov rsi, r10;                      // rsi = src_ptr

        // dst_ptr = _sf_row_scratch + r*row_stride + dst_off
        mov rax, [rsp + 0];
        imul rax, r13;
        lea r10, [rip + _sf_row_scratch];
        add r10, rax;
        mov rcx, [rsp + 24];
        add r10, rcx;
        // _sf_fmt_cell(type=rdi, src=rsi, buf=rdx, width=rcx, flags=r8)
        mov rdi, rdx;                      // type
                                           // rsi = src_ptr (already set)
        mov rdx, r10;                      // dst
        mov rcx, r9;                       // width
        mov r8, [rsp + 40];                // flags
        call _sf_fmt_cell;
        // rax = length written

        // Space-pad: recompute dst and width (caller-save clobbered).
        mov rcx, [rsp + 8];
        mov r9, rcx;
        shl r9, 5;
        mov r11, rbx;
        add r11, r9;
        mov r10, [r11 + 8];
        mov r9, r10;
        shr r9, 16;
        and r9, 0xFFFF;                    // width

        mov r11, [rsp + 0];
        imul r11, r13;
        lea r10, [rip + _sf_row_scratch];
        add r10, r11;
        mov r11, [rsp + 24];
        add r10, r11;                      // dst_ptr

        mov rdi, r10;
        mov rsi, rax;                      // start_off = fmt_cell's len
        mov rdx, r9;                       // width
        call _sf_space_pad;

        // Compute in_rec_size and advance offsets.
        mov rcx, [rsp + 8];
        mov rax, rcx;
        shl rax, 5;
        mov r11, rbx;
        add r11, rax;
        mov rax, [r11 + 8];
        mov rdx, rax;
        and rdx, 0xFF;                     // type (reload)
        mov r9, rax;
        shr r9, 16;
        and r9, 0xFFFF;                    // width (reload)
        mov r10, 8;
        cmp rdx, 5;
        jne sfr_use_small_m;
        mov r10, 32;
      sfr_use_small_m:

        // src_off += in_rec_size
        mov rax, [rsp + 16];
        add rax, r10;
        mov [rsp + 16], rax;
        // dst_off += width
        mov rax, [rsp + 24];
        add rax, r9;
        mov [rsp + 24], rax;
        // f++
        mov rax, [rsp + 8];
        add rax, 1;
        mov [rsp + 8], rax;
        jmp sfr_f_loop;

      sfr_f_done:
        mov rax, [rsp + 0];
        add rax, 1;
        mov [rsp + 0], rax;
        jmp sfr_r_loop;

      sfr_r_done:
        // -------- Hand off to M3 --------
        mov rdi, [rsp + 32];               // tty_fd
        lea rsi, [rip + _sf_row_scratch];
        mov rdx, r15;                      // row_count
        lea rcx, [rip + _sf_col_desc];
        mov r8, r12;                       // col_count
        mov r9, [rsp + 40];                // flags
        call _ansi256_table_render;
        // rax holds M3's return (AT_OK or AT_ERR_* in 0x18xx).
        jmp sfr_epilogue;

      sfr_too_wide:
        mov rax, 0x1900;                   // SF_ERR_SCHEMA_TOO_WIDE
        jmp sfr_epilogue;

      sfr_bad_type:
        mov rax, 0x1901;                   // SF_ERR_UNKNOWN_TYPE
        jmp sfr_epilogue;

      sfr_bad_record:
        mov rax, 0x1902;                   // SF_ERR_BAD_RECORD
        jmp sfr_epilogue;

      sfr_epilogue:
        add rsp, 56;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }
}
