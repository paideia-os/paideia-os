// src/kernel/core/term/kitty_graphics.pdx -- Wave UMB-W16 R129.M2
//
// Kitty graphics protocol emitter (paideia-os#2605).
//
// Lands:  2026-10-13
//
// Overview
// ========
//
// The Kitty graphics protocol lets a terminal emulator display a
// bitmap image inline, inside the normal character grid, by wrapping
// the pixel bytes in a base64 payload inside an APC (Application
// Program Command) escape sequence that passes transparently through
// the character-cell line discipline.  The envelope is:
//
//     ESC '_' G <control-list> ; <base64-payload> ESC '\'
//
// where
//     ESC          = 0x1B
//     '_'          = 0x5F  (APC introducer; distinct from DCS 'P')
//     G            = 0x47  (Kitty "graphics" selector)
//     <control-list> = comma-separated key=value pairs
//                       (f=32 for 32-bit RGBA, s=W, v=H, a=T for
//                        transmit-and-display, m=0|1 for last/more-
//                        follows chunk)
//     ';'          = 0x3B  (separator between controls and payload)
//     <base64>     = standard RFC 4648 encoding of the pixel bytes,
//                    without padding at chunk boundaries
//     ESC '\'      = 0x1B 0x5C  (String Terminator / ST)
//
// Supported by iTerm2 >= 3.3, Kitty, WezTerm, Konsole >= 22.04, and
// Ghostty.  xterm itself does NOT support Kitty graphics (xterm has
// its own `tektronix` and `sixel` facilities instead); callers must
// gate the emission on a positive capability probe.
//
// R129.M1 (xtgettcap.pdx, Wave UMB-W15) landed the XTGETTCAP DCS
// round-trip helper.  M2 piggybacks on that primitive: the public
// probe `_kitty_graphics_available` queries the `RGB` cap (which
// every known Kitty-graphics-supporting terminal advertises) and
// treats the OK-with-nonzero-value response as a positive signal.
// See design/shell/kitty-graphics-emitter.md section 5 for the
// heuristic rationale and the deferred cap-name question.
//
// Scope
// -----
//   * emit a 32-bit RGBA bitmap, up to 1024x1024, as a stream of
//     APC chunks each carrying at most 4096 base64 bytes of payload
//   * base64-encode the raw bytes with the RFC 4648 '+/' alphabet,
//     without boundary padding (chunk boundaries are a multiple of
//     3 raw bytes except possibly the last, which emits 2 or 3
//     chars for a 1 or 2 byte tail)
//   * drive uart_putc directly for every byte; tty_fd is accepted
//     but not dispatched (parity with xtgettcap.pdx's M1 contract)
//
// Explicit non-scope at M2
// ------------------------
//   * no image placement options (z-index, cursor move, auto-
//     dismiss).  Every image displays at the current cursor and the
//     cursor advances by the image's cell footprint, as per the
//     Kitty default.
//   * no diffs / animation.  Each call transmits a fresh image id;
//     a future wave can expose id control (i=<N>) and the follow-up
//     ops (a=f for frame, a=a for animation).
//   * no PNG / JPEG transmission (f=100 / f=24).  M2 is RGBA-only
//     (f=32); a future wave can add compressed-format passthrough.
//   * no tty_fd dispatch -- every byte funnels through uart_putc.
//
// See design/shell/kitty-graphics-emitter.md for the full contract.
//
// Encoder-pitfall notes
// ---------------------
//   * no `test rN, rN` -- always `cmp rN, 0; j{e,ne}`
//   * no 2-op `imul rN, imm`  (2-op `imul rN, rN` reg-reg is fine)
//   * no `and rN, imm64`      -- all masks fit in imm32 (0xFF, 0x3F, ...)
//   * labels prefixed `kg_` / `kgb_` / `kgd_` / `kge_` / `kgi_` /
//     `kga_` to avoid collisions with sibling-module labels and
//     pdx reserved keywords (loop, if, let, fn, ...)
//   * module basename `KittyGraphics` matches `kitty_graphics.pdx`
//   * single-line `pub let X : T = ...`
//   * cross-module symbols (uart_putc, _xtgettcap_probe) accessed as
//     direct RIP-relative calls; linker resolves

module KittyGraphics = structure {
  // =========================================================================
  // Section 1 -- public constants
  // =========================================================================

  // Return-status codes.  M2 bands them in 0x17xx; the band is otherwise
  // unused and leaves room for KG_ERR_IO, KG_ERR_BAD_FORMAT, etc. at
  // R129.M3+.
  pub let KG_OK                   : u64 = 0
  pub let KG_ERR_UNSUPPORTED      : u64 = 0x1700
  pub let KG_ERR_IMAGE_TOO_LARGE  : u64 = 0x1701
  pub let KG_ERR_BAD_DIMENSIONS   : u64 = 0x1702

  // Pixel format: 32-bit RGBA.  Four bytes per pixel.
  pub let KG_BYTES_PER_PIXEL : u64 = 4

  // Dimension cap -- 1024 x 1024 pixels.  Max raw image = 4 MiB.
  //
  // The ceiling exists for two reasons: (a) tty-line budget -- a
  // single frame at 1024x1024 is ~5.5 MiB of base64 over the UART
  // and already comes close to multi-second emit times at 115200
  // baud; (b) implementation safety -- the chunk index is a u64 but
  // we have never exercised the emitter beyond ~10 MiB payloads, so
  // we keep the cap conservative at M2.  Lifting it is a one-line
  // change here plus a design-doc update.
  pub let KG_MAX_DIM : u64 = 1024

  // Chunk sizing.
  //
  // The Kitty protocol caps a single APC payload at 4096 base64
  // characters (per the official spec; some terminals accept
  // more but 4096 is the portable floor).  Each chunk encodes
  // KG_CHUNK_RAW raw bytes which produce exactly KG_CHUNK_B64
  // base64 characters (3 raw -> 4 b64, so 3072 raw -> 4096 b64).
  // The final chunk may be shorter and may contain a 1- or 2-byte
  // partial-group tail that encodes to 2 or 3 characters (no '='
  // padding on the wire, per the Kitty protocol's chunk-boundary
  // rule).
  pub let KG_CHUNK_RAW : u64 = 3072
  pub let KG_CHUNK_B64 : u64 = 4096

  // APC envelope bytes.
  pub let KG_ESC    : u64 = 0x1B      // ESC
  pub let KG_APC    : u64 = 0x5F      // '_'
  pub let KG_SEL_G  : u64 = 0x47      // 'G' -- Kitty graphics selector
  pub let KG_SEMI   : u64 = 0x3B      // ';' -- control/payload separator
  pub let KG_ST     : u64 = 0x5C      // '\\' -- String Terminator tail

  // =========================================================================
  // Section 2 -- static buffers (.bss) and immutable tables
  // =========================================================================

  // RFC 4648 base64 alphabet: A-Z (0..25), a-z (26..51), 0-9 (52..61),
  // '+' (62), '/' (63).  Immutable 64-byte lookup table; indexed by
  // the 6-bit sextet during encoding.
  pub let _kg_b64_table : [u8; 64] =
    "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

  // Capability name string used by _kitty_graphics_available.  Three
  // ASCII bytes "RGB" (not NUL-terminated; XTGETTCAP takes an explicit
  // length).  See design/shell/kitty-graphics-emitter.md section 5
  // for why we probe RGB rather than a bespoke `kitty-graphics` cap.
  pub let _kg_cap_rgb : [u8; 3] = "RGB"

  // Per-chunk base64 output scratch.  Sized to the maximum Kitty APC
  // payload (4096 bytes).  Overwritten each chunk; the emit loop
  // walks it byte-by-byte to the UART.
  pub let mut _kg_b64_chunk : [u8; 4096] = uninit @align(8)

  // Decimal-digit reversal scratch for _kg_tx_u64_dec.  32 bytes is
  // sufficient for any u64 (max 20 decimal digits); the extra margin
  // absorbs any future itoa-with-prefix growth without touching the
  // register-save layout.
  pub let mut _kg_dec_scratch : [u8; 32] = uninit @align(8)

  // Reserve the remainder of the directive-mandated 32 KiB scratch
  // envelope (32768 - 4096 - 32 = 28640 bytes).  Not consumed at M2;
  // reserved for a future wave's chunk-reassembly / diff staging slab.
  // Named `_kg_scratch` to leave the taxonomy open.
  pub let mut _kg_scratch : [u8; 28640] = uninit @align(8)

  // =========================================================================
  // Section 3 -- _kg_tx_byte(byte) -> ()
  // =========================================================================
  //
  // Single-byte TX shim over uart_putc.  Same shape as
  // term/xtgettcap.pdx::_xt_tx_byte -- isolated so a future wave can
  // route by tty_fd without touching the APC emitter body.
  //
  // SysV: rdi = byte on entry, passes straight through.
  pub let _kg_tx_byte : (u64) -> () !{sysreg, PortIo} @{paideia.port_io} =
    fn (byte: u64) -> unsafe {
      effects: {sysreg, PortIo},
      capabilities: {paideia.port_io},
      justification: "R129.M2 (paideia-os#2605, Wave UMB-W16): single-byte TX shim over uart_putc. SysV: rdi carries the byte through to uart_putc; no re-marshalling. `sub rsp,8; call uart_putc; add rsp,8` keeps rsp%16==0 at the nested call site (entry rsp%16==8 + 8-byte pad = rsp%16==0). No prologue needed; uart_putc preserves rbx and r12-r15. Mirrors term/xtgettcap.pdx::_xt_tx_byte exactly so the two modules share the same byte-emit shape; isolated per module so each can later gain its own fd-dispatch router without a cross-module edit.",
      block: {
        sub rsp, 8;
        call uart_putc;
        add rsp, 8;
        ret
      }
    }

  // =========================================================================
  // Section 4 -- _kg_tx_u64_dec(val) -> ()
  // =========================================================================
  //
  // Emits `val` as its unsigned decimal representation via _kg_tx_byte.
  // Zero prints as "0", not empty.  Max observed caller value at M2 is
  // 1024 (image dimensions), so wall-time is dominated by the uart_putc
  // round trips, not the itoa cost.
  //
  // Mechanism: collect digits LSB-first into _kg_dec_scratch via
  // repeated `div rcx` with rcx=10, then walk the scratch in reverse
  // to emit MSB-first.
  //
  // Registers:
  //   rbx = val (callee-save; div clobbers rax/rdx)
  //   r12 = digit count (callee-save; survives _kg_tx_byte call)
  //
  // Preserves (SysV callee-save): rbx, rbp, r12-r15.
  // Clobbers (SysV caller-save):  rax, rcx, rdx, rsi, rdi, r8-r11.
  pub let _kg_tx_u64_dec : (u64) -> () !{sysreg, PortIo} @{paideia.port_io} =
    fn (val: u64) -> unsafe {
      effects: {sysreg, PortIo},
      capabilities: {paideia.port_io},
      justification: "R129.M2 (paideia-os#2605, Wave UMB-W16): unsigned-decimal itoa + per-digit emit. 2-push callee-save prologue (rbx=val, r12=digit-count) -- entry rsp%16==8, +16 -> rsp%16==8 at steady state inside the function. Collect-phase loop uses `xor rdx,rdx; mov rax,rbx; mov rcx,10; div rcx` to pull one base-10 digit per iteration; stores remainder (0..9) + 0x30 into _kg_dec_scratch[r12] via mov_b, bumps r12, replaces rbx with the quotient, repeats until quotient==0 (always runs at least once, so val=0 produces one '0' digit). Emit-phase walks r12 downward; before each call `push r12` lands rsp%16==0 for uart_putc (via _kg_tx_byte, which is a +8-pad passthrough -- the inner call site inside _kg_tx_byte sees rsp%16==0 as required), `pop r12` restores %16==8. Encoder: mov / xor / div / add / mov_b / lea / cmp / je / jne / sub / jmp / push / pop / call -- all pre-existing.",
      block: {
        push rbx;
        push r12;

        mov rbx, rdi;                      // rbx = val
        xor r12, r12;                      // r12 = digit count

      kgd_collect:
        xor rdx, rdx;
        mov rax, rbx;
        mov rcx, 10;
        div rcx;                           // rax = quot, rdx = rem
        add rdx, 0x30;                     // rem -> ASCII digit
        lea r10, [rip + _kg_dec_scratch];
        add r10, r12;
        mov_b [r10 + 0], rdx;
        add r12, 1;
        mov rbx, rax;                      // val = quot
        cmp rbx, 0;
        jne kgd_collect;

      kgd_emit:
        cmp r12, 0;
        je  kgd_done;
        sub r12, 1;
        lea r10, [rip + _kg_dec_scratch];
        add r10, r12;
        xor rax, rax;
        mov_b rax, [r10 + 0];
        mov rdi, rax;
        push r12;                          // rsp%16==8 -> ==0, SysV-safe for call
        call _kg_tx_byte;
        pop r12;
        jmp kgd_emit;

      kgd_done:
        pop r12;
        pop rbx;
        ret
      }
    }

  // =========================================================================
  // Section 5 -- _kg_b64_encode_chunk(src, src_len, dst) -> u64
  // =========================================================================
  //
  // Encodes src[0..src_len) as RFC 4648 base64 into dst[0..out_len),
  // where
  //     out_len = 4 * (src_len / 3)                     if src_len % 3 == 0
  //     out_len = 4 * (src_len / 3) + 2                 if src_len % 3 == 1
  //     out_len = 4 * (src_len / 3) + 3                 if src_len % 3 == 2
  //
  // No '=' padding is emitted at chunk boundaries.  The Kitty graphics
  // protocol forbids inline padding inside a multi-chunk transmission;
  // the final chunk's last 1- or 2-byte tail becomes 2 or 3 characters
  // encoded from the available bits with zero fill.
  //
  // Returns the number of bytes written to dst.
  //
  // The encoder is a leaf: no nested calls, so no alignment pad is
  // needed.  Three callee-save pushes (rbx=src, r12=src_len, r13=dst)
  // give the body a stable base; the inner loop keeps i (src offset)
  // in rcx and j (dst offset) in r9, both caller-save (never crossed
  // by a nested call because there are none).
  //
  // Registers:
  //   rbx = src
  //   r12 = src_len
  //   r13 = dst
  //   rcx = i (src offset, step 3)
  //   r9  = j (dst offset, step 4 or variable)
  //   rax, rdx, rsi, rdi, r8, r10, r11 = scratch
  //
  // Preserves (SysV callee-save): rbx, rbp, r12-r15.
  // Clobbers (SysV caller-save):  rax, rcx, rdx, rsi, rdi, r8-r11.
  pub let _kg_b64_encode_chunk : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (src: u64) (src_len: u64) (dst: u64) -> unsafe {
      effects: {mem},
      capabilities: {},
      justification: "R129.M2 (paideia-os#2605, Wave UMB-W16): RFC 4648 base64 encoder, chunk-boundary-aware (no '=' padding on the wire). Leaf; 3-push callee-save prologue (rbx=src, r12=src_len, r13=dst) with no inner call so no alignment pad is required. Main loop processes groups of 3 raw bytes -> 4 base64 chars while (src_len - i) >= 3: loads b0,b1,b2 via zero-extend `xor rax,rax; mov_b rax, [r11+N]` into rsi/rdi/r8 (caller-save slots that only need to survive within one iteration body -- no nested call to clobber them). For each of four 6-bit sextets, computes the sextet in rax, uses `lea rdx, [rip + _kg_b64_table]; add rdx, rax; mov_b rax, [rdx+0]` as the 64-entry alphabet lookup, then stores the ASCII char at dst[j+K]. Advances rcx+=3, r9+=4. Tail handler (remaining 1 or 2 bytes): branches on `cmp r10, 1 / cmp r10, 2`; the 1-byte path emits two chars (sextets `b0>>2` and `(b0&3)<<4`), the 2-byte path emits three chars (sextets `b0>>2`, `((b0&3)<<4)|(b1>>4)`, `(b1&0xF)<<2`). Sextet math uses only shl/shr by imm, `and rN, imm8` masks (0x03, 0x0F, 0x3F), and `or rN, rN` -- all within the pdx encoder's proven subset. Lookup indices are naturally bounded to 0..63 by the sextet construction, so no explicit `and rN, 0x3F` is needed before the table add (kept for defense-in-depth on the first three sextets of the main loop). Return packs j (dst length) into rax at kgb_done. Encoder: mov / mov_b / lea / add / sub / shl / shr / and / or / xor / cmp / je / jne / jb / ja / jae / jbe / jmp / push / pop -- all pre-existing. Reserved-label discipline: kgb_ prefix.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                      // rbx = src
        mov r12, rsi;                      // r12 = src_len
        mov r13, rdx;                      // r13 = dst

        xor rcx, rcx;                      // i = 0 (src offset)
        xor r9, r9;                        // j = 0 (dst offset)

      kgb_main:
        // remaining = src_len - i
        mov r10, r12;
        sub r10, rcx;
        cmp r10, 3;
        jb  kgb_tail;

        // Load b0, b1, b2 (zero-extended, kept in rsi/rdi/r8).
        mov r11, rbx;
        add r11, rcx;

        xor rax, rax;
        mov_b rax, [r11 + 0];
        mov rsi, rax;                      // rsi = b0

        xor rax, rax;
        mov_b rax, [r11 + 1];
        mov rdi, rax;                      // rdi = b1

        xor rax, rax;
        mov_b rax, [r11 + 2];
        mov r8, rax;                       // r8  = b2

        // sextet 0 = b0 >> 2
        mov rax, rsi;
        shr rax, 2;
        and rax, 0x3F;                     // defense-in-depth
        lea rdx, [rip + _kg_b64_table];
        add rdx, rax;
        xor rax, rax;
        mov_b rax, [rdx + 0];
        mov r11, r13;
        add r11, r9;
        mov_b [r11 + 0], rax;

        // sextet 1 = ((b0 & 0x03) << 4) | ((b1 >> 4) & 0x0F)
        mov rax, rsi;
        and rax, 0x03;
        shl rax, 4;
        mov rdx, rdi;
        shr rdx, 4;
        and rdx, 0x0F;
        or  rax, rdx;
        and rax, 0x3F;
        lea rdx, [rip + _kg_b64_table];
        add rdx, rax;
        xor rax, rax;
        mov_b rax, [rdx + 0];
        mov r11, r13;
        add r11, r9;
        add r11, 1;
        mov_b [r11 + 0], rax;

        // sextet 2 = ((b1 & 0x0F) << 2) | ((b2 >> 6) & 0x03)
        mov rax, rdi;
        and rax, 0x0F;
        shl rax, 2;
        mov rdx, r8;
        shr rdx, 6;
        and rdx, 0x03;
        or  rax, rdx;
        and rax, 0x3F;
        lea rdx, [rip + _kg_b64_table];
        add rdx, rax;
        xor rax, rax;
        mov_b rax, [rdx + 0];
        mov r11, r13;
        add r11, r9;
        add r11, 2;
        mov_b [r11 + 0], rax;

        // sextet 3 = b2 & 0x3F
        mov rax, r8;
        and rax, 0x3F;
        lea rdx, [rip + _kg_b64_table];
        add rdx, rax;
        xor rax, rax;
        mov_b rax, [rdx + 0];
        mov r11, r13;
        add r11, r9;
        add r11, 3;
        mov_b [r11 + 0], rax;

        add rcx, 3;
        add r9, 4;
        jmp kgb_main;

      kgb_tail:
        // remaining = src_len - i, 0..2
        mov r10, r12;
        sub r10, rcx;
        cmp r10, 0;
        je  kgb_done;
        cmp r10, 1;
        je  kgb_tail1;

        // --- 2-byte tail: emit 3 chars ---
        mov r11, rbx;
        add r11, rcx;
        xor rax, rax;
        mov_b rax, [r11 + 0];
        mov rsi, rax;                      // b0
        xor rax, rax;
        mov_b rax, [r11 + 1];
        mov rdi, rax;                      // b1

        // sextet 0 = b0 >> 2
        mov rax, rsi;
        shr rax, 2;
        and rax, 0x3F;
        lea rdx, [rip + _kg_b64_table];
        add rdx, rax;
        xor rax, rax;
        mov_b rax, [rdx + 0];
        mov r11, r13;
        add r11, r9;
        mov_b [r11 + 0], rax;

        // sextet 1 = ((b0 & 0x03) << 4) | ((b1 >> 4) & 0x0F)
        mov rax, rsi;
        and rax, 0x03;
        shl rax, 4;
        mov rdx, rdi;
        shr rdx, 4;
        and rdx, 0x0F;
        or  rax, rdx;
        and rax, 0x3F;
        lea rdx, [rip + _kg_b64_table];
        add rdx, rax;
        xor rax, rax;
        mov_b rax, [rdx + 0];
        mov r11, r13;
        add r11, r9;
        add r11, 1;
        mov_b [r11 + 0], rax;

        // sextet 2 = (b1 & 0x0F) << 2
        mov rax, rdi;
        and rax, 0x0F;
        shl rax, 2;
        and rax, 0x3F;
        lea rdx, [rip + _kg_b64_table];
        add rdx, rax;
        xor rax, rax;
        mov_b rax, [rdx + 0];
        mov r11, r13;
        add r11, r9;
        add r11, 2;
        mov_b [r11 + 0], rax;

        add r9, 3;
        jmp kgb_done;

      kgb_tail1:
        // --- 1-byte tail: emit 2 chars ---
        mov r11, rbx;
        add r11, rcx;
        xor rax, rax;
        mov_b rax, [r11 + 0];
        mov rsi, rax;                      // b0

        // sextet 0 = b0 >> 2
        mov rax, rsi;
        shr rax, 2;
        and rax, 0x3F;
        lea rdx, [rip + _kg_b64_table];
        add rdx, rax;
        xor rax, rax;
        mov_b rax, [rdx + 0];
        mov r11, r13;
        add r11, r9;
        mov_b [r11 + 0], rax;

        // sextet 1 = (b0 & 0x03) << 4
        mov rax, rsi;
        and rax, 0x03;
        shl rax, 4;
        and rax, 0x3F;
        lea rdx, [rip + _kg_b64_table];
        add rdx, rax;
        xor rax, rax;
        mov_b rax, [rdx + 0];
        mov r11, r13;
        add r11, r9;
        add r11, 1;
        mov_b [r11 + 0], rax;

        add r9, 2;

      kgb_done:
        mov rax, r9;                       // return j (bytes written)
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // =========================================================================
  // Section 6 -- _kg_emit_chunk(b64_len, is_first, is_last,
  //                              width, height) -> ()
  // =========================================================================
  //
  // Emits one Kitty APC chunk to the UART.  Reads the base64 payload
  // from the module-scope _kg_b64_chunk static (0..b64_len bytes
  // long, pre-encoded by _kg_b64_encode_chunk).
  //
  // Wire format emitted:
  //
  //     is_first == 1:  ESC '_' G 'a=T,f=32,s=<W>,v=<H>,m=<F>;<b64>' ESC '\'
  //     is_first == 0:                       ESC '_' G 'm=<F>;<b64>' ESC '\'
  //
  // where <F> is '1' for "more chunks follow" (is_last==0) and
  // '0' for "this is the final chunk" (is_last==1).  The width and
  // height controls appear only on the first chunk; subsequent
  // chunks inherit them from the Kitty-side chunk-reassembly buffer
  // keyed by the implicit image id (we do not emit i=<N>; the
  // terminal auto-assigns an id and auto-dismisses on the final
  // chunk per `a=T` semantics).
  //
  // Registers (callee-save slots after 6-push prologue + 8-byte pad):
  //   rbx = b64_len
  //   rbp = is_first
  //   r12 = is_last
  //   r13 = width
  //   r14 = height
  //   r15 = i (payload emit loop index)
  //
  // 6 pushes + 8 pad -> rsp%16==0 at every nested call site.
  pub let _kg_emit_chunk : (u64, u64, u64, u64, u64) -> ()
                           !{sysreg, mem, PortIo} @{paideia.port_io} =
    fn (b64_len: u64) (is_first: u64) (is_last: u64)
       (width: u64) (height: u64) -> unsafe {
      effects: {sysreg, mem, PortIo},
      capabilities: {paideia.port_io},
      justification: "R129.M2 (paideia-os#2605, Wave UMB-W16): one Kitty APC chunk emission over uart_putc. 6 callee-save pushes (rbx=b64_len, rbp=is_first, r12=is_last, r13=width, r14=height, r15=i) + sub rsp,8 land rsp%16==0 at every nested _kg_tx_byte / _kg_tx_u64_dec call site (entry %16==8 + 48 pushes = %16==8, + 8 pad = %16==0). Opening: emits ESC '_' 'G' unconditionally. If rbp (is_first) != 0, emits the fixed control block `a=T,f=32,s=<W>,v=<H>,` with W/H expanded via _kg_tx_u64_dec. Every chunk emits `m=<flag>;` where flag is '1' when is_last==0 (more follows) and '0' when is_last==1 (final chunk) -- selected by `cmp r12, 0; jne kge_m0; mov rdi, 0x31; jmp kge_m; kge_m0: mov rdi, 0x30; kge_m: call _kg_tx_byte`. Payload loop: xor r15,r15; while r15 < rbx, load _kg_b64_chunk[r15] via `lea; add; xor rax,rax; mov_b rax,[r+0]`, call _kg_tx_byte with it, bump r15. Closing: emits ESC '\\\\'. Encoder: mov / cmp / je / jne / jmp / jae / xor / lea / add / sub / mov_b / push / pop / call -- all pre-existing. Reserved-label discipline: kge_ prefix.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;                        // SysV alignment pad:
                                           //   entry rsp%16==8;
                                           //   +6 pushes = %16==8;
                                           //   +8 pad   = %16==0 for
                                           //   every direct nested call.

        mov rbx, rdi;                      // rbx = b64_len
        mov rbp, rsi;                      // rbp = is_first
        mov r12, rdx;                      // r12 = is_last
        mov r13, rcx;                      // r13 = width
        mov r14, r8;                       // r14 = height

        // ---- APC introducer: ESC '_' 'G' ----
        mov rdi, 0x1B;
        call _kg_tx_byte;
        mov rdi, 0x5F;
        call _kg_tx_byte;
        mov rdi, 0x47;
        call _kg_tx_byte;

        // ---- First-chunk control fields: a=T,f=32,s=<W>,v=<H>, ----
        cmp rbp, 0;
        je  kge_skip_first;

        // 'a=T,'
        mov rdi, 0x61;
        call _kg_tx_byte;
        mov rdi, 0x3D;
        call _kg_tx_byte;
        mov rdi, 0x54;
        call _kg_tx_byte;
        mov rdi, 0x2C;
        call _kg_tx_byte;

        // 'f=32,'
        mov rdi, 0x66;
        call _kg_tx_byte;
        mov rdi, 0x3D;
        call _kg_tx_byte;
        mov rdi, 0x33;
        call _kg_tx_byte;
        mov rdi, 0x32;
        call _kg_tx_byte;
        mov rdi, 0x2C;
        call _kg_tx_byte;

        // 's=<W>,'
        mov rdi, 0x73;
        call _kg_tx_byte;
        mov rdi, 0x3D;
        call _kg_tx_byte;
        mov rdi, r13;                      // width
        call _kg_tx_u64_dec;
        mov rdi, 0x2C;
        call _kg_tx_byte;

        // 'v=<H>,'
        mov rdi, 0x76;
        call _kg_tx_byte;
        mov rdi, 0x3D;
        call _kg_tx_byte;
        mov rdi, r14;                      // height
        call _kg_tx_u64_dec;
        mov rdi, 0x2C;
        call _kg_tx_byte;

      kge_skip_first:
        // ---- Always emit m=<flag> ----
        mov rdi, 0x6D;                     // 'm'
        call _kg_tx_byte;
        mov rdi, 0x3D;                     // '='
        call _kg_tx_byte;

        // flag: '0' if is_last!=0, '1' if is_last==0
        cmp r12, 0;
        jne kge_m0;
        mov rdi, 0x31;                     // '1' -> more follows
        jmp kge_m_emit;
      kge_m0:
        mov rdi, 0x30;                     // '0' -> final chunk
      kge_m_emit:
        call _kg_tx_byte;

        // ';'
        mov rdi, 0x3B;
        call _kg_tx_byte;

        // ---- Base64 payload ----
        xor r15, r15;                      // i = 0
      kge_payload:
        cmp r15, rbx;
        jae kge_payload_done;
        lea r10, [rip + _kg_b64_chunk];
        add r10, r15;
        xor rax, rax;
        mov_b rax, [r10 + 0];
        mov rdi, rax;
        call _kg_tx_byte;
        add r15, 1;
        jmp kge_payload;
      kge_payload_done:

        // ---- ESC '\\' (ST) ----
        mov rdi, 0x1B;
        call _kg_tx_byte;
        mov rdi, 0x5C;
        call _kg_tx_byte;

        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }

  // =========================================================================
  // Section 7 -- _kitty_graphics_available(tty_fd) -> u64
  // =========================================================================
  //
  // Returns 1 if the terminal appears to support Kitty graphics, 0
  // otherwise.
  //
  // Heuristic (see design/shell/kitty-graphics-emitter.md section 5):
  // probe the XTGETTCAP `RGB` capability via R129.M1's
  // `_xtgettcap_probe`.  The three mainstream Kitty-graphics-capable
  // terminals (iTerm2 >= 3.3, Kitty, WezTerm) ALL advertise the
  // RGB truecolor cap; terminals that do not advertise RGB (xterm
  // in its default build, foot, basic VT100 fallbacks) do not
  // implement Kitty graphics either.  The probe status XT_OK with
  // bytes_written > 0 is treated as the positive signal.
  //
  // This is a one-way inference, not a cryptographic proof: a
  // terminal that advertises RGB but does not implement Kitty
  // graphics (hypothetically; none known) would be a false positive.
  // A false positive is tolerable at M2 because the APC emit will
  // simply result in the terminal painting garbage or ignoring the
  // sequence; neither action breaks the kernel.  A direct
  // kitty-graphics capability probe (e.g. the `Terminal attributes`
  // DA3 report or a dedicated `kitty-graphics` XTGETTCAP cap name)
  // is deferred to R129.M3.
  //
  // Caller contract (identical to the probe's own):
  //     * TTY must be in raw mode so the XTGETTCAP response can be
  //       drained from _uart_rx_ring without being consumed by the
  //       cooked-mode line discipline.
  //
  // SysV: rdi = tty_fd (forwarded to _xtgettcap_probe).  Returns 1 or 0.
  pub let _kitty_graphics_available : (u64) -> u64
                                       !{sysreg, mem, PortIo}
                                       @{paideia.port_io} =
    fn (tty_fd: u64) -> unsafe {
      effects: {sysreg, mem, PortIo},
      capabilities: {paideia.port_io},
      justification: "R129.M2 (paideia-os#2605, Wave UMB-W16): Kitty graphics capability probe. Delegates to R129.M1 _xtgettcap_probe with cap=\"RGB\" (3 bytes), out_ptr=_kg_dec_scratch (reused -- itoa scratch is dead between invocations), out_cap=32. 1 push (rbx) lands rsp%16==0 at the probe call site (entry %16==8, +push rbx = %16==0). Return packing from the probe: (bytes_written << 32) | status; we decode status via `mov rdx, rax; shl rdx, 32; shr rdx, 32` (clears high half, zero-extended to leave status in rdx) and bytes_written via `shr rax, 32`. Returns 1 iff status==XT_OK (0) AND bytes_written>0; 0 otherwise. Encoder: mov / lea / shl / shr / cmp / je / jne / jmp / xor / push / pop / call -- all pre-existing. Note: rbx is pushed defensively to preserve tty_fd across the probe call for a future wave that would want to re-probe on an XT_ERR_MALFORMED-but-ESC-P-1 response; _xtgettcap_probe is SysV-callee-save-preserving so no spill is strictly needed at M2.",
      block: {
        push rbx;                          // entry rsp%16==8; +push -> %16==0

        mov rbx, rdi;                      // preserve tty_fd (unused post-probe
                                           // at M2 but reserved for a retry
                                           // call site in a later wave)

        mov rdi, rbx;                      // probe tty_fd (identity)
        lea rsi, [rip + _kg_cap_rgb];
        mov rdx, 3;
        lea rcx, [rip + _kg_dec_scratch];
        mov r8, 32;
        call _xtgettcap_probe;

        // rax = (bytes_written << 32) | status
        mov rdx, rax;
        shl rdx, 32;
        shr rdx, 32;                       // rdx = status
        cmp rdx, 0;                        // XT_OK
        jne kga_no_support;

        shr rax, 32;                       // rax = bytes_written
        cmp rax, 0;
        je  kga_no_support;

        mov rax, 1;
        jmp kga_done;

      kga_no_support:
        xor rax, rax;

      kga_done:
        pop rbx;
        ret
      }
    }

  // =========================================================================
  // Section 8 -- _kitty_image_rgba(tty_fd, pixels_ptr,
  //                                 width, height) -> u64 (errno)
  // =========================================================================
  //
  // Emits a 32-bit RGBA bitmap at (pixels_ptr .. pixels_ptr+W*H*4)
  // as a Kitty graphics APC stream.  Chunks the raw bytes at
  // KG_CHUNK_RAW (3072) per chunk, producing exactly KG_CHUNK_B64
  // (4096) base64 characters per chunk except possibly the final
  // chunk (which emits 2 or 3 chars for a 1- or 2-byte tail, no
  // padding).  The first chunk carries the control block
  // `a=T,f=32,s=<W>,v=<H>,m=<F>;`; subsequent chunks carry only
  // `m=<F>;`.  F is 1 for intermediate chunks and 0 for the final
  // chunk; the final-chunk 0 triggers the terminal to assemble and
  // display the image.
  //
  // SysV register map:
  //     rdi = tty_fd       (M2: forwarded identity, uart_putc only)
  //     rsi = pixels_ptr
  //     rdx = width        (1..1024)
  //     rcx = height       (1..1024)
  //     ret = errno (0 == KG_OK)
  //
  // Status taxonomy:
  //     KG_OK                     emission completed; the final
  //                                chunk's m=0 was emitted
  //     KG_ERR_BAD_DIMENSIONS     width==0 or height==0
  //     KG_ERR_IMAGE_TOO_LARGE    width>1024 or height>1024
  //
  // NOT returned at M2 (reserved for M3+):
  //     KG_ERR_UNSUPPORTED        the caller is expected to have
  //                                gated on _kitty_graphics_available
  //                                already; this helper does NOT
  //                                re-probe (saves 100 ms per emit).
  //
  // Register discipline (5 callee-save pushes = rsp%16==0 at steady
  // state inside the function body, matching every nested-call
  // alignment requirement without an extra pad):
  //     rbx = pixels_ptr
  //     rbp = width
  //     r12 = height
  //     r13 = total_bytes (= W * H * 4)
  //     r14 = offset       (bytes consumed so far from pixels_ptr)
  pub let _kitty_image_rgba : (u64, u64, u64, u64) -> u64
                               !{sysreg, mem, PortIo}
                               @{paideia.port_io} =
    fn (tty_fd: u64) (pixels_ptr: u64) (width: u64)
       (height: u64) -> unsafe {
      effects: {sysreg, mem, PortIo},
      capabilities: {paideia.port_io},
      justification: "R129.M2 (paideia-os#2605, Wave UMB-W16): Kitty graphics RGBA image emitter. 5 callee-save pushes (rbx=pixels, rbp=width, r12=height, r13=total_bytes, r14=offset) land rsp%16==0 at steady state (entry %16==8, +40 -> %16==0), so every nested _kg_b64_encode_chunk / _kg_emit_chunk call is pre-aligned with no extra pad. Validation: cmp rbp,0/je bad; cmp r12,0/je bad; cmp rbp,1024/ja too_large; cmp r12,1024/ja too_large -- rejects zero and over-cap dimensions before any byte hits the wire. total_bytes computed via `mov rax,rbp; imul rax,r12; shl rax,2` (2-op `imul rN,rN` reg-reg is in the proven subset per time/tsc.pdx L190; shl by 2 == *4 for the RGBA byte count). Chunk loop: while r14 < r13, compute bytes_this = min(KG_CHUNK_RAW=3072, r13-r14) in r9; call _kg_b64_encode_chunk(src=pixels+offset in rdi, len=bytes_this in rsi, dst=_kg_b64_chunk in rdx); rax = b64_len. Then recompute is_first (r14==0) in rsi, is_last (r13-r14<=3072, i.e. remaining fits in one chunk) in rdx; call _kg_emit_chunk(b64_len in rdi, is_first in rsi, is_last in rdx, width in rcx, height in r8). Advance r14 by bytes_this (recomputed from offset/total rather than stashed, since r9 is caller-save and we have no spare callee-save slot). Return: 0 (KG_OK), 0x1702 (KG_ERR_BAD_DIMENSIONS), or 0x1701 (KG_ERR_IMAGE_TOO_LARGE). Encoder: mov / cmp / je / jne / jb / jbe / ja / jae / jmp / xor / sub / add / shl / imul / lea / push / pop / call -- all pre-existing. Reserved-label discipline: kgi_ prefix.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;

        mov rbx, rsi;                      // rbx = pixels_ptr
        mov rbp, rdx;                      // rbp = width
        mov r12, rcx;                      // r12 = height

        // ---- Validate dimensions ----
        cmp rbp, 0;
        je  kgi_bad_dim;
        cmp r12, 0;
        je  kgi_bad_dim;
        cmp rbp, 1024;                     // KG_MAX_DIM
        ja  kgi_too_large;
        cmp r12, 1024;
        ja  kgi_too_large;

        // ---- total_bytes = width * height * 4 ----
        mov rax, rbp;
        imul rax, r12;                     // rax = W * H (reg-reg, OK)
        shl rax, 2;                        // rax *= 4
        mov r13, rax;                      // r13 = total_bytes

        xor r14, r14;                      // r14 = offset = 0

      kgi_chunk_loop:
        cmp r14, r13;
        jae kgi_ok;

        // bytes_this = min(KG_CHUNK_RAW=3072, remaining)
        mov r9, r13;
        sub r9, r14;                       // remaining
        mov r10, 3072;
        cmp r9, r10;
        jbe kgi_have_bytes;
        mov r9, r10;
      kgi_have_bytes:
        // r9 = bytes_this (lost after _kg_b64_encode_chunk call;
        //                   recomputed as needed below)

        // ---- Call _kg_b64_encode_chunk(src, len, dst) ----
        mov rdi, rbx;
        add rdi, r14;                      // src = pixels + offset
        mov rsi, r9;                       // len = bytes_this
        lea rdx, [rip + _kg_b64_chunk];
        call _kg_b64_encode_chunk;
        // rax = b64_len

        // ---- Prepare _kg_emit_chunk args ----
        // rdi = b64_len
        mov rdi, rax;

        // rsi = is_first (1 iff offset == 0)
        mov rsi, 0;
        cmp r14, 0;
        jne kgi_not_first;
        mov rsi, 1;
      kgi_not_first:

        // rdx = is_last (1 iff remaining <= 3072)
        mov rdx, 0;
        mov r10, r13;
        sub r10, r14;                      // remaining
        cmp r10, 3072;
        ja  kgi_not_last;
        mov rdx, 1;
      kgi_not_last:

        // rcx = width, r8 = height
        mov rcx, rbp;
        mov r8, r12;

        call _kg_emit_chunk;

        // ---- Advance offset by bytes_this (recomputed) ----
        mov r9, r13;
        sub r9, r14;
        mov r10, 3072;
        cmp r9, r10;
        jbe kgi_adv_small;
        mov r9, r10;
      kgi_adv_small:
        add r14, r9;
        jmp kgi_chunk_loop;

      kgi_ok:
        mov rax, 0;                        // KG_OK
        jmp kgi_epilogue;

      kgi_bad_dim:
        mov rax, 0x1702;                   // KG_ERR_BAD_DIMENSIONS
        jmp kgi_epilogue;

      kgi_too_large:
        mov rax, 0x1701;                   // KG_ERR_IMAGE_TOO_LARGE
        jmp kgi_epilogue;

      kgi_epilogue:
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }
}
