// src/kernel/core/semterm/plot.pdx -- R41.M3-001 (#1371)
//
// PLOT COMPOSITOR for the semantic terminal. Assembles a text-mode
// chart into a fixed 80x24 cell buffer by writing one glyph at a
// time. Every glyph is a Unicode code point (the buffer stays
// framebuffer-independent: a downstream frontend maps code points
// through its own font, and a byte-stream frontend re-encodes to
// UTF-8 at emit time).
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the CANVAS + PRIMITIVE PALETTE. plt_reset clears the canvas;
// plt_put writes one cell at (row, col); five higher-level primitives
// (plt_bar, plt_line, plt_dot, plt_heatmap, plt_sparkline) each
// synthesise a single glyph from a small ordinal input and forward to
// plt_put. Every primitive returns PLT_OK or a code from §3.
//
// Cell buffer geometry is FIXED at 80 x 24 = 1920 cells at reset.
// The R41.M3 witness driver draws inside this exact box; a later
// round that widens or narrows the geometry is a widening of this
// module's own constants -- not a caller-supplied argument -- and the
// downstream layout engine (semterm/layout.pdx) treats these
// dimensions as its own hard bound.
//
// A cell is a single u64:
//   bits  0..31   Unicode code point of the glyph (0 = empty cell)
//   bits 32..39   foreground palette index (0..15 refer to
//                 semterm/palette.pdx)
//   bits 40..47   background palette index (0..15)
//   bits 48..63   reserved (must be zero at reset)
//
// This module does NOT own the glyph inventory beyond the small set
// each primitive maps to; it does NOT rasterise; it does NOT emit
// bytes to a serial port or a framebuffer. Every consumer that walks
// the canvas re-reads through plt_get; there is no cursor state.
//
// It is a SCAFFOLD (D7): R41.M3 wires it into the witness tree but
// no live query drives it; plt_arbitrated() returns 0 until a later
// round hooks the semantic engine's result set into the compositor.
//
// =============================================================================
// §1  PRIMITIVE GLYPH TABLES
// =============================================================================
//
// bar (0..8):
//   0 -> U+0020 ' '
//   1..8 -> U+2581..U+2588 (lower one-eighth block through full block)
//
// line (0..10):
//   0  -> U+2500 '-'  horizontal
//   1  -> U+2502 '|'  vertical
//   2  -> U+250C corner NW
//   3  -> U+2510 corner NE
//   4  -> U+2514 corner SW
//   5  -> U+2518 corner SE
//   6  -> U+252C T-down
//   7  -> U+2534 T-up
//   8  -> U+251C T-right
//   9  -> U+2524 T-left
//   10 -> U+253C cross
//
// dot: single primitive with no argument -> U+00B7 middle dot.
//
// heatmap (0..8):
//   0    -> U+0020 ' '
//   1..2 -> U+2591 light shade
//   3..4 -> U+2592 medium shade
//   5..6 -> U+2593 dark shade
//   7..8 -> U+2588 full block
//
// sparkline (0..8): same mapping as bar; the caller draws a run of
// cells at one row and reads it as a line chart. The primitive is
// distinct from bar so the callers' intent survives review.
//
// A caller-supplied ordinal outside the documented range is REFUSED
// with PLT_ERR_BAD_LEVEL / PLT_ERR_BAD_KIND rather than silently
// clamped -- a downstream diff between the two shapes must stay
// visible.
//
// =============================================================================
// §2  ONE WRITER OF THE STATE
// =============================================================================
//
// _plt_buf and _plt_state are written only by helpers in this module.
// tools/build.sh confines relocations against each to
// `core/semterm/plot.o`.
//
// STATE LAYOUT -- _plt_state : [u64; 8]
//   +0    init_mark   0x9107 once plt_reset has run
//   +8    err         sticky error latch (first-writer-wins)
//   +16   rows        canvas rows (24 at reset)
//   +24   cols        canvas cols (80 at reset)
//   +32   writes      total plt_put calls since reset
//   +40   reserved
//   +48   reserved
//   +56   reserved
//
// BUFFER LAYOUT -- _plt_buf : [u64; 1920]  (= 24 rows * 80 cols)
//   cell(row, col) = _plt_buf[row * 80 + col]
//
// =============================================================================
// §3  FAILURE TAXONOMY 0xFFFFF080..0xFFFFF08F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time. Adjacent used
// band above: resultset 0xFFFFF090..9F (R41.M2-003). Adjacent free
// band below: layout 0xFFFFF070..7F (R41.M3-002).
//
//   PLT_OK             = 0
//   PLT_ERR_NOT_INIT   = 0xFFFFF08F   plt_put/get before plt_reset
//   PLT_ERR_BAD_ROW    = 0xFFFFF08E   row >= rows
//   PLT_ERR_BAD_COL    = 0xFFFFF08D   col >= cols
//   PLT_ERR_BAD_LEVEL  = 0xFFFFF08C   bar/heatmap/sparkline level > 8
//   PLT_ERR_BAD_KIND   = 0xFFFFF08B   line kind > 10
//   PLT_ERR_INTERNAL   = 0xFFFFF08A   unreachable-fallthrough tripwire
//
// =============================================================================
// §4  ARITY DISCIPLINE
// =============================================================================
//
// plt_put is (row, col, glyph, attrs) so every writeable cell field
// appears in the caller-visible arity. A widening (adding, say, a
// blink flag) is a widening of this arity, and the build.sh gate
// pins it -- a second writer against _plt_buf that smuggled the flag
// through would trip the confinement check.

module Plot = structure {

  // Canvas geometry (§0, §2).
  pub let PLT_ROWS      : u64 = 24
  pub let PLT_COLS      : u64 = 80
  pub let PLT_BUF_WORDS : u64 = 1920                // 24 * 80

  // Glyph code points (§1).
  pub let PLT_GLYPH_SPACE   : u64 = 0x0020
  pub let PLT_GLYPH_DOT     : u64 = 0x00B7
  pub let PLT_GLYPH_LIGHT   : u64 = 0x2591
  pub let PLT_GLYPH_MEDIUM  : u64 = 0x2592
  pub let PLT_GLYPH_DARK    : u64 = 0x2593
  pub let PLT_GLYPH_FULL    : u64 = 0x2588

  // Failure taxonomy (§3).
  pub let PLT_OK             : u64 = 0
  pub let PLT_ERR_NOT_INIT   : u64 = 0xFFFFF08F
  pub let PLT_ERR_BAD_ROW    : u64 = 0xFFFFF08E
  pub let PLT_ERR_BAD_COL    : u64 = 0xFFFFF08D
  pub let PLT_ERR_BAD_LEVEL  : u64 = 0xFFFFF08C
  pub let PLT_ERR_BAD_KIND   : u64 = 0xFFFFF08B
  pub let PLT_ERR_INTERNAL   : u64 = 0xFFFFF08A

  pub let PLT_INIT_MARK : u64 = 0x9107

  pub let mut _plt_buf   : [u64; 1920] = uninit @align(64)
  pub let mut _plt_state : [u64; 8]    = uninit @align(64)

  // ==========================================================================
  // Reset. Boot + teardown.
  // ==========================================================================

  pub let plt_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M3-001 (#1371): clear canvas + state, install init_mark and default 24x80 geometry. Labels prefixed plt_rst_.",
      block: {
        lea r10, [rip + _plt_buf];
        xor rax, rax;
        xor rcx, rcx;
      plt_rst_buf:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 1920;
        jb  plt_rst_buf;

        lea r10, [rip + _plt_state];
        xor rcx, rcx;
      plt_rst_st:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  plt_rst_st;

        mov rax, 0x9107;
        mov [r10 + 0], rax;                     // init_mark
        mov rax, 24;
        mov [r10 + 16], rax;                    // rows
        mov rax, 80;
        mov [r10 + 24], rax;                    // cols
        ret
      }
    } @no_frame

  pub let plt_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R41.M3-001 (#1371): honesty pin. Returns 0 until a later round drives plt_put from a live result-set consumer.",
      block: {
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let plt_err : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M3-001 (#1371): sticky error latch readback. Labels prefixed plt_er_.",
      block: {
        lea r10, [rip + _plt_state];
        mov rax, [r10 + 8];
        ret
      }
    } @no_frame

  pub let plt_bound : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M3-001 (#1371): 1 iff init_mark matches. Labels prefixed plt_bnd_.",
      block: {
        lea r10, [rip + _plt_state];
        mov rax, [r10 + 0];
        mov r11, 0x9107;
        cmp rax, r11;
        jne plt_bnd_no;
        mov rax, 1;
        ret;
      plt_bnd_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let plt_rows : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M3-001 (#1371): canvas row count. Labels prefixed plt_rw_.",
      block: {
        lea r10, [rip + _plt_state];
        mov rax, [r10 + 16];
        ret
      }
    } @no_frame

  pub let plt_cols : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M3-001 (#1371): canvas col count. Labels prefixed plt_cl_.",
      block: {
        lea r10, [rip + _plt_state];
        mov rax, [r10 + 24];
        ret
      }
    } @no_frame

  pub let plt_writes : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M3-001 (#1371): total plt_put calls since reset. Labels prefixed plt_wr_.",
      block: {
        lea r10, [rip + _plt_state];
        mov rax, [r10 + 32];
        ret
      }
    } @no_frame

  pub let plt_set_err : (u64) -> () !{mem} @{} =
    fn (code: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M3-001 (#1371): first-writer-wins error latch. Labels prefixed plt_se_.",
      block: {
        lea r10, [rip + _plt_state];
        mov rax, [r10 + 8];
        cmp rax, 0;
        jne plt_se_out;
        mov [r10 + 8], rdi;
      plt_se_out:
        ret
      }
    } @no_frame

  // ==========================================================================
  // plt_put(row, col, glyph, attrs) -> u64
  //
  // Store the cell (glyph + attrs packed per §0) at (row, col). Bumps
  // the writes counter on success. Refused if not init or if
  // (row, col) is out of range. Attrs are the upper 32 bits (fg + bg
  // + reserved) and are not validated here beyond truncation to 32
  // bits; palette lookups happen at emit time.
  //
  // Locals: rbx=row, r12=col, r13=glyph, r14=attrs.
  // ==========================================================================

  pub let plt_put : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (row: u64, col: u64, glyph: u64, attrs: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M3-001 (#1371): write one cell at (row, col). Packs (glyph & 0xFFFFFFFF) | (attrs << 32). Labels prefixed plt_pt_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        mov rbx, rdi;
        mov r12, rsi;
        mov r13, rdx;
        mov r14, rcx;

        lea r10, [rip + _plt_state];
        mov rax, [r10 + 0];
        mov r11, 0x9107;
        cmp rax, r11;
        jne plt_pt_ni;

        mov rax, [r10 + 16];                     // rows
        cmp rbx, rax;
        jae plt_pt_br;
        mov rax, [r10 + 24];                     // cols
        cmp r12, rax;
        jae plt_pt_bc;

        // cell = (glyph & 0xFFFFFFFF) | (attrs << 32)
        mov r11, 0xFFFFFFFF;
        and r13, r11;
        mov r8, r14;
        shl r8, 32;
        or  r13, r8;

        // offset = row * 80 + col
        lea r10, [rip + _plt_buf];
        mov r8, rbx;
        shl r8, 6;                               // row * 64
        mov r9, rbx;
        shl r9, 4;                               // row * 16
        add r8, r9;                              // row * 80
        add r8, r12;                             // + col
        mov [r10 + r8 * 8], r13;

        lea r10, [rip + _plt_state];
        mov rax, [r10 + 32];
        add rax, 1;
        mov [r10 + 32], rax;                     // writes++

        xor rax, rax;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      plt_pt_ni:
        mov rdi, 0xFFFFF08F;
        call plt_set_err;
        mov rax, 0xFFFFF08F;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;
      plt_pt_br:
        mov rdi, 0xFFFFF08E;
        call plt_set_err;
        mov rax, 0xFFFFF08E;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;
      plt_pt_bc:
        mov rdi, 0xFFFFF08D;
        call plt_set_err;
        mov rax, 0xFFFFF08D;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // plt_get(row, col) -> cell   (0 on out-of-range, err latched)
  // ==========================================================================

  pub let plt_get : (u64, u64) -> u64 !{mem} @{} =
    fn (row: u64, col: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M3-001 (#1371): read cell at (row, col). Labels prefixed plt_gt_.",
      block: {
        lea r10, [rip + _plt_state];
        mov rax, [r10 + 0];
        mov r11, 0x9107;
        cmp rax, r11;
        jne plt_gt_ni;

        mov rax, [r10 + 16];
        cmp rdi, rax;
        jae plt_gt_br;
        mov rax, [r10 + 24];
        cmp rsi, rax;
        jae plt_gt_bc;

        // offset = row * 80 + col
        lea r10, [rip + _plt_buf];
        mov r8, rdi;
        shl r8, 6;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add r8, rsi;
        mov rax, [r10 + r8 * 8];
        ret;

      plt_gt_ni:
        mov rdi, 0xFFFFF08F;
        call plt_set_err;
        xor rax, rax;
        ret;
      plt_gt_br:
        mov rdi, 0xFFFFF08E;
        call plt_set_err;
        xor rax, rax;
        ret;
      plt_gt_bc:
        mov rdi, 0xFFFFF08D;
        call plt_set_err;
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // plt_bar(row, col, level) -> u64
  //
  // Draw one bar cell at (row, col). Level 0..8; level 0 draws a
  // space, level k in 1..8 draws U+2580 + k (i.e. U+2581..U+2588).
  // ==========================================================================

  pub let plt_bar : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (row: u64, col: u64, level: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M3-001 (#1371): bar glyph selection. Labels prefixed plt_br_.",
      block: {
        push rbx;
        push r12;
        push r13;
        mov rbx, rdi;                            // row
        mov r12, rsi;                            // col
        mov r13, rdx;                            // level

        cmp r13, 8;
        ja  plt_br_bl;

        cmp r13, 0;
        jne plt_br_glyph;
        mov r13, 0x0020;                         // space
        jmp plt_br_call;
      plt_br_glyph:
        // 0x2580 + level
        add r13, 0x2580;
      plt_br_call:
        mov rdi, rbx;
        mov rsi, r12;
        mov rdx, r13;
        xor rcx, rcx;
        call plt_put;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      plt_br_bl:
        mov rdi, 0xFFFFF08C;
        call plt_set_err;
        mov rax, 0xFFFFF08C;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // plt_line(row, col, kind) -> u64
  //
  // Draw one line-drawing cell at (row, col). Kind 0..10 chosen from
  // the small ISO/IEC 10646 box-drawing set (§1).
  // ==========================================================================

  pub let plt_line : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (row: u64, col: u64, kind: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M3-001 (#1371): line glyph dispatch. Labels prefixed plt_ln_.",
      block: {
        push rbx;
        push r12;
        push r13;
        mov rbx, rdi;
        mov r12, rsi;
        mov r13, rdx;

        cmp r13, 10;
        ja  plt_ln_bk;

        // Dispatch table by kind.
        cmp r13, 0;
        jne plt_ln_1;
        mov r13, 0x2500;
        jmp plt_ln_call;
      plt_ln_1:
        cmp r13, 1;
        jne plt_ln_2;
        mov r13, 0x2502;
        jmp plt_ln_call;
      plt_ln_2:
        cmp r13, 2;
        jne plt_ln_3;
        mov r13, 0x250C;
        jmp plt_ln_call;
      plt_ln_3:
        cmp r13, 3;
        jne plt_ln_4;
        mov r13, 0x2510;
        jmp plt_ln_call;
      plt_ln_4:
        cmp r13, 4;
        jne plt_ln_5;
        mov r13, 0x2514;
        jmp plt_ln_call;
      plt_ln_5:
        cmp r13, 5;
        jne plt_ln_6;
        mov r13, 0x2518;
        jmp plt_ln_call;
      plt_ln_6:
        cmp r13, 6;
        jne plt_ln_7;
        mov r13, 0x252C;
        jmp plt_ln_call;
      plt_ln_7:
        cmp r13, 7;
        jne plt_ln_8;
        mov r13, 0x2534;
        jmp plt_ln_call;
      plt_ln_8:
        cmp r13, 8;
        jne plt_ln_9;
        mov r13, 0x251C;
        jmp plt_ln_call;
      plt_ln_9:
        cmp r13, 9;
        jne plt_ln_10;
        mov r13, 0x2524;
        jmp plt_ln_call;
      plt_ln_10:
        mov r13, 0x253C;
      plt_ln_call:
        mov rdi, rbx;
        mov rsi, r12;
        mov rdx, r13;
        xor rcx, rcx;
        call plt_put;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      plt_ln_bk:
        mov rdi, 0xFFFFF08B;
        call plt_set_err;
        mov rax, 0xFFFFF08B;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // plt_dot(row, col) -> u64
  //
  // Write U+00B7 middle dot at (row, col).
  // ==========================================================================

  pub let plt_dot : (u64, u64) -> u64 !{mem} @{} =
    fn (row: u64, col: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M3-001 (#1371): dot glyph write via plt_put. Labels prefixed plt_dt_.",
      block: {
        mov rdx, 0x00B7;
        xor rcx, rcx;
        call plt_put;
        ret
      }
    }

  // ==========================================================================
  // plt_heatmap(row, col, level) -> u64
  //
  // Level 0..8. Buckets: {0}, {1,2}, {3,4}, {5,6}, {7,8}.
  // ==========================================================================

  pub let plt_heatmap : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (row: u64, col: u64, level: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M3-001 (#1371): heatmap glyph selection. Labels prefixed plt_hm_.",
      block: {
        push rbx;
        push r12;
        push r13;
        mov rbx, rdi;
        mov r12, rsi;
        mov r13, rdx;

        cmp r13, 8;
        ja  plt_hm_bl;

        cmp r13, 0;
        jne plt_hm_low;
        mov r13, 0x0020;                          // space
        jmp plt_hm_call;
      plt_hm_low:
        cmp r13, 2;
        ja  plt_hm_med;
        mov r13, 0x2591;                          // light
        jmp plt_hm_call;
      plt_hm_med:
        cmp r13, 4;
        ja  plt_hm_dark;
        mov r13, 0x2592;                          // medium
        jmp plt_hm_call;
      plt_hm_dark:
        cmp r13, 6;
        ja  plt_hm_full;
        mov r13, 0x2593;                          // dark
        jmp plt_hm_call;
      plt_hm_full:
        mov r13, 0x2588;                          // full block
      plt_hm_call:
        mov rdi, rbx;
        mov rsi, r12;
        mov rdx, r13;
        xor rcx, rcx;
        call plt_put;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      plt_hm_bl:
        mov rdi, 0xFFFFF08C;
        call plt_set_err;
        mov rax, 0xFFFFF08C;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // plt_sparkline(row, col, level) -> u64
  //
  // Same glyph inventory as plt_bar; kept as a distinct primitive so
  // the callers' intent (a run of adjacent cells at ONE row) survives
  // review. A widening (e.g. adding a "direction" argument) is a
  // widening of this arity, not a hidden mode on plt_bar.
  // ==========================================================================

  pub let plt_sparkline : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (row: u64, col: u64, level: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M3-001 (#1371): sparkline glyph selection (mirrors plt_bar). Labels prefixed plt_sp_.",
      block: {
        push rbx;
        push r12;
        push r13;
        mov rbx, rdi;
        mov r12, rsi;
        mov r13, rdx;

        cmp r13, 8;
        ja  plt_sp_bl;

        cmp r13, 0;
        jne plt_sp_glyph;
        mov r13, 0x0020;
        jmp plt_sp_call;
      plt_sp_glyph:
        add r13, 0x2580;
      plt_sp_call:
        mov rdi, rbx;
        mov rsi, r12;
        mov rdx, r13;
        xor rcx, rcx;
        call plt_put;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      plt_sp_bl:
        mov rdi, 0xFFFFF08C;
        call plt_set_err;
        mov rax, 0xFFFFF08C;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
