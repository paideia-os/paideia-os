// src/kernel/core/semterm/pager.pdx -- R41.M4-003 (#1376)
//
// SEMTERM RESULT PAGER. Paginates a result-set buffer (semterm/
// resultset.pdx) into fixed-height fb pages for the framebuffer
// frontend. Owns nothing about the data itself -- it tracks
// (total_rows, rows_per_page, current_page, quit, search_offset) and
// a monotone counter of navigation calls. The frontend calls
// pgr_open with the seal-time row count, then walks pages with
// pgr_next_page / pgr_prev_page and asks pgr_page_start /
// pgr_page_end for the row range the current page addresses.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the PAGE INDEX. pgr_open(total_rows, rows_per_page) freezes
// the pagination shape at seal time; pgr_next_page moves to the next
// page unless the current page is the last; pgr_prev_page moves back
// unless page 0; pgr_quit sets a sticky quit flag every subsequent
// navigation call refuses on; pgr_search_set(offset) records the
// offset of a search token (the actual matcher is a later round's
// concern -- storing the offset lets a widening rewrite a single
// site).
//
// pgr_page_start()/pgr_page_end() compute the [row0, row1) range the
// current page addresses; pgr_current_page reports the page index; a
// frontend feeds rs_get(row, col) between those bounds to render.
//
// It does NOT read the result-set. It does NOT format rows -- a
// downstream formatter reads rs_get for each row in [start, end) and
// picks a column layout per the source schema. It does NOT own the
// key mapping; the frontend translates SPACE, b, q, / into calls to
// pgr_next_page / pgr_prev_page / pgr_quit / pgr_search_set.
//
// It is a SCAFFOLD (D7): R41.M4 wires it into the witness tree but no
// live result-set drives it; pgr_arbitrated() returns 0 until a later
// round hooks a real formatter into the (start, end) range.
//
// =============================================================================
// §1  PAGE ARITHMETIC
// =============================================================================
//
// last_page = (total_rows == 0) ? 0 : (total_rows - 1) / rows_per_page
// page_start = current_page * rows_per_page
// page_end   = min(page_start + rows_per_page, total_rows)
//
// A total_rows of 0 collapses to a single empty page (current_page ==
// 0, page_start == page_end == 0); pgr_next_page and pgr_prev_page
// both refuse.
//
// rows_per_page is bounded at 24 (the plot canvas height per
// semterm/plot.pdx §0). rows_per_page == 0 or > 24 is refused with
// PGR_ERR_BAD_ROWS.
//
// =============================================================================
// §2  ONE WRITER OF THE STATE
// =============================================================================
//
// _pgr_state is written only by helpers in this module. tools/build.sh
// confines relocations against it to `core/semterm/pager.o`.
//
// STATE LAYOUT -- _pgr_state : [u64; 8]
//   +0    init_mark      0x9A6E once pgr_reset has run
//   +8    err            sticky error latch (first-writer-wins)
//   +16   opened         1 iff pgr_open has run since reset
//   +24   total_rows     row count committed at pgr_open
//   +32   rows_per_page  page height committed at pgr_open (1..24)
//   +40   current_page   0..last_page
//   +48   quit           1 iff pgr_quit has run
//   +56   search_offset  last pgr_search_set argument (0 at reset)
//
// =============================================================================
// §3  FAILURE TAXONOMY 0xFFFFF030..0xFFFFF03F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time. Adjacent used
// band above: line_editor 0xFFFFF040..4F (R41.M4-002). Adjacent free
// band below: 0xFFFFF020..2F (unassigned).
//
//   PGR_OK               = 0
//   PGR_ERR_NOT_INIT     = 0xFFFFF03F   accessor before pgr_reset
//   PGR_ERR_NOT_OPEN     = 0xFFFFF03E   navigation before pgr_open
//   PGR_ERR_BAD_ROWS     = 0xFFFFF03D   rows_per_page 0 or > 24
//   PGR_ERR_AT_START     = 0xFFFFF03C   pgr_prev_page from page 0
//   PGR_ERR_AT_END       = 0xFFFFF03B   pgr_next_page from last page
//   PGR_ERR_QUIT         = 0xFFFFF03A   navigation after pgr_quit
//   PGR_ERR_ALREADY_OPEN = 0xFFFFF039   pgr_open twice without reset
//   PGR_ERR_INTERNAL     = 0xFFFFF038   unreachable-fallthrough tripwire
//
// =============================================================================
// §4  ARITY DISCIPLINE
// =============================================================================
//
// pgr_open is (total_rows, rows_per_page); pgr_search_set is
// (offset). Every navigation entry point is (). A widening (a scroll
// offset, a per-column filter) is a widening of these arities, and
// tools/build.sh pins the signatures.

module Pager = structure {

  // Page geometry (§1).
  pub let PGR_MAX_ROWS_PER_PAGE : u64 = 24

  // Failure taxonomy (§3).
  pub let PGR_OK               : u64 = 0
  pub let PGR_ERR_NOT_INIT     : u64 = 0xFFFFF03F
  pub let PGR_ERR_NOT_OPEN     : u64 = 0xFFFFF03E
  pub let PGR_ERR_BAD_ROWS     : u64 = 0xFFFFF03D
  pub let PGR_ERR_AT_START     : u64 = 0xFFFFF03C
  pub let PGR_ERR_AT_END       : u64 = 0xFFFFF03B
  pub let PGR_ERR_QUIT         : u64 = 0xFFFFF03A
  pub let PGR_ERR_ALREADY_OPEN : u64 = 0xFFFFF039
  pub let PGR_ERR_INTERNAL     : u64 = 0xFFFFF038

  pub let PGR_INIT_MARK : u64 = 0x9A6E

  pub let mut _pgr_state : [u64; 8] = uninit @align(64)

  // ==========================================================================
  // Reset. Boot + teardown.
  // ==========================================================================

  pub let pgr_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M4-003 (#1376): clear state, install init_mark. Labels prefixed pgr_rst_.",
      block: {
        lea r10, [rip + _pgr_state];
        xor rax, rax;
        xor rcx, rcx;
      pgr_rst_st:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  pgr_rst_st;

        mov rax, 0x9A6E;
        mov [r10 + 0], rax;                      // init_mark
        ret
      }
    } @no_frame

  pub let pgr_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R41.M4-003 (#1376): honesty pin. Returns 0 until a live formatter consumes pgr_page_start / pgr_page_end.",
      block: {
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let pgr_err : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M4-003 (#1376): sticky error latch readback. Labels prefixed pgr_er_.",
      block: {
        lea r10, [rip + _pgr_state];
        mov rax, [r10 + 8];
        ret
      }
    } @no_frame

  pub let pgr_bound : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M4-003 (#1376): 1 iff init_mark matches. Labels prefixed pgr_bnd_.",
      block: {
        lea r10, [rip + _pgr_state];
        mov rax, [r10 + 0];
        mov r11, 0x9A6E;
        cmp rax, r11;
        jne pgr_bnd_no;
        mov rax, 1;
        ret;
      pgr_bnd_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let pgr_set_err : (u64) -> () !{mem} @{} =
    fn (code: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M4-003 (#1376): first-writer-wins error latch. Labels prefixed pgr_se_.",
      block: {
        lea r10, [rip + _pgr_state];
        mov rax, [r10 + 8];
        cmp rax, 0;
        jne pgr_se_out;
        mov [r10 + 8], rdi;
      pgr_se_out:
        ret
      }
    } @no_frame

  // ==========================================================================
  // Field readbacks.
  // ==========================================================================

  pub let pgr_opened : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M4-003 (#1376): opened field.",
      block: {
        lea r10, [rip + _pgr_state];
        mov rax, [r10 + 16];
        ret
      }
    } @no_frame

  pub let pgr_total_rows : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M4-003 (#1376): total_rows field.",
      block: {
        lea r10, [rip + _pgr_state];
        mov rax, [r10 + 24];
        ret
      }
    } @no_frame

  pub let pgr_rows_per_page : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M4-003 (#1376): rows_per_page field.",
      block: {
        lea r10, [rip + _pgr_state];
        mov rax, [r10 + 32];
        ret
      }
    } @no_frame

  pub let pgr_current_page : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M4-003 (#1376): current_page field.",
      block: {
        lea r10, [rip + _pgr_state];
        mov rax, [r10 + 40];
        ret
      }
    } @no_frame

  pub let pgr_quit_flag : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M4-003 (#1376): quit field.",
      block: {
        lea r10, [rip + _pgr_state];
        mov rax, [r10 + 48];
        ret
      }
    } @no_frame

  pub let pgr_search_offset : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M4-003 (#1376): search_offset field.",
      block: {
        lea r10, [rip + _pgr_state];
        mov rax, [r10 + 56];
        ret
      }
    } @no_frame

  // ==========================================================================
  // pgr_open(total_rows, rows_per_page) -> u64
  //
  // Freeze pagination. Refuses:
  //   - not init                     PGR_ERR_NOT_INIT
  //   - opened already                PGR_ERR_ALREADY_OPEN
  //   - rows_per_page 0 or > 24      PGR_ERR_BAD_ROWS
  // ==========================================================================

  pub let pgr_open : (u64, u64) -> u64 !{mem} @{} =
    fn (total_rows: u64, rows_per_page: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M4-003 (#1376): commit total_rows + rows_per_page. Labels prefixed pgr_op_.",
      block: {
        lea r10, [rip + _pgr_state];
        mov rax, [r10 + 0];
        mov r11, 0x9A6E;
        cmp rax, r11;
        jne pgr_op_ni;

        mov rax, [r10 + 16];                     // opened
        cmp rax, 0;
        jne pgr_op_ao;

        cmp rsi, 0;
        je  pgr_op_br;
        cmp rsi, 24;
        ja  pgr_op_br;

        mov [r10 + 24], rdi;                     // total_rows
        mov [r10 + 32], rsi;                     // rows_per_page
        mov rax, 1;
        mov [r10 + 16], rax;                     // opened = 1
        xor rax, rax;
        mov [r10 + 40], rax;                     // current_page = 0
        mov [r10 + 48], rax;                     // quit = 0
        mov [r10 + 56], rax;                     // search_offset = 0
        ret;

      pgr_op_ni:
        mov rdi, 0xFFFFF03F;
        call pgr_set_err;
        mov rax, 0xFFFFF03F;
        ret;
      pgr_op_ao:
        mov rdi, 0xFFFFF039;
        call pgr_set_err;
        mov rax, 0xFFFFF039;
        ret;
      pgr_op_br:
        mov rdi, 0xFFFFF03D;
        call pgr_set_err;
        mov rax, 0xFFFFF03D;
        ret
      }
    }

  // ==========================================================================
  // pgr_next_page() -> u64
  //
  // Advance current_page unless already at last_page. Refuses if not
  // init, not opened, or after pgr_quit.
  //
  // last_page = (total_rows == 0) ? 0 : (total_rows - 1) / rows_per_page.
  //
  // Locals: rbx = total_rows, r12 = rows_per_page, r13 = current, r14 = last_page.
  // ==========================================================================

  pub let pgr_next_page : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M4-003 (#1376): current_page++. Refuses at last_page. Labels prefixed pgr_np_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        lea r10, [rip + _pgr_state];
        mov rax, [r10 + 0];
        mov r11, 0x9A6E;
        cmp rax, r11;
        jne pgr_np_ni;

        mov rax, [r10 + 16];                     // opened
        cmp rax, 0;
        je  pgr_np_no;

        mov rax, [r10 + 48];                     // quit
        cmp rax, 0;
        jne pgr_np_q;

        mov rbx, [r10 + 24];                     // total_rows
        mov r12, [r10 + 32];                     // rows_per_page
        mov r13, [r10 + 40];                     // current_page

        // last_page = (total_rows == 0) ? 0 : (total_rows - 1) / rows_per_page.
        cmp rbx, 0;
        je  pgr_np_last0;
        mov rax, rbx;
        sub rax, 1;
        xor rdx, rdx;
        div r12;
        mov r14, rax;
        jmp pgr_np_check;
      pgr_np_last0:
        xor r14, r14;

      pgr_np_check:
        cmp r13, r14;
        jae pgr_np_end;
        add r13, 1;
        mov [r10 + 40], r13;
        xor rax, rax;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      pgr_np_ni:
        mov rdi, 0xFFFFF03F;
        call pgr_set_err;
        mov rax, 0xFFFFF03F;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;
      pgr_np_no:
        mov rdi, 0xFFFFF03E;
        call pgr_set_err;
        mov rax, 0xFFFFF03E;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;
      pgr_np_q:
        mov rdi, 0xFFFFF03A;
        call pgr_set_err;
        mov rax, 0xFFFFF03A;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;
      pgr_np_end:
        mov rdi, 0xFFFFF03B;
        call pgr_set_err;
        mov rax, 0xFFFFF03B;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // pgr_prev_page() -> u64
  //
  // Decrement current_page unless already at page 0.
  // ==========================================================================

  pub let pgr_prev_page : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M4-003 (#1376): current_page--. Refuses at page 0. Labels prefixed pgr_pp_.",
      block: {
        lea r10, [rip + _pgr_state];
        mov rax, [r10 + 0];
        mov r11, 0x9A6E;
        cmp rax, r11;
        jne pgr_pp_ni;

        mov rax, [r10 + 16];
        cmp rax, 0;
        je  pgr_pp_no;

        mov rax, [r10 + 48];
        cmp rax, 0;
        jne pgr_pp_q;

        mov r8, [r10 + 40];
        cmp r8, 0;
        je  pgr_pp_start;
        sub r8, 1;
        mov [r10 + 40], r8;
        xor rax, rax;
        ret;

      pgr_pp_ni:
        mov rdi, 0xFFFFF03F;
        call pgr_set_err;
        mov rax, 0xFFFFF03F;
        ret;
      pgr_pp_no:
        mov rdi, 0xFFFFF03E;
        call pgr_set_err;
        mov rax, 0xFFFFF03E;
        ret;
      pgr_pp_q:
        mov rdi, 0xFFFFF03A;
        call pgr_set_err;
        mov rax, 0xFFFFF03A;
        ret;
      pgr_pp_start:
        mov rdi, 0xFFFFF03C;
        call pgr_set_err;
        mov rax, 0xFFFFF03C;
        ret
      }
    }

  // ==========================================================================
  // pgr_quit() -> u64
  //
  // Set the sticky quit flag. Idempotent once set. Refuses if not
  // init or not opened.
  // ==========================================================================

  pub let pgr_quit : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M4-003 (#1376): set quit flag. Labels prefixed pgr_qt_.",
      block: {
        lea r10, [rip + _pgr_state];
        mov rax, [r10 + 0];
        mov r11, 0x9A6E;
        cmp rax, r11;
        jne pgr_qt_ni;

        mov rax, [r10 + 16];
        cmp rax, 0;
        je  pgr_qt_no;

        mov rax, 1;
        mov [r10 + 48], rax;                     // quit = 1
        xor rax, rax;
        ret;

      pgr_qt_ni:
        mov rdi, 0xFFFFF03F;
        call pgr_set_err;
        mov rax, 0xFFFFF03F;
        ret;
      pgr_qt_no:
        mov rdi, 0xFFFFF03E;
        call pgr_set_err;
        mov rax, 0xFFFFF03E;
        ret
      }
    }

  // ==========================================================================
  // pgr_search_set(offset) -> u64
  //
  // Record a search offset. The actual matcher lives in a later
  // round; the offset is what a caller feeds into rs_get. Refuses if
  // not init or not opened.
  // ==========================================================================

  pub let pgr_search_set : (u64) -> u64 !{mem} @{} =
    fn (offset: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M4-003 (#1376): store search_offset. Labels prefixed pgr_ss_.",
      block: {
        lea r10, [rip + _pgr_state];
        mov rax, [r10 + 0];
        mov r11, 0x9A6E;
        cmp rax, r11;
        jne pgr_ss_ni;

        mov rax, [r10 + 16];
        cmp rax, 0;
        je  pgr_ss_no;

        mov rax, [r10 + 48];
        cmp rax, 0;
        jne pgr_ss_q;

        mov [r10 + 56], rdi;                     // search_offset
        xor rax, rax;
        ret;

      pgr_ss_ni:
        mov rdi, 0xFFFFF03F;
        call pgr_set_err;
        mov rax, 0xFFFFF03F;
        ret;
      pgr_ss_no:
        mov rdi, 0xFFFFF03E;
        call pgr_set_err;
        mov rax, 0xFFFFF03E;
        ret;
      pgr_ss_q:
        mov rdi, 0xFFFFF03A;
        call pgr_set_err;
        mov rax, 0xFFFFF03A;
        ret
      }
    }

  // ==========================================================================
  // pgr_page_start() -> u64
  //
  // current_page * rows_per_page. Refuses if not init or not opened.
  // ==========================================================================

  pub let pgr_page_start : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M4-003 (#1376): current_page * rows_per_page. Labels prefixed pgr_ps_.",
      block: {
        lea r10, [rip + _pgr_state];
        mov rax, [r10 + 0];
        mov r11, 0x9A6E;
        cmp rax, r11;
        jne pgr_ps_ni;

        mov rax, [r10 + 16];
        cmp rax, 0;
        je  pgr_ps_no;

        mov rax, [r10 + 40];                     // current_page
        mov r8, [r10 + 32];                      // rows_per_page
        imul rax, r8;
        ret;

      pgr_ps_ni:
        mov rdi, 0xFFFFF03F;
        call pgr_set_err;
        xor rax, rax;
        ret;
      pgr_ps_no:
        mov rdi, 0xFFFFF03E;
        call pgr_set_err;
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // pgr_page_end() -> u64
  //
  // min(page_start + rows_per_page, total_rows). Refuses if not init
  // or not opened.
  // ==========================================================================

  pub let pgr_page_end : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M4-003 (#1376): min(page_start + rows_per_page, total_rows). Labels prefixed pgr_pe_.",
      block: {
        lea r10, [rip + _pgr_state];
        mov rax, [r10 + 0];
        mov r11, 0x9A6E;
        cmp rax, r11;
        jne pgr_pe_ni;

        mov rax, [r10 + 16];
        cmp rax, 0;
        je  pgr_pe_no;

        mov rax, [r10 + 40];                     // current_page
        mov r8, [r10 + 32];                      // rows_per_page
        imul rax, r8;                            // page_start
        add rax, r8;                             // + rows_per_page
        mov r9, [r10 + 24];                      // total_rows
        cmp rax, r9;
        jbe pgr_pe_out;
        mov rax, r9;
      pgr_pe_out:
        ret;

      pgr_pe_ni:
        mov rdi, 0xFFFFF03F;
        call pgr_set_err;
        xor rax, rax;
        ret;
      pgr_pe_no:
        mov rdi, 0xFFFFF03E;
        call pgr_set_err;
        xor rax, rax;
        ret
      }
    }
}
