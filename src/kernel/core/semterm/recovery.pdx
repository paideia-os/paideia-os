// src/kernel/core/semterm/recovery.pdx -- R41.M5-001 (#1377)
//
// SEMTERM RECOVERY-MODE INTEGRATION + SAFECTL BRIDGE. The seam a boot-
// time cmdline parser calls when `recovery=1` is present: it arms
// recovery mode, records the safectl KIND_* / cap-slot the semantic
// terminal must bind to instead of a shell, keeps the session read-
// only by default, and gates a small verb union so a live safectl
// verb dispatcher can prove the terminal refused an UPDATE it never
// widened.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the RECOVERY-MODE ARBITER. rec_reset boots empty (armed = 0,
// ro = 1, safectl unbound); rec_arm sets the armed flag exactly once
// (a boot-time widening will call rec_arm from a cmdline parser that
// matched `recovery=1`, keeping cmdline handling out of this module);
// rec_safectl_bind(kind, slot) records the KIND_* + cap-slot the
// semterm frontend must attach to; rec_set_ro(v) widens or restores
// the read-only default; rec_verb(verb_id) accepts a verb from a
// small union (SELECT_STATE, SELECT_AUDIT, UPDATE_RESCUE,
// UPDATE_QUARANTINE) and refuses any UPDATE_* while ro == 1.
//
// It does NOT parse the kernel cmdline. A boot-time cmdline scanner
// is responsible for detecting `recovery=1` and calling rec_arm;
// leaving the scanner outside this module keeps a widening (regex,
// alternate token) from silently altering the arming semantics.
//
// It does NOT own the safectl channel. rec_safectl_bind stores the
// (kind, slot) pair the semterm frontend will read on attach; the
// actual channel walk is a later round's concern -- an unbound safectl
// row is a legitimate refusal (REC_ERR_NOT_BOUND) the verb dispatcher
// surfaces rather than silently succeeding.
//
// It does NOT invoke a shell. The semantic terminal's fb frontend
// (semterm/fb_frontend.pdx) reads rec_armed / rec_safectl_kind /
// rec_safectl_slot at attach time to decide between the recovery
// bind and the ordinary shell bind; those readbacks are the seam.
//
// It is a SCAFFOLD (D7): R41.M5 wires it into the witness tree but no
// live cmdline scanner arms it and no live safectl walk consumes the
// bind; rec_arbitrated() returns 0 until a later round hooks a real
// verb dispatcher into rec_verb.
//
// =============================================================================
// §1  VERB UNION
// =============================================================================
//
// A small four-entry union names the safectl operations the recovery
// terminal exposes. The union exists AS CODE so a subscriber that
// unpacks a verb the arbiter never authorised fails validation rather
// than silently misdispatching:
//
//   REC_VERB_SELECT_STATE      = 1   SELECT * FROM safectl.state
//   REC_VERB_SELECT_AUDIT      = 2   SELECT * FROM safectl.audit
//   REC_VERB_UPDATE_RESCUE     = 3   UPDATE safectl SET rescue_kernel = ...
//   REC_VERB_UPDATE_QUARANTINE = 4   UPDATE safectl SET quarantine = ...
//
// SELECT_* verbs are always accepted (they are RO reads). UPDATE_*
// verbs are refused with REC_ERR_RO_REFUSED unless a caller has
// explicitly widened the session with rec_set_ro(0); a subsequent
// rec_set_ro(1) restores the default. The widening ceremony -- one
// call, one code path -- is deliberately loud, so a live UPDATE
// dispatch cannot be smuggled through a SELECT.
//
// =============================================================================
// §2  ONE WRITER OF THE STATE
// =============================================================================
//
// _rec_state is written only by helpers in this module. tools/build.sh
// confines relocations against it to `core/semterm/recovery.o`.
//
// STATE LAYOUT -- _rec_state : [u64; 8]
//   +0    init_mark        0xEC0F once rec_reset has run
//   +8    err              sticky error latch (first-writer-wins)
//   +16   armed            1 iff rec_arm has run since reset
//   +24   safectl_kind     KIND_* tag recorded by rec_safectl_bind (0 = unbound)
//   +32   safectl_slot     cap_table slot recorded by rec_safectl_bind
//   +40   ro               1 = read-only session (default); 0 = writes allowed
//   +48   verb_count       total accepted verbs since reset
//   +56   deny_count       total refused verbs (RO_REFUSED / BAD_VERB / ...)
//
// =============================================================================
// §3  FAILURE TAXONOMY 0xFFFFF020..0xFFFFF02F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time. Adjacent used
// band above: pager 0xFFFFF030..3F (R41.M4-003). Adjacent free band
// below: session_log 0xFFFFF010..1F (R41.M5-002).
//
//   REC_OK                = 0
//   REC_ERR_NOT_INIT      = 0xFFFFF02F   accessor before rec_reset
//   REC_ERR_NOT_ARMED     = 0xFFFFF02E   verb / bind before rec_arm
//   REC_ERR_NOT_BOUND     = 0xFFFFF02D   verb before rec_safectl_bind
//   REC_ERR_BAD_VERB      = 0xFFFFF02C   verb_id outside REC_VERB_* union
//   REC_ERR_RO_REFUSED    = 0xFFFFF02B   UPDATE_* verb while ro == 1
//   REC_ERR_ALREADY_ARMED = 0xFFFFF02A   rec_arm twice without reset
//   REC_ERR_BAD_ROV       = 0xFFFFF029   rec_set_ro with v outside {0, 1}
//   REC_ERR_INTERNAL      = 0xFFFFF028   unreachable-fallthrough tripwire
//
// =============================================================================
// §4  ARITY DISCIPLINE
// =============================================================================
//
// rec_safectl_bind is (kind, slot). rec_verb is (verb_id). rec_set_ro
// is (v). Every readback is (). A widening (a cmdline slice, a per-
// verb argument tuple) is a widening of these arities, and
// tools/build.sh pins the signatures.

module Recovery = structure {

  // Verb union (§1).
  pub let REC_VERB_SELECT_STATE      : u64 = 1
  pub let REC_VERB_SELECT_AUDIT      : u64 = 2
  pub let REC_VERB_UPDATE_RESCUE     : u64 = 3
  pub let REC_VERB_UPDATE_QUARANTINE : u64 = 4
  pub let REC_VERB_MIN               : u64 = 1
  pub let REC_VERB_MAX               : u64 = 4
  pub let REC_VERB_UPDATE_LO         : u64 = 3     // first UPDATE_* verb

  // Failure taxonomy (§3).
  pub let REC_OK                : u64 = 0
  pub let REC_ERR_NOT_INIT      : u64 = 0xFFFFF02F
  pub let REC_ERR_NOT_ARMED     : u64 = 0xFFFFF02E
  pub let REC_ERR_NOT_BOUND     : u64 = 0xFFFFF02D
  pub let REC_ERR_BAD_VERB      : u64 = 0xFFFFF02C
  pub let REC_ERR_RO_REFUSED    : u64 = 0xFFFFF02B
  pub let REC_ERR_ALREADY_ARMED : u64 = 0xFFFFF02A
  pub let REC_ERR_BAD_ROV       : u64 = 0xFFFFF029
  pub let REC_ERR_INTERNAL      : u64 = 0xFFFFF028

  pub let REC_INIT_MARK : u64 = 0xEC0F

  pub let mut _rec_state : [u64; 8] = uninit @align(64)

  // ==========================================================================
  // Reset. Boot + teardown. ro is set to 1 (RO default) after the
  // memory sweep so a subsequent accessor cannot observe an interim
  // state with ro == 0.
  // ==========================================================================

  pub let rec_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M5-001 (#1377): clear state, install init_mark, set ro = 1 (read-only default). Labels prefixed rec_rst_.",
      block: {
        lea r10, [rip + _rec_state];
        xor rax, rax;
        xor rcx, rcx;
      rec_rst_st:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  rec_rst_st;

        mov rax, 0xEC0F;
        mov [r10 + 0], rax;                      // init_mark
        mov rax, 1;
        mov [r10 + 40], rax;                     // ro = 1 (RO default)
        ret
      }
    } @no_frame

  pub let rec_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R41.M5-001 (#1377): honesty pin. Returns 0 until a live cmdline parser arms this module and a live safectl dispatcher consumes rec_verb.",
      block: {
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let rec_bound : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M5-001 (#1377): 1 iff init_mark matches. Labels prefixed rec_bnd_.",
      block: {
        lea r10, [rip + _rec_state];
        mov rax, [r10 + 0];
        mov r11, 0xEC0F;
        cmp rax, r11;
        jne rec_bnd_no;
        mov rax, 1;
        ret;
      rec_bnd_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let rec_err : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M5-001 (#1377): sticky error latch readback. Labels prefixed rec_er_.",
      block: {
        lea r10, [rip + _rec_state];
        mov rax, [r10 + 8];
        ret
      }
    } @no_frame

  pub let rec_set_err : (u64) -> () !{mem} @{} =
    fn (code: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M5-001 (#1377): first-writer-wins error latch. Labels prefixed rec_se_.",
      block: {
        lea r10, [rip + _rec_state];
        mov rax, [r10 + 8];
        cmp rax, 0;
        jne rec_se_out;
        mov [r10 + 8], rdi;
      rec_se_out:
        ret
      }
    } @no_frame

  // ==========================================================================
  // Field readbacks.
  // ==========================================================================

  pub let rec_armed : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M5-001 (#1377): armed field.",
      block: {
        lea r10, [rip + _rec_state];
        mov rax, [r10 + 16];
        ret
      }
    } @no_frame

  pub let rec_safectl_kind : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M5-001 (#1377): safectl_kind field.",
      block: {
        lea r10, [rip + _rec_state];
        mov rax, [r10 + 24];
        ret
      }
    } @no_frame

  pub let rec_safectl_slot : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M5-001 (#1377): safectl_slot field.",
      block: {
        lea r10, [rip + _rec_state];
        mov rax, [r10 + 32];
        ret
      }
    } @no_frame

  pub let rec_ro : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M5-001 (#1377): ro field.",
      block: {
        lea r10, [rip + _rec_state];
        mov rax, [r10 + 40];
        ret
      }
    } @no_frame

  pub let rec_verb_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M5-001 (#1377): verb_count field.",
      block: {
        lea r10, [rip + _rec_state];
        mov rax, [r10 + 48];
        ret
      }
    } @no_frame

  pub let rec_deny_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M5-001 (#1377): deny_count field.",
      block: {
        lea r10, [rip + _rec_state];
        mov rax, [r10 + 56];
        ret
      }
    } @no_frame

  // ==========================================================================
  // rec_arm() -> u64
  //
  // Arm recovery mode. Refuses:
  //   - not init                     REC_ERR_NOT_INIT
  //   - already armed                 REC_ERR_ALREADY_ARMED
  // ==========================================================================

  pub let rec_arm : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M5-001 (#1377): set armed = 1. Refuses double-arm without reset. Labels prefixed rec_ar_.",
      block: {
        lea r10, [rip + _rec_state];
        mov rax, [r10 + 0];
        mov r11, 0xEC0F;
        cmp rax, r11;
        jne rec_ar_ni;

        mov rax, [r10 + 16];                     // armed
        cmp rax, 0;
        jne rec_ar_aa;

        mov rax, 1;
        mov [r10 + 16], rax;                     // armed = 1
        xor rax, rax;
        ret;

      rec_ar_ni:
        mov rdi, 0xFFFFF02F;
        call rec_set_err;
        mov rax, 0xFFFFF02F;
        ret;
      rec_ar_aa:
        mov rdi, 0xFFFFF02A;
        call rec_set_err;
        mov rax, 0xFFFFF02A;
        ret
      }
    }

  // ==========================================================================
  // rec_safectl_bind(kind, slot) -> u64
  //
  // Record the safectl (KIND_*, cap_table slot) the semterm frontend
  // must attach to. Refuses if not init or not armed.
  // ==========================================================================

  pub let rec_safectl_bind : (u64, u64) -> u64 !{mem} @{} =
    fn (kind: u64, slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M5-001 (#1377): store (safectl_kind, safectl_slot). Labels prefixed rec_sb_.",
      block: {
        lea r10, [rip + _rec_state];
        mov rax, [r10 + 0];
        mov r11, 0xEC0F;
        cmp rax, r11;
        jne rec_sb_ni;

        mov rax, [r10 + 16];                     // armed
        cmp rax, 0;
        je  rec_sb_na;

        mov [r10 + 24], rdi;                     // safectl_kind
        mov [r10 + 32], rsi;                     // safectl_slot
        xor rax, rax;
        ret;

      rec_sb_ni:
        mov rdi, 0xFFFFF02F;
        call rec_set_err;
        mov rax, 0xFFFFF02F;
        ret;
      rec_sb_na:
        mov rdi, 0xFFFFF02E;
        call rec_set_err;
        mov rax, 0xFFFFF02E;
        ret
      }
    }

  // ==========================================================================
  // rec_set_ro(v) -> u64
  //
  // Widen or restore the read-only default. v must be 0 or 1.
  // Refuses if not init or not armed.
  // ==========================================================================

  pub let rec_set_ro : (u64) -> u64 !{mem} @{} =
    fn (v: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M5-001 (#1377): store ro flag (0 or 1). Labels prefixed rec_sr_.",
      block: {
        lea r10, [rip + _rec_state];
        mov rax, [r10 + 0];
        mov r11, 0xEC0F;
        cmp rax, r11;
        jne rec_sr_ni;

        mov rax, [r10 + 16];                     // armed
        cmp rax, 0;
        je  rec_sr_na;

        cmp rdi, 1;
        ja  rec_sr_bv;

        mov [r10 + 40], rdi;                     // ro
        xor rax, rax;
        ret;

      rec_sr_ni:
        mov rdi, 0xFFFFF02F;
        call rec_set_err;
        mov rax, 0xFFFFF02F;
        ret;
      rec_sr_na:
        mov rdi, 0xFFFFF02E;
        call rec_set_err;
        mov rax, 0xFFFFF02E;
        ret;
      rec_sr_bv:
        mov rdi, 0xFFFFF029;
        call rec_set_err;
        mov rax, 0xFFFFF029;
        ret
      }
    }

  // ==========================================================================
  // rec_verb(verb_id) -> u64
  //
  // Accept a safectl verb from the small union (§1). Refuses:
  //   - not init                     REC_ERR_NOT_INIT
  //   - not armed                     REC_ERR_NOT_ARMED
  //   - safectl not bound             REC_ERR_NOT_BOUND
  //   - verb_id outside [1..4]        REC_ERR_BAD_VERB
  //   - UPDATE_* while ro == 1        REC_ERR_RO_REFUSED
  //
  // Increments verb_count on accept, deny_count on any refusal that
  // survived the arm/bind gates (BAD_VERB, RO_REFUSED). The gate
  // refusals (NOT_INIT / NOT_ARMED / NOT_BOUND) do NOT bump deny_count
  // because they are configuration mistakes, not dispatch mistakes.
  // ==========================================================================

  pub let rec_verb : (u64) -> u64 !{mem} @{} =
    fn (verb_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M5-001 (#1377): validate + count a safectl verb. Labels prefixed rec_vb_.",
      block: {
        lea r10, [rip + _rec_state];
        mov rax, [r10 + 0];
        mov r11, 0xEC0F;
        cmp rax, r11;
        jne rec_vb_ni;

        mov rax, [r10 + 16];                     // armed
        cmp rax, 0;
        je  rec_vb_na;

        mov rax, [r10 + 24];                     // safectl_kind
        cmp rax, 0;
        je  rec_vb_nb;

        // Verb bounds [1..4].
        cmp rdi, 1;
        jb  rec_vb_bv;
        cmp rdi, 4;
        ja  rec_vb_bv;

        // UPDATE_* while ro == 1 refused.
        cmp rdi, 3;                              // REC_VERB_UPDATE_LO
        jb  rec_vb_ok;
        mov rax, [r10 + 40];                     // ro
        cmp rax, 1;
        je  rec_vb_ro;

      rec_vb_ok:
        mov rax, [r10 + 48];                     // verb_count
        add rax, 1;
        mov [r10 + 48], rax;
        xor rax, rax;
        ret;

      rec_vb_ni:
        mov rdi, 0xFFFFF02F;
        call rec_set_err;
        mov rax, 0xFFFFF02F;
        ret;
      rec_vb_na:
        mov rdi, 0xFFFFF02E;
        call rec_set_err;
        mov rax, 0xFFFFF02E;
        ret;
      rec_vb_nb:
        mov rdi, 0xFFFFF02D;
        call rec_set_err;
        mov rax, 0xFFFFF02D;
        ret;
      rec_vb_bv:
        lea r10, [rip + _rec_state];
        mov rax, [r10 + 56];                     // deny_count
        add rax, 1;
        mov [r10 + 56], rax;
        mov rdi, 0xFFFFF02C;
        call rec_set_err;
        mov rax, 0xFFFFF02C;
        ret;
      rec_vb_ro:
        lea r10, [rip + _rec_state];
        mov rax, [r10 + 56];                     // deny_count
        add rax, 1;
        mov [r10 + 56], rax;
        mov rdi, 0xFFFFF02B;
        call rec_set_err;
        mov rax, 0xFFFFF02B;
        ret
      }
    }
}
