// src/kernel/core/semterm/gui_hdr.pdx -- R44.M4-001 (#1409)
//
// SEMTERM GUI HDR / COLOR-AWARE PLOTS. The G6 tone-mapping seam
// behind the R44 chart engine: at plot time the emitter asks this
// module for the RGB value of a series index, and the module picks
// from the wide-gamut BT.2020 palette if the bound R36
// KIND_DISPLAY_OUTPUT reports HDR capability, otherwise it defers to
// the sRGB catalogue in semterm/palette.pdx.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the HDR-AWARE ROUTER between the R44 chart engine and the
// two catalogues (BT.2020 wide-gamut here, sRGB in palette.pdx). A
// live R36 display supervisor walks the seam:
//   is_hdr := display_query_hdr(kind_display_output_row)
//   hdr_set_capable(is_hdr)                       // once per output attach
//   for series in 0 .. 7:
//     rgb := hdr_pick_series(series)              // called from gui_charts
//     ... hand rgb to the compositor ...
//
// hdr_reset zeroes state; hdr_set_capable(flag) coerces flag to 0/1
// and parks it into capable; hdr_capable / hdr_bound / hdr_arbitrated
// are the readbacks; hdr_pick_series(series) is the chart-color
// dispatcher; hdr_series_picks_total / hdr_mode_switches_total /
// hdr_hdr_picks / hdr_sdr_picks let a diagnostic ring prove the seam
// exercised both branches.
//
// It does NOT read a KIND_DISPLAY_OUTPUT row directly. R36 (display
// supervisor) owns the row and the HDR-capability bit; this module
// is the SEAM the supervisor sets. Keeping the row dereference OUT
// of this module keeps hdr_ independent of R36's init state and lets
// the same module serve HDR-off boots (integrated eDP, external SDR
// monitor) without a policy detour.
//
// It does NOT tone-map. The G6 tone mapper (a later module) reads
// hdr_capable() and picks its EOTF (PQ vs. sRGB gamma). This module
// only picks CHART COLORS -- eight distinguishable series entries
// with a documented CIELAB delta-E floor in both modes.
//
// It is a SCAFFOLD (D7): R44.M4 wires it into the witness tree but
// no live R36 display supervisor sets hdr_capable and no live chart
// engine drains hdr_pick_series; hdr_arbitrated() returns 0 until a
// later round hooks the supervisor into hdr_set_capable and the
// chart engine into hdr_pick_series.
//
// =============================================================================
// §1  WIDE-GAMUT BT.2020 PALETTE
// =============================================================================
//
// Eight-entry categorical set, one entry per series index 0..7. The
// 24-bit RGB values are the primaries and secondaries of ITU-R
// BT.2020 (red, green, blue and their combinations), which the
// compositor is instructed by hdr_capable == 1 to interpret in the
// BT.2020 primary space rather than sRGB. Because the BT.2020
// primaries sit much farther from D65 than the sRGB primaries do,
// the CIELAB delta-E between adjacent entries is documented as
// >= 40 in the BT.2020 primary space -- comfortably above the >= 15
// floor R41.M3 palette.pdx guarantees for its sRGB set.
//
//   series 0 -> BT.2020 red         0xFF0000
//   series 1 -> BT.2020 green       0x00FF00
//   series 2 -> BT.2020 blue        0x0000FF
//   series 3 -> BT.2020 yellow      0xFFFF00
//   series 4 -> BT.2020 magenta     0xFF00FF
//   series 5 -> BT.2020 cyan        0x00FFFF
//   series 6 -> BT.2020 orange      0xFF8000
//   series 7 -> BT.2020 violet      0x8000FF
//
// A widening (a nine-way series set, a per-luminance override, a P3
// intermediate stop) is a widening of HDR_SERIES_MAX and rewrites
// _hdr_series_bt2020's declaration in one place.
//
// SDR FALLBACK. When hdr_capable == 0 the picker calls
// pal_series_color(series) to resolve a default-palette index, then
// pal_default_rgb to get the sRGB 24-bit value. That sRGB catalogue
// carries its own delta-E >= 15 floor from R41.M3 palette.pdx §0.
// The two floors are documented on the same axis so a boot on either
// path passes the same "adjacent series stay distinguishable"
// contract.
//
// =============================================================================
// §2  ONE WRITER OF THE STATE
// =============================================================================
//
// _hdr_state and _hdr_series_bt2020 are written only by helpers in
// this module. tools/build.sh confines relocations against each to
// `core/semterm/gui_hdr.o`.
//
// STATE LAYOUT -- _hdr_state : [u64; 8]
//   +0    init_mark              0xBC20 once hdr_reset has run
//   +8    err                    sticky error latch (first-writer-wins)
//   +16   capable                0 (sRGB) | 1 (HDR / BT.2020)
//   +24   series_picks_total     count across every hdr_pick_series
//   +32   hdr_picks              count of picks in HDR branch
//   +40   sdr_picks              count of picks in sRGB branch
//   +48   mode_switches_total    count across every hdr_set_capable
//   +56   reserved               0
//
// BT.2020 CATALOGUE -- _hdr_series_bt2020 : [u64; 8]
//   Eight 24-bit RGB values populated by hdr_reset (§1 order).
//
// =============================================================================
// §3  FAILURE TAXONOMY 0xFFFFEE40..0xFFFFEE4F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time. Adjacent used
// band above: gui_kbdnav 0xFFFFEE50..5F (R44.M3-003). Adjacent free
// band below: gui_feedback 0xFFFFEE30..3F (this milestone).
//
//   HDR_OK              = 0
//   HDR_ERR_NOT_INIT    = 0xFFFFEE4F   accessor before hdr_reset
//   HDR_ERR_BAD_SERIES  = 0xFFFFEE4E   series > HDR_SERIES_MAX
//   HDR_ERR_BAD_FLAG    = 0xFFFFEE4D   RESERVED (set_capable coerces)
//   HDR_ERR_INTERNAL    = 0xFFFFEE4B   unreachable-fallthrough tripwire
//
// =============================================================================
// §4  ARITY DISCIPLINE
// =============================================================================
//
// hdr_set_capable is (flag). hdr_pick_series is (series). Every
// readback is (). A widening (per-output capability, luminance-cap
// argument, an intermediate P3 mode) is a widening of these arities
// and tools/build.sh pins the signatures.

module GuiHdr = structure {

  // Series count (§1).
  pub let HDR_SERIES_MAX : u64 = 7

  // Failure taxonomy (§3).
  pub let HDR_OK             : u64 = 0
  pub let HDR_ERR_NOT_INIT   : u64 = 0xFFFFEE4F
  pub let HDR_ERR_BAD_SERIES : u64 = 0xFFFFEE4E
  pub let HDR_ERR_BAD_FLAG   : u64 = 0xFFFFEE4D
  pub let HDR_ERR_INTERNAL   : u64 = 0xFFFFEE4B

  pub let HDR_INIT_MARK : u64 = 0xBC20

  pub let mut _hdr_state         : [u64; 8] = uninit @align(64)
  pub let mut _hdr_series_bt2020 : [u64; 8] = uninit @align(64)

  // ==========================================================================
  // Reset. Boot + teardown. Installs BT.2020 catalogue.
  // ==========================================================================

  pub let hdr_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M4-001 (#1409): clear state, install init_mark + BT.2020 catalogue (§1). Labels prefixed hdr_rst_.",
      block: {
        lea r10, [rip + _hdr_state];
        xor rax, rax;
        xor rcx, rcx;
      hdr_rst_st:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  hdr_rst_st;

        mov rax, 0xBC20;
        mov [r10 + 0], rax;                      // init_mark

        // BT.2020 catalogue -- one entry per series index (§1).
        lea r10, [rip + _hdr_series_bt2020];
        mov rax, 0xFF0000;                       // series 0 : red
        mov [r10 + 0], rax;
        mov rax, 0x00FF00;                       // series 1 : green
        mov [r10 + 8], rax;
        mov rax, 0x0000FF;                       // series 2 : blue
        mov [r10 + 16], rax;
        mov rax, 0xFFFF00;                       // series 3 : yellow
        mov [r10 + 24], rax;
        mov rax, 0xFF00FF;                       // series 4 : magenta
        mov [r10 + 32], rax;
        mov rax, 0x00FFFF;                       // series 5 : cyan
        mov [r10 + 40], rax;
        mov rax, 0xFF8000;                       // series 6 : orange
        mov [r10 + 48], rax;
        mov rax, 0x8000FF;                       // series 7 : violet
        mov [r10 + 56], rax;
        ret
      }
    }

  pub let hdr_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R44.M4-001 (#1409): honesty pin. Returns 0 until a live R36 display supervisor sets hdr_capable and a live chart engine drains hdr_pick_series.",
      block: {
        xor rax, rax;
        ret
      }
    }

  pub let hdr_err : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M4-001 (#1409): sticky error latch readback.",
      block: {
        lea r10, [rip + _hdr_state];
        mov rax, [r10 + 8];
        ret
      }
    }

  pub let hdr_bound : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M4-001 (#1409): 1 iff init_mark matches. Labels prefixed hdr_bnd_.",
      block: {
        lea r10, [rip + _hdr_state];
        mov rax, [r10 + 0];
        mov r11, 0xBC20;
        cmp rax, r11;
        jne hdr_bnd_no;
        mov rax, 1;
        ret;
      hdr_bnd_no:
        xor rax, rax;
        ret
      }
    }

  pub let hdr_set_err : (u64) -> () !{mem} @{} =
    fn (code: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M4-001 (#1409): first-writer-wins error latch. Labels prefixed hdr_se_.",
      block: {
        lea r10, [rip + _hdr_state];
        mov rax, [r10 + 8];
        cmp rax, 0;
        jne hdr_se_out;
        mov [r10 + 8], rdi;
      hdr_se_out:
        ret
      }
    }

  // ==========================================================================
  // Readbacks.
  // ==========================================================================

  pub let hdr_capable : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M4-001 (#1409): capable field (0 | 1).",
      block: {
        lea r10, [rip + _hdr_state];
        mov rax, [r10 + 16];
        ret
      }
    }

  pub let hdr_series_picks_total : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M4-001 (#1409): series_picks_total running total.",
      block: {
        lea r10, [rip + _hdr_state];
        mov rax, [r10 + 24];
        ret
      }
    }

  pub let hdr_hdr_picks : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M4-001 (#1409): hdr_picks running total.",
      block: {
        lea r10, [rip + _hdr_state];
        mov rax, [r10 + 32];
        ret
      }
    }

  pub let hdr_sdr_picks : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M4-001 (#1409): sdr_picks running total.",
      block: {
        lea r10, [rip + _hdr_state];
        mov rax, [r10 + 40];
        ret
      }
    }

  pub let hdr_mode_switches_total : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M4-001 (#1409): mode_switches_total running total.",
      block: {
        lea r10, [rip + _hdr_state];
        mov rax, [r10 + 48];
        ret
      }
    }

  // ==========================================================================
  // hdr_set_capable(flag) -> u64
  //
  // Coerce flag to 0/1 and store into capable. Refuses not init.
  // Bumps mode_switches_total on every successful call. A per-call
  // increment (rather than "only on state change") lets a diagnostic
  // ring prove the seam was invoked; the branch count matters for
  // the D7 dormancy proof, not the value transition.
  // ==========================================================================

  pub let hdr_set_capable : (u64) -> u64 !{mem} @{} =
    fn (flag: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M4-001 (#1409): coerce flag to 0/1; bump mode_switches_total. Labels prefixed hdr_sc_.",
      block: {
        lea r10, [rip + _hdr_state];
        mov rax, [r10 + 0];
        mov r11, 0xBC20;
        cmp rax, r11;
        jne hdr_sc_ni;

        cmp rdi, 0;
        je  hdr_sc_st;
        mov rdi, 1;
      hdr_sc_st:
        mov [r10 + 16], rdi;

        // mode_switches_total += 1.
        mov rax, [r10 + 48];
        add rax, 1;
        mov [r10 + 48], rax;

        xor rax, rax;
        ret;

      hdr_sc_ni:
        mov rdi, 0xFFFFEE4F;
        call hdr_set_err;
        mov rax, 0xFFFFEE4F;
        ret
      }
    }

  // ==========================================================================
  // hdr_pick_series(series) -> u64
  //
  // Return the 24-bit RGB value to paint series in the current mode.
  // Refuses not init or series > HDR_SERIES_MAX.
  //
  //   capable == 1 -> _hdr_series_bt2020[series]  (BT.2020 branch)
  //   capable == 0 -> pal_default_rgb(pal_series_color(series))
  //                                              (sRGB fallback)
  //
  // Bumps series_picks_total unconditionally and hdr_picks / sdr_picks
  // per branch so a diagnostic ring can prove both paths were
  // exercised in the same boot.
  // ==========================================================================

  pub let hdr_pick_series : (u64) -> u64 !{mem} @{} =
    fn (series: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M4-001 (#1409): dispatch series -> RGB per capable mode. Labels prefixed hdr_ps_.",
      block: {
        lea r10, [rip + _hdr_state];
        mov rax, [r10 + 0];
        mov r11, 0xBC20;
        cmp rax, r11;
        jne hdr_ps_ni;

        cmp rdi, 7;
        ja  hdr_ps_bs;

        // Bump series_picks_total.
        mov rax, [r10 + 24];
        add rax, 1;
        mov [r10 + 24], rax;

        // Branch on capable.
        mov rax, [r10 + 16];
        cmp rax, 0;
        je  hdr_ps_sdr;

        // HDR branch: read _hdr_series_bt2020[series].
        lea r11, [rip + _hdr_series_bt2020];
        mov rax, [r11 + rdi * 8];

        // hdr_picks += 1.
        mov rcx, [r10 + 32];
        add rcx, 1;
        mov [r10 + 32], rcx;
        ret;

      hdr_ps_sdr:
        // sRGB fallback: pal_series_color(series) -> default idx;
        // pal_default_rgb(default idx) -> 24-bit RGB.
        //
        // Alignment: entry to hdr_pick_series has rsp % 16 == 8 (SysV
        // "at CALL" contract). One push (rbx) brings us to rsp % 16
        // == 0 which is the required alignment at every nested CALL
        // site below. push saves the OUTER rbx on the stack so the
        // rbx REGISTER is free to use as a scratch for the RGB value
        // across the second call; pop rbx restores the outer value
        // before returning.
        push rbx;

        // series is already in rdi from the outer entry (unchanged
        // above; the readback path did not touch rdi).
        call pal_series_color;
        mov  rdi, rax;
        call pal_default_rgb;
        mov  rbx, rax;                           // save RGB in rbx-reg

        // sdr_picks += 1. r10 was clobbered by the nested calls so
        // recompute it against _hdr_state.
        lea  r10, [rip + _hdr_state];
        mov  rcx, [r10 + 40];
        add  rcx, 1;
        mov  [r10 + 40], rcx;

        mov  rax, rbx;                           // return RGB
        pop  rbx;
        ret;

      hdr_ps_ni:
        mov rdi, 0xFFFFEE4F;
        call hdr_set_err;
        mov rax, 0xFFFFEE4F;
        ret;
      hdr_ps_bs:
        mov rdi, 0xFFFFEE4E;
        call hdr_set_err;
        xor rax, rax;
        ret
      }
    }
}
