// src/kernel/core/semterm/gui_theme.pdx -- R44.M1-003 (#1402)
//
// SEMTERM GUI THEME. Theme + font registry for the R44 GUI shell.
// Exposes an enum of themes (light / dark / high-contrast), an enum
// of fonts (Iosevka default + monospace fallback), and a bounded
// integer font size. A change to any of these bumps a "persist
// pending" counter the session_log integration will flush; the
// actual session_log.append happens in a later widening.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the THEME + FONT SEAM for the GUI shell. gth_reset installs
// the default configuration (dark theme, Iosevka, 14pt); gth_theme_set
// / gth_font_set / gth_font_size_set update the choice after argument
// checks; gth_persist_pending() reports how many unflushed changes
// are queued; gth_persist_flush() clears the counter after a
// downstream session_log write.
//
// It does NOT rasterize glyphs. It does NOT own the SDF text stack
// or the color-space (G6) mapping tables -- theme_id / font_id are
// opaque enum tags a downstream renderer consumes. It does NOT write
// to session_log directly: gth_persist_flush() only clears the
// pending counter (returns the count just flushed); the actual
// slog_record call is a widening in a later round and keeps the
// audit tag out of this module the way session_log §1 records for
// SEMTERM_QUERY_EXEC.
//
// It is a SCAFFOLD (D7): R44.M1 wires it into the witness tree but
// no live renderer reads gth_theme_get and no live session_log
// forwarder drains gth_persist_flush; gth_arbitrated() returns 0
// until a later round hooks these seams into the toolkit.
//
// =============================================================================
// §1  ENUM AND SIZE MODEL
// =============================================================================
//
// Themes:
//   GTH_THEME_LIGHT         = 0
//   GTH_THEME_DARK          = 1     (default -- terminal is a night tool)
//   GTH_THEME_HIGH_CONTRAST = 2
//   GTH_THEME_MAX           = 2     (largest valid tag)
//
// Fonts:
//   GTH_FONT_IOSEVKA        = 0     (default -- ligature-safe monospace)
//   GTH_FONT_MONO_FALLBACK  = 1     (bitmap fallback)
//   GTH_FONT_MAX            = 1
//
// Font size is an integer in [GTH_SIZE_MIN, GTH_SIZE_MAX] = [8, 48].
// Values outside that range are refused with GTH_ERR_BAD_SIZE. A
// sub-8pt terminal is unreadable regardless of the SDF pipeline; a
// >48pt terminal is a size the shell's fixed-region layout cannot
// accommodate. Both boundaries are structural refusals rather than
// silent clamps so a corpus fixture can prove the extremities.
//
// =============================================================================
// §2  PERSISTENCE SEAM
// =============================================================================
//
// _gth_state carries a persist_pending counter incremented by every
// successful setter. A live session_log writer walks the seam:
//   pending := gth_persist_pending()
//   if pending > 0:
//     slog_record(GTH_HASH, pending, 0)  (deferred in R44+)
//     gth_persist_flush()
//
// gth_persist_flush() returns the count it just cleared so a caller
// can either bridge that number into the audit forwarder or record
// it as evidence in a diagnostic ring. gth_persist_pending is a
// plain read; gth_persist_flush is the write that resets pending
// to 0.
//
// =============================================================================
// §3  ONE WRITER OF THE STATE
// =============================================================================
//
// _gth_state is written only by helpers in this module. tools/build.sh
// confines relocations against it to `core/semterm/gui_theme.o`.
//
// STATE LAYOUT -- _gth_state : [u64; 8]
//   +0    init_mark          0x7DE3 once gth_reset has run
//   +8    err                sticky error latch
//   +16   theme_id           0..GTH_THEME_MAX (starts at GTH_THEME_DARK)
//   +24   font_id            0..GTH_FONT_MAX (starts at GTH_FONT_IOSEVKA)
//   +32   font_size          [GTH_SIZE_MIN, GTH_SIZE_MAX] (starts at 14)
//   +40   persist_pending    count of unflushed setter calls
//   +48   persist_flushed    running total of gth_persist_flush returns
//   +56   reserved           0
//
// =============================================================================
// §4  FAILURE TAXONOMY 0xFFFFEEB0..0xFFFFEEBF
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time. Adjacent used
// band above: gui_layout 0xFFFFEEC0..CF (R44.M1-002). Adjacent free
// band below: 0xFFFFEEA0..AF (unassigned).
//
//   GTH_OK            = 0
//   GTH_ERR_NOT_INIT  = 0xFFFFEEBF   accessor before gth_reset
//   GTH_ERR_BAD_THEME = 0xFFFFEEBE   theme_id > GTH_THEME_MAX
//   GTH_ERR_BAD_FONT  = 0xFFFFEEBD   font_id > GTH_FONT_MAX
//   GTH_ERR_BAD_SIZE  = 0xFFFFEEBC   size < 8 or size > 48
//   GTH_ERR_INTERNAL  = 0xFFFFEEBB   unreachable-fallthrough tripwire
//
// =============================================================================
// §5  ARITY DISCIPLINE
// =============================================================================
//
// gth_theme_set is (theme_id). gth_font_set is (font_id).
// gth_font_size_set is (size). Every readback is (). A widening (a
// per-tab theme override, a font-family fallback chain) is a
// widening of these arities.

module GuiTheme = structure {

  // Theme enum (§1).
  pub let GTH_THEME_LIGHT         : u64 = 0
  pub let GTH_THEME_DARK          : u64 = 1
  pub let GTH_THEME_HIGH_CONTRAST : u64 = 2
  pub let GTH_THEME_MAX           : u64 = 2

  // Font enum (§1).
  pub let GTH_FONT_IOSEVKA       : u64 = 0
  pub let GTH_FONT_MONO_FALLBACK : u64 = 1
  pub let GTH_FONT_MAX           : u64 = 1

  // Font size bounds (§1).
  pub let GTH_SIZE_MIN     : u64 = 8
  pub let GTH_SIZE_MAX     : u64 = 48
  pub let GTH_SIZE_DEFAULT : u64 = 14

  // Failure taxonomy (§4).
  pub let GTH_OK            : u64 = 0
  pub let GTH_ERR_NOT_INIT  : u64 = 0xFFFFEEBF
  pub let GTH_ERR_BAD_THEME : u64 = 0xFFFFEEBE
  pub let GTH_ERR_BAD_FONT  : u64 = 0xFFFFEEBD
  pub let GTH_ERR_BAD_SIZE  : u64 = 0xFFFFEEBC
  pub let GTH_ERR_INTERNAL  : u64 = 0xFFFFEEBB

  pub let GTH_INIT_MARK : u64 = 0x7DE3

  pub let mut _gth_state : [u64; 8] = uninit @align(64)

  // ==========================================================================
  // Reset. Boot + teardown. Installs the DARK / IOSEVKA / 14pt default.
  // ==========================================================================

  pub let gth_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M1-003 (#1402): clear state, install init_mark + DARK / IOSEVKA / 14pt defaults. Labels prefixed gth_rst_.",
      block: {
        lea r10, [rip + _gth_state];
        xor rax, rax;
        xor rcx, rcx;
      gth_rst_st:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  gth_rst_st;

        mov rax, 0x7DE3;
        mov [r10 + 0], rax;                      // init_mark
        mov rax, 1;
        mov [r10 + 16], rax;                     // theme = DARK
        xor rax, rax;
        mov [r10 + 24], rax;                     // font = IOSEVKA
        mov rax, 14;
        mov [r10 + 32], rax;                     // font_size = 14
        ret
      }
    } @no_frame

  pub let gth_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R44.M1-003 (#1402): honesty pin. Returns 0 until a live renderer consumes gth_theme_get and a live session_log writer drains gth_persist_flush.",
      block: {
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let gth_err : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M1-003 (#1402): sticky error latch readback.",
      block: {
        lea r10, [rip + _gth_state];
        mov rax, [r10 + 8];
        ret
      }
    } @no_frame

  pub let gth_bound : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M1-003 (#1402): 1 iff init_mark matches. Labels prefixed gth_bnd_.",
      block: {
        lea r10, [rip + _gth_state];
        mov rax, [r10 + 0];
        mov r11, 0x7DE3;
        cmp rax, r11;
        jne gth_bnd_no;
        mov rax, 1;
        ret;
      gth_bnd_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let gth_set_err : (u64) -> () !{mem} @{} =
    fn (code: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M1-003 (#1402): first-writer-wins error latch. Labels prefixed gth_se_.",
      block: {
        lea r10, [rip + _gth_state];
        mov rax, [r10 + 8];
        cmp rax, 0;
        jne gth_se_out;
        mov [r10 + 8], rdi;
      gth_se_out:
        ret
      }
    } @no_frame

  // ==========================================================================
  // Readbacks.
  // ==========================================================================

  pub let gth_theme_get : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M1-003 (#1402): theme_id field.",
      block: {
        lea r10, [rip + _gth_state];
        mov rax, [r10 + 16];
        ret
      }
    } @no_frame

  pub let gth_font_get : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M1-003 (#1402): font_id field.",
      block: {
        lea r10, [rip + _gth_state];
        mov rax, [r10 + 24];
        ret
      }
    } @no_frame

  pub let gth_font_size_get : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M1-003 (#1402): font_size field.",
      block: {
        lea r10, [rip + _gth_state];
        mov rax, [r10 + 32];
        ret
      }
    } @no_frame

  pub let gth_persist_pending : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M1-003 (#1402): persist_pending field.",
      block: {
        lea r10, [rip + _gth_state];
        mov rax, [r10 + 40];
        ret
      }
    } @no_frame

  pub let gth_persist_flushed : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M1-003 (#1402): persist_flushed running total.",
      block: {
        lea r10, [rip + _gth_state];
        mov rax, [r10 + 48];
        ret
      }
    } @no_frame

  // ==========================================================================
  // Setters. Each successful setter bumps persist_pending.
  // ==========================================================================

  pub let gth_theme_set : (u64) -> u64 !{mem} @{} =
    fn (theme_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M1-003 (#1402): store theme_id after enum check; bump persist_pending. Labels prefixed gth_ts_.",
      block: {
        lea r10, [rip + _gth_state];
        mov rax, [r10 + 0];
        mov r11, 0x7DE3;
        cmp rax, r11;
        jne gth_ts_ni;

        cmp rdi, 2;
        ja  gth_ts_bt;

        mov [r10 + 16], rdi;                     // theme_id
        mov rax, [r10 + 40];
        add rax, 1;
        mov [r10 + 40], rax;
        xor rax, rax;
        ret;

      gth_ts_ni:
        mov rdi, 0xFFFFEEBF;
        call gth_set_err;
        mov rax, 0xFFFFEEBF;
        ret;
      gth_ts_bt:
        mov rdi, 0xFFFFEEBE;
        call gth_set_err;
        mov rax, 0xFFFFEEBE;
        ret
      }
    }

  pub let gth_font_set : (u64) -> u64 !{mem} @{} =
    fn (font_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M1-003 (#1402): store font_id after enum check; bump persist_pending. Labels prefixed gth_fs_.",
      block: {
        lea r10, [rip + _gth_state];
        mov rax, [r10 + 0];
        mov r11, 0x7DE3;
        cmp rax, r11;
        jne gth_fs_ni;

        cmp rdi, 1;
        ja  gth_fs_bf;

        mov [r10 + 24], rdi;                     // font_id
        mov rax, [r10 + 40];
        add rax, 1;
        mov [r10 + 40], rax;
        xor rax, rax;
        ret;

      gth_fs_ni:
        mov rdi, 0xFFFFEEBF;
        call gth_set_err;
        mov rax, 0xFFFFEEBF;
        ret;
      gth_fs_bf:
        mov rdi, 0xFFFFEEBD;
        call gth_set_err;
        mov rax, 0xFFFFEEBD;
        ret
      }
    }

  pub let gth_font_size_set : (u64) -> u64 !{mem} @{} =
    fn (size: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M1-003 (#1402): store font_size after bounds check; bump persist_pending. Labels prefixed gth_ss_.",
      block: {
        lea r10, [rip + _gth_state];
        mov rax, [r10 + 0];
        mov r11, 0x7DE3;
        cmp rax, r11;
        jne gth_ss_ni;

        cmp rdi, 8;
        jb  gth_ss_bs;
        cmp rdi, 48;
        ja  gth_ss_bs;

        mov [r10 + 32], rdi;                     // font_size
        mov rax, [r10 + 40];
        add rax, 1;
        mov [r10 + 40], rax;
        xor rax, rax;
        ret;

      gth_ss_ni:
        mov rdi, 0xFFFFEEBF;
        call gth_set_err;
        mov rax, 0xFFFFEEBF;
        ret;
      gth_ss_bs:
        mov rdi, 0xFFFFEEBC;
        call gth_set_err;
        mov rax, 0xFFFFEEBC;
        ret
      }
    }

  // ==========================================================================
  // gth_persist_flush() -> u64
  //
  // Return the current persist_pending count and clear it. Bumps the
  // persist_flushed running total by the returned count. Refuses not
  // init.
  // ==========================================================================

  pub let gth_persist_flush : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M1-003 (#1402): drain persist_pending; add to persist_flushed. Labels prefixed gth_pf_.",
      block: {
        lea r10, [rip + _gth_state];
        mov rax, [r10 + 0];
        mov r11, 0x7DE3;
        cmp rax, r11;
        jne gth_pf_ni;

        mov r8, [r10 + 40];                      // pending
        xor rax, rax;
        mov [r10 + 40], rax;                     // pending = 0

        mov rax, [r10 + 48];                     // flushed total
        add rax, r8;
        mov [r10 + 48], rax;

        mov rax, r8;                             // return pending
        ret;

      gth_pf_ni:
        mov rdi, 0xFFFFEEBF;
        call gth_set_err;
        mov rax, 0xFFFFEEBF;
        ret
      }
    }
}
