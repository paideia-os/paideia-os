// src/kernel/core/semterm/sources.pdx -- R41.M2-002 (#1369)
//
// TYPED DATA-SOURCE REGISTRY for the semantic terminal. Every table
// the query engine can name in FROM is a row in this registry; each
// row binds a name hash to a (schema_id, provider_fn, cap_slot)
// triple. The engine resolves a FROM identifier by looking up the
// name hash, and the resulting source_id is what its scan iterator
// consumes.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the NAME->SOURCE index. src_register installs a row; the
// engine's src_lookup(name_hash) returns a source_id or 0. The
// module owns nothing about the data itself -- the provider function
// pointer is invoked by the engine (in a later round, once the
// live consumer paths land) and yields rows into the result-set
// buffer.
//
// Every row is BOUND TO A CAPABILITY SLOT (cap_slot: 0 = none, or an
// index into the caller's KIND_CAP_* table). The engine refuses to
// scan a source whose cap_slot is non-zero unless a live capability
// is present at that slot; boot registration passes cap_slot = 0 for
// the audit / dmesg-adjacent internal sources whose reads are unions
// of authorised streams the kernel already owns.
//
// It does NOT invoke the provider. It does NOT allocate for the
// caller. It does NOT decode schema. The engine (semterm/engine.pdx)
// is the only consumer of these fields.
//
// It is a SCAFFOLD (D7): R41.M2 wires it into the witness tree but
// no live query drives it; src_arbitrated() returns 0 until a later
// round hooks the engine's scan_open into the registered providers.
//
// =============================================================================
// §1  PRE-REGISTERED SOURCES
// =============================================================================
//
// Five sources open at reset (src_reset pre-populates them):
//
//   SRC_SYSCALLS    (1)   the audit-emit-shaped syscall trace stream
//                          schema_id = 1, cap_slot = 0
//   SRC_CAPS        (2)   the process capability table
//                          schema_id = 2, cap_slot = 0
//   SRC_TASKS       (3)   the scheduler task table
//                          schema_id = 3, cap_slot = 0
//   SRC_INTERRUPTS  (4)   the interrupt-source table
//                          schema_id = 4, cap_slot = 0
//   SRC_AUDIT       (5)   the audit ring
//                          schema_id = 5, cap_slot = 0
//
// A live provider function is INSTALLED LATER; the boot pre-register
// stores 0 in the provider slot, and src_get_provider(id) returning
// 0 is a legitimate scan-refusal cause the engine translates into
// its own SCAN_UNBOUND code. Widening the pre-registered set is a
// widening of this module's own constants -- not a caller-supplied
// row.
//
// Additional user-defined sources may be installed after boot via
// src_register; the registry cap is SRC_MAX_SLOTS = 16. Registering
// the 17th is refused with SRC_ERR_FULL.
//
// The name hash is CALLER-SUPPLIED and CALLER-DEFINED: any 64-bit
// function will do as long as the same function is used at register
// and at lookup. This keeps the registry identifier-representation-
// agnostic (FNV-1a or CRC64 or another; the pre-registered names use
// the placeholder hashes 0xA100..0xA104 documented in the witness
// header).
//
// =============================================================================
// §2  ONE WRITER OF THE STATE
// =============================================================================
//
// _src_table and _src_state are written only by helpers in this
// module. tools/build.sh confines relocations against each to
// `core/semterm/sources.o`.
//
// TABLE LAYOUT -- _src_table : [u64; 64]  (= 16 slots * 4 fields)
//
//   slot(i) = _src_table[i * 4 .. i * 4 + 3]
//     +0   name_hash    caller-supplied 64-bit identifier
//     +8   schema_id    caller-supplied schema tag (0 = unbound row)
//     +16  provider     function pointer; 0 = no live provider yet
//     +24  cap_slot     0 = no capability required; non-zero =
//                       KIND_CAP_* slot the engine must hold
//
// STATE LAYOUT -- _src_state : [u64; 8]
//   +0   count        number of live rows in _src_table (0..16)
//   +8   err          sticky error latch
//   +16  init_mark    0x50AC once src_reset has run
//   +24  reserved     (three cells reserved for a per-round scan stat)
//
// A slot(0) row is RESERVED to mean "no source", so src_lookup can
// return 0 to signal SRC_ERR_NOT_FOUND without a special sentinel.
// Live rows start at slot(1).
//
// =============================================================================
// §3  FAILURE TAXONOMY 0xFFFFF0A0..0xFFFFF0AF
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time. Adjacent used
// band above: BT ATT 0xFFFFF0C0..CF. Adjacent used band below:
// engine 0xFFFFF0B0..BF (R41.M2-001). Result-set band below that:
// 0xFFFFF090..9F.
//
//   SRC_OK             = 0
//   SRC_ERR_NOT_INIT   = 0xFFFFF0AF   src_register/lookup without src_reset
//   SRC_ERR_FULL       = 0xFFFFF0AE   registry has no free slot
//   SRC_ERR_DUP        = 0xFFFFF0AD   name_hash already registered
//   SRC_ERR_NOT_FOUND  = 0xFFFFF0AC   lookup: no row with that name_hash
//   SRC_ERR_BAD_ID     = 0xFFFFF0AB   source_id outside [1, count]
//   SRC_ERR_BAD_SCHEMA = 0xFFFFF0AA   schema_id == 0 rejected
//   SRC_ERR_BAD_HASH   = 0xFFFFF0A9   name_hash == 0 rejected
//   SRC_ERR_INTERNAL   = 0xFFFFF0A8   unreachable-fallthrough tripwire
//
// =============================================================================
// §4  ARITY DISCIPLINE
// =============================================================================
//
// src_register takes ALL FOUR row fields as caller-visible arguments
// (name_hash, schema_id, provider, cap_slot). A widening would let a
// caller install a row shape a future rule would refuse; every
// additional field must appear in the arity pin here and in the
// build.sh gate below, or a caller cannot smuggle it in.

module Sources = structure {

  // Pre-registered source-ids (§1).
  pub let SRC_NONE       : u64 = 0
  pub let SRC_SYSCALLS   : u64 = 1
  pub let SRC_CAPS       : u64 = 2
  pub let SRC_TASKS      : u64 = 3
  pub let SRC_INTERRUPTS : u64 = 4
  pub let SRC_AUDIT      : u64 = 5

  // Placeholder name hashes for the pre-registered sources (§1).
  pub let SRC_H_SYSCALLS   : u64 = 0xA100
  pub let SRC_H_CAPS       : u64 = 0xA101
  pub let SRC_H_TASKS      : u64 = 0xA102
  pub let SRC_H_INTERRUPTS : u64 = 0xA103
  pub let SRC_H_AUDIT      : u64 = 0xA104

  pub let SRC_MAX_SLOTS : u64 = 16
  pub let SRC_ROW_WORDS : u64 = 4                // (hash, schema, provider, cap)

  // Failure taxonomy (§3).
  pub let SRC_OK             : u64 = 0
  pub let SRC_ERR_NOT_INIT   : u64 = 0xFFFFF0AF
  pub let SRC_ERR_FULL       : u64 = 0xFFFFF0AE
  pub let SRC_ERR_DUP        : u64 = 0xFFFFF0AD
  pub let SRC_ERR_NOT_FOUND  : u64 = 0xFFFFF0AC
  pub let SRC_ERR_BAD_ID     : u64 = 0xFFFFF0AB
  pub let SRC_ERR_BAD_SCHEMA : u64 = 0xFFFFF0AA
  pub let SRC_ERR_BAD_HASH   : u64 = 0xFFFFF0A9
  pub let SRC_ERR_INTERNAL   : u64 = 0xFFFFF0A8

  pub let SRC_INIT_MARK : u64 = 0x50AC

  pub let mut _src_table : [u64; 64] = uninit @align(64)   // 16 * 4
  pub let mut _src_state : [u64; 8]  = uninit @align(64)

  // ==========================================================================
  // Reset. Boot + teardown. Also PRE-REGISTERS the five kernel sources.
  // ==========================================================================

  pub let src_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M2-002 (#1369): clear registry + state, install init_mark, pre-register five kernel sources at slots 1..5. Labels prefixed src_rst_.",
      block: {
        lea r10, [rip + _src_table];
        xor rax, rax;
        xor rcx, rcx;
      src_rst_tbl:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 64;
        jb  src_rst_tbl;

        lea r10, [rip + _src_state];
        xor rcx, rcx;
      src_rst_st:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  src_rst_st;

        // init_mark + count = 1 (slot 0 reserved).
        mov rax, 0x50AC;
        mov [r10 + 16], rax;
        mov rax, 1;
        mov [r10 + 0], rax;

        // Pre-register the five kernel sources at slots 1..5.
        // Row layout: [hash, schema, provider=0, cap_slot=0].
        lea r10, [rip + _src_table];

        // slot 1: SYSCALLS  hash=0xA100 schema=1.
        mov rax, 0xA100;
        mov [r10 + 32], rax;                     // 1*4*8 = 32
        mov rax, 1;
        mov [r10 + 40], rax;

        // slot 2: CAPS  hash=0xA101 schema=2.
        mov rax, 0xA101;
        mov [r10 + 64], rax;
        mov rax, 2;
        mov [r10 + 72], rax;

        // slot 3: TASKS  hash=0xA102 schema=3.
        mov rax, 0xA102;
        mov [r10 + 96], rax;
        mov rax, 3;
        mov [r10 + 104], rax;

        // slot 4: INTERRUPTS  hash=0xA103 schema=4.
        mov rax, 0xA103;
        mov [r10 + 128], rax;
        mov rax, 4;
        mov [r10 + 136], rax;

        // slot 5: AUDIT  hash=0xA104 schema=5.
        mov rax, 0xA104;
        mov [r10 + 160], rax;
        mov rax, 5;
        mov [r10 + 168], rax;

        // Bump count to 6 (slots 0..5 populated).
        lea r10, [rip + _src_state];
        mov rax, 6;
        mov [r10 + 0], rax;
        ret
      }
    }

  pub let src_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R41.M2-002 (#1369): honesty pin. Returns 0 until a live query drives src_lookup from the engine.",
      block: {
        xor rax, rax;
        ret
      }
    }

  pub let src_err : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M2-002 (#1369): sticky error latch readback. Labels prefixed src_er_.",
      block: {
        lea r10, [rip + _src_state];
        mov rax, [r10 + 8];
        ret
      }
    }

  pub let src_bound : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M2-002 (#1369): 1 iff init_mark matches. Labels prefixed src_bnd_.",
      block: {
        lea r10, [rip + _src_state];
        mov rax, [r10 + 16];
        mov r11, 0x50AC;
        cmp rax, r11;
        jne src_bnd_no;
        mov rax, 1;
        ret;
      src_bnd_no:
        xor rax, rax;
        ret
      }
    }

  pub let src_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M2-002 (#1369): registry live-slot count (includes slot 0 reserved). Labels prefixed src_cnt_.",
      block: {
        lea r10, [rip + _src_state];
        mov rax, [r10 + 0];
        ret
      }
    }

  pub let src_set_err : (u64) -> () !{mem} @{} =
    fn (code: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M2-002 (#1369): first-writer-wins error latch. Labels prefixed src_se_.",
      block: {
        lea r10, [rip + _src_state];
        mov rax, [r10 + 8];
        cmp rax, 0;
        jne src_se_out;
        mov [r10 + 8], rdi;
      src_se_out:
        ret
      }
    }

  // ==========================================================================
  // src_register(name_hash, schema_id, provider, cap_slot) -> source_id | 0
  //
  // Install one row. Refuses:
  //   - init_mark unset             SRC_ERR_NOT_INIT
  //   - registry full               SRC_ERR_FULL
  //   - name_hash == 0              SRC_ERR_BAD_HASH
  //   - schema_id == 0              SRC_ERR_BAD_SCHEMA
  //   - name_hash already present   SRC_ERR_DUP
  //
  // On success returns the new source_id (the row's slot index).
  //
  // Locals: rbx=name_hash, r12=schema_id, r13=provider, r14=cap_slot,
  //         r15=slot_index.
  // ==========================================================================

  pub let src_register : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (name_hash: u64, schema_id: u64, provider: u64, cap_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M2-002 (#1369): install a source row. Uses lea r9,[base + r8*8] to synthesise the row base pointer per iteration (assembler accepts base+index*scale but not base+index+disp); the four field stores then use pure [reg+disp]. Labels prefixed src_rg_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        mov rbx, rdi;
        mov r12, rsi;
        mov r13, rdx;
        mov r14, rcx;

        lea r10, [rip + _src_state];
        mov rax, [r10 + 16];
        mov r11, 0x50AC;
        cmp rax, r11;
        jne src_rg_ni;

        cmp rbx, 0;
        je  src_rg_bh;
        cmp r12, 0;
        je  src_rg_bs;

        // Duplicate scan.
        mov rax, [r10 + 0];                      // count
        mov r15, rax;                            // save count -> tentative slot
        mov rcx, 1;
      src_rg_dup:
        cmp rcx, r15;
        jae src_rg_dup_done;
        lea r9, [rip + _src_table];
        mov r8, rcx;
        shl r8, 2;                               // slot * 4 words
        lea r9, [r9 + r8 * 8];                   // row base
        mov r11, [r9 + 0];                       // stored hash
        cmp r11, rbx;
        je  src_rg_dup_hit;
        add rcx, 1;
        jmp src_rg_dup;
      src_rg_dup_done:
        cmp r15, 16;                             // SRC_MAX_SLOTS
        jae src_rg_full;

        // Install at slot r15.
        lea r9, [rip + _src_table];
        mov r8, r15;
        shl r8, 2;                               // slot * 4 words
        lea r9, [r9 + r8 * 8];                   // row base
        mov [r9 + 0], rbx;                       // hash
        mov [r9 + 8], r12;                       // schema
        mov [r9 + 16], r13;                      // provider
        mov [r9 + 24], r14;                      // cap_slot

        // count++
        lea r10, [rip + _src_state];
        mov rax, r15;
        add rax, 1;
        mov [r10 + 0], rax;

        mov rax, r15;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      src_rg_ni:
        mov rdi, 0xFFFFF0AF;
        call src_set_err;
        xor rax, rax;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;
      src_rg_bh:
        mov rdi, 0xFFFFF0A9;
        call src_set_err;
        xor rax, rax;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;
      src_rg_bs:
        mov rdi, 0xFFFFF0AA;
        call src_set_err;
        xor rax, rax;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;
      src_rg_dup_hit:
        mov rdi, 0xFFFFF0AD;
        call src_set_err;
        xor rax, rax;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;
      src_rg_full:
        mov rdi, 0xFFFFF0AE;
        call src_set_err;
        xor rax, rax;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // src_lookup(name_hash) -> source_id | 0
  //
  // Linear scan for name_hash. Returns 0 (SRC_NONE) if not found;
  // does NOT latch an error -- lookup by shape is a legitimate query
  // shape. Refuses only on init unset.
  // ==========================================================================

  pub let src_lookup : (u64) -> u64 !{mem} @{} =
    fn (name_hash: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M2-002 (#1369): linear scan for name hash. Uses [base + index*scale] with index = slot*4 words so the hash field (offset 0 in each row) is addressable without base+index+disp. Labels prefixed src_lk_.",
      block: {
        lea r10, [rip + _src_state];
        mov rax, [r10 + 16];
        mov r11, 0x50AC;
        cmp rax, r11;
        jne src_lk_ni;

        mov r8, [r10 + 0];                       // count
        lea r9, [rip + _src_table];
        mov rcx, 1;
      src_lk_scan:
        cmp rcx, r8;
        jae src_lk_no;
        mov r11, rcx;
        shl r11, 2;                              // slot * 4 words
        mov rax, [r9 + r11 * 8];                 // stored hash at field 0
        cmp rax, rdi;
        je  src_lk_hit;
        add rcx, 1;
        jmp src_lk_scan;
      src_lk_hit:
        mov rax, rcx;
        ret;
      src_lk_no:
        xor rax, rax;
        ret;
      src_lk_ni:
        mov rdi, 0xFFFFF0AF;
        call src_set_err;
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // src_get_schema(src_id) / src_get_provider(src_id) / src_get_cap(src_id).
  //
  // Return the stored field, or 0 if src_id is out of range.
  // ==========================================================================

  pub let src_get_schema : (u64) -> u64 !{mem} @{} =
    fn (src_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M2-002 (#1369): read schema_id field via lea + [reg+disp]. Labels prefixed src_gs_.",
      block: {
        lea r10, [rip + _src_state];
        mov r8, [r10 + 0];
        cmp rdi, 1;
        jb  src_gs_bad;
        cmp rdi, r8;
        jae src_gs_bad;
        lea r10, [rip + _src_table];
        mov r11, rdi;
        shl r11, 2;                              // slot * 4 words
        lea r10, [r10 + r11 * 8];                // row base
        mov rax, [r10 + 8];                      // schema at offset +8
        ret;
      src_gs_bad:
        mov rdi, 0xFFFFF0AB;
        call src_set_err;
        xor rax, rax;
        ret
      }
    }

  pub let src_get_provider : (u64) -> u64 !{mem} @{} =
    fn (src_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M2-002 (#1369): read provider fn ptr via lea + [reg+disp]. Labels prefixed src_gp_.",
      block: {
        lea r10, [rip + _src_state];
        mov r8, [r10 + 0];
        cmp rdi, 1;
        jb  src_gp_bad;
        cmp rdi, r8;
        jae src_gp_bad;
        lea r10, [rip + _src_table];
        mov r11, rdi;
        shl r11, 2;                              // slot * 4 words
        lea r10, [r10 + r11 * 8];                // row base
        mov rax, [r10 + 16];                     // provider at offset +16
        ret;
      src_gp_bad:
        mov rdi, 0xFFFFF0AB;
        call src_set_err;
        xor rax, rax;
        ret
      }
    }

  pub let src_get_cap : (u64) -> u64 !{mem} @{} =
    fn (src_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M2-002 (#1369): read cap_slot field via lea + [reg+disp]. Labels prefixed src_gc_.",
      block: {
        lea r10, [rip + _src_state];
        mov r8, [r10 + 0];
        cmp rdi, 1;
        jb  src_gc_bad;
        cmp rdi, r8;
        jae src_gc_bad;
        lea r10, [rip + _src_table];
        mov r11, rdi;
        shl r11, 2;                              // slot * 4 words
        lea r10, [r10 + r11 * 8];                // row base
        mov rax, [r10 + 24];                     // cap_slot at offset +24
        ret;
      src_gc_bad:
        mov rdi, 0xFFFFF0AB;
        call src_set_err;
        xor rax, rax;
        ret
      }
    }
}
