// src/kernel/core/semterm/lexer.pdx -- R41.M1-001 (#1365)
//
// Command LEXER for the semantic terminal. Opens R41 (semantic terminal
// framebuffer frontend) with the shared semantic-term-core backend.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the TOKEN CURSOR over a caller-supplied byte buffer holding a
// SQL-adjacent query string. It scans one token at a time on demand,
// classifies it into a small union (KEYWORD / IDENT / INTLIT / STRLIT /
// OP / punctuation / EOF), and records the token's byte range as
// (start, len) into the input buffer so the parser can name-check and
// literal-decode without a second scan.
//
// It does NOT allocate anything on its own -- the caller owns the input
// buffer, and the token record is a single (kind, start, len) tuple
// updated in place per lex_next call. It does NOT decode literal
// values (that is the parser's job when it builds a Literal AST node);
// it decides ONLY what shape the token has. And it does NOT interpret
// keywords case-insensitively -- SQL-adjacent means "keywords are
// UPPERCASE in the grammar", which is checked against a small keyword
// table by exact byte match.
//
// The lexer is a SCAFFOLD in the D7 sense: R41.M1 wires it into the
// witness tree but no live command path calls it yet -- the terminal
// frontend that consumes it opens in R41.M2+. lex_arbitrated() returns
// 0 until a later round binds it to a live keyboard input path.
//
// =============================================================================
// §1  TOKEN UNION
// =============================================================================
//
//   TOK_EOF        (0)   end of input
//   TOK_KW_SELECT  (1)   the six SQL keywords + logical / comparison words:
//   TOK_KW_FROM    (2)   SELECT, FROM, WHERE, JOIN, GROUP, ORDER, LIMIT,
//   TOK_KW_WHERE   (3)   AS, ASC, DESC, AND, OR, NOT, IN, LIKE, BETWEEN
//   TOK_KW_JOIN    (4)
//   TOK_KW_GROUP   (5)
//   TOK_KW_ORDER   (6)
//   TOK_KW_LIMIT   (7)
//   TOK_KW_AS      (8)
//   TOK_KW_ASC     (9)
//   TOK_KW_DESC    (10)
//   TOK_KW_AND     (11)
//   TOK_KW_OR      (12)
//   TOK_KW_NOT     (13)
//   TOK_KW_IN      (14)
//   TOK_KW_LIKE    (15)
//   TOK_KW_BETWEEN (16)
//   TOK_IDENT      (17)  ASCII identifier -- first char [A-Za-z_], rest
//                        [A-Za-z_0-9]. Refused as TOO_LONG past 32 bytes.
//   TOK_INTLIT     (18)  decimal digit run.
//   TOK_STRLIT     (19)  single-quoted literal. Doubled '' is not
//                        handled at this milestone; a bare ' inside a
//                        string is UNTERMINATED_STR.
//   TOK_OP_EQ      (20)  '='
//   TOK_OP_LT      (21)  '<'
//   TOK_OP_GT      (22)  '>'
//   TOK_OP_LE      (23)  '<='
//   TOK_OP_GE      (24)  '>='
//   TOK_OP_NE      (25)  '<>'
//   TOK_OP_STAR    (26)  '*'
//   TOK_OP_PLUS    (27)  '+'
//   TOK_OP_MINUS   (28)  '-'
//   TOK_LPAREN     (29)  '('
//   TOK_RPAREN     (30)  ')'
//   TOK_COMMA      (31)  ','
//   TOK_DOT        (32)  '.'
//   TOK_SEMI       (33)  ';'
//
// The union is closed at the lexer boundary. A parser that receives a
// value outside [0, 33] is looking at a corrupted state cell rather
// than a token the lexer produced.
//
// =============================================================================
// §2  ONE WRITER OF THE STATE
// =============================================================================
//
// _lex_state and _lex_stats are written only by helpers in this module.
// tools/build.sh confines relocations against each to
// `core/semterm/lexer.o`.
//
// STATE LAYOUT -- _lex_state : [u64; 8]
//   +0   buf         base of the input byte buffer
//   +8   len         input length in bytes
//   +16  pos         cursor, always in [0, len]
//   +24  tok_kind    last token kind produced (from §1)
//   +32  tok_start   byte offset in buf of the token's first byte
//   +40  tok_len     token length in bytes
//   +48  err         sticky error code (0 = LEX_OK)
//   +56  init_mark   0xB1A5 once lex_bind has run
//
// =============================================================================
// §3  FAILURE TAXONOMY 0xFFFFF170..0xFFFFF17F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band. Adjacent used band above: audit_schema
// 0xFFFFF180..8F (R40.M5-001). Adjacent free band below: parser
// 0xFFFFF160..6F (R41.M1-002).
//
//   LEX_OK                = 0
//   LEX_ERR_UNKNOWN_CHAR  = 0xFFFFF17F   byte outside the lexer's alphabet
//   LEX_ERR_UNTERMINATED  = 0xFFFFF17E   ' opened, not closed before EOF
//   LEX_ERR_INT_OVERFLOW  = 0xFFFFF17D   decimal digit run > 20 bytes
//   LEX_ERR_TOO_LONG      = 0xFFFFF17C   IDENT run > 32 bytes
//   LEX_ERR_NOT_BOUND     = 0xFFFFF17B   lex_next called without lex_bind
//   LEX_ERR_BAD_INPUT     = 0xFFFFF17A   buf == 0 || len > 2^31
//   LEX_ERR_INTERNAL      = 0xFFFFF179   unreachable-fallthrough tripwire
//
// =============================================================================
// §4  ARITY DISCIPLINE
// =============================================================================
//
// Every entry point takes at most the caller-visible arguments its
// contract names. In particular lex_next takes ZERO arguments -- it
// scans from the cursor stored in _lex_state, so a caller cannot smuggle
// a fabricated position by widening the call site.

module Lexer = structure {

  // Token kinds (§1).
  pub let TOK_EOF        : u64 = 0
  pub let TOK_KW_SELECT  : u64 = 1
  pub let TOK_KW_FROM    : u64 = 2
  pub let TOK_KW_WHERE   : u64 = 3
  pub let TOK_KW_JOIN    : u64 = 4
  pub let TOK_KW_GROUP   : u64 = 5
  pub let TOK_KW_ORDER   : u64 = 6
  pub let TOK_KW_LIMIT   : u64 = 7
  pub let TOK_KW_AS      : u64 = 8
  pub let TOK_KW_ASC     : u64 = 9
  pub let TOK_KW_DESC    : u64 = 10
  pub let TOK_KW_AND     : u64 = 11
  pub let TOK_KW_OR      : u64 = 12
  pub let TOK_KW_NOT     : u64 = 13
  pub let TOK_KW_IN      : u64 = 14
  pub let TOK_KW_LIKE    : u64 = 15
  pub let TOK_KW_BETWEEN : u64 = 16
  pub let TOK_IDENT      : u64 = 17
  pub let TOK_INTLIT     : u64 = 18
  pub let TOK_STRLIT     : u64 = 19
  pub let TOK_OP_EQ      : u64 = 20
  pub let TOK_OP_LT      : u64 = 21
  pub let TOK_OP_GT      : u64 = 22
  pub let TOK_OP_LE      : u64 = 23
  pub let TOK_OP_GE      : u64 = 24
  pub let TOK_OP_NE      : u64 = 25
  pub let TOK_OP_STAR    : u64 = 26
  pub let TOK_OP_PLUS    : u64 = 27
  pub let TOK_OP_MINUS   : u64 = 28
  pub let TOK_LPAREN     : u64 = 29
  pub let TOK_RPAREN     : u64 = 30
  pub let TOK_COMMA      : u64 = 31
  pub let TOK_DOT        : u64 = 32
  pub let TOK_SEMI       : u64 = 33
  pub let TOK_MAX        : u64 = 33

  // Length caps (§3).
  pub let LEX_IDENT_MAX  : u64 = 32
  pub let LEX_INT_MAX    : u64 = 20
  pub let LEX_INPUT_MAX  : u64 = 0x80000000            // 2^31

  // Failure taxonomy (§3).
  pub let LEX_OK                : u64 = 0
  pub let LEX_ERR_UNKNOWN_CHAR  : u64 = 0xFFFFF17F
  pub let LEX_ERR_UNTERMINATED  : u64 = 0xFFFFF17E
  pub let LEX_ERR_INT_OVERFLOW  : u64 = 0xFFFFF17D
  pub let LEX_ERR_TOO_LONG      : u64 = 0xFFFFF17C
  pub let LEX_ERR_NOT_BOUND     : u64 = 0xFFFFF17B
  pub let LEX_ERR_BAD_INPUT     : u64 = 0xFFFFF17A
  pub let LEX_ERR_INTERNAL      : u64 = 0xFFFFF179

  pub let LEX_INIT_MARK  : u64 = 0xB1A5

  pub let mut _lex_state : [u64; 8] = uninit @align(64)
  pub let mut _lex_stats : [u64; 8] = uninit @align(64)

  pub let LEX_ST_BINDS        : u64 = 0
  pub let LEX_ST_TOKENS       : u64 = 1
  pub let LEX_ST_KEYWORDS     : u64 = 2
  pub let LEX_ST_REFUSED      : u64 = 3
  pub let LEX_ST_STRLITS      : u64 = 4
  pub let LEX_ST_INTLITS      : u64 = 5

  // ==========================================================================
  // Reset. Boot + teardown.
  // ==========================================================================

  pub let lex_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M1-001 (#1365): clear state + stats. Labels prefixed lex_rs_.",
      block: {
        lea r10, [rip + _lex_state];
        xor rax, rax;
        xor rcx, rcx;
      lex_rs_st:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  lex_rs_st;

        lea r10, [rip + _lex_stats];
        xor rcx, rcx;
      lex_rs_ct:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  lex_rs_ct;
        ret
      }
    }

  pub let lex_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R41.M1-001 (#1365): honesty pin. Returns 0 until the terminal frontend wires keyboard input into lex_bind.",
      block: {
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Counter primitives.
  // ==========================================================================

  pub let lex_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M1-001 (#1365): counter bump. Labels prefixed lex_nt_.",
      block: {
        cmp rdi, 8;
        jae lex_nt_out;
        lea r10, [rip + _lex_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      lex_nt_out:
        ret
      }
    }

  pub let lex_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M1-001 (#1365): counter read. Labels prefixed lex_stt_.",
      block: {
        cmp rdi, 8;
        jae lex_stt_zero;
        lea r10, [rip + _lex_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      lex_stt_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Character classifiers. Each takes a byte in rdi[7:0] (zero-extended)
  // and returns 1 iff in class, else 0.
  // ==========================================================================

  pub let lex_is_space : (u64) -> u64 !{} @{} =
    fn (c: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R41.M1-001 (#1365): SP/TAB/LF/CR classifier. Labels prefixed lex_isp_.",
      block: {
        cmp rdi, 32;                    // ' '
        je  lex_isp_yes;
        cmp rdi, 9;                     // TAB
        je  lex_isp_yes;
        cmp rdi, 10;                    // LF
        je  lex_isp_yes;
        cmp rdi, 13;                    // CR
        je  lex_isp_yes;
        xor rax, rax;
        ret;
      lex_isp_yes:
        mov rax, 1;
        ret
      }
    }

  pub let lex_is_digit : (u64) -> u64 !{} @{} =
    fn (c: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R41.M1-001 (#1365): [0-9] classifier. Labels prefixed lex_idg_.",
      block: {
        cmp rdi, 48;                    // '0'
        jb  lex_idg_no;
        cmp rdi, 57;                    // '9'
        ja  lex_idg_no;
        mov rax, 1;
        ret;
      lex_idg_no:
        xor rax, rax;
        ret
      }
    }

  pub let lex_is_alpha : (u64) -> u64 !{} @{} =
    fn (c: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R41.M1-001 (#1365): [A-Za-z_] classifier -- underscore admitted, mixing case is admitted here (case-folding is the keyword matcher's job, not the alphabet's). Labels prefixed lex_iap_.",
      block: {
        cmp rdi, 95;                    // '_'
        je  lex_iap_yes;
        cmp rdi, 65;                    // 'A'
        jb  lex_iap_lc;
        cmp rdi, 90;                    // 'Z'
        jbe lex_iap_yes;
      lex_iap_lc:
        cmp rdi, 97;                    // 'a'
        jb  lex_iap_no;
        cmp rdi, 122;                   // 'z'
        ja  lex_iap_no;
      lex_iap_yes:
        mov rax, 1;
        ret;
      lex_iap_no:
        xor rax, rax;
        ret
      }
    }

  pub let lex_is_alnum : (u64) -> u64 !{} @{} =
    fn (c: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R41.M1-001 (#1365): identifier-continuation classifier. Labels prefixed lex_ian_.",
      block: {
        push rbx;
        mov rbx, rdi;
        call lex_is_alpha;
        cmp rax, 1;
        je  lex_ian_yes;
        mov rdi, rbx;
        call lex_is_digit;
        cmp rax, 1;
        je  lex_ian_yes;
        xor rax, rax;
        pop rbx;
        ret;
      lex_ian_yes:
        mov rax, 1;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // lex_bind(buf, len) -> u64  { LEX_OK | LEX_ERR_BAD_INPUT }
  //
  // Point the cursor at a fresh input. Refuses buf == 0 or len above
  // LEX_INPUT_MAX so a caller cannot ask the lexer to walk a
  // caller-supplied width the input buffer cannot possibly satisfy.
  // ==========================================================================

  pub let lex_bind : (u64, u64) -> u64 !{mem} @{} =
    fn (buf: u64, len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M1-001 (#1365): install cursor. rdi=buf, rsi=len. On BAD_INPUT the state stays unbound (init_mark left 0). Labels prefixed lex_bd_.",
      block: {
        cmp rdi, 0;
        je  lex_bd_bad;
        mov r10, 0x80000000;            // LEX_INPUT_MAX
        cmp rsi, r10;
        jae lex_bd_bad;

        lea r10, [rip + _lex_state];
        mov [r10 + 0], rdi;             // buf
        mov [r10 + 8], rsi;             // len
        xor rax, rax;
        mov [r10 + 16], rax;            // pos
        mov [r10 + 24], rax;            // tok_kind
        mov [r10 + 32], rax;            // tok_start
        mov [r10 + 40], rax;            // tok_len
        mov [r10 + 48], rax;            // err
        mov rax, 0xB1A5;                // LEX_INIT_MARK
        mov [r10 + 56], rax;

        mov rdi, 0;                     // LEX_ST_BINDS
        call lex_note;
        xor rax, rax;
        ret;

      lex_bd_bad:
        mov rdi, 3;                     // LEX_ST_REFUSED
        call lex_note;
        mov rax, 0xFFFFF17A;
        ret
      }
    }

  // ==========================================================================
  // Small readbacks over _lex_state. Each is a single-line accessor so a
  // caller that spelunks the state directly reads through a symbol the
  // confinement gate polices rather than through a raw offset.
  // ==========================================================================

  pub let lex_pos : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M1-001 (#1365): current cursor. Labels prefixed lex_ps_.",
      block: {
        lea r10, [rip + _lex_state];
        mov rax, [r10 + 16];
        ret
      }
    }

  pub let lex_len : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M1-001 (#1365): input length. Labels prefixed lex_ln_.",
      block: {
        lea r10, [rip + _lex_state];
        mov rax, [r10 + 8];
        ret
      }
    }

  pub let lex_tok_kind : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M1-001 (#1365): last token kind. Labels prefixed lex_tk_.",
      block: {
        lea r10, [rip + _lex_state];
        mov rax, [r10 + 24];
        ret
      }
    }

  pub let lex_tok_start : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M1-001 (#1365): token start offset. Labels prefixed lex_ts_.",
      block: {
        lea r10, [rip + _lex_state];
        mov rax, [r10 + 32];
        ret
      }
    }

  pub let lex_tok_len : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M1-001 (#1365): token length. Labels prefixed lex_tl_.",
      block: {
        lea r10, [rip + _lex_state];
        mov rax, [r10 + 40];
        ret
      }
    }

  pub let lex_err : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M1-001 (#1365): sticky error latch. Labels prefixed lex_er_.",
      block: {
        lea r10, [rip + _lex_state];
        mov rax, [r10 + 48];
        ret
      }
    }

  pub let lex_bound : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M1-001 (#1365): 1 iff init_mark matches. Labels prefixed lex_bn_.",
      block: {
        lea r10, [rip + _lex_state];
        mov rax, [r10 + 56];
        mov r11, 0xB1A5;
        cmp rax, r11;
        jne lex_bn_no;
        mov rax, 1;
        ret;
      lex_bn_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // lex_set_err(code) -- latch sticky error (first writer wins).
  // ==========================================================================

  pub let lex_set_err : (u64) -> () !{mem} @{} =
    fn (code: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M1-001 (#1365): first-writer-wins error latch. Labels prefixed lex_se_.",
      block: {
        lea r10, [rip + _lex_state];
        mov rax, [r10 + 48];
        cmp rax, 0;
        jne lex_se_out;
        mov [r10 + 48], rdi;
      lex_se_out:
        ret
      }
    }

  // ==========================================================================
  // lex_peek() -- byte at pos, or 0 at EOF (does not advance).
  // ==========================================================================

  pub let lex_peek : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M1-001 (#1365): peek current byte, zero at EOF. Bounds-checks before dereferencing buf. Labels prefixed lex_pk_.",
      block: {
        lea r10, [rip + _lex_state];
        mov rax, [r10 + 16];            // pos
        mov r11, [r10 + 8];             // len
        cmp rax, r11;
        jae lex_pk_eof;
        mov r8, [r10 + 0];              // buf
        add r8, rax;
        xor rax, rax;
        mov_b rax, [r8];
        ret;
      lex_pk_eof:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // lex_kw_match(start, len) -> tok_kind
  //   start = _lex_state[buf] + start_offset already consumed by scanner.
  //   len   = byte length of the identifier.
  //
  // Returns TOK_KW_* if the byte range matches a keyword, else TOK_IDENT.
  // Comparison is EXACT byte equality against uppercase spellings; a
  // lowercase 'select' is left as TOK_IDENT rather than promoted.
  //
  // Implementation is a small dispatch on length: keywords are 2..7 bytes.
  // A shorter run is definitely IDENT. This scaffold recognises the four
  // most common keywords (SELECT / FROM / WHERE / JOIN) plus the logical
  // AND / OR / NOT and the AS alias marker; the remaining keywords in
  // §1 stay in the token union but degrade to TOK_IDENT here so the
  // parser sees them by shape (a caller adding a new keyword recognition
  // adds one case to this dispatch, nothing else moves).
  // ==========================================================================

  pub let lex_kw_match : (u64, u64) -> u64 !{mem} @{} =
    fn (start: u64, len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M1-001 (#1365): keyword match. rdi=start (buf+off), rsi=len. Byte-by-byte compare -- no library call. Labels prefixed lex_kw_.",
      block: {
        push rbx;
        push r12;
        push r13;
        mov rbx, rdi;                   // start ptr
        mov r12, rsi;                   // len

        cmp r12, 2;
        jb  lex_kw_ident;
        cmp r12, 7;
        ja  lex_kw_ident;

        // len == 2  -> AS / OR / IN
        cmp r12, 2;
        jne lex_kw_l3;
        // AS
        xor rax, rax;
        mov_b rax, [rbx + 0];
        cmp rax, 65;                    // 'A'
        jne lex_kw_or;
        xor rax, rax;
        mov_b rax, [rbx + 1];
        cmp rax, 83;                    // 'S'
        jne lex_kw_or;
        mov rax, 8;                     // TOK_KW_AS
        jmp lex_kw_out;
      lex_kw_or:
        xor rax, rax;
        mov_b rax, [rbx + 0];
        cmp rax, 79;                    // 'O'
        jne lex_kw_in;
        xor rax, rax;
        mov_b rax, [rbx + 1];
        cmp rax, 82;                    // 'R'
        jne lex_kw_in;
        mov rax, 12;                    // TOK_KW_OR
        jmp lex_kw_out;
      lex_kw_in:
        xor rax, rax;
        mov_b rax, [rbx + 0];
        cmp rax, 73;                    // 'I'
        jne lex_kw_ident;
        xor rax, rax;
        mov_b rax, [rbx + 1];
        cmp rax, 78;                    // 'N'
        jne lex_kw_ident;
        mov rax, 14;                    // TOK_KW_IN
        jmp lex_kw_out;

      lex_kw_l3:
        cmp r12, 3;
        jne lex_kw_l4;
        // AND
        xor rax, rax;
        mov_b rax, [rbx + 0];
        cmp rax, 65;
        jne lex_kw_not;
        xor rax, rax;
        mov_b rax, [rbx + 1];
        cmp rax, 78;
        jne lex_kw_not;
        xor rax, rax;
        mov_b rax, [rbx + 2];
        cmp rax, 68;                    // 'D'
        jne lex_kw_not;
        mov rax, 11;                    // TOK_KW_AND
        jmp lex_kw_out;
      lex_kw_not:
        xor rax, rax;
        mov_b rax, [rbx + 0];
        cmp rax, 78;                    // 'N'
        jne lex_kw_asc;
        xor rax, rax;
        mov_b rax, [rbx + 1];
        cmp rax, 79;
        jne lex_kw_asc;
        xor rax, rax;
        mov_b rax, [rbx + 2];
        cmp rax, 84;                    // 'T'
        jne lex_kw_asc;
        mov rax, 13;                    // TOK_KW_NOT
        jmp lex_kw_out;
      lex_kw_asc:
        xor rax, rax;
        mov_b rax, [rbx + 0];
        cmp rax, 65;                    // 'A'
        jne lex_kw_ident;
        xor rax, rax;
        mov_b rax, [rbx + 1];
        cmp rax, 83;                    // 'S'
        jne lex_kw_ident;
        xor rax, rax;
        mov_b rax, [rbx + 2];
        cmp rax, 67;                    // 'C'
        jne lex_kw_ident;
        mov rax, 9;                     // TOK_KW_ASC
        jmp lex_kw_out;

      lex_kw_l4:
        cmp r12, 4;
        jne lex_kw_l5;
        // FROM / JOIN / DESC / LIKE
        xor rax, rax;
        mov_b rax, [rbx + 0];
        cmp rax, 70;                    // 'F'
        jne lex_kw_join;
        xor rax, rax;
        mov_b rax, [rbx + 1];
        cmp rax, 82;
        jne lex_kw_ident;
        xor rax, rax;
        mov_b rax, [rbx + 2];
        cmp rax, 79;
        jne lex_kw_ident;
        xor rax, rax;
        mov_b rax, [rbx + 3];
        cmp rax, 77;
        jne lex_kw_ident;
        mov rax, 2;                     // TOK_KW_FROM
        jmp lex_kw_out;
      lex_kw_join:
        xor rax, rax;
        mov_b rax, [rbx + 0];
        cmp rax, 74;                    // 'J'
        jne lex_kw_desc;
        xor rax, rax;
        mov_b rax, [rbx + 1];
        cmp rax, 79;
        jne lex_kw_ident;
        xor rax, rax;
        mov_b rax, [rbx + 2];
        cmp rax, 73;
        jne lex_kw_ident;
        xor rax, rax;
        mov_b rax, [rbx + 3];
        cmp rax, 78;
        jne lex_kw_ident;
        mov rax, 4;                     // TOK_KW_JOIN
        jmp lex_kw_out;
      lex_kw_desc:
        xor rax, rax;
        mov_b rax, [rbx + 0];
        cmp rax, 68;                    // 'D'
        jne lex_kw_like;
        xor rax, rax;
        mov_b rax, [rbx + 1];
        cmp rax, 69;
        jne lex_kw_ident;
        xor rax, rax;
        mov_b rax, [rbx + 2];
        cmp rax, 83;
        jne lex_kw_ident;
        xor rax, rax;
        mov_b rax, [rbx + 3];
        cmp rax, 67;
        jne lex_kw_ident;
        mov rax, 10;                    // TOK_KW_DESC
        jmp lex_kw_out;
      lex_kw_like:
        xor rax, rax;
        mov_b rax, [rbx + 0];
        cmp rax, 76;                    // 'L'
        jne lex_kw_ident;
        xor rax, rax;
        mov_b rax, [rbx + 1];
        cmp rax, 73;
        jne lex_kw_ident;
        xor rax, rax;
        mov_b rax, [rbx + 2];
        cmp rax, 75;
        jne lex_kw_ident;
        xor rax, rax;
        mov_b rax, [rbx + 3];
        cmp rax, 69;
        jne lex_kw_ident;
        mov rax, 15;                    // TOK_KW_LIKE
        jmp lex_kw_out;

      lex_kw_l5:
        cmp r12, 5;
        jne lex_kw_l6;
        // WHERE / GROUP / ORDER / LIMIT
        xor rax, rax;
        mov_b rax, [rbx + 0];
        cmp rax, 87;                    // 'W'
        jne lex_kw_group;
        xor rax, rax;
        mov_b rax, [rbx + 1];
        cmp rax, 72;
        jne lex_kw_ident;
        xor rax, rax;
        mov_b rax, [rbx + 2];
        cmp rax, 69;
        jne lex_kw_ident;
        xor rax, rax;
        mov_b rax, [rbx + 3];
        cmp rax, 82;
        jne lex_kw_ident;
        xor rax, rax;
        mov_b rax, [rbx + 4];
        cmp rax, 69;
        jne lex_kw_ident;
        mov rax, 3;                     // TOK_KW_WHERE
        jmp lex_kw_out;
      lex_kw_group:
        xor rax, rax;
        mov_b rax, [rbx + 0];
        cmp rax, 71;                    // 'G'
        jne lex_kw_order;
        xor rax, rax;
        mov_b rax, [rbx + 1];
        cmp rax, 82;
        jne lex_kw_ident;
        xor rax, rax;
        mov_b rax, [rbx + 2];
        cmp rax, 79;
        jne lex_kw_ident;
        xor rax, rax;
        mov_b rax, [rbx + 3];
        cmp rax, 85;
        jne lex_kw_ident;
        xor rax, rax;
        mov_b rax, [rbx + 4];
        cmp rax, 80;
        jne lex_kw_ident;
        mov rax, 5;                     // TOK_KW_GROUP
        jmp lex_kw_out;
      lex_kw_order:
        xor rax, rax;
        mov_b rax, [rbx + 0];
        cmp rax, 79;                    // 'O'
        jne lex_kw_limit;
        xor rax, rax;
        mov_b rax, [rbx + 1];
        cmp rax, 82;
        jne lex_kw_ident;
        xor rax, rax;
        mov_b rax, [rbx + 2];
        cmp rax, 68;
        jne lex_kw_ident;
        xor rax, rax;
        mov_b rax, [rbx + 3];
        cmp rax, 69;
        jne lex_kw_ident;
        xor rax, rax;
        mov_b rax, [rbx + 4];
        cmp rax, 82;
        jne lex_kw_ident;
        mov rax, 6;                     // TOK_KW_ORDER
        jmp lex_kw_out;
      lex_kw_limit:
        xor rax, rax;
        mov_b rax, [rbx + 0];
        cmp rax, 76;                    // 'L'
        jne lex_kw_ident;
        xor rax, rax;
        mov_b rax, [rbx + 1];
        cmp rax, 73;
        jne lex_kw_ident;
        xor rax, rax;
        mov_b rax, [rbx + 2];
        cmp rax, 77;
        jne lex_kw_ident;
        xor rax, rax;
        mov_b rax, [rbx + 3];
        cmp rax, 73;
        jne lex_kw_ident;
        xor rax, rax;
        mov_b rax, [rbx + 4];
        cmp rax, 84;
        jne lex_kw_ident;
        mov rax, 7;                     // TOK_KW_LIMIT
        jmp lex_kw_out;

      lex_kw_l6:
        cmp r12, 6;
        jne lex_kw_l7;
        // SELECT
        xor rax, rax;
        mov_b rax, [rbx + 0];
        cmp rax, 83;                    // 'S'
        jne lex_kw_ident;
        xor rax, rax;
        mov_b rax, [rbx + 1];
        cmp rax, 69;
        jne lex_kw_ident;
        xor rax, rax;
        mov_b rax, [rbx + 2];
        cmp rax, 76;
        jne lex_kw_ident;
        xor rax, rax;
        mov_b rax, [rbx + 3];
        cmp rax, 69;
        jne lex_kw_ident;
        xor rax, rax;
        mov_b rax, [rbx + 4];
        cmp rax, 67;
        jne lex_kw_ident;
        xor rax, rax;
        mov_b rax, [rbx + 5];
        cmp rax, 84;
        jne lex_kw_ident;
        mov rax, 1;                     // TOK_KW_SELECT
        jmp lex_kw_out;

      lex_kw_l7:
        // BETWEEN
        xor rax, rax;
        mov_b rax, [rbx + 0];
        cmp rax, 66;                    // 'B'
        jne lex_kw_ident;
        xor rax, rax;
        mov_b rax, [rbx + 1];
        cmp rax, 69;
        jne lex_kw_ident;
        xor rax, rax;
        mov_b rax, [rbx + 2];
        cmp rax, 84;
        jne lex_kw_ident;
        xor rax, rax;
        mov_b rax, [rbx + 3];
        cmp rax, 87;
        jne lex_kw_ident;
        xor rax, rax;
        mov_b rax, [rbx + 4];
        cmp rax, 69;
        jne lex_kw_ident;
        xor rax, rax;
        mov_b rax, [rbx + 5];
        cmp rax, 69;
        jne lex_kw_ident;
        xor rax, rax;
        mov_b rax, [rbx + 6];
        cmp rax, 78;
        jne lex_kw_ident;
        mov rax, 16;                    // TOK_KW_BETWEEN
        jmp lex_kw_out;

      lex_kw_ident:
        mov rax, 17;                    // TOK_IDENT

      lex_kw_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // lex_next() -> tok_kind
  //
  // Scan one token from the current cursor. Advances pos past the token
  // (and past any trailing whitespace it consumes to reach it). Writes
  // (tok_kind, tok_start, tok_len) into _lex_state. On error, latches
  // sticky err, sets tok_kind to TOK_EOF, and returns TOK_EOF.
  //
  // Locals: rbx=state ptr, r12=buf, r13=len, r14=pos, r15=tok_start.
  // ==========================================================================

  pub let lex_next : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M1-001 (#1365): scan one token. Requires init_mark. Callee-saves rbx/r12-r15; entry rsp%16==8, five pushes -> 0 which every nested call needs. Labels prefixed lex_nx_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // ---- Guard: bound?
        lea rbx, [rip + _lex_state];
        mov rax, [rbx + 56];
        mov r11, 0xB1A5;
        cmp rax, r11;
        jne lex_nx_not_bound;

        // ---- Sticky error?  Refuse further scanning.
        mov rax, [rbx + 48];
        cmp rax, 0;
        jne lex_nx_eof_silent;

        mov r12, [rbx + 0];             // buf
        mov r13, [rbx + 8];             // len
        mov r14, [rbx + 16];            // pos

        // ---- Skip whitespace.
      lex_nx_ws:
        cmp r14, r13;
        jae lex_nx_eof;
        mov r8, r12;
        add r8, r14;
        xor rdi, rdi;
        mov_b rdi, [r8];
        call lex_is_space;
        cmp rax, 1;
        jne lex_nx_start;
        add r14, 1;
        jmp lex_nx_ws;

      lex_nx_start:
        mov r15, r14;                   // tok_start
        mov [rbx + 32], r15;

        // Load first byte.
        mov r8, r12;
        add r8, r14;
        xor rdi, rdi;
        mov_b rdi, [r8];

        // ---- Punctuation and single-char ops (leaf branches).
        cmp rdi, 40;                    // '('
        jne lex_nx_p_rparen;
        mov rax, 29;                    // TOK_LPAREN
        add r14, 1;
        mov r11, 1;
        jmp lex_nx_finish;
      lex_nx_p_rparen:
        cmp rdi, 41;                    // ')'
        jne lex_nx_p_comma;
        mov rax, 30;
        add r14, 1;
        mov r11, 1;
        jmp lex_nx_finish;
      lex_nx_p_comma:
        cmp rdi, 44;                    // ','
        jne lex_nx_p_dot;
        mov rax, 31;
        add r14, 1;
        mov r11, 1;
        jmp lex_nx_finish;
      lex_nx_p_dot:
        cmp rdi, 46;                    // '.'
        jne lex_nx_p_semi;
        mov rax, 32;
        add r14, 1;
        mov r11, 1;
        jmp lex_nx_finish;
      lex_nx_p_semi:
        cmp rdi, 59;                    // ';'
        jne lex_nx_p_eq;
        mov rax, 33;
        add r14, 1;
        mov r11, 1;
        jmp lex_nx_finish;
      lex_nx_p_eq:
        cmp rdi, 61;                    // '='
        jne lex_nx_p_star;
        mov rax, 20;                    // TOK_OP_EQ
        add r14, 1;
        mov r11, 1;
        jmp lex_nx_finish;
      lex_nx_p_star:
        cmp rdi, 42;                    // '*'
        jne lex_nx_p_plus;
        mov rax, 26;
        add r14, 1;
        mov r11, 1;
        jmp lex_nx_finish;
      lex_nx_p_plus:
        cmp rdi, 43;                    // '+'
        jne lex_nx_p_minus;
        mov rax, 27;
        add r14, 1;
        mov r11, 1;
        jmp lex_nx_finish;
      lex_nx_p_minus:
        cmp rdi, 45;                    // '-'
        jne lex_nx_p_lt;
        mov rax, 28;
        add r14, 1;
        mov r11, 1;
        jmp lex_nx_finish;

        // ---- '<' possibly '<=' or '<>'
      lex_nx_p_lt:
        cmp rdi, 60;                    // '<'
        jne lex_nx_p_gt;
        add r14, 1;
        mov r11, 1;
        // Peek next.
        cmp r14, r13;
        jae lex_nx_lt_only;
        mov r8, r12;
        add r8, r14;
        xor rax, rax;
        mov_b rax, [r8];
        cmp rax, 61;                    // '='
        jne lex_nx_lt_ne;
        add r14, 1;
        mov r11, 2;
        mov rax, 23;                    // TOK_OP_LE
        jmp lex_nx_finish;
      lex_nx_lt_ne:
        cmp rax, 62;                    // '>'
        jne lex_nx_lt_only;
        add r14, 1;
        mov r11, 2;
        mov rax, 25;                    // TOK_OP_NE
        jmp lex_nx_finish;
      lex_nx_lt_only:
        mov rax, 21;                    // TOK_OP_LT
        jmp lex_nx_finish;

        // ---- '>' possibly '>='
      lex_nx_p_gt:
        cmp rdi, 62;                    // '>'
        jne lex_nx_p_squote;
        add r14, 1;
        mov r11, 1;
        cmp r14, r13;
        jae lex_nx_gt_only;
        mov r8, r12;
        add r8, r14;
        xor rax, rax;
        mov_b rax, [r8];
        cmp rax, 61;
        jne lex_nx_gt_only;
        add r14, 1;
        mov r11, 2;
        mov rax, 24;                    // TOK_OP_GE
        jmp lex_nx_finish;
      lex_nx_gt_only:
        mov rax, 22;                    // TOK_OP_GT
        jmp lex_nx_finish;

        // ---- '\''  string literal
      lex_nx_p_squote:
        cmp rdi, 39;                    // '\''
        jne lex_nx_p_digit;
        add r14, 1;                     // consume opening quote
      lex_nx_sl_scan:
        cmp r14, r13;
        jae lex_nx_sl_unterm;
        mov r8, r12;
        add r8, r14;
        xor rax, rax;
        mov_b rax, [r8];
        cmp rax, 39;
        je  lex_nx_sl_end;
        add r14, 1;
        jmp lex_nx_sl_scan;
      lex_nx_sl_end:
        add r14, 1;                     // consume closing quote
        // Length = r14 - r15.  tok_start includes opening quote.
        mov r11, r14;
        sub r11, r15;
        mov rax, 19;                    // TOK_STRLIT
        push rax;
        push r11;
        mov rdi, 4;                     // LEX_ST_STRLITS
        call lex_note;
        pop r11;
        pop rax;
        jmp lex_nx_finish;
      lex_nx_sl_unterm:
        mov rdi, 0xFFFFF17E;            // LEX_ERR_UNTERMINATED
        call lex_set_err;
        jmp lex_nx_eof;

        // ---- digit -> INTLIT
      lex_nx_p_digit:
        push rdi;
        call lex_is_digit;
        pop rdi;
        cmp rax, 1;
        jne lex_nx_p_alpha;
        // Scan digits.
      lex_nx_int_scan:
        add r14, 1;
        cmp r14, r13;
        jae lex_nx_int_done;
        mov r8, r12;
        add r8, r14;
        xor rdi, rdi;
        mov_b rdi, [r8];
        call lex_is_digit;
        cmp rax, 1;
        je  lex_nx_int_scan;
      lex_nx_int_done:
        mov r11, r14;
        sub r11, r15;
        cmp r11, 20;                    // LEX_INT_MAX
        ja  lex_nx_int_overflow;
        mov rax, 18;                    // TOK_INTLIT
        push rax;
        push r11;
        mov rdi, 5;                     // LEX_ST_INTLITS
        call lex_note;
        pop r11;
        pop rax;
        jmp lex_nx_finish;
      lex_nx_int_overflow:
        mov rdi, 0xFFFFF17D;            // LEX_ERR_INT_OVERFLOW
        call lex_set_err;
        jmp lex_nx_eof;

        // ---- alpha -> IDENT or KEYWORD
      lex_nx_p_alpha:
        push rdi;
        call lex_is_alpha;
        pop rdi;
        cmp rax, 1;
        jne lex_nx_p_unknown;
      lex_nx_id_scan:
        add r14, 1;
        cmp r14, r13;
        jae lex_nx_id_done;
        mov r8, r12;
        add r8, r14;
        xor rdi, rdi;
        mov_b rdi, [r8];
        call lex_is_alnum;
        cmp rax, 1;
        je  lex_nx_id_scan;
      lex_nx_id_done:
        mov r11, r14;
        sub r11, r15;
        cmp r11, 32;                    // LEX_IDENT_MAX
        ja  lex_nx_id_too_long;
        // Keyword or IDENT?
        mov rdi, r12;
        add rdi, r15;
        mov rsi, r11;
        call lex_kw_match;
        // rax now token kind.
        cmp rax, 17;                    // TOK_IDENT
        je  lex_nx_id_finish;
        push rax;
        push r11;
        mov rdi, 2;                     // LEX_ST_KEYWORDS
        call lex_note;
        pop r11;
        pop rax;
        jmp lex_nx_finish;
      lex_nx_id_finish:
        push rax;
        push r11;
        mov rdi, 1;                     // LEX_ST_TOKENS (per-token)
        call lex_note;
        pop r11;
        pop rax;
        jmp lex_nx_finish;
      lex_nx_id_too_long:
        mov rdi, 0xFFFFF17C;            // LEX_ERR_TOO_LONG
        call lex_set_err;
        jmp lex_nx_eof;

        // ---- unknown character
      lex_nx_p_unknown:
        mov rdi, 0xFFFFF17F;            // LEX_ERR_UNKNOWN_CHAR
        call lex_set_err;
        jmp lex_nx_eof;

        // ---- Finish: rax = tok_kind, r11 = tok_len, r14 = new pos.
      lex_nx_finish:
        mov [rbx + 24], rax;            // tok_kind
        mov [rbx + 40], r11;            // tok_len
        mov [rbx + 16], r14;            // pos
        mov r10, rax;
        // Count each token.
        push r10;
        mov rdi, 1;                     // LEX_ST_TOKENS
        call lex_note;
        pop r10;
        mov rax, r10;
        jmp lex_nx_out;

      lex_nx_not_bound:
        mov rdi, 0xFFFFF17B;            // LEX_ERR_NOT_BOUND
        call lex_set_err;
        // fallthrough to EOF path.
      lex_nx_eof:
        mov [rbx + 16], r14;            // pos (in case we scanned partially)
      lex_nx_eof_silent:
        xor rax, rax;                   // TOK_EOF
        mov [rbx + 24], rax;
        mov r11, 0;
        mov [rbx + 40], r11;
        mov rdi, 3;                     // LEX_ST_REFUSED (only if err set)
        push rax;
        call lex_note;
        pop rax;

      lex_nx_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
