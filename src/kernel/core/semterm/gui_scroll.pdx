// src/kernel/core/semterm/gui_scroll.pdx -- R44.M2-003 (#1405)
//
// SEMTERM GUI SMOOTH SCROLLING. Sub-pixel positioning + ease-out
// cubic animation curve for the R44 GUI results region. Callers park
// a viewport height, a content height, and drive the offset toward a
// target with scr_scroll_to; scr_animate_step advances the animation
// one or more frames and reads back the sub-pixel-accurate offset;
// scr_reproject_glyph translates a glyph's original sub-pixel row
// into the currently-scrolled coordinate, keeping the glyph position
// stable within a frame.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the SCROLL SEAM behind the shell's results region. The Vello
// backend (semterm/gui_vello.pdx) walks the seam at frame flush:
//   for each glyph at base_row_ss:
//     y_ss = scr_reproject_glyph(base_row_ss)  // shifted by current offset
//     ... emit glyph at y_ss ...
//   scr_animate_step(1)  // advance one frame toward target
//
// scr_reset zeroes state; scr_viewport_set(h) / scr_content_set(h)
// park the viewport height and content height in integer pixels;
// scr_scroll_to(target_ss, frames) parks an animation from the
// current offset to target_ss over frames frames; scr_animate_step(n)
// advances n frames and returns the new offset; scr_reproject_glyph
// subtracts the current offset from a caller-supplied base sub-pixel
// row.
//
// It does NOT rasterise. It does NOT clip glyphs to the viewport --
// the Vello backend does that at emit time using the offset this
// module reports. It does NOT own the resultset row height or the
// glyph geometry -- the caller passes sub-pixel rows in.
//
// It is a SCAFFOLD (D7): R44.M2 wires it into the witness tree but
// no live frame loop drives scr_animate_step and no live Vello
// backend calls scr_reproject_glyph; scr_arbitrated() returns 0
// until a later round hooks the shell's scroll input into
// scr_scroll_to and the frame loop into scr_animate_step.
//
// =============================================================================
// §1  SUB-PIXEL POSITIONING
// =============================================================================
//
// SCR_SS_PER_PIXEL = 1024. Sub-pixel units (ss) are Q22.10 fixed
// point: one whole pixel is 1024 ss. Ten bits of fraction give
// per-milli-pixel precision, which is finer than any display or
// human-perception threshold; twenty-two bits of integer give up to
// ~4M rows of scrollable content, which is more than any realistic
// resultset. Sub-pixel accuracy matters here for two reasons:
//
//   1) An animation curve is CONTINUOUS. Integer-pixel jumps of the
//      offset produce visible stepping (moire on horizontal rules,
//      shimmer on adjacent glyph rows); Q22.10 keeps the eased delta
//      smooth even for slow scrolls where each frame moves less than
//      one pixel.
//
//   2) Text remains STABLE across the animation. When the offset
//      changes by 0.3 pixels, glyph rasters slide by 0.3 pixels
//      too; if the offset were quantised to integer pixels, some
//      glyph rows would occasionally jump by a full pixel between
//      frames while others didn't, and the eye would read that as
//      dancing text. scr_reproject_glyph delivers the exact offset
//      to every glyph in the same frame.
//
// scr_offset_int() returns the offset ROUNDED to the nearest whole
// pixel (offset_ss + 512) >> 10 -- a convenience for callers that
// only want an integer row for a scroll bar or a status readout.
//
// =============================================================================
// §2  EASE-OUT CUBIC ANIMATION CURVE
// =============================================================================
//
// Ease-out cubic: the offset moves quickly at first and settles
// gently at the target. Formally, given progress p in [0, 1]:
//
//   eased(p) = 1 - (1 - p)^3
//
// In Q0.10 (one whole unit = 1024) with p and eased both in [0, 1024]:
//
//   u    = 1024 - p                                (0..1024)
//   u2   = (u * u) >> 10                           (0..1024)
//   u3   = (u2 * u) >> 10                          (0..1024)
//   eased = 1024 - u3                              (0..1024)
//
// The position at eased fraction e is:
//
//   if target >= start:
//     offset = start + ((target - start) * e) >> 10
//   else:
//     offset = start - ((start - target) * e) >> 10
//
// Cubic (rather than linear or higher-order) is the cheapest curve
// that gives a natural motion the eye reads as "settling", it never
// overshoots, and its arithmetic stays inside 64-bit integer range
// for any realistic (delta_ss, eased) pair -- delta_ss up to ~2^50
// times eased up to 2^10 fits with >2 bits to spare.
//
// The final step (frames_left drops to 0) SNAPS the offset to
// target_ss exactly. Approximating the last hundred sub-pixels with
// the eased formula could leave a stale fractional residue that a
// glyph rasteriser would render as one-off jitter; the snap
// eliminates that.
//
// =============================================================================
// §3  ONE WRITER OF THE STATE
// =============================================================================
//
// _scr_state is written only by helpers in this module. tools/build.sh
// confines relocations against it to `core/semterm/gui_scroll.o`.
//
// STATE LAYOUT -- _scr_state : [u64; 16]
//   +0    init_mark        0x53C7 once scr_reset has run
//   +8    err              sticky error latch
//   +16   viewport_h       integer pixels (0 until viewport_set)
//   +24   content_h        integer pixels (0 until content_set)
//   +32   offset_ss        Q22.10 current scroll offset
//   +40   start_ss         Q22.10 animation origin
//   +48   target_ss        Q22.10 animation target
//   +56   frames_total     count of frames scroll_to parked
//   +64   frames_left      0 == idle; > 0 == animating
//   +72   frames_advanced  running total across animate_step
//   +80..127 reserved      0
//
// =============================================================================
// §4  FAILURE TAXONOMY 0xFFFFEE80..0xFFFFEE8F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time. Adjacent used
// band above: gui_charts 0xFFFFEE90..9F (R44.M2-002). Adjacent free
// band below: 0xFFFFEE70..7F (unassigned).
//
//   SCR_OK             = 0
//   SCR_ERR_NOT_INIT   = 0xFFFFEE8F   accessor before scr_reset
//   SCR_ERR_BAD_HEIGHT = 0xFFFFEE8E   viewport_set / content_set with 0
//   SCR_ERR_NO_CONTENT = 0xFFFFEE8D   scroll_to before content_set or
//                                       viewport_set (content_h == 0 or
//                                       viewport_h == 0)
//   SCR_ERR_BAD_TARGET = 0xFFFFEE8C   target_ss > max_offset_ss
//   SCR_ERR_BAD_FRAMES = 0xFFFFEE8B   scroll_to or animate_step with 0
//   SCR_ERR_ANIM_BUSY  = 0xFFFFEE8A   scroll_to while frames_left != 0
//   SCR_ERR_ANIM_IDLE  = 0xFFFFEE89   animate_step while frames_left == 0
//   SCR_ERR_INTERNAL   = 0xFFFFEE88   unreachable-fallthrough tripwire
//
// =============================================================================
// §5  ARITY DISCIPLINE
// =============================================================================
//
// scr_viewport_set is (height). scr_content_set is (height).
// scr_scroll_to is (target_ss, frames). scr_animate_step is (frames).
// scr_reproject_glyph is (base_row_ss). Every readback is (). A
// widening (per-axis scroll, spring animation with overshoot, custom
// easing curve) is a widening of these arities and tools/build.sh
// pins the signatures.

module GuiScroll = structure {

  // Sub-pixel unit constant (§1).
  pub let SCR_SS_PER_PIXEL : u64 = 1024
  pub let SCR_SS_HALF      : u64 = 512

  // Easing unit (§2). eased and progress live in Q0.10, [0, 1024].
  pub let SCR_EASE_UNIT : u64 = 1024

  // Failure taxonomy (§4).
  pub let SCR_OK             : u64 = 0
  pub let SCR_ERR_NOT_INIT   : u64 = 0xFFFFEE8F
  pub let SCR_ERR_BAD_HEIGHT : u64 = 0xFFFFEE8E
  pub let SCR_ERR_NO_CONTENT : u64 = 0xFFFFEE8D
  pub let SCR_ERR_BAD_TARGET : u64 = 0xFFFFEE8C
  pub let SCR_ERR_BAD_FRAMES : u64 = 0xFFFFEE8B
  pub let SCR_ERR_ANIM_BUSY  : u64 = 0xFFFFEE8A
  pub let SCR_ERR_ANIM_IDLE  : u64 = 0xFFFFEE89
  pub let SCR_ERR_INTERNAL   : u64 = 0xFFFFEE88

  pub let SCR_INIT_MARK : u64 = 0x53C7

  pub let mut _scr_state : [u64; 16] = uninit @align(64)

  // ==========================================================================
  // Reset. Boot + teardown.
  // ==========================================================================

  pub let scr_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M2-003 (#1405): clear state, install init_mark. Labels prefixed scr_rst_.",
      block: {
        lea r10, [rip + _scr_state];
        xor rax, rax;
        xor rcx, rcx;
      scr_rst_st:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 16;
        jb  scr_rst_st;

        mov rax, 0x53C7;
        mov [r10 + 0], rax;                     // init_mark
        ret
      }
    } @no_frame

  pub let scr_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R44.M2-003 (#1405): honesty pin. Returns 0 until a live frame loop drives scr_animate_step and a live Vello backend calls scr_reproject_glyph.",
      block: {
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let scr_err : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M2-003 (#1405): sticky error latch readback.",
      block: {
        lea r10, [rip + _scr_state];
        mov rax, [r10 + 8];
        ret
      }
    } @no_frame

  pub let scr_bound : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M2-003 (#1405): 1 iff init_mark matches. Labels prefixed scr_bnd_.",
      block: {
        lea r10, [rip + _scr_state];
        mov rax, [r10 + 0];
        mov r11, 0x53C7;
        cmp rax, r11;
        jne scr_bnd_no;
        mov rax, 1;
        ret;
      scr_bnd_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let scr_set_err : (u64) -> () !{mem} @{} =
    fn (code: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M2-003 (#1405): first-writer-wins error latch. Labels prefixed scr_se_.",
      block: {
        lea r10, [rip + _scr_state];
        mov rax, [r10 + 8];
        cmp rax, 0;
        jne scr_se_out;
        mov [r10 + 8], rdi;
      scr_se_out:
        ret
      }
    } @no_frame

  // ==========================================================================
  // Simple readbacks.
  // ==========================================================================

  pub let scr_viewport_get : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M2-003 (#1405): viewport_h field.",
      block: {
        lea r10, [rip + _scr_state];
        mov rax, [r10 + 16];
        ret
      }
    } @no_frame

  pub let scr_content_get : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M2-003 (#1405): content_h field.",
      block: {
        lea r10, [rip + _scr_state];
        mov rax, [r10 + 24];
        ret
      }
    } @no_frame

  pub let scr_offset_ss : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M2-003 (#1405): offset_ss field (Q22.10).",
      block: {
        lea r10, [rip + _scr_state];
        mov rax, [r10 + 32];
        ret
      }
    } @no_frame

  pub let scr_offset_int : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M2-003 (#1405): (offset_ss + 512) >> 10 -- integer-pixel round-to-nearest.",
      block: {
        lea r10, [rip + _scr_state];
        mov rax, [r10 + 32];
        add rax, 512;
        shr rax, 10;
        ret
      }
    } @no_frame

  pub let scr_frames_total : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M2-003 (#1405): frames_total field.",
      block: {
        lea r10, [rip + _scr_state];
        mov rax, [r10 + 56];
        ret
      }
    } @no_frame

  pub let scr_frames_left : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M2-003 (#1405): frames_left field.",
      block: {
        lea r10, [rip + _scr_state];
        mov rax, [r10 + 64];
        ret
      }
    } @no_frame

  pub let scr_frames_advanced : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M2-003 (#1405): frames_advanced running total.",
      block: {
        lea r10, [rip + _scr_state];
        mov rax, [r10 + 72];
        ret
      }
    } @no_frame

  // ==========================================================================
  // scr_max_offset_ss() -> u64
  //
  // Returns (content_h - viewport_h) * SCR_SS_PER_PIXEL, or 0 if
  // content_h <= viewport_h. No init check (accessor style; a caller
  // reading a zero on a not-init module reads the same zero the reset
  // installs).
  // ==========================================================================

  pub let scr_max_offset_ss : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M2-003 (#1405): (content_h - viewport_h) << 10, clamped at 0. Labels prefixed scr_mo_.",
      block: {
        lea r10, [rip + _scr_state];
        mov rax, [r10 + 24];                     // content_h
        mov rcx, [r10 + 16];                     // viewport_h
        cmp rax, rcx;
        jbe scr_mo_zero;
        sub rax, rcx;
        shl rax, 10;                             // multiply by 1024
        ret;
      scr_mo_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // scr_viewport_set(height) / scr_content_set(height)
  //
  // Store the integer-pixel height. Refuses not init or height == 0.
  // A widening/shrink mid-animation is not refused here -- the caller
  // is trusted to have suspended the animation first, or to accept
  // that offset_ss may exceed the new max_offset_ss (a future
  // scr_animate_step would still walk to target_ss unchanged, but the
  // Vello backend must clip to the new viewport).
  // ==========================================================================

  pub let scr_viewport_set : (u64) -> u64 !{mem} @{} =
    fn (height: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M2-003 (#1405): store viewport_h. Labels prefixed scr_vs_.",
      block: {
        lea r10, [rip + _scr_state];
        mov rax, [r10 + 0];
        mov r11, 0x53C7;
        cmp rax, r11;
        jne scr_vs_ni;

        cmp rdi, 0;
        je  scr_vs_bh;

        mov [r10 + 16], rdi;
        xor rax, rax;
        ret;

      scr_vs_ni:
        mov rdi, 0xFFFFEE8F;
        call scr_set_err;
        mov rax, 0xFFFFEE8F;
        ret;
      scr_vs_bh:
        mov rdi, 0xFFFFEE8E;
        call scr_set_err;
        mov rax, 0xFFFFEE8E;
        ret
      }
    }

  pub let scr_content_set : (u64) -> u64 !{mem} @{} =
    fn (height: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M2-003 (#1405): store content_h. Labels prefixed scr_cs_.",
      block: {
        lea r10, [rip + _scr_state];
        mov rax, [r10 + 0];
        mov r11, 0x53C7;
        cmp rax, r11;
        jne scr_cs_ni;

        cmp rdi, 0;
        je  scr_cs_bh;

        mov [r10 + 24], rdi;
        xor rax, rax;
        ret;

      scr_cs_ni:
        mov rdi, 0xFFFFEE8F;
        call scr_set_err;
        mov rax, 0xFFFFEE8F;
        ret;
      scr_cs_bh:
        mov rdi, 0xFFFFEE8E;
        call scr_set_err;
        mov rax, 0xFFFFEE8E;
        ret
      }
    }

  // ==========================================================================
  // scr_scroll_to(target_ss, frames) -> u64
  //
  // Park an animation from the current offset to target_ss over
  // frames frames. Refuses not init, no content (viewport_h or
  // content_h == 0), bad target (target_ss > max_offset_ss), bad
  // frames (frames == 0), or anim busy (frames_left != 0). A callable
  // that wants to force a new destination while animating must
  // wait for scr_animate_step to drain frames_left to 0 first.
  // ==========================================================================

  pub let scr_scroll_to : (u64, u64) -> u64 !{mem} @{} =
    fn (target_ss: u64, frames: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M2-003 (#1405): install animation origin/target/frame count. Labels prefixed scr_to_.",
      block: {
        lea r10, [rip + _scr_state];
        mov rax, [r10 + 0];
        mov r11, 0x53C7;
        cmp rax, r11;
        jne scr_to_ni;

        // Anim must be idle.
        mov rax, [r10 + 64];
        cmp rax, 0;
        jne scr_to_ab;

        // viewport_h > 0 AND content_h > 0.
        mov rax, [r10 + 16];
        cmp rax, 0;
        je  scr_to_nc;
        mov rax, [r10 + 24];
        cmp rax, 0;
        je  scr_to_nc;

        // frames > 0.
        cmp rsi, 0;
        je  scr_to_bf;

        // target_ss <= max_offset_ss.
        // max = (content_h - viewport_h) << 10, or 0 if content <= viewport.
        mov rax, [r10 + 24];                     // content_h
        mov rcx, [r10 + 16];                     // viewport_h
        cmp rax, rcx;
        jbe scr_to_max_zero;
        sub rax, rcx;
        shl rax, 10;
        jmp scr_to_max_ready;
      scr_to_max_zero:
        xor rax, rax;
      scr_to_max_ready:
        // rax = max_offset_ss
        cmp rdi, rax;
        ja  scr_to_bt;

        // Park start = current offset; target = rdi; total = left = rsi.
        mov rax, [r10 + 32];                     // offset_ss
        mov [r10 + 40], rax;                     // start_ss
        mov [r10 + 48], rdi;                     // target_ss
        mov [r10 + 56], rsi;                     // frames_total
        mov [r10 + 64], rsi;                     // frames_left

        xor rax, rax;
        ret;

      scr_to_ni:
        mov rdi, 0xFFFFEE8F;
        call scr_set_err;
        mov rax, 0xFFFFEE8F;
        ret;
      scr_to_nc:
        mov rdi, 0xFFFFEE8D;
        call scr_set_err;
        mov rax, 0xFFFFEE8D;
        ret;
      scr_to_bt:
        mov rdi, 0xFFFFEE8C;
        call scr_set_err;
        mov rax, 0xFFFFEE8C;
        ret;
      scr_to_bf:
        mov rdi, 0xFFFFEE8B;
        call scr_set_err;
        mov rax, 0xFFFFEE8B;
        ret;
      scr_to_ab:
        mov rdi, 0xFFFFEE8A;
        call scr_set_err;
        mov rax, 0xFFFFEE8A;
        ret
      }
    }

  // ==========================================================================
  // scr_animate_step(frames_to_advance) -> u64
  //
  // Advance the animation by frames_to_advance frames (clamped to the
  // remaining frames_left). Returns the new offset_ss. On the last
  // frame (frames_left drops to 0), snaps offset to target_ss
  // exactly. Refuses not init, anim idle (frames_left == 0), or
  // frames_to_advance == 0.
  //
  // Ease-out cubic (§2):
  //   progress = ((total - left_new) * 1024) / total
  //   u        = 1024 - progress
  //   u2       = (u * u) >> 10
  //   u3       = (u2 * u) >> 10
  //   eased    = 1024 - u3
  //   delta    = |target - start|
  //   offset   = start (+/-) (delta * eased) >> 10
  //
  // Locals: rbx = frames-actually-advanced, r12 = state ptr,
  //         r13 = eased, r14 = start, r15 = target.
  // ==========================================================================

  pub let scr_animate_step : (u64) -> u64 !{mem} @{} =
    fn (frames_to_advance: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M2-003 (#1405): advance frames_left, compute ease-out cubic delta, park new offset. Snaps to target on final frame. Labels prefixed scr_st_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        lea r12, [rip + _scr_state];
        mov rax, [r12 + 0];
        mov r11, 0x53C7;
        cmp rax, r11;
        jne scr_st_ni;

        cmp rdi, 0;
        je  scr_st_bf;

        mov rax, [r12 + 64];                     // frames_left
        cmp rax, 0;
        je  scr_st_ai;

        // actual = min(rdi, frames_left).
        cmp rdi, rax;
        jbe scr_st_use_rdi;
        mov rdi, rax;
      scr_st_use_rdi:
        mov rbx, rdi;                            // actual

        // frames_left -= actual.
        sub rax, rbx;
        mov [r12 + 64], rax;                     // new frames_left

        // frames_advanced += actual.
        mov r8, [r12 + 72];
        add r8, rbx;
        mov [r12 + 72], r8;

        // If frames_left == 0, snap.
        cmp rax, 0;
        jne scr_st_ease;
        mov r8, [r12 + 48];                      // target_ss
        mov [r12 + 32], r8;                      // offset = target
        mov rax, r8;
        jmp scr_st_out;

      scr_st_ease:
        // progress_num = (total - left_new) << 10.
        mov r11, [r12 + 56];                     // frames_total
        mov r14, r11;
        sub r14, rax;                            // r14 = total - left_new
        shl r14, 10;
        // progress = r14 / total.
        mov rax, r14;
        xor rdx, rdx;
        div r11;                                 // rax = progress (0..1024)

        // u = 1024 - progress.
        mov r14, 1024;
        sub r14, rax;                            // r14 = u

        // u2 = (u * u) >> 10. Two-operand imul: 64-bit low result in rax;
        //   u*u <= 2^20 fits without touching upper bits.
        mov rax, r14;
        imul rax, r14;                           // rax = u * u
        shr rax, 10;
        mov r15, rax;                            // r15 = u2

        // u3 = (u2 * u) >> 10. u2*u <= 2^20 -- same argument.
        mov rax, r15;
        imul rax, r14;                           // rax = u2 * u
        shr rax, 10;                             // rax = u3

        // eased = 1024 - u3.
        mov r13, 1024;
        sub r13, rax;                            // r13 = eased (0..1024)

        // Load start / target.
        mov r14, [r12 + 40];                     // start
        mov r15, [r12 + 48];                     // target

        // Forward or backward?
        cmp r15, r14;
        jb  scr_st_bwd;

        // Forward: delta = target - start; offset = start + (delta * eased) >> 10.
        //   For realistic scroll geometry (content_h < 2^40) delta * eased
        //   stays inside the 64-bit low half, so the two-operand imul
        //   result in rax is exact.
        mov rax, r15;
        sub rax, r14;
        imul rax, r13;
        shr rax, 10;
        add rax, r14;
        mov [r12 + 32], rax;
        jmp scr_st_out;

      scr_st_bwd:
        // Backward: delta = start - target; offset = start - (delta * eased) >> 10.
        mov rax, r14;
        sub rax, r15;
        imul rax, r13;
        shr rax, 10;
        mov rcx, r14;
        sub rcx, rax;
        mov [r12 + 32], rcx;
        mov rax, rcx;
        jmp scr_st_out;

      scr_st_ni:
        mov rdi, 0xFFFFEE8F;
        call scr_set_err;
        mov rax, 0xFFFFEE8F;
        jmp scr_st_out;
      scr_st_ai:
        mov rdi, 0xFFFFEE89;
        call scr_set_err;
        mov rax, 0xFFFFEE89;
        jmp scr_st_out;
      scr_st_bf:
        mov rdi, 0xFFFFEE8B;
        call scr_set_err;
        mov rax, 0xFFFFEE8B;

      scr_st_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // scr_reproject_glyph(base_row_ss) -> u64
  //
  // Translate a glyph's original sub-pixel row by the current scroll
  // offset. Returns base_row_ss - offset_ss (as u64; wrapping if the
  // glyph is above the viewport -- the caller is expected to clip).
  // No init check; on a not-init module offset_ss reads as the zero
  // reset installs, and base_row_ss passes through unchanged.
  // ==========================================================================

  pub let scr_reproject_glyph : (u64) -> u64 !{mem} @{} =
    fn (base_row_ss: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M2-003 (#1405): base_row_ss - offset_ss. Labels prefixed scr_rp_.",
      block: {
        lea r10, [rip + _scr_state];
        mov rax, [r10 + 32];                     // offset_ss
        sub rdi, rax;
        mov rax, rdi;
        ret
      }
    } @no_frame
}
