// src/kernel/core/semterm/gui_a11y.pdx -- R44.M3-002 (#1407)
//
// SEMTERM GUI A11Y BINDING. The G10 accessibility-tree seam for the
// R44 GUI query editor and results region: publishes each widget as
// a node in a bounded rooted tree, tags each with an ARIA-style role
// (text-input / table / cell / chart-region), an opaque name-id and
// value-id (indices into a caller-owned string pool), and a parent
// link, then tracks a publish-pending counter that a live screen
// reader drains.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the A11Y_TREE SEAM behind the R44.M1 gui_shell's regions. A
// live G10 accessibility publisher walks the seam:
//   root := a11_root_add(A11Y_KIND_TEXT_INPUT, name_editor, value_editor)
//   table := a11_child_add(root, A11Y_KIND_TABLE, name_results, 0)
//   cell00 := a11_child_add(table, A11Y_KIND_CELL, name_r0c0, value_r0c0)
//   ...
//   chart := a11_child_add(root, A11Y_KIND_CHART_REGION, name_chart, 0)
//   pending := a11_publish_pending()
//   if pending > 0:
//     // hand the freshly-added subtree to the AT-SPI-like bridge
//     a11_publish_flush()
//
// a11_reset zeroes state; a11_root_add(kind, name_id, value_id)
// installs the tree's single root and returns its node id (0);
// a11_child_add(parent_id, kind, name_id, value_id) allocates a
// child slot, records its depth as parent.depth + 1, and returns the
// child's node id. a11_node_count returns the number of live nodes;
// a11_node_field(id, field) reads one word of one node's record;
// a11_publish_pending / a11_publish_flush / a11_publishes_total track
// the drain seam.
//
// It does NOT own the string pool. name_id / value_id are opaque
// ordinals -- the caller resolves them through its own attribute
// dictionary (semterm/palette.pdx has the same discipline for color
// series). Keeping the string dereference OUT of this module keeps
// a11_ independent of any pool's init state.
//
// It does NOT own the widget tree. The gui_shell / gui_layout / and
// eventual G12 widget hierarchy are the SOURCE of the a11y tree; this
// module is the MIRROR the accessibility bridge walks.
//
// It is a SCAFFOLD (D7): R44.M3 wires it into the witness tree but
// no live G12 widget tree publishes and no live screen reader
// drains; a11_arbitrated() returns 0 until a later round hooks the
// toolkit into a11_root_add / a11_child_add and the bridge into
// a11_publish_flush.
//
// =============================================================================
// §1  NODE ROLES
// =============================================================================
//
// A11Y_KIND_TEXT_INPUT   = 0    query editor (single-line + IME preedit)
// A11Y_KIND_TABLE        = 1    results container
// A11Y_KIND_CELL         = 2    one cell of the results table
// A11Y_KIND_CHART_REGION = 3    a chart placeholder region (SVG/canvas
//                                surrogate for AT-SPI navigation)
// A11Y_KIND_MAX          = 3    largest valid tag
//
// The four roles match the four widget archetypes the R44 GUI
// exposes to a screen reader: an editable line, a two-dimensional
// grid, one grid cell, and a chart surface (which most screen readers
// treat as an announceable region rather than descendable geometry).
// A widening (button / toolbar / menu) is a widening of A11Y_KIND_MAX
// and rewrites the enum comment + the a11_kind_valid check in one
// place.
//
// =============================================================================
// §2  ROOTED TREE
// =============================================================================
//
// A11Y_NODE_MAX = 32. One node per widget. The R44 GUI's four regions
// times an average of six accessible descendants (four column headers,
// a status readback, one chart region) sits well under 32; a
// widening is a widening of A11Y_NODE_MAX and rewrites _a11_nodes's
// declaration.
//
// EXACTLY ONE ROOT. a11_root_add refuses a second call with
// A11_ERR_HAS_ROOT; a11_child_add refuses any call before a root
// exists with A11_ERR_NO_ROOT. A screen reader that walked a forest
// (multiple roots) would either announce two windows for one shell or
// silently pick one, and both are UX faults the refusal prevents.
//
// The root is always node id 0 (it is the first-allocated slot). A
// child's parent_id must be < node_count -- the parent must already
// have been added, which enforces a topological insertion order
// (parents before children). A11_ERR_BAD_PARENT covers parent_id ==
// A11Y_NO_PARENT (the sentinel that means "root has no parent") when
// passed to a11_child_add, and parent_id >= node_count in all other
// cases.
//
// Depth is derived: root has depth 0; each child records
// parent.depth + 1. There is no explicit depth cap -- the pool bound
// (32 nodes) is a coarser upper limit than any realistic screen
// reader would traverse.
//
// =============================================================================
// §3  PUBLISH SEAM
// =============================================================================
//
// Every successful a11_root_add / a11_child_add bumps
// publish_pending by 1. A live AT-SPI-like bridge walks the seam
// exactly as gui_theme's persist_pending / persist_flush pair does:
//
//   pending := a11_publish_pending()
//   if pending > 0:
//     ... walk newly-added nodes and push to the AT bridge ...
//     a11_publish_flush()      // clears pending, bumps publishes_total
//
// a11_publish_flush returns the count it just cleared so a diagnostic
// ring can record it as evidence.
//
// =============================================================================
// §4  ONE WRITER OF THE STATE
// =============================================================================
//
// _a11_state and _a11_nodes are written only by helpers in this
// module. tools/build.sh confines relocations against each to
// `core/semterm/gui_a11y.o`.
//
// STATE LAYOUT -- _a11_state : [u64; 8]
//   +0    init_mark          0xA110 once a11_reset has run
//   +8    err                sticky error latch (first-writer-wins)
//   +16   node_count         0..A11Y_NODE_MAX
//   +24   publish_pending    count of unflushed publishes
//   +32   publishes_flushed  running total across a11_publish_flush
//   +40   root_installed     0 | 1
//   +48   reserved           0
//   +56   reserved           0
//
// NODES LAYOUT -- _a11_nodes : [u64; 32 * 5] = 160 words
//   node(i) = _a11_nodes[i * 5 .. i * 5 + 4]
//     +0  kind              A11Y_KIND_*
//     +8  name_id           opaque ordinal
//     +16 value_id          opaque ordinal
//     +24 parent_id         A11Y_NO_PARENT for root, else 0..node_count-1
//     +32 depth             0 for root, parent.depth + 1 otherwise
//
// =============================================================================
// §5  FAILURE TAXONOMY 0xFFFFEE60..0xFFFFEE6F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time. Adjacent used
// band above: gui_ime 0xFFFFEE70..7F (this milestone). Adjacent free
// band below: 0xFFFFEE50..5F (gui_kbdnav, this milestone).
//
//   A11_OK             = 0
//   A11_ERR_NOT_INIT   = 0xFFFFEE6F   accessor before a11_reset
//   A11_ERR_NODES_FULL = 0xFFFFEE6E   root_add / child_add when pool full
//   A11_ERR_BAD_KIND   = 0xFFFFEE6D   kind > A11Y_KIND_MAX
//   A11_ERR_HAS_ROOT   = 0xFFFFEE6C   root_add after root exists
//   A11_ERR_NO_ROOT    = 0xFFFFEE6B   child_add before root exists
//   A11_ERR_BAD_PARENT = 0xFFFFEE6A   parent_id >= node_count
//   A11_ERR_BAD_NODE   = 0xFFFFEE69   node_field id >= node_count
//   A11_ERR_BAD_FIELD  = 0xFFFFEE68   node_field field > 4
//   A11_ERR_INTERNAL   = 0xFFFFEE67   unreachable-fallthrough tripwire
//
// =============================================================================
// §6  ARITY DISCIPLINE
// =============================================================================
//
// a11_root_add is (kind, name_id, value_id). a11_child_add is
// (parent_id, kind, name_id, value_id). a11_node_field is (id,
// field). Every readback is (). A widening (a per-node checked-state
// bit, a name-key locale, dynamic re-parenting) is a widening of
// these arities and tools/build.sh pins the signatures.

module GuiA11y = structure {

  // Pool bound (§2).
  pub let A11Y_NODE_MAX : u64 = 32

  // Parent sentinel (§2). The root has no parent; this value is
  // stored in the root's parent_id slot and refused as a parent
  // argument to a11_child_add.
  pub let A11Y_NO_PARENT : u64 = 0xFFFFFFFFFFFFFFFF

  // Node roles (§1).
  pub let A11Y_KIND_TEXT_INPUT   : u64 = 0
  pub let A11Y_KIND_TABLE        : u64 = 1
  pub let A11Y_KIND_CELL         : u64 = 2
  pub let A11Y_KIND_CHART_REGION : u64 = 3
  pub let A11Y_KIND_MAX          : u64 = 3

  // Failure taxonomy (§5).
  pub let A11_OK             : u64 = 0
  pub let A11_ERR_NOT_INIT   : u64 = 0xFFFFEE6F
  pub let A11_ERR_NODES_FULL : u64 = 0xFFFFEE6E
  pub let A11_ERR_BAD_KIND   : u64 = 0xFFFFEE6D
  pub let A11_ERR_HAS_ROOT   : u64 = 0xFFFFEE6C
  pub let A11_ERR_NO_ROOT    : u64 = 0xFFFFEE6B
  pub let A11_ERR_BAD_PARENT : u64 = 0xFFFFEE6A
  pub let A11_ERR_BAD_NODE   : u64 = 0xFFFFEE69
  pub let A11_ERR_BAD_FIELD  : u64 = 0xFFFFEE68
  pub let A11_ERR_INTERNAL   : u64 = 0xFFFFEE67

  pub let A11_INIT_MARK : u64 = 0xA110

  pub let mut _a11_state : [u64; 8]   = uninit @align(64)
  pub let mut _a11_nodes : [u64; 160] = uninit @align(64)

  // ==========================================================================
  // Reset. Boot + teardown.
  // ==========================================================================

  pub let a11_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M3-002 (#1407): clear state + node pool, install init_mark. Labels prefixed a11_rst_.",
      block: {
        lea r10, [rip + _a11_nodes];
        xor rax, rax;
        xor rcx, rcx;
      a11_rst_nd:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 160;
        jb  a11_rst_nd;

        lea r10, [rip + _a11_state];
        xor rcx, rcx;
      a11_rst_st:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  a11_rst_st;

        mov rax, 0xA110;
        mov [r10 + 0], rax;                      // init_mark
        ret
      }
    }

  pub let a11_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R44.M3-002 (#1407): honesty pin. Returns 0 until a live G12 widget tree publishes and a live AT bridge drains a11_publish_flush.",
      block: {
        xor rax, rax;
        ret
      }
    }

  pub let a11_err : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M3-002 (#1407): sticky error latch readback.",
      block: {
        lea r10, [rip + _a11_state];
        mov rax, [r10 + 8];
        ret
      }
    }

  pub let a11_bound : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M3-002 (#1407): 1 iff init_mark matches. Labels prefixed a11_bnd_.",
      block: {
        lea r10, [rip + _a11_state];
        mov rax, [r10 + 0];
        mov r11, 0xA110;
        cmp rax, r11;
        jne a11_bnd_no;
        mov rax, 1;
        ret;
      a11_bnd_no:
        xor rax, rax;
        ret
      }
    }

  pub let a11_set_err : (u64) -> () !{mem} @{} =
    fn (code: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M3-002 (#1407): first-writer-wins error latch. Labels prefixed a11_se_.",
      block: {
        lea r10, [rip + _a11_state];
        mov rax, [r10 + 8];
        cmp rax, 0;
        jne a11_se_out;
        mov [r10 + 8], rdi;
      a11_se_out:
        ret
      }
    }

  // ==========================================================================
  // Readbacks.
  // ==========================================================================

  pub let a11_node_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M3-002 (#1407): node_count field.",
      block: {
        lea r10, [rip + _a11_state];
        mov rax, [r10 + 16];
        ret
      }
    }

  pub let a11_publish_pending : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M3-002 (#1407): publish_pending field.",
      block: {
        lea r10, [rip + _a11_state];
        mov rax, [r10 + 24];
        ret
      }
    }

  pub let a11_publishes_flushed : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M3-002 (#1407): publishes_flushed running total.",
      block: {
        lea r10, [rip + _a11_state];
        mov rax, [r10 + 32];
        ret
      }
    }

  pub let a11_root_installed : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M3-002 (#1407): root_installed field (1 iff a11_root_add succeeded).",
      block: {
        lea r10, [rip + _a11_state];
        mov rax, [r10 + 40];
        ret
      }
    }

  // ==========================================================================
  // a11_node_field(node_id, field) -> u64
  //
  // Read one field of one node. field: 0=kind, 1=name_id, 2=value_id,
  // 3=parent_id, 4=depth. Refuses node_id >= node_count OR field > 4.
  // ==========================================================================

  pub let a11_node_field : (u64, u64) -> u64 !{mem} @{} =
    fn (node_id: u64, field: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M3-002 (#1407): read one field of one node. Labels prefixed a11_nf_.",
      block: {
        lea r10, [rip + _a11_state];
        mov rax, [r10 + 16];                     // node_count
        cmp rdi, rax;
        jae a11_nf_bn;
        cmp rsi, 4;
        ja  a11_nf_bf;

        mov rax, rdi;
        mov r11, 5;
        imul rax, r11;                           // rax = node_id * 5
        add rax, rsi;
        lea r10, [rip + _a11_nodes];
        mov rax, [r10 + rax * 8];
        ret;

      a11_nf_bn:
        mov rdi, 0xFFFFEE69;
        call a11_set_err;
        xor rax, rax;
        ret;
      a11_nf_bf:
        mov rdi, 0xFFFFEE68;
        call a11_set_err;
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // a11_root_add(kind, name_id, value_id) -> u64
  //
  // Install the single root node. Returns node id 0 on success.
  // Refuses not init, bad kind, root already exists (HAS_ROOT). Pool
  // full is impossible on this path (root is always allocated when
  // node_count == 0, so NODES_FULL cannot trigger against 32 slots),
  // but the taxonomy still reserves it for child_add.
  // ==========================================================================

  pub let a11_root_add : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (kind: u64, name_id: u64, value_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M3-002 (#1407): install root node at id 0. Labels prefixed a11_ra_.",
      block: {
        lea r10, [rip + _a11_state];
        mov rax, [r10 + 0];
        mov r11, 0xA110;
        cmp rax, r11;
        jne a11_ra_ni;

        // root_installed must be 0.
        mov rax, [r10 + 40];
        cmp rax, 0;
        jne a11_ra_hr;

        // kind <= A11Y_KIND_MAX.
        cmp rdi, 3;
        ja  a11_ra_bk;

        // Root goes at index 0. node_count is 0 here (root_installed
        // == 0 implies node_count == 0 by construction).
        lea r11, [rip + _a11_nodes];
        mov [r11 + 0],  rdi;                     // kind
        mov [r11 + 8],  rsi;                     // name_id
        mov [r11 + 16], rdx;                     // value_id
        mov rax, 0xFFFFFFFFFFFFFFFF;
        mov [r11 + 24], rax;                     // parent_id = A11Y_NO_PARENT
        xor rax, rax;
        mov [r11 + 32], rax;                     // depth = 0

        // node_count = 1.
        mov rax, 1;
        mov [r10 + 16], rax;
        // root_installed = 1.
        mov [r10 + 40], rax;
        // publish_pending += 1.
        mov rax, [r10 + 24];
        add rax, 1;
        mov [r10 + 24], rax;

        xor rax, rax;                            // root id
        ret;

      a11_ra_ni:
        mov rdi, 0xFFFFEE6F;
        call a11_set_err;
        mov rax, 0xFFFFEE6F;
        ret;
      a11_ra_hr:
        mov rdi, 0xFFFFEE6C;
        call a11_set_err;
        mov rax, 0xFFFFEE6C;
        ret;
      a11_ra_bk:
        mov rdi, 0xFFFFEE6D;
        call a11_set_err;
        mov rax, 0xFFFFEE6D;
        ret
      }
    }

  // ==========================================================================
  // a11_child_add(parent_id, kind, name_id, value_id) -> u64
  //
  // Append a child under an existing node. Returns the new child's
  // id. Refuses not init, root missing (NO_ROOT), bad kind, bad
  // parent (parent_id >= node_count, incl. sentinel), pool full.
  // ==========================================================================

  pub let a11_child_add : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (parent_id: u64, kind: u64, name_id: u64, value_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M3-002 (#1407): allocate child under existing parent. Labels prefixed a11_ca_.",
      block: {
        lea r10, [rip + _a11_state];
        mov rax, [r10 + 0];
        mov r11, 0xA110;
        cmp rax, r11;
        jne a11_ca_ni;

        // Root must be installed.
        mov rax, [r10 + 40];
        cmp rax, 0;
        je  a11_ca_nr;

        // kind <= A11Y_KIND_MAX.
        cmp rsi, 3;
        ja  a11_ca_bk;

        // parent_id < node_count.
        mov rax, [r10 + 16];                     // node_count
        cmp rdi, rax;
        jae a11_ca_bp;

        // Pool full?
        cmp rax, 32;
        jae a11_ca_nf;

        // Compute parent's depth.
        mov r11, 5;
        mov r9, rdi;                             // r9 = parent_id
        imul r9, r11;                            // r9 = parent_id * 5
        add r9, 4;                               // ... + 4 (depth slot)
        lea r11, [rip + _a11_nodes];
        mov r9, [r11 + r9 * 8];                  // r9 = parent depth
        add r9, 1;                               // child depth

        // Write child at index node_count.
        mov r11, 5;
        imul rax, r11;                           // rax = node_count * 5
        lea r11, [rip + _a11_nodes];
        lea r11, [r11 + rax * 8];                // r11 = &nodes[node_count]

        mov [r11 + 0],  rsi;                     // kind
        mov [r11 + 8],  rdx;                     // name_id
        mov [r11 + 16], rcx;                     // value_id
        mov [r11 + 24], rdi;                     // parent_id
        mov [r11 + 32], r9;                      // depth

        // Bump node_count and return the freshly-assigned id.
        mov rax, [r10 + 16];                     // old node_count (== child_id)
        mov r8, rax;
        add rax, 1;
        mov [r10 + 16], rax;

        // publish_pending += 1.
        mov rax, [r10 + 24];
        add rax, 1;
        mov [r10 + 24], rax;

        mov rax, r8;                             // child_id = old node_count
        ret;

      a11_ca_ni:
        mov rdi, 0xFFFFEE6F;
        call a11_set_err;
        mov rax, 0xFFFFEE6F;
        ret;
      a11_ca_nr:
        mov rdi, 0xFFFFEE6B;
        call a11_set_err;
        mov rax, 0xFFFFEE6B;
        ret;
      a11_ca_bk:
        mov rdi, 0xFFFFEE6D;
        call a11_set_err;
        mov rax, 0xFFFFEE6D;
        ret;
      a11_ca_bp:
        mov rdi, 0xFFFFEE6A;
        call a11_set_err;
        mov rax, 0xFFFFEE6A;
        ret;
      a11_ca_nf:
        mov rdi, 0xFFFFEE6E;
        call a11_set_err;
        mov rax, 0xFFFFEE6E;
        ret
      }
    }

  // ==========================================================================
  // a11_publish_flush() -> u64
  //
  // Return the current publish_pending count and clear it. Bumps
  // publishes_flushed by the returned count. Refuses not init.
  // ==========================================================================

  pub let a11_publish_flush : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M3-002 (#1407): drain publish_pending; add to publishes_flushed. Labels prefixed a11_pf_.",
      block: {
        lea r10, [rip + _a11_state];
        mov rax, [r10 + 0];
        mov r11, 0xA110;
        cmp rax, r11;
        jne a11_pf_ni;

        mov r8, [r10 + 24];                      // pending
        xor rax, rax;
        mov [r10 + 24], rax;                     // pending = 0

        mov rax, [r10 + 32];                     // flushed total
        add rax, r8;
        mov [r10 + 32], rax;

        mov rax, r8;                             // return old pending
        ret;

      a11_pf_ni:
        mov rdi, 0xFFFFEE6F;
        call a11_set_err;
        mov rax, 0xFFFFEE6F;
        ret
      }
    }
}
