// src/kernel/core/semterm/layout.pdx -- R41.M3-002 (#1372)
//
// CHART LAYOUT ENGINE for the semantic terminal. Owns the arena of
// grid-based sub-rectangles ("panes") that carve a canvas into named
// regions. Every pane addresses a rectangular subset of the 80x24
// plot canvas (semterm/plot.pdx) via (row0, col0, rows, cols); the
// engine that composes a chart consumes pane rectangles rather than
// hard-coded offsets, so a widening of the geometry rewrites nothing
// downstream.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the PANE ARENA + THE SPLITTER. lay_root(rows, cols) installs
// pane 0 covering (0, 0, rows, cols); lay_split_h(parent, top_size,
// bottom_size) carves the parent into two horizontally-stacked children
// with the given row extents; lay_split_v does the equivalent for
// vertically-stacked children (column extents). NESTED LAYOUTS ARE
// SPLITS APPLIED TO A CHILD: splitting a child does not touch its
// parent's rectangle, and a caller composes a row-of-cols by
// lay_split_h on the root then lay_split_v on each child.
//
// A size argument of 0 means FLEX: the child takes the parent's
// remaining extent along that axis. Passing 0 to BOTH sides of a
// split is refused (the parent is not carved and the caller cannot
// tell which pane was actually created). Passing non-zero sizes that
// sum to more than the parent's extent is refused (the layout is
// over-specified and the ambiguity must surface).
//
// It does NOT parse a DSL string. The R41.M3 issue's spec-string
// syntax ("2 rows: title(1); body(*)") is a LATER round's frontend
// over these primitives -- lay_root + lay_split_h with sizes {1, 0}
// realises exactly that spec. Keeping the parser out of this module
// keeps the layout arena describable without pulling in the lexer /
// parser stack.
//
// It does NOT draw. It does NOT allocate a plot canvas. Every
// consumer that renders through a pane reads (row0, col0, rows, cols)
// via lay_pane_r0/lay_pane_c0/lay_pane_rows/lay_pane_cols and hands
// coordinates to plt_put.
//
// It is a SCAFFOLD (D7): R41.M3 wires it into the witness tree but
// no live query drives it; lay_arbitrated() returns 0 until a later
// round hooks the semantic engine's result set into a laid-out
// chart.
//
// =============================================================================
// §1  ARENA GEOMETRY
// =============================================================================
//
// Pane arena: 32 panes maximum. Pane 0 is the root (allocated by
// lay_root). Splits allocate two contiguous panes at the tail of the
// arena and return the first child's id; the second child is at
// first_id + 1. LAY_ERR_FULL when the arena has no room for two
// more panes.
//
// TABLE LAYOUT -- _lay_arena : [u64; 128]  (= 32 panes * 4 fields)
//
//   pane(i) = _lay_arena[i * 4 .. i * 4 + 3]
//     +0   row0        top row of the pane's rectangle
//     +8   col0        left column of the pane's rectangle
//     +16  rows        row extent (1..parent.rows)
//     +24  cols        col extent (1..parent.cols)
//
// STATE LAYOUT -- _lay_state : [u64; 8]
//   +0    init_mark    0x1A70 once lay_reset has run
//   +8    err          sticky error latch
//   +16   pane_count   number of live panes in _lay_arena (0..32)
//   +24   root_set     1 once lay_root has run (0 at reset)
//   +32   reserved
//   +40   reserved
//   +48   reserved
//   +56   reserved
//
// =============================================================================
// §2  ONE WRITER OF THE STATE
// =============================================================================
//
// _lay_arena and _lay_state are written only by helpers in this
// module. tools/build.sh confines relocations against each to
// `core/semterm/layout.o`.
//
// =============================================================================
// §3  FAILURE TAXONOMY 0xFFFFF070..0xFFFFF07F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time. Adjacent used
// band above: plot 0xFFFFF080..8F (R41.M3-001). Adjacent free band
// below: palette 0xFFFFF060..6F (R41.M3-003).
//
//   LAY_OK             = 0
//   LAY_ERR_NOT_INIT   = 0xFFFFF07F   lay_root/split before lay_reset
//   LAY_ERR_FULL       = 0xFFFFF07E   arena has no room for another split
//   LAY_ERR_BAD_ID     = 0xFFFFF07D   pane_id outside [0, pane_count)
//   LAY_ERR_BAD_SIZE   = 0xFFFFF07C   size arguments contradict parent extent
//   LAY_ERR_NO_ROOT    = 0xFFFFF07B   split before lay_root
//   LAY_ERR_ROOT_TWICE = 0xFFFFF07A   lay_root called twice without a reset
//   LAY_ERR_INTERNAL   = 0xFFFFF079   unreachable-fallthrough tripwire
//
// =============================================================================
// §4  ARITY DISCIPLINE
// =============================================================================
//
// lay_split_h and lay_split_v are (parent_id, size_a, size_b) so
// both child extents are caller-visible. A widening (an N-way split)
// is a widening of this arity, and the build.sh gate pins it.

module Layout = structure {

  // Arena geometry (§1).
  pub let LAY_MAX_PANES : u64 = 32
  pub let LAY_ROW_WORDS : u64 = 4                  // (r0, c0, rows, cols)
  pub let LAY_ARENA_WORDS : u64 = 128              // 32 * 4

  // Failure taxonomy (§3).
  pub let LAY_OK              : u64 = 0
  pub let LAY_ERR_NOT_INIT    : u64 = 0xFFFFF07F
  pub let LAY_ERR_FULL        : u64 = 0xFFFFF07E
  pub let LAY_ERR_BAD_ID      : u64 = 0xFFFFF07D
  pub let LAY_ERR_BAD_SIZE    : u64 = 0xFFFFF07C
  pub let LAY_ERR_NO_ROOT     : u64 = 0xFFFFF07B
  pub let LAY_ERR_ROOT_TWICE  : u64 = 0xFFFFF07A
  pub let LAY_ERR_INTERNAL    : u64 = 0xFFFFF079

  pub let LAY_INIT_MARK : u64 = 0x1A70

  pub let mut _lay_arena : [u64; 128] = uninit @align(64)
  pub let mut _lay_state : [u64; 8]   = uninit @align(64)

  // ==========================================================================
  // Reset. Boot + teardown.
  // ==========================================================================

  pub let lay_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M3-002 (#1372): clear arena + state, install init_mark. Labels prefixed lay_rst_.",
      block: {
        lea r10, [rip + _lay_arena];
        xor rax, rax;
        xor rcx, rcx;
      lay_rst_ar:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 128;
        jb  lay_rst_ar;

        lea r10, [rip + _lay_state];
        xor rcx, rcx;
      lay_rst_st:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  lay_rst_st;

        mov rax, 0x1A70;
        mov [r10 + 0], rax;                     // init_mark
        ret
      }
    } @no_frame

  pub let lay_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R41.M3-002 (#1372): honesty pin. Returns 0 until a later round consumes pane rectangles from a live chart.",
      block: {
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let lay_err : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M3-002 (#1372): sticky error latch readback. Labels prefixed lay_er_.",
      block: {
        lea r10, [rip + _lay_state];
        mov rax, [r10 + 8];
        ret
      }
    } @no_frame

  pub let lay_bound : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M3-002 (#1372): 1 iff init_mark matches. Labels prefixed lay_bnd_.",
      block: {
        lea r10, [rip + _lay_state];
        mov rax, [r10 + 0];
        mov r11, 0x1A70;
        cmp rax, r11;
        jne lay_bnd_no;
        mov rax, 1;
        ret;
      lay_bnd_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let lay_pane_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M3-002 (#1372): live pane count. Labels prefixed lay_pc_.",
      block: {
        lea r10, [rip + _lay_state];
        mov rax, [r10 + 16];
        ret
      }
    } @no_frame

  pub let lay_root_set : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M3-002 (#1372): 1 iff lay_root has run since reset. Labels prefixed lay_rs_.",
      block: {
        lea r10, [rip + _lay_state];
        mov rax, [r10 + 24];
        ret
      }
    } @no_frame

  pub let lay_set_err : (u64) -> () !{mem} @{} =
    fn (code: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M3-002 (#1372): first-writer-wins error latch. Labels prefixed lay_se_.",
      block: {
        lea r10, [rip + _lay_state];
        mov rax, [r10 + 8];
        cmp rax, 0;
        jne lay_se_out;
        mov [r10 + 8], rdi;
      lay_se_out:
        ret
      }
    } @no_frame

  // ==========================================================================
  // Field readbacks.
  // ==========================================================================

  pub let lay_pane_r0 : (u64) -> u64 !{mem} @{} =
    fn (pane_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M3-002 (#1372): row0 field of pane_id. Labels prefixed lay_r0_.",
      block: {
        lea r10, [rip + _lay_state];
        mov rax, [r10 + 0];
        mov r11, 0x1A70;
        cmp rax, r11;
        jne lay_r0_ni;
        mov r8, [r10 + 16];
        cmp rdi, r8;
        jae lay_r0_bi;
        lea r10, [rip + _lay_arena];
        mov r9, rdi;
        shl r9, 2;                                // pane * 4 words
        mov rax, [r10 + r9 * 8 + 0];
        ret;
      lay_r0_ni:
        mov rdi, 0xFFFFF07F;
        call lay_set_err;
        xor rax, rax;
        ret;
      lay_r0_bi:
        mov rdi, 0xFFFFF07D;
        call lay_set_err;
        xor rax, rax;
        ret
      }
    }

  pub let lay_pane_c0 : (u64) -> u64 !{mem} @{} =
    fn (pane_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M3-002 (#1372): col0 field of pane_id. Labels prefixed lay_c0_.",
      block: {
        lea r10, [rip + _lay_state];
        mov rax, [r10 + 0];
        mov r11, 0x1A70;
        cmp rax, r11;
        jne lay_c0_ni;
        mov r8, [r10 + 16];
        cmp rdi, r8;
        jae lay_c0_bi;
        lea r10, [rip + _lay_arena];
        mov r9, rdi;
        shl r9, 2;
        mov rax, [r10 + r9 * 8 + 8];
        ret;
      lay_c0_ni:
        mov rdi, 0xFFFFF07F;
        call lay_set_err;
        xor rax, rax;
        ret;
      lay_c0_bi:
        mov rdi, 0xFFFFF07D;
        call lay_set_err;
        xor rax, rax;
        ret
      }
    }

  pub let lay_pane_rows : (u64) -> u64 !{mem} @{} =
    fn (pane_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M3-002 (#1372): rows extent of pane_id. Labels prefixed lay_pr_.",
      block: {
        lea r10, [rip + _lay_state];
        mov rax, [r10 + 0];
        mov r11, 0x1A70;
        cmp rax, r11;
        jne lay_pr_ni;
        mov r8, [r10 + 16];
        cmp rdi, r8;
        jae lay_pr_bi;
        lea r10, [rip + _lay_arena];
        mov r9, rdi;
        shl r9, 2;
        mov rax, [r10 + r9 * 8 + 16];
        ret;
      lay_pr_ni:
        mov rdi, 0xFFFFF07F;
        call lay_set_err;
        xor rax, rax;
        ret;
      lay_pr_bi:
        mov rdi, 0xFFFFF07D;
        call lay_set_err;
        xor rax, rax;
        ret
      }
    }

  pub let lay_pane_cols : (u64) -> u64 !{mem} @{} =
    fn (pane_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M3-002 (#1372): cols extent of pane_id. Labels prefixed lay_pk_.",
      block: {
        lea r10, [rip + _lay_state];
        mov rax, [r10 + 0];
        mov r11, 0x1A70;
        cmp rax, r11;
        jne lay_pk_ni;
        mov r8, [r10 + 16];
        cmp rdi, r8;
        jae lay_pk_bi;
        lea r10, [rip + _lay_arena];
        mov r9, rdi;
        shl r9, 2;
        mov rax, [r10 + r9 * 8 + 24];
        ret;
      lay_pk_ni:
        mov rdi, 0xFFFFF07F;
        call lay_set_err;
        xor rax, rax;
        ret;
      lay_pk_bi:
        mov rdi, 0xFFFFF07D;
        call lay_set_err;
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // lay_root(rows, cols) -> pane_id | error
  //
  // Install pane 0 covering (0, 0, rows, cols). Refused if not init,
  // if rows or cols is zero, or if lay_root was already called since
  // the last reset (root can only be set once so the arena
  // never carries a stale root while children reference the old
  // rectangle).
  // ==========================================================================

  pub let lay_root : (u64, u64) -> u64 !{mem} @{} =
    fn (rows: u64, cols: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M3-002 (#1372): install pane 0 (root) covering the full canvas. Labels prefixed lay_rt_.",
      block: {
        lea r10, [rip + _lay_state];
        mov rax, [r10 + 0];
        mov r11, 0x1A70;
        cmp rax, r11;
        jne lay_rt_ni;

        mov rax, [r10 + 24];                     // root_set
        cmp rax, 0;
        jne lay_rt_rt;

        cmp rdi, 0;
        je  lay_rt_bs;
        cmp rsi, 0;
        je  lay_rt_bs;

        // Store pane 0 fields.
        lea r10, [rip + _lay_arena];
        xor rax, rax;
        mov [r10 + 0], rax;                      // row0 = 0
        mov [r10 + 8], rax;                      // col0 = 0
        mov [r10 + 16], rdi;                     // rows
        mov [r10 + 24], rsi;                     // cols

        lea r10, [rip + _lay_state];
        mov rax, 1;
        mov [r10 + 16], rax;                     // pane_count = 1
        mov [r10 + 24], rax;                     // root_set = 1
        xor rax, rax;
        ret;

      lay_rt_ni:
        mov rdi, 0xFFFFF07F;
        call lay_set_err;
        mov rax, 0xFFFFF07F;
        ret;
      lay_rt_rt:
        mov rdi, 0xFFFFF07A;
        call lay_set_err;
        mov rax, 0xFFFFF07A;
        ret;
      lay_rt_bs:
        mov rdi, 0xFFFFF07C;
        call lay_set_err;
        mov rax, 0xFFFFF07C;
        ret
      }
    }

  // ==========================================================================
  // lay_split_h(parent_id, top_rows, bottom_rows) -> first_child_id
  //
  // Split parent into two horizontally-stacked children (top +
  // bottom). Each child inherits the parent's col extent. Each
  // child's row extent is the corresponding size argument; a size of
  // 0 means FLEX (takes the parent's remaining rows).
  //
  // Refuses if:
  //   - not init                           LAY_ERR_NOT_INIT
  //   - no root                            LAY_ERR_NO_ROOT
  //   - parent_id out of range             LAY_ERR_BAD_ID
  //   - top and bottom both 0              LAY_ERR_BAD_SIZE
  //   - non-zero sizes sum > parent.rows   LAY_ERR_BAD_SIZE
  //   - arena has no room for two panes    LAY_ERR_FULL
  //
  // Returns the id of the FIRST child (top); second child is
  // first + 1.
  //
  // Locals: rbx = parent, r12 = top, r13 = bottom, r14 = first_id.
  // ==========================================================================

  pub let lay_split_h : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (parent_id: u64, top_rows: u64, bottom_rows: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M3-002 (#1372): horizontal split (rows carve). Labels prefixed lay_sh_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        mov rbx, rdi;
        mov r12, rsi;
        mov r13, rdx;

        lea r10, [rip + _lay_state];
        mov rax, [r10 + 0];
        mov r11, 0x1A70;
        cmp rax, r11;
        jne lay_sh_ni;

        mov rax, [r10 + 24];
        cmp rax, 0;
        je  lay_sh_nr;

        mov r8, [r10 + 16];                      // pane_count
        cmp rbx, r8;
        jae lay_sh_bi;

        // Both sizes zero -> ambiguous.
        mov rax, r12;
        or  rax, r13;
        cmp rax, 0;
        je  lay_sh_bs;

        // Read parent geometry.
        lea r10, [rip + _lay_arena];
        mov r9, rbx;
        shl r9, 2;                                // parent * 4 words
        mov r14, [r10 + r9 * 8 + 0];              // parent.row0
        mov r15, [r10 + r9 * 8 + 8];              // parent.col0
        mov rax, [r10 + r9 * 8 + 16];             // parent.rows
        mov rcx, [r10 + r9 * 8 + 24];             // parent.cols

        // Resolve flex.
        // if top == 0: top = parent.rows - bottom
        // if bottom == 0: bottom = parent.rows - top
        // else: check top + bottom <= parent.rows
        cmp r12, 0;
        jne lay_sh_top_ok;
        // top flex: needs bottom <= parent.rows
        cmp r13, rax;
        ja  lay_sh_bs;
        mov r12, rax;
        sub r12, r13;
        jmp lay_sh_sizes_ok;
      lay_sh_top_ok:
        cmp r13, 0;
        jne lay_sh_both;
        // bottom flex.
        cmp r12, rax;
        ja  lay_sh_bs;
        mov r13, rax;
        sub r13, r12;
        jmp lay_sh_sizes_ok;
      lay_sh_both:
        // Neither flex: check sum <= parent.rows.
        mov r8, r12;
        add r8, r13;
        cmp r8, rax;
        ja  lay_sh_bs;
      lay_sh_sizes_ok:

        // Ensure arena has room for two more panes.
        lea r10, [rip + _lay_state];
        mov r8, [r10 + 16];                      // pane_count
        mov r9, r8;
        add r9, 2;
        cmp r9, 32;
        ja  lay_sh_full;

        // Allocate two panes at slots r8 (top) and r8+1 (bottom).
        // top: (row0=parent.row0, col0=parent.col0, rows=r12, cols=parent.cols)
        // bot: (row0=parent.row0+r12, col0=parent.col0, rows=r13, cols=parent.cols)
        lea r10, [rip + _lay_arena];
        mov r9, r8;
        shl r9, 2;                                // slot * 4 words
        mov [r10 + r9 * 8 + 0], r14;              // row0
        mov [r10 + r9 * 8 + 8], r15;              // col0
        mov [r10 + r9 * 8 + 16], r12;             // rows
        mov [r10 + r9 * 8 + 24], rcx;             // cols

        // Bottom pane row0 = parent.row0 + top_rows.
        mov rax, r14;
        add rax, r12;
        mov r9, r8;
        add r9, 1;
        shl r9, 2;
        mov [r10 + r9 * 8 + 0], rax;              // row0
        mov [r10 + r9 * 8 + 8], r15;              // col0
        mov [r10 + r9 * 8 + 16], r13;             // rows
        mov [r10 + r9 * 8 + 24], rcx;             // cols

        // Bump pane_count.
        lea r10, [rip + _lay_state];
        mov r9, [r10 + 16];
        mov rax, r9;
        add rax, 2;
        mov [r10 + 16], rax;

        // Return first child id = r8 (original pane_count).
        mov rax, r8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      lay_sh_ni:
        mov rdi, 0xFFFFF07F;
        call lay_set_err;
        mov rax, 0xFFFFF07F;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;
      lay_sh_nr:
        mov rdi, 0xFFFFF07B;
        call lay_set_err;
        mov rax, 0xFFFFF07B;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;
      lay_sh_bi:
        mov rdi, 0xFFFFF07D;
        call lay_set_err;
        mov rax, 0xFFFFF07D;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;
      lay_sh_bs:
        mov rdi, 0xFFFFF07C;
        call lay_set_err;
        mov rax, 0xFFFFF07C;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;
      lay_sh_full:
        mov rdi, 0xFFFFF07E;
        call lay_set_err;
        mov rax, 0xFFFFF07E;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // lay_split_v(parent_id, left_cols, right_cols) -> first_child_id
  //
  // Vertical split (col carve). Same shape as lay_split_h with rows
  // and cols swapped.
  //
  // Locals: rbx = parent, r12 = left, r13 = right, r14 = parent.row0,
  //         r15 = parent.col0. rcx holds parent.rows across the flex
  //         arithmetic; parent.cols is reloaded before the store.
  // ==========================================================================

  pub let lay_split_v : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (parent_id: u64, left_cols: u64, right_cols: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M3-002 (#1372): vertical split (cols carve). Labels prefixed lay_sv_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        mov rbx, rdi;
        mov r12, rsi;
        mov r13, rdx;

        lea r10, [rip + _lay_state];
        mov rax, [r10 + 0];
        mov r11, 0x1A70;
        cmp rax, r11;
        jne lay_sv_ni;

        mov rax, [r10 + 24];
        cmp rax, 0;
        je  lay_sv_nr;

        mov r8, [r10 + 16];
        cmp rbx, r8;
        jae lay_sv_bi;

        mov rax, r12;
        or  rax, r13;
        cmp rax, 0;
        je  lay_sv_bs;

        // Read parent geometry.
        lea r10, [rip + _lay_arena];
        mov r9, rbx;
        shl r9, 2;
        mov r14, [r10 + r9 * 8 + 0];              // parent.row0
        mov r15, [r10 + r9 * 8 + 8];              // parent.col0
        mov rcx, [r10 + r9 * 8 + 16];             // parent.rows
        mov rax, [r10 + r9 * 8 + 24];             // parent.cols

        // Resolve flex against parent.cols (rax).
        cmp r12, 0;
        jne lay_sv_left_ok;
        cmp r13, rax;
        ja  lay_sv_bs;
        mov r12, rax;
        sub r12, r13;
        jmp lay_sv_sizes_ok;
      lay_sv_left_ok:
        cmp r13, 0;
        jne lay_sv_both;
        cmp r12, rax;
        ja  lay_sv_bs;
        mov r13, rax;
        sub r13, r12;
        jmp lay_sv_sizes_ok;
      lay_sv_both:
        mov r8, r12;
        add r8, r13;
        cmp r8, rax;
        ja  lay_sv_bs;
      lay_sv_sizes_ok:

        // Ensure arena room.
        lea r10, [rip + _lay_state];
        mov r8, [r10 + 16];
        mov r9, r8;
        add r9, 2;
        cmp r9, 32;
        ja  lay_sv_full;

        // Allocate: left (row0=parent.row0, col0=parent.col0, rows=parent.rows, cols=r12).
        // right     (row0=parent.row0, col0=parent.col0+r12, rows=parent.rows, cols=r13).
        lea r10, [rip + _lay_arena];
        mov r9, r8;
        shl r9, 2;
        mov [r10 + r9 * 8 + 0], r14;              // row0
        mov [r10 + r9 * 8 + 8], r15;              // col0
        mov [r10 + r9 * 8 + 16], rcx;             // rows = parent.rows
        mov [r10 + r9 * 8 + 24], r12;             // cols = left

        mov rax, r15;
        add rax, r12;                             // parent.col0 + left
        mov r9, r8;
        add r9, 1;
        shl r9, 2;
        mov [r10 + r9 * 8 + 0], r14;              // row0
        mov [r10 + r9 * 8 + 8], rax;              // col0
        mov [r10 + r9 * 8 + 16], rcx;             // rows
        mov [r10 + r9 * 8 + 24], r13;             // cols = right

        lea r10, [rip + _lay_state];
        mov r9, [r10 + 16];
        mov rax, r9;
        add rax, 2;
        mov [r10 + 16], rax;

        mov rax, r8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      lay_sv_ni:
        mov rdi, 0xFFFFF07F;
        call lay_set_err;
        mov rax, 0xFFFFF07F;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;
      lay_sv_nr:
        mov rdi, 0xFFFFF07B;
        call lay_set_err;
        mov rax, 0xFFFFF07B;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;
      lay_sv_bi:
        mov rdi, 0xFFFFF07D;
        call lay_set_err;
        mov rax, 0xFFFFF07D;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;
      lay_sv_bs:
        mov rdi, 0xFFFFF07C;
        call lay_set_err;
        mov rax, 0xFFFFF07C;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;
      lay_sv_full:
        mov rdi, 0xFFFFF07E;
        call lay_set_err;
        mov rax, 0xFFFFF07E;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
