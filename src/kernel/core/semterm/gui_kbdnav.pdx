// src/kernel/core/semterm/gui_kbdnav.pdx -- R44.M3-003 (#1408)
//
// SEMTERM GUI KEYBOARD NAVIGATION. Focus routing across the R44 GUI
// panels per the G10 keyboard spec: Tab / Shift+Tab cycle focus
// through the widgets of the active panel; F6 / Shift+F6 rotate the
// panel focus; arrow keys walk within a panel (dir 0..3 = up / down
// / left / right); a focus-ring visibility flag models the "user
// engaged keyboard nav" hint; skip-links reset focus to widget 0 for
// long pager pages.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the KEYBOARD FOCUS SEAM behind the R44.M1 gui_shell's four
// regions and the R44.M1 gui_layout's per-region widget tree. A live
// G10 input router walks the seam:
//   knv_widgets_set(panel, n)   // once per panel at layout time
//   ...
//   knv_ring_show(1)            // user pressed a nav key
//   knv_next_widget()           // Tab
//   knv_next_panel()            // F6
//   knv_arrow(KNV_DIR_DOWN)     // arrow within panel
//   knv_skip_link_next()        // skip-link on a pager page
//
// knv_reset zeroes state (panel=0, widget=0, ring hidden, widgets
// per panel default 1) and installs the init_mark;
// knv_widgets_set(panel_id, count) parks a per-panel widget count
// (refuses count == 0); knv_focus_panel / knv_focus_widget report
// the current focus; knv_next_widget / knv_prev_widget cycle the
// widget within the current panel modulo widgets_per_panel; F6 pair
// (knv_next_panel / knv_prev_panel) rotates the panel and resets
// widget focus to 0; knv_arrow(dir) is the within-panel arrow (up /
// left map to prev, down / right to next); knv_ring_show(flag) sets
// the focus-ring visibility hint; knv_skip_link_next / _prev bump a
// skip-hits counter and reset widget focus to 0.
//
// It does NOT paint the ring. The Vello backend
// (semterm/gui_vello.pdx) reads knv_ring_visible + knv_focus_panel +
// knv_focus_widget at frame time and draws a border overlay under
// the focused widget's rectangle. It does NOT own the widget
// geometry: the per-panel widget count is a scalar the caller sets
// once per layout pass.
//
// It is a SCAFFOLD (D7): R44.M3 wires it into the witness tree but
// no live G10 input router pumps keys; knv_arbitrated() returns 0
// until a later round hooks the input stack into knv_next_widget /
// knv_next_panel / knv_arrow.
//
// =============================================================================
// §1  PANEL AND WIDGET MODEL
// =============================================================================
//
// KNV_PANEL_MAX = 4. Four panels, one per R44.M1 gui_shell region
// (query editor, results, tab bar, status bar). Widening the panel
// set is a widening of KNV_PANEL_MAX and rewrites _knv_widgets's
// declaration in one place.
//
// Widgets per panel are caller-supplied: knv_widgets_set(panel_id,
// count) parks a positive count into _knv_widgets[panel_id]. Zero
// is refused (KNV_ERR_BAD_COUNT) so cycling arithmetic (widget = (w
// + 1) % widgets_per_panel[p]) can never divide by zero.
//
// At reset every panel starts with count 1. That way an early
// knv_next_widget call against a panel whose layout has not yet
// populated widgets stays inside the modulus and cannot escape the
// panel (widget remains 0). A widening (per-panel default counts
// derived from the layout schema) is a widening of knv_reset's
// initial fill loop.
//
// =============================================================================
// §2  DIRECTIONAL ARROWS
// =============================================================================
//
// KNV_DIR_UP    = 0
// KNV_DIR_DOWN  = 1
// KNV_DIR_LEFT  = 2
// KNV_DIR_RIGHT = 3
// KNV_DIR_MAX   = 3
//
// Within-panel arrow: up / left decrement widget focus with wrap;
// down / right increment with wrap. The mapping does NOT presume a
// 2D grid -- the panel-local widget order is whatever the layout
// registers, and the arrow is a directional hint the same walker
// implements as Tab / Shift+Tab. Refusal on dir > KNV_DIR_MAX keeps
// the input router honest.
//
// =============================================================================
// §3  SKIP-LINKS FOR PAGER PAGES
// =============================================================================
//
// The R41.M4 pager (semterm/pager.pdx) is the only panel that emits
// multiple pages of results. A screen reader / keyboard user on a
// long results page reaches a skip-link at the top and bottom of
// each page: knv_skip_link_next / knv_skip_link_prev drop the
// widget focus to 0 (start-of-page) and bump the skip_hits counter
// so a diagnostic ring can prove the skip-link fires at least once
// per page traversal. Panel focus is unchanged -- skip-link is
// intra-panel, not cross-panel.
//
// =============================================================================
// §4  FOCUS-RING VISIBILITY
// =============================================================================
//
// ring_visible starts at 0. A first keyboard-nav event (any of Tab /
// F6 / arrow / skip-link) does NOT auto-show the ring -- the caller
// is expected to route knv_ring_show(1) when it detects the user
// touched the keyboard for navigation (mouse users get no ring). The
// ring flag is a hint the Vello backend reads, not a mode this
// module enforces on itself.
//
// =============================================================================
// §5  ONE WRITER OF THE STATE
// =============================================================================
//
// _knv_state and _knv_widgets are written only by helpers in this
// module. tools/build.sh confines relocations against each to
// `core/semterm/gui_kbdnav.o`.
//
// STATE LAYOUT -- _knv_state : [u64; 8]
//   +0    init_mark        0x77AB once knv_reset has run
//   +8    err              sticky error latch (first-writer-wins)
//   +16   focus_panel      0..KNV_PANEL_MAX-1
//   +24   focus_widget     0..widgets_per_panel[focus_panel]-1
//   +32   ring_visible     0 | 1
//   +40   panel_bumps      running total across next/prev_panel
//   +48   widget_bumps     running total across next/prev_widget + arrow
//   +56   skip_hits        running total across skip_link_next/_prev
//
// WIDGETS LAYOUT -- _knv_widgets : [u64; 4]
//   _knv_widgets[i] = widgets_per_panel for panel i (>= 1 after reset).
//
// =============================================================================
// §6  FAILURE TAXONOMY 0xFFFFEE50..0xFFFFEE5F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time. Adjacent used
// band above: gui_a11y 0xFFFFEE60..6F (this milestone). Adjacent
// free band below: 0xFFFFEE40..4F (unassigned).
//
//   KNV_OK             = 0
//   KNV_ERR_NOT_INIT   = 0xFFFFEE5F   accessor before knv_reset
//   KNV_ERR_BAD_PANEL  = 0xFFFFEE5E   panel_id >= KNV_PANEL_MAX
//   KNV_ERR_BAD_COUNT  = 0xFFFFEE5D   widgets_set count == 0
//   KNV_ERR_BAD_DIR    = 0xFFFFEE5C   arrow dir > KNV_DIR_MAX
//   KNV_ERR_INTERNAL   = 0xFFFFEE5B   unreachable-fallthrough tripwire
//
// =============================================================================
// §7  ARITY DISCIPLINE
// =============================================================================
//
// knv_widgets_set is (panel_id, count). knv_widgets_get is
// (panel_id). knv_ring_show is (flag). knv_arrow is (dir).
// knv_next_widget / knv_prev_widget / knv_next_panel /
// knv_prev_panel / knv_skip_link_next / knv_skip_link_prev are ().
// Every readback is (). A widening (a chorded shortcut, a per-panel
// focus-trap flag, an accelerator ring) is a widening of these
// arities and tools/build.sh pins the signatures.

module GuiKbdnav = structure {

  // Panel count (§1).
  pub let KNV_PANEL_MAX : u64 = 4

  // Arrow directions (§2).
  pub let KNV_DIR_UP    : u64 = 0
  pub let KNV_DIR_DOWN  : u64 = 1
  pub let KNV_DIR_LEFT  : u64 = 2
  pub let KNV_DIR_RIGHT : u64 = 3
  pub let KNV_DIR_MAX   : u64 = 3

  // Failure taxonomy (§6).
  pub let KNV_OK             : u64 = 0
  pub let KNV_ERR_NOT_INIT   : u64 = 0xFFFFEE5F
  pub let KNV_ERR_BAD_PANEL  : u64 = 0xFFFFEE5E
  pub let KNV_ERR_BAD_COUNT  : u64 = 0xFFFFEE5D
  pub let KNV_ERR_BAD_DIR    : u64 = 0xFFFFEE5C
  pub let KNV_ERR_INTERNAL   : u64 = 0xFFFFEE5B

  pub let KNV_INIT_MARK : u64 = 0x77AB

  pub let mut _knv_state   : [u64; 8] = uninit @align(64)
  pub let mut _knv_widgets : [u64; 4] = uninit @align(64)

  // ==========================================================================
  // Reset. Boot + teardown. Installs widgets_per_panel[*] = 1.
  // ==========================================================================

  pub let knv_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M3-003 (#1408): clear state, install init_mark + widgets_per_panel[*]=1. Labels prefixed knv_rst_.",
      block: {
        lea r10, [rip + _knv_state];
        xor rax, rax;
        xor rcx, rcx;
      knv_rst_st:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  knv_rst_st;

        mov rax, 0x77AB;
        mov [r10 + 0], rax;                      // init_mark

        // widgets_per_panel[i] = 1 for i in 0..4.
        lea r10, [rip + _knv_widgets];
        mov rax, 1;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        ret
      }
    }

  pub let knv_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R44.M3-003 (#1408): honesty pin. Returns 0 until a live G10 input router pumps keys into knv_next_widget / knv_next_panel / knv_arrow.",
      block: {
        xor rax, rax;
        ret
      }
    }

  pub let knv_err : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M3-003 (#1408): sticky error latch readback.",
      block: {
        lea r10, [rip + _knv_state];
        mov rax, [r10 + 8];
        ret
      }
    }

  pub let knv_bound : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M3-003 (#1408): 1 iff init_mark matches. Labels prefixed knv_bnd_.",
      block: {
        lea r10, [rip + _knv_state];
        mov rax, [r10 + 0];
        mov r11, 0x77AB;
        cmp rax, r11;
        jne knv_bnd_no;
        mov rax, 1;
        ret;
      knv_bnd_no:
        xor rax, rax;
        ret
      }
    }

  pub let knv_set_err : (u64) -> () !{mem} @{} =
    fn (code: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M3-003 (#1408): first-writer-wins error latch. Labels prefixed knv_se_.",
      block: {
        lea r10, [rip + _knv_state];
        mov rax, [r10 + 8];
        cmp rax, 0;
        jne knv_se_out;
        mov [r10 + 8], rdi;
      knv_se_out:
        ret
      }
    }

  // ==========================================================================
  // Readbacks.
  // ==========================================================================

  pub let knv_focus_panel : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M3-003 (#1408): focus_panel field.",
      block: {
        lea r10, [rip + _knv_state];
        mov rax, [r10 + 16];
        ret
      }
    }

  pub let knv_focus_widget : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M3-003 (#1408): focus_widget field.",
      block: {
        lea r10, [rip + _knv_state];
        mov rax, [r10 + 24];
        ret
      }
    }

  pub let knv_ring_visible : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M3-003 (#1408): ring_visible field.",
      block: {
        lea r10, [rip + _knv_state];
        mov rax, [r10 + 32];
        ret
      }
    }

  pub let knv_panel_bumps : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M3-003 (#1408): panel_bumps running total.",
      block: {
        lea r10, [rip + _knv_state];
        mov rax, [r10 + 40];
        ret
      }
    }

  pub let knv_widget_bumps : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M3-003 (#1408): widget_bumps running total.",
      block: {
        lea r10, [rip + _knv_state];
        mov rax, [r10 + 48];
        ret
      }
    }

  pub let knv_skip_hits : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M3-003 (#1408): skip_hits running total.",
      block: {
        lea r10, [rip + _knv_state];
        mov rax, [r10 + 56];
        ret
      }
    }

  // ==========================================================================
  // knv_widgets_get(panel_id) -> u64
  //
  // Read widgets_per_panel[panel_id]. Refuses panel_id >= KNV_PANEL_MAX
  // (accessor style: no init check; a caller against a not-init
  // module reads the zero the reset fill leaves behind for the widget
  // slot at panel_id == 0..3, which we backfill with 1 at reset time).
  // ==========================================================================

  pub let knv_widgets_get : (u64) -> u64 !{mem} @{} =
    fn (panel_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M3-003 (#1408): read widgets_per_panel[panel_id]. Labels prefixed knv_wg_.",
      block: {
        cmp rdi, 4;
        jae knv_wg_bp;

        lea r10, [rip + _knv_widgets];
        mov rax, [r10 + rdi * 8];
        ret;

      knv_wg_bp:
        mov rdi, 0xFFFFEE5E;
        call knv_set_err;
        mov rax, 0xFFFFEE5E;             // surface the taxonomy code to
                                         // the caller (matches every
                                         // other refusal in this module)
        ret
      }
    }

  // ==========================================================================
  // knv_widgets_set(panel_id, count) -> u64
  //
  // Park a positive widget count. Refuses not init, bad panel_id, or
  // count == 0. Does NOT clamp focus_widget -- caller re-issues
  // knv_next_widget / knv_prev_widget to reintegrate.
  // ==========================================================================

  pub let knv_widgets_set : (u64, u64) -> u64 !{mem} @{} =
    fn (panel_id: u64, count: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M3-003 (#1408): park widgets_per_panel[panel_id]. Labels prefixed knv_ws_.",
      block: {
        lea r10, [rip + _knv_state];
        mov rax, [r10 + 0];
        mov r11, 0x77AB;
        cmp rax, r11;
        jne knv_ws_ni;

        cmp rdi, 4;
        jae knv_ws_bp;

        cmp rsi, 0;
        je  knv_ws_bc;

        lea r10, [rip + _knv_widgets];
        mov [r10 + rdi * 8], rsi;

        xor rax, rax;
        ret;

      knv_ws_ni:
        mov rdi, 0xFFFFEE5F;
        call knv_set_err;
        mov rax, 0xFFFFEE5F;
        ret;
      knv_ws_bp:
        mov rdi, 0xFFFFEE5E;
        call knv_set_err;
        mov rax, 0xFFFFEE5E;
        ret;
      knv_ws_bc:
        mov rdi, 0xFFFFEE5D;
        call knv_set_err;
        mov rax, 0xFFFFEE5D;
        ret
      }
    }

  // ==========================================================================
  // knv_ring_show(flag) -> u64
  //
  // Coerce flag to 0/1 and store into ring_visible. Refuses not init.
  // ==========================================================================

  pub let knv_ring_show : (u64) -> u64 !{mem} @{} =
    fn (flag: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M3-003 (#1408): store 0/1 into ring_visible. Labels prefixed knv_rs_.",
      block: {
        lea r10, [rip + _knv_state];
        mov rax, [r10 + 0];
        mov r11, 0x77AB;
        cmp rax, r11;
        jne knv_rs_ni;

        cmp rdi, 0;
        je  knv_rs_st;
        mov rdi, 1;
      knv_rs_st:
        mov [r10 + 32], rdi;
        xor rax, rax;
        ret;

      knv_rs_ni:
        mov rdi, 0xFFFFEE5F;
        call knv_set_err;
        mov rax, 0xFFFFEE5F;
        ret
      }
    }

  // ==========================================================================
  // knv_next_widget() / knv_prev_widget()
  //
  // Cycle focus_widget within widgets_per_panel[focus_panel]. Modular
  // wrap. Bumps widget_bumps. Refuses not init.
  // ==========================================================================

  pub let knv_next_widget : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M3-003 (#1408): focus_widget = (focus_widget + 1) mod widgets_per_panel[focus_panel]. Labels prefixed knv_nw_.",
      block: {
        lea r10, [rip + _knv_state];
        mov rax, [r10 + 0];
        mov r11, 0x77AB;
        cmp rax, r11;
        jne knv_nw_ni;

        // widgets_per_panel[focus_panel].
        mov rcx, [r10 + 16];                     // focus_panel
        lea r11, [rip + _knv_widgets];
        mov r9, [r11 + rcx * 8];                 // r9 = widget count

        // new = (focus_widget + 1) mod r9.
        mov rax, [r10 + 24];                     // focus_widget
        add rax, 1;
        xor rdx, rdx;
        div r9;                                  // rax = quo, rdx = rem
        mov [r10 + 24], rdx;                     // focus_widget = rem

        // widget_bumps += 1.
        mov rax, [r10 + 48];
        add rax, 1;
        mov [r10 + 48], rax;

        xor rax, rax;
        ret;

      knv_nw_ni:
        mov rdi, 0xFFFFEE5F;
        call knv_set_err;
        mov rax, 0xFFFFEE5F;
        ret
      }
    }

  pub let knv_prev_widget : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M3-003 (#1408): focus_widget = (focus_widget + count - 1) mod widgets_per_panel[focus_panel]. Labels prefixed knv_pw_.",
      block: {
        lea r10, [rip + _knv_state];
        mov rax, [r10 + 0];
        mov r11, 0x77AB;
        cmp rax, r11;
        jne knv_pw_ni;

        mov rcx, [r10 + 16];                     // focus_panel
        lea r11, [rip + _knv_widgets];
        mov r9, [r11 + rcx * 8];                 // r9 = widget count

        // new = (focus_widget + count - 1) mod r9.
        mov rax, [r10 + 24];                     // focus_widget
        add rax, r9;
        sub rax, 1;
        xor rdx, rdx;
        div r9;
        mov [r10 + 24], rdx;

        mov rax, [r10 + 48];
        add rax, 1;
        mov [r10 + 48], rax;

        xor rax, rax;
        ret;

      knv_pw_ni:
        mov rdi, 0xFFFFEE5F;
        call knv_set_err;
        mov rax, 0xFFFFEE5F;
        ret
      }
    }

  // ==========================================================================
  // knv_next_panel() / knv_prev_panel()
  //
  // Rotate focus_panel modulo KNV_PANEL_MAX and reset focus_widget to
  // 0. Bumps panel_bumps. Refuses not init.
  // ==========================================================================

  pub let knv_next_panel : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M3-003 (#1408): focus_panel = (focus_panel + 1) mod 4; focus_widget = 0. Labels prefixed knv_np_.",
      block: {
        lea r10, [rip + _knv_state];
        mov rax, [r10 + 0];
        mov r11, 0x77AB;
        cmp rax, r11;
        jne knv_np_ni;

        mov rax, [r10 + 16];                     // focus_panel
        add rax, 1;
        cmp rax, 4;
        jb  knv_np_ok;
        xor rax, rax;
      knv_np_ok:
        mov [r10 + 16], rax;
        xor rax, rax;
        mov [r10 + 24], rax;                     // focus_widget = 0

        mov rax, [r10 + 40];
        add rax, 1;
        mov [r10 + 40], rax;

        xor rax, rax;
        ret;

      knv_np_ni:
        mov rdi, 0xFFFFEE5F;
        call knv_set_err;
        mov rax, 0xFFFFEE5F;
        ret
      }
    }

  pub let knv_prev_panel : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M3-003 (#1408): focus_panel = (focus_panel + 3) mod 4; focus_widget = 0. Labels prefixed knv_pp_.",
      block: {
        lea r10, [rip + _knv_state];
        mov rax, [r10 + 0];
        mov r11, 0x77AB;
        cmp rax, r11;
        jne knv_pp_ni;

        mov rax, [r10 + 16];                     // focus_panel
        cmp rax, 0;
        jne knv_pp_dec;
        mov rax, 3;
        jmp knv_pp_st;
      knv_pp_dec:
        sub rax, 1;
      knv_pp_st:
        mov [r10 + 16], rax;
        xor rax, rax;
        mov [r10 + 24], rax;                     // focus_widget = 0

        mov rax, [r10 + 40];
        add rax, 1;
        mov [r10 + 40], rax;

        xor rax, rax;
        ret;

      knv_pp_ni:
        mov rdi, 0xFFFFEE5F;
        call knv_set_err;
        mov rax, 0xFFFFEE5F;
        ret
      }
    }

  // ==========================================================================
  // knv_arrow(dir) -> u64
  //
  // Within-panel arrow. Refuses not init or dir > KNV_DIR_MAX. up /
  // left decrement widget focus with wrap; down / right increment
  // with wrap. Bumps widget_bumps on success.
  // ==========================================================================

  pub let knv_arrow : (u64) -> u64 !{mem} @{} =
    fn (dir: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M3-003 (#1408): dispatch arrow to prev/next semantics. Labels prefixed knv_ar_.",
      block: {
        lea r10, [rip + _knv_state];
        mov rax, [r10 + 0];
        mov r11, 0x77AB;
        cmp rax, r11;
        jne knv_ar_ni;

        cmp rdi, 3;
        ja  knv_ar_bd;

        // up (0) or left (2) -> prev; down (1) or right (3) -> next.
        // Bit 0: 0 == prev (up/left), 1 == next (down/right).
        mov rcx, rdi;
        and rcx, 1;
        cmp rcx, 0;
        je  knv_ar_prev;

        // next.
        mov rcx, [r10 + 16];                     // focus_panel
        lea r11, [rip + _knv_widgets];
        mov r9, [r11 + rcx * 8];
        mov rax, [r10 + 24];
        add rax, 1;
        xor rdx, rdx;
        div r9;
        mov [r10 + 24], rdx;
        jmp knv_ar_ok;

      knv_ar_prev:
        mov rcx, [r10 + 16];
        lea r11, [rip + _knv_widgets];
        mov r9, [r11 + rcx * 8];
        mov rax, [r10 + 24];
        add rax, r9;
        sub rax, 1;
        xor rdx, rdx;
        div r9;
        mov [r10 + 24], rdx;

      knv_ar_ok:
        mov rax, [r10 + 48];
        add rax, 1;
        mov [r10 + 48], rax;

        xor rax, rax;
        ret;

      knv_ar_ni:
        mov rdi, 0xFFFFEE5F;
        call knv_set_err;
        mov rax, 0xFFFFEE5F;
        ret;
      knv_ar_bd:
        mov rdi, 0xFFFFEE5C;
        call knv_set_err;
        mov rax, 0xFFFFEE5C;
        ret
      }
    }

  // ==========================================================================
  // knv_skip_link_next() / knv_skip_link_prev()
  //
  // Reset focus_widget to 0 on the current panel and bump skip_hits.
  // Panel focus is unchanged. Refuses not init.
  // ==========================================================================

  pub let knv_skip_link_next : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M3-003 (#1408): forward skip-link -- widget = 0, bump skip_hits. Labels prefixed knv_sn_.",
      block: {
        lea r10, [rip + _knv_state];
        mov rax, [r10 + 0];
        mov r11, 0x77AB;
        cmp rax, r11;
        jne knv_sn_ni;

        xor rax, rax;
        mov [r10 + 24], rax;                     // focus_widget = 0

        mov rax, [r10 + 56];
        add rax, 1;
        mov [r10 + 56], rax;

        xor rax, rax;
        ret;

      knv_sn_ni:
        mov rdi, 0xFFFFEE5F;
        call knv_set_err;
        mov rax, 0xFFFFEE5F;
        ret
      }
    }

  pub let knv_skip_link_prev : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M3-003 (#1408): backward skip-link -- widget = 0, bump skip_hits. Labels prefixed knv_sp_.",
      block: {
        lea r10, [rip + _knv_state];
        mov rax, [r10 + 0];
        mov r11, 0x77AB;
        cmp rax, r11;
        jne knv_sp_ni;

        xor rax, rax;
        mov [r10 + 24], rax;                     // focus_widget = 0

        mov rax, [r10 + 56];
        add rax, 1;
        mov [r10 + 56], rax;

        xor rax, rax;
        ret;

      knv_sp_ni:
        mov rdi, 0xFFFFEE5F;
        call knv_set_err;
        mov rax, 0xFFFFEE5F;
        ret
      }
    }
}
