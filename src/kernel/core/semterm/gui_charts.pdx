// src/kernel/core/semterm/gui_charts.pdx -- R44.M2-002 (#1404)
//
// SEMTERM GUI CHART PRIMITIVES. Bar / line / scatter / heatmap chart
// records for the R44 GUI results region, drawn as Vello paths in a
// later widening. Charts carry a bounding rectangle, a kind ordinal,
// a wide-gamut color-series pool (indexed into the R41.M3 palette),
// and stroke attributes (AA on/off, cap style, join style) that the
// Vello backend consumes when it turns a chart record into a scene
// subgraph.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the CHART CATALOGUE + PATH RECORD. cha_reset clears state;
// cha_chart_new(kind, x0, y0, x1, y1) allocates a chart slot and
// returns its id (0-based); cha_series_add(chart_id, palette_series)
// binds one color series (0..7 into the palette's series lookup) to a
// chart and returns a series id; cha_aa_set / cha_cap_set /
// cha_join_set park the stroke attributes the Vello path emitter
// consumes; cha_emit_path(chart_id) bumps a per-chart path counter
// AND the global paths_emitted total, standing in for "a Vello path
// was assembled and queued" until the R44.M3+ backend hooks in.
//
// It does NOT draw. It does NOT own a scene graph, a Vello geometry
// buffer, or the transform matrix stack -- those live in libpaideia-ui
// (G12) once the real backend attaches. It does NOT resolve the RGB
// color of a series: cha_series_palette(series_id) returns the palette
// series ordinal, and a downstream renderer walks it through
// pal_series_color + pal_default_rgb (or pal_extended for wide-gamut
// beyond the 16-entry default). Keeping the palette dereference OUT
// of this module keeps cha_ independent of pal_'s init state -- so a
// chart record can be assembled before the palette is bound, and the
// pixel colors settle at emit time.
//
// It is a SCAFFOLD (D7): R44.M2 wires it into the witness tree but no
// live query or Vello backend consumes the chart records;
// cha_arbitrated() returns 0 until a later round hooks the resultset
// into cha_chart_new and the Vello path emitter into cha_emit_path.
//
// =============================================================================
// §1  CHART KIND + STROKE ATTRIBUTES
// =============================================================================
//
// CHA_KIND_BAR     = 0    filled rectangles per category
// CHA_KIND_LINE    = 1    polyline through data points
// CHA_KIND_SCATTER = 2    disc-per-point cloud
// CHA_KIND_HEATMAP = 3    color-mapped 2D grid
// CHA_KIND_MAX     = 3    largest valid tag
//
// Anti-aliasing:
//   CHA_AA_OFF = 0    pixel-aligned (fast; used at very small stroke widths)
//   CHA_AA_ON  = 1    default -- Vello's analytic edge AA
//
// Cap styles (line ends):
//   CHA_CAP_BUTT   = 0    flat cap at endpoint (default)
//   CHA_CAP_ROUND  = 1    semicircular
//   CHA_CAP_SQUARE = 2    projecting square
//   CHA_CAP_MAX    = 2
//
// Join styles (line-segment joins):
//   CHA_JOIN_MITER = 0    sharp corner (default)
//   CHA_JOIN_ROUND = 1    rounded corner
//   CHA_JOIN_BEVEL = 2    flattened corner
//   CHA_JOIN_MAX   = 2
//
// The stroke attributes are GLOBAL, not per-chart -- one AA/cap/join
// triple governs every chart in the frame. A widening to per-chart
// stroke is a widening of _cha_charts's row width and rewrites both
// the setter and the confinement in one place.
//
// =============================================================================
// §2  POOLS AND ID SPACES
// =============================================================================
//
// CHA_CHART_MAX  = 8      chart records
// CHA_SERIES_MAX = 16     series bindings (chart_id, palette_series)
//
// Both pools are bump allocators: chart_count grows via cha_chart_new;
// series_count grows via cha_series_add. Nothing releases; the whole
// pool is torn down by cha_reset. A widening (series eviction, chart
// destruction) is a widening of _cha_state's alloc cursors and
// rewrites the confinement in one place.
//
// Series indices span the ENTIRE series pool, not per-chart -- so
// series_id 5 has one meaning globally, and cha_series_chart(id)
// walks back to the owning chart. This shape matches the Vello scene
// graph, which numbers primitives globally per frame.
//
// =============================================================================
// §3  ONE WRITER OF THE STATE
// =============================================================================
//
// _cha_state, _cha_charts and _cha_series are written only by helpers
// in this module. tools/build.sh confines relocations against each to
// `core/semterm/gui_charts.o`.
//
// STATE LAYOUT -- _cha_state : [u64; 8]
//   +0    init_mark        0x7C20 once cha_reset has run
//   +8    err              sticky error latch
//   +16   chart_count      0..CHA_CHART_MAX
//   +24   series_count     0..CHA_SERIES_MAX
//   +32   aa_enabled       0 | 1 (starts at CHA_AA_ON)
//   +40   cap_style        CHA_CAP_BUTT default
//   +48   join_style       CHA_JOIN_MITER default
//   +56   paths_emitted    running total across cha_emit_path
//
// CHARTS LAYOUT -- _cha_charts : [u64; 8 * 6] = 48 words
//   chart(i) = _cha_charts[i * 6 .. i * 6 + 5]
//     +0  kind
//     +8  x0
//     +16 y0
//     +24 x1
//     +32 y1
//     +40 paths_local      per-chart emit counter
//
// SERIES LAYOUT -- _cha_series : [u64; 16 * 2] = 32 words
//   series(i) = _cha_series[i * 2 .. i * 2 + 1]
//     +0  chart_id
//     +8  palette_series   0..7 (index into pal_series_color)
//
// =============================================================================
// §4  FAILURE TAXONOMY 0xFFFFEE90..0xFFFFEE9F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time. Adjacent used
// band above: gui_vello 0xFFFFEEA0..AF (R44.M2-001). Adjacent free
// band below: gui_scroll 0xFFFFEE80..8F (R44.M2-003).
//
//   CHA_OK              = 0
//   CHA_ERR_NOT_INIT    = 0xFFFFEE9F   accessor before cha_reset
//   CHA_ERR_CHARTS_FULL = 0xFFFFEE9E   chart_new when pool exhausted
//   CHA_ERR_BAD_CHART   = 0xFFFFEE9D   chart_id >= chart_count
//   CHA_ERR_BAD_KIND    = 0xFFFFEE9C   kind > CHA_KIND_MAX
//   CHA_ERR_SERIES_FULL = 0xFFFFEE9B   series_add when pool exhausted
//   CHA_ERR_BAD_SERIES  = 0xFFFFEE9A   series_id >= series_count OR
//                                       palette_series > 7 at add-time
//   CHA_ERR_BAD_RECT    = 0xFFFFEE99   x0 >= x1 or y0 >= y1
//   CHA_ERR_BAD_CAP     = 0xFFFFEE98   cap style > CHA_CAP_MAX
//   CHA_ERR_BAD_JOIN    = 0xFFFFEE97   join style > CHA_JOIN_MAX
//   CHA_ERR_INTERNAL    = 0xFFFFEE96   unreachable-fallthrough tripwire
//
// =============================================================================
// §5  ARITY DISCIPLINE
// =============================================================================
//
// cha_chart_new is (kind, x0, y0, x1, y1). cha_series_add is
// (chart_id, palette_series). cha_aa_set is (flag). cha_cap_set is
// (style). cha_join_set is (style). cha_emit_path is (chart_id).
// Every readback is (). A widening (per-chart stroke, per-series
// alpha) is a widening of these arities and tools/build.sh pins the
// signatures.

module GuiCharts = structure {

  // Pool sizes (§2).
  pub let CHA_CHART_MAX  : u64 = 8
  pub let CHA_SERIES_MAX : u64 = 16

  // Chart kinds (§1).
  pub let CHA_KIND_BAR     : u64 = 0
  pub let CHA_KIND_LINE    : u64 = 1
  pub let CHA_KIND_SCATTER : u64 = 2
  pub let CHA_KIND_HEATMAP : u64 = 3
  pub let CHA_KIND_MAX     : u64 = 3

  // AA (§1).
  pub let CHA_AA_OFF : u64 = 0
  pub let CHA_AA_ON  : u64 = 1

  // Cap styles (§1).
  pub let CHA_CAP_BUTT   : u64 = 0
  pub let CHA_CAP_ROUND  : u64 = 1
  pub let CHA_CAP_SQUARE : u64 = 2
  pub let CHA_CAP_MAX    : u64 = 2

  // Join styles (§1).
  pub let CHA_JOIN_MITER : u64 = 0
  pub let CHA_JOIN_ROUND : u64 = 1
  pub let CHA_JOIN_BEVEL : u64 = 2
  pub let CHA_JOIN_MAX   : u64 = 2

  // Failure taxonomy (§4).
  pub let CHA_OK              : u64 = 0
  pub let CHA_ERR_NOT_INIT    : u64 = 0xFFFFEE9F
  pub let CHA_ERR_CHARTS_FULL : u64 = 0xFFFFEE9E
  pub let CHA_ERR_BAD_CHART   : u64 = 0xFFFFEE9D
  pub let CHA_ERR_BAD_KIND    : u64 = 0xFFFFEE9C
  pub let CHA_ERR_SERIES_FULL : u64 = 0xFFFFEE9B
  pub let CHA_ERR_BAD_SERIES  : u64 = 0xFFFFEE9A
  pub let CHA_ERR_BAD_RECT    : u64 = 0xFFFFEE99
  pub let CHA_ERR_BAD_CAP     : u64 = 0xFFFFEE98
  pub let CHA_ERR_BAD_JOIN    : u64 = 0xFFFFEE97
  pub let CHA_ERR_INTERNAL    : u64 = 0xFFFFEE96

  pub let CHA_INIT_MARK : u64 = 0x7C20

  pub let mut _cha_state  : [u64; 8]  = uninit @align(64)
  pub let mut _cha_charts : [u64; 48] = uninit @align(64)
  pub let mut _cha_series : [u64; 32] = uninit @align(64)

  // ==========================================================================
  // Reset. Boot + teardown. Installs AA_ON + CAP_BUTT + JOIN_MITER
  // defaults.
  // ==========================================================================

  pub let cha_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M2-002 (#1404): clear state + charts + series, install init_mark + AA_ON + CAP_BUTT + JOIN_MITER defaults. Labels prefixed cha_rst_.",
      block: {
        lea r10, [rip + _cha_series];
        xor rax, rax;
        xor rcx, rcx;
      cha_rst_sr:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  cha_rst_sr;

        lea r10, [rip + _cha_charts];
        xor rcx, rcx;
      cha_rst_ch:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 48;
        jb  cha_rst_ch;

        lea r10, [rip + _cha_state];
        xor rcx, rcx;
      cha_rst_st:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  cha_rst_st;

        mov rax, 0x7C20;
        mov [r10 + 0], rax;                     // init_mark
        mov rax, 1;
        mov [r10 + 32], rax;                    // aa_enabled = CHA_AA_ON
        // cap_style, join_style already 0 (BUTT / MITER)
        ret
      }
    }

  pub let cha_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R44.M2-002 (#1404): honesty pin. Returns 0 until a live resultset feeds cha_chart_new and a live Vello emitter drives cha_emit_path.",
      block: {
        xor rax, rax;
        ret
      }
    }

  pub let cha_err : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M2-002 (#1404): sticky error latch readback.",
      block: {
        lea r10, [rip + _cha_state];
        mov rax, [r10 + 8];
        ret
      }
    }

  pub let cha_bound : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M2-002 (#1404): 1 iff init_mark matches. Labels prefixed cha_bnd_.",
      block: {
        lea r10, [rip + _cha_state];
        mov rax, [r10 + 0];
        mov r11, 0x7C20;
        cmp rax, r11;
        jne cha_bnd_no;
        mov rax, 1;
        ret;
      cha_bnd_no:
        xor rax, rax;
        ret
      }
    }

  pub let cha_set_err : (u64) -> () !{mem} @{} =
    fn (code: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M2-002 (#1404): first-writer-wins error latch. Labels prefixed cha_se_.",
      block: {
        lea r10, [rip + _cha_state];
        mov rax, [r10 + 8];
        cmp rax, 0;
        jne cha_se_out;
        mov [r10 + 8], rdi;
      cha_se_out:
        ret
      }
    }

  // ==========================================================================
  // cha_reset_err — clear the sticky err latch WITHOUT touching chart
  // or series pools, stroke state, or counters. Used by witnesses that
  // assert a specific latched code across a stage boundary; the
  // first-writer-wins latch must be cleared between stages that both
  // intentionally trigger a refusal path or the second stage sees the
  // first stage's code.
  // ==========================================================================

  pub let cha_reset_err : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M2-002 (#1404): clear err latch; preserve charts + series + stroke + counters. Labels prefixed cha_re_.",
      block: {
        lea r10, [rip + _cha_state];
        xor rax, rax;
        mov [r10 + 8], rax;
        ret
      }
    }

  // ==========================================================================
  // Readbacks.
  // ==========================================================================

  pub let cha_chart_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M2-002 (#1404): chart_count field.",
      block: {
        lea r10, [rip + _cha_state];
        mov rax, [r10 + 16];
        ret
      }
    }

  pub let cha_series_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M2-002 (#1404): series_count field.",
      block: {
        lea r10, [rip + _cha_state];
        mov rax, [r10 + 24];
        ret
      }
    }

  pub let cha_aa_get : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M2-002 (#1404): aa_enabled field.",
      block: {
        lea r10, [rip + _cha_state];
        mov rax, [r10 + 32];
        ret
      }
    }

  pub let cha_cap_get : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M2-002 (#1404): cap_style field.",
      block: {
        lea r10, [rip + _cha_state];
        mov rax, [r10 + 40];
        ret
      }
    }

  pub let cha_join_get : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M2-002 (#1404): join_style field.",
      block: {
        lea r10, [rip + _cha_state];
        mov rax, [r10 + 48];
        ret
      }
    }

  pub let cha_paths_emitted : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M2-002 (#1404): paths_emitted running total.",
      block: {
        lea r10, [rip + _cha_state];
        mov rax, [r10 + 56];
        ret
      }
    }

  // ==========================================================================
  // cha_chart_field(chart_id, field) -> u64
  //
  // field: 0=kind, 1=x0, 2=y0, 3=x1, 4=y1, 5=paths_local.
  // Refuses chart_id >= chart_count OR field > 5.
  // ==========================================================================

  pub let cha_chart_field : (u64, u64) -> u64 !{mem} @{} =
    fn (chart_id: u64, field: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M2-002 (#1404): read one field of one chart. Labels prefixed cha_cf_.",
      block: {
        lea r10, [rip + _cha_state];
        mov rax, [r10 + 16];                     // chart_count
        cmp rdi, rax;
        jae cha_cf_bc;
        cmp rsi, 5;
        ja  cha_cf_bf;

        mov rax, rdi;
        mov r11, 6;
        imul rax, r11;                                // rax = chart_id * 6
        add rax, rsi;
        lea r10, [rip + _cha_charts];
        mov rax, [r10 + rax * 8];
        ret;

      cha_cf_bc:
        mov rdi, 0xFFFFEE9D;
        call cha_set_err;
        xor rax, rax;
        ret;
      cha_cf_bf:
        mov rdi, 0xFFFFEE96;
        call cha_set_err;
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // cha_chart_new(kind, x0, y0, x1, y1) -> u64
  //
  // Allocate a chart and return its id. Refuses not init, charts full,
  // bad kind, bad rectangle. 6th arg on stack per SysV.
  // ==========================================================================

  pub let cha_chart_new : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (kind: u64, x0: u64, y0: u64, x1: u64, y1: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M2-002 (#1404): allocate a chart record. Args: kind=rdi, x0=rsi, y0=rdx, x1=rcx, y1=r8. Labels prefixed cha_cn_.",
      block: {
        lea r10, [rip + _cha_state];
        mov rax, [r10 + 0];
        mov r11, 0x7C20;
        cmp rax, r11;
        jne cha_cn_ni;

        cmp rdi, 3;
        ja  cha_cn_bk;

        mov rax, [r10 + 16];                     // chart_count
        cmp rax, 8;
        jae cha_cn_cf;

        // Rectangle sanity: x0 < x1 AND y0 < y1.
        cmp rsi, rcx;
        jae cha_cn_br;
        cmp rdx, r8;
        jae cha_cn_br;

        // Store new chart at chart_count.
        mov r11, 6;
        mov r9, rax;                             // save chart_id
        imul rax, r11;                                // rax = chart_id * 6
        lea r14, [rip + _cha_charts];
        lea r14, [r14 + rax * 8];                // r14 = &charts[chart_id]

        mov [r14 + 0],  rdi;                     // kind
        mov [r14 + 8],  rsi;                     // x0
        mov [r14 + 16], rdx;                     // y0
        mov [r14 + 24], rcx;                     // x1
        mov [r14 + 32], r8;                      // y1
        xor rax, rax;
        mov [r14 + 40], rax;                     // paths_local = 0

        // Bump chart_count.
        mov rax, r9;
        add rax, 1;
        mov [r10 + 16], rax;

        mov rax, r9;                             // return old chart_count as id
        ret;

      cha_cn_ni:
        mov rdi, 0xFFFFEE9F;
        call cha_set_err;
        mov rax, 0xFFFFEE9F;
        ret;
      cha_cn_bk:
        mov rdi, 0xFFFFEE9C;
        call cha_set_err;
        mov rax, 0xFFFFEE9C;
        ret;
      cha_cn_cf:
        mov rdi, 0xFFFFEE9E;
        call cha_set_err;
        mov rax, 0xFFFFEE9E;
        ret;
      cha_cn_br:
        mov rdi, 0xFFFFEE99;
        call cha_set_err;
        mov rax, 0xFFFFEE99;
        ret
      }
    }

  // ==========================================================================
  // cha_series_add(chart_id, palette_series) -> u64
  //
  // Bind one palette series (0..7) to one chart. Returns the new
  // series id. Refuses not init, bad chart, bad series (palette_series
  // > 7), or series pool full.
  // ==========================================================================

  pub let cha_series_add : (u64, u64) -> u64 !{mem} @{} =
    fn (chart_id: u64, palette_series: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M2-002 (#1404): bind palette series to chart. Labels prefixed cha_sa_.",
      block: {
        lea r10, [rip + _cha_state];
        mov rax, [r10 + 0];
        mov r11, 0x7C20;
        cmp rax, r11;
        jne cha_sa_ni;

        mov rax, [r10 + 16];                     // chart_count
        cmp rdi, rax;
        jae cha_sa_bc;

        cmp rsi, 7;
        ja  cha_sa_bs;

        mov rax, [r10 + 24];                     // series_count
        cmp rax, 16;
        jae cha_sa_sf;

        // Store series at series_count.
        mov r11, 2;
        mov r9, rax;                             // save series_id
        imul rax, r11;                                // rax = series_id * 2
        lea r14, [rip + _cha_series];
        lea r14, [r14 + rax * 8];                // r14 = &series[series_id]

        mov [r14 + 0], rdi;                      // chart_id
        mov [r14 + 8], rsi;                      // palette_series

        // Bump series_count.
        mov rax, r9;
        add rax, 1;
        mov [r10 + 24], rax;

        mov rax, r9;                             // return old series_count as id
        ret;

      cha_sa_ni:
        mov rdi, 0xFFFFEE9F;
        call cha_set_err;
        mov rax, 0xFFFFEE9F;
        ret;
      cha_sa_bc:
        mov rdi, 0xFFFFEE9D;
        call cha_set_err;
        mov rax, 0xFFFFEE9D;
        ret;
      cha_sa_bs:
        mov rdi, 0xFFFFEE9A;
        call cha_set_err;
        mov rax, 0xFFFFEE9A;
        ret;
      cha_sa_sf:
        mov rdi, 0xFFFFEE9B;
        call cha_set_err;
        mov rax, 0xFFFFEE9B;
        ret
      }
    }

  // ==========================================================================
  // cha_series_chart(series_id) -> u64
  // cha_series_palette(series_id) -> u64
  //
  // Read the chart_id / palette_series ordinal of one series. Refuses
  // series_id >= series_count with CHA_ERR_BAD_SERIES.
  // ==========================================================================

  pub let cha_series_chart : (u64) -> u64 !{mem} @{} =
    fn (series_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M2-002 (#1404): read chart_id of one series. Labels prefixed cha_sc_.",
      block: {
        lea r10, [rip + _cha_state];
        mov rax, [r10 + 24];                     // series_count
        cmp rdi, rax;
        jae cha_sc_bs;

        mov rax, rdi;
        shl rax, 1;                              // rax = id * 2 words
        lea r10, [rip + _cha_series];
        mov rax, [r10 + rax * 8];
        ret;

      cha_sc_bs:
        mov rdi, 0xFFFFEE9A;
        call cha_set_err;
        xor rax, rax;
        ret
      }
    }

  pub let cha_series_palette : (u64) -> u64 !{mem} @{} =
    fn (series_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M2-002 (#1404): read palette_series ordinal of one series. Labels prefixed cha_sp_.",
      block: {
        lea r10, [rip + _cha_state];
        mov rax, [r10 + 24];                     // series_count
        cmp rdi, rax;
        jae cha_sp_bs;

        mov rax, rdi;
        shl rax, 1;
        add rax, 1;                              // palette_series field at +8 = +1 word
        lea r10, [rip + _cha_series];
        mov rax, [r10 + rax * 8];
        ret;

      cha_sp_bs:
        mov rdi, 0xFFFFEE9A;
        call cha_set_err;
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Stroke setters. Each refuses not init or a bad value.
  // ==========================================================================

  pub let cha_aa_set : (u64) -> u64 !{mem} @{} =
    fn (flag: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M2-002 (#1404): store aa_enabled after 0/1 coercion. Labels prefixed cha_as_.",
      block: {
        lea r10, [rip + _cha_state];
        mov rax, [r10 + 0];
        mov r11, 0x7C20;
        cmp rax, r11;
        jne cha_as_ni;

        cmp rdi, 0;
        je  cha_as_store;
        mov rdi, 1;
      cha_as_store:
        mov [r10 + 32], rdi;
        xor rax, rax;
        ret;

      cha_as_ni:
        mov rdi, 0xFFFFEE9F;
        call cha_set_err;
        mov rax, 0xFFFFEE9F;
        ret
      }
    }

  pub let cha_cap_set : (u64) -> u64 !{mem} @{} =
    fn (style: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M2-002 (#1404): store cap_style after enum check. Labels prefixed cha_cs_.",
      block: {
        lea r10, [rip + _cha_state];
        mov rax, [r10 + 0];
        mov r11, 0x7C20;
        cmp rax, r11;
        jne cha_cs_ni;

        cmp rdi, 2;
        ja  cha_cs_bs;

        mov [r10 + 40], rdi;
        xor rax, rax;
        ret;

      cha_cs_ni:
        mov rdi, 0xFFFFEE9F;
        call cha_set_err;
        mov rax, 0xFFFFEE9F;
        ret;
      cha_cs_bs:
        mov rdi, 0xFFFFEE98;
        call cha_set_err;
        mov rax, 0xFFFFEE98;
        ret
      }
    }

  pub let cha_join_set : (u64) -> u64 !{mem} @{} =
