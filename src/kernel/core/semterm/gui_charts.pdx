  // ==========================================================================
  // cha_emit_path(chart_id) -> u64
  //
  // Bump the per-chart paths_local counter AND the global paths_emitted
  // counter. Refuses not init or bad chart.
  // ==========================================================================

  pub let cha_emit_path : (u64) -> u64 !{mem} @{} =
    fn (chart_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M2-002 (#1404): bump per-chart + global path counters. Labels prefixed cha_ep_.",
      block: {
        lea r10, [rip + _cha_state];
        mov rax, [r10 + 0];
        mov r11, 0x7C20;
        cmp rax, r11;
        jne cha_ep_ni;

        mov rax, [r10 + 16];                     // chart_count
        cmp rdi, rax;
        jae cha_ep_bc;

        // Per-chart paths_local at chart_id * 6 + 5.
        mov rax, rdi;
        mov r11, 6;
        imul rax, r11;
        add rax, 5;                              // paths_local field
        lea r14, [rip + _cha_charts];
        mov rcx, [r14 + rax * 8];
        add rcx, 1;
        mov [r14 + rax * 8], rcx;

        // Global paths_emitted at state+56.
        mov rax, [r10 + 56];
        add rax, 1;
        mov [r10 + 56], rax;

        xor rax, rax;
        ret;

      cha_ep_ni:
        mov rdi, 0xFFFFEE9F;
        call cha_set_err;
        mov rax, 0xFFFFEE9F;
        ret;
      cha_ep_bc:
        mov rdi, 0xFFFFEE9D;
        call cha_set_err;
        mov rax, 0xFFFFEE9D;
        ret
      }
    }
}
