// src/kernel/core/semterm/line_editor.pdx -- R41.M4-002 (#1375)
//
// SEMTERM LINE EDITOR. Readline-analog input line for the semantic
// terminal: an insertion buffer with a cursor the caller moves left,
// right, home, and end across, backspace and delete against the
// cursor position, a kill/yank register, a 32-slot history browsed
// with up/down, and a completion hook the frontend calls to walk
// through candidate completions at the cursor.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the LINE-EDIT STATE MACHINE the semantic terminal's frontend
// feeds one key event at a time. led_reset boots empty; led_insert(ch)
// writes one printable ASCII byte at the cursor and advances the
// cursor; led_backspace removes the byte to the left of the cursor
// and shifts the tail; led_delete removes the byte at the cursor;
// led_left / led_right / led_home / led_end move the cursor without
// touching the buffer; led_kill_line saves the (cursor..end) suffix
// into a kill register and truncates the line at the cursor;
// led_yank inserts the kill register at the cursor; led_history_push
// stores the current line as a history entry; led_history_up /
// led_history_down browse the history into the buffer; led_complete_
// next asks the completion hook for the next candidate at the
// cursor.
//
// It does NOT allocate. It does NOT block on input; the frontend
// (semterm/fb_frontend.pdx) sources bytes and calls one edit primitive
// per key. It does NOT own a completion catalogue -- led_complete_next
// returns 0 in this scaffold so a widening that installs a catalogue
// is a widening of this arity, not a hidden global. It does NOT emit
// bytes; readback via led_get_at + led_buf_len is how a renderer
// walks the line.
//
// It is a SCAFFOLD (D7): R41.M4 wires it into the witness tree but no
// live terminal drives it; led_arbitrated() returns 0 until a later
// round hooks a real frontend into led_insert / led_left / ....
//
// =============================================================================
// §1  BUFFER + HISTORY + KILL GEOMETRY
// =============================================================================
//
// Insertion buffer -- one byte per u64 slot for uniform addressing:
//   _led_buf : [u64; 128]
//   buf_len is the live byte count (0..128); cursor is 0..buf_len.
//
// Kill register:
//   _led_kill : [u64; 128]
//   kill_len is 0..128; led_yank inserts kill_len bytes at cursor.
//   The register is REPLACED (not appended) by each led_kill_line.
//
// History ring:
//   _led_hist : [u64; 4096]   (= 32 entries * 128 bytes)
//   hist_count is the number of live entries (0..32); once full,
//   led_history_push refuses with LED_ERR_HIST_FULL so a caller must
//   drop entries deliberately rather than silently overwriting the
//   oldest. Each entry stores its length as the first slot's high
//   byte the caller reads via led_hist_len(idx).
//
// Actually simpler: the history stores raw bytes and a separate
// length array:
//   _led_hist_lens : [u64; 32]
//
// led_history_up copies the most recent entry into _led_buf; a
// subsequent led_history_up walks older entries. hist_cursor tracks
// the walk; it is bumped past the tail once every entry has been
// shown, at which point led_history_up refuses with
// LED_ERR_HIST_EMPTY.
//
// =============================================================================
// §2  CHARACTER RANGE
// =============================================================================
//
// led_insert accepts printable ASCII in [0x20, 0x7E]. Control bytes
// (BS, DEL, arrows, ...) reach the editor through their own
// primitives -- led_backspace, led_delete, led_left, led_right, ... --
// so a caller cannot smuggle an unprinted byte through led_insert.
// A byte outside the printable range is refused with LED_ERR_BAD_CH.
// A widening (Unicode, control-graphic characters) is a widening of
// this range, and the refusal keeps the widening deliberate.
//
// =============================================================================
// §3  ONE WRITER OF THE STATE
// =============================================================================
//
// _led_buf, _led_kill, _led_hist, _led_hist_lens, and _led_state are
// written only by helpers in this module. tools/build.sh confines
// relocations against each to `core/semterm/line_editor.o`.
//
// STATE LAYOUT -- _led_state : [u64; 8]
//   +0    init_mark    0x1EE0 once led_reset has run
//   +8    err          sticky error latch (first-writer-wins)
//   +16   buf_len      0..128
//   +24   cursor       0..buf_len
//   +32   hist_count   0..32
//   +40   hist_cursor  0..hist_count (walk pointer for up/down)
//   +48   kill_len     0..128
//   +56   reserved
//
// =============================================================================
// §4  FAILURE TAXONOMY 0xFFFFF040..0xFFFFF04F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time. Adjacent used
// band above: fb_frontend 0xFFFFF050..5F (R41.M4-001). Adjacent free
// band below: pager 0xFFFFF030..3F (R41.M4-003).
//
//   LED_OK              = 0
//   LED_ERR_NOT_INIT    = 0xFFFFF04F   accessor before led_reset
//   LED_ERR_BAD_POS     = 0xFFFFF04E   move past 0 or buf_len
//   LED_ERR_BUF_FULL    = 0xFFFFF04D   insert or yank past 128 bytes
//   LED_ERR_BUF_EMPTY   = 0xFFFFF04C   backspace at 0 or delete past end
//   LED_ERR_HIST_EMPTY  = 0xFFFFF04B   up/down past the walk boundary
//   LED_ERR_HIST_FULL   = 0xFFFFF04A   push into a full 32-slot history
//   LED_ERR_BAD_CH      = 0xFFFFF049   led_insert with non-printable byte
//   LED_ERR_INTERNAL    = 0xFFFFF048   unreachable-fallthrough tripwire
//
// =============================================================================
// §5  ARITY DISCIPLINE
// =============================================================================
//
// led_insert is (ch) -- one byte per call. led_history_push is () --
// the entry always comes from the current line. led_get_at is (idx).
// A widening is a widening of these arities, and tools/build.sh pins
// the signatures.

module LineEditor = structure {

  // Buffer geometry (§1).
  pub let LED_BUF_MAX     : u64 = 128
  pub let LED_HIST_ENTRIES : u64 = 32
  pub let LED_HIST_WORDS  : u64 = 4096                // 32 * 128
  pub let LED_KILL_MAX    : u64 = 128

  // Character range (§2).
  pub let LED_CH_MIN : u64 = 0x20
  pub let LED_CH_MAX : u64 = 0x7E

  // Failure taxonomy (§4).
  pub let LED_OK             : u64 = 0
  pub let LED_ERR_NOT_INIT   : u64 = 0xFFFFF04F
  pub let LED_ERR_BAD_POS    : u64 = 0xFFFFF04E
  pub let LED_ERR_BUF_FULL   : u64 = 0xFFFFF04D
  pub let LED_ERR_BUF_EMPTY  : u64 = 0xFFFFF04C
  pub let LED_ERR_HIST_EMPTY : u64 = 0xFFFFF04B
  pub let LED_ERR_HIST_FULL  : u64 = 0xFFFFF04A
  pub let LED_ERR_BAD_CH     : u64 = 0xFFFFF049
  pub let LED_ERR_INTERNAL   : u64 = 0xFFFFF048

  pub let LED_INIT_MARK : u64 = 0x1EE0

  pub let mut _led_buf       : [u64; 128]  = uninit @align(64)
  pub let mut _led_kill      : [u64; 128]  = uninit @align(64)
  pub let mut _led_hist      : [u64; 4096] = uninit @align(64)
  pub let mut _led_hist_lens : [u64; 32]   = uninit @align(64)
  pub let mut _led_state     : [u64; 8]    = uninit @align(64)

  // ==========================================================================
  // Reset. Boot + teardown.
  // ==========================================================================

  pub let led_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M4-002 (#1375): clear buffer + kill + history + state, install init_mark. Labels prefixed led_rst_.",
      block: {
        // Clear _led_buf.
        lea r10, [rip + _led_buf];
        xor rax, rax;
        xor rcx, rcx;
      led_rst_b:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 128;
        jb  led_rst_b;

        // Clear _led_kill.
        lea r10, [rip + _led_kill];
        xor rcx, rcx;
      led_rst_k:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 128;
        jb  led_rst_k;

        // Clear _led_hist.
        lea r10, [rip + _led_hist];
        xor rcx, rcx;
      led_rst_h:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4096;
        jb  led_rst_h;

        // Clear _led_hist_lens.
        lea r10, [rip + _led_hist_lens];
        xor rcx, rcx;
      led_rst_hl:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  led_rst_hl;

        // Clear _led_state.
        lea r10, [rip + _led_state];
        xor rcx, rcx;
      led_rst_st:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  led_rst_st;

        mov rax, 0x1EE0;
        mov [r10 + 0], rax;                      // init_mark
        ret
      }
    } @no_frame

  pub let led_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R41.M4-002 (#1375): honesty pin. Returns 0 until a real terminal frontend drives one primitive per key.",
      block: {
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let led_err : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M4-002 (#1375): sticky error latch readback. Labels prefixed led_er_.",
      block: {
        lea r10, [rip + _led_state];
        mov rax, [r10 + 8];
        ret
      }
    } @no_frame

  pub let led_bound : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M4-002 (#1375): 1 iff init_mark matches. Labels prefixed led_bnd_.",
      block: {
        lea r10, [rip + _led_state];
        mov rax, [r10 + 0];
        mov r11, 0x1EE0;
        cmp rax, r11;
        jne led_bnd_no;
        mov rax, 1;
        ret;
      led_bnd_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let led_set_err : (u64) -> () !{mem} @{} =
    fn (code: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M4-002 (#1375): first-writer-wins error latch. Labels prefixed led_se_.",
      block: {
        lea r10, [rip + _led_state];
        mov rax, [r10 + 8];
        cmp rax, 0;
        jne led_se_out;
        mov [r10 + 8], rdi;
      led_se_out:
        ret
      }
    } @no_frame

  // ==========================================================================
  // Field readbacks.
  // ==========================================================================

  pub let led_buf_len : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M4-002 (#1375): buf_len readback.",
      block: {
        lea r10, [rip + _led_state];
        mov rax, [r10 + 16];
        ret
      }
    } @no_frame

  pub let led_cursor : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M4-002 (#1375): cursor readback.",
      block: {
        lea r10, [rip + _led_state];
        mov rax, [r10 + 24];
        ret
      }
    } @no_frame

  pub let led_hist_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M4-002 (#1375): hist_count readback.",
      block: {
        lea r10, [rip + _led_state];
        mov rax, [r10 + 32];
        ret
      }
    } @no_frame

  pub let led_kill_len : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M4-002 (#1375): kill_len readback.",
      block: {
        lea r10, [rip + _led_state];
        mov rax, [r10 + 48];
        ret
      }
    } @no_frame

  pub let led_get_at : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M4-002 (#1375): byte at buf[idx]. Refuses idx >= buf_len. Labels prefixed led_gt_.",
      block: {
        lea r10, [rip + _led_state];
        mov rax, [r10 + 0];
        mov r11, 0x1EE0;
        cmp rax, r11;
        jne led_gt_ni;

        mov r8, [r10 + 16];                      // buf_len
        cmp rdi, r8;
        jae led_gt_bp;

        lea r10, [rip + _led_buf];
        mov rax, [r10 + rdi * 8];
        ret;

      led_gt_ni:
        mov rdi, 0xFFFFF04F;
        call led_set_err;
        xor rax, rax;
        ret;
      led_gt_bp:
        mov rdi, 0xFFFFF04E;
        call led_set_err;
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // led_insert(ch) -> u64
  //
  // Insert one printable ASCII byte at the cursor; shift the tail
  // right by one; advance cursor. Refuses:
  //   - not init                     LED_ERR_NOT_INIT
  //   - ch outside [0x20, 0x7E]      LED_ERR_BAD_CH
  //   - buf_len == 128               LED_ERR_BUF_FULL
  //
  // Locals: rbx = ch, r12 = i (loop scratch), r13 = buf_len, r14 = cursor.
  // ==========================================================================

  pub let led_insert : (u64) -> u64 !{mem} @{} =
    fn (ch: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M4-002 (#1375): insert one byte at cursor. Shift tail right. Labels prefixed led_in_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        mov rbx, rdi;                            // ch

        lea r10, [rip + _led_state];
        mov rax, [r10 + 0];
        mov r11, 0x1EE0;
        cmp rax, r11;
        jne led_in_ni;

        // Range check.
        cmp rbx, 0x20;
        jb  led_in_bc;
        cmp rbx, 0x7E;
        ja  led_in_bc;

        mov r13, [r10 + 16];                     // buf_len
        cmp r13, 128;
        jae led_in_full;

        mov r14, [r10 + 24];                     // cursor

        // Shift buf[i+1] = buf[i] for i from buf_len-1 downto cursor.
        lea r10, [rip + _led_buf];
        mov r12, r13;                            // r12 = buf_len
      led_in_shift:
        cmp r12, r14;
        jbe led_in_place;
        // buf[r12] = buf[r12 - 1]
        mov r11, r12;
        sub r11, 1;
        mov rax, [r10 + r11 * 8];
        mov [r10 + r12 * 8], rax;
        sub r12, 1;
        jmp led_in_shift;

      led_in_place:
        // buf[cursor] = ch
        mov [r10 + r14 * 8], rbx;

        // buf_len++, cursor++.
        lea r10, [rip + _led_state];
        mov rax, [r10 + 16];
        add rax, 1;
        mov [r10 + 16], rax;
        mov rax, [r10 + 24];
        add rax, 1;
        mov [r10 + 24], rax;

        xor rax, rax;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      led_in_ni:
        mov rdi, 0xFFFFF04F;
        call led_set_err;
        mov rax, 0xFFFFF04F;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;
      led_in_bc:
        mov rdi, 0xFFFFF049;
        call led_set_err;
        mov rax, 0xFFFFF049;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;
      led_in_full:
        mov rdi, 0xFFFFF04D;
        call led_set_err;
        mov rax, 0xFFFFF04D;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // led_backspace() -> u64
  //
  // Remove buf[cursor - 1]; shift tail left; decrement cursor and
  // buf_len. Refuses if cursor == 0.
  // ==========================================================================

  pub let led_backspace : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M4-002 (#1375): erase byte left of cursor. Shift tail left. Labels prefixed led_bs_.",
      block: {
        push rbx;
        push r12;
        push r13;

        lea r10, [rip + _led_state];
        mov rax, [r10 + 0];
        mov r11, 0x1EE0;
        cmp rax, r11;
        jne led_bs_ni;

        mov r13, [r10 + 24];                     // cursor
        cmp r13, 0;
        je  led_bs_empty;

        mov r12, [r10 + 16];                     // buf_len

        // Shift buf[i - 1] = buf[i] for i from cursor..buf_len - 1.
        lea r10, [rip + _led_buf];
        mov rbx, r13;                            // i = cursor
      led_bs_shift:
        cmp rbx, r12;
        jae led_bs_final;
        mov r11, rbx;
        sub r11, 1;
        mov rax, [r10 + rbx * 8];
        mov [r10 + r11 * 8], rax;
        add rbx, 1;
        jmp led_bs_shift;

      led_bs_final:
        // Zero out the freed tail slot.
        mov r11, r12;
        sub r11, 1;
        xor rax, rax;
        mov [r10 + r11 * 8], rax;

        lea r10, [rip + _led_state];
        mov rax, [r10 + 16];
        sub rax, 1;
        mov [r10 + 16], rax;                     // buf_len--
        mov rax, [r10 + 24];
        sub rax, 1;
        mov [r10 + 24], rax;                     // cursor--

        xor rax, rax;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      led_bs_ni:
        mov rdi, 0xFFFFF04F;
        call led_set_err;
        mov rax, 0xFFFFF04F;
        pop r13;
        pop r12;
        pop rbx;
        ret;
      led_bs_empty:
        mov rdi, 0xFFFFF04C;
        call led_set_err;
        mov rax, 0xFFFFF04C;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // led_delete() -> u64
  //
  // Remove buf[cursor]; shift tail left; decrement buf_len; cursor
  // unchanged. Refuses if cursor == buf_len.
  // ==========================================================================

  pub let led_delete : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M4-002 (#1375): erase byte at cursor. Shift tail left. Labels prefixed led_dl_.",
      block: {
        push rbx;
        push r12;
        push r13;

        lea r10, [rip + _led_state];
        mov rax, [r10 + 0];
        mov r11, 0x1EE0;
        cmp rax, r11;
        jne led_dl_ni;

        mov r13, [r10 + 24];                     // cursor
        mov r12, [r10 + 16];                     // buf_len
        cmp r13, r12;
        jae led_dl_empty;

        // Shift buf[i] = buf[i + 1] for i from cursor..buf_len - 2.
        lea r10, [rip + _led_buf];
        mov rbx, r13;
      led_dl_shift:
        mov r11, rbx;
        add r11, 1;
        cmp r11, r12;
        jae led_dl_final;
        mov rax, [r10 + r11 * 8];
        mov [r10 + rbx * 8], rax;
        add rbx, 1;
        jmp led_dl_shift;

      led_dl_final:
        // Zero out the freed tail slot.
        mov r11, r12;
        sub r11, 1;
        xor rax, rax;
        mov [r10 + r11 * 8], rax;

        lea r10, [rip + _led_state];
        mov rax, [r10 + 16];
        sub rax, 1;
        mov [r10 + 16], rax;                     // buf_len--

        xor rax, rax;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      led_dl_ni:
        mov rdi, 0xFFFFF04F;
        call led_set_err;
        mov rax, 0xFFFFF04F;
        pop r13;
        pop r12;
        pop rbx;
        ret;
      led_dl_empty:
        mov rdi, 0xFFFFF04C;
        call led_set_err;
        mov rax, 0xFFFFF04C;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Cursor motion primitives: led_left / led_right / led_home / led_end.
  // ==========================================================================

  pub let led_left : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M4-002 (#1375): cursor--. Refuses at 0. Labels prefixed led_lf_.",
      block: {
        lea r10, [rip + _led_state];
        mov rax, [r10 + 0];
        mov r11, 0x1EE0;
        cmp rax, r11;
        jne led_lf_ni;

        mov rax, [r10 + 24];
        cmp rax, 0;
        je  led_lf_bp;
        sub rax, 1;
        mov [r10 + 24], rax;
        xor rax, rax;
        ret;

      led_lf_ni:
        mov rdi, 0xFFFFF04F;
        call led_set_err;
        mov rax, 0xFFFFF04F;
        ret;
      led_lf_bp:
        mov rdi, 0xFFFFF04E;
        call led_set_err;
        mov rax, 0xFFFFF04E;
        ret
      }
    }

  pub let led_right : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M4-002 (#1375): cursor++. Refuses past buf_len. Labels prefixed led_rt_.",
      block: {
        lea r10, [rip + _led_state];
        mov rax, [r10 + 0];
        mov r11, 0x1EE0;
        cmp rax, r11;
        jne led_rt_ni;

        mov r8, [r10 + 24];                      // cursor
        mov r9, [r10 + 16];                      // buf_len
        cmp r8, r9;
        jae led_rt_bp;
        add r8, 1;
        mov [r10 + 24], r8;
        xor rax, rax;
        ret;

      led_rt_ni:
        mov rdi, 0xFFFFF04F;
        call led_set_err;
        mov rax, 0xFFFFF04F;
        ret;
      led_rt_bp:
        mov rdi, 0xFFFFF04E;
        call led_set_err;
        mov rax, 0xFFFFF04E;
        ret
      }
    }

  pub let led_home : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M4-002 (#1375): cursor = 0. Labels prefixed led_hm_.",
      block: {
        lea r10, [rip + _led_state];
        mov rax, [r10 + 0];
        mov r11, 0x1EE0;
        cmp rax, r11;
        jne led_hm_ni;
        xor rax, rax;
        mov [r10 + 24], rax;
        ret;
      led_hm_ni:
        mov rdi, 0xFFFFF04F;
        call led_set_err;
        mov rax, 0xFFFFF04F;
        ret
      }
    }

  pub let led_end : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M4-002 (#1375): cursor = buf_len. Labels prefixed led_ed_.",
      block: {
        lea r10, [rip + _led_state];
        mov rax, [r10 + 0];
        mov r11, 0x1EE0;
        cmp rax, r11;
        jne led_ed_ni;
        mov rax, [r10 + 16];
        mov [r10 + 24], rax;
        xor rax, rax;
        ret;
      led_ed_ni:
        mov rdi, 0xFFFFF04F;
        call led_set_err;
        mov rax, 0xFFFFF04F;
        ret
      }
    }

  // ==========================================================================
  // led_kill_line() -> u64
  //
  // Copy buf[cursor..buf_len] into _led_kill; truncate buf_len to
  // cursor; zero the freed tail. kill_len = buf_len_old - cursor.
  //
  // Locals: rbx = i, r12 = cursor, r13 = buf_len_old.
  // ==========================================================================

  pub let led_kill_line : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M4-002 (#1375): move (cursor..buf_len) into kill register; truncate line. Labels prefixed led_kl_.",
      block: {
        push rbx;
        push r12;
        push r13;

        lea r10, [rip + _led_state];
        mov rax, [r10 + 0];
        mov r11, 0x1EE0;
        cmp rax, r11;
        jne led_kl_ni;

        mov r12, [r10 + 24];                     // cursor
        mov r13, [r10 + 16];                     // buf_len

        // kill_len = buf_len - cursor.
        mov rax, r13;
        sub rax, r12;
        mov [r10 + 48], rax;                     // kill_len

        // Copy buf[cursor + i] into kill[i] for i in 0..kill_len.
        // Also zero buf[cursor + i].
        xor rbx, rbx;
      led_kl_copy:
        mov r11, rbx;
        add r11, r12;                            // cursor + i
        cmp r11, r13;
        jae led_kl_trunc;
        lea r8, [rip + _led_buf];
        mov r9, [r8 + r11 * 8];
        lea r8, [rip + _led_kill];
        mov [r8 + rbx * 8], r9;
        // Zero the source slot.
        lea r8, [rip + _led_buf];
        xor rax, rax;
        mov [r8 + r11 * 8], rax;
        add rbx, 1;
        jmp led_kl_copy;

      led_kl_trunc:
        // buf_len = cursor.
        lea r10, [rip + _led_state];
        mov [r10 + 16], r12;
        xor rax, rax;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      led_kl_ni:
        mov rdi, 0xFFFFF04F;
        call led_set_err;
        mov rax, 0xFFFFF04F;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // led_yank() -> u64
  //
  // Insert kill_len bytes from _led_kill at the cursor; shift tail
  // right by kill_len; advance cursor by kill_len; buf_len += kill_len.
  // Refuses if buf_len + kill_len > 128.
  //
  // Locals: rbx = kill_len, r12 = cursor, r13 = buf_len_old, r14 = i.
  // ==========================================================================

  pub let led_yank : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M4-002 (#1375): insert kill register at cursor. Labels prefixed led_yk_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        lea r10, [rip + _led_state];
        mov rax, [r10 + 0];
        mov r11, 0x1EE0;
        cmp rax, r11;
        jne led_yk_ni;

        mov rbx, [r10 + 48];                     // kill_len
        cmp rbx, 0;
        je  led_yk_done;

        mov r12, [r10 + 24];                     // cursor
        mov r13, [r10 + 16];                     // buf_len

        // Refuse if buf_len + kill_len > 128.
        mov rax, r13;
        add rax, rbx;
        cmp rax, 128;
        ja  led_yk_full;

        // Shift buf[i + kill_len] = buf[i] for i from buf_len-1 downto cursor.
        lea r10, [rip + _led_buf];
        mov r14, r13;                            // r14 = buf_len (start)
      led_yk_shift:
        cmp r14, r12;
        jbe led_yk_paste;
        mov r11, r14;
        sub r11, 1;                              // src index
        mov r8, r11;
        add r8, rbx;                             // dest index
        mov rax, [r10 + r11 * 8];
        mov [r10 + r8 * 8], rax;
        sub r14, 1;
        jmp led_yk_shift;

      led_yk_paste:
        // Paste kill[0..kill_len] at buf[cursor..cursor + kill_len].
        xor r14, r14;
      led_yk_p:
        cmp r14, rbx;
        jae led_yk_bump;
        lea r8, [rip + _led_kill];
        mov rax, [r8 + r14 * 8];
        mov r11, r12;
        add r11, r14;
        lea r8, [rip + _led_buf];
        mov [r8 + r11 * 8], rax;
        add r14, 1;
        jmp led_yk_p;

      led_yk_bump:
        // buf_len += kill_len; cursor += kill_len.
        lea r10, [rip + _led_state];
        mov rax, [r10 + 16];
        add rax, rbx;
        mov [r10 + 16], rax;
        mov rax, [r10 + 24];
        add rax, rbx;
        mov [r10 + 24], rax;

      led_yk_done:
        xor rax, rax;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      led_yk_ni:
        mov rdi, 0xFFFFF04F;
        call led_set_err;
        mov rax, 0xFFFFF04F;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;
      led_yk_full:
        mov rdi, 0xFFFFF04D;
        call led_set_err;
        mov rax, 0xFFFFF04D;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // led_history_push() -> u64
  //
  // Store the current line as _led_hist[hist_count]. Refuses if
  // hist_count == 32. Resets hist_cursor to hist_count + 1 so a
  // subsequent led_history_up shows the fresh entry.
  //
  // Locals: rbx = hist_count, r12 = buf_len, r13 = i, r14 = base.
  // ==========================================================================

  pub let led_history_push : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M4-002 (#1375): copy current line into hist[hist_count]. Labels prefixed led_hp_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        lea r10, [rip + _led_state];
        mov rax, [r10 + 0];
        mov r11, 0x1EE0;
        cmp rax, r11;
        jne led_hp_ni;

        mov rbx, [r10 + 32];                     // hist_count
        cmp rbx, 32;
        jae led_hp_full;

        mov r12, [r10 + 16];                     // buf_len

        // Store length.
        lea r10, [rip + _led_hist_lens];
        mov [r10 + rbx * 8], r12;

        // Copy buf[0..buf_len] into hist[hist_count * 128 + i].
        // r14 = hist_count * 128
        mov r14, rbx;
        shl r14, 7;                              // * 128
        xor r13, r13;                            // i
      led_hp_copy:
        cmp r13, r12;
        jae led_hp_bump;
        lea r8, [rip + _led_buf];
        mov rax, [r8 + r13 * 8];
        mov r11, r14;
        add r11, r13;
        lea r8, [rip + _led_hist];
        mov [r8 + r11 * 8], rax;
        add r13, 1;
        jmp led_hp_copy;

      led_hp_bump:
        lea r10, [rip + _led_state];
        mov rax, rbx;
        add rax, 1;
        mov [r10 + 32], rax;                     // hist_count++
        mov [r10 + 40], rax;                     // hist_cursor = new hist_count

        xor rax, rax;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      led_hp_ni:
        mov rdi, 0xFFFFF04F;
        call led_set_err;
        mov rax, 0xFFFFF04F;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;
      led_hp_full:
        mov rdi, 0xFFFFF04A;
        call led_set_err;
        mov rax, 0xFFFFF04A;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // led_history_up() -> u64
  //
  // Load hist[hist_cursor - 1] into buf, decrement hist_cursor.
  // Refuses if hist_cursor == 0 (no older entry).
  //
  // Locals: rbx = new_cursor, r12 = buf_len, r13 = i, r14 = base.
  // ==========================================================================

  pub let led_history_up : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M4-002 (#1375): browse to older history entry. Labels prefixed led_hu_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        lea r10, [rip + _led_state];
        mov rax, [r10 + 0];
        mov r11, 0x1EE0;
        cmp rax, r11;
        jne led_hu_ni;

        mov rbx, [r10 + 40];                     // hist_cursor
        cmp rbx, 0;
        je  led_hu_empty;
        sub rbx, 1;                              // target index

        // Load length.
        lea r10, [rip + _led_hist_lens];
        mov r12, [r10 + rbx * 8];

        // Clear buf.
        lea r10, [rip + _led_buf];
        xor rax, rax;
        xor r13, r13;
      led_hu_clr:
        mov [r10 + r13 * 8], rax;
        add r13, 1;
        cmp r13, 128;
        jb  led_hu_clr;

        // Copy hist[target * 128 + i] into buf[i].
        mov r14, rbx;
        shl r14, 7;                              // * 128
        xor r13, r13;
      led_hu_copy:
        cmp r13, r12;
        jae led_hu_bump;
        mov r11, r14;
        add r11, r13;
        lea r8, [rip + _led_hist];
        mov rax, [r8 + r11 * 8];
        lea r8, [rip + _led_buf];
        mov [r8 + r13 * 8], rax;
        add r13, 1;
        jmp led_hu_copy;

      led_hu_bump:
        lea r10, [rip + _led_state];
        mov [r10 + 16], r12;                     // buf_len = entry len
        mov [r10 + 24], r12;                     // cursor = end of loaded line
        mov [r10 + 40], rbx;                     // hist_cursor = target

        xor rax, rax;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      led_hu_ni:
        mov rdi, 0xFFFFF04F;
        call led_set_err;
        mov rax, 0xFFFFF04F;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;
      led_hu_empty:
        mov rdi, 0xFFFFF04B;
        call led_set_err;
        mov rax, 0xFFFFF04B;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // led_history_down() -> u64
  //
  // Load hist[hist_cursor + 1] into buf, increment hist_cursor. Refuses
  // if hist_cursor >= hist_count - 1 (no newer entry).
  //
  // Locals: rbx = new_cursor, r12 = buf_len, r13 = i, r14 = base.
  // ==========================================================================

  pub let led_history_down : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M4-002 (#1375): browse to newer history entry. Labels prefixed led_hd_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        lea r10, [rip + _led_state];
        mov rax, [r10 + 0];
        mov r11, 0x1EE0;
        cmp rax, r11;
        jne led_hd_ni;

        mov rbx, [r10 + 40];                     // hist_cursor
        add rbx, 1;
        mov r8, [r10 + 32];                      // hist_count
        cmp rbx, r8;
        jae led_hd_empty;

        // Load length.
        lea r10, [rip + _led_hist_lens];
        mov r12, [r10 + rbx * 8];

        // Clear buf.
        lea r10, [rip + _led_buf];
        xor rax, rax;
        xor r13, r13;
      led_hd_clr:
        mov [r10 + r13 * 8], rax;
        add r13, 1;
        cmp r13, 128;
        jb  led_hd_clr;

        // Copy hist[target * 128 + i] into buf[i].
        mov r14, rbx;
        shl r14, 7;
        xor r13, r13;
      led_hd_copy:
        cmp r13, r12;
        jae led_hd_bump;
        mov r11, r14;
        add r11, r13;
        lea r8, [rip + _led_hist];
        mov rax, [r8 + r11 * 8];
        lea r8, [rip + _led_buf];
        mov [r8 + r13 * 8], rax;
        add r13, 1;
        jmp led_hd_copy;

      led_hd_bump:
        lea r10, [rip + _led_state];
        mov [r10 + 16], r12;
        mov [r10 + 24], r12;
        mov [r10 + 40], rbx;

        xor rax, rax;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      led_hd_ni:
        mov rdi, 0xFFFFF04F;
        call led_set_err;
        mov rax, 0xFFFFF04F;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;
      led_hd_empty:
        mov rdi, 0xFFFFF04B;
        call led_set_err;
        mov rax, 0xFFFFF04B;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // led_complete_next() -> u64
  //
  // Completion hook. Returns 0 in this scaffold (no catalogue
  // installed). A widening installs a completion catalogue and this
  // returns the next candidate's kind identifier.
  // ==========================================================================

  pub let led_complete_next : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M4-002 (#1375): completion hook stub. Labels prefixed led_cn_.",
      block: {
        lea r10, [rip + _led_state];
        mov rax, [r10 + 0];
        mov r11, 0x1EE0;
        cmp rax, r11;
        jne led_cn_ni;
        xor rax, rax;
        ret;
      led_cn_ni:
        mov rdi, 0xFFFFF04F;
        call led_set_err;
        xor rax, rax;
        ret
      }
    }
}
