// src/kernel/core/semterm/types.pdx -- R41.M1-003 (#1367)
//
// QUERY TYPE SYSTEM for the semantic terminal. Layered on top of the
// parser's AST arena (semterm/parser.pdx): infers a type + effect row
// for each node bottom-up, and refuses malformed inputs (comparison of
// a scalar to a relation, aggregation over a non-scalar, effect row
// declared narrower than the capabilities the query touches).
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the SHAPE-CHECKER on top of the AST. tyq_infer walks the arena
// starting from a root, assigns each node a type tag (§1), composes
// effect rows bottom-up (§2), and rejects any composition the grammar
// admits but the type discipline refuses.
//
// It does NOT execute anything. It does NOT resolve identifiers against
// a live schema catalogue -- the schema binding (relation name -> row
// shape) lives in R41.M2's semantic query engine. This module accepts
// caller-supplied bindings through tyq_bind and validates that the
// AST's references resolve within them.
//
// It does NOT own the AST -- every read goes through par_node_get, and
// every write is refused (there is no back-write path). That is what
// makes this a checker rather than a rewriter.
//
// The types module is a SCAFFOLD in the D7 sense: R41.M1 wires it into
// the witness tree but no live command path calls it yet.
// tyq_arbitrated() returns 0 until a later round drives it.
//
// =============================================================================
// §1  TYPE UNION
// =============================================================================
//
//   TY_UNKNOWN   (0)   inference has not yet visited the node
//   TY_INT       (1)   scalar integer (INTLIT, integer column)
//   TY_TEXT      (2)   scalar UTF-8 text (STRLIT, text column)
//   TY_BOOL      (3)   scalar boolean (result of a comparison / logical op)
//   TY_TUPLE     (4)   one row of a relation (a projected column list)
//   TY_RELATION  (5)   a set of tuples (a table reference; a subquery's result)
//   TY_EFFECT    (6)   an effect row (not a data type; the type of a
//                       BIN_OP whose operator is an "emit" verb; unused
//                       at this milestone -- reserved so a later round
//                       does not shift the ordinals)
//
// Type ordinals fit u8. A caller-supplied binding above TY_EFFECT is
// TYQ_ERR_BAD_TY.
//
// =============================================================================
// §2  EFFECT ROWS
// =============================================================================
//
// An effect row is a bitmask over three flags:
//
//   EFR_READ   (bit 0)   query reads from a data source (any SELECT)
//   EFR_WRITE  (bit 1)   query mutates a data source (reserved -- INSERT /
//                        UPDATE / DELETE are not in the R41.M1 grammar
//                        but the bit is reserved so a caller cannot
//                        smuggle a write through a widening later)
//   EFR_EMIT   (bit 2)   query composes a subscriber-facing notification
//                        (reserved for a later round)
//
// tyq_infer computes the effect row by folding the row of each visited
// node (leaves contribute their own; interior nodes union their
// children's). The final row on the root is what a caller uses to
// decide which capabilities the query needs.
//
// =============================================================================
// §3  BINDING ENVIRONMENT
// =============================================================================
//
// tyq_bind(name_hash, ty_kind) installs one identifier -> type mapping
// in a fixed-size environment (_tyq_env). Lookup is by exact match on
// a 64-bit name hash the caller supplies; that lets the type system
// stay identifier-representation-agnostic (the caller may hash by
// FNV-1a, by CRC64, or by any function it likes, as long as it uses
// the SAME hash at both bind and lookup).
//
// TYQ_ENV_SLOTS = 32 bindings. Overflowing the env is TYQ_ERR_ENV_FULL.
// A duplicate bind is TYQ_ERR_ENV_DUP (silent overwrite would let a
// second binding hide the first from the checker).
//
// =============================================================================
// §4  ONE WRITER OF THE STATE
// =============================================================================
//
// _tyq_env, _tyq_types (per-node type cache), _tyq_effects (per-node
// effect row cache) and _tyq_state are written only by helpers here.
// tools/build.sh confines relocations against each to
// `core/semterm/types.o`.
//
// STATE LAYOUT -- _tyq_state : [u64; 8]
//   +0   env_count   how many bindings are live in _tyq_env
//   +8   err         sticky error code
//   +16  root_ty     inferred type of the last tyq_infer call
//   +24  root_efr    inferred effect row of the last tyq_infer call
//   +32  init_mark   0xD474 once tyq_reset has run
//
// =============================================================================
// §5  FAILURE TAXONOMY 0xFFFFF150..0xFFFFF15F
// =============================================================================
//
// Sixteen-wide, verified disjoint. Adjacent used band above: parser
// 0xFFFFF160..6F. Adjacent band below: KIND_BT_ADAPTER 0xFFFFF140..4F.
//
//   TYQ_OK              = 0
//   TYQ_ERR_BAD_TY      = 0xFFFFF15F  ty_kind outside [0..6]
//   TYQ_ERR_BAD_NODE    = 0xFFFFF15E  arena index out of range
//   TYQ_ERR_BAD_KIND    = 0xFFFFF15D  AST node kind outside recogniser union
//   TYQ_ERR_ENV_FULL    = 0xFFFFF15C  no room in _tyq_env
//   TYQ_ERR_ENV_DUP     = 0xFFFFF15B  duplicate bind for name_hash
//   TYQ_ERR_UNBOUND     = 0xFFFFF15A  reference resolves to no binding
//   TYQ_ERR_MISMATCH    = 0xFFFFF159  binop operands disagree on scalar type
//   TYQ_ERR_NOT_SCALAR  = 0xFFFFF158  comparison RHS or LHS is a relation
//   TYQ_ERR_NOT_INIT    = 0xFFFFF157  tyq_infer without tyq_reset
//   TYQ_ERR_INTERNAL    = 0xFFFFF156  unreachable-fallthrough tripwire

module Types = structure {

  // Type union (§1).
  pub let TY_UNKNOWN   : u64 = 0
  pub let TY_INT       : u64 = 1
  pub let TY_TEXT      : u64 = 2
  pub let TY_BOOL      : u64 = 3
  pub let TY_TUPLE     : u64 = 4
  pub let TY_RELATION  : u64 = 5
  pub let TY_EFFECT    : u64 = 6
  pub let TY_MAX       : u64 = 6

  // Effect flags (§2).
  pub let EFR_NONE   : u64 = 0
  pub let EFR_READ   : u64 = 1
  pub let EFR_WRITE  : u64 = 2
  pub let EFR_EMIT   : u64 = 4
  pub let EFR_MASK   : u64 = 7

  // Env capacity (§3).
  pub let TYQ_ENV_SLOTS : u64 = 32

  // Per-node cache capacity: mirrors PAR_ARENA_NODES.
  pub let TYQ_CACHE_NODES : u64 = 256

  // Failure taxonomy (§5).
  pub let TYQ_OK              : u64 = 0
  pub let TYQ_ERR_BAD_TY      : u64 = 0xFFFFF15F
  pub let TYQ_ERR_BAD_NODE    : u64 = 0xFFFFF15E
  pub let TYQ_ERR_BAD_KIND    : u64 = 0xFFFFF15D
  pub let TYQ_ERR_ENV_FULL    : u64 = 0xFFFFF15C
  pub let TYQ_ERR_ENV_DUP     : u64 = 0xFFFFF15B
  pub let TYQ_ERR_UNBOUND     : u64 = 0xFFFFF15A
  pub let TYQ_ERR_MISMATCH    : u64 = 0xFFFFF159
  pub let TYQ_ERR_NOT_SCALAR  : u64 = 0xFFFFF158
  pub let TYQ_ERR_NOT_INIT    : u64 = 0xFFFFF157
  pub let TYQ_ERR_INTERNAL    : u64 = 0xFFFFF156

  pub let TYQ_INIT_MARK : u64 = 0xD474

  // Env layout: pairs (name_hash, ty_kind). Row stride = 2 words.
  pub let mut _tyq_env     : [u64; 64]  = uninit @align(64)
  pub let mut _tyq_types   : [u64; 256] = uninit @align(64)
  pub let mut _tyq_effects : [u64; 256] = uninit @align(64)
  pub let mut _tyq_state   : [u64; 8]   = uninit @align(64)

  // ==========================================================================
  // Reset. Boot + teardown.
  // ==========================================================================

  pub let tyq_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M1-003 (#1367): clear env, per-node caches, state. Labels prefixed tyq_rs_.",
      block: {
        // env
        lea r10, [rip + _tyq_env];
        xor rax, rax;
        xor rcx, rcx;
      tyq_rs_env:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 64;
        jb  tyq_rs_env;

        // types cache
        lea r10, [rip + _tyq_types];
        xor rcx, rcx;
      tyq_rs_ty:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 256;
        jb  tyq_rs_ty;

        // effects cache
        lea r10, [rip + _tyq_effects];
        xor rcx, rcx;
      tyq_rs_ef:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 256;
        jb  tyq_rs_ef;

        // state
        lea r10, [rip + _tyq_state];
        xor rcx, rcx;
      tyq_rs_st:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  tyq_rs_st;

        mov rax, 0xD474;
        mov [r10 + 32], rax;            // init_mark
        ret
      }
    } @no_frame

  pub let tyq_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R41.M1-003 (#1367): honesty pin. Returns 0 until a later round drives tyq_infer from the terminal frontend.",
      block: {
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let tyq_err : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M1-003 (#1367): sticky error latch readback. Labels prefixed tyq_er_.",
      block: {
        lea r10, [rip + _tyq_state];
        mov rax, [r10 + 8];
        ret
      }
    } @no_frame

  pub let tyq_env_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M1-003 (#1367): number of live bindings. Labels prefixed tyq_ec_.",
      block: {
        lea r10, [rip + _tyq_state];
        mov rax, [r10 + 0];
        ret
      }
    } @no_frame

  pub let tyq_root_ty : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M1-003 (#1367): last root inference type. Labels prefixed tyq_rty_.",
      block: {
        lea r10, [rip + _tyq_state];
        mov rax, [r10 + 16];
        ret
      }
    } @no_frame

  pub let tyq_root_efr : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M1-003 (#1367): last root effect row. Labels prefixed tyq_ref_.",
      block: {
        lea r10, [rip + _tyq_state];
        mov rax, [r10 + 24];
        ret
      }
    } @no_frame

  pub let tyq_bound : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M1-003 (#1367): 1 iff init_mark matches. Labels prefixed tyq_bnd_.",
      block: {
        lea r10, [rip + _tyq_state];
        mov rax, [r10 + 32];
        mov r11, 0xD474;
        cmp rax, r11;
        jne tyq_bnd_no;
        mov rax, 1;
        ret;
      tyq_bnd_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let tyq_set_err : (u64) -> () !{mem} @{} =
    fn (code: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M1-003 (#1367): first-writer-wins error latch. Labels prefixed tyq_se_.",
      block: {
        lea r10, [rip + _tyq_state];
        mov rax, [r10 + 8];
        cmp rax, 0;
        jne tyq_se_out;
        mov [r10 + 8], rdi;
      tyq_se_out:
        ret
      }
    } @no_frame

  // ==========================================================================
  // tyq_bind(name_hash, ty_kind) -> u64
  //
  // Install an identifier -> type binding. Refuses duplicates, out-of-
  // range types, and env overflow.
  // ==========================================================================

  pub let tyq_bind : (u64, u64) -> u64 !{mem} @{} =
    fn (name_hash: u64, ty_kind: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M1-003 (#1367): install a binding. Labels prefixed tyq_bd_.",
      block: {
        push rbx;
        push r12;
        mov rbx, rdi;
        mov r12, rsi;

        // Init mark.
        lea r10, [rip + _tyq_state];
        mov rax, [r10 + 32];
        mov r11, 0xD474;
        cmp rax, r11;
        jne tyq_bd_not_init;

        // Type range.
        cmp r12, 6;                     // TY_MAX
        ja  tyq_bd_bad_ty;

        // Search for duplicate.
        mov rax, [r10 + 0];             // env_count
        lea r9, [rip + _tyq_env];
        xor rcx, rcx;
      tyq_bd_scan:
        cmp rcx, rax;
        jae tyq_bd_scan_done;
        mov r8, rcx;
        shl r8, 1;                      // idx * 2
        mov r11, [r9 + r8 * 8];         // stored hash
        cmp r11, rbx;
        je  tyq_bd_dup;
        add rcx, 1;
        jmp tyq_bd_scan;
      tyq_bd_scan_done:
        cmp rax, 32;                    // TYQ_ENV_SLOTS
        jae tyq_bd_full;

        mov r8, rax;
        shl r8, 1;
        mov [r9 + r8 * 8], rbx;
        mov r11, r8;
        add r11, 1;
        mov [r9 + r11 * 8], r12;

        add rax, 1;
        mov [r10 + 0], rax;             // env_count++

        xor rax, rax;
        pop r12;
        pop rbx;
        ret;

      tyq_bd_not_init:
        mov rdi, 0xFFFFF157;
        call tyq_set_err;
        mov rax, 0xFFFFF157;
        pop r12;
        pop rbx;
        ret;
      tyq_bd_bad_ty:
        mov rdi, 0xFFFFF15F;
        call tyq_set_err;
        mov rax, 0xFFFFF15F;
        pop r12;
        pop rbx;
        ret;
      tyq_bd_dup:
        mov rdi, 0xFFFFF15B;
        call tyq_set_err;
        mov rax, 0xFFFFF15B;
        pop r12;
        pop rbx;
        ret;
      tyq_bd_full:
        mov rdi, 0xFFFFF15C;
        call tyq_set_err;
        mov rax, 0xFFFFF15C;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // tyq_lookup(name_hash) -> ty_kind | TY_UNKNOWN
  //
  // Returns the type bound to name_hash, or TY_UNKNOWN if unbound.
  // Does NOT latch an error -- lookup by shape is a legitimate query
  // (the caller decides whether unbound is an error).
  // ==========================================================================

  pub let tyq_lookup : (u64) -> u64 !{mem} @{} =
    fn (name_hash: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M1-003 (#1367): linear scan for binding. Labels prefixed tyq_lk_.",
      block: {
        lea r10, [rip + _tyq_state];
        mov rax, [r10 + 0];             // env_count
        lea r9, [rip + _tyq_env];
        xor rcx, rcx;
      tyq_lk_scan:
        cmp rcx, rax;
        jae tyq_lk_no;
        mov r8, rcx;
        shl r8, 1;
        mov r11, [r9 + r8 * 8];
        cmp r11, rdi;
        je  tyq_lk_hit;
        add rcx, 1;
        jmp tyq_lk_scan;
      tyq_lk_hit:
        add r8, 1;
        mov rax, [r9 + r8 * 8];
        ret;
      tyq_lk_no:
        xor rax, rax;                   // TY_UNKNOWN
        ret
      }
    } @no_frame

  // ==========================================================================
  // tyq_effect_union(a, b) -> u64
  //
  // Bitwise union masked to EFR_MASK. A caller-supplied bit outside
  // EFR_MASK is masked off rather than tolerated (a widening of the
  // effect vocabulary must be added to the mask constant, not smuggled
  // through a caller argument).
  // ==========================================================================

  pub let tyq_effect_union : (u64, u64) -> u64 !{} @{} =
    fn (a: u64, b: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R41.M1-003 (#1367): mask + OR. Labels prefixed tyq_eu_.",
      block: {
        mov rax, rdi;
        or  rax, rsi;
        and rax, 7;                     // EFR_MASK
        ret
      }
    } @no_frame

  // ==========================================================================
  // tyq_node_ty(idx) / tyq_node_efr(idx) -- per-node cache readback.
  // ==========================================================================

  pub let tyq_node_ty : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M1-003 (#1367): per-node type cache readback (zero if unvisited or out-of-range). Labels prefixed tyq_nty_.",
      block: {
        cmp rdi, 256;
        jae tyq_nty_zero;
        lea r10, [rip + _tyq_types];
        mov rax, [r10 + rdi * 8];
        ret;
      tyq_nty_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let tyq_node_efr : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M1-003 (#1367): per-node effect-row cache readback. Labels prefixed tyq_nef_.",
      block: {
        cmp rdi, 256;
        jae tyq_nef_zero;
        lea r10, [rip + _tyq_effects];
        mov rax, [r10 + rdi * 8];
        ret;
      tyq_nef_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // tyq_infer(root_idx) -> ty_kind
  //
  // Bottom-up inference on the AST rooted at root_idx. Uses par_node_get
  // for every read. Writes per-node results into _tyq_types /
  // _tyq_effects and the root pair into _tyq_state[root_ty/root_efr].
  //
  // This scaffold recognises the AST shapes SelectStmt / TableRef /
  // ColumnExpr / Literal / BinOp. Fuller productions (JoinExpr,
  // WhereClause, OrderClause, FnCall) inherit their bottom-up rules in
  // R41.M2 when the semantic query engine drives them; the ordinals
  // are already reserved here so the arithmetic does not shift.
  //
  // Locals: rbx=idx, r12=kind, r13=left_ty, r14=right_ty, r15=efr.
  // ==========================================================================

  pub let tyq_infer : (u64) -> u64 !{mem} @{} =
    fn (root_idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M1-003 (#1367): bottom-up inference. Recursive: five-push callee-save + one recursion level per nested BinOp / SelectStmt subtree. Labels prefixed tyq_in_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // Init check.
        lea r10, [rip + _tyq_state];
        mov rax, [r10 + 32];
        mov r11, 0xD474;
        cmp rax, r11;
        jne tyq_in_not_init;

        mov rbx, rdi;                   // idx

        // Bounds.
        cmp rbx, 1;
        jb  tyq_in_bad_node;
        cmp rbx, 256;
        jae tyq_in_bad_node;

        // Fetch kind.
        mov rdi, rbx;
        mov rsi, 0;                     // AST_OFF_KIND
        call par_node_get;
        mov r12, rax;

        // Dispatch.
        cmp r12, 9;                     // AST_LITERAL
        je  tyq_in_literal;
        cmp r12, 6;                     // AST_COLUMN_EXPR
        je  tyq_in_column;
        cmp r12, 2;                     // AST_TABLE_REF
        je  tyq_in_table;
        cmp r12, 7;                     // AST_BIN_OP
        je  tyq_in_binop;
        cmp r12, 1;                     // AST_SELECT_STMT
        je  tyq_in_select;
        // Unknown kind.
        mov rdi, 0xFFFFF15D;
        call tyq_set_err;
        xor rax, rax;
        jmp tyq_in_out;

      tyq_in_literal:
        // P0 is the token kind: 18=INTLIT -> TY_INT, 19=STRLIT -> TY_TEXT.
        mov rdi, rbx;
        mov rsi, 4;                     // P0
        call par_node_get;
        cmp rax, 18;
        je  tyq_in_lit_int;
        cmp rax, 19;
        je  tyq_in_lit_text;
        mov rdi, 0xFFFFF15D;
        call tyq_set_err;
        xor rax, rax;
        jmp tyq_in_out;
      tyq_in_lit_int:
        mov rax, 1;                     // TY_INT
        mov r15, 0;                     // literals have no effect
        jmp tyq_in_store;
      tyq_in_lit_text:
        mov rax, 2;                     // TY_TEXT
        mov r15, 0;
        jmp tyq_in_store;

      tyq_in_column:
        // A bare column reference in R41.M1 has TY_INT by default (a
        // schema binding would refine this via tyq_lookup on a name hash
        // the parser would need to compute -- deferred to R41.M2). The
        // effect row is EFR_READ.
        mov rax, 1;                     // TY_INT
        mov r15, 1;                     // EFR_READ
        jmp tyq_in_store;

      tyq_in_table:
        mov rax, 5;                     // TY_RELATION
        mov r15, 1;                     // EFR_READ
        jmp tyq_in_store;

      tyq_in_binop:
        // Recurse into LEFT and RIGHT.
        mov rdi, rbx;
        mov rsi, 1;                     // LEFT
        call par_node_get;
        cmp rax, 0;
        je  tyq_in_bad_node;
        mov rdi, rax;
        call tyq_infer;
        mov r13, rax;                   // left_ty

        mov rdi, rbx;
        mov rsi, 2;                     // RIGHT
        call par_node_get;
        cmp rax, 0;
        je  tyq_in_bad_node;
        mov rdi, rax;
        call tyq_infer;
        mov r14, rax;                   // right_ty

        // Neither may be a relation.
        cmp r13, 5;
        je  tyq_in_not_scalar;
        cmp r14, 5;
        je  tyq_in_not_scalar;
        // Must agree on scalar type.
        cmp r13, r14;
        jne tyq_in_mismatch;

        // Union effect rows.
        mov rdi, rbx;
        mov rsi, 1;
        call par_node_get;
        push rax;
        mov rdi, rax;
        call tyq_node_efr;
        mov r13, rax;
        pop rax;
        mov rdi, rbx;
        mov rsi, 2;
        call par_node_get;
        mov rdi, rax;
        call tyq_node_efr;
        mov r14, rax;
        mov rdi, r13;
        mov rsi, r14;
        call tyq_effect_union;
        mov r15, rax;

        mov rax, 3;                     // TY_BOOL
        jmp tyq_in_store;

      tyq_in_select:
        // Projection (LEFT) sets the tuple type; source (RIGHT) sets the
        // relation type. Result is TY_RELATION with EFR_READ unioned
        // from children.
        mov rdi, rbx;
        mov rsi, 1;                     // LEFT (projection)
        call par_node_get;
        cmp rax, 0;
        je  tyq_in_bad_node;
        mov rdi, rax;
        call tyq_infer;
        // proj_ty in rax (should be scalar for R41.M1 minimal grammar).
        mov r13, rax;

        mov rdi, rbx;
        mov rsi, 2;                     // RIGHT (table)
        call par_node_get;
        cmp rax, 0;
        je  tyq_in_bad_node;
        mov rdi, rax;
        call tyq_infer;
        mov r14, rax;
        cmp r14, 5;
        jne tyq_in_bad_node;            // SELECT's FROM must be a relation

        // Effect row union.
        mov rdi, rbx;
        mov rsi, 1;
        call par_node_get;
        mov rdi, rax;
        call tyq_node_efr;
        mov r13, rax;
        mov rdi, rbx;
        mov rsi, 2;
        call par_node_get;
        mov rdi, rax;
        call tyq_node_efr;
        mov rdi, r13;
        mov rsi, rax;
        call tyq_effect_union;
        // Ensure EFR_READ is set for a SELECT.
        or  rax, 1;
        and rax, 7;
        mov r15, rax;

        mov rax, 5;                     // TY_RELATION
        jmp tyq_in_store;

      tyq_in_store:
        // rax = ty_kind, r15 = efr, rbx = idx.
        lea r10, [rip + _tyq_types];
        mov [r10 + rbx * 8], rax;
        lea r10, [rip + _tyq_effects];
        mov [r10 + rbx * 8], r15;
        // If root: also stamp state.
        lea r10, [rip + _tyq_state];
        mov [r10 + 16], rax;
        mov [r10 + 24], r15;
        jmp tyq_in_out;

      tyq_in_not_init:
        mov rdi, 0xFFFFF157;
        call tyq_set_err;
        xor rax, rax;
        jmp tyq_in_out;
      tyq_in_bad_node:
        mov rdi, 0xFFFFF15E;
        call tyq_set_err;
        xor rax, rax;
        jmp tyq_in_out;
      tyq_in_mismatch:
        mov rdi, 0xFFFFF159;
        call tyq_set_err;
        xor rax, rax;
        jmp tyq_in_out;
      tyq_in_not_scalar:
        mov rdi, 0xFFFFF158;
        call tyq_set_err;
        xor rax, rax;

      tyq_in_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
