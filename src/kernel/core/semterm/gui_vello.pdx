// src/kernel/core/semterm/gui_vello.pdx -- R44.M2-001 (#1403)
//
// SEMTERM GUI VELLO RENDERING. The R44.M2 typography-quality rendering
// seam for query result output: routes rows from the R41 resultset
// through the R37 GPU (Vello backend), stages a subpixel-aware glyph
// atlas with configurable AA mode, and composes a fixed four-layer
// scene (background + text_bg + text_fg + selection).
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the RENDER SEAM behind the shell's results region. A live
// resultset writer walks the seam:
//   vel_route_result(row_count)              // stage row count
//   for each glyph run:
//     vel_atlas_add_glyph(codepoint)         // upload glyph
//   vel_submit_frame()                       // compose + flush
//
// vel_reset zeroes state and installs the four named layers with
// sensible defaults (background, text_bg, text_fg VISIBLE @ full
// opacity; selection HIDDEN @ 50% opacity, ready to be shown when
// the shell reports a selection). vel_layer_show / vel_layer_set_opacity
// toggle per-layer visibility and translucency. vel_subpx_set picks
// between VEL_SUBPX_NONE (grayscale AA) and VEL_SUBPX_RGB (horizontal
// subpixel AA -- the Vello default for LCD panels). vel_atlas_add_glyph
// stores a code point in a bounded 256-entry atlas; vel_atlas_glyph_at
// reads it back. vel_route_result parks a pending row count from the
// resultset; vel_submit_frame requires a pending route and refuses
// otherwise, then walks each layer and counts visible ones into
// layers_composed before bumping frames_submitted and clearing the
// pending flag.
//
// It does NOT rasterise. It does NOT ship draw commands to the GPU;
// the Vello scene graph, the glyph SDF cache, and the queue submissions
// live in libpaideia-ui (G12) once R44.M3+ hooks a real backend.
// It does NOT own the resultset -- the row_count arrives as an opaque
// scalar from R41's rs_row_count, and the module trusts that scalar
// to be valid.
//
// It is a SCAFFOLD (D7): R44.M2 wires it into the witness tree but no
// live GPU backend paints and no live resultset writer routes;
// vel_arbitrated() returns 0 until a later round hooks R37 GPU into
// vel_submit_frame and R41 resultset into vel_route_result.
//
// =============================================================================
// §1  LAYER MODEL
// =============================================================================
//
// VEL_LAYER_BACKGROUND = 0    solid theme background
// VEL_LAYER_TEXT_BG    = 1    per-cell background attributes
// VEL_LAYER_TEXT_FG    = 2    subpixel-AA text glyphs
// VEL_LAYER_SELECTION  = 3    translucent selection overlay
// VEL_LAYER_MAX        = 4
//
// Z-order is baked at reset (BACKGROUND=0 .. SELECTION=3) so a
// downstream compositor walks the array top-to-bottom and paints in
// the intended stack. Reordering is a widening of _vel_layers and
// rewrites vel_reset's initial store in one place; a caller-visible
// z_order field would let a widening slip in a hidden coordinate the
// confinement gate could not see.
//
// Opacity is a Q10.0 integer in [0, VEL_OPACITY_MAX] = [0, 1000] --
// 0 == fully transparent, 1000 == fully opaque. Q10.0 rather than
// floating point so the layer state stays scalar-comparable in
// witnesses; 1000 gives per-mille precision, which matches the
// perceptual step a viewer can distinguish on a monitor. Values above
// 1000 are refused with VEL_ERR_BAD_OPACITY rather than clamped so a
// corpus fixture can prove the boundary.
//
// =============================================================================
// §2  GLYPH ATLAS
// =============================================================================
//
// VEL_ATLAS_MAX_GLYPHS = 256. Each entry is a single Unicode code
// point; codepoint 0 is the empty-slot marker so vel_atlas_add_glyph
// refuses a 0 argument with VEL_ERR_BAD_GLYPH (an empty cell in the
// resultset is not a glyph the renderer needs to upload; the caller
// tracks that separately). The pool is a bump allocator: atlas_count
// grows monotonically, and vel_atlas_reset() zeroes it so a boot
// witness or a re-theme can start fresh.
//
// The atlas indices are dense (0..atlas_count-1). vel_atlas_glyph_at
// refuses an index >= atlas_count with VEL_ERR_BAD_ATLAS.
//
// =============================================================================
// §3  SUB-PIXEL POSITIONING
// =============================================================================
//
// VEL_SUBPX_NONE = 0    grayscale AA (fallback for e-ink / mono panels)
// VEL_SUBPX_RGB  = 1    horizontal subpixel AA (RGB-stripe LCDs)
// VEL_SUBPX_MAX  = 1
//
// The mode is a single scalar consumed by whichever glyph rasteriser
// R44.M3+ hooks in. It defaults to VEL_SUBPX_RGB at reset because the
// primary T14 G4 panel is an RGB-stripe LCD; a mono fallback is a
// setter call away.
//
// =============================================================================
// §4  ONE WRITER OF THE STATE
// =============================================================================
//
// _vel_state, _vel_layers and _vel_atlas are written only by helpers
// in this module. tools/build.sh confines relocations against each to
// `core/semterm/gui_vello.o`.
//
// STATE LAYOUT -- _vel_state : [u64; 8]
//   +0    init_mark        0x7E10 once vel_reset has run
//   +8    err              sticky error latch (first-writer-wins)
//   +16   subpx_mode       0 | 1 (starts at VEL_SUBPX_RGB)
//   +24   atlas_count      0..256 (bump allocator)
//   +32   frames_submitted running total across vel_submit_frame
//   +40   result_pending   0 | 1 (must be 1 for submit_frame)
//   +48   result_rows      row count staged by vel_route_result
//   +56   layers_composed  running total of visible-layer counts
//
// LAYERS LAYOUT -- _vel_layers : [u64; 16] = 4 * 4 words
//   layer(i) = _vel_layers[i * 4 .. i * 4 + 3]
//     +0  visible        0 | 1
//     +8  opacity        0..VEL_OPACITY_MAX
//     +16 z_order        baked at reset
//     +24 reserved       0
//
// ATLAS LAYOUT -- _vel_atlas : [u64; 256]
//   _vel_atlas[i] = codepoint (0 = empty slot marker)
//
// =============================================================================
// §5  FAILURE TAXONOMY 0xFFFFEEA0..0xFFFFEEAF
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time. Adjacent used
// band above: gui_theme 0xFFFFEEB0..BF (R44.M1-003). Adjacent free
// band below: gui_charts 0xFFFFEE90..9F (R44.M2-002).
//
//   VEL_OK              = 0
//   VEL_ERR_NOT_INIT    = 0xFFFFEEAF   accessor before vel_reset
//   VEL_ERR_BAD_LAYER   = 0xFFFFEEAE   id >= VEL_LAYER_MAX
//   VEL_ERR_BAD_OPACITY = 0xFFFFEEAD   opacity > VEL_OPACITY_MAX
//   VEL_ERR_BAD_SUBPX   = 0xFFFFEEAC   mode > VEL_SUBPX_MAX
//   VEL_ERR_ATLAS_FULL  = 0xFFFFEEAB   add_glyph when atlas_count == 256
//   VEL_ERR_BAD_ATLAS   = 0xFFFFEEAA   glyph_at index >= atlas_count
//   VEL_ERR_BAD_GLYPH   = 0xFFFFEEA9   add_glyph with codepoint == 0
//   VEL_ERR_NO_RESULT   = 0xFFFFEEA8   submit_frame without route_result
//   VEL_ERR_INTERNAL    = 0xFFFFEEA7   unreachable-fallthrough tripwire
//
// =============================================================================
// §6  ARITY DISCIPLINE
// =============================================================================
//
// vel_layer_show is (id, flag). vel_layer_set_opacity is (id, opacity).
// vel_subpx_set is (mode). vel_atlas_add_glyph is (codepoint).
// vel_atlas_glyph_at is (index). vel_route_result is (row_count).
// vel_submit_frame is (). Every readback is (). A widening (an
// alpha-per-glyph override, a per-layer blend mode, a scissor rect)
// is a widening of these arities and the tools/build.sh pin locks
// the signatures so a hidden coordinate cannot slip in.

module GuiVello = structure {

  // Layer enum (§1).
  pub let VEL_LAYER_BACKGROUND : u64 = 0
  pub let VEL_LAYER_TEXT_BG    : u64 = 1
  pub let VEL_LAYER_TEXT_FG    : u64 = 2
  pub let VEL_LAYER_SELECTION  : u64 = 3
  pub let VEL_LAYER_MAX        : u64 = 4

  // Opacity bounds (§1).
  pub let VEL_OPACITY_MAX     : u64 = 1000
  pub let VEL_OPACITY_DEFAULT : u64 = 1000
  pub let VEL_OPACITY_HALF    : u64 = 500

  // Sub-pixel mode enum (§3).
  pub let VEL_SUBPX_NONE : u64 = 0
  pub let VEL_SUBPX_RGB  : u64 = 1
  pub let VEL_SUBPX_MAX  : u64 = 1

  // Glyph atlas size (§2).
  pub let VEL_ATLAS_MAX_GLYPHS : u64 = 256

  // Failure taxonomy (§5).
  pub let VEL_OK              : u64 = 0
  pub let VEL_ERR_NOT_INIT    : u64 = 0xFFFFEEAF
  pub let VEL_ERR_BAD_LAYER   : u64 = 0xFFFFEEAE
  pub let VEL_ERR_BAD_OPACITY : u64 = 0xFFFFEEAD
  pub let VEL_ERR_BAD_SUBPX   : u64 = 0xFFFFEEAC
  pub let VEL_ERR_ATLAS_FULL  : u64 = 0xFFFFEEAB
  pub let VEL_ERR_BAD_ATLAS   : u64 = 0xFFFFEEAA
  pub let VEL_ERR_BAD_GLYPH   : u64 = 0xFFFFEEA9
  pub let VEL_ERR_NO_RESULT   : u64 = 0xFFFFEEA8
  pub let VEL_ERR_INTERNAL    : u64 = 0xFFFFEEA7

  pub let VEL_INIT_MARK : u64 = 0x7E10

  pub let mut _vel_state  : [u64; 8]   = uninit @align(64)
  pub let mut _vel_layers : [u64; 16]  = uninit @align(64)
  pub let mut _vel_atlas  : [u64; 256] = uninit @align(64)

  // ==========================================================================
  // Reset. Boot + teardown. Installs the four named layers with the
  // documented defaults (BACKGROUND / TEXT_BG / TEXT_FG visible @ full
  // opacity; SELECTION hidden @ half opacity), the RGB subpixel mode,
  // and a cleared atlas.
  // ==========================================================================

  pub let vel_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M2-001 (#1403): clear state + layers + atlas, install init_mark + subpx=RGB + layer defaults (bg/tbg/tfg opaque visible, sel translucent hidden). Labels prefixed vel_rst_.",
      block: {
        lea r10, [rip + _vel_atlas];
        xor rax, rax;
        xor rcx, rcx;
      vel_rst_at:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 256;
        jb  vel_rst_at;

        lea r10, [rip + _vel_layers];
        xor rcx, rcx;
      vel_rst_lz:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 16;
        jb  vel_rst_lz;

        lea r10, [rip + _vel_state];
        xor rcx, rcx;
      vel_rst_st:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  vel_rst_st;

        mov rax, 0x7E10;
        mov [r10 + 0], rax;                     // init_mark
        mov rax, 1;
        mov [r10 + 16], rax;                    // subpx_mode = RGB

        // Layer 0 BACKGROUND: visible=1, opacity=1000, z=0.
        lea r10, [rip + _vel_layers];
        mov rax, 1;
        mov [r10 + 0], rax;
        mov rax, 1000;
        mov [r10 + 8], rax;
        xor rax, rax;
        mov [r10 + 16], rax;
        // Layer 1 TEXT_BG: visible=1, opacity=1000, z=1. Base offset 32.
        mov rax, 1;
        mov [r10 + 32], rax;
        mov rax, 1000;
        mov [r10 + 40], rax;
        mov rax, 1;
        mov [r10 + 48], rax;
        // Layer 2 TEXT_FG: visible=1, opacity=1000, z=2. Base offset 64.
        mov rax, 1;
        mov [r10 + 64], rax;
        mov rax, 1000;
        mov [r10 + 72], rax;
        mov rax, 2;
        mov [r10 + 80], rax;
        // Layer 3 SELECTION: visible=0, opacity=500, z=3. Base offset 96.
        xor rax, rax;
        mov [r10 + 96], rax;
        mov rax, 500;
        mov [r10 + 104], rax;
        mov rax, 3;
        mov [r10 + 112], rax;

        ret
      }
    }

  pub let vel_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R44.M2-001 (#1403): honesty pin. Returns 0 until a live R37 GPU backend paints and a live R41 resultset writer routes rows.",
      block: {
        xor rax, rax;
        ret
      }
    }

  pub let vel_err : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M2-001 (#1403): sticky error latch readback.",
      block: {
        lea r10, [rip + _vel_state];
        mov rax, [r10 + 8];
        ret
      }
    }

  pub let vel_bound : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M2-001 (#1403): 1 iff init_mark matches. Labels prefixed vel_bnd_.",
      block: {
        lea r10, [rip + _vel_state];
        mov rax, [r10 + 0];
        mov r11, 0x7E10;
        cmp rax, r11;
        jne vel_bnd_no;
        mov rax, 1;
        ret;
      vel_bnd_no:
        xor rax, rax;
        ret
      }
    }

  pub let vel_set_err : (u64) -> () !{mem} @{} =
    fn (code: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M2-001 (#1403): first-writer-wins error latch. Labels prefixed vel_se_.",
      block: {
        lea r10, [rip + _vel_state];
        mov rax, [r10 + 8];
        cmp rax, 0;
        jne vel_se_out;
        mov [r10 + 8], rdi;
      vel_se_out:
        ret
      }
    }

  // ==========================================================================
  // Simple readbacks.
  // ==========================================================================

  pub let vel_subpx_get : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M2-001 (#1403): subpx_mode field.",
      block: {
        lea r10, [rip + _vel_state];
        mov rax, [r10 + 16];
        ret
      }
    }

  pub let vel_atlas_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M2-001 (#1403): atlas_count field.",
      block: {
        lea r10, [rip + _vel_state];
        mov rax, [r10 + 24];
        ret
      }
    }

  pub let vel_frames_submitted : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M2-001 (#1403): frames_submitted running total.",
      block: {
        lea r10, [rip + _vel_state];
        mov rax, [r10 + 32];
        ret
      }
    }

  pub let vel_result_pending : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M2-001 (#1403): result_pending field.",
      block: {
        lea r10, [rip + _vel_state];
        mov rax, [r10 + 40];
        ret
      }
    }

  pub let vel_result_rows : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M2-001 (#1403): result_rows staged by vel_route_result.",
      block: {
        lea r10, [rip + _vel_state];
        mov rax, [r10 + 48];
        ret
      }
    }

  pub let vel_layers_composed : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M2-001 (#1403): layers_composed running total.",
      block: {
        lea r10, [rip + _vel_state];
        mov rax, [r10 + 56];
        ret
      }
    }

  // ==========================================================================
  // vel_layer_visible(id) / vel_layer_show(id, flag)
  //
  // Refuses id >= VEL_LAYER_MAX. flag is coerced to 0 or 1.
  // ==========================================================================

  pub let vel_layer_visible : (u64) -> u64 !{mem} @{} =
    fn (id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M2-001 (#1403): read visible field of one layer. Labels prefixed vel_lv_.",
      block: {
        cmp rdi, 4;
        jae vel_lv_bl;

        mov rax, rdi;
        shl rax, 2;                              // rax = id * 4 (words)
        lea r10, [rip + _vel_layers];
        mov rax, [r10 + rax * 8];
        ret;

      vel_lv_bl:
        mov rdi, 0xFFFFEEAE;
        call vel_set_err;
        xor rax, rax;
        ret
      }
    }

  pub let vel_layer_show : (u64, u64) -> u64 !{mem} @{} =
    fn (id: u64, flag: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M2-001 (#1403): toggle layer visibility. Labels prefixed vel_ls_.",
      block: {
        lea r10, [rip + _vel_state];
        mov rax, [r10 + 0];
        mov r11, 0x7E10;
        cmp rax, r11;
        jne vel_ls_ni;

        cmp rdi, 4;
        jae vel_ls_bl;

        // Coerce flag to 0/1.
        cmp rsi, 0;
        je  vel_ls_store;
        mov rsi, 1;
      vel_ls_store:

        mov rax, rdi;
        shl rax, 2;                              // id * 4 words
        lea r10, [rip + _vel_layers];
        mov [r10 + rax * 8], rsi;                // visible field at +0

        xor rax, rax;
        ret;

      vel_ls_ni:
        mov rdi, 0xFFFFEEAF;
        call vel_set_err;
        mov rax, 0xFFFFEEAF;
        ret;
      vel_ls_bl:
        mov rdi, 0xFFFFEEAE;
        call vel_set_err;
        mov rax, 0xFFFFEEAE;
        ret
      }
    }

  // ==========================================================================
  // vel_layer_opacity(id) / vel_layer_set_opacity(id, opacity)
  //
  // opacity in [0, VEL_OPACITY_MAX] = [0, 1000]. Refuses > 1000.
  // ==========================================================================

  pub let vel_layer_opacity : (u64) -> u64 !{mem} @{} =
    fn (id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M2-001 (#1403): read opacity field of one layer. Labels prefixed vel_lo_.",
      block: {
        cmp rdi, 4;
        jae vel_lo_bl;

        mov rax, rdi;
        shl rax, 2;
        add rax, 1;                              // opacity field at +8 = +1 word
        lea r10, [rip + _vel_layers];
        mov rax, [r10 + rax * 8];
        ret;

      vel_lo_bl:
        mov rdi, 0xFFFFEEAE;
        call vel_set_err;
        xor rax, rax;
        ret
      }
    }

  pub let vel_layer_set_opacity : (u64, u64) -> u64 !{mem} @{} =
    fn (id: u64, opacity: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M2-001 (#1403): store opacity after bounds. Labels prefixed vel_lso_.",
      block: {
        lea r10, [rip + _vel_state];
        mov rax, [r10 + 0];
        mov r11, 0x7E10;
        cmp rax, r11;
        jne vel_lso_ni;

        cmp rdi, 4;
        jae vel_lso_bl;

        cmp rsi, 1000;
        ja  vel_lso_bo;

        mov rax, rdi;
        shl rax, 2;
        add rax, 1;                              // opacity field
        lea r10, [rip + _vel_layers];
        mov [r10 + rax * 8], rsi;

        xor rax, rax;
        ret;

      vel_lso_ni:
        mov rdi, 0xFFFFEEAF;
        call vel_set_err;
        mov rax, 0xFFFFEEAF;
        ret;
      vel_lso_bl:
        mov rdi, 0xFFFFEEAE;
        call vel_set_err;
        mov rax, 0xFFFFEEAE;
        ret;
      vel_lso_bo:
        mov rdi, 0xFFFFEEAD;
        call vel_set_err;
        mov rax, 0xFFFFEEAD;
        ret
      }
    }

  pub let vel_layer_zorder : (u64) -> u64 !{mem} @{} =
    fn (id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M2-001 (#1403): read z_order field of one layer. Labels prefixed vel_lz_.",
      block: {
        cmp rdi, 4;
        jae vel_lz_bl;

        mov rax, rdi;
        shl rax, 2;
        add rax, 2;                              // z_order field at +16 = +2 words
        lea r10, [rip + _vel_layers];
        mov rax, [r10 + rax * 8];
        ret;

      vel_lz_bl:
        mov rdi, 0xFFFFEEAE;
        call vel_set_err;
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // vel_subpx_set(mode) -> u64
  //
  // Refuses not init or mode > VEL_SUBPX_MAX.
  // ==========================================================================

  pub let vel_subpx_set : (u64) -> u64 !{mem} @{} =
    fn (mode: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M2-001 (#1403): store subpx_mode after enum check. Labels prefixed vel_sx_.",
      block: {
        lea r10, [rip + _vel_state];
        mov rax, [r10 + 0];
        mov r11, 0x7E10;
        cmp rax, r11;
        jne vel_sx_ni;

        cmp rdi, 1;
        ja  vel_sx_bm;

        mov [r10 + 16], rdi;
        xor rax, rax;
        ret;

      vel_sx_ni:
        mov rdi, 0xFFFFEEAF;
        call vel_set_err;
        mov rax, 0xFFFFEEAF;
        ret;
      vel_sx_bm:
        mov rdi, 0xFFFFEEAC;
        call vel_set_err;
        mov rax, 0xFFFFEEAC;
        ret
      }
    }

  // ==========================================================================
  // vel_atlas_reset() -> u64
  //
  // Zero the atlas storage and atlas_count. Refuses not init.
  // ==========================================================================

  pub let vel_atlas_reset : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M2-001 (#1403): clear atlas + atlas_count. Labels prefixed vel_ar_.",
      block: {
        lea r10, [rip + _vel_state];
        mov rax, [r10 + 0];
        mov r11, 0x7E10;
        cmp rax, r11;
        jne vel_ar_ni;

        lea r10, [rip + _vel_atlas];
        xor rax, rax;
        xor rcx, rcx;
      vel_ar_lz:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 256;
        jb  vel_ar_lz;

        lea r10, [rip + _vel_state];
        xor rax, rax;
        mov [r10 + 24], rax;                     // atlas_count = 0
        ret;

      vel_ar_ni:
        mov rdi, 0xFFFFEEAF;
        call vel_set_err;
        mov rax, 0xFFFFEEAF;
        ret
      }
    }

  // ==========================================================================
  // vel_atlas_add_glyph(codepoint) -> u64
  //
  // Append codepoint to the atlas and return its index. Refuses not
  // init, codepoint == 0, or atlas full.
  // ==========================================================================

  pub let vel_atlas_add_glyph : (u64) -> u64 !{mem} @{} =
    fn (codepoint: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M2-001 (#1403): bump-allocate a glyph slot. Labels prefixed vel_ag_.",
      block: {
        lea r10, [rip + _vel_state];
        mov rax, [r10 + 0];
        mov r11, 0x7E10;
        cmp rax, r11;
        jne vel_ag_ni;

        cmp rdi, 0;
        je  vel_ag_bg;

        mov rax, [r10 + 24];                     // atlas_count
        cmp rax, 256;
        jae vel_ag_af;

        // Store glyph at atlas[atlas_count].
        lea r11, [rip + _vel_atlas];
        mov [r11 + rax * 8], rdi;

        // Bump count.
        mov rcx, rax;
        add rcx, 1;
        mov [r10 + 24], rcx;

        ret;                                     // return old atlas_count as index

      vel_ag_ni:
        mov rdi, 0xFFFFEEAF;
        call vel_set_err;
        mov rax, 0xFFFFEEAF;
        ret;
      vel_ag_bg:
        mov rdi, 0xFFFFEEA9;
        call vel_set_err;
        mov rax, 0xFFFFEEA9;
        ret;
      vel_ag_af:
        mov rdi, 0xFFFFEEAB;
        call vel_set_err;
        mov rax, 0xFFFFEEAB;
        ret
      }
    }

  // ==========================================================================
  // vel_atlas_glyph_at(index) -> u64
  //
  // Read the codepoint stored at atlas[index]. Refuses index >= atlas_count.
  // ==========================================================================

  pub let vel_atlas_glyph_at : (u64) -> u64 !{mem} @{} =
    fn (index: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M2-001 (#1403): read atlas entry by index. Labels prefixed vel_ax_.",
      block: {
        lea r10, [rip + _vel_state];
        mov rax, [r10 + 24];                     // atlas_count
        cmp rdi, rax;
        jae vel_ax_bx;

        lea r10, [rip + _vel_atlas];
        mov rax, [r10 + rdi * 8];
        ret;

      vel_ax_bx:
        mov rdi, 0xFFFFEEAA;
        call vel_set_err;
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // vel_route_result(row_count) -> u64
  //
  // Stage a resultset row count for the next submit. Sets result_pending
  // and stores row_count. Refuses not init. A repeated route before
  // submit OVERWRITES the previous stage (the last routed value wins);
  // this is deliberate -- the resultset is the authority, and mid-flight
  // updates arrive before the frame flush.
  // ==========================================================================

  pub let vel_route_result : (u64) -> u64 !{mem} @{} =
    fn (row_count: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M2-001 (#1403): park result_pending + result_rows. Labels prefixed vel_rr_.",
      block: {
        lea r10, [rip + _vel_state];
        mov rax, [r10 + 0];
        mov r11, 0x7E10;
        cmp rax, r11;
        jne vel_rr_ni;

        mov rax, 1;
        mov [r10 + 40], rax;                     // result_pending = 1
        mov [r10 + 48], rdi;                     // result_rows

        xor rax, rax;
        ret;

      vel_rr_ni:
        mov rdi, 0xFFFFEEAF;
        call vel_set_err;
        mov rax, 0xFFFFEEAF;
        ret
      }
    }

  // ==========================================================================
  // vel_submit_frame() -> u64
  //
  // Compose the four layers (count visible ones into layers_composed),
  // bump frames_submitted, clear result_pending. Refuses not init or
  // no pending result.
  // ==========================================================================

  pub let vel_submit_frame : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M2-001 (#1403): compose layers + flush frame counter. Labels prefixed vel_sf_.",
      block: {
        lea r10, [rip + _vel_state];
        mov rax, [r10 + 0];
        mov r11, 0x7E10;
        cmp rax, r11;
        jne vel_sf_ni;

        mov rax, [r10 + 40];                     // result_pending
        cmp rax, 0;
        je  vel_sf_nr;

        // Walk four layers, sum visible flags.
        lea r11, [rip + _vel_layers];
        xor rcx, rcx;                            // i
        xor r8,  r8;                             // visible sum
      vel_sf_loop:
        mov rax, rcx;
        shl rax, 2;                              // i * 4 words
        mov rdx, [r11 + rax * 8];                // visible field
        add r8, rdx;
        add rcx, 1;
        cmp rcx, 4;
        jb  vel_sf_loop;

        // layers_composed += visible sum.
        mov rax, [r10 + 56];
        add rax, r8;
        mov [r10 + 56], rax;

        // frames_submitted += 1.
        mov rax, [r10 + 32];
        add rax, 1;
        mov [r10 + 32], rax;

        // Clear pending.
        xor rax, rax;
        mov [r10 + 40], rax;

        xor rax, rax;
        ret;

      vel_sf_ni:
        mov rdi, 0xFFFFEEAF;
        call vel_set_err;
        mov rax, 0xFFFFEEAF;
        ret;
      vel_sf_nr:
        mov rdi, 0xFFFFEEA8;
        call vel_set_err;
        mov rax, 0xFFFFEEA8;
        ret
      }
    }
}
