// src/kernel/core/semterm/gui_layout.pdx -- R44.M1-002 (#1401)
//
// SEMTERM GUI LAYOUT. Tab + split-pane arithmetic for the R44 GUI
// shell (semterm/gui_shell.pdx). Owns a fixed pool of up to 8 tabs
// and 16 panes; each tab points at a pane subtree, each pane is
// either a LEAF (holding a session-hash) or a SPLIT (holding an
// orientation + two child pane ids). Focus is a single pane index.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the LAYOUT SEAM behind the shell's query-editor / results
// regions: each tab hosts an independent semterm session, and each
// tab's canvas is a binary tree of splits terminating in LEAF panes.
// gly_reset zeroes state; gly_tab_new(title_hash) allocates a tab
// with a single LEAF root; gly_pane_split(pane_id, orientation)
// replaces a LEAF with a SPLIT whose second child is a fresh LEAF;
// gly_focus_set(pane_id) parks focus at a LEAF; gly_focus_next()
// cycles focus across LEAF panes in the active tab.
//
// It does NOT allocate memory from the kernel heap. It does NOT
// render splits. It does NOT drive session lifecycle -- session_hash
// is opaque, minted by whatever a later round hooks in through
// gly_tab_new. It does NOT compute pixel geometry; the shell's
// region rectangles (gsh_region_set) constrain the drawable area and
// a downstream layout engine derives per-pane rectangles from the
// tree shape.
//
// It is a SCAFFOLD (D7): R44.M1 wires it into the witness tree but
// no live shell instantiates tabs from user actions;
// gly_arbitrated() returns 0 until a later round hooks the shell's
// input into gly_tab_new / gly_pane_split.
//
// =============================================================================
// §1  POOLS AND KIND ENCODING
// =============================================================================
//
// GLY_TAB_MAX  = 8
// GLY_PANE_MAX = 16
//
// Pane kinds:
//   GLY_KIND_UNUSED = 0    slot is free
//   GLY_KIND_LEAF   = 1    session_hash lives in the second word
//   GLY_KIND_SPLIT  = 2    (orientation, child_a, child_b) live in words 1..3
//
// Split orientations:
//   GLY_ORIENT_H = 0       horizontal split (rows), children stacked
//   GLY_ORIENT_V = 1       vertical split (cols), children side by side
//
// The pane pool is a bump allocator: gly_pane_split reserves the next
// free slot for the fresh LEAF and never releases; a widening
// (destructive close, snapshot compaction) is a widening of this and
// rewrites _gsh_state's pane_alloc_next accounting in one place.
//
// =============================================================================
// §2  ONE WRITER OF THE STATE
// =============================================================================
//
// _gly_state, _gly_tabs and _gly_panes are written only by helpers
// in this module. tools/build.sh confines relocations against each
// to `core/semterm/gui_layout.o`.
//
// STATE LAYOUT -- _gly_state : [u64; 8]
//   +0    init_mark        0x7AB5 once gly_reset has run
//   +8    err              sticky error latch
//   +16   tab_count        number of in-use tab slots (0..GLY_TAB_MAX)
//   +24   active_tab       index of the active tab (valid iff tab_count > 0)
//   +32   focus_pane       index of the focused pane (valid iff tab_count > 0)
//   +40   pane_alloc_next  next pane slot the bump allocator hands out
//   +48   reserved         0
//   +56   reserved         0
//
// TABS LAYOUT -- _gly_tabs : [u64; 8 * 3] = 24 words
//   tab(i) = _gly_tabs[i * 3 .. i * 3 + 2]
//     +0  title_hash        opaque session name key
//     +8  root_pane         pane index of the tab's canvas
//     +16 in_use            0 | 1
//
// PANES LAYOUT -- _gly_panes : [u64; 16 * 4] = 64 words
//   pane(i) = _gly_panes[i * 4 .. i * 4 + 3]
//     +0  kind              UNUSED | LEAF | SPLIT
//     +8  session_hash      (if LEAF) OR orientation (if SPLIT)
//     +16 child_a           (if SPLIT)
//     +24 child_b           (if SPLIT)
//
// =============================================================================
// §3  FAILURE TAXONOMY 0xFFFFEEC0..0xFFFFEECF
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time. Adjacent used
// band above: gui_shell 0xFFFFEED0..DF (R44.M1-001). Adjacent free
// band below: gui_theme 0xFFFFEEB0..BF (R44.M1-003).
//
//   GLY_OK             = 0
//   GLY_ERR_NOT_INIT   = 0xFFFFEECF   accessor before gly_reset
//   GLY_ERR_TABS_FULL  = 0xFFFFEECE   tab_new when tab_count == GLY_TAB_MAX
//   GLY_ERR_BAD_TAB    = 0xFFFFEECD   tab_id >= GLY_TAB_MAX or not in use
//   GLY_ERR_NO_TABS    = 0xFFFFEECC   focus/active op before first tab
//   GLY_ERR_PANES_FULL = 0xFFFFEECB   pane_split when pool exhausted
//   GLY_ERR_BAD_PANE   = 0xFFFFEECA   pane_id >= pane_alloc_next
//   GLY_ERR_NOT_LEAF   = 0xFFFFEEC9   pane_split target not a LEAF
//   GLY_ERR_BAD_ORIENT = 0xFFFFEEC8   orientation outside {0, 1}
//   GLY_ERR_INTERNAL   = 0xFFFFEEC7   unreachable-fallthrough tripwire
//
// =============================================================================
// §4  ARITY DISCIPLINE
// =============================================================================
//
// gly_tab_new is (title_hash) -> u64 (new tab id).
// gly_tab_active_set is (tab_id). gly_pane_split is (pane_id, orient) ->
// u64 (new leaf pane id). gly_focus_set is (pane_id). Every readback is
// (). A widening (destructive close, per-tab focus, nested pane close)
// is a widening of these arities.

module GuiLayout = structure {

  // Pool sizes (§1).
  pub let GLY_TAB_MAX  : u64 = 8
  pub let GLY_PANE_MAX : u64 = 16

  // Pane kinds (§1).
  pub let GLY_KIND_UNUSED : u64 = 0
  pub let GLY_KIND_LEAF   : u64 = 1
  pub let GLY_KIND_SPLIT  : u64 = 2

  // Split orientations (§1).
  pub let GLY_ORIENT_H : u64 = 0
  pub let GLY_ORIENT_V : u64 = 1

  // Failure taxonomy (§3).
  pub let GLY_OK             : u64 = 0
  pub let GLY_ERR_NOT_INIT   : u64 = 0xFFFFEECF
  pub let GLY_ERR_TABS_FULL  : u64 = 0xFFFFEECE
  pub let GLY_ERR_BAD_TAB    : u64 = 0xFFFFEECD
  pub let GLY_ERR_NO_TABS    : u64 = 0xFFFFEECC
  pub let GLY_ERR_PANES_FULL : u64 = 0xFFFFEECB
  pub let GLY_ERR_BAD_PANE   : u64 = 0xFFFFEECA
  pub let GLY_ERR_NOT_LEAF   : u64 = 0xFFFFEEC9
  pub let GLY_ERR_BAD_ORIENT : u64 = 0xFFFFEEC8
  pub let GLY_ERR_INTERNAL   : u64 = 0xFFFFEEC7

  pub let GLY_INIT_MARK : u64 = 0x7AB5

  pub let mut _gly_state : [u64; 8]  = uninit @align(64)
  pub let mut _gly_tabs  : [u64; 24] = uninit @align(64)
  pub let mut _gly_panes : [u64; 64] = uninit @align(64)

  // ==========================================================================
  // Reset. Boot + teardown.
  // ==========================================================================

  pub let gly_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M1-002 (#1401): clear state + tabs + panes, install init_mark. Labels prefixed gly_rst_.",
      block: {
        lea r10, [rip + _gly_panes];
        xor rax, rax;
        xor rcx, rcx;
      gly_rst_pn:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 64;
        jb  gly_rst_pn;

        lea r10, [rip + _gly_tabs];
        xor rcx, rcx;
      gly_rst_tb:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 24;
        jb  gly_rst_tb;

        lea r10, [rip + _gly_state];
        xor rcx, rcx;
      gly_rst_st:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  gly_rst_st;

        mov rax, 0x7AB5;
        mov [r10 + 0], rax;                      // init_mark
        ret
      }
    } @no_frame

  pub let gly_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R44.M1-002 (#1401): honesty pin. Returns 0 until a live shell drives gly_tab_new / gly_pane_split.",
      block: {
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let gly_err : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M1-002 (#1401): sticky error latch readback.",
      block: {
        lea r10, [rip + _gly_state];
        mov rax, [r10 + 8];
        ret
      }
    } @no_frame

  pub let gly_bound : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M1-002 (#1401): 1 iff init_mark matches. Labels prefixed gly_bnd_.",
      block: {
        lea r10, [rip + _gly_state];
        mov rax, [r10 + 0];
        mov r11, 0x7AB5;
        cmp rax, r11;
        jne gly_bnd_no;
        mov rax, 1;
        ret;
      gly_bnd_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let gly_set_err : (u64) -> () !{mem} @{} =
    fn (code: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M1-002 (#1401): first-writer-wins error latch. Labels prefixed gly_se_.",
      block: {
        lea r10, [rip + _gly_state];
        mov rax, [r10 + 8];
        cmp rax, 0;
        jne gly_se_out;
        mov [r10 + 8], rdi;
      gly_se_out:
        ret
      }
    } @no_frame

  pub let gly_tab_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M1-002 (#1401): tab_count field.",
      block: {
        lea r10, [rip + _gly_state];
        mov rax, [r10 + 16];
        ret
      }
    } @no_frame

  pub let gly_pane_alloc_next : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M1-002 (#1401): pane_alloc_next field.",
      block: {
        lea r10, [rip + _gly_state];
        mov rax, [r10 + 40];
        ret
      }
    } @no_frame

  // ==========================================================================
  // gly_tab_new(title_hash) -> u64
  //
  // Allocate a new tab and its root LEAF pane. Returns the new tab id
  // (0-based) on success. Refuses not init, tabs full, or panes full.
  // The first tab is made active and its root pane is focused; later
  // tabs do NOT change active/focus (a fresh tab is a background
  // creation until an explicit tab_active_set / focus_set).
  // ==========================================================================

  pub let gly_tab_new : (u64) -> u64 !{mem} @{} =
    fn (title_hash: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M1-002 (#1401): allocate tab + root leaf. Labels prefixed gly_tn_.",
      block: {
        lea r10, [rip + _gly_state];
        mov rax, [r10 + 0];
        mov r11, 0x7AB5;
        cmp rax, r11;
        jne gly_tn_ni;

        mov rax, [r10 + 16];                     // tab_count
        cmp rax, 8;
        jae gly_tn_tf;

        mov rcx, [r10 + 40];                     // pane_alloc_next
        cmp rcx, 16;
        jae gly_tn_pf;

        // Reserve pane slot: kind = LEAF, session_hash = title_hash.
        mov r8, rcx;
        mov r9, 4;
        mov r11, rcx;                            // save pane_alloc_next
        mov rax, r8;
        imul rax, r9;                            // rax = pane_idx * 4
        lea r9, [rip + _gly_panes];
        lea r9, [r9 + rax * 8];                  // r9 = &panes[pane_idx]
        mov rax, 1;
        mov [r9 + 0], rax;                       // kind = LEAF
        mov [r9 + 8], rdi;                       // session_hash = title_hash
        xor rax, rax;
        mov [r9 + 16], rax;
        mov [r9 + 24], rax;

        // Bump pane_alloc_next.
        mov rax, r11;
        add rax, 1;
        mov [r10 + 40], rax;

        // Reserve tab slot.
        mov rax, [r10 + 16];                     // tab_count
        mov r9, 3;
        mov rcx, rax;                            // save tab_id
        push rcx;
        imul rax, r9;                            // rax = tab_id * 3
        lea r9, [rip + _gly_tabs];
        lea r9, [r9 + rax * 8];
        mov [r9 + 0], rdi;                       // title_hash
        mov [r9 + 8], r11;                       // root_pane = allocated pane
        mov rax, 1;
        mov [r9 + 16], rax;                      // in_use

        // Bump tab_count.
        pop rcx;                                 // tab_id
        mov rax, rcx;
        add rax, 1;
        mov [r10 + 16], rax;

        // First tab: make active + focused on its root.
        cmp rcx, 0;
        jne gly_tn_ret;
        xor rax, rax;
        mov [r10 + 24], rax;                     // active_tab = 0
        mov [r10 + 32], r11;                     // focus_pane = root

      gly_tn_ret:
        mov rax, rcx;                            // return tab_id
        ret;

      gly_tn_ni:
        mov rdi, 0xFFFFEECF;
        call gly_set_err;
        mov rax, 0xFFFFEECF;
        ret;
      gly_tn_tf:
        mov rdi, 0xFFFFEECE;
        call gly_set_err;
        mov rax, 0xFFFFEECE;
        ret;
      gly_tn_pf:
        mov rdi, 0xFFFFEECB;
        call gly_set_err;
        mov rax, 0xFFFFEECB;
        ret
      }
    }

  // ==========================================================================
  // gly_tab_active_get() -> u64
  // gly_tab_active_set(tab_id) -> u64
  //
  // active_tab is only meaningful when tab_count > 0. active_set
  // refuses NO_TABS or bad tab.
  // ==========================================================================

  pub let gly_tab_active_get : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M1-002 (#1401): active_tab field readback (unchecked; witness verifies via tab_count).",
      block: {
        lea r10, [rip + _gly_state];
        mov rax, [r10 + 24];
        ret
      }
    } @no_frame

  pub let gly_tab_active_set : (u64) -> u64 !{mem} @{} =
    fn (tab_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M1-002 (#1401): update active_tab after bounds. Labels prefixed gly_tas_.",
      block: {
        lea r10, [rip + _gly_state];
        mov rax, [r10 + 0];
        mov r11, 0x7AB5;
        cmp rax, r11;
        jne gly_tas_ni;

        mov rax, [r10 + 16];                     // tab_count
        cmp rax, 0;
        je  gly_tas_nt;
        cmp rdi, rax;
        jae gly_tas_bt;

        mov [r10 + 24], rdi;                     // active_tab = tab_id
        xor rax, rax;
        ret;

      gly_tas_ni:
        mov rdi, 0xFFFFEECF;
        call gly_set_err;
        mov rax, 0xFFFFEECF;
        ret;
      gly_tas_nt:
        mov rdi, 0xFFFFEECC;
        call gly_set_err;
        mov rax, 0xFFFFEECC;
        ret;
      gly_tas_bt:
        mov rdi, 0xFFFFEECD;
        call gly_set_err;
        mov rax, 0xFFFFEECD;
        ret
      }
    }

  // ==========================================================================
  // gly_pane_kind(pane_id) -> u64
  // gly_pane_field(pane_id, field) -> u64
  //
  // field: 0=kind, 1=session_hash/orient, 2=child_a, 3=child_b.
  // Refuses pane_id >= pane_alloc_next.
  // ==========================================================================

  pub let gly_pane_kind : (u64) -> u64 !{mem} @{} =
    fn (pane_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M1-002 (#1401): read kind field of one pane. Labels prefixed gly_pk_.",
      block: {
        lea r10, [rip + _gly_state];
        mov rax, [r10 + 40];                     // pane_alloc_next
        cmp rdi, rax;
        jae gly_pk_bp;

        mov rax, rdi;
        mov r11, 4;
        imul rax, r11;
        lea r10, [rip + _gly_panes];
        mov rax, [r10 + rax * 8];
        ret;

      gly_pk_bp:
        mov rdi, 0xFFFFEECA;
        call gly_set_err;
        xor rax, rax;
        ret
      }
    }

  pub let gly_pane_field : (u64, u64) -> u64 !{mem} @{} =
    fn (pane_id: u64, field: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M1-002 (#1401): read one field of one pane. Labels prefixed gly_pf_.",
      block: {
        lea r10, [rip + _gly_state];
        mov rax, [r10 + 40];
        cmp rdi, rax;
        jae gly_pf_bp;
        cmp rsi, 3;
        ja  gly_pf_bf;

        mov rax, rdi;
        mov r11, 4;
        imul rax, r11;
        add rax, rsi;
        lea r10, [rip + _gly_panes];
        mov rax, [r10 + rax * 8];
        ret;

      gly_pf_bp:
        mov rdi, 0xFFFFEECA;
        call gly_set_err;
        xor rax, rax;
        ret;
      gly_pf_bf:
        mov rdi, 0xFFFFEEC7;
        call gly_set_err;
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // gly_pane_split(pane_id, orient) -> u64
  //
  // Replace the LEAF at pane_id with a SPLIT whose child_a is a fresh
  // LEAF (session_hash cloned from the old LEAF) and child_b is a
  // second fresh LEAF (session_hash = 0). Returns the new child_b's
  // pane id on success -- callers focus on the new pane immediately.
  //
  // Refuses not init, bad pane, non-leaf pane, bad orient, or panes
  // full (need 2 fresh slots).
  // ==========================================================================

  pub let gly_pane_split : (u64, u64) -> u64 !{mem} @{} =
    fn (pane_id: u64, orient: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M1-002 (#1401): promote LEAF to SPLIT + spawn two fresh LEAFs. Labels prefixed gly_ps_.",
      block: {
        lea r10, [rip + _gly_state];
        mov rax, [r10 + 0];
        mov r11, 0x7AB5;
        cmp rax, r11;
        jne gly_ps_ni;

        mov rax, [r10 + 40];                     // pane_alloc_next
        cmp rdi, rax;
        jae gly_ps_bp;

        cmp rsi, 1;
        ja  gly_ps_bo;

        // Need 2 fresh slots.
        mov rcx, rax;
        add rcx, 2;
        cmp rcx, 16;
        ja  gly_ps_pf;

        // Save inputs.
        push rdi;                                // pane_id
        push rsi;                                // orient
        push rax;                                // old pane_alloc_next

        // Load old pane's kind + session_hash.
        mov rax, rdi;
        mov r11, 4;
        imul rax, r11;                                 // rax = pane_id * 4
        lea r10, [rip + _gly_panes];
        lea r10, [r10 + rax * 8];                // r10 = &panes[pane_id]

        mov rax, [r10 + 0];
        cmp rax, 1;                              // LEAF?
        jne gly_ps_nl_clean;

        mov r8, [r10 + 8];                       // saved session_hash

        // Pop scratch (keep on stack via non-destructive move).
        // Actually retrieve alloc_next.
        pop rax;                                 // rax = alloc_next (old base)
        push rax;

        // Populate child_a at alloc_next.
        mov r11, 4;
        mov rcx, rax;                            // save index
        imul rax, r11;
        lea r9, [rip + _gly_panes];
        lea r9, [r9 + rax * 8];
        mov rax, 1;
        mov [r9 + 0], rax;                       // LEAF
        mov [r9 + 8], r8;                        // inherit session_hash
        xor rax, rax;
        mov [r9 + 16], rax;
        mov [r9 + 24], rax;
        mov r14, rcx;                            // r14 = child_a index

        // Populate child_b at alloc_next + 1.
        mov rax, r14;
        add rax, 1;
        mov r15, rax;                            // r15 = child_b index
        mov r11, 4;
        imul rax, r11;
        lea r9, [rip + _gly_panes];
        lea r9, [r9 + rax * 8];
        mov rax, 1;
        mov [r9 + 0], rax;                       // LEAF
        xor rax, rax;
        mov [r9 + 8], rax;                       // fresh session
        mov [r9 + 16], rax;
        mov [r9 + 24], rax;

        // Bump alloc_next by 2.
        lea r10, [rip + _gly_state];
        mov rax, [r10 + 40];
        add rax, 2;
        mov [r10 + 40], rax;

        // Promote pane_id to SPLIT.
        pop rax;                                 // discard old alloc_next
        pop rsi;                                 // orient
        pop rdi;                                 // pane_id

        mov rax, rdi;
        mov r11, 4;
        imul rax, r11;
        lea r10, [rip + _gly_panes];
        lea r10, [r10 + rax * 8];
        mov rax, 2;
        mov [r10 + 0], rax;                      // SPLIT
        mov [r10 + 8], rsi;                      // orientation
        mov [r10 + 16], r14;                     // child_a
        mov [r10 + 24], r15;                     // child_b

        mov rax, r15;                            // return child_b id
        ret;

      gly_ps_nl_clean:
        pop rax;
        pop rsi;
        pop rdi;
        mov rdi, 0xFFFFEEC9;
        call gly_set_err;
        mov rax, 0xFFFFEEC9;
        ret;
      gly_ps_ni:
        mov rdi, 0xFFFFEECF;
        call gly_set_err;
        mov rax, 0xFFFFEECF;
        ret;
      gly_ps_bp:
        mov rdi, 0xFFFFEECA;
        call gly_set_err;
        mov rax, 0xFFFFEECA;
        ret;
      gly_ps_bo:
        mov rdi, 0xFFFFEEC8;
        call gly_set_err;
        mov rax, 0xFFFFEEC8;
        ret;
      gly_ps_pf:
        mov rdi, 0xFFFFEECB;
        call gly_set_err;
        mov rax, 0xFFFFEECB;
        ret
      }
    }

  // ==========================================================================
  // gly_focus_get() / gly_focus_set(pane_id)
  //
  // Focus is a single pane index. focus_set refuses not init, no tabs,
  // bad pane, or a non-LEAF target (splits are structural, only leaves
  // can receive input events).
  // ==========================================================================

  pub let gly_focus_get : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M1-002 (#1401): focus_pane field readback.",
      block: {
        lea r10, [rip + _gly_state];
        mov rax, [r10 + 32];
        ret
      }
    } @no_frame

  pub let gly_focus_set : (u64) -> u64 !{mem} @{} =
    fn (pane_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M1-002 (#1401): park focus on a LEAF pane. Labels prefixed gly_fs_.",
      block: {
        lea r10, [rip + _gly_state];
        mov rax, [r10 + 0];
        mov r11, 0x7AB5;
        cmp rax, r11;
        jne gly_fs_ni;

        mov rax, [r10 + 16];                     // tab_count
        cmp rax, 0;
        je  gly_fs_nt;

        mov rax, [r10 + 40];                     // pane_alloc_next
        cmp rdi, rax;
        jae gly_fs_bp;

        // Kind must be LEAF.
        mov rax, rdi;
        mov r11, 4;
        imul rax, r11;
        lea r9, [rip + _gly_panes];
        mov rax, [r9 + rax * 8];
        cmp rax, 1;
        jne gly_fs_nl;

        mov [r10 + 32], rdi;                     // focus_pane = pane_id
        xor rax, rax;
        ret;

      gly_fs_ni:
        mov rdi, 0xFFFFEECF;
        call gly_set_err;
        mov rax, 0xFFFFEECF;
        ret;
      gly_fs_nt:
        mov rdi, 0xFFFFEECC;
        call gly_set_err;
        mov rax, 0xFFFFEECC;
        ret;
      gly_fs_bp:
        mov rdi, 0xFFFFEECA;
        call gly_set_err;
        mov rax, 0xFFFFEECA;
        ret;
      gly_fs_nl:
        mov rdi, 0xFFFFEEC9;
        call gly_set_err;
        mov rax, 0xFFFFEEC9;
        ret
      }
    }

  // ==========================================================================
  // gly_focus_next() -> u64
  //
  // Cycle focus_pane to the next LEAF pane in the pool (round-robin
  // across all allocated LEAFs). Refuses not init or no tabs.
  // Deliberately walks the full pool: cross-tab cycling is left to a
  // later widening that carries per-tab leaf lists; the R44.M1 shape
  // is a single flat sweep so a witness can prove wrap.
  // ==========================================================================

  pub let gly_focus_next : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M1-002 (#1401): sweep for the next LEAF after focus_pane. Labels prefixed gly_fn_.",
      block: {
        lea r10, [rip + _gly_state];
        mov rax, [r10 + 0];
        mov r11, 0x7AB5;
        cmp rax, r11;
        jne gly_fn_ni;

        mov rax, [r10 + 16];                     // tab_count
        cmp rax, 0;
        je  gly_fn_nt;

        mov r8, [r10 + 40];                      // alloc_next (upper bound)
        mov r9, [r10 + 32];                      // current focus_pane

        // Start at (focus_pane + 1) mod alloc_next.
        mov rax, r9;
        add rax, 1;
        cmp rax, r8;
        jb  gly_fn_scan;
        xor rax, rax;
      gly_fn_scan:
        // rax = candidate, r8 = alloc_next.
        // Loop at most alloc_next iterations; on LEAF, park + return 0.
        xor rcx, rcx;                            // iteration counter
      gly_fn_loop:
        mov r11, 4;
        mov r15, rax;                            // save candidate
        imul rax, r11;
        lea r14, [rip + _gly_panes];
        mov rdx, [r14 + rax * 8];                // kind
        cmp rdx, 1;                              // LEAF?
        je  gly_fn_park;
        mov rax, r15;
        add rax, 1;
        cmp rax, r8;
        jb  gly_fn_cont;
        xor rax, rax;
      gly_fn_cont:
        add rcx, 1;
        cmp rcx, r8;
        jb  gly_fn_loop;

        // No leaf found -- return the sticky NO_TABS since this can
        // only happen if every pane is a SPLIT (structurally impossible
        // in this pool, since gly_pane_split spawns two LEAFs per
        // promotion).
        mov rdi, 0xFFFFEEC7;
        call gly_set_err;
        mov rax, 0xFFFFEEC7;
        ret;

      gly_fn_park:
        mov [r10 + 32], r15;                     // focus_pane = candidate
        xor rax, rax;
        ret;

      gly_fn_ni:
        mov rdi, 0xFFFFEECF;
        call gly_set_err;
        mov rax, 0xFFFFEECF;
        ret;
      gly_fn_nt:
        mov rdi, 0xFFFFEECC;
        call gly_set_err;
        mov rax, 0xFFFFEECC;
        ret
      }
    }
}
