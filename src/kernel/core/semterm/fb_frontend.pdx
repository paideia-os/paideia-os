// src/kernel/core/semterm/fb_frontend.pdx -- R41.M4-001 (#1374)
//
// SEMTERM FRAMEBUFFER FRONTEND. The R23 fb-console + R26 HID keyboard
// side of the semantic terminal. Owns the cursor coordinates a
// framebuffer renderer needs (row, col, style), a synthetic HID input
// queue that a keyboard event stream feeds bytes into, and a
// render-prepare primitive that packs (row, col, cursor-overlay) for
// the downstream fb-console driver.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the FRONTEND SEAM between the semantic terminal's cell buffer
// (semterm/plot.pdx) and the R23 fb-console pixel stack. sfb_reset
// clears state; sfb_cursor_set(row, col) parks the terminal cursor at
// (row, col) inside the 80x24 canvas plot.pdx owns;
// sfb_cursor_style_set(style) picks BLOCK (0) or UNDERLINE (1);
// sfb_render_prepare(row, col) packs (row << 16 | col | cursor_bit
// << 32) as the render command a framebuffer glyph blitter consumes,
// and bumps a renders counter so a caller can prove the path was
// walked. sfb_input_push(byte) accepts one HID-derived byte at the
// tail of a 64-slot ring, sfb_input_pop() takes one at the head, and
// sfb_input_len() reports the fill so a witness can drive
// backpressure and drain in the same fixture.
//
// It does NOT write to the framebuffer. It does NOT own the pixel
// blitter, the ANSI SGR state machine, or the font atlas -- those
// live in R23's fb_console.pdx. It does NOT poll the USB HID
// keyboard; a later round routes KIND_HID_EVENT deliveries into
// sfb_input_push. It does NOT own the cell buffer; the render
// command carries the (row, col) coordinates and the downstream
// blitter reads plt_get on its own.
//
// It is a SCAFFOLD (D7): R41.M4 wires it into the witness tree but no
// live fb-console driver walks the command, and no live HID event
// stream pushes bytes; sfb_arbitrated() returns 0 until a later round
// hooks a real frontend into these seams.
//
// =============================================================================
// §1  CURSOR AND INPUT MODEL
// =============================================================================
//
// The cursor lives inside the plot canvas: (row, col) is constrained
// to [0, PLT_ROWS) x [0, PLT_COLS) with PLT_ROWS = 24, PLT_COLS = 80
// per semterm/plot.pdx §0. sfb_render_prepare refuses out-of-range
// arguments rather than clamping so a downstream blitter cannot draw
// past the canvas edge without the refusal surfacing.
//
// The style is a tiny enum: 0 = block, 1 = underline. A widening
// (e.g. a bar, a hollow rectangle) is a widening of this enum;
// sfb_cursor_style_set refuses anything else with SFB_ERR_BAD_STYLE
// so the enum is the single documented widening path.
//
// Input queue is a 64-slot single-producer / single-consumer ring.
// sfb_input_push at the tail; sfb_input_pop at the head. Full refuses
// with SFB_ERR_INPUT_FULL; empty refuses with SFB_ERR_INPUT_EMPTY. A
// widening (multi-byte scancode blocks) is a widening of this arity,
// not a mode on the byte path.
//
// =============================================================================
// §2  ONE WRITER OF THE STATE
// =============================================================================
//
// _sfb_state and _sfb_input_q are written only by helpers in this
// module. tools/build.sh confines relocations against each to
// `core/semterm/fb_frontend.o`.
//
// STATE LAYOUT -- _sfb_state : [u64; 8]
//   +0    init_mark      0xF00B once sfb_reset has run
//   +8    err            sticky error latch (first-writer-wins)
//   +16   cursor_row     0..PLT_ROWS
//   +24   cursor_col     0..PLT_COLS
//   +32   cursor_style   0 (block) | 1 (underline)
//   +40   input_head     next index sfb_input_pop reads from
//   +48   input_tail     next index sfb_input_push writes to
//   +56   renders        total sfb_render_prepare calls since reset
//
// QUEUE LAYOUT -- _sfb_input_q : [u64; 64]
//   The queue is empty when input_head == input_tail. It is full when
//   (input_tail + 1) % 64 == input_head; the reserved slot avoids
//   confusing full with empty without a separate count.
//
// =============================================================================
// §3  FAILURE TAXONOMY 0xFFFFF050..0xFFFFF05F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time. Adjacent used
// band above: palette 0xFFFFF060..6F (R41.M3-003). Adjacent free band
// below: line_editor 0xFFFFF040..4F (R41.M4-002).
//
//   SFB_OK              = 0
//   SFB_ERR_NOT_INIT    = 0xFFFFF05F   accessor before sfb_reset
//   SFB_ERR_BAD_ROW     = 0xFFFFF05E   row >= PLT_ROWS
//   SFB_ERR_BAD_COL     = 0xFFFFF05D   col >= PLT_COLS
//   SFB_ERR_BAD_STYLE   = 0xFFFFF05C   style outside {0, 1}
//   SFB_ERR_INPUT_FULL  = 0xFFFFF05B   push into a full queue
//   SFB_ERR_INPUT_EMPTY = 0xFFFFF05A   pop from an empty queue
//   SFB_ERR_INTERNAL    = 0xFFFFF059   unreachable-fallthrough tripwire
//
// =============================================================================
// §4  ARITY DISCIPLINE
// =============================================================================
//
// sfb_cursor_set is (row, col); sfb_render_prepare is (row, col). Any
// widening (e.g. adding a viewport rectangle) is a widening of these
// arities, and tools/build.sh pins the signatures so a hidden
// coordinate cannot slip in.

module FbFrontend = structure {

  // Canvas geometry mirror (§1) -- kept alongside PLT_ROWS/PLT_COLS
  // in semterm/plot.pdx §0 so a downstream widening rewrites both in
  // one place.
  pub let SFB_ROWS : u64 = 24
  pub let SFB_COLS : u64 = 80

  // Style enum (§1).
  pub let SFB_STYLE_BLOCK     : u64 = 0
  pub let SFB_STYLE_UNDERLINE : u64 = 1

  // Queue geometry (§2).
  pub let SFB_INPUT_SLOTS : u64 = 64

  // Failure taxonomy (§3).
  pub let SFB_OK              : u64 = 0
  pub let SFB_ERR_NOT_INIT    : u64 = 0xFFFFF05F
  pub let SFB_ERR_BAD_ROW     : u64 = 0xFFFFF05E
  pub let SFB_ERR_BAD_COL     : u64 = 0xFFFFF05D
  pub let SFB_ERR_BAD_STYLE   : u64 = 0xFFFFF05C
  pub let SFB_ERR_INPUT_FULL  : u64 = 0xFFFFF05B
  pub let SFB_ERR_INPUT_EMPTY : u64 = 0xFFFFF05A
  pub let SFB_ERR_INTERNAL    : u64 = 0xFFFFF059

  pub let SFB_INIT_MARK : u64 = 0xF00B

  pub let mut _sfb_state   : [u64; 8]  = uninit @align(64)
  pub let mut _sfb_input_q : [u64; 64] = uninit @align(64)

  // ==========================================================================
  // Reset. Boot + teardown.
  // ==========================================================================

  pub let sfb_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M4-001 (#1374): clear state + queue, install init_mark. Labels prefixed sfb_rst_.",
      block: {
        lea r10, [rip + _sfb_input_q];
        xor rax, rax;
        xor rcx, rcx;
      sfb_rst_q:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 64;
        jb  sfb_rst_q;

        lea r10, [rip + _sfb_state];
        xor rcx, rcx;
      sfb_rst_st:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  sfb_rst_st;

        mov rax, 0xF00B;
        mov [r10 + 0], rax;                      // init_mark
        ret
      }
    } @no_frame

  pub let sfb_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R41.M4-001 (#1374): honesty pin. Returns 0 until a live fb-console drives sfb_render_prepare and a live HID stream drives sfb_input_push.",
      block: {
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let sfb_err : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M4-001 (#1374): sticky error latch readback. Labels prefixed sfb_er_.",
      block: {
        lea r10, [rip + _sfb_state];
        mov rax, [r10 + 8];
        ret
      }
    } @no_frame

  pub let sfb_bound : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M4-001 (#1374): 1 iff init_mark matches. Labels prefixed sfb_bnd_.",
      block: {
        lea r10, [rip + _sfb_state];
        mov rax, [r10 + 0];
        mov r11, 0xF00B;
        cmp rax, r11;
        jne sfb_bnd_no;
        mov rax, 1;
        ret;
      sfb_bnd_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let sfb_set_err : (u64) -> () !{mem} @{} =
    fn (code: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M4-001 (#1374): first-writer-wins error latch. Labels prefixed sfb_se_.",
      block: {
        lea r10, [rip + _sfb_state];
        mov rax, [r10 + 8];
        cmp rax, 0;
        jne sfb_se_out;
        mov [r10 + 8], rdi;
      sfb_se_out:
        ret
      }
    } @no_frame

  // ==========================================================================
  // Cursor readbacks.
  // ==========================================================================

  pub let sfb_cursor_row : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M4-001 (#1374): cursor row field. Labels prefixed sfb_cr_.",
      block: {
        lea r10, [rip + _sfb_state];
        mov rax, [r10 + 16];
        ret
      }
    } @no_frame

  pub let sfb_cursor_col : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M4-001 (#1374): cursor col field. Labels prefixed sfb_cc_.",
      block: {
        lea r10, [rip + _sfb_state];
        mov rax, [r10 + 24];
        ret
      }
    } @no_frame

  pub let sfb_cursor_style : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M4-001 (#1374): cursor style field. Labels prefixed sfb_cy_.",
      block: {
        lea r10, [rip + _sfb_state];
        mov rax, [r10 + 32];
        ret
      }
    } @no_frame

  pub let sfb_renders : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M4-001 (#1374): total sfb_render_prepare calls since reset. Labels prefixed sfb_rn_.",
      block: {
        lea r10, [rip + _sfb_state];
        mov rax, [r10 + 56];
        ret
      }
    } @no_frame

  // ==========================================================================
  // sfb_cursor_set(row, col) -> u64
  //
  // Park the cursor at (row, col). Refused if not init, if row >=
  // SFB_ROWS, or if col >= SFB_COLS.
  // ==========================================================================

  pub let sfb_cursor_set : (u64, u64) -> u64 !{mem} @{} =
    fn (row: u64, col: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M4-001 (#1374): store cursor coords after bounds. Labels prefixed sfb_cs_.",
      block: {
        lea r10, [rip + _sfb_state];
        mov rax, [r10 + 0];
        mov r11, 0xF00B;
        cmp rax, r11;
        jne sfb_cs_ni;

        cmp rdi, 24;
        jae sfb_cs_br;
        cmp rsi, 80;
        jae sfb_cs_bc;

        mov [r10 + 16], rdi;                     // cursor_row
        mov [r10 + 24], rsi;                     // cursor_col
        xor rax, rax;
        ret;

      sfb_cs_ni:
        mov rdi, 0xFFFFF05F;
        call sfb_set_err;
        mov rax, 0xFFFFF05F;
        ret;
      sfb_cs_br:
        mov rdi, 0xFFFFF05E;
        call sfb_set_err;
        mov rax, 0xFFFFF05E;
        ret;
      sfb_cs_bc:
        mov rdi, 0xFFFFF05D;
        call sfb_set_err;
        mov rax, 0xFFFFF05D;
        ret
      }
    }

  // ==========================================================================
  // sfb_cursor_style_set(style) -> u64
  //
  // Style must be 0 (block) or 1 (underline). Anything else is refused.
  // ==========================================================================

  pub let sfb_cursor_style_set : (u64) -> u64 !{mem} @{} =
    fn (style: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M4-001 (#1374): store cursor style after enum check. Labels prefixed sfb_ss_.",
      block: {
        lea r10, [rip + _sfb_state];
        mov rax, [r10 + 0];
        mov r11, 0xF00B;
        cmp rax, r11;
        jne sfb_ss_ni;

        cmp rdi, 1;
        ja  sfb_ss_bs;

        mov [r10 + 32], rdi;                     // cursor_style
        xor rax, rax;
        ret;

      sfb_ss_ni:
        mov rdi, 0xFFFFF05F;
        call sfb_set_err;
        mov rax, 0xFFFFF05F;
        ret;
      sfb_ss_bs:
        mov rdi, 0xFFFFF05C;
        call sfb_set_err;
        mov rax, 0xFFFFF05C;
        ret
      }
    }

  // ==========================================================================
  // sfb_render_prepare(row, col) -> u64
  //
  // Pack a render command for cell (row, col):
  //   bits  0..15   col (0..PLT_COLS)
  //   bits 16..31   row (0..PLT_ROWS)
  //   bit  32       cursor_bit (1 iff (row, col) == current cursor)
  //   bits 33..63   reserved (0)
  // Bumps renders counter on success. Refused if not init or out of
  // range.
  // ==========================================================================

  pub let sfb_render_prepare : (u64, u64) -> u64 !{mem} @{} =
    fn (row: u64, col: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M4-001 (#1374): pack row/col/cursor-overlay into a render command. Labels prefixed sfb_rp_.",
      block: {
        push rbx;
        push r12;
        push r13;
        mov rbx, rdi;                            // row
        mov r12, rsi;                            // col

        lea r10, [rip + _sfb_state];
        mov rax, [r10 + 0];
        mov r11, 0xF00B;
        cmp rax, r11;
        jne sfb_rp_ni;

        cmp rbx, 24;
        jae sfb_rp_br;
        cmp r12, 80;
        jae sfb_rp_bc;

        // Compose row << 16 | col in r13.
        mov r13, rbx;
        shl r13, 16;
        or  r13, r12;

        // cursor_bit = (row == cursor_row && col == cursor_col) ? 1 : 0.
        mov rax, [r10 + 16];                     // cursor_row
        cmp rax, rbx;
        jne sfb_rp_nocur;
        mov rax, [r10 + 24];                     // cursor_col
        cmp rax, r12;
        jne sfb_rp_nocur;
        mov rax, 1;
        shl rax, 32;
        or  r13, rax;
      sfb_rp_nocur:

        // Bump renders.
        mov rax, [r10 + 56];
        add rax, 1;
        mov [r10 + 56], rax;

        mov rax, r13;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      sfb_rp_ni:
        mov rdi, 0xFFFFF05F;
        call sfb_set_err;
        mov rax, 0xFFFFF05F;
        pop r13;
        pop r12;
        pop rbx;
        ret;
      sfb_rp_br:
        mov rdi, 0xFFFFF05E;
        call sfb_set_err;
        mov rax, 0xFFFFF05E;
        pop r13;
        pop r12;
        pop rbx;
        ret;
      sfb_rp_bc:
        mov rdi, 0xFFFFF05D;
        call sfb_set_err;
        mov rax, 0xFFFFF05D;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Input queue: sfb_input_push, sfb_input_pop, sfb_input_len.
  // ==========================================================================

  pub let sfb_input_len : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M4-001 (#1374): (tail - head) mod 64. Labels prefixed sfb_il_.",
      block: {
        lea r10, [rip + _sfb_state];
        mov r8, [r10 + 40];                      // head
        mov r9, [r10 + 48];                      // tail
        // len = (tail - head + 64) % 64
        mov rax, r9;
        sub rax, r8;
        // signed compare -- if negative, add 64.
        cmp rax, 0;
        jge sfb_il_out;
        add rax, 64;
      sfb_il_out:
        ret
      }
    } @no_frame

  pub let sfb_input_push : (u64) -> u64 !{mem} @{} =
    fn (byte: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M4-001 (#1374): enqueue one byte at tail. Refuses full. Labels prefixed sfb_ip_.",
      block: {
        lea r10, [rip + _sfb_state];
        mov rax, [r10 + 0];
        mov r11, 0xF00B;
        cmp rax, r11;
        jne sfb_ip_ni;

        // next_tail = (tail + 1) % 64
        mov r9, [r10 + 48];                      // tail
        mov rax, r9;
        add rax, 1;
        cmp rax, 64;
        jb  sfb_ip_ok;
        xor rax, rax;
      sfb_ip_ok:
        // Full when next_tail == head.
        mov r8, [r10 + 40];                      // head
        cmp rax, r8;
        je  sfb_ip_full;

        // Store byte (masked to 8 bits) at slot r9.
        lea r11, [rip + _sfb_input_q];
        mov rcx, 0xFF;
        and rdi, rcx;
        mov [r11 + r9 * 8], rdi;

        mov [r10 + 48], rax;                     // tail = next_tail
        xor rax, rax;
        ret;

      sfb_ip_ni:
        mov rdi, 0xFFFFF05F;
        call sfb_set_err;
        mov rax, 0xFFFFF05F;
        ret;
      sfb_ip_full:
        mov rdi, 0xFFFFF05B;
        call sfb_set_err;
        mov rax, 0xFFFFF05B;
        ret
      }
    }

  pub let sfb_input_pop : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M4-001 (#1374): dequeue one byte at head. Refuses empty. Labels prefixed sfb_op_.",
      block: {
        lea r10, [rip + _sfb_state];
        mov rax, [r10 + 0];
        mov r11, 0xF00B;
        cmp rax, r11;
        jne sfb_op_ni;

        mov r8, [r10 + 40];                      // head
        mov r9, [r10 + 48];                      // tail
        cmp r8, r9;
        je  sfb_op_empty;

        // Read byte at slot r8.
        lea r11, [rip + _sfb_input_q];
        mov rax, [r11 + r8 * 8];

        // head = (head + 1) % 64
        mov r9, r8;
        add r9, 1;
        cmp r9, 64;
        jb  sfb_op_advance;
        xor r9, r9;
      sfb_op_advance:
        mov [r10 + 40], r9;
        ret;

      sfb_op_ni:
        mov rdi, 0xFFFFF05F;
        call sfb_set_err;
        xor rax, rax;
        ret;
      sfb_op_empty:
        mov rdi, 0xFFFFF05A;
        call sfb_set_err;
        xor rax, rax;
        ret
      }
    }
}
