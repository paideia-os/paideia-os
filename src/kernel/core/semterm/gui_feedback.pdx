// src/kernel/core/semterm/gui_feedback.pdx -- R44.M4-002 (#1410)
//
// SEMTERM GUI PRESENTATION-TIME FEEDBACK. The G9
// presentation_time_feedback subscription seam that lets the R44 GUI
// terminal adapt its render cost when the compositor reports that
// frames land past their present deadline.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the ADAPTIVE FEEDBACK ARBITER between the G9 compositor
// event stream and the R44.M2 chart / scroll seams. A live G9
// subscriber walks the seam:
//   pfb_set_budget(budget_ns)                    // once at frontend attach
//   ...
//   on every KIND_PRESENT_FEEDBACK event ev:
//     pfb_report(ev.rendered_at, ev.presented_at)
//     if pfb_detail_level() > 0:
//       // gui_charts asks for a coarser series count / bar-width
//     if pfb_scroll_frozen() != 0:
//       // gui_scroll skips the ease-out animation step this frame
//
// pfb_reset zeroes state and installs the init_mark;
// pfb_set_budget(u64) parks the per-frame latency budget (refuses 0
// with PFB_ERR_BAD_BUDGET so the "over budget?" comparison can never
// silently underflow); pfb_report(rendered_at, presented_at) records
// one sample -- computes latency = presented_at - rendered_at, latches
// last_latency, bumps reports_total, and toggles the two adaptive
// flags (detail_level, scroll_frozen) based on latency vs. budget.
// pfb_last_latency / pfb_over_budget_count / pfb_reports_total /
// pfb_detail_level / pfb_scroll_frozen are the readbacks a
// diagnostic ring drains.
//
// It does NOT subscribe to KIND_PRESENT_FEEDBACK directly. The G9
// subscription is one round further out (an IPC channel binding on
// top of the compositor's frame_pump); this module is the SEAM the
// subscriber calls into. Keeping the row dereference OUT of this
// module keeps pfb_ independent of the compositor's init state.
//
// It does NOT change the render code path. It only PUBLISHES the
// signal: gui_charts reads pfb_detail_level() at chart-emit time and
// picks a bar width; gui_scroll reads pfb_scroll_frozen() before
// scr_animate_step and either skips the step or takes it. Keeping
// the actual cadence changes OUT of this module means a widening
// (a new adaptive knob -- glyph subpixel granularity, IME preedit
// blur) is a widening of the READERS, not of pfb_.
//
// It is a SCAFFOLD (D7): R44.M4 wires it into the witness tree but
// no live G9 subscriber calls pfb_report and no live chart / scroll
// path reads the adaptive flags; pfb_arbitrated() returns 0 until a
// later round hooks the compositor into pfb_report and the render
// modules into pfb_detail_level / pfb_scroll_frozen.
//
// =============================================================================
// §1  LATENCY BUDGET AND THE THREE STATE VARIABLES
// =============================================================================
//
// last_latency = presented_at - rendered_at        (per-report scalar)
// over_budget_count += 1  iff  last_latency > budget
// reports_total += 1  unconditionally on a successful pfb_report
//
// The two adaptive flags reflect the CURRENT report, not a moving
// average. A single fast frame after a slow one restores full detail
// / animated scroll; a single slow frame after a fast run drops to
// reduced detail / frozen scroll. The design tolerates noisy
// feedback because the READERS (charts / scroll) already have their
// own smoothing (glyph atlas caching, ease-out curve integration);
// what they need from this module is a per-frame HINT, not a policy.
//
// The units of budget_ns / rendered_at / presented_at are OPAQUE to
// this module -- the caller (the G9 subscription) must have picked a
// consistent unit (typically nanoseconds against a monotonic clock);
// pfb_report only cares that presented_at >= rendered_at (refuses
// with PFB_ERR_BAD_TIME otherwise, so a caller who swapped the two
// arguments does not silently underflow into a "very large latency"
// that permanently latches scroll_frozen == 1).
//
// =============================================================================
// §2  ONE WRITER OF THE STATE
// =============================================================================
//
// _pfb_state is written only by helpers in this module.
// tools/build.sh confines relocations against it to
// `core/semterm/gui_feedback.o`.
//
// STATE LAYOUT -- _pfb_state : [u64; 8]
//   +0    init_mark          0x9F00 once pfb_reset has run
//   +8    err                sticky error latch (first-writer-wins)
//   +16   budget             u64, > 0 after pfb_set_budget
//   +24   last_latency       u64, presented_at - rendered_at of last report
//   +32   over_budget_count  count of reports with latency > budget
//   +40   reports_total      count of successful pfb_report calls
//   +48   detail_level       0 (full) | 1 (reduced)
//   +56   scroll_frozen      0 (animated) | 1 (frozen)
//
// =============================================================================
// §3  FAILURE TAXONOMY 0xFFFFEE30..0xFFFFEE3F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time. Adjacent used
// band above: gui_hdr 0xFFFFEE40..4F (this milestone). Adjacent
// free band below: 0xFFFFEE20..2F (unassigned).
//
//   PFB_OK              = 0
//   PFB_ERR_NOT_INIT    = 0xFFFFEE3F   accessor before pfb_reset
//   PFB_ERR_BAD_TIME    = 0xFFFFEE3E   presented_at < rendered_at
//   PFB_ERR_BAD_BUDGET  = 0xFFFFEE3D   set_budget with budget == 0
//   PFB_ERR_NO_BUDGET   = 0xFFFFEE3C   pfb_report before set_budget
//   PFB_ERR_INTERNAL    = 0xFFFFEE3B   unreachable-fallthrough tripwire
//
// =============================================================================
// §4  ARITY DISCIPLINE
// =============================================================================
//
// pfb_set_budget is (budget). pfb_report is (rendered_at,
// presented_at). Every readback is (). A widening (a per-panel
// budget, a per-frame present_slot argument, a policy hysteresis
// window) is a widening of these arities and tools/build.sh pins the
// signatures.

module GuiFeedback = structure {

  // Failure taxonomy (§3).
  pub let PFB_OK              : u64 = 0
  pub let PFB_ERR_NOT_INIT    : u64 = 0xFFFFEE3F
  pub let PFB_ERR_BAD_TIME    : u64 = 0xFFFFEE3E
  pub let PFB_ERR_BAD_BUDGET  : u64 = 0xFFFFEE3D
  pub let PFB_ERR_NO_BUDGET   : u64 = 0xFFFFEE3C
  pub let PFB_ERR_INTERNAL    : u64 = 0xFFFFEE3B

  pub let PFB_INIT_MARK : u64 = 0x9F00

  pub let mut _pfb_state : [u64; 8] = uninit @align(64)

  // ==========================================================================
  // Reset. Boot + teardown.
  // ==========================================================================

  pub let pfb_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M4-002 (#1410): clear state, install init_mark. Labels prefixed pfb_rst_.",
      block: {
        lea r10, [rip + _pfb_state];
        xor rax, rax;
        xor rcx, rcx;
      pfb_rst_st:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  pfb_rst_st;

        mov rax, 0x9F00;
        mov [r10 + 0], rax;                      // init_mark
        ret
      }
    }

  pub let pfb_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R44.M4-002 (#1410): honesty pin. Returns 0 until a live G9 subscriber calls pfb_report and a live chart / scroll reader drains the adaptive flags.",
      block: {
        xor rax, rax;
        ret
      }
    }

  pub let pfb_err : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M4-002 (#1410): sticky error latch readback.",
      block: {
        lea r10, [rip + _pfb_state];
        mov rax, [r10 + 8];
        ret
      }
    }

  pub let pfb_bound : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M4-002 (#1410): 1 iff init_mark matches. Labels prefixed pfb_bnd_.",
      block: {
        lea r10, [rip + _pfb_state];
        mov rax, [r10 + 0];
        mov r11, 0x9F00;
        cmp rax, r11;
        jne pfb_bnd_no;
        mov rax, 1;
        ret;
      pfb_bnd_no:
        xor rax, rax;
        ret
      }
    }

  pub let pfb_set_err : (u64) -> () !{mem} @{} =
    fn (code: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M4-002 (#1410): first-writer-wins error latch. Labels prefixed pfb_se_.",
      block: {
        lea r10, [rip + _pfb_state];
        mov rax, [r10 + 8];
        cmp rax, 0;
        jne pfb_se_out;
        mov [r10 + 8], rdi;
      pfb_se_out:
        ret
      }
    }

  // ==========================================================================
  // Readbacks.
  // ==========================================================================

  pub let pfb_budget : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M4-002 (#1410): budget field.",
      block: {
        lea r10, [rip + _pfb_state];
        mov rax, [r10 + 16];
        ret
      }
    }

  pub let pfb_last_latency : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M4-002 (#1410): last_latency field.",
      block: {
        lea r10, [rip + _pfb_state];
        mov rax, [r10 + 24];
        ret
      }
    }

  pub let pfb_over_budget_count : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M4-002 (#1410): over_budget_count field.",
      block: {
        lea r10, [rip + _pfb_state];
        mov rax, [r10 + 32];
        ret
      }
    }

  pub let pfb_reports_total : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M4-002 (#1410): reports_total field.",
      block: {
        lea r10, [rip + _pfb_state];
        mov rax, [r10 + 40];
        ret
      }
    }

  pub let pfb_detail_level : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M4-002 (#1410): detail_level field.",
      block: {
        lea r10, [rip + _pfb_state];
        mov rax, [r10 + 48];
        ret
      }
    }

  pub let pfb_scroll_frozen : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M4-002 (#1410): scroll_frozen field.",
      block: {
        lea r10, [rip + _pfb_state];
        mov rax, [r10 + 56];
        ret
      }
    }

  // ==========================================================================
  // pfb_set_budget(budget) -> u64
  //
  // Park a positive per-frame latency budget. Refuses not init or
  // budget == 0 (PFB_ERR_BAD_BUDGET so the "over budget?" comparison
  // in pfb_report cannot silently underflow against a zero threshold).
  // ==========================================================================

  pub let pfb_set_budget : (u64) -> u64 !{mem} @{} =
    fn (budget: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M4-002 (#1410): park budget. Labels prefixed pfb_sb_.",
      block: {
        lea r10, [rip + _pfb_state];
        mov rax, [r10 + 0];
        mov r11, 0x9F00;
        cmp rax, r11;
        jne pfb_sb_ni;

        cmp rdi, 0;
        je  pfb_sb_bb;

        mov [r10 + 16], rdi;

        xor rax, rax;
        ret;

      pfb_sb_ni:
        mov rdi, 0xFFFFEE3F;
        call pfb_set_err;
        mov rax, 0xFFFFEE3F;
        ret;
      pfb_sb_bb:
        mov rdi, 0xFFFFEE3D;
        call pfb_set_err;
        mov rax, 0xFFFFEE3D;
        ret
      }
    }

  // ==========================================================================
  // pfb_report(rendered_at, presented_at) -> u64
  //
  // Record one presentation-time-feedback sample. Refuses not init,
  // budget not set (PFB_ERR_NO_BUDGET), or presented_at < rendered_at
  // (PFB_ERR_BAD_TIME).
  //
  // On success:
  //   last_latency = presented_at - rendered_at
  //   reports_total += 1
  //   if last_latency > budget:
  //     over_budget_count += 1
  //     detail_level = 1
  //     scroll_frozen = 1
  //   else:
  //     detail_level = 0
  //     scroll_frozen = 0
  //
  // Adaptive flags reflect the CURRENT report (§1); a single fast
  // frame after a slow one restores full detail.
  // ==========================================================================

  pub let pfb_report : (u64, u64) -> u64 !{mem} @{} =
    fn (rendered_at: u64, presented_at: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M4-002 (#1410): record one sample; latch adaptive flags. Labels prefixed pfb_rp_.",
      block: {
        lea r10, [rip + _pfb_state];
        mov rax, [r10 + 0];
        mov r11, 0x9F00;
        cmp rax, r11;
        jne pfb_rp_ni;

        // Budget must be > 0.
        mov r9, [r10 + 16];                      // budget
        cmp r9, 0;
        je  pfb_rp_nb;

        // presented_at >= rendered_at.
        cmp rsi, rdi;
        jb  pfb_rp_bt;

        // latency = presented_at - rendered_at.
        mov rax, rsi;
        sub rax, rdi;
        mov [r10 + 24], rax;                     // last_latency

        // reports_total += 1.
        mov rcx, [r10 + 40];
        add rcx, 1;
        mov [r10 + 40], rcx;

        // Compare latency vs. budget.
        cmp rax, r9;
        ja  pfb_rp_over;

        // Under (or equal): full detail, animated scroll.
        xor rax, rax;
        mov [r10 + 48], rax;                     // detail_level = 0
        mov [r10 + 56], rax;                     // scroll_frozen = 0
        xor rax, rax;
        ret;

      pfb_rp_over:
        // Over: reduce detail, freeze scroll, bump counter.
        mov rcx, [r10 + 32];
        add rcx, 1;
        mov [r10 + 32], rcx;                     // over_budget_count += 1
        mov rax, 1;
        mov [r10 + 48], rax;                     // detail_level = 1
        mov [r10 + 56], rax;                     // scroll_frozen = 1
        xor rax, rax;
        ret;

      pfb_rp_ni:
        mov rdi, 0xFFFFEE3F;
        call pfb_set_err;
        mov rax, 0xFFFFEE3F;
        ret;
      pfb_rp_nb:
        mov rdi, 0xFFFFEE3C;
        call pfb_set_err;
        mov rax, 0xFFFFEE3C;
        ret;
      pfb_rp_bt:
        mov rdi, 0xFFFFEE3E;
        call pfb_set_err;
        mov rax, 0xFFFFEE3E;
        ret
      }
    }
}
