// src/kernel/core/semterm/gui_shell.pdx -- R44.M1-001 (#1400)
//
// SEMTERM GUI SHELL. The R44 replacement for the R41.M4 fb_frontend:
// a libpaideia-ui (G12) window that hosts the semantic terminal. The
// window is a fixed-arity composition of four named regions -- the
// query editor pane, the results pane, the tab bar and the status bar
// -- plus an event queue that a G8 input router (KIND_HID_EVENT, R44+)
// will drain into.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the WINDOW-SHELL SEAM between the semantic-term core (R41.M1..M2)
// and the eventual G12 toolkit stack (Vello rasterizer, SDF text, IME,
// a11y). gsh_reset zeroes state; gsh_region_set(id, x, y, w, h) parks
// a region's rectangle; gsh_region_show(id, flag) toggles visibility;
// gsh_focus_set(id) parks the focused region (must be visible);
// gsh_event_push(kind, data) enqueues an input event and
// gsh_event_pump() dequeues one, delivering it to the focused region
// and bumping that region's delivery counter.
//
// It does NOT paint pixels. It does NOT own the G12 widget tree, the
// Vello scene graph, or the a11y accessibility tree -- those live in
// libpaideia-ui (G12). It does NOT decode HID events; a KIND_HID_EVENT
// subscriber (R32.M3) turns raw HID reports into gsh_event_push calls
// once R44+ hooks the router into this seam.
//
// It is a SCAFFOLD (D7): R44.M1 wires it into the witness tree but no
// live G12 toolkit paints, and no live HID event stream pushes;
// gsh_arbitrated() returns 0 until a later round installs a real
// toolkit frontend.
//
// =============================================================================
// §1  REGION MODEL
// =============================================================================
//
// GSH_REGION_QUERY_EDITOR = 0
// GSH_REGION_RESULTS      = 1
// GSH_REGION_TAB_BAR      = 2
// GSH_REGION_STATUS_BAR   = 3
// GSH_REGION_MAX          = 4
//
// Four regions, fixed. A widening (a side panel, a floating palette)
// is a widening of GSH_REGION_MAX and rewrites _gsh_regions in one
// place. Each region carries (x, y, w, h, visible, events_delivered).
// gsh_region_set refuses w == 0 or h == 0 with GSH_ERR_BAD_DIM -- a
// zero-dimension region on the toolkit side would either occupy no
// hit-testable area silently (a widget the user cannot reach) or
// divide by zero downstream, and either failure would be invisible
// here without the refusal.
//
// =============================================================================
// §2  EVENT QUEUE
// =============================================================================
//
// GSH_EVENT_SLOTS = 8. Each slot is two words: (kind, data). Ring
// arithmetic is the same reserved-slot pattern as
// semterm/fb_frontend.pdx §2: empty when head == tail, full when
// (tail + 1) % 8 == head so full does not collide with empty. Push
// refuses full with GSH_ERR_EVENT_FULL, pop refuses empty with
// GSH_ERR_EVENT_EMPTY. Pump routes the popped event to the focused
// region: focus must be a visible region (gsh_focus_set enforces),
// so a delivered event always has a bona fide addressee.
//
// =============================================================================
// §3  ONE WRITER OF THE STATE
// =============================================================================
//
// _gsh_state, _gsh_regions and _gsh_event_q are written only by
// helpers in this module. tools/build.sh confines relocations against
// each to `core/semterm/gui_shell.o`.
//
// STATE LAYOUT -- _gsh_state : [u64; 8]
//   +0    init_mark        0x5687 once gsh_reset has run
//   +8    err              sticky error latch (first-writer-wins)
//   +16   focus_region_id  0..GSH_REGION_MAX (starts at 0)
//   +24   event_head       next index gsh_event_pump reads from
//   +32   event_tail       next index gsh_event_push writes to
//   +40   events_delivered running total across all regions
//   +48   reserved         0
//   +56   reserved         0
//
// REGIONS LAYOUT -- _gsh_regions : [u64; 4 * 6] = 24 words
//   region(i) = _gsh_regions[i * 6 .. i * 6 + 5]
//     +0  x
//     +8  y
//     +16 w
//     +24 h
//     +32 visible          0 | 1
//     +40 events_delivered running total to this region
//
// QUEUE LAYOUT -- _gsh_event_q : [u64; 16] = 8 slots of 2 words each
//   slot(i) = (_gsh_event_q[i * 2], _gsh_event_q[i * 2 + 1]) = (kind, data)
//
// =============================================================================
// §4  FAILURE TAXONOMY 0xFFFFEED0..0xFFFFEEDF
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time. Adjacent used
// band above: concurrent_stress test 0xFFFFEEE0..EF (R42.M5-003).
// Adjacent free band below: gui_layout 0xFFFFEEC0..CF (R44.M1-002).
//
//   GSH_OK              = 0
//   GSH_ERR_NOT_INIT    = 0xFFFFEEDF   accessor before gsh_reset
//   GSH_ERR_BAD_REGION  = 0xFFFFEEDE   id >= GSH_REGION_MAX
//   GSH_ERR_BAD_DIM     = 0xFFFFEEDD   w == 0 or h == 0
//   GSH_ERR_HIDDEN_FOCUS= 0xFFFFEEDC   focus_set targets a non-visible region
//   GSH_ERR_EVENT_FULL  = 0xFFFFEEDB   push into a full queue
//   GSH_ERR_EVENT_EMPTY = 0xFFFFEEDA   pump against an empty queue
//   GSH_ERR_INTERNAL    = 0xFFFFEED9   unreachable-fallthrough tripwire
//
// =============================================================================
// §5  ARITY DISCIPLINE
// =============================================================================
//
// gsh_region_set is (id, x, y, w, h) -- five caller-visible arguments.
// gsh_region_show is (id, flag). gsh_focus_set is (id). gsh_event_push
// is (kind, data). Every readback is (). A widening (a z-order field, a
// per-region cap slot) is a widening of these arities, and
// tools/build.sh pins the signatures so a hidden coordinate cannot
// slip in.

module GuiShell = structure {

  // Region enum (§1).
  pub let GSH_REGION_QUERY_EDITOR : u64 = 0
  pub let GSH_REGION_RESULTS      : u64 = 1
  pub let GSH_REGION_TAB_BAR      : u64 = 2
  pub let GSH_REGION_STATUS_BAR   : u64 = 3
  pub let GSH_REGION_MAX          : u64 = 4

  // Event queue geometry (§2).
  pub let GSH_EVENT_SLOTS : u64 = 8

  // Failure taxonomy (§4).
  pub let GSH_OK               : u64 = 0
  pub let GSH_ERR_NOT_INIT     : u64 = 0xFFFFEEDF
  pub let GSH_ERR_BAD_REGION   : u64 = 0xFFFFEEDE
  pub let GSH_ERR_BAD_DIM      : u64 = 0xFFFFEEDD
  pub let GSH_ERR_HIDDEN_FOCUS : u64 = 0xFFFFEEDC
  pub let GSH_ERR_EVENT_FULL   : u64 = 0xFFFFEEDB
  pub let GSH_ERR_EVENT_EMPTY  : u64 = 0xFFFFEEDA
  pub let GSH_ERR_INTERNAL     : u64 = 0xFFFFEED9

  pub let GSH_INIT_MARK : u64 = 0x5687

  pub let mut _gsh_state   : [u64; 8]  = uninit @align(64)
  pub let mut _gsh_regions : [u64; 24] = uninit @align(64)
  pub let mut _gsh_event_q : [u64; 16] = uninit @align(64)

  // ==========================================================================
  // Reset. Boot + teardown.
  // ==========================================================================

  pub let gsh_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M1-001 (#1400): clear state + regions + queue, install init_mark. Labels prefixed gsh_rst_.",
      block: {
        lea r10, [rip + _gsh_event_q];
        xor rax, rax;
        xor rcx, rcx;
      gsh_rst_q:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 16;
        jb  gsh_rst_q;

        lea r10, [rip + _gsh_regions];
        xor rcx, rcx;
      gsh_rst_rg:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 24;
        jb  gsh_rst_rg;

        lea r10, [rip + _gsh_state];
        xor rcx, rcx;
      gsh_rst_st:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  gsh_rst_st;

        mov rax, 0x5687;
        mov [r10 + 0], rax;                      // init_mark
        ret
      }
    }

  pub let gsh_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R44.M1-001 (#1400): honesty pin. Returns 0 until a live G12 toolkit paints and a live HID stream drives gsh_event_push.",
      block: {
        xor rax, rax;
        ret
      }
    }

  pub let gsh_err : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M1-001 (#1400): sticky error latch readback. Labels prefixed gsh_er_.",
      block: {
        lea r10, [rip + _gsh_state];
        mov rax, [r10 + 8];
        ret
      }
    }

  pub let gsh_bound : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M1-001 (#1400): 1 iff init_mark matches. Labels prefixed gsh_bnd_.",
      block: {
        lea r10, [rip + _gsh_state];
        mov rax, [r10 + 0];
        mov r11, 0x5687;
        cmp rax, r11;
        jne gsh_bnd_no;
        mov rax, 1;
        ret;
      gsh_bnd_no:
        xor rax, rax;
        ret
      }
    }

  pub let gsh_set_err : (u64) -> () !{mem} @{} =
    fn (code: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M1-001 (#1400): first-writer-wins error latch. Labels prefixed gsh_se_.",
      block: {
        lea r10, [rip + _gsh_state];
        mov rax, [r10 + 8];
        cmp rax, 0;
        jne gsh_se_out;
        mov [r10 + 8], rdi;
      gsh_se_out:
        ret
      }
    }

  // ==========================================================================
  // Simple readbacks.
  // ==========================================================================

  pub let gsh_focus_get : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M1-001 (#1400): focus_region_id field.",
      block: {
        lea r10, [rip + _gsh_state];
        mov rax, [r10 + 16];
        ret
      }
    }

  pub let gsh_event_len : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M1-001 (#1400): (tail - head + 8) mod 8. Labels prefixed gsh_el_.",
      block: {
        lea r10, [rip + _gsh_state];
        mov r8, [r10 + 24];                      // head
        mov r9, [r10 + 32];                      // tail
        mov rax, r9;
        sub rax, r8;
        cmp rax, 0;
        jge gsh_el_out;
        add rax, 8;
      gsh_el_out:
        ret
      }
    }

  pub let gsh_events_delivered : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M1-001 (#1400): total events_delivered field.",
      block: {
        lea r10, [rip + _gsh_state];
        mov rax, [r10 + 40];
        ret
      }
    }

  // ==========================================================================
  // gsh_region_get(id, field) -> u64
  //
  // field: 0=x, 1=y, 2=w, 3=h, 4=visible, 5=events_delivered.
  // Refuses id >= GSH_REGION_MAX; a bad field returns 0 with err latched.
  // ==========================================================================

  pub let gsh_region_get : (u64, u64) -> u64 !{mem} @{} =
    fn (id: u64, field: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M1-001 (#1400): read one field of one region. Labels prefixed gsh_rg_.",
      block: {
        cmp rdi, 4;
        jae gsh_rg_br;
        cmp rsi, 5;
        ja  gsh_rg_bf;

        lea r10, [rip + _gsh_regions];
        mov rax, rdi;
        // offset = (id * 6 + field) * 8
        mov r11, 6;
        imul rax, r11;                                 // rdx:rax = rdi * 6
        add rax, rsi;
        mov rcx, rax;
        mov rax, [r10 + rcx * 8];
        ret;

      gsh_rg_br:
        mov rdi, 0xFFFFEEDE;
        call gsh_set_err;
        xor rax, rax;
        ret;
      gsh_rg_bf:
        mov rdi, 0xFFFFEED9;
        call gsh_set_err;
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // gsh_region_set(id, x, y, w, h) -> u64
  //
  // Park the region's rectangle. Refuses not init, bad id, or zero
  // dimension. Does not touch visibility or the delivered counter.
  // ==========================================================================

  pub let gsh_region_set : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (id: u64, x: u64, y: u64, w: u64, h: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M1-001 (#1400): store rectangle after arg checks. 6th arg on the stack per SysV; retrieved via [rbp + 16]. Labels prefixed gsh_rs_.",
      block: {
        lea r10, [rip + _gsh_state];
        mov rax, [r10 + 0];
        mov r11, 0x5687;
        cmp rax, r11;
        jne gsh_rs_ni;

        cmp rdi, 4;
        jae gsh_rs_br;
        // w in rcx, h in r8. Refuse zeros.
        cmp rcx, 0;
        je  gsh_rs_bd;
        cmp r8, 0;
        je  gsh_rs_bd;

        // offset base = id * 6 (words)
        mov rax, rdi;
        mov r11, 6;
        imul rax, r11;                                 // rax = id * 6
        lea r10, [rip + _gsh_regions];
        lea r10, [r10 + rax * 8];                // r10 = &regions[id]

        mov [r10 + 0],  rsi;                     // x
        mov [r10 + 8],  rdx;                     // y
        mov [r10 + 16], rcx;                     // w
        mov [r10 + 24], r8;                      // h

        xor rax, rax;
        ret;

      gsh_rs_ni:
        mov rdi, 0xFFFFEEDF;
        call gsh_set_err;
        mov rax, 0xFFFFEEDF;
        ret;
      gsh_rs_br:
        mov rdi, 0xFFFFEEDE;
        call gsh_set_err;
        mov rax, 0xFFFFEEDE;
        ret;
      gsh_rs_bd:
        mov rdi, 0xFFFFEEDD;
        call gsh_set_err;
        mov rax, 0xFFFFEEDD;
        ret
      }
    }

  // ==========================================================================
  // gsh_region_show(id, flag) -> u64
  //
  // Set the visible flag. flag is coerced to 0 or 1. Refuses not init or
  // bad id.
  // ==========================================================================

  pub let gsh_region_show : (u64, u64) -> u64 !{mem} @{} =
    fn (id: u64, flag: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M1-001 (#1400): toggle region visibility. Labels prefixed gsh_sh_.",
      block: {
        lea r10, [rip + _gsh_state];
        mov rax, [r10 + 0];
        mov r11, 0x5687;
        cmp rax, r11;
        jne gsh_sh_ni;

        cmp rdi, 4;
        jae gsh_sh_br;

        // Coerce flag to 0/1.
        cmp rsi, 0;
        je  gsh_sh_store;
        mov rsi, 1;
      gsh_sh_store:

        mov rax, rdi;
        mov r11, 6;
        imul rax, r11;                                 // rax = id * 6
        add rax, 4;                              // + visible field
        lea r10, [rip + _gsh_regions];
        mov [r10 + rax * 8], rsi;

        xor rax, rax;
        ret;

      gsh_sh_ni:
        mov rdi, 0xFFFFEEDF;
        call gsh_set_err;
        mov rax, 0xFFFFEEDF;
        ret;
      gsh_sh_br:
        mov rdi, 0xFFFFEEDE;
        call gsh_set_err;
        mov rax, 0xFFFFEEDE;
        ret
      }
    }

  // ==========================================================================
  // gsh_focus_set(id) -> u64
  //
  // Park focus at region id. Refuses not init, bad id, or focus on a
  // hidden region. A visible region is a region whose visible flag is 1
  // AND whose (w, h) are both > 0 (a zero-dim region can never accept
  // pointer hits regardless of the flag).
  // ==========================================================================

  pub let gsh_focus_set : (u64) -> u64 !{mem} @{} =
    fn (id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M1-001 (#1400): park focus after visibility check. Labels prefixed gsh_fs_.",
      block: {
        lea r10, [rip + _gsh_state];
        mov rax, [r10 + 0];
        mov r11, 0x5687;
        cmp rax, r11;
        jne gsh_fs_ni;

        cmp rdi, 4;
        jae gsh_fs_br;

        // offset base = id * 6
        mov rax, rdi;
        mov r11, 6;
        imul rax, r11;
        lea r9, [rip + _gsh_regions];
        lea r9, [r9 + rax * 8];                  // r9 = &regions[id]

        // visible == 1?
        mov rax, [r9 + 32];
        cmp rax, 1;
        jne gsh_fs_hi;
        // w > 0?
        mov rax, [r9 + 16];
        cmp rax, 0;
        je  gsh_fs_hi;
        // h > 0?
        mov rax, [r9 + 24];
        cmp rax, 0;
        je  gsh_fs_hi;

        // Store focus.
        lea r10, [rip + _gsh_state];
        mov [r10 + 16], rdi;

        xor rax, rax;
        ret;

      gsh_fs_ni:
        mov rdi, 0xFFFFEEDF;
        call gsh_set_err;
        mov rax, 0xFFFFEEDF;
        ret;
      gsh_fs_br:
        mov rdi, 0xFFFFEEDE;
        call gsh_set_err;
        mov rax, 0xFFFFEEDE;
        ret;
      gsh_fs_hi:
        mov rdi, 0xFFFFEEDC;
        call gsh_set_err;
        mov rax, 0xFFFFEEDC;
        ret
      }
    }

  // ==========================================================================
  // gsh_event_push(kind, data) -> u64
  //
  // Enqueue one event. Refuses not init or full queue.
  // ==========================================================================

  pub let gsh_event_push : (u64, u64) -> u64 !{mem} @{} =
    fn (kind: u64, data: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M1-001 (#1400): enqueue (kind, data) at tail. Labels prefixed gsh_ep_.",
      block: {
        lea r10, [rip + _gsh_state];
        mov rax, [r10 + 0];
        mov r11, 0x5687;
        cmp rax, r11;
        jne gsh_ep_ni;

        // next_tail = (tail + 1) % 8
        mov r9, [r10 + 32];                      // tail
        mov rax, r9;
        add rax, 1;
        cmp rax, 8;
        jb  gsh_ep_ok;
        xor rax, rax;
      gsh_ep_ok:
        // Full when next_tail == head.
        mov r8, [r10 + 24];                      // head
        cmp rax, r8;
        je  gsh_ep_full;

        // slot = tail * 2
        mov rcx, r9;
        shl rcx, 1;
        lea r11, [rip + _gsh_event_q];
        mov [r11 + rcx * 8], rdi;                // kind
        add rcx, 1;
        mov [r11 + rcx * 8], rsi;                // data

        mov [r10 + 32], rax;                     // tail = next_tail
        xor rax, rax;
        ret;

      gsh_ep_ni:
        mov rdi, 0xFFFFEEDF;
        call gsh_set_err;
        mov rax, 0xFFFFEEDF;
        ret;
      gsh_ep_full:
        mov rdi, 0xFFFFEEDB;
        call gsh_set_err;
        mov rax, 0xFFFFEEDB;
        ret
      }
    }

  // ==========================================================================
  // gsh_event_pump() -> u64
  //
  // Dequeue one event and deliver it to the focused region. Returns
  // the event's kind field on success; refuses not init or empty queue.
  // Bumps events_delivered (global and per-region).
  // ==========================================================================

  pub let gsh_event_pump : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M1-001 (#1400): dequeue at head, deliver to focused region. Labels prefixed gsh_pm_.",
      block: {
        lea r10, [rip + _gsh_state];
        mov rax, [r10 + 0];
        mov r11, 0x5687;
        cmp rax, r11;
        jne gsh_pm_ni;

        mov r8, [r10 + 24];                      // head
        mov r9, [r10 + 32];                      // tail
        cmp r8, r9;
        je  gsh_pm_empty;

        // Read event.kind at slot = head * 2.
        mov rcx, r8;
        shl rcx, 1;
        lea r11, [rip + _gsh_event_q];
        mov rax, [r11 + rcx * 8];                // kind (saved for return)
        push rax;

        // head = (head + 1) % 8
        mov r9, r8;
        add r9, 1;
        cmp r9, 8;
        jb  gsh_pm_adv;
        xor r9, r9;
      gsh_pm_adv:
        mov [r10 + 24], r9;

        // Bump global events_delivered.
        mov rax, [r10 + 40];
        add rax, 1;
        mov [r10 + 40], rax;

        // Bump focus_region.events_delivered.
        mov rax, [r10 + 16];                     // focus_region_id
        mov r11, 6;
        imul rax, r11;
        add rax, 5;                              // + delivered field
        lea r11, [rip + _gsh_regions];
        mov rcx, [r11 + rax * 8];
        add rcx, 1;
        mov [r11 + rax * 8], rcx;

        pop rax;                                 // return the kind
        ret;

      gsh_pm_ni:
        mov rdi, 0xFFFFEEDF;
        call gsh_set_err;
        mov rax, 0xFFFFEEDF;
        ret;
      gsh_pm_empty:
        mov rdi, 0xFFFFEEDA;
        call gsh_set_err;
        mov rax, 0xFFFFEEDA;
        ret
      }
    }
}
