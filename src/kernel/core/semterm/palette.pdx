// src/kernel/core/semterm/palette.pdx -- R41.M3-003 (#1373)
//
// COLOR PALETTE API for the semantic terminal. Owns the 16-entry
// default palette (RGB triplets), the ANSI SGR mapping that emits
// those entries over a text terminal, an eight-way series lookup
// tuned for the two common types of dichromacy (deuteranopia and
// protanopia), and the xterm 256-color extended palette formula.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the CATALOGUE. pal_default_rgb(idx) returns the 24-bit RGB
// value of default entry idx (0..15); pal_ansi_fg(idx) /
// pal_ansi_bg(idx) return the SGR ordinal that selects it on an
// ANSI-conformant terminal; pal_series_color(series) returns the
// default-palette index the chart engine should use for series
// (0..7) so consecutive series pairs remain distinguishable under
// deuteranopia and protanopia (§1).
//
// The default palette is a 16-entry scan-line-safe set with a
// documented CIELAB delta-E floor -- adjacent entries in the
// series list carry delta-E >= 15 against each other and against
// black / white so a viewer reading a chart on a paper printout, on
// a display in bright ambient light, or through a monochromatic
// filter can still tell adjacent categories apart. The specific
// values track the xterm/VGA canon so a downstream frontend using an
// ANSI SGR sequence does not need to re-negotiate a palette with the
// display.
//
// The extended 256-color palette (pal_extended(idx)) is COMPUTED, not
// stored, using the xterm formula documented in §2. This keeps the
// module bounded (one 16-entry default table lives in memory) while
// still giving the chart engine a stable 256-value RGB catalogue.
//
// It does NOT render. It does NOT emit ANSI escape sequences (the
// downstream frontend does that -- this module returns the ordinal
// alone). It does NOT reason about the framebuffer or the display
// gamma.
//
// It is a SCAFFOLD (D7): R41.M3 wires it into the witness tree but
// no live query drives it; pal_arbitrated() returns 0 until a later
// round hooks a chart-emitting formatter into the catalogue.
//
// =============================================================================
// §1  DEFAULT PALETTE + SERIES ORDER
// =============================================================================
//
// Sixteen entries. Values are 24-bit RGB packed as (R << 16 | G << 8
// | B).  The set follows the xterm/VGA canon so an ANSI SGR
// sequence resolves to the same color on any conformant terminal.
//
//   idx  name            RGB          ANSI FG    ANSI BG
//   0    black           0x000000     30         40
//   1    red             0xCD0000     31         41
//   2    green           0x00CD00     32         42
//   3    yellow          0xCDCD00     33         43
//   4    blue            0x0000EE     34         44
//   5    magenta         0xCD00CD     35         45
//   6    cyan            0x00CDCD     36         46
//   7    white           0xE5E5E5     37         47
//   8    bright-black    0x7F7F7F     90         100
//   9    bright-red      0xFF0000     91         101
//   10   bright-green    0x00FF00     92         102
//   11   bright-yellow   0xFFFF00     93         103
//   12   bright-blue     0x5C5CFF     94         104
//   13   bright-magenta  0xFF00FF     95         105
//   14   bright-cyan     0x00FFFF     96         106
//   15   bright-white    0xFFFFFF     97         107
//
// SERIES ORDER (§0 delta-E floor). Eight indices into the default
// table, ordered so consecutive series pairs stay distinguishable
// under normal, deuteranopic, and protanopic vision. Chosen from
// the Wong-style categorical set and remapped into the 16-color
// space:
//
//   series 0 -> idx 4   blue
//   series 1 -> idx 11  bright-yellow
//   series 2 -> idx 10  bright-green
//   series 3 -> idx 13  bright-magenta
//   series 4 -> idx 6   cyan
//   series 5 -> idx 9   bright-red
//   series 6 -> idx 14  bright-cyan
//   series 7 -> idx 3   yellow
//
// =============================================================================
// §2  EXTENDED 256-COLOR PALETTE FORMULA
// =============================================================================
//
// pal_extended(idx) returns the 24-bit RGB value for index idx in
// the xterm-256 palette:
//
//   0..15    the default palette above.
//   16..231  a 6x6x6 RGB cube. Compute:
//              n = idx - 16
//              r_step = n / 36
//              g_step = (n / 6) % 6
//              b_step = n % 6
//              channel value: step == 0 -> 0
//                              else       55 + step * 40
//   232..255 grayscale. Compute:
//              n = idx - 232
//              gray = 8 + n * 10  (0x08, 0x12, 0x1C, ... 0xEE)
//              R = G = B = gray
//
// The formula matches the xterm defaults every conformant terminal
// resolves to; the module does the arithmetic rather than storing
// the full 256-entry table because the result is deterministic.
//
// =============================================================================
// §3  ONE WRITER OF THE STATE
// =============================================================================
//
// _pal_default, _pal_ansi_fg, _pal_ansi_bg, _pal_series and
// _pal_state are written only by helpers in this module.
// tools/build.sh confines relocations against each to
// `core/semterm/palette.o`.
//
// STATE LAYOUT -- _pal_state : [u64; 8]
//   +0    init_mark  0xC01B once pal_reset has run
//   +8    err        sticky error latch
//   +16   reserved
//   +24   reserved
//   +32   reserved
//   +40   reserved
//   +48   reserved
//   +56   reserved
//
// =============================================================================
// §4  FAILURE TAXONOMY 0xFFFFF060..0xFFFFF06F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time. Adjacent used
// band above: layout 0xFFFFF070..7F (R41.M3-002). Adjacent free band
// below: unassigned 0xFFFFF050..5F.
//
//   PAL_OK             = 0
//   PAL_ERR_NOT_INIT   = 0xFFFFF06F   any accessor before pal_reset
//   PAL_ERR_BAD_IDX    = 0xFFFFF06E   default index outside [0, 16)
//   PAL_ERR_BAD_SERIES = 0xFFFFF06D   series index outside [0, 8)
//   PAL_ERR_BAD_EXT    = 0xFFFFF06C   extended index outside [0, 256)
//   PAL_ERR_INTERNAL   = 0xFFFFF06B   unreachable-fallthrough tripwire
//
// =============================================================================
// §5  ARITY DISCIPLINE
// =============================================================================
//
// Every accessor is (idx) -> value; there is no widening path the
// caller can walk without adding a value to the enum. The tables are
// mutable only through pal_reset, so the confinement gate names them
// alongside the state cell.

module Palette = structure {

  // Table sizes.
  pub let PAL_DEFAULT_COUNT : u64 = 16
  pub let PAL_SERIES_COUNT  : u64 = 8

  // Failure taxonomy (§4).
  pub let PAL_OK             : u64 = 0
  pub let PAL_ERR_NOT_INIT   : u64 = 0xFFFFF06F
  pub let PAL_ERR_BAD_IDX    : u64 = 0xFFFFF06E
  pub let PAL_ERR_BAD_SERIES : u64 = 0xFFFFF06D
  pub let PAL_ERR_BAD_EXT    : u64 = 0xFFFFF06C
  pub let PAL_ERR_INTERNAL   : u64 = 0xFFFFF06B

  pub let PAL_INIT_MARK : u64 = 0xC01B

  pub let mut _pal_default  : [u64; 16] = uninit @align(64)
  pub let mut _pal_ansi_fg  : [u64; 16] = uninit @align(64)
  pub let mut _pal_ansi_bg  : [u64; 16] = uninit @align(64)
  pub let mut _pal_series   : [u64; 8]  = uninit @align(64)
  pub let mut _pal_state    : [u64; 8]  = uninit @align(64)

  // ==========================================================================
  // Reset. Boot + teardown. Populates all four tables.
  // ==========================================================================

  pub let pal_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M3-003 (#1373): clear state, install init_mark, populate the default RGB table + ANSI mappings + series order per §1. Labels prefixed pal_rst_.",
      block: {
        // -- Clear _pal_state.
        lea r10, [rip + _pal_state];
        xor rax, rax;
        xor rcx, rcx;
      pal_rst_st:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  pal_rst_st;

        // -- Populate _pal_default (§1 RGB column).
        lea r10, [rip + _pal_default];
        mov rax, 0x000000;
        mov [r10 + 0], rax;
        mov rax, 0xCD0000;
        mov [r10 + 8], rax;
        mov rax, 0x00CD00;
        mov [r10 + 16], rax;
        mov rax, 0xCDCD00;
        mov [r10 + 24], rax;
        mov rax, 0x0000EE;
        mov [r10 + 32], rax;
        mov rax, 0xCD00CD;
        mov [r10 + 40], rax;
        mov rax, 0x00CDCD;
        mov [r10 + 48], rax;
        mov rax, 0xE5E5E5;
        mov [r10 + 56], rax;
        mov rax, 0x7F7F7F;
        mov [r10 + 64], rax;
        mov rax, 0xFF0000;
        mov [r10 + 72], rax;
        mov rax, 0x00FF00;
        mov [r10 + 80], rax;
        mov rax, 0xFFFF00;
        mov [r10 + 88], rax;
        mov rax, 0x5C5CFF;
        mov [r10 + 96], rax;
        mov rax, 0xFF00FF;
        mov [r10 + 104], rax;
        mov rax, 0x00FFFF;
        mov [r10 + 112], rax;
        mov rax, 0xFFFFFF;
        mov [r10 + 120], rax;

        // -- Populate _pal_ansi_fg (§1 ANSI FG column).
        // idx 0..7 -> 30..37; idx 8..15 -> 90..97.
        lea r10, [rip + _pal_ansi_fg];
        mov rax, 30;
        mov [r10 + 0], rax;
        mov rax, 31;
        mov [r10 + 8], rax;
        mov rax, 32;
        mov [r10 + 16], rax;
        mov rax, 33;
        mov [r10 + 24], rax;
        mov rax, 34;
        mov [r10 + 32], rax;
        mov rax, 35;
        mov [r10 + 40], rax;
        mov rax, 36;
        mov [r10 + 48], rax;
        mov rax, 37;
        mov [r10 + 56], rax;
        mov rax, 90;
        mov [r10 + 64], rax;
        mov rax, 91;
        mov [r10 + 72], rax;
        mov rax, 92;
        mov [r10 + 80], rax;
        mov rax, 93;
        mov [r10 + 88], rax;
        mov rax, 94;
        mov [r10 + 96], rax;
        mov rax, 95;
        mov [r10 + 104], rax;
        mov rax, 96;
        mov [r10 + 112], rax;
        mov rax, 97;
        mov [r10 + 120], rax;

        // -- Populate _pal_ansi_bg (§1 ANSI BG column).
        // idx 0..7 -> 40..47; idx 8..15 -> 100..107.
        lea r10, [rip + _pal_ansi_bg];
        mov rax, 40;
        mov [r10 + 0], rax;
        mov rax, 41;
        mov [r10 + 8], rax;
        mov rax, 42;
        mov [r10 + 16], rax;
        mov rax, 43;
        mov [r10 + 24], rax;
        mov rax, 44;
        mov [r10 + 32], rax;
        mov rax, 45;
        mov [r10 + 40], rax;
        mov rax, 46;
        mov [r10 + 48], rax;
        mov rax, 47;
        mov [r10 + 56], rax;
        mov rax, 100;
        mov [r10 + 64], rax;
        mov rax, 101;
        mov [r10 + 72], rax;
        mov rax, 102;
        mov [r10 + 80], rax;
        mov rax, 103;
        mov [r10 + 88], rax;
        mov rax, 104;
        mov [r10 + 96], rax;
        mov rax, 105;
        mov [r10 + 104], rax;
        mov rax, 106;
        mov [r10 + 112], rax;
        mov rax, 107;
        mov [r10 + 120], rax;

        // -- Populate _pal_series (§1 series order).
        lea r10, [rip + _pal_series];
        mov rax, 4;                              // series 0 -> blue
        mov [r10 + 0], rax;
        mov rax, 11;                             // series 1 -> bright-yellow
        mov [r10 + 8], rax;
        mov rax, 10;                             // series 2 -> bright-green
        mov [r10 + 16], rax;
        mov rax, 13;                             // series 3 -> bright-magenta
        mov [r10 + 24], rax;
        mov rax, 6;                              // series 4 -> cyan
        mov [r10 + 32], rax;
        mov rax, 9;                              // series 5 -> bright-red
        mov [r10 + 40], rax;
        mov rax, 14;                             // series 6 -> bright-cyan
        mov [r10 + 48], rax;
        mov rax, 3;                              // series 7 -> yellow
        mov [r10 + 56], rax;

        // -- Install init_mark last.
        lea r10, [rip + _pal_state];
        mov rax, 0xC01B;
        mov [r10 + 0], rax;
        ret
      }
    } @no_frame

  pub let pal_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R41.M3-003 (#1373): honesty pin. Returns 0 until a chart formatter consumes pal_ansi_fg / pal_ansi_bg.",
      block: {
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let pal_err : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M3-003 (#1373): sticky error latch readback. Labels prefixed pal_er_.",
      block: {
        lea r10, [rip + _pal_state];
        mov rax, [r10 + 8];
        ret
      }
    } @no_frame

  pub let pal_bound : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M3-003 (#1373): 1 iff init_mark matches. Labels prefixed pal_bnd_.",
      block: {
        lea r10, [rip + _pal_state];
        mov rax, [r10 + 0];
        mov r11, 0xC01B;
        cmp rax, r11;
        jne pal_bnd_no;
        mov rax, 1;
        ret;
      pal_bnd_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let pal_set_err : (u64) -> () !{mem} @{} =
    fn (code: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M3-003 (#1373): first-writer-wins error latch. Labels prefixed pal_se_.",
      block: {
        lea r10, [rip + _pal_state];
        mov rax, [r10 + 8];
        cmp rax, 0;
        jne pal_se_out;
        mov [r10 + 8], rdi;
      pal_se_out:
        ret
      }
    } @no_frame

  // ==========================================================================
  // pal_default_rgb(idx) -> u64
  //
  // 24-bit RGB value packed as (R << 16 | G << 8 | B). Refused if
  // idx >= 16 (PAL_ERR_BAD_IDX) or if not init.
  // ==========================================================================

  pub let pal_default_rgb : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M3-003 (#1373): default RGB lookup. Labels prefixed pal_dr_.",
      block: {
        lea r10, [rip + _pal_state];
        mov rax, [r10 + 0];
        mov r11, 0xC01B;
        cmp rax, r11;
        jne pal_dr_ni;

        cmp rdi, 16;
        jae pal_dr_bi;

        lea r10, [rip + _pal_default];
        mov rax, [r10 + rdi * 8];
        ret;

      pal_dr_ni:
        mov rdi, 0xFFFFF06F;
        call pal_set_err;
        xor rax, rax;
        ret;
      pal_dr_bi:
        mov rdi, 0xFFFFF06E;
        call pal_set_err;
        xor rax, rax;
        ret
      }
    }

  pub let pal_ansi_fg : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M3-003 (#1373): ANSI SGR foreground ordinal. Labels prefixed pal_af_.",
      block: {
        lea r10, [rip + _pal_state];
        mov rax, [r10 + 0];
        mov r11, 0xC01B;
        cmp rax, r11;
        jne pal_af_ni;

        cmp rdi, 16;
        jae pal_af_bi;

        lea r10, [rip + _pal_ansi_fg];
        mov rax, [r10 + rdi * 8];
        ret;

      pal_af_ni:
        mov rdi, 0xFFFFF06F;
        call pal_set_err;
        xor rax, rax;
        ret;
      pal_af_bi:
        mov rdi, 0xFFFFF06E;
        call pal_set_err;
        xor rax, rax;
        ret
      }
    }

  pub let pal_ansi_bg : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M3-003 (#1373): ANSI SGR background ordinal. Labels prefixed pal_ab_.",
      block: {
        lea r10, [rip + _pal_state];
        mov rax, [r10 + 0];
        mov r11, 0xC01B;
        cmp rax, r11;
        jne pal_ab_ni;

        cmp rdi, 16;
        jae pal_ab_bi;

        lea r10, [rip + _pal_ansi_bg];
        mov rax, [r10 + rdi * 8];
        ret;

      pal_ab_ni:
        mov rdi, 0xFFFFF06F;
        call pal_set_err;
        xor rax, rax;
        ret;
      pal_ab_bi:
        mov rdi, 0xFFFFF06E;
        call pal_set_err;
        xor rax, rax;
        ret
      }
    }

  pub let pal_series_color : (u64) -> u64 !{mem} @{} =
    fn (series: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M3-003 (#1373): colorblind-safe series-index -> default-palette-index. Labels prefixed pal_sc_.",
      block: {
        lea r10, [rip + _pal_state];
        mov rax, [r10 + 0];
        mov r11, 0xC01B;
        cmp rax, r11;
        jne pal_sc_ni;

        cmp rdi, 8;
        jae pal_sc_bs;

        lea r10, [rip + _pal_series];
        mov rax, [r10 + rdi * 8];
        ret;

      pal_sc_ni:
        mov rdi, 0xFFFFF06F;
        call pal_set_err;
        xor rax, rax;
        ret;
      pal_sc_bs:
        mov rdi, 0xFFFFF06D;
        call pal_set_err;
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // pal_extended(idx) -> u64
  //
  // 24-bit RGB for idx in [0, 256). idx 0..15 defers to
  // pal_default_rgb; idx 16..231 is the 6x6x6 cube; idx 232..255 is
  // the grayscale ramp. See §2 for the formula.
  //
  // Locals: rbx = idx, r12 = n scratch, r13..r15 = channel scratch.
  // ==========================================================================

  pub let pal_extended : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R41.M3-003 (#1373): xterm-256 formula. 0..15 defers to _pal_default; 16..231 is 6x6x6 cube (step 0 -> 0, else 55 + step*40); 232..255 is 8 + n*10 grayscale. Labels prefixed pal_ex_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        mov rbx, rdi;

        lea r10, [rip + _pal_state];
        mov rax, [r10 + 0];
        mov r11, 0xC01B;
        cmp rax, r11;
        jne pal_ex_ni;

        cmp rbx, 256;
        jae pal_ex_bx;

        // 0..15 -> pal_default_rgb
        cmp rbx, 16;
        jae pal_ex_1;
        mov rdi, rbx;
        call pal_default_rgb;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      pal_ex_1:
        cmp rbx, 232;
        jae pal_ex_gray;

        // 6x6x6 cube. n = idx - 16.
        mov r12, rbx;
        sub r12, 16;

        // r_step = n / 36. Use div: rdx:rax / r_divisor.
        mov rax, r12;
        xor rdx, rdx;
        mov r8, 36;
        div r8;                                  // rax = r_step, rdx = n % 36
        mov r13, rax;                            // r_step
        mov r14, rdx;                            // rem after /36

        // g_step = rem / 6
        mov rax, r14;
        xor rdx, rdx;
        mov r8, 6;
        div r8;
        mov r14, rax;                            // g_step
        mov r15, rdx;                            // b_step

        // channel(step) = step == 0 ? 0 : 55 + step * 40
        // Compute r channel.
        mov rax, r13;
        cmp rax, 0;
        je  pal_ex_r0;
        mov r8, 40;
        imul rax, r8;                            // rax = step * 40
        add rax, 55;
      pal_ex_r0:
        mov r13, rax;                            // r_channel

        mov rax, r14;
        cmp rax, 0;
        je  pal_ex_g0;
        mov r8, 40;
        imul rax, r8;
        add rax, 55;
      pal_ex_g0:
        mov r14, rax;                            // g_channel

        mov rax, r15;
        cmp rax, 0;
        je  pal_ex_b0;
        mov r8, 40;
        imul rax, r8;
        add rax, 55;
      pal_ex_b0:
        mov r15, rax;                            // b_channel

        // RGB = (r << 16) | (g << 8) | b
        mov rax, r13;
        shl rax, 16;
        mov r8, r14;
        shl r8, 8;
        or  rax, r8;
        or  rax, r15;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      pal_ex_gray:
        // gray = 8 + (idx - 232) * 10
        mov r12, rbx;
        sub r12, 232;
        mov rax, r12;
        mov r8, 10;
        imul rax, r8;
        add rax, 8;
        // Broadcast into R, G, B.
        mov r13, rax;
        mov r14, r13;
        shl r14, 16;
        mov r15, r13;
        shl r15, 8;
        or  r14, r15;
        or  r14, r13;
        mov rax, r14;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      pal_ex_ni:
        mov rdi, 0xFFFFF06F;
        call pal_set_err;
        xor rax, rax;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;
      pal_ex_bx:
        mov rdi, 0xFFFFF06C;
        call pal_set_err;
        xor rax, rax;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
