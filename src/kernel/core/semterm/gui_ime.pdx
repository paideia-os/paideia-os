// src/kernel/core/semterm/gui_ime.pdx -- R44.M3-001 (#1406)
//
// SEMTERM GUI IME BINDING. The G11 IME service seam for the R44 GUI
// query-editor: routes composing code points from a downstream input
// method into a bounded pre-edit buffer (rendered with an underline
// attribute before commit), tracks a notify-pending counter that a
// live editor pump drains, and moves the composed code points from
// pre-edit into a committed-run counter on ime_commit.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// It is the IME SEAM behind the R44.M1 gui_shell's query-editor region.
// A live G11 IME source walks the seam:
//   ime_preedit_push(cp)     // for each composing code point
//   ime_preedit_push(cp)
//   ime_commit()             // IME says the composition is final
//   // A downstream editor pump then reads ime_notify_pending() and
//   // when > 0 drains the freshly-committed run into its own buffer
//   // via ime_notify_ack().
//
// Cancellation (the user backspaces every code point, or an IME
// cancel key drops the composition) is ime_preedit_clear(); nothing
// commits.
//
// ime_reset zeroes state; ime_preedit_push(codepoint) appends one
// code point to the pre-edit buffer (refuses codepoint 0 with
// IME_ERR_BAD_CP; codepoint 0 is the empty-slot marker, and letting
// it into the buffer would collide with the atlas convention in
// semterm/gui_vello.pdx §2); ime_preedit_pop drops the most recent
// composing code point (backspace during composition);
// ime_preedit_clear cancels the composition; ime_preedit_len /
// ime_preedit_at read back the buffer; ime_commit moves the pre-edit
// run into commits_total and bumps notify_pending; ime_notify_pending
// / ime_notify_ack / ime_notify_flushed track the drain seam;
// ime_commits_total is the running total of committed code points.
//
// It does NOT rasterise. The Vello backend (semterm/gui_vello.pdx)
// walks the pre-edit run at frame flush and draws an underline
// attribute under those glyphs; the underline style is a widening of
// the atlas record and NOT a field of this module. It does NOT own
// the query editor: the editor's line buffer is
// semterm/line_editor.pdx and only draws committed code points; the
// commit HANDOFF (ime_commit -> notify_pending) is what wakes the
// editor pump.
//
// It is a SCAFFOLD (D7): R44.M3 wires it into the witness tree but
// no live G11 IME source pushes and no live editor pump drains;
// ime_arbitrated() returns 0 until a later round hooks the input
// stack into ime_preedit_push and the editor into ime_notify_ack.
//
// =============================================================================
// §1  PRE-EDIT BUFFER
// =============================================================================
//
// IME_PREEDIT_MAX = 64. One entry per code point being composed.
// Sixty-four is more than any realistic single-composition run for
// CJK IMEs (a hanzi or kana row is typically 1--4 code points, and
// pinyin composition ~10) but bounded at a value the failure taxonomy
// can reason about. A widening (multi-line composition, extended-pict
// composition beyond 64) is a widening of IME_PREEDIT_MAX and
// rewrites _ime_preedit's declaration in one place.
//
// Slot i holds one Unicode code point (u64, since the widest UCS-4
// value 0x10FFFF fits well below 2^32 and u64 keeps the row uniform
// with every other counted state in this file). Code point 0 is the
// empty-slot marker: ime_preedit_push refuses 0 with IME_ERR_BAD_CP,
// so a walker that finds a 0 in the middle of the buffer has
// discovered a state-machine bug the confinement gate can identify.
//
// =============================================================================
// §2  COMMIT + NOTIFY HANDOFF
// =============================================================================
//
// ime_commit is the atomic hand-off from IME to editor. It:
//   1. adds preedit_len to commits_total.
//   2. clears preedit_len to 0.
//   3. increments notify_pending by 1 (one pending notify PER commit,
//      regardless of run length -- the pending flag is a wake-up, not
//      a byte count).
//
// A live editor pump walks the seam:
//   pending := ime_notify_pending()
//   while pending > 0:
//     // read commits_total delta from last drain, walk the newly-
//     // committed characters (the caller tracks its own last-total
//     // marker; this module hands out the running total, not a
//     // delta).
//     ime_notify_ack()
//     pending := ime_notify_pending()
//
// Refuses commit with an empty pre-edit (IME_ERR_NOTHING_TO_COMMIT)
// so a stray IME notify cannot bump notify_pending without a real
// commit behind it. Refuses notify_ack with notify_pending == 0
// (IME_ERR_NO_NOTIFY) so an ack can never underflow the counter.
//
// =============================================================================
// §3  ONE WRITER OF THE STATE
// =============================================================================
//
// _ime_state and _ime_preedit are written only by helpers in this
// module. tools/build.sh confines relocations against each to
// `core/semterm/gui_ime.o`.
//
// STATE LAYOUT -- _ime_state : [u64; 8]
//   +0    init_mark        0x71ED once ime_reset has run
//   +8    err              sticky error latch (first-writer-wins)
//   +16   preedit_len      0..IME_PREEDIT_MAX
//   +24   commits_total    running total of committed code points
//   +32   notify_pending   count of unflushed commits
//   +40   notify_flushed   running total of ime_notify_ack calls
//   +48   pushes_total     running total of ime_preedit_push successes
//   +56   reserved         0
//
// PRE-EDIT LAYOUT -- _ime_preedit : [u64; 64]
//   _ime_preedit[i] = codepoint (0 = empty-slot marker)
//
// =============================================================================
// §4  FAILURE TAXONOMY 0xFFFFEE70..0xFFFFEE7F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time. Adjacent used
// band above: gui_scroll 0xFFFFEE80..8F (R44.M2-003). Adjacent free
// band below: 0xFFFFEE60..6F (gui_a11y, this milestone).
//
//   IME_OK                   = 0
//   IME_ERR_NOT_INIT         = 0xFFFFEE7F   accessor before ime_reset
//   IME_ERR_BAD_CP           = 0xFFFFEE7E   preedit_push with codepoint 0
//   IME_ERR_PREEDIT_FULL     = 0xFFFFEE7D   preedit_push when buffer full
//   IME_ERR_PREEDIT_EMPTY    = 0xFFFFEE7C   preedit_pop with empty buffer
//   IME_ERR_NOTHING_TO_COMMIT = 0xFFFFEE7B  commit with preedit_len == 0
//   IME_ERR_BAD_IDX          = 0xFFFFEE7A   preedit_at with idx >= preedit_len
//   IME_ERR_NO_NOTIFY        = 0xFFFFEE79   notify_ack when pending == 0
//   IME_ERR_INTERNAL         = 0xFFFFEE78   unreachable-fallthrough tripwire
//
// =============================================================================
// §5  ARITY DISCIPLINE
// =============================================================================
//
// ime_preedit_push is (codepoint). ime_preedit_at is (idx).
// ime_preedit_pop, ime_preedit_clear, ime_commit, ime_notify_ack are
// (). Every readback is (). A widening (an attribute per preedit
// slot, a caret position, multiple simultaneous compositions) is a
// widening of these arities and tools/build.sh pins the signatures.

module GuiIme = structure {

  // Pre-edit bound (§1).
  pub let IME_PREEDIT_MAX : u64 = 64

  // Failure taxonomy (§4).
  pub let IME_OK                    : u64 = 0
  pub let IME_ERR_NOT_INIT          : u64 = 0xFFFFEE7F
  pub let IME_ERR_BAD_CP            : u64 = 0xFFFFEE7E
  pub let IME_ERR_PREEDIT_FULL      : u64 = 0xFFFFEE7D
  pub let IME_ERR_PREEDIT_EMPTY     : u64 = 0xFFFFEE7C
  pub let IME_ERR_NOTHING_TO_COMMIT : u64 = 0xFFFFEE7B
  pub let IME_ERR_BAD_IDX           : u64 = 0xFFFFEE7A
  pub let IME_ERR_NO_NOTIFY         : u64 = 0xFFFFEE79
  pub let IME_ERR_INTERNAL          : u64 = 0xFFFFEE78

  pub let IME_INIT_MARK : u64 = 0x71ED

  pub let mut _ime_state   : [u64; 8]  = uninit @align(64)
  pub let mut _ime_preedit : [u64; 64] = uninit @align(64)

  // ==========================================================================
  // Reset. Boot + teardown.
  // ==========================================================================

  pub let ime_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M3-001 (#1406): clear state + preedit buffer, install init_mark. Labels prefixed ime_rst_.",
      block: {
        lea r10, [rip + _ime_preedit];
        xor rax, rax;
        xor rcx, rcx;
      ime_rst_pb:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 64;
        jb  ime_rst_pb;

        lea r10, [rip + _ime_state];
        xor rcx, rcx;
      ime_rst_st:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  ime_rst_st;

        mov rax, 0x71ED;
        mov [r10 + 0], rax;                      // init_mark
        ret
      }
    }

  pub let ime_arbitrated : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R44.M3-001 (#1406): honesty pin. Returns 0 until a live G11 IME source pushes and a live editor pump drains ime_notify_ack.",
      block: {
        xor rax, rax;
        ret
      }
    }

  pub let ime_err : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M3-001 (#1406): sticky error latch readback.",
      block: {
        lea r10, [rip + _ime_state];
        mov rax, [r10 + 8];
        ret
      }
    }

  pub let ime_bound : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M3-001 (#1406): 1 iff init_mark matches. Labels prefixed ime_bnd_.",
      block: {
        lea r10, [rip + _ime_state];
        mov rax, [r10 + 0];
        mov r11, 0x71ED;
        cmp rax, r11;
        jne ime_bnd_no;
        mov rax, 1;
        ret;
      ime_bnd_no:
        xor rax, rax;
        ret
      }
    }

  pub let ime_set_err : (u64) -> () !{mem} @{} =
    fn (code: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M3-001 (#1406): first-writer-wins error latch. Labels prefixed ime_se_.",
      block: {
        lea r10, [rip + _ime_state];
        mov rax, [r10 + 8];
        cmp rax, 0;
        jne ime_se_out;
        mov [r10 + 8], rdi;
      ime_se_out:
        ret
      }
    }

  // ==========================================================================
  // Readbacks.
  // ==========================================================================

  pub let ime_preedit_len : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M3-001 (#1406): preedit_len field.",
      block: {
        lea r10, [rip + _ime_state];
        mov rax, [r10 + 16];
        ret
      }
    }

  pub let ime_commits_total : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M3-001 (#1406): commits_total field.",
      block: {
        lea r10, [rip + _ime_state];
        mov rax, [r10 + 24];
        ret
      }
    }

  pub let ime_notify_pending : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M3-001 (#1406): notify_pending field.",
      block: {
        lea r10, [rip + _ime_state];
        mov rax, [r10 + 32];
        ret
      }
    }

  pub let ime_notify_flushed : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M3-001 (#1406): notify_flushed running total.",
      block: {
        lea r10, [rip + _ime_state];
        mov rax, [r10 + 40];
        ret
      }
    }

  pub let ime_pushes_total : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M3-001 (#1406): pushes_total field.",
      block: {
        lea r10, [rip + _ime_state];
        mov rax, [r10 + 48];
        ret
      }
    }

  // ==========================================================================
  // ime_preedit_at(idx) -> u64
  //
  // Read one code point from the pre-edit buffer. Refuses idx >=
  // preedit_len with IME_ERR_BAD_IDX. No init check on the read path
  // (accessor style: a caller reading from a not-init module reads
  // the zero the reset installs, and BAD_IDX would fire for any
  // positive idx against a zero-len buffer).
  // ==========================================================================

  pub let ime_preedit_at : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M3-001 (#1406): read one preedit slot. Labels prefixed ime_pa_.",
      block: {
        lea r10, [rip + _ime_state];
        mov rax, [r10 + 16];                     // preedit_len
        cmp rdi, rax;
        jae ime_pa_bi;

        lea r10, [rip + _ime_preedit];
        mov rax, [r10 + rdi * 8];
        ret;

      ime_pa_bi:
        mov rdi, 0xFFFFEE7A;
        call ime_set_err;
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // ime_preedit_push(codepoint) -> u64
  //
  // Append one composing code point to the pre-edit buffer. Refuses
  // not init, codepoint 0 (empty-slot marker), or buffer full.
  // ==========================================================================

  pub let ime_preedit_push : (u64) -> u64 !{mem} @{} =
    fn (codepoint: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M3-001 (#1406): append one code point to preedit. Labels prefixed ime_pp_.",
      block: {
        lea r10, [rip + _ime_state];
        mov rax, [r10 + 0];
        mov r11, 0x71ED;
        cmp rax, r11;
        jne ime_pp_ni;

        cmp rdi, 0;
        je  ime_pp_bc;

        mov rax, [r10 + 16];                     // preedit_len
        cmp rax, 64;
        jae ime_pp_pf;

        // _ime_preedit[preedit_len] = codepoint.
        lea r11, [rip + _ime_preedit];
        mov [r11 + rax * 8], rdi;

        // preedit_len += 1.
        add rax, 1;
        mov [r10 + 16], rax;

        // pushes_total += 1.
        mov rax, [r10 + 48];
        add rax, 1;
        mov [r10 + 48], rax;

        xor rax, rax;
        ret;

      ime_pp_ni:
        mov rdi, 0xFFFFEE7F;
        call ime_set_err;
        mov rax, 0xFFFFEE7F;
        ret;
      ime_pp_bc:
        mov rdi, 0xFFFFEE7E;
        call ime_set_err;
        mov rax, 0xFFFFEE7E;
        ret;
      ime_pp_pf:
        mov rdi, 0xFFFFEE7D;
        call ime_set_err;
        mov rax, 0xFFFFEE7D;
        ret
      }
    }

  // ==========================================================================
  // ime_preedit_pop() -> u64
  //
  // Drop the most recent composing code point (backspace during
  // composition). Zeroes the vacated slot so a subsequent walker sees
  // the empty-slot marker at every index >= preedit_len. Refuses not
  // init or empty buffer.
  // ==========================================================================

  pub let ime_preedit_pop : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M3-001 (#1406): drop last preedit slot. Labels prefixed ime_po_.",
      block: {
        lea r10, [rip + _ime_state];
        mov rax, [r10 + 0];
        mov r11, 0x71ED;
        cmp rax, r11;
        jne ime_po_ni;

        mov rax, [r10 + 16];                     // preedit_len
        cmp rax, 0;
        je  ime_po_pe;

        // preedit_len -= 1.
        sub rax, 1;
        mov [r10 + 16], rax;

        // Zero the vacated slot.
        lea r11, [rip + _ime_preedit];
        xor rcx, rcx;
        mov [r11 + rax * 8], rcx;

        xor rax, rax;
        ret;

      ime_po_ni:
        mov rdi, 0xFFFFEE7F;
        call ime_set_err;
        mov rax, 0xFFFFEE7F;
        ret;
      ime_po_pe:
        mov rdi, 0xFFFFEE7C;
        call ime_set_err;
        mov rax, 0xFFFFEE7C;
        ret
      }
    }

  // ==========================================================================
  // ime_preedit_clear() -> u64
  //
  // Cancel the composition: clear preedit_len to 0 and zero every
  // used slot. Idempotent even against an already-empty buffer.
  // Refuses not init.
  // ==========================================================================

  pub let ime_preedit_clear : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M3-001 (#1406): drop entire preedit run; idempotent. Labels prefixed ime_pc_.",
      block: {
        lea r10, [rip + _ime_state];
        mov rax, [r10 + 0];
        mov r11, 0x71ED;
        cmp rax, r11;
        jne ime_pc_ni;

        mov rcx, [r10 + 16];                     // preedit_len
        // preedit_len = 0.
        xor rax, rax;
        mov [r10 + 16], rax;

        cmp rcx, 0;
        je  ime_pc_out;

        lea r11, [rip + _ime_preedit];
        xor rax, rax;
        xor rdi, rdi;
      ime_pc_zl:
        cmp rdi, rcx;
        jae ime_pc_out;
        mov [r11 + rdi * 8], rax;
        add rdi, 1;
        jmp ime_pc_zl;

      ime_pc_out:
        xor rax, rax;
        ret;

      ime_pc_ni:
        mov rdi, 0xFFFFEE7F;
        call ime_set_err;
        mov rax, 0xFFFFEE7F;
        ret
      }
    }

  // ==========================================================================
  // ime_commit() -> u64
  //
  // Move preedit_len code points into commits_total, clear preedit
  // (both the counter and every used slot) and bump notify_pending by
  // one. Refuses not init or empty preedit
  // (IME_ERR_NOTHING_TO_COMMIT). Returns the count just committed on
  // success.
  // ==========================================================================

  pub let ime_commit : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M3-001 (#1406): hand preedit run over as one commit. Labels prefixed ime_cm_.",
      block: {
        push rbx;
        push r12;

        lea r10, [rip + _ime_state];
        mov rax, [r10 + 0];
        mov r11, 0x71ED;
        cmp rax, r11;
        jne ime_cm_ni;

        mov rbx, [r10 + 16];                     // preedit_len
        cmp rbx, 0;
        je  ime_cm_nc;

        // commits_total += preedit_len.
        mov rax, [r10 + 24];
        add rax, rbx;
        mov [r10 + 24], rax;

        // Zero every used slot BEFORE clearing preedit_len so a
        // concurrent reader (there is none today, but the guarantee
        // is cheap) sees a valid buffer.
        lea r12, [rip + _ime_preedit];
        xor rax, rax;
        xor rcx, rcx;
      ime_cm_zl:
        cmp rcx, rbx;
        jae ime_cm_zd;
        mov [r12 + rcx * 8], rax;
        add rcx, 1;
        jmp ime_cm_zl;
      ime_cm_zd:

        // preedit_len = 0.
        xor rax, rax;
        mov [r10 + 16], rax;

        // notify_pending += 1.
        mov rax, [r10 + 32];
        add rax, 1;
        mov [r10 + 32], rax;

        mov rax, rbx;                            // return committed count
        jmp ime_cm_out;

      ime_cm_ni:
        mov rdi, 0xFFFFEE7F;
        call ime_set_err;
        mov rax, 0xFFFFEE7F;
        jmp ime_cm_out;
      ime_cm_nc:
        mov rdi, 0xFFFFEE7B;
        call ime_set_err;
        mov rax, 0xFFFFEE7B;

      ime_cm_out:
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // ime_notify_ack() -> u64
  //
  // Drain one notify. Decrement notify_pending, bump notify_flushed.
  // Refuses not init or notify_pending == 0 (IME_ERR_NO_NOTIFY).
  // ==========================================================================

  pub let ime_notify_ack : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R44.M3-001 (#1406): drain one pending notify. Labels prefixed ime_na_.",
      block: {
        lea r10, [rip + _ime_state];
        mov rax, [r10 + 0];
        mov r11, 0x71ED;
        cmp rax, r11;
        jne ime_na_ni;

        mov rax, [r10 + 32];                     // notify_pending
        cmp rax, 0;
        je  ime_na_nn;

        sub rax, 1;
        mov [r10 + 32], rax;

        mov rax, [r10 + 40];                     // notify_flushed
        add rax, 1;
        mov [r10 + 40], rax;

        xor rax, rax;
        ret;

      ime_na_ni:
        mov rdi, 0xFFFFEE7F;
        call ime_set_err;
        mov rax, 0xFFFFEE7F;
        ret;
      ime_na_nn:
        mov rdi, 0xFFFFEE79;
        call ime_set_err;
        mov rax, 0xFFFFEE79;
        ret
      }
    }
}
