// src/kernel/core/pds/cap_decl_check.pdx -- UMB-W28 R227.M2 (paideia-os #2704)
//
// pds-lang CAPABILITY-DECLARATION CHECKER
//
// =============================================================================
// SECTION 0  WHY THIS FILE EXISTS
// =============================================================================
//
// R227 (paideia-shell-language, umbrella #2694) is the typed, capability-
// aware shell / scripting surface. R227.M1 (Wave 112, #2703) landed the
// HEADER PRAGMA parser: a byte-level predicate that walks `#pragma pds
// <directive>` lines at the start of a `.pds` file and emits an array of
// 32-byte PdsHpRecord into a caller-provided buffer. M1 recognises four
// directives (version, strict, charset, history_default_cap) and performs
// NO capability enforcement -- it is a pure parser.
//
// R227.M2 (THIS FILE) lands the CAP-DECL CHECKER: the second stage of
// the pds load pipeline. Where M1 answered "what did the file say?",
// M2 answers "is what the file said consistent with what the caller is
// allowed to grant?". It validates the NARROW-ONLY INVARIANT:
//
//     declared.rights ⊆ granted.rights   for every declared cap.
//
// This is the SAME invariant R125.M2's `_cap_minter_derive` enforces at
// mint time (see src/kernel/core/svc/cap_minter.pdx step 7 of the derive
// algorithm) and the SAME invariant R125.M3's `.caps.decl` ELF loader
// pre-checks before dispatching to the minter (see src/kernel/core/elf/
// caps_decl_loader.pdx §4). M2's role in the pds pipeline is to catch a
// widening request EARLY -- before any load-time side effect, before the
// script's body is parsed, before the user sees a half-created session.
//
// Pipeline shape:
//
//     bytes of .pds file
//        │
//        ▼
//     _pds_hp_parse       -- R227.M1: byte-level pragma parser
//        │  emits PdsHpRecord[k] (32 B each)
//        ▼
//     _pds_cdc_check      -- R227.M2 (THIS): cross-checks declared caps
//        │                   against the caller's grant env, returns
//        │                   errno WITHOUT mutating any state
//        ▼
//     [M3+]               -- integrated with R123.M3 functor-invoke:
//                            on OK, mint the declared caps into the
//                            session's cap-env via _cap_minter_derive.
//
// M2 performs NO mint. It is a pure read-only predicate that lets the
// loader abort cleanly before any env insert / state mutation happens.
// The mint step lands in M3 (or integrated with R123.M3 functor-invoke)
// so M2 can land independently and the policy layer can grow test
// coverage against the predicate before the enforcement path arrives.
//
// =============================================================================
// SECTION 1  PUBLIC API
// =============================================================================
//
//   _pds_cdc_check(pragmas_ptr, n_pragmas,
//                  declared_caps_ptr, n_declared,
//                  grant_env_handle) -> u64 errno
//
// ARGS:
//
//   rdi = pragmas_ptr          -- base of PdsHpRecord[n_pragmas] as
//                                 emitted by _pds_hp_parse (32 B stride).
//                                 M2 scans this array to count KIND_CAP
//                                 ordinals (ordinal 5, reserved for the
//                                 pragma parser's follow-up milestone)
//                                 and cross-checks the count against
//                                 n_declared. May be 0 iff n_pragmas==0.
//
//   rsi = n_pragmas            -- u64 count of PdsHpRecord entries. Zero
//                                 means "no pragma block present".
//
//   rdx = declared_caps_ptr    -- base of DeclaredCap[n_declared] where
//                                 each record is 16 bytes:
//                                     +0  u64 name_hash  (FNV-1a 64)
//                                     +8  u64 rights     (bit mask)
//                                 These are the AUTHORITATIVE declared
//                                 caps the pds loader has pre-parsed
//                                 from the pragma block. The checker
//                                 treats this array as the source of
//                                 truth and uses pragmas_ptr only for
//                                 the UNDECLARED cross-check (§5).
//
//   rcx = n_declared           -- u64 count of DeclaredCap entries.
//                                 Zero is OK: a script with no cap
//                                 declarations trivially passes.
//
//   r8  = grant_env_handle     -- KIND_CAP_ENV handle (0..CAP_ENV_MAX)
//                                 representing the grants the caller is
//                                 permitted to pass through to the pds
//                                 session. The checker calls
//                                 cap_env_lookup(grant_env_handle, slot)
//                                 to resolve each declared cap's parent
//                                 and reads the stored u64 as a rights
//                                 mask directly (same bridge convention
//                                 as R125.M4 syscall cap-check §2).
//
// RETURNS (rax):
//
//   PDS_CDC_OK                   = 0        all declared caps pass the
//                                           narrow-only invariant against
//                                           the grant env.
//   PDS_CDC_ERR_UNDECLARED       = 0x3100   KIND_CAP pragma count does
//                                           NOT match n_declared (a
//                                           declared cap is missing a
//                                           pragma record, or vice versa).
//                                           Catches a pipeline-level
//                                           mismatch before the per-cap
//                                           invariants run.
//   PDS_CDC_ERR_RIGHTS_WIDEN     = 0x3101   a declared cap's rights
//                                           mask has bits beyond what
//                                           the grant env's parent cap
//                                           provides. This is the
//                                           NARROW-ONLY INVARIANT
//                                           violation and the primary
//                                           reason M2 exists.
//   PDS_CDC_ERR_GRANT_INSUFFICIENT = 0x3102 cap_env_lookup against the
//                                           grant env returned 0 for a
//                                           declared cap's parent slot:
//                                           the caller cannot pass this
//                                           cap down because they do
//                                           not hold it themselves.
//   PDS_CDC_ERR_BAD_PRAGMA       = 0x3103   a declared cap record is
//                                           structurally malformed
//                                           (name_hash == 0, which is
//                                           reserved for "unused slot"
//                                           per FNV-1a convention).
//                                           Fast-fails the whole check.
//
// All four error codes share the 0x3100..0x31FF band (new carve-out
// above the pds-header-pragma band 0x2800..0x28FF). Grep audit on
// 2026-10-14: `grep -rnE '0x31[0-9A-F]{2}\b' src/ 2>/dev/null` returns
// zero hits -- clean band.
//
// =============================================================================
// SECTION 2  NARROW-ONLY INVARIANT  (THE MAIN GUARANTEE)
// =============================================================================
//
// For every declared cap D in declared_caps[0..n_declared]:
//
//     Let G = cap_env_lookup(grant_env_handle, parent_slot(D)).
//     Require (D.rights & G) == D.rights.
//
// The expression form `(D & G) == D` is equivalent to `D & ~G == 0` but
// avoids the paideia-as `not reg` encoder gap (see R125.M2
// _cap_minter_derive step 7, which uses the same idiom). We use it here
// for consistency with the kernel-wide narrow-only check.
//
// The check is PURE: no env mutation, no cap_table traffic, no klog
// chatter on the success path. On failure, one klog_s1 fingerprint lands
// to make the audit trail greppable.
//
// =============================================================================
// SECTION 3  BRIDGE: HASH -> PARENT SLOT  (M3 PATTERN REUSED)
// =============================================================================
//
// R125.M3's caps_decl_loader (`src/kernel/core/elf/caps_decl_loader.pdx`
// §1) adopted a BRIDGE for mapping an FNV-1a 64 cap name hash to a
// parent env slot: `parent_slot = (name_hash & 0xFF) mod CAP_ENV_SLOTS`.
// Rationale there was the lack of a `_cap_env_lookup_by_hash` surface
// at R125.M4. That surface is STILL not landed at R227.M2, so the pds
// checker inherits the same bridge convention. Hash collisions are
// 2^-56 per pair (bridge is semantic, not security-weakening -- the
// narrow-only check still runs on whatever cap the resolver returns).
//
// A follow-up (not in M2's scope) replaces the bridge with the real
// hash resolver once it lands. The on-wire DeclaredCap record shape
// does not change: the resolver is a kernel-internal plug-point.
//
// =============================================================================
// SECTION 4  BRIDGE: SLOT VALUE AS RIGHTS MASK  (M4 PATTERN REUSED)
// =============================================================================
//
// R125.M4's syscall cap-check (`src/kernel/core/syscall/cap_check.pdx`
// §2) adopts a SIMPLIFICATION: a KIND_CAP_ENV slot's stored u64 is
// read directly as a rights mask, rather than being dereferenced into
// the cap_table at `[cap_table + idx*24 + 8]` to recover a full
// capability descriptor. Rationale: at R125.M3-era the shell inserts
// rights-level masks into env slots directly, so the simpler read is
// faithful to the data in flight.
//
// R227.M2 inherits the same simplification. When the cap-table
// dereference lands at M5+, this file picks up the richer read without
// changing the public API (the DeclaredCap record shape is unchanged;
// the resolver is kernel-internal).
//
// =============================================================================
// SECTION 5  THE UNDECLARED CROSS-CHECK
// =============================================================================
//
// The pragmas array is reserved for a future KIND_CAP ordinal (= 5)
// that the pragma parser emits when it sees `#pragma pds caps "<spec>"`.
// At R227.M1 the parser recognises only ordinals 1..4; so at the moment
// R227.M2 ships the pragma parser never emits KIND_CAP and the count
// of KIND_CAP pragmas in `pragmas_ptr` is always zero.
//
// The UNDECLARED check compares (count of KIND_CAP ordinals in pragmas)
// against n_declared and fails if they diverge. This catches the
// pipeline-level invariant "declared_caps was populated inconsistently
// with the pragma stream": e.g. a loader that parsed caps from a
// non-pragma source without a corresponding pragma record, OR a pragma
// stream with cap records the loader forgot to parse. Both cases are
// loader bugs that the checker trips cleanly.
//
// At M2 the common case `n_pragmas == K`, `n_declared == 0`, no KIND_CAP
// pragmas present (M1 parser does not emit them) -> count == 0 ==
// n_declared -> UNDECLARED does not fire. A loader that pre-populates
// declared_caps from some other channel while M1-era pragmas elide the
// KIND_CAP ordinal MUST pass n_declared=0 and apply its caps outside
// the checker, or wait for the pragma parser's KIND_CAP extension.
//
// =============================================================================
// SECTION 6  REGISTER PLAN
// =============================================================================
//
// _pds_cdc_check -- 5 callee-save pushes + sub rsp, 16 (local spill):
//
//     push rbx    rbx = pragmas_ptr                 (needed in §5 scan)
//     push r12    r12 = n_pragmas                   (needed in §5 scan)
//     push r13    r13 = declared_caps_ptr           (needed in main loop)
//     push r14    r14 = n_declared                  (needed in main loop)
//     push r15    r15 = grant_env_handle            (needed in main loop)
//     sub rsp, 16
//                 [rsp+0]  = i   (loop counter, survives cap_env_lookup)
//                 [rsp+8]  = declared.rights (saved across cap_env_lookup)
//
// Entry rsp%16==8; +5 pushes = +40 -> rsp%16==0; +sub16 -> rsp%16==0
// (call-ready at the nested cap_env_lookup / klog_s1 calls).
//
// =============================================================================
// SECTION 7  ENCODER DISCIPLINE  (feedback_pdx_encoder_pitfalls)
// =============================================================================
//
//   * cmp rN, 0          never `test rN, rN`
//   * `and rN, imm8/32`  OK (bit 31 clear, sign-ext safe)
//   * `and rN, imm64`    FORBIDDEN -- stage via `mov r10, imm64; and`
//   * no `imul r, imm`   2-op register `imul r, r` IS supported
//   * strides            DeclaredCap=16 -> shl 4; PdsHpRecord=32 -> shl 5
//   * single-line `pub let` strings (one line per literal)
//   * module basename    `CapDeclCheck` matches `cap_decl_check.pdx`
//   * fingerprint tags   N = len(string) + 1  (NUL counted)
//   * labels prefixed    `pds_cdc_` (reserved-word discipline)
//   * narrow-only        `mov rax, req; and rax, par; cmp rax, req` --
//                        avoids the `not reg` encoder gap, mirrors
//                        R125.M2 _cap_minter_derive step 7.
//
// =============================================================================

module CapDeclCheck = structure {

  // ==========================================================================
  // SECTION 8  CONSTANTS
  // ==========================================================================

  // Return codes (§1).
  pub let PDS_CDC_OK                     : u64 = 0
  pub let PDS_CDC_ERR_UNDECLARED         : u64 = 0x3100
  pub let PDS_CDC_ERR_RIGHTS_WIDEN       : u64 = 0x3101
  pub let PDS_CDC_ERR_GRANT_INSUFFICIENT : u64 = 0x3102
  pub let PDS_CDC_ERR_BAD_PRAGMA         : u64 = 0x3103

  // DeclaredCap record geometry.
  pub let PDS_CDC_DECLARED_SIZE          : u64 = 16     // {u64 name_hash, u64 rights}
  pub let PDS_CDC_DECLARED_OFF_HASH      : u64 = 0
  pub let PDS_CDC_DECLARED_OFF_RIGHTS    : u64 = 8

  // PdsHpRecord geometry (mirrors R227.M1 header_pragma.pdx §2).
  pub let PDS_CDC_PRAGMA_SIZE            : u64 = 32
  pub let PDS_CDC_PRAGMA_OFF_KIND        : u64 = 0      // u16

  // KIND_CAP ordinal reserved for the pragma parser's follow-up milestone.
  // Numerically distinct from PDS_HP_KIND_* ordinals 1..4 (version,
  // strict, charset, history_default_cap). KIND_CAP = 5.
  pub let PDS_CDC_KIND_CAP               : u64 = 5

  // Hash -> slot bridge (§3). Mirrors caps_decl_loader.pdx §1.
  pub let PDS_CDC_SLOT_MASK              : u64 = 0xFF
  pub let PDS_CDC_SLOTS                  : u64 = 6      // KindCapEnv.CAP_ENV_SLOTS

  // Mask for u16 kind read.
  pub let PDS_CDC_U16_MASK               : u64 = 0xFFFF

  // ==========================================================================
  // SECTION 9  KLOG FINGERPRINT TAGS  (N = len(string) + 1, NUL inclusive)
  // ==========================================================================
  //
  // 1-line per literal (single-line `pub let` discipline).
  //
  //   "pds.cdc: undeclared"       = 19 + NUL -> N=20
  //   "pds.cdc: rights widen"     = 21 + NUL -> N=22
  //   "pds.cdc: grant insuff"     = 21 + NUL -> N=22
  //   "pds.cdc: bad pragma"       = 19 + NUL -> N=20
  //   "pds.cdc: ok"               = 11 + NUL -> N=12
  pub let pds_cdc_tag_undeclared  : [u8; 20] = "pds.cdc: undeclared\0"
  pub let pds_cdc_tag_rights_wide : [u8; 22] = "pds.cdc: rights widen\0"
  pub let pds_cdc_tag_grant_insuf : [u8; 22] = "pds.cdc: grant insuff\0"
  pub let pds_cdc_tag_bad_pragma  : [u8; 20] = "pds.cdc: bad pragma\0"
  pub let pds_cdc_tag_ok          : [u8; 12] = "pds.cdc: ok\0"

  // ==========================================================================
  // SECTION 10  _pds_cdc_count_cap_pragmas(pragmas_ptr, n_pragmas) -> u64
  //
  // Pure leaf. Counts PdsHpRecord entries whose u16 kind at offset 0
  // equals PDS_CDC_KIND_CAP. Stride is PDS_CDC_PRAGMA_SIZE = 32 (= shl 5,
  // no `imul`). u16 kind is read as a full u64 and masked low-16 via the
  // elf_lite dialect (no movzx; no `byte ptr` / `word ptr`; no r*d size
  // qualifiers).
  //
  // Register plan: pure leaf, no callee-save pushes. rax = count, rcx = i,
  // r10 = per-iteration scratch, r11 = pragmas_ptr saved. Entry rsp%16==8
  // undisturbed on exit.
  // ==========================================================================
  pub let _pds_cdc_count_cap_pragmas : (u64, u64) -> u64 !{mem} @{} =
    fn (pragmas_ptr: u64) (n_pragmas: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "UMB-W28 R227.M2 (paideia-os #2704): count PdsHpRecord entries whose u16 kind equals PDS_CDC_KIND_CAP (5). Pure leaf -- no pushes, no nested calls, no stack use. Stride 32 via `shl rN, 5` (no 2-op imul with immediate per encoder-pitfalls memory). u16 kind read as full u64 + `and rN, 0xFFFF` mask (dialect per src/kernel/core/elf/caps_decl_loader.pdx; no movzx, no size qualifiers). Compare uses `cmp rN, imm32` directly (5 fits imm8 sign-ext safe). Loop counter in rcx (caller-save; no nested call clobbers it). Labels prefixed pds_cdc_cp_.",
      block: {
        xor rax, rax;                     // count = 0
        xor rcx, rcx;                     // i = 0
        mov r11, rdi;                     // r11 = pragmas_ptr

      pds_cdc_cp_loop:
        cmp rcx, rsi;
        jae pds_cdc_cp_done;

        // rec_ptr = pragmas_ptr + i * 32
        mov r10, rcx;
        shl r10, 5;                       // * 32
        add r10, r11;

        // kind = u16 @ [rec_ptr + 0]: load u64, mask low 16.
        mov r8, [r10 + 0];
        mov r9, 0xFFFF;
        and r8, r9;

        cmp r8, 5;                        // PDS_CDC_KIND_CAP
        jne pds_cdc_cp_next;
        add rax, 1;

      pds_cdc_cp_next:
        add rcx, 1;
        jmp pds_cdc_cp_loop;

      pds_cdc_cp_done:
        ret
      }
    }

  // ==========================================================================
  // SECTION 11  _pds_cdc_check(pragmas_ptr, n_pragmas,
  //                            declared_caps_ptr, n_declared,
  //                            grant_env_handle) -> errno
  //
  // The primary M2 entry point. Full flow:
  //
  //   1. Call _pds_cdc_count_cap_pragmas(pragmas_ptr, n_pragmas) ->
  //      count. If count != n_declared -> ERR_UNDECLARED.
  //   2. If n_declared == 0 -> OK (nothing more to check).
  //   3. For i in 0..n_declared:
  //        a. Load declared.name_hash (u64 @ [rec+0]).
  //           If 0 -> ERR_BAD_PRAGMA.
  //        b. Load declared.rights (u64 @ [rec+8]). Spill to [rsp+8]
  //           so cap_env_lookup can clobber caller-save regs.
  //        c. parent_slot = (name_hash & 0xFF) mod PDS_CDC_SLOTS.
  //        d. cap_env_lookup(grant_env_handle, parent_slot) -> granted.
  //           If granted == 0 -> ERR_GRANT_INSUFFICIENT.
  //        e. Narrow-only invariant:
  //              rax = declared & granted;
  //              if rax != declared -> ERR_RIGHTS_WIDEN.
  //        f. Advance i; loop.
  //   4. Emit `pds.cdc: ok` fingerprint; return OK.
  //
  // Register plan: 5 callee-save pushes + sub rsp, 16 (see §6). The
  // nested calls (_pds_cdc_count_cap_pragmas, cap_env_lookup, klog_s1)
  // each see rsp%16==0 at entry. Loop counter in [rsp+0], declared.rights
  // spill in [rsp+8].
  // ==========================================================================
  pub let _pds_cdc_check : (u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (pragmas_ptr: u64) (n_pragmas: u64) (declared_caps_ptr: u64) (n_declared: u64) (grant_env_handle: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "UMB-W28 R227.M2 (paideia-os #2704): pds cap-decl checker. Validates that `declared_caps[0..n_declared]` satisfy the narrow-only invariant against `grant_env_handle`. Pure predicate -- NO mint, NO env mutation, NO cap_table traffic. Flow: (a) cross-check pragma KIND_CAP count against n_declared (ERR_UNDECLARED on mismatch); (b) per-record: name_hash==0 -> ERR_BAD_PRAGMA; cap_env_lookup via (name_hash & 0xFF) mod CAP_ENV_SLOTS bridge (same convention as R125.M3 caps_decl_loader); lookup == 0 -> ERR_GRANT_INSUFFICIENT; (declared & granted) != declared -> ERR_RIGHTS_WIDEN. Narrow-only idiom `mov rax, req; and rax, par; cmp rax, req` mirrors R125.M2 _cap_minter_derive step 7 and avoids the paideia-as `not reg` encoder gap. Rights-mask slot read matches R125.M4 cap_check §2 (stored u64 interpreted as a rights mask directly; cap_table dereference lands at M5+ without API change). Encoder discipline: cmp rN,0 (never test); stride 16 via shl 4 (never 2-op imul-imm); `and rN, 0xFF` is imm8 sign-ext safe; single-line pub let; module basename CapDeclCheck matches cap_decl_check.pdx. 5 callee-save pushes (rbx=pragmas_ptr, r12=n_pragmas, r13=declared_caps_ptr, r14=n_declared, r15=grant_env_handle) + sub rsp,16 ([rsp+0]=i loop, [rsp+8]=declared.rights spill across cap_env_lookup). Labels prefixed pds_cdc_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 16;

        mov rbx, rdi;                     // pragmas_ptr
        mov r12, rsi;                     // n_pragmas
        mov r13, rdx;                     // declared_caps_ptr
        mov r14, rcx;                     // n_declared
        mov r15, r8;                      // grant_env_handle

        // ------------------------------------------------------------------
        // Step 1: UNDECLARED cross-check.
        //   count = _pds_cdc_count_cap_pragmas(pragmas_ptr, n_pragmas)
        //   if count != n_declared -> ERR_UNDECLARED
        // ------------------------------------------------------------------
        mov rdi, rbx;
        mov rsi, r12;
        call _pds_cdc_count_cap_pragmas;

        cmp rax, r14;
        jne pds_cdc_undeclared;

        // ------------------------------------------------------------------
        // Step 2: trivial pass if n_declared == 0.
        // ------------------------------------------------------------------
        cmp r14, 0;
        je  pds_cdc_ok;

        // ------------------------------------------------------------------
        // Step 3: per-record loop.
        // ------------------------------------------------------------------
        mov rax, 0;
        mov [rsp + 0], rax;               // i = 0

      pds_cdc_loop:
        mov rax, [rsp + 0];
        cmp rax, r14;
        jae pds_cdc_ok;

        // rec_ptr = declared_caps_ptr + i * 16
        mov r10, rax;
        shl r10, 4;                       // * 16
        add r10, r13;                     // rec_ptr

        // name_hash = [rec_ptr + 0]
        mov r9, [r10 + 0];
        cmp r9, 0;
        je  pds_cdc_bad_pragma;

        // declared.rights = [rec_ptr + 8]; spill across cap_env_lookup.
        mov r11, [r10 + 8];
        mov [rsp + 8], r11;

        // parent_slot = (name_hash & 0xFF) mod PDS_CDC_SLOTS (= 6).
        mov rax, r9;
        and rax, 0xFF;                    // imm8 sign-ext safe
      pds_cdc_mod6:
        cmp rax, 6;
        jb  pds_cdc_mod6_done;
        sub rax, 6;
        jmp pds_cdc_mod6;
      pds_cdc_mod6_done:

        // cap_env_lookup(grant_env_handle, parent_slot) -> rax
        mov rdi, r15;                     // grant_env_handle
        mov rsi, rax;                     // parent_slot
        call cap_env_lookup;

        cmp rax, 0;
        je  pds_cdc_grant_insuff;

        // Narrow-only invariant: (declared & granted) == declared.
        //   r11 = declared.rights, rax = granted
        //   rcx = declared & granted; cmp rcx, declared; jne widen
        mov r11, [rsp + 8];
        mov rcx, r11;
        and rcx, rax;
        cmp rcx, r11;
        jne pds_cdc_rights_widen;

        // Next iteration.
        mov rax, [rsp + 0];
        add rax, 1;
        mov [rsp + 0], rax;
        jmp pds_cdc_loop;

        // ------------------------------------------------------------------
        // Success path: emit `pds.cdc: ok` fingerprint and return 0.
        // ------------------------------------------------------------------
      pds_cdc_ok:
        mov rdi, 3;                       // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + pds_cdc_tag_ok];
        call klog_s1;
        xor rax, rax;                     // PDS_CDC_OK
        jmp pds_cdc_out;

        // ------------------------------------------------------------------
        // Error paths: one klog_s1 fingerprint + packed errno.
        // ------------------------------------------------------------------
      pds_cdc_undeclared:
        mov rdi, 2;                       // LEVEL_WARN
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + pds_cdc_tag_undeclared];
        call klog_s1;
        mov rax, 0x3100;                  // PDS_CDC_ERR_UNDECLARED
        jmp pds_cdc_out;

      pds_cdc_rights_widen:
        mov rdi, 2;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + pds_cdc_tag_rights_wide];
        call klog_s1;
        mov rax, 0x3101;                  // PDS_CDC_ERR_RIGHTS_WIDEN
        jmp pds_cdc_out;

      pds_cdc_grant_insuff:
        mov rdi, 2;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + pds_cdc_tag_grant_insuf];
        call klog_s1;
        mov rax, 0x3102;                  // PDS_CDC_ERR_GRANT_INSUFFICIENT
        jmp pds_cdc_out;

      pds_cdc_bad_pragma:
        mov rdi, 2;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + pds_cdc_tag_bad_pragma];
        call klog_s1;
        mov rax, 0x3103;                  // PDS_CDC_ERR_BAD_PRAGMA

      pds_cdc_out:
        add rsp, 16;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
