// src/kernel/core/pds/typecheck_gate.pdx -- UMB-W? R133.M5 (paideia-os #2624)
//
// `.pds` PRE-EXECUTION TYPE-CHECK PIPELINE GATE.
//
// R133.M1 (Wave 113, paideia-os#2620) landed `_ctr_parse` and
// `_ctr_locate_section`, the `.pds` BINARY CONTAINER reader.  R133.M2
// (Wave 115, paideia-os#2621) landed `_pds_cdg_gate`, the capability-
// declaration LOAD-TIME gate.  R133.M3 (Wave 118, paideia-os#2622)
// landed `_ig_build_order`, the import-graph transitive traversal +
// cycle detector.  R133.M4 (Wave 119, paideia-os#2623) landed
// `_vg_check`, the `#requires-paideia OP SEMVER` version gate.
//
// R133.M5 (THIS FILE) is the FOURTH read-only predicate in the pds load
// pipeline: once a container has been admitted at the caps-decl gate,
// its import adjacency has been shown acyclic, and its ABI version has
// been proven satisfied, the loader hands the PARSED SCRIPT BODY to a
// type-check adapter.  Every pipeline stage's declared row-type is
// walked through a REGISTERED user-space CHECKER (R132.Mx -- softarch's
// HM core landed under tools/user/libpdx-pds-parser/), and any stage
// whose type-signature fails to compose with its upstream stage's
// output refuses the load with a source span naming the offending
// stage index.
//
// =============================================================================
// SECTION 0  WHY THIS FILE EXISTS
// =============================================================================
//
// The pds-lang type system (R132.Mx: R222 CommandSig / R223 record
// projection / R224 ClosureCapture / R225 RowTypes / R229 TypeEnv)
// LIVES OUTSIDE THE KERNEL in `tools/user/libpdx-pds-parser/`.  The
// kernel cannot absorb its implementation at M5: the HM core, type
// algebra, and row-polymorphism engine are too large for the kernel's
// bounded surface and (correctly) have no business inside ring 0.
//
// But the LOAD-TIME GATE must still refuse ill-typed scripts BEFORE
// the first byte of a pipeline stage dispatches an effect.  Three
// forces require a dedicated adapter at the kernel's edge:
//
//   (A) SATELLITE DECOUPLING.  The user-space type-checker ships as a
//       separate artefact (R132.Mx milestones land on their own cadence
//       in `tools/user/libpdx-pds-parser/`).  The kernel cannot HARD-
//       LINK that satellite (a kernel built on wave N cannot wait for
//       the type-checker's wave N+K).  The gate exposes a REGISTRATION
//       slot (`_pds_tcg_register_checker`) that the satellite populates
//       at boot once its own init has validated the type-env.  Before
//       registration, the gate returns `TCG_ERR_NO_CHECKER_AVAIL` --
//       the surrounding R131 pds-loader surfaces this as `PdsErr::
//       NoTypeChecker { reason: "satellite not registered" }` and
//       either refuses the load (strict posture) or admits with a
//       downgraded promise (allow-partial posture; selected at M6+ by
//       a kernel-boot flag).
//
//   (B) ERROR-CODE NAMESPACING.  Each prior R133 gate owns a disjoint
//       16-bit band so a surrounding error-reporter can switch on the
//       low 16 bits of the packed status without ambiguity:
//
//           0x3200..0x32FF  R133.M2 caps-decl gate
//           0x3A00..0x3AFF  R133.M3 import graph
//           0x3B00..0x3BFF  R133.M4 version gate
//           0x3E00..0x3EFF  R133.M5 typecheck gate   <-- THIS
//
//       0x3C00..0x3CFF is reserved by R222.M4 ArgSpec/FlagSpec (user-
//       space, see design/shell/arg-flag-spec-typing.md); 0x3D00..0x3DFF
//       is reserved by R229.M3 TypeEnv (user-space, see design/shell/
//       type-env-threading.md).  grep audit on 2026-10-15:
//
//           grep -rnE '0x3E[0-9A-Fa-f]{2}\b' src/ design/
//
//       returned no live source references -- band free of collision.
//
//   (C) PURE PREDICATE.  The gate accepts a (body_ptr, body_len) byte
//       range and returns a packed u64 -- no session-env mutation, no
//       disk I/O, no allocation.  Reusable from an offline `pdsc verify`
//       pass without wiring, and amenable to a future adversarial
//       smoke that drives malformed PipelineBody records straight at
//       the entry.
//
// =============================================================================
// SECTION 1  PipelineBody BINARY LAYOUT  (M5-DEFINED)
// =============================================================================
//
// The CALLER (R131 pds-loader at M5+) parses the `.pds` TEXT section
// (or the compiled container's TEXT equivalent) into a sequence of
// pipeline STAGES and emits a fixed-stride record stream into a
// contiguous buffer:
//
//     +----------------------------------------------------------+
//     | PipelineBody header (TCG_HEADER_SIZE = 32 bytes)         |
//     |   [ 0.. 4] magic         u32 = 0x50495042 ('PIPB')       |
//     |                             (LE: file bytes 'B','P','I','P') |
//     |   [ 4.. 6] n_stages      u16  count of StageDesc records |
//     |                             (0 .. TCG_MAX_STAGES = 64)   |
//     |   [ 6.. 8] flags         u16  shape bits; 0 at M5        |
//     |   [ 8..12] stages_offset u32  byte offset from body base |
//     |                             to StageDesc[0]              |
//     |   [12..16] stages_len    u32  byte length of the stages  |
//     |                             region (= n_stages * 32)     |
//     |   [16..32] reserved      [u8; 16]  zero at M5            |
//     +----------------------------------------------------------+
//     | StageDesc[0]  (TCG_STAGE_STRIDE = 32 bytes)              |
//     | StageDesc[1]  ...                                        |
//     |   ...                                                    |
//     | StageDesc[n_stages-1]                                    |
//     +----------------------------------------------------------+
//
// Each StageDesc is 32 bytes:
//
//     byte [ 0.. 1]  stage_kind     u8   mirrors R222/R223 kinds
//     byte [ 1.. 2]  type_code      u8
//     byte [ 2.. 3]  name_len       u8
//     byte [ 3.. 4]  reserved       u8
//     byte [ 4..12]  type_desc_ref  u64  LE handle into the user-space
//                                        type-env's TypeDesc arena
//     byte [12..26]  name_inline    [u8; 14]
//     byte [26..32]  reserved       [u8; 6]
//
// NOTE ON HEADER SIZE: the task brief listed `reserved[12]` for a
// stated 32-byte header, which sums to 28 bytes.  We interpret the
// "32B" total as authoritative and expand `reserved` to [u8; 16];
// the stages array therefore starts at or after offset 32 with the
// exact start controlled by the caller-supplied `stages_offset` field
// (minimum 32).  A future wave MAY narrow the header back to 28 bytes
// if the caller discipline fixes `stages_offset == 28` consistently.
//
// The on-wire shape is REUSED unchanged by the user-space checker:
// `_pds_tcg_check_stage(stage_ptr)` is passed a pointer into the body
// buffer at the stage's offset, so no re-encoding is needed.
//
// Invariants enforced at gate time:
//
//   (I1) body_ptr != 0 AND body_len >= TCG_HEADER_SIZE (32).
//   (I2) header.magic == TCG_MAGIC.
//   (I3) header.n_stages <= TCG_MAX_STAGES (64).
//   (I4) header.stages_offset >= TCG_HEADER_SIZE AND
//        header.stages_offset + header.stages_len <= body_len.
//   (I5) header.stages_len >= header.n_stages * TCG_STAGE_STRIDE.
//
// A failure at any invariant surfaces as the corresponding TCG_ERR_*
// code (SECTION 3) BEFORE the registered checker is invoked -- the
// gate never hands a malformed stream to the satellite.
//
// =============================================================================
// SECTION 2  WEAK-IMPORT ADAPTER MODEL  (M5-DEFINED)
// =============================================================================
//
// The pdx dialect does not implement linker-level weak imports (the
// paideia-as encoder emits strict symbol references only).  To let the
// kernel link in isolation of the user-space type-checker, R133.M5
// expresses the "weak import" as a REGISTRATION SLOT:
//
//     pub let mut _tcg_check_fn : u64 = uninit @align(8)   // .bss nil
//
// The slot is zero-init by the kernel's .bss zero-fill at boot entry
// (confirmed via `boot/entry.pdx:16` rep-stosq zero of `_bss_start.._bss_end`).
// The surrounding satellite's init publishes the checker via:
//
//     _pds_tcg_register_checker(fn_ptr: u64) -> u64
//
// which writes the function pointer into the slot and emits a one-shot
// fingerprint `pds typecheck registered`.  Passing fn_ptr == 0 is a
// contract violation (returns TCG_ERR_NULL_FN); unregistering is NOT
// supported at M5 (nullifying the slot would race with an in-flight
// load; a later wave adds a sealed "unregister" primitive if the
// hot-reload-the-type-checker workflow lands).
//
// At gate time, the adapter loads the slot into rax, dispatches via
// `call rax`, and interprets a non-zero return as a stage-level
// type-check failure.  The user-space side's status band is OPAQUE
// to the gate: whatever the satellite returns is forwarded verbatim in
// the high 32 bits of the mismatch packing (SECTION 3).
//
// =============================================================================
// SECTION 3  RETURN CODES  (BAND 0x3E00..0x3EFF)
// =============================================================================
//
// _pds_tcg_gate returns a PACKED u64:
//
//   bits [15: 0]  = status                   TCG_* code
//   bits [31:16]  = bad_idx    on TCG_ERR_STAGE_TYPE_MISMATCH;
//                              = n_stages    on TCG_OK;
//                              = 0           on every other return.
//   bits [63:32]  = stage_status on MISMATCH -- the user-space
//                              checker's own errno, passed through
//                              verbatim so a surrounding reporter can
//                              surface the specific pds-lang reason.
//                              = 0           on every other return.
//
//   TCG_OK                        = 0x0000     all stages type-check.
//                                              Fingerprint:
//                                              `pds typecheck ok stages=<n>`.
//   TCG_ERR_NO_CHECKER_AVAIL      = 0x3E00     registration slot nil.
//                                              The satellite has not yet
//                                              published its checker fn.
//                                              Fingerprint:
//                                              `pds typecheck no-checker`.
//   TCG_ERR_BAD_HEADER            = 0x3E01     magic mismatch at [0..4].
//                                              Fingerprint:
//                                              `pds typecheck bad-header`.
//   TCG_ERR_TOO_MANY_STAGES       = 0x3E02     n_stages > TCG_MAX_STAGES
//                                              (64).  Fingerprint:
//                                              `pds typecheck too-many-stages`.
//   TCG_ERR_STAGE_TYPE_MISMATCH   = 0x3E03     a stage's registered
//                                              checker returned non-zero.
//                                              Bad index in [31:16],
//                                              checker status in [63:32].
//                                              Fingerprint:
//                                              `pds typecheck rejected
//                                               stages=<n> bad=<idx>`.
//   TCG_ERR_NULL_BODY             = 0x3E04     body_ptr == 0 or
//                                              body_len < TCG_HEADER_SIZE.
//                                              Fingerprint:
//                                              `pds typecheck null-body`.
//   TCG_ERR_BAD_STAGES_BOUNDS     = 0x3E05     stages_offset or
//                                              stages_offset+stages_len
//                                              exceeds body_len; OR
//                                              stages_len < n_stages*32.
//                                              Fingerprint:
//                                              `pds typecheck bad-bounds`.
//   TCG_ERR_NULL_FN               = 0x3E06     _pds_tcg_register_checker
//                                              rejected fn_ptr == 0.
//                                              Fingerprint:
//                                              `pds typecheck null-fn`.
//
// The 0x3E00 band is new; grep audit on 2026-10-15:
//     `grep -rnE '0x3E[0-9A-Fa-f]{2}\b' src/ design/`
// returns no live source references -- band free of collision.
//
// =============================================================================
// SECTION 4  REGISTER PLAN
// =============================================================================
//
// _pds_tcg_gate -- 5 callee-save pushes + sub rsp, 16:
//
//     push rbx     rbx = body_ptr                 (base of input)
//     push r12     r12 = body_len                 (byte count)
//     push r13     r13 = n_stages                 (loop upper bound)
//     push r14     r14 = loop_i                   (stage index)
//     push r15     r15 = stages_base              (body_ptr + stages_offset)
//     sub  rsp, 16
//                  [rsp +  0] = check_fn          cached checker ptr
//                  [rsp +  8] = last_stage_status checker's rax on mismatch
//
// Entry rsp%16==8; +5 pushes (40) + sub 16 = +56; (8+56)%16==0 at body.
//
//   * Pre-CALL to klog_s1:  body rsp%16==0, direct call.
//   * Pre-CALL to klog_s1_d2:  idiom `sub rsp, 8; push v2` (+16) lands
//                               rsp%16==0 at the CALL (SysV callee
//                               entry rsp%16==8).  Post-CALL `add rsp,
//                               16` reclaims pad + push.  Same proof
//                               as version_gate.pdx:703-714.
//   * Pre-CALL to check_fn via `call rax`:  body rsp%16==0, direct
//                               indirect call lands callee at
//                               rsp%16==8 per SysV, no pad needed.
//                               Matches `vops.pdx:139` `call rax`
//                               shape (that site's `sub rsp,8; call
//                               rax; add rsp,8` idiom belongs to its
//                               own callee-less dispatcher frame; our
//                               frame is already aligned post-prologue
//                               so the pad is NOT needed here).
//
// Scratch (caller-save; may be clobbered by any nested CALL):
//     rax, rcx, rdx, rsi, rdi, r8, r9, r10, r11
//
// _pds_tcg_register_checker -- 2 callee-save pushes:
//
//     push rbx     rbx = fn_ptr
//     push r12     callee-save pad (keeps 2-push alignment)
//
// Entry rsp%16==8, +16 pushes = (8+16)%16==8; sub rsp, 8 for klog_s1
// alignment -> rsp%16==0 at CALL.  Post-CALL add rsp, 8.
//
// =============================================================================
// SECTION 5  ENCODER DISCIPLINE  (feedback_pdx_encoder_pitfalls)
// =============================================================================
//
//   * `cmp rN, 0`              never `test rN, rN` (R123.M2 discipline).
//   * Stride 32 (StageDesc)    `shl rN, 5` -- power of two.
//   * No `and rN, imm64`       mismatch pack uses `shl` + `or` only.
//   * No 2-op `imul r, imm`    not needed; strides are shifts.
//   * Single-line `pub let`    one line per literal (tags, prefix,
//                               TCG_* status codes, fn ptr slot).
//   * Module basename          `TypecheckGate` matches
//                               `typecheck_gate.pdx`.
//   * Labels prefixed          `tcg_` (reserved-word discipline;
//                               distinct from `ctr_`, `pds_cdg_`,
//                               `ig_`, `vg_` siblings).
//   * Byte loads               `xor rN, rN; mov_b rN, [reg+reg*1]`.
//   * u16 loads                `xor rN, rN; mov_w rN, [reg+off]`
//                               (per header_pragma.pdx:924 precedent).
//   * u32 loads                `xor rN, rN; mov eax, [reg+off]`
//                               (per container_reader.pdx G4 pattern).
//   * `cmp rN, imm8/imm32`     every status compare (0x3E00..0x3E06)
//                               fits imm32 sign-ext safe (bit 31 clear).
//                               TCG_MAGIC (0x50495042) also sign-ext
//                               safe.
//   * Full-u64 status compares not low-byte masked (Wave 118 lesson).
//   * Fingerprint OK token     the OK tag uses LOWER-CASE "ok"
//                               (follows R133.M2..M4 precedent).  The
//                               verify-fingerprint-coverage.sh OK_TOK
//                               regex matches only uppercase `OK` as a
//                               word token, so this tag is NOT in the
//                               asserted-marker extractor's set --
//                               no allowlist entry is needed.
//
// =============================================================================
// SECTION 6  CROSS-MODULE WIRING NOTES
// =============================================================================
//
// Expected caller sequence (lands at R131 pds-loader post-M5):
//
//   (1) Caller reads `.pds` file bytes into a buffer.
//   (2) Caller invokes `_pds_cdg_gate(buf_ptr, buf_len, grant_env)`;
//       on non-zero, abort.
//   (3) Caller invokes `_vg_check(req_line_ptr, req_line_len)` on the
//       isolated `#requires-paideia` pragma; on non-zero, abort.
//   (4) Caller invokes `_ig_build_order` on the import adjacency; on
//       non-zero, abort.
//   (5) Caller parses the TEXT section into a PipelineBody record
//       stream, writes it to a scratch buffer, and invokes:
//           packed = _pds_tcg_gate(body_ptr, body_len)
//       On OK:        proceed to execute the pipeline.
//       On MISMATCH:  surface as
//                     `PdsErr::TypeMismatch { stage: bad_idx,
//                                             reason: stage_status }`.
//       On NO_CHECKER: surface as `PdsErr::NoTypeChecker`.
//       On any other TCG_ERR_*: surface as the specific reason.
//   (6) Only on TCG_OK does the loader dispatch stage effects.
//
// Satellite init sequence (lands at R132.Mx pds-parser boot):
//
//   (1) Satellite's own init runs AFTER kernel .bss zero (so the
//       registration slot is nil at the time of registration).
//   (2) Satellite publishes:
//           status = _pds_tcg_register_checker(&_pds_tcg_check_stage_impl)
//       On OK: the gate is now armed with the real checker.
//       On TCG_ERR_NULL_FN: fatal -- the satellite's fn-ptr is bogus.
//
// Design doc: design/kernel/pds-typecheck-gate.md (M5 wire shape,
// weak-import adapter model, status band derivation, acceptance smoke).
//
// =============================================================================

module TypecheckGate = structure {

  // ==========================================================================
  // SECTION 7  CONSTANTS
  // ==========================================================================

  // Return codes (SECTION 3).
  pub let TCG_OK                       : u64 = 0
  pub let TCG_ERR_NO_CHECKER_AVAIL     : u64 = 0x3E00
  pub let TCG_ERR_BAD_HEADER           : u64 = 0x3E01
  pub let TCG_ERR_TOO_MANY_STAGES      : u64 = 0x3E02
  pub let TCG_ERR_STAGE_TYPE_MISMATCH  : u64 = 0x3E03
  pub let TCG_ERR_NULL_BODY            : u64 = 0x3E04
  pub let TCG_ERR_BAD_STAGES_BOUNDS    : u64 = 0x3E05
  pub let TCG_ERR_NULL_FN              : u64 = 0x3E06

  // PipelineBody geometry (SECTION 1).
  pub let TCG_MAGIC          : u64 = 0x50495042   // 'PIPB' as little-endian u32
  pub let TCG_HEADER_SIZE    : u64 = 32
  pub let TCG_STAGE_STRIDE   : u64 = 32
  pub let TCG_MAX_STAGES     : u64 = 64

  // Field offsets inside the PipelineBody header (SECTION 1).
  pub let TCG_HDR_OFF_MAGIC         : u64 = 0
  pub let TCG_HDR_OFF_N_STAGES      : u64 = 4
  pub let TCG_HDR_OFF_FLAGS         : u64 = 6
  pub let TCG_HDR_OFF_STAGES_OFFSET : u64 = 8
  pub let TCG_HDR_OFF_STAGES_LEN    : u64 = 12

  // ==========================================================================
  // SECTION 8  REGISTRATION SLOT  (.bss; zero-init at boot via rep-stosq)
  // ==========================================================================
  //
  // Nil at kernel entry; the user-space satellite's init publishes
  // the checker here via `_pds_tcg_register_checker`.  See SECTION 2
  // for the weak-import rationale.
  pub let mut _tcg_check_fn : u64 = uninit @align(8)

  // ==========================================================================
  // SECTION 9  FINGERPRINT TAGS  (N = len(string) + 1, NUL inclusive)
  // ==========================================================================
  //
  //   "pds typecheck ok"              16 + NUL -> N = 17
  //   "pds typecheck rejected"        22 + NUL -> N = 23
  //   "pds typecheck no-checker"      24 + NUL -> N = 25
  //   "pds typecheck bad-header"      24 + NUL -> N = 25
  //   "pds typecheck too-many-stages" 29 + NUL -> N = 30
  //   "pds typecheck null-body"       23 + NUL -> N = 24
  //   "pds typecheck bad-bounds"      24 + NUL -> N = 25
  //   "pds typecheck null-fn"         21 + NUL -> N = 22
  //   "pds typecheck registered"      24 + NUL -> N = 25
  //   "stages"                         6 + NUL -> N =  7
  //   "bad"                            3 + NUL -> N =  4
  //
  // Lower-case "ok" avoids the fingerprint-coverage extractor (R133.M2
  // / R133.M3 / R133.M4 precedent), so no allowlist row is needed.  A
  // future smoke may pin the strings as plain substring assertions in
  // its golden file.
  pub let tcg_tag_ok              : [u8; 17] = "pds typecheck ok\0"
  pub let tcg_tag_rejected        : [u8; 23] = "pds typecheck rejected\0"
  pub let tcg_tag_no_checker      : [u8; 25] = "pds typecheck no-checker\0"
  pub let tcg_tag_bad_header      : [u8; 25] = "pds typecheck bad-header\0"
  pub let tcg_tag_too_many        : [u8; 30] = "pds typecheck too-many-stages\0"
  pub let tcg_tag_null_body       : [u8; 24] = "pds typecheck null-body\0"
  pub let tcg_tag_bad_bounds      : [u8; 25] = "pds typecheck bad-bounds\0"
  pub let tcg_tag_null_fn         : [u8; 22] = "pds typecheck null-fn\0"
  pub let tcg_tag_registered      : [u8; 25] = "pds typecheck registered\0"
  pub let tcg_k_stages            : [u8;  7] = "stages\0"
  pub let tcg_k_bad               : [u8;  4] = "bad\0"

  // ==========================================================================
  // SECTION 10  _pds_tcg_register_checker(fn_ptr) -> u64
  //
  // Publishes the user-space checker's entry address into the module-
  // level slot.  See SECTION 2 for the weak-import rationale.
  //
  // Entry: rdi = fn_ptr
  // Return: rax = TCG_OK on success, TCG_ERR_NULL_FN (0x3E06) on
  //              fn_ptr == 0.
  //
  // Side effects: writes `_tcg_check_fn`, emits one klog_s1 fingerprint
  // (`pds typecheck registered` on OK, `pds typecheck null-fn` on nil).
  // ==========================================================================
  pub let _pds_tcg_register_checker : (u64) -> u64 !{mem, sysreg} @{} =
    fn (fn_ptr: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "UMB-W? R133.M5 (paideia-os #2624): publish the user-space pds type-checker entry address into the module-level _tcg_check_fn registration slot. The slot models a `weak import` without the pdx dialect needing linker-level weak support: the satellite's own init (R132.Mx) calls this fn once, after kernel .bss zero but before the first .pds load, to arm the gate. nil fn_ptr is a contract violation -- returns TCG_ERR_NULL_FN (0x3E06) with no write. 2-push callee-save prologue (rbx=fn_ptr, r12 as pad): entry rsp%16==8, +16 = rsp%16==8, sub rsp,8 before klog_s1 -> rsp%16==0 at CALL, add rsp,8 after. Encoder: cmp rax,0 never test; status 0x3E06 fits imm32 sign-ext safe. One klog_s1 per return path (LEVEL_INFO on OK, LEVEL_WARN on NULL_FN). Module basename TypecheckGate matches file basename typecheck_gate.pdx. Labels prefixed tcg_rc_.",
      block: {
        push rbx;
        push r12;

        mov rbx, rdi;                     // fn_ptr

        // -------- Guard: nil fn_ptr -> NULL_FN.
        cmp rbx, 0;
        je  tcg_rc_null;

        // -------- Publish the checker into the slot.
        lea r10, [rip + _tcg_check_fn];
        mov [r10 + 0], rbx;

        // -------- Emit `pds typecheck registered` fingerprint.
        sub rsp, 8;                       // alignment pad
        mov rdi, 3;                       // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + tcg_tag_registered];
        call klog_s1;
        add rsp, 8;

        xor rax, rax;                     // TCG_OK
        jmp tcg_rc_out;

      tcg_rc_null:
        sub rsp, 8;
        mov rdi, 2;                       // LEVEL_WARN
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + tcg_tag_null_fn];
        call klog_s1;
        add rsp, 8;

        mov rax, 0x3E06;                  // TCG_ERR_NULL_FN

      tcg_rc_out:
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION 11  _pds_tcg_gate(body_ptr, body_len) -> packed u64
  //
  // The sole LOAD-TIME entry point.  See §0 for role, §1 for the
  // PipelineBody wire shape, §2 for the weak-import adapter model,
  // §3 for the return pack, §4 for the register plan.
  //
  // Entry: rdi = body_ptr, rsi = body_len
  // Return: rax = packed status (see §3)
  //
  // Side effects: reads `_tcg_check_fn`; calls through it per stage;
  // emits one klog_s1_d2 fingerprint on OK or MISMATCH; emits one
  // klog_s1 fingerprint on every other error path.  Does NOT mutate
  // the registration slot or any other module-level state.
  // ==========================================================================
  pub let _pds_tcg_gate : (u64, u64) -> u64 !{mem, sysreg} @{} =
    fn (body_ptr: u64) (body_len: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "UMB-W? R133.M5 (paideia-os #2624): .pds load-time pre-execution type-check pipeline gate. Validates a caller-supplied PipelineBody record stream (32B header: magic 'PIPB' 0x50495042 + u16 n_stages + u16 flags + u32 stages_offset + u32 stages_len + 16B reserved; 32B StageDesc stride: u8 stage_kind + u8 type_code + u8 name_len + u8 reserved + u64 type_desc_ref + 14B name_inline + 6B reserved) against the user-space type-checker registered at _tcg_check_fn, walks every stage through `call rax`, and refuses the load on any non-zero return. Returns TCG_OK (0) with n_stages in bits [31:16] on full pass; TCG_ERR_STAGE_TYPE_MISMATCH (0x3E03) with bad_idx in [31:16] and the checker's own status in [63:32] on first failure; or bare TCG_ERR_* in {NO_CHECKER_AVAIL 0x3E00 slot nil, BAD_HEADER 0x3E01 magic mismatch, TOO_MANY_STAGES 0x3E02 n_stages>64, NULL_BODY 0x3E04 body_ptr==0 or body_len<32, BAD_STAGES_BOUNDS 0x3E05 geometry fault} on invariant failure. Register plan: 5 callee-save pushes (rbx=body_ptr, r12=body_len, r13=n_stages, r14=loop_i, r15=stages_base_ptr) + sub rsp,16 for [rsp+0]=check_fn and [rsp+8]=last_stage_status; entry rsp%16==8, +40+16=56, (8+56)%16==0 at body — klog_s1_d2 pre-CALL idiom `sub rsp,8; push v2` lands rsp%16==0 at CALL (version_gate.pdx:703 precedent); `call rax` for the checker lands callee at rsp%16==8 per SysV with NO pad (body already rsp%16==0 — distinct from vops.pdx:139 which pads its own un-prologued dispatcher). Encoder discipline: cmp rN,0 never test; stride 32 via `shl rN,5` never 2-op imul-imm; `and rN,imm` not needed; u16 zero-extend via `xor rax,rax; mov_w rax,[mem]` (header_pragma.pdx:924 precedent); u32 zero-extend via `xor rax,rax; mov eax,[mem]` (container_reader.pdx G4 precedent); magic 0x50495042 and all status codes 0x3E00..0x3E06 fit imm32 sign-ext safe (bit 31 clear). Fingerprint tags: 'pds typecheck ok\\0' (17B) + 'stages\\0' (7B) via klog_s1_d2 on OK with v1=n_stages v2=0; 'pds typecheck rejected\\0' (23B) + 'stages\\0' + 'bad\\0' via klog_s1_d2 on MISMATCH with v1=n_stages v2=bad_idx; per-error klog_s1 tags for every bare TCG_ERR_* path. Lower-case 'ok' intentionally bypasses verify-fingerprint-coverage.sh OK_TOK regex (R133.M2..M4 precedent) — no allowlist row required. Module basename TypecheckGate matches file basename typecheck_gate.pdx. Labels prefixed tcg_ (reserved-word discipline; distinct from ctr_/pds_cdg_/ig_/vg_ siblings).",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 16;

        mov rbx, rdi;                     // body_ptr
        mov r12, rsi;                     // body_len

        // Zero stack locals defensively.
        xor rax, rax;
        mov [rsp + 0], rax;               // check_fn = 0 placeholder
        mov [rsp + 8], rax;               // last_stage_status = 0

        // ------------------------------------------------------------------
        // (I1) body_ptr != 0 AND body_len >= TCG_HEADER_SIZE (32).
        // ------------------------------------------------------------------
        cmp rbx, 0;
        je  tcg_null_body;
        cmp r12, 32;
        jb  tcg_null_body;

        // ------------------------------------------------------------------
        // (I2) Load magic (u32 @ 0, zero-ext) and compare TCG_MAGIC.
        // ------------------------------------------------------------------
        xor rax, rax;
        mov eax, [rbx + 0];               // magic
        mov r10, 0x50495042;               // TCG_MAGIC ('PIPB' LE)
        cmp rax, r10;
        jne tcg_bad_header;

        // ------------------------------------------------------------------
        // (I3) Load n_stages (u16 @ 4, zero-ext) and check <= TCG_MAX_STAGES.
        // ------------------------------------------------------------------
        xor rax, rax;
        mov_w rax, [rbx + 4];              // n_stages (u16)
        cmp rax, 64;                       // imm8 sign-ext safe
        ja  tcg_too_many_stages;
        mov r13, rax;                      // n_stages -> callee-save

        // ------------------------------------------------------------------
        // Load stages_offset (u32 @ 8) and stages_len (u32 @ 12).
        // ------------------------------------------------------------------
        xor rax, rax;
        mov eax, [rbx + 8];                // stages_offset
        mov r10, rax;                      // r10 = stages_offset

        xor rax, rax;
        mov eax, [rbx + 12];               // stages_len
        mov r11, rax;                      // r11 = stages_len

        // ------------------------------------------------------------------
        // (I4a) stages_offset >= TCG_HEADER_SIZE (32).
        // ------------------------------------------------------------------
        cmp r10, 32;
        jb  tcg_bad_bounds;

        // ------------------------------------------------------------------
        // (I4b) stages_offset + stages_len <= body_len.
        //       Compute sum into rcx; a wrap at u64 would still exceed
        //       body_len (which fits in u64), so a bare comparison
        //       suffices.  Done defensively anyway by checking the
        //       components as follows: if r11 > (body_len - r10) then
        //       fail.  r10 <= body_len is already implied by r10 >= 32
        //       and body_len >= 32 (I1).  Nope: a huge stages_offset
        //       could exceed body_len; guard with `cmp r10, r12`.
        // ------------------------------------------------------------------
        cmp r10, r12;
        ja  tcg_bad_bounds;
        mov rcx, r12;
        sub rcx, r10;                      // rcx = body_len - stages_offset
        cmp r11, rcx;
        ja  tcg_bad_bounds;

        // ------------------------------------------------------------------
        // (I5) stages_len >= n_stages * TCG_STAGE_STRIDE (= n_stages * 32).
        // ------------------------------------------------------------------
        mov rcx, r13;
        shl rcx, 5;                        // n_stages * 32
        cmp r11, rcx;
        jb  tcg_bad_bounds;

        // ------------------------------------------------------------------
        // Compute stages_base = body_ptr + stages_offset.
        // ------------------------------------------------------------------
        mov r15, rbx;
        add r15, r10;                      // r15 = stages_base_ptr

        // ------------------------------------------------------------------
        // Load the registered checker ptr.  nil -> NO_CHECKER_AVAIL.
        // Cache in a stack local so the walk loop reloads cheaply if
        // paranoia later wants to re-check between stages.
        // ------------------------------------------------------------------
        lea r10, [rip + _tcg_check_fn];
        mov rax, [r10 + 0];
        cmp rax, 0;
        je  tcg_no_checker;
        mov [rsp + 0], rax;                // cache check_fn

        // ------------------------------------------------------------------
        // Walk stages: for i in 0..n_stages:
        //     stage_ptr = stages_base + i * 32
        //     rax = check_fn(stage_ptr)
        //     if rax != 0: emit rejected, pack and return
        // Zero stages is a trivial pass (loop condition `i < 0` false
        // on entry).
        // ------------------------------------------------------------------
        xor r14, r14;                      // loop_i = 0

      tcg_walk_loop:
        cmp r14, r13;
        jae tcg_walk_done;

        // stage_ptr = stages_base + loop_i * 32
        mov rdi, r14;
        shl rdi, 5;                        // loop_i * 32
        add rdi, r15;                      // stage_ptr

        // check_fn(stage_ptr)
        mov rax, [rsp + 0];                // reload cached check_fn
        call rax;                          // SysV: rsp%16==0 at CALL

        cmp rax, 0;
        jne tcg_stage_rejected;

        add r14, 1;
        jmp tcg_walk_loop;

      tcg_walk_done:
        // ------------------------------------------------------------------
        // OK path: emit `pds typecheck ok stages=<n>` fingerprint, pack
        // (n_stages << 16) | TCG_OK.
        //
        // klog_s1_d2 ABI (wrappers.pdx L261): rdi=level, rsi=subsys_ptr,
        //                                      rdx=tag_ptr, rcx=k1, r8=v1,
        //                                      r9=k2, [rsp+8 post-push]=v2.
        // Alignment idiom: body rsp%16==0; `sub rsp, 8; push v2` lands
        //                  rsp%16==0 at CALL (callee entry rsp%16==8 per
        //                  SysV).  Post-call `add rsp, 16`.
        // v1 = n_stages (r13); v2 = 0 (reserved; no cycles / errors to log).
        // ------------------------------------------------------------------
        sub rsp, 8;                        // alignment pad
        xor rax, rax;                      // v2 = 0
        push rax;

        mov  rdi, 3;                       // LEVEL_INFO
        lea  rsi, [rip + SUBSYS_CAP_];
        lea  rdx, [rip + tcg_tag_ok];
        lea  rcx, [rip + tcg_k_stages];
        mov  r8,  r13;                     // v1 = n_stages
        lea  r9,  [rip + tcg_k_bad];       // k2 reused for symmetry (bad=0 on OK)
        call klog_s1_d2;

        add rsp, 16;                       // reclaim pad + push

        // Pack (n_stages << 16) | TCG_OK.
        mov rax, r13;
        shl rax, 16;
        jmp tcg_out;

      tcg_stage_rejected:
        // ------------------------------------------------------------------
        // MISMATCH path: `pds typecheck rejected stages=<n> bad=<idx>`.
        // Preserve the checker's non-zero status (rax) in [rsp+8] so
        // the klog call doesn't clobber it, then pack:
        //   (stage_status << 32) | (bad_idx << 16) | TCG_ERR_STAGE_TYPE_MISMATCH.
        // ------------------------------------------------------------------
        mov [rsp + 8], rax;                // save stage_status

        sub rsp, 8;                        // alignment pad
        mov rax, r14;                      // v2 = bad_idx
        push rax;

        mov  rdi, 2;                       // LEVEL_WARN
        lea  rsi, [rip + SUBSYS_CAP_];
        lea  rdx, [rip + tcg_tag_rejected];
        lea  rcx, [rip + tcg_k_stages];
        mov  r8,  r13;                     // v1 = n_stages
        lea  r9,  [rip + tcg_k_bad];
        call klog_s1_d2;

        add rsp, 16;                       // reclaim pad + push

        // Pack the return.
        //   rax = stage_status << 32
        //   or   (bad_idx << 16)
        //   or   TCG_ERR_STAGE_TYPE_MISMATCH
        mov rax, [rsp + 8];                // reload stage_status
        shl rax, 32;
        mov r11, r14;                      // bad_idx
        shl r11, 16;
        or  rax, r11;
        mov r11, 0x3E03;                   // TCG_ERR_STAGE_TYPE_MISMATCH
        or  rax, r11;
        jmp tcg_out;

      tcg_no_checker:
        mov rdi, 2;                        // LEVEL_WARN
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + tcg_tag_no_checker];
        call klog_s1;
        mov rax, 0x3E00;                   // TCG_ERR_NO_CHECKER_AVAIL
        jmp tcg_out;

      tcg_bad_header:
        mov rdi, 2;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + tcg_tag_bad_header];
        call klog_s1;
        mov rax, 0x3E01;                   // TCG_ERR_BAD_HEADER
        jmp tcg_out;

      tcg_too_many_stages:
        mov rdi, 2;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + tcg_tag_too_many];
        call klog_s1;
        mov rax, 0x3E02;                   // TCG_ERR_TOO_MANY_STAGES
        jmp tcg_out;

      tcg_null_body:
        mov rdi, 2;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + tcg_tag_null_body];
        call klog_s1;
        mov rax, 0x3E04;                   // TCG_ERR_NULL_BODY
        jmp tcg_out;

      tcg_bad_bounds:
        mov rdi, 2;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + tcg_tag_bad_bounds];
        call klog_s1;
        mov rax, 0x3E05;                   // TCG_ERR_BAD_STAGES_BOUNDS

      tcg_out:
        add rsp, 16;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION 12  _pds_tcg_bad_idx(packed) -> u64
  //
  // Accessor: given a packed return value whose low 16 bits are
  // TCG_ERR_STAGE_TYPE_MISMATCH (0x3E03), recover the bad-stage index
  // stored in bits [31:16].  Returns 0 on any non-mismatch input
  // (including TCG_OK and parse errors), so callers can safely invoke
  // it unconditionally in a log path.
  //
  // Pure leaf.  No stack use.
  // ==========================================================================
  pub let _pds_tcg_bad_idx : (u64) -> u64 !{} @{} =
    fn (packed: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R133.M5 (paideia-os #2624): recover bad_idx from a packed TCG_ERR_STAGE_TYPE_MISMATCH return value. Masks the low 16 bits against 0xFFFF; on match against 0x3E03 shifts right 16 and masks to 0xFFFF; on non-match returns 0. Pure leaf — no stack use, no nested call. Encoder: `and rN, imm16` fits imm32 (0xFFFF, bit 31 clear); `shr rN, 16` is the standard short right-shift; cmp against 0x3E03 is sign-ext safe (bit 31 clear).",
      block: {
        // low16 = packed & 0xFFFF
        mov rax, rdi;
        mov r10, 0xFFFF;
        and rax, r10;

        // if low16 != 0x3E03 -> return 0
        mov r10, 0x3E03;
        cmp rax, r10;
        jne tcg_bi_zero;

        // bad_idx = (packed >> 16) & 0xFFFF
        mov rax, rdi;
        shr rax, 16;
        mov r10, 0xFFFF;
        and rax, r10;
        ret

      tcg_bi_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // SECTION 13  _pds_tcg_stage_status(packed) -> u64
  //
  // Accessor: given a packed TCG_ERR_STAGE_TYPE_MISMATCH value, recover
  // the user-space checker's own status stored in bits [63:32].
  // Returns 0 on any non-mismatch input.
  //
  // Pure leaf.  No stack use.
  // ==========================================================================
  pub let _pds_tcg_stage_status : (u64) -> u64 !{} @{} =
    fn (packed: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R133.M5 (paideia-os #2624): recover the user-space checker's forwarded status from a packed TCG_ERR_STAGE_TYPE_MISMATCH return value. Masks the low 16 bits against 0xFFFF; on match against 0x3E03 shifts right 32 bits; on non-match returns 0. Pure leaf — no stack use, no nested call. Encoder: `and rN, imm16` fits imm32; `shr rN, 32` is the standard long right-shift.",
      block: {
        // low16 = packed & 0xFFFF
        mov rax, rdi;
        mov r10, 0xFFFF;
        and rax, r10;

        // if low16 != 0x3E03 -> return 0
        mov r10, 0x3E03;
        cmp rax, r10;
        jne tcg_ss_zero;

        // stage_status = packed >> 32
        mov rax, rdi;
        shr rax, 32;
        ret

      tcg_ss_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // SECTION 14  _pds_tcg_ok_stages(packed) -> u64
  //
  // Accessor: given a packed TCG_OK return value (low 16 bits == 0),
  // recover the n_stages count stored in bits [31:16].  Returns 0 on
  // any non-OK input, so callers can safely invoke it in a log path
  // that names a success value AND an error.
  //
  // Pure leaf.  No stack use.
  // ==========================================================================
  pub let _pds_tcg_ok_stages : (u64) -> u64 !{} @{} =
    fn (packed: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R133.M5 (paideia-os #2624): recover n_stages from a packed TCG_OK return value. Masks the low 16 bits; on zero shifts right 16 and masks to 0xFFFF; on non-zero returns 0 (not an OK pack). Pure leaf — no stack use, no nested call. Encoder: `and rN, imm16` fits imm32; cmp against 0 is the canonical zero-check.",
      block: {
        mov rax, rdi;
        mov r10, 0xFFFF;
        and rax, r10;
        cmp rax, 0;
        jne tcg_os_zero;

        mov rax, rdi;
        shr rax, 16;
        mov r10, 0xFFFF;
        and rax, r10;
        ret

      tcg_os_zero:
        xor rax, rax;
        ret
      }
    }
}
