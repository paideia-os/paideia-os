// src/kernel/core/pds/version_gate.pdx -- UMB-W? R133.M4 (paideia-os #2623)
//
// `.pds` `#requires-paideia` LOAD-TIME VERSION GATE.
//
// R133.M1 (Wave 113, paideia-os#2620) landed `_ctr_parse` and
// `_ctr_locate_section`, the `.pds` BINARY CONTAINER reader.
// R133.M2 (Wave 115, paideia-os#2621) landed `_pds_cdg_gate`, the
// capability-declaration LOAD-TIME gate.  R133.M3 (Wave 118,
// paideia-os#2622) landed `_ig_build_order`, the import-graph
// transitive traversal + cycle detector.  R133.M4 (THIS FILE) is the
// third read-only predicate in the pds load pipeline: once a container
// has been admitted at the cap-decl gate and its import adjacency has
// been shown acyclic, the loader asserts the script's `#requires-
// paideia OP SEMVER` directive against the kernel's own
// `KERNEL_VERSION_(MAJOR|MINOR|PATCH)` triple.  Any mismatch refuses
// the load with `PdsErr::VersionMismatch` BEFORE a single TEXT byte
// is dispatched to the shell command decoder.
//
// =============================================================================
// SECTION 0  WHY THIS FILE EXISTS
// =============================================================================
//
// `#requires-paideia` pins the ABI contract the author wrote the
// script against: the kernel's command surface, effect taxonomy and
// capability shapes evolve, and a script compiled against `paideia 2.x`
// may legitimately refuse to run on a `0.x` kernel that has not yet
// minted the effects / capabilities the script's cap-decl references
// positionally.  Three forces require a dedicated gate layer:
//
//   (A) SEPARATION OF CONCERNS.  The caps-decl gate (R133.M2) is
//       parameterised over a KIND_CAP_ENV grant env; the version gate
//       is parameterised over the static kernel-version triple.
//       Collapsing them would couple an ABI-pin predicate to a session-
//       local env handle and preclude the use of the version gate as
//       a pure predicate in offline tools (e.g. a hypothetical
//       `pdsc verify` pass).
//
//   (B) ERROR-CODE NAMESPACING.  Cap-decl faults carry cap-shape
//       reasons (UNDECLARED, RIGHTS_WIDEN) in the 0x3200..0x32FF band;
//       import-graph faults carry traversal reasons (CYCLE, BAD_NODE)
//       in 0x3A00..0x3AFF.  Version-gate faults carry the ABI reason
//       (VERSION_MISMATCH plus parse errors) in a disjoint band so a
//       surrounding error-reporter can switch on the low 16 bits of the
//       packed status without ambiguity.
//
//   (C) REUSABILITY.  The parser accepts a byte-range `(ptr, len)`
//       and returns a packed u64.  It is reusable from the R133.M1
//       container reader's pragma extractor, the source-form
//       `_pds_hp_parse` pass, and the hypothetical offline `pdsc
//       verify` path without wiring.
//
// =============================================================================
// SECTION 1  DIRECTIVE GRAMMAR  (M4-DEFINED)
// =============================================================================
//
//     directive := "#requires-paideia" WS+ OP WS+ SEMVER
//     OP        := ">=" | "<=" | "~=" | ">" | "<" | "="
//     SEMVER    := DIGITS "." DIGITS [ "." DIGITS ]
//     DIGITS    := [0-9]+
//     WS        := " " | "\t"
//
// The parser scans greedily: `>=` matches before `>`, `<=` before `<`.
// Trailing whitespace / newline after the version is tolerated; the
// gate consumes exactly the directive and leaves the rest alone (the
// caller hands the gate only the single pragma line).
//
// `~=` is the "compatible with" op -- same major, equal-or-newer
// within that major.  Named `~=` because `^` is a bitxor token in
// pdx-lang.
//
// =============================================================================
// SECTION 2  COMPARISON SEMANTICS
// =============================================================================
//
// Three-way lex compare on `(major, minor, patch)`:
//
//     cmp3((hm,hn,hp), (rm,rn,rp)) =
//         HI    if hm > rm, or (hm==rm and hn > rn),
//                      or (hm==rm and hn==rn and hp > rp)
//         EQ    if (hm,hn,hp) == (rm,rn,rp)
//         LO    otherwise
//
// Op dispatch:
//
//     =    satisfied when cmp == EQ
//     >=   satisfied when cmp in {HI, EQ}
//     <=   satisfied when cmp in {LO, EQ}
//     >    satisfied when cmp == HI
//     <    satisfied when cmp == LO
//     ~=   satisfied when have.major == req.major AND cmp in {HI, EQ}
//
// The internal three-way result is encoded as rsi in {0 (LO), 1 (EQ),
// 2 (HI)} so each dispatch arm uses an imm8-fit cmp.
//
// =============================================================================
// SECTION 3  RETURN CODES  (BAND 0x3B00..0x3BFF)
// =============================================================================
//
// _vg_check returns a PACKED u64:
//
//   bits [15: 0]  = status                  VG_* code
//   bits [31:16]  = have_major              on VG_ERR_VERSION_MISMATCH;
//                                            0 on every other return.
//   bits [63:32]  = req_major               on VG_ERR_VERSION_MISMATCH;
//                                            0 on every other return.
//
//   VG_OK                     = 0x0000     directive parses + constraint
//                                          satisfied.
//   VG_ERR_VERSION_MISMATCH   = 0x3B00     parsed, but have-triple fails
//                                          op vs req-triple.  Fingerprint
//                                          at LEVEL_WARN: `pds version
//                                          mismatch`.
//   VG_ERR_BAD_DIRECTIVE      = 0x3B01     prefix mismatch -- the input
//                                          does not begin with the exact
//                                          17-byte string "#requires-
//                                          paideia".
//   VG_ERR_BAD_OP             = 0x3B02     op token not in {>=, <=, ~=,
//                                          >, <, =}.
//   VG_ERR_BAD_SEMVER         = 0x3B03     missing / malformed digit run
//                                          or missing '.' between the
//                                          major and minor components.
//   VG_ERR_SRC_TOO_SHORT      = 0x3B04     src_len < 18 (prefix 17 +
//                                          at least one trailing byte).
//
// The 0x3B00 band is new; grep audit on 2026-10-15:
//   `grep -rnE '0x3B[0-9A-Fa-f]{2}\b' src/ design/` returns no live
//   source references -- band free of collision (Wave 118 R133.M3-vs-
//   R221.M2 lesson applied).
//
// =============================================================================
// SECTION 4  KERNEL VERSION TRIPLE
// =============================================================================
//
// `grep -rn 'KERNEL_VERSION' src/kernel` on 2026-10-15 found no pre-
// existing exported triple.  This file is the authoritative declaration
// site at M4; `0.1.0` reflects the pre-1.0 posture of the paideia-os
// workspace in Wave 118.  A later wave bumps these on each phase close
// in parallel with the paideia-as `workspace.version` discipline (see
// `feedback_paideia_as_version_discipline`).
//
// Call sites load via `mov r11, [rip + KERNEL_VERSION_MAJOR]`, the same
// idiom `frame_capture_emit.pdx:538` uses to load `CAPTURE_ROW_MAX`.
// A `pub let X : u64 = N` emits a loadable storage symbol in the pdx
// encoder (confirmed against `graphics/frame_capture_emit.pdx`,
// `graphics/session_revoke.pdx`, `graphics/surface_toplevel.pdx`).
//
// =============================================================================
// SECTION 5  REGISTER PLAN
// =============================================================================
//
// _vg_check -- 5 callee-save pushes + sub rsp, 16:
//
//     push rbx     rbx = src_ptr                 (base of input text)
//     push r12     r12 = src_len                 (byte count)
//     push r13     r13 = cursor                  (byte offset into src)
//     push r14     r14 = req_major               (u64 accumulator)
//     push r15     r15 = req_minor               (u64 accumulator)
//     sub  rsp, 16
//                  [rsp +  0] = req_patch        (u64; 0 if absent)
//                  [rsp +  8] = op               (VG_OP_* code)
//
// Entry rsp%16==8; +5 pushes (40) + sub 16 = +56; (8+56)%16==0 at body.
// Pre-CALL to klog_s1: body rsp%16==0, direct call.
// Pre-CALL to klog_s1_d2: idiom `sub rsp, 8; push v2` (+16) lands
//                         rsp%16==0 at the CALL (SysV callee entry
//                         rsp%16==8).  Post-CALL: `add rsp, 16`
//                         reclaims pad + push.  Same alignment proof
//                         as import_graph.pdx:610-612.
//
// Scratch (caller-save; may be clobbered by any nested CALL):
//     rax, rcx, rdx, rsi, rdi, r8, r9, r10, r11
//
// Internal op codes (never surface externally):
//     VG_OP_EQ        = 1   =
//     VG_OP_GE        = 2   >=
//     VG_OP_LE        = 3   <=
//     VG_OP_GT        = 4   >
//     VG_OP_LT        = 5   <
//     VG_OP_CARET_EQ  = 6   ~=
//
// =============================================================================
// SECTION 6  ENCODER DISCIPLINE  (feedback_pdx_encoder_pitfalls)
// =============================================================================
//
//   * `cmp rN, 0`              never `test rN, rN` (R123.M2 discipline).
//   * No 2-op `imul r, imm`    `v * 10` via `mov r10, v; shl r10, 3;
//                               mov r11, v; shl r11, 1; add r10, r11`
//                               (v*8 + v*2 = v*10).
//   * No `and rN, imm64`       mismatch pack uses `shl` + `or` only.
//   * Single-line `pub let`    one line per literal (tags, prefix,
//                               kernel-version triple).
//   * Module basename          `VersionGate` matches
//                               `version_gate.pdx`.
//   * Labels prefixed          `vg_` (reserved-word discipline;
//                               distinct from `ctr_`, `pds_cdg_`,
//                               `ig_` siblings).
//   * Byte loads               `xor rN, rN; mov_b rN, [reg+reg*1]`
//                               (mov_b does not implicitly zero-extend
//                                -- R133.M3 L450 precedent).
//   * `cmp rN, imm8`           every byte-literal compare (' ', '\t',
//                               '0', '9', '.', '=', '>', '<', '~')
//                               fits imm8.
//   * Status codes             0x3B00..0x3B04 fit imm32 sign-ext safe
//                               (bit 31 clear).
//   * Fingerprint OK token     the OK tag uses LOWER-CASE "ok"
//                               (follows R133.M2 / R133.M3 precedent).
//                               tools/verify-fingerprint-coverage.sh's
//                               OK_TOK regex matches only uppercase
//                               `OK` as a word token (per the regex
//                               at L3685), so this tag is NOT in the
//                               asserted-marker extractor's set --
//                               no allowlist entry is needed.
//
// =============================================================================
// SECTION 7  CROSS-MODULE WIRING NOTES
// =============================================================================
//
// Expected caller sequence (lands at R131/R133.M5+ pds-loader):
//
//   (1) Caller reads `.pds` file bytes into a buffer.
//   (2) Caller invokes `_pds_cdg_gate(buf_ptr, buf_len, grant_env)`;
//       on non-zero, abort.
//   (3) Caller isolates the single `#requires-paideia` directive line
//       from the container's pragma block (bytes between the leading
//       `#` and the trailing LF).
//   (4) Caller invokes:
//           packed = _vg_check(line_ptr, line_len)
//       On OK (low16==0): proceed to the import-graph gate.
//       On MISMATCH (low16==0x3B00): the required-major is in
//         bits[63:32] and the have-major is in bits[31:16]; surface
//         as `PdsErr::VersionMismatch { required_major, have_major }`
//         and abort the load.
//       On other VG_ERR_*: surface as the specific parse reason.
//   (5) Caller invokes `_ig_build_order` on the import adjacency;
//       on non-zero, abort.
//   (6) Caller dispatches TEXT bytes to the R131 shell command decoder.
//
// Design doc: design/kernel/pds-version-gate.md (M4 directive grammar,
// comparison semantics, status band derivation, acceptance smoke).
//
// =============================================================================

module VersionGate = structure {

  // ==========================================================================
  // SECTION 8  CONSTANTS
  // ==========================================================================

  // Return codes (SECTION 3).
  pub let VG_OK                     : u64 = 0
  pub let VG_ERR_VERSION_MISMATCH   : u64 = 0x3B00
  pub let VG_ERR_BAD_DIRECTIVE      : u64 = 0x3B01
  pub let VG_ERR_BAD_OP             : u64 = 0x3B02
  pub let VG_ERR_BAD_SEMVER         : u64 = 0x3B03
  pub let VG_ERR_SRC_TOO_SHORT      : u64 = 0x3B04

  // Internal op codes (SECTION 5).
  pub let VG_OP_EQ         : u64 = 1
  pub let VG_OP_GE         : u64 = 2
  pub let VG_OP_LE         : u64 = 3
  pub let VG_OP_GT         : u64 = 4
  pub let VG_OP_LT         : u64 = 5
  pub let VG_OP_CARET_EQ   : u64 = 6

  // Kernel version triple (SECTION 4).  Loadable via `mov rN, [rip + ...]`.
  pub let KERNEL_VERSION_MAJOR : u64 = 0
  pub let KERNEL_VERSION_MINOR : u64 = 1
  pub let KERNEL_VERSION_PATCH : u64 = 0

  // Directive prefix "#requires-paideia" (17 bytes; compared on 17 of 18).
  //   N = len(string) + 1 (NUL counted); comparison uses only the first 17.
  pub let vg_prefix     : [u8; 18] = "#requires-paideia\0"
  pub let vg_prefix_len : u64 = 17

  // ==========================================================================
  // SECTION 9  FINGERPRINT TAGS  (N = len(string) + 1, NUL inclusive)
  // ==========================================================================
  //
  //   "pds version ok"         14 + NUL -> N = 15
  //   "pds version mismatch"   20 + NUL -> N = 21
  //   "required"                8 + NUL -> N =  9
  //   "have"                    4 + NUL -> N =  5
  //
  // Lower-case "ok" bypasses the fingerprint-coverage extractor (R133.M2
  // / R133.M3 precedent), so no allowlist row is needed.  A future smoke
  // may pin the string as a plain substring assertion in its golden file.
  pub let vg_tag_ok        : [u8; 15] = "pds version ok\0"
  pub let vg_tag_mismatch  : [u8; 21] = "pds version mismatch\0"
  pub let vg_k_required    : [u8;  9] = "required\0"
  pub let vg_k_have        : [u8;  5] = "have\0"

  // ==========================================================================
  // SECTION 10  _vg_check(src_ptr, src_len) -> packed u64
  //
  // The sole public entry point.  See §0 for role, §1 for grammar,
  // §2 for compare semantics, §3 for the return-pack, §5 for the
  // register plan.
  //
  // Entry: rdi=src_ptr, rsi=src_len
  // Return: rax = packed status (see §3)
  //
  // Side effects: emits one klog_s1 fingerprint on each error path and
  // one klog_s1_d2 fingerprint on the OK path.  Does not mutate any
  // module-level state.
  // ==========================================================================
  pub let _vg_check : (u64, u64) -> u64 !{mem, sysreg} @{} =
    fn (src_ptr: u64) (src_len: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "UMB-W? R133.M4 (paideia-os #2623): .pds load-time `#requires-paideia OP SEMVER` version gate. Parses the textual directive from a (ptr, len) byte range, lex-compares the parsed (major, minor, patch) triple against the kernel's own KERNEL_VERSION_(MAJOR|MINOR|PATCH) static triple, and returns a packed u64 whose low 16 bits are VG_OK (0) or VG_ERR_* in {VERSION_MISMATCH 0x3B00, BAD_DIRECTIVE 0x3B01, BAD_OP 0x3B02, BAD_SEMVER 0x3B03, SRC_TOO_SHORT 0x3B04}. On MISMATCH bits [63:32] carry req_major and bits [31:16] carry have_major so the caller recovers both sides without a side channel. Grammar: `#requires-paideia` (17-byte literal) WS+ OP WS+ SEMVER; OP in {>=, <=, ~=, >, <, =} with greedy 2-char-before-1-char matching; SEMVER = DIGITS '.' DIGITS ['.' DIGITS]. Compare = three-way lex on (major, minor, patch), result in rsi in {0 (LO), 1 (EQ), 2 (HI)}; op dispatch uses imm8-fit cmps. ~= requires have.major == req.major AND cmp in {HI, EQ}. Register plan: 5 callee-save pushes (rbx=src_ptr, r12=src_len, r13=cursor, r14=req_major, r15=req_minor) + sub rsp,16 for [rsp+0]=req_patch and [rsp+8]=op; entry rsp%16==8, +40+16=56, (8+56)%16==0 at body — klog_s1_d2 pre-CALL idiom `sub rsp,8; push v2` lands rsp%16==0 at CALL (import_graph.pdx:610 precedent). Encoder discipline: cmp rN,0 never test; v*10 via (shl rN,3)+(shl rM,1)+(add rN,rM) never 2-op imul-imm; `and rN,imm` not needed; byte loads via `xor rN,rN; mov_b rN,[reg+reg*1]` (mov_b does not implicitly zero-extend — R133.M3 L450 precedent); all byte literals (' '=32, '\\t'=9, '0'=48, '9'=57, '.'=46, '='=61, '>'=62, '<'=60, '~'=126) fit imm8; all status codes 0x3B00..0x3B04 fit imm32 sign-ext safe (bit 31 clear). Fingerprint tags: 'pds version ok\\0' (15B) + 'required\\0' (9B) + 'have\\0' (5B) via klog_s1_d2 on OK; 'pds version mismatch\\0' (21B) via klog_s1 on mismatch. Lower-case 'ok' intentionally bypasses verify-fingerprint-coverage.sh OK_TOK regex (R133.M2 / R133.M3 precedent) — no allowlist row required. Module basename VersionGate matches file basename version_gate.pdx. Labels prefixed vg_ (reserved-word discipline; distinct from ctr_/pds_cdg_/ig_ siblings).",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 16;

        mov rbx, rdi;                     // src_ptr
        mov r12, rsi;                     // src_len

        // Zero stack locals: req_patch and op.  Defensive; also ensures
        // the compare step reads a well-defined req_patch=0 when the
        // directive omits the ".patch" component.
        xor rax, rax;
        mov [rsp + 0], rax;               // req_patch = 0
        mov [rsp + 8], rax;               // op = 0 (placeholder; overwritten)

        // Zero the triple accumulators so the parser's running
        // accumulator starts clean on every entry.
        xor r14, r14;                     // req_major = 0
        xor r15, r15;                     // req_minor = 0

        // ------------------------------------------------------------------
        // Step 1: src_len >= 18 (prefix 17 + at least one trailing byte).
        // ------------------------------------------------------------------
        cmp r12, 18;
        jb  vg_src_too_short;

        // ------------------------------------------------------------------
        // Step 2: memcmp src[0..17] vs vg_prefix[0..17].  On any
        // mismatch jump to BAD_DIRECTIVE.
        // ------------------------------------------------------------------
        xor r13, r13;                     // cursor = 0
        lea r9, [rip + vg_prefix];        // r9 = &vg_prefix

      vg_scan_prefix:
        cmp r13, 17;
        jae vg_prefix_ok;
        xor rax, rax;
        mov_b rax, [rbx + r13*1];         // src[r13]
        xor rcx, rcx;
        mov_b rcx, [r9  + r13*1];         // vg_prefix[r13]
        cmp rax, rcx;
        jne vg_bad_directive;
        add r13, 1;
        jmp vg_scan_prefix;

      vg_prefix_ok:
        // r13 = 17 now (points at the first byte after the prefix).

        // ------------------------------------------------------------------
        // Step 3: skip whitespace (space=32, tab=9) between prefix and op.
        // ------------------------------------------------------------------
      vg_skip_ws1:
        cmp r13, r12;
        jae vg_bad_directive;
        xor rax, rax;
        mov_b rax, [rbx + r13*1];
        cmp rax, 32;                      // ' '
        je  vg_skip_ws1_adv;
        cmp rax, 9;                       // '\t'
        je  vg_skip_ws1_adv;
        jmp vg_parse_op;
      vg_skip_ws1_adv:
        add r13, 1;
        jmp vg_skip_ws1;

        // ------------------------------------------------------------------
        // Step 4: parse the op token.  Greedy: try 2-char ops first
        // ({>=, <=, ~=}), fall through to 1-char ({>, <, =}).
        // ------------------------------------------------------------------
      vg_parse_op:
        // Need at least 1 byte for a 1-char op; the earlier skip_ws1
        // left r13 at a non-whitespace byte strictly inside [0, src_len).
        xor rax, rax;
        mov_b rax, [rbx + r13*1];         // first op byte

        // Is there a second byte available for a 2-char op?
        mov rcx, r13;
        add rcx, 1;
        cmp rcx, r12;
        jae vg_try_1char;
        xor r10, r10;
        mov_b r10, [rbx + rcx*1];         // second op byte candidate

        // -- '>' then '=' -> VG_OP_GE; otherwise '>' alone -> VG_OP_GT.
        cmp rax, 62;                      // '>'
        jne vg_try_le;
        cmp r10, 61;                      // '='
        jne vg_op_gt_single;
        mov r11, 2;                       // VG_OP_GE
        mov [rsp + 8], r11;
        add r13, 2;
        jmp vg_skip_ws2;
      vg_op_gt_single:
        mov r11, 4;                       // VG_OP_GT
        mov [rsp + 8], r11;
        add r13, 1;
        jmp vg_skip_ws2;

      vg_try_le:
        // -- '<' then '=' -> VG_OP_LE; otherwise '<' alone -> VG_OP_LT.
        cmp rax, 60;                      // '<'
        jne vg_try_tilde;
        cmp r10, 61;                      // '='
        jne vg_op_lt_single;
        mov r11, 3;                       // VG_OP_LE
        mov [rsp + 8], r11;
        add r13, 2;
        jmp vg_skip_ws2;
      vg_op_lt_single:
        mov r11, 5;                       // VG_OP_LT
        mov [rsp + 8], r11;
        add r13, 1;
        jmp vg_skip_ws2;

      vg_try_tilde:
        // -- '~' then '=' -> VG_OP_CARET_EQ; '~' alone is NOT a valid op.
        cmp rax, 126;                     // '~'
        jne vg_try_eq;
        cmp r10, 61;                      // '='
        jne vg_bad_op;
        mov r11, 6;                       // VG_OP_CARET_EQ
        mov [rsp + 8], r11;
        add r13, 2;
        jmp vg_skip_ws2;

      vg_try_eq:
        // -- '=' alone -> VG_OP_EQ; anything else -> BAD_OP.
        cmp rax, 61;                      // '='
        jne vg_bad_op;
        mov r11, 1;                       // VG_OP_EQ
        mov [rsp + 8], r11;
        add r13, 1;
        jmp vg_skip_ws2;

      vg_try_1char:
        // Only 1 byte available: '=' / '>' / '<' as single-char ops.
        cmp rax, 61;                      // '='
        je  vg_op_eq_tail;
        cmp rax, 62;                      // '>'
        je  vg_op_gt_tail;
        cmp rax, 60;                      // '<'
        je  vg_op_lt_tail;
        jmp vg_bad_op;
      vg_op_eq_tail:
        mov r11, 1;
        mov [rsp + 8], r11;
        add r13, 1;
        jmp vg_skip_ws2;
      vg_op_gt_tail:
        mov r11, 4;
        mov [rsp + 8], r11;
        add r13, 1;
        jmp vg_skip_ws2;
      vg_op_lt_tail:
        mov r11, 5;
        mov [rsp + 8], r11;
        add r13, 1;
        jmp vg_skip_ws2;

        // ------------------------------------------------------------------
        // Step 5: skip whitespace between op and version.
        // ------------------------------------------------------------------
      vg_skip_ws2:
        cmp r13, r12;
        jae vg_bad_semver;
        xor rax, rax;
        mov_b rax, [rbx + r13*1];
        cmp rax, 32;                      // ' '
        je  vg_skip_ws2_adv;
        cmp rax, 9;                       // '\t'
        je  vg_skip_ws2_adv;
        jmp vg_parse_major;
      vg_skip_ws2_adv:
        add r13, 1;
        jmp vg_skip_ws2;

        // ------------------------------------------------------------------
        // Step 6: parse major digits into r14.
        // Accumulator update:   acc = acc*10 + (byte - '0')
        //                            = (acc<<3) + (acc<<1) + digit
        // ------------------------------------------------------------------
      vg_parse_major:
        xor r14, r14;                     // req_major = 0
        xor rcx, rcx;                     // digit count
      vg_pm_loop:
        cmp r13, r12;
        jae vg_pm_done;
        xor rax, rax;
        mov_b rax, [rbx + r13*1];
        cmp rax, 48;                      // '0'
        jb  vg_pm_done;
        cmp rax, 57;                      // '9'
        ja  vg_pm_done;
        //   r14 = r14*10 + (rax - 48)
        mov r10, r14;
        shl r10, 3;                       // r14 * 8
        mov r11, r14;
        shl r11, 1;                       // r14 * 2
        add r10, r11;                     // r14 * 10
        sub rax, 48;
        add r10, rax;
        mov r14, r10;
        add r13, 1;
        add rcx, 1;
        cmp rcx, 9;                       // <=9 digits: no u32 wrap
        ja  vg_bad_semver;
        jmp vg_pm_loop;
      vg_pm_done:
        cmp rcx, 0;
        je  vg_bad_semver;

        // Expect '.'.
        cmp r13, r12;
        jae vg_bad_semver;
        xor rax, rax;
        mov_b rax, [rbx + r13*1];
        cmp rax, 46;                      // '.'
        jne vg_bad_semver;
        add r13, 1;

        // ------------------------------------------------------------------
        // Step 7: parse minor digits into r15.
        // ------------------------------------------------------------------
      vg_parse_minor:
        xor r15, r15;                     // req_minor = 0
        xor rcx, rcx;
      vg_pmn_loop:
        cmp r13, r12;
        jae vg_pmn_done;
        xor rax, rax;
        mov_b rax, [rbx + r13*1];
        cmp rax, 48;
        jb  vg_pmn_done;
        cmp rax, 57;
        ja  vg_pmn_done;
        mov r10, r15;
        shl r10, 3;
        mov r11, r15;
        shl r11, 1;
        add r10, r11;
        sub rax, 48;
        add r10, rax;
        mov r15, r10;
        add r13, 1;
        add rcx, 1;
        cmp rcx, 9;                       // <=9 digits: no u32 wrap
        ja  vg_bad_semver;
        jmp vg_pmn_loop;
      vg_pmn_done:
        cmp rcx, 0;
        je  vg_bad_semver;

        // ------------------------------------------------------------------
        // Step 8: optional patch component.  If next byte is '.', parse
        // digits; otherwise treat patch = 0 (already zeroed on entry).
        // Trailing whitespace / newline falls through to compare.
        // ------------------------------------------------------------------
        cmp r13, r12;
        jae vg_compare;
        xor rax, rax;
        mov_b rax, [rbx + r13*1];
        cmp rax, 46;                      // '.'
        jne vg_compare;
        add r13, 1;

      vg_parse_patch:
        xor r8, r8;                       // local patch accumulator
        xor rcx, rcx;
      vg_pp_loop:
        cmp r13, r12;
        jae vg_pp_done;
        xor rax, rax;
        mov_b rax, [rbx + r13*1];
        cmp rax, 48;
        jb  vg_pp_done;
        cmp rax, 57;
        ja  vg_pp_done;
        mov r10, r8;
        shl r10, 3;
        mov r11, r8;
        shl r11, 1;
        add r10, r11;
        sub rax, 48;
        add r10, rax;
        mov r8, r10;
        add r13, 1;
        add rcx, 1;
        cmp rcx, 9;                       // <=9 digits: no u32 wrap
        ja  vg_bad_semver;
        jmp vg_pp_loop;
      vg_pp_done:
        cmp rcx, 0;
        je  vg_bad_semver;
        mov [rsp + 0], r8;                // store req_patch

        // ------------------------------------------------------------------
        // Step 9: three-way compare on (have, required).  Encodes the
        // result in rsi: 0 = have < req (LO), 1 = equal (EQ), 2 = have >
        // req (HI).  Required triple is in (r14, r15, [rsp+0]); have
        // triple is loaded from the kernel-version statics into
        // (r8, r9, r10).
        // ------------------------------------------------------------------
      vg_compare:
        mov r8,  [rip + KERNEL_VERSION_MAJOR];
        mov r9,  [rip + KERNEL_VERSION_MINOR];
        mov r10, [rip + KERNEL_VERSION_PATCH];

        // Compare majors.
        cmp r8, r14;
        ja  vg_cmp_hi;
        jb  vg_cmp_lo;
        // Majors equal; compare minors.
        cmp r9, r15;
        ja  vg_cmp_hi;
        jb  vg_cmp_lo;
        // Minors equal; compare patches.
        mov r11, [rsp + 0];
        cmp r10, r11;
        ja  vg_cmp_hi;
        jb  vg_cmp_lo;
        // Everything equal.
        mov rsi, 1;                       // EQ
        jmp vg_cmp_done;
      vg_cmp_lo:
        mov rsi, 0;                       // LO
        jmp vg_cmp_done;
      vg_cmp_hi:
        mov rsi, 2;                       // HI

      vg_cmp_done:
        // Dispatch on op (in rax from the stack-local slot).
        mov rax, [rsp + 8];

        cmp rax, 1;                       // VG_OP_EQ
        je  vg_check_eq;
        cmp rax, 2;                       // VG_OP_GE
        je  vg_check_ge;
        cmp rax, 3;                       // VG_OP_LE
        je  vg_check_le;
        cmp rax, 4;                       // VG_OP_GT
        je  vg_check_gt;
        cmp rax, 5;                       // VG_OP_LT
        je  vg_check_lt;
        cmp rax, 6;                       // VG_OP_CARET_EQ
        je  vg_check_caret;
        jmp vg_bad_op;

      vg_check_eq:
        cmp rsi, 1;
        je  vg_ok;
        jmp vg_mismatch;
      vg_check_ge:
        cmp rsi, 1;
        jae vg_ok;                        // 1 (EQ) or 2 (HI)
        jmp vg_mismatch;
      vg_check_le:
        cmp rsi, 1;
        jbe vg_ok;                        // 0 (LO) or 1 (EQ)
        jmp vg_mismatch;
      vg_check_gt:
        cmp rsi, 2;
        je  vg_ok;
        jmp vg_mismatch;
      vg_check_lt:
        cmp rsi, 0;
        je  vg_ok;
        jmp vg_mismatch;
      vg_check_caret:
        // ~= : have.major == req.major AND cmp in {HI, EQ}.
        cmp r8, r14;
        jne vg_mismatch;
        cmp rsi, 1;
        jae vg_ok;
        jmp vg_mismatch;

        // ------------------------------------------------------------------
        // Step 10a: emit "pds version ok" fingerprint with k=required and
        // k=have via klog_s1_d2 at LEVEL_INFO.  v1 = req_major (r14),
        // v2 = have_major (reloaded from KERNEL_VERSION_MAJOR).
        //
        // klog_s1_d2 ABI (wrappers.pdx L261): rdi=level, rsi=subsys_ptr,
        //                                      rdx=tag_ptr, rcx=k1, r8=v1,
        //                                      r9=k2, [rsp+8 post-push]=v2.
        // Alignment: body rsp%16==0; `sub rsp,8; push v2` lands rsp%16==0
        //            at CALL (callee entry rsp%16==8 per SysV).  Post-call
        //            `add rsp, 16` reclaims pad + push.  Same idiom as
        //            import_graph.pdx:610-612 and ioapic_route.pdx:337.
        // ------------------------------------------------------------------
      vg_ok:
        mov rax, [rip + KERNEL_VERSION_MAJOR];
        sub rsp, 8;                       // alignment pad
        push rax;                         // [rsp+8 post-push] = v2 = have_major

        mov rdi, 3;                       // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + vg_tag_ok];
        lea rcx, [rip + vg_k_required];
        mov r8,  r14;                     // v1 = req_major
        lea r9,  [rip + vg_k_have];
        call klog_s1_d2;

        add rsp, 16;                      // reclaim pad + push

        xor rax, rax;                     // VG_OK
        jmp vg_out;

        // ------------------------------------------------------------------
        // Step 10b: emit "pds version mismatch" fingerprint at LEVEL_WARN,
        // then pack (req_major << 32) | (have_major << 16) | 0x3B00.
        // ------------------------------------------------------------------
      vg_mismatch:
        mov rdi, 2;                       // LEVEL_WARN
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + vg_tag_mismatch];
        call klog_s1;

        // Pack return.
        //   rax = req_major << 32
        //   or   (have_major << 16)
        //   or   0x3B00
        mov rax, r14;
        shl rax, 32;
        mov r11, [rip + KERNEL_VERSION_MAJOR];
        shl r11, 16;
        or  rax, r11;
        mov r11, 0x3B00;
        or  rax, r11;
        jmp vg_out;

      vg_bad_directive:
        mov rax, 0x3B01;                  // VG_ERR_BAD_DIRECTIVE
        jmp vg_out;

      vg_bad_op:
        mov rax, 0x3B02;                  // VG_ERR_BAD_OP
        jmp vg_out;

      vg_bad_semver:
        mov rax, 0x3B03;                  // VG_ERR_BAD_SEMVER
        jmp vg_out;

      vg_src_too_short:
        mov rax, 0x3B04;                  // VG_ERR_SRC_TOO_SHORT

      vg_out:
        add rsp, 16;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION 11  _vg_mismatch_req_major(packed) -> u64
  //
  // Accessor: given a packed return value whose low 16 bits are
  // VG_ERR_VERSION_MISMATCH (0x3B00), recover the required-major stored
  // in bits [63:32].  Returns 0 on any non-mismatch input (including
  // VG_OK and parse errors), so callers can safely invoke it in a log
  // path that names both success and error values.
  //
  // Pure leaf.  No stack use.
  // ==========================================================================
  pub let _vg_mismatch_req_major : (u64) -> u64 !{} @{} =
    fn (packed: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R133.M4 (paideia-os #2623): recover req_major from a packed VG_ERR_VERSION_MISMATCH return value. Masks the low 16 bits against 0xFFFF; on match against 0x3B00 shifts the high 32 bits down into rax; otherwise returns 0. Pure leaf — no stack use, no nested call. Encoder: `and rN, imm16` fits imm32 (0xFFFF, bit 31 clear); `shr rax, 32` is the standard long right-shift; cmp against 0x3B00 is sign-ext safe (bit 31 clear).",
      block: {
        // low16 = packed & 0xFFFF
        mov rax, rdi;
        mov r10, 0xFFFF;
        and rax, r10;

        // if low16 != 0x3B00 -> return 0
        mov r10, 0x3B00;
        cmp rax, r10;
        jne vg_rm_zero;

        // req_major = packed >> 32
        mov rax, rdi;
        shr rax, 32;
        ret

      vg_rm_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // SECTION 12  _vg_mismatch_have_major(packed) -> u64
  //
  // Accessor: given a packed VG_ERR_VERSION_MISMATCH value, recover the
  // have-major stored in bits [31:16].  Returns 0 on any non-mismatch
  // input.
  //
  // Pure leaf.  No stack use.
  // ==========================================================================
  pub let _vg_mismatch_have_major : (u64) -> u64 !{} @{} =
    fn (packed: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R133.M4 (paideia-os #2623): recover have_major from a packed VG_ERR_VERSION_MISMATCH return value. Masks the low 16 bits against 0xFFFF; on match against 0x3B00 shifts right 16 and masks to 0xFFFF to recover the have_major field. Pure leaf — no stack use, no nested call. Encoder: `and rN, imm16` fits imm32 (0xFFFF, bit 31 clear); `shr rN, 16` is the standard short right-shift.",
      block: {
        // low16 = packed & 0xFFFF
        mov rax, rdi;
        mov r10, 0xFFFF;
        and rax, r10;

        // if low16 != 0x3B00 -> return 0
        mov r10, 0x3B00;
        cmp rax, r10;
        jne vg_hm_zero;

        // have_major = (packed >> 16) & 0xFFFF
        mov rax, rdi;
        shr rax, 16;
        mov r10, 0xFFFF;
        and rax, r10;
        ret

      vg_hm_zero:
        xor rax, rax;
        ret
      }
    }
}
