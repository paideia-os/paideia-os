// src/kernel/core/pds/header_pragma.pdx -- UMB-W25 R227.M1 (paideia-os #2703)
//
// pds-lang (paideia-shell-language) HEADER PRAGMA parser.
//
// A `.pds` file begins with an optional block of header pragmas --
// single-line directives of the shape `#pragma pds <directive>` that
// configure how the rest of the file is parsed and how the shell
// session is scaled. The pragma block ends at the first non-blank,
// non-comment, non-pragma line; parsing of the pds language body is
// handed off from that point forward.
//
// =============================================================================
// SECTION 0  SCOPE
// =============================================================================
//
// R227.M1 subset -- four directives. Later milestones (M2+) extend
// the dispatch table in SECTION 10 without changing the record shape
// or the wire ABI.
//
//   #pragma pds version "<N.N.N>"            -> PDS_HP_KIND_VERSION
//   #pragma pds strict                       -> PDS_HP_KIND_STRICT
//   #pragma pds charset utf8                 -> PDS_HP_KIND_CHARSET
//   #pragma pds history_default_cap <N>      -> PDS_HP_KIND_HISTORY_CAP
//
// This parser is PURE: it consumes a byte range, emits an array of
// 32-byte PdsHpRecord into a caller-provided buffer, and returns a
// packed u64 of (count << 32) | status. It performs NO allocation,
// NO VFS traffic, NO klog chatter, and NO capability lookup -- the
// caller places the parsed records into whatever enforcement context
// is appropriate (R127 history scaling, R123 shell strict mode,
// R221 charset enforcement, R227.M2 version gating).
//
// This file is DISTINCT from `src/kernel/core/shell/cmd_registry_
// parser.pdx` (UMB-W4 R123.M2): that parser consumes the on-disk
// shell command registry (TOML subset) and drives KIND_CMD_MODULE
// row allocation. THIS parser consumes `.pds` source bytes and
// emits an in-memory record stream for session configuration.
//
// =============================================================================
// SECTION 1  GRAMMAR
// =============================================================================
//
// Accepted shape at file head:
//
//   HEADER        := LINE*
//   LINE          := BLANK | COMMENT | PRAGMA | HALT
//   BLANK         := WS* LF
//   COMMENT       := WS* '#' (not followed by 'pragma pds ') .* LF
//   PRAGMA        := WS* '#pragma pds ' DIRECTIVE WS* COMMENT_TAIL? LF
//   HALT          := anything else  (pragma block ends; parser returns)
//   DIRECTIVE     := DIR_VERSION | DIR_STRICT | DIR_CHARSET | DIR_HISTORY
//   DIR_VERSION   := 'version' WS+ '"' VERSION '"'
//   DIR_STRICT    := 'strict'
//   DIR_CHARSET   := 'charset' WS+ 'utf8'
//   DIR_HISTORY   := 'history_default_cap' WS+ NUM
//
//   VERSION       := DIGIT+ ('.' DIGIT+)*       (1..24 bytes)
//   NUM           := DIGIT+                     (1..19 bytes decimal u64)
//   DIGIT         := [0-9]
//   WS            := SP (0x20) | HT (0x09) | CR (0x0D)
//   COMMENT_TAIL  := '#' .*
//
// HALT is NOT an error: it is the point the pds body parser takes
// over. Blank and regular `#...` comment lines (NOT `#pragma pds ...`)
// are tolerated and skipped. The parser only CONSUMES bytes up to and
// including the LF of the last pragma / blank / comment line it
// processed; it does NOT consume the first HALT byte.
//
// =============================================================================
// SECTION 2  OUTPUT RECORD SHAPE
// =============================================================================
//
// Each parsed pragma yields a fixed 32-byte PdsHpRecord stored at
// out_ptr + i*32:
//
//     byte [ 0.. 1]  kind      u16   -- PDS_HP_KIND_* ordinal
//     byte [ 2.. 3]  len       u16   -- value payload byte count
//     byte [ 4.. 7]  reserved  u32   -- zero at M1 (future flags)
//     byte [ 8..31]  value     u8[24]-- payload (shape by kind)
//
// Payload shape per kind (M1):
//
//   KIND_VERSION    (1):  value = ASCII bytes of version string;
//                         len = string length (1..24).
//   KIND_STRICT     (2):  value = all zero; len = 0.
//   KIND_CHARSET    (3):  value = "utf8" (4 bytes, no NUL); len = 4.
//   KIND_HISTORY_CAP(4):  value[0..7] = u64 little-endian number;
//                         value[8..23] = zero;
//                         len = 8  (signals u64 payload to consumers).
//
// Unused bytes within the 24-byte value field are ZERO -- the writer
// zeroes the entire 32-byte slot before stamping the header + payload.
// This gives consumers a stable fingerprint for digest / schema use.
//
// =============================================================================
// SECTION 3  RETURN CODE
// =============================================================================
//
// _pds_hp_parse returns a packed u64:
//
//   bits [15: 0]   = status                PDS_HP_* code
//   bits [31:16]   = 0  (reserved)
//   bits [63:32]   = count OR byte offset  (see per-status table)
//
//   PDS_HP_OK                 = 0x0000     bits[63:32] = pragmas_parsed
//   PDS_HP_ERR_SYNTAX         = 0x2800     bits[63:32] = byte offset of
//                                           the first bad byte, measured
//                                           from buf_ptr. Count is NOT
//                                           returned on this path.
//   PDS_HP_ERR_UNKNOWN_PRAGMA = 0x2801     bits[63:32] = pragmas_parsed
//                                           before the unknown directive
//   PDS_HP_ERR_BAD_VERSION    = 0x2802     bits[63:32] = pragmas_parsed
//                                           before the malformed version
//   PDS_HP_ERR_OUT_TOO_SMALL  = 0x2803     bits[63:32] = pragmas_parsed
//                                           successfully before the out
//                                           buffer filled
//
// The 0x2800 prefix carves pds-header-pragma errors out of the kernel
// error space; sibling pds-lang modules in R227.M2+ claim 0x28xx
// adjacents (M2 import/export: 0x2810..0x28FF).
//
// =============================================================================
// SECTION 4  ENCODER DISCIPLINE
// =============================================================================
//
// Pure leaf -- the function makes NO nested calls, so rsp alignment
// requirements inside the body are relaxed. Five callee-save pushes
// (rbx, r12, r13, r14, r15 -- 40 bytes) are kept purely so the five
// cursor / bound registers survive the body. Scratch: rax, rcx, rdx,
// rsi, rdi, r8, r9, r10, r11 (all caller-save, no nested call means
// no save/restore needed around their use).
//
// Register plan inside the body:
//   rbx = buf_start      (callee-save; needed for byte-offset report)
//   r12 = buf_end        (callee-save)
//   r13 = cursor         (callee-save)
//   r14 = out_cursor     (callee-save; advances by 32 per pragma)
//   r15 = out_end        (callee-save; out_ptr + out_cap)
//   r11 = pragmas_count  (caller-save, zeroed at entry, no inner call
//                         clobbers it -- the function has none)
//   r10 = per-step scratch (byte reads)
//   r9  = secondary scratch (second byte read for comparisons)
//   rcx = loop counter (string match, byte-copy)
//   rax = packed return value in epilogue
//
// Every constant in this file fits imm32 (bit 31 clear): kinds 1..4,
// prefix lengths 4..19, PDS_HP_RECORD_SIZE=32, PDS_HP_VERSION_MAX=24,
// PDS_HP_ERR_* 0x2800..0x2803. The `mov rN, imm32` zero-extend form
// is a 7-byte encode per the kernel-wide discipline.
//
// Zero checks: `cmp rN, 0; jcc` (never `test rN, rN`). Zero-ext byte
// loads: `xor rN, rN; mov_b rN, [mem]` (encoder does not zero-extend
// on its own, per pipe_backend.pdx §57). Byte stores: only the
// `mov_b [reg+off], reg` and `mov_b [reg+reg*1], reg` forms are legal
// in the encoder today -- the `mov_b [reg+reg*1+off], reg` form is
// NOT supported (confirmed by schema_registry.pdx §cn and the earlier
// repo-wide sweep). The byte-copy block in SECTION 11 pre-advances
// the destination pointer to a local scratch to sidestep this.
//
// u16 stores: `mov_w [reg+off], reg` is supported (confirmed by
// crs.pdx §bus-range and ios-small-item). We use it for the record
// header kind + len fields.
//
// Multiply by 10 (NUM parse): no 2-op `imul r, imm`. Materialised
// via `mov tmp, num; shl num, 3; shl tmp, 1; add num, tmp`
// (num *= 8, tmp = 2*num_prev, add -> 10*num_prev).
//
// Reserved labels: every label in this file is prefixed `pds_hp_`
// so none collides with pdx reserved words (`loop`, `if`, `let`,
// `else`, `fn`) or with sibling modules.
//
// Module basename `HeaderPragma` matches the file basename
// `header_pragma.pdx` (encoder expects an exact match).
//
// =============================================================================
// SECTION 5  CROSS-MODULE WIRING NOTES
// =============================================================================
//
// This module is a self-contained parsing primitive. There is no boot
// hook, no capability substrate row, no VFS traffic. The expected
// caller sequence (lands in R227.M2+ once the pds body parser arrives):
//
//   (1) A pds-session loader reads a `.pds` file into a buffer.
//   (2) It allocates (or statically owns) a PdsHpRecord[K] array.
//   (3) It calls `_pds_hp_parse(buf, len, &records, K*32)`.
//   (4) On OK, it walks the records to configure the session:
//         KIND_VERSION      -> gate on pds-lang version compatibility
//         KIND_STRICT       -> enable strict parse mode for the body
//         KIND_CHARSET      -> gate on charset == utf8 (M1 only)
//         KIND_HISTORY_CAP  -> hand to R127 history scaler
//   (5) The pds body parser resumes at `buf + consumed_bytes` where
//       `consumed_bytes` is derived by the caller (not surfaced in
//       this M1; a follow-up adds a `_pds_hp_tail_offset` accessor).
//
// Design doc: design/shell/pds-header-pragmas.md (M1 subset + M2+
// extension plan).
//
// =============================================================================

module HeaderPragma = structure {

  // ==========================================================================
  // SECTION 6  CONSTANTS
  // ==========================================================================

  // Return codes (§3).
  pub let PDS_HP_OK                 : u64 = 0
  pub let PDS_HP_ERR_SYNTAX         : u64 = 0x2800
  pub let PDS_HP_ERR_UNKNOWN_PRAGMA : u64 = 0x2801
  pub let PDS_HP_ERR_BAD_VERSION    : u64 = 0x2802
  pub let PDS_HP_ERR_OUT_TOO_SMALL  : u64 = 0x2803

  // Record kinds (§2).
  pub let PDS_HP_KIND_VERSION      : u64 = 1
  pub let PDS_HP_KIND_STRICT       : u64 = 2
  pub let PDS_HP_KIND_CHARSET      : u64 = 3
  pub let PDS_HP_KIND_HISTORY_CAP  : u64 = 4

  // Record geometry.
  pub let PDS_HP_RECORD_SIZE       : u64 = 32
  pub let PDS_HP_VALUE_MAX         : u64 = 24
  pub let PDS_HP_VERSION_MAX       : u64 = 24

  // Prefix + directive lengths (used by the byte-match loops).
  pub let PDS_HP_PREFIX_LEN        : u64 = 12   // "#pragma pds "
  pub let PDS_HP_VERSION_KW_LEN    : u64 = 7    // "version"
  pub let PDS_HP_STRICT_KW_LEN     : u64 = 6    // "strict"
  pub let PDS_HP_CHARSET_KW_LEN    : u64 = 7    // "charset"
  pub let PDS_HP_HISTORY_KW_LEN    : u64 = 19   // "history_default_cap"
  pub let PDS_HP_UTF8_LEN          : u64 = 4    // "utf8"

  // Byte-literal constants (plain integers, not strings, to keep the
  // code dense without pulling in an ASCII helper table).
  pub let PDS_HP_BYTE_SP           : u64 = 0x20
  pub let PDS_HP_BYTE_HT           : u64 = 0x09
  pub let PDS_HP_BYTE_CR           : u64 = 0x0D
  pub let PDS_HP_BYTE_LF           : u64 = 0x0A
  pub let PDS_HP_BYTE_HASH         : u64 = 0x23
  pub let PDS_HP_BYTE_QUOTE        : u64 = 0x22
  pub let PDS_HP_BYTE_DOT          : u64 = 0x2E
  pub let PDS_HP_BYTE_D0           : u64 = 0x30
  pub let PDS_HP_BYTE_D9           : u64 = 0x39
  pub let PDS_HP_BYTE_V            : u64 = 0x76
  pub let PDS_HP_BYTE_S            : u64 = 0x73
  pub let PDS_HP_BYTE_C            : u64 = 0x63
  pub let PDS_HP_BYTE_H            : u64 = 0x68

  // ==========================================================================
  // SECTION 7  INTERNED STRING LITERALS
  // --------------------------------------------------------------------------
  // Each is NUL-terminated per the kernel-wide `pub let` string
  // discipline, but the length constants in SECTION 6 count ASCII
  // bytes (NUL-exclusive) because the byte-match loops stop at the
  // length, not at a NUL.
  // ==========================================================================
  pub let pds_hp_prefix       : [u8; 13] = "#pragma pds \0"
  pub let pds_hp_dir_version  : [u8; 8]  = "version\0"
  pub let pds_hp_dir_strict   : [u8; 7]  = "strict\0"
  pub let pds_hp_dir_charset  : [u8; 8]  = "charset\0"
  pub let pds_hp_dir_history  : [u8; 20] = "history_default_cap\0"
  pub let pds_hp_val_utf8     : [u8; 5]  = "utf8\0"

  // ==========================================================================
  // SECTION 8  _pds_hp_parse(buf_ptr, buf_len, out_ptr, out_cap) -> packed u64
  //
  // Walks the pragma block at the start of `buf_ptr[0..buf_len)`,
  // emitting one 32-byte PdsHpRecord per recognised directive into
  // `out_ptr[0..out_cap)`. Blank lines and regular `#` comments
  // (NOT `#pragma pds ...`) are skipped. The first non-blank,
  // non-comment, non-pragma line HALTS the walk cleanly (OK).
  //
  // Entry regs: rdi=buf_ptr, rsi=buf_len, rdx=out_ptr, rcx=out_cap.
  // Return: rax packed per SECTION 3.
  //
  // Pure leaf. Register map in SECTION 4.
  // ==========================================================================
  pub let _pds_hp_parse : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (buf_ptr: u64) (buf_len: u64) (out_ptr: u64) (out_cap: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "UMB-W25 R227.M1 (paideia-os #2703): pds-lang header pragma parser. Walks `#pragma pds <directive>` lines at the start of a .pds buffer, emitting one 32-byte PdsHpRecord per recognised directive. M1 directives: version/strict/charset/history_default_cap. Blank lines and regular `#` comments (NOT `#pragma pds ...`) are skipped. First non-blank, non-comment, non-pragma line halts cleanly (OK). Returns (count << 32) | status on OK; (byte_offset << 32) | PDS_HP_ERR_SYNTAX on bad grammar; (count_before << 32) | PDS_HP_ERR_UNKNOWN_PRAGMA / BAD_VERSION / OUT_TOO_SMALL on the respective errors. Pure leaf -- no nested call, so rsp alignment inside the body is relaxed. Five callee-save pushes (rbx=buf_start, r12=buf_end, r13=cursor, r14=out_cursor, r15=out_end) + no sub rsp since no inner call needs alignment. r11 holds pragmas_count across the whole body (caller-save but survives: no inner call). Encoder discipline: no `test rN,rN` (always `cmp reg,0`); no 2-op `imul r,imm` (NUM parse uses shl+add); no `and reg,imm64` (not needed here); byte stores limited to `mov_b [reg+off],reg` and `mov_b [reg+reg*1],reg` -- the byte-copy pre-advances the destination into rsi to sidestep the unsupported `[reg+reg*1+off]` form. All string literals are single-line. Module basename `HeaderPragma` matches file basename `header_pragma.pdx`. Labels prefixed `pds_hp_`.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                     // buf_start
        mov r12, rsi;
        add r12, rdi;                     // buf_end = buf_start + buf_len
        mov r13, rdi;                     // cursor
        mov r14, rdx;                     // out_cursor
        mov r15, rdx;
        add r15, rcx;                     // out_end = out_ptr + out_cap
        xor r11, r11;                     // pragmas_count = 0

        // ------------------------------------------------------------------
        // LINE DISPATCH
        // ------------------------------------------------------------------
      pds_hp_line_start:
        cmp r13, r12;
        jae pds_hp_done;

        // Skip leading WS (SP / HT / CR). LF is a blank line.
      pds_hp_skip_ws:
        cmp r13, r12;
        jae pds_hp_done;
        xor r10, r10;
        mov_b r10, [r13 + 0];
        cmp r10, 0x20;                    // ' '
        je  pds_hp_ws_adv;
        cmp r10, 0x09;                    // '\t'
        je  pds_hp_ws_adv;
        cmp r10, 0x0D;                    // '\r'
        je  pds_hp_ws_adv;
        jmp pds_hp_after_ws;

      pds_hp_ws_adv:
        add r13, 1;
        jmp pds_hp_skip_ws;

      pds_hp_after_ws:
        // r10 holds the first non-WS byte on this line.
        cmp r10, 0x0A;                    // LF -> blank line
        je  pds_hp_eat_lf;
        cmp r10, 0x23;                    // '#' -> comment or pragma
        je  pds_hp_check_pragma;
        // Anything else: pragma block ended. Clean exit.
        jmp pds_hp_done;

      pds_hp_eat_lf:
        add r13, 1;
        jmp pds_hp_line_start;

        // ------------------------------------------------------------------
        // Match "#pragma pds " prefix (12 bytes).
        //
        // If 12 bytes are not available, assume this is a regular `#`
        // comment at EOF and HALT (not an error): the caller's body
        // parser will pick up the trailing bytes.
        //
        // If the first 12 bytes do NOT match, treat the whole line as
        // a regular `#` comment and skip it.
        // ------------------------------------------------------------------
      pds_hp_check_pragma:
        mov r9, r13;
        add r9, 12;
        cmp r9, r12;
        ja  pds_hp_done;                  // short tail, clean exit

        lea r9, [rip + pds_hp_prefix];
        xor rcx, rcx;
      pds_hp_pfx_cmp:
        cmp rcx, 12;
        jae pds_hp_pfx_ok;
        xor r10, r10;
        mov_b r10, [r13 + rcx * 1];
        xor r8, r8;
        mov_b r8, [r9 + rcx * 1];
        cmp r10, r8;
        jne pds_hp_regular_comment;
        add rcx, 1;
        jmp pds_hp_pfx_cmp;

      pds_hp_pfx_ok:
        add r13, 12;                      // past "#pragma pds "
        jmp pds_hp_dispatch;

      pds_hp_regular_comment:
        // r13 still points at '#'. Scan to LF or EOF.
      pds_hp_rc_scan:
        cmp r13, r12;
        jae pds_hp_done;
        xor r10, r10;
        mov_b r10, [r13 + 0];
        add r13, 1;
        cmp r10, 0x0A;
        je  pds_hp_line_start;
        jmp pds_hp_rc_scan;

        // ------------------------------------------------------------------
        // DIRECTIVE DISPATCH
        // Switch on first byte: 'v' / 's' / 'c' / 'h'.
        // Anything else -> PDS_HP_ERR_UNKNOWN_PRAGMA.
        // ------------------------------------------------------------------
      pds_hp_dispatch:
        cmp r13, r12;
        jae pds_hp_unknown;               // empty directive
        xor r10, r10;
        mov_b r10, [r13 + 0];
        cmp r10, 0x76;                    // 'v'
        je  pds_hp_do_version;
        cmp r10, 0x73;                    // 's'
        je  pds_hp_do_strict;
        cmp r10, 0x63;                    // 'c'
        je  pds_hp_do_charset;
        cmp r10, 0x68;                    // 'h'
        je  pds_hp_do_history;
        jmp pds_hp_unknown;

        // ==================================================================
        // DIRECTIVE: version "<N.N.N>"
        // ==================================================================
      pds_hp_do_version:
        // Match 7 bytes "version"
        mov r9, r13;
        add r9, 7;
        cmp r9, r12;
        ja  pds_hp_unknown;

        lea r9, [rip + pds_hp_dir_version];
        xor rcx, rcx;
      pds_hp_v_kw_cmp:
        cmp rcx, 7;
        jae pds_hp_v_kw_ok;
        xor r10, r10;
        mov_b r10, [r13 + rcx * 1];
        xor r8, r8;
        mov_b r8, [r9 + rcx * 1];
        cmp r10, r8;
        jne pds_hp_unknown;
        add rcx, 1;
        jmp pds_hp_v_kw_cmp;

      pds_hp_v_kw_ok:
        add r13, 7;

        // Require at least one WS after "version".
        cmp r13, r12;
        jae pds_hp_bad;
        xor r10, r10;
        mov_b r10, [r13 + 0];
        cmp r10, 0x20;
        je  pds_hp_v_ws_first;
        cmp r10, 0x09;
        je  pds_hp_v_ws_first;
        jmp pds_hp_bad;

      pds_hp_v_ws_first:
        add r13, 1;

        // Skip any additional WS.
      pds_hp_v_ws_more:
        cmp r13, r12;
        jae pds_hp_bad;
        xor r10, r10;
        mov_b r10, [r13 + 0];
        cmp r10, 0x20;
        je  pds_hp_v_ws_more_adv;
        cmp r10, 0x09;
        je  pds_hp_v_ws_more_adv;
        jmp pds_hp_v_want_quote;
      pds_hp_v_ws_more_adv:
        add r13, 1;
        jmp pds_hp_v_ws_more;

      pds_hp_v_want_quote:
        // r10 holds the first non-WS byte; must be '"'.
        cmp r10, 0x22;
        jne pds_hp_bad;
        add r13, 1;

        // r9 = version_start.
        mov r9, r13;

      pds_hp_v_scan:
        cmp r13, r12;
        jae pds_hp_bad;                   // unterminated string
        xor r10, r10;
        mov_b r10, [r13 + 0];
        cmp r10, 0x22;                    // closing quote
        je  pds_hp_v_scan_end;
        cmp r10, 0x0A;                    // LF inside string
        je  pds_hp_bad;
        // Valid version byte: digit or '.'
        cmp r10, 0x30;
        jb  pds_hp_v_check_dot;
        cmp r10, 0x39;
        jbe pds_hp_v_scan_adv;
      pds_hp_v_check_dot:
        cmp r10, 0x2E;
        je  pds_hp_v_scan_adv;
        jmp pds_hp_bad_version;

      pds_hp_v_scan_adv:
        add r13, 1;
        jmp pds_hp_v_scan;

      pds_hp_v_scan_end:
        // r13 at closing quote. version_len = r13 - r9.
        mov r8, r13;
        sub r8, r9;                       // version_len (callee-save r8)
        cmp r8, 0;
        je  pds_hp_bad_version;           // empty version string
        mov r10, 24;                      // PDS_HP_VERSION_MAX
        cmp r8, r10;
        ja  pds_hp_bad_version;           // too long

        add r13, 1;                       // past closing quote

        // --- Commit a KIND_VERSION record ---
        // Capacity check.
        mov r10, r14;
        add r10, 32;
        cmp r10, r15;
        ja  pds_hp_too_small;

        // Zero 32 bytes.
        xor rax, rax;
        mov [r14 + 0], rax;
        mov [r14 + 8], rax;
        mov [r14 + 16], rax;
        mov [r14 + 24], rax;

        // kind (u16 @+0) = 1
        mov r10, 1;
        mov_w [r14 + 0], r10;
        // len (u16 @+2) = version_len
        mov_w [r14 + 2], r8;

        // Byte-copy r8 bytes from r9 (version_start) to [r14+8..].
        // The `mov_b [reg+reg*1+off], reg` form is NOT supported by
        // the encoder today; pre-advance the destination into rsi so
        // the inner store uses the legal `[reg+reg*1]` form.
        mov rsi, r14;
        add rsi, 8;
        xor rcx, rcx;
      pds_hp_v_cp:
        cmp rcx, r8;
        jae pds_hp_v_cp_done;
        xor r10, r10;
        mov_b r10, [r9 + rcx * 1];
        mov_b [rsi + rcx * 1], r10;
        add rcx, 1;
        jmp pds_hp_v_cp;
      pds_hp_v_cp_done:

        add r14, 32;
        add r11, 1;
        jmp pds_hp_trailing_tail;

        // ==================================================================
        // DIRECTIVE: strict
        // ==================================================================
      pds_hp_do_strict:
        // Match 6 bytes "strict".
        mov r9, r13;
        add r9, 6;
        cmp r9, r12;
        ja  pds_hp_unknown;

        lea r9, [rip + pds_hp_dir_strict];
        xor rcx, rcx;
      pds_hp_s_kw_cmp:
        cmp rcx, 6;
        jae pds_hp_s_kw_ok;
        xor r10, r10;
        mov_b r10, [r13 + rcx * 1];
        xor r8, r8;
        mov_b r8, [r9 + rcx * 1];
        cmp r10, r8;
        jne pds_hp_unknown;
        add rcx, 1;
        jmp pds_hp_s_kw_cmp;

      pds_hp_s_kw_ok:
        add r13, 6;

        // --- Commit a KIND_STRICT record ---
        mov r10, r14;
        add r10, 32;
        cmp r10, r15;
        ja  pds_hp_too_small;

        xor rax, rax;
        mov [r14 + 0], rax;
        mov [r14 + 8], rax;
        mov [r14 + 16], rax;
        mov [r14 + 24], rax;

        mov r10, 2;                       // KIND_STRICT
        mov_w [r14 + 0], r10;
        // len = 0; already zero.

        add r14, 32;
        add r11, 1;
        jmp pds_hp_trailing_tail;

        // ==================================================================
        // DIRECTIVE: charset utf8
        // ==================================================================
      pds_hp_do_charset:
        // Match 7 bytes "charset".
        mov r9, r13;
        add r9, 7;
        cmp r9, r12;
        ja  pds_hp_unknown;

        lea r9, [rip + pds_hp_dir_charset];
        xor rcx, rcx;
      pds_hp_c_kw_cmp:
        cmp rcx, 7;
        jae pds_hp_c_kw_ok;
        xor r10, r10;
        mov_b r10, [r13 + rcx * 1];
        xor r8, r8;
        mov_b r8, [r9 + rcx * 1];
        cmp r10, r8;
        jne pds_hp_unknown;
        add rcx, 1;
        jmp pds_hp_c_kw_cmp;

      pds_hp_c_kw_ok:
        add r13, 7;

        // Require at least one WS.
        cmp r13, r12;
        jae pds_hp_bad;
        xor r10, r10;
        mov_b r10, [r13 + 0];
        cmp r10, 0x20;
        je  pds_hp_c_ws_first;
        cmp r10, 0x09;
        je  pds_hp_c_ws_first;
        jmp pds_hp_bad;

      pds_hp_c_ws_first:
        add r13, 1;
      pds_hp_c_ws_more:
        cmp r13, r12;
        jae pds_hp_bad;
        xor r10, r10;
        mov_b r10, [r13 + 0];
        cmp r10, 0x20;
        je  pds_hp_c_ws_more_adv;
        cmp r10, 0x09;
        je  pds_hp_c_ws_more_adv;
        jmp pds_hp_c_want_utf8;
      pds_hp_c_ws_more_adv:
        add r13, 1;
        jmp pds_hp_c_ws_more;

      pds_hp_c_want_utf8:
        // Match 4 bytes "utf8" at r13.
        mov r9, r13;
        add r9, 4;
        cmp r9, r12;
        ja  pds_hp_bad_version;           // charset value expected,
                                          // truncated -> treat as a
                                          // not-utf8 charset. We fold
                                          // "not utf8" to BAD_VERSION
                                          // at M1 (M1 accepts only
                                          // utf8). An ERR_BAD_CHARSET
                                          // lands with M2.

        lea r9, [rip + pds_hp_val_utf8];
        xor rcx, rcx;
      pds_hp_c_val_cmp:
        cmp rcx, 4;
        jae pds_hp_c_val_ok;
        xor r10, r10;
        mov_b r10, [r13 + rcx * 1];
        xor r8, r8;
        mov_b r8, [r9 + rcx * 1];
        cmp r10, r8;
        jne pds_hp_bad_version;           // only utf8 accepted at M1
        add rcx, 1;
        jmp pds_hp_c_val_cmp;

      pds_hp_c_val_ok:
        add r13, 4;

        // --- Commit a KIND_CHARSET record (value="utf8", len=4) ---
        mov r10, r14;
        add r10, 32;
        cmp r10, r15;
        ja  pds_hp_too_small;

        xor rax, rax;
        mov [r14 + 0], rax;
        mov [r14 + 8], rax;
        mov [r14 + 16], rax;
        mov [r14 + 24], rax;

        mov r10, 3;                       // KIND_CHARSET
        mov_w [r14 + 0], r10;
        mov r10, 4;                       // len
        mov_w [r14 + 2], r10;

        // Copy "utf8" into value[0..4]. Four byte stores.
        mov r10, 0x75;                    // 'u'
        mov_b [r14 + 8], r10;
        mov r10, 0x74;                    // 't'
        mov_b [r14 + 9], r10;
        mov r10, 0x66;                    // 'f'
        mov_b [r14 + 10], r10;
        mov r10, 0x38;                    // '8'
        mov_b [r14 + 11], r10;

        add r14, 32;
        add r11, 1;
        jmp pds_hp_trailing_tail;

        // ==================================================================
        // DIRECTIVE: history_default_cap <N>
        // ==================================================================
      pds_hp_do_history:
        // Match 19 bytes "history_default_cap".
        mov r9, r13;
        add r9, 19;
        cmp r9, r12;
        ja  pds_hp_unknown;

        lea r9, [rip + pds_hp_dir_history];
        xor rcx, rcx;
      pds_hp_h_kw_cmp:
        cmp rcx, 19;
        jae pds_hp_h_kw_ok;
        xor r10, r10;
        mov_b r10, [r13 + rcx * 1];
        xor r8, r8;
        mov_b r8, [r9 + rcx * 1];
        cmp r10, r8;
        jne pds_hp_unknown;
        add rcx, 1;
        jmp pds_hp_h_kw_cmp;

      pds_hp_h_kw_ok:
        add r13, 19;

        // Require at least one WS.
        cmp r13, r12;
        jae pds_hp_bad;
        xor r10, r10;
        mov_b r10, [r13 + 0];
        cmp r10, 0x20;
        je  pds_hp_h_ws_first;
        cmp r10, 0x09;
        je  pds_hp_h_ws_first;
        jmp pds_hp_bad;

      pds_hp_h_ws_first:
        add r13, 1;
      pds_hp_h_ws_more:
        cmp r13, r12;
        jae pds_hp_bad;
        xor r10, r10;
        mov_b r10, [r13 + 0];
        cmp r10, 0x20;
        je  pds_hp_h_ws_more_adv;
        cmp r10, 0x09;
        je  pds_hp_h_ws_more_adv;
        jmp pds_hp_h_want_num;
      pds_hp_h_ws_more_adv:
        add r13, 1;
        jmp pds_hp_h_ws_more;

      pds_hp_h_want_num:
        // r10 has first non-WS byte; must be a digit.
        cmp r10, 0x30;
        jb  pds_hp_bad;
        cmp r10, 0x39;
        ja  pds_hp_bad;

        // Accumulate decimal into rdi.
        xor rdi, rdi;                     // num = 0
      pds_hp_h_num_loop:
        cmp r13, r12;
        jae pds_hp_h_num_done;
        xor r10, r10;
        mov_b r10, [r13 + 0];
        cmp r10, 0x30;
        jb  pds_hp_h_num_done;
        cmp r10, 0x39;
        ja  pds_hp_h_num_done;

        // digit = r10 - '0'
        sub r10, 0x30;

        // num = num * 10 + digit
        //   tmp = num
        //   num <<= 3            ; num *= 8
        //   tmp <<= 1            ; tmp = 2 * orig
        //   num += tmp           ; num = 10 * orig
        //   num += digit
        mov rax, rdi;
        shl rdi, 3;
        shl rax, 1;
        add rdi, rax;
        add rdi, r10;

        add r13, 1;
        jmp pds_hp_h_num_loop;

      pds_hp_h_num_done:
        // --- Commit a KIND_HISTORY_CAP record (value[0..8] = num u64) ---
        mov r10, r14;
        add r10, 32;
        cmp r10, r15;
        ja  pds_hp_too_small;

        xor rax, rax;
        mov [r14 + 0], rax;
        mov [r14 + 8], rax;
        mov [r14 + 16], rax;
        mov [r14 + 24], rax;

        mov r10, 4;                       // KIND_HISTORY_CAP
        mov_w [r14 + 0], r10;
        mov r10, 8;                       // len = 8 (u64 payload)
        mov_w [r14 + 2], r10;

        // Store u64 value at [r14+8].
        mov [r14 + 8], rdi;

        add r14, 32;
        add r11, 1;
        jmp pds_hp_trailing_tail;

        // ==================================================================
        // SHARED TAIL -- consume any trailing WS, optional comment, LF.
        // Returns to pds_hp_line_start on success, pds_hp_bad on garbage.
        // ==================================================================
      pds_hp_trailing_tail:
        cmp r13, r12;
        jae pds_hp_done;                  // EOF right after directive
        xor r10, r10;
        mov_b r10, [r13 + 0];
        cmp r10, 0x20;
        je  pds_hp_tt_adv;
        cmp r10, 0x09;
        je  pds_hp_tt_adv;
        cmp r10, 0x0D;
        je  pds_hp_tt_adv;
        cmp r10, 0x23;                    // '#' trailing comment
        je  pds_hp_tt_cmt;
        cmp r10, 0x0A;
        je  pds_hp_tt_lf;
        jmp pds_hp_bad;

      pds_hp_tt_adv:
        add r13, 1;
        jmp pds_hp_trailing_tail;

      pds_hp_tt_cmt:
        add r13, 1;
      pds_hp_tt_cmt_scan:
        cmp r13, r12;
        jae pds_hp_done;
        xor r10, r10;
        mov_b r10, [r13 + 0];
        add r13, 1;
        cmp r10, 0x0A;
        je  pds_hp_line_start;
        jmp pds_hp_tt_cmt_scan;

      pds_hp_tt_lf:
        add r13, 1;
        jmp pds_hp_line_start;

        // ==================================================================
        // EXIT PATHS
        // ==================================================================
        // On BAD_SYNTAX: pack byte offset (r13 - rbx) into bits 32..63
        // of PDS_HP_ERR_SYNTAX.
      pds_hp_bad:
        mov r10, r13;
        sub r10, rbx;
        shl r10, 32;
        mov rax, 0x2800;
        or  rax, r10;
        jmp pds_hp_out;

      pds_hp_bad_version:
        mov rax, r11;
        shl rax, 32;
        mov r10, 0x2802;
        or  rax, r10;
        jmp pds_hp_out;

      pds_hp_unknown:
        mov rax, r11;
        shl rax, 32;
        mov r10, 0x2801;
        or  rax, r10;
        jmp pds_hp_out;

      pds_hp_too_small:
        mov rax, r11;
        shl rax, 32;
        mov r10, 0x2803;
        or  rax, r10;
        jmp pds_hp_out;

      pds_hp_done:
        // OK: (count << 32) | 0
        mov rax, r11;
        shl rax, 32;
        // PDS_HP_OK == 0, no OR needed.

      pds_hp_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION 9  _pds_hp_record_kind(record_ptr) -> u64
  //
  // Accessor: load the u16 kind at byte offset 0 of a PdsHpRecord
  // and zero-extend to u64. Pure leaf; used by consumer code to
  // route a record to its enforcement site without re-parsing.
  // ==========================================================================
  pub let _pds_hp_record_kind : (u64) -> u64 !{mem} @{} =
    fn (record_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "UMB-W25 R227.M1 (paideia-os #2703): read u16 kind at offset 0 of a 32-byte PdsHpRecord and zero-extend to u64. Pure leaf. No stack use. Encoder discipline: xor+mov_w zero-ext per crs.pdx L320 precedent.",
      block: {
        xor rax, rax;
        mov_w rax, [rdi + 0];
        ret
      }
    }

  // ==========================================================================
  // SECTION 10  _pds_hp_record_len(record_ptr) -> u64
  //
  // Accessor: load the u16 len at byte offset 2 of a PdsHpRecord
  // and zero-extend to u64.
  // ==========================================================================
  pub let _pds_hp_record_len : (u64) -> u64 !{mem} @{} =
    fn (record_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "UMB-W25 R227.M1 (paideia-os #2703): read u16 len at offset 2 of a 32-byte PdsHpRecord and zero-extend to u64. Pure leaf. No stack use.",
      block: {
        xor rax, rax;
        mov_w rax, [rdi + 2];
        ret
      }
    }

  // ==========================================================================
  // SECTION 11  _pds_hp_record_u64(record_ptr) -> u64
  //
  // Accessor: load the u64 payload at byte offset 8 of a PdsHpRecord.
  // Semantically valid only for KIND_HISTORY_CAP (len == 8). The
  // caller is responsible for the kind check.
  // ==========================================================================
  pub let _pds_hp_record_u64 : (u64) -> u64 !{mem} @{} =
    fn (record_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "UMB-W25 R227.M1 (paideia-os #2703): read u64 payload at offset 8 of a 32-byte PdsHpRecord. Semantically valid only for KIND_HISTORY_CAP (len==8); caller gates the kind. Pure leaf. No stack use.",
      block: {
        mov rax, [rdi + 8];
        ret
      }
    }
}
