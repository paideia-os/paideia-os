// src/kernel/core/pds/caps_decl_gate.pdx -- UMB-W29 R133.M2 (paideia-os #2621)
//
// `.pds` CAPABILITY-DECLARATION LOAD-TIME GATE.
//
// R133.M1 (Wave 113, paideia-os#2620) landed the `.pds` BINARY
// CONTAINER reader -- `_ctr_parse` emits the 32-byte section-header
// stream and `_ctr_locate_section` finds a section by kind.
//
// R227.M2 (Wave 115, paideia-os#2704) landed the pds-lang CAP-DECL
// CHECKER -- `_pds_cdc_check` validates that an array of 16-byte
// DeclaredCap records satisfies the narrow-only invariant against a
// caller-supplied `KIND_CAP_ENV` grant env.
//
// R133.M2 (THIS FILE) is the THIN INTEGRATION LAYER between those
// two primitives: during pds-script LOAD time, before any TEXT byte
// of the container is dispatched to the shell command decoder, this
// file:
//
//   1. Locates the CAPS_DECL section (kind=CT_SEC_CAPS_DECL=3) in a
//      pre-read `.pds` container buffer via `_ctr_locate_section`.
//   2. Reads the CAPS_DECL section's compact header
//      `[u32 n_decls][u32 reserved]` and bounds-checks the payload.
//   3. Decodes the DeclaredCap records that follow (16 bytes each,
//      same wire shape as `_pds_cdc_check` expects: {name_hash: u64,
//      rights: u64}).
//   4. Invokes `_pds_cdc_check` with a NIL pragmas array (the binary
//      container does not yet carry a textual pragma block at M2 --
//      that reconciles at R133.M4+ when the TEXT-and-pragma unifier
//      lands).
//   5. Returns a bare errno in the 0x3200..0x32FF band (new carve-out
//      above R227.M2's 0x3100..0x31FF band and R227.M1's 0x2800..0x28FF).
//
// On OK (0), the caller may proceed to dispatch TEXT bytes to the
// shell command decoder. On any failure, the caller MUST abort the
// load without touching the session's cap-env: the gate is the LAST
// read-only predicate before any load-time side effect.
//
// =============================================================================
// SECTION 0  WHY THIS FILE EXISTS
// =============================================================================
//
// The gate is NOT the checker and NOT the container reader; it is
// the WIRE between them. Three forces require a dedicated layer:
//
//   (A) SECTION DISCOVERY. The container reader is agnostic about
//       section kinds: it emits records and lets the caller filter
//       by kind. The checker is agnostic about containers: it
//       consumes a flat DeclaredCap array. Without the gate, every
//       pds-load call site would reimplement the "find CAPS_DECL,
//       decode, dispatch" boilerplate, and the policy decision (what
//       happens when CAPS_DECL is missing) would drift between call
//       sites.
//
//   (B) POLICY. "What if the container has no CAPS_DECL section?"
//       The container reader returns NOT_FOUND (0x2905). The checker
//       cannot be invoked without a declared-caps array. The gate
//       makes the POLICY decision explicit: at M2, no CAPS_DECL
//       section => REFUSE the load (strict posture). An "allow-empty"
//       variant lands at M3 behind a load-time flag (see §Y of the
//       design doc at `design/shell/pds-caps-decl-gate.md`).
//
//   (C) ERROR-CODE NAMESPACING. The checker's 0x31xx band carries
//       cap-decl-specific errors (UNDECLARED, RIGHTS_WIDEN, etc.).
//       The gate needs its own band for container-level failures
//       (NO_CAPS_DECL, BAD_HEADER) PLUS a wrapper for passing through
//       the checker's errno without ambiguity. The 0x3200..0x32FF
//       band is reserved for this file; 0x3202 (CHECK_FAILED) is the
//       passthrough form -- see §3.
//
// =============================================================================
// SECTION 1  CAPS_DECL SECTION BINARY LAYOUT  (M2-DEFINED)
// =============================================================================
//
// The `.pds` container reserves kind=CT_SEC_CAPS_DECL=3 for the
// capability-declaration bundle. R133.M1 treated the payload shape as
// opaque bytes; R133.M2 pins the shape:
//
//     +--------------------------------------------------------+
//     | CapsDeclSectionHeader (8 bytes)                        |
//     |   [0..4]   n_decls      u32   number of DeclaredCap     |
//     |                               records that follow      |
//     |                               (0..CAPS_DECL_MAX = 64)   |
//     |   [4..8]   reserved     u32   zero at M2                |
//     +--------------------------------------------------------+
//     | DeclaredCap[0]  (16 bytes)                             |
//     | DeclaredCap[1]  (16 bytes)                             |
//     |   ...                                                  |
//     | DeclaredCap[n_decls-1]                                 |
//     +--------------------------------------------------------+
//
// Each DeclaredCap mirrors R227.M2's record shape exactly:
//
//     byte [ 0.. 8]  name_hash  u64   FNV-1a 64 of the cap name
//     byte [ 8..16]  rights     u64   bit-mask requested
//
// The on-wire shape is REUSED unchanged from the checker so no
// re-encoding is needed between layers -- the gate hands a pointer
// into the container buffer directly to `_pds_cdc_check` as the
// `declared_caps_ptr` argument.
//
// Invariants enforced at parse time:
//
//   (G1) caps_size >= 8                     (header fits in payload)
//   (G2) n_decls <= CAPS_DECL_MAX (64)       (bounds total array size)
//   (G3) caps_size >= 8 + n_decls * 16       (DeclaredCap stream fits)
//
// A failure at any invariant surfaces as PDS_CDG_ERR_BAD_HEADER. The
// gate performs NO decoding beyond those three checks; it hands the
// DeclaredCap pointer to the checker, which performs the per-record
// invariants (name_hash != 0, narrow-only rights check).
//
// =============================================================================
// SECTION 2  CAPS_DECL_MAX  (TRANSITIONAL CEILING)
// =============================================================================
//
// At M2, a single `.pds` container may declare at most 64 capabilities.
// Rationale:
//
//   * The checker's narrow-only loop is O(n_declared * cap_env_lookup);
//     cap_env_lookup is O(1) given the KIND_CAP_ENV slot bridge, so
//     the check is O(n_declared). A ceiling at 64 keeps the worst-case
//     gate cost bounded without the checker needing to grow a work-
//     queue abstraction.
//
//   * The CT_SEC_CAPS_DECL section carries 8 B header + 16 B *  n_decls
//     = 8 + 64 * 16 = 1032 B max. That fits comfortably inside a
//     single page without the loader needing to span a payload across
//     page boundaries.
//
//   * The `KIND_CAP_ENV` substrate (R125.M1) uses CAP_ENV_SLOTS = 6
//     slots at M2, so the hash-to-slot bridge (R125.M3 pattern reused
//     at R227.M2 §3) will collide many declared caps onto the same
//     parent -- a ceiling at 64 is already generous relative to the
//     substrate's 6 slots. Scripts that declare more than 64 caps
//     almost certainly have a design error.
//
// R133.M4+ lifts the ceiling once the slot bridge is replaced with
// the real `_cap_env_lookup_by_hash` resolver.
//
// =============================================================================
// SECTION 3  RETURN CODES
// =============================================================================
//
// _pds_cdg_gate returns a BARE u64 errno:
//
//   PDS_CDG_OK                     = 0x0000     all declared caps pass.
//
//   PDS_CDG_ERR_NO_CAPS_DECL       = 0x3200     container has no section
//                                               of kind=CT_SEC_CAPS_DECL.
//                                               M2 refuses: a `.pds`
//                                               container that does not
//                                               explicitly declare its
//                                               capabilities cannot be
//                                               loaded. See §Y of the
//                                               design doc for the
//                                               "allow-empty" variant
//                                               deferred to M3.
//
//   PDS_CDG_ERR_BAD_HEADER         = 0x3201     caller-supplied container
//                                               buffer fails one of:
//                                                 - container-header
//                                                   validation (BAD_MAGIC,
//                                                   BAD_VERSION, SECTION_
//                                                   COUNT, SECTION_
//                                                   OVERRUN surfaced
//                                                   by _ctr_locate_
//                                                   section) OR
//                                                 - CAPS_DECL section
//                                                   payload geometry
//                                                   (G1/G2/G3 §1).
//                                               One errno collapses
//                                               both because the gate's
//                                               caller is the pds
//                                               loader, which abort-
//                                               and-logs on any header
//                                               fault without needing
//                                               a per-cause distinction.
//
//   PDS_CDG_ERR_CHECK_FAILED       = 0x3202     the checker returned
//                                               non-zero. The gate
//                                               WRAPS the checker's
//                                               errno into the high
//                                               16 bits of the return
//                                               value so the caller
//                                               can recover the
//                                               specific PDS_CDC_ERR_*
//                                               cause without a side-
//                                               channel:
//
//                                                 bits [15: 0] = 0x3202
//                                                 bits [31:16] = CDC errno
//                                                                (0x3100..
//                                                                 0x3103)
//                                                 bits [63:32] = 0
//
//                                               e.g. UNDECLARED (0x3100)
//                                               surfaces as 0x31000000_
//                                               00003202; RIGHTS_WIDEN
//                                               (0x3101) as 0x31010000_
//                                               00003202. The non-zero
//                                               upper half acts as the
//                                               passthrough flag.
//
// The 0x3200 band is new; grep audit on 2026-10-14:
//   `grep -rnE '0x32[0-9A-F]{2}\b' src/` returns only unrelated hits
//   (0x322E3000 TPM revision u32, 0x3231564E NV12 fourcc) -- no
//   collision with 0x3200..0x3203.
//
// =============================================================================
// SECTION 4  TRANSITIONAL CONSTRAINT  (M2 ↔ CHECKER UNDECLARED)
// =============================================================================
//
// R227.M2's `_pds_cdc_check` enforces an UNDECLARED cross-check: the
// count of KIND_CAP pragmas in the pragma stream MUST equal n_declared.
// At R133.M2 the gate hands the checker a NIL pragma array (ptr=0,
// n=0) because the `.pds` BINARY container does not yet carry a
// textual pragma block as a dedicated section -- the pragmas live only
// in the SOURCE form and are consumed by `_pds_hp_parse` at compile
// time, not at load time.
//
// Consequence: the checker's KIND_CAP pragma count is 0. For the
// UNDECLARED check to pass, n_declared MUST ALSO be 0. The practical
// effect at M2 is:
//
//   container has no CAPS_DECL section            -> PDS_CDG_ERR_NO_CAPS_DECL
//   container has CAPS_DECL, n_decls = 0          -> PDS_CDG_OK
//                                                    (empty declaration;
//                                                     script requests no
//                                                     capabilities)
//   container has CAPS_DECL, n_decls > 0          -> PDS_CDG_ERR_CHECK_FAILED
//                                                    (wrapped UNDECLARED)
//
// This is a KNOWN transitional constraint. The reconciliation lands
// at R133.M4+ when either:
//
//   (a) the container compiler emits a dedicated CT_SEC_PRAGMAS section
//       mirroring the source pragma block, which the gate parses before
//       invoking the checker; OR
//   (b) the checker gains an explicit "trust-the-caller" flag that
//       suppresses the UNDECLARED cross-check for binary-container
//       loaders where no pragma stream exists.
//
// Both options preserve the checker's PURE PREDICATE contract. The
// design doc at `design/shell/pds-caps-decl-gate.md` §Y weighs the
// tradeoffs; (a) is favoured because it keeps the checker's shape
// uniform between the source-load and binary-load paths.
//
// In practice at M2, scripts that need to declare capabilities will
// continue to be loaded via the SOURCE path (R227.M1 pragma parser +
// R227.M2 checker direct). The BINARY container path is reserved for
// capability-free scripts and signed-code-mobility scenarios where
// the signer vouches that the compiled TEXT bytes are safe to run
// under the loader's env unchanged.
//
// =============================================================================
// SECTION 5  REGISTER PLAN
// =============================================================================
//
// _pds_cdg_gate -- 5 callee-save pushes + sub rsp, 16:
//
//     push rbx    rbx = container_ptr        (needed across all calls)
//     push r12    r12 = container_len        (passed to locate call)
//     push r13    r13 = grant_env_handle     (passed to checker call)
//     push r14    r14 = caps_payload_ptr     (survives checker call)
//     push r15    r15 = caps_size            (used post-locate for G1/G3)
//     sub rsp, 16
//                 [rsp+0]  = caps_off  (out-ptr into _ctr_locate_section)
//                 [rsp+8]  = caps_size (out-ptr into _ctr_locate_section;
//                                       also mirrored into r15 after return)
//
// Entry rsp%16==8; +5 pushes = +40 -> rsp%16==0; +sub16 -> rsp%16==0
// (call-ready at every nested call: _ctr_locate_section, _pds_cdc_check,
// klog_s1).
//
// =============================================================================
// SECTION 6  ENCODER DISCIPLINE  (feedback_pdx_encoder_pitfalls)
// =============================================================================
//
//   * cmp rN, 0          never `test rN, rN` (R123.M2 discipline)
//   * `and rN, imm8/32`  OK (bit 31 clear, sign-ext safe)
//   * `and rN, imm64`    FORBIDDEN -- stage via `mov r10, imm; and`
//   * no `imul r, imm`   stride DeclaredCap=16 -> `shl rN, 4`
//                         (no 2-op register-imm imul in the dialect)
//   * single-line `pub let` strings (one line per literal)
//   * module basename    `CapsDeclGate` matches `caps_decl_gate.pdx`
//   * fingerprint tags   N = len(string) + 1  (NUL counted)
//   * labels prefixed    `pds_cdg_` (reserved-word discipline)
//   * out-ptr idiom      `lea rN, [rsp + K]` for stack-local output
//                         pointers (precedent: caps_decl_loader.pdx L510)
//   * u32 zero-extend    `xor rax, rax; mov eax, [mem]` (defensive
//                         against future encoder churn around implicit
//                         zero-extension; precedent: container_reader.pdx)
//   * wrapper shift      `shl r11, 16` + `or rax, r11` for CDC errno
//                         into bits [31:16] of return value
//
// =============================================================================
// SECTION 7  CROSS-MODULE WIRING NOTES
// =============================================================================
//
// Expected caller sequence (lands at R131/R133.M3 pds-loader):
//
//   (1) Caller reads `.pds` file bytes into a buffer (buf_ptr, buf_len).
//   (2) Caller invokes:
//         e = _pds_cdg_gate(buf_ptr, buf_len, grant_env_handle)
//       On e==0, proceed to dispatch TEXT section. On e!=0, abort the
//       load WITHOUT touching the session's cap-env or any other state.
//   (3) [M4+] On OK, the loader mints each declared cap into the
//       session's own cap-env via `_cap_minter_derive` using the
//       bridge pattern established in R227.M2 §4.
//
// This module is a self-contained composition primitive. It does NOT
// mutate state. The one side effect is a single `klog_s1` fingerprint
// per return path, matching the checker's audit-trail discipline. On
// the success path, `pds.cdg: ok` lands at LEVEL_INFO; on every error
// path, `pds.cdg: <cause>` lands at LEVEL_WARN.
//
// Design doc: design/shell/pds-caps-decl-gate.md (M2 integration,
// policy decisions, allow-empty variant for M3, pragma reconciliation
// plan for M4).
//
// =============================================================================

module CapsDeclGate = structure {

  // ==========================================================================
  // SECTION 8  CONSTANTS
  // ==========================================================================

  // Return codes (SECTION 3).
  pub let PDS_CDG_OK                 : u64 = 0
  pub let PDS_CDG_ERR_NO_CAPS_DECL   : u64 = 0x3200
  pub let PDS_CDG_ERR_BAD_HEADER     : u64 = 0x3201
  pub let PDS_CDG_ERR_CHECK_FAILED   : u64 = 0x3202

  // Container reader error codes consumed by the gate's locate step.
  // Mirrored from container_reader.pdx SECTION 3. The gate collapses
  // all of these except NOT_FOUND into PDS_CDG_ERR_BAD_HEADER.
  pub let PDS_CDG_CT_NOT_FOUND       : u64 = 0x2905   // CT_ERR_NOT_FOUND

  // Section kind to locate (mirrors container_reader.pdx SECTION 2).
  pub let PDS_CDG_SEC_CAPS_DECL      : u64 = 3        // CT_SEC_CAPS_DECL

  // CapsDeclSection geometry (SECTION 1).
  pub let PDS_CDG_HEADER_SIZE        : u64 = 8        // n_decls + reserved
  pub let PDS_CDG_DECLARED_SIZE      : u64 = 16       // {name_hash, rights}
  pub let PDS_CDG_HEADER_OFF_NDECLS  : u64 = 0        // u32
  pub let PDS_CDG_HEADER_OFF_RSVD    : u64 = 4        // u32
  pub let PDS_CDG_CAPS_DECL_MAX      : u64 = 64       // SECTION 2 ceiling

  // Wrapper shift amount for CHECK_FAILED passthrough (SECTION 3).
  pub let PDS_CDG_CDC_SHIFT          : u64 = 16

  // ==========================================================================
  // SECTION 9  KLOG FINGERPRINT TAGS  (N = len(string) + 1, NUL inclusive)
  // ==========================================================================
  //
  // One-line-per-literal (single-line `pub let` discipline).
  //
  //   "pds.cdg: ok"                 = 11 + NUL -> N=12
  //   "pds.cdg: no caps-decl"       = 21 + NUL -> N=22
  //   "pds.cdg: bad header"         = 19 + NUL -> N=20
  //   "pds.cdg: check failed"       = 21 + NUL -> N=22
  pub let pds_cdg_tag_ok          : [u8; 12] = "pds.cdg: ok\0"
  pub let pds_cdg_tag_no_caps     : [u8; 22] = "pds.cdg: no caps-decl\0"
  pub let pds_cdg_tag_bad_header  : [u8; 20] = "pds.cdg: bad header\0"
  pub let pds_cdg_tag_check_fail  : [u8; 22] = "pds.cdg: check failed\0"

  // ==========================================================================
  // SECTION 10  _pds_cdg_gate(container_ptr, container_len,
  //                           grant_env_handle) -> errno
  //
  // The sole public entry point. See §0 for the role of this file,
  // §1 for the CAPS_DECL section layout, §3 for the return-code
  // table, §4 for the transitional UNDECLARED constraint, §5 for
  // the register plan.
  //
  // Entry: rdi=container_ptr, rsi=container_len, rdx=grant_env_handle
  // Return: rax = PDS_CDG_* errno (0 on success)
  //
  // Flow:
  //   step 1  locate CT_SEC_CAPS_DECL via _ctr_locate_section
  //   step 2  dispatch: NOT_FOUND -> NO_CAPS_DECL;
  //                      any other container error -> BAD_HEADER
  //   step 3  bounds-check caps_size vs CapsDeclSectionHeader (G1)
  //   step 4  load n_decls (u32 zero-ext); bounds-check against
  //            CAPS_DECL_MAX (G2) and caps_size >= 8 + n_decls*16 (G3)
  //   step 5  compute declared_caps_ptr = caps_payload_ptr + 8
  //   step 6  call _pds_cdc_check(0, 0, declared_caps_ptr, n_decls,
  //                               grant_env_handle)
  //   step 7  cdc_errno == 0 -> emit `pds.cdg: ok` fingerprint, ret 0
  //            cdc_errno != 0 -> emit `pds.cdg: check failed` fingerprint,
  //                               return 0x3202 | (cdc_errno << 16)
  // ==========================================================================
  pub let _pds_cdg_gate : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (container_ptr: u64) (container_len: u64) (grant_env_handle: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "UMB-W29 R133.M2 (paideia-os #2621): .pds load-time capability-declaration gate. Composes R133.M1 _ctr_locate_section + R227.M2 _pds_cdc_check into a single predicate: locate CT_SEC_CAPS_DECL (kind=3) in the container, bounds-check the compact `[u32 n_decls][u32 reserved]` payload header plus the n_decls*16-byte DeclaredCap stream, and dispatch to the checker with a nil pragmas array (binary container does not carry pragmas at M2; reconciles at R133.M4+). Returns PDS_CDG_OK (0) on success; PDS_CDG_ERR_NO_CAPS_DECL (0x3200) when CAPS_DECL is absent (M2 strict policy -- no caps-decl section means no load); PDS_CDG_ERR_BAD_HEADER (0x3201) collapses all container-header faults (BAD_MAGIC/BAD_VERSION/SECTION_COUNT/SECTION_OVERRUN surfaced by _ctr_locate_section) plus caps-section geometry faults (G1 caps_size>=8, G2 n_decls<=64, G3 caps_size>=8+n_decls*16); PDS_CDG_ERR_CHECK_FAILED (0x3202) wraps the checker's errno into bits [31:16] of the return value so the specific PDS_CDC_ERR_* cause survives without a side channel. 5 callee-save pushes (rbx=container_ptr, r12=container_len, r13=grant_env_handle, r14=caps_payload_ptr, r15=caps_size) + sub rsp,16 lands rsp%16==0 at every nested call: entry %16==8, +40+16=56, (8+56)%16==0. Stack locals [rsp+0]=caps_off, [rsp+8]=caps_size as out-pointers for _ctr_locate_section (precedent: elf/caps_decl_loader.pdx L510 pattern `lea rdx,[rsp+K]`). Encoder discipline: cmp rN,0 never test; stride 16 via `shl rN,4` never 2-op imul-imm; `and rN,imm` not needed; u32 zero-extend via `xor rax,rax; mov eax,[mem]`; 0x2905 CT_ERR_NOT_FOUND staged through r10 before compare (bit 31 clear but defensive against future encoder churn around large imm32 compares). Wrapper for CHECK_FAILED: `mov r11, cdc_errno; shl r11,16; mov rax,0x3202; or rax,r11`. One klog_s1 fingerprint per return path (LEVEL_INFO on OK, LEVEL_WARN on each error). Module basename CapsDeclGate matches file basename caps_decl_gate.pdx. Labels prefixed pds_cdg_ (reserved-word discipline + distinct from pds_cdc_ sibling).",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 16;

        mov rbx, rdi;                     // container_ptr
        mov r12, rsi;                     // container_len
        mov r13, rdx;                     // grant_env_handle

        // ------------------------------------------------------------------
        // Zero the stack locals so a sloppy locate return cannot leak
        // uninitialised bytes if we take an error path before the
        // locate call writes through them (defence in depth; the
        // _ctr_locate_section contract leaves out-pointers UNTOUCHED
        // on error, so these zeros are the authoritative values on
        // the BAD_HEADER / NO_CAPS_DECL paths).
        // ------------------------------------------------------------------
        xor rax, rax;
        mov [rsp + 0], rax;               // caps_off  = 0
        mov [rsp + 8], rax;               // caps_size = 0

        // ------------------------------------------------------------------
        // Step 1: _ctr_locate_section(container_ptr, container_len,
        //                             CT_SEC_CAPS_DECL=3,
        //                             &caps_off, &caps_size) -> rax
        // ------------------------------------------------------------------
        mov rdi, rbx;                     // container_ptr
        mov rsi, r12;                     // container_len
        mov rdx, 3;                       // CT_SEC_CAPS_DECL
        lea rcx, [rsp + 0];               // &caps_off
        lea r8,  [rsp + 8];               // &caps_size
        call _ctr_locate_section;

        // ------------------------------------------------------------------
        // Step 2: dispatch on locate return.
        //   rax == 0                 -> locate ok, continue
        //   rax == 0x2905 NOT_FOUND  -> NO_CAPS_DECL (M2 strict)
        //   rax == anything else     -> BAD_HEADER
        // ------------------------------------------------------------------
        cmp rax, 0;
        je  pds_cdg_locate_ok;

        mov r10, 0x2905;                  // CT_ERR_NOT_FOUND
        cmp rax, r10;
        je  pds_cdg_no_caps_decl;

        // Any other container-header fault -> BAD_HEADER.
        jmp pds_cdg_bad_header;

      pds_cdg_locate_ok:
        // ------------------------------------------------------------------
        // Load caps_off and caps_size from the stack. r14 holds the
        // caps PAYLOAD pointer (container_ptr + caps_off); r15 holds
        // caps_size for the per-check bounds tests (G1, G3).
        // ------------------------------------------------------------------
        mov r14, [rsp + 0];               // caps_off
        add r14, rbx;                     // caps_payload_ptr
        mov r15, [rsp + 8];               // caps_size

        // ------------------------------------------------------------------
        // (G1) caps_size >= 8  -- CapsDeclSectionHeader fits.
        // ------------------------------------------------------------------
        cmp r15, 8;
        jb  pds_cdg_bad_header;

        // ------------------------------------------------------------------
        // Load n_decls (u32 @ caps_payload_ptr + 0, zero-ext to u64).
        // ------------------------------------------------------------------
        xor rax, rax;
        mov eax, [r14 + 0];               // n_decls

        // ------------------------------------------------------------------
        // (G2) n_decls <= PDS_CDG_CAPS_DECL_MAX (64).
        // ------------------------------------------------------------------
        cmp rax, 64;                      // imm8 sign-ext safe
        ja  pds_cdg_bad_header;

        // ------------------------------------------------------------------
        // (G3) caps_size >= 8 + n_decls * 16.
        //        n_decls * 16 = rax << 4; no 2-op `imul r, imm`.
        // ------------------------------------------------------------------
        mov r11, rax;
        shl r11, 4;                       // n_decls * 16
        add r11, 8;                       // + header size
        cmp r15, r11;
        jb  pds_cdg_bad_header;

        // ------------------------------------------------------------------
        // Step 5: declared_caps_ptr = caps_payload_ptr + 8.
        //         Call _pds_cdc_check(nil, 0, declared_caps_ptr,
        //                             n_decls, grant_env_handle).
        //         rax still holds n_decls from the (G2) load.
        // ------------------------------------------------------------------
        xor rdi, rdi;                     // pragmas_ptr = 0 (nil)
        xor rsi, rsi;                     // n_pragmas  = 0
        mov rdx, r14;
        add rdx, 8;                       // declared_caps_ptr
        mov rcx, rax;                     // n_decls
        mov r8,  r13;                     // grant_env_handle
        call _pds_cdc_check;

        // ------------------------------------------------------------------
        // Step 7: branch on checker return.
        //   rax == 0           -> emit `pds.cdg: ok`, return 0
        //   rax != 0           -> emit `pds.cdg: check failed`,
        //                          return 0x3202 | (cdc_errno << 16)
        // ------------------------------------------------------------------
        cmp rax, 0;
        je  pds_cdg_ok;

        // Wrap CDC errno into high 16 bits of the return value.
        // r11 = cdc_errno << 16; rax = 0x3202; rax = rax | r11.
        // r12 (container_len) is dead after the locate step and is
        // callee-saved, so it survives klog_s1 (r11 is caller-saved
        // and klog_emit_core's callees clobber it).
        mov r12, rax;
        shl r12, 16;

        // Fingerprint BEFORE the final composition so the klog_s1
        // args can clobber rax safely.
        mov rdi, 2;                       // LEVEL_WARN
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + pds_cdg_tag_check_fail];
        call klog_s1;

        mov rax, 0x3202;                  // PDS_CDG_ERR_CHECK_FAILED
        or  rax, r12;
        jmp pds_cdg_out;

      pds_cdg_ok:
        mov rdi, 3;                       // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + pds_cdg_tag_ok];
        call klog_s1;
        xor rax, rax;                     // PDS_CDG_OK
        jmp pds_cdg_out;

      pds_cdg_no_caps_decl:
        mov rdi, 2;                       // LEVEL_WARN
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + pds_cdg_tag_no_caps];
        call klog_s1;
        mov rax, 0x3200;                  // PDS_CDG_ERR_NO_CAPS_DECL
        jmp pds_cdg_out;

      pds_cdg_bad_header:
        mov rdi, 2;                       // LEVEL_WARN
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + pds_cdg_tag_bad_header];
        call klog_s1;
        mov rax, 0x3201;                  // PDS_CDG_ERR_BAD_HEADER

      pds_cdg_out:
        add rsp, 16;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION 11  _pds_cdg_unwrap_cdc_errno(packed) -> u64
  //
  // Accessor: given a PDS_CDG_ERR_CHECK_FAILED-wrapped return value
  // (low 16 bits = 0x3202, bits [31:16] = CDC errno), recover the
  // original PDS_CDC_ERR_* errno by shifting right 16 and masking to
  // u16. Returns 0 if the input is not a CHECK_FAILED code.
  //
  // Pure leaf. No stack use. Caller: tests + any audit path that
  // wants to log the specific CDC cause.
  // ==========================================================================
  pub let _pds_cdg_unwrap_cdc_errno : (u64) -> u64 !{} @{} =
    fn (packed: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "UMB-W29 R133.M2 (paideia-os #2621): recover the wrapped PDS_CDC_ERR_* errno from a PDS_CDG_ERR_CHECK_FAILED return value. Checks the low 16 bits against 0x3202 (CHECK_FAILED sentinel); on non-match returns 0. On match, shifts right 16 and masks to 0xFFFF to recover the CDC errno. Pure leaf, no stack use, no nested call. Encoder discipline: `and rN, imm16` fits imm32 (0xFFFF, bit 31 clear); `shr rN, imm8` is the standard right-shift form; cmp rN,0 pattern not needed (we compare against 0x3202 directly, which fits imm32 sign-ext safe).",
      block: {
        // low16 = packed & 0xFFFF
        mov rax, rdi;
        mov r10, 0xFFFF;
        and rax, r10;

        // if low16 != 0x3202 -> return 0
        mov r10, 0x3202;
        cmp rax, r10;
        jne pds_cdg_unw_zero;

        // cdc = (packed >> 16) & 0xFFFF
        mov rax, rdi;
        shr rax, 16;
        mov r10, 0xFFFF;
        and rax, r10;
        ret

      pds_cdg_unw_zero:
        xor rax, rax;
        ret
      }
    }
}
