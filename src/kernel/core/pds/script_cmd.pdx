// src/kernel/core/pds/script_cmd.pdx -- UMB-W? R133.M6 (paideia-os #2625)
//
// `.pds` SCRIPT EXECUTION AS FUNCTOR APPLICATION.
//
// R133.M1 (Wave 113, paideia-os#2620) landed `_ctr_parse` and
// `_ctr_locate_section`, the `.pds` BINARY CONTAINER reader.  R133.M2
// (Wave 115, paideia-os#2621) landed `_pds_cdg_gate`, the capability-
// declaration LOAD-TIME gate.  R133.M3 (Wave 118, paideia-os#2622)
// landed `_ig_build_order`, the import-graph transitive traversal +
// cycle detector.  R133.M4 (Wave 119, paideia-os#2623) landed
// `_vg_check`, the `#requires-paideia OP SEMVER` version gate.
// R133.M5 (Wave 120, paideia-os#2624) landed `_pds_tcg_gate`, the
// pre-execution type-check pipeline gate + its weak-import adapter.
//
// R133.M6 (THIS FILE) is the FINAL stage of the pds load pipeline:
// once a container has passed caps-decl, import-graph, version-gate
// and typecheck gates, the loader turns the script into an IN-PROCESS
// FUNCTOR APPLICATION.  A synthesized `ScriptCmd` descriptor (16-byte
// stack-local shim) carrying the narrowed cap env, flags and script
// id is handed to a REGISTERED dispatcher symbol via `call rax`; on
// return we fingerprint `pds run ok script=<n> duration_us=<n>` and
// pack the status.  The dispatcher is a weak-imported satellite
// (registered at R131 pds-loader boot) using the same registration-
// slot model as R133.M5's `_tcg_check_fn`.
//
// =============================================================================
// SECTION 0  WHY THIS FILE EXISTS
// =============================================================================
//
// `pds run backup.pds` must become a FUNCTOR CALL whose arg env is
// the invoker's capability env NARROWED by the script's `#capability`
// list.  The script is not a privileged executable; it is a bundle
// of effects proposed by the author and ADMITTED by the preceding
// gates.  Dispatching it as "an in-process functor call to a
// synthesized ScriptCmd" (the acceptance phrase) means:
//
//   (A) CAP NARROWING NOT WIDENING.  The script's declared cap mask
//       is INTERSECTED with the invoker's: `narrowed = invoker & script`.
//       A `#capability` list wider than the invoker admits silently
//       drops the extras -- the author declared the superset they
//       wanted, the invoker vetoed what they weren't entitled to grant.
//       The ANDed mask is the authoritative env for every stage effect
//       within this script's lifetime.
//
//   (B) SYNTHESIZED FUNCTOR DESCRIPTOR.  No disk-resident functor
//       object is created.  The 16-byte `ScriptCmd` descriptor is
//       stack-allocated inside `_pds_sc_run`'s frame and lives only
//       for the duration of the dispatch call.  The dispatcher reads
//       the narrowed caps, flags and script id from the descriptor;
//       the body bytes come as a separate `(body_ptr, body_len)` pair.
//       The descriptor pointer MUST NOT be retained past the
//       dispatcher's return; a conforming satellite copies out the
//       fields it needs before any suspend / schedule / await.
//
//   (C) WEAK-IMPORT DISPATCHER.  The pdx dialect does not implement
//       linker-level weak imports (the paideia-as encoder emits
//       strict symbol references only).  Grep for `_fi_invoke_script`
//       in `src/kernel/core/shell/` on 2026-10-15 found no such
//       symbol: the in-process functor dispatcher that would handle
//       a synthesized ScriptCmd lives in the R131 pds-loader satellite
//       (future wave) and must register through a `.bss` slot the way
//       R133.M5's type-checker does.  The gate exposes a REGISTRATION
//       SLOT:
//
//           pub let mut _sc_dispatch_fn : u64 = uninit @align(8)
//
//       and a one-shot registration primitive:
//
//           _pds_sc_register_dispatcher(fn_ptr: u64) -> u64
//
//       Before registration, `_pds_sc_run` returns `SC_ERR_NO_DISPATCHER`;
//       after registration, every call dispatches through the slot via
//       `call rax`.  This mirrors the R133.M5 weak-import adapter
//       precedent byte-for-byte so a surrounding error-reporter can
//       switch on the low 16 bits without caring which gate failed.
//
//   (D) PURE PREDICATE AT THE SHIM LAYER.  `_pds_sc_run` validates
//       the body header, narrows the caps, assembles the descriptor,
//       calls the dispatcher, measures the elapsed TSC window, and
//       returns a packed u64.  No disk I/O, no allocation, no mutation
//       of any module-level state other than the fingerprint emits.
//
// =============================================================================
// SECTION 1  SCRIPT BODY BINARY LAYOUT  (M6-DEFINED)
// =============================================================================
//
// The CALLER (R131 pds-loader at M6+) assembles a 32-byte header +
// opaque payload (the compiled pipeline body produced by R133.M5's
// upstream parser) into a contiguous buffer:
//
//     +----------------------------------------------------------+
//     | ScriptBody header (SC_HEADER_SIZE = 32 bytes)            |
//     |   [ 0.. 4] magic         u32 = 0x50534352 ('PSCR')       |
//     |                             (LE: file bytes 'R','C','S','P') |
//     |   [ 4.. 8] script_id     u32  (<= 0xFFFF at M6 for the  |
//     |                             16-bit pack ceiling)          |
//     |   [ 8..16] script_caps   u64  the script's declared cap  |
//     |                             mask -- precomputed by the   |
//     |                             R131 pds-loader from the     |
//     |                             container's `#capability`    |
//     |                             directives at caps-decl time.|
//     |   [16..24] payload_len   u64  informational; the opaque  |
//     |                             pipeline body length         |
//     |   [24..32] reserved      [u8; 8]  zero at M6             |
//     +----------------------------------------------------------+
//     | opaque pipeline body bytes (dispatcher-defined)          |
//     +----------------------------------------------------------+
//
// Invariants enforced at shim time BEFORE the dispatcher is invoked:
//
//   (I1) body_ptr != 0 AND body_len >= SC_HEADER_SIZE (32).
//   (I2) header.magic == SC_MAGIC.
//   (I3) header.script_id <= SC_MAX_SCRIPT_ID (0xFFFF).
//
// A failure at any invariant surfaces as the corresponding SC_ERR_*
// code (SECTION 3) BEFORE the registered dispatcher is invoked -- the
// shim never hands a malformed stream to the satellite.
//
// `script_caps` is NOT validated here: it is a bitmap the pds-loader
// already derived from the `#capability` admissions in R133.M2.  Any
// bit the invoker does not grant is silently masked off by the AND
// below; the author's intent to widen past the invoker's env is a
// soft no-op, not a hard fault.
//
// =============================================================================
// SECTION 2  SCRIPTCMD DESCRIPTOR  (M6-DEFINED)
// =============================================================================
//
// The 16-byte stack-local shim handed to the dispatcher:
//
//     +----------------------------------------+
//     | ScriptCmd descriptor (16 bytes)        |
//     |   [ 0.. 8] narrowed_caps  u64          |
//     |   [ 8..12] flags          u32  (0 M6)  |
//     |   [12..16] script_id      u32          |
//     +----------------------------------------+
//
// `narrowed_caps` = `invoker_caps & script_caps` -- cap NARROWING
// (never widening) at the shim boundary.
//
// `flags` is reserved as a per-call shape bitfield (deadline enabled,
// quiet mode, trace mode, ...); M6 pins it at 0.  A future wave
// widens.
//
// `script_id` mirrors the header field verbatim (u32, bounded by I3).
//
// `deadline_us` and `invoker_tid`, listed as logical ScriptCmd fields
// in the brief, are NOT in the 16-byte shim at M6 -- the dispatcher
// is a weak satellite and the R131 pds-loader at M6 does not surface
// a deadline / invoker tid.  A future wave extends the descriptor
// (bumping SC_DESC_SIZE) and threads both fields; the current layout
// stays as the first 16 bytes of that extended struct for ABI
// stability.
//
// =============================================================================
// SECTION 3  RETURN CODES  (BAND 0x4100..0x41FF)
// =============================================================================
//
// _pds_sc_run returns a PACKED u64:
//
//   bits [15: 0]  = status                 SC_* code
//   bits [31:16]  = script_id              on SC_OK and
//                                           SC_ERR_SCRIPT_RUN_FAILED;
//                                           0 on every other return.
//   bits [63:32]  = duration_us            on SC_OK;
//                                           dispatcher_errno on
//                                           SC_ERR_SCRIPT_RUN_FAILED;
//                                           0 on every other return.
//
//   SC_OK                        = 0x0000     dispatcher returned 0.
//                                              Fingerprint:
//                                              `pds run ok
//                                                script=<id>
//                                                duration_us=<us>`.
//   SC_ERR_NO_DISPATCHER         = 0x4100     registration slot nil.
//                                              The satellite has not yet
//                                              published its dispatcher
//                                              fn.  Fingerprint:
//                                              `pds run no-dispatcher`.
//   SC_ERR_NULL_BODY             = 0x4101     body_ptr == 0 or
//                                              body_len < SC_HEADER_SIZE.
//                                              Fingerprint:
//                                              `pds run null-body`.
//   SC_ERR_BAD_HEADER            = 0x4102     magic mismatch at [0..4].
//                                              Fingerprint:
//                                              `pds run bad-header`.
//   SC_ERR_SCRIPT_RUN_FAILED     = 0x4103     dispatcher returned non-
//                                              zero errno.  Fingerprint:
//                                              `pds run failed
//                                                script=<id>
//                                                errno=<e>`.
//   SC_ERR_SCRIPT_ID_TOO_LARGE   = 0x4104     header.script_id > 0xFFFF
//                                              (M6 pack ceiling).
//                                              Fingerprint:
//                                              `pds run bad-script-id`.
//   SC_ERR_NULL_FN               = 0x4105     _pds_sc_register_dispatcher
//                                              rejected fn_ptr == 0.
//                                              Fingerprint:
//                                              `pds run null-fn`.
//
// The 0x4100..0x41FF band is new; grep audit on 2026-10-15:
//     `grep -rnE '\b0x41[0-9A-Fa-f]{2}\b' src/kernel/ design/`
// returned only `0x41ED` (S_IFDIR | 0o755) in
// `syscall/handlers/sys_pdxfs_stat_by_inode.pdx` -- a POSIX mode
// constant, not an error code, in a disjoint semantic namespace.
// Band free of collision for status codes (Wave 118 lesson applied).
//
// =============================================================================
// SECTION 4  REGISTER PLAN
// =============================================================================
//
// _pds_sc_run -- 5 callee-save pushes + sub rsp, 32:
//
//     push rbx     rbx = body_ptr                 (base of input)
//     push r12     r12 = body_len                 (byte count)
//     push r13     r13 = invoker_caps             (SysV arg 3; survives
//                                                  dispatch call)
//     push r14     r14 = script_id (u32 zero-ext) (survives dispatch
//                                                  call and klog emit)
//     push r15     r15 = scratch -- script_caps / start_tsc /
//                        duration_us bay (used across phases, each
//                        phase re-establishes before the next
//                        boundary)
//     sub  rsp, 32
//                  [rsp +  0] = narrowed_caps     (desc byte 0..7)
//                  [rsp +  8] = flags(u32 lo) |   (desc byte 8..15)
//                                script_id(u32 hi)
//                  [rsp + 16] = start_tsc         (saved across the
//                                                  dispatch CALL;
//                                                  r15 is caller-save
//                                                  w.r.t. the opaque
//                                                  dispatcher)
//                  [rsp + 24] = dispatcher_errno  (saved across the
//                                                  klog emit on the
//                                                  SCRIPT_RUN_FAILED
//                                                  path)
//
// Entry rsp%16==8; +5 pushes (40) + sub 32 = +72; (8+72)%16==0 at body.
//
//   * Pre-CALL to klog_s1:  body rsp%16==0, direct call.
//   * Pre-CALL to klog_s1_d2:  idiom `sub rsp, 8; push v2` (+16) lands
//                               rsp%16==0 at the CALL (SysV callee
//                               entry rsp%16==8).  Post-CALL `add rsp,
//                               16` reclaims pad + push.  Same proof
//                               as typecheck_gate.pdx:634-646.
//   * Pre-CALL to _sc_dispatch_fn via `call rax`:  body rsp%16==0,
//                               direct indirect call lands callee at
//                               rsp%16==8 per SysV, no pad needed.
//                               Mirrors typecheck_gate.pdx:613.
//
// Scratch (caller-save; may be clobbered by any nested CALL):
//     rax, rcx, rdx, rsi, rdi, r8, r9, r10, r11
//
// _pds_sc_register_dispatcher -- 2 callee-save pushes:
//
//     push rbx     rbx = fn_ptr
//     push r12     callee-save pad (keeps 2-push alignment)
//
// Entry rsp%16==8, +16 pushes = (8+16)%16==8; sub rsp, 8 for klog_s1
// alignment -> rsp%16==0 at CALL.  Post-CALL add rsp, 8.
//
// =============================================================================
// SECTION 5  TSC DURATION CONVERSION
// =============================================================================
//
// `rdtsc` captures a 64-bit cycle counter in rdx:rax.  Reconstruct
// via the canonical idiom (`shl rdx, 32; or rax, rdx`) -- same shape
// as `time/tsc.pdx:138-140` and `fs/pdxfs_lite/uuid.pdx:74-76`.
//
// Compute `duration_us = (end_tsc - start_tsc) * 10^6 / _tsc_hz`:
//
//     mov  rax, duration_tsc
//     mov  rcx, 1000000
//     imul rax, rcx                 (2-op reg,reg -- distinct from
//                                    the forbidden 2-op reg,imm form)
//     xor  rdx, rdx
//     mov  rcx, [rip + _tsc_hz]
//     cmp  rcx, 0
//     je   sc_du_zero
//     div  rcx                      (unsigned 128/64 -> 64)
//
// Overflow envelope: `duration_tsc * 10^6` fits in u64 for
// duration_tsc < 2^64 / 10^6 ~= 1.8e13 cycles ~= 6000 seconds at
// 3 GHz TSC -- plenty for any script run bounded by a human-scale
// deadline.  A future wave that threads a deadline_us into the
// descriptor will refuse any script whose declared deadline exceeds
// this envelope; for M6 the envelope is implicit.
//
// If `_tsc_hz` is zero (calibration has not run), duration_us is
// clamped to zero and the fingerprint reports `duration_us=0`.  This
// is a boot-order degradation path, not an error; the gate still
// returns SC_OK (dispatcher returned 0) and the surrounding tooling
// may notice the clamp separately via `_tsc_hz` inspection.
//
// =============================================================================
// SECTION 6  ENCODER DISCIPLINE  (feedback_pdx_encoder_pitfalls)
// =============================================================================
//
//   * `cmp rN, 0`              never `test rN, rN`.
//   * No `and rN, imm64`       the cap intersection uses `and r64, r64`
//                               (reg-reg); every mask literal is loaded
//                               into a register first.
//   * No 2-op `imul r, imm`    the TSC->us conversion uses `imul rax,
//                               rcx` (2-op reg,reg -- distinct form
//                               from the forbidden 2-op reg,imm).
//   * Single-line `pub let`    one line per literal (tags, status
//                               codes, registration slot).
//   * Module basename          `ScriptCmd` matches `script_cmd.pdx`.
//   * Labels prefixed          `sc_` (reserved-word discipline;
//                               distinct from `ctr_`, `pds_cdg_`,
//                               `ig_`, `vg_`, `tcg_` siblings).
//   * u32 loads                `xor rN, rN; mov eax, [reg+off]`
//                               (container_reader.pdx G4 precedent;
//                               typecheck_gate.pdx:519 echo).
//   * u64 loads                `mov rN, [reg+off]` (full-width).
//   * `cmp rN, imm32`          every status compare 0x4100..0x4105
//                               and SC_MAGIC (0x50534352) fit imm32
//                               sign-ext safe (bit 31 clear).
//   * Full-u64 status compares not low-byte masked (Wave 118 lesson).
//   * Fingerprint OK token     the OK tag uses LOWER-CASE "ok"
//                               (follows R133.M2..M5 precedent).  The
//                               verify-fingerprint-coverage.sh OK_TOK
//                               regex matches only uppercase `OK` as
//                               a word token, so this tag is NOT in
//                               the asserted-marker extractor's set --
//                               no allowlist entry is needed.
//   * rdtsc clobber discipline rdtsc writes rax + rdx.  Spill any
//                               survivor BEFORE and restore AFTER.
//                               Reconstruct via `shl rdx, 32; or rax,
//                               rdx` (uuid.pdx:74-76 precedent).
//   * Register liveness        r11 is clobbered by every nested CALL
//                               (Wave 116 lesson).  Every value that
//                               must survive a nested CALL lives in a
//                               callee-save (rbx, r12..r15) OR on the
//                               caller frame.  r15 is explicitly
//                               re-established at each phase boundary
//                               (script_caps -> start_tsc -> duration)
//                               and the spill mirrors live on the
//                               frame at [rsp+16] (start_tsc) and
//                               [rsp+24] (dispatcher_errno).
//
// =============================================================================
// SECTION 7  CROSS-MODULE WIRING NOTES
// =============================================================================
//
// Expected caller sequence (lands at R131 pds-loader post-M6):
//
//   (1) Caller reads `.pds` file bytes into a buffer.
//   (2) Caller invokes `_pds_cdg_gate(buf_ptr, buf_len, grant_env)`;
//       on non-zero, abort.
//   (3) Caller invokes `_vg_check(req_line_ptr, req_line_len)` on the
//       isolated `#requires-paideia` pragma; on non-zero, abort.
//   (4) Caller invokes `_ig_build_order` on the import adjacency; on
//       non-zero, abort.
//   (5) Caller parses the TEXT section into a PipelineBody record
//       stream, invokes `_pds_tcg_gate(body_ptr, body_len)`; on
//       non-zero, abort.
//   (6) Caller assembles the SCRIPT BODY (32-byte ScriptBody header
//       + opaque pipeline bytes; the cap_mask field is derived from
//       the `#capability` directives already admitted at step (2)),
//       then invokes:
//           packed = _pds_sc_run(script_body_ptr, script_body_len,
//                                invoker_caps)
//       On OK:        the script has run to completion with
//                     dispatcher return 0.  `_pds_sc_duration_us` and
//                     `_pds_sc_script_id` recover the two useful
//                     fields.
//       On SCRIPT_RUN_FAILED: dispatcher returned non-zero.
//                     `_pds_sc_errno` and `_pds_sc_script_id` recover
//                     the error pair.
//       On NO_DISPATCHER: the pds-loader satellite has not yet
//                     published its dispatcher.  Surface as
//                     `PdsErr::NoScriptDispatcher` and either refuse
//                     the run (strict posture) or admit to a
//                     dry-run-only mode (allow-partial posture;
//                     selected at M7+ by a kernel-boot flag).
//       On any other SC_ERR_*: surface as the specific reason.
//
// Satellite init sequence (lands at R131 pds-loader boot):
//
//   (1) Satellite's own init runs AFTER kernel .bss zero (so the
//       registration slot is nil at the time of registration).
//   (2) Satellite publishes:
//           status = _pds_sc_register_dispatcher(&_pds_sc_dispatch_impl)
//       On OK: the shim is now armed with the real dispatcher.
//       On SC_ERR_NULL_FN: fatal -- the satellite's fn-ptr is bogus.
//
// Design doc: design/kernel/pds-script-cmd.md (M6 wire shape, cap
// narrowing, descriptor shape, weak-import adapter, status band
// derivation, acceptance smoke).
//
// =============================================================================

module ScriptCmd = structure {

  // ==========================================================================
  // SECTION 8  CONSTANTS
  // ==========================================================================

  // Return codes (SECTION 3).
  pub let SC_OK                        : u64 = 0
  pub let SC_ERR_NO_DISPATCHER         : u64 = 0x4100
  pub let SC_ERR_NULL_BODY             : u64 = 0x4101
  pub let SC_ERR_BAD_HEADER            : u64 = 0x4102
  pub let SC_ERR_SCRIPT_RUN_FAILED     : u64 = 0x4103
  pub let SC_ERR_SCRIPT_ID_TOO_LARGE   : u64 = 0x4104
  pub let SC_ERR_NULL_FN               : u64 = 0x4105

  // ScriptBody geometry (SECTION 1).
  pub let SC_MAGIC             : u64 = 0x50534352   // 'PSCR' as little-endian u32
  pub let SC_HEADER_SIZE       : u64 = 32
  pub let SC_MAX_SCRIPT_ID     : u64 = 0xFFFF        // M6 pack ceiling (16-bit field)

  // Field offsets inside the ScriptBody header (SECTION 1).
  pub let SC_HDR_OFF_MAGIC     : u64 = 0
  pub let SC_HDR_OFF_SCRIPT_ID : u64 = 4
  pub let SC_HDR_OFF_CAP_MASK  : u64 = 8

  // ScriptCmd descriptor geometry (SECTION 2).
  pub let SC_DESC_SIZE         : u64 = 16
  pub let SC_DESC_OFF_CAPS     : u64 = 0
  pub let SC_DESC_OFF_FLAGS    : u64 = 8
  pub let SC_DESC_OFF_SCRIPT_ID : u64 = 12

  // Microsecond conversion constant (SECTION 5).
  pub let SC_US_PER_SEC        : u64 = 1000000

  // ==========================================================================
  // SECTION 9  REGISTRATION SLOT  (.bss; zero-init at boot via rep-stosq)
  // ==========================================================================
  //
  // Nil at kernel entry; the user-space pds-loader satellite's init
  // publishes the dispatcher here via `_pds_sc_register_dispatcher`.
  // See §0(C) for the weak-import rationale.
  pub let mut _sc_dispatch_fn : u64 = uninit @align(8)

  // ==========================================================================
  // SECTION 10  FINGERPRINT TAGS  (N = len(string) + 1, NUL inclusive)
  // ==========================================================================
  //
  //   "pds run ok"              10 + NUL -> N = 11
  //   "pds run failed"          14 + NUL -> N = 15
  //   "pds run no-dispatcher"   21 + NUL -> N = 22
  //   "pds run null-body"       17 + NUL -> N = 18
  //   "pds run bad-header"      18 + NUL -> N = 19
  //   "pds run bad-script-id"   21 + NUL -> N = 22
  //   "pds run null-fn"         15 + NUL -> N = 16
  //   "pds run registered"      18 + NUL -> N = 19
  //   "script"                   6 + NUL -> N =  7
  //   "duration_us"             11 + NUL -> N = 12
  //   "errno"                    5 + NUL -> N =  6
  //
  // Lower-case "ok" avoids the fingerprint-coverage extractor
  // (R133.M2..M5 precedent), so no allowlist row is needed.  A future
  // smoke may pin the strings as plain substring assertions in its
  // golden file.
  pub let sc_tag_ok              : [u8; 11] = "pds run ok\0"
  pub let sc_tag_failed          : [u8; 15] = "pds run failed\0"
  pub let sc_tag_no_dispatcher   : [u8; 22] = "pds run no-dispatcher\0"
  pub let sc_tag_null_body       : [u8; 18] = "pds run null-body\0"
  pub let sc_tag_bad_header      : [u8; 19] = "pds run bad-header\0"
  pub let sc_tag_bad_script_id   : [u8; 22] = "pds run bad-script-id\0"
  pub let sc_tag_null_fn         : [u8; 16] = "pds run null-fn\0"
  pub let sc_tag_registered      : [u8; 19] = "pds run registered\0"
  pub let sc_k_script            : [u8;  7] = "script\0"
  pub let sc_k_duration_us       : [u8; 12] = "duration_us\0"
  pub let sc_k_errno             : [u8;  6] = "errno\0"

  // ==========================================================================
  // SECTION 11  _pds_sc_register_dispatcher(fn_ptr) -> u64
  //
  // Publishes the user-space dispatcher's entry address into the
  // module-level slot.  See §0(C) for the weak-import rationale.
  //
  // Entry: rdi = fn_ptr
  // Return: rax = SC_OK on success, SC_ERR_NULL_FN (0x4105) on
  //              fn_ptr == 0.
  //
  // Side effects: writes `_sc_dispatch_fn`, emits one klog_s1
  // fingerprint (`pds run registered` on OK, `pds run null-fn` on nil).
  // ==========================================================================
  pub let _pds_sc_register_dispatcher : (u64) -> u64 !{mem, sysreg} @{} =
    fn (fn_ptr: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "UMB-W? R133.M6 (paideia-os #2625): publish the user-space pds script-dispatcher entry address into the module-level _sc_dispatch_fn registration slot. The slot models a `weak import` without the pdx dialect needing linker-level weak support: the satellite's own init (R131 pds-loader) calls this fn once, after kernel .bss zero but before the first .pds run, to arm the shim. nil fn_ptr is a contract violation -- returns SC_ERR_NULL_FN (0x4105) with no write. 2-push callee-save prologue (rbx=fn_ptr, r12 as pad): entry rsp%16==8, +16 = rsp%16==8, sub rsp,8 before klog_s1 -> rsp%16==0 at CALL, add rsp,8 after. Encoder: cmp rax,0 never test; status 0x4105 fits imm32 sign-ext safe. One klog_s1 per return path (LEVEL_INFO on OK, LEVEL_WARN on NULL_FN). Module basename ScriptCmd matches file basename script_cmd.pdx. Labels prefixed sc_rd_. Mirrors R133.M5 typecheck_gate.pdx:426-470 byte-for-byte modulo tag names and the slot symbol.",
      block: {
        push rbx;
        push r12;

        mov rbx, rdi;                     // fn_ptr

        // -------- Guard: nil fn_ptr -> NULL_FN.
        cmp rbx, 0;
        je  sc_rd_null;

        // -------- Publish the dispatcher into the slot.
        lea r10, [rip + _sc_dispatch_fn];
        mov [r10 + 0], rbx;

        // -------- Emit `pds run registered` fingerprint.
        sub rsp, 8;                       // alignment pad
        mov rdi, 3;                       // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + sc_tag_registered];
        call klog_s1;
        add rsp, 8;

        xor rax, rax;                     // SC_OK
        jmp sc_rd_out;

      sc_rd_null:
        sub rsp, 8;
        mov rdi, 2;                       // LEVEL_WARN
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + sc_tag_null_fn];
        call klog_s1;
        add rsp, 8;

        mov rax, 0x4105;                  // SC_ERR_NULL_FN

      sc_rd_out:
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION 12  _pds_sc_run(body_ptr, body_len, invoker_caps) -> packed u64
  //
  // The sole RUN-TIME entry point.  See §0 for role, §1 for the
  // ScriptBody wire shape, §2 for the descriptor, §3 for the return
  // pack, §4 for the register plan, §5 for the TSC conversion.
  //
  // Entry: rdi = body_ptr, rsi = body_len, rdx = invoker_caps
  // Return: rax = packed status (see §3)
  //
  // Side effects: reads `_sc_dispatch_fn`; calls through it; two
  // rdtsc samples bracket the dispatch; emits one klog_s1_d2
  // fingerprint on OK or SCRIPT_RUN_FAILED; emits one klog_s1
  // fingerprint on every other error path.  Does NOT mutate the
  // registration slot or any other module-level state.
  // ==========================================================================
  pub let _pds_sc_run : (u64, u64, u64) -> u64 !{mem, sysreg} @{} =
    fn (body_ptr: u64) (body_len: u64) (invoker_caps: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "UMB-W? R133.M6 (paideia-os #2625): .pds script execution as functor application. Receives a loaded + typechecked ScriptBody (32B header: magic 'PSCR' 0x50534352 + u32 script_id + u64 script_caps + u64 payload_len + 8B reserved) + an invoker_caps mask, computes narrowed_caps = invoker_caps & script_caps, assembles a 16B ScriptCmd descriptor (narrowed_caps u64 + flags u32 + script_id u32) on the stack frame, and dispatches via the weak-imported `_sc_dispatch_fn` slot by indirect `call rax`. Two rdtsc samples bracket the dispatch call; duration_us = (end_tsc - start_tsc) * 10^6 / _tsc_hz with a _tsc_hz==0 clamp to 0. Returns SC_OK (0) with script_id in [31:16] and duration_us in [63:32] on dispatcher return 0; SC_ERR_SCRIPT_RUN_FAILED (0x4103) with script_id in [31:16] and dispatcher_errno in [63:32] on dispatcher non-zero; or bare SC_ERR_* in {NO_DISPATCHER 0x4100 slot nil, NULL_BODY 0x4101 body_ptr==0 or body_len<32, BAD_HEADER 0x4102 magic mismatch, SCRIPT_ID_TOO_LARGE 0x4104 script_id>0xFFFF, NULL_FN 0x4105 reg_dispatcher nil (surfaces from the register primitive, not this fn)} on invariant failure. Register plan: 5 callee-save pushes (rbx=body_ptr, r12=body_len, r13=invoker_caps, r14=script_id, r15=scratch bay) + sub rsp,32 for [rsp+0]=narrowed_caps, [rsp+8]=desc byte 8..15 (flags|script_id<<32), [rsp+16]=start_tsc, [rsp+24]=dispatcher_errno; entry rsp%16==8, +40+32=72, (8+72)%16==0 at body — klog_s1_d2 pre-CALL idiom `sub rsp,8; push v2` lands rsp%16==0 at CALL (typecheck_gate.pdx:634 precedent); `call rax` for the dispatcher lands callee at rsp%16==8 per SysV with NO pad (body already rsp%16==0, matching typecheck_gate.pdx:613). rdtsc clobber discipline: rax/rdx trashed, every rdtsc preceded by any-survivor spill to [rsp+N] or callee-save; reconstruction via `shl rdx,32; or rax,rdx` (uuid.pdx:74-76 precedent). Encoder discipline: cmp rN,0 never test; `and r64,r64` for cap intersection (no imm64 and); `imul rax,rcx` for TSC->us (2-op reg,reg -- distinct from forbidden 2-op reg,imm); `div rcx` with pre-zeroed rdx for unsigned 128/64 (tsc.pdx:276-278 precedent); u16 load via `xor rax,rax; mov_w rax,[mem]`; u32 load via `xor rax,rax; mov eax,[mem]` (container_reader.pdx G4 precedent); magic 0x50534352 and all status codes 0x4100..0x4105 fit imm32 sign-ext safe (bit 31 clear). Fingerprint tags: 'pds run ok\\0' (11B) + 'script\\0' (7B) + 'duration_us\\0' (12B) via klog_s1_d2 on OK with v1=script_id v2=duration_us; 'pds run failed\\0' (15B) + 'script\\0' + 'errno\\0' (6B) via klog_s1_d2 on SCRIPT_RUN_FAILED with v1=script_id v2=errno; per-error klog_s1 tags for every bare SC_ERR_* path. Lower-case 'ok' intentionally bypasses verify-fingerprint-coverage.sh OK_TOK regex (R133.M2..M5 precedent) — no allowlist row required. Module basename ScriptCmd matches file basename script_cmd.pdx. Labels prefixed sc_ (reserved-word discipline; distinct from ctr_/pds_cdg_/ig_/vg_/tcg_ siblings).",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 32;

        mov rbx, rdi;                     // body_ptr
        mov r12, rsi;                     // body_len
        mov r13, rdx;                     // invoker_caps

        // Zero stack locals defensively.
        xor rax, rax;
        mov [rsp +  0], rax;              // narrowed_caps = 0
        mov [rsp +  8], rax;              // desc byte 8..15 = 0
        mov [rsp + 16], rax;              // start_tsc = 0
        mov [rsp + 24], rax;              // dispatcher_errno = 0

        // ------------------------------------------------------------------
        // (I1) body_ptr != 0 AND body_len >= SC_HEADER_SIZE (32).
        // ------------------------------------------------------------------
        cmp rbx, 0;
        je  sc_null_body;
        cmp r12, 32;
        jb  sc_null_body;

        // ------------------------------------------------------------------
        // (I2) Load magic (u32 @ 0, zero-ext) and compare SC_MAGIC.
        // ------------------------------------------------------------------
        xor rax, rax;
        mov eax, [rbx + 0];               // magic
        mov r10, 0x50534352;              // SC_MAGIC ('PSCR' LE)
        cmp rax, r10;
        jne sc_bad_header;

        // ------------------------------------------------------------------
        // Load script_id (u32 @ 4, zero-ext).
        // ------------------------------------------------------------------
        xor rax, rax;
        mov eax, [rbx + 4];               // script_id (u32)
        mov r14, rax;                     // r14 = script_id (callee-save)

        // ------------------------------------------------------------------
        // (I3) script_id <= SC_MAX_SCRIPT_ID (0xFFFF) -- M6 pack ceiling.
        // ------------------------------------------------------------------
        mov r10, 0xFFFF;
        cmp r14, r10;
        ja  sc_bad_script_id;

        // ------------------------------------------------------------------
        // Load script_caps (u64 @ 8) and compute narrowed_caps.
        // narrowed = invoker_caps & script_caps -- cap NARROWING at
        // the shim boundary (never widening).  Store into [rsp+0]
        // (descriptor byte 0..7).
        // ------------------------------------------------------------------
        mov r15, [rbx + 8];               // r15 = script_caps
        mov rax, r13;                     // invoker_caps
        and rax, r15;                     // narrowed = invoker & script
        mov [rsp + 0], rax;               // desc.narrowed_caps

        // ------------------------------------------------------------------
        // Pack descriptor byte 8..15: flags (u32 lo, 0 at M6) |
        // script_id (u32 hi).  shl + or is the single-instruction-per-
        // step idiom; no 2-op imul-imm.
        // ------------------------------------------------------------------
        mov rax, r14;                     // script_id
        shl rax, 32;                      // script_id << 32 (desc bit 12..15)
        xor r10, r10;                     // flags = 0 (desc bit 8..11)
        or  rax, r10;                     // flags | (script_id << 32)
        mov [rsp + 8], rax;               // desc.flags|script_id

        // ------------------------------------------------------------------
        // Load the registered dispatcher ptr.  nil -> NO_DISPATCHER.
        // ------------------------------------------------------------------
        lea r10, [rip + _sc_dispatch_fn];
        mov rax, [r10 + 0];
        cmp rax, 0;
        je  sc_no_dispatcher;

        // Stash dispatcher ptr in r15 across the rdtsc sampling (rdtsc
        // trashes rax + rdx; r15 is callee-save w.r.t. this function
        // and survives rdtsc unscathed).
        mov r15, rax;                     // r15 = _sc_dispatch_fn

        // ------------------------------------------------------------------
        // Phase 1: start_tsc = rdtsc, reconstruct 64-bit, save to
        // [rsp+16].
        // ------------------------------------------------------------------
        rdtsc;                            // edx:eax = tsc
        shl rdx, 32;
        or  rax, rdx;
        mov [rsp + 16], rax;              // start_tsc

        // ------------------------------------------------------------------
        // Phase 2: dispatch -- _sc_dispatch_fn(desc_ptr, body_ptr,
        //                                      body_len).
        //
        // SysV ABI: rdi=arg1, rsi=arg2, rdx=arg3.
        //   arg1 = desc_ptr   = rsp + 0 (BEFORE adjust)
        //   arg2 = body_ptr   = rbx
        //   arg3 = body_len   = r12
        //
        // `call rax` lands callee at rsp%16==8 per SysV with NO pad
        // (body rsp%16==0 by prologue math).  rax is caller-save and
        // already carries the dispatcher ptr from r15 on the next
        // store.
        // ------------------------------------------------------------------
        mov rdi, rsp;                     // desc_ptr (= rsp + 0)
        mov rsi, rbx;                     // body_ptr
        mov rdx, r12;                     // body_len
        mov rax, r15;                     // dispatcher ptr
        call rax;                         // SysV: rsp%16==0 at CALL

        // Stash dispatcher return in r15 across the next rdtsc
        // (callee-save: survives rdtsc).
        mov r15, rax;                     // r15 = dispatcher_errno

        // ------------------------------------------------------------------
        // Phase 3: end_tsc = rdtsc, reconstruct 64-bit; duration_tsc
        // = end_tsc - start_tsc.
        // ------------------------------------------------------------------
        rdtsc;                            // edx:eax = tsc
        shl rdx, 32;
        or  rax, rdx;
        sub rax, [rsp + 16];              // rax = duration_tsc

        // ------------------------------------------------------------------
        // Phase 4: duration_us = duration_tsc * 10^6 / _tsc_hz;
        // clamp to 0 on _tsc_hz == 0.
        //
        // Overflow envelope: duration_tsc * 10^6 fits u64 for
        //   duration_tsc < 2^64 / 10^6 ~= 1.8e13 cycles ~= 6000 s at
        //   3 GHz TSC.  See SECTION 5 for the deadline note.
        // ------------------------------------------------------------------
        mov rcx, 1000000;                 // 10^6 (SC_US_PER_SEC)
        imul rax, rcx;                    // rax = duration_tsc * 10^6
                                          // 2-op reg,reg: distinct from
                                          // the forbidden 2-op reg,imm.
        xor rdx, rdx;
        mov rcx, [rip + _tsc_hz];
        cmp rcx, 0;
        je  sc_du_zero;
        div rcx;                          // rax = duration_us
        jmp sc_du_done;
      sc_du_zero:
        xor rax, rax;                     // duration_us = 0 (clamp)
      sc_du_done:
        mov [rsp + 24], rax;              // stash duration_us for the klog

        // ------------------------------------------------------------------
        // Branch on dispatcher return: 0 -> OK path, non-zero ->
        // SCRIPT_RUN_FAILED.
        // ------------------------------------------------------------------
        cmp r15, 0;
        jne sc_script_failed;

        // ------------------------------------------------------------------
        // OK path: emit `pds run ok script=<id> duration_us=<us>`
        // fingerprint, pack (duration_us << 32) | (script_id << 16) |
        // SC_OK.
        //
        // klog_s1_d2 ABI (wrappers.pdx L261): rdi=level, rsi=subsys_ptr,
        //                                      rdx=tag_ptr, rcx=k1, r8=v1,
        //                                      r9=k2, [rsp+8 post-push]=v2.
        // Alignment idiom: body rsp%16==0; `sub rsp, 8; push v2` lands
        //                  rsp%16==0 at CALL (callee entry rsp%16==8 per
        //                  SysV).  Post-call `add rsp, 16`.
        // v1 = script_id (r14); v2 = duration_us ([rsp+24+16 post pad]).
        // ------------------------------------------------------------------
        sub rsp, 8;                       // alignment pad
        mov rax, [rsp + 32];          // reload duration_us (frame
                                          // shifted by sub rsp,8)
        push rax;                         // v2 (becomes [rsp+8] at CALL)

        mov  rdi, 3;                      // LEVEL_INFO
        lea  rsi, [rip + SUBSYS_CAP_];
        lea  rdx, [rip + sc_tag_ok];
        lea  rcx, [rip + sc_k_script];
        mov  r8,  r14;                    // v1 = script_id
        lea  r9,  [rip + sc_k_duration_us];
        call klog_s1_d2;

        add rsp, 16;                      // reclaim pad + push

        // Pack (duration_us << 32) | (script_id << 16) | SC_OK.
        mov rax, [rsp + 24];              // duration_us
        shl rax, 32;
        mov r11, r14;                     // script_id (survived callee-save)
        shl r11, 16;
        or  rax, r11;
        jmp sc_out;

      sc_script_failed:
        // ------------------------------------------------------------------
        // SCRIPT_RUN_FAILED path: `pds run failed script=<id>
        // errno=<e>`.  Dispatcher errno is in r15 (callee-save);
        // mirror it to [rsp+24] (overwrites the stashed duration_us
        // which we don't need on this path).  Pack:
        //   (dispatcher_errno << 32) | (script_id << 16) |
        //   SC_ERR_SCRIPT_RUN_FAILED.
        // ------------------------------------------------------------------
        mov [rsp + 24], r15;              // save dispatcher_errno

        sub rsp, 8;                       // alignment pad
        mov rax, [rsp + 32];          // reload dispatcher_errno
        push rax;                         // v2

        mov  rdi, 2;                      // LEVEL_WARN
        lea  rsi, [rip + SUBSYS_CAP_];
        lea  rdx, [rip + sc_tag_failed];
        lea  rcx, [rip + sc_k_script];
        mov  r8,  r14;                    // v1 = script_id
        lea  r9,  [rip + sc_k_errno];
        call klog_s1_d2;

        add rsp, 16;                      // reclaim pad + push

        // Pack the return.
        //   rax = dispatcher_errno << 32
        //   or   (script_id << 16)
        //   or   SC_ERR_SCRIPT_RUN_FAILED
        mov rax, [rsp + 24];              // reload dispatcher_errno
        shl rax, 32;
        mov r11, r14;                     // script_id
        shl r11, 16;
        or  rax, r11;
        mov r11, 0x4103;                  // SC_ERR_SCRIPT_RUN_FAILED
        or  rax, r11;
        jmp sc_out;

      sc_no_dispatcher:
        mov rdi, 2;                       // LEVEL_WARN
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + sc_tag_no_dispatcher];
        call klog_s1;
        mov rax, 0x4100;                  // SC_ERR_NO_DISPATCHER
        jmp sc_out;

      sc_bad_header:
        mov rdi, 2;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + sc_tag_bad_header];
        call klog_s1;
        mov rax, 0x4102;                  // SC_ERR_BAD_HEADER
        jmp sc_out;

      sc_bad_script_id:
        mov rdi, 2;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + sc_tag_bad_script_id];
        call klog_s1;
        mov rax, 0x4104;                  // SC_ERR_SCRIPT_ID_TOO_LARGE
        jmp sc_out;

      sc_null_body:
        mov rdi, 2;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + sc_tag_null_body];
        call klog_s1;
        mov rax, 0x4101;                  // SC_ERR_NULL_BODY

      sc_out:
        add rsp, 32;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION 13  _pds_sc_script_id(packed) -> u64
  //
  // Accessor: given a packed return value whose low 16 bits are either
  // SC_OK (0) or SC_ERR_SCRIPT_RUN_FAILED (0x4103), recover the
  // script_id stored in bits [31:16].  Returns 0 on any other input,
  // so callers can safely invoke it unconditionally in a log path.
  //
  // Pure leaf.  No stack use.
  // ==========================================================================
  pub let _pds_sc_script_id : (u64) -> u64 !{} @{} =
    fn (packed: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R133.M6 (paideia-os #2625): recover script_id from a packed SC_OK or SC_ERR_SCRIPT_RUN_FAILED return value. Masks the low 16 bits against 0xFFFF; on 0 (SC_OK) or 0x4103 (SCRIPT_RUN_FAILED) shifts right 16 and masks to 0xFFFF; else returns 0. Pure leaf — no stack use, no nested call. Encoder: `and rN, imm16` fits imm32 (0xFFFF, bit 31 clear); `shr rN, 16` is the standard short right-shift; cmp against 0 and 0x4103 is sign-ext safe (bit 31 clear).",
      block: {
        // low16 = packed & 0xFFFF
        mov rax, rdi;
        mov r10, 0xFFFF;
        and rax, r10;

        // Accept SC_OK (0) OR SC_ERR_SCRIPT_RUN_FAILED (0x4103).
        cmp rax, 0;
        je  sc_si_recover;
        mov r10, 0x4103;
        cmp rax, r10;
        jne sc_si_zero;

      sc_si_recover:
        // script_id = (packed >> 16) & 0xFFFF
        mov rax, rdi;
        shr rax, 16;
        mov r10, 0xFFFF;
        and rax, r10;
        ret

      sc_si_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // SECTION 14  _pds_sc_duration_us(packed) -> u64
  //
  // Accessor: given a packed SC_OK return value (low 16 bits == 0),
  // recover the duration_us count stored in bits [63:32].  Returns 0
  // on any non-OK input, so callers can safely invoke it in a log
  // path that names a success value AND an error.
  //
  // Pure leaf.  No stack use.
  // ==========================================================================
  pub let _pds_sc_duration_us : (u64) -> u64 !{} @{} =
    fn (packed: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R133.M6 (paideia-os #2625): recover duration_us from a packed SC_OK return value. Masks the low 16 bits; on zero shifts right 32; on non-zero returns 0 (not an OK pack). Pure leaf — no stack use, no nested call. Encoder: `and rN, imm16` fits imm32; cmp against 0 is the canonical zero-check; `shr rN, 32` is the standard long right-shift.",
      block: {
        mov rax, rdi;
        mov r10, 0xFFFF;
        and rax, r10;
        cmp rax, 0;
        jne sc_du_acc_zero;

        mov rax, rdi;
        shr rax, 32;
        ret

      sc_du_acc_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // SECTION 15  _pds_sc_errno(packed) -> u64
  //
  // Accessor: given a packed SC_ERR_SCRIPT_RUN_FAILED return value
  // (low 16 bits == 0x4103), recover the dispatcher's forwarded errno
  // stored in bits [63:32].  Returns 0 on any other input.
  //
  // Pure leaf.  No stack use.
  // ==========================================================================
  pub let _pds_sc_errno : (u64) -> u64 !{} @{} =
    fn (packed: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R133.M6 (paideia-os #2625): recover the dispatcher's forwarded errno from a packed SC_ERR_SCRIPT_RUN_FAILED return value. Masks the low 16 bits against 0xFFFF; on 0x4103 shifts right 32 bits; else returns 0. Pure leaf — no stack use, no nested call. Encoder: `and rN, imm16` fits imm32; `shr rN, 32` is the standard long right-shift; cmp against 0x4103 is sign-ext safe.",
      block: {
        mov rax, rdi;
        mov r10, 0xFFFF;
        and rax, r10;

        mov r10, 0x4103;
        cmp rax, r10;
        jne sc_er_zero;

        mov rax, rdi;
        shr rax, 32;
        ret

      sc_er_zero:
        xor rax, rax;
        ret
      }
    }
}
