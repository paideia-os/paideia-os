// src/kernel/core/pds/import_graph.pdx -- UMB-W? R133.M3 (paideia-os #2622)
//
// `.pds` TRANSITIVE #IMPORT GRAPH TRAVERSAL + CIRCULARITY DETECTION.
//
// R133.M1 (Wave 113, paideia-os#2620) landed the `.pds` binary container
// reader (`_ctr_parse` + `_ctr_locate_section`).  R133.M2 (Wave 115,
// paideia-os#2621) landed the capability-declaration LOAD-TIME gate
// (`_pds_cdg_gate`) that composes the container reader with the pds-lang
// cap-decl checker (R227.M2).  R133.M3 (THIS FILE) is the next read-only
// predicate in the pds load pipeline: once a `.pds` container has been
// admitted at the cap-decl gate, the loader may walk its `#import`
// references transitively, detect any cycles, and produce the
// DEPENDENCY-ORDERED module list the R131 pds-loader will use to
// dispatch TEXT bytes bottom-up.
//
// =============================================================================
// SECTION 0  WHY THIS FILE EXISTS
// =============================================================================
//
// A `.pds` source may declare `#import <module>` directives that
// reference other `.pds` sources on the local pdx-filesystem.  During
// load the loader must:
//
//   (1) walk the TRANSITIVE closure of #import so no module whose
//       bytes have not yet been dispatched is referenced from TEXT;
//   (2) refuse any input whose import graph is CYCLIC (per PDS-O2
//       discipline -- see design/terminal/pds-format.md §PDS-O2):
//       a cycle inside the module graph makes "dispatch dependencies
//       first" ill-defined, and R131's text-section loader cannot
//       close over a half-materialised module while its own body is
//       still unparsed;
//   (3) emit the modules in POST-ORDER (dependency-ordered -- a module
//       lands AFTER every module it imports) so the dispatcher can
//       simply iterate the array and never has to retry.
//
// R133.M3 performs (1)+(2)+(3) as a PURE PREDICATE on an in-memory
// adjacency table the caller has already built.  It does NOT read bytes
// from disk; it does NOT allocate; it does NOT mutate the cap-env or
// any session state.  The caller (R131 pds-loader at M3+) parses the
// `.pds` text / container, builds the import adjacency, and hands
// it here before any load-time side effect.  On OK the caller walks
// the returned post-order and feeds each module's TEXT bytes to the
// R131 dispatcher.  On ImportCycle the caller aborts the load.
//
// =============================================================================
// SECTION 1  ADJACENCY WIRE SHAPE (M3-DEFINED)
// =============================================================================
//
// The caller passes a FIXED-STRIDE adjacency table.  Each row describes
// one module's outgoing #import edges:
//
//     +----------------------------------------------------------+
//     | ImportAdjRow (IG_ADJ_STRIDE = 36 bytes)                  |
//     |   [ 0.. 4]  n_imports  u32   number of valid imports     |
//     |                              in this row (0..IG_MAX_IMPORTS=8) |
//     |   [ 4.. 8]  import[0]  u32   destination module index    |
//     |   [ 8..12]  import[1]  u32                                 |
//     |   ...                                                    |
//     |   [32..36]  import[7]  u32                                 |
//     +----------------------------------------------------------+
//
// The caller supplies `n_nodes` rows laid out contiguously as
// `ImportAdjRow[n_nodes]`.  Row i describes module i's imports;
// module indices are u32 ordinals in `[0, n_nodes)`.
//
// Invariants enforced at traversal time:
//
//   (I1) n_nodes <= IG_MAX_NODES (64)        -- bounds the scratch
//                                                color + stack arrays.
//   (I2) out_cap >= n_nodes * 4              -- caller buffer has room
//                                                for the post-order u32
//                                                stream.
//   (I3) per row i: n_imports <= IG_MAX_IMPORTS (8)
//                                            -- row fits in the fixed
//                                                stride.
//   (I4) per import j of row i: j < n_nodes  -- import ordinal is a
//                                                valid module index.
//
// A failure at any invariant surfaces as the corresponding IG_ERR_*
// code (SECTION 3).
//
// =============================================================================
// SECTION 2  TRAVERSAL ALGORITHM  (ITERATIVE DFS)
// =============================================================================
//
// Classic three-colour DFS with an explicit (not recursive) work
// stack, so the traversal has NO stack-depth bound beyond
// IG_MAX_NODES frames (64) and is immune to the kernel's bounded
// callstack discipline.
//
//   WHITE (0)  node not yet visited
//   GRAY  (1)  node currently on the DFS stack (in-progress)
//   BLACK (2)  node fully explored (all descendants done)
//
//   dfs_build_order():
//     for each i in 0..n_nodes:
//       if color[i] != WHITE: continue
//       push (i, next_child_idx = 0)
//       color[i] = GRAY
//       while stack non-empty:
//         let frame = stack.top
//         let row   = adj[frame.node]
//         if frame.next_child >= row.n_imports:
//           color[frame.node] = BLACK
//           out.append(frame.node)         // POST-ORDER emit
//           stack.pop
//           continue
//         let child = row.import[frame.next_child]
//         frame.next_child += 1
//         if child >= n_nodes:  return BAD_NODE
//         match color[child]:
//           GRAY  => return CYCLE(path_len = stack.depth)
//           BLACK => continue              // already fully processed
//           WHITE => push (child, 0); color[child] = GRAY
//
// Post-order emission guarantees the dependency-ordered property:
// a module M lands in the output AFTER every module M transitively
// imports (because M only turns BLACK -- and only then is appended --
// once every outgoing edge has been fully explored).
//
// Cycle detection: a GRAY-coloured child means we have encountered a
// node that is still on the current DFS path, i.e. a back-edge, i.e. a
// cycle.  The reported `path_len` is the stack depth at the moment of
// detection (`stk_bytes >> 4`), which is an UPPER BOUND on the length
// of the specific cycle (the actual cycle length is the distance from
// `child`'s stack frame to the top frame, inclusive; computing it
// precisely requires a stack-rewalk which is a legitimate M4
// elaboration -- see §Y of the design doc).  For the acceptance
// smoke the upper-bound suffices; the shape `PdsErr::ImportCycle(path=<n>)`
// is semantically "a cycle of at most n modules was observed", which
// is what the R131 pds-loader surfaces to the user.
//
// Scratch arrays live as module-level `mut` statics in .bss:
//
//     _ig_color : [u8;  64]     per-node colour, zeroed per invocation
//     _ig_stk   : [u64; 128]    DFS work stack; 64 frames * 2 u64
//                               (node_idx, next_child_idx)
//
// This substrate is single-threaded at M3: the kernel never dispatches
// two concurrent pds-load calls, and the import-graph primitive is a
// read-only predicate.  A later wave MAY lift the scratch arrays into
// the caller's buffer (parameterise `scratch_ptr`) if multi-concurrent
// loads become relevant -- the signature stays stable (new args append
// at the end).  See design/kernel/pds-import-graph.md §Y.
//
// =============================================================================
// SECTION 3  RETURN CODES  (BAND 0x3A00..0x3AFF)
// =============================================================================
//
// _ig_build_order returns a PACKED u64:
//
//   bits [15: 0]  = status                   IG_* code
//   bits [63:32]  = count   on IG_OK         n_modules emitted (= n_nodes
//                                            when the graph is acyclic
//                                            and reachable; in M3 the
//                                            graph MUST be reachable --
//                                            isolated subgraphs are
//                                            folded in by the outer-
//                                            loop that visits every
//                                            unvisited start)
//                   path_len on IG_ERR_CYCLE DFS stack depth at the
//                                            moment the GRAY-GRAY edge
//                                            was observed; an upper
//                                            bound on the specific
//                                            cycle length (§2).
//                   0        on all other errors
//
//   IG_OK                   = 0x0000     every reachable node emitted,
//                                        no cycle observed.
//   IG_ERR_CYCLE            = 0x3A00     back-edge from current node
//                                        to a GRAY ancestor.  The
//                                        upper-bound cycle length is
//                                        packed into bits [63:32].
//                                        R131 surfaces this as
//                                        `PdsErr::ImportCycle(path=<n>)`.
//   IG_ERR_TOO_MANY_NODES   = 0x3A01     n_nodes > IG_MAX_NODES (64).
//                                        At M3 the scratch arrays are
//                                        fixed-size; a later wave
//                                        lifts the ceiling via caller-
//                                        provided scratch.
//   IG_ERR_OUT_TOO_SMALL    = 0x3A02     out_cap < n_nodes * 4.
//                                        The caller buffer cannot
//                                        hold the full post-order.
//   IG_ERR_BAD_NODE         = 0x3A03     an import ordinal exceeds
//                                        n_nodes.  Caller contract
//                                        violation (adjacency row
//                                        references a module outside
//                                        the declared range).
//   IG_ERR_TOO_MANY_IMPORTS = 0x3A04     a row's n_imports > 8
//                                        (IG_MAX_IMPORTS).  Caller
//                                        contract violation.
//
// The 0x3A00 prefix carves a new PDS-subsystem error band disjoint
// from every landed packed-status range in the paideia-os tree:
//
//   0x2800..0x28FF  R227.M1 pds header pragmas          (user-space)
//   0x2900..0x29FF  R133.M1 pds container reader        (kernel)
//   0x2A00..0x2BFF  R222.M1/R223.M1 (user-space parser)
//   0x2E00..0x2FFF  R226 Datalog / R227 (user-space)
//   0x3000..0x300F  R229.M1 REPL loop                   (user-space)
//   0x3100..0x31FF  R227.M2 pds cap-decl checker        (kernel)
//   0x3200..0x32FF  R133.M2 pds cap-decl gate           (kernel)
//   0x3300..0x33FF  R222.M2 cmd-functor identity       (user-space)
//   0x3400..0x34FF  R223.M2 record projection           (user-space)
//   0x3500..0x35FF  R224.M2 ClosureCapture              (user-space)
//   0x3600..0x36FF  R225.M2 RowTypes                    (user-space)
//   0x3700..0x37FF  R229.M2 session-env                 (user-space)
//   0x3800..0x38FF  R221.M2 grapheme iter              (user-space)
//   0x3900..0x39FF  R222.M3 functor instance           (user-space)
//   0x3A00..0x3AFF  R133.M3 pds import graph  <-- THIS
//
// grep audit on 2026-10-14:
//   `grep -rnE '0x3A[0-9A-Fa-f]{2}\b' src/ design/` returns only
//   unrelated hits (0x3818 e1000e TDT MMIO offset in design/networking/
//   r91-plan.md); no live source uses this band for a status code.
//
// =============================================================================
// SECTION 4  ENCODER DISCIPLINE  (feedback_pdx_encoder_pitfalls)
// =============================================================================
//
//   * `cmp rN, 0`               never `test rN, rN` (R123.M2 discipline)
//   * `and rN, imm8/imm32`      OK (bit 31 clear, sign-ext safe); no
//                                `and rN, imm64` form used
//   * no 2-op `imul r, imm`     IG_ADJ_STRIDE=36 computed via
//                                `shl rN,5` + `shl rM,2` + `add rN,rM`
//                                (i*32 + i*4 = i*36)
//                               Stride 16 for DFS frames uses `shl rN, 4`
//                                (power-of-two).
//                               Stride 4 for u32 output / u32 import
//                                uses `shl rN, 2`.
//   * single-line `pub let`     one line per literal (ig_tag_*, ig_k_*)
//   * module basename           `ImportGraph` matches `import_graph.pdx`
//   * fingerprint tag sizes     N = len(string) + 1 (NUL counted)
//     - "pds import graph ok"   19 + NUL -> N = 20
//     - "pds import graph: cycle" 23 + NUL -> N = 24
//     - "modules"                7 + NUL -> N =  8
//     - "cycles"                 6 + NUL -> N =  7
//   * labels prefixed           `ig_` (reserved-word discipline;
//                                distinct from `ctr_`, `pds_cdg_`,
//                                `pds_cdc_` siblings)
//   * u32 zero-extend loads     `xor rax, rax; mov eax, [mem]` OR
//                                `xor rN, rN; mov_d rN, [mem]`
//                                (defensive against future encoder churn)
//   * byte loads                `xor rN, rN; mov_b rN, [mem]`
//                                (mov_b does not implicitly zero-extend)
//   * byte stores via index     `mov_b [reg + reg*1], rN`
//                                (proven in pipe_backend.pdx L276 /
//                                vnode_pool.pdx L324 / dir.pdx L181)
//   * u64 indexed access        `mov [reg + reg*8], rN` and the
//                                `mov rN, [reg + reg*8]` dual
//                                (proven in env_sharing.pdx L375/377/
//                                656/665)
//   * fingerprint OK token      the OK tag uses LOWER-CASE "ok"
//                                (follows R133.M2 ig precedent:
//                                 "pds.cdg: ok").  tools/verify-
//                                 fingerprint-coverage.sh's OK_TOK
//                                 regex matches only uppercase OK as a
//                                 word token, so this tag is NOT in the
//                                 asserted-marker extractor's set --
//                                 no allowlist entry is needed (same
//                                 posture as R133.M2's tags).  The
//                                 string's SEMANTIC role as the
//                                 success-fingerprint is unchanged;
//                                 any future smoke that pins it does
//                                 so as a plain substring match.
//
// =============================================================================
// SECTION 5  REGISTER PLAN
// =============================================================================
//
// _ig_build_order -- 5 callee-save pushes + sub rsp, 16:
//
//     push rbx     rbx = adj_ptr          (callee-save; survives nested
//                                           klog_s1_d2 call)
//     push r12     r12 = n_nodes          (callee-save)
//     push r13     r13 = out_ptr          (callee-save)
//     push r14     r14 = stk_bytes        (byte offset into _ig_stk;
//                                           0 = empty, +16 per push,
//                                           -16 per pop; max 1024)
//     push r15     r15 = write_cursor     (count of u32 words emitted
//                                           to out_ptr; also n_modules
//                                           in the OK packed return)
//     sub  rsp, 16
//                  [rsp +  0] = start_i   (outer-loop iterator; stored
//                                           on stack so the inner DFS
//                                           may clobber every scratch
//                                           register freely)
//                  [rsp +  8] = reserved  (alignment pad; future
//                                           elaboration slot)
//
// Entry rsp%16==8; +5 pushes +16 sub = +56; (8+56)%16==0 at body.
// Pre-CALL to klog_s1_d2: body rsp%16==0 -> `sub rsp, 8; push <v2>`
// = +16 -> rsp%16==0 at CALL (callee entry rsp%16==8 per SysV).
// Post-CALL: `add rsp, 16` restores body rsp%16==0.  Same idiom as
// panic_dump.pdx L215-227 and ioapic_route.pdx L337.
//
// Scratch (caller-save; may be clobbered by any nested CALL):
//     rax, rcx, rdx, rsi, rdi, r8, r9, r10, r11
//
// Inner-loop role:
//     rax = cur_i (current top-frame node)      -- live within one iter
//     rsi = next_child_idx                      -- live within one iter
//     r8  = row_base pointer                    -- live within one iter
//     r9  = lea-base scratch (_ig_color / _ig_stk) -- re-leaed per step
//     r10, r11, rcx, rdx = arithmetic scratch
//
// =============================================================================
// SECTION 6  CROSS-MODULE WIRING NOTES
// =============================================================================
//
// Expected caller sequence (lands at R131/R133.M4 pds-loader):
//
//   (1) Caller admits the top-level `.pds` container via R133.M2
//       (`_pds_cdg_gate`): on OK the capability declarations are
//       known-safe.
//   (2) Caller walks the TEXT section (or source form) and extracts
//       `#import <module>` ordinals, building a flat
//       `ImportAdjRow[n_nodes]` adjacency table.
//   (3) Caller invokes:
//           packed = _ig_build_order(adj_ptr, n_nodes, out_ptr, out_cap)
//       On OK:    low16==0, high32==n_modules; walk out_ptr[0..n_modules)
//                  as the dependency-ordered dispatch sequence.
//       On CYCLE: low16==0x3A00; high32==path_len upper bound.
//                  Surface as `PdsErr::ImportCycle(path=<n>)` and abort
//                  the load.
//       On other: surface as the specific IG_ERR_* reason.
//
// Design doc: design/kernel/pds-import-graph.md (M3 wire shape, the
// stack-depth-vs-cycle-length discussion, the lift-scratch-to-caller
// M4 plan, and the smoke matrix).
//
// =============================================================================

module ImportGraph = structure {

  // ==========================================================================
  // SECTION 7  CONSTANTS
  // ==========================================================================

  // Return codes (SECTION 3).
  pub let IG_OK                    : u64 = 0
  pub let IG_ERR_CYCLE             : u64 = 0x3A00
  pub let IG_ERR_TOO_MANY_NODES    : u64 = 0x3A01
  pub let IG_ERR_OUT_TOO_SMALL     : u64 = 0x3A02
  pub let IG_ERR_BAD_NODE          : u64 = 0x3A03
  pub let IG_ERR_TOO_MANY_IMPORTS  : u64 = 0x3A04

  // Adjacency wire geometry (SECTION 1).
  pub let IG_MAX_NODES    : u64 = 64
  pub let IG_MAX_IMPORTS  : u64 = 8
  pub let IG_ADJ_STRIDE   : u64 = 36          // 4 + 4 * 8

  // Colour palette (SECTION 2).
  pub let IG_WHITE : u64 = 0
  pub let IG_GRAY  : u64 = 1
  pub let IG_BLACK : u64 = 2

  // ==========================================================================
  // SECTION 8  SCRATCH BUFFERS  (.bss; zeroed per invocation head)
  // ==========================================================================
  //
  // Single-threaded at M3; see SECTION 2 for the rationale.  Scratch is
  // conservatively over-aligned to a cache line for the color table and
  // to the natural 8-byte line for the DFS stack.
  pub let mut _ig_color : [u8;  64]  = uninit @align(64)
  pub let mut _ig_stk   : [u64; 128] = uninit @align(64)

  // ==========================================================================
  // SECTION 9  FINGERPRINT TAGS  (N = len(string) + 1, NUL inclusive)
  // ==========================================================================
  //
  //   "pds import graph ok"       19 + NUL -> N = 20
  //   "pds import graph: cycle"   23 + NUL -> N = 24
  //   "modules"                    7 + NUL -> N =  8
  //   "cycles"                     6 + NUL -> N =  7
  //
  // Lower-case "ok" avoids the fingerprint-coverage extractor (same
  // posture as R133.M2's `pds.cdg:` family), so no allowlist row is
  // needed in tools/verify-fingerprint-coverage.sh.  A future smoke
  // may still pin the string as a plain substring assertion.
  pub let ig_tag_ok    : [u8; 20] = "pds import graph ok\0"
  pub let ig_tag_cycle : [u8; 24] = "pds import graph: cycle\0"
  pub let ig_k_modules : [u8;  8] = "modules\0"
  pub let ig_k_cycles  : [u8;  7] = "cycles\0"

  // ==========================================================================
  // SECTION 10  _ig_build_order(adj_ptr, n_nodes, out_ptr, out_cap)
  //                                                      -> packed u64
  //
  // The sole public entry point.  See §0 for role, §1 for the
  // adjacency wire shape, §2 for the DFS algorithm, §3 for return
  // packing, §5 for the register plan.
  //
  // Entry: rdi=adj_ptr, rsi=n_nodes, rdx=out_ptr, rcx=out_cap
  // Return: rax = (count << 32) | status
  //
  // Side effects: writes _ig_color[0..n_nodes), writes _ig_stk,
  // writes out_ptr[0..n_modules), emits one klog_s1_d2 fingerprint
  // on IG_OK and one klog_s1 fingerprint on IG_ERR_CYCLE.  All other
  // error paths return silently (caller-contract violations; the
  // calling R131 pds-loader surfaces them as its own PdsErr::* value).
  // ==========================================================================
  pub let _ig_build_order : (u64, u64, u64, u64) -> u64 !{mem, sysreg} @{} =
    fn (adj_ptr: u64) (n_nodes: u64) (out_ptr: u64) (out_cap: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "UMB-W? R133.M3 (paideia-os #2622): .pds import-graph transitive traversal + circularity detection + dependency-ordered module list. Consumes a caller-built ImportAdjRow[n_nodes] adjacency table (36-byte stride: u32 n_imports + 8 u32 imports) and emits the DFS post-order into a caller-supplied u32[] buffer. Classic three-colour iterative DFS with explicit work stack; GRAY-coloured child = back-edge = cycle; BLACK node appended to post-order on frame pop. Returns packed (n_modules << 32) | IG_OK on success, (path_len << 32) | IG_ERR_CYCLE (0x3A00) on cycle, or bare IG_ERR_* in {TOO_MANY_NODES 0x3A01, OUT_TOO_SMALL 0x3A02, BAD_NODE 0x3A03, TOO_MANY_IMPORTS 0x3A04} on invariant failure. Register plan: 5 callee-save pushes (rbx=adj_ptr, r12=n_nodes, r13=out_ptr, r14=stk_bytes, r15=write_cursor) + sub rsp,16 for stack-stored start_i (survives klog clobber of every caller-save reg). Entry rsp%16==8, +40+16 = 56, (8+56)%16==0 at body — klog_s1_d2 call site uses `sub rsp,8; push v2` to maintain the SysV pre-CALL rsp%16==0 invariant, same idiom as panic_dump.pdx L215-227. Scratch arrays _ig_color[64] + _ig_stk[128] live in .bss (@align 64); single-threaded at M3 (kernel never dispatches two concurrent pds-loads; a later wave may lift scratch into caller-provided buffer). Encoder discipline: cmp rN,0 never test; stride 36 computed as (shl r10,5)+(shl r11,2)+(add r10,r11) never 2-op imul-imm; stride 16 (DFS frame) via shl rN,4; stride 4 (u32) via shl rN,2; `and rN,imm` not needed; u32 zero-extend via `xor rax,rax; mov eax,[mem]` and `xor rN,rN; mov_d rN,[mem]`; byte loads via `xor rN,rN; mov_b rN,[mem]`; byte stores via `mov_b [reg+reg*1], rN` (proven in pipe_backend.pdx L276). Fingerprint tags: 'pds import graph ok\\0' (20B) + 'modules\\0' (8B) + 'cycles\\0' (7B) via klog_s1_d2 on OK; 'pds import graph: cycle\\0' (24B) via klog_s1 on cycle. Lower-case 'ok' intentionally bypasses the verify-fingerprint-coverage.sh OK_TOK regex (R133.M2 precedent) — no allowlist row required. Module basename ImportGraph matches file basename import_graph.pdx. Labels prefixed ig_ (reserved-word discipline, distinct from ctr_/pds_cdg_/pds_cdc_ siblings).",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 16;

        mov rbx, rdi;                     // adj_ptr
        mov r12, rsi;                     // n_nodes
        mov r13, rdx;                     // out_ptr

        xor rax, rax;
        mov [rsp + 0], rax;               // start_i = 0 (defensive zero)
        mov [rsp + 8], rax;               // reserved slot

        // ------------------------------------------------------------------
        // (I1) n_nodes <= IG_MAX_NODES (64).
        // ------------------------------------------------------------------
        cmp r12, 64;
        ja  ig_too_many_nodes;

        // ------------------------------------------------------------------
        // (I2) out_cap >= n_nodes * 4   (rcx carries out_cap).
        // ------------------------------------------------------------------
        mov r10, r12;
        shl r10, 2;                       // n_nodes * 4
        cmp rcx, r10;
        jb  ig_out_too_small;

        // ------------------------------------------------------------------
        // Zero _ig_color[0..n_nodes].  The .bss zero-init only runs once
        // at kernel boot, so a second invocation would inherit the
        // previous call's colour marks; defensive zero is cheap (bounded
        // by n_nodes <= 64).
        // ------------------------------------------------------------------
        lea r9, [rip + _ig_color];
        xor r10, r10;                     // i = 0
        xor rax, rax;                     // zero byte source

      ig_zero_loop:
        cmp r10, r12;
        jae ig_zero_done;
        mov_b [r9 + r10*1], rax;
        add r10, 1;
        jmp ig_zero_loop;

      ig_zero_done:
        xor r14, r14;                     // stk_bytes = 0 (DFS stack empty)
        xor r15, r15;                     // write_cursor = 0

        // ------------------------------------------------------------------
        // Outer loop: visit each unvisited node as a fresh DFS root.
        // start_i lives on the stack at [rsp+0] so the inner DFS loop
        // may freely clobber every caller-save register.
        // ------------------------------------------------------------------
        xor rax, rax;
        mov [rsp + 0], rax;               // start_i = 0

      ig_outer_loop:
        mov rcx, [rsp + 0];               // rcx = start_i
        cmp rcx, r12;
        jae ig_outer_done;

        // Is color[start_i] WHITE?
        lea r9, [rip + _ig_color];
        xor rax, rax;
        mov_b rax, [r9 + rcx*1];
        cmp rax, 0;                       // IG_WHITE
        jne ig_outer_next;

        // Mark start_i GRAY and push initial frame onto _ig_stk.
        mov r10, 1;                       // IG_GRAY
        mov_b [r9 + rcx*1], r10;

        lea r9, [rip + _ig_stk];
        mov [r9 + 0], rcx;                // frame[0].node = start_i
        xor rax, rax;
        mov [r9 + 8], rax;                // frame[0].next_child = 0
        mov r14, 16;                      // stk_bytes = 16 (one frame)

        // ------------------------------------------------------------------
        // Inner DFS loop.  Terminates when the stack is empty (back at
        // the outer-loop level) or on cycle / BAD_NODE return.
        // ------------------------------------------------------------------
      ig_dfs_loop:
        cmp r14, 0;
        je  ig_outer_next;

        // Load top frame: cur_i and next_child.
        lea r9, [rip + _ig_stk];
        mov r10, r14;
        sub r10, 16;                      // byte offset of top frame
        add r9, r10;                      // r9 = &top_frame
        mov rax, [r9 + 0];                // rax = cur_i
        mov rsi, [r9 + 8];                // rsi = next_child_idx

        // Compute row base: adj_ptr + cur_i * IG_ADJ_STRIDE (= 36).
        //   stride 36 = 32 + 4 = (cur_i << 5) + (cur_i << 2).
        mov r10, rax;
        shl r10, 5;                       // cur_i * 32
        mov r11, rax;
        shl r11, 2;                       // cur_i * 4
        add r10, r11;                     // cur_i * 36
        mov r8, rbx;
        add r8, r10;                      // r8 = row_base

        // Load n_imports (u32 @ row+0, zero-ext to u64).
        xor r11, r11;
        mov_d r11, [r8 + 0];              // r11 = n_imports

        // (I3) n_imports <= IG_MAX_IMPORTS (8).
        cmp r11, 8;
        ja  ig_too_many_imports;

        // If next_child >= n_imports: emit cur_i and pop.
        cmp rsi, r11;
        jae ig_frame_done;

        // Load child = import[next_child] (u32 @ row+4+rsi*4, zero-ext).
        mov r10, rsi;
        shl r10, 2;                       // next_child * 4
        add r10, 4;                       // + header offset
        mov r11, r8;
        add r11, r10;                     // r11 = &row.import[next_child]
        xor rdx, rdx;
        mov_d rdx, [r11 + 0];             // rdx = child

        // Advance the top frame's next_child iterator in place.
        //   next_child += 1.
        //   r9 still points to &top_frame.
        add rsi, 1;
        mov [r9 + 8], rsi;

        // (I4) child < n_nodes.
        cmp rdx, r12;
        jae ig_bad_node;

        // Inspect color[child].
        lea r9, [rip + _ig_color];
        xor rax, rax;
        mov_b rax, [r9 + rdx*1];

        // GRAY (1) -> cycle.
        cmp rax, 1;                       // IG_GRAY
        je  ig_cycle_detected;

        // BLACK (2) -> already processed, skip.
        cmp rax, 2;                       // IG_BLACK
        je  ig_dfs_loop;

        // WHITE (0) -> push child as a new frame, mark GRAY.
        mov r10, 1;                       // IG_GRAY
        mov_b [r9 + rdx*1], r10;

        lea r9, [rip + _ig_stk];
        mov r10, r14;                     // byte offset for the new frame
                                          // (next free slot).
        add r9, r10;                      // r9 = &new_frame
        mov [r9 + 0], rdx;                // new_frame.node = child
        xor rax, rax;
        mov [r9 + 8], rax;                // new_frame.next_child = 0
        add r14, 16;                      // stk_bytes += 16
        jmp ig_dfs_loop;

      ig_frame_done:
        // The current top frame is fully explored.  Mark its node
        // BLACK, append to post-order output, and pop.
        //   rax still holds cur_i from the top-of-loop load.
        lea r9, [rip + _ig_color];
        mov r10, 2;                       // IG_BLACK
        mov_b [r9 + rax*1], r10;

        // out_ptr[write_cursor] = cur_i   (u32 store).
        // Offset: r15 * 4.
        mov r10, r15;
        shl r10, 2;                       // write_cursor * 4
        mov r11, r13;
        add r11, r10;                     // &out_ptr[write_cursor]
        mov_d [r11 + 0], rax;             // u32 store of cur_i (low 32b)

        add r15, 1;                       // write_cursor += 1
        sub r14, 16;                      // stk_bytes -= 16 (pop)
        jmp ig_dfs_loop;

      ig_outer_next:
        mov rax, [rsp + 0];
        add rax, 1;
        mov [rsp + 0], rax;
        jmp ig_outer_loop;

      ig_outer_done:
        // ------------------------------------------------------------------
        // Success: every node reached, no cycle, post-order emitted.
        // Emit "pds import graph ok" modules=<r15> cycles=0 via
        // klog_s1_d2.  Then return (r15 << 32) | IG_OK.
        //
        // klog_s1_d2 ABI: rdi=level, rsi=subsys_ptr, rdx=tag_ptr,
        //                  rcx=k1, r8=v1, r9=k2, [rsp+8]=v2
        //                  (v2 pushed by caller before call).
        // Alignment idiom: `sub rsp,8; push v2` -> rsp%16==0 at CALL;
        //                  `add rsp,16` after.
        // ------------------------------------------------------------------
        sub rsp, 8;                       // alignment pad
        xor rax, rax;                     // v2 = cycles = 0 (no cycle on OK)
        push rax;                         // [rsp+8] post-call = v2

        mov  rdi, 3;                      // LEVEL_INFO
        lea  rsi, [rip + SUBSYS_CAP_];
        lea  rdx, [rip + ig_tag_ok];
        lea  rcx, [rip + ig_k_modules];
        mov  r8,  r15;                    // v1 = n_modules
        lea  r9,  [rip + ig_k_cycles];
        call klog_s1_d2;

        add rsp, 16;                      // pop push + pad

        // Pack (n_modules << 32) | IG_OK.
        mov rax, r15;
        shl rax, 32;
        jmp ig_out;

      ig_cycle_detected:
        // ------------------------------------------------------------------
        // Back-edge observed: current top frame's edge targets a GRAY
        // ancestor.  Report path_len = stk_bytes / 16 (DFS depth).
        // Emit one klog_s1 fingerprint and return.
        // ------------------------------------------------------------------
        mov rdi, 2;                       // LEVEL_WARN
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + ig_tag_cycle];
        call klog_s1;

        // path_len = r14 / 16 (= stk_bytes >> 4).
        mov rax, r14;
        shr rax, 4;                       // path_len
        shl rax, 32;                      // path_len << 32
        mov r10, 0x3A00;                  // IG_ERR_CYCLE
        or  rax, r10;
        jmp ig_out;

      ig_too_many_nodes:
        mov rax, 0x3A01;                  // IG_ERR_TOO_MANY_NODES
        jmp ig_out;

      ig_out_too_small:
        mov rax, 0x3A02;                  // IG_ERR_OUT_TOO_SMALL
        jmp ig_out;

      ig_bad_node:
        mov rax, 0x3A03;                  // IG_ERR_BAD_NODE
        jmp ig_out;

      ig_too_many_imports:
        mov rax, 0x3A04;                  // IG_ERR_TOO_MANY_IMPORTS

      ig_out:
        add rsp, 16;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION 11  _ig_cycle_path(packed) -> u64
  //
  // Accessor: given a packed return value whose low 16 bits are
  // IG_ERR_CYCLE (0x3A00), recover the path_len upper bound stored in
  // bits [63:32].  Returns 0 on any non-cycle input (including IG_OK),
  // so callers can safely invoke it unconditionally for logging.
  //
  // Pure leaf.  No stack use.
  // ==========================================================================
  pub let _ig_cycle_path : (u64) -> u64 !{} @{} =
    fn (packed: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R133.M3 (paideia-os #2622): recover the path_len upper bound from a packed IG_ERR_CYCLE return value. Masks the low 16 bits against 0x3A00 to confirm the cycle sentinel; on match shifts the high 32 bits down into rax; on non-match returns 0. Pure leaf — no stack use, no nested call. Encoder: `and rN, imm16` fits imm32 (0xFFFF, bit 31 clear); `shr rax, 32` is the standard long right-shift; cmp against 0x3A00 is sign-ext-safe (bit 31 clear).",
      block: {
        // low16 = packed & 0xFFFF
        mov rax, rdi;
        mov r10, 0xFFFF;
        and rax, r10;

        // if low16 != 0x3A00 -> return 0
        mov r10, 0x3A00;
        cmp rax, r10;
        jne ig_cp_zero;

        // path_len = packed >> 32
        mov rax, rdi;
        shr rax, 32;
        ret

      ig_cp_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // SECTION 12  _ig_build_order_count(packed) -> u64
  //
  // Accessor: given a packed IG_OK return value whose low 16 bits are
  // 0, recover the n_modules count stored in bits [63:32].  Returns 0
  // on any non-OK input, so callers can safely invoke it in logs that
  // name a success value AND an error.
  //
  // Pure leaf.  No stack use.
  // ==========================================================================
  pub let _ig_build_order_count : (u64) -> u64 !{} @{} =
    fn (packed: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R133.M3 (paideia-os #2622): recover n_modules from a packed IG_OK return value. Masks the low 16 bits; on zero shifts the high 32 bits down into rax; on non-zero returns 0 (not an OK pack). Pure leaf — no stack use, no nested call. Encoder: `and rN, imm16` fits imm32; cmp against 0 is the canonical zero-check.",
      block: {
        mov rax, rdi;
        mov r10, 0xFFFF;
        and rax, r10;
        cmp rax, 0;
        jne ig_bc_zero;

        mov rax, rdi;
        shr rax, 32;
        ret

      ig_bc_zero:
        xor rax, rax;
        ret
      }
    }
}
