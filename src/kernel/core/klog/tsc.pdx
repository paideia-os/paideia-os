// src/kernel/core/klog/tsc.pdx — M0-002 (#682) TSC and CPU ID helpers
// kread_tsc() and kread_cpu_id() — leaf helpers for logging substrate
// Issue: #682
// [unsafe] — system register reads only; no side effects
// Audit: design/kernel/kernel-logging-substrate.md §5.5
//
// Two pure leaf helpers for the M0 logging substrate, callable from anywhere.
// kread_tsc: reads rdtsc (EDX:EAX) and combines into RAX as single u64.
// kread_cpu_id: R18 pre-SMP returns 0; post-SMP reads [gs:_cpu_id] (via GS_BASE per #657).

module Tsc = structure {
  // kread_tsc() -> u64 !{sysreg} @{}
  // Returns TSC as u64 in RAX (EDX:EAX MSB-combined).
  // Preserves rbx, rbp, r12-r15 (SysV callee-save); clobbers rax, rcx, rdx, rsi, rdi, r8-r11.
  pub let kread_tsc : () -> u64 !{sysreg} @{} =
    fn () -> unsafe {
      effects: { sysreg },
      capabilities: {},
      justification: "Reads TSC via rdtsc instruction. EDX holds high 32 bits, EAX holds low 32 bits. Shift EDX left 32, OR into EAX to form single u64 in RAX. No branches or allocation. Preserves callee-save per SysV; clobbers rax, rdx.",
      block: {
        rdtsc;
        shl rdx, 32;
        or rax, rdx;
        ret;
      }
    }

  // kread_cpu_id() -> u64 !{sysreg, mem} @{}
  // R18 pre-SMP: returns 0. Post-SMP (R14.b-M5-008+, #657): reads [gs:_cpu_id].
  // Returns CPU ID as u64 in RAX.
  // Preserves rbx, rbp, r12-r15 (SysV callee-save); clobbers rax, rcx, rdx, rsi, rdi, r8-r11.
  pub let kread_cpu_id : () -> u64 !{sysreg, mem} @{} =
    fn () -> unsafe {
      effects: { sysreg, mem },
      capabilities: {},
      justification: "R18 pre-SMP stub: returns 0 (no per-CPU ID). Body upgraded to rdmsr/[gs:off] at SMP transition (PA-R14-001 close). Effect row marked {sysreg, mem} for SMP stability. No branches. Preserves callee-save per SysV; clobbers rax.",
      block: {
        xor rax, rax;
        ret;
      }
    }
}
