// src/kernel/core/klog/hex.pdx — M0-001 (#681) int→string conversion
// u64_to_hex(value, buf_ptr) and u64_to_dec(value, buf_ptr) — leaf helpers for logging substrate
// Issue: #681
// [unsafe] — writes to caller-supplied buffer only; no side effects beyond memory writes
// Audit: design/kernel/kernel-logging-substrate.md §5.4
//
// Two pure leaf helpers for the M0 logging substrate, callable from anywhere. Both write to
// a caller-supplied buffer with no allocation or branches beyond loop counter.
// u64_to_hex: writes exactly 18 bytes ("0x" + 16 hex nibbles, zero-padded, MSB-first).
// u64_to_dec: writes 1..20 bytes (unsigned decimal, no leading zeros).

module Hex = structure {
  // u64_to_hex(value: u64, buf: u64) -> u64 !{} @{}
  // Writes exactly 18 bytes: "0x" followed by 16 lowercase hex nibbles (MSB-first, zero-padded).
  // Returns buf_ptr + 18.
  // Caller must supply buffer ≥ 18 bytes; does not NUL-terminate (caller's responsibility).
  pub let u64_to_hex : (u64, u64) -> u64 !{} @{} =
    fn (value: u64) (buf: u64) -> unsafe {
      effects: {mem},
      capabilities: {},
      justification: "Writes caller-supplied buffer only via mov [mem], reg. Single-pass right-to-left: shift value left 4 bits per nibble, extract top 4 bits, compute hex ASCII char (0x30-0x39 for 0-9, 0x61-0x66 for a-f) via arithmetic, byte-store. Preserves rbx, rbp, r12-r15 (SysV callee-save); clobbers rax, rcx, rdx, rsi, rdi, r8-r11. No branches or loops beyond fixed 16-iteration encoding.",
      block: {
        mov r8, rsi;                                 // r8 = buf
        mov r9, rdi;                                 // r9 = value
        mov r10, 16;                                 // r10 = loop counter (16 nibbles)

        // Prefix: "0x"
        mov al, 0x30;                                // '0'
        mov [r8], al;
        mov al, 0x78;                                // 'x'
        mov [r8 + 1], al;

        hex_loop_top:
        // Extract top 4 bits via shift, compute nibble offset in buf
        mov rax, r9;
        shr rax, 60;                                 // top 4 bits in rax[3:0]
        and rax, 0xF;                                // mask to 4 bits

        // Convert nibble to ASCII: 0-9 → 0x30-0x39, 10-15 → 0x61-0x66
        // al = nibble value (0-15)
        cmp rax, 10;
        jb hex_digit_0_9;
        add rax, 0x57;                               // for 10-15: 10+0x57=0x61='a'
        jmp hex_digit_done;
        hex_digit_0_9:
        add rax, 0x30;                               // for 0-9: 0x30='0'
        hex_digit_done:

        // Compute position: 2 + (16 - counter)
        mov rdx, 16;
        sub rdx, r10;
        add rdx, 2;
        add rdx, r8;                                 // rdx = buf + position

        // Store byte at buf[position]
        mov [rdx], al;

        // Shift value left 4 bits for next iteration
        shl r9, 4;

        // Decrement counter, loop
        dec r10;
        cmp r10, 0;
        jne hex_loop_top;

        // Return buf + 18
        mov rax, r8;
        add rax, 18;
        ret;
      }
    }

  // u64_to_dec(value: u64, buf: u64) -> u64 !{} @{}
  // Writes 1..20 bytes: unsigned decimal representation (no leading zeros, no sign).
  // Returns buf_ptr + written_length.
  // Caller must supply buffer ≥ 20 bytes; does not NUL-terminate.
  pub let u64_to_dec : (u64, u64) -> u64 !{} @{} =
    fn (value: u64) (buf: u64) -> unsafe {
      effects: {mem},
      capabilities: {},
      justification: "Writes caller-supplied buffer via mov [mem], reg. Staging buffer on stack (20 bytes) holds result before copy back to caller buffer. Divide-by-10 loop: rax = value, rcx = 10 (divisor), xor rdx, rdx (zero extend), div rcx → rax = quotient, rdx = digit. Reverse pass copies staging→caller buffer. Digit-count scratch via rdx (caller-save, clobbered by div but reused after). Preserves rbx, rbp, r12, r13-r15 (SysV callee-save); clobbers rax, rcx, rdx, rsi, rdi, r8-r11. No branches beyond loop counter and zero-check.",
      block: {
        mov r8, rsi;                                 // r8 = caller buf
        mov r9, rdi;                                 // r9 = value
        sub rsp, 20;                                 // allocate 20-byte staging
        mov r10, rsp;                                // r10 = staging cursor (fill right-to-left)
        add r10, 19;                                 // r10 points to last byte

        // Handle zero special case
        cmp r9, 0;
        jne dec_divide_loop;

        // value == 0: write "0" and return 1
        mov al, 0x30;                                // '0'
        mov [r8], al;
        add rsp, 20;
        mov rax, r8;
        add rax, 1;
        ret;

        dec_divide_loop:
        // Divide r9 by 10: rax = r9, rcx = 10, xor rdx, rdx, div rcx
        mov rax, r9;
        mov rcx, 10;
        xor rdx, rdx;                                // zero extend rdx:rax
        div rcx;                                     // rax = quotient, rdx = remainder

        // Convert digit to ASCII and store
        add rdx, 0x30;                               // rdx += '0'
        mov [r10], dl;

        // Prepare next iteration
        mov r9, rax;                                 // r9 = quotient
        dec r10;                                     // move cursor left

        // Loop if quotient != 0
        cmp r9, 0;
        jne dec_divide_loop;

        // r10 now points to first digit. Copy to caller buffer.
        // Count digits: r11 = 19 - (r10 - rsp) = 20 - (r10 - rsp) - 1 = end - first
        // Actually: first digit at r10, last at [rsp+19]
        // so length = 20 - (r10 - rsp) = 20 + rsp - r10
        mov rax, rsp;
        add rax, 20;
        mov r11, r10;
        // r11 = first digit ptr, rax = end of staging
        mov rdx, rax;
        sub rdx, r11;                                // rdx = digit count (caller-save)

        // Copy loop: copy rdx bytes from r11 (first digit) to r8
        mov rcx, 0;
        dec_copy_loop:
        cmp rcx, rdx;
        jge dec_copy_done;
        mov rax, r11;
        add rax, rcx;
        mov al, [rax];                               // load from staging
        mov rax, r8;
        add rax, rcx;
        mov [rax], al;                               // store to caller buf
        inc rcx;
        jmp dec_copy_loop;

        dec_copy_done:
        add rsp, 20;
        mov rax, r8;
        add rax, rdx;                                // return buf + length
        ret;
      }
    }
}
