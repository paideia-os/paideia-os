// src/kernel/core/klog/panic_ipi.pdx — M4-003 (#694): multicore panic halt via IPI
//
// panic_ipi_halt_others() → () !{sysreg, mem} @{}
//   Broadcast NMI IPI to all secondary CPUs to halt them before ring drain.
//   On R14b: stub that returns immediately (no-op).
//   On R19+: broadcasts NMI via LAPIC ICR with all-excluding-self (10b),
//     delivery mode NMI (100b), edge trigger, level assert; polls ICR
//     delivery-status. See design/kernel/kernel-logging-substrate.md §9.1
//     step 4 for full fill-in recipe.

module PanicIpi = structure {
  pub let panic_ipi_halt_others : () -> () !{sysreg, mem} @{} =
    fn () -> unsafe {
    effects: { sysreg, mem },
    capabilities: { boot },
    justification: "M4-003 (#694): On R14b, this is a stub that returns immediately. Wire-up insertion in klog_panic (between klog_s1 and klog_ring_dump_panic) freezes secondary CPUs before ring drain, preventing them from scribbling the ring tail while the BSP drains. NMI delivery mode interrupts APs even if they execute cli. Broadcasting happens after klog_s1 ensures the panic tag reaches the wire before we go silent on 15 cores. See design/kernel/kernel-logging-substrate.md §9.1 step 4 for R19+ LAPIC ICR NMI broadcast recipe: destination shorthand 10b (all-excluding-self), delivery mode 100b (NMI), edge trigger, level assert, poll delivery-status.",
    block: {
      ret;
    }
  }
}
