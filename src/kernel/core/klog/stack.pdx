// src/kernel/core/klog/stack.pdx — M5-001 (#695) stack walker
// Issue: #695
// [unsafe] — memory R/O (rbp chain reads), sysreg I/O (uart via klog_s1_x2)
// Audit: design/kernel/kernel-logging-substrate.md §7 (stack walking)
//
// M5-001 stack walker: Walks a synthetic or real rbp chain and logs each frame
// via klog_s1_x2(PANIC, PANC, tag_frame, k_rip, saved_rip, k_rbp, current_rbp).
// Stops on: frame count exhausted, null rbp, misaligned rbp, or non-canonical rbp.
// This witness-only implementation does NOT integrate with klog_panic yet
// (paideia-as does not emit SysV frame prologues for regular functions — #696).

module Stack = structure {
  // ========================================================================
  // klog_walk_rbp(start_rbp: u64, max_frames: u64) -> () !{sysreg, mem} @{}
  //
  // Walk an rbp chain starting at start_rbp, logging up to max_frames frames.
  // Each frame is logged as: PANIC level, PANC subsys, tag_frame tag,
  // two hex KVs: k_rip=[rbp+8], k_rbp=rbp.
  //
  // Stops if: frames_remaining reaches 0, rbp is 0, misaligned, or not canonical.
  // Canonical boundary: must be >= 0xFFFF800000000000 (higher-half).
  //
  // Register discipline:
  //   r13 = current_rbp (callee-save, survives klog calls)
  //   r14 = frames_remaining (callee-save, survives klog calls)
  // Clobbers: rax, rcx, rdx, rsi, rdi, r8, r9, r10, r11 (SysV caller-save)
  // ========================================================================
  pub let klog_walk_rbp : (u64, u64) -> () !{sysreg, mem} @{} =
    fn (start_rbp: u64) (max_frames: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: {},
      justification: "M5-001 stack walker per #695 witness spec. Preserve rbp, r13, r14 on entry/exit (SysV callee-save). Loop: (1) test frames_remaining; (2) test rbp; (3) check alignment (rbp & 7); (4) check canonical (rbp >= 0xFFFF800000000000); (5) call klog_s1_x2(0, SUBSYS_PANC, tag_frame, k_rip, [rbp+8], k_rbp, rbp) with rbp pushed as 7th arg; (6) advance rbp to [rbp], decrement counter, loop. Byte-compare loops avoided per paideia-as#1270. Callee-save discipline: initial push saves rbp (SysV frame base), then r13/r14 (for loop state). All register load/store via mov (no sized mnemonics). uart_putc clobbers rax; callee-save regs survive. Stack alignment: 3 pushes = rsp ≡ 8 (mod 16); klog_s1_x2 push v2 = rsp ≡ 0 (mod 16) before call (matches pattern in core/int/dump.pdx). Audit: design/kernel/kernel-logging-substrate.md §7.",
      block: {
        push rbp;
        push r13;
        push r14;

        mov r13, rdi;                      // r13 = current_rbp (start_rbp)
        mov r14, rsi;                      // r14 = frames_remaining (max_frames)

        walk_top:
        cmp r14, 0;
        je walk_done;

        cmp r13, 0;
        je walk_done;                      // null rbp → stop

        mov rax, r13;
        and rax, 7;
        cmp rax, 0;
        jne walk_done;                     // misaligned (not 8-byte aligned) → stop

        mov rax, 0xFFFF800000000000;
        cmp r13, rax;
        jb walk_done;                      // not higher-half canonical → stop

        // Call klog_s1_x2(LEVEL_PANIC, SUBSYS_PANC, tag_frame, k_rip, [r13+8], k_rbp, r13)
        // Push r13 (v2, the 7th argument) onto stack before call
        push r13;

        mov rdi, 0;                        // rdi = LEVEL_PANIC = 0
        lea rsi, [rip + SUBSYS_PANC];      // rsi = SUBSYS_PANC
        lea rdx, [rip + tag_frame];        // rdx = tag_frame
        lea rcx, [rip + k_rip];            // rcx = k_rip (k1)
        mov r8, [r13 + 8];                 // r8 = [rbp+8] saved rip (v1)
        lea r9, [rip + k_rbp];             // r9 = k_rbp (k2)
        // v2 (current_rbp) is on stack; klog_s1_x2 will read it from [rsp+8]

        call klog_s1_x2;

        add rsp, 8;                        // pop v2

        mov r13, [r13];                    // r13 = [rbp] → advance to saved prev_rbp
        dec r14;                           // frames_remaining--
        jmp walk_top;

        walk_done:
        pop r14;
        pop r13;
        pop rbp;
        ret;
      }
    } @no_frame
}
