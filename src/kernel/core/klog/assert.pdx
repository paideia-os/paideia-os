// src/kernel/core/klog/assert.pdx — M6-001 (#696): kassert_fail halting witness
//
// kassert_fail(subsys, file_id, line, expected, actual) → () !{sysreg, mem} @{}   ; noreturn
//   Atomic kernel assertion failure: logs expected vs. actual, file+line context,
//   emits panic-level event stream, and halts via klog_panic. No return.
//
// Signature: kassert_fail : (u64, u64, u64, u64, u64) -> () !{sysreg, mem} @{}
//            (subsys_ptr, file_id, line, expected, actual)
//
// Call discipline (SysV ABI):
//   rdi = subsys_ptr (arg 1, callee receives directly)
//   rsi = file_id (arg 2)
//   rdx = line (arg 3)
//   rcx = expected (arg 4)
//   r8 = actual (arg 5)
//
// Emits:
//   1. klog_s1_x2(PANIC, subsys, tag_assert, k_exp, expected, k_got, actual)
//   2. klog_s1_x1_d1(PANIC, subsys, tag_at, k_file, file_id, k_line, line)
//   3. klog_panic(subsys, tag_assertion_failed)
//
// This witness-only implementation in Phase A lands as dormant symbol:
//   lea rax, [rip + kassert_fail]; xor rax, rax  (in kernel_main.pdx)
// Phase B (M8's boot_panic_smoke) will invoke real assertion with canary values.
// No live caller paths active; real assertion firewall at #696 Phase A finish line.
//
// Audit: design/kernel/kernel-logging-substrate.md §11.1
//        paideia-os#696 (two-phase witness plan)

module Assert = structure {
  pub let kassert_fail : (u64, u64, u64, u64, u64) -> () !{sysreg, mem} @{} =
    fn (subsys_ptr: u64) (file_id: u64) (line: u64) (expected: u64) (actual: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: { boot },
      justification: "M6-001 (#696) Phase A: dormant kassert_fail symbol. Saves all 5 args in callee-save regs (r12-r15) and stack; keeps subsys (rdi), file_id (rsi), line (rdx) live. Step 1: klog_s1_x2(LEVEL_PANIC, subsys, tag_assert, k_exp, expected, k_got, actual) with actual pushed as 7th arg. Step 2: klog_s1_x1_d1(LEVEL_PANIC, subsys, tag_at, k_file, file_id, k_line, line) with line pushed as 7th arg. Step 3: klog_panic(subsys, tag_assertion_failed) — noreturn via existing #692 path (cli + klog_s1 + dump + isa-debug-exit). Stack alignment: 4 pushes (r12-r15) = rsp ≡ 0 (mod 16); each klog call's push before its next push inside klog_s1_x2/x1_d1 restores alignment. Noreturn: halt via klog_panic; frame preserved for debuggability.",
      block: {
        // Save all 5 args in callee-save regs for recovery across klog calls
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                              // r12 = subsys_ptr (arg 1)
        mov r13, rsi;                              // r13 = file_id (arg 2)
        mov r14, rdx;                              // r14 = line (arg 3)
        mov r15, rcx;                              // r15 = expected (arg 4)
        // actual (arg 5) is already in r8 (caller-save, will need to push before each call)

        // ====================================================================
        // Step 1: klog_s1_x2(LEVEL_PANIC, subsys, tag_assert, k_exp, expected, k_got, actual)
        // ====================================================================
        // Args setup:
        //   rdi = LEVEL_PANIC (0)
        //   rsi = subsys_ptr (from r12)
        //   rdx = tag_assert
        //   rcx = k_exp (k1)
        //   r8 = expected (v1, from r15)
        //   r9 = k_got (k2)
        //   [rsp+8] = actual (v2, from caller arg 5 in r8)
        //
        // Push actual (7th arg) onto stack before call
        push r8;

        mov rdi, 0;                                // rdi = LEVEL_PANIC
        mov rsi, r12;                              // rsi = subsys_ptr
        lea rdx, [rip + tag_assert];               // rdx = tag_assert
        lea rcx, [rip + k_exp];                    // rcx = k_exp (k1)
        mov r8, r15;                               // r8 = expected (v1)
        lea r9, [rip + k_got];                     // r9 = k_got (k2)
        // actual is on stack at [rsp+8]

        call klog_s1_x2;
        add rsp, 8;                                // pop actual

        // ====================================================================
        // Step 2: klog_s1_x1_d1(LEVEL_PANIC, subsys, tag_at, k_file, file_id, k_line, line)
        // ====================================================================
        // Args setup:
        //   rdi = LEVEL_PANIC (0)
        //   rsi = subsys_ptr (from r12)
        //   rdx = tag_at
        //   rcx = k_file (kx)
        //   r8 = file_id (vx, from r13)
        //   r9 = k_line (kd)
        //   [rsp+8] = line (vd, from r14)
        //
        // Push line (7th arg) onto stack before call
        push r14;

        mov rdi, 0;                                // rdi = LEVEL_PANIC
        mov rsi, r12;                              // rsi = subsys_ptr
        lea rdx, [rip + tag_at];                   // rdx = tag_at
        lea rcx, [rip + k_file];                   // rcx = k_file (kx)
        mov r8, r13;                               // r8 = file_id (vx)
        lea r9, [rip + k_line];                    // r9 = k_line (kd)
        // line is on stack at [rsp+8]

        call klog_s1_x1_d1;
        add rsp, 8;                                // pop line

        // ====================================================================
        // Step 3: klog_panic(subsys, tag_assertion_failed)
        // ====================================================================
        // Args: rdi = subsys_ptr, rsi = tag_assertion_failed
        mov rdi, r12;                              // rdi = subsys_ptr
        lea rsi, [rip + tag_assertion_failed];    // rsi = tag_assertion_failed
        call klog_panic;

        // UNREACHABLE — klog_panic is noreturn (cli+hlt loop)
        // But to silence warnings, add a sentinel that won't be reached
        ud2;

        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret;
      }
    }
}
