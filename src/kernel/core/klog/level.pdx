// src/kernel/core/klog/level.pdx — M1-001 (#683) Logging level constants and helpers
// Level definition module: constants, runtime level tracking, and level→letter converter
// Issue: #683
// [unsafe] — lookup table only; no side effects beyond u64-read from rodata
// Audit: design/kernel/kernel-logging-substrate.md §5.1
//
// M1-001 logging levels module. Defines level constants (PANIC through TRACE, 0-5),
// compile-time and runtime level thresholds, and a u64-stride table lookup for
// converting level codes to single-character letters ('P','E','W','I','D','T').
// Avoids byte-load hazard (paideia-as#1270) by storing letters as u64-stride values.

module Level = structure {
  // ============================================================================
  // Log level constants (compile-time and module-scope exports)
  // ============================================================================

  // Numeric code for each log level (0-5). Used in level gates and table indexing.
  pub let LEVEL_PANIC  : u64 = 0
  pub let LEVEL_ERROR  : u64 = 1
  pub let LEVEL_WARN   : u64 = 2
  pub let LEVEL_INFO   : u64 = 3
  pub let LEVEL_DEBUG  : u64 = 4
  pub let LEVEL_TRACE  : u64 = 5

  // Compile-time level gate: only levels 0..3 (PANIC through INFO) are emitted.
  // Mutable at module scope so future stages can override for selective debug builds.
  pub let KLOG_COMPILE_LEVEL : u64 = 3

  // ============================================================================
  // Runtime state: writable data section (§5.3 emit.pdx filter check)
  // ============================================================================

  // Runtime level threshold. Defaults to INFO (3) for production; can be mutated
  // by callers or repl to enable DEBUG (4) or TRACE (5) in boot or post-init.
  // Storage: .data section, 8-byte aligned, symbol _klog_runtime_level.
  // Direct read via mov rax, [rip + _klog_runtime_level] (no getter wrapper at M1).
  pub let mut _klog_runtime_level : u64 = 3

  // ============================================================================
  // Rodata: level→letter lookup table (u64-stride to avoid byte-load hazard)
  // ============================================================================

  // Letter codes for levels 0-5: 'P'(0x50), 'E'(0x45), 'W'(0x57), 'I'(0x49),
  // 'D'(0x44), 'T'(0x54). Stored as u64 values at 8-byte stride to allow single
  // u64 load (avoiding paideia-as#1270 byte-load compare hazard).
  // Precondition: level in [0..5]; OOB indices read adjacent rodata (acceptable).
  let LEVEL_LETTERS : [u64; 6] = [0x50, 0x45, 0x57, 0x49, 0x44, 0x54]

  // ============================================================================
  // Primitive: level→letter converter
  // ============================================================================

  // klog_level_letter(level: u64) -> u64 !{} @{}
  // Converts a numeric level code (0-5) to a single-character letter code.
  // Returns: u64 containing the letter ('P', 'E', 'W', 'I', 'D', 'T') in rax.
  // Clobbers: rax, rdi (SysV caller-save). Preserves: rbx, rbp, r12-r15.
  // Branches: none. No nested calls → no uart_puts-between-load hazard.
  pub let klog_level_letter : (u64) -> u64 !{} @{} =
    fn (level: u64) -> unsafe {
      effects: {mem},
      capabilities: {},
      justification: "u64-stride table lookup from rodata. No byte-load, no compare on loaded value (dodges paideia-as#1270). No branches. Precondition: level in [0..5]; OOB reads adjacent rodata — acceptable, all call sites pass compile-time LEVEL_* constants. LEA loads table base, SHL scales index by 8 (u64 stride), ADD computes offset, MOV loads u64 from table.",
      block: {
        lea rax, [rip + LEVEL_LETTERS];
        shl rdi, 3;
        add rax, rdi;
        mov rax, [rax];
        ret;
      }
    }
}
