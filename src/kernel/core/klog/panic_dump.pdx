// src/kernel/core/klog/panic_dump.pdx — R111.M4-016 (#2368)
//
// Byte-slice panic entry point that mirrors the panic message across
// every substrate that this boot has brought up, then halts.  Sits
// alongside the existing (subsys, tag) klog_panic path — it does not
// replace it.  Callers with a raw message buffer + length reach it
// through PanicDump.panic; callers with a tag pointer keep reaching the
// legacy klog_panic contract unchanged.
//
// Round: R111.M4 — T14 G4 boot wave, M4-016
// Roadmap: design/roadmap/r111-t14-boot-wave.md (task #2368)
// Encoder floor: paideia-as v0.36+.
//
// -----------------------------------------------------------------------------
// Contract
// -----------------------------------------------------------------------------
//
// panic(msg_ptr, msg_len) is NORETURN.  Sequence:
//
//   (a) Serial klog — walk msg[0..msg_len) with uart_putc.  This runs
//       before every other substrate because a bare COM1 wire is the
//       only substrate every boot path has always brought up (per the
//       R1.5 uart_init landing) — a fault in any later substrate still
//       leaves the message on the wire the operator's serial capture is
//       already recording.
//
//   (b) GOP framebuffer mirror — if _gop_fb_console_active == 1, hand
//       the byte-slice to gop_fb_console_puts.  Under -kernel PVH the
//       gate is 0 and this is a load+compare early-out.  Under UEFI +
//       GOP + LFB-map-succeeded (M4-015 handoff) the puts() call now
//       drives the M4-016 fill-red blit stub, so a photograph of the
//       T14 G4 panel captures the panic that a headless-serial capture
//       would miss (design/hardware/quirks.md §2.5 "no-UART fallback").
//
//   (c) Fingerprint — klog_s1_d2 emits
//         "panic PANIC DUMP fb=<0|1> msg_len=<n>"
//       so a smoke-mode capture proves both arms fired (fb=1 on UEFI,
//       fb=0 on PVH) and pins the byte count the caller handed in.  The
//       tag body deliberately carries no "OK" token so verify-
//       fingerprint-coverage.sh's OK_TOK regex skips it — this is an
//       event, not a bring-up marker.
//
//   (d) Halt — cli; hlt; jmp $-2.  The label is `panic_dump_halt_spin`.
//       No isa-debug-exit here: this is the physical-panel-visible
//       panic entry, and prematurely handing QEMU an exit code (as
//       legacy klog_panic does via port 0xf4 for the QEMU smoke matrix)
//       would race the operator's photograph.  Callers that want the
//       QEMU-exit behaviour take the legacy klog_panic path.
//
// -----------------------------------------------------------------------------
// Legacy klog_panic co-existence
// -----------------------------------------------------------------------------
//
// The existing klog_panic(subsys_ptr, tag_ptr) at core/klog/panic.pdx
// stays live and byte-for-byte unchanged.  Its callers (exception halt
// in core/int/exceptions.pdx, boot/kernel_main.pdx bailouts, kassert
// path in klog/assert.pdx, and a handful of syscall dispatch bailouts)
// all pass tag POINTERS keyed by SUBSYS; migrating each to the
// (msg_ptr, msg_len) shape is a separate landing (planned as
// R111.M4-018 "unify panic entries").  Until then, the two entries
// share nothing: no jump from klog_panic to PanicDump.panic, no shared
// halt loop, no shared banner.  This module owns exactly its own
// three-substrate mirror + halt.
//
// -----------------------------------------------------------------------------
// Fault-handler wire-up (task item 1)
// -----------------------------------------------------------------------------
//
// The panic path already exists as klog_panic; the double-fault (#DF
// vec 8) and general-protection (#GP vec 13) trampolines in core/int/
// idt.pdx already route through _typed_handler_8 / _typed_handler_13
// -> exc_handle -> klog_panic (see core/int/exceptions.pdx L90-97 for
// the terminal klog_panic call).  Wiring those handlers to the new
// PanicDump.panic entry instead would require reshaping the trap-frame
// -> message projection they perform today; that reshape is the same
// scope as the M4-018 unification above.  The M4-016 landing therefore
// installs the callable entry + the FB-visible substrate without
// touching the trampolines, so the panic path from every existing
// klog_panic caller keeps working byte-for-byte AND a new caller with a
// byte-slice can reach the FB-visible arm today.
//
// -----------------------------------------------------------------------------
// Encoder-pitfall discipline (feedback_pdx_encoder_pitfalls)
// -----------------------------------------------------------------------------
//
//   * No `test rN, rN` — use `cmp rN, 0` (jz/jnz on the flag).
//   * No 2-op `imul r, imm` — use `mov r, imm; imul r, r`.
//   * No `and reg, imm64` — mask via `mov rax, imm64; and rN, rax`.
//   * No `cmp reg, [mem]` — load into a register first.
//   * Byte-load-zero pattern: `xor rax, rax; mov_b rax, [mem]`.
//
// Reserved label prefix: `panic_dump_` to avoid clashes with the
// klog_panic path's `spin` / `panic_fb_banner_skip` labels and the
// gop_fb_console module's `gop_fb_*` labels.

module PanicDump = structure {

  // ==========================================================================
  // .rodata — tag + KV keys for the fingerprint line.
  //
  // Locally scoped (like the GopFbConsole module's gop_fb_ok_msg /
  // gop_fb_k_width sibling constants) rather than promoted to
  // klog/keys.pdx: this module is the sole consumer of these three
  // strings, and the fingerprint-coverage gate matches on string
  // content, not symbol identity.  "PANIC DUMP" carries no OK token so
  // no verify-fingerprint-coverage.sh allowlist row is needed.
  // ==========================================================================

  pub let tag_panic_dump           : [u8; 11] = "PANIC DUMP\0"
  pub let tag_panic_dump_k_fb      : [u8; 3]  = "fb\0"
  pub let tag_panic_dump_k_msg_len : [u8; 8]  = "msg_len\0"

  // ==========================================================================
  // panic(msg_ptr: u64, msg_len: u64) -> ()   ; NORETURN
  //
  // See file header for the full contract.  Byte-slice panic entry that
  // mirrors msg[0..msg_len) to serial + GOP framebuffer, emits a
  // fingerprint, and halts.
  //
  // Effects/capabilities: {sysreg, mem, PortIo} @{paideia.port_io} —
  // a strict superset of every nested callee's row:
  //   uart_putc            : !{sysreg, PortIo} @{paideia.port_io}
  //   gop_fb_console_puts  : !{mem}            @{}
  //   klog_s1_d2           : !{sysreg, mem}    @{}
  //   raw cli/hlt          : !{sysreg}         @{}
  // ==========================================================================

  pub let panic : (u64, u64) -> () !{sysreg, mem, PortIo} @{paideia.port_io} =
    fn (msg_ptr: u64) (msg_len: u64) -> unsafe {
      effects: { sysreg, mem, PortIo },
      capabilities: { paideia.port_io },
      justification: "R111.M4-016 (paideia-os #2368): byte-slice panic entry — mirrors msg[0..msg_len) across every live substrate (serial COM1 via uart_putc, GOP framebuffer via gop_fb_console_puts gated on _gop_fb_console_active), emits the 'PANIC DUMP fb=<0|1> msg_len=<n>' fingerprint via klog_s1_d2, and halts. NORETURN. Sits alongside legacy klog_panic(subsys, tag) at core/klog/panic.pdx unchanged; existing exception-halt / kassert / boot-bailout callers keep reaching klog_panic byte-for-byte, this entry adds a callable target for callers with a raw msg-ptr+len. Register plan: 3-push callee-save (rbx=msg_ptr, r12=msg_len, r13=iterator idx) — entry rsp%16==8, +24 = rsp%16==0 (aligned pre-CALL as SysV requires); uart_putc and gop_fb_console_puts issue from this state with no additional pad (both take only register args and preserve rbx/r12/r13 across the call per their own SysV callee-save discipline). Step (a) serial mirror: xor r13,r13; loop while r13<r12; byte load via canonical `xor rax,rax; mov_b rax,[rbx+r13*1]` (mov_b does not zero-extend per paideia-as encoder gap — pre-xor makes the zero-extension explicit); rdi=rax; call uart_putc; add r13,1; jmp. Serial runs BEFORE the FB mirror because COM1 is the substrate every boot path has always brought up (R1.5 uart_init landing) — a fault in the FB path still leaves the message on the wire the operator's serial capture is already recording. Step (b) FB mirror: mov rax,[rip+_gop_fb_console_active]; cmp rax,0; je skip. Non-zero -> rdi=msg_ptr(rbx), rsi=msg_len(r12), call gop_fb_console_puts. Under M4-016 puts() drives gop_fb_draw_glyph_at per printable byte -> visible red strip on the T14 G4 panel whose length matches the byte count (photograph-recoverable per design/hardware/quirks.md §2.5). Under -kernel PVH gate is 0 -> load+compare early-out, byte-identical to the pre-M4-016 wire. Step (c) fingerprint: klog_s1_d2(LEVEL_PANIC=0, SUBSYS_PANC, tag_panic_dump, tag_panic_dump_k_fb, [_gop_fb_console_active], tag_panic_dump_k_msg_len, msg_len). klog_s1_d2 takes 7 args (6 reg + 1 stack): rdi=level, rsi=subsys_ptr, rdx=tag_ptr, rcx=k1, r8=v1, r9=k2, [rsp+8]=v2 (per paideia-as ABI limit of 6 params — see klog/wrappers.pdx L258). Body rsp%16==0; a lone `push v2` alone would land the CALL at rsp%16==8 (callee entry rsp%16==0, SysV-violating), so the caller emits an 8-byte pad + 8-byte push (16 B total) — same idiom as core/apic/ioapic_route.pdx:337 ioapic_wla_emit's klog_s1_d2 call site. After the CALL: `add rsp, 16` reclaims both slots and restores body rsp%16==0. Tag body 'PANIC DUMP' carries no OK token so verify-fingerprint-coverage.sh's OK_TOK regex skips it (no allowlist row needed). Step (d) halt: cli; hlt; jmp panic_dump_halt_spin. NORETURN — no ret at block end (same panic idiom as klog_panic's `spin:` label; the paideia-as encoder accepts a fall-off-end block when the final control flow is an unconditional jmp to a local label, per M4-001 klog_panic precedent). No isa-debug-exit call here: this entry is the physical-panel-visible arm and would race an operator's photograph if it handed QEMU an exit code prematurely; legacy klog_panic keeps the port-0xf4 exit for the QEMU smoke matrix. Effect/capability row is a strict superset of every nested callee (uart_putc: sysreg+PortIo+paideia.port_io; gop_fb_console_puts: mem; klog_s1_d2: sysreg+mem; raw cli/hlt: sysreg) per this tree's effect-widening discipline. Encoder posture (v0.36+): push/pop / mov reg,reg / mov reg,imm32 / mov r64,[rip+sym] / lea r64,[rip+sym] / xor r,r / mov_b r64,[reg+reg*1] / add r64,imm8 / sub r64,imm8 / cmp r64,imm8 / cmp r64,r64 / je/jne/jae/jmp / call rel32 / cli / hlt. No test rN,rN. No 2-op imul r,imm. No and reg,imm64. No cmp reg,[mem]. Reserved label prefix: panic_dump_.",
      block: {
        push rbx;
        push r12;
        push r13;
        // 3 callee-save pushes: entry rsp%16==8, -24 = rsp%16==0.  Every
        // nested call below issues from rsp%16==0 as SysV requires (call
        // pushes RIP -> callee entry rsp%16==8).  No additional pad is
        // needed for uart_putc / gop_fb_console_puts — they take only
        // register args and preserve rbx/r12/r13 across the call.  The
        // klog_s1_d2 stack-arg path pads separately below.

        mov rbx, rdi;                           // rbx = msg_ptr
        mov r12, rsi;                           // r12 = msg_len

        // ================================================================
        // Step (a): serial klog — walk msg[0..msg_len) via uart_putc.
        // ================================================================
        //
        // Iterator r13 counts up.  Byte load via canonical
        // `xor rax, rax; mov_b rax, [rbx + r13*1]` (indexed-byte-load
        // form with explicit *1 scale per vfs_open.pdx L127 / pdxfs_lite
        // /rename.pdx precedent — paideia-as encoder gap: mov_b does
        // not zero-extend, so the pre-xor makes the zero-extension
        // explicit).  uart_putc preserves rbx/r12/r13 across the call.

        xor r13, r13;                           // idx = 0

      panic_dump_uart_loop:
        cmp r13, r12;
        jae panic_dump_uart_done;

        xor rax, rax;
        mov_b rax, [rbx + r13 * 1];
        mov rdi, rax;                           // arg 0: byte
        call uart_putc;

        add r13, 1;
        jmp panic_dump_uart_loop;

      panic_dump_uart_done:

        // ================================================================
        // Step (b): GOP framebuffer mirror — gated on the M4-015 active
        // flag.
        // ================================================================
        //
        // Under -kernel PVH _gop_fb_console_active stays 0 (gop_fb_
        // console_init took the OFF arm) and this is a load+compare
        // early-out.  Under UEFI + GOP + LFB-map-succeeded the flag is
        // 1 and puts() drives the M4-016 fill-red blit stub, so the
        // panic message renders as a visible red strip whose length
        // matches the byte count.

        mov rax, [rip + _gop_fb_console_active];
        cmp rax, 0;
        je  panic_dump_fb_skip;

        mov rdi, rbx;                           // arg 0: msg_ptr
        mov rsi, r12;                           // arg 1: msg_len
        call gop_fb_console_puts;

      panic_dump_fb_skip:

        // ================================================================
        // Step (c): fingerprint via klog_s1_d2.
        // ================================================================
        //
        // Emits "panic PANIC DUMP fb=<0|1> msg_len=<n>".
        //
        // klog_s1_d2 signature (per klog/wrappers.pdx L258):
        //   rdi=level, rsi=subsys_ptr, rdx=tag_ptr,
        //   rcx=k1, r8=v1, r9=k2, [rsp+8]=v2
        //
        // paideia-as ABI limit is 6 register args; v2 (msg_len) is
        // pushed to the stack before the call.  Body rsp%16==0; a lone
        // `push v2` would land the call at rsp%16==8 pre-CALL (callee
        // entry rsp%16==0, SysV-violating).  Same 8-byte pad + 8-byte
        // push (16 B total) idiom the ioapic_route module uses at
        // core/apic/ioapic_route.pdx:337 keeps the callee-entry
        // rsp%16==8 invariant.  Post-call `add rsp, 16` reclaims both
        // slots, restoring body rsp%16==0.

        sub rsp, 8;                             // alignment pad
        mov rax, r12;                           // rax = v2 = msg_len
        push rax;                               // [rsp+8] post-call = v2

        mov  rdi, 0;                            // LEVEL_PANIC
        lea  rsi, [rip + SUBSYS_PANC];
        lea  rdx, [rip + tag_panic_dump];
        lea  rcx, [rip + tag_panic_dump_k_fb];
        mov  r8,  [rip + _gop_fb_console_active];   // v1 = fb flag
        lea  r9,  [rip + tag_panic_dump_k_msg_len];
        call klog_s1_d2;

        add rsp, 16;                            // pop push + pad

        // ================================================================
        // Step (d): halt.  cli + hlt spin; NMI can still interrupt but
        // this task has no return path — the CPU stays here forever.
        // ================================================================

      panic_dump_halt_spin:
        cli;
        hlt;
        jmp panic_dump_halt_spin;
      }
    }
}
