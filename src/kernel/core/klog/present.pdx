// src/kernel/core/klog/present.pdx — R49.M2-002 / R49.M2-003 (#1574, #1575)
//
// Boot-time presentation surface for RELEASE builds.
//
// TEST builds (_kernel_build_mode == 0, the default and the mode every
// existing smoke asserts against) treat every entry point in this
// module as a fast-return no-op. The witness stream on the wire is
// therefore byte-identical to the pre-R49 tree — the 14-mode smoke
// matrix + goldens keep passing unchanged.
//
// RELEASE builds (_kernel_build_mode == 1) enter the body and emit a
// curated set of human-readable lines via uart_putc directly, bypassing
// the release-mode mute that uart_puts and klog_emit_core install. That
// bypass is what lets the release image emit anything at all: the
// bootstub witnesses, the KPTI OK / SMP BRINGUP DONE / R__ tag stream
// and every klog line are all muted in release, and this module is what
// puts the machine's boot output back on the wire in a form a person
// (not a debugger) is meant to read.
//
// Scope at initial landing (R49.M2):
//
//   - present_boot_start: the release banner (ASCII logo + copyright)
//     and the "kernel starting" line. Emitted from kernel_main_64
//     immediately after uart_init.
//   - present_boot_ready: the release "System ready." line. Emitted
//     from boot_continue_after_ring3 at the very end, right before
//     the init handoff.
//
// R49.M2-003 documents the ordering, grouping, failure-visibility and
// verbose-escape-hatch decisions the presentation stream will grow
// into over subsequent rounds. Every future release-visible message
// lands here rather than as a scattered uart_puts, so a single file
// carries the entire release surface — an inventory of what a person
// sees at boot is a directory listing of this file's `present_*`
// entry points.
//
// See design/kernel/boot-presentation.md for the full presentation
// spec, sample happy-path + failure transcripts, and the roadmap for
// per-stage progress lines (firmware/CPU/memory/storage/input/network).

module Present = structure {

  // ============================================================================
  // Release banner + copyright — the ASCII logo (banner_art from
  // tools/boot_stub.S) plus a version and legal line. Emitted first in
  // release mode; TEST mode returns immediately with no bytes.
  //
  // Content deliberately overlaps with banner_art (the same identity a
  // developer sees at the top of a TEST boot) so the two modes agree
  // on what machine is booting. The wording under it is a rewrite of
  // the dev-round subsystem markers into a form aimed at a reader,
  // not a fingerprint verifier.
  // ============================================================================
  pub let present_boot_start : () -> () !{sysreg, mem} @{} =
    fn () -> unsafe {
      effects: { sysreg, mem },
      capabilities: {},
      justification: "R49.M2-002 (#1574). Release-only banner emit. Guard: mov rax,[rip+_kernel_build_mode]; cmp rax,0; je pbs_muted. Reuses banner_art (tools/boot_stub.S) via lea rdi,[rip+banner_art]; calls uart_putc byte-by-byte in a local copy of uart_puts's loop, so the release-mute in uart_puts does not swallow this call. Then emits the release preamble via _release_preamble_msg. No klog dependency: this must run BEFORE the klog subsystem is even needed. Registers per SysV; leaf enough to skip a frame. Byte-load idiom `mov rax,[rsi+rcx*1]; and rax,0xff; jz` is the proven pattern from uart_puts.",
      block: {
        mov rax, [rip + _kernel_build_mode];
        cmp rax, 0;
        je pbs_muted;

        lea rdi, [rip + banner_art];
        call present_puts;

        lea rdi, [rip + _release_preamble_msg];
        call present_puts;

        ret;

        pbs_muted:
        ret
      }
    }

  // ============================================================================
  // Release "System ready." — the line that closes the release boot,
  // emitted right before init is iretq'd into ring 3. Between banner
  // and ready, release mode emits nothing today; that surface grows
  // in the M2 completion issues (per-stage progress, failure lines)
  // referenced in design/kernel/boot-presentation.md §4.
  // ============================================================================
  pub let present_boot_ready : () -> () !{sysreg, mem} @{} =
    fn () -> unsafe {
      effects: { sysreg, mem },
      capabilities: {},
      justification: "R49.M2-002 (#1574). Release-only readiness line. Same guard shape as present_boot_start. Emits _release_ready_msg via present_puts. TEST mode is a no-op so the existing witness stream (INIT BOOT OK + sti ordering) is unchanged and every golden that asserts an ordered subsequence around this point keeps passing.",
      block: {
        mov rax, [rip + _kernel_build_mode];
        cmp rax, 0;
        je pbr_muted;

        lea rdi, [rip + _release_ready_msg];
        call present_puts;

        ret;

        pbr_muted:
        ret
      }
    }

  // ============================================================================
  // Bypass writer. Copies uart_puts's byte loop but calls uart_putc
  // (which is NOT muted) directly, so the bytes reach COM1 even
  // when the release mute is set on uart_puts. Callers must have
  // already checked _kernel_build_mode; this primitive does not, so
  // it can also be reused later by TEST-only helpers if we need a
  // "definitely not muted" path.
  //
  // Not `pub`-exported outside the Present interface today — the
  // module intentionally exposes only present_boot_* entry points to
  // the rest of the kernel, so every release-visible message lives in
  // one file. See design/kernel/boot-presentation.md §5.
  // ============================================================================
  pub let present_puts : (u64) -> () !{sysreg, mem} @{} =
    fn (s: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: {},
      justification: "R49.M2-002 (#1574). Bypass-uart_puts writer for release output. Identical loop shape to uart.pdx uart_puts but calls uart_putc directly, so the _kernel_build_mode mute on uart_puts is not consulted. Local labels prp_top / prp_end are function-scoped so the shared `loop_top` name in uart.pdx does not collide (paideia-as labels are per-function).",
      block: {
        mov rsi, rdi;
        xor rcx, rcx;
        prp_top:
          mov rax, [rsi + rcx * 1];
          and rax, 0xff;
          jz prp_end;
          mov rdi, rax;
          call uart_putc;
          add rsi, 1;
          jmp prp_top;
        prp_end:
          ret
      }
    }

  // ============================================================================
  // Release-visible strings.
  //
  // Wording rules (R49.M2-002 acceptance criteria):
  //   - No `R__` round identifier, no `M__-___` milestone identifier.
  //   - No raw hex TSC timestamp.
  //   - No 4-char subsystem tag from klog's column alignment.
  //   - Sentences, not markers.
  //
  // The regression gate at tools/run-smoke.sh (boot_release mode) and
  // tests/release/expected-release-boot.txt asserts these properties
  // mechanically. See design/kernel/boot-presentation.md §6.
  //
  // Sizes are the byte count of the string INCLUDING the trailing \n
  // and NUL — paideia-as `[u8; N]` wants the exact array length.
  // ============================================================================

  // 46 characters + \n + \0 = 48 bytes.
  pub let _release_preamble_msg : [u8; 48] =
    "Kernel starting. Please wait for system ready.\n\0"

  // 13 characters + \n + \0 = 15 bytes.
  pub let _release_ready_msg : [u8; 15] =
    "System ready.\n\0"
}
