  // R69.M1 (#1883/#1888/#1894): SMP scheduler real-dispatch fingerprints.
  //
  // tag_sched_cross_cpu_wake_ok — emitted by sched_wake (wake_block.pdx)
  // when a target task's cpu_mask names a CPU other than the caller's,
  // proving the cross-CPU remote-enqueue + reschedule-IPI path fired
  // (rather than the wildcard/same-CPU local-enqueue fallback). KVs:
  // k_from (waking CPU), k_to (target CPU), k_pid (woken task's pid).
  //
  // tag_sched_work_steal_ok — emitted by sched_try_steal (runqueue.pdx)
  // when it moves half of the fullest sibling's runqueue into an idle
  // CPU's runqueue. KVs: k_src (donor CPU), k_dst (recipient CPU),
  // k_stolen (task count moved).
  //
  // tag_smp_dispatch_ok — the R69.M1-004 fairness rollup emitted by the
  // boot_r69_smp_dispatch witness (boot/witness/r69_smp_dispatch.pdx).
  // HONEST SCOPE: min_ticks/max_ticks/ratio_pct measure per-CPU
  // *runqueue-residency* (task count parked on each CPU's runqueue
  // after cross-CPU-wake distribution), NOT execution-tick counts —
  // real per-CPU tick accrual requires an AP to take timer interrupts,
  // which is blocked on AP-side IDT install (never landed; see
  // ap_entry.pdx's "IDT install" note and apic/tsc_deadline.pdx's
  // "APs cannot receive timer interrupts until an IDT is installed on
  // [them]" note, both outstanding since R18.M1 #762). ratio_pct is an
  // integer percentage (min*100/max) rather than a fraction, since this
  // KV is decimal-only.
  pub let tag_sched_cross_cpu_wake_ok : [u8; 58] = "sched cross-cpu wake ok [legacy: SCHED CROSS CPU WAKE OK]\0"
  pub let tag_sched_work_steal_ok     : [u8; 50] = "sched work steal ok [legacy: SCHED WORK STEAL OK]\0"
  pub let tag_smp_dispatch_ok         : [u8; 42] = "smp dispatch ok [legacy: SMP DISPATCH OK]\0"

  pub let k_src        : [u8; 4]  = "src\0"
  pub let k_dst        : [u8; 4]  = "dst\0"
  pub let k_stolen     : [u8; 7]  = "stolen\0"
  pub let k_cpus       : [u8; 5]  = "cpus\0"
  pub let k_min_ticks  : [u8; 10] = "min_ticks\0"
  pub let k_max_ticks  : [u8; 10] = "max_ticks\0"
  pub let k_ratio_pct  : [u8; 10] = "ratio_pct\0"

