// src/kernel/core/klog/keys.pdx — M1-002 (#684) Logging event keys
//
// Nineteen .rodata key symbols emitted to COM1 by klog_emit_core
// (src/kernel/core/klog/emit.pdx). Each string is NUL-terminated because
// uart_puts (src/kernel/boot/uart.pdx) walks bytes until zero.
//
// Byte counts (NUL-inclusive):
//   k_cr2                4   "cr2\0"
//   k_rip                4   "rip\0"
//   k_cs                 3   "cs\0"
//   k_rfl                4   "rfl\0"
//   k_rsp                4   "rsp\0"
//   k_ss                 3   "ss\0"
//   k_err                4   "err\0"
//   k_vec                4   "vec\0"
//   k_pid                4   "pid\0"
//   k_tid                4   "tid\0"
//   k_pa                 3   "pa\0"
//   k_va                 3   "va\0"
//   k_len                4   "len\0"
//   k_fd                 3   "fd\0"
//   k_file               5   "file\0"
//   k_line               5   "line\0"
//   k_exp                4   "exp\0"
//   k_got                4   "got\0"
//   k_rbp                4   "rbp\0"
//
// Callers reference symbols as flat globals: `lea rdi, [rip + k_XXX]`.
// All keys are lowercase to match §3.3 EBNF (key = 1*(ALPHA/DIGIT/"_")).
// Variable length to accommodate different key names without padding.
//
// Audit: design/kernel/kernel-logging-substrate.md §5.2
//        design/audit/entries/r14b-m1-002-subsys-keys.md

module Keys = structure {
  pub let k_cr2 : [u8; 4] = "cr2\0"
  pub let k_rip : [u8; 4] = "rip\0"
  pub let k_cs : [u8; 3] = "cs\0"
  pub let k_rfl : [u8; 4] = "rfl\0"
  pub let k_rsp : [u8; 4] = "rsp\0"
  pub let k_ss : [u8; 3] = "ss\0"
  pub let k_err : [u8; 4] = "err\0"
  pub let k_vec : [u8; 4] = "vec\0"
  pub let k_pid : [u8; 4] = "pid\0"
  pub let k_tid : [u8; 4] = "tid\0"
  pub let k_pa : [u8; 3] = "pa\0"
  pub let k_va : [u8; 3] = "va\0"
  pub let k_len : [u8; 4] = "len\0"
  pub let k_fd : [u8; 3] = "fd\0"
  pub let k_file : [u8; 5] = "file\0"
  pub let k_line : [u8; 5] = "line\0"

  // R31.M2-1596 (#1596): cap-table slot index, for loader_seed_caps'
  // LOADER_SEED_SLOT_TAKEN refusal. Distinct from k_line (a source-line or
  // sub-test number) because the two are read very differently: a line
  // number sends you to the code, a slot number sends you to the machine's
  // capability table.
  pub let k_slot : [u8; 5] = "slot\0"
  pub let k_exp : [u8; 4] = "exp\0"
  pub let k_got : [u8; 4] = "got\0"
  pub let k_rbp : [u8; 4] = "rbp\0"
  pub let tag_frame : [u8; 6] = "FRAME\0"
  pub let k_panic_dump_begin : [u8; 31] = "====== PANIC DUMP BEGIN ======\0"
  pub let k_panic_dump_end : [u8; 29] = "====== PANIC DUMP END ======\0"
  // R23-M3-002 (#884): fb-only panic banner bytes.  Emitted to the
  // framebuffer console (never to COM1) at panic entry so a photograph
  // of a frozen T14 G4 screen shows an unmissable red "*** PANIC ***"
  // line above the ring history.  Wire sequence (26 bytes, NO screen
  // clear so the pre-panic boot log stays visible above the banner):
  //   [0..7)   CSI SGR bold + red foreground: ESC '[' '1' ';' '3' '1' 'm'
  //   [7..20)  literal banner:                '*' '*' '*' ' ' 'P' 'A' 'N' 'I' 'C' ' ' '*' '*' '*'
  //   [20..24) CSI SGR reset:                 ESC '[' '0' 'm'
  //   [24..26) CRLF terminator:               '\r' '\n'
  // Byte-array literal (numeric form, no escape-decoding assumption) so
  // paideia-as string-literal escape support is not on the critical
  // path.  Consumers pass k_panic_fb_banner_len as the byte count.
  pub let k_panic_fb_banner : [u8; 26] = [
    0x1Bu8, 0x5Bu8, 0x31u8, 0x3Bu8, 0x33u8, 0x31u8, 0x6Du8,
    0x2Au8, 0x2Au8, 0x2Au8, 0x20u8, 0x50u8, 0x41u8, 0x4Eu8, 0x49u8, 0x43u8, 0x20u8, 0x2Au8, 0x2Au8, 0x2Au8,
    0x1Bu8, 0x5Bu8, 0x30u8, 0x6Du8,
    0x0Du8, 0x0Au8
  ]
  pub let k_panic_fb_banner_len : u64 = 26
  pub let tag_trap_frame : [u8; 12] = "TRAP FRAME\0"
  pub let tag_pf : [u8; 4] = "PF\0"
  pub let tag_exc_halt : [u8; 9] = "EXC HALT\0"
  pub let tag_sched_block_precond : [u8; 14] = "SCHED PRECOND\0"
  pub let tag_exit_returned : [u8; 14] = "EXIT RETURNED\0"
  pub let tag_ring3_returned : [u8; 15] = "RING3 RETURNED\0"
  pub let tag_kmain_returned : [u8; 15] = "KMAIN RETURNED\0"
  pub let tag_init_boot_hang : [u8; 15] = "INIT BOOT HANG\0"
  pub let tag_assert : [u8; 7] = "ASSERT\0"
  pub let tag_at : [u8; 3] = "AT\0"
  pub let tag_assertion_failed : [u8; 18] = "assertion failed\0"
  // #1762: R14/R15 round tags stripped per design/policy/output-provenance-strip.md.
  // tag_r15_handler_called / tag_r15_gp_debug removed entirely (not renamed):
  // both were unconditional bisection debug prints from the R15-M2-006b
  // #GP witness bring-up ("Debug: print unconditionally to see if handler
  // is called at all" / "Debug: print that witness path is taken" in
  // src/kernel/core/int/exceptions.pdx), asserted by no golden/fixture,
  // and name a bring-up state no longer being debugged — see #1775 cluster A
  // for the sibling boot_stub.S sweep of the same shape.
  pub let tag_ud_ok : [u8; 6] = "UD OK\0"
  pub let tag_ring3_hello_ok : [u8; 15] = "RING3 HELLO OK\0"
  pub let tag_witness_resumed : [u8; 16] = "WITNESS RESUMED\0"
  // R31.M0-1583 (#1583): emitted by fault_ring3_death_check when a ring-3
  // fault is turned into a task death instead of a machine panic.
  // Deliberately carries no OK token: this is an event, not a fingerprint,
  // and a marker in verify-fingerprint-coverage.sh's emitted set would need
  // a golden line asserting that a smoke run faults.
  pub let tag_ring3_fault_kill : [u8; 29] = "RING3 FAULT: TASK TERMINATED\0"
  pub let tag_sched_task_a_tick : [u8; 12] = "TASK A TICK\0"
  pub let tag_sched_task_b_tick : [u8; 12] = "TASK B TICK\0"
  // R15-M7-566 (#566): timer-preempt witness tags — see design §4.
  pub let tag_preempt_pa : [u8; 8] = "PA TICK\0"
  pub let tag_preempt_pb : [u8; 8] = "PB TICK\0"
  pub let tag_ipc_smoke_ok : [u8; 7] = "IPC OK\0"
  pub let tag_max_len_canary : [u8; 15] = "MAX LEN CANARY\0"
  pub let tag_max_len_measured : [u8; 14] = "M8 MAXLINE OK\0"
  pub let tag_kpti_stacks_ok : [u8; 16] = "KPTI STACKS OK\n\0"
  pub let tag_kpti_desc_ok : [u8; 14] = "KPTI DESC OK\n\0"
  pub let tag_kpti_isr_ok : [u8; 13] = "KPTI ISR OK\n\0"

  // R14b-M5-008 (#661): pf_handle_cow bisection markers (11 tags).
  // Byte counts audited: text_length + 1 (NUL). #699 fabrication trap corrected.
  pub let tag_pf_cow_entry : [u8; 13] = "PF COW ENTRY\0"
  pub let tag_pf_cow_flip_ok : [u8; 15] = "PF COW FLIP OK\0"
  pub let tag_pf_cow_err_rsvd_reject : [u8; 16] = "PF COW ERR RSVD\0"
  pub let tag_pf_cow_err_pw_reject : [u8; 15] = "PF COW ERR P|W\0"
  pub let tag_pf_cow_pml4_absent : [u8; 16] = "PF COW PML4 ABS\0"
  pub let tag_pf_cow_pdpt_absent : [u8; 16] = "PF COW PDPT ABS\0"
  pub let tag_pf_cow_pd_absent : [u8; 14] = "PF COW PD ABS\0"
  pub let tag_pf_cow_pt_absent : [u8; 14] = "PF COW PT ABS\0"
  pub let tag_pf_cow_leaf_rw_reject : [u8; 15] = "PF COW LEAF RW\0"
  pub let tag_pf_cow_leaf_cow_reject : [u8; 16] = "PF COW LEAF COW\0"
  pub let tag_pf_cow_refcount_reject : [u8; 14] = "PF COW REFCNT\0"

  // R15-M6-002 (#553): pf_handle_cow split-path markers.
  // Split path fires when refcount >= 2 (page has other sharers): allocate a
  // fresh frame, copy 4 KiB, rewrite the leaf PTE, invlpg, decref old frame.
  // Byte counts: text_length + 1 (NUL), audited per #699 discipline.
  pub let tag_pf_cow_split_ok : [u8; 16] = "PF COW SPLIT OK\0"
  pub let tag_pf_cow_split_alloc_fail : [u8; 17] = "PF COW SPLIT OOM\0"

  // R21-M1 (#825/#826): XSAVE probe + enable fingerprints and keys.
  // Byte counts include trailing NUL per #699 discipline.
  pub let tag_xsave_probe_ok : [u8; 15] = "XSAVE PROBE OK\0"
  pub let tag_xsave_probe_no_support : [u8; 21] = "XSAVE NO CPU SUPPORT\0"
  pub let tag_xsave_enabled : [u8; 14] = "XSAVE ENABLED\0"
  pub let k_mask : [u8; 5] = "mask\0"
  pub let k_size : [u8; 5] = "size\0"
  pub let k_xcr0 : [u8; 5] = "xcr0\0"

  // R21-M2 (#830/#831): AVX2 / AVX-512 CPU-feature-bit fingerprints.
  // Emitted by cpu_probe_avx2 / cpu_probe_avx512 (src/kernel/core/cpu/
  // cpu_features.pdx) after xsave_enable_this_cpu, so XCR0 has been
  // programmed and CPUID.07H reflects the runtime feature surface.
  // Byte counts NUL-inclusive per #699 discipline.
  pub let tag_cpu_avx2_avail   : [u8; 19] = "CPU AVX2 available\0"
  pub let tag_cpu_avx2_absent  : [u8; 21] = "CPU AVX2 unavailable\0"
  pub let tag_cpu_avx512_avail  : [u8; 22] = "CPU AVX-512 available\0"
  pub let tag_cpu_avx512_absent : [u8; 24] = "CPU AVX-512 unavailable\0"
  // K/V key for the AVX-512 bitmap fingerprint.
  pub let k_bits : [u8; 5] = "bits\0"

  // R21-M2 (#832): YMM-preservation regression fixture fingerprints.
  // Emitted only when cpu_avx2_available() returns true — the witnesses
  // in tests/kernel/cpu/ymm_preserve.pdx auto-skip on qemu64-default
  // boots.  Smoke: tools/run-smoke.sh boot_r21_ymm_preserve, guarded by
  // PAIDEIA_R21_YMM=1 in pre-push.
  // Byte counts NUL-inclusive per #699 discipline (each string body =
  // 17 chars + 1 NUL = 18 bytes).
  pub let tag_ymm_preserve_a_ok  : [u8; 18] = "YMM PRESERVE A OK\0"
  pub let tag_ymm_preserve_b_ok  : [u8; 18] = "YMM PRESERVE B OK\0"
  pub let tag_ymm_preserve_fail  : [u8; 18] = "YMM PRESERVE FAIL\0"

  // R21-M5 (#842 HPET, #843 TSC, #844 x2APIC) fingerprints + keys.
