// src/kernel/core/klog/keys.pdx — M1-002 (#684) Logging event keys
//
// Nineteen .rodata key symbols emitted to COM1 by klog_emit_core
// (src/kernel/core/klog/emit.pdx). Each string is NUL-terminated because
// uart_puts (src/kernel/boot/uart.pdx) walks bytes until zero.
//
// Byte counts (NUL-inclusive):
//   k_cr2                4   "cr2\0"
//   k_rip                4   "rip\0"
//   k_cs                 3   "cs\0"
//   k_rfl                4   "rfl\0"
//   k_rsp                4   "rsp\0"
//   k_ss                 3   "ss\0"
//   k_err                4   "err\0"
//   k_vec                4   "vec\0"
//   k_pid                4   "pid\0"
//   k_tid                4   "tid\0"
//   k_pa                 3   "pa\0"
//   k_va                 3   "va\0"
//   k_len                4   "len\0"
//   k_fd                 3   "fd\0"
//   k_file               5   "file\0"
//   k_line               5   "line\0"
//   k_exp                4   "exp\0"
//   k_got                4   "got\0"
//   k_rbp                4   "rbp\0"
//
// Callers reference symbols as flat globals: `lea rdi, [rip + k_XXX]`.
// All keys are lowercase to match §3.3 EBNF (key = 1*(ALPHA/DIGIT/"_")).
// Variable length to accommodate different key names without padding.
//
// Audit: design/kernel/kernel-logging-substrate.md §5.2
//        design/audit/entries/r14b-m1-002-subsys-keys.md

module Keys = structure {
  pub let k_cr2 : [u8; 4] = "cr2\0"
  pub let k_rip : [u8; 4] = "rip\0"
  pub let k_cs : [u8; 3] = "cs\0"
  pub let k_rfl : [u8; 4] = "rfl\0"
  pub let k_rsp : [u8; 4] = "rsp\0"
  pub let k_ss : [u8; 3] = "ss\0"
  pub let k_err : [u8; 4] = "err\0"
  pub let k_vec : [u8; 4] = "vec\0"
  pub let k_pid : [u8; 4] = "pid\0"
  pub let k_tid : [u8; 4] = "tid\0"
  pub let k_pa : [u8; 3] = "pa\0"
  pub let k_va : [u8; 3] = "va\0"
  pub let k_len : [u8; 4] = "len\0"
  pub let k_fd : [u8; 3] = "fd\0"
  pub let k_file : [u8; 5] = "file\0"
  pub let k_line : [u8; 5] = "line\0"
  pub let k_exp : [u8; 4] = "exp\0"
  pub let k_got : [u8; 4] = "got\0"
  pub let k_rbp : [u8; 4] = "rbp\0"
}
