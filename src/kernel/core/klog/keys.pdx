// src/kernel/core/klog/keys.pdx — M1-002 (#684) Logging event keys
//
// Nineteen .rodata key symbols emitted to COM1 by klog_emit_core
// (src/kernel/core/klog/emit.pdx). Each string is NUL-terminated because
// uart_puts (src/kernel/boot/uart.pdx) walks bytes until zero.
//
// Byte counts (NUL-inclusive):
//   k_cr2                4   "cr2\0"
//   k_rip                4   "rip\0"
//   k_cs                 3   "cs\0"
//   k_rfl                4   "rfl\0"
//   k_rsp                4   "rsp\0"
//   k_ss                 3   "ss\0"
//   k_err                4   "err\0"
//   k_vec                4   "vec\0"
//   k_pid                4   "pid\0"
//   k_tid                4   "tid\0"
//   k_pa                 3   "pa\0"
//   k_va                 3   "va\0"
//   k_len                4   "len\0"
//   k_fd                 3   "fd\0"
//   k_file               5   "file\0"
//   k_line               5   "line\0"
//   k_exp                4   "exp\0"
//   k_got                4   "got\0"
//   k_rbp                4   "rbp\0"
//
// Callers reference symbols as flat globals: `lea rdi, [rip + k_XXX]`.
// All keys are lowercase to match §3.3 EBNF (key = 1*(ALPHA/DIGIT/"_")).
// Variable length to accommodate different key names without padding.
//
// Audit: design/kernel/kernel-logging-substrate.md §5.2
//        design/audit/entries/r14b-m1-002-subsys-keys.md

module Keys = structure {
  pub let k_cr2 : [u8; 4] = "cr2\0"
  pub let k_rip : [u8; 4] = "rip\0"
  pub let k_cs : [u8; 3] = "cs\0"
  pub let k_rfl : [u8; 4] = "rfl\0"
  pub let k_rsp : [u8; 4] = "rsp\0"
  pub let k_ss : [u8; 3] = "ss\0"
  pub let k_err : [u8; 4] = "err\0"
  pub let k_vec : [u8; 4] = "vec\0"
  pub let k_pid : [u8; 4] = "pid\0"
  pub let k_tid : [u8; 4] = "tid\0"
  pub let k_pa : [u8; 3] = "pa\0"
  pub let k_va : [u8; 3] = "va\0"
  pub let k_len : [u8; 4] = "len\0"
  pub let k_fd : [u8; 3] = "fd\0"
  pub let k_file : [u8; 5] = "file\0"
  pub let k_line : [u8; 5] = "line\0"

  // R31.M2-1596 (#1596): cap-table slot index, for loader_seed_caps'
  // LOADER_SEED_SLOT_TAKEN refusal. Distinct from k_line (a source-line or
  // sub-test number) because the two are read very differently: a line
  // number sends you to the code, a slot number sends you to the machine's
  // capability table.
  pub let k_slot : [u8; 5] = "slot\0"
  pub let k_exp : [u8; 4] = "exp\0"
  pub let k_got : [u8; 4] = "got\0"
  pub let k_rbp : [u8; 4] = "rbp\0"

  // R61.M1-003 (#1822): byte count of a seeded tmpfs binary's ELF image.
  // Distinct from k_len (a generic byte-length key used across several
  // unrelated subsystems) because the R61 bin-seed fingerprints
  // (`bin seed ok -- file=/bin/<name> bytes=<N>`) want the literal word
  // "bytes" on the wire, not a name shared with e.g. buffer lengths.
  pub let k_bytes : [u8; 6] = "bytes\0"

  // R90-XREPO.010.M1-006 (paideia-os #2114): row count emitted by
  // sys_pdxfs_dir_readnext on EOD.  Kept distinct from k_count (which is
  // reused across unrelated subsystems for aggregate counters) so the
  // readdir fingerprint `sys pdxfs readdir ok ... rows=<n>` carries the
  // literal word "rows" on the wire, matching the semantic-pipe
  // PdxFsDirEntry[] framing the tool consumers key on.
  pub let k_rows : [u8; 5] = "rows\0"
  pub let tag_frame : [u8; 6] = "FRAME\0"
  pub let k_panic_dump_begin : [u8; 31] = "====== PANIC DUMP BEGIN ======\0"
  pub let k_panic_dump_end : [u8; 29] = "====== PANIC DUMP END ======\0"
  // R23-M3-002 (#884): fb-only panic banner bytes.  Emitted to the
  // framebuffer console (never to COM1) at panic entry so a photograph
  // of a frozen T14 G4 screen shows an unmissable red "*** PANIC ***"
  // line above the ring history.  Wire sequence (26 bytes, NO screen
  // clear so the pre-panic boot log stays visible above the banner):
  //   [0..7)   CSI SGR bold + red foreground: ESC '[' '1' ';' '3' '1' 'm'
  //   [7..20)  literal banner:                '*' '*' '*' ' ' 'P' 'A' 'N' 'I' 'C' ' ' '*' '*' '*'
  //   [20..24) CSI SGR reset:                 ESC '[' '0' 'm'
  //   [24..26) CRLF terminator:               '\r' '\n'
  // Byte-array literal (numeric form, no escape-decoding assumption) so
  // paideia-as string-literal escape support is not on the critical
  // path.  Consumers pass k_panic_fb_banner_len as the byte count.
  pub let k_panic_fb_banner : [u8; 26] = [
    0x1Bu8, 0x5Bu8, 0x31u8, 0x3Bu8, 0x33u8, 0x31u8, 0x6Du8,
    0x2Au8, 0x2Au8, 0x2Au8, 0x20u8, 0x50u8, 0x41u8, 0x4Eu8, 0x49u8, 0x43u8, 0x20u8, 0x2Au8, 0x2Au8, 0x2Au8,
    0x1Bu8, 0x5Bu8, 0x30u8, 0x6Du8,
    0x0Du8, 0x0Au8
  ]
  pub let k_panic_fb_banner_len : u64 = 26
  pub let tag_trap_frame : [u8; 12] = "TRAP FRAME\0"
  pub let tag_pf : [u8; 4] = "PF\0"

  // R51 Phase C (SUBSYS_INT shard, boot-transcript.md §7): English
  // narrative header emitted once per klog_dump_trap_frame call, right
  // before the two TRAP FRAME lines and the optional PF cr2 line.
  // Two-line strategy (§5.1 option A) rather than a bracketed suffix on
  // tag_trap_frame because tests/logging/expected-panic-dump.txt and
  // tests/r14b/expected-boot-r14b-loader.txt pin the contiguous
  // substrings `TRAP FRAME vec=0x` and `TRAP FRAME rfl=0x`; any suffix
  // between `TRAP FRAME` and the composer-appended ` vec=0x...` breaks
  // the contiguity.  The narrative body carries no `OK` token so
  // verify-fingerprint-coverage.sh's OK_TOK regex skips it.
  pub let tag_trap_frame_narrative : [u8; 20] = "trap frame captured\0"

  // R51 Phase C: tag_exc_halt renamed to tag_exc_halt_narrative with
  // bracketed legacy suffix (memo §5.1 option B).  klog_panic emits
  // the tag string as the message body; the golden
  // tests/logging/expected-panic-dump.txt line 3 pins substring
  // `EXC HALT`, which stays live inside `[legacy: EXC HALT]`.  For
  // operator grep discipline (memo §3.5 "keep the token operators grep
  // for" for panic messages) the marker is bracketed rather than
  // dropped.  Body carries no `OK` token so coverage is unaffected.
  pub let tag_exc_halt_narrative : [u8; 46] = "unhandled exception halted [legacy: EXC HALT]\0"

  pub let tag_sched_block_precond : [u8; 14] = "SCHED PRECOND\0"

  // R51 Phase C: tag_exit_returned renamed with bracketed legacy suffix.
  // Used by syscall/dispatch.pdx's dispatch_exit_halt via klog_panic; no
  // golden asserts `EXIT RETURNED` (grep tests/ returns zero hits) but
  // the marker is kept in brackets for operator grep parity with the
  // pre-R51 wire.  No OK token; coverage unaffected.
  pub let tag_exit_returned_narrative : [u8; 58] = "scheduler returned to ZOMBIE task [legacy: EXIT RETURNED]\0"
  // R51 Phase C batch 5 (SUBSYS_BOOT shard, boot-transcript.md §3.5):
  // three klog_panic tags rewritten IN-PLACE with English narrative bodies
  // plus bracketed `[legacy: <OLD>]` suffix (memo §5.1 option B).  None of
  // the three carry an OK token and grep tests/**/* returns zero hits for
  // `RING3 RETURNED`, `KMAIN RETURNED`, `INIT BOOT HANG`, so the rewrite
  // is both coverage-neutral and golden-neutral.  The bracketed marker
  // preserves operator grep parity with the pre-R51 wire (each of the
  // three names a specific boot-progress failure mode: ring-3 witness
  // path returned unexpectedly, kmain returned to the halt trampoline,
  // and the init supervisor never scheduled).  Emit sites in
  // src/kernel/boot/entry.pdx, src/kernel/boot/kernel_main.pdx are
  // unchanged (tag identifiers stable; only the body strings + byte
  // counts grew).
  pub let tag_ring3_returned : [u8; 62] = "ring-3 witness returned unexpectedly [legacy: RING3 RETURNED]\0"
  pub let tag_kmain_returned : [u8; 46] = "kernel_main returned [legacy: KMAIN RETURNED]\0"
  pub let tag_init_boot_hang : [u8; 57] = "init supervisor never scheduled [legacy: INIT BOOT HANG]\0"
  pub let tag_assert : [u8; 7] = "ASSERT\0"
  pub let tag_at : [u8; 3] = "AT\0"
  pub let tag_assertion_failed : [u8; 18] = "assertion failed\0"
  // #1762: R14/R15 round tags stripped per design/policy/output-provenance-strip.md.
  // tag_r15_handler_called / tag_r15_gp_debug removed entirely (not renamed):
  // both were unconditional bisection debug prints from the R15-M2-006b
  // #GP witness bring-up ("Debug: print unconditionally to see if handler
  // is called at all" / "Debug: print that witness path is taken" in
  // src/kernel/core/int/exceptions.pdx), asserted by no golden/fixture,
  // and name a bring-up state no longer being debugged — see #1775 cluster A
  // for the sibling boot_stub.S sweep of the same shape.
  pub let tag_ud_ok : [u8; 6] = "UD OK\0"
  pub let tag_ring3_hello_ok : [u8; 15] = "RING3 HELLO OK\0"

  // R51 Phase C (SUBSYS_INT shard, boot-transcript.md §7): English
  // narrative lines preceding the two OK-token witness fingerprints
  // above.  Two-line strategy (§5.1 option A) rather than a bracketed
  // suffix on the existing tags because both `UD OK` and
  // `RING3 HELLO OK` are OK-tokenised and asserted by goldens
  // (`UD OK` in tests/r14b/expected-boot-r14b-ud.txt; `RING3 HELLO OK`
  // in five goldens including tests/r15/expected-boot-r15-ring3.txt).
  // Rewriting the tag body would leave the OK-token unchanged in the
  // new string, but verify-fingerprint-coverage.sh matches markers by
  // whole-string startswith/startswith parity — a new marker with a
  // narrative prefix would fail coverage.  Two-line preserves both the
  // asserted fingerprint and the coverage relationship byte-identically.
  // Narrative bodies carry no OK token (verify-fingerprint-coverage.sh's
  // OK_TOK regex skips them) so no allowlist row is needed.
  pub let tag_ud_narrative              : [u8; 27] = "ring-3 #UD witness resumed\0"
  pub let tag_ring3_hello_narrative     : [u8; 28] = "ring-3 hello from userspace\0"

  // R51 Phase C: tag_witness_resumed renamed to tag_witness_resumed_narrative
  // with bracketed legacy suffix (memo §5.1 option B).  No golden asserts
  // `WITNESS RESUMED` and the string has no OK token, so the rewrite is
  // free of both coverage and golden constraints.  Bracketed marker is
  // defensive for operator grep parity with the pre-R51 wire.
  pub let tag_witness_resumed_narrative : [u8; 54] = "ring-3 witness path resumed [legacy: WITNESS RESUMED]\0"

  // R31.M0-1583 (#1583): emitted by fault_ring3_death_check when a ring-3
  // fault is turned into a task death instead of a machine panic.
  // Deliberately carries no OK token: this is an event, not a fingerprint,
  // and a marker in verify-fingerprint-coverage.sh's emitted set would need
  // a golden line asserting that a smoke run faults.
  //
  // R51 Phase C: renamed to _narrative with bracketed legacy suffix.  No
  // golden asserts `RING3 FAULT: TASK TERMINATED` and the string has no OK
  // token, so the rewrite is coverage-neutral.  The bracketed `RING3 FAULT`
  // marker is preserved for operator grep parity (memo §3.5).
  pub let tag_ring3_fault_kill_narrative : [u8; 71] = "ring-3 task terminated after unrecoverable fault [legacy: RING3 FAULT]\0"

  // R51 Phase C batch 4 (SUBSYS_SCHD shard, design/kernel/boot-transcript.md
  // §3.5): the four cooperative-yield and preempt-witness per-tick markers
  // are rewritten IN-PLACE with an English narrative body plus a bracketed
  // `[legacy: <OLD>]` suffix (memo §5.1 option B).  None of these strings
  // carry an OK token so verify-fingerprint-coverage.sh's OK_TOK regex
  // ignores them.  A tree-wide grep of tests/**/* returns hits only for the
  // preempt witnesses' bare `PA TICK` / `PB TICK` lines (r15..r17 goldens);
  // run-smoke.sh's ordered-substring rule keeps those green because
  // `PA TICK` remains a contiguous substring inside the bracketed marker.
  // `TASK A TICK` / `TASK B TICK` have no golden anchor at all — the
  // R10/R11 cooperative-yield tasks are legacy witnesses whose ticks are
  // observed operationally, not asserted mechanically.  Emit sites in
  // src/kernel/core/sched/tasks.pdx + tasks_r11.pdx are unchanged (tag
  // identifiers stable; only the body strings + byte counts grow).
  pub let tag_sched_task_a_tick : [u8; 46] = "cooperative task A tick [legacy: TASK A TICK]\0"
  pub let tag_sched_task_b_tick : [u8; 46] = "cooperative task B tick [legacy: TASK B TICK]\0"
  // R15-M7-566 (#566): timer-preempt witness tags — see design §4.
  pub let tag_preempt_pa : [u8; 46] = "preempt witness task A tick [legacy: PA TICK]\0"
  pub let tag_preempt_pb : [u8; 46] = "preempt witness task B tick [legacy: PB TICK]\0"
  // R51 Phase C (SUBSYS_IPC shard, boot-transcript.md §7): English
  // narrative with bracketed legacy suffix (memo §5.1 option B).  The
  // `IPC OK` marker appears as a whole-line assertion in six goldens
  // (tests/r{8,9,10,11,12}/expected-boot-*.txt); tools/run-smoke.sh does
  // an ordered-substring match, so the bracketed `[legacy: IPC OK]` keeps
  // every golden green.  The old `tag_ipc_smoke_ok` symbol is deleted —
  // sole consumer was src/kernel/core/ipc/smoke.pdx; the OK-token
  // migrates from `IPC OK` (7 B) to the bracketed suffix inside the
  // narrative body, keeping verify-fingerprint-coverage.sh's OK_TOK
  // regex satisfied by the same golden lines as before.
  pub let tag_ipc_narrative : [u8; 20] = "ipc endpoints ready\0"
  pub let tag_ipc_smoke_ok  : [u8; 7]  = "IPC OK\0"
  pub let tag_max_len_canary : [u8; 15] = "MAX LEN CANARY\0"
  pub let tag_max_len_measured : [u8; 14] = "M8 MAXLINE OK\0"
  // R51 boot-transcript §5 Bug B: strip embedded '\n' from tag payloads.
  // The composer's format layer emits its own newline in step 13, so a
  // '\n' mid-tag splits one logical record across two physical lines
  // (the second landing prefix-less, matching the "COOLING ROW\n\0"
  // exemplar the design memo names).  These three were the last KPTI-
  // suite offenders; their byte counts now match `<text>\0` exactly.
  // R51 Phase C batch 5 (SUBSYS_BOOT shard, boot-transcript.md §3.5):
  // KPTI witness cluster — three sibling OK-token fingerprints asserted
  // by tests/r14b/expected-boot-r14b-kpti.txt:12..14 as whole lines
  // (`KPTI STACKS OK`, `KPTI DESC OK`, `KPTI ISR OK`).  Whole-line OK
  // golden anchors require BYTE-IDENTICAL preservation (memo §5.1 option
  // A), so the three fingerprints stay byte-identical.  ONE narrative
  // line — tag_kpti_narrative — is emitted immediately before the
  // three-line cluster in src/kernel/boot/kernel_main.pdx per memo §3.5
  // ("collapse KPTI OK .. KPTI DESC OK (5 lines) → KPTI: page tables,
  // scratch, stacks, ISR, descriptors ready").  The narrative carries no
  // OK token so verify-fingerprint-coverage.sh's OK_TOK regex ignores
  // it; no new coverage row needed.  The two additional legacy witness
  // lines the memo names (kpti_ok_msg / kpti_scratch_ok_msg) live in
  // tools/boot_stub.S and stay byte-identical there — outside Keys-
  // module scope per batch-4 precedent (commit b10af36).
  pub let tag_kpti_stacks_ok : [u8; 15] = "KPTI STACKS OK\0"
  pub let tag_kpti_desc_ok : [u8; 13] = "KPTI DESC OK\0"
  pub let tag_kpti_isr_ok : [u8; 12] = "KPTI ISR OK\0"
  pub let tag_kpti_narrative : [u8; 59] = "KPTI: page tables, scratch, stacks, ISR, descriptors ready\0"

  // R14b-M5-008 (#661): pf_handle_cow bisection markers (11 tags).
  // Byte counts audited: text_length + 1 (NUL). #699 fabrication trap corrected.
  //
  // R51 Phase C batch 3 (SUBSYS_MM__ shard, design/kernel/boot-transcript.md
  // §3.5): the non-OK bisection markers are rewritten IN-PLACE with an
  // English narrative body plus a bracketed `[legacy: <OLD>]` suffix (memo
  // §5.1 option B).  None of these strings carry an OK token so
  // verify-fingerprint-coverage.sh's OK_TOK regex ignores them, and grep of
  // tests/**/* returns zero hits for any of `PF COW ENTRY`, `PF COW ERR
  // RSVD`, `PF COW ERR P|W`, `PF COW PML4 ABS`, `PF COW PDPT ABS`, `PF COW
  // PD ABS`, `PF COW PT ABS`, `PF COW LEAF RW`, `PF COW LEAF COW`, or `PF
  // COW REFCNT` — so the rewrite is both coverage-neutral and golden-
  // neutral.  The bracketed marker preserves operator grep parity with the
  // pre-R51 wire.  Emit sites in src/kernel/core/mm/pf_handler.pdx are
  // unchanged (tag identifier is stable; only the body it points at grows).
  pub let tag_pf_cow_entry : [u8; 46] = "page-fault COW entered [legacy: PF COW ENTRY]\0"
  pub let tag_pf_cow_err_rsvd_reject : [u8; 69] = "page-fault COW rejected: reserved bits set [legacy: PF COW ERR RSVD]\0"
  pub let tag_pf_cow_err_pw_reject : [u8; 63] = "page-fault COW rejected: not P|W-only [legacy: PF COW ERR P|W]\0"
  pub let tag_pf_cow_pml4_absent : [u8; 64] = "page-fault COW walk: PML4 not present [legacy: PF COW PML4 ABS]\0"
  pub let tag_pf_cow_pdpt_absent : [u8; 64] = "page-fault COW walk: PDPT not present [legacy: PF COW PDPT ABS]\0"
  pub let tag_pf_cow_pd_absent : [u8; 60] = "page-fault COW walk: PD not present [legacy: PF COW PD ABS]\0"
  pub let tag_pf_cow_pt_absent : [u8; 60] = "page-fault COW walk: PT not present [legacy: PF COW PT ABS]\0"
  pub let tag_pf_cow_leaf_rw_reject : [u8; 72] = "page-fault COW rejected: leaf already writable [legacy: PF COW LEAF RW]\0"
  pub let tag_pf_cow_leaf_cow_reject : [u8; 64] = "page-fault COW rejected: leaf not COW [legacy: PF COW LEAF COW]\0"
  pub let tag_pf_cow_refcount_reject : [u8; 71] = "page-fault COW rejected: refcount inconsistent [legacy: PF COW REFCNT]\0"

  // R51 Phase C batch 3: tag_pf_cow_flip_ok kept BYTE-IDENTICAL with the
  // pre-R51 wire.  Golden tests/r14b/expected-boot-r14b-kpti.txt:8 asserts
  // the whole-line `PF COW FLIP OK`, and verify-fingerprint-coverage.sh's
  // OK_TOK covered_by() requires marker.startswith(golden) or vice versa —
  // any bracketed suffix or narrative prefix would break that relationship.
  // A separate narrative tag (tag_pf_cow_flip_ok_narrative) is emitted just
  // before this fingerprint under the same _cow_witness_verbose gate; the
  // two-line pattern mirrors HPET INIT OK from shard 1 (b3db5cb).
  pub let tag_pf_cow_flip_ok : [u8; 15] = "PF COW FLIP OK\0"
  pub let tag_pf_cow_flip_ok_narrative : [u8; 35] = "page-fault COW fast-flip completed\0"

  // R15-M6-002 (#553): pf_handle_cow split-path markers.
  // Split path fires when refcount >= 2 (page has other sharers): allocate a
  // fresh frame, copy 4 KiB, rewrite the leaf PTE, invlpg, decref old frame.
  // Byte counts: text_length + 1 (NUL), audited per #699 discipline.
  //
  // R51 Phase C batch 3: tag_pf_cow_split_ok kept BYTE-IDENTICAL because it
  // is explicitly ALLOWLISTED in tools/verify-fingerprint-coverage.sh (line
  // ~116, rationale: "COW split arm needs a write fault on a refcount>=2
  // frame; no witness writes to a shared frame") — the allowlist stale-
  // check would fire if the string body changed.  Narrative added as a
  // sibling tag (two-line pattern) under the same _cow_witness_verbose
  // gate.  tag_pf_cow_split_alloc_fail carries no OK token and no golden
  // hits so it takes the bracketed-suffix in-place rewrite.
  pub let tag_pf_cow_split_ok : [u8; 16] = "PF COW SPLIT OK\0"
  pub let tag_pf_cow_split_ok_narrative : [u8; 31] = "page-fault COW split completed\0"
  pub let tag_pf_cow_split_alloc_fail : [u8; 66] = "page-fault COW split allocation failed [legacy: PF COW SPLIT OOM]\0"

  // R21-M1 (#825/#826): XSAVE probe + enable fingerprints and keys.
  // Byte counts include trailing NUL per #699 discipline.
  // R51 Phase C batch 5 (SUBSYS_BOOT shard, boot-transcript.md §3.5):
  // three XSAVE fingerprints straddle two sub-strategies.
  //
  //   tag_xsave_probe_ok   — kept BYTE-IDENTICAL because
  //     tests/r21/expected-ymm-preserve.txt:1 asserts the whole-line
  //     `XSAVE PROBE OK` and verify-fingerprint-coverage.sh's OK_TOK
  //     covered_by() requires that byte identity (a bracketed suffix
  //     or narrative prefix would break the startswith relationship in
  //     either direction).  Two-line pattern: xsave_probe_bsp now emits
  //     tag_xsave_probe_narrative first, then the byte-identical
  //     fingerprint (with the mask/size KVs) — same shape as HPET from
  //     shard 1 (b3db5cb) and PAT INIT OK from batch 3.
  //
  //   tag_xsave_enabled    — same two-line pattern; whole-line asserted
  //     by tests/r21/expected-ymm-preserve.txt:2 as `XSAVE ENABLED`.
  //     xsave_enable_this_cpu emits tag_xsave_enable_narrative just
  //     before the byte-identical fingerprint (with the xcr0 KV).
  //
  //   tag_xsave_probe_no_support — no golden hit (grep tests/** returns
  //     zero); no OK token.  In-place bracketed suffix rewrite (memo
  //     §5.1 option B).  Coverage- and golden-neutral.  Body byte count
  //     grew; tag identifier and emit site (xsave.pdx) are unchanged.
  //
  // Narratives carry no OK token so verify-fingerprint-coverage.sh's
  // OK_TOK regex ignores them; no new coverage row is needed.
  pub let tag_xsave_probe_ok : [u8; 15] = "XSAVE PROBE OK\0"
  pub let tag_xsave_probe_narrative : [u8; 35] = "XSAVE CPUID probe: XCR0 target set\0"
  pub let tag_xsave_probe_no_support : [u8; 56] = "XSAVE CPU support absent [legacy: XSAVE NO CPU SUPPORT]\0"
  pub let tag_xsave_enabled : [u8; 14] = "XSAVE ENABLED\0"
  pub let tag_xsave_enable_narrative : [u8; 37] = "XSAVE enabled on this CPU (BSP init)\0"
  // R51 batch 5 note: tag_ymm_preserve_{a,b}_ok and tag_ymm_preserve_fail
  // are declaration-only in this file; their sole emit sites live under
  // tests/kernel/cpu/ymm_preserve.pdx which the batch-4 precedent
  // (design/kernel/boot-transcript.md §5, and commit b10af36 shard
  // report) classifies as out of the Keys-module rewrite scope for
  // R51 Phase C — deferred as an out-of-scope follow-up.  The tags
  // stay byte-identical, keeping the r21/expected-ymm-preserve.txt
  // whole-line golden anchors on `YMM PRESERVE A OK` and
  // `YMM PRESERVE B OK` unchanged.
  pub let k_mask : [u8; 5] = "mask\0"
  pub let k_size : [u8; 5] = "size\0"
  pub let k_xcr0 : [u8; 5] = "xcr0\0"

  // R21-M2 (#830/#831): AVX2 / AVX-512 CPU-feature-bit fingerprints.
