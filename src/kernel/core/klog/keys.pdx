  // Byte counts NUL-inclusive per #699 discipline:
  //   tag_boot_udp_sock_ok -- 19 chars + NUL = 20
  //   k_port_a             --  6 chars + NUL = 7
  //   k_port_b             --  6 chars + NUL = 7
  pub let tag_boot_udp_sock_ok : [u8; 20] = "boot udp sock ok --\0"
  pub let k_port_a             : [u8; 7]  = "port_a\0"
  pub let k_port_b             : [u8; 7]  = "port_b\0"

  // paideia-os #2004 (R65v2-exposed sys_mkdir silent-fail): tmpfs_create
  // failure/diagnostic fingerprints.
  //
  //   tag_tmpfs_create_fail  — emitted from src/kernel/core/fs/tmpfs/create.
  //     pdx tmpfs_create_fail_emit whenever tmpfs_create is about to return
  //     0.  Carries a single decimal KV `reason=<code>` where the code
  //     names the failure arm: 1 = parent-not-dir, 2 = name collision,
  //     3 = inode-pool OOM (TMPFS_INODE_ALLOC_OOM).  Turns the previously-
  //     silent 'tmpfs_create returned 0' three-way ambiguity into a loud,
  //     distinguishable serial line so the next occurrence of this class
  //     of bug (R65v2 mkdir /home → SYS_MKDIR_ERR_EIO with no kernel-side
  //     signal on the wire, filed as paideia-os #2004) fingerprints
  //     itself immediately.  Contains FAIL (not OK) per verify-fingerprint-
  //     coverage.sh's OK_TOK regex convention — not a tracked marker; it is
  //     an operator diagnostic aid, and asserting it in a golden would
  //     invert the FAIL/OK distinction the coverage gate depends on.
  //
  //   tag_tmpfs_inode_count  — emitted from src/kernel/boot/kernel_main.pdx
  //     boot_continue_after_ring3 immediately after each of the two kernel-
  //     side tmpfs seed batches (witness_bin_seeds and witness_rootfs_dir_
  //     seeds).  Carries a single decimal KV `count=<N>` where N is
  //     tmpfs_inode_alloc_count()'s return (allocated-slot count with the
  //     slot-0 sentinel subtracted).  Snapshots pool-consumption pressure
  //     at each boot-time seed checkpoint so a future rise toward
  //     TMPFS_MAX=256 is visible on the serial log before it re-runs the
  //     R65v2 silent-mkdir-fail regression at a larger seed inventory.
  //     Lowercase "count --" (no OK token per verify-fingerprint-coverage.
  //     sh's OK_TOK regex) — matches tag_rfs_dir_seeds_ok's own untracked
  //     shape; no golden update is required.
  //
  // k_reason and k_count are REUSED from earlier blocks in this file (the
  // R51 IOMMU shard and the R24 NVMe shard respectively).
  //
  // Byte counts NUL-inclusive per #699:
  //   tag_tmpfs_create_fail    -- 45 chars + NUL = 46
  //   tag_tmpfs_inode_count    -- 26 chars + NUL = 27
  pub let tag_tmpfs_create_fail : [u8; 46] = "tmpfs create fail [legacy: TMPFS CREATE FAIL]\0"
  pub let tag_tmpfs_inode_count : [u8; 27] = "tmpfs inode alloc count --\0"

  // R100-PREP-003 (paideia-os #2009): sys_icmp_echo + boot witness
  // fingerprints. sys_icmp_echo_body (syscall/handlers/sys_icmp_echo.pdx)
  // emits `sys icmp echo ok [legacy: SYS ICMP ECHO OK] -- rtt_ns=<n>`
  // via klog_s1_d1(SUBSYS_NET_, tag_sys_icmp_echo_ok, k_rtt_ns, rtt_ns)
  // on every successful call. The paired boot witness at
  // src/kernel/boot/witness/r100_prep_003_icmp_echo.pdx emits
  // `boot icmp echo ok -- [legacy: BOOT ICMP ECHO OK] rtt_ns=<n>` via
  // the same wrapper. Both carry standalone uppercase OK tokens in
  // their legacy-alias suffix, so both need a golden line or an
  // allowlist entry -- allowlist entries land in
  // tools/verify-fingerprint-coverage.sh (mirroring the R73 sys_kill
  // precedent, since no boot mode's expected-log golden asserts a
  // networked-syscall line at this landing).
  //
  // Byte counts NUL-inclusive per #699 discipline:
  //   tag_sys_icmp_echo_ok  -- 43 chars + NUL = 44.
  //   tag_boot_icmp_echo_ok -- 48 chars + NUL = 49.
  //   k_rtt_ns              --  6 chars + NUL = 7.
  pub let tag_sys_icmp_echo_ok  : [u8; 44] = "sys icmp echo ok [legacy: SYS ICMP ECHO OK]\0"
  pub let tag_boot_icmp_echo_ok : [u8; 49] = "boot icmp echo ok -- [legacy: BOOT ICMP ECHO OK]\0"
  pub let k_rtt_ns              : [u8; 7]  = "rtt_ns\0"

  // R90-XREPO.011.M1-001 (paideia-os #2117): kernel-side sched_wait /
  // sched_wake_kind primitive fingerprints. Both are emitted from inside
  // the primitive itself (src/kernel/core/sched/wait.pdx) rather than
  // from a boot witness -- the parent-issue text names a two-thread
  // park/notify witness that lands with the sibling elevate-broker
  // dispatch-loop milestone (R90-XREPO.011.M1-003), which is the first
  // real consumer of the primitive.
  //
  //   tag_sched_wait_ok -- emitted at sched_wait entry, after the wait-
  //     key (kind, obj) pair is stored in the caller's TCB and before
  //     the sched_block self-suspend fires. Rendered line:
  //     `sched wait ok [legacy: SCHED WAIT OK] -- kind=<n>` via
  //     klog_s1_d1(LEVEL_INFO, SUBSYS_SCHD, tag_sched_wait_ok,
  //                k_kind, kind).
  //   tag_sched_wake_ok -- emitted at sched_wake_kind exit, ONCE per
  //     call, iff at least one waiter was actually woken (a call that
  //     matches no waiter emits nothing so a busy notify loop cannot
  //     flood the ring). Rendered line:
  //     `sched wake ok [legacy: SCHED WAKE OK] -- kind=<n>` via
  //     klog_s1_d1(LEVEL_INFO, SUBSYS_SCHD, tag_sched_wake_ok,
  //                k_kind, kind).
  //
  // Both tags contain a standalone uppercase OK token inside their
  // bracketed legacy-alias suffix, so tools/verify-fingerprint-coverage.
  // sh demands either a golden line or an allowlist entry. Allowlist
  // entries land alongside this declaration (see that file's Section A
  // block for `sched wait ok` / `sched wake ok`) with the reason "no
  // kernel-side witness spawns a park/notify pair yet -- assertable
  // when the elevate-broker dispatch loop lands (R90-XREPO.011.M1-003)".
  //
  // Byte counts NUL-inclusive per #699 discipline:
  //   tag_sched_wait_ok -- 37 chars + NUL = 38.
  //   tag_sched_wake_ok -- 37 chars + NUL = 38.
  //   k_kind            --  4 chars + NUL = 5.
  pub let tag_sched_wait_ok : [u8; 38] = "sched wait ok [legacy: SCHED WAIT OK]\0"
  pub let tag_sched_wake_ok : [u8; 38] = "sched wake ok [legacy: SCHED WAKE OK]\0"
  pub let k_kind            : [u8; 5]  = "kind\0"

  // R90-XREPO.011.M1-003 (paideia-os #2122): elevate-broker real
  // dispatch body fingerprints. Emitted from within
  // elevate_broker_serve_one (src/kernel/core/ipc/elevate_broker.pdx)
  // once policy evaluation lands on ALLOW or DENY, so the boot witness
  // and any future golden can distinguish an approved elevation from
  // a fail-closed refusal without inspecting the row's state byte
  // through a query op. Third tag (`boot elevate broker ok`) is the
  // witness's own success rollup emitted from
  // src/kernel/boot/witness/elevate_broker_dispatch.pdx.
  //
  // All three carry a standalone uppercase OK token inside their
  // bracketed legacy-alias suffix so tools/verify-fingerprint-coverage.
  // sh sees them; allowlist entries land alongside this declaration
  // (see that file's Section A block) because no golden file asserts
  // the exact lines yet -- the witness's own passing is the assertable
  // signal for this code path today, same posture the sibling
  // tag_elvc_expire_set_ok / tag_sched_wait_ok entries already take.
  //
  // Byte counts NUL-inclusive per #699 discipline:
  //   tag_elvb_allow_ok       -- 57 chars + NUL = 58.
  //   tag_elvb_deny_ok        -- 55 chars + NUL = 56.
  //   tag_boot_elvb_ok        -- 55 chars + NUL = 56.
  //   k_row                    -- already declared elsewhere; reused.
  //   k_pid                    -- already declared above; reused.
  //   k_decision (new)         --  8 chars + NUL = 9.
  pub let tag_elvb_allow_ok : [u8; 58] = "elevate broker allow ok [legacy: ELEVATE BROKER ALLOW OK]\0"
  pub let tag_elvb_deny_ok  : [u8; 56] = "elevate broker deny ok [legacy: ELEVATE BROKER DENY OK]\0"
  pub let tag_boot_elvb_ok  : [u8; 56] = "boot elevate broker ok [legacy: BOOT ELEVATE BROKER OK]\0"
  pub let k_decision        : [u8; 9]  = "decision\0"

  // R90-XREPO.010.M1-003 (paideia-os #2111): sys_pdxfs_txn_commit +
  // sys_pdxfs_txn_abort + boot-witness fingerprints. Both syscall bodies
  // emit their fingerprint from the OK path only (matches every other
  // sys_* handler's "OK path only" discipline -- the -EBADF and
  // sentinel-forward arms do not emit). The boot witness at
  // src/kernel/boot/witness/r90_xrepo_010_003_pdxfs_txn_lifecycle.pdx
  // opens two txns against a synthetic KIND_MEMORY parent, commits the
  // first and aborts the second, verifies each row's state advanced to
  // COMMITTED (2) / ABORTED (3), and emits a single rollup fingerprint
  // covering both scenarios.
  //
  // All three tags carry a standalone uppercase OK token inside their
  // bracketed legacy-alias suffix, so tools/verify-fingerprint-coverage.
  // sh demands either a golden line or an allowlist entry -- allowlist
  // entries land in tools/verify-fingerprint-coverage.sh alongside the
  // R73 `sys kill ok` / R100-PREP-003 `sys icmp echo ok` precedents
  // (kernel path live at every boot, no golden asserts the line yet).
  //
  // k_txn is the transaction row_id in [0, PXT_MAX = 16). It is distinct
  // from k_slot (a cap_table slot 0..255) because the two are read very
  // differently: k_slot names where in the calling task's cap_table the
  // KIND_PDXFS_TXN descriptor lives, while k_txn names which pdxfs
  // transaction row underneath the descriptor was mutated. The syscall
  // body resolves cap_slot -> row_id via pdxfs_txn_row_of_slot before
  // emitting, so a fingerprint reader who wants to correlate against
  // the PXT_ST_COMMITS / PXT_ST_ABORTS bumps in _pdxfs_txn_stats sees
  // the same row_id in both places.
  //
  // Byte counts NUL-inclusive per #699 discipline:
  //   tag_sys_pdxfs_txn_commit_ok  -- 57 chars + NUL = 58.
  //   tag_sys_pdxfs_txn_abort_ok   -- 55 chars + NUL = 56.
  //   tag_boot_pdxfs_txn_lc_ok     -- 65 chars + NUL = 66.
  //   k_txn                        --  3 chars + NUL =  4.
  pub let tag_sys_pdxfs_txn_commit_ok : [u8; 58] = "sys pdxfs txn commit ok [legacy: SYS PDXFS TXN COMMIT OK]\0"
  pub let tag_sys_pdxfs_txn_abort_ok  : [u8; 56] = "sys pdxfs txn abort ok [legacy: SYS PDXFS TXN ABORT OK]\0"
  pub let tag_boot_pdxfs_txn_lc_ok    : [u8; 66] = "boot pdxfs txn lifecycle ok [legacy: BOOT PDXFS TXN LIFECYCLE OK]\0"
  pub let k_txn                       : [u8; 4]  = "txn\0"

  // R90-XREPO.010.M1-002 (paideia-os #2110): sys_pdxfs_stat_by_inode
  // + boot-witness fingerprints. The syscall body emits its
  // fingerprint from the OK path only (matches every other sys_*
  // handler's "OK path only" discipline -- the -EFAULT and -ENOENT
  // arms do not emit). The boot witness at src/kernel/boot/witness/
  // r90_xrepo_010_002_stat_by_inode.pdx seeds a fresh tmpfs file
  // (/tmp/statseed, 16 bytes), calls the scratch_fill helper
  // directly (bypassing user_ptr_ok since a boot witness has no
  // user-half address to hand it), asserts mode_bits / size / mtime
  // in the populated record, and emits a single rollup fingerprint.
  //
  // Both tags carry a standalone uppercase OK token inside their
  // bracketed legacy-alias suffix, so tools/verify-fingerprint-
  // coverage.sh demands either a golden line or an allowlist entry
  // -- allowlist entries land alongside the R90-XREPO.010.M1-003
  // txn lifecycle entries above (kernel path live at every boot, no
  // golden asserts the line yet).
  //
  // k_ino / k_size reuse the existing declarations at L966 / L345 --
  // no new klog keys are needed for this landing since the
  // fingerprint contract carries only the two decimal K/V pairs
  // ino=<n> size=<n>. A future landing that adds mode_bits or
  // mtime_ns to the fingerprint stream would introduce k_mode /
  // k_mtime here.
  //
  // Byte counts NUL-inclusive per #699 discipline:
  //   tag_sys_pdxfs_stat_by_inode_ok  -- 63 chars + NUL = 64.
  //   tag_boot_pdxfs_stat_ok          -- 21 chars + NUL = 22 (all-
  //     lowercase, no bracketed legacy-alias suffix -- matches the
  //     boot_pfrb_ok precedent one milestone up so verify-fingerprint
  //     -coverage.sh's OK_TOK extractor does not gate on it and no
  //     allowlist entry is needed for the boot rollup line).
  pub let tag_sys_pdxfs_stat_by_inode_ok : [u8; 64] = "sys pdxfs stat by inode ok [legacy: SYS PDXFS STAT BY INODE OK]\0"
  pub let tag_boot_pdxfs_stat_ok         : [u8; 22] = "boot pdxfs stat ok --\0"

  // R90-XREPO.010.M1-004 (paideia-os #2112): sys_pdxfs_undo_write
  // (sysno 107) + the abort-side undo-replay hook + boot-witness
  // fingerprints.  Three OK-token tags total:
  //
  //   tag_sys_pdxfs_undo_write_ok    -- emitted by sys_pdxfs_undo_write_
  //     body on the OK path only, decimal KVs (txn=<row>, len=<n>).
  //     `len=` is the snapshot byte-count the caller staged; `txn=` is
  //     the row_id resolved from cap_slot via pdxfs_txn_row_of_slot.
  //   tag_sys_pdxfs_undo_replay_ok   -- emitted by sys_pdxfs_txn_abort_
  //     body AFTER the OPEN -> ABORTED transition succeeds and the
  //     row's undo records have been replayed, decimal KVs
  //     (txn=<row>, entries=<n>).  A row with no records emits
  //     entries=0; the fingerprint is still emitted so a caller can
  //     always correlate the txn-abort fingerprint stream with a
  //     matching replay-completion line.
  //   tag_boot_pdxfs_undo_ok         -- boot witness rollup fingerprint,
  //     all-lowercase (no bracketed legacy alias) so verify-fingerprint-
  //     coverage.sh's OK_TOK extractor does not gate on it (mirrors the
  //     tag_boot_pdxfs_stat_ok / tag_boot_pfrb_ok precedent one
  //     milestone up).
  //
  // k_txn / k_len / k_entries are all REUSED from earlier blocks in
  // this file (L1591 / L48 / L1164 respectively) -- no new klog keys
  // are minted for this landing.
  //
  // Byte counts NUL-inclusive per #699 discipline:
  //   tag_sys_pdxfs_undo_write_ok    -- 57 chars + NUL = 58.
  //   tag_sys_pdxfs_undo_replay_ok   -- 59 chars + NUL = 60.
  //   tag_boot_pdxfs_undo_ok         -- 21 chars + NUL = 22.
  pub let tag_sys_pdxfs_undo_write_ok  : [u8; 58] = "sys pdxfs undo write ok [legacy: SYS PDXFS UNDO WRITE OK]\0"
  pub let tag_sys_pdxfs_undo_replay_ok : [u8; 60] = "sys pdxfs undo replay ok [legacy: SYS PDXFS UNDO REPLAY OK]\0"
  pub let tag_boot_pdxfs_undo_ok       : [u8; 22] = "boot pdxfs undo ok --\0"

  // R90-XREPO.010.M1-005 (paideia-os #2113): sys_pdxfs_fault_inject
  // (sysno 527) + PdxFS fault-injection substrate fingerprints.
  // Three tags total, NONE of which carries a standalone uppercase OK
  // token (both "ARMED" and "FIRED" are class-labels for the fault
  // switchboard, and the boot rollup is all-lowercase like the M1-002 /
  // M1-004 rollup precedents).  So tools/verify-fingerprint-coverage.sh
  // does NOT gate on any of the three -- no allowlist entries needed.
  //
  //   tag_sys_pdxfs_fault_inject_armed  -- emitted by sys_pdxfs_fault_
  //     inject_body on the OK path only (both arm and disarm; the class
  //     value in the fingerprint distinguishes them).  Decimal KV
  //     (class=<n>) where n in [0, 4].
  //   tag_sys_pdxfs_fault_fired         -- emitted by pdxfs_fault_check_
  //     and_consume when a matched arm fires; carries the class value.
  //   tag_boot_pdxfs_fault_inject_ok    -- boot witness rollup, all-
  //     lowercase (mirrors tag_boot_pdxfs_undo_ok / tag_boot_pdxfs_stat_
  //     ok precedents one milestone up).
  //
  // k_class is REUSED from the R30 platform block above (line 488) --
  // no new klog keys are minted for this landing.
  //
  // Byte counts NUL-inclusive per #699 discipline:
  //   tag_sys_pdxfs_fault_inject_armed  -- 67 chars + NUL = 68.
  //   tag_sys_pdxfs_fault_fired         -- 53 chars + NUL = 54.
  //   tag_boot_pdxfs_fault_inject_ok    -- 29 chars + NUL = 30.
  pub let tag_sys_pdxfs_fault_inject_armed : [u8; 68] = "sys pdxfs fault inject armed [legacy: SYS PDXFS FAULT INJECT ARMED]\0"
  pub let tag_sys_pdxfs_fault_fired        : [u8; 54] = "sys pdxfs fault fired [legacy: SYS PDXFS FAULT FIRED]\0"
  pub let tag_boot_pdxfs_fault_inject_ok   : [u8; 30] = "boot pdxfs fault inject ok --\0"
}
