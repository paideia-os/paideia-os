  // R29.M4-004 (#1035): blob-driver signature telemetry. Three tags
  // rather than one, selected by the combined verdict, so an operator
  // can grep the audit log for BLOB SIG REJECT alone — the line that
  // means a firmware blob failed its dual-signature check — without
  // matching the routine scaffold-epoch traffic. Byte counts
  // NUL-inclusive per #699 discipline.
  //   k_verdict                 8 = "verdict" + NUL
  //   k_gate                    5 = "gate"    + NUL
  //   tag_blob_sig_ok          12 = "BLOB SIG OK"       + NUL
  //   tag_blob_sig_unsigned    18 = "BLOB SIG UNSIGNED" + NUL
  //   tag_blob_sig_reject      16 = "BLOB SIG REJECT"   + NUL
  pub let k_verdict                 : [u8; 8]  = "verdict\0"
  pub let k_gate                    : [u8; 5]  = "gate\0"
  pub let tag_blob_sig_ok           : [u8; 12] = "BLOB SIG OK\0"
  pub let tag_blob_sig_unsigned     : [u8; 18] = "BLOB SIG UNSIGNED\0"
  pub let tag_blob_sig_reject       : [u8; 16] = "BLOB SIG REJECT\0"

  // R51 Phase C (SUBSYS_DRIVER shard, boot-transcript.md §7): verdict-
  // agnostic English narrative emitted once per blob_sig_audit call, right
  // before the classified `BLOB SIG {OK,UNSIGNED,REJECT}` fingerprint.
  // Two-line strategy (§5.1 option A) rather than a bracketed suffix on
  // the three verdict tags because `BLOB SIG OK` is allowlisted in
  // tools/verify-fingerprint-coverage.sh (rationale: "emitted only for
  // verdict==0; no boot fixture is validly signed under R25.M5 dev-bypass
  // keyring; needs R32"), and the allowlist matches by exact string —
  // rewriting the tag body would break the allowlist entry, and touching
  // verify-scripts is out of scope for this shard.  Keeping the three
  // verdict tags byte-identical preserves both the allowlist entry and
  // the OK-token coverage relationship for `BLOB SIG OK` unchanged.
  // The narrative body carries no OK token so verify-fingerprint-coverage's
  // OK_TOK regex skips it; the narrative fires at the same level as the
  // classified fingerprint (WARN for UNSIGNED, ERROR for REJECT, INFO for
  // OK) so runtime level filtering does not silently drop it.
  pub let tag_blob_sig_narrative    : [u8; 37] = "driver blob signature audit recorded\0"

  // boot-mmio-mapping step 2 (design/kernel/boot-mmio-mapping.md).
  // Emitted by platform_map_early_mmio after the three firmware-fixed
  // MMIO windows (HPET / xAPIC / IOAPIC) have been passed through
  // platform_mmio_map. The N=<count> KV names how many mappings the
  // manifest walk installed (0..3 at this step; grows as MCFG and other
  // rows land in step 5+). Byte count NUL-inclusive per #699 discipline.
  //   tag_platform_mmio_early_ok 23 = "PLATFORM MMIO EARLY OK" + NUL
  //
  // R51 Phase C batch 3 (SUBSYS_MM__ shard, boot-transcript.md §3.5):
  // tag_platform_mmio_early_ok kept BYTE-IDENTICAL because tests/r17/
  // shell-shutdown.golden:3 asserts the whole-line `PLATFORM MMIO EARLY OK`
  // and OK_TOK coverage requires that byte identity.  Two-line pattern:
  // platform_map_early_mmio now emits tag_platform_mmio_early_narrative
  // first, then this fingerprint (with the count KV) — same shape as HPET
  // from shard 1 (b3db5cb).  Narrative has no OK token so OK_TOK skips it.
  pub let tag_platform_mmio_early_ok : [u8; 23] = "PLATFORM MMIO EARLY OK\0"
  pub let tag_platform_mmio_early_narrative : [u8; 29] = "platform MMIO windows mapped\0"

  // boot-mmio-mapping step 5 (design/kernel/boot-mmio-mapping.md §3 step 5).
  // Emitted by platform_map_mcfg_segments after the ACPI-discovered PCIe
  // ECAM windows in Mcfg._mcfg_segments have been passed through
  // platform_mmio_map. The N=<count> KV names how many segments were
  // mapped successfully (0.._mcfg_count). Under `qemu -kernel` PVH boot
  // where phase1_acpi_gather yields _mcfg_count=0, the fingerprint reports
  // N=0 cleanly. Byte count NUL-inclusive per #699 discipline.
  //   tag_mcfg_mapped           12 = "MCFG MAPPED" + NUL
  //
  // R51 Phase C batch 3 (SUBSYS_MM__ shard, boot-transcript.md §3.5):
  // tag_mcfg_mapped renamed in place with bracketed legacy suffix (memo
  // §5.1 option B).  No OK token in the string and grep tests/** returns
  // zero hits, so the rewrite is coverage-neutral and golden-neutral.  The
  // bracketed marker preserves operator grep parity with the pre-R51 wire.
  // Emit site in src/kernel/boot/mcfg_map.pdx is unchanged (tag identifier
  // stable; only the body grows).  The trailing k_n=<count> KV still lands
  // after the closing `]` on the wire — readable as `PCIe ECAM segments
  // mapped [legacy: MCFG MAPPED] n=0` under `qemu -kernel`.
  pub let tag_mcfg_mapped            : [u8; 48] = "PCIe ECAM segments mapped [legacy: MCFG MAPPED]\0"

  // R51 Phase C batch 4 (SUBSYS_USER shard, boot-transcript.md §3.5):
  // English narrative tags emitted just BEFORE the byte-identical
  // fingerprint banner in each of the three user-substrate smokes:
  //   src/kernel/core/user/first_boot_smoke.pdx   -> FIRST BOOT SMOKE OK
  //   src/kernel/core/user/user_supervisor_smoke.pdx -> USER SUPERVISOR SMOKE OK
  //   src/kernel/core/user/elevate_smoke.pdx      -> ELEVATE SMOKE OK
  //
  // The three OK banners are asserted whole-line by tests/r17/
  // shell-shutdown.golden lines 461-463 and are scanned by
  // verify-fingerprint-coverage.sh's OK_TOK regex.  A bracketed suffix on
  // those banners would introduce a `]` between the OK token and its
  // whole-line golden anchor and break covered_by()'s
  // marker.startswith(golden) relationship; the two-line pattern from the
  // IPC / KPTI / HPET shards is used instead — the narrative line prints
  // first, the byte-identical fingerprint prints second, and the golden
  // still substring-matches the fingerprint line unchanged.  Narratives
  // carry no OK token so verify-fingerprint-coverage.sh's OK_TOK scan
  // ignores them; no new coverage row is needed for this shard.
  pub let tag_fbs_narrative : [u8; 37] = "first-boot provisioning smoke passed\0"
  pub let tag_uss_narrative : [u8; 29] = "user supervisor smoke passed\0"
  pub let tag_els_narrative : [u8; 28] = "elevate policy smoke passed\0"

  // R54.M1-002 (#1779): bdev_write real submit path over nvme_write_blocking.
  //
  // Fingerprint emitted from bdev_write.pdx nvw_batch_flush() at the end of
  // each productive flush (newly-submitted > 0). Two-line strategy is NOT
  // used: the R51 Phase C option-B bracketed legacy suffix is folded into
  // the single tag string so the wire carries both the R51 narrative form
  // (`pdxb bdev flush ok`) and the historic operator grep marker (`BDEV
  // FLUSH OK`) in one line, followed by the composer-appended k=v pairs:
  //
  //   wire: pdxb bdev flush ok [legacy: BDEV FLUSH OK] pending=0x<n> submitted=0x<m>
  //
  // The tag DOES contain an OK token by verify-fingerprint-coverage.sh's
  // regex (`space OK ]` -- both delimiters are non-alnum), and coverage
  // is satisfied by tests/r54/expected-r54-bdev-flush.txt whose line 2
  // is the whole-tag substring `pdxb bdev flush ok [legacy: BDEV FLUSH
  // OK]` (covered_by() accepts marker.startswith(a) OR a.startswith(marker),
  // and a == marker matches both).  Byte count NUL-inclusive: 42 chars +
  // NUL = 43.
  pub let tag_pdxb_bdev_flush_ok : [u8; 43] = "pdxb bdev flush ok [legacy: BDEV FLUSH OK]\0"
  pub let k_pending              : [u8; 8]  = "pending\0"
  pub let k_submitted            : [u8; 10] = "submitted\0"

  // R54.M1-003 (#1780): bdev NVMe-block payload round-trip witness.
  //
  // Two fingerprints, one per phase of the two-phase round-trip smoke
  // (tools/run-smoke.sh boot_r54_bdev_round_trip_phase{1,2} + meta-mode
  // boot_r54_bdev_round_trip). Emitted from r54_bdev_round_trip.pdx via
  // klog_s1 (0 KV entries -- lba, payload, and match are hardcoded in
  // the tag itself since each fingerprint pins one specific triple).
  //
  //   wire (phase 1):
  //     pdxb bdev round-trip write ok - lba=16 payload=deadbeefcafebabe
  //     [legacy: PDXB BDEV WROTE OK]
  //
  //   wire (phase 2):
  //     pdxb bdev round-trip readback ok - lba=16 match=1
  //     [legacy: PDXB BDEV READBACK OK]
  //
  // Both tags DO contain an OK token by verify-fingerprint-coverage.sh's
  // OK_TOK regex (`space OK ]` -- both delimiters non-alnum). Coverage
  // rows land in tests/r54/expected-r54-bdev-round-trip-phase{1,2}.txt
  // as the whole-tag substring (contains-in-order match).
  //
  // Byte counts NUL-inclusive:
  //   tag_pdxb_bdev_rt_write_ok    -- 94 chars (em-dash is 3 UTF-8
  //                                    bytes) + NUL = 95.
  //   tag_pdxb_bdev_rt_readback_ok -- 83 chars (em-dash is 3 UTF-8
  //                                    bytes) + NUL = 84.
  pub let tag_pdxb_bdev_rt_write_ok    : [u8; 95] = "pdxb bdev round-trip write ok — lba=16 payload=deadbeefcafebabe [legacy: PDXB BDEV WROTE OK]\0"
  pub let tag_pdxb_bdev_rt_readback_ok : [u8; 84] = "pdxb bdev round-trip readback ok — lba=16 match=1 [legacy: PDXB BDEV READBACK OK]\0"

  // R55.M2-001 (#1783): pdxfs-block allocator extent-run fingerprint.
  //
  // Fingerprint emitted from allocator.pdx alloc_extent_run() at the end of
  // each successful extent-run allocation (bit-run set + durable bitmap
  // writeback both succeeded). Same two-in-one strategy as R54.M1-002's
  // tag_pdxb_bdev_flush_ok: the R51 Phase C option-B bracketed legacy suffix
  // is folded into the single tag string so the wire carries both the R51
  // narrative form (`pdxb alloc ok`) and the historic operator grep marker
  // (`PDXB ALLOC OK`) in one line, followed by the composer-appended k=v
  // pairs:
  //
  //   wire: pdxb alloc ok [legacy: PDXB ALLOC OK] start_lba=0x0000000000000200 len_lba=0x0000000000000004
  //
  // The tag DOES contain an OK token per verify-fingerprint-coverage.sh's
  // regex (`space OK ]` — both delimiters non-alnum); coverage row lands in
  // tests/r55/expected-r55-alloc.txt as the whole-tag substring `pdxb alloc
  // ok [legacy: PDXB ALLOC OK]` (contains-in-order match).
  //
  // A companion verify-post-condition tag fires immediately after when
  // alloc_extent_run's own re-read of the returned run confirms every bit
  // in [start_lba, start_lba + len_lba) reads back as SET. Same tag shape.
  //
  //   wire: pdxb alloc verify ok [legacy: PDXB ALLOC VERIFY OK] start_lba=0x0000000000000200 len_lba=0x0000000000000004
  //
  // Byte counts NUL-inclusive:
  //   tag_pdxb_alloc_ok        -- 37 chars (no em-dash) + NUL = 38.
  //   tag_pdxb_alloc_verify_ok -- 51 chars (no em-dash) + NUL = 52.
  //   k_start_lba              -- 9 chars + NUL = 10.
  //   k_len_lba                -- 7 chars + NUL = 8.
  pub let tag_pdxb_alloc_ok        : [u8; 38] = "pdxb alloc ok [legacy: PDXB ALLOC OK]\0"
  pub let tag_pdxb_alloc_verify_ok : [u8; 52] = "pdxb alloc verify ok [legacy: PDXB ALLOC VERIFY OK]\0"
  pub let k_start_lba              : [u8; 10] = "start_lba\0"
  pub let k_len_lba                : [u8; 8]  = "len_lba\0"

  // R55.M2-002 (#1784): pdxfs-block inode-table writeback fingerprint.
  //
  // Fingerprint emitted from inode_table.pdx inode_table_write() at the
  // end of each successful read-modify-write of the 4-KiB inode-table
  // block that contains ino's 128-B slot. Same two-in-one bracketed
  // legacy-suffix shape R54.M1-002 / R55.M2-001 already use in this
  // file family; the wire carries both the R51 narrative form
  // (`pdxb inode write ok`) and the historic operator grep marker
  // (`PDXB INODE WRITE OK`) in a single line, followed by the
  // composer-appended k=v pairs (ino + size):
  //
  //   wire: pdxb inode write ok [legacy: PDXB INODE WRITE OK] ino=0x0000000000000002 size=0x000000000000000d
  //
  // The tag DOES contain an OK token per verify-fingerprint-coverage.sh's
  // regex (`space OK ]` — both delimiters non-alnum); coverage row lands
  // in tests/r55/expected-r55-inode-write.txt as the whole-tag substring
  // `pdxb inode write ok [legacy: PDXB INODE WRITE OK]` (contains-in-
  // order match).
  //
  // k_size is REUSED from the R21 batch-4 XSAVE fingerprint block above
  // (line 338 -- "size\0", [u8; 5]); it is a plain generic key with no
  // XSAVE-specific semantics baked in and is the natural spelling for
  // the inode's byte_len field. Adding a second `k_size` would violate
  // the module's one-symbol-per-key discipline and force a per-caller
  // disambiguation prefix nothing else in this file uses.
  //
  // Byte counts NUL-inclusive:
  //   tag_pdxb_inode_write_ok  -- 49 chars (no em-dash) + NUL = 50.
  //   k_ino                    -- 3 chars + NUL = 4.
  pub let tag_pdxb_inode_write_ok : [u8; 50] = "pdxb inode write ok [legacy: PDXB INODE WRITE OK]\0"
  pub let k_ino                   : [u8; 4]  = "ino\0"

  // R55.M2-003 (#1785): pdxfs-block WAL append + fsync fingerprint.
  //
  // Fingerprint emitted from wal.pdx wal_fsync_bdev() at the end of each
  // successful WAL flush over bdev_write_at (#1784) --- the WAL-fsync-
  // before-data-write barrier bdev_write.pdx §0 explicitly refuses to
  // enforce itself. Two-in-one bracketed legacy-suffix shape identical
  // to R54.M1-002 / R55.M2-001 / R55.M2-002 (`tag_pdxb_bdev_flush_ok` /
  // `tag_pdxb_alloc_ok` / `tag_pdxb_inode_write_ok`) so the wire carries
  // both the R51 narrative form (`pdxb wal fsynced`) and the historic
  // operator grep marker (`PDXB WAL OK`) in a single line, followed by
  // the composer-appended k=v pairs (records + lba):
  //
  //   wire: pdxb wal fsynced [legacy: PDXB WAL OK] records=0x0000000000000001 lba=0x0000000000000040
  //
  // The tag DOES contain an OK token per verify-fingerprint-coverage.sh's
  // regex (`space OK ]` --- both delimiters non-alnum); coverage row
  // lands in tests/r55/expected-r55-wal-fsync.txt as the whole-tag
  // substring `pdxb wal fsynced [legacy: PDXB WAL OK]` (contains-in-
  // order match).
  //
  // Emitted exactly once per successful wal_fsync_bdev call (not per
  // wal_append_write --- the append side is silent on the wire, matching
  // the pdxb allocator's per-run-only emit posture rather than the
  // NVMe SQ scaffold's per-flush emit).
  //
  // Byte counts NUL-inclusive:
  //   tag_pdxb_wal_fsynced_ok -- 38 chars (no em-dash) + NUL = 39.
  //   k_records                -- 7 chars + NUL = 8.
  //   k_lba                    -- 3 chars + NUL = 4.
  pub let tag_pdxb_wal_fsynced_ok : [u8; 39] = "pdxb wal fsynced [legacy: PDXB WAL OK]\0"
  pub let k_records               : [u8; 8]  = "records\0"
  pub let k_lba                   : [u8; 4]  = "lba\0"

  // R55.M2-004 (#1786): pdxfs-block composed end-to-end write fingerprint.
  //
  // Fingerprint emitted from cow_write.pdx pdxfs_block_write() at the end
  // of each successful composed write. Same two-in-one bracketed
  // legacy-suffix shape R54.M1-002 / R55.M2-001 / R55.M2-002 / R55.M2-003
  // already use in this file family; the wire carries both the R51
  // narrative form (`pdxb write ok`) and the historic operator grep
  // marker (`PDXB WRITE OK`) in a single line, followed by the
  // composer-appended k=v pairs (ino + offset + len):
  //
  //   wire: pdxb write ok [legacy: PDXB WRITE OK] ino=0x0000000000000002 offset=0x0000000000000000 len=0x000000000000000d
  //
  // The tag DOES contain an OK token per verify-fingerprint-coverage.sh's
  // regex (`space OK ]` --- both delimiters non-alnum); coverage row lands
  // in tests/r55/expected-r55-write-e2e.txt as the whole-tag substring
  // `pdxb write ok [legacy: PDXB WRITE OK]` (contains-in-order match).
  //
  // Emitted exactly once per successful composed pdxfs_block_write call.
  // Fires on BOTH the LIVE path (all sub-primitives succeeded) and the
  // SUBSTRATE path (when _nvme_io_queue_count == 0, disk-touching steps
  // are skipped but the fingerprint still fires --- mirrors R55.M2-002
  // inode_table_write and R55.M2-003 wal_fsync_bdev's own substrate
  // emit posture). ANY failure path bypasses the emit and forwards the
  // sub-primitive's sentinel verbatim.
  //
  // k_ino is REUSED from R55.M2-002 above (line 959, "ino\0", [u8; 4]).
  // k_offset is minted here; no prior key in this file names a byte-
  // offset within an inode --- the closest neighbour, k_start_lba
  // (R55.M2-001), names an LBA offset rather than a byte offset.
  // k_len is REUSED from the R7-era generic key block above (line 48,
  // "len\0", [u8; 4]).
  //
  // Byte counts NUL-inclusive:
  //   tag_pdxb_write_ok -- 37 chars (no em-dash) + NUL = 38.
  //   k_offset          -- 6 chars + NUL = 7.
  pub let tag_pdxb_write_ok : [u8; 38] = "pdxb write ok [legacy: PDXB WRITE OK]\0"
  pub let k_offset          : [u8; 7]  = "offset\0"

  // R55.M2-005 (#1787): two-phase pdxfs-block write-then-reboot-then-
  // read-back fingerprint. Emitted from the R55.M2-005 boot witness
  // (src/kernel/boot/witness/r55_write_e2e.pdx) on the phase-2 arm
  // when the reboot-preserved payload matches the phase-1 write
  // byte-for-byte. Same two-in-one bracketed legacy-suffix shape
  // R54.M1-002 / R55.M2-001 / R55.M2-002 / R55.M2-003 / R55.M2-004
  // already use in this file family; the wire carries both the R51
  // narrative form (`pdxb read match ok -- bytes=13`) and the historic
  // operator grep marker (`PDXB PERSIST OK`) in a single line. No
  // k=v pairs are appended -- the byte count is baked into the tag
  // literal itself and the payload-vs-expected match is the witness's
  // own memcmp gate rather than an on-wire visualization, so klog_s1
  // (not klog_s1_x3) is the emit call.
  //
  // Design note re: payload visualization -- an earlier draft baked
  // the readable payload string ("hello world\n" with backslash+n
  // literal) into the tag so the serial line self-documented what
  // matched. That draft ran afoul of verify-fingerprint-coverage.sh's
  // unesc() heuristic, which unconditionally collapses backslash+n
  // to a real newline (LF) when comparing the emitted marker against
  // the asserted golden line -- the golden's `\n` stays literal
  // (two ASCII bytes) but the marker's `\n` collapses to LF, and
  // covered_by()'s prefix match then fails at the differing byte.
  // Alternatives considered: (a) truncate the golden to strip the
  // `\n` chars -- would remove the OK token from the asserted line
  // and defeat coverage entirely; (b) use a byte-array literal to
  // bypass the string-literal extractor -- the array extractor
  // decodes bytes-latin-1 and passes THROUGH unesc, hitting the
  // same collapse. The pragmatic fix is to omit the readable payload
  // from the tag literal; `bytes=13` conveys the meaningful info
  // (thirteen-byte read matched) without introducing the escape
  // hazard, and it parallels sibling tags like tag_pdxb_bdev_rt_
  // readback_ok which surface `lba=16 match=1` rather than raw
  // payload bytes.
  //
  // The tag DOES contain an OK token per verify-fingerprint-coverage.
  // sh's OK_TOK regex (`space OK ]` --- both delimiters non-alnum);
  // coverage row lands in tests/r55/expected-r55-write-e2e-phase2.txt
  // as the whole-tag substring (contains-in-order match).
  //
  // Emitted exactly once per successful phase-2 readback. The phase-1
  // arm re-uses tag_pdxb_write_ok (above) via the composed
  // pdxfs_block_write call; no additional tag is minted for phase 1.
  //
  // Byte counts NUL-inclusive:
  //   tag_pdxb_persist_ok -- 55 chars (em-dash is 3 UTF-8 bytes) +
  //                          NUL = 58.
  pub let tag_pdxb_persist_ok : [u8; 58] = "pdxb read match ok — bytes=13 [legacy: PDXB PERSIST OK]\0"

  // R56.M3-002 (#1791): sys_stat success fingerprint.
  //
  // Fingerprint emitted from sys_stat_body (src/kernel/core/syscall/
  // sys_stat.pdx) at the tail of every successful stat resolution --
  // after path_resolve returns a real vnode idx, vops_stat has populated
  // the 64-byte kernel-side stat scratch, and user_write_bytes_via_walk
  // has copied the 64 bytes back to the ring-3 caller.
  //
  // Bracketed-legacy shape matches R54/R55 wire-fingerprint precedent
  // (`tag_pdxb_bdev_flush_ok` / `tag_pdxb_alloc_ok` / `tag_pdxb_inode_
  // write_ok` and the R55.M2-005 sibling `tag_pdxb_persist_ok`) so the
  // wire carries both the R51 narrative form (`sys stat ok`) and the
  // historic operator grep marker (`SYS STAT OK`) in a single line,
  // followed by the composer-appended k=v pairs (path scratch VA + file
  // size):
  //
  //   wire: sys stat ok [legacy: SYS STAT OK] path=0x000000000031f000 size=0x0000000000000020
  //
  // The tag DOES contain an OK token per verify-fingerprint-coverage.sh's
  // regex (`space OK ]` — both delimiters non-alnum); coverage row lands
  // in tests/r56/expected-r56-stat.txt as the whole-tag substring
  // `sys stat ok [legacy: SYS STAT OK]` (contains-in-order match).
  //
  // Per R54/R55 precedent AND the R56.M3-002 task's own em-dash guidance
  // (`em-dash DROPPED per established R54/R55 wire-fingerprint
  // precedent`), NO em-dash is baked into the tag literal. The wire form
  // has the k=v pairs appended directly after the `]` with a single
  // space separator, per klog_emit_core's own composer contract.
  //
  // Emitted exactly once per successful sys_stat call. ANY failure path
  // (path_resolve -> ENOENT, vops_stat -> EIO, user_write_bytes_via_walk
  // -> EFAULT) bypasses the emit and forwards the sentinel verbatim.
  //
  // k_path is minted here; no prior key in this file names a filesystem
  // path (k_pa/k_va are physical/virtual memory addresses, k_file/k_line
  // are source-file coordinates). k_size is REUSED from the R21 batch-4
  // XSAVE fingerprint block above (line 338, "size\0", [u8; 5]).
  //
  // Byte counts NUL-inclusive:
  //   tag_sys_stat_ok -- 33 chars (no em-dash) + NUL = 34.
  //   k_path          -- 4 chars + NUL = 5.
  pub let tag_sys_stat_ok : [u8; 34] = "sys stat ok [legacy: SYS STAT OK]\0"
  pub let k_path          : [u8; 5]  = "path\0"

  // R56.M3-003 (#1792): sys_getdents body success fingerprint.
  //
  // Emitted exactly once per successful sys_getdents_body call from
  // src/kernel/core/syscall/sys_getdents.pdx. Two-in-one bracketed
  // legacy-suffix shape (memo §5.1 option B) mirrors the pdxb_*_ok
  // family so the wire carries both the R51 narrative form
  // (`sys getdents ok`) and the historic operator grep marker
  // (`SYS GETDENTS OK`) in a single line, followed by the composer-
  // appended k=v pairs (path + entries). Em-dash is DROPPED from the tag
  // literal itself — the k=v pairs appear after the bracket, not spliced
  // through it (matches tag_sys_stat_ok / tag_pdxb_write_ok shape). Wire:
  //
  //   sys getdents ok [legacy: SYS GETDENTS OK] path=0x0000000000000001 entries=0x0000000000000003
  //
  // path carries the directory vnode_idx (root vnode = 1) — it is the
  // best identifier the body has access to (fd_get returns a packed
  // entry, not a path string). entries carries the count of live
  // records the backend adapter wrote (excluding the terminator).
  //
  // k_path is REUSED from the R56.M3-002 (#1791) sys_stat fingerprint
  // block above — same "path" byte string, same u64 read shape at every
  // callsite. Only tag_sys_getdents_ok and k_entries are minted here.
  //
  // The tag DOES contain an OK token per verify-fingerprint-coverage.sh's
  // regex (`space OK ]` — both delimiters non-alnum); coverage row lands
  // in tests/r56/expected-r56-getdents.txt as the whole-tag substring
  // `sys getdents ok [legacy: SYS GETDENTS OK]`.
  //
  // Byte counts NUL-inclusive:
  //   tag_sys_getdents_ok -- 41 chars + NUL = 42.
  //   k_entries           -- 7 chars + NUL = 8.
  pub let tag_sys_getdents_ok : [u8; 42] = "sys getdents ok [legacy: SYS GETDENTS OK]\0"
  pub let k_entries           : [u8; 8]  = "entries\0"

  // R56.M3-004 (#1793): sys_mkdir + sys_rmdir body success fingerprints.
  //
  // Two-in-one bracketed legacy-suffix shape (memo §5.1 option B) — same
  // family as tag_sys_stat_ok / tag_sys_getdents_ok above.  Em-dash is
  // DROPPED from the tag literal itself (composer appends the k=v pair
  // AFTER the trailing `]` with a single space separator; the R51/R55/
  // R56 wire-fingerprint precedent this file already documents).
  //
  // Wire form:
  //
  //   sys mkdir ok [legacy: SYS MKDIR OK] path=0x0000000000000001
  //   sys rmdir ok [legacy: SYS RMDIR OK] path=0x0000000000000001
  //
  // Emitted exactly once per successful sys_mkdir_body / sys_rmdir_body
  // call from src/kernel/core/syscall/sys_mkdir.pdx and .../sys_rmdir.pdx
  // respectively.  ANY failure path (path_resolve -> ENOENT, split_no_slash
  // -> ENOENT, vops_mkdir/vops_rmdir -> EIO, user_ptr_ok -> EFAULT)
  // bypasses the emit and forwards the sentinel verbatim.
  //
  // k_path is REUSED from the R56.M3-002 (#1791) sys_stat fingerprint
  // block above (line 1123, "path\0", [u8; 5]) — same "path" byte string,
  // same u64 read shape at every callsite; the value is the address of
  // the kernel-side path scratch (rendered as hex), which is the best
  // callsite-uniform identifier the body can offer without a stable
  // per-mount path canonicaliser.  Only tag_sys_mkdir_ok / tag_sys_rmdir_
  // ok are minted here.
  //
  // Both tags contain an OK token per verify-fingerprint-coverage.sh's
  // regex (`space OK ]` — both delimiters non-alnum); coverage rows land
  // in tests/r56/expected-r56-mkdir-rmdir.txt as the whole-tag substrings
  // `sys mkdir ok [legacy: SYS MKDIR OK]` and `sys rmdir ok [legacy: SYS
  // RMDIR OK]`.
  //
  // Byte counts NUL-inclusive:
  //   tag_sys_mkdir_ok -- 35 chars + NUL = 36.
  //   tag_sys_rmdir_ok -- 35 chars + NUL = 36.
  pub let tag_sys_mkdir_ok : [u8; 36] = "sys mkdir ok [legacy: SYS MKDIR OK]\0"
  pub let tag_sys_rmdir_ok : [u8; 36] = "sys rmdir ok [legacy: SYS RMDIR OK]\0"

  // R56.M3-005 (#1794) sys_unlink + sys_rename fingerprint tags & keys.
