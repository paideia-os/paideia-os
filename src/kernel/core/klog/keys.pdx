  //   tag_nvme_ctrl            10 = "NVME CTRL" + NUL
  //   tag_nvme_ctrl_mint       15 = "NVME CTRL MINT" + NUL
  //   tag_nvme_ctrl_bringup    18 = "NVME CTRL BRINGUP" + NUL
  //   tag_nvme_ctrl_identify   19 = "NVME CTRL IDENTIFY" + NUL
