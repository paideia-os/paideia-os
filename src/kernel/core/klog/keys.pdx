  // R21-M5 (#842 HPET, #843 TSC, #844 x2APIC) fingerprints + keys.
  // Byte counts NUL-inclusive per #699 discipline.
  //   tag_hpet_init_ok         13 = "HPET INIT OK" + NUL
  //   tag_x2apic_available     17 = "X2APIC AVAILABLE" + NUL   (R51: deleted)
  //   tag_x2apic_absent        14 = "X2APIC ABSENT" + NUL      (R51: deleted)
  //   k_period_fs              10 = "period_fs" + NUL
  //   k_freq_hz                 8 = "freq_hz" + NUL
  //
  // R51 Phase C (SUBSYS_TIME shard, boot-transcript.md §7): the two TIME
  // subsystem emits get English narrative bodies alongside the machine
  // fingerprints.  HPET follows a TWO-LINE pattern (narrative followed by
  // the preserved `HPET INIT OK ...` fingerprint) because the r14b
  // golden `tests/r14b/expected-boot-r14b-kpti.txt` pins the CONTIGUOUS
  // substring `HPET INIT OK period_fs=0x`, whose contiguity is broken by
  // any bracketed `[legacy: HPET INIT OK]` suffix (the `]` intervenes
  // before the KV composer appends ` period_fs=0x...`).  TSC follows a
  // ONE-LINE pattern (English + bracketed legacy suffix per memo §5.1
  // option B) because no golden asserts `TSC CALIBRATED`, and its
  // frequency KV moves to decimal via klog_s1_d1 + k_freq_hz (memo §3.5
  // engineering-units discipline).
  //
  // The narrative strings deliberately carry NO `OK` token so that
  // verify-fingerprint-coverage.sh's OK_TOK regex ignores them — a
  // narrative that spelled `HPET INIT OK` inside the body would need
  // either a matching golden or an allowlist row, both of which are
  // out of scope for this shard.  The old `tag_tsc_calibrated` and
  // `k_hz` are DELETED (sole consumer was tsc.pdx; neither carries an
  // OK token so no coverage row moves).  `tag_hpet_init_ok`,
  // `k_period_fs`, `k_freq_hz` are UNCHANGED — the HPET fingerprint
  // line stays byte-identical to the pre-R51 wire.
  //
  //   tag_hpet_narrative       39 = "HPET initialized: main counter running" + NUL
  //   tag_tsc_narrative        40 = "TSC calibrated [legacy: TSC CALIBRATED]" + NUL
  pub let tag_hpet_init_ok      : [u8; 13] = "HPET INIT OK\0"
  pub let tag_hpet_narrative    : [u8; 39] = "HPET initialized: main counter running\0"
  pub let tag_tsc_narrative     : [u8; 40] = "TSC calibrated [legacy: TSC CALIBRATED]\0"
  // R51 Phase C (SUBSYS_APIC shard, boot-transcript.md §7): English
  // narrative bodies with bracketed legacy suffix (memo §5.1 option B).
  // Neither `X2APIC AVAILABLE` nor `X2APIC ABSENT` is asserted by any
  // golden (grep tests/ returns zero hits) and neither carries an OK
  // token, so the rewrite is coverage-neutral and golden-neutral.  The
  // bracketed legacy markers are kept for operator grep parity with
  // documentation (tools/nvme-hw-smoke.md and tools/pdxfs-lite-e2e-smoke.md
  // both list the historic wire strings in prose, not as machine-parsed
  // fixtures).  Old `tag_x2apic_available` and `tag_x2apic_absent` are
  // deleted — sole consumer was src/kernel/core/apic/x2apic.pdx.
  pub let tag_x2apic_available_narrative  : [u8; 56] = "x2APIC supported on this CPU [legacy: X2APIC AVAILABLE]\0"
  pub let tag_x2apic_absent_narrative     : [u8; 55] = "x2APIC not present on this CPU [legacy: X2APIC ABSENT]\0"
  pub let k_period_fs           : [u8; 10] = "period_fs\0"
  pub let k_freq_hz             : [u8; 8]  = "freq_hz\0"

