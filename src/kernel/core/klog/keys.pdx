  //   k_bar0                    5 = "bar0" + NUL
  //   k_mdts                    5 = "mdts" + NUL
  //   k_nn_ctrl                 3 = "nn" + NUL  (nn already used in R24; reuse)
  //   k_num_io_queues          11 = "num_io_qs" + NUL
  pub let tag_nvme_ctrl             : [u8; 10] = "NVME CTRL\0"
  pub let tag_nvme_ctrl_mint        : [u8; 15] = "NVME CTRL MINT\0"
  pub let tag_nvme_ctrl_bringup     : [u8; 18] = "NVME CTRL BRINGUP\0"
  pub let tag_nvme_ctrl_identify    : [u8; 19] = "NVME CTRL IDENTIFY\0"
  pub let tag_nvme_ctrl_negotiate   : [u8; 20] = "NVME CTRL NEGOTIATE\0"
  pub let k_row                     : [u8; 4]  = "row\0"
  pub let k_bar0                    : [u8; 5]  = "bar0\0"
  pub let k_mdts                    : [u8; 5]  = "mdts\0"
  pub let k_num_io_qs               : [u8; 10] = "num_io_qs\0"

  // R26-M1 (#941..#945): xHCI substrate — PCI probe + capability register
  // map + BIOS handoff + SMI disable + reset/enable. Byte counts
  // NUL-inclusive per #699 discipline.
  //   tag_xhci_probe          11 = "XHCI PROBE" + NUL
  //   tag_xhci_cap             9 = "XHCI CAP" + NUL
  //   tag_xhci_handoff        13 = "XHCI HANDOFF" + NUL
  //   tag_xhci_smi             9 = "XHCI SMI" + NUL
  //   tag_xhci_reset          11 = "XHCI RESET" + NUL
  //   k_maxslots               9 = "maxslots" + NUL
  //   k_maxintrs               9 = "maxintrs" + NUL
  //   k_maxports               9 = "maxports" + NUL
  //   k_hciversion            11 = "hciversion" + NUL
  //   k_xecp                   5 = "xecp" + NUL
  //   k_slotsen                8 = "slotsen" + NUL
  pub let tag_xhci_probe            : [u8; 11] = "XHCI PROBE\0"
  pub let tag_xhci_cap              : [u8; 9]  = "XHCI CAP\0"
  pub let tag_xhci_handoff          : [u8; 13] = "XHCI HANDOFF\0"
  pub let tag_xhci_smi              : [u8; 9]  = "XHCI SMI\0"
  pub let tag_xhci_reset            : [u8; 11] = "XHCI RESET\0"
  pub let k_maxslots                : [u8; 9]  = "maxslots\0"
  pub let k_maxintrs                : [u8; 9]  = "maxintrs\0"
  pub let k_maxports                : [u8; 9]  = "maxports\0"
  pub let k_hciversion              : [u8; 11] = "hciversion\0"
  pub let k_xecp                    : [u8; 5]  = "xecp\0"
  pub let k_slotsen                 : [u8; 8]  = "slotsen\0"

  // R27-M1 (#971..#975): e1000e / i219 NIC substrate — PCI probe + MMIO
  // register map + reset + MAC-from-EEPROM + PHY register access. Byte
  // counts NUL-inclusive per #699 discipline.
  //   tag_e1000e_probe         13 = "E1000E PROBE" + NUL
  //   tag_e1000e_reset         13 = "E1000E RESET" + NUL
  //   tag_e1000e_mac           11 = "E1000E MAC" + NUL
  //   k_mac_lo                  7 = "mac_lo" + NUL   (bytes [0..3] as u32)
  //   k_mac_hi                  7 = "mac_hi" + NUL   (bytes [4..5] as u16)
  pub let tag_e1000e_probe          : [u8; 13] = "E1000E PROBE\0"
  pub let tag_e1000e_reset          : [u8; 13] = "E1000E RESET\0"
  pub let tag_e1000e_mac            : [u8; 11] = "E1000E MAC\0"
  pub let k_mac_lo                  : [u8; 7]  = "mac_lo\0"
  pub let k_mac_hi                  : [u8; 7]  = "mac_hi\0"

  // R27-M2 (#976..#980): e1000e RX/TX ring substrate + MSI-X + IRQ.
  //   tag_e1000e_rx_ring       15 = "E1000E RX RING" + NUL
  //   tag_e1000e_tx_ring       15 = "E1000E TX RING" + NUL
  //   tag_e1000e_rx            10 = "E1000E RX" + NUL
  //   tag_e1000e_msix          12 = "E1000E MSIX" + NUL
  //   tag_e1000e_irq           11 = "E1000E IRQ" + NUL
  //   tag_e1000e_link          12 = "E1000E LINK" + NUL
  pub let tag_e1000e_rx_ring        : [u8; 15] = "E1000E RX RING\0"
  pub let tag_e1000e_tx_ring        : [u8; 15] = "E1000E TX RING\0"
  pub let tag_e1000e_rx             : [u8; 10] = "E1000E RX\0"
  pub let tag_e1000e_msix           : [u8; 12] = "E1000E MSIX\0"
  pub let tag_e1000e_irq            : [u8; 11] = "E1000E IRQ\0"
  pub let tag_e1000e_link           : [u8; 12] = "E1000E LINK\0"

  // R27-M3 (#981..#984): L2 Ethernet frame framework — parse/build,
  // RX dispatch, TX submit, broadcast/multicast filter. Byte counts
  // NUL-inclusive per #699 discipline.
  //   tag_l2_ipv4              11 = "L2 RX IPV4" + NUL
  //   tag_l2_arp               10 = "L2 RX ARP"  + NUL
  pub let tag_l2_ipv4               : [u8; 11] = "L2 RX IPV4\0"
  pub let tag_l2_arp                : [u8; 10] = "L2 RX ARP\0"

  // R27-M5 (#989..#992): IPv4 header + checksum + RX/TX. Stubs for
  // ICMP + UDP are fingerprint-only at M5 (real handlers land R27.M6).
  //   tag_l3_ipv4              11 = "L3 RX IPV4" + NUL
  //   tag_l3_icmp              11 = "L3 RX ICMP" + NUL
  //   tag_l3_udp               10 = "L3 RX UDP"  + NUL
  pub let tag_l3_ipv4               : [u8; 11] = "L3 RX IPV4\0"
  pub let tag_l3_icmp               : [u8; 11] = "L3 RX ICMP\0"
  pub let tag_l3_udp                : [u8; 10] = "L3 RX UDP\0"

  // R29.M4-004 (#1035): blob-driver signature telemetry. Three tags
  // rather than one, selected by the combined verdict, so an operator
  // can grep the audit log for BLOB SIG REJECT alone — the line that
  // means a firmware blob failed its dual-signature check — without
  // matching the routine scaffold-epoch traffic. Byte counts
  // NUL-inclusive per #699 discipline.
  //   k_verdict                 8 = "verdict" + NUL
  //   k_gate                    5 = "gate"    + NUL
  //   tag_blob_sig_ok          12 = "BLOB SIG OK"       + NUL
  //   tag_blob_sig_unsigned    18 = "BLOB SIG UNSIGNED" + NUL
  //   tag_blob_sig_reject      16 = "BLOB SIG REJECT"   + NUL
  pub let k_verdict                 : [u8; 8]  = "verdict\0"
  pub let k_gate                    : [u8; 5]  = "gate\0"
  pub let tag_blob_sig_ok           : [u8; 12] = "BLOB SIG OK\0"
  pub let tag_blob_sig_unsigned     : [u8; 18] = "BLOB SIG UNSIGNED\0"
  pub let tag_blob_sig_reject       : [u8; 16] = "BLOB SIG REJECT\0"

  // boot-mmio-mapping step 2 (design/kernel/boot-mmio-mapping.md).
  // Emitted by platform_map_early_mmio after the three firmware-fixed
  // MMIO windows (HPET / xAPIC / IOAPIC) have been passed through
  // platform_mmio_map. The N=<count> KV names how many mappings the
  // manifest walk installed (0..3 at this step; grows as MCFG and other
  // rows land in step 5+). Byte count NUL-inclusive per #699 discipline.
  //   tag_platform_mmio_early_ok 23 = "PLATFORM MMIO EARLY OK" + NUL
  pub let tag_platform_mmio_early_ok : [u8; 23] = "PLATFORM MMIO EARLY OK\0"
}
