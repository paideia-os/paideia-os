// src/kernel/core/klog/ring.pdx — M2-001 (#687) klog ring buffer
// Monotonic head/tail ring buffer for kernel logging
// Issue: #687
// [unsafe] — memory R/W, sysreg I/O (uart_putc clobber discipline)
// Audit: design/kernel/kernel-logging-substrate.md §6
//
// M2-001 ring buffer: 64 KiB .bss slab + monotonic u64 head/tail counters.
// Wrap-index via `head & 0xFFFF` (power-of-2 size). Split-copy on wrap.
// Drain polls LSR bit 5 (THRE), non-spinning per §6.3.
// Per-core writer at R14b (_klog_in_progress_bsp); SMP locking deferred.

module Ring = structure {
  // === Constants ===
  pub let KLOG_RING_SIZE : u64 = 65536       // §6.1 fixed
  pub let KLOG_RING_MASK : u64 = 0xFFFF      // KLOG_RING_SIZE - 1

  // === Storage (.bss slab — zero-init, no init call needed) ===
  pub let mut _klog_ring      : [u8; 65536] = uninit @align(8)   // .bss ring slab
  pub let mut _klog_ring_head : u64 = 0                          // .data monotonic write cursor
  pub let mut _klog_ring_tail : u64 = 0                          // .data drain cursor

  // ========================================================================
  // klog_ring_write(buf_ptr: u64, len: u64) -> () !{mem} @{}
  //
  // Write len bytes from buf_ptr into _klog_ring starting at [head & MASK].
  // Advance head by len. If head - tail > SIZE, drop oldest: tail = head - SIZE.
  //
  // Split-copy pattern: if write wraps ring boundary, copy in two parts:
  //   (1) bytes_to_end = 65536 - (head & 0xFFFF) bytes at [_klog_ring + wrap_idx]
  //   (2) remaining bytes at [_klog_ring + 0]
  //
  // Registers (SysV caller-save): rdi=buf_ptr, rsi=len.
  // Preserves: rbx, rbp, r12-r15.
  // ========================================================================
  pub let klog_ring_write : (u64, u64) -> () !{mem} @{} =
    fn (buf_ptr: u64) (len: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "M2-001 ring write per §6.1-6.2. (1) snapshot head into rcx; (2) compute wrap_idx = head & 0xFFFF; (3) space_to_end = 65536 - wrap_idx; (4) if len <= space_to_end, single-copy; else split-copy: first copy space_to_end bytes at [_klog_ring + wrap_idx], then copy (len - space_to_end) at [_klog_ring + 0]; (5) advance head += len; (6) check overflow: if (head - tail > 65536), set tail = head - 65536. All byte-loops use mov_b [dst], al pattern (proven at uart.pdx, path.pdx; avoids paideia-as#1270). Monotonic u64 never wraps per §6.1. Registers: push rbx (callee-save); rdi=buf_ptr, rsi=len. Clobbers: rax, rcx, rdx, r8-r11 (SysV caller-save only).",
      block: {
        push rbx;

        // Step 1: snapshot head
        mov rcx, [rip + _klog_ring_head];      // rcx = head snapshot

        // Step 2: compute wrap_idx = head & 0xFFFF
        mov rdx, rcx;
        and rdx, 0xFFFF;                       // rdx = wrap_idx

        // Step 3: space_to_end = 65536 - wrap_idx
        mov r8, 65536;
        sub r8, rdx;                           // r8 = space_to_end

        // Step 4: decide single vs split copy
        cmp rsi, r8;
        jbe klog_write_single_copy;

        // === SPLIT COPY ===
        // First copy: r8 bytes from [buf_ptr] into [_klog_ring + wrap_idx]
        lea r11, [rip + _klog_ring];           // r11 = _klog_ring base
        mov r9, rdi;                           // r9 = source pointer
        mov r10, r8;                           // r10 = byte count (space_to_end)
        add r11, rdx;                          // r11 = _klog_ring + wrap_idx

        klog_write_split_copy_first:
        cmp r10, 0;
        je klog_write_split_copy_second_start;
        mov al, [r9 + 0];
        mov_b [r11 + 0], al;
        inc r9;
        inc r11;
        dec r10;
        jmp klog_write_split_copy_first;

        klog_write_split_copy_second_start:
        // Second copy: (len - space_to_end) bytes from [buf_ptr + space_to_end] into [_klog_ring + 0]
        mov r10, rsi;                          // r10 = len
        sub r10, r8;                           // r10 = len - space_to_end
        lea r11, [rip + _klog_ring];           // r11 = _klog_ring base again

        klog_write_split_copy_second:
        cmp r10, 0;
        je klog_write_advance_head;
        mov al, [r9 + 0];
        mov_b [r11 + 0], al;
        inc r9;
        inc r11;
        dec r10;
        jmp klog_write_split_copy_second;

        // === SINGLE COPY ===
        klog_write_single_copy:
        mov r9, rdi;                           // r9 = source pointer
        mov r10, rsi;                          // r10 = byte count (len)
        lea r11, [rip + _klog_ring];
        add r11, rdx;                          // r11 = _klog_ring + wrap_idx

        klog_write_single_copy_loop:
        cmp r10, 0;
        je klog_write_advance_head;
        mov al, [r9 + 0];
        mov_b [r11 + 0], al;
        inc r9;
        inc r11;
        dec r10;
        jmp klog_write_single_copy_loop;

        // Step 5: advance head
        klog_write_advance_head:
        add rcx, rsi;                          // rcx = head + len
        mov [rip + _klog_ring_head], rcx;

        // Step 6: check overflow and drop oldest if needed
        mov rax, rcx;                          // rax = new head
        mov r10, [rip + _klog_ring_tail];      // r10 = tail
        sub rax, r10;                          // rax = head - tail
        cmp rax, 65536;
        jbe klog_write_done;

        // Overflow: tail = head - 65536
        mov rax, rcx;
        sub rax, 65536;
        mov [rip + _klog_ring_tail], rax;

        klog_write_done:
        pop rbx;
        ret;
      }
    }

  // ========================================================================
  // klog_ring_drain_to_uart() -> () !{sysreg, mem} @{}
  //
  // Poll-drain loop: while tail < head, check LSR bit 5 (THRE).
  // If not set, return (non-spinning). If set, emit byte and advance tail.
  //
  // Registers: SysV caller-save only. Preserves: rbx, rbp, r12-r15.
  // ========================================================================
  pub let klog_ring_drain_to_uart : () -> () !{sysreg, mem} @{} =
    fn () -> unsafe {
      effects: { sysreg, mem },
      capabilities: {},
      justification: "M2-001 ring drain per §6.3. Loop: load tail, cmp tail < head. If not, return. Poll LSR (0x3FD) bit 5 (THRE). If not set, return (non-spinning per §6.3). Else load byte at [_klog_ring + (tail & 0xFFFF)], write to THR (0x3F8), increment tail, loop. Byte-load uses mov_b + and pattern (proven). Registers: push rbx (callee-save); rdi/rsi clobbered by uart ops. Clobbers: rax, rcx, rdx, rsi, rdi (SysV caller-save).  R23-M2-004 (#882) fb-mirror hook: after each UART store, if _fb_console_active is nonzero (fb_console_init has run), mirror the same byte into fb_console_putchar so the log stream lands on both serial and the framebuffer console.  The hook is inside klog_emit_core's cli + _klog_in_progress_bsp reentrancy gate (see core/klog/emit.pdx L84-89 / L75-81) so fb_console_putchar sees no interrupt-mid-mutation and no downstream recursion into klog (fb_console_* is strictly below klog in the call graph).  Register discipline for the hook: rbx (callee-save) stashes the byte across `out_al al` and the nested call; tail is incremented and written back BEFORE the fb call so the r8 clobber inside fb_console_putchar does not corrupt the ring-tail write-back.  Stack alignment: entry rsp%16==8, push rbx -> rsp%16==0 — nested call sees the SysV-aligned rsp without any additional pad.  Under `qemu -kernel` boot the PVH path never invokes fb_console_init, _fb_console_active stays 0, and the hook is a two-instruction dormant load+compare — no visible behavior change.",
      block: {
        push rbx;

        klog_drain_loop_start:
        // Load tail and head
        mov r8, [rip + _klog_ring_tail];       // r8 = tail
        mov r9, [rip + _klog_ring_head];       // r9 = head

        // Check if tail < head
        cmp r8, r9;
        jge klog_drain_done;

        // Poll LSR (0x3FD) bit 5 (THRE)
        mov dx, 0x3FD;
        in_al al;
        and rax, 0x20;                         // Test THRE bit (bit 5)
        jz klog_drain_done;                   // If THRE not set, return (non-spinning)

        // Compute wrap_idx = tail & 0xFFFF
        mov rcx, r8;
        and rcx, 0xFFFF;                       // rcx = wrap_idx

        // Load byte from ring[wrap_idx]
        lea rax, [rip + _klog_ring];
        add rax, rcx;                          // rax = _klog_ring + wrap_idx
        mov_b al, [rax + 0];                   // al = ring byte

        // R23-M2-004 (#882): stash the byte in rbx (callee-save) so it
        // survives both the UART store's rax reuse and the nested
        // fb_console_putchar call below.
        mov rbx, rax;
        and rbx, 0xFF;

        // Write to THR (0x3F8)
        mov dx, 0x3F8;
        out_al al;

        // Increment tail BEFORE the fb-mirror call so r8's caller-save
        // clobber inside fb_console_putchar does not corrupt the write.
        add r8, 1;
        mov [rip + _klog_ring_tail], r8;

        // R23-M2-004 (#882): mirror to framebuffer console if active.
        // Gate on _fb_console_active — 0 on the PVH `-kernel` boot path
        // and pre-fb_console_init, so this collapses to a load+compare
        // when the console is dormant.
        mov rax, [rip + _fb_console_active];
        cmp rax, 0;
        je klog_drain_fb_skip;

        mov rdi, rbx;                          // arg 0 = byte
        call fb_console_putchar;

        klog_drain_fb_skip:
        jmp klog_drain_loop_start;

        klog_drain_done:
        pop rbx;
        ret;
      }
    }

  // ========================================================================
  // klog_ring_dump_panic() -> () !{sysreg, mem} @{}
  //
  // Panic dump: emit BEGIN marker, busy-emit all ring bytes to UART, emit END marker.
  // Two klog_s1 calls frame the dump with PANIC level structured lines.
  // Busy-emit loop from dump_start to dump_head via blocking uart_putc (THRE polling).
  //
  // Register discipline: rbx = dump_head snapshot, r12 = loop index (both callee-save).
  // uart_putc clobbers rax; callee-save regs survive.
  // Loop compare is u64-width (cmp r12, rbx; jae done) to avoid paideia-as#1270.
  //
  // Placement: M2-002 (#688) sibling to M2-001 ring buffer.
  // ========================================================================
  pub let klog_ring_dump_panic : () -> () !{sysreg, mem} @{} =
    fn () -> unsafe {
      effects: { sysreg, mem },
      capabilities: {},
      justification: "M2-002 ring dump on panic per §6.4. (1) klog_s1(LEVEL_PANIC, SUBSYS_PANC, k_panic_dump_begin) appends BEGIN marker to ring. (2) snapshot dump_head = _klog_ring_head. (3) compute dump_start = (dump_head > KLOG_RING_SIZE) ? dump_head - KLOG_RING_SIZE : 0 (oldest live byte). (4) busy-emit loop i = dump_start..dump_head: mov_b al, [_klog_ring + (i & 0xFFFF)]; and rax, 0xff; mov rdi, rax; call uart_putc; then R23-M3-002 (#884) fb-mirror tail: if _fb_console_active is nonzero, call fb_console_putchar(byte) with the same byte reloaded into rdi (rdi is caller-save across uart_putc, so we re-mov rdi from a callee-save scratch — see register plan below).  uart_putc's THRE spin is unconditional wait; panic can afford to block. (5) klog_s1(LEVEL_PANIC, SUBSYS_PANC, k_panic_dump_end) appends END marker. Registers: push rbx+r12+r13 (callee-save); rbx=dump_head, r12=loop index, r13=fb-mirror byte scratch (survives uart_putc + fb_console_putchar caller-save clobbers).  Loop terminator u64 (cmp r12, rbx; jae done) immune to #1270 byte-compare miscompile. Byte load via proven mov_b+and pattern. Ordering: BEGIN and END land adjacent at ring tail, wire order is pre-panic history then BEGIN then END — end-of-log framing per §6.4 language.  fb-mirror ordering: the same bytes UART sees (BEGIN + ring + END) also reach fb_console_putchar, producing a photograph-recoverable trace on the framebuffer even when there is no serial line — matches the design/hardware/quirks.md §2.5 chassis-has-no-UART fallback recipe.  Stack alignment: entry rsp%16==8, +3 pushes (rbx, r12, r13) = rsp%16==0, so both nested calls (uart_putc, fb_console_putchar) see SysV-aligned rsp with no extra pad.  Dormant under `-kernel` PVH boot (fb never inits → fb-mirror is a load+compare + short-jump). Audit: design/kernel/kernel-logging-substrate.md §6.4.",
      block: {
        push rbx;
        push r12;
        push r13;                                   // R23-M3-002 (#884): fb-mirror byte scratch

        // Step 1: Call klog_s1(LEVEL_PANIC, SUBSYS_PANC, k_panic_dump_begin)
        mov rdi, 0;                                // rdi = LEVEL_PANIC = 0 (lowest level)
        lea rsi, [rip + SUBSYS_PANC];              // rsi = subsys_ptr (SUBSYS_PANC)
        lea rdx, [rip + k_panic_dump_begin];       // rdx = tag_ptr (key string)
        call klog_s1;

        // Step 2: Snapshot dump_head
        mov rbx, [rip + _klog_ring_head];          // rbx = dump_head snapshot

        // Step 3: Compute dump_start = (dump_head > KLOG_RING_SIZE) ? dump_head - KLOG_RING_SIZE : 0
        mov r12, rbx;                              // r12 = dump_head
        sub r12, 65536;                            // r12 = dump_head - KLOG_RING_SIZE
        cmp rbx, 65536;
        jbe dump_start_is_zero;
        jmp dump_start_computed;
        dump_start_is_zero:
        xor r12, r12;                              // r12 = 0 (dump_head <= KLOG_RING_SIZE)
        dump_start_computed:

        // Step 4: Busy-emit loop from dump_start (r12) to dump_head (rbx)
        // At loop entry: r12 = dump_start, rbx = dump_head
        // Loop counter will be in r12, dump_head stays in rbx

        // Reinitialize r12 = dump_start (it was clobbered by sub)
        mov r12, rbx;                              // r12 = dump_head
        sub r12, 65536;
        cmp rbx, 65536;
        jbe loop_start_is_zero;
        jmp loop_emit_start;
        loop_start_is_zero:
        xor r12, r12;                              // r12 = 0

        loop_emit_start:
        // Loop: for i in dump_start..dump_head, emit byte at ring[(i & 0xFFFF)]
        cmp r12, rbx;                              // Compare i vs dump_head (u64-width)
        jae loop_emit_done;

        // Compute wrap_idx = i & 0xFFFF
        mov rax, r12;
        and rax, 0xFFFF;                           // rax = wrap_idx

        // Load byte from ring[wrap_idx]
        lea rcx, [rip + _klog_ring];
        add rcx, rax;                              // rcx = _klog_ring + wrap_idx
        mov_b al, [rcx + 0];                       // al = ring byte
        and rax, 0xFF;                             // Mask to byte (zero-extend)

        // R23-M3-002 (#884): stash the byte in r13 (callee-save) so it
        // survives BOTH the uart_putc call AND the nested
        // fb_console_putchar call below.
        mov r13, rax;

        mov rdi, rax;                              // rdi = byte (uart_putc param)
        call uart_putc;

        // R23-M3-002 (#884): mirror the same byte to the fb console
        // when it is live (fb_console_init has run under UEFI/GOP).
        // Dormant under `-kernel` PVH boot (flag stays 0 → load+compare
        // + short-jump only).  fb_console_putchar re-enters the ANSI
        // state machine on every byte, so the drained ring bytes are
        // interpreted (SGR / CUP / etc.) just as they would be on the
        // live drain path — no need to strip ANSI here.
        mov rax, [rip + _fb_console_active];
        cmp rax, 0;
        je loop_emit_fb_skip;

        mov rdi, r13;                              // rdi = byte (fb_console_putchar param)
        call fb_console_putchar;

        loop_emit_fb_skip:

        // Increment loop counter
        inc r12;
        jmp loop_emit_start;

        loop_emit_done:

        // Step 5: Call klog_s1(LEVEL_PANIC, SUBSYS_PANC, k_panic_dump_end)
        mov rdi, 0;                                // rdi = LEVEL_PANIC = 0
        lea rsi, [rip + SUBSYS_PANC];              // rsi = subsys_ptr (SUBSYS_PANC)
        lea rdx, [rip + k_panic_dump_end];         // rdx = tag_ptr (key string)
        call klog_s1;

        pop r13;
        pop r12;
        pop rbx;
        ret;
      }
    }

  // ========================================================================
  // klog_ring_read_tail(dst_ptr: u64, len: u64) -> u64 !{mem} @{}
  //
  // logging-m9-001 (#708) / logging-m9-002 (#709) reader primitive.
  //
  // Copies up to `len` bytes from the ring's LIVE HISTORY WINDOW into
  // the caller-supplied kernel scratch buffer at `dst_ptr`. Returns the
  // number of bytes actually copied in rax (may be less than `len` if
  // fewer bytes are live).
  //
  // Live window definition (POSIX dmesg semantics):
  //   live_start = max(0, head - KLOG_RING_SIZE)
  //   available  = head - live_start = min(head, KLOG_RING_SIZE)
  //
  // NOTE: this is DELIBERATELY decoupled from _klog_ring_tail, which is
  // the UART-drain cursor (drain advances tail as bytes hit COM1, so the
  // [drain_tail..head] window is nearly always empty by the time a
  // dmesg-style reader arrives). A POSIX-style dmesg reader wants the
  // full LIVE HISTORY currently in the ring — anything that has not been
  // overwritten by the drop-oldest wrap yet — which is the full window
  // ending at head with capacity capped at KLOG_RING_SIZE bytes.
  //
  //   n         = min(available, len)
  //   src[0..n] = ring[(live_start & MASK)..], wrap-copy over ring
  //               boundary if (live_start & MASK) + n > KLOG_RING_SIZE.
  //   Neither head nor tail is mutated — this is a pure peek.
  //
  // Register discipline (SysV): rdi=dst_ptr, rsi=len. Preserves rbx
  // (callee-save; used to stash dst_ptr across the len computation).
  // Clobbers rax, rcx, rdx, r8-r11.
  // ========================================================================
  pub let klog_ring_read_tail : (u64, u64) -> u64 !{mem} @{} =
    fn (dst_ptr: u64) (len: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "logging-m9-001/-002 (#708/#709) ring reader per §12.10. Reads the LIVE HISTORY WINDOW ending at head — NOT the [drain_tail..head] window (drain_tail is the UART-emit cursor and is nearly always at head; using it would make every dmesg read return 0). Live window definition (POSIX dmesg semantics): live_start = (head > KLOG_RING_SIZE) ? head - KLOG_RING_SIZE : 0; available = head - live_start = min(head, KLOG_RING_SIZE). (1) snapshot head. (2) derive live_start via cmp+jbe. (3) available = head - live_start. (4) n = min(available, len). (5) start_idx = live_start & 0xFFFF. (6) if start_idx + n <= KLOG_RING_SIZE, single-copy; else split-copy at boundary. Byte-copies use mov_b [dst], al pattern (proven — matches klog_ring_write / uart.pdx / path.pdx; avoids paideia-as#1270). Register discipline: push rbx (callee-save) to stash dst_ptr; rdi/rsi consumed as SysV args; return count in rax. Neither head nor _klog_ring_tail is mutated — pure peek.",
      block: {
        push rbx;

        // Cap `len` at KLOG_RING_SIZE (65536). A caller requesting a huge
        // read cannot exceed the ring's own capacity.
        mov rax, 65536;
        cmp rsi, rax;
        jbe read_tail_len_ok;
        mov rsi, rax;
      read_tail_len_ok:

        // Snapshot head.
        mov r8, [rip + _klog_ring_head];   // r8 = head

        // live_start = (head > KLOG_RING_SIZE) ? head - KLOG_RING_SIZE : 0
        mov r9, r8;                        // r9 = head (temp)
        mov rcx, 65536;
        cmp r8, rcx;
        jbe read_tail_live_start_zero;
        sub r9, rcx;                       // r9 = head - KLOG_RING_SIZE
        jmp read_tail_live_start_done;
      read_tail_live_start_zero:
        xor r9, r9;                        // r9 = 0
      read_tail_live_start_done:

        // available = head - live_start
        mov r10, r8;
        sub r10, r9;

        // n = min(available, len)
        cmp r10, rsi;
        jbe read_tail_n_from_avail;
        mov r10, rsi;                      // n = len (len is the smaller)
        jmp read_tail_n_done;
      read_tail_n_from_avail:
        // n already = available (which is <= len); no move needed.
      read_tail_n_done:

        // If n == 0, nothing to copy.
        cmp r10, 0;
        je read_tail_return;

        // Save dst_ptr into rbx (callee-save) so we can reuse rdi as
        // the running destination cursor.
        mov rbx, rdi;

        // start_idx = live_start & 0xFFFF (r9 = live_start)
        mov rcx, r9;
        and rcx, 0xFFFF;                   // rcx = start_idx

        // space_to_end = KLOG_RING_SIZE - start_idx
        mov r11, 65536;
        sub r11, rcx;                      // r11 = space_to_end

        // Decide: single vs split copy.
        cmp r10, r11;
        jbe read_tail_single_copy;

        // === SPLIT COPY ===
        // First half: space_to_end bytes from ring[start_idx..end] -> dst[0..].
        lea rdx, [rip + _klog_ring];
        add rdx, rcx;                      // rdx = &_klog_ring[start_idx]
        mov r8, r11;                       // r8 = space_to_end (reuse: head no longer needed)

      read_tail_split_first:
        cmp r8, 0;
        je read_tail_split_second_start;
        mov al, [rdx + 0];
        mov_b [rbx + 0], al;
        inc rdx;
        inc rbx;
        dec r8;
        jmp read_tail_split_first;

      read_tail_split_second_start:
        // Second half: (n - space_to_end) bytes from ring[0..] -> dst[space_to_end..].
        mov r8, r10;
        sub r8, r11;                       // r8 = n - space_to_end
        lea rdx, [rip + _klog_ring];       // rdx = &_klog_ring[0]

      read_tail_split_second:
        cmp r8, 0;
        je read_tail_return_n;
        mov al, [rdx + 0];
        mov_b [rbx + 0], al;
        inc rdx;
        inc rbx;
        dec r8;
        jmp read_tail_split_second;

        // === SINGLE COPY ===
      read_tail_single_copy:
        lea rdx, [rip + _klog_ring];
        add rdx, rcx;                      // rdx = &_klog_ring[start_idx]
        mov r8, r10;                       // r8 = n

      read_tail_single_loop:
        cmp r8, 0;
        je read_tail_return_n;
        mov al, [rdx + 0];
        mov_b [rbx + 0], al;
        inc rdx;
        inc rbx;
        dec r8;
        jmp read_tail_single_loop;

      read_tail_return_n:
        mov rax, r10;                      // rax = bytes copied
        pop rbx;
        ret;

      read_tail_return:
        xor rax, rax;                      // 0 bytes copied
        pop rbx;
        ret;
      }
    }
}
