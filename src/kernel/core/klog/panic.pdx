// src/kernel/core/klog/panic.pdx — M4-001 (#692): kernel panic handler
//
// klog_panic(subsys, tag) → () !{sysreg, mem} @{}   ; noreturn
//   Atomically emit a panic-level log line, dump the panic ring,
//   and halt the CPU via isa-debug-exit. No return.
//
// Precision: matches klog_s1 argument shape (subsys, tag) without reason_ptr.
// The tag IS the reason phrase. The log-line's fixed prefix (PANIC level,
// subsys, TSC, CPU) is synthesized by klog_s1.

module Panic = structure {
  pub let klog_panic : (u64, u64) -> () !{sysreg, mem} @{} =
    fn (subsys_ptr: u64) (tag_ptr: u64) -> unsafe {
    effects: { sysreg, mem },
    capabilities: { boot },
    justification: "M4-001 (#692) + #716 wire-up + R23-M3-002 (#884) fb-banner: Emit panic-level klog line via klog_s1 (step 2), broadcast NMI to freeze secondaries (step 3), walk the caller-chain rbp into the event stream via klog_walk_rbp (step 3.5, #716) BEFORE the ring drain so FRAME lines interleave with the ring context, if the fb console is live emit a bold-red '*** PANIC ***' banner via fb_console_puts (step 3.7, #884) so the display shows an unmissable panic marker above the ring history that follows, drain the ring via klog_ring_dump_panic (step 4 — the drain body itself carries a per-byte fb-mirror hook so the same bytes UART sees also reach fb_console_putchar), exit QEMU via isa-debug-exit port 0xf4 value 0x11 (step 5), then cli+hlt spin (step 6). Re-entrancy is implicit: klog_s1 → klog_emit_core checks _klog_in_progress_bsp and no-ops on re-entry; klog_ring_dump_panic still fires (last ring bytes reach wire). Noreturn: stack frame preserved for debuggability, but function never returns. Stack-walker (#716): klog_panic's body is Unsafe (implicitly @no_frame per paideia-as #1276 phase-3 emit rule), so rbp inside this function equals the caller's rbp — the panic-triggering frame. klog_walk_rbp reads start_rbp from rdi and max_frames from rsi (bound 32 frames or canonical-VA guard, whichever comes first) and preserves rbp/r13/r14 (SysV callee-save), so control returns to us with rbp intact for downstream calls.  fb-banner (step 3.7): gated on [_fb_console_active] != 0 so the `-kernel` PVH boot path (fb never inits) sees a load+compare + short-jump only; on the UEFI/GOP path the 26-byte k_panic_fb_banner byte slice is handed to fb_console_puts, which drives the ANSI parser to switch SGR bold-red, print the banner, reset SGR, and end with CRLF.  Placement is BEFORE klog_ring_dump_panic so the banner sits above the dump on-screen (photograph-recoverable per design/hardware/quirks.md §2.5 no-UART fallback).",
    block: {
      // Step 1: cli — quiesce this CPU
      cli;

      // Step 2: emit panic-level klog line via klog_s1(PANIC, subsys, tag)
      //   rdi = 0 (LEVEL_PANIC)
      //   rsi = subsys_ptr (caller arg 1, currently in rdi)
      //   rdx = tag_ptr (caller arg 2, currently in rsi)
      mov rdx, rsi;       // rdx = tag_ptr (save before overwriting rsi)
      mov rsi, rdi;       // rsi = subsys_ptr (was caller arg 1 in rdi)
      mov rdi, 0;         // rdi = LEVEL_PANIC (0)
      call klog_s1;

      // Step 3: broadcast NMI IPI to halt secondary CPUs
      call panic_ipi_halt_others;

      // Step 3.5 (#716): walk the caller's rbp chain into the panic event
      // stream. klog_walk_rbp emits one FRAME line per frame (rip + rbp),
      // stopping at 32 frames, null rbp, misaligned rbp, or a non-canonical
      // (below higher-half) rbp. Placed AFTER halt-others (secondaries frozen
      // → no ring-tail contention) and BEFORE the ring drain (FRAME lines
      // land alongside the surrounding ring context on the wire).
      mov rdi, rbp;       // rdi = start_rbp = caller's frame base
      mov rsi, 32;        // rsi = max_frames
      call klog_walk_rbp;

      // Step 3.7 (R23-M3-002 #884): if the framebuffer console is live,
      // emit a bold-red '*** PANIC ***' banner via fb_console_puts BEFORE
      // the ring dump so the display shows an unmissable marker above
      // the drained ring context.  Dormant under `-kernel` PVH boot
      // (fb_console_init never ran → flag is 0 → load+compare only).
      mov rax, [rip + _fb_console_active];
      cmp rax, 0;
      je panic_fb_banner_skip;

      lea rdi, [rip + k_panic_fb_banner];  // rdi = &banner bytes
      mov rsi, 26;                          // rsi = k_panic_fb_banner_len (26)
      call fb_console_puts;

      panic_fb_banner_skip:

      // Step 4: call klog_ring_dump_panic (BEGIN + drain + END, blocking THRE)
      call klog_ring_dump_panic;

      // Step 5: isa-debug-exit via outb to port 0xf4
      //   mov dx, 0xf4         ; I/O port
      //   mov al, 0x11         ; exit code → QEMU sees (0x11 << 1) | 1 = 35
      mov dx, 0xf4;
      mov al, 0x11;
      out_al al;

      // Step 5: belt & braces — spin forever
      spin:
      cli;
      hlt;
      jmp spin;
    }
  }
}
