// src/kernel/core/klog/panic.pdx — M4-001 (#692): kernel panic handler
//
// klog_panic(subsys, tag) → () !{sysreg, mem} @{}   ; noreturn
//   Atomically emit a panic-level log line, dump the panic ring,
//   and halt the CPU via isa-debug-exit. No return.
//
// Precision: matches klog_s1 argument shape (subsys, tag) without reason_ptr.
// The tag IS the reason phrase. The log-line's fixed prefix (PANIC level,
// subsys, TSC, CPU) is synthesized by klog_s1.

module Panic = structure {
  pub let klog_panic : (u64, u64) -> () !{sysreg, mem} @{} =
    fn (subsys_ptr: u64) (tag_ptr: u64) -> unsafe {
    effects: { sysreg, mem },
    capabilities: { boot },
    justification: "M4-001 (#692): Emit panic-level klog line via klog_s1 (step 2), drain ring via klog_ring_dump_panic (step 3), exit QEMU via isa-debug-exit port 0xf4 value 0x11 (step 4), then cli+hlt spin (step 5). Re-entrancy is implicit: klog_s1 → klog_emit_core checks _klog_in_progress_bsp and no-ops on re-entry; klog_ring_dump_panic still fires (last ring bytes reach wire). Noreturn: stack frame preserved for debuggability, but function never returns.",
    block: {
      // Step 1: cli — quiesce this CPU
      cli;

      // Step 2: emit panic-level klog line via klog_s1(PANIC, subsys, tag)
      //   rdi = 0 (LEVEL_PANIC)
      //   rsi = subsys_ptr (caller arg 1, currently in rdi)
      //   rdx = tag_ptr (caller arg 2, currently in rsi)
      mov rdx, rsi;       // rdx = tag_ptr (save before overwriting rsi)
      mov rsi, rdi;       // rsi = subsys_ptr (was caller arg 1 in rdi)
      mov rdi, 0;         // rdi = LEVEL_PANIC (0)
      call klog_s1;

      // Step 3: broadcast NMI IPI to halt secondary CPUs
      call panic_ipi_halt_others;

      // Step 4: call klog_ring_dump_panic (BEGIN + drain + END, blocking THRE)
      call klog_ring_dump_panic;

      // Step 5: isa-debug-exit via outb to port 0xf4
      //   mov dx, 0xf4         ; I/O port
      //   mov al, 0x11         ; exit code → QEMU sees (0x11 << 1) | 1 = 35
      mov dx, 0xf4;
      mov al, 0x11;
      out_al al;

      // Step 5: belt & braces — spin forever
      spin:
      cli;
      hlt;
      jmp spin;
    }
  }
}
