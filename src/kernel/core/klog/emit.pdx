// src/kernel/core/klog/emit.pdx — M1-003 (#685) klog_emit_core — core emitter
// klog_emit_core(level, subsys_ptr, tag_ptr, kvs_ptr, kv_count) → ()
// Issue: #685
// [unsafe] — system register reads (cli/popfq), UART side-effect (uart_puts), memory R/W
// Audit: design/kernel/kernel-logging-substrate.md §5.6
//
// M1-003 core emitter. Filters by compile-time (KLOG_COMPILE_LEVEL) and runtime level gates,
// enforces single-writer via re-entrancy gate (_klog_in_progress_bsp), formats complete log
// line on caller's 256-byte stack buffer, and calls uart_puts. Registers: push 6 callee-save
// (rbx, rbp, r12-r15); rbx=subsys_ptr, rbp=tag_ptr, r12=kvs_ptr, r13=kv_count, r14=rsp (base),
// r15=r14 (cursor). Frame: sub rsp, 304 (buffer[256] + rflags[8] + kv_idx[8] + hex_scratch[20] +
// 12-byte pad; 288 would collide with the pushed r15 slot since u64_to_hex writes 18 bytes at [r14+272]).
// Per §5.1-5.6 of design/kernel/kernel-logging-substrate.md.

module Emit = structure {
  // klog_emit_core(level: u64, subsys_ptr: u64, tag_ptr: u64,
  //                 kvs_ptr: u64, kv_count: u64) -> () !{sysreg, mem} @{}
  // Filters by level, checks re-entrancy gate, formats and emits line to UART.
  // Inline byte-copy patterns: mov rax, [mem]; and rax, 0xff; jz (proven idiom from uart.pdx).
  // KV loop dispatches on fmt_letter 0x78 ('x') → u64_to_hex, else u64_to_dec.
  pub let klog_emit_core : (u64, u64, u64, u64, u64) -> () !{sysreg, mem} @{} =
    fn (level: u64) (subsys_ptr: u64) (tag_ptr: u64) (kvs_ptr: u64) (kv_count: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: {},
      justification: "M1-003 core emitter per §5.6. Prologue: push 6 callee-save (rbx,rbp,r12-r15); sub rsp,288; reload params into callee-save; spill level to [r14+280]. (1) Filter: cmp rdi, KLOG_COMPILE_LEVEL=3; ja skip. cmp rdi, [rip+_klog_runtime_level]; ja skip. (2) Re-entrancy: cmp qword [rip+_klog_in_progress_bsp], 0; jne skip. Set gate=1. (3) pushfq; pop rax; mov [r14+256], rax; cli. (4) Initialize r15=r14 (cursor). (5) kread_tsc → rax; u64_to_hex(tsc, r14+272); copy 16 bytes from [r14+274] to r15; store |. (6) kread_cpu_id → rax; and rax,0xF; inline nibble→ASCII; store |. (7) Reload level [r14+280] → rdi; klog_level_letter → al; store al; store |. (8) Subsys copy from rbx: mov rax,[rbx]; and rax,0xff; jz done_subsys; store byte [r15],al; inc r15; jmp loop. Store |. (9) Tag copy from rbp: same idiom. (10) KV loop: rcx=0..kv_count; spill rcx to [r14+264] per call. base=r12+rcx*24. Load {key_ptr, value, fmt_letter} from base. Emit space; key-copy; =; dispatch 0x78→u64_to_hex else u64_to_dec. (11) Store \\n, \\0. (12) mov rdi,r14; call uart_puts. Epilogue: mov rax,[r14+256]; mov rsp,rbx_temp (calc via r14+288); popfq; clear gate; add rsp,288; pop 6; ret. Byte-reads use and rax,0xff idiom. Clobbers per SysV.",
      block: {
        // Prologue: save 6 callee-save registers
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;

        // Frame: sub rsp, 288
        sub rsp, 304;

        // Setup r14 = rsp (frame base)
        mov r14, rsp;

        // Reload parameters into callee-save registers
        mov rbx, rsi;                               // rbx = subsys_ptr
        mov rbp, rdx;                               // rbp = tag_ptr
        mov r12, rcx;                               // r12 = kvs_ptr
        mov r13, r8;                                // r13 = kv_count
        // rdi = level (already in correct register)

        // Spill level to [r14+280] for later use in step 8
        mov [r14 + 280], rdi;

        // ====================================================================
        // Step 1-2: Level filter (compile-time and runtime)
        // ====================================================================
        cmp rdi, 3;                                 // KLOG_COMPILE_LEVEL = 3
        ja emit_skip;

        mov rax, [rip + _klog_runtime_level];
        cmp rdi, rax;
        ja emit_skip;

        // ====================================================================
        // Step 3: Re-entrancy gate check
        // ====================================================================
        mov rax, [rip + _klog_in_progress_bsp];
        cmp rax, 0;
        jne emit_skip;

        // Set gate to 1
        mov rax, 1;
        mov [rip + _klog_in_progress_bsp], rax;

        // ====================================================================
        // Step 4: Save RFLAGS, cli
        // ====================================================================
        pushfq;
        pop rax;
        mov [r14 + 256], rax;                       // Save RFLAGS at offset 256
        cli;

        // ====================================================================
        // Step 5: Initialize cursor (r15 = r14)
        // ====================================================================
        mov r15, r14;

        // ====================================================================
        // Step 6: TSC output (16 hex digits without "0x" prefix)
        // ====================================================================
        call kread_tsc;                             // Returns TSC in rax
        mov rdi, rax;                               // rdi = tsc value (first param)
        lea rsi, [r14 + 272];                       // rsi = scratch buffer (second param)
        call u64_to_hex;                            // Returns buf+18 in rax

        // Copy 16 hex digits (skip "0x" prefix at r14+272..+273)
        mov rcx, 16;
        lea rsi, [r14 + 274];                       // Skip "0x" prefix
        tsc_copy_loop:
        mov al, [rsi];
        mov [r15], al;
        inc rsi;
        inc r15;
        dec rcx;
        cmp rcx, 0;
        jne tsc_copy_loop;

        // Store '|'
        mov al, 0x7C;
        mov [r15], al;
        inc r15;

        // ====================================================================
        // Step 7: CPU ID output (1 hex nibble)
        // ====================================================================
        call kread_cpu_id;                          // Returns CPU ID in rax
        and rax, 0xF;                               // Mask to 4 bits

        // Convert nibble to ASCII: 0-9 → 0x30-0x39, 10-15 → 0x61-0x66
        cmp rax, 10;
        jb cpu_digit_0_9;
        add rax, 0x57;                              // 10-15: add 0x57 → 0x61-0x66
        jmp cpu_digit_done;
        cpu_digit_0_9:
        add rax, 0x30;                              // 0-9: add 0x30 → 0x30-0x39
        cpu_digit_done:
        mov [r15], al;
        inc r15;

        // Store '|'
        mov al, 0x7C;
        mov [r15], al;
        inc r15;

        // ====================================================================
        // Step 8: Level letter output
        // ====================================================================
        mov rdi, [r14 + 280];                       // Restore level from spill
        call klog_level_letter;                     // Returns letter in rax
        mov [r15], al;
        inc r15;

        // Store '|'
        mov al, 0x7C;
        mov [r15], al;
        inc r15;

        // ====================================================================
        // Step 9: Subsys copy (4 bytes, NUL-terminated)
        // ====================================================================
        mov rsi, rbx;                               // rsi = subsys_ptr
        subsys_copy_loop:
        mov rax, [rsi];
        and rax, 0xff;
        jz subsys_copy_done;
        mov [r15], al;
        inc rsi;
        inc r15;
        jmp subsys_copy_loop;
        subsys_copy_done:

        // Store '|'
        mov al, 0x7C;
        mov [r15], al;
        inc r15;

        // ====================================================================
        // Step 10: Tag copy (variable length, NUL-terminated)
        // ====================================================================
        mov rsi, rbp;                               // rsi = tag_ptr
        tag_copy_loop:
        mov rax, [rsi];
        and rax, 0xff;
        jz tag_copy_done;
        mov [r15], al;
        inc rsi;
        inc r15;
        jmp tag_copy_loop;
        tag_copy_done:

        // ====================================================================
        // Step 11: KV loop (idx in rcx, base = r12 + rcx*24)
        // ====================================================================
        xor rcx, rcx;                               // rcx = 0 (kv index)
        kv_loop_start:
        cmp rcx, r13;                               // Compare idx vs kv_count
        jge kv_loop_end;

        // Spill kv_idx to [r14+264] for nested calls
        mov [r14 + 264], rcx;

        // Calculate base = r12 + rcx*24
        mov rax, rcx;
        mov r8, 24;
        imul rax, r8;                               // Multiply by 24
        add rax, r12;                               // rax = base of kv entry

        // Load key_ptr from base[0], value from base[8], fmt_letter from base[16]
        mov r9, [rax];                              // r9 = key_ptr
        mov r10, [rax + 8];                         // r10 = value
        mov r11, [rax + 16];                        // r11 = fmt_letter (as u64, will mask to byte later)
        and r11, 0xFF;                              // Mask to byte

        // Emit space
        mov al, 0x20;
        mov [r15], al;
        inc r15;

        // Copy key (NUL-terminated byte-by-byte)
        mov rsi, r9;                                // rsi = key_ptr
        kv_key_copy:
        mov rax, [rsi];
        and rax, 0xff;
        jz kv_key_done;
        mov [r15], al;
        inc rsi;
        inc r15;
        jmp kv_key_copy;
        kv_key_done:

        // Emit '='
        mov al, 0x3D;
        mov [r15], al;
        inc r15;

        // Dispatch on fmt_letter: 0x78 ('x') → hex, else → dec
        cmp r11, 0x78;
        je kv_emit_hex;

        // Decimal path
        mov rdi, r10;                               // rdi = value (first param)
        lea rsi, [r15];                             // rsi = cursor (second param, for append)
        call u64_to_dec;                            // Returns buf+length in rax
        mov r15, rax;                               // Update cursor
        jmp kv_value_done;

        kv_emit_hex:
        // Hex path
        mov rdi, r10;                               // rdi = value (first param)
        lea rsi, [r14 + 272];                       // rsi = scratch buffer (second param)
        call u64_to_hex;                            // Returns buf+18 in rax

        // Copy all 18 bytes ("0x"+16 nibbles) from scratch
        mov rcx, 18;
        lea rsi, [r14 + 272];
        kv_hex_copy:
        mov al, [rsi];
        mov [r15], al;
        inc rsi;
        inc r15;
        dec rcx;
        cmp rcx, 0;
        jne kv_hex_copy;

        kv_value_done:
        // Restore kv_idx and loop
        mov rcx, [r14 + 264];
        inc rcx;
        jmp kv_loop_start;

        kv_loop_end:

        // ====================================================================
        // Step 12: Emit newline and NUL-terminator
        // ====================================================================
        mov al, 0x0A;                               // '\n'
        mov [r15], al;
        inc r15;
        xor rax, rax;                               // '\0'
        mov [r15], al;

        // ====================================================================
        // Step 13: Call uart_puts with buffer address
        // ====================================================================
        mov rdi, r14;                               // rdi = buffer address
        call uart_puts;

        // ====================================================================
        // Step 14: Epilogue
        // ====================================================================
        // Restore RFLAGS: pushfq pushes to rsp, so to restore:
        mov rax, [r14 + 256];
        pushfq;                                     // Create space
        mov [rsp], rax;                             // Place RFLAGS
        popfq;                                      // Restore

        // Clear re-entrancy gate
        xor rax, rax;
        mov [rip + _klog_in_progress_bsp], rax;

        // Return to epilogue
        add rsp, 304;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret;

        // ====================================================================
        // Skip path (level filtered or gate set)
        // ====================================================================
        emit_skip:
        add rsp, 304;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret;
      }
    }
}
