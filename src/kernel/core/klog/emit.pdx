// src/kernel/core/klog/emit.pdx — M1-003 (#685) klog_emit_core — core emitter
//                                  R51 rewrite: human-readable transcript prefix
// klog_emit_core(level, subsys_ptr, tag_ptr, kvs_ptr, kv_count) → ()
// Issue: #685
// [unsafe] — system register reads (cli/popfq), UART side-effect (via klog_ring_drain_to_uart), memory R/W
// Audit: design/kernel/kernel-logging-substrate.md §5.6
//        design/kernel/boot-transcript.md §2.1, §4.1  (SUPERSEDES wire format for steps 6..10)
//
// R51 changed the emitted prefix from the machine-readable
//   <hex-timestamp>|<cpu>|<lvl-letter>|<4char-subsys>|<message>
// to the human-readable
//   [  <sssss>.<uuuuuu>] <LEVEL> cpu<N> <subsystem>: <message>
// The rest of the emitter is unchanged: level filter, re-entrancy gate,
// cli window, KV loop, ring write + drain, audit forward.
//
// Timestamp is elapsed µs since the first klog line — see
// format.pdx::klog_ts_read_delta_usec for the latch discipline. Level
// is a five-character word from level.pdx::LEVEL_WORDS. Subsystem
// widens from a fixed 4-character tag to a variable lowercase word
// right-padded to KLOG_SUBSYS_COLUMN_WIDTH (subsys.pdx). CPU column is
// `cpu` + one hex digit + trailing space.
//
// M1-003 core emitter. Filters by compile-time (KLOG_COMPILE_LEVEL) and runtime level gates,
// enforces single-writer via re-entrancy gate (_klog_in_progress_bsp), formats complete log
// line on caller's 256-byte stack buffer, writes it to the klog ring (drained to UART).
// M2-001 (#687) replaced the direct uart_puts call with klog_ring_write +
// klog_ring_drain_to_uart. Registers: push 6 callee-save
// (rbx, rbp, r12-r15); rbx=subsys_ptr, rbp=tag_ptr, r12=kvs_ptr, r13=kv_count, r14=rsp (base),
// r15=r14 (cursor). Frame: sub rsp, 304 (buffer[256] + rflags[8] + kv_idx[8] + hex_scratch[20] +
// 12-byte pad; 288 would collide with the pushed r15 slot since u64_to_hex writes 18 bytes at [r14+272]).
// #713: the level spill (needed across steps 6-7 while rdi is clobbered by kread_tsc/u64_to_hex/
// kread_cpu_id) lives at [r14+292], inside the 12-byte pad — NOT at [r14+280], which overlaps
// hex_scratch's [272..290) write range and got silently clobbered by the TSC hex digits.
// R51 reuses [r14+264] (formerly kv_idx spill during step 11) as a step-6 usec spill: the
// two writes are disjoint in time — step 6 completes before step 11 first stores kv_idx —
// and the byte range is otherwise unclaimed.
// Per §5.1-5.6 of design/kernel/kernel-logging-substrate.md.

module Emit = structure {
  // klog_emit_core(level: u64, subsys_ptr: u64, tag_ptr: u64,
  //                 kvs_ptr: u64, kv_count: u64) -> () !{sysreg, mem} @{}
  // Filters by level, checks re-entrancy gate, formats and emits line to UART.
  // Inline byte-copy patterns: mov rax, [mem]; and rax, 0xff; jz (proven idiom from uart.pdx).
  // KV loop dispatches on fmt_letter 0x78 ('x') → u64_to_hex, else u64_to_dec.
  pub let klog_emit_core : (u64, u64, u64, u64, u64) -> () !{sysreg, mem} @{} =
    fn (level: u64) (subsys_ptr: u64) (tag_ptr: u64) (kvs_ptr: u64) (kv_count: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: {},
      justification: "M1-003 core emitter per §5.6. Prologue: push 6 callee-save (rbx,rbp,r12-r15); sub rsp,304; reload params into callee-save; spill level to [r14+292] (#713: was [r14+280], which overlapped hex_scratch [272..290) and got clobbered by step 6's TSC hex digits). (1) Filter: cmp rdi, KLOG_COMPILE_LEVEL=3; ja skip. cmp rdi, [rip+_klog_runtime_level]; ja skip. (2) Re-entrancy: cmp qword [rip+_klog_in_progress_bsp], 0; jne skip. Set gate=1. (3) pushfq; pop rax; mov [r14+256], rax; cli. (4) Initialize r15=r14 (cursor). (5) kread_tsc → rax; u64_to_hex(tsc, r14+272); copy 16 bytes from [r14+274] to r15; store |. (6) kread_cpu_id → rax; and rax,0xF; inline nibble→ASCII; store |. (7) Reload level [r14+292] → rdi; klog_level_letter → al; store al; store |. (8) Subsys copy from rbx: mov rax,[rbx]; and rax,0xff; jz done_subsys; store byte [r15],al; inc r15; jmp loop. Store |. (9) Tag copy from rbp: same idiom. (10) KV loop: rcx=0..kv_count; spill rcx to [r14+264] per call. base=r12+rcx*24. Load {key_ptr, value, fmt_letter} from base. Emit space; key-copy; =; dispatch 0x78→u64_to_hex else u64_to_dec. (11) Store \\n, \\0. (12) mov rdi,r14 (buf ptr); mov rsi,r15; sub rsi,r14 (byte count incl \\n, excl NUL); call klog_ring_write (M2-001 #687); call klog_ring_drain_to_uart (non-spinning THRE-poll drain). Epilogue: mov rax,[r14+256]; mov rsp,rbx_temp (calc via r14+288); popfq; clear gate; add rsp,288; pop 6; ret. Byte-reads use and rax,0xff idiom. Clobbers per SysV.",
      block: {
        // Prologue: save 6 callee-save registers
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;

        // Frame: sub rsp, 288
        sub rsp, 304;

        // Setup r14 = rsp (frame base)
        mov r14, rsp;

        // Reload parameters into callee-save registers
        mov rbx, rsi;                               // rbx = subsys_ptr
        mov rbp, rdx;                               // rbp = tag_ptr
        mov r12, rcx;                               // r12 = kvs_ptr
        mov r13, r8;                                // r13 = kv_count
        // rdi = level (already in correct register)

        // Spill level to [r14+292] for later use in step 8.
        // #713: offset 280 collides with hex_scratch [272..290) (u64_to_hex
        // writes 18 bytes there in step 6), clobbering the spilled level
        // with TSC hex-digit bytes before step 8 reloads it, which then
        // feeds a huge index into klog_level_letter's table lookup and
        // faults on a non-canonical address. 292 sits in the 12-byte pad
        // (292..303), which no other step writes.
        mov [r14 + 292], rdi;

        // ====================================================================
        // Step 1-2: Level filter (compile-time and runtime)
        // ====================================================================
        cmp rdi, 3;                                 // KLOG_COMPILE_LEVEL = 3
        ja emit_skip;

        mov rax, [rip + _klog_runtime_level];
        cmp rdi, rax;
        ja emit_skip;

        // ====================================================================
        // Step 3: Re-entrancy gate check
        // ====================================================================
        mov rax, [rip + _klog_in_progress_bsp];
        cmp rax, 0;
        jne emit_skip;

        // Set gate to 1
        mov rax, 1;
        mov [rip + _klog_in_progress_bsp], rax;

        // ====================================================================
        // Step 4: Save RFLAGS, cli
        // ====================================================================
        pushfq;
        pop rax;
        mov [r14 + 256], rax;                       // Save RFLAGS at offset 256
        cli;

        // ====================================================================
        // Step 5: Initialize cursor (r15 = r14)
        // ====================================================================
        mov r15, r14;

        // ====================================================================
        // Step 6: Timestamp column — `[  <sssss>.<uuuuuu>] `
        // ====================================================================
        // R51 boot-transcript §3.1 / §4.1. Replaces the 16-hex-digit raw
        // TSC dump with an elapsed-µs column that opens on `[    0.000000]`
        // (Linux-dmesg convention).  On the very first klog line
        // klog_ts_read_delta_usec latches _klog_t0 = rdtsc and returns 0;
        // every subsequent line returns (rdtsc - _klog_t0) / ticks_per_µs.
        // Pre-calibration the divisor is _klog_ts_prehpet_divisor (2500,
        // QEMU-typical 2.5 GHz); post-calibration it is _tsc_hz / 1e6.

        // Emit '['.
        mov rax, 0x5B;
        mov [r15], al;
        add r15, 1;

        // Compute delta_µs.
        call klog_ts_read_delta_usec;               // rax = delta µs

        // Split delta_µs into seconds (rax / 1_000_000) and remainder
        // microseconds (rdx after div).  Spill the microseconds into
        // [r14+264] so we can reuse rax for the seconds format call —
        // [r14+264] is otherwise idle until step 11's kv_idx spill,
        // which starts after this whole prefix has been emitted.
        mov rcx, 1000000;
        xor rdx, rdx;
        div rcx;                                    // rax = sec, rdx = µs_rem
        mov [r14 + 264], rdx;                       // spill µs_rem

        // Format seconds — 5 columns, right-justified, space-padded.
        mov rdi, rax;                               // value
        mov rsi, r15;                               // buf cursor
        mov rdx, 5;                                 // width
        call u64_to_dec_rpad;                       // rax = new cursor
        mov r15, rax;

        // Emit '.'.
        mov rax, 0x2E;
        mov [r15], al;
        add r15, 1;

        // Format microseconds — 6 columns, zero-padded.
        mov rdi, [r14 + 264];                       // reload µs_rem
        mov rsi, r15;
        mov rdx, 6;
        call u64_to_dec_zpad;                       // rax = new cursor
        mov r15, rax;

        // Emit ']' and trailing space.
        mov rax, 0x5D;
        mov [r15], al;
        add r15, 1;
        mov rax, 0x20;
        mov [r15], al;
        add r15, 1;

        // ====================================================================
        // Step 7: Level column — 5-char word + trailing space
        // ====================================================================
        // R51 boot-transcript §3.2.  Replaces the single letter with a
        // fixed 5-character word (PANIC / ERROR / WARN  / INFO  / DEBUG /
        // TRACE — see level.pdx::LEVEL_WORDS).  The klog_level_word
        // helper returns a pointer to the first byte of the level word;
        // we copy exactly five bytes and append one trailing space.

        mov rdi, [r14 + 292];                       // reload level (#713 spill slot)
        call klog_level_word;                       // rax = ptr to 5-byte word
        mov rsi, rax;
        mov rcx, 5;
      level_word_copy:
        mov al, [rsi];
        mov [r15], al;
        add rsi, 1;
        add r15, 1;
        sub rcx, 1;
        cmp rcx, 0;
        jne level_word_copy;

        // Trailing space between level and CPU columns.
        mov rax, 0x20;
        mov [r15], al;
        add r15, 1;

        // ====================================================================
        // Step 8: CPU column — `cpu<N> `
        // ====================================================================
        // R51 boot-transcript §3.3.  The literal `cpu` prefix (3 columns)
        // eliminates the misread where a standalone `0` in the old format
        // looked like a level to first-time readers.  Width-2 CPU support
        // (§3.3 second paragraph) is a future extension: it would emit
        // two hex digits uniformly across the boot, gated on a boot-wide
        // sentinel; today we always emit one hex digit.

        mov rax, 0x63;                              // 'c'
        mov [r15], al;
        add r15, 1;
        mov rax, 0x70;                              // 'p'
        mov [r15], al;
        add r15, 1;
        mov rax, 0x75;                              // 'u'
        mov [r15], al;
        add r15, 1;

        call kread_cpu_id;                          // rax = CPU id
        and rax, 0xF;                               // mask to 4 bits
        cmp rax, 10;
        jb cpu_digit_0_9;
        add rax, 0x57;                              // 10..15 → 'a'..'f'
        jmp cpu_digit_done;
      cpu_digit_0_9:
        add rax, 0x30;                              // 0..9   → '0'..'9'
      cpu_digit_done:
        mov [r15], al;
        add r15, 1;

        // Trailing space between CPU and subsystem columns.
        mov rax, 0x20;
        mov [r15], al;
        add r15, 1;

        // ====================================================================
        // Step 9: Subsystem column — NUL-copy then right-pad to 8 columns
        // ====================================================================
        // R51 boot-transcript §3.4.  Subsys strings widened from fixed
        // 4-char tags (`MM__`, `CAP_`) to lowercase words (`memory`,
        // `cap`) up to 8 bytes.  The composer walks the NUL-terminated
        // string counting bytes, then space-pads to reach
        // KLOG_SUBSYS_COLUMN_WIDTH (8) so every printed row is square.
        // A 9-character future subsystem grows the field boot-wide
        // (matching the CPU-column widening discipline).

        mov rsi, rbx;                               // rsi = subsys_ptr
        xor rcx, rcx;                               // rcx = printed count
      subsys_copy_loop:
        mov rax, [rsi];
        and rax, 0xff;
        jz subsys_pad_start;
        mov [r15], al;
        add rsi, 1;
        add r15, 1;
        add rcx, 1;
        jmp subsys_copy_loop;

      subsys_pad_start:
        // Space-pad until printed count reaches KLOG_SUBSYS_COLUMN_WIDTH.
      subsys_pad_loop:
        cmp rcx, 8;
        jae subsys_pad_done;
        mov rax, 0x20;
        mov [r15], al;
        add r15, 1;
        add rcx, 1;
        jmp subsys_pad_loop;
      subsys_pad_done:

        // ====================================================================
        // Step 10: `: ` — the prefix/message boundary
        // ====================================================================
        // The single space after `:` is the only whitespace between the
        // fixed-column prefix (32 bytes total) and the free-form message
        // that follows.  A monospaced reader sees the message always
        // starting at column 33.

        mov rax, 0x3A;                              // ':'
        mov [r15], al;
        add r15, 1;
        mov rax, 0x20;                              // ' '
        mov [r15], al;
        add r15, 1;

        // ====================================================================
        // Step 10.5: Tag copy (variable length, NUL-terminated) — MESSAGE BODY
        // ====================================================================
        // Under R51 the tag string IS the message body (§3.5 keeps the
        // message content untouched — Phase A/B is prefix-only, Phase C
        // rewrites message content subsystem-by-subsystem).
        mov rsi, rbp;                               // rsi = tag_ptr
        tag_copy_loop:
        mov rax, [rsi];
        and rax, 0xff;
        jz tag_copy_done;
        mov [r15], al;
        inc rsi;
        inc r15;
        jmp tag_copy_loop;
        tag_copy_done:

        // ====================================================================
        // Step 11: KV loop (idx in rcx, base = r12 + rcx*24)
        // ====================================================================
        xor rcx, rcx;                               // rcx = 0 (kv index)
        kv_loop_start:
        cmp rcx, r13;                               // Compare idx vs kv_count
        jge kv_loop_end;

        // Spill kv_idx to [r14+264] for nested calls
        mov [r14 + 264], rcx;

        // Calculate base = r12 + rcx*24
        mov rax, rcx;
        mov r8, 24;
        imul rax, r8;                               // Multiply by 24
        add rax, r12;                               // rax = base of kv entry

        // Load key_ptr from base[0], value from base[8], fmt_letter from base[16]
        mov r9, [rax];                              // r9 = key_ptr
        mov r10, [rax + 8];                         // r10 = value
        mov r11, [rax + 16];                        // r11 = fmt_letter (as u64, will mask to byte later)
        and r11, 0xFF;                              // Mask to byte

        // Emit space
        mov al, 0x20;
        mov [r15], al;
        inc r15;

        // Copy key (NUL-terminated byte-by-byte)
        mov rsi, r9;                                // rsi = key_ptr
        kv_key_copy:
        mov rax, [rsi];
        and rax, 0xff;
        jz kv_key_done;
        mov [r15], al;
        inc rsi;
        inc r15;
        jmp kv_key_copy;
        kv_key_done:

        // Emit '='
        mov al, 0x3D;
        mov [r15], al;
        inc r15;

        // Dispatch on fmt_letter: 0x78 ('x') → hex, else → dec
        cmp r11, 0x78;
        je kv_emit_hex;

        // Decimal path
        mov rdi, r10;                               // rdi = value (first param)
        lea rsi, [r15];                             // rsi = cursor (second param, for append)
        call u64_to_dec;                            // Returns buf+length in rax
        mov r15, rax;                               // Update cursor
        jmp kv_value_done;

        kv_emit_hex:
        // Hex path
        mov rdi, r10;                               // rdi = value (first param)
        lea rsi, [r14 + 272];                       // rsi = scratch buffer (second param)
        call u64_to_hex;                            // Returns buf+18 in rax

        // Copy all 18 bytes ("0x"+16 nibbles) from scratch
        mov rcx, 18;
        lea rsi, [r14 + 272];
        kv_hex_copy:
        mov al, [rsi];
        mov [r15], al;
        inc rsi;
        inc r15;
        dec rcx;
        cmp rcx, 0;
        jne kv_hex_copy;

        kv_value_done:
        // Restore kv_idx and loop
        mov rcx, [r14 + 264];
        inc rcx;
        jmp kv_loop_start;

        kv_loop_end:

        // ====================================================================
        // Step 12: Emit newline and NUL-terminator
        // ====================================================================
        mov al, 0x0A;                               // '\n'
        mov [r15], al;
        inc r15;
        xor rax, rax;                               // '\0'
        mov [r15], al;

        // ====================================================================
        // Step 13: Write to ring buffer and drain
        // ====================================================================
        // R49.M1-002 (#1572): release-mode UART mute. Ring-buffer write
        // is unconditional (dmesg + audit history stay intact so post-
        // mortem tooling keeps working), but the drain-to-UART is gated
        // on _kernel_build_mode. TEST mode (default 0) drains as
        // before, so the fingerprint stream stays byte-identical to
        // the pre-R49 tree; RELEASE (=1) skips the drain and the only
        // bytes that reach COM1 are what the Present module explicitly
        // emits via uart_putc (uart_puts is separately muted; see
        // src/kernel/boot/uart.pdx). rax is dead here — the last live
        // load into it (step 12) happened before this block.
        mov rdi, r14;                               // rdi = buffer address
        mov rsi, r15;                               // rsi = cursor (length = cursor - base)
        sub rsi, r14;                               // rsi = length (bytes written including \n, excluding \0)
        call klog_ring_write;
        mov rax, [rip + _kernel_build_mode];
        cmp rax, 0;
        jne klog_drain_muted;
        call klog_ring_drain_to_uart;
        klog_drain_muted:

        // ====================================================================
        // Step 13.5: audit-log bridge — logging-m9-003 (#710)
        //
        // Filter (PANIC + ERROR) and append the rendered line into the
        // in-kernel audit ring. Drop-oldest overflow discipline lives
        // inside klog_audit_forward; here we only pass level + line
        // pointer + line length. The forward is a pure memory op — no
        // vfs / tmpfs / lock touched — so it is safe to invoke inside
        // the re-entrancy gate + cli window. See audit.pdx file-level
        // comment for the "why fs writes cannot land here" analysis.
        //
        // Register plan:
        //   arg0 (rdi) = level — reload from spill slot [r14+292], same
        //                slot step 8's klog_level_letter reads (not
        //                clobbered between).
        //   arg1 (rsi) = buffer address = r14 (frame base).
        //   arg2 (rdx) = length (cursor - base), recomputed identically
        //                to step 13's rsi.
        //
        // The three level/rsi/rdx registers were clobbered by
        // klog_ring_write / klog_ring_drain_to_uart above, so all three
        // are re-materialized here.
        // ====================================================================
        mov rdi, [r14 + 292];                       // reload level from spill
        mov rsi, r14;                               // buffer address
        mov rdx, r15;
        sub rdx, r14;                               // length
        call klog_audit_forward;

        // ====================================================================
        // Step 14: Epilogue
        // ====================================================================
        // Restore RFLAGS: pushfq pushes to rsp, so to restore:
        mov rax, [r14 + 256];
        pushfq;                                     // Create space
        mov [rsp], rax;                             // Place RFLAGS
        popfq;                                      // Restore

        // Clear re-entrancy gate
        xor rax, rax;
        mov [rip + _klog_in_progress_bsp], rax;

        // Return to epilogue
        add rsp, 304;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret;

        // ====================================================================
        // Skip path (level filtered or gate set)
        // ====================================================================
        emit_skip:
        add rsp, 304;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret;
      }
    }
}
