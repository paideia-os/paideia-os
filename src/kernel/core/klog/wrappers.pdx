// src/kernel/core/klog/wrappers.pdx — M1-004 (#686) per-arity wrappers
// Issue: #686
// [unsafe] — marshalls args into stack KV table, tail-calls klog_emit_core
// Audit: design/kernel/kernel-logging-substrate.md §5.2
//
// M1-004 per-arity wrappers. Each wrapper marshals its arguments into a caller-stack
// KV table and tail-calls klog_emit_core(level, subsys_ptr, tag_ptr, kvs_ptr, kv_count).
// All wrappers preserve rbx, r12-r15 (SysV callee-save). Stack alignment maintained:
// sub rsp, N rounded to 16B ensures rsp ≡ 0 mod 16 immediately before call.
// KV entry layout: {key_ptr @+0, value @+8, fmt_letter @+16} (24 bytes per entry).

module Wrappers = structure {

  // ============================================================================
  // klog_s1: 0 KV entries (level, subsys, tag in registers)
  // ============================================================================
  // Args: rdi=level, rsi=subsys_ptr, rdx=tag_ptr (all regs, no stack)
  // KV table: empty (0 entries, kvs_ptr=0, kv_count=0)
  // Stack frame: none (no frame needed for 0 KVs)
  pub let klog_s1 : (u64, u64, u64) -> () !{sysreg, mem} @{} =
    fn (level: u64) (subsys_ptr: u64) (tag_ptr: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: {},
      justification: "M1-004 0-arity wrapper. Parameters already in correct SysV registers. No frame, no KV table. Tail-call klog_emit_core with kvs_ptr=0, kv_count=0.",
      block: {
        xor rcx, rcx;                  // rcx = kvs_ptr = 0
        xor r8, r8;                    // r8 = kv_count = 0
        call klog_emit_core;
        ret;
      }
    } @no_frame

  // ============================================================================
  // klog_s1_x1: 1 hex KV entry
  // ============================================================================
  // Args: rdi=level, rsi=subsys_ptr, rdx=tag_ptr, rcx=key1, r8=value1
  // Stack frame: 32 bytes (1 KV × 24 + 8 align)
  pub let klog_s1_x1 : (u64, u64, u64, u64, u64) -> () !{sysreg, mem} @{} =
    fn (level: u64) (subsys_ptr: u64) (tag_ptr: u64) (key1: u64) (value1: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: {},
      justification: "M1-004 1-arity hex wrapper. Save key1 (rcx) and value1 (r8) on stack before clobbering rcx/r8 for emit call. Frame: push rbp; mov rbp,rsp; sub rsp,32. KV[0] at [rbp-32..-9]: key_ptr=key1, value=value1, fmt_letter=0x78. Epilogue: add rsp,32; pop rbp; ret.",
      block: {
        push rbp;
        mov rbp, rsp;
        sub rsp, 32;

        // Store KV[0]: {key1, value1, fmt='x'}
        mov rax, rcx;                  // rax = key1
        mov [rbp - 32], rax;           // KV[0].key_ptr
        mov rax, r8;                   // rax = value1
        mov [rbp - 24], rax;           // KV[0].value
        mov rax, 0x78;                 // fmt_letter = 'x'
        mov [rbp - 16], rax;           // KV[0].fmt_letter

        // Call klog_emit_core(level, subsys_ptr, tag_ptr, kvs_ptr, kv_count)
        lea rcx, [rbp - 32];           // rcx = kvs_ptr (address of KV[0])
        mov r8, 1;                     // r8 = kv_count = 1
        call klog_emit_core;

        add rsp, 32;
        pop rbp;
        ret;
      }
    } @no_frame

  // ============================================================================
  // klog_s1_x2: 2 hex KV entries
  // ============================================================================
  // Args: rdi=level, rsi=subsys_ptr, rdx=tag_ptr, rcx=k1, r8=v1, r9=k2, [rsp+8]=v2
  // Stack frame: 48 bytes (2 KVs × 24)
  pub let klog_s1_x2 : (u64, u64, u64, u64, u64, u64) -> () !{sysreg, mem} @{} =
    fn (level: u64) (subsys_ptr: u64) (tag_ptr: u64) (k1: u64) (v1: u64) (k2: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: {},
      justification: "M1-004 2-arity hex wrapper. paideia-as limited to 6 params; caller pushes [rsp+8]=v2 before call. After push rbp, v2 becomes [rbp+16].",
      block: {
        push rbp;
        mov rbp, rsp;
        sub rsp, 48;

        // Store KV[0]: {k1, v1, fmt='x'}
        mov rax, rcx;                  // rax = k1
        mov [rbp - 48], rax;           // KV[0].key_ptr
        mov rax, r8;                   // rax = v1
        mov [rbp - 40], rax;           // KV[0].value
        mov rax, 0x78;
        mov [rbp - 32], rax;           // KV[0].fmt_letter

        // Store KV[1]: {k2, v2, fmt='x'}
        mov rax, r9;                   // rax = k2
        mov [rbp - 24], rax;           // KV[1].key_ptr
        mov rax, [rbp + 16];           // rax = v2 (7th arg from caller stack)
        mov [rbp - 16], rax;           // KV[1].value
        mov rax, 0x78;
        mov [rbp - 8], rax;            // KV[1].fmt_letter

        // Call klog_emit_core
        lea rcx, [rbp - 48];           // rcx = kvs_ptr
        mov r8, 2;                     // r8 = kv_count = 2
        call klog_emit_core;

        add rsp, 48;
        pop rbp;
        ret;
      }
    } @no_frame

  // ============================================================================
  // klog_s1_x3: 3 hex KV entries (caller passes extra args on stack)
  // ============================================================================
  // Args: rdi=level, rsi=subsys_ptr, rdx=tag_ptr, rcx=k1, r8=v1, r9=k2;
  //       stack: [rsp+8]=v2, [rsp+16]=k3, [rsp+24]=v3 (passed by caller before call)
  // Stack frame: 80 bytes (3 KVs × 24 + 8 pad)
  // Signature limited to 6 params due to paideia-as ABI constraint; caller passes rest on stack
  pub let klog_s1_x3 : (u64, u64, u64, u64, u64, u64) -> () !{sysreg, mem} @{} =
    fn (level: u64) (subsys_ptr: u64) (tag_ptr: u64) (k1: u64) (v1: u64) (k2: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: {},
      justification: "M1-004 3-arity hex wrapper. paideia-as limited to 6 params; caller pushes [rsp+8]=v2, [rsp+16]=k3, [rsp+24]=v3 before call. After push rbp, these become [rbp+16], [rbp+24], [rbp+32].",
      block: {
        push rbp;
        mov rbp, rsp;
        sub rsp, 80;

        // Store KV[0]: {k1, v1, fmt='x'}
        mov rax, rcx;
        mov [rbp - 80], rax;           // KV[0].key_ptr
        mov rax, r8;
        mov [rbp - 72], rax;           // KV[0].value
        mov rax, 0x78;
        mov [rbp - 64], rax;           // KV[0].fmt_letter

        // Store KV[1]: {k2, v2, fmt='x'}
        mov rax, r9;
        mov [rbp - 56], rax;           // KV[1].key_ptr
        mov rax, [rbp + 16];
        mov [rbp - 48], rax;           // KV[1].value (v2 from stack)
        mov rax, 0x78;
        mov [rbp - 40], rax;           // KV[1].fmt_letter

        // Store KV[2]: {k3, v3, fmt='x'}
        mov rax, [rbp + 24];
        mov [rbp - 32], rax;           // KV[2].key_ptr (k3 from stack)
        mov rax, [rbp + 32];
        mov [rbp - 24], rax;           // KV[2].value (v3 from stack)
        mov rax, 0x78;
        mov [rbp - 16], rax;           // KV[2].fmt_letter

        // Call klog_emit_core
        lea rcx, [rbp - 80];
        mov r8, 3;
        call klog_emit_core;

        add rsp, 80;
        pop rbp;
        ret;
      }
    } @no_frame

  // ============================================================================
  // klog_s1_x4: 4 hex KV entries (caller passes extra args on stack)
  // ============================================================================
  // Args: rdi=level, rsi=subsys_ptr, rdx=tag_ptr, rcx=k1, r8=v1, r9=k2;
  //       stack: [rsp+8]=v2, [rsp+16]=k3, [rsp+24]=v3, [rsp+32]=k4, [rsp+40]=v4
  // Stack frame: 96 bytes (4 KVs × 24)
  // Signature limited to 6 params due to paideia-as ABI constraint
  pub let klog_s1_x4 : (u64, u64, u64, u64, u64, u64) -> () !{sysreg, mem} @{} =
    fn (level: u64) (subsys_ptr: u64) (tag_ptr: u64) (k1: u64) (v1: u64) (k2: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: {},
      justification: "M1-004 4-arity hex wrapper. paideia-as limited to 6 params; caller pushes stack args before call. After push rbp, [rbp+16]=v2, [rbp+24]=k3, [rbp+32]=v3, [rbp+40]=k4, [rbp+48]=v4.",
      block: {
        push rbp;
        mov rbp, rsp;
        sub rsp, 96;

        // Store KV[0]: {k1, v1, fmt='x'}
        mov rax, rcx;
        mov [rbp - 96], rax;
        mov rax, r8;
        mov [rbp - 88], rax;
        mov rax, 0x78;
        mov [rbp - 80], rax;

        // Store KV[1]: {k2, v2, fmt='x'}
        mov rax, r9;
        mov [rbp - 72], rax;
        mov rax, [rbp + 16];
        mov [rbp - 64], rax;
        mov rax, 0x78;
        mov [rbp - 56], rax;

        // Store KV[2]: {k3, v3, fmt='x'}
        mov rax, [rbp + 24];
        mov [rbp - 48], rax;
        mov rax, [rbp + 32];
        mov [rbp - 40], rax;
        mov rax, 0x78;
        mov [rbp - 32], rax;

        // Store KV[3]: {k4, v4, fmt='x'}
        mov rax, [rbp + 40];
        mov [rbp - 24], rax;
        mov rax, [rbp + 48];
        mov [rbp - 16], rax;
        mov rax, 0x78;
        mov [rbp - 8], rax;

        // Call klog_emit_core
        lea rcx, [rbp - 96];
        mov r8, 4;
        call klog_emit_core;

        add rsp, 96;
        pop rbp;
        ret;
      }
    } @no_frame

  // ============================================================================
  // klog_s1_d1: 1 decimal KV entry
  // ============================================================================
  // Args: rdi=level, rsi=subsys_ptr, rdx=tag_ptr, rcx=key1, r8=value1
  // Stack frame: 32 bytes (same as x1, but fmt_letter=0x64 for decimal)
  pub let klog_s1_d1 : (u64, u64, u64, u64, u64) -> () !{sysreg, mem} @{} =
    fn (level: u64) (subsys_ptr: u64) (tag_ptr: u64) (key1: u64) (value1: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: {},
      justification: "M1-004 1-arity decimal wrapper. Same as klog_s1_x1 but fmt_letter=0x64 ('d') instead of 0x78 ('x').",
      block: {
        push rbp;
        mov rbp, rsp;
        sub rsp, 32;

        // Store KV[0]: {key1, value1, fmt='d'}
        mov rax, rcx;
        mov [rbp - 32], rax;           // KV[0].key_ptr
        mov rax, r8;
        mov [rbp - 24], rax;           // KV[0].value
        mov rax, 0x64;                 // fmt_letter = 'd'
        mov [rbp - 16], rax;           // KV[0].fmt_letter

        // Call klog_emit_core
        lea rcx, [rbp - 32];
        mov r8, 1;
        call klog_emit_core;

        add rsp, 32;
        pop rbp;
        ret;
      }
    } @no_frame

  // ============================================================================
  // klog_s1_x1_d1: 2 KV entries (1 hex, 1 decimal; caller passes extra arg on stack)
  // ============================================================================
  // Args: rdi=level, rsi=subsys_ptr, rdx=tag_ptr, rcx=kx, r8=vx, r9=kd;
  //       stack: [rsp+8]=vd (7th arg, passed by caller before call)
  // Stack frame: 48 bytes (2 KVs × 24)
  // Signature limited to 6 params due to paideia-as ABI constraint
  pub let klog_s1_x1_d1 : (u64, u64, u64, u64, u64, u64) -> () !{sysreg, mem} @{} =
    fn (level: u64) (subsys_ptr: u64) (tag_ptr: u64) (kx: u64) (vx: u64) (kd: u64) -> unsafe {
      effects: { sysreg, mem },
      capabilities: {},
      justification: "M1-004 1-hex+1-decimal wrapper. paideia-as limited to 6 params; caller pushes [rsp+8]=vd before call. After push rbp, vd becomes [rbp+16].",
      block: {
        push rbp;
        mov rbp, rsp;
        sub rsp, 48;

        // Store KV[0]: {kx, vx, fmt='x'}
        mov rax, rcx;
        mov [rbp - 48], rax;           // KV[0].key_ptr
        mov rax, r8;
        mov [rbp - 40], rax;           // KV[0].value
        mov rax, 0x78;                 // fmt_letter = 'x'
        mov [rbp - 32], rax;           // KV[0].fmt_letter

        // Store KV[1]: {kd, vd, fmt='d'}
        mov rax, r9;
        mov [rbp - 24], rax;           // KV[1].key_ptr
        mov rax, [rbp + 16];           // rax = vd (7th arg from caller stack)
        mov [rbp - 16], rax;           // KV[1].value
        mov rax, 0x64;                 // fmt_letter = 'd'
        mov [rbp - 8], rax;            // KV[1].fmt_letter

        // Call klog_emit_core
        lea rcx, [rbp - 48];
        mov r8, 2;
        call klog_emit_core;

        add rsp, 48;
        pop rbp;
        ret;
      }
    } @no_frame
}
