// src/kernel/core/klog/subsys.pdx — M1-002 (#684) Logging subsystem tags
//                                    R51 rewrite: lowercase human-readable words
//
// Twenty-one .rodata subsystem tag symbols emitted to COM1 by
// klog_emit_core (src/kernel/core/klog/emit.pdx). Each string is
// NUL-terminated because the composer walks bytes until zero.
//
// R51 (design/kernel/boot-transcript.md §3.4) changed the strings in
// place: what used to be a fixed-width 4-character machine tag with
// underscore padding (`MM__`, `CAP_`, `IOMM`) is now a lowercase
// human-readable word (`memory`, `cap`, `iommu`) up to eight bytes,
// NUL-terminated. Symbol names are unchanged — every call site
// (`lea rdi, [rip + SUBSYS_XXXX]`) keeps working — but the printed
// column is right-padded to a fixed 8-column field by the composer,
// so the visual layout stays square regardless of the token length.
//
// Padding responsibility moved from the string layout (fixed 4-char
// tag) to the composer (variable-length string + count-based right-
// pad to KLOG_SUBSYS_COLUMN_WIDTH). §3.4 explains the rationale:
// widening a nine-character subsystem would grow the field for every
// line that boot, matching the CPU-column widening discipline.
//
// Byte counts (NUL-inclusive):
//   SUBSYS_BOOT          5   "boot\0"
//   SUBSYS_MM__          7   "memory\0"
//   SUBSYS_INT_          4   "int\0"
//   SUBSYS_TASK          5   "task\0"
//   SUBSYS_SCHD          6   "sched\0"
//   SUBSYS_CAP_          4   "cap\0"
//   SUBSYS_IPC_          4   "ipc\0"
//   SUBSYS_VFS_          4   "vfs\0"
//   SUBSYS_TTY_          4   "tty\0"
//   SUBSYS_FS__          3   "fs\0"
//   SUBSYS_USER          5   "user\0"
//   SUBSYS_PANC          6   "panic\0"
//   SUBSYS_TIME          5   "time\0"
//   SUBSYS_APIC          5   "apic\0"
//   SUBSYS_PCI_          4   "pci\0"
//   SUBSYS_IOMM          6   "iommu\0"
//   SUBSYS_NVME          5   "nvme\0"
//   SUBSYS_XHCI          5   "xhci\0"
//   SUBSYS_E1KE          7   "e1000e\0"
//   SUBSYS_NET_          4   "net\0"
//   SUBSYS_DRV_          7   "driver\0"
//
// KLOG_SUBSYS_COLUMN_WIDTH is 8: every word fits in eight columns
// (`e1000e ` and `driver  ` are the widest with 1- and 2-column trailing
// padding respectively). §3.4 covers the "what if we add a 9-column
// subsystem" case.
//
// Callers reference symbols as flat globals: `lea rdi, [rip + SUBSYS_XXXX]`.
//
// Audit: design/kernel/boot-transcript.md §3.4
//        design/kernel/kernel-logging-substrate.md §5.2 (superseded for wire format)
//        design/audit/entries/r14b-m1-002-subsys-keys.md

module Subsys = structure {
  // Column budget for the printed subsystem field. Composer right-pads
  // with spaces to reach this width; a longer subsystem grows the
  // column boot-wide (see §3.4).
  pub let KLOG_SUBSYS_COLUMN_WIDTH : u64 = 8

  pub let SUBSYS_BOOT : [u8; 5] = "boot\0"
  pub let SUBSYS_MM__ : [u8; 7] = "memory\0"
  pub let SUBSYS_INT_ : [u8; 4] = "int\0"
  pub let SUBSYS_TASK : [u8; 5] = "task\0"
  pub let SUBSYS_SCHD : [u8; 6] = "sched\0"
  pub let SUBSYS_CAP_ : [u8; 4] = "cap\0"
  pub let SUBSYS_IPC_ : [u8; 4] = "ipc\0"
  pub let SUBSYS_VFS_ : [u8; 4] = "vfs\0"
  pub let SUBSYS_TTY_ : [u8; 4] = "tty\0"
  pub let SUBSYS_FS__ : [u8; 3] = "fs\0"
  pub let SUBSYS_USER : [u8; 5] = "user\0"
  pub let SUBSYS_PANC : [u8; 6] = "panic\0"
  pub let SUBSYS_TIME : [u8; 5] = "time\0"
  pub let SUBSYS_APIC : [u8; 5] = "apic\0"
  pub let SUBSYS_PCI_ : [u8; 4] = "pci\0"
  pub let SUBSYS_IOMM : [u8; 6] = "iommu\0"
  pub let SUBSYS_NVME : [u8; 5] = "nvme\0"
  pub let SUBSYS_XHCI : [u8; 5] = "xhci\0"
  pub let SUBSYS_E1KE : [u8; 7] = "e1000e\0"
  pub let SUBSYS_NET_ : [u8; 4] = "net\0"

  // R29.M4-004 (#1035): driver framework — lifecycle, registry, and
  // blob-signature telemetry. Distinct from the per-device subsystems
  // above because a blob-signature rejection is a property of the
  // framework's trust path, not of the device that happened to need the
  // firmware; an operator grepping the audit log for supply-chain events
  // wants one tag, not one per driver.
  pub let SUBSYS_DRV_ : [u8; 7] = "driver\0"
}
