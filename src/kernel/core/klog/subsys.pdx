// src/kernel/core/klog/subsys.pdx — M1-002 (#684) Logging subsystem tags
//
// Fourteen .rodata subsystem tag symbols emitted to COM1 by klog_emit_core
// (src/kernel/core/klog/emit.pdx). Each string is NUL-terminated because
// uart_puts (src/kernel/boot/uart.pdx) walks bytes until zero.
//
// Byte counts (NUL-inclusive):
//   SUBSYS_BOOT          5   "BOOT\0"
//   SUBSYS_MM__          5   "MM__\0"
//   SUBSYS_INT_          5   "INT_\0"
//   SUBSYS_TASK          5   "TASK\0"
//   SUBSYS_SCHD          5   "SCHD\0"
//   SUBSYS_CAP_          5   "CAP_\0"
//   SUBSYS_IPC_          5   "IPC_\0"
//   SUBSYS_VFS_          5   "VFS_\0"
//   SUBSYS_TTY_          5   "TTY_\0"
//   SUBSYS_FS__          5   "FS__\0"
//   SUBSYS_USER          5   "USER\0"
//   SUBSYS_PANC          5   "PANC\0"
//   SUBSYS_TIME          5   "TIME\0"
//   SUBSYS_APIC          5   "APIC\0"
//
// Callers reference symbols as flat globals: `lea rdi, [rip + SUBSYS_XXXX]`.
// Fixed-width 4-character tags with underscore padding preserve byte-offset
// parse contract (§3.3 of kernel-logging-substrate.md).
//
// Audit: design/kernel/kernel-logging-substrate.md §5.2
//        design/audit/entries/r14b-m1-002-subsys-keys.md

module Subsys = structure {
  pub let SUBSYS_BOOT : [u8; 5] = "BOOT\0"
  pub let SUBSYS_MM__ : [u8; 5] = "MM__\0"
  pub let SUBSYS_INT_ : [u8; 5] = "INT_\0"
  pub let SUBSYS_TASK : [u8; 5] = "TASK\0"
  pub let SUBSYS_SCHD : [u8; 5] = "SCHD\0"
  pub let SUBSYS_CAP_ : [u8; 5] = "CAP_\0"
  pub let SUBSYS_IPC_ : [u8; 5] = "IPC_\0"
  pub let SUBSYS_VFS_ : [u8; 5] = "VFS_\0"
  pub let SUBSYS_TTY_ : [u8; 5] = "TTY_\0"
  pub let SUBSYS_FS__ : [u8; 5] = "FS__\0"
  pub let SUBSYS_USER : [u8; 5] = "USER\0"
  pub let SUBSYS_PANC : [u8; 5] = "PANC\0"
  pub let SUBSYS_TIME : [u8; 5] = "TIME\0"
  pub let SUBSYS_APIC : [u8; 5] = "APIC\0"
  pub let SUBSYS_PCI_ : [u8; 5] = "PCI_\0"
}
