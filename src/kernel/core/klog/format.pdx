// src/kernel/core/klog/format.pdx — R51 human-readable transcript format
//
// The "human-readable transcript" project (design/kernel/boot-transcript.md
// §2, §4.1) replaces the wire format
//
//   <hex-timestamp>|<cpu>|<lvl-letter>|<4char-subsys>|<message>
//
// with
//
//   [  <sssss>.<uuuuuu>] <LEVEL> cpu<N> <subsystem>: <message>
//
// The line composition still lives in `emit.pdx` (steps 6..10). This
// module contains the small primitives that the composer needs and did
// not have before:
//
//   * `_klog_t0` — a one-shot latch of `rdtsc` taken on the very first
//     klog line ever emitted, so every timestamp is "elapsed ticks since
//     the first log record". This is the same discipline the Linux
//     kernel uses for its `[    0.000000]` prefix.
//
//   * `_klog_ts_prehpet_divisor` — the ticks-per-microsecond divisor
//     used before the TSC is calibrated. `_tsc_hz` is 0 until
//     `tsc_calibrate` (src/kernel/core/time/tsc.pdx) has published the
//     real frequency; while `_tsc_hz` is 0 the composer divides by this
//     constant instead. QEMU-typical 2.5 GHz -> 2500 ticks/µs. The first
//     ~50 lines of a real boot are the only ones affected, none of them
//     depend on sub-µs accuracy, and one "timestamp base recalibrated"
//     line at TSC calibration marks the transition (§3.1).
//
//   * `klog_ts_read_delta_usec` — the composer's one entry point.
//     Reads `rdtsc`, latches `_klog_t0` on first call, returns the
//     elapsed time since t0 in microseconds. Uses `_tsc_hz` when the
//     TSC has been calibrated, otherwise the pre-HPET divisor.
//
//   * `u64_to_dec_rpad` — decimal formatter, right-justified,
//     space-padded to a caller-supplied width. Grows past the width if
//     the value has more digits (alignment breaks visibly, per §3.1
//     "correct: alignment breaks visibly rather than silently
//     truncating"). Used for the seconds column.
//
//   * `u64_to_dec_zpad` — same but zero-padded. Used for the six-digit
//     microseconds column.
//
// Both padded formatters emit at MOST `width` characters when the value
// fits; if the value overflows the width they emit ceil(log10(value))
// characters instead. Neither NUL-terminates — the composer is walking
// a cursor.
//
// [unsafe] — caller-supplied buffer writes only; rdtsc read; `_klog_t0`
//            and `_tsc_hz` read; `_klog_t0` writes on the one-shot latch.
// Audit: design/kernel/boot-transcript.md §3.1, §4.1

module Format = structure {

  // ============================================================================
  // .data storage
  // ============================================================================

  // Latched at the first klog_ts_read_delta_usec call. Zero means "not
  // yet latched"; on the first emit we snapshot rdtsc into this slot
  // and return delta = 0 for that same line, so the boot transcript
  // opens on `[    0.000000]` (Linux-dmesg convention). Every later
  // line reads `rdtsc - _klog_t0`.
  //
  // Race: klog_emit_core is already inside a cli window + single-writer
  // gate (_klog_in_progress_bsp), so the "check-if-zero, snapshot"
  // sequence is atomic against re-entry. See emit.pdx justification for
  // the wider ordering argument.
  pub let mut _klog_t0 : u64 = 0

  // Ticks-per-microsecond divisor used before `_tsc_hz` (populated by
  // tsc_calibrate) is non-zero. Deliberately approximate: the first
  // ~50 boot lines are the only ones affected and none of them care
  // about sub-µs accuracy. QEMU-typical 2.5 GHz → 2500 ticks/µs.
  //
  // Left `mut` so a future runtime override (e.g. a CPUID leaf 0x15
  // read that yields a specific frequency before HPET calibration)
  // can rewrite it without a source edit at every call site.
  pub let mut _klog_ts_prehpet_divisor : u64 = 2500

  // ============================================================================
  // klog_ts_read_delta_usec() -> u64 !{sysreg, mem} @{}
  //
  // Returns the elapsed microseconds since the first klog emit. On the
  // very first call `_klog_t0` is 0 → we snapshot rdtsc into `_klog_t0`
  // and return 0 (so the first line renders `[    0.000000]`). On every
  // later call we return `(rdtsc - _klog_t0) / ticks_per_usec` where
  // `ticks_per_usec` is `_tsc_hz / 1_000_000` if `_tsc_hz` != 0 (post-
  // calibration), else `_klog_ts_prehpet_divisor`.
  //
  // Preserves rbx, rbp, r12-r15 (SysV callee-save).
  // Clobbers rax, rcx, rdx, rsi, rdi, r8-r11.
  // ============================================================================
  pub let klog_ts_read_delta_usec : () -> u64 !{sysreg, mem} @{} =
    fn () -> unsafe {
      effects: { sysreg, mem },
      capabilities: {},
      justification: "R51 boot-transcript §4.1 timestamp helper. (1) rdtsc -> rax via edx:eax reconstruct. (2) Load _klog_t0. If 0, this is the one-shot latch path: store rax into _klog_t0 and return 0 (first line is `[    0.000000]`). Otherwise proceed. (3) delta = rdtsc - _klog_t0 (u64 wrap-safe; rdtsc is monotonic). (4) Divisor: if _tsc_hz != 0, ticks_per_usec = _tsc_hz / 1_000_000; else ticks_per_usec = _klog_ts_prehpet_divisor. Reject a zero divisor (defensive: an unusual _klog_ts_prehpet_divisor override could yield 0) by returning delta unchanged rather than raising #DE. (5) usec = delta / ticks_per_usec via `xor rdx,rdx; div rcx`. Return rax. The whole routine is called from within klog_emit_core's cli/single-writer gate, so the check-then-latch race is closed by the composer's own re-entrancy discipline; no extra lock here. Register plan: no callee-save touched; rax/rcx/rdx clobbered by rdtsc + div — SysV caller-save.",
      block: {
        // (1) rdtsc -> rax
        rdtsc;
        shl rdx, 32;
        or rax, rdx;

        // Stash the current TSC in r8 so we can still use it for the
        // latch-store and the delta computation after the memory read.
        mov r8, rax;

        // (2) Load _klog_t0
        mov r9, [rip + _klog_t0];
        cmp r9, 0;
        jne klog_ts_have_t0;

        // Latch path: store rax into _klog_t0, return 0.
        mov [rip + _klog_t0], r8;
        xor rax, rax;
        ret;

      klog_ts_have_t0:
        // (3) delta = rdtsc - _klog_t0
        mov rax, r8;
        sub rax, r9;                            // rax = delta (ticks)

        // (4) Divisor selection.
        //   rcx = _tsc_hz / 1_000_000  if _tsc_hz != 0
        //         _klog_ts_prehpet_divisor  otherwise
        mov r10, [rip + _tsc_hz];
        cmp r10, 0;
        je klog_ts_use_prehpet;

        mov rcx, r10;
        mov r11, 1000000;
        xor rdx, rdx;
        // rax is the delta; move it aside so we can reuse rax/rdx for div.
        mov r8, rax;                            // r8 = delta (stash)
        mov rax, rcx;                           // rax = _tsc_hz
        div r11;                                // rax = _tsc_hz / 1_000_000
        mov rcx, rax;                           // rcx = ticks_per_usec
        mov rax, r8;                            // restore delta into rax
        jmp klog_ts_have_divisor;

      klog_ts_use_prehpet:
        mov rcx, [rip + _klog_ts_prehpet_divisor];

      klog_ts_have_divisor:
        // Defensive: zero divisor -> return delta unchanged rather than #DE.
        cmp rcx, 0;
        jne klog_ts_do_div;
        ret;

      klog_ts_do_div:
        // (5) usec = delta / ticks_per_usec
        xor rdx, rdx;
        div rcx;
        ret;
      }
    }

  // ============================================================================
  // u64_to_dec_rpad(value, buf, width) -> u64 !{mem} @{}
  //
  // Writes `value` as decimal into `buf`, right-justified inside a
  // `width`-column field, space-padded on the LEFT. If the value has
  // more digits than `width`, the field grows: `width` acts as a
  // minimum, never as a truncation cap. Returns the new cursor
  // (buf + max(digit_count, width)).
  //
  // No NUL-terminate; the composer walks a cursor.
  //
  // Register plan (SysV): rdi = value, rsi = buf, rdx = width.
  // Preserves rbx, rbp, r12-r15. Clobbers rax, rcx, rdx, rsi, rdi, r8-r11.
  // Stack: 20-byte staging on rsp for right-to-left divide-by-10 digits.
  // ============================================================================
  pub let u64_to_dec_rpad : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (value: u64) (buf: u64) (width: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R51 padded decimal helper. Same divide-by-10 shape as u64_to_dec in hex.pdx, but with a right-justified/space-padded epilogue. (1) Sub rsp,32 for staging (20 bytes needed; round up so rsp stays 16-aligned pre-call — no nested calls here so alignment is defensive). (2) Divide loop: r9 = value; if 0, count=1 and staging[0]='0'. Else loop `rax=r9; xor rdx,rdx; mov rcx,10; div rcx; store dl+0x30 into staging[--cursor]; r9=rax; loop until r9==0`. (3) digit_count = 20 - (staging_cursor - staging_base). (4) Output cursor = buf. If digit_count < width, emit (width - digit_count) space bytes then copy digits; else emit only the digits. (5) Return buf + max(digit_count, width). Register plan: r8=digit_count, r9=quotient during divide, r10=pad_count, r11=staging_ptr scratch, rbx=buf across the divide loop (callee-save; single push). Byte writes use `mov_b` idiom (proven in hex.pdx). No branches into skewed registers.",
      block: {
        push rbx;
        mov rbx, rsi;                           // rbx = buf (callee-save spill)
        mov r9, rdi;                            // r9 = value
        // r12 = width — spill to callee-save so we can reuse rdx for div.
        push r12;
        mov r12, rdx;

        sub rsp, 32;                            // 20-byte staging (rounded to 32)
        mov r10, rsp;
        add r10, 19;                            // r10 = staging tail

        // Handle zero: emit '0' once.
        cmp r9, 0;
        jne rpad_div_loop;

        mov al, 0x30;
        mov_b [r10 + 0], al;
        mov r8, 1;                              // digit_count = 1
        mov r11, r10;                           // first-digit ptr
        jmp rpad_after_div;

      rpad_div_loop:
        mov rax, r9;
        mov rcx, 10;
        xor rdx, rdx;
        div rcx;                                // rax=quot, rdx=rem
        add rdx, 0x30;
        mov [r10 + 0], dl;                      // dl safe: rdx = 0..9
        mov r9, rax;
        cmp r9, 0;
        je rpad_div_done;
        sub r10, 1;
        jmp rpad_div_loop;

      rpad_div_done:
        // r10 points at the highest-order digit; length = staging_end - r10.
        mov rax, rsp;
        add rax, 20;
        mov r11, r10;                           // r11 = first digit ptr
        mov r8, rax;
        sub r8, r11;                            // r8 = digit_count

      rpad_after_div:
        // Emit leading space padding if width > digit_count.
        mov rax, r12;                           // rax = width
        cmp rax, r8;
        jbe rpad_copy_digits;                   // width <= digits → no pad
        sub rax, r8;                            // rax = pad_count
        mov r10, rax;                           // r10 = pad counter

      rpad_pad_loop:
        cmp r10, 0;
        je rpad_copy_digits;
        mov al, 0x20;                           // space
        mov_b [rbx + 0], al;
        add rbx, 1;
        sub r10, 1;
        jmp rpad_pad_loop;

      rpad_copy_digits:
        // Copy r8 bytes from r11 → rbx.
        mov rcx, 0;
      rpad_copy_loop:
        cmp rcx, r8;
        jge rpad_done;
        mov rax, r11;
        add rax, rcx;
        mov dl, [rax];
        mov_b [rbx + 0], dl;
        add rbx, 1;
        add rcx, 1;
        jmp rpad_copy_loop;

      rpad_done:
        add rsp, 32;
        mov rax, rbx;                           // rax = new cursor
        pop r12;
        pop rbx;
        ret;
      }
    }

  // ============================================================================
  // u64_to_dec_zpad(value, buf, width) -> u64 !{mem} @{}
  //
  // Same as u64_to_dec_rpad but zero-padded on the LEFT ('0', not ' ').
  // Used for the six-digit microseconds column, where the padded slot
  // must read as digits so `.000042` is unambiguous.
  //
  // If value has more digits than width, the field grows (no truncate).
  // Returns cursor after the field.
  // ============================================================================
  pub let u64_to_dec_zpad : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (value: u64) (buf: u64) (width: u64) -> unsafe {
      effects: { mem },
      capabilities: {},
      justification: "R51 zero-padded decimal helper. Divide-by-10 shape identical to u64_to_dec_rpad (see above); the only difference is the pad byte (0x30 '0' instead of 0x20 space). Kept as a separate lambda because a single formatter parameterised on pad byte would need an extra caller-supplied register — the two use sites (seconds column and microseconds column) each pick a fixed pad, so branch elimination beats parameterisation.",
      block: {
        push rbx;
        mov rbx, rsi;
        mov r9, rdi;
        push r12;
        mov r12, rdx;

        sub rsp, 32;
        mov r10, rsp;
        add r10, 19;

        cmp r9, 0;
        jne zpad_div_loop;

        mov al, 0x30;
        mov_b [r10 + 0], al;
        mov r8, 1;
        mov r11, r10;
        jmp zpad_after_div;

      zpad_div_loop:
        mov rax, r9;
        mov rcx, 10;
        xor rdx, rdx;
        div rcx;
        add rdx, 0x30;
        mov [r10 + 0], dl;
        mov r9, rax;
        cmp r9, 0;
        je zpad_div_done;
        sub r10, 1;
        jmp zpad_div_loop;

      zpad_div_done:
        mov rax, rsp;
        add rax, 20;
        mov r11, r10;
        mov r8, rax;
        sub r8, r11;

      zpad_after_div:
        mov rax, r12;
        cmp rax, r8;
        jbe zpad_copy_digits;
        sub rax, r8;
        mov r10, rax;

      zpad_pad_loop:
        cmp r10, 0;
        je zpad_copy_digits;
        mov al, 0x30;                           // '0'
        mov_b [rbx + 0], al;
        add rbx, 1;
        sub r10, 1;
        jmp zpad_pad_loop;

      zpad_copy_digits:
        mov rcx, 0;
      zpad_copy_loop:
        cmp rcx, r8;
        jge zpad_done;
        mov rax, r11;
        add rax, rcx;
        mov dl, [rax];
        mov_b [rbx + 0], dl;
        add rbx, 1;
        add rcx, 1;
        jmp zpad_copy_loop;

      zpad_done:
        add rsp, 32;
        mov rax, rbx;
        pop r12;
        pop rbx;
        ret;
      }
    }
}
