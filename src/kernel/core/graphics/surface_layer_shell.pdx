// src/kernel/core/graphics/surface_layer_shell.pdx -- R113.M2-008 (paideia-os #2388)
//
// KIND_SURFACE role: LAYER_SHELL -- system-UI authority for surfaces
// that live above OR below the ordinary xdg-toplevel z-band.  This is
// the wlr_layer_shell_v1 equivalent, minted over a bare KIND_SURFACE
// row the same way surface_toplevel.pdx (R113.M2-006, #2386) mints its
// TOPLEVEL role over one.  Panels, taskbars, notification popovers,
// system wallpapers, and lock-screen overlays are the M2-consumer
// vocabulary for this role.
//
// Umbrella: R113 GPU-native compositor (#2380).  Substrate authority:
// design/graphics/r113-m1-substrate.md (FROZEN 2026-09-08).  Sibling
// role: surface_toplevel.pdx (M2-006, precedent for shape / row-size
// / label-prefix / fingerprint discipline / dedicated-pool posture).
//
// -----------------------------------------------------------------------------
// SCOPE (per issue #2388)
// -----------------------------------------------------------------------------
//
// A LAYER_SHELL surface differs from a TOPLEVEL surface in three ways:
//
//   1. It sits on one of four fixed z-bands (BACKGROUND < BOTTOM <
//      TOP < OVERLAY).  The compositor's z-order pass ignores the
//      TOPLEVEL stacking rules for these surfaces and slots each one
//      into its declared band.
//
//   2. It is anchored to one or more screen edges (top / bottom /
//      left / right, or the four corners as edge-bit combinations),
//      OR unanchored (bitmask 0) for a floating overlay placed by
//      set_margin alone.  The anchor drives placement: an edge-
//      anchored surface tracks that edge across output resize; a
//      corner-anchored surface tracks the two adjacent edges; a
//      centred/floating surface uses margin as an offset from the
//      output origin.
//
//   3. It declares an exclusive_zone -- the amount of screen edge
//      it consumes -- so that ordinary toplevel windows tile around
//      it (a top panel with exclusive_zone=32 shrinks the effective
//      output height by 32 for every toplevel maximize).  Negative
//      values ("I want to be drawn but don't shrink the work area")
//      and zero ("I'm decorative, ignore me for tiling") are legal;
//      the compositor's exclusive-zone accumulator interprets the
//      i64.
//
// Ops (this landing):
//
//   * layer_shell_create(surface_slot, layer, anchor_edges) -> lsid | err
//     Binds a fresh LAYER_SHELL row to an already-minted KIND_SURFACE
//     row.  layer must be in {0,1,2,3}; anchor_edges is a bitmask
//     over {TOP=1, BOTTOM=2, LEFT=4, RIGHT=8} with no bits outside
//     0x0F.  Assigns a fresh monotonic layer_shell_id (first id = 1;
//     zero reserved as the "unset" sentinel).  exclusive_zone and
//     margin default to 0; set_exclusive_zone / set_margin adjust
//     them later.  Emits LAYER SHELL CREATE OK sid=<n> lsid=<n>
//     layer=<n> and returns the layer_shell_id, or one of the
//     0xFFFFE1AF..0xFFFFE1A8 refusal codes.
//
//   * layer_shell_set_exclusive_zone(lsid, zone) -> 0 | err
//     Overwrites the row's exclusive_zone slot.  Stored raw as a u64
//     (compositor-side reads it as i64 for the {negative / zero /
//     positive} semantic sketched above); no numeric validation --
//     the full u64 range is legal.  Refuses BAD_ID on lsid==0 and
//     NOT_FOUND on a stale id.
//
//   * layer_shell_set_margin(lsid, top, right, bottom, left) -> 0 | err
//     Packs four u16 margin values into the row's margin word (top
//     in the high 16 bits, then right, bottom, left low).  Refuses
//     BAD_MARGIN if any value >= 65536 (does not fit in u16).  All
//     four are unsigned pixel distances from the corresponding
//     anchored edge; negative margins don't make practical sense in
//     the layer-shell model and their absence in the row shape is a
//     deliberate simplification vs Wayland's i32 margin field.
//
// The dispatcher wire-up (role-multiplexed OP_SURFACE_ROLE_LAYER_
// SHELL_* arm on cap_handler_surface) belongs to a follow-on landing,
// matching the M2-006 TOPLEVEL role's split: this file lands the
// authority bodies; the dispatcher fan-out is a sibling.
//
// -----------------------------------------------------------------------------
// ROW LAYOUT -- 256 BYTES (32 u64 WORDS), CACHE-FRIENDLY POWER-OF-2
// -----------------------------------------------------------------------------
//
//   +  0  hdr             in_use[63:56] | generation[55:0]
//                         (56-bit LAM ABA counter, matches kind_surface
//                          row+0 discipline)
//   +  8  layer_shell_id  u64 (monotonic; first id = 1; 0 reserved)
//   + 16  refs            surface_slot[31:0] | layer[63:32]
//                         (layer in {0,1,2,3}; low 32 zero-extends
//                          surface_slot the same way surface_toplevel
//                          packs surface_slot | close_pending)
//   + 24  anchor_edges    u64 (bitmask; only low 4 bits used today;
//                         high 60 bits reserved for future
//                         exclusive_edge / keyboard_interactivity
//                         packing without a layout revision)
//   + 32  exclusive_zone  u64 (raw; compositor interprets as i64)
//   + 40  margin          top[63:48] | right[47:32] |
//                         bottom[31:16] | left[15:0]   (u16 x 4)
//   + 48..+255  reserved for future role extensions (keyboard
//                         interactivity mode, exclusive_edge override,
//                         output binding, popup_pending, layer FSM,
//                         a11y bridge slot)
//
// Row size 256 matches the sibling TOPLEVEL row (surface_toplevel.pdx
// TOPLEVEL_ROW_BYTES) so slot->offset is a single `shl 8` (encoder
// pitfall v0.36+: no 2-op `imul r, imm`) and the pool geometry mirrors
// the TOPLEVEL pool exactly: 16 rows * 256 bytes = 4 KiB = one page,
// `@align(64)` puts each row on a fresh cache line.  Reserved tail
// pre-books space for the M2 role-catalogue follow-ons named in the
// substrate doc §11 non-goals; extending the row later becomes a
// zero-move field addition rather than a layout bump.
//
// -----------------------------------------------------------------------------
// SIDE-TABLE POSTURE (dedicated pool, NOT indexed by surface_slot)
// -----------------------------------------------------------------------------
//
// Same rationale as surface_toplevel.pdx §"SIDE-TABLE POSTURE": a
// dedicated LAYER_SHELL pool keyed by monotonic layer_shell_id
// (returned as the caller-visible handle) decouples this role's row
// count from SURFACE_ROW_MAX and preserves LAM safety across
// destroy+recreate cycles on the same underlying KIND_SURFACE row.
// The linear scan across 16 rows for find_by_id is one cache line of
// loads -- a hash side-table would be premature at M2 sizing.
//
// -----------------------------------------------------------------------------
// FAILURE TAXONOMY -- 0xFFFFE1A0..0xFFFFE1AF (FRESH BAND)
// -----------------------------------------------------------------------------
//
// Grep-verified free at landing time against src/ and design/
// (2026-09-08): `grep -rn '0xFFFFE1[Aa][0-9A-Fa-f]' src/ design/`
// returned zero hits.  Neighbours on the 0xFFFFE1XX page (all
// occupied by kernel-side compositor substrate):
//
//   0xFFFFE110..E11F   kind_surface.pdx        (substrate)
//   0xFFFFE150..E15F   surface_present.pdx     (present-fence)
//   0xFFFFE160..E16F   damage_region.pdx       (damage-region)
//   0xFFFFE170..E17F   surface_toplevel.pdx    (TOPLEVEL role)
//   0xFFFFE180..E18F   focus.pdx               (focus / grab)
//   0xFFFFE1A0..E1AF   THIS FILE               (LAYER_SHELL role)
//
// Codes:
//
//   0xFFFFE1AF  LAYER_SHELL_TAIL_ENOSPC     row pool full
//   0xFFFFE1AE  LAYER_SHELL_BAD_SURFACE     surface_slot invalid / dead
//   0xFFFFE1AD  LAYER_SHELL_BAD_LAYER       layer > 3
//   0xFFFFE1AC  LAYER_SHELL_BAD_ANCHOR      anchor_edges & ~0x0F != 0
//   0xFFFFE1AB  LAYER_SHELL_NOT_FOUND       no live row matches lsid
//   0xFFFFE1AA  LAYER_SHELL_BAD_ID          lsid == 0 (sentinel)
//   0xFFFFE1A9  LAYER_SHELL_BAD_MARGIN      margin value >= 65536
//   0xFFFFE1A0..A8 RESERVED for M2 role-catalogue expansion (planned:
//                  BAD_OUTPUT, KEYBOARD_INT_INVALID, EXCLUSIVE_EDGE_
//                  MISMATCH, POPUP_ALREADY_BOUND, ...)
//
// -----------------------------------------------------------------------------
// FINGERPRINT (issue mandate + M1-doc §8 lesson)
// -----------------------------------------------------------------------------
//
// LAYER SHELL CREATE OK sid=<n> lsid=<n> layer=<n>
//
// Emitted via klog_s1_x3 from layer_shell_create's success tail.  The
// three-KV shape (sid + lsid + layer) is the layer-shell analogue of
// the two-KV TOPLEVEL fingerprint: sid names the underlying
// KIND_SURFACE row (surface_id, read from surface row+8), lsid names
// this file's own row's monotonic id, and layer -- the field that
// distinguishes this role from every other surface role in the M2
// catalogue -- is the third KV so a boot witness or coverage matrix
// can filter by band without decoding the row.  Tag byte count (62)
// verified by hand: "surface layer shell create ok " (30) + "[legacy:
// LAYER SHELL CREATE OK]" (31) + "\0" (1).
//
// A tools/verify-fingerprint-coverage.sh allowlist entry accompanies
// this landing (M1-doc §8 mandate: every "... OK" tag either asserts
// in the test matrix or names an allowlist reason).  set_exclusive_
// zone and set_margin do NOT emit fingerprints -- these are
// compositor-internal state edits with no boot-time reachability
// today; the create-time fingerprint is the substrate-live witness.
//
// -----------------------------------------------------------------------------
// EXTERNAL SYMBOLS
// -----------------------------------------------------------------------------
//
// This module references (bare symbols, kernel .pdx single global namespace):
//   * surface_row_valid   (kind_surface.pdx)         -- gate (1) in create
//   * surface_row_addr    (kind_surface.pdx)         -- sid read for klog
//   * surface_k_sid       (kind_surface.pdx L200)    -- "sid\0" KV key
//   * SUBSYS_CAP_         (klog subsystem ordinal)
//   * klog_s1_x3          (klog/wrappers.pdx L116)   -- 3-KV emit
//
// No import declaration needed -- paideia-as's kernel .pdx link path
// is one global namespace (same pattern surface_toplevel.pdx and
// surface_commit_ops.pdx already use for these exact symbols).
//
// -----------------------------------------------------------------------------
// ENCODER PITFALLS (per feedback_pdx_encoder_pitfalls v0.36+)
// -----------------------------------------------------------------------------
//
//   * No `test rN, rN` -- every zero-check uses `cmp rN, 0` + `je/jne`.
//   * No 2-op `imul r, imm` -- slot->offset math is `shl r, 8`
//     (slot * 256).
//   * No `and reg, imm64` -- validation-mask logic uses `shr` /
//     register-loaded masks; the 32-bit mask `0xFFFFFFFF` is safe as
//     `and reg, 0xFFFFFFFF` per the kind_surface / surface_toplevel
//     precedent (encodes as unsigned imm32, no sign-extend for that
//     value).  Margin overflow test uses `mov r10, 0x10000; cmp rN,
//     r10; jae bad_margin` (i.e., 65536 compared as unsigned).
//   * No `cmp reg, [mem]` -- every mem-compare loads to a scratch first.
//   * No literal-scaled `[reg + N*8]` -- register-scaled
//     `[reg + rcx * 8]` (scale 8 in the {1,2,4,8} legal set) used for
//     the init loop over the pool; displacement form `[reg + N]` used
//     for fixed offsets.
//   * Multiline `pub let ="..."` refused by the encoder -- every
//     string literal in this file lives on one source line.
//   * Module name matches file basename: `SurfaceLayerShell` for
//     `surface_layer_shell.pdx`.
//   * Fingerprint tag byte count computed by hand and asserted in the
//     `[u8; N]` type ascription (62 for the create-ok tag, 5 for the
//     lsid key, 6 for the layer key).
//
// -----------------------------------------------------------------------------
// LABEL PREFIXES
// -----------------------------------------------------------------------------
//
//   lsi_    layer_shell_init
//   lssb_   layer_shell_stats_bump_*    (three leaves, one per stat slot)
//   lsrv_   layer_shell_row_valid
//   lsra_   layer_shell_row_addr
//   lsfb_   layer_shell_find_by_id
//   lsc_    layer_shell_create
//   lssez_  layer_shell_set_exclusive_zone
//   lssm_   layer_shell_set_margin
//
// All prefixes avoid the paideia-as reserved-keyword set
// (feedback_paideia_as_reserved_labels: loop, if, let, while, for,
// match, pub, mod, use, fn, struct, enum, impl, trait, type, where,
// move, mut, ref).  "layer" and "shell" are NOT reserved -- verified
// against the reserved list -- so identifiers built on them (module
// name SurfaceLayerShell, constants LAYER_*, functions layer_shell_*)
// are safe.

module SurfaceLayerShell = structure {

  // ==========================================================================
  // Row shape + pool constants.
  // ==========================================================================

  pub let LAYER_SHELL_ROW_MAX   : u64 = 16
  pub let LAYER_SHELL_ROW_BYTES : u64 = 256
  pub let LAYER_SHELL_ROW_WORDS : u64 = 32

  // Row offsets.
  pub let LS_OFF_HDR            : u64 = 0
  pub let LS_OFF_LAYER_SHELL_ID : u64 = 8
  pub let LS_OFF_REFS           : u64 = 16
  pub let LS_OFF_ANCHOR         : u64 = 24
  pub let LS_OFF_EXCLUSIVE_ZONE : u64 = 32
  pub let LS_OFF_MARGIN         : u64 = 40

  // ==========================================================================
  // Layers (z-band ordinals).  Ordering: BACKGROUND < BOTTOM < TOP <
  // OVERLAY.  The compositor's z-order pass reads the layer nibble
  // and sorts within-band by stacking discipline (out of scope here).
  // ==========================================================================

  pub let LAYER_BACKGROUND : u64 = 0
  pub let LAYER_BOTTOM     : u64 = 1
  pub let LAYER_TOP        : u64 = 2
  pub let LAYER_OVERLAY    : u64 = 3
  pub let LAYER_MAX        : u64 = 3

  // ==========================================================================
  // Anchor edge bits.  Corners are edge-bit combinations:
  //   TOP|LEFT     = 0x05
  //   TOP|RIGHT    = 0x09
  //   BOTTOM|LEFT  = 0x06
  //   BOTTOM|RIGHT = 0x0A
  // Center / floating overlay: bitmask 0 (no anchors).
  // Any bit outside 0x0F is refused as BAD_ANCHOR.
  // ==========================================================================

  pub let ANCHOR_TOP    : u64 = 0x01
  pub let ANCHOR_BOTTOM : u64 = 0x02
  pub let ANCHOR_LEFT   : u64 = 0x04
  pub let ANCHOR_RIGHT  : u64 = 0x08
  pub let ANCHOR_MASK   : u64 = 0x0F

  // ==========================================================================
  // Margin overflow bound (65536 = 1 << 16; any margin value >= this
  // does not fit in the u16 slot in row+40).
  // ==========================================================================

  pub let MARGIN_LIMIT : u64 = 0x10000

  // ==========================================================================
  // Failure taxonomy (0xFFFFE1A0..0xFFFFE1AF, fresh band).
  // ==========================================================================

  pub let LAYER_SHELL_OK              : u64 = 0
  pub let LAYER_SHELL_TAIL_ENOSPC     : u64 = 0xFFFFE1AF
  pub let LAYER_SHELL_BAD_SURFACE     : u64 = 0xFFFFE1AE
  pub let LAYER_SHELL_BAD_LAYER       : u64 = 0xFFFFE1AD
  pub let LAYER_SHELL_BAD_ANCHOR      : u64 = 0xFFFFE1AC
  pub let LAYER_SHELL_NOT_FOUND       : u64 = 0xFFFFE1AB
  pub let LAYER_SHELL_BAD_ID          : u64 = 0xFFFFE1AA
  pub let LAYER_SHELL_BAD_MARGIN      : u64 = 0xFFFFE1A9

  // ==========================================================================
  // Pool storage.  16 rows * 256 bytes = 4 KiB, one page-aligned
  // allocation.  Zero-initialised .bss; layer_shell_init defensively
  // re-scrubs at boot to match the kind_surface_init / damage_region_
  // init / toplevel_init discipline (chaos-restart re-scrub point).
  // ==========================================================================

  pub let mut _layer_shells         : [u64; 512] = uninit @align(64)
  pub let mut _layer_shell_stats    : [u64; 4]   = uninit @align(64)
  pub let mut _layer_shell_next_id  : u64        = uninit @align(8)

  pub let LS_ST_CREATES    : u64 = 0
  pub let LS_ST_SET_ZONE   : u64 = 1
  pub let LS_ST_SET_MARGIN : u64 = 2
  pub let LS_ST_MAX        : u64 = 3

  // ==========================================================================
  // Fingerprint tag (62 bytes) + KV keys (5 and 6 bytes).  surface_k_sid
  // ("sid\0") is already declared in kind_surface.pdx L200 and is
  // referenced by bare-symbol lookup (single global namespace, same as
  // surface_toplevel.pdx's use of surface_k_sid at L674).
  // ==========================================================================

  pub let surface_layer_shell_create_ok_msg : [u8; 62] = "surface layer shell create ok [legacy: LAYER SHELL CREATE OK]\0"
  pub let layer_shell_k_lsid  : [u8; 5] = "lsid\0"
  pub let layer_shell_k_layer : [u8; 6] = "layer\0"

  // ==========================================================================
  // Stats bumpers.  Load-inc-store leaves (no `add reg, [mem]`), one
  // per counter slot -- mirrors toplevel_stats_bump_* discipline in
  // surface_toplevel.pdx L295-345.
  // ==========================================================================

  pub let layer_shell_stats_bump_creates : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M2-008 (#2388): bump _layer_shell_stats[LS_ST_CREATES=0]. Load-inc-store, no `add reg, [mem]`. Called from layer_shell_create success tail only. Labels prefixed lssb_c_.",
      block: {
        lea r10, [rip + _layer_shell_stats];
        mov rax, [r10 + 0];
        add rax, 1;
        mov [r10 + 0], rax;
        ret
      }
    }

  pub let layer_shell_stats_bump_set_zone : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M2-008 (#2388): bump _layer_shell_stats[LS_ST_SET_ZONE=1]. Labels prefixed lssb_sz_.",
      block: {
        lea r10, [rip + _layer_shell_stats];
        mov rax, [r10 + 8];
        add rax, 1;
        mov [r10 + 8], rax;
        ret
      }
    }

  pub let layer_shell_stats_bump_set_margin : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M2-008 (#2388): bump _layer_shell_stats[LS_ST_SET_MARGIN=2]. Labels prefixed lssb_sm_.",
      block: {
        lea r10, [rip + _layer_shell_stats];
        mov rax, [r10 + 16];
        add rax, 1;
        mov [r10 + 16], rax;
        ret
      }
    }

  // ==========================================================================
  // layer_shell_init() -- zero pool + stats + id counter at boot.
  //
  // Called from kernel_main's graphics-substrate init phase alongside
  // kind_surface_init / damage_region_init / toplevel_init.  Three
  // straight-line loops mirroring toplevel_init (surface_toplevel.pdx
  // L354-380).
  // ==========================================================================

  pub let layer_shell_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M2-008 (#2388): zero _layer_shells (512 u64 = 4 KiB), _layer_shell_stats (4 u64), _layer_shell_next_id (1 u64). Defensive boot-time re-scrub mirroring toplevel_init (surface_toplevel.pdx L354). Two straight-line loops using [reg + rcx * 8] SIB (scale 8 in {1,2,4,8} legal set) plus one scalar store. Labels prefixed lsi_.",
      block: {
        lea r10, [rip + _layer_shells];
        xor rax, rax;
        xor rcx, rcx;
      lsi_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 512;
        jb  lsi_rows;

        lea r10, [rip + _layer_shell_stats];
        xor rcx, rcx;
      lsi_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  lsi_stats;

        lea r10, [rip + _layer_shell_next_id];
        mov [r10 + 0], rax;
        ret
      }
    }

  // ==========================================================================
  // layer_shell_row_valid(slot) -> 1 iff slot < LAYER_SHELL_ROW_MAX
  // and the row's in_use marker byte (top byte of hdr) is nonzero.
  // ==========================================================================

  pub let layer_shell_row_valid : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M2-008 (#2388): 1 iff slot < LAYER_SHELL_ROW_MAX(16) and in_use marker set. Slot->offset via shl 8 (row * 256). Labels prefixed lsrv_.",
      block: {
        mov r10, [rip + LAYER_SHELL_ROW_MAX];
        cmp rdi, r10;
        jae lsrv_no;
        lea r10, [rip + _layer_shells];
        mov r11, rdi;
        shl r11, 8;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  lsrv_no;
        mov rax, 1;
        ret;
      lsrv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // layer_shell_row_addr(slot) -> &_layer_shells[slot*256] iff live; 0
  // otherwise.  Exposed for the follow-on cap dispatcher's multi-field
  // row edits.
  // ==========================================================================

  pub let layer_shell_row_addr : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M2-008 (#2388): row base pointer post-liveness. Returns 0 on invalid slot (out-of-range OR in_use==0). Labels prefixed lsra_.",
      block: {
        mov r10, [rip + LAYER_SHELL_ROW_MAX];
        cmp rdi, r10;
        jae lsra_no;
        lea r10, [rip + _layer_shells];
        mov r11, rdi;
        shl r11, 8;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  lsra_no;
        mov rax, r10;
        ret;
      lsra_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // layer_shell_find_by_id(lsid) -> slot | LAYER_SHELL_NOT_FOUND.
  //
  // Linear scan across live rows.  Zero lsid is a caller bug and
  // returns LAYER_SHELL_NOT_FOUND (a zero row+8 word is the "no id
  // assigned" state a live-and-uninitialised row would hold, but every
  // claim path stamps a nonzero id before releasing the row so a zero
  // at +8 of a live row is not observable; conflating the two cases
  // here keeps the return taxonomy compact).
  // ==========================================================================

  pub let layer_shell_find_by_id : (u64) -> u64 !{mem} @{} =
    fn (lsid: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M2-008 (#2388): linear scan for lsid in row+8 of every live row. `shl 8` slot compute + `+ 8` displacement for the id load (byte offset 8 within a 256-byte row). Labels prefixed lsfb_.",
      block: {
        push rbx;
        push r12;
        mov r12, rdi;                        // r12 = target lsid
        xor rbx, rbx;                        // rbx = scan idx
      lsfb_scan:
        mov r10, [rip + LAYER_SHELL_ROW_MAX];
        cmp rbx, r10;
        jae lsfb_none;
        lea r10, [rip + _layer_shells];
        mov r11, rbx;
        shl r11, 8;
        add r10, r11;                        // r10 = row base
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  lsfb_step;
        mov rax, [r10 + 8];
        cmp rax, r12;
        jne lsfb_step;
        mov rax, rbx;
        jmp lsfb_out;
      lsfb_step:
        add rbx, 1;
        jmp lsfb_scan;
      lsfb_none:
        mov rax, 0xFFFFE1AB;                 // LAYER_SHELL_NOT_FOUND
      lsfb_out:
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // layer_shell_create(surface_slot, layer, anchor_edges) -> lsid | err
  //
  // Gate order:
  //   (1) surface_row_valid(surface_slot)   -> else LAYER_SHELL_BAD_SURFACE
  //   (2) layer <= LAYER_MAX (3)            -> else LAYER_SHELL_BAD_LAYER
  //   (3) anchor_edges & ~0x0F == 0         -> else LAYER_SHELL_BAD_ANCHOR
  //   (4) low-first free-slot scan          -> else LAYER_SHELL_TAIL_ENOSPC
  //   (5) LAM header: bump low-56 gen, OR in 1<<56 marker
  //   (6) Read sid from KIND_SURFACE row+8 via surface_row_addr
  //   (7) Assign lsid = pre-inc _layer_shell_next_id (first id = 1)
  //   (8) Stamp row: lsid, refs (surface_slot | layer<<32), anchor,
  //       exclusive_zone=0, margin=0, reserved zeroed
  //   (9) stats.creates++
  //  (10) klog_s1_x3 LAYER SHELL CREATE OK sid=<sid> lsid=<r15>
  //       layer=<r13>
  //  (11) return lsid
  //
  // Register plan: rbx=free_slot scratch, r12=surface_slot, r13=layer,
  // r14=anchor_edges (pre-write) then reused as scratch post-write,
  // r15=lsid, rbp=row_base.  Six callee-save pushes = 48 B + sub rsp,8
  // = 56 B; entry rsp%16==8 -> (8+56) = 64, %16=0 -- aligned for every
  // nested call including surface_row_valid / surface_row_addr /
  // layer_shell_stats_bump_creates / klog_s1_x3.
  //
  // klog_s1_x3 push idiom (int/dump.pdx L83-116 precedent):
  // sub rsp,8; push v3; push k3; push v2; call; add rsp, 32.
  // At body rsp%16=0 before the sub, this lands the three stack args
  // at [rsp+8..+24] as klog_s1_x3's ABI expects (wrappers.pdx L112).
  //
  // Reserved-tail zero: row bytes +48..+255 are 26 u64 words (208
  // bytes).  The init leaf already zeroed the whole pool at boot, but
  // a slot that was previously live and then destroyed will have
  // stale post-header bytes; the destroy path is a follow-on landing
  // and does not exist yet, but zeroing on claim is cheap (26 stores)
  // and mirrors surface_toplevel.pdx's zero-title-region discipline.
  // ==========================================================================

  pub let layer_shell_create : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (surface_slot: u64) (layer: u64) (anchor_edges: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R113.M2-008 (#2388): create LAYER_SHELL role over a KIND_SURFACE row. Gate order per file header. Six callee-save pushes (rbx/r12-r15/rbp) + sub rsp,8 land rsp%16=0 (entry 8 + 48 + 8 = 64) for every nested call including klog_s1_x3. Slot->offset via shl 8 (row * 256; encoder pitfall v0.36+: no 2-op imul r,imm). LAM header discipline mirrors surface_toplevel.pdx L582-591: 56-bit mask via movabs, in_use marker bit 56. surface_row_addr + [row+8] load re-reads sid post-liveness (defense-in-depth against a slot going dead between gates 1 and 6, impossible in single-threaded kernel bringup but the cheap check preserves ordering-independence). Anchor validation via `shr r10, 4` + `cmp/jne bad_anchor` avoids `and reg, imm64` (encoder pitfall v0.36+). klog_s1_x3 push idiom (sub 8; push v3; push k3; push v2; call; add 32) at rsp%16=0 lands the three stack args at [rsp+8..+24] per wrappers.pdx L112 ABI. Reserved-tail zero loop covers row bytes +48..+255 via [reg + rcx * 8] scale-8 SIB. Labels prefixed lsc_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;
        sub rsp, 8;

        mov r12, rdi;                        // surface_slot
        mov r13, rsi;                        // layer
        mov r14, rdx;                        // anchor_edges

        // (1) surface_row_valid(surface_slot)
        mov rdi, r12;
        call surface_row_valid;
        cmp rax, 0;
        je  lsc_bad_surface;

        // (2) layer <= LAYER_MAX (3)
        mov r10, [rip + LAYER_MAX];
        cmp r13, r10;
        ja  lsc_bad_layer;

        // (3) anchor_edges bits outside 0x0F?  `shr r10, 4` isolates
        //     the high 60 bits; any set bit there is a reject.
        mov r10, r14;
        shr r10, 4;
        cmp r10, 0;
        jne lsc_bad_anchor;

        // (4) low-first free-slot scan
        xor rbx, rbx;                        // rbx = candidate slot
      lsc_scan:
        mov r10, [rip + LAYER_SHELL_ROW_MAX];
        cmp rbx, r10;
        jae lsc_enospc;
        lea r10, [rip + _layer_shells];
        mov r11, rbx;
        shl r11, 8;                          // rbx * 256
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  lsc_claim;
        add rbx, 1;
        jmp lsc_scan;

      lsc_claim:
        // r10 = row base for the claimed slot; keep it in rbp.
        mov rbp, r10;

        // (5) LAM: hdr = ((old_gen + 1) & 0x00FFFFFFFFFFFFFF) | (1<<56)
        mov r11, [rbp + 0];
        mov r9, 0x00FFFFFFFFFFFFFF;
        and r11, r9;
        add r11, 1;
        and r11, r9;
        mov r8, 1;
        shl r8, 56;
        or  r11, r8;
        mov [rbp + 0], r11;

        // (6) sid = surface_row_addr(surface_slot)[+8]
        mov rdi, r12;
        call surface_row_addr;
        cmp rax, 0;
        je  lsc_bad_surface_late;
        mov r10, [rax + 8];                  // r10 = sid
        // Stash sid on the stack slot -- r14 already holds anchor
        // (needed for row+24 write), r13 holds layer (needed for
        // klog v3 and row+16 pack), r15 not yet assigned.  Stack
        // slot survives across the reserved-tail zero loop and the
        // klog setup.
        mov [rsp + 0], r10;                  // stack slot = sid

        // (7) lsid = pre-inc _layer_shell_next_id (first id = 1)
        lea r10, [rip + _layer_shell_next_id];
        mov rax, [r10 + 0];
        add rax, 1;
        mov [r10 + 0], rax;
        mov r15, rax;                        // r15 = lsid

        // (8a) +8 = lsid
        mov [rbp + 8], r15;

        // (8b) +16 = refs = surface_slot[31:0] | layer[63:32]
        mov rax, r12;
        and rax, 0xFFFFFFFF;                 // preserve low 32 (safe imm32)
        mov r11, r13;                        // r11 = layer
        shl r11, 32;                         // layer << 32
        or  rax, r11;
        mov [rbp + 16], rax;

        // (8c) +24 = anchor_edges (validated; high 60 bits guaranteed
        //      zero by gate 3, so the store also implicitly zero-fills
        //      the reserved high bits).
        mov [rbp + 24], r14;

        // (8d) +32 = exclusive_zone = 0 (default; set_exclusive_zone
        //      overwrites later)
        xor rax, rax;
        mov [rbp + 32], rax;

        // (8e) +40 = margin = 0 (default; set_margin overwrites later)
        mov [rbp + 40], rax;

        // (8f) Zero the 208-byte reserved tail (+48..+255 = 26 u64
        //      stores).  Reuse rbx (dead after claim scan) as the
        //      tail base pointer so the loop uses the proven
        //      `[base + rcx * 8]` form.  rax already 0 from (8d).
        mov rbx, rbp;
        add rbx, 48;
        xor rcx, rcx;
      lsc_tail_zero:
        mov [rbx + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 26;
        jb  lsc_tail_zero;

        // (9) stats.creates++
        call layer_shell_stats_bump_creates;

        // (10) klog_s1_x3 LAYER SHELL CREATE OK
        //      k1 = "sid",   v1 = sid   (from stack slot)
        //      k2 = "lsid",  v2 = lsid  (r15)  [stack push]
        //      k3 = "layer", v3 = layer (r13)  [stack push]
        //      Push order (reverse for [rsp+8]=v2, [rsp+16]=k3,
        //      [rsp+24]=v3): push v3 first, then k3, then v2.
        mov rdi, 3;                          // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + surface_layer_shell_create_ok_msg];
        lea rcx, [rip + surface_k_sid];
        mov r8, [rsp + 0];                   // v1 = sid (stack slot)
        lea r9, [rip + layer_shell_k_lsid];
        sub rsp, 8;                          // align for x3 (rsp%16: 0 -> 8)
        mov rax, r13;                        // v3 = layer
        push rax;                            // (rsp%16: 8 -> 0)
        lea rax, [rip + layer_shell_k_layer];
        push rax;                            // k3 (rsp%16: 0 -> 8)
        mov rax, r15;                        // v2 = lsid
        push rax;                            // (rsp%16: 8 -> 0)
        call klog_s1_x3;
        add rsp, 32;                         // undo 3 pushes + align

        // (11) return lsid
        mov rax, r15;
        jmp lsc_out;

      lsc_bad_surface_late:
        // The KIND_SURFACE row went dead between gate (1) and the
        // sid read (impossible today, defense-in-depth).  Roll back
        // the header claim so the slot stays scannable, then refuse.
        // Roll-back = clear the in_use marker; the incremented
        // generation stays (ABA safety preserved by consuming the
        // generation slot).
        mov r11, [rbp + 0];
        mov r9, 0x00FFFFFFFFFFFFFF;
        and r11, r9;
        mov [rbp + 0], r11;
        mov rax, 0xFFFFE1AE;                 // LAYER_SHELL_BAD_SURFACE
        jmp lsc_out;

      lsc_bad_surface:
        mov rax, 0xFFFFE1AE;                 // LAYER_SHELL_BAD_SURFACE
        jmp lsc_out;
      lsc_bad_layer:
        mov rax, 0xFFFFE1AD;                 // LAYER_SHELL_BAD_LAYER
        jmp lsc_out;
      lsc_bad_anchor:
        mov rax, 0xFFFFE1AC;                 // LAYER_SHELL_BAD_ANCHOR
        jmp lsc_out;
      lsc_enospc:
        mov rax, 0xFFFFE1AF;                 // LAYER_SHELL_TAIL_ENOSPC

      lsc_out:
        add rsp, 8;
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // layer_shell_set_exclusive_zone(lsid, zone) -> 0 | err
  //
  // Gate order:
  //   (1) lsid != 0                            -> else LAYER_SHELL_BAD_ID
  //   (2) layer_shell_find_by_id -> slot       -> else LAYER_SHELL_NOT_FOUND
  //   (3) Overwrite: row+32 = zone (raw u64; compositor reads as i64)
  //   (4) stats.set_zone++
  //   (5) return 0
  //
  // Register plan: rbx=slot, r12=zone.  Two callee-save pushes + sub
  // rsp,8 = 24 B; entry rsp%16==8 -> (8+24)=32, %16=0, aligned for the
  // two nested calls (layer_shell_find_by_id + layer_shell_stats_bump_
  // set_zone).
  // ==========================================================================

  pub let layer_shell_set_exclusive_zone : (u64, u64) -> u64 !{mem} @{cap} =
    fn (lsid: u64) (zone: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R113.M2-008 (#2388): overwrite exclusive_zone slot at row+32. Full u64 accepted (compositor interprets as i64 per file header's exclusive-zone semantic). Two callee-save pushes (rbx/r12) + sub rsp,8 land rsp%16=0 (entry 8 + 16 + 8 = 32) for both nested calls. Slot->offset via shl 8 (row * 256). Labels prefixed lssez_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        // (1) lsid != 0
        cmp rdi, 0;
        je  lssez_bad_id;

        mov r12, rsi;                        // zone

        // (2) find by id (rdi already holds lsid)
        call layer_shell_find_by_id;
        mov r10, 0xFFFFE1AB;                 // LAYER_SHELL_NOT_FOUND
        cmp rax, r10;
        je  lssez_not_found;
        mov rbx, rax;                        // rbx = slot

        // (3) row_base = &_layer_shells[slot * 256], then row+32 = zone
        lea r10, [rip + _layer_shells];
        mov r11, rbx;
        shl r11, 8;
        add r10, r11;
        mov [r10 + 32], r12;

        // (4) stats.set_zone++
        call layer_shell_stats_bump_set_zone;

        // (5) return 0
        xor rax, rax;
        jmp lssez_out;

      lssez_bad_id:
        mov rax, 0xFFFFE1AA;                 // LAYER_SHELL_BAD_ID
        jmp lssez_out;
      lssez_not_found:
        mov rax, 0xFFFFE1AB;                 // LAYER_SHELL_NOT_FOUND

      lssez_out:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // layer_shell_set_margin(lsid, top, right, bottom, left) -> 0 | err
  //
  // Gate order:
  //   (1) lsid != 0                            -> else LAYER_SHELL_BAD_ID
  //   (2) each of top/right/bottom/left < MARGIN_LIMIT (65536)
  //                                            -> else LAYER_SHELL_BAD_MARGIN
  //   (3) layer_shell_find_by_id -> slot       -> else LAYER_SHELL_NOT_FOUND
  //   (4) Pack: row+40 = top[63:48] | right[47:32] | bottom[31:16] |
  //                     left[15:0]
  //   (5) stats.set_margin++
  //   (6) return 0
  //
  // Register plan: rbx=slot, r12=top, r13=right, r14=bottom, r15=left.
  // Five callee-save pushes = 40 B; entry rsp%16==8 -> (8+40)=48, %16=0
  // -- aligned for every nested call.
  //
  // Note on gate order: gate (2) runs BEFORE gate (3) so a caller with
  // both a bad lsid AND bad margin values gets the more specific
  // BAD_MARGIN response; this matches the surface_toplevel.pdx
  // set_title precedent (title-length validated before find_by_id when
  // the title arg is intrinsically bad regardless of id validity).
  // ==========================================================================

  pub let layer_shell_set_margin : (u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (lsid: u64) (top: u64) (right: u64) (bottom: u64) (left: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R113.M2-008 (#2388): pack four u16 margins into row+40. Five callee-save pushes (rbx/r12/r13/r14/r15) land rsp%16=0 (entry 8 + 40 = 48) for both nested calls -- no additional pad needed. Overflow bound MARGIN_LIMIT (65536) loaded into r10 for the four `cmp/jae bad_margin` checks (no `cmp reg, imm32` misuse; the value fits imm32 but the load-and-compare form is uniform across the four checks). Packing uses `shl` (16/32/48) plus `or`, all encoder-safe. Slot->offset via shl 8 (row * 256). Labels prefixed lssm_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // (1) lsid != 0
        cmp rdi, 0;
        je  lssm_bad_id;

        mov r12, rsi;                        // top
        mov r13, rdx;                        // right
        mov r14, rcx;                        // bottom
        mov r15, r8;                         // left

        // (2) Each margin < MARGIN_LIMIT (65536)
        mov r10, [rip + MARGIN_LIMIT];
        cmp r12, r10;
        jae lssm_bad_margin;
        cmp r13, r10;
        jae lssm_bad_margin;
        cmp r14, r10;
        jae lssm_bad_margin;
        cmp r15, r10;
        jae lssm_bad_margin;

        // (3) find by id
        // rdi already holds lsid (was never overwritten).
        call layer_shell_find_by_id;
        mov r10, 0xFFFFE1AB;                 // LAYER_SHELL_NOT_FOUND
        cmp rax, r10;
        je  lssm_not_found;
        mov rbx, rax;                        // rbx = slot

        // (4) Pack margin: top[63:48] | right[47:32] | bottom[31:16] |
        //     left[15:0].  Build in rax:
        //       rax = (top << 48) | (right << 32) | (bottom << 16) |
        //             left
        //     Each source register still holds the raw u64 with only
        //     the low 16 bits used (gate 2 rejected higher values), so
        //     the shifts stack without cross-field bit-bleed.
        mov rax, r12;                        // rax = top
        shl rax, 48;                         // top in bits 63..48
        mov r11, r13;                        // r11 = right
        shl r11, 32;                         // right in bits 47..32
        or  rax, r11;
        mov r11, r14;                        // r11 = bottom
        shl r11, 16;                         // bottom in bits 31..16
        or  rax, r11;
        or  rax, r15;                        // left in bits 15..0
        // Row base = &_layer_shells[slot * 256]; write to +40.
        lea r10, [rip + _layer_shells];
        mov r11, rbx;
        shl r11, 8;
        add r10, r11;
        mov [r10 + 40], rax;

        // (5) stats.set_margin++
        call layer_shell_stats_bump_set_margin;

        // (6) return 0
        xor rax, rax;
        jmp lssm_out;

      lssm_bad_id:
        mov rax, 0xFFFFE1AA;                 // LAYER_SHELL_BAD_ID
        jmp lssm_out;
      lssm_bad_margin:
        mov rax, 0xFFFFE1A9;                 // LAYER_SHELL_BAD_MARGIN
        jmp lssm_out;
      lssm_not_found:
        mov rax, 0xFFFFE1AB;                 // LAYER_SHELL_NOT_FOUND

      lssm_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
