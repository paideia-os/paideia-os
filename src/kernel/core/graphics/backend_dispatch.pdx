// src/kernel/core/graphics/backend_dispatch.pdx -- R101.M1-002
//
// Thin backend-dispatch shim. Two wrappers routing to the driver whose
// backend_kind matches _active_backend_kind:
//
//   backend_flush(src_va, dst_va, width, height, stride) -> u64
//
// At R101, only BOCHS_STDVGA is a valid target (VIRTIO_GPU + IRIS_XE
// are R103/R104 concerns and their driver bodies do not exist yet).
// The dispatch compare-chain shape mirrors design/graphics/r101-kernel-
// plan.md §R101.M1-002 -- one arm per backend, adding new arms as
// each backend's flush driver lands.
//
// -----------------------------------------------------------------------------
// paideia-as `@jump_table` gap
// -----------------------------------------------------------------------------
//
// Per the plan: "Verify paideia-as `@jump_table` is lowered per R91.M1-
// 002's identical verification step; fall back to an explicit compare
// chain if not." This landing takes the compare-chain path
// unconditionally: three or four backends is well below the jump-table
// win threshold, and the explicit chain is unambiguous under
// paideia-as v0.24.x's encoder floor.
//
// -----------------------------------------------------------------------------
// Return value
// -----------------------------------------------------------------------------
//
// bytes_copied on success; 0 if no active backend is set (nothing to
// dispatch to) or if the active backend has no flush driver in this
// landing (virtio_gpu / iris_xe -- both return 0 without emitting a
// warning; the framebuffer's flip stats already record failed flushes).

module BackendDispatch = structure {

  // ==========================================================================
  // backend_flush(src_va, dst_va, width, height, stride) -> u64
  // ==========================================================================
  pub let backend_flush : (u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{boot} =
    fn (src_va: u64) (dst_va: u64) (width: u64) (height: u64) (stride: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot},
      justification: "R101.M1-002: dispatch to the active backend's flush driver based on _active_backend_kind (kind_display_backend.pdx). At R101 only BOCHS_STDVGA (=1) has a driver body; VIRTIO_GPU (=2/=3) and IRIS_XE (=4) return 0 without a warning (their driver bodies land at R103/R104). All five args pass through untouched into the driver call -- the tail-call shape lets bochs_flush own the full 6-push register plan without this frame stashing anything. paideia-as SysV: 5 args in rdi/rsi/rdx/rcx/r8; no stack args. No callee-save touched here (dispatch is a leaf-shaped tail forwarder). Labels prefixed dpyd_.",
      block: {
        mov r10, [rip + _active_backend_kind];
        cmp r10, 1;                              // DPYB_KIND_BOCHS_STDVGA
        jne dpyd_not_bochs;
        call bochs_flush;
        ret;

      dpyd_not_bochs:
        // Other backends (virtio_gpu 2D/3D, iris_xe) not yet landed.
        xor rax, rax;
        ret
      }
    }
}
