// src/kernel/core/graphics/backend_dispatch.pdx -- R101.M1-002
//
// Thin backend-dispatch shim. Two wrappers routing to the driver whose
// backend_kind matches _active_backend_kind:
//
//   backend_flush(src_va, dst_va, width, height, stride) -> u64
//
// At R101, only BOCHS_STDVGA is a valid target (VIRTIO_GPU + IRIS_XE
// are R103/R104 concerns and their driver bodies do not exist yet).
// The dispatch compare-chain shape mirrors design/graphics/r101-kernel-
// plan.md §R101.M1-002 -- one arm per backend, adding new arms as
// each backend's flush driver lands.
//
// -----------------------------------------------------------------------------
// paideia-as `@jump_table` gap
// -----------------------------------------------------------------------------
//
// Per the plan: "Verify paideia-as `@jump_table` is lowered per R91.M1-
// 002's identical verification step; fall back to an explicit compare
// chain if not." This landing takes the compare-chain path
// unconditionally: three or four backends is well below the jump-table
// win threshold, and the explicit chain is unambiguous under
// paideia-as v0.24.x's encoder floor.
//
// -----------------------------------------------------------------------------
// Return value
// -----------------------------------------------------------------------------
//
// bytes_copied on success; 0 if no active backend is set (nothing to
// dispatch to) or if the active backend has no flush driver in this
// landing (virtio_gpu / iris_xe -- both return 0 without emitting a
// warning; the framebuffer's flip stats already record failed flushes).

module BackendDispatch = structure {

  // ==========================================================================
  // backend_flush(src_va, dst_va, width, height, stride) -> u64
  // ==========================================================================
  pub let backend_flush : (u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{boot} =
    fn (src_va: u64) (dst_va: u64) (width: u64) (height: u64) (stride: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot},
      justification: "R101.M1-002 + R103.M3-002 wire-in: dispatch to the active backend's flush driver based on _active_backend_kind (kind_display_backend.pdx). BOCHS_STDVGA (=1) -> bochs_flush; VIRTIO_GPU_2D (=2) -> virtio_gpu_backend_flush (which internally issues TRANSFER_TO_HOST_2D + RESOURCE_FLUSH and advances the display timeline via dpy_timeline_vblank_signal); other kinds return 0. All five args pass through unchanged. Labels prefixed dpyd_.",
      block: {
        mov r10, [rip + _active_backend_kind];
        cmp r10, 1;                              // DPYB_KIND_BOCHS_STDVGA
        je  dpyd_bochs;
        cmp r10, 2;                              // DPYB_KIND_VIRTIO_GPU_2D
        je  dpyd_virtio;
        xor rax, rax;
        ret;

      dpyd_bochs:
        call bochs_flush;
        ret;

      dpyd_virtio:
        call virtio_gpu_backend_flush;
        ret
      }
    }

  // ==========================================================================
  // backend_page_flip(pgfl_row_id, target_fb_slot) -> u64
  //
  // R104.M4-002 (paideia-os #2181): backend-neutral page-flip dispatch.
  // Routes to the driver whose backend_kind matches _active_backend_kind:
  //
  //   BOCHS_STDVGA (=1) -> emulate via bochs_flush of the target fb
  //                         (stdvga has no independent scan-out address
  //                         register; write the pixels and treat that as
  //                         the flip). Returns 0 on the assumption a
  //                         KIND_FRAMEBUFFER accessor will resolve
  //                         target_fb_slot to a src pointer; today the
  //                         path is a placeholder returning 0.
  //   VIRTIO_GPU_2D (=2) -> emulate via virtio_gpu_backend_flush (the
  //                         RESOURCE_FLUSH command is the flip). Same
  //                         placeholder posture.
  //   IRIS_XE (=4)       -> iris_xe_backend_page_flip (this landing's
  //                         SURF_LIVE MMIO write).
  //   other              -> return 0.
  //
  // The compose-with-KIND_SCANOUT_LEASE gate (R104.M4-005) runs at the
  // MINT site, not here -- once the mint succeeds, the plane binding is
  // fixed for the flip cap's lifetime and this dispatcher has nothing
  // to re-check.
  //
  // seq_completed is bumped by the vblank source (virtio-gpu ISR, real
  // vblank ISR, or LAPIC-tick simulator), not by this dispatcher.
  //
  // Labels prefixed dpyd_pf_.
  // ==========================================================================
  pub let backend_page_flip : (u64, u64) -> u64 !{mem, sysreg} @{boot} =
    fn (pgfl_row_id: u64) (target_fb_slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot},
      justification: "R104.M4-002 (#2181): backend-neutral page-flip dispatch. IRIS_XE arm hits iris_xe_backend_page_flip; other backends are placeholders returning 0 pending KIND_FRAMEBUFFER accessor widening. Labels prefixed dpyd_pf_.",
      block: {
        mov r10, [rip + _active_backend_kind];
        cmp r10, 4;                              // DPYB_KIND_IRIS_XE
        je  dpyd_pf_iris_xe;
        cmp r10, 1;                              // DPYB_KIND_BOCHS_STDVGA
        je  dpyd_pf_placeholder;
        cmp r10, 2;                              // DPYB_KIND_VIRTIO_GPU_2D
        je  dpyd_pf_placeholder;
        xor rax, rax;
        ret;

      dpyd_pf_iris_xe:
        call iris_xe_backend_page_flip;
        ret;

      dpyd_pf_placeholder:
        xor rax, rax;
        ret
      }
    }
}
