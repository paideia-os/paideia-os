// src/kernel/core/graphics/surface_popup.pdx -- R113.M2-007 (paideia-os #2387)
//
// KIND_SURFACE role: POPUP -- an xdg-popup-equivalent authority
// (parent anchor + positioner + lifetime state) layered over a live
// KIND_SURFACE row.  Umbrella: R113 GPU-native compositor (#2380).
//
// Design authority: design/graphics/r113-m1-substrate.md (FROZEN
// 2026-09-08, commit 1988e50) governs the KIND_SURFACE substrate this
// role sits on top of.  Sibling landing surface_toplevel.pdx (paideia-
// os #2386, R113.M2-006) is the precedent this file mirrors one-for-
// one: dedicated pool, LAM header discipline, id-keyed lookup, klog
// fingerprint on the create tail.  The two role landings are
// deliberately shape-symmetric so a follow-on role-multiplexed
// cap_handler_surface arm can dispatch them through a single switch.
//
// -----------------------------------------------------------------------------
// SCOPE (per issue #2387)
// -----------------------------------------------------------------------------
//
// The POPUP role is Wayland's xdg_popup: a transient surface anchored
// to a parent (a toplevel-role surface, or another popup-role surface)
// via a positioner (anchor point + gravity + offset).  Popups have a
// simple two-state lifetime -- alive at create, dismissed on grab loss
// or explicit dismiss request.  This landing lands the side-table +
// two op bodies:
//
//   * popup_create(surface_slot, parent_slot, anchor_x, anchor_y,
//                  gravity) -> popup_id | err
//     Binds a fresh POPUP row to an already-minted KIND_SURFACE row.
//     Requires the parent to also be a live KIND_SURFACE row (both
//     the popup and its parent are role-decorated surfaces; the role
//     coupling itself -- is-parent-actually-a-toplevel-or-popup -- is
//     out-of-scope for M2-007 and left to a follow-on role-registry
//     landing).  Positioner encoding: anchor_x/anchor_y as i16 screen
//     coords relative to parent, gravity as a 0..8 enum ordinal
//     (xdg_positioner_gravity: NONE, TOP, BOTTOM, LEFT, RIGHT,
//     TOP_LEFT, BOTTOM_LEFT, TOP_RIGHT, BOTTOM_RIGHT).  Offset_x /
//     offset_y default to 0 (the create signature does not take them;
//     a future popup_set_offset op may widen the surface).  Emits
//     SURFACE POPUP CREATE OK fingerprint with (sid, pid, parent) KVs.
//
//   * popup_dismiss(popup_id) -> 0 | err
//     Toggles the lifetime state to dismissed.  Idempotent-refusal:
//     second dismiss returns POPUP_ALREADY_DISMISSED rather than
//     silently succeeding, giving a confused caller an explicit
//     refusal instead of a lost signal.  Mirrors the toplevel_
//     request_close ALREADY_CLOSING discipline.
//
// The dispatcher wire-up for these ops through cap_invoke against a
// KIND_SURFACE cap belongs to a follow-on landing (role-multiplexed
// OP_SURFACE_ROLE_POPUP_* arm on cap_handler_surface); this file is
// the authority-body substrate a boot witness and that dispatcher
// will both call.
//
// -----------------------------------------------------------------------------
// ROW LAYOUT -- 64 BYTES (8 u64 WORDS), CACHE-LINE-ALIGNED
// -----------------------------------------------------------------------------
//
//   +  0  hdr           in_use[63:56] | generation[55:0]
//                       (56-bit LAM ABA counter, matches kind_surface
//                        row+0 discipline)
//   +  8  popup_id      u64 (monotonic; first id = 1; 0 reserved)
//   + 16  refs          surface_slot[31:0] | parent_slot[63:32]
//                       (u32 | u32; parent_slot is another KIND_SURFACE
//                        row index, NOT a popup-pool index -- popup-
//                        of-popup role coupling is out-of-scope for
//                        M2-007 and belongs to the role-registry
//                        follow-on)
//   + 24  positioner_ao anchor_x[15:0] | anchor_y[31:16] |
//                       offset_x[47:32] | offset_y[63:48]
//                       (i16 * 4, packed as low 16 bits of each field
//                        with zero-init offset at create time)
//   + 32  gravity_state gravity[15:0] | state[31:16] | reserved[63:32]
//                       state values: 0 = alive, 1 = dismissed
//   + 40  reserved      (constraint-adjustment bitmask, popup-grab
//                        slot, parent-role-kind discriminator, ...)
//   + 48  reserved
//   + 56  reserved
//
// Row size 64 chosen so slot->offset is a single `shl 6` (encoder
// pitfall v0.36+: no 2-op `imul r,imm`); pool of 16 rows = 1 KiB, one
// page-aligned allocation, `@align(64)` puts each row on its own
// cache line.  Same working-set posture as the kind_surface substrate
// pool (16 * 64 = 1 KiB) and half the per-row footprint of the
// toplevel side-table (256 B / row -- toplevel carries a 128 B inline
// title buffer that popup does not need).  Reserved tail leaves room
// for the M2 role-registry follow-on's constraint_adjustment mask
// (xdg_positioner_constraint_adjustment: flip X/Y, slide X/Y, resize
// X/Y), the implicit-grab seat pointer (once the input model wires),
// and a parent_kind u16 discriminator (once popup-of-popup coupling
// ships as its own role-registry entry).
//
// -----------------------------------------------------------------------------
// SIDE-TABLE POSTURE (dedicated pool, mirrors surface_toplevel.pdx)
// -----------------------------------------------------------------------------
//
// Dedicated pool per the toplevel precedent, NOT surface_slot-indexed:
//   * A dedicated pool decouples the POPUP row-count from
//     SURFACE_ROW_MAX(16) as the substrate scales.
//   * A single KIND_SURFACE row can legally be re-bound to a fresh
//     POPUP after destroy+recreate; an indexed-by-slot table would
//     reuse the same row and leak the previous LAM generation (an
//     ABA hazard the substrate's own header word exists to catch).
//   * Sibling role landings all share this shape -- toplevel is the
//     precedent; popup is the mirror.
//
// Consequently: the popup_id (the u64 in +8) is the ONLY caller-
// visible handle.  Callers pass popup_id to dismiss; internally we
// scan the pool for the matching id (popup_find_by_id).  Same
// premature-hash rationale as toplevel_find_by_id at ROW_MAX=16.
//
// -----------------------------------------------------------------------------
// FAILURE TAXONOMY -- 0xFFFFE190..0xFFFFE19F (FRESH BAND)
// -----------------------------------------------------------------------------
//
// Grep-verified free at landing time against src/ and design/ (no
// hit for `0xFFFFE19[0-9A-F]`).  Neighbours:
//
//   0xFFFFE110..E11F   kind_surface.pdx        (substrate refusal band)
//   0xFFFFE150..E15F   surface_present.pdx     (present-fence refusal band)
//   0xFFFFE160..E16F   damage_region.pdx       (damage-region refusal band)
//   0xFFFFE170..E17F   surface_toplevel.pdx    (TOPLEVEL role refusal band)
//   0xFFFFE190..E19F   THIS FILE
//
// Codes:
//
//   0xFFFFE19F  POPUP_TAIL_ENOSPC         row pool full
//   0xFFFFE19E  POPUP_BAD_SURFACE         surface_slot invalid / dead
//   0xFFFFE19D  POPUP_BAD_PARENT          parent_slot invalid / dead
//   0xFFFFE19C  POPUP_BAD_GRAVITY         gravity ordinal > 8
//   0xFFFFE19B  POPUP_BAD_ANCHOR          anchor_x or anchor_y not in i16
//   0xFFFFE19A  POPUP_NOT_FOUND           no live row matches popup_id
//   0xFFFFE199  POPUP_BAD_ID              popup_id == 0 (sentinel)
//   0xFFFFE198  POPUP_ALREADY_DISMISSED   dismiss of already-dismissed
//   0xFFFFE190..97 RESERVED for M2 role-catalogue expansion
//
// -----------------------------------------------------------------------------
// FINGERPRINT (issue mandate + M1-doc §8 lesson)
// -----------------------------------------------------------------------------
//
// SURFACE POPUP CREATE OK sid=<n> pid=<n> parent=<n>
//
// Emitted via klog_s1_x3 from popup_create's success tail.  The
// three-KV shape (sid + pid + parent) is the natural triple for this
// role: sid names the KIND_SURFACE row backing the popup (surface_id
// via row+8), pid names this file's own row (popup_id), parent names
// the KIND_SURFACE row of the parent role (surface_id via surface_
// row_addr on parent_slot).  Reading parent as an id rather than a
// slot preserves LAM-safe identity across slot recycle -- same
// discipline as sid.  Tag byte count (50) verified by hand:
// "surface popup create ok " (24) + "[legacy: POPUP CREATE OK]" (25)
// + "\0" (1).
//
// A tools/verify-fingerprint-coverage.sh allowlist entry accompanies
// this landing so the tag is not a coverage-gate silent hole (M1 doc
// §8 mandate: every "... OK" tag either asserts in the test matrix
// or names an allowlist reason).  popup_dismiss does NOT emit a
// fingerprint -- it is a compositor-internal state transition with
// no boot-time reachability today; the create-time fingerprint is
// the substrate-live witness the R113 wave asserts.
//
// -----------------------------------------------------------------------------
// EXTERNAL SYMBOLS
// -----------------------------------------------------------------------------
//
// This module references (bare symbols, kernel .pdx single global namespace):
//   * surface_row_valid   (kind_surface.pdx)   -- gates (4) + (5) in create
//   * surface_row_addr    (kind_surface.pdx)   -- sid + parent-sid reads
//   * SUBSYS_CAP_         (klog subsystem ordinal)
//   * surface_k_sid       (kind_surface.pdx)   -- sid KV key
//   * klog_s1_x3          (klog/wrappers.pdx)  -- 3-KV emit
//
// No import declaration needed -- paideia-as's kernel .pdx link path
// is one global namespace (same pattern surface_toplevel.pdx uses).
//
// -----------------------------------------------------------------------------
// ENCODER PITFALLS (per feedback_pdx_encoder_pitfalls v0.36+)
// -----------------------------------------------------------------------------
//
//   * No `test rN, rN` -- every zero-check uses `cmp rN, 0` + `je/jne`.
//   * No 2-op `imul r, imm` -- slot->offset math is `shl r, 6`
//     (slot * 64).
//   * No `and reg, imm64` -- the 56-bit LAM mask loads via
//     `mov r64, imm64` before the two-register and.  The 32-bit mask
//     `0xFFFFFFFF` and the 16-bit mask `0xFFFF` are safe as imm32 for
//     `and reg, imm` per the kind_surface / tui_canvas / kind_gpu_bo
//     precedent (encode as unsigned values that do NOT sign-extend
//     for these bit widths).
//   * No `cmp reg, [mem]` -- every mem-compare loads to a scratch first.
//   * No literal-scaled `[reg + N*8]` -- displacement form
//     `[reg + 8N]` used for fixed offsets; register-scaled
//     `[reg + rcx * 8]` (scale in {1,2,4,8}) used for u64 table walks.
//   * Multiline `pub let ="..."` refused by the encoder -- every
//     string literal in this file lives on one source line.
//   * Module name matches file basename: `SurfacePopup` for
//     `surface_popup.pdx`.
//   * Fingerprint tag byte count computed by hand and asserted in the
//     `[u8; N]` type ascription (50 for the create-ok tag, 4 for pid,
//     7 for parent).
//   * i16 range check via `add x, 0x8000; cmp x, 0x10000; jae bad`
//     (0x8000 and 0x10000 both encode cleanly as imm32 for the add/
//     cmp forms; the wrap-and-compare form obviates a signed compare
//     the encoder does not need to know about).
//
// -----------------------------------------------------------------------------
// LABEL PREFIXES
// -----------------------------------------------------------------------------
//
//   pi_    popup_init
//   psb_   popup_stats_bump_*    (two leaves, one per stat slot)
//   prv_   popup_row_valid
//   pra_   popup_row_addr
//   pfb_   popup_find_by_id
//   pc_    popup_create
//   pd_    popup_dismiss
//
// All prefixes avoid the paideia-as reserved-keyword set
// (feedback_paideia_as_reserved_labels: loop, if, let, while, for,
// match, pub, mod, use, fn, struct, enum, impl, trait, type, where,
// move, mut, ref).

module SurfacePopup = structure {

  // ==========================================================================
  // Row shape + pool constants.
  // ==========================================================================

  pub let POPUP_ROW_MAX      : u64 = 16
  pub let POPUP_ROW_BYTES    : u64 = 64
  pub let POPUP_ROW_WORDS    : u64 = 8

  // Row offsets.
  pub let PU_OFF_HDR           : u64 = 0
  pub let PU_OFF_POPUP_ID      : u64 = 8
  pub let PU_OFF_REFS          : u64 = 16
  pub let PU_OFF_POSITIONER_AO : u64 = 24
  pub let PU_OFF_GRAVITY_STATE : u64 = 32

  // Lifetime state values (bits 16..31 of PU_OFF_GRAVITY_STATE word).
  pub let POPUP_STATE_ALIVE     : u64 = 0
  pub let POPUP_STATE_DISMISSED : u64 = 1

  // Gravity range (xdg_positioner_gravity ordinals 0..8 inclusive).
  pub let POPUP_GRAVITY_MAX     : u64 = 8

  // ==========================================================================
  // Failure taxonomy (0xFFFFE190..0xFFFFE19F, fresh band).
  // ==========================================================================

  pub let POPUP_OK                  : u64 = 0
  pub let POPUP_TAIL_ENOSPC         : u64 = 0xFFFFE19F
  pub let POPUP_BAD_SURFACE         : u64 = 0xFFFFE19E
  pub let POPUP_BAD_PARENT          : u64 = 0xFFFFE19D
  pub let POPUP_BAD_GRAVITY         : u64 = 0xFFFFE19C
  pub let POPUP_BAD_ANCHOR          : u64 = 0xFFFFE19B
  pub let POPUP_NOT_FOUND           : u64 = 0xFFFFE19A
  pub let POPUP_BAD_ID              : u64 = 0xFFFFE199
  pub let POPUP_ALREADY_DISMISSED   : u64 = 0xFFFFE198

  // ==========================================================================
  // Pool storage.  16 rows * 64 bytes = 1 KiB, one page-aligned
  // allocation.  Zero-initialised .bss; popup_init defensively re-
  // scrubs at boot to match the kind_surface_init / damage_region_
  // init / toplevel_init discipline (chaos-restart witness re-scrub
  // point).
  // ==========================================================================

  pub let mut _popups        : [u64; 128] = uninit @align(64)  // 16 * 8
  pub let mut _popup_stats   : [u64; 2]   = uninit @align(64)
  pub let mut _popup_next_id : u64        = uninit @align(8)

  pub let PU_ST_CREATES      : u64 = 0
  pub let PU_ST_DISMISSES    : u64 = 1
  pub let PU_ST_MAX          : u64 = 2

  // ==========================================================================
  // Fingerprint tag (50 bytes) + KV keys.  surface_k_sid ("sid\0") is
  // already declared in kind_surface.pdx and referenced by bare-symbol
  // lookup (single global namespace, same pattern as surface_toplevel.
  // pdx's use of surface_k_sid).
  // ==========================================================================

  pub let surface_popup_create_ok_msg : [u8; 50] = "surface popup create ok [legacy: POPUP CREATE OK]\0"
  pub let popup_k_pid    : [u8; 4] = "pid\0"
  pub let popup_k_parent : [u8; 7] = "parent\0"

  // ==========================================================================
  // Stats bumpers.  Load-inc-store leaves (no `add reg, [mem]`), one
  // per counter slot -- mirrors toplevel_stats_bump_* discipline in
  // surface_toplevel.pdx L295-345.
  // ==========================================================================

  pub let popup_stats_bump_creates : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M2-007 (#2387): bump _popup_stats[PU_ST_CREATES=0]. Load-inc-store, no `add reg, [mem]`. Called from popup_create success tail only. Labels prefixed psb_c_.",
      block: {
        lea r10, [rip + _popup_stats];
        mov rax, [r10 + 0];
        add rax, 1;
        mov [r10 + 0], rax;
        ret
      }
    }

  pub let popup_stats_bump_dismisses : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M2-007 (#2387): bump _popup_stats[PU_ST_DISMISSES=1]. Load-inc-store, no `add reg, [mem]`. Called from popup_dismiss success tail only. Labels prefixed psb_d_.",
      block: {
        lea r10, [rip + _popup_stats];
        mov rax, [r10 + 8];
        add rax, 1;
        mov [r10 + 8], rax;
        ret
      }
    }

  // ==========================================================================
  // popup_init() -- zero pool + stats + id counter at boot.
  //
  // Called from kernel_main's graphics-substrate init phase alongside
  // kind_surface_init / damage_region_init / toplevel_init.  Three
  // straight-line loops.
  // ==========================================================================

  pub let popup_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M2-007 (#2387): zero _popups (128 u64 = 1 KiB), _popup_stats (2 u64), _popup_next_id (1 u64). Defensive boot-time re-scrub mirroring kind_surface_init (kind_surface.pdx L272) / damage_region_init (damage_region.pdx L191) / toplevel_init (surface_toplevel.pdx L354). Three straight-line loops using [reg + rcx * 8] SIB (scale 8 in the {1,2,4,8} legal set). Labels prefixed pi_.",
      block: {
        lea r10, [rip + _popups];
        xor rax, rax;
        xor rcx, rcx;
      pi_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 128;
        jb  pi_rows;

        lea r10, [rip + _popup_stats];
        xor rcx, rcx;
      pi_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 2;
        jb  pi_stats;

        lea r10, [rip + _popup_next_id];
        mov [r10 + 0], rax;
        ret
      }
    }

  // ==========================================================================
  // popup_row_valid(slot) -> 1 iff slot < POPUP_ROW_MAX and the row's
  // in_use marker byte (top byte of hdr) is nonzero.
  // ==========================================================================

  pub let popup_row_valid : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M2-007 (#2387): 1 iff slot < POPUP_ROW_MAX(16) and in_use marker set. Slot->offset via shl 6 (row * 64). Labels prefixed prv_.",
      block: {
        mov r10, [rip + POPUP_ROW_MAX];
        cmp rdi, r10;
        jae prv_no;
        lea r10, [rip + _popups];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  prv_no;
        mov rax, 1;
        ret;
      prv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // popup_row_addr(slot) -> &_popups[slot*64] iff live; 0 otherwise.
  // Exposed for the follow-on cap dispatcher's multi-field row edits.
  // ==========================================================================

  pub let popup_row_addr : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M2-007 (#2387): row base pointer post-liveness. Returns 0 on invalid slot (out-of-range OR in_use==0). Labels prefixed pra_.",
      block: {
        mov r10, [rip + POPUP_ROW_MAX];
        cmp rdi, r10;
        jae pra_no;
        lea r10, [rip + _popups];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  pra_no;
        mov rax, r10;
        ret;
      pra_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // popup_find_by_id(popup_id) -> slot | POPUP_NOT_FOUND.
  //
  // Linear scan across live rows.  Zero id argument is a caller bug and
  // returns POPUP_NOT_FOUND (a zero row+8 word is the "no id assigned"
  // state a live-and-uninitialised row would hold, but every claim path
  // stamps a nonzero id before releasing the row so a zero at +8 of a
  // live row is not observable; conflating the two cases here keeps
  // the return taxonomy compact -- same rationale as toplevel_find_by_
  // id in surface_toplevel.pdx L451).
  // ==========================================================================

  pub let popup_find_by_id : (u64) -> u64 !{mem} @{} =
    fn (popup_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M2-007 (#2387): linear scan for popup_id in row+8 of every live row. Scale-8 SIB not used (byte offset 8 within a 64-byte row, so `shl 6` slot compute + `+ 8` displacement). Labels prefixed pfb_.",
      block: {
        push rbx;
        push r12;
        mov r12, rdi;                        // r12 = target popup_id
        xor rbx, rbx;                        // rbx = scan idx
      pfb_scan:
        mov r10, [rip + POPUP_ROW_MAX];
        cmp rbx, r10;
        jae pfb_none;
        lea r10, [rip + _popups];
        mov r11, rbx;
        shl r11, 6;
        add r10, r11;                        // r10 = row base
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  pfb_step;
        mov rax, [r10 + 8];
        cmp rax, r12;
        jne pfb_step;
        mov rax, rbx;
        jmp pfb_out;
      pfb_step:
        add rbx, 1;
        jmp pfb_scan;
      pfb_none:
        mov rax, 0xFFFFE19A;                 // POPUP_NOT_FOUND
      pfb_out:
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // popup_create(surface_slot, parent_slot, anchor_x, anchor_y,
  //              gravity) -> popup_id | err
  //
  // Gate order:
  //   (1) gravity <= POPUP_GRAVITY_MAX(8) -> else POPUP_BAD_GRAVITY
  //   (2) anchor_x fits i16                -> else POPUP_BAD_ANCHOR
  //   (3) anchor_y fits i16                -> else POPUP_BAD_ANCHOR
  //   (4) surface_row_valid(surface_slot)  -> else POPUP_BAD_SURFACE
  //   (5) surface_row_valid(parent_slot)   -> else POPUP_BAD_PARENT
  //   (6) low-first free-slot scan         -> else POPUP_TAIL_ENOSPC
  //   (7) LAM header: bump low-56 gen, OR in 1<<56 marker
  //   (8) Read sid from KIND_SURFACE(surface_slot) row+8 via surface_row_addr
  //   (9) Read parent_sid from KIND_SURFACE(parent_slot) row+8
  //  (10) Assign popup_id = pre-inc _popup_next_id (first id = 1)
  //  (11) Stamp row: id, refs (surface_slot|parent_slot), positioner_ao
  //       (anchor_x|anchor_y with offset_x/offset_y=0), gravity_state
  //       (gravity with state=alive=0), reserved words = 0
  //  (12) stats.creates++
  //  (13) klog_s1_x3 SURFACE POPUP CREATE OK sid=<sid> pid=<popup_id>
  //       parent=<parent_sid>
  //  (14) return popup_id
  //
  // Register plan: rbx=row_base (post-claim), r12=surface_slot,
  // r13=parent_slot, r14=packed positioner_ao (built early once i16
  // gates pass), r15=popup_id (assigned late, used across klog emit).
  // Five callee-save pushes (rbx, r12, r13, r14, r15) = 40 B; entry
  // rsp%16==8 -> post-pushes (8+40)%16=0.  sub rsp,32 for local slots
  // ([rsp+0]=gravity, [rsp+8]=sid, [rsp+16]=parent_sid, [rsp+24]=pad)
  // keeps rsp%16=0 (32 is a multiple of 16) for every nested call
  // including the klog_s1_x3 emit.
  //
  // klog_s1_x3 v2/v3 push idiom (bochs_stdvga/probe.pdx L212-229): at
  // rsp%16==0 emit-site, sub 8 (align); push v3; push k3; push v2;
  // call; add rsp,32 (pop pre-align + three pushes = 32 B).  This
  // lands v2 at [rsp+8], k3 at [rsp+16], v3 at [rsp+24] as the
  // klog_s1_x3 ABI expects (wrappers.pdx L112-114).
  //
  // Positioner_ao pack: (anchor_x & 0xFFFF) | ((anchor_y & 0xFFFF)
  // << 16).  offset_x / offset_y default to 0 at create (unset in
  // the create signature -- a future popup_set_offset op may widen
  // the surface).  The i16 range check uses the wrap-and-compare
  // form: add x, 0x8000; cmp x, 0x10000; jae bad.  Valid signed
  // i16 values (as u64) are [0, 0x7FFF] or [0xFFFFFFFFFFFF8000,
  // 0xFFFFFFFFFFFFFFFF]; adding 0x8000 maps the first band to
  // [0x8000, 0xFFFF] and the second band (via wrap) to [0, 0x7FFF],
  // combining to [0, 0xFFFF].  Anything else falls outside and
  // trips the jae.  0x8000 and 0x10000 both fit imm32 for add /
  // cmp with correct sign-extension for these values.
  // ==========================================================================

  pub let popup_create : (u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (surface_slot: u64) (parent_slot: u64) (anchor_x: u64) (anchor_y: u64) (gravity: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R113.M2-007 (#2387): create POPUP role over a KIND_SURFACE row anchored to a parent KIND_SURFACE row via a positioner. Gate order per file header. Five callee-save pushes (rbx/r12-r15) + sub rsp,32 land rsp%16=0 (entry 8 + 40 + 32 = 80) for every nested call including klog_s1_x3. Slot->offset via shl 6 (row * 64, encoder pitfall v0.36+: no 2-op imul r,imm). LAM header discipline mirrors kind_surface.pdx L831-840: 56-bit mask via movabs, in_use marker bit 56. surface_row_addr + [row+8] load re-reads sid + parent_sid post-liveness (defense-in-depth against a slot going dead between gates 4/5 and 8/9, impossible in single-threaded kernel bringup but the cheap check preserves ordering-independence, mirroring surface_toplevel.pdx tc_bad_surface_late fault). klog_s1_x3 v2/v3 push idiom (sub 8; push v3; push k3; push v2; call; add 32) at rsp%16=0 lands v2/k3/v3 at [rsp+8]/[rsp+16]/[rsp+24] per wrappers.pdx L112-114 ABI. i16 range check via add 0x8000; cmp 0x10000; jae -- wrap-and-compare form. Positioner_ao pack: (anchor_x & 0xFFFF) | ((anchor_y & 0xFFFF) << 16); offset_x/offset_y default 0. Gravity_state pack: (gravity & 0xFFFF) | (0 << 16) with state=alive=0 at create. Labels prefixed pc_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 32;

        // Stash immutable arg copies before any range check clobbers rdx/rcx/r8.
        mov r12, rdi;                        // surface_slot
        mov r13, rsi;                        // parent_slot
        mov [rsp + 0], r8;                   // gravity (stack slot)

        // (1) gravity <= POPUP_GRAVITY_MAX
        mov r10, [rip + POPUP_GRAVITY_MAX];
        cmp r8, r10;
        ja  pc_bad_gravity;

        // (2) anchor_x fits i16.  Add 0x8000; result >= 0x10000 -> bad.
        mov rax, rdx;                        // anchor_x
        add rax, 0x8000;
        mov r11, 0x10000;
        cmp rax, r11;
        jae pc_bad_anchor;

        // (3) anchor_y fits i16.
        mov rax, rcx;                        // anchor_y
        add rax, 0x8000;
        mov r11, 0x10000;
        cmp rax, r11;
        jae pc_bad_anchor;

        // Build positioner_ao = (anchor_x & 0xFFFF) | ((anchor_y & 0xFFFF) << 16).
        // offset_x / offset_y default to 0 (unset in create signature).
        mov rax, rdx;                        // anchor_x
        and rax, 0xFFFF;
        mov r11, rcx;                        // anchor_y
        and r11, 0xFFFF;
        shl r11, 16;
        or  rax, r11;
        mov r14, rax;                        // r14 = positioner_ao

        // (4) surface_row_valid(surface_slot)
        mov rdi, r12;
        call surface_row_valid;
        cmp rax, 0;
        je  pc_bad_surface;

        // (5) surface_row_valid(parent_slot)
        mov rdi, r13;
        call surface_row_valid;
        cmp rax, 0;
        je  pc_bad_parent;

        // (6) Low-first free-slot scan over POPUP_ROW_MAX(16) rows.
        xor rbx, rbx;                        // rbx = candidate slot
      pc_scan:
        mov r10, [rip + POPUP_ROW_MAX];
        cmp rbx, r10;
        jae pc_enospc;
        lea r10, [rip + _popups];
        mov r11, rbx;
        shl r11, 6;                          // rbx * 64
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  pc_claim;
        add rbx, 1;
        jmp pc_scan;

      pc_claim:
        // r10 = row base for the claimed slot; keep it in rbx (dead
        // as candidate-index after this point, alive as row base
        // through the row-stamp phase).
        mov rbx, r10;

        // (7) LAM: hdr = ((old_gen + 1) & 0x00FFFFFFFFFFFFFF) | (1<<56)
        mov r11, [rbx + 0];
        mov r9, 0x00FFFFFFFFFFFFFF;
        and r11, r9;
        add r11, 1;
        and r11, r9;
        mov r8, 1;
        shl r8, 56;
        or  r11, r8;
        mov [rbx + 0], r11;

        // (8) sid = surface_row_addr(surface_slot)[+8]
        mov rdi, r12;
        call surface_row_addr;
        cmp rax, 0;
        je  pc_bad_surface_late;
        mov r10, [rax + 8];                  // r10 = sid
        mov [rsp + 8], r10;                  // stash sid

        // (9) parent_sid = surface_row_addr(parent_slot)[+8]
        mov rdi, r13;
        call surface_row_addr;
        cmp rax, 0;
        je  pc_bad_parent_late;
        mov r10, [rax + 8];                  // r10 = parent_sid
        mov [rsp + 16], r10;                 // stash parent_sid

        // (10) popup_id = pre-inc _popup_next_id (first id = 1)
        lea r10, [rip + _popup_next_id];
        mov rax, [r10 + 0];
        add rax, 1;
        mov [r10 + 0], rax;
        mov r15, rax;                        // r15 = popup_id

        // (11a) +8 = popup_id
        mov [rbx + 8], r15;

        // (11b) +16 = refs = surface_slot[31:0] | parent_slot[63:32]
        mov rax, r12;
        and rax, 0xFFFFFFFF;                 // surface_slot low 32
        mov r11, r13;
        mov r11d, r11d;                      // parent_slot low 32 (zero-extend clears bits 32-63; r11 dest for and,imm32 collides with encoder scratch per U1615)
        shl r11, 32;
        or  rax, r11;
        mov [rbx + 16], rax;

        // (11c) +24 = positioner_ao (built in r14 above)
        mov [rbx + 24], r14;

        // (11d) +32 = gravity_state = (gravity & 0xFFFF) | (state<<16)
        //       state = POPUP_STATE_ALIVE = 0 at create.
        mov rax, [rsp + 0];                  // gravity (from stack slot)
        and rax, 0xFFFF;
        mov [rbx + 32], rax;

        // (11e) +40 / +48 / +56 = reserved (zero at create)
        xor rax, rax;
        mov [rbx + 40], rax;
        mov [rbx + 48], rax;
        mov [rbx + 56], rax;

        // (12) stats.creates++
        call popup_stats_bump_creates;

        // (13) klog_s1_x3 SURFACE POPUP CREATE OK sid=<sid> pid=<popup_id>
        //      parent=<parent_sid>
        //      klog_s1_x3 ABI: rdi=level, rsi=subsys_ptr, rdx=tag_ptr,
        //      rcx=k1, r8=v1, r9=k2; stack: [rsp+8]=v2, [rsp+16]=k3,
        //      [rsp+24]=v3.
        //      At this emit-site rsp%16=0 (entry+pushes+sub 32 = 0).
        //      Pre-align via sub 8; push v3=parent_sid; push k3=popup_
        //      k_parent; push v2=popup_id; call; add rsp, 32 pops the
        //      3 pushes + pre-align.
        mov rdi, 3;                          // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + surface_popup_create_ok_msg];
        lea rcx, [rip + surface_k_sid];
        mov r8, [rsp + 8];                   // v1 = sid (from stack slot)
        lea r9, [rip + popup_k_pid];
        sub rsp, 8;                          // pre-align (rsp%16 was 0 -> 8)
        mov rax, [rsp + 24];                 // parent_sid (post-sub-8 offset)
        push rax;                            // v3 = parent_sid
        lea rax, [rip + popup_k_parent];
        push rax;                            // k3
        push r15;                            // v2 = popup_id (pid)
        call klog_s1_x3;
        add rsp, 32;                         // pop 3 pushes (24) + pre-align (8)

        // (14) return popup_id
        mov rax, r15;
        jmp pc_out;

      pc_bad_surface_late:
        // The KIND_SURFACE row went dead between gate (4) and the sid
        // read (impossible today, defense-in-depth).  Roll back the
        // header claim so the slot stays scannable, then refuse.
        // Roll-back = clear the in_use marker; the incremented
        // generation stays (ABA safety preserved by consuming the
        // generation slot).
        mov r11, [rbx + 0];
        mov r9, 0x00FFFFFFFFFFFFFF;
        and r11, r9;
        mov [rbx + 0], r11;
        mov rax, 0xFFFFE19E;                 // POPUP_BAD_SURFACE
        jmp pc_out;

      pc_bad_parent_late:
        // Same shape as pc_bad_surface_late: roll back header claim,
        // then refuse.  The parent row went dead between gate (5) and
        // the parent_sid read.
        mov r11, [rbx + 0];
        mov r9, 0x00FFFFFFFFFFFFFF;
        and r11, r9;
        mov [rbx + 0], r11;
        mov rax, 0xFFFFE19D;                 // POPUP_BAD_PARENT
        jmp pc_out;

      pc_bad_gravity:
        mov rax, 0xFFFFE19C;                 // POPUP_BAD_GRAVITY
        jmp pc_out;
      pc_bad_anchor:
        mov rax, 0xFFFFE19B;                 // POPUP_BAD_ANCHOR
        jmp pc_out;
      pc_bad_surface:
        mov rax, 0xFFFFE19E;                 // POPUP_BAD_SURFACE
        jmp pc_out;
      pc_bad_parent:
        mov rax, 0xFFFFE19D;                 // POPUP_BAD_PARENT
        jmp pc_out;
      pc_enospc:
        mov rax, 0xFFFFE19F;                 // POPUP_TAIL_ENOSPC

      pc_out:
        add rsp, 32;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // popup_dismiss(popup_id) -> 0 | err
  //
  // Compositor-facing lifetime toggle.  Gate order:
  //   (1) popup_id != 0                     -> else POPUP_BAD_ID
  //   (2) popup_find_by_id -> slot          -> else POPUP_NOT_FOUND
  //   (3) state already dismissed?          -> POPUP_ALREADY_DISMISSED
  //   (4) Set state = DISMISSED preserving gravity + reserved fields
  //   (5) stats.dismisses++
  //   (6) return 0
  //
  // Register plan: rbx=slot, r12=row_base.  Two callee-save pushes +
  // sub rsp,8 = 24 B; entry rsp%16==8 -> (8+24)=32, %16=0, aligned
  // for the two nested calls (popup_find_by_id + popup_stats_bump_
  // dismisses).
  //
  // State-field update: gravity_state word is packed as gravity[15:0]
  // | state[31:16] | reserved[63:32].  Since we've already verified
  // state == 0 (i.e., bits 16..31 are all zero), we can just OR in
  // (1<<16) rather than mask-then-or.  Reserved bits 32..63 are also
  // preserved by the OR (they stay whatever they were, though they
  // are 0 by create-time init).
  // ==========================================================================

  pub let popup_dismiss : (u64) -> u64 !{mem} @{cap} =
    fn (popup_id: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R113.M2-007 (#2387): compositor sets popup lifetime state to DISMISSED. Idempotent-refusal: second dismiss returns POPUP_ALREADY_DISMISSED rather than silently succeeding, mirrors toplevel_request_close ALREADY_CLOSING discipline. Two callee-save pushes (rbx/r12) + sub rsp,8 land rsp%16=0 (entry 8 + 16 + 8 = 32) for the two nested calls. State sits in row+32 bits 16..31; write preserves gravity (bits 0..15) and reserved (bits 32..63) via OR-in-place (safe because we've already verified state==0 pre-write). Labels prefixed pd_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        // (1) popup_id != 0
        cmp rdi, 0;
        je  pd_bad_id;

        // (2) find by id
        call popup_find_by_id;
        mov r10, 0xFFFFE19A;                 // POPUP_NOT_FOUND
        cmp rax, r10;
        je  pd_not_found;
        mov rbx, rax;                        // rbx = slot

        // Compute row base inline (slot is live -- popup_find_by_id
        // only returns live slots).
        lea r10, [rip + _popups];
        mov r11, rbx;
        shl r11, 6;
        add r10, r11;
        mov r12, r10;                        // r12 = row_base

        // (3) Read gravity_state, extract state (bits 16..31).
        mov rax, [r12 + 32];
        shr rax, 16;
        and rax, 0xFFFF;
        cmp rax, 0;
        jne pd_already;

        // (4) Set state = DISMISSED (1) preserving gravity + reserved.
        //     Since state bits are known zero, OR-in-place suffices.
        mov rax, [r12 + 32];
        mov r10, 1;
        shl r10, 16;                         // r10 = 1 << 16
        or  rax, r10;
        mov [r12 + 32], rax;

        // (5) stats.dismisses++
        call popup_stats_bump_dismisses;

        // (6) return 0
        xor rax, rax;
        jmp pd_out;

      pd_bad_id:
        mov rax, 0xFFFFE199;                 // POPUP_BAD_ID
        jmp pd_out;
      pd_not_found:
        mov rax, 0xFFFFE19A;                 // POPUP_NOT_FOUND
        jmp pd_out;
      pd_already:
        mov rax, 0xFFFFE198;                 // POPUP_ALREADY_DISMISSED

      pd_out:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }
}
