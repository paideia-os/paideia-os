// src/kernel/core/graphics/login_screen.pdx -- R113.M5-023 (paideia-os #2403)
//
// Login-screen compositor hook: pre-session state.
//
// PURPOSE.  Before a user shell activates, the compositor must render a
// login prompt surface AND block every user-shell surface from receiving
// events.  This module owns that pre-session state transition: on
// login_screen_activate() the current z-order stack and focus cells are
// snapshotted, the z-order stack is cleared to a single login surface,
// and keyboard focus latches on that surface.  On login_screen_
// deactivate() (called by the authentication broker on credential
// success) the snapshotted z-order + focus cells are restored, the login
// surface is destroyed, and the compositor resumes the user shell's
// event flow untouched.
//
// SITS ABOVE.
//   * kind_surface   (R113.M1-001, #2381)  -- surface_mint / surface_destroy
//                                              / surface_row_valid.  The login
//                                              surface is an ordinary KIND_
//                                              SURFACE row (no special kind
//                                              bit), differing only in owner
//                                              task and lifecycle scope.
//   * z_order        (R113.M2-010, #2390)  -- _z_stack[16] + _z_stack_count
//                                              are the pre-session snapshot
//                                              target.  We touch the storage
//                                              directly rather than call
//                                              z_order_remove/push_top per
//                                              slot: the snapshot must be
//                                              atomic in the sense that no
//                                              intermediate state (partial
//                                              stack, wrong-order stack)
//                                              can be seen by a concurrent
//                                              read from the compositor
//                                              backend, and per-slot ops
//                                              would emit a fingerprint per
//                                              slot which floods the tag
//                                              wire with an
//                                              observability-only ceremony.
//   * focus          (R113.M2-011, #2391)  -- _kbd_focus_slot / _ptr_focus_
//                                              slot / _implicit_grab_slot
//                                              are all snapshotted.
//                                              Reinstatement on
//                                              deactivate writes the cells
//                                              DIRECTLY (not via focus_set_
//                                              keyboard) for the same "no
//                                              extra fingerprint noise"
//                                              rationale that governs the
//                                              z_order snapshot.  The
//                                              LOGIN SCREEN DISMISSED tag
//                                              is the single boot-witness
//                                              anchor for the whole
//                                              restoration.
//   * kind_session   (R113.M5-022, #2402)  -- SESSION_STATE_LOGIN(1) is
//                                              the substrate state a
//                                              session sits in while this
//                                              module's active flag is
//                                              set.  A follow-on session-
//                                              manager landing will
//                                              transition to SESSION_
//                                              STATE_ACTIVE(2) as the
//                                              same call cascade that
//                                              triggers login_screen_
//                                              deactivate; this module
//                                              does NOT itself touch the
//                                              KIND_SESSION substrate --
//                                              blocking user-shell
//                                              activation is expressed as
//                                              a queryable flag
//                                              (login_screen_is_active())
//                                              that the session manager
//                                              consults.
//
// -----------------------------------------------------------------------------
// FIVE ENTRY POINTS
// -----------------------------------------------------------------------------
//
//   * login_screen_init()                     -- boot-time scrub of every
//                                                cell in this module to zero.
//                                                Called from kernel_main.pdx
//                                                boot cascade after z_order_
//                                                init / focus_init (which
//                                                own the cells this module
//                                                snapshots FROM).  .bss is
//                                                already zero at real boot;
//                                                this leaf preserves the
//                                                chaos-restart re-scrub
//                                                discipline the sibling
//                                                init leaves establish.
//
//   * login_screen_is_active() -> u64         -- pure accessor for the
//                                                _login_screen_active
//                                                cell.  Returns 1 while
//                                                the login prompt owns
//                                                the compositor front and
//                                                0 otherwise.  The
//                                                session-manager gate on
//                                                user-shell activation
//                                                calls this and refuses
//                                                the transition to
//                                                SESSION_STATE_ACTIVE
//                                                (kind_session.pdx §3)
//                                                while the return is 1.
//
//   * login_screen_activate() -> u64          -- snapshot z_order + focus;
//                                                clear z_order; mint the
//                                                login surface; focus_set_
//                                                keyboard on it.  Emits
//                                                LOGIN SCREEN ACTIVE
//                                                sid=<login_surface_slot>
//                                                on success.  Refusal
//                                                arms restore any state
//                                                partially cleared, so a
//                                                failed activate never
//                                                leaves the compositor
//                                                half-torn.
//
//   * login_screen_deactivate() -> u64        -- restore snapshotted
//                                                z_order + focus (direct
//                                                writes, no fingerprint
//                                                per-cell); destroy the
//                                                login surface; clear
//                                                the active flag.
//                                                Emits LOGIN SCREEN
//                                                DISMISSED sid=<former
//                                                login_surface_slot> on
//                                                success.  surface_
//                                                destroy's return is
//                                                intentionally swallowed
//                                                (best-effort dismissal;
//                                                the DISMISSED tag is
//                                                the state-transition
//                                                anchor, not the destroy
//                                                success).
//
// -----------------------------------------------------------------------------
// WHY DIRECT STORAGE ACCESS INTO z_order / focus CELLS
// -----------------------------------------------------------------------------
//
// The alternative -- iterate the saved z_order snapshot and call
// z_order_push_top per slot on restore -- has three defects for the
// pre-session context:
//
//   (a) FINGERPRINT FLOOD.  Each push_top does not emit today, but the
//       "raise on focus" side-effect on the final focus_set_keyboard call
//       WOULD emit a Z ORDER RAISE OK per invocation, and the direct
//       restore avoids all N emitters in favour of the one LOGIN SCREEN
//       DISMISSED anchor -- the semantic being restored is "the state
//       that existed before login", not "N successive activate events".
//
//   (b) VALIDATION SEMANTICS.  z_order_push_top validates each slot via
//       surface_row_valid.  A surface destroyed BETWEEN the snapshot and
//       the restore (a shell surface reaped by a user-shell exit while
//       the login prompt was up) would silently drop from the restored
//       stack, changing the observable post-condition without a witness.
//       Direct restore preserves the exact snapshot bytes; the next
//       compositor pass over the restored stack notices the stale slot
//       via surface_row_valid at paint time (composite_gpu.pdx
//       cpbb_stale_skip arm) and does the right thing without silent
//       data loss.
//
//   (c) ATOMIC RESTORE.  The direct write is a straight-line sequence
//       of 17 stores (16 slots + count); no partial-restore state
//       observable to any concurrent read from the compositor backend.
//       The push_top iteration would leave the stack in every prefix
//       state 0..16 in turn.  This matters for backends running on a
//       separate CPU today (composite_gpu concurrency is deferred to
//       the R113.M4 multi-core landing, but the invariant should hold
//       at the primitive level so a future concurrency landing does
//       not need to widen the module's API surface).
//
// The z_order snapshot copies ALL 16 slots regardless of _z_stack_count
// because (a) the copy is a fixed cost (~128 bytes), (b) it removes a
// count-conditional inside the copy loop, (c) it makes the restore
// trivially symmetric with the snapshot (no "the tail is stale" trap on
// a shrinking count between activate and deactivate).
//
// -----------------------------------------------------------------------------
// LOGIN-SURFACE ATTRIBUTES
// -----------------------------------------------------------------------------
//
//   * owner_task = LOGIN_SCREEN_OWNER_TASK (= 1).  The compositor is the
//     owner; 1 is used as the sentinel "kernel-owned" task id in every
//     kind_* landing that mints a substrate-visible resource without a
//     genuine user task attached (kind_gpu_bo's boot witness, kind_
//     display_plane's synth path, etc.).  A future task-substrate
//     landing that introduces a real COMPOSITOR_TASK_ID constant can
//     retire this sentinel in a single-token edit.
//
//   * width  = LOGIN_SCREEN_WIDTH  (= 800)
//   * height = LOGIN_SCREEN_HEIGHT (= 600)
//     Fixed 800x600 XRGB8888 -- the smallest resolution T14 G4 GOP is
//     guaranteed to negotiate on the R111.M4-016 (#2373) framebuffer
//     bring-up path.  A follow-on landing that reads the live GOP
//     framebuffer geometry (once R113.M4-021 wires it into the graphics
//     substrate) will refine these to native resolution; the login
//     prompt's own layout code caps at these dimensions so scaling to
//     native is transparent.
//
//   * format = LOGIN_SCREEN_FORMAT (= SF_FOURCC_XRGB8888 = 0x34325258).
//     The single fourcc every DPP row in the R113.M1-004 surface_format
//     table declares native.  Passing the incompatible-pair gate
//     (surface_format.pdx bfc_out) is not this landing's problem --
//     surface_mint only validates format != 0; the compatibility check
//     runs on first buffer attach (M1-004 first-attach path).
//
// -----------------------------------------------------------------------------
// FAILURE TAXONOMY -- 0xFFFFE280..0xFFFFE28F (per issue directive)
// -----------------------------------------------------------------------------
//
// Pre-landing sweep (2026-09-08):
//
//     $ grep -rn '0xFFFFE28' src design  ->  empty
//
// so 0xFFFFE280..0xFFFFE28F is fresh and uncontested.  Neighbouring
// bands in the 0xFFFFE2XX page:
//
//   0xFFFFE270..E27F  R113.M5-022 KIND_SESSION substrate
//   0xFFFFE280..E28F  R113.M5-023 LOGIN SCREEN  (THIS FILE)
//
// Slot map:
//
//   0xFFFFE280  LOGIN_SCREEN_RESTORE_FAILED   (reserved; no arm emits this
//                                              today -- direct-restore is
//                                              infallible.  Kept as a
//                                              reservation so a future
//                                              concurrency landing can
//                                              express "snapshot torn"
//                                              without opening a new band)
//   0xFFFFE281..0xFFFFE28A                    reserved for follow-on
//                                              (per-seat login screens,
//                                              gesture claim during login,
//                                              etc.)
//   0xFFFFE28B  LOGIN_SCREEN_DESTROY_FAILED   surface_destroy on the login
//                                              surface returned a non-zero
//                                              code (unreachable on the
//                                              happy path -- we minted
//                                              the slot ourselves and no
//                                              one else can revoke it
//                                              while active_flag == 1;
//                                              held as a reservation)
//   0xFFFFE28C  LOGIN_SCREEN_FOCUS_FAILED     focus_set_keyboard on the
//                                              minted login surface
//                                              returned non-zero.
//                                              Unreachable on the happy
//                                              path -- surface_row_valid
//                                              trivially passes on a
//                                              just-minted slot; held as
//                                              a defensive reservation.
//   0xFFFFE28D  LOGIN_SCREEN_MINT_FAILED      surface_mint returned an
//                                              error (e.g. SURFACE_TAIL_
//                                              ENOSPC when every slot is
//                                              already in use).  Reachable
//                                              iff the user shell has
//                                              minted every KIND_SURFACE
//                                              row and login is invoked
//                                              before a single revoke.
//   0xFFFFE28E  LOGIN_SCREEN_NOT_ACTIVE       login_screen_deactivate
//                                              called while
//                                              _login_screen_active == 0.
//   0xFFFFE28F  LOGIN_SCREEN_ALREADY_ACTIVE   login_screen_activate
//                                              called while
//                                              _login_screen_active == 1.
//
// -----------------------------------------------------------------------------
// FINGERPRINT TAGS (per issue #2403 §3)
// -----------------------------------------------------------------------------
//
// Wire form (post-klog_s1_x1 KV append):
//
//   login screen active    [legacy: LOGIN SCREEN ACTIVE]    sid=0x<hex>
//   login screen dismissed [legacy: LOGIN SCREEN DISMISSED] sid=0x<hex>
//
// Byte counts verified by hand:
//   "login screen active [legacy: LOGIN SCREEN ACTIVE]\0"        = 50 bytes
//     - "login screen active"                = 19
//     - " [legacy: "                         = 10
//     - "LOGIN SCREEN ACTIVE"                = 19
//     - "]"                                  = 1
//     - "\0"                                 = 1
//   "login screen dismissed [legacy: LOGIN SCREEN DISMISSED]\0"  = 56 bytes
//     - "login screen dismissed"             = 22
//     - " [legacy: "                         = 10
//     - "LOGIN SCREEN DISMISSED"             = 22
//     - "]"                                  = 1
//     - "\0"                                 = 1
//
// Both tags carry the "sid" KV via login_k_sid ("sid\0", 4 bytes).
// Neither contains the "OK" token, so verify-fingerprint-coverage.sh
// does NOT enumerate them -- they are state-transition markers, not
// success-rollup markers, and follow the R89.M1-005 boot-witness /
// R113.M5-022 SESSION MINT OK naming convention where the OK token is
// scoped to success-rollup wire lines only.
//
// -----------------------------------------------------------------------------
// EXTERNAL SYMBOLS
// -----------------------------------------------------------------------------
//
// This module references (bare symbols, kernel .pdx single global
// namespace, same pattern as focus.pdx / z_order.pdx):
//
//   * surface_mint            (kind_surface.pdx)   -- mint login surface
//   * surface_destroy         (kind_surface.pdx)   -- destroy on deactivate
//   * SURFACE_ROW_MAX         (kind_surface.pdx)   -- mint success gate
//   * focus_set_keyboard      (focus.pdx)          -- latch login focus
//   * _kbd_focus_slot         (focus.pdx)          -- snapshot source
//   * _ptr_focus_slot         (focus.pdx)          -- snapshot source
//   * _implicit_grab_slot     (focus.pdx)          -- snapshot source
//   * _z_stack                (z_order.pdx)        -- snapshot source/dest
//   * _z_stack_count          (z_order.pdx)        -- snapshot source/dest
//   * SUBSYS_CAP_             (klog subsystem ordinal)
//   * klog_s1_x1              (klog/wrappers.pdx)  -- 1-KV hex emit
//
// -----------------------------------------------------------------------------
// ENCODER PITFALLS (per feedback_pdx_encoder_pitfalls v0.36+)
// -----------------------------------------------------------------------------
//
//   * No `test rN, rN` -- every zero-check uses `cmp rN, 0` + `je/jne`.
//   * No 2-op `imul r, imm` -- no row-offset math in this file.
//   * No `and reg, imm64` -- no wide masks in this file.
//   * No `cmp reg, [mem]` -- every mem compare loads to a scratch first.
//   * No literal-scaled `[reg + N*8]` -- displacement `[reg + 0]` for
//     scalar cells; register-scaled `[reg + rcx * 8]` (scale 8 in the
//     legal {1,2,4,8} set) for the z_stack snapshot / restore loops.
//   * No `mov qword [mem], imm64` -- immediates staged in a register
//     first (0 via `xor rax, rax`; 1 via `mov rax, 1`).
//   * Reserved-keyword labels avoided (loop/if/let/while/for/match/pub/
//     mod/use/fn/struct/enum/impl/trait/type/where/move/mut/ref).
//     Label prefixes:  ls_i_    login_screen_init
//                      ls_q_    login_screen_is_active
//                      ls_a_    login_screen_activate
//                      ls_d_    login_screen_deactivate
//   * Multiline `pub let ="..."` refused by the encoder -- both string
//     literals in this file live on one source line.
//   * Module name matches file basename: `LoginScreen` for
//     `login_screen.pdx`.
//   * Fingerprint tag byte counts computed by hand and asserted in the
//     `[u8; N]` type ascription (50 for the active tag, 56 for the
//     dismissed tag, 4 for the sid KV key).
//
// -----------------------------------------------------------------------------
// STACK DISCIPLINE
// -----------------------------------------------------------------------------
//
// Both activate and deactivate push a single callee-save (rbx = login
// surface slot).  Entry rsp%16==8, +8 = 16, %16==0 for every nested
// call (surface_mint, focus_set_keyboard, surface_destroy, klog_s1_x1).
// All nested callees preserve rbx per SysV so the slot survives to the
// fingerprint emission.  login_screen_init and login_screen_is_active
// are pure leaves with no push and no nested call.

module LoginScreen = structure {

  // ==========================================================================
  // SECTION 1 -- CONSTANTS
  // ==========================================================================

  pub let LOGIN_SCREEN_OK                 : u64 = 0

  // Failure taxonomy (per file header §"FAILURE TAXONOMY").
  pub let LOGIN_SCREEN_RESTORE_FAILED     : u64 = 0xFFFFE280
  pub let LOGIN_SCREEN_DESTROY_FAILED     : u64 = 0xFFFFE28B
  pub let LOGIN_SCREEN_FOCUS_FAILED       : u64 = 0xFFFFE28C
  pub let LOGIN_SCREEN_MINT_FAILED        : u64 = 0xFFFFE28D
  pub let LOGIN_SCREEN_NOT_ACTIVE         : u64 = 0xFFFFE28E
  pub let LOGIN_SCREEN_ALREADY_ACTIVE     : u64 = 0xFFFFE28F

  // Login-surface attributes (per file header §"LOGIN-SURFACE ATTRIBUTES").
  // Sentinel owner_task 1 mirrors kind_gpu_bo boot-witness / kind_display_
  // plane synth path convention; a future task-substrate landing that
  // introduces COMPOSITOR_TASK_ID retires the sentinel in one edit.
  pub let LOGIN_SCREEN_OWNER_TASK : u64 = 1
  pub let LOGIN_SCREEN_WIDTH      : u64 = 800
  pub let LOGIN_SCREEN_HEIGHT     : u64 = 600
  // SF_FOURCC_XRGB8888 (surface_format.pdx L95): the single fourcc
  // every DPP row declares native in the M1-004 supported-pairs table.
  pub let LOGIN_SCREEN_FORMAT     : u64 = 0x34325258

  // ==========================================================================
  // SECTION 2 -- STATE CELLS (.bss, @align as noted)
  //
  // Zero-init at .bss load is the semantic identity for _login_screen_
  // active (== 0 means "no login screen up"), so a mint-and-forget path
  // that skips login_screen_init still reports the correct pre-session
  // state.  login_screen_init defensively re-scrubs at boot to preserve
  // the sibling init leaves' chaos-restart discipline.
  // ==========================================================================

  pub let mut _login_screen_active   : u64        = uninit @align(8)
  pub let mut _login_surface_slot    : u64        = uninit @align(8)

  // Snapshot cells for focus (from focus.pdx).
  pub let mut _saved_kbd_focus       : u64        = uninit @align(8)
  pub let mut _saved_ptr_focus       : u64        = uninit @align(8)
  pub let mut _saved_grab            : u64        = uninit @align(8)

  // Snapshot cells for z_order (from z_order.pdx).  Full 16-slot copy
  // per file header §"WHY DIRECT STORAGE ACCESS".
  pub let mut _saved_z_stack         : [u64; 16]  = uninit @align(64)
  pub let mut _saved_z_stack_count   : u64        = uninit @align(8)

  // ==========================================================================
  // SECTION 3 -- FINGERPRINT TAGS + KV KEY
  //
  // Byte counts verified by hand and asserted in the type ascription.
  // Both literals live on one source line (multiline `pub let ="..."` is
  // refused by the encoder per feedback_pdx_encoder_pitfalls).
  // ==========================================================================

  pub let login_screen_active_msg    : [u8; 50] = "login screen active [legacy: LOGIN SCREEN ACTIVE]\0"
  pub let login_screen_dismissed_msg : [u8; 56] = "login screen dismissed [legacy: LOGIN SCREEN DISMISSED]\0"
  pub let login_k_sid                : [u8; 4]  = "sid\0"

  // ==========================================================================
  // SECTION 4 -- login_screen_init() -> ()
  //
  // Zero every cell owned by this module.  Called from kernel_main.pdx
  // boot cascade after z_order_init / focus_init (which own the cells
  // this module snapshots FROM -- init order matters only inasmuch as
  // this file must not read those cells before they are latched, but
  // login_screen_init itself does not read them, so the ordering is
  // enforced by convention rather than data dependency).
  // ==========================================================================

  pub let login_screen_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M5-023 (#2403): scrub every login-screen cell to zero. Six scalar cells + a 16-word saved z_stack. Straight-line loop over the array using register-scaled SIB [r10 + rcx * 8] (scale 8 in the legal {1,2,4,8} set). Zero staged via xor rax, rax then stored (no `mov qword [mem], imm64` form). Zero-arg leaf; no callee-save; entry rsp%16=8 unchanged on return. Labels prefixed ls_i_.",
      block: {
        xor rax, rax;

        lea r10, [rip + _login_screen_active];
        mov [r10 + 0], rax;

        lea r10, [rip + _login_surface_slot];
        mov [r10 + 0], rax;

        lea r10, [rip + _saved_kbd_focus];
        mov [r10 + 0], rax;

        lea r10, [rip + _saved_ptr_focus];
        mov [r10 + 0], rax;

        lea r10, [rip + _saved_grab];
        mov [r10 + 0], rax;

        lea r10, [rip + _saved_z_stack_count];
        mov [r10 + 0], rax;

        lea r10, [rip + _saved_z_stack];
        xor rcx, rcx;
      ls_i_scrub:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 16;
        jb  ls_i_scrub;

        ret
      }
    }

  // ==========================================================================
  // SECTION 5 -- login_screen_is_active() -> u64
  //
  // Pure accessor for the _login_screen_active cell.  1 while the login
  // prompt owns the compositor front, 0 otherwise.  The session-manager
  // gate on user-shell activation calls this and refuses SESSION_STATE_
  // ACTIVE while the return is 1 (per file header §SITS ABOVE).
  // ==========================================================================

  pub let login_screen_is_active : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M5-023 (#2403): rip-relative load of _login_screen_active. Pure leaf; no callee-save; entry rsp%16=8 unchanged on ret. Labels prefixed ls_q_ (none needed).",
      block: {
        lea r10, [rip + _login_screen_active];
        mov rax, [r10 + 0];
        ret
      }
    }

  // ==========================================================================
  // SECTION 6 -- login_screen_activate() -> u64
  //
  // Gate order:
  //   (1) _login_screen_active == 0        -> else LOGIN_SCREEN_ALREADY_ACTIVE
  //   (2) snapshot focus cells (kbd/ptr/grab)
  //   (3) snapshot z_stack contents + count (full 16-slot copy)
  //   (4) clear z_stack (count = 0; leave array cells intact -- count
  //       gates every reader)
  //   (5) surface_mint(owner=1, w=800, h=600, format=XRGB8888)
  //         -> else LOGIN_SCREEN_MINT_FAILED (+ restore z_stack)
  //   (6) focus_set_keyboard(login_surface_slot)
  //         -> else LOGIN_SCREEN_FOCUS_FAILED (+ destroy surface + restore
  //            z_stack)
  //   (7) _login_screen_active = 1
  //   (8) emit LOGIN SCREEN ACTIVE sid=<login_surface_slot> via klog_s1_x1
  //   (9) return 0
  //
  // Mint-success check: surface_mint returns row_id (0..SURFACE_ROW_MAX-1)
  // on success or a code >= 0xFFFFE110 on failure.  Any return < SURFACE_
  // ROW_MAX(16) is a valid slot; any other value is an error to propagate.
  //
  // Focus-success check: focus_set_keyboard returns 0 on success (the
  // silent-no-op arm also returns 0) or FOCUS_BAD_SLOT (0xFFFFE180) on
  // an unlivable slot.  On our just-minted slot the BAD_SLOT arm is
  // unreachable, but the code defensively handles it.
  //
  // Register plan: one callee-save push (rbx = login_surface_slot from
  // step 5 onward) aligns rsp%16=0 (entry 8 + 8 = 16) for every nested
  // call.  All nested callees (surface_mint, focus_set_keyboard,
  // surface_destroy, klog_s1_x1) preserve rbx per SysV.
  // ==========================================================================

  pub let login_screen_activate : () -> u64 !{mem, sysreg} @{cap} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R113.M5-023 (#2403): enter pre-session compositor state. Gate order per file header §SECTION 6: (1) ALREADY_ACTIVE gate; (2) snapshot _kbd_focus_slot / _ptr_focus_slot / _implicit_grab_slot; (3) snapshot _z_stack (full 16-slot copy) + _z_stack_count; (4) clear _z_stack_count (array cells intact; count gates every reader per z_order.pdx §POOL); (5) surface_mint(1, 800, 600, XRGB8888) -- MINT_FAILED arm restores z_stack (no login surface yet); (6) focus_set_keyboard(slot) -- FOCUS_FAILED arm destroys the minted surface then restores z_stack (defensive; BAD_SLOT unreachable post-mint); (7) latch active_flag = 1; (8) emit LOGIN SCREEN ACTIVE sid=<slot> via klog_s1_x1 with login_k_sid; (9) return 0. Mint-success sentinel: valid row_id is < SURFACE_ROW_MAX(16); any other return is a taxonomy code (>= 0xFFFFE110). One callee-save push (rbx = login_surface_slot) aligns rsp%16=0 for every nested call; surface_mint / focus_set_keyboard / surface_destroy / klog_s1_x1 all preserve rbx per SysV so the slot survives to emission. No test rN,rN; no 2-op imul; no `and reg, imm64`; no `cmp reg, [mem]` (SURFACE_ROW_MAX loaded to r11 first); z_stack copy uses register-scaled [r10 + rcx * 8] (scale 8 in the legal set). Labels prefixed ls_a_.",
      block: {
        push rbx;

        // Gate 1: not already active
        lea r10, [rip + _login_screen_active];
        mov rax, [r10 + 0];
        cmp rax, 0;
        jne ls_a_already;

        // Step 2: snapshot focus cells
        lea r10, [rip + _kbd_focus_slot];
        mov rax, [r10 + 0];
        lea r10, [rip + _saved_kbd_focus];
        mov [r10 + 0], rax;

        lea r10, [rip + _ptr_focus_slot];
        mov rax, [r10 + 0];
        lea r10, [rip + _saved_ptr_focus];
        mov [r10 + 0], rax;

        lea r10, [rip + _implicit_grab_slot];
        mov rax, [r10 + 0];
        lea r10, [rip + _saved_grab];
        mov [r10 + 0], rax;

        // Step 3: snapshot z_stack (count + all 16 slots)
        lea r10, [rip + _z_stack_count];
        mov r11, [r10 + 0];
        lea r10, [rip + _saved_z_stack_count];
        mov [r10 + 0], r11;

        xor rcx, rcx;
      ls_a_savez:
        lea r10, [rip + _z_stack];
        mov rax, [r10 + rcx * 8];
        lea r10, [rip + _saved_z_stack];
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 16;
        jb  ls_a_savez;

        // Step 4: clear live z_stack (count = 0; array cells intact)
        xor rax, rax;
        lea r10, [rip + _z_stack_count];
        mov [r10 + 0], rax;

        // Step 5: mint login surface
        mov rdi, 1;                          // owner_task = LOGIN_SCREEN_OWNER_TASK
        mov rsi, 800;                        // w = LOGIN_SCREEN_WIDTH
        mov rdx, 600;                        // h = LOGIN_SCREEN_HEIGHT
        mov rcx, 0x34325258;                 // format = LOGIN_SCREEN_FORMAT (XRGB8888)
        call surface_mint;

        // Mint success gate: rax < SURFACE_ROW_MAX -> valid slot; else error.
        mov r11, [rip + SURFACE_ROW_MAX];
        cmp rax, r11;
        jae ls_a_mint_failed;

        // Save login surface slot in callee-save + module cell.
        mov rbx, rax;
        lea r10, [rip + _login_surface_slot];
        mov [r10 + 0], rbx;

        // Step 6: focus_set_keyboard(login_surface_slot)
        mov rdi, rbx;
        call focus_set_keyboard;
        cmp rax, 0;
        jne ls_a_focus_failed;

        // Step 7: latch active flag
        mov rax, 1;
        lea r10, [rip + _login_screen_active];
        mov [r10 + 0], rax;

        // Step 8: emit LOGIN SCREEN ACTIVE sid=<login_surface_slot>
        mov rdi, 3;                          // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + login_screen_active_msg];
        lea rcx, [rip + login_k_sid];
        mov r8, rbx;                         // sid = login_surface_slot
        call klog_s1_x1;

        // Step 9: return 0
        xor rax, rax;
        jmp ls_a_out;

      ls_a_already:
        mov rax, 0xFFFFE28F;                 // LOGIN_SCREEN_ALREADY_ACTIVE
        jmp ls_a_out;

      ls_a_mint_failed:
        // No login surface exists yet; restore z_stack (count + slots) and
        // return LOGIN_SCREEN_MINT_FAILED.  Focus cells were only READ in
        // step 2; not modified, no restore needed.
        xor rcx, rcx;
      ls_a_mf_restore:
        lea r10, [rip + _saved_z_stack];
        mov rax, [r10 + rcx * 8];
        lea r10, [rip + _z_stack];
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 16;
        jb  ls_a_mf_restore;
        lea r10, [rip + _saved_z_stack_count];
        mov rax, [r10 + 0];
        lea r10, [rip + _z_stack_count];
        mov [r10 + 0], rax;
        mov rax, 0xFFFFE28D;                 // LOGIN_SCREEN_MINT_FAILED
        jmp ls_a_out;

      ls_a_focus_failed:
        // focus_set_keyboard failed -- destroy the just-minted login
        // surface (its return is swallowed; the deactivate path uses the
        // same swallow discipline) and restore z_stack.  focus_set_
        // keyboard returns BAD_SLOT before any write, so _kbd_focus_slot
        // is unmodified; no focus restore needed.
        mov rdi, rbx;
        call surface_destroy;
        // Clear _login_surface_slot too so a subsequent activate cannot
        // observe the stale slot.
        xor rax, rax;
        lea r10, [rip + _login_surface_slot];
        mov [r10 + 0], rax;
        xor rcx, rcx;
      ls_a_ff_restore:
        lea r10, [rip + _saved_z_stack];
        mov rax, [r10 + rcx * 8];
        lea r10, [rip + _z_stack];
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 16;
        jb  ls_a_ff_restore;
        lea r10, [rip + _saved_z_stack_count];
        mov rax, [r10 + 0];
        lea r10, [rip + _z_stack_count];
        mov [r10 + 0], rax;
        mov rax, 0xFFFFE28C;                 // LOGIN_SCREEN_FOCUS_FAILED

      ls_a_out:
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION 7 -- login_screen_deactivate() -> u64
  //
  // Gate order:
  //   (1) _login_screen_active == 1        -> else LOGIN_SCREEN_NOT_ACTIVE
  //   (2) load rbx = _login_surface_slot   (for destroy + fingerprint)
  //   (3) restore z_stack count + all 16 slots (direct writes)
  //   (4) restore focus cells (direct writes; no focus_set_keyboard call
  //       per file header §"WHY DIRECT STORAGE ACCESS")
  //   (5) surface_destroy(login_surface_slot) -- return swallowed
  //   (6) clear _login_screen_active + _login_surface_slot
  //   (7) emit LOGIN SCREEN DISMISSED sid=<login_surface_slot> via
  //       klog_s1_x1
  //   (8) return 0
  //
  // The direct-write restore is infallible; no arm emits LOGIN_SCREEN_
  // RESTORE_FAILED today (the code is a reservation per file header
  // §"FAILURE TAXONOMY").  surface_destroy's return is swallowed --
  // dismissal semantics prioritise the state-transition anchor over the
  // destroy-success signal; a follow-on landing that plumbs a real
  // failure mode (e.g. a chaos-restart witness that revokes the login
  // surface out from under us) can lift the swallow into a taxonomy
  // slot (0xFFFFE28B is pre-reserved).
  //
  // Register plan: one callee-save push (rbx = login_surface_slot from
  // step 2 onward) aligns rsp%16=0 (entry 8 + 8 = 16) for every nested
  // call (surface_destroy, klog_s1_x1).  Both preserve rbx per SysV.
  // ==========================================================================

  pub let login_screen_deactivate : () -> u64 !{mem, sysreg} @{cap} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R113.M5-023 (#2403): exit pre-session compositor state. Gate order per file header §SECTION 7: (1) NOT_ACTIVE gate; (2) load rbx = _login_surface_slot for destroy + fingerprint; (3) restore _z_stack_count + all 16 z_stack slots via direct writes; (4) restore _kbd_focus_slot / _ptr_focus_slot / _implicit_grab_slot via direct writes (NOT via focus_set_keyboard -- would emit spurious FOCUS KBD OK + drive z_order_raise on the just-restored stack; the LOGIN SCREEN DISMISSED tag is the single restoration anchor per file header §WHY DIRECT STORAGE ACCESS); (5) surface_destroy(login_surface_slot) -- return swallowed per §SECTION 7 rationale; (6) clear active_flag + login_surface_slot cells; (7) emit LOGIN SCREEN DISMISSED sid=<login_surface_slot> via klog_s1_x1 with login_k_sid; (8) return 0. Direct-restore infallible today -- LOGIN_SCREEN_RESTORE_FAILED (0xFFFFE280) held as reservation for a future concurrency landing. One callee-save push (rbx = login_surface_slot) aligns rsp%16=0 for surface_destroy + klog_s1_x1; both preserve rbx per SysV so the slot survives to emission. No test rN,rN; no 2-op imul; no `and reg, imm64`; no `cmp reg, [mem]`; z_stack restore uses register-scaled [r10 + rcx * 8] (scale 8 in the legal set). Labels prefixed ls_d_.",
      block: {
        push rbx;

        // Gate 1: must be active
        lea r10, [rip + _login_screen_active];
        mov rax, [r10 + 0];
        cmp rax, 0;
        je  ls_d_not_active;

        // Step 2: load login surface slot for destroy + fingerprint
        lea r10, [rip + _login_surface_slot];
        mov rbx, [r10 + 0];

        // Step 3: restore z_stack (count + all 16 slots)
        lea r10, [rip + _saved_z_stack_count];
        mov r11, [r10 + 0];
        lea r10, [rip + _z_stack_count];
        mov [r10 + 0], r11;

        xor rcx, rcx;
      ls_d_rstz:
        lea r10, [rip + _saved_z_stack];
        mov rax, [r10 + rcx * 8];
        lea r10, [rip + _z_stack];
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 16;
        jb  ls_d_rstz;

        // Step 4: restore focus cells (direct writes)
        lea r10, [rip + _saved_kbd_focus];
        mov rax, [r10 + 0];
        lea r10, [rip + _kbd_focus_slot];
        mov [r10 + 0], rax;

        lea r10, [rip + _saved_ptr_focus];
        mov rax, [r10 + 0];
        lea r10, [rip + _ptr_focus_slot];
        mov [r10 + 0], rax;

        lea r10, [rip + _saved_grab];
        mov rax, [r10 + 0];
        lea r10, [rip + _implicit_grab_slot];
        mov [r10 + 0], rax;

        // Step 5: surface_destroy(login_surface_slot) -- return swallowed
        mov rdi, rbx;
        call surface_destroy;

        // Step 6: clear active + login_surface_slot cells
        xor rax, rax;
        lea r10, [rip + _login_screen_active];
        mov [r10 + 0], rax;
        lea r10, [rip + _login_surface_slot];
        mov [r10 + 0], rax;

        // Step 7: emit LOGIN SCREEN DISMISSED sid=<login_surface_slot>
        mov rdi, 3;                          // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + login_screen_dismissed_msg];
        lea rcx, [rip + login_k_sid];
        mov r8, rbx;                         // sid = login_surface_slot
        call klog_s1_x1;

        // Step 8: return 0
        xor rax, rax;
        jmp ls_d_out;

      ls_d_not_active:
        mov rax, 0xFFFFE28E;                 // LOGIN_SCREEN_NOT_ACTIVE

      ls_d_out:
        pop rbx;
        ret
      }
    }

}
