// src/kernel/core/graphics/composite_plan.pdx -- R113.M4-020 (paideia-os #2400)
//
// Damage-driven redraw: build the per-frame recomposite plan by
// walking the z-order stack top-down, gathering each surface's
// per-frame damage rects, clipping to screen bounds, and emitting
// a flat array of packed u64 rects the GPU backend blits.  After
// the walk every surface's damage region is cleared so the next
// frame starts with an empty region.
//
// Umbrella: R113 (#2380); sibling to R113.M1-003 (damage_region.pdx
// #2383) which provides the per-surface rect store, R113.M2-010
// (z_order.pdx #2390) which provides the top-down slot iteration
// order, R113.M1-002 (surface_commit_ops.pdx #2382) whose commit-txn
// already clears the per-surface damage on swap.  R113.M4-020 is the
// PER-FRAME planner atop those substrates -- the piece the GPU
// backend calls once per vsync to obtain the minimal blit set.
//
// -----------------------------------------------------------------------------
// SCOPE (per issue #2400)
// -----------------------------------------------------------------------------
//
// One entry point:
//
//   composite_plan(out_rects_ptr, out_cap) -> count
//
// Semantics:
//
//   * Walk _z_stack from top (frontmost, index count-1) down to
//     back (index 0) -- the industry-standard direction for
//     composite planners because it lets a future occlusion-culling
//     pass discard damage behind opaque foreground surfaces without
//     restructuring the outer loop (R113.M4 follow-on).  For the
//     M4-020 baseline the direction is semantically equivalent to
//     bottom-up (no culling), but the loop shape is fixed here so
//     the culling landing is a pure filter insert.
//
//   * For each surface's damage region, iterate 0..damage_region_
//     count(slot) via damage_region_get(slot, i).  Each rect is
//     already packed per doc §2 damage layout:
//
//       dx[15:0] | dy[31:16] | dw[47:32] | dh[63:48]
//
//     No coordinate transform is applied: doc §2 row layout carries
//     no per-surface origin (buffer-origin state lives compositor-
//     side per doc §11 non-goals), so surface-local damage
//     coordinates ARE screen coordinates for the M4-020 landing.
//     Once surface_origin lands (R113.M2 follow-on) the transform
//     inserts here as (x, y) += (surface_origin_x, surface_origin_y)
//     before the clip step below.
//
//   * Clip each rect to the framebuffer bounds (_gop_fb_width /
//     _gop_fb_height from gop_fb_console.pdx).  A rect fully outside
//     the screen (x >= screen_w or y >= screen_h) is dropped.  A
//     rect that straddles the right/bottom edge has its width/height
//     truncated (right = min(x+w, screen_w); w' = right - x; and
//     symmetrically for y/h).  A rect that clips to zero area (w'==0
//     or h'==0) is dropped.
//
//   * Write clipped rects into out_rects_ptr[0..out_cap-1] as packed
//     u64s in the SAME layout as the input rects (doc §2), so the
//     GPU backend uses one unpack pattern for both the per-surface
//     store and the compositor's plan buffer.
//
//   * After enumeration (regardless of write outcomes), call
//     damage_region_clear(slot) for every surface visited.  The
//     clear is the "next frame starts empty" contract per doc §9
//     M4-020 line.  A surface that the compositor SKIPPED (e.g. it
//     was fully offscreen) is still cleared -- its damage was
//     enumerated and, from the planner's point of view, dispatched;
//     leaving stale damage would cause the following frame to redo
//     work already accounted for.
//
//   * Return the count of clipped rects actually WRITTEN to
//     out_rects_ptr.  If more clipped rects existed than out_cap
//     permitted, the excess is DROPPED silently (caller sees
//     count == out_cap and can escalate to a whole-screen repaint;
//     matches the weston / wlroots "damage region overflowed the
//     plan buffer" convention).
//
// Enumerate-only mode: if the caller passes (0, 0) the planner
// still walks + clears damage but writes nothing; the return value
// is 0 (nothing was written) and the fingerprint's covered= KV
// reports the input volume.  Useful for a "flush damage without
// rendering" call site (e.g. a scanout-blackout frame).  Passing
// (0, N>0) is rejected as COMPOSITE_PLAN_BAD_ARG -- a positive
// capacity without a buffer is a caller bug.
//
// -----------------------------------------------------------------------------
// FAILURE TAXONOMY -- 0xFFFFE240..0xFFFFE24F (fresh band)
// -----------------------------------------------------------------------------
//
// Pre-landing sweep (2026-09-08):
//
//   $ grep -rn '0xFFFFE24' src design  ->  empty
//
// so 0xFFFFE240..0xFFFFE24F is fresh and uncontested.  Neighbouring
// bands in the 0xFFFFE2XX page:
//
//   0xFFFFE1B0..E1BF  R113.M2-010 Z-ORDER
//   0xFFFFE1C0..E1CF  R113.M3-012 KBD ROUTE
//   0xFFFFE1D0..E1DF  R113.M3-013 PTR ROUTE
//   0xFFFFE1E0..E1EF  R113.M3-014 TOUCH ROUTE
//   0xFFFFE1F0..E1FF  free
//   0xFFFFE200..E23F  free (large window)
//   0xFFFFE240..E24F  R113.M4-020 COMPOSITE PLAN (THIS FILE)
//
// Slot map:
//
//   0xFFFFE240  COMPOSITE_PLAN_BAD_ARG   out_rects_ptr == 0 while
//                                        out_cap > 0.  A caller who
//                                        promised capacity without
//                                        supplying a buffer would
//                                        cause a wild-pointer store
//                                        on the first successful
//                                        clip; refuse before the walk.
//   0xFFFFE241..E24F                     reserved for M4 follow-on
//                                        (per-plane plans, present-
//                                        fence gating, damage-history
//                                        rollups).
//
// The count return channel does not overlap: the maximum output
// count is bounded by SURFACE_ROW_MAX(16) * DMG_RECTS_PER_SURFACE(8)
// = 128 which is far below 0xFFFFE240, so returning the count as a
// bare u64 is unambiguous versus the failure sentinel.
//
// -----------------------------------------------------------------------------
// FINGERPRINT (per issue #2400 §4)
// -----------------------------------------------------------------------------
//
// Wire form (post-klog_s1_x2 KV append):
//
//   composite plan ok [legacy: COMPOSITE PLAN OK] dirty_count=0x<hex> covered=0x<hex>
//
// Byte counts hand-verified:
//
//   "composite plan ok [legacy: COMPOSITE PLAN OK]\0"    = 46 bytes
//   "dirty_count\0"                                       = 12 bytes
//   "covered\0"                                           =  8 bytes
//
// Semantics of the two KVs:
//
//   dirty_count  Number of clipped rects actually WRITTEN to
//                out_rects_ptr.  Equals the return value.  Bounded
//                above by min(out_cap, SURFACE_ROW_MAX*DMG_RECTS_
//                PER_SURFACE) = min(out_cap, 128).
//
//   covered      Total per-surface damage rects EXAMINED across the
//                z-stack walk (sum of damage_region_count over
//                visited surfaces).  Reports the input volume the
//                planner processed BEFORE clipping / capacity
//                enforcement.  Equal to dirty_count when nothing is
//                clipped or truncated; strictly greater when either
//                offscreen rects were dropped or out_cap was
//                exceeded.  The (covered - dirty_count) gap is the
//                observability handle for "the planner did work the
//                GPU won't see" and is what a future budget-tuning
//                witness will read.
//
// Emitter cadence: composite_plan is called once per composited
// frame (60-240 Hz depending on the vsync source).  klog_s1_x2 is
// a light emitter (48-byte stack frame, one klog_emit_core call);
// the ring cost is bounded to ~250 kB/s at 240 Hz.  If frame-rate
// tuning ever surfaces this as a hot path, the natural follow-on
// is a `composite_plan_quiet` variant that suppresses the emit
// when dirty_count == 0 && covered == 0.  For M4-020 the emit is
// unconditional because (a) no live caller wires the planner yet
// (see allowlist entry below), and (b) even at 240 Hz the ring is
// far from saturation.
//
// Emitter reachability: NO live caller in the M4-020 landing.  The
// GPU backend wire (R36 display-plane bring-up / R113.M4 present-
// fence hook) is a separate follow-on landing; the planner is
// staged here so those landings are a single-call insert rather
// than a compositor-plus-planner joint drop.  The verify-
// fingerprint-coverage.sh allowlist entry mirrors the surface
// present ok / z order raise ok siblings' "wire-deferred; assertable
// when a boot witness drives the planner end-to-end" posture.
//
// -----------------------------------------------------------------------------
// EXTERNAL SYMBOLS
// -----------------------------------------------------------------------------
//
// This module references (bare symbols, kernel .pdx single global
// namespace, same pattern as surface_commit_ops.pdx / z_order.pdx):
//
//   * z_order_slot_at        (z_order.pdx)         -- top-down walk
//   * _z_stack_count         (z_order.pdx)         -- depth read
//   * damage_region_count    (damage_region.pdx)   -- per-surface count
//   * damage_region_get      (damage_region.pdx)   -- per-rect read
//   * damage_region_clear    (damage_region.pdx)   -- per-surface scrub
//   * _gop_fb_width          (gop_fb_console.pdx)  -- screen w (u64)
//   * _gop_fb_height         (gop_fb_console.pdx)  -- screen h (u64)
//   * SUBSYS_CAP_            (klog subsystem ordinal)
//   * klog_s1_x2             (klog/wrappers.pdx)   -- 2-KV hex emit
//
// The _gop_fb_width / _gop_fb_height reads are safe pre-GOP-init:
// both allocations default-zero at .bss and gop_fb_console_init
// leaves them zero on the PVH short-circuit arm.  A zero screen
// causes the first clip check (x >= screen_w) to fire on the very
// first rect (x >= 0 iff x == 0, and 0 >= 0 is TRUE with ja/jae
// semantics -- `cmp x, 0; jae drop` drops any x >= 0 which includes
// x == 0), collapsing the output to zero rects.  The walk still
// runs, damage is still cleared, and the fingerprint reports
// dirty_count=0 covered=<total>.  No crash surface.
//
// -----------------------------------------------------------------------------
// ENCODER PITFALLS (per feedback_pdx_encoder_pitfalls v0.36+)
// -----------------------------------------------------------------------------
//
//   * No `test rN, rN` -- every zero-check uses `cmp rN, 0` + `je/jne`.
//   * No 2-op `imul r, imm` -- offsets computed via shr / shl or via
//     register-scaled SIB `[reg + rN * 8]` (scale 8 in the legal
//     {1,2,4,8} set).
//   * No `and reg, imm64` -- masks are `and reg, 0xFFFF` (imm32
//     0x0000FFFF, sign bit clear at bit 31, safe per surface_commit_
//     ops.pdx L269 precedent).
//   * No `cmp reg, [mem]` -- every mem compare loads to a scratch
//     first (`mov rdx, [rbp - N]; cmp r13, rdx`).
//   * Failure sentinel `0xFFFFE240` and error return use `mov reg,
//     imm64`; the encoder emits the 10-byte imm64 form for constants
//     with bit 31 set (established idiom throughout kind_surface.pdx
//     failure returns).  Sentinel comparison uses `cmp rax, 8; ja
//     ...` rather than a literal sentinel cmp to avoid any imm32
//     sign-extension footgun.
//   * `mov [rdx + r13 * 8], rax` uses register-scaled SIB with scale
//     in the legal {1,2,4,8} set (surface_toplevel.pdx precedent).
//   * `[rip + sym]` and `lea reg, [rip + sym]` are the standing forms
//     for global data access; every symbol reference is bare.
//   * Multiline `pub let ="..."` refused by the encoder -- both
//     string literals in this file live on one source line each.
//   * Module name matches file basename: `CompositePlan` for
//     `composite_plan.pdx`.
//   * Fingerprint tag byte counts computed by hand and asserted in
//     the `[u8; N]` type ascription (46 for the ok tag, 12 for the
//     dirty_count KV key, 8 for the covered KV key).
//
// -----------------------------------------------------------------------------
// STACK FRAME + REGISTER PLAN
// -----------------------------------------------------------------------------
//
// Frame layout (post push rbp; mov rbp, rsp; 5 callee-save pushes;
// sub rsp, 40):
//
//   [rbp+16]     (caller: no stack args -- 2 arg fn)
//   [rbp+8]      saved return addr (pushed by call)
//   [rbp+0]      saved caller-rbp
//   [rbp-8]      saved rbx
//   [rbp-16]     saved r12
//   [rbp-24]     saved r13
//   [rbp-32]     saved r14
//   [rbp-40]     saved r15
//   [rbp-48]     out_rects_ptr        (spill)
//   [rbp-56]     out_cap              (spill)
//   [rbp-64]     z_depth              (spill; loaded once at entry)
//   [rbp-72]     screen_w             (spill; loaded once at entry)
//   [rbp-80]     screen_h             (spill; loaded once at entry)
//
// Total = 80 bytes below rbp; entry rsp%16=8 -> post push rbp %16=0
// -> after 5 pushes %16=8+40 % 16 = 8, wait: pushes are 40 bytes so
// after the 5 pushes rsp is at rbp-40, which is 40 bytes below rbp.
// rbp is 16-aligned (since push rbp made rsp %16=0).  So rbp-40 is
// %16 = (0 - 40) mod 16 = -40 mod 16 = 8.  Then sub rsp, 40 lands
// rsp at rbp-80, %16 = (0 - 80) mod 16 = 0.  Aligned for every
// nested call without further padding.
//
// Live-across-call callee-save registers (SysV-preserved):
//
//   rbx  cur_slot (surface slot fetched from z_order_slot_at each iter)
//   r12  damage_count for cur_slot (fetched from damage_region_count)
//   r13  dirty_count (running output index; also return value)
//   r14  covered (running total of damage rects examined pre-clip)
//   r15  z-index (outer loop, decremented top-down)
//
// The inner-loop counter `j` lives in memory ([rbp-24] would collide
// with the saved r13; use a caller-save reg during the leaf sequence
// between calls) -- actually the walk is: fetch rect (call), clip
// (register-only), maybe write (register-only), advance j.  We can
// keep j in rcx across the call because damage_region_get is a pure
// leaf that preserves callee-saves, and rcx is not part of the
// callee-save set -- BUT damage_region_get takes rsi=j and doesn't
// clobber... wait, damage_region_get is invoked with rdi=slot,
// rsi=index; rcx is caller-save and is clobbered by the call.  Keep
// j in a spill slot.  Free spill: reuse [rbp-64] after z_depth is
// no longer needed... no, z_depth is read every outer iteration.
// Simpler: use a dedicated spill slot.  6-slot frame instead of 5:
// bump sub to 48 -> total 88, %16 = 8 -- misaligned.  Bump to 56:
// total 96, %16 = 0.  Actually the simpler fix is to keep j in a
// callee-save slot -- but all five are taken.  Use [rbp-56]? no,
// that's out_cap.
//
// Alternative: fetch damage_region_get via ONE call per iteration,
// then j++ in a scratch spilled to [rbp-72] AFTER screen_w read?
// No -- screen_w is used in the clip.  Cleanest: extend the frame
// to 56 bytes to add a j-spill slot, keeping alignment (5 pushes +
// 56 = 96 = 16*6).  New layout:
//
//   [rbp-48]  out_rects_ptr
//   [rbp-56]  out_cap
//   [rbp-64]  z_depth
//   [rbp-72]  screen_w
//   [rbp-80]  screen_h
//   [rbp-88]  j (inner index; spilled across damage_region_get)
//   [rbp-96]  pad (alignment)
//
// Total = 96 bytes below rbp, %16 = 0.  Aligned.

module CompositePlan = structure {

  // ==========================================================================
  // Failure taxonomy (0xFFFFE240..0xFFFFE24F).  See file header
  // §FAILURE TAXONOMY.
  // ==========================================================================

  pub let COMPOSITE_PLAN_OK       : u64 = 0
  pub let COMPOSITE_PLAN_BAD_ARG  : u64 = 0xFFFFE240

  // ==========================================================================
  // Fingerprint tag (46 bytes) + two KV keys (12 + 8 bytes).  Byte
  // counts hand-verified in the file header §FINGERPRINT.
  // ==========================================================================

  pub let composite_plan_ok_msg    : [u8; 46] = "composite plan ok [legacy: COMPOSITE PLAN OK]\0"
  pub let composite_plan_k_dirty   : [u8; 12] = "dirty_count\0"
  pub let composite_plan_k_covered : [u8; 8]  = "covered\0"

  // ==========================================================================
  // composite_plan(out_rects_ptr, out_cap) -> count
  //
  // Gate + walk order per file header §SCOPE.  Register plan +
  // stack frame per file header §STACK FRAME.  Labels prefixed cp_
  // (avoids the paideia-as reserved keyword set per
  // feedback_paideia_as_reserved_labels).
  // ==========================================================================

  pub let composite_plan : (u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (out_rects_ptr: u64) (out_cap: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R113.M4-020 (#2400): damage-driven per-frame composite planner.  Walks _z_stack top-down (index count-1 down to 0), enumerates per-surface damage rects via damage_region_count/damage_region_get, clips each rect to _gop_fb_width x _gop_fb_height (offscreen rects dropped; edge-straddling rects truncated), writes clipped packed u64 rects (doc §2 damage layout) into out_rects_ptr up to out_cap; drops overflow silently (caller escalates to whole-screen repaint on count==cap, per weston/wlroots convention).  Calls damage_region_clear per visited surface after enumeration (next-frame-empty contract).  Emits COMPOSITE PLAN OK dirty_count=<n_written> covered=<n_examined> via klog_s1_x2.  Enumerate-only mode: (out_rects_ptr==0, out_cap==0) walks + clears without writing, returns 0.  (out_rects_ptr==0, out_cap>0) is a caller bug -> COMPOSITE_PLAN_BAD_ARG.  Frame: 1 rbp + 5 callee-save pushes + sub rsp, 56 = 96 bytes below rbp = %16=0 alignment for every nested call (z_order_slot_at, damage_region_count, damage_region_get, damage_region_clear, klog_s1_x2) without further padding.  klog_s1_x2 v2 push idiom (sub 8; push r14; call; add 16) at rsp%16=0 lands v2 at [rsp+8] per klog_s1_x2 ABI (wrappers.pdx L72).  Sentinel handling: damage_region_count returns 0..8 legal or DMG_BAD_SLOT (0xFFFFE160) on out-of-range slot -- treat any return >8 as a stale z_stack entry and skip the surface (no imm32 sign-extension footgun; `cmp rax, 8; ja skip` uses imm8).  No test rN,rN; no 2-op imul; no `and reg, imm64`; no `cmp reg, [mem]` (every mem compare goes through a scratch load); register-scaled SIB `[reg + rN * 8]` with scale 8 in the legal set for the output store.  Labels prefixed cp_.",
      block: {
        push rbp;
        mov rbp, rsp;
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 56;

        // Spill args.
        mov [rbp - 48], rdi;                 // out_rects_ptr
        mov [rbp - 56], rsi;                 // out_cap

        // Gate: (out_rects_ptr == 0 && out_cap > 0) -> BAD_ARG.
        // (0, 0) is legal enumerate-only mode.
        cmp rdi, 0;
        jne cp_args_ok;
        cmp rsi, 0;
        je  cp_args_ok;
        mov rax, 0xFFFFE240;                 // COMPOSITE_PLAN_BAD_ARG
        jmp cp_out;

      cp_args_ok:
        // Load screen bounds (u64 each; zero pre-GOP-init is safe,
        // see file header §EXTERNAL SYMBOLS on zero-screen posture).
        mov rax, [rip + _gop_fb_width];
        mov [rbp - 72], rax;                 // screen_w
        mov rax, [rip + _gop_fb_height];
        mov [rbp - 80], rax;                 // screen_h

        // Load z-stack depth.
        lea r10, [rip + _z_stack_count];
        mov rax, [r10 + 0];
        mov [rbp - 64], rax;                 // z_depth

        // Init loop state.
        xor r13, r13;                        // dirty_count = 0
        xor r14, r14;                        // covered = 0

        // r15 = z_depth (pre-decrement pattern: top-down walk).
        mov r15, [rbp - 64];

      cp_outer:
        cmp r15, 0;
        je  cp_emit;
        sub r15, 1;                          // r15 = current z-index

        // rbx = z_order_slot_at(r15).  Out-of-range returns 0 which
        // is a valid slot; we're bounded by [rbp-64] so no OOB call
        // reaches z_order_slot_at from this loop.
        mov rdi, r15;
        call z_order_slot_at;
        mov rbx, rax;                        // rbx = cur_slot

        // r12 = damage_region_count(cur_slot).  Returns 0..8 legal
        // or DMG_BAD_SLOT (0xFFFFE160) on out-of-range slot.  Any
        // return > 8 is treated as a stale-entry sentinel; skip
        // this surface entirely (do NOT clear damage -- the slot is
        // not a legitimate surface and clearing it would be wrong).
        mov rdi, rbx;
        call damage_region_count;
        cmp rax, 8;
        ja  cp_outer;                        // sentinel: skip surface
        mov r12, rax;                        // r12 = damage_count

        // covered += damage_count.
        add r14, r12;

        // Inner loop: for j in 0..damage_count.
        xor rax, rax;
        mov [rbp - 88], rax;                 // j = 0

      cp_inner:
        mov rcx, [rbp - 88];                 // j
        cmp rcx, r12;
        jae cp_next_surface;

        // Fetch packed rect: damage_region_get(cur_slot, j).
        mov rdi, rbx;
        mov rsi, rcx;
        call damage_region_get;
        // rax = packed rect, or 0 on out-of-range (impossible: j <
        // count and cur_slot < SURFACE_ROW_MAX by construction).
        // Defensive: skip on 0.
        cmp rax, 0;
        je  cp_advance_j;

        // Unpack packed rect (doc §2 layout).
        //   x = rax & 0xFFFF
        //   y = (rax >> 16) & 0xFFFF
        //   w = (rax >> 32) & 0xFFFF
        //   h = (rax >> 48)              (shift alone masks)
        mov r8, rax;                         // r8 = packed (saved for h step)

        mov r9, rax;
        and r9, 0xFFFF;                      // r9 = x

        mov r10, rax;
        shr r10, 16;
        and r10, 0xFFFF;                     // r10 = y

        mov r11, rax;
        shr r11, 32;
        and r11, 0xFFFF;                     // r11 = w

        mov rax, r8;
        shr rax, 48;                         // rax = h

        // Clip: drop if fully offscreen.
        mov rcx, [rbp - 72];                 // screen_w
        cmp r9, rcx;
        jae cp_advance_j;                    // x >= screen_w -> drop

        mov rdx, [rbp - 80];                 // screen_h
        cmp r10, rdx;
        jae cp_advance_j;                    // y >= screen_h -> drop

        // Compute right = x + w; clip to screen_w.
        mov rdi, r9;
        add rdi, r11;                        // rdi = right
        cmp rdi, rcx;
        jbe cp_x_ok;
        mov rdi, rcx;                        // right = screen_w
      cp_x_ok:
        sub rdi, r9;                         // rdi = clipped w
        cmp rdi, 0;
        je  cp_advance_j;                    // zero area -> drop
        mov r11, rdi;                        // r11 = clipped w

        // Compute bottom = y + h; clip to screen_h.
        mov rdi, r10;
        add rdi, rax;                        // rdi = bottom
        cmp rdi, rdx;
        jbe cp_y_ok;
        mov rdi, rdx;                        // bottom = screen_h
      cp_y_ok:
        sub rdi, r10;                        // rdi = clipped h
        cmp rdi, 0;
        je  cp_advance_j;                    // zero area -> drop
        mov rax, rdi;                        // rax = clipped h

        // Repack clipped rect: (h<<48) | (w<<32) | (y<<16) | x.
        // Fields already <= 16 bits (source rect had 16-bit fields;
        // clipping only shrinks); mask defensively before shift.
        and r9,  0xFFFF;
        and r10, 0xFFFF;
        and r11, 0xFFFF;
        and rax, 0xFFFF;
        shl rax, 48;
        shl r11, 32;
        or  rax, r11;
        shl r10, 16;
        or  rax, r10;
        or  rax, r9;                         // rax = repacked (clipped)

        // Write to output if capacity remains.  No `cmp reg, [mem]`;
        // load out_cap into a scratch first.
        mov rdx, [rbp - 56];                 // out_cap
        cmp r13, rdx;
        jae cp_advance_j;                    // cap exhausted -> drop

        // out_rects_ptr is guaranteed non-zero here: cp_args_ok
        // rejected (rdi==0 && rsi>0) so if cap>0 then ptr>0; the
        // cmp above has proven cap > dirty_count >= 0 so cap > 0.
        mov rdx, [rbp - 48];                 // out_rects_ptr
        mov [rdx + r13 * 8], rax;
        add r13, 1;                          // dirty_count++

      cp_advance_j:
        mov rcx, [rbp - 88];
        add rcx, 1;
        mov [rbp - 88], rcx;
        jmp cp_inner;

      cp_next_surface:
        // Clear per-surface damage for cur_slot.  Return value is
        // DMG_OK or DMG_BAD_SLOT; we've already dispatched on the
        // slot via damage_region_count so a stale DMG_BAD_SLOT here
        // is impossible and the return is discarded.
        mov rdi, rbx;
        call damage_region_clear;
        jmp cp_outer;

      cp_emit:
        // Emit COMPOSITE PLAN OK dirty_count=<r13> covered=<r14>.
        // klog_s1_x2 v2 push idiom (sub 8; push v2; call; add 16)
        // at rsp%16=0 lands v2 at [rsp+8] per wrappers.pdx L72.
        // klog_s1_x2 preserves rbx/r12-r15/rbp per SysV; r13 (used
        // as return value below) survives across the call.
        mov rdi, 3;                          // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + composite_plan_ok_msg];
        lea rcx, [rip + composite_plan_k_dirty];
        mov r8, r13;                         // v1 = dirty_count
        lea r9, [rip + composite_plan_k_covered];
        sub rsp, 8;
        push r14;                            // v2 = covered
        call klog_s1_x2;
        add rsp, 16;

        // Return dirty_count.
        mov rax, r13;

      cp_out:
        add rsp, 56;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        pop rbp;
        ret
      }
    }
}
