// src/kernel/core/graphics/surface_present.pdx -- R113.M1-005 (paideia-os #2385)
//
// Present-fence: kernel signals surface when frame scanned out.  Design
// authority: design/graphics/r113-m1-substrate.md (FROZEN 2026-09-08).
//
// Sibling to R113.M1-001 (kind_surface.pdx substrate + row accessors +
// mint/destroy) and R113.M1-002 (surface_commit_ops.pdx commit-txn body).
// Consumes:
//   * surface_row_valid, surface_row_addr, surface_row_serial_get
//     (kind_surface.pdx §4) for slot liveness + last-committed serial.
//   * surface_present_ok_msg, surface_k_sid (kind_surface.pdx §8/§tags)
//     for the fingerprint emission.  Doc §8's five-tag mandate landed
//     the tag byte-array in M1-001; this landing wires the emitter.
//   * surface_k_serial (surface_commit_ops.pdx §160-165) as the second
//     KV key.  Reused verbatim (byte-array is at file-global scope);
//     re-declaring here would duplicate the symbol.
//
// -----------------------------------------------------------------------------
// SCOPE (per issue #2385 + design doc §9 M1-005 line)
// -----------------------------------------------------------------------------
//
// Wayland's wl_surface.frame equivalent: after surface_commit succeeds
// (kernel promotes pending -> current and bumps next_serial), the R36
// display-plane IRQ handler (or the compositor when it commits a
// composition to the display) invokes surface_present_notify(sid,
// serial) to publish the fact that a specific serial was scanned out.
// Any client waiting on that serial unblocks; a client polling the
// row's last-presented serial via surface_present_last() sees the new
// value.
//
// Three entry points:
//
//   * surface_present_notify(surface_slot, serial) -> u64
//     Called by the R36 display plane / compositor after scanout
//     completes.  Validates:
//       (1) slot live (surface_row_valid)             -> else BAD_SLOT
//       (2) serial != 0 && serial <= row_serial        -> else BAD_SERIAL
//     On success: read sid via surface_row_addr, emit
//     "SURFACE PRESENT OK sid=<n> serial=<n>" via klog_s1_x2, return
//     SURFACE_PRESENT_OK (0).  Does NOT bump _surface_stats -- doc §6
//     stats slots (MINTS / DESTROYS / REFUSED / COMMITS) do not include
//     PRESENTS; a per-present counter belongs to the display-plane
//     substrate, not the surface substrate, and lands with R36 wiring.
//
//   * surface_present_wait(surface_slot, timeout_ns) -> u64
//     Client-side wait for the last-presented serial.  STUB per issue
//     #2385: reads surface_row_serial_get and returns immediately
//     (timeout_ns argument accepted per ABI but not honored -- no
//     scheduler-integrated block-wait primitive exists at M1).  On slot
//     valid: returns row_serial (low 48 bits).  On slot invalid: remaps
//     the substrate's SURFACE_BAD_SLOT (0xFFFFE110) to the present-
//     fence-band SURFACE_PRESENT_BAD_SLOT (0xFFFFE150) so callers see
//     a single failure vocabulary.  The SURFACE_PRESENT_TIMEOUT code is
//     minted here but not yet returned by any code path -- the
//     real block-and-timeout body lands when M2 wires a wait-queue
//     against KIND_PRESENT_FEEDBACK.
//
//   * surface_present_last(surface_slot) -> u64
//     Non-blocking read of the row's last-presented serial.  Same shape
//     as surface_present_wait but no timeout argument.  Provided as a
//     separate entry point so a polling caller does not have to pass a
//     bogus timeout argument through a wait ABI that is only a stub
//     today.  Return-shape identical to surface_present_wait.
//
// -----------------------------------------------------------------------------
// FAILURE TAXONOMY -- 0xFFFFE150..0xFFFFE15F (fresh band, grep-verified free)
// -----------------------------------------------------------------------------
//
// The R113.M1-005 briefing named the band 0xFFFFE130..0xFFFFE13F.  That
// range is ALREADY CLAIMED by src/user/input_server/route_revoke.pdx
// (0xFFFFE130..0xFFFFE137 + tail 0xFFFFE13F, 9 codes in use); adopting
// the briefing verbatim would repeat exactly the Wave-12 M1-002
// failure-band collision that the freeze doc §5 was written to prevent
// (see doc §0 collision #3).  Per feedback-spec-vs-codebase-conflicts,
// the invariant wins: the briefing's proposed band is REJECTED and this
// landing takes 0xFFFFE150..0xFFFFE15F instead.
//
// Neighbouring bands (from src/user/input_server/seat_lock.pdx L257-261
// and a targeted repeat sweep):
//
//   0xFFFFE110..E11F  R113.M1-001 KIND_SURFACE substrate (kind_surface.pdx)
//   0xFFFFE120..E12F  R113.M1-004 kernel-side surface_format (surface_format.pdx)
//   0xFFFFE130..E13F  ROUTE_REVOKE   (src/user/input_server/route_revoke.pdx)
//   0xFFFFE140..E14F  SEAT_LOCK      (src/user/input_server/seat_lock.pdx)
//   0xFFFFE150..E15F  R113.M1-005 SURFACE PRESENT (THIS FILE)
//   0xFFFFE160..E1FF  entirely free (verified 2026-09-08 by targeted
//                     `grep -rho '0xFFFFE1[6-9A-Fa-f][0-9A-Fa-f]' src`
//                     -> empty)
//
// Freshness verification (2026-09-08 pre-landing):
//   $ grep -rn '0xFFFFE15' src -> only the seat_lock.pdx map comment
//     (line 260) naming this range as "entirely free (next fresh window
//     for future Wave-0 landings needing a fresh band)".  No live code
//     uses any code in 0xFFFFE150..0xFFFFE15F.
//
// Slot map:
//
//   0xFFFFE150  SURFACE_PRESENT_BAD_SLOT     band tail sentinel; slot invalid
//   0xFFFFE151  SURFACE_PRESENT_TIMEOUT      wait exceeded timeout_ns (stub
//                                            body does not yet return this;
//                                            reserved for the real block-and-
//                                            timeout landing in M2)
//   0xFFFFE152  SURFACE_PRESENT_BAD_SERIAL   serial == 0 OR serial > row_serial
//                                            (notify caller asserts a serial
//                                            the surface never committed)
//   0xFFFFE153..0xFFFFE15F                   reserved for M1-005 follow-on
//                                            (per-plane scanout ack, feedback
//                                            subscription taxonomy, etc.)
//
// -----------------------------------------------------------------------------
// RIGHTS GATING -- OWNED BY THE DISPATCHER (kind_surface.pdx §3.2 KGATE_*)
// -----------------------------------------------------------------------------
//
// These op bodies do NOT check rights.  surface_present_notify is
// kernel-internal only (called by the R36 display-plane IRQ handler or
// by the compositor's own kernel-side present-ack path); no cap_invoke
// arm dispatches to it.  surface_present_wait / surface_present_last
// are reached via cap_invoke through cap_handler_surface's KGATE_QUERY
// arm (R_SURFACE_READ | R_SURFACE_QUERY_GEOMETRY = 0x021) once the
// dispatcher OP catalog gains OP_SURFACE_PRESENT_WAIT / _LAST arms in a
// follow-on landing.  Same discipline as surface_commit_ops.pdx §RIGHTS
// GATING: layering the check twice would produce dead code and split
// the wire.
//
// -----------------------------------------------------------------------------
// FINGERPRINT ALLOWLIST
// -----------------------------------------------------------------------------
//
// The `surface present ok [legacy: SURFACE PRESENT OK]` allowlist entry
// in tools/verify-fingerprint-coverage.sh (added at R113.M1-001, #2381)
// said the emitter would land in M1-005.  This file IS that emitter;
// the allowlist entry's reason updates in-place (companion edit) to
// note that the emitter has now landed at surface_present_notify.
// Assertability still requires a boot witness invoking notify end-to-
// end (no such witness exists in the default matrix today); the
// allowlist entry remains valid.
//
// -----------------------------------------------------------------------------
// ENCODER PITFALLS (per feedback_pdx_encoder_pitfalls v0.36+)
// -----------------------------------------------------------------------------
//
//   * No `test rN, rN` -- every zero-check uses `cmp rN, 0` + `je/jne`.
//   * No 2-op `imul r, imm` -- row-index math is via the surface_row_*
//     accessors, not local *64.
//   * No `and reg, imm64` -- no 48/56-bit mask is used here; the
//     accessor callees already clip serials to 48 bits before returning.
//   * No `cmp reg, [mem]` -- every mem compare loads to scratch first
//     (the accessor callees encapsulate this).
//   * No literal-scaled `[reg + N*8]` -- displacement form only.
//   * klog_s1_x2 v2 push idiom follows bdev_write.pdx L809 /
//     surface_commit_ops.pdx L401-404 byte-for-byte: `sub rsp, 8;
//     push v2; call klog_s1_x2; add rsp, 16`.
//
// -----------------------------------------------------------------------------
// LABEL PREFIX
// -----------------------------------------------------------------------------
//
// `spn_` on surface_present_notify, `spw_` on surface_present_wait,
// `spl_` on surface_present_last.  All prefixes avoid the paideia-as
// reserved keyword set (feedback_paideia_as_reserved_labels).

module SurfacePresent = structure {

  // ==========================================================================
  // Failure taxonomy -- 0xFFFFE150..0xFFFFE15F.  See file header for the
  // freshness sweep and the rejection rationale for the briefing's
  // colliding 0xFFFFE130..E13F proposal.
  // ==========================================================================

  pub let SURFACE_PRESENT_OK          : u64 = 0
  pub let SURFACE_PRESENT_BAD_SLOT    : u64 = 0xFFFFE150
  pub let SURFACE_PRESENT_TIMEOUT     : u64 = 0xFFFFE151
  pub let SURFACE_PRESENT_BAD_SERIAL  : u64 = 0xFFFFE152

  // ==========================================================================
  // surface_present_notify(surface_slot, serial) -> u64
  //
  // Called by the R36 display-plane IRQ handler (or the compositor)
  // after scanout completes.  Emits the SURFACE PRESENT OK fingerprint
  // so the tag becomes reachable in the default matrix once a boot
  // witness wires end-to-end mint -> attach -> commit -> notify.
  //
  // Gate order:
  //   (1) surface_slot valid (surface_row_valid)          -> else BAD_SLOT
  //   (2) serial != 0                                      -> else BAD_SERIAL
  //   (3) serial <= row_serial (last committed)            -> else BAD_SERIAL
  //   (4) read sid from row+8 via surface_row_addr
  //   (5) klog_s1_x2 SURFACE PRESENT OK sid=<r13> serial=<r14>
  //   (6) return SURFACE_PRESENT_OK (0)
  //
  // The (2)+(3) split preserves a distinct error for the caller-mistake
  // path (a display plane asserting a serial the surface never
  // committed) versus the substrate-mistake path (slot went dead
  // mid-notify).  Both collapse to SURFACE_PRESENT_BAD_SERIAL because
  // there is no downstream consumer that would take a different action
  // on the two arms today; the shared code keeps the taxonomy compact.
  //
  // Register plan: r12=surface_slot, r13=sid, r14=serial.  Three
  // callee-save pushes (24 B) + `sub rsp, 16` = 40 B; entry rsp%16==8
  // -> (8+40) = 48, %16=0 -- aligned for every nested call without
  // further padding.  klog_s1_x2 preserves rbx/r12-r15/rbp per SysV so
  // r13/r14 survive across the emit.  klog_s1_x2 v2 push idiom (sub 8;
  // push v2; call; add 16) at body rsp%16=0: sub 8 -> %16=8; push
  // -> %16=0; call.
  //
  // klog_s1_x2 signature per klog/wrappers.pdx L72:
  //   (level, subsys, tag, k1, v1, k2) with v2 pushed as 7th arg on
  //   the caller stack.
  // ==========================================================================

  pub let surface_present_notify : (u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (surface_slot: u64) (serial: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R113.M1-005 (#2385): present-fence notify body. Gate order per file header: (1) surface_row_valid else SURFACE_PRESENT_BAD_SLOT; (2) serial != 0 else SURFACE_PRESENT_BAD_SERIAL; (3) serial <= row_serial (via surface_row_serial_get, low-48 clipped by that accessor) else SURFACE_PRESENT_BAD_SERIAL; (4) read sid from row+8 via surface_row_addr (pre-emit for the same ordering-independence discipline surface_commit uses at L376); (5) klog_s1_x2 SURFACE PRESENT OK sid=<r13> serial=<r14>; (6) return 0. Does NOT bump _surface_stats -- doc §6 stats slots do not include PRESENTS; a per-scanout counter belongs to the R36 display-plane substrate. Rights gating is the caller's problem (present-notify is kernel-internal; not reached via cap_invoke). Three callee-save pushes (r12=slot, r13=sid, r14=serial) + sub rsp,16 align rsp%16=0 (entry 8 + 24 + 16 = 48) for every nested call. klog_s1_x2 v2 push idiom mirrors surface_commit_ops.pdx L401-404 byte-for-byte: sub 8; push r14; call; add rsp, 16. klog_s1_x2 preserves rbx/r12-r15/rbp per SysV. Labels prefixed spn_.",
      block: {
        push r12;
        push r13;
        push r14;
        sub rsp, 16;

        mov r12, rdi;                        // surface_slot
        mov r14, rsi;                        // serial

        // (1) slot valid
        mov rdi, r12;
        call surface_row_valid;
        cmp rax, 0;
        je  spn_bad_slot;

        // (2) serial != 0
        cmp r14, 0;
        je  spn_bad_serial;

        // (3) serial <= row_serial (last committed, low-48 clipped by
        // surface_row_serial_get).  Returns SURFACE_BAD_SLOT
        // (0xFFFFE110) on invalid, which would compare above any legal
        // serial (48-bit domain) and cause the ja branch to fire; we
        // rewire that to BAD_SLOT for taxonomy hygiene by re-checking
        // against the sentinel first.
        mov rdi, r12;
        call surface_row_serial_get;
        mov r10, 0xFFFFE110;                 // SURFACE_BAD_SLOT sentinel
        cmp rax, r10;
        je  spn_bad_slot;                    // slot went dead mid-notify
        cmp r14, rax;
        ja  spn_bad_serial;                  // asserted serial from the future

        // (4) read sid from row+8.  surface_row_addr returns row_base
        // pointer post-liveness (0 if the row went un-live between the
        // (1) gate and here, which is impossible in single-threaded
        // kernel bringup but re-checked defensively).
        mov rdi, r12;
        call surface_row_addr;
        cmp rax, 0;
        je  spn_bad_slot;
        mov r13, [rax + 8];                  // r13 = surface_id

        // (5) emit fingerprint: SURFACE PRESENT OK sid=<r13> serial=<r14>.
        //   klog_s1_x2(LEVEL_INFO=3, SUBSYS_CAP_, surface_present_ok_msg,
        //              surface_k_sid, sid, surface_k_serial, serial)
        // v2 (serial) pushed as 7th arg per klog_s1_x2 ABI (wrappers.pdx
        // L72).  bdev_write.pdx L809 / surface_commit_ops.pdx L401-404
        // push idiom: sub 8; push v2; call; add 16.
        mov rdi, 3;                          // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + surface_present_ok_msg];
        lea rcx, [rip + surface_k_sid];
        mov r8, r13;                         // v1 = sid
        lea r9, [rip + surface_k_serial];
        sub rsp, 8;
        push r14;                            // v2 = serial
        call klog_s1_x2;
        add rsp, 16;

        // (6) return SURFACE_PRESENT_OK (0)
        xor rax, rax;
        jmp spn_out;

      spn_bad_slot:
        mov rax, 0xFFFFE150;                 // SURFACE_PRESENT_BAD_SLOT
        jmp spn_out;
      spn_bad_serial:
        mov rax, 0xFFFFE152;                 // SURFACE_PRESENT_BAD_SERIAL

      spn_out:
        add rsp, 16;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // surface_present_wait(surface_slot, timeout_ns) -> u64
  //
  // Client-side wait for the last-presented serial.  STUB per issue
  // #2385: reads surface_row_serial_get and returns immediately.  The
  // timeout_ns argument is accepted per the eventual block-and-timeout
  // ABI but not honored today (no scheduler-integrated wait-queue
  // primitive exists at M1; that lands with R113.M2 when
  // KIND_PRESENT_FEEDBACK gains a wait-queue).
  //
  // On slot valid: returns row_serial (low 48 bits, clipped by the
  // accessor).  On slot invalid: remaps the substrate's
  // SURFACE_BAD_SLOT (0xFFFFE110) to the present-fence-band
  // SURFACE_PRESENT_BAD_SLOT (0xFFFFE150) so callers see a single
  // failure vocabulary.
  //
  // Alignment: leaf calling one function.  Entry rsp%16==8; `sub rsp,
  // 8` -> %16=0 for the nested call.  timeout_ns (rsi) is discarded
  // per the stub semantic; the slot argument (rdi) passes straight
  // through to surface_row_serial_get.
  // ==========================================================================

  pub let surface_present_wait : (u64, u64) -> u64 !{mem} @{} =
    fn (surface_slot: u64) (timeout_ns: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M1-005 (#2385): present-fence wait STUB. Reads surface_row_serial_get and returns immediately; timeout_ns argument accepted per the eventual block-and-timeout ABI but not honored today (no scheduler-integrated wait-queue at M1; lands with R113.M2 KIND_PRESENT_FEEDBACK wire). Remaps the accessor's SURFACE_BAD_SLOT (0xFFFFE110) to SURFACE_PRESENT_BAD_SLOT (0xFFFFE150) so callers see one failure vocabulary. SURFACE_PRESENT_TIMEOUT (0xFFFFE151) is minted for the real body's future timeout arm; not returned here. Alignment: leaf calling one function; `sub rsp, 8` aligns rsp%16=0 for surface_row_serial_get, then `add rsp, 8` before ret. Labels prefixed spw_.",
      block: {
        sub rsp, 8;                          // align rsp%16=0 for the call

        // slot passes straight through in rdi; timeout_ns (rsi)
        // intentionally discarded per stub semantic.
        call surface_row_serial_get;

        // Remap SURFACE_BAD_SLOT (0xFFFFE110) -> SURFACE_PRESENT_BAD_SLOT
        // (0xFFFFE150) for taxonomy hygiene.
        mov r10, 0xFFFFE110;
        cmp rax, r10;
        jne spw_out;
        mov rax, 0xFFFFE150;

      spw_out:
        add rsp, 8;
        ret
      }
    }

  // ==========================================================================
  // surface_present_last(surface_slot) -> u64
  //
  // Non-blocking read of the row's last-presented serial.  Same shape
  // as surface_present_wait but no timeout argument -- a polling caller
  // does not need to pass a bogus timeout through a wait ABI that is
  // only a stub today.  Return: row_serial (low 48) on live slot,
  // SURFACE_PRESENT_BAD_SLOT (0xFFFFE150) on invalid slot.
  //
  // Alignment: identical to surface_present_wait.
  // ==========================================================================

  pub let surface_present_last : (u64) -> u64 !{mem} @{} =
    fn (surface_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M1-005 (#2385): present-fence non-blocking last-serial read. Passthrough to surface_row_serial_get with SURFACE_BAD_SLOT -> SURFACE_PRESENT_BAD_SLOT remap for taxonomy hygiene. Provided as a separate entry point so polling callers do not pass a bogus timeout through the wait ABI. Same alignment shape as surface_present_wait. Labels prefixed spl_.",
      block: {
        sub rsp, 8;                          // align rsp%16=0 for the call

        // slot passes straight through in rdi.
        call surface_row_serial_get;

        // Remap SURFACE_BAD_SLOT -> SURFACE_PRESENT_BAD_SLOT.
        mov r10, 0xFFFFE110;
        cmp rax, r10;
        jne spl_out;
        mov rax, 0xFFFFE150;

      spl_out:
        add rsp, 8;
        ret
      }
    }
}
