// src/kernel/core/graphics/screenshot.pdx -- R113.M7-034 (paideia-os #2414)
//
// On-demand full-frame capture.  A caller (screenshot key handler, a
// FrameCaptureView@0.1 semantic-pipe consumer, a boot witness that
// wants a "before" panel snapshot before pushing the compositor into a
// new mode, ...) invokes capture_screenshot(dst_bo_slot, format) and
// the kernel copies the current fully-composited framebuffer into the
// destination KIND_GPU_BO.
//
// The M7-034 landing is the SUBSTRATE + FINGERPRINT arm: validate the
// destination, validate the requested format, note the intent, emit
// SCREENSHOT OK with (bo=<slot>, w=<width>, h=<height>) KVs, return
// 0.  The physical pixel copy from _gop_fb_ptr (higher-half kernel VA
// of the LFB, gop_fb_console.pdx L124) into the destination BO's
// mapped byte range is DEFERRED to the R113.M7-034 wire landing that
// also lands the KIND_MEMORY-slot-to-VA resolver (per dma_buf.pdx §BO
// L60-63: "A real MMU-derived PA (page-table walk from memory_slot's
// base + offset) lands with R113.M5's user-space wl_drm-analog bridge,
// which is the first path that needs a real bus address").  Same
// posture as scanout_bind (R113.M4-018 / #2398), composite_gpu_blend
// (R113.M4-019 / #2399), and vblank_handler (R113.M4-021 / #2401):
// the substrate lands here, the physical wire is a single-call insert
// once the address-resolver arrives.
//
// -----------------------------------------------------------------------------
// SCOPE (per issue #2414)
// -----------------------------------------------------------------------------
//
// One entry point:
//
//   capture_screenshot(dst_bo_slot, format) -> 0 = OK | error
//
// Gate order (bail-first, cheapest gate first so a bad-BO call never
// touches the framebuffer geometry cells and a bad-format call never
// touches the BO row):
//
//   (1) kgb_tail_valid(dst_bo_slot)              -> else SCREENSHOT_BAD_BO
//   (2) format == SCREENSHOT_FOURCC_XRGB8888     -> else SCREENSHOT_BAD_FORMAT
//         M7-034 admissible set opens with XRGB8888 only -- the fourcc
//         the R113.M4 direct-scanout admissible subset also opens with
//         (scanout.pdx L354-361).  NV12 / YUYV / P010 land as follow-
//         on when a compositor witness proves a specific captor wants
//         a subsampled format; screenshot consumers today (screenshot
//         key handler, FrameCaptureView@0.1 semantic-pipe) all want
//         XRGB8888.
//   (3) _gop_fb_base_pa != 0                     -> else SCREENSHOT_NO_FB
//         GOP framebuffer not initialised (PVH boot, GOP-absent, LFB-
//         map-fail per gop_fb_console_init).  A capture request on a
//         panel-less boot rejects rather than emitting garbage.
//   (4) required_bytes = _gop_fb_width * _gop_fb_height * 4
//       kgb_row_size(dst_bo_slot) >= required_bytes
//                                                -> else SCREENSHOT_BO_TOO_SMALL
//         XRGB8888 pixel is 4 bytes; the width*height product on any
//         realistic panel (4096x2160 = 8.85M) fits in 24 bits, so the
//         *4 product never overflows the u64 size cell.  A caller that
//         mints a BO smaller than the panel gets an explicit error
//         rather than a silent short-copy that would produce a torn
//         partial-frame image.
//   (5) Wire-deferred physical copy: bump SCREENSHOT_ST_BLITS_PENDING
//         as a witness that the intent reached the substrate.  The
//         R113.M7-034 wire's memcpy(_gop_fb_ptr -> dst_bo_va,
//         required_bytes) drops in here; until then the stat counter
//         reports "captures asked for" and the pending counter reports
//         "captures not yet physically fulfilled".  Same wire-deferred
//         stat idiom composite_gpu_blend's ST_SUBMITS uses.
//   (6) Emit SCREENSHOT OK bo=<slot> w=<width> h=<height> via
//       klog_s1_x3.
//   (7) Bump SCREENSHOT_ST_CAPTURES.
//   (8) Return SCREENSHOT_OK (0).
//
// -----------------------------------------------------------------------------
// RATIONALE FOR THE FORMAT PARAMETER
// -----------------------------------------------------------------------------
//
// The framebuffer's native format is fixed at UEFI-GOP-init time (BGR_
// 8888 on T14 G4, RGB_8888 on the remaining EFI paths), so at first
// glance the caller's `format` parameter is redundant: the copy will
// always land the panel's native layout.  It is kept in the signature
// for three reasons:
//
//   (a) The screenshot key handler (M7-035) and the FrameCaptureView
//       consumer (M7-036) may want to REQUEST a format they can
//       decode (a PNG-encoding path knows XRGB8888 but not BGR_8888);
//       the parameter lets those consumers assert "I need XRGB8888"
//       and reject at the substrate rather than silently receiving a
//       byte-swapped image they cannot decode.
//   (b) When the follow-on wire lands a format converter (BGR_8888 ->
//       XRGB8888 via a shuffle-mask blit; NV12 -> XRGB8888 via a
//       de-planarizing shader), the parameter becomes load-bearing and
//       the substrate's format-gate widens without a signature churn.
//   (c) The `format` parameter mirrors scanout_bind's ordinal-check
//       posture, so screenshot consumers and direct-scanout consumers
//       share vocabulary.
//
// -----------------------------------------------------------------------------
// FAILURE TAXONOMY -- 0xFFFFE2C0..0xFFFFE2CF (fresh band, sweep-verified)
// -----------------------------------------------------------------------------
//
// Pre-landing sweep (2026-09-08):
//
//   $ grep -rn '0xFFFFE2[Cc]' src design tools tests   ->  empty
//
// so 0xFFFFE2C0..0xFFFFE2CF is fresh and uncontested.  Neighbouring
// bands in the 0xFFFFE2XX page:
//
//   0xFFFFE250..E25F  R113.M4-019 COMPOSITE GPU
//   0xFFFFE260..E26F  R113.M4-021 VBLANK (used band)
//   0xFFFFE270..E27F  R113.M5-022 KIND_SESSION substrate
//   0xFFFFE280..E28F  R113.M5-023 LOGIN SCREEN
//   0xFFFFE290..E2BF  free
//   0xFFFFE2C0..E2CF  R113.M7-034 SCREENSHOT  (THIS FILE)
//   0xFFFFE2D0..E2FF  free
//
// Slot map:
//
//   0xFFFFE2C0  SCREENSHOT_BAD_BO         dst_bo_slot not a live
//                                         KIND_GPU_BO row (kgb_tail_
//                                         valid returned 0).  The
//                                         most common caller error --
//                                         a caller passed a stale row
//                                         id after a revocation raced
//                                         the capture request.
//   0xFFFFE2C1  SCREENSHOT_BAD_FORMAT     format outside the admissible
//                                         set {XRGB8888} at M7-034.
//                                         Widens with the format
//                                         converter follow-on.
//   0xFFFFE2C2  SCREENSHOT_NO_FB          _gop_fb_base_pa == 0.  GOP
//                                         framebuffer not initialised
//                                         (PVH boot path, GOP-absent
//                                         firmware, or LFB map fail).
//                                         A capture on a panel-less
//                                         boot rejects rather than
//                                         emitting a garbage image.
//   0xFFFFE2C3  SCREENSHOT_BO_TOO_SMALL   destination BO's size
//                                         (kgb_row_size) is smaller
//                                         than width * height * 4.
//                                         Refuses the request rather
//                                         than issuing a short-copy
//                                         that would produce a torn
//                                         partial-frame image.
//   0xFFFFE2C4  SCREENSHOT_BLIT_FAIL      reserved: raised by the
//                                         follow-on physical-blit wire
//                                         when the memcpy path (or the
//                                         format-converter blit)
//                                         refuses (dst VA resolve
//                                         fail, dst-region write fault
//                                         under the follow-on MMU
//                                         landing).  This landing does
//                                         not raise it live.
//   0xFFFFE2C5..0xFFFFE2CF                reserved for M7 follow-on
//                                         (per-region capture, cursor-
//                                         overlay compositing, HDR
//                                         tone-map, ...).
//
// -----------------------------------------------------------------------------
// FINGERPRINT (per issue #2414)
// -----------------------------------------------------------------------------
//
// Wire form (post-klog_s1_x3 KV append):
//
//   screenshot ok [legacy: SCREENSHOT OK] bo=0x<hex> w=0x<hex> h=0x<hex>
//
// Byte count for the tag string, hand-verified:
//
//   "screenshot ok "                 = 14   (10 + 1 + 2 + 1)
//   "[legacy: "                      =  9
//   "SCREENSHOT OK"                  = 13   (10 + 1 + 2)
//   "]"                              =  1
//   NUL                              =  1
//   ---------------------------------------
//   total                            = 38 bytes
//
// KV keys:
//   * screenshot_k_bo ("bo\0", 3 bytes)      module-local, mirrors
//                                            dmabuf_k_bo ("bo\0", 3
//                                            bytes) at dma_buf.pdx
//                                            L310 -- same 3-byte key
//                                            for the same semantic
//                                            (buffer object slot).
//                                            Declared locally rather
//                                            than reusing the
//                                            dma_buf symbol because
//                                            (a) the screenshot
//                                            substrate is not a
//                                            dma_buf consumer (no
//                                            import step), and (b)
//                                            each module owning its
//                                            own KV vocabulary keeps
//                                            the cross-module string-
//                                            table graph simple.
//   * screenshot_k_w  ("w\0", 2 bytes)       width KV key.
//   * screenshot_k_h  ("h\0", 2 bytes)       height KV key.
//
// Emitter cadence: capture_screenshot is called once per screenshot-
// key press (M7-035 wire) or once per FrameCaptureView@0.1 tick
// (M7-036 wire).  Both are user-driven low-volume paths; klog volume
// is bounded.  Emit fires on EVERY successful capture (not just first-
// per-BO) because each capture is a distinct user-observable event
// that the fingerprint stream should record; the "first-per" idempotency
// scanout_try_direct uses defeats a per-frame emit smear, but per-
// capture is exactly what a screenshot audit trail wants.
//
// Emitter reachability: NO live caller in the M7-034 landing.  The
// screenshot key handler (M7-035) and the FrameCaptureView@0.1
// semantic-pipe (M7-036) are separate follow-on landings; the
// substrate is staged here so those landings are a single-call
// insert rather than a substrate-plus-consumer joint drop.  A
// tools/verify-fingerprint-coverage.sh allowlist entry mirrors the
// composite gpu ok / scanout direct ok / vblank tick siblings'
// "wire-deferred; assertable when a boot witness drives an end-to-
// end capture" posture.
//
// -----------------------------------------------------------------------------
// EXTERNAL SYMBOLS
// -----------------------------------------------------------------------------
//
// This module references (bare symbols, kernel .pdx single global
// namespace, same pattern as composite_gpu.pdx / scanout.pdx):
//
//   * kgb_tail_valid       (cap/kind_gpu_bo.pdx)         -- BO liveness
//   * kgb_row_size         (cap/kind_gpu_bo.pdx)         -- BO byte size
//   * _gop_fb_base_pa      (devices/display/gop_fb_console.pdx)  -- FB PA (0 = OFF)
//   * _gop_fb_width        (devices/display/gop_fb_console.pdx)  -- width (px)
//   * _gop_fb_height       (devices/display/gop_fb_console.pdx)  -- height (px)
//   * SUBSYS_CAP_          (klog/subsys.pdx)             -- klog subsys
//   * klog_s1_x3           (klog/wrappers.pdx)           -- 3-KV hex emit
//
// SUBSYS_CAP_ vs SUBSYS_GFX_: mirrors dma_buf.pdx §SUBSYSTEM CHOICE.
// Screenshot is a capability-space concern (destination is a KIND_GPU_
// BO cap; the "who's allowed to snapshot the panel" gate lands at the
// syscall boundary above this substrate), not a graphics-substrate
// concern (pixel layout, damage compression).  A future SUBSYS_GFX_
// bulk-move for the graphics-substrate messages is a natural follow-
// on but out of scope for M7-034.
//
// -----------------------------------------------------------------------------
// ENCODER PITFALLS (per feedback_pdx_encoder_pitfalls v0.36+)
// -----------------------------------------------------------------------------
//
//   * No `test rN, rN` -- every zero-check uses `cmp rN, 0` + `je/jne`.
//   * No 2-op `imul r, imm` -- required_bytes = width * height uses
//     the 2-op reg-reg form `imul rax, r14` (allowed; the reg-imm form
//     is the refused one).  The final *4 uses `shl rax, 2` (imm8 safe).
//     Same idiom shm_pool.pdx L890 uses (`imul rax, r13`).
//   * No `and reg, imm64` -- no 64-bit mask needed in this module;
//     the fourcc equality check compares a 32-bit fourcc pack (0x342_
//     5258 fits imm32).
//   * No `cmp reg, [mem]` -- every mem compare loads to a scratch
//     register first (`mov rax, [rip + _gop_fb_base_pa]; cmp rax, 0`).
//   * No literal-scaled `[reg + N*8]` -- direct RIP-relative access
//     for globals; no register-scaled SIB needed here (screenshot
//     touches no per-slot arrays).
//   * Failure sentinels 0xFFFFE2C[0-3] use `mov reg, imm64` (bit 31
//     set -> 10-byte movabs form per composite_gpu.pdx L682 idiom).
//   * `[rip + sym]` and `lea reg, [rip + sym]` for global data.
//   * Multiline `pub let ="..."` refused -- every string literal in
//     this file lives on one source line.
//   * Module name matches file basename: `Screenshot` for
//     `screenshot.pdx`.
//   * Fingerprint tag byte count asserted in the `[u8; N]` type
//     ascription (38 for screenshot_ok_msg, 3 for bo key, 2 for w/h
//     keys).
//
// -----------------------------------------------------------------------------
// STACK FRAME / REGISTER PLAN
// -----------------------------------------------------------------------------
//
// capture_screenshot:
//
//   5 callee-save pushes (rbx = dst_bo_slot, r12 = format,
//   r13 = width, r14 = height, r15 = required_bytes) = 40 B; entry
//   rsp%16 = 8 -> post-push rsp%16 = 0 for every nested call
//   (kgb_tail_valid, kgb_row_size, klog_s1_x3).  All nested callees
//   preserve rbx/r12-r15/rbp per SysV, so every loop invariant
//   survives across every call.
//
//   For the klog_s1_x3 stack-arg emit: `sub rsp, 32` at body rsp%16=0
//   preserves alignment (32 % 16 = 0) and reserves 24 bytes for the
//   three stack args (v2, k3, v3) plus 8 bytes of tail pad the
//   wrapper's frame layout consumes.  Store shape follows dma_buf.
//   pdx L545-549 byte-for-byte:
//     [rsp+0]  = v2 = width
//     [rsp+8]  = k3 = &screenshot_k_h
//     [rsp+16] = v3 = height
//   The wrapper reads [rbp+16] = v2, [rbp+24] = k3, [rbp+32] = v3
//   (post `push rbp; mov rbp, rsp`), which resolves to the caller's
//   [rsp+0], [rsp+8], [rsp+16] pre-CALL after the CALL's ret-addr
//   push (mapping [rsp_pre_CALL + N] -> [rsp_post_CALL + N + 8] ->
//   [rbp + N + 16]).
//
// -----------------------------------------------------------------------------
// LABEL PREFIXES
// -----------------------------------------------------------------------------
//
//   sh_    capture_screenshot
//
// All prefixes avoid the paideia-as reserved-keyword set
// (feedback_paideia_as_reserved_labels: loop, if, let, while, for,
// match, pub, mod, use, fn, struct, enum, impl, trait, type, where,
// move, mut, ref).

module Screenshot = structure {

  // ==========================================================================
  // Constants
  // ==========================================================================

  pub let SCREENSHOT_OK              : u64 = 0

  // Failure taxonomy -- 0xFFFFE2C0..0xFFFFE2CF (see file header
  // §FAILURE TAXONOMY).
  pub let SCREENSHOT_BAD_BO          : u64 = 0xFFFFE2C0
  pub let SCREENSHOT_BAD_FORMAT      : u64 = 0xFFFFE2C1
  pub let SCREENSHOT_NO_FB           : u64 = 0xFFFFE2C2
  pub let SCREENSHOT_BO_TOO_SMALL    : u64 = 0xFFFFE2C3
  pub let SCREENSHOT_BLIT_FAIL       : u64 = 0xFFFFE2C4

  // DRM_FOURCC admissible set (opens with XRGB8888 only at M7-034;
  // see file header §RATIONALE FOR THE FORMAT PARAMETER).  Duplicated
  // as a local constant rather than symbol-referenced from scanout.
  // pdx so capture_screenshot stays a self-contained substrate.
  pub let SCREENSHOT_FOURCC_XRGB8888 : u64 = 0x34325258

  // ==========================================================================
  // Stats counters.
  // ==========================================================================
  //
  //   SCREENSHOT_ST_CAPTURES        incremented on every successful capture
  //   SCREENSHOT_ST_BLITS_PENDING   incremented on every successful capture;
  //                                 decremented by the R113.M7-034 wire when
  //                                 the physical blit lands.  Delta reports
  //                                 "captures whose pixels are not yet in
  //                                 the destination BO".  Wire-deferred
  //                                 witness (see file header §SCOPE step 5).
  //   SCREENSHOT_ST_BAD_BO          incremented on the SCREENSHOT_BAD_BO
  //                                 refusal edge.
  //   SCREENSHOT_ST_BAD_FORMAT      incremented on the SCREENSHOT_BAD_FORMAT
  //                                 refusal edge.
  //   SCREENSHOT_ST_NO_FB           incremented on the SCREENSHOT_NO_FB
  //                                 refusal edge.
  //   SCREENSHOT_ST_BO_TOO_SMALL    incremented on the SCREENSHOT_BO_TOO_
  //                                 SMALL refusal edge.
  //
  // Refusal counters kept per-edge so a boot audit can distinguish
  // "captures asked for panel that never came up" (NO_FB dominates)
  // from "captures asked for BO smaller than panel" (BO_TOO_SMALL
  // dominates); the two failure modes have different remediation
  // paths.
  //
  // Six counters fits in a u64[8]; leaves two for a future M7 follow-
  // on (per-region captures, cursor overlay stats).
  // ==========================================================================

  pub let mut _screenshot_stats            : [u64; 8] = uninit @align(64)

  pub let SCREENSHOT_ST_CAPTURES     : u64 = 0
  pub let SCREENSHOT_ST_BLITS_PENDING: u64 = 1
  pub let SCREENSHOT_ST_BAD_BO       : u64 = 2
  pub let SCREENSHOT_ST_BAD_FORMAT   : u64 = 3
  pub let SCREENSHOT_ST_NO_FB        : u64 = 4
  pub let SCREENSHOT_ST_BO_TOO_SMALL : u64 = 5

  // ==========================================================================
  // Fingerprint tag (38 bytes) + three KV keys (3 + 2 + 2 bytes).
  // Byte counts hand-verified in the file header §FINGERPRINT.
  // ==========================================================================

  pub let screenshot_ok_msg : [u8; 38] = "screenshot ok [legacy: SCREENSHOT OK]\0"
  pub let screenshot_k_bo   : [u8; 3]  = "bo\0"
  pub let screenshot_k_w    : [u8; 2]  = "w\0"
  pub let screenshot_k_h    : [u8; 2]  = "h\0"

  // ==========================================================================
  // screenshot_init() -> ()
  //
  // Zero the stats block at boot.  Called from the graphics-substrate
  // init phase alongside dma_buf_init / scanout_init.  Wiring to
  // kernel_main is a companion landing (this file only lands the
  // substrate; the boot wire is picked up when the R113.M7 rendering-
  // path wave lands or when a boot witness needs the pre-init state
  // for a chaos-restart re-scrub).  Straight-line loop, no nested
  // calls; touches only rax, rcx, r10.
  // ==========================================================================

  pub let screenshot_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M7-034 (#2414): zero _screenshot_stats[8] (64 B) at boot.  Defensive re-scrub mirroring dma_buf_init / scanout_init discipline (chaos-restart witness re-scrub point).  Straight-line loop using [reg + rcx * 8] register-scaled SIB (scale 8 in the legal {1,2,4,8} set); zero staged via xor rax,rax.  Zero-arg leaf; entry rsp%16=8 unchanged on return.  Labels prefixed sh_i_.",
      block: {
        lea r10, [rip + _screenshot_stats];
        xor rax, rax;
        xor rcx, rcx;
      sh_i_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  sh_i_stats;
        ret
      }
    }

  // ==========================================================================
  // capture_screenshot(dst_bo_slot, format) -> u64
  //
  // Validate the destination + format, verify the framebuffer is
  // alive, verify the destination is large enough, note the wire-
  // deferred blit intent, emit SCREENSHOT OK bo=<slot> w=<width>
  // h=<height>, return SCREENSHOT_OK.  See file header §SCOPE for
  // the eight-step gate order and §STACK FRAME for the register
  // plan.  Labels prefixed sh_.
  // ==========================================================================

  pub let capture_screenshot : (u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (dst_bo_slot: u64) (format: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R113.M7-034 (#2414): on-demand full-frame capture substrate.  Gate order per file header §SCOPE: (1) kgb_tail_valid(dst_bo_slot) else SCREENSHOT_BAD_BO; (2) format == SCREENSHOT_FOURCC_XRGB8888 else SCREENSHOT_BAD_FORMAT; (3) _gop_fb_base_pa != 0 else SCREENSHOT_NO_FB; (4) required = width * height * 4; kgb_row_size(dst_bo_slot) >= required else SCREENSHOT_BO_TOO_SMALL; (5) bump SCREENSHOT_ST_BLITS_PENDING as wire-deferred physical-copy witness (memcpy(_gop_fb_ptr -> dst_bo_va, required_bytes) lands with the R113.M7-034 wire that also lands the KIND_MEMORY-slot-to-VA resolver per dma_buf.pdx §BO L60-63); (6) emit SCREENSHOT OK bo=<slot> w=<width> h=<height> via klog_s1_x3; (7) bump SCREENSHOT_ST_CAPTURES; (8) return SCREENSHOT_OK.  required_bytes = width * height * 4: width * height uses `imul rax, r14` (2-op reg-reg form, allowed per feedback_pdx_encoder_pitfalls; the refused form is 2-op reg-imm) and *4 uses `shl rax, 2` (imm8 safe); at any realistic panel (<= 4096x2160) the product fits comfortably in u64.  Failure sentinels loaded via `mov reg, imm64` (bit-31-set 0xFFFFE2C[0-3] hits the 10-byte movabs form per composite_gpu.pdx L682 idiom).  Refusal edges bump their per-edge stats counter before returning so a boot audit can distinguish the four failure modes; success bumps both CAPTURES and BLITS_PENDING.  Five callee-save pushes (rbx=dst_bo_slot, r12=format, r13=width, r14=height, r15=required_bytes) = 40 B; entry rsp%16=8 -> post-push rsp%16=0 for every nested call (kgb_tail_valid, kgb_row_size, klog_s1_x3 all preserve rbx/r12-r15/rbp per SysV).  klog_s1_x3 stack-arg emit follows dma_buf.pdx L545-549 byte-for-byte: sub rsp, 32 at rsp%16=0 preserves alignment while reserving 24 B for (v2=width at [rsp+0], k3=&screenshot_k_h at [rsp+8], v3=height at [rsp+16]) plus 8 B tail pad; wrapper reads [rbp+16]/[rbp+24]/[rbp+32] after its `push rbp` (mapping caller's pre-CALL [rsp+0/8/16] through the CALL's ret-addr push).  No test rN,rN; no 2-op `imul r, imm`; no `and reg, imm64`; no `cmp reg, [mem]` (every mem compare loads to a scratch first).  Labels prefixed sh_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                        // rbx = dst_bo_slot
        mov r12, rsi;                        // r12 = format

        // Gate 1: destination BO is a live KIND_GPU_BO row.
        mov rdi, rbx;
        call kgb_tail_valid;
        cmp rax, 0;
        je  sh_bad_bo;

        // Gate 2: format admissible.  M7-034 accepts XRGB8888 only.
        mov r10, 0x34325258;                 // SCREENSHOT_FOURCC_XRGB8888
        cmp r12, r10;
        jne sh_bad_format;

        // Gate 3: framebuffer alive.  _gop_fb_base_pa == 0 means the
        // GOP init OFF-arm ran (PVH boot / GOP-absent / LFB map fail).
        mov rax, [rip + _gop_fb_base_pa];
        cmp rax, 0;
        je  sh_no_fb;

        // Load width + height from the GOP substrate.  Both cells are
        // u64 pixel counts latched by gop_fb_console_init on the OK
        // arm; safe to read here because Gate 3 above confirmed the
        // OK arm ran (any OFF-arm cell holds 0 and would have joined
        // sh_no_fb already; the width/height latches lag base_pa by
        // no other synchronization but boot init is single-threaded).
        mov r13, [rip + _gop_fb_width];
        mov r14, [rip + _gop_fb_height];

        // required_bytes = width * height * 4.  XRGB8888 pixel is 4
        // bytes; on any realistic panel (4096x2160 = 8.85M) the product
        // fits comfortably in u64.  2-op reg-reg imul is the allowed
        // form (the refused pitfall is 2-op reg-imm); shl 2 for the *4
        // is imm8 safe.
        mov rax, r13;                        // rax = width
        imul rax, r14;                       // rax = width * height
        shl rax, 2;                          // rax = width * height * 4
        mov r15, rax;                        // r15 = required_bytes

        // Gate 4: destination BO large enough.
        mov rdi, rbx;
        call kgb_row_size;
        cmp rax, r15;
        jb  sh_too_small;

        // Gate 5: wire-deferred physical-copy witness.  Bump the
        // pending counter so a boot audit can see the capture request
        // reached the substrate before the R113.M7-034 wire's memcpy
        // path is live.  The wire drops the memcpy(_gop_fb_ptr ->
        // dst_bo_va, required_bytes) here and decrements this counter
        // in the same landing.
        lea r10, [rip + _screenshot_stats];
        mov rax, [r10 + 8];                  // ST_BLITS_PENDING = 1
        add rax, 1;
        mov [r10 + 8], rax;

        // Gate 6: emit SCREENSHOT OK bo=<rbx> w=<r13> h=<r14> via
        // klog_s1_x3.  Stack-arg store shape mirrors dma_buf.pdx
        // L545-549 byte-for-byte.
        mov rdi, 3;                          // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + screenshot_ok_msg];
        lea rcx, [rip + screenshot_k_bo];
        mov r8,  rbx;                        // v1 = bo slot
        lea r9,  [rip + screenshot_k_w];     // k2

        sub rsp, 32;                         // 24 args + 8 pad, preserves %16=0
        mov [rsp + 0], r13;                  // v2 = width
        lea r10, [rip + screenshot_k_h];
        mov [rsp + 8], r10;                  // k3 = &screenshot_k_h
        mov [rsp + 16], r14;                 // v3 = height
        call klog_s1_x3;
        add rsp, 32;

        // Gate 7: bump SCREENSHOT_ST_CAPTURES.
        lea r10, [rip + _screenshot_stats];
        mov rax, [r10 + 0];                  // ST_CAPTURES = 0
        add rax, 1;
        mov [r10 + 0], rax;

        // Gate 8: return SCREENSHOT_OK.
        xor rax, rax;
        jmp sh_out;

      sh_bad_bo:
        lea r10, [rip + _screenshot_stats];
        mov rax, [r10 + 16];                 // ST_BAD_BO = 2
        add rax, 1;
        mov [r10 + 16], rax;
        mov rax, 0xFFFFE2C0;                 // SCREENSHOT_BAD_BO
        jmp sh_out;

      sh_bad_format:
        lea r10, [rip + _screenshot_stats];
        mov rax, [r10 + 24];                 // ST_BAD_FORMAT = 3
        add rax, 1;
        mov [r10 + 24], rax;
        mov rax, 0xFFFFE2C1;                 // SCREENSHOT_BAD_FORMAT
        jmp sh_out;

      sh_no_fb:
        lea r10, [rip + _screenshot_stats];
        mov rax, [r10 + 32];                 // ST_NO_FB = 4
        add rax, 1;
        mov [r10 + 32], rax;
        mov rax, 0xFFFFE2C2;                 // SCREENSHOT_NO_FB
        jmp sh_out;

      sh_too_small:
        lea r10, [rip + _screenshot_stats];
        mov rax, [r10 + 40];                 // ST_BO_TOO_SMALL = 5
        add rax, 1;
        mov [r10 + 40], rax;
        mov rax, 0xFFFFE2C3;                 // SCREENSHOT_BO_TOO_SMALL

      sh_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
