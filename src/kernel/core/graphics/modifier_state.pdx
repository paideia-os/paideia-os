// src/kernel/core/graphics/modifier_state.pdx -- R113.M3-015 (paideia-os #2395)
//
// Modifier-state tracker: shift / ctrl / alt / meta (left+right pairs)
// plus caps / num / scroll locks, single-seat cell for now.
//
// Landing sits atop the R113.M2 window-manager batch (focus.pdx +
// z_order.pdx) and predates the input-dispatcher wire-up.  Consumers
// live in three places, none currently reachable in the default
// 14-mode QEMU matrix because all three are gated on xHCI MSI-X
// routing being live (drivers/xhci/hid_kbd_attach.pdx §IRQ path):
//
//   * hid_kbd_attach Transfer Event handler       -- calls modifier_set
//     on every key-down / key-up edge for the eight non-lock bits.
//   * hid_kbd_lock_toggle worker                  -- calls
//     modifier_toggle_lock on caps/num/scroll press edges (release
//     edges are ignored per USB HID spec §10.1.1: lock LEDs are
//     driven by state, not by press count).
//   * input-dispatcher key-to-slot router        -- calls modifier_get
//     when composing an input event before forwarding to the
//     keyboard-focused surface (focus.pdx _kbd_focus_slot).
//
// -----------------------------------------------------------------------------
// SCOPE (per issue #2395)
// -----------------------------------------------------------------------------
//
// One global cell (`_modifier_state`, u64) holding the OR of every
// currently-asserted modifier bit.  Four entry points:
//
//   * modifier_state_init()             -- boot-time init; latches
//                                          _modifier_state to 0.
//                                          Called from kernel_main.pdx
//                                          after focus_init.  Not
//                                          strictly defensive against
//                                          .bss zero-init (zero IS the
//                                          semantic identity here --
//                                          "no modifier held, no lock
//                                          engaged"), but sequences at
//                                          the same boot slot as the
//                                          sibling focus_init /
//                                          z_order_init so a chaos-
//                                          restart witness re-scrub
//                                          hits every input-state
//                                          module in one pass.
//
//   * modifier_set(bit, is_press) -> u64
//                                       -- flip a non-lock bit.
//                                          is_press == 0 clears; != 0
//                                          sets.  Emits fingerprint
//                                          MODIFIER STATE OK mask=<hex>
//                                          only on transition (a
//                                          repeat set of an already-
//                                          held bit, or a release of
//                                          an already-cleared bit, is
//                                          a silent no-op success --
//                                          mirrors focus_set_keyboard
//                                          idempotency).  Rejects
//                                          unknown bit or multi-bit
//                                          arg with MOD_BAD_BIT.
//
//   * modifier_get() -> u64             -- non-blocking read of
//                                          _modifier_state.  Returns
//                                          the raw mask.  Pure leaf.
//
//   * modifier_toggle_lock(bit) -> u64  -- XOR a lock bit (caps / num
//                                          / scroll only).  Rejects
//                                          non-lock bits with
//                                          MOD_BAD_LOCK_BIT.  Always
//                                          transitions (XOR flips), so
//                                          always emits.
//
// -----------------------------------------------------------------------------
// BIT LAYOUT -- POSITIONAL, LOW BITS FIRST (per issue #2395)
// -----------------------------------------------------------------------------
//
//   bit 0 (0x001)  MOD_SHIFT_LEFT
//   bit 1 (0x002)  MOD_SHIFT_RIGHT
//   bit 2 (0x004)  MOD_CTRL_LEFT
//   bit 3 (0x008)  MOD_CTRL_RIGHT
//   bit 4 (0x010)  MOD_ALT_LEFT
//   bit 5 (0x020)  MOD_ALT_RIGHT
//   bit 6 (0x040)  MOD_META_LEFT
//   bit 7 (0x080)  MOD_META_RIGHT
//   bit 8 (0x100)  MOD_CAPS_LOCK
//   bit 9 (0x200)  MOD_NUM_LOCK
//   bit 10 (0x400) MOD_SCROLL_LOCK
//
//   MOD_ALL_BITS   = 0x7FF (11 bits, entire known set)
//   MOD_LOCK_BITS  = 0x700 (caps | num | scroll)
//
// Positional-bit layout (rather than USB HID's report-modifier byte
// packing) is chosen for O(1) OR/AND/XOR arithmetic in the fast path;
// hid_kbd_attach maps USB HID modifier bits to these positions in its
// Transfer Event handler.  Left/right pair discrimination is preserved
// (not folded into a single SHIFT / CTRL / ALT / META bit) so per-key
// remapping (Alt-Gr, Right-Meta as compose key, etc.) can gate on the
// specific side without a re-decode.
//
// -----------------------------------------------------------------------------
// SINGLE SEAT FOR NOW (per issue #2395)
// -----------------------------------------------------------------------------
//
// The issue title reads "tracked per seat" but its body §requirement
// (1) explicitly scopes "single seat for now".  Multi-seat expansion
// (per src/user/input_server/seat_kind.pdx §SEAT_MAX = 8) lands as a
// follow-on R113.M3-016+ when the seat_kind vocabulary is wired into
// the kernel-side substrate; today's single global cell matches the
// substrate depth of every sibling in the input-server plane
// (_kbd_focus_slot, _ptr_focus_slot, _implicit_grab_slot from
// focus.pdx are all seat-agnostic).  When multi-seat lands, this cell
// becomes _modifier_state_per_seat[SEAT_MAX] and every entry point
// gains a `seat_id` first argument -- consumer-code churn is confined
// to the three call sites named above.
//
// -----------------------------------------------------------------------------
// FINGERPRINT ON TRANSITION (not on every set)
// -----------------------------------------------------------------------------
//
// modifier_set emits only when the new mask differs from the current
// cell.  A key-repeat set (bit already asserted, is_press != 0) or a
// spurious release (bit already cleared, is_press == 0) is a silent
// no-op success (rax = MOD_OK).  This mirrors focus_set_keyboard's
// idempotency (focus.pdx §"FINGERPRINT ON TRANSITION") and keeps the
// wire volume proportional to actual state changes, not to key-repeat
// autofire (which at 32 Hz would flood the klog otherwise).
//
// modifier_toggle_lock always transitions (XOR is guaranteed to flip
// the bit), so no idempotency guard -- every call emits.
//
// -----------------------------------------------------------------------------
// FAILURE TAXONOMY -- 0xFFFFE1E0..0xFFFFE1EF (fresh band, grep-verified)
// -----------------------------------------------------------------------------
//
// Sweep 2026-09-08:
//
//   $ grep -rho '0xFFFFE1[0-9A-Fa-f]\{2\}' src | sort -u
//
// Yields 0xFFFFE100..0xFFFFE1BF as occupied (in scattered bands owned
// by SURFACE / SURFACE_FORMAT / ROUTE_REVOKE / SEAT_LOCK / SURFACE_
// PRESENT / FOCUS / Z_ORDER / TOPLEVEL / POPUP / LAYER_SHELL), and
// 0xFFFFE1C0..0xFFFFE1FF entirely free.  0xFFFFE1E0..0xFFFFE1EF is a
// fresh, uncontested band.  Neighbouring occupancy (all landed R113.M2
// or earlier):
//
//   0xFFFFE180..E18F  R113.M2-011 FOCUS       (focus.pdx)
//   0xFFFFE190..E19F  R113.M2-010 Z_ORDER     (z_order.pdx)
//   0xFFFFE1A0..E1AF  R113.M2-001 TOPLEVEL    (surface_toplevel.pdx)
//   0xFFFFE1B0..E1BF  R113.M2-002 POPUP       (surface_popup.pdx)
//   0xFFFFE1C0..E1CF  entirely free
//   0xFFFFE1D0..E1DF  entirely free
//   0xFFFFE1E0..E1EF  R113.M3-015 MODIFIER_STATE (THIS FILE)
//
// Slot map:
//
//   0xFFFFE1E0  MOD_BAD_BIT           bit passed to modifier_set is
//                                     zero, has bits outside MOD_ALL_
//                                     BITS, or has more than one bit
//                                     set (multi-modifier atomic sets
//                                     are not supported -- the caller
//                                     must loop).
//   0xFFFFE1E1  MOD_BAD_LOCK_BIT      bit passed to modifier_toggle_
//                                     lock is not one of MOD_CAPS_
//                                     LOCK / MOD_NUM_LOCK / MOD_
//                                     SCROLL_LOCK.
//   0xFFFFE1E2..0xFFFFE1EF            reserved for M3 follow-on
//                                     (per-seat gate mismatch, key
//                                     compose partial commit, etc.).
//
// -----------------------------------------------------------------------------
// FINGERPRINT ALLOWLIST
// -----------------------------------------------------------------------------
//
// The tag "modifier state ok [legacy: MODIFIER STATE OK]" is the
// transition emitter.  Unreachable in the default 14-mode QEMU matrix
// today (no boot witness calls modifier_set / modifier_toggle_lock;
// first live callers are the HID kbd handlers blocked on xHCI MSI-X
// routing -- see file header §CONSUMERS).  One entry in
// tools/verify-fingerprint-coverage.sh points at this file with the
// "input-server wire deferred" posture the FOCUS KBD / FOCUS PTR
// siblings use.
//
// KV key reused: k_mask ("mask\0", 5 bytes) from
// src/kernel/core/klog/keys.pdx §k_mask (already declared, no new key
// needed).  Wire form (post-klog_s1_x1 KV append):
//
//   modifier state ok [legacy: MODIFIER STATE OK] mask=0x<hex>
//
// -----------------------------------------------------------------------------
// RIGHTS GATING -- OWNED BY THE INPUT DISPATCHER, NOT HERE
// -----------------------------------------------------------------------------
//
// modifier_set / modifier_get / modifier_toggle_lock are kernel-
// internal only; no cap_invoke arm dispatches to them.  The input
// dispatcher landing will gate on R_INPUT_ROUTE (a future right on
// KIND_INPUT_ROUTE, src/user/input_server/route_kind.pdx) or on the
// per-device attach right before calling in.  Same discipline as
// focus_set_keyboard (focus.pdx §RIGHTS GATING).
//
// -----------------------------------------------------------------------------
// ENCODER PITFALLS (per feedback_pdx_encoder_pitfalls v0.36+)
// -----------------------------------------------------------------------------
//
//   * No `test rN, rN` -- every zero-check uses `cmp rN, 0` + `je/jne`.
//   * No 2-op `imul r, imm` -- no arithmetic on bit indices in this file.
//   * No `and reg, imm64` -- MOD_ALL_BITS (0x7FF) and MOD_LOCK_BITS
//     (0x700) both fit in imm32; used only as `and reg, imm32` which
//     the encoder accepts.  No 64-bit constant is ever AND'd with a
//     register.
//   * No `cmp reg, [mem]` -- every mem compare loads to a scratch
//     register first (focus.pdx pattern).
//   * No literal-scaled `[reg + N*8]` -- only displacement form
//     `[reg + 0]` used for the single cell.
//   * No `mov qword [mem], imm64` -- the cell is written by loading
//     into rax first then storing.
//
// -----------------------------------------------------------------------------
// LABEL PREFIX
// -----------------------------------------------------------------------------
//
// `msi_` = modifier_state_init (no labels needed), `ms_` = modifier_set,
// `mg_` = modifier_get (no labels needed), `mtl_` = modifier_toggle_
// lock.  All prefixes avoid the paideia-as reserved keyword set
// (feedback_paideia_as_reserved_labels): `ms` is not a keyword; `mtl`
// is not a keyword; `mg` is not a keyword.

module ModifierState = structure {

  // ==========================================================================
  // Bit constants -- positional layout (see file header §BIT LAYOUT)
  // ==========================================================================

  pub let MOD_SHIFT_LEFT   : u64 = 1
  pub let MOD_SHIFT_RIGHT  : u64 = 2
  pub let MOD_CTRL_LEFT    : u64 = 4
  pub let MOD_CTRL_RIGHT   : u64 = 8
  pub let MOD_ALT_LEFT     : u64 = 16
  pub let MOD_ALT_RIGHT    : u64 = 32
  pub let MOD_META_LEFT    : u64 = 64
  pub let MOD_META_RIGHT   : u64 = 128
  pub let MOD_CAPS_LOCK    : u64 = 256
  pub let MOD_NUM_LOCK     : u64 = 512
  pub let MOD_SCROLL_LOCK  : u64 = 1024

  // Aggregate masks used by the validators in modifier_set and
  // modifier_toggle_lock.  Both fit in imm32, satisfying the "no
  // `and reg, imm64`" encoder pitfall.
  pub let MOD_ALL_BITS     : u64 = 0x7FF   // all 11 known bits
  pub let MOD_LOCK_BITS    : u64 = 0x700   // caps | num | scroll

  // ==========================================================================
  // Result codes -- 0xFFFFE1E0..0xFFFFE1EF (see file header §FAILURE TAXONOMY)
  // ==========================================================================

  pub let MOD_OK               : u64 = 0
  pub let MOD_BAD_BIT          : u64 = 0xFFFFE1E0
  pub let MOD_BAD_LOCK_BIT     : u64 = 0xFFFFE1E1

  // ==========================================================================
  // Global modifier-state cell (.bss, @align(8))
  //
  // Zero-init at .bss IS the semantic identity here ("no modifier
  // held, no lock engaged"), unlike focus.pdx where zero-init would
  // alias slot 0.  modifier_state_init runs at boot anyway to keep
  // the chaos-restart witness re-scrub point uniform across
  // focus_init / z_order_init / modifier_state_init.
  // ==========================================================================

  pub let mut _modifier_state : u64 = uninit @align(8)

  // ==========================================================================
  // Fingerprint tag (transition emitter)
  //
  // Wire form: modifier state ok [legacy: MODIFIER STATE OK] mask=0x<hex>
  //
  // Byte count verified by hand:
  //   "modifier state ok [legacy: MODIFIER STATE OK]\0" = 46 bytes
  // ==========================================================================

  pub let modifier_state_msg : [u8; 46] = "modifier state ok [legacy: MODIFIER STATE OK]\0"

  // ==========================================================================
  // modifier_state_init() -> ()
  //
  // Latch _modifier_state to 0.  Called from kernel_main.pdx after
  // focus_init.  Zero-arg leaf; no callee-save clobber; only touches
  // rax + r10.  See file header §"single seat for now" for the
  // rationale on why zero IS the identity (unlike focus.pdx's
  // FOCUS_NONE sentinel).
  // ==========================================================================

  pub let modifier_state_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M3-015 (#2395): latch _modifier_state to 0.  Called from kernel_main.pdx after focus_init as part of the chaos-restart witness re-scrub cluster (kind_surface_init / damage_region_init / toplevel_init / z_order_init / focus_init / modifier_state_init).  Zero is the semantic identity here (no modifier held) so this leaf is not strictly defensive against .bss zero-init, but sequencing it at the same boot slot keeps the re-scrub uniform.  Straight-line, no branches, no nested calls; entry rsp%16==8 unchanged on ret.",
      block: {
        xor rax, rax;
        lea r10, [rip + _modifier_state];
        mov [r10 + 0], rax;
        ret
      }
    }

  // ==========================================================================
  // modifier_set(bit, is_press) -> u64
  //
  // Gate order:
  //   (1) validate bit -- non-zero, subset of MOD_ALL_BITS, single-bit.
  //       Reject with MOD_BAD_BIT on failure.
  //   (2) load current _modifier_state.
  //   (3) compute new state:
  //         is_press != 0  ->  new = current | bit
  //         is_press == 0  ->  new = current & ~bit
  //   (4) if new == current -> silent no-op success (return MOD_OK,
  //       no emit).  Matches key-repeat / spurious-release semantics.
  //   (5) store new into _modifier_state.
  //   (6) emit fingerprint MODIFIER STATE OK mask=<new>.
  //   (7) return MOD_OK.
  //
  // Register plan: one callee-save push (r12 = new_state) sits at
  // rsp%16==0 in the body (entry 8 + 8 = 16, %16=0), aligned for
  // klog_s1_x1 without further padding.  klog_s1_x1 preserves r12 per
  // SysV, so the new-state value survives to the emit even though we
  // could equivalently pass it directly (r12 is the safer form -- a
  // future re-order that inserts a nested call between the store and
  // the emit would otherwise silently corrupt the mask arg).  Labels
  // prefixed ms_.
  // ==========================================================================

  pub let modifier_set : (u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (bit: u64, is_press: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R113.M3-015 (#2395): set/clear a non-lock modifier bit.  Gate order per file header: (1) validate bit is non-zero, subset of MOD_ALL_BITS (0x7FF), and single-bit via (bit & (bit-1)) == 0; reject with MOD_BAD_BIT (0xFFFFE1E0); (2) load current cell; (3) compute new = current OR bit (press) or current AND NOT bit (release); (4) if new == current, silent no-op success (mirrors focus_set_keyboard idempotency); (5) store; (6) klog_s1_x1 MODIFIER STATE OK mask=<new> via k_mask key (already declared in src/kernel/core/klog/keys.pdx §k_mask, no new key needed); (7) return MOD_OK.  No `and reg, imm64` (0x7FF fits imm32).  One callee-save push (r12 = new_state) aligns rsp%16=0 (entry 8 + 8 = 16) for klog_s1_x1.  Labels prefixed ms_.",
      block: {
        push r12;

        // (1a) bit != 0
        cmp rdi, 0;
        je  ms_bad_bit;

        // (1b) bit subset of MOD_ALL_BITS (0x7FF fits imm32)
        mov rax, rdi;
        and rax, 0x7FF;
        cmp rax, rdi;
        jne ms_bad_bit;

        // (1c) single-bit: (bit & (bit - 1)) == 0
        mov rax, rdi;
        sub rax, 1;
        and rax, rdi;
        cmp rax, 0;
        jne ms_bad_bit;

        // (2) load current
        lea r10, [rip + _modifier_state];
        mov r11, [r10 + 0];               // r11 = current (kept for compare)

        // (3) compute new state -> rax
        cmp rsi, 0;
        je  ms_release;

        // press: new = current | bit
        mov rax, r11;
        or  rax, rdi;
        jmp ms_check;

      ms_release:
        // release: new = current & ~bit -- stage ~bit in rcx (scratch)
        mov rcx, rdi;
        not rcx;
        mov rax, r11;
        and rax, rcx;

      ms_check:
        // (4) no-op if unchanged (silent success, no emit)
        cmp rax, r11;
        je  ms_no_change;

        // (5) store new
        mov [r10 + 0], rax;

        // (6) emit fingerprint MODIFIER STATE OK mask=<new>
        mov r12, rax;                      // preserve across klog call
        mov rdi, 3;                        // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + modifier_state_msg];
        lea rcx, [rip + k_mask];
        mov r8, r12;                       // mask = new state
        call klog_s1_x1;

      ms_no_change:
        // (7) return MOD_OK
        xor rax, rax;
        jmp ms_out;

      ms_bad_bit:
        mov rax, 0xFFFFE1E0;               // MOD_BAD_BIT

      ms_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // modifier_get() -> u64
  //
  // Non-blocking read of _modifier_state.  Returns the raw mask.
  // Pure leaf; no push, no nested call.
  // ==========================================================================

  pub let modifier_get : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M3-015 (#2395): rip-relative load of _modifier_state.  Pure leaf; no callee-save; entry rsp%16=8 unchanged on ret.  Labels prefixed mg_ (none needed).",
      block: {
        lea r10, [rip + _modifier_state];
        mov rax, [r10 + 0];
        ret
      }
    }

  // ==========================================================================
  // modifier_toggle_lock(bit) -> u64
  //
  // Gate order:
  //   (1) validate bit is one of MOD_CAPS_LOCK / MOD_NUM_LOCK /
  //       MOD_SCROLL_LOCK: non-zero, subset of MOD_LOCK_BITS (0x700),
  //       single-bit.  Reject with MOD_BAD_LOCK_BIT.
  //   (2) XOR bit into _modifier_state (always transitions).
  //   (3) emit fingerprint MODIFIER STATE OK mask=<new>.
  //   (4) return MOD_OK.
  //
  // No idempotency guard needed -- XOR is guaranteed to flip the bit,
  // so every call transitions.  Consumers on the USB HID key-down
  // edge for caps/num/scroll rely on this: the LED-drive worker
  // reads modifier_get after every toggle and reprograms the
  // keyboard's lock LEDs to match.
  //
  // Register plan: identical to modifier_set (one callee-save push
  // for r12 = new_state).  Labels prefixed mtl_.
  // ==========================================================================

  pub let modifier_toggle_lock : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (bit: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R113.M3-015 (#2395): XOR a lock bit into _modifier_state.  Gate order per file header: (1) validate bit is non-zero, subset of MOD_LOCK_BITS (0x700), single-bit via (bit & (bit-1)) == 0; reject with MOD_BAD_LOCK_BIT (0xFFFFE1E1); (2) XOR bit into cell (always transitions); (3) klog_s1_x1 MODIFIER STATE OK mask=<new>; (4) return MOD_OK.  No `and reg, imm64` (0x700 fits imm32).  One callee-save push (r12 = new_state) aligns rsp%16=0 for klog_s1_x1.  Labels prefixed mtl_.",
      block: {
        push r12;

        // (1a) bit != 0
        cmp rdi, 0;
        je  mtl_bad_bit;

        // (1b) bit subset of MOD_LOCK_BITS (0x700 fits imm32)
        mov rax, rdi;
        and rax, 0x700;
        cmp rax, rdi;
        jne mtl_bad_bit;

        // (1c) single-bit: (bit & (bit - 1)) == 0
        mov rax, rdi;
        sub rax, 1;
        and rax, rdi;
        cmp rax, 0;
        jne mtl_bad_bit;

        // (2) XOR bit into cell
        lea r10, [rip + _modifier_state];
        mov rax, [r10 + 0];
        xor rax, rdi;
        mov [r10 + 0], rax;

        // (3) emit fingerprint MODIFIER STATE OK mask=<new>
        mov r12, rax;                      // preserve across klog call
        mov rdi, 3;                        // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + modifier_state_msg];
        lea rcx, [rip + k_mask];
        mov r8, r12;                       // mask = new state
        call klog_s1_x1;

        // (4) return MOD_OK
        xor rax, rax;
        jmp mtl_out;

      mtl_bad_bit:
        mov rax, 0xFFFFE1E1;               // MOD_BAD_LOCK_BIT

      mtl_out:
        pop r12;
        ret
      }
    }

}
