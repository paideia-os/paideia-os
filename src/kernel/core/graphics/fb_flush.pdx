// src/kernel/core/graphics/fb_flush.pdx -- R101.M3-002
//
// fb_flush_via_backend(fb_slot, src_va) -> bytes_copied
//
// Reads the fb row's geometry (width, height, stride, lfb_va) and
// dispatches to backend_flush(src_va, lfb_va, width, height, stride).
// The caller supplies the source pixel buffer VA (typically the
// address of a KIND_MEMORY-backed range they own); this function
// owns knowing the destination + geometry.
//
// Bumps _fb_stats[FB_ST_FLUSHES] on success.
//
// -----------------------------------------------------------------------------
// Contract with the caller
// -----------------------------------------------------------------------------
//
//   fb_slot -- row_id into _fb_table (the value kind_framebuffer_mint_
//              simple returned). Must be < FB_MAX (bounds-checked here).
//   src_va  -- kernel VA of the source buffer. Caller ensures at least
//              (width * 4 * height) bytes are readable at src_va.
//
// Returns bytes_copied (= width * 4 * height) on success, or 0 on any
// error (bad slot, backend dispatch returned 0).

module FbFlush = structure {

  // ==========================================================================
  // fb_flush_via_backend(fb_slot, src_va) -> u64
  //
  // Register plan: r12 = fb_slot, r13 = src_va, r14 = width, r15 =
  // height, rbx = stride, rbp = lfb_va. Six callee-save pushes + sub
  // rsp,8 for alignment (entry rsp%16==8, +48+8=56, %16==0). Six
  // nested calls, all preserving callee-save per SysV.
  // ==========================================================================
  pub let fb_flush_via_backend : (u64, u64) -> u64 !{mem, sysreg} @{boot, cap} =
    fn (fb_slot: u64) (src_va: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {boot, cap},
      justification: "R101.M3-002: read fb row geometry (width, height, stride, lfb_va) via fb_row_* accessors and dispatch backend_flush(src, lfb_va, width, height, stride). Bounds-checks fb_slot < FB_MAX(4) via fb_row_valid (returns 0 sentinel on invalid). Bumps FB_ST_FLUSHES on success. Register plan: r12=fb_slot, r13=src_va, r14=width, r15=height, rbx=stride, rbp=lfb_va. Six callee-save pushes + rsp,8 pad. Labels prefixed fbfl_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;

        mov r12, rdi;                            // fb_slot
        mov r13, rsi;                            // src_va

        // Bounds + in_use check.
        mov rdi, r12;
        call fb_row_valid;
        cmp rax, 0;
        je  fbfl_bad;

        // Read width.
        mov rdi, r12;
        call fb_row_width;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  fbfl_bad;
        mov r14, rax;

        // Read height.
        mov rdi, r12;
        call fb_row_height;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  fbfl_bad;
        mov r15, rax;

        // Read stride.
        mov rdi, r12;
        call fb_row_stride;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  fbfl_bad;
        mov rbx, rax;

        // Read lfb_va.
        mov rdi, r12;
        call fb_row_lfb_va;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  fbfl_bad;
        mov rbp, rax;
        cmp rbp, 0;
        je  fbfl_bad;

        // backend_flush(src_va, lfb_va, width, height, stride)
        mov rdi, r13;                            // src_va
        mov rsi, rbp;                            // lfb_va (dst)
        mov rdx, r14;                            // width
        mov rcx, r15;                            // height
        mov r8,  rbx;                            // stride
        call backend_flush;
        cmp rax, 0;
        je  fbfl_bad;

        // Bump FB_ST_FLUSHES + return bytes.
        push rax;                                // preserve bytes across fb_note
        mov rdi, 1;                              // FB_ST_FLUSHES
        call fb_note;
        pop rax;
        jmp fbfl_out;

      fbfl_bad:
        xor rax, rax;

      fbfl_out:
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }
}
