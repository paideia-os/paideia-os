// src/kernel/core/graphics/surface_toplevel.pdx -- R113.M2-006 (paideia-os #2386)
//
// KIND_SURFACE role: TOPLEVEL -- an xdg-toplevel-equivalent authority
// (title + resize-hints + close_pending flag) layered over a live
// KIND_SURFACE row.  Umbrella: R113 GPU-native compositor (#2380).
//
// Design authority: design/graphics/r113-m1-substrate.md (FROZEN
// 2026-09-08, commit 1988e50) governs the KIND_SURFACE substrate this
// role sits on top of.  M2 role-freeze doc for the toplevel/popup/
// subsurface role catalogue is not yet landed; this file is the first
// concrete role instance of the M2 wave and its shape becomes the
// precedent the sibling role landings mirror.
//
// -----------------------------------------------------------------------------
// SCOPE (per issue #2386)
// -----------------------------------------------------------------------------
//
// A "surface role" in the R113 vocabulary is a compositor-side authority
// that binds extra semantics on top of a bare KIND_SURFACE row.  The
// TOPLEVEL role is Wayland's xdg_toplevel + xdg_surface pair in one
// authority: a window with a title, a min/max resize band, and a
// close_pending flag toggled by the compositor and cleared by the
// client on frame acknowledgement.
//
// This landing lands the side-table + four op bodies:
//
//   * toplevel_create(surface_slot, title_ptr, title_len) -> toplevel_id
//     Binds a fresh TOPLEVEL row to an already-minted KIND_SURFACE
//     row.  Copies title_ptr[0..title_len) into the row's inline
//     title[128] buffer, zero-padding the tail.  Assigns a fresh
//     monotonic toplevel_id (first id = 1; zero reserved as the
//     "unset" sentinel).  Emits SURFACE TOPLEVEL CREATE OK fingerprint
//     with sid=<surface_id from KIND_SURFACE row+8> and tid=<toplevel_id>.
//     Returns the toplevel_id on success or one of the
//     0xFFFFE17F..0xFFFFE178 refusal codes.
//
//   * toplevel_set_title(toplevel_id, title_ptr, title_len) -> 0 | err
//     Overwrites the inline title.  Validates length and pointer per
//     the same gates as create; refuses TOPLEVEL_BAD_ID on
//     toplevel_id==0 and TOPLEVEL_NOT_FOUND on a stale id.
//
//   * toplevel_request_close(toplevel_id) -> 0 | err
//     Compositor-facing: sets close_pending=1 in the row.  Idempotent
//     to the extent that a second request while pending returns
//     TOPLEVEL_ALREADY_CLOSING rather than silently succeeding, so a
//     confused caller sees an explicit refusal instead of a lost
//     signal.
//
//   * toplevel_ack_close(toplevel_id) -> 0 | err
//     Client-facing: clears close_pending after the client has drained
//     its state.  Refuses TOPLEVEL_NOT_PENDING if no request is
//     outstanding (protects against the client acking a request the
//     compositor never made -- classic Wayland "phantom ack" bug).
//
// The dispatcher wire-up for these ops through cap_invoke against a
// KIND_SURFACE cap belongs to a follow-on landing (a role-multiplexed
// OP_SURFACE_ROLE_* arm on cap_handler_surface); this file is the
// authority-body substrate a boot witness and that dispatcher will
// both call.
//
// -----------------------------------------------------------------------------
// ROW LAYOUT -- 256 BYTES (32 u64 WORDS), CACHE-FRIENDLY POWER-OF-2
// -----------------------------------------------------------------------------
//
//   +  0  hdr           in_use[63:56] | generation[55:0]
//                       (56-bit LAM ABA counter, matches kind_surface
//                        row+0 discipline)
//   +  8  toplevel_id   u64 (monotonic; first id = 1; 0 reserved)
//   + 16  refs          surface_slot[31:0] | close_pending[63:32]
//                       (close_pending is 0 or 1 -- one full u32 slot
//                        reserved so a future ack-serial can widen
//                        into the same word without a layout revision)
//   + 24  resize_min    min_w[63:32] | min_h[31:0]     (u32 | u32)
//   + 32  resize_max    max_w[63:32] | max_h[31:0]     (u32 | u32)
//   + 40  title_len     u64 (0..TOPLEVEL_TITLE_MAX inclusive)
//   + 48..+175  title   inline UTF-8 byte buffer, 128 bytes,
//                       zero-padded past title_len
//   +176..+255  reserved for future role extensions (state fsm,
//                       app_id, workspace binding etc.)
//
// Row size 256 chosen so slot->offset is a single `shl 8` (encoder
// pitfall v0.36+: no 2-op `imul r,imm`); pool of 16 rows = 4 KiB = one
// page, `@align(64)` on the storage puts each row on a fresh cache
// line.  Reserved tail is deliberate padding for the M2 role-freeze
// doc's follow-on fields (activated/maximized/fullscreen fsm, per-role
// z_order slot, workspace_kind_id, a11y_tree_kind_id bridge to
// user-side window_kind).
//
// resize_min/resize_max are stamped to zero at create; a future
// toplevel_set_resize_hints landing wires the actual writer.  Reading
// zero means "unconstrained" per the xdg_toplevel semantic (min_w==0
// AND min_h==0 == no minimum; same for max).
//
// -----------------------------------------------------------------------------
// SIDE-TABLE POSTURE (dedicated pool, NOT indexed by surface_slot)
// -----------------------------------------------------------------------------
//
// The issue text offered two alternatives: "_toplevels[16] side-table
// indexed by surface_slot (or dedicated pool)".  This landing takes
// the dedicated-pool option:
//
//   * Indexed-by-surface_slot would tie the TOPLEVEL row-count to
//     SURFACE_ROW_MAX(16) forever, forcing a lockstep bump whenever
//     the substrate scales.  A dedicated pool decouples the two.
//
//   * A single KIND_SURFACE row can legally be re-bound to a fresh
//     TOPLEVEL after destroy+recreate; an indexed-by-slot table would
//     reuse the same row and leak the previous LAM generation (an ABA
//     hazard the substrate's own header word exists to catch).
//
//   * Sibling role landings (POPUP, SUBSURFACE) will each want their
//     own row pool with their own byte count; a dedicated-pool
//     posture makes them all one-for-one with this file rather than
//     forcing each into the surface_slot index space.
//
// Consequently: the toplevel_id (the u64 in +8) is the ONLY caller-
// visible handle.  Callers pass toplevel_id to set_title / request_
// close / ack_close; internally we scan the pool for the matching id
// (toplevel_find_by_id).  A future landing may add an id->slot hash
// side-table if the linear scan proves hot, but at ROW_MAX=16 the
// scan is one cache line's worth of loads and a hash would be
// premature.
//
// -----------------------------------------------------------------------------
// FAILURE TAXONOMY -- 0xFFFFE170..0xFFFFE17F (FRESH BAND)
// -----------------------------------------------------------------------------
//
// Grep-verified free at landing time against src/ and design/ (no
// hit for `0xFFFFE17[0-9A-F]`).  Neighbours:
//
//   0xFFFFE110..E11F   kind_surface.pdx        (substrate refusal band)
//   0xFFFFE150..E15F   surface_present.pdx     (present-fence refusal band)
//   0xFFFFE160..E16F   damage_region.pdx       (damage-region refusal band)
//   0xFFFFE170..E17F   THIS FILE
//
// Codes:
//
//   0xFFFFE17F  TOPLEVEL_TAIL_ENOSPC      row pool full
//   0xFFFFE17E  TOPLEVEL_BAD_SURFACE      surface_slot invalid / dead
//   0xFFFFE17D  TOPLEVEL_BAD_TITLE_LEN    title_len > 128
//   0xFFFFE17C  TOPLEVEL_BAD_TITLE_PTR    title_len > 0 but ptr == 0
//   0xFFFFE17B  TOPLEVEL_NOT_FOUND        no live row matches toplevel_id
//   0xFFFFE17A  TOPLEVEL_BAD_ID           toplevel_id == 0 (sentinel)
//   0xFFFFE179  TOPLEVEL_ALREADY_CLOSING  request_close while pending
//   0xFFFFE178  TOPLEVEL_NOT_PENDING      ack_close while not pending
//   0xFFFFE170..77 RESERVED for M2 role-catalogue expansion
//
// -----------------------------------------------------------------------------
// FINGERPRINT (issue mandate + M1-doc §8 lesson)
// -----------------------------------------------------------------------------
//
// SURFACE TOPLEVEL CREATE OK sid=<n> tid=<n>
//
// Emitted via klog_s1_x2 from toplevel_create's success tail.  The
// two-KV shape (sid + tid) is the standard for a role-binds-to-
// substrate event: sid names the KIND_SURFACE row (surface_id, from
// row+8), tid names this file's own row (toplevel_id).  Tag byte
// count (56) verified by hand: "surface toplevel create ok " (27) +
// "[legacy: TOPLEVEL CREATE OK]" (28) + "\0" (1).
//
// A tools/verify-fingerprint-coverage.sh allowlist entry accompanies
// this landing so the tag is not a coverage-gate silent hole (M1 doc
// §8 mandate: every "... OK" tag either asserts in the test matrix
// or names an allowlist reason).  set_title / request_close / ack_close
// do NOT emit fingerprints -- these are compositor-internal state
// transitions with no boot-time reachability today; the create-time
// fingerprint is the substrate-live witness the R113 wave asserts.
//
// -----------------------------------------------------------------------------
// EXTERNAL SYMBOLS
// -----------------------------------------------------------------------------
//
// This module references (bare symbols, kernel .pdx single global namespace):
//   * surface_row_valid   (kind_surface.pdx)         -- gate (1) in create
//   * surface_row_addr    (kind_surface.pdx)         -- sid read for klog
//   * SUBSYS_CAP_         (klog subsystem ordinal)
//   * klog_s1_x2          (klog/wrappers.pdx)        -- 2-KV emit
//
// No import declaration needed -- paideia-as's kernel .pdx link path
// is one global namespace (same pattern surface_commit_ops.pdx and
// damage_region.pdx already use).
//
// -----------------------------------------------------------------------------
// ENCODER PITFALLS (per feedback_pdx_encoder_pitfalls v0.36+)
// -----------------------------------------------------------------------------
//
//   * No `test rN, rN` -- every zero-check uses `cmp rN, 0` + `je/jne`.
//   * No 2-op `imul r, imm` -- slot->offset math is `shl r, 8`
//     (slot * 256).
//   * No `and reg, imm64` -- the 56-bit LAM mask loads via
//     `mov r64, imm64` before the two-register and.  The 32-bit mask
//     `0xFFFFFFFF` is safe as `and reg, 0xFFFFFFFF` per the
//     kind_surface / tui_canvas / kind_gpu_bo precedent (encodes as
//     an unsigned imm32 that does NOT sign-extend for that value).
//   * No `cmp reg, [mem]` -- every mem-compare loads to a scratch first.
//   * No literal-scaled `[reg + N*8]` -- displacement form
//     `[reg + 8N]` used for fixed offsets; register-scaled
//     `[reg + rcx * 8]` (scale in {1,2,4,8}) used for u64 table walks;
//     `[reg + rcx * 1]` used for byte-index title copies (mirrors
//     vfs_open.pdx L`mov_b rax, [rbx + r8*1]` precedent).
//   * Multiline `pub let ="..."` refused by the encoder -- every
//     string literal in this file lives on one source line.
//   * Module name matches file basename: `SurfaceToplevel` for
//     `surface_toplevel.pdx`.
//   * Fingerprint tag byte count computed by hand and asserted in the
//     `[u8; N]` type ascription (56 for the create-ok tag, 4 for the
//     tid key).
//
// -----------------------------------------------------------------------------
// LABEL PREFIXES
// -----------------------------------------------------------------------------
//
//   ti_    toplevel_init
//   tsb_   toplevel_stats_bump_*    (four leaves, one per stat slot)
//   trv_   toplevel_row_valid
//   tra_   toplevel_row_addr
//   tfb_   toplevel_find_by_id
//   tc_    toplevel_create
//   tst_   toplevel_set_title
//   trc_   toplevel_request_close
//   tac_   toplevel_ack_close
//
// All prefixes avoid the paideia-as reserved-keyword set
// (feedback_paideia_as_reserved_labels: loop, if, let, while, for,
// match, pub, mod, use, fn, struct, enum, impl, trait, type, where,
// move, mut, ref).

module SurfaceToplevel = structure {

  // ==========================================================================
  // Row shape + pool constants.
  // ==========================================================================

  pub let TOPLEVEL_ROW_MAX     : u64 = 16
  pub let TOPLEVEL_ROW_BYTES   : u64 = 256
  pub let TOPLEVEL_ROW_WORDS   : u64 = 32
  pub let TOPLEVEL_TITLE_MAX   : u64 = 128

  // Row offsets.
  pub let TL_OFF_HDR           : u64 = 0
  pub let TL_OFF_TOPLEVEL_ID   : u64 = 8
  pub let TL_OFF_REFS          : u64 = 16
  pub let TL_OFF_RESIZE_MIN    : u64 = 24
  pub let TL_OFF_RESIZE_MAX    : u64 = 32
  pub let TL_OFF_TITLE_LEN     : u64 = 40
  pub let TL_OFF_TITLE         : u64 = 48

  // ==========================================================================
  // Failure taxonomy (0xFFFFE170..0xFFFFE17F, fresh band).
  // ==========================================================================

  pub let TOPLEVEL_OK               : u64 = 0
  pub let TOPLEVEL_TAIL_ENOSPC      : u64 = 0xFFFFE17F
  pub let TOPLEVEL_BAD_SURFACE      : u64 = 0xFFFFE17E
  pub let TOPLEVEL_BAD_TITLE_LEN    : u64 = 0xFFFFE17D
  pub let TOPLEVEL_BAD_TITLE_PTR    : u64 = 0xFFFFE17C
  pub let TOPLEVEL_NOT_FOUND        : u64 = 0xFFFFE17B
  pub let TOPLEVEL_BAD_ID           : u64 = 0xFFFFE17A
  pub let TOPLEVEL_ALREADY_CLOSING  : u64 = 0xFFFFE179
  pub let TOPLEVEL_NOT_PENDING      : u64 = 0xFFFFE178

  // ==========================================================================
  // Pool storage.  16 rows * 256 bytes = 4 KiB, one page-aligned
  // allocation.  Zero-initialised .bss; toplevel_init defensively
  // re-scrubs at boot to match the kind_surface_init / damage_region_
  // init discipline (chaos-restart witness re-scrub point).
  // ==========================================================================

  pub let mut _toplevels        : [u64; 512] = uninit @align(64)
  pub let mut _toplevel_stats   : [u64; 4]   = uninit @align(64)
  pub let mut _toplevel_next_id : u64        = uninit @align(8)

  pub let TL_ST_CREATES      : u64 = 0
  pub let TL_ST_SET_TITLE    : u64 = 1
  pub let TL_ST_CLOSE_REQ    : u64 = 2
  pub let TL_ST_CLOSE_ACK    : u64 = 3
  pub let TL_ST_MAX          : u64 = 4

  // ==========================================================================
  // Fingerprint tag (56 bytes) + KV key (4 bytes).  surface_k_sid
  // ("sid\0") is already declared in kind_surface.pdx and is referenced
  // by bare-symbol lookup (single global namespace, same as
  // surface_commit_ops.pdx's use of surface_k_sid at L417).
  // ==========================================================================

  pub let surface_toplevel_create_ok_msg : [u8; 56] = "surface toplevel create ok [legacy: TOPLEVEL CREATE OK]\0"
  pub let toplevel_k_tid : [u8; 4] = "tid\0"

  // ==========================================================================
  // Stats bumpers.  Load-inc-store leaves (no `add reg, [mem]`), one
  // per counter slot -- mirrors surface_stats_bump_* discipline in
  // kind_surface.pdx L211-260.
  // ==========================================================================

  pub let toplevel_stats_bump_creates : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M2-006 (#2386): bump _toplevel_stats[TL_ST_CREATES=0]. Load-inc-store, no `add reg, [mem]`. Called from toplevel_create success tail only. Labels prefixed tsb_c_.",
      block: {
        lea r10, [rip + _toplevel_stats];
        mov rax, [r10 + 0];
        add rax, 1;
        mov [r10 + 0], rax;
        ret
      }
    }

  pub let toplevel_stats_bump_set_title : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M2-006 (#2386): bump _toplevel_stats[TL_ST_SET_TITLE=1]. Labels prefixed tsb_st_.",
      block: {
        lea r10, [rip + _toplevel_stats];
        mov rax, [r10 + 8];
        add rax, 1;
        mov [r10 + 8], rax;
        ret
      }
    }

  pub let toplevel_stats_bump_close_req : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M2-006 (#2386): bump _toplevel_stats[TL_ST_CLOSE_REQ=2]. Labels prefixed tsb_cr_.",
      block: {
        lea r10, [rip + _toplevel_stats];
        mov rax, [r10 + 16];
        add rax, 1;
        mov [r10 + 16], rax;
        ret
      }
    }

  pub let toplevel_stats_bump_close_ack : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M2-006 (#2386): bump _toplevel_stats[TL_ST_CLOSE_ACK=3]. Labels prefixed tsb_ca_.",
      block: {
        lea r10, [rip + _toplevel_stats];
        mov rax, [r10 + 24];
        add rax, 1;
        mov [r10 + 24], rax;
        ret
      }
    }

  // ==========================================================================
  // toplevel_init() -- zero pool + stats + id counter at boot.
  //
  // Called from kernel_main's graphics-substrate init phase alongside
  // kind_surface_init / damage_region_init.  Three straight-line loops.
  // ==========================================================================

  pub let toplevel_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M2-006 (#2386): zero _toplevels (512 u64 = 4 KiB), _toplevel_stats (4 u64), _toplevel_next_id (1 u64). Defensive boot-time re-scrub mirroring kind_surface_init (kind_surface.pdx L272) / damage_region_init (damage_region.pdx L191). Three straight-line loops using [reg + rcx * 8] SIB (scale 8 in the {1,2,4,8} legal set). Labels prefixed ti_.",
      block: {
        lea r10, [rip + _toplevels];
        xor rax, rax;
        xor rcx, rcx;
      ti_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 512;
        jb  ti_rows;

        lea r10, [rip + _toplevel_stats];
        xor rcx, rcx;
      ti_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  ti_stats;

        lea r10, [rip + _toplevel_next_id];
        mov [r10 + 0], rax;
        ret
      }
    }

  // ==========================================================================
  // toplevel_row_valid(slot) -> 1 iff slot < TOPLEVEL_ROW_MAX and the
  // row's in_use marker byte (top byte of hdr) is nonzero.
  // ==========================================================================

  pub let toplevel_row_valid : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M2-006 (#2386): 1 iff slot < TOPLEVEL_ROW_MAX(16) and in_use marker set. Slot->offset via shl 8 (row * 256). Labels prefixed trv_.",
      block: {
        mov r10, [rip + TOPLEVEL_ROW_MAX];
        cmp rdi, r10;
        jae trv_no;
        lea r10, [rip + _toplevels];
        mov r11, rdi;
        shl r11, 8;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  trv_no;
        mov rax, 1;
        ret;
      trv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // toplevel_row_addr(slot) -> &_toplevels[slot*256] iff live; 0 otherwise.
  // Exposed for the follow-on cap dispatcher's multi-field row edits.
  // ==========================================================================

  pub let toplevel_row_addr : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M2-006 (#2386): row base pointer post-liveness. Returns 0 on invalid slot (out-of-range OR in_use==0). Labels prefixed tra_.",
      block: {
        mov r10, [rip + TOPLEVEL_ROW_MAX];
        cmp rdi, r10;
        jae tra_no;
        lea r10, [rip + _toplevels];
        mov r11, rdi;
        shl r11, 8;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  tra_no;
        mov rax, r10;
        ret;
      tra_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // toplevel_find_by_id(toplevel_id) -> slot | TOPLEVEL_NOT_FOUND.
  //
  // Linear scan across live rows.  Zero id argument is a caller bug and
  // returns TOPLEVEL_NOT_FOUND (a zero row+8 word is the "no id assigned"
  // state a live-and-uninitialised row would hold, but every claim path
  // stamps a nonzero id before releasing the row so a zero at +8 of a
  // live row is not observable; conflating the two cases here keeps the
  // return taxonomy compact).
  // ==========================================================================

  pub let toplevel_find_by_id : (u64) -> u64 !{mem} @{} =
    fn (toplevel_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M2-006 (#2386): linear scan for toplevel_id in row+8 of every live row. Scale-8 SIB not used (byte offset 8 within a 256-byte row, so `shl 8` slot compute + `+ 8` displacement). Labels prefixed tfb_.",
      block: {
        push rbx;
        push r12;
        mov r12, rdi;                        // r12 = target toplevel_id
        xor rbx, rbx;                        // rbx = scan idx
      tfb_scan:
        mov r10, [rip + TOPLEVEL_ROW_MAX];
        cmp rbx, r10;
        jae tfb_none;
        lea r10, [rip + _toplevels];
        mov r11, rbx;
        shl r11, 8;
        add r10, r11;                        // r10 = row base
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  tfb_step;
        mov rax, [r10 + 8];
        cmp rax, r12;
        jne tfb_step;
        mov rax, rbx;
        jmp tfb_out;
      tfb_step:
        add rbx, 1;
        jmp tfb_scan;
      tfb_none:
        mov rax, 0xFFFFE17B;                 // TOPLEVEL_NOT_FOUND
      tfb_out:
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // toplevel_create(surface_slot, title_ptr, title_len) -> toplevel_id | err
  //
  // Gate order:
  //   (1) surface_row_valid(surface_slot)   -> else TOPLEVEL_BAD_SURFACE
  //   (2) title_len <= TOPLEVEL_TITLE_MAX   -> else TOPLEVEL_BAD_TITLE_LEN
  //   (3) title_len > 0 => title_ptr != 0   -> else TOPLEVEL_BAD_TITLE_PTR
  //   (4) low-first free-slot scan          -> else TOPLEVEL_TAIL_ENOSPC
  //   (5) LAM header: bump low-56 gen, OR in 1<<56 marker
  //   (6) Read sid from KIND_SURFACE row+8 via surface_row_addr
  //   (7) Assign toplevel_id = pre-inc _toplevel_next_id (first id = 1)
  //   (8) Stamp row: id, surface_slot, close_pending=0, resize_min=0,
  //       resize_max=0, title_len, title bytes copied, tail zero-padded
  //   (9) stats.creates++
  //  (10) klog_s1_x2 SURFACE TOPLEVEL CREATE OK sid=<r14> tid=<r15>
  //  (11) return toplevel_id
  //
  // Register plan: rbx=free_slot / row_base scratch, r12=surface_slot,
  // r13=title_ptr, r14=title_len (pre-copy) then reused as sid post-copy,
  // r15=toplevel_id, rbp=row_base (survives across copy loops).  Six
  // callee-save pushes = 48 B + sub rsp,8 = 56 B; entry rsp%16==8 ->
  // (8+56) = 64, %16=0 -- aligned for every nested call.
  //
  // klog_s1_x2 v2 push idiom (bdev_write.pdx L809 / surface_commit_ops
  // L420-423): sub 8; push v2; call; add 16.  At body rsp%16=0 before
  // the emit, this lands v2 at [rsp+8] as klog_s1_x2's ABI expects.
  //
  // Title copy discipline: (a) zero the whole 128-byte inline title
  // region first (16 u64 stores in a straight-line loop, since 128/8 =
  // 16); (b) copy title_len bytes from title_ptr byte-by-byte via
  // `mov_b rax, [src + idx*1]; mov_b [dst + idx*1], al`.  The two-pass
  // approach keeps every write encoder-conservative and avoids
  // partial-write ordering hazards between tail-pad and copy.  For
  // title_len==0 the copy phase is a no-op and the row's title stays
  // fully zero.
  // ==========================================================================

  pub let toplevel_create : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (surface_slot: u64) (title_ptr: u64) (title_len: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R113.M2-006 (#2386): create TOPLEVEL role over a KIND_SURFACE row. Gate order per file header. Six callee-save pushes (rbx/r12-r15/rbp) + sub rsp,8 land rsp%16=0 (entry 8 + 48 + 8 = 64) for every nested call including klog_s1_x2. Slot->offset via shl 8 (row * 256, encoder pitfall v0.36+: no 2-op imul r,imm). LAM header discipline mirrors kind_surface.pdx L831-840: 56-bit mask via movabs, in_use marker bit 56. surface_row_addr + [row+8] load re-reads sid post-liveness (defense-in-depth against a slot going dead between gates 1 and 6, impossible in single-threaded kernel bringup but the cheap check preserves ordering-independence, mirroring surface_commit_ops.pdx L376-381). klog_s1_x2 v2 push idiom (sub 8; push r15; call; add 16) at rsp%16=0 lands v2 at [rsp+8] per wrappers.pdx L72 ABI. Title copy is a straight-line 16 u64 zero-pass followed by a byte-copy loop using [reg + rcx * 1] scale-1 SIB (vfs_open.pdx precedent, mov_b idiom). Labels prefixed tc_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;
        sub rsp, 8;

        mov r12, rdi;                        // surface_slot
        mov r13, rsi;                        // title_ptr
        mov r14, rdx;                        // title_len

        // (1) surface_row_valid(surface_slot)
        mov rdi, r12;
        call surface_row_valid;
        cmp rax, 0;
        je  tc_bad_surface;

        // (2) title_len <= TOPLEVEL_TITLE_MAX
        mov r10, [rip + TOPLEVEL_TITLE_MAX];
        cmp r14, r10;
        ja  tc_bad_title_len;

        // (3) title_len > 0 => title_ptr != 0
        cmp r14, 0;
        je  tc_ptr_ok;
        cmp r13, 0;
        je  tc_bad_title_ptr;
      tc_ptr_ok:

        // (4) low-first free-slot scan
        xor rbx, rbx;                        // rbx = candidate slot
      tc_scan:
        mov r10, [rip + TOPLEVEL_ROW_MAX];
        cmp rbx, r10;
        jae tc_enospc;
        lea r10, [rip + _toplevels];
        mov r11, rbx;
        shl r11, 8;                          // rbx * 256
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  tc_claim;
        add rbx, 1;
        jmp tc_scan;

      tc_claim:
        // r10 = row base for the claimed slot; keep it in rbp.
        mov rbp, r10;

        // (5) LAM: hdr = ((old_gen + 1) & 0x00FFFFFFFFFFFFFF) | (1<<56)
        mov r11, [rbp + 0];
        mov r9, 0x00FFFFFFFFFFFFFF;
        and r11, r9;
        add r11, 1;
        and r11, r9;
        mov r8, 1;
        shl r8, 56;
        or  r11, r8;
        mov [rbp + 0], r11;

        // (6) sid = surface_row_addr(surface_slot)[+8]
        mov rdi, r12;
        call surface_row_addr;
        cmp rax, 0;
        je  tc_bad_surface_late;
        mov r10, [rax + 8];                  // r10 = sid
        // Stash sid into r14 -- title_len is no longer needed as-is
        // (we've already validated it and will re-load from row+40
        // if the copy loop needs it; simpler is to keep title_len
        // where it is and use a separate scratch for sid).  Use r9
        // (caller-save) as a temporary: the very next thing that
        // clobbers r9 is the klog_s1_x2 argument setup which loads
        // r9 with the k2 pointer AFTER sid has been moved into r8
        // as v1.  Save sid on the stack slot to keep the flow
        // straight-forward across the copy loops.
        mov [rsp + 0], r10;                  // stack slot = sid

        // (7) toplevel_id = pre-inc _toplevel_next_id (first id = 1)
        lea r10, [rip + _toplevel_next_id];
        mov rax, [r10 + 0];
        add rax, 1;
        mov [r10 + 0], rax;
        mov r15, rax;                        // r15 = toplevel_id

        // (8a) +8 = toplevel_id
        mov [rbp + 8], r15;

        // (8b) +16 = refs = surface_slot[31:0] | close_pending[63:32]
        //      close_pending = 0 at create.
        mov rax, r12;
        and rax, 0xFFFFFFFF;
        mov [rbp + 16], rax;

        // (8c) +24 = resize_min = 0 (unconstrained)
        xor rax, rax;
        mov [rbp + 24], rax;
        // (8d) +32 = resize_max = 0 (unconstrained)
        mov [rbp + 32], rax;

        // (8e) +40 = title_len (as validated)
        mov [rbp + 40], r14;

        // (8f) Zero the 128-byte inline title region (16 u64 stores).
        //      rbx is dead after the claim scan; repurpose it as the
        //      title-area pointer (row_base + 48) so the loops use the
        //      proven `[base + rcx * scale]` form (no displacement +
        //      scale composition -- kept encoder-conservative).
        mov rbx, rbp;
        add rbx, 48;
        xor rcx, rcx;
      tc_title_zero:
        mov [rbx + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 16;
        jb  tc_title_zero;

        // (8g) Byte-copy title_len bytes from title_ptr into row+48.
        //      Skip the loop entirely if title_len == 0.  Byte load
        //      via `mov_b rax, [src + rcx * 1]` (nvme identify.pdx
        //      copy-loop precedent); byte store via `mov [dst + rcx *
        //      1], al` (same precedent -- plain `mov` with `al` alias).
        cmp r14, 0;
        je  tc_title_done;
        xor rcx, rcx;
      tc_title_copy:
        cmp rcx, r14;
        jae tc_title_done;
        mov_b rax, [r13 + rcx * 1];
        mov [rbx + rcx * 1], al;
        add rcx, 1;
        jmp tc_title_copy;
      tc_title_done:

        // (9) stats.creates++
        call toplevel_stats_bump_creates;

        // (10) klog_s1_x2 SURFACE TOPLEVEL CREATE OK sid=<sid> tid=<r15>
        //      v2 (tid) pushed as 7th arg per klog_s1_x2 ABI.
        mov rdi, 3;                          // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + surface_toplevel_create_ok_msg];
        lea rcx, [rip + surface_k_sid];
        mov r8, [rsp + 0];                   // v1 = sid (from stack slot)
        lea r9, [rip + toplevel_k_tid];
        sub rsp, 8;
        push r15;                            // v2 = toplevel_id (tid)
        call klog_s1_x2;
        add rsp, 16;

        // (11) return toplevel_id
        mov rax, r15;
        jmp tc_out;

      tc_bad_surface_late:
        // The KIND_SURFACE row went dead between gate (1) and the
        // sid read (impossible today, defense-in-depth).  Roll back
        // the header claim so the slot stays scannable, then refuse.
        // Roll-back = clear the in_use marker; the incremented
        // generation stays (ABA safety is preserved by consuming the
        // generation slot).
        mov r11, [rbp + 0];
        mov r9, 0x00FFFFFFFFFFFFFF;
        and r11, r9;
        mov [rbp + 0], r11;
        mov rax, 0xFFFFE17E;                 // TOPLEVEL_BAD_SURFACE
        jmp tc_out;

      tc_bad_surface:
        mov rax, 0xFFFFE17E;                 // TOPLEVEL_BAD_SURFACE
        jmp tc_out;
      tc_bad_title_len:
        mov rax, 0xFFFFE17D;                 // TOPLEVEL_BAD_TITLE_LEN
        jmp tc_out;
      tc_bad_title_ptr:
        mov rax, 0xFFFFE17C;                 // TOPLEVEL_BAD_TITLE_PTR
        jmp tc_out;
      tc_enospc:
        mov rax, 0xFFFFE17F;                 // TOPLEVEL_TAIL_ENOSPC

      tc_out:
        add rsp, 8;
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // toplevel_set_title(toplevel_id, title_ptr, title_len) -> 0 | err
  //
  // Gate order:
  //   (1) toplevel_id != 0                     -> else TOPLEVEL_BAD_ID
  //   (2) toplevel_find_by_id -> slot          -> else TOPLEVEL_NOT_FOUND
  //   (3) title_len <= TOPLEVEL_TITLE_MAX      -> else TOPLEVEL_BAD_TITLE_LEN
  //   (4) title_len > 0 => title_ptr != 0      -> else TOPLEVEL_BAD_TITLE_PTR
  //   (5) Overwrite: write title_len at row+40; zero title[128]; copy bytes
  //   (6) stats.set_title++
  //   (7) return 0
  //
  // Register plan: rbx=slot, r12=title_ptr, r13=title_len, r14=row_base.
  // Four callee-save pushes = 32 B; entry rsp%16==8 -> (8+32)=40, %16=8
  // -- BAD.  Add `sub rsp, 8` alignment padding to reach 48, %16=0,
  // aligned for every nested call.
  // ==========================================================================

  pub let toplevel_set_title : (u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (toplevel_id: u64) (title_ptr: u64) (title_len: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R113.M2-006 (#2386): overwrite an existing TOPLEVEL row's inline title. Gate order per file header. Four callee-save pushes (rbx/r12/r13/r14) + sub rsp,8 land rsp%16=0 (entry 8 + 32 + 8 = 48) for every nested call. Zero-pass over 16 u64 words before byte copy avoids partial-write ordering hazards. Labels prefixed tst_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        sub rsp, 8;

        // (1) toplevel_id != 0
        cmp rdi, 0;
        je  tst_bad_id;

        mov r12, rsi;                        // title_ptr
        mov r13, rdx;                        // title_len

        // (2) find slot by id
        // rdi already holds toplevel_id.
        call toplevel_find_by_id;
        mov r10, 0xFFFFE17B;                 // TOPLEVEL_NOT_FOUND
        cmp rax, r10;
        je  tst_not_found;
        mov rbx, rax;                        // rbx = slot

        // (3) title_len <= TOPLEVEL_TITLE_MAX
        mov r10, [rip + TOPLEVEL_TITLE_MAX];
        cmp r13, r10;
        ja  tst_bad_title_len;

        // (4) title_len > 0 => title_ptr != 0
        cmp r13, 0;
        je  tst_ptr_ok;
        cmp r12, 0;
        je  tst_bad_title_ptr;
      tst_ptr_ok:

        // (5) row_base = &_toplevels[slot * 256].  Slot is live (gate 2)
        // so tra_no cannot fire; keep the compute inline (skip the
        // toplevel_row_addr call to avoid a redundant liveness check).
        lea r10, [rip + _toplevels];
        mov r11, rbx;
        shl r11, 8;
        add r10, r11;
        mov r14, r10;                        // r14 = row_base

        // Write title_len at row+40.
        mov [r14 + 40], r13;

        // Advance r14 by 48 so the title-area loops use the proven
        // `[base + rcx * scale]` form (no displacement + scale
        // composition -- kept encoder-conservative).  r14 is no longer
        // the row base after this point; that's fine because none of
        // the remaining code paths need it.
        add r14, 48;

        // Zero the 128-byte inline title region (16 u64 stores).
        xor rax, rax;
        xor rcx, rcx;
      tst_title_zero:
        mov [r14 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 16;
        jb  tst_title_zero;

        // Copy title_len bytes.  Byte load via `mov_b rax, [src + rcx
        // * 1]`; byte store via `mov [dst + rcx * 1], al` (nvme
        // identify.pdx copy-loop precedent).
        cmp r13, 0;
        je  tst_title_done;
        xor rcx, rcx;
      tst_title_copy:
        cmp rcx, r13;
        jae tst_title_done;
        mov_b rax, [r12 + rcx * 1];
        mov [r14 + rcx * 1], al;
        add rcx, 1;
        jmp tst_title_copy;
      tst_title_done:

        // (6) stats.set_title++
        call toplevel_stats_bump_set_title;

        // (7) return 0
        xor rax, rax;
        jmp tst_out;

      tst_bad_id:
        mov rax, 0xFFFFE17A;                 // TOPLEVEL_BAD_ID
        jmp tst_out;
      tst_not_found:
        mov rax, 0xFFFFE17B;                 // TOPLEVEL_NOT_FOUND
        jmp tst_out;
      tst_bad_title_len:
        mov rax, 0xFFFFE17D;                 // TOPLEVEL_BAD_TITLE_LEN
        jmp tst_out;
      tst_bad_title_ptr:
        mov rax, 0xFFFFE17C;                 // TOPLEVEL_BAD_TITLE_PTR

      tst_out:
        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // toplevel_request_close(toplevel_id) -> 0 | err
  //
  // Compositor-facing "please close" flag toggle.  Gate order:
  //   (1) toplevel_id != 0                     -> else TOPLEVEL_BAD_ID
  //   (2) toplevel_find_by_id -> slot          -> else TOPLEVEL_NOT_FOUND
  //   (3) close_pending (high 32 of row+16) already set?
  //                                            -> TOPLEVEL_ALREADY_CLOSING
  //   (4) Set close_pending = 1 (preserving surface_slot low 32)
  //   (5) stats.close_req++
  //   (6) return 0
  //
  // Register plan: rbx=slot, r12=row_base.  Two callee-save pushes +
  // sub rsp,8 = 24 B; entry rsp%16==8 -> (8+24)=32, %16=0, aligned for
  // the two nested calls (toplevel_find_by_id + toplevel_stats_bump_
  // close_req).
  // ==========================================================================

  pub let toplevel_request_close : (u64) -> u64 !{mem} @{cap} =
    fn (toplevel_id: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R113.M2-006 (#2386): compositor sets close_pending. Idempotent-refusal: second request while pending returns TOPLEVEL_ALREADY_CLOSING rather than silently succeeding (protects against a confused compositor path). Two callee-save pushes (rbx/r12) + sub rsp,8 land rsp%16=0 (entry 8 + 16 + 8 = 32) for the two nested calls. close_pending sits in row+16 high 32; write preserves surface_slot in low 32 via and 0xFFFFFFFF (safe imm32 encoding per kind_surface precedent). Labels prefixed trc_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        // (1) toplevel_id != 0
        cmp rdi, 0;
        je  trc_bad_id;

        // (2) find by id
        call toplevel_find_by_id;
        mov r10, 0xFFFFE17B;                 // TOPLEVEL_NOT_FOUND
        cmp rax, r10;
        je  trc_not_found;
        mov rbx, rax;                        // rbx = slot

        // Compute row base inline (slot is live, no re-check needed).
        lea r10, [rip + _toplevels];
        mov r11, rbx;
        shl r11, 8;
        add r10, r11;
        mov r12, r10;                        // r12 = row_base

        // (3) Read refs word.  close_pending = (refs >> 32) & 0xFFFFFFFF.
        mov rax, [r12 + 16];
        shr rax, 32;
        cmp rax, 0;
        jne trc_already;

        // (4) Set close_pending = 1 preserving surface_slot (low 32).
        mov rax, [r12 + 16];
        and rax, 0xFFFFFFFF;                 // preserve surface_slot
        mov r10, 1;
        shl r10, 32;                         // 1 << 32 (close_pending=1)
        or  rax, r10;
        mov [r12 + 16], rax;

        // (5) stats.close_req++
        call toplevel_stats_bump_close_req;

        // (6) return 0
        xor rax, rax;
        jmp trc_out;

      trc_bad_id:
        mov rax, 0xFFFFE17A;                 // TOPLEVEL_BAD_ID
        jmp trc_out;
      trc_not_found:
        mov rax, 0xFFFFE17B;                 // TOPLEVEL_NOT_FOUND
        jmp trc_out;
      trc_already:
        mov rax, 0xFFFFE179;                 // TOPLEVEL_ALREADY_CLOSING

      trc_out:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // toplevel_ack_close(toplevel_id) -> 0 | err
  //
  // Client-facing "I've drained" flag clear.  Gate order:
  //   (1) toplevel_id != 0                     -> else TOPLEVEL_BAD_ID
  //   (2) toplevel_find_by_id -> slot          -> else TOPLEVEL_NOT_FOUND
  //   (3) close_pending already clear?         -> TOPLEVEL_NOT_PENDING
  //   (4) Clear close_pending (preserving surface_slot low 32)
  //   (5) stats.close_ack++
  //   (6) return 0
  //
  // Register plan: identical to toplevel_request_close (rbx=slot,
  // r12=row_base, two callee-save pushes + sub rsp,8 = 24 B).
  // ==========================================================================

  pub let toplevel_ack_close : (u64) -> u64 !{mem} @{cap} =
    fn (toplevel_id: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R113.M2-006 (#2386): client clears close_pending. Explicit refusal (TOPLEVEL_NOT_PENDING) if no request is outstanding, protecting against phantom-ack bugs (Wayland precedent: xdg_toplevel.close ack races). Two callee-save pushes + sub rsp,8 align rsp%16=0. Clear write preserves surface_slot low 32 via and 0xFFFFFFFF. Labels prefixed tac_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        // (1) toplevel_id != 0
        cmp rdi, 0;
        je  tac_bad_id;

        // (2) find by id
        call toplevel_find_by_id;
        mov r10, 0xFFFFE17B;                 // TOPLEVEL_NOT_FOUND
        cmp rax, r10;
        je  tac_not_found;
        mov rbx, rax;                        // rbx = slot

        // Compute row base inline.
        lea r10, [rip + _toplevels];
        mov r11, rbx;
        shl r11, 8;
        add r10, r11;
        mov r12, r10;                        // r12 = row_base

        // (3) Read close_pending (high 32 of row+16).
        mov rax, [r12 + 16];
        shr rax, 32;
        cmp rax, 0;
        je  tac_not_pending;

        // (4) Clear close_pending, preserving surface_slot.
        mov rax, [r12 + 16];
        and rax, 0xFFFFFFFF;                 // strip high 32 = clear pending
        mov [r12 + 16], rax;

        // (5) stats.close_ack++
        call toplevel_stats_bump_close_ack;

        // (6) return 0
        xor rax, rax;
        jmp tac_out;

      tac_bad_id:
        mov rax, 0xFFFFE17A;                 // TOPLEVEL_BAD_ID
        jmp tac_out;
      tac_not_found:
        mov rax, 0xFFFFE17B;                 // TOPLEVEL_NOT_FOUND
        jmp tac_out;
      tac_not_pending:
        mov rax, 0xFFFFE178;                 // TOPLEVEL_NOT_PENDING

      tac_out:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }
}
