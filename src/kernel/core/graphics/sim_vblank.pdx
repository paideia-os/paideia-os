// src/kernel/core/graphics/sim_vblank.pdx -- R101.M3-003
//
// Simulated 60 Hz vblank source for the Bochs/stdvga backend.
//
// Bochs has no real vblank IRQ (the QEMU stdvga emits none). Per
// design/graphics/r101-kernel-plan.md §4.4, the R101 landing drives a
// simulated 60 Hz vblank off the LAPIC scheduler-tick path: LAPIC
// ticks at 100 Hz, so every 2 ticks + a residue counter that skips
// every 5th 2-tick period approximates 60 Hz well enough for the R101
// MVP witness (which only cares that SOME vblank arrived, not that it
// arrived on the millisecond).
//
// Approximation: 100 Hz / (5/3) = 60 Hz. Implemented as a 5-state
// counter: fires on cycles {0, 2, 3, 5, 7} of every 10 ticks (5 fires
// per 10 ticks = 50 Hz -- close enough for R101; a proper 60 Hz needs
// a fractional counter with a fixed-point residue, deferred to R103
// when virtio-gpu provides a real completion event and this simulated
// source retires as fallback-only).
//
// Called from int/exceptions.pdx's handle_timer body via the same
// tick_count-mod-N gating pattern the R94 tcp_poll_retransmits hook
// uses. When _active_backend_kind == BOCHS_STDVGA (=1), fires
// dpy_timeline_vblank_signal(engine_id=1, output_id=1) to advance the
// KIND_DISPLAY_TIMELINE row a future compositor holds. When no
// backend is active OR the active backend is not BOCHS_STDVGA (a real
// virtio-gpu / iris_xe backend has its own vblank source), this call
// is a no-op.
//
// -----------------------------------------------------------------------------
// SOURCE_SIMULATED = 3 -- documented enum value for the display-timeline
// source field
// -----------------------------------------------------------------------------
//
// design/graphics/r101-kernel-plan.md §R101.M3-005 asks for a new
// SOURCE_SIMULATED = 3 value on the KIND_DISPLAY_TIMELINE source enum.
// The timeline row's current shape (kind_display_timeline.pdx §2) does
// NOT carry a source field -- it records only {header, timeline_id,
// engine_id/output_id, last_scanout_value}. Introducing the source
// field is deferred to R103.M4-001 (which needs to distinguish
// SOURCE_VIRTIO_COMPLETION = 4 from SOURCE_SIMULATED = 3). This
// landing publishes SOURCE_SIMULATED as a compile-time constant so
// the R103 refactor has a stable name to bind against.

module SimVblank = structure {

  // Source-enum value for a timeline advanced by this simulated tick.
  // Registered here rather than in kind_display_timeline.pdx because
  // the timeline row does not yet carry a source field (see file
  // header). R103 lands the source-field refactor and rebinds this.
  pub let DPY_TL_SOURCE_UNKNOWN   : u64 = 0
  pub let DPY_TL_SOURCE_IRIS_XE   : u64 = 1
  pub let DPY_TL_SOURCE_VIRTIO    : u64 = 2
  pub let DPY_TL_SOURCE_SIMULATED : u64 = 3

  // Residue counter for the 5-of-10 approximation. See file header.
  // Zero-initialized by .bss; wraps every 10 ticks.
  pub let mut _sim_vblank_tick_residue : u64 = 0

  // ==========================================================================
  // sim_vblank_tick() -> ()
  //
  // Called from handle_timer once per LAPIC tick (100 Hz). Fires
  // dpy_timeline_vblank_signal every ~2 ticks when the Bochs backend
  // is active. When _active_backend_kind is 0 (no backend) or != 1
  // (BOCHS_STDVGA), returns without touching anything.
  //
  // Register discipline: leaf function, touches rax/rcx/r10/r11 only,
  // all caller-save. Safe to call from handle_timer's IF=0 context
  // without disturbing anything the ISR body has staged.
  // ==========================================================================
  pub let sim_vblank_tick : () -> () !{mem, sysreg} @{} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "R101.M3-003: LAPIC-tick-driven simulated 60 Hz vblank source for the Bochs/stdvga backend. Gates on _active_backend_kind == BOCHS_STDVGA (1); returns cleanly on any other value. Advances the tick residue mod 10; fires on even residues (5 fires per 10 ticks = 50 Hz -- see file header for the R101 approximation rationale). On a fire, calls dpy_timeline_vblank_signal(engine_id=1, output_id=1); ignores its NO_ROW return. Register plan: leaf, touches only caller-save (rax/rcx/rdx/rdi/rsi/r10/r11), no callee-save spilled. Entry rsp%16 == 8 (post-call); sub rsp,8 -> rsp%16 == 0 aligns for the nested call. Labels prefixed simvb_.",
      block: {
        sub rsp, 8;

        // Gate on active backend == BOCHS_STDVGA.
        mov rax, [rip + _active_backend_kind];
        cmp rax, 1;
        jne simvb_out;

        // Advance residue mod 10.
        lea r10, [rip + _sim_vblank_tick_residue];
        mov rax, [r10 + 0];
        add rax, 1;
        mov r11, 10;
        xor rdx, rdx;
        div r11;
        mov [r10 + 0], rdx;                      // publish (rax mod 10)

        // Fire on even residues {0, 2, 4, 6, 8}.
        mov rax, rdx;
        and rax, 1;
        cmp rax, 0;
        jne simvb_out;

        mov rdi, 1;
        mov rsi, 1;
        call dpy_timeline_vblank_signal;

      simvb_out:
        add rsp, 8;
        ret
      }
    }
}
