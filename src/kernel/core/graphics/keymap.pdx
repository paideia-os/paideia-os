// src/kernel/core/graphics/keymap.pdx -- R113.M3-016 (paideia-os #2396)
//
// Keymap: XKB-equivalent layout parser + per-surface delivery.
//
// -----------------------------------------------------------------------------
// SCOPE (per issue #2396)
// -----------------------------------------------------------------------------
//
// Sits atop R113.M3-012 (kbd_route.pdx) and R113.M3-015 (modifier_state.pdx).
// modifier_state tracks the currently-held modifier bit-mask; kbd_route
// owns the per-surface event ring.  This file's job is what happens
// BETWEEN a raw HID Usage code (with the caller's modifier snapshot)
// and the keysym that lands on the focused surface's ring:
//
//   * A static translation table _keymap[hid_code][modifier_class] u16
//     covering US QWERTY as the built-in layout.  256 rows (full u8
//     HID Usage space) x 4 modifier classes (normal / shift / alt-gr /
//     shift+alt-gr) x 2 bytes per keysym = 2 KiB in .bss.  Unmapped
//     cells stay 0 (uninit -> .bss zero at boot).
//
//   * keymap_init() populates the US QWERTY rows and emits the
//     KEYMAP LAYOUT OK fingerprint (name + key-row count) once at
//     boot -- the sole init-time reachable summary in this file.
//
//   * keymap_translate(hid_code, modifier_mask) -> keysym
//     Pure lookup: derives the 2-bit modifier class from the mask
//     (shift bits -> bit 0, alt bits -> bit 1), fetches the u16 at
//     _keymap[hid][class], returns it or a KEYMAP_* sentinel.
//
//   * keymap_deliver_per_surface(surface_slot, hid_code, is_press)
//     Wire helper: (1) modifier_get() -> mask; (2) keymap_translate
//     via the mask; (3) kbd_event_deliver(slot, keysym, 0, is_press).
//     Propagates any sentinel from translate; forwards the deliver
//     return value on success.
//
// -----------------------------------------------------------------------------
// MODIFIER CLASSES (per issue #2396)
// -----------------------------------------------------------------------------
//
// Two bits derived from the modifier_state mask (modifier_state.pdx §BIT
// LAYOUT):
//
//   class[0] = 1 if any shift bit is set  (MOD_SHIFT_LEFT | MOD_SHIFT_RIGHT
//              = 0x003 -- both bits get folded to a single "shift held"
//              signal because the US QWERTY layout does not differentiate
//              left vs right shift for keysym selection; per-side
//              discrimination is preserved in the mask for downstream
//              consumers that DO care).
//   class[1] = 1 if any alt bit is set    (MOD_ALT_LEFT | MOD_ALT_RIGHT
//              = 0x030 -- same fold rationale as shift; a follow-on
//              XKB-style layout with distinct AltGr semantics can
//              specialize this to MOD_ALT_RIGHT only without touching
//              the class encoding).
//
// Composed as:  class = (alt_present << 1) | shift_present
//
//   0 = normal    (neither modifier held)
//   1 = shift     (shift held, alt not held)
//   2 = alt/altgr (alt held, shift not held)
//   3 = shift+alt (both held)
//
// Ctrl and meta do NOT participate in class selection: the layout
// produces the same keysym whether Ctrl is held or not (the terminal
// or application interprets Ctrl-A as `chr(1)` by folding on the raw
// keysym `a`, not by re-indexing the keymap).  Same rationale for Meta.
// Only the two "shape-modifying" modifier families -- shift and alt --
// select which keysym the layout binds to a given HID code.
//
// -----------------------------------------------------------------------------
// KEYSYM ENCODING
// -----------------------------------------------------------------------------
//
// Keysyms in the US QWERTY layout are the corresponding ASCII code
// point (7-bit basic Latin block), which matches XKB's own convention
// for that block.  A future layout with keysyms outside basic Latin
// (accented letters, symbols) will use the same u16 lane; XKB reserves
// values above 0xFF00 for function/navigation/dead keys, and the u16
// lane leaves 8 free bits above 0x00FF for the same allocation.  Cells
// with no defined keysym stay 0 (the .bss zero-init), and
// keymap_translate returns KEYMAP_UNMAPPED (0xFFFFE211) for a zero
// cell.
//
// -----------------------------------------------------------------------------
// STATIC TABLE + BOOT-TIME INSTALL
// -----------------------------------------------------------------------------
//
// The 52 US QWERTY key rows are held in a compact packed source table
// _keymap_table : [u64; 52], one row per HID code:
//
//   bits [15:0]   hid_code      (u8 in practice; u16 headroom)
//   bits [31:16]  base keysym   (normal / class 0)
//   bits [47:32]  shift keysym  (shift / class 1)
//   bits [63:48]  reserved for a future alt-gr / shift+alt column
//                 (zero today -- US QWERTY has no alt-gr layer).
//
// keymap_init walks the table row by row and copies the pair into the
// _keymap[hid*4 + 0] and _keymap[hid*4 + 1] u16 slots.  Alt-gr /
// shift+alt slots stay 0 (the natural US QWERTY state; a follow-on
// layout table can be a drop-in replacement without touching the
// installer loop).
//
// The packed source table is compile-time initialized; the u16 keymap
// array is `uninit` and populated at boot.  This is more compact in
// source than 52 x 2 straight-line writes and lets a future layout be
// swapped by editing one table rather than 100+ mov instructions.
//
// -----------------------------------------------------------------------------
// FINGERPRINT ALLOWLIST
// -----------------------------------------------------------------------------
//
// One tag emitted, exactly once per boot (keymap_init runs from
// kernel_main.pdx alongside kbd_route_init / modifier_state_init /
// ptr_route_init):
//
//   "keymap layout ok [legacy: KEYMAP LAYOUT OK] name=0x<hex> keys=<n>"
//
// name = packed 8-byte ASCII of the layout identifier ("USQWERTY"
// little-endian => 0x5954524557515355), keys = row count actually
// installed (52 for US QWERTY -- 26 letters + 10 digits + 5 whitespace
// + 11 punctuation).
//
// KV keys used: two locally-declared 5-byte strings (keymap_k_name,
// keymap_k_keys) rather than plumbing new entries into
// src/kernel/core/klog/keys.pdx -- the "name"/"keys" identifiers are
// not sufficiently generic to justify a shared declaration and the
// local pattern matches kbd_route.pdx's `kbd_route_ready_msg`
// (in-file byte string) convention.
//
// Coverage: allowlisted in tools/verify-fingerprint-coverage.sh with
// the "no golden pins this exact literal yet" reason (mirrors the
// policy seed ok / resolv seed ok pattern above -- reachable every
// boot but not asserted by any test golden yet; a follow-on boot
// witness under R113.M3-016+ smoke will pin it).
//
// -----------------------------------------------------------------------------
// FAILURE TAXONOMY -- 0xFFFFE210..0xFFFFE21F (fresh band, grep-verified)
// -----------------------------------------------------------------------------
//
// Sweep 2026-09-08:
//
//   $ grep -rho '0xFFFFE2[0-9A-Fa-f]\{2\}' src -> empty
//
// So 0xFFFFE210..0xFFFFE21F is uncontested.  Neighbouring bands (per
// R113.M3-012/013/015 landings, kbd_route.pdx / ptr_route.pdx /
// modifier_state.pdx headers):
//
//   0xFFFFE1C0..E1CF  R113.M3-012 KBD_ROUTE       (kbd_route.pdx)
//   0xFFFFE1D0..E1DF  R113.M3-013 PTR_ROUTE       (ptr_route.pdx)
//   0xFFFFE1E0..E1EF  R113.M3-015 MODIFIER_STATE  (modifier_state.pdx)
//   0xFFFFE1F0..E1FF  free (reserved for M3 follow-on)
//   0xFFFFE200..E20F  free (reserved for M3 follow-on)
//   0xFFFFE210..E21F  R113.M3-016 KEYMAP          (THIS FILE)
//
// Slot map:
//
//   0xFFFFE210  KEYMAP_BAD_HID    hid_code >= 256 (out of the u8 HID
//                                 Usage code range that the table
//                                 indexes).
//   0xFFFFE211  KEYMAP_UNMAPPED   translate returned a zero-cell (no
//                                 keysym bound for the (hid, class)
//                                 pair in the current layout).  A
//                                 legitimate soft-failure for a key
//                                 the layout does not cover, not a bug.
//   0xFFFFE212  KEYMAP_BAD_SLOT   surface_slot passed to
//                                 keymap_deliver_per_surface is out of
//                                 range (mirrors KBD_ROUTE_BAD_SLOT
//                                 handling but the caller sees the
//                                 KEYMAP band so it can distinguish
//                                 the pre-translate arm from
//                                 kbd_event_deliver's own reject).
//   0xFFFFE213..0xFFFFE21F           reserved for M3 follow-on
//                                 (per-layout compose sequence, dead-
//                                 key state, seat-scoped keymap, etc.).
//
// -----------------------------------------------------------------------------
// RIGHTS GATING -- OWNED BY THE INPUT DISPATCHER, NOT HERE
// -----------------------------------------------------------------------------
//
// keymap_init / keymap_translate / keymap_deliver_per_surface do NOT
// check rights.  All three are kernel-internal; no cap_invoke arm
// dispatches to them.  The input-server / cap_handler_surface landing
// will gate on R_SURFACE_KGATE_QUERY (kind_surface.pdx §3.2) or a
// dedicated R_INPUT_ROUTE right before calling in.  Same discipline as
// kbd_route.pdx §"Rights gating -- owned by the input dispatcher".
//
// -----------------------------------------------------------------------------
// ENCODER PITFALLS (per feedback_pdx_encoder_pitfalls v0.36+)
// -----------------------------------------------------------------------------
//
//   * No `test rN, rN` -- every zero-check uses `cmp rN, 0` + `je/jne`.
//   * No 2-op `imul r, imm` -- keymap byte offset uses `shl 3` (hid *
//     8 = 4 classes * 2 bytes/class); table row byte offset uses
//     `shl 3` (u64 row lane).  Class-to-byte offset uses `shl 1`.
//   * No `and reg, imm64` -- 0xFFFF (u16 mask), 0x03 (shift bits),
//     0x30 (alt bits) all fit imm8 or imm32.  Layout-name u64 constant
//     0x5954524557515355 staged via `mov r64, imm64` (movabs) into a
//     scratch register before being placed in the r8 argument slot.
//   * No `cmp reg, [mem]` -- every mem compare loads to a scratch
//     register first (surface_present.pdx L242 pattern).
//   * No literal-scaled `[reg + N*8]` beyond SIB scale 1/2/4/8 --
//     ring stride not applicable here; all offsets computed then
//     added to the base register with a plain displacement.
//   * No `mov qword [mem], imm64` -- keymap installer stages values
//     into a scratch register then stores via `mov_w`.
//   * u16 memory access uses `mov_w [reg + disp], reg` and `mov_w reg,
//     [reg + disp]` (fb_console.pdx / acpi/hpet.pdx pattern).
//
// -----------------------------------------------------------------------------
// LABEL PREFIX
// -----------------------------------------------------------------------------
//
// `ki_` = keymap_init, `kt_` = keymap_translate, `kd_` =
// keymap_deliver_per_surface.  All prefixes avoid the paideia-as
// reserved keyword set (feedback_paideia_as_reserved_labels): `ki`,
// `kt`, `kd` are not keywords.

module Keymap = structure {

  // ==========================================================================
  // Constants
  // ==========================================================================

  // Full u8 HID Usage code range covered by the table.  Bumping this
  // would require paired resizes of _keymap (below) and every offset
  // computation that folds it into a `shl 3`.
  pub let KEYMAP_MAX_HID        : u64 = 256

  // Modifier-class fan-out (see file header §MODIFIER CLASSES).
  pub let KEYMAP_MOD_CLASSES    : u64 = 4

  // Total u16 slots = 256 * 4 = 1024.  Matches the _keymap declaration
  // below; kept explicit so a future bump reads as a single edit.
  pub let KEYMAP_TOTAL_SLOTS    : u64 = 1024

  // Modifier-class encoding (bit 0 = shift, bit 1 = alt).  Consumers
  // that need to hand-craft a class value (e.g. a test witness) should
  // OR these rather than pass a raw integer.
  pub let KEYMAP_CLASS_NORMAL   : u64 = 0
  pub let KEYMAP_CLASS_SHIFT    : u64 = 1
  pub let KEYMAP_CLASS_ALT      : u64 = 2
  pub let KEYMAP_CLASS_SHIFT_ALT: u64 = 3

  // Shift / alt bit masks folded from modifier_state.pdx §BIT LAYOUT.
  // Both fit imm8/imm32; used only via `and reg, imm32` (encoder-safe).
  pub let KEYMAP_SHIFT_BITS     : u64 = 0x003    // MOD_SHIFT_LEFT | MOD_SHIFT_RIGHT
  pub let KEYMAP_ALT_BITS       : u64 = 0x030    // MOD_ALT_LEFT | MOD_ALT_RIGHT

  // Layout identifier -- packed 8-byte ASCII, little-endian.  "USQWERTY"
  // reads as 0x59, 0x54, 0x52, 0x45, 0x57, 0x51, 0x53, 0x55 in memory,
  // which loads as the u64 0x5954524557515355.  Staged into a register
  // via movabs (imm64 mov) rather than an in-memory constant to keep
  // the wire arg self-contained.
  pub let KEYMAP_LAYOUT_NAME_US : u64 = 0x5954524557515355

  // Row count actually installed by keymap_init (26 letters + 10
  // digits + 5 whitespace/control + 11 punctuation = 52).  Kept
  // explicit here rather than derived from the table length so the
  // fingerprint value and the loop bound are visibly tied.
  pub let KEYMAP_INSTALLED_ROWS : u64 = 52

  // Result codes -- see file header §FAILURE TAXONOMY.
  pub let KEYMAP_OK             : u64 = 0
  pub let KEYMAP_BAD_HID        : u64 = 0xFFFFE210
  pub let KEYMAP_UNMAPPED       : u64 = 0xFFFFE211
  pub let KEYMAP_BAD_SLOT       : u64 = 0xFFFFE212

  // Sentinel band low bound -- any translate/deliver return >= this
  // value is a KEYMAP_* sentinel and must NOT be enqueued as a
  // keysym.  Staged via `mov reg, imm64` (movabs) then compared.
  pub let KEYMAP_SENTINEL_BASE  : u64 = 0xFFFFE210

  // ==========================================================================
  // KV keys -- locally declared, "name" and "keys" are too generic to
  // justify plumbing into src/kernel/core/klog/keys.pdx (kbd_route.pdx
  // uses the same in-file pattern for its ready message; the shared
  // keys.pdx module is reserved for cross-file KV keys).
  // ==========================================================================

  pub let keymap_k_name : [u8; 5] = "name\0"
  pub let keymap_k_keys : [u8; 5] = "keys\0"

  // ==========================================================================
  // Fingerprint tag -- boot-time summary emitter.
  //
  // Wire form (post-klog_s1_x2 KV append):
  //   keymap layout ok [legacy: KEYMAP LAYOUT OK] name=0x<hex> keys=0x<hex>
  //
  // Byte count verified by hand:
  //   "keymap layout ok [legacy: KEYMAP LAYOUT OK]\0" = 44 bytes
  //     (16 chars "keymap layout ok" + 1 space + 26 chars
  //     "[legacy: KEYMAP LAYOUT OK]" + 1 NUL)
  // ==========================================================================

  pub let keymap_layout_msg : [u8; 44] = "keymap layout ok [legacy: KEYMAP LAYOUT OK]\0"

  // ==========================================================================
  // Global keymap table -- .bss, @align(8).
  //
  // _keymap : [u16; 1024] -- row-major [hid_code][modifier_class]:
  //   byte offset for _keymap[hid][class] = (hid * 4 + class) * 2
  //                                       = hid * 8 + class * 2
  //
  // Uninit at declaration; .bss zero-init at boot leaves every slot at
  // 0 (the "unmapped" identity, which keymap_translate reports as
  // KEYMAP_UNMAPPED).  keymap_init overwrites the US QWERTY rows;
  // remaining rows and the alt/shift+alt columns stay 0 (US QWERTY
  // has no alt-gr layer).
  // ==========================================================================

  pub let mut _keymap : [u16; 1024] = uninit @align(8)

  // ==========================================================================
  // US QWERTY packed source table -- 52 u64 rows.
  //
  // Format per row (see file header §STATIC TABLE):
  //   bits [15:0]   hid_code
  //   bits [31:16]  base keysym  (class 0)
  //   bits [47:32]  shift keysym (class 1)
  //   bits [63:48]  reserved     (zero -- no alt-gr layer)
  //
  // Row helper:  val = (shift << 32) | (base << 16) | hid
  //
  // HID Usage codes per USB HID Usage Table 1.12 §10 (Keyboard/Keypad
  // Page 0x07); shifted keysyms per the US QWERTY convention (POSIX
  // /usr/share/X11/xkb/symbols/us "basic" variant).
  // ==========================================================================

  pub let _keymap_table : [u64; 52] = [
    // Letters a-z (HID 0x04-0x1D)  base=lowercase ASCII, shift=uppercase
    0x0000004100610004,  // a / A
    0x0000004200620005,  // b / B
    0x0000004300630006,  // c / C
    0x0000004400640007,  // d / D
    0x0000004500650008,  // e / E
    0x0000004600660009,  // f / F
    0x000000470067000A,  // g / G
    0x000000480068000B,  // h / H
    0x000000490069000C,  // i / I
    0x0000004A006A000D,  // j / J
    0x0000004B006B000E,  // k / K
    0x0000004C006C000F,  // l / L
    0x0000004D006D0010,  // m / M
    0x0000004E006E0011,  // n / N
    0x0000004F006F0012,  // o / O
    0x0000005000700013,  // p / P
    0x0000005100710014,  // q / Q
    0x0000005200720015,  // r / R
    0x0000005300730016,  // s / S
    0x0000005400740017,  // t / T
    0x0000005500750018,  // u / U
    0x0000005600760019,  // v / V
    0x000000570077001A,  // w / W
    0x000000580078001B,  // x / X
    0x000000590079001C,  // y / Y
    0x0000005A007A001D,  // z / Z

    // Digit row 1..9,0 (HID 0x1E-0x27)  base=digit, shift=US-punctuation
    0x000000210031001E,  // 1 / !
    0x000000400032001F,  // 2 / @
    0x0000002300330020,  // 3 / #
    0x0000002400340021,  // 4 / $
    0x0000002500350022,  // 5 / %
    0x0000005E00360023,  // 6 / ^
    0x0000002600370024,  // 7 / &
    0x0000002A00380025,  // 8 / *
    0x0000002800390026,  // 9 / (
    0x0000002900300027,  // 0 / )

    // Whitespace / control (HID 0x28-0x2C)  base == shift (no
    // shift-modified variant); populating both classes keeps the
    // translate path monotonic for a shift-held Enter/Tab/etc.
    0x0000000D000D0028,  // Enter    (CR 0x0D)
    0x0000001B001B0029,  // Escape   (ESC 0x1B)
    0x000000080008002A,  // Backspace(BS  0x08)
    0x000000090009002B,  // Tab      (HT  0x09)
    0x000000200020002C,  // Space    (SP  0x20)

    // Punctuation (HID 0x2D-0x38, skipping 0x32 -- non-US-hash key)
    0x0000005F002D002D,  // -  _
    0x0000002B003D002E,  // =  +
    0x0000007B005B002F,  // [  {
    0x0000007D005D0030,  // ]  }
    0x0000007C005C0031,  // \  |
    0x0000003A003B0033,  // ;  :
    0x0000002200270034,  // '  "
    0x0000007E00600035,  // `  ~
    0x0000003C002C0036,  // ,  <
    0x0000003E002E0037,  // .  >
    0x0000003F002F0038   // /  ?
  ]

  // ==========================================================================
  // keymap_init() -> ()
  //
  // Walk _keymap_table row by row (52 rows), decode hid/base/shift,
  // and store base at _keymap[hid][0] / shift at _keymap[hid][1].
  // Emit KEYMAP LAYOUT OK name=<hex> keys=<n> once via klog_s1_x2 at
  // the end of the install loop.
  //
  // Register plan: three callee-save pushes (rbx = row index, r12 =
  // &_keymap, r13 = &_keymap_table) -> entry rsp%16==8, +24 = 32,
  // rsp%16==0 for the loop body (no nested call inside the loop).
  // Later, a single push rax (v2 for klog_s1_x2 stack arg) -> rsp%16==8
  // pre-call; call pushes ret addr -> rsp%16==0 inside klog_s1_x2
  // (matches its own entry contract).  klog_s1_x2 preserves rbx / r12
  // / r13 per SysV so the callee-saves survive across the emit even
  // though they are not read afterward.  Labels prefixed ki_.
  // ==========================================================================

  pub let keymap_init : () -> () !{mem, sysreg} @{cap} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R113.M3-016 (#2396): populate _keymap with 52 US QWERTY (hid, base, shift) rows from _keymap_table, then emit KEYMAP LAYOUT OK name=0x5954524557515355 (\"USQWERTY\" LE) keys=52 via klog_s1_x2.  Loop body per row: (a) load packed u64 row = _keymap_table[rbx]; (b) extract hid = row & 0xFFFF; (c) base_offset in _keymap = hid * 8 (4 classes * 2 bytes = shl 3); (d) base = (row >> 16) & 0xFFFF, store via mov_w [rcx + 0], r11 (class 0); (e) shift = (row >> 32) & 0xFFFF, store via mov_w [rcx + 2], r11 (class 1); (f) advance rbx and loop while rbx < 52.  Three callee-save pushes (rbx = row idx, r12 = &_keymap, r13 = &_keymap_table) -> entry rsp%16=8, +24 = 32, %16=0 for the loop.  Post-loop klog_s1_x2 uses the sibling `sub rsp, 8; push v2; call; add rsp, 16` idiom (z_order.pdx L~245): pre-sub rsp%16=0, sub 8 -> %16=8, push v2 -> %16=0, call -> callee-entry %16=8 (SysV); on return, add rsp, 16 -> %16=0, pop r13/r12/rbx -> %16=8, ret restores caller alignment.  Layout name (imm64) staged into r8 via movabs.  No `and reg, imm64` (0xFFFF is imm32); no 2-op imul (offsets use shl 3).  klog_s1_x2 preserves rbx/r12/r13 per SysV so callee-saves survive.  Labels prefixed ki_.",
      block: {
        push rbx;
        push r12;
        push r13;

        // Load base pointers.
        lea r12, [rip + _keymap];
        lea r13, [rip + _keymap_table];
        xor rbx, rbx;                    // rbx = row index

      ki_install_loop:
        // (a) Load packed row: rax = _keymap_table[rbx].
        mov r10, rbx;
        shl r10, 3;                      // row * 8 bytes (u64 lane)
        mov r11, r13;
        add r11, r10;
        mov rax, [r11 + 0];              // rax = packed row

        // (b) Extract hid = row & 0xFFFF -> r10.
        mov r10, rax;
        and r10, 0xFFFF;                 // r10 = hid_code

        // (c) Compute _keymap byte offset for [hid][0]:
        //     hid * (4 classes * 2 bytes) = hid * 8 = shl 3.
        mov r11, r10;
        shl r11, 3;                      // r11 = hid * 8
        mov rcx, r12;
        add rcx, r11;                    // rcx = &_keymap[hid][0]

        // (d) Extract base = (row >> 16) & 0xFFFF -> r11; store class 0.
        mov r11, rax;
        shr r11, 16;
        and r11, 0xFFFF;                 // r11 = base keysym (u16)
        mov_w [rcx + 0], r11;            // _keymap[hid][0] = base

        // (e) Extract shift = (row >> 32) & 0xFFFF -> r11; store class 1.
        mov r11, rax;
        shr r11, 32;
        and r11, 0xFFFF;                 // r11 = shift keysym (u16)
        mov_w [rcx + 2], r11;            // _keymap[hid][1] = shift

        // (f) Advance and loop while rbx < 52.
        add rbx, 1;
        cmp rbx, 52;                     // KEYMAP_INSTALLED_ROWS
        jb  ki_install_loop;

        // Emit KEYMAP LAYOUT OK name=<hex> keys=<n> once via the
        // sibling `sub rsp, 8; push v2; call klog_s1_x2; add rsp, 16`
        // idiom (z_order.pdx L~245).  At rsp%16=0 pre-sub: sub 8 ->
        // %16=8, push v2 -> %16=0, call -> callee-entry %16=8 (SysV).
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + keymap_layout_msg];
        lea rcx, [rip + keymap_k_name];
        mov r8, 0x5954524557515355;      // v1 = "USQWERTY" LE (movabs)
        lea r9, [rip + keymap_k_keys];
        sub rsp, 8;                      // align pad
        mov rax, 52;                     // v2 = KEYMAP_INSTALLED_ROWS
        push rax;                        // caller-pushed 7th stack arg
        call klog_s1_x2;
        add rsp, 16;                     // pop v2 + undo align pad

        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // keymap_translate(hid_code, modifier_mask) -> keysym
  //
  // Gate order:
  //   (1) hid_code >= 256 -> KEYMAP_BAD_HID.
  //   (2) Derive modifier class from modifier_mask:
  //         class = (alt_present << 1) | shift_present
  //       where shift_present = (mask & KEYMAP_SHIFT_BITS) != 0 and
  //       alt_present   = (mask & KEYMAP_ALT_BITS)   != 0.
  //   (3) Load _keymap[hid_code * 4 + class] as u16 into rax.
  //   (4) If rax == 0 -> KEYMAP_UNMAPPED (no keysym bound for this
  //       (hid, class) pair in the current layout).
  //   (5) Return rax as the keysym (zero-extended).
  //
  // Pure leaf; no memory writes; only reads _keymap.  No callee-save
  // required (only rax / rcx / r10 / r11 scratched; entry rsp%16=8
  // unchanged on ret).  Labels prefixed kt_.
  // ==========================================================================

  pub let keymap_translate : (u64, u64) -> u64 !{mem} @{} =
    fn (hid_code: u64, modifier_mask: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M3-016 (#2396): translate (hid_code, modifier_mask) to a keysym via _keymap[hid][class] lookup.  (1) hid_code >= 256 -> KEYMAP_BAD_HID (0xFFFFE210); (2) class = (alt_present << 1) | shift_present, folded from mask & 0x003 (shift) and mask & 0x030 (alt) -- both fit imm8; (3) load u16 from _keymap[hid * 4 + class] via base + hid*8 + class*2 (shl 3, shl 1); (4) zero cell -> KEYMAP_UNMAPPED (0xFFFFE211); (5) return keysym (zero-extended from u16).  Pure leaf; only rax/rcx/r10/r11 scratched; entry rsp%16=8 unchanged on ret.  No `and reg, imm64` (masks fit imm8/imm32); no 2-op imul (offsets via shl).  Labels prefixed kt_.",
      block: {
        // (1) hid bounds check.
        cmp rdi, 256;                    // KEYMAP_MAX_HID
        jae kt_bad_hid;

        // (2) Derive class from mask.
        xor rax, rax;                    // rax = class accumulator (0)

        mov r10, rsi;
        and r10, 3;                      // KEYMAP_SHIFT_BITS (0x003 fits imm8)
        cmp r10, 0;
        je  kt_no_shift;
        mov rax, 1;                      // class |= 1 (shift bit)
      kt_no_shift:

        mov r10, rsi;
        and r10, 0x30;                   // KEYMAP_ALT_BITS (0x030 fits imm8)
        cmp r10, 0;
        je  kt_no_alt;
        or  rax, 2;                      // class |= 2 (alt bit)
      kt_no_alt:

        // (3) offset = hid * 8 + class * 2  -> r11
        mov r11, rdi;
        shl r11, 3;                      // hid * 8
        mov r10, rax;
        shl r10, 1;                      // class * 2
        add r11, r10;

        // Load base and add offset; xor-then-mov_w for u16 zero-ext.
        lea rcx, [rip + _keymap];
        add rcx, r11;
        xor rax, rax;                    // pre-zero for the u16 load
        mov_w rax, [rcx + 0];            // rax[15:0] = keysym
        and rax, 0xFFFF;                 // belt-and-suspenders zero-ext (fb_console.pdx L414-416 pattern)

        // (4) zero cell -> KEYMAP_UNMAPPED.
        cmp rax, 0;
        je  kt_unmapped;

        // (5) return rax as the keysym.
        ret

      kt_bad_hid:
        mov rax, 0xFFFFE210;             // KEYMAP_BAD_HID
        ret

      kt_unmapped:
        mov rax, 0xFFFFE211;             // KEYMAP_UNMAPPED
        ret
      }
    }

  // ==========================================================================
  // keymap_deliver_per_surface(surface_slot, hid_code, is_press) -> u64
  //
  // Gate order:
  //   (1) modifier_get() -> mask.
  //   (2) keymap_translate(hid_code, mask) -> keysym or KEYMAP_*
  //       sentinel.  On sentinel (>= KEYMAP_SENTINEL_BASE) propagate
  //       the sentinel without enqueueing.
  //   (3) kbd_event_deliver(surface_slot, keysym, modifiers=0,
  //       is_press) -- the deliver leaf validates its own surface_slot
  //       and returns 0/KBD_ROUTE_* which we forward.
  //
  // Modifiers=0 in the enqueue: the keysym already encodes the shift
  // semantics (uppercase vs lowercase, shifted punctuation), so the
  // downstream consumer does not need the modifier byte to re-derive
  // it.  A follow-on that widens the event lane for Ctrl/Meta chords
  // (which do NOT participate in keymap class selection -- see file
  // header §MODIFIER CLASSES) will forward the raw mask.
  //
  // Register plan: three callee-save pushes (rbx = surface_slot,
  // r12 = hid_code, r13 = is_press) -> entry rsp%16==8, +24 = 32,
  // rsp%16==0 for every nested call (modifier_get, keymap_translate,
  // kbd_event_deliver).  All three preserve rbx/r12/r13 per SysV so
  // the args survive across the modifier_get + translate hops.  Labels
  // prefixed kd_.
  // ==========================================================================

  pub let keymap_deliver_per_surface : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (surface_slot: u64, hid_code: u64, is_press: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R113.M3-016 (#2396): wire helper that composes modifier_get (modifier_state.pdx) + keymap_translate + kbd_event_deliver (kbd_route.pdx) for a single HID key edge.  (1) push rbx/r12/r13 (surface_slot / hid_code / is_press); (2) call modifier_get -> mask in rax; (3) call keymap_translate(hid_code, mask) -> keysym or KEYMAP_* sentinel; (4) if rax >= KEYMAP_SENTINEL_BASE (0xFFFFE210, staged via movabs into r10 for the compare), propagate the sentinel without enqueue; (5) else call kbd_event_deliver(surface_slot, keysym, 0, is_press) -- modifiers=0 because the keysym already encodes the shift semantics; (6) forward rax (either the sentinel or the kbd_event_deliver return value).  Three callee-save pushes -> entry rsp%16=8, +24 = 32, %16=0 for the three nested calls (all SysV-preserve rbx/r12/r13).  Labels prefixed kd_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                    // rbx = surface_slot
        mov r12, rsi;                    // r12 = hid_code
        mov r13, rdx;                    // r13 = is_press

        // (1) modifier_get() -> mask in rax.
        call modifier_get;

        // (2) keymap_translate(hid_code, mask) -> rax
        mov rdi, r12;                    // hid_code
        mov rsi, rax;                    // modifier_mask
        call keymap_translate;

        // (3) Sentinel check: rax >= 0xFFFFE210 propagates without enqueue.
        mov r10, 0xFFFFE210;             // KEYMAP_SENTINEL_BASE (movabs)
        cmp rax, r10;
        jae kd_out;                      // propagate translate sentinel

        // (4) Enqueue via kbd_event_deliver(slot, keysym, 0, is_press).
        mov rdi, rbx;                    // surface_slot
        mov rsi, rax;                    // key_code = keysym
        xor rdx, rdx;                    // modifiers = 0 (keysym pre-encodes shift)
        mov rcx, r13;                    // is_press
        call kbd_event_deliver;
        // rax = KBD_ROUTE_OK or KBD_ROUTE_* sentinel from deliver -- forward as-is.

      kd_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

}
