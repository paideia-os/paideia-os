// src/kernel/core/graphics/focus.pdx -- R113.M2-011 (paideia-os #2391)
//
// Focus model: keyboard focus + pointer focus + implicit grab.
//
// This is the first R113.M2 (window-manager) landing atop the R113.M1
// KIND_SURFACE substrate (design/graphics/r113-m1-substrate.md §9's
// downstream M2 sequencing: M2-011 = "focus" leaf, depends only on
// surface_row_valid from the substrate).  Sibling to M2-001..M2-006 but
// self-contained: no cross-references into the toplevel/popup/z-order
// state; those siblings will read/write this state via the six exported
// entry points below.
//
// -----------------------------------------------------------------------------
// SCOPE (per issue #2391)
// -----------------------------------------------------------------------------
//
// Three global focus-state cells:
//
//   * _kbd_focus_slot      -- KIND_SURFACE row slot receiving keyboard
//                             events.  Written by the input dispatcher
//                             (a future landing) when the compositor
//                             refocuses; read by hid_kbd_attach.pdx's
//                             follow-on Transfer Event handler to steer
//                             HID reports to the focused surface.
//
//   * _ptr_focus_slot      -- KIND_SURFACE row slot under the pointer
//                             cursor.  Written by the pointer-motion
//                             worker as the cursor crosses surface
//                             extents; read by the pointer-event
//                             dispatcher for hover / enter / leave.
//
//   * _implicit_grab_slot  -- KIND_SURFACE row slot that captured the
//                             pointer on the most recent button-down
//                             edge.  Weston / wlroots-style implicit
//                             grab: pointer events keep flowing to the
//                             grabbed surface even when the cursor
//                             wanders off it, until button-up releases
//                             the grab.  Distinct from _ptr_focus_slot
//                             so a grab can outlive a hover transition.
//
// Six entry points:
//
//   * focus_init()                    -- boot-time init; all three cells
//                                        latch to FOCUS_NONE (0xFF..FF).
//                                        Called from kernel_main.pdx
//                                        immediately after
//                                        kind_surface_init.
//   * focus_set_keyboard(slot) -> u64 -- validate slot (or FOCUS_NONE
//                                        to clear); emit "FOCUS KBD"
//                                        fingerprint on transition;
//                                        return 0 | FOCUS_BAD_SLOT.
//   * focus_get_keyboard() -> u64     -- current keyboard-focus slot
//                                        (FOCUS_NONE if unfocused).
//   * focus_set_pointer(slot) -> u64  -- symmetric to set_keyboard,
//                                        emits "FOCUS PTR" on transition.
//   * focus_get_pointer() -> u64      -- current pointer-focus slot.
//   * focus_grab(slot) -> u64         -- implicit grab: on button-down
//                                        callers pin a slot; refuses
//                                        with FOCUS_ALREADY_GRABBED if
//                                        a grab is already in flight
//                                        (button-up must run first).
//   * focus_ungrab() -> u64           -- release grab; FOCUS_NOT_GRABBED
//                                        if no grab is active.
//
// -----------------------------------------------------------------------------
// WHY FOCUS_NONE = 0xFFFFFFFFFFFFFFFF (not 0)
// -----------------------------------------------------------------------------
//
// KIND_SURFACE row slots are indexed [0, SURFACE_ROW_MAX) with slot 0 a
// valid slot (kind_surface.pdx surface_mint uses a low-first scan, so
// the first ever surface mint claims slot 0).  A zero sentinel would
// collide with slot 0.  0xFFFFFFFFFFFFFFFF is outside the u64 slot-id
// domain (SURFACE_ROW_MAX is 16 today, ~48 at compositor maturity, and
// even a hypothetical 2^32-slot pool leaves room for this sentinel).
// This choice also forces focus_init to run at boot: .bss zero-init
// would land _kbd_focus_slot at 0, i.e. "slot 0 focused" -- wrong
// unless a mint has actually happened.  focus_init is wired at
// kernel_main.pdx's boot cascade after kind_surface_init for that
// reason.
//
// -----------------------------------------------------------------------------
// FINGERPRINT ON TRANSITION (not on every set)
// -----------------------------------------------------------------------------
//
// focus_set_keyboard and focus_set_pointer emit the fingerprint only
// when the new slot differs from the current cell value.  A repeat set
// with the same slot is a no-op success (returns 0 without emitting).
// This mirrors surface_format.pdx's idempotency discipline
// (surface_format_bind_at_mint: first-bind emits, repeat-bind is
// silent) and keeps the fingerprint volume proportional to the number
// of actual refocus events, not to input-worker polling frequency.
//
// -----------------------------------------------------------------------------
// FAILURE TAXONOMY -- 0xFFFFE180..0xFFFFE18F (fresh band, grep-verified)
// -----------------------------------------------------------------------------
//
// The R113 R113.M1 sweep at design/graphics/r113-m1-substrate.md §5.1
// established the 0xFFFFE1XX page's occupancy.  Repeated targeted grep
// pre-landing (2026-09-08):
//
//     $ grep -rn '0xFFFFE18' src -> empty
//
// so 0xFFFFE180..0xFFFFE18F is a fresh, uncontested band.  Neighbouring
// bands (established at R113.M1 landings):
//
//   0xFFFFE110..E11F  R113.M1-001 KIND_SURFACE substrate
//   0xFFFFE120..E12F  R113.M1-004 kernel-side surface_format
//   0xFFFFE130..E13F  ROUTE_REVOKE (src/user/input_server/route_revoke.pdx)
//   0xFFFFE140..E14F  SEAT_LOCK    (src/user/input_server/seat_lock.pdx)
//   0xFFFFE150..E15F  R113.M1-005 SURFACE PRESENT
//   0xFFFFE160..E17F  entirely free
//   0xFFFFE180..E18F  R113.M2-011 FOCUS (THIS FILE)
//
// Slot map:
//
//   0xFFFFE180  FOCUS_BAD_SLOT          slot fails surface_row_valid
//   0xFFFFE181  FOCUS_ALREADY_GRABBED   focus_grab called with a grab
//                                       still in flight (button-up
//                                       must run first).
//   0xFFFFE182  FOCUS_NOT_GRABBED       focus_ungrab called with no
//                                       grab pending.
//   0xFFFFE183..0xFFFFE18F              reserved for M2 follow-on
//                                       (per-seat focus, focus-locked
//                                       keyboard-grab, gesture claim,
//                                       etc.)
//
// -----------------------------------------------------------------------------
// FINGERPRINT ALLOWLIST
// -----------------------------------------------------------------------------
//
// The tags "focus kbd ok [legacy: FOCUS KBD OK]" and
// "focus ptr ok [legacy: FOCUS PTR OK]" are the transition emitters.
// Both are unreachable in the default 14-mode QEMU matrix today (no
// boot witness calls focus_set_*; the first live caller is the input
// dispatcher landing that consumes hid_kbd_attach's Transfer Event
// path, blocked on MSI-X routing for xHCI -- see
// drivers/xhci/hid_kbd_attach.pdx §IRQ path).  Two entries in
// tools/verify-fingerprint-coverage.sh point at this file with the
// same "input-server wire deferred" posture the HID KBD ATTACH OK
// sibling uses.
//
// -----------------------------------------------------------------------------
// RIGHTS GATING -- OWNED BY THE INPUT DISPATCHER, NOT HERE
// -----------------------------------------------------------------------------
//
// These bodies do NOT check rights.  focus_set_* / focus_grab /
// focus_ungrab are kernel-internal only; no cap_invoke arm dispatches
// to them.  The input dispatcher landing will gate on
// R_SURFACE_KGATE_QUERY (kind_surface.pdx §3.2) or a dedicated
// R_INPUT_ROUTE right before calling in.  Same discipline as
// surface_present_notify (surface_present.pdx §RIGHTS GATING).
//
// -----------------------------------------------------------------------------
// ENCODER PITFALLS (per feedback_pdx_encoder_pitfalls v0.36+)
// -----------------------------------------------------------------------------
//
//   * No `test rN, rN` -- every zero-check uses `cmp rN, 0` + `je/jne`.
//   * No 2-op `imul r, imm` -- no row-index arithmetic in this file.
//   * No `and reg, imm64` -- FOCUS_NONE (0xFFFFFFFFFFFFFFFF) staged
//     into a scratch register via `mov r64, imm64` (movabs), never
//     used as an `and`/`cmp` immediate directly.
//   * No `cmp reg, [mem]` -- every mem compare loads to a scratch
//     first (surface_present.pdx L242 pattern).
//   * No literal-scaled `[reg + N*8]` -- only displacement form
//     `[reg + 0]` used for the three cells.
//   * No `mov qword [mem], imm64` -- FOCUS_NONE is written by loading
//     into rax via movabs then storing.
//
// -----------------------------------------------------------------------------
// LABEL PREFIX
// -----------------------------------------------------------------------------
//
// `fi_` = focus_init, `fsk_` = focus_set_keyboard, `fgk_` = focus_get_
// keyboard, `fsp_` = focus_set_pointer, `fgp_` = focus_get_pointer,
// `fg_` = focus_grab, `fu_` = focus_ungrab.  All prefixes avoid the
// paideia-as reserved keyword set (feedback_paideia_as_reserved_labels).

module Focus = structure {

  // ==========================================================================
  // Constants
  // ==========================================================================

  // FOCUS_NONE sentinel: outside u64 slot-id domain (SURFACE_ROW_MAX
  // is 16 today, ~48 at compositor maturity).  See file header
  // §"Why FOCUS_NONE = 0xFF..FF" for why zero is not a safe sentinel.
  pub let FOCUS_NONE            : u64 = 0xFFFFFFFFFFFFFFFF

  pub let FOCUS_OK              : u64 = 0
  pub let FOCUS_BAD_SLOT        : u64 = 0xFFFFE180
  pub let FOCUS_ALREADY_GRABBED : u64 = 0xFFFFE181
  pub let FOCUS_NOT_GRABBED     : u64 = 0xFFFFE182

  // ==========================================================================
  // Global focus-state cells (.bss, @align(8))
  //
  // Zero-init at .bss load is deliberately NOT the semantic identity;
  // focus_init must run at boot to latch the FOCUS_NONE sentinel into
  // all three cells.  See file header §"Why FOCUS_NONE = 0xFF..FF".
  // ==========================================================================

  pub let mut _kbd_focus_slot      : u64 = uninit @align(8)
  pub let mut _ptr_focus_slot      : u64 = uninit @align(8)
  pub let mut _implicit_grab_slot  : u64 = uninit @align(8)

  // ==========================================================================
  // Fingerprint tags (transition emitters)
  //
  // Wire form (post-klog_s1_x1 KV append):
  //   focus kbd ok [legacy: FOCUS KBD OK] sid=0x<hex>
  //   focus ptr ok [legacy: FOCUS PTR OK] sid=0x<hex>
  //
  // Byte counts verified by hand:
  //   "focus kbd ok [legacy: FOCUS KBD OK]\0" = 36 bytes
  //   "focus ptr ok [legacy: FOCUS PTR OK]\0" = 36 bytes
  //
  // KV key reused: surface_k_sid ("sid\0", 4 bytes) from
  // src/kernel/core/cap/kind_surface.pdx (declared at R113.M1-001,
  // #2381).  surface_present.pdx uses the same reuse pattern.
  // ==========================================================================

  pub let focus_kbd_msg : [u8; 36] = "focus kbd ok [legacy: FOCUS KBD OK]\0"
  pub let focus_ptr_msg : [u8; 36] = "focus ptr ok [legacy: FOCUS PTR OK]\0"

  // ==========================================================================
  // focus_init() -> ()
  //
  // Latch all three cells to FOCUS_NONE.  Called from kernel_main.pdx
  // immediately after kind_surface_init (which scrubs the surface row
  // pool to zero) so the surface substrate and its focus overlay stand
  // consistent at boot.  Zero-arg leaf; no callee-save clobber; only
  // touches rax + r10.
  // ==========================================================================

  pub let focus_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M2-011 (#2391): latch _kbd_focus_slot / _ptr_focus_slot / _implicit_grab_slot to FOCUS_NONE (0xFFFFFFFFFFFFFFFF).  Called from kernel_main.pdx after kind_surface_init.  FOCUS_NONE staged into rax via movabs (imm64) then stored -- no `mov qword [mem], imm64` form.  Straight-line, no branches, no nested calls; entry rsp%16==8 unchanged on return.  Labels prefixed fi_ (none needed).",
      block: {
        mov rax, 0xFFFFFFFFFFFFFFFF;      // FOCUS_NONE
        lea r10, [rip + _kbd_focus_slot];
        mov [r10 + 0], rax;
        lea r10, [rip + _ptr_focus_slot];
        mov [r10 + 0], rax;
        lea r10, [rip + _implicit_grab_slot];
        mov [r10 + 0], rax;
        ret
      }
    }

  // ==========================================================================
  // focus_set_keyboard(slot) -> u64
  //
  // Gate order:
  //   (1) if slot == current _kbd_focus_slot -> return 0 (no-op).
  //   (2) if slot != FOCUS_NONE, validate via surface_row_valid ->
  //       else FOCUS_BAD_SLOT (slot out-of-range or not in_use).
  //   (3) store slot into _kbd_focus_slot.
  //   (4) emit fingerprint FOCUS KBD OK sid=<slot>.
  //   (5) return 0.
  //
  // Passing FOCUS_NONE is legal and clears focus (no validation gate;
  // step (4) still emits so observers can see the unfocus transition).
  //
  // Register plan: one callee-save push (r12 = slot) sits at rsp%16==0
  // in the body (entry 8 + 8 = 16, %16=0), aligned for
  // surface_row_valid and klog_s1_x1 without further padding.
  // surface_row_valid and klog_s1_x1 both preserve r12 per SysV so the
  // slot survives to the emit.  Labels prefixed fsk_.
  // ==========================================================================

  pub let focus_set_keyboard : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R113.M2-011 (#2391): set keyboard-focus slot.  Gate order per file header: (1) no-op if slot == current cell (silent success, no emit); (2) validate via surface_row_valid unless slot == FOCUS_NONE (clear-focus arm); (3) store; (4) klog_s1_x1 FOCUS KBD OK sid=<slot>; (5) return 0.  FOCUS_NONE (0xFFFFFFFFFFFFFFFF) staged via movabs into r11 for the equality compare, never used as `cmp reg, imm64` directly.  One callee-save push (r12 = slot) aligns rsp%16=0 (entry 8 + 8 = 16) for both surface_row_valid and klog_s1_x1.  klog_s1_x1 preserves r12 per SysV so slot survives to emission.  Labels prefixed fsk_.",
      block: {
        push r12;
        mov r12, rdi;                     // r12 = new slot

        // (1) no-op if unchanged
        lea r10, [rip + _kbd_focus_slot];
        mov rax, [r10 + 0];
        cmp rax, r12;
        je  fsk_no_change;

        // (2) validate slot unless clearing (FOCUS_NONE)
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp r12, r11;
        je  fsk_store;                    // clear-focus arm skips validation

        mov rdi, r12;
        call surface_row_valid;
        cmp rax, 0;
        je  fsk_bad_slot;

      fsk_store:
        // (3) write new cell
        lea r10, [rip + _kbd_focus_slot];
        mov [r10 + 0], r12;

        // (4) emit fingerprint FOCUS KBD OK sid=<slot>
        mov rdi, 3;                       // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + focus_kbd_msg];
        lea rcx, [rip + surface_k_sid];
        mov r8, r12;                      // sid = slot
        call klog_s1_x1;

      fsk_no_change:
        // (5) return 0
        xor rax, rax;
        jmp fsk_out;

      fsk_bad_slot:
        mov rax, 0xFFFFE180;              // FOCUS_BAD_SLOT

      fsk_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // focus_get_keyboard() -> u64
  //
  // Non-blocking read of _kbd_focus_slot.  Returns FOCUS_NONE if no
  // keyboard focus is set.  Pure leaf; no push, no nested call.
  // ==========================================================================

  pub let focus_get_keyboard : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M2-011 (#2391): rip-relative load of _kbd_focus_slot.  Pure leaf; no callee-save; entry rsp%16=8 unchanged on ret.  Labels prefixed fgk_ (none needed).",
      block: {
        lea r10, [rip + _kbd_focus_slot];
        mov rax, [r10 + 0];
        ret
      }
    }

  // ==========================================================================
  // focus_set_pointer(slot) -> u64
  //
  // Symmetric to focus_set_keyboard; emits "FOCUS PTR" tag.  Same gate
  // order, same register plan, same alignment.  Labels prefixed fsp_.
  // ==========================================================================

  pub let focus_set_pointer : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R113.M2-011 (#2391): set pointer-focus slot.  Mirrors focus_set_keyboard byte-for-byte with focus_ptr_msg tag and _ptr_focus_slot cell.  Same alignment (one callee-save push, rsp%16==0 in body).  Labels prefixed fsp_.",
      block: {
        push r12;
        mov r12, rdi;                     // r12 = new slot

        // (1) no-op if unchanged
        lea r10, [rip + _ptr_focus_slot];
        mov rax, [r10 + 0];
        cmp rax, r12;
        je  fsp_no_change;

        // (2) validate slot unless clearing
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp r12, r11;
        je  fsp_store;

        mov rdi, r12;
        call surface_row_valid;
        cmp rax, 0;
        je  fsp_bad_slot;

      fsp_store:
        // (3) write new cell
        lea r10, [rip + _ptr_focus_slot];
        mov [r10 + 0], r12;

        // (4) emit fingerprint FOCUS PTR OK sid=<slot>
        mov rdi, 3;                       // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + focus_ptr_msg];
        lea rcx, [rip + surface_k_sid];
        mov r8, r12;                      // sid = slot
        call klog_s1_x1;

      fsp_no_change:
        xor rax, rax;
        jmp fsp_out;

      fsp_bad_slot:
        mov rax, 0xFFFFE180;              // FOCUS_BAD_SLOT

      fsp_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // focus_get_pointer() -> u64
  //
  // Non-blocking read of _ptr_focus_slot.  Pure leaf.
  // ==========================================================================

  pub let focus_get_pointer : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M2-011 (#2391): rip-relative load of _ptr_focus_slot.  Pure leaf; no callee-save.  Labels prefixed fgp_ (none needed).",
      block: {
        lea r10, [rip + _ptr_focus_slot];
        mov rax, [r10 + 0];
        ret
      }
    }

  // ==========================================================================
  // focus_grab(slot) -> u64
  //
  // Implicit-grab set (called on pointer-button-down).  Refuses if a
  // grab is already in flight -- button-up must run focus_ungrab first.
  //
  // Gate order:
  //   (1) if _implicit_grab_slot != FOCUS_NONE -> FOCUS_ALREADY_GRABBED.
  //   (2) validate slot via surface_row_valid -> else FOCUS_BAD_SLOT.
  //       (FOCUS_NONE is NOT a legal grab target; use focus_ungrab to
  //        clear.)
  //   (3) store slot into _implicit_grab_slot; return 0.
  //
  // No fingerprint emit -- the requirement (issue #2391 §3) mandates
  // transition tags only for KBD / PTR focus.  Grab state is an
  // implementation detail of pointer-event routing; a per-grab tag
  // would flood the wire on every mouse click.
  //
  // Register plan: one callee-save push (r12 = slot) aligns rsp%16==0
  // for the surface_row_valid call.  Labels prefixed fg_.
  // ==========================================================================

  pub let focus_grab : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M2-011 (#2391): implicit-grab set on button-down.  Gate order per file header: (1) refuse if grab already active (FOCUS_ALREADY_GRABBED) -- button-up must run focus_ungrab first; (2) validate slot (FOCUS_NONE is NOT a legal grab target -- callers use focus_ungrab to clear); (3) store.  No fingerprint emit per requirement (transition tags are KBD/PTR only).  FOCUS_NONE staged via movabs into r11 for the equality compare.  One callee-save push (r12 = slot) aligns rsp%16==0 for surface_row_valid.  Labels prefixed fg_.",
      block: {
        push r12;
        mov r12, rdi;                     // r12 = new slot

        // (1) refuse if already grabbed
        lea r10, [rip + _implicit_grab_slot];
        mov rax, [r10 + 0];
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne fg_already;

        // (2) validate slot
        mov rdi, r12;
        call surface_row_valid;
        cmp rax, 0;
        je  fg_bad_slot;

        // (3) store
        lea r10, [rip + _implicit_grab_slot];
        mov [r10 + 0], r12;
        xor rax, rax;
        jmp fg_out;

      fg_already:
        mov rax, 0xFFFFE181;              // FOCUS_ALREADY_GRABBED
        jmp fg_out;
      fg_bad_slot:
        mov rax, 0xFFFFE180;              // FOCUS_BAD_SLOT

      fg_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // focus_ungrab() -> u64
  //
  // Implicit-grab release (called on pointer-button-up).  Refuses with
  // FOCUS_NOT_GRABBED if no grab is active.
  //
  // Pure leaf: no push, no nested call, no fingerprint emit.  Labels
  // prefixed fu_.
  // ==========================================================================

  pub let focus_ungrab : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M2-011 (#2391): implicit-grab release on button-up.  Refuses with FOCUS_NOT_GRABBED (0xFFFFE182) if no grab is active; otherwise stores FOCUS_NONE and returns 0.  FOCUS_NONE staged via movabs into r11 for both the compare and the store (the store form `mov [mem], imm64` does not exist; r11 stays live as the write source).  Pure leaf; no callee-save; entry rsp%16=8 unchanged on ret.  Labels prefixed fu_.",
      block: {
        lea r10, [rip + _implicit_grab_slot];
        mov rax, [r10 + 0];
        mov r11, 0xFFFFFFFFFFFFFFFF;      // FOCUS_NONE
        cmp rax, r11;
        je  fu_not_grabbed;

        mov [r10 + 0], r11;               // clear grab (r11 = FOCUS_NONE)
        xor rax, rax;
        ret;

      fu_not_grabbed:
        mov rax, 0xFFFFE182;              // FOCUS_NOT_GRABBED
        ret
      }
    }

}
