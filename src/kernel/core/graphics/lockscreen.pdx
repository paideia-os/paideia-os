// src/kernel/core/graphics/lockscreen.pdx -- R113.M5-024 (paideia-os #2404)
//
// Mid-session compositor lock hook.  Freezes the compositor to a caller-
// registered lock surface, hides all other surfaces, and preserves their
// state for restore-on-dismiss.
//
// Umbrella: R113 (#2380).  Sits above:
//   * kind_session.pdx  (R113.M5-022, #2402) -- SESSION_STATE_LOCKED=3
//   * z_order.pdx       (R113.M2-010, #2390) -- _z_stack + push/remove/raise
//   * focus.pdx         (R113.M2-011, #2391) -- focus_set_keyboard
//   * kind_surface.pdx  (R113.M1-001, #2381) -- surface_row_valid
//
// -----------------------------------------------------------------------------
// SCOPE (per issue #2404)
// -----------------------------------------------------------------------------
//
// Four entry points:
//
//   * lockscreen_init()                        -- boot-time init; scrubs
//                                                 the four per-session
//                                                 substrate arrays and
//                                                 latches _lock_surface_
//                                                 slots to LOCK_SURFACE_
//                                                 NONE (0xFF..FF).  .bss
//                                                 zero-init would leave
//                                                 the surface cells at 0
//                                                 (aliasing valid surface
//                                                 slot 0), so this call
//                                                 is REQUIRED not just
//                                                 defensive -- same
//                                                 discipline focus_init
//                                                 uses.
//
//   * lockscreen_bind_surface(session_id,      -- register the surface
//                             surface_slot)       slot to be raised on
//                                                 lockscreen_engage.  The
//                                                 issue's engage(sid)
//                                                 signature mandates a
//                                                 pre-registered lock
//                                                 surface (mirrors the
//                                                 Wayland ext-session-
//                                                 lock-v1 protocol shape
//                                                 where the client
//                                                 attaches a surface to
//                                                 the lock role before
//                                                 requesting the
//                                                 compositor lock).
//
//   * lockscreen_engage(session_id)            -- freeze compositor:
//                                                 snapshot _z_stack into
//                                                 the per-session stash,
//                                                 remove every stashed
//                                                 slot from _z_stack,
//                                                 raise the bound lock
//                                                 surface, set keyboard
//                                                 focus to it, transition
//                                                 the session to
//                                                 SESSION_STATE_LOCKED,
//                                                 mark engaged, and emit
//                                                 LOCKSCREEN ENGAGE OK
//                                                 sid=<session_id>.
//
//   * lockscreen_dismiss(session_id)           -- on auth success:
//                                                 remove the lock
//                                                 surface from _z_stack,
//                                                 restore stashed
//                                                 slots via z_order_
//                                                 push_top (order-
//                                                 preserving because
//                                                 push_top appends at
//                                                 the frontmost end),
//                                                 transition the session
//                                                 to SESSION_STATE_
//                                                 ACTIVE, clear engaged,
//                                                 and emit LOCKSCREEN
//                                                 DISMISS OK sid=<n>.
//
// -----------------------------------------------------------------------------
// STATE PRESERVATION SEMANTIC
// -----------------------------------------------------------------------------
//
// "Hide all other surfaces but preserve their state for unlock" is
// implemented by removing the surfaces from _z_stack.  The composite
// planner (composite_plan.pdx) walks _z_stack top-down; a surface
// absent from the stack is not drawn.  The surface ROW (buffer, damage
// region, format, subsurface tree) is not touched -- state preservation
// is by construction.  On dismiss the stashed slot list is pushed back
// onto _z_stack in original order, restoring both membership and paint
// order.
//
// A slot in the snapshot that no longer resolves to a valid surface at
// dismiss time (surface destroyed during the lock window) will return
// Z_ORDER_BAD_SLOT from z_order_push_top; the restore loop swallows
// that per-slot error and continues.  Best-effort restore is the
// correct posture: the caller does not expect a lock to keep destroyed
// surfaces alive, and returning an error from dismiss because one
// surface vanished mid-lock would strand the session in LOCKED state
// with no path to ACTIVE.
//
// If a NEW surface was created and pushed on _z_stack during the lock
// window (e.g. a lock-agent child surface for the password prompt),
// it is left in _z_stack post-dismiss along with the restored original
// entries.  This is the honest semantic: the dismiss restores the
// snapshot but does not scrub post-snapshot additions.
//
// -----------------------------------------------------------------------------
// PER-SESSION SUBSTRATE
// -----------------------------------------------------------------------------
//
// Four arrays indexed by session_id (== KIND_SESSION row_id, in [0,
// SESSION_ROW_MAX=16)):
//
//   _lock_surface_slots[16]  -- bound lock surface slot, or LOCK_SURFACE_
//                               NONE (0xFF..FF) when no bind is in
//                               force.  Requires latch at boot (zero
//                               would alias surface slot 0).
//   _lock_stash_slots[16*16] -- 16 rows of 16 slots each; _lock_stash_
//                               slots[session_id * 16 + i] holds the
//                               i-th slot of the pre-engage _z_stack
//                               snapshot for that session.  Zero at
//                               boot is fine; unread until an engage
//                               populates it.
//   _lock_stash_counts[16]   -- snapshot depth per session.  Zero at
//                               boot is fine; matches "no snapshot".
//   _lock_engaged[16]        -- 0 = idle, 1 = engaged.  Zero at boot
//                               is fine; matches "not locked".
//
// LOCK_STASH_MAX matches Z_STACK_MAX (16) one-for-one so a snapshot of
// a full z-stack always fits.  R113.M2-010's file header notes both
// constants will be bumped together to ~48 at compositor maturity.
//
// -----------------------------------------------------------------------------
// FINGERPRINT (per issue #2404)
// -----------------------------------------------------------------------------
//
// Wire form (post-klog_s1_x1 KV append):
//
//   lockscreen engage ok [legacy: LOCKSCREEN ENGAGE OK] sid=0x<hex>
//   lockscreen dismiss ok [legacy: LOCKSCREEN DISMISS OK] sid=0x<hex>
//
// Byte counts verified by hand:
//   "lockscreen engage ok [legacy: LOCKSCREEN ENGAGE OK]\0"  = 52 bytes
//   "lockscreen dismiss ok [legacy: LOCKSCREEN DISMISS OK]\0" = 54 bytes
//
// KV key reused: session_k_sid ("sid\0", 4 bytes) from kind_session.pdx
// -- this is a session_id, semantically distinct from surface_k_sid's
// surface-slot payload.  Same bare-symbol reuse pattern surface_
// present.pdx / focus.pdx / z_order.pdx use for their sid KV.
//
// Emitter reachability: unreachable in the default 14-mode QEMU matrix
// today.  The full engage/dismiss cascade requires a live session_mint
// (kind_session substrate; no boot witness drives it yet), a bound
// lock surface (compositor-side lock-agent landing not yet wired), and
// the input-server MSI-X wire (shared blocker with the focus / z_order
// siblings, drivers/xhci/hid_kbd_attach.pdx §IRQ path).  A tools/
// verify-fingerprint-coverage.sh allowlist entry mirrors the session
// mint / z_order raise / focus kbd posture.
//
// -----------------------------------------------------------------------------
// FAILURE TAXONOMY -- 0xFFFFE290..0xFFFFE29F (fresh band, per issue directive)
// -----------------------------------------------------------------------------
//
// Pre-landing sweep (2026-09-08):
//
//     $ grep -rn '0xFFFFE29' src design  ->  empty
//
// so 0xFFFFE290..0xFFFFE29F is fresh and uncontested.
//
//   0xFFFFE290 LOCK_BAD_SESSION     session_id fails session_row_valid
//                                   (out-of-range OR row not in_use)
//   0xFFFFE291 LOCK_BAD_SURFACE     bind called with a surface_slot
//                                   that fails surface_row_valid
//   0xFFFFE292 LOCK_NO_SURFACE      engage with no prior successful
//                                   bind for this session (cell still
//                                   LOCK_SURFACE_NONE)
//   0xFFFFE293 LOCK_ALREADY_ENGAGED engage on a session already engaged
//   0xFFFFE294 LOCK_NOT_ENGAGED     dismiss on a session not engaged
//   0xFFFFE295 LOCK_SESSION_SET     session_set_state returned non-zero
//                                   (session moved to EXITED between
//                                   engage/dismiss or state gate
//                                   otherwise refused); the visual
//                                   state has already been applied
//                                   when this fires, so callers see
//                                   the engaged/dismissed z-stack but
//                                   an error return
//   0xFFFFE296..0xFFFFE29F          reserved for M5 follow-on (per-
//                                   session lock policy, session-lock
//                                   protocol version negotiation,
//                                   inhibit / uninhibit, etc.)
//
// -----------------------------------------------------------------------------
// RIGHTS GATING -- OWNED BY THE FUTURE CAP DISPATCHER, NOT HERE
// -----------------------------------------------------------------------------
//
// These bodies do NOT check rights.  lockscreen_* are kernel-internal
// only; no cap_invoke arm dispatches to them today.  A follow-on
// KIND_LOCK_AGENT capability landing will gate on R_LOCK_ENGAGE /
// R_LOCK_DISMISS (or reuse R_SESSION_SET_STATE from kind_session.pdx
// §2) at the dispatcher edge.  Same discipline as focus.pdx / z_order.
// pdx / surface_present.pdx op bodies.
//
// -----------------------------------------------------------------------------
// ENCODER PITFALLS (per feedback_pdx_encoder_pitfalls v0.36+)
// -----------------------------------------------------------------------------
//
//   * No `test rN, rN` -- every zero-check uses `cmp rN, 0` + `je/jne`.
//   * No 2-op `imul r, imm` -- per-session stash offset (session_id *
//     128) computed via `shl r, 7`; per-slot offset within a row uses
//     the register-scaled SIB `[reg + rcx * 8]` (scale 8 in the legal
//     {1,2,4,8} set).
//   * No `and reg, imm64` -- no wide masks needed in this file.
//   * No `cmp reg, [mem]` -- every mem compare loads to a scratch
//     register first.
//   * No literal-scaled `[reg + N*8]` -- only displacement form
//     `[reg + 0]` for scalar cells, `[reg + 8N]` for per-session
//     scalar offsets (N < 8, fits an 8-bit disp), and register-scaled
//     `[reg + rN * 8]` for the stash walk.
//   * No `mov qword [mem], imm64` -- LOCK_SURFACE_NONE staged into a
//     register via `mov r64, imm64` (movabs) then stored.
//   * Multiline `pub let ="..."` refused -- both fingerprint literals
//     live on one source line each.
//   * Module name matches file basename: `Lockscreen` for `lockscreen.
//     pdx`.
//   * Fingerprint tag byte count computed by hand (52 for engage tag,
//     54 for dismiss tag) and asserted in the `[u8; N]` type
//     ascription.
//   * Reserved-keyword labels avoided (loop/if/let/while/for/match/
//     pub/mod/use/fn/struct/enum/impl/trait/type/where/move/mut/ref).
//     Label prefixes: `lsi_`, `lsbs_`, `lse_`, `lsd_`.
//
// -----------------------------------------------------------------------------
// STACK DISCIPLINE
// -----------------------------------------------------------------------------
//
// engage and dismiss both push three callee-saves (rbx = session_id,
// r12 = lock_surface_slot, r13 = scratch: snapshot count / loop idx)
// = 24 bytes on top of the entry 8-B misalignment lands rsp%16 == 0
// (entry 8 + 24 = 32) for every nested call -- session_row_valid,
// z_order_slot_at, z_order_remove, z_order_raise, z_order_push_top,
// focus_set_keyboard, session_set_state, klog_s1_x1.  All those
// callees preserve rbx / r12 / r13 per SysV.
//
// bind_surface pushes two callee-saves (rbx = session_id, r12 =
// surface_slot) + sub rsp, 8 for pad: 24 bytes total on top of entry
// 8-B misalignment -> rsp%16 == 0 for the surface_row_valid call.
//
// klog_s1_x1's callsite in engage/dismiss inherits the rsp%16 == 0
// posture from the three-push prologue: no extra pad needed (klog_s1_
// x1 is a normal SysV call, unlike klog_s1_x2's seventh-arg v2 push
// idiom).

module Lockscreen = structure {

  // ==========================================================================
  // SECTION 1 -- CONSTANTS
  // ==========================================================================

  pub let LOCK_STASH_MAX     : u64 = 16       // matches Z_STACK_MAX
  pub let LOCK_SESSION_MAX   : u64 = 16       // matches SESSION_ROW_MAX

  // Sentinel for "no lock surface bound" -- outside u64 slot-id domain
  // (SURFACE_ROW_MAX = 16 today, ~48 at compositor maturity).  Zero is
  // NOT safe here because surface slot 0 is a valid slot (surface_mint
  // low-first scan claims it for the first ever mint).  Same reasoning
  // as focus.pdx FOCUS_NONE.
  pub let LOCK_SURFACE_NONE  : u64 = 0xFFFFFFFFFFFFFFFF

  // ==========================================================================
  // SECTION 2 -- FAILURE TAXONOMY  0xFFFFE290..0xFFFFE29F
  // ==========================================================================

  pub let LOCK_OK              : u64 = 0
  pub let LOCK_BAD_SESSION     : u64 = 0xFFFFE290
  pub let LOCK_BAD_SURFACE     : u64 = 0xFFFFE291
  pub let LOCK_NO_SURFACE      : u64 = 0xFFFFE292
  pub let LOCK_ALREADY_ENGAGED : u64 = 0xFFFFE293
  pub let LOCK_NOT_ENGAGED     : u64 = 0xFFFFE294
  pub let LOCK_SESSION_SET     : u64 = 0xFFFFE295

  // ==========================================================================
  // SECTION 3 -- PER-SESSION SUBSTRATE
  // ==========================================================================
  //
  // _lock_surface_slots requires boot-time latching to LOCK_SURFACE_NONE
  // (see file header §PER-SESSION SUBSTRATE and §"WHY FOCUS_NONE" in
  // focus.pdx for the sentinel rationale).  The other three arrays are
  // zero-init-safe.

  pub let mut _lock_surface_slots : [u64; 16]  = uninit @align(64)
  pub let mut _lock_stash_slots   : [u64; 256] = uninit @align(64)
  pub let mut _lock_stash_counts  : [u64; 16]  = uninit @align(64)
  pub let mut _lock_engaged       : [u64; 16]  = uninit @align(64)

  // ==========================================================================
  // SECTION 4 -- FINGERPRINT TAGS
  // ==========================================================================
  //
  // Byte counts verified by hand (file header §FINGERPRINT).  Both tags
  // live on one source line each (multiline `pub let ="..."` refused
  // by the encoder per feedback_pdx_encoder_pitfalls).  KV key
  // session_k_sid ("sid\0", 4 bytes) reused from kind_session.pdx by
  // bare-symbol lookup.

  pub let lockscreen_engage_msg  : [u8; 52] = "lockscreen engage ok [legacy: LOCKSCREEN ENGAGE OK]\0"
  pub let lockscreen_dismiss_msg : [u8; 54] = "lockscreen dismiss ok [legacy: LOCKSCREEN DISMISS OK]\0"

  // ==========================================================================
  // SECTION 5 -- lockscreen_init() -> ()
  //
  // Latch _lock_surface_slots to LOCK_SURFACE_NONE (16 * 8 = 128 B
  // written).  Defensively scrub _lock_stash_slots (256 u64 = 2 KiB),
  // _lock_stash_counts (16 u64 = 128 B), and _lock_engaged (16 u64 =
  // 128 B) -- all three are zero-init-safe at .bss but the scrub keeps
  // the chaos-restart witness re-scrub discipline uniform (mirrors
  // kind_surface_init / z_order_init / focus_init).
  //
  // Called from kernel_main.pdx after focus_init.  Zero-arg leaf; no
  // callee-save clobber; only touches rax, rcx, r10, r11.  Labels
  // prefixed lsi_.
  // ==========================================================================

  pub let lockscreen_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M5-024 (#2404): latch _lock_surface_slots to LOCK_SURFACE_NONE (0xFF..FF) -- zero-init would alias valid surface slot 0.  Defensive scrub of _lock_stash_slots (256 u64), _lock_stash_counts (16 u64), _lock_engaged (16 u64) mirrors kind_surface_init / z_order_init / focus_init discipline.  Straight-line loops using [reg + rcx * 8] register-scaled SIB (scale 8 in the legal {1,2,4,8} set).  LOCK_SURFACE_NONE staged into r11 via movabs then stored (no `mov qword [mem], imm64` form).  Zero-arg leaf, no callee-save clobber; entry rsp%16=8 unchanged on return.  Labels prefixed lsi_.",
      block: {
        // Latch _lock_surface_slots[16] to LOCK_SURFACE_NONE
        mov r11, 0xFFFFFFFFFFFFFFFF;
        lea r10, [rip + _lock_surface_slots];
        xor rcx, rcx;
      lsi_surfaces:
        mov [r10 + rcx * 8], r11;
        add rcx, 1;
        cmp rcx, 16;
        jb  lsi_surfaces;

        // Scrub _lock_stash_slots[256] to zero
        xor rax, rax;
        lea r10, [rip + _lock_stash_slots];
        xor rcx, rcx;
      lsi_stash:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 256;
        jb  lsi_stash;

        // Scrub _lock_stash_counts[16] to zero
        lea r10, [rip + _lock_stash_counts];
        xor rcx, rcx;
      lsi_counts:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 16;
        jb  lsi_counts;

        // Scrub _lock_engaged[16] to zero
        lea r10, [rip + _lock_engaged];
        xor rcx, rcx;
      lsi_engaged:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 16;
        jb  lsi_engaged;

        ret
      }
    }

  // ==========================================================================
  // SECTION 6 -- lockscreen_bind_surface(session_id, surface_slot) -> u64
  //
  // Register the surface slot the compositor should raise on
  // lockscreen_engage for this session.  The bound slot survives across
  // engage/dismiss cycles until a subsequent bind replaces it; callers
  // that rotate the lock surface between locks re-bind before each
  // engage.
  //
  // Gate order:
  //   (1) session_row_valid(session_id) -> else LOCK_BAD_SESSION
  //   (2) surface_row_valid(surface_slot) -> else LOCK_BAD_SURFACE
  //   (3) _lock_surface_slots[session_id] = surface_slot; return 0
  //
  // No fingerprint emit (bind is a pure config op, not a state
  // transition observers care about; engage is the state-visible tag).
  //
  // Register plan: push rbx (session_id) + push r12 (surface_slot) +
  // sub rsp, 8 for pad = 24 bytes; entry 8 + 24 = 32 -> rsp%16 = 0 for
  // both session_row_valid and surface_row_valid.  Labels prefixed
  // lsbs_.
  // ==========================================================================

  pub let lockscreen_bind_surface : (u64, u64) -> u64 !{mem} @{cap} =
    fn (session_id: u64) (surface_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R113.M5-024 (#2404): register lock surface for session.  Gate order per file header: (1) session_row_valid else LOCK_BAD_SESSION; (2) surface_row_valid else LOCK_BAD_SURFACE; (3) store into _lock_surface_slots[session_id].  Two callee-save pushes + sub rsp, 8 pad land rsp%16=0 for both nested validation calls.  Per-session offset computed via `mov r11, session_id; shl r11, 3` (session_id * 8 for the u64-indexed cell), no 2-op imul.  No fingerprint emit (bind is a config op, engage is the state-visible tag).  Labels prefixed lsbs_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        mov rbx, rdi;                     // rbx = session_id
        mov r12, rsi;                     // r12 = surface_slot

        // (1) validate session
        mov rdi, rbx;
        call session_row_valid;
        cmp rax, 0;
        je  lsbs_bad_session;

        // (2) validate surface
        mov rdi, r12;
        call surface_row_valid;
        cmp rax, 0;
        je  lsbs_bad_surface;

        // (3) store: _lock_surface_slots[session_id] = surface_slot
        lea r10, [rip + _lock_surface_slots];
        mov r11, rbx;
        shl r11, 3;                       // session_id * 8
        add r10, r11;
        mov [r10 + 0], r12;

        xor rax, rax;                     // LOCK_OK
        jmp lsbs_out;

      lsbs_bad_session:
        mov rax, 0xFFFFE290;              // LOCK_BAD_SESSION
        jmp lsbs_out;
      lsbs_bad_surface:
        mov rax, 0xFFFFE291;              // LOCK_BAD_SURFACE

      lsbs_out:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION 7 -- lockscreen_engage(session_id) -> u64
  //
  // Freeze compositor: snapshot z-stack, hide all other surfaces, raise
  // the bound lock surface, focus it, transition session to LOCKED.
  //
  // Gate order:
  //   (1) session_row_valid(session_id)          -> else LOCK_BAD_SESSION
  //   (2) _lock_engaged[session_id] == 0         -> else LOCK_ALREADY_ENGAGED
  //   (3) _lock_surface_slots[session_id] !=
  //        LOCK_SURFACE_NONE                     -> else LOCK_NO_SURFACE
  //   (4) snapshot: for i in 0.._z_stack_count:
  //         _lock_stash_slots[sid*16 + i] = _z_stack[i]
  //       store _z_stack_count into _lock_stash_counts[sid]
  //   (5) dismantle: for i in 0..snapshot_count:
  //         z_order_remove(_lock_stash_slots[sid*16 + i])  // best-effort
  //   (6) z_order_raise(lock_surface_slot)      // auto-adds if absent
  //   (7) focus_set_keyboard(lock_surface_slot)
  //   (8) session_set_state(session_id, SESSION_STATE_LOCKED=3)
  //         -- if non-zero, latch LOCK_SESSION_SET as the return but
  //         complete steps (9) and (10) so state stays consistent
  //   (9) _lock_engaged[session_id] = 1
  //  (10) klog LOCKSCREEN ENGAGE OK sid=<session_id>
  //  (11) return 0 (or LOCK_SESSION_SET from step 8)
  //
  // Note on step (5): iterating a snapshot of slot VALUES (not indices)
  // makes the remove order-independent; each remove shifts _z_stack
  // internally but does not affect the snapshot we walk.  Any snapshot
  // slot z_order_remove returns non-OK for (Z_ORDER_BAD_SLOT / NOT_
  // PRESENT) is a best-effort skip -- can happen if the surface was
  // destroyed between snapshot and remove, or if two consecutive
  // snapshot entries pointed at the same slot (z_order_push_top rejects
  // duplicates so this cannot happen in practice, but the code is
  // defensive against it).
  //
  // Note on step (6): z_order_raise auto-adds the lock surface if it
  // was not in the snapshot (typical case: lock surface was not part
  // of the shell z-stack).  If it WAS in the snapshot, it was removed
  // in step (5) and re-added here.  Net post-state: _z_stack contains
  // exactly [lock_surface_slot].
  //
  // Register plan: push rbx (session_id) + push r12 (lock_surface_slot)
  // + push r13 (count / index scratch) = 24 bytes; entry 8 + 24 = 32
  // -> rsp%16 = 0 for every nested call.  All nested callees preserve
  // rbx / r12 / r13 per SysV.  Labels prefixed lse_.
  // ==========================================================================

  pub let lockscreen_engage : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (session_id: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R113.M5-024 (#2404): mid-session compositor lock.  Gate order per file header: (1) session_row_valid; (2) not already engaged; (3) lock surface bound; (4) snapshot _z_stack into per-session stash; (5) dismantle current z-stack by removing each stashed slot (best-effort per slot); (6) z_order_raise(lock_surface) -- auto-adds; (7) focus_set_keyboard(lock_surface); (8) session_set_state(id, LOCKED=3); (9) mark engaged; (10) klog LOCKSCREEN ENGAGE OK sid=<n>; (11) return 0 (or LOCK_SESSION_SET if step 8 refused).  Three callee-save pushes (rbx=session_id, r12=lock_surface_slot, r13=count/idx scratch) land rsp%16=0 (entry 8 + 24 = 32) for every nested call.  Per-session stash base computed via `mov r11, rbx; shl r11, 7` (session_id * 128), no 2-op imul.  Per-slot access uses register-scaled SIB [r10 + rcx * 8].  klog_s1_x1 is a normal SysV call (no v2-push idiom needed).  Labels prefixed lse_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                     // rbx = session_id

        // (1) validate session
        mov rdi, rbx;
        call session_row_valid;
        cmp rax, 0;
        je  lse_bad_session;

        // (2) not already engaged: load _lock_engaged[session_id]
        lea r10, [rip + _lock_engaged];
        mov r11, rbx;
        shl r11, 3;
        add r10, r11;
        mov rax, [r10 + 0];
        cmp rax, 0;
        jne lse_already;

        // (3) surface bound: load _lock_surface_slots[session_id]
        lea r10, [rip + _lock_surface_slots];
        mov r11, rbx;
        shl r11, 3;
        add r10, r11;
        mov r12, [r10 + 0];                // r12 = lock_surface_slot
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp r12, r11;
        je  lse_no_surface;

        // (4) snapshot: read _z_stack_count, then copy _z_stack[0..count]
        //     into _lock_stash_slots[session_id*16 + 0..count]
        lea r10, [rip + _z_stack_count];
        mov r13, [r10 + 0];                // r13 = z_stack count

        // Store snapshot depth into _lock_stash_counts[session_id]
        lea r10, [rip + _lock_stash_counts];
        mov r11, rbx;
        shl r11, 3;
        add r10, r11;
        mov [r10 + 0], r13;                // _lock_stash_counts[sid] = count

        // Copy loop
        xor rcx, rcx;                      // rcx = i
      lse_snap:
        cmp rcx, r13;
        jae lse_snap_done;

        // r9 = _z_stack[i]
        lea r10, [rip + _z_stack];
        mov r9, [r10 + rcx * 8];

        // dst = &_lock_stash_slots + session_id * 128 + i * 8
        lea r10, [rip + _lock_stash_slots];
        mov r11, rbx;
        shl r11, 7;                        // session_id * 128
        add r10, r11;
        mov [r10 + rcx * 8], r9;

        add rcx, 1;
        jmp lse_snap;
      lse_snap_done:

        // (5) dismantle: for i in 0..r13:
        //       z_order_remove(_lock_stash_slots[session_id*16 + i])
        //     r13 stays live as the snapshot count; use r14... no, we
        //     only pushed 3 callee-saves.  Reuse rcx as the loop idx
        //     (nested call clobbers rcx per SysV; reload each iter).
        xor rcx, rcx;
      lse_dismantle:
        cmp rcx, r13;
        jae lse_dismantle_done;

        // Load slot from stash into rdi
        lea r10, [rip + _lock_stash_slots];
        mov r11, rbx;
        shl r11, 7;
        add r10, r11;
        mov rdi, [r10 + rcx * 8];

        // Save rcx across the call (z_order_remove uses one callee-save
        // internally; rcx is caller-save, so restack via r13...) --
        // simpler: push/pop rcx across the call.  Costs 16 B per iter
        // but keeps register accounting local.
        push rcx;
        push r13;                          // pad to keep rsp%16=0
        call z_order_remove;
        pop  r13;
        pop  rcx;
        // Return value swallowed (best-effort: Z_ORDER_NOT_PRESENT or
        // Z_ORDER_BAD_SLOT on a snapshot slot that has since been
        // removed / destroyed is not fatal here).

        add rcx, 1;
        jmp lse_dismantle;
      lse_dismantle_done:

        // (6) z_order_raise(lock_surface_slot) -- auto-adds if absent
        mov rdi, r12;
        call z_order_raise;

        // (7) focus_set_keyboard(lock_surface_slot)
        //     focus_set_keyboard itself side-effects into z_order_raise
        //     (fsk_store arm), which is idempotent-for-array-contents
        //     when the slot is already the frontmost entry -- so calling
        //     both raise then set_keyboard is safe (raise fires; the
        //     inner raise from set_keyboard is a no-op-for-array + one
        //     extra Z ORDER RAISE OK fingerprint emit).  We accept the
        //     duplicate emit for correctness: the caller-visible
        //     invariant is "keyboard focus is on lock surface AND lock
        //     surface is frontmost" and both calls together assert
        //     that, without either being able to drop.
        mov rdi, r12;
        call focus_set_keyboard;

        // (8) session_set_state(session_id, SESSION_STATE_LOCKED=3)
        //     Latch return into r13 (scratch: no longer holds snapshot
        //     count after this point) for the (11) return path.
        mov rdi, rbx;
        mov rsi, 3;                        // SESSION_STATE_LOCKED
        call session_set_state;
        mov r13, rax;                      // r13 = state-set result

        // (9) _lock_engaged[session_id] = 1
        lea r10, [rip + _lock_engaged];
        mov r11, rbx;
        shl r11, 3;
        add r10, r11;
        mov rax, 1;
        mov [r10 + 0], rax;

        // (10) klog LOCKSCREEN ENGAGE OK sid=<session_id>
        mov rdi, 3;                        // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + lockscreen_engage_msg];
        lea rcx, [rip + session_k_sid];
        mov r8, rbx;                       // sid = session_id
        call klog_s1_x1;

        // (11) return 0 unless step (8) refused
        cmp r13, 0;
        jne lse_state_fail;
        xor rax, rax;                      // LOCK_OK
        jmp lse_out;

      lse_state_fail:
        mov rax, 0xFFFFE295;               // LOCK_SESSION_SET
        jmp lse_out;

      lse_bad_session:
        mov rax, 0xFFFFE290;               // LOCK_BAD_SESSION
        jmp lse_out;
      lse_already:
        mov rax, 0xFFFFE293;               // LOCK_ALREADY_ENGAGED
        jmp lse_out;
      lse_no_surface:
        mov rax, 0xFFFFE292;               // LOCK_NO_SURFACE

      lse_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION 8 -- lockscreen_dismiss(session_id) -> u64
  //
  // On auth success: unfreeze compositor, restore stashed z-stack,
  // transition session to ACTIVE.
  //
  // Gate order:
  //   (1) session_row_valid(session_id)          -> else LOCK_BAD_SESSION
  //   (2) _lock_engaged[session_id] == 1         -> else LOCK_NOT_ENGAGED
  //   (3) z_order_remove(lock_surface_slot)     // best-effort strip
  //   (4) restore: for i in 0.._lock_stash_counts[sid]:
  //         z_order_push_top(_lock_stash_slots[sid*16 + i])
  //         -- best-effort: BAD_SLOT / STACK_FULL / ALREADY_PRESENT are
  //         swallowed; a snapshot slot whose surface was destroyed
  //         during the lock returns BAD_SLOT and the restore skips it.
  //   (5) session_set_state(session_id, SESSION_STATE_ACTIVE=2)
  //         -- if non-zero, latch LOCK_SESSION_SET as the return
  //   (6) _lock_engaged[session_id] = 0
  //   (7) _lock_stash_counts[session_id] = 0
  //   (8) klog LOCKSCREEN DISMISS OK sid=<session_id>
  //   (9) return 0 (or LOCK_SESSION_SET from step 5)
  //
  // The bound lock surface slot in _lock_surface_slots[session_id] is
  // deliberately NOT cleared here -- a subsequent engage on the same
  // session reuses the same lock surface without a re-bind.  Callers
  // that want to rotate the lock surface call bind_surface between
  // dismiss and the next engage.
  //
  // Register plan: identical shape to engage.  Labels prefixed lsd_.
  // ==========================================================================

  pub let lockscreen_dismiss : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (session_id: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R113.M5-024 (#2404): on auth success, unfreeze compositor and restore stashed z-stack.  Gate order per file header: (1) session_row_valid; (2) engaged; (3) z_order_remove(lock_surface) best-effort; (4) restore via z_order_push_top loop (best-effort per slot); (5) session_set_state(id, ACTIVE=2); (6) clear engaged; (7) clear stash count; (8) klog LOCKSCREEN DISMISS OK sid=<n>; (9) return 0 (or LOCK_SESSION_SET if step 5 refused).  Three callee-save pushes (rbx=session_id, r12=lock_surface_slot, r13=snapshot count / state-set result) land rsp%16=0 for every nested call.  Per-session stash base via `shl r11, 7`; per-cell offset via `shl r11, 3`.  klog_s1_x1 is a normal SysV call.  Bound lock surface deliberately NOT cleared -- a re-engage on the same session reuses it.  Labels prefixed lsd_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                     // rbx = session_id

        // (1) validate session
        mov rdi, rbx;
        call session_row_valid;
        cmp rax, 0;
        je  lsd_bad_session;

        // (2) engaged: load _lock_engaged[session_id]
        lea r10, [rip + _lock_engaged];
        mov r11, rbx;
        shl r11, 3;
        add r10, r11;
        mov rax, [r10 + 0];
        cmp rax, 0;
        je  lsd_not_engaged;

        // Load lock_surface_slot into r12 for the remove call
        lea r10, [rip + _lock_surface_slots];
        mov r11, rbx;
        shl r11, 3;
        add r10, r11;
        mov r12, [r10 + 0];                // r12 = lock_surface_slot

        // (3) z_order_remove(lock_surface_slot) -- best-effort
        mov rdi, r12;
        call z_order_remove;
        // return value swallowed

        // (4) restore loop: for i in 0..stash_count:
        //       z_order_push_top(_lock_stash_slots[sid*16 + i])
        // Load stash_count into r13.
        lea r10, [rip + _lock_stash_counts];
        mov r11, rbx;
        shl r11, 3;
        add r10, r11;
        mov r13, [r10 + 0];                // r13 = stash_count

        xor rcx, rcx;
      lsd_restore:
        cmp rcx, r13;
        jae lsd_restore_done;

        // Load slot from stash into rdi
        lea r10, [rip + _lock_stash_slots];
        mov r11, rbx;
        shl r11, 7;                        // session_id * 128
        add r10, r11;
        mov rdi, [r10 + rcx * 8];

        // Save rcx across the call (caller-save; push/pop discipline)
        push rcx;
        push r13;                          // pad to keep rsp%16=0
        call z_order_push_top;
        pop  r13;
        pop  rcx;
        // return value swallowed (BAD_SLOT / STACK_FULL / ALREADY_
        // PRESENT are best-effort per file header)

        add rcx, 1;
        jmp lsd_restore;
      lsd_restore_done:

        // (5) session_set_state(session_id, SESSION_STATE_ACTIVE=2)
        //     Latch return into r13 (scratch: stash_count no longer
        //     needed) for the (9) return path.
        mov rdi, rbx;
        mov rsi, 2;                        // SESSION_STATE_ACTIVE
        call session_set_state;
        mov r13, rax;                      // r13 = state-set result

        // (6) _lock_engaged[session_id] = 0
        lea r10, [rip + _lock_engaged];
        mov r11, rbx;
        shl r11, 3;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0], rax;

        // (7) _lock_stash_counts[session_id] = 0
        lea r10, [rip + _lock_stash_counts];
        mov r11, rbx;
        shl r11, 3;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0], rax;

        // (8) klog LOCKSCREEN DISMISS OK sid=<session_id>
        mov rdi, 3;                        // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + lockscreen_dismiss_msg];
        lea rcx, [rip + session_k_sid];
        mov r8, rbx;                       // sid = session_id
        call klog_s1_x1;

        // (9) return 0 unless step (5) refused
        cmp r13, 0;
        jne lsd_state_fail;
        xor rax, rax;                      // LOCK_OK
        jmp lsd_out;

      lsd_state_fail:
        mov rax, 0xFFFFE295;               // LOCK_SESSION_SET
        jmp lsd_out;

      lsd_bad_session:
        mov rax, 0xFFFFE290;               // LOCK_BAD_SESSION
        jmp lsd_out;
      lsd_not_engaged:
        mov rax, 0xFFFFE294;               // LOCK_NOT_ENGAGED

      lsd_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

}
