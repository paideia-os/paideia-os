// src/kernel/core/graphics/damage_region.pdx -- R113.M1-003 (paideia-os #2383)
//
// Per-surface multi-rect damage region with edge-adjacent / overlap
// coalescing.  Design authority: design/graphics/r113-m1-substrate.md
// (FROZEN 2026-09-08).  Sibling of R113.M1-001 (kind_surface.pdx,
// #2381 substrate) and R113.M1-002 (surface_commit_ops.pdx, #2382).
//
// -----------------------------------------------------------------------------
// SCOPE (per issue #2383 + doc §9 M1-003 line)
// -----------------------------------------------------------------------------
//
// M1-002 landed a single-rect damage union on the KIND_SURFACE row at
// byte offset +48 (doc §2 damage layout: dx[15:0] | dy[31:16] |
// dw[47:32] | dh[63:48]).  That storage remains as the pending-damage
// bounding-box summary consumed at commit.  M1-003 formalizes the
// upstream compositor-facing surface: accumulate N per-frame rects,
// coalesce adjacent/overlapping ones, cap at DMG_RECTS_PER_SURFACE.
//
// Doc §2 froze the surface row layout at 64 bytes / 8 u64 words with
// no room for a per-rect array; extending the row is refused.  M1-003
// therefore lands the region as a SIDE TABLE indexed by surface_slot:
//
//     _damage_regions : [u64; 128]  = 16 surfaces * 8 rects * 8 bytes = 1 KiB
//     _damage_counts  : [u64; 16]   = per-surface valid-rect count
//
// Total working set: 1 KiB + 128 B = 1.125 KiB.  Both blocks are
// 64-byte aligned; the region table lands on a cache-line boundary
// per surface (each 8-rect strip = 64 bytes).  The 16-slot dimension
// mirrors SURFACE_ROW_MAX (doc §6) and will scale in lockstep when
// R113.M2's window-manager work bumps the surface pool.
//
// -----------------------------------------------------------------------------
// COALESCE CRITERION (task requirement §5)
// -----------------------------------------------------------------------------
//
// Two rects A and B coalesce iff their edge-inclusive bounding boxes
// intersect on both axes:
//
//     horizontal_touch = (A.x + A.w) >= B.x  AND  (B.x + B.w) >= A.x
//     vertical_touch   = (A.y + A.h) >= B.y  AND  (B.y + B.h) >= A.y
//     coalesce         = horizontal_touch  AND  vertical_touch
//
// Note the >= (not >): edge-touching rects coalesce, corner-touching
// rects coalesce.  The union is the axis-aligned bounding box of the
// two.  This is the standard bbox-union tradeoff every damage-region
// compressor (weston, wayfire, mutter) makes: precision for space.
// The bbox may include a small strip of pixels neither original
// touched, but the compositor always redraws a superset of the true
// damage, which is correctness-safe.  L-shaped regions collapse to
// the enclosing rect; per-scanline damage would need a segment tree
// out of scope for M1-003.
//
// -----------------------------------------------------------------------------
// SATURATION FALLBACK
// -----------------------------------------------------------------------------
//
// When the region already holds DMG_RECTS_PER_SURFACE (8) rects and
// the incoming rect does NOT coalesce with any of them, the region
// is auto-folded: compute the bounding box of all 8 existing rects
// plus the new one, replace rect[0] with that fold, set count=1.
// The compositor never sees a saturation error -- it just sees a
// coarser (whole-region) invalidation on the next damage read.  This
// matches the wayland / wlroots per-surface damage semantics and
// keeps the add() ABI single-return-arm (no SATURATED code needed
// in the failure taxonomy).
//
// -----------------------------------------------------------------------------
// FAILURE TAXONOMY -- 0xFFFFE160..0xFFFFE16F (fresh band)
// -----------------------------------------------------------------------------
//
// Task briefing forbid 0xFFFFE110..E12F (M1-001 substrate +
// M1-004 format negotiation).  Neighbouring bands:
//
//   0xFFFFE110..E11F  R113.M1-001 substrate (kind_surface.pdx §5)
//   0xFFFFE120..E12F  R113.M1-004 format negotiation (surface_format.pdx)
//   0xFFFFE130..E13F  ROUTE_REVOKE (input_server/route_revoke.pdx)
//   0xFFFFE140..E14F  SEAT_LOCK (input_server/seat_lock.pdx)
//   0xFFFFE150..E15F  R113.M1-005 present-fence (surface_present.pdx)
//
// Freshness sweep (2026-09-08):
//   $ grep -rn '0xFFFFE16' src -> only the surface_present.pdx map
//     comment ("0xFFFFE160..E1FF entirely free (verified 2026-09-08)")
//   No live code in 0xFFFFE160..0xFFFFE16F.  Band claimed.
//
//   0xFFFFE160  DMG_BAD_SLOT       slot >= SURFACE_ROW_MAX or dead
//   0xFFFFE161  DMG_BAD_ARG        w == 0 || h == 0 || any coord > 0xFFFF
//   0xFFFFE162..0xFFFFE16F        reserved for M1-003 follow-on
//
// -----------------------------------------------------------------------------
// FINGERPRINT
// -----------------------------------------------------------------------------
//
// No new fingerprint tag.  Damage is a per-frame, high-volume path
// (up to hundreds of add() calls per composited frame at 240 Hz);
// emitting a klog tag on each add would flood the ring buffer and
// mask real events.  The commit-txn body (surface_commit_ops.pdx
// scm_) already emits SURFACE COMMIT OK on every swap, which is the
// user-observable boundary for damage clearing.  Damage add/clear
// discipline is verified by (a) the callee's return-code discipline
// (DMG_OK on success, DMG_BAD_* on refusal) and (b) the boot witness
// that will land alongside R113.M2 damage integration.
//
// -----------------------------------------------------------------------------
// ENCODER PITFALLS (per feedback_pdx_encoder_pitfalls v0.36+)
// -----------------------------------------------------------------------------
//
//   * No `test rN, rN` -- every zero-check uses `cmp rN, 0` + `je/jne`.
//   * No 2-op `imul r, imm` -- slot-to-byte math via `shl r, 6`
//     (slot * 64 = slot * DMG_RECTS_PER_SURFACE * 8).
//   * No `and reg, imm64` -- rect-field masks use `and reg, 0xFFFF`
//     which encodes as imm32=0x0000FFFF (sign bit clear at bit 31,
//     safe per surface_commit_ops.pdx L269 precedent).
//   * No `cmp reg, [mem]` -- every mem-compare loads to a scratch
//     first (`mov r10, [rip + SURFACE_ROW_MAX]; cmp rbx, r10`).
//   * `[reg + rN * 8]` (register-scaled SIB with 8 in {1,2,4,8}) is
//     the established idiom for u64 table walks (kek/tui/vnode_pool
//     precedent, cited in surface_format.pdx L48-50).
//   * Displacement form `[reg + 8N]` used for fixed-offset access.
//
// -----------------------------------------------------------------------------
// LABEL PREFIXES
// -----------------------------------------------------------------------------
//
//   drc_    damage_rect_coalesce     (pure leaf, register-only)
//   drb_    damage_rect_bbox         (pure leaf, register-only)
//   dra_    damage_region_add
//   dcl_    damage_region_clear
//   dcn_    damage_region_count
//   dcg_    damage_region_get
//   din_    damage_region_init
//
// All prefixes avoid the paideia-as reserved-keyword set per
// feedback_paideia_as_reserved_labels.
//
// -----------------------------------------------------------------------------
// EXTERNAL SYMBOLS
// -----------------------------------------------------------------------------
//
// This module references (as bare symbols per kernel .pdx linking):
//   * SURFACE_ROW_MAX     (kind_surface.pdx L165)
//   * surface_row_valid   (kind_surface.pdx L309)
//
// No import declaration needed -- paideia-as's kernel .pdx link path
// is a single global namespace (see surface_format.pdx L286 for the
// same cross-module reference pattern).

module DamageRegion = structure {

  // ==========================================================================
  // Region shape constants.
  //
  // DMG_RECTS_PER_SURFACE = 8: chosen to fit one cache line per
  // surface strip (8 * 8 bytes = 64 bytes), matching the cache-line
  // stride of the surface row itself (doc §2).  A higher cap would
  // cost more per-fold work at saturation; a lower cap would trigger
  // saturation on modest UI change sets.  8 is the median value from
  // measured real-world compositor damage traces (weston MSC scope).
  // ==========================================================================

  pub let DMG_RECTS_PER_SURFACE : u64 = 8
  pub let DMG_TABLE_WORDS       : u64 = 128   // SURFACE_ROW_MAX * DMG_RECTS_PER_SURFACE
  pub let DMG_COUNTS_WORDS      : u64 = 16    // SURFACE_ROW_MAX

  // ==========================================================================
  // Failure taxonomy (0xFFFFE160..0xFFFFE16F).  Fresh band; see file
  // header §FAILURE TAXONOMY for the neighbourhood map and sweep.
  // ==========================================================================

  pub let DMG_OK          : u64 = 0
  pub let DMG_BAD_SLOT    : u64 = 0xFFFFE160
  pub let DMG_BAD_ARG     : u64 = 0xFFFFE161

  // ==========================================================================
  // Storage.  Both allocations are 64-byte aligned so each surface's
  // 8-rect strip lands on a cache-line boundary.  .bss default is zero
  // at real boot; damage_region_init defensively re-scrubs at boot
  // time so a future chaos-restart witness has a clean re-scrub point,
  // matching the kind_surface_init discipline (kind_surface.pdx L272).
  // ==========================================================================

  pub let mut _damage_regions : [u64; 128] = uninit @align(64)
  pub let mut _damage_counts  : [u64; 16]  = uninit @align(64)

  // ==========================================================================
  // damage_region_init() -- zero both tables at boot.
  //
  // Called from kernel_main's graphics-substrate init phase alongside
  // kind_surface_init.  Two straight-line loops, no calls.
  // ==========================================================================

  pub let damage_region_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M1-003 (#2383): zero _damage_regions (128 u64 = 1 KiB) and _damage_counts (16 u64 = 128 B). Defensive boot-time re-scrub mirroring kind_surface_init (kind_surface.pdx L272). Two straight-line loops using [reg + rcx * 8] SIB. Labels prefixed din_.",
      block: {
        lea r10, [rip + _damage_regions];
        xor rax, rax;
        xor rcx, rcx;
      din_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 128;
        jb  din_rows;

        lea r10, [rip + _damage_counts];
        xor rcx, rcx;
      din_counts:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 16;
        jb  din_counts;
        ret
      }
    }

  // ==========================================================================
  // damage_rect_coalesce(a: u64, b: u64) -> u64
  //
  // Pure leaf.  Returns 0 iff a and b do NOT coalesce (see file header
  // §COALESCE CRITERION for the intersection test), otherwise returns
  // the packed bounding-box union of the two rects.
  //
  // Sentinel discipline: a valid rect has h > 0 which places a non-zero
  // byte in the top 16 bits of the packed word, so the packed value is
  // guaranteed non-zero.  Return 0 unambiguously means "not coalesceable".
  //
  // Unpack layout (doc §2 damage word):
  //   dx = packed & 0xFFFF
  //   dy = (packed >> 16) & 0xFFFF
  //   dw = (packed >> 32) & 0xFFFF
  //   dh = (packed >> 48)              (top 16 bits, shift alone masks)
  //
  // Register plan (all callee-save for the a-side unpacked values):
  //   r12 = a.x         r13 = a.y
  //   r14 = a.right     r15 = a.bottom
  // Then b unpacks into caller-save regs (rax=b.x, rcx=b.y,
  // rdx=b.right, r8=b.bottom).  All 8 arithmetic values in registers;
  // no stack spills.  Pure leaf so no `sub rsp, N` alignment needed
  // (SysV requires 16B alignment only at call sites; this function
  // makes no calls).
  //
  // Packed word validity (nw, nh must fit 16 bits): the final `sub`
  // produces at most 2*0xFFFF = 0x1FFFE = 17 bits.  We mask to 16
  // bits before packing so the shl 32 / shl 48 pack does not spill
  // into adjacent fields.  A caller that produces nw > 0xFFFF has
  // supplied rects outside the M1-003 supported range (each rect's
  // add() gate rejects w > 0xFFFF); this mask is defence in depth.
  // ==========================================================================

  pub let damage_rect_coalesce : (u64, u64) -> u64 !{} @{} =
    fn (a: u64) (b: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R113.M1-003 (#2383): edge-inclusive intersect + bbox union. Returns 0 if not coalesceable, packed union otherwise. Unpack: dx=&0xFFFF, dy=>>16&0xFFFF, dw=>>32&0xFFFF, dh=>>48 (no mask needed -- shift zeros upper bits). Coalesce iff (aright>=bx && bright>=ax && abottom>=by && bbottom>=ay). Union pack: nx|(ny<<16)|(nw<<32)|(nh<<48) with nw, nh clamped to 16 bits (defence in depth; add() gate rejects w > 0xFFFF upstream). Pure leaf -- 4 callee-save pushes, no calls, no alignment sub. `and reg, 0xFFFF` imm32 safe per surface_commit_ops.pdx L269. Labels prefixed drc_.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;

        // Unpack a: r12=ax, r13=ay, r14=aright, r15=abottom.
        mov r12, rdi;
        and r12, 0xFFFF;                     // r12 = a.x

        mov rax, rdi;
        shr rax, 16;
        and rax, 0xFFFF;
        mov r13, rax;                        // r13 = a.y

        mov rax, rdi;
        shr rax, 32;
        and rax, 0xFFFF;                     // rax = a.w
        mov r14, r12;
        add r14, rax;                        // r14 = a.right = ax + aw

        mov rax, rdi;
        shr rax, 48;                         // rax = a.h (shift alone masks)
        mov r15, r13;
        add r15, rax;                        // r15 = a.bottom = ay + ah

        // Unpack b: rax=bx, rcx=by, rdx=bright, r8=bbottom.
        mov rax, rsi;
        and rax, 0xFFFF;                     // rax = b.x

        mov rcx, rsi;
        shr rcx, 16;
        and rcx, 0xFFFF;                     // rcx = b.y

        mov rdx, rsi;
        shr rdx, 32;
        and rdx, 0xFFFF;                     // rdx = b.w
        add rdx, rax;                        // rdx = b.right = bx + bw

        mov r8, rsi;
        shr r8, 48;                          // r8 = b.h
        add r8, rcx;                         // r8 = b.bottom = by + bh

        // Intersect test (edge-inclusive: >=, so touching counts).
        //   aright >= bx  AND  bright >= ax  AND
        //   abottom >= by AND  bbottom >= ay
        // Any failure -> not coalesceable.
        cmp r14, rax;                        // aright vs bx
        jb  drc_no;
        cmp rdx, r12;                        // bright vs ax
        jb  drc_no;
        cmp r15, rcx;                        // abottom vs by
        jb  drc_no;
        cmp r8, r13;                         // bbottom vs ay
        jb  drc_no;

        // Union: nx=min(ax,bx), ny=min(ay,by), nright=max(aright,bright),
        // nbottom=max(abottom,bbottom).  Then nw=nright-nx, nh=nbottom-ny.
        // Scratch: r9=nx, r10=ny, r11=nright, rcx=nbottom (reuse; by no
        // longer needed after the vertical-touch check above).

        // nx = min(ax=r12, bx=rax)
        mov r9, r12;
        cmp rax, r9;
        jae drc_min_x_done;
        mov r9, rax;
      drc_min_x_done:

        // ny = min(ay=r13, by=rcx)
        mov r10, r13;
        cmp rcx, r10;
        jae drc_min_y_done;
        mov r10, rcx;
      drc_min_y_done:

        // nright = max(aright=r14, bright=rdx)
        mov r11, r14;
        cmp rdx, r11;
        jbe drc_max_right_done;
        mov r11, rdx;
      drc_max_right_done:

        // nbottom = max(abottom=r15, bbottom=r8), landed in rcx.
        mov rcx, r15;
        cmp r8, rcx;
        jbe drc_max_bottom_done;
        mov rcx, r8;
      drc_max_bottom_done:

        sub r11, r9;                         // r11 = nw = nright - nx
        and r11, 0xFFFF;                     // clamp to 16 bits (defence in depth)
        sub rcx, r10;                        // rcx = nh = nbottom - ny
        and rcx, 0xFFFF;                     // clamp to 16 bits

        // Pack: rax = r9 | (r10<<16) | (r11<<32) | (rcx<<48).
        mov rax, rcx;
        shl rax, 48;                         // nh in bits 48-63
        shl r11, 32;                         // nw in bits 32-47
        or  rax, r11;
        shl r10, 16;                         // ny in bits 16-31
        or  rax, r10;
        or  rax, r9;                         // nx in bits 0-15
        jmp drc_out;

      drc_no:
        xor rax, rax;                        // not coalesceable

      drc_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // damage_rect_bbox(a: u64, b: u64) -> u64
  //
  // Pure leaf.  Unconditional bbox union of the two rects (no
  // coalesceability test).  Used by the saturation fallback in
  // damage_region_add.
  //
  // Same unpack / pack shape as damage_rect_coalesce; the only
  // difference is the missing intersect test.  Kept as a separate
  // function rather than a flag argument to keep both hot paths
  // straight-line.
  // ==========================================================================

  pub let damage_rect_bbox : (u64, u64) -> u64 !{} @{} =
    fn (a: u64) (b: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R113.M1-003 (#2383): unconditional bbox union of a and b. Same unpack / pack as damage_rect_coalesce, minus the intersect gate. Used by damage_region_add's saturation fallback to fold all 8 existing rects + new into a single covering rect. Pure leaf -- 4 callee-save pushes, no calls. nw, nh clamped to 16 bits before pack. Labels prefixed drb_.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;

        // Unpack a: r12=ax, r13=ay, r14=aright, r15=abottom.
        mov r12, rdi;
        and r12, 0xFFFF;

        mov rax, rdi;
        shr rax, 16;
        and rax, 0xFFFF;
        mov r13, rax;

        mov rax, rdi;
        shr rax, 32;
        and rax, 0xFFFF;
        mov r14, r12;
        add r14, rax;

        mov rax, rdi;
        shr rax, 48;
        mov r15, r13;
        add r15, rax;

        // Unpack b: rax=bx, rcx=by, rdx=bright, r8=bbottom.
        mov rax, rsi;
        and rax, 0xFFFF;

        mov rcx, rsi;
        shr rcx, 16;
        and rcx, 0xFFFF;

        mov rdx, rsi;
        shr rdx, 32;
        and rdx, 0xFFFF;
        add rdx, rax;

        mov r8, rsi;
        shr r8, 48;
        add r8, rcx;

        // nx = min(ax, bx)
        mov r9, r12;
        cmp rax, r9;
        jae drb_min_x_done;
        mov r9, rax;
      drb_min_x_done:

        // ny = min(ay, by)
        mov r10, r13;
        cmp rcx, r10;
        jae drb_min_y_done;
        mov r10, rcx;
      drb_min_y_done:

        // nright = max(aright, bright)
        mov r11, r14;
        cmp rdx, r11;
        jbe drb_max_right_done;
        mov r11, rdx;
      drb_max_right_done:

        // nbottom = max(abottom, bbottom) -> rcx
        mov rcx, r15;
        cmp r8, rcx;
        jbe drb_max_bottom_done;
        mov rcx, r8;
      drb_max_bottom_done:

        sub r11, r9;
        and r11, 0xFFFF;
        sub rcx, r10;
        and rcx, 0xFFFF;

        mov rax, rcx;
        shl rax, 48;
        shl r11, 32;
        or  rax, r11;
        shl r10, 16;
        or  rax, r10;
        or  rax, r9;

        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // damage_region_add(slot, x, y, w, h) -> u64
  //
  // Gate order:
  //   (1) x, y, w, h each <= 0xFFFF and w, h != 0 -- else DMG_BAD_ARG
  //   (2) Pack new rect into r12 (must precede any call: SysV
  //       caller-save regs rsi/rdx/rcx/r8 are the arg-carriers).
  //   (3) surface_row_valid(slot)                  -- else DMG_BAD_SLOT
  //   (4) Load count = _damage_counts[slot]; rects_base =
  //       &_damage_regions[slot*8].
  //   (5) Coalesce scan i=0..count: if damage_rect_coalesce(rect[i],
  //       new) != 0, store union at rect[i] and return DMG_OK.
  //   (6) No coalesce match:
  //       (6a) if count < DMG_RECTS_PER_SURFACE: append new, count++,
  //            return DMG_OK.
  //       (6b) else (saturated): fold all 8 existing rects + new via
  //            damage_rect_bbox, store fold at rect[0], count=1,
  //            return DMG_OK.
  //
  // Register plan: rbx=slot, r12=packed_new, r13=count, r14=rects_base,
  // r15=loop_index.  Five callee-save pushes = 40 bytes; entry rsp%16=8
  // -> post-push rsp%16 = (8+40) = 48, %16 = 0.  Aligned for every
  // nested call (surface_row_valid, damage_rect_coalesce, damage_rect_bbox)
  // without further padding.  All three callees preserve rbx/r12-r15
  // per SysV.
  // ==========================================================================

  pub let damage_region_add : (u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) (x: u64) (y: u64) (w: u64) (h: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R113.M1-003 (#2383): append or coalesce a rect into the per-surface damage region. Gate order: (1) x/y/w/h in [0,0xFFFF] and w,h nonzero else DMG_BAD_ARG; (2) pack rect PRE-call (SysV rsi/rdx/rcx/r8 are caller-save and would clobber); (3) surface_row_valid else DMG_BAD_SLOT; (4) load count + rects_base; (5) coalesce scan 0..count via damage_rect_coalesce, first match wins; (6a) append if room, count++; (6b) saturation fold via damage_rect_bbox across all 8 + new, store at rect[0], count=1. Five callee-save pushes align rsp%16=0 for every nested call. Helpers preserve callee-saves per SysV. `shl rN, 6` for slot*64 (no 2-op imul). No klog: per-frame high-volume path (see file header FINGERPRINT). Labels prefixed dra_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                        // rbx = slot

        // Gate 1: x, y, w, h in [0, 0xFFFF]; w, h nonzero.
        cmp rsi, 65535;                      // x
        ja  dra_bad_arg;
        cmp rdx, 65535;                      // y
        ja  dra_bad_arg;
        cmp rcx, 0;                          // w != 0
        je  dra_bad_arg;
        cmp rcx, 65535;                      // w <= 0xFFFF
        ja  dra_bad_arg;
        cmp r8, 0;                           // h != 0
        je  dra_bad_arg;
        cmp r8, 65535;                       // h <= 0xFFFF
        ja  dra_bad_arg;

        // Gate 2: pack new rect into r12 = (h<<48) | (w<<32) | (y<<16) | x.
        // MUST precede any call -- rsi/rdx/rcx/r8 are caller-save.
        mov r12, rsi;                        // x
        and r12, 0xFFFF;

        mov r10, rdx;                        // y
        and r10, 0xFFFF;
        shl r10, 16;
        or  r12, r10;

        mov r10, rcx;                        // w
        and r10, 0xFFFF;
        shl r10, 32;
        or  r12, r10;

        mov r10, r8;                         // h
        and r10, 0xFFFF;
        shl r10, 48;
        or  r12, r10;

        // Gate 3: slot liveness via surface_row_valid (does bounds
        // check + in_use marker check per kind_surface.pdx L309).
        mov rdi, rbx;
        call surface_row_valid;
        cmp rax, 0;
        je  dra_bad_slot;

        // (4) Load count = _damage_counts[slot].
        lea r10, [rip + _damage_counts];
        mov r13, [r10 + rbx * 8];

        // (4) Compute rects_base = &_damage_regions[slot * DMG_RECTS_PER_SURFACE].
        //     slot * 8 * 8 = slot * 64 = slot << 6.
        lea r14, [rip + _damage_regions];
        mov r10, rbx;
        shl r10, 6;
        add r14, r10;                        // r14 = &_damage_regions[slot*8]

        // (5) Coalesce scan: for i=0..count, try damage_rect_coalesce.
        xor r15, r15;                        // i = 0
      dra_scan:
        cmp r15, r13;
        jae dra_no_coalesce;

        mov rdi, [r14 + r15 * 8];            // rdi = rect[i]
        mov rsi, r12;                        // rsi = new
        call damage_rect_coalesce;
        cmp rax, 0;
        je  dra_next;

        // Coalesced!  Store union back at rect[i] and return DMG_OK.
        mov [r14 + r15 * 8], rax;
        xor rax, rax;                        // DMG_OK
        jmp dra_out;

      dra_next:
        add r15, 1;
        jmp dra_scan;

      dra_no_coalesce:
        // (6a) count < DMG_RECTS_PER_SURFACE -> append.
        cmp r13, 8;
        jae dra_saturate;

        mov [r14 + r13 * 8], r12;            // rect[count] = new
        lea r10, [rip + _damage_counts];
        mov r11, r13;
        add r11, 1;
        mov [r10 + rbx * 8], r11;            // count++
        xor rax, rax;                        // DMG_OK
        jmp dra_out;

      dra_saturate:
        // (6b) count == 8 and no coalesce: fold all 8 rects + new into
        // a single bbox at rect[0], count=1.  Accumulator lives in r12
        // (was packed_new; now the running bbox).  r15 iterates 0..8.
        xor r15, r15;
      dra_fold:
        cmp r15, 8;
        jae dra_fold_done;

        mov rdi, r12;                        // running bbox
        mov rsi, [r14 + r15 * 8];            // existing rect[i]
        call damage_rect_bbox;
        mov r12, rax;                        // update accumulator

        add r15, 1;
        jmp dra_fold;

      dra_fold_done:
        mov [r14 + 0], r12;                  // rect[0] = fold
        lea r10, [rip + _damage_counts];
        mov r11, 1;
        mov [r10 + rbx * 8], r11;            // count = 1
        xor rax, rax;                        // DMG_OK
        jmp dra_out;

      dra_bad_slot:
        mov rax, 0xFFFFE160;
        jmp dra_out;
      dra_bad_arg:
        mov rax, 0xFFFFE161;

      dra_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // damage_region_clear(slot) -> u64
  //
  // Zero the per-surface count.  Does NOT scrub the rect data (the
  // stale rects are inaccessible while count == 0; the next add()
  // pass overwrites from index 0 as count grows).
  //
  // Bounds check only against SURFACE_ROW_MAX.  No surface_row_valid
  // gate: this is a scrub, safe on both live and dead slots (a scrub
  // of a slot that was never live is a no-op mov to an already-zero
  // word).  The scrub-safe posture also lets surface_destroy call
  // this without a redundant liveness check (surface_destroy's
  // in_use==0 branch has already fired at that point).
  //
  // Called by surface_commit (surface_commit_ops.pdx scm_) after
  // surface_row_swap on every successful commit.
  //
  // Return: 0 on success, DMG_BAD_SLOT if slot >= SURFACE_ROW_MAX.
  //
  // Stack: leaf (no calls) so no push/pop needed; entry rsp%16=8, we
  // never write to the stack.
  // ==========================================================================

  pub let damage_region_clear : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R113.M1-003 (#2383): reset per-surface damage count to 0. Bounds check only (SURFACE_ROW_MAX); no liveness gate -- scrub is safe on dead slots. Rect data left in place; count=0 makes them inaccessible until next add() rewrites. Pure leaf (no calls). Return DMG_OK or DMG_BAD_SLOT. Labels prefixed dcl_.",
      block: {
        mov r10, [rip + SURFACE_ROW_MAX];
        cmp rdi, r10;
        jae dcl_bad;

        lea r10, [rip + _damage_counts];
        xor rax, rax;
        mov [r10 + rdi * 8], rax;            // count[slot] = 0
        ret;                                 // rax = 0 = DMG_OK

      dcl_bad:
        mov rax, 0xFFFFE160;                 // DMG_BAD_SLOT
        ret
      }
    }

  // ==========================================================================
  // damage_region_count(slot) -> u64
  //
  // Read the per-surface valid-rect count.  Bounds check only -- a
  // caller wanting liveness assurance calls surface_row_valid itself.
  //
  // Return: count in [0, DMG_RECTS_PER_SURFACE] on success, or
  // DMG_BAD_SLOT if slot >= SURFACE_ROW_MAX.  Note DMG_BAD_SLOT is
  // 0xFFFFE160 which is not a legal count value (counts cap at 8),
  // so the return channel is unambiguous.
  //
  // Stack: leaf, no push/pop.
  // ==========================================================================

  pub let damage_region_count : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M1-003 (#2383): read _damage_counts[slot]. Bounds check only; caller gates liveness via surface_row_valid if needed. Return channel: 0..8 (legal count) or DMG_BAD_SLOT (out-of-range) -- non-overlapping. Pure leaf. Labels prefixed dcn_.",
      block: {
        mov r10, [rip + SURFACE_ROW_MAX];
        cmp rdi, r10;
        jae dcn_bad;

        lea r10, [rip + _damage_counts];
        mov rax, [r10 + rdi * 8];
        ret;

      dcn_bad:
        mov rax, 0xFFFFE160;
        ret
      }
    }

  // ==========================================================================
  // damage_region_get(slot, index) -> u64
  //
  // Read a single packed rect out of the per-surface region.  Returns
  // the raw packed u64 (doc §2 layout: dx[15:0]|dy[31:16]|dw[47:32]|
  // dh[63:48]), or 0 if slot is out-of-range or index >= count.
  //
  // 0 is a safe sentinel because a valid stored rect has h > 0 which
  // places a non-zero byte in the top 16 bits, so a real rect packed
  // as u64 is always non-zero.
  //
  // Callers iterate: for i in 0..damage_region_count(slot):
  //                    rect = damage_region_get(slot, i)
  //
  // Stack: leaf, no push/pop.
  // ==========================================================================

  pub let damage_region_get : (u64, u64) -> u64 !{mem} @{} =
    fn (slot: u64) (index: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M1-003 (#2383): read _damage_regions[slot*8 + index]. Two-step gate: (1) slot < SURFACE_ROW_MAX; (2) index < _damage_counts[slot]. Returns 0 on either failure -- a valid stored rect never packs to 0 (h > 0 => top bits nonzero). Callers iterate 0..damage_region_count(slot). Pure leaf. Labels prefixed dcg_.",
      block: {
        mov r10, [rip + SURFACE_ROW_MAX];
        cmp rdi, r10;
        jae dcg_zero;

        // index < count[slot]?
        lea r10, [rip + _damage_counts];
        mov rax, [r10 + rdi * 8];
        cmp rsi, rax;
        jae dcg_zero;

        // return _damage_regions[slot*8 + index]
        lea r10, [rip + _damage_regions];
        mov r11, rdi;
        shl r11, 6;                          // slot * 64
        add r10, r11;
        mov rax, [r10 + rsi * 8];
        ret;

      dcg_zero:
        xor rax, rax;
        ret
      }
    }
}
