// src/kernel/core/graphics/touch_route.pdx -- R113.M3-014 (paideia-os #2394)
//
// Touch event routing: the HID touchscreen ingress side of the R113
// GPU-native compositor's input model, for T14 G4 touchscreen SKUs.
// Umbrella: R113 (#2380).  Sibling to ptr_route.pdx (R113.M3-013,
// #2393), kbd_route.pdx (R113.M3-012, #2392), focus.pdx (R113.M2-011,
// #2391), z_order.pdx (R113.M2-010, #2390); depends only on
// surface_row_dims_get from the KIND_SURFACE substrate (design/
// graphics/r113-m1-substrate.md §4) and on _z_stack / _z_stack_count
// from z_order.pdx.  Deliberately does NOT depend on focus.pdx --
// touch and pointer focus are distinct Wayland concepts (wl_touch is
// its own interface, separate from wl_pointer); touch delivery pins
// via the per-touch-slot _touch_target latch, not via
// _ptr_focus_slot or _implicit_grab_slot.
//
// -----------------------------------------------------------------------------
// SCOPE (per issue #2394)
// -----------------------------------------------------------------------------
//
// Four ingress leaves + per-surface event ring + per-touch state:
//
//   * _touch_events[16][32]           -- per-surface event ring, 16
//                                        surfaces (matching SURFACE_
//                                        ROW_MAX and Z_STACK_MAX) x 32
//                                        slot depth, mirroring
//                                        _ptr_events layout byte-for-
//                                        byte (ptr_route.pdx §Pool
//                                        storage).  Flat u64 array of
//                                        512 entries, row-major:
//                                        _touch_events[slot * 32 +
//                                        head].  SPSC-shaped write from
//                                        the touch dispatcher; consumer
//                                        (compositor via a future
//                                        OP_SURFACE_TOUCH_DRAIN op)
//                                        lands in a later milestone.
//                                        Overflow overwrites the oldest
//                                        entry (natural mod-32 wrap).
//
//   * _touch_heads[16]                -- per-surface write cursor, one
//                                        u64 per surface (same shape as
//                                        _ptr_heads).  Advances mod 32
//                                        on every successful enqueue.
//
//   * _touch_target[10]               -- per-touch-slot surface anchor.
//                                        touch_event_down latches the
//                                        hit-tested surface here; move/
//                                        up read this cell to steer
//                                        delivery to the same surface
//                                        the down established (Wayland
//                                        wl_touch pinning discipline --
//                                        a moving finger keeps
//                                        delivering to the surface it
//                                        first landed on, even when it
//                                        wanders off the surface's
//                                        bounds).  FOCUS_NONE (0xFF..FF)
//                                        means "this touch slot is not
//                                        currently down"; touch_event_
//                                        up clears the cell back to
//                                        FOCUS_NONE.
//
//   * _touch_x[10], _touch_y[10],     -- per-touch-slot last-known
//     _touch_pressure[10]                position and pressure.
//                                        touch_event_down / move write
//                                        these; touch_event_up reads
//                                        them to pack the final up
//                                        event with the last-observed
//                                        coordinates (Wayland
//                                        convention: the up event
//                                        carries no coords, but the
//                                        consumer benefits from a
//                                        self-contained event -- we
//                                        pack last-known x/y and
//                                        pressure=last-known so a
//                                        client that missed a move
//                                        still knows where the finger
//                                        went up).
//
//   * touch_route_init()              -- boot-time init; scrubs
//                                        _touch_events / _touch_heads
//                                        / _touch_x / _touch_y /
//                                        _touch_pressure to zero AND
//                                        latches _touch_target[10] to
//                                        FOCUS_NONE (0xFF..FF).  The
//                                        FOCUS_NONE latch is REQUIRED
//                                        (not defensive) -- .bss zero-
//                                        init would leave _touch_
//                                        target[0..9] = 0, i.e. "every
//                                        touch slot is anchored to
//                                        surface slot 0", and the very
//                                        first touch_event_move would
//                                        misroute to slot 0 without a
//                                        prior down.  Same discipline
//                                        as focus_init (focus.pdx
//                                        §"Why FOCUS_NONE = 0xFF..FF").
//
//   * touch_event_down(touch_slot,    -- (1) validate touch_slot < 10;
//                      x, y,             (2) hit-test the z_order stack
//                      pressure)             top-down (index count-1
//                                            down to 0), first slot
//                                            whose (0 <= x < w) && (0
//                                            <= y < h) is the hit;
//                                        (3) on hit, latch _touch_
//                                            target[touch_slot] = hit,
//                                            _touch_x/y/pressure
//                                            [touch_slot] = args;
//                                        (4) pack event word (kind=4)
//                                            and enqueue to hit's ring;
//                                        (5) emit TOUCH ROUTE READY
//                                            sid=<hit>;
//                                        returns 0 on delivery, TOUCH_
//                                        ROUTE_NO_TARGET if no surface
//                                        under the touch point,
//                                        TOUCH_ROUTE_BAD_TOUCH_SLOT if
//                                        touch_slot >= 10, TOUCH_ROUTE_
//                                        BAD_SLOT if a corrupt z_stack
//                                        cell yields an out-of-range
//                                        target.
//
//   * touch_event_move(touch_slot,    -- (1) validate touch_slot < 10;
//                      x, y,             (2) target = _touch_target
//                      pressure)             [touch_slot]; if FOCUS_
//                                            NONE, return TOUCH_ROUTE_
//                                            NOT_DOWN (a move without a
//                                            prior down is a driver
//                                            bug -- refuse loudly);
//                                        (3) bounds check target;
//                                        (4) update _touch_x/y/pressure
//                                            [touch_slot];
//                                        (5) pack event word (kind=5),
//                                            enqueue to target's ring,
//                                            emit TOUCH ROUTE READY
//                                            sid=<target>.  Does NOT
//                                            re-hit-test -- the down-
//                                            established target is
//                                            sticky, so a finger can
//                                            drag off the origin
//                                            surface and keep delivering
//                                            (wl_touch pinning).
//
//   * touch_event_up(touch_slot)      -- (1) validate touch_slot < 10;
//                                        (2) target = _touch_target
//                                            [touch_slot]; if FOCUS_
//                                            NONE, TOUCH_ROUTE_NOT_DOWN;
//                                        (3) bounds check target;
//                                        (4) pack event word (kind=6)
//                                            with last-known x/y/
//                                            pressure from state,
//                                            enqueue, emit;
//                                        (5) clear _touch_target
//                                            [touch_slot] = FOCUS_NONE.
//                                        _touch_x/y/pressure are NOT
//                                        cleared -- the next down for
//                                        this touch slot overwrites
//                                        them.
//
//   * touch_event_cancel()            -- system-wide cancel (screen
//                                        lock, seat switch, focus loss
//                                        to a chrome pointer grab, etc.
//                                        -- the "sequence is invalid,
//                                        forget everything" wl_touch.
//                                        cancel signal).  Walks all 10
//                                        touch slots; for each with an
//                                        active target, enqueues a
//                                        cancel event (kind=7) to that
//                                        target's ring, emits TOUCH
//                                        ROUTE READY sid=<target>, and
//                                        clears the state cell.  Idle
//                                        slots are skipped silently.
//                                        Returns 0 unconditionally
//                                        (cancel is idempotent -- no
//                                        active touches -> no work, no
//                                        error).
//
// -----------------------------------------------------------------------------
// EVENT WORD ENCODING (u64 per ring slot)
// -----------------------------------------------------------------------------
//
//   [63:60] event_kind    4 = touch-down
//                         5 = touch-move
//                         6 = touch-up
//                         7 = touch-cancel
//   [59:56] touch_slot    4 bits (0..9; 10..15 reserved)
//   [55:48] pressure      8 bits (0..255; up/cancel emit last-known)
//   [47:24] x24           24-bit screen x (16 Mpx addressable)
//   [23:0]  y24           24-bit screen y
//
// Contrast with ptr_route's 4-bit kind + 12 reserved + 48 payload: the
// touch envelope splits the 12 "reserved" bits into slot (4) + pressure
// (8) at the file scope, since every touch event needs both.  The
// remaining 48 bits carry the same 24+24 coordinate pair the pointer
// motion envelope uses, so a downstream consumer that already unpacks
// x24/y24 for ptr_route can reuse the shift/mask code verbatim on the
// low 48 bits of a touch word.
//
// kinds 4..7 slot in above ptr_route's kinds 1..3 (motion/button/axis);
// the 4-bit kind field can hold 16 distinct event types, and this file
// claims the top half's low four.  Future gesture-recognizer / stylus
// tilt / pen-barrel events land in 8..15 without a wire-format bump.
//
// -----------------------------------------------------------------------------
// HIT-TEST POSITION ASSUMPTION
// -----------------------------------------------------------------------------
//
// Same at-origin assumption ptr_route.pdx §"HIT-TEST POSITION
// ASSUMPTION" documents: KIND_SURFACE rows carry width/height
// (wh_packed at +24) but no per-surface (x, y) origin -- position is
// deferred to the role side-tables (xdg_toplevel geometry, layer-shell
// anchor + margin).  The hit predicate here is (0 <= x < w) && (0 <=
// y < h) for every slot in the z_order stack top-down; first match
// wins.  The R113.M2 xdg_toplevel geometry follow-on will refine this
// inline the same way it refines ptr_route.
//
// -----------------------------------------------------------------------------
// FOCUS INTERACTION -- INTENTIONALLY NONE
// -----------------------------------------------------------------------------
//
// touch_event_down does NOT call focus_set_pointer.  Wayland treats
// wl_pointer and wl_touch as distinct interfaces: a touchscreen tap
// does not move the mouse cursor's pointer focus (a compositor may
// choose to synthesize wl_pointer events from touch, but that is a
// higher-layer "touch emulation" policy, not the leaf's job).  Keeping
// touch off the focus wire also lets a touchscreen SKU coexist with an
// external mouse cleanly -- the two anchors do not race for _ptr_focus_
// slot.  Grab semantic: wl_touch has an implicit per-touch grab that
// is exactly _touch_target[touch_slot] -- there is no separate grab
// cell (contrast focus.pdx's _implicit_grab_slot for the pointer).
//
// -----------------------------------------------------------------------------
// FAILURE TAXONOMY -- 0xFFFFE200..0xFFFFE20F (fresh band, grep-verified)
// -----------------------------------------------------------------------------
//
// Pre-landing sweep (2026-09-08):
//
//     $ grep -rn '0xFFFFE20' src design tests tools -> empty
//
// so 0xFFFFE200..0xFFFFE20F is fresh and uncontested.  Neighbouring
// bands in the 0xFFFFE1XX / 0xFFFFE2XX pages:
//
//   0xFFFFE1B0..E1BF  R113.M2-010 Z-ORDER
//   0xFFFFE1C0..E1CF  free
//   0xFFFFE1D0..E1DF  R113.M3-013 PTR ROUTE
//   0xFFFFE1E0..E1EF  free (reserved next to ptr_route per its header)
//   0xFFFFE1F0..E1FF  free
//   0xFFFFE200..E20F  R113.M3-014 TOUCH ROUTE (THIS FILE)
//   0xFFFFE210..E21F+ free
//
// Slot map:
//
//   0xFFFFE200  TOUCH_ROUTE_NO_TARGET     touch_event_down: no surface
//                                         under the touch point (z_
//                                         order stack empty OR every
//                                         live surface fails the hit
//                                         predicate).
//   0xFFFFE201  TOUCH_ROUTE_BAD_SLOT      target slot resolved to a
//                                         value outside [0, SURFACE_
//                                         ROW_MAX); defensive --
//                                         reachable only if a corrupt
//                                         _z_stack cell leaked past
//                                         z_order_raise's validator.
//   0xFFFFE202  TOUCH_ROUTE_BAD_TOUCH_SLOT  touch_slot >= TOUCH_MAX(10);
//                                         driver bug (the multi-touch
//                                         digitizer report descriptor
//                                         bounds this at 10 per the
//                                         HID Class Definition v1.11
//                                         §16.1 max contacts field).
//   0xFFFFE203  TOUCH_ROUTE_NOT_DOWN      touch_event_move / touch_
//                                         event_up called for a slot
//                                         whose _touch_target is
//                                         FOCUS_NONE (no prior down);
//                                         driver bug.
//   0xFFFFE204..0xFFFFE20F                reserved for M3 follow-on
//                                         (per-seat routing, palm
//                                         rejection, gesture-recognizer
//                                         disagreement, hover-only
//                                         digitizer stylus).
//
// -----------------------------------------------------------------------------
// FINGERPRINT (per issue #2394 §4)
// -----------------------------------------------------------------------------
//
// Wire form (post-klog_s1_x1 KV append):
//
//   touch route ready [legacy: TOUCH ROUTE READY] sid=0x<hex>
//
// Byte count verified by hand:
//   "touch route ready " (18) + "[legacy: " (9) + "TOUCH ROUTE READY"
//   (17) + "]" (1) + "\0" (1) = 46 bytes.
//
// KV key reused: surface_k_sid ("sid\0", 4 bytes) from kind_surface.pdx
// L200 (same reuse pattern surface_present.pdx / surface_toplevel.pdx /
// z_order.pdx / ptr_route.pdx use).
//
// Emission cadence: every successful ring-enqueue emits once.  A single
// touch_event_cancel that walks all 10 slots can emit up to 10 times
// (once per active touch).  Idle-slot skips are silent.
//
// Emitter reachability: unreachable in the default 14-mode QEMU matrix
// today (no caller wires the touch_event_* leaves -- no touchscreen
// digitizer HID handler exists yet).  A tools/verify-fingerprint-
// coverage.sh allowlist entry mirrors the ptr_route / focus / z-order /
// hid_kbd_attach siblings' "input-server wire deferred" posture.
//
// -----------------------------------------------------------------------------
// EXTERNAL SYMBOLS
// -----------------------------------------------------------------------------
//
// This module references (bare symbols, kernel .pdx single global
// namespace, same pattern as ptr_route.pdx):
//
//   * surface_row_dims_get    (kind_surface.pdx)   -- w/h unpack source
//   * _z_stack                (z_order.pdx)        -- top-down walk
//   * _z_stack_count          (z_order.pdx)        -- walk length
//   * SUBSYS_CAP_             (klog subsystem ordinal)
//   * surface_k_sid           (kind_surface.pdx)   -- reused KV key
//   * klog_s1_x1              (klog/wrappers.pdx)  -- 1-KV hex emit
//
// -----------------------------------------------------------------------------
// ENCODER PITFALLS (per feedback_pdx_encoder_pitfalls v0.36+)
// -----------------------------------------------------------------------------
//
//   * No `test rN, rN` -- every zero-check uses `cmp rN, 0` + `je/jne`.
//   * No 2-op `imul r, imm` -- ring offset math uses `shl r, 8` for
//     slot * 256 (32 u64) and pack shifts (24 / 48 / 56 / 60) for the
//     event word field packing.
//   * No `and reg, imm64` -- FOCUS_NONE (0xFFFFFFFFFFFFFFFF) staged
//     into a scratch register via `mov r64, imm64` (movabs) first.
//     Narrow masks 0xFF / 0xF / 0xFFFF / 0xFFFFFF / 0xFFFFFFFF / 31
//     fit in 32-bit immediates and encode without sign-extension
//     concern per the ptr_route.pdx precedent.
//   * No `cmp reg, [mem]` -- every mem compare loads to a scratch
//     register first (surface_present.pdx L242 pattern).
//   * No literal-scaled `[reg + N*8]` -- only displacement form
//     `[reg + 0]` for scalar cells; register-scaled `[reg + rN * 8]`
//     for the ring / stack / heads / per-touch-state walks (scale 8
//     in the SIB-legal {1, 2, 4, 8} set).
//   * No `mov qword [mem], imm64` -- zero staged via `xor rax, rax`
//     then stored; FOCUS_NONE staged via movabs then stored (init
//     writes to _touch_target[10]).
//   * Multiline `pub let ="..."` refused by the encoder -- the string
//     literal in this file lives on one source line.
//   * Module name matches file basename: `TouchRoute` for
//     `touch_route.pdx`.
//   * Fingerprint tag byte count computed by hand and asserted in the
//     `[u8; N]` type ascription (46 for the ready tag).
//
// -----------------------------------------------------------------------------
// LABEL PREFIXES
// -----------------------------------------------------------------------------
//
//   tri_   touch_route_init
//   td_    touch_event_down
//   tm_    touch_event_move
//   tu_    touch_event_up
//   tc_    touch_event_cancel
//
// All prefixes avoid the paideia-as reserved-keyword set
// (feedback_paideia_as_reserved_labels: loop, if, let, while, for,
// match, pub, mod, use, fn, struct, enum, impl, trait, type, where,
// move, mut, ref).

module TouchRoute = structure {

  // ==========================================================================
  // Constants
  // ==========================================================================

  pub let TOUCH_ROUTE_OK             : u64 = 0
  pub let TOUCH_ROUTE_NO_TARGET      : u64 = 0xFFFFE200
  pub let TOUCH_ROUTE_BAD_SLOT       : u64 = 0xFFFFE201
  pub let TOUCH_ROUTE_BAD_TOUCH_SLOT : u64 = 0xFFFFE202
  pub let TOUCH_ROUTE_NOT_DOWN       : u64 = 0xFFFFE203

  pub let TOUCH_RING_MAX             : u64 = 16      // matches SURFACE_ROW_MAX
  pub let TOUCH_RING_DEPTH           : u64 = 32      // per-surface ring depth
  pub let TOUCH_MAX                  : u64 = 10      // concurrent touch points

  // ==========================================================================
  // Pool storage
  //
  // _touch_events:   16 surfaces * 32 u64 slots = 512 u64 = 4 KiB, one
  //                  page aligned.  Row-major: (slot, head) at index
  //                  slot * 32 + head; byte offset slot * 256 + head * 8.
  // _touch_heads:    16 u64 write cursors (one per surface).  16 * 8 = 128 B.
  // _touch_target:   10 u64 per-touch-slot surface anchors.  MUST be
  //                  latched to FOCUS_NONE at boot -- zero would alias
  //                  surface slot 0.  See touch_route_init.
  // _touch_x/y/pressure: 10 u64 per-touch-slot last-known state cells.
  //                  Zero-init is the correct semantic identity
  //                  ("no position", "no pressure") -- these are only
  //                  meaningful when _touch_target[i] != FOCUS_NONE.
  //
  // Zero-initialised .bss; touch_route_init defensively re-scrubs at
  // boot AND latches _touch_target to FOCUS_NONE.
  // ==========================================================================

  pub let mut _touch_events   : [u64; 512] = uninit @align(64)
  pub let mut _touch_heads    : [u64; 16]  = uninit @align(64)
  pub let mut _touch_target   : [u64; 10]  = uninit @align(64)
  pub let mut _touch_x        : [u64; 10]  = uninit @align(64)
  pub let mut _touch_y        : [u64; 10]  = uninit @align(64)
  pub let mut _touch_pressure : [u64; 10]  = uninit @align(64)

  // ==========================================================================
  // Fingerprint tag (46 bytes).  surface_k_sid ("sid\0") is reused
  // from kind_surface.pdx L200 by bare-symbol lookup (same pattern as
  // ptr_route.pdx / z_order.pdx / surface_toplevel.pdx).
  // ==========================================================================

  pub let touch_route_ready_msg : [u8; 46] = "touch route ready [legacy: TOUCH ROUTE READY]\0"

  // ==========================================================================
  // touch_route_init() -> ()
  //
  // Six straight-line loops: zero _touch_events (512 u64), zero _touch_
  // heads (16 u64), zero _touch_x (10 u64), zero _touch_y (10 u64),
  // zero _touch_pressure (10 u64), latch _touch_target (10 u64) to
  // FOCUS_NONE.  Called from kernel_main.pdx boot cascade after
  // ptr_route_init.  The FOCUS_NONE latch on _touch_target is REQUIRED
  // (not defensive) -- .bss zero-init would alias surface slot 0 for
  // every touch slot, misrouting every first-move-without-down.
  // Zero-arg leaf; no callee-save clobber; touches only rax, rcx, r10.
  // Labels prefixed tri_.
  // ==========================================================================

  pub let touch_route_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M3-014 (#2394): zero _touch_events (512 u64), _touch_heads (16), _touch_x (10), _touch_y (10), _touch_pressure (10), then latch _touch_target (10) to FOCUS_NONE (0xFFFFFFFFFFFFFFFF).  The FOCUS_NONE latch is REQUIRED not defensive -- .bss zero would alias surface slot 0 for every touch slot.  Six straight-line loops using [reg + rcx * 8] register-scaled SIB (scale 8 in the legal {1,2,4,8} set).  Zero staged via xor rax, rax then stored (no `mov qword [mem], imm64` form); FOCUS_NONE staged via movabs into rax then stored.  Zero-arg leaf; entry rsp%16=8 unchanged on return.  Labels prefixed tri_.",
      block: {
        xor rax, rax;

        lea r10, [rip + _touch_events];
        xor rcx, rcx;
      tri_events:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 512;
        jb  tri_events;

        lea r10, [rip + _touch_heads];
        xor rcx, rcx;
      tri_heads:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 16;
        jb  tri_heads;

        lea r10, [rip + _touch_x];
        xor rcx, rcx;
      tri_x:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 10;
        jb  tri_x;

        lea r10, [rip + _touch_y];
        xor rcx, rcx;
      tri_y:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 10;
        jb  tri_y;

        lea r10, [rip + _touch_pressure];
        xor rcx, rcx;
      tri_pressure:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 10;
        jb  tri_pressure;

        mov rax, 0xFFFFFFFFFFFFFFFF;
        lea r10, [rip + _touch_target];
        xor rcx, rcx;
      tri_target:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 10;
        jb  tri_target;

        ret
      }
    }

  // ==========================================================================
  // touch_event_down(touch_slot, x, y, pressure) -> u64
  //
  // Gate order:
  //   (1) touch_slot < TOUCH_MAX(10) else TOUCH_ROUTE_BAD_TOUCH_SLOT
  //   (2) pack event word early (uses all 4 args before any call
  //       clobbers rdi/rsi/rdx/rcx)
  //   (3) save touch_slot / x / y into callee-save regs
  //   (4) walk z_order stack top-down; first surface whose row is
  //       in_use (surface_row_dims_get != 0) AND passes the hit
  //       predicate (x < w && y < h) is the target
  //   (5) target found: bounds-check < SURFACE_ROW_MAX, latch
  //       _touch_target[touch_slot] / _touch_x/y/pressure[touch_slot],
  //       enqueue event to target's ring, emit fingerprint
  //   (6) return 0 on delivery, TOUCH_ROUTE_NO_TARGET / _BAD_SLOT /
  //       _BAD_TOUCH_SLOT on the respective refusals
  //
  // Register plan:
  //   rbx = event word (packed early, live across nested calls)
  //   r12 = touch_slot (live across calls -- state array index)
  //   r13 = x (live for hit-test predicate)
  //   r14 = y (live for hit-test predicate)
  //   r15 = z_order loop index during hit-test, then target slot after
  //         the hit is found (same idx-then-target multiplex ptr_route
  //         uses)
  //
  // Five callee-save pushes = 40 bytes.  Entry rsp%16=8, post
  // (8-40)%16=0 -- aligned for surface_row_dims_get and klog_s1_x1
  // without further padding.
  //
  // Pressure trip: the pressure argument (rcx) is captured into rbx as
  // part of the event word pack (bits [55:48]) before any call.  After
  // the hit-test, the state-latch step re-extracts pressure from rbx
  // via `mov r11, rbx; shr r11, 48; and r11, 0xFF` to avoid burning a
  // sixth callee-save register or a stack slot.
  //
  // Labels prefixed td_.
  // ==========================================================================

  pub let touch_event_down : (u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (touch_slot: u64) (x: u64) (y: u64) (pressure: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R113.M3-014 (#2394): touch-down ingress.  Gate order per file header: (1) touch_slot < TOUCH_MAX(10); (2) pack event word into rbx BEFORE saving args (rdi/rsi/rdx/rcx are caller-save and would be clobbered by the first nested call); (3) save touch_slot/x/y to r12/r13/r14; (4) z-order top-down hit-test using surface_row_dims_get (dims high 32 = w, low 32 = h -- matches kind_surface.pdx surface_mint layout); (5) latch _touch_target[touch_slot] / _touch_x/y/pressure[touch_slot] and enqueue + emit TOUCH ROUTE READY sid=<target>.  Pressure re-extracted from rbx (bits [55:48]) for the state latch, avoiding a sixth callee-save reg.  Five callee-save pushes (rbx=event, r12=touch_slot, r13=x, r14=y, r15=loop_idx/target) land rsp%16=0 for every nested call.  FOCUS_NONE never touched here -- state writes use r15 (target slot < 16) not FOCUS_NONE.  Narrow masks 0xF / 0xFF / 0xFFFF / 0xFFFFFF / 0xFFFFFFFF safe as 32-bit immediates per the ptr_route.pdx precedent.  Ring offset via shl 8 (target * 256) + register-scaled [r10 + r8 * 8] (head * 8), never 2-op imul.  Hit-test at-origin position assumption documented in file header §HIT-TEST POSITION ASSUMPTION.  Labels prefixed td_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        // (1) validate touch_slot < TOUCH_MAX(10)
        cmp rdi, 10;
        jae td_bad_touch_slot;

        // (2) pack event word early:
        //   (4 << 60) | (touch_slot << 56) | (pressure << 48)
        //     | (x << 24) | y
        mov rbx, rcx;                        // pressure
        and rbx, 0xFF;                       // 8 bits
        shl rbx, 48;
        mov r10, rdi;                        // touch_slot
        and r10, 0xF;                        // 4 bits
        shl r10, 56;
        or  rbx, r10;
        mov r10, 4;
        shl r10, 60;                         // kind = 4 (touch-down)
        or  rbx, r10;
        mov r10, rsi;                        // x
        and r10, 0xFFFFFF;                   // 24 bits
        shl r10, 24;
        or  rbx, r10;
        mov r10, rdx;                        // y
        and r10, 0xFFFFFF;
        or  rbx, r10;

        // (3) save args to callee-save
        mov r12, rdi;                        // touch_slot
        mov r13, rsi;                        // x
        mov r14, rdx;                        // y

        // (4) walk z_order stack top-down: for i = count - 1 downto 0
        lea r10, [rip + _z_stack_count];
        mov r15, [r10 + 0];
        cmp r15, 0;
        je  td_no_target;                    // empty stack -> no target
        sub r15, 1;                          // r15 = start idx (count - 1)

      td_hit_loop:
        lea r10, [rip + _z_stack];
        mov rdi, [r10 + r15 * 8];            // rdi = surface slot arg
        call surface_row_dims_get;           // rax = wh_packed | 0 (invalid)

        cmp rax, 0;
        je  td_hit_skip;                     // dims 0 -> row not in_use

        // Unpack: high 32 = w, low 32 = h (matches surface_mint layout).
        mov r11, rax;
        shr r11, 32;                         // r11 = w
        and rax, 0xFFFFFFFF;                 // rax = h

        // Hit predicate: (x < w) && (y < h)
        cmp r13, r11;
        jae td_hit_skip;
        cmp r14, rax;
        jae td_hit_skip;

        // Hit -- resolve r15 from idx to target slot.  surface_row_
        // dims_get preserves r15 per SysV so the re-index into
        // _z_stack is safe.
        lea r10, [rip + _z_stack];
        mov r15, [r10 + r15 * 8];            // r15 = target
        jmp td_have_target;

      td_hit_skip:
        cmp r15, 0;
        je  td_no_target;
        sub r15, 1;
        jmp td_hit_loop;

      td_have_target:
        // (5a) bounds check target < SURFACE_ROW_MAX(16).  Immediate 16
        // inlined per the ptr_route.pdx / z_order.pdx precedent
        // (cross-module data-symbol reach less battle-tested than
        // cross-module code-label reach; a single-token edit follows
        // when SURFACE_ROW_MAX and TOUCH_RING_MAX are bumped together).
        cmp r15, 16;
        jae td_bad_slot;

        // (5b) latch per-touch state: target, x, y, pressure.
        // Pressure re-extracted from rbx [55:48] to avoid the sixth
        // callee-save reg.
        lea r10, [rip + _touch_target];
        mov [r10 + r12 * 8], r15;
        lea r10, [rip + _touch_x];
        mov [r10 + r12 * 8], r13;
        lea r10, [rip + _touch_y];
        mov [r10 + r12 * 8], r14;
        mov r11, rbx;
        shr r11, 48;
        and r11, 0xFF;
        lea r10, [rip + _touch_pressure];
        mov [r10 + r12 * 8], r11;

        // (5c) enqueue rbx to _touch_events[r15 * 32 + head]:
        //   head = _touch_heads[r15]
        //   base = _touch_events + r15 * 256
        //   [base + head * 8] = rbx
        //   _touch_heads[r15] = (head + 1) & 31
        lea r10, [rip + _touch_heads];
        mov r8, [r10 + r15 * 8];             // r8 = head

        lea r10, [rip + _touch_events];
        mov r11, r15;
        shl r11, 8;                          // r11 = r15 * 256
        add r10, r11;                        // r10 = ring base
        mov [r10 + r8 * 8], rbx;             // store event

        add r8, 1;
        and r8, 31;                          // mod 32
        lea r10, [rip + _touch_heads];
        mov [r10 + r15 * 8], r8;

        // (5d) emit TOUCH ROUTE READY sid=<r15>
        mov rdi, 3;                          // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + touch_route_ready_msg];
        lea rcx, [rip + surface_k_sid];
        mov r8, r15;                         // sid = target
        call klog_s1_x1;

        xor rax, rax;
        jmp td_out;

      td_bad_touch_slot:
        mov rax, 0xFFFFE202;                 // TOUCH_ROUTE_BAD_TOUCH_SLOT
        jmp td_out;
      td_no_target:
        mov rax, 0xFFFFE200;                 // TOUCH_ROUTE_NO_TARGET
        jmp td_out;
      td_bad_slot:
        mov rax, 0xFFFFE201;                 // TOUCH_ROUTE_BAD_SLOT

      td_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // touch_event_move(touch_slot, x, y, pressure) -> u64
  //
  // Gate order:
  //   (1) touch_slot < TOUCH_MAX(10) else TOUCH_ROUTE_BAD_TOUCH_SLOT
  //   (2) target = _touch_target[touch_slot];
  //       if FOCUS_NONE -> TOUCH_ROUTE_NOT_DOWN
  //   (3) bounds check target < SURFACE_ROW_MAX(16)
  //   (4) update _touch_x/y/pressure[touch_slot] with new args
  //   (5) pack event word (kind=5), enqueue to target's ring
  //   (6) emit TOUCH ROUTE READY sid=<target>
  //
  // No hit-test -- move delivery follows the down-established target
  // (wl_touch pinning discipline: a moving finger keeps delivering to
  // the surface it first landed on, even after wandering off).
  //
  // Register plan:
  //   r12 = target (live across klog_s1_x1)
  //   The event word is packed into r9 (caller-save) and stored to the
  //   ring inline before the klog call -- no need for rbx here since
  //   nothing between pack and enqueue makes a call.
  //   One callee-save push (r12) aligns rsp%16=0 for klog_s1_x1
  //   (entry 8 + 8 = 16, %16 = 0).
  //
  // Labels prefixed tm_.
  // ==========================================================================

  pub let touch_event_move : (u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (touch_slot: u64) (x: u64) (y: u64) (pressure: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R113.M3-014 (#2394): touch-move ingress.  Gate order per file header: (1) touch_slot < TOUCH_MAX(10); (2) target = _touch_target[touch_slot]; FOCUS_NONE -> TOUCH_ROUTE_NOT_DOWN; (3) SURFACE_ROW_MAX(16) bounds check; (4) update _touch_x/y/pressure[touch_slot]; (5) pack + enqueue event (kind=5); (6) emit TOUCH ROUTE READY sid=<target>.  No hit-test -- delivery is sticky to the down-established target (wl_touch pinning).  One callee-save push (r12 = target) aligns rsp%16=0 for klog_s1_x1.  FOCUS_NONE staged via movabs into r11 for the equality compare, never used as `cmp reg, imm64` directly.  Event word packed into r9 inline (no call between pack and enqueue, so no callee-save needed).  Narrow masks 0xF / 0xFF / 0xFFFF / 0xFFFFFF safe as 32-bit immediates.  Ring offset via shl 8 + register-scaled SIB.  Labels prefixed tm_.",
      block: {
        push r12;

        // (1) validate touch_slot < TOUCH_MAX(10)
        cmp rdi, 10;
        jae tm_bad_touch_slot;

        // (2) target = _touch_target[touch_slot]
        lea r10, [rip + _touch_target];
        mov r12, [r10 + rdi * 8];
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp r12, r11;
        je  tm_not_down;

        // (3) bounds check target < SURFACE_ROW_MAX(16)
        cmp r12, 16;
        jae tm_bad_slot;

        // (4) update per-touch state
        lea r10, [rip + _touch_x];
        mov [r10 + rdi * 8], rsi;
        lea r10, [rip + _touch_y];
        mov [r10 + rdi * 8], rdx;
        lea r10, [rip + _touch_pressure];
        mov [r10 + rdi * 8], rcx;

        // (5a) pack event word into r9:
        //   (5 << 60) | (touch_slot << 56) | (pressure << 48)
        //     | (x << 24) | y
        mov r9, rcx;                         // pressure
        and r9, 0xFF;
        shl r9, 48;
        mov r11, rdi;                        // touch_slot
        and r11, 0xF;
        shl r11, 56;
        or  r9, r11;
        mov r11, 5;
        shl r11, 60;                         // kind = 5 (touch-move)
        or  r9, r11;
        mov r11, rsi;                        // x
        and r11, 0xFFFFFF;
        shl r11, 24;
        or  r9, r11;
        mov r11, rdx;                        // y
        and r11, 0xFFFFFF;
        or  r9, r11;

        // (5b) enqueue r9 to _touch_events[r12 * 32 + head]
        lea r10, [rip + _touch_heads];
        mov r8, [r10 + r12 * 8];             // r8 = head

        lea r10, [rip + _touch_events];
        mov r11, r12;
        shl r11, 8;                          // r11 = r12 * 256
        add r10, r11;
        mov [r10 + r8 * 8], r9;

        add r8, 1;
        and r8, 31;
        lea r10, [rip + _touch_heads];
        mov [r10 + r12 * 8], r8;

        // (6) emit TOUCH ROUTE READY sid=<r12>
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + touch_route_ready_msg];
        lea rcx, [rip + surface_k_sid];
        mov r8, r12;
        call klog_s1_x1;

        xor rax, rax;
        jmp tm_out;

      tm_bad_touch_slot:
        mov rax, 0xFFFFE202;                 // TOUCH_ROUTE_BAD_TOUCH_SLOT
        jmp tm_out;
      tm_not_down:
        mov rax, 0xFFFFE203;                 // TOUCH_ROUTE_NOT_DOWN
        jmp tm_out;
      tm_bad_slot:
        mov rax, 0xFFFFE201;                 // TOUCH_ROUTE_BAD_SLOT

      tm_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // touch_event_up(touch_slot) -> u64
  //
  // Gate order:
  //   (1) touch_slot < TOUCH_MAX(10) else TOUCH_ROUTE_BAD_TOUCH_SLOT
  //   (2) target = _touch_target[touch_slot];
  //       if FOCUS_NONE -> TOUCH_ROUTE_NOT_DOWN
  //   (3) bounds check target < SURFACE_ROW_MAX(16)
  //   (4) pack event word (kind=6) with last-known x/y/pressure from
  //       state cells
  //   (5) enqueue to target's ring, emit fingerprint
  //   (6) clear _touch_target[touch_slot] = FOCUS_NONE
  //
  // The x/y/pressure fields are packed from state (not from args --
  // touch_event_up takes only touch_slot).  Consumer benefit: the up
  // event is self-contained, so a client that missed a move event
  // still knows where the finger went up.
  //
  // _touch_x/y/pressure are NOT cleared -- the next touch_event_down
  // for this slot overwrites them.  Only _touch_target[touch_slot]
  // reverts to FOCUS_NONE, marking the slot idle.
  //
  // Register plan:
  //   r12 = target (live across klog_s1_x1)
  //   One callee-save push, rsp%16=0 for the call.
  //
  // Labels prefixed tu_.
  // ==========================================================================

  pub let touch_event_up : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (touch_slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R113.M3-014 (#2394): touch-up ingress.  Gate order per file header: (1) touch_slot < TOUCH_MAX(10); (2) target = _touch_target[touch_slot]; FOCUS_NONE -> TOUCH_ROUTE_NOT_DOWN; (3) SURFACE_ROW_MAX(16) bounds check; (4) pack event (kind=6) with last-known x/y/pressure from state cells; (5) enqueue + emit TOUCH ROUTE READY sid=<target>; (6) clear _touch_target[touch_slot] = FOCUS_NONE.  x/y/pressure cells NOT cleared (next down overwrites).  One callee-save push (r12 = target) aligns rsp%16=0 for klog_s1_x1.  FOCUS_NONE staged via movabs into r11 for the equality compare AND as the write source for the clear (no `mov qword [mem], imm64` form).  Event word packed into r9 inline.  State reads use register-scaled [r10 + rdi * 8]; rdi (touch_slot) survives until the klog arg-setup step where it gets overwritten with LEVEL_INFO (3) -- ordering: state clear happens before klog arg setup.  Labels prefixed tu_.",
      block: {
        push r12;

        // (1) validate touch_slot < TOUCH_MAX(10)
        cmp rdi, 10;
        jae tu_bad_touch_slot;

        // (2) target = _touch_target[touch_slot]
        lea r10, [rip + _touch_target];
        mov r12, [r10 + rdi * 8];
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp r12, r11;
        je  tu_not_down;

        // (3) bounds check target
        cmp r12, 16;
        jae tu_bad_slot;

        // (4) pack event word into r9 with last-known state:
        //   (6 << 60) | (touch_slot << 56) | (pressure << 48)
        //     | (x << 24) | y
        lea r10, [rip + _touch_pressure];
        mov r9, [r10 + rdi * 8];
        and r9, 0xFF;
        shl r9, 48;
        mov r11, rdi;
        and r11, 0xF;
        shl r11, 56;
        or  r9, r11;
        mov r11, 6;
        shl r11, 60;                         // kind = 6 (touch-up)
        or  r9, r11;
        lea r10, [rip + _touch_x];
        mov r11, [r10 + rdi * 8];
        and r11, 0xFFFFFF;
        shl r11, 24;
        or  r9, r11;
        lea r10, [rip + _touch_y];
        mov r11, [r10 + rdi * 8];
        and r11, 0xFFFFFF;
        or  r9, r11;

        // (5a) enqueue r9 to _touch_events[r12][head]
        lea r10, [rip + _touch_heads];
        mov r8, [r10 + r12 * 8];

        lea r10, [rip + _touch_events];
        mov r11, r12;
        shl r11, 8;
        add r10, r11;
        mov [r10 + r8 * 8], r9;

        add r8, 1;
        and r8, 31;
        lea r10, [rip + _touch_heads];
        mov [r10 + r12 * 8], r8;

        // (6) clear _touch_target[touch_slot] = FOCUS_NONE (before
        // klog args clobber rdi)
        lea r10, [rip + _touch_target];
        mov r11, 0xFFFFFFFFFFFFFFFF;
        mov [r10 + rdi * 8], r11;

        // (5b) emit TOUCH ROUTE READY sid=<r12>
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + touch_route_ready_msg];
        lea rcx, [rip + surface_k_sid];
        mov r8, r12;
        call klog_s1_x1;

        xor rax, rax;
        jmp tu_out;

      tu_bad_touch_slot:
        mov rax, 0xFFFFE202;                 // TOUCH_ROUTE_BAD_TOUCH_SLOT
        jmp tu_out;
      tu_not_down:
        mov rax, 0xFFFFE203;                 // TOUCH_ROUTE_NOT_DOWN
        jmp tu_out;
      tu_bad_slot:
        mov rax, 0xFFFFE201;                 // TOUCH_ROUTE_BAD_SLOT

      tu_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // touch_event_cancel() -> u64
  //
  // System-wide cancel (screen lock, seat switch, chrome pointer grab,
  // etc. -- the "sequence is invalid, forget everything" wl_touch.
  // cancel signal).
  //
  // Walk all TOUCH_MAX(10) touch slots:
  //   for i = 0 to 9:
  //     target = _touch_target[i]
  //     if target == FOCUS_NONE: skip
  //     bounds check target < SURFACE_ROW_MAX(16) (defensive)
  //     pack event (kind=7) with touch_slot=i, last-known x/y,
  //       pressure=0 (canceled -- no pressure to report)
  //     enqueue to target's ring
  //     clear _touch_target[i] = FOCUS_NONE
  //     emit TOUCH ROUTE READY sid=<target>
  //
  // Returns 0 unconditionally (cancel is idempotent -- no active
  // touches means no work, no error).
  //
  // Register plan:
  //   rbx = loop index (0..9), live across every klog call
  //   r12 = current target (live across klog)
  //   Two callee-save pushes + sub rsp, 8 = 24 bytes; entry rsp%16=8,
  //   post 8+24=32, mod 16 = 0.  klog_s1_x1 aligned.
  //
  // Labels prefixed tc_.
  // ==========================================================================

  pub let touch_event_cancel : () -> u64 !{mem, sysreg} @{cap} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R113.M3-014 (#2394): system-wide touch cancel.  Walks all TOUCH_MAX(10) slots; for each with an active target, packs cancel event (kind=7, pressure=0, last-known x/y), enqueues to that target's ring, clears _touch_target[i] = FOCUS_NONE, emits TOUCH ROUTE READY sid=<target>.  Idle slots skipped silently.  Returns 0 unconditionally.  Two callee-save pushes (rbx=loop_idx, r12=target) + sub rsp,8 align rsp%16=0 for klog_s1_x1.  FOCUS_NONE staged via movabs into r11 for the equality compare AND as the clear write source (no `mov qword [mem], imm64` form).  Loop index rbx survives klog_s1_x1 per SysV callee-save preservation.  Narrow masks 0xF / 0xFFFFFF safe as 32-bit immediates.  Ring offset via shl 8 + register-scaled SIB.  Labels prefixed tc_.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;

        xor rbx, rbx;                        // rbx = touch_slot index 0..9

      tc_loop:
        cmp rbx, 10;
        jae tc_done;

        // target = _touch_target[rbx]
        lea r10, [rip + _touch_target];
        mov r12, [r10 + rbx * 8];
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp r12, r11;
        je  tc_next;                         // idle slot -> skip

        // Defensive bounds check on target (corrupt state guard).
        cmp r12, 16;
        jae tc_next;                         // silently skip corrupt slot

        // Pack event word into r9:
        //   (7 << 60) | (touch_slot << 56) | 0 | (x << 24) | y
        // pressure bits [55:48] zero (finger canceled -- no pressure).
        mov r9, rbx;
        and r9, 0xF;
        shl r9, 56;
        mov r11, 7;
        shl r11, 60;                         // kind = 7 (touch-cancel)
        or  r9, r11;
        lea r10, [rip + _touch_x];
        mov r11, [r10 + rbx * 8];
        and r11, 0xFFFFFF;
        shl r11, 24;
        or  r9, r11;
        lea r10, [rip + _touch_y];
        mov r11, [r10 + rbx * 8];
        and r11, 0xFFFFFF;
        or  r9, r11;

        // Enqueue r9 to _touch_events[r12][head]
        lea r10, [rip + _touch_heads];
        mov r8, [r10 + r12 * 8];

        lea r10, [rip + _touch_events];
        mov r11, r12;
        shl r11, 8;
        add r10, r11;
        mov [r10 + r8 * 8], r9;

        add r8, 1;
        and r8, 31;
        lea r10, [rip + _touch_heads];
        mov [r10 + r12 * 8], r8;

        // Clear _touch_target[rbx] = FOCUS_NONE
        lea r10, [rip + _touch_target];
        mov r11, 0xFFFFFFFFFFFFFFFF;
        mov [r10 + rbx * 8], r11;

        // Emit TOUCH ROUTE READY sid=<r12>
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + touch_route_ready_msg];
        lea rcx, [rip + surface_k_sid];
        mov r8, r12;
        call klog_s1_x1;

      tc_next:
        add rbx, 1;
        jmp tc_loop;

      tc_done:
        add rsp, 8;
        pop r12;
        pop rbx;
        xor rax, rax;
        ret
      }
    }

}
