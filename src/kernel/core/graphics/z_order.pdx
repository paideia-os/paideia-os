// src/kernel/core/graphics/z_order.pdx -- R113.M2-010 (paideia-os #2390)
//
// Z-order stack + activation ("raise on focus") for the R113 GPU-native
// compositor.  Umbrella: R113 (#2380).  Sibling to focus.pdx (M2-011,
// #2391) and surface_toplevel.pdx (M2-006, #2386); depends only on
// surface_row_valid from the KIND_SURFACE substrate (design/graphics/
// r113-m1-substrate.md §4).
//
// -----------------------------------------------------------------------------
// SCOPE (per issue #2390)
// -----------------------------------------------------------------------------
//
// An ordered list of KIND_SURFACE row slots representing paint / hit-
// test order.  Convention: the ARRAY-TOP end (index [count-1]) is the
// FRONTMOST surface; index [0] is the backmost.  Rendering iterates
// 0..count (back-to-front); hit-testing iterates count-1..0 (front-to-
// back).  This matches the natural array-append semantic of
// z_order_push_top and keeps the "top of stack" mental model coherent
// with the array's high index.
//
// Five entry points:
//
//   * z_order_init()                    -- boot-time init; scrubs the
//                                          _z_stack[16] pool and
//                                          _z_stack_count to zero.
//                                          Defensive (.bss is already
//                                          zero) but preserves the
//                                          chaos-restart re-scrub
//                                          discipline the sibling
//                                          init leaves (kind_surface_
//                                          init, damage_region_init,
//                                          toplevel_init) established.
//   * z_order_push_top(slot) -> u64     -- validate slot, refuse if
//                                          already present or stack
//                                          full, else append at
//                                          [_z_stack_count] and
//                                          increment.  Silent success
//                                          (no fingerprint emit -- the
//                                          "raise" tag covers the
//                                          activation-visible witness).
//   * z_order_remove(slot) -> u64       -- validate slot, find in
//                                          stack, shift entries above
//                                          down, decrement count.
//                                          Refuses NOT_PRESENT on
//                                          absent slot.  Silent.
//   * z_order_raise(slot) -> u64        -- ensure slot at top: remove-
//                                          if-present + append.  Auto-
//                                          adds if slot not currently
//                                          in stack (STACK_FULL is
//                                          only observable on the
//                                          auto-add arm when count ==
//                                          Z_STACK_MAX).  Emits Z
//                                          ORDER RAISE OK sid=<slot>
//                                          depth=<new_count> on any
//                                          success.  Called by
//                                          focus.pdx focus_set_
//                                          keyboard as the "raise on
//                                          focus" side-effect per
//                                          issue title.
//   * z_order_slot_at(index) -> u64     -- bounds-checked read of
//                                          _z_stack[index]; returns 0
//                                          (not a failure code, per
//                                          issue text "slot | 0") on
//                                          out-of-range index.  Zero
//                                          is a valid slot in the
//                                          surface substrate (surface_
//                                          mint low-first scan claims
//                                          slot 0 for the first ever
//                                          mint), so callers who need
//                                          to distinguish "slot 0" from
//                                          "out of range" must check
//                                          against _z_stack_count via
//                                          a separate accessor -- this
//                                          landing keeps the return
//                                          shape as-specified.
//
// -----------------------------------------------------------------------------
// SEMANTIC NOTES
// -----------------------------------------------------------------------------
//
// raise-as-ensure-top:  z_order_raise(slot) makes slot the frontmost
// entry regardless of whether it was already in the stack.  If present
// at index i, entries i+1..count-1 shift down one slot and slot is
// appended at [count-1] (post-shift, pre-append count-1 == count-1,
// then post-append count is restored -- net array is unchanged).  If
// absent, slot is appended at [count] and count increments.  The
// "auto-add" flavour matches the focus.pdx side-effect need: on
// focus_set_keyboard(fresh_slot), the compositor wants the slot to
// become frontmost even if a prior activation never registered it.
// The alternative (strict raise: refuse NOT_PRESENT on absent slot,
// caller falls back to push_top) doubles the caller-side gate and
// splits the "Z ORDER RAISE OK" fingerprint into two paths; folding
// the auto-add in keeps the emitter path single.
//
// pool sizing:  Z_STACK_MAX == 16 matches SURFACE_ROW_MAX (kind_
// surface.pdx §6), so the stack can hold every live surface without
// eviction.  R113.M2 (window-manager, #2380) is expected to bump both
// substrate constants together to ~48 as compositor maturity demands;
// this file's constant is a single-token edit.
//
// no rights gating:  z_order_* are kernel-internal only.  No cap_
// invoke arm dispatches to them; the compositor's WM logic reaches
// them via focus.pdx's side-effect path or through follow-on toplevel
// activation calls.  Same posture as focus.pdx and surface_toplevel.
// pdx op bodies.
//
// -----------------------------------------------------------------------------
// FAILURE TAXONOMY -- 0xFFFFE1B0..0xFFFFE1BF (fresh band, grep-verified)
// -----------------------------------------------------------------------------
//
// Pre-landing sweep (2026-09-08):
//
//     $ grep -rn '0xFFFFE1B' src design  ->  empty
//
// so 0xFFFFE1B0..0xFFFFE1BF is fresh and uncontested.  Neighbouring
// bands in the 0xFFFFE1XX page:
//
//   0xFFFFE110..E11F  R113.M1-001 KIND_SURFACE substrate
//   0xFFFFE120..E12F  R113.M1-004 kernel-side surface_format
//   0xFFFFE130..E13F  ROUTE_REVOKE
//   0xFFFFE140..E14F  SEAT_LOCK
//   0xFFFFE150..E15F  R113.M1-005 SURFACE PRESENT
//   0xFFFFE160..E16F  free
//   0xFFFFE170..E17F  R113.M2-006 SURFACE TOPLEVEL
//   0xFFFFE180..E18F  R113.M2-011 FOCUS
//   0xFFFFE190..E1AF  free
//   0xFFFFE1B0..E1BF  R113.M2-010 Z-ORDER (THIS FILE)
//
// Slot map:
//
//   0xFFFFE1B0  Z_ORDER_BAD_SLOT        slot fails surface_row_valid
//   0xFFFFE1B1  Z_ORDER_STACK_FULL      _z_stack_count == Z_STACK_MAX
//                                       on the auto-add arm of raise,
//                                       or on push_top
//   0xFFFFE1B2  Z_ORDER_NOT_PRESENT     remove called on absent slot
//   0xFFFFE1B3  Z_ORDER_ALREADY_PRESENT push_top on already-present
//                                       slot (duplicate rejected; use
//                                       raise instead to make top)
//   0xFFFFE1B4..0xFFFFE1BF              reserved for M2 follow-on
//                                       (per-workspace z-order, layer-
//                                       shell overlay bands, etc.)
//
// -----------------------------------------------------------------------------
// FINGERPRINT (per issue #2390 §3)
// -----------------------------------------------------------------------------
//
// Wire form (post-klog_s1_x2 KV append):
//
//   z order raise ok [legacy: Z ORDER RAISE OK] sid=0x<hex> depth=0x<hex>
//
// Byte count verified by hand: "z order raise ok " (17) + "[legacy: "
// (9) + "Z ORDER RAISE OK" (16) + "]" (1) + "\0" (1) = 44 bytes.
//
// KV keys: `surface_k_sid` ("sid\0", 4 bytes) reused from kind_
// surface.pdx L200 (same reuse pattern as surface_present.pdx and
// surface_toplevel.pdx); a fresh `z_order_k_depth` ("depth\0", 6
// bytes) declared in this file for the depth KV.
//
// Emitter reachability: `raise` fires whenever focus_set_keyboard
// transitions to a non-FOCUS_NONE slot (focus.pdx fsk_store arm's
// side-effect).  Unreachable in the default 14-mode QEMU matrix today
// (same MSI-X wire blocker the sibling focus / hid_kbd_attach tags
// name); a tools/verify-fingerprint-coverage.sh allowlist entry
// mirrors the focus siblings' "input-server wire deferred" posture.
//
// -----------------------------------------------------------------------------
// EXTERNAL SYMBOLS
// -----------------------------------------------------------------------------
//
// This module references (bare symbols, kernel .pdx single global
// namespace, same pattern as surface_toplevel.pdx / focus.pdx):
//
//   * surface_row_valid   (kind_surface.pdx)   -- slot gate
//   * SUBSYS_CAP_         (klog subsystem ordinal)
//   * surface_k_sid       (kind_surface.pdx)   -- reused KV key
//   * klog_s1_x2          (klog/wrappers.pdx)  -- 2-KV hex emit
//
// -----------------------------------------------------------------------------
// ENCODER PITFALLS (per feedback_pdx_encoder_pitfalls v0.36+)
// -----------------------------------------------------------------------------
//
//   * No `test rN, rN` -- every zero-check uses `cmp rN, 0` + `je/jne`.
//   * No 2-op `imul r, imm` -- all offsets computed via `shl` or via
//     the register-scaled SIB form `[reg + rcx * 8]` (scale in the
//     legal {1,2,4,8} set) inside straight-line array loops.
//   * No `and reg, imm64` -- no wide masks needed in this file.
//   * No `cmp reg, [mem]` -- every mem-compare loads to a scratch
//     register first.
//   * No literal-scaled `[reg + N*8]` -- only displacement form
//     `[reg + 0]` for the count cell and register-scaled `[reg + rN *
//     8]` for the stack walks.
//   * No `mov qword [mem], imm64` -- immediates staged in a register
//     first (0 via `xor rax, rax`).
//   * Multiline `pub let ="..."` refused by the encoder -- both string
//     literals in this file live on one source line.
//   * Module name matches file basename: `ZOrder` for `z_order.pdx`.
//   * Fingerprint tag byte count computed by hand and asserted in the
//     `[u8; N]` type ascription (44 for the raise-ok tag, 6 for the
//     depth KV key).
//
// -----------------------------------------------------------------------------
// LABEL PREFIXES
// -----------------------------------------------------------------------------
//
//   zi_    z_order_init
//   zop_   z_order_push_top
//   zore_  z_order_remove
//   zor_   z_order_raise
//   zsa_   z_order_slot_at
//
// All prefixes avoid the paideia-as reserved-keyword set
// (feedback_paideia_as_reserved_labels: loop, if, let, while, for,
// match, pub, mod, use, fn, struct, enum, impl, trait, type, where,
// move, mut, ref).

module ZOrder = structure {

  // ==========================================================================
  // Constants
  // ==========================================================================

  pub let Z_STACK_MAX            : u64 = 16

  pub let Z_ORDER_OK             : u64 = 0
  pub let Z_ORDER_BAD_SLOT       : u64 = 0xFFFFE1B0
  pub let Z_ORDER_STACK_FULL     : u64 = 0xFFFFE1B1
  pub let Z_ORDER_NOT_PRESENT    : u64 = 0xFFFFE1B2
  pub let Z_ORDER_ALREADY_PRESENT: u64 = 0xFFFFE1B3

  // ==========================================================================
  // Pool storage.  16 u64 slots (128 B) + one count cell = fits in two
  // cache lines with the count on the second line's head so the hot
  // read of _z_stack_count during scan does not evict the stack tail.
  // Zero-initialised .bss; z_order_init defensively re-scrubs at boot.
  // ==========================================================================

  pub let mut _z_stack        : [u64; 16] = uninit @align(64)
  pub let mut _z_stack_count  : u64        = uninit @align(8)

  // ==========================================================================
  // Fingerprint tag (44 bytes) + depth KV key (6 bytes).  surface_k_sid
  // ("sid\0") is reused from kind_surface.pdx L200 by bare-symbol
  // lookup (same pattern surface_present.pdx / surface_toplevel.pdx use).
  // ==========================================================================

  pub let z_order_raise_ok_msg : [u8; 44] = "z order raise ok [legacy: Z ORDER RAISE OK]\0"
  pub let z_order_k_depth      : [u8; 6]  = "depth\0"

  // ==========================================================================
  // z_order_init() -> ()
  //
  // Zero _z_stack[16] and _z_stack_count.  Called from kernel_main.pdx
  // boot cascade alongside toplevel_init / focus_init.  Zero-arg leaf,
  // no callee-save clobber; touches only rax, rcx, r10.
  // ==========================================================================

  pub let z_order_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M2-010 (#2390): zero _z_stack (16 u64) and _z_stack_count (1 u64). Defensive boot-time re-scrub mirroring kind_surface_init / damage_region_init / toplevel_init / focus_init discipline.  Straight-line loop using [reg + rcx * 8] register-scaled SIB (scale 8 in the legal {1,2,4,8} set).  Zero staged via xor rax, rax then stored (no `mov qword [mem], imm64` form).  Zero-arg leaf; entry rsp%16=8 unchanged on return.  Labels prefixed zi_.",
      block: {
        xor rax, rax;
        lea r10, [rip + _z_stack];
        xor rcx, rcx;
      zi_zero:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 16;
        jb  zi_zero;

        lea r10, [rip + _z_stack_count];
        mov [r10 + 0], rax;
        ret
      }
    }

  // ==========================================================================
  // z_order_push_top(slot) -> u64
  //
  // Gate order:
  //   (1) surface_row_valid(slot)          -> else Z_ORDER_BAD_SLOT
  //   (2) _z_stack_count < Z_STACK_MAX     -> else Z_ORDER_STACK_FULL
  //   (3) slot not already in _z_stack     -> else Z_ORDER_ALREADY_PRESENT
  //   (4) _z_stack[count] = slot; count++
  //   (5) return 0
  //
  // Silent success (no fingerprint emit); the "raise" tag covers the
  // activation-visible witness path.
  //
  // Register plan: one callee-save push (r12 = slot) aligns rsp%16=0
  // (entry 8 + 8 = 16) for the surface_row_valid call.  Labels
  // prefixed zop_.
  // ==========================================================================

  pub let z_order_push_top : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M2-010 (#2390): validate + append.  Gate order per file header.  One callee-save push (r12 = slot) aligns rsp%16=0 for surface_row_valid.  Duplicate-scan uses register-scaled SIB [r10 + rcx * 8].  Silent success; no fingerprint.  Labels prefixed zop_.",
      block: {
        push r12;
        mov r12, rdi;                        // r12 = slot

        // (1) validate slot
        mov rdi, r12;
        call surface_row_valid;
        cmp rax, 0;
        je  zop_bad_slot;

        // (2) count < Z_STACK_MAX
        lea r10, [rip + _z_stack_count];
        mov r11, [r10 + 0];                  // r11 = count
        cmp r11, 16;
        jae zop_full;

        // (3) scan for duplicate: for i=0..count-1
        xor rcx, rcx;
      zop_scan:
        cmp rcx, r11;
        jae zop_append;
        lea r10, [rip + _z_stack];
        mov rax, [r10 + rcx * 8];
        cmp rax, r12;
        je  zop_dup;
        add rcx, 1;
        jmp zop_scan;

      zop_append:
        // (4) _z_stack[count] = slot; count++
        lea r10, [rip + _z_stack];
        mov [r10 + r11 * 8], r12;
        add r11, 1;
        lea r10, [rip + _z_stack_count];
        mov [r10 + 0], r11;

        // (5) return 0
        xor rax, rax;
        jmp zop_out;

      zop_bad_slot:
        mov rax, 0xFFFFE1B0;                 // Z_ORDER_BAD_SLOT
        jmp zop_out;
      zop_full:
        mov rax, 0xFFFFE1B1;                 // Z_ORDER_STACK_FULL
        jmp zop_out;
      zop_dup:
        mov rax, 0xFFFFE1B3;                 // Z_ORDER_ALREADY_PRESENT

      zop_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // z_order_remove(slot) -> u64
  //
  // Gate order:
  //   (1) surface_row_valid(slot)          -> else Z_ORDER_BAD_SLOT
  //   (2) linear scan for slot in _z_stack -> else Z_ORDER_NOT_PRESENT
  //   (3) shift: for j=i..count-2: _z_stack[j] = _z_stack[j+1]
  //   (4) count--
  //   (5) return 0
  //
  // Silent success (no fingerprint emit).  Register plan: one callee-
  // save push (r12 = slot) aligns rsp%16=0 for surface_row_valid.
  // Labels prefixed zore_.
  // ==========================================================================

  pub let z_order_remove : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M2-010 (#2390): validate + find + shift-remove.  Gate order per file header.  One callee-save push (r12 = slot) aligns rsp%16=0 for surface_row_valid.  Shift loop uses register-scaled SIB [r10 + rcx * 8] and [r10 + r9 * 8] (both scale 8 in the legal set); when slot is at [count-1] the shift loop is trivially empty (rcx + 1 == count on entry).  Silent success; no fingerprint.  Labels prefixed zore_.",
      block: {
        push r12;
        mov r12, rdi;                        // r12 = slot

        // (1) validate slot
        mov rdi, r12;
        call surface_row_valid;
        cmp rax, 0;
        je  zore_bad_slot;

        // (2) find slot
        lea r10, [rip + _z_stack_count];
        mov r11, [r10 + 0];                  // r11 = count
        xor rcx, rcx;
      zore_scan:
        cmp rcx, r11;
        jae zore_notfound;
        lea r10, [rip + _z_stack];
        mov rax, [r10 + rcx * 8];
        cmp rax, r12;
        je  zore_shift;
        add rcx, 1;
        jmp zore_scan;

      zore_shift:
        // for j=i..count-2: _z_stack[j] = _z_stack[j+1]
        mov r9, rcx;
        add r9, 1;
        cmp r9, r11;
        jae zore_shift_done;
        lea r10, [rip + _z_stack];
        mov rax, [r10 + r9 * 8];
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        jmp zore_shift;
      zore_shift_done:

        // (4) count--
        sub r11, 1;
        lea r10, [rip + _z_stack_count];
        mov [r10 + 0], r11;

        // (5) return 0
        xor rax, rax;
        jmp zore_out;

      zore_bad_slot:
        mov rax, 0xFFFFE1B0;                 // Z_ORDER_BAD_SLOT
        jmp zore_out;
      zore_notfound:
        mov rax, 0xFFFFE1B2;                 // Z_ORDER_NOT_PRESENT

      zore_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // z_order_raise(slot) -> u64
  //
  // Ensure slot at top: remove-if-present + append.  Auto-adds if slot
  // not currently in stack; STACK_FULL is only observable on the
  // auto-add arm when count == Z_STACK_MAX.
  //
  // Gate order:
  //   (1) surface_row_valid(slot)          -> else Z_ORDER_BAD_SLOT
  //   (2) linear scan for slot:
  //         found  at index i -> shift entries i+1..count-1 down;
  //                              count-- (decrements to reflect
  //                              slot removed) and fall through to
  //                              (3)
  //         not-found         -> if count == Z_STACK_MAX, Z_ORDER_
  //                              STACK_FULL; else fall through to (3)
  //   (3) _z_stack[count] = slot; count++
  //   (4) emit Z ORDER RAISE OK sid=<slot> depth=<new_count>
  //   (5) return 0
  //
  // Post-state: slot is at _z_stack[count-1] (the frontmost end),
  // regardless of the pre-state.  If slot was already the frontmost
  // (index count-1), the shift loop is trivially empty and the net
  // effect is a fingerprint emit only (idempotent for the array
  // contents).
  //
  // Register plan: push r12, r13 + sub rsp, 8 = 24 B on top of the
  // entry 8-B misalignment lands rsp%16=0 (entry 8 + 16 + 8 = 32) for
  // surface_row_valid and klog_s1_x2.  r12 = slot, r13 = count (live
  // across the scan, shift, append and emit).
  //
  // klog_s1_x2 v2 push idiom (bdev_write.pdx L809 / surface_toplevel.
  // pdx L676-679): sub 8; push v2; call; add 16.  At body rsp%16=0
  // before the emit this lands v2 at [rsp+8] per klog_s1_x2 ABI
  // (wrappers.pdx L72).  Labels prefixed zor_.
  // ==========================================================================

  pub let z_order_raise : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R113.M2-010 (#2390): ensure slot at frontmost end.  Gate order per file header: (1) surface_row_valid; (2) find slot via linear scan (shift-remove-if-present, auto-add-if-absent with STACK_FULL check); (3) append at [count]; (4) klog_s1_x2 with sid + depth KVs; (5) return 0.  Two callee-save pushes (r12 = slot, r13 = count) + sub rsp, 8 land rsp%16=0 (entry 8 + 16 + 8 = 32) for surface_row_valid and klog_s1_x2.  Shift loop uses register-scaled SIB [r10 + rcx * 8] and [r10 + r11 * 8] (scale 8 in the legal {1,2,4,8} set).  When slot pre-existed at [count-1] (frontmost) the shift loop is trivially empty and the append restores it -- idempotent for array contents, but the fingerprint still emits so observers see the activation event.  klog_s1_x2 v2 push idiom (sub 8; push r13; call; add 16) at rsp%16=0 lands v2 at [rsp+8] per klog_s1_x2 ABI (wrappers.pdx L72).  Labels prefixed zor_.",
      block: {
        push r12;
        push r13;
        sub rsp, 8;

        mov r12, rdi;                        // r12 = slot

        // (1) validate slot
        mov rdi, r12;
        call surface_row_valid;
        cmp rax, 0;
        je  zor_bad_slot;

        // (2) find slot in _z_stack
        lea r10, [rip + _z_stack_count];
        mov r13, [r10 + 0];                  // r13 = count
        xor rcx, rcx;                        // rcx = scan idx (also
                                             // reused as shift dst idx)
      zor_scan:
        cmp rcx, r13;
        jae zor_notfound;
        lea r10, [rip + _z_stack];
        mov rax, [r10 + rcx * 8];
        cmp rax, r12;
        je  zor_found;
        add rcx, 1;
        jmp zor_scan;

      zor_found:
        // Shift entries above down: for j=i..count-2:
        //   _z_stack[j] = _z_stack[j+1]
        // rcx = i (start dst); r11 = j+1 (src) each iteration.
      zor_shift:
        mov r11, rcx;
        add r11, 1;
        cmp r11, r13;
        jae zor_shift_done;
        lea r10, [rip + _z_stack];
        mov rax, [r10 + r11 * 8];
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        jmp zor_shift;
      zor_shift_done:
        // Slot removed logically; the physical [count-1] slot now
        // holds stale data but the count-- below hides it.
        sub r13, 1;                          // count-- (net after remove)
        jmp zor_append;

      zor_notfound:
        // Auto-add arm: STACK_FULL if count == Z_STACK_MAX.
        cmp r13, 16;
        jae zor_full;

      zor_append:
        // (3) _z_stack[count] = slot; count++
        lea r10, [rip + _z_stack];
        mov [r10 + r13 * 8], r12;
        add r13, 1;                          // new count (== depth)
        lea r10, [rip + _z_stack_count];
        mov [r10 + 0], r13;

        // (4) emit Z ORDER RAISE OK sid=<slot> depth=<r13>
        mov rdi, 3;                          // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + z_order_raise_ok_msg];
        lea rcx, [rip + surface_k_sid];
        mov r8, r12;                         // v1 = sid = slot
        lea r9, [rip + z_order_k_depth];
        sub rsp, 8;
        push r13;                            // v2 = depth
        call klog_s1_x2;
        add rsp, 16;

        // (5) return 0
        xor rax, rax;
        jmp zor_out;

      zor_bad_slot:
        mov rax, 0xFFFFE1B0;                 // Z_ORDER_BAD_SLOT
        jmp zor_out;
      zor_full:
        mov rax, 0xFFFFE1B1;                 // Z_ORDER_STACK_FULL

      zor_out:
        add rsp, 8;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // z_order_slot_at(index) -> u64
  //
  // Bounds-checked read.  Returns _z_stack[index] iff index <
  // _z_stack_count; returns 0 (per issue text "slot | 0") on out-of-
  // range index.  Pure leaf; no callee-save; no nested call.
  //
  // Caveat: zero IS a valid surface slot (surface_mint's low-first scan
  // claims slot 0 for the first ever mint), so "0" from this accessor
  // is ambiguous between "index out of range" and "index is in range
  // and holds slot 0".  Callers that need the distinction check
  // `index < _z_stack_count` separately (a `z_order_depth()` accessor
  // is a natural follow-on when a caller needs it; not part of this
  // landing's four-op mandate).  Labels prefixed zsa_.
  // ==========================================================================

  pub let z_order_slot_at : (u64) -> u64 !{mem} @{} =
    fn (index: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M2-010 (#2390): bounds-checked read of _z_stack[index].  Returns 0 (per issue text) on out-of-range index.  Pure leaf; no callee-save; entry rsp%16=8 unchanged on ret.  Register-scaled SIB [r10 + rdi * 8] (scale 8 in the legal {1,2,4,8} set).  Labels prefixed zsa_.",
      block: {
        lea r10, [rip + _z_stack_count];
        mov r11, [r10 + 0];
        cmp rdi, r11;
        jae zsa_oob;
        lea r10, [rip + _z_stack];
        mov rax, [r10 + rdi * 8];
        ret;
      zsa_oob:
        xor rax, rax;
        ret
      }
    }

}
