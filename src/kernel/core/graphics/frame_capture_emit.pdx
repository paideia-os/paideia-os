// src/kernel/core/graphics/frame_capture_emit.pdx -- R113.M7-033 (paideia-os #2413)
//
// FrameCaptureView@0.1 per-frame emission substrate.  This is the M7-033
// pool + emit path that the sibling M7-032 declaration landing
// (frame_capture_schema.pdx §SCOPE lines "It does NOT land: * the _fcap
// _rows pool or any row-alloc / free primitives; * frame_capture_mint /
// ... * frame_capture_emit_from_vblank ...") explicitly deferred.
//
// The 4-slot bounded ring holds the most recent FrameCaptureView@0.1
// records the compositor's frame-kicker (vblank_handler ->
// surface_present_notify -> here) has published.  Consumers (a future
// libpdx-semantic-pipe reader on the KIND_FRAME_CAPTURE endpoint) read
// at _fcv_tail up to _fcv_head; a producer that laps the reader
// overwrites the oldest slot without back-pressure (the ring is
// deliberately lossy under consumer stall -- the compositor never blocks
// on a slow capture consumer, matching the wl_output.frame semantics
// where the compositor is authoritative and clients drop frames).
//
// -----------------------------------------------------------------------------
// SCOPE (per issue #2413)
// -----------------------------------------------------------------------------
//
// Three entry points, one wire-in:
//
//   * frame_capture_emit_init() -> ()
//     Boot-time defensive re-scrub of the ring pool + head + tail.
//     Zero-init at .bss so this is not strictly required for a clean
//     boot; the chaos-restart witness reruns the boot cascade against a
//     pre-populated .bss so the re-scrub is REQUIRED for restart
//     correctness (same discipline scanout_init / vblank_init /
//     frame_capture_schema_init / z_order_init / kind_surface_init hold
//     to).  Ordered in kernel_main's boot cascade immediately after
//     frame_capture_schema_init.
//
//   * frame_capture_emit(frame_id, timestamp_ns, surface_id,
//                        bbox_packed, format, width, height, stride)
//     -> 0 (OK)
//     Push a single 96-byte FrameCaptureView@0.1 record into the ring
//     at slot = _fcv_head & 3, then advance _fcv_head by 1.  The 8-arg
//     signature is authoritative on the wire (see frame_capture_schema
//     .pdx §SCHEMA RECORD LAYOUT); the paideia-as 6-param ABI limit is
//     accommodated by passing height / stride on the caller stack (same
//     idiom klog_s1_x2 uses for v2, klog_s1_x3 uses for v2/k3/v3, etc.).
//     Emits `FRAME CAPTURE EMIT OK fid=<n> sid=<n>` per emit via
//     klog_s1_x2; emission is rate-limited implicitly by consent (see
//     the maybe_emit wrapper below).  Never returns an error today --
//     the failure band 0xFFFFE2F0..0xFFFFE2FF is reserved for a follow-
//     on landing that adds back-pressure / dims-validate arms without
//     needing a fresh sweep.
//
//   * frame_capture_maybe_emit_for_surface(surface_slot, serial) -> 0
//     Consent-gated wrapper.  Scans the KIND_CAPTURE row pool (see
//     kind_capture.pdx §POOL SUBSTRATE) for a live grant whose
//     source_surface matches surface_slot OR is 0 (fullscreen).  If
//     none: silent skip (returns 0 without emitting).  If found:
//     resolves surface_id from surface_row_addr(surface_slot)+8,
//     samples timestamp_ns via hpet_now_ns, and calls frame_capture_emit
//     with bbox / format / dims stubbed to 0 (those fields land with
//     the follow-on that plumbs damage_region + surface_format-bind
//     into the emit path; the schema slot exists today, the wire
//     source does not).  Frame-id is the presented serial (which is
//     the monotonic per-surface commit counter the compositor already
//     advances at commit-time; a per-boot global frame-id counter is
//     a follow-on refinement).  Called from surface_present_notify per
//     rendered surface (companion edit in surface_present.pdx).
//
// -----------------------------------------------------------------------------
// RING LAYOUT
// -----------------------------------------------------------------------------
//
// 4 slots * 96 bytes = 384 bytes = 48 u64 words.  Slots are contiguous
// in _frame_capture_records; slot i lives at byte offset (i * 96).
// Since 96 does not decompose cleanly to a single shift, the offset is
// computed via shift-add:  i * 96 = (i << 6) + (i << 5)  (the encoder
// refuses 2-op `imul r, imm` per feedback_pdx_encoder_pitfalls; 3-op
// `imul r, r, imm` is available but the shift-add form matches the
// substrate discipline in dma_buf.pdx / shm_pool.pdx that already
// avoids the 96-byte imul path).
//
// _fcv_head advances monotonically on every emit (never wraps in the
// 64-bit domain -- at 240 Hz per display * 8 displays * 16 surfaces =
// 30720 emits/sec, wrap-around takes ~19 million years).  Consumers
// compare (head - tail) against RING_SLOTS to detect lap-over; that
// contract lives with the follow-on consumer library.
//
// -----------------------------------------------------------------------------
// FAILURE TAXONOMY -- 0xFFFFE2F0..0xFFFFE2FF (fresh band)
// -----------------------------------------------------------------------------
//
// Pre-landing sweep (2026-09-08):
//
//   $ grep -rn '0xFFFFE2F' src -> empty
//
// so the entire band is fresh.  Neighbouring bands in the 0xFFFFE2xx
// page (from screenshot.pdx §FAILURE TAXONOMY + kind_capture.pdx
// §FAILURE TAXONOMY + a targeted repeat sweep):
//
//   0xFFFFE2B0..E2BF  R113.M7-032 FRAME CAPTURE SCHEMA (frame_capture_schema.pdx)
//   0xFFFFE2C0..E2CF  R113.M7-034 SCREENSHOT           (screenshot.pdx)
//   0xFFFFE2D0..E2DF  R113.M7-036 KIND_CAPTURE         (kind_capture.pdx)
//   0xFFFFE2E0..E2EF  R113.M5-025 KIND_SEAT (kind_seat.pdx)
//   0xFFFFE2F0..E2FF  R113.M7-033 FRAME CAPTURE EMIT   (THIS FILE)
//
// Slot map:
//
//   0xFFFFE2FF  FCE_EMIT_TAIL_ENOSPC   reserved: raised by a future
//                                      back-pressure landing that
//                                      refuses emit when (head - tail)
//                                      == RING_SLOTS.  Today the ring
//                                      overwrites without complaint
//                                      (the wl_output.frame policy);
//                                      this code stays declared so a
//                                      follow-on that flips the ring
//                                      to bounded-with-back-pressure
//                                      does not need a fresh sweep.
//   0xFFFFE2FE  FCE_EMIT_BAD_DIMS      reserved: width == 0 OR
//                                      height == 0 (dims-validate arm
//                                      the schema's FCV_BAD_DIMS
//                                      companion code would return).
//                                      Not raised today because the
//                                      maybe_emit wrapper passes 0 for
//                                      dims (data source not yet
//                                      plumbed); flipping this on
//                                      before the plumbing lands would
//                                      make the emit unfireable.
//   0xFFFFE2FD  FCE_EMIT_BAD_STRIDE    reserved: stride < width * bpp.
//   0xFFFFE2FC  FCE_EMIT_BAD_SURFACE   reserved: surface_id == 0 (not
//                                      a legal KIND_SURFACE row id --
//                                      the mint low-first scan claims
//                                      row 0 for the first-ever mint,
//                                      so sid == 0 is a caller bug).
//   0xFFFFE2F0..0xFFFFE2FB              reserved for M7 follow-on
//                                      (per-consumer subscription drop
//                                      counts, tail-lap taxonomy, etc.)
//
// The emit body in this landing returns FCE_EMIT_OK unconditionally on
// every path (there is no reachable error arm), so the band is fully
// declarative today.  The reservation is the audit-track for the
// follow-on that lands the validators without a fresh band-allocation
// ceremony.
//
// -----------------------------------------------------------------------------
// FINGERPRINT
// -----------------------------------------------------------------------------
//
// Wire form (post-klog_s1_x2 KV append):
//
//   frame capture emit ok [legacy: FRAME CAPTURE EMIT OK] fid=0x<hex> sid=0x<hex>
//
// Byte counts hand-verified:
//
//   "frame capture emit ok [legacy: FRAME CAPTURE EMIT OK]\0" = 54 bytes
//     - "frame capture emit ok "                  = 22
//     - "[legacy: FRAME CAPTURE EMIT OK]"         = 31
//     - NUL                                       = 1
//                                              total = 54
//   "fid\0"                                       = 4 bytes
//   "sid\0"                                       = 4 bytes
//
// Emitter reachability: reachable in principle whenever a live
// KIND_CAPTURE grant covers a surface being presented.  In the default
// 14-mode QEMU smoke matrix no such grant is minted (the capture-broker
// path that mints KIND_CAPTURE grants is a separate M7-036 landing that
// requires user-space UI to drive), so the fingerprint sits on the
// tools/verify-fingerprint-coverage.sh allowlist alongside the
// SCREENSHOT OK / SURFACE PRESENT OK / VBLANK / COMPOSITE GPU OK
// siblings.  Assertable when a boot witness mints a KIND_CAPTURE grant
// covering a surface AND drives one full commit -> present cycle on
// that surface end-to-end.
//
// -----------------------------------------------------------------------------
// EXTERNAL SYMBOLS
// -----------------------------------------------------------------------------
//
// This module references (bare symbols, kernel .pdx single global
// namespace):
//
//   * CAPTURE_ROW_MAX          (cap/kind_capture.pdx)          -- consent pool ceiling
//   * capture_row_source_get   (cap/kind_capture.pdx)          -- consent source lookup
//   * surface_row_addr         (cap/kind_surface.pdx)          -- sid lookup
//   * hpet_now_ns              (time/hpet.pdx)                 -- monotonic timestamp
//   * SUBSYS_CAP_              (klog/subsys.pdx)               -- klog subsys
//   * klog_s1_x2               (klog/wrappers.pdx)             -- 2-KV hex emit
//
// -----------------------------------------------------------------------------
// ENCODER PITFALLS (per feedback_pdx_encoder_pitfalls v0.36+)
// -----------------------------------------------------------------------------
//
//   * No `test rN, rN` -- every zero-check uses `cmp rN, 0` + `je/jne`.
//   * No 2-op `imul r, imm` -- the *96 record-offset math uses
//     shift-add:  (r << 6) + (r << 5)  (a well-established substrate
//     idiom -- dma_buf.pdx §L217 uses `shl rN, 5` for *32, shm_pool.pdx
//     §L200 uses `shl rN, 12` for *4096).
//   * No `and reg, imm64` -- the ring mask is `and reg, 3` (imm8 safe,
//     per the issue briefing's explicit note).
//   * No `cmp reg, [mem]` -- CAPTURE_ROW_MAX loaded via `mov r10,
//     [rip + CAPTURE_ROW_MAX]` first, then `cmp r12, r10`.
//   * No `mov qword [mem], imm64` -- zero immediates staged via
//     `xor reg, reg` first; large sentinels staged via `mov reg, imm64`
//     (movabs) then `cmp reg, sentinel_reg`.
//   * Sentinel `0xFFFFE2DC` (CAPTURE_BAD_SLOT, bit 31 set) loaded via
//     `mov r10, 0xFFFFE2DC` -- same idiom as surface_present.pdx L242
//     for its own 0xFFFFE110 sentinel.
//   * 32-bit stores from register-low halves use the displacement form
//     `mov [reg + N], regNd` per the bot.pdx L300 idiom (bare
//     `mov [rax], regNd` is the eoi.pdx-flagged elaborator gap; every
//     store here has a non-zero displacement).
//   * Module name matches file basename: `FrameCaptureEmit` for
//     `frame_capture_emit.pdx`.
//   * All string literals live on ONE source line each (multiline
//     `pub let ="..."` refused by the encoder).
//   * `[rip + sym]` and `lea reg, [rip + sym]` are the standing forms
//     for global data access.  Register-scaled `[reg + rN * 8]` (scale
//     8 in the legal SIB set) used in the init scrub loop.
//
// -----------------------------------------------------------------------------
// STACK ALIGNMENT (SysV: pre-CALL rsp%16 == 0 => callee entry rsp%16 == 8)
// -----------------------------------------------------------------------------
//
//   * frame_capture_emit_init:
//       Leaf, no callee-save, no nested call.  Entry rsp%16=8 unchanged
//       on return.
//
//   * frame_capture_emit:
//       1 rbp + 4 callee-save pushes (rbx=frame_id, r12=surface_id,
//       r13=head, r14=slot_offset) = 40 bytes = %16=0 alignment for
//       every nested call (klog_s1_x2 only).  klog_s1_x2 v2 push idiom
//       lifted from surface_present.pdx L269-273 byte-for-byte:
//         sub rsp, 8;    // %16=0 -> %16=8
//         push r12;      // %16=8 -> %16=0 (r12 = surface_id = v2)
//         call klog_s1_x2;
//         add rsp, 16;   // restore
//       klog_s1_x2 preserves rbx/r12-r15/rbp per SysV so both saved
//       args (rbx=frame_id, r12=surface_id) survive across the emit.
//
//   * frame_capture_maybe_emit_for_surface:
//       1 rbp + 5 callee-save pushes (rbx=surface_slot, r12=scan idx,
//       r13=surface_id, r14=timestamp_ns, r15=serial) + sub rsp, 8
//       = 56 bytes = %16=0 for every nested call (capture_row_source_
//       get, surface_row_addr, hpet_now_ns, frame_capture_emit).  The
//       final frame_capture_emit call reserves 16 bytes for the 2 stack
//       args (height + stride) via `sub rsp, 16` at %16=0 (stays 0);
//       args land at [rsp+0] (height) and [rsp+8] (stride), matching
//       the wrapper-callee's [rbp+16] / [rbp+24] read after its own
//       push rbp (per the klog_s1_x3 convention documented in
//       wrappers.pdx L110-113 for its stack args).
//
// -----------------------------------------------------------------------------
// LABEL PREFIXES
// -----------------------------------------------------------------------------
//
//   fce_init_   frame_capture_emit_init
//   fce_e_      frame_capture_emit
//   fcm_        frame_capture_maybe_emit_for_surface
//
// All prefixes avoid the paideia-as reserved-keyword set
// (feedback_paideia_as_reserved_labels: loop, if, let, while, for,
// match, pub, mod, use, fn, struct, enum, impl, trait, type, where,
// move, mut, ref).

module FrameCaptureEmit = structure {

  // ==========================================================================
  // SECTION 1 -- RING GEOMETRY + FAILURE TAXONOMY
  // ==========================================================================

  pub let FCE_RING_SLOTS      : u64 = 4
  pub let FCE_RING_MASK       : u64 = 3
  pub let FCE_RECORD_BYTES    : u64 = 96
  pub let FCE_RING_BYTES      : u64 = 384      // 4 * 96
  pub let FCE_RING_U64_WORDS  : u64 = 48       // 4 * 12

  pub let FCE_OK                    : u64 = 0
  pub let FCE_EMIT_TAIL_ENOSPC      : u64 = 0xFFFFE2FF
  pub let FCE_EMIT_BAD_DIMS         : u64 = 0xFFFFE2FE
  pub let FCE_EMIT_BAD_STRIDE       : u64 = 0xFFFFE2FD
  pub let FCE_EMIT_BAD_SURFACE      : u64 = 0xFFFFE2FC

  // ==========================================================================
  // SECTION 2 -- RING POOL + HEAD / TAIL COUNTERS
  // ==========================================================================
  //
  // 4 slots * 12 u64 words per slot = 48 u64 words = 384 bytes.  64-byte
  // aligned so slot 0 lands on a cache-line boundary; subsequent slots
  // straddle cache-line pairs (96 bytes = 1.5 cache lines) which is
  // acceptable for the current single-producer / occasional-consumer
  // access pattern.
  //
  // _fcv_head advances on every emit; _fcv_tail advances on every
  // consumer read (that logic lives with the follow-on consumer
  // library, not here).  Both are u64 to match the wl_output.frame
  // sequence-counter width every downstream consumer already assumes.
  // The names come verbatim from the issue briefing.

  pub let mut _frame_capture_records : [u64; 48] = uninit @align(64)
  pub let mut _fcv_head              : u64 = uninit @align(8)
  pub let mut _fcv_tail              : u64 = uninit @align(8)

  // ==========================================================================
  // SECTION 3 -- FINGERPRINT TAG + KV KEY NAMES
  // ==========================================================================
  //
  // Byte counts hand-verified in the file header §FINGERPRINT.  Keys are
  // declared file-local rather than reused from klog/keys.pdx or from
  // surface_present.pdx for the same self-containment reason
  // shm_pool.pdx / surface_commit_ops.pdx / surface_present.pdx set the
  // precedent for (grep-verify hits stay narrow; the emit path does not
  // depend on the exact declaration site of any KV key).

  pub let frame_capture_emit_ok_msg : [u8; 54] = "frame capture emit ok [legacy: FRAME CAPTURE EMIT OK]\0"
  pub let fce_k_fid : [u8; 4] = "fid\0"
  pub let fce_k_sid : [u8; 4] = "sid\0"

  // ==========================================================================
  // SECTION 4 -- frame_capture_emit_init() -> ()
  //
  // Defensive re-scrub of _frame_capture_records + _fcv_head + _fcv_tail.
  // Zero-init at .bss makes this strictly redundant on a clean boot;
  // the chaos-restart witness reruns the boot cascade against a pre-
  // populated .bss so the re-scrub is REQUIRED for restart correctness
  // (same discipline scanout_init / vblank_init / frame_capture_schema
  // _init hold to).  Called from kernel_main's boot cascade immediately
  // after frame_capture_schema_init.
  //
  // Zero-arg leaf; touches only rax, rcx, r10.  Entry rsp%16=8
  // unchanged on return.  Labels prefixed fce_init_.
  // ==========================================================================

  pub let frame_capture_emit_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M7-033 (#2413): zero _frame_capture_records (48 u64) + _fcv_head + _fcv_tail. Defensive boot-time re-scrub mirroring scanout_init / vblank_init / frame_capture_schema_init discipline (chaos-restart witness re-scrub point). Zero staged via xor rax, rax then stored (no `mov qword [mem], imm64` form). Loop counter rcx walks 0..48; per-iteration store uses register-scaled `[r10 + rcx * 8]` (scale 8 in the legal SIB set, same idiom as damage_region.pdx L200). Zero-arg leaf; entry rsp%16=8 unchanged on return. Labels prefixed fce_init_ (avoids paideia-as reserved keywords).",
      block: {
        xor rax, rax;
        lea r10, [rip + _frame_capture_records];
        xor rcx, rcx;

      fce_init_step:
        cmp rcx, 48;
        jae fce_init_done;
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        jmp fce_init_step;

      fce_init_done:
        lea r10, [rip + _fcv_head];
        mov [r10 + 0], rax;
        lea r10, [rip + _fcv_tail];
        mov [r10 + 0], rax;
        ret
      }
    }

  // ==========================================================================
  // SECTION 5 -- frame_capture_emit(frame_id, timestamp_ns, surface_id,
  //                                 bbox_packed, format, width,
  //                                 height, stride) -> u64
  //
  // Push one 96-byte FrameCaptureView@0.1 record into the ring at
  // slot = _fcv_head & 3, then advance _fcv_head by 1.  Emits
  // `FRAME CAPTURE EMIT OK fid=<frame_id> sid=<surface_id>` via
  // klog_s1_x2.  Returns FCE_OK (0) unconditionally in this landing;
  // the failure band 0xFFFFE2F0..0xFFFFE2FF is reserved for a follow-on
  // landing (see file header §FAILURE TAXONOMY).
  //
  // 8 args, paideia-as ABI 6-param limit: last 2 args (height, stride)
  // pass via caller stack per the klog_s1_x2 idiom.  After push rbp
  // they read as [rbp + 16] (height) and [rbp + 24] (stride).
  //
  // Record layout (frame_capture_schema.pdx §SCHEMA RECORD LAYOUT):
  //   +0   frame_id (u64)
  //   +8   timestamp_ns (u64)
  //   +16  surface_id (u64)
  //   +24  bbox_packed (u64)
  //   +32  format (u32)
  //   +36  width (u32)
  //   +40  height (u32)
  //   +44  stride (u32)
  //   +48..+95   reserved slots + tail pad (all zero on emit)
  //
  // Register plan: rbx=frame_id (klog v1), r12=surface_id (klog v2),
  // r13=head (for the post-write increment), r14=ring-slot base VA.
  // klog_s1_x2 preserves rbx/r12-r15/rbp per SysV.  Labels prefixed
  // fce_e_.
  // ==========================================================================

  pub let frame_capture_emit : (u64, u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (frame_id: u64) (timestamp_ns: u64) (surface_id: u64) (bbox_packed: u64) (format: u64) (width: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R113.M7-033 (#2413): per-frame FrameCaptureView@0.1 emit into the 4-slot bounded ring _frame_capture_records. Body: (1) slot = _fcv_head & 3 (imm8 safe per issue briefing note); (2) slot_offset = slot * 96 via shift-add (r14 << 6) + (r14 << 5) -- avoids the encoder-refused 2-op `imul r, imm` per feedback_pdx_encoder_pitfalls; (3) write 8 record fields at the appropriate widths (four u64 at +0/+8/+16/+24; four u32 at +32/+36/+40/+44 via displacement-form `mov [reg + N], regNd` per bot.pdx L300 idiom); (4) zero reserved slots + tail padding at +48..+95 (six u64 stores of xor'd rax); (5) advance _fcv_head; (6) emit FRAME CAPTURE EMIT OK fid=<rbx> sid=<r12> via klog_s1_x2; (7) return FCE_OK. Height / stride read from caller stack at [rbp+16] / [rbp+24] via the klog_s1_x2 stack-arg convention (paideia-as 6-param ABI limit; the 8-arg wire signature is authoritative). Frame: 1 rbp + 4 callee-save pushes (rbx/r12/r13/r14) = 40 bytes = %16=0 alignment (entry 8 + 40 = 48 = %16 0) for every nested call. klog_s1_x2 v2 push idiom (sub 8; push r12; call; add 16) at rsp%16=0 lands v2 at [rsp+8] per wrappers.pdx L72. rdi/rsi/rdx/rcx/r8/r9 (input args) are held unmodified from function entry through the ring writes so no re-load is needed; rbx/r12 (frame_id/surface_id) are latched into callee-saves once at entry so they survive the klog call. No test rN,rN; no 2-op imul-imm; no `and reg, imm64`; no `cmp reg, [mem]` (no mem-compare in this body). Labels prefixed fce_e_.",
      block: {
        push rbp;
        mov rbp, rsp;
        push rbx;
        push r12;
        push r13;
        push r14;

        // Latch frame_id + surface_id into callee-saves for the klog
        // emit tail (rdi / rdx are caller-save; klog preserves rbx /
        // r12 per SysV).
        mov rbx, rdi;                        // rbx = frame_id
        mov r12, rdx;                        // r12 = surface_id

        // Compute ring slot: idx = _fcv_head & 3.
        lea r10, [rip + _fcv_head];
        mov r13, [r10 + 0];                  // r13 = head (full value; used
                                             //          for post-write ++).
        mov r14, r13;
        and r14, 3;                          // r14 = head & 3 (imm8)

        // slot_offset = idx * 96 = (idx << 6) + (idx << 5).
        // Compute (idx << 5) first into rax so we still hold idx in
        // r14 for the (r14 << 6) step.
        mov rax, r14;
        shl r14, 6;                          // r14 = idx * 64
        shl rax, 5;                          // rax = idx * 32
        add r14, rax;                        // r14 = idx * 96

        // r10 = &_frame_capture_records[slot].
        lea r10, [rip + _frame_capture_records];
        add r10, r14;

        // Write record fields.  Input regs unchanged from entry:
        //   rdi = frame_id, rsi = timestamp_ns, rdx = surface_id,
        //   rcx = bbox_packed, r8 = format, r9 = width.
        mov [r10 + 0],  rdi;                 // frame_id       (u64 @ +0)
        mov [r10 + 8],  rsi;                 // timestamp_ns   (u64 @ +8)
        mov [r10 + 16], rdx;                 // surface_id     (u64 @ +16)
        mov [r10 + 24], rcx;                 // bbox_packed    (u64 @ +24)

        // Four u32 fields at +32/+36/+40/+44.  Displacement-form
        // 32-bit stores avoid the eoi.pdx elaborator gap on bare
        // `mov [reg], regNd`.
        mov [r10 + 32], r8d;                 // format         (u32 @ +32)
        mov [r10 + 36], r9d;                 // width          (u32 @ +36)

        // Height + stride from caller stack ([rbp+16] / [rbp+24]).
        mov rax, [rbp + 16];                 // rax = height (u64 slot)
        mov [r10 + 40], eax;                 // height         (u32 @ +40)
        mov rax, [rbp + 24];                 // rax = stride (u64 slot)
        mov [r10 + 44], eax;                 // stride         (u32 @ +44)

        // Zero reserved slots + tail padding (+48..+95 = 48 bytes = 6 u64).
        xor rax, rax;
        mov [r10 + 48], rax;
        mov [r10 + 56], rax;
        mov [r10 + 64], rax;
        mov [r10 + 72], rax;
        mov [r10 + 80], rax;
        mov [r10 + 88], rax;

        // Advance _fcv_head monotonically (no wrap in the 64-bit domain
        // per file header §RING LAYOUT).
        lea r10, [rip + _fcv_head];
        add r13, 1;
        mov [r10 + 0], r13;

        // Fingerprint: FRAME CAPTURE EMIT OK fid=<rbx> sid=<r12>.
        // klog_s1_x2(LEVEL_INFO=3, SUBSYS_CAP_, tag, k_fid, v1=fid,
        //            k_sid, v2=sid).  v2 pushed per wrappers.pdx L72.
        mov rdi, 3;                          // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + frame_capture_emit_ok_msg];
        lea rcx, [rip + fce_k_fid];
        mov r8,  rbx;                        // v1 = fid
        lea r9,  [rip + fce_k_sid];
        sub rsp, 8;
        push r12;                            // v2 = sid
        call klog_s1_x2;
        add rsp, 16;

        // Return FCE_OK (0).
        xor rax, rax;

        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        pop rbp;
        ret
      }
    }

  // ==========================================================================
  // SECTION 6 -- frame_capture_maybe_emit_for_surface(surface_slot,
  //                                                    serial) -> u64
  //
  // Consent-gated emit wrapper.  Called from surface_present_notify
  // per rendered surface.  Body:
  //   (1) Scan _captures[0..CAPTURE_ROW_MAX) for a live grant whose
  //       source_surface matches surface_slot OR is 0 (fullscreen).
  //       If none: silent return 0.
  //   (2) Resolve surface_id via surface_row_addr(surface_slot)+8.
  //       If the surface went dead mid-scan: silent return 0.
  //   (3) Sample timestamp_ns via hpet_now_ns.
  //   (4) Call frame_capture_emit with (frame_id=serial, timestamp_ns,
  //       surface_id, bbox_packed=0, format=0, width=0, height=0,
  //       stride=0).  The bbox / format / dims stubs land actual
  //       values in a follow-on landing that plumbs damage_region and
  //       surface_format-bind into this call site; the schema slot
  //       exists today, the wire source does not.
  //
  // The consent scan uses capture_row_source_get (per-row leaf that
  // returns source_surface on a live row or CAPTURE_BAD_SLOT (0xFFFFE2DC)
  // on any stale / OOB slot).  Sixteen accessor calls in the worst case
  // is comfortably within budget for a per-vblank code path (~2880
  // invocations/sec even at 240 Hz * 8 displays * 16 surfaces).
  //
  // Frame: 1 rbp + 5 callee-save pushes + sub rsp, 8 = 56 bytes;
  // rsp%16=0 for every nested call (capture_row_source_get,
  // surface_row_addr, hpet_now_ns, frame_capture_emit).  All callees
  // preserve rbx/r12-r15/rbp per SysV so the loop invariants and
  // gathered args survive across every call.  Labels prefixed fcm_.
  // ==========================================================================

  pub let frame_capture_maybe_emit_for_surface : (u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (surface_slot: u64) (serial: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R113.M7-033 (#2413): consent-gated frame-capture emit wrapper. Called from surface_present_notify per rendered surface. Body: (1) scan _captures[0..CAPTURE_ROW_MAX=16) via capture_row_source_get (per-row leaf that returns source_surface on a live row or CAPTURE_BAD_SLOT sentinel 0xFFFFE2DC on stale/OOB) -- match iff return == surface_slot (per-surface grant) OR return == 0 (fullscreen grant per kind_capture.pdx §ROW LAYOUT L182); (2) on match, read sid from surface_row_addr(surface_slot)+8 (silent skip if the surface went dead mid-scan -- surface_row_addr returns 0 on a dead row); (3) sample timestamp_ns via hpet_now_ns (@{boot} bleed absorbed silently per drivers/dpy/timeline.pdx L296 precedent -- @{cap} on this fn matches surface_present_notify's own capability set which is our caller); (4) call frame_capture_emit(frame_id=serial, timestamp_ns, surface_id, bbox_packed=0, format=0, width=0, height=0, stride=0) via the 2-stack-arg convention (sub rsp,16 at %16=0 reserves both slots; [rsp+0]=height=0, [rsp+8]=stride=0 -- the schema wire slots exist today but bbox/format/dims plumbing lands in a follow-on that wires damage_region + surface_format-bind into this call site). Register plan: rbx=surface_slot, r12=scan idx, r13=surface_id (sid), r14=timestamp_ns, r15=serial (frame_id). Frame: 1 rbp + 5 callee-save pushes + sub rsp, 8 = 56 bytes = %16=0 (entry 8 + 48 + 8 = 64) for every nested call. capture_row_source_get / surface_row_addr / hpet_now_ns / frame_capture_emit all preserve rbx/r12-r15/rbp per SysV so loop invariants survive across every emit. CAPTURE_BAD_SLOT (0xFFFFE2DC) staged via `mov r10, 0xFFFFE2DC` for the sentinel compare (bit-31-set imm; movabs form per surface_present.pdx L242 idiom). Silent-skip (no consent, no live surface, or no covering grant) returns 0 -- indistinguishable from a successful emit at this ABI, matching surface_present_notify's own error-swallow discipline for the notify emit itself. No test rN,rN; no 2-op imul-imm; no `and reg, imm64`; no `cmp reg, [mem]` (CAPTURE_ROW_MAX loaded to r10 first). Labels prefixed fcm_.",
      block: {
        push rbp;
        mov rbp, rsp;
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;

        mov rbx, rdi;                        // rbx = surface_slot
        mov r15, rsi;                        // r15 = serial (= frame_id)

        // (1) Consent scan: walk _captures[0..CAPTURE_ROW_MAX).
        xor r12, r12;                        // r12 = i = 0

      fcm_scan_next:
        mov r10, [rip + CAPTURE_ROW_MAX];
        cmp r12, r10;
        jae fcm_no_consent;

        mov rdi, r12;
        call capture_row_source_get;

        // Sentinel check: CAPTURE_BAD_SLOT (0xFFFFE2DC) => not a live
        // row => skip to next.
        mov r10, 0xFFFFE2DC;
        cmp rax, r10;
        je  fcm_scan_advance;

        // Live row.  match iff source == 0 (fullscreen) OR source ==
        // surface_slot (per-surface grant).
        cmp rax, 0;
        je  fcm_have_consent;
        cmp rax, rbx;
        je  fcm_have_consent;

      fcm_scan_advance:
        add r12, 1;
        jmp fcm_scan_next;

      fcm_have_consent:
        // (2) Resolve sid via surface_row_addr(surface_slot) + 8.
        mov rdi, rbx;
        call surface_row_addr;
        cmp rax, 0;
        je  fcm_out_ok;                      // surface went dead; silent
        mov r13, [rax + 8];                  // r13 = surface_id (sid)

        // (3) Sample timestamp_ns.
        call hpet_now_ns;
        mov r14, rax;                        // r14 = timestamp_ns

        // (4) frame_capture_emit(frame_id=serial, timestamp_ns, sid,
        //                        bbox=0, format=0, width=0,
        //                        height=0, stride=0).  Stack args:
        //                        [rsp+0]=height, [rsp+8]=stride.
        xor rax, rax;
        sub rsp, 16;
        mov [rsp + 0], rax;                  // 7th arg: height = 0
        mov [rsp + 8], rax;                  // 8th arg: stride = 0
        mov rdi, r15;                        // frame_id = serial
        mov rsi, r14;                        // timestamp_ns
        mov rdx, r13;                        // surface_id
        xor rcx, rcx;                        // bbox_packed = 0
        xor r8,  r8;                         // format = 0
        xor r9,  r9;                         // width = 0
        call frame_capture_emit;
        add rsp, 16;

      fcm_out_ok:
        xor rax, rax;
        jmp fcm_out;

      fcm_no_consent:
        xor rax, rax;                        // silent skip; return 0

      fcm_out:
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        pop rbp;
        ret
      }
    }
}
