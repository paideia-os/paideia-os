// src/kernel/core/graphics/surface_commit_ops.pdx -- R113.M1-002 (paideia-os #2382)
//
// KIND_SURFACE commit-protocol ops: surface_attach_buffer,
// surface_damage, surface_commit.  Design authority:
// design/graphics/r113-m1-substrate.md (FROZEN 2026-09-08).
//
// Sibling of R113.M1-001 (kind_surface.pdx, #2381) which landed the
// KIND_SURFACE = 0x1B8 identity, the 64-byte row layout, the row pool
// substrate, the row accessors, the mint / destroy dispatchers, all
// five fingerprint tag byte arrays, and the failure taxonomy band
// 0xFFFFE110..0xFFFFE11F.  Also sibling to R113.M1-001b (cap_handler_
// surface.pdx, #2424) which wired the KIND_SURFACE cap-op dispatcher
// through the KGATE_* rights aliases (kind_surface.pdx §3.2).
//
// -----------------------------------------------------------------------------
// SCOPE (per issue #2382 + doc §9 milestone graph)
// -----------------------------------------------------------------------------
//
// M1-001b's dispatcher (cap_handler_surface.pdx) currently routes
// OP_SURFACE_COMMIT / _DAMAGE / _ATTACH directly to the raw row
// accessors (surface_row_swap / _damage_or / _pending_set).  Three
// gaps result:
//
//   * COMMIT emits NO fingerprint -- SURFACE COMMIT OK is a data-only
//     tag with no live emitter (documented in the M1-001 allowlist
//     entry as "emitter lands in R113.M1-002").
//   * COMMIT bumps NO stats -- _surface_stats[SURFACE_ST_COMMITS] is
//     unchanged by every dispatched commit.
//   * ATTACH does NOT validate its bo_slot argument -- any u64 < 2^32
//     that the caller supplies is silently accepted as pending_bo,
//     which the compositor then dereferences at scanout time.
//
// This landing closes those three gaps with three op bodies that layer
// over the raw row accessors:
//
//   * surface_attach_buffer(surface_slot, bo_slot, x_off, y_off)
//       -> 0 | SURFACE_BAD_SLOT | SURFACE_ATTACH_BAD_BO
//     Gate order: surface_slot valid -> bo_slot valid (via
//     kgb_tail_valid, kind_gpu_bo.pdx) -> surface_row_pending_set.
//     x_off/y_off are accepted per Wayland ABI but NOT persisted at
//     M1-002 -- doc §2 row layout carries no per-surface buffer-origin
//     field; buffer-origin state lives compositor-side (doc §11 non-
//     goals defer this to a later milestone).
//
//   * surface_damage(surface_slot, x, y, w, h)
//       -> 0 | SURFACE_BAD_SLOT
//     Packs (x, y, w, h) into a single u64 per doc §2's damage layout
//     (dx[15:0] | dy[31:16] | dw[47:32] | dh[63:48]) and unions into
//     the row's pending damage bbox via surface_row_damage_or.  This
//     is the kernel-internal-caller-friendly wrapper over the packed-
//     rect accessor; the cap-invoke dispatcher continues to call
//     surface_row_damage_or directly with an already-packed rect.  A
//     boot witness that speaks x/y/w/h uses this wrapper instead of
//     re-packing at every call site.  The briefing's packing (`x<<48
//     | y<<32 | w<<16 | h`) is the REVERSE endianness of doc §2's
//     frozen layout; per feedback-spec-vs-codebase-conflicts, the
//     frozen invariant (doc §2, three landed user-side consumers) wins.
//
//   * surface_commit(surface_slot) -> new_serial | error
//     Gate order: surface_slot valid -> pending_bo != 0 else
//     SURFACE_SWAP_NO_PENDING -> read sid from row+8 (via surface_row_
//     addr) -> surface_row_swap -> damage_region_clear -> _surface_
//     stats.commits++ -> klog SURFACE COMMIT OK sid=<n> serial=<n>
//     -> return new_serial.  The doc §4 accessor surface_row_swap
//     returns the post-bump next_serial (low 48 bits) which is the
//     commit-txn receipt this op returns.  The damage_region_clear
//     call (M1-003 #2383, damage_region.pdx dcl_) resets the per-
//     surface multi-rect damage side-table so the next frame starts
//     with an empty region -- the row+48 bbox from M1-002 stays as
//     a legacy summary, but M1-003's side-table is the authoritative
//     damage record downstream code reads.
//
// -----------------------------------------------------------------------------
// RIGHTS GATING -- OWNED BY THE DISPATCHER (kind_surface.pdx §3.2 KGATE_*)
// -----------------------------------------------------------------------------
//
// These op bodies do NOT check rights.  The task-briefing wording
// "validates rights (R_SURFACE_ATTACH_BUFFER=0x040)" means the op is
// REACHED VIA that rights gate (cap_handler_surface.pdx sh_op_attach
// checks R_SURFACE_KGATE_ATTACH before dispatching here); it does NOT
// mean the op body re-checks rights internally.  Layering the check
// twice would produce dead code (the dispatcher always gates before
// dispatch) and would duplicate the failure taxonomy (dispatcher
// returns INVOKE_DENIED = 0xFFFFFFFFFFFFFFFD; a second check here
// would return a different SURFACE_MINT_BAD_RIGHTS code, splitting
// the wire).
//
// Kernel-internal callers (a boot witness, a follow-on user-space
// bridge) that invoke these op bodies bypassing the dispatcher must
// perform their own rights check upstream, exactly as they would for
// any surface_row_* accessor call.  This landing does not create a
// rights-independent invocation surface -- the KGATE_* aliases remain
// the single source of truth (doc §3.2, kind_surface.pdx L99-103).
//
// -----------------------------------------------------------------------------
// FAILURE CODE REUSE (doc §5 -- FROZEN band 0xFFFFE110..0xFFFFE11F)
// -----------------------------------------------------------------------------
//
// The briefing named a new code SURFACE_COMMIT_NO_PENDING = 0xFFFFE118
// for the commit-with-no-pending arm.  Two problems: (a) 0xFFFFE118 is
// ALREADY taken by SURFACE_ATTACH_BAD_BO (kind_surface.pdx L148), and
// (b) the design doc §5 already carries SURFACE_SWAP_NO_PENDING =
// 0xFFFFE116 with exactly this semantic ("swap called with pending
// == 0").  Per feedback-spec-vs-codebase-conflicts and the doc's own
// freeze status, the doc wins: this landing uses
// SURFACE_SWAP_NO_PENDING (0xFFFFE116) for the commit-no-pending arm.
//
// The 0xFFFFE111 / 0xFFFFE112 slots stay "reserved for M2 additions"
// per doc §5 and are NOT touched by this landing.
//
// -----------------------------------------------------------------------------
// DISPATCHER WIRE-UP (companion edit at cap_handler_surface.pdx)
// -----------------------------------------------------------------------------
//
// The M1-001b dispatcher (cap_handler_surface.pdx) is edited alongside
// this file so that:
//
//   * sh_op_commit  -> call surface_commit           (was: call surface_row_swap)
//   * sh_op_attach  -> call surface_attach_buffer    (was: call surface_row_pending_set)
//
// sh_op_damage continues to call surface_row_damage_or directly with
// the dispatcher's already-packed rect (r14); routing through
// surface_damage's 5-arg unpack would just unpack-then-repack the
// same word.  surface_damage exists here for kernel-internal callers
// that speak (x, y, w, h) rather than a packed rect.
//
// -----------------------------------------------------------------------------
// ENCODER PITFALLS (per feedback_pdx_encoder_pitfalls v0.36+)
// -----------------------------------------------------------------------------
//
//   * No `test rN, rN` -- every zero-check uses `cmp rN, 0` + `je/jne`.
//   * No 2-op `imul r, imm` -- row-index math is via surface_row_addr
//     / surface_row_valid rather than local *64.
//   * No `and reg, imm64` -- rect packing uses `and reg, 0xFFFF` which
//     encodes as imm32=0x0000FFFF (sign bit clear at bit 31), safe per
//     mcfg.pdx L284 precedent (`and r10, 0xFFFF`).
//   * No `cmp reg, [mem]` -- every mem compare loads to a scratch first.
//   * No literal-scaled `[reg + N*8]` -- displacement form `[reg + 8N]`
//     used throughout.
//
// -----------------------------------------------------------------------------
// LABEL PREFIX
// -----------------------------------------------------------------------------
//
// `sab_` on surface_attach_buffer, `sdm_` on surface_damage, `scm_`
// on surface_commit.  All prefixes avoid the paideia-as reserved
// keyword set (feedback_paideia_as_reserved_labels).
//
// -----------------------------------------------------------------------------
// FINGERPRINT ALLOWLIST
// -----------------------------------------------------------------------------
//
// The `surface commit ok` allowlist entry in tools/verify-fingerprint-
// coverage.sh (added at R113.M1-001, #2381) said the emitter would
// land in R113.M1-002.  This file IS that emitter; the allowlist
// entry's reason updates in-place to note that the emitter has now
// landed and is reachable through the dispatcher's OP_SURFACE_COMMIT
// arm.  Assertability still requires a boot witness invoking commit
// end-to-end (no such witness exists in the default matrix today);
// the allowlist entry remains valid.

module SurfaceCommitOps = structure {

  // ==========================================================================
  // Fingerprint KV keys.  surface_k_sid ("sid\0") is already declared
  // in kind_surface.pdx; introduce surface_k_serial here for the
  // COMMIT OK second KV.  Byte count includes NUL terminator.
  // ==========================================================================

  pub let surface_k_serial : [u8; 7] = "serial\0"

  // ==========================================================================
  // surface_attach_buffer(surface_slot, bo_slot, x_off, y_off) -> u64
  //
  // Gate order:
  //   (1) surface_slot valid (surface_row_valid)      -> else SURFACE_BAD_SLOT
  //   (2) bo_slot valid (kgb_tail_valid, kind_gpu_bo) -> else SURFACE_ATTACH_BAD_BO
  //   (3) surface_row_pending_set(slot, bo)              (passthrough return)
  //
  // x_off/y_off are consumed per the Wayland-style op ABI but NOT
  // stored -- doc §2 row layout carries no per-surface buffer-origin
  // field; buffer-origin state lives compositor-side.  Discarding
  // them preserves the op-signature shape user-side callers expect
  // while keeping the row layout doc-frozen.
  //
  // Register plan: r12=surface_slot, r13=bo_slot.  Two callee-save
  // pushes + sub rsp,8 = 24 B; entry rsp%16==8 -> (8+24)=32, %16=0,
  // aligned for every nested call (surface_row_valid, kgb_tail_valid,
  // surface_row_pending_set) without further padding.  All three
  // callees are pure leaves / near-leaves that preserve callee-save
  // regs per SysV.
  // ==========================================================================

  pub let surface_attach_buffer : (u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (surface_slot: u64) (bo_slot: u64) (x_off: u64) (y_off: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R113.M1-002 (#2382): OP_ATTACH_BUFFER body. Gate order: (1) surface_slot valid via surface_row_valid else SURFACE_BAD_SLOT; (2) bo_slot valid via kgb_tail_valid (kind_gpu_bo.pdx L488) else SURFACE_ATTACH_BAD_BO; (3) surface_row_pending_set (passthrough return, 0 on success). Rights gating is the dispatcher's KGATE_ATTACH check (cap_handler_surface.pdx sh_op_attach), not this body -- see file header §RIGHTS GATING. x_off/y_off consumed but not stored (doc §2 row has no origin field; buffer-origin is compositor-side; doc §11 non-goals defers). Two callee-save pushes (r12=surface_slot, r13=bo_slot) + sub rsp,8 align rsp%16=0 (entry 8 + 16 + 8 = 32) for every nested call. Labels prefixed sab_.",
      block: {
        push r12;
        push r13;
        sub rsp, 8;

        mov r12, rdi;                        // surface_slot
        mov r13, rsi;                        // bo_slot
        // rdx/rcx (x_off/y_off) intentionally discarded -- see header.

        // (1) surface_slot valid
        mov rdi, r12;
        call surface_row_valid;
        cmp rax, 0;
        je  sab_bad_slot;

        // (2) bo_slot valid (kind_gpu_bo.pdx accessor)
        mov rdi, r13;
        call kgb_tail_valid;
        cmp rax, 0;
        je  sab_bad_bo;

        // (3) commit pending buffer -- passthrough return (0 on success,
        // SURFACE_BAD_SLOT if a caller somehow raced our (1) gate, which
        // is impossible in the single-threaded kernel bringup this file
        // targets but is passed through for defense-in-depth).
        mov rdi, r12;
        mov rsi, r13;
        call surface_row_pending_set;
        jmp sab_out;

      sab_bad_slot:
        mov rax, 0xFFFFE110;                 // SURFACE_BAD_SLOT
        jmp sab_out;
      sab_bad_bo:
        mov rax, 0xFFFFE118;                 // SURFACE_ATTACH_BAD_BO

      sab_out:
        add rsp, 8;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // surface_damage(surface_slot, x, y, w, h) -> u64
  //
  // Gate order:
  //   (1) Pack rect: packed = (h<<48) | (w<<32) | (y<<16) | x per doc §2
  //   (2) surface_row_damage_or(slot, packed)  (passthrough: 0 | BAD_SLOT)
  //
  // Rect packing MUST be computed BEFORE any nested call because rdx/
  // rcx/r8/r9 (SysV arg regs for x/y/w/h) are caller-save and would be
  // clobbered by the very first call.  Pack into r13 (callee-save) up
  // front, then invoke the accumulator.
  //
  // Register plan: r12=surface_slot, r13=packed_rect.  Two callee-save
  // pushes + sub rsp,8 = 24 B; entry rsp%16==8 -> (8+24)=32, %16=0.
  // Scratch r10 used per-field during pack.
  // ==========================================================================

  pub let surface_damage : (u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (surface_slot: u64) (x: u64) (y: u64) (w: u64) (h: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R113.M1-002 (#2382): OP_DAMAGE_ADD body (kernel-internal caller variant). Packs (x,y,w,h) per doc §2 damage layout (dx[15:0]|dy[31:16]|dw[47:32]|dh[63:48]) into r13 pre-gate, then OR-unions into row+48 via surface_row_damage_or. Pack MUST run before surface_row_damage_or's call clobbers rdx/rcx/r8/r9 (SysV caller-save arg regs). Doc §2 packing is REVERSE of the briefing (which said x<<48 | y<<32 | w<<16 | h); doc wins per feedback-spec-vs-codebase-conflicts. Rights gating is the dispatcher's KGATE_DAMAGE check (cap_handler_surface.pdx sh_op_damage), not this body. The dispatcher continues to call surface_row_damage_or directly with an already-packed rect; this wrapper exists for kernel-internal callers (a boot witness) that speak unpacked coordinates. Two callee-save pushes + sub rsp,8 align rsp%16=0. `and reg, 0xFFFF` safe imm32 encoding (mcfg.pdx L284 precedent). Labels prefixed sdm_.",
      block: {
        push r12;
        push r13;
        sub rsp, 8;

        mov r12, rdi;                        // surface_slot

        // (1) Pack rect: (h<<48) | (w<<32) | (y<<16) | x per doc §2.
        // Each field masked to 16 bits via `and reg, 0xFFFF` (encodes
        // as imm32=0x0000FFFF, sign bit clear at bit 31 -- safe).
        mov r13, rsi;                        // r13 = x
        and r13, 0xFFFF;                     // r13 = x & 0xFFFF (bits 0-15)

        mov r10, rdx;                        // y
        and r10, 0xFFFF;
        shl r10, 16;                         // y in bits 16-31
        or  r13, r10;

        mov r10, rcx;                        // w
        and r10, 0xFFFF;
        shl r10, 32;                         // w in bits 32-47
        or  r13, r10;

        mov r10, r8;                         // h
        and r10, 0xFFFF;
        shl r10, 48;                         // h in bits 48-63
        or  r13, r10;

        // (2) OR packed rect into row+48.  surface_row_damage_or
        // performs its own slot-validity check (returns
        // SURFACE_BAD_SLOT on invalid); no explicit gate needed here.
        mov rdi, r12;
        mov rsi, r13;
        call surface_row_damage_or;

        add rsp, 8;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // surface_commit(surface_slot) -> new_serial | error
  //
  // Gate order:
  //   (1) surface_slot valid (surface_row_valid)    -> else SURFACE_BAD_SLOT
  //   (2) pending_bo != 0 (surface_row_pending_get) -> else SURFACE_SWAP_NO_PENDING
  //   (3) read surface_id from row+8 (via surface_row_addr)
  //   (4) surface_row_swap(surface_slot)            -> r14 = new_next_serial
  //   (5) surface_stats_bump_commits (kind_surface.pdx)
  //   (6) klog_s1_x2(LEVEL_INFO, SUBSYS_CAP_, surface_commit_ok_msg,
  //                  k_sid, sid, k_serial, new_serial)
  //   (7) return new_serial
  //
  // Note on (2): the doc §5 code for this arm is SURFACE_SWAP_NO_PENDING
  // (0xFFFFE116), NOT the briefing's proposed SURFACE_COMMIT_NO_PENDING
  // = 0xFFFFE118 (which collides with SURFACE_ATTACH_BAD_BO -- see
  // file header §FAILURE CODE REUSE).
  //
  // Note on (3): sid MUST be read BEFORE surface_row_swap because the
  // swap does not touch row+8 (surface_id) today, but reading pre-swap
  // keeps the emission ordering-independent of any future swap-body
  // revision.  Same discipline as surface_destroy's pre-scrub sid
  // read (kind_surface.pdx L961-963).
  //
  // Rights gating is the dispatcher's KGATE_COMMIT check (cap_handler_
  // surface.pdx sh_op_commit), not this body -- see file header
  // §RIGHTS GATING.
  //
  // Register plan: r12=surface_slot, r13=sid, r14=new_serial.  Three
  // callee-save pushes + sub rsp,8 = 32 B; entry rsp%16==8 -> (8+32)
  // = 40, %16=8 -- BAD.  Use three pushes + `sub rsp, 16` = 40 B ->
  // (8+40)=48, %16=0, aligned for every nested call without further
  // padding.
  //
  // klog_s1_x2 with v2 push idiom (bdev_write.pdx L809): `sub rsp, 8;
  // push v2; call klog_s1_x2; add rsp, 16`.  At rsp%16=0 before the
  // idiom: sub 8 -> %16=8, push -> %16=0, call, add 16 -> %16=0.
  //
  // klog_s1_x2 signature per klog/wrappers.pdx L72:
  //   (level, subsys, tag, k1, v1, k2) with v2 pushed as 7th arg on
  //   the caller stack.  Preserves rbx/r12-r15/rbp per SysV, so r13
  //   (sid) and r14 (new_serial) survive across the call.
  // ==========================================================================

  pub let surface_commit : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (surface_slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R113.M1-002 (#2382) + M1-003 (#2383) hook: OP_MINT_COMMIT_TXN body. Gate order: (1) surface_slot valid via surface_row_valid else SURFACE_BAD_SLOT; (2) pending_bo != 0 via surface_row_pending_get else SURFACE_SWAP_NO_PENDING (doc §5 semantic; NOT the briefing's colliding SURFACE_COMMIT_NO_PENDING at already-taken 0xFFFFE118); (3) read sid from row+8 via surface_row_addr (pre-swap for ordering-independence, mirrors surface_destroy's pre-scrub sid read); (4) surface_row_swap -> r14 = new_next_serial; (4a) damage_region_clear(slot) resets the M1-003 per-surface multi-rect side-table (damage_region.pdx dcl_); (5) surface_stats_bump_commits (kind_surface.pdx); (6) klog_s1_x2 sid=<r13> serial=<r14>; (7) return new_serial. Rights gating is the dispatcher's KGATE_COMMIT check, not this body. Three callee-save pushes (r12/r13/r14) + sub rsp,16 align rsp%16=0 (entry 8 + 24 + 16 = 48) for every nested call. damage_region_clear is a pure leaf that preserves callee-saves. klog_s1_x2 v2 push idiom (bdev_write.pdx L809): sub 8; push r14; call klog_s1_x2; add rsp, 16. klog_s1_x2 preserves rbx/r12-r15/rbp per SysV so r13/r14 survive. Labels prefixed scm_.",
      block: {
        push r12;
        push r13;
        push r14;
        sub rsp, 16;

        mov r12, rdi;                        // surface_slot

        // (1) surface_slot valid
        mov rdi, r12;
        call surface_row_valid;
        cmp rax, 0;
        je  scm_bad_slot;

        // (2) pending_bo != 0
        mov rdi, r12;
        call surface_row_pending_get;
        cmp rax, 0;
        je  scm_no_pending;

        // (3) read sid from row+8.  surface_row_addr returns row_base
        // pointer post-liveness (0 if the row went un-live between our
        // (1) gate and here, which is impossible in single-threaded
        // kernel bringup but re-checked defensively).
        mov rdi, r12;
        call surface_row_addr;
        cmp rax, 0;
        je  scm_bad_slot;
        mov r13, [rax + 8];                  // r13 = surface_id

        // (4) atomic swap: current<-pending, pending<-0, bump next_serial.
        // Returns post-bump next_serial (low 48 bits) or SURFACE_BAD_SLOT
        // (0xFFFFE110) if the slot went invalid; we've re-validated at
        // step (3) so this is defense-in-depth only.
        mov rdi, r12;
        call surface_row_swap;
        mov r14, rax;                        // r14 = new_next_serial

        // (4a) M1-003 (#2383): reset the per-surface damage region after
        // the swap.  damage_region_clear (damage_region.pdx dcl_) is a
        // pure leaf that zeros _damage_counts[slot]; it preserves all
        // callee-save regs so r12 (slot) and r14 (new_serial) survive.
        // Return value is DMG_OK on success or DMG_BAD_SLOT for an
        // out-of-range slot; we've already gate-checked slot at step
        // (1) so a stale DMG_BAD_SLOT here is impossible and the return
        // value is discarded.  The clear runs UNCONDITIONALLY on every
        // commit -- the M1-002 row+48 bbox is a legacy summary that
        // M1-003 supersedes for the multi-rect region; clearing the
        // side-table on commit is the M1-003 contract per doc §9.
        mov rdi, r12;
        call damage_region_clear;

        // (5) stats.commits++
        call surface_stats_bump_commits;

        // (6) emit fingerprint: SURFACE COMMIT OK sid=<r13> serial=<r14>.
        //   klog_s1_x2(LEVEL_INFO=3, SUBSYS_CAP_, surface_commit_ok_msg,
        //              surface_k_sid, sid, surface_k_serial, new_serial)
        // v2 (new_serial) pushed as 7th arg per klog_s1_x2 ABI
        // (wrappers.pdx L72).  bdev_write.pdx L809 push idiom: sub 8;
        // push v2; call; add 16.
        mov rdi, 3;                          // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + surface_commit_ok_msg];
        lea rcx, [rip + surface_k_sid];
        mov r8, r13;                         // v1 = sid
        lea r9, [rip + surface_k_serial];
        sub rsp, 8;
        push r14;                            // v2 = new_serial
        call klog_s1_x2;
        add rsp, 16;

        // (7) return new_serial
        mov rax, r14;
        jmp scm_out;

      scm_bad_slot:
        mov rax, 0xFFFFE110;                 // SURFACE_BAD_SLOT
        jmp scm_out;
      scm_no_pending:
        mov rax, 0xFFFFE116;                 // SURFACE_SWAP_NO_PENDING

      scm_out:
        add rsp, 16;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }
}
