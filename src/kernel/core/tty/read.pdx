// src/kernel/core/tty/read.pdx — R16-M5-005 (#606)
// tty_read + tty_read_try — cooked-mode reader for TTY vnode.
//
// Per design/kernel/r16-m5-005-tty-read-blocking.md:
//
//   tty_read_try(vn, buf, len, off) -> u64
//     Non-blocking peek. If _tty_line_complete == 1, copies
//     min(len, _tty_line_head) bytes from _tty_line_buf to buf,
//     calls tty_line_reset, and returns the byte count.
//     Otherwise returns 0.
//
//   tty_read(vn, buf, len, off) -> u64
//     Blocking wrapper. Loops: tty_read_try; if 0, install
//     _current_tcb as RX waiter (under cli guard, see design
//     §3.8 race analysis) and call sched_block; retry on wake.
//     This is the function the vops slot at _tty_vops[+0] points
//     to; its address stays stable across the #603 → #606
//     substitution (monotonic body growth per #603 §3.3.3).
//
// Witness fixture: _tty_read_witness_buf : [u8; 64] — .bss slab
//   used ONLY by the kernel_main witness at #606. Not touched
//   by any production caller. See design §5.3.

module Read = structure {
  // === Witness fixture (kernel_main-only) ===
  pub let mut _tty_read_witness_buf : [u8; 64] = uninit @align(8)

  // ==========================================================================
  // tty_read_try(vn, buf, len, off) -> u64 — leaf, non-blocking
  // ==========================================================================
  // Input:  rdi = vn (ignored — single-tty at R16.M5)
  //         rsi = buf (destination base)
  //         rdx = len (max bytes)
  //         rcx = off (ignored — streaming device)
  // Output: rax = bytes copied (0 if _tty_line_complete == 0)
  //
  // Side effects (fast path):
  //   buf[0..n] := _tty_line_buf[0..n]  where n = min(len, _tty_line_head)
  //   _tty_line_head := 0
  //   _tty_line_complete := 0
  //
  // Side effects (empty path): none.
  //
  // Clobbers (SysV caller-save): rax, rcx, rdx, r8, r9.
  // Preserves rbx (via push/pop) — used to carry n across tty_line_reset.
  pub let tty_read_try : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (vn: u64) (buf: u64) (len: u64) (off: u64) -> unsafe {
      effects: { mem },
      capabilities: { },
      justification: "R16-M5-005 (#606): non-blocking cooked-mode reader. Reads _tty_line_complete via `mov rax, [rip + _tty_line_complete]` (RIP-relative qword load — landed at core/tty/line_buffer.pdx:118). If 0, returns 0 with no side effect (empty path — see design §3.5). If 1 (fast path — see design §3.4), computes n = min(len, _tty_line_head) via `mov rax, [rip + _tty_line_head]; cmp rax, rdx; jbe use_head; mov rax, rdx; use_head:` then spills n to callee-save rbx across the subsequent `call tty_line_reset` (which clobbers rax). Byte-copy loop: `lea r8, [rip + _tty_line_buf]` for src base, `xor rcx, rcx` for cursor, then per iteration `mov r9, r8; add r9, rcx; mov_b rax, [r9+0]; mov r9, rsi; add r9, rcx; mov_b [r9+0], rax; add rcx, 1; cmp rcx, rbx; jb loop`. Uses lea+add composition instead of SIB [base+idx] to stay within the audited idiom set — same discipline as core/tty/line_buffer.pdx:52-53 for its own single-index case. Post-copy: `call tty_line_reset` (zeroes head + complete; clobbers rax only — line_buffer.pdx:96-100), `mov rax, rbx` restores n, `pop rbx; ret`. Leaf-adjacent (single nested call to tty_line_reset which is itself leaf). Push rbx at entry makes rsp%16==0 for the nested call per SysV; symmetric pop restores caller's rsp%16==8. Return convention: rax = n. 0 return distinguishes empty from EOF only externally (§3.9); at R16.M5 both map to 0 and the wrapper retries either way. Called by (a) this issue's witness (all 5 sub-tests); (b) the sibling tty_read blocking wrapper; (c) (future) R17+ syscall dispatcher when the fd carries O_NONBLOCK. No user-pointer validation — R17+ syscall entry stub will bounds-check buf/len before calling. Truncation on len < head is unconditional-reset-with-drop (§3.6 documents the R17+ read-cursor upgrade path). Audit: r16-m5-005-tty-read-blocking.",
      block: {
        push rbx;

        // Empty-path guard: return 0 if no complete line.
        mov  rax, [rip + _tty_line_complete];
        cmp  rax, 0;
        je   ttr_try_empty;

        // n = min(len, _tty_line_head), stashed in callee-save rbx.
        mov  rax, [rip + _tty_line_head];
        cmp  rax, rdx;
        jbe  ttr_n_is_head;
        mov  rax, rdx;
      ttr_n_is_head:
        mov  rbx, rax;

        // Copy loop: for i in 0..n: buf[i] := _tty_line_buf[i].
        lea  r8, [rip + _tty_line_buf];
        xor  rcx, rcx;
      ttr_copy_loop:
        cmp  rcx, rbx;
        jae  ttr_copy_done;

        // src byte
        xor  rax, rax;
        mov  r9, r8;
        add  r9, rcx;
        mov_b rax, [r9 + 0];

        // dst byte
        mov  r9, rsi;
        add  r9, rcx;
        mov_b [r9 + 0], rax;

        add  rcx, 1;
        jmp  ttr_copy_loop;

      ttr_copy_done:
        call tty_line_reset;               // zeroes head + complete
        mov  rax, rbx;                     // return n
        pop  rbx;
        ret;

      ttr_try_empty:
        xor  rax, rax;                     // return 0
        pop  rbx;
        ret
      }
    }

  // ==========================================================================
  // tty_read(vn, buf, len, off) -> u64 — blocking wrapper (vops slot)
  // ==========================================================================
  // Input:  rdi = vn, rsi = buf, rdx = len, rcx = off
  // Output: rax = bytes copied (always > 0 in blocking-mode contract)
  //
  // At R16.M5 this function is code-committed per monotonic-growth contract
  // (#603 §3.3.3) but not runtime-exercised (would deadlock boot thread).
  // Runtime exercise lands at #609 closer smoke + R17 syscall dispatch.
  // See design §5.4 for full justification.
  //
  // For R16.M5, this is a minimal stub that delegates to tty_read_try.
  // The full blocking implementation (spill buf→rbx, len→r12, cli guard,
  // waiter install, sched_block loop) is deferred until the wrapper is
  // actually called at syscall dispatch (#608+).
  //
  // Clobbers (SysV caller-save): rax, rcx, rdx, rdi, rsi, r8, r9.
  pub let tty_read : (u64, u64, u64, u64) -> u64 !{mem, sysreg} @{sched} =
    fn (vn: u64) (buf: u64) (len: u64) (off: u64) -> unsafe {
      effects: { mem, sysreg },
      capabilities: { sched },
      justification: "R16-M5-005 (#667) + R17-M5 (#748): blocking wrapper — spill buf/len across sched_block via rbx/r12 callee-save; fast-try-then-cli-drain-then-retry-then-block loop. Fast path (line_buf already has a complete line): call tty_read_try immediately without cli; if rax != 0 return. This preserves the pre-process_init witness discipline where line_buf is prefilled directly (kernel_main.pdx tty_vops witness Sub-test C at line 5983-5997) and the wrapper never enters the slow path or touches _current_tcb. Slow path (line_buf empty): cli; call tty_stdin_drain (#748 bridge — pumps _uart_rx_ring bytes through tty_process_input so IRQ-delivered UART input reaches _tty_line_buf); re-call tty_read_try under the still-held cli; if bytes materialized after drain, sti and return them (the sti-before-jmp releases IF that the drain window held). If still empty after drain, install waiter and sched_block — the drain-then-set-waiter-then-block sequence is atomic under cli so no byte can arrive between the empty-check and the block (closing the classic condition-variable wake race per design/kernel/r17-m5-636-shell-binary-seed.md prereq #3). sched_block internally releases IF via its context-switch path (per sched_block's own contract); on wake we jmp ttr_retry from the top so the ret-from-block re-runs the fast-path check first. Requires _current_tcb.state == RUNNABLE (post-#663 sched_block guard); pre-process_init callers must reach the fast path via a pre-filled line_buf (verified by the tty_vops witness prefill).",
      block: {
        push rbx;
        push r12;
        mov  rbx, rsi;                     // spill buf
        mov  r12, rdx;                     // spill len

      ttr_retry:
        // ---- Fast path: check line_buf without cli ----
        mov  rsi, rbx;                     // restore args
        mov  rdx, r12;
        call tty_read_try;
        cmp  rax, 0;
        jne  ttr_read_done;                // got bytes → return

        // ---- Slow path: atomic drain-then-recheck-then-block under cli ----
        //
        // The cli here is load-bearing for the wake race, not for drain
        // state protection: it ensures that (a) any byte still in the
        // ring is pulled into line_buf and re-checked before we commit
        // to blocking, and (b) if we DO commit, no IRQ can slip a byte
        // + wake between the set_waiter store and the sched_block state
        // flip. sched_block's own switch path releases IF; on the wake
        // return, we re-enter this loop with IF=1 and the fast path
        // handles the (typical) case where the woken byte satisfies the
        // read outright.
        cli;

        // #748 bridge: pump _uart_rx_ring → tty_process_input →
        // _tty_line_buf so bytes IRQ-delivered by uart_rx_isr become
        // visible to tty_read_try.
        call tty_stdin_drain;

        // Re-check line_buf now that the drain has potentially made
        // it non-empty (the common case for interactive typing: user
        // just pressed Enter, byte arrived + IRQ fired between our
        // fast-path try and this drain).
        mov  rsi, rbx;                     // restore args (try clobbered rsi/rdx)
        mov  rdx, r12;
        call tty_read_try;
        cmp  rax, 0;
        je   ttr_go_block;                 // still empty → commit to block

        // Got bytes from the drain. Release IF (cli was ours to hold
        // only across the drain-then-check atomicity window) and
        // fall through to the shared return.
        sti;
        jmp  ttr_read_done;

      ttr_go_block:
        // Still nothing. Install ourselves as the RX waiter and sleep.
        // The atomic set-waiter → sched_block hand-off is what makes
        // the wake path correct: the ISR's uart_rx_notify_wake_if_waiter
        // (rx_isr.pdx:75) will observe the just-set waiter slot on the
        // very next byte, clear it, and sched_wake us.
        //
        // #748 debugger verify fix: sti BEFORE sched_block.
        // sched_switch_r15 (switch.pdx:98-243) captures caller's live
        // RFLAGS on entry via pushfq/pop and stores into TCB regs_save;
        // sched_switch_r15_continuation popfq's it verbatim on wake.
        // With cli held at entry from the drain window above, IF=0
        // gets saved → task wakes with interrupts disabled → timer
        // preempt + all IRQs stay masked indefinitely for that task.
        // Mirror the drain-succeeded path's sti to ensure IF=1 is
        // captured. The tiny cli→set_waiter→sti→sched_block window
        // is race-safe because set_waiter is atomic and the ISR
        // wake-if-waiter check is idempotent under the resulting
        // interrupt-visible state.
        mov  rdi, [rip + _current_tcb];
        call uart_rx_notify_set_waiter;
        sti;
        call sched_block;                  // returns after ISR sched_wake
        jmp  ttr_retry;

      ttr_read_done:
        pop  r12;
        pop  rbx;
        ret
      }
    }
}
