// PaideiaOS Phase-2 Capability Kind Enum
// P2-004: cap kind enum (16 base kinds per linearity-and-tags §3.1)
//
// Per design/capabilities/linearity-and-tags.md §3.1:
// Capability kinds are a closed enum of 16 base kinds, encoded in 4 LAM tag bits.
// The kernel's descriptor-table dispatch on kind is an exhaustive switch per the
// FP discipline (substructural lattice). Userspace defines derived kinds purely in
// the type system (functor-typed); the kernel sees only the base kind at runtime.
//
// The 16 base kinds are:
//   0  — null (placeholder, unused descriptor)
//   1  — process (TCB pointer, CSpace root)
//   2  — thread (inherited from Phase 1 API; maps to scheduler context in Phase 2+)
//   3  — page table (memory management, paging structures)
//   4  — page (individual memory page or region)
//   5  — ipc endpoint (Send or Recv side IPC primitive endpoint)
//   6  — ipc port (port-mapped I/O capability)
//   7  — scheduler context (budget, period, priority donation per seL4-MCS)
//   8  — timer (event scheduling and wakeups)
//   9  — interrupt (vector number, CPU affinity mask)
//  10  — device (device memory region and configuration)
//  11  — io port (I/O port access, per driver)
//  12  — notification (async signaling primitive)
//  13  — reply (return-path endpoint for RPC)
//  14  — hw (R29.M0-001 #1017: hardware-adjacent base kind — parent for
//           KIND_INTERRUPT / KIND_MSIX_VECTOR / KIND_DMA_DOMAIN /
//           KIND_HW_TIMELINE landing in R29.M1 #1019-#1022; enables
//           LAM kind-hint fast-dispatch for hardware caps per
//           design/roadmap/next-wave-synthesis.md §10 D6)
//  15  — reserved (reserved for future expansion; today: confidential-
//           computing / TDX per CAP-Q9 open issue + KIND_DMESG derived-
//           kind base per logging-m9-001)
//
// Slot 15 remains reserved deliberately for the confidential-computing
// / TDX growth path (per CAP-Q9); slot 14 was previously reserved (as
// "fault") and is promoted here to KIND_HW per D6 to shelter the family
// of hardware-adjacent derived kinds. The LAM kind-hint must remain 4
// bits, so any future post-D6 base-kind addition would need to displace
// slot 15 and require a major-version event.
//
// R29.M0-001 (#1017) note on the prior "fault" label at slot 14: no
// paideia-os code path ever referenced KIND_FAULT at runtime — it was
// carried in the header comment as a reservation placeholder only (grep
// confirms zero call-site consumers before this rename). Exception /
// fault handling under Phase-2+ is expressed via the R15/R18 IDT + IST
// substrate (design/kernel/interrupts.md), not via a base-kind cap.
// Promoting slot 14 to KIND_HW is therefore a pure enum-label change
// with no dispatch, mint, or descriptor-tail impact today; the
// cap_invoke_dispatch fallthrough (identity return of target_ptr, see
// src/kernel/core/cap/invoke.pdx) still applies to slot-14 caps until
// R29.M1 lands the per-derived-kind handlers.

module Kind = structure {

  // ============================================================================
  // 16-bit capability kind constants (4-bit enum, fits in LAM tag)
  // ============================================================================

  let KIND_NULL : u64 = 0
  let KIND_PROCESS : u64 = 1
  let KIND_THREAD : u64 = 2
  let KIND_PAGE_TABLE : u64 = 3
  let KIND_PAGE : u64 = 4
  // KIND_IPC_ENDPOINT (=5). R20b.M1-001 (#1552) formalizes the
  // descriptor tail (target_ptr) for this kind: bits [15:0] =
  // endpoint_id, bits [17:16] = direction (0=send, 1=recv, 2=bidi),
  // bits [63:18] reserved. See src/kernel/core/cap/kind_endpoint.pdx
  // for the encode/decode helpers, rights refinement, and mint gate,
  // and design/ipc/userspace-server-substrate.md §3.1 for the shape.
  // Base slot 5 is unchanged; the tail is a static refinement, not a
  // new base kind.
  let KIND_IPC_ENDPOINT : u64 = 5
  let KIND_IPC_PORT : u64 = 6
  // R29.M5-001 (#1036): KIND_MEMORY is the name the design documents use
  // for the memory base kind (see design/roadmap/next-wave-softarch.md
  // §P10, which lists KIND_MEMORY alongside KIND_IPC_ENDPOINT /
  // KIND_DEVICE / KIND_INTERRUPT as a derivation base). The runtime
  // 16-slot enum spells that same base kind as KIND_PAGE = 4 —
  // "individual memory page or region", whose dispatch chatter is
  // literally "CAP INVOKE MEM" (cap_mem_msg in tags.pdx). Binding the
  // document vocabulary to the runtime slot ONCE, here, is what keeps
  // derived kinds that specify "derived over KIND_MEMORY" from drifting
  // onto a different slot. This is an alias, NOT a new base kind: the
  // closed 16-kind enum is unchanged.
  pub let KIND_MEMORY : u64 = 4
  let KIND_SCHED_CTX : u64 = 7
  let KIND_TIMER : u64 = 8
  let KIND_INTERRUPT : u64 = 9
  let KIND_DEVICE : u64 = 10
  let KIND_IO_PORT : u64 = 11
  let KIND_NOTIFICATION : u64 = 12
  let KIND_REPLY : u64 = 13
  // R29.M0-001 (#1017): slot 14 promoted from the prior "fault" placeholder
  // to KIND_HW — the base kind for hardware-adjacent capabilities. Per
  // design/roadmap/next-wave-synthesis.md §10 D6:
  //
  //   KIND_HW is the sheltering base for the R29.M1 derived-kind family:
  //     KIND_HW_INTERRUPT      (#1019, landed) — vector + CPU affinity + trigger mode
  //     KIND_HW_MSIX_VECTOR    (#1022, landed) — MSI-X vector under an interrupt parent
  //     KIND_HW_TIMELINE       (planned later) — monotonic hardware clock domain
  //
  //   (A fourth skeleton, KIND_HW_DMA_DOMAIN, was listed here at
  //   R29.M0-001. R29.M5-001 #1036 renamed it to KIND_DMA_DOMAIN and
  //   re-based it over KIND_MEMORY (slot 4) — a DMA domain is a
  //   memory-access scope, not a device-authority handle. It is no
  //   longer part of the KIND_HW family; see the KIND_DMA_DOMAIN block
  //   at the end of this file.)
  //
  //   Fast-dispatch rationale: with KIND_HW at a base slot (4-bit LAM
  //   kind-hint), any hardware-adjacent cap can be routed by a single
  //   `cmp rcx, 14; je call_kind_hw` in cap_invoke_dispatch (identical
  //   shape to KIND_DEVICE dispatch at slot 10). Derived kinds refine
  //   the descriptor tail without displacing the LAM kind-hint.
  //
  // Today (R29.M0-001, this issue): the base kind is registered and
  // mintable; there is NO KIND_HW dispatch branch in invoke.pdx yet —
  // freshly minted KIND_HW caps fall through to the identity return
  // (rax = target_ptr) exactly as slots 11/14/15 did prior to this
  // change. The R29.M1 sub-issues introduce the derived kinds + tail
  // encoders + dispatch branch as a coordinated set.
  //
  // See design/architecture/next-wave-derived-kinds.md §KIND_HW for the
  // base-kind + tail-shape + rights-bitmask spec that R29.M1 refines.
  pub let KIND_HW : u64 = 14
  let KIND_RESERVED : u64 = 15

  // ============================================================================
  // Mask for extracting kind from LAM tag (4 bits)
  // ============================================================================

  let KIND_MASK : u64 = 0xF  // 4-bit mask, fits in LAM tag-bits 53-50

  // ============================================================================
  // D7-004: driver-registration kind
  // ============================================================================
  //
  // SPEC CONFLICT (resolved here): .plans §3 D7-004 says "KIND_DRIVER (new cap
  // kind, value 5)". Value 5 is already KIND_IPC_ENDPOINT in the binding closed
  // 16-kind enum above (design/capabilities/linearity-and-tags.md §3.1), and the
  // base enum is full (slots 0..15 assigned; 14/15 reserved). Silently
  // reassigning slot 5 would break every IPC-endpoint capability in the system.
  //
  // Resolution per Pillar 6 (security by construction) and the closed-enum
  // invariant: KIND_DRIVER is a DERIVED kind, not a new base kind. At runtime it
  // is carried as KIND_DEVICE (base 10) — a driver capability authorises
  // device-memory + config access — with the "driver" refinement expressed in
  // the descriptor's kind-specific tail (the manifest pointer, D7-004). The
  // numeric tag below is above the 4-bit base range to make the derived nature
  // explicit and to avoid any LAM-tag collision.
  let KIND_DRIVER_BASE : u64 = 10        // = KIND_DEVICE (runtime base kind)
  let KIND_DRIVER : u64 = 0x15           // derived-kind tag (decimal 21), out of 4-bit range

  // ============================================================================
  // logging-m9-001 (#708): KIND_DMESG — kernel log-ring stream cap
  // ============================================================================
  //
  // Per design/kernel/kernel-logging-substrate.md §12.10 — post-R18 Phase M9
  // observability handle. The base 4-bit enum (slots 0..15) is closed and full;
  // KIND_DMESG follows the KIND_DRIVER pattern above: derived-kind tag above
  // the 4-bit range (decimal 22) so the LAM kind-hint bits are unaffected, and
  // the runtime base kind stays KIND_RESERVED (15) — the closest semantic
  // match (an inert observability handle, not a scheduling/memory primitive).
  //
  // At mint time (kernel_main.pdx boot witness) the cap is written to the
  // static cap_table with descriptor.kind = KIND_DMESG (22). The linear
  // dispatch chain in cap_invoke_dispatch (src/kernel/core/cap/invoke.pdx)
  // matches on 22 and routes to cap_handler_dmesg.
  //
  // Rights: RIGHT_READ only (0x01). No mutation ops — the ring is written
  // exclusively by klog_emit_core; userspace holders only observe it.
  //
  // Ops (op_arg[7:0] = op_code):
  //   OP_READ_TAIL (0): copy up to op_arg[63:8] bytes from ring[tail..head]
  //                     into a kernel scratch buffer whose address is the
  //                     descriptor's target_ptr. Returns bytes copied.
  //   OP_STAT (1):      returns head packed with size — high 32 bits = head
  //                     (mod 2^32; wraps once every 2^32 log bytes; boot
  //                     workloads stay far below that), low 32 bits = ring
  //                     capacity (KLOG_RING_SIZE = 65536).
  let KIND_DMESG_BASE : u64 = 15         // = KIND_RESERVED (runtime base kind)
  pub let KIND_DMESG : u64 = 0x16        // derived-kind tag (decimal 22), out of 4-bit range

  // ============================================================================
  // R29.M1-001 (#1019): KIND_HW_INTERRUPT — first derived kind over KIND_HW.
  // ============================================================================
  //
  // Per design/roadmap/next-wave-synthesis.md §10 D6 + §3 R29 of
  // next-wave-softarch.md. Rides KIND_HW (base slot 14, promoted at
  // R29.M0-001 #1017). Numeric derived tag chosen distinct from every
  // existing derived kind (KIND_DRIVER=0x15, KIND_DMESG=0x16,
  // KIND_ACPI=0x20, KIND_PCI_DEV=0x30) and above the 4-bit base-slot
  // range so the LAM kind-hint (slot 14) survives.
  //
  // Descriptor payload: target_ptr = row_id in bits [15:0]; row lives in
  // _hw_interrupt_table (kind_hw_interrupt.pdx). Row encodes gsi/affinity
  // /edge_or_level per next-wave-derived-kinds.md §KIND_HW_INTERRUPT
  // and softarch §3 R29's {gsi:u32, cpu_affinity_mask:u64, edge_or_level:u8}
  // spec.
  //
  // Rights: R_HW_INT_INVOKE | R_HW_INT_REVOKE | R_HW_INT_MINT | R_HW_INT_OBSERVE
  //         = 0x008 | 0x010 | 0x200 | 0x400 = 0x618
  //
  // Handler: cap_handler_hw_interrupt in kind_hw_interrupt.pdx. Dispatched
  // via cap_invoke_dispatch on `cmp rcx, 0x140; je call_kind_hw_interrupt`.
  //
  // Slot-9 KIND_INTERRUPT (kind_interrupt.pdx legacy stub) is deprecated
  // at R29.M1-001 close but preserved as compatibility alias until R30
  // open — the two dispatch entries coexist in invoke.pdx.
  let KIND_HW_INT_BASE : u64 = 14         // = KIND_HW (runtime base kind)
  pub let KIND_HW_INTERRUPT : u64 = 0x140 // derived-kind tag (decimal 320)

  // ============================================================================
  // R29.M1-004 (#1022): KIND_HW_MSIX_VECTOR — second derived kind over
  // KIND_HW, layered atop KIND_HW_INTERRUPT.
  // ============================================================================
  //
  // Per design/roadmap/next-wave-synthesis.md §10 D6 and
  // design/architecture/next-wave-derived-kinds.md §KIND_HW_MSIX_VECTOR.
  // Rides KIND_HW (base slot 14) but derives semantically from
  // KIND_HW_INTERRUPT (0x140): a KIND_HW_INTERRUPT cap authorizes a
  // GSI/line, and mints N KIND_HW_MSIX_VECTOR children (one per MSI-X
  // vector on the underlying device). Numeric derived tag 0x141 is
  // adjacent to KIND_HW_INTERRUPT (0x140) in the R29 range; distinct
  // from every existing derived-kind tag.
  //
  // Descriptor payload: target_ptr = row_id in bits [15:0]; row lives
  // in _hw_msix_vector_table (kind_hw_msix_vector.pdx). Row encodes
  // {msix_table_offset:u32, msix_data:u32, parent_slot:u8} plus the
  // in_use flag + reserved u128 for R29.M2+ MSI-X wire-up state.
  //
  // Rights: R_MSIX_INVOKE | R_MSIX_REVOKE | R_MSIX_MINT
  //         = 0x008 | 0x010 | 0x200 = 0x218
  //
  // Handler: cap_handler_hw_msix_vector in kind_hw_msix_vector.pdx.
  // Dispatched via cap_invoke_dispatch on `cmp rcx, 0x141; je
  // call_kind_hw_msix_vector`.
  //
  // Revoke cascade: hw_int_cap_revoke (kind_hw_interrupt.pdx) calls
  // msix_cascade_revoke_by_parent before freeing the parent — no
  // dangling child descriptor can outlive its parent's revoke.
  pub let KIND_HW_MSIX_VECTOR : u64 = 0x141

  // ============================================================================
  // R29.M5-001 (#1036) / R29.M5-002 (#1037): KIND_DMA_DOMAIN — per-driver-
  // process IOMMU domain. Third entry in the R29 derived-kind block.
  // ============================================================================
  //
  // NAMING RECONCILIATION. design/architecture/next-wave-derived-kinds.md
  // carried a planning skeleton called `KIND_HW_DMA_DOMAIN` with runtime
  // base KIND_HW (14). design/roadmap/next-wave-softarch.md §3 R29 and
  // issues #1036/#1037 — the binding spec for this landing — name it
  // `KIND_DMA_DOMAIN` and derive it over KIND_MEMORY. The softarch/issue
  // form wins, and the catalog entry is renamed (not aliased) because no
  // code ever referenced the skeleton:
  //
  //   * A DMA domain is a MEMORY-ACCESS SCOPE, not a device-authority
  //     handle: it names the set of physical pages a bus-mastering device
  //     may reach. Deriving it over KIND_HW would let a holder of pure
  //     device authority manufacture memory reach, inverting the R29
  //     IOMMU invariant (domain cap authorizes the mapping SITE; a
  //     KIND_PAGE cap authorizes the PAGE). Deriving over KIND_MEMORY
  //     makes the mint gate structurally enforce "no widening a device's
  //     reach past memory authority you already hold".
  //   * Keeping the `HW_` infix while changing the base would leave the
  //     name asserting a base kind that is no longer true.
  //
  // Runtime base kind: KIND_MEMORY = KIND_PAGE = 4 (see the KIND_MEMORY
  // binding above). The LAM kind-hint therefore reads slot 4.
  //
  // Numeric derived tag 0x142 is retained from the catalog. The 0x14x
  // block is the R29-ROUND derived-kind block, not a base-slot encoding:
  // the pre-existing derived tags already have no correspondence between
  // tag prefix and base slot (KIND_DRIVER = 0x15 has base 10;
  // KIND_DMESG = 0x16 has base 15). Keeping 0x142 leaves the R29 block
  // contiguous (0x140 interrupt / 0x141 msix / 0x142 dma domain / 0x143
  // timeline reserved) and avoids re-numbering a published value.
  //
  // Descriptor payload: target_ptr = row_id in bits [15:0]; the row lives
  // in _dma_domain_table (kind_dma_domain.pdx) and encodes
  // {iommu_ctx_id:u32, bus_dev_fn:u16, capacity_bytes:u64, coherency:u8}
  // plus the parent_slot (u8, for cascade) and the in_use flag. Row
  // indirection is required because the tail is 104 live bits — it does
  // not fit the 64-bit target_ptr — and it deliberately reuses the exact
  // shape of KIND_HW_INTERRUPT / KIND_HW_MSIX_VECTOR rather than
  // inventing a third encoding.
  //
  // Rights: R_DMA_INVOKE | R_DMA_REVOKE | R_DMA_MINT | R_DMA_OBSERVE
  //         = 0x008 | 0x010 | 0x200 | 0x400 = 0x618
  //
  // Handler: cap_handler_dma_domain in kind_dma_domain.pdx. Dispatched
  // via cap_invoke_dispatch on `cmp rcx, 0x142; je call_kind_dma_domain`.
  //
  // Granularity: ONE domain per driver process (D1.b per
  // design/roadmap/next-wave-synthesis.md §10 and
  // design/drivers/blob-policy.md §2), shared across every device that
  // driver owns — not one per device.
  //
  // Revoke cascade: dma_cascade_revoke_by_parent(parent_slot) revokes
  // every KIND_DMA_DOMAIN whose row records that KIND_MEMORY ancestor,
  // so tearing down memory authority cannot leave a live IOMMU context
  // entry behind. R29.M5-003 wires it into driver-process teardown.
  pub let KIND_DMA_DOMAIN_BASE : u64 = 4   // = KIND_MEMORY (runtime base kind)
  pub let KIND_DMA_DOMAIN : u64 = 0x142    // derived-kind tag (decimal 322)

  // ============================================================================
  // R30.M3-001 (#1061): KIND_OP_REGION — the address-space window cap.
  // Opens the R30 derived-kind block (0x15x).
  // ============================================================================
  //
  // THIS IS THE SECURITY BOUNDARY OF R30. Every kind above it authorises
  // something the kernel itself already mediates. This one authorises
  // touching a PHYSICAL ADDRESS named by a firmware table that is
  // vendor-supplied, unsigned, and mutable by anyone who can reflash the
  // part. Per design/roadmap/next-wave-softarch.md §3 R30: the firmware
  // OperationRegion abstraction becomes a cap, and no other component of
  // the system can silently poke a hardware address.
  //
  // THE DERIVATION IS ASYMMETRIC, which is why the tail must record the
  // address space and why one derived tag serves two base slots:
  //
  //   memory-like space  -> derives over KIND_MEMORY  (= slot 4)
  //   port-like space    -> derives over KIND_IO_PORT (= slot 11)
  //
  // The reasoning is R29.M5-001's, one lattice over: deriving a
  // memory-space window over port authority would let a holder of the
  // lesser authority manufacture memory reach. `opregion_space_base_kind`
  // (kind_op_region.pdx) is the single table that decides, and the mint
  // gate consults it rather than accepting whichever parent the caller
  // happened to present.
  //
  // Because the base slot varies per row, the LAM kind-hint cannot be a
  // constant for this kind — which is exactly why cap_invoke_dispatch
  // compares the FULL u64 kind field (0x150) rather than the 4-bit slot,
  // as it already does for every derived kind.
  //
  // Descriptor payload: target_ptr = row_id in bits [15:0]; the row lives
  // in _op_region_table (kind_op_region.pdx) and encodes
  // {space:u8, base:u64, len:u64, parent_slot:u8, parent_row:u16,
  // is_root:u1}. Row indirection is required — 155 live bits do not fit
  // the 64-bit target_ptr — and it reuses the KIND_HW_INTERRUPT /
  // KIND_HW_MSIX_VECTOR / KIND_DMA_DOMAIN shape rather than inventing a
  // fourth.
  //
  // Rights: R_OPREG_READ | R_OPREG_WRITE | R_OPREG_INVOKE |
  //         R_OPREG_REVOKE | R_OPREG_MINT | R_OPREG_OBSERVE
  //         = 0x001 | 0x002 | 0x008 | 0x010 | 0x200 | 0x400 = 0x61B
  //
  // READ and WRITE are separate — a read-only window (a thermal or
  // battery region the supervisor may sample but must never poke) is a
  // shape this round needs, and folding both into INVOKE would make it
  // unexpressible.
  //
  // Handler: cap_handler_op_region in kind_op_region.pdx, dispatched on
  // `cmp rcx, 0x150; je call_kind_op_region`. QUERY ops only: there is
  // deliberately no "access this address" op, because a poke-op on the
  // capability would recreate one layer up the very property this kind
  // exists to remove.
  //
  // Acquisition, and why "forgot to check the cap" is not expressible:
  // _op_region_table has exactly one writer (opregion_tail_alloc) with
  // exactly two callers. The ROOT path demands the base-kind parent the
  // space requires, carrying RIGHT_MINT, and encodes platform knowledge
  // — it is not an op on any capability, so nothing holding only a
  // KIND_OP_REGION can reach it. The DERIVE path — the one a
  // firmware-declared region takes — containment-checks the request
  // against the parent row's own base and length and REFUSES
  // (OPREG_MINT_NO_COVER) rather than clipping. Truncating instead would
  // turn the capability system into an address oracle.
  //
  // Revoke cascade: opregion_cascade_revoke_by_parent is TRANSITIVE (a
  // window may be derived from a window), implemented as a fixed-point
  // scan so a teardown path carries no unbounded recursion.
  //
  // See design/architecture/next-wave-derived-kinds.md §KIND_OP_REGION.
  pub let KIND_OP_REGION_BASE_MEMORY : u64 = 4    // memory-like spaces
  pub let KIND_OP_REGION_BASE_PORT   : u64 = 11   // port-like spaces
  pub let KIND_OP_REGION : u64 = 0x150            // derived-kind tag (336)

  // ---------------------------------------------------------------------
  // KIND_FW_SESSION (0x155): authority to open ONE evaluation session
  // against ONE firmware-supplied object, plus the arbitration deciding
  // which of several concurrent sessions may WRITE it. Sixth and last
  // entry in the R30 derived-kind block (0x150 op_region / 0x151
  // acpi_event / 0x152 i2c_bus / 0x153 i2c_slave / 0x154 gpio_line /
  // 0x155 fw_session).
  //
  // Derives over KIND_IPC_ENDPOINT (base slot 5) because a session is a
  // conversation with the ACPI supervisor. The kind check alone is an
  // EMPTY GATE — every endpoint in the system is a KIND_IPC_ENDPOINT,
  // the shell's stdout included — so the mint's second half requires the
  // parent's INHERITED endpoint id to be registered as a firmware-object
  // endpoint for the requested op-region domain.
  //
  // THE NAME. The R30 catalog called this KIND_AML_SESSION, and that
  // identifier cannot be spelled anywhere under src/kernel/** because
  // tools/lint-no-kernel-aml.sh forbids it (design/acpi/
  // no-aml-in-kernel.md §3). #1569 renamed the capability rather than
  // weakening the lint, ahead of the issue that introduced it; see
  // cap/kind_fw_session.pdx for the full argument.
  //
  // Dispatched via cap_invoke_dispatch on `cmp rcx, 0x155; je
  // call_kind_fw_session`, comparing the FULL u64 kind field rather than
  // the 4-bit LAM slot, so it coexists with the slot-5 endpoint handler.
  //
  // See design/architecture/next-wave-derived-kinds.md §KIND_FW_SESSION.
  pub let KIND_FW_SESSION_BASE : u64 = 5          // = KIND_IPC_ENDPOINT
  pub let KIND_FW_SESSION : u64 = 0x155           // derived-kind tag (341)

  // ---------------------------------------------------------------------
  // KIND_EC_QUERY (0x156): the right to be told that ONE embedded
  // controller raised ONE of a named set of query events. First entry
  // past the R30 derived-kind block.
  //
  // Derives over KIND_IPC_ENDPOINT (base slot 5), like KIND_FW_SESSION
  // and for the same reason — being told about something is a
  // conversation — and, like KIND_FW_SESSION, THE KIND HALF OF THAT GATE
  // IS EMPTY ON ITS OWN. Every endpoint in the machine is a
  // KIND_IPC_ENDPOINT, the shell's stdout included, so a gate that
  // stopped at the kind would let any process holding any endpoint mint
  // itself a subscription to the embedded controller. This is the #1075
  // lesson's second instance.
  //
  // The second half is a SECOND CAPABILITY ARGUMENT rather than a
  // registry lookup: `region_slot` must be a live KIND_OP_REGION (0x150)
  // carrying RIGHT_MINT whose address space is OPREG_SPACE_EC (0x03) and
  // whose declared length is in 1..256. The two halves prove unrelated
  // things — WHERE the holder will be told, and WHICH controller it will
  // be told about — and the controller's address is then INHERITED from
  // the region's own row rather than accepted as an argument, so a
  // subscription cannot be stamped with one machine's address while its
  // region capability names another.
  //
  // Dispatched via cap_invoke_dispatch on `cmp rcx, 0x156; je
  // call_kind_ec_query`, comparing the FULL u64 kind field rather than
  // the 4-bit LAM slot, so it coexists with the slot-5 endpoint handler.
  //
  // NOT LOADER-SEEDABLE, and deliberately absent from
  // KIND_SEEDABLE_TABLE below. #1597's rule refuses a kind DEFINED BY
  // ITS DERIVATION, because seeding manufactures a root with no parent.
  // This kind is the strongest case for that rule in the tree: both
  // parents are load-bearing, one of them supplies the controller
  // address the row records, and a sidecar entry naming it would create
  // a subscription to an address taken from untrusted image bytes with
  // no region capability behind it.
  //
  // See design/architecture/next-wave-derived-kinds.md §KIND_EC_QUERY
  // and cap/kind_ec_query.pdx.
  pub let KIND_EC_QUERY_BASE : u64 = 5            // = KIND_IPC_ENDPOINT
  pub let KIND_EC_QUERY : u64 = 0x156             // derived-kind tag (342)

  // ============================================================================
  // KIND_THERMAL_ZONE (0x157): one ACPI thermal zone's trip points, and
  // the right to be told which side of them a temperature falls on.
  // ============================================================================
  //
  // Derived over KIND_DEVICE (base slot 10), the third kind in the tree to
  // take that parent after KIND_I2C_BUS and KIND_GPIO_LINE, and the third
  // time the kind half of the gate discriminates NOTHING: every PCI
  // function in the machine is a KIND_DEVICE.
  //
  // WHAT MAKES THIS ONE DIFFERENT FROM KIND_GPIO_LINE, whose second half
  // was a lookup in the table of probed pad controllers. THERE IS NO SUCH
  // TABLE HERE AND THERE CANNOT BE ONE IN THIS RING. "This device is a
  // thermal zone" is true because the firmware namespace declares it, and
  // reading that declaration is bytecode evaluation, which
  // design/acpi/no-aml-in-kernel.md forbids in ring 0 down to the token
  // level. So the mint enforces the four things the kernel CAN check --
  // the inherited device key is non-zero, no other live row holds it, the
  // critical threshold is plausible, the hysteresis is not zero -- and
  // cap/kind_thermal_zone.pdx §5 states the limit plainly rather than
  // letting a future reader take the kind check for a hardware proof. The
  // discrimination is performed by the ring-3 supervisor that walked the
  // namespace, and the capability is the record of ITS decision.
  //
  // THE UNIT IS DECI-KELVIN, everywhere, with no conversion on the control
  // path. ACPI reports temperature in tenths of a Kelvin; the one
  // conversion in the module is display-only and confined by
  // tools/build.sh. See kind_thermal_zone.pdx §0 for why that is the
  // single most important sentence about this kind.
  //
  // Dispatched via cap_invoke_dispatch on `cmp rcx, 0x157; je
  // call_kind_thermal_zone`, comparing the full u64 kind field rather than
  // the 4-bit LAM base slot, so it coexists with the slot-10 KIND_DEVICE
  // handler.
  //
  // NOT LOADER-SEEDABLE, and the refusal needs no code: kind_is_loader_
  // seedable scans an enumeration and a kind absent from it is refused.
  // Stating the decision here is what #1597 asks for; adding the entry is
  // what it forbids. Two reasons, and the second is specific to this kind.
  // (1) Like every derived kind, it is DEFINED by its derivation: seeding
  // one from a sidecar would manufacture a root with no parent, which is
  // not a shortcut to the same object but a different and unparented one.
  // (2) Its target_ptr is a ROW INDEX into _thermal_zone_table, and a
  // sidecar is untrusted image bytes — so a seeded entry would let an
  // image name a row it did not create and thereby claim a zone, and its
  // trip points, belonging to some other part. On this kind that is not
  // an abstract escalation: the row it would reach holds a CRITICAL
  // THRESHOLD, and the authority to be believed about a part's
  // temperature is the authority to have the machine powered off. A
  // supervisor that wants a zone capability derives it from the
  // KIND_DEVICE capability for the part, which is exactly the gate that
  // makes the identity inheritable rather than argued.
  //
  // See design/architecture/next-wave-derived-kinds.md §KIND_THERMAL_ZONE
  // and cap/kind_thermal_zone.pdx.
  pub let KIND_THERMAL_ZONE_BASE : u64 = 10       // = KIND_DEVICE
  pub let KIND_THERMAL_ZONE : u64 = 0x157         // derived-kind tag (343)

  // ============================================================================
  // KIND_BATTERY (0x158): one battery pack's static identity — index,
  // design capacity in mWh, chemistry — and the right to be told what its
  // most recently reported percent, voltage and state were.
  // ============================================================================
  //
  // Derived over KIND_DEVICE (base slot 10), the fourth kind in this file
  // to take that parent after KIND_I2C_BUS, KIND_GPIO_LINE and
  // KIND_THERMAL_ZONE, and the fourth time the kind half of the gate
  // discriminates NOTHING: every PCI function in the machine is a
  // KIND_DEVICE.
  //
  // Like KIND_THERMAL_ZONE, "this device is a battery" is a firmware-
  // namespace fact this ring may not read -- design/acpi/no-aml-in-
  // kernel.md forbids it in ring 0 down to the token level -- so the
  // mint enforces the four things the kernel CAN check (non-zero
  // inherited device key, one battery per key, plausible index /
  // design / chemistry) and cap/kind_battery.pdx §2 says so explicitly
  // rather than letting a reader take the kind check for a hardware
  // proof.
  //
  // THE UNITS ARE PERCENT [0, 100], mWh AND mV, everywhere, with no
  // conversion on the control path. cap/kind_battery.pdx §0 states the
  // discipline plainly; the single conversion in the module is
  // display-only, if it ever appears.
  //
  // Dispatched via cap_invoke_dispatch on `cmp rcx, 0x158; je
  // call_kind_battery`, comparing the full u64 kind field rather than
  // the 4-bit LAM base slot, so it coexists with the slot-10
  // KIND_DEVICE handler.
  //
  // NOT LOADER-SEEDABLE, for the same reasons KIND_THERMAL_ZONE is not:
  // a derived kind whose target_ptr is a row index into a private tail
  // table, and whose row holds a design capacity, would let a seeded
  // entry claim any row -- and on this kind that means claiming any
  // pack's design capacity, which is the divisor of every future
  // percent computation.
  //
  // See cap/kind_battery.pdx.
  pub let KIND_BATTERY_BASE : u64 = 10            // = KIND_DEVICE
  pub let KIND_BATTERY : u64 = 0x158              // derived-kind tag (344)

  // ============================================================================
  // KIND_COOLING_DEVICE (0x159): one cooling device's static identity —
  // index, cooling type (FAN/THROTTLE/POWER_STATE/UNKNOWN), and state
  // range [state_min, state_max] — and the right to be told what its
  // most recently reported cooling state was.
  // ============================================================================
  //
  // Derived over KIND_DEVICE (base slot 10), the fifth kind in this file
  // to take that parent after KIND_I2C_BUS, KIND_GPIO_LINE,
  // KIND_THERMAL_ZONE and KIND_BATTERY, and the fifth time the kind
  // half of the gate discriminates NOTHING: every PCI function in the
  // machine is a KIND_DEVICE.
  //
  // Like KIND_THERMAL_ZONE and KIND_BATTERY, "this device is a cooling
  // device" is a firmware-namespace fact this ring may not read --
  // design/acpi/no-aml-in-kernel.md forbids it in ring 0 down to the
  // token level -- so the mint enforces the three things the kernel
  // CAN check (non-zero inherited device key, one cooler per key, a
  // plausible index / type / range) and cap/kind_cooling_device.pdx §2
  // says so explicitly rather than letting a reader take the kind check
  // for a hardware proof.
  //
  // THE STATE IS AN ORDINAL, with no conversion on the control path.
  // ACPI 6.5 §11.7 leaves the meaning of the ordinal per-device (a fan
  // speed table index, a percent-throttled index, a Dn power state);
  // cap/kind_cooling_device.pdx §0 states the discipline plainly. The
  // per-device meaning stays in the ring-3 supervisor that walked the
  // namespace.
  //
  // Dispatched via cap_invoke_dispatch on `cmp rcx, 0x159; je
  // call_kind_cooling_device`, comparing the full u64 kind field rather
  // than the 4-bit LAM base slot, so it coexists with the slot-10
  // KIND_DEVICE handler.
  //
  // NOT LOADER-SEEDABLE, for the same reasons KIND_THERMAL_ZONE and
  // KIND_BATTERY are not: a derived kind whose target_ptr is a row
  // index into a private tail table, and whose row holds a state_max,
  // would let a seeded entry claim any row -- and on this kind that
  // means claiming any fan's advertised state range, which is what a
  // policy server writes control decisions against.
  //
  // See cap/kind_cooling_device.pdx.
  pub let KIND_COOLING_DEVICE_BASE : u64 = 10     // = KIND_DEVICE
  pub let KIND_COOLING_DEVICE : u64 = 0x159       // derived-kind tag (345)

  // ============================================================================
  // KIND_BACKLIGHT (0x15a): one backlight controller's static identity —
  // index, backend (PWM/DPAUX/ACPI/UNKNOWN), and brightness range
  // [brightness_min, brightness_max] — and the right to be told what its
  // most recently reported brightness was.
  // ============================================================================
  //
  // Derived over KIND_DEVICE (base slot 10), the sixth kind in this file
  // to take that parent after KIND_I2C_BUS, KIND_GPIO_LINE,
  // KIND_THERMAL_ZONE, KIND_BATTERY and KIND_COOLING_DEVICE, and the
  // sixth time the kind half of the gate discriminates NOTHING: every
  // PCI function in the machine is a KIND_DEVICE.
  //
  // Like KIND_COOLING_DEVICE, "this device is a backlight controller" is
  // a firmware-namespace fact this ring may not read --
  // design/acpi/no-aml-in-kernel.md forbids it in ring 0 down to the
  // token level -- so the mint enforces the three things the kernel
  // CAN check (non-zero inherited device key, one panel per key, a
  // plausible index / backend / range) and cap/kind_backlight.pdx §2
  // says so explicitly rather than letting a reader take the kind check
  // for a hardware proof.
  //
  // THE BRIGHTNESS IS AN ORDINAL, with no conversion on the control
  // path. A PWM controller's 0..255 is not the same ordinal as an eDP
  // DPAUX 0..255 or an ACPI _BCL 0..100; cap/kind_backlight.pdx §0
  // states the discipline plainly. The per-device meaning stays in the
  // ring-3 compositor that walked the namespace.
  //
  // "HELD BY COMPOSITOR ONLY" INVARIANT (issue #1106): the mint's
  // one-cap-per-panel rule enforces the property STRUCTURALLY -- a
  // second holder is refused with BACKLIGHT_MINT_BL_IN_USE. Which
  // compositor holds the one capability is a policy question above this
  // ring.
  //
  // Dispatched via cap_invoke_dispatch on `cmp rcx, 0x15a; je
  // call_kind_backlight`, comparing the full u64 kind field rather than
  // the 4-bit LAM base slot, so it coexists with the slot-10
  // KIND_DEVICE handler.
  //
  // NOT LOADER-SEEDABLE, for the same reasons KIND_THERMAL_ZONE and
  // KIND_COOLING_DEVICE are not: a derived kind whose target_ptr is a
  // row index into a private tail table, and whose row holds a
  // brightness_max, would let a seeded entry claim any row -- and on
  // this kind that means claiming any panel's advertised range, which
  // is what a compositor writes brightness commands against.
  //
  // See cap/kind_backlight.pdx.
  pub let KIND_BACKLIGHT_BASE : u64 = 10          // = KIND_DEVICE
  pub let KIND_BACKLIGHT : u64 = 0x15a            // derived-kind tag (346)

  // ============================================================================
  // KIND_HID_DEVICE (0x15b): one HID input device's static identity —
  // index, transport (I2C/USB/BT/UNKNOWN), vendor:product, and the
  // number of report ids its descriptor declares — and the right to
  // be told that its owner installed one report against the class
  // driver (a counter, not a payload).
  // ============================================================================
  //
  // Derived over KIND_DEVICE (base slot 10), the seventh kind in this
  // file to take that parent after KIND_I2C_BUS, KIND_GPIO_LINE,
  // KIND_THERMAL_ZONE, KIND_BATTERY, KIND_COOLING_DEVICE and
  // KIND_BACKLIGHT, and the seventh time the kind half of the gate
  // discriminates NOTHING: every PCI function in the machine is a
  // KIND_DEVICE.
  //
  // Like KIND_BACKLIGHT, "this device is a HID input peripheral" is
  // a fact about a descriptor byte stream this ring may not read --
  // the class-driver-in-ring-3 half of design/acpi/no-aml-in-
  // kernel.md's discipline generalises to firmware / descriptor
  // classification -- so the mint enforces the three things the
  // kernel CAN check (non-zero inherited device key, one row per
  // key, a plausible index / transport / vendor:product /
  // report_id_count) and cap/kind_hid_device.pdx §2 says so rather
  // than letting the kind check read as a hardware proof.
  //
  // Dispatched via cap_invoke_dispatch on `cmp rcx, 0x15b; je
  // call_kind_hid_device`, comparing the full u64 kind field rather
  // than the 4-bit LAM base slot, so it coexists with the slot-10
  // KIND_DEVICE handler. NO OP REACHABLE THROUGH THIS BRANCH CAN
  // CHANGE A REPORT_ID_COUNT, A TRANSPORT OR AN IDENTITY: there is
  // no setter in the kind at all, and the one op that carries state
  // at all (REPORT_INSTALL, arity ONE — no payload) REFUSES a non-
  // zero op_arg[63:8] rather than masking it. The subscriber side
  // of the HID event pipeline is KIND_HID_EVENT (0x15c) below, a
  // separate lineage rooted at KIND_IPC_ENDPOINT.
  //
  // NOT LOADER-SEEDABLE, for the same reasons every derived kind in
  // this family is not.
  //
  // See cap/kind_hid_device.pdx.
  pub let KIND_HID_DEVICE_BASE : u64 = 10         // = KIND_DEVICE
  pub let KIND_HID_DEVICE : u64 = 0x15b           // derived-kind tag (347)

  // ============================================================================
  // KIND_HID_EVENT (0x15c): the authority a ring-3 subscriber holds
  // to be told, on ONE endpoint it also holds, about the SUBSET of
  // the HID event-class stream it asks for (key / pointer / touch /
  // sensor). The record of one subscription.
  // ============================================================================
  //
  // Derived over KIND_IPC_ENDPOINT (base slot 5), the third kind in
  // this file to take that parent after KIND_FW_SESSION and
  // KIND_EC_QUERY, and the third time the kind half of the gate is
  // named as EMPTY on its own: every endpoint in the system is a
  // KIND_IPC_ENDPOINT, the shell's stdout included. The second half
  // is a validated non-zero event-type mask, a non-zero subscriber
  // pid, and an INHERITED endpoint id read from the parent's
  // target_ptr[15:0] (kind_endpoint.pdx's endpoint_tail_pack).
  //
  // Unlike KIND_EC_QUERY there is no second capability argument.
  // Event classes are coarse-grained (four bits), so the uniqueness
  // key is the (endpoint_id, event_type_mask) pair -- two
  // subscriptions on the same endpoint for the same mask are refused
  // as duplicates; same endpoint with different masks is legal
  // (two rows).
  //
  // Dispatched via cap_invoke_dispatch on `cmp rcx, 0x15c; je
  // call_kind_hid_event`. NO OP REACHABLE THROUGH THIS BRANCH TAKES
  // AN OPERAND: every op is (op only) and op_arg[63:8] is REFUSED
  // rather than masked, because reserved bits on an invocation op
  // are where a future field would appear.
  //
  // NOT LOADER-SEEDABLE, for the same reasons KIND_EC_QUERY and
  // KIND_HID_DEVICE are not: a derived kind whose target_ptr is a
  // row id into a private tail table, and whose row holds a
  // subscriber pid, would let a seeded entry install a subscription
  // owned by a pid a sidecar chose.
  //
  // See cap/kind_hid_event.pdx.
  pub let KIND_HID_EVENT_BASE : u64 = 5           // = KIND_IPC_ENDPOINT
  pub let KIND_HID_EVENT : u64 = 0x15c            // derived-kind tag (348)

  // ============================================================================
  // KIND_SENSOR_CHANNEL (0x15d): the authority a ring-3 subscriber holds
  // to be told, on ONE endpoint it also holds, about ONE class of sensor
  // sample the R32 substrate emits (ALS / ACCEL / GYRO) at a chosen rate.
  // The record of one subscription.
  // ============================================================================
  //
  // Derived over KIND_IPC_ENDPOINT (base slot 5), the fourth kind in
  // this file to take that parent after KIND_FW_SESSION, KIND_EC_QUERY
  // and KIND_HID_EVENT, and the fourth time the kind half of the gate
  // is named as EMPTY on its own: every endpoint in the system is a
  // KIND_IPC_ENDPOINT, the shell's stdout included. The second half is
  // a validated non-zero sensor type (one of ALS/ACCEL/GYRO), a rate
  // in [1, SENSOR_RATE_MAX] Hz, a non-zero subscriber pid, and an
  // INHERITED endpoint id read from the parent's target_ptr[15:0].
  //
  // Uniqueness key is (endpoint_id, sensor_type) -- two subscriptions
  // on the same endpoint for the same sensor type are refused as
  // duplicates; same endpoint with different sensor types is legal
  // (two rows). Rate is NOT part of the uniqueness key: a rate change
  // is expressed by revoke-and-remint, so a subscriber cannot quietly
  // widen its share of the driver's sample budget after the gate
  // approved a slower one.
  //
  // Dispatched via cap_invoke_dispatch on `cmp rcx, 0x15d; je
  // call_kind_sensor_channel`. QUERY ops and SAMPLE_NOTE all take NO
  // OPERAND, and op_arg[63:8] is REFUSED rather than masked, because
  // reserved bits on an invocation op are where a future field would
  // appear.
  //
  // NOT LOADER-SEEDABLE, for the same reasons every derived kind in
  // the endpoint-parented family is not.
  //
  // See cap/kind_sensor_channel.pdx.
  pub let KIND_SENSOR_CHANNEL_BASE : u64 = 5      // = KIND_IPC_ENDPOINT
  pub let KIND_SENSOR_CHANNEL : u64 = 0x15d       // derived-kind tag (349)

  // ============================================================================
  // KIND_AUDIO_CONTROLLER (0x15e): one HDA controller's static identity
  // — inherited hda_key, opaque bar_handle, codec_count, corb_size,
  // rirb_size — and the right to be told the discovery scan updated
  // the codec count.
  // ============================================================================
  //
  // Derived over KIND_DEVICE (base slot 10), the eighth kind in this
  // file to take that parent after KIND_I2C_BUS, KIND_GPIO_LINE,
  // KIND_THERMAL_ZONE, KIND_BATTERY, KIND_COOLING_DEVICE,
  // KIND_BACKLIGHT and KIND_HID_DEVICE, and the eighth time the kind
  // half of the gate discriminates NOTHING: every PCI function in the
  // machine is a KIND_DEVICE.
  //
  // "This device is an HDA controller" is a PCI class-code fact
  // (04:03) that the ring-3 supervisor / pci_enumerator distills; the
  // kernel enforces only what it can (a non-zero inherited device key,
  // one controller per key, corb_size and rirb_size in the small
  // enumerated set) and cap/kind_audio_controller.pdx §2 says so
  // explicitly rather than letting the kind check read as a hardware
  // proof.
  //
  // THE OPAQUE BAR HANDLE IS RECORDED, NOT RESOLVED. bar_handle is a
  // u64 stashed at mint that mirrors hda_controller_bind's opaque
  // discipline (drivers/hda/controller.pdx §0): a live driver reaches
  // the register window through hda_controller_bind, and this kind
  // neither dereferences nor mediates the handle. Widening either the
  // mint or the accessors to accept a controller BASE / EXTENT would
  // let a caller reach any window a firmware table happens to name --
  // exactly what §2 of ec_access.pdx exists to prevent.
  //
  // Dispatched via cap_invoke_dispatch on `cmp rcx, 0x15e; je
  // call_kind_audio_ctrl`, comparing the full u64 kind field rather
  // than the 4-bit LAM base slot, so it coexists with the slot-10
  // KIND_DEVICE handler. NO OP REACHABLE THROUGH THIS BRANCH CAN
  // CHANGE A BAR_HANDLE OR A RING SHAPE, and the one op that carries
  // state (REPORT, new_codec_count packed into op_arg[11:8]) REFUSES
  // a non-zero reserved op_arg[63:12] rather than masking it.
  //
  // NOT LOADER-SEEDABLE, for the same reasons every derived kind in
  // this family is not: a derived kind whose target_ptr is a row
  // index into a private tail table, and whose row holds a
  // bar_handle, would let a seeded entry claim any row -- and on
  // this kind that means claiming any controller's advertised BAR,
  // which is what a driver writes register commands against.
  //
  // See cap/kind_audio_controller.pdx.
  pub let KIND_AUDIO_CONTROLLER_BASE : u64 = 10   // = KIND_DEVICE
  pub let KIND_AUDIO_CONTROLLER : u64 = 0x15e     // derived-kind tag (350)

  // ============================================================================
  // KIND_PCM_STREAM (0x15f): one PCM stream's static identity — a session
  // key, an inherited endpoint id, an audio_clock_slot pointing at a
  // KIND_AUDIO_CLOCK capability, a ring buffer object key, a sample format
  // ordinal, a sample rate, a channel count, and a stream position counter.
  // ============================================================================
  //
  // Derived over KIND_IPC_ENDPOINT (base slot 5), the fifth kind in this
  // file to take that parent after KIND_FW_SESSION, KIND_EC_QUERY,
  // KIND_HID_EVENT and KIND_SENSOR_CHANNEL, and the fifth time the kind
  // half of the gate is EMPTY on its own: every endpoint in the system is
  // a KIND_IPC_ENDPOINT. The second half is a validated non-zero
  // audio_clock_slot naming a live KIND_AUDIO_CLOCK, a non-zero ring
  // buffer key, a validated sample format, a validated sample rate, a
  // validated channels count, and an INHERITED endpoint id read from the
  // parent's target_ptr[15:0].
  //
  // LINEAR: once minted, this cap cannot be re-parented — the row's
  // audio_clock_slot, ring_bo_key, sample_format, sample_rate and
  // channels fields are set once at mint and there is no primitive in
  // this module that changes them. cap/kind_pcm_stream.pdx §1 and
  // pcm_stream_reparent_forbidden.pdx explain the discipline.
  //
  // CROSS-CAP INVARIANT: the same ring_bo_key cannot be attached to two
  // KIND_PCM_STREAM rows whose audio_clock_slot values name DIFFERENT
  // clocks — a single buffer written by two producers at two different
  // timebases loses phase alignment silently. Enforced at mint via
  // pcm_stream_find_conflicting_ring_clock; refused with
  // PCM_STREAM_MINT_XCLOCK_CONFLICT.
  //
  // Dispatched via cap_invoke_dispatch on `cmp rcx, 0x15f; je
  // call_kind_pcm_stream`. NO OP REACHABLE THROUGH THIS BRANCH CAN
  // CHANGE ANY IDENTITY FIELD, and every op takes NO OPERAND —
  // op_arg[63:8] is REFUSED rather than masked.
  //
  // NOT LOADER-SEEDABLE, for the same reasons every derived kind in
  // this family is not.
  //
  // See cap/kind_pcm_stream.pdx.
  pub let KIND_PCM_STREAM_BASE : u64 = 5          // = KIND_IPC_ENDPOINT
  pub let KIND_PCM_STREAM : u64 = 0x15f           // derived-kind tag (351)

  // ============================================================================
  // KIND_AUDIO_CLOCK (0x160): one hardware audio timeline domain — the
  // sync source ordinal (HDA_BCLK / PCH_GEN), a nominal rate in Hz, a
  // current rate in Hz, and a lifetime samples_produced counter. FIRST
  // NON-GPU CONSUMER of the KIND_HW_TIMELINE family (planned in R29 —
  // see kind_hw_msix_vector.pdx).
  // ============================================================================
  //
  // Derived over KIND_HW (base slot 14) at this milestone, and the
  // header of cap/kind_audio_clock.pdx §2 explains why: KIND_HW_TIMELINE
  // (planned in R29.M1's derived-kind block, not yet minted) is the
  // INTENDED parent. When it lands the parent-kind check in
  // audio_clock_check_parent tightens from KIND_HW to
  // KIND_HW_TIMELINE without any other change to this kind — the mint
  // continues to inherit the clock source key from the parent's
  // target_ptr rather than accepting one as an argument.
  //
  // Dispatched via cap_invoke_dispatch on `cmp rcx, 0x160; je
  // call_kind_audio_clock`. The one op that carries state (REPORT,
  // packing new_current_hz[47:8] and new_samples_produced_delta[63:48])
  // REFUSES a value outside PCM_CLOCK_HZ bounds rather than clamping,
  // and no other op takes an operand.
  //
  // NOT LOADER-SEEDABLE, for the same reasons every derived kind in
  // this family is not.
  //
  // See cap/kind_audio_clock.pdx.
  pub let KIND_AUDIO_CLOCK_BASE : u64 = 14        // = KIND_HW (tighten to
                                                  // KIND_HW_TIMELINE when it
                                                  // lands)
  pub let KIND_AUDIO_CLOCK : u64 = 0x160          // derived-kind tag (352)

  // ============================================================================
  // KIND_AUDIO_ROUTE (0x161): one audio routing edge -- source stream slot,
  // destination PCM slot, Q15 gain, mute -- and the right to be told which
  // producer's samples reach which consumer at what mixer level.
  // ============================================================================
  //
  // Derived over KIND_IPC_ENDPOINT (base slot 5), the sixth kind in this
  // file to take that parent after KIND_FW_SESSION, KIND_EC_QUERY,
  // KIND_HID_EVENT, KIND_SENSOR_CHANNEL and KIND_PCM_STREAM, and the sixth
  // time the kind half of the gate is EMPTY on its own: every endpoint in
  // the system is a KIND_IPC_ENDPOINT. The second half of the gate
  // requires (a) inherited endpoint id from parent target_ptr[15:0] non-
  // zero, (b) source_stream_slot naming a live KIND_PCM_STREAM,
  // (c) dest_pcm_slot naming a live KIND_PCM_STREAM, (d) source and dest
  // slots must differ (SELF_LOOP refused), (e) a valid Q15 signed gain.
  //
  // UNITS: gain_q15 is signed 16-bit Q15 fixed-point ([-32768, +32767]);
  // NOT dB, NOT a linear multiplier, NOT millibel. The Q15 saturating
  // adder lives in src/kernel/core/drivers/audio/route_table.pdx and is
  // the ONLY primitive that combines two gains. cap/kind_audio_route.pdx
  // §0 states the discipline plainly; two arithmetic units in one row
  // would let a mix stage that thought in linear multipliers write a
  // value the mixer's combine step reads as Q15.
  //
  // LINEAR ON IDENTITY, DYNAMIC ON STATE: route_key, source_stream_slot
  // and dest_pcm_slot are set once at mint and there is no primitive
  // that changes them. gain_q15 and mute are updated by
  // audio_route_set_gain and audio_route_set_mute respectively (arity
  // two: capability + one value; validators refuse rather than clamp).
  //
  // Dispatched via cap_invoke_dispatch on `cmp rcx, 0x161; je
  // call_kind_audio_route`, comparing the full u64 kind field rather
  // than the 4-bit LAM base slot, so it coexists with the slot-5
  // endpoint handler.
  //
  // NOT LOADER-SEEDABLE, for the same reasons every derived kind in
  // this family is not.
  //
  // See cap/kind_audio_route.pdx.
  pub let KIND_AUDIO_ROUTE_BASE : u64 = 5         // = KIND_IPC_ENDPOINT
  pub let KIND_AUDIO_ROUTE : u64 = 0x161          // derived-kind tag (353)

  // ============================================================================
  // KIND_USB_DEVICE (0x162): one USB device's static identity — the
  // inherited device_key, the device address on its bus (1..127) and
  // the negotiated speed ordinal (LOW / FULL / HIGH / SUPER).
  // ============================================================================
  //
  // Derived over KIND_DEVICE (base slot 10), the ninth kind in this
  // file to take that parent after KIND_I2C_BUS, KIND_GPIO_LINE,
  // KIND_THERMAL_ZONE, KIND_BATTERY, KIND_COOLING_DEVICE,
  // KIND_BACKLIGHT, KIND_HID_DEVICE and KIND_AUDIO_CONTROLLER, and the
  // ninth time the kind half of the gate discriminates NOTHING: every
  // PCI function in the machine is a KIND_DEVICE.
  //
  // "This device is a USB device" is a class-code fact the ring-3
  // xhci_supervisor distills — the class driver that walked
  // xhci_slot_lifecycle and enumerated the port to which it is
  // attached — and the capability is the record of ITS decision.
  //
  // Dispatched via cap_invoke_dispatch on `cmp rcx, 0x162; je
  // call_kind_usb_device`. NO OP REACHABLE THROUGH THIS BRANCH CAN
  // CHANGE address OR speed: address is set once by the address device
  // command that the class driver issued before minting, and a device
  // whose address could be re-stamped in place would let one policy
  // decision act as if it were about another device.
  //
  // KIND_USB_DEVICE IS THE PARENT KIND FOR KIND_USB_HUB (0x163) — a
  // hub is a USB device with a hub class descriptor, and the derivation
  // is what lets the KIND_USB_HUB mint gate refuse a hub claim not
  // rooted in a device the enumerator has seen.
  //
  // NOT LOADER-SEEDABLE, for the same reasons every derived kind in
  // this family is not.
  //
  // See cap/kind_usb_device.pdx.
  pub let KIND_USB_DEVICE_BASE : u64 = 10         // = KIND_DEVICE
  pub let KIND_USB_DEVICE : u64 = 0x162           // derived-kind tag (354)

  // ============================================================================
  // KIND_USB_HUB (0x163): one USB hub's static identity — the
  // inherited hub_key, port_count (1..15 per USB 2.0 §11.23.2.1),
  // tt_supported (0/1) and tier (1..5, USB 2.0 spec limit).
  // ============================================================================
  //
  // Derived over KIND_USB_DEVICE (0x162), a derived-kind parent
  // rather than a base slot — the FIRST such derivation in the USB
  // fabric, and for the same reason KIND_I2C_SLAVE derives over
  // KIND_I2C_BUS rather than KIND_DEVICE: a raw device holder must
  // not be able to mint hub authority without the USB-device
  // capability that proves the enumerator walked xhci_slot_lifecycle
  // and negotiated an address.
  //
  // The hub descriptor (USB 2.0 §11.23.2.1) declares port count,
  // hub characteristics (including transaction-translator support)
  // and per-port device-removable flags. The class driver in
  // drivers/usb/hub_driver.pdx decodes it; this capability is what
  // the driver mints to record its findings.
  //
  // Dispatched via cap_invoke_dispatch on `cmp rcx, 0x163; je
  // call_kind_usb_hub`. NO OP REACHABLE THROUGH THIS BRANCH CAN
  // CHANGE port_count, tt_supported OR tier: a hub whose port count
  // could be raised would let a subscriber to the hub_topology_channel
  // be told about a port that does not exist, and tier is the physical
  // depth in the topology tree — restamping it would tunnel one hub's
  // authority up to be its own grandparent.
  //
  // NOT LOADER-SEEDABLE, for the same reasons every derived kind in
  // this family is not.
  //
  // See cap/kind_usb_hub.pdx.
  pub let KIND_USB_HUB_BASE : u64 = 0x162         // = KIND_USB_DEVICE
  pub let KIND_USB_HUB : u64 = 0x163              // derived-kind tag (355)

  // ============================================================================
  // KIND_USB_INTERFACE (0x164): one USB interface's static identity —
  // inherited interface_key, interface_number (0..31), alt_setting
  // (0..15), and the three USB-IF descriptor bytes (class, subclass,
  // protocol).
  // ============================================================================
  //
  // Derived over KIND_USB_DEVICE (0x162), a derived-kind parent — the
  // SECOND such derivation in the USB fabric after KIND_USB_HUB, and
  // for the same reason: a raw KIND_DEVICE holder must not be able to
  // mint interface authority without the intermediate USB-device
  // capability that proves the enumerator negotiated an address.
  //
  // WHY THIS KIND EXISTS SEPARATELY FROM KIND_USB_DEVICE. A USB device
  // may present SEVERAL interfaces (a composite device — a fingerprint
  // reader plus a camera, a headset's audio plus its HID buttons); the
  // interface-per-driver rule (drivers/usb/composite_bind.pdx) says
  // one class driver binds to one interface, so the CAPABILITY at
  // which driver-binding decisions are gated has to be the interface,
  // not the device.
  //
  // Dispatched via cap_invoke_dispatch on `cmp rcx, 0x164; je
  // call_kind_usb_interface`. NO OP REACHABLE THROUGH THIS BRANCH CAN
  // CHANGE interface_number, alt_setting, class, subclass OR protocol:
  // alt-setting switching is expressed by revoke-and-remint, so a
  // holder cannot reroute endpoints derived under the old bandwidth
  // budget without giving up its capability first.
  //
  // KIND_USB_INTERFACE IS THE (interface) parent for KIND_USB_ENDPOINT
  // (0x165) — endpoints belong to interfaces, and the interface-half
  // of the endpoint's two-cap gate is what proves the endpoint
  // capability names a real interface descriptor.
  //
  // NOT LOADER-SEEDABLE, for the same reasons every derived kind in
  // this family is not.
  //
  // See cap/kind_usb_interface.pdx.
  pub let KIND_USB_INTERFACE_BASE : u64 = 0x162   // = KIND_USB_DEVICE
  pub let KIND_USB_INTERFACE : u64 = 0x164        // derived-kind tag (356)

  // ============================================================================
  // KIND_USB_ENDPOINT (0x165): one USB endpoint's static identity —
  // inherited endpoint_key, ep_num (0..15), ep_type (control / isoch /
  // bulk / interrupt), direction (OUT / IN), max_packet size, plus
  // the interface_slot the endpoint belongs to.
  // ============================================================================
  //
  // Derived over KIND_IPC_ENDPOINT (base slot 5), the seventh kind in
  // this file to take that parent after KIND_FW_SESSION, KIND_EC_QUERY,
  // KIND_HID_EVENT, KIND_SENSOR_CHANNEL, KIND_PCM_STREAM and
  // KIND_AUDIO_ROUTE, and the seventh time the kind half of that gate
  // is EMPTY on its own: every endpoint in the machine is a
  // KIND_IPC_ENDPOINT. The second half is a SECOND CAPABILITY ARGUMENT
  // (interface_slot) that must be a live KIND_USB_INTERFACE (0x164)
  // carrying RIGHT_MINT. The two halves prove unrelated things — WHERE
  // the transfer completions will arrive (the IPC endpoint), and WHICH
  // USB interface the endpoint belongs to.
  //
  // Dispatched via cap_invoke_dispatch on `cmp rcx, 0x165; je
  // call_kind_usb_endpoint`. NO OP REACHABLE THROUGH THIS BRANCH CAN
  // CHANGE ep_num, ep_type, direction, max_packet OR interface_slot:
  // an endpoint whose ep_type could be re-stamped in place would let
  // a bulk-scheduled ring receive an isoch packet.
  //
  // NOT LOADER-SEEDABLE, for the same reasons every derived kind in
  // the endpoint-parented family is not.
  //
  // See cap/kind_usb_endpoint.pdx.
  pub let KIND_USB_ENDPOINT_BASE : u64 = 5        // = KIND_IPC_ENDPOINT
  pub let KIND_USB_ENDPOINT : u64 = 0x165         // derived-kind tag (357)

  // ============================================================================
  // KIND_MSC_LUN (0x166): one USB mass-storage LOGICAL UNIT's static
  // identity — its inherited lun_key and the lun_number (0..15) the
  // class driver reports Get-Max-LUN assigned it.
  // ============================================================================
  //
  // Derived over KIND_USB_INTERFACE (0x164), a derived-kind parent —
  // the third such derivation in the USB fabric after KIND_USB_HUB and
  // KIND_USB_INTERFACE, and for the same argument: a raw KIND_DEVICE
  // holder must not be able to mint LUN authority without the
  // intermediate USB-interface capability that proves the enumerator
  // walked the descriptor tree far enough to identify a mass-storage
  // interface.
  //
  // WHY THIS KIND EXISTS SEPARATELY FROM KIND_USB_INTERFACE. A USB
  // mass-storage INTERFACE may present SEVERAL logical units (a card
  // reader with three slots reports Max-LUN = 2, i.e. three LUNs).
  // SCSI addressing runs PER-LUN — a READ(10) issued at LUN 1 hits
  // different media from a READ(10) at LUN 0 — so the CAPABILITY at
  // which storage-command authority is gated has to be the LUN.
  //
  // Dispatched via cap_invoke_dispatch on `cmp rcx, 0x166; je
  // call_kind_msc_lun`. NO OP REACHABLE THROUGH THIS BRANCH CAN
  // CHANGE lun_number OR lun_key. See cap/kind_msc_lun.pdx.
  //
  // KIND_MSC_LUN IS THE PARENT KIND for KIND_SCSI_DEVICE (0x167) —
  // a SCSI device is a LUN with an INQUIRY-reported device type and
  // a READ_CAPACITY-reported block geometry, and the derivation is
  // what lets the KIND_SCSI_DEVICE mint gate refuse a SCSI claim
  // not rooted in a LUN the enumerator has seen.
  //
  // NOT LOADER-SEEDABLE, for the same reasons every derived kind in
  // this family is not.
  pub let KIND_MSC_LUN_BASE : u64 = 0x164         // = KIND_USB_INTERFACE
  pub let KIND_MSC_LUN : u64 = 0x166              // derived-kind tag (358)

  // ============================================================================
  // KIND_SCSI_DEVICE (0x167): one SCSI logical unit's static identity
  // — inherited scsi_key, scsi_type (SBC-3 device type), block_size
  // (bytes) and block_count (READ_CAPACITY response).
  // ============================================================================
  //
  // Derived over KIND_MSC_LUN (0x166), a derived-kind parent — the
  // fourth such derivation in the USB fabric. A LUN is what USB MSC
  // addresses; a SCSI DEVICE is what SCSI addresses — the LUN, seen
  // at the block layer, after its INQUIRY reported a device type and
  // its READ_CAPACITY reported a block geometry.
  //
  // Dispatched via cap_invoke_dispatch on `cmp rcx, 0x167; je
  // call_kind_scsi_device`. NO OP REACHABLE THROUGH THIS BRANCH CAN
  // CHANGE block_size OR block_count — a block_size that could be
  // re-stamped in place would let a driver read a 4096-byte sector
  // with a 512-byte transfer buffer. See cap/kind_scsi_device.pdx.
  //
  // LEAF OF THE STORAGE LATTICE. R_SCSI_DEV_MINT is deliberately
  // absent from R_SCSI_DEV_ALL.
  //
  // NOT LOADER-SEEDABLE.
  pub let KIND_SCSI_DEVICE_BASE : u64 = 0x166     // = KIND_MSC_LUN
  pub let KIND_SCSI_DEVICE : u64 = 0x167          // derived-kind tag (359)

  // ============================================================================
  // KIND_USB_URB (0x168): one OUTSTANDING USB Request Block — its
  // inherited urb_key, direction (IN/OUT), buffer_len (0..65535
  // bytes), and timeout_ms (0..60000, capped at one minute).
  // ============================================================================
  //
  // Derived over KIND_IPC_ENDPOINT (base slot 5), the eighth kind in
  // this file to take that parent after KIND_FW_SESSION, KIND_EC_
  // QUERY, KIND_HID_EVENT, KIND_SENSOR_CHANNEL, KIND_PCM_STREAM,
  // KIND_AUDIO_ROUTE and KIND_USB_ENDPOINT, and the eighth time the
  // kind half of the gate is EMPTY on its own: every endpoint in the
  // machine is a KIND_IPC_ENDPOINT.
  //
  // A URB (USB Request Block) is one queued transfer awaiting
  // completion. usb_transfer_channel.submit_urb (R34.M3-004 #1179)
  // hands the caller back a URB handle; that handle IS this kind. A
  // subsequent cancel_urb / poll_status names the URB by capability,
  // not by a caller-supplied id, so a caller cannot poll an URB it
  // did not submit.
  //
  // Dispatched via cap_invoke_dispatch on `cmp rcx, 0x168; je
  // call_kind_usb_urb`. NO OP REACHABLE THROUGH THIS BRANCH CAN
  // CHANGE direction, buffer_len OR timeout_ms.
  //
  // LEAF OF THE URB LATTICE. R_USB_URB_MINT is deliberately absent
  // from R_USB_URB_ALL.
  //
  // NOT LOADER-SEEDABLE.
  pub let KIND_USB_URB_BASE : u64 = 5             // = KIND_IPC_ENDPOINT
  pub let KIND_USB_URB : u64 = 0x168              // derived-kind tag (360)

  // ---------------------------------------------------------------------
  // KIND_ISOCH_STREAM (0x169): one queued USB isochronous stream — its
  // static identity (stream_key), the KIND_USB_ENDPOINT cap slot
  // through which its packets flow (endpoint_slot), the service
  // interval in bInterval units per USB 2.0 §9.6.6, its bandwidth
  // reservation in bytes/(micro)frame, and its direction (IN/OUT).
  //
  // Derived over KIND_USB_ENDPOINT (0x165), a derived-kind parent
  // rather than a base slot — the SECOND kind after KIND_USB_HUB /
  // KIND_MSC_LUN / KIND_SCSI_DEVICE to take a derived-kind parent in
  // the USB fabric. Unlike the KIND_IPC_ENDPOINT-derived kinds this
  // gate is NOT empty on its own: KIND_USB_ENDPOINT has a validated
  // ep_type. But the mint STILL enforces additional fields (§1 of
  // cap/kind_isoch_stream.pdx) because the parent's ep_type check
  // that this row's bandwidth reservation lands on an ISOCH endpoint
  // is deferred to R34.M5-003 #1188 when the scheduler admits the
  // row to the isoch_ring.
  //
  // Dispatched via cap_invoke_dispatch on `cmp rcx, 0x169; je
  // call_kind_isoch_stream`. NO OP REACHABLE THROUGH THIS BRANCH
  // CAN CHANGE endpoint_slot, service_interval, bandwidth_reservation
  // OR direction.
  //
  // LEAF OF THE ISOCH LATTICE. R_ISOCH_STREAM_MINT is deliberately
  // absent from R_ISOCH_STREAM_ALL.
  //
  // NOT LOADER-SEEDABLE.
  pub let KIND_ISOCH_STREAM_BASE : u64 = 0x165    // = KIND_USB_ENDPOINT
  pub let KIND_ISOCH_STREAM : u64 = 0x169         // derived-kind tag (361)

  // ---------------------------------------------------------------------
  // R34.M6-001 (#1194): KIND_FP_SENSOR (0x16A = 362) — one USB
  // fingerprint sensor's static identity (inherited sensor_key,
  // device_slot, vendor / product id, sensor type AREA/SWIPE,
  // resolution_dpi, enrollment_state). Derives over KIND_DEVICE
  // (base slot 10), the tenth kind in this file to take that parent
  // (after KIND_I2C_BUS, KIND_GPIO_LINE, KIND_THERMAL_ZONE,
  // KIND_BATTERY, KIND_COOLING_DEVICE, KIND_BACKLIGHT,
  // KIND_HID_DEVICE, KIND_AUDIO_CONTROLLER and KIND_USB_DEVICE),
  // and the tenth time the kind half of the gate discriminates
  // NOTHING on its own: every PCI (or USB-parented) function is a
  // KIND_DEVICE. Unlike KIND_HID_DEVICE the second half additionally
  // requires a vendor in the accepted small set (Goodix 0x27C6,
  // Synaptics 0x06CB, or bring-up placeholder 0), because a template
  // captured on one sensor cannot be verified against another and a
  // driver that mistook sensor A's protocol for sensor B's would
  // either return NO_MATCH forever (privacy-preserving) or MATCH on
  // a template that was never enrolled (security failure).
  //
  // Dispatched via cap_invoke_dispatch on `cmp rcx, 0x16A; je
  // call_kind_fp_sensor`. NO OP REACHABLE THROUGH THIS BRANCH CAN
  // CHANGE vendor_id, product_id, sensor_type OR resolution_dpi —
  // the row's identity is frozen at mint. enrollment_state is
  // dynamic but the setter is not on this kind: fp_class.pdx owns
  // the state-machine transitions.
  //
  // LEAF OF THE FP LATTICE. R_FP_SENSOR_MINT is DELIBERATELY absent
  // from R_FP_SENSOR_ALL — nothing derives from an fp-sensor cap
  // in this milestone.
  //
  // NOT LOADER-SEEDABLE.
  pub let KIND_FP_SENSOR_BASE : u64 = 10          // = KIND_DEVICE
  pub let KIND_FP_SENSOR : u64 = 0x16A            // derived-kind tag (362)

  // ---------------------------------------------------------------------
  // R35.M1-002 (#1196): KIND_PCIE_HOTPLUG_EVENT (0x16B = 363) — one
  // PCIe root-port hotplug event subscription (event_key, inherited
  // endpoint_id, root_port_bdf, event_type, port_status). Derives
  // over KIND_IPC_ENDPOINT (base slot 5), the ninth kind in this
  // file to take that parent after KIND_FW_SESSION, KIND_EC_QUERY,
  // KIND_HID_EVENT, KIND_SENSOR_CHANNEL, KIND_PCM_STREAM,
  // KIND_AUDIO_ROUTE, KIND_USB_ENDPOINT and KIND_USB_URB, and the
  // ninth time the kind half of the gate is EMPTY on its own: every
  // endpoint in the machine is a KIND_IPC_ENDPOINT, the shell's
  // stdout included.
  //
  // The second half of the gate requires (a) inherited endpoint id
  // from parent target_ptr[15:0] non-zero, (b) event_key non-zero
  // and unique among live rows, (c) root_port_bdf fitting in u16,
  // (d) event_type in [0, 3] (PRESENCE_DETECT_CHANGE /
  // DLL_STATE_CHANGE / COMMAND_COMPLETED / POWER_FAULT — the four
  // raw Slot Status decode bits per PCIe base §6.7, NOT the
  // supervisor's higher-level {link_up, link_down, dpc_triggered,
  // surprise_removal} vocabulary), and (e) port_status fitting in
  // u16.
  //
  // Dispatched via cap_invoke_dispatch on `cmp rcx, 0x16B; je
  // call_kind_pcie_hp_evt`. NO OP REACHABLE THROUGH THIS BRANCH
  // CAN CHANGE event_key, root_port_bdf, event_type OR port_status.
  //
  // LEAF OF THE HOTPLUG LATTICE. R_PCIE_HP_EVT_MINT is DELIBERATELY
  // absent from R_PCIE_HP_EVT_ALL — nothing derives from a hotplug
  // event cap in this milestone.
  //
  // NOT LOADER-SEEDABLE.
  pub let KIND_PCIE_HOTPLUG_EVENT_BASE : u64 = 5      // = KIND_IPC_ENDPOINT
  pub let KIND_PCIE_HOTPLUG_EVENT : u64 = 0x16B       // derived-kind tag (363)

  // ---------------------------------------------------------------------
  // R35.M2-003 (#1203): KIND_TB_DOMAIN (0x16C = 364) — one Thunderbolt 4
  // / USB4 domain's static identity (domain_key, device_slot, nhi_bdf,
  // domain_id, route_id, state). Derives over KIND_DEVICE (base slot 10),
  // the eleventh kind in this file to take that parent (after
  // KIND_I2C_BUS, KIND_GPIO_LINE, KIND_THERMAL_ZONE, KIND_BATTERY,
  // KIND_COOLING_DEVICE, KIND_BACKLIGHT, KIND_HID_DEVICE,
  // KIND_AUDIO_CONTROLLER, KIND_USB_DEVICE and KIND_FP_SENSOR), and the
  // eleventh time the kind half of the gate discriminates NOTHING on its
  // own: every PCI function in the machine is a KIND_DEVICE.
  //
  // The second half of the gate requires (a) inherited device key
  // non-zero (NO_DEVICE), (b) domain_key non-zero and unique among live
  // rows (NO_KEY / IN_USE), (c) nhi_bdf fits in u16 (BAD_BDF),
  // (d) domain_id fits in u8 (BAD_DOMAIN_ID), (e) route_id fits in 24
  // bits — five bits per hop, twelve hops max per USB4 §5 (BAD_ROUTE),
  // (f) state in {0,1,2,3} — UNINIT/PROBED/ACTIVE/TORN (BAD_STATE).
  //
  // Dispatched via cap_invoke_dispatch on `cmp rcx, 0x16C; je
  // call_kind_tb_domain`. NO OP REACHABLE THROUGH THIS BRANCH CAN
  // CHANGE domain_key, device_slot, nhi_bdf, domain_id OR route_id —
  // the row's identity is frozen at mint. state is dynamic but the
  // setter is not on this kind: the CM supervisor / router_walk owns
  // the state-machine transitions.
  //
  // LEAF OF THE TB LATTICE. R_TB_DOMAIN_MINT is DELIBERATELY absent
  // from R_TB_DOMAIN_ALL — nothing derives from a tb-domain cap in
  // this milestone.
  //
  // NOT LOADER-SEEDABLE.
  pub let KIND_TB_DOMAIN_BASE : u64 = 10             // = KIND_DEVICE
  pub let KIND_TB_DOMAIN : u64 = 0x16C               // derived-kind tag (364)

  // ---------------------------------------------------------------------
  // R35.M3-004 (#1208): KIND_TB_ROUTE (0x16D = 365) — one established
  // TB4 tunnel's identity (route_key, endpoint_slot, 24-bit route_id,
  // tunnel_type in {PCIe, DP, USB3}, source and sink adapters, state
  // in {NEGOTIATING, ACTIVE, TORN}). Derives over KIND_IPC_ENDPOINT
  // (base slot 5), the TENTH kind in this file to take that parent
  // after KIND_FW_SESSION, KIND_EC_QUERY, KIND_HID_EVENT,
  // KIND_SENSOR_CHANNEL, KIND_PCM_STREAM, KIND_AUDIO_ROUTE,
  // KIND_USB_ENDPOINT, KIND_USB_URB and KIND_PCIE_HOTPLUG_EVENT, and
  // the TENTH time the kind half of the gate is EMPTY on its own:
  // every endpoint in the machine is a KIND_IPC_ENDPOINT.
  //
  // The second half of the gate requires (a) route_key non-zero and
  // unique among live rows (NO_KEY / IN_USE), (b) endpoint_slot names
  // a live KIND_IPC_ENDPOINT with RIGHT_MINT (BAD_ENDPOINT); the
  // slot is stashed on the row and used by the tunnel-event fanout
  // path, (c) route_id fits in 24 bits (BAD_ROUTE), (d) tunnel_type
  // in {0,1,2} — PCIe/DP/USB3 (BAD_TUNNEL), (e) source_adapter and
  // sink_adapter fit in u8 (BAD_ADAPTER), (f) source != sink —
  // SELF-LOOP refused (BAD_ADAPTER), (g) state in {0,1,2} —
  // NEGOTIATING/ACTIVE/TORN (BAD_STATE).
  //
  // Parent is KIND_IPC_ENDPOINT rather than KIND_TB_DOMAIN because
  // this kind's primary function on the invoke path is to deliver
  // tunnel-lifecycle events to a subscriber; the parent must be the
  // endpoint the events arrive on. A future refinement can add a
  // second-cap gate demanding a KIND_TB_DOMAIN also be presented at
  // mint (the way KIND_EC_QUERY demands a KIND_OP_REGION).
  //
  // Dispatched via cap_invoke_dispatch on `cmp rcx, 0x16D; je
  // call_kind_tb_route`, comparing the full u64 kind field rather
  // than the 4-bit LAM base slot, so it coexists with the slot-5
  // endpoint handler. NO OP REACHABLE THROUGH THIS BRANCH CAN
  // CHANGE route_key, endpoint_slot, route_id, tunnel_type,
  // source_adapter, sink_adapter OR state — the row's identity is
  // frozen at mint. state is dynamic, but the setter is not on
  // this kind: the tunnel-establishment scaffolds (pcie_tunnel /
  // dp_tunnel / usb3_tunnel) and route_teardown.pdx own the
  // state-machine transitions.
  //
  // LEAF OF THE TB TUNNEL LATTICE. R_TB_ROUTE_MINT is DELIBERATELY
  // absent from R_TB_ROUTE_ALL — nothing derives from a tb-route
  // cap in this milestone.
  //
  // NOT LOADER-SEEDABLE.
  pub let KIND_TB_ROUTE_BASE : u64 = 5              // = KIND_IPC_ENDPOINT
  pub let KIND_TB_ROUTE : u64 = 0x16D               // derived-kind tag (365)

  // ---------------------------------------------------------------------
  // R35.M4-001 (#1210): KIND_DMA_ATTESTATION (0x16E = 366) — the
  // authority a ring-3 dock supervisor holds to record ONE user's DMA
  // consent decision for one Thunderbolt dock (attest_key, inherited
  // endpoint_slot, dock_id, iommu_domain_id, consent_state in
  // {PENDING, GRANTED, REVOKED}, attestation_hash CRC32 over device
  // UUID + firmware version). Derives over KIND_IPC_ENDPOINT (base
  // slot 5), the ELEVENTH kind in this file to take that parent
  // after KIND_FW_SESSION, KIND_EC_QUERY, KIND_HID_EVENT,
  // KIND_SENSOR_CHANNEL, KIND_PCM_STREAM, KIND_AUDIO_ROUTE,
  // KIND_USB_ENDPOINT, KIND_USB_URB, KIND_PCIE_HOTPLUG_EVENT and
  // KIND_TB_ROUTE, and the ELEVENTH time the kind half of the gate
  // is EMPTY on its own: every endpoint in the machine is a
  // KIND_IPC_ENDPOINT.
  //
  // The second half of the gate requires (a) attest_key non-zero and
  // unique among live rows (NO_KEY / IN_USE), (b) endpoint_slot names
  // a live KIND_IPC_ENDPOINT with RIGHT_MINT (BAD_ENDPOINT); the
  // slot is stashed on the row and used by the consent-event fanout
  // path, (c) dock_id fits in u16 and non-zero (BAD_DOCK — zero is
  // reserved as sentinel), (d) iommu_domain_id fits in u16
  // (BAD_DOMAIN — zero is legal, the first VT-d domain), (e)
  // attestation_hash is a non-zero u32 (BAD_HASH — zero means no
  // hash computed, which is not a consent record). consent_state is
  // NOT accepted at mint: every attestation starts PENDING; the
  // transitions to GRANTED / REVOKED are gated to consent_dialog and
  // consent_revoke respectively.
  //
  // ANCHOR OF THE R35.M4 REVOCATION CASCADE. R_DMA_ATTEST_MINT is
  // DELIBERATELY absent from R_DMA_ATTEST_ALL — nothing derives from
  // an attestation cap — but this kind IS the parent of the cascade
  // consent_revoke walks: KIND_DMA_ATTESTATION -> matching
  // KIND_TB_ROUTE rows -> dependent KIND_USB_DEVICE / KIND_TB_DOMAIN
  // -> IOMMU domain unmap (final).
  //
  // Dispatched via cap_invoke_dispatch on `cmp rcx, 0x16E; je
  // call_kind_dma_attest`, comparing the full u64 kind field rather
  // than the 4-bit LAM slot, so it coexists with the slot-5
  // KIND_IPC_ENDPOINT handler. NO OP REACHABLE THROUGH THIS BRANCH
  // CAN CHANGE attest_key, endpoint_slot, dock_id, iommu_domain_id
  // OR attestation_hash — the row's identity is frozen at mint.
  // consent_state is dynamic, but the setter is NOT on this kind:
  // consent_dialog.pdx owns PENDING -> GRANTED and
  // consent_revoke.pdx owns the transitions to REVOKED.
  //
  // NOT LOADER-SEEDABLE.
  pub let KIND_DMA_ATTESTATION_BASE : u64 = 5       // = KIND_IPC_ENDPOINT
  pub let KIND_DMA_ATTESTATION : u64 = 0x16E        // derived-kind tag (366)

  // ---------------------------------------------------------------------
  // R36.M1-004 (#1238): KIND_DISPLAY_ENGINE (0x16F = 367) — one Intel
  // Iris Xe display engine's static identity (engine_key, inherited
  // device_slot, pci_bdf, gpu_gen in {Xe1, Xe2, Xe3}, power_state in
  // {OFF, ON, SUSPEND}, cdclk_khz). Derives over KIND_DEVICE (base
  // slot 10), and the kind half of that gate discriminates NOTHING
  // for the twelfth time in this file: every PCI function is a
  // KIND_DEVICE. Unlike KIND_GPIO_LINE there is no probed table the
  // inherited identity can be looked up in — "this device is a
  // display engine" is a PCI class-code fact the ring-3 supervisor
  // distills, and the capability is the record of ITS decision.
  //
  // The second half of the gate requires (a) engine_key non-zero and
  // unique among live rows (NO_KEY / IN_USE), (b) device_slot names
  // a live KIND_DEVICE with RIGHT_MINT (NO_DEVICE), (c) pci_bdf
  // fits in u16 (BAD_BDF), (d) gpu_gen in {1,2,3} — Xe1/Xe2/Xe3
  // (BAD_GEN; 0 is reserved as unknown), (e) power_state in {0,1,2}
  // — OFF/ON/SUSPEND (BAD_STATE), (f) cdclk_khz within [CDCLK_MIN_
  // KHZ, CDCLK_MAX_KHZ] (BAD_CDCLK — 0 is refused because a live
  // engine at zero clock is not a live engine), (g) rights subset
  // of R_DISPLAY_ENGINE_ALL.
  //
  // OPENS THE R36 DISPLAY BLOCK. R_DISPLAY_ENGINE_MINT is
  // DELIBERATELY absent from R_DISPLAY_ENGINE_ALL — nothing derives
  // from a display-engine cap in this milestone. A future pipe /
  // plane / transcoder / DP-link kind can be added as a separate
  // derived kind that consults this one at mint.
  //
  // Dispatched via cap_invoke_dispatch on `cmp rcx, 0x16F; je
  // call_kind_display_engine`, comparing the full u64 kind field
  // rather than the 4-bit LAM base slot, so it coexists with the
  // slot-10 KIND_DEVICE handler. NO OP REACHABLE THROUGH THIS
  // BRANCH CAN CHANGE engine_key, device_slot, pci_bdf, gpu_gen,
  // power_state OR cdclk_khz — the row's identity is frozen at
  // mint. power_state and cdclk_khz are dynamic in principle but
  // their setters live outside this kind (pwr_wells.pdx owns
  // power-state transitions and dpclk_config.pdx owns clock
  // setpoints).
  //
  // NOT LOADER-SEEDABLE.
  pub let KIND_DISPLAY_ENGINE_BASE : u64 = 10       // = KIND_DEVICE
  pub let KIND_DISPLAY_ENGINE : u64 = 0x16F         // derived-kind tag (367)

  // ---------------------------------------------------------------------
  // R36.M2-003 (#1241): KIND_DISPLAY_OUTPUT (0x170 = 368) — one display
  // output on one KIND_DISPLAY_ENGINE: the DDI a link is attached to,
  // the wire protocol (HDMI / DP / eDP / DP_MST), the current
  // connection state, and the hash of the last EDID the panel produced.
  // Derives over KIND_DEVICE (base slot 10) — the kind half of that
  // gate discriminates NOTHING for the thirteenth time in this file:
  // every PCI function is a KIND_DEVICE. The additional mint gates
  // are: (a) output_key non-zero + unique (NO_KEY / IN_USE); (b)
  // device_slot names a live KIND_DEVICE with RIGHT_MINT (NO_DEVICE);
  // (c) engine_slot names a live KIND_DISPLAY_ENGINE (NO_ENGINE);
  // (d) ddi_index <= 7 (BAD_DDI); (e) output_type in {0 HDMI, 1 DP,
  // 2 eDP, 3 DP_MST} (BAD_TYPE); (f) connected in {0, 1}
  // (BAD_CONNECTED); (g) rights subset of R_DISPLAY_OUTPUT_ALL.
  //
  // OPENS THE R36.M2 DISPLAY-OUTPUT CLUSTER. R_DISPLAY_OUTPUT_MINT is
  // DELIBERATELY absent from R_DISPLAY_OUTPUT_ALL — nothing derives
  // from a display-output cap in this milestone.
  //
  // Dispatched via cap_invoke_dispatch on `cmp rcx, 0x170; je
  // call_kind_display_output`. NO OP REACHABLE THROUGH THIS BRANCH
  // CAN CHANGE output_key, device_slot, engine_slot, ddi_index OR
  // output_type — the row's identity is frozen at mint. connected
  // and edid_hash are dynamic in principle but their setters live
  // outside this kind (hpd_isr.pdx owns connected transitions,
  // edid.pdx owns hash extraction).
  //
  // NOT LOADER-SEEDABLE.
  pub let KIND_DISPLAY_OUTPUT_BASE : u64 = 10       // = KIND_DEVICE
  pub let KIND_DISPLAY_OUTPUT : u64 = 0x170         // derived-kind tag (368)

  // ---------------------------------------------------------------------
  // R36.M3-001 (#1244): KIND_MODESET_TXN (0x171 = 369) — one in-flight
  // atomic modeset transaction: the endpoint the caller runs the session
  // on, the KIND_DISPLAY_OUTPUT the transaction acts against, an FSM
  // state field (OPEN / MODE_SET / PLANE_SET / COMMITTING / ABORTED),
  // and (once set_mode has run) the KIND_DISPLAY_MODE slot the txn will
  // arm. Derives over KIND_IPC_ENDPOINT (base slot 5) — the fifteenth
  // kind in this file to take that parent, and the fifteenth time the
  // kind half of the gate is EMPTY on its own: every endpoint in the
  // machine is a KIND_IPC_ENDPOINT.
  //
  // LINEAR. R_MODESET_TXN_MINT (0x200) is DELIBERATELY ABSENT from
  // R_MODESET_TXN_ALL (0x419). A caller that asks for R_MINT trips
  // mtx_rights_valid before tail_alloc — the row cannot be re-parented.
  // The row-layout linear_flag stamped to 1 at mint is a documented
  // witness of the same discipline (cap/kind_modeset_txn.pdx §0/§3).
  //
  // The second half of the gate requires (a) txn_key non-zero and
  // unique (NO_KEY / IN_USE); (b) endpoint_slot names a live
  // KIND_IPC_ENDPOINT with RIGHT_MINT, and endpoint id is INHERITED
  // from the parent's target_ptr[15:0] (NO_ENDPOINT); (c) output_slot
  // fits u32 — it names the KIND_DISPLAY_OUTPUT the txn will act
  // against (not inherited: a modeset is scoped to the panel, not the
  // conversation); (d) initial state is always OPEN (mint never enters
  // MODE_SET/PLANE_SET/COMMITTING/ABORTED); (e) mode_slot is 0 at mint
  // (set_mode is a modeset_channel transition, not a mint-time field);
  // (f) rights subset of R_MODESET_TXN_ALL.
  //
  // Dispatched via cap_invoke_dispatch on `cmp rcx, 0x171; je
  // call_kind_modeset_txn`. NO OP REACHABLE THROUGH THIS BRANCH CAN
  // CHANGE txn_key, endpoint_slot OR output_slot — the row's identity
  // is frozen at mint. state and mode_slot ARE dynamic but their setter
  // lives outside this kind: modeset_channel.pdx's mch_event_apply is
  // the ONE PATH, calling mtx_row_transition after consulting the FSM
  // transition table.
  //
  // NOT LOADER-SEEDABLE, for the same reasons every derived kind in
  // this family is not.
  pub let KIND_MODESET_TXN_BASE : u64 = 5           // = KIND_IPC_ENDPOINT
  pub let KIND_MODESET_TXN : u64 = 0x171            // derived-kind tag (369)

  // ---------------------------------------------------------------------
  // R36.M3-004 (#1247): KIND_DISPLAY_MODE (0x172 = 370) — one display
  // mode: pixel clock in kHz, active horizontal / vertical resolution,
  // refresh rate in Hz, and format flags (interlaced / double-scan).
  // Derives over KIND_MEMORY (base slot 4). The KIND_MEMORY parent is
  // the record of the byte range those fields were read out of — the
  // kernel never trusts a ring-3 mode blob directly; it trusts the
  // enumerator (drivers/dpy/mode_enum.pdx) that walked it against the
  // engine's declared limits.
  //
  // Second half of the gate requires (a) mode_key non-zero + unique
  // (NO_KEY / IN_USE); (b) memory_slot names a live KIND_MEMORY with
  // RIGHT_MINT (NO_MEMORY); (c) pixel_clock_khz in
  // [DPM_PCLK_MIN_KHZ, DPM_PCLK_MAX_KHZ] (BAD_PCLK); (d) h_active,
  // v_active in (0, u16 max] (BAD_DIM); (e) refresh_hz in
  // (0, DPM_REFRESH_MAX] (BAD_REFRESH); (f) flags subset of
  // DPM_FLAG_ALL (BAD_FLAGS); (g) rights subset of R_DISPLAY_MODE_ALL.
  //
  // LEAF. R_DISPLAY_MODE_MINT is DELIBERATELY ABSENT from
  // R_DISPLAY_MODE_ALL: no cap in this tree derives from a
  // KIND_DISPLAY_MODE. A later pixel-format-aware kind can be
  // introduced as a separate derived kind that consults this one at
  // mint.
  //
  // Dispatched via cap_invoke_dispatch on `cmp rcx, 0x172; je
  // call_kind_display_mode`. NO OP REACHABLE THROUGH THIS BRANCH CAN
  // CHANGE ANY IDENTITY FIELD — the row is frozen at mint.
  //
  // NOT LOADER-SEEDABLE, for the same reasons every derived kind in
  // this family is not.
  pub let KIND_DISPLAY_MODE_BASE : u64 = 4          // = KIND_MEMORY
  pub let KIND_DISPLAY_MODE : u64 = 0x172           // derived-kind tag (370)

  // ---------------------------------------------------------------------
  // R36.M4-001 (#1249): KIND_DISPLAY_PLANE (0x173 = 371) — one display
  // plane on one KIND_DISPLAY_OUTPUT: the plane's identifying key, the
  // KIND_MEMORY row whose byte range holds the pixel buffer scanned out
  // of, the plane class (primary / overlay / cursor), a compositor
  // z-order, a pixel format (fourcc-lite ordinal), and the plane's
  // width and height. Derives over KIND_MEMORY (base slot 4) because
  // the authority to scan out of a byte range must not exceed the
  // authority to reach that range.
  //
  // Second half of the gate requires (a) plane_key non-zero + unique
  // (NO_KEY / IN_USE); (b) memory_slot names a live KIND_MEMORY with
  // RIGHT_MINT (NO_MEMORY); (c) plane_type in {PRIMARY, OVERLAY,
  // CURSOR} (BAD_TYPE); (d) zorder <= 255 (BAD_ZORDER) -- the per-class
  // z-order rule (primary=0, overlay in 1..15, cursor driver-managed)
  // is enforced by the plane driver modules rather than the kind, so
  // the compositor can reason about a plane's z-order before consulting
  // the driver; (e) format in {XRGB8888, NV12, YUYV, RGBA8888, P010}
  // (BAD_FORMAT); (f) width, height in (0, u16 max] (BAD_DIM);
  // (g) rights subset of R_DISPLAY_PLANE_ALL.
  //
  // LEAF. R_DISPLAY_PLANE_MINT is DELIBERATELY ABSENT from
  // R_DISPLAY_PLANE_ALL: no cap in this tree derives from a
  // KIND_DISPLAY_PLANE. The three driver modules (plane_primary,
  // plane_overlay, plane_cursor) consume the row through row accessors
  // rather than by minting children.
  //
  // Dispatched via cap_invoke_dispatch on `cmp rcx, 0x173; je
  // call_kind_display_plane`. NO OP REACHABLE THROUGH THIS BRANCH CAN
  // CHANGE ANY IDENTITY FIELD — the row is frozen at mint.
  //
  // NOT LOADER-SEEDABLE, for the same reasons every derived kind in
  // this family is not.
  pub let KIND_DISPLAY_PLANE_BASE : u64 = 4         // = KIND_MEMORY
  pub let KIND_DISPLAY_PLANE : u64 = 0x173          // derived-kind tag (371)

  // ---------------------------------------------------------------------
  // R37.M3-001 (#1262): KIND_GPU_BO (0x174 = 372) — one GPU Buffer
  // Object: bo_key, memory_slot, size_bytes, tiling, cache and format
  // hint. Derives over KIND_MEMORY (base slot 4). The KIND_MEMORY
  // parent is the record of the byte range this BO is backed by --
  // the kernel never trusts a ring-3 BO blob directly; it trusts the
  // KIND_MEMORY holder that had authority over those bytes.
  //
  // Second half of the gate requires (a) bo_key non-zero + unique
  // (NO_KEY / IN_USE); (b) memory_slot names a live KIND_MEMORY with
  // RIGHT_MINT (NO_MEMORY); (c) size_bytes in (0, u32 max] (BAD_SIZE)
  // -- the allocator (bo_alloc.pdx) refines to one of the six size
  // classes, and this kind holds the width but does not enforce the
  // class discipline; (d) tiling in {LINEAR, X, Y, TILE4, TILEF}
  // (BAD_TILING); (e) cache in {WB, WT, UC, WC} (BAD_CACHE);
  // (f) format_hint fits u16 (compositor hint, NOT a fourcc);
  // (g) rights subset of R_GPU_BO_ALL.
  //
  // LEAF. R_GPU_BO_MINT is DELIBERATELY ABSENT from R_GPU_BO_ALL: no
  // cap in this tree derives from a KIND_GPU_BO. The channel and
  // allocator modules consume the row through row accessors rather
  // than by minting children.
  //
  // Dispatched via cap_invoke_dispatch on `cmp rcx, 0x174; je
  // call_kind_gpu_bo`. NO OP REACHABLE THROUGH THIS BRANCH CAN
  // CHANGE ANY IDENTITY FIELD -- the row is frozen at mint.
  //
  // NOT LOADER-SEEDABLE, for the same reasons every derived kind in
  // this family is not.
  pub let KIND_GPU_BO_BASE : u64 = 4                // = KIND_MEMORY
  pub let KIND_GPU_BO : u64 = 0x174                 // derived-kind tag (372)

  // ---------------------------------------------------------------------
  // R37.M4-001 (#1267): KIND_GPU_VM (0x175 = 373) — one GPU virtual
  // memory context: vm_key, endpoint_slot, pml4_pa, space_id, state.
  // Derives over KIND_IPC_ENDPOINT (base slot 5).  The KIND_IPC_
  // ENDPOINT parent is the endpoint the GPU service dispatches VM ops
  // over; like every KIND_IPC_ENDPOINT-derived kind in this tree, the
  // kind check alone discriminates nothing and the mint gates below
  // cover the rest.
  //
  // Second half of the gate requires (a) vm_key non-zero + unique
  // (NO_KEY / IN_USE); (b) endpoint_slot names a live KIND_IPC_
  // ENDPOINT with RIGHT_MINT (NO_ENDPOINT); (c) pml4_pa non-zero and
  // 4K-aligned (BAD_ROOT); (d) space_id in (0, u16 max] (BAD_SPACE);
  // (e) initial state always STATE_NEW (BAD_STATE); (f) rights subset
  // of R_GPU_VM_ALL.
  //
  // LEAF.  R_GPU_VM_MINT is DELIBERATELY ABSENT from R_GPU_VM_ALL --
  // no cap in this tree derives from a KIND_GPU_VM.  ppgtt_bind and
  // gtt_scanout consume the row through row accessors rather than by
  // minting children.
  //
  // Dispatched via cap_invoke_dispatch on `cmp rcx, 0x175; je
  // call_kind_gpu_vm`.  The only mutable field on the row is `state`,
  // which ppgtt_walker (at first bind) and gpu_vm_cap_revoke advance
  // through kgvm_row_transition -- no op reachable through this branch
  // mutates any identity field.
  //
  // NOT LOADER-SEEDABLE, for the same reasons every derived kind in
  // this family is not.
  pub let KIND_GPU_VM_BASE : u64 = 5                // = KIND_IPC_ENDPOINT
  pub let KIND_GPU_VM : u64 = 0x175                 // derived-kind tag (373)

  // ---------------------------------------------------------------------
  // R37.M5-001 (#1272): KIND_GPU_CONTEXT (0x176 = 374) — one GPU
  // submission context: ctx_key, endpoint_slot, vm_slot (KIND_GPU_VM),
  // engine_id, priority, state, linear_flag.  Derives over
  // KIND_IPC_ENDPOINT (base slot 5).  The KIND_IPC_ENDPOINT parent is
  // the endpoint the GPU service dispatches submission ops for this
  // context over; like every KIND_IPC_ENDPOINT-derived kind in this
  // tree, the kind check alone discriminates nothing and the mint
  // gates below cover the rest.
  //
  // Second half of the gate requires (a) ctx_key non-zero + unique
  // (NO_KEY / IN_USE); (b) endpoint_slot names a live KIND_IPC_
  // ENDPOINT with RIGHT_MINT (this is the parent_slot itself);
  // (c) vm_slot names a live KIND_GPU_VM (BAD_VM); (d) engine_id in
  // {0=RENDER, 1=BLITTER, 2=VIDEO} (BAD_ENGINE); (e) priority fits
  // u8; (f) initial state always STATE_NEW; (g) rights subset of
  // R_GPU_CTX_ALL AND rights & R_MINT == 0 (LINEAR).
  //
  // LINEAR (stronger than LEAF).  R_GPU_CTX_MINT is DELIBERATELY
  // ABSENT from R_GPU_CTX_ALL AND the mint gate carries an EXPLICIT
  // refuse (KGCTX_MINT_REFUSED_MINT) BEFORE the subset check.  Two
  // gates because LEAF says "no child KIND derives"; LINEAR says
  // "no child CAP of any kind ever descends".  The row also carries
  // linear_flag = 1 in body2[31:24] so a downstream consumer can
  // assert LINEAR through kgctx_row_linear without re-reading rights.
  //
  // Dispatched via cap_invoke_dispatch on `cmp rcx, 0x176; je
  // call_kind_gpu_context`.  The only mutable field on the row is
  // `state`, which the LRC-init path (at first ACTIVE) and
  // gpu_ctx_cap_revoke advance through kgctx_row_transition -- no op
  // reachable through this branch mutates any identity field, and
  // linear_flag is frozen at 1.
  //
  // NOT LOADER-SEEDABLE, for the same reasons every derived kind in
  // this family is not.
  pub let KIND_GPU_CONTEXT_BASE : u64 = 5           // = KIND_IPC_ENDPOINT
  pub let KIND_GPU_CONTEXT : u64 = 0x176            // derived-kind tag (374)

  // ---------------------------------------------------------------------
  // R37.M6-001 (#1276): KIND_GPU_SUBMIT (0x177 = 375) — one in-flight
  // GPU submission: submit_key, endpoint_slot, ctx_slot (KIND_GPU_
  // CONTEXT), batch_bo_slot (KIND_GPU_BO), state, linear_flag.
  // Derives over KIND_IPC_ENDPOINT (base slot 5).  The KIND_IPC_
  // ENDPOINT parent is the endpoint the GPU service accepts
  // submission commands over; like every KIND_IPC_ENDPOINT-derived
  // kind in this tree, the kind check alone discriminates nothing
  // and the mint gates below cover the rest.
  //
  // Second half of the gate requires (a) submit_key non-zero +
  // unique (NO_KEY / IN_USE); (b) endpoint_slot names a live KIND_
  // IPC_ENDPOINT with RIGHT_MINT (this is the parent_slot itself);
  // (c) ctx_slot names a live KIND_GPU_CONTEXT (BAD_CTX);
  // (d) batch_bo_slot names a live KIND_GPU_BO (BAD_BO); (e) initial
  // state always STATE_PENDING; (f) rights subset of R_GPU_SUB_ALL
  // AND rights & R_MINT == 0 (LINEAR).
  //
  // LINEAR (stronger than LEAF).  R_GPU_SUB_MINT is DELIBERATELY
  // ABSENT from R_GPU_SUB_ALL AND the mint gate carries an EXPLICIT
  // refuse (KGSUB_MINT_REFUSED_MINT) BEFORE the subset check.  Two
  // gates because LEAF says "no child KIND derives"; LINEAR says
  // "no child CAP of any kind ever descends".  The row also carries
  // linear_flag = 1 in body2[47:40] so a downstream consumer can
  // assert LINEAR through kgsub_row_linear without re-reading rights.
  //
  // Dispatched via cap_invoke_dispatch on `cmp rcx, 0x177; je
  // call_kind_gpu_submit`.  The only mutable field on the row is
  // `state`, which the submit path (at SUBMITTED) and the completion
  // path (at DONE / FAULTED) advance through kgsub_row_transition;
  // no op reachable through this branch mutates any identity field,
  // and linear_flag is frozen at 1.
  //
  // NOT LOADER-SEEDABLE, for the same reasons every derived kind in
  // this family is not.
  pub let KIND_GPU_SUBMIT_BASE : u64 = 5            // = KIND_IPC_ENDPOINT
  pub let KIND_GPU_SUBMIT : u64 = 0x177             // derived-kind tag (375)

  // ============================================================================
  // R38.M3-001 (#1299): KIND_WIFI_PHY -- one WiFi PHY's static identity
  // (phy_key, KIND_DEVICE slot, hw_id from CSR_HW_REV, band_mask, channel
  // count, regdomain_id).  Derives over KIND_DEVICE (base slot 10).
  //
  // Opens R38.M3 (WiFi capability layer): R38.M1 brought up the AX211
  // as a driver-private substrate (probe / fw), R38.M2 laid down the
  // transport plumbing (CTXT_INFO / TX DMA / D1.b DMA domain), and
  // R38.M3 introduces the KIND_WIFI_PHY / KIND_WIFI_VIF / KIND_WIFI_
  // SCAN_TXN triple that a ring-3 supervisor uses to name one radio,
  // one interface, and one in-flight scan.
  //
  // Same fall-through-safe pattern as every derived kind above: the
  // full u64 kind field is compared, not the 4-bit LAM base slot, so
  // this coexists with the slot-10 KIND_DEVICE handler.  NO OP
  // REACHABLE THROUGH THIS BRANCH CAN CHANGE ANY IDENTITY FIELD --
  // the row is frozen at mint; the only mutator anywhere is the
  // revoke helper.  See cap/kind_wifi_phy.pdx.
  pub let KIND_WIFI_PHY_BASE : u64 = 10             // = KIND_DEVICE
  pub let KIND_WIFI_PHY : u64 = 0x178               // derived-kind tag (376)

  // ============================================================================
  // R38.M3-002 (#1300): KIND_WIFI_VIF -- one WiFi virtual interface's
  // identity (vif_key, KIND_IPC_ENDPOINT slot, phy_slot pointing at a
  // KIND_WIFI_PHY, MAC address, mode ordinal, state).  Derives over
  // KIND_IPC_ENDPOINT (base slot 5).
  //
  // The kind half of the derivation gate is EMPTY -- every endpoint in
  // the machine is a KIND_IPC_ENDPOINT.  The second half requires a
  // live KIND_WIFI_PHY at phy_slot AND a plausible (non-zero,
  // non-multicast) MAC AND a valid mode.  Same fall-through-safe
  // pattern.  state advances through wvif_row_transition; identity
  // fields are frozen at mint.  See cap/kind_wifi_vif.pdx.
  pub let KIND_WIFI_VIF_BASE : u64 = 5              // = KIND_IPC_ENDPOINT
  pub let KIND_WIFI_VIF : u64 = 0x179               // derived-kind tag (377)

  // ============================================================================
  // R38.M3-003 (#1303): KIND_WIFI_SCAN_TXN -- one in-flight WiFi scan
  // transaction (scan_key, endpoint_slot, vif_slot naming a
  // KIND_WIFI_VIF, FSM state, result_count, linear_flag frozen at 1).
  // Derives over KIND_IPC_ENDPOINT (base slot 5).  LINEAR.
  //
  // LINEAR TRIPLE-CHECK: (1) R_WSCN_MINT (0x200) ABSENT from
  // R_WSCN_ALL (0x41B), so a mint request with R_MINT set fails the
  // subset test; (2) the mint gate carries an EXPLICIT refuse
  // (WSCN_MINT_REFUSED_MINT) that fires BEFORE the subset check so
  // an operator can distinguish a LINEAR trip from an ordinary
  // rights-mask trip; (3) the row itself carries linear_flag = 1 in
  // body2[23:16] so a downstream consumer walking the row through
  // wscn_row_linear can assert LINEAR without re-reading rights.
  //
  // Same fall-through-safe pattern as every derived kind above.  State
  // advances through wscn_row_transition; result_count advances
  // monotonically through wscn_row_bump_results; no other field is
  // mutable; linear_flag is frozen at 1.  See cap/kind_wifi_scan_txn.pdx.
  pub let KIND_WIFI_SCAN_TXN_BASE : u64 = 5         // = KIND_IPC_ENDPOINT
  pub let KIND_WIFI_SCAN_TXN : u64 = 0x17A          // derived-kind tag (378)

  // ============================================================================
  // R38.M5-001 (#1309): KIND_WIFI_KEY -- ONE 802.11 cryptographic key.
  // SEALED (opaque to userland).  Derived over KIND_MEMORY (base slot 4).
  // ============================================================================
  //
  // The authority to hold ONE key (key_key naming the object, memory_slot
  // naming the backing store, algo, key_id, sealed_len) WITHOUT the
  // material.  design/roadmap/next-wave-softarch.md §358 -- "sealed so an
  // application can hold the cap without the material; only the crypto
  // server can unseal".
  //
  // SEALED TRIPLE-CHECK (§0 of cap/kind_wifi_key.pdx):
  //   (1) R_WKEY_READ (0x001) is ABSENT from R_WKEY_ALL (0x418).
  //   (2) NO OP in the kind reads material -- the enumerated set covers
  //       key_key / memory_slot / algo / key_id / sealed_len /
  //       sealed_flag / bind_to_hw / debug_print; op above MAX returns
  //       UNSUPPORTED.
  //   (3) sealed_flag frozen at 1 in body1[55:48] at mint by
  //       wkey_body1_pack.
  //
  // Same fall-through-safe pattern as every derived kind above -- the
  // full u64 kind field is compared, not the 4-bit LAM base slot, so
  // this coexists with the slot-4 KIND_PAGE handler.  NO OP REACHABLE
  // THROUGH THIS BRANCH CAN CHANGE ANY IDENTITY FIELD -- the row is
  // frozen at mint; the ONLY mutator is the revoke helper.
  // See cap/kind_wifi_key.pdx.
  pub let KIND_WIFI_KEY_BASE : u64 = 4              // = KIND_MEMORY
  pub let KIND_WIFI_KEY : u64 = 0x17B               // derived-kind tag (379)

  // ============================================================================
  // R39.M3-003 (#1333): KIND_BT_GATT_CONNECTION -- one live Bluetooth
  // GATT (Generic Attribute Profile) connection (conn_key,
  // KIND_IPC_ENDPOINT slot, 48-bit remote BD_ADDR, negotiated ATT
  // MTU, FSM state ordinal, security_level ordinal).  Derives over
  // KIND_IPC_ENDPOINT (base slot 5).
  //
  // The kind half of the derivation gate is EMPTY -- every endpoint
  // in the machine is a KIND_IPC_ENDPOINT.  The second half requires
  // a non-zero BD_ADDR (all-zero is reserved by BT §1.2), an ATT MTU
  // in [23, 517] per BT §3.2.9, initial STATE_DISCONNECTED, and a
  // valid security_level (0..3 per BT §5.2.4).  Same fall-through-
  // safe pattern.  state advances through kbgc_row_transition;
  // identity fields (conn_key, endpoint_slot, remote_addr, mtu,
  // security_level) are frozen at mint.  See
  // cap/kind_bt_gatt_connection.pdx.
  pub let KIND_BT_GATT_CONNECTION_BASE : u64 = 5    // = KIND_IPC_ENDPOINT
  pub let KIND_BT_GATT_CONNECTION      : u64 = 0x17C  // derived-kind tag (380)

  // ============================================================================
  // R39.M4-002 (#1336): KIND_BT_PAIRING -- one Bluetooth LE Secure
  // Connections pairing record (pair_key, memory_slot naming the
  // backing store, peer BD_ADDR, ltk_algo, bond_flag, sealed_flag=1).
  // SEALED (opaque to userland).  Derived over KIND_MEMORY (base slot 4).
  //
  // SEALED TRIPLE-CHECK (§0 of cap/kind_bt_pairing.pdx):
  //   (1) R_BTP_READ (0x001) is ABSENT from R_BTP_ALL (0x418).
  //   (2) NO OP in the kind reads LTK material -- the enumerated set
  //       covers pair_key / memory_slot / peer_addr / algo / bond_flag
  //       / sealed_flag / bind_to_link / debug_print; op above MAX
  //       returns UNSUPPORTED.
  //   (3) sealed_flag frozen at 1 in body1[55:48] at mint by
  //       btp_body1_pack.
  //
  // Same fall-through-safe pattern as every derived kind above -- the
  // full u64 kind field is compared, not the 4-bit LAM base slot, so
  // this coexists with the slot-4 KIND_PAGE handler.  NO OP REACHABLE
  // THROUGH THIS BRANCH CAN CHANGE ANY IDENTITY FIELD -- the row is
  // frozen at mint; the ONLY mutator is the revoke helper.
  // See cap/kind_bt_pairing.pdx.
  pub let KIND_BT_PAIRING_BASE : u64 = 4              // = KIND_MEMORY
  pub let KIND_BT_PAIRING      : u64 = 0x17D          // derived-kind tag (381)

  // ============================================================================
  // R40.M2-001 (#1352): KIND_CSI_CAMERA -- one MIPI-CSI camera sensor
  // (cam_key, KIND_DEVICE slot, vendor_id, sensor_id, lanes count,
  // max_width, max_height).  Derived over KIND_DEVICE (base slot 10).
  //
  // The kind half of the derivation gate discriminates nothing on its
  // own -- every PCI/ACPI-discovered function is a KIND_DEVICE.  The
  // mint additionally requires: cam_key non-zero and unique; device_slot
  // names a live KIND_DEVICE; vendor_id/sensor_id in (0, 0xFFFF]; lanes
  // in [1, 4]; max_width/max_height in [1, 8192].  Same fall-through-safe
  // pattern -- full u64 kind field compared, so this coexists with the
  // slot-10 KIND_DEVICE handler.  Every op reachable through this
  // branch is a QUERY -- identity fields are frozen at mint; the ONLY
  // mutator is the revoke helper.  See cap/kind_csi_camera.pdx.
  pub let KIND_CSI_CAMERA_BASE : u64 = 10             // = KIND_DEVICE
  pub let KIND_CSI_CAMERA      : u64 = 0x17E          // derived-kind tag (382)

  // ============================================================================
  // R31.M2-1597 (#1597): THE LOADER-SEEDABLE SET.
  //
  // Which kinds an _init_caps sidecar may ask the loader to mint, and why
  // that list lives HERE rather than in the validator that consults it.
  // ============================================================================
  //
  // WHAT WAS WRONG WITH THE OLD ANSWER
  //
  // init_caps_validate accepted `kind <= 15 || kind == 0x15 || kind == 0x16`
  // -- the closed 4-bit base enum plus two ad-hoc extensions -- with a
  // comment asking whoever added the next derived kind to remember to add a
  // branch. Nobody did. KIND_ACPI (0x20) and KIND_PCI_DEV (0x30) had been
  // declared for rounds, two shipped userspace images declared sidecar
  // entries naming them, and pci_enumerator.pdx even carried a note saying
  // the accept set "will grow" to include them. It never grew, and the
  // images simply could not be loaded.
  //
  // THAT IS THE SMALLER HALF OF THE PROBLEM. The larger half is that
  // `kind <= 15` was never a decision about authority at all -- it was a
  // restatement of how many values fit in the LAM tag field. The base enum
  // contains KIND_PROCESS, KIND_THREAD, KIND_PAGE_TABLE, KIND_PAGE and
  // KIND_SCHED_CTX, whose descriptors carry a KERNEL POINTER in target_ptr,
  // and NOTHING VALIDATES target_ptr. The sidecar is untrusted image bytes.
  // So the old accept set let any image ask to be handed a capability of a
  // kernel-object kind pointing at an address of its choosing, and the only
  // reason that was not exploitable is that no dispatch path for those
  // kinds dereferences the pointer yet.
  //
  // "Fits in four bits" is not a reason to hand something to a boot image.
  //
  // THE NEW ANSWER: AN ENUMERATED SET, WITH A REASON PER ENTRY
  //
  // The kinds a sidecar may seed are precisely the kinds a boot image may
  // be handed WITHOUT ASKING ANYONE. That is an authority question, so the
  // answer is an enumeration and not a range, and it lives next to the kind
  // declarations it names so the two cannot drift the way they just did.
  // tools/verify-cap-seedable-set.sh fails the build if an entry here is
  // not a kind declared in this file.
  //
  //   KIND_IPC_ENDPOINT (5)
  //       An endpoint is the unit of service addressability. A server that
  //       cannot be handed one at load time cannot be a server at all --
  //       there is no bootstrap path by which it could obtain the first
  //       one. target_ptr is an endpoint id resolved through
  //       endpoint_table, which bounds-checks the row; the image cannot
  //       name memory this way, only a row that may or may not exist.
  //
  //   KIND_DRIVER (0x15)
  //       A driver image's identity as a driver. Same bootstrap argument:
  //       the thing that makes it a driver has to arrive with it.
  //
  //   KIND_DMESG (0x16)
  //       Append access to the kernel log ring. Reaches no other task's
  //       state, and a process that cannot say anything cannot be
  //       diagnosed. Already seedable, already exercised by the boot
  //       witness in kernel_main.pdx.
  //
  //   KIND_ACPI (0x20)
  //       Read access to the ACPI static-table byte range, needed by
  //       acpi_supervisor. THIS IS THE WEAKEST ENTRY IN THE LIST and it is
  //       admitted deliberately rather than silently: it is read-only, the
  //       range is firmware-published rather than image-chosen, and the
  //       supervisor is the one process whose whole purpose requires it.
  //       KIND_OP_REGION (0x150) -- the WRITE reach into OpRegion windows
  //       and the embedded controller -- is a different kind precisely so
  //       that it can be refused here while this one is allowed.
  //
  //   KIND_PCI_DEV (0x30)
  //       Config-space read access for pci_enumerator. Same shape and same
  //       argument as KIND_ACPI, one bus over.
  //
  // WHAT IS DELIBERATELY ABSENT, AND WHY EACH ABSENCE IS A REFUSAL
  //
  //   Base kinds 0..4, 6..15 -- the kernel-object kinds. Their target_ptr
  //       is a kernel pointer and the sidecar is untrusted. An image that
  //       needs one of these must DERIVE it from a capability it already
  //       holds, through a mint gate that validates the parent. That is
  //       what derivation is for. This is a NARROWING of the previous
  //       accept set, and the boot witness's own KIND_TIMER (8) entry was
  //       retired to KIND_DMESG for it -- with a new negative sub-test
  //       asserting that KIND_TIMER is now refused, so the narrowing is
  //       witnessed rather than asserted.
  //
  //   KIND_OP_REGION (0x150) and the R30/R29 derived family (0x151
  //       acpi_event, 0x152 i2c_bus, 0x153 i2c_slave, 0x154 gpio_line,
  //       0x155 fw_session, 0x140 hw_interrupt, 0x141 msix_vector, 0x142
  //       dma_domain). Every one of these is defined by its derivation
  //       from a parent, and several carry revoke cascades keyed on a
  //       parent_slot. Seeding one from a sidecar would manufacture a root
  //       with no parent, which is not a shortcut to the same object -- it
  //       is a different and unrevocable object. A supervisor that wants
  //       these gets them by deriving from KIND_ACPI, which is exactly why
  //       KIND_ACPI is the entry above and these are not.
  //
  // ON THE NUMBERING, SINCE #1597 ASKS
  //
  // The regions are NOT a taxonomy, and it is worth saying so rather than
  // letting the next reader infer one:
  //
  //   0..15        deliberate -- the closed 4-bit base enum, sized by the
  //                LAM tag field (bits 53-50), frozen.
  //   0x15, 0x16   HISTORICAL. The first two derived tags, parked just
  //                above the base range because that was the next free
  //                number when KIND_DRIVER and KIND_DMESG were added.
  //   0x20, 0x30   HISTORICAL. Assigned by their own subsystems in
  //                different rounds (acpi_cap.pdx, device_cap.pdx), spaced
  //                by 0x10 with no registry discipline between them.
  //   0x140+       deliberate -- the R29 hardware block.
  //   0x150+       deliberate -- the R30 firmware block.
  //
  // So the answer to "is 0x20/0x30 sitting in a different region on
  // purpose?" is NO: they are where they are by accretion. That is exactly
  // why THIS set must be an enumeration. Had it been written as a range or
  // a mask over the numbering, it would have encoded an accident as a
  // policy -- and every future kind's seedability would have been decided
  // by whichever number happened to be free when it was declared.
  // ============================================================================

  // Number of entries in KIND_SEEDABLE_TABLE. Read by the validator's
  // scan bound and asserted against the table's declared length by
  // tools/verify-cap-seedable-set.sh.
  pub let KIND_SEEDABLE_COUNT : u64 = 5

  // The set itself, in ascending numeric order. Each value MUST be a
  // KIND_* constant declared above; the verify script enforces it.
  pub let KIND_SEEDABLE_TABLE : [u64; 5] = [
    5,      // KIND_IPC_ENDPOINT
    0x15,   // KIND_DRIVER
    0x16,   // KIND_DMESG
    0x20,   // KIND_ACPI
    0x30    // KIND_PCI_DEV
  ]

  // ==========================================================================
  // kind_is_loader_seedable(kind) -> 1 if seedable, 0 otherwise
  //
  // The single predicate every loader-side gate consults. init_caps_validate
  // calls this instead of open-coding a comparison chain, so the accept set
  // has exactly one definition and it is the one above.
  //
  // Linear scan of five entries. A scan rather than a range test because
  // the set is an enumeration on purpose (see §ON THE NUMBERING), and five
  // compares on a path that runs once per sidecar entry at image load is
  // not a cost worth trading a correctness property for.
  // ==========================================================================
  pub let kind_is_loader_seedable : (u64) -> u64 !{mem} @{} =
    fn (kind: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M2-1597 (#1597): answer whether `kind` may be minted from an _init_caps sidecar, by linear scan of KIND_SEEDABLE_TABLE. This is the ONLY definition of the loader-seedable set; init_caps_validate consulted an open-coded `kind <= 15 || kind == 0x15 || kind == 0x16` chain until this landed, which is how KIND_ACPI and KIND_PCI_DEV came to be declared, referenced by two shipped userspace images, and un-seedable for rounds without anything reporting it. Placing the predicate in kind.pdx rather than in the validator is the point of the change: the set is a statement about the kinds, so it lives with the kinds, and a new derived kind is seedable only if someone adds it here with a reason. Walks the table by pointer increment rather than a scaled-index load, matching the conservative addressing idiom used elsewhere in this tree. Leaf function, no nested calls; touches rax/r10/r11 only, all caller-save, so every callee-save register a caller has committed survives -- which is what lets init_caps_validate call it from inside its entry loop with r12-r15 live. Returns 1 or 0 rather than an error code because it is a predicate, and its one caller supplies the INIT_CAPS_BAD_KIND that a false answer becomes. Reads a rodata table -> !{mem}. No capabilities: this decides ABOUT authority, it does not exercise any. Reserved labels: kind_seed_p_.",
      block: {
        lea r10, [rip + KIND_SEEDABLE_TABLE];
        mov r11, 5;                      // KIND_SEEDABLE_COUNT

      kind_seed_p_scan:
        cmp r11, 0;
        je  kind_seed_p_no;
        mov rax, [r10 + 0];
        cmp rax, rdi;
        je  kind_seed_p_yes;
        add r10, 8;
        sub r11, 1;
        jmp kind_seed_p_scan;

      kind_seed_p_yes:
        mov rax, 1;
        ret;

      kind_seed_p_no:
        xor rax, rax;
        ret
      }
    }

}
