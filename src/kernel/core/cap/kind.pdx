// PaideiaOS Phase-2 Capability Kind Enum
// P2-004: cap kind enum (16 base kinds per linearity-and-tags §3.1)
//
// Per design/capabilities/linearity-and-tags.md §3.1:
// Capability kinds are a closed enum of 16 base kinds, encoded in 4 LAM tag bits.
// The kernel's descriptor-table dispatch on kind is an exhaustive switch per the
// FP discipline (substructural lattice). Userspace defines derived kinds purely in
// the type system (functor-typed); the kernel sees only the base kind at runtime.
//
// The 16 base kinds are:
//   0  — null (placeholder, unused descriptor)
//   1  — process (TCB pointer, CSpace root)
//   2  — thread (inherited from Phase 1 API; maps to scheduler context in Phase 2+)
//   3  — page table (memory management, paging structures)
//   4  — page (individual memory page or region)
//   5  — ipc endpoint (Send or Recv side IPC primitive endpoint)
//   6  — ipc port (port-mapped I/O capability)
//   7  — scheduler context (budget, period, priority donation per seL4-MCS)
//   8  — timer (event scheduling and wakeups)
//   9  — interrupt (vector number, CPU affinity mask)
//  10  — device (device memory region and configuration)
//  11  — io port (I/O port access, per driver)
//  12  — notification (async signaling primitive)
//  13  — reply (return-path endpoint for RPC)
//  14  — hw (R29.M0-001 #1017: hardware-adjacent base kind — parent for
//           KIND_INTERRUPT / KIND_MSIX_VECTOR / KIND_DMA_DOMAIN /
//           KIND_HW_TIMELINE landing in R29.M1 #1019-#1022; enables
//           LAM kind-hint fast-dispatch for hardware caps per
//           design/roadmap/next-wave-synthesis.md §10 D6)
//  15  — reserved (reserved for future expansion; today: confidential-
//           computing / TDX per CAP-Q9 open issue + KIND_DMESG derived-
//           kind base per logging-m9-001)
//
// Slot 15 remains reserved deliberately for the confidential-computing
// / TDX growth path (per CAP-Q9); slot 14 was previously reserved (as
// "fault") and is promoted here to KIND_HW per D6 to shelter the family
// of hardware-adjacent derived kinds. The LAM kind-hint must remain 4
// bits, so any future post-D6 base-kind addition would need to displace
// slot 15 and require a major-version event.
//
// R29.M0-001 (#1017) note on the prior "fault" label at slot 14: no
// paideia-os code path ever referenced KIND_FAULT at runtime — it was
// carried in the header comment as a reservation placeholder only (grep
// confirms zero call-site consumers before this rename). Exception /
// fault handling under Phase-2+ is expressed via the R15/R18 IDT + IST
// substrate (design/kernel/interrupts.md), not via a base-kind cap.
// Promoting slot 14 to KIND_HW is therefore a pure enum-label change
// with no dispatch, mint, or descriptor-tail impact today; the
// cap_invoke_dispatch fallthrough (identity return of target_ptr, see
// src/kernel/core/cap/invoke.pdx) still applies to slot-14 caps until
// R29.M1 lands the per-derived-kind handlers.

module Kind = structure {

  // ============================================================================
  // 16-bit capability kind constants (4-bit enum, fits in LAM tag)
  // ============================================================================

  let KIND_NULL : u64 = 0
  let KIND_PROCESS : u64 = 1
  let KIND_THREAD : u64 = 2
  let KIND_PAGE_TABLE : u64 = 3
  let KIND_PAGE : u64 = 4
  // KIND_IPC_ENDPOINT (=5). R20b.M1-001 (#1552) formalizes the
  // descriptor tail (target_ptr) for this kind: bits [15:0] =
  // endpoint_id, bits [17:16] = direction (0=send, 1=recv, 2=bidi),
  // bits [63:18] reserved. See src/kernel/core/cap/kind_endpoint.pdx
  // for the encode/decode helpers, rights refinement, and mint gate,
  // and design/ipc/userspace-server-substrate.md §3.1 for the shape.
  // Base slot 5 is unchanged; the tail is a static refinement, not a
  // new base kind.
  let KIND_IPC_ENDPOINT : u64 = 5
  let KIND_IPC_PORT : u64 = 6
  // R29.M5-001 (#1036): KIND_MEMORY is the name the design documents use
  // for the memory base kind (see design/roadmap/next-wave-softarch.md
  // §P10, which lists KIND_MEMORY alongside KIND_IPC_ENDPOINT /
  // KIND_DEVICE / KIND_INTERRUPT as a derivation base). The runtime
  // 16-slot enum spells that same base kind as KIND_PAGE = 4 —
  // "individual memory page or region", whose dispatch chatter is
  // literally "CAP INVOKE MEM" (cap_mem_msg in tags.pdx). Binding the
  // document vocabulary to the runtime slot ONCE, here, is what keeps
  // derived kinds that specify "derived over KIND_MEMORY" from drifting
  // onto a different slot. This is an alias, NOT a new base kind: the
  // closed 16-kind enum is unchanged.
  pub let KIND_MEMORY : u64 = 4
  let KIND_SCHED_CTX : u64 = 7
  let KIND_TIMER : u64 = 8
  let KIND_INTERRUPT : u64 = 9
  let KIND_DEVICE : u64 = 10
  let KIND_IO_PORT : u64 = 11
  let KIND_NOTIFICATION : u64 = 12
  let KIND_REPLY : u64 = 13
  // R29.M0-001 (#1017): slot 14 promoted from the prior "fault" placeholder
  // to KIND_HW — the base kind for hardware-adjacent capabilities. Per
  // design/roadmap/next-wave-synthesis.md §10 D6:
  //
  //   KIND_HW is the sheltering base for the R29.M1 derived-kind family:
  //     KIND_HW_INTERRUPT      (#1019, landed) — vector + CPU affinity + trigger mode
  //     KIND_HW_MSIX_VECTOR    (#1022, landed) — MSI-X vector under an interrupt parent
  //     KIND_HW_TIMELINE       (planned later) — monotonic hardware clock domain
  //
  //   (A fourth skeleton, KIND_HW_DMA_DOMAIN, was listed here at
  //   R29.M0-001. R29.M5-001 #1036 renamed it to KIND_DMA_DOMAIN and
  //   re-based it over KIND_MEMORY (slot 4) — a DMA domain is a
  //   memory-access scope, not a device-authority handle. It is no
  //   longer part of the KIND_HW family; see the KIND_DMA_DOMAIN block
  //   at the end of this file.)
  //
  //   Fast-dispatch rationale: with KIND_HW at a base slot (4-bit LAM
  //   kind-hint), any hardware-adjacent cap can be routed by a single
  //   `cmp rcx, 14; je call_kind_hw` in cap_invoke_dispatch (identical
  //   shape to KIND_DEVICE dispatch at slot 10). Derived kinds refine
  //   the descriptor tail without displacing the LAM kind-hint.
  //
  // Today (R29.M0-001, this issue): the base kind is registered and
  // mintable; there is NO KIND_HW dispatch branch in invoke.pdx yet —
  // freshly minted KIND_HW caps fall through to the identity return
  // (rax = target_ptr) exactly as slots 11/14/15 did prior to this
  // change. The R29.M1 sub-issues introduce the derived kinds + tail
  // encoders + dispatch branch as a coordinated set.
  //
  // See design/architecture/next-wave-derived-kinds.md §KIND_HW for the
  // base-kind + tail-shape + rights-bitmask spec that R29.M1 refines.
  pub let KIND_HW : u64 = 14
  let KIND_RESERVED : u64 = 15

  // ============================================================================
  // Mask for extracting kind from LAM tag (4 bits)
  // ============================================================================

  let KIND_MASK : u64 = 0xF  // 4-bit mask, fits in LAM tag-bits 53-50

  // ============================================================================
  // D7-004: driver-registration kind
  // ============================================================================
  //
  // SPEC CONFLICT (resolved here): .plans §3 D7-004 says "KIND_DRIVER (new cap
  // kind, value 5)". Value 5 is already KIND_IPC_ENDPOINT in the binding closed
  // 16-kind enum above (design/capabilities/linearity-and-tags.md §3.1), and the
  // base enum is full (slots 0..15 assigned; 14/15 reserved). Silently
  // reassigning slot 5 would break every IPC-endpoint capability in the system.
  //
  // Resolution per Pillar 6 (security by construction) and the closed-enum
  // invariant: KIND_DRIVER is a DERIVED kind, not a new base kind. At runtime it
  // is carried as KIND_DEVICE (base 10) — a driver capability authorises
  // device-memory + config access — with the "driver" refinement expressed in
  // the descriptor's kind-specific tail (the manifest pointer, D7-004). The
  // numeric tag below is above the 4-bit base range to make the derived nature
  // explicit and to avoid any LAM-tag collision.
  let KIND_DRIVER_BASE : u64 = 10        // = KIND_DEVICE (runtime base kind)
  let KIND_DRIVER : u64 = 0x15           // derived-kind tag (decimal 21), out of 4-bit range

  // ============================================================================
  // logging-m9-001 (#708): KIND_DMESG — kernel log-ring stream cap
  // ============================================================================
  //
  // Per design/kernel/kernel-logging-substrate.md §12.10 — post-R18 Phase M9
  // observability handle. The base 4-bit enum (slots 0..15) is closed and full;
  // KIND_DMESG follows the KIND_DRIVER pattern above: derived-kind tag above
  // the 4-bit range (decimal 22) so the LAM kind-hint bits are unaffected, and
  // the runtime base kind stays KIND_RESERVED (15) — the closest semantic
  // match (an inert observability handle, not a scheduling/memory primitive).
  //
  // At mint time (kernel_main.pdx boot witness) the cap is written to the
  // static cap_table with descriptor.kind = KIND_DMESG (22). The linear
  // dispatch chain in cap_invoke_dispatch (src/kernel/core/cap/invoke.pdx)
  // matches on 22 and routes to cap_handler_dmesg.
  //
  // Rights: RIGHT_READ only (0x01). No mutation ops — the ring is written
  // exclusively by klog_emit_core; userspace holders only observe it.
  //
  // Ops (op_arg[7:0] = op_code):
  //   OP_READ_TAIL (0): copy up to op_arg[63:8] bytes from ring[tail..head]
  //                     into a kernel scratch buffer whose address is the
  //                     descriptor's target_ptr. Returns bytes copied.
  //   OP_STAT (1):      returns head packed with size — high 32 bits = head
  //                     (mod 2^32; wraps once every 2^32 log bytes; boot
  //                     workloads stay far below that), low 32 bits = ring
  //                     capacity (KLOG_RING_SIZE = 65536).
  let KIND_DMESG_BASE : u64 = 15         // = KIND_RESERVED (runtime base kind)
  pub let KIND_DMESG : u64 = 0x16        // derived-kind tag (decimal 22), out of 4-bit range

  // ============================================================================
  // R29.M1-001 (#1019): KIND_HW_INTERRUPT — first derived kind over KIND_HW.
  // ============================================================================
  //
  // Per design/roadmap/next-wave-synthesis.md §10 D6 + §3 R29 of
  // next-wave-softarch.md. Rides KIND_HW (base slot 14, promoted at
  // R29.M0-001 #1017). Numeric derived tag chosen distinct from every
  // existing derived kind (KIND_DRIVER=0x15, KIND_DMESG=0x16,
  // KIND_ACPI=0x20, KIND_PCI_DEV=0x30) and above the 4-bit base-slot
  // range so the LAM kind-hint (slot 14) survives.
  //
  // Descriptor payload: target_ptr = row_id in bits [15:0]; row lives in
  // _hw_interrupt_table (kind_hw_interrupt.pdx). Row encodes gsi/affinity
  // /edge_or_level per next-wave-derived-kinds.md §KIND_HW_INTERRUPT
  // and softarch §3 R29's {gsi:u32, cpu_affinity_mask:u64, edge_or_level:u8}
  // spec.
  //
  // Rights: R_HW_INT_INVOKE | R_HW_INT_REVOKE | R_HW_INT_MINT | R_HW_INT_OBSERVE
  //         = 0x008 | 0x010 | 0x200 | 0x400 = 0x618
  //
  // Handler: cap_handler_hw_interrupt in kind_hw_interrupt.pdx. Dispatched
  // via cap_invoke_dispatch on `cmp rcx, 0x140; je call_kind_hw_interrupt`.
  //
  // Slot-9 KIND_INTERRUPT (kind_interrupt.pdx legacy stub) is deprecated
  // at R29.M1-001 close but preserved as compatibility alias until R30
  // open — the two dispatch entries coexist in invoke.pdx.
  let KIND_HW_INT_BASE : u64 = 14         // = KIND_HW (runtime base kind)
  pub let KIND_HW_INTERRUPT : u64 = 0x140 // derived-kind tag (decimal 320)

  // ============================================================================
  // R29.M1-004 (#1022): KIND_HW_MSIX_VECTOR — second derived kind over
  // KIND_HW, layered atop KIND_HW_INTERRUPT.
  // ============================================================================
  //
  // Per design/roadmap/next-wave-synthesis.md §10 D6 and
  // design/architecture/next-wave-derived-kinds.md §KIND_HW_MSIX_VECTOR.
  // Rides KIND_HW (base slot 14) but derives semantically from
  // KIND_HW_INTERRUPT (0x140): a KIND_HW_INTERRUPT cap authorizes a
  // GSI/line, and mints N KIND_HW_MSIX_VECTOR children (one per MSI-X
  // vector on the underlying device). Numeric derived tag 0x141 is
  // adjacent to KIND_HW_INTERRUPT (0x140) in the R29 range; distinct
  // from every existing derived-kind tag.
  //
  // Descriptor payload: target_ptr = row_id in bits [15:0]; row lives
  // in _hw_msix_vector_table (kind_hw_msix_vector.pdx). Row encodes
  // {msix_table_offset:u32, msix_data:u32, parent_slot:u8} plus the
  // in_use flag + reserved u128 for R29.M2+ MSI-X wire-up state.
  //
  // Rights: R_MSIX_INVOKE | R_MSIX_REVOKE | R_MSIX_MINT
  //         = 0x008 | 0x010 | 0x200 = 0x218
  //
  // Handler: cap_handler_hw_msix_vector in kind_hw_msix_vector.pdx.
  // Dispatched via cap_invoke_dispatch on `cmp rcx, 0x141; je
  // call_kind_hw_msix_vector`.
  //
  // Revoke cascade: hw_int_cap_revoke (kind_hw_interrupt.pdx) calls
  // msix_cascade_revoke_by_parent before freeing the parent — no
  // dangling child descriptor can outlive its parent's revoke.
  pub let KIND_HW_MSIX_VECTOR : u64 = 0x141

  // ============================================================================
  // R29.M5-001 (#1036) / R29.M5-002 (#1037): KIND_DMA_DOMAIN — per-driver-
  // process IOMMU domain. Third entry in the R29 derived-kind block.
  // ============================================================================
  //
  // NAMING RECONCILIATION. design/architecture/next-wave-derived-kinds.md
  // carried a planning skeleton called `KIND_HW_DMA_DOMAIN` with runtime
  // base KIND_HW (14). design/roadmap/next-wave-softarch.md §3 R29 and
  // issues #1036/#1037 — the binding spec for this landing — name it
  // `KIND_DMA_DOMAIN` and derive it over KIND_MEMORY. The softarch/issue
  // form wins, and the catalog entry is renamed (not aliased) because no
  // code ever referenced the skeleton:
  //
  //   * A DMA domain is a MEMORY-ACCESS SCOPE, not a device-authority
  //     handle: it names the set of physical pages a bus-mastering device
  //     may reach. Deriving it over KIND_HW would let a holder of pure
  //     device authority manufacture memory reach, inverting the R29
  //     IOMMU invariant (domain cap authorizes the mapping SITE; a
  //     KIND_PAGE cap authorizes the PAGE). Deriving over KIND_MEMORY
  //     makes the mint gate structurally enforce "no widening a device's
  //     reach past memory authority you already hold".
  //   * Keeping the `HW_` infix while changing the base would leave the
  //     name asserting a base kind that is no longer true.
  //
  // Runtime base kind: KIND_MEMORY = KIND_PAGE = 4 (see the KIND_MEMORY
  // binding above). The LAM kind-hint therefore reads slot 4.
  //
  // Numeric derived tag 0x142 is retained from the catalog. The 0x14x
  // block is the R29-ROUND derived-kind block, not a base-slot encoding:
  // the pre-existing derived tags already have no correspondence between
  // tag prefix and base slot (KIND_DRIVER = 0x15 has base 10;
  // KIND_DMESG = 0x16 has base 15). Keeping 0x142 leaves the R29 block
  // contiguous (0x140 interrupt / 0x141 msix / 0x142 dma domain / 0x143
  // timeline reserved) and avoids re-numbering a published value.
  //
  // Descriptor payload: target_ptr = row_id in bits [15:0]; the row lives
  // in _dma_domain_table (kind_dma_domain.pdx) and encodes
  // {iommu_ctx_id:u32, bus_dev_fn:u16, capacity_bytes:u64, coherency:u8}
  // plus the parent_slot (u8, for cascade) and the in_use flag. Row
  // indirection is required because the tail is 104 live bits — it does
  // not fit the 64-bit target_ptr — and it deliberately reuses the exact
  // shape of KIND_HW_INTERRUPT / KIND_HW_MSIX_VECTOR rather than
  // inventing a third encoding.
  //
  // Rights: R_DMA_INVOKE | R_DMA_REVOKE | R_DMA_MINT | R_DMA_OBSERVE
  //         = 0x008 | 0x010 | 0x200 | 0x400 = 0x618
  //
  // Handler: cap_handler_dma_domain in kind_dma_domain.pdx. Dispatched
  // via cap_invoke_dispatch on `cmp rcx, 0x142; je call_kind_dma_domain`.
  //
  // Granularity: ONE domain per driver process (D1.b per
  // design/roadmap/next-wave-synthesis.md §10 and
  // design/drivers/blob-policy.md §2), shared across every device that
  // driver owns — not one per device.
  //
  // Revoke cascade: dma_cascade_revoke_by_parent(parent_slot) revokes
  // every KIND_DMA_DOMAIN whose row records that KIND_MEMORY ancestor,
  // so tearing down memory authority cannot leave a live IOMMU context
  // entry behind. R29.M5-003 wires it into driver-process teardown.
  pub let KIND_DMA_DOMAIN_BASE : u64 = 4   // = KIND_MEMORY (runtime base kind)
  pub let KIND_DMA_DOMAIN : u64 = 0x142    // derived-kind tag (decimal 322)

}
