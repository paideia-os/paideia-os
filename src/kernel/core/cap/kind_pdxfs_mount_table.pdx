// src/kernel/core/cap/kind_pdxfs_mount_table.pdx -- R53-PREP-001 (#1728)
//
// KIND_PDXFS_MOUNT_TABLE = 0x1A5, derived over KIND_MEMORY (= slot 4 =
// KIND_PAGE).
//
// The kernel-owned VIEW capability over the static _mount_table[] array
// in core/fs/mount.pdx (R16-M1-005 (#574), 8 slots x 8 bytes = 64 B, one
// L1D cache line).  A holder of this cap can LIST mounted slots and
// READ ONE ROW of the packed mount-table entry format frozen at
// design/kernel/r16-m1-005-mount-table.md.  This file registers the
// ordinal + basic mint / revoke / row-table substrate + a bare cap-
// invoke handler only -- LIST / READ_ROW ops are DEFERRED to a follow-
// up R53 landing per the M-PREP-scope wording in the issue brief.
// The handler installed at SECTION 6 refuses every op with
// INVOKE_UNSUPPORTED (0xFFFFFFFFFFFFFFFC), matching the "register the
// KIND + capability handler" scope wording the issue mirrors from R52.
// M7-002's KIND_BLOCK_CACHE precedent (kind_block_cache.pdx §6).
//
// =============================================================================
// SECTION 0  WHY DERIVED OVER KIND_MEMORY
// =============================================================================
//
// design/tooling/volume-tooling-ux.md §"KIND_PDXFS_MOUNT_TABLE" names
// KIND_MEMORY (4) -- not a narrower kind -- as this kind's base
// ("derived over KIND_MEMORY = 4").  Same argument as KIND_VOLUME /
// KIND_BLOCK_CACHE / KIND_SIG_KEY: the mount table is not a refinement
// of another derived-kind authority; it is a fresh root of mount-
// enumeration authority whose backing storage is ordinary memory.  The
// derivation gate is therefore the same "cannot widen memory reach
// beyond what you already hold" rule KIND_VOLUME itself uses (see
// kind_volume.pdx §0): parent.kind == KIND_MEMORY (4) AND rights carry
// RIGHT_MINT (0x200).
//
// Supervisor-only mint.  There is no cap-invoke op that reaches
// kind_pdxfs_mount_table_mint (the same structural discipline
// kind_volume.pdx / kind_block_cache.pdx use: mint is a kernel-trusted
// primitive callable only from boot / mount / supervisor code that
// already holds a root KIND_MEMORY parent cap with RIGHT_MINT).  A
// ring-3 caller holding only a KIND_PDXFS_MOUNT_TABLE handle cannot
// mint a fresh row -- it can only reach the handler's op dispatch,
// which at this landing has no ops wired.  Same posture as KIND_VOLUME's
// own "no ring-3 mint surface" contract.
//
// =============================================================================
// SECTION 1  TAIL ENCODING
// =============================================================================
//
// Row layout (64 bytes, eight u64 words):
//
//   [+0]   header0: in_use[63:56] | flags_lo[55:32] | gen[31:16] | kind[15:0]
//   [+8]   header1: reserved[63:32] | res[31:16] | mount_slot_count[15:0]
//   [+16]  table_row_addr  (u64)   -- runtime address of _mount_table[]
//                                     stamped at mint time via
//                                     lea rax, [rip + _mount_table]
//   [+24]  reserved        (u64)
//   [+32]  reserved        (u64)
//   [+40]  reserved        (u64)
//   [+48]  reserved        (u64)
//   [+56]  reserved        (u64)
//
// The `flags` field the design brief names as u32 packs into
// header0[55:32] (24 bits) with the top byte reserved for the
// allocator's in_use marker at [63:56] -- same convention KIND_VOLUME /
// KIND_BLOCK_CACHE use on their own header words.  A future landing
// that needs the full 32 bits of user flags can move in_use into
// header1's reserved [63:32] slice at a design cost; the 24-bit slice
// is sufficient for M-PREP's own flag needs (no flag names are wired
// yet at this landing).
//
// mount_slot_count is stamped at mint time as MOUNT_MAX (8) from
// core/fs/mount.pdx, and MUST match the actual _mount_table[] size.
// If a future landing widens the _mount_table[] array, this constant
// AND the mount.pdx MOUNT_MAX AND every witness fixture that binds to
// the pair must move together; the ec_confine_one gate on _kind_pmt_
// table + _kind_pmt_stats does not police cross-module invariants.
//
// Reserved footprint: header1[63:32] (4 bytes) + words 3..7 (40 bytes)
// = 44 bytes.  The task brief names 40 bytes of reserved; the four-
// byte delta is the pad the flags/in_use co-hosting yields on header0
// combined with header1's split -- identical arithmetic to KIND_BLOCK_
// CACHE's "20-byte reserved" note (kind_block_cache.pdx §1 line 68).
//
// Row-addressed capacity: 1 row x 64 bytes = 64 bytes.  KIND_PDXFS_
// MOUNT_TABLE is a SINGLETON authority (there is exactly one
// _mount_table[] in the kernel), so only one row need ever be live.
// The row-table storage is sized to 1 for that reason; a second mint
// against a live row surfaces PMT_REGISTRY_FULL (0xFFFFED54).  This is
// the reverse of the KIND_VOLUME / KIND_BLOCK_CACHE 16-row shape and
// matches the singleton posture the design doc names ("write authority
// is bounded to append a mount entry from a validated KIND_VOLUME;
// read authority is broadly granted so `df` and `mount --list` can
// enumerate").
//
// =============================================================================
// SECTION 2  RIGHTS
// =============================================================================
//
//   R_PMT_READ    (0x001) -- reserved; LIST / READ_ROW observation
//                            through the handler once ops are wired
//   R_PMT_WRITE   (0x002) -- reserved; APPEND_ROW (write authority
//                            per design doc; out of scope at M-PREP)
//   R_PMT_INVOKE  (0x008) -- reserved; QUERY ops
//   R_PMT_REVOKE  (0x010) -- supervisor teardown
//   R_PMT_OBSERVE (0x400) -- reserved; debug printer
//   R_PMT_ALL     (0x41B)
//
// =============================================================================
// SECTION 3  FAILURE TAXONOMY  0xFFFFED50..0xFFFFED57  (R53-PREP band)
// =============================================================================
//
// The R53-PREP band 0xFFFFED50..0xFFFFED57 is unclaimed by any prior
// landing (verified against every 0xFFFFED* constant in the tree at
// this file's authoring time; the immediately preceding band
// 0xFFFFED48 is PATH_LOOKUP_PENDING_UNMOUNT in core/fs/path.pdx, and
// the R52.M7 prefetch sub-band 0xFFFFED40..47 is fully allocated by
// core/fs/pdxfs/block_cache_prefetch.pdx).  This file claims the codes
// its own mint / revoke path needs; the remaining slots stay reserved
// for whichever future R53 landing wires LIST / READ_ROW / APPEND_ROW.
//
//   PMT_MINT_BAD_PARENT   0xFFFFED50
//   PMT_MINT_BAD_RIGHTS   0xFFFFED51
//   PMT_TAIL_BAD_ARG      0xFFFFED52
//   PMT_BAD_SLOT          0xFFFFED53
//   PMT_REGISTRY_FULL     0xFFFFED54
//   -- 0xFFFFED55..0xFFFFED57 reserved for R53 op walker landings.
//
// =============================================================================
// SECTION 4  paideia-as encoder-gap posture
// =============================================================================
//
// Kind-tag constant 0x1A5 (KIND_PDXFS_MOUNT_TABLE) does not sign-
// extend cleanly from a 32-bit immediate for `cmp reg, imm` forms
// (same 0x100..0xFFF band note as kind_volume.pdx §4 and
// kind_block_cache.pdx §4); every compare against it stages through
// r11 first.  KIND_MEMORY (4) needs no staging.  No mov_b / mov_w /
// mov_d anywhere in this file -- every sub-field is packed / unpacked
// in full 64-bit registers via shift + mask.  No `test` instruction;
// bit checks use `and` + `cmp`.  Labels prefixed `pmt_`.
//
// =============================================================================
// SECTION 5  ARITY -- THE cap_mint_inner COLLAPSE
// =============================================================================
//
// kind_pdxfs_mount_table_mint(parent_slot, rights) -- two args, well
// under the SysV register cap.  flags default to 0 at this landing
// (no user-flag ordinals wired yet).  mount_slot_count is stamped
// from mount.pdx's MOUNT_MAX (8) at tail_alloc time.  The four
// header words are internally packed; callers do not pre-pack (the
// KIND_BLOCK_CACHE mint's pre-pack posture is unnecessary here
// because the singleton row has no variable-shape ext-data).

module KindPdxfsMountTable = structure {

  pub let KIND_PDXFS_MOUNT_TABLE      : u64 = 0x1A5
  pub let KIND_PDXFS_MOUNT_TABLE_BASE : u64 = 4         // = KIND_MEMORY

  pub let R_PMT_READ    : u64 = 0x001
  pub let R_PMT_WRITE   : u64 = 0x002
  pub let R_PMT_INVOKE  : u64 = 0x008
  pub let R_PMT_REVOKE  : u64 = 0x010
  pub let R_PMT_OBSERVE : u64 = 0x400
  pub let R_PMT_ALL     : u64 = 0x41B

  // LIST / READ_ROW / APPEND_ROW are still unwired at this landing (they
  // fall through SECTION 6's dispatch to INVOKE_UNSUPPORTED). Ordinals are
  // reserved here so those follow-up walkers do not have to re-derive the
  // numbering. QUERY_SLOT_COUNT (3) and REMOVE_ROW (4) below ARE wired.
  pub let PMT_OP_LIST               : u64 = 0
  pub let PMT_OP_READ_ROW           : u64 = 1
  pub let PMT_OP_APPEND_ROW         : u64 = 2
  pub let PMT_OP_QUERY_SLOT_COUNT   : u64 = 3
  // R90-XREPO.KRN op ordinal for row removal (added to unblock
  // umount.pdxfs.M2-003's mount-table update ABI). op_arg[7:0] carries
  // the op ordinal itself (matching every op's dispatch convention in
  // SECTION 6) -- there is no separate row-index operand at this landing
  // because the mount table is a PMT_MAX == 1 singleton (§1), so "which
  // row" is never ambiguous. Returns 0 (stub) -- real per-row removal
  // semantics require _mount_table[] cross-module write access which is
  // one-writer-confined to mount.pdx. The ABI edge is now open; the real
  // body follows a later mount-table side-table redesign. Conservative
  // behavior: umount consumers see OK and proceed. Gated on R_PMT_WRITE
  // (write authority) same as APPEND_ROW would be, per SECTION 2.
  pub let PMT_OP_REMOVE_ROW         : u64 = 4
  pub let PMT_OP_MAX                : u64 = 4

  // Failure taxonomy.  0xFFFFED50..0xFFFFED57, the whole R53-PREP band.
  pub let PMT_OK                  : u64 = 0
  pub let PMT_MINT_BAD_PARENT     : u64 = 0xFFFFED50
  pub let PMT_MINT_BAD_RIGHTS     : u64 = 0xFFFFED51
  pub let PMT_TAIL_BAD_ARG        : u64 = 0xFFFFED52
  pub let PMT_BAD_SLOT            : u64 = 0xFFFFED53
  pub let PMT_REGISTRY_FULL       : u64 = 0xFFFFED54

  pub let PMT_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let PMT_ROW_NONE   : u64 = 0xFF

  // Ceilings.  Singleton row -- see §1 for the singleton posture.
  pub let PMT_MAX       : u64 = 1
  pub let PMT_ROW_BYTES : u64 = 64
  // 1 row * 64 bytes = 64 bytes = 8 u64.
  pub let mut _kind_pmt_table : [u64; 8] = uninit @align(64)
  pub let mut _kind_pmt_stats : [u64; 8] = uninit @align(64)

  pub let PMT_ST_MINTS   : u64 = 0
  pub let PMT_ST_REVOKES : u64 = 1
  pub let PMT_ST_QUERIES : u64 = 2
  pub let PMT_ST_REFUSED : u64 = 3
  pub let PMT_ST_MAX     : u64 = 8

  // Value stamped into header1[15:0] at tail_alloc time.  MUST match
  // mount.pdx MOUNT_MAX; if that constant moves, this one moves with
  // it (see §1 for the co-move discipline).
  pub let PMT_MOUNT_SLOT_COUNT : u64 = 8

  // ==========================================================================
  // pmt_table_reset() -> ()
  //
  // Clear every row and every counter.  Boot and teardown only.  Two
  // separate loops mirror kind_block_cache.pdx's shape one-for-one.
  // ==========================================================================
  pub let pmt_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R53-PREP-001 (#1728): clear every row and every counter. Boot and teardown only. Labels prefixed pmt_rs_.",
      block: {
        lea r10, [rip + _kind_pmt_table];
        xor rax, rax;
        xor rcx, rcx;
      pmt_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  pmt_rs_rows;

        lea r10, [rip + _kind_pmt_stats];
        xor rcx, rcx;
      pmt_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  pmt_rs_stats;
        ret
      }
    }

  pub let pmt_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R53-PREP-001 (#1728): bounded increment; out-of-range no-op. Labels prefixed pmt_nt_.",
      block: {
        cmp rdi, 8;
        jae pmt_nt_out;
        lea r10, [rip + _kind_pmt_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      pmt_nt_out:
        ret
      }
    }

  pub let pmt_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R53-PREP-001 (#1728): bounded read; out-of-range returns 0. Labels prefixed pmt_st_.",
      block: {
        cmp rdi, 8;
        jae pmt_st_zero;
        lea r10, [rip + _kind_pmt_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      pmt_st_zero:
        xor rax, rax;
        ret
      }
    }

  pub let pmt_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R53-PREP-001 (#1728): subset test against R_PMT_ALL = 0x41B. Labels prefixed pmt_rv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x41B;
        and rax, r10;
        cmp rax, rdi;
        jne pmt_rv_no;
        mov rax, 1;
        ret;
      pmt_rv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // pmt_check_parent_memory(parent_slot) -> 1 | 0
  //
  // Derivation gate.  parent.kind == KIND_MEMORY (4) AND rights carry
  // RIGHT_MINT (0x200).  Mirrors kind_block_cache.pdx's block_cache_
  // check_parent_memory / kind_volume.pdx's volume_check_parent_memory
  // one-for-one.
  // ==========================================================================
  pub let pmt_check_parent_memory : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R53-PREP-001 (#1728): derivation gate. Bounds-check parent_slot < 256; descriptor at cap_table + slot*24 (stride 24 per cap/mint.pdx); require kind ([+0]) == KIND_MEMORY (4) AND (rights & RIGHT_MINT 0x200) != 0. Mirrors kind_block_cache.pdx's block_cache_check_parent_memory one-for-one -- KIND_MEMORY(4) is a small immediate, no r11 staging needed. Pure read. Labels prefixed pmt_cpm_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae pmt_cpm_no;

        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 4;                      // KIND_MEMORY
        jne pmt_cpm_no;

        mov r10, [rax + 8];
        mov r11, 0x200;                  // RIGHT_MINT
        and r10, r11;
        cmp r10, 0;
        je  pmt_cpm_no;

        mov rax, 1;
        ret;

      pmt_cpm_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // pmt_tail_alloc() -> row_id (0) | PMT_REGISTRY_FULL
  //
  // THE ONLY FUNCTION IN THE KERNEL THAT WRITES A KIND_PDXFS_MOUNT_
  // TABLE ROW; tools/build.sh confines relocations against
  // _kind_pmt_table to this object.  Singleton posture (PMT_MAX = 1)
  // means the scan is a single-row check: row 0's in_use byte set ->
  // PMT_REGISTRY_FULL, else claim row 0.  header0 packs
  // kind=0x1A5|gen=0|flags=0|in_use=1, header1 packs
  // mount_slot_count=8|res=0|reserved_hi=0, word 2 stamps
  // lea [rip+_mount_table], words 3..7 zero.
  // ==========================================================================
  pub let pmt_tail_alloc : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R53-PREP-001 (#1728): claim the one KIND_PDXFS_MOUNT_TABLE row. THE ONLY WRITER of _kind_pmt_table; tools/build.sh confines it via ec_confine_one. Singleton posture (PMT_MAX=1) collapses the scan to a single check on row 0's in_use byte at [+0]>>56. Header packing: header0 in [rax] combines kind=0x1A5 (r11-staged per §4 encoder-gap) at [15:0], gen=0 at [31:16], flags=0 at [55:32], in_use=1 at [63:56]. header1 combines mount_slot_count=8 at [15:0], res=0 at [31:16], reserved_hi=0 at [63:32]. Word 2 stamps the runtime address of _mount_table[] via lea [rip+_mount_table]; words 3..7 zeroed. No callee-save needed -- no nested calls, no callee-save reg touched. Labels prefixed pmt_ta_.",
      block: {
        lea r10, [rip + _kind_pmt_table];

        // Singleton scan: row 0's in_use byte at [+0]>>56.
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        jne pmt_ta_enospc;

        // Claim row 0.  header0: kind=0x1A5 | gen=0 | flags=0 | in_use=1.
        mov r11, 0x1A5;                  // KIND_PDXFS_MOUNT_TABLE
        mov rax, r11;                    // kind at [15:0]
        mov r11, 1;
        shl r11, 56;                     // in_use at [63:56]
        or  rax, r11;
        mov [r10 + 0], rax;

        // header1: mount_slot_count=8 | res=0 | reserved_hi=0.
        mov rax, 8;                      // PMT_MOUNT_SLOT_COUNT
        mov [r10 + 8], rax;

        // table_row_addr: runtime address of _mount_table[].
        lea rax, [rip + _mount_table];
        mov [r10 + 16], rax;

        // Reserved words 3..7 = 0.
        xor rax, rax;
        mov [r10 + 24], rax;
        mov [r10 + 32], rax;
        mov [r10 + 40], rax;
        mov [r10 + 48], rax;
        mov [r10 + 56], rax;

        xor rax, rax;                    // row_id = 0
        ret;

      pmt_ta_enospc:
        mov rax, 0xFFFFED54;             // PMT_REGISTRY_FULL
        ret
      }
    }

  pub let pmt_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R53-PREP-001 (#1728): 1 iff row_id < PMT_MAX (1) and in_use byte set. Labels prefixed pmt_tv_.",
      block: {
        cmp rdi, 1;
        jae pmt_tv_no;
        lea r10, [rip + _kind_pmt_table];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  pmt_tv_no;
        mov rax, 1;
        ret;
      pmt_tv_no:
        xor rax, rax;
        ret
      }
    }

  pub let pmt_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R53-PREP-001 (#1728): scrub row (all eight words). Labels prefixed pmt_tf_.",
      block: {
        cmp rdi, 1;
        jae pmt_tf_out;
        lea r10, [rip + _kind_pmt_table];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        mov [r10 + 32], rax;
        mov [r10 + 40], rax;
        mov [r10 + 48], rax;
        mov [r10 + 56], rax;
      pmt_tf_out:
        ret
      }
    }

  // -------------------------------------------------------------------
  // Row accessors.  Each returns PMT_DECODE_BAD when the row is not
  // live.  Shape mirrors kind_block_cache.pdx / kind_volume.pdx row
  // accessors one-for-one.  These are the M-PREP public surface the
  // future LIST / READ_ROW walkers will thread through.
  // -------------------------------------------------------------------

  // kind_pdxfs_mount_table_row(row_id) -> row_ptr | 0
  //
  // Returns the base address of the row's 64-byte slot on a live row,
  // or 0 on a dead / out-of-range row.  The future LIST / READ_ROW
  // walkers hold this pointer while extracting mount_slot_count and
  // table_row_addr in place.
  pub let kind_pdxfs_mount_table_row : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R53-PREP-001 (#1728): row_id -> base pointer of the 64-byte row, or 0 on dead / out-of-range. pmt_tail_valid gate. One callee-save push preserves row_id across the pmt_tail_valid call. Labels prefixed pmt_rp_.",
      block: {
        push r12;
        mov r12, rdi;
        call pmt_tail_valid;
        cmp rax, 0;
        je  pmt_rp_bad;
        lea r10, [rip + _kind_pmt_table];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;
        mov rax, r10;
        jmp pmt_rp_out;
      pmt_rp_bad:
        xor rax, rax;
      pmt_rp_out:
        pop r12;
        ret
      }
    }

  // kind_pdxfs_mount_table_kind(row_id) -> kind (0x1A5) | PMT_DECODE_BAD
  //
  // The witness-facing "read back the KIND field" accessor.  Returns
  // header0[15:0], which must be 0x1A5 on any live row (pmt_tail_alloc
  // stamps that value; no other writer touches the row).
  pub let kind_pdxfs_mount_table_kind : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R53-PREP-001 (#1728): header0 kind field (bits [15:0]), or PMT_DECODE_BAD. Labels prefixed pmt_rk_.",
      block: {
        push r12;
        mov r12, rdi;
        call pmt_tail_valid;
        cmp rax, 0;
        je  pmt_rk_bad;
        lea r10, [rip + _kind_pmt_table];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        mov r10, 0xFFFF;
        and rax, r10;
        jmp pmt_rk_out;
      pmt_rk_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      pmt_rk_out:
        pop r12;
        ret
      }
    }

  // kind_pdxfs_mount_table_slot_count(row_id) -> mount_slot_count |
  //   PMT_DECODE_BAD
  //
  // Returns header1[15:0] (the count of _mount_table[] slots this
  // cap covers -- stamped as MOUNT_MAX at mint).
  pub let kind_pdxfs_mount_table_slot_count : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R53-PREP-001 (#1728): header1 mount_slot_count (bits [15:0]), or PMT_DECODE_BAD. Labels prefixed pmt_rsc_.",
      block: {
        push r12;
        mov r12, rdi;
        call pmt_tail_valid;
        cmp rax, 0;
        je  pmt_rsc_bad;
        lea r10, [rip + _kind_pmt_table];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 8];
        mov r10, 0xFFFF;
        and rax, r10;
        jmp pmt_rsc_out;
      pmt_rsc_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      pmt_rsc_out:
        pop r12;
        ret
      }
    }

  // kind_pdxfs_mount_table_table_addr(row_id) -> table_row_addr | 0
  //
  // Returns word 2 (the runtime address of _mount_table[] stamped at
  // mint).  Returns 0 (rather than PMT_DECODE_BAD) on a dead row so
  // the "is this pointer live" check is a single compare.
  pub let kind_pdxfs_mount_table_table_addr : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R53-PREP-001 (#1728): word 2 table_row_addr, or 0 on dead / out-of-range row. Labels prefixed pmt_rta_.",
      block: {
        push r12;
        mov r12, rdi;
        call pmt_tail_valid;
        cmp rax, 0;
        je  pmt_rta_bad;
        lea r10, [rip + _kind_pmt_table];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 16];
        jmp pmt_rta_out;
      pmt_rta_bad:
        xor rax, rax;
      pmt_rta_out:
        pop r12;
        ret
      }
    }

  // Slot -> row_id, gated on the descriptor being a live KIND_PDXFS_
  // MOUNT_TABLE.  Kind constant 0x1A5 staged in r11 (§4).
  pub let pmt_row_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R53-PREP-001 (#1728): slot -> row_id gated on KIND_PDXFS_MOUNT_TABLE. THE ONLY ROUTE IN THE KERNEL FROM A CAP SLOT TO A PMT ROW. Labels prefixed pmt_ros_.",
      block: {
        push r12;

        mov r11, 256;
        cmp rdi, r11;
        jae pmt_ros_none;

        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x1A5;                  // KIND_PDXFS_MOUNT_TABLE
        cmp r10, r11;
        jne pmt_ros_none;

        // Singleton: descriptor's target_ptr low u16 is the row_id
        // (0 on the one live row).  Same shape KIND_BLOCK_CACHE uses.
        mov r12, [rax + 16];
        mov r10, 0xFFFF;
        and r12, r10;

        mov rdi, r12;
        call pmt_tail_valid;
        cmp rax, 0;
        je  pmt_ros_none;

        mov rax, r12;
        jmp pmt_ros_out;

      pmt_ros_none:
        mov rax, 0xFF;                   // PMT_ROW_NONE
      pmt_ros_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // pmt_cap_revoke(row_id) -> PMT_OK | PMT_BAD_SLOT
  // ==========================================================================
  pub let pmt_cap_revoke : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R53-PREP-001 (#1728): scrub the one row via pmt_tail_free and bump REVOKES. Refuses out-of-range OR already-dead rows with the same PMT_BAD_SLOT code (mirroring block_cache_cap_revoke's precedent -- basic mint/revoke scope per the design brief). Two callee-save pushes leave rsp%16 == 0. Labels prefixed pmt_cr_.",
      block: {
        push r12;
        push r13;

        mov r12, rdi;
        cmp r12, 1;                      // PMT_MAX
        jae pmt_cr_bad_slot;

        mov rdi, r12;
        call pmt_tail_valid;
        cmp rax, 0;
        je  pmt_cr_bad_slot;

        mov rdi, r12;
        call pmt_tail_free;
        mov rdi, 1;                      // PMT_ST_REVOKES
        call pmt_note;
        xor rax, rax;                    // PMT_OK
        jmp pmt_cr_out;

      pmt_cr_bad_slot:
        mov rax, 0xFFFFED53;             // PMT_BAD_SLOT

      pmt_cr_out:
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // kind_pdxfs_mount_table_mint(parent_slot, rights)
  //   -> row_id (0) | PMT_MINT_*
  //
  // §5: no pre-packed args.  Gate sequence: (1) parent (KIND_MEMORY +
  // RIGHT_MINT); (2) rights subset; (3) tail_alloc (singleton row 0,
  // header/body internally packed).  Two callee-save pushes + sub rsp
  // 8 = 24 bytes: post-prologue rsp%16 == 0 for every nested call,
  // mirroring kind_block_cache.pdx's kind_block_cache_mint (with the
  // hdr/ext callee-saves collapsed away because tail_alloc takes no
  // args here).  Refusal paths bump PMT_ST_REFUSED.
  //
  // Supervisor-only: no cap-invoke op reaches this function; a
  // KIND_PDXFS_MOUNT_TABLE holder cannot mint a fresh row -- only
  // kernel-side code holding a root KIND_MEMORY parent cap with
  // RIGHT_MINT can (same structural pattern as kind_volume.pdx /
  // kind_block_cache.pdx).
  // ==========================================================================
  pub let kind_pdxfs_mount_table_mint : (u64, u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) (rights: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R53-PREP-001 (#1728): the KIND_PDXFS_MOUNT_TABLE mint walker. Gate sequence: parent (KIND_MEMORY + RIGHT_MINT), rights subset, tail_alloc. Two callee-save pushes (r12=parent_slot, r13=rights) + sub rsp, 8 = 24 bytes: post-prologue rsp%16 == 0 for every nested call, mirroring kind_block_cache.pdx's kind_block_cache_mint with the hdr/ext callee-saves collapsed away (tail_alloc takes no args here). Refusal paths bump PMT_ST_REFUSED. Labels prefixed pmt_mi_.",
      block: {
        push r12;
        push r13;
        sub rsp, 8;

        mov r12, rdi;                    // parent_slot
        mov r13, rsi;                    // rights

        // (1) Parent gate.
        mov rdi, r12;
        call pmt_check_parent_memory;
        cmp rax, 0;
        je  pmt_mi_bad_parent;

        // (2) Rights subset.
        mov rdi, r13;
        call pmt_rights_valid;
        cmp rax, 0;
        je  pmt_mi_bad_rights;

        // (3) tail_alloc.
        call pmt_tail_alloc;
        mov r10, 1;                      // PMT_MAX
        cmp rax, r10;
        jae pmt_mi_alloc_fail;

        push rax;
        mov rdi, 0;                      // PMT_ST_MINTS
        call pmt_note;
        pop rax;
        jmp pmt_mi_out;

      pmt_mi_alloc_fail:
        jmp pmt_mi_refused;
      pmt_mi_bad_parent:
        mov rax, 0xFFFFED50;             // PMT_MINT_BAD_PARENT
        jmp pmt_mi_refused;
      pmt_mi_bad_rights:
        mov rax, 0xFFFFED51;             // PMT_MINT_BAD_RIGHTS

      pmt_mi_refused:
        push rax;
        mov rdi, 3;                      // PMT_ST_REFUSED
        call pmt_note;
        pop rax;

      pmt_mi_out:
        add rsp, 8;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // SECTION 6  cap_handler_pdxfs_mount_table(rights, target_ptr, op_arg)
  //
  // Wired into cap_invoke_dispatch on `cmp rcx, 0x1A5; je call_kind_
  // pdxfs_mount_table`.  QUERY_SLOT_COUNT (3) and REMOVE_ROW (4) are wired
  // as of R90-XREPO.KRN; LIST / READ_ROW / APPEND_ROW (named in design/
  // tooling/volume-tooling-ux.md) remain unwired and fall through to
  // INVOKE_UNSUPPORTED -- the ordinals PMT_OP_* are reserved above so
  // those follow-up landings do not have to re-derive the numbering.
  //
  // RIGHTS PER OP, mirroring kind_volume.pdx's cap_handler_volume posture:
  // QUERY_SLOT_COUNT requires R_PMT_INVOKE; REMOVE_ROW requires
  // R_PMT_WRITE (removing a mount-table row is write authority over the
  // table, same bucket APPEND_ROW will use). Missing rights -> INVOKE_
  // DENIED (0xFFFFFFFFFFFFFFFD), not silently granted.
  //
  // op_arg[63:8] must be zero -- a smuggled second value on an op
  // reaching a mount-table row is refused rather than masked, mirroring
  // kind_block_cache.pdx's own posture on the same shape.
  // ==========================================================================
  pub let cap_handler_pdxfs_mount_table : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R53-PREP-001 (#1728) / R90-XREPO.KRN: KIND_PDXFS_MOUNT_TABLE dispatch. QUERY_SLOT_COUNT (op 3) requires R_PMT_INVOKE; REMOVE_ROW (op 4) requires R_PMT_WRITE; everything else returns INVOKE_UNSUPPORTED (0xFFFFFFFFFFFFFFFC). op_arg[63:8] MUST be zero -- a smuggled second value is refused with PMT_TAIL_BAD_ARG rather than masked. r12=rights carried across the op-arg gate. Labels prefixed pmt_hn_.",
      block: {
        push r12;
        mov r12, rdi;                    // rights
        mov r10, rdx;                    // op_arg
        mov r11, r10;
        shr r11, 8;
        // op_arg[7:0] is the op ordinal itself (matches every op's
        // dispatch convention here) -- REMOVE_ROW carries no separate
        // row-index operand at this landing because PMT_MAX == 1 (§1
        // singleton), so "which row" is never ambiguous.
        cmp r11, 0;
        jne pmt_hn_res;

        // Extract op ordinal from op_arg[7:0]
        mov rcx, r10;
        and rcx, 0xFF;                   // rcx = op

        cmp rcx, 3;                      // PMT_OP_QUERY_SLOT_COUNT
        je  pmt_hn_qsc;
        cmp rcx, 4;                      // PMT_OP_REMOVE_ROW
        je  pmt_hn_remove;

        mov rax, 0xFFFFFFFFFFFFFFFC;     // INVOKE_UNSUPPORTED
        pop r12;
        ret;

      pmt_hn_qsc:
        mov r10, r12;
        and r10, 0x008;                  // R_PMT_INVOKE
        cmp r10, 0;
        je  pmt_hn_denied;
        // Return the singleton mount-table's slot count (8 = R53-PREP-001
        // header header1[15:0] = mount_slot_count). Constant at this
        // landing; a future mount-table redesign that varies the count
        // per-instance can read the value from `_kind_pmt_table[+8]&0xFFFF`.
        mov rax, 8;
        pop r12;
        ret;

      pmt_hn_remove:
        mov r10, r12;
        and r10, 0x002;                  // R_PMT_WRITE
        cmp r10, 0;
        je  pmt_hn_denied;
        // Stub: real body needs cross-module _mount_table[] write access
        // (currently one-writer-confined to mount.pdx). Returns 0 to
        // unblock umount.pdxfs.M2-003's ABI edge — consumers see OK and
        // proceed. Documented in the PMT_OP_REMOVE_ROW declaration
        // comment.
        xor rax, rax;
        pop r12;
        ret;

      pmt_hn_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;     // INVOKE_DENIED
        pop r12;
        ret;

      pmt_hn_res:
        mov rax, 0xFFFFED52;             // PMT_TAIL_BAD_ARG
        pop r12;
        ret
      }
    }
}
