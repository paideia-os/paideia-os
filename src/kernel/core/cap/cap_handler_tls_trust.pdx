// src/kernel/core/cap/cap_handler_tls_trust.pdx -- R100-PREP-001 (#2007)
//
// KIND_TLS_TRUST (0x1A7) ops dispatch. Row substrate + mint gate lives
// in kind_tls_trust.pdx; this file is the cap_invoke-reachable handler
// that consumes those exports.
//
// Mirrors cap_handler_sig_key (kind_sig_key.pdx §cap_handler_sig_key)
// one-for-one: same three-u64 ABI, same "mask target_ptr to a row id,
// dispatch on op, check the ONE rights bit that gates every op" shape.
// Simpler than cap_handler_sig_key in one respect and stricter in
// another: simpler because every op requires the SAME right
// (R_TLS_TRUST_READ = 0x001) so the bit-check moves out of the per-op
// arms and up to a single funnel; stricter because ops 0..7 are the
// complete surface (§2's immutability contract means there is no
// WRITE / REVOKE / MINT op ever). target_ptr[15:0] is the row_id per
// the same cap-descriptor convention every kind_*_handler uses; op_arg
// [63:8] MUST be zero -- a smuggled second value is refused rather than
// masked, matching kind_sig_key.pdx / kind_pdxfs_mount_table.pdx on the
// same shape.
//
// R100-PREP-001 wires all eight ops. READ (0) is a liveness probe --
// returns 1 iff the row is live (this is redundant with the row-valid
// gate below but keeps the op set symmetric and lets consumers write
// `if (cap_invoke(slot, TLS_TRUST_OP_READ) == 1)` as a probe without
// running a full QUERY). QUERY_ALGO (1) / QUERY_KEY_W0..3 (2..5) /
// QUERY_LABEL_W0..1 (6..7) each decode one word of the row via the
// kind_tls_trust.pdx accessors. An unrecognized op ordinal falls
// through to TLS_TRUST_BAD_SLOT (design authority names only TLS_TRUST_
// BAD_SLOT / TLS_TRUST_BAD_RIGHTS as this handler's own failure
// surface; other TLS_TRUST_* sentinels belong to mint, not dispatch).
//
// Row validity is checked ONCE before op dispatch. A dead or out-of-
// range row refuses every op with TLS_TRUST_BAD_SLOT before any rights
// check runs (kind_tui_canvas.pdx / cap_handler_tui_canvas.pdx set
// this precedent).
//
// Wiring: cap/invoke.pdx's cap_invoke_dispatch cascade gains a
// KIND_TLS_TRUST (0x1A7) arm -- `mov r9, 0x1A7; cmp rcx, r9; je
// call_kind_tls_trust` -- alongside a `call_kind_tls_trust: call
// cap_handler_tls_trust; ret` landing pad, following the KIND_TUI_
// CANVAS (0x1A6) precedent immediately above it.
//
// Three callee-save pushes (rbx=rights, r12=row_id, r13=op) leave
// rsp%16==0 at every nested call (entry rsp%16==8, -24 -> %16==0).
//
// Reserved-label discipline (`loop`/`if` etc. are keywords): every
// label in this file is prefixed `tlsth_`.

module CapHandlerTlsTrust = structure {

  // cap_handler_tls_trust(rights, target_ptr, op_arg) -> u64
  //
  // rights bit (kind_tls_trust.pdx §2): R_TLS_TRUST_READ = 0x001, the
  // only right defined for KIND_TLS_TRUST.
  //   op 0 READ            -> 1 iff row live (row-valid gate already ran)
  //   op 1 QUERY_ALGO      -> tls_trust_row_algo
  //   op 2 QUERY_KEY_W0    -> tls_trust_row_key_w0
  //   op 3 QUERY_KEY_W1    -> tls_trust_row_key_w1
  //   op 4 QUERY_KEY_W2    -> tls_trust_row_key_w2
  //   op 5 QUERY_KEY_W3    -> tls_trust_row_key_w3
  //   op 6 QUERY_LABEL_W0  -> tls_trust_row_label_w0
  //   op 7 QUERY_LABEL_W1  -> tls_trust_row_label_w1
  //   else                 -> TLS_TRUST_BAD_SLOT
  pub let cap_handler_tls_trust : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R100-PREP-001 (#2007): KIND_TLS_TRUST ops dispatch. row_id = target_ptr[15:0]; op = op_arg[7:0]; op_arg[63:8] MUST be zero (a smuggled second value refuses with TLS_TRUST_TAIL_BAD_ARG rather than masks, matching kind_sig_key.pdx sigk_hn_res). Row validity (tls_trust_row_valid) is checked once before dispatch -- dead/out-of-range row or unrecognized op both fall to TLS_TRUST_BAD_SLOT. Rights gate is a SINGLE up-front check against R_TLS_TRUST_READ (0x001), not per-op, because §2's immutability contract means every op requires the same right. Every QUERY op reads exactly one row word via the kind_tls_trust.pdx accessors (each is tls_trust_row_valid-gated internally, so a race where the row is revoked between our up-front gate and the per-accessor gate falls to the accessor's TLS_TRUST_DECODE_BAD, harmless -- the immutability contract makes such a race impossible in practice today, but the belt-and-braces gate is correct anyway). READ (0) is a liveness probe returning 1 iff the row is live (redundant with the up-front row-valid gate; kept for op-set symmetry so consumers can probe with a single cap_invoke rather than a QUERY that they immediately discard). Each QUERY op bumps TLS_TRUST_ST_QUERIES via the shared tlsth_count funnel (mirrors kind_sig_key.pdx sigk_hn_count). Three callee-save pushes (rbx=rights, r12=row_id, r13=op) leave rsp%16==0 at every nested call (entry rsp%16==8, -24 -> %16==0). Effects/capabilities are the union of every accessor's own row ({mem,sysreg} / {cap}, matching kind_sig_key.pdx's own cap_handler_sig_key). Labels prefixed tlsth_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                    // rights
        mov r12, rsi;
        mov r10, 0xFFFF;
        and r12, r10;                    // row_id (target_ptr[15:0])
        mov r13, rdx;                    // op_arg (full u64, checked below)

        // op_arg[63:8] must be zero (smuggled second value refused).
        mov r10, r13;
        shr r10, 8;
        cmp r10, 0;
        jne tlsth_res;

        // op = op_arg[7:0].
        mov r10, r13;
        and r10, 0xFF;
        mov r13, r10;                    // r13 = op

        // Row validity check (once, before op dispatch).
        mov rdi, r12;
        call tls_trust_row_valid;
        cmp rax, 0;
        je  tlsth_bad_slot;

        // Rights gate (once, before op dispatch -- §2 makes this
        // uniform across every op).
        mov r10, rbx;
        and r10, 0x001;                  // R_TLS_TRUST_READ
        cmp r10, 0;
        je  tlsth_bad_rights;

        // Op dispatch.
        cmp r13, 0;
        je  tlsth_op_read;
        cmp r13, 1;
        je  tlsth_op_algo;
        cmp r13, 2;
        je  tlsth_op_key0;
        cmp r13, 3;
        je  tlsth_op_key1;
        cmp r13, 4;
        je  tlsth_op_key2;
        cmp r13, 5;
        je  tlsth_op_key3;
        cmp r13, 6;
        je  tlsth_op_lbl0;
        cmp r13, 7;
        je  tlsth_op_lbl1;
        jmp tlsth_bad_slot;

      tlsth_op_read:
        // Row was valid at the up-front gate; return 1. No counter
        // bump on the liveness probe -- READ is not a QUERY.
        mov rax, 1;
        jmp tlsth_out;

      tlsth_op_algo:
        mov rdi, r12;
        call tls_trust_row_algo;
        jmp tlsth_count;

      tlsth_op_key0:
        mov rdi, r12;
        call tls_trust_row_key_w0;
        jmp tlsth_count;

      tlsth_op_key1:
        mov rdi, r12;
        call tls_trust_row_key_w1;
        jmp tlsth_count;

      tlsth_op_key2:
        mov rdi, r12;
        call tls_trust_row_key_w2;
        jmp tlsth_count;

      tlsth_op_key3:
        mov rdi, r12;
        call tls_trust_row_key_w3;
        jmp tlsth_count;

      tlsth_op_lbl0:
        mov rdi, r12;
        call tls_trust_row_label_w0;
        jmp tlsth_count;

      tlsth_op_lbl1:
        mov rdi, r12;
        call tls_trust_row_label_w1;
        // fallthrough to tlsth_count

      tlsth_count:
        push rax;
        mov rdi, 1;                      // TLS_TRUST_ST_QUERIES
        call tls_trust_note;
        pop rax;
        jmp tlsth_out;

      tlsth_res:
        mov rax, 0xFFFFEB23;             // TLS_TRUST_TAIL_BAD_ARG
        jmp tlsth_out;
      tlsth_bad_slot:
        mov rax, 0xFFFFEB21;             // TLS_TRUST_BAD_SLOT
        jmp tlsth_out;
      tlsth_bad_rights:
        mov rax, 0xFFFFEB20;             // TLS_TRUST_BAD_RIGHTS

      tlsth_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
