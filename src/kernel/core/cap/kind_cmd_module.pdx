// src/kernel/core/cap/kind_cmd_module.pdx -- UMB-W1 R123.M1 skeleton
// paideia-os #2585 (umbrella decomposition wave 1, chain-head).
//
// KIND_CMD_MODULE = 0x5C, derived over KIND_MEMORY (= slot 4 = KIND_PAGE).
//
// Kernel-side CAPABILITY SUBSTRATE for dynamically-loaded shell command
// modules. A cmd-module is a `.pds` package that, when "opened", registers
// one or more shell commands with the semantic shell per the R123 section
// of design/userspace/semantic-shell-materialization-plan.md. This file
// freezes the substrate the subsequent R123.M* landings build on:
//
//   M1 (THIS LANDING, #2585)  -- row pool, open/lookup/list/close, cap
//                                 handler. Skeleton: lookup always MISSES
//                                 (no command registry yet) and list
//                                 reports cmd_count==0. Open mints a row,
//                                 close releases it, and the cap handler
//                                 fans ops out to those three primitives.
//   M2 (#2586)                  -- registry integration (binds opened
//                                 modules to the shell dispatch cascade).
//   M3 (#2587)                  -- in-process invoke (R123.M3 light-cmd
//                                 fast path, already exercised against
//                                 the earlier #2503 CmdModule).
//   M4..M6                      -- schema narrowing, async loader, bus.
//
// DISTINCT from the earlier `src/kernel/core/cap/cmd_module.pdx` landing
// (#2503) at ordinal 0x200. The two files coexist because:
//
//   (a) they encode DIFFERENT row shapes -- #2503 packs the module's
//       NAME (3 x u64 = 24 bytes), its (version, functor, in_process,
//       cap_env_ptr, refcount) tuple, and lives at `_cmd_module_table :
//       [u64; 96]` (16 rows x 48 bytes). THIS file encodes the SHELL-
//       facing handle view (name_hash_u64, open_count, cmd_count,
//       loaded_at_ts, flags) and lives at `_kcm_table : [u64; 48]`
//       (8 rows x 48 bytes). The pre-existing 0x200 module is the
//       mint path for module-local records; this new 0x5C module is
//       the holder-facing cap gate the shell command loader presents
//       to cap_invoke. They share the DOMAIN but not the ABI.
//
//   (b) the full-u64 kind field in the cap-table descriptor
//       disambiguates. cap_invoke_dispatch's cascade `cmp rcx, 0x5C`
//       sits adjacent to `cmp rcx, 0x5B` (KIND_FW_MANIFEST) and does
//       not touch the 0x200 arm at all. A holder presenting a 0x200
//       cap reaches cap_handler at offset 0x200; a holder presenting
//       a 0x5C cap reaches cap_handler_cmd_module HERE. No ambiguity.
//
//   (c) a later landing may collapse the two by moving the row pool
//       behind one of them and treating the other as a projection, or
//       by renaming one. That is a cap/ cleanup slice, not an M1
//       landing concern.
//
// =============================================================================
// SECTION 0  DERIVATION POSTURE
// =============================================================================
//
// KIND_CMD_MODULE derives over KIND_MEMORY (= KIND_PAGE, base slot 4)
// because an open module row is a static, kernel-owned record whose only
// in-flight resource is a byte range (future: the loaded module's cap
// environment + command table). Same posture as KIND_FW_MANIFEST (0x5B)
// adjacent, KIND_SIG_KEY (0x1A3), KIND_TLS_TRUST (0x1A7), KIND_SCHEMA_
// HANDLE (0x1B2). The kind tag encodes SEMANTICS (this is a cmd-module
// handle), the LAM-hint slot encodes RUNTIME SHAPE (a memory region).
//
// =============================================================================
// SECTION 1  SLOT ASSIGNMENT  --  0x5C
// =============================================================================
//
// Numeric derived-kind tag KIND_CMD_MODULE = 0x5C (decimal 92). Wave 84
// I8 KIND_FW_MANIFEST took 0x5B immediately before this slot; 0x5C is the
// next natural adjacent slot. Audit at landing time:
//   `grep -rnE '\b0x5[Cc]\b' src/kernel/core/cap/invoke.pdx` returned 0.
//   `grep -rnE 'KIND[A-Z_]+ *: *u64 *= *0x5C' src/` returned 0.
// No existing dispatch arm overwritten. (Non-kind 0x5C occurrences --
// HDA MMIO register offsets, ACPI FADT field offsets, TPM CRB base --
// are byte displacements and MMIO offsets, not kind tags.)
//
// 0x5C fits imm32 with bit 31 clear so no r9 staging is required; the
// dispatch arm in cap/invoke.pdx is a direct `cmp rcx, 0x5C`, same cost
// as every other sub-0x80 kind in the pre-R29 block.
//
// =============================================================================
// SECTION 2  ROW LAYOUT  --  48 BYTES PER ROW, 8 ROWS
// =============================================================================
//
// Per #2585 task directive, each row is 48 bytes = 6 u64:
//
//   [+0]   name_hash_u64    (u64)   djb2-style u64 digest of the module
//                                    name supplied to cmd_module_open.
//                                    name_hash_u64 == 0 is RESERVED to
//                                    mark an EMPTY ROW; a non-empty row
//                                    always has flags & CM_FLAG_LIVE set
//                                    and vice versa. .bss zero-init
//                                    gives us the EMPTY sentinel for free.
//   [+8]   open_count       (u64)   refcount of outstanding opens of
//                                    this module. cmd_module_open bumps,
//                                    cmd_module_close decrements. When
//                                    open_count drops to 0 the row's
//                                    flags clear and the slot becomes
//                                    free again. (R123.M1 skeleton does
//                                    not DEDUP across concurrent opens
//                                    of the same name beyond the single-
//                                    row AlreadyLoaded gate; a later M*
//                                    may reinstate the open on a dup to
//                                    bump open_count.)
//   [+16]  cmd_count        (u64)   number of shell commands this
//                                    module exposes. At R123.M1 skeleton
//                                    this is always 0 on mint and never
//                                    changes (no cmd registry wired
//                                    yet); R123.M2 populates it as the
//                                    registry binds commands.
//   [+24]  loaded_at_ts     (u64)   boot-tick / scheduler counter at
//                                    open (0 at Wave UMB-W1 pending the
//                                    scheduler-counter wiring that lands
//                                    alongside the TPM PCR 7 extend in
//                                    paideia-os #2566). Future witnesses
//                                    diff this against the current tick
//                                    to detect stale modules.
//   [+32]  flags            (u64)   bit 0 (CM_FLAG_LIVE = 0x1) = row is
//                                    valid; zero flags marks EMPTY. Bits
//                                    1..63 reserved. Publish-last
//                                    discipline matches every row-pool
//                                    kind in the cap/ tree one-for-one:
//                                    write flags LAST so a torn reader
//                                    sees either a fully-populated row
//                                    or a zero sentinel, never a
//                                    half-written state.
//   [+40]  reserved         (u64)   reserved for a future per-module
//                                    cap_env_ptr once the cap-env
//                                    substrate (#2588, R125.M1) lands.
//                                    Zero on mint, never read at M1.
//
// Row size: 48 bytes = 6 u64. Row-addressed capacity: CM_MODULE_MAX = 8
// rows at this landing. 8 x 48 = 384 bytes = 48 u64. Grows by increasing
// CM_MODULE_MAX (the arithmetic is a single `imul rax, r11` with r11
// seeded to 48 via `mov r11, 48` per the paideia-as encoder discipline;
// no 2-op imul-with-imm form in the encoder).
//
// name_hash_u64 == 0 AND flags == 0 both encode EMPTY. Scans check flags.
// A real-boot .bss zero-init guarantees every row starts EMPTY; the
// defensive reset below covers the chaos-restart / witness-replay path.
//
// =============================================================================
// SECTION 3  NAME HASH  --  djb2-STYLE 64-BIT
// =============================================================================
//
// cmd_module_open receives (name_ptr, name_len). We byte-walk the buffer
// and fold each byte into a 64-bit accumulator via the djb2 recurrence:
//
//     hash := 5381                 (0x1505; starting basis)
//     for byte in name_bytes:
//         hash := (hash << 5) + hash + byte           // hash * 33 + byte
//
// Properties relevant to the substrate:
//   * Determinism -- same bytes always produce the same u64. The
//     cmd_module_lookup dedup path can therefore compare the hash
//     column directly instead of re-byte-walking an interned name.
//   * No cryptographic claim. A collision in u64 space is possible
//     with ~2^32 names; we treat a collision as ALREADY_LOADED and
//     the holder re-tries with a longer name. For a shell command
//     module namespace this ceiling is wildly generous.
//   * Zero-length names map to 5381. cmd_module_open rejects
//     name_len == 0 earlier so this never reaches the row.
//
// Encoder posture: paideia-as supports `mov_b r10, [rbx + rcx*1]` for a
// byte load with explicit *1 SIB (per cmd_module.pdx:584 §13 comment on
// superblock.pdx §271 encoder-friction note). Caller zeroes r10 BEFORE
// each mov_b per the "encoder does not zero-extend on its own" discipline
// from pipe_backend.pdx §57.
//
// =============================================================================
// SECTION 4  RIGHTS  --  R_CM_READ (0x001) + R_CM_INVOKE (0x002) + R_CM_WRITE (0x004)
// =============================================================================
//
//   R_CM_READ    (0x001)  gate the handler's LIST + LOOKUP ops.
//   R_CM_INVOKE  (0x002)  gate the handler's CLOSE op.
//   R_CM_WRITE   (0x004)  gate the handler's RELOAD op (R123.M6 UMB-W8,
//                          paideia-os #2590). Mutates ALL rows (table
//                          flush + re-parse of /system/shell/commands.
//                          toml), so a dedicated bit distinct from
//                          R_CM_INVOKE's per-row CLOSE gate.
//
// No MINT, no REVOKE, no FORWARD. open/close are supervisor-level
// entrypoints that operate on module-level state directly (the shell
// command-loader calls them, not a ring-3 holder). A ring-3 holder
// presenting a KIND_CMD_MODULE cap through cap_invoke can:
//   * LOOKUP a command by name within a module
//   * LIST commands exposed by a module
//   * CLOSE their own open handle (releases the row refcount)
//   * RELOAD the whole table (requires R_CM_WRITE; shell admin only)
// but cannot mint new modules.
//
// R_CM_ALL = R_CM_READ | R_CM_INVOKE | R_CM_WRITE = 0x007.
//
// =============================================================================
// SECTION 5  FAILURE TAXONOMY  --  0xFFFFFCC1..0xFFFFFCC5
// =============================================================================
//
// Per #2585 task directive this module reserves five codes:
//
//   CM_BAD_NAME         = 0xFFFFFCC1  (name_ptr == 0 OR name_len == 0 OR
//                                       name_len > CM_NAME_MAX = 64)
//   CM_MODULE_FULL      = 0xFFFFFCC2  (no empty row AND no live-row match
//                                       for the hash -- the holder is
//                                       trying to open a new module and
//                                       the row pool is exhausted)
//   CM_UNKNOWN_HANDLE   = 0xFFFFFCC3  (lookup/list/close handle out of
//                                       range OR the row's LIVE bit
//                                       is clear)
//   CM_CMD_NOT_FOUND    = 0xFFFFFCC4  (lookup found the module but the
//                                       named command does not exist
//                                       inside it -- the only outcome
//                                       the R123.M1 skeleton returns
//                                       from lookup; M2 populates
//                                       real cmd rows and lookup
//                                       starts hitting)
//   CM_ALREADY_LOADED   = 0xFFFFFCC5  (open found a live row with the
//                                       SAME name_hash. R123.M1 skeleton
//                                       REFUSES the second open; a
//                                       future M* may bump open_count
//                                       instead.)
//
// Audit at landing time:
//   `grep -rhoE '0xFFFFFCC[0-9A-Fa-f]' src/ | sort -u` showed FCC0 then
//   a gap from FCC1..FCC9 (0 occurrences each) then FCCA..FCCF reused by
//   HDA codec q + USB hub drv + HDA ALC287 init. The band FCC1..FCC5 is
//   unclaimed and the five codes are contiguous.
//
// All five fit imm32 with bit 31 set (zero-extend to u64 via the `mov
// rax, imm32` 7-byte emit, same posture as the FWM_* band above). Caller
// surfacing compares against the full u64 CM_* constant below.
//
// =============================================================================
// SECTION 6  paideia-as encoder-gap posture
// =============================================================================
//
// Kind-tag constant 0x5C fits imm32, so every compare against it uses
// `cmp rcx, 0x5C` directly (no r9/r11 staging). Error sentinels
// 0xFFFFFCC1..C5 fit imm32 (zero-extend to u64 via the `mov rax, imm32`
// 7-byte emit). The row-stride multiply uses `mov r11, 48; imul rax, r11`
// reg-reg (paideia-as encoder has no 2-op `imul r, imm` form). Liveness
// tests use `cmp rN, 0` (never `test rN, rN` 2-op). Masked compares
// stage through r10/r11 reg-reg (never `and r11, imm64`). All `pub let`
// string declarations are single-line. Module basename `KindCmdModule`
// matches the file basename `kind_cmd_module.pdx`. Every label in this
// file is prefixed `kcm_` (reserved-word discipline -- `loop`/`if`/
// `let` are keywords; `kcm_` keeps us well clear).
//
// klog_s1_x2 convention per the Wave 73 I7 regression memory: the 7th
// stack argument (v2) lives at the caller's `[rsp+0]` AFTER `sub rsp,
// 16` (which becomes `[rbp+16]` inside the wrapper's `push rbp`
// prologue). This file follows that convention one-for-one in the
// cmd_module_open fingerprint emit.
//
// klog_s1_x1_d1 convention: hex arg first in registers (kx/vx in rcx/
// r8), decimal second with kd in r9 and vd stacked at caller `[rsp+0]`
// after `sub rsp, 16`. The emitted line reads two key-value pairs in
// the order of the enabled wrappers.
//
// Fingerprint tag `[u8; N]` string literals have N = string length + 1
// (the trailing NUL counts). Each tag's N is spelled next to the literal
// for audit.

module KindCmdModule = structure {

  pub let KIND_CMD_MODULE      : u64 = 0x5C
  pub let KIND_CMD_MODULE_BASE : u64 = 4         // = KIND_MEMORY (LAM-hint)

  // Rights (§4).
  pub let R_CM_READ   : u64 = 0x001
  pub let R_CM_INVOKE : u64 = 0x002
  pub let R_CM_WRITE  : u64 = 0x004
  pub let R_CM_ALL    : u64 = 0x007

  // Ops (cap_handler_cmd_module dispatch).
  pub let CM_OP_LOOKUP     : u64 = 0  // op_arg bits [55:24] = handle;
                                       //   additional ptr/len args
                                       //   not plumbed through
                                       //   cap_invoke at M1 (M2 wires)
  pub let CM_OP_LIST       : u64 = 1  // op_arg bits [55:24] = handle
                                       //   -> cmd_count (0 at M1)
  pub let CM_OP_CLOSE      : u64 = 2  // op_arg bits [55:24] = handle
                                       //   -> OK | CM_UNKNOWN_HANDLE
  // R123.M5 discovery iterator ops (#2589). CM_OP_LIST_FIRST takes no
  // argument. CM_OP_LIST_NEXT and CM_OP_READ_NAME take row_id in
  // op_arg bits [39:8] (same slot as `handle` for the earlier ops --
  // discovery row_ids ARE module handles). CM_OP_READ_NAME's out_ptr
  // is NOT plumbed through cap_invoke at this landing (same posture
  // as cmd_module_lookup not plumbing cmd_name_ptr at M1); the handler
  // reports the byte length so holders can size a buffer. In-kernel
  // consumers call kcm_read_name directly with a real out_ptr.
  pub let CM_OP_LIST_FIRST : u64 = 3  // (no arg)        -> row_id | CM_LIST_END
  pub let CM_OP_LIST_NEXT  : u64 = 4  // row_id          -> row_id | CM_LIST_END | CM_BAD_ROW
  pub let CM_OP_READ_NAME  : u64 = 5  // row_id, out_ptr -> byte_len | CM_BAD_ROW
  // R123.M6 UMB-W8 hot-reload op (paideia-os #2590). Takes no argument
  // slot; dispatches to _cmd_registry_reload from cmd_registry_parser.pdx
  // §13 which (a) acquires an atomic xchg in-flight guard, (b) flushes
  // the KIND_CMD_MODULE row pool via kcm_table_reset, (c) re-parses
  // /system/shell/commands.toml via _cmd_registry_load_boot, (d) emits
  // the CMDREG RELOADED fingerprint, (e) releases the in-flight guard.
  // Gates R_CM_WRITE (not R_CM_INVOKE) because the mutation is table-
  // wide, not per-row.
  pub let CM_OP_RELOAD     : u64 = 6  // (no arg)        -> errno (CRP_OK | CRP_ERR_*)
  pub let CM_OP_MAX        : u64 = 6

  // Failure codes (§5). The first five (CM_BAD_NAME..CM_ALREADY_LOADED)
  // predate R123.M5; CM_LIST_END and CM_BAD_ROW extend the band by two
  // for the discovery iterator per #2589. All seven fit imm32
  // (zero-extend to u64 via `mov rax, imm32`); they occupy a clean
  // 7-wide band 0xFFFFFCC1..0xFFFFFCC7.
  pub let CM_OK              : u64 = 0
  pub let CM_BAD_NAME        : u64 = 0xFFFFFCC1
  pub let CM_MODULE_FULL     : u64 = 0xFFFFFCC2
  pub let CM_UNKNOWN_HANDLE  : u64 = 0xFFFFFCC3
  pub let CM_CMD_NOT_FOUND   : u64 = 0xFFFFFCC4
  pub let CM_ALREADY_LOADED  : u64 = 0xFFFFFCC5
  pub let CM_LIST_END        : u64 = 0xFFFFFCC6   // iterator exhausted
  pub let CM_BAD_ROW         : u64 = 0xFFFFFCC7   // row_id out of range

  pub let CM_ROW_NONE : u64 = 0xFF

  // Standard cap_invoke sentinels (shared across every kind).
  pub let INVOKE_UNSUPPORTED : u64 = 0xFFFFFFFFFFFFFFFC
  pub let INVOKE_DENIED      : u64 = 0xFFFFFFFFFFFFFFFD

  // Row + name ceilings.
  pub let CM_MODULE_MAX : u64 = 8     // row count at Wave UMB-W1
  pub let CM_ROW_BYTES  : u64 = 48    // 6 u64
  pub let CM_NAME_MAX   : u64 = 64    // max module name length in bytes
  pub let CM_FLAG_LIVE    : u64 = 0x1   // bit 0 of flags word (§2) -- row live
  // UMB-W6 R123.M4 (#2588): bit 1 (CM_FLAG_ISOLATE = 0x2) is claimed by
  // the OOP functor-invoke path for "spawn a fresh task instead of calling
  // in-process". DEFINED one-for-one in functor_invoke_oop.pdx (FIO_FLAG_
  // ISOLATE) and mirrored in cmd_jail_wire.pdx (CJW_FLAG_ISOLATE). We do
  // NOT redefine it here to avoid a two-site-of-truth hazard; the comment
  // records the bit so a future adjacent claim does not collide.
  //
  // UMB-W21 R135.M7 (paideia-os #2632): bit 2 (CM_FLAG_WASI = 0x4) marks
  // a cmd row whose functor is a WASI binary and must be dispatched
  // through the R135 jail substrate (jail_supervisor + wasi_args +
  // fd_mediation + stdout_records). The dispatch shim cmd_jail_wire.pdx
  // reads this bit alongside CM_FLAG_ISOLATE (0x2) to choose:
  //
  //    (CM_FLAG_ISOLATE=0, CM_FLAG_WASI=0) -> in-process via
  //                                           _functor_invoke_call
  //    (CM_FLAG_ISOLATE=1, CM_FLAG_WASI=0) -> OOP spawn via
  //                                           _functor_invoke_oop_spawn
  //                                           (no jail/WASI wiring)
  //    (CM_FLAG_ISOLATE=1, CM_FLAG_WASI=1) -> OOP spawn + jail_
  //                                           supervisor_create +
  //                                           wasi_args_register
  //    (CM_FLAG_ISOLATE=0, CM_FLAG_WASI=1) -> REJECTED by cjw_dispatch
  //                                           (CJW_ERR_BAD_ROW) -- a WASI
  //                                           binary MUST run isolated.
  //
  // The parser-side wiring that reads `wasi = true` from
  // /system/shell/commands.toml and sets both bits is deferred to the
  // cmd_registry_parser follow-up (R123.M2 extension); for M7 the bit
  // is set via `_cmd_jail_wire_mark_wasi(row_id)` from a kernel-trusted
  // caller, exactly mirroring the ISOLATE-bit setter precedent in
  // functor_invoke_oop.pdx (_functor_invoke_oop_set_isolate).
  pub let CM_FLAG_ISOLATE : u64 = 0x2   // bit 1 -- OOP spawn (W6 R123.M4)
  pub let CM_FLAG_WASI    : u64 = 0x4   // bit 2 -- WASI jail (W21 R135.M7)

  // djb2 starting basis (§3).
  pub let CM_HASH_BASIS : u64 = 5381

  // 8 rows * 48 bytes = 384 bytes = 48 u64. .bss zero-init means every
  // row starts with flags == 0 (the EMPTY sentinel, §2), which is the
  // free-slot marker scan paths look for and the reset below respects.
  pub let mut _kcm_table : [u64; 48] = uninit @align(64)

  // R123.M5 (#2589) name store. CM_OP_READ_NAME needs the actual name
  // bytes, not just the hash column of the row. We allocate a parallel
  // 8-slot buffer of CM_NAME_MAX (64) bytes each = 512 bytes = 64 u64,
  // and a parallel length array (one u64 per slot). cmd_module_open
  // populates both when it mints a row; cmd_module_close does not need
  // to scrub them because the empty-row scan honors flags==0 and the
  // next open overwrites the slot before publishing LIVE.
  //
  // The slot layout is unaligned-byte (u8) so a short name copies byte
  // for byte via mov_b; the backing storage is declared as a u8 array
  // and never read as u64.
  pub let mut _kcm_names     : [u8;  512] = uninit @align(64)
  pub let mut _kcm_name_lens : [u64; 8]   = uninit @align(64)

  // Observability counters: open_ok / open_full / open_bad_name /
  // open_dup / lookup_hit / lookup_miss / close_ok / close_unk.
  pub let mut _kcm_stats : [u64; 8] = uninit @align(64)

  pub let CM_ST_OPEN_OK       : u64 = 0
  pub let CM_ST_OPEN_FULL     : u64 = 1
  pub let CM_ST_OPEN_BAD_NAME : u64 = 2
  pub let CM_ST_OPEN_DUP      : u64 = 3
  pub let CM_ST_LOOKUP_HIT    : u64 = 4
  pub let CM_ST_LOOKUP_MISS   : u64 = 5
  pub let CM_ST_CLOSE_OK      : u64 = 6
  pub let CM_ST_CLOSE_UNK     : u64 = 7

  // Fingerprint tags + keys. One tag per emitted event; §Section 5 of
  // the #2585 task directive names three wire shapes:
  //
  //   `CMD_MODULE OPEN name_hash=0x<16-hex> handle=0x<16-hex>`     -- open
  //   `CMD_MODULE LOOKUP cmd_name=<dec> result=0x<16-hex>`         -- lookup
  //   `CMD_MODULE CLOSE handle=0x<16-hex>`                         -- close
  //
  // Byte counts NUL-inclusive per the kernel-logging-substrate.md
  // #699 discipline.
  pub let kcm_tag_open          : [u8; 16] = "CMD_MODULE OPEN\0"
  pub let kcm_tag_lookup        : [u8; 18] = "CMD_MODULE LOOKUP\0"
  pub let kcm_tag_close         : [u8; 17] = "CMD_MODULE CLOSE\0"
  pub let kcm_tag_handler_entry : [u8; 29] = "KIND_CMD_MODULE dispatch inv\0"

  pub let kcm_k_name_hash : [u8; 10] = "name_hash\0"
  pub let kcm_k_handle    : [u8; 7]  = "handle\0"
  pub let kcm_k_cmd_name  : [u8; 9]  = "cmd_name\0"
  pub let kcm_k_result    : [u8; 7]  = "result\0"

  // ==========================================================================
  // kcm_table_reset() -> ()
  //
  // Defensive clear. Zero the row table (48 u64) and the stats array
  // (8 u64). .bss is already zero at real boot; this call is belt-and-
  // braces per the KIND_FW_MANIFEST / KIND_FIRMWARE_BLOB precedent and
  // gives a future witness or chaos-restart flow a clean re-scrub point.
  // ==========================================================================
  pub let kcm_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "UMB-W1 R123.M1 (#2585) + R123.M5 (#2589): clear every _kcm_table u64 (48 words), every _kcm_stats u64 (8 words), every _kcm_names u64 (64 words = 512 bytes), every _kcm_name_lens u64 (8 words). Boot + teardown only. .bss already zero at real boot; this is defensive (matches fw_manifest_table_reset / firmware_blob_table_reset one-for-one). Labels prefixed kcm_tr_.",
      block: {
        lea r10, [rip + _kcm_table];
        xor rax, rax;
        xor rcx, rcx;
      kcm_tr_table:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 48;
        jb  kcm_tr_table;

        lea r10, [rip + _kcm_stats];
        xor rcx, rcx;
      kcm_tr_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  kcm_tr_stats;

        // R123.M5 (#2589): clear name store (512 bytes = 64 u64).
        lea r10, [rip + _kcm_names];
        xor rcx, rcx;
      kcm_tr_names:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 64;
        jb  kcm_tr_names;

        // R123.M5 (#2589): clear name-length array (8 u64).
        lea r10, [rip + _kcm_name_lens];
        xor rcx, rcx;
      kcm_tr_name_lens:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  kcm_tr_name_lens;
        ret
      }
    }

  // ==========================================================================
  // kcm_row_base(row_id) -> &_kcm_table[row_id*48]
  //
  // Row index -> row base pointer. Stride 48 via `mov r11, 48; imul rax,
  // r11` reg-reg (the paideia-as encoder has no 2-op `imul r, imm` form;
  // the reg-reg 3-byte imul is the canonical path, same as every other
  // row-base helper in the cap/ tree whose stride is not a sum of two
  // power-of-two shifts). No bounds check by policy: every caller
  // validates first.
  // ==========================================================================
  pub let kcm_row_base : (u64) -> u64 !{} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "UMB-W1 R123.M1 (#2585): row_id -> &_kcm_table[row_id*48]. Stride 48 as `mov r11, 48; imul rax, r11` reg-reg per encoder discipline. Pure leaf. Labels prefixed kcm_rb_.",
      block: {
        mov rax, rdi;
        mov r11, 48;
        imul rax, r11;
        lea r10, [rip + _kcm_table];
        add rax, r10;
        ret
      }
    }

  // ==========================================================================
  // kcm_row_live(row_id) -> 1 iff row_id < CM_MODULE_MAX AND
  //                               (flags & CM_FLAG_LIVE) != 0
  //
  // flags == 0 marks EMPTY (§2); an in-range row_id whose flags lack the
  // LIVE bit is NOT live.
  // ==========================================================================
  pub let kcm_row_live : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "UMB-W1 R123.M1 (#2585): 1 iff row_id < CM_MODULE_MAX(8) and flags (word 5 at [+32]) & CM_FLAG_LIVE != 0. Pure leaf. Labels prefixed kcm_rl_.",
      block: {
        mov r10, 8;                      // CM_MODULE_MAX
        cmp rdi, r10;
        jae kcm_rl_no;
        mov rax, rdi;
        mov r11, 48;
        imul rax, r11;
        lea r10, [rip + _kcm_table];
        add rax, r10;
        mov r10, [rax + 32];             // flags
        mov r11, 1;                      // CM_FLAG_LIVE
        and r10, r11;
        cmp r10, 0;
        je  kcm_rl_no;
        mov rax, 1;
        ret;
      kcm_rl_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // kcm_name_hash(name_ptr, name_len) -> u64
  //
  // djb2 variant (§3): hash := 5381; for each byte: hash := hash*33 + b.
  // Zero-length names return 5381; the caller gates for len>0 anyway.
  // Pure leaf, 1 push (rbx) to park name_ptr across the loop.
  // ==========================================================================
  pub let kcm_name_hash : (u64, u64) -> u64 !{mem} @{} =
    fn (name_ptr: u64) (name_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "UMB-W1 R123.M1 (#2585): djb2 u64 digest of name bytes. hash := 5381; per byte, hash := (hash<<5)+hash+byte -> hash*33+byte. Encoder: `mov_b r10, [rbx + rcx*1]` with pre-zero of r10 (encoder does not zero-extend on its own, per pipe_backend §57). One callee-save push (rbx = name_ptr) parks across the loop. Labels prefixed kcm_nh_.",
      block: {
        push rbx;

        mov rbx, rdi;                    // name_ptr
        mov rax, 5381;                   // CM_HASH_BASIS
        xor rcx, rcx;                    // i

      kcm_nh_loop:
        cmp rcx, rsi;                    // i < name_len?
        jae kcm_nh_done;

        // hash *= 33  via (hash << 5) + hash.
        mov r11, rax;
        shl rax, 5;
        add rax, r11;

        // + byte
        xor r10, r10;                    // pre-zero before mov_b
        mov_b r10, [rbx + rcx * 1];
        add rax, r10;

        add rcx, 1;
        jmp kcm_nh_loop;

      kcm_nh_done:
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // kcm_find_hash(name_hash) -> row_id | CM_ROW_NONE
  //
  // Linear scan for the first LIVE row whose name_hash column matches.
  // Returns CM_ROW_NONE (0xFF) on miss. One callee-save push (r13 =
  // row cursor); +8 keeps rsp%16==0 at nested kcm_row_base calls.
  // ==========================================================================
  pub let kcm_find_hash : (u64) -> u64 !{mem} @{} =
    fn (name_hash: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "UMB-W1 R123.M1 (#2585): scan _kcm_table[0..CM_MODULE_MAX) for first live row whose name_hash column (word 0 at [+0]) matches. Miss returns CM_ROW_NONE (0xFF). Two callee-save pushes (rbx+r13) + sub rsp,8 land rsp%16==0 at nested kcm_row_base calls (entry rsp%16==8; +16+8=24 -> 24%16==8 -- WAIT; let me recompute: entry rsp%16==8, +2*8=16 -> 24, 24%16==8, +8 sub -> 32, 32%16==0. Good.). Labels prefixed kcm_fh_.",
      block: {
        push rbx;
        push r13;
        sub rsp, 8;

        mov rbx, rdi;                    // name_hash
        xor r13, r13;                    // row cursor

      kcm_fh_scan:
        cmp r13, 8;                      // CM_MODULE_MAX
        jae kcm_fh_none;

        mov rdi, r13;
        call kcm_row_base;
        // rax = row base. Check LIVE flag first.
        mov r10, [rax + 32];             // flags
        mov r11, 1;
        and r10, r11;
        cmp r10, 0;
        je  kcm_fh_next;                 // dead/empty row

        mov r10, [rax + 0];              // name_hash column
        cmp r10, rbx;
        je  kcm_fh_hit;

      kcm_fh_next:
        add r13, 1;
        jmp kcm_fh_scan;

      kcm_fh_hit:
        mov rax, r13;
        jmp kcm_fh_out;

      kcm_fh_none:
        mov rax, 0xFF;                   // CM_ROW_NONE

      kcm_fh_out:
        add rsp, 8;
        pop r13;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // kcm_find_empty() -> row_id | CM_ROW_NONE
  //
  // Linear scan for the first row whose flags word is zero (EMPTY
  // sentinel). Returns CM_ROW_NONE if the pool is full. Two pushes +
  // sub rsp,8 land rsp%16==0 at the nested kcm_row_base call.
  // ==========================================================================
  pub let kcm_find_empty : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "UMB-W1 R123.M1 (#2585): scan _kcm_table[0..CM_MODULE_MAX) for first row whose flags word (word 5 at [+32]) is zero (EMPTY sentinel). Full returns CM_ROW_NONE (0xFF). Two callee-save pushes (rbx+r13) + sub rsp,8 land rsp%16==0 at nested kcm_row_base calls. Labels prefixed kcm_fe_.",
      block: {
        push rbx;
        push r13;
        sub rsp, 8;

        xor r13, r13;                    // row cursor
      kcm_fe_scan:
        cmp r13, 8;
        jae kcm_fe_none;

        mov rdi, r13;
        call kcm_row_base;
        mov rbx, rax;                    // row base
        mov r10, [rbx + 32];             // flags
        cmp r10, 0;
        je  kcm_fe_hit;

        add r13, 1;
        jmp kcm_fe_scan;

      kcm_fe_hit:
        mov rax, r13;
        jmp kcm_fe_out;

      kcm_fe_none:
        mov rax, 0xFF;                   // CM_ROW_NONE

      kcm_fe_out:
        add rsp, 8;
        pop r13;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // kcm_note(stats_slot) -> ()
  //
  // Bump _kcm_stats[slot]. Caller passes slot ordinal (CM_ST_*).
  // ==========================================================================
  pub let kcm_note : (u64) -> () !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "UMB-W1 R123.M1 (#2585): bump _kcm_stats[slot] by 1. Slot ordinals in {0..7} per CM_ST_* enumeration. Pure leaf, no bounds check (caller passes constants only). Labels prefixed kcm_nt_.",
      block: {
        lea r10, [rip + _kcm_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
        ret
      }
    }

  // ==========================================================================
  // kcm_name_slot_base(row_id) -> &_kcm_names[row_id*64]
  //
  // R123.M5 (#2589): row_id -> name slot pointer. Stride 64 via `shl rax,6`
  // (power-of-two, so no imul reg-reg dance -- same posture as the TMPFS
  // symlink pool and other 64-byte-slotted structures). Pure leaf, no
  // bounds check (every caller validates row_id first).
  // ==========================================================================
  pub let kcm_name_slot_base : (u64) -> u64 !{} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R123.M5 (#2589): row_id -> &_kcm_names[row_id*64]. Stride 64 as `shl rax, 6` (power-of-two). Pure leaf. Labels prefixed kcm_nsb_.",
      block: {
        mov rax, rdi;
        shl rax, 6;
        lea r10, [rip + _kcm_names];
        add rax, r10;
        ret
      }
    }

  // ==========================================================================
  // kcm_name_store(row_id, name_ptr, name_len) -> ()
  //
  // R123.M5 (#2589) helper: copy name_len bytes from name_ptr into the
  // row's name slot, then record name_len in _kcm_name_lens[row_id].
  // Caller has already validated: row_id < CM_MODULE_MAX AND
  // name_ptr != 0 AND 0 < name_len <= CM_NAME_MAX. Pure byte copy via
  // mov_b r,[rbx+rcx*1] / mov_b [r12+rcx*1],r pair (vnode_pool.pdx:323
  // precedent).
  //
  // Register plan: three callee-save pushes (rbx=name_ptr, r12=slot_base,
  // r13=name_len) land rsp%16==0 at the nested kcm_name_slot_base call
  // (entry rsp%16==8; +3*8=24 -> 32%16==0).
  // ==========================================================================
  pub let kcm_name_store : (u64, u64, u64) -> () !{mem} @{} =
    fn (row_id: u64) (name_ptr: u64) (name_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R123.M5 (#2589): copy name_len bytes from name_ptr into _kcm_names[row_id*64 .. +name_len] and set _kcm_name_lens[row_id] := name_len. Caller validates row_id < CM_MODULE_MAX, name_ptr != 0, 0 < name_len <= CM_NAME_MAX=64. Register plan parks row_id in r12 across the nested kcm_name_slot_base call (callee-saved, so survives whatever the leaf writes); after the call rax=slot_base takes over r12 since row_id is no longer needed. Byte-copy via `mov_b r10,[rbx+rcx*1]; mov_b [r12+rcx*1],r10` per vnode_pool.pdx:323 precedent (r10 pre-zeroed before mov_b load, encoder does not zero-extend on its own). Three callee-save pushes (rbx=name_ptr, r12=row_id-then-slot_base, r13=name_len) land rsp%16==0 at nested kcm_name_slot_base call (entry rsp%16==8; +3*8=24 -> 32%16==0). Labels prefixed kcm_ns_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rsi;                    // name_ptr    (survives via rbx)
        mov r12, rdi;                    // row_id      (survives via r12)
        mov r13, rdx;                    // name_len    (survives via r13)

        // Record length. Use r12 (row_id) as the index.
        lea r10, [rip + _kcm_name_lens];
        mov [r10 + r12 * 8], r13;

        // Resolve slot base. kcm_name_slot_base takes row_id in rdi.
        mov rdi, r12;
        call kcm_name_slot_base;
        mov r12, rax;                    // r12 := slot_base (row_id done)

        // Byte-copy loop.
        xor rcx, rcx;                    // i
      kcm_ns_copy:
        cmp rcx, r13;
        jae kcm_ns_done;
        xor r10, r10;                    // pre-zero before mov_b
        mov_b r10, [rbx + rcx * 1];
        mov_b [r12 + rcx * 1], r10;
        add rcx, 1;
        jmp kcm_ns_copy;

      kcm_ns_done:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // kcm_list_first() -> row_id | CM_LIST_END
  //
  // R123.M5 (#2589) discovery primitive. Scan rows [0, CM_MODULE_MAX);
  // return the first LIVE row_id or CM_LIST_END (0xFFFFFCC6) if the
  // module table is empty. Pairs with kcm_list_next for iteration;
  // consumers (shell `help`, tab-completion) start with FIRST and step
  // via NEXT until they see CM_LIST_END.
  //
  // Register plan: two callee-save pushes (rbx + r13 for row cursor)
  // + sub rsp,8 for alignment at the nested kcm_row_live call (entry
  // rsp%16==8; +16+8=32, 32%16==0).
  // ==========================================================================
  pub let kcm_list_first : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R123.M5 (#2589): scan _kcm_table[0..CM_MODULE_MAX=8) for the first LIVE row_id; return CM_LIST_END (0xFFFFFCC6) if the table is empty. Two callee-save pushes (rbx+r13=cursor) + sub rsp,8 land rsp%16==0 at nested kcm_row_live calls (entry rsp%16==8; +2*8+8=24, 24%16==8 -- recompute: 8+16+8=32, 32%16==0). Labels prefixed kcm_lf_.",
      block: {
        push rbx;
        push r13;
        sub rsp, 8;

        xor r13, r13;                    // row cursor
      kcm_lf_scan:
        cmp r13, 8;                      // CM_MODULE_MAX
        jae kcm_lf_end;

        mov rdi, r13;
        call kcm_row_live;
        cmp rax, 0;
        jne kcm_lf_hit;

        add r13, 1;
        jmp kcm_lf_scan;

      kcm_lf_hit:
        mov rax, r13;
        jmp kcm_lf_out;

      kcm_lf_end:
        mov rax, 0xFFFFFCC6;             // CM_LIST_END

      kcm_lf_out:
        add rsp, 8;
        pop r13;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // kcm_list_next(row_id) -> next_row_id | CM_LIST_END | CM_BAD_ROW
  //
  // R123.M5 (#2589) discovery primitive. Given the row_id a previous
  // FIRST or NEXT returned, scan forward for the next LIVE row_id.
  // Returns CM_LIST_END when the iterator is exhausted and CM_BAD_ROW
  // when the caller supplied a row_id outside [0, CM_MODULE_MAX).
  //
  // NB: a torn iteration -- the row the caller last saw having been
  // closed between NEXT calls -- does NOT return CM_BAD_ROW. The scan
  // starts at `row_id + 1`, so a stale row_id in [0, CM_MODULE_MAX)
  // simply resumes at that offset even if the previously-live row has
  // since vanished. CM_BAD_ROW is reserved for a caller passing an
  // out-of-range row_id (e.g. 0xFFFFFCC6 from a prior CM_LIST_END).
  //
  // Register plan: two callee-save pushes (rbx = starting row_id,
  // r13 = cursor) + sub rsp,8 for alignment.
  // ==========================================================================
  pub let kcm_list_next : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R123.M5 (#2589): given row_id in [0,CM_MODULE_MAX), scan [row_id+1, CM_MODULE_MAX) for the next LIVE row_id. Out-of-range row_id -> CM_BAD_ROW (0xFFFFFCC7). No live row remaining -> CM_LIST_END (0xFFFFFCC6). Two callee-save pushes (rbx=start, r13=cursor) + sub rsp,8 land rsp%16==0 at nested kcm_row_live. Labels prefixed kcm_ln_.",
      block: {
        push rbx;
        push r13;
        sub rsp, 8;

        mov rbx, rdi;                    // starting row_id

        // Validate: row_id < CM_MODULE_MAX. Out of range -> CM_BAD_ROW.
        mov r10, 8;                      // CM_MODULE_MAX
        cmp rbx, r10;
        jae kcm_ln_bad;

        // Begin scan at row_id + 1.
        mov r13, rbx;
        add r13, 1;

      kcm_ln_scan:
        cmp r13, 8;
        jae kcm_ln_end;

        mov rdi, r13;
        call kcm_row_live;
        cmp rax, 0;
        jne kcm_ln_hit;

        add r13, 1;
        jmp kcm_ln_scan;

      kcm_ln_hit:
        mov rax, r13;
        jmp kcm_ln_out;

      kcm_ln_end:
        mov rax, 0xFFFFFCC6;             // CM_LIST_END
        jmp kcm_ln_out;

      kcm_ln_bad:
        mov rax, 0xFFFFFCC7;             // CM_BAD_ROW

      kcm_ln_out:
        add rsp, 8;
        pop r13;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // kcm_read_name(row_id, out_ptr) -> byte_len | CM_BAD_ROW
  //
  // R123.M5 (#2589) discovery primitive. Given a row_id and an output
  // buffer, write up to CM_NAME_MAX name bytes to out_ptr and return
  // the actual byte length (<= CM_NAME_MAX). Row must be LIVE; a dead
  // or out-of-range row_id yields CM_BAD_ROW (0xFFFFFCC7).
  //
  // Byte semantics:
  //   * The name was captured verbatim at cmd_module_open; no NUL is
  //     appended. Callers that want a C string should pass a buffer of
  //     at least CM_NAME_MAX + 1 and append NUL at offset = returned
  //     length.
  //   * If out_ptr == 0, the function returns the byte length WITHOUT
  //     copying -- useful for buffer sizing. CM_BAD_ROW on dead row.
  //
  // Register plan: three callee-save pushes (rbx = row_id, r12 =
  // out_ptr, r13 = name_len) alone land rsp%16==0 at nested
  // kcm_row_live / kcm_name_slot_base calls (entry rsp%16==8;
  // +3*8=24 -> 32%16==0). No sub rsp pad is needed; cmd_module_lookup
  // (M1) follows the same 3-push-no-pad discipline.
  // ==========================================================================
  pub let kcm_read_name : (u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64) (out_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R123.M5 (#2589): if row_id in [0,CM_MODULE_MAX) AND row LIVE, read name_len from _kcm_name_lens[row_id]; if out_ptr != 0, copy name_len bytes from _kcm_names[row_id*64 .. +name_len] to [out_ptr .. +name_len]; return name_len. Dead or out-of-range row -> CM_BAD_ROW (0xFFFFFCC7). Byte copy via `mov_b r10,[rax+rcx*1]; mov_b [r12+rcx*1],r10` with r10 pre-zeroed (encoder does not zero-extend on its own). Three callee-save pushes (rbx=row_id, r12=out_ptr, r13=name_len) alone land rsp%16==0 at nested kcm_row_live / kcm_name_slot_base (entry rsp%16==8; +3*8=24 -> 32%16==0). Matches cmd_module_lookup's 3-push-no-pad discipline. Labels prefixed kcm_rn_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                    // row_id
        mov r12, rsi;                    // out_ptr

        // Validate: row LIVE.
        mov rdi, rbx;
        call kcm_row_live;
        cmp rax, 0;
        je  kcm_rn_bad;

        // Load name_len from _kcm_name_lens[row_id].
        lea r10, [rip + _kcm_name_lens];
        mov r13, [r10 + rbx * 8];

        // If out_ptr == 0, size-only query: skip the copy.
        cmp r12, 0;
        je  kcm_rn_done;

        // Resolve slot_base in rax.
        mov rdi, rbx;
        call kcm_name_slot_base;         // rax = slot base

        xor rcx, rcx;                    // i
      kcm_rn_copy:
        cmp rcx, r13;
        jae kcm_rn_done;
        xor r10, r10;                    // pre-zero before mov_b
        mov_b r10, [rax + rcx * 1];
        mov_b [r12 + rcx * 1], r10;
        add rcx, 1;
        jmp kcm_rn_copy;

      kcm_rn_done:
        mov rax, r13;                    // return name_len
        jmp kcm_rn_out;

      kcm_rn_bad:
        mov rax, 0xFFFFFCC7;             // CM_BAD_ROW

      kcm_rn_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // cmd_module_open(name_ptr, name_len) -> handle | errcode
  //
  // Mint a KIND_CMD_MODULE row for the named module.
  //
  // Algorithm:
  //   1. Validate name (name_ptr != 0; 0 < name_len <= CM_NAME_MAX = 64).
  //      Else CM_BAD_NAME.
  //   2. Compute hash via kcm_name_hash.
  //   3. kcm_find_hash(hash): if hit, CM_ALREADY_LOADED. (R123.M1
  //      skeleton refuses dup opens; a future M* may bump open_count
  //      instead.)
  //   4. kcm_find_empty(): if miss, CM_MODULE_FULL.
  //   5. Write the row: name_hash, open_count=1, cmd_count=0,
  //      loaded_at_ts=0, flags=LIVE, reserved=0. flags LAST
  //      (publish-last discipline, §2).
  //   6. Emit `CMD_MODULE OPEN name_hash=0x<16-hex> handle=0x<16-hex>`
  //      via klog_s1_x2 (hex + hex).
  //   7. Bump CM_ST_OPEN_OK; return handle (row_id).
  //
  // Register plan: rbx = name_ptr, r12 = name_len, r13 = hash, r14 =
  // row_id. Four callee-save pushes land rsp%16==0 at every nested
  // call (entry rsp%16==8; +4*8=32 -> 40, 40%16==8 -- WAIT; recompute:
  // 8 + 32 = 40, 40%16==8 -- that is wrong for aligned calls. Add a
  // fifth push (r15) for alignment: 8 + 40 = 48, 48%16==0. Good.).
  // ==========================================================================
  pub let cmd_module_open : (u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (name_ptr: u64) (name_len: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "UMB-W1 R123.M1 (#2585) + R123.M5 (#2589): mint one KIND_CMD_MODULE row. Gate order: (1) name_ptr != 0 AND 0 < name_len <= CM_NAME_MAX=64 (else CM_BAD_NAME); (2) kcm_find_hash dup -> CM_ALREADY_LOADED; (3) kcm_find_empty -> CM_MODULE_FULL on miss; (4) R123.M5 kcm_name_store copies name bytes + length into _kcm_names/_kcm_name_lens so later CM_OP_READ_NAME can return the actual name; (5) write 6 u64 (name_hash, open_count=1, cmd_count=0, loaded_at_ts=0, flags=LIVE, reserved=0) with flags LAST (publish-last discipline, §2) -- note name_store runs BEFORE flags=LIVE so a torn reader seeing LIVE sees a populated name slot; (6) emit CMD_MODULE OPEN fingerprint via klog_s1_x2 (hex+hex: name_hash + handle); (7) bump CM_ST_OPEN_OK; return handle. Five callee-save pushes (rbx=name_ptr, r12=name_len, r13=hash, r14=row_id, r15 for alignment pad) leave rsp%16==0 at every nested call (entry rsp%16==8; +5*8=40 -> 48%16==0). klog_s1_x2 frame uses sub rsp,16 (v2 at [rsp+0] per Wave 73 I7 regression) keeping rsp%16==0 at the klog call. Labels prefixed kcm_op_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        // rsp%16: 8 + 40 = 48, 48 % 16 == 0 at nested calls.

        mov rbx, rdi;                    // name_ptr
        mov r12, rsi;                    // name_len

        // Step 1: name validity.
        cmp rbx, 0;
        je  kcm_op_bad_name;
        cmp r12, 0;
        je  kcm_op_bad_name;
        mov r10, 64;                     // CM_NAME_MAX
        cmp r12, r10;
        ja  kcm_op_bad_name;

        // Step 2: hash.
        mov rdi, rbx;
        mov rsi, r12;
        call kcm_name_hash;
        mov r13, rax;                    // name_hash

        // Step 3: dup scan.
        mov rdi, r13;
        call kcm_find_hash;
        mov r10, 0xFF;
        cmp rax, r10;
        jne kcm_op_dup;                  // found live row with same hash

        // Step 4: alloc empty.
        call kcm_find_empty;
        mov r10, 0xFF;
        cmp rax, r10;
        je  kcm_op_full;
        mov r14, rax;                    // row_id

        // Step 4b (R123.M5 #2589): capture name bytes + length into the
        // discovery name store. Writes _kcm_names[row_id*64..+name_len]
        // and _kcm_name_lens[row_id]. Done BEFORE the row's flags LIVE
        // publish-last so a torn reader that sees LIVE sees a populated
        // name slot too.
        mov rdi, r14;                    // row_id
        mov rsi, rbx;                    // name_ptr
        mov rdx, r12;                    // name_len
        call kcm_name_store;

        // Step 5: write row.
        mov rdi, r14;
        call kcm_row_base;               // rax = row base

        mov [rax + 0],  r13;             // name_hash
        mov r10, 1;
        mov [rax + 8],  r10;             // open_count = 1
        xor r10, r10;
        mov [rax + 16], r10;             // cmd_count   = 0
        mov [rax + 24], r10;             // loaded_at_ts = 0 (sched wire later)
        mov [rax + 40], r10;             // reserved    = 0
        // flags LAST (publish-last):
        mov r10, 1;                      // CM_FLAG_LIVE
        mov [rax + 32], r10;             // flags = LIVE

        // Step 6: fingerprint.
        // klog_s1_x2 wire shape:
        //   rdi=level, rsi=subsys, rdx=tag, rcx=k1, r8=v1, r9=k2;
        //   caller's [rsp+0] after sub rsp,16 holds v2.
        sub rsp, 16;
        mov [rsp + 0], r14;              // v2 = handle (row_id)
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + kcm_tag_open];
        lea rcx, [rip + kcm_k_name_hash]; // k1
        mov r8, r13;                     // v1 = name_hash
        lea r9, [rip + kcm_k_handle];    // k2
        call klog_s1_x2;
        add rsp, 16;

        // Step 7: bump + return.
        mov rdi, 0;                      // CM_ST_OPEN_OK
        call kcm_note;

        mov rax, r14;                    // handle = row_id
        jmp kcm_op_out;

      kcm_op_bad_name:
        mov rdi, 2;                      // CM_ST_OPEN_BAD_NAME
        call kcm_note;
        mov rax, 0xFFFFFCC1;             // CM_BAD_NAME
        jmp kcm_op_out;

      kcm_op_dup:
        mov rdi, 3;                      // CM_ST_OPEN_DUP
        call kcm_note;
        mov rax, 0xFFFFFCC5;             // CM_ALREADY_LOADED
        jmp kcm_op_out;

      kcm_op_full:
        mov rdi, 1;                      // CM_ST_OPEN_FULL
        call kcm_note;
        mov rax, 0xFFFFFCC2;             // CM_MODULE_FULL

      kcm_op_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // cmd_module_lookup(handle, cmd_name_ptr, cmd_name_len) -> cmd_handle | err
  //
  // Resolve a command name within an opened module.
  //
  // R123.M1 SKELETON SEMANTICS: no command registry exists yet (R123.M2
  // populates it), so every well-formed lookup against a LIVE handle
  // returns CM_CMD_NOT_FOUND. We still validate the handle and emit the
  // fingerprint so the wire shape is frozen; M2 flips the body from
  // "always miss" to "scan the per-module command table".
  //
  // Validation:
  //   * handle < CM_MODULE_MAX AND flags & LIVE != 0, else
  //     CM_UNKNOWN_HANDLE.
  //   * cmd_name_ptr != 0 AND cmd_name_len > 0 (soft check; a zero-
  //     length name just rolls into the MISS fingerprint).
  //
  // Fingerprint `CMD_MODULE LOOKUP cmd_name=<dec> result=0x<16-hex>`.
  // The <dec> is cmd_name_len (semantically meaningful at skeleton
  // level: the number of bytes the lookup was asked to match); M2
  // populates it with a real cmd ordinal.
  //
  // Register plan: rbx = handle, r12 = cmd_name_ptr, r13 = cmd_name_len.
  // Three callee-save pushes land rsp%16==0 at every nested call
  // (entry rsp%16==8; +3*8=24 -> 32%16==0).
  // ==========================================================================
  pub let cmd_module_lookup : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (handle: u64) (cmd_name_ptr: u64) (cmd_name_len: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "UMB-W1 R123.M1 (#2585) SKELETON: validate handle (bounds + LIVE); M1 always returns CM_CMD_NOT_FOUND (no cmd registry wired yet; M2 populates). Emits `CMD_MODULE LOOKUP cmd_name=<cmd_name_len> result=0x<result>` via klog_s1_x1_d1 (hex=result, dec=cmd_name_len). Bump CM_ST_LOOKUP_MISS on miss, CM_ST_LOOKUP_HIT on hit (reserved slot; M1 never reaches it). Three callee-save pushes (rbx=handle, r12=cmd_name_ptr, r13=cmd_name_len) land rsp%16==0 at every nested call. klog_s1_x1_d1 frame uses sub rsp,16 (v_dec at [rsp+0] per Wave 73 I7). Labels prefixed kcm_lu_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                    // handle
        mov r12, rsi;                    // cmd_name_ptr (unused at M1)
        mov r13, rdx;                    // cmd_name_len

        // Validate handle.
        mov rdi, rbx;
        call kcm_row_live;
        cmp rax, 0;
        je  kcm_lu_unk;

        // Skeleton: always miss. Bump stat, emit fingerprint w/ result=CM_CMD_NOT_FOUND.
        mov rdi, 5;                      // CM_ST_LOOKUP_MISS
        call kcm_note;

        // klog_s1_x1_d1 wire shape:
        //   rdi=level, rsi=subsys, rdx=tag, rcx=kx, r8=vx (hex), r9=kd;
        //   caller's [rsp+0] after sub rsp,16 holds vd (decimal).
        sub rsp, 16;
        mov [rsp + 0], r13;              // vd = cmd_name_len
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + kcm_tag_lookup];
        lea rcx, [rip + kcm_k_result];   // kx = result
        mov r8, 0xFFFFFCC4;              // vx = CM_CMD_NOT_FOUND
        lea r9, [rip + kcm_k_cmd_name];  // kd = cmd_name
        call klog_s1_x1_d1;
        add rsp, 16;

        mov rax, 0xFFFFFCC4;             // CM_CMD_NOT_FOUND
        jmp kcm_lu_out;

      kcm_lu_unk:
        mov rax, 0xFFFFFCC3;             // CM_UNKNOWN_HANDLE

      kcm_lu_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // cmd_module_list(handle, out_ptr, out_len) -> count | errcode
  //
  // Enumerate the commands a module exposes.
  //
  // R123.M1 SKELETON: cmd_count is always 0 (no registry yet). Validate
  // the handle and return 0; M2 populates and writes IDs to out_ptr
  // (bounded by out_len) + returns the real count. No fingerprint at
  // M1 (list is a query, not an event; a future M* may emit when the
  // caller requests > cmd_count rows).
  //
  // Register plan: 1 callee-save push (rbx = handle). Entry rsp%16==8;
  // +8 -> rsp%16==0 at the nested call.
  // ==========================================================================
  pub let cmd_module_list : (u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (handle: u64) (out_ptr: u64) (out_len: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "UMB-W1 R123.M1 (#2585) SKELETON: validate handle (bounds + LIVE); return cmd_count read from row at [+16] (always 0 at M1; M2 populates). CM_UNKNOWN_HANDLE on dead handle. out_ptr/out_len unused at M1 (M2 writes IDs). One push (rbx=handle) lands rsp%16==0 at nested kcm_row_live/kcm_row_base. Labels prefixed kcm_ls_.",
      block: {
        push rbx;

        mov rbx, rdi;                    // handle

        mov rdi, rbx;
        call kcm_row_live;
        cmp rax, 0;
        je  kcm_ls_unk;

        // Read cmd_count from row[+16] (always 0 at M1).
        mov rdi, rbx;
        call kcm_row_base;
        mov rax, [rax + 16];             // cmd_count
        jmp kcm_ls_out;

      kcm_ls_unk:
        mov rax, 0xFFFFFCC3;             // CM_UNKNOWN_HANDLE

      kcm_ls_out:
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // cmd_module_close(handle) -> OK | errcode
  //
  // Release one open against a module.
  //
  // Algorithm:
  //   1. Validate handle (< CM_MODULE_MAX AND LIVE). Else
  //      CM_UNKNOWN_HANDLE.
  //   2. Decrement row.open_count. If it drops to 0, clear flags (the
  //      row becomes EMPTY again -- the next kcm_find_empty picks it
  //      up). If it stays > 0, the row remains LIVE (future M* with
  //      refcount semantics).
  //   3. Emit `CMD_MODULE CLOSE handle=0x<16-hex>` via klog_s1_x1.
  //   4. Bump CM_ST_CLOSE_OK; return CM_OK.
  //
  // Register plan: 1 callee-save push (rbx = handle). Entry rsp%16==8;
  // +8 -> rsp%16==0 at every nested call. klog_s1_x1 is a 5-register
  // wrapper (no stack arg), so no additional sub-rsp needed.
  // ==========================================================================
  pub let cmd_module_close : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (handle: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "UMB-W1 R123.M1 (#2585): close one open against a KIND_CMD_MODULE row. Gate: handle<CM_MODULE_MAX AND flags & LIVE != 0. On OK: open_count-=1; if hits 0, flags := 0 (row re-enters EMPTY pool). Emits `CMD_MODULE CLOSE handle=0x<handle>` via klog_s1_x1 (hex-only). Bump CM_ST_CLOSE_OK or CM_ST_CLOSE_UNK accordingly. One callee-save push (rbx=handle); +8 lands rsp%16==0 at nested kcm_row_live/kcm_row_base/klog_s1_x1 calls. Labels prefixed kcm_cl_.",
      block: {
        push rbx;

        mov rbx, rdi;                    // handle

        mov rdi, rbx;
        call kcm_row_live;
        cmp rax, 0;
        je  kcm_cl_unk;

        // Decrement open_count at row[+8].
        mov rdi, rbx;
        call kcm_row_base;               // rax = row base
        mov r10, [rax + 8];              // open_count
        cmp r10, 0;
        je  kcm_cl_clear;                // defensive: already 0 -> clear
        sub r10, 1;
        mov [rax + 8], r10;
        cmp r10, 0;
        jne kcm_cl_done;

      kcm_cl_clear:
        // open_count now 0: scrub LIVE flag. (Row scrubbing is cheap;
        // name_hash and other columns stay set until the next open
        // overwrites, which does not matter because scans honor
        // flags==0 == EMPTY.)
        xor r10, r10;
        mov [rax + 32], r10;             // flags := 0

      kcm_cl_done:
        // Fingerprint.
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + kcm_tag_close];
        lea rcx, [rip + kcm_k_handle];   // k1
        mov r8, rbx;                     // v1 = handle
        call klog_s1_x1;

        mov rdi, 6;                      // CM_ST_CLOSE_OK
        call kcm_note;

        xor rax, rax;                    // CM_OK
        jmp kcm_cl_out;

      kcm_cl_unk:
        mov rdi, 7;                      // CM_ST_CLOSE_UNK
        call kcm_note;
        mov rax, 0xFFFFFCC3;             // CM_UNKNOWN_HANDLE

      kcm_cl_out:
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // cap_handler_cmd_module(rights, target_ptr, op_arg) -> u64
  //
  // KIND_CMD_MODULE cap_invoke dispatch. Reachable from cap/invoke.pdx
  // :cap_invoke_dispatch via the `cmp rcx, 0x5C; je call_kind_cmd_module`
  // arm (added by this landing).
  //
  // op_arg encoding (R123.M1 skeleton surface + R123.M5/M6 extensions):
  //   bits [7:0]    = op_code  (CM_OP_LOOKUP = 0, CM_OP_LIST = 1,
  //                              CM_OP_CLOSE = 2, CM_OP_LIST_FIRST = 3,
  //                              CM_OP_LIST_NEXT = 4, CM_OP_READ_NAME = 5,
  //                              CM_OP_RELOAD = 6)
  //   bits [39:8]   = handle   (u32, caps-of-caller row_id)
  //
  // Ops:
  //   CM_OP_LOOKUP  -> cmd_module_lookup(handle, 0, 0) -- the ptr+len
  //                     pair is not plumbed through cap_invoke's 3-arg
  //                     surface at M1; the handler reports MISS for
  //                     every call. R123.M2 widens this once the
  //                     cap_invoke 5-arg handler shape lands (or by
  //                     threading the cmd name through a per-process
  //                     scratch register the handler reads here).
  //   CM_OP_LIST    -> cmd_module_list(handle, 0, 0) -- returns
  //                     cmd_count (always 0 at M1).
  //   CM_OP_CLOSE   -> cmd_module_close(handle).
  //   CM_OP_RELOAD  -> _cmd_registry_reload() [R123.M6 UMB-W8 #2590].
  //                     Table-wide mutation: flushes the KCM pool,
  //                     re-parses /system/shell/commands.toml, emits
  //                     the CMDREG RELOADED fingerprint, returns
  //                     CRP_OK or CRP_ERR_*. Idempotency guard owned
  //                     by the reload primitive (atomic xchg on a
  //                     static in-flight flag; concurrent re-entry
  //                     surfaces CRP_ERR_RELOAD_BUSY).
  //   else          -> INVOKE_UNSUPPORTED.
  //
  // Rights:
  //   LOOKUP + LIST require R_CM_READ.
  //   CLOSE requires R_CM_INVOKE (its mutation of the row is a state
  //   transition, not a read).
  //   RELOAD requires R_CM_WRITE (table-wide mutation; distinct bit
  //   from R_CM_INVOKE's per-row CLOSE gate).
  //
  // Register plan: three callee-save pushes (rbx=rights, r12=op_code,
  // r13=handle) land rsp%16==0 at every nested call.
  // ==========================================================================
  pub let cap_handler_cmd_module : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "UMB-W1 R123.M1 (#2585) + R123.M5 (#2589) + R123.M6 UMB-W8 (#2590): KIND_CMD_MODULE cap_invoke dispatch. Entry chatter (klog_s1 of kcm_tag_handler_entry). op_code = op_arg[7:0]; handle = (op_arg >> 8) & 0xFFFFFFFF (also serves as row_id for M5 ops). Rights gate: LOOKUP/LIST/LIST_FIRST/LIST_NEXT/READ_NAME require R_CM_READ; CLOSE requires R_CM_INVOKE; RELOAD requires R_CM_WRITE. Delegate ops 0..2 to cmd_module_lookup/list/close; 3..5 to kcm_list_first/kcm_list_next/kcm_read_name (M5 discovery iterator); 6 to _cmd_registry_reload (M6 hot-reload primitive in cmd_registry_parser.pdx §13 which owns the in-flight guard). READ_NAME is called with out_ptr=0 (size-only) because cap_invoke's 3-arg surface does not plumb a buffer at this landing; in-kernel consumers bypass the dispatcher. Else INVOKE_UNSUPPORTED. Rights violation -> INVOKE_DENIED. Three callee-save pushes (rbx=rights, r12=op_code, r13=handle) land rsp%16==0 at every nested call. Labels prefixed kcm_hd_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                    // rights
        mov r12, rdx;                    // op_arg
        mov r10, 0xFF;
        and r12, r10;                    // op_code = op_arg[7:0]
        mov r13, rdx;
        shr r13, 8;
        mov r10, 0xFFFFFFFF;
        and r13, r10;                    // handle = (op_arg >> 8) & u32

        // Entry chatter.
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + kcm_tag_handler_entry];
        call klog_s1;

        // Op dispatch (rights check inside each arm so CLOSE gets its
        // own gate while LOOKUP/LIST/LIST_FIRST/LIST_NEXT/READ_NAME
        // share one). R123.M5 (#2589) adds the three discovery arms.
        cmp r12, 0;
        je  kcm_hd_op_lookup;
        cmp r12, 1;
        je  kcm_hd_op_list;
        cmp r12, 2;
        je  kcm_hd_op_close;
        cmp r12, 3;
        je  kcm_hd_op_list_first;
        cmp r12, 4;
        je  kcm_hd_op_list_next;
        cmp r12, 5;
        je  kcm_hd_op_read_name;
        cmp r12, 6;
        je  kcm_hd_op_reload;
        jmp kcm_hd_unsup;

      kcm_hd_op_lookup:
        mov r10, rbx;
        and r10, 0x001;                  // R_CM_READ
        cmp r10, 0;
        je  kcm_hd_denied;
        mov rdi, r13;                    // handle
        xor rsi, rsi;                    // cmd_name_ptr = 0 (not plumbed)
        xor rdx, rdx;                    // cmd_name_len = 0
        call cmd_module_lookup;
        jmp kcm_hd_out;

      kcm_hd_op_list:
        mov r10, rbx;
        and r10, 0x001;                  // R_CM_READ
        cmp r10, 0;
        je  kcm_hd_denied;
        mov rdi, r13;                    // handle
        xor rsi, rsi;                    // out_ptr = 0 (not plumbed)
        xor rdx, rdx;                    // out_len = 0
        call cmd_module_list;
        jmp kcm_hd_out;

      kcm_hd_op_close:
        mov r10, rbx;
        and r10, 0x002;                  // R_CM_INVOKE
        cmp r10, 0;
        je  kcm_hd_denied;
        mov rdi, r13;                    // handle
        call cmd_module_close;
        jmp kcm_hd_out;

      // R123.M5 (#2589) discovery arms. All three gate on R_CM_READ:
      // they expose only read-side table/name state (no state mutation).
      // LIST_FIRST ignores its handle slot (iterator seed, no arg).
      // LIST_NEXT uses the handle slot as the previous row_id.
      // READ_NAME uses the handle slot as the row_id to read; out_ptr
      // is NOT plumbed through cap_invoke's 3-arg surface at this
      // landing, so the handler calls kcm_read_name with out_ptr=0
      // (size-only query). An in-kernel consumer that needs the bytes
      // calls kcm_read_name directly with a real out_ptr.
      kcm_hd_op_list_first:
        mov r10, rbx;
        and r10, 0x001;                  // R_CM_READ
        cmp r10, 0;
        je  kcm_hd_denied;
        call kcm_list_first;
        jmp kcm_hd_out;

      kcm_hd_op_list_next:
        mov r10, rbx;
        and r10, 0x001;                  // R_CM_READ
        cmp r10, 0;
        je  kcm_hd_denied;
        mov rdi, r13;                    // row_id (from handle slot)
        call kcm_list_next;
        jmp kcm_hd_out;

      kcm_hd_op_read_name:
        mov r10, rbx;
        and r10, 0x001;                  // R_CM_READ
        cmp r10, 0;
        je  kcm_hd_denied;
        mov rdi, r13;                    // row_id
        xor rsi, rsi;                    // out_ptr = 0 (not plumbed at M5)
        call kcm_read_name;
        jmp kcm_hd_out;

      // R123.M6 UMB-W8 hot-reload arm (paideia-os #2590). Gates
      // R_CM_WRITE (0x004) and dispatches to _cmd_registry_reload
      // (src/kernel/core/shell/cmd_registry_parser.pdx §13). The
      // reload primitive owns the in-flight guard (atomic xchg on
      // _crp_reload_in_flight) so a concurrent re-entry sees
      // CRP_ERR_RELOAD_BUSY (0x0C05); this arm forwards the errno
      // return unchanged.
      kcm_hd_op_reload:
        mov r10, rbx;
        and r10, 0x004;                  // R_CM_WRITE
        cmp r10, 0;
        je  kcm_hd_denied;
        call _cmd_registry_reload;
        jmp kcm_hd_out;

      kcm_hd_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;     // INVOKE_DENIED
        jmp kcm_hd_out;

      kcm_hd_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;     // INVOKE_UNSUPPORTED

      kcm_hd_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Boot wiring note
  // ----------------
  // kernel_main.pdx needs one new call alongside the existing cap/
  // substrate resets:
  //
  //   call kcm_table_reset;             // defensive zero
  //
  // Zero-arg, allocates nothing on the stack, touches rax/rcx/r10;
  // safe alongside kernel_main's live handoff registers. Wiring
  // deferred to the next slice. At real boot .bss zero-init already
  // leaves _kcm_table empty, so cmd_module_open correctly ALLOCATES
  // from row 0 upward without the explicit reset.
  //
  // Cross-module caller sites (future landings):
  //   - src/kernel/core/shell/cmd_loader.pdx (R123.M2, #2586): calls
  //     cmd_module_open(name_ptr, name_len) at .pds-package load and
  //     records the returned handle in the shell's module table.
  //   - src/kernel/core/shell/cmd_registry.pdx (R123.M2): the registry
  //     binds each command exposed by a module to its row's cmd_count
  //     column + populates per-row command metadata; this is the slice
  //     that flips cmd_module_lookup from "always miss" to real.
  //   - src/kernel/core/shell/cmd_unload.pdx (R123.M2): calls
  //     cmd_module_close(handle) when a module is unloaded.
  //   - src/kernel/core/cap/invoke.pdx: ADDED by this landing, dispatch
  //     arm `cmp rcx, 0x5C; je call_kind_cmd_module` + the matching
  //     `call cap_handler_cmd_module; ret` label.
  // ==========================================================================
}
