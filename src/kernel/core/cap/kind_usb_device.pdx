  // ==========================================================================
  // Mint.
  // ==========================================================================

  pub let usb_device_cap_mint_inner : (u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (address: u64) (speed: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R34.M1-003 (#1169): mint a KIND_USB_DEVICE over a KIND_DEVICE. Sequence: (1) slot < 256 else BAD_SLOT. (2) check_parent -> BAD_PARENT. (3) rights_valid -> BAD_RIGHTS. (4) address in [1,127] else BAD_ADDRESS. (5) speed in [1,4] else BAD_SPEED. (6) INHERIT device_key -> NO_DEVICE. (7) UNIQUENESS on key -> IN_USE. (8) hdr_pack + body_pack + tail_alloc. (9) cap_mint_write with target_ptr = row_id | (slot << 16). Labels prefixed usbd_mi_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov rbx, rdi;                    // slot
        mov r12, rsi;                    // parent_slot
        mov r13, rdx;                    // rights
        mov r14, rcx;                    // address
        mov r15, r8;                     // speed

        mov r10, 256;
        cmp rbx, r10;
        jae usbd_mi_bad_slot;

        mov rdi, r12;
        call usb_device_check_parent;
        cmp rax, 0;
        je  usbd_mi_bad_parent;

        mov rdi, r13;
        call usb_device_rights_valid;
        cmp rax, 0;
        je  usbd_mi_bad_rights;

        mov rdi, r14;
        call usb_device_address_valid;
        cmp rax, 0;
        je  usbd_mi_bad_addr;

        mov rdi, r15;
        call usb_device_speed_valid;
        cmp rax, 0;
        je  usbd_mi_bad_speed;

        mov rdi, r12;
        call usb_device_parent_key;
        cmp rax, 0;
        je  usbd_mi_no_device;
        mov rbp, rax;                    // device_key

        mov rdi, rbp;
        call usb_device_find_by_key;
        cmp rax, 0xFF;
        jne usbd_mi_in_use;

        mov rdi, r12;
        call usb_device_hdr_pack;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  usbd_mi_bad_parent;
        push rax;
        sub rsp, 8;

        mov rdi, r14;
        mov rsi, r15;
        call usb_device_body_pack;
        add rsp, 8;
        pop r10;                         // hdr
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  usbd_mi_bad_speed;

        mov rdi, r10;                    // hdr
        mov rsi, rbp;                    // device_key
        mov rdx, rax;                    // body_packed
        call usb_device_tail_alloc;

        mov r10, 0xFFFFFDEF;
        cmp rax, r10;
        je  usbd_mi_enospc;
        mov r10, 0xFFFFFDEE;
        cmp rax, r10;
        je  usbd_mi_bad_addr;

        mov r14, rax;                    // row_id
        mov r11, rbx;
        shl r11, 16;
        or  r14, r11;

        mov rdi, rbx;
        mov rsi, 0x162;
        mov rdx, r13;
        mov rcx, r14;
        call cap_mint_write;

        mov rdi, 0;                      // ST_MINTS
        call usb_device_note;

        xor rax, rax;
        jmp usbd_mi_out;

      usbd_mi_bad_slot:
        mov rax, 0xFFFFFDE6;
        jmp usbd_mi_out;
      usbd_mi_bad_parent:
        mov rax, 0xFFFFFDED;
        jmp usbd_mi_out;
      usbd_mi_bad_rights:
        mov rax, 0xFFFFFDEC;
        jmp usbd_mi_out;
      usbd_mi_bad_addr:
        mov rax, 0xFFFFFDEB;
        jmp usbd_mi_out;
      usbd_mi_bad_speed:
        mov rax, 0xFFFFFDEA;
        jmp usbd_mi_out;
      usbd_mi_no_device:
        mov rax, 0xFFFFFDE9;
        jmp usbd_mi_out;
      usbd_mi_in_use:
        mov rdi, 2;
        call usb_device_note;
        mov rax, 0xFFFFFDE7;
        jmp usbd_mi_out;
      usbd_mi_enospc:
        mov rdi, 3;
        call usb_device_note;
        mov rax, 0xFFFFFDE8;

      usbd_mi_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let usb_device_cap_mint : (u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (address: u64) (speed: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R34.M1-003 (#1169): audited mint. Reserved labels: none.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;
        mov r13, rsi;

        call usb_device_cap_mint_inner;
        mov r14, rax;

        mov rdi, 1;
        mov rsi, 0x162;
        mov rdx, r12;
        mov rcx, r13;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Revoke.
  // ==========================================================================

  pub let usb_device_cap_revoke_inner : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R34.M1-003 (#1169): revoke a KIND_USB_DEVICE. Labels prefixed usbd_rvk_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;

        mov r10, 256;
        cmp r12, r10;
        jae usbd_rvk_bad_slot;

        lea rax, [rip + cap_table];
        mov r8, r12;
        shl r8, 3;
        mov r9, r12;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov rbx, rax;

        mov r10, [rbx + 0];
        cmp r10, 0;
        je  usbd_rvk_already;

        mov r11, 0x162;
        cmp r10, r11;
        jne usbd_rvk_wrong_kind;

        mov r13, [rbx + 16];
        mov r10, 0xFFFF;
        and r13, r10;

        mov rdi, r13;
        call usb_device_tail_valid;
        cmp rax, 0;
        je  usbd_rvk_clear;

        mov rdi, r13;
        call usb_device_tail_free;

      usbd_rvk_clear:
        mov rdi, r12;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        mov rdi, 1;
        call usb_device_note;

        xor rax, rax;
        jmp usbd_rvk_out;

      usbd_rvk_bad_slot:
        mov rax, 0xFFFFFDE6;
        jmp usbd_rvk_out;
      usbd_rvk_wrong_kind:
        mov rax, 0xFFFFFDE5;
        jmp usbd_rvk_out;
      usbd_rvk_already:
        mov rax, 0xFFFFFDE4;

      usbd_rvk_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let usb_device_cap_revoke : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R34.M1-003 (#1169): audited revoke.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;

        call usb_device_cap_revoke_inner;
        mov r14, rax;

        mov rdi, 2;
        mov rsi, 0x162;
        mov rdx, r12;
        mov rcx, r12;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Dispatch handler.
  // ==========================================================================

  pub let cap_handler_usb_device : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R34.M1-003 (#1169): KIND_USB_DEVICE dispatch handler. row_id = target_ptr[15:0]. Queries need INVOKE; DEBUG_PRINT needs OBSERVE. All ops arity ONE — op_arg[63:8] REFUSED. Labels prefixed usbd_hn_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov r12, rdi;                    // rights
        mov r13, rsi;
        mov r10, 0xFFFF;
        and r13, r10;                    // row_id
        mov r14, rdx;                    // op_arg

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_usb_device_msg];
        call klog_s1;

        mov r10, r14;
        and r10, 0xFF;
        mov rbp, r10;                    // op
        mov r11, r14;
        shr r11, 8;
        cmp r11, 0;
        jne usbd_hn_res;

        cmp rbp, 4;
        ja  usbd_hn_unsup;

        cmp rbp, 4;
        je  usbd_hn_dbg;

        // Ops 0..3: INVOKE.
        mov r10, r12;
        and r10, 0x008;
        cmp r10, 0;
        je  usbd_hn_denied;

        mov rdi, r13;
        cmp rbp, 0;
        je  usbd_hn_key;
        cmp rbp, 1;
        je  usbd_hn_addr;
        cmp rbp, 2;
        je  usbd_hn_spd;
        call usb_device_row_parent;
        jmp usbd_hn_out;

      usbd_hn_key:
        call usb_device_row_key;
        jmp usbd_hn_out;
      usbd_hn_addr:
        call usb_device_row_address;
        jmp usbd_hn_out;
      usbd_hn_spd:
        call usb_device_row_speed;
        jmp usbd_hn_out;

      usbd_hn_dbg:
        mov r10, r12;
        and r10, 0x400;
        cmp r10, 0;
        je  usbd_hn_denied;
        xor rax, rax;
        jmp usbd_hn_out;

      usbd_hn_res:
        mov rax, 0xFFFFFDEE;
        jmp usbd_hn_out;
      usbd_hn_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;
        jmp usbd_hn_out;
      usbd_hn_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;

      usbd_hn_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
