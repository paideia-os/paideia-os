// src/kernel/core/cap/kind_usb_device.pdx — R34.M1-003 (#1169)
//
// KIND_USB_DEVICE = 0x162, derived over KIND_DEVICE (10).
//
// The authority to hold ONE USB device's static identity — its
// inherited device_key (from the parent KIND_DEVICE), the address
// negotiated on its bus (1..127), and the speed ordinal the xhci
// slot lifecycle observed at attach (LOW / FULL / HIGH / SUPER).
//
// =============================================================================
// §0  UNITS: EVERY FIELD IS AN ORDINAL, NOT A HANDLE
// =============================================================================
//
// USB devices are named to the class driver by the xhci_slot that
// negotiated their address; that slot is not exposed through this
// capability, and neither is a transfer-ring handle, a control-
// endpoint slot, or any other reach into the xhci substrate. This
// row records the THREE FACTS a policy layer needs about a USB
// device — who it is, where it lives, and how fast it speaks — and
// no more. Transfers cross the xhci substrate through the class
// driver's separate authority; nothing in this kind carries a byte
// of a transfer, and nothing here reaches an endpoint or a slot at
// all.
//
// The one silent failure a shape like this is prone to is ADDRESS
// SUBSTITUTION: a row that could be re-stamped in place with a
// different address would let one policy decision act as if it were
// about another device. §1 states the discipline that makes it
// unrepresentable: address and speed are ROW IDENTITY, set once at
// mint, and there is no primitive anywhere in this module that
// changes them.
//
// =============================================================================
// §1  STATIC IDENTITY IS AT MINT, DYNAMIC STATE IS ABSENT
// =============================================================================
//
// Same discipline as `kind_hid_device.pdx` §1. `device_key`,
// `address` and `speed` are ROW IDENTITY — they name the physical
// device — and are refused to a mint that supplies implausible
// values. There is NO dynamic state on this row: unlike HID device,
// there is no lifetime counter, because the events that would bump
// it (transfers) do not run through this kind at all. Its whole
// surface is queries.
//
// =============================================================================
// §2  DERIVATION OVER KIND_DEVICE — THE NINTH TIME THE KIND HALF PROVES NOTHING
// =============================================================================
//
// The gate demands `kind == KIND_DEVICE (10)` carrying `RIGHT_MINT`.
// As with KIND_HID_DEVICE, KIND_BACKLIGHT et al., that half
// discriminates NOTHING on its own: every PCI function in the
// machine is a KIND_DEVICE, and "this device is a USB device" is a
// class-code fact a ring-3 xhci_supervisor distills. The kernel
// enforces exactly what it can:
//
//   * The inherited device key must be NON-ZERO (`USBD_MINT_NO_DEVICE`).
//   * NO OTHER LIVE ROW MAY HOLD THAT KEY (`USBD_MINT_IN_USE`). One
//     physical device, one capability.
//   * The address is in [1, 127] (USB spec §9.4.6). Address 0 is
//     the default address every device holds before the SET_ADDRESS
//     command, and admitting it into a capability would let a row
//     claim identity over the still-unassigned bus default.
//   * The speed is one of {LOW, FULL, HIGH, SUPER} (§5).
//
// =============================================================================
// §3  KIND_USB_HUB DERIVES OVER THIS KIND, NOT OVER KIND_DEVICE
// =============================================================================
//
// A USB hub is a USB device whose class descriptor is the standard
// hub descriptor (USB 2.0 §11.23.2.1). The KIND_USB_HUB mint gate
// requires a live KIND_USB_DEVICE as its parent, not a raw
// KIND_DEVICE — same reason KIND_I2C_SLAVE derives over KIND_I2C_BUS
// rather than KIND_DEVICE: without the intermediate authority, any
// PCI holder could claim to have enumerated a hub.
//
// =============================================================================
// §4  ENUMERATIONS: SPEED
// =============================================================================
//
//   0 UNKNOWN     speed not classified — refused for legitimate
//                 mints, present so the ordinal 0 is a real answer
//                 rather than a decode error
//   1 LOW         1.5 Mbps
//   2 FULL        12 Mbps
//   3 HIGH        480 Mbps
//   4 SUPER       5 Gbps (USB 3.x)
//
// =============================================================================
// §5  NO PORT I/O, NO AML, NO FIRMWARE NAMES
// =============================================================================

module KindUsbDevice = structure {

  pub let KIND_USB_DEVICE        : u64 = 0x162
  pub let USB_DEVICE_PARENT_KIND : u64 = 10     // = KIND_DEVICE

  // §2 bounds.
  pub let USB_ADDRESS_MIN : u64 = 1
  pub let USB_ADDRESS_MAX : u64 = 127

  // §4 speed enumeration.
  pub let USB_SPEED_UNKNOWN : u64 = 0
  pub let USB_SPEED_LOW     : u64 = 1
  pub let USB_SPEED_FULL    : u64 = 2
  pub let USB_SPEED_HIGH    : u64 = 3
  pub let USB_SPEED_SUPER   : u64 = 4
  pub let USB_SPEED_MAX     : u64 = 4

  // Rights. RIGHT_MINT (0x200) is OUTSIDE the mask because this kind
  // is a NON-LEAF: KIND_USB_HUB derives from it. Holders that must
  // derive a hub capability need the mint bit; the gate expects it
  // to appear on this kind's row and refuses to fabricate authority.
  pub let R_USB_DEVICE_READ    : u64 = 0x001
  pub let R_USB_DEVICE_INVOKE  : u64 = 0x008
  pub let R_USB_DEVICE_REVOKE  : u64 = 0x010
  pub let R_USB_DEVICE_MINT    : u64 = 0x200
  pub let R_USB_DEVICE_OBSERVE : u64 = 0x400
  pub let R_USB_DEVICE_ALL     : u64 = 0x619

  // Ops (op_arg[7:0]):
  //   0 QUERY_KEY      INVOKE  device_key
  //   1 QUERY_ADDRESS  INVOKE  address
  //   2 QUERY_SPEED    INVOKE  speed
  //   3 QUERY_PARENT   INVOKE  parent slot
  //   4 DEBUG_PRINT    OBSERVE row dump
  pub let USBD_OP_QUERY_KEY     : u64 = 0
  pub let USBD_OP_QUERY_ADDRESS : u64 = 1
  pub let USBD_OP_QUERY_SPEED   : u64 = 2
  pub let USBD_OP_QUERY_PARENT  : u64 = 3
  pub let USBD_OP_DEBUG_PRINT   : u64 = 4
  pub let USBD_OP_MAX           : u64 = 4

  // Failure taxonomy — 0xFFFFFDE0..0xFFFFFDEF (disjoint from every
  // other cap kind's band).
  pub let USBD_OK                 : u64 = 0
  pub let USBD_TAIL_ENOSPC        : u64 = 0xFFFFFDEF
  pub let USBD_TAIL_BAD_ARG       : u64 = 0xFFFFFDEE
  pub let USBD_MINT_BAD_PARENT    : u64 = 0xFFFFFDED
  pub let USBD_MINT_BAD_RIGHTS    : u64 = 0xFFFFFDEC
  pub let USBD_MINT_BAD_ADDRESS   : u64 = 0xFFFFFDEB
  pub let USBD_MINT_BAD_SPEED     : u64 = 0xFFFFFDEA
  pub let USBD_MINT_NO_DEVICE     : u64 = 0xFFFFFDE9
  pub let USBD_MINT_ENOSPC        : u64 = 0xFFFFFDE8
  pub let USBD_MINT_IN_USE        : u64 = 0xFFFFFDE7
  pub let USBD_BAD_SLOT           : u64 = 0xFFFFFDE6
  pub let USBD_WRONG_KIND         : u64 = 0xFFFFFDE5
  pub let USBD_REVOKE_ALREADY     : u64 = 0xFFFFFDE4

  pub let USBD_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let USBD_ROW_NONE   : u64 = 0xFF

  // Table sizing and row layout.
  //
  // EIGHT ROWS, sized by USB devices a T14 G4 initially wires (root
  // hub ports + first-tier peripherals). 32-byte rows so the index
  // is `shl 5`; paideia-as has no `mul`.
  //
  //   [+0]  header (in_use[63:56] | parent_slot[15:8])
  //   [+8]  device_key      INHERITED from parent's target_ptr
  //   [+16] address_speed   address[7:0] | speed[15:8]
  //   [+24] reserved (zero)
  pub let USBD_MAX       : u64 = 8
  pub let USBD_ROW_BYTES : u64 = 32

  pub let mut _usb_device_table : [u64; 32] = uninit @align(64)
  pub let mut _usb_device_stats : [u64; 4]  = uninit @align(64)

  pub let USBD_ST_MINTS   : u64 = 0
  pub let USBD_ST_REVOKES : u64 = 1
  pub let USBD_ST_IN_USE  : u64 = 2
  pub let USBD_ST_ENOSPC  : u64 = 3

  pub let usbd_dbg_msg : [u8; 15] = "USB DEV ROW\n\0\0\0"
  pub let usbd_k_row   : [u8; 4]  = "row\0"
  pub let usbd_k_addr  : [u8; 5]  = "addr\0"
  pub let usbd_k_spd   : [u8; 4]  = "spd\0"
  pub let usbd_k_key   : [u8; 4]  = "key\0"

  // ==========================================================================
  // Table reset.
  // ==========================================================================

  pub let usb_device_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M1-003 (#1169): clear the USB device row table and its counters. Boot and teardown only. Labels prefixed usbd_rs_ per reserved-label discipline.",
      block: {
        lea r10, [rip + _usb_device_table];
        xor rax, rax;
        xor rcx, rcx;
      usbd_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  usbd_rs_rows;

        lea r10, [rip + _usb_device_stats];
        xor rcx, rcx;
      usbd_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  usbd_rs_stats;
        ret
      }
    }

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let usb_device_address_valid : (u64) -> u64 !{} @{} =
    fn (a: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M1-003 (#1169): 1 iff a in [USB_ADDRESS_MIN, USB_ADDRESS_MAX]. Zero is refused because it is the pre-SET_ADDRESS default. Labels prefixed usbd_av_.",
      block: {
        cmp rdi, 1;
        jb  usbd_av_no;
        cmp rdi, 127;
        ja  usbd_av_no;
        mov rax, 1;
        ret;
      usbd_av_no:
        xor rax, rax;
        ret
      }
    }

  pub let usb_device_speed_valid : (u64) -> u64 !{} @{} =
    fn (s: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M1-003 (#1169): 1 iff s in [LOW, SUPER]. UNKNOWN refused per §4. Labels prefixed usbd_sv_.",
      block: {
        cmp rdi, 0;
        je  usbd_sv_no;
        cmp rdi, 4;
        ja  usbd_sv_no;
        mov rax, 1;
        ret;
      usbd_sv_no:
        xor rax, rax;
        ret
      }
    }

  pub let usb_device_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M1-003 (#1169): subset test against R_USB_DEVICE_ALL. Labels prefixed usbd_rv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x619;
        and rax, r10;
        cmp rax, rdi;
        jne usbd_rv_no;
        mov rax, 1;
        ret;
      usbd_rv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Counters.
  // ==========================================================================

  pub let usb_device_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M1-003 (#1169): increment counter. Labels prefixed usbd_nt_.",
      block: {
        cmp rdi, 4;
        jae usbd_nt_out;
        lea r10, [rip + _usb_device_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      usbd_nt_out:
        ret
      }
    }

  pub let usb_device_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M1-003 (#1169): read counter. Labels prefixed usbd_st_.",
      block: {
        cmp rdi, 4;
        jae usbd_st_zero;
        lea r10, [rip + _usb_device_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      usbd_st_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Parent gate: parent must be live KIND_DEVICE with RIGHT_MINT.
  // ==========================================================================

  pub let usb_device_check_parent : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R34.M1-003 (#1169): parent must be live KIND_DEVICE with RIGHT_MINT. §2's empty-half gate. Labels prefixed usbd_cp_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae usbd_cp_no;

        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 10;                     // KIND_DEVICE
        jne usbd_cp_no;

        mov r10, [rax + 8];
        mov r11, 0x200;                  // RIGHT_MINT
        and r10, r11;
        cmp r10, 0;
        je  usbd_cp_no;

        mov rax, 1;
        ret;
      usbd_cp_no:
        xor rax, rax;
        ret
      }
    }

  pub let usb_device_parent_key : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R34.M1-003 (#1169): parent KIND_DEVICE target_ptr (device identity key), or 0. Labels prefixed usbd_pk_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae usbd_pk_no;

        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 10;
        jne usbd_pk_no;

        mov rax, [rax + 16];
        ret;
      usbd_pk_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Header pack.
  // ==========================================================================

  pub let usb_device_hdr_pack : (u64) -> u64 !{} @{} =
    fn (parent_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M1-003 (#1169): (parent_slot << 8). Labels prefixed usbd_hp_.",
      block: {
        mov r10, 256;
        cmp rdi, r10;
        jae usbd_hp_bad;
        mov rax, rdi;
        shl rax, 8;
        ret;
      usbd_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let usb_device_body_pack : (u64, u64) -> u64 !{} @{} =
    fn (address: u64) (speed: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M1-003 (#1169): pack address[7:0] | speed[15:8]. Labels prefixed usbd_bp_.",
      block: {
        cmp rdi, 127;
        ja  usbd_bp_bad;
        cmp rdi, 1;
        jb  usbd_bp_bad;
        cmp rsi, 0;
        je  usbd_bp_bad;
        cmp rsi, 4;
        ja  usbd_bp_bad;

        mov rax, rdi;
        and rax, 0xFF;
        mov r10, rsi;
        and r10, 0xFF;
        shl r10, 8;
        or  rax, r10;
        ret;
      usbd_bp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // Tail alloc/free.
  // ==========================================================================

  pub let usb_device_tail_alloc : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (device_key: u64) (body_packed: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M1-003 (#1169): claim one USB device row. THE ONE WRITER of _usb_device_table. Labels prefixed usbd_ta_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov r12, rdi;                    // hdr
        mov r13, rsi;                    // device_key
        mov r14, rdx;                    // body_packed

        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne usbd_ta_bad;

        cmp r13, 0;
        je  usbd_ta_bad;

        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp r14, r10;
        je  usbd_ta_bad;

        xor rbx, rbx;
      usbd_ta_scan:
        cmp rbx, 8;
        jae usbd_ta_enospc;

        lea r10, [rip + _usb_device_table];
        mov r11, rbx;
        shl r11, 5;
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  usbd_ta_claim;

        add rbx, 1;
        jmp usbd_ta_scan;

      usbd_ta_claim:
        mov rax, r12;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r13;
        mov [r10 + 16], r14;
        xor rax, rax;
        mov [r10 + 24], rax;
        mov rax, rbx;
        jmp usbd_ta_out;

      usbd_ta_enospc:
        mov rax, 0xFFFFFDEF;
        jmp usbd_ta_out;
      usbd_ta_bad:
        mov rax, 0xFFFFFDEE;

      usbd_ta_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let usb_device_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M1-003 (#1169): 1 iff row_id < MAX and in_use. Labels prefixed usbd_tv_.",
      block: {
        cmp rdi, 8;
        jae usbd_tv_no;
        lea r10, [rip + _usb_device_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  usbd_tv_no;
        mov rax, 1;
        ret;
      usbd_tv_no:
        xor rax, rax;
        ret
      }
    }

  pub let usb_device_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M1-003 (#1169): scrub one row. Labels prefixed usbd_tf_.",
      block: {
        cmp rdi, 8;
        jae usbd_tf_out;
        lea r10, [rip + _usb_device_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
      usbd_tf_out:
        ret
      }
    }

  // ==========================================================================
  // Row accessors.
  // ==========================================================================

  pub let usb_device_row_key : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M1-003 (#1169): device_key. Labels prefixed usbd_rk_.",
      block: {
        push r12; push r13; push r14;
        mov r12, rdi;
        call usb_device_tail_valid;
        cmp rax, 0;
        je  usbd_rk_bad;
        lea r10, [rip + _usb_device_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 8];
        jmp usbd_rk_out;
      usbd_rk_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      usbd_rk_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  pub let usb_device_row_address : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M1-003 (#1169): address. Labels prefixed usbd_ra_.",
      block: {
        push r12; push r13; push r14;
        mov r12, rdi;
        call usb_device_tail_valid;
        cmp rax, 0;
        je  usbd_ra_bad;
        lea r10, [rip + _usb_device_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        and rax, 0xFF;
        jmp usbd_ra_out;
      usbd_ra_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      usbd_ra_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  pub let usb_device_row_speed : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M1-003 (#1169): speed. Labels prefixed usbd_rsp_.",
      block: {
        push r12; push r13; push r14;
        mov r12, rdi;
        call usb_device_tail_valid;
        cmp rax, 0;
        je  usbd_rsp_bad;
        lea r10, [rip + _usb_device_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 8;
        and rax, 0xFF;
        jmp usbd_rsp_out;
      usbd_rsp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      usbd_rsp_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  pub let usb_device_row_parent : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M1-003 (#1169): parent slot. Labels prefixed usbd_rpa_.",
      block: {
        push r12; push r13; push r14;
        mov r12, rdi;
        call usb_device_tail_valid;
        cmp rax, 0;
        je  usbd_rpa_bad;
        lea r10, [rip + _usb_device_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 8;
        and rax, 0xFF;
        jmp usbd_rpa_out;
      usbd_rpa_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      usbd_rpa_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  // ==========================================================================
  // Lookups.
  // ==========================================================================

  pub let usb_device_find_by_key : (u64) -> u64 !{mem} @{} =
    fn (device_key: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M1-003 (#1169): live row holding this device_key, or ROW_NONE. Labels prefixed usbd_fk_.",
      block: {
        cmp rdi, 0;
        je  usbd_fk_none;
        xor rcx, rcx;
      usbd_fk_scan:
        cmp rcx, 8;
        jae usbd_fk_none;
        lea r10, [rip + _usb_device_table];
        mov r11, rcx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  usbd_fk_next;
        mov rax, [r10 + 8];
        cmp rax, rdi;
        je  usbd_fk_hit;
      usbd_fk_next:
        add rcx, 1;
        jmp usbd_fk_scan;
      usbd_fk_hit:
        mov rax, rcx;
        ret;
      usbd_fk_none:
        mov rax, 0xFF;
        ret
      }
    }

  pub let usb_device_row_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R34.M1-003 (#1169): slot -> row_id, gated on live KIND_USB_DEVICE. ARITY ONE. Labels prefixed usbd_ros_.",
      block: {
        push r12; push r13; push r14;

        mov r11, 256;
        cmp rdi, r11;
        jae usbd_ros_none;

        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x162;
        cmp r10, r11;
        jne usbd_ros_none;

        mov r12, [rax + 16];
        mov r10, 0xFFFF;
        and r12, r10;

        mov rdi, r12;
        call usb_device_tail_valid;
        cmp rax, 0;
        je  usbd_ros_none;

        mov rax, r12;
        jmp usbd_ros_out;

      usbd_ros_none:
        mov rax, 0xFF;
      usbd_ros_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  pub let usb_device_key_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R34.M1-003 (#1169): device_key of the USB device this cap names. ARITY ONE. Labels prefixed usbd_kos_.",
      block: {
        push r12; push r13; push r14;
        call usb_device_row_of_slot;
        mov r12, rax;
        cmp r12, 0xFF;
        je  usbd_kos_bad;
        mov rdi, r12;
        call usb_device_row_key;
        jmp usbd_kos_out;
      usbd_kos_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      usbd_kos_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

