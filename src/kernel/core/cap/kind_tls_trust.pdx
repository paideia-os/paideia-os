  // Slot -> row_id, gated on the descriptor being a live KIND_TLS_TRUST.
  // Kind constant 0x1A7 staged in r11 (§4). THE ONLY ROUTE IN THE
  // KERNEL FROM A CAP SLOT TO A TLS-TRUST ROW.
  pub let tls_trust_row_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R100-PREP-001 (#2007): slot -> row_id gated on KIND_TLS_TRUST (0x1A7, r11-staged per §4). THE ONLY ROUTE IN THE KERNEL FROM A CAP SLOT TO A TLS-TRUST ROW. Descriptor's target_ptr low u16 is the row_id; matches every other kind_*_row_of_slot in this tree. Labels prefixed tlst_ros_.",
      block: {
        push r12;

        mov r11, 256;
        cmp rdi, r11;
        jae tlst_ros_none;

        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x1A7;                  // KIND_TLS_TRUST
        cmp r10, r11;
        jne tlst_ros_none;

        mov r12, [rax + 16];
        mov r10, 0xFFFF;
        and r12, r10;

        mov rdi, r12;
        call tls_trust_row_valid;
        cmp rax, 0;
        je  tlst_ros_none;

        mov rax, r12;
        jmp tlst_ros_out;

      tlst_ros_none:
        mov rax, 0xFF;                   // TLS_TRUST_ROW_NONE
      tlst_ros_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // kind_tls_trust_mint_body(parent_slot, algo, key_ptr, label_ptr)
  //   -> row_id | TLS_TRUST_MINT_*
  //
  // The KIND_TLS_TRUST mint walker. Not reachable via cap_invoke (§2's
  // immutability contract makes MINT/WRITE/REVOKE not-a-right); called
  // from supervisor / loader / pdxtrust code that already holds a root
  // KIND_MEMORY parent cap with RIGHT_MINT. On success emits the mint
  // fingerprint via klog_s1_x1(LEVEL_INFO, SUBSYS_CAP_, tls_trust_
  // mint_ok_msg, tls_trust_k_row, row_id) once -- matches KIND_SIG_KEY /
  // KIND_TUI_CANVAS mint-emit discipline; no fingerprint on QUERY /
  // READ.
  //
  // Gate order: (1) parent (KIND_MEMORY + RIGHT_MINT); (2) algo; (3)
  // key_ptr non-null; (4) label_ptr non-null; (5) hdr_pack; (6)
  // tail_alloc. Six callee-save pushes + sub rsp,8 leave rsp%16==0 for
  // every nested call (entry rsp%16==8, +48+8=56 -> %16==0).
  // ==========================================================================
  pub let kind_tls_trust_mint_body : (u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (parent_slot: u64) (algo: u64) (key_ptr: u64) (label_ptr: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R100-PREP-001 (#2007): mint KIND_TLS_TRUST over KIND_MEMORY. Gate order: (1) parent (tls_trust_check_parent_memory: KIND_MEMORY(4)+RIGHT_MINT); (2) algo (tls_trust_algo_valid: [1, TLS_TRUST_ALGO_MAX=1]); (3) key_ptr non-null (a zero pointer never dereferences safely -- pdxcurl-design.md §12.3's .pubkey buffer always has a real address); (4) label_ptr non-null (callers passing an all-zero 16-byte region still pass its address, not zero); (5) tls_trust_hdr_pack; (6) tls_trust_tail_alloc(hdr, key_ptr, label_ptr). Register plan: r12=parent_slot, r13=algo, r14=key_ptr, r15=label_ptr, rbx=hdr (packed algo), rbp=row_id -- all live across the klog_s1_x1 call, which preserves rbx/rbp/r12-r15 per SysV. Six callee-save pushes + sub rsp,8 = 56 bytes: entry rsp%16==8, +56 -> %16==0 for every nested call. On success emits the mint fingerprint once (matches KIND_SIG_KEY / KIND_TUI_CANVAS mint-emit discipline). Refusal paths bump TLS_TRUST_ST_REFUSED through the shared tlst_mi_refused funnel (mirrors kind_tui_canvas.pdx tcm_refused / kind_sig_key.pdx sigk_mi_refused). Labels prefixed tlst_mi_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;
        sub rsp, 8;

        mov r12, rdi;                    // parent_slot
        mov r13, rsi;                    // algo
        mov r14, rdx;                    // key_ptr
        mov r15, rcx;                    // label_ptr

        // (1) Parent gate.
        mov rdi, r12;
        call tls_trust_check_parent_memory;
        cmp rax, 0;
        je  tlst_mi_bad_parent;

        // (2) Algo gate.
        mov rdi, r13;
        call tls_trust_algo_valid;
        cmp rax, 0;
        je  tlst_mi_bad_algo;

        // (3) key_ptr non-null.
        cmp r14, 0;
        je  tlst_mi_bad_key;

        // (4) label_ptr non-null.
        cmp r15, 0;
        je  tlst_mi_bad_label;

        // (5) Pack header.
        mov rdi, r13;
        call tls_trust_hdr_pack;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  tlst_mi_bad_algo;
        mov rbx, rax;                    // hdr

        // (6) tail_alloc(hdr, key_ptr, label_ptr).
        mov rdi, rbx;
        mov rsi, r14;
        mov rdx, r15;
        call tls_trust_tail_alloc;
        mov r10, 8;                      // TLS_TRUST_MAX
        cmp rax, r10;
        jae tlst_mi_alloc_fail;          // rax already holds sentinel

        mov rbp, rax;                    // row_id

        mov rdi, 0;                      // TLS_TRUST_ST_MINTS
        call tls_trust_note;

        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + tls_trust_mint_ok_msg];
        lea rcx, [rip + tls_trust_k_row];
        mov r8,  rbp;                    // row_id
        call klog_s1_x1;

        mov rax, rbp;
        jmp tlst_mi_out;

      tlst_mi_alloc_fail:
        jmp tlst_mi_refused;
      tlst_mi_bad_parent:
        mov rax, 0xFFFFEB27;             // TLS_TRUST_MINT_BAD_PARENT
        jmp tlst_mi_refused;
      tlst_mi_bad_algo:
        mov rax, 0xFFFFEB26;             // TLS_TRUST_MINT_BAD_ALGO
        jmp tlst_mi_refused;
      tlst_mi_bad_key:
        mov rax, 0xFFFFEB25;             // TLS_TRUST_MINT_BAD_KEY
        jmp tlst_mi_refused;
      tlst_mi_bad_label:
        mov rax, 0xFFFFEB24;             // TLS_TRUST_MINT_BAD_LABEL

      tlst_mi_refused:
        // Shared refusal funnel: every mint failure branch lands here
        // exactly once. rax (the sentinel) is preserved across the
        // bump call since tls_trust_note only reads rdi.
        push rax;
        mov rdi, 2;                      // TLS_TRUST_ST_REFUSED
        call tls_trust_note;
        pop rax;

      tlst_mi_out:
        add rsp, 8;
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
