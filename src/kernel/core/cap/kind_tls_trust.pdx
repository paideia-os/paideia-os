// src/kernel/core/cap/kind_tls_trust.pdx -- R100-PREP-001 (#2007)
//
// KIND_TLS_TRUST = 0x1A7, derived over KIND_MEMORY (= slot 4 =
// KIND_PAGE).
//
// The runtime authority for ONE pinned TLS trust anchor -- a raw
// public key + algorithm tag + optional 16-byte label -- consumed by
// pdxcurl once per invocation at TLS 1.3 handshake setup to validate
// the server's transcript signature. Design authorities:
// design/networking/pdxcurl-design.md §"KIND_TLS_TRUST" and
// design/networking/r100-user-tools-plan.md §12.3. Ordinal declaration
// and derivation rationale live in cap/kind.pdx (the KIND_TLS_TRUST_
// BASE / KIND_TLS_TRUST block immediately after KIND_SIG_KEY there);
// this file registers the row substrate + mint gate + row accessors.
// The op-dispatch handler lives in cap/cap_handler_tls_trust.pdx and
// the cap_invoke_dispatch branch (`cmp rcx, 0x1A7; je call_kind_
// tls_trust`) is added in cap/invoke.pdx alongside the KIND_TUI_CANVAS
// (0x1A6) arm immediately above it.
//
// =============================================================================
// SECTION 0  WHY KIND_TLS_TRUST DERIVES OVER KIND_MEMORY
// =============================================================================
//
// The trust anchor is not a refinement of some narrower derived
// authority; pdxtrust (the minter, parent plan §8) reads a .pubkey
// file into an ordinary memory region, then asks the kernel to package
// that region as a read-only trust-anchor handle. Same posture as
// KIND_SIG_KEY (kind_sig_key.pdx §0) and KIND_PDXFS_MOUNT_TABLE
// (kind_pdxfs_mount_table.pdx §0): the memory-derived rule is the KIND_
// VOLUME rule verbatim -- parent.kind == KIND_MEMORY (4) AND rights
// carry RIGHT_MINT (0x200).
//
// =============================================================================
// SECTION 1  TAIL ENCODING
// =============================================================================
//
// Row layout (64 bytes, eight u64 words; parent plan §12.3's "raw
// public key + algorithm tag + label (~64 bytes)" resolves to):
//
//   [+0]   header:  in_use[63:56] | algo[7:0] | reserved[55:8]
//   [+8]   key_material_w0 (u64) -- key bytes  [0..8)
//   [+16]  key_material_w1 (u64) -- key bytes  [8..16)
//   [+24]  key_material_w2 (u64) -- key bytes [16..24)
//   [+32]  key_material_w3 (u64) -- key bytes [24..32)
//   [+40]  label_w0        (u64) -- label bytes [0..8)
//   [+48]  label_w1        (u64) -- label bytes [8..16)
//   [+56]  reserved        (u64) -- zeroed at alloc
//
// algo (1 = Ed25519 at this landing; other values reserved for future
// PQ signature algorithms per pdxcurl-design.md §"Signature algorithm")
// packs into bits [7:0] of the header word, matching KIND_SIG_KEY's
// key_type discipline. UNLIKE KIND_SIG_KEY the key material is INLINE
// -- pdxcurl reads it once per session and never touches an out-of-
// line LBA -- so key_material_w0..w3 are direct tail_alloc args, not
// deferred setters. Ed25519 keys are exactly 32 bytes; a future
// algorithm with a longer public key would need either a distinct kind
// or an out-of-line pointer in the reserved word (parent plan §12.4
// notes ML-DSA-65 keys are ~1952 B, out-of-line by construction).
//
// label_w0..w1 carry an ASCII/UTF-8 label (typically a hostname like
// "example.com\0" or a hex-truncated key fingerprint) NUL-padded to
// exactly 16 bytes. Purpose is diagnostic only (dmesg / dbg-print
// identity); no comparison operator gates the trust decision on the
// label. Callers who don't need a label pass a 16-byte zero region.
//
// Row-addressed capacity: 8 rows x 64 bytes = 512 bytes. Small
// working-set assumption -- pdxtrust catalogs are meant for a handful
// of ~1-10 trust anchors per system, not a global CA store. A future
// landing that needs more resizes _tls_trust_table here and updates
// TLS_TRUST_MAX; the ec_confine_one gate on _tls_trust_table +
// _tls_trust_stats catches any cross-module write drift.
//
// =============================================================================
// SECTION 2  RIGHTS  --  R_TLS_TRUST_READ (0x001) ONLY
// =============================================================================
//
//   R_TLS_TRUST_READ (0x001) -- gate every op in cap_handler_tls_trust
//
// No R_TLS_TRUST_WRITE, no R_TLS_TRUST_MINT, no R_TLS_TRUST_REVOKE.
// Per issue #2007's explicit contract: "no write/mint/revoke on
// already-minted cap. Trust anchors are immutable once minted." The
// "update a trust anchor" workflow is "remove, then re-import" at the
// pdxtrust CLI layer (parent plan §8.1). The kernel-side mint gate
// (kind_tls_trust_mint_body below) is exercised by the loader /
// pdxtrust / supervisor path only; it is NOT reachable via cap_invoke.
// A supervisor-only revoke primitive for boot teardown is deferred to
// a future landing (kind_pdxfs_mount_table.pdx follows the same
// pattern of not exposing revoke through cap_invoke).
//
// R_TLS_TRUST_ALL = R_TLS_TRUST_READ = 0x001. Subset test in
// tls_trust_rights_valid uses that constant.
//
// =============================================================================
// SECTION 3  FAILURE TAXONOMY  0xFFFFEB20..0xFFFFEB27
// =============================================================================
//
// A repo-wide audit at landing time (grep -rEho '0xFFFFE[A-F0-9]{3}'
// under src/kernel/) shows the 0xFFFFEB20..0xFFFFEB2F page is entirely
// free. This file claims 0xFFFFEB20..0xFFFFEB27 (8 codes, immediately
// after KIND_TUI_CANVAS's 0xFFFFEB10..0xFFFFEB1F band); 0xFFFFEB28..
// 0xFFFFEB2F stays reserved for whichever future R100 kind claims the
// next slot. Disjoint from KIND_SIG_KEY's 0xFFFFEB00..0xFFFFEB0F and
// from every KIND_TCP_* / KIND_INODE_HANDLE / KIND_VOLUME band.
//
// =============================================================================
// SECTION 4  paideia-as encoder-gap posture
// =============================================================================
//
// Kind-tag constant 0x1A7 (KIND_TLS_TRUST) sits in the same 0x100..
// 0xFFF band as KIND_SIG_KEY (0x1A3) and KIND_TUI_CANVAS (0x1A6); it
// does not sign-extend cleanly from a 32-bit immediate for `cmp reg,
// imm` forms, so every compare against it stages through r11 first
// (matching kind_sig_key.pdx §4 and kind_pdxfs_mount_table.pdx §4).
// KIND_MEMORY (4) needs no staging. No mov_b / mov_w / mov_d anywhere
// in this file -- every sub-field is packed / unpacked in full 64-bit
// registers via shift + mask. No `test` instruction; bit checks use
// `and` + `cmp`. No `add reg, [mem]` and no `cmp reg, [mem]` anywhere
// (every value is loaded into a register before any arithmetic or
// comparison). Every label in this file is prefixed `tlst_` (reserved-
// word discipline -- `loop`/`if` etc. are keywords).
//
// =============================================================================
// SECTION 5  ARITY -- MINT SIGNATURE
// =============================================================================
//
// kind_tls_trust_mint_body(parent_slot, algo, key_ptr, label_ptr) --
// four args, well under the SysV register cap. The key material and
// label are passed as pointers into caller memory rather than as eight
// packed u64 values, both because (a) that fits the 6-arg SysV budget
// with room to spare, and (b) callers already have the .pubkey buffer
// laid out contiguously (pdxtrust reads it in one gulp; the boot
// witness in r100_tls_trust.pdx declares it as a static .bss buffer).
// tail_alloc dereferences those pointers exactly once each and copies
// the four+two words into the row before publishing in_use. Rights on
// the minted cap are R_TLS_TRUST_READ; the caller does NOT pass a
// rights arg -- immutability makes any subset choice meaningless.

module KindTlsTrust = structure {

  pub let KIND_TLS_TRUST      : u64 = 0x1A7
  pub let KIND_TLS_TRUST_BASE : u64 = 4       // = KIND_MEMORY (LAM-hint slot)

  pub let R_TLS_TRUST_READ    : u64 = 0x001
  pub let R_TLS_TRUST_ALL     : u64 = 0x001

  // Algorithm tags (§1). Only 1 (Ed25519) accepted at this landing;
  // 0 is the invalid sentinel same posture as KIND_SIG_KEY's key_type.
  pub let TLS_TRUST_ALGO_ED25519 : u64 = 1
  pub let TLS_TRUST_ALGO_MAX     : u64 = 1

  // Ops (design authority §"Ops"). All eight require R_TLS_TRUST_READ;
  // there is no R_TLS_TRUST_INVOKE / _OBSERVE (§2). READ (0) is the
  // liveness probe -- returns 1 iff the row is live -- and every other
  // op decodes one word of the row.
  pub let TLS_TRUST_OP_READ          : u64 = 0
  pub let TLS_TRUST_OP_QUERY_ALGO    : u64 = 1
  pub let TLS_TRUST_OP_QUERY_KEY_W0  : u64 = 2
  pub let TLS_TRUST_OP_QUERY_KEY_W1  : u64 = 3
  pub let TLS_TRUST_OP_QUERY_KEY_W2  : u64 = 4
  pub let TLS_TRUST_OP_QUERY_KEY_W3  : u64 = 5
  pub let TLS_TRUST_OP_QUERY_LABEL_W0 : u64 = 6
  pub let TLS_TRUST_OP_QUERY_LABEL_W1 : u64 = 7
  pub let TLS_TRUST_OP_MAX           : u64 = 7

  // Failure taxonomy. 0xFFFFEB20..0xFFFFEB27 band (see §3).
  pub let TLS_TRUST_OK              : u64 = 0
  pub let TLS_TRUST_MINT_BAD_PARENT : u64 = 0xFFFFEB27
  pub let TLS_TRUST_MINT_BAD_ALGO   : u64 = 0xFFFFEB26
  pub let TLS_TRUST_MINT_BAD_KEY    : u64 = 0xFFFFEB25
  pub let TLS_TRUST_MINT_BAD_LABEL  : u64 = 0xFFFFEB24
  pub let TLS_TRUST_TAIL_BAD_ARG    : u64 = 0xFFFFEB23
  pub let TLS_TRUST_TAIL_ENOSPC     : u64 = 0xFFFFEB22
  pub let TLS_TRUST_BAD_SLOT        : u64 = 0xFFFFEB21
  pub let TLS_TRUST_BAD_RIGHTS      : u64 = 0xFFFFEB20

  pub let TLS_TRUST_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let TLS_TRUST_ROW_NONE   : u64 = 0xFF

  // Ceilings.
  pub let TLS_TRUST_MAX       : u64 = 8
  pub let TLS_TRUST_ROW_BYTES : u64 = 64
  // 8 rows * 64 bytes = 512 bytes = 64 u64.
  pub let mut _tls_trust_table : [u64; 64] = uninit @align(64)
  pub let mut _tls_trust_stats : [u64; 8]  = uninit @align(64)

  pub let TLS_TRUST_ST_MINTS   : u64 = 0
  pub let TLS_TRUST_ST_QUERIES : u64 = 1
  pub let TLS_TRUST_ST_REFUSED : u64 = 2
  pub let TLS_TRUST_ST_MAX     : u64 = 8

  // Fingerprint (emitted once on successful mint, matching the
  // KIND_SIG_KEY / KIND_TUI_CANVAS mint-ok discipline; no fingerprint
  // on read/query ops since those are the hot path).
  pub let tls_trust_mint_ok_msg : [u8; 46] = "tls trust mint ok [legacy: TLS TRUST MINT OK]\0"
  pub let tls_trust_k_row       : [u8; 4]  = "row\0"

  // ==========================================================================
  // tls_trust_table_reset() -> ()
  //
  // Clear every row and every counter. Boot and teardown only. Two
  // separate loops mirror kind_sig_key.pdx / kind_pdxfs_mount_table.pdx
  // one-for-one.
  // ==========================================================================
  pub let tls_trust_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R100-PREP-001 (#2007): clear every _tls_trust_table row and every _tls_trust_stats counter. Boot and teardown only. .bss is already zero at real boot; this is defensive (matches KIND_SIG_KEY sig_key_table_reset / KIND_TUI_CANVAS kind_tui_canvas_init shape) and gives a future witness a clean re-scrub point. Labels prefixed tlst_rs_.",
      block: {
        lea r10, [rip + _tls_trust_table];
        xor rax, rax;
        xor rcx, rcx;
      tlst_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 64;
        jb  tlst_rs_rows;

        lea r10, [rip + _tls_trust_stats];
        xor rcx, rcx;
      tlst_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  tlst_rs_stats;
        ret
      }
    }

  pub let tls_trust_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R100-PREP-001 (#2007): bounded increment on _tls_trust_stats; out-of-range no-op. Load-inc-store idiom, no `add reg, [mem]`. Labels prefixed tlst_nt_.",
      block: {
        cmp rdi, 8;
        jae tlst_nt_out;
        lea r10, [rip + _tls_trust_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      tlst_nt_out:
        ret
      }
    }

  pub let tls_trust_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R100-PREP-001 (#2007): bounded read of _tls_trust_stats; out-of-range returns 0. Labels prefixed tlst_st_.",
      block: {
        cmp rdi, 8;
        jae tlst_st_zero;
        lea r10, [rip + _tls_trust_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      tlst_st_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Validators.
  // ==========================================================================

  // tls_trust_algo_valid(algo) -> 1 iff algo in [1, TLS_TRUST_ALGO_MAX].
  // 0 is the invalid sentinel (§1), matching KIND_SIG_KEY's key_type
  // discipline. Only 1 (Ed25519) is accepted at this landing.
  pub let tls_trust_algo_valid : (u64) -> u64 !{} @{} =
    fn (algo: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R100-PREP-001 (#2007): 1 iff algo in [1, TLS_TRUST_ALGO_MAX=1]. 0 refused per §1's invalid-sentinel discipline (mirrors sig_key_hdr_pack's key_type == 0 refusal). Labels prefixed tlst_av_.",
      block: {
        cmp rdi, 1;
        jb  tlst_av_no;
        cmp rdi, 1;                      // TLS_TRUST_ALGO_MAX
        ja  tlst_av_no;
        mov rax, 1;
        ret;
      tlst_av_no:
        xor rax, rax;
        ret
      }
    }

  // tls_trust_rights_valid(rights) -> 1 iff subset of R_TLS_TRUST_ALL.
  pub let tls_trust_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R100-PREP-001 (#2007): subset test against R_TLS_TRUST_ALL = 0x001. Immutability (§2) means the only sensible rights value is R_TLS_TRUST_READ itself; anything else is a caller bug. Labels prefixed tlst_rv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x001;                  // R_TLS_TRUST_ALL
        and rax, r10;
        cmp rax, rdi;
        jne tlst_rv_no;
        mov rax, 1;
        ret;
      tlst_rv_no:
        xor rax, rax;
        ret
      }
    }

  // tls_trust_check_parent_memory(parent_slot) -> 1 iff
  // cap_table[parent_slot].kind == KIND_MEMORY (4) AND rights carry
  // RIGHT_MINT (0x200). Mirrors sig_key_check_parent_memory /
  // pmt_check_parent_memory one-for-one.
  pub let tls_trust_check_parent_memory : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R100-PREP-001 (#2007): derivation gate. Bounds-check parent_slot < 256; descriptor at cap_table + slot*24 (stride 24 per cap/mint.pdx); require kind ([+0]) == KIND_MEMORY (4) AND (rights & RIGHT_MINT 0x200) != 0. Mirrors kind_sig_key.pdx sig_key_check_parent_memory / kind_pdxfs_mount_table.pdx pmt_check_parent_memory one-for-one. Pure read (@{cap} because it inspects cap_table). Labels prefixed tlst_cpm_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae tlst_cpm_no;

        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 4;                      // KIND_MEMORY
        jne tlst_cpm_no;

        mov r10, [rax + 8];
        mov r11, 0x200;                  // RIGHT_MINT
        and r10, r11;
        cmp r10, 0;
        je  tlst_cpm_no;

        mov rax, 1;
        ret;

      tlst_cpm_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Packers.
  // ==========================================================================

  // tls_trust_hdr_pack(algo) -> hdr | TLS_TRUST_DECODE_BAD
  //
  // algo packs into bits [7:0]. 0 refused per §1. Bits [63:56] MUST
  // leave this function zero -- that byte belongs to the allocator's
  // in_use flag (set by tail_alloc on the claim path).
  pub let tls_trust_hdr_pack : (u64) -> u64 !{} @{} =
    fn (algo: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R100-PREP-001 (#2007): canonical header encoder. algo fits [7:0] and must be non-zero (0 is the invalid sentinel; 1 = Ed25519 at this landing). Bits [63:56] left zero for the allocator's in_use flag. Mirrors sig_key_hdr_pack one-for-one. Labels prefixed tlst_hp_.",
      block: {
        cmp rdi, 0;
        je  tlst_hp_bad;

        mov r10, 0xFF;
        cmp rdi, r10;
        ja  tlst_hp_bad;

        mov rax, rdi;                    // algo in [7:0]
        ret;

      tlst_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // Row pool: slot / row_valid / tail_alloc / tail_free.
  // ==========================================================================

  // tls_trust_row_slot(idx) -> &_tls_trust_table[idx*64]. No bounds
  // check by policy -- mirrors tui_canvas_slot exactly (caller
  // validates idx first).
  pub let tls_trust_row_slot : (u64) -> u64 !{} @{} =
    fn (idx: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R100-PREP-001 (#2007): &_tls_trust_table[idx*64]. SIB scale limited to 1/2/4/8 so *64 is shl 6 + add. No bounds check by policy, mirrors kind_tui_canvas.pdx tui_canvas_slot. Labels prefixed tlst_rs_.",
      block: {
        lea rax, [rip + _tls_trust_table];
        shl rdi, 6;
        add rax, rdi;
        ret
      }
    }

  // tls_trust_row_valid(idx) -> 1 iff idx < TLS_TRUST_MAX and the
  // row's in_use byte is set.
  pub let tls_trust_row_valid : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R100-PREP-001 (#2007): 1 iff idx < TLS_TRUST_MAX(8) and in_use byte set. Inlined address compute (idx*64 via shl 6) rather than a nested call to tls_trust_row_slot, keeping this a pure leaf -- mirrors tui_canvas_row_valid / sig_key_tail_valid. Labels prefixed tlst_rv2_.",
      block: {
        mov r10, 8;
        cmp rdi, r10;
        jae tlst_rv2_no;
        lea r10, [rip + _tls_trust_table];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  tlst_rv2_no;
        mov rax, 1;
        ret;
      tlst_rv2_no:
        xor rax, rax;
        ret
      }
    }

  // tls_trust_tail_alloc(hdr, key_ptr, label_ptr) -> row_id | TLS_TRUST_TAIL_*
  //
  // THE ONLY WRITER of _tls_trust_table on the allocate path. Low-first
  // scan over 8 rows of 64 bytes. Copies four u64 from [key_ptr..+32)
  // into the row's key_material_w0..w3 words and two u64 from
  // [label_ptr..+16) into label_w0..w1. hdr in_use pre-set is a bug ->
  // TLS_TRUST_TAIL_BAD_ARG (mirrors sig_key_tail_alloc's own gate).
  // algo byte zero -> TLS_TRUST_TAIL_BAD_ARG (same discipline).
  //
  // Register plan: rbx=hdr, r12=key_ptr, r13=label_ptr, r14=row cursor,
  // r15=row_id. Five callee-save pushes leave rsp%16 == 0 for no nested
  // call (this is a straight-line leaf) but the saves are still useful
  // for register liveness across the internal scan loop. On success,
  // returns row_id in rax; on failure returns one of the TLS_TRUST_
  // TAIL_* sentinels above (0xFFFFEB22/0xFFFFEB23).
  pub let tls_trust_tail_alloc : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (key_ptr: u64) (label_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R100-PREP-001 (#2007): claim one TLS-trust row. THE ONLY WRITER of _tls_trust_table on the allocate path; tools/build.sh confines it via ec_confine_one. Gates: hdr in_use pre-set -> TLS_TRUST_TAIL_BAD_ARG (bug: caller must pass a fresh header); algo byte (hdr[7:0]) zero -> TLS_TRUST_TAIL_BAD_ARG. Low-first scan over 8 rows of 64 bytes (idx*64 via shl 6). On claim, copies four u64 from key_ptr into row+8..+32 (32-byte public key inline, §1) and two u64 from label_ptr into row+40..+48 (16-byte label). Zeros the reserved word at row+56. Publishes in_use=1 in the header BYTE LAST via a single qword store combining hdr's algo byte with the in_use marker, matching sig_key_tail_alloc's ordering. Five callee-save pushes (rbx/r12-r15) preserve the loop-carried state across the internal scan; there are no nested calls, so no additional stack alignment padding is needed. Labels prefixed tlst_ta_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                    // hdr
        mov r12, rsi;                    // key_ptr
        mov r13, rdx;                    // label_ptr

        // hdr in_use pre-set?
        mov rax, rbx;
        shr rax, 56;
        cmp rax, 0;
        jne tlst_ta_bad;

        // algo byte zero?
        mov rax, rbx;
        mov r10, 0xFF;
        and rax, r10;
        cmp rax, 0;
        je  tlst_ta_bad;

        xor r14, r14;                    // row cursor idx = 0
      tlst_ta_scan:
        cmp r14, 8;                      // TLS_TRUST_MAX
        jae tlst_ta_enospc;

        lea r10, [rip + _tls_trust_table];
        mov r11, r14;
        shl r11, 6;                      // idx * 64
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  tlst_ta_claim;

        add r14, 1;
        jmp tlst_ta_scan;

      tlst_ta_claim:
        // Copy the four key words (32 bytes total): [r12..+32) -> [r10+8..+40).
        mov rax, [r12 + 0];
        mov [r10 + 8],  rax;
        mov rax, [r12 + 8];
        mov [r10 + 16], rax;
        mov rax, [r12 + 16];
        mov [r10 + 24], rax;
        mov rax, [r12 + 24];
        mov [r10 + 32], rax;

        // Copy the two label words (16 bytes total): [r13..+16) -> [r10+40..+56).
        mov rax, [r13 + 0];
        mov [r10 + 40], rax;
        mov rax, [r13 + 8];
        mov [r10 + 48], rax;

        // Reserved word.
        xor rax, rax;
        mov [r10 + 56], rax;

        // Header last: algo | in_use=1.
        mov rax, rbx;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0], rax;

        mov r15, r14;                    // row_id
        mov rax, r15;
        jmp tlst_ta_out;

      tlst_ta_enospc:
        mov rax, 0xFFFFEB22;             // TLS_TRUST_TAIL_ENOSPC
        jmp tlst_ta_out;
      tlst_ta_bad:
        mov rax, 0xFFFFEB23;             // TLS_TRUST_TAIL_BAD_ARG

      tlst_ta_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // tls_trust_tail_free(row_id) -> (). Scrub the whole 64-byte row.
  // Reserved for a future supervisor teardown path; not reachable via
  // cap_invoke per §2's immutability contract.
  pub let tls_trust_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R100-PREP-001 (#2007): scrub one row (all eight words). Reserved for future supervisor teardown only; §2's immutability contract means cap_invoke never reaches this. Labels prefixed tlst_tf_.",
      block: {
        mov r10, 8;
        cmp rdi, r10;
        jae tlst_tf_out;
        lea r10, [rip + _tls_trust_table];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        mov [r10 + 32], rax;
        mov [r10 + 40], rax;
        mov [r10 + 48], rax;
        mov [r10 + 56], rax;
      tlst_tf_out:
        ret
      }
    }

  // ==========================================================================
  // Row accessors. Each returns TLS_TRUST_DECODE_BAD when the row is
  // not live, matching kind_sig_key.pdx / kind_pdxfs_mount_table.pdx
  // discipline. These are the public surface cap_handler_tls_trust's
  // QUERY_* ops thread through.
  // ==========================================================================

  pub let tls_trust_row_algo : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R100-PREP-001 (#2007): algo (header bits [7:0]) or TLS_TRUST_DECODE_BAD. Labels prefixed tlst_ra_.",
      block: {
        push r12;
        mov r12, rdi;
        call tls_trust_row_valid;
        cmp rax, 0;
        je  tlst_ra_bad;
        lea r10, [rip + _tls_trust_table];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        mov r10, 0xFF;
        and rax, r10;
        jmp tlst_ra_out;
      tlst_ra_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      tlst_ra_out:
        pop r12;
        ret
      }
    }

  pub let tls_trust_row_key_w0 : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R100-PREP-001 (#2007): key_material_w0, or TLS_TRUST_DECODE_BAD. Labels prefixed tlst_rk0_.",
      block: {
        push r12;
        mov r12, rdi;
        call tls_trust_row_valid;
        cmp rax, 0;
        je  tlst_rk0_bad;
        lea r10, [rip + _tls_trust_table];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 8];
        jmp tlst_rk0_out;
      tlst_rk0_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      tlst_rk0_out:
        pop r12;
        ret
      }
    }

