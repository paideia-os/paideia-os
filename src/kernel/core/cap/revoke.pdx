// PaideiaOS Phase-2 Capability Revoke Operation
// P2-010: cap_revoke(handle) -> u64
//
// Per design/capabilities/linearity-and-tags.md §6:
// Revoke operation withdraws all rights from a capability and invalidates
// it for further use. The capability becomes a null capability (kind = KIND_NULL).
// Revocation is idempotent — revoking an already-revoked capability is safe.
//
// What the function does (R31.M1-1589):
// 1. Decode the handle to a slot: bits [7:0].
// 2. Delegate to cap_revoke_slot, which dispatches on the descriptor's
//    kind to that kind's own audited revoke, runs the lineage cascade
//    beneath it, and clears the slot's owner column.
// 3. Return the dispatcher's code verbatim.
//
// There is NO generation check at step 2, because there is no generation
// -- not in the descriptor and not in the handle. See the block comment
// above cap_revoke for what that means and what it would take to change.

module Revoke = structure {

  // ============================================================================
  // Result codes for cap_revoke()
  // ============================================================================

  let REVOKE_OK : u64 = 0                  // Revoke succeeded
  let REVOKE_INVALID_HANDLE : u64 = -1     // Handle decode/validation failed (bad LAM tag, out of bounds)
  let REVOKE_ALREADY_REVOKED : u64 = -2    // Descriptor already revoked (generation mismatch, slot empty)

  // ============================================================================
  // cap_revoke(handle: u64) -> u64
  // Revokes a capability by invalidating its descriptor.
  //
  // Implementation (R31.M1-1589, #1589):
  // 1. Decode handle to slot: bits [7:0]. There is NO generation in the
  //    handle to decode; see §Stale handles below.
  // 2. Delegate to cap_revoke_slot(slot), which dispatches on the
  //    descriptor's kind to that kind's own audited revoke -- running the
  //    LINEAGE cascade -- and clears the slot's owner column.
  //
  // ---------------------------------------------------------------------
  // WHAT THE TWO TODOs HERE USED TO SAY, AND WHY THEY ARE GONE
  // ---------------------------------------------------------------------
  //
  // Step 3 read "TODO: fetch descriptor, increment generation (wrapping
  // within 4-bit), write back" and step 4 read "TODO: call slab_free(slot)".
  //
  // THERE IS NO generation FIELD. cap_table is 256 x 3 u64s at stride 24,
  // and `generation` -- which struct Capability declared until #1589 --
  // sat at struct offset +24, which in a stride-24 table is THE NEXT
  // DESCRIPTOR'S kind. A contributor following that instruction would
  // have silently retyped the adjacent capability, and since `kind` is
  // the first thing every gate checks, the symptom would have appeared
  // arbitrarily far from the cause. The instruction to step on the mine
  // was written down in the same tree as the mine.
  //
  // ---------------------------------------------------------------------
  // STALE HANDLES ARE NOT DEFENDED, AND THAT IS RECORDED RATHER THAN
  // IMPLIED
  // ---------------------------------------------------------------------
  //
  // Dropping the phantom generation removes a defence that was never
  // there to begin with, but it also removes the impression that one
  // was. A handle whose slot has been revoked and re-minted resolves to
  // the NEW capability, and the only thing between a caller and the
  // wrong object is the kind check every gate performs -- which catches
  // a re-mint to a different kind and does not catch a re-mint to the
  // same one.
  //
  // Restoring a generation defence means changing the HANDLE LAYOUT
  // (design/capabilities/handle-layout.md), not adding a table column: a
  // "handle" today is bits [7:0] and has nowhere to put a generation.
  // The five derived kinds are not exposed to this, because they take a
  // SLOT and re-derive their row from the descriptor on every call, so a
  // stale slot fails the kind check or the *_tail_valid row check.
  //
  // See design/capabilities/ownership-and-lineage.md §4.1.
  // ============================================================================

  // R12-m5-001 note: rewritten from pure-fn if-else to unsafe block per
  // paideia-as #913.
  // R31.M1-1589 note: the placeholder body -- which bounds-checked and
  // returned REVOKE_OK WITHOUT TOUCHING THE DESCRIPTOR, so a caller could
  // not distinguish "revoked" from "did nothing" -- now delegates to a
  // real per-slot dispatcher.
  pub let cap_revoke : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (h : u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R31.M1-1589 (#1589): the generic handle-based revoke gains a real body. slot = h & 0xFF, which is the whole of the current handle layout -- the mask is preserved rather than widened because widening it here without widening design/capabilities/handle-layout.md would make two documents disagree about what a handle is. The bounds check against 256 is kept even though a byte cannot exceed 255: it is what makes the function's own contract independent of the mask above it, so a future handle layout that widens the field does not silently gain an out-of-range path. Delegation to cap_revoke_slot is what makes 'revoked' distinguishable from 'did nothing' for the first time -- the previous body returned REVOKE_OK without touching the descriptor, and its own justification said so. Return codes are cap_revoke_slot's, not this module's REVOKE_*: collapsing CAP_OWNER_ALREADY and the per-kind WRONG_KIND into REVOKE_OK would discard exactly the discrimination a caller revoking a handle it may not own needs. Effects widened from {} to {mem, sysreg} @{cap} -- the union of the callee's -- which is the honest consequence of the body no longer being a no-op. One push keeps rsp%16 == 0 at the nested call. Reserved labels: revoke_.",
      block: {
        push r12;                        // alignment only: rsp%16 == 0 at the call
        // slot = h & 0xFF
        mov rax, rdi;
        and rax, 0xFF;
        // if slot >= 256, return REVOKE_INVALID_HANDLE
        cmp rax, 256;
        jae revoke_bad;
        mov rdi, rax;
        call cap_revoke_slot;
        pop r12;
        ret;
        revoke_bad:
          // REVOKE_INVALID_HANDLE = 0xFFFFFFFFFFFFFFFF
          mov rax, 0xFFFFFFFFFFFFFFFF;
          pop r12;
          ret
      }
    }

}
