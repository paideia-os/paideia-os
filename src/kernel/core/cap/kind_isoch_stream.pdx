// src/kernel/core/cap/kind_isoch_stream.pdx — R34.M5-001 (#1186)
//
// KIND_ISOCH_STREAM = 0x169, derived over KIND_USB_ENDPOINT (0x165).
//
// The authority to hold ONE outstanding USB isochronous stream — its
// inherited stream_key (a fresh identity supplied by the driver at
// stream-open time), the cap_table slot of the KIND_USB_ENDPOINT
// through which its packets flow (endpoint_slot, u32 for future
// index-widening headroom), its service_interval (bInterval per USB
// 2.0 §9.6.6), its bandwidth_reservation (bytes per (micro)frame),
// and its direction (IN/OUT).
//
// =============================================================================
// §0  WHY THIS KIND EXISTS
// =============================================================================
//
// An INTERFACE is one function; a USB ENDPOINT is one transfer pipe
// (KIND_USB_ENDPOINT, R34.M2 #1175); an ISOCH STREAM is one
// scheduled ISOCHRONOUS pipe. Isochronous transfers reserve bus
// bandwidth up front — the scheduler must know per-service-interval
// how many bytes a stream will consume, or a second stream squeezed
// into an already-oversubscribed frame will drop packets with no
// error path a caller can see. So the CAPABILITY at which
// isochronous stream authority is gated is separate from the endpoint
// authority that any transfer type shares.
//
// =============================================================================
// §1  DERIVATION OVER KIND_USB_ENDPOINT
// =============================================================================
//
// The gate demands `kind == KIND_USB_ENDPOINT (0x165)` carrying
// `RIGHT_MINT`. This half is NOT empty on its own — KIND_USB_ENDPOINT
// (unlike KIND_IPC_ENDPOINT) has a validated ep_type — so a mint that
// stopped at the kind check would still permit an isoch stream to be
// bolted onto a bulk or interrupt endpoint. The mint additionally
// requires:
//
//   (a) stream_key non-zero and unique among live rows (NO_KEY / IN_USE)
//   (b) endpoint_slot names a live KIND_USB_ENDPOINT with RIGHT_MINT
//       (BAD_ENDPOINT — the ep_type check that this row's ISOCH
//       reservation is being placed against an ISOCH endpoint is
//       DEFERRED to R34.M5-003 #1188 when the scheduler wires this
//       row into the ring; recording it early would take an untrusted
//       ep_type argument here rather than reading it from the endpoint
//       row).
//   (c) service_interval in [1, 255] (BAD_INTERVAL — bInterval == 0
//       is not encodable for a scheduled endpoint)
//   (d) bandwidth_reservation <= 3072 (BAD_BANDWIDTH — HS ISOCH cap
//       is 3 × 1024-byte transactions per microframe per USB 2.0
//       §5.9)
//   (e) direction in [0, 1] (BAD_DIRECTION)
//   (f) rights subset of R_ISOCH_STREAM_ALL (BAD_RIGHTS)
//
// =============================================================================
// §2  STATIC IDENTITY IS AT MINT, DYNAMIC STATE IS ABSENT
// =============================================================================
//
// stream_key, endpoint_slot, service_interval, bandwidth_reservation
// and direction are ROW IDENTITY. There is NO packet-counter, delivery
// timestamp or in-flight state on this row — those belong to the
// scheduler (drivers/usb/xhci/isoch_ring.pdx, R34.M5-003 #1188) and
// to the endpoint's own bookkeeping. A row whose bandwidth_reservation
// could be re-stamped in place would let the scheduler admit a stream
// whose reservation the arbiter never approved.
//
// =============================================================================
// §3  LEAF OF THE ISOCH LATTICE
// =============================================================================
//
// R_ISOCH_STREAM_MINT (0x200) is DELIBERATELY ABSENT from
// R_ISOCH_STREAM_ALL: nothing derives from an isoch-stream cap. A
// stream is a completion / reservation handle, not a mint parent.
// Same discipline KIND_USB_ENDPOINT / KIND_USB_URB / KIND_HID_EVENT
// applied for the same reason.
//
// =============================================================================
// §4  FAILURE TAXONOMY 0xFFFFFAC0..0xFFFFFACF
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent bands: SOF timeline 0xFFFFFAB0..BF,
// isoch_ring 0xFFFFFAA0..AF, uvc_synth 0xFFFFFA90..9F, composite_hid
// 0xFFFFFAD0..DF, gamepad 0xFFFFFAE0..EF).

module KindIsochStream = structure {

  pub let KIND_ISOCH_STREAM         : u64 = 0x169
  pub let ISOCH_STREAM_PARENT_KIND  : u64 = 0x165    // = KIND_USB_ENDPOINT

  // §1 bounds.
  pub let ISOCH_INTERVAL_MIN     : u64 = 1
  pub let ISOCH_INTERVAL_MAX     : u64 = 255
  pub let ISOCH_BANDWIDTH_MAX    : u64 = 3072       // HS: 3 × 1024 B/µframe
  pub let ISOCH_DIR_MIN          : u64 = 0
  pub let ISOCH_DIR_MAX          : u64 = 1

  pub let ISOCH_DIR_OUT : u64 = 0
  pub let ISOCH_DIR_IN  : u64 = 1

  // Rights. Leaf: RIGHT_MINT NOT in the mask (§3).
  pub let R_ISOCH_STREAM_READ    : u64 = 0x001
  pub let R_ISOCH_STREAM_INVOKE  : u64 = 0x008
  pub let R_ISOCH_STREAM_REVOKE  : u64 = 0x010
  pub let R_ISOCH_STREAM_OBSERVE : u64 = 0x400
  pub let R_ISOCH_STREAM_ALL     : u64 = 0x419

  // Ops.
  pub let ISOCH_OP_QUERY_KEY       : u64 = 0
  pub let ISOCH_OP_QUERY_ENDPOINT  : u64 = 1
  pub let ISOCH_OP_QUERY_INTERVAL  : u64 = 2
  pub let ISOCH_OP_QUERY_BANDWIDTH : u64 = 3
  pub let ISOCH_OP_QUERY_DIRECTION : u64 = 4
  pub let ISOCH_OP_QUERY_PARENT    : u64 = 5
  pub let ISOCH_OP_DEBUG_PRINT     : u64 = 6
  pub let ISOCH_OP_MAX             : u64 = 6

  // Failure taxonomy — 0xFFFFFAC0..0xFFFFFACF.
  pub let ISOCH_OK                  : u64 = 0
  pub let ISOCH_TAIL_ENOSPC         : u64 = 0xFFFFFACF
  pub let ISOCH_TAIL_BAD_ARG        : u64 = 0xFFFFFACE
  pub let ISOCH_MINT_BAD_PARENT     : u64 = 0xFFFFFACD
  pub let ISOCH_MINT_BAD_RIGHTS     : u64 = 0xFFFFFACC
  pub let ISOCH_MINT_BAD_ENDPOINT   : u64 = 0xFFFFFACB
  pub let ISOCH_MINT_BAD_INTERVAL   : u64 = 0xFFFFFACA
  pub let ISOCH_MINT_BAD_BANDWIDTH  : u64 = 0xFFFFFAC9
  pub let ISOCH_MINT_BAD_DIRECTION  : u64 = 0xFFFFFAC8
  pub let ISOCH_MINT_NO_KEY         : u64 = 0xFFFFFAC7
  pub let ISOCH_MINT_ENOSPC         : u64 = 0xFFFFFAC6
  pub let ISOCH_MINT_IN_USE         : u64 = 0xFFFFFAC5
  pub let ISOCH_BAD_SLOT            : u64 = 0xFFFFFAC4
  pub let ISOCH_WRONG_KIND          : u64 = 0xFFFFFAC3
  pub let ISOCH_REVOKE_ALREADY      : u64 = 0xFFFFFAC2

  pub let ISOCH_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let ISOCH_ROW_NONE   : u64 = 0xFF

  // 16 rows × 32-byte stride.
  //   [+0]  header (in_use[63:56] | parent_slot[15:8])
  //   [+8]  stream_key
  //   [+16] body: endpoint_slot[31:0] | service_interval[39:32]
  //               | bandwidth_reservation[55:40] | direction[63:56]
  //   [+24] reserved
  pub let ISOCH_MAX       : u64 = 16
  pub let ISOCH_ROW_BYTES : u64 = 32

  pub let mut _isoch_stream_table : [u64; 64] = uninit @align(64)
  pub let mut _isoch_stream_stats : [u64; 4]  = uninit @align(64)

  pub let ISOCH_ST_MINTS   : u64 = 0
  pub let ISOCH_ST_REVOKES : u64 = 1
  pub let ISOCH_ST_IN_USE  : u64 = 2
  pub let ISOCH_ST_ENOSPC  : u64 = 3

  pub let isoch_dbg_msg : [u8; 17] = "ISOCH STREAM ROW\0"

  // ==========================================================================
  // Table reset.
  // ==========================================================================

  pub let isoch_stream_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M5-001 (#1186): clear the ISOCH stream row table and its counters. Boot and teardown only. Labels prefixed isoch_rs_.",
      block: {
        lea r10, [rip + _isoch_stream_table];
        xor rax, rax;
        xor rcx, rcx;
      isoch_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 64;
        jb  isoch_rs_rows;

        lea r10, [rip + _isoch_stream_stats];
        xor rcx, rcx;
      isoch_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  isoch_rs_stats;
        ret
      }
    }

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let isoch_stream_interval_valid : (u64) -> u64 !{} @{} =
    fn (i: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M5-001 (#1186): 1 iff i in [1, 255]. Labels prefixed isoch_iv_.",
      block: {
        cmp rdi, 1;
        jb  isoch_iv_no;
        cmp rdi, 255;
        ja  isoch_iv_no;
        mov rax, 1;
        ret;
      isoch_iv_no:
        xor rax, rax;
        ret
      }
    }

  pub let isoch_stream_bandwidth_valid : (u64) -> u64 !{} @{} =
    fn (b: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M5-001 (#1186): 1 iff b <= 3072 (HS ISOCH cap per USB 2.0 §5.9: 3 × 1024 B/µframe). Zero is admitted — a reserved-but-idle stream is a legitimate state. Labels prefixed isoch_bv_.",
      block: {
        cmp rdi, 3072;
        ja  isoch_bv_no;
        mov rax, 1;
        ret;
      isoch_bv_no:
        xor rax, rax;
        ret
      }
    }

  pub let isoch_stream_direction_valid : (u64) -> u64 !{} @{} =
    fn (d: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M5-001 (#1186): 1 iff d <= 1. Labels prefixed isoch_dv_.",
      block: {
        cmp rdi, 1;
        ja  isoch_dv_no;
        mov rax, 1;
        ret;
      isoch_dv_no:
        xor rax, rax;
        ret
      }
    }

  pub let isoch_stream_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M5-001 (#1186): subset test against R_ISOCH_STREAM_ALL = 0x419. RIGHT_MINT (0x200) is OUTSIDE the mask — this kind is a leaf (§3). Labels prefixed isoch_rv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x419;
        and rax, r10;
        cmp rax, rdi;
        jne isoch_rv_no;
        mov rax, 1;
        ret;
      isoch_rv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Counters.
  // ==========================================================================

  pub let isoch_stream_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M5-001 (#1186): counter bump. Labels prefixed isoch_nt_.",
      block: {
        cmp rdi, 4;
        jae isoch_nt_out;
        lea r10, [rip + _isoch_stream_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      isoch_nt_out:
        ret
      }
    }

  pub let isoch_stream_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M5-001 (#1186): counter read. Labels prefixed isoch_st_.",
      block: {
        cmp rdi, 4;
        jae isoch_st_zero;
        lea r10, [rip + _isoch_stream_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      isoch_st_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Parent gate: parent must be live KIND_USB_ENDPOINT with RIGHT_MINT.
  // ==========================================================================

  pub let isoch_stream_check_parent : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R34.M5-001 (#1186): §1 gate. parent must be live KIND_USB_ENDPOINT (0x165) with RIGHT_MINT. Unlike KIND_IPC_ENDPOINT-derived kinds this half discriminates — every KIND_USB_ENDPOINT has a validated ep_type — but the mint STILL enforces additional fields (§1 (b)-(e)) because the parent's ep_type is not audited here (R34.M5-003 pins it when the row is admitted to the ring). Labels prefixed isoch_cp_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae isoch_cp_no;

        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x165;                  // KIND_USB_ENDPOINT
        cmp r10, r11;
        jne isoch_cp_no;

        mov r10, [rax + 8];
        mov r11, 0x200;                  // RIGHT_MINT
        and r10, r11;
        cmp r10, 0;
        je  isoch_cp_no;

        mov rax, 1;
        ret;
      isoch_cp_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Endpoint gate: endpoint_slot must be live KIND_USB_ENDPOINT + RIGHT_MINT.
  //
  // Redundant with the parent gate when endpoint_slot == parent_slot,
  // deliberately kept SEPARATE because a future stream shape may
  // combine an IPC endpoint (as notification target) with a USB
  // endpoint (as transfer pipe), and the endpoint-side check must
  // then tighten independently from the parent side. Same shape as
  // usb_endpoint_check_interface (kind_usb_endpoint.pdx §1).
  // ==========================================================================

  pub let isoch_stream_check_endpoint : (u64) -> u64 !{mem} @{cap} =
    fn (endpoint_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R34.M5-001 (#1186): endpoint gate. endpoint_slot must be live KIND_USB_ENDPOINT (0x165) with RIGHT_MINT. Held SEPARATE from parent gate for future extensibility (see block header). Labels prefixed isoch_ce_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae isoch_ce_no;

        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x165;                  // KIND_USB_ENDPOINT
        cmp r10, r11;
        jne isoch_ce_no;

        mov r10, [rax + 8];
        mov r11, 0x200;                  // RIGHT_MINT
        and r10, r11;
        cmp r10, 0;
        je  isoch_ce_no;

        mov rax, 1;
        ret;
      isoch_ce_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Header pack.
  // ==========================================================================

  pub let isoch_stream_hdr_pack : (u64) -> u64 !{} @{} =
    fn (parent_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M5-001 (#1186): (parent_slot << 8). Labels prefixed isoch_hp_.",
      block: {
        mov r10, 256;
        cmp rdi, r10;
        jae isoch_hp_bad;
        mov rax, rdi;
        shl rax, 8;
        ret;
      isoch_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let isoch_stream_body_pack : (u64, u64, u64, u64) -> u64 !{} @{} =
    fn (endpoint_slot: u64) (service_interval: u64) (bandwidth_reservation: u64) (direction: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M5-001 (#1186): pack endpoint_slot[31:0] | service_interval[39:32] | bandwidth_reservation[55:40] | direction[63:56]. Refuses out-of-range fields. Labels prefixed isoch_bp_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  isoch_bp_bad;
        cmp rsi, 1;
        jb  isoch_bp_bad;
        cmp rsi, 255;
        ja  isoch_bp_bad;
        cmp rdx, 3072;
        ja  isoch_bp_bad;
        cmp rcx, 1;
        ja  isoch_bp_bad;

        mov rax, rdi;
        and rax, 0xFFFFFFFF;
        mov r10, rsi;
        and r10, 0xFF;
        shl r10, 32;
        or  rax, r10;
        mov r10, rdx;
        and r10, 0xFFFF;
        shl r10, 40;
        or  rax, r10;
        mov r10, rcx;
        and r10, 0xFF;
        shl r10, 56;
        or  rax, r10;
        ret;
      isoch_bp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // Tail alloc/valid/free.
  //
  // THE ONE WRITER of _isoch_stream_table. tools/build.sh confines
  // relocations against `_isoch_stream_table` to this object.
  // ==========================================================================

  pub let isoch_stream_tail_alloc : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (stream_key: u64) (body_packed: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M5-001 (#1186): claim one ISOCH stream row. THE ONE WRITER of _isoch_stream_table. Gates: hdr in_use pre-set -> BAD_ARG; stream_key != 0 -> BAD_ARG; body_packed != DECODE_BAD -> BAD_ARG. Low-first free scan over 16 rows of 32 bytes. Labels prefixed isoch_ta_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov r12, rdi;                    // hdr
        mov r13, rsi;                    // stream_key
        mov r14, rdx;                    // body_packed

        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne isoch_ta_bad;

        cmp r13, 0;
        je  isoch_ta_bad;

        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp r14, r10;
        je  isoch_ta_bad;

        xor rbx, rbx;
      isoch_ta_scan:
        cmp rbx, 16;
        jae isoch_ta_enospc;

        lea r10, [rip + _isoch_stream_table];
        mov r11, rbx;
        shl r11, 5;
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  isoch_ta_claim;

        add rbx, 1;
        jmp isoch_ta_scan;

      isoch_ta_claim:
        mov rax, r12;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r13;
        mov [r10 + 16], r14;
        xor rax, rax;
        mov [r10 + 24], rax;
        mov rax, rbx;
        jmp isoch_ta_out;

      isoch_ta_enospc:
        mov rax, 0xFFFFFACF;
        jmp isoch_ta_out;
      isoch_ta_bad:
        mov rax, 0xFFFFFACE;

      isoch_ta_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let isoch_stream_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M5-001 (#1186): 1 iff row_id < ISOCH_MAX and in_use. Labels prefixed isoch_tv_.",
      block: {
        cmp rdi, 16;
        jae isoch_tv_no;
        lea r10, [rip + _isoch_stream_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  isoch_tv_no;
        mov rax, 1;
        ret;
      isoch_tv_no:
        xor rax, rax;
        ret
      }
    }

  pub let isoch_stream_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M5-001 (#1186): scrub one row. Labels prefixed isoch_tf_.",
      block: {
        cmp rdi, 16;
        jae isoch_tf_out;
        lea r10, [rip + _isoch_stream_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
      isoch_tf_out:
        ret
      }
    }

  // ==========================================================================
  // Row accessors.
  // ==========================================================================

  pub let isoch_stream_row_key : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M5-001 (#1186): stream_key. Labels prefixed isoch_rk_.",
      block: {
        push r12; push r13; push r14;
        mov r12, rdi;
        call isoch_stream_tail_valid;
        cmp rax, 0;
        je  isoch_rk_bad;
        lea r10, [rip + _isoch_stream_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 8];
        jmp isoch_rk_out;
      isoch_rk_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      isoch_rk_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  pub let isoch_stream_row_endpoint : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M5-001 (#1186): endpoint_slot. Labels prefixed isoch_re_.",
      block: {
        push r12; push r13; push r14;
        mov r12, rdi;
        call isoch_stream_tail_valid;
        cmp rax, 0;
        je  isoch_re_bad;
        lea r10, [rip + _isoch_stream_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        and rax, 0xFFFFFFFF;
        jmp isoch_re_out;
      isoch_re_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      isoch_re_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  pub let isoch_stream_row_interval : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M5-001 (#1186): service_interval. Labels prefixed isoch_ri_.",
      block: {
        push r12; push r13; push r14;
        mov r12, rdi;
        call isoch_stream_tail_valid;
        cmp rax, 0;
        je  isoch_ri_bad;
        lea r10, [rip + _isoch_stream_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 32;
        and rax, 0xFF;
        jmp isoch_ri_out;
      isoch_ri_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      isoch_ri_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  pub let isoch_stream_row_bandwidth : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M5-001 (#1186): bandwidth_reservation. Labels prefixed isoch_rb_.",
      block: {
        push r12; push r13; push r14;
        mov r12, rdi;
        call isoch_stream_tail_valid;
        cmp rax, 0;
        je  isoch_rb_bad;
        lea r10, [rip + _isoch_stream_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 40;
        and rax, 0xFFFF;
        jmp isoch_rb_out;
      isoch_rb_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      isoch_rb_out:
        pop r14; pop r13; pop r12;
