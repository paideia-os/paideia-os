  // ==========================================================================
  // Dispatch handler.
  // ==========================================================================

  pub let cap_handler_isoch_stream : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R34.M5-001 (#1186): KIND_ISOCH_STREAM dispatch. Queries INVOKE; DEBUG_PRINT OBSERVE. All ops arity ONE — op_arg[63:8] REFUSED. Labels prefixed isoch_hn_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov r12, rdi;                    // rights
        mov r13, rsi;
        mov r10, 0xFFFF;
        and r13, r10;                    // row_id
        mov r14, rdx;                    // op_arg

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_isoch_stream_msg];
        call klog_s1;

        mov r10, r14;
        and r10, 0xFF;
        mov rbp, r10;                    // op
        mov r11, r14;
        shr r11, 8;
        cmp r11, 0;
        jne isoch_hn_res;

        cmp rbp, 6;
        ja  isoch_hn_unsup;

        cmp rbp, 6;
        je  isoch_hn_dbg;

        // Ops 0..5: INVOKE.
        mov r10, r12;
        and r10, 0x008;
        cmp r10, 0;
        je  isoch_hn_denied;

        mov rdi, r13;
        cmp rbp, 0;
        je  isoch_hn_key;
        cmp rbp, 1;
        je  isoch_hn_ep;
        cmp rbp, 2;
        je  isoch_hn_int;
        cmp rbp, 3;
        je  isoch_hn_bw;
        cmp rbp, 4;
        je  isoch_hn_dir;
        call isoch_stream_row_parent;
        jmp isoch_hn_out;

      isoch_hn_key:
        call isoch_stream_row_key;
        jmp isoch_hn_out;
      isoch_hn_ep:
        call isoch_stream_row_endpoint;
        jmp isoch_hn_out;
      isoch_hn_int:
        call isoch_stream_row_interval;
        jmp isoch_hn_out;
      isoch_hn_bw:
        call isoch_stream_row_bandwidth;
        jmp isoch_hn_out;
      isoch_hn_dir:
        call isoch_stream_row_direction;
        jmp isoch_hn_out;

      isoch_hn_dbg:
        mov r10, r12;
        and r10, 0x400;
        cmp r10, 0;
        je  isoch_hn_denied;
        xor rax, rax;
        jmp isoch_hn_out;

      isoch_hn_res:
        mov rax, 0xFFFFFACE;
        jmp isoch_hn_out;
      isoch_hn_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;
        jmp isoch_hn_out;
      isoch_hn_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;

      isoch_hn_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
