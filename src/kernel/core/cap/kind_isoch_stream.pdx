  // ==========================================================================
  // Mint. Six args (slot, parent_slot, endpoint_slot, rights, stream_key,
  // packed_body). packed_body = interval[7:0] | bandwidth[23:8] |
  //                             direction[31:24] (24 live bits).
  // ==========================================================================

  pub let isoch_stream_cap_mint_inner : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) (parent_slot: u64) (endpoint_slot: u64) (rights: u64) (stream_key: u64) (packed_body: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R34.M5-001 (#1186): mint KIND_ISOCH_STREAM over KIND_USB_ENDPOINT. Six args (slot, parent, endpoint, rights, key, packed). packed = interval[7:0] | bandwidth[23:8] | direction[31:24]. Sequence: slot<256; check_parent; check_endpoint; rights_valid; unpack + validate interval/bandwidth/direction; stream_key non-zero (NO_KEY); uniqueness (IN_USE); hdr_pack; body_pack (with endpoint_slot); tail_alloc; cap_mint_write. Labels prefixed isoch_mi_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov rbx, rdi;                    // slot
        mov r12, rsi;                    // parent_slot
        mov r13, rdx;                    // endpoint_slot
        mov r14, rcx;                    // rights
        mov r15, r8;                     // stream_key
        mov rbp, r9;                     // packed_body

        mov r10, 256;
        cmp rbx, r10;
        jae isoch_mi_bad_slot;

        mov rdi, r12;
        call isoch_stream_check_parent;
        cmp rax, 0;
        je  isoch_mi_bad_parent;

        mov rdi, r13;
        call isoch_stream_check_endpoint;
        cmp rax, 0;
        je  isoch_mi_bad_endpoint;

        mov rdi, r14;
        call isoch_stream_rights_valid;
        cmp rax, 0;
        je  isoch_mi_bad_rights;

        mov rdi, rbp;
        and rdi, 0xFF;                   // interval
        call isoch_stream_interval_valid;
        cmp rax, 0;
        je  isoch_mi_bad_interval;

        mov rdi, rbp;
        shr rdi, 8;
        and rdi, 0xFFFF;                 // bandwidth
        call isoch_stream_bandwidth_valid;
        cmp rax, 0;
        je  isoch_mi_bad_bandwidth;

        mov rdi, rbp;
        shr rdi, 24;
        and rdi, 0xFF;                   // direction
        call isoch_stream_direction_valid;
        cmp rax, 0;
        je  isoch_mi_bad_direction;

        cmp r15, 0;
        je  isoch_mi_no_key;

        mov rdi, r15;
        call isoch_stream_find_by_key;
        cmp rax, 0xFF;
        jne isoch_mi_in_use;

        // Body pack args: (endpoint_slot, interval, bandwidth, direction).
        mov rdi, r13;                    // endpoint_slot
        mov rsi, rbp;
        and rsi, 0xFF;                   // interval
        mov rdx, rbp;
        shr rdx, 8;
        and rdx, 0xFFFF;                 // bandwidth
        mov rcx, rbp;
        shr rcx, 24;
        and rcx, 0xFF;                   // direction
        call isoch_stream_body_pack;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  isoch_mi_bad_interval;
        push rax;                        // body
        sub rsp, 8;

        mov rdi, r12;
        call isoch_stream_hdr_pack;
        add rsp, 8;
        pop r10;                         // body
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  isoch_mi_bad_parent;

        mov rdi, rax;                    // hdr
        mov rsi, r15;                    // stream_key
        mov rdx, r10;                    // body
        call isoch_stream_tail_alloc;

        mov r10, 0xFFFFFACF;
        cmp rax, r10;
        je  isoch_mi_enospc;
        mov r10, 0xFFFFFACE;
        cmp rax, r10;
        je  isoch_mi_bad_interval;

        mov r15, rax;                    // row_id
        mov r11, rbx;
        shl r11, 16;
        or  r15, r11;

        mov rdi, rbx;
        mov rsi, 0x169;
        mov rdx, r14;
        mov rcx, r15;
        call cap_mint_write;

        mov rdi, 0;
        call isoch_stream_note;

        xor rax, rax;
        jmp isoch_mi_out;

      isoch_mi_bad_slot:
        mov rax, 0xFFFFFAC4;
        jmp isoch_mi_out;
      isoch_mi_bad_parent:
        mov rax, 0xFFFFFACD;
        jmp isoch_mi_out;
      isoch_mi_bad_endpoint:
        mov rax, 0xFFFFFACB;
        jmp isoch_mi_out;
      isoch_mi_bad_rights:
        mov rax, 0xFFFFFACC;
        jmp isoch_mi_out;
      isoch_mi_bad_interval:
        mov rax, 0xFFFFFACA;
        jmp isoch_mi_out;
      isoch_mi_bad_bandwidth:
        mov rax, 0xFFFFFAC9;
        jmp isoch_mi_out;
      isoch_mi_bad_direction:
        mov rax, 0xFFFFFAC8;
        jmp isoch_mi_out;
      isoch_mi_no_key:
        mov rax, 0xFFFFFAC7;
        jmp isoch_mi_out;
      isoch_mi_in_use:
        mov rdi, 2;
        call isoch_stream_note;
        mov rax, 0xFFFFFAC5;
        jmp isoch_mi_out;
      isoch_mi_enospc:
        mov rdi, 3;
        call isoch_stream_note;
        mov rax, 0xFFFFFAC6;

      isoch_mi_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let isoch_stream_cap_mint : (u64, u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) (parent_slot: u64) (endpoint_slot: u64) (rights: u64) (stream_key: u64) (packed_body: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R34.M5-001 (#1186): audited mint.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;
        mov r13, rsi;

        call isoch_stream_cap_mint_inner;
        mov r14, rax;

        mov rdi, 1;
        mov rsi, 0x169;
        mov rdx, r12;
        mov rcx, r13;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
