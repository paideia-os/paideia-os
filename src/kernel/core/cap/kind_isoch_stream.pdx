  pub let isoch_stream_cap_revoke_inner : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R34.M5-001 (#1186): revoke KIND_ISOCH_STREAM. Labels prefixed isoch_rvk_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;

        mov r10, 256;
        cmp r12, r10;
        jae isoch_rvk_bad_slot;

        lea rax, [rip + cap_table];
        mov r8, r12;
        shl r8, 3;
        mov r9, r12;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov rbx, rax;

        mov r10, [rbx + 0];
        cmp r10, 0;
        je  isoch_rvk_already;

        mov r11, 0x169;
        cmp r10, r11;
        jne isoch_rvk_wrong_kind;

        mov r13, [rbx + 16];
        mov r10, 0xFFFF;
        and r13, r10;

        mov rdi, r13;
        call isoch_stream_tail_valid;
        cmp rax, 0;
        je  isoch_rvk_clear;

        mov rdi, r13;
        call isoch_stream_tail_free;

      isoch_rvk_clear:
        mov rdi, r12;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        mov rdi, 1;
        call isoch_stream_note;

        xor rax, rax;
        jmp isoch_rvk_out;

      isoch_rvk_bad_slot:
        mov rax, 0xFFFFFAC4;
        jmp isoch_rvk_out;
      isoch_rvk_wrong_kind:
        mov rax, 0xFFFFFAC3;
        jmp isoch_rvk_out;
      isoch_rvk_already:
        mov rax, 0xFFFFFAC2;

      isoch_rvk_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let isoch_stream_cap_revoke : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
