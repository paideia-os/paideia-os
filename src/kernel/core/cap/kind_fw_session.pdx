// src/kernel/core/cap/kind_fw_session.pdx — R30.M8-002 (#1083)
//
// KIND_FW_SESSION derived kind: the authority to open ONE evaluation
// session against ONE firmware-supplied object, and the arbitration
// that decides which of several such sessions may WRITE.
//
// ---------------------------------------------------------------------
// THE NAME, AND WHY IT IS NOT KIND_AML_SESSION
// ---------------------------------------------------------------------
// The R30 catalog named this `KIND_AML_SESSION`. THAT IDENTIFIER CANNOT
// EXIST IN THIS DIRECTORY. tools/lint-no-kernel-aml.sh refuses any
// identifier beginning `aml` anywhere under src/kernel/**, and
// capabilities live in src/kernel/core/cap/ — so the catalog name and
// the file's address were in direct contradiction.
//
// #1569 was filed ahead of this issue precisely so the contradiction
// would be resolved before code existed to rename, and it was resolved
// by renaming the capability rather than by carving an exception into
// the lint. The lint enforces the Pillar 3 boundary (no firmware
// bytecode interpreter in ring 0, design/acpi/no-aml-in-kernel.md); a
// boundary with one exception is a boundary with a precedent, and the
// next exception is argued from this one rather than from the rationale.
//
// The new name is also the accurate one. What is arbitrated is an
// EVALUATION SESSION against a FIRMWARE-SUPPLIED OBJECT. Nothing about
// it is specific to the AML bytecode language, and if a platform ever
// describes itself in something other than AML this kind still reads
// correctly.
//
// ---------------------------------------------------------------------
// THE PROPERTY THIS FILE EXISTS TO MAKE TRUE
// ---------------------------------------------------------------------
//   Many components may hold a session on the same firmware object and
//   read it concurrently. At most one of them can be writing it at any
//   moment, and the one that is writing knows it is.
//
// Note what is NOT claimed: sessions are not mutually exclusive. That is
// the point of having them. R31 will have a battery driver, a thermal
// driver and a lid driver all evaluating objects under the same EC
// scope, and an arbitration scheme that serialised all of them would
// serialise the machine's whole platform stack behind its slowest
// consumer.
//
// What must be exclusive is WRITING, and it must be exclusive PER
// OBJECT rather than per session — which is why this file has two
// tables and not one.
//
// ---------------------------------------------------------------------
// WHY TWO TABLES
// ---------------------------------------------------------------------
// A capability names a session. Arbitration is about the OBJECT. Those
// are different cardinalities: N sessions to 1 object.
//
// Putting the writer claim in the session row would give every session
// its own claim, which is the same as having no arbitration at all —
// each holder would successfully claim "the lock", observe that it
// holds it, and write concurrently with every other holder doing the
// same. That failure has no symptom on the claiming side whatsoever; it
// surfaces as a firmware object with interleaved half-updates.
//
//   _fw_object_table    THE ARBITRATED THING. One row per distinct
//                       (scope_path, op_region_domain). Carries the
//                       claim, the claim depth, and the session
//                       refcount.
//
//   _fw_session_table   THE CAPABILITY'S ROW. One per live capability.
//                       Carries the domain, the parent slot, and an
//                       INDEX into the object table.
//
// Two capabilities minted on the same (scope_path, domain) resolve to
// the SAME object row. That is not an optimisation — it is the entire
// mechanism. If they resolved to different object rows they would
// arbitrate against different locks, and the second holder's writes
// would land in the middle of the first's.
//
// ---------------------------------------------------------------------
// TAIL ENCODING — row indirection, and why the path is stored whole
// ---------------------------------------------------------------------
// The catalog tail is {scope_path:[u8;64], op_region_domain:u8}. That is
// 65 bytes and the descriptor's target_ptr is 64 BITS, so the tail goes
// in a private table and target_ptr carries a row id — the discipline
// KIND_HW_INTERRUPT (#1019), KIND_DMA_DOMAIN (#1036), KIND_OP_REGION
// (#1061), KIND_ACPI_EVENT (#1068) and KIND_GPIO_LINE (#1075) all use.
//
// THE SCOPE PATH IS STORED IN FULL, NOT HASHED, and that is worth an
// argument because 64 bytes per object is the largest row in the cap
// subsystem and a 64-bit hash would have made it 8.
//
// A hash collision between two distinct scope paths would merge two
// firmware objects into one arbitration domain. The consequence is not
// a wrong answer to a query — it is that a writer holding the claim on
// `\_SB.PCI0.LPCB.EC0` would be excluding a writer on some unrelated
// scope, and, far worse, the reverse: two paths that SHOULD share an
// object but hash differently would not exclude each other at all.
// Identity is the whole basis of the exclusion, so identity is exact.
//
// The kernel does not parse the path and does not know what it means.
// It is an opaque 64-byte name supplied by the supervisor, compared
// bytewise. That is the strongest thing the kernel can honestly do with
// a firmware namespace it is forbidden to interpret.
//
// ---------------------------------------------------------------------
// DERIVATION — over KIND_IPC_ENDPOINT, and the two-part gate
// ---------------------------------------------------------------------
// The parent is a KIND_IPC_ENDPOINT (base slot 5), because a session is
// a conversation: the holder talks to the ACPI supervisor, and the
// authority to open a session is downstream of the authority to talk to
// the thing that has the firmware namespace.
//
// A KIND CHECK ALONE IS AN EMPTY GATE HERE, and more obviously so than
// anywhere it has been said before. Every IPC endpoint in the system is
// a KIND_IPC_ENDPOINT — the shell's stdout is one. A gate that stopped
// at `kind == 5 && rights & RIGHT_MINT` would let the holder of any
// endpoint whatsoever mint arbitration authority over the embedded
// controller's scope.
//
// So there is a second half, and it follows #1075's shape exactly:
//
//   FIRST HALF   cap_table[parent_slot].kind == KIND_IPC_ENDPOINT (5)
//                and rights carry RIGHT_MINT.
//
//   SECOND HALF  the parent's INHERITED endpoint id — read out of the
//                parent descriptor, never argued — must be REGISTERED
//                in _fw_ep_registry as a firmware-object endpoint, and
//                the requested op_region_domain must be one of the
//                domains that registration granted.
//
// The registry is written once, at ACPI bring-up, by the code that
// creates the supervisor's endpoint. A KIND_IPC_ENDPOINT for the
// shell reaches the second half and is refused FW_SESSION_MINT_NO_EP.
//
// THE ENDPOINT ID IS INHERITED, NEVER ARGUED. fw_session_cap_mint has
// no endpoint parameter; it reads the id from the parent capability's
// own descriptor. That is what makes the second half unforgeable: a
// caller cannot name an endpoint it does not hold, so it cannot claim a
// domain that endpoint was not registered for.
//
// ---------------------------------------------------------------------
// THE CLAIM — recursive, owner-checked, and released only at 1->0
// ---------------------------------------------------------------------
// The claim is the userspace Global Lock argument (#1082) one level up,
// and it fails the same way if the recursion is got wrong:
//
//   * a second session's claim while another holds it is REFUSED
//     (FW_SESSION_CLAIM_HELD), not queued and not silently granted;
//   * the SAME session re-claiming SUCCEEDS and increments a depth,
//     because a session that evaluates a method which evaluates another
//     method against the same object must not deadlock against itself;
//   * release at depth > 1 decrements and RETAINS the claim. An inner
//     release that dropped it would let another session start writing
//     the object in the middle of the outer session's update.
//
// The owner comparison is against the SESSION ROW, not the capability
// slot, because a slot can be revoked and re-minted while a claim is
// outstanding and the new occupant is not the old one.
//
// ---------------------------------------------------------------------
// FAILURE TAXONOMY — 0xFFFFFE10..0xFFFFFE1F, A NEW BAND
// ---------------------------------------------------------------------
// The 0xFFFFFFxx band is EXHAUSTED. At the time of writing it has two
// free runs of eight and nothing wider; every previous derived kind took
// a contiguous sixteen (KIND_GPIO_LINE 0xFFFFFF10..1F, KIND_ACPI_EVENT
// 0xFFFFFF90..9F, KIND_OP_REGION 0xFFFFFFC5..CF, KIND_DMA_DOMAIN
// 0xFFFFFFD5..DF).
//
// Splitting this kind's codes across two eight-wide holes to stay in the
// old band would have made the taxonomy discontiguous for no reason
// other than that the band was full, and would have left the NEXT kind
// with the same problem and less room. So 0xFFFFFExx is opened here as
// the successor band and this kind takes 0xFFFFFE10..0xFFFFFE1F from
// it. The band is disjoint from every code in tree.
//
// ---------------------------------------------------------------------
// DESCRIPTOR WRITES — #1579, and staying on the right side of it
// ---------------------------------------------------------------------
// #1579 records that `cap_mint_write` is the only writer of capability
// descriptors BY CONVENTION rather than by build gate, and that some
// existing revoke paths (kind_gpio_line.pdx among them) clear a
// descriptor with three direct stores instead.
//
// This file does not fix that — it is not this issue's to fix — but it
// deliberately does not add to it. Both the mint and the revoke here go
// through `cap_mint_write`; the revoke calls it with kind, rights and
// target_ptr all zero, which is the same 24 bytes the direct stores
// would have written, through the one function that is supposed to
// write them. When #1579 lands its build gate, this module will already
// satisfy it.

module KindFwSession = structure {

  // ==========================================================================
  // Tags and bounds.
  // ==========================================================================

  pub let KIND_FW_SESSION : u64 = 0x155   // derived-kind tag (decimal 341)

  // The base. KIND_IPC_ENDPOINT = 5 in the closed base-kind encoding
  // (cap/kind.pdx); the FULL u64 kind field is compared at dispatch, not
  // the 4-bit LAM slot, so this coexists with the slot-5 endpoint
  // handler exactly as every derived kind above it does.
  pub let FW_SESSION_PARENT_KIND : u64 = 5

  pub let FW_SESSION_MAX      : u64 = 16   // live capabilities
  pub let FW_SESSION_ROW_BYTES: u64 = 16
  pub let FW_OBJECT_MAX       : u64 = 8    // distinct firmware objects
  pub let FW_OBJECT_ROW_BYTES : u64 = 128
  pub let FW_EP_MAX           : u64 = 8    // registered endpoints
  pub let FW_EP_ROW_BYTES     : u64 = 16

  // The scope path is a fixed 64-byte opaque name. A LENGTH is carried
  // beside it rather than relying on a NUL: a firmware path is not
  // guaranteed NUL-terminated, and a comparison that stopped at the
  // first zero byte would make two paths sharing a prefix compare equal
  // -- which would merge two objects' arbitration, the exact failure the
  // whole-path comparison exists to prevent.
  pub let FW_SCOPE_MAX : u64 = 64

  // Domains are a bitmask position, 0..7. op_region_domain in the tail
  // is the INDEX; the registry stores the MASK of indices an endpoint
  // may open sessions for.
  pub let FW_DOMAIN_MAX : u64 = 8

  // ==========================================================================
  // Rights.
  //
  // R_FW_SESSION_ALL deliberately EXCLUDES RIGHT_MINT: this kind is a
  // LEAF of the derivation lattice. A session does not derive sessions,
  // and a MINT bit no gate reads is the shape that later acquires a
  // meaning nobody audited -- the argument #1071 made and #1075 repeated.
  //
  // WRITE IS A SEPARATE BIT FROM THE CLAIM, and the separation carries
  // weight. RIGHT_WRITE says a holder may modify the object; the claim
  // says it is the one currently doing so. A holder with the claim and
  // without RIGHT_WRITE is a legitimate configuration -- a session that
  // needs a consistent multi-read snapshot takes the claim precisely so
  // that nobody writes underneath it, and giving it write authority to
  // achieve that would be handing out more than it asked for.
  // ==========================================================================

  pub let R_FW_SESSION_READ    : u64 = 0x001
  pub let R_FW_SESSION_WRITE   : u64 = 0x002
  pub let R_FW_SESSION_INVOKE  : u64 = 0x008
  pub let R_FW_SESSION_REVOKE  : u64 = 0x010
  pub let R_FW_SESSION_OBSERVE : u64 = 0x400
  pub let R_FW_SESSION_ALL     : u64 = 0x41B

  // ==========================================================================
  // Failure taxonomy — 0xFFFFFE10..0xFFFFFE1F. See the header for why a
  // new band. Each code is a distinct OPERATOR PROBLEM; collapsing any
  // two would make a misconfigured supervisor look like a full table.
  // ==========================================================================

  pub let FW_SESSION_OK                : u64 = 0
  pub let FW_SESSION_MINT_BAD_ARG      : u64 = 0xFFFFFE1F
  pub let FW_SESSION_MINT_BAD_PARENT   : u64 = 0xFFFFFE1E
  pub let FW_SESSION_MINT_BAD_RIGHTS   : u64 = 0xFFFFFE1D
  pub let FW_SESSION_MINT_NO_EP        : u64 = 0xFFFFFE1C
  pub let FW_SESSION_MINT_BAD_DOMAIN   : u64 = 0xFFFFFE1B
  pub let FW_SESSION_MINT_BAD_SCOPE    : u64 = 0xFFFFFE1A
  pub let FW_SESSION_MINT_ENOSPC       : u64 = 0xFFFFFE19
  pub let FW_SESSION_MINT_OBJ_ENOSPC   : u64 = 0xFFFFFE18
  pub let FW_SESSION_CLAIM_HELD        : u64 = 0xFFFFFE17
  pub let FW_SESSION_CLAIM_NOT_HELD    : u64 = 0xFFFFFE16
  pub let FW_SESSION_CLAIM_DEPTH       : u64 = 0xFFFFFE15
  pub let FW_SESSION_REVOKE_BAD_SLOT   : u64 = 0xFFFFFE14
  pub let FW_SESSION_REVOKE_WRONG_KIND : u64 = 0xFFFFFE13
  pub let FW_SESSION_REVOKE_ALREADY    : u64 = 0xFFFFFE12
  pub let FW_SESSION_EP_ENOSPC         : u64 = 0xFFFFFE11
  pub let FW_SESSION_DECODE_BAD        : u64 = 0xFFFFFFFFFFFFFFFF

  pub let FW_CLAIM_DEPTH_MAX : u64 = 32

  // ==========================================================================
  // Storage. Confined to kind_fw_session.o by tools/build.sh.
  //
  // _fw_session_table  16 rows x 16 B
  //   +0  hdr: [63:56] in_use | [55:48] domain | [47:40] parent_slot
  //   +8  object index
  //
  // _fw_object_table   8 rows x 96 B
  //   +0  hdr: [63:56] in_use | [55:48] domain | [47:40] path_len
  //   +8  holder: 0 = unclaimed, else session_row + 1
  //   +16 claim depth
  //   +24 session refcount
  //   +32..95 scope_path, 64 opaque bytes
  //   +96..127 reserved (pads the row to 128 B: a power-of-two stride
  //            makes the row index a SHIFT, and paideia-as has no `mul`)
  //
  // _fw_ep_registry    8 rows x 16 B
  //   +0  endpoint id, 0 = empty
  //   +8  domain mask
  // ==========================================================================

  pub let mut _fw_session_table : [u64; 32]  = uninit @align(64)
  pub let mut _fw_object_table  : [u64; 128] = uninit @align(64)
  pub let mut _fw_ep_registry   : [u64; 16]  = uninit @align(64)

  pub let fws_dbg_msg : [u8; 15] = "FW SESSION ROW\0"
  pub let fws_k_row   : [u8; 4]  = "row\0"
  pub let fws_k_obj   : [u8; 4]  = "obj\0"
  pub let fws_k_dom   : [u8; 4]  = "dom\0"

  // ==========================================================================
  // fw_session_table_reset() -- clear all three tables.
  // ==========================================================================

  pub let fw_session_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M8-002 (#1083): zero the session table, the object table and the endpoint registry. Called once at boot before any mint. A counted loop over the total word count of all three arrays, which are adjacent declarations but are cleared as three independent runs so that a future size change to one does not silently under-clear another. Labels prefixed fws_tr_ per reserved-label discipline.",
      block: {
        lea rcx, [rip + _fw_session_table];
        xor rax, rax;
        xor r8, r8;
      fws_tr_sess:
        mov [rcx + r8*8], rax;
        add r8, 1;
        cmp r8, 32;
        jb fws_tr_sess;

        lea rcx, [rip + _fw_object_table];
        xor r8, r8;
      fws_tr_obj:
        mov [rcx + r8*8], rax;
        add r8, 1;
        cmp r8, 128;
        jb fws_tr_obj;

        lea rcx, [rip + _fw_ep_registry];
        xor r8, r8;
      fws_tr_ep:
        mov [rcx + r8*8], rax;
        add r8, 1;
        cmp r8, 16;
        jb fws_tr_ep;
        ret
      }
    }

  // ==========================================================================
  // THE ENDPOINT REGISTRY -- the second half of the derivation gate.
  //
  // fw_ep_register(endpoint_id, domain_mask) is called at ACPI bring-up
  // by the code that creates the supervisor's endpoint. It is the ONLY
  // writer, and what it writes is the answer to "may sessions be minted
  // under this endpoint, and for which domains".
  // ==========================================================================

  pub let fw_ep_register : (u64, u64) -> u64 !{mem} @{} =
    fn (endpoint_id: u64) (domain_mask: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M8-002 (#1083): register an endpoint as a firmware-object endpoint, with the mask of op-region domains sessions under it may name. Refuses endpoint_id 0 (0 is the registry's own 'empty' sentinel, and a row carrying it would be permanently unmatchable while also occupying a slot) and refuses a zero mask (an endpoint registered for no domain is a registration with no meaning that would nonetheless pass the first half of the gate's second test). Re-registering an existing id OVERWRITES its mask rather than allocating a second row: two rows for one endpoint would make the gate's answer depend on scan order. Low-first scan; exhaustion -> FW_SESSION_EP_ENOSPC. Labels prefixed fws_epr_ per reserved-label discipline.",
      block: {
        cmp rdi, 0;
        je fws_epr_bad;
        cmp rsi, 0;
        je fws_epr_bad;

        lea rcx, [rip + _fw_ep_registry];
        xor r8, r8;
        // first pass: an existing registration wins
      fws_epr_scan:
        mov rax, [rcx + r8*8];
        cmp rax, rdi;
        je fws_epr_hit;
        add r8, 2;
        cmp r8, 16;
        jb fws_epr_scan;

        // second pass: the lowest free row
        xor r8, r8;
      fws_epr_free:
        mov rax, [rcx + r8*8];
        cmp rax, 0;
        je fws_epr_hit;
        add r8, 2;
        cmp r8, 16;
        jb fws_epr_free;
        mov rax, 0xFFFFFE11;             // FW_SESSION_EP_ENOSPC
        ret;

      fws_epr_hit:
        mov [rcx + r8*8], rdi;
        add r8, 1;
        mov [rcx + r8*8], rsi;
        xor rax, rax;
        ret;

      fws_epr_bad:
        mov rax, 0xFFFFFE1F;             // FW_SESSION_MINT_BAD_ARG
        ret
      }
    }

  pub let fw_ep_domains : (u64) -> u64 !{mem} @{} =
    fn (endpoint_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M8-002 (#1083): the domain mask registered for `endpoint_id`, or 0 if it is not a firmware-object endpoint. ZERO IS THE REFUSAL and it is unambiguous because fw_ep_register refuses to store a zero mask -- so 'registered for nothing' and 'not registered' cannot be confused, and a caller cannot be handed a mask that passes a subsequent bit test by accident. An endpoint_id of 0 returns 0 without scanning, since 0 is the empty-row sentinel and would otherwise match every free row. Pure read. Labels prefixed fws_epd_ per reserved-label discipline.",
      block: {
        cmp rdi, 0;
        je fws_epd_no;
        lea rcx, [rip + _fw_ep_registry];
        xor r8, r8;
      fws_epd_scan:
        mov rax, [rcx + r8*8];
        cmp rax, rdi;
        je fws_epd_hit;
        add r8, 2;
        cmp r8, 16;
        jb fws_epd_scan;
      fws_epd_no:
        xor rax, rax;
        ret;
      fws_epd_hit:
        add r8, 1;
        mov rax, [rcx + r8*8];
        ret
      }
    }

  // ==========================================================================
  // THE FIRST HALF OF THE DERIVATION GATE.
  // ==========================================================================

  pub let fw_session_check_parent_endpoint : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R30.M8-002 (#1083): the first half of the KIND_FW_SESSION derivation gate. Bounds-check parent_slot < 256; load the descriptor at cap_table + parent_slot*24 (stride 24 per cap/mint.pdx); require kind == KIND_IPC_ENDPOINT (5) AND (rights & RIGHT_MINT 0x200) != 0. THIS HALF ALONE IS DELIBERATELY NOT SUFFICIENT and the mint does not treat it as such -- more obviously here than for any previous kind, because EVERY IPC endpoint in the system satisfies it, the shell's stdout included. The second half, in fw_session_cap_mint, requires the parent's INHERITED endpoint id to be registered in _fw_ep_registry for the requested domain. Pure read. Labels prefixed fws_cpe_ per reserved-label discipline.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae fws_cpe_no;
        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;                      // slot*24 = slot*8 + slot*16
        add rax, r8;
        mov rcx, rax;
        mov rax, [rcx + 0];              // kind
        cmp rax, 5;                      // KIND_IPC_ENDPOINT
        jne fws_cpe_no;
        mov rax, [rcx + 8];              // rights
        and rax, 0x200;                  // RIGHT_MINT
        cmp rax, 0;
        je fws_cpe_no;
        mov rax, 1;
        ret;
      fws_cpe_no:
        xor rax, rax;
        ret
      }
    }

  pub let fw_session_parent_eid : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R30.M8-002 (#1083): read the parent KIND_IPC_ENDPOINT descriptor's endpoint id -- target_ptr bits [15:0], the encoding cap/kind_endpoint.pdx's endpoint_tail_pack writes. THIS IS THE ONLY SOURCE OF A SESSION'S ENDPOINT IDENTITY: the mint has no endpoint argument, so the domains a session may name are the domains the endpoint its parent capability names was registered for, and no others. That is the discipline #1070 established for KIND_I2C_BUS and #1075 for KIND_GPIO_LINE, and it is what makes the second half of the gate unforgeable rather than merely present -- a caller cannot name an endpoint it does not hold. Returns 0 for an out-of-range slot or a non-endpoint descriptor; 0 is also what fw_ep_domains refuses outright, so a fabricated parent cannot resolve to a registered endpoint by accident. Pure read. Labels prefixed fws_pei_ per reserved-label discipline.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae fws_pei_no;
        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;                      // slot*24 = slot*8 + slot*16
        add rax, r8;
        mov rcx, rax;
        mov rax, [rcx + 0];
        cmp rax, 5;                      // KIND_IPC_ENDPOINT
        jne fws_pei_no;
        mov rax, [rcx + 16];             // target_ptr
        mov r10, 0xFFFF;
        and rax, r10;                    // endpoint_id, bits [15:0]
        ret;
      fws_pei_no:
        xor rax, rax;
        ret
      }
    }

  pub let fw_session_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R30.M8-002 (#1083): 1 iff (rights & R_FW_SESSION_ALL) == rights. R_FW_SESSION_ALL = 0x41B (READ|WRITE|INVOKE|REVOKE|OBSERVE). A subset test, so a session that may read a firmware object but never write it is expressible -- which is the common case, since most consumers of a thermal zone or a battery only sample it. RIGHT_MINT (0x200) is OUTSIDE the mask: this kind is the bottom of the derivation lattice. Pure leaf. Labels prefixed fws_rv_ per reserved-label discipline.",
      block: {
        mov rax, rdi;
        and rax, 0x41B;
        cmp rax, rdi;
        jne fws_rv_no;
        mov rax, 1;
        ret;
      fws_rv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // THE OBJECT TABLE. Identity is (scope_path, domain), compared WHOLE.
  // ==========================================================================

  pub let fw_object_find : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (scope_ptr: u64) (path_len: u64) (domain: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M8-002 (#1083): find the live object row whose (scope_path, domain) equals the argument, or FW_SESSION_DECODE_BAD. THE COMPARISON IS BYTEWISE OVER path_len BYTES AND THE LENGTHS MUST MATCH FIRST -- a comparison that stopped at a shared prefix would report `\\_SB.PCI0.LPCB.EC0` and `\\_SB.PCI0.LPCB.EC0X` as the same object, merging two arbitration domains so that a writer on one excluded a writer on the other while neither excluded its own true peer. The kernel does not parse the path and must not: it is a firmware namespace this ring is forbidden to interpret (design/acpi/no-aml-in-kernel.md), so an exact opaque byte comparison is the strongest honest identity available. Domain is compared before the path because it is one byte against sixty-four. Pure read; no nested call. Labels prefixed fws_of_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // scope_ptr
        mov r13, rsi;                    // path_len
        mov r14, rdx;                    // domain

        lea rbx, [rip + _fw_object_table];
        xor r15, r15;                    // object index

      fws_of_row:
        mov r8, r15;
        shl r8, 7;                       // 128-byte stride
        add r8, rbx;                     // r8 = &row

        mov rax, [r8 + 0];
        mov rcx, rax;
        shr rcx, 56;
        cmp rcx, 0;
        je fws_of_next;                  // not in use

        mov rcx, rax;
        shr rcx, 48;
        and rcx, 0xFF;
        cmp rcx, r14;
        jne fws_of_next;                 // wrong domain

        mov rcx, rax;
        shr rcx, 40;
        and rcx, 0xFF;
        cmp rcx, r13;
        jne fws_of_next;                 // DIFFERENT LENGTH -> different name

        // bytewise over the whole declared length
        xor r9, r9;
      fws_of_byte:
        cmp r9, r13;
        jae fws_of_hit;
        mov rax, r8;
        add rax, 32;
        add rax, r9;
        xor rcx, rcx;
        mov_b rcx, [rax + 0];
        mov rax, r12;
        add rax, r9;
        xor rdx, rdx;
        mov_b rdx, [rax + 0];
        cmp rcx, rdx;
        jne fws_of_next;
        add r9, 1;
        jmp fws_of_byte;

      fws_of_hit:
        mov rax, r15;
        jmp fws_of_out;

      fws_of_next:
        add r15, 1;
        cmp r15, 8;                      // FW_OBJECT_MAX
        jb fws_of_row;
        mov rax, 0xFFFFFFFFFFFFFFFF;     // FW_SESSION_DECODE_BAD

      fws_of_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let fw_object_alloc : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (scope_ptr: u64) (path_len: u64) (domain: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M8-002 (#1083): return the index of the object row for (scope_path, domain), creating it if absent. FIND FIRST, THEN ALLOCATE -- and that order is the mechanism rather than an optimisation: two capabilities minted on the same firmware object MUST resolve to the same row, because they arbitrate against the claim that row holds. Allocating unconditionally would give each holder its own claim, every claim would succeed, and every holder would observe itself to be the exclusive writer while writing concurrently with all the others. That failure is invisible from the claiming side and surfaces as a firmware object with interleaved half-updates. Refuses path_len 0 or > 64 (FW_SESSION_MINT_BAD_SCOPE) and domain >= 8 (FW_SESSION_MINT_BAD_DOMAIN) BEFORE touching the table, so a malformed request cannot occupy a row. On allocation the 64 path bytes are copied in full and the refcount starts at 0 -- the caller bumps it, because the caller is the one that knows whether the session row it is about to write actually landed. Labels prefixed fws_oa_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;

        cmp r13, 0;
        je fws_oa_badscope;
        cmp r13, 64;                     // FW_SCOPE_MAX
        ja fws_oa_badscope;
        cmp r14, 8;                      // FW_DOMAIN_MAX
        jae fws_oa_baddom;

        // ---- find first: the same object must be the same row ----
        mov rdi, r12;
        mov rsi, r13;
        mov rdx, r14;
        call fw_object_find;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        jne fws_oa_out;

        // ---- allocate the lowest free row ----
        lea rbx, [rip + _fw_object_table];
        xor r15, r15;
      fws_oa_scan:
        mov r8, r15;
        shl r8, 7;
        add r8, rbx;
        mov rax, [r8 + 0];
        shr rax, 56;
        cmp rax, 0;
        je fws_oa_take;
        add r15, 1;
        cmp r15, 8;
        jb fws_oa_scan;
        mov rax, 0xFFFFFE18;             // FW_SESSION_MINT_OBJ_ENOSPC
        jmp fws_oa_out;

      fws_oa_take:
        // hdr = in_use | domain << 48 | path_len << 40
        mov rax, 1;
        shl rax, 56;
        mov rcx, r14;
        shl rcx, 48;
        or rax, rcx;
        mov rcx, r13;
        shl rcx, 40;
        or rax, rcx;
        mov [r8 + 0], rax;
        xor rax, rax;
        mov [r8 + 8], rax;               // unclaimed
        mov [r8 + 16], rax;              // depth 0
        mov [r8 + 24], rax;              // refcount 0 -- the caller bumps it

        // copy the path, whole
        xor r9, r9;
      fws_oa_copy:
        cmp r9, r13;
        jae fws_oa_copied;
        mov rax, r12;
        add rax, r9;
        xor rcx, rcx;
        mov_b rcx, [rax + 0];
        mov rax, r8;
        add rax, 32;
        add rax, r9;
        mov_b [rax + 0], rcx;
        add r9, 1;
        jmp fws_oa_copy;

      fws_oa_copied:
        mov rax, r15;
        jmp fws_oa_out;

      fws_oa_badscope:
        mov rax, 0xFFFFFE1A;             // FW_SESSION_MINT_BAD_SCOPE
        jmp fws_oa_out;

      fws_oa_baddom:
        mov rax, 0xFFFFFE1B;             // FW_SESSION_MINT_BAD_DOMAIN

      fws_oa_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let fw_object_holder : (u64) -> u64 !{mem} @{} =
    fn (obj: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M8-002 (#1083): the object's current writer claim -- 0 unclaimed, else session_row + 1. THE +1 BIAS IS DELIBERATE: session row 0 is a legitimate row, and storing the row id raw would make 'row 0 holds the claim' and 'nobody holds the claim' the same bit pattern, which is the arbitration equivalent of always answering yes. Bounds-checked; an out-of-range index reads 0 rather than off the end of the table. Pure read. Labels prefixed fws_oh_ per reserved-label discipline.",
      block: {
        cmp rdi, 8;
        jae fws_oh_zero;
        mov rax, rdi;
        shl rax, 7;
        lea rcx, [rip + _fw_object_table];
        add rcx, rax;
        mov rax, [rcx + 8];
        ret;
      fws_oh_zero:
        xor rax, rax;
        ret
      }
    }

  pub let fw_object_depth : (u64) -> u64 !{mem} @{} =
    fn (obj: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M8-002 (#1083): the object's claim depth. Non-zero exactly when the claim is held; the witness asserts depth and holder agree, since a holder with depth 0 or a depth with no holder is a half-updated claim and either would let a second writer in. Bounds-checked. Pure read. Labels prefixed fws_od_ per reserved-label discipline.",
      block: {
        cmp rdi, 8;
        jae fws_od_zero;
        mov rax, rdi;
        shl rax, 7;
        lea rcx, [rip + _fw_object_table];
        add rcx, rax;
        mov rax, [rcx + 16];
        ret;
      fws_od_zero:
        xor rax, rax;
        ret
      }
    }

  pub let fw_object_refs : (u64) -> u64 !{mem} @{} =
    fn (obj: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M8-002 (#1083): how many live sessions name this object. The object row is freed when this reaches 0, so it is what makes the table reusable across a boot rather than monotonically consumed. Bounds-checked. Pure read. Labels prefixed fws_or_ per reserved-label discipline.",
      block: {
        cmp rdi, 8;
        jae fws_or_zero;
        mov rax, rdi;
        shl rax, 7;
        lea rcx, [rip + _fw_object_table];
        add rcx, rax;
        mov rax, [rcx + 24];
        ret;
      fws_or_zero:
        xor rax, rax;
        ret
      }
    }

  pub let fw_objects_live : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M8-002 (#1083): how many object rows are in use. The observable that makes 'the same firmware object resolved to the same row' assertable: minting two sessions on one scope must leave this at 1, and a mint path that allocated per capability would leave it at 2 with every other assertion in the witness still passing. Labels prefixed fws_ol_ per reserved-label discipline.",
      block: {
        lea rcx, [rip + _fw_object_table];
        xor r8, r8;
        xor r9, r9;
      fws_ol_scan:
        mov r10, r8;
        shl r10, 7;
        add r10, rcx;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je fws_ol_next;
        add r9, 1;
      fws_ol_next:
        add r8, 1;
        cmp r8, 8;
        jb fws_ol_scan;
        mov rax, r9;
        ret
      }
    }

  // ==========================================================================
  // THE SESSION ROW TABLE.
  // ==========================================================================

  pub let fw_session_row_alloc : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (obj: u64) (domain: u64) (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M8-002 (#1083): claim the lowest free session row and point it at object `obj`. THE ONLY WRITER OF A SESSION'S OBJECT BINDING, which is what makes the mint gate upstream of it exhaustive rather than merely usual: a session cannot come to name an object except through this function, and this function is reached only after both halves of the derivation gate have passed. Bumps the object's refcount as part of the same claim, so a row and its reference are never out of step -- doing it in the caller would leave a window in which a row named an object the object did not know about, and a revoke landing there would decrement a count that had never been incremented. Exhaustion -> FW_SESSION_MINT_ENOSPC. Labels prefixed fws_ra_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;

        lea rbx, [rip + _fw_session_table];
        xor r8, r8;
      fws_ra_scan:
        mov r10, r8;
        shl r10, 4;
        add r10, rbx;                    // r10 = &row
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je fws_ra_take;
        add r8, 1;
        cmp r8, 16;                      // FW_SESSION_MAX
        jb fws_ra_scan;
        mov rax, 0xFFFFFE19;             // FW_SESSION_MINT_ENOSPC
        jmp fws_ra_out;

      fws_ra_take:
        mov rax, 1;
        shl rax, 56;
        mov rcx, r13;
        shl rcx, 48;
        or rax, rcx;
        mov rcx, r14;
        shl rcx, 40;
        or rax, rcx;
        mov [r10 + 0], rax;
        mov [r10 + 8], r12;              // object index

        // the row and its reference land together
        mov rax, r12;
        shl rax, 7;
        lea rcx, [rip + _fw_object_table];
        add rcx, rax;
        mov rax, [rcx + 24];
        add rax, 1;
        mov [rcx + 24], rax;

        mov rax, r8;

      fws_ra_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let fw_session_row_obj : (u64) -> u64 !{mem} @{} =
    fn (row: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M8-002 (#1083): the object index a live session row names, FW_SESSION_DECODE_BAD for an out-of-range or dead row -- never a plausible 0, because object 0 is a legitimate object and a decoder that returned it for a dead row would report a perfectly believable session. Labels prefixed fws_ro_ per reserved-label discipline.",
      block: {
        cmp rdi, 16;
        jae fws_ro_bad;
        lea rcx, [rip + _fw_session_table];
        mov r8, rdi;
        shl r8, 4;
        add r8, rcx;                     // r8 = &row
        mov rax, [r8 + 0];
        shr rax, 56;
        cmp rax, 0;
        je fws_ro_bad;
        mov rax, [r8 + 8];
        ret;
      fws_ro_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let fw_session_row_domain : (u64) -> u64 !{mem} @{} =
    fn (row: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M8-002 (#1083): the op-region domain a live session row names, from header bits [55:48]; FW_SESSION_DECODE_BAD for a dead row, never 0, because domain 0 is legitimate. Labels prefixed fws_rd_ per reserved-label discipline.",
      block: {
        cmp rdi, 16;
        jae fws_rd_bad;
        lea rcx, [rip + _fw_session_table];
        mov r8, rdi;
        shl r8, 4;
        add r8, rcx;
        mov rax, [r8 + 0];
        mov rdx, rax;
        shr rdx, 56;
        cmp rdx, 0;
        je fws_rd_bad;
        shr rax, 48;
        and rax, 0xFF;
        ret;
      fws_rd_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let fw_sessions_live : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M8-002 (#1083): how many session rows are in use. Labels prefixed fws_sl_ per reserved-label discipline.",
      block: {
        lea rcx, [rip + _fw_session_table];
        xor r8, r8;
        xor r9, r9;
      fws_sl_scan:
        mov rax, r8;
        shl rax, 4;
        add rax, rcx;
        mov rax, [rax + 0];
        shr rax, 56;
        cmp rax, 0;
        je fws_sl_next;
        add r9, 1;
      fws_sl_next:
        add r8, 1;
        cmp r8, 16;
        jb fws_sl_scan;
        mov rax, r9;
        ret
      }
    }

  // ==========================================================================
  // THE CLAIM. The whole arbitration.
  // ==========================================================================

  pub let fw_session_claim : (u64) -> u64 !{mem} @{} =
    fn (row: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M8-002 (#1083): take the writer claim on the object session `row` names. Unclaimed -> take it, depth 1, holder = row + 1. ALREADY HELD BY THIS SAME SESSION -> increment the depth and succeed, because a session evaluating a method that evaluates another method against the same object must not deadlock against itself -- the recursive-mutex rule aml_ctl.pdx states for Serialized methods, one level up. HELD BY A DIFFERENT SESSION -> FW_SESSION_CLAIM_HELD, a REFUSAL rather than a queue: this kernel has no place to park a waiter and a silent grant would be a data race dressed as success. The owner comparison is against the SESSION ROW, not the capability slot, because a slot can be revoked and re-minted while a claim is outstanding and the new occupant is not the old one. The depth bound is checked BEFORE the increment so an overflow can never be committed and then noticed. Labels prefixed fws_cl_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;                      // 16 + 8 = 24; rsp%16 == 0 at the call

        mov r12, rdi;
        call fw_session_row_obj;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je fws_cl_bad;

        shl rax, 7;
        lea rbx, [rip + _fw_object_table];
        add rbx, rax;

        mov rax, [rbx + 8];              // holder
        cmp rax, 0;
        je fws_cl_take;

        // held -- by us, or by somebody else?
        mov rcx, r12;
        add rcx, 1;
        cmp rax, rcx;
        jne fws_cl_held;

        mov rax, [rbx + 16];
        cmp rax, 32;                     // FW_CLAIM_DEPTH_MAX
        jae fws_cl_deep;
        add rax, 1;
        mov [rbx + 16], rax;
        xor rax, rax;                    // FW_SESSION_OK
        jmp fws_cl_out;

      fws_cl_take:
        mov rax, r12;
        add rax, 1;
        mov [rbx + 8], rax;              // holder = row + 1
        mov rax, 1;
        mov [rbx + 16], rax;             // depth 1
        xor rax, rax;
        jmp fws_cl_out;

      fws_cl_held:
        mov rax, 0xFFFFFE17;             // FW_SESSION_CLAIM_HELD
        jmp fws_cl_out;

      fws_cl_deep:
        mov rax, 0xFFFFFE15;             // FW_SESSION_CLAIM_DEPTH
        jmp fws_cl_out;

      fws_cl_bad:
        mov rax, 0xFFFFFE1F;             // FW_SESSION_MINT_BAD_ARG

      fws_cl_out:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let fw_session_unclaim : (u64) -> u64 !{mem} @{} =
    fn (row: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M8-002 (#1083): release one level of the writer claim. AT DEPTH > 1 THIS DECREMENTS AND RETAINS THE CLAIM -- an inner release that dropped it would let a second session start writing the object in the middle of the outer session's update, which is the #1082 nested-release failure one level up and has the same shape: the loser's corruption appears in the firmware object rather than in the loser's code. At depth 1 the holder is cleared. A release by a session that does not hold the claim is FW_SESSION_CLAIM_NOT_HELD and NOT a silent no-op, because it means some caller's bracketing is broken and the next release would be somebody else's. Labels prefixed fws_uc_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        sub rsp, 8;                      // 16 + 8 = 24; rsp%16 == 0 at the call

        mov r12, rdi;
        call fw_session_row_obj;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je fws_uc_bad;

        shl rax, 7;
        lea rbx, [rip + _fw_object_table];
        add rbx, rax;

        mov rax, [rbx + 8];
        mov rcx, r12;
        add rcx, 1;
        cmp rax, rcx;
        jne fws_uc_not;                  // not ours (or nobody's)

        mov rax, [rbx + 16];
        cmp rax, 1;
        jbe fws_uc_drop;
        sub rax, 1;
        mov [rbx + 16], rax;             // still held, one level shallower
        xor rax, rax;
        jmp fws_uc_out;

      fws_uc_drop:
        xor rax, rax;
        mov [rbx + 8], rax;              // holder cleared
        mov [rbx + 16], rax;             // depth 0
        jmp fws_uc_out;

      fws_uc_not:
        mov rax, 0xFFFFFE16;             // FW_SESSION_CLAIM_NOT_HELD
        jmp fws_uc_out;

      fws_uc_bad:
        mov rax, 0xFFFFFE1F;

      fws_uc_out:
        add rsp, 8;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // MINT.
  // ==========================================================================

  pub let fw_session_cap_mint : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (scope_ptr: u64) (path_len: u64) (domain: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R30.M8-002 (#1083): mint a KIND_FW_SESSION. Sequence: (1) slot < 256 else FW_SESSION_MINT_BAD_ARG. (2) fw_session_check_parent_endpoint -- THE FIRST HALF OF THE GATE -- else FW_SESSION_MINT_BAD_PARENT. (3) fw_session_rights_valid else FW_SESSION_MINT_BAD_RIGHTS. (4) domain < 8 else FW_SESSION_MINT_BAD_DOMAIN, checked here as well as in fw_object_alloc so that a domain which cannot be represented is refused as unrepresentable before it is tested against a mask. (5) eid = fw_session_parent_eid(parent_slot) -- INHERITED, never argued. (6) mask = fw_ep_domains(eid); zero -> FW_SESSION_MINT_NO_EP, WHICH IS THE SECOND HALF OF THE GATE and is what refuses the holder of an ordinary endpoint such as the shell's stdout. (7) (mask >> domain) & 1 -> FW_SESSION_MINT_NO_EP if clear: a registered endpoint may still not be registered for THIS domain, and granting it would let the supervisor's console endpoint arbitrate the embedded controller. (8) fw_object_alloc -- find-then-allocate, so two sessions on one firmware object share one claim. (9) fw_session_row_alloc, which also bumps the object refcount. (10) cap_mint_write(slot, KIND_FW_SESSION = 0x155, rights, row | slot << 16). Five pushes plus a 32-byte frame (72 bytes; entry rsp%16 == 8, so rsp%16 == 0 at every nested call -- paideia-as emits no rbp prologue, so the pushed total is the whole of the alignment) hold slot/parent/rights/scope/len in r12/r13/r14/r15/rbx with domain at [rsp+0], eid at [rsp+8] and the object index at [rsp+16]. Labels prefixed fws_mi_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 32;

        mov r12, rdi;                    // slot
        mov r13, rsi;                    // parent_slot
        mov r14, rdx;                    // rights
        mov r15, rcx;                    // scope_ptr
        mov rbx, r8;                     // path_len
        mov [rsp + 0], r9;               // domain

        mov r11, 256;
        cmp r12, r11;
        jae fws_mi_badarg;

        mov rdi, r13;
        call fw_session_check_parent_endpoint;
        cmp rax, 0;
        je fws_mi_badparent;

        mov rdi, r14;
        call fw_session_rights_valid;
        cmp rax, 0;
        je fws_mi_badrights;

        mov rax, [rsp + 0];
        cmp rax, 8;                      // FW_DOMAIN_MAX
        jae fws_mi_baddom;

        // ---- the inherited identity ----
        mov rdi, r13;
        call fw_session_parent_eid;
        mov [rsp + 8], rax;

        // ---- THE SECOND HALF OF THE GATE ----
        mov rdi, [rsp + 8];
        call fw_ep_domains;
        cmp rax, 0;
        je fws_mi_noep;

        // Test bit `domain` of the mask. A variable-count shift is not
        // in the mnemonic table, and a bounded walk is clearer than a
        // lookup table for eight positions -- domain < 8 was checked
        // above, so this terminates in at most eight iterations.
        mov rcx, [rsp + 0];
      fws_mi_shift:
        cmp rcx, 0;
        je fws_mi_tested;
        shr rax, 1;
        sub rcx, 1;
        jmp fws_mi_shift;
      fws_mi_tested:
        and rax, 1;
        cmp rax, 0;
        je fws_mi_noep;

        // ---- the object: found, or created ----
        mov rdi, r15;
        mov rsi, rbx;
        mov rdx, [rsp + 0];
        call fw_object_alloc;
        cmp rax, 8;
        jae fws_mi_objfail;              // any code >= FW_OBJECT_MAX is an error
        mov [rsp + 16], rax;

        // ---- the session row ----
        mov rdi, [rsp + 16];
        mov rsi, [rsp + 0];
        mov rdx, r13;
        call fw_session_row_alloc;
        cmp rax, 16;
        jae fws_mi_rowfail;

        // ---- the descriptor ----
        mov r9, rax;                     // row id
        mov rdi, r12;
        mov rsi, 0x155;                  // KIND_FW_SESSION
        mov rdx, r14;
        mov rcx, r12;
        shl rcx, 16;
        or rcx, r9;                      // target_ptr = row | slot << 16
        call cap_mint_write;
        xor rax, rax;                    // FW_SESSION_OK
        jmp fws_mi_out;

      fws_mi_objfail:
        // fw_object_alloc already chose the specific code
        jmp fws_mi_out;

      fws_mi_rowfail:
        jmp fws_mi_out;

      fws_mi_badarg:
        mov rax, 0xFFFFFE1F;
        jmp fws_mi_out;
      fws_mi_badparent:
        mov rax, 0xFFFFFE1E;
        jmp fws_mi_out;
      fws_mi_badrights:
        mov rax, 0xFFFFFE1D;
        jmp fws_mi_out;
      fws_mi_noep:
        mov rax, 0xFFFFFE1C;
        jmp fws_mi_out;
      fws_mi_baddom:
        mov rax, 0xFFFFFE1B;

      fws_mi_out:
        add rsp, 32;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // REVOKE.
  // ==========================================================================

  pub let fw_session_cap_revoke : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R30.M8-002 (#1083): revoke a KIND_FW_SESSION. Reads the row id out of the DESCRIPTOR (target_ptr bits [15:0]), never from an argument. RELEASES THE CLAIM IF THIS SESSION HELD IT, unconditionally and at every depth -- a revoked session cannot release its own claim afterwards, and a claim left held by a dead session would exclude every other writer on that object forever, which is a firmware object permanently frozen by a driver that has already exited. Then frees the row, decrements the object's refcount, and frees the OBJECT ROW at refcount 0 so the table is reusable across a boot rather than monotonically consumed. Idempotent: a second revoke is FW_SESSION_REVOKE_ALREADY, which is a distinct answer from success because a caller revoking twice has a bookkeeping bug worth surfacing. Labels prefixed fws_rk_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        sub rsp, 8;                      // 32 + 8 = 40; rsp%16 == 0 at the call

        mov r12, rdi;
        mov r11, 256;
        cmp r12, r11;
        jae fws_rk_badslot;

        lea rax, [rip + cap_table];
        mov r8, r12;
        shl r8, 3;
        mov r9, r12;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov rcx, rax;
        mov rax, [rcx + 0];
        mov rdx, 0x155;
        cmp rax, rdx;
        jne fws_rk_wrongkind;

        mov r13, [rcx + 16];
        mov r10, 0xFFFF;
        and r13, r10;                    // row id, from the descriptor

        cmp r13, 16;
        jae fws_rk_badslot;

        lea rcx, [rip + _fw_session_table];
        mov r8, r13;
        shl r8, 4;
        add r8, rcx;                     // r8 = &row
        mov rax, [r8 + 0];
        shr rax, 56;
        cmp rax, 0;
        je fws_rk_already;

        // ---- the object this session named ----
        mov r14, [r8 + 8];               // object index

        // ---- drop the claim if it was ours, at ANY depth ----
        mov rax, r14;
        shl rax, 7;
        lea rbx, [rip + _fw_object_table];
        add rbx, rax;
        mov rax, [rbx + 8];
        mov rcx, r13;
        add rcx, 1;
        cmp rax, rcx;
        jne fws_rk_noclaim;
        xor rax, rax;
        mov [rbx + 8], rax;
        mov [rbx + 16], rax;

      fws_rk_noclaim:
        // ---- free the session row ----
        lea rcx, [rip + _fw_session_table];
        mov rdx, r13;
        shl rdx, 4;
        add rdx, rcx;
        xor rax, rax;
        mov [rdx + 0], rax;
        mov [rdx + 8], rax;

        // ---- release the object reference ----
        mov rax, [rbx + 24];
        cmp rax, 0;
        je fws_rk_freeobj;
        sub rax, 1;
        mov [rbx + 24], rax;
        cmp rax, 0;
        jne fws_rk_ok;

      fws_rk_freeobj:
        // last session gone: the object row returns to the pool
        xor rax, rax;
        mov [rbx + 0], rax;
        mov [rbx + 8], rax;
        mov [rbx + 16], rax;
        mov [rbx + 24], rax;

      fws_rk_ok:
        // the descriptor itself
        mov rdi, r12;
        mov rsi, 0;
        mov rdx, 0;
        mov rcx, 0;
        call cap_mint_write;
        xor rax, rax;
        jmp fws_rk_out;

      fws_rk_already:
        mov rax, 0xFFFFFE12;
        jmp fws_rk_out;
      fws_rk_wrongkind:
        mov rax, 0xFFFFFE13;
        jmp fws_rk_out;
      fws_rk_badslot:
        mov rax, 0xFFFFFE14;

      fws_rk_out:
        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Ops, and the required right.
  // ==========================================================================

  pub let FW_SESSION_OP_QUERY_OBJ    : u64 = 0   // INVOKE  -> object index
  pub let FW_SESSION_OP_QUERY_DOMAIN : u64 = 1   // INVOKE  -> domain
  pub let FW_SESSION_OP_QUERY_HOLDER : u64 = 2   // OBSERVE -> holder + 1
  pub let FW_SESSION_OP_QUERY_DEPTH  : u64 = 3   // OBSERVE -> claim depth
  pub let FW_SESSION_OP_CLAIM        : u64 = 4   // WRITE
  pub let FW_SESSION_OP_UNCLAIM      : u64 = 5   // WRITE
  pub let FW_SESSION_OP_DEBUG_PRINT  : u64 = 6   // OBSERVE
  pub let FW_SESSION_OP_MAX          : u64 = 6

  pub let cap_handler_fw_session : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R30.M8-002 (#1083): KIND_FW_SESSION dispatch handler. row = target_ptr[15:0] -- from the DESCRIPTOR, which only the kernel writes; op = op_arg[7:0], upper 56 bits DISCARDED, which closes the channel a caller might use to smuggle an object index or a scope pointer into the invocation. NO OP REACHABLE HERE TAKES AN OBJECT, A SCOPE OR A DOMAIN: the object a session acts on comes from its own row and nowhere else, which is the confinement discipline #1075 established for GPIO pins applied to firmware objects. Ops 0..1 require RIGHT_INVOKE (0x008); ops 2..3 and 6 require RIGHT_OBSERVE (0x400); THE CLAIM OPS 4..5 REQUIRE RIGHT_WRITE (0x002) -- taking the writer claim is a write-class action even though it stores nothing in the object, because its whole effect is to exclude other writers, and a read-only holder that could exclude writers could stall the platform stack without ever having been granted authority over it. Unknown op -> INVOKE_UNSUPPORTED (0xFFFFFFFFFFFFFFFC); rights failure -> INVOKE_DENIED (0xFFFFFFFFFFFFFFFD). Queries return FW_SESSION_DECODE_BAD for a dead row, never a plausible zero -- object 0, domain 0 and depth 0 are each values a live row can legitimately hold. r12=rights, r13=row, r14=op; three pushes plus the frame leave rsp%16 == 0 at every nested call. Labels prefixed fws_h_ per reserved-label discipline.",
      block: {
        push r12;
        push r13;
        push r14;
        sub rsp, 16;                     // 24 + 16 = 40; rsp%16 == 0 at the call

        mov r12, rdi;                    // rights
        mov r13, rsi;
        mov r10, 0xFFFF;
        and r13, r10;                    // row id
        mov r14, rdx;
        and r14, 0xFF;                   // op

        cmp r14, 6;                      // FW_SESSION_OP_MAX
        ja fws_h_unsup;

        cmp r14, 1;
        jbe fws_h_need_invoke;
        cmp r14, 3;
        jbe fws_h_need_observe;
        cmp r14, 5;
        jbe fws_h_need_write;
        jmp fws_h_need_observe;          // op 6, DEBUG_PRINT

      fws_h_need_invoke:
        mov rax, r12;
        and rax, 0x008;
        cmp rax, 0;
        je fws_h_denied;
        jmp fws_h_go;
      fws_h_need_observe:
        mov rax, r12;
        and rax, 0x400;
        cmp rax, 0;
        je fws_h_denied;
        jmp fws_h_go;
      fws_h_need_write:
        mov rax, r12;
        and rax, 0x002;
        cmp rax, 0;
        je fws_h_denied;

      fws_h_go:
        cmp r14, 0;
        je fws_h_obj;
        cmp r14, 1;
        je fws_h_domain;
        cmp r14, 2;
        je fws_h_holder;
        cmp r14, 3;
        je fws_h_depth;
        cmp r14, 4;
        je fws_h_claim;
        cmp r14, 5;
        je fws_h_unclaim;

        // op 6: the canonical dump
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_BOOT];
        lea rdx, [rip + fws_dbg_msg];
        lea rcx, [rip + fws_k_row];
        mov r8, r13;
        call klog_s1_d1;
        xor rax, rax;
        jmp fws_h_out;

      fws_h_obj:
        mov rdi, r13;
        call fw_session_row_obj;
        jmp fws_h_out;
      fws_h_domain:
        mov rdi, r13;
        call fw_session_row_domain;
        jmp fws_h_out;
      fws_h_holder:
        mov rdi, r13;
        call fw_session_row_obj;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je fws_h_out;
        mov rdi, rax;
        call fw_object_holder;
        jmp fws_h_out;
      fws_h_depth:
        mov rdi, r13;
        call fw_session_row_obj;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je fws_h_out;
        mov rdi, rax;
        call fw_object_depth;
        jmp fws_h_out;
      fws_h_claim:
        mov rdi, r13;
        call fw_session_claim;
        jmp fws_h_out;
      fws_h_unclaim:
        mov rdi, r13;
        call fw_session_unclaim;
        jmp fws_h_out;

      fws_h_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;     // INVOKE_DENIED
        jmp fws_h_out;
      fws_h_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;     // INVOKE_UNSUPPORTED

      fws_h_out:
        add rsp, 16;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }
}
