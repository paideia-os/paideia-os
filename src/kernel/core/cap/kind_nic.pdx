// src/kernel/core/cap/kind_nic.pdx -- R91.M1-001 (paideia-os #2011)
//
// KIND_NIC = 0x1AD, derived over KIND_DEVICE (= slot 10).
//
// The device-level capability for one NIC's identity + link state. Row
// substrate + mint gate + row accessors + cap_invoke dispatch handler
// all in one file, mirroring the compact posture kind_tls_trust.pdx +
// cap_handler_tls_trust.pdx split takes -- but folded into a single
// module because KIND_NIC's op surface is deliberately tiny (three
// QUERY ops, all under one right) and the two-file split adds no
// modularity a real second consumer needs at this landing.
//
// The design-doc row for this ordinal lives in
// design/architecture/next-wave-derived-kinds.md (the 0x1AD entry landed
// alongside this file); the KIND_NIC constant + BASE alias live in
// src/kernel/core/cap/kind.pdx immediately after KIND_UDP_SOCKET, and
// the cap_invoke_dispatch branch (`mov r9, 0x1AD; cmp rcx, r9; je
// call_kind_nic`) is added in src/kernel/core/cap/invoke.pdx alongside
// the KIND_TLS_TRUST (0x1A7) arm above it.
//
// =============================================================================
// SECTION 0  WHY KIND_NIC DERIVES OVER KIND_DEVICE
// =============================================================================
//
// A NIC is a PCI function (or, for virtio-net under QEMU, a virtio
// device transport backed by a PCI function). Every PCI function in the
// machine is already a KIND_DEVICE per the R31.M3 discipline this file
// family reuses -- see kind_battery.pdx §2, kind_thermal_zone.pdx §5.
// The kind half of the derivation gate therefore discriminates NOTHING
// on its own (a raw KIND_DEVICE holder could be any PCI function); what
// the mint additionally enforces is a plausible nic_kind selector, a
// well-formed link_state, and the parent capability carrying RIGHT_MINT.
// "This device is a NIC" is a class-code / probe-time fact the ring-3
// supervisor distills, and the KIND_NIC capability is the record of ITS
// decision -- the same honest division kind_battery §2 writes down.
//
// R91 planning originally reserved 0x1A7 for KIND_NIC; R100-PREP-001
// (#2007) landed KIND_TLS_TRUST at 0x1A7 first because that reservation
// was placeholder-only (no kind file, no dispatch, no witness). The
// R91.M1-001 landing therefore reallocates from the next free tag per
// design/architecture/next-wave-derived-kinds.md's tail summary --
// 0x1AB/0x1AC are TCP (fix#2005 relocation), 0x1AD is the next free slot
// past the R91-R99 networking reservation block. See kind.pdx §KIND_NIC
// for the full ordinal-reallocation rationale.
//
// =============================================================================
// SECTION 1  TAIL ENCODING
// =============================================================================
//
// Row layout (16 bytes, two u64 words):
//
//   [+0] header (u64):
//        in_use    [63:56] (allocator flag; 0=free, 1=live)
//        reserved  [55:16]
//        link_state[15:8]  (0=DOWN, 1=UP; NIC_LINK_MAX = 1)
//        nic_kind  [7:0]   (0=NONE, 1=E1000E, 2=VIRTIO, 3=RTL8139;
//                           NIC_KIND_MAX = 3)
//
//   [+8] mac_word (u64):
//        mac_bytes [47:0]  (six MAC bytes packed little-endian: byte 0
//                           in bits [7:0], byte 5 in bits [47:40]; this
//                           is the canonical on-wire order for a NIC
//                           MAC read via config-space or MMIO)
//        reserved  [63:48] (must be zero on mint)
//
// Row-addressed capacity: NIC_MAX = 4 rows. Rationale: T14 G4 census
// (design/drivers/architecture.md §2) shows at most two NICs in the
// class of laptop this kernel targets (one wired-Ethernet at boot for
// bring-up, one wireless once R38/R39 wire drivers land as separate
// KIND_WIFI_VIF children). Four is one power-of-two above that ceiling,
// leaving headroom for the R91.M2 virtio-net-under-QEMU witness to mint
// a synthetic third alongside real hardware without inflating the pool.
//
// =============================================================================
// SECTION 2  RIGHTS  --  R_NIC_QUERY (0x001) ONLY
// =============================================================================
//
//   R_NIC_QUERY (0x001) -- gate every op in cap_handler_nic.
//
// No R_NIC_WRITE, no R_NIC_INVOKE, no R_NIC_MINT, no R_NIC_REVOKE at
// this landing: KIND_NIC is a *static-identity* capability at R91.M1-001.
// The three QUERY ops are the entire surface. Later milestones that
// wire real driver bring-up (rx/tx ring authority, MAC programming,
// link renegotiation) will do so via SEPARATE derived kinds -- the same
// discipline KIND_TB_DOMAIN + KIND_TB_ROUTE take under KIND_DEVICE, so
// that a subscriber that only needs to know which NIC exists cannot
// promote itself into one that can drive the wire.
//
// R_NIC_ALL = R_NIC_QUERY = 0x001. Subset test in nic_rights_valid uses
// that constant.
//
// =============================================================================
// SECTION 3  FAILURE TAXONOMY  0xFFFFEB28..0xFFFFEB2F
// =============================================================================
//
// A repo-wide audit at landing time (grep -rEho '0xFFFFEB[0-9A-Fa-f]{2}'
// under src/kernel/) shows the 0xFFFFEB28..0xFFFFEB2F page is entirely
// free -- kind_tls_trust.pdx §3 explicitly reserved it as the "next
// free R100-adjacent band". This file claims all eight codes; disjoint
// from KIND_SIG_KEY's 0xFFFFEB00..0xFFFFEB0F, KIND_TUI_CANVAS's
// 0xFFFFEB10..0xFFFFEB1F and KIND_TLS_TRUST's 0xFFFFEB20..0xFFFFEB27.
//
// =============================================================================
// SECTION 4  ENCODER DISCIPLINE
// =============================================================================
//
// Kind-tag constant 0x1AD (KIND_NIC) sits in the same 0x100..0xFFF band
// as the sibling R100 kinds and does not sign-extend cleanly from a
// 32-bit immediate for `cmp reg, imm` forms, so every compare against
// it stages through r11 first (matches kind_tls_trust.pdx §4). KIND_
// DEVICE (10) needs no staging. Rights bits stage through r11 the same
// way for the RIGHT_MINT (0x200) check. No mov_b / mov_w / mov_d
// anywhere; every sub-field is packed / unpacked via shift + mask in
// full 64-bit registers. No `test`, no `add reg, [mem]`, no `cmp reg,
// [mem]`. Every label in this file is prefixed `kn_` (kind-nic) or
// `kn_hn_` (handler) per reserved-word discipline (`loop`/`if` etc. are
// keywords).

module KindNic = structure {

  pub let KIND_NIC      : u64 = 0x1AD
  pub let KIND_NIC_BASE : u64 = 10        // = KIND_DEVICE (LAM-hint slot)

  // nic_kind selector (§1).
  pub let NIC_KIND_NONE    : u64 = 0
  pub let NIC_KIND_E1000E  : u64 = 1
  pub let NIC_KIND_VIRTIO  : u64 = 2
  pub let NIC_KIND_RTL8139 : u64 = 3
  pub let NIC_KIND_MAX     : u64 = 3

  // link_state selector (§1).
  pub let NIC_LINK_DOWN : u64 = 0
  pub let NIC_LINK_UP   : u64 = 1
  pub let NIC_LINK_MAX  : u64 = 1

  // Rights (§2). Immutable-once-minted at this landing.
  pub let R_NIC_QUERY : u64 = 0x001
  pub let R_NIC_ALL   : u64 = 0x001

  // Ops (all arity-one, all gated on R_NIC_QUERY).
  pub let NIC_OP_QUERY_KIND : u64 = 0
  pub let NIC_OP_QUERY_MAC  : u64 = 1
  pub let NIC_OP_QUERY_LINK : u64 = 2
  pub let NIC_OP_MAX        : u64 = 2

  // Failure taxonomy (§3). 0xFFFFEB28..0xFFFFEB2F band.
  pub let NIC_OK              : u64 = 0
  pub let NIC_MINT_BAD_PARENT : u64 = 0xFFFFEB2F
  pub let NIC_MINT_BAD_KIND   : u64 = 0xFFFFEB2E
  pub let NIC_MINT_BAD_LINK   : u64 = 0xFFFFEB2D
  pub let NIC_MINT_BAD_RIGHTS : u64 = 0xFFFFEB2C
  pub let NIC_TAIL_BAD_ARG    : u64 = 0xFFFFEB2B
  pub let NIC_TAIL_ENOSPC     : u64 = 0xFFFFEB2A
  pub let NIC_BAD_SLOT        : u64 = 0xFFFFEB29
  pub let NIC_BAD_RIGHTS      : u64 = 0xFFFFEB28

  pub let NIC_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let NIC_ROW_NONE   : u64 = 0xFF

  // Ceilings.
  pub let NIC_MAX       : u64 = 4
  pub let NIC_ROW_BYTES : u64 = 16

  // NIC_MAX * NIC_ROW_BYTES = 64 bytes = 8 u64.
  pub let mut _nic_table : [u64; 8] = uninit @align(64)
  pub let mut _nic_stats : [u64; 8] = uninit @align(64)

  pub let NIC_ST_MINTS   : u64 = 0
  pub let NIC_ST_QUERIES : u64 = 1
  pub let NIC_ST_REFUSED : u64 = 2
  pub let NIC_ST_MAX     : u64 = 8

  // Fingerprint. Emitted once on successful mint only -- no fingerprint
  // on QUERY (which is the hot path once a real ISR / RX ring lands and
  // one line per packet would flood the ring, matching TLS_TRUST_ST_
  // QUERIES's no-fingerprint discipline).
  pub let nic_mint_ok_msg : [u8; 34] = "nic mint ok [legacy: NIC MINT OK]\0"
  pub let nic_k_row       : [u8; 4]  = "row\0"

  // ==========================================================================
  // nic_table_reset() -> ()
  //
  // Clear every row and every counter. Boot and teardown only. Two
  // separate loops mirror tls_trust_table_reset one-for-one.
  // ==========================================================================
  pub let nic_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R91.M1-001 (paideia-os #2011): clear every _nic_table row and every _nic_stats counter. Boot and teardown only. .bss is already zero at real boot; this is defensive (matches KIND_TLS_TRUST tls_trust_table_reset / KIND_TUI_CANVAS kind_tui_canvas_init shape) and gives a future witness a clean re-scrub point. Labels prefixed kn_rs_.",
      block: {
        lea r10, [rip + _nic_table];
        xor rax, rax;
        xor rcx, rcx;
      kn_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  kn_rs_rows;

        lea r10, [rip + _nic_stats];
        xor rcx, rcx;
      kn_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  kn_rs_stats;
        ret
      }
    }

  pub let nic_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R91.M1-001 (paideia-os #2011): bounded increment on _nic_stats; out-of-range no-op. Load-inc-store idiom, no `add reg, [mem]`. Labels prefixed kn_nt_.",
      block: {
        cmp rdi, 8;
        jae kn_nt_out;
        lea r10, [rip + _nic_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      kn_nt_out:
        ret
      }
    }

  // ==========================================================================
  // Validators.
  // ==========================================================================

  // nic_kind_valid(nk) -> 1 iff nk in [0, NIC_KIND_MAX = 3]. NONE (0)
  // is a LEGAL value at this landing: a KIND_NIC minted as a placeholder
  // for a slot the supervisor has not yet identified the concrete NIC
  // for should still be well-formed, which is the whole point of
  // deriving over KIND_DEVICE rather than over a concrete-driver kind.
  pub let nic_kind_valid : (u64) -> u64 !{} @{} =
    fn (nk: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R91.M1-001 (paideia-os #2011): 1 iff nk in [0, NIC_KIND_MAX = 3]. NONE (0) is legal at this landing (see file header). Labels prefixed kn_kv_.",
      block: {
        mov r10, 3;
        cmp rdi, r10;
        ja  kn_kv_no;
        mov rax, 1;
        ret;
      kn_kv_no:
        xor rax, rax;
        ret
      }
    }

  // nic_link_valid(ls) -> 1 iff ls in [0, NIC_LINK_MAX = 1].
  pub let nic_link_valid : (u64) -> u64 !{} @{} =
    fn (ls: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R91.M1-001 (paideia-os #2011): 1 iff ls in [0, NIC_LINK_MAX = 1]. Labels prefixed kn_lv_.",
      block: {
        mov r10, 1;
        cmp rdi, r10;
        ja  kn_lv_no;
        mov rax, 1;
        ret;
      kn_lv_no:
        xor rax, rax;
        ret
      }
    }

  // nic_rights_valid(rights) -> 1 iff subset of R_NIC_ALL. Immutability
  // (§2) means the only sensible rights value on a minted cap is
  // R_NIC_QUERY itself; anything else is a caller bug.
  pub let nic_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R91.M1-001 (paideia-os #2011): subset test against R_NIC_ALL = 0x001. Labels prefixed kn_rv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x001;                  // R_NIC_ALL
        and rax, r10;
        cmp rax, rdi;
        jne kn_rv_no;
        mov rax, 1;
        ret;
      kn_rv_no:
        xor rax, rax;
        ret
      }
    }

  // nic_check_parent_device(parent_slot) -> 1 iff
  // cap_table[parent_slot].kind == KIND_DEVICE (10) AND rights carry
  // RIGHT_MINT (0x200). Mirrors battery_check_parent_device one-for-one
  // (KIND_DEVICE derivation gate).
  pub let nic_check_parent_device : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R91.M1-001 (paideia-os #2011): first half of the KIND_NIC derivation gate. Bounds-check parent_slot < 256; load the descriptor at cap_table + slot*24 (stride 24 per cap/mint.pdx); require kind ([+0]) == KIND_DEVICE (10) AND (rights & RIGHT_MINT 0x200) != 0. THIS HALF DISCRIMINATES NOTHING and the mint does not treat it as though it did (§0). Pure read (@{cap} because it inspects cap_table). Labels prefixed kn_cpd_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae kn_cpd_no;

        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 10;                     // KIND_DEVICE
        jne kn_cpd_no;

        mov r10, [rax + 8];
        mov r11, 0x200;                  // RIGHT_MINT
        and r10, r11;
        cmp r10, 0;
        je  kn_cpd_no;

        mov rax, 1;
        ret;

      kn_cpd_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Packers.
  // ==========================================================================

  // nic_hdr_pack(nic_kind, link_state) -> hdr | NIC_DECODE_BAD.
  //
  // Packs nic_kind into bits [7:0] and link_state into bits [15:8]. Bits
  // [63:56] must leave this function zero -- that byte belongs to the
  // allocator's in_use flag (set by tail_alloc on the claim path).
  pub let nic_hdr_pack : (u64, u64) -> u64 !{} @{} =
    fn (nic_kind: u64) (link_state: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R91.M1-001 (paideia-os #2011): canonical header encoder. nic_kind in [0, 3] fits [7:0]; link_state in [0, 1] fits [15:8]. NIC_DECODE_BAD (~0) on out-of-range input. Bits [63:56] left zero for the allocator's in_use flag. Labels prefixed kn_hp_.",
      block: {
        mov r10, 3;
        cmp rdi, r10;
        ja  kn_hp_bad;
        mov r10, 1;
        cmp rsi, r10;
        ja  kn_hp_bad;

        mov rax, rdi;                    // nic_kind in [7:0]
        mov r10, rsi;
        shl r10, 8;                      // link_state in [15:8]
        or  rax, r10;
        ret;

      kn_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // nic_mac_valid(mac_word) -> 1 iff mac_word[63:48] == 0.
  // A caller-supplied MAC with the reserved upper 16 bits set is a bug
  // (the on-wire MAC is 48 bits), refused rather than masked so a
  // smuggled second value in those bits is diagnosable.
  pub let nic_mac_valid : (u64) -> u64 !{} @{} =
    fn (mac_word: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R91.M1-001 (paideia-os #2011): 1 iff mac_word[63:48] == 0. A NIC MAC is 48 bits; the upper 16 bits of the packed word are reserved and must be zero. Refused, not masked. Labels prefixed kn_mv_.",
      block: {
        mov rax, rdi;
        shr rax, 48;
        cmp rax, 0;
        jne kn_mv_no;
        mov rax, 1;
        ret;
      kn_mv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Row pool: row_valid / tail_alloc / tail_free.
  // ==========================================================================

  // nic_row_valid(idx) -> 1 iff idx < NIC_MAX and the row's in_use byte
  // is set. Inlined address compute (idx*16 via shl 4) rather than a
  // nested call, keeping this a pure leaf -- mirrors tls_trust_row_valid.
  pub let nic_row_valid : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R91.M1-001 (paideia-os #2011): 1 iff idx < NIC_MAX(4) and in_use byte set. Inlined address compute (idx*16 via shl 4). Labels prefixed kn_rv2_.",
      block: {
        mov r10, 4;
        cmp rdi, r10;
        jae kn_rv2_no;
        lea r10, [rip + _nic_table];
        mov r11, rdi;
        shl r11, 4;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  kn_rv2_no;
        mov rax, 1;
        ret;
      kn_rv2_no:
        xor rax, rax;
        ret
      }
    }

  // nic_tail_alloc(hdr, mac_word) -> row_id | NIC_TAIL_*
  //
  // THE ONLY WRITER of _nic_table on the allocate path. Low-first scan
  // over 4 rows of 16 bytes. hdr in_use pre-set is a bug -> NIC_TAIL_
  // BAD_ARG. mac_word[63:48] non-zero is a bug -> NIC_TAIL_BAD_ARG (see
  // nic_mac_valid). Header write is LAST: in_use bit is set via OR with
  // (1 << 56) in the same qword store, matching tls_trust_tail_alloc's
  // "publish in_use last" ordering.
  pub let nic_tail_alloc : (u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (mac_word: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R91.M1-001 (paideia-os #2011): claim one NIC row. THE ONLY WRITER of _nic_table on the allocate path. Gates: hdr in_use pre-set (bits [63:56] non-zero) -> NIC_TAIL_BAD_ARG; mac_word[63:48] non-zero -> NIC_TAIL_BAD_ARG. Low-first scan over 4 rows of 16 bytes (idx*16 via shl 4). On claim: writes mac_word to [row+8], then the header with in_use=1 to [row+0]. Three callee-save pushes (rbx/r12/r13) preserve loop-carried state across the internal scan; no nested calls, so no additional stack alignment padding is needed. Labels prefixed kn_ta_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                    // hdr
        mov r12, rsi;                    // mac_word

        // hdr in_use pre-set?
        mov rax, rbx;
        shr rax, 56;
        cmp rax, 0;
        jne kn_ta_bad;

        // mac_word[63:48] non-zero?
        mov rax, r12;
        shr rax, 48;
        cmp rax, 0;
        jne kn_ta_bad;

        xor r13, r13;                    // row cursor idx = 0
      kn_ta_scan:
        cmp r13, 4;                      // NIC_MAX
        jae kn_ta_enospc;

        lea r10, [rip + _nic_table];
        mov r11, r13;
        shl r11, 4;                      // idx * 16
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  kn_ta_claim;

        add r13, 1;
        jmp kn_ta_scan;

      kn_ta_claim:
        // mac_word first.
        mov [r10 + 8], r12;

        // Header last: hdr | in_use=1.
        mov rax, rbx;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0], rax;

        mov rax, r13;                    // row_id
        jmp kn_ta_out;

      kn_ta_enospc:
        mov rax, 0xFFFFEB2A;             // NIC_TAIL_ENOSPC
        jmp kn_ta_out;
      kn_ta_bad:
        mov rax, 0xFFFFEB2B;             // NIC_TAIL_BAD_ARG

      kn_ta_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // nic_tail_free(row_id) -> (). Scrub the whole 16-byte row.
  pub let nic_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R91.M1-001 (paideia-os #2011): scrub one row (both u64 words). Labels prefixed kn_tf_.",
      block: {
        mov r10, 4;
        cmp rdi, r10;
        jae kn_tf_out;
        lea r10, [rip + _nic_table];
        mov r11, rdi;
        shl r11, 4;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0], rax;
        mov [r10 + 8], rax;
      kn_tf_out:
        ret
      }
    }

  // ==========================================================================
  // Row accessors. Each returns NIC_DECODE_BAD when the row is not live,
  // matching kind_tls_trust.pdx / kind_pdxfs_mount_table.pdx discipline.
  // These are the public surface cap_handler_nic's QUERY_* ops thread
  // through.
  // ==========================================================================

  pub let nic_row_nic_kind : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R91.M1-001 (paideia-os #2011): nic_kind (header bits [7:0]) or NIC_DECODE_BAD. Labels prefixed kn_rk_.",
      block: {
        push r12;
        mov r12, rdi;
        call nic_row_valid;
        cmp rax, 0;
        je  kn_rk_bad;
        lea r10, [rip + _nic_table];
        mov r11, r12;
        shl r11, 4;
        add r10, r11;
        mov rax, [r10 + 0];
        mov r10, 0xFF;
        and rax, r10;
        jmp kn_rk_out;
      kn_rk_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      kn_rk_out:
        pop r12;
        ret
      }
    }

  pub let nic_row_link : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R91.M1-001 (paideia-os #2011): link_state (header bits [15:8]) or NIC_DECODE_BAD. Labels prefixed kn_rl_.",
      block: {
        push r12;
        mov r12, rdi;
        call nic_row_valid;
        cmp rax, 0;
        je  kn_rl_bad;
        lea r10, [rip + _nic_table];
        mov r11, r12;
        shl r11, 4;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 8;
        mov r10, 0xFF;
        and rax, r10;
        jmp kn_rl_out;
      kn_rl_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      kn_rl_out:
        pop r12;
        ret
      }
    }

  pub let nic_row_mac : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R91.M1-001 (paideia-os #2011): mac_word[47:0] or NIC_DECODE_BAD. Labels prefixed kn_rm_.",
      block: {
        push r12;
        mov r12, rdi;
        call nic_row_valid;
        cmp rax, 0;
        je  kn_rm_bad;
        lea r10, [rip + _nic_table];
        mov r11, r12;
        shl r11, 4;
        add r10, r11;
        mov rax, [r10 + 8];
        mov r10, 0xFFFFFFFFFFFF;
        and rax, r10;
        jmp kn_rm_out;
      kn_rm_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      kn_rm_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // kind_nic_mint_body(parent_slot, rights, nic_kind, link_state, mac_word)
  //   -> row_id | NIC_MINT_*
  //
  // The KIND_NIC mint walker. Not reachable via cap_invoke (§2's rights
  // set omits MINT); called from supervisor / driver-bringup code that
  // already holds a root KIND_DEVICE parent cap with RIGHT_MINT. On
  // success emits the mint fingerprint via klog_s1_x1(LEVEL_INFO,
  // SUBSYS_CAP_, nic_mint_ok_msg, nic_k_row, row_id) once -- matches
  // KIND_SIG_KEY / KIND_TLS_TRUST / KIND_TUI_CANVAS mint-emit discipline;
  // no fingerprint on QUERY.
  //
  // Gate order: (1) parent (KIND_DEVICE + RIGHT_MINT); (2) rights
  // subset; (3) nic_kind; (4) link_state; (5) mac_word reserved bits;
  // (6) hdr_pack; (7) tail_alloc.
  //
  // Six callee-save pushes + sub rsp,8 leave rsp%16==0 for every nested
  // call (entry rsp%16==8, +48+8=56 -> %16==0). Register plan: r12=
  // parent_slot, r13=rights, r14=nic_kind, r15=link_state, rbp=mac_word,
  // rbx=hdr (packed) then reused as scratch after tail_alloc returns.
  // ==========================================================================
  pub let kind_nic_mint_body : (u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (parent_slot: u64) (rights: u64) (nic_kind: u64) (link_state: u64) (mac_word: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R91.M1-001 (paideia-os #2011): mint KIND_NIC over KIND_DEVICE. Gate order: (1) parent (nic_check_parent_device: KIND_DEVICE(10)+RIGHT_MINT); (2) rights subset (nic_rights_valid); (3) nic_kind (nic_kind_valid: [0, NIC_KIND_MAX=3]); (4) link_state (nic_link_valid: [0, NIC_LINK_MAX=1]); (5) mac_word reserved (nic_mac_valid: [63:48]==0); (6) nic_hdr_pack; (7) nic_tail_alloc(hdr, mac_word). Register plan: r12=parent_slot, r13=rights, r14=nic_kind, r15=link_state, rbp=mac_word, rbx=hdr -- all live across the klog_s1_x1 call which preserves rbx/rbp/r12-r15 per SysV. Six callee-save pushes + sub rsp,8 = 56 bytes: entry rsp%16==8, +56 -> %16==0 for every nested call. On success emits the mint fingerprint once. Refusal paths bump NIC_ST_REFUSED through the shared kn_mi_refused funnel (mirrors kind_tls_trust.pdx tlst_mi_refused). Labels prefixed kn_mi_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;
        sub rsp, 8;

        mov r12, rdi;                    // parent_slot
        mov r13, rsi;                    // rights
        mov r14, rdx;                    // nic_kind
        mov r15, rcx;                    // link_state
        mov rbp, r8;                     // mac_word

        // (1) Parent gate.
        mov rdi, r12;
        call nic_check_parent_device;
        cmp rax, 0;
        je  kn_mi_bad_parent;

        // (2) Rights subset.
        mov rdi, r13;
        call nic_rights_valid;
        cmp rax, 0;
        je  kn_mi_bad_rights;

        // (3) nic_kind.
        mov rdi, r14;
        call nic_kind_valid;
        cmp rax, 0;
        je  kn_mi_bad_kind;

        // (4) link_state.
        mov rdi, r15;
        call nic_link_valid;
        cmp rax, 0;
        je  kn_mi_bad_link;

        // (5) mac_word reserved bits.
        mov rdi, rbp;
        call nic_mac_valid;
        cmp rax, 0;
        je  kn_mi_bad_arg;

        // (6) Pack header.
        mov rdi, r14;
        mov rsi, r15;
        call nic_hdr_pack;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  kn_mi_bad_arg;
        mov rbx, rax;                    // hdr

        // (7) tail_alloc(hdr, mac_word).
        mov rdi, rbx;
        mov rsi, rbp;
        call nic_tail_alloc;
        mov r10, 4;                      // NIC_MAX
        cmp rax, r10;
        jae kn_mi_alloc_fail;

        mov rbx, rax;                    // rbx = row_id (hdr no longer needed)

        mov rdi, 0;                      // NIC_ST_MINTS
        call nic_note;

        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + nic_mint_ok_msg];
        lea rcx, [rip + nic_k_row];
        mov r8,  rbx;                    // row_id
        call klog_s1_x1;

        mov rax, rbx;
        jmp kn_mi_out;

      kn_mi_alloc_fail:
        // rax already holds a NIC_TAIL_* sentinel.
        jmp kn_mi_refused;
      kn_mi_bad_parent:
        mov rax, 0xFFFFEB2F;             // NIC_MINT_BAD_PARENT
        jmp kn_mi_refused;
      kn_mi_bad_rights:
        mov rax, 0xFFFFEB2C;             // NIC_MINT_BAD_RIGHTS
        jmp kn_mi_refused;
      kn_mi_bad_kind:
        mov rax, 0xFFFFEB2E;             // NIC_MINT_BAD_KIND
        jmp kn_mi_refused;
      kn_mi_bad_link:
        mov rax, 0xFFFFEB2D;             // NIC_MINT_BAD_LINK
        jmp kn_mi_refused;
      kn_mi_bad_arg:
        mov rax, 0xFFFFEB2B;             // NIC_TAIL_BAD_ARG

      kn_mi_refused:
        // Shared refusal funnel: every mint failure branch lands here
        // exactly once. rax (the sentinel) is preserved across the
        // bump call since nic_note only reads rdi.
        push rax;
        mov rdi, 2;                      // NIC_ST_REFUSED
        call nic_note;
        pop rax;

      kn_mi_out:
        add rsp, 8;
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // cap_handler_nic(rights, target_ptr, op_arg) -> u64
  //
  // KIND_NIC op dispatch. row_id = target_ptr[15:0]; op = op_arg[7:0];
  // op_arg[63:8] MUST be zero -- a smuggled second value is refused
  // rather than masked, matching kind_sig_key / kind_tls_trust discipline.
  // Rights gate is a SINGLE up-front check against R_NIC_QUERY (0x001),
  // not per-op, because §2's immutability contract means every op
  // requires the same right. A dead or out-of-range row refuses every
  // op with NIC_BAD_SLOT before any rights check runs (kind_tls_trust
  // sets this precedent).
  //
  //   op 0 NIC_OP_QUERY_KIND -> nic_row_nic_kind
  //   op 1 NIC_OP_QUERY_MAC  -> nic_row_mac
  //   op 2 NIC_OP_QUERY_LINK -> nic_row_link
  //   else                    -> NIC_BAD_SLOT
  //
  // Three callee-save pushes (rbx=rights, r12=row_id, r13=op) leave
  // rsp%16==0 at every nested call (entry rsp%16==8, -24 -> %16==0).
  // ==========================================================================
  pub let cap_handler_nic : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R91.M1-001 (paideia-os #2011): KIND_NIC ops dispatch. row_id = target_ptr[15:0]; op = op_arg[7:0]; op_arg[63:8] MUST be zero (a smuggled second value refuses with NIC_TAIL_BAD_ARG rather than masks, matching kind_sig_key.pdx sigk_hn_res). Row validity (nic_row_valid) is checked once before dispatch -- dead/out-of-range row refuses with NIC_BAD_SLOT. Rights gate is a SINGLE up-front check against R_NIC_QUERY (0x001), not per-op, because §2's immutability contract means every op requires the same right. An unrecognized op ordinal falls to NIC_BAD_SLOT. Each successful QUERY bumps NIC_ST_QUERIES via the shared kn_hn_count funnel (mirrors kind_tls_trust.pdx tlsth_count). Three callee-save pushes (rbx=rights, r12=row_id, r13=op) leave rsp%16==0 at every nested call. Labels prefixed kn_hn_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                    // rights
        mov r12, rsi;
        mov r10, 0xFFFF;
        and r12, r10;                    // row_id (target_ptr[15:0])
        mov r13, rdx;                    // op_arg (full u64)

        // op_arg[63:8] must be zero.
        mov r10, r13;
        shr r10, 8;
        cmp r10, 0;
        jne kn_hn_res;

        // op = op_arg[7:0].
        mov r10, r13;
        and r10, 0xFF;
        mov r13, r10;                    // r13 = op

        // Row validity (once, before op dispatch).
        mov rdi, r12;
        call nic_row_valid;
        cmp rax, 0;
        je  kn_hn_bad_slot;

        // Rights gate (once, before op dispatch -- §2 uniform).
        mov r10, rbx;
        and r10, 0x001;                  // R_NIC_QUERY
        cmp r10, 0;
        je  kn_hn_bad_rights;

        // Op dispatch.
        cmp r13, 0;
        je  kn_hn_op_kind;
        cmp r13, 1;
        je  kn_hn_op_mac;
        cmp r13, 2;
        je  kn_hn_op_link;
        jmp kn_hn_bad_slot;

      kn_hn_op_kind:
        mov rdi, r12;
        call nic_row_nic_kind;
        jmp kn_hn_count;

      kn_hn_op_mac:
        mov rdi, r12;
        call nic_row_mac;
        jmp kn_hn_count;

      kn_hn_op_link:
        mov rdi, r12;
        call nic_row_link;
        // fallthrough to kn_hn_count

      kn_hn_count:
        push rax;
        mov rdi, 1;                      // NIC_ST_QUERIES
        call nic_note;
        pop rax;
        jmp kn_hn_out;

      kn_hn_res:
        mov rax, 0xFFFFEB2B;             // NIC_TAIL_BAD_ARG
        jmp kn_hn_out;
      kn_hn_bad_slot:
        mov rax, 0xFFFFEB29;             // NIC_BAD_SLOT
        jmp kn_hn_out;
      kn_hn_bad_rights:
        mov rax, 0xFFFFEB28;             // NIC_BAD_RIGHTS

      kn_hn_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
