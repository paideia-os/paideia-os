  // ==========================================================================
  // thermal_zone_find_by_key(zone_key) -> row_id | THERMAL_ROW_NONE
  // ==========================================================================

  pub let thermal_zone_find_by_key : (u64) -> u64 !{mem} @{} =
    fn (zone_key: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M2-001 (#1094): the live row holding this device key, or THERMAL_ROW_NONE (0xFF). Linear scan over 8 rows. THE UNIQUENESS TEST sec 5's second gate needs: two live zone capabilities over one part means two policy servers with two independent hysteresis states and two independent critical latches driving one physical control loop, neither able to see the other, and the one that writes last decides -- KIND_GPIO_LINE's 'a pin has one state' argument applied to a temperature. Refuses to match a zone_key of 0 at all, so a fabricated parent cannot collide with, or be found by, the sentinel thermal_zone_parent_key returns for a bad slot. Sentinel is 0xFF and not 0 because row 0 is a legitimate answer. Leaf. Labels prefixed tz_fk_ per reserved-label discipline.",
      block: {
        cmp rdi, 0;
        je  tz_fk_none;
        xor rcx, rcx;
      tz_fk_scan:
        cmp rcx, 8;                      // THERMAL_ZONE_MAX
        jae tz_fk_none;
        lea r10, [rip + _thermal_zone_table];
        mov r11, rcx;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  tz_fk_next;
        mov rax, [r10 + 8];
        cmp rax, rdi;
        je  tz_fk_hit;
      tz_fk_next:
        add rcx, 1;
        jmp tz_fk_scan;
      tz_fk_hit:
        mov rax, rcx;
        ret;
      tz_fk_none:
        mov rax, 0xFF;                   // THERMAL_ROW_NONE
        ret
      }
    }

  // ==========================================================================
  // thermal_zone_row_of_slot(slot) -> row_id | THERMAL_ROW_NONE
  //
  // The one route from a capability slot to a row. ARITY ONE.
  // ==========================================================================

  pub let thermal_zone_row_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R31.M2-001 (#1094): slot -> row_id, gated on the descriptor being a live KIND_THERMAL_ZONE. THE ONLY ROUTE IN THE KERNEL FROM ANYTHING TO A THERMAL ROW, and ARITY ONE so that the row a caller reaches is the row its capability names: capability in, row out, no other parameter. Every function below that touches a threshold goes through it. Returns THERMAL_ROW_NONE for an out-of-range slot, a null descriptor, a descriptor of any other kind, or a target_ptr naming a dead row -- one sentinel for four conditions because the caller's action is the same in all four and the specific code belongs to whichever gate the caller is implementing. Pure read. Labels prefixed tz_ros_ per reserved-label discipline.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r11, 256;
        cmp rdi, r11;
        jae tz_ros_none;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x157;                  // KIND_THERMAL_ZONE
        cmp r10, r11;
        jne tz_ros_none;

        mov r12, [rax + 16];
        mov r10, 0xFFFF;
        and r12, r10;                    // row_id

        mov rdi, r12;
        call thermal_zone_tail_valid;
        cmp rax, 0;
        je  tz_ros_none;

        mov rax, r12;
        jmp tz_ros_out;

      tz_ros_none:
        mov rax, 0xFF;                   // THERMAL_ROW_NONE
      tz_ros_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // thermal_zone_crt_of_slot(slot) -> crt_dk | THERMAL_DECODE_BAD
  //
  // §1. ARITY ONE, PINNED. THE CRITICAL THRESHOLD COMES FROM THE ROW.
  // ==========================================================================

  pub let thermal_zone_crt_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R31.M2-001 (#1094): the _CRT threshold, in DECI-KELVIN, of the zone this capability names. ARITY ONE, PINNED BY tools/build.sh, AND THAT IS THE POINT OF THE FUNCTION. A second parameter -- any second parameter -- is how a caller-supplied critical threshold reaches a comparison whose outcome is a power-off: `crt_of_slot(slot, default_crt)` reads as a convenience and is a way to shut a machine down by arithmetic, while `crt_of_slot(slot, scale)` is a way to keep it running past its limit. Neither is expressible against a one-argument signature, which is why the arity is checked mechanically rather than reviewed. Composed of thermal_zone_row_of_slot and thermal_zone_row_crt, so the kind check and the liveness check are the ones every other path uses rather than a second, weaker restatement of them -- the drift that makes two gates disagree. Three pushes leave rsp%16 == 0 at both nested calls. Labels prefixed tz_cos_ per reserved-label discipline.",
      block: {
        push r12;
        push r13;
        push r14;
        call thermal_zone_row_of_slot;
        mov r12, rax;
        cmp r12, 0xFF;                   // THERMAL_ROW_NONE
        je  tz_cos_bad;
        mov rdi, r12;
        call thermal_zone_row_crt;
        jmp tz_cos_out;
      tz_cos_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      tz_cos_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let thermal_zone_level_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R31.M2-001 (#1094): the current ladder level of the zone this capability names, or THERMAL_DECODE_BAD. ARITY ONE for the same reason crt_of_slot is: a level argument would let a caller assert a cooling state rather than read one. Labels prefixed tz_los_ per reserved-label discipline.",
      block: {
        push r12;
        push r13;
        push r14;
        call thermal_zone_row_of_slot;
        mov r12, rax;
        cmp r12, 0xFF;
        je  tz_los_bad;
        mov rdi, r12;
        call thermal_zone_row_level;
        jmp tz_los_out;
      tz_los_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      tz_los_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let thermal_zone_crt_latched_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R31.M2-001 (#1094): 1 iff this capability's zone has a confirmed critical crossing, or THERMAL_DECODE_BAD. THE FUNCTION A PLATFORM SHUTDOWN PATH WOULD CALL, and it exists now, unconsumed, so that when that path is written it READS the confirmed fact rather than re-deriving the decision from a temperature it fetched itself -- which is how two components come to disagree about whether the machine should be off. sec 6 records that there is no such caller in src/ today. ARITY ONE: a shutdown predicate that took a threshold would be a shutdown predicate a caller could talk out of firing. Labels prefixed tz_kls_ per reserved-label discipline.",
      block: {
        push r12;
        push r13;
        push r14;
        call thermal_zone_row_of_slot;
        mov r12, rax;
        cmp r12, 0xFF;
        je  tz_kls_bad;
        mov rdi, r12;
        call thermal_zone_row_latched;
        jmp tz_kls_out;
      tz_kls_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      tz_kls_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // thermal_zone_threshold_of_level(row_id, level) -> dk | 0
  //
  // §4. The threshold a level was entered at. Level 0 has none.
  // ==========================================================================

  pub let thermal_zone_threshold_of_level : (u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64) (level: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M2-001 (#1094): the deci-Kelvin threshold that level 1..4 is entered at -- _AC0, _AC1, _AC2, _PSV respectively -- or 0 for level 0 (NOMINAL has no entry threshold) or for a level whose trip was never declared. NOT DEFINED FOR THERMAL_LVL_CRITICAL, and that omission is load-bearing rather than an oversight: sec 4's hysteresis is a rule about LEAVING a level, critical is never left, and a function that answered `_CRT` here would make `temp + hyst < threshold(CRITICAL)` a syntactically valid way to exit a confirmed critical crossing by cooling. Level 5 therefore answers 0, which the descent rule reads as 'no threshold to fall below' and consequently never descends from -- the safe reading of the missing case. `level` is an ORDINAL and not a temperature: it selects among thresholds the row already holds. Three pushes leave rsp%16 == 0 at every nested call. Labels prefixed tz_tol_ per reserved-label discipline.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;                    // row_id
        mov r13, rsi;                    // level

        cmp r13, 0;
        je  tz_tol_zero;
        cmp r13, 4;                      // THERMAL_LVL_PASSIVE
        ja  tz_tol_zero;
        je  tz_tol_psv;

        // Levels 1..3 -> _AC0.._AC2, i.e. which = level - 1.
        mov rdi, r12;
        mov rsi, r13;
        sub rsi, 1;
        call thermal_zone_row_ac;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  tz_tol_zero;
        jmp tz_tol_out;

      tz_tol_psv:
        mov rdi, r12;
        call thermal_zone_row_psv;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  tz_tol_zero;
        jmp tz_tol_out;

      tz_tol_zero:
        xor rax, rax;
      tz_tol_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // thermal_zone_raw_level(row_id, temp_dk) -> 0..4
  //
  // §4. The highest NON-CRITICAL level this temperature has crossed.
  // ==========================================================================

  pub let thermal_zone_raw_level : (u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64) (temp_dk: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M2-001 (#1094): the highest non-critical ladder level whose declared threshold is at or below temp_dk, evaluated PASSIVE-first and descending. Highest-first rather than lowest-first because the answer is a maximum and the first hit is therefore the answer -- a lowest-first loop would have to keep going and would give the wrong result the moment somebody wrote `break` in the natural place. A level whose threshold is 0 was never declared and is skipped rather than treated as crossed; without that, an undeclared _PSV (0 dK) would be at or below every reading and every zone would report PASSIVE forever, which is the single most likely way this ladder silently stops working. The ORDERING it relies on -- _AC0 < _AC1 < _AC2 < _PSV -- is not assumed here: thermal_zone_trips_install REFUSES a row that violates it, so this scan cannot be reached with a crossed ladder. Comparison is deci-Kelvin against deci-Kelvin, per sec 0, with no conversion anywhere in the loop. Five pushes leave rsp%16 == 0 at every nested call. Labels prefixed tz_rwl_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // row_id
        mov r13, rsi;                    // temp_dk
        mov rbx, 4;                      // level cursor, PASSIVE first

      tz_rwl_loop:
        cmp rbx, 0;
        je  tz_rwl_nominal;

        mov rdi, r12;
        mov rsi, rbx;
        call thermal_zone_threshold_of_level;
        mov r14, rax;

        cmp r14, 0;
        je  tz_rwl_next;                 // level not declared

        cmp r13, r14;
        jae tz_rwl_hit;

      tz_rwl_next:
        sub rbx, 1;
        jmp tz_rwl_loop;

      tz_rwl_hit:
        mov rax, rbx;
        jmp tz_rwl_out;

      tz_rwl_nominal:
        xor rax, rax;                    // THERMAL_LVL_NOMINAL

      tz_rwl_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // thermal_zone_trips_install(slot, psv_dk, ac_levels) -> THERMAL_OK | ...
  //
  // §2. ONCE PER ROW. THE OPTIONAL TRIPS ONLY. NEVER `_CRT`.
  // ==========================================================================

  pub let thermal_zone_trips_install : (u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) (psv_dk: u64) (ac_levels: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R31.M2-001 (#1094): install the OPTIONAL trip points of the zone this capability names -- _PSV and up to three _ACx, packed _AC0 [15:0] | _AC1 [31:16] | _AC2 [47:32]. NOTE WHAT IS NOT AN ARGUMENT: _CRT. The critical threshold is set once by the mint and there is no path that changes it, because 'raise the critical threshold, the machine keeps shutting down' is the most plausible-sounding request anybody will make of this file and it is exactly the change that removes the protection sec 1 exists for. Gates, in order: (1) the slot must name a live KIND_THERMAL_ZONE -> THERMAL_BAD_SLOT / THERMAL_WRONG_KIND, via thermal_zone_row_of_slot, whose checks are reused rather than restated. (2) MONOTONICITY: num_trips must be 0 -> THERMAL_TRIP_ALREADY. Installing twice is REFUSED and not merged, for the reason core/acpi/ec_event.pdx sec 3 refuses a remap: every cooling decision is taken from these thresholds, so a zone whose _AC0 was 3200 at boot and 3600 an hour later stops requesting a fan at a temperature it used to request one at, with no symptom until the part is hot. Idempotence is NOT offered even for identical values, unlike the meaning table -- there the caller sweeps 256 bytes and filtering would be its problem, here there is exactly one call per zone and a second one is a bug in the installer. (3) ac_levels bits [63:48] non-zero -> THERMAL_TRIP_BAD_AC (a reserved field merely ignored is one a later revision cannot use). (4) CONTIGUITY: a non-zero _AC1 with a zero _AC0, or a non-zero _AC2 with a zero _AC1, -> THERMAL_TRIP_BAD_AC. ACPI numbers active levels from 0, so a gap means the parse lost one, and a lost level is a fan speed the firmware asked for and nobody will ever request. (5) Each declared _ACx must be plausible, strictly ascending, and strictly below crt_dk -> THERMAL_TRIP_BAD_AC. (6) psv_dk, if non-zero, must be plausible, strictly below crt_dk, AND STRICTLY ABOVE the highest declared _ACx -> THERMAL_TRIP_BAD_PSV. That last clause is what makes sec 4's ladder well-ordered BY CONSTRUCTION: ACPI does not guarantee _PSV > _AC2, and on a machine where they cross, 'the highest crossed trip' would report PASSIVE while an active level the firmware wanted was never requested. Refusing the crossing once, here, is cheaper and far more honest than resolving it at every evaluation. NOTHING IS CLAMPED anywhere in this function -- clamping a trip point picks a temperature, and the whole file exists because picking one is not the kernel's to do. num_trips is then the count of what was actually stored, which is the vacuity guard proving the install was not a no-op. Five pushes leave rsp%16 == 0 at every nested call; rbx holds the row, r12 psv, r13 ac_levels, r14 crt, r15 scratch. Labels prefixed tz_ti_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rsi;                    // psv_dk
        mov r13, rdx;                    // ac_levels

        call thermal_zone_row_of_slot;
        mov rbx, rax;
        cmp rbx, 0xFF;                   // THERMAL_ROW_NONE
        je  tz_ti_bad_slot;

        // (2) monotonicity.
        mov rdi, rbx;
        call thermal_zone_row_trips;
        cmp rax, 0;
        jne tz_ti_already;

        // crt for the ceiling comparisons.
        mov rdi, rbx;
        call thermal_zone_row_crt;
        mov r14, rax;

        // (3) reserved bits of ac_levels.
        mov rax, r13;
        shr rax, 48;
        cmp rax, 0;
        jne tz_ti_bad_ac;

        // Unpack into r8 = ac0, r9 = ac1, r10 = ac2. No call may
        // intervene while these live in caller-save registers, and none
        // does until they have been folded into r15.
        mov r8, r13;
        and r8, 0xFFFF;                  // ac0
        mov r9, r13;
        shr r9, 16;
        and r9, 0xFFFF;                  // ac1
        mov r10, r13;
        shr r10, 32;
        and r10, 0xFFFF;                 // ac2

        // (4) contiguity.
        cmp r8, 0;
        jne tz_ti_ac1;
        cmp r9, 0;
        jne tz_ti_bad_ac;                // ac1 without ac0
        cmp r10, 0;
        jne tz_ti_bad_ac;                // ac2 without ac0
        jmp tz_ti_ac_done;

      tz_ti_ac1:
        cmp r9, 0;
        jne tz_ti_ac2;
        cmp r10, 0;
        jne tz_ti_bad_ac;                // ac2 without ac1
        jmp tz_ti_ac_done;

      tz_ti_ac2:
        // ac0 and ac1 both present; ac1 must exceed ac0.
        cmp r9, r8;
        jbe tz_ti_bad_ac;
        cmp r10, 0;
        je  tz_ti_ac_done;
        cmp r10, r9;
        jbe tz_ti_bad_ac;

      tz_ti_ac_done:
        // (5) ceilings against crt. Each declared level strictly below.
        cmp r8, 0;
        je  tz_ti_ac_bounds_done;
        cmp r8, r14;
        jae tz_ti_bad_ac;
        cmp r9, 0;
        je  tz_ti_ac_bounds_done;
        cmp r9, r14;
        jae tz_ti_bad_ac;
        cmp r10, 0;
        je  tz_ti_ac_bounds_done;
        cmp r10, r14;
        jae tz_ti_bad_ac;

      tz_ti_ac_bounds_done:
        // Highest declared _ACx into r15, for the _PSV ordering gate.
        xor r15, r15;
        cmp r8, 0;
        je  tz_ti_top_done;
        mov r15, r8;
        cmp r9, 0;
        je  tz_ti_top_done;
        mov r15, r9;
        cmp r10, 0;
        je  tz_ti_top_done;
        mov r15, r10;

      tz_ti_top_done:
        // Plausibility of each declared level. r8/r9/r10 are caller-save,
        // so they are re-derived from r13 after each nested call.
        mov rax, r13;
        and rax, 0xFFFF;
        cmp rax, 0;
        je  tz_ti_pl1_done;
        mov rdi, rax;
        call thermal_dk_plausible;
        cmp rax, 0;
        je  tz_ti_bad_ac;
      tz_ti_pl1_done:
        mov rax, r13;
        shr rax, 16;
        and rax, 0xFFFF;
        cmp rax, 0;
        je  tz_ti_pl2_done;
        mov rdi, rax;
        call thermal_dk_plausible;
        cmp rax, 0;
        je  tz_ti_bad_ac;
      tz_ti_pl2_done:
        mov rax, r13;
        shr rax, 32;
        and rax, 0xFFFF;
        cmp rax, 0;
        je  tz_ti_pl3_done;
        mov rdi, rax;
        call thermal_dk_plausible;
        cmp rax, 0;
        je  tz_ti_bad_ac;
      tz_ti_pl3_done:

        // (6) _PSV.
        cmp r12, 0;
        je  tz_ti_psv_done;
        mov rdi, r12;
        call thermal_dk_plausible;
        cmp rax, 0;
        je  tz_ti_bad_psv;
        cmp r12, r14;
        jae tz_ti_bad_psv;               // must be below crt
        cmp r15, 0;
        je  tz_ti_psv_done;
        cmp r12, r15;
        jbe tz_ti_bad_psv;               // must be above the top active

      tz_ti_psv_done:
        // Count what is actually being stored, for num_trips.
        xor rax, rax;
        cmp r12, 0;
        je  tz_ti_cnt_ac;
        add rax, 1;
      tz_ti_cnt_ac:
        mov r10, r13;
        and r10, 0xFFFF;
        cmp r10, 0;
        je  tz_ti_cnt_done;
        add rax, 1;
        mov r10, r13;
        shr r10, 16;
        and r10, 0xFFFF;
        cmp r10, 0;
        je  tz_ti_cnt_done;
        add rax, 1;
        mov r10, r13;
        shr r10, 32;
        and r10, 0xFFFF;
        cmp r10, 0;
        je  tz_ti_cnt_done;
        add rax, 1;
      tz_ti_cnt_done:
        mov r15, rax;                    // r15 = num_trips

        // Store. Row base recomputed here rather than held across the
        // nested calls above.
        lea r10, [rip + _thermal_zone_table];
        mov r11, rbx;
        shl r11, 6;
        add r10, r11;

        mov [r10 + 32], r12;             // psv_dk
        mov [r10 + 40], r13;             // ac_levels

        // num_trips into header bits [23:16]. Read-modify-write of the
        // header word, clearing only that byte.
        mov rax, [r10 + 0];
        mov r11, 0xFF;
        shl r11, 16;
        mov rcx, r11;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        sub r11, rcx;
        and rax, r11;                    // clear [23:16]
        mov rcx, r15;
        shl rcx, 16;
        or  rax, rcx;
        mov [r10 + 0], rax;

        xor rax, rax;                    // THERMAL_OK
        jmp tz_ti_out;

      tz_ti_bad_slot:
        mov rax, 0xFFFFFE36;             // THERMAL_BAD_SLOT
        jmp tz_ti_out;
      tz_ti_already:
        mov rax, 0xFFFFFE33;             // THERMAL_TRIP_ALREADY
        jmp tz_ti_out;
      tz_ti_bad_psv:
        mov rax, 0xFFFFFE32;             // THERMAL_TRIP_BAD_PSV
        jmp tz_ti_out;
      tz_ti_bad_ac:
        mov rax, 0xFFFFFE31;             // THERMAL_TRIP_BAD_AC

      tz_ti_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // thermal_zone_assess(slot, temp_dk) -> level | THERMAL_LVL_CRITICAL
  //                                     | THERMAL_IMPLAUSIBLE
  //                                     | THERMAL_BAD_SLOT
  //
  // §3 + §4. ARITY TWO, PINNED. THE ONLY COMPARISON AGAINST `_CRT`.
  // ==========================================================================

  pub let thermal_zone_assess : (u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) (temp_dk: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R31.M2-001 (#1094): present one reading, in DECI-KELVIN, against the trip points of the zone this capability names, and return the verdict. ARITY TWO, PINNED BY tools/build.sh: a capability and a temperature, and nothing else. A THIRD ARGUMENT WOULD BE A CALLER-SUPPLIED THRESHOLD, and the whole of sec 1 is that the threshold in a critical comparison comes from the row. Note which of the two IS an argument and why that is not the same weakness: the reading must come from outside, because _TMP is a firmware method and this ring cannot evaluate one, so a holder of R_THERMAL_READ over a zone can indeed assert that zone's temperature -- which is exactly the authority a zone capability is. What sec 3 defends against is GARBAGE, not malice. ORDER OF OPERATIONS, and each step is load-bearing: (1) slot -> row via thermal_zone_row_of_slot -> THERMAL_BAD_SLOT. (2) PLAUSIBILITY. Outside 2232..4232 dK -> THERMAL_IMPLAUSIBLE, counted, AND NOTHING IN THE ROW IS TOUCHED -- not the level, not the candidate, not the latch. Clearing the candidate on a garbage reading would let alternating garbage and genuinely-hot readings prevent a confirmation indefinitely; advancing the ladder on one would let garbage request cooling. Doing nothing is the only defensible response to a value that is not a temperature. (3) ALREADY LATCHED -> THERMAL_LVL_CRITICAL immediately. A confirmed critical crossing is a fact about the part, not about the last reading, and a subsequent cool reading is evidence that something started cooling it rather than evidence that it never happened. (4) AT OR ABOVE _CRT: if no candidate is outstanding, RECORD THIS READING AS THE CANDIDATE AND DO NOT LATCH -- the caller gets the highest non-critical verdict, so the fans go to maximum on the strength of one hot reading while the shutdown waits for a second. If a candidate IS outstanding and the two agree within THERMAL_CRT_CONFIRM_DELTA_DK (50 dK), LATCH. If they disagree by more, RE-ARM with the newer reading and count it: two readings 30 K apart are evidence of a sensor that is lying, and a machine that powers off because of one is a machine an operator cannot keep running. (5) BELOW _CRT: clear the candidate, because a reading below the threshold is positive evidence that the earlier one was wrong or transient. (6) THE LADDER, with sec 4's hysteresis: raw = raw_level(temp); rising or equal takes raw immediately; falling holds the current level until temp + hyst < threshold(current). Expressed that way rather than as temp < threshold - hyst so the arithmetic cannot underflow on a cold zone. The comparison is deci-Kelvin against deci-Kelvin throughout, per sec 0 -- there is no conversion anywhere on this path, which is why no step of it can be wrong about the unit. Five pushes leave rsp%16 == 0 at every nested call; rbx = row, r12 = temp, r13/r14/r15 scratch across calls. Labels prefixed tz_as_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rsi;                    // temp_dk

        call thermal_zone_row_of_slot;
        mov rbx, rax;
        cmp rbx, 0xFF;                   // THERMAL_ROW_NONE
        je  tz_as_bad_slot;

        // (2) plausibility.
        mov rdi, r12;
        call thermal_dk_plausible;
        cmp rax, 0;
        je  tz_as_implausible;

        // (3) already latched?
        mov rdi, rbx;
        call thermal_zone_row_latched;
        cmp rax, 1;
        je  tz_as_critical_done;

        // (4)/(5) the critical comparison.
        mov rdi, rbx;
        call thermal_zone_row_crt;
        mov r13, rax;                    // crt_dk

        cmp r12, r13;
        jb  tz_as_below_crt;

        mov rdi, rbx;
        call thermal_zone_row_cand;
        mov r14, rax;                    // candidate

        cmp r14, 0;
        je  tz_as_arm;

        // |temp - cand| <= delta ?
        cmp r12, r14;
        jae tz_as_diff_hi;
        mov r15, r14;
        sub r15, r12;
        jmp tz_as_diff_done;
      tz_as_diff_hi:
        mov r15, r12;
        sub r15, r14;
      tz_as_diff_done:
        mov r10, 50;                     // THERMAL_CRT_CONFIRM_DELTA_DK
        cmp r15, r10;
        ja  tz_as_rearm;

        // Confirmed. Latch, and record.
        lea r10, [rip + _thermal_zone_table];
        mov r11, rbx;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 56];
        mov r11, 1;
        shl r11, 8;
        or  rax, r11;                    // crt_latched = 1
        mov [r10 + 56], rax;

        mov rdi, 4;                      // THERMAL_ST_LATCHED
        call thermal_zone_note;
        jmp tz_as_critical_done;

      tz_as_rearm:
        mov rdi, 3;                      // THERMAL_ST_DISAGREED
        call thermal_zone_note;
        jmp tz_as_arm_store;

      tz_as_arm:
        mov rdi, 2;                      // THERMAL_ST_ARMED
        call thermal_zone_note;

      tz_as_arm_store:
        lea r10, [rip + _thermal_zone_table];
        mov r11, rbx;
        shl r11, 6;
        add r10, r11;
        mov [r10 + 48], r12;             // crt_cand = this reading
        jmp tz_as_ladder;

      tz_as_below_crt:
        lea r10, [rip + _thermal_zone_table];
        mov r11, rbx;
        shl r11, 6;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 48], rax;             // clear the candidate

      tz_as_ladder:
        mov rdi, 0;                      // THERMAL_ST_ASSESSED
        call thermal_zone_note;

        mov rdi, rbx;
        mov rsi, r12;
        call thermal_zone_raw_level;
        mov r13, rax;                    // raw

        mov rdi, rbx;
        call thermal_zone_row_level;
        mov r14, rax;                    // current

        cmp r13, r14;
        jae tz_as_take_raw;

        // Falling. Hold unless temp + hyst < threshold(current).
        mov rdi, rbx;
        mov rsi, r14;
        call thermal_zone_threshold_of_level;
        mov r15, rax;                    // threshold(current)

        cmp r15, 0;
        je  tz_as_take_cur;              // no threshold to fall below

        mov rdi, rbx;
        call thermal_zone_row_hyst;
        add rax, r12;                    // temp + hyst
        cmp rax, r15;
        jb  tz_as_take_raw;

      tz_as_take_cur:
        mov r13, r14;

      tz_as_take_raw:
        // Store r13 as the new level, preserving latched / reads.
        lea r10, [rip + _thermal_zone_table];
        mov r11, rbx;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 56];
        mov r11, 0xFFFFFFFFFFFFFF00;
        and rax, r11;                    // clear level byte
        or  rax, r13;
        mov [r10 + 56], rax;

        mov rax, r13;
        jmp tz_as_out;

      tz_as_critical_done:
        mov rax, 5;                      // THERMAL_LVL_CRITICAL
        jmp tz_as_out;

      tz_as_implausible:
        mov rdi, 1;                      // THERMAL_ST_IMPLAUSIBLE
        call thermal_zone_note;
        mov rax, 0xFFFFFE30;             // THERMAL_IMPLAUSIBLE
        jmp tz_as_out;

      tz_as_bad_slot:
        mov rax, 0xFFFFFE36;             // THERMAL_BAD_SLOT

      tz_as_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // thermal_zone_cap_mint_inner(slot, parent_slot, rights, crt_dk, hyst_dk)
  // ==========================================================================

  pub let thermal_zone_cap_mint_inner : (u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (crt_dk: u64) (hyst_dk: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R31.M2-001 (#1094): mint a KIND_THERMAL_ZONE over a KIND_DEVICE. Gates, in order: (1) slot < 256 -> THERMAL_BAD_SLOT. (2) thermal_zone_check_parent_device -> THERMAL_MINT_BAD_PARENT, which is the half that discriminates nothing (sec 5). (3) thermal_zone_rights_valid -> THERMAL_MINT_BAD_RIGHTS. (4) crt_dk must be plausible -> THERMAL_MINT_BAD_CRT. A zone with no critical threshold, or one outside 2232..4232 dK, is REFUSED RATHER THAN CREATED, which is the difference between this kind and every other installed table in the tree: the optional trips start empty and fill, but _CRT is part of the row's identity because a live row without one is a zone a policy server can read, act on, and believe it is watching. Zero is refused by the same test -- 0 dK is below THERMAL_DK_MIN -- so 'forgot to pass the critical threshold' and 'passed a Celsius value' are both caught by the plausibility bound rather than by a separate zero check that a Celsius 95 would have sailed through. (5) hyst_dk in 1..THERMAL_HYST_MAX_DK -> THERMAL_MINT_BAD_HYST. A zone with zero hysteresis flaps its cooling state continuously on a trip point, and there is no default this kernel could pick: 5 K is right for a skin sensor and wrong for a package one. ACPI's _HYS is optional, so when firmware supplies none the installer must decide, and being made to decide is the point. (6) INHERIT the identity: thermal_zone_parent_key(parent_slot); 0 -> THERMAL_MINT_NO_DEVICE. The key is not an argument anywhere, for the reason ec_event_map_bind takes no address -- an argued key would attach one part's critical threshold to another part and every reading thereafter would be confidently about the wrong silicon. (7) UNIQUENESS: thermal_zone_find_by_key must answer THERMAL_ROW_NONE -> THERMAL_MINT_ZONE_IN_USE. The second mint is REFUSED, not merged: two capabilities over one zone means two hysteresis states and two critical latches driving one control loop with neither able to see the other. (8) hdr_pack(parent_slot, 0) then tail_alloc -> THERMAL_MINT_ENOSPC on exhaustion, and the allocator re-validates _CRT and hysteresis independently so that no future second caller can create a row without them. (9) cap_mint_write(slot, KIND_THERMAL_ZONE, rights, row_id | (slot << 16)) -- the only descriptor writer, on both the mint and the revoke path per #1579, which keeps the owner column's unconditional clear on the teardown path as well. Five pushes leave rsp%16 == 0 at every nested call. Labels prefixed tz_mi_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                    // slot
        mov r12, rsi;                    // parent_slot
        mov r13, rdx;                    // rights
        mov r14, rcx;                    // crt_dk
        mov r15, r8;                     // hyst_dk

        mov r10, 256;
        cmp rbx, r10;
        jae tz_mi_bad_slot;

        mov rdi, r12;
        call thermal_zone_check_parent_device;
        cmp rax, 0;
        je  tz_mi_bad_parent;

        mov rdi, r13;
        call thermal_zone_rights_valid;
        cmp rax, 0;
        je  tz_mi_bad_rights;

        mov rdi, r14;
        call thermal_dk_plausible;
        cmp rax, 0;
        je  tz_mi_bad_crt;

        cmp r15, 0;
        je  tz_mi_bad_hyst;
        mov r10, 200;                    // THERMAL_HYST_MAX_DK
        cmp r15, r10;
        ja  tz_mi_bad_hyst;

        mov rdi, r12;
        call thermal_zone_parent_key;
        cmp rax, 0;
        je  tz_mi_no_device;
        mov rdi, rax;
        push rdi;                        // zone_key
        sub rsp, 8;                      // keep rsp%16 == 0
        call thermal_zone_find_by_key;
        add rsp, 8;
        pop rdi;                         // rdi = zone_key
        cmp rax, 0xFF;                   // THERMAL_ROW_NONE
        jne tz_mi_in_use;

        // rdi still holds zone_key; stash it in r10 across hdr_pack.
        mov r10, rdi;
        push r10;
        sub rsp, 8;
        mov rdi, r12;
        xor rsi, rsi;                    // num_trips = 0
        call thermal_zone_hdr_pack;
        add rsp, 8;
        pop r10;                         // r10 = zone_key
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  tz_mi_bad_parent;

        mov rdi, rax;                    // hdr
        mov rsi, r10;                    // zone_key
        mov rdx, r14;                    // crt_dk
        mov rcx, r15;                    // hyst_dk
        call thermal_zone_tail_alloc;

        mov r10, 0xFFFFFE3F;             // THERMAL_TAIL_ENOSPC
        cmp rax, r10;
        je  tz_mi_enospc;
        mov r10, 0xFFFFFE3E;             // THERMAL_TAIL_BAD_ARG
        cmp rax, r10;
        je  tz_mi_bad_crt;

        // target_ptr = row_id | (slot << 16).
        mov r14, rax;                    // row_id
        mov r11, rbx;
        shl r11, 16;
        or  r14, r11;

        mov rdi, rbx;
        mov rsi, 0x157;                  // KIND_THERMAL_ZONE
        mov rdx, r13;                    // rights
        mov rcx, r14;                    // target_ptr
        call cap_mint_write;

        xor rax, rax;                    // THERMAL_OK
        jmp tz_mi_out;

      tz_mi_bad_slot:
        mov rax, 0xFFFFFE36;
        jmp tz_mi_out;
      tz_mi_bad_parent:
        mov rax, 0xFFFFFE3D;
        jmp tz_mi_out;
      tz_mi_bad_rights:
        mov rax, 0xFFFFFE3C;
        jmp tz_mi_out;
      tz_mi_bad_crt:
        mov rax, 0xFFFFFE3B;
        jmp tz_mi_out;
      tz_mi_bad_hyst:
        mov rax, 0xFFFFFE3A;
        jmp tz_mi_out;
      tz_mi_no_device:
        mov rax, 0xFFFFFE39;
        jmp tz_mi_out;
      tz_mi_enospc:
        mov rax, 0xFFFFFE38;
        jmp tz_mi_out;
      tz_mi_in_use:
        mov rax, 0xFFFFFE37;

      tz_mi_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let thermal_zone_cap_mint : (u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (crt_dk: u64) (hyst_dk: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R31.M2-001 (#1094): audited mint. Putting emission in the wrapper means a second mint path cannot exist without being audited, which is the discipline every derived kind since #1068 follows. The audit record carries the SUBJECT slot and the PRINCIPAL (parent) slot, so 'which device capability was used to claim this zone' is answerable after the fact -- the question an operator asks when two components disagree about which part a temperature belongs to. Four pushes leave rsp%16 == 0 at both nested calls. Reserved labels: none.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // subject slot
        mov r13, rsi;                    // principal (parent slot)

        call thermal_zone_cap_mint_inner;
        mov r14, rax;

        mov rdi, 1;                      // DRV_AUDIT_EV_MINT
        mov rsi, 0x157;                  // KIND_THERMAL_ZONE
        mov rdx, r12;
        mov rcx, r13;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // thermal_zone_cap_revoke_inner(slot) -> THERMAL_OK | ...
  // ==========================================================================

  pub let thermal_zone_cap_revoke_inner : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R31.M2-001 (#1094): revoke a KIND_THERMAL_ZONE. (1) slot < 256 -> THERMAL_BAD_SLOT. (2) kind == 0 -> THERMAL_REVOKE_ALREADY, idempotent on a null slot and a DISTINCT code from success so a caller can tell 'nothing to do' from 'done'. (3) kind != 0x157 -> THERMAL_WRONG_KIND, which is what stops a zone revoke from freeing another kind's row through a coincidentally-shaped target_ptr -- and which is what makes it safe for the owner-column sweep to call this blindly. (4) row_id from target_ptr[15:0]; if live, thermal_zone_tail_free scrubs it, which is what makes the zone RE-MINTABLE and therefore what makes a policy-server restart possible at all: a stranded row still holds the zone's uniqueness key, so the next legitimate mint would be refused ZONE_IN_USE by a ghost that is also the only remaining record of the part's critical threshold. (5) clear the descriptor through cap_mint_write(slot, 0, 0, 0) rather than three raw stores, per #1579, so the owner column's unconditional clear runs on teardown as well as creation. NOTHING IS COOLED AND NOTHING IS SHUT DOWN. Revoking authority over a zone leaves the machine exactly as it was, and that is deliberate: a revoke that acted on a latch would make capability teardown a power-management event, and a revoke that cleared one would erase the record that a part had been past its limit. Whether a released zone needs cooling is a question for whoever still holds a cooling device. Five pushes leave rsp%16 == 0 at every nested call. Labels prefixed tz_rvk_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // slot

        mov r10, 256;
        cmp r12, r10;
        jae tz_rvk_bad_slot;

        mov rax, cap_table;
        mov r8, r12;
        shl r8, 3;
        mov r9, r12;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov rbx, rax;                    // descriptor base

        mov r10, [rbx + 0];
        cmp r10, 0;
        je  tz_rvk_already;

        mov r11, 0x157;                  // KIND_THERMAL_ZONE
        cmp r10, r11;
        jne tz_rvk_wrong_kind;

        mov r13, [rbx + 16];
        mov r10, 0xFFFF;
        and r13, r10;                    // row_id

        mov rdi, r13;
        call thermal_zone_tail_valid;
        cmp rax, 0;
        je  tz_rvk_clear;

        mov rdi, r13;
        call thermal_zone_tail_free;

      tz_rvk_clear:
        mov rdi, r12;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        xor rax, rax;                    // THERMAL_OK
        jmp tz_rvk_out;

      tz_rvk_bad_slot:
        mov rax, 0xFFFFFE36;
        jmp tz_rvk_out;
      tz_rvk_wrong_kind:
        mov rax, 0xFFFFFE35;
        jmp tz_rvk_out;
      tz_rvk_already:
        mov rax, 0xFFFFFE34;

      tz_rvk_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let thermal_zone_cap_revoke : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R31.M2-001 (#1094): audited revoke. THE SYMBOL THE OWNER-COLUMN SWEEP CALLS, so a process death leaves the same audit trail a deliberate teardown would -- the reconciliation property R29.M6-002 established, and the one an operator needs when a machine gets hot after a policy server crashed and the question is whether its zone rows were released or stranded. There is NO cascade: nothing in this tree derives from a thermal zone (KIND_COOLING_DEVICE derives over KIND_DEVICE, because a fan is a device the platform has and not a subdivision of a temperature), and an empty cascade call would be a hook that looks maintained and is not. Three pushes leave rsp%16 == 0 at both nested calls. Reserved labels: none.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;

        call thermal_zone_cap_revoke_inner;
        mov r14, rax;

        mov rdi, 2;                      // DRV_AUDIT_EV_REVOKE
        mov rsi, 0x157;                  // KIND_THERMAL_ZONE
        mov rdx, r12;
        mov rcx, r12;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // thermal_zone_debug_print(row_id) -> THERMAL_OK | THERMAL_TAIL_BAD_ARG
  // ==========================================================================

  pub let thermal_zone_debug_print : (u64) -> u64 !{mem, sysreg} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "R31.M2-001 (#1094): canonical printer for one zone row. Refuses a dead or out-of-range row with THERMAL_TAIL_BAD_ARG rather than printing zeroes: a freed row renders as {crt 0, hyst 0, psv 0, level 0}, which is a plausible-looking zone with no critical threshold sitting comfortably cool -- the single most misleading four values this module could emit. Six KV lines. THE _CRT IS PRINTED TWICE, once in deci-Kelvin and once through thermal_dk_to_dc, and that is the only place in the file the conversion is used. Both, because they are the two ways a reader will want to check it and printing only one is how a unit error survives a log review: 3550 dK next to 818 dC is self-evidently 81.8 C, while 3550 alone reads as a number and 818 alone reads as a temperature that could be either unit. The level is printed as an ordinal rather than a name because the ladder's numbering is what every other assertion in the tree uses. r12 holds row_id across the calls, r13 each fetched value; three pushes leave rsp%16 == 0 at every nested call. Labels prefixed tz_dp_ per reserved-label discipline.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;

        call thermal_zone_tail_valid;
        cmp rax, 0;
        je  tz_dp_bad;

        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + tz_dbg_msg];
        lea rcx, [rip + tz_k_row];
        mov r8, r12;
        call klog_s1_x1;

        mov rdi, r12;
        call thermal_zone_row_crt;
        mov r13, rax;
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + tz_dbg_msg];
        lea rcx, [rip + tz_k_crt];
        mov r8, r13;
        call klog_s1_d1;

        mov rdi, r13;
        call thermal_dk_to_dc;
        mov r13, rax;
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + tz_dbg_msg];
        lea rcx, [rip + tz_k_crtc];
        mov r8, r13;
        call klog_s1_d1;

        mov rdi, r12;
        call thermal_zone_row_hyst;
        mov r13, rax;
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + tz_dbg_msg];
        lea rcx, [rip + tz_k_hys];
        mov r8, r13;
        call klog_s1_d1;

        mov rdi, r12;
        call thermal_zone_row_psv;
        mov r13, rax;
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + tz_dbg_msg];
        lea rcx, [rip + tz_k_psv];
        mov r8, r13;
        call klog_s1_d1;

        mov rdi, r12;
        call thermal_zone_row_level;
        mov r13, rax;
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + tz_dbg_msg];
        lea rcx, [rip + tz_k_lvl];
        mov r8, r13;
        call klog_s1_d1;

        xor rax, rax;                    // THERMAL_OK
        jmp tz_dp_out;

      tz_dp_bad:
        mov rax, 0xFFFFFE3E;             // THERMAL_TAIL_BAD_ARG

      tz_dp_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // cap_handler_thermal_zone(rights, target_ptr, op_arg)
  // ==========================================================================

  pub let cap_handler_thermal_zone : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R31.M2-001 (#1094): KIND_THERMAL_ZONE dispatch handler. Emits cap_thermal_zone_msg on entry (argument registers saved across klog_s1, which clobbers all three per klog/wrappers.pdx sec 5.1). row_id = target_ptr[15:0] and slot = target_ptr[31:16], both from the DESCRIPTOR, which only cap_mint_write writes; op = op_arg[7:0]. RIGHTS PER OP: QUERY_CRT / QUERY_LEVEL / QUERY_LATCHED / ASSESS require R_THERMAL_READ (0x001), QUERY_HYST / QUERY_PSV / QUERY_TRIPS / QUERY_PARENT require R_THERMAL_INVOKE (0x008), DEBUG_PRINT requires R_THERMAL_OBSERVE (0x400). QUERY_CRT is READ and not INVOKE because a critical threshold is a statement about how hot this part may get, which is the same class of fact as its temperature, while a hysteresis or a trip count is configuration introspection. QUERY_LATCHED is READ and not OBSERVE because 'has this part been past its limit' is the reading's conclusion and not chatter about the row. THE OPS THAT ARE ABSENT: there is no trip-install op and no _CRT-setting op, so no invocation through this handler can change a threshold -- thermal_zone_trips_install is reachable only from ring 0, which is where the ring-3 supervisor's install request will land when the RPC for it exists, and R_THERMAL_TRIP is consequently a right this handler never reads. That is deliberate and is the shape #1075 used for its reserved rights: the bit exists so that a capability minted today is refused the authority when the op appears, rather than silently acquiring it. OPS 0..7 TAKE NO OPERAND and discard op_arg[63:8], because there is nothing up there they could mean. OP 8 (ASSESS) TAKES ONE: the reading, in deci-Kelvin, in op_arg[31:16], and op_arg[63:32] must be ZERO -> THERMAL_OP_ARG_RESERVED. Refused rather than masked, for #1077's reason applied to a more dangerous target: thirty-two free bits on an invocation that reaches a _CRT comparison is where a second temperature would be smuggled, and masking would turn the attempt into an ordinary successful call. Sixteen bits covers the whole deci-Kelvin domain, so nothing legitimate needs the upper half. Unknown op -> INVOKE_UNSUPPORTED (0xFFFFFFFFFFFFFFFC); rights failure -> INVOKE_DENIED (0xFFFFFFFFFFFFFFFD). Every query returns THERMAL_DECODE_BAD for a dead row and never a plausible zero, which matters here for all of them: 0 is a legitimate _PSV, a legitimate level, a legitimate latch and a legitimate trip count. r12=rights, r13=row_id, rbx=slot, r14=op, r15=operand; five pushes leave rsp%16 == 0 at every nested call. Labels prefixed tz_h_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // rights
        mov r13, rsi;
        mov r10, 0xFFFF;
        and r13, r10;                    // row_id = target_ptr[15:0]
        mov rbx, rsi;
        shr rbx, 16;
        and rbx, 0xFF;                   // slot   = target_ptr[31:16]
        mov r14, rdx;                    // op_arg, whole

        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_thermal_zone_msg];
        call klog_s1;

        // Decode. No call intervenes between forming r11 and testing it.
        mov r10, r14;
        and r10, 0xFF;                   // op
        mov r15, r14;
        shr r15, 16;
        mov r11, 0xFFFF;
        and r15, r11;                    // operand = op_arg[31:16]
        mov r11, r14;
        shr r11, 32;                     // everything above the operand
        mov r14, r10;                    // r14 = op from here on

        cmp r14, 8;                      // THERMAL_OP_MAX
        ja  tz_h_unsup;

        cmp r14, 8;                      // THERMAL_OP_ASSESS
        je  tz_h_assess_gate;

        // Ops 0..7: no operand, upper bits discarded.
        cmp r14, 7;                      // THERMAL_OP_DEBUG_PRINT
        je  tz_h_dbg;

        cmp r14, 0;
        je  tz_h_read_gate;
        cmp r14, 3;
        je  tz_h_read_gate;
        cmp r14, 4;
        je  tz_h_read_gate;

        // QUERY_HYST / QUERY_PSV / QUERY_TRIPS / QUERY_PARENT: INVOKE.
        mov rax, r12;
        mov r10, 0x008;                  // R_THERMAL_INVOKE
        and rax, r10;
        cmp rax, 0;
        je  tz_h_denied;

        mov rdi, r13;
        cmp r14, 1;
        je  tz_h_hyst;
        cmp r14, 2;
        je  tz_h_psv;
        cmp r14, 5;
        je  tz_h_trips;
        call thermal_zone_row_parent;
        jmp tz_h_out;

      tz_h_read_gate:
        mov rax, r12;
        mov r10, 0x001;                  // R_THERMAL_READ
        and rax, r10;
        cmp rax, 0;
        je  tz_h_denied;

        mov rdi, r13;
        cmp r14, 0;
        je  tz_h_crt;
        cmp r14, 3;
        je  tz_h_level;
        call thermal_zone_row_latched;
        jmp tz_h_out;

      tz_h_assess_gate:
        // The reserved field is REFUSED, not masked.
        cmp r11, 0;
        jne tz_h_res;

        mov rax, r12;
        mov r10, 0x001;                  // R_THERMAL_READ
        and rax, r10;
        cmp rax, 0;
        je  tz_h_denied;

        mov rdi, rbx;                    // the slot from the DESCRIPTOR
        mov rsi, r15;                    // the reading, deci-Kelvin
        call thermal_zone_assess;
        jmp tz_h_out;

      tz_h_crt:
        call thermal_zone_row_crt;
        jmp tz_h_out;
      tz_h_level:
        call thermal_zone_row_level;
        jmp tz_h_out;
      tz_h_hyst:
        call thermal_zone_row_hyst;
        jmp tz_h_out;
      tz_h_psv:
        call thermal_zone_row_psv;
        jmp tz_h_out;
      tz_h_trips:
        call thermal_zone_row_trips;
        jmp tz_h_out;

      tz_h_dbg:
        mov rax, r12;
        mov r10, 0x400;                  // R_THERMAL_OBSERVE
        and rax, r10;
        cmp rax, 0;
        je  tz_h_denied;
        mov rdi, r13;
        call thermal_zone_debug_print;
        jmp tz_h_out;

      tz_h_res:
        mov rax, 0xFFFFFE3E;             // THERMAL_TAIL_BAD_ARG
        jmp tz_h_out;
      tz_h_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;     // INVOKE_DENIED
        jmp tz_h_out;
      tz_h_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;     // INVOKE_UNSUPPORTED

      tz_h_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
