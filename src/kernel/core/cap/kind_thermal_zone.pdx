// src/kernel/core/cap/kind_thermal_zone.pdx — R31.M2-001 (#1094)
//
// KIND_THERMAL_ZONE = 0x157, derived over KIND_DEVICE (10).
//
// The authority to hold one thermal zone's trip points and to be told
// which side of them a temperature falls on.
//
// =============================================================================
// §0  THE UNIT IS DECI-KELVIN AND THERE IS NO CONVERSION ON THE CONTROL PATH
// =============================================================================
//
// ACPI 6.5 §11.4 reports every temperature — `_TMP`, `_CRT`, `_HOT`,
// `_PSV`, `_ACx`, `_HYS` — in TENTHS OF A KELVIN. 3000 is 300.0 K, which
// is 26.85 °C. Nothing in this module is in Celsius.
//
// That is the single most dangerous fact in a thermal subsystem, because
// both ways of getting it wrong are silent:
//
//   * READ deci-Kelvin AS Celsius and every zone looks like it is at
//     3000 °C, or — with the offset applied the wrong way — like it is
//     frozen. Either way NO TRIP EVER FIRES, and a subsystem that never
//     protects anything looks exactly like a subsystem with nothing to
//     protect against.
//   * READ Celsius AS deci-Kelvin and 45 °C reads as 4.5 K, or a `_CRT`
//     of 1000 (100.0 K) is below every plausible reading and the machine
//     shuts down at boot.
//
// The defence is not a careful conversion. It is that THE CONTROL PATH
// NEVER CONVERTS. `_CRT`, `_PSV`, `_ACx`, `_HYS` and `_TMP` all arrive in
// deci-Kelvin, are stored in deci-Kelvin, and are compared against each
// other in deci-Kelvin. A comparison between two quantities in the same
// unit cannot be wrong about the unit.
//
// Conversion exists in exactly ONE function, `thermal_dk_to_dc`, it is
// used ONLY by the row printer, and `tools/build.sh` asserts that no
// object other than this one relocates against it. Every field name in
// this file that holds a temperature ends in `_dk`, so a Celsius value
// assigned to one is visible at the point of assignment rather than three
// layers downstream.
//
// The witness asserts a known value end to end: 3000 dK in, 268 dC out
// (26.8 °C), through the shipping conversion, against the two wrong
// answers a sign error and a missing offset would give.
//
// =============================================================================
// §1  TRIP POINTS ARE NOT INTERCHANGEABLE, AND `_CRT` IS THE ONE THAT KILLS
// =============================================================================
//
// ACPI's trip points are four different instructions to the OS:
//
//   `_CRT`  shut down NOW. Unconditional, no negotiation, no policy.
//   `_HOT`  hibernate. Graceful, but the machine is going down.
//   `_PSV`  throttle. The machine stays up and gets slower.
//   `_ACx`  run the fans at level x. The machine stays up and gets loud.
//
// Confusing `_CRT` with `_PSV` in either direction is a shipped disaster.
// One way, a laptop powers off for being warm. The other way, it politely
// reduces clocks while the part cooks — and `_PSV` throttling on a machine
// whose EC owns fan control may not reduce the temperature at all.
//
// Three consequences run through this file:
//
//   * A ZONE CANNOT EXIST WITHOUT A `_CRT`. It is a mint argument, not an
//     installed one, and an implausible or zero value is refused
//     (`THERMAL_MINT_BAD_CRT`). §2 explains why this one trip is part of
//     the row's identity while the others are installed afterwards.
//   * `_CRT` IS NEVER REACHABLE BY A CALLER-SUPPLIED VALUE. The threshold
//     comes from the row; `thermal_zone_crt_of_slot` has ARITY ONE and
//     `thermal_zone_assess` has ARITY TWO, both pinned by
//     `tools/build.sh`, and there is no primitive anywhere that takes a
//     `_CRT` and a slot together.
//   * `_CRT` CANNOT BE RAISED. Trip installation is monotone: it happens
//     once per row and `_CRT` is not part of it. "Raise the critical
//     threshold because the machine keeps shutting down" is the most
//     plausible-sounding call anybody will ever want to add here, and it
//     is exactly the call that removes the protection.
//
// `_HOT` is DELIBERATELY ABSENT rather than stored and ignored. It means
// hibernate, this kernel cannot hibernate, and a stored threshold that
// nothing acts on is a field a later reader will believe is wired.
//
// =============================================================================
// §2  THE TRIP TABLE IS INSTALLED, NOT COMPILED IN
// =============================================================================
//
// Same discipline as the query-byte meanings in `core/acpi/ec_event.pdx`
// §2, and the same reason. `_CRT` on this machine is whatever this
// machine's firmware says, and learning it means evaluating a firmware
// method — which `design/acpi/no-aml-in-kernel.md` forbids in ring 0 down
// to the token level. A compiled-in trip table would be a kernel that
// silently protects every laptop except the one it is running on.
//
// So the kernel holds small integers it was told, and never learns them
// by itself. The intended installer is the ring-3 supervisor that
// evaluated the zone.
//
// WHY `_CRT` IS AT MINT AND THE REST IS INSTALLED, which is the one place
// this module departs from "starts empty and only fills": a row that is
// live with no `_CRT` is a zone a policy server can read, act on, and
// believe it is watching — with no critical threshold behind it. The
// optional trips have a safe absent state (no active level means no fan
// request; no `_PSV` means no throttle request). `_CRT` has none. So the
// row cannot be allocated without one, and the OPTIONAL trips are the
// part that starts empty and fills exactly once
// (`THERMAL_TRIP_ALREADY` on the second attempt).
//
// Hysteresis is at mint for the same reason in weaker form: a zone with
// zero hysteresis flaps its cooling state continuously while it sits on a
// trip point, and there is no default this kernel could pick — 5 K is
// right for a skin sensor and wrong for a package sensor. ACPI's `_HYS`
// is optional, so when firmware supplies none the installer must choose,
// and zero is refused (`THERMAL_MINT_BAD_HYST`).
//
// `_TC1`/`_TC2`/`_TSP` — ACPI's passive-cooling coefficients — are NOT
// implemented and not stored. This platform defers P-state control to
// hardware HWP per `design/roadmap/next-wave-osarch.md` §2.3, so the
// passive equation those coefficients parameterise has no actuator here.
// What replaces them is stated rather than implied: hysteresis on the
// ACTIVE ladder, from `_HYS`, applied on the way DOWN only (§4).
//
// =============================================================================
// §3  A GARBAGE TEMPERATURE IS DANGEROUS IN BOTH DIRECTIONS
// =============================================================================
//
// A thermal reading comes through the embedded controller, and #1580's
// kernel-side arbitration record now exists -- `ec_access_arbitrated()`
// returns 1 once `ec_access_bind_arbitration` binds the FACS and PM1
// addresses fadt_parse emits. But the RING-3 half of the Global Lock
// (aml_glk_attach in the acpi_supervisor bubble, which is still a
// stub) has not been wired, so every EC transaction on real hardware
// today STILL runs unarbitrated against SMM even with the addresses
// known. The plausibility discipline below stays in force until the
// R34 userspace-bubble milestone activates the ring-3 attach; the
// signal that a read is racing firmware is exactly the same.
//
// That cuts both ways, and only one of the two directions is obvious:
//
//   * TOO HIGH — a garbage read above `_CRT` powers off a healthy
//     machine, and the operator has no way to tell that from a real
//     overheat.
//   * TOO LOW — a garbage read below every trip masks a real overheat for
//     as long as it persists, and the fans stay off while it does.
//
// Two defences, both cheap, both witnessed:
//
//   * PLAUSIBILITY BOUNDS. A reading outside 2232..4232 dK (−50.0 °C to
//     +150.0 °C) is refused with `THERMAL_IMPLAUSIBLE` and CHANGES
//     NOTHING — not the level, not the confirmation candidate, not the
//     latch. It is counted, because "this zone keeps returning nonsense"
//     is a diagnosis and silence is not. The bounds are wide on purpose:
//     they are there to reject a byte that is not a temperature, not to
//     second-guess a sensor.
//   * TWO AGREEING READS BEFORE CRITICAL. A single reading above `_CRT`
//     does NOT latch. It is recorded as a candidate and the caller gets
//     the highest NON-critical verdict. Only a second reading that is
//     also above `_CRT` and within `THERMAL_CRT_CONFIRM_DELTA_DK` (50 dK
//     = 5 K) of the candidate latches. Two readings that disagree by more
//     than that re-arm rather than latch — they are evidence of a bad
//     sensor, not of a hot part. A reading below `_CRT` clears the
//     candidate outright.
//
// A SINGLE UNARBITRATED READ AUTHORISING A POWER-OFF IS THE WRONG SHAPE,
// and this is the smallest change that makes it not that.
//
// What confirmation costs, stated honestly: one extra sampling interval
// before a genuine critical latches. On a part that is genuinely past
// `_CRT` the temperature is not falling, so the second read agrees and
// the cost is one interval — which is why the interval belongs to the
// policy server and the confirmation belongs here.
//
// What confirmation does NOT defend against: a caller with
// `R_THERMAL_READ` over this zone that submits two agreeing fabricated
// readings. That is not an attack, it is the holder exercising authority
// over its own zone; a zone capability is the authority to say what this
// zone's temperature is. The confirmation is against GARBAGE, and it says
// so.
//
// ONCE LATCHED, NEVER CLEARED while the row lives. A part that went past
// its critical threshold did go past it, and a subsequent cool reading is
// not evidence that it did not — it is evidence that something started
// cooling it. Only a revoke clears the latch, because that is the point
// at which somebody has decided the zone's history no longer applies.
//
// =============================================================================
// §4  THE LADDER IS WELL-ORDERED BY CONSTRUCTION
// =============================================================================
//
// Five non-critical states, in ascending temperature:
//
//   0 NOMINAL   below every installed trip
//   1 ACTIVE1   at or above `_AC0`
//   2 ACTIVE2   at or above `_AC1`
//   3 ACTIVE3   at or above `_AC2`
//   4 PASSIVE   at or above `_PSV`
//   5 CRITICAL  at or above `_CRT`, CONFIRMED (§3)
//
// In ACPI nothing guarantees `_PSV > _AC2`, and a machine where they
// cross would make "the highest crossed trip" ill-defined: the ladder
// would report PASSIVE while an active level the firmware wanted was
// never requested. Rather than resolve that at every evaluation, the
// INSTALL GATE REFUSES THE CROSSING (`THERMAL_TRIP_BAD_PSV`), which makes
// the ordering a property of every row that exists. Likewise `_AC0 < _AC1
// < _AC2` strictly, contiguous from `_AC0` (a non-zero `_AC1` with a zero
// `_AC0` is refused — ACPI numbers active levels from 0 and a gap means
// the parse lost one), and every installed trip strictly below `_CRT`.
//
// HYSTERESIS APPLIES ON THE WAY DOWN ONLY. Rising, the level follows the
// temperature immediately — a part getting hotter gets cooling now. To
// LEAVE level L the temperature must fall `hyst_dk` BELOW L's own
// threshold; until then the level holds. Expressed as `temp + hyst <
// threshold(L)` rather than `temp < threshold(L) - hyst` so the
// arithmetic cannot underflow on a cold zone with a large hysteresis.
//
// CRITICAL IS NEVER HYSTERETIC and is not part of the ladder's descent:
// it latches (§3) and the latch outranks every subsequent evaluation.
//
// =============================================================================
// §5  DERIVATION OVER KIND_DEVICE, AND WHAT THE GATE HONESTLY CANNOT CHECK
// =============================================================================
//
// The gate demands `kind == KIND_DEVICE (10)` carrying `RIGHT_MINT`, and
// #1075's lesson applies in full: EVERY PCI FUNCTION IN THE MACHINE IS A
// KIND_DEVICE, so that half discriminates nothing on its own.
//
// For `KIND_GPIO_LINE` the second half was a lookup in the probed pad
// controller table — a machine-side fact that told a network card from a
// pad controller. THERE IS NO EQUIVALENT HERE, and pretending otherwise
// would be worse than admitting it. "This device is a ThermalZone" is a
// statement about the firmware namespace: it is true because `\_TZ.TZ00`
// declares it, and reading that declaration is bytecode evaluation, which
// this ring may not do. The kernel cannot know.
//
// So the second half is what the kernel CAN enforce, stated exactly:
//
//   * The inherited device key must be NON-ZERO
//     (`THERMAL_MINT_NO_DEVICE`). A fabricated or empty parent
//     `target_ptr` cannot resolve to "device 0".
//   * NO OTHER LIVE ROW MAY HOLD THAT KEY
//     (`THERMAL_MINT_ZONE_IN_USE`). One zone, one capability. Two
//     capabilities for one zone means two policy servers with two
//     hysteresis states driving one set of fans, each unable to see the
//     other, which is `KIND_GPIO_LINE`'s "a pin has one state" argument
//     applied to a control loop.
//   * A plausible, non-zero `_CRT` and a non-zero hysteresis (§1, §2).
//
// The discrimination that this gate does not perform is performed by the
// ring-3 supervisor that walked the namespace, and the capability is the
// record of ITS decision. That is the honest division, and it is written
// here so that nobody later reads the kind check as though it proved
// something about the hardware.
//
// The identity is INHERITED, never argued — `thermal_zone_parent_key`
// reads the parent descriptor's `target_ptr`, the discipline #1070
// established and #1075 extended. A mint with a device key argument would
// let a holder attach a zone's trip points to a device its capability
// never named, and every reading thereafter would be confidently about
// the wrong part.
//
// =============================================================================
// §6  WHAT THIS KIND STILL DOES NOT DO
// =============================================================================
//
// Stated plainly, in the manner of `core/acpi/ec_event.pdx` §1, so that
// no reader has to discover it:
//
//   * NOTHING SHUTS THE MACHINE DOWN. `thermal_zone_assess` returns
//     `THERMAL_LVL_CRITICAL` and sets a latch. There is no consumer of
//     that latch in `src/`, because there is no platform power-off path
//     in this kernel at all — the same gap `core/acpi/ec_event.pdx` §1
//     records for the power button. `thermal_zone_crt_latched_of_slot`
//     exists so that the consumer, when it is written, reads the latch
//     rather than re-deriving the decision.
//   * NOTHING READS A REAL TEMPERATURE. `_TMP` is a firmware method, so
//     every reading this kind will ever see must arrive from ring 3.
//     `THERMAL_OP_ASSESS` is the route in and it exists and is reachable;
//     it has no ring-3 CALLER, because no ring-3 program evaluates `_TMP`
//     yet.
//   * NOTHING SETS A COOLING STATE. `KIND_COOLING_DEVICE` is R31.M4's.
//     This kind answers WHICH LEVEL, and deliberately holds no cooling
//     device identity: the level-to-device association is `_ALx`, which
//     is namespace, which is ring 3's. The planning tail's
//     `active_cooling_devs` is reconciled away for that reason — see
//     `design/architecture/next-wave-derived-kinds.md`.
//
// The boot witness therefore asserts trip arithmetic, unit conversion,
// hysteresis, confirmation and refusal. It asserts nothing about a fan.
//
// =============================================================================
// §7  NO PORT I/O, NO AML, NO FIRMWARE NAMES
// =============================================================================
//
// This module contains no `in`/`out` and no firmware-bytecode identifier.
// `tools/lint-no-kernel-aml.sh` refuses any kernel identifier matching
// `\baml`, `\bdsdt`, `\bssdt`, `\bacpica`, `\_SB_` or `\_SB.` in code AND
// in `justification:` strings, which are code and not comments.
// `KIND_THERMAL_ZONE`, `thermal_zone_*` and `_thermal_zone_table` match
// none of the six; the trip-point names `_CRT`, `_PSV`, `_ACx` and `_HYS`
// match none of the six either, and they appear only in comments and
// design prose in any case. Checked against the script rather than
// assumed, because #1569 records `KIND_AML_SESSION` being renamed for
// exactly this reason at push time.
//
// =============================================================================

module KindThermalZone = structure {

  // ==========================================================================
  // The tag, and the parent kind.
  // ==========================================================================

  pub let KIND_THERMAL_ZONE      : u64 = 0x157  // derived-kind tag (343)
  pub let THERMAL_PARENT_KIND    : u64 = 10     // = KIND_DEVICE

  // ==========================================================================
  // §0's unit. THE ONLY PLACE 2732 APPEARS.
  //
  // 0 °C is 273.15 K; ACPI's tenth-of-a-Kelvin grid cannot represent the
  // .15, and ACPI 6.5 §11.4 itself uses 2732 as the zero-Celsius offset.
  // Using the same constant firmware uses is worth more than a half-tenth
  // of a Kelvin of accuracy in a printer.
  // ==========================================================================

  pub let THERMAL_DK_ZERO_C : u64 = 2732

  // §3's plausibility window, in deci-Kelvin. −50.0 °C .. +150.0 °C.
  pub let THERMAL_DK_MIN : u64 = 2232
  pub let THERMAL_DK_MAX : u64 = 4232

  // §3's agreement window for the two-read critical confirmation, in
  // deci-Kelvin. 50 dK = 5.0 K.
  pub let THERMAL_CRT_CONFIRM_DELTA_DK : u64 = 50

  // §2's hysteresis bound, in deci-Kelvin. 1..200 (0.1 K .. 20.0 K). A
  // hysteresis wider than 20 K on a laptop zone would hold a fan level
  // across the whole span between two trip points, which is not
  // hysteresis but a different ladder.
  pub let THERMAL_HYST_MAX_DK : u64 = 200

  // ==========================================================================
  // §4's ladder.
  // ==========================================================================

  pub let THERMAL_LVL_NOMINAL  : u64 = 0
  pub let THERMAL_LVL_ACTIVE1  : u64 = 1
  pub let THERMAL_LVL_ACTIVE2  : u64 = 2
  pub let THERMAL_LVL_ACTIVE3  : u64 = 3
  pub let THERMAL_LVL_PASSIVE  : u64 = 4
  pub let THERMAL_LVL_CRITICAL : u64 = 5

  // ==========================================================================
  // Rights.
  //
  // R_THERMAL_READ and R_THERMAL_TRIP are the two halves of #1095's
  // effect row `!{thermal_read, thermal_trip}`, and the split is the
  // substance of it: "may be told how hot this zone is" and "may say what
  // hot means for this zone" are different authorities, and the second is
  // strictly the more dangerous. A policy server needs READ forever and
  // TRIP once, at install; keeping TRIP after that is keeping the ability
  // to install trips on a zone that has none.
  //
  // RIGHT_MINT (0x200) is OUTSIDE the mask and its absence is structural:
  // this kind is a leaf of the lattice. KIND_COOLING_DEVICE derives over
  // KIND_DEVICE, not over a zone, because a fan is a device the platform
  // has and not a subdivision of a temperature.
  // ==========================================================================

  pub let R_THERMAL_READ    : u64 = 0x001
  pub let R_THERMAL_TRIP    : u64 = 0x002
  pub let R_THERMAL_INVOKE  : u64 = 0x008
  pub let R_THERMAL_REVOKE  : u64 = 0x010
  pub let R_THERMAL_OBSERVE : u64 = 0x400
  pub let R_THERMAL_ALL     : u64 = 0x41B

  // ==========================================================================
  // Ops (op_arg[7:0]) and the right each requires.
  //
  //   0 QUERY_CRT       READ      the row's own _CRT, deci-Kelvin
  //   1 QUERY_HYST      INVOKE    hysteresis, deci-Kelvin
  //   2 QUERY_PSV       INVOKE    _PSV, deci-Kelvin, 0 = none installed
  //   3 QUERY_LEVEL     READ      the current ladder level
  //   4 QUERY_LATCHED   READ      1 once critical has been confirmed
  //   5 QUERY_TRIPS     INVOKE    count of installed optional trips
  //   6 QUERY_PARENT    INVOKE    the parent KIND_DEVICE slot
  //   7 DEBUG_PRINT     OBSERVE   canonical row dump
  //   8 ASSESS          READ      submit a reading; returns a verdict
  //
  // QUERY_CRT needs READ rather than INVOKE because a threshold is a
  // statement about how hot this part is allowed to get, which is the
  // same class of fact as its temperature; QUERY_HYST and QUERY_PSV are
  // configuration introspection. QUERY_LATCHED needs READ and not OBSERVE
  // because "has this part been past its limit" is the reading's
  // conclusion and not chatter about the row.
  //
  // ASSESS carries its reading in op_arg[31:16] — sixteen bits, which
  // covers the whole deci-Kelvin domain, and op_arg[63:32] must be ZERO
  // (THERMAL_OP_ARG_RESERVED) rather than masked. Fifty-six free bits on
  // an invocation that reaches a _CRT comparison is where a second
  // temperature would be smuggled, and masking would turn the attempt
  // into an ordinary successful call.
  // ==========================================================================

  pub let THERMAL_OP_QUERY_CRT     : u64 = 0
  pub let THERMAL_OP_QUERY_HYST    : u64 = 1
  pub let THERMAL_OP_QUERY_PSV     : u64 = 2
  pub let THERMAL_OP_QUERY_LEVEL   : u64 = 3
  pub let THERMAL_OP_QUERY_LATCHED : u64 = 4
  pub let THERMAL_OP_QUERY_TRIPS   : u64 = 5
  pub let THERMAL_OP_QUERY_PARENT  : u64 = 6
  pub let THERMAL_OP_DEBUG_PRINT   : u64 = 7
  pub let THERMAL_OP_ASSESS        : u64 = 8
  pub let THERMAL_OP_MAX           : u64 = 8

  // ==========================================================================
  // Failure taxonomy — 0xFFFFFE30..0xFFFFFE3F.
  //
  // A sixteen-wide band disjoint from every other in tree: KIND_FW_SESSION
  // owns 0xFFFFFE10..1F, the owner column owns 0xFFFFFE2B..2F, and the
  // whole 0xFFFFFFxx page is exhausted. Disjointness is what lets a code
  // threaded up through the mint, the row allocator and the dispatch
  // handler still name the gate that refused it.
  //
  // BAD_SLOT and WRONG_KIND are SHARED between the trip installer, the
  // assessor and the revoke rather than triplicated. A slot out of range
  // is the same operator problem whichever entry point saw it, and which
  // entry point it was is in the caller's own frame; spending six of
  // sixteen codes to restate the call site would have cost the band the
  // room the trip refusals actually need.
  // ==========================================================================

  pub let THERMAL_OK                : u64 = 0
  pub let THERMAL_TAIL_ENOSPC       : u64 = 0xFFFFFE3F
  pub let THERMAL_TAIL_BAD_ARG      : u64 = 0xFFFFFE3E
  pub let THERMAL_MINT_BAD_PARENT   : u64 = 0xFFFFFE3D
  pub let THERMAL_MINT_BAD_RIGHTS   : u64 = 0xFFFFFE3C
  pub let THERMAL_MINT_BAD_CRT      : u64 = 0xFFFFFE3B
  pub let THERMAL_MINT_BAD_HYST     : u64 = 0xFFFFFE3A
  pub let THERMAL_MINT_NO_DEVICE    : u64 = 0xFFFFFE39
  pub let THERMAL_MINT_ENOSPC       : u64 = 0xFFFFFE38
  pub let THERMAL_MINT_ZONE_IN_USE  : u64 = 0xFFFFFE37
  pub let THERMAL_BAD_SLOT          : u64 = 0xFFFFFE36
  pub let THERMAL_WRONG_KIND        : u64 = 0xFFFFFE35
  pub let THERMAL_REVOKE_ALREADY    : u64 = 0xFFFFFE34
  pub let THERMAL_TRIP_ALREADY      : u64 = 0xFFFFFE33
  pub let THERMAL_TRIP_BAD_PSV      : u64 = 0xFFFFFE32
  pub let THERMAL_TRIP_BAD_AC       : u64 = 0xFFFFFE31
  pub let THERMAL_IMPLAUSIBLE       : u64 = 0xFFFFFE30

  // The decoders' contract for a dead or out-of-range row. All-ones,
  // never a plausible zero — 0 dK is a value no live row can hold and 0
  // is also a legitimate answer for _PSV and for the ladder level, so a
  // decoder that returned zero on a dead row would be indistinguishable
  // from one reporting a cold, passively-unconfigured zone.
  pub let THERMAL_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF

  // `thermal_zone_find_by_key`'s "no row holds this key". 0xFF rather
  // than 0, because row 0 is a legitimate answer.
  pub let THERMAL_ROW_NONE : u64 = 0xFF

  // ==========================================================================
  // Table sizing and row layout.
  //
  // EIGHT ROWS, sized by ZONES A MACHINE HAS and not by processes. The
  // T14 G4 declares a handful — package, skin, battery bay — and no
  // laptop this OS has been near declares eight. A zone is a physical
  // part of one machine, so unlike KIND_ACPI_EVENT (whose sizing argument
  // is "one subscriber per process") there is no multiplier here.
  //
  // Sixty-four bytes per row so the index is a `shl 6`; paideia-as has no
  // `mul`.
  //
  //   [+0]  header word
  //           bits [7:0]   reserved, must be zero
  //           bits [15:8]  parent_slot  cap_table slot of the parent
  //                                     KIND_DEVICE at mint; audit and
  //                                     query only
  //           bits [23:16] num_trips    installed OPTIONAL trips, 0..4
  //                                     (_PSV plus up to three _ACx).
  //                                     _CRT and _HYS are not counted:
  //                                     they are never absent.
  //           bits [55:24] reserved, must be zero
  //           bits [63:56] in_use       allocator flag; a row is free iff
  //                                     this byte is zero, which .bss
  //                                     zero-init makes true at boot
  //   [+8]  zone_key    INHERITED from the parent descriptor's
  //                     target_ptr. Non-zero. The uniqueness key and the
  //                     cascade key.
  //   [+16] crt_dk      _CRT, deci-Kelvin. Non-zero and plausible. §1.
  //   [+24] hyst_dk     _HYS, deci-Kelvin. 1..THERMAL_HYST_MAX_DK. §2.
  //   [+32] psv_dk      _PSV, deci-Kelvin, or 0 for "firmware declared
  //                     none". §4 guarantees psv_dk > ac2_dk when both
  //                     are present.
  //   [+40] ac_levels   _AC0 [15:0] | _AC1 [31:16] | _AC2 [47:32];
  //                     [63:48] reserved, must be zero. Strictly
  //                     ascending, contiguous from _AC0, each below
  //                     crt_dk. Zero means "this level not declared".
  //   [+48] crt_cand    §3's confirmation candidate, deci-Kelvin, or 0
  //                     for "no reading above _CRT is outstanding".
  //   [+56] state word
  //           bits [7:0]   level        §4's current ladder level, 0..4
  //           bits [15:8]  crt_latched  0 | 1, set once, never cleared
  //           bits [31:16] reserved, must be zero
  //           bits [63:32] reads        assessments that reached the
  //                                     ladder, lifetime
  //
  // `tools/build.sh` asserts by `objdump -r` that no object other than
  // `core/cap/kind_thermal_zone.o` relocates against `_thermal_zone_table`.
  // The table is the only place in the kernel where a temperature
  // THRESHOLD lives, and a second writer could raise a _CRT with no
  // capability involved and no refusal recorded.
  // ==========================================================================

  pub let THERMAL_ZONE_MAX  : u64 = 8
  pub let THERMAL_ROW_BYTES : u64 = 64
  pub let THERMAL_TRIP_MAX  : u64 = 4

  pub let mut _thermal_zone_table : [u64; 64] = uninit @align(64)

  // Counters. Deliberately NOT in the row: they survive a revoke, because
  // "this zone kept returning nonsense" is evidence about a sensor and
  // outlives any one capability over it.
  //
  //   +0  assessed      readings that reached the ladder
  //   +8  implausible   readings refused by §3's bounds
  //   +16 armed         confirmation candidates recorded
  //   +24 disagreed     second readings that re-armed instead of latching
  //   +32 latched       critical confirmations, lifetime
  pub let mut _thermal_zone_stats : [u64; 8] = uninit @align(64)

  pub let THERMAL_ST_ASSESSED    : u64 = 0
  pub let THERMAL_ST_IMPLAUSIBLE : u64 = 1
  pub let THERMAL_ST_ARMED       : u64 = 2
  pub let THERMAL_ST_DISAGREED   : u64 = 3
  pub let THERMAL_ST_LATCHED     : u64 = 4
  pub let THERMAL_ST_MAX         : u64 = 8

  // Local klog keys and tags. The row-dump tag lives here rather than in
  // cap/tags.pdx so that dispatch chatter and row dumps never share a
  // label.
  pub let tz_dbg_msg : [u8; 17] = "THERMAL ZONE ROW\0"
  pub let tz_k_row   : [u8; 4]  = "row\0"
  pub let tz_k_crt   : [u8; 7]  = "crt_dk\0"
  pub let tz_k_hys   : [u8; 8]  = "hyst_dk\0"
  pub let tz_k_psv   : [u8; 7]  = "psv_dk\0"
  pub let tz_k_lvl   : [u8; 6]  = "level\0"
  pub let tz_k_crtc  : [u8; 7]  = "crt_dc\0"

  // ==========================================================================
  // thermal_zone_table_reset() -> ()
  // ==========================================================================

  pub let thermal_zone_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M2-001 (#1094): clear every row and every counter. Boot and teardown only. Two separate store runs rather than one over the sum, because the two arrays have different lengths and a single loop over their total would encode their adjacency in .bss as a fact the code depends on -- the discipline core/acpi/ec_event.pdx's reset established for the same reason. Bounded by immediate compares, 64 and 8 iterations. Leaf. Labels prefixed tz_rs_ per reserved-label discipline.",
      block: {
        lea r10, [rip + _thermal_zone_table];
        xor rax, rax;
        xor rcx, rcx;
      tz_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 64;
        jb  tz_rs_rows;

        lea r10, [rip + _thermal_zone_stats];
        xor rcx, rcx;
      tz_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  tz_rs_stats;
        ret
      }
    }

  // ==========================================================================
  // thermal_dk_to_dc(temp_dk) -> temp_dc
  //
  // §0. THE ONLY UNIT CONVERSION IN THE THERMAL PATH. DISPLAY ONLY.
  // ==========================================================================

  pub let thermal_dk_to_dc : (u64) -> u64 !{} @{} =
    fn (temp_dk: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R31.M2-001 (#1094): deci-Kelvin to deci-Celsius, temp_dk - THERMAL_DK_ZERO_C (2732). THIS IS THE ONLY CONVERSION IN THE MODULE AND IT IS NOT ON THE CONTROL PATH. Every comparison that decides anything -- against _CRT, _PSV, _ACx, or a hysteresis band -- happens between two deci-Kelvin quantities, so no decision in this file can be wrong about the unit; see sec 0. This function exists for thermal_zone_debug_print, and tools/build.sh confines relocations against it to this object so a future consumer cannot start converting before deciding. REFUSES rather than wrapping below the offset: a temp_dk under 2732 is below 0 C, which is representable in deci-Celsius only as a negative number, and this kernel's klog emitters print unsigned. Returning THERMAL_DECODE_BAD makes a sub-zero reading visible as un-renderable instead of appearing as an enormous positive temperature -- which is exactly the class of confusion sec 0 is about, and it would arrive through the one function whose whole job is not to cause it. The plausibility floor (2232) is BELOW the conversion floor (2732) on purpose: a zone at -20 C is implausible-adjacent but real on a cold morning and must still assess, so the refusal lives here in the printer and not in the bounds. Pure leaf. Labels prefixed tz_dc_ per reserved-label discipline.",
      block: {
        mov r10, 2732;                   // THERMAL_DK_ZERO_C
        cmp rdi, r10;
        jb  tz_dc_bad;
        mov rax, rdi;
        sub rax, r10;
        ret;
      tz_dc_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;     // THERMAL_DECODE_BAD
        ret
      }
    }

  // ==========================================================================
  // thermal_dk_plausible(temp_dk) -> 1 | 0
  //
  // §3. Is this a temperature at all.
  // ==========================================================================

  pub let thermal_dk_plausible : (u64) -> u64 !{} @{} =
    fn (temp_dk: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R31.M2-001 (#1094): 1 iff THERMAL_DK_MIN (2232, -50.0 C) <= temp_dk <= THERMAL_DK_MAX (4232, +150.0 C). The window is DELIBERATELY WIDE. Its job is to reject a byte that is not a temperature -- which is what an EC transaction unarbitrated against SMM can return while the ring-3 half of the #1580 plumbing has not activated aml_glk_attach -- and NOT to second-guess a sensor, because a bound tight enough to catch a mildly wrong reading is a bound that discards a real extreme one. Both failure directions are covered by one test and that is the point: a value too HIGH would power off a healthy machine through the _CRT path, a value too LOW masks a real overheat for as long as it persists, and a subsystem that only checked the first would be protecting the machine from itself while leaving it unprotected from heat. Inclusive at both ends: 2232 and 4232 are the stated limits and a limit that is refused is a different limit. Pure leaf. Labels prefixed tz_pl_ per reserved-label discipline.",
      block: {
        mov r10, 2232;                   // THERMAL_DK_MIN
        cmp rdi, r10;
        jb  tz_pl_no;
        mov r10, 4232;                   // THERMAL_DK_MAX
        cmp rdi, r10;
        ja  tz_pl_no;
        mov rax, 1;
        ret;
      tz_pl_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // thermal_zone_note(which) -> ()
  // ==========================================================================

  pub let thermal_zone_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M2-001 (#1094): increment one counter; a silent no-op on an out-of-range index. A no-op rather than a refusal because every caller is inside this module and passes a constant -- the bound is here so the array cannot be walked past if that ever stops being true, not so a caller can handle an error it has no way to act on. Same shape as ec_event_note. Leaf. Labels prefixed tz_nt_ per reserved-label discipline.",
      block: {
        cmp rdi, 8;                      // THERMAL_ST_MAX
        jae tz_nt_out;
        lea r10, [rip + _thermal_zone_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      tz_nt_out:
        ret
      }
    }

  pub let thermal_zone_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M2-001 (#1094): bounds-checked read of one counter; out of range returns 0. THIS IS WHAT MAKES A LYING SENSOR DIAGNOSABLE. A zone whose readings are refused by sec 3's bounds looks, from every other vantage point in the system, exactly like a zone that is comfortably cool: the level stays NOMINAL, no trip fires, nothing is logged as an error. The implausible count is the only place the difference is visible, and the difference is 'the fans are off because the part is cool' versus 'the fans are off because the kernel cannot read the part'. Leaf. Labels prefixed tz_st_ per reserved-label discipline.",
      block: {
        cmp rdi, 8;                      // THERMAL_ST_MAX
        jae tz_st_zero;
        lea r10, [rip + _thermal_zone_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      tz_st_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // thermal_zone_rights_valid(rights) -> 1 | 0
  // ==========================================================================

  pub let thermal_zone_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R31.M2-001 (#1094): 1 iff (rights & R_THERMAL_ALL) == rights. R_THERMAL_ALL = 0x41B (READ|TRIP|INVOKE|REVOKE|OBSERVE). A subset test and not an equality, so the two capabilities a policy server actually wants are both expressible: one that may install this zone's trip points once, and a strictly weaker one that may only be told which side of them a reading falls on. That split is the whole content of #1095's effect row -- thermal_read and thermal_trip are separate effects because saying what hot MEANS for a part is a larger authority than being told that it is. RIGHT_MINT (0x200) is OUTSIDE the mask: this kind is a leaf, and a MINT bit no gate reads is the shape that later acquires a meaning nobody audited. Pure leaf. Labels prefixed tz_rv_ per reserved-label discipline.",
      block: {
        mov rax, rdi;
        mov r10, 0x41B;                  // R_THERMAL_ALL
        and rax, r10;
        cmp rax, rdi;
        jne tz_rv_no;
        mov rax, 1;
        ret;
      tz_rv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // thermal_zone_check_parent_device(parent_slot) -> 1 | 0
  //
  // §5. THE FIRST HALF OF THE DERIVATION GATE, AND IT DISCRIMINATES
  // NOTHING ON ITS OWN.
  // ==========================================================================

  pub let thermal_zone_check_parent_device : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R31.M2-001 (#1094): the first half of the KIND_THERMAL_ZONE derivation gate. Bounds-check parent_slot < 256; load the descriptor at cap_table + parent_slot*24 (stride 24 per cap/mint.pdx); require kind == KIND_DEVICE (10) AND (rights & RIGHT_MINT 0x200) != 0. THIS HALF DISCRIMINATES NOTHING and the mint does not treat it as though it did -- every PCI function in the machine is a KIND_DEVICE, which is #1075's lesson stated for the third time. Where KIND_GPIO_LINE's second half could look the inherited identity up in a table of PROBED pad controllers, there is no such table here and there cannot be one in this ring: 'this device is a thermal zone' is true because the firmware namespace declares it, and reading that declaration is bytecode evaluation. So the second half, in thermal_zone_cap_mint_inner, is what the kernel CAN enforce and no more -- the inherited device key is non-zero, no other live row holds it, the _CRT is plausible and the hysteresis is not zero -- and sec 5 says so explicitly rather than letting a reader take this kind check for a hardware proof. Pure read. Labels prefixed tz_cpd_ per reserved-label discipline.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae tz_cpd_no;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 10;                     // KIND_DEVICE
        jne tz_cpd_no;

        mov r10, [rax + 8];
        mov r11, 0x200;                  // RIGHT_MINT
        and r10, r11;
        cmp r10, 0;
        je  tz_cpd_no;

        mov rax, 1;
        ret;

      tz_cpd_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // thermal_zone_parent_key(parent_slot) -> zone_key | 0
  //
  // §5. ZONE IDENTITY IS INHERITED, NEVER ARGUED.
  // ==========================================================================

  pub let thermal_zone_parent_key : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R31.M2-001 (#1094): read the parent KIND_DEVICE descriptor's target_ptr, which for a device capability is its identity key. THIS IS THE ONLY SOURCE OF A ZONE CAPABILITY'S IDENTITY: the mint has no device argument, so the part whose trip points a zone row holds is the part its parent capability names and no other. A mint that took the key as an argument would let a holder attach one part's critical threshold to a different part -- and the resulting row would be internally consistent, pass every other gate, and be confidently about the wrong piece of silicon for the rest of the boot. That is the discipline #1070 established and #1075 extended. Returns 0 for an out-of-range slot or a non-KIND_DEVICE descriptor, and 0 is exactly what thermal_zone_cap_mint_inner refuses with THERMAL_MINT_NO_DEVICE, so a fabricated parent cannot resolve to 'device 0' by accident. Pure read. Labels prefixed tz_pk_ per reserved-label discipline.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae tz_pk_no;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 10;                     // KIND_DEVICE
        jne tz_pk_no;

        mov rax, [rax + 16];             // target_ptr = device identity key
        ret;

      tz_pk_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // thermal_zone_hdr_pack(parent_slot, num_trips) -> hdr | THERMAL_DECODE_BAD
  // ==========================================================================

  pub let thermal_zone_hdr_pack : (u64, u64) -> u64 !{} @{} =
    fn (parent_slot: u64) (num_trips: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R31.M2-001 (#1094): canonical header-word encoder. Validates parent_slot < 256 and num_trips <= THERMAL_TRIP_MAX (4), then packs (parent_slot << 8) | (num_trips << 16), leaving bits [7:0], [55:24] and [63:56] clear. Bits [63:56] are the allocator's in_use flag and MUST leave this function zero, which is the whole reason the encoder exists rather than two shifts at the call site: a header arriving with in_use pre-set hands back a row the free scan skips forever, and on this kind the leaked row holds a critical threshold, so the next legitimate mint of that zone is refused ZONE_IN_USE by a ghost that is still the only record of how hot the part may get. Pure leaf. Labels prefixed tz_hp_ per reserved-label discipline.",
      block: {
        mov r10, 256;
        cmp rdi, r10;
        jae tz_hp_bad;
        mov r10, 4;                      // THERMAL_TRIP_MAX
        cmp rsi, r10;
        ja  tz_hp_bad;

        mov rax, rdi;
        shl rax, 8;
        mov r11, rsi;
        shl r11, 16;
        or  rax, r11;
        ret;

      tz_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;     // THERMAL_DECODE_BAD
        ret
      }
    }

  pub let thermal_zone_hdr_parent : (u64) -> u64 !{} @{} =
    fn (hdr: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R31.M2-001 (#1094): parent_slot from header bits [15:8]. A named accessor rather than a shift at each call site, so a future field added to the header cannot silently change what a caller reads. Pure leaf.",
      block: { mov rax, rdi; shr rax, 8; and rax, 0xFF; ret }
    }

  pub let thermal_zone_hdr_trips : (u64) -> u64 !{} @{} =
    fn (hdr: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R31.M2-001 (#1094): num_trips from header bits [23:16]. Pure leaf.",
      block: { mov rax, rdi; shr rax, 16; and rax, 0xFF; ret }
    }

  // ==========================================================================
  // thermal_zone_tail_alloc(hdr, zone_key, crt_dk, hyst_dk)
  //   -> row_id | THERMAL_TAIL_*
  //
  // THE ONLY FUNCTION IN THE KERNEL THAT WRITES A CRITICAL THRESHOLD.
  // ==========================================================================

  pub let thermal_zone_tail_alloc : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (zone_key: u64) (crt_dk: u64) (hyst_dk: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M2-001 (#1094): claim one row. THE ONLY FUNCTION IN THE KERNEL THAT WRITES A CRITICAL THRESHOLD, which is what makes the mint gate upstream of it exhaustive rather than merely usual, and which is why tools/build.sh confines relocations against _thermal_zone_table to this object. Gates, in order: hdr bits [63:56] non-zero -> TAIL_BAD_ARG (those are the allocator's in_use flag and a caller that pre-set them would be handed a row the free scan skips forever); hdr reserved bits [7:0] or [55:24] non-zero -> TAIL_BAD_ARG (a reserved bit merely ignored is a reserved bit a later revision cannot use); zone_key == 0 -> TAIL_BAD_ARG (0 is thermal_zone_parent_key's refusal value, and a row keyed on it would be a zone belonging to no device while still occupying the uniqueness key); crt_dk implausible -> TAIL_BAD_ARG; hyst_dk == 0 or > THERMAL_HYST_MAX_DK -> TAIL_BAD_ARG. THE _CRT AND HYSTERESIS CHECKS ARE HERE AS WELL AS IN THE MINT, and the duplication is deliberate: the mint's versions produce the specific codes an installer needs (MINT_BAD_CRT, MINT_BAD_HYST), while these make it impossible for ANY future second caller of the allocator to create a row without them. A row with a zero _CRT is a zone a policy server can read and act on with nothing behind it, and that state must be unrepresentable rather than merely unreached. Low-first scan over 8 rows of 64 bytes, free iff byte 7 of [row+0] is zero, which .bss zero-init makes true at boot; exhaustion -> TAIL_ENOSPC. Claim writes all eight words: hdr | (1 << 56), zone_key, crt_dk, hyst_dk, psv_dk = 0, ac_levels = 0, crt_cand = 0, state = 0 -- so a reused row cannot inherit the previous zone's optional trips, its hysteresis level or its critical latch. Five pushes leave rsp%16 == 0 at both nested calls. Labels prefixed tz_ta_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // hdr
        mov r13, rsi;                    // zone_key
        mov r14, rdx;                    // crt_dk
        mov r15, rcx;                    // hyst_dk

        // hdr in_use pre-set?
        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne tz_ta_bad;

        // hdr reserved [7:0]?
        mov rax, r12;
        and rax, 0xFF;
        cmp rax, 0;
        jne tz_ta_bad;

        // hdr reserved [55:24]?
        mov rax, r12;
        shr rax, 24;
        mov r10, 0xFFFFFFFF;
        and rax, r10;
        cmp rax, 0;
        jne tz_ta_bad;

        cmp r13, 0;
        je  tz_ta_bad;

        mov rdi, r14;
        call thermal_dk_plausible;
        cmp rax, 0;
        je  tz_ta_bad;

        cmp r15, 0;
        je  tz_ta_bad;
        mov r10, 200;                    // THERMAL_HYST_MAX_DK
        cmp r15, r10;
        ja  tz_ta_bad;

        // Low-first free scan.
        xor rbx, rbx;                    // row_id
      tz_ta_scan:
        cmp rbx, 8;                      // THERMAL_ZONE_MAX
        jae tz_ta_enospc;

        lea r10, [rip + _thermal_zone_table];
        mov r11, rbx;
        shl r11, 6;                      // row * 64
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  tz_ta_claim;

        add rbx, 1;
        jmp tz_ta_scan;

      tz_ta_claim:
        mov rax, r12;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;                    // in_use = 1
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r13;             // zone_key
        mov [r10 + 16], r14;             // crt_dk
        mov [r10 + 24], r15;             // hyst_dk
        xor rax, rax;
        mov [r10 + 32], rax;             // psv_dk
        mov [r10 + 40], rax;             // ac_levels
        mov [r10 + 48], rax;             // crt_cand
        mov [r10 + 56], rax;             // state
        mov rax, rbx;
        jmp tz_ta_out;

      tz_ta_enospc:
        mov rax, 0xFFFFFE3F;             // THERMAL_TAIL_ENOSPC
        jmp tz_ta_out;
      tz_ta_bad:
        mov rax, 0xFFFFFE3E;             // THERMAL_TAIL_BAD_ARG

      tz_ta_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let thermal_zone_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M2-001 (#1094): 1 iff row_id < THERMAL_ZONE_MAX and the row's in_use byte is set. Every decoder gates on this so that a freed row answers THERMAL_DECODE_BAD rather than the zeroes it was scrubbed to -- which on this kind matters more than usual, since a scrubbed row renders as {crt 0, level 0, latched 0}, i.e. as a zone with no critical threshold sitting comfortably cool. Leaf. Labels prefixed tz_tv_ per reserved-label discipline.",
      block: {
        cmp rdi, 8;                      // THERMAL_ZONE_MAX
        jae tz_tv_no;
        lea r10, [rip + _thermal_zone_table];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  tz_tv_no;
        mov rax, 1;
        ret;
      tz_tv_no:
        xor rax, rax;
        ret
      }
    }

  pub let thermal_zone_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M2-001 (#1094): scrub one row to zero, which clears in_use and returns it to the free scan. ALL EIGHT WORDS, including the critical latch and the hysteresis level: a revoke is the one point at which somebody has decided this zone's history no longer applies, and a row that kept its latch across a re-mint would report a part as having been past its limit on the strength of a reading taken about a capability that no longer exists. Scrubbing the KEY is what makes the zone re-mintable, and therefore what makes a policy-server restart possible at all. A no-op on an out-of-range row rather than a refusal: the callers are the revoke path and the allocator's own error handling, neither of which has an action for a failure. Leaf. Labels prefixed tz_tf_ per reserved-label discipline.",
      block: {
        cmp rdi, 8;                      // THERMAL_ZONE_MAX
        jae tz_tf_out;
        lea r10, [rip + _thermal_zone_table];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        mov [r10 + 32], rax;
        mov [r10 + 40], rax;
        mov [r10 + 48], rax;
        mov [r10 + 56], rax;
      tz_tf_out:
        ret
      }
    }

  // ==========================================================================
  // Row accessors. Every one returns THERMAL_DECODE_BAD for a dead row.
  // ==========================================================================

  pub let thermal_zone_row_hdr : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M2-001 (#1094): the raw header word of a live row, or THERMAL_DECODE_BAD. Three pushes leave rsp%16 == 0 at the nested validity call. Labels prefixed tz_rh_ per reserved-label discipline.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        call thermal_zone_tail_valid;
        cmp rax, 0;
        je  tz_rh_bad;
        lea r10, [rip + _thermal_zone_table];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        jmp tz_rh_out;
      tz_rh_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      tz_rh_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let thermal_zone_row_key : (u64) -> u64 !{mem} @{} =
