// src/kernel/core/cap/kind_tb_domain.pdx — R35.M2-003 (#1203)
//
// KIND_TB_DOMAIN = 0x16C, derived over KIND_DEVICE (10).
//
// The authority to hold ONE Thunderbolt 4 / USB4 domain's static
// identity — its inherited domain_key, the cap_table slot of its
// parent KIND_DEVICE (device_slot), the NHI (Native Host Interface)
// PCIe bus:dev:func the domain is anchored on, a per-machine
// domain_id, the 24-bit route_id (five bits per hop, USB4 spec §5),
// and its current state (uninit / probed / active / torn).
//
// =============================================================================
// §0  WHY THIS KIND EXISTS
// =============================================================================
//
// A Thunderbolt domain is a TREE of routers rooted at one NHI, and
// every capability decision downstream of it — tunnel establishment,
// DMA-domain boundaries, PCIe endpoint attach — is scoped by the
// domain the router sits inside. Two NHIs on the same machine host
// two disjoint domains, so the capability that names "this side of
// the tree" has to be per-NHI rather than per-controller. This kind
// is the record of one such tree.
//
// =============================================================================
// §1  DERIVATION OVER KIND_DEVICE
// =============================================================================
//
// The gate demands `kind == KIND_DEVICE (10)` carrying `RIGHT_MINT`.
// Like KIND_FP_SENSOR, KIND_HID_DEVICE and every other KIND_DEVICE-
// derived kind, THE KIND HALF OF THE GATE DISCRIMINATES NOTHING on
// its own — every PCI function in the machine is a KIND_DEVICE — so
// the mint additionally requires:
//
//   (a) domain_key non-zero and unique among live rows (NO_KEY / IN_USE)
//   (b) device_slot names a live KIND_DEVICE with RIGHT_MINT; the
//       device identity is INHERITED from the parent's target_ptr
//       rather than accepted as an argument (NO_DEVICE)
//   (c) nhi_bdf fits in u16 (BAD_BDF)
//   (d) domain_id fits in u8 (BAD_DOMAIN_ID)
//   (e) route_id fits in 24 bits — every USB4 route is a sequence of
//       5-bit adapter ordinals capped at 12 hops (BAD_ROUTE)
//   (f) state in {0,1,2,3} — {UNINIT, PROBED, ACTIVE, TORN} (BAD_STATE)
//   (g) rights subset of R_TB_DOMAIN_ALL
//
// =============================================================================
// §2  STATE IS THE ONE DYNAMIC FIELD
// =============================================================================
//
// domain_key, device_slot, nhi_bdf, domain_id and route_id are ROW
// IDENTITY, frozen at mint. state moves through {UNINIT → PROBED →
// ACTIVE → TORN} as the topology walker discovers routers and the
// supervisor tears them down, but the transition primitive is NOT on
// this kind: kind_tb_domain exposes only ROW ACCESSORS and a COUNTER,
// and the state field is the record of decisions taken elsewhere.
//
// =============================================================================
// §3  LEAF OF THE TB LATTICE
// =============================================================================
//
// R_TB_DOMAIN_MINT (0x200) is DELIBERATELY ABSENT from
// R_TB_DOMAIN_ALL: nothing derives from a tb-domain cap in this
// milestone. Same discipline KIND_FP_SENSOR / KIND_USB_URB /
// KIND_ISOCH_STREAM applied for the same reason — a future tunnel
// or peer-router kind can be added as a separate derived kind that
// consults this one at mint.
//
// =============================================================================
// §4  FAILURE TAXONOMY 0xFFFFF9F0..0xFFFFF9FF
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent free bands: tb_nhi_probe 0xFFFFF9E0..EF,
// tb_cm_rings 0xFFFFF9D0..DF, tb_router_walk 0xFFFFF9C0..CF,
// tb_topology_channel 0xFFFFF9B0..BF; adjacent used band above:
// pcie_link_retrain 0xFFFFFA00..0F).

module KindTbDomain = structure {

  pub let KIND_TB_DOMAIN         : u64 = 0x16C
  pub let TB_DOMAIN_PARENT_KIND  : u64 = 10          // = KIND_DEVICE

  // State ordinals (§2).
  pub let TB_STATE_UNINIT : u64 = 0
  pub let TB_STATE_PROBED : u64 = 1
  pub let TB_STATE_ACTIVE : u64 = 2
  pub let TB_STATE_TORN   : u64 = 3
  pub let TB_STATE_MAX    : u64 = 3

  // Route bounds. 24 bits total: five bits per hop, twelve hops max
  // per USB4 §5.
  pub let TB_ROUTE_BITS : u64 = 24
  pub let TB_ROUTE_MAX  : u64 = 0xFFFFFF

  // Rights. Leaf: RIGHT_MINT NOT in the mask (§3).
  pub let R_TB_DOMAIN_READ    : u64 = 0x001
  pub let R_TB_DOMAIN_INVOKE  : u64 = 0x008
  pub let R_TB_DOMAIN_REVOKE  : u64 = 0x010
  pub let R_TB_DOMAIN_OBSERVE : u64 = 0x400
  pub let R_TB_DOMAIN_ALL     : u64 = 0x419

  // Ops. Every op takes NO OPERAND — op_arg[63:8] REFUSED.
  pub let TB_DOM_OP_QUERY_KEY       : u64 = 0
  pub let TB_DOM_OP_QUERY_DEVICE    : u64 = 1
  pub let TB_DOM_OP_QUERY_NHI_BDF   : u64 = 2
  pub let TB_DOM_OP_QUERY_DOMAIN_ID : u64 = 3
  pub let TB_DOM_OP_QUERY_ROUTE_ID  : u64 = 4
  pub let TB_DOM_OP_QUERY_STATE     : u64 = 5
  pub let TB_DOM_OP_QUERY_PARENT    : u64 = 6
  pub let TB_DOM_OP_DEBUG_PRINT     : u64 = 7
  pub let TB_DOM_OP_MAX             : u64 = 7

  // Failure taxonomy — 0xFFFFF9F0..0xFFFFF9FF.
  pub let TB_DOM_OK                 : u64 = 0
  pub let TB_DOM_TAIL_ENOSPC        : u64 = 0xFFFFF9FF
  pub let TB_DOM_TAIL_BAD_ARG       : u64 = 0xFFFFF9FE
  pub let TB_DOM_MINT_BAD_PARENT    : u64 = 0xFFFFF9FD
  pub let TB_DOM_MINT_BAD_RIGHTS    : u64 = 0xFFFFF9FC
  pub let TB_DOM_MINT_BAD_BDF       : u64 = 0xFFFFF9FB
  pub let TB_DOM_MINT_BAD_DOMAIN_ID : u64 = 0xFFFFF9FA
  pub let TB_DOM_MINT_BAD_ROUTE     : u64 = 0xFFFFF9F9
  pub let TB_DOM_MINT_BAD_STATE     : u64 = 0xFFFFF9F8
  pub let TB_DOM_MINT_NO_DEVICE     : u64 = 0xFFFFF9F7
  pub let TB_DOM_MINT_NO_KEY        : u64 = 0xFFFFF9F6
  pub let TB_DOM_MINT_ENOSPC        : u64 = 0xFFFFF9F5
  pub let TB_DOM_MINT_IN_USE        : u64 = 0xFFFFF9F4
  pub let TB_DOM_BAD_SLOT           : u64 = 0xFFFFF9F3
  pub let TB_DOM_WRONG_KIND         : u64 = 0xFFFFF9F2
  pub let TB_DOM_REVOKE_ALREADY     : u64 = 0xFFFFF9F1

  pub let TB_DOM_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let TB_DOM_ROW_NONE   : u64 = 0xFF

  // 8 rows, 32-byte stride.
  //   [+0]  header (in_use[63:56] | parent_slot[15:8])
  //   [+8]  domain_key
  //   [+16] body word 1: device_slot[31:0] | nhi_bdf[47:32]
  //                     | domain_id[55:48] | state[63:56]
  //   [+24] body word 2: route_id[23:0] | reserved[63:24]
  pub let TB_DOMAIN_MAX       : u64 = 8
  pub let TB_DOMAIN_ROW_BYTES : u64 = 32

  pub let mut _tb_domain_table : [u64; 32] = uninit @align(64)
  pub let mut _tb_domain_stats : [u64; 4]  = uninit @align(64)

  pub let TB_DOM_ST_MINTS   : u64 = 0
  pub let TB_DOM_ST_REVOKES : u64 = 1
  pub let TB_DOM_ST_IN_USE  : u64 = 2
  pub let TB_DOM_ST_ENOSPC  : u64 = 3

  pub let tb_dom_dbg_msg : [u8; 14] = "TB DOMAIN ROW\0"

  // ==========================================================================
  // Table reset.
  // ==========================================================================

  pub let tb_domain_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M2-003 (#1203): clear the TB DOMAIN row table and its counters. Boot and teardown only. Labels prefixed tbd_rs_.",
      block: {
        lea r10, [rip + _tb_domain_table];
        xor rax, rax;
        xor rcx, rcx;
      tbd_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  tbd_rs_rows;

        lea r10, [rip + _tb_domain_stats];
        xor rcx, rcx;
      tbd_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  tbd_rs_stats;
        ret
      }
    }

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let tb_domain_bdf_valid : (u64) -> u64 !{} @{} =
    fn (b: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M2-003 (#1203): 1 iff b fits in u16 (bus:dev:func packed as bus[15:8] dev[7:3] func[2:0]). Labels prefixed tbd_bv_.",
      block: {
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  tbd_bv_no;
        mov rax, 1;
        ret;
      tbd_bv_no:
        xor rax, rax;
        ret
      }
    }

  pub let tb_domain_id_valid : (u64) -> u64 !{} @{} =
    fn (d: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M2-003 (#1203): 1 iff d fits in u8. Labels prefixed tbd_iv_.",
      block: {
        cmp rdi, 0xFF;
        ja  tbd_iv_no;
        mov rax, 1;
        ret;
      tbd_iv_no:
        xor rax, rax;
        ret
      }
    }

  pub let tb_domain_route_valid : (u64) -> u64 !{} @{} =
    fn (r: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M2-003 (#1203): 1 iff r fits in 24 bits (USB4 §5 route). Labels prefixed tbd_rv_.",
      block: {
        mov r10, 0xFFFFFF;
        cmp rdi, r10;
        ja  tbd_rv_no;
        mov rax, 1;
        ret;
      tbd_rv_no:
        xor rax, rax;
        ret
      }
    }

  pub let tb_domain_state_valid : (u64) -> u64 !{} @{} =
    fn (s: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M2-003 (#1203): 1 iff s in {0,1,2,3} (UNINIT/PROBED/ACTIVE/TORN). Labels prefixed tbd_sv_.",
      block: {
        cmp rdi, 3;
        ja  tbd_sv_no;
        mov rax, 1;
        ret;
      tbd_sv_no:
        xor rax, rax;
        ret
      }
    }

  pub let tb_domain_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M2-003 (#1203): subset test against R_TB_DOMAIN_ALL = 0x419. RIGHT_MINT (0x200) is OUTSIDE the mask — this kind is a leaf (§3). Labels prefixed tbd_rgv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x419;
        and rax, r10;
        cmp rax, rdi;
        jne tbd_rgv_no;
        mov rax, 1;
        ret;
      tbd_rgv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Counters.
  // ==========================================================================

  pub let tb_domain_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M2-003 (#1203): counter bump. Labels prefixed tbd_nt_.",
      block: {
        cmp rdi, 4;
        jae tbd_nt_out;
        lea r10, [rip + _tb_domain_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      tbd_nt_out:
        ret
      }
    }

  pub let tb_domain_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M2-003 (#1203): counter read. Labels prefixed tbd_st_.",
      block: {
        cmp rdi, 4;
        jae tbd_st_zero;
        lea r10, [rip + _tb_domain_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      tbd_st_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Parent gate: parent must be live KIND_DEVICE with RIGHT_MINT.
  // ==========================================================================

  pub let tb_domain_check_parent : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R35.M2-003 (#1203): §1 gate. parent must be live KIND_DEVICE (10) with RIGHT_MINT. Kind check alone discriminates NOTHING; the mint's additional gates cover the rest. Labels prefixed tbd_cp_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae tbd_cp_no;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 10;                     // KIND_DEVICE
        jne tbd_cp_no;

        mov r10, [rax + 8];
        mov r11, 0x200;                  // RIGHT_MINT
        and r10, r11;
        cmp r10, 0;
        je  tbd_cp_no;

        mov rax, 1;
        ret;
      tbd_cp_no:
        xor rax, rax;
        ret
      }
    }

  // Read parent KIND_DEVICE identity from its target_ptr.
  pub let tb_domain_parent_key : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R35.M2-003 (#1203): parent KIND_DEVICE target_ptr = its identity key. 0 if bad slot or wrong kind — the mint refuses NO_DEVICE for 0. Labels prefixed tbd_pk_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae tbd_pk_no;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 10;
        jne tbd_pk_no;

        mov rax, [rax + 16];
        ret;
      tbd_pk_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Header + body packers.
  // ==========================================================================

  pub let tb_domain_hdr_pack : (u64) -> u64 !{} @{} =
    fn (parent_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M2-003 (#1203): (parent_slot << 8). Labels prefixed tbd_hp_.",
      block: {
        mov r10, 256;
        cmp rdi, r10;
        jae tbd_hp_bad;
        mov rax, rdi;
        shl rax, 8;
        ret;
      tbd_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let tb_domain_body1_pack : (u64, u64, u64, u64) -> u64 !{} @{} =
    fn (device_slot: u64) (nhi_bdf: u64) (domain_id: u64) (state: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M2-003 (#1203): pack device_slot[31:0] | nhi_bdf[47:32] | domain_id[55:48] | state[63:56]. Refuses out-of-range fields. Labels prefixed tbd_b1_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  tbd_b1_bad;
        mov r10, 0xFFFF;
        cmp rsi, r10;
        ja  tbd_b1_bad;
        cmp rdx, 0xFF;
        ja  tbd_b1_bad;
        cmp rcx, 3;
        ja  tbd_b1_bad;

        mov rax, rdi;
        and rax, 0xFFFFFFFF;
        mov r10, rsi;
        and r10, 0xFFFF;
        shl r10, 32;
        or  rax, r10;
        mov r10, rdx;
        and r10, 0xFF;
        shl r10, 48;
        or  rax, r10;
        mov r10, rcx;
        and r10, 0xFF;
        shl r10, 56;
        or  rax, r10;
        ret;
      tbd_b1_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let tb_domain_body2_pack : (u64) -> u64 !{} @{} =
    fn (route_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M2-003 (#1203): pack route_id[23:0]. Reserved [63:24] left zero. Refuses out-of-range route. Labels prefixed tbd_b2_.",
      block: {
        mov r10, 0xFFFFFF;
        cmp rdi, r10;
        ja  tbd_b2_bad;
        mov rax, rdi;
        and rax, 0xFFFFFF;
        ret;
      tbd_b2_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // Tail alloc/valid/free.
  //
  // THE ONE WRITER of _tb_domain_table. tools/build.sh confines
  // relocations against `_tb_domain_table` to this object.
  // ==========================================================================

  pub let tb_domain_tail_alloc : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (domain_key: u64) (body1_packed: u64) (body2_packed: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M2-003 (#1203): claim one TB DOMAIN row. THE ONE WRITER of _tb_domain_table. Gates: hdr in_use pre-set -> BAD_ARG; domain_key != 0 -> BAD_ARG; body1/body2 != DECODE_BAD -> BAD_ARG. Low-first free scan over 8 rows of 32 bytes. Labels prefixed tbd_ta_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // hdr
        mov r13, rsi;                    // domain_key
        mov r14, rdx;                    // body1
        mov r15, rcx;                    // body2

        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne tbd_ta_bad;

        cmp r13, 0;
        je  tbd_ta_bad;

        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp r14, r10;
        je  tbd_ta_bad;
        cmp r15, r10;
        je  tbd_ta_bad;

        xor rbx, rbx;
      tbd_ta_scan:
        cmp rbx, 8;
        jae tbd_ta_enospc;

        lea r10, [rip + _tb_domain_table];
        mov r11, rbx;
        shl r11, 5;
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  tbd_ta_claim;

        add rbx, 1;
        jmp tbd_ta_scan;

      tbd_ta_claim:
        mov rax, r12;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r13;
        mov [r10 + 16], r14;
        mov [r10 + 24], r15;
        mov rax, rbx;
        jmp tbd_ta_out;

      tbd_ta_enospc:
        mov rax, 0xFFFFF9FF;
        jmp tbd_ta_out;
      tbd_ta_bad:
        mov rax, 0xFFFFF9FE;

      tbd_ta_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let tb_domain_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M2-003 (#1203): 1 iff row_id < MAX and in_use. Labels prefixed tbd_tvr_.",
      block: {
        cmp rdi, 8;
        jae tbd_tvr_no;
        lea r10, [rip + _tb_domain_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  tbd_tvr_no;
        mov rax, 1;
        ret;
      tbd_tvr_no:
        xor rax, rax;
        ret
      }
    }

  pub let tb_domain_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M2-003 (#1203): scrub one row. Labels prefixed tbd_tf_.",
      block: {
        cmp rdi, 8;
        jae tbd_tf_out;
        lea r10, [rip + _tb_domain_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
      tbd_tf_out:
        ret
      }
    }

  // ==========================================================================
  // Row accessors.
  // ==========================================================================

  pub let tb_domain_row_key : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M2-003 (#1203): domain_key. Labels prefixed tbd_rk_.",
      block: {
        push r12; push r13; push r14;
        mov r12, rdi;
        call tb_domain_tail_valid;
        cmp rax, 0;
        je  tbd_rk_bad;
        lea r10, [rip + _tb_domain_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 8];
        jmp tbd_rk_out;
      tbd_rk_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      tbd_rk_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  pub let tb_domain_row_device : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M2-003 (#1203): device_slot. Labels prefixed tbd_rd_.",
      block: {
        push r12; push r13; push r14;
        mov r12, rdi;
        call tb_domain_tail_valid;
        cmp rax, 0;
        je  tbd_rd_bad;
        lea r10, [rip + _tb_domain_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        and rax, 0xFFFFFFFF;
        jmp tbd_rd_out;
      tbd_rd_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      tbd_rd_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  pub let tb_domain_row_nhi_bdf : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M2-003 (#1203): nhi_bdf. Labels prefixed tbd_rn_.",
      block: {
        push r12; push r13; push r14;
        mov r12, rdi;
        call tb_domain_tail_valid;
        cmp rax, 0;
        je  tbd_rn_bad;
        lea r10, [rip + _tb_domain_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 32;
        and rax, 0xFFFF;
        jmp tbd_rn_out;
      tbd_rn_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      tbd_rn_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  pub let tb_domain_row_domain_id : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M2-003 (#1203): domain_id. Labels prefixed tbd_ri_.",
      block: {
        push r12; push r13; push r14;
        mov r12, rdi;
        call tb_domain_tail_valid;
        cmp rax, 0;
        je  tbd_ri_bad;
        lea r10, [rip + _tb_domain_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 48;
        and rax, 0xFF;
        jmp tbd_ri_out;
      tbd_ri_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      tbd_ri_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

