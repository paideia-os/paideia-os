  // ==========================================================================
  // Lookups.
  // ==========================================================================

  pub let tb_domain_find_by_key : (u64) -> u64 !{mem} @{} =
    fn (domain_key: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M2-003 (#1203): live row holding this domain_key, or ROW_NONE. Refuses to match 0. Labels prefixed tbd_fk_.",
      block: {
        cmp rdi, 0;
        je  tbd_fk_none;
        xor rcx, rcx;
      tbd_fk_scan:
        cmp rcx, 8;
        jae tbd_fk_none;
        lea r10, [rip + _tb_domain_table];
        mov r11, rcx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  tbd_fk_next;
        mov rax, [r10 + 8];
        cmp rax, rdi;
        je  tbd_fk_hit;
      tbd_fk_next:
        add rcx, 1;
        jmp tbd_fk_scan;
      tbd_fk_hit:
        mov rax, rcx;
        ret;
      tbd_fk_none:
        mov rax, 0xFF;
        ret
      }
    }

  pub let tb_domain_row_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R35.M2-003 (#1203): slot -> row_id, gated on live KIND_TB_DOMAIN. Labels prefixed tbd_ros_.",
      block: {
        push r12; push r13; push r14;

        mov r11, 256;
        cmp rdi, r11;
        jae tbd_ros_none;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x16C;
        cmp r10, r11;
        jne tbd_ros_none;

        mov r12, [rax + 16];
        mov r10, 0xFFFF;
        and r12, r10;

        mov rdi, r12;
        call tb_domain_tail_valid;
        cmp rax, 0;
        je  tbd_ros_none;

        mov rax, r12;
        jmp tbd_ros_out;

      tbd_ros_none:
        mov rax, 0xFF;
      tbd_ros_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  pub let tb_domain_key_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R35.M2-003 (#1203): domain_key. ARITY ONE. Labels prefixed tbd_kos_.",
      block: {
        push r12; push r13; push r14;
        call tb_domain_row_of_slot;
        mov r12, rax;
        cmp r12, 0xFF;
        je  tbd_kos_bad;
        mov rdi, r12;
        call tb_domain_row_key;
        jmp tbd_kos_out;
      tbd_kos_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      tbd_kos_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  pub let tb_domain_route_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R35.M2-003 (#1203): route_id. ARITY ONE. Labels prefixed tbd_rtos_.",
      block: {
        push r12; push r13; push r14;
        call tb_domain_row_of_slot;
        mov r12, rax;
        cmp r12, 0xFF;
        je  tbd_rtos_bad;
        mov rdi, r12;
        call tb_domain_row_route_id;
        jmp tbd_rtos_out;
      tbd_rtos_bad:
