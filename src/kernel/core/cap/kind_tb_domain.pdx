      }
    }

  // ==========================================================================
  // Mint. Six args (slot, parent_slot, rights, domain_key, device_slot,
  // packed_ident). packed_ident encoding:
  //   [15:0]  nhi_bdf
  //   [23:16] domain_id
  //   [47:24] route_id
  //   [55:48] state
  //   [63:56] reserved (must be zero)
  // ==========================================================================

  pub let tb_domain_cap_mint_inner : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (domain_key: u64) (device_slot: u64) (packed_ident: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R35.M2-003 (#1203): mint KIND_TB_DOMAIN over KIND_DEVICE. Six args (slot, parent, rights, key, device_slot, packed). packed = nhi_bdf[15:0] | domain_id[23:16] | route_id[47:24] | state[55:48]. Sequence: slot<256; check_parent; parent_key non-zero (NO_DEVICE); rights_valid; unpack + validate bdf/id/route/state; domain_key non-zero (NO_KEY); uniqueness (IN_USE); hdr_pack; body1_pack; body2_pack; tail_alloc; cap_mint_write. Labels prefixed tbd_mi_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov rbx, rdi;                    // slot
        mov r12, rsi;                    // parent_slot
        mov r13, rdx;                    // rights
        mov r14, rcx;                    // domain_key
        mov r15, r8;                     // device_slot
        mov rbp, r9;                     // packed_ident

        mov r10, 256;
        cmp rbx, r10;
        jae tbd_mi_bad_slot;

        mov rdi, r12;
        call tb_domain_check_parent;
        cmp rax, 0;
        je  tbd_mi_bad_parent;

        mov rdi, r12;
        call tb_domain_parent_key;
        cmp rax, 0;
        je  tbd_mi_no_device;

        mov rdi, r13;
        call tb_domain_rights_valid;
        cmp rax, 0;
        je  tbd_mi_bad_rights;

        // Validate nhi_bdf.
        mov rdi, rbp;
        and rdi, 0xFFFF;
        call tb_domain_bdf_valid;
        cmp rax, 0;
        je  tbd_mi_bad_bdf;

        // Validate domain_id.
        mov rdi, rbp;
        shr rdi, 16;
        and rdi, 0xFF;
        call tb_domain_id_valid;
        cmp rax, 0;
        je  tbd_mi_bad_domain_id;

        // Validate route_id.
        mov rdi, rbp;
        shr rdi, 24;
        and rdi, 0xFFFFFF;
        call tb_domain_route_valid;
        cmp rax, 0;
        je  tbd_mi_bad_route;

        // Validate state.
        mov rdi, rbp;
        shr rdi, 48;
        and rdi, 0xFF;
        call tb_domain_state_valid;
        cmp rax, 0;
        je  tbd_mi_bad_state;

        cmp r14, 0;
        je  tbd_mi_no_key;

        mov rdi, r14;
        call tb_domain_find_by_key;
        cmp rax, 0xFF;
        jne tbd_mi_in_use;

        // Body1 pack args: (device_slot, nhi_bdf, domain_id, state).
        mov rdi, r15;                    // device_slot
        mov rsi, rbp;
        and rsi, 0xFFFF;                 // nhi_bdf
        mov rdx, rbp;
        shr rdx, 16;
        and rdx, 0xFF;                   // domain_id
        mov rcx, rbp;
        shr rcx, 48;
        and rcx, 0xFF;                   // state
        call tb_domain_body1_pack;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  tbd_mi_bad_bdf;
        push rax;                        // body1
        sub rsp, 8;

        // Body2 pack: route_id.
        mov rdi, rbp;
        shr rdi, 24;
        and rdi, 0xFFFFFF;
        call tb_domain_body2_pack;
        add rsp, 8;
        pop r11;                         // body1
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  tbd_mi_bad_route;
        mov r15, rax;                    // body2 in r15
        push r11;                        // body1
        sub rsp, 8;

        // Header.
        mov rdi, r12;
        call tb_domain_hdr_pack;
        add rsp, 8;
        pop r11;                         // body1
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  tbd_mi_bad_parent;

        // tail_alloc(hdr, domain_key, body1, body2).
        mov rdi, rax;                    // hdr
        mov rsi, r14;                    // domain_key
        mov rdx, r11;                    // body1
        mov rcx, r15;                    // body2
        call tb_domain_tail_alloc;

        mov r10, 0xFFFFF9FF;             // ENOSPC
        cmp rax, r10;
        je  tbd_mi_enospc;
        mov r10, 0xFFFFF9FE;             // BAD_ARG
        cmp rax, r10;
        je  tbd_mi_bad_bdf;

        mov r15, rax;                    // row_id
        mov r11, rbx;
        shl r11, 16;
        or  r15, r11;

        mov rdi, rbx;
        mov rsi, 0x16C;
        mov rdx, r13;
        mov rcx, r15;
        call cap_mint_write;

        mov rdi, 0;
        call tb_domain_note;

        xor rax, rax;
        jmp tbd_mi_out;

      tbd_mi_bad_slot:
        mov rax, 0xFFFFF9F3;
        jmp tbd_mi_out;
      tbd_mi_bad_parent:
        mov rax, 0xFFFFF9FD;
        jmp tbd_mi_out;
      tbd_mi_bad_rights:
        mov rax, 0xFFFFF9FC;
        jmp tbd_mi_out;
      tbd_mi_bad_bdf:
        mov rax, 0xFFFFF9FB;
        jmp tbd_mi_out;
      tbd_mi_bad_domain_id:
        mov rax, 0xFFFFF9FA;
        jmp tbd_mi_out;
      tbd_mi_bad_route:
        mov rax, 0xFFFFF9F9;
        jmp tbd_mi_out;
      tbd_mi_bad_state:
        mov rax, 0xFFFFF9F8;
        jmp tbd_mi_out;
      tbd_mi_no_device:
        mov rax, 0xFFFFF9F7;
        jmp tbd_mi_out;
      tbd_mi_no_key:
        mov rax, 0xFFFFF9F6;
        jmp tbd_mi_out;
      tbd_mi_in_use:
        mov rdi, 2;
        call tb_domain_note;
        mov rax, 0xFFFFF9F4;
        jmp tbd_mi_out;
      tbd_mi_enospc:
        mov rdi, 3;
        call tb_domain_note;
        mov rax, 0xFFFFF9F5;

      tbd_mi_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let tb_domain_cap_mint : (u64, u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (domain_key: u64) (device_slot: u64) (packed_ident: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R35.M2-003 (#1203): audited mint.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;
        mov r13, rsi;

        call tb_domain_cap_mint_inner;
        mov r14, rax;

        mov rdi, 1;
        mov rsi, 0x16C;
        mov rdx, r12;
        mov rcx, r13;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Revoke.
  // ==========================================================================

  pub let tb_domain_cap_revoke_inner : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R35.M2-003 (#1203): revoke KIND_TB_DOMAIN. Labels prefixed tbd_rvk_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;

        mov r10, 256;
        cmp r12, r10;
        jae tbd_rvk_bad_slot;

        mov rax, cap_table;
        mov r8, r12;
        shl r8, 3;
        mov r9, r12;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov rbx, rax;

        mov r10, [rbx + 0];
        cmp r10, 0;
        je  tbd_rvk_already;

        mov r11, 0x16C;
        cmp r10, r11;
        jne tbd_rvk_wrong_kind;

        mov r13, [rbx + 16];
        mov r10, 0xFFFF;
        and r13, r10;

        mov rdi, r13;
        call tb_domain_tail_valid;
        cmp rax, 0;
        je  tbd_rvk_clear;

        mov rdi, r13;
        call tb_domain_tail_free;

      tbd_rvk_clear:
        mov rdi, r12;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        mov rdi, 1;
        call tb_domain_note;

        xor rax, rax;
        jmp tbd_rvk_out;

      tbd_rvk_bad_slot:
        mov rax, 0xFFFFF9F3;
        jmp tbd_rvk_out;
      tbd_rvk_wrong_kind:
        mov rax, 0xFFFFF9F2;
        jmp tbd_rvk_out;
      tbd_rvk_already:
        mov rax, 0xFFFFF9F1;

      tbd_rvk_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let tb_domain_cap_revoke : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R35.M2-003 (#1203): audited revoke.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;

        call tb_domain_cap_revoke_inner;
        mov r14, rax;

        mov rdi, 2;
        mov rsi, 0x16C;
        mov rdx, r12;
        mov rcx, r12;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Dispatch handler.
  // ==========================================================================

  pub let cap_handler_tb_domain : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R35.M2-003 (#1203): KIND_TB_DOMAIN dispatch. Queries INVOKE; DEBUG_PRINT OBSERVE. All ops arity ONE — op_arg[63:8] REFUSED. Labels prefixed tbd_hn_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov r12, rdi;                    // rights
        mov r13, rsi;
        mov r10, 0xFFFF;
        and r13, r10;                    // row_id
        mov r14, rdx;                    // op_arg

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_tb_domain_msg];
        call klog_s1;

        mov r10, r14;
        and r10, 0xFF;
        mov rbp, r10;                    // op
        mov r11, r14;
        shr r11, 8;
        cmp r11, 0;
        jne tbd_hn_res;

        cmp rbp, 7;
        ja  tbd_hn_unsup;

        cmp rbp, 7;
        je  tbd_hn_dbg;

        // Ops 0..6: INVOKE.
        mov r10, r12;
        and r10, 0x008;
        cmp r10, 0;
        je  tbd_hn_denied;

        mov rdi, r13;
        cmp rbp, 0;
        je  tbd_hn_key;
        cmp rbp, 1;
        je  tbd_hn_dev;
        cmp rbp, 2;
        je  tbd_hn_bdf;
        cmp rbp, 3;
        je  tbd_hn_did;
        cmp rbp, 4;
        je  tbd_hn_rt;
        cmp rbp, 5;
        je  tbd_hn_stt;
        call tb_domain_row_parent;
        jmp tbd_hn_out;

      tbd_hn_key:
        call tb_domain_row_key;
        jmp tbd_hn_out;
      tbd_hn_dev:
        call tb_domain_row_device;
        jmp tbd_hn_out;
      tbd_hn_bdf:
        call tb_domain_row_nhi_bdf;
        jmp tbd_hn_out;
      tbd_hn_did:
        call tb_domain_row_domain_id;
        jmp tbd_hn_out;
      tbd_hn_rt:
        call tb_domain_row_route_id;
        jmp tbd_hn_out;
      tbd_hn_stt:
        call tb_domain_row_state;
        jmp tbd_hn_out;

      tbd_hn_dbg:
        mov r10, r12;
        and r10, 0x400;
        cmp r10, 0;
        je  tbd_hn_denied;
        xor rax, rax;
        jmp tbd_hn_out;

      tbd_hn_res:
        mov rax, 0xFFFFF9FE;
        jmp tbd_hn_out;
      tbd_hn_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;
        jmp tbd_hn_out;
      tbd_hn_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;

      tbd_hn_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
