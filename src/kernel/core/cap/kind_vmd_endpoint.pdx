// src/kernel/core/cap/kind_vmd_endpoint.pdx — R47.M1-003 (#1414)
//
// KIND_VMD_ENDPOINT = 0x187, derived over KIND_DEVICE (10).
//
// The authority to hold ONE endpoint sitting behind an Intel VMD
// (Volume Management Device) root aperture — the child NVMe (or
// other-class) device whose real bus/dev/fn number lives in VMD's
// virtual root-complex address space rather than in the platform's
// primary PCI hierarchy.
//
// =============================================================================
// §0  WHY THIS KIND EXISTS
// =============================================================================
//
// R47 lifts the BIOS-off quirk that R22..R46 lived under (see
// design/hardware/quirks.md §2.4).  With VMD ENABLED, an NVMe device is
// NOT reachable through the ordinary R22 pci_enumerate_all walk — the
// VMD controller hides its children behind a per-domain config-space
// aperture.  A ring-3 supervisor (nvme_supervisor, storage_supervisor)
// needs to name ONE such child WITHOUT holding the whole VMD BAR
// window, and without a fresh KIND_DEVICE minted from firmware bytes.
//
// KIND_VMD_ENDPOINT is that named handle.  It records the endpoint's
// identity fields (vmd_slot naming the KIND_DEVICE that IS the VMD
// controller, virtual bus/dev/fn under that controller, the child's
// PCI class code, and an FSM state ordinal) and nothing else — the
// live MMIO reach still requires an explicitly-minted KIND_OP_REGION
// derived from the VMD BAR memory authority.
//
// The KIND half of the derivation gate discriminates NOTHING on its
// own — every PCI function in the machine is a KIND_DEVICE — so the
// mint additionally requires:
//
//   (a) endpoint_key non-zero and unique among live rows (NO_KEY / IN_USE)
//   (b) vmd_slot names a live KIND_DEVICE (BAD_DEVICE)
//   (c) vbdf packed correctly, bus/dev/fn in range (BAD_VBDF)
//   (d) class_code non-zero and fits u24 (BAD_CLASS)
//   (e) state == KVE_STATE_ATTACHED at mint (BAD_STATE)
//   (f) rights subset of R_KVE_ALL (R_MINT ABSENT from the mask)
//
// =============================================================================
// §1  ROW LAYOUT — 32 BYTES EXACTLY
// =============================================================================
//
//   [+0]  header:  in_use[63:56] | parent_slot[15:8]
//   [+8]  endpoint_key (u64)
//   [+16] body1:   vmd_slot[15:0] | vbdf[31:16] | class_code[55:32] | state[63:56]
//   [+24] body2:   reserved (all zero)
//
// state advances through kve_row_transition; every other identity
// field is FROZEN at mint.
//
// =============================================================================
// §2  FAILURE TAXONOMY 0xFFFFFBF0..0xFFFFFBFF
// =============================================================================

module KindVmdEndpoint = structure {

  pub let KIND_VMD_ENDPOINT : u64 = 0x187
  pub let KVE_PARENT_KIND   : u64 = 10          // = KIND_DEVICE

  // FSM state ordinals (endpoint lifecycle).
  pub let KVE_STATE_ATTACHED : u64 = 0          // newly enumerated child
  pub let KVE_STATE_ACTIVE   : u64 = 1          // driver bound
  pub let KVE_STATE_QUIESCED : u64 = 2          // suspended
  pub let KVE_STATE_DETACHED : u64 = 3          // hot-unplug pending
  pub let KVE_STATE_MAX      : u64 = 3

  // Rights.  R_MINT (0x200) NOT in the mask.
  pub let R_KVE_READ    : u64 = 0x001
  pub let R_KVE_INVOKE  : u64 = 0x008
  pub let R_KVE_REVOKE  : u64 = 0x010
  pub let R_KVE_OBSERVE : u64 = 0x400
  pub let R_KVE_ALL     : u64 = 0x419

  // Ops.
  pub let KVE_OP_QUERY_KEY    : u64 = 0
  pub let KVE_OP_QUERY_VMD    : u64 = 1
  pub let KVE_OP_QUERY_VBDF   : u64 = 2
  pub let KVE_OP_QUERY_CLASS  : u64 = 3
  pub let KVE_OP_QUERY_STATE  : u64 = 4
  pub let KVE_OP_MAX          : u64 = 4

  // Failure taxonomy — 0xFFFFFBF0..0xFFFFFBFF.
  pub let KVE_OK              : u64 = 0
  pub let KVE_TAIL_ENOSPC     : u64 = 0xFFFFFBFF
  pub let KVE_TAIL_BAD_ARG    : u64 = 0xFFFFFBFE
  pub let KVE_MINT_BAD_PARENT : u64 = 0xFFFFFBFD
  pub let KVE_MINT_BAD_RIGHTS : u64 = 0xFFFFFBFC
  pub let KVE_MINT_BAD_DEVICE : u64 = 0xFFFFFBFB
  pub let KVE_MINT_BAD_VBDF   : u64 = 0xFFFFFBFA
  pub let KVE_MINT_BAD_CLASS  : u64 = 0xFFFFFBF9
  pub let KVE_MINT_BAD_STATE  : u64 = 0xFFFFFBF8
  pub let KVE_MINT_NO_KEY     : u64 = 0xFFFFFBF7
  pub let KVE_MINT_ENOSPC     : u64 = 0xFFFFFBF6
  pub let KVE_MINT_IN_USE     : u64 = 0xFFFFFBF5
  pub let KVE_BAD_SLOT        : u64 = 0xFFFFFBF4
  pub let KVE_WRONG_KIND      : u64 = 0xFFFFFBF3
  pub let KVE_REVOKE_ALREADY  : u64 = 0xFFFFFBF2
  pub let KVE_BAD_TRANSITION  : u64 = 0xFFFFFBF1

  pub let KVE_ROW_NONE : u64 = 0xFF
  pub let KVE_MAX      : u64 = 8

  pub let mut _vmd_endpoint_table : [u64; 32] = uninit @align(64)
  pub let mut _vmd_endpoint_stats : [u64; 4]  = uninit @align(64)

  pub let KVE_ST_MINTS       : u64 = 0
  pub let KVE_ST_REVOKES     : u64 = 1
  pub let KVE_ST_TRANSITIONS : u64 = 2
  pub let KVE_ST_REFUSED     : u64 = 3

  pub let kve_dbg_msg : [u8; 16] = "VMD ENDPOINT ROW"

  // ==========================================================================
  // Table reset.
  // ==========================================================================

  pub let vmd_endpoint_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R47.M1-003 (#1414): clear KIND_VMD_ENDPOINT row table + counters. Boot and teardown only. Labels prefixed kve_rs_.",
      block: {
        lea r10, [rip + _vmd_endpoint_table];
        xor rax, rax;
        xor rcx, rcx;
      kve_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  kve_rs_rows;

        lea r10, [rip + _vmd_endpoint_stats];
        xor rcx, rcx;
      kve_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  kve_rs_stats;
        ret
      }
    }

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let kve_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R47.M1-003 (#1414): subset of R_KVE_ALL = 0x419. R_MINT OUTSIDE the mask. Labels prefixed kve_rv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x419;
        and rax, r10;
        cmp rax, rdi;
        jne kve_rv_no;
        mov rax, 1;
        ret;
      kve_rv_no:
        xor rax, rax;
        ret
      }
    }

  pub let kve_state_valid : (u64) -> u64 !{} @{} =
    fn (s: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R47.M1-003 (#1414): 1 iff s <= STATE_MAX (3). Labels prefixed kve_sv_.",
      block: {
        cmp rdi, 3;
        ja  kve_sv_no;
        mov rax, 1;
        ret;
      kve_sv_no:
        xor rax, rax;
        ret
      }
    }

  pub let kve_class_valid : (u64) -> u64 !{} @{} =
    fn (c: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R47.M1-003 (#1414): 1 iff c non-zero and fits 24 bits (PCI class:subclass:progif triple). Labels prefixed kve_cv_.",
      block: {
        cmp rdi, 0;
        je  kve_cv_no;
        mov r10, 0xFFFFFF;
        cmp rdi, r10;
        ja  kve_cv_no;
        mov rax, 1;
        ret;
      kve_cv_no:
        xor rax, rax;
        ret
      }
    }

  // vbdf pack: bus[15:8] | dev[7:3] | fn[2:0]. Bus 0..255, dev 0..31, fn 0..7.
  pub let kve_vbdf_valid : (u64) -> u64 !{} @{} =
    fn (vbdf: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R47.M1-003 (#1414): 1 iff vbdf fits 16 bits, dev in 0..31, fn in 0..7. Labels prefixed kve_vv_.",
      block: {
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  kve_vv_no;
        mov rax, 1;
        ret;
      kve_vv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Counters.
  // ==========================================================================

  pub let kve_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R47.M1-003 (#1414): counter bump. Labels prefixed kve_nt_.",
      block: {
        cmp rdi, 4;
        jae kve_nt_out;
        lea r10, [rip + _vmd_endpoint_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      kve_nt_out:
        ret
      }
    }

  pub let kve_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R47.M1-003 (#1414): counter read.",
      block: {
        cmp rdi, 4;
        jae kve_stt_zero;
        lea r10, [rip + _vmd_endpoint_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      kve_stt_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Parent gate: live KIND_DEVICE (10) with RIGHT_MINT.
  // ==========================================================================

  pub let kve_check_parent : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R47.M1-003 (#1414): parent must be live KIND_DEVICE (10) with RIGHT_MINT. Labels prefixed kve_cp_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae kve_cp_no;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 10;
        jne kve_cp_no;

        mov r10, [rax + 8];
        mov r11, 0x200;
        and r10, r11;
        cmp r10, 0;
        je  kve_cp_no;

        mov rax, 1;
        ret;
      kve_cp_no:
        xor rax, rax;
        ret
      }
    }

  pub let kve_check_device : (u64) -> u64 !{mem} @{cap} =
    fn (device_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R47.M1-003 (#1414): device_slot must name a live KIND_DEVICE. Labels prefixed kve_cd_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae kve_cd_no;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 10;
        jne kve_cd_no;

        mov rax, 1;
        ret;
      kve_cd_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Header + body packers.
  // ==========================================================================

  pub let kve_hdr_pack : (u64) -> u64 !{} @{} =
    fn (parent_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R47.M1-003 (#1414): (parent_slot << 8). Labels prefixed kve_hp_.",
      block: {
        mov r10, 256;
        cmp rdi, r10;
        jae kve_hp_bad;
        mov rax, rdi;
        shl rax, 8;
        ret;
      kve_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let kve_body1_pack : (u64, u64, u64, u64) -> u64 !{} @{} =
    fn (vmd_slot: u64) (vbdf: u64) (class_code: u64) (state: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R47.M1-003 (#1414): pack vmd_slot[15:0] | vbdf[31:16] | class[55:32] | state[63:56]. Labels prefixed kve_b1_.",
      block: {
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  kve_b1_bad;
        cmp rsi, r10;
        ja  kve_b1_bad;
        mov r10, 0xFFFFFF;
        cmp rdx, r10;
        ja  kve_b1_bad;
        cmp rcx, 3;
        ja  kve_b1_bad;

        mov rax, rdi;
        and rax, 0xFFFF;
        mov r10, rsi;
        and r10, 0xFFFF;
        shl r10, 16;
        or  rax, r10;
        mov r10, rdx;
        and r10, 0xFFFFFF;
        shl r10, 32;
        or  rax, r10;
        mov r10, rcx;
        and r10, 0xFF;
        shl r10, 56;
        or  rax, r10;
        ret;
      kve_b1_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // Tail alloc / valid / free — THE ONE WRITER of _vmd_endpoint_table.
  // ==========================================================================

  pub let kve_tail_alloc : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (endpoint_key: u64) (body1: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R47.M1-003 (#1414): claim one VMD ENDPOINT row. THE ONE WRITER. Labels prefixed kve_ta_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;

        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne kve_ta_bad;

        cmp r13, 0;
        je  kve_ta_bad;

        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp r14, r10;
        je  kve_ta_bad;

        xor rbx, rbx;
      kve_ta_scan:
        cmp rbx, 8;
        jae kve_ta_enospc;

        lea r10, [rip + _vmd_endpoint_table];
        mov r11, rbx;
        shl r11, 5;
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  kve_ta_claim;

        add rbx, 1;
        jmp kve_ta_scan;

      kve_ta_claim:
        mov rax, r12;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r13;
        mov [r10 + 16], r14;
        xor rax, rax;
        mov [r10 + 24], rax;
        mov rax, rbx;
        jmp kve_ta_out;

      kve_ta_enospc:
        mov rax, 0xFFFFFBFF;
        jmp kve_ta_out;
      kve_ta_bad:
        mov rax, 0xFFFFFBFE;

      kve_ta_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let kve_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R47.M1-003 (#1414): 1 iff row_id<MAX and in_use. Labels prefixed kve_tvr_.",
      block: {
        cmp rdi, 8;
        jae kve_tvr_no;
        lea r10, [rip + _vmd_endpoint_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  kve_tvr_no;
        mov rax, 1;
        ret;
      kve_tvr_no:
        xor rax, rax;
        ret
      }
    }

  pub let kve_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R47.M1-003 (#1414): scrub one row. Labels prefixed kve_tf_.",
      block: {
        cmp rdi, 8;
        jae kve_tf_out;
        lea r10, [rip + _vmd_endpoint_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
      kve_tf_out:
        ret
      }
    }

  // ==========================================================================
  // Row accessors.
  // ==========================================================================

  pub let kve_row_key : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R47.M1-003 (#1414): endpoint_key. Labels prefixed kve_rk_.",
      block: {
        push r12;
        mov r12, rdi;
        call kve_tail_valid;
        cmp rax, 0;
        je  kve_rk_bad;
        lea r10, [rip + _vmd_endpoint_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 8];
        jmp kve_rk_out;
      kve_rk_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      kve_rk_out:
        pop r12;
        ret
      }
    }

  pub let kve_row_vmd : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R47.M1-003 (#1414): vmd_slot. Labels prefixed kve_rvm_.",
      block: {
        push r12;
        mov r12, rdi;
        call kve_tail_valid;
        cmp rax, 0;
        je  kve_rvm_bad;
        lea r10, [rip + _vmd_endpoint_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        and rax, 0xFFFF;
        jmp kve_rvm_out;
      kve_rvm_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      kve_rvm_out:
        pop r12;
        ret
      }
    }

  pub let kve_row_vbdf : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R47.M1-003 (#1414): vbdf. Labels prefixed kve_rvb_.",
      block: {
        push r12;
        mov r12, rdi;
        call kve_tail_valid;
        cmp rax, 0;
        je  kve_rvb_bad;
        lea r10, [rip + _vmd_endpoint_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 16;
        and rax, 0xFFFF;
        jmp kve_rvb_out;
      kve_rvb_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      kve_rvb_out:
        pop r12;
        ret
      }
    }

  pub let kve_row_class : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R47.M1-003 (#1414): class_code. Labels prefixed kve_rcc_.",
      block: {
        push r12;
        mov r12, rdi;
        call kve_tail_valid;
        cmp rax, 0;
        je  kve_rcc_bad;
        lea r10, [rip + _vmd_endpoint_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 32;
        and rax, 0xFFFFFF;
        jmp kve_rcc_out;
      kve_rcc_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      kve_rcc_out:
        pop r12;
        ret
      }
    }

  pub let kve_row_state : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R47.M1-003 (#1414): state. Labels prefixed kve_rst_.",
      block: {
        push r12;
        mov r12, rdi;
        call kve_tail_valid;
        cmp rax, 0;
        je  kve_rst_bad;
        lea r10, [rip + _vmd_endpoint_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 56;
        and rax, 0xFF;
        jmp kve_rst_out;
      kve_rst_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      kve_rst_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // kve_row_transition — the ONE MUTATOR of state.
  // Legal edges: ATTACHED->ACTIVE, ACTIVE->QUIESCED, QUIESCED->ACTIVE,
  //              any -> DETACHED, DETACHED -> ATTACHED (re-plug).
  // ==========================================================================

  pub let kve_row_transition : (u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64) (new_state: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R47.M1-003 (#1414): mutate state field. Labels prefixed kve_rt_.",
      block: {
        push r12;
        push r13;

        mov r12, rdi;
        mov r13, rsi;

        mov rdi, r12;
        call kve_tail_valid;
        cmp rax, 0;
        je  kve_rt_bad;

        mov rdi, r13;
        call kve_state_valid;
        cmp rax, 0;
        je  kve_rt_bad;

        lea r10, [rip + _vmd_endpoint_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 56;
        and rax, 0xFF;

        // any -> DETACHED (3) is legal (hot-unplug).
        cmp r13, 3;
        je  kve_rt_apply;
        // DETACHED (3) -> ATTACHED (0) is legal (re-plug).
        cmp rax, 3;
        je  kve_rt_from3;
        // ATTACHED (0) -> ACTIVE (1).
        cmp rax, 0;
        je  kve_rt_from0;
        // ACTIVE (1) -> QUIESCED (2) or -> ACTIVE (idempotent no-op).
        cmp rax, 1;
        je  kve_rt_from1;
        // QUIESCED (2) -> ACTIVE (1).
        cmp rax, 2;
        je  kve_rt_from2;
        jmp kve_rt_bad;

      kve_rt_from0:
        cmp r13, 1;
        je  kve_rt_apply;
        jmp kve_rt_bad;
      kve_rt_from1:
        cmp r13, 2;
        je  kve_rt_apply;
        jmp kve_rt_bad;
      kve_rt_from2:
        cmp r13, 1;
        je  kve_rt_apply;
        jmp kve_rt_bad;
      kve_rt_from3:
        cmp r13, 0;
        je  kve_rt_apply;
        jmp kve_rt_bad;

      kve_rt_apply:
        mov rax, [r10 + 16];
        mov r11, 0xFF;
        shl r11, 56;
        not r11;
        and rax, r11;
        mov r11, r13;
        and r11, 0xFF;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 16], rax;

        mov rdi, 2;
        call kve_note;
        xor rax, rax;
        jmp kve_rt_out;

      kve_rt_bad:
        mov rax, 0xFFFFFBF1;

      kve_rt_out:
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Lookups.
  // ==========================================================================

  pub let kve_find_by_key : (u64) -> u64 !{mem} @{} =
    fn (endpoint_key: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R47.M1-003 (#1414): live row holding endpoint_key, or ROW_NONE. Refuses to match 0. Labels prefixed kve_fk_.",
      block: {
        cmp rdi, 0;
        je  kve_fk_none;
        xor rcx, rcx;
      kve_fk_scan:
        cmp rcx, 8;
        jae kve_fk_none;
        lea r10, [rip + _vmd_endpoint_table];
        mov r11, rcx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  kve_fk_next;
        mov rax, [r10 + 8];
        cmp rax, rdi;
        je  kve_fk_hit;
      kve_fk_next:
        add rcx, 1;
        jmp kve_fk_scan;
      kve_fk_hit:
        mov rax, rcx;
        ret;
      kve_fk_none:
        mov rax, 0xFF;
        ret
      }
    }

  pub let kve_row_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R47.M1-003 (#1414): slot -> row_id, gated on live KIND_VMD_ENDPOINT. Labels prefixed kve_ros_.",
      block: {
        push r12;

        mov r11, 256;
        cmp rdi, r11;
        jae kve_ros_none;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x187;
        cmp r10, r11;
        jne kve_ros_none;

        mov r12, [rax + 16];
        mov r10, 0xFFFF;
        and r12, r10;

        mov rdi, r12;
        call kve_tail_valid;
        cmp rax, 0;
        je  kve_ros_none;

        mov rax, r12;
        jmp kve_ros_out;

      kve_ros_none:
        mov rax, 0xFF;
      kve_ros_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Mint.  packed_cfg encoding:
  //   [15:0]   vmd_slot (KIND_DEVICE naming the VMD controller)
  //   [31:16]  vbdf (virtual bus:dev:fn under VMD)
  //   [55:32]  class_code (24-bit PCI class:subclass:progif)
  //   [63:56]  state (must be 0 = ATTACHED at mint)
  // ==========================================================================

  pub let vmd_endpoint_cap_mint_inner : (u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (endpoint_key: u64) (packed_cfg: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R47.M1-003 (#1414): mint KIND_VMD_ENDPOINT over KIND_DEVICE. Labels prefixed kve_mi_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov rbx, rdi;                    // slot
        mov r12, rsi;                    // parent_slot
        mov r13, rdx;                    // rights
        mov r14, rcx;                    // endpoint_key
        mov rbp, r8;                     // packed_cfg

        mov r10, 256;
        cmp rbx, r10;
        jae kve_mi_bad_slot;

        mov rdi, r12;
        call kve_check_parent;
        cmp rax, 0;
        je  kve_mi_bad_parent;

        mov rdi, r13;
        call kve_rights_valid;
        cmp rax, 0;
        je  kve_mi_bad_rights;

        // vmd_slot check
        mov r10, rbp;
        and r10, 0xFFFF;
        mov r15, r10;                    // vmd_slot -> r15
        mov rdi, r15;
        call kve_check_device;
        cmp rax, 0;
        je  kve_mi_bad_device;

        // vbdf check
        mov r10, rbp;
        shr r10, 16;
        and r10, 0xFFFF;
        mov rdi, r10;
        call kve_vbdf_valid;
        cmp rax, 0;
        je  kve_mi_bad_vbdf;

        // class check
        mov r10, rbp;
        shr r10, 32;
        and r10, 0xFFFFFF;
        mov rdi, r10;
        call kve_class_valid;
        cmp rax, 0;
        je  kve_mi_bad_class;

        // state must be 0 (ATTACHED) at mint.
        mov r10, rbp;
        shr r10, 56;
        and r10, 0xFF;
        cmp r10, 0;
        jne kve_mi_bad_state;

        cmp r14, 0;
        je  kve_mi_no_key;

        mov rdi, r14;
        call kve_find_by_key;
        cmp rax, 0xFF;
        jne kve_mi_in_use;

        // Pack body1.
        mov rdi, r15;                    // vmd_slot
        mov rsi, rbp;
        shr rsi, 16;
        and rsi, 0xFFFF;
        mov rdx, rbp;
        shr rdx, 32;
        and rdx, 0xFFFFFF;
        mov rcx, 0;                      // state = ATTACHED
        call kve_body1_pack;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  kve_mi_bad_state;
        push rax;                        // body1

        // Header.
        mov rdi, r12;
        call kve_hdr_pack;
        pop r15;                         // body1
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  kve_mi_bad_parent;

        // tail_alloc(hdr, endpoint_key, body1).
        mov rdi, rax;
        mov rsi, r14;
        mov rdx, r15;
        call kve_tail_alloc;

        mov r10, 0xFFFFFBFF;
        cmp rax, r10;
        je  kve_mi_enospc;
        mov r10, 0xFFFFFBFE;
        cmp rax, r10;
        je  kve_mi_bad_arg;

        mov r15, rax;                    // row_id
        mov r11, rbx;
        shl r11, 16;
        or  r15, r11;

        mov rdi, rbx;
        mov rsi, 0x187;
        mov rdx, r13;
        mov rcx, r15;
        call cap_mint_write;

        mov rdi, 0;
        call kve_note;

        xor rax, rax;
        jmp kve_mi_out;

      kve_mi_bad_slot:
        mov rax, 0xFFFFFBF4;
        jmp kve_mi_out;
      kve_mi_bad_parent:
        mov rax, 0xFFFFFBFD;
        jmp kve_mi_out;
      kve_mi_bad_rights:
        mov rax, 0xFFFFFBFC;
        jmp kve_mi_out;
      kve_mi_bad_device:
        mov rax, 0xFFFFFBFB;
        jmp kve_mi_out;
      kve_mi_bad_vbdf:
        mov rax, 0xFFFFFBFA;
        jmp kve_mi_out;
      kve_mi_bad_class:
        mov rax, 0xFFFFFBF9;
        jmp kve_mi_out;
      kve_mi_bad_state:
        mov rax, 0xFFFFFBF8;
        jmp kve_mi_out;
      kve_mi_no_key:
        mov rax, 0xFFFFFBF7;
        jmp kve_mi_out;
      kve_mi_in_use:
        mov rdi, 3;
        call kve_note;
        mov rax, 0xFFFFFBF5;
        jmp kve_mi_out;
      kve_mi_enospc:
        mov rdi, 3;
        call kve_note;
        mov rax, 0xFFFFFBF6;
        jmp kve_mi_out;
      kve_mi_bad_arg:
        mov rax, 0xFFFFFBFE;

      kve_mi_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Revoke.
  // ==========================================================================

  pub let vmd_endpoint_cap_revoke_inner : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R47.M1-003 (#1414): revoke KIND_VMD_ENDPOINT. Labels prefixed kve_rvk_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rdi;

        mov r10, 256;
        cmp r12, r10;
        jae kve_rvk_bad_slot;

        mov rax, cap_table;
        mov r8, r12;
        shl r8, 3;
        mov r9, r12;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov rbx, rax;

        mov r10, [rbx + 0];
        cmp r10, 0;
        je  kve_rvk_already;

        mov r11, 0x187;
        cmp r10, r11;
        jne kve_rvk_wrong_kind;

        mov r13, [rbx + 16];
        mov r10, 0xFFFF;
        and r13, r10;

        mov rdi, r13;
        call kve_tail_valid;
        cmp rax, 0;
        je  kve_rvk_clear;

        mov rdi, r13;
        call kve_tail_free;

      kve_rvk_clear:
        mov rdi, r12;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        mov rdi, 1;
        call kve_note;

        xor rax, rax;
        jmp kve_rvk_out;

      kve_rvk_bad_slot:
        mov rax, 0xFFFFFBF4;
        jmp kve_rvk_out;
      kve_rvk_wrong_kind:
        mov rax, 0xFFFFFBF3;
        jmp kve_rvk_out;
      kve_rvk_already:
        mov rax, 0xFFFFFBF2;

      kve_rvk_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Dispatch handler.  Queries only.
  // ==========================================================================

  pub let cap_handler_vmd_endpoint : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R47.M1-003 (#1414): KIND_VMD_ENDPOINT dispatch. All ops arity ONE -- op_arg[63:8] REFUSED. Labels prefixed kve_hn_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push rbp;

        mov r12, rdi;
        mov r13, rsi;
        mov r10, 0xFFFF;
        and r13, r10;
        mov r14, rdx;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_vmd_endpoint_msg];
        call klog_s1;

        mov r10, r14;
        and r10, 0xFF;
        mov rbp, r10;
        mov r11, r14;
        shr r11, 8;
        cmp r11, 0;
        jne kve_hn_res;

        cmp rbp, 4;
        ja  kve_hn_unsup;

        // All ops require INVOKE.
        mov r10, r12;
        and r10, 0x008;
        cmp r10, 0;
        je  kve_hn_denied;

        mov rdi, r13;
        cmp rbp, 0;
        je  kve_hn_key;
        cmp rbp, 1;
        je  kve_hn_vmd;
        cmp rbp, 2;
        je  kve_hn_vbdf;
        cmp rbp, 3;
        je  kve_hn_class;
        call kve_row_state;
        jmp kve_hn_out;

      kve_hn_key:
        call kve_row_key;
        jmp kve_hn_out;
      kve_hn_vmd:
        call kve_row_vmd;
        jmp kve_hn_out;
      kve_hn_vbdf:
        call kve_row_vbdf;
        jmp kve_hn_out;
      kve_hn_class:
        call kve_row_class;
        jmp kve_hn_out;

      kve_hn_res:
        mov rax, 0xFFFFFBFE;
        jmp kve_hn_out;
      kve_hn_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;
        jmp kve_hn_out;
      kve_hn_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;

      kve_hn_out:
        pop rbp;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
