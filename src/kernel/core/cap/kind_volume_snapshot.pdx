// src/kernel/core/cap/kind_volume_snapshot.pdx -- R90-XREPO.LV11.M3-001 (paideia-os #2223)
//
// KIND_VOLUME_SNAPSHOT = 0x1B3, derived over KIND_VOLUME (= 0x1A0).
//
// Kernel-side landing of the KIND_VOLUME_SNAPSHOT capability that the
// libpdx-volume v1.1.0 vol_snapshot.pdx client stubs cross-repo
// reference (LV.M3-001 filed as paideia-os/paideia-os#2223). Row
// substrate + mint gate + row accessors + narrow body + cap_invoke
// dispatch handler all in one file (kind_schema_handle.pdx compact
// posture), because the op surface is small (three ops all gated on
// R_SNAP_READ / R_SNAP_CREATE_CHILD / R_SNAP_DELETE).
//
// =============================================================================
// SECTION 0  ORDINAL CHOICE  --  0x1B3
// =============================================================================
//
// R101 GUI plan (design/graphics/r101-kernel-plan.md §5) previously
// reserved 0x1AE / 0x1AF / 0x1B0 / 0x1B1 for the display substrate;
// R90-XREPO.012.M3-001 (#2126) then claimed 0x1B2 for KIND_SCHEMA_
// HANDLE at the base of the "reserved for G7+" band. This landing
// takes the very next slot at 0x1B3, with sibling KIND_KEK (this
// wave's second landing, #2224) at 0x1B4. Both sit in the same
// 0x1B2..0x1BF strip explicitly named as available by the R101 tail
// summary.
//
// =============================================================================
// SECTION 1  WHY DERIVED OVER KIND_VOLUME
// =============================================================================
//
// A snapshot is not a fresh KIND_MEMORY consumer: it is a refinement
// of the volume it snapshots. The derivation gate is therefore
// parent.kind == KIND_VOLUME (0x1A0) AND rights carry RIGHT_MINT
// (0x200) -- the same "cannot widen reach beyond what you already
// hold" rule KIND_PDXFS_FILE / KIND_VOLUME themselves use, with the
// base kind narrowed to the volume the snapshot belongs to. There is
// no cap-invoke op that reaches kind_volume_snapshot_mint_body: the
// mint is a kernel-trusted primitive callable from sys_pdxfs_snap_
// create (future landing, see the LV.M3-001 issue's own §Desired
// end-state) or from a boot witness.
//
// The KVS_OP_CREATE op the dispatch handler exposes does NOT mint a
// fresh snapshot cap -- it is the child-of-snapshot creation gate,
// consuming R_SNAP_CREATE_CHILD from the parent snapshot cap to
// derive a new snapshot row that chains from this one (see the
// parent_snap_id field at row +40, populated at mint time by whichever
// caller passes a non-zero parent).
//
// =============================================================================
// SECTION 2  TAIL ENCODING
// =============================================================================
//
// Row layout (48 bytes, six u64 words):
//
//   [+0]  header      (u64):  in_use[63:56] | kind_tag[55:0]
//                             kind_tag mirrors KIND_VOLUME_SNAPSHOT for a
//                             defensive tag-in-row assertion at revoke
//                             time; low 56 bits, so kind_tag <= 0x1B3
//                             fits without overlap with the top-byte
//                             in_use marker.
//   [+8]  volume_slot (u64):  the parent KIND_VOLUME cap slot the
//                             snapshot is of; caller passes this at
//                             mint and it is loaded back by every
//                             query op to name the target volume.
//   [+16] ids32       (u64):  snap_id[31:0] | snap_seq[63:32]
//                             snap_id  -- monotonic snapshot id
//                                         assigned by the kernel from
//                                         _kvs_next_snap_id (starts
//                                         at 1, never reused).
//                             snap_seq -- per-volume sequence number
//                                         (starts at 1 for the first
//                                         snapshot of a volume; caller
//                                         supplies this at mint).
//   [+24] created_tsc (u64):  TSC snapshot at mint (rdtsc), for
//                             fingerprint correlation with the UEJ.
//   [+32] flags_ref   (u64):  refcount[31:0] | flags[63:32]
//                             refcount -- initialised 1 at mint,
//                                         bumped by KVS_OP_CREATE,
//                                         decremented on revoke.
//                             flags    -- bit 0 = READ_ONLY,
//                                         bit 1 = FROZEN, others
//                                         reserved (must be zero).
//   [+40] parent_res  (u64):  parent_snap_id[31:0] | reserved[63:32]
//                             parent_snap_id -- 0 for a base snapshot
//                                              (no parent); otherwise
//                                              the snap_id of the
//                                              snapshot this one
//                                              refines (incremental
//                                              chain).
//                             reserved      -- must be zero at mint.
//
// The refcount / flags / snap_id / snap_seq / parent_snap_id fields
// are 32-bit sub-fields packed into three u64 slots so the total row
// size stays exactly 48 bytes, matching the client-side wire size
// libpdx-volume vol_snapshot.pdx expects (checked against
// design/kernel/kind-volume-snapshot.md at the LV.M4 doc landing;
// today the field-by-field spec is the LV.M3-001 issue body plus
// this file's SECTION 2).
//
// Row-addressed capacity: KVS_MAX = 64 rows. 64 * 48 = 3072 bytes = 384
// u64 words. Sixty-four outstanding snapshots is one order above the
// current design ceiling of "eight snapshots per volume, up to eight
// volumes" (libpdx-volume vol_snapshot.pdx §3), leaving headroom for
// the incremental-chain child-of-child case.
//
// =============================================================================
// SECTION 3  RIGHTS
// =============================================================================
//
//   R_SNAP_READ         (0x001)  -- KVS_OP_QUERY: metadata retrieval.
//   R_SNAP_CREATE_CHILD (0x002)  -- KVS_OP_CREATE: derive a child snap.
//   R_SNAP_DELETE       (0x004)  -- future revoke path (not consumed
//                                    by any op at this landing).
//   R_KVS_ALL           (0x007)  -- subset test in kvs_rights_valid.
//
// =============================================================================
// SECTION 4  FAILURE TAXONOMY  --  0xFFFFEB40..0xFFFFEB4F
// =============================================================================
//
// The 0xFFFFEB40..0xFFFFEB4F page was verified free by grep at
// landing time -- kind_schema_handle.pdx §4 owns 0xFFFFEB30..0xFFFFEB
// 39; kind_tui_canvas.pdx §"failure taxonomy" owns 0xFFFFEB10..0xFF
// FFEB1F; kind_sig_key.pdx §3 owns 0xFFFFEB00..0xFFFFEB0F. The band
// 0xFFFFEB20..0xFFFFEB2F is unclaimed but left as headroom for a
// future kind's own landing; this file skips ahead to 0xFFFFEB40 so
// KIND_KEK's sibling landing (#2224, this same wave) can adopt the
// 0xFFFFEB50..0xFFFFEB5F band contiguously.
//
//   KVS_MINT_BAD_PARENT  0xFFFFEB40  -- parent not KIND_VOLUME
//   KVS_MINT_BAD_RIGHTS  0xFFFFEB41  -- rights not subset of R_KVS_ALL
//   KVS_MINT_BAD_ARG     0xFFFFEB42  -- snap_seq/flags/parent invalid
//   KVS_TAIL_ENOSPC      0xFFFFEB43  -- 64-row pool full
//   KVS_BAD_SLOT         0xFFFFEB44  -- op_arg row_id OOR or free
//   KVS_BAD_RIGHTS       0xFFFFEB45  -- op invoked without required right
//   KVS_TAIL_BAD_ARG     0xFFFFEB46  -- op_arg[63:8] non-zero
//
// =============================================================================
// SECTION 5  ENCODER DISCIPLINE
// =============================================================================
//
// Kind-tag 0x1B3 does not sign-extend cleanly from a 32-bit
// immediate, so every compare stages through r11 first (same posture
// as kind_schema_handle.pdx §5). Row stride is 48 bytes -- not a power
// of two -- so `idx * 48` composes as `idx*32 + idx*16` via two shifts
// and an add (32 = shl 5, 16 = shl 4), matching kind_volume.pdx's
// `shl 6` idiom shape but split across two registers. No `add reg,
// [mem]`, no `mov_bzx` / `mov_wzx`, no `test`. Labels prefixed
// `kvs_` (kind-volume-snapshot) or `kvs_hn_` (handler).

module KindVolumeSnapshot = structure {

  pub let KIND_VOLUME_SNAPSHOT      : u64 = 0x1B3
  pub let KIND_VOLUME_SNAPSHOT_BASE : u64 = 0x1A0        // = KIND_VOLUME

  // Rights (§3).
  pub let R_SNAP_READ         : u64 = 0x001
  pub let R_SNAP_CREATE_CHILD : u64 = 0x002
  pub let R_SNAP_DELETE       : u64 = 0x004
  pub let R_KVS_ALL           : u64 = 0x007

  // Ops (op_arg[7:0]; op_arg[63:8] MUST be zero).
  pub let KVS_OP_CREATE : u64 = 0
  pub let KVS_OP_NARROW : u64 = 1
  pub let KVS_OP_QUERY  : u64 = 2
  pub let KVS_OP_MAX    : u64 = 2

  // Failure taxonomy (§4).
  pub let KVS_OK               : u64 = 0
  pub let KVS_MINT_BAD_PARENT  : u64 = 0xFFFFEB40
  pub let KVS_MINT_BAD_RIGHTS  : u64 = 0xFFFFEB41
  pub let KVS_MINT_BAD_ARG     : u64 = 0xFFFFEB42
  pub let KVS_TAIL_ENOSPC      : u64 = 0xFFFFEB43
  pub let KVS_BAD_SLOT         : u64 = 0xFFFFEB44
  pub let KVS_BAD_RIGHTS       : u64 = 0xFFFFEB45
  pub let KVS_TAIL_BAD_ARG     : u64 = 0xFFFFEB46

  pub let KVS_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let KVS_ROW_NONE   : u64 = 0xFF

  // Ceilings.
  pub let KVS_MAX       : u64 = 64
  pub let KVS_ROW_BYTES : u64 = 48

  // 64 rows * 48 bytes = 3072 bytes = 384 u64. Sole writer of every
  // row of _kvs_table is kvs_row_alloc (§Row pool) below; tools/build.
  // sh confinement pattern mirrors kind_volume.pdx's _volume_table.
  pub let mut _kvs_table         : [u64; 384] = uninit @align(64)
  pub let mut _kvs_stats         : [u64; 8]   = uninit @align(64)
  pub let mut _kvs_next_snap_id  : u64        = uninit @align(8)

  // Stat slots.
  pub let KVS_ST_MINTS      : u64 = 0
  pub let KVS_ST_NARROWS    : u64 = 1
  pub let KVS_ST_QUERIES    : u64 = 2
  pub let KVS_ST_CREATES    : u64 = 3
  pub let KVS_ST_REFUSED    : u64 = 4
  pub let KVS_ST_MAX        : u64 = 8

  // ==========================================================================
  // kind_volume_snapshot_init() -> ()
  //
  // Boot / teardown scrub of the row pool, counter table and the
  // monotonic snap-id counter. .bss already starts zero at real boot;
  // defensive, matches kind_schema_handle.pdx ksh_table_reset shape
  // one-for-one with an extra clear for _kvs_next_snap_id.
  // ==========================================================================

  pub let kind_volume_snapshot_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R90-XREPO.LV11.M3-001 (paideia-os #2223): clear _kvs_table (384 u64 = 3072 bytes), _kvs_stats (8 u64) and _kvs_next_snap_id (1 u64). Three separate straight-line loops (the two tables + a single store for the id counter), mirrors kind_schema_handle.pdx ksh_table_reset. Labels prefixed kvs_rs_.",
      block: {
        lea r10, [rip + _kvs_table];
        xor rax, rax;
        xor rcx, rcx;
      kvs_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 384;
        jb  kvs_rs_rows;

        lea r10, [rip + _kvs_stats];
        xor rcx, rcx;
      kvs_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  kvs_rs_stats;

        lea r10, [rip + _kvs_next_snap_id];
        mov [r10 + 0], rax;
        ret
      }
    }

  pub let kvs_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R90-XREPO.LV11.M3-001 (paideia-os #2223): bounded increment on _kvs_stats. Load-inc-store idiom (no `add reg, [mem]`). Labels prefixed kvs_nt_.",
      block: {
        cmp rdi, 8;
        jae kvs_nt_out;
        lea r10, [rip + _kvs_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      kvs_nt_out:
        ret
      }
    }

  // ==========================================================================
  // Validators.
  // ==========================================================================

  // kvs_rights_valid(rights) -> 1 iff subset of R_KVS_ALL (0x007).
  pub let kvs_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R90-XREPO.LV11.M3-001 (paideia-os #2223): subset test against R_KVS_ALL = 0x007. Labels prefixed kvs_rv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x007;                  // R_KVS_ALL
        and rax, r10;
        cmp rax, rdi;
        jne kvs_rv_no;
        mov rax, 1;
        ret;
      kvs_rv_no:
        xor rax, rax;
        ret
      }
    }

  // kvs_check_parent_volume(parent_slot) -> 1 iff cap_table[parent_slot]
  // .kind == KIND_VOLUME (0x1A0) AND rights carry RIGHT_MINT (0x200).
  // Mirrors ksh_check_parent_memory one-for-one with the parent kind
  // widened from KIND_MEMORY (4) to KIND_VOLUME (0x1A0).
  pub let kvs_check_parent_volume : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R90-XREPO.LV11.M3-001 (paideia-os #2223): KIND_VOLUME derivation gate. Bounds-check parent_slot < 256; load descriptor at cap_table + slot*24 (stride 24 per cap/mint.pdx); require kind ([+0]) == KIND_VOLUME (0x1A0) AND rights ([+8]) carry RIGHT_MINT (0x200). KIND_VOLUME (0x1A0) sits in the 0x100..0xFFF band, so it stages through r11 first (matches kind_schema_handle.pdx §5 rule). Pure read (@{cap} because it inspects cap_table). Labels prefixed kvs_cpv_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae kvs_cpv_no;

        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x1A0;                  // KIND_VOLUME
        cmp r10, r11;
        jne kvs_cpv_no;

        mov r10, [rax + 8];
        mov r11, 0x200;                  // RIGHT_MINT
        and r10, r11;
        cmp r10, 0;
        je  kvs_cpv_no;

        mov rax, 1;
        ret;
      kvs_cpv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Row pool: kvs_row_valid / kvs_row_alloc / kvs_row_free.
  //
  // Row stride is 48 bytes (KVS_ROW_BYTES), which is NOT a power of
  // two, so idx*48 composes as (idx*32) + (idx*16) via two shifts +
  // an add. Every address compute in this file uses the same shape.
  // ==========================================================================

  // kvs_row_valid(idx) -> 1 iff idx < KVS_MAX and header's in_use byte
  // (bits [63:56]) is set.
  pub let kvs_row_valid : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R90-XREPO.LV11.M3-001 (paideia-os #2223): 1 iff idx < KVS_MAX(64) and in_use byte set. Address compute uses idx*32 + idx*16 = idx*48 (KVS_ROW_BYTES = 48, not a power of two). Labels prefixed kvs_rv2_.",
      block: {
        mov r10, 64;
        cmp rdi, r10;
        jae kvs_rv2_no;
        lea r10, [rip + _kvs_table];
        mov r11, rdi;
        shl r11, 5;                      // idx * 32
        mov r8,  rdi;
        shl r8,  4;                      // idx * 16
        add r11, r8;                     // idx * 48
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;                     // in_use byte
        cmp rax, 0;
        je  kvs_rv2_no;
        mov rax, 1;
        ret;
      kvs_rv2_no:
        xor rax, rax;
        ret
      }
    }

  // kvs_row_alloc(volume_slot, snap_seq, flags, parent_snap_id)
  //   -> row_idx | KVS_TAIL_ENOSPC
  //
  // Low-first scan over 64 rows of 48 bytes. Header write is LAST:
  // packs (KIND_VOLUME_SNAPSHOT tag in low 56 bits) OR (1 << 56 in_use
  // marker) into [row+0] in the same qword store, matching kind_
  // schema_handle.pdx's "publish in_use last" ordering.
  //
  // Assigns a fresh snap_id by pre-incrementing _kvs_next_snap_id (so
  // the first minted id is 1, guaranteeing no live row ever carries
  // snap_id == 0 -- the "no parent" sentinel used at row +40).
  // refcount is initialised to 1 (this mint IS the first reference).
  // created_tsc is captured via rdtsc at claim time.
  pub let kvs_row_alloc : (u64, u64, u64, u64) -> u64 !{mem, sysreg} @{} =
    fn (volume_slot: u64) (snap_seq: u64) (flags: u64) (parent_snap_id: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "R90-XREPO.LV11.M3-001 (paideia-os #2223): claim one KIND_VOLUME_SNAPSHOT row. Low-first scan (r14=idx cursor) over 64 rows of 48 bytes; address compute (row_base + idx*48) uses shl 5 + shl 4 + add. On claim: (1) pre-increment _kvs_next_snap_id to assign a fresh snap_id (first id is 1, so parent_snap_id==0 stays available as the 'no parent' sentinel); (2) capture rdtsc into r10:r11 -> shl+or into a full u64; (3) write volume_slot at row+8; (4) pack (snap_id | snap_seq<<32) at row+16; (5) write created_tsc at row+24; (6) pack (1 | flags<<32) at row+32 (refcount initialised to 1); (7) pack (parent_snap_id | reserved 0) at row+40 (reserved zero); (8) publish header LAST: OR the 1<<56 in_use marker with the low-56-bit kind tag (KIND_VOLUME_SNAPSHOT = 0x1B3) into [row+0]. Six callee-save pushes (rbx=volume_slot, r12=snap_seq, r13=flags, r14=idx cursor, r15=parent_snap_id, rbp=snap_id) preserve loop-carried state across the internal scan + rdtsc call. Entry rsp%16==8, plus 48 bytes = %16==8, plus sub rsp,8 pad = %16==0 before every nested rdtsc call. Effects {mem, sysreg}: mem for row + counter stores; sysreg for the rdtsc which reads a synchronization MSR. Labels prefixed kvs_ra_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;
        sub rsp, 8;

        mov rbx, rdi;                    // volume_slot
        mov r12, rsi;                    // snap_seq
        mov r13, rdx;                    // flags
        mov r15, rcx;                    // parent_snap_id

        // Fresh snap_id: pre-increment _kvs_next_snap_id, hold in rbp.
        lea r10, [rip + _kvs_next_snap_id];
        mov rax, [r10 + 0];
        add rax, 1;
        mov [r10 + 0], rax;
        mov rbp, rax;                    // rbp = snap_id (>= 1)

        xor r14, r14;                    // idx = 0
      kvs_ra_scan:
        mov r10, 64;                     // KVS_MAX
        cmp r14, r10;
        jae kvs_ra_enospc;

        lea r10, [rip + _kvs_table];
        mov r11, r14;
        shl r11, 5;                      // idx * 32
        mov r8,  r14;
        shl r8,  4;                      // idx * 16
        add r11, r8;                     // idx * 48
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;                     // in_use
        cmp rax, 0;
        je  kvs_ra_claim;

        add r14, 1;
        jmp kvs_ra_scan;

      kvs_ra_claim:
        // (3) volume_slot @ +8.
        mov [r10 + 8], rbx;

        // (4) ids32 = (snap_seq << 32) | (snap_id & 0xFFFFFFFF) @ +16.
        mov rax, rbp;
        mov r11, 0xFFFFFFFF;
        and rax, r11;                    // snap_id low 32
        mov rcx, r12;
        and rcx, r11;
        shl rcx, 32;                     // snap_seq low 32 << 32
        or  rax, rcx;
        mov [r10 + 16], rax;

        // (5) created_tsc via rdtsc @ +24.
        // rdtsc writes edx:eax; compose into rcx = (rdx << 32) | rax.
        rdtsc;
        shl rdx, 32;
        or  rax, rdx;
        mov [r10 + 24], rax;

        // (6) flags_ref = (flags << 32) | (refcount = 1) @ +32.
        mov rax, 1;                      // refcount = 1
        mov rcx, r13;
        mov r11, 0xFFFFFFFF;
        and rcx, r11;
        shl rcx, 32;                     // flags << 32
        or  rax, rcx;
        mov [r10 + 32], rax;

        // (7) parent_res = (0 reserved << 32) | (parent_snap_id & 0xFFFFFFFF) @ +40.
        mov rax, r15;
        mov r11, 0xFFFFFFFF;
        and rax, r11;
        mov [r10 + 40], rax;

        // (8) Publish header LAST: kind_tag OR (in_use << 56).
        mov rax, 0x1B3;                  // KIND_VOLUME_SNAPSHOT kind tag
        mov rcx, 1;
        shl rcx, 56;
        or  rax, rcx;
        mov [r10 + 0], rax;

        mov rax, r14;                    // row_idx
        jmp kvs_ra_out;

      kvs_ra_enospc:
        mov rax, 0xFFFFEB43;             // KVS_TAIL_ENOSPC

      kvs_ra_out:
        add rsp, 8;
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // kvs_row_free(idx) -> (). Scrub the whole 48-byte row.
  pub let kvs_row_free : (u64) -> () !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R90-XREPO.LV11.M3-001 (paideia-os #2223): scrub one row (six u64 words). Labels prefixed kvs_rf_.",
      block: {
        mov r10, 64;                     // KVS_MAX
        cmp rdi, r10;
        jae kvs_rf_out;
        lea r10, [rip + _kvs_table];
        mov r11, rdi;
        shl r11, 5;
        mov r8,  rdi;
        shl r8,  4;
        add r11, r8;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        mov [r10 + 32], rax;
        mov [r10 + 40], rax;
      kvs_rf_out:
        ret
      }
    }

  // ==========================================================================
  // Row accessors. Each returns KVS_DECODE_BAD when the row is not
  // live. Shape mirrors ksh_row_* / vol_row_* one-for-one.
  // ==========================================================================

  pub let kvs_row_volume_slot : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R90-XREPO.LV11.M3-001 (paideia-os #2223): volume_slot (row+8) or KVS_DECODE_BAD. Labels prefixed kvs_rvs_.",
      block: {
        push r12;
        mov r12, rdi;
        call kvs_row_valid;
        cmp rax, 0;
        je  kvs_rvs_bad;
        lea r10, [rip + _kvs_table];
        mov r11, r12;
        shl r11, 5;
        mov r8,  r12;
        shl r8,  4;
        add r11, r8;
        add r10, r11;
        mov rax, [r10 + 8];
        jmp kvs_rvs_out;
      kvs_rvs_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      kvs_rvs_out:
        pop r12;
        ret
      }
    }

  pub let kvs_row_snap_id : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R90-XREPO.LV11.M3-001 (paideia-os #2223): snap_id (ids32 low 32) or KVS_DECODE_BAD. Labels prefixed kvs_rsi_.",
      block: {
        push r12;
        mov r12, rdi;
        call kvs_row_valid;
        cmp rax, 0;
        je  kvs_rsi_bad;
        lea r10, [rip + _kvs_table];
        mov r11, r12;
        shl r11, 5;
        mov r8,  r12;
        shl r8,  4;
        add r11, r8;
        add r10, r11;
        mov rax, [r10 + 16];
        mov r10, 0xFFFFFFFF;
        and rax, r10;
        jmp kvs_rsi_out;
      kvs_rsi_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      kvs_rsi_out:
        pop r12;
        ret
      }
    }

  pub let kvs_row_snap_seq : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R90-XREPO.LV11.M3-001 (paideia-os #2223): snap_seq (ids32 high 32) or KVS_DECODE_BAD. Labels prefixed kvs_rsq_.",
      block: {
        push r12;
        mov r12, rdi;
        call kvs_row_valid;
        cmp rax, 0;
        je  kvs_rsq_bad;
        lea r10, [rip + _kvs_table];
        mov r11, r12;
        shl r11, 5;
        mov r8,  r12;
        shl r8,  4;
        add r11, r8;
        add r10, r11;
        mov rax, [r10 + 16];
