  pub let kvs_row_parent_snap_id : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R90-XREPO.LV11.M3-001 (paideia-os #2223): parent_snap_id (parent_res low 32) or KVS_DECODE_BAD. Labels prefixed kvs_rpi_.",
