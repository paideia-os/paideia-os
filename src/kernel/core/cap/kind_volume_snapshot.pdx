  // ==========================================================================
  // kind_volume_snapshot_mint_body(parent_slot, rights, volume_slot,
  //                                snap_seq, flags, parent_snap_id) -> row_idx | KVS_*
  //
  // The KIND_VOLUME_SNAPSHOT mint walker. Not reachable via cap_
  // invoke (no MINT right on any op at this landing); called from
  // sys_pdxfs_snap_create (a future landing) or the boot witness
  // after the caller holds a KIND_VOLUME parent cap with RIGHT_MINT.
  //
  // Gate order: (1) parent (KIND_VOLUME + RIGHT_MINT); (2) rights
  // subset; (3) flags <= 0x3 (only READ_ONLY and FROZEN defined at
  // this landing); (4) row_alloc. snap_seq / parent_snap_id are
  // passed through verbatim (caller ensures the chain invariant).
  //
  // Register plan: 6 callee-save pushes leave rsp%16==8+48=56, sub
  // rsp,8 -> %16==0 before every nested call. rbx=parent_slot,
  // r12=rights, r13=volume_slot, r14=snap_seq, r15=flags,
  // rbp=parent_snap_id.
  // ==========================================================================

  pub let kind_volume_snapshot_mint_body : (u64, u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (parent_slot: u64) (rights: u64) (volume_slot: u64) (snap_seq: u64) (flags: u64) (parent_snap_id: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R90-XREPO.LV11.M3-001 (paideia-os #2223): mint KIND_VOLUME_SNAPSHOT over KIND_VOLUME. Gate order: (1) parent gate (kvs_check_parent_volume: KIND_VOLUME(0x1A0) + RIGHT_MINT(0x200)); (2) rights subset (kvs_rights_valid: <= R_KVS_ALL = 0x007); (3) flags <= 0x3 (only READ_ONLY (bit 0) and FROZEN (bit 1) defined; upper bits must be zero -- reserved for future revocation states); (4) kvs_row_alloc(volume_slot, snap_seq, flags, parent_snap_id). Six callee-save pushes + sub rsp,8 = 56 bytes: entry rsp%16==8, +56 -> rsp%16==0 for every nested call including rdtsc inside kvs_row_alloc. On success bumps KVS_ST_MINTS; refusal funnel bumps KVS_ST_REFUSED. Effects {mem, sysreg}: mem for row + counter stores; sysreg for rdtsc transitively via kvs_row_alloc. Labels prefixed kvs_mi_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;
        sub rsp, 8;

        mov rbx, rdi;                    // parent_slot
        mov r12, rsi;                    // rights
        mov r13, rdx;                    // volume_slot
        mov r14, rcx;                    // snap_seq
        mov r15, r8;                     // flags
        mov rbp, r9;                     // parent_snap_id

        // (1) Parent gate.
        mov rdi, rbx;
        call kvs_check_parent_volume;
        cmp rax, 0;
        je  kvs_mi_bad_parent;

        // (2) Rights subset.
        mov rdi, r12;
        call kvs_rights_valid;
        cmp rax, 0;
        je  kvs_mi_bad_rights;

        // (3) flags <= 0x3.
        mov r10, 3;
        cmp r15, r10;
        ja  kvs_mi_bad_arg;

        // (4) Row alloc.
        mov rdi, r13;                    // volume_slot
        mov rsi, r14;                    // snap_seq
        mov rdx, r15;                    // flags
        mov rcx, rbp;                    // parent_snap_id
        call kvs_row_alloc;
        mov r10, 64;                     // KVS_MAX (row cap)
        cmp rax, r10;
        jae kvs_mi_alloc_fail;

        // Success: bump mints, return row_idx.
        push rax;
        mov rdi, 0;                      // KVS_ST_MINTS
        call kvs_note;
        pop rax;
        jmp kvs_mi_out;

      kvs_mi_alloc_fail:
        // rax already holds KVS_TAIL_ENOSPC (0xFFFFEB43).
        jmp kvs_mi_refused;
      kvs_mi_bad_parent:
        mov rax, 0xFFFFEB40;             // KVS_MINT_BAD_PARENT
        jmp kvs_mi_refused;
      kvs_mi_bad_rights:
        mov rax, 0xFFFFEB41;             // KVS_MINT_BAD_RIGHTS
        jmp kvs_mi_refused;
      kvs_mi_bad_arg:
        mov rax, 0xFFFFEB42;             // KVS_MINT_BAD_ARG

      kvs_mi_refused:
        push rax;
        mov rdi, 4;                      // KVS_ST_REFUSED
        call kvs_note;
        pop rax;

      kvs_mi_out:
        add rsp, 8;
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // kind_volume_snapshot_narrow_body(row_id, drop_mask) -> 0 | KVS_*
  //
  // Narrow the caller's snapshot cap by dropping every right in
  // drop_mask. At this landing there is no dedicated stored-rights
  // field on the row (rights live on the cap_table descriptor row
  // that referenced this snapshot), so narrow is a pure validation
  // gate: verify the row is live and drop_mask is a subset of R_KVS_
  // ALL. The actual descriptor rights rewrite lands in whichever
  // sys_pdxfs_snap_narrow shim calls this body -- exactly the split
  // ksh_narrow / cap_mint_write take at kind_schema_handle.pdx +
  // sys_sreg_lookup follow-up.
  //
  // Returns 0 iff row is live AND drop_mask subset of R_KVS_ALL.
  // Bumps KVS_ST_NARROWS on the OK arm.
  // ==========================================================================

  pub let kind_volume_snapshot_narrow_body : (u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64) (drop_mask: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R90-XREPO.LV11.M3-001 (paideia-os #2223): narrow gate. (1) kvs_row_valid(row_id) -> non-zero; (2) drop_mask subset of R_KVS_ALL (0x007). No stored-rights rewrite here -- descriptor-side rights live in the caller's cap_table slot and its rewrite is the caller's responsibility (see file header §KVS_OP_NARROW). Bumps KVS_ST_NARROWS on OK. Two callee-save pushes (rbx=row_id, r12=drop_mask) leave rsp%16==0 for every nested call from entry rsp%16==8 -- matches ksh_row_free/alloc's shape. Labels prefixed kvs_nb_.",
      block: {
        push rbx;
        push r12;

        mov rbx, rdi;                    // row_id
        mov r12, rsi;                    // drop_mask

        // (1) Row live?
        mov rdi, rbx;
        call kvs_row_valid;
        cmp rax, 0;
        je  kvs_nb_bad_slot;

        // (2) drop_mask subset of R_KVS_ALL?
        mov rdi, r12;
        call kvs_rights_valid;
        cmp rax, 0;
        je  kvs_nb_bad_rights;

        // OK: bump narrows, return 0.
        mov rdi, 1;                      // KVS_ST_NARROWS
        call kvs_note;
        xor rax, rax;
        jmp kvs_nb_out;

      kvs_nb_bad_slot:
        mov rax, 0xFFFFEB44;             // KVS_BAD_SLOT
        jmp kvs_nb_out;
      kvs_nb_bad_rights:
        mov rax, 0xFFFFEB45;             // KVS_BAD_RIGHTS

      kvs_nb_out:
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // cap_handler_volume_snapshot(rights, target_ptr, op_arg) -> u64
  //
  // KIND_VOLUME_SNAPSHOT op dispatch. row_id = target_ptr[15:0]; op =
  // op_arg[7:0]; op_arg[63:8] MUST be zero (smuggled second value
  // refused with KVS_TAIL_BAD_ARG).
  //
  //   op 0 KVS_OP_CREATE -> derive-child gate: requires R_SNAP_CREATE_
  //                         CHILD. Returns the row's snap_id as u64
  //                         so a caller wrapping this op through
  //                         libpdx-volume vol_snapshot_create_child
  //                         can pass it as parent_snap_id on the
  //                         follow-on mint (kernel-side descriptor
  //                         creation via kind_volume_snapshot_mint_
  //                         body is NOT invoked from here -- see the
  //                         file header's SECTION 1 posture on why
  //                         mint is not reachable via cap_invoke).
  //   op 1 KVS_OP_NARROW -> delegate to kind_volume_snapshot_narrow_
  //                         body(row_id, drop_mask = op_arg[7:0]).
  //                         Actually op_arg's low byte is the OP
  //                         selector; the drop_mask is caller-side
  //                         (bit 16..23) reserved for the follow-up
  //                         cap-invoke landing. At this landing
  //                         drop_mask is fixed at 0 (no-op narrow --
  //                         a valid gate that always succeeds if the
  //                         row is live and the caller holds any
  //                         subset of R_KVS_ALL).
  //   op 2 KVS_OP_QUERY  -> requires R_SNAP_READ. Returns the row's
  //                         created_tsc as u64 (single-word metadata
  //                         return; snap_seq / parent_snap_id are
  //                         exposed via the row accessors above,
  //                         which a future multi-word QUERY variant
  //                         wraps).
  // Three callee-save pushes (rbx=rights, r12=row_id, r13=op) leave
  // rsp%16==8 at every nested call from entry rsp%16==8. Add `sub rsp,
  // 8` before each nested call to reach %16==0.
  // ==========================================================================

  pub let cap_handler_volume_snapshot : (u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R90-XREPO.LV11.M3-001 (paideia-os #2223): KIND_VOLUME_SNAPSHOT ops dispatch. row_id = target_ptr[15:0]; op = op_arg[7:0]; op_arg[63:8] MUST be zero. Row validity checked once before op dispatch. Per-op rights gates: CREATE needs R_SNAP_CREATE_CHILD (0x002); NARROW is a subset-test on any right (delegates to kind_volume_snapshot_narrow_body which itself validates drop_mask); QUERY needs R_SNAP_READ (0x001). CREATE returns the row's snap_id (for parent_snap_id propagation on a follow-on mint from user space). NARROW returns the narrow gate's outcome (0 iff live + drop_mask=0 subset of R_KVS_ALL). QUERY returns created_tsc. Each op bumps its own stat counter. Three callee-save pushes leave rsp%16==0 at every nested call (entry rsp%16==8, minus 24 = %16==0); a nested call whose return value we save across a further nested call uses the `push rax; sub rsp,8; call; add rsp,8; pop rax;` idiom to keep %16==0 through the whole save-restore window (matches kind_schema_handle.pdx cap_handler_schema_handle's ksh_hn_count shape). Effects {mem}: reads _kvs_table + stat counter writes. Capability {cap}: forward-compat annotation for a future R91+ per-volume-slot ownership check. Labels prefixed kvs_hn_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                    // rights
        mov r12, rsi;
        mov r10, 0xFFFF;
        and r12, r10;                    // row_id (target_ptr[15:0])
        mov r13, rdx;                    // op_arg

        // op_arg[63:8] must be zero.
        mov r10, r13;
        shr r10, 8;
        cmp r10, 0;
        jne kvs_hn_bad_arg;

        // op = op_arg[7:0].
        mov r10, r13;
        and r10, 0xFF;
        mov r13, r10;

        // Row validity gate (once, before per-op branches).
        mov rdi, r12;
        call kvs_row_valid;
        cmp rax, 0;
        je  kvs_hn_bad_slot;

        // Op dispatch.
        cmp r13, 0;
        je  kvs_hn_op_create;
        cmp r13, 1;
        je  kvs_hn_op_narrow;
        cmp r13, 2;
        je  kvs_hn_op_query;
        jmp kvs_hn_bad_slot;

      kvs_hn_op_create:
        // Rights gate for CREATE.
        mov r10, rbx;
        and r10, 0x002;                  // R_SNAP_CREATE_CHILD
        cmp r10, 0;
        je  kvs_hn_bad_rights;
        // Return snap_id for parent chain propagation.
        mov rdi, r12;
        call kvs_row_snap_id;
        push rax;
        sub rsp, 8;
        mov rdi, 3;                      // KVS_ST_CREATES
        call kvs_note;
        add rsp, 8;
        pop rax;
        jmp kvs_hn_out;

      kvs_hn_op_narrow:
        // Delegate to the narrow gate with drop_mask = 0 (see handler
        // justification for the deferred cap-arg landing).
        mov rdi, r12;
        xor rsi, rsi;
        call kind_volume_snapshot_narrow_body;
        // narrow_body already bumped KVS_ST_NARROWS on the OK arm.
        jmp kvs_hn_out;

      kvs_hn_op_query:
        // Rights gate for QUERY.
        mov r10, rbx;
        and r10, 0x001;                  // R_SNAP_READ
        cmp r10, 0;
        je  kvs_hn_bad_rights;
        mov rdi, r12;
        call kvs_row_created_tsc;
        push rax;
        sub rsp, 8;
        mov rdi, 2;                      // KVS_ST_QUERIES
        call kvs_note;
        add rsp, 8;
        pop rax;
        jmp kvs_hn_out;

      kvs_hn_bad_arg:
        mov rax, 0xFFFFEB46;             // KVS_TAIL_BAD_ARG
        jmp kvs_hn_out;
      kvs_hn_bad_slot:
        mov rax, 0xFFFFEB44;             // KVS_BAD_SLOT
        jmp kvs_hn_out;
      kvs_hn_bad_rights:
        mov rax, 0xFFFFEB45;             // KVS_BAD_RIGHTS

      kvs_hn_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
