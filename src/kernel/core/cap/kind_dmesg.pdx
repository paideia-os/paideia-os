// src/kernel/core/cap/kind_dmesg.pdx — logging-m9-001 (#708) KIND_DMESG handler
// Per design/kernel/kernel-logging-substrate.md §12.10 (Phase M9 observability).
//
// Cap descriptor:
//   kind        = 22 (KIND_DMESG, derived-kind above 4-bit range; see kind.pdx)
//   rights      = RIGHT_READ (0x01)
//   target_ptr  = kernel VA of a caller-owned scratch buffer for OP_READ_TAIL
//                 to copy ring bytes into (single-slot; SMP concurrent readers
//                 deferred to R19+ per §14 Q3).
//
// Operations (op_arg[7:0] = op_code):
//   OP_READ_TAIL (0):
//     RIGHT_READ required.
//     op_arg[63:8] = length (byte count requested, capped at KLOG_RING_SIZE).
//     Calls klog_ring_read_tail(target_ptr, capped_len) -> bytes copied.
//     Returns bytes copied in rax.
//
//   OP_STAT (1):
//     RIGHT_READ required.
//     Returns (head_lo32 << 32) | KLOG_RING_SIZE.
//     head_lo32 = _klog_ring_head & 0xFFFFFFFF (advance monitor for readers).
//
// Denial paths:
//   Bad op (>=2)      → INVOKE_UNSUPPORTED (0xFFFFFFFFFFFFFFFC).
//   Missing RIGHT_READ → INVOKE_DENIED    (0xFFFFFFFFFFFFFFFD).
//
// Register discipline: handler ABI matches every other kind_*.pdx —
//   RDI = rights, RSI = target_ptr, RDX = op_arg -> RAX = result.
// The introductory klog_s1 chatter mirrors the pattern used across
// kind_timer / kind_notification / kind_process / kind_reply so the
// dispatch-witness trail includes a CAP INVOKE DMESG line before the
// per-op branch.
//
// Audit: design/kernel/kernel-logging-substrate.md §12.10 + §14 Q6.

module KindDmesg = structure {

  // Result sentinels — identical to those defined in invoke.pdx so the
  // module is self-contained w.r.t. observable return values.
  pub let DMESG_INVOKE_UNSUPPORTED : u64 = 0xFFFFFFFFFFFFFFFC
  pub let DMESG_INVOKE_DENIED      : u64 = 0xFFFFFFFFFFFFFFFD

  // Op codes.
  pub let DMESG_OP_READ_TAIL : u64 = 0
  pub let DMESG_OP_STAT      : u64 = 1

  pub let cap_handler_dmesg : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "logging-m9-001 (#708): KIND_DMESG handler. op_arg[7:0] = op_code, op_arg[63:8] = length (OP_READ_TAIL only). OP_READ_TAIL (0) RIGHT_READ: extract length; call klog_ring_read_tail(target_ptr, length); return bytes copied. OP_STAT (1) RIGHT_READ: pack (head_lo32 << 32) | KLOG_RING_SIZE. Any other op -> INVOKE_UNSUPPORTED. Rights failure -> INVOKE_DENIED. klog_s1(INFO, SUBSYS_CAP_, cap_dmesg_msg) chatter matches every other kind_*.pdx handler's opening tag emission for dispatch-witness continuity. RDI-preserve discipline: push rdi/rsi/rdx before klog_s1 (which clobbers rdi/rsi/rdx per SysV), pop them back after so the per-op switch below sees the caller-provided values unchanged. Post-M9 lock-free reader: no cli/sti needed here; the ring's monotonic head/tail counters are u64 loads, atomic on x86-64. Concurrent klog writers may race with our read snapshot but the underlying ring copy is bounded by tail<=head at snapshot time; readers see a consistent prefix.",
      block: {
        push rdi;
        push rsi;
        push rdx;
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_dmesg_msg];
        call klog_s1;
        pop rdx;
        pop rsi;
        pop rdi;

        // Extract op_code from op_arg[7:0].
        mov r8, rdx;
        and r8, 0xFF;
        cmp r8, 0;
        je dmesg_do_read_tail;
        cmp r8, 1;
        je dmesg_do_stat;
        // Unknown op.
        mov rax, 0xFFFFFFFFFFFFFFFC;
        ret;

        dmesg_do_read_tail:
        // Rights check: RIGHT_READ (0x01) must be set.
        mov rax, rdi;
        and rax, 0x01;
        cmp rax, 0x01;
        jne dmesg_denied;

        // Extract length = op_arg[63:8].
        mov r9, rdx;
        shr r9, 8;

        // Call klog_ring_read_tail(dst=target_ptr, len=r9).
        // rsi already holds target_ptr; move it into rdi (arg0) and r9 into rsi (arg1).
        mov rdi, rsi;
        mov rsi, r9;
        call klog_ring_read_tail;
        // rax = bytes copied — pass through.
        ret;

        dmesg_do_stat:
        // Rights check: RIGHT_READ (0x01) must be set.
        mov rax, rdi;
        and rax, 0x01;
        cmp rax, 0x01;
        jne dmesg_denied;

        // Pack (head_lo32 << 32) | KLOG_RING_SIZE.
        mov r10, [rip + _klog_ring_head];
        mov r11, 0xFFFFFFFF;
        and r10, r11;                      // r10 = head_lo32
        shl r10, 32;
        or  r10, 65536;                    // KLOG_RING_SIZE
        mov rax, r10;
        ret;

        dmesg_denied:
        mov rdi, 1;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_denied_msg];
        call klog_s1;
        mov rax, 0xFFFFFFFFFFFFFFFD;
        ret
      }
    }
}
