// src/kernel/core/cap/kind_scsi_device.pdx — R34.M3-003 (#1178)
//
// KIND_SCSI_DEVICE = 0x167, derived over KIND_MSC_LUN (0x166).
//
// The authority to hold ONE SCSI logical-unit's static SBC-3
// identity — its inherited scsi_key (a fresh identity supplied by
// the class driver at INQUIRY time), its scsi_type (0=DIRECT-ACCESS,
// 5=CD/DVD, 7=OPTICAL, ...) and its block geometry: block_size (in
// bytes) and block_count (READ_CAPACITY(10) response).
//
// =============================================================================
// §0  WHY THIS KIND EXISTS
// =============================================================================
//
// A LOGICAL UNIT (KIND_MSC_LUN) is what USB MSC addresses; a SCSI
// DEVICE is what SCSI addresses — the LUN, seen at the block layer,
// after its INQUIRY reported a device type and its READ_CAPACITY
// reported a block geometry. Storage-command authority is per-SCSI-
// device: a READ(10) at scsi_key K1 reads blocks off THAT block
// device, not off another LUN's, so the CAPABILITY at which
// block-command routing is gated has to be this kind.
//
// =============================================================================
// §1  DERIVATION OVER KIND_MSC_LUN
// =============================================================================
//
// The gate demands `kind == KIND_MSC_LUN (0x166)` carrying
// `RIGHT_MINT`. Like KIND_USB_HUB and KIND_MSC_LUN, deriving over a
// derived-kind parent is the point: a raw KIND_USB_INTERFACE holder
// must not be able to mint SCSI authority without the intermediate
// LUN authority the class driver ESTABLISHED with Get-Max-LUN.
//
// SECOND HALF: (a) parent LUN's inherited lun_key must be non-zero
// (NO_LUN); (b) scsi_key non-zero and unique among live rows
// (NO_KEY / IN_USE); (c) scsi_type in [0, 31]; (d) block_size a
// power-of-two in [512, 65536]; (e) block_count non-zero.
//
// =============================================================================
// §2  DYNAMIC STATE IS ABSENT
// =============================================================================
//
// Same discipline as KIND_MSC_LUN §2. scsi_key, scsi_type,
// block_size and block_count are ROW IDENTITY, refused to a mint
// that supplies implausible values. There is NO command state on
// this row — pending CDBs, sense data, unit-attention state live on
// the transport (BOT/UAS) side. A block_size that could be
// re-stamped in place would let a driver read a 4096-byte sector
// with a 512-byte transfer buffer.
//
// =============================================================================
// §3  LEAF OF THE STORAGE LATTICE
// =============================================================================
//
// R_SCSI_DEV_MINT (0x200) IS DELIBERATELY ABSENT from R_SCSI_DEV_ALL:
// nothing derives from a SCSI-device cap in this milestone. Adding
// a MINT bit that no gate accepts as a parent would be a rights bit
// looking like authority and conferring none.
//
// =============================================================================
// §4  FAILURE TAXONOMY 0xFFFFFB70..0xFFFFFB7F
// =============================================================================
//
// R34.M3 softarch chose 0xFFFFFB70..7F, NOT the 0xFFFFFB90..9F the
// task's original suggestion had, because 0xFFFFFB9x collides with
// interface_parser.pdx's live band. Verified disjoint by grep of
// src/kernel/** and tests/kernel/** at R34.M3-003 open.

module KindScsiDevice = structure {

  pub let KIND_SCSI_DEVICE       : u64 = 0x167
  pub let SCSI_DEV_PARENT_KIND   : u64 = 0x166    // = KIND_MSC_LUN

  // §1 bounds.
  pub let SCSI_DEV_TYPE_MIN      : u64 = 0
  pub let SCSI_DEV_TYPE_MAX      : u64 = 31
  pub let SCSI_DEV_BLKSZ_MIN     : u64 = 512
  pub let SCSI_DEV_BLKSZ_MAX     : u64 = 65536

  // SBC-3 well-known types.
  pub let SCSI_DEV_TYPE_DIRECT    : u64 = 0     // hard disk / flash
  pub let SCSI_DEV_TYPE_CDROM     : u64 = 5
  pub let SCSI_DEV_TYPE_OPTICAL   : u64 = 7

  // Rights. Leaf (§3): RIGHT_MINT NOT in R_SCSI_DEV_ALL.
  pub let R_SCSI_DEV_READ    : u64 = 0x001
  pub let R_SCSI_DEV_INVOKE  : u64 = 0x008
  pub let R_SCSI_DEV_REVOKE  : u64 = 0x010
  pub let R_SCSI_DEV_OBSERVE : u64 = 0x400
  pub let R_SCSI_DEV_ALL     : u64 = 0x419

  // Ops:
  pub let SCSIDEV_OP_QUERY_KEY    : u64 = 0
  pub let SCSIDEV_OP_QUERY_TYPE   : u64 = 1
  pub let SCSIDEV_OP_QUERY_BLKSZ  : u64 = 2
  pub let SCSIDEV_OP_QUERY_BLKCNT : u64 = 3
  pub let SCSIDEV_OP_QUERY_PARENT : u64 = 4
  pub let SCSIDEV_OP_DEBUG_PRINT  : u64 = 5
  pub let SCSIDEV_OP_MAX          : u64 = 5

  // Failure taxonomy — 0xFFFFFB70..0xFFFFFB7F.
  pub let SCSIDEV_OK                 : u64 = 0
  pub let SCSIDEV_TAIL_ENOSPC        : u64 = 0xFFFFFB7F
  pub let SCSIDEV_TAIL_BAD_ARG       : u64 = 0xFFFFFB7E
  pub let SCSIDEV_MINT_BAD_PARENT    : u64 = 0xFFFFFB7D
  pub let SCSIDEV_MINT_BAD_RIGHTS    : u64 = 0xFFFFFB7C
  pub let SCSIDEV_MINT_BAD_TYPE      : u64 = 0xFFFFFB7B
  pub let SCSIDEV_MINT_BAD_BLKSZ     : u64 = 0xFFFFFB7A
  pub let SCSIDEV_MINT_BAD_BLKCNT    : u64 = 0xFFFFFB79
  pub let SCSIDEV_MINT_NO_LUN        : u64 = 0xFFFFFB78
  pub let SCSIDEV_MINT_NO_KEY        : u64 = 0xFFFFFB77
  pub let SCSIDEV_MINT_ENOSPC        : u64 = 0xFFFFFB76
  pub let SCSIDEV_MINT_IN_USE        : u64 = 0xFFFFFB75
  pub let SCSIDEV_BAD_SLOT           : u64 = 0xFFFFFB74
  pub let SCSIDEV_WRONG_KIND         : u64 = 0xFFFFFB73
  pub let SCSIDEV_REVOKE_ALREADY     : u64 = 0xFFFFFB72

  pub let SCSIDEV_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let SCSIDEV_ROW_NONE   : u64 = 0xFF

  // 16 rows, 32-byte stride.
  //   [+0]  header (in_use[63:56] | parent_slot[15:8])
  //   [+8]  scsi_key
  //   [+16] body: scsi_type[7:0] | block_size[39:8]
  //   [+24] block_count (u64)
  pub let SCSIDEV_MAX       : u64 = 16
  pub let SCSIDEV_ROW_BYTES : u64 = 32

  pub let mut _scsi_device_table : [u64; 64] = uninit @align(64)
  pub let mut _scsi_device_stats : [u64; 4]  = uninit @align(64)

  pub let SCSIDEV_ST_MINTS   : u64 = 0
  pub let SCSIDEV_ST_REVOKES : u64 = 1
  pub let SCSIDEV_ST_IN_USE  : u64 = 2
  pub let SCSIDEV_ST_ENOSPC  : u64 = 3

  // R51 boot-transcript §5 Bug B: strip embedded '\n' (composer emits its own).
  pub let scsidev_dbg_msg : [u8; 13] = "SCSI DEV ROW\0"

  // ==========================================================================
  // Table reset.
  // ==========================================================================

  pub let scsi_device_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M3-003 (#1178): clear the SCSI device row table and its counters. Labels prefixed scsid_rs_.",
      block: {
        lea r10, [rip + _scsi_device_table];
        xor rax, rax;
        xor rcx, rcx;
      scsid_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 64;
        jb  scsid_rs_rows;

        lea r10, [rip + _scsi_device_stats];
        xor rcx, rcx;
      scsid_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  scsid_rs_stats;
        ret
      }
    }

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let scsi_device_type_valid : (u64) -> u64 !{} @{} =
    fn (t: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M3-003 (#1178): 1 iff t <= 31. Labels prefixed scsid_tv_.",
      block: {
        cmp rdi, 31;
        ja  scsid_tv_no;
        mov rax, 1;
        ret;
      scsid_tv_no:
        xor rax, rax;
        ret
      }
    }

  pub let scsi_device_blksz_valid : (u64) -> u64 !{} @{} =
    fn (bs: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M3-003 (#1178): 1 iff bs in [512, 65536] and power-of-two. Labels prefixed scsid_bv_.",
      block: {
        cmp rdi, 512;
        jb  scsid_bv_no;
        cmp rdi, 65536;
        ja  scsid_bv_no;
        // Power-of-two: (bs & (bs-1)) == 0.
        mov rax, rdi;
        mov r10, rdi;
        sub r10, 1;
        and rax, r10;
        cmp rax, 0;
        jne scsid_bv_no;
        mov rax, 1;
        ret;
      scsid_bv_no:
        xor rax, rax;
        ret
      }
    }

  pub let scsi_device_blkcnt_valid : (u64) -> u64 !{} @{} =
    fn (bc: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M3-003 (#1178): 1 iff bc != 0. Labels prefixed scsid_cv_.",
      block: {
        cmp rdi, 0;
        je  scsid_cv_no;
        mov rax, 1;
        ret;
      scsid_cv_no:
        xor rax, rax;
        ret
      }
    }

  pub let scsi_device_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M3-003 (#1178): subset test against R_SCSI_DEV_ALL. Labels prefixed scsid_rv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x419;
        and rax, r10;
        cmp rax, rdi;
        jne scsid_rv_no;
        mov rax, 1;
        ret;
      scsid_rv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Counters.
  // ==========================================================================

  pub let scsi_device_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M3-003 (#1178): counter bump. Labels prefixed scsid_nt_.",
      block: {
        cmp rdi, 4;
        jae scsid_nt_out;
        lea r10, [rip + _scsi_device_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      scsid_nt_out:
        ret
      }
    }

  pub let scsi_device_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M3-003 (#1178): counter read. Labels prefixed scsid_st_.",
      block: {
        cmp rdi, 4;
        jae scsid_st_zero;
        lea r10, [rip + _scsi_device_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      scsid_st_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Parent gate.
  // ==========================================================================

  pub let scsi_device_check_parent : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R34.M3-003 (#1178): parent must be live KIND_MSC_LUN (0x166) with RIGHT_MINT. Labels prefixed scsid_cp_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae scsid_cp_no;

        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x166;
        cmp r10, r11;
        jne scsid_cp_no;

        mov r10, [rax + 8];
        mov r11, 0x200;
        and r10, r11;
        cmp r10, 0;
        je  scsid_cp_no;

        mov rax, 1;
        ret;
      scsid_cp_no:
        xor rax, rax;
        ret
      }
    }

  pub let scsi_device_parent_key : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R34.M3-003 (#1178): parent LUN row's lun_key, or 0. Labels prefixed scsid_pk_.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;

        mov r11, 256;
        cmp r12, r11;
        jae scsid_pk_zero;

        lea rax, [rip + cap_table];
        mov r8, r12;
        shl r8, 3;
        mov r9, r12;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x166;
        cmp r10, r11;
        jne scsid_pk_zero;

        mov r13, [rax + 16];
        mov r10, 0xFFFF;
        and r13, r10;

        mov rdi, r13;
        call msc_lun_row_key;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  scsid_pk_zero;
        jmp scsid_pk_out;

      scsid_pk_zero:
        xor rax, rax;
      scsid_pk_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  // ==========================================================================
  // Header pack.
  // ==========================================================================

  pub let scsi_device_hdr_pack : (u64) -> u64 !{} @{} =
    fn (parent_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M3-003 (#1178): (parent_slot << 8). Labels prefixed scsid_hp_.",
      block: {
        mov r10, 256;
        cmp rdi, r10;
        jae scsid_hp_bad;
        mov rax, rdi;
        shl rax, 8;
        ret;
      scsid_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let scsi_device_body_pack : (u64, u64) -> u64 !{} @{} =
    fn (scsi_type: u64) (block_size: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M3-003 (#1178): pack scsi_type[7:0] | block_size[39:8]. Refuses out-of-range. Labels prefixed scsid_bp_.",
      block: {
        cmp rdi, 31;
        ja  scsid_bp_bad;
        cmp rsi, 512;
        jb  scsid_bp_bad;
        cmp rsi, 65536;
        ja  scsid_bp_bad;

        mov rax, rdi;
        and rax, 0xFF;
        mov r10, rsi;
        and r10, 0xFFFFFFFF;
        shl r10, 8;
        or  rax, r10;
        ret;
      scsid_bp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // Tail alloc/valid/free. Row layout uses [+8]=key, [+16]=body, [+24]=blkcnt.
  // ==========================================================================

  pub let scsi_device_tail_alloc : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (scsi_key: u64) (body_packed: u64) (block_count: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M3-003 (#1178): claim one SCSI device row. THE ONE WRITER of _scsi_device_table. Labels prefixed scsid_ta_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // hdr
        mov r13, rsi;                    // scsi_key
        mov r14, rdx;                    // body_packed
        mov r15, rcx;                    // block_count

        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne scsid_ta_bad;

        cmp r13, 0;
        je  scsid_ta_bad;

        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp r14, r10;
        je  scsid_ta_bad;

        cmp r15, 0;
        je  scsid_ta_bad;

        xor rbx, rbx;
      scsid_ta_scan:
        cmp rbx, 16;
        jae scsid_ta_enospc;

        lea r10, [rip + _scsi_device_table];
        mov r11, rbx;
        shl r11, 5;
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  scsid_ta_claim;

        add rbx, 1;
        jmp scsid_ta_scan;

      scsid_ta_claim:
        mov rax, r12;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r13;
        mov [r10 + 16], r14;
        mov [r10 + 24], r15;
        mov rax, rbx;
        jmp scsid_ta_out;

      scsid_ta_enospc:
        mov rax, 0xFFFFFB7F;
        jmp scsid_ta_out;
      scsid_ta_bad:
        mov rax, 0xFFFFFB7E;

      scsid_ta_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let scsi_device_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M3-003 (#1178): 1 iff row_id < MAX and in_use. Labels prefixed scsid_tvr_.",
      block: {
        cmp rdi, 16;
        jae scsid_tvr_no;
        lea r10, [rip + _scsi_device_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  scsid_tvr_no;
        mov rax, 1;
        ret;
      scsid_tvr_no:
        xor rax, rax;
        ret
      }
    }

  pub let scsi_device_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M3-003 (#1178): scrub one row. Labels prefixed scsid_tf_.",
      block: {
        cmp rdi, 16;
        jae scsid_tf_out;
        lea r10, [rip + _scsi_device_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
      scsid_tf_out:
        ret
      }
    }

  // ==========================================================================
  // Row accessors.
  // ==========================================================================

  pub let scsi_device_row_key : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M3-003 (#1178): scsi_key. Labels prefixed scsid_rk_.",
      block: {
        push r12; push r13; push r14;
        mov r12, rdi;
        call scsi_device_tail_valid;
        cmp rax, 0;
        je  scsid_rk_bad;
        lea r10, [rip + _scsi_device_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 8];
        jmp scsid_rk_out;
      scsid_rk_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      scsid_rk_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  pub let scsi_device_row_type : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M3-003 (#1178): scsi_type. Labels prefixed scsid_rt_.",
      block: {
        push r12; push r13; push r14;
        mov r12, rdi;
        call scsi_device_tail_valid;
        cmp rax, 0;
        je  scsid_rt_bad;
        lea r10, [rip + _scsi_device_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        and rax, 0xFF;
        jmp scsid_rt_out;
      scsid_rt_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      scsid_rt_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  pub let scsi_device_row_blksz : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M3-003 (#1178): block_size. Labels prefixed scsid_rb_.",
      block: {
        push r12; push r13; push r14;
        mov r12, rdi;
        call scsi_device_tail_valid;
        cmp rax, 0;
        je  scsid_rb_bad;
        lea r10, [rip + _scsi_device_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 8;
        and rax, 0xFFFFFFFF;
        jmp scsid_rb_out;
      scsid_rb_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      scsid_rb_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  pub let scsi_device_row_blkcnt : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M3-003 (#1178): block_count. Labels prefixed scsid_rc_.",
      block: {
        push r12; push r13; push r14;
        mov r12, rdi;
        call scsi_device_tail_valid;
        cmp rax, 0;
        je  scsid_rc_bad;
        lea r10, [rip + _scsi_device_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 24];
        jmp scsid_rc_out;
      scsid_rc_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      scsid_rc_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  pub let scsi_device_row_parent : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M3-003 (#1178): parent slot. Labels prefixed scsid_rp_.",
      block: {
        push r12; push r13; push r14;
        mov r12, rdi;
        call scsi_device_tail_valid;
        cmp rax, 0;
        je  scsid_rp_bad;
        lea r10, [rip + _scsi_device_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 8;
        and rax, 0xFF;
        jmp scsid_rp_out;
      scsid_rp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      scsid_rp_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  // ==========================================================================
  // Lookups.
  // ==========================================================================

  pub let scsi_device_find_by_key : (u64) -> u64 !{mem} @{} =
    fn (scsi_key: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M3-003 (#1178): live row holding this scsi_key, or ROW_NONE. Labels prefixed scsid_fk_.",
      block: {
        cmp rdi, 0;
        je  scsid_fk_none;
        xor rcx, rcx;
      scsid_fk_scan:
        cmp rcx, 16;
        jae scsid_fk_none;
        lea r10, [rip + _scsi_device_table];
        mov r11, rcx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  scsid_fk_next;
        mov rax, [r10 + 8];
        cmp rax, rdi;
        je  scsid_fk_hit;
      scsid_fk_next:
        add rcx, 1;
        jmp scsid_fk_scan;
      scsid_fk_hit:
        mov rax, rcx;
        ret;
      scsid_fk_none:
        mov rax, 0xFF;
        ret
      }
    }

  pub let scsi_device_row_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
