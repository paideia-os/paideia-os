  // ==========================================================================
  // Mint. Six args (slot, parent_slot, rights, scsi_key, packed_type_blksz,
  // block_count). packed_type_blksz = scsi_type[7:0] | block_size[39:8].
  // ==========================================================================

  pub let scsi_device_cap_mint_inner : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (scsi_key: u64) (packed_type_blksz: u64) (block_count: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R34.M3-003 (#1178): mint KIND_SCSI_DEVICE over KIND_MSC_LUN. Six args because SysV has six argument regs; scsi_type + block_size are packed into one u64 to fit. Sequence: slot<256; check_parent; rights_valid; unpack scsi_type/block_size; validate; parent_key non-zero (NO_LUN); scsi_key non-zero (NO_KEY); uniqueness (IN_USE); block_count non-zero (BAD_BLKCNT); hdr_pack; body_pack; tail_alloc; cap_mint_write. Labels prefixed scsid_mi_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov rbx, rdi;                    // slot
        mov r12, rsi;                    // parent_slot
        mov r13, rdx;                    // rights
        mov r14, rcx;                    // scsi_key
        mov r15, r8;                     // packed_type_blksz
        mov rbp, r9;                     // block_count

        mov r10, 256;
        cmp rbx, r10;
        jae scsid_mi_bad_slot;

        mov rdi, r12;
        call scsi_device_check_parent;
        cmp rax, 0;
        je  scsid_mi_bad_parent;

        mov rdi, r13;
        call scsi_device_rights_valid;
        cmp rax, 0;
        je  scsid_mi_bad_rights;

        mov rdi, r15;
        and rdi, 0xFF;                   // scsi_type
        call scsi_device_type_valid;
        cmp rax, 0;
        je  scsid_mi_bad_type;

        mov rdi, r15;
        shr rdi, 8;
        and rdi, 0xFFFFFFFF;             // block_size
        call scsi_device_blksz_valid;
        cmp rax, 0;
        je  scsid_mi_bad_blksz;

        mov rdi, rbp;
        call scsi_device_blkcnt_valid;
        cmp rax, 0;
        je  scsid_mi_bad_blkcnt;

        mov rdi, r12;
        call scsi_device_parent_key;
        cmp rax, 0;
        je  scsid_mi_no_lun;

        cmp r14, 0;
        je  scsid_mi_no_key;

        mov rdi, r14;
        call scsi_device_find_by_key;
        cmp rax, 0xFF;
        jne scsid_mi_in_use;

        mov rdi, r15;
        and rdi, 0xFF;                   // scsi_type
        mov rsi, r15;
        shr rsi, 8;
        and rsi, 0xFFFFFFFF;             // block_size
        call scsi_device_body_pack;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  scsid_mi_bad_type;
        push rax;
        sub rsp, 8;

        mov rdi, r12;
        call scsi_device_hdr_pack;
        add rsp, 8;
        pop r10;                         // body
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  scsid_mi_bad_parent;

        mov rdi, rax;                    // hdr
        mov rsi, r14;                    // scsi_key
        mov rdx, r10;                    // body
        mov rcx, rbp;                    // block_count
        call scsi_device_tail_alloc;

        mov r10, 0xFFFFFB7F;
        cmp rax, r10;
        je  scsid_mi_enospc;
        mov r10, 0xFFFFFB7E;
        cmp rax, r10;
        je  scsid_mi_bad_type;

        mov r15, rax;                    // row_id
        mov r11, rbx;
        shl r11, 16;
        or  r15, r11;

        mov rdi, rbx;
        mov rsi, 0x167;
        mov rdx, r13;
        mov rcx, r15;
        call cap_mint_write;

        mov rdi, 0;
        call scsi_device_note;

        xor rax, rax;
        jmp scsid_mi_out;

      scsid_mi_bad_slot:
        mov rax, 0xFFFFFB74;
        jmp scsid_mi_out;
      scsid_mi_bad_parent:
        mov rax, 0xFFFFFB7D;
        jmp scsid_mi_out;
      scsid_mi_bad_rights:
        mov rax, 0xFFFFFB7C;
        jmp scsid_mi_out;
      scsid_mi_bad_type:
        mov rax, 0xFFFFFB7B;
        jmp scsid_mi_out;
      scsid_mi_bad_blksz:
        mov rax, 0xFFFFFB7A;
        jmp scsid_mi_out;
      scsid_mi_bad_blkcnt:
        mov rax, 0xFFFFFB79;
        jmp scsid_mi_out;
      scsid_mi_no_lun:
        mov rax, 0xFFFFFB78;
        jmp scsid_mi_out;
      scsid_mi_no_key:
        mov rax, 0xFFFFFB77;
        jmp scsid_mi_out;
      scsid_mi_in_use:
        mov rdi, 2;
        call scsi_device_note;
        mov rax, 0xFFFFFB75;
        jmp scsid_mi_out;
      scsid_mi_enospc:
        mov rdi, 3;
        call scsi_device_note;
        mov rax, 0xFFFFFB76;

      scsid_mi_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let scsi_device_cap_mint : (u64, u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (scsi_key: u64) (packed_type_blksz: u64) (block_count: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R34.M3-003 (#1178): audited mint.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;
        mov r13, rsi;

        call scsi_device_cap_mint_inner;
        mov r14, rax;

        mov rdi, 1;
        mov rsi, 0x167;
        mov rdx, r12;
        mov rcx, r13;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Revoke.
  // ==========================================================================

  pub let scsi_device_cap_revoke_inner : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R34.M3-003 (#1178): revoke a KIND_SCSI_DEVICE. Labels prefixed scsid_rvk_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;

        mov r10, 256;
        cmp r12, r10;
        jae scsid_rvk_bad_slot;

        lea rax, [rip + cap_table];
        mov r8, r12;
        shl r8, 3;
        mov r9, r12;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov rbx, rax;

        mov r10, [rbx + 0];
        cmp r10, 0;
        je  scsid_rvk_already;

        mov r11, 0x167;
        cmp r10, r11;
        jne scsid_rvk_wrong_kind;

        mov r13, [rbx + 16];
        mov r10, 0xFFFF;
        and r13, r10;

        mov rdi, r13;
        call scsi_device_tail_valid;
        cmp rax, 0;
        je  scsid_rvk_clear;

        mov rdi, r13;
        call scsi_device_tail_free;

      scsid_rvk_clear:
        mov rdi, r12;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        mov rdi, 1;
        call scsi_device_note;

        xor rax, rax;
        jmp scsid_rvk_out;

      scsid_rvk_bad_slot:
        mov rax, 0xFFFFFB74;
        jmp scsid_rvk_out;
      scsid_rvk_wrong_kind:
        mov rax, 0xFFFFFB73;
        jmp scsid_rvk_out;
      scsid_rvk_already:
        mov rax, 0xFFFFFB72;

      scsid_rvk_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let scsi_device_cap_revoke : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R34.M3-003 (#1178): audited revoke.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;

        call scsi_device_cap_revoke_inner;
        mov r14, rax;

        mov rdi, 2;
        mov rsi, 0x167;
        mov rdx, r12;
        mov rcx, r12;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Dispatch.
  // ==========================================================================

  pub let cap_handler_scsi_device : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R34.M3-003 (#1178): KIND_SCSI_DEVICE dispatch handler. Queries INVOKE; DEBUG OBSERVE. Arity ONE; op_arg[63:8] REFUSED. Labels prefixed scsid_hn_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov r12, rdi;
        mov r13, rsi;
        mov r10, 0xFFFF;
        and r13, r10;
        mov r14, rdx;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_scsi_device_msg];
        call klog_s1;

        mov r10, r14;
        and r10, 0xFF;
        mov rbp, r10;
        mov r11, r14;
        shr r11, 8;
        cmp r11, 0;
        jne scsid_hn_res;

        cmp rbp, 5;
        ja  scsid_hn_unsup;

        cmp rbp, 5;
        je  scsid_hn_dbg;

        mov r10, r12;
        and r10, 0x008;
        cmp r10, 0;
        je  scsid_hn_denied;

        mov rdi, r13;
        cmp rbp, 0;
        je  scsid_hn_key;
        cmp rbp, 1;
        je  scsid_hn_typ;
        cmp rbp, 2;
        je  scsid_hn_bs;
        cmp rbp, 3;
        je  scsid_hn_bc;
        call scsi_device_row_parent;
        jmp scsid_hn_out;

      scsid_hn_key:
        call scsi_device_row_key;
        jmp scsid_hn_out;
      scsid_hn_typ:
        call scsi_device_row_type;
        jmp scsid_hn_out;
      scsid_hn_bs:
        call scsi_device_row_blksz;
        jmp scsid_hn_out;
      scsid_hn_bc:
        call scsi_device_row_blkcnt;
        jmp scsid_hn_out;

      scsid_hn_dbg:
        mov r10, r12;
        and r10, 0x400;
        cmp r10, 0;
        je  scsid_hn_denied;
        xor rax, rax;
        jmp scsid_hn_out;

      scsid_hn_res:
        mov rax, 0xFFFFFB7E;
        jmp scsid_hn_out;
      scsid_hn_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;
        jmp scsid_hn_out;
      scsid_hn_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;

      scsid_hn_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
