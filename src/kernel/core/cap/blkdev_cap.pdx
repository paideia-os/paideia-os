// src/kernel/core/cap/blkdev_cap.pdx — R24-M5-003 / #905
// KIND_BLKDEV derived capability descriptor (per-namespace block device)
//
// Design context
// --------------
// The R24.M2 nvme_ns_list + R24.M4 PRP/DMA layers exposed the ability
// to read/write logical blocks on a discovered NVMe namespace. R24.M5
// gives that access a capability: KIND_BLKDEV is minted one-per-active
// namespace and grants the holder the right to invoke read_sectors /
// write_sectors / get_capacity RPCs against that namespace.
//
// The design surface is documented in two companion files:
//   - design/ipc/blkdev-rpc-schema.md  — the wire format the userspace
//     driver-server will speak; wire code deferred to R25+ per #1015.
//   - design/drivers/blkdev-cap.md     — the rights model + revocation
//     semantics (this module's runtime side).
//
// KIND base assignment
// --------------------
// The base-kind enum (cap/kind.pdx §Kind) is closed at 16 slots. No
// existing base slot matches "block device" — KIND_DEVICE (10) is
// reserved for the legacy device-handler kind (kind_dev.pdx) — so
// KIND_BLKDEV rides KIND_PAGE (base 4), matching the KIND_ACPI /
// KIND_PCI_DEV precedent (see acpi_cap.pdx §KIND base assignment).
//
// The derived-kind tag sits above the 4-bit LAM range and distinct
// from prior derived tags:
//
//   KIND_DRIVER    = 0x15
//   KIND_ACPI      = 0x20
//   KIND_PCI_DEV   = 0x30
//   KIND_INTERRUPT_CAP    = 0x40
//   KIND_NOTIFICATION_CAP = 0x41
//   KIND_BLKDEV    = 0x42  (this module)
//
// Rights discipline
// -----------------
// Five rights on a KIND_BLKDEV capability (R_BLK_FLUSH/R_BLK_TRIM added
// at R51.M4-001, #1651 — design/hardware/nvme-oncs-reliability.md §4.1):
//
//   R_BLK_READ   (bit 0)  — read_sectors RPC
//   R_BLK_WRITE  (bit 1)  — write_sectors RPC
//   R_BLK_ADMIN  (bit 2)  — get_capacity, namespace-management RPCs
//   R_BLK_FLUSH  (bit 3)  — BDEV_OP_FLUSH (R51.M4-001, #1651)
//   R_BLK_TRIM   (bit 4)  — BDEV_OP_TRIM (R51.M4, #1652)
//
// A driver-server hosting a filesystem asks the broker for R_BLK_READ |
// R_BLK_WRITE. A read-only namespace publication (e.g. an ISO image
// mount) hands out only R_BLK_READ. R_BLK_ADMIN is reserved for the
// nvme_supervisor. R_BLK_ALL (now 0x1F) carries FLUSH/TRIM by default
// — an admin/write cap should be able to flush and trim.
//
// Descriptor tail (64 bytes, extended from R24's 32 at R51.M7-001/#1669)
// -----------------------------------------------------------------------
//
// R24's KIND_BLKDEV was gate-only (see "Fixture posture" below) — no
// module here ever wrote a real 32-byte payload. R51 wires KIND_BLKDEV
// end-to-end via dual-kind mint over TWO different parent rows
// (kind_nvme_namespace.pdx's nvme_ns_dual_kind_mint, #1642;
// kind_ahci_port.pdx's ahci_port_dual_kind_mint, #1662), so the actual
// per-cap payload lives as ROW-INDIRECTION: the cap descriptor itself
// stays {kind, rights, target_ptr} (cap/mint.pdx's cap_mint_write, 24
// bytes total), with target_ptr packing row_id (bits [15:0]) + family
// (bits [23:16]); the 64-byte "tail" is the row addressed by target_ptr
// in whichever per-family table owns it (_nvme_namespace_table /
// _ahci_port_table, kind_nvme_namespace.pdx / kind_ahci_port.pdx
// SECTION 1 — both already 64 bytes, extended incrementally at
// R51.M2/M5/M6 ahead of this ticket, plus max_transfer_blocks /
// dma_domain_slot added by R51.M7-001/#1669 itself). The R24 32-byte
// view below stays byte-for-byte readable via kind_blkdev.pdx's
// `_blkdev_legacy_view`; the full 64-byte extension (family / features
// / max_transfer_blocks / dma_domain_slot / parent_slot / attest_key)
// is reached via that same file's family-dispatching `blkdev_row_*`
// accessors. design/hardware/nvme-and-disk-substrate.md §4.3 +
// design/hardware/nvme-ahci-tail-milestones.md §M7-001.
//
// R24-preserved 32-byte view (offsets unchanged, still readable via
// `_blkdev_legacy_view`):
//
//   +0    u8  controller_idx     — parent row's parent_slot & 0xFF
//   +1    u8  _pad0
//   +2    u16 _pad1
//   +4    u32 nsid_or_port       — NVMe: nsid; AHCI: port_index
//   +8    u32 lba_size           — bytes per logical block (512 or 4096 typical)
//   +12   u32 _pad2
//   +16   u64 block_count        — total addressable blocks (NSZE / LBA48 count)
//   +24   u32 rights             — subset of R_BLK_ALL (cap descriptor's own
//                                    rights field, not row data)
//   +28   u32 _pad3
//
// R51 extension (reached via kind_blkdev.pdx's blkdev_row_* accessors,
// not at these literal byte offsets — see that file's own layout note
// on why the two per-family row tables pack these fields differently):
//
//   family               — 0=LEGACY_NVME, 1=NVME, 2=AHCI
//   features              — bitmap: bit0 FLUSH, 1 TRIM, 2 WRITE_ZEROES,
//                            3 WRITE_CACHE_PRESENT
//   max_transfer_blocks   — u16; zero until R51.M7-003 populates it
//                            from MDTS (NVMe) / PRDTL_max (AHCI)
//   dma_domain_slot       — u8 (0..255); zero (unscoped) until a driver
//                            process scopes this cap to a KIND_DMA_DOMAIN
//   parent_slot           — KIND_NVME_NAMESPACE or KIND_AHCI_PORT slot
//                            this cap was derived from
//   attest_key            — KIND_DMA_ATTESTATION.attest_key
//
// Fixture posture at R24.M5
// -------------------------
// This module is *mint-gate only*, matching AcpiCap / DeviceCap /
// InterruptCap. The gate validates controller_idx / nsid / rights but
// the descriptor slab write is deferred until cap_revoke has a real
// body (see cap/revoke.pdx §R12-m5-001). A revocation must invalidate
// every in-flight read/write RPC citing the cap; that logic lives with
// the R23+ userspace-server substrate (#1015). blkdev_cap_mint itself
// is superseded at R51 by the per-family entry points R51.M7-003 adds
// (blkdev_cap_mint_from_nvme / _from_ahci); it stays exported as a
// compat shim.
//
// paideia-as encoder-gap posture (v0.22.x)
// ----------------------------------------
// Pure arithmetic + branch. Reserved-label discipline: labels prefixed
// `blk_cap_`.

module BlkdevCap = structure {

  // ============================================================================
  // Kind tags
  // ============================================================================
  //
  // Runtime base kind for a KIND_BLKDEV capability. Rides KIND_PAGE
  // (=4) — the underlying resource is a set of logical blocks projected
  // onto host pages via PRP transfers. Same posture as KIND_ACPI /
  // KIND_PCI_DEV.

  pub let KIND_BLKDEV_BASE : u64 = 4
  pub let KIND_BLKDEV      : u64 = 0x42
  pub let KIND_BLKDEV_TAG  : u64 = 0x42

  // ============================================================================
  // Rights
  // ============================================================================

  pub let R_BLK_READ   : u64 = 0x01
  pub let R_BLK_WRITE  : u64 = 0x02
  pub let R_BLK_ADMIN  : u64 = 0x04
  pub let R_BLK_FLUSH  : u64 = 0x08   // R51.M4-001 (#1651): BDEV_OP_FLUSH
  pub let R_BLK_TRIM   : u64 = 0x10   // R51.M4 (#1652): BDEV_OP_TRIM
  pub let R_BLK_ALL    : u64 = 0x1F   // 0x01 | 0x02 | 0x04 | 0x08 | 0x10
                                       // widened at R51.M4-001 (#1651)
                                       // from 0x07; an existing R_BLK_ALL
                                       // mint now implicitly carries
                                       // FLUSH/TRIM authorization (design
                                       // doc §4.1 -- intentional).

  // ============================================================================
  // Mint return codes
  // ============================================================================

  pub let BLK_CAP_MINT_OK         : u64 = 0
  pub let BLK_CAP_MINT_BAD_RIGHTS : u64 = 0xFFFFFFFF
  pub let BLK_CAP_MINT_BAD_CTRL   : u64 = 0xFFFFFFFE
  pub let BLK_CAP_MINT_BAD_NSID   : u64 = 0xFFFFFFFD

  // ============================================================================
  // Bounds (mirror nvme/probe.pdx NVME_MAX_DEVS)
  // ============================================================================

  pub let BLK_CAP_CTRL_MAX : u64 = 8   // matches NVME_MAX_DEVS

  // ============================================================================
  // blk_rights_valid(rights) -> u64
  // ============================================================================
  //
  // Returns 1 iff (rights & R_BLK_ALL) == rights; else 0.

  pub let blk_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R24-M5-003 (#905) KIND_BLKDEV rights-subset validator. Returns 1 iff (rights & R_BLK_ALL) == rights; else 0. R_BLK_ALL = 0x1F (bits 0..4, widened at R51.M4-001 #1651 from 0x07 to add R_BLK_FLUSH/R_BLK_TRIM). Same encoder posture as AcpiCap.rights_valid / DeviceCap.rights_valid / InterruptCap.int_rights_valid — unsafe block per paideia-as #913 (pure-fn if-else T0532). Leaf.",
      block: {
        mov rax, rdi;
        mov r10, 0x1F;
        and rax, r10;
        cmp rax, rdi;
        jne blk_cap_rights_no;
        mov rax, 1;
        ret;
        blk_cap_rights_no:
          mov rax, 0;
          ret
      }
    }

  // ============================================================================
  // blkdev_cap_mint(controller_idx, nsid, rights) -> u64
  // ============================================================================
  //
  // Gate-only mint per the AcpiCap / DeviceCap pattern. Real slab_alloc
  // + cap_mint_write deferred until cap_revoke has a real body (see
  // cap/revoke.pdx §R12-m5-001).
  //
  // SysV:
  //   rdi = controller_idx (u8 semantics; must be < BLK_CAP_CTRL_MAX)
  //   rsi = nsid (u32 semantics; must be non-zero per NVMe §3.1.14)
  //   rdx = rights (u32 semantics; subset of R_BLK_ALL)
  //
  // Returns rax = BLK_CAP_MINT_OK on success, or BLK_CAP_MINT_BAD_*.
  //
  // Return codes:
  //   BLK_CAP_MINT_OK           = 0
  //   BLK_CAP_MINT_BAD_CTRL     = 0xFFFFFFFE   (controller_idx >= 8)
  //   BLK_CAP_MINT_BAD_NSID     = 0xFFFFFFFD   (nsid == 0)
  //   BLK_CAP_MINT_BAD_RIGHTS   = 0xFFFFFFFF   (rights outside R_BLK_ALL)

  pub let blkdev_cap_mint : (u64, u64, u64) -> u64 !{} @{} =
    fn (controller_idx: u64, nsid: u64, rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R24-M5-003 (#905) KIND_BLKDEV mint gate. Sequence: controller_idx < BLK_CAP_CTRL_MAX (8), nsid != 0, then blk_rights_valid(rights). On any failure return the corresponding BLK_CAP_MINT_BAD_*. Real slab_alloc + cap_mint_write wire-up deferred until cap_revoke has a real body (see cap/revoke.pdx §R12-m5-001) so a KIND_BLKDEV revoke-→-EPERM-on-RPC fixture can round-trip once the userspace-server substrate (#1015) lands. Same structural posture as interrupt_cap_mint. Preserves rdx (rights) across the blk_rights_valid call by shuffling it into rdi. Written as unsafe block per paideia-as #913.",
      block: {
        // Controller-index bound.
        cmp rdi, 8;                              // BLK_CAP_CTRL_MAX
        jae blk_cap_mint_bad_ctrl;

        // NSID != 0 (NVMe §3.1.14: NSID=0 is a broadcast identifier,
        // never a valid target for read/write).
        cmp rsi, 0;
        je  blk_cap_mint_bad_nsid;

        // blk_rights_valid expects rights in rdi.
        mov rdi, rdx;
        call blk_rights_valid;
        cmp rax, 0;
        je  blk_cap_mint_bad_rights;

        // OK path — return BLK_CAP_MINT_OK (0). Real descriptor write
        // deferred (see module header §Fixture posture).
        mov rax, 0;
        ret;

        blk_cap_mint_bad_ctrl:
          mov rax, 0xFFFFFFFE;
          ret;
        blk_cap_mint_bad_nsid:
          mov rax, 0xFFFFFFFD;
          ret;
        blk_cap_mint_bad_rights:
          mov rax, 0xFFFFFFFF;
          ret
      }
    }
}
