// src/kernel/core/cap/kind_gpu_vm.pdx — R37.M4-001 (#1267)
//
// KIND_GPU_VM = 0x175, derived over KIND_IPC_ENDPOINT (5). LEAF.
//
// One GPU virtual-memory context: a vm_key identifying the space, the
// KIND_IPC_ENDPOINT the client drives the space over, the physical
// frame that holds the PPGTT root (PML4), an ASID-like space_id, and
// the FSM state (NEW / ACTIVE / DYING) that gates bind and unbind.
//
// =============================================================================
// §0  WHY THIS KIND EXISTS
// =============================================================================
//
// Every GPU process needs a private virtual address space its GPU BOs
// live in.  Without a capability naming that space, a caller could:
//
//   (1) Attach a BO into another process's PPGTT and read its scan-out
//       ("cross-process VA forging"): the row records the endpoint the
//       space belongs to and the ppgtt_bind gate refuses a bind whose
//       target VM is not held by the caller.
//   (2) Restamp the PPGTT root out from under an in-flight submission
//       ("root swap"): pml4_pa is frozen at mint and there is no op on
//       this kind that mutates it.
//   (3) Recycle the ASID of a DYING space before its bindings drain
//       ("stale ASID"): the state field advances NEW -> ACTIVE ->
//       DYING but never returns, and revoke refuses non-DYING.
//
// The KIND_IPC_ENDPOINT parent is the endpoint over which the GPU
// service dispatches VM ops for this space.  Like every KIND_IPC_
// ENDPOINT-derived kind in this tree (KIND_MODESET_TXN,
// KIND_FW_SESSION, KIND_EC_QUERY, ...), the parent kind alone
// discriminates NOTHING; the mint gates below cover the rest.
//
// =============================================================================
// §1  DERIVATION OVER KIND_IPC_ENDPOINT
// =============================================================================
//
// The gate demands `kind == KIND_IPC_ENDPOINT (5)` carrying RIGHT_MINT.
// A mint additionally requires:
//
//   (a) vm_key non-zero and unique among live rows (NO_KEY / IN_USE)
//   (b) endpoint_slot names a live KIND_IPC_ENDPOINT with RIGHT_MINT
//       (NO_ENDPOINT); the endpoint id is INHERITED from the parent's
//       target_ptr[15:0] and stashed on the row so a fanout path can
//       drop back to the endpoint the space is scoped to
//   (c) pml4_pa non-zero and 4K-aligned (BAD_ROOT); the frame must be
//       the physical address of the PPGTT root (PML4) that
//       ppgtt_walker will page-walk through
//   (d) space_id fits in u16 and is non-zero (BAD_SPACE); zero is
//       reserved for the kernel-driver's own GTT root
//   (e) initial state is always STATE_NEW; a caller cannot mint into
//       ACTIVE / DYING — the transition to ACTIVE is
//       ppgtt_walker's job at first bind, and the transition to DYING
//       is the revoke helper
//   (f) rights subset of R_GPU_VM_ALL (which excludes R_MINT — this is
//       a LEAF; no cap in this tree derives from a KIND_GPU_VM)
//
// =============================================================================
// §2  ROW LAYOUT — 32 BYTES EXACTLY
// =============================================================================
//
//   [+0]  header:  in_use[63:56] | parent_slot[15:8]
//   [+8]  vm_key   (u64)
//   [+16] body1:   endpoint_slot[31:0] | space_id[47:32]
//                | state[55:48]        | reserved[63:56]
//   [+24] body2:   pml4_pa (u64)
//
// state is the ONE mutable field: kgvm_row_transition (called only by
// ppgtt_walker at first bind and by kgvm_revoke_inner at teardown) is
// the sole mutator.  No op reachable through cap_handler_gpu_vm
// mutates state.
//
// =============================================================================
// §3  LEAF
// =============================================================================
//
// R_GPU_VM_MINT (0x200) is DELIBERATELY ABSENT from R_GPU_VM_ALL.  No
// cap in this tree derives from a KIND_GPU_VM.  ppgtt_bind and
// gtt_scanout consume the row through row accessors rather than by
// minting children.
//
// =============================================================================
// §4  FAILURE TAXONOMY 0xFFFFF5F0..0xFFFFF5FF
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent free bands: ppgtt_walker
// 0xFFFFF5E0..EF, ppgtt_bind 0xFFFFF5D0..DF, ppgtt_prot
// 0xFFFFF5C0..CF, gtt_scanout 0xFFFFF5B0..BF; adjacent used band
// above: gpu_bo_alloc_channel 0xFFFFF600..0F).

module KindGpuVm = structure {

  pub let KIND_GPU_VM         : u64 = 0x175
  pub let GPU_VM_PARENT_KIND  : u64 = 5           // = KIND_IPC_ENDPOINT

  // FSM state ordinals (§1e).
  pub let KGVM_STATE_NEW    : u64 = 0
  pub let KGVM_STATE_ACTIVE : u64 = 1
  pub let KGVM_STATE_DYING  : u64 = 2
  pub let KGVM_STATE_MAX    : u64 = 2

  // Rights.  LEAF: R_MINT (0x200) NOT in the mask (§3).
  pub let R_GPU_VM_READ    : u64 = 0x001
  pub let R_GPU_VM_WRITE   : u64 = 0x002
  pub let R_GPU_VM_INVOKE  : u64 = 0x008
  pub let R_GPU_VM_REVOKE  : u64 = 0x010
  pub let R_GPU_VM_OBSERVE : u64 = 0x400
  pub let R_GPU_VM_ALL     : u64 = 0x41B

  // Ops.  Every op takes NO OPERAND -- op_arg[63:8] REFUSED.
  pub let KGVM_OP_QUERY_KEY      : u64 = 0
  pub let KGVM_OP_QUERY_ENDPOINT : u64 = 1
  pub let KGVM_OP_QUERY_PML4     : u64 = 2
  pub let KGVM_OP_QUERY_SPACE    : u64 = 3
  pub let KGVM_OP_QUERY_STATE    : u64 = 4
  pub let KGVM_OP_DEBUG_PRINT    : u64 = 5
  pub let KGVM_OP_MAX            : u64 = 5

  // Failure taxonomy -- 0xFFFFF5F0..0xFFFFF5FF.
  pub let KGVM_OK                : u64 = 0
  pub let KGVM_TAIL_ENOSPC       : u64 = 0xFFFFF5FF
  pub let KGVM_TAIL_BAD_ARG      : u64 = 0xFFFFF5FE
  pub let KGVM_MINT_BAD_PARENT   : u64 = 0xFFFFF5FD
  pub let KGVM_MINT_BAD_RIGHTS   : u64 = 0xFFFFF5FC
  pub let KGVM_MINT_BAD_ROOT     : u64 = 0xFFFFF5FB
  pub let KGVM_MINT_BAD_SPACE    : u64 = 0xFFFFF5FA
  pub let KGVM_MINT_BAD_STATE    : u64 = 0xFFFFF5F9
  pub let KGVM_MINT_NO_ENDPOINT  : u64 = 0xFFFFF5F8
  pub let KGVM_MINT_NO_KEY       : u64 = 0xFFFFF5F7
  pub let KGVM_MINT_ENOSPC       : u64 = 0xFFFFF5F6
  pub let KGVM_MINT_IN_USE       : u64 = 0xFFFFF5F5
  pub let KGVM_BAD_SLOT          : u64 = 0xFFFFF5F4
  pub let KGVM_WRONG_KIND        : u64 = 0xFFFFF5F3
  pub let KGVM_REVOKE_ALREADY    : u64 = 0xFFFFF5F2
  pub let KGVM_BAD_TRANSITION    : u64 = 0xFFFFF5F1

  pub let KGVM_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let KGVM_ROW_NONE   : u64 = 0xFF

  // 8 rows, 32-byte stride -- total 256 bytes as [u64; 32].
  pub let KGVM_MAX       : u64 = 8
  pub let KGVM_ROW_BYTES : u64 = 32

  pub let mut _gpu_vm_table : [u64; 32] = uninit @align(64)
  pub let mut _gpu_vm_stats : [u64; 4]  = uninit @align(64)

  pub let KGVM_ST_MINTS       : u64 = 0
  pub let KGVM_ST_REVOKES     : u64 = 1
  pub let KGVM_ST_TRANSITIONS : u64 = 2
  pub let KGVM_ST_REFUSED     : u64 = 3

  pub let kgvm_dbg_msg : [u8; 11] = "GPU VM ROW\0"

  // ==========================================================================
  // Table reset.
  // ==========================================================================

  pub let gpu_vm_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M4-001 (#1267): clear the GPU VM row table and its counters. Boot and teardown only. Labels prefixed kgvm_rs_.",
      block: {
        lea r10, [rip + _gpu_vm_table];
        xor rax, rax;
        xor rcx, rcx;
      kgvm_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  kgvm_rs_rows;

        lea r10, [rip + _gpu_vm_stats];
        xor rcx, rcx;
      kgvm_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  kgvm_rs_stats;
        ret
      }
    }

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let kgvm_state_valid : (u64) -> u64 !{} @{} =
    fn (s: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R37.M4-001 (#1267): 1 iff s <= KGVM_STATE_MAX (2). Labels prefixed kgvm_sv_.",
      block: {
        cmp rdi, 2;
        ja  kgvm_sv_no;
        mov rax, 1;
        ret;
      kgvm_sv_no:
        xor rax, rax;
        ret
      }
    }

  pub let kgvm_pml4_valid : (u64) -> u64 !{} @{} =
    fn (pa: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R37.M4-001 (#1267): 1 iff pa != 0 AND pa & 0xFFF == 0 (4K-aligned frame). Labels prefixed kgvm_pv_.",
      block: {
        cmp rdi, 0;
        je  kgvm_pv_no;
        mov r10, 0xFFF;
        and r10, rdi;
        cmp r10, 0;
        jne kgvm_pv_no;
        mov rax, 1;
        ret;
      kgvm_pv_no:
        xor rax, rax;
        ret
      }
    }

  pub let kgvm_space_valid : (u64) -> u64 !{} @{} =
    fn (id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R37.M4-001 (#1267): 1 iff 0 < id <= 0xFFFF. Space 0 is reserved for the kernel-driver GTT. Labels prefixed kgvm_spv_.",
      block: {
        cmp rdi, 0;
        je  kgvm_spv_no;
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  kgvm_spv_no;
        mov rax, 1;
        ret;
      kgvm_spv_no:
        xor rax, rax;
        ret
      }
    }

  pub let kgvm_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R37.M4-001 (#1267): subset test against R_GPU_VM_ALL = 0x41B. R_MINT (0x200) is OUTSIDE the mask -- LEAF (§3). Labels prefixed kgvm_rgv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x41B;
        and rax, r10;
        cmp rax, rdi;
        jne kgvm_rgv_no;
        mov rax, 1;
        ret;
      kgvm_rgv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Counters.
  // ==========================================================================

  pub let kgvm_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M4-001 (#1267): counter bump. Labels prefixed kgvm_nt_.",
      block: {
        cmp rdi, 4;
        jae kgvm_nt_out;
        lea r10, [rip + _gpu_vm_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      kgvm_nt_out:
        ret
      }
    }

  pub let kgvm_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M4-001 (#1267): counter read. Labels prefixed kgvm_stt_.",
      block: {
        cmp rdi, 4;
        jae kgvm_stt_zero;
        lea r10, [rip + _gpu_vm_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      kgvm_stt_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Parent gate: live KIND_IPC_ENDPOINT (5) with RIGHT_MINT.
  // ==========================================================================

  pub let kgvm_check_parent : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R37.M4-001 (#1267): §1 gate. Parent must be live KIND_IPC_ENDPOINT (5) with RIGHT_MINT. Labels prefixed kgvm_cp_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae kgvm_cp_no;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 5;
        jne kgvm_cp_no;

        mov r10, [rax + 8];
        mov r11, 0x200;
        and r10, r11;
        cmp r10, 0;
        je  kgvm_cp_no;

        mov rax, 1;
        ret;
      kgvm_cp_no:
        xor rax, rax;
        ret
      }
    }

  pub let kgvm_parent_endpoint_id : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R37.M4-001 (#1267): read endpoint id from parent's target_ptr[15:0]. 0 on bad slot / wrong kind. Labels prefixed kgvm_pe_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae kgvm_pe_no;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 5;
        jne kgvm_pe_no;

        mov rax, [rax + 16];
        and rax, 0xFFFF;
        ret;
      kgvm_pe_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Header + body packers.
  // ==========================================================================

  pub let kgvm_hdr_pack : (u64) -> u64 !{} @{} =
    fn (parent_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R37.M4-001 (#1267): (parent_slot << 8). Labels prefixed kgvm_hp_.",
      block: {
        mov r10, 256;
        cmp rdi, r10;
        jae kgvm_hp_bad;
        mov rax, rdi;
        shl rax, 8;
        ret;
      kgvm_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let kgvm_body1_pack : (u64, u64, u64) -> u64 !{} @{} =
    fn (endpoint_slot: u64) (space_id: u64) (state: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R37.M4-001 (#1267): pack endpoint_slot[31:0] | space_id[47:32] | state[55:48]. Labels prefixed kgvm_b1_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  kgvm_b1_bad;
        mov r10, 0xFFFF;
        cmp rsi, r10;
        ja  kgvm_b1_bad;
        cmp rdx, 2;
        ja  kgvm_b1_bad;

        mov rax, rdi;
        and rax, 0xFFFFFFFF;
        mov r10, rsi;
        and r10, 0xFFFF;
        shl r10, 32;
        or  rax, r10;
        mov r10, rdx;
        and r10, 0xFF;
        shl r10, 48;
        or  rax, r10;
        ret;
      kgvm_b1_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // Tail alloc / valid / free -- THE ONE WRITER of _gpu_vm_table.
  // ==========================================================================

  pub let kgvm_tail_alloc : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (vm_key: u64) (body1: u64) (body2: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M4-001 (#1267): claim one GPU VM row. THE ONE WRITER of _gpu_vm_table. Gates: hdr in_use pre-set -> BAD_ARG; vm_key != 0 -> BAD_ARG; body1/body2 != DECODE_BAD -> BAD_ARG. Labels prefixed kgvm_ta_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov r15, rcx;

        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne kgvm_ta_bad;

        cmp r13, 0;
        je  kgvm_ta_bad;

        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp r14, r10;
        je  kgvm_ta_bad;

        xor rbx, rbx;
      kgvm_ta_scan:
        cmp rbx, 8;
        jae kgvm_ta_enospc;

        lea r10, [rip + _gpu_vm_table];
        mov r11, rbx;
        shl r11, 5;
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  kgvm_ta_claim;

        add rbx, 1;
        jmp kgvm_ta_scan;

      kgvm_ta_claim:
        mov rax, r12;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r13;
        mov [r10 + 16], r14;
        mov [r10 + 24], r15;
        mov rax, rbx;
        jmp kgvm_ta_out;

      kgvm_ta_enospc:
        mov rax, 0xFFFFF5FF;
        jmp kgvm_ta_out;
      kgvm_ta_bad:
        mov rax, 0xFFFFF5FE;

      kgvm_ta_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let kgvm_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M4-001 (#1267): 1 iff row_id < MAX and in_use. Labels prefixed kgvm_tvr_.",
      block: {
        cmp rdi, 8;
        jae kgvm_tvr_no;
        lea r10, [rip + _gpu_vm_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  kgvm_tvr_no;
        mov rax, 1;
        ret;
      kgvm_tvr_no:
        xor rax, rax;
        ret
      }
    }

  pub let kgvm_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M4-001 (#1267): scrub one row. Labels prefixed kgvm_tf_.",
      block: {
        cmp rdi, 8;
        jae kgvm_tf_out;
        lea r10, [rip + _gpu_vm_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
      kgvm_tf_out:
        ret
      }
    }

  // ==========================================================================
  // Row accessors.
  // ==========================================================================

  pub let kgvm_row_key : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M4-001 (#1267): vm_key. Labels prefixed kgvm_rk_.",
      block: {
        push r12;
        mov r12, rdi;
        call kgvm_tail_valid;
        cmp rax, 0;
        je  kgvm_rk_bad;
        lea r10, [rip + _gpu_vm_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 8];
        jmp kgvm_rk_out;
      kgvm_rk_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      kgvm_rk_out:
        pop r12;
        ret
      }
    }

  pub let kgvm_row_endpoint : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M4-001 (#1267): endpoint_slot (body1[31:0]). Labels prefixed kgvm_re_.",
      block: {
        push r12;
        mov r12, rdi;
        call kgvm_tail_valid;
        cmp rax, 0;
        je  kgvm_re_bad;
        lea r10, [rip + _gpu_vm_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        and rax, 0xFFFFFFFF;
        jmp kgvm_re_out;
      kgvm_re_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      kgvm_re_out:
        pop r12;
        ret
      }
    }

  pub let kgvm_row_space : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M4-001 (#1267): space_id (body1[47:32]). Labels prefixed kgvm_rsp_.",
      block: {
        push r12;
        mov r12, rdi;
        call kgvm_tail_valid;
        cmp rax, 0;
        je  kgvm_rsp_bad;
        lea r10, [rip + _gpu_vm_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 32;
        and rax, 0xFFFF;
        jmp kgvm_rsp_out;
      kgvm_rsp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      kgvm_rsp_out:
        pop r12;
        ret
      }
    }

  pub let kgvm_row_state : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M4-001 (#1267): state (body1[55:48]). Labels prefixed kgvm_rst_.",
      block: {
        push r12;
        mov r12, rdi;
        call kgvm_tail_valid;
        cmp rax, 0;
        je  kgvm_rst_bad;
        lea r10, [rip + _gpu_vm_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 48;
        and rax, 0xFF;
        jmp kgvm_rst_out;
      kgvm_rst_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      kgvm_rst_out:
        pop r12;
        ret
      }
    }

  pub let kgvm_row_pml4 : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M4-001 (#1267): pml4_pa (body2). Labels prefixed kgvm_rp_.",
      block: {
        push r12;
        mov r12, rdi;
        call kgvm_tail_valid;
        cmp rax, 0;
        je  kgvm_rp_bad;
        lea r10, [rip + _gpu_vm_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 24];
        jmp kgvm_rp_out;
      kgvm_rp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      kgvm_rp_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // kgvm_row_transition(row_id, new_state) — the ONE MUTATOR of the state
  // field.  ppgtt_walker moves NEW -> ACTIVE at first bind; revoke moves to
  // DYING.  Any other transition (e.g. ACTIVE -> NEW) is refused.
  // ==========================================================================

  pub let kgvm_row_transition : (u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64) (new_state: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M4-001 (#1267): mutate state field on one row. Only forward FSM edges are legal: NEW->ACTIVE, NEW->DYING, ACTIVE->DYING. Labels prefixed kgvm_rt_.",
      block: {
        push r12;
        push r13;

        mov r12, rdi;
        mov r13, rsi;

        mov rdi, r12;
        call kgvm_tail_valid;
        cmp rax, 0;
        je  kgvm_rt_bad;

        mov rdi, r13;
        call kgvm_state_valid;
        cmp rax, 0;
        je  kgvm_rt_bad;

        // Read current state.
        lea r10, [rip + _gpu_vm_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 48;
        and rax, 0xFF;

        // Legal edges: (0,1), (0,2), (1,2).  Anything else refused.
        cmp rax, 0;
        je  kgvm_rt_from0;
        cmp rax, 1;
        je  kgvm_rt_from1;
        jmp kgvm_rt_bad;
      kgvm_rt_from0:
        cmp r13, 0;
        je  kgvm_rt_bad;
        jmp kgvm_rt_apply;
      kgvm_rt_from1:
        cmp r13, 2;
        jne kgvm_rt_bad;

      kgvm_rt_apply:
        // Rewrite body1 with new state[55:48], preserving lower 48 bits.
        mov rax, [r10 + 16];
        mov r11, 0xFFFFFFFFFFFF;         // low 48 bits
        and rax, r11;
        mov r11, r13;
        and r11, 0xFF;
        shl r11, 48;
        or  rax, r11;
        mov [r10 + 16], rax;

        mov rdi, 2;                      // TRANSITIONS
        call kgvm_note;
        xor rax, rax;
        jmp kgvm_rt_out;

      kgvm_rt_bad:
        mov rax, 0xFFFFF5F1;             // BAD_TRANSITION
      kgvm_rt_out:
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Lookups.
  // ==========================================================================

  pub let kgvm_find_by_key : (u64) -> u64 !{mem} @{} =
    fn (vm_key: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R37.M4-001 (#1267): live row holding vm_key, or ROW_NONE. Refuses to match 0. Labels prefixed kgvm_fk_.",
      block: {
        cmp rdi, 0;
        je  kgvm_fk_none;
        xor rcx, rcx;
      kgvm_fk_scan:
        cmp rcx, 8;
        jae kgvm_fk_none;
        lea r10, [rip + _gpu_vm_table];
        mov r11, rcx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  kgvm_fk_next;
        mov rax, [r10 + 8];
        cmp rax, rdi;
        je  kgvm_fk_hit;
      kgvm_fk_next:
        add rcx, 1;
        jmp kgvm_fk_scan;
      kgvm_fk_hit:
        mov rax, rcx;
        ret;
      kgvm_fk_none:
        mov rax, 0xFF;
        ret
      }
    }

  pub let kgvm_row_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R37.M4-001 (#1267): slot -> row_id, gated on live KIND_GPU_VM. Labels prefixed kgvm_ros_.",
      block: {
        push r12;

        mov r11, 256;
        cmp rdi, r11;
        jae kgvm_ros_none;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x175;
        cmp r10, r11;
        jne kgvm_ros_none;

        mov r12, [rax + 16];
        mov r10, 0xFFFF;
        and r12, r10;

        mov rdi, r12;
        call kgvm_tail_valid;
        cmp rax, 0;
        je  kgvm_ros_none;

        mov rax, r12;
        jmp kgvm_ros_out;

      kgvm_ros_none:
        mov rax, 0xFF;
      kgvm_ros_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Mint. Five args (slot, parent_slot, rights, vm_key, packed_ss_pml4).
  //
  //   packed_ss_pml4 encoding:
  //     [15:0]  space_id
  //     [63:16] pml4_pa >> 12   (4K-aligned frame index)
  //
  //  Packing the last two arguments keeps the ABI within the paideia-as
  //  SysV pass ceiling matching the other minters in this tree.
  // ==========================================================================

  pub let gpu_vm_cap_mint_inner : (u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (vm_key: u64) (packed_ss_pml4: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R37.M4-001 (#1267): mint KIND_GPU_VM over KIND_IPC_ENDPOINT. LEAF -- rights_valid refuses R_MINT. Sequence: slot<256; check_parent; parent_endpoint_id non-zero (NO_ENDPOINT); rights_valid; space+pml4 unpack+validate; vm_key non-zero (NO_KEY); uniqueness (IN_USE); pack; tail_alloc; cap_mint_write. Labels prefixed kgvm_mi_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov rbx, rdi;                    // slot
        mov r12, rsi;                    // parent_slot
        mov r13, rdx;                    // rights
        mov r14, rcx;                    // vm_key
        mov rbp, r8;                     // packed_ss_pml4

        mov r10, 256;
        cmp rbx, r10;
        jae kgvm_mi_bad_slot;

        mov rdi, r12;
        call kgvm_check_parent;
        cmp rax, 0;
        je  kgvm_mi_bad_parent;

        mov rdi, r12;
        call kgvm_parent_endpoint_id;
        cmp rax, 0;
        je  kgvm_mi_no_endpoint;
        // (endpoint id inherited by parent but the ROW stores endpoint_
        // SLOT so a fanout path can drop back to the parent's descriptor
        // -- the id itself is derivable via kgvm_parent_endpoint_id if
        // needed and does not need a duplicate copy on the row.)

        mov rdi, r13;
        call kgvm_rights_valid;
        cmp rax, 0;
        je  kgvm_mi_bad_rights;

        // Unpack + validate space_id.
        mov rdi, rbp;
        and rdi, 0xFFFF;
        call kgvm_space_valid;
        cmp rax, 0;
        je  kgvm_mi_bad_space;

        // Unpack + validate pml4_pa (frame index -> byte address).
        mov r15, rbp;
        shr r15, 16;
        shl r15, 12;                     // pml4_pa
        mov rdi, r15;
        call kgvm_pml4_valid;
        cmp rax, 0;
        je  kgvm_mi_bad_root;

        cmp r14, 0;
        je  kgvm_mi_no_key;

        mov rdi, r14;
        call kgvm_find_by_key;
        cmp rax, 0xFF;
        jne kgvm_mi_in_use;

        // Body1 pack: (endpoint_slot=parent_slot, space_id, state=NEW).
        mov rdi, r12;
        mov rsi, rbp;
        and rsi, 0xFFFF;
        mov rdx, 0;                      // state = NEW
        call kgvm_body1_pack;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  kgvm_mi_bad_state;
        push rax;                        // body1
        sub rsp, 8;

        // Header.
        mov rdi, r12;
        call kgvm_hdr_pack;
        add rsp, 8;
        pop r11;                         // body1
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  kgvm_mi_bad_parent;

        // tail_alloc(hdr, vm_key, body1, body2=pml4_pa).
        mov rdi, rax;
        mov rsi, r14;
        mov rdx, r11;
        mov rcx, r15;
        call kgvm_tail_alloc;

        mov r10, 0xFFFFF5FF;
        cmp rax, r10;
        je  kgvm_mi_enospc;
        mov r10, 0xFFFFF5FE;
        cmp rax, r10;
        je  kgvm_mi_bad_state;

        mov r15, rax;                    // row_id
        mov r11, rbx;
        shl r11, 16;
        or  r15, r11;

        mov rdi, rbx;
        mov rsi, 0x175;
        mov rdx, r13;
        mov rcx, r15;
        call cap_mint_write;

        mov rdi, 0;
        call kgvm_note;

        xor rax, rax;
        jmp kgvm_mi_out;

      kgvm_mi_bad_slot:
        mov rax, 0xFFFFF5F4;
        jmp kgvm_mi_out;
      kgvm_mi_bad_parent:
        mov rax, 0xFFFFF5FD;
        jmp kgvm_mi_out;
      kgvm_mi_bad_rights:
        mov rax, 0xFFFFF5FC;
        jmp kgvm_mi_out;
      kgvm_mi_bad_root:
        mov rax, 0xFFFFF5FB;
        jmp kgvm_mi_out;
      kgvm_mi_bad_space:
        mov rax, 0xFFFFF5FA;
        jmp kgvm_mi_out;
      kgvm_mi_bad_state:
        mov rax, 0xFFFFF5F9;
        jmp kgvm_mi_out;
      kgvm_mi_no_endpoint:
        mov rax, 0xFFFFF5F8;
        jmp kgvm_mi_out;
      kgvm_mi_no_key:
        mov rax, 0xFFFFF5F7;
        jmp kgvm_mi_out;
      kgvm_mi_in_use:
        mov rdi, 3;
        call kgvm_note;
        mov rax, 0xFFFFF5F5;
        jmp kgvm_mi_out;
      kgvm_mi_enospc:
        mov rdi, 3;
        call kgvm_note;
        mov rax, 0xFFFFF5F6;

      kgvm_mi_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let gpu_vm_cap_mint : (u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (vm_key: u64) (packed_ss_pml4: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R37.M4-001 (#1267): audited mint.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;
        mov r13, rsi;

        call gpu_vm_cap_mint_inner;
        mov r14, rax;

        mov rdi, 1;
        mov rsi, 0x175;
        mov rdx, r12;
        mov rcx, r13;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Revoke.  Advances state to DYING before scrubbing so consumers that
  // observe the row mid-revoke see the drain marker.
  // ==========================================================================

  pub let gpu_vm_cap_revoke_inner : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R37.M4-001 (#1267): revoke KIND_GPU_VM. Labels prefixed kgvm_rvk_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rdi;

        mov r10, 256;
        cmp r12, r10;
        jae kgvm_rvk_bad_slot;

        mov rax, cap_table;
        mov r8, r12;
        shl r8, 3;
        mov r9, r12;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov rbx, rax;

        mov r10, [rbx + 0];
        cmp r10, 0;
        je  kgvm_rvk_already;

        mov r11, 0x175;
        cmp r10, r11;
        jne kgvm_rvk_wrong_kind;

        mov r13, [rbx + 16];
        mov r10, 0xFFFF;
        and r13, r10;

        mov rdi, r13;
        call kgvm_tail_valid;
        cmp rax, 0;
        je  kgvm_rvk_clear;

        // Advance to DYING (ignore transition failure -- may already be
        // DYING if a prior revoke raced to the row).
        mov rdi, r13;
        mov rsi, 2;                      // DYING
        call kgvm_row_transition;

        mov rdi, r13;
        call kgvm_tail_free;

      kgvm_rvk_clear:
        mov rdi, r12;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        mov rdi, 1;
        call kgvm_note;

        xor rax, rax;
        jmp kgvm_rvk_out;

      kgvm_rvk_bad_slot:
        mov rax, 0xFFFFF5F4;
        jmp kgvm_rvk_out;
      kgvm_rvk_wrong_kind:
        mov rax, 0xFFFFF5F3;
        jmp kgvm_rvk_out;
      kgvm_rvk_already:
        mov rax, 0xFFFFF5F2;

      kgvm_rvk_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let gpu_vm_cap_revoke : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R37.M4-001 (#1267): audited revoke.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;

        call gpu_vm_cap_revoke_inner;
        mov r14, rax;

        mov rdi, 2;
        mov rsi, 0x175;
        mov rdx, r12;
        mov rcx, r12;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Dispatch handler.  Queries only.
  // ==========================================================================

  pub let cap_handler_gpu_vm : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R37.M4-001 (#1267): KIND_GPU_VM dispatch. Query ops require INVOKE; DEBUG_PRINT requires OBSERVE. All ops arity ONE -- op_arg[63:8] REFUSED. Labels prefixed kgvm_hn_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push rbp;

        mov r12, rdi;
        mov r13, rsi;
        mov r10, 0xFFFF;
        and r13, r10;
        mov r14, rdx;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_gpu_vm_msg];
        call klog_s1;

        mov r10, r14;
        and r10, 0xFF;
        mov rbp, r10;
        mov r11, r14;
        shr r11, 8;
        cmp r11, 0;
        jne kgvm_hn_res;

        cmp rbp, 5;
        ja  kgvm_hn_unsup;

        cmp rbp, 5;
        je  kgvm_hn_dbg;

        // Ops 0..4: INVOKE.
        mov r10, r12;
        and r10, 0x008;
        cmp r10, 0;
        je  kgvm_hn_denied;

        mov rdi, r13;
        cmp rbp, 0;
        je  kgvm_hn_key;
        cmp rbp, 1;
        je  kgvm_hn_ep;
        cmp rbp, 2;
        je  kgvm_hn_p4;
        cmp rbp, 3;
        je  kgvm_hn_sp;
        call kgvm_row_state;
        jmp kgvm_hn_out;

      kgvm_hn_key:
        call kgvm_row_key;
        jmp kgvm_hn_out;
      kgvm_hn_ep:
        call kgvm_row_endpoint;
        jmp kgvm_hn_out;
      kgvm_hn_p4:
        call kgvm_row_pml4;
        jmp kgvm_hn_out;
      kgvm_hn_sp:
        call kgvm_row_space;
        jmp kgvm_hn_out;

      kgvm_hn_dbg:
        mov r10, r12;
        and r10, 0x400;
        cmp r10, 0;
        je  kgvm_hn_denied;
        xor rax, rax;
        jmp kgvm_hn_out;

      kgvm_hn_res:
        mov rax, 0xFFFFF5FE;
        jmp kgvm_hn_out;
      kgvm_hn_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;
        jmp kgvm_hn_out;
      kgvm_hn_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;

      kgvm_hn_out:
        pop rbp;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
