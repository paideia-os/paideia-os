// src/kernel/core/cap/kind_hotplug_channel.pdx -- R105.M4-001
//
// KIND_HOTPLUG_CHANNEL = 0x1B1, derived over KIND_IPC_ENDPOINT (= 5).
//
// A compositor holds one KIND_HOTPLUG_CHANNEL over an IPC endpoint it
// created; the R36 HPD ISR (drivers/dpy/hpd_isr.pdx) fans display-
// connect / disconnect events into that endpoint via the delivery
// primitive hotplug_channel_deliver.
//
// Per design/graphics/r101-kernel-plan.md §R105.M4 (2026-09-01): "how
// does the compositor learn about external-display connect/disconnect
// events without polling?" -- this cap is the answer, and
// sys_display_hotplug_subscribe (sysno 113) is its userland surface.
//
// =============================================================================
// SECTION 0  WHY KIND_HOTPLUG_CHANNEL DERIVES OVER KIND_IPC_ENDPOINT
// =============================================================================
//
// The channel authority IS the endpoint an event lands on. Deriving over
// KIND_IPC_ENDPOINT captures that: mint requires an existing endpoint
// with RIGHT_MINT, and the row's port_slot names the endpoint id inside
// the endpoint table. Matches KIND_HID_EVENT (0x191) precedent one-for-
// one -- both are ISR-fanned event streams over a userland endpoint.
//
// =============================================================================
// SECTION 1  TAIL ENCODING -- 32 BYTES (four u64 words)
// =============================================================================
//
//   [+0]  header (u64):
//         in_use   [63:56]   allocator flag (0=free, 1=live)
//         reserved [55:16]
//         mask     [15:0]    event-class subscription mask
//                            0x01 = HPCH_EV_CONNECT
//                            0x02 = HPCH_EV_DISCONNECT
//                            0x04 = HPCH_EV_MODE_CHANGE
//                            HPCH_MASK_ALL = 0x07
//   [+8]  port_slot   (u64)  endpoint_id (0..127) the ISR delivers into
//   [+16] delivered   (u64)  monotonic count of events published
//   [+24] owner_pid   (u64)  compositor pid holding this channel
//
// Row-addressed capacity: HPCH_MAX = 4 rows. Rationale: one compositor
// per system at R105; the extra rows cover a compositor-restart handoff
// and a supervisor witness. 4 * 32 = 128 bytes = 16 u64.
//
// =============================================================================
// SECTION 2  RIGHTS
// =============================================================================
//
//   R_HPCH_SUBSCRIBE (0x001) -- authority to attach and receive events.
//   R_HPCH_REVOKE    (0x002) -- authority to tear down the row.
//   R_HPCH_ALL       (0x003)
//
// =============================================================================
// SECTION 3  FAILURE TAXONOMY  0xFFFFEB60..0xFFFFEB6F
// =============================================================================
//
// Landing-time audit: 0xFFFFEB60..0xFFFFEB6F entirely free (disjoint
// from KIND_FRAMEBUFFER 0xFFFFEB40..4F, KIND_PAGE_FLIP 0xFFFFEB50..5F).
//
// =============================================================================
// SECTION 4  ENCODER DISCIPLINE
// =============================================================================
//
// Kind-tag 0x1B1 stages through r11 for `cmp reg, imm`. Row fields are
// full u64 words; no mov_b/w/d for row loads. No `test`, no
// `add reg, [mem]`, no `cmp reg, [mem]`. Labels prefixed `hpch_`.

module KindHotplugChannel = structure {

  pub let KIND_HOTPLUG_CHANNEL      : u64 = 0x1B1
  pub let KIND_HOTPLUG_CHANNEL_BASE : u64 = 5         // = KIND_IPC_ENDPOINT

  // Event classes (§1 mask field).
  pub let HPCH_EV_CONNECT     : u64 = 0x01
  pub let HPCH_EV_DISCONNECT  : u64 = 0x02
  pub let HPCH_EV_MODE_CHANGE : u64 = 0x04
  pub let HPCH_MASK_ALL       : u64 = 0x07

  // Rights (§2).
  pub let R_HPCH_SUBSCRIBE : u64 = 0x001
  pub let R_HPCH_REVOKE    : u64 = 0x002
  pub let R_HPCH_ALL       : u64 = 0x003

  // Ops (query surface; deliver is kernel-internal).
  pub let HPCH_OP_QUERY_MASK      : u64 = 0
  pub let HPCH_OP_QUERY_DELIVERED : u64 = 1
  pub let HPCH_OP_SET_MASK        : u64 = 2
  pub let HPCH_OP_MAX             : u64 = 2

  // Failure taxonomy (§3). 0xFFFFEB60..0xFFFFEB6F band.
  pub let HPCH_OK              : u64 = 0
  pub let HPCH_MINT_BAD_PORT   : u64 = 0xFFFFEB6F
  pub let HPCH_MINT_BAD_MASK   : u64 = 0xFFFFEB6E
  pub let HPCH_MINT_BAD_RIGHTS : u64 = 0xFFFFEB6D
  pub let HPCH_TAIL_BAD_ARG    : u64 = 0xFFFFEB6C
  pub let HPCH_TAIL_ENOSPC     : u64 = 0xFFFFEB6B
  pub let HPCH_BAD_SLOT        : u64 = 0xFFFFEB6A

  pub let HPCH_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let HPCH_ROW_NONE   : u64 = 0xFF

  // Ceilings.
  pub let HPCH_MAX       : u64 = 4
  pub let HPCH_ROW_BYTES : u64 = 32

  // 4 rows * 32 bytes = 128 bytes = 16 u64.
  pub let mut _hpch_table : [u64; 16] = uninit @align(64)
  pub let mut _hpch_stats : [u64; 4]  = uninit @align(32)

  pub let HPCH_ST_MINTS     : u64 = 0
  pub let HPCH_ST_DELIVERED : u64 = 1
  pub let HPCH_ST_REFUSED   : u64 = 2

  // Fingerprint (all-lowercase, no OK_TOK). NUL-terminated.
  pub let hpch_mint_ok_msg : [u8; 29] = "r105 hotplug channel mint ok\0"

  // ==========================================================================
  // hpch_table_reset() -> ()
  // ==========================================================================
  pub let hpch_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R105.M4-001: clear every _hpch_table row + counters. Boot and teardown. .bss zero at real boot; defensive re-scrub. Mirrors dpyb_table_reset one-for-one. Labels prefixed hpch_rs_.",
      block: {
        lea r10, [rip + _hpch_table];
        xor rax, rax;
        xor rcx, rcx;
      hpch_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 16;
        jb  hpch_rs_rows;

        lea r10, [rip + _hpch_stats];
        xor rcx, rcx;
      hpch_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  hpch_rs_stats;
        ret
      }
    }

  pub let hpch_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R105.M4-001: bounded stats increment; OOR no-op. Load-inc-store idiom. Labels prefixed hpch_nt_.",
      block: {
        cmp rdi, 4;
        jae hpch_nt_out;
        lea r10, [rip + _hpch_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      hpch_nt_out:
        ret
      }
    }

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let hpch_mask_valid : (u64) -> u64 !{} @{} =
    fn (m: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R105.M4-001: 1 iff m != 0 and m subset HPCH_MASK_ALL (0x07). Empty mask refused. Labels prefixed hpch_mv_.",
      block: {
        cmp rdi, 0;
        je  hpch_mv_no;
        mov rax, rdi;
        mov r10, 0x07;
        and rax, r10;
        cmp rax, rdi;
        jne hpch_mv_no;
        mov rax, 1;
        ret;
      hpch_mv_no:
        xor rax, rax;
        ret
      }
    }

  pub let hpch_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R105.M4-001: subset test against R_HPCH_ALL = 0x003. Labels prefixed hpch_rv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x003;
        and rax, r10;
        cmp rax, rdi;
        jne hpch_rv_no;
        mov rax, 1;
        ret;
      hpch_rv_no:
        xor rax, rax;
        ret
      }
    }

  // hpch_check_endpoint(endpoint_id) -> 1 iff endpoint_id < 128 and the
  // endpoint slot is live (defensive: we accept the raw id since the
  // parent-endpoint mint typically pre-verifies).
  pub let hpch_check_endpoint : (u64) -> u64 !{} @{} =
    fn (ep_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R105.M4-001: bounds ep_id < 128 (ENDPOINT_ID_MAX). Deep liveness lives in the caller's parent cap gate; this is a lightweight numeric bound. Labels prefixed hpch_ce_.",
      block: {
        cmp rdi, 128;
        jae hpch_ce_no;
        mov rax, 1;
        ret;
      hpch_ce_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Row pool.
  // ==========================================================================

  pub let hpch_row_valid : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R105.M4-001: 1 iff idx < HPCH_MAX(4) and in_use bit set. Address compute via idx*32 (shl 5). Labels prefixed hpch_rv2_.",
      block: {
        mov r10, 4;
        cmp rdi, r10;
        jae hpch_rv2_no;
        lea r10, [rip + _hpch_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  hpch_rv2_no;
        mov rax, 1;
        ret;
      hpch_rv2_no:
        xor rax, rax;
        ret
      }
    }

  pub let hpch_row_addr : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R105.M4-001: &_hpch_table[idx*32]. Caller validates idx first. Labels prefixed hpch_ra_.",
      block: {
        lea rax, [rip + _hpch_table];
        mov r10, rdi;
        shl r10, 5;
        add rax, r10;
        ret
      }
    }

  // hpch_hdr_pack(mask) -> hdr | HPCH_DECODE_BAD.
  pub let hpch_hdr_pack : (u64) -> u64 !{} @{} =
    fn (mask: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R105.M4-001: pack mask into hdr[15:0]. Empty mask refused. Labels prefixed hpch_hp_.",
      block: {
        cmp rdi, 0;
        je  hpch_hp_bad;
        mov r10, 0x07;
        mov rax, rdi;
        and rax, r10;
        cmp rax, rdi;
        jne hpch_hp_bad;
        mov rax, rdi;
        ret;
      hpch_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // hpch_tail_alloc(hdr, port_slot, owner_pid) -> row_id | HPCH_TAIL_*.
  pub let hpch_tail_alloc : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (port_slot: u64) (owner_pid: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R105.M4-001: claim one HPCH row. hdr in_use pre-set refused -> HPCH_TAIL_BAD_ARG. Low-first scan; writes tail first, header last. 3 callee-save pushes for the three args. Labels prefixed hpch_ta_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                    // hdr
        mov r12, rsi;                    // port_slot
        mov r13, rdx;                    // owner_pid

        mov rax, rbx;
        shr rax, 56;
        cmp rax, 0;
        jne hpch_ta_bad;

        xor rcx, rcx;
      hpch_ta_scan:
        cmp rcx, 4;
        jae hpch_ta_enospc;

        lea r10, [rip + _hpch_table];
        mov r11, rcx;
        shl r11, 5;
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  hpch_ta_claim;

        add rcx, 1;
        jmp hpch_ta_scan;

      hpch_ta_claim:
        mov [r10 + 8],  r12;             // port_slot
        xor rax, rax;
        mov [r10 + 16], rax;             // delivered = 0
        mov [r10 + 24], r13;             // owner_pid

        mov rax, rbx;                    // hdr
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0], rax;              // header last

        mov rax, rcx;
        jmp hpch_ta_out;

      hpch_ta_enospc:
        mov rax, 0xFFFFEB6B;             // HPCH_TAIL_ENOSPC
        jmp hpch_ta_out;
      hpch_ta_bad:
        mov rax, 0xFFFFEB6C;             // HPCH_TAIL_BAD_ARG

      hpch_ta_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let hpch_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R105.M4-001: scrub one HPCH row (four u64 words). Labels prefixed hpch_tf_.",
      block: {
        mov r10, 4;
        cmp rdi, r10;
        jae hpch_tf_out;
        lea r10, [rip + _hpch_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
      hpch_tf_out:
        ret
      }
    }

  // hpch_row_port(idx) -> port_slot | HPCH_DECODE_BAD.
  pub let hpch_row_port : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R105.M4-001: read port_slot from row[+8]. Labels prefixed hpch_rp_.",
      block: {
        push rbx;
        mov rbx, rdi;
        call hpch_row_valid;
        cmp rax, 0;
        je  hpch_rp_bad;
        mov rdi, rbx;
        call hpch_row_addr;
        mov r10, rax;
        mov rax, [r10 + 8];
        pop rbx;
        ret;
      hpch_rp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        pop rbx;
        ret
      }
    }

  pub let hpch_row_mask : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R105.M4-001: read mask from row[+0][15:0]. Labels prefixed hpch_rm_.",
      block: {
        push rbx;
        mov rbx, rdi;
        call hpch_row_valid;
        cmp rax, 0;
        je  hpch_rm_bad;
        mov rdi, rbx;
        call hpch_row_addr;
        mov r10, rax;
        mov rax, [r10 + 0];
        and rax, 0xFFFF;
        pop rbx;
        ret;
      hpch_rm_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        pop rbx;
        ret
      }
    }

  pub let hpch_row_delivered : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R105.M4-001: read delivered counter from row[+16]. Labels prefixed hpch_rd_.",
      block: {
        push rbx;
        mov rbx, rdi;
        call hpch_row_valid;
        cmp rax, 0;
        je  hpch_rd_bad;
        mov rdi, rbx;
        call hpch_row_addr;
        mov r10, rax;
        mov rax, [r10 + 16];
        pop rbx;
        ret;
      hpch_rd_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // kind_hotplug_channel_mint_body(endpoint_id, rights, mask, owner_pid)
  //   -> row_id | HPCH_MINT_*
  //
  // paideia-as SysV caps register args at 6; four args fit.
  // ==========================================================================
  pub let kind_hotplug_channel_mint_body : (u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (endpoint_id: u64) (rights: u64) (mask: u64) (owner_pid: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R105.M4-001: mint KIND_HOTPLUG_CHANNEL. Gate order: (1) endpoint_id via hpch_check_endpoint; (2) rights via hpch_rights_valid; (3) mask via hpch_mask_valid; (4) hdr pack; (5) tail_alloc. On success emits mint fingerprint. Register plan: rbx=endpoint_id (survives every nested call; reused for row_id at the end), r12=rights, r13=mask, r14=owner_pid, rbp=hdr (set after hpch_hdr_pack; survives tail_alloc). Five callee-save pushes (rbx, rbp, r12, r13, r14) leave rsp%16==0 given entry %16==8 (5*8+8=48). Labels prefixed hpch_mb_.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        push r14;

        mov rbx, rdi;                    // endpoint_id (survives)
        mov r12, rsi;                    // rights
        mov r13, rdx;                    // mask
        mov r14, rcx;                    // owner_pid

        // Gate 1: endpoint_id
        mov rdi, rbx;
        call hpch_check_endpoint;
        cmp rax, 0;
        je  hpch_mb_bad_port;

        // Gate 2: rights
        mov rdi, r12;
        call hpch_rights_valid;
        cmp rax, 0;
        je  hpch_mb_bad_rights;

        // Gate 3: mask
        mov rdi, r13;
        call hpch_mask_valid;
        cmp rax, 0;
        je  hpch_mb_bad_mask;

        // Header pack.
        mov rdi, r13;
        call hpch_hdr_pack;
        mov rbp, rax;                    // rbp = hdr (survives)

        // Tail alloc: (hdr, port_slot=endpoint_id, owner_pid).
        mov rdi, rbp;
        mov rsi, rbx;                    // port_slot = endpoint_id
        mov rdx, r14;                    // owner_pid
        call hpch_tail_alloc;

        mov r10, 4;
        cmp rax, r10;
        jae hpch_mb_refused;

        mov rbx, rax;                    // rbx = row_id (final)

        mov rdi, 0;                      // HPCH_ST_MINTS
        call hpch_note;

        // Fingerprint.
        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + hpch_mint_ok_msg];
        lea rcx, [rip + k_row];
        mov r8, rbx;
        call klog_s1_d1;

        mov rax, rbx;
        jmp hpch_mb_out;

      hpch_mb_bad_port:
        mov rax, 0xFFFFEB6F;             // HPCH_MINT_BAD_PORT
        jmp hpch_mb_refused;
      hpch_mb_bad_rights:
        mov rax, 0xFFFFEB6D;             // HPCH_MINT_BAD_RIGHTS
        jmp hpch_mb_refused;
      hpch_mb_bad_mask:
        mov rax, 0xFFFFEB6E;             // HPCH_MINT_BAD_MASK

      hpch_mb_refused:
        push rax;
        mov rdi, 2;                      // HPCH_ST_REFUSED
        call hpch_note;
        pop rax;

      hpch_mb_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret
      }
    }

  pub let kind_hotplug_channel_revoke_body : (u64) -> u64 !{mem} @{cap} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R105.M4-001: revoke HPCH row. Bounds + in_use gate; else tail_free + return 0. Labels prefixed hpch_rb_.",
      block: {
        push r12;
        mov r12, rdi;

        mov r10, 4;
        cmp r12, r10;
        jae hpch_rb_bad_slot;

        mov rdi, r12;
        call hpch_row_valid;
        cmp rax, 0;
        je  hpch_rb_bad_slot;

        mov rdi, r12;
        call hpch_tail_free;
        xor rax, rax;
        jmp hpch_rb_out;

      hpch_rb_bad_slot:
        mov rax, 0xFFFFEB6A;             // HPCH_BAD_SLOT

      hpch_rb_out:
        pop r12;
        ret
      }
    }

  // hotplug_channel_deliver(event_class) -> u64
  //
  // Fan a display hotplug event into every live HPCH row whose mask
  // covers `event_class`. Returns the number of rows delivered to.
  //
  // Called from the HPD ISR (drivers/dpy/hpd_isr.pdx) when a real
  // vblank-adjacent HPD flag flips, and from any simulated-hotplug
  // witness. `event_class` MUST be exactly one of HPCH_EV_* (single
  // bit); a mask with multiple bits set is treated as "any of these"
  // for gate purposes but is not idiomatic.
  //
  // Delivery bumps the row's `delivered` counter; a real endpoint
  // enqueue against the row's port_slot is DEFERRED to R106 (needs a
  // fixed-payload event-record shape not defined in this landing). The
  // counter is the visible-effect the witness asserts against.
  pub let hotplug_channel_deliver : (u64) -> u64 !{mem} @{} =
    fn (event_class: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R105.M4-001: scan _hpch_table for live rows whose mask covers event_class; bump the row's delivered counter for each match. Returns the count of matches so a caller (ISR or witness) can see whether any subscriber existed. Two callee-save pushes for the row cursor + hit counter. Labels prefixed hpch_dl_.",
      block: {
        push rbx;
        push r12;

        mov rbx, rdi;                    // event_class
        xor r12, r12;                    // hits = 0

        xor rcx, rcx;                    // row idx = 0
      hpch_dl_scan:
        cmp rcx, 4;
        jae hpch_dl_done;

        lea r10, [rip + _hpch_table];
        mov r11, rcx;
        shl r11, 5;
        add r10, r11;

        mov rax, [r10 + 0];
        mov r8, rax;
        shr r8, 56;
        cmp r8, 0;
        je  hpch_dl_next;                // row free -> skip

        // mask & event_class ?
        mov r8, rax;
        and r8, 0xFFFF;                  // row mask
        and r8, rbx;                     // AND with event_class
        cmp r8, 0;
        je  hpch_dl_next;

        // Bump delivered counter.
        mov rax, [r10 + 16];
        add rax, 1;
        mov [r10 + 16], rax;

        add r12, 1;                      // hits++

      hpch_dl_next:
        add rcx, 1;
        jmp hpch_dl_scan;

      hpch_dl_done:
        // Bump global HPCH_ST_DELIVERED once if any hit landed.
        cmp r12, 0;
        je  hpch_dl_out;
        mov rdi, 1;                      // HPCH_ST_DELIVERED
        call hpch_note;

      hpch_dl_out:
        mov rax, r12;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let kind_hotplug_channel_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R105.M4-001: boot-time defensive re-scrub. .bss zero at real boot. Zero args, no push/pop.",
      block: {
        call hpch_table_reset;
        ret
      }
    }
}
