// src/kernel/core/cap/kind_fp_sensor.pdx — R34.M6-001 (#1194)
//
// KIND_FP_SENSOR = 0x16A, derived over KIND_DEVICE (10).
//
// The authority to hold ONE USB fingerprint sensor's static identity
// — its inherited sensor_key (a fresh identity supplied by the class
// driver at bind), the cap_table slot of its parent KIND_DEVICE
// (device_slot), the USB vendor and product id, the sensor kind
// (area / swipe), the sensor's declared resolution in DPI, and its
// current enrollment_state.
//
// =============================================================================
// §0  WHY THIS KIND EXISTS
// =============================================================================
//
// A fingerprint sensor is not addressed like a mass-storage LUN. Two
// vendors (Goodix 0x27C6, Synaptics 0x06CB) ship almost every part in
// this class, and their command protocols are entirely different —
// there is no BOT / UAS discipline that all fingerprint sensors
// agree on. The vendor-agnostic surface lives in
// drivers/usb/fp/fp_class.pdx; every command reaching the wire must
// carry a capability naming the specific part that is enrolled or
// verified against, because a template captured on ONE sensor cannot
// be verified against another and a driver that mistook sensor A's
// bulk-in for sensor B's would either return NO_MATCH indefinitely
// (privacy-preserving) or MATCH on a template that was never enrolled
// (a security failure).
//
// =============================================================================
// §1  DERIVATION OVER KIND_DEVICE
// =============================================================================
//
// The gate demands `kind == KIND_DEVICE (10)` carrying `RIGHT_MINT`.
// Like KIND_HID_DEVICE, KIND_BATTERY and every other KIND_DEVICE-
// derived kind, THE KIND HALF OF THE GATE DISCRIMINATES NOTHING on
// its own — every PCI (or USB) function in the machine is a
// KIND_DEVICE — so the mint additionally requires:
//
//   (a) sensor_key non-zero and unique among live rows (NO_KEY / IN_USE)
//   (b) device_slot names a live KIND_DEVICE with RIGHT_MINT
//       (NO_DEVICE); its identity is INHERITED from the parent's
//       target_ptr rather than accepted as an argument
//   (c) vendor_id in the accepted small set (0x27C6 Goodix, 0x06CB
//       Synaptics, or 0 for a bring-up placeholder) — BAD_VENDOR
//   (d) sensor_type in {FP_TYPE_AREA, FP_TYPE_SWIPE} — BAD_TYPE
//   (e) resolution_dpi in [FP_DPI_MIN, FP_DPI_MAX] — BAD_DPI
//   (f) rights subset of R_FP_SENSOR_ALL
//
// =============================================================================
// §2  ENROLLMENT_STATE IS THE ONE DYNAMIC FIELD
// =============================================================================
//
// sensor_key, device_slot, vendor_id, product_id, sensor_type and
// resolution_dpi are ROW IDENTITY. enrollment_state is dynamic — it
// moves through {IDLE, ENROLLING, ENROLLED} as the class driver
// negotiates template capture — but the transition primitive is not
// on this kind: kind_fp_sensor exposes only ROW ACCESSORS and a
// COUNTER; the state machine lives in fp_class.pdx. This kind is the
// SUBSTRATE of authority.
//
// =============================================================================
// §3  LEAF OF THE FP LATTICE
// =============================================================================
//
// R_FP_SENSOR_MINT (0x200) is DELIBERATELY ABSENT from
// R_FP_SENSOR_ALL: nothing derives from an fp-sensor cap in this
// milestone. Same discipline KIND_USB_ENDPOINT / KIND_USB_URB /
// KIND_ISOCH_STREAM applied for the same reason.
//
// =============================================================================
// §4  FAILURE TAXONOMY 0xFFFFFA80..0xFFFFFA8F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent free bands: fp_class 0xFFFFFA70..7F,
// fp_capture_channel 0xFFFFFA60..6F, goodix 0xFFFFFA50..5F, synaptics
// 0xFFFFFA40..4F; adjacent used band above: uvc_synth 0xFFFFFA90..9F).

module KindFpSensor = structure {

  pub let KIND_FP_SENSOR         : u64 = 0x16A
  pub let FP_SENSOR_PARENT_KIND  : u64 = 10          // = KIND_DEVICE

  // Vendor ids the mint accepts. 0 is bring-up only (permitted so the
  // witness can drive the mint without teaching it a real vendor id).
  pub let FP_VENDOR_GOODIX    : u64 = 0x27C6
  pub let FP_VENDOR_SYNAPTICS : u64 = 0x06CB

  // Sensor type ordinals.
  pub let FP_TYPE_UNKNOWN : u64 = 0
  pub let FP_TYPE_AREA    : u64 = 1
  pub let FP_TYPE_SWIPE   : u64 = 2
  pub let FP_TYPE_MAX     : u64 = 2

  // Resolution bounds (dots per inch). 100 dpi below the coarsest
  // shipping part; 2000 dpi above the finest.
  pub let FP_DPI_MIN : u64 = 100
  pub let FP_DPI_MAX : u64 = 2000

  // Enrollment state ordinals.
  pub let FP_ENROLL_IDLE      : u64 = 0
  pub let FP_ENROLL_ENROLLING : u64 = 1
  pub let FP_ENROLL_ENROLLED  : u64 = 2
  pub let FP_ENROLL_MAX       : u64 = 2

  // Rights. Leaf: RIGHT_MINT NOT in the mask (§3).
  pub let R_FP_SENSOR_READ    : u64 = 0x001
  pub let R_FP_SENSOR_INVOKE  : u64 = 0x008
  pub let R_FP_SENSOR_REVOKE  : u64 = 0x010
  pub let R_FP_SENSOR_OBSERVE : u64 = 0x400
  pub let R_FP_SENSOR_ALL     : u64 = 0x419

  // Ops.
  pub let FP_OP_QUERY_KEY        : u64 = 0
  pub let FP_OP_QUERY_DEVICE     : u64 = 1
  pub let FP_OP_QUERY_VENDOR     : u64 = 2
  pub let FP_OP_QUERY_PRODUCT    : u64 = 3
  pub let FP_OP_QUERY_TYPE       : u64 = 4
  pub let FP_OP_QUERY_DPI        : u64 = 5
  pub let FP_OP_QUERY_ENROLL     : u64 = 6
  pub let FP_OP_QUERY_PARENT     : u64 = 7
  pub let FP_OP_DEBUG_PRINT      : u64 = 8
  pub let FP_OP_MAX              : u64 = 8

  // Failure taxonomy — 0xFFFFFA80..0xFFFFFA8F.
  pub let FP_OK                 : u64 = 0
  pub let FP_TAIL_ENOSPC        : u64 = 0xFFFFFA8F
  pub let FP_TAIL_BAD_ARG       : u64 = 0xFFFFFA8E
  pub let FP_MINT_BAD_PARENT    : u64 = 0xFFFFFA8D
  pub let FP_MINT_BAD_RIGHTS    : u64 = 0xFFFFFA8C
  pub let FP_MINT_BAD_VENDOR    : u64 = 0xFFFFFA8B
  pub let FP_MINT_BAD_TYPE      : u64 = 0xFFFFFA8A
  pub let FP_MINT_BAD_DPI       : u64 = 0xFFFFFA89
  pub let FP_MINT_NO_DEVICE     : u64 = 0xFFFFFA88
  pub let FP_MINT_NO_KEY        : u64 = 0xFFFFFA87
  pub let FP_MINT_ENOSPC        : u64 = 0xFFFFFA86
  pub let FP_MINT_IN_USE        : u64 = 0xFFFFFA85
  pub let FP_BAD_SLOT           : u64 = 0xFFFFFA84
  pub let FP_WRONG_KIND         : u64 = 0xFFFFFA83
  pub let FP_REVOKE_ALREADY     : u64 = 0xFFFFFA82

  pub let FP_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let FP_ROW_NONE   : u64 = 0xFF

  // 8 rows, 32-byte stride.
  //   [+0]  header (in_use[63:56] | parent_slot[15:8])
  //   [+8]  sensor_key
  //   [+16] body word 1: device_slot[31:0] | vendor_id[47:32]
  //                     | product_id[63:48]
  //   [+24] body word 2: sensor_type[7:0] | resolution_dpi[23:8]
  //                     | enrollment_state[31:24] | reserved[63:32]
  pub let FP_SENSOR_MAX       : u64 = 8
  pub let FP_SENSOR_ROW_BYTES : u64 = 32

  pub let mut _fp_sensor_table : [u64; 32] = uninit @align(64)
  pub let mut _fp_sensor_stats : [u64; 4]  = uninit @align(64)

  pub let FP_ST_MINTS   : u64 = 0
  pub let FP_ST_REVOKES : u64 = 1
  pub let FP_ST_IN_USE  : u64 = 2
  pub let FP_ST_ENOSPC  : u64 = 3

  pub let fp_dbg_msg : [u8; 14] = "FP SENSOR ROW\0"

  // ==========================================================================
  // Table reset.
  // ==========================================================================

  pub let fp_sensor_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M6-001 (#1194): clear the FP SENSOR row table and its counters. Boot and teardown only. Labels prefixed fp_rs_.",
      block: {
        lea r10, [rip + _fp_sensor_table];
        xor rax, rax;
        xor rcx, rcx;
      fp_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  fp_rs_rows;

        lea r10, [rip + _fp_sensor_stats];
        xor rcx, rcx;
      fp_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  fp_rs_stats;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let fp_sensor_vendor_valid : (u64) -> u64 !{} @{} =
    fn (v: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M6-001 (#1194): 1 iff v in {0, 0x27C6 Goodix, 0x06CB Synaptics}. 0 is a bring-up placeholder for a witness that does not yet name a real vendor. Labels prefixed fp_vv_.",
      block: {
        cmp rdi, 0;
        je  fp_vv_yes;
        cmp rdi, 0x27C6;
        je  fp_vv_yes;
        cmp rdi, 0x06CB;
        je  fp_vv_yes;
        xor rax, rax;
        ret;
      fp_vv_yes:
        mov rax, 1;
        ret
      }
    } @no_frame

  pub let fp_sensor_type_valid : (u64) -> u64 !{} @{} =
    fn (t: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M6-001 (#1194): 1 iff t in {AREA=1, SWIPE=2}. UNKNOWN (0) is refused at mint — a sensor whose kind was never learnt cannot be enrolled against without picking either an area-scan or a swipe pipeline. Labels prefixed fp_tv_.",
      block: {
        cmp rdi, 1;
        jb  fp_tv_no;
        cmp rdi, 2;
        ja  fp_tv_no;
        mov rax, 1;
        ret;
      fp_tv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let fp_sensor_dpi_valid : (u64) -> u64 !{} @{} =
    fn (d: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M6-001 (#1194): 1 iff d in [100, 2000]. A DPI outside those bounds is not a fingerprint sensor. Labels prefixed fp_dv_.",
      block: {
        cmp rdi, 100;
        jb  fp_dv_no;
        cmp rdi, 2000;
        ja  fp_dv_no;
        mov rax, 1;
        ret;
      fp_dv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let fp_sensor_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M6-001 (#1194): subset test against R_FP_SENSOR_ALL = 0x419. RIGHT_MINT (0x200) is OUTSIDE the mask — this kind is a leaf (§3). Labels prefixed fp_rv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x419;
        and rax, r10;
        cmp rax, rdi;
        jne fp_rv_no;
        mov rax, 1;
        ret;
      fp_rv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Counters.
  // ==========================================================================

  pub let fp_sensor_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M6-001 (#1194): counter bump. Labels prefixed fp_nt_.",
      block: {
        cmp rdi, 4;
        jae fp_nt_out;
        lea r10, [rip + _fp_sensor_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      fp_nt_out:
        ret
      }
    } @no_frame

  pub let fp_sensor_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M6-001 (#1194): counter read. Labels prefixed fp_st_.",
      block: {
        cmp rdi, 4;
        jae fp_st_zero;
        lea r10, [rip + _fp_sensor_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      fp_st_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Parent gate: parent must be live KIND_DEVICE with RIGHT_MINT.
  // ==========================================================================

  pub let fp_sensor_check_parent : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R34.M6-001 (#1194): §1 gate. parent must be live KIND_DEVICE (10) with RIGHT_MINT. Kind check alone discriminates NOTHING; the mint's additional gates cover the rest. Labels prefixed fp_cp_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae fp_cp_no;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 10;                     // KIND_DEVICE
        jne fp_cp_no;

        mov r10, [rax + 8];
        mov r11, 0x200;                  // RIGHT_MINT
        and r10, r11;
        cmp r10, 0;
        je  fp_cp_no;

        mov rax, 1;
        ret;
      fp_cp_no:
        xor rax, rax;
        ret
      }
    }

  // Read parent KIND_DEVICE identity from its target_ptr.
  pub let fp_sensor_parent_key : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R34.M6-001 (#1194): parent KIND_DEVICE target_ptr = its identity key. 0 if bad slot or wrong kind — the mint refuses NO_DEVICE for 0. Labels prefixed fp_pk_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae fp_pk_no;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 10;
        jne fp_pk_no;

        mov rax, [rax + 16];
        ret;
      fp_pk_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Header pack.
  // ==========================================================================

  pub let fp_sensor_hdr_pack : (u64) -> u64 !{} @{} =
    fn (parent_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M6-001 (#1194): (parent_slot << 8). Labels prefixed fp_hp_.",
      block: {
        mov r10, 256;
        cmp rdi, r10;
        jae fp_hp_bad;
        mov rax, rdi;
        shl rax, 8;
        ret;
      fp_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  pub let fp_sensor_body1_pack : (u64, u64, u64) -> u64 !{} @{} =
    fn (device_slot: u64) (vendor_id: u64) (product_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M6-001 (#1194): pack device_slot[31:0] | vendor_id[47:32] | product_id[63:48]. Refuses out-of-range fields. Labels prefixed fp_b1_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  fp_b1_bad;
        mov r10, 0xFFFF;
        cmp rsi, r10;
        ja  fp_b1_bad;
        cmp rdx, r10;
        ja  fp_b1_bad;

        mov rax, rdi;
        and rax, 0xFFFFFFFF;
        mov r10, rsi;
        and r10, 0xFFFF;
        shl r10, 32;
        or  rax, r10;
        mov r10, rdx;
        and r10, 0xFFFF;
        shl r10, 48;
        or  rax, r10;
        ret;
      fp_b1_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  pub let fp_sensor_body2_pack : (u64, u64, u64) -> u64 !{} @{} =
    fn (sensor_type: u64) (resolution_dpi: u64) (enrollment_state: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M6-001 (#1194): pack sensor_type[7:0] | resolution_dpi[23:8] | enrollment_state[31:24]. Reserved [63:32] left zero. Refuses out-of-range fields. Labels prefixed fp_b2_.",
      block: {
        cmp rdi, 2;
        ja  fp_b2_bad;
        cmp rsi, 2000;
        ja  fp_b2_bad;
        cmp rdx, 2;
        ja  fp_b2_bad;

        mov rax, rdi;
        and rax, 0xFF;
        mov r10, rsi;
        and r10, 0xFFFF;
        shl r10, 8;
        or  rax, r10;
        mov r10, rdx;
        and r10, 0xFF;
        shl r10, 24;
        or  rax, r10;
        ret;
      fp_b2_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Tail alloc/valid/free.
  //
  // THE ONE WRITER of _fp_sensor_table. tools/build.sh confines
  // relocations against `_fp_sensor_table` to this object.
  // ==========================================================================

  pub let fp_sensor_tail_alloc : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (sensor_key: u64) (body1_packed: u64) (body2_packed: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M6-001 (#1194): claim one FP SENSOR row. THE ONE WRITER of _fp_sensor_table. Gates: hdr in_use pre-set -> BAD_ARG; sensor_key != 0 -> BAD_ARG; body1/body2 != DECODE_BAD -> BAD_ARG. Low-first free scan over 8 rows of 32 bytes. Labels prefixed fp_ta_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // hdr
        mov r13, rsi;                    // sensor_key
        mov r14, rdx;                    // body1
        mov r15, rcx;                    // body2

        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne fp_ta_bad;

        cmp r13, 0;
        je  fp_ta_bad;

        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp r14, r10;
        je  fp_ta_bad;
        cmp r15, r10;
        je  fp_ta_bad;

        xor rbx, rbx;
      fp_ta_scan:
        cmp rbx, 8;
        jae fp_ta_enospc;

        lea r10, [rip + _fp_sensor_table];
        mov r11, rbx;
        shl r11, 5;
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  fp_ta_claim;

        add rbx, 1;
        jmp fp_ta_scan;

      fp_ta_claim:
        mov rax, r12;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r13;
        mov [r10 + 16], r14;
        mov [r10 + 24], r15;
        mov rax, rbx;
        jmp fp_ta_out;

      fp_ta_enospc:
        mov rax, 0xFFFFFA8F;
        jmp fp_ta_out;
      fp_ta_bad:
        mov rax, 0xFFFFFA8E;

      fp_ta_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let fp_sensor_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M6-001 (#1194): 1 iff row_id < MAX and in_use. Labels prefixed fp_tv_.",
      block: {
        cmp rdi, 8;
        jae fp_tvr_no;
        lea r10, [rip + _fp_sensor_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  fp_tvr_no;
        mov rax, 1;
        ret;
      fp_tvr_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let fp_sensor_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M6-001 (#1194): scrub one row. Labels prefixed fp_tf_.",
      block: {
        cmp rdi, 8;
        jae fp_tf_out;
        lea r10, [rip + _fp_sensor_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
      fp_tf_out:
        ret
      }
    } @no_frame

  // ==========================================================================
  // Row accessors.
  // ==========================================================================

  pub let fp_sensor_row_key : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M6-001 (#1194): sensor_key. Labels prefixed fp_rk_.",
      block: {
        push r12; push r13; push r14;
        mov r12, rdi;
        call fp_sensor_tail_valid;
        cmp rax, 0;
        je  fp_rk_bad;
        lea r10, [rip + _fp_sensor_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 8];
        jmp fp_rk_out;
      fp_rk_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      fp_rk_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  pub let fp_sensor_row_device : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M6-001 (#1194): device_slot. Labels prefixed fp_rd_.",
      block: {
        push r12; push r13; push r14;
        mov r12, rdi;
        call fp_sensor_tail_valid;
        cmp rax, 0;
        je  fp_rd_bad;
        lea r10, [rip + _fp_sensor_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        and rax, 0xFFFFFFFF;
        jmp fp_rd_out;
      fp_rd_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      fp_rd_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  pub let fp_sensor_row_vendor : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M6-001 (#1194): vendor_id. Labels prefixed fp_rv2_.",
      block: {
        push r12; push r13; push r14;
        mov r12, rdi;
        call fp_sensor_tail_valid;
        cmp rax, 0;
        je  fp_rv2_bad;
        lea r10, [rip + _fp_sensor_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 32;
        and rax, 0xFFFF;
        jmp fp_rv2_out;
      fp_rv2_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      fp_rv2_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  pub let fp_sensor_row_product : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M6-001 (#1194): product_id. Labels prefixed fp_rpr_.",
