  // ==========================================================================
  // Lookups.
  // ==========================================================================

  pub let fp_sensor_find_by_key : (u64) -> u64 !{mem} @{} =
    fn (sensor_key: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M6-001 (#1194): live row holding this sensor_key, or ROW_NONE. Refuses to match 0. Labels prefixed fp_fk_.",
      block: {
        cmp rdi, 0;
        je  fp_fk_none;
        xor rcx, rcx;
      fp_fk_scan:
        cmp rcx, 8;
        jae fp_fk_none;
        lea r10, [rip + _fp_sensor_table];
        mov r11, rcx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  fp_fk_next;
        mov rax, [r10 + 8];
        cmp rax, rdi;
        je  fp_fk_hit;
      fp_fk_next:
        add rcx, 1;
        jmp fp_fk_scan;
      fp_fk_hit:
        mov rax, rcx;
        ret;
      fp_fk_none:
        mov rax, 0xFF;
        ret
      }
    } @no_frame

  pub let fp_sensor_row_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R34.M6-001 (#1194): slot -> row_id, gated on live KIND_FP_SENSOR. Labels prefixed fp_ros_.",
      block: {
        push r12; push r13; push r14;

        mov r11, 256;
        cmp rdi, r11;
        jae fp_ros_none;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x16A;
        cmp r10, r11;
        jne fp_ros_none;

        mov r12, [rax + 16];
        mov r10, 0xFFFF;
        and r12, r10;

        mov rdi, r12;
        call fp_sensor_tail_valid;
        cmp rax, 0;
        je  fp_ros_none;

        mov rax, r12;
        jmp fp_ros_out;

      fp_ros_none:
        mov rax, 0xFF;
      fp_ros_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

