  // ==========================================================================
  // Mint. Six args (slot, parent_slot, rights, sensor_key, device_slot,
  // packed_ident). packed_ident encoding:
  //   [15:0]  vendor_id
  //   [31:16] product_id
  //   [39:32] sensor_type
  //   [55:40] resolution_dpi
  //   [63:56] enrollment_state
  // ==========================================================================

  pub let fp_sensor_cap_mint_inner : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (sensor_key: u64) (device_slot: u64) (packed_ident: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R34.M6-001 (#1194): mint KIND_FP_SENSOR over KIND_DEVICE. Six args (slot, parent, rights, key, device_slot, packed_ident). packed = vendor[15:0] | product[31:16] | type[39:32] | dpi[55:40] | enroll[63:56]. Sequence: slot<256; check_parent; parent_key non-zero (NO_DEVICE); rights_valid; unpack + validate vendor/type/dpi/enroll; sensor_key non-zero (NO_KEY); uniqueness (IN_USE); hdr_pack; body1_pack (with device_slot); body2_pack; tail_alloc; cap_mint_write. Labels prefixed fp_mi_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov rbx, rdi;                    // slot
        mov r12, rsi;                    // parent_slot
        mov r13, rdx;                    // rights
        mov r14, rcx;                    // sensor_key
        mov r15, r8;                     // device_slot
        mov rbp, r9;                     // packed_ident

        mov r10, 256;
        cmp rbx, r10;
        jae fp_mi_bad_slot;

        mov rdi, r12;
        call fp_sensor_check_parent;
        cmp rax, 0;
        je  fp_mi_bad_parent;

        mov rdi, r12;
        call fp_sensor_parent_key;
        cmp rax, 0;
        je  fp_mi_no_device;

        mov rdi, r13;
        call fp_sensor_rights_valid;
        cmp rax, 0;
        je  fp_mi_bad_rights;

        // vendor_id
        mov rdi, rbp;
        and rdi, 0xFFFF;
        call fp_sensor_vendor_valid;
        cmp rax, 0;
        je  fp_mi_bad_vendor;

        // sensor_type
        mov rdi, rbp;
        shr rdi, 32;
        and rdi, 0xFF;
        call fp_sensor_type_valid;
        cmp rax, 0;
        je  fp_mi_bad_type;

        // resolution_dpi
        mov rdi, rbp;
        shr rdi, 40;
        and rdi, 0xFFFF;
        call fp_sensor_dpi_valid;
        cmp rax, 0;
        je  fp_mi_bad_dpi;

        // enrollment_state (accept 0..2; > 2 -> BAD_TYPE band suffices;
        // keep separate as BAD_ARG via body2_pack instead).
        cmp r14, 0;
        je  fp_mi_no_key;

        mov rdi, r14;
        call fp_sensor_find_by_key;
        cmp rax, 0xFF;
        jne fp_mi_in_use;

        // Body1 pack args: (device_slot, vendor_id, product_id).
        mov rdi, r15;                    // device_slot
        mov rsi, rbp;
        and rsi, 0xFFFF;                 // vendor
        mov rdx, rbp;
        shr rdx, 16;
        and rdx, 0xFFFF;                 // product
        call fp_sensor_body1_pack;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  fp_mi_bad_vendor;
        push rax;                        // body1
        sub rsp, 8;

        // Body2 pack args: (sensor_type, resolution_dpi, enrollment_state).
        mov rdi, rbp;
        shr rdi, 32;
        and rdi, 0xFF;                   // type
        mov rsi, rbp;
        shr rsi, 40;
        and rsi, 0xFFFF;                 // dpi
        mov rdx, rbp;
        shr rdx, 56;
        and rdx, 0xFF;                   // enroll
        call fp_sensor_body2_pack;
        add rsp, 8;
        pop r11;                         // body1
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  fp_mi_bad_type;
        mov r15, rax;                    // body2 in r15 (overwrites device_slot)
        push r11;                        // body1
        sub rsp, 8;

        mov rdi, r12;
        call fp_sensor_hdr_pack;
        add rsp, 8;
        pop r11;                         // body1
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  fp_mi_bad_parent;

        mov rdi, rax;                    // hdr
        mov rsi, r14;                    // sensor_key
        mov rdx, r11;                    // body1
        mov rcx, r15;                    // body2
        call fp_sensor_tail_alloc;

        mov r10, 0xFFFFFA8F;
        cmp rax, r10;
        je  fp_mi_enospc;
        mov r10, 0xFFFFFA8E;
        cmp rax, r10;
        je  fp_mi_bad_type;

        mov r15, rax;                    // row_id
        mov r11, rbx;
        shl r11, 16;
        or  r15, r11;

        mov rdi, rbx;
        mov rsi, 0x16A;
        mov rdx, r13;
        mov rcx, r15;
        call cap_mint_write;

        mov rdi, 0;
        call fp_sensor_note;

        xor rax, rax;
        jmp fp_mi_out;

      fp_mi_bad_slot:
        mov rax, 0xFFFFFA84;
        jmp fp_mi_out;
      fp_mi_bad_parent:
        mov rax, 0xFFFFFA8D;
        jmp fp_mi_out;
      fp_mi_bad_rights:
        mov rax, 0xFFFFFA8C;
        jmp fp_mi_out;
      fp_mi_bad_vendor:
        mov rax, 0xFFFFFA8B;
        jmp fp_mi_out;
      fp_mi_bad_type:
        mov rax, 0xFFFFFA8A;
        jmp fp_mi_out;
      fp_mi_bad_dpi:
        mov rax, 0xFFFFFA89;
        jmp fp_mi_out;
      fp_mi_no_device:
        mov rax, 0xFFFFFA88;
        jmp fp_mi_out;
      fp_mi_no_key:
        mov rax, 0xFFFFFA87;
        jmp fp_mi_out;
      fp_mi_in_use:
        mov rdi, 2;
        call fp_sensor_note;
        mov rax, 0xFFFFFA85;
        jmp fp_mi_out;
      fp_mi_enospc:
        mov rdi, 3;
        call fp_sensor_note;
        mov rax, 0xFFFFFA86;

      fp_mi_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let fp_sensor_cap_mint : (u64, u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (sensor_key: u64) (device_slot: u64) (packed_ident: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R34.M6-001 (#1194): audited mint.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;
        mov r13, rsi;

        call fp_sensor_cap_mint_inner;
        mov r14, rax;

        mov rdi, 1;
        mov rsi, 0x16A;
        mov rdx, r12;
        mov rcx, r13;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Revoke.
  // ==========================================================================

  pub let fp_sensor_cap_revoke_inner : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R34.M6-001 (#1194): revoke KIND_FP_SENSOR. Labels prefixed fp_rvk_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;

        mov r10, 256;
        cmp r12, r10;
        jae fp_rvk_bad_slot;

        mov rax, cap_table;
        mov r8, r12;
        shl r8, 3;
        mov r9, r12;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov rbx, rax;

        mov r10, [rbx + 0];
        cmp r10, 0;
        je  fp_rvk_already;

        mov r11, 0x16A;
        cmp r10, r11;
        jne fp_rvk_wrong_kind;

        mov r13, [rbx + 16];
        mov r10, 0xFFFF;
        and r13, r10;

        mov rdi, r13;
        call fp_sensor_tail_valid;
        cmp rax, 0;
        je  fp_rvk_clear;

        mov rdi, r13;
        call fp_sensor_tail_free;

      fp_rvk_clear:
        mov rdi, r12;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        mov rdi, 1;
        call fp_sensor_note;

        xor rax, rax;
        jmp fp_rvk_out;

      fp_rvk_bad_slot:
        mov rax, 0xFFFFFA84;
        jmp fp_rvk_out;
      fp_rvk_wrong_kind:
        mov rax, 0xFFFFFA83;
        jmp fp_rvk_out;
      fp_rvk_already:
        mov rax, 0xFFFFFA82;

      fp_rvk_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let fp_sensor_cap_revoke : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R34.M6-001 (#1194): audited revoke.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;

        call fp_sensor_cap_revoke_inner;
        mov r14, rax;

        mov rdi, 2;
        mov rsi, 0x16A;
        mov rdx, r12;
        mov rcx, r12;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Dispatch handler.
  // ==========================================================================

  pub let cap_handler_fp_sensor : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R34.M6-001 (#1194): KIND_FP_SENSOR dispatch. Queries INVOKE; DEBUG_PRINT OBSERVE. All ops arity ONE — op_arg[63:8] REFUSED. Labels prefixed fp_hn_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov r12, rdi;                    // rights
        mov r13, rsi;
        mov r10, 0xFFFF;
        and r13, r10;                    // row_id
        mov r14, rdx;                    // op_arg

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_fp_sensor_msg];
        call klog_s1;

        mov r10, r14;
        and r10, 0xFF;
        mov rbp, r10;                    // op
        mov r11, r14;
        shr r11, 8;
        cmp r11, 0;
        jne fp_hn_res;

        cmp rbp, 8;
        ja  fp_hn_unsup;

        cmp rbp, 8;
        je  fp_hn_dbg;

        // Ops 0..7: INVOKE.
        mov r10, r12;
        and r10, 0x008;
        cmp r10, 0;
        je  fp_hn_denied;

        mov rdi, r13;
        cmp rbp, 0;
        je  fp_hn_key;
        cmp rbp, 1;
        je  fp_hn_dev;
        cmp rbp, 2;
        je  fp_hn_ven;
        cmp rbp, 3;
        je  fp_hn_prd;
        cmp rbp, 4;
        je  fp_hn_typ;
        cmp rbp, 5;
        je  fp_hn_dpi;
        cmp rbp, 6;
        je  fp_hn_enr;
        call fp_sensor_row_parent;
        jmp fp_hn_out;

      fp_hn_key:
        call fp_sensor_row_key;
        jmp fp_hn_out;
      fp_hn_dev:
        call fp_sensor_row_device;
        jmp fp_hn_out;
      fp_hn_ven:
        call fp_sensor_row_vendor;
        jmp fp_hn_out;
      fp_hn_prd:
        call fp_sensor_row_product;
        jmp fp_hn_out;
      fp_hn_typ:
        call fp_sensor_row_type;
        jmp fp_hn_out;
      fp_hn_dpi:
        call fp_sensor_row_dpi;
        jmp fp_hn_out;
      fp_hn_enr:
        call fp_sensor_row_enroll;
        jmp fp_hn_out;

      fp_hn_dbg:
        mov r10, r12;
        and r10, 0x400;
        cmp r10, 0;
        je  fp_hn_denied;
        xor rax, rax;
        jmp fp_hn_out;

      fp_hn_res:
        mov rax, 0xFFFFFA8E;
        jmp fp_hn_out;
      fp_hn_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;
        jmp fp_hn_out;
      fp_hn_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;

      fp_hn_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
