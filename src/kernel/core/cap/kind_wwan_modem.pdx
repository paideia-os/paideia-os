// src/kernel/core/cap/kind_wwan_modem.pdx -- R40.M4-001 (#1360)
//
// KIND_WWAN_MODEM = 0x180, derived over KIND_DEVICE (10).
//
// The authority to hold ONE WWAN (Wireless Wide Area Network) modem's
// static identity: a modem_key, the KIND_DEVICE slot the modem was
// bound on, its 16-bit USB / PCIe vendor_id, its 16-bit product_id,
// its form-factor ordinal (M.2 / USB), and its current PCIe power
// state (D0 active / D3 gated).
//
// =============================================================================
// §0  WHY THIS KIND EXISTS
// =============================================================================
//
// R40.M4 opens the T14 G4 WWAN bring-up (Intel / Fibocom LTE / 5G-NR
// modems on the M.2 3042/3052 slot). R40.M4-002 (this issue) introduces
// the CAPABILITY over one probed modem so a ring-3 supervisor (an MBIM
// session daemon, a connection manager) can name ONE MODEM without
// touching either the PCIe config space or the USB CDC control channel
// directly.
//
// The kind half of the derivation gate discriminates NOTHING on its
// own -- every PCI/ACPI-discovered function is a KIND_DEVICE, and this
// is the twelfth kind in the tree to take that parent -- so the mint
// additionally requires:
//
//   (a) modem_key non-zero and unique among live rows (NO_KEY / IN_USE)
//   (b) device_slot names a live KIND_DEVICE (BAD_DEVICE)
//   (c) vendor_id in (0, 0xFFFF] (BAD_VENDOR)
//   (d) product_id in (0, 0xFFFF] (BAD_PRODUCT)
//   (e) form_factor in {WWM_FORM_M2=1, WWM_FORM_USB=2} (BAD_FORM)
//   (f) power_state in {WWM_PWR_D0=0, WWM_PWR_D3=3} (BAD_PWR)
//   (g) rights subset of R_WWM_ALL (R_MINT OUTSIDE the mask -- LEAF)
//
// =============================================================================
// §1  ROW LAYOUT -- 32 BYTES EXACTLY
// =============================================================================
//
//   [+0]  header:  in_use[63:56] | parent_slot[15:8]
//   [+8]  modem_key   (u64)
//   [+16] body1:   device_slot[31:0] | vendor_id[47:32] | product_id[63:48]
//   [+24] body2:   form_factor[7:0] | power_state[15:8] | reserved[63:16]
//
// Every identity field is set once at mint; no primitive in this
// module mutates any of them. Revoke scrubs the entire row.
//
// =============================================================================
// §2  FAILURE TAXONOMY 0xFFFFF1C0..0xFFFFF1CF
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band. Adjacent used band above: camera_capture_channel
// 0xFFFFF1D0..DF (R40.M3-003). Adjacent free band below:
// kind_mbim_session 0xFFFFF1B0..BF (R40.M4-004).

module KindWwanModem = structure {

  pub let KIND_WWAN_MODEM      : u64 = 0x180
  pub let WWM_PARENT_KIND      : u64 = 10       // = KIND_DEVICE

  // Form-factor ordinals -- enumerated so bit-widening is refused, not masked.
  pub let WWM_FORM_M2          : u64 = 1
  pub let WWM_FORM_USB         : u64 = 2

  // PCIe power-state ordinals (D-states). Only D0 (active) and D3
  // (deep gate) are meaningful on the WWAN control path; D1/D2 are
  // deliberately unaccepted -- an ambiguous intermediate state would
  // let a caller stamp a modem row with a power level the ring-3
  // supervisor never validated.
  pub let WWM_PWR_D0           : u64 = 0
  pub let WWM_PWR_D3           : u64 = 3

  // Rights -- LEAF. R_MINT (0x200) OUTSIDE R_WWM_ALL.
  pub let R_WWM_READ           : u64 = 0x001
  pub let R_WWM_INVOKE         : u64 = 0x008
  pub let R_WWM_REVOKE         : u64 = 0x010
  pub let R_WWM_OBSERVE        : u64 = 0x400
  pub let R_WWM_ALL            : u64 = 0x419

  // Ops -- all QUERY, all arity ONE (op_arg[63:8] REFUSED).
  pub let WWM_OP_QUERY_KEY     : u64 = 0
  pub let WWM_OP_QUERY_DEVICE  : u64 = 1
  pub let WWM_OP_QUERY_VENDOR  : u64 = 2
  pub let WWM_OP_QUERY_PRODUCT : u64 = 3
  pub let WWM_OP_QUERY_FORM    : u64 = 4
  pub let WWM_OP_QUERY_PWR     : u64 = 5
  pub let WWM_OP_DEBUG_PRINT   : u64 = 6
  pub let WWM_OP_MAX           : u64 = 6

  // Failure taxonomy 0xFFFFF1C0..CF.
  pub let WWM_OK               : u64 = 0
  pub let WWM_TAIL_ENOSPC      : u64 = 0xFFFFF1CF
  pub let WWM_TAIL_BAD_ARG     : u64 = 0xFFFFF1CE
  pub let WWM_MINT_BAD_PARENT  : u64 = 0xFFFFF1CD
  pub let WWM_MINT_BAD_RIGHTS  : u64 = 0xFFFFF1CC
  pub let WWM_MINT_BAD_DEVICE  : u64 = 0xFFFFF1CB
  pub let WWM_MINT_BAD_VENDOR  : u64 = 0xFFFFF1CA
  pub let WWM_MINT_BAD_PRODUCT : u64 = 0xFFFFF1C9
  pub let WWM_MINT_BAD_FORM    : u64 = 0xFFFFF1C8
  pub let WWM_MINT_BAD_PWR     : u64 = 0xFFFFF1C7
  pub let WWM_MINT_NO_KEY      : u64 = 0xFFFFF1C6
  pub let WWM_MINT_IN_USE      : u64 = 0xFFFFF1C5
  pub let WWM_MINT_ENOSPC      : u64 = 0xFFFFF1C4
  pub let WWM_BAD_SLOT         : u64 = 0xFFFFF1C3
  pub let WWM_WRONG_KIND       : u64 = 0xFFFFF1C2
  pub let WWM_REVOKE_ALREADY   : u64 = 0xFFFFF1C1
  pub let WWM_RESERVED         : u64 = 0xFFFFF1C0

  pub let WWM_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let WWM_ROW_NONE   : u64 = 0xFF

  // Eight rows, 32-byte stride -- total 256 bytes as [u64; 32].
  pub let WWM_MAX       : u64 = 8
  pub let WWM_ROW_BYTES : u64 = 32

  pub let mut _wwan_modem_table : [u64; 32] = uninit @align(64)
  pub let mut _wwan_modem_stats : [u64; 4]  = uninit @align(64)

  pub let WWM_ST_MINTS   : u64 = 0
  pub let WWM_ST_REVOKES : u64 = 1
  pub let WWM_ST_REFUSED : u64 = 2
  pub let WWM_ST_QUERIES : u64 = 3

  pub let wwm_dbg_msg : [u8; 15] = "WWAN MODEM ROW\0"

  // ==========================================================================
  // Table reset.
  // ==========================================================================

  pub let wwan_modem_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M4-001 (#1360): clear KIND_WWAN_MODEM row table and counters. Boot + teardown only. Labels prefixed wwm_rs_.",
      block: {
        lea r10, [rip + _wwan_modem_table];
        xor rax, rax;
        xor rcx, rcx;
      wwm_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  wwm_rs_rows;

        lea r10, [rip + _wwan_modem_stats];
        xor rcx, rcx;
      wwm_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  wwm_rs_stats;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let wwm_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R40.M4-001 (#1360): subset test against R_WWM_ALL = 0x419. R_MINT (0x200) OUTSIDE the mask -- LEAF. Labels prefixed wwm_rv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x419;
        and rax, r10;
        cmp rax, rdi;
        jne wwm_rv_no;
        mov rax, 1;
        ret;
      wwm_rv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let wwm_form_valid : (u64) -> u64 !{} @{} =
    fn (form: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R40.M4-001 (#1360): 1 iff form in {M2=1, USB=2}. Enumerated -- widening refused, not masked. Labels prefixed wwm_fv_.",
      block: {
        cmp rdi, 1;
        je  wwm_fv_yes;
        cmp rdi, 2;
        je  wwm_fv_yes;
        xor rax, rax;
        ret;
      wwm_fv_yes:
        mov rax, 1;
        ret
      }
    } @no_frame

  pub let wwm_pwr_valid : (u64) -> u64 !{} @{} =
    fn (pwr: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R40.M4-001 (#1360): 1 iff pwr in {D0=0, D3=3}. D1/D2 deliberately unaccepted (§0 (f)). Labels prefixed wwm_pv_.",
      block: {
        cmp rdi, 0;
        je  wwm_pv_yes;
        cmp rdi, 3;
        je  wwm_pv_yes;
        xor rax, rax;
        ret;
      wwm_pv_yes:
        mov rax, 1;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Counters.
  // ==========================================================================

  pub let wwm_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M4-001 (#1360): counter bump. Labels prefixed wwm_nt_.",
      block: {
        cmp rdi, 4;
        jae wwm_nt_out;
        lea r10, [rip + _wwan_modem_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      wwm_nt_out:
        ret
      }
    } @no_frame

  pub let wwm_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M4-001 (#1360): counter read. Labels prefixed wwm_stt_.",
      block: {
        cmp rdi, 4;
        jae wwm_stt_zero;
        lea r10, [rip + _wwan_modem_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      wwm_stt_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Parent gate: live KIND_DEVICE (10) with RIGHT_MINT.
  // ==========================================================================

  pub let wwm_check_parent : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R40.M4-001 (#1360): parent must be live KIND_DEVICE (10) with RIGHT_MINT. Labels prefixed wwm_cp_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae wwm_cp_no;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 10;
        jne wwm_cp_no;

        mov r10, [rax + 8];
        mov r11, 0x200;
        and r10, r11;
        cmp r10, 0;
        je  wwm_cp_no;

        mov rax, 1;
        ret;
      wwm_cp_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Device gate: live KIND_DEVICE (10) at device_slot.
  // ==========================================================================

  pub let wwm_check_device : (u64) -> u64 !{mem} @{cap} =
    fn (device_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R40.M4-001 (#1360): device_slot must name a live KIND_DEVICE. Labels prefixed wwm_cd_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae wwm_cd_no;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 10;
        jne wwm_cd_no;

        mov rax, 1;
        ret;
      wwm_cd_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Header + body packers.
  // ==========================================================================

  pub let wwm_hdr_pack : (u64) -> u64 !{} @{} =
    fn (parent_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R40.M4-001 (#1360): (parent_slot << 8). Labels prefixed wwm_hp_.",
      block: {
        mov r10, 256;
        cmp rdi, r10;
        jae wwm_hp_bad;
        mov rax, rdi;
        shl rax, 8;
        ret;
      wwm_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  // body1: device_slot[31:0] | vendor_id[47:32] | product_id[63:48].
  pub let wwm_body1_pack : (u64, u64, u64) -> u64 !{} @{} =
    fn (device_slot: u64) (vendor_id: u64) (product_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R40.M4-001 (#1360): pack body1: device_slot[31:0] | vendor_id[47:32] | product_id[63:48]. Labels prefixed wwm_b1_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  wwm_b1_bad;
        mov r10, 0xFFFF;
        cmp rsi, r10;
        ja  wwm_b1_bad;
        cmp rdx, r10;
        ja  wwm_b1_bad;

        mov rax, rdi;
        and rax, 0xFFFFFFFF;
        mov r10, rsi;
        and r10, 0xFFFF;
        shl r10, 32;
        or  rax, r10;
        mov r10, rdx;
        and r10, 0xFFFF;
        shl r10, 48;
        or  rax, r10;
        ret;
      wwm_b1_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  // body2: form_factor[7:0] | power_state[15:8] | reserved[63:16].
  pub let wwm_body2_pack : (u64, u64) -> u64 !{} @{} =
    fn (form: u64) (pwr: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R40.M4-001 (#1360): pack body2: form_factor[7:0] | power_state[15:8]. Reserved [63:16] MUST be zero on read. Labels prefixed wwm_b2_.",
      block: {
        mov r10, 0xFF;
        cmp rdi, r10;
        ja  wwm_b2_bad;
        cmp rsi, r10;
        ja  wwm_b2_bad;

        mov rax, rdi;
        and rax, 0xFF;
        mov r10, rsi;
        and r10, 0xFF;
        shl r10, 8;
        or  rax, r10;
        ret;
      wwm_b2_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Tail alloc / valid / free -- THE ONE WRITER of _wwan_modem_table.
  // ==========================================================================

  pub let wwm_tail_alloc : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (modem_key: u64) (body1: u64) (body2: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M4-001 (#1360): claim one WWAN MODEM row. THE ONE WRITER of _wwan_modem_table. Gates: hdr in_use pre-set -> BAD_ARG; modem_key != 0 -> BAD_ARG; body1/body2 != DECODE_BAD -> BAD_ARG. Labels prefixed wwm_ta_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov r15, rcx;

        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne wwm_ta_bad;

        cmp r13, 0;
        je  wwm_ta_bad;

        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp r14, r10;
        je  wwm_ta_bad;
        cmp r15, r10;
        je  wwm_ta_bad;

        xor rbx, rbx;
      wwm_ta_scan:
        cmp rbx, 8;
        jae wwm_ta_enospc;

        lea r10, [rip + _wwan_modem_table];
        mov r11, rbx;
        shl r11, 5;
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  wwm_ta_claim;

        add rbx, 1;
        jmp wwm_ta_scan;

      wwm_ta_claim:
        mov rax, r12;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r13;
        mov [r10 + 16], r14;
        mov [r10 + 24], r15;
        mov rax, rbx;
        jmp wwm_ta_out;

      wwm_ta_enospc:
        mov rax, 0xFFFFF1CF;
        jmp wwm_ta_out;
      wwm_ta_bad:
        mov rax, 0xFFFFF1CE;

      wwm_ta_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let wwm_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M4-001 (#1360): 1 iff row_id < MAX and in_use. Labels prefixed wwm_tvr_.",
      block: {
        cmp rdi, 8;
        jae wwm_tvr_no;
        lea r10, [rip + _wwan_modem_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  wwm_tvr_no;
        mov rax, 1;
        ret;
      wwm_tvr_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let wwm_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M4-001 (#1360): scrub one row. Labels prefixed wwm_tf_.",
      block: {
        cmp rdi, 8;
        jae wwm_tf_out;
        lea r10, [rip + _wwan_modem_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
      wwm_tf_out:
        ret
      }
    } @no_frame

  // ==========================================================================
  // Row accessors.
  // ==========================================================================

  pub let wwm_row_key : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M4-001 (#1360): modem_key. Labels prefixed wwm_rk_.",
      block: {
        push r12;
        mov r12, rdi;
        call wwm_tail_valid;
        cmp rax, 0;
        je  wwm_rk_bad;
        lea r10, [rip + _wwan_modem_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 8];
        jmp wwm_rk_out;
      wwm_rk_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      wwm_rk_out:
        pop r12;
        ret
      }
    }

  pub let wwm_row_device : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M4-001 (#1360): device_slot (body1[31:0]). Labels prefixed wwm_rd_.",
      block: {
        push r12;
        mov r12, rdi;
        call wwm_tail_valid;
        cmp rax, 0;
        je  wwm_rd_bad;
        lea r10, [rip + _wwan_modem_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        and rax, 0xFFFFFFFF;
        jmp wwm_rd_out;
      wwm_rd_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      wwm_rd_out:
        pop r12;
        ret
      }
    }

  pub let wwm_row_vendor : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M4-001 (#1360): vendor_id (body1[47:32]). Labels prefixed wwm_rv1_.",
      block: {
        push r12;
        mov r12, rdi;
        call wwm_tail_valid;
        cmp rax, 0;
        je  wwm_rv1_bad;
        lea r10, [rip + _wwan_modem_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 32;
        and rax, 0xFFFF;
        jmp wwm_rv1_out;
      wwm_rv1_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      wwm_rv1_out:
        pop r12;
        ret
      }
    }

  pub let wwm_row_product : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M4-001 (#1360): product_id (body1[63:48]). Labels prefixed wwm_rp_.",
      block: {
        push r12;
        mov r12, rdi;
        call wwm_tail_valid;
        cmp rax, 0;
        je  wwm_rp_bad;
        lea r10, [rip + _wwan_modem_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 48;
        and rax, 0xFFFF;
        jmp wwm_rp_out;
      wwm_rp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      wwm_rp_out:
        pop r12;
        ret
      }
    }

  pub let wwm_row_form : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M4-001 (#1360): form_factor (body2[7:0]). Labels prefixed wwm_rf_.",
      block: {
        push r12;
        mov r12, rdi;
        call wwm_tail_valid;
        cmp rax, 0;
        je  wwm_rf_bad;
        lea r10, [rip + _wwan_modem_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 24];
        and rax, 0xFF;
        jmp wwm_rf_out;
      wwm_rf_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      wwm_rf_out:
        pop r12;
        ret
      }
    }

  pub let wwm_row_pwr : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M4-001 (#1360): power_state (body2[15:8]). Labels prefixed wwm_rw_.",
      block: {
        push r12;
        mov r12, rdi;
        call wwm_tail_valid;
        cmp rax, 0;
        je  wwm_rw_bad;
        lea r10, [rip + _wwan_modem_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 24];
        shr rax, 8;
        and rax, 0xFF;
        jmp wwm_rw_out;
      wwm_rw_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      wwm_rw_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Lookups.
  // ==========================================================================

  pub let wwm_find_by_key : (u64) -> u64 !{mem} @{} =
    fn (modem_key: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R40.M4-001 (#1360): live row holding modem_key, or ROW_NONE. Refuses to match 0. Labels prefixed wwm_fk_.",
      block: {
        cmp rdi, 0;
        je  wwm_fk_none;
        xor rcx, rcx;
      wwm_fk_scan:
        cmp rcx, 8;
        jae wwm_fk_none;
        lea r10, [rip + _wwan_modem_table];
        mov r11, rcx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  wwm_fk_next;
        mov rax, [r10 + 8];
        cmp rax, rdi;
        je  wwm_fk_hit;
      wwm_fk_next:
        add rcx, 1;
        jmp wwm_fk_scan;
      wwm_fk_hit:
        mov rax, rcx;
        ret;
      wwm_fk_none:
        mov rax, 0xFF;
        ret
      }
    } @no_frame

  pub let wwm_row_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R40.M4-001 (#1360): slot -> row_id, gated on live KIND_WWAN_MODEM. Labels prefixed wwm_ros_.",
      block: {
        push r12;

        mov r11, 256;
        cmp rdi, r11;
        jae wwm_ros_none;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x180;
        cmp r10, r11;
        jne wwm_ros_none;

        mov r12, [rax + 16];
        mov r10, 0xFFFF;
        and r12, r10;

        mov rdi, r12;
        call wwm_tail_valid;
        cmp rax, 0;
        je  wwm_ros_none;

        mov rax, r12;
        jmp wwm_ros_out;

      wwm_ros_none:
        mov rax, 0xFF;
      wwm_ros_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Mint. Six args -- device_slot / vendor / product / form / pwr packed in
  // two args to fit the ABI:
  //
  //   packed_ids encoding:
  //     [15:0]   device_slot
  //     [31:16]  vendor_id
  //     [47:32]  product_id
  //     [63:48]  reserved
  //
  //   packed_state encoding:
  //     [7:0]    form_factor
  //     [15:8]   power_state
  //     [63:16]  reserved
  // ==========================================================================

  pub let wwan_modem_cap_mint_inner : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (modem_key: u64) (packed_ids: u64) (packed_state: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R40.M4-001 (#1360): mint KIND_WWAN_MODEM over KIND_DEVICE. Sequence: slot<256; check_parent; rights_valid; unpack; check_device; vendor/product non-zero; form_valid; pwr_valid; modem_key non-zero (NO_KEY); uniqueness (IN_USE); pack; tail_alloc; cap_mint_write. Labels prefixed wwm_mi_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov rbx, rdi;                    // slot
        mov r12, rsi;                    // parent_slot
        mov r13, rdx;                    // rights
        mov r14, rcx;                    // modem_key
        mov r15, r8;                     // packed_ids
        mov rbp, r9;                     // packed_state

        mov r10, 256;
        cmp rbx, r10;
        jae wwm_mi_bad_slot;

        mov rdi, r12;
        call wwm_check_parent;
        cmp rax, 0;
        je  wwm_mi_bad_parent;

        mov rdi, r13;
        call wwm_rights_valid;
        cmp rax, 0;
        je  wwm_mi_bad_rights;

        // device_slot check
        mov r10, r15;
        and r10, 0xFFFF;
        mov rdi, r10;
        call wwm_check_device;
        cmp rax, 0;
        je  wwm_mi_bad_device;

        // vendor non-zero
        mov r10, r15;
        shr r10, 16;
        and r10, 0xFFFF;
        cmp r10, 0;
        je  wwm_mi_bad_vendor;

        // product non-zero
        mov r10, r15;
        shr r10, 32;
        and r10, 0xFFFF;
        cmp r10, 0;
        je  wwm_mi_bad_product;

        // form_valid
        mov r10, rbp;
        and r10, 0xFF;
        mov rdi, r10;
        call wwm_form_valid;
        cmp rax, 0;
        je  wwm_mi_bad_form;

        // pwr_valid
        mov r10, rbp;
        shr r10, 8;
        and r10, 0xFF;
        mov rdi, r10;
        call wwm_pwr_valid;
        cmp rax, 0;
        je  wwm_mi_bad_pwr;

        cmp r14, 0;
        je  wwm_mi_no_key;

        mov rdi, r14;
        call wwm_find_by_key;
        cmp rax, 0xFF;
        jne wwm_mi_in_use;

        // Pack body1.
        mov rdi, r15;
        and rdi, 0xFFFF;                 // device_slot
        mov rsi, r15;
        shr rsi, 16;
        and rsi, 0xFFFF;                 // vendor_id
        mov rdx, r15;
        shr rdx, 32;
        and rdx, 0xFFFF;                 // product_id
        call wwm_body1_pack;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  wwm_mi_bad_vendor;
        push rax;                        // body1 on stack

        // Pack body2.
        mov rdi, rbp;
        and rdi, 0xFF;                   // form
        mov rsi, rbp;
        shr rsi, 8;
        and rsi, 0xFF;                   // pwr
        call wwm_body2_pack;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  wwm_mi_bad_state_pop;
        push rax;                        // body2 on stack

        // Header.
        mov rdi, r12;
        call wwm_hdr_pack;
        pop r11;                         // body2
        pop rbp;                         // body1 (rbp reused)
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  wwm_mi_bad_parent;

        // tail_alloc(hdr, modem_key, body1, body2).
        mov rdi, rax;
        mov rsi, r14;
        mov rdx, rbp;
        mov rcx, r11;
        call wwm_tail_alloc;

        mov r10, 0xFFFFF1CF;
        cmp rax, r10;
        je  wwm_mi_enospc;
        mov r10, 0xFFFFF1CE;
        cmp rax, r10;
        je  wwm_mi_bad_arg;

        mov r15, rax;                    // row_id
        mov r11, rbx;
        shl r11, 16;
        or  r15, r11;

        mov rdi, rbx;
        mov rsi, 0x180;
        mov rdx, r13;
        mov rcx, r15;
        call cap_mint_write;

        mov rdi, 0;
        call wwm_note;

        xor rax, rax;
        jmp wwm_mi_out;

      wwm_mi_bad_state_pop:
        add rsp, 8;
        jmp wwm_mi_bad_form;

      wwm_mi_bad_slot:
        mov rax, 0xFFFFF1C3;
        jmp wwm_mi_out;
      wwm_mi_bad_parent:
        mov rax, 0xFFFFF1CD;
        jmp wwm_mi_out;
      wwm_mi_bad_rights:
        mov rax, 0xFFFFF1CC;
        jmp wwm_mi_out;
      wwm_mi_bad_device:
        mov rax, 0xFFFFF1CB;
        jmp wwm_mi_out;
      wwm_mi_bad_vendor:
        mov rax, 0xFFFFF1CA;
        jmp wwm_mi_out;
      wwm_mi_bad_product:
        mov rax, 0xFFFFF1C9;
        jmp wwm_mi_out;
      wwm_mi_bad_form:
        mov rax, 0xFFFFF1C8;
        jmp wwm_mi_out;
      wwm_mi_bad_pwr:
        mov rax, 0xFFFFF1C7;
        jmp wwm_mi_out;
      wwm_mi_no_key:
        mov rax, 0xFFFFF1C6;
        jmp wwm_mi_out;
      wwm_mi_in_use:
        mov rdi, 2;
        call wwm_note;
        mov rax, 0xFFFFF1C5;
        jmp wwm_mi_out;
      wwm_mi_enospc:
        mov rdi, 2;
        call wwm_note;
        mov rax, 0xFFFFF1C4;
        jmp wwm_mi_out;
      wwm_mi_bad_arg:
        mov rax, 0xFFFFF1CE;

      wwm_mi_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Revoke.
  // ==========================================================================

  pub let wwan_modem_cap_revoke_inner : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R40.M4-001 (#1360): revoke KIND_WWAN_MODEM. Labels prefixed wwm_rvk_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rdi;

        mov r10, 256;
        cmp r12, r10;
        jae wwm_rvk_bad_slot;

        mov rax, cap_table;
        mov r8, r12;
        shl r8, 3;
        mov r9, r12;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov rbx, rax;

        mov r10, [rbx + 0];
        cmp r10, 0;
        je  wwm_rvk_already;

        mov r11, 0x180;
        cmp r10, r11;
        jne wwm_rvk_wrong_kind;

        mov r13, [rbx + 16];
        mov r10, 0xFFFF;
        and r13, r10;

        mov rdi, r13;
        call wwm_tail_valid;
        cmp rax, 0;
        je  wwm_rvk_clear;

        mov rdi, r13;
        call wwm_tail_free;

      wwm_rvk_clear:
        mov rdi, r12;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        mov rdi, 1;
        call wwm_note;

        xor rax, rax;
        jmp wwm_rvk_out;

      wwm_rvk_bad_slot:
        mov rax, 0xFFFFF1C3;
        jmp wwm_rvk_out;
      wwm_rvk_wrong_kind:
        mov rax, 0xFFFFF1C2;
        jmp wwm_rvk_out;
      wwm_rvk_already:
        mov rax, 0xFFFFF1C1;

      wwm_rvk_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Dispatch handler. Queries only.
  // ==========================================================================

  pub let cap_handler_wwan_modem : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R40.M4-001 (#1360): KIND_WWAN_MODEM dispatch. All ops arity ONE -- op_arg[63:8] REFUSED. Query ops require INVOKE; DEBUG_PRINT requires OBSERVE. Labels prefixed wwm_hn_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push rbp;

        mov r12, rdi;
        mov r13, rsi;
        mov r10, 0xFFFF;
        and r13, r10;
        mov r14, rdx;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_wwan_modem_msg];
        call klog_s1;

        mov r10, r14;
        and r10, 0xFF;
        mov rbp, r10;
        mov r11, r14;
        shr r11, 8;
        cmp r11, 0;
        jne wwm_hn_res;

        cmp rbp, 6;
        ja  wwm_hn_unsup;

        cmp rbp, 6;
        je  wwm_hn_dbg;

        // Ops 0..5: INVOKE.
        mov r10, r12;
        and r10, 0x008;
        cmp r10, 0;
        je  wwm_hn_denied;

        mov rdi, r13;
        cmp rbp, 0;
        je  wwm_hn_key;
        cmp rbp, 1;
        je  wwm_hn_dev;
        cmp rbp, 2;
        je  wwm_hn_vend;
        cmp rbp, 3;
        je  wwm_hn_prod;
        cmp rbp, 4;
        je  wwm_hn_form;
        call wwm_row_pwr;
        jmp wwm_hn_out;

      wwm_hn_key:
        call wwm_row_key;
        jmp wwm_hn_out;
      wwm_hn_dev:
        call wwm_row_device;
        jmp wwm_hn_out;
      wwm_hn_vend:
        call wwm_row_vendor;
        jmp wwm_hn_out;
      wwm_hn_prod:
        call wwm_row_product;
        jmp wwm_hn_out;
      wwm_hn_form:
        call wwm_row_form;
        jmp wwm_hn_out;

      wwm_hn_dbg:
        mov r10, r12;
        and r10, 0x400;
        cmp r10, 0;
        je  wwm_hn_denied;
        xor rax, rax;
        jmp wwm_hn_out;

      wwm_hn_res:
        mov rax, 0xFFFFF1CE;
        jmp wwm_hn_out;
      wwm_hn_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;
        jmp wwm_hn_out;
      wwm_hn_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;

      wwm_hn_out:
        pop rbp;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
