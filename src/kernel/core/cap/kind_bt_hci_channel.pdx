// src/kernel/core/cap/kind_bt_hci_channel.pdx — R39.M1-003 (#1325)
//
// KIND_BT_HCI_CHANNEL = 0x183, derived over KIND_IPC_ENDPOINT (5).
//
// One live HCI (Host Controller Interface) transport channel: a chan_key
// naming the channel, the KIND_IPC_ENDPOINT the client drives HCI
// packets over, the KIND_BT_ADAPTER slot naming which adapter the
// channel binds to, a direction ordinal (host->controller / controller->
// host), and a packet_type ordinal (CMD / ACL / SCO / EVT) per BT
// Core §4.
//
// =============================================================================
// §0  WHY THIS KIND EXISTS
// =============================================================================
//
// HCI transport (BT §4) is a MULTI-CHANNEL substrate: commands travel
// host->controller (packet_type = CMD), events travel controller->host
// (packet_type = EVT), and ACL / SCO data can travel in either
// direction.  A subscriber that carries an authority to WRITE a CMD
// packet must not also carry the authority to write an EVT packet, or
// the direction gate on the CNVi transport (hci_cnvi.pdx) will refuse
// on the first attempt to inject a host-authored EVT.  The kind
// discriminates that -- direction and packet_type are FROZEN on mint
// and the packer for each HCI verb consults them.
//
// The KIND_IPC_ENDPOINT parent is the endpoint the HCI transport
// accepts packets on.  Like every KIND_IPC_ENDPOINT-derived kind in
// this tree (KIND_WIFI_VIF, KIND_GPU_SUBMIT, KIND_MODESET_TXN,
// KIND_BT_GATT_CONNECTION, ...), the parent kind alone discriminates
// NOTHING; the mint gates below cover the rest.
//
// =============================================================================
// §1  DERIVATION OVER KIND_IPC_ENDPOINT
// =============================================================================
//
// The gate demands `kind == KIND_IPC_ENDPOINT (5)` carrying RIGHT_MINT.
// A mint additionally requires:
//
//   (a) chan_key non-zero and unique among live rows (NO_KEY / IN_USE)
//   (b) endpoint_slot names a live KIND_IPC_ENDPOINT with RIGHT_MINT
//       (this is the parent_slot itself)
//   (c) adapter_slot names a live KIND_BT_ADAPTER (BAD_ADAPTER)
//   (d) direction in {KBHC_DIR_H2C, KBHC_DIR_C2H} (BAD_DIR)
//   (e) packet_type in {KBHC_PKT_CMD, KBHC_PKT_ACL, KBHC_PKT_SCO,
//       KBHC_PKT_EVT} (BAD_PKT)
//   (f) rights subset of R_KBHC_ALL (R_MINT ABSENT from the mask)
//
// =============================================================================
// §2  ROW LAYOUT — 32 BYTES EXACTLY
// =============================================================================
//
//   [+0]  header:  in_use[63:56] | parent_slot[15:8]
//   [+8]  chan_key    (u64)
//   [+16] body1:   endpoint_slot[31:0] | adapter_slot[63:32]
//   [+24] body2:   direction[7:0] | packet_type[15:8] | reserved[63:16]
//
// Every field is set once at mint and there is no primitive here that
// mutates any of them.  Revoke scrubs the entire row.
//
// =============================================================================
// §3  FAILURE TAXONOMY 0xFFFFF130..0xFFFFF13F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent used band above: kind_bt_adapter
// 0xFFFFF140..4F; adjacent free band below: hci_cnvi transport
// 0xFFFFF120..2F).

module KindBtHciChannel = structure {

  pub let KIND_BT_HCI_CHANNEL : u64 = 0x183
  pub let KBHC_PARENT_KIND    : u64 = 5           // = KIND_IPC_ENDPOINT

  // Direction ordinals.
  pub let KBHC_DIR_H2C : u64 = 0                  // host -> controller
  pub let KBHC_DIR_C2H : u64 = 1                  // controller -> host
  pub let KBHC_DIR_MAX : u64 = 1

  // Packet-type ordinals (BT §4.1).
  pub let KBHC_PKT_CMD : u64 = 1
  pub let KBHC_PKT_ACL : u64 = 2
  pub let KBHC_PKT_SCO : u64 = 3
  pub let KBHC_PKT_EVT : u64 = 4
  pub let KBHC_PKT_MIN : u64 = 1
  pub let KBHC_PKT_MAX : u64 = 4

  // Rights.  R_MINT (0x200) NOT in the mask.
  pub let R_KBHC_READ    : u64 = 0x001
  pub let R_KBHC_WRITE   : u64 = 0x002
  pub let R_KBHC_INVOKE  : u64 = 0x008
  pub let R_KBHC_REVOKE  : u64 = 0x010
  pub let R_KBHC_OBSERVE : u64 = 0x400
  pub let R_KBHC_ALL     : u64 = 0x41B

  // Ops.  Every op takes NO OPERAND -- op_arg[63:8] REFUSED.
  pub let KBHC_OP_QUERY_KEY       : u64 = 0
  pub let KBHC_OP_QUERY_ENDPOINT  : u64 = 1
  pub let KBHC_OP_QUERY_ADAPTER   : u64 = 2
  pub let KBHC_OP_QUERY_DIR       : u64 = 3
  pub let KBHC_OP_QUERY_PKT       : u64 = 4
  pub let KBHC_OP_DEBUG_PRINT     : u64 = 5
  pub let KBHC_OP_MAX             : u64 = 5

  // Failure taxonomy -- 0xFFFFF130..0xFFFFF13F.
  pub let KBHC_OK                 : u64 = 0
  pub let KBHC_TAIL_ENOSPC        : u64 = 0xFFFFF13F
  pub let KBHC_TAIL_BAD_ARG       : u64 = 0xFFFFF13E
  pub let KBHC_MINT_BAD_PARENT    : u64 = 0xFFFFF13D
  pub let KBHC_MINT_BAD_RIGHTS    : u64 = 0xFFFFF13C
  pub let KBHC_MINT_BAD_ADAPTER   : u64 = 0xFFFFF13B
  pub let KBHC_MINT_BAD_DIR       : u64 = 0xFFFFF13A
  pub let KBHC_MINT_BAD_PKT       : u64 = 0xFFFFF139
  pub let KBHC_MINT_NO_KEY        : u64 = 0xFFFFF138
  pub let KBHC_MINT_ENOSPC        : u64 = 0xFFFFF137
  pub let KBHC_MINT_IN_USE        : u64 = 0xFFFFF136
  pub let KBHC_BAD_SLOT           : u64 = 0xFFFFF135
  pub let KBHC_WRONG_KIND         : u64 = 0xFFFFF134
  pub let KBHC_REVOKE_ALREADY     : u64 = 0xFFFFF133
  pub let KBHC_RESERVED_ZERO      : u64 = 0xFFFFF132
  pub let KBHC_MINT_UNUSED_A      : u64 = 0xFFFFF131
  pub let KBHC_MINT_UNUSED_B      : u64 = 0xFFFFF130

  pub let KBHC_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let KBHC_ROW_NONE   : u64 = 0xFF

  pub let KBHC_MAX       : u64 = 8
  pub let KBHC_ROW_BYTES : u64 = 32

  pub let mut _bt_hci_chan_table : [u64; 32] = uninit @align(64)
  pub let mut _bt_hci_chan_stats : [u64; 4]  = uninit @align(64)

  pub let KBHC_ST_MINTS   : u64 = 0
  pub let KBHC_ST_REVOKES : u64 = 1
  pub let KBHC_ST_REFUSED : u64 = 2
  pub let KBHC_ST_QUERIES : u64 = 3

  pub let kbhc_dbg_msg : [u8; 20] = "BT HCI CHAN ROW\0\0\0\0\0"

  // ==========================================================================
  // Table reset.
  // ==========================================================================

  pub let bt_hci_chan_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M1-003 (#1325): clear KIND_BT_HCI_CHANNEL row table + counters. Boot and teardown only. Labels prefixed kbhc_rs_.",
      block: {
        lea r10, [rip + _bt_hci_chan_table];
        xor rax, rax;
        xor rcx, rcx;
      kbhc_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  kbhc_rs_rows;

        lea r10, [rip + _bt_hci_chan_stats];
        xor rcx, rcx;
      kbhc_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  kbhc_rs_stats;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let kbhc_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M1-003 (#1325): subset test against R_KBHC_ALL = 0x41B. R_MINT (0x200) OUTSIDE the mask. Labels prefixed kbhc_rv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x41B;
        and rax, r10;
        cmp rax, rdi;
        jne kbhc_rv_no;
        mov rax, 1;
        ret;
      kbhc_rv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let kbhc_dir_valid : (u64) -> u64 !{} @{} =
    fn (d: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M1-003 (#1325): 1 iff d <= KBHC_DIR_MAX (1). Labels prefixed kbhc_dv_.",
      block: {
        cmp rdi, 1;
        ja  kbhc_dv_no;
        mov rax, 1;
        ret;
      kbhc_dv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let kbhc_pkt_valid : (u64) -> u64 !{} @{} =
    fn (p: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M1-003 (#1325): 1 iff p in [1,4] (CMD/ACL/SCO/EVT). Labels prefixed kbhc_pv_.",
      block: {
        cmp rdi, 1;
        jb  kbhc_pv_no;
        cmp rdi, 4;
        ja  kbhc_pv_no;
        mov rax, 1;
        ret;
      kbhc_pv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Counters.
  // ==========================================================================

  pub let kbhc_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M1-003 (#1325): counter bump. Labels prefixed kbhc_nt_.",
      block: {
        cmp rdi, 4;
        jae kbhc_nt_out;
        lea r10, [rip + _bt_hci_chan_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      kbhc_nt_out:
        ret
      }
    } @no_frame

  pub let kbhc_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M1-003 (#1325): counter read. Labels prefixed kbhc_stt_.",
      block: {
        cmp rdi, 4;
        jae kbhc_stt_zero;
        lea r10, [rip + _bt_hci_chan_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      kbhc_stt_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Parent gate: live KIND_IPC_ENDPOINT (5) with RIGHT_MINT.
  // ==========================================================================

  pub let kbhc_check_parent : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R39.M1-003 (#1325): parent must be live KIND_IPC_ENDPOINT (5) with RIGHT_MINT. Labels prefixed kbhc_cp_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae kbhc_cp_no;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 5;
        jne kbhc_cp_no;

        mov r10, [rax + 8];
        mov r11, 0x200;
        and r10, r11;
        cmp r10, 0;
        je  kbhc_cp_no;

        mov rax, 1;
        ret;
      kbhc_cp_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Adapter gate: live KIND_BT_ADAPTER (0x182) at adapter_slot.
  // ==========================================================================

  pub let kbhc_check_adapter : (u64) -> u64 !{mem} @{cap} =
    fn (adapter_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R39.M1-003 (#1325): adapter_slot must name a live KIND_BT_ADAPTER. Labels prefixed kbhc_ca_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae kbhc_ca_no;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x182;
        cmp r10, r11;
        jne kbhc_ca_no;

        mov rax, 1;
        ret;
      kbhc_ca_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Header + body packers.
  // ==========================================================================

  pub let kbhc_hdr_pack : (u64) -> u64 !{} @{} =
    fn (parent_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M1-003 (#1325): (parent_slot << 8). Labels prefixed kbhc_hp_.",
      block: {
        mov r10, 256;
        cmp rdi, r10;
        jae kbhc_hp_bad;
        mov rax, rdi;
        shl rax, 8;
        ret;
      kbhc_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  pub let kbhc_body1_pack : (u64, u64) -> u64 !{} @{} =
    fn (endpoint_slot: u64) (adapter_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M1-003 (#1325): pack endpoint_slot[31:0] | adapter_slot[63:32]. Labels prefixed kbhc_b1_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  kbhc_b1_bad;
        cmp rsi, r10;
        ja  kbhc_b1_bad;

        mov rax, rdi;
        and rax, 0xFFFFFFFF;
        mov r10, rsi;
        and r10, 0xFFFFFFFF;
        shl r10, 32;
        or  rax, r10;
        ret;
      kbhc_b1_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  pub let kbhc_body2_pack : (u64, u64) -> u64 !{} @{} =
    fn (direction: u64) (packet_type: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M1-003 (#1325): pack direction[7:0] | packet_type[15:8] | reserved[63:16]=0. Labels prefixed kbhc_b2_.",
      block: {
        cmp rdi, 1;
        ja  kbhc_b2_bad;
        cmp rsi, 4;
        ja  kbhc_b2_bad;
        cmp rsi, 1;
        jb  kbhc_b2_bad;

        mov rax, rdi;
        and rax, 0xFF;
        mov r10, rsi;
        and r10, 0xFF;
        shl r10, 8;
        or  rax, r10;
        ret;
      kbhc_b2_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Tail alloc / valid / free -- THE ONE WRITER of _bt_hci_chan_table.
  // ==========================================================================

  pub let kbhc_tail_alloc : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (chan_key: u64) (body1: u64) (body2: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M1-003 (#1325): claim one BT HCI CHANNEL row. THE ONE WRITER. Labels prefixed kbhc_ta_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov r15, rcx;

        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne kbhc_ta_bad;

        cmp r13, 0;
        je  kbhc_ta_bad;

        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp r14, r10;
        je  kbhc_ta_bad;
        cmp r15, r10;
        je  kbhc_ta_bad;

        xor rbx, rbx;
      kbhc_ta_scan:
        cmp rbx, 8;
        jae kbhc_ta_enospc;

        lea r10, [rip + _bt_hci_chan_table];
        mov r11, rbx;
        shl r11, 5;
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  kbhc_ta_claim;

        add rbx, 1;
        jmp kbhc_ta_scan;

      kbhc_ta_claim:
        mov rax, r12;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r13;
        mov [r10 + 16], r14;
        mov [r10 + 24], r15;
        mov rax, rbx;
        jmp kbhc_ta_out;

      kbhc_ta_enospc:
        mov rax, 0xFFFFF13F;
        jmp kbhc_ta_out;
      kbhc_ta_bad:
        mov rax, 0xFFFFF13E;

      kbhc_ta_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let kbhc_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M1-003 (#1325): 1 iff row_id<MAX and in_use. Labels prefixed kbhc_tvr_.",
      block: {
        cmp rdi, 8;
        jae kbhc_tvr_no;
        lea r10, [rip + _bt_hci_chan_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  kbhc_tvr_no;
        mov rax, 1;
        ret;
      kbhc_tvr_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let kbhc_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M1-003 (#1325): scrub one row. Labels prefixed kbhc_tf_.",
      block: {
        cmp rdi, 8;
        jae kbhc_tf_out;
        lea r10, [rip + _bt_hci_chan_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
      kbhc_tf_out:
        ret
      }
    } @no_frame

  // ==========================================================================
  // Row accessors.
  // ==========================================================================

  pub let kbhc_row_key : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M1-003 (#1325): chan_key. Labels prefixed kbhc_rk_.",
      block: {
        push r12;
        mov r12, rdi;
        call kbhc_tail_valid;
        cmp rax, 0;
        je  kbhc_rk_bad;
        lea r10, [rip + _bt_hci_chan_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 8];
        jmp kbhc_rk_out;
      kbhc_rk_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      kbhc_rk_out:
        pop r12;
        ret
      }
    }

  pub let kbhc_row_endpoint : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M1-003 (#1325): endpoint_slot (body1[31:0]). Labels prefixed kbhc_re_.",
      block: {
        push r12;
        mov r12, rdi;
        call kbhc_tail_valid;
        cmp rax, 0;
        je  kbhc_re_bad;
        lea r10, [rip + _bt_hci_chan_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        and rax, 0xFFFFFFFF;
        jmp kbhc_re_out;
      kbhc_re_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      kbhc_re_out:
        pop r12;
        ret
      }
    }

  pub let kbhc_row_adapter : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M1-003 (#1325): adapter_slot (body1[63:32]). Labels prefixed kbhc_ra_.",
      block: {
        push r12;
        mov r12, rdi;
        call kbhc_tail_valid;
        cmp rax, 0;
        je  kbhc_ra_bad;
        lea r10, [rip + _bt_hci_chan_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 32;
        and rax, 0xFFFFFFFF;
        jmp kbhc_ra_out;
      kbhc_ra_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      kbhc_ra_out:
        pop r12;
        ret
      }
    }

  pub let kbhc_row_dir : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M1-003 (#1325): direction (body2[7:0]). Labels prefixed kbhc_rd_.",
      block: {
        push r12;
        mov r12, rdi;
        call kbhc_tail_valid;
        cmp rax, 0;
        je  kbhc_rd_bad;
        lea r10, [rip + _bt_hci_chan_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 24];
        and rax, 0xFF;
        jmp kbhc_rd_out;
      kbhc_rd_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      kbhc_rd_out:
        pop r12;
        ret
      }
    }

  pub let kbhc_row_pkt : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M1-003 (#1325): packet_type (body2[15:8]). Labels prefixed kbhc_rp_.",
      block: {
        push r12;
        mov r12, rdi;
        call kbhc_tail_valid;
        cmp rax, 0;
        je  kbhc_rp_bad;
        lea r10, [rip + _bt_hci_chan_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 24];
        shr rax, 8;
        and rax, 0xFF;
        jmp kbhc_rp_out;
      kbhc_rp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      kbhc_rp_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Lookups.
  // ==========================================================================

  pub let kbhc_find_by_key : (u64) -> u64 !{mem} @{} =
    fn (chan_key: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M1-003 (#1325): live row holding chan_key, or ROW_NONE. Refuses to match 0. Labels prefixed kbhc_fk_.",
      block: {
        cmp rdi, 0;
        je  kbhc_fk_none;
        xor rcx, rcx;
      kbhc_fk_scan:
        cmp rcx, 8;
        jae kbhc_fk_none;
        lea r10, [rip + _bt_hci_chan_table];
        mov r11, rcx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  kbhc_fk_next;
        mov rax, [r10 + 8];
        cmp rax, rdi;
        je  kbhc_fk_hit;
      kbhc_fk_next:
        add rcx, 1;
        jmp kbhc_fk_scan;
      kbhc_fk_hit:
        mov rax, rcx;
        ret;
      kbhc_fk_none:
        mov rax, 0xFF;
        ret
      }
    } @no_frame

  pub let kbhc_row_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R39.M1-003 (#1325): slot -> row_id, gated on live KIND_BT_HCI_CHANNEL. Labels prefixed kbhc_ros_.",
      block: {
        push r12;

        mov r11, 256;
        cmp rdi, r11;
        jae kbhc_ros_none;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x183;
        cmp r10, r11;
        jne kbhc_ros_none;

        mov r12, [rax + 16];
        mov r10, 0xFFFF;
        and r12, r10;

        mov rdi, r12;
        call kbhc_tail_valid;
        cmp rax, 0;
        je  kbhc_ros_none;

        mov rax, r12;
        jmp kbhc_ros_out;

      kbhc_ros_none:
        mov rax, 0xFF;
      kbhc_ros_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Mint. Six args (slot, parent_slot, rights, chan_key, adapter_slot,
  // packed_dp).
  //
  //   packed_dp encoding:
  //     [7:0]    direction   (0..1)
  //     [15:8]   packet_type (1..4)
  //     [63:16]  reserved (must be zero)
  // ==========================================================================

  pub let bt_hci_chan_cap_mint_inner : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (chan_key: u64) (adapter_slot: u64) (packed_dp: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R39.M1-003 (#1325): mint KIND_BT_HCI_CHANNEL over KIND_IPC_ENDPOINT. Six-arg because adapter_slot needs its own u32 slot alongside direction+packet_type. Labels prefixed kbhc_mi_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov rbx, rdi;                    // slot
        mov r12, rsi;                    // parent_slot
        mov r13, rdx;                    // rights
        mov r14, rcx;                    // chan_key
        mov r15, r8;                     // adapter_slot
        mov rbp, r9;                     // packed_dp

        mov r10, 256;
        cmp rbx, r10;
        jae kbhc_mi_bad_slot;

        mov rdi, r12;
        call kbhc_check_parent;
        cmp rax, 0;
        je  kbhc_mi_bad_parent;

        mov rdi, r13;
        call kbhc_rights_valid;
        cmp rax, 0;
        je  kbhc_mi_bad_rights;

        // Reserved [63:16] must be zero.
        mov r10, rbp;
        shr r10, 16;
        cmp r10, 0;
        jne kbhc_mi_reserved;

        // adapter check
        mov rdi, r15;
        call kbhc_check_adapter;
        cmp rax, 0;
        je  kbhc_mi_bad_adapter;

        // direction valid
        mov r10, rbp;
        and r10, 0xFF;
        mov rdi, r10;
        call kbhc_dir_valid;
        cmp rax, 0;
        je  kbhc_mi_bad_dir;

        // packet type valid
        mov r10, rbp;
        shr r10, 8;
        and r10, 0xFF;
        mov rdi, r10;
        call kbhc_pkt_valid;
        cmp rax, 0;
        je  kbhc_mi_bad_pkt;

        cmp r14, 0;
        je  kbhc_mi_no_key;

        mov rdi, r14;
        call kbhc_find_by_key;
        cmp rax, 0xFF;
        jne kbhc_mi_in_use;

        // Body1 pack (endpoint_slot=parent_slot, adapter_slot).
        mov rdi, r12;
        mov rsi, r15;
        call kbhc_body1_pack;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  kbhc_mi_bad_arg;
        push rax;                        // body1 on stack (top)

        // Body2 pack (direction, packet_type).
        mov rdi, rbp;
        and rdi, 0xFF;
        mov rsi, rbp;
        shr rsi, 8;
        and rsi, 0xFF;
        call kbhc_body2_pack;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  kbhc_mi_bad_arg_pop1;
        push rax;                        // body2 on stack (top)

        // Header pack.
        mov rdi, r12;
        call kbhc_hdr_pack;
        pop r15;                         // body2 -> r15
        pop rbp;                         // body1 -> rbp
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  kbhc_mi_bad_parent;

        // tail_alloc(hdr, chan_key, body1, body2).
        mov rdi, rax;
        mov rsi, r14;
        mov rdx, rbp;
        mov rcx, r15;
        call kbhc_tail_alloc;

        mov r10, 0xFFFFF13F;
        cmp rax, r10;
        je  kbhc_mi_enospc;
        mov r10, 0xFFFFF13E;
        cmp rax, r10;
        je  kbhc_mi_bad_arg;

        mov r15, rax;                    // row_id
        mov r11, rbx;
        shl r11, 16;
        or  r15, r11;

        mov rdi, rbx;
        mov rsi, 0x183;
        mov rdx, r13;
        mov rcx, r15;
        call cap_mint_write;

        mov rdi, 0;
        call kbhc_note;

        xor rax, rax;
        jmp kbhc_mi_out;

      kbhc_mi_bad_arg_pop1:
        add rsp, 8;
        jmp kbhc_mi_bad_arg;

      kbhc_mi_bad_slot:
        mov rax, 0xFFFFF135;
        jmp kbhc_mi_out;
      kbhc_mi_bad_parent:
        mov rax, 0xFFFFF13D;
        jmp kbhc_mi_out;
      kbhc_mi_bad_rights:
        mov rax, 0xFFFFF13C;
        jmp kbhc_mi_out;
      kbhc_mi_bad_adapter:
        mov rax, 0xFFFFF13B;
        jmp kbhc_mi_out;
      kbhc_mi_bad_dir:
        mov rax, 0xFFFFF13A;
        jmp kbhc_mi_out;
      kbhc_mi_bad_pkt:
        mov rax, 0xFFFFF139;
        jmp kbhc_mi_out;
      kbhc_mi_no_key:
        mov rax, 0xFFFFF138;
        jmp kbhc_mi_out;
      kbhc_mi_in_use:
        mov rdi, 2;
        call kbhc_note;
        mov rax, 0xFFFFF136;
        jmp kbhc_mi_out;
      kbhc_mi_enospc:
        mov rdi, 2;
        call kbhc_note;
        mov rax, 0xFFFFF137;
        jmp kbhc_mi_out;
      kbhc_mi_reserved:
        mov rax, 0xFFFFF132;
        jmp kbhc_mi_out;
      kbhc_mi_bad_arg:
        mov rax, 0xFFFFF13E;

      kbhc_mi_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Revoke.
  // ==========================================================================

  pub let bt_hci_chan_cap_revoke_inner : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R39.M1-003 (#1325): revoke KIND_BT_HCI_CHANNEL. Labels prefixed kbhc_rvk_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rdi;

        mov r10, 256;
        cmp r12, r10;
        jae kbhc_rvk_bad_slot;

        mov rax, cap_table;
        mov r8, r12;
        shl r8, 3;
        mov r9, r12;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov rbx, rax;

        mov r10, [rbx + 0];
        cmp r10, 0;
        je  kbhc_rvk_already;

        mov r11, 0x183;
        cmp r10, r11;
        jne kbhc_rvk_wrong_kind;

        mov r13, [rbx + 16];
        mov r10, 0xFFFF;
        and r13, r10;

        mov rdi, r13;
        call kbhc_tail_valid;
        cmp rax, 0;
        je  kbhc_rvk_clear;

        mov rdi, r13;
        call kbhc_tail_free;

      kbhc_rvk_clear:
        mov rdi, r12;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        mov rdi, 1;
        call kbhc_note;

        xor rax, rax;
        jmp kbhc_rvk_out;

      kbhc_rvk_bad_slot:
        mov rax, 0xFFFFF135;
        jmp kbhc_rvk_out;
      kbhc_rvk_wrong_kind:
        mov rax, 0xFFFFF134;
        jmp kbhc_rvk_out;
      kbhc_rvk_already:
        mov rax, 0xFFFFF133;

      kbhc_rvk_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Dispatch handler.  Queries only.
  // ==========================================================================

  pub let cap_handler_bt_hci_chan : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R39.M1-003 (#1325): KIND_BT_HCI_CHANNEL dispatch. Query ops require INVOKE; DEBUG_PRINT requires OBSERVE. All ops arity ONE -- op_arg[63:8] REFUSED. Labels prefixed kbhc_hn_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push rbp;

        mov r12, rdi;
        mov r13, rsi;
        mov r10, 0xFFFF;
        and r13, r10;
        mov r14, rdx;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_bt_hci_chan_msg];
        call klog_s1;

        mov r10, r14;
        and r10, 0xFF;
        mov rbp, r10;
        mov r11, r14;
        shr r11, 8;
        cmp r11, 0;
        jne kbhc_hn_res;

        cmp rbp, 5;
        ja  kbhc_hn_unsup;

        cmp rbp, 5;
        je  kbhc_hn_dbg;

        // Ops 0..4: INVOKE.
        mov r10, r12;
        and r10, 0x008;
        cmp r10, 0;
        je  kbhc_hn_denied;

        mov rdi, r13;
        cmp rbp, 0;
        je  kbhc_hn_key;
        cmp rbp, 1;
        je  kbhc_hn_ep;
        cmp rbp, 2;
        je  kbhc_hn_adap;
        cmp rbp, 3;
        je  kbhc_hn_dir;
        call kbhc_row_pkt;
        jmp kbhc_hn_out;

      kbhc_hn_key:
        call kbhc_row_key;
        jmp kbhc_hn_out;
      kbhc_hn_ep:
        call kbhc_row_endpoint;
        jmp kbhc_hn_out;
      kbhc_hn_adap:
        call kbhc_row_adapter;
        jmp kbhc_hn_out;
      kbhc_hn_dir:
        call kbhc_row_dir;
        jmp kbhc_hn_out;

      kbhc_hn_dbg:
        mov r10, r12;
        and r10, 0x400;
        cmp r10, 0;
        je  kbhc_hn_denied;
        xor rax, rax;
        jmp kbhc_hn_out;

      kbhc_hn_res:
        mov rax, 0xFFFFF13E;
        jmp kbhc_hn_out;
      kbhc_hn_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;
        jmp kbhc_hn_out;
      kbhc_hn_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;

      kbhc_hn_out:
        pop rbp;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
