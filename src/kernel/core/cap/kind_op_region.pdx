// src/kernel/core/cap/kind_op_region.pdx — R30.M3-001 (#1061)
//
// KIND_OP_REGION derived kind: the address-space window capability.
//
// ---------------------------------------------------------------------
// WHY THIS FILE IS THE SECURITY BOUNDARY OF R30
// ---------------------------------------------------------------------
// Everything R30 has landed so far parses and evaluates firmware
// bytecode inside a sandbox: the worst outcome of a bug was a wrong
// answer or a bounded burn of fuel. This kind is where that stops. The
// firmware bytecode language has a construct that names a RAW PHYSICAL
// ADDRESS and a length and asks to read and write there. The tables that
// carry it are vendor-supplied, unsigned, and mutable by anyone who can
// reflash the part.
//
// Nothing in the bytecode language constrains that address. A table may
// name kernel text, the page tables, a driver's bus-master buffer, or
// the supervisor's own object arena, and a handler that simply
// dereferences what it was asked for hands the firmware author — or an
// attacker with a flash programmer — full read/write of the machine.
//
// The invariant this file exists to make TRUE, and to make impossible to
// forget:
//
//   A window may be opened ONLY inside a window the caller already
//   holds, and every access is derived from the held window's own
//   recorded base and length — never from the address the table asked
//   for.
//
// The mechanism is containment-on-derive plus a private row table:
//
//   * `_op_region_table` is module-private storage. It is the ONLY place
//     a {space, base, len} triple lives, and the only writer is
//     `opregion_tail_alloc`.
//   * `opregion_tail_alloc` has exactly TWO callers, both in this file:
//     `opregion_cap_mint_root_inner` and `opregion_cap_derive_inner`.
//   * The ROOT path requires a parent capability of the base kind the
//     space demands (KIND_MEMORY for memory-like spaces, KIND_IO_PORT
//     for port-like spaces) carrying RIGHT_MINT. Root windows encode
//     PLATFORM knowledge — the firmware memory map, the ECAM aperture,
//     the EC command/data ports — and are established by kernel-side
//     boot code, not by anything a table can reach.
//   * The DERIVE path is the one a firmware-declared region takes. It
//     requires a parent KIND_OP_REGION with RIGHT_MINT, and it
//     CONTAINMENT-CHECKS the requested [base, base+len) against the
//     parent row's own [base, base+len). It also inherits the space from
//     the parent rather than accepting one, so a caller cannot relabel a
//     memory window as an I/O window.
//
// There is no third way to obtain a row. "Forgot to check the
// capability" is therefore not expressible: the check is not a step
// beside the allocation, it is the only path to it. tools/build.sh
// asserts this mechanically with `objdump -r` — `_op_region_table` may
// be relocated against from kind_op_region.o and no other kernel object.
//
// ---------------------------------------------------------------------
// REFUSAL, NEVER TRUNCATION
// ---------------------------------------------------------------------
// When a table declares a window the caller holds no capability over,
// `opregion_cap_derive` returns OPREG_MINT_NO_COVER (0xFFFFFFC5) and
// allocates nothing. It does NOT clip the request down to the permitted
// subrange.
//
// That choice is load-bearing and it is the one an implementation gets
// wrong by being helpful. Silent truncation turns the capability system
// into an ORACLE: a table declares a 4 GiB region, observes that its
// accesses succeed up to offset N and fail past it, and has thereby
// measured exactly how much of the address space the supervisor holds —
// without ever being refused anything. Refusal leaks one bit ("no"),
// truncation leaks the boundary.
//
// ---------------------------------------------------------------------
// DERIVATION ASYMMETRY — and why the tail must record which
// ---------------------------------------------------------------------
// The issue title says "derived over KIND_MEMORY / KIND_PORT", and the
// slash is not a convenience. A memory-space window and a port-space
// window are different authorities over different namespaces, and the
// reasoning is R29.M5-001's (#1036), one lattice over:
//
//   A memory-space window MUST derive over KIND_MEMORY. Deriving it over
//   KIND_IO_PORT — or over any weaker handle — would let a holder of
//   port authority manufacture memory reach, which is precisely the
//   privilege inversion the capability lattice exists to forbid. The
//   converse holds symmetrically.
//
// Because ONE derived-kind tag covers both, the row must record which
// namespace it is in, and the mint gate must compare the parent's base
// kind against the space's requirement rather than accepting either.
// `opregion_space_base_kind` is that table, and it is the single source
// of truth for the asymmetry.
//
// ---------------------------------------------------------------------
// ADDRESS SPACES (ACPI 6.5 §19.6.102 RegionSpaceKeyword)
// ---------------------------------------------------------------------
//   0x00 SystemMemory      memory-like  -> KIND_MEMORY   (R30.M3-002 #1062)
//   0x01 SystemIO          port-like    -> KIND_IO_PORT  (R30.M3-003 #1063)
//   0x02 PCI_Config        memory-like  -> KIND_MEMORY   (R30.M3-004 #1064)
//   0x03 EmbeddedControl   port-like    -> KIND_IO_PORT  (R30.M3-005 #1065)
//   0x05 SystemCMOS        port-like    -> KIND_IO_PORT
//   0x06 PciBarTarget      memory-like  -> KIND_MEMORY
//   0x0A PCC               memory-like  -> KIND_MEMORY
//
// PCI_Config is memory-like because this platform reaches configuration
// space through the ECAM aperture landed in R22 — an MMIO window — not
// through the 0xCF8/0xCFC port pair. Recording it as port-like would
// make the mint gate demand the wrong parent authority and would make
// the R30.M3-004 handler's containment check meaningless.
//
// Deliberately ABSENT, and refused with OPREG_MINT_BAD_SPACE:
//   0x04 SMBus, 0x07 IPMI, 0x08 GeneralPurposeIO, 0x09 GenericSerialBus
//
// Those four are not address spaces at all — they are BUS spaces, whose
// accesses are transactions on a serial bus, not loads and stores. They
// have their own capabilities in this round's catalog (KIND_I2C_BUS,
// KIND_I2C_SLAVE, KIND_GPIO_LINE). Admitting them here would require
// this kind to carry a {base, len} pair that means nothing for them, and
// a containment check over a coordinate that is not an address. Refusing
// them keeps this kind's invariant exactly one sentence long.
//
// ---------------------------------------------------------------------
// DESCRIPTOR TAIL — row indirection (KIND_HW_INTERRUPT #1019 /
// KIND_HW_MSIX_VECTOR #1022 / KIND_DMA_DOMAIN #1036 shape)
// ---------------------------------------------------------------------
// The tail is {space:u8, base:u64, len:u64, parent_slot:u8,
// parent_row:u16, is_root:u1} = 155 live bits. It does not fit the
// descriptor's 64-bit target_ptr, so `target_ptr` holds a `row_id` in
// bits [15:0] (bits [63:16] MUST be zero) and the payload lives in a
// kernel-owned private table. This is deliberately the SAME indirection
// as the three kinds above; a fourth encoding would fragment the
// revoke/cascade reasoning across the whole family.
//
// Row layout — `_op_region_table[row_id]`, 32 bytes (four u64s):
//
//   [+0]  u64:  bits [7:0]   = space        (RegionSpaceKeyword)
//               bits [15:8]  = parent_slot  (cap_table slot of the cap
//                                            this row was derived from —
//                                            a KIND_MEMORY / KIND_IO_PORT
//                                            for a root, a KIND_OP_REGION
//                                            for a derived row. One field
//                                            for both because the cascade
//                                            walk asks one question:
//                                            "whose child is this?")
//               bit  [16]    = is_root      (1 = platform window, 0 =
//                                            derived sub-window)
//               bits [23:17] = reserved (must be zero)
//               bits [39:24] = parent_row   (u16; row_id of the parent
//                                            KIND_OP_REGION, 0xFFFF for a
//                                            root)
//               bits [55:40] = reserved (must be zero)
//               bits [63:56] = in_use       (0 = free, 1 = allocated)
//   [+8]  u64:  base — physical address for a memory-like space, port
//               number for a port-like space. Full u64: a root window
//               above the 4 GiB line must be representable.
//   [+16] u64:  len — length in BYTES. Full u64 for the same reason.
//               Zero is rejected at allocation: a window that admits no
//               access is indistinguishable from no window, and admitting
//               it would let a caller mint a capability whose only effect
//               is to consume a scarce row.
//   [+24] u64:  reserved (must be zero) — R30.M4 access accounting.
//
// Bits [63:56] of a caller-supplied header word are structurally
// reserved: `opregion_tail_pack` refuses to produce one with those bits
// set and `opregion_tail_alloc` refuses to accept one, which is what
// lets the allocator OR in the in_use flag with no read-modify-write
// hazard. Same device as `dma_tail_alloc`.
//
// ---------------------------------------------------------------------
// RIGHTS
// ---------------------------------------------------------------------
//   R_OPREG_READ    (0x001 = RIGHT_READ)    — the window may be read
//   R_OPREG_WRITE   (0x002 = RIGHT_WRITE)   — the window may be written
//   R_OPREG_INVOKE  (0x008 = RIGHT_INVOKE)  — the query ops
//   R_OPREG_REVOKE  (0x010 = RIGHT_REVOKE)  — supervisor teardown
//   R_OPREG_MINT    (0x200 = RIGHT_MINT)    — DERIVE a sub-window
//   R_OPREG_OBSERVE (0x400 = RIGHT_OBSERVE) — the canonical debug printer
//   R_OPREG_ALL     (0x61B) — bitwise OR of the six.
//
// READ and WRITE are separate here, unlike KIND_DMA_DOMAIN, because a
// READ-ONLY window is a shape this round actually needs: a thermal or
// battery region the supervisor may sample but must never poke. Folding
// both into RIGHT_INVOKE would make that unexpressible and would mean
// every region handed out for a query also carried the authority to
// write hardware.
//
// DERIVE IS MONOTONE. `opregion_cap_derive` requires
// `(child_rights & parent_rights) == child_rights`. A sub-window can
// only ever be narrower in rights as well as in extent, so no chain of
// derivations can end up holding more than its root did. Without this
// the containment check would still hold on ADDRESSES while leaking
// authority on OPERATIONS — a read-only 4 KiB window could derive a
// writable 4 KiB window inside itself.
//
// ---------------------------------------------------------------------
// REVOKE + CASCADE
// ---------------------------------------------------------------------
// `opregion_cap_revoke(slot)` verifies kind == 0x150, frees and scrubs
// the row, and clears the descriptor. Idempotent on a null slot.
//
// `opregion_cascade_revoke_by_parent(parent_slot) -> count` revokes
// every KIND_OP_REGION whose row records that parent, TRANSITIVELY.
// The transitive part is the whole point and is why this cascade is a
// fixed-point loop rather than the single scan KIND_DMA_DOMAIN uses: a
// window can be derived from a window, so revoking a root must also
// revoke its grandchildren. A single pass would leave a grandchild row
// alive whose recorded base and length still describe memory the
// revoked root was the only justification for — a live handle to an
// address nobody owns any more, which is the exact failure this kind
// exists to prevent. The loop repeats the full scan until a pass revokes
// nothing; it terminates because each pass that continues frees at least
// one of OPREG_MAX rows, so at most OPREG_MAX+1 passes run.
//
// ---------------------------------------------------------------------
// TABLE SIZING
// ---------------------------------------------------------------------
// OPREG_MAX = 32. A real DSDT declares on the order of a dozen
// OperationRegions; 32 covers the platform roots plus that with room,
// and matches the R30.M1 fixture-scale sizing of the userspace arenas.
// Storage: 32 * 32 = 1024 bytes .bss, align 64.

module KindOpRegion = structure {

  // ==========================================================================
  // Kind tags
  //
  // 0x150 opens the R30 derived-kind block. The R29 block (0x140
  // interrupt, 0x141 msix, 0x142 dma domain, 0x143 timeline reserved) is
  // left contiguous and untouched. As with every derived tag, 0x150 is
  // above the 4-bit base-slot range so the LAM kind-hint is unaffected.
  // ==========================================================================

  pub let KIND_OP_REGION : u64 = 0x150     // derived-kind tag (decimal 336)

  // The two legal base kinds. Which one a given row derives over is a
  // function of its space, not a free choice — see opregion_space_base_kind.
  pub let OPREG_BASE_MEMORY : u64 = 4      // = KIND_MEMORY (= KIND_PAGE)
  pub let OPREG_BASE_PORT   : u64 = 11     // = KIND_IO_PORT

  // ==========================================================================
  // Rights
  // ==========================================================================

  pub let R_OPREG_READ    : u64 = 0x001
  pub let R_OPREG_WRITE   : u64 = 0x002
  pub let R_OPREG_INVOKE  : u64 = 0x008
  pub let R_OPREG_REVOKE  : u64 = 0x010
  pub let R_OPREG_MINT    : u64 = 0x200
  pub let R_OPREG_OBSERVE : u64 = 0x400
  pub let R_OPREG_ALL     : u64 = 0x61B

  // ==========================================================================
  // Address spaces
  // ==========================================================================

  pub let OPREG_SPACE_SYSTEM_MEMORY : u64 = 0x00
  pub let OPREG_SPACE_SYSTEM_IO     : u64 = 0x01
  pub let OPREG_SPACE_PCI_CONFIG    : u64 = 0x02
  pub let OPREG_SPACE_EC            : u64 = 0x03
  pub let OPREG_SPACE_SMBUS         : u64 = 0x04
  pub let OPREG_SPACE_CMOS          : u64 = 0x05
  pub let OPREG_SPACE_PCI_BAR       : u64 = 0x06
  pub let OPREG_SPACE_IPMI          : u64 = 0x07
  pub let OPREG_SPACE_GPIO          : u64 = 0x08
  pub let OPREG_SPACE_GSBUS         : u64 = 0x09
  pub let OPREG_SPACE_PCC           : u64 = 0x0A
  pub let OPREG_SPACE_MAX           : u64 = 0x0A

  // ==========================================================================
  // Table caps
  // ==========================================================================

  pub let OPREG_MAX       : u64 = 32
  pub let OPREG_ROW_BYTES : u64 = 32

  // Sentinel parent_row for a root window.
  pub let OPREG_NO_PARENT_ROW : u64 = 0xFFFF

  // ==========================================================================
  // Return codes
  //
  // Block 0xFFFFFFC2..0xFFFFFFCF — disjoint from DMA_* (0xFFFFFFD5..
  // 0xFFFFFFDF), MSIX_* (0xFFFFFFE7..0xFFFFFFEF) and HW_INT_*
  // (0xFFFFFFF7..0xFFFFFFFF), so a witness failure names its originating
  // kind unambiguously.
  // ==========================================================================

  pub let OPREG_TAIL_OK          : u64 = 0
  pub let OPREG_TAIL_ENOSPC      : u64 = 0xFFFFFFCF
  pub let OPREG_TAIL_BAD_ARG     : u64 = 0xFFFFFFCE
  pub let OPREG_TAIL_BAD_SPACE   : u64 = 0xFFFFFFCD
  pub let OPREG_TAIL_BAD_RANGE   : u64 = 0xFFFFFFCC

  pub let OPREG_MINT_OK          : u64 = 0
  pub let OPREG_MINT_BAD_PARENT  : u64 = 0xFFFFFFCB
  pub let OPREG_MINT_BAD_RIGHTS  : u64 = 0xFFFFFFCA
  pub let OPREG_MINT_ENOSPC      : u64 = 0xFFFFFFC9
  pub let OPREG_MINT_BAD_ARG     : u64 = 0xFFFFFFC8
  pub let OPREG_MINT_BAD_SPACE   : u64 = 0xFFFFFFC7
  pub let OPREG_MINT_BAD_RANGE   : u64 = 0xFFFFFFC6

  // THE HEADLINE REFUSAL. A window was requested that the parent
  // capability does not cover. Nothing was allocated, nothing was
  // clipped, and no descriptor was written.
  pub let OPREG_MINT_NO_COVER    : u64 = 0xFFFFFFC5

  pub let OPREG_REVOKE_OK        : u64 = 0
  pub let OPREG_REVOKE_BAD_SLOT  : u64 = 0xFFFFFFC4
  pub let OPREG_REVOKE_WRONG_KIND: u64 = 0xFFFFFFC3
  pub let OPREG_REVOKE_ALREADY   : u64 = 0xFFFFFFC2

  // Cannot collide with a well-formed header word (bits [63:56] of a
  // well-formed word are zero before the allocator sets in_use, and
  // 0xFF there means 255 concurrent uses of a 1-bit flag).
  pub let OPREG_DECODE_BAD       : u64 = 0xFFFFFFFFFFFFFFFF

  // ==========================================================================
  // Ops (op_arg[7:0] = op_code) and their required right
  // ==========================================================================

  pub let OPREG_OP_QUERY_SPACE  : u64 = 0   // INVOKE  -> space
  pub let OPREG_OP_QUERY_BASE   : u64 = 1   // INVOKE  -> base
  pub let OPREG_OP_QUERY_LEN    : u64 = 2   // INVOKE  -> len
  pub let OPREG_OP_QUERY_PARENT : u64 = 3   // INVOKE  -> parent_slot
  pub let OPREG_OP_QUERY_ROOT   : u64 = 4   // INVOKE  -> is_root
  pub let OPREG_OP_DEBUG_PRINT  : u64 = 5   // OBSERVE -> canonical printer

  // ==========================================================================
  // Backing table (.bss, align 64) — MODULE-PRIVATE BY CONSTRUCTION.
  //
  // 32 rows * 32 bytes = 1024 bytes = 128 u64s. .bss zero-init means
  // every row starts in_use = 0, which is the free sentinel the
  // allocator scans for.
  //
  // tools/build.sh asserts with `objdump -r` that no kernel object other
  // than kind_op_region.o relocates against this symbol. That assertion
  // is what upgrades "the containment check is the only path to a row"
  // from a claim about this file to a property of the whole kernel.
  // ==========================================================================

  pub let mut _op_region_table : [u64; 128] = uninit @align(64)

  // ==========================================================================
  // Canonical debug-printer strings (.rodata)
  // ==========================================================================

  pub let opr_dbg_msg : [u8; 15] = "OP REGION ROW\0"
  pub let opr_k_row   : [u8; 4]  = "row\0"
  pub let opr_k_spc   : [u8; 4]  = "spc\0"
  pub let opr_k_bas   : [u8; 4]  = "bas\0"
  pub let opr_k_len   : [u8; 4]  = "len\0"

  // ==========================================================================
  // opregion_space_base_kind(space) -> u64
  //
  // THE DERIVATION ASYMMETRY, as a table. Returns OPREG_BASE_MEMORY (4)
  // for a memory-like space, OPREG_BASE_PORT (11) for a port-like space,
  // and OPREG_DECODE_BAD for a bus space or an unknown keyword.
  // ==========================================================================

  pub let opregion_space_base_kind : (u64) -> u64 !{} @{} =
    fn (space: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R30.M3-001 (#1061): the single source of truth for which base kind a given address space must derive over. Memory-like (returns 4 = KIND_MEMORY): 0x00 SystemMemory, 0x02 PCI_Config (this platform reaches config space through the R22 ECAM aperture, which is MMIO), 0x06 PciBarTarget, 0x0A PCC. Port-like (returns 11 = KIND_IO_PORT): 0x01 SystemIO, 0x03 EmbeddedControl (the EC command/data port pair), 0x05 SystemCMOS. Everything else -- 0x04 SMBus, 0x07 IPMI, 0x08 GeneralPurposeIO, 0x09 GenericSerialBus, and every value above 0x0A -- returns OPREG_DECODE_BAD, because those are BUS spaces whose accesses are serial-bus transactions rather than loads and stores; they carry their own capabilities in this round's catalog and a {base,len} containment check over a non-address coordinate would mean nothing. Written as an explicit compare chain rather than a bitmask because the asymmetry is the thing a reader must be able to audit at a glance, and a mask hides which side each space fell on. Pure leaf. Reserved labels: opr_sbk_.",
      block: {
        cmp rdi, 0x00;
        je opr_sbk_mem;
        cmp rdi, 0x02;
        je opr_sbk_mem;
        cmp rdi, 0x06;
        je opr_sbk_mem;
        cmp rdi, 0x0A;
        je opr_sbk_mem;

        cmp rdi, 0x01;
        je opr_sbk_port;
        cmp rdi, 0x03;
        je opr_sbk_port;
        cmp rdi, 0x05;
        je opr_sbk_port;

        mov rax, 0xFFFFFFFFFFFFFFFF;     // OPREG_DECODE_BAD
        ret;

      opr_sbk_mem:
        mov rax, 4;                      // OPREG_BASE_MEMORY
        ret;

      opr_sbk_port:
        mov rax, 11;                     // OPREG_BASE_PORT
        ret
      }
    }

  // ==========================================================================
  // opregion_space_valid(space) -> u64
  //
  // 1 iff the space is one this kind admits.
  // ==========================================================================

  pub let opregion_space_valid : (u64) -> u64 !{} @{} =
    fn (space: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R30.M3-001 (#1061): 1 iff opregion_space_base_kind(space) is not OPREG_DECODE_BAD. Defined in terms of the base-kind table rather than as a second list, so the admitted set and the derivation asymmetry cannot drift apart -- adding a space to one without the other is the bug this shape makes impossible. Reserved labels: opr_sv_.",
      block: {
        call opregion_space_base_kind;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je opr_sv_no;
        mov rax, 1;
        ret;

      opr_sv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // opregion_range_contains(o_base, o_len, i_base, i_len) -> u64
  //
  // 1 iff [i_base, i_base+i_len) is entirely inside [o_base, o_base+o_len).
  //
  // OVERFLOW-SAFE BY CONSTRUCTION. Not one comparison in this function
  // adds two caller-supplied 64-bit values, because `i_base + i_len` is
  // exactly the expression a firmware table controls both operands of.
  // The naive form `i_base + i_len <= o_base + o_len` wraps for
  // i_base = 2^64-1, i_len = 2, and reports CONTAINED for a window that
  // starts at the top of the address space and runs off the end of it.
  // ==========================================================================

  pub let opregion_range_contains : (u64, u64, u64, u64) -> u64 !{} @{} =
    fn (o_base: u64) (o_len: u64) (i_base: u64) (i_len: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R30.M3-001 (#1061): overflow-safe containment. Gates in order: (1) o_len == 0 -> 0, an empty outer window contains nothing. (2) i_len == 0 -> 0, an empty inner window is not a window; admitting it would let a table mint a zero-length region at an arbitrary address and then read its base back out of the row, which is an address oracle with no access required. (3) i_base < o_base -> 0. (4) i_len > o_len -> 0; this is checked BEFORE the offset arithmetic so that o_len - i_len below cannot underflow. (5) off = i_base - o_base (non-negative by gate 3); off > o_len - i_len -> 0. Both subtractions are proven non-underflowing by the preceding gates, so no comparison ever adds two caller-supplied values and the 2^64 wrap that reports a top-of-address-space window as contained cannot occur. Pure leaf. rdi=o_base, rsi=o_len, rdx=i_base, rcx=i_len. Reserved labels: opr_rc_.",
      block: {
        cmp rsi, 0;
        je opr_rc_no;                    // outer empty
        cmp rcx, 0;
        je opr_rc_no;                    // inner empty

        cmp rdx, rdi;
        jb opr_rc_no;                    // inner starts below outer

        cmp rcx, rsi;
        ja opr_rc_no;                    // inner longer than outer

        // off = i_base - o_base   (>= 0 by the gate above)
        mov r10, rdx;
        sub r10, rdi;

        // room = o_len - i_len    (>= 0 by the gate above)
        mov r11, rsi;
        sub r11, rcx;

        cmp r10, r11;
        ja opr_rc_no;

        mov rax, 1;
        ret;

      opr_rc_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // opregion_range_wraps(base, len) -> u64
  //
  // 1 iff base + len would exceed 2^64. Used at ROOT allocation, where
  // there is no outer window to contain the request.
  // ==========================================================================

  pub let opregion_range_wraps : (u64, u64) -> u64 !{} @{} =
    fn (base: u64) (len: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R30.M3-001 (#1061): 1 iff base + len > 2^64, computed as len > (2^64-1) - base so the sum is never formed. A window whose end wraps is refused rather than clamped: clamping would silently change what the caller believes it holds, and every later containment check would then be measured against a length nobody asked for. len == 0 answers 0 here -- the zero-length refusal belongs to the allocator, which reports it as BAD_ARG rather than BAD_RANGE, so the two failure edges keep distinct codes. Pure leaf. Reserved labels: opr_rw_.",
      block: {
        mov r10, 0xFFFFFFFFFFFFFFFF;
        sub r10, rdi;                    // 2^64-1 - base
        cmp rsi, r10;
        ja opr_rw_yes;
        xor rax, rax;
        ret;

      opr_rw_yes:
        mov rax, 1;
        ret
      }
    }

  // ==========================================================================
  // opregion_tail_pack(space, parent_slot, is_root, parent_row) -> u64
  //
  // Canonical header-word encoder. OPREG_DECODE_BAD on malformed input.
  // ==========================================================================

  pub let opregion_tail_pack : (u64, u64, u64, u64) -> u64 !{} @{} =
    fn (space: u64) (parent_slot: u64) (is_root: u64) (parent_row: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R30.M3-001 (#1061): canonical KIND_OP_REGION header-word encoder. Validates space via opregion_space_valid (so an unadmitted or bus space can never reach a row), parent_slot < 256, is_root <= 1, parent_row <= 0xFFFF, and the cross-field rule that is_root == 1 REQUIRES parent_row == OPREG_NO_PARENT_ROW (0xFFFF). That last rule is why this is an encoder and not four shifts at the call site: a root row that also carried a plausible parent_row would be revoked twice by the cascade -- once as its parent's child and once by the fixed-point pass -- and the second revoke would report WRONG_KIND against a descriptor another mint had meanwhile reused. Making the combination unrepresentable is cheaper than detecting it. Pack: space | (parent_slot << 8) | (is_root << 16) | (parent_row << 24). Bits [63:56] left clear for the allocator's in_use flag. Callee-saved across the nested call via r12/r13/r14/r15 pushes (four pushes: entry rsp%16 == 8, four pushes -> 8, so one further push before the call restores 0 -- rbx is pushed for that alignment and is itself callee-save). Reserved labels: opr_tp_.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;
        push rbx;                        // 5 pushes -> rsp%16 == 0 at the call

        mov r12, rdi;                    // space
        mov r13, rsi;                    // parent_slot
        mov r14, rdx;                    // is_root
        mov r15, rcx;                    // parent_row

        call opregion_space_valid;
        cmp rax, 0;
        je opr_tp_bad;

        cmp r13, 256;
        jae opr_tp_bad;
        cmp r14, 1;
        ja  opr_tp_bad;
        mov rbx, 0xFFFF;
        cmp r15, rbx;
        ja  opr_tp_bad;

        // is_root == 1 requires parent_row == 0xFFFF.
        cmp r14, 1;
        jne opr_tp_build;
        cmp r15, rbx;
        jne opr_tp_bad;

      opr_tp_build:
        mov rax, r12;
        and rax, 0xFF;                   // space

        mov rbx, r13;
        and rbx, 0xFF;
        shl rbx, 8;
        or  rax, rbx;                    // | parent_slot << 8

        mov rbx, r14;
        and rbx, 1;
        shl rbx, 16;
        or  rax, rbx;                    // | is_root << 16

        mov rbx, r15;
        mov r10, 0xFFFF;
        and rbx, r10;
        shl rbx, 24;
        or  rax, rbx;                    // | parent_row << 24

        pop rbx;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret;

      opr_tp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        pop rbx;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Header-word field extractors — the decode half of the round-trip.
  // These operate on the WORD, not on a row.
  // ==========================================================================

  pub let opregion_hdr_space : (u64) -> u64 !{} @{} =
    fn (hdr: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R30.M3-001 (#1061): space from header bits [7:0]. Pure leaf.",
      block: {
        mov rax, rdi;
        and rax, 0xFF;
        ret
      }
    }

  pub let opregion_hdr_parent : (u64) -> u64 !{} @{} =
    fn (hdr: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R30.M3-001 (#1061): parent_slot from header bits [15:8]. Pure leaf.",
      block: {
        mov rax, rdi;
        shr rax, 8;
        and rax, 0xFF;
        ret
      }
    }

  pub let opregion_hdr_is_root : (u64) -> u64 !{} @{} =
    fn (hdr: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R30.M3-001 (#1061): is_root from header bit [16]. Pure leaf.",
      block: {
        mov rax, rdi;
        shr rax, 16;
        and rax, 1;
        ret
      }
    }

  pub let opregion_hdr_parent_row : (u64) -> u64 !{} @{} =
    fn (hdr: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R30.M3-001 (#1061): parent_row from header bits [39:24]. Pure leaf.",
      block: {
        mov rax, rdi;
        shr rax, 24;
        mov r10, 0xFFFF;
        and rax, r10;
        ret
      }
    }

  // ==========================================================================
  // opregion_tail_alloc(hdr_word, base, len) -> row_id | error
  //
  // THE ONLY WRITER OF _op_region_table. Two callers, both in this file,
  // both of which have already established that the caller holds
  // authority over [base, base+len).
  // ==========================================================================

  pub let opregion_tail_alloc : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr_word: u64) (base: u64) (len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M3-001 (#1061): allocate and populate a free _op_region_table row. THIS IS THE ONLY FUNCTION IN THE KERNEL THAT WRITES A {space, base, len} TRIPLE, which is what makes the two authority gates upstream of it exhaustive. Gates, in order: hdr bits [63:56] non-zero -> OPREG_TAIL_BAD_ARG (those bits belong to the in_use flag the allocator ORs in, so accepting them would let a caller pre-set the flag and hand back a row the free scan skips); hdr reserved bits [23:17] or [55:40] non-zero -> OPREG_TAIL_BAD_ARG (a reserved bit that is merely ignored is a reserved bit a later revision cannot use); space field not admitted -> OPREG_TAIL_BAD_SPACE; len == 0 -> OPREG_TAIL_BAD_ARG; base + len wraps 2^64 -> OPREG_TAIL_BAD_RANGE. Low-first scan over 32 rows of 32 bytes; free iff the in_use byte (byte 7 of [row+0]) is zero; exhaustion -> OPREG_TAIL_ENOSPC. Claim: [row+0] = hdr | (1 << 56); [row+8] = base; [row+16] = len; [row+24] = 0. Args parked in r13/r14/r15 across the scan and the nested space check. Reserved labels: opr_ta_.",
      block: {
        push r13;
        push r14;
        push r15;

        mov r13, rdi;                    // hdr_word
        mov r14, rsi;                    // base
        mov r15, rdx;                    // len

        // Gate: hdr bits [63:56] must be zero.
        mov r10, r13;
        shr r10, 56;
        cmp r10, 0;
        jne opr_ta_bad_arg;

        // Gate: reserved bits [23:17] must be zero.
        mov r10, r13;
        shr r10, 17;
        and r10, 0x7F;
        cmp r10, 0;
        jne opr_ta_bad_arg;

        // Gate: reserved bits [55:40] must be zero.
        mov r10, r13;
        shr r10, 40;
        mov r11, 0xFFFF;
        and r10, r11;
        cmp r10, 0;
        jne opr_ta_bad_arg;

        // Gate: the space field is admitted.
        mov rdi, r13;
        and rdi, 0xFF;
        call opregion_space_valid;
        cmp rax, 0;
        je opr_ta_bad_space;

        // Gate: len != 0.
        cmp r15, 0;
        je opr_ta_bad_arg;

        // Gate: base + len does not wrap.
        mov rdi, r14;
        mov rsi, r15;
        call opregion_range_wraps;
        cmp rax, 0;
        jne opr_ta_bad_range;

        // Row cursor.
        lea r8, [rip + _op_region_table];
        xor rcx, rcx;

      opr_ta_scan:
        cmp rcx, 32;                     // OPREG_MAX
        jae opr_ta_none;
        mov rax, [r8];
        mov r10, rax;
        shr r10, 56;                     // in_use byte
        cmp r10, 0;
        je opr_ta_found;
        add r8, 32;                      // OPREG_ROW_BYTES
        add rcx, 1;
        jmp opr_ta_scan;

      opr_ta_found:
        mov rax, r13;
        mov r10, 1;
        shl r10, 56;
        or  rax, r10;
        mov [r8 + 0], rax;               // hdr | in_use

        mov rax, r14;
        mov [r8 + 8], rax;               // base

        mov rax, r15;
        mov [r8 + 16], rax;              // len

        xor rax, rax;
        mov [r8 + 24], rax;              // reserved

        mov rax, rcx;                    // row_id
        pop r15;
        pop r14;
        pop r13;
        ret;

      opr_ta_none:
        mov rax, 0xFFFFFFCF;             // OPREG_TAIL_ENOSPC
        pop r15;
        pop r14;
        pop r13;
        ret;

      opr_ta_bad_space:
        mov rax, 0xFFFFFFCD;
        pop r15;
        pop r14;
        pop r13;
        ret;

      opr_ta_bad_range:
        mov rax, 0xFFFFFFCC;
        pop r15;
        pop r14;
        pop r13;
        ret;

      opr_ta_bad_arg:
        mov rax, 0xFFFFFFCE;
        pop r15;
        pop r14;
        pop r13;
        ret
      }
    }

  // ==========================================================================
  // opregion_tail_free(row_id) -> ()
  // ==========================================================================

  pub let opregion_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M3-001 (#1061): row_id >= OPREG_MAX -> silent no-op. Otherwise zero all four u64s of the row. Zeroing [row+0] is what clears in_use, so free and SCRUB are the same operation: no stale base or length survives in the table, which matters more here than for any other kind because a stale row is a recorded permission to touch a physical address. Leaf. Reserved labels: opr_tf_.",
      block: {
        cmp rdi, 32;
        jae opr_tf_done;

        mov r8, rdi;
        shl r8, 5;                       // row_id * 32
        lea r9, [rip + _op_region_table];
        add r8, r9;

        xor rax, rax;
        mov [r8 + 0], rax;
        mov [r8 + 8], rax;
        mov [r8 + 16], rax;
        mov [r8 + 24], rax;

      opr_tf_done:
        ret
      }
    }

  // ==========================================================================
  // opregion_tail_valid(row_id) -> u64
  // ==========================================================================

  pub let opregion_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M3-001 (#1061): 1 iff row_id < OPREG_MAX and the row's in_use byte is non-zero. Same shape as dma_tail_valid. Leaf; pure read. Reserved labels: opr_tv_.",
      block: {
        cmp rdi, 32;
        jae opr_tv_no;

        mov r8, rdi;
        shl r8, 5;
        lea r9, [rip + _op_region_table];
        add r8, r9;

        mov rax, [r8 + 0];
        shr rax, 56;
        cmp rax, 0;
        je opr_tv_no;

        mov rax, 1;
        ret;

      opr_tv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Row decoders. Every one bounds-checks and in_use-checks first, and
  // returns OPREG_DECODE_BAD on a dead or out-of-range row — never a
  // plausible-looking zero.
  // ==========================================================================

  pub let opregion_row_hdr : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M3-001 (#1061): raw header word of a LIVE row, OPREG_DECODE_BAD otherwise. The other decoders are written in terms of this one so the bounds check and the liveness check exist once. Leaf; pure read. Reserved labels: opr_rh_.",
      block: {
        cmp rdi, 32;
        jae opr_rh_bad;

        mov r8, rdi;
        shl r8, 5;
        lea r9, [rip + _op_region_table];
        add r8, r9;

        mov rax, [r8 + 0];
        mov r10, rax;
        shr r10, 56;
        cmp r10, 0;
        je opr_rh_bad;

        // Strip the in_use flag so the value round-trips against
        // opregion_tail_pack's output.
        mov r10, 0x00FFFFFFFFFFFFFF;
        and rax, r10;
        ret;

      opr_rh_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let opregion_row_space : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M3-001 (#1061): space of a live row, OPREG_DECODE_BAD on a dead or out-of-range row. Unambiguous: a live row's space is 0..0x0A by construction. Reserved labels: opr_rs_.",
      block: {
        call opregion_row_hdr;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je opr_rs_out;
        and rax, 0xFF;
      opr_rs_out:
        ret
      }
    }

  pub let opregion_row_parent : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M3-001 (#1061): parent cap slot of a live row, OPREG_DECODE_BAD on a dead row. Reserved labels: opr_rp_.",
      block: {
        call opregion_row_hdr;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je opr_rp_out;
        shr rax, 8;
        and rax, 0xFF;
      opr_rp_out:
        ret
      }
    }

  pub let opregion_row_is_root : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M3-001 (#1061): is_root of a live row, OPREG_DECODE_BAD on a dead row. Reserved labels: opr_ri_.",
      block: {
        call opregion_row_hdr;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je opr_ri_out;
        shr rax, 16;
        and rax, 1;
      opr_ri_out:
        ret
      }
    }

  pub let opregion_row_parent_row : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M3-001 (#1061): parent_row of a live row (0xFFFF for a root), OPREG_DECODE_BAD on a dead row. Reserved labels: opr_rpr_.",
      block: {
        call opregion_row_hdr;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je opr_rpr_out;
        shr rax, 24;
        mov r10, 0xFFFF;
        and rax, r10;
      opr_rpr_out:
        ret
      }
    }

  pub let opregion_row_base : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M3-001 (#1061): base of a live row from [+8], OPREG_DECODE_BAD on a dead or out-of-range row. A base of 0xFFFFFFFFFFFFFFFF is not representable in a live row because opregion_tail_alloc refuses any base whose window wraps and every window has len >= 1, so the sentinel is unambiguous. Reserved labels: opr_rb_.",
      block: {
        cmp rdi, 32;
        jae opr_rb_bad;

        mov r8, rdi;
        shl r8, 5;
        lea r9, [rip + _op_region_table];
        add r8, r9;

        mov rax, [r8 + 0];
        shr rax, 56;
        cmp rax, 0;
        je opr_rb_bad;

        mov rax, [r8 + 8];
        ret;

      opr_rb_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let opregion_row_len : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R30.M3-001 (#1061): len of a live row from [+16], OPREG_DECODE_BAD on a dead or out-of-range row. Unambiguous: a live row's len is non-zero and base+len does not wrap, so len = 2^64-1 would require base = 0 and is excluded by the wrap check at allocation (0 + 2^64-1 is exactly representable, so the one residual case is a full-address-space window at base 0, which no platform root describes and which the boot witness never mints). Reserved labels: opr_rl_.",
      block: {
        cmp rdi, 32;
        jae opr_rl_bad;

        mov r8, rdi;
        shl r8, 5;
        lea r9, [rip + _op_region_table];
        add r8, r9;

        mov rax, [r8 + 0];
        shr rax, 56;
        cmp rax, 0;
        je opr_rl_bad;

        mov rax, [r8 + 16];
        ret;

      opr_rl_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // opregion_rights_valid(rights) -> u64
  // ==========================================================================

  pub let opregion_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R30.M3-001 (#1061): 1 iff (rights & R_OPREG_ALL) == rights. R_OPREG_ALL = 0x61B (READ|WRITE|INVOKE|REVOKE|MINT|OBSERVE). Same shape as dma_rights_valid. Pure leaf. Reserved labels: opr_rv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x61B;
        and rax, r10;
        cmp rax, rdi;
        jne opr_rv_no;
        mov rax, 1;
        ret;

      opr_rv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // opregion_check_parent_base(parent_slot, want_kind) -> u64
  //
  // 1 iff cap_table[parent_slot].kind == want_kind AND rights carry
  // RIGHT_MINT. The ROOT gate.
  // ==========================================================================

  pub let opregion_check_parent_base : (u64, u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) (want_kind: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R30.M3-001 (#1061): root mint gate. Bounds-check parent_slot < 256; load the descriptor at cap_table + parent_slot*24 (stride 24 per cap/mint.pdx); require kind == want_kind AND (rights & RIGHT_MINT 0x200) != 0. want_kind is passed in rather than fixed because the derivation is ASYMMETRIC -- a memory-space root demands KIND_MEMORY (4) and a port-space root demands KIND_IO_PORT (11), and the caller obtains it from opregion_space_base_kind so the space decides, never the caller. Passing it in also means a mutant that hardcodes one kind fails the other space's fixture rather than silently accepting both. Pure read. Reserved labels: opr_cpb_.",
      block: {
        cmp rdi, 256;
        jae opr_cpb_no;

        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, rsi;
        jne opr_cpb_no;

        mov r10, [rax + 8];
        mov r11, 0x200;
        and r10, r11;
        cmp r10, 0;
        je opr_cpb_no;

        mov rax, 1;
        ret;

      opr_cpb_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // opregion_cap_mint_root(slot, parent_slot, rights, space, base, len)
  //   -> u64
  //
  // PLATFORM PATH. Establishes a root window from real memory or port
  // authority. Reachable only from kernel-side boot / supervisor code;
  // it is deliberately NOT an op on any capability, so nothing holding
  // only a KIND_OP_REGION can reach it, and therefore nothing a firmware
  // table drives can widen its own reach.
  //
  // SysV: rdi=slot, rsi=parent_slot, rdx=rights, rcx=space, r8=base,
  //       r9=len.
  // ==========================================================================

  pub let opregion_cap_mint_root_inner : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64)
       (space: u64) (base: u64) (len: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R30.M3-001 (#1061): root window mint. Sequence: (1) slot < 256 else OPREG_MINT_BAD_ARG. (2) want = opregion_space_base_kind(space); OPREG_DECODE_BAD -> OPREG_MINT_BAD_SPACE. (3) opregion_check_parent_base(parent_slot, want) -> OPREG_MINT_BAD_PARENT. THE SPACE PICKS THE REQUIRED PARENT KIND, so a KIND_IO_PORT holder cannot mint a SystemMemory root and a KIND_MEMORY holder cannot mint a SystemIO one. (4) opregion_rights_valid(rights) -> OPREG_MINT_BAD_RIGHTS. (5) hdr = opregion_tail_pack(space, parent_slot, 1, 0xFFFF). (6) opregion_tail_alloc(hdr, base, len), translating TAIL codes to distinct MINT codes so each failure edge stays nameable at the boundary. (7) cap_mint_write(slot, KIND_OP_REGION, rights, row_id). All six arguments are parked in callee-save registers across the four nested calls (r12=slot, r13=parent_slot, r14=rights, r15=space, rbx=base, rbp is NOT used -- len is spilled to the stack slot reserved by the sub rsp 16, keeping the frame 16-byte aligned at every call). Reserved labels: opr_mr_.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;
        push rbx;
        sub rsp, 24;                     // 5 pushes + 24 -> rsp%16 == 0

        mov r12, rdi;                    // slot
        mov r13, rsi;                    // parent_slot
        mov r14, rdx;                    // rights
        mov r15, rcx;                    // space
        mov rbx, r8;                     // base
        mov [rsp + 0], r9;               // len

        cmp r12, 256;
        jae opr_mr_bad_arg;

        // -- Step 2: which base kind does this space demand?
        mov rdi, r15;
        call opregion_space_base_kind;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je opr_mr_bad_space;
        mov [rsp + 8], rax;              // want_kind

        // -- Step 3: parent gate.
        mov rdi, r13;
        mov rsi, [rsp + 8];
        call opregion_check_parent_base;
        cmp rax, 0;
        je opr_mr_bad_parent;

        // -- Step 4: rights subset.
        mov rdi, r14;
        call opregion_rights_valid;
        cmp rax, 0;
        je opr_mr_bad_rights;

        // -- Step 5: header word (is_root = 1, parent_row = 0xFFFF).
        mov rdi, r15;                    // space
        mov rsi, r13;                    // parent_slot
        mov rdx, 1;                      // is_root
        mov rcx, 0xFFFF;                 // OPREG_NO_PARENT_ROW
        call opregion_tail_pack;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je opr_mr_bad_arg;

        // -- Step 6: allocate the row.
        mov rdi, rax;                    // hdr
        mov rsi, rbx;                    // base
        mov rdx, [rsp + 0];              // len
        call opregion_tail_alloc;

        mov r10, 0xFFFFFFCF;             // OPREG_TAIL_ENOSPC
        cmp rax, r10;
        je opr_mr_enospc;
        mov r10, 0xFFFFFFCD;             // OPREG_TAIL_BAD_SPACE
        cmp rax, r10;
        je opr_mr_bad_space;
        mov r10, 0xFFFFFFCC;             // OPREG_TAIL_BAD_RANGE
        cmp rax, r10;
        je opr_mr_bad_range;
        mov r10, 0xFFFFFFCE;             // OPREG_TAIL_BAD_ARG
        cmp rax, r10;
        je opr_mr_bad_arg;

        // -- Step 7: descriptor.
        mov rcx, rax;                    // target_ptr = row_id
        mov rdi, r12;                    // slot
        mov rsi, 0x150;                  // KIND_OP_REGION
        mov rdx, r14;                    // rights
        call cap_mint_write;

        xor rax, rax;                    // OPREG_MINT_OK
        jmp opr_mr_out;

      opr_mr_bad_parent:
        mov rax, 0xFFFFFFCB;
        jmp opr_mr_out;
      opr_mr_bad_rights:
        mov rax, 0xFFFFFFCA;
        jmp opr_mr_out;
      opr_mr_enospc:
        mov rax, 0xFFFFFFC9;
        jmp opr_mr_out;
      opr_mr_bad_space:
        mov rax, 0xFFFFFFC7;
        jmp opr_mr_out;
      opr_mr_bad_range:
        mov rax, 0xFFFFFFC6;
        jmp opr_mr_out;
      opr_mr_bad_arg:
        mov rax, 0xFFFFFFC8;

      opr_mr_out:
        add rsp, 24;
        pop rbx;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let opregion_cap_mint_root : (u64, u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64)
       (space: u64) (base: u64) (len: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R30.M3-001 (#1061): audited entry point for the root mint, same wrapper shape as dma_cap_mint. THE AUDIT IS NOT OPTIONAL DECORATION HERE: a root window is a standing permission to touch physical addresses, and the only way to answer 'which physical ranges did this boot ever authorise' after the fact is for every root that ever existed to have left a record. Putting the emission in the wrapper means a future second root-mint path cannot exist without being audited -- the same device iteration 33 used to make audit emission unsuppressable. Three-push prologue (r12/r13/r14): entry rsp%16 == 8, three pushes -> 0 at both nested calls. The six SysV argument registers are untouched by the two movs, so the inner body sees them exactly as passed; r14 carries the inner outcome across drv_audit_emit and is restored to rax, making the wrapper return-value transparent. Reserved labels: none.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;                    // subject slot
        mov r13, rsi;                    // principal (parent slot)

        call opregion_cap_mint_root_inner;
        mov r14, rax;

        mov rdi, 1;                      // DRV_AUDIT_EV_MINT
        mov rsi, 0x150;                  // KIND_OP_REGION
        mov rdx, r12;
        mov rcx, r13;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // opregion_cap_derive(child_slot, parent_slot, rights, base, len) -> u64
  //
  // THE PATH A FIRMWARE-DECLARED REGION TAKES, and the place the whole
  // milestone's security argument lives.
  //
  // What it does NOT take is a space: the space is INHERITED from the
  // parent row. A caller cannot relabel a memory window as an I/O window
  // and thereby route its accesses through a handler that reads a
  // different namespace.
  //
  // What it refuses, and how:
  //   * parent is not a live KIND_OP_REGION with RIGHT_MINT
  //                                     -> OPREG_MINT_BAD_PARENT
  //   * child rights are not a subset of parent rights
  //                                     -> OPREG_MINT_BAD_RIGHTS
  //   * [base, base+len) is not inside the parent's window
  //                                     -> OPREG_MINT_NO_COVER
  //
  // The third is the one that matters. It is REFUSAL: nothing is
  // allocated, no descriptor is written, and the request is NOT clipped
  // to the covered part.
  //
  // SysV: rdi=child_slot, rsi=parent_slot, rdx=rights, rcx=base, r8=len.
  // ==========================================================================

  pub let opregion_cap_derive_inner : (u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (child_slot: u64) (parent_slot: u64) (rights: u64)
       (base: u64) (len: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R30.M3-001 (#1061): derive a sub-window from a held window. Sequence: (1) child_slot < 256 else OPREG_MINT_BAD_ARG. (2) parent descriptor: kind must be KIND_OP_REGION (0x150) and rights must carry RIGHT_MINT (0x200), else OPREG_MINT_BAD_PARENT. Read directly rather than through opregion_check_parent_base because that helper's want_kind is a BASE kind and this gate wants the DERIVED tag -- conflating the two would let a raw KIND_MEMORY cap derive a window with no containment check at all, which is the exact hole this function exists to close. (3) parent row_id from target_ptr[15:0]; opregion_tail_valid -> OPREG_MINT_BAD_PARENT for a descriptor whose row was already freed. (4) rights monotonicity: (rights & parent_rights) == rights, and opregion_rights_valid(rights); either failing -> OPREG_MINT_BAD_RIGHTS. Monotonicity is checked against the PARENT'S rights, not against R_OPREG_ALL, so a read-only window cannot derive a writable one. (5) CONTAINMENT: opregion_range_contains(parent_base, parent_len, base, len) == 0 -> OPREG_MINT_NO_COVER, with nothing allocated and no descriptor written. (6) space inherited from the parent row -- never an argument. (7) hdr = opregion_tail_pack(space, parent_slot, 0, parent_row_id); allocate; cap_mint_write(child_slot, 0x150, rights, row_id). Registers: r12=child_slot, r13=parent_slot, r14=rights, r15=parent row_id, rbx=base; len and parent base/len/rights spilled to the 48-byte frame. Reserved labels: opr_dv_.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;
        push rbx;
        sub rsp, 56;                     // 5 pushes + 56 -> rsp%16 == 0

        mov r12, rdi;                    // child_slot
        mov r13, rsi;                    // parent_slot
        mov r14, rdx;                    // rights
        mov rbx, rcx;                    // base
        mov [rsp + 0], r8;               // len

        cmp r12, 256;
        jae opr_dv_bad_arg;
        cmp r13, 256;
        jae opr_dv_bad_parent;

        // -- Step 2: the parent must be a KIND_OP_REGION with RIGHT_MINT.
        lea rax, [rip + cap_table];
        mov r8, r13;
        shl r8, 3;
        mov r9, r13;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x150;                  // KIND_OP_REGION
        cmp r10, r11;
        jne opr_dv_bad_parent;

        mov r10, [rax + 8];              // parent rights
        mov [rsp + 8], r10;
        mov r11, 0x200;                  // RIGHT_MINT
        and r10, r11;
        cmp r10, 0;
        je opr_dv_bad_parent;

        // -- Step 3: parent row.
        mov r15, [rax + 16];
        mov r10, 0xFFFF;
        and r15, r10;                    // parent row_id

        mov rdi, r15;
        call opregion_tail_valid;
        cmp rax, 0;
        je opr_dv_bad_parent;

        // -- Step 4: rights monotonicity, then the absolute subset.
        mov r10, r14;
        mov r11, [rsp + 8];
        and r10, r11;
        cmp r10, r14;
        jne opr_dv_bad_rights;

        mov rdi, r14;
        call opregion_rights_valid;
        cmp rax, 0;
        je opr_dv_bad_rights;

        // -- Step 5: CONTAINMENT. The one that matters.
        mov rdi, r15;
        call opregion_row_base;
        mov [rsp + 16], rax;             // parent base

        mov rdi, r15;
        call opregion_row_len;
        mov [rsp + 24], rax;             // parent len

        mov rdi, [rsp + 16];
        mov rsi, [rsp + 24];
        mov rdx, rbx;                    // requested base
        mov rcx, [rsp + 0];              // requested len
        call opregion_range_contains;
        cmp rax, 0;
        je opr_dv_no_cover;

        // -- Step 6: inherit the space from the parent row.
        mov rdi, r15;
        call opregion_row_space;
        mov [rsp + 32], rax;

        // -- Step 7: header, row, descriptor.
        mov rdi, [rsp + 32];             // space (inherited)
        mov rsi, r13;                    // parent_slot
        xor rdx, rdx;                    // is_root = 0
        mov rcx, r15;                    // parent_row
        call opregion_tail_pack;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je opr_dv_bad_arg;

        mov rdi, rax;
        mov rsi, rbx;                    // base
        mov rdx, [rsp + 0];              // len
        call opregion_tail_alloc;

        mov r10, 0xFFFFFFCF;
        cmp rax, r10;
        je opr_dv_enospc;
        mov r10, 0xFFFFFFCD;
        cmp rax, r10;
        je opr_dv_bad_space;
        mov r10, 0xFFFFFFCC;
        cmp rax, r10;
        je opr_dv_bad_range;
        mov r10, 0xFFFFFFCE;
        cmp rax, r10;
        je opr_dv_bad_arg;

        mov rcx, rax;                    // target_ptr = row_id
        mov rdi, r12;
        mov rsi, 0x150;
        mov rdx, r14;
        call cap_mint_write;

        xor rax, rax;                    // OPREG_MINT_OK
        jmp opr_dv_out;

      opr_dv_no_cover:
        mov rax, 0xFFFFFFC5;             // OPREG_MINT_NO_COVER
        jmp opr_dv_out;
      opr_dv_bad_parent:
        mov rax, 0xFFFFFFCB;
        jmp opr_dv_out;
      opr_dv_bad_rights:
        mov rax, 0xFFFFFFCA;
        jmp opr_dv_out;
      opr_dv_enospc:
        mov rax, 0xFFFFFFC9;
        jmp opr_dv_out;
      opr_dv_bad_space:
        mov rax, 0xFFFFFFC7;
        jmp opr_dv_out;
      opr_dv_bad_range:
        mov rax, 0xFFFFFFC6;
        jmp opr_dv_out;
      opr_dv_bad_arg:
        mov rax, 0xFFFFFFC8;

      opr_dv_out:
        add rsp, 56;
        pop rbx;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  pub let opregion_cap_derive : (u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (child_slot: u64) (parent_slot: u64) (rights: u64)
       (base: u64) (len: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R30.M3-001 (#1061): audited entry point for the derive path. Every window a firmware table causes to exist -- and every window it was REFUSED -- leaves a record, because the outcome code is the audit record's outcome field: an OPREG_MINT_NO_COVER (0xFFFFFFC5) line is the trace of a table that asked for an address nobody had granted it, which is precisely the event an operator wants to see. Emitting only on success would make the attack invisible and the refusal unprovable. Three-push prologue (r12/r13/r14): entry rsp%16 == 8, three pushes -> 0 at both nested calls. Reserved labels: none.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;                    // subject (child slot)
        mov r13, rsi;                    // principal (parent window)

        call opregion_cap_derive_inner;
        mov r14, rax;

        mov rdi, 1;                      // DRV_AUDIT_EV_MINT
        mov rsi, 0x150;                  // KIND_OP_REGION
        mov rdx, r12;
        mov rcx, r13;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // opregion_cap_revoke(slot) -> u64
  // ==========================================================================

  pub let opregion_cap_revoke_inner : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R30.M3-001 (#1061): revoke a KIND_OP_REGION. (1) slot < 256 else OPREG_REVOKE_BAD_SLOT. (2) descriptor at cap_table + slot*24. (3) kind == 0 -> OPREG_REVOKE_ALREADY (idempotent). (4) kind != 0x150 -> OPREG_REVOKE_WRONG_KIND, so a revoke for this kind can never clear another kind's descriptor. (5) row_id = target_ptr[15:0]; opregion_tail_free scrubs the row, which is what stops a freed window's recorded base and length from surviving in the table. (6) clear the descriptor. Descriptor base parked in r11 across the free call. Reserved labels: opr_rvk_.",
      block: {
        cmp rdi, 256;
        jae opr_rvk_bad_slot;

        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r11, rax;
        mov r10, [rax + 0];

        cmp r10, 0;
        je opr_rvk_already;

        mov r9, 0x150;
        cmp r10, r9;
        jne opr_rvk_wrong_kind;

        mov rdi, [r11 + 16];
        mov r10, 0xFFFF;
        and rdi, r10;

        push r11;
        call opregion_tail_free;
        pop r11;

        xor rax, rax;
        mov [r11 + 0],  rax;
        mov [r11 + 8],  rax;
        mov [r11 + 16], rax;

        xor rax, rax;                    // OPREG_REVOKE_OK
        ret;

      opr_rvk_bad_slot:
        mov rax, 0xFFFFFFC4;
        ret;

      opr_rvk_wrong_kind:
        mov rax, 0xFFFFFFC3;
        ret;

      opr_rvk_already:
        mov rax, 0xFFFFFFC2;
        ret
      }
    }

  pub let opregion_cap_revoke : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R30.M3-001 (#1061): audited revoke. The cascade below calls THIS symbol, so tearing down a root that owns N sub-windows leaves N records rather than one -- the same reconciliation property R29.M6-002 established for the DMA cascade. Three-push prologue (r12/r13/r14): entry rsp%16 == 8, three pushes -> 0 at both nested calls; r13 is pushed for alignment uniformity with the other wrappers. Reserved labels: none.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;

        call opregion_cap_revoke_inner;
        mov r14, rax;

        mov rdi, 2;                      // DRV_AUDIT_EV_REVOKE
        mov rsi, 0x150;
        mov rdx, r12;
        mov rcx, r12;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // opregion_cascade_revoke_by_parent(parent_slot) -> count
  //
  // TRANSITIVE. See the header note: a window can be derived from a
  // window, so revoking a root must reach its grandchildren.
  // ==========================================================================

  pub let opregion_cascade_revoke_by_parent : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R30.M3-001 (#1061): transitive cascade revoke. Outer loop: repeat the full cap_table scan until a pass revokes nothing. Inner scan: for slot in 0..256, load kind at cap_table[slot][+0]; skip unless 0x150; row_id from target_ptr[15:0]; skip if row_id >= OPREG_MAX; read the row's parent_slot from _op_region_table[row_id][+0][15:8]; if it matches the pass's target OR the descriptor's own slot was revoked in an earlier pass, revoke and count. The FIXED POINT is what makes it transitive: pass 1 revokes the roots' direct children and, having cleared their descriptors, pass 2 finds the grandchildren orphaned -- their recorded parent_slot now names a NULL descriptor, which the walk treats as revocable. Termination: a pass that revokes nothing ends the loop, and every pass that continues frees at least one of OPREG_MAX rows, so at most OPREG_MAX+1 passes run. The alternative -- recursion -- would put an unbounded-depth call chain on a teardown path, which is exactly the shape a hostile derivation chain would exploit. Registers: r12 = slot cursor, r13 = target parent_slot, r14 = total count, rbx = pass count / scratch; all callee-save and pushed around the walk so opregion_cap_revoke's clobbers cannot corrupt it. Reserved labels: opr_cs_.",
      block: {
        push r12;
        push r13;
        push r14;
        push rbx;
        sub rsp, 24;                     // 4 pushes + 24 -> rsp%16 == 0

        mov r13, rdi;
        and r13, 0xFF;                   // target parent_slot
        xor r14, r14;                    // total revoked

      opr_cs_pass:
        xor rbx, rbx;                    // revoked this pass
        xor r12, r12;                    // slot cursor

      opr_cs_scan:
        cmp r12, 256;
        jae opr_cs_pass_end;

        // R51.M8-006 FIX: lea for the cap_table BASE ADDRESS. Same
        // fault as kind_nvme_namespace.pdx nvme_ns_cascade_revoke_blkdev
        // -- `mov rax, cap_table` compiled as `mov rax, [rip+cap_table]`
        // (opcode 0x8b, a LOAD) and returned cap_table[0] rather than
        // the array address, so at rax=0 slot 171 hit unmapped VA
        // 0x1008. This walker (both the primary scan below and the
        // ORPHAN TEST following) both did it.
        lea rax, [rip + cap_table];
        mov r8, r12;
        shl r8, 3;
        mov r9, r12;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x150;
        cmp r10, r11;
        jne opr_cs_skip;

        mov r10, [rax + 16];             // target_ptr
        mov r11, 0xFFFF;
        and r10, r11;                    // row_id
        cmp r10, 32;                     // OPREG_MAX
        jae opr_cs_skip;

        // Row header -> {parent_slot, is_root}, both read once.
        mov r8, r10;
        shl r8, 5;
        lea r9, [rip + _op_region_table];
        add r8, r9;
        mov r11, [r8 + 0];               // hdr

        mov r10, r11;
        shr r10, 8;
        and r10, 0xFF;                   // row.parent_slot

        cmp r10, r13;
        je opr_cs_hit;                   // a direct child of the target

        // A ROOT row's parent_slot names a KIND_MEMORY / KIND_IO_PORT
        // descriptor, which is legitimately not 0x150, so the orphan test
        // below must never be applied to one. Roots go only by the direct
        // match above.
        mov r9, r11;
        shr r9, 16;
        and r9, 1;                       // is_root
        cmp r9, 0;
        jne opr_cs_skip;

        // ORPHAN TEST — this is what makes the cascade TRANSITIVE. The
        // row's parent cap slot no longer holds a KIND_OP_REGION, which
        // means an earlier pass revoked the parent window. A grandchild
        // whose parent is gone is a live handle to an address whose only
        // justification has been destroyed, so it goes too. Deriving the
        // closure from the table state rather than from a worklist is
        // what keeps the walk allocation-free and bounded.
        //
        // R51.M8-006 FIX: lea for the cap_table BASE ADDRESS (see the
        // note above the primary scan; the same fault applies to the
        // orphan-test descriptor address computation).
        lea rax, [rip + cap_table];
        mov r8, r10;
        shl r8, 3;
        mov r9, r10;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov r11, [rax + 0];
        mov r9, 0x150;
        cmp r11, r9;
        je opr_cs_skip;                  // parent still alive: not an orphan

      opr_cs_hit:
        push r12;
        push r13;
        push r14;
        push rbx;
        mov rdi, r12;
        call opregion_cap_revoke;
        pop rbx;
        pop r14;
        pop r13;
        pop r12;
        add r14, 1;
        add rbx, 1;

      opr_cs_skip:
        add r12, 1;
        jmp opr_cs_scan;

      opr_cs_pass_end:
        cmp rbx, 0;
        jne opr_cs_pass;                 // a pass that revoked something
                                         //   may have orphaned more

        mov rax, r14;
        add rsp, 24;
        pop rbx;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // opregion_debug_print(row_id) -> u64
  //
  // Canonical printer. OBSERVE-class.
  // ==========================================================================

  pub let opregion_debug_print : (u64) -> u64 !{mem, sysreg} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "R30.M3-001 (#1061): canonical debug printer for one row. Refuses a dead or out-of-range row with OPREG_TAIL_BAD_ARG rather than printing zeroes, because a printer that renders a freed row as {space 0, base 0, len 0} is indistinguishable from one rendering a live SystemMemory window at address zero. Emits four KV lines (row / spc / bas / len) through klog_s1_x1 so each value is machine-greppable in the smoke log. r12 holds row_id across the four calls; entry rsp%16 == 8 and three pushes bring it to 0. Reserved labels: opr_dp_.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;

        call opregion_tail_valid;
        cmp rax, 0;
        je opr_dp_bad;

        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + opr_dbg_msg];
        lea rcx, [rip + opr_k_row];
        mov r8, r12;
        call klog_s1_x1;

        mov rdi, r12;
        call opregion_row_space;
        mov r13, rax;
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + opr_dbg_msg];
        lea rcx, [rip + opr_k_spc];
        mov r8, r13;
        call klog_s1_x1;

        mov rdi, r12;
        call opregion_row_base;
        mov r13, rax;
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + opr_dbg_msg];
        lea rcx, [rip + opr_k_bas];
        mov r8, r13;
        call klog_s1_x1;

        mov rdi, r12;
        call opregion_row_len;
        mov r13, rax;
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + opr_dbg_msg];
        lea rcx, [rip + opr_k_len];
        mov r8, r13;
        call klog_s1_x1;

        xor rax, rax;                    // OPREG_TAIL_OK
        pop r14;
        pop r13;
        pop r12;
        ret;

      opr_dp_bad:
        mov rax, 0xFFFFFFCE;             // OPREG_TAIL_BAD_ARG
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // cap_handler_op_region(rights, target_ptr, op_arg) -> u64
  //
  // Dispatch handler. QUERY ops only — there is deliberately no ACCESS
  // op here. Reading and writing a window is not a three-register
  // capability invocation; it needs a mapping, a width and a direction,
  // and it belongs to the userspace address-space handler (#1062) acting
  // on a MAPPING the supervisor obtained from this capability. Putting a
  // poke-this-address op on the capability would recreate, one layer up,
  // exactly the "any component can silently touch a hardware address"
  // property this kind exists to remove.
  // ==========================================================================

  pub let cap_handler_op_region : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R30.M3-001 (#1061): KIND_OP_REGION dispatch handler. Emits cap_opreg_msg on entry (arg registers saved across klog_s1, which clobbers all three per klog/wrappers.pdx §5.1). row_id = target_ptr[15:0]; op = op_arg[7:0]. Ops 0..4 (QUERY_SPACE / BASE / LEN / PARENT / ROOT) require RIGHT_INVOKE (0x008); op 5 (DEBUG_PRINT) requires RIGHT_OBSERVE (0x400). The rights gate is PER-OP rather than a single entry gate so the query and observe authority classes stay separable at the call site -- a monitor holding only OBSERVE can print a row without holding the authority to query it programmatically, and vice versa. Unknown op -> INVOKE_UNSUPPORTED (0xFFFFFFFFFFFFFFFC); rights failure -> INVOKE_DENIED (0xFFFFFFFFFFFFFFFD). Every query returns OPREG_DECODE_BAD for a dead row, which is the decoders' contract and never a plausible zero. r12=rights, r13=row_id, r14=op across the klog call. Reserved labels: opr_h_.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;                    // rights
        mov r13, rsi;
        mov r10, 0xFFFF;
        and r13, r10;                    // row_id
        mov r14, rdx;
        and r14, 0xFF;                   // op

        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_opreg_msg];
        call klog_s1;

        cmp r14, 5;
        je opr_h_dbg;
        cmp r14, 4;
        ja opr_h_unsup;

        // Ops 0..4: RIGHT_INVOKE.
        mov rax, r12;
        mov r10, 0x008;
        and rax, r10;
        cmp rax, 0;
        je opr_h_denied;

        mov rdi, r13;
        cmp r14, 0;
        je opr_h_space;
        cmp r14, 1;
        je opr_h_base;
        cmp r14, 2;
        je opr_h_len;
        cmp r14, 3;
        je opr_h_parent;

        call opregion_row_is_root;
        jmp opr_h_out;

      opr_h_space:
        call opregion_row_space;
        jmp opr_h_out;
      opr_h_base:
        call opregion_row_base;
        jmp opr_h_out;
      opr_h_len:
        call opregion_row_len;
        jmp opr_h_out;
      opr_h_parent:
        call opregion_row_parent;
        jmp opr_h_out;

      opr_h_dbg:
        mov rax, r12;
        mov r10, 0x400;                  // RIGHT_OBSERVE
        and rax, r10;
        cmp rax, 0;
        je opr_h_denied;
        mov rdi, r13;
        call opregion_debug_print;
        jmp opr_h_out;

      opr_h_denied:
        mov rdi, 1;                      // LEVEL_ERROR
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_denied_msg];
        call klog_s1;
        mov rax, 0xFFFFFFFFFFFFFFFD;     // INVOKE_DENIED
        jmp opr_h_out;

      opr_h_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;     // INVOKE_UNSUPPORTED

      opr_h_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

}
