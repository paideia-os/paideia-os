  // ==========================================================================
  // State transition helpers. Consumers: consent_dialog.pdx (grant path)
  // and consent_revoke.pdx (revoke path). Transitions form a monotone
  // lattice (§2): PENDING -> GRANTED / PENDING -> REVOKED / GRANTED ->
  // REVOKED only. Every other transition is refused BAD_TRANSITION.
  // ==========================================================================

  pub let dma_attest_row_set_granted : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M4-001 (#1210): PENDING -> GRANTED. Refuses any other prior state — a GRANTED cannot be regranted (idempotence would let a caller mask a REVOKE, and consent revocations must be sticky). Labels prefixed daa_sg_.",
      block: {
        push r12;
        push r13;

        mov r12, rdi;

        mov rdi, r12;
        call dma_attest_tail_valid;
        cmp rax, 0;
        je  daa_sg_bad_slot;

        lea r10, [rip + _dma_attest_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 24];
        mov r13, rax;
        and r13, 0xFF;

        cmp r13, 0;                       // must be PENDING
        jne daa_sg_bad_trans;

        // Clear low byte, OR in GRANTED.
        mov r11, rax;
        mov r10, 0xFFFFFFFFFFFFFF00;
        and r11, r10;
        or  r11, 1;                       // GRANTED
        lea r10, [rip + _dma_attest_table];
        mov rax, r12;
        shl rax, 5;
        add r10, rax;
        mov [r10 + 24], r11;

        xor rax, rax;
        jmp daa_sg_out;

      daa_sg_bad_slot:
        mov rax, 0xFFFFF953;
        jmp daa_sg_out;
      daa_sg_bad_trans:
        mov rax, 0xFFFFF950;

      daa_sg_out:
        pop r13;
        pop r12;
        ret
      }
    }

  pub let dma_attest_row_set_revoked : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M4-001 (#1210): {PENDING, GRANTED} -> REVOKED. Idempotent for REVOKED (returns OK) — the revoke cascade is idempotent by design (consent_revoke.pdx §3), so a second revoke of the same row is a no-op rather than an error. Labels prefixed daa_srv_.",
      block: {
        push r12;
        push r13;

        mov r12, rdi;

        mov rdi, r12;
        call dma_attest_tail_valid;
        cmp rax, 0;
        je  daa_srv_bad_slot;

        lea r10, [rip + _dma_attest_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 24];
        mov r13, rax;
        and r13, 0xFF;

        cmp r13, 2;                       // already REVOKED
        je  daa_srv_ok;

        // Clear low byte, OR in REVOKED.
        mov r11, rax;
        mov r10, 0xFFFFFFFFFFFFFF00;
        and r11, r10;
        or  r11, 2;                       // REVOKED
        lea r10, [rip + _dma_attest_table];
        mov rax, r12;
        shl rax, 5;
        add r10, rax;
        mov [r10 + 24], r11;

      daa_srv_ok:
        xor rax, rax;
        jmp daa_srv_out;

      daa_srv_bad_slot:
        mov rax, 0xFFFFF953;

      daa_srv_out:
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Lookups.
  // ==========================================================================

  pub let dma_attest_find_by_key : (u64) -> u64 !{mem} @{} =
    fn (attest_key: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M4-001 (#1210): live row holding this attest_key, or ROW_NONE. Refuses to match 0. Labels prefixed daa_fk_.",
      block: {
        cmp rdi, 0;
        je  daa_fk_none;
        xor rcx, rcx;
      daa_fk_scan:
        cmp rcx, 8;
        jae daa_fk_none;
        lea r10, [rip + _dma_attest_table];
        mov r11, rcx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  daa_fk_next;
        mov rax, [r10 + 8];
        cmp rax, rdi;
        je  daa_fk_hit;
      daa_fk_next:
        add rcx, 1;
        jmp daa_fk_scan;
      daa_fk_hit:
        mov rax, rcx;
        ret;
      daa_fk_none:
        mov rax, 0xFF;
        ret
      }
    }

  pub let dma_attest_find_by_dock : (u64) -> u64 !{mem} @{} =
    fn (dock_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M4-001 (#1210): live row holding this dock_id, or ROW_NONE. Refuses to match 0 (dock_id=0 is reserved as sentinel). Used by consent_revoke to anchor the cascade. Labels prefixed daa_fd_.",
      block: {
        cmp rdi, 0;
        je  daa_fd_none;
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  daa_fd_none;
        xor rcx, rcx;
      daa_fd_scan:
        cmp rcx, 8;
        jae daa_fd_none;
        lea r10, [rip + _dma_attest_table];
        mov r11, rcx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  daa_fd_next;
        mov rax, [r10 + 16];
        shr rax, 32;
        and rax, 0xFFFF;
        cmp rax, rdi;
        je  daa_fd_hit;
      daa_fd_next:
        add rcx, 1;
        jmp daa_fd_scan;
      daa_fd_hit:
        mov rax, rcx;
        ret;
      daa_fd_none:
        mov rax, 0xFF;
        ret
      }
    }

  pub let dma_attest_row_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R35.M4-001 (#1210): slot -> row_id, gated on live KIND_DMA_ATTESTATION. Labels prefixed daa_ros_.",
      block: {
        push r12; push r13; push r14;

        mov r11, 256;
        cmp rdi, r11;
        jae daa_ros_none;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x16E;
        cmp r10, r11;
        jne daa_ros_none;

        mov r12, [rax + 16];
        mov r10, 0xFFFF;
        and r12, r10;

        mov rdi, r12;
        call dma_attest_tail_valid;
        cmp rax, 0;
        je  daa_ros_none;

        mov rax, r12;
        jmp daa_ros_out;

      daa_ros_none:
        mov rax, 0xFF;
      daa_ros_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  pub let dma_attest_state_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R35.M4-001 (#1210): consent_state. ARITY ONE. Labels prefixed daa_sos_.",
      block: {
        push r12; push r13; push r14;
        call dma_attest_row_of_slot;
        mov r12, rax;
        cmp r12, 0xFF;
        je  daa_sos_bad;
        mov rdi, r12;
        call dma_attest_row_state;
        jmp daa_sos_out;
      daa_sos_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      daa_sos_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  // ==========================================================================
  // Mint. Six args (slot, parent_slot, rights, attest_key,
  // endpoint_slot, packed_ident).
  //
  // packed_ident encoding:
  //   [15:0]  dock_id             (16 bits)
  //   [31:16] iommu_domain_id     (16 bits)
  //   [63:32] attestation_hash    (32 bits)
  //
  // consent_state is NOT accepted; every attestation is minted in
  // PENDING (§1). Transitions are made by consent_dialog and
  // consent_revoke through the row-setter helpers above.
  // ==========================================================================

  pub let dma_attest_cap_mint_inner : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (attest_key: u64) (endpoint_slot: u64) (packed_ident: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R35.M4-001 (#1210): mint KIND_DMA_ATTESTATION over KIND_IPC_ENDPOINT. Six args (slot, parent, rights, key, endpoint_slot, packed_ident). packed_ident = dock_id[15:0] | iommu_domain_id[31:16] | attestation_hash[63:32]. Initial consent_state = PENDING. Sequence: slot<256; check_parent; check_endpoint (BAD_ENDPOINT); rights_valid; unpack + validate dock/domain/hash; attest_key non-zero (NO_KEY); uniqueness (IN_USE); hdr_pack; body1_pack; body2_pack; tail_alloc; cap_mint_write. Labels prefixed daa_mi_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov rbx, rdi;                    // slot
        mov r12, rsi;                    // parent_slot
        mov r13, rdx;                    // rights
        mov r14, rcx;                    // attest_key
        mov r15, r8;                     // endpoint_slot
        mov rbp, r9;                     // packed_ident

        mov r10, 256;
        cmp rbx, r10;
        jae daa_mi_bad_slot;

        mov rdi, r12;
        call dma_attest_check_parent;
        cmp rax, 0;
        je  daa_mi_bad_parent;

        mov rdi, r15;
        call dma_attest_check_endpoint;
        cmp rax, 0;
        je  daa_mi_bad_endpoint;

        mov rdi, r13;
        call dma_attest_rights_valid;
        cmp rax, 0;
        je  daa_mi_bad_rights;

        // Validate dock_id.
        mov rdi, rbp;
        and rdi, 0xFFFF;
        call dma_attest_dock_valid;
        cmp rax, 0;
        je  daa_mi_bad_dock;

        // Validate iommu_domain_id.
        mov rdi, rbp;
        shr rdi, 16;
        and rdi, 0xFFFF;
        call dma_attest_domain_valid;
        cmp rax, 0;
        je  daa_mi_bad_domain;

        // Validate attestation_hash.
        mov rdi, rbp;
        shr rdi, 32;
        and rdi, 0xFFFFFFFF;
        call dma_attest_hash_valid;
        cmp rax, 0;
        je  daa_mi_bad_hash;

        cmp r14, 0;
        je  daa_mi_no_key;

        mov rdi, r14;
        call dma_attest_find_by_key;
        cmp rax, 0xFF;
        jne daa_mi_in_use;

        // Body1 pack args: (endpoint_slot, dock_id, iommu_domain_id).
        mov rdi, r15;                    // endpoint_slot
        mov rsi, rbp;
        and rsi, 0xFFFF;                 // dock_id
        mov rdx, rbp;
        shr rdx, 16;
        and rdx, 0xFFFF;                 // iommu_domain_id
        call dma_attest_body1_pack;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  daa_mi_bad_dock;
        push rax;                        // body1
        sub rsp, 8;                      // 16-byte align

        // Body2 pack args: (consent_state=0, attestation_hash).
        mov rdi, 0;                      // PENDING
        mov rsi, rbp;
        shr rsi, 32;
        and rsi, 0xFFFFFFFF;             // attestation_hash
        call dma_attest_body2_pack;
        add rsp, 8;
        pop r11;                         // body1
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  daa_mi_bad_hash;
        mov r15, rax;                    // body2
        push r11;                        // body1
        sub rsp, 8;

        // Header.
        mov rdi, r12;
        call dma_attest_hdr_pack;
        add rsp, 8;
        pop r11;                         // body1
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  daa_mi_bad_parent;

        // tail_alloc(hdr, attest_key, body1, body2).
        mov rdi, rax;                    // hdr
        mov rsi, r14;                    // attest_key
        mov rdx, r11;                    // body1
        mov rcx, r15;                    // body2
        call dma_attest_tail_alloc;

        mov r10, 0xFFFFF95F;             // ENOSPC
        cmp rax, r10;
        je  daa_mi_enospc;
        mov r10, 0xFFFFF95E;             // BAD_ARG
        cmp rax, r10;
        je  daa_mi_bad_dock;

        mov r15, rax;                    // row_id
        mov r11, rbx;
        shl r11, 16;
        or  r15, r11;

        mov rdi, rbx;
        mov rsi, 0x16E;
        mov rdx, r13;
        mov rcx, r15;
        call cap_mint_write;

        mov rdi, 0;
        call dma_attest_note;

        xor rax, rax;
        jmp daa_mi_out;

      daa_mi_bad_slot:
        mov rax, 0xFFFFF953;
        jmp daa_mi_out;
      daa_mi_bad_parent:
        mov rax, 0xFFFFF95D;
        jmp daa_mi_out;
      daa_mi_bad_rights:
        mov rax, 0xFFFFF95C;
        jmp daa_mi_out;
      daa_mi_bad_dock:
        mov rax, 0xFFFFF95B;
        jmp daa_mi_out;
      daa_mi_bad_domain:
        mov rax, 0xFFFFF95A;
        jmp daa_mi_out;
      daa_mi_bad_hash:
        mov rax, 0xFFFFF958;
        jmp daa_mi_out;
      daa_mi_bad_endpoint:
        mov rax, 0xFFFFF957;
        jmp daa_mi_out;
      daa_mi_no_key:
        mov rax, 0xFFFFF956;
        jmp daa_mi_out;
      daa_mi_in_use:
        mov rdi, 2;
        call dma_attest_note;
        mov rax, 0xFFFFF954;
        jmp daa_mi_out;
      daa_mi_enospc:
        mov rdi, 3;
        call dma_attest_note;
        mov rax, 0xFFFFF955;

      daa_mi_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let dma_attest_cap_mint : (u64, u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (attest_key: u64) (endpoint_slot: u64) (packed_ident: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R35.M4-001 (#1210): audited mint.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;
        mov r13, rsi;

        call dma_attest_cap_mint_inner;
        mov r14, rax;

        mov rdi, 1;
        mov rsi, 0x16E;
        mov rdx, r12;
        mov rcx, r13;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Revoke (of the cap slot; the row lives on for its consent_state
  // history until dma_attest_tail_free clears it via the cascade).
  // ==========================================================================

  pub let dma_attest_cap_revoke_inner : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R35.M4-001 (#1210): revoke KIND_DMA_ATTESTATION. Labels prefixed daa_rvk_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;

        mov r10, 256;
        cmp r12, r10;
        jae daa_rvk_bad_slot;

        mov rax, cap_table;
        mov r8, r12;
        shl r8, 3;
        mov r9, r12;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov rbx, rax;

        mov r10, [rbx + 0];
        cmp r10, 0;
        je  daa_rvk_already;

        mov r11, 0x16E;
        cmp r10, r11;
        jne daa_rvk_wrong_kind;

        mov r13, [rbx + 16];
        mov r10, 0xFFFF;
        and r13, r10;

        mov rdi, r13;
        call dma_attest_tail_valid;
        cmp rax, 0;
        je  daa_rvk_clear;

        mov rdi, r13;
        call dma_attest_tail_free;

      daa_rvk_clear:
        mov rdi, r12;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        mov rdi, 1;
        call dma_attest_note;

        xor rax, rax;
        jmp daa_rvk_out;

      daa_rvk_bad_slot:
        mov rax, 0xFFFFF953;
        jmp daa_rvk_out;
      daa_rvk_wrong_kind:
        mov rax, 0xFFFFF952;
        jmp daa_rvk_out;
      daa_rvk_already:
        mov rax, 0xFFFFF951;

      daa_rvk_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let dma_attest_cap_revoke : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R35.M4-001 (#1210): audited revoke.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;

        call dma_attest_cap_revoke_inner;
        mov r14, rax;

        mov rdi, 2;
        mov rsi, 0x16E;
        mov rdx, r12;
        mov rcx, r12;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Dispatch handler.
  // ==========================================================================

  pub let cap_handler_dma_attest : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R35.M4-001 (#1210): KIND_DMA_ATTESTATION dispatch. Queries INVOKE; DEBUG_PRINT OBSERVE. All ops arity ONE — op_arg[63:8] REFUSED. Labels prefixed daa_hn_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov r12, rdi;                    // rights
        mov r13, rsi;
        mov r10, 0xFFFF;
        and r13, r10;                    // row_id
        mov r14, rdx;                    // op_arg

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_dma_attest_msg];
        call klog_s1;

        mov r10, r14;
        and r10, 0xFF;
        mov rbp, r10;                    // op
        mov r11, r14;
        shr r11, 8;
        cmp r11, 0;
        jne daa_hn_res;

        cmp rbp, 7;
        ja  daa_hn_unsup;

        cmp rbp, 7;
        je  daa_hn_dbg;

        // Ops 0..6: INVOKE.
        mov r10, r12;
        and r10, 0x008;
        cmp r10, 0;
        je  daa_hn_denied;

        mov rdi, r13;
        cmp rbp, 0;
        je  daa_hn_key;
        cmp rbp, 1;
        je  daa_hn_eid;
        cmp rbp, 2;
        je  daa_hn_dck;
        cmp rbp, 3;
        je  daa_hn_dom;
        cmp rbp, 4;
        je  daa_hn_stt;
        cmp rbp, 5;
        je  daa_hn_hsh;
        call dma_attest_row_parent;
        jmp daa_hn_out;

      daa_hn_key:
        call dma_attest_row_key;
        jmp daa_hn_out;
      daa_hn_eid:
        call dma_attest_row_endpoint;
        jmp daa_hn_out;
      daa_hn_dck:
        call dma_attest_row_dock;
        jmp daa_hn_out;
      daa_hn_dom:
        call dma_attest_row_domain;
        jmp daa_hn_out;
      daa_hn_stt:
        call dma_attest_row_state;
        jmp daa_hn_out;
      daa_hn_hsh:
        call dma_attest_row_hash;
        jmp daa_hn_out;

      daa_hn_dbg:
        mov r10, r12;
        and r10, 0x400;
        cmp r10, 0;
        je  daa_hn_denied;
        xor rax, rax;
        jmp daa_hn_out;

      daa_hn_res:
        mov rax, 0xFFFFF95E;
        jmp daa_hn_out;
      daa_hn_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;
        jmp daa_hn_out;
      daa_hn_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;

      daa_hn_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
