// src/kernel/core/cap/kind_dma_attestation.pdx — R35.M4-001 (#1210)
//
// KIND_DMA_ATTESTATION = 0x16E, derived over KIND_IPC_ENDPOINT (5).
//
// The authority a ring-3 dock supervisor holds to record ONE DMA
// attestation record — the attest_key that names it, the
// KIND_IPC_ENDPOINT cap slot that delivers consent-decision events
// (endpoint_slot), the dock_id whose device this attestation covers,
// the iommu_domain_id the dock is isolated by (per D3 in
// design/roadmap/next-wave-synthesis.md), the current consent state
// (PENDING / GRANTED / REVOKED), and the attestation_hash (CRC32 of
// device UUID + firmware version).
//
// =============================================================================
// §0  WHY THIS KIND EXISTS
// =============================================================================
//
// A Thunderbolt 4 dock is a bus-mastering PCIe device. Attaching one
// grants DMA reach across the entire host memory unless the IOMMU
// domain (KIND_DMA_DOMAIN, R29.M5) is set up to constrain it AND the
// user consented. R35.M4 is the round that turns that requirement
// into structure:
//
//   * The IOMMU domain the dock is confined to is named by
//     iommu_domain_id (kind_dma_domain.pdx §0).
//   * The attestation record — a hash over the device UUID + firmware
//     version — is the record of "which device the user consented to
//     see, at which firmware level".
//   * The consent_state field records what the user answered in the
//     dialog (consent_dialog.pdx), and consent_revoke.pdx walks it as
//     the ANCHOR of the revocation cascade that reaches every
//     KIND_TB_ROUTE, KIND_USB_DEVICE and KIND_TB_DOMAIN downstream.
//
// This kind is deliberately not a capability the DEVICE holds — it is
// the record of THE USER'S DECISION about the device, and holding it
// is what a driver process (or its supervisor) does to prove the
// decision existed when the tunnels were established.
//
// =============================================================================
// §1  DERIVATION OVER KIND_IPC_ENDPOINT
// =============================================================================
//
// The gate demands `kind == KIND_IPC_ENDPOINT (5)` carrying RIGHT_MINT.
// Like KIND_TB_ROUTE, KIND_PCIE_HOTPLUG_EVENT, KIND_HID_EVENT,
// KIND_EC_QUERY and KIND_FW_SESSION, THE KIND HALF OF THE GATE
// DISCRIMINATES NOTHING on its own — every endpoint in the machine is
// kind 5, the shell's stdout included — so the mint additionally
// requires:
//
//   (a) attest_key non-zero and unique among live rows (NO_KEY / IN_USE)
//   (b) endpoint_slot names a live KIND_IPC_ENDPOINT with RIGHT_MINT
//       (BAD_ENDPOINT); the slot is stashed on the row and used by
//       the consent-event fanout path to reach the dock supervisor
//   (c) dock_id fits in u16 (BAD_DOCK)
//   (d) iommu_domain_id fits in u16 (BAD_DOMAIN)
//   (e) attestation_hash is a u32; every 32-bit value is valid (a hash
//       is by definition opaque), but zero is refused (BAD_HASH) because
//       "no hash computed" is not a consent record
//   (f) rights subset of R_DMA_ATTEST_ALL
//
// consent_state is NOT accepted at mint. Every attestation starts in
// PENDING (0), and is moved to GRANTED (1) by consent_dialog only after
// the user actually answers the dialog, or REVOKED (2) by the
// consent_revoke sequencer. Accepting an initial state at mint would
// let a caller manufacture a granted attestation the user never
// approved.
//
// =============================================================================
// §2  CONSENT STATE IS THE ONE DYNAMIC FIELD
// =============================================================================
//
// attest_key, endpoint_slot, dock_id, iommu_domain_id, attestation_hash
// are ROW IDENTITY, frozen at mint. consent_state moves through
// {PENDING → GRANTED, PENDING → REVOKED, GRANTED → REVOKED} — never
// backward — as consent_dialog.pdx and consent_revoke.pdx take
// decisions, but the transition primitive is NOT on this kind's
// dispatch: dma_attest exposes only ROW ACCESSORS and a COUNTER
// through its cap_handler. The two helpers dma_attest_row_set_granted
// and dma_attest_row_set_revoked are gated at the module level to the
// two callers that own the transitions.
//
// The state transitions form a monotone lattice: no primitive in this
// module walks GRANTED → PENDING or REVOKED → anything, because a
// consent that was withdrawn cannot be un-withdrawn without a fresh
// mint. The state field IS the record of the last decision, and a
// "regrant" is a revoke + mint, deliberately.
//
// =============================================================================
// §3  ANCHOR OF THE R35.M4 REVOCATION CASCADE
// =============================================================================
//
// R_DMA_ATTEST_MINT (0x200) is DELIBERATELY ABSENT from R_DMA_ATTEST_ALL:
// nothing derives from an attestation cap. But this kind IS the parent
// of the cascade that consent_revoke walks (§0 of consent_revoke.pdx):
//
//   KIND_DMA_ATTESTATION  (this kind)
//     └─ walk every KIND_TB_ROUTE whose route_key matches this dock
//        └─ walk every dependent KIND_USB_DEVICE / KIND_TB_DOMAIN
//           └─ IOMMU domain unmap (final)
//
// The cascade is DOWNSTREAM only: nothing above KIND_DMA_ATTESTATION
// is touched by a revoke, because revoking a user's consent to a
// device cannot retroactively invalidate the endpoint the consent
// dialog arrived on.
//
// =============================================================================
// §4  FAILURE TAXONOMY 0xFFFFF950..0xFFFFF95F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent free bands: dma_consent_channel
// 0xFFFFF940..4F, consent_dialog 0xFFFFF930..3F, iommu_domain
// 0xFFFFF920..2F, consent_revoke 0xFFFFF910..1F; adjacent used band
// below: route_teardown 0xFFFFF960..6F).

module KindDmaAttestation = structure {

  pub let KIND_DMA_ATTESTATION      : u64 = 0x16E
  pub let DMA_ATTEST_PARENT_KIND    : u64 = 5           // = KIND_IPC_ENDPOINT

  // Consent state ordinals (§2).
  pub let DMA_ATTEST_STATE_PENDING : u64 = 0
  pub let DMA_ATTEST_STATE_GRANTED : u64 = 1
  pub let DMA_ATTEST_STATE_REVOKED : u64 = 2
  pub let DMA_ATTEST_STATE_MAX     : u64 = 2

  // Rights. Leaf: RIGHT_MINT NOT in the mask (§3).
  pub let R_DMA_ATTEST_READ    : u64 = 0x001
  pub let R_DMA_ATTEST_INVOKE  : u64 = 0x008
  pub let R_DMA_ATTEST_REVOKE  : u64 = 0x010
  pub let R_DMA_ATTEST_OBSERVE : u64 = 0x400
  pub let R_DMA_ATTEST_ALL     : u64 = 0x419

  // Ops. Every op takes NO OPERAND — op_arg[63:8] REFUSED.
  pub let DMA_ATT_OP_QUERY_KEY       : u64 = 0
  pub let DMA_ATT_OP_QUERY_ENDPOINT  : u64 = 1
  pub let DMA_ATT_OP_QUERY_DOCK      : u64 = 2
  pub let DMA_ATT_OP_QUERY_DOMAIN    : u64 = 3
  pub let DMA_ATT_OP_QUERY_STATE     : u64 = 4
  pub let DMA_ATT_OP_QUERY_HASH      : u64 = 5
  pub let DMA_ATT_OP_QUERY_PARENT    : u64 = 6
  pub let DMA_ATT_OP_DEBUG_PRINT     : u64 = 7
  pub let DMA_ATT_OP_MAX             : u64 = 7

  // Failure taxonomy — 0xFFFFF950..0xFFFFF95F.
  pub let DMA_ATT_OK                 : u64 = 0
  pub let DMA_ATT_TAIL_ENOSPC        : u64 = 0xFFFFF95F
  pub let DMA_ATT_TAIL_BAD_ARG       : u64 = 0xFFFFF95E
  pub let DMA_ATT_MINT_BAD_PARENT    : u64 = 0xFFFFF95D
  pub let DMA_ATT_MINT_BAD_RIGHTS    : u64 = 0xFFFFF95C
  pub let DMA_ATT_MINT_BAD_DOCK      : u64 = 0xFFFFF95B
  pub let DMA_ATT_MINT_BAD_DOMAIN    : u64 = 0xFFFFF95A
  pub let DMA_ATT_MINT_BAD_STATE     : u64 = 0xFFFFF959
  pub let DMA_ATT_MINT_BAD_HASH      : u64 = 0xFFFFF958
  pub let DMA_ATT_MINT_BAD_ENDPOINT  : u64 = 0xFFFFF957
  pub let DMA_ATT_MINT_NO_KEY        : u64 = 0xFFFFF956
  pub let DMA_ATT_MINT_ENOSPC        : u64 = 0xFFFFF955
  pub let DMA_ATT_MINT_IN_USE        : u64 = 0xFFFFF954
  pub let DMA_ATT_BAD_SLOT           : u64 = 0xFFFFF953
  pub let DMA_ATT_WRONG_KIND         : u64 = 0xFFFFF952
  pub let DMA_ATT_REVOKE_ALREADY     : u64 = 0xFFFFF951
  pub let DMA_ATT_BAD_TRANSITION     : u64 = 0xFFFFF950

  pub let DMA_ATT_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let DMA_ATT_ROW_NONE   : u64 = 0xFF

  // 8 rows, 32-byte stride.
  //   [+0]  header (in_use[63:56] | parent_slot[15:8])
  //   [+8]  attest_key
  //   [+16] body word 1: endpoint_slot[31:0] | dock_id[47:32]
  //                     | iommu_domain_id[63:48]
  //   [+24] body word 2: consent_state[7:0] | attestation_hash[39:8]
  //                     | reserved[63:40]
  pub let DMA_ATT_MAX       : u64 = 8
  pub let DMA_ATT_ROW_BYTES : u64 = 32

  pub let mut _dma_attest_table : [u64; 32] = uninit @align(64)
  pub let mut _dma_attest_stats : [u64; 4]  = uninit @align(64)

  pub let DMA_ATT_ST_MINTS   : u64 = 0
  pub let DMA_ATT_ST_REVOKES : u64 = 1
  pub let DMA_ATT_ST_IN_USE  : u64 = 2
  pub let DMA_ATT_ST_ENOSPC  : u64 = 3

  pub let dma_att_dbg_msg : [u8; 16] = "DMA ATTEST ROW\0\0"

  // ==========================================================================
  // Table reset.
  // ==========================================================================

  pub let dma_attest_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M4-001 (#1210): clear the DMA ATTEST row table and its counters. Boot and teardown only. Labels prefixed daa_rs_.",
      block: {
        lea r10, [rip + _dma_attest_table];
        xor rax, rax;
        xor rcx, rcx;
      daa_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  daa_rs_rows;

        lea r10, [rip + _dma_attest_stats];
        xor rcx, rcx;
      daa_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  daa_rs_stats;
        ret
      }
    }

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let dma_attest_dock_valid : (u64) -> u64 !{} @{} =
    fn (d: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M4-001 (#1210): 1 iff d fits in u16 and non-zero (dock_id 0 is reserved as sentinel). Labels prefixed daa_dv_.",
      block: {
        cmp rdi, 0;
        je  daa_dv_no;
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  daa_dv_no;
        mov rax, 1;
        ret;
      daa_dv_no:
        xor rax, rax;
        ret
      }
    }

  pub let dma_attest_domain_valid : (u64) -> u64 !{} @{} =
    fn (id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M4-001 (#1210): 1 iff id fits in u16. domain_id 0 is legal (the FIRST IOMMU domain, per Intel VT-d §3.4.1 / AMD-Vi §2.2). Labels prefixed daa_iv_.",
      block: {
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  daa_iv_no;
        mov rax, 1;
        ret;
      daa_iv_no:
        xor rax, rax;
        ret
      }
    }

  pub let dma_attest_state_valid : (u64) -> u64 !{} @{} =
    fn (s: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M4-001 (#1210): 1 iff s in {0,1,2} (PENDING/GRANTED/REVOKED). Labels prefixed daa_sv_.",
      block: {
        cmp rdi, 2;
        ja  daa_sv_no;
        mov rax, 1;
        ret;
      daa_sv_no:
        xor rax, rax;
        ret
      }
    }

  pub let dma_attest_hash_valid : (u64) -> u64 !{} @{} =
    fn (h: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M4-001 (#1210): 1 iff h fits in u32 and non-zero. Zero is refused because 'no hash computed' is not a consent record — a driver whose attestation hash is zero has skipped the UUID+firmware computation, and its consent decision cannot be tied to a particular device. Labels prefixed daa_hv_.",
      block: {
        cmp rdi, 0;
        je  daa_hv_no;
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  daa_hv_no;
        mov rax, 1;
        ret;
      daa_hv_no:
        xor rax, rax;
        ret
      }
    }

  pub let dma_attest_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M4-001 (#1210): subset test against R_DMA_ATTEST_ALL = 0x419. RIGHT_MINT (0x200) is OUTSIDE the mask — this kind is a leaf (§3). Labels prefixed daa_rgv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x419;
        and rax, r10;
        cmp rax, rdi;
        jne daa_rgv_no;
        mov rax, 1;
        ret;
      daa_rgv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Counters.
  // ==========================================================================

  pub let dma_attest_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M4-001 (#1210): counter bump. Labels prefixed daa_nt_.",
      block: {
        cmp rdi, 4;
        jae daa_nt_out;
        lea r10, [rip + _dma_attest_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      daa_nt_out:
        ret
      }
    }

  pub let dma_attest_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M4-001 (#1210): counter read.",
      block: {
        cmp rdi, 4;
        jae daa_st_zero;
        lea r10, [rip + _dma_attest_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      daa_st_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Parent gate.
  // ==========================================================================

  pub let dma_attest_check_parent : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R35.M4-001 (#1210): §1 gate. parent must be live KIND_IPC_ENDPOINT (5) with RIGHT_MINT. Labels prefixed daa_cp_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae daa_cp_no;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 5;                      // KIND_IPC_ENDPOINT
        jne daa_cp_no;

        mov r10, [rax + 8];
        mov r11, 0x200;                  // RIGHT_MINT
        and r10, r11;
        cmp r10, 0;
        je  daa_cp_no;

        mov rax, 1;
        ret;
      daa_cp_no:
        xor rax, rax;
        ret
      }
    }

  pub let dma_attest_check_endpoint : (u64) -> u64 !{mem} @{cap} =
    fn (endpoint_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R35.M4-001 (#1210): §1.b gate. endpoint_slot must be a live KIND_IPC_ENDPOINT (5) with RIGHT_MINT. Labels prefixed daa_ce_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae daa_ce_no;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 5;
        jne daa_ce_no;

        mov r10, [rax + 8];
        mov r11, 0x200;
        and r10, r11;
        cmp r10, 0;
        je  daa_ce_no;

        mov rax, 1;
        ret;
      daa_ce_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Header + body packers.
  // ==========================================================================

  pub let dma_attest_hdr_pack : (u64) -> u64 !{} @{} =
    fn (parent_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M4-001 (#1210): (parent_slot << 8). Labels prefixed daa_hp_.",
      block: {
        mov r10, 256;
        cmp rdi, r10;
        jae daa_hp_bad;
        mov rax, rdi;
        shl rax, 8;
        ret;
      daa_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let dma_attest_body1_pack : (u64, u64, u64) -> u64 !{} @{} =
    fn (endpoint_slot: u64) (dock_id: u64) (iommu_domain_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M4-001 (#1210): pack endpoint_slot[31:0] | dock_id[47:32] | iommu_domain_id[63:48]. Refuses out-of-range fields. Labels prefixed daa_b1_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  daa_b1_bad;
        mov r10, 0xFFFF;
        cmp rsi, r10;
        ja  daa_b1_bad;
        cmp rdx, r10;
        ja  daa_b1_bad;

        mov rax, rdi;
        and rax, 0xFFFFFFFF;
        mov r10, rsi;
        and r10, 0xFFFF;
        shl r10, 32;
        or  rax, r10;
        mov r10, rdx;
        and r10, 0xFFFF;
        shl r10, 48;
        or  rax, r10;
        ret;
      daa_b1_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let dma_attest_body2_pack : (u64, u64) -> u64 !{} @{} =
    fn (consent_state: u64) (attestation_hash: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R35.M4-001 (#1210): pack consent_state[7:0] | attestation_hash[39:8]. Reserved [63:40] left zero. Refuses out-of-range fields. Labels prefixed daa_b2_.",
      block: {
        cmp rdi, 2;
        ja  daa_b2_bad;
        mov r10, 0xFFFFFFFF;
        cmp rsi, r10;
        ja  daa_b2_bad;

        mov rax, rdi;
        and rax, 0xFF;
        mov r10, rsi;
        and r10, 0xFFFFFFFF;
        shl r10, 8;
        or  rax, r10;
        ret;
      daa_b2_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // Tail alloc / valid / free.
  //
  // THE ONE WRITER of _dma_attest_table. tools/build.sh confines
  // relocations against `_dma_attest_table` to this object.
  // ==========================================================================

  pub let dma_attest_tail_alloc : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (attest_key: u64) (body1_packed: u64) (body2_packed: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M4-001 (#1210): claim one DMA ATTEST row. THE ONE WRITER of _dma_attest_table. Low-first free scan over 8 rows of 32 bytes. Labels prefixed daa_ta_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // hdr
        mov r13, rsi;                    // attest_key
        mov r14, rdx;                    // body1
        mov r15, rcx;                    // body2

        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne daa_ta_bad;

        cmp r13, 0;
        je  daa_ta_bad;

        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp r14, r10;
        je  daa_ta_bad;
        cmp r15, r10;
        je  daa_ta_bad;

        xor rbx, rbx;
      daa_ta_scan:
        cmp rbx, 8;
        jae daa_ta_enospc;

        lea r10, [rip + _dma_attest_table];
        mov r11, rbx;
        shl r11, 5;
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  daa_ta_claim;

        add rbx, 1;
        jmp daa_ta_scan;

      daa_ta_claim:
        mov rax, r12;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r13;
        mov [r10 + 16], r14;
        mov [r10 + 24], r15;
        mov rax, rbx;
        jmp daa_ta_out;

      daa_ta_enospc:
        mov rax, 0xFFFFF95F;
        jmp daa_ta_out;
      daa_ta_bad:
        mov rax, 0xFFFFF95E;

      daa_ta_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let dma_attest_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M4-001 (#1210): 1 iff row_id < MAX and in_use. Labels prefixed daa_tvr_.",
      block: {
        cmp rdi, 8;
        jae daa_tvr_no;
        lea r10, [rip + _dma_attest_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  daa_tvr_no;
        mov rax, 1;
        ret;
      daa_tvr_no:
        xor rax, rax;
        ret
      }
    }

  pub let dma_attest_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M4-001 (#1210): scrub one row. Labels prefixed daa_tf_.",
      block: {
        cmp rdi, 8;
        jae daa_tf_out;
        lea r10, [rip + _dma_attest_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
      daa_tf_out:
        ret
      }
    }

  // ==========================================================================
  // Row accessors.
  // ==========================================================================

  pub let dma_attest_row_key : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R35.M4-001 (#1210): attest_key. Labels prefixed daa_rk_.",
      block: {
        push r12; push r13; push r14;
        mov r12, rdi;
        call dma_attest_tail_valid;
        cmp rax, 0;
        je  daa_rk_bad;
        lea r10, [rip + _dma_attest_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 8];
        jmp daa_rk_out;
      daa_rk_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      daa_rk_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  pub let dma_attest_row_endpoint : (u64) -> u64 !{mem} @{} =
