// src/kernel/core/cap/kind_tui_canvas.pdx — R89.M1-001 (#1988)
//
// KIND_TUI_CANVAS = 0x1A6, derived over KIND_MEMORY (= KIND_PAGE, 4).
// Design authority: design/kernel/kind-tui-canvas.md.
//
// This landing is row + mint gate ONLY (design doc's implementation-
// files table, R89.M1-001): ordinal, constants, rights, ops, failure
// taxonomy, the 8-row pool, mint/revoke bodies, boot-time pool reset.
// cap_handler_tui_canvas (R89.M1-002), the PRESENT/RESIZE cell-diff
// bodies (R89.M1-003/004) and the boot witness (R89.M1-005) are NOT
// here. Shape mirrors kind_tty.pdx (row + mint gate, six/eight-word
// row); the memory-derivation gate mirrors kind_gpu_bo.pdx's
// kgb_check_parent (kind == KIND_MEMORY(4) carrying RIGHT_MINT).
//
// THREE DEVIATIONS FROM THE DESIGN DOC, EACH FORCED BY THE REPO STATE
// AT LANDING TIME (not a re-derivation — the doc's row/rights/ops
// tables are implemented verbatim):
//
//   (1) FAILURE BAND. The doc names 0xFFFFEC40..0xFFFFEC4F as "the
//       next free band after KIND_TTY's 0xFFFFEC30..0xFFFFEC3F". A
//       repo-wide sweep at landing time shows that band already
//       belongs to KIND_NVME_CONTROLLER (kind_nvme_controller.pdx §3,
//       NVMEC_* constants) — kind_volume.pdx §3 and kind_sig_key.pdx
//       §3 both independently confirm the entire 0xFFFFEC00..
//       0xFFFFECFF page was band-claimed end to end by #1703/#1699.
//       This file opens a fresh, verified-free page instead:
//       0xFFFFEB10..0xFFFFEB1F (0xFFFFEB00..0F belongs to KIND_SIG_KEY;
//       0xFFFFEB10..1F is unclaimed by any kind_*.pdx / cap_*.pdx /
//       tests/**/*.pdx file as of this landing).
//   (2) tty_slot VALIDATION FUNCTION NAME. The design doc's own §
//       "Derivation" text (not the issue paraphrase) names the exact
//       function: `tty_tail_valid`. Called verbatim; tty_slot is a row
//       id into kind_tty's _tty_table, not a cap_table slot.
//   (3) TUI_MINT_BAD_SIZE. The doc specifies "memory_slot's byte range
//       < 2*rows*cols*CELL_BYTES". No KIND_MEMORY consumer in this
//       tree (kind_gpu_bo, kind_display_plane, kind_display_mode,
//       kind_bt_pairing — all four audited) has ever carried or
//       exposed a real byte-length for a memory capability: the
//       cap_table descriptor is {kind, rights, target_ptr} and
//       target_ptr is a bare pointer, not a (ptr, len) pair. Every one
//       of those kinds instead validates a caller-supplied size
//       against a formality ceiling (kind_gpu_bo's kgb_size_valid: 0 <
//       s <= u32 max), not the real allocation. tui_size_valid follows
//       that exact precedent: it bounds N = rows*cols*2*CELL_BYTES
//       against 0 < N <= u32 max. Given TUI_DIM_MAX = 4096 already
//       bounds rows/cols before this check runs, N tops out at
//       536,870,912 — the ceiling can never fire today, same as
//       kgb_size_valid's. Tightening this into a true cross-check
//       needs a (ptr, len) field added to KIND_MEMORY itself, which is
//       a cross-cutting change out of scope for one kind's landing.
//
// canvas_id is KERNEL-ASSIGNED (mint_body takes no id argument per
// the issue's 4-arg signature): a monotonic _tui_next_canvas_id
// counter, pre-incremented so the first id is 1, guaranteeing the
// design doc's "refused == 0" invariant without an explicit check.
//
// Frame prologue: none. Every function here uses the same manual
// push/pop discipline kind_tty.pdx and kind_gpu_bo.pdx use — the
// compiler already suppresses the frame prologue for unsafe-bodied
// lambdas (see #1606 for the gated attribute this replaces).
//
// =============================================================================
// ROW LAYOUT — 64 BYTES (one cache line), per design doc §"Row layout"
// =============================================================================
//   [+0]  header:     in_use[63:56] | reserved[55:0]
//   [+8]  canvas_id   (u64, kernel-assigned, never 0)
//   [+16] memory_slot (u64, cap_table slot; KIND_MEMORY(4) + RIGHT_MINT)
//   [+24] tty_slot    (u64, row id into kind_tty's _tty_table)
//   [+32] rows[63:32] | cols[31:0]
//   [+40] cell_bytes  (u64, = CELL_BYTES = 16)
//   [+48] presents    (u64, running PRESENT count; R89.M1-003 owns it)
//   [+56] reserved    (u64, flags)
//
// FAILURE TAXONOMY — 0xFFFFEB10..0xFFFFEB1F (see deviation (1) above)

module KindTuiCanvas = structure {

  pub let KIND_TUI_CANVAS      : u64 = 0x1A6
  pub let KIND_TUI_CANVAS_BASE : u64 = 4          // = KIND_MEMORY

  pub let TUI_DIM_MAX  : u64 = 4096
  pub let CELL_BYTES   : u64 = 16

  // Rights (design doc §"Rights").
  pub let R_TUI_PRESENT : u64 = 0x002
  pub let R_TUI_INVOKE  : u64 = 0x008
  pub let R_TUI_RESIZE  : u64 = 0x010
  pub let R_TUI_REVOKE  : u64 = 0x020
  pub let R_TUI_MINT    : u64 = 0x200
  pub let R_TUI_OBSERVE : u64 = 0x400
  pub let R_TUI_ALL     : u64 = 0x63A

  // Ops (design doc §"Ops"). Dispatch itself lands at R89.M1-002.
  pub let TUI_OP_PRESENT      : u64 = 0
  pub let TUI_OP_QUERY_ROWS   : u64 = 1
  pub let TUI_OP_QUERY_COLS   : u64 = 2
  pub let TUI_OP_QUERY_ID     : u64 = 3
  pub let TUI_OP_QUERY_TTY_ID : u64 = 4
  pub let TUI_OP_RESIZE       : u64 = 5
  pub let TUI_OP_CLEAR        : u64 = 6
  pub let TUI_OP_DEBUG_PRINT  : u64 = 7
  pub let TUI_OP_MAX          : u64 = 7

  // Failure taxonomy — 0xFFFFEB10..0xFFFFEB1F. See deviation (1).
  pub let TUI_OK              : u64 = 0
  pub let TUI_TAIL_ENOSPC     : u64 = 0xFFFFEB1F
  pub let TUI_MINT_BAD_MEMORY : u64 = 0xFFFFEB1E
  pub let TUI_MINT_BAD_TTY    : u64 = 0xFFFFEB1D
  pub let TUI_MINT_BAD_DIMS   : u64 = 0xFFFFEB1C
  pub let TUI_MINT_BAD_SIZE   : u64 = 0xFFFFEB1B
  pub let TUI_BAD_SLOT        : u64 = 0xFFFFEB1A
  pub let TUI_BAD_RIGHTS      : u64 = 0xFFFFEB19
  pub let TUI_REVOKE_ALREADY  : u64 = 0xFFFFEB18

  // Row pool. TUI_CANVAS_MAX = 8 (kind_tty precedent's starting
  // ceiling). 8 rows * 64 bytes = 512 bytes.
  pub let TUI_CANVAS_MAX       : u64 = 8
  pub let TUI_CANVAS_ROW_BYTES : u64 = 64

  pub let mut _tui_canvas_pool     : [u8; 512] = uninit @align(8)   // = 8 * 64
  pub let mut _tui_next_canvas_id  : u64       = uninit @align(8)

  // R89.M1-004 (#1991): counter table, byte-for-byte mirror of
  // kind_tty.pdx's _tty_stats (same [u64; 8] @align(64) shape — a full
  // cache line, four counters used today, four words reserved for
  // future growth exactly as _tty_stats reserves WRITES/unused slots
  // 4..7). THE ONLY WRITERS are the four tui_stats_bump_* helpers
  // immediately below; every other .pdx file (cap_handler_tui_canvas.
  // pdx, core/tui/canvas_present.pdx) calls those helpers rather than
  // touching this array directly — see tools/build.sh's confinement
  // gate for _tui_stats (mirrors _tty_stats's gate one-for-one).
  // Zeroed by .bss's own boot-time zero-init; no explicit reset
  // function (kind_tui_canvas_init predates this landing and is left
  // untouched per this issue's own scope).
  pub let mut _tui_stats : [u64; 8] = uninit @align(64)

  pub let TUI_ST_MINTS    : u64 = 0
  pub let TUI_ST_REVOKES  : u64 = 1
  pub let TUI_ST_PRESENTS : u64 = 2
  pub let TUI_ST_REFUSED  : u64 = 3
  pub let TUI_ST_MAX      : u64 = 8

  // Fingerprint (design doc §"Fingerprint golden"). Emitted once, on
  // successful mint only — not on revoke.
  pub let tui_mint_ok_msg : [u8; 48] = "tui canvas mint ok [legacy: TUI CANVAS MINT OK]\0"
  pub let tui_k_canvas_id : [u8; 10] = "canvas_id\0"

  // ==========================================================================
  // Validators.
  // ==========================================================================

  // tui_dim_valid(v) -> 1 iff v in [1, TUI_DIM_MAX].
  pub let tui_dim_valid : (u64) -> u64 !{} @{} =
    fn (v: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R89.M1-001 (#1988): 1 iff v in [1, TUI_DIM_MAX = 4096]. Mirrors kind_tty.pdx tty_rows_valid. Labels prefixed tdv_.",
      block: {
        cmp rdi, 1;
        jb  tdv_no;
        mov r10, 4096;
        cmp rdi, r10;
        ja  tdv_no;
        mov rax, 1;
        ret;
      tdv_no:
        xor rax, rax;
        ret
      }
    }

  // tui_size_valid(rows, cols) -> 1 iff 0 < rows*cols*2*CELL_BYTES <=
  // u32 max. Formality ceiling, not a real backing-store cross-check
  // — see file header deviation (3).
  pub let tui_size_valid : (u64, u64) -> u64 !{} @{} =
    fn (rows: u64) (cols: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R89.M1-001 (#1988): N = rows*cols*32 (2*CELL_BYTES) via imul + shl 5; 1 iff 0 < N <= u32 max. See file header deviation (3) for why this is a ceiling check, not a real memory-backing cross-check. Labels prefixed tsv_.",
      block: {
        mov rax, rdi;
        imul rax, rsi;
        shl rax, 5;
        cmp rax, 0;
        je  tsv_no;
        mov r10, 0xFFFFFFFF;
        cmp rax, r10;
        ja  tsv_no;
        mov rax, 1;
        ret;
      tsv_no:
        xor rax, rax;
        ret
      }
    }

  // tui_check_memory(memory_slot) -> 1 iff cap_table[memory_slot].kind
  // == KIND_MEMORY(4) and rights carry RIGHT_MINT (0x200). Mirrors
  // kind_gpu_bo.pdx kgb_check_parent exactly (majority precedent among
  // memory-derived kinds: kind_gpu_bo, kind_display_plane, kind_
  // display_mode, kind_block_cache all require RIGHT_MINT on the sole
  // memory argument).
  pub let tui_check_memory : (u64) -> u64 !{mem} @{cap} =
    fn (memory_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R89.M1-001 (#1988): derivation gate. parent.kind == KIND_MEMORY(4) AND rights carry RIGHT_MINT (0x200). Mirrors kind_gpu_bo.pdx kgb_check_parent one-for-one. Labels prefixed tcmem_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae tcmem_no;

        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 4;                      // KIND_MEMORY
        jne tcmem_no;

        mov r10, [rax + 8];
        mov r11, 0x200;                  // RIGHT_MINT
        and r10, r11;
        cmp r10, 0;
        je  tcmem_no;

        mov rax, 1;
        ret;
      tcmem_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Packers.
  // ==========================================================================

  pub let tui_hdr_pack : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "R89.M1-001 (#1988): canonical header encoder; only in_use is ever written (by tail_alloc), low 56 bits stay 0. Mirrors kind_tty.pdx tty_hdr_pack. Labels prefixed thp_.",
      block: {
        xor rax, rax;
        ret
      }
    }

  // rows[63:32] | cols[31:0].
  pub let tui_pack_rowcols : (u64, u64) -> u64 !{} @{} =
    fn (rows: u64) (cols: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R89.M1-001 (#1988): pack rows[63:32] | cols[31:0] per design doc row layout +32. Labels prefixed tprc_.",
      block: {
        mov rax, rsi;
        and rax, 0xFFFFFFFF;
        mov r10, rdi;
        and r10, 0xFFFFFFFF;
        shl r10, 32;
        or  rax, r10;
        ret
      }
    }

  // Monotonic id counter; pre-increment so the first id is 1 (never
  // 0), satisfying the design doc's "refused == 0" invariant without
  // an explicit post-check.
  pub let tui_next_canvas_id : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R89.M1-001 (#1988): pre-increment monotonic counter; canvas_id is kernel-assigned since mint_body takes no id argument (issue's 4-arg signature). Labels prefixed tnci_.",
      block: {
        lea r10, [rip + _tui_next_canvas_id];
        mov rax, [r10 + 0];
        add rax, 1;
        mov [r10 + 0], rax;
        ret
      }
    }

  // ==========================================================================
  // Row pool: slot / row_valid / tail_alloc / tail_free.
  // ==========================================================================

  // tui_canvas_slot(idx) -> &_tui_canvas_pool[idx*64]. No bounds check
  // by policy — mirrors vnode_pool.pdx vnode_slot exactly (caller
  // validates idx first).
  pub let tui_canvas_slot : (u64) -> u64 !{} @{} =
    fn (idx: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R89.M1-001 (#1988): &_tui_canvas_pool[idx*64]. SIB scale limited to 1/2/4/8 so *64 is shl 6 + add. No bounds check by policy, mirrors vnode_pool.pdx vnode_slot. Labels prefixed tcs_.",
      block: {
        lea rax, [rip + _tui_canvas_pool];
        shl rdi, 6;
        add rax, rdi;
        ret
      }
    }

  // tui_canvas_row_valid(idx) -> 1 iff idx < TUI_CANVAS_MAX and the
  // row's in_use byte is set. Inlines the address compute (rather than
  // calling tui_canvas_slot) so this stays a pure leaf with no nested
  // call to align for — mirrors kind_gpu_bo.pdx kgb_tail_valid /
  // kind_tty.pdx tty_tail_valid exactly.
  pub let tui_canvas_row_valid : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R89.M1-001 (#1988): 1 iff idx < TUI_CANVAS_MAX(8) and in_use set. Inlined address compute (idx*64 via shl 6) rather than a nested call to tui_canvas_slot, keeping this a pure leaf — mirrors kind_gpu_bo.pdx kgb_tail_valid / kind_tty.pdx tty_tail_valid. Labels prefixed tcrv_.",
      block: {
        mov r10, 8;
        cmp rdi, r10;
        jae tcrv_no;
        lea r10, [rip + _tui_canvas_pool];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  tcrv_no;
        mov rax, 1;
        ret;
      tcrv_no:
        xor rax, rax;
        ret
      }
    }

  // tui_canvas_tail_alloc(hdr, canvas_id, memory_slot, tty_slot,
  // packed_rowcols) -> row_id | TUI_TAIL_ENOSPC. THE ONLY WRITER of
  // _tui_canvas_pool on the allocate path. Low-first scan over 8 rows.
  pub let tui_canvas_tail_alloc : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (canvas_id: u64) (memory_slot: u64) (tty_slot: u64) (packed_rowcols: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R89.M1-001 (#1988): claim one canvas row. THE ONLY WRITER of _tui_canvas_pool. Low-first free scan over 8 rows of 64 bytes (idx*64 via shl 6). Populates cell_bytes=CELL_BYTES(16), presents=0, reserved=0 per design doc row layout. Five callee-save pushes leave rsp%16==0 for the nested tui_canvas_slot-equivalent inline address compute (no nested call here, but the shape mirrors kind_gpu_bo.pdx kgb_tail_alloc). Labels prefixed tca_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                    // hdr
        mov r12, rsi;                    // canvas_id
        mov r13, rdx;                    // memory_slot
        mov r14, rcx;                    // tty_slot
        mov r15, r8;                     // packed_rowcols

        xor rcx, rcx;                    // idx = 0
      tca_scan:
        cmp rcx, 8;
        jae tca_enospc;

        lea r10, [rip + _tui_canvas_pool];
        mov r11, rcx;
        shl r11, 6;                      // idx * 64
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  tca_claim;

        add rcx, 1;
        jmp tca_scan;

      tca_claim:
        mov rax, rbx;
        mov r9, 1;
        shl r9, 56;
        or  rax, r9;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r12;             // canvas_id
        mov [r10 + 16], r13;             // memory_slot
        mov [r10 + 24], r14;             // tty_slot
        mov [r10 + 32], r15;             // rows|cols
        mov rax, 16;
        mov [r10 + 40], rax;             // cell_bytes = CELL_BYTES
        xor rax, rax;
        mov [r10 + 48], rax;             // presents = 0
        mov [r10 + 56], rax;             // reserved = 0
        mov rax, rcx;                    // row_id
        jmp tca_out;

      tca_enospc:
        mov rax, 0xFFFFEB1F;             // TUI_TAIL_ENOSPC

      tca_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // tui_canvas_tail_free(idx) -> (). Scrub the whole 64-byte row.
  pub let tui_canvas_tail_free : (u64) -> () !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R89.M1-001 (#1988): scrub one row (all eight words). Labels prefixed tcf_.",
      block: {
        mov r10, 8;
        cmp rdi, r10;
        jae tcf_out;
        lea r10, [rip + _tui_canvas_pool];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        mov [r10 + 32], rax;
        mov [r10 + 40], rax;
        mov [r10 + 48], rax;
        mov [r10 + 56], rax;
      tcf_out:
        ret
      }
    }

  // ==========================================================================
  // Stats bookkeeping (R89.M1-004, #1991). Four tiny, single-counter
  // helpers rather than kind_tty.pdx's one generic index-dispatched
  // tty_note — canvas_present.pdx (a different module, PRESENT's
  // success tail) needs to bump ONE specific counter across a module
  // boundary, and a named leaf per counter is a plainer cross-module
  // contract than exporting a bare stat-index constant for it to pass
  // through. Each is a straight-line no-branch leaf (no internal
  // labels needed) using the load-inc-store idiom tty_note itself uses
  // (no `add reg, [mem]` anywhere). Labels prefixed tui_stats_ (none
  // needed here, but the prefix is reserved for any future branch).
  // ==========================================================================

  pub let tui_stats_bump_mints : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R89.M1-004 (#1991): bump _tui_stats[TUI_ST_MINTS=0]. Load-inc-store idiom, no `add reg, [mem]`. Called from kind_tui_canvas_mint_body's success tail only. Labels prefixed tui_stats_ (none needed, straight-line).",
      block: {
        lea r10, [rip + _tui_stats];
        mov rax, [r10 + 0];
        add rax, 1;
        mov [r10 + 0], rax;
        ret
      }
    }

  pub let tui_stats_bump_revokes : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R89.M1-004 (#1991): bump _tui_stats[TUI_ST_REVOKES=1]. Load-inc-store idiom, no `add reg, [mem]`. Called from kind_tui_canvas_revoke_body's success tail only. Labels prefixed tui_stats_ (none needed, straight-line).",
      block: {
        lea r10, [rip + _tui_stats];
        mov rax, [r10 + 8];
        add rax, 1;
        mov [r10 + 8], rax;
        ret
      }
    }

  pub let tui_stats_bump_presents : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R89.M1-004 (#1991): bump _tui_stats[TUI_ST_PRESENTS=2]. Load-inc-store idiom, no `add reg, [mem]`. THE ONLY writer of this slot; called cross-module from core/tui/canvas_present.pdx's tui_present_body success tail — canvas_present.pdx never touches _tui_stats itself, preserving kind_tui_canvas.o's one-writer confinement. Distinct from the per-canvas-row `presents` field at row+48 (design doc row layout), which tui_present_body continues to bump directly — that field counts PRESENTs for ONE canvas row; this counter is the kernel-wide PRESENT total across every row. Labels prefixed tui_stats_ (none needed, straight-line).",
      block: {
        lea r10, [rip + _tui_stats];
        mov rax, [r10 + 16];
        add rax, 1;
        mov [r10 + 16], rax;
        ret
      }
    }

  pub let tui_stats_bump_refused : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R89.M1-004 (#1991): bump _tui_stats[TUI_ST_REFUSED=3]. Load-inc-store idiom, no `add reg, [mem]`. Called ONLY from kind_tui_canvas_mint_body's shared refusal funnel (tcm_refused), mirroring kind_tty.pdx's tty_cap_mint_inner / tty_mi_refused exactly: that is the ONLY place kind_tty.pdx bumps TTY_ST_REFUSED anywhere in the tree — neither tty_cap_revoke's own failure arms nor cap_handler_tty's dispatch-deny arms (tty_hn_denied/tty_hn_unsup/tty_hn_res) bump it. This file follows that same narrow convention: revoke failure (kind_tui_canvas_revoke_body's tcr_bad_slot/tcr_already) and dispatch denial (cap_handler_tui_canvas's tuih_bad_slot/tuih_bad_rights) do NOT bump refused, matching the TTY analogue's own scope. Labels prefixed tui_stats_ (none needed, straight-line).",
      block: {
        lea r10, [rip + _tui_stats];
        mov rax, [r10 + 24];
        add rax, 1;
        mov [r10 + 24], rax;
        ret
      }
    }

  // ==========================================================================
  // Mint / revoke bodies. Return contract: mint returns a fresh row
  // (canvas slot) idx on success, or a TUI_MINT_* sentinel — the
  // future cap_handler_tui_canvas (R89.M1-002) packs that idx into a
  // cap_table descriptor exactly as cap_handler_gpu_bo does for
  // kind_gpu_bo's row idx.
  // ==========================================================================

  // kind_tui_canvas_mint_body(memory_slot, tty_slot, rows, cols) ->
  // row_id | TUI_MINT_BAD_DIMS | TUI_MINT_BAD_MEMORY |
  // TUI_MINT_BAD_TTY | TUI_MINT_BAD_SIZE | TUI_TAIL_ENOSPC.
  //
  // Gate order (issue-specified): dims, memory, tty, size, alloc.
  // Six callee-save pushes + sub rsp,8 leave rsp%16==0 for every
  // nested call (entry rsp%16==8, +48+8=56 -> %16==0).
  pub let kind_tui_canvas_mint_body : (u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (memory_slot: u64) (tty_slot: u64) (rows: u64) (cols: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R89.M1-001 (#1988): mint KIND_TUI_CANVAS over KIND_MEMORY. Gate order: (1) rows dim; (2) cols dim; (3) memory_slot (tui_check_memory: KIND_MEMORY(4)+RIGHT_MINT); (4) tty_slot (tty_tail_valid — design doc §Derivation names this function verbatim, see file header deviation (2)); (5) size ceiling (tui_size_valid, see deviation (3)); (6) tui_canvas_tail_alloc. canvas_id is kernel-assigned via tui_next_canvas_id (pre-increment, never 0). On success emits the design doc's mint fingerprint via klog_s1_x1(LEVEL_INFO, SUBSYS_CAP_, tui_mint_ok_msg, tui_k_canvas_id, canvas_id) — NOT on revoke. Register plan: r12=memory_slot, r13=tty_slot, r14=rows, r15=cols, rbx=canvas_id, rbp=hdr then reused for row_id (hdr is dead once tail_alloc returns) — all live across the klog_s1_x1 call, which per the iommu/domain_switch.pdx precedent preserves rbx/r12-r15/rbp. Six pushes + sub rsp,8: entry rsp%16==8, +48+8=56, rsp%16==0. Labels prefixed tcm_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;
        sub rsp, 8;

        mov r12, rdi;                    // memory_slot
        mov r13, rsi;                    // tty_slot
        mov r14, rdx;                    // rows
        mov r15, rcx;                    // cols

        mov rdi, r14;
        call tui_dim_valid;
        cmp rax, 0;
        je  tcm_bad_dims;

        mov rdi, r15;
        call tui_dim_valid;
        cmp rax, 0;
        je  tcm_bad_dims;

        mov rdi, r12;
        call tui_check_memory;
        cmp rax, 0;
        je  tcm_bad_memory;

        mov rdi, r13;
        call tty_tail_valid;
        cmp rax, 0;
        je  tcm_bad_tty;

        mov rdi, r14;
        mov rsi, r15;
        call tui_size_valid;
        cmp rax, 0;
        je  tcm_bad_size;

        call tui_next_canvas_id;
        mov rbx, rax;                    // canvas_id

        call tui_hdr_pack;
        mov rbp, rax;                    // hdr

        mov rdi, r14;
        mov rsi, r15;
        call tui_pack_rowcols;
        mov r9, rax;                     // packed_rowcols

        mov rdi, rbp;                    // hdr
        mov rsi, rbx;                    // canvas_id
        mov rdx, r12;                    // memory_slot
        mov rcx, r13;                    // tty_slot
        mov r8,  r9;                     // packed_rowcols
        call tui_canvas_tail_alloc;

        mov r10, 8;
        cmp rax, r10;
        jae tcm_refused;                 // rax already holds TUI_TAIL_ENOSPC

        mov rbp, rax;                    // rbp = row_id (hdr no longer needed)

        call tui_stats_bump_mints;       // R89.M1-004 (#1991)

        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + tui_mint_ok_msg];
        lea rcx, [rip + tui_k_canvas_id];
        mov r8,  rbx;                    // canvas_id
        call klog_s1_x1;

        mov rax, rbp;
        jmp tcm_out;

      tcm_bad_dims:
        mov rax, 0xFFFFEB1C;             // TUI_MINT_BAD_DIMS
        jmp tcm_refused;
      tcm_bad_memory:
        mov rax, 0xFFFFEB1E;             // TUI_MINT_BAD_MEMORY
        jmp tcm_refused;
      tcm_bad_tty:
        mov rax, 0xFFFFEB1D;             // TUI_MINT_BAD_TTY
        jmp tcm_refused;
      tcm_bad_size:
        mov rax, 0xFFFFEB1B;             // TUI_MINT_BAD_SIZE

      tcm_refused:
        // R89.M1-004 (#1991): shared refusal funnel — every mint
        // failure branch (bad dims/memory/tty/size, and ENOSPC) lands
        // here exactly once, mirroring kind_tty.pdx's tty_cap_mint_
        // inner / tty_mi_refused. rax (the sentinel) is preserved
        // across the bump call since tui_stats_bump_refused clobbers
        // it as scratch.
        push rax;
        call tui_stats_bump_refused;
        pop rax;

      tcm_out:
        add rsp, 8;
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // kind_tui_canvas_revoke_body(slot) -> 0 | TUI_BAD_SLOT |
  // TUI_REVOKE_ALREADY. `slot` is the row idx mint_body returned, not
  // a cap_table slot (no KIND_TUI_CANVAS cap is minted into cap_table
  // by this landing — cap_handler_tui_canvas at R89.M1-002 owns that).
  pub let kind_tui_canvas_revoke_body : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R89.M1-001 (#1988) + R89.M1-004 (#1991): revoke KIND_TUI_CANVAS row. slot >= TUI_CANVAS_MAX(8) -> TUI_BAD_SLOT; not in_use -> TUI_REVOKE_ALREADY; else tail_free + bump _tui_stats[TUI_ST_REVOKES] + return 0. No fingerprint on revoke per issue scope. Revoke failure does NOT bump _tui_stats.refused, mirroring kind_tty.pdx tty_cap_revoke exactly (that function's own bad_slot/already arms don't bump TTY_ST_REFUSED either — see tui_stats_bump_refused's own justification). One callee-save push (r12) leaves rsp%16==0 across the three nested calls. Labels prefixed tcr_.",
      block: {
        push r12;
        mov r12, rdi;

        mov r10, 8;
        cmp r12, r10;
        jae tcr_bad_slot;

        mov rdi, r12;
        call tui_canvas_row_valid;
        cmp rax, 0;
        je  tcr_already;

        mov rdi, r12;
        call tui_canvas_tail_free;
        call tui_stats_bump_revokes;     // R89.M1-004 (#1991)
        xor rax, rax;
        jmp tcr_out;

      tcr_bad_slot:
        mov rax, 0xFFFFEB1A;             // TUI_BAD_SLOT
        jmp tcr_out;
      tcr_already:
        mov rax, 0xFFFFEB18;             // TUI_REVOKE_ALREADY

      tcr_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Boot init.
  // ==========================================================================

  // kind_tui_canvas_init() -> (). Zero the pool + reset the id
  // counter. .bss is already zero at real boot; this is defensive
  // (matches the design doc's explicit request) and gives a future
  // witness a clean re-scrub point, mirroring kind_tty.pdx
  // tty_table_reset / kind_gpu_bo.pdx gpu_bo_table_reset in shape.
  pub let kind_tui_canvas_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R89.M1-001 (#1988): zero _tui_canvas_pool (64 u64 words) and reset _tui_next_canvas_id to 0. Boot-time defensive re-scrub, mirrors kind_tty.pdx tty_table_reset. Labels prefixed tci_.",
      block: {
        lea r10, [rip + _tui_canvas_pool];
        xor rax, rax;
        xor rcx, rcx;
      tci_loop:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 64;
        jb  tci_loop;

        lea r10, [rip + _tui_next_canvas_id];
        mov [r10 + 0], rax;
        ret
      }
    }
}
