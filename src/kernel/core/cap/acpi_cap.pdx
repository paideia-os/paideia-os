// src/kernel/core/cap/acpi_cap.pdx — R20-M4-001 / #819
// KIND_ACPI derived capability descriptor
//
// Design context
// --------------
// The kernel does structural parsing of ACPI static tables at boot
// (R20.M1–M3: RSDP, XSDT, MADT, MCFG, FADT, HPET). Nothing further
// happens in-kernel — no interpretation, no policy — per the "no AML
// in kernel" guardrail (design/acpi/no-aml-in-kernel.md, #822).
//
// Every subsequent read of ACPI data (userspace acpi_supervisor,
// eventual R34 userspace bubble, driver probes) must go through a
// capability invocation. This module registers KIND_ACPI as the
// derived capability that authorises read of the RSDP + XSDT-linked
// table image byte range.
//
// KIND base assignment
// --------------------
// The base-kind enum is closed at 16 slots (see cap/kind.pdx §Kind).
// New kinds must be *derived* per design/capabilities/derived-kinds.md:
// a derived kind rides an existing base kind at runtime and adds
// static-only refinement in the type system.
//
// KIND_ACPI rides KIND_PAGE (base 4) because the underlying resource
// is a read-only physical page range containing the RSDP + XSDT + the
// SDT images referenced by the XSDT entries. The kernel installs the
// range with EFI_MEMORY_RUNTIME preservation guarantees; the mint
// captures the range's [base_pa, base_pa + len) window and stamps the
// descriptor with target_ptr = base_pa. The derived-kind tag is
// 0x20 (32) — above the 4-bit base range and distinct from
// KIND_DRIVER (0x15), so an audit reading a descriptor tail can tell
// them apart.
//
// Rights discipline (R_ACPI_READ only)
// ------------------------------------
// The KIND_ACPI capability grants exactly one right — the ability to
// read the underlying byte range. No write, no mint, no re-map, no
// invoke against methods (there are no methods; AML lives elsewhere).
// This is intentional: read is the *only* honest operation on ACPI
// static tables from ring-3.
//
// Fixture posture at R20.M4
// -------------------------
// The full acceptance criterion "revoke → subsequent read fails with
// EPERM" from #819 depends on cap_revoke's real body writing back to
// the descriptor + slab_free — currently cap_revoke returns
// REVOKE_OK as a placeholder (see cap/revoke.pdx §R12-m5-001 note).
// The mint half of the criterion lands here; the revoke fixture is
// captured in the round's report as a hard prerequisite on
// cap_revoke's real body.

module AcpiCap = structure {

  // ============================================================================
  // Kind tags (mirror of Kind module for local reference)
  // ============================================================================

  // Runtime base kind for a KIND_ACPI capability. Rides KIND_PAGE (=4)
  // because the underlying resource is a read-only physical page range.
  let KIND_ACPI_BASE : u64 = 4

  // Derived-kind tag. Placed above the 4-bit base range so it cannot
  // collide with a LAM base-kind tag. Value 0x20 chosen distinct from
  // KIND_DRIVER (0x15).
  let KIND_ACPI : u64 = 0x20

  // ============================================================================
  // Rights (subset legal on a KIND_ACPI capability)
  // ============================================================================
  //
  // Mirror of Rights.RIGHT_READ (0x01). Other rights (write, mint,
  // exec, invoke, seal, …) are explicitly forbidden on a KIND_ACPI
  // capability — validated by rights_valid below.

  let R_ACPI_READ : u64 = 0x01
  let R_ACPI_ALL  : u64 = 0x01   // Only READ is legal

  // ============================================================================
  // Mint return codes (mirror of DriverCap.DRIVER_MINT_*)
  // ============================================================================

  let ACPI_MINT_OK           : u64 = 0
  let ACPI_MINT_BAD_RIGHTS   : u64 = 0xFFFFFFFF
  let ACPI_MINT_BAD_RANGE    : u64 = 0xFFFFFFFE

  // ============================================================================
  // rights_valid(rights) -> u64
  // Returns 1 if rights is a subset of R_ACPI_ALL (i.e. equals READ or 0),
  // else 0. Same shape as DriverCap.rights_valid.
  //
  // R_ACPI_ALL = 0x01, so the mask reduces to a bit-0 gate.
  // ============================================================================

  let rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "KIND_ACPI rights-subset validator (R20-M4-001 / #819). Returns 1 iff (rights & R_ACPI_ALL) == rights; else 0. R_ACPI_ALL = 0x01. Same encoder posture as DriverCap.rights_valid — unsafe block per paideia-as #913 (pure-fn if-else T0532).",
      block: {
        // rax = rights & R_ACPI_ALL
        mov rax, rdi;
        mov r10, 0x1;
        and rax, r10;
        // if rax == rights (rdi), return 1; else 0
        cmp rax, rdi;
        jne acpi_rights_no;
        mov rax, 1;
        ret;
        acpi_rights_no:
          mov rax, 0;
          ret
      }
    }

  // ============================================================================
  // range_valid(base_pa, len) -> u64
  // Sanity: both non-zero, len <= 2 MiB (bounded — ACPI static tables
  // per platform are well under this; e.g. q35 emits ~4 KiB, T14 G4
  // captured tables ~40 KiB). Returns 1 on OK, 0 on failure.
  // ============================================================================

  let ACPI_RANGE_MAX_LEN : u64 = 0x200000   // 2 MiB

  let range_valid : (u64, u64) -> u64 !{} @{} =
    fn (base_pa: u64) (len: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "KIND_ACPI range validator (R20-M4-001 / #819). Rejects base_pa == 0, len == 0, or len > ACPI_RANGE_MAX_LEN (2 MiB). All ACPI static-table images seen on q35 / T14 G4 fit well inside 2 MiB. Bound catches a truncated or wildly-corrupt XSDT length field before it becomes a descriptor's target_ptr.",
      block: {
        // Reject base_pa == 0
        cmp rdi, 0;
        je acpi_range_no;
        // Reject len == 0
        cmp rsi, 0;
        je acpi_range_no;
        // Reject len > ACPI_RANGE_MAX_LEN (0x200000)
        mov r10, 0x200000;
        cmp rsi, r10;
        ja acpi_range_no;
        // OK
        mov rax, 1;
        ret;
        acpi_range_no:
          mov rax, 0;
          ret
      }
    }

  // ============================================================================
  // acpi_cap_mint(base_pa, len, rights) -> u64
  // Gate-only mint per the DriverCap pattern (real slab_alloc +
  // descriptor write reuses cap_mint / cap_mint_write; wire-up deferred
  // pending revoke's real body — see module header §Fixture posture).
  //
  // Return codes:
  //   ACPI_MINT_OK           = 0
  //   ACPI_MINT_BAD_RANGE    = 0xFFFFFFFE  (base_pa/len failed range_valid)
  //   ACPI_MINT_BAD_RIGHTS   = 0xFFFFFFFF  (rights carried a bit outside R_ACPI_ALL)
  //
  // ABI: SysV — rdi=base_pa, rsi=len, rdx=rights, -> rax.
  // ============================================================================

  let acpi_cap_mint : (u64, u64, u64) -> u64 !{} @{} =
    fn (base_pa: u64) (len: u64) (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "KIND_ACPI mint gate (R20-M4-001 / #819). Sequence: range_valid(base_pa, len) then rights_valid(rights). On any failure return the corresponding ACPI_MINT_BAD_*. Real slab_alloc + cap_mint_write wire-up deferred until cap_revoke has a real body (see cap/revoke.pdx §R12-m5-001) so that the #819 revoke-→-EPERM acceptance fixture can round-trip. Rewritten as unsafe block per paideia-as #913 (pure-fn if-else T0532).",
      block: {
        // Preserve rights (rdx) across range_valid + rights_valid calls.
        push rdx;
        // range_valid expects rdi=base_pa, rsi=len — already there.
        call range_valid;
        pop rdx;
        cmp rax, 0;
        je acpi_mint_bad_range;
        // Move rights into rdi for rights_valid.
        mov rdi, rdx;
        call rights_valid;
        cmp rax, 0;
        je acpi_mint_bad_rights;
        // OK path — return ACPI_MINT_OK (0). Real descriptor write
        // deferred (see module header §Fixture posture).
        mov rax, 0;
        ret;
        acpi_mint_bad_range:
          // ACPI_MINT_BAD_RANGE = 0xFFFFFFFE
          mov rax, 0xFFFFFFFE;
          ret;
        acpi_mint_bad_rights:
          // ACPI_MINT_BAD_RIGHTS = 0xFFFFFFFF
          mov rax, 0xFFFFFFFF;
          ret
      }
    }

}
