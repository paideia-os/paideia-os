// src/kernel/core/cap/kind_wifi_phy.pdx — R38.M3-001 (#1299)
//
// KIND_WIFI_PHY = 0x178, derived over KIND_DEVICE (10).
//
// The authority to hold one WiFi PHY's static identity (phy_key, the
// KIND_DEVICE slot the PHY was probed on, the hw_id read from CSR_HW_REV,
// a band_mask naming which of {2.4, 5, 6} GHz the radio can drive, a
// channel_count and a regdomain_id).  Opens R38.M3 -- the capability
// layer above the R38.M2 transport plumbing.
//
// =============================================================================
// §0  WHY THIS KIND EXISTS
// =============================================================================
//
// R38.M1..M2 brought up the AX211 as a driver-private substrate: probe,
// firmware, ring backing, TX DMA.  Every one of those touched a device
// window through hard-wired paths that the D1.b DMA domain refuse-gate
// protected.  R38.M3 introduces a CAPABILITY over that hardware so a
// ring-3 supervisor (station manager, AP daemon, monitor tool) can name
// ONE PHY without touching MMIO at all.
//
// The kind half of the derivation gate discriminates NOTHING on its
// own -- every PCI function is a KIND_DEVICE, the tenth time in this
// tree the pattern repeats -- so the mint additionally requires:
//
//   (a) phy_key non-zero and unique among live rows (NO_KEY / IN_USE)
//   (b) device_slot names a live KIND_DEVICE (BAD_DEVICE)
//   (c) hw_id in (0, 0xFFFF] (BAD_HW_ID)
//   (d) band_mask non-zero and confined to bits [2:0] (BAD_BANDS)
//   (e) channel_count in (0, WPHY_CHAN_MAX] (BAD_CHANNELS)
//   (f) rights subset of R_WPHY_ALL (no R_MINT in R_WPHY_ALL)
//
// =============================================================================
// §1  ROW LAYOUT -- 32 BYTES EXACTLY
// =============================================================================
//
//   [+0]  header:  in_use[63:56] | parent_slot[15:8]
//   [+8]  phy_key    (u64)
//   [+16] body1:   device_slot[31:0] | hw_id[47:32] | band_mask[55:48]
//                | channel_count[63:56]
//   [+24] body2:   regdomain_id[15:0] | reserved[63:16]
//
// Every field is set once at mint and there is no primitive here that
// mutates any of them.  Revoke scrubs the entire row.
//
// =============================================================================
// §2  FAILURE TAXONOMY 0xFFFFF470..0xFFFFF47F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent used band above: WiFi CTXT_INFO ring
// 0xFFFFF480..8F; adjacent free bands below: KIND_WIFI_VIF
// 0xFFFFF460..6F).

module KindWifiPhy = structure {

  pub let KIND_WIFI_PHY        : u64 = 0x178
  pub let WPHY_PARENT_KIND     : u64 = 10       // = KIND_DEVICE

  pub let WPHY_HW_ID_MAX       : u64 = 0xFFFF
  pub let WPHY_BAND_MASK_MAX   : u64 = 0x07     // bits [2:0]: 2.4 / 5 / 6 GHz
  pub let WPHY_CHAN_MAX        : u64 = 64

  // Rights -- LEAF.  R_MINT (0x200) OUTSIDE R_WPHY_ALL.
  pub let R_WPHY_READ    : u64 = 0x001
  pub let R_WPHY_INVOKE  : u64 = 0x008
  pub let R_WPHY_REVOKE  : u64 = 0x010
  pub let R_WPHY_OBSERVE : u64 = 0x400
  pub let R_WPHY_ALL     : u64 = 0x419

  // Ops -- all QUERY, all arity ONE (op_arg[63:8] REFUSED).
  pub let WPHY_OP_QUERY_KEY      : u64 = 0
  pub let WPHY_OP_QUERY_DEVICE   : u64 = 1
  pub let WPHY_OP_QUERY_HW_ID    : u64 = 2
  pub let WPHY_OP_QUERY_BANDS    : u64 = 3
  pub let WPHY_OP_QUERY_CHANNELS : u64 = 4
  pub let WPHY_OP_QUERY_REGDOM   : u64 = 5
  pub let WPHY_OP_DEBUG_PRINT    : u64 = 6
  pub let WPHY_OP_MAX            : u64 = 6

  // Failure taxonomy 0xFFFFF470..7F.
  pub let WPHY_OK                 : u64 = 0
  pub let WPHY_TAIL_ENOSPC        : u64 = 0xFFFFF47F
  pub let WPHY_TAIL_BAD_ARG       : u64 = 0xFFFFF47E
  pub let WPHY_MINT_BAD_PARENT    : u64 = 0xFFFFF47D
  pub let WPHY_MINT_BAD_RIGHTS    : u64 = 0xFFFFF47C
  pub let WPHY_MINT_BAD_DEVICE    : u64 = 0xFFFFF47B
  pub let WPHY_MINT_BAD_HW_ID     : u64 = 0xFFFFF47A
  pub let WPHY_MINT_BAD_BANDS     : u64 = 0xFFFFF479
  pub let WPHY_MINT_BAD_CHANNELS  : u64 = 0xFFFFF478
  pub let WPHY_MINT_NO_KEY        : u64 = 0xFFFFF477
  pub let WPHY_MINT_IN_USE        : u64 = 0xFFFFF476
  pub let WPHY_MINT_ENOSPC        : u64 = 0xFFFFF475
  pub let WPHY_BAD_SLOT           : u64 = 0xFFFFF474
  pub let WPHY_WRONG_KIND         : u64 = 0xFFFFF473
  pub let WPHY_REVOKE_ALREADY     : u64 = 0xFFFFF472
  pub let WPHY_DECODE_UNUSED_A    : u64 = 0xFFFFF471
  pub let WPHY_DECODE_UNUSED_B    : u64 = 0xFFFFF470

  pub let WPHY_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let WPHY_ROW_NONE   : u64 = 0xFF

  // Eight rows, 32-byte stride -- total 256 bytes as [u64; 32].
  pub let WPHY_MAX       : u64 = 8
  pub let WPHY_ROW_BYTES : u64 = 32

  pub let mut _wifi_phy_table : [u64; 32] = uninit @align(64)
  pub let mut _wifi_phy_stats : [u64; 4]  = uninit @align(64)

  pub let WPHY_ST_MINTS   : u64 = 0
  pub let WPHY_ST_REVOKES : u64 = 1
  pub let WPHY_ST_REFUSED : u64 = 2
  pub let WPHY_ST_QUERIES : u64 = 3

  pub let wphy_dbg_msg : [u8; 13] = "WIFI PHY ROW\0"

  // ==========================================================================
  // Table reset.
  // ==========================================================================

  pub let wifi_phy_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M3-001 (#1299): clear KIND_WIFI_PHY row table and counters. Boot + teardown only. Labels prefixed wphy_rs_.",
      block: {
        lea r10, [rip + _wifi_phy_table];
        xor rax, rax;
        xor rcx, rcx;
      wphy_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  wphy_rs_rows;

        lea r10, [rip + _wifi_phy_stats];
        xor rcx, rcx;
      wphy_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  wphy_rs_stats;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let wphy_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M3-001 (#1299): subset test against R_WPHY_ALL = 0x419. R_MINT (0x200) OUTSIDE the mask -- LEAF. Labels prefixed wphy_rv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x419;
        and rax, r10;
        cmp rax, rdi;
        jne wphy_rv_no;
        mov rax, 1;
        ret;
      wphy_rv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let wphy_bands_valid : (u64) -> u64 !{} @{} =
    fn (bands: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M3-001 (#1299): 1 iff bands non-zero and confined to bits [2:0]. Labels prefixed wphy_bv_.",
      block: {
        cmp rdi, 0;
        je  wphy_bv_no;
        mov r10, 0x07;
        cmp rdi, r10;
        ja  wphy_bv_no;
        mov rax, 1;
        ret;
      wphy_bv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Counters.
  // ==========================================================================

  pub let wphy_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M3-001 (#1299): counter bump. Labels prefixed wphy_nt_.",
      block: {
        cmp rdi, 4;
        jae wphy_nt_out;
        lea r10, [rip + _wifi_phy_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      wphy_nt_out:
        ret
      }
    } @no_frame

  pub let wphy_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M3-001 (#1299): counter read. Labels prefixed wphy_stt_.",
      block: {
        cmp rdi, 4;
        jae wphy_stt_zero;
        lea r10, [rip + _wifi_phy_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      wphy_stt_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Parent gate: live KIND_DEVICE (10) with RIGHT_MINT.
  // ==========================================================================

  pub let wphy_check_parent : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R38.M3-001 (#1299): parent must be live KIND_DEVICE (10) with RIGHT_MINT. Labels prefixed wphy_cp_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae wphy_cp_no;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 10;
        jne wphy_cp_no;

        mov r10, [rax + 8];
        mov r11, 0x200;
        and r10, r11;
        cmp r10, 0;
        je  wphy_cp_no;

        mov rax, 1;
        ret;
      wphy_cp_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Device gate: live KIND_DEVICE (10) at device_slot.
  // ==========================================================================

  pub let wphy_check_device : (u64) -> u64 !{mem} @{cap} =
    fn (device_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R38.M3-001 (#1299): device_slot must name a live KIND_DEVICE. Labels prefixed wphy_cd_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae wphy_cd_no;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 10;
        jne wphy_cd_no;

        mov rax, 1;
        ret;
      wphy_cd_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Header + body packers.
  // ==========================================================================

  pub let wphy_hdr_pack : (u64) -> u64 !{} @{} =
    fn (parent_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M3-001 (#1299): (parent_slot << 8). Labels prefixed wphy_hp_.",
      block: {
        mov r10, 256;
        cmp rdi, r10;
        jae wphy_hp_bad;
        mov rax, rdi;
        shl rax, 8;
        ret;
      wphy_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  pub let wphy_body1_pack : (u64, u64, u64, u64) -> u64 !{} @{} =
    fn (device_slot: u64) (hw_id: u64) (band_mask: u64) (channel_count: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M3-001 (#1299): pack body1: device_slot[31:0] | hw_id[47:32] | band_mask[55:48] | channel_count[63:56]. Labels prefixed wphy_b1_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  wphy_b1_bad;
        mov r10, 0xFFFF;
        cmp rsi, r10;
        ja  wphy_b1_bad;
        mov r10, 0xFF;
        cmp rdx, r10;
        ja  wphy_b1_bad;
        cmp rcx, r10;
        ja  wphy_b1_bad;

        mov rax, rdi;
        and rax, 0xFFFFFFFF;
        mov r10, rsi;
        and r10, 0xFFFF;
        shl r10, 32;
        or  rax, r10;
        mov r10, rdx;
        and r10, 0xFF;
        shl r10, 48;
        or  rax, r10;
        mov r10, rcx;
        and r10, 0xFF;
        shl r10, 56;
        or  rax, r10;
        ret;
      wphy_b1_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  pub let wphy_body2_pack : (u64) -> u64 !{} @{} =
    fn (regdomain_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R38.M3-001 (#1299): pack body2: regdomain_id[15:0]. Reserved bits [63:16] MUST be zero on read. Labels prefixed wphy_b2_.",
      block: {
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  wphy_b2_bad;
        mov rax, rdi;
        and rax, 0xFFFF;
        ret;
      wphy_b2_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Tail alloc / valid / free -- THE ONE WRITER of _wifi_phy_table.
  // ==========================================================================

  pub let wphy_tail_alloc : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (phy_key: u64) (body1: u64) (body2: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M3-001 (#1299): claim one WIFI PHY row. THE ONE WRITER of _wifi_phy_table. Gates: hdr in_use pre-set -> BAD_ARG; phy_key != 0 -> BAD_ARG; body1/body2 != DECODE_BAD -> BAD_ARG. Labels prefixed wphy_ta_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov r15, rcx;

        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne wphy_ta_bad;

        cmp r13, 0;
        je  wphy_ta_bad;

        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp r14, r10;
        je  wphy_ta_bad;
        cmp r15, r10;
        je  wphy_ta_bad;

        xor rbx, rbx;
      wphy_ta_scan:
        cmp rbx, 8;
        jae wphy_ta_enospc;

        lea r10, [rip + _wifi_phy_table];
        mov r11, rbx;
        shl r11, 5;
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  wphy_ta_claim;

        add rbx, 1;
        jmp wphy_ta_scan;

      wphy_ta_claim:
        mov rax, r12;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r13;
        mov [r10 + 16], r14;
        mov [r10 + 24], r15;
        mov rax, rbx;
        jmp wphy_ta_out;

      wphy_ta_enospc:
        mov rax, 0xFFFFF47F;
        jmp wphy_ta_out;
      wphy_ta_bad:
        mov rax, 0xFFFFF47E;

      wphy_ta_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let wphy_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M3-001 (#1299): 1 iff row_id < MAX and in_use. Labels prefixed wphy_tvr_.",
      block: {
        cmp rdi, 8;
        jae wphy_tvr_no;
        lea r10, [rip + _wifi_phy_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  wphy_tvr_no;
        mov rax, 1;
        ret;
      wphy_tvr_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let wphy_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M3-001 (#1299): scrub one row. Labels prefixed wphy_tf_.",
      block: {
        cmp rdi, 8;
        jae wphy_tf_out;
        lea r10, [rip + _wifi_phy_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
      wphy_tf_out:
        ret
      }
    } @no_frame

  // ==========================================================================
  // Row accessors.
  // ==========================================================================

  pub let wphy_row_key : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M3-001 (#1299): phy_key. Labels prefixed wphy_rk_.",
      block: {
        push r12;
        mov r12, rdi;
        call wphy_tail_valid;
        cmp rax, 0;
        je  wphy_rk_bad;
        lea r10, [rip + _wifi_phy_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 8];
        jmp wphy_rk_out;
      wphy_rk_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      wphy_rk_out:
        pop r12;
        ret
      }
    }

  pub let wphy_row_device : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M3-001 (#1299): device_slot (body1[31:0]). Labels prefixed wphy_rd_.",
      block: {
        push r12;
        mov r12, rdi;
        call wphy_tail_valid;
        cmp rax, 0;
        je  wphy_rd_bad;
        lea r10, [rip + _wifi_phy_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        and rax, 0xFFFFFFFF;
        jmp wphy_rd_out;
      wphy_rd_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      wphy_rd_out:
        pop r12;
        ret
      }
    }

  pub let wphy_row_hw_id : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M3-001 (#1299): hw_id (body1[47:32]). Labels prefixed wphy_rh_.",
      block: {
        push r12;
        mov r12, rdi;
        call wphy_tail_valid;
        cmp rax, 0;
        je  wphy_rh_bad;
        lea r10, [rip + _wifi_phy_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 32;
        and rax, 0xFFFF;
        jmp wphy_rh_out;
      wphy_rh_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      wphy_rh_out:
        pop r12;
        ret
      }
    }

  pub let wphy_row_bands : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M3-001 (#1299): band_mask (body1[55:48]). Labels prefixed wphy_rb_.",
      block: {
        push r12;
        mov r12, rdi;
        call wphy_tail_valid;
        cmp rax, 0;
        je  wphy_rb_bad;
        lea r10, [rip + _wifi_phy_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 48;
        and rax, 0xFF;
        jmp wphy_rb_out;
      wphy_rb_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      wphy_rb_out:
        pop r12;
        ret
      }
    }

  pub let wphy_row_channels : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M3-001 (#1299): channel_count (body1[63:56]). Labels prefixed wphy_rc_.",
      block: {
        push r12;
        mov r12, rdi;
        call wphy_tail_valid;
        cmp rax, 0;
        je  wphy_rc_bad;
        lea r10, [rip + _wifi_phy_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 56;
        and rax, 0xFF;
        jmp wphy_rc_out;
      wphy_rc_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      wphy_rc_out:
        pop r12;
        ret
      }
    }

  pub let wphy_row_regdom : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M3-001 (#1299): regdomain_id (body2[15:0]). Labels prefixed wphy_rg_.",
      block: {
        push r12;
        mov r12, rdi;
        call wphy_tail_valid;
        cmp rax, 0;
        je  wphy_rg_bad;
        lea r10, [rip + _wifi_phy_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 24];
        and rax, 0xFFFF;
        jmp wphy_rg_out;
      wphy_rg_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      wphy_rg_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Lookups.
  // ==========================================================================

  pub let wphy_find_by_key : (u64) -> u64 !{mem} @{} =
    fn (phy_key: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R38.M3-001 (#1299): live row holding phy_key, or ROW_NONE. Refuses to match 0. Labels prefixed wphy_fk_.",
      block: {
        cmp rdi, 0;
        je  wphy_fk_none;
        xor rcx, rcx;
      wphy_fk_scan:
        cmp rcx, 8;
        jae wphy_fk_none;
        lea r10, [rip + _wifi_phy_table];
        mov r11, rcx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  wphy_fk_next;
        mov rax, [r10 + 8];
        cmp rax, rdi;
        je  wphy_fk_hit;
      wphy_fk_next:
        add rcx, 1;
        jmp wphy_fk_scan;
      wphy_fk_hit:
        mov rax, rcx;
        ret;
      wphy_fk_none:
        mov rax, 0xFF;
        ret
      }
    } @no_frame

  pub let wphy_row_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R38.M3-001 (#1299): slot -> row_id, gated on live KIND_WIFI_PHY. Labels prefixed wphy_ros_.",
      block: {
        push r12;

        mov r11, 256;
        cmp rdi, r11;
        jae wphy_ros_none;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x178;
        cmp r10, r11;
        jne wphy_ros_none;

        mov r12, [rax + 16];
        mov r10, 0xFFFF;
        and r12, r10;

        mov rdi, r12;
        call wphy_tail_valid;
        cmp rax, 0;
        je  wphy_ros_none;

        mov rax, r12;
        jmp wphy_ros_out;

      wphy_ros_none:
        mov rax, 0xFF;
      wphy_ros_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Mint.  Six args -- device_slot / hw_id / bands / channels / regdom packed
  // in packed_cfg to fit the ABI:
  //
  //   packed_cfg encoding:
  //     [15:0]   device_slot
  //     [31:16]  hw_id
  //     [39:32]  band_mask
  //     [47:40]  channel_count
  //     [63:48]  regdomain_id
  // ==========================================================================

  pub let wifi_phy_cap_mint_inner : (u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (phy_key: u64) (packed_cfg: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R38.M3-001 (#1299): mint KIND_WIFI_PHY over KIND_DEVICE. Sequence: slot<256; check_parent; rights_valid; unpack; check_device; bands_valid; channels bound; hw_id bound; phy_key non-zero (NO_KEY); uniqueness (IN_USE); pack; tail_alloc; cap_mint_write. Labels prefixed wphy_mi_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov rbx, rdi;                    // slot
        mov r12, rsi;                    // parent_slot
        mov r13, rdx;                    // rights
        mov r14, rcx;                    // phy_key
        mov rbp, r8;                     // packed_cfg

        mov r10, 256;
        cmp rbx, r10;
        jae wphy_mi_bad_slot;

        mov rdi, r12;
        call wphy_check_parent;
        cmp rax, 0;
        je  wphy_mi_bad_parent;

        mov rdi, r13;
        call wphy_rights_valid;
        cmp rax, 0;
        je  wphy_mi_bad_rights;

        // device_slot check
        mov r10, rbp;
        and r10, 0xFFFF;
        mov r15, r10;                    // device_slot -> r15
        mov rdi, r15;
        call wphy_check_device;
        cmp rax, 0;
        je  wphy_mi_bad_device;

        // hw_id bound
        mov r10, rbp;
        shr r10, 16;
        and r10, 0xFFFF;
        cmp r10, 0;
        je  wphy_mi_bad_hw_id;

        // bands_valid
        mov r10, rbp;
        shr r10, 32;
        and r10, 0xFF;
        mov rdi, r10;
        call wphy_bands_valid;
        cmp rax, 0;
        je  wphy_mi_bad_bands;

        // channels bound
        mov r10, rbp;
        shr r10, 40;
        and r10, 0xFF;
        cmp r10, 0;
        je  wphy_mi_bad_chan;
        cmp r10, 64;
        ja  wphy_mi_bad_chan;

        cmp r14, 0;
        je  wphy_mi_no_key;

        mov rdi, r14;
        call wphy_find_by_key;
        cmp rax, 0xFF;
        jne wphy_mi_in_use;

        // Pack body1.
        mov rdi, r15;                    // device_slot
        mov rsi, rbp;
        shr rsi, 16;
        and rsi, 0xFFFF;                 // hw_id
        mov rdx, rbp;
        shr rdx, 32;
        and rdx, 0xFF;                   // bands
        mov rcx, rbp;
        shr rcx, 40;
        and rcx, 0xFF;                   // channels
        call wphy_body1_pack;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  wphy_mi_bad_hw_id;
        mov r15, rax;                    // body1 -> r15

        // Pack body2.
        mov rdi, rbp;
        shr rdi, 48;
        and rdi, 0xFFFF;                 // regdomain_id
        call wphy_body2_pack;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  wphy_mi_bad_hw_id;
        // save body2 on stack
        push rax;
        push r15;                        // body1 also on stack

        // Header.
        mov rdi, r12;
        call wphy_hdr_pack;
        pop r15;                         // body1
        pop rbp;                         // body2
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  wphy_mi_bad_parent;

        // tail_alloc(hdr, phy_key, body1, body2).
        mov rdi, rax;
        mov rsi, r14;
        mov rdx, r15;
        mov rcx, rbp;
        call wphy_tail_alloc;

        mov r10, 0xFFFFF47F;
        cmp rax, r10;
        je  wphy_mi_enospc;
        mov r10, 0xFFFFF47E;
        cmp rax, r10;
        je  wphy_mi_bad_hw_id;

        mov r15, rax;                    // row_id
        mov r11, rbx;
        shl r11, 16;
        or  r15, r11;

        mov rdi, rbx;
        mov rsi, 0x178;
        mov rdx, r13;
        mov rcx, r15;
        call cap_mint_write;

        mov rdi, 0;
        call wphy_note;

        xor rax, rax;
        jmp wphy_mi_out;

      wphy_mi_bad_slot:
        mov rax, 0xFFFFF474;
        jmp wphy_mi_out;
      wphy_mi_bad_parent:
        mov rax, 0xFFFFF47D;
        jmp wphy_mi_out;
      wphy_mi_bad_rights:
        mov rax, 0xFFFFF47C;
        jmp wphy_mi_out;
      wphy_mi_bad_device:
        mov rax, 0xFFFFF47B;
        jmp wphy_mi_out;
      wphy_mi_bad_hw_id:
        mov rax, 0xFFFFF47A;
        jmp wphy_mi_out;
      wphy_mi_bad_bands:
        mov rax, 0xFFFFF479;
        jmp wphy_mi_out;
      wphy_mi_bad_chan:
        mov rax, 0xFFFFF478;
        jmp wphy_mi_out;
      wphy_mi_no_key:
        mov rax, 0xFFFFF477;
        jmp wphy_mi_out;
      wphy_mi_in_use:
        mov rdi, 2;
        call wphy_note;
        mov rax, 0xFFFFF476;
        jmp wphy_mi_out;
      wphy_mi_enospc:
        mov rdi, 2;
        call wphy_note;
        mov rax, 0xFFFFF475;

      wphy_mi_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Revoke.
  // ==========================================================================

  pub let wifi_phy_cap_revoke_inner : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R38.M3-001 (#1299): revoke KIND_WIFI_PHY. Labels prefixed wphy_rvk_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rdi;

        mov r10, 256;
        cmp r12, r10;
        jae wphy_rvk_bad_slot;

        mov rax, cap_table;
        mov r8, r12;
        shl r8, 3;
        mov r9, r12;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov rbx, rax;

        mov r10, [rbx + 0];
        cmp r10, 0;
        je  wphy_rvk_already;

        mov r11, 0x178;
        cmp r10, r11;
        jne wphy_rvk_wrong_kind;

        mov r13, [rbx + 16];
        mov r10, 0xFFFF;
        and r13, r10;

        mov rdi, r13;
        call wphy_tail_valid;
        cmp rax, 0;
        je  wphy_rvk_clear;

        mov rdi, r13;
        call wphy_tail_free;

      wphy_rvk_clear:
        mov rdi, r12;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        mov rdi, 1;
        call wphy_note;

        xor rax, rax;
        jmp wphy_rvk_out;

      wphy_rvk_bad_slot:
        mov rax, 0xFFFFF474;
        jmp wphy_rvk_out;
      wphy_rvk_wrong_kind:
        mov rax, 0xFFFFF473;
        jmp wphy_rvk_out;
      wphy_rvk_already:
        mov rax, 0xFFFFF472;

      wphy_rvk_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Dispatch handler.  Queries only.
  // ==========================================================================

  pub let cap_handler_wifi_phy : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R38.M3-001 (#1299): KIND_WIFI_PHY dispatch. All ops arity ONE -- op_arg[63:8] REFUSED. Query ops require INVOKE; DEBUG_PRINT requires OBSERVE. Labels prefixed wphy_hn_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push rbp;

        mov r12, rdi;
        mov r13, rsi;
        mov r10, 0xFFFF;
        and r13, r10;
        mov r14, rdx;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_wifi_phy_msg];
        call klog_s1;

        mov r10, r14;
        and r10, 0xFF;
        mov rbp, r10;
        mov r11, r14;
        shr r11, 8;
        cmp r11, 0;
        jne wphy_hn_res;

        cmp rbp, 6;
        ja  wphy_hn_unsup;

        cmp rbp, 6;
        je  wphy_hn_dbg;

        // Ops 0..5: INVOKE.
        mov r10, r12;
        and r10, 0x008;
        cmp r10, 0;
        je  wphy_hn_denied;

        mov rdi, r13;
        cmp rbp, 0;
        je  wphy_hn_key;
        cmp rbp, 1;
        je  wphy_hn_dev;
        cmp rbp, 2;
        je  wphy_hn_hw;
        cmp rbp, 3;
        je  wphy_hn_bands;
        cmp rbp, 4;
        je  wphy_hn_chan;
        call wphy_row_regdom;
        jmp wphy_hn_out;

      wphy_hn_key:
        call wphy_row_key;
        jmp wphy_hn_out;
      wphy_hn_dev:
        call wphy_row_device;
        jmp wphy_hn_out;
      wphy_hn_hw:
        call wphy_row_hw_id;
        jmp wphy_hn_out;
      wphy_hn_bands:
        call wphy_row_bands;
        jmp wphy_hn_out;
      wphy_hn_chan:
        call wphy_row_channels;
        jmp wphy_hn_out;

      wphy_hn_dbg:
        mov r10, r12;
        and r10, 0x400;
        cmp r10, 0;
        je  wphy_hn_denied;
        xor rax, rax;
        jmp wphy_hn_out;

      wphy_hn_res:
        mov rax, 0xFFFFF47E;
        jmp wphy_hn_out;
      wphy_hn_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;
        jmp wphy_hn_out;
      wphy_hn_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;

      wphy_hn_out:
        pop rbp;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
