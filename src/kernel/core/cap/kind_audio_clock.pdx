  // ==========================================================================
  // Uniqueness lookup and slot resolution.
  // ==========================================================================

  pub let audio_clock_find_by_key : (u64) -> u64 !{mem} @{} =
    fn (timeline_key: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M3-003 (#1149): live row holding this key, or ROW_NONE. Refuses key=0 outright. Labels prefixed aclk_fk_.",
      block: {
        cmp rdi, 0;
        je  aclk_fk_none;
        xor rcx, rcx;
      aclk_fk_scan:
        cmp rcx, 4;
        jae aclk_fk_none;
        lea r10, [rip + _audio_clock_table];
        mov r11, rcx;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  aclk_fk_next;
        mov rax, [r10 + 8];
        cmp rax, rdi;
        je  aclk_fk_hit;
      aclk_fk_next:
        add rcx, 1;
        jmp aclk_fk_scan;
      aclk_fk_hit:
        mov rax, rcx;
        ret;
      aclk_fk_none:
        mov rax, 0xFF;
        ret
      }
    }

  pub let audio_clock_row_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R33.M3-003 (#1149): slot -> row_id, gated on live KIND_AUDIO_CLOCK descriptor. ARITY ONE. Labels prefixed aclk_ros_.",
      block: {
        push r12; push r13; push r14;

        mov r11, 256;
        cmp rdi, r11;
        jae aclk_ros_none;

        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x160;                  // KIND_AUDIO_CLOCK
        cmp r10, r11;
        jne aclk_ros_none;

        mov r12, [rax + 16];
        mov r10, 0xFFFF;
        and r12, r10;

        mov rdi, r12;
        call audio_clock_tail_valid;
        cmp rax, 0;
        je  aclk_ros_none;

        mov rax, r12;
        jmp aclk_ros_out;

      aclk_ros_none:
        mov rax, 0xFF;
      aclk_ros_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

