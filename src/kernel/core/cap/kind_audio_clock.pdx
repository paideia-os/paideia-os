// src/kernel/core/cap/kind_audio_clock.pdx — R33.M3-003 (#1149)
//
// KIND_AUDIO_CLOCK = 0x160, derived over KIND_HW (14).
//
// The authority to name ONE hardware audio timeline domain (its sync
// source, its nominal rate, its running current rate) and to be told
// when the driver observed a new current rate or produced samples. The
// FIRST NON-GPU CONSUMER of the KIND_HW_TIMELINE family — see §2.
//
// =============================================================================
// §0  UNITS: RATES ARE ALWAYS IN Hz, NEVER IN kHz OR TICKS
// =============================================================================
//
// nominal_hz and current_hz are stored verbatim as Hz — 48000 for a
// 48 kHz sample clock, never 48 for kHz nor 96000 for a doubled-rate
// interpretation. Two arithmetic units in one row would let a report
// installer that thought in kHz install a rate the driver's sampling
// loop reads as Hz — off by 1000× — and the amplifier would happily
// consume 48 samples per second at what the caller believed was 48 kHz.
//
// PCM_CLOCK_HZ_MIN (=8000) and PCM_CLOCK_HZ_MAX (=192000) bound both
// rates. Below 8 kHz is telephony territory this platform does not host
// (the HDA controller cannot even program it); above 192 kHz is beyond
// what T14 G4 codecs advertise. A caller-supplied 1 Hz would install a
// clock nobody could drain and no report installer would refuse; a
// caller-supplied 384 kHz would double the DMA rate silently.
//
// =============================================================================
// §1  STATIC IDENTITY IS AT MINT, DYNAMIC STATE IS INSTALLED
// =============================================================================
//
// Same discipline as `kind_audio_controller.pdx` §1. The row's four
// identity-ish fields split into three set-once and one dynamic:
//
//   * clock_source — 1 (HDA_BCLK) or 2 (PCH_GEN). ROW IDENTITY.
//                    Zero refused because zero is the "no source"
//                    sentinel; anything above 2 refused because that
//                    is a decoder answer, not a legitimate parent
//                    state.
//   * nominal_hz  — 8000..192000. ROW IDENTITY. A nominal rate that
//                    could be raised at runtime would silently widen
//                    every downstream buffer sizing decision.
//   * current_hz  — 8000..192000. DYNAMIC — updated by
//                    audio_clock_report_install.
//   * samples_produced — u64. DYNAMIC — bumped by the same installer.
//
// =============================================================================
// §2  DERIVATION OVER KIND_HW — AND THE INTENDED TIGHTENING TO
//     KIND_HW_TIMELINE
// =============================================================================
//
// The gate demands `kind == KIND_HW (14)` carrying RIGHT_MINT. That
// half discriminates NOTHING on its own: every hardware-adjacent
// authority in the machine is a KIND_HW at some slot. This is the same
// pattern KIND_AUDIO_CONTROLLER states over KIND_DEVICE at length.
//
// THE INTENDED PARENT IS KIND_HW_TIMELINE, not raw KIND_HW.
// KIND_HW_TIMELINE (planned in the R29.M1 derived-kind block per
// kind.pdx §KIND_HW) has not landed as of R33.M3. When it does, the
// parent-kind check in audio_clock_check_parent tightens from
// KIND_HW (14) to KIND_HW_TIMELINE (0x142 or whichever tag the
// R29 successor commits picks) IN PLACE — no other change in this
// module, because the mint continues to inherit the clock source key
// from the parent's target_ptr rather than accepting it as an argument.
// The audio-clock witness's happy-path stage today mints from a
// synthetic KIND_HW parent; when the tightening lands, the fixture
// mints a synthetic KIND_HW_TIMELINE and every stage of this witness
// stays valid without renumbering assertions.
//
// The second half of the gate:
//
//   * The inherited timeline key must be NON-ZERO
//     (`AUDIO_CLOCK_MINT_NO_TIMELINE`).
//   * NO OTHER LIVE ROW MAY HOLD THAT KEY
//     (`AUDIO_CLOCK_MINT_IN_USE`). One timeline, one capability.
//   * clock_source in [1, 2].
//   * nominal_hz in [PCM_CLOCK_HZ_MIN, PCM_CLOCK_HZ_MAX].
//
// =============================================================================
// §3  A GARBAGE REPORT IS DANGEROUS
// =============================================================================
//
// audio_clock_report_install pushes (new_current_hz, samples_delta) in
// one call. gates:
//
//   * new_current_hz outside [MIN, MAX] -> IMPLAUSIBLE_RATE, counted,
//     and NOTHING IN THE ROW IS TOUCHED. NOT CLAMPED.
//   * samples_delta > PCM_CLOCK_SAMPLE_DELTA_MAX (=192000) is refused:
//     one report should not claim more samples than a full second of
//     the fastest supported rate produced; a caller that has that
//     many samples to report should split them.
//
// =============================================================================
// §4  WHAT THIS KIND DOES NOT DO
// =============================================================================
//
//   * NOTHING DRIVES A CLOCK. No MMIO, no port I/O; the code path here
//     is a row read/write only.
//   * NOTHING NARROWS OR WIDENS clock_source AT RUNTIME. It is set
//     once at mint and there is no primitive that changes it.
//
// =============================================================================
// §5  NO PORT I/O, NO AML, NO FIRMWARE NAMES
// =============================================================================
//
// Contains no `in`/`out` and no firmware-bytecode identifier.
// `tools/lint-no-kernel-aml.sh` refuses any kernel identifier matching
// `\baml`, `\bdsdt`, `\bssdt`, `\bacpica`, `\_SB_` or `\_SB.`.
// KIND_AUDIO_CLOCK, audio_clock_* and _audio_clock_table match none.
//
// =============================================================================

module KindAudioClock = structure {

  // ==========================================================================
  // The tag, and the parent kind.
  // ==========================================================================

  pub let KIND_AUDIO_CLOCK : u64 = 0x160        // derived-kind tag (352)
  pub let AUDIO_CLOCK_PARENT_KIND : u64 = 14    // = KIND_HW (see §2)

  // ==========================================================================
  // §0 bounds and §1 enumeration.
  // ==========================================================================

  pub let PCM_CLOCK_HZ_MIN            : u64 = 8000
  pub let PCM_CLOCK_HZ_MAX            : u64 = 192000
  pub let PCM_CLOCK_SAMPLE_DELTA_MAX  : u64 = 192000

  pub let CLOCK_SOURCE_UNKNOWN  : u64 = 0
  pub let CLOCK_SOURCE_HDA_BCLK : u64 = 1
  pub let CLOCK_SOURCE_PCH_GEN  : u64 = 2
  pub let CLOCK_SOURCE_MAX      : u64 = 2

  // ==========================================================================
  // Rights. Leaf kind — RIGHT_MINT is OUTSIDE the mask (no derivation
  // from an audio-clock capability).
  // ==========================================================================

  pub let R_AUDIO_CLOCK_READ    : u64 = 0x001
  pub let R_AUDIO_CLOCK_REPORT  : u64 = 0x002
  pub let R_AUDIO_CLOCK_INVOKE  : u64 = 0x008
  pub let R_AUDIO_CLOCK_REVOKE  : u64 = 0x010
  pub let R_AUDIO_CLOCK_OBSERVE : u64 = 0x400
  pub let R_AUDIO_CLOCK_ALL     : u64 = 0x41B

  // ==========================================================================
  // Ops.
  //
  //   0 QUERY_SOURCE   INVOKE   clock_source ordinal
  //   1 QUERY_NOMINAL  INVOKE   nominal_hz
  //   2 QUERY_CURRENT  INVOKE   current_hz
  //   3 QUERY_SAMPLES  INVOKE   samples_produced
  //   4 QUERY_PARENT   INVOKE   parent slot
  //   5 DEBUG_PRINT    OBSERVE  row dump
  //   6 REPORT         REPORT   push {new_current_hz, samples_delta}
  //
  // REPORT layout:
  //   op_arg[7:0]    = op = 6
  //   op_arg[27:8]   = new_current_hz  (20 bits, 0..0xFFFFF > MAX)
  //   op_arg[47:28]  = samples_delta   (20 bits, capped at MAX)
  //   op_arg[63:48]  = reserved, MUST be zero
  // ==========================================================================

  pub let AUDIO_CLOCK_OP_QUERY_SOURCE  : u64 = 0
  pub let AUDIO_CLOCK_OP_QUERY_NOMINAL : u64 = 1
  pub let AUDIO_CLOCK_OP_QUERY_CURRENT : u64 = 2
  pub let AUDIO_CLOCK_OP_QUERY_SAMPLES : u64 = 3
  pub let AUDIO_CLOCK_OP_QUERY_PARENT  : u64 = 4
  pub let AUDIO_CLOCK_OP_DEBUG_PRINT   : u64 = 5
  pub let AUDIO_CLOCK_OP_REPORT        : u64 = 6
  pub let AUDIO_CLOCK_OP_MAX           : u64 = 6

  // ==========================================================================
  // Failure taxonomy — 0xFFFFFED0..0xFFFFFEDF.
  // Disjoint from KIND_AUDIO_CONTROLLER (0xFFFFFEB0..BF), KIND_SENSOR
  // (0xFFFFFEA0..AF), KIND_HID_EVENT (0xFFFFFE90..9F), etc.
  // ==========================================================================

  pub let AUDIO_CLOCK_OK                   : u64 = 0
  pub let AUDIO_CLOCK_TAIL_ENOSPC          : u64 = 0xFFFFFEDF
  pub let AUDIO_CLOCK_TAIL_BAD_ARG         : u64 = 0xFFFFFEDE
  pub let AUDIO_CLOCK_MINT_BAD_PARENT      : u64 = 0xFFFFFEDD
  pub let AUDIO_CLOCK_MINT_BAD_RIGHTS      : u64 = 0xFFFFFEDC
  pub let AUDIO_CLOCK_MINT_BAD_SOURCE      : u64 = 0xFFFFFEDB
  pub let AUDIO_CLOCK_MINT_BAD_NOMINAL     : u64 = 0xFFFFFEDA
  pub let AUDIO_CLOCK_MINT_NO_TIMELINE     : u64 = 0xFFFFFED8
  pub let AUDIO_CLOCK_MINT_ENOSPC          : u64 = 0xFFFFFED7
  pub let AUDIO_CLOCK_MINT_IN_USE          : u64 = 0xFFFFFED6
  pub let AUDIO_CLOCK_BAD_SLOT             : u64 = 0xFFFFFED5
  pub let AUDIO_CLOCK_WRONG_KIND           : u64 = 0xFFFFFED4
  pub let AUDIO_CLOCK_REVOKE_ALREADY       : u64 = 0xFFFFFED3
  pub let AUDIO_CLOCK_IMPLAUSIBLE_RATE     : u64 = 0xFFFFFED2
  pub let AUDIO_CLOCK_IMPLAUSIBLE_DELTA    : u64 = 0xFFFFFED1

  pub let AUDIO_CLOCK_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let AUDIO_CLOCK_ROW_NONE : u64 = 0xFF

  // ==========================================================================
  // Table sizing and row layout.
  //
  // FOUR ROWS. A T14 G4 hosts one HDA_BCLK domain and one PCH_GEN
  // domain; four leaves headroom for a second HDA controller and a
  // reserved slot.
  //
  //   [+0]  header word
  //           bits [7:0]   reserved, must be zero
  //           bits [15:8]  parent_slot
  //           bits [55:16] reserved, must be zero
  //           bits [63:56] in_use
  //   [+8]  timeline_key   INHERITED from parent target_ptr, non-zero.
  //   [+16] clock_source   1..2
  //   [+24] nominal_hz     [PCM_CLOCK_HZ_MIN, PCM_CLOCK_HZ_MAX]
  //   [+32] current_hz     [PCM_CLOCK_HZ_MIN, PCM_CLOCK_HZ_MAX]
  //   [+40] samples_produced u64 lifetime
  //   [+48] reports        u64 lifetime install count
  //   [+56] reserved
  // ==========================================================================

  pub let AUDIO_CLOCK_MAX       : u64 = 4
  pub let AUDIO_CLOCK_ROW_BYTES : u64 = 64

  pub let mut _audio_clock_table : [u64; 32] = uninit @align(64)

  pub let mut _audio_clock_stats : [u64; 8] = uninit @align(64)

  pub let AUDIO_CLOCK_ST_MINTS      : u64 = 0
  pub let AUDIO_CLOCK_ST_REPORTS    : u64 = 1
  pub let AUDIO_CLOCK_ST_IMPL_RATE  : u64 = 2
  pub let AUDIO_CLOCK_ST_IMPL_DELTA : u64 = 3
  pub let AUDIO_CLOCK_ST_IN_USE     : u64 = 4
  pub let AUDIO_CLOCK_ST_ENOSPC     : u64 = 5
  pub let AUDIO_CLOCK_ST_REVOKES    : u64 = 6
  pub let AUDIO_CLOCK_ST_MAX        : u64 = 8

  // R51 boot-transcript §5 Bug B: strip embedded '\n' (composer emits its own).
  pub let aclk_dbg_msg : [u8; 16] = "AUDIO CLOCK ROW\0"
  pub let aclk_k_row : [u8; 4] = "row\0"
  pub let aclk_k_src : [u8; 4] = "src\0"
  pub let aclk_k_nom : [u8; 5] = "nomz\0"
  pub let aclk_k_cur : [u8; 5] = "curz\0"
  pub let aclk_k_smp : [u8; 5] = "smpl\0"

  // ==========================================================================
  // audio_clock_table_reset() -> ()
  // ==========================================================================

  pub let audio_clock_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M3-003 (#1149): clear every row and every counter. Boot and teardown only. Labels prefixed aclk_rs_ per reserved-label discipline.",
      block: {
        lea r10, [rip + _audio_clock_table];
        xor rax, rax;
        xor rcx, rcx;
      aclk_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  aclk_rs_rows;

        lea r10, [rip + _audio_clock_stats];
        xor rcx, rcx;
      aclk_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  aclk_rs_stats;
        ret
      }
    }

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let audio_clock_source_valid : (u64) -> u64 !{} @{} =
    fn (src: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M3-003 (#1149): 1 iff src in [1, CLOCK_SOURCE_MAX]. UNKNOWN (0) refused per §1. Pure leaf. Labels prefixed aclk_sv_.",
      block: {
        cmp rdi, 0;
        je  aclk_sv_no;
        mov r10, 2;                      // CLOCK_SOURCE_MAX
        cmp rdi, r10;
        ja  aclk_sv_no;
        mov rax, 1;
        ret;
      aclk_sv_no:
        xor rax, rax;
        ret
      }
    }

  pub let audio_clock_hz_valid : (u64) -> u64 !{} @{} =
    fn (hz: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M3-003 (#1149): 1 iff hz in [PCM_CLOCK_HZ_MIN, PCM_CLOCK_HZ_MAX]. §0. Pure leaf. Labels prefixed aclk_hv_.",
      block: {
        mov r10, 8000;                   // PCM_CLOCK_HZ_MIN
        cmp rdi, r10;
        jb  aclk_hv_no;
        mov r10, 192000;                 // PCM_CLOCK_HZ_MAX
        cmp rdi, r10;
        ja  aclk_hv_no;
        mov rax, 1;
        ret;
      aclk_hv_no:
        xor rax, rax;
        ret
      }
    }

  pub let audio_clock_delta_valid : (u64) -> u64 !{} @{} =
    fn (d: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M3-003 (#1149): 1 iff d <= PCM_CLOCK_SAMPLE_DELTA_MAX. §3. Pure leaf. Labels prefixed aclk_dv_.",
      block: {
        mov r10, 192000;                 // PCM_CLOCK_SAMPLE_DELTA_MAX
        cmp rdi, r10;
        ja  aclk_dv_no;
        mov rax, 1;
        ret;
      aclk_dv_no:
        xor rax, rax;
        ret
      }
    }

  pub let audio_clock_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M3-003 (#1149): 1 iff (rights & R_AUDIO_CLOCK_ALL) == rights. Leaf. Labels prefixed aclk_rvv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x41B;
        and rax, r10;
        cmp rax, rdi;
        jne aclk_rvv_no;
        mov rax, 1;
        ret;
      aclk_rvv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Counters.
  // ==========================================================================

  pub let audio_clock_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M3-003 (#1149): increment one counter. Leaf. Labels prefixed aclk_nt_.",
      block: {
        cmp rdi, 8;
        jae aclk_nt_out;
        lea r10, [rip + _audio_clock_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      aclk_nt_out:
        ret
      }
    }

  pub let audio_clock_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M3-003 (#1149): bounds-checked read of one counter. Leaf. Labels prefixed aclk_st_.",
      block: {
        cmp rdi, 8;
        jae aclk_st_zero;
        lea r10, [rip + _audio_clock_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      aclk_st_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Derivation gate.
  // ==========================================================================

  pub let audio_clock_check_parent : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R33.M3-003 (#1149): first half of the KIND_AUDIO_CLOCK derivation gate. parent_slot < 256; kind == KIND_HW (14) AND RIGHT_MINT (0x200). §2 documents the intended tightening to KIND_HW_TIMELINE. Labels prefixed aclk_cp_.",
      block: {
        cmp rdi, 256;
        jae aclk_cp_no;
        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 14;                     // KIND_HW
        jne aclk_cp_no;

        mov r10, [rax + 8];
        mov r11, 0x200;
        and r10, r11;
        cmp r10, 0;
        je  aclk_cp_no;

        mov rax, 1;
        ret;
      aclk_cp_no:
        xor rax, rax;
        ret
      }
    }

  pub let audio_clock_parent_key : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R33.M3-003 (#1149): read the parent's target_ptr as the timeline key. Zero on bad slot or wrong kind. Labels prefixed aclk_pk_.",
      block: {
        cmp rdi, 256;
        jae aclk_pk_no;
        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 14;
        jne aclk_pk_no;

        mov rax, [rax + 16];
        ret;
      aclk_pk_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Header pack/unpack.
  // ==========================================================================

  pub let audio_clock_hdr_pack : (u64) -> u64 !{} @{} =
    fn (parent_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M3-003 (#1149): pack (parent_slot << 8), leaving [7:0], [55:16], [63:56] clear. Pure leaf. Labels prefixed aclk_hp_.",
      block: {
        mov r10, 256;
        cmp rdi, r10;
        jae aclk_hp_bad;
        mov rax, rdi;
        shl rax, 8;
        ret;
      aclk_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let audio_clock_hdr_parent : (u64) -> u64 !{} @{} =
    fn (hdr: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R33.M3-003 (#1149): parent_slot from bits [15:8]. Pure leaf.",
      block: { mov rax, rdi; shr rax, 8; and rax, 0xFF; ret }
    }

  // ==========================================================================
  // Tail alloc / free.
  // ==========================================================================

  pub let audio_clock_tail_alloc : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (timeline_key: u64) (clock_source: u64) (nominal_hz: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M3-003 (#1149): claim one row. THE ONLY FUNCTION IN THE KERNEL THAT WRITES A CLOCK'S static-identity fields. Gates: hdr in_use/reserved zero; timeline_key non-zero; clock_source in [1,CLOCK_SOURCE_MAX]; nominal_hz in [PCM_CLOCK_HZ_MIN, PCM_CLOCK_HZ_MAX]. Low-first scan over 4 rows of 64 bytes. Sets current_hz = nominal_hz initially, samples_produced = 0. Labels prefixed aclk_ta_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // hdr
        mov r13, rsi;                    // timeline_key
        mov r14, rdx;                    // clock_source
        mov r15, rcx;                    // nominal_hz

        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne aclk_ta_bad;

        mov rax, r12;
        and rax, 0xFF;
        cmp rax, 0;
        jne aclk_ta_bad;

        mov rax, r12;
        shr rax, 16;
        mov r10, 0xFFFFFFFFFF;
        and rax, r10;
        cmp rax, 0;
        jne aclk_ta_bad;

        cmp r13, 0;
        je  aclk_ta_bad;

        cmp r14, 0;
        je  aclk_ta_bad;
        mov r10, 2;                      // CLOCK_SOURCE_MAX
        cmp r14, r10;
        ja  aclk_ta_bad;

        mov r10, 8000;
        cmp r15, r10;
        jb  aclk_ta_bad;
        mov r10, 192000;
        cmp r15, r10;
        ja  aclk_ta_bad;

        xor rbx, rbx;
      aclk_ta_scan:
        cmp rbx, 4;                      // AUDIO_CLOCK_MAX
        jae aclk_ta_enospc;

        lea r10, [rip + _audio_clock_table];
        mov r11, rbx;
        shl r11, 6;
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  aclk_ta_claim;

        add rbx, 1;
        jmp aclk_ta_scan;

      aclk_ta_claim:
        mov rax, r12;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r13;             // timeline_key
        mov [r10 + 16], r14;             // clock_source
        mov [r10 + 24], r15;             // nominal_hz
        mov [r10 + 32], r15;             // current_hz = nominal_hz
        xor rax, rax;
        mov [r10 + 40], rax;             // samples_produced = 0
        mov [r10 + 48], rax;             // reports = 0
        mov [r10 + 56], rax;
        mov rax, rbx;
        jmp aclk_ta_out;

      aclk_ta_enospc:
        mov rax, 0xFFFFFEDF;             // AUDIO_CLOCK_TAIL_ENOSPC
        jmp aclk_ta_out;
      aclk_ta_bad:
        mov rax, 0xFFFFFEDE;             // AUDIO_CLOCK_TAIL_BAD_ARG

      aclk_ta_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let audio_clock_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M3-003 (#1149): 1 iff row_id < AUDIO_CLOCK_MAX and in_use. Labels prefixed aclk_tv_.",
      block: {
        cmp rdi, 4;
        jae aclk_tv_no;
        lea r10, [rip + _audio_clock_table];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  aclk_tv_no;
        mov rax, 1;
        ret;
      aclk_tv_no:
        xor rax, rax;
        ret
      }
    }

  pub let audio_clock_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M3-003 (#1149): scrub one row to zero. Labels prefixed aclk_tf_.",
      block: {
        cmp rdi, 4;
        jae aclk_tf_out;
        lea r10, [rip + _audio_clock_table];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        mov [r10 + 32], rax;
        mov [r10 + 40], rax;
        mov [r10 + 48], rax;
        mov [r10 + 56], rax;
      aclk_tf_out:
        ret
      }
    }

  // ==========================================================================
  // Row accessors.
