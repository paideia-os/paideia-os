  pub let audio_clock_row_hdr : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R33.M3-003 (#1149): header word or DECODE_BAD. Labels prefixed aclk_rh_.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        call audio_clock_tail_valid;
        cmp rax, 0;
        je  aclk_rh_bad;
        lea r10, [rip + _audio_clock_table];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        jmp aclk_rh_out;
      aclk_rh_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      aclk_rh_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

