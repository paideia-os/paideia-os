  // ==========================================================================
  // audio_clock_report_install(slot, new_current_hz, samples_delta)
  //
  // ARITY THREE — a capability and the two dynamic fields §1 declares.
  // ==========================================================================

  pub let audio_clock_report_install : (u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) (new_current_hz: u64) (samples_delta: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R33.M3-003 (#1149): install one clock report. ARITY THREE: a capability and the two dynamic fields §1 declares. Gates: (1) slot must name live KIND_AUDIO_CLOCK -> BAD_SLOT. (2) new_current_hz in [MIN, MAX] -> else IMPLAUSIBLE_RATE, counted, ROW UNTOUCHED. (3) samples_delta <= SAMPLE_DELTA_MAX -> else IMPLAUSIBLE_DELTA, counted, ROW UNTOUCHED. (4) Update current_hz and samples_produced += delta; bump reports. Labels prefixed aclk_ri_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov r12, rsi;                    // new_current_hz
        mov r13, rdx;                    // samples_delta

        call audio_clock_row_of_slot;
        mov rbx, rax;
        cmp rbx, 0xFF;
        je  aclk_ri_bad_slot;

        mov r10, 8000;
        cmp r12, r10;
        jb  aclk_ri_impl_rate;
        mov r10, 192000;
        cmp r12, r10;
        ja  aclk_ri_impl_rate;

        mov r10, 192000;
        cmp r13, r10;
        ja  aclk_ri_impl_delta;

        lea r10, [rip + _audio_clock_table];
        mov r11, rbx;
        shl r11, 6;
        add r10, r11;

        mov [r10 + 32], r12;             // current_hz

        mov rax, [r10 + 40];             // samples_produced
        add rax, r13;
        mov [r10 + 40], rax;

        mov rax, [r10 + 48];
        add rax, 1;
        mov [r10 + 48], rax;

        mov rdi, 1;                      // ST_REPORTS
        call audio_clock_note;

        xor rax, rax;
        jmp aclk_ri_out;

      aclk_ri_bad_slot:
        mov rax, 0xFFFFFED5;
        jmp aclk_ri_out;
      aclk_ri_impl_rate:
        mov rdi, 2;                      // ST_IMPL_RATE
        call audio_clock_note;
        mov rax, 0xFFFFFED2;
        jmp aclk_ri_out;
      aclk_ri_impl_delta:
        mov rdi, 3;                      // ST_IMPL_DELTA
        call audio_clock_note;
        mov rax, 0xFFFFFED1;

      aclk_ri_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // audio_clock_cap_mint_inner(slot, parent_slot, rights, clock_source,
  //                            nominal_hz) -> OK | MINT_*
  // ==========================================================================

  pub let audio_clock_cap_mint_inner : (u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (clock_source: u64) (nominal_hz: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R33.M3-003 (#1149): mint a KIND_AUDIO_CLOCK over a KIND_HW (planned tightening to KIND_HW_TIMELINE per §2). Gates: (1) slot < 256. (2) check_parent -> BAD_PARENT. (3) rights_valid -> BAD_RIGHTS. (4) source_valid -> BAD_SOURCE. (5) hz_valid(nominal_hz) -> BAD_NOMINAL. (6) parent_key non-zero -> else NO_TIMELINE. (7) find_by_key must return NONE -> else IN_USE. (8) hdr_pack + tail_alloc -> ENOSPC on exhaustion. (9) cap_mint_write with target_ptr = row_id | (slot << 16). Labels prefixed aclk_mi_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov rbx, rdi;                    // slot
        mov r12, rsi;                    // parent_slot
        mov r13, rdx;                    // rights
        mov r14, rcx;                    // clock_source
        mov r15, r8;                     // nominal_hz

        mov r10, 256;
        cmp rbx, r10;
        jae aclk_mi_bad_slot;

        mov rdi, r12;
        call audio_clock_check_parent;
        cmp rax, 0;
        je  aclk_mi_bad_parent;

        mov rdi, r13;
        call audio_clock_rights_valid;
        cmp rax, 0;
        je  aclk_mi_bad_rights;

        mov rdi, r14;
        call audio_clock_source_valid;
        cmp rax, 0;
        je  aclk_mi_bad_source;

        mov rdi, r15;
        call audio_clock_hz_valid;
        cmp rax, 0;
        je  aclk_mi_bad_nominal;

        mov rdi, r12;
        call audio_clock_parent_key;
        cmp rax, 0;
        je  aclk_mi_no_timeline;

        mov r10, rax;
        push r10;
        sub rsp, 8;
        mov rdi, r10;
        call audio_clock_find_by_key;
        add rsp, 8;
        pop r10;
        cmp rax, 0xFF;
        jne aclk_mi_in_use_note;

        push r10;
        sub rsp, 8;
        mov rdi, r12;
        call audio_clock_hdr_pack;
        add rsp, 8;
        pop r10;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  aclk_mi_bad_parent;

        mov rdi, rax;                    // hdr
        mov rsi, r10;                    // timeline_key
        mov rdx, r14;                    // clock_source
        mov rcx, r15;                    // nominal_hz
        call audio_clock_tail_alloc;

        mov r10, 0xFFFFFEDF;
        cmp rax, r10;
        je  aclk_mi_enospc;
        mov r10, 0xFFFFFEDE;
        cmp rax, r10;
        je  aclk_mi_bad_source;

        mov r14, rax;
        mov r11, rbx;
        shl r11, 16;
        or  r14, r11;

        mov rdi, rbx;
        mov rsi, 0x160;
        mov rdx, r13;
        mov rcx, r14;
        call cap_mint_write;

        mov rdi, 0;                      // ST_MINTS
        call audio_clock_note;

        xor rax, rax;
        jmp aclk_mi_out;

      aclk_mi_in_use_note:
        mov rdi, 4;                      // ST_IN_USE
        call audio_clock_note;
        mov rax, 0xFFFFFED6;
        jmp aclk_mi_out;

      aclk_mi_bad_slot:
        mov rax, 0xFFFFFED5;
        jmp aclk_mi_out;
      aclk_mi_bad_parent:
        mov rax, 0xFFFFFEDD;
        jmp aclk_mi_out;
      aclk_mi_bad_rights:
        mov rax, 0xFFFFFEDC;
        jmp aclk_mi_out;
      aclk_mi_bad_source:
        mov rax, 0xFFFFFEDB;
        jmp aclk_mi_out;
      aclk_mi_bad_nominal:
        mov rax, 0xFFFFFEDA;
        jmp aclk_mi_out;
      aclk_mi_no_timeline:
        mov rax, 0xFFFFFED8;
        jmp aclk_mi_out;
      aclk_mi_enospc:
        mov rdi, 5;                      // ST_ENOSPC
        call audio_clock_note;
        mov rax, 0xFFFFFED7;

      aclk_mi_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let audio_clock_cap_mint : (u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (clock_source: u64) (nominal_hz: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R33.M3-003 (#1149): audited mint. Labels: none.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;
        mov r13, rsi;

        call audio_clock_cap_mint_inner;
        mov r14, rax;

        mov rdi, 1;                      // DRV_AUDIT_EV_MINT
        mov rsi, 0x160;
        mov rdx, r12;
        mov rcx, r13;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Revoke.
  // ==========================================================================

  pub let audio_clock_cap_revoke_inner : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R33.M3-003 (#1149): revoke a KIND_AUDIO_CLOCK. (1) slot < 256. (2) kind == 0 -> REVOKE_ALREADY. (3) kind != 0x160 -> WRONG_KIND. (4) free row. (5) clear descriptor. Labels prefixed aclk_rvk_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;

        mov r10, 256;
        cmp r12, r10;
        jae aclk_rvk_bad_slot;

        lea rax, [rip + cap_table];
        mov r8, r12;
        shl r8, 3;
        mov r9, r12;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov rbx, rax;

        mov r10, [rbx + 0];
        cmp r10, 0;
        je  aclk_rvk_already;

        mov r11, 0x160;
        cmp r10, r11;
        jne aclk_rvk_wrong_kind;

        mov r13, [rbx + 16];
        mov r10, 0xFFFF;
        and r13, r10;

        mov rdi, r13;
        call audio_clock_tail_valid;
        cmp rax, 0;
        je  aclk_rvk_clear;

        mov rdi, r13;
        call audio_clock_tail_free;

      aclk_rvk_clear:
        mov rdi, r12;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        mov rdi, 6;                      // ST_REVOKES
        call audio_clock_note;

        xor rax, rax;
        jmp aclk_rvk_out;

      aclk_rvk_bad_slot:
        mov rax, 0xFFFFFED5;
        jmp aclk_rvk_out;
      aclk_rvk_wrong_kind:
        mov rax, 0xFFFFFED4;
        jmp aclk_rvk_out;
      aclk_rvk_already:
        mov rax, 0xFFFFFED3;

      aclk_rvk_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let audio_clock_cap_revoke : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R33.M3-003 (#1149): audited revoke.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;

        call audio_clock_cap_revoke_inner;
        mov r14, rax;

        mov rdi, 2;                      // DRV_AUDIT_EV_REVOKE
        mov rsi, 0x160;
        mov rdx, r12;
        mov rcx, r12;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Dispatch handler.
  // ==========================================================================

  pub let cap_handler_audio_clock : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R33.M3-003 (#1149): KIND_AUDIO_CLOCK dispatch. row_id = target_ptr[15:0], slot = target_ptr[31:16]; op = op_arg[7:0]. QUERY_* need INVOKE; DEBUG_PRINT needs OBSERVE; REPORT needs REPORT. Queries take no operand; REPORT packs (new_current_hz[27:8], samples_delta[47:28], reserved[63:48]=0). Labels prefixed aclk_hn_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov r12, rdi;                    // rights
        mov r13, rsi;
        mov r10, 0xFFFF;
        and r13, r10;                    // row_id
        mov rbx, rsi;
        shr rbx, 16;
        and rbx, 0xFF;                   // slot
        mov r14, rdx;                    // op_arg

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_audio_clock_msg];
        call klog_s1;

        mov r10, r14;
        and r10, 0xFF;
        mov rbp, r10;                    // op

        cmp rbp, 6;
        ja  aclk_hn_unsup;

        cmp rbp, 6;
        je  aclk_hn_report_gate;

        cmp rbp, 5;
        je  aclk_hn_dbg;

        mov r11, r14;
        shr r11, 8;
        cmp r11, 0;
        jne aclk_hn_res;

        mov r10, r12;
        and r10, 0x008;
        cmp r10, 0;
        je  aclk_hn_denied;

        mov rdi, r13;
        cmp rbp, 0;
        je  aclk_hn_src;
        cmp rbp, 1;
        je  aclk_hn_nom;
        cmp rbp, 2;
        je  aclk_hn_cur;
        cmp rbp, 3;
        je  aclk_hn_smp;
        call audio_clock_row_parent;
        jmp aclk_hn_out;

      aclk_hn_report_gate:
        // Decode new_current_hz [27:8], samples_delta [47:28],
        // reserved [63:48].
        mov r11, r14;
        shr r11, 48;
        cmp r11, 0;
        jne aclk_hn_res;

        mov r11, r14;
        shr r11, 8;
        mov r10, 0xFFFFF;                // 20 bits
        and r11, r10;
        mov r15, r11;                    // new_current_hz

        mov r11, r14;
        shr r11, 28;
        mov r10, 0xFFFFF;
        and r11, r10;
        mov rbp, r11;                    // samples_delta (reuse rbp)

        mov r10, r12;
        and r10, 0x002;
        cmp r10, 0;
        je  aclk_hn_denied;

        mov rdi, rbx;
        mov rsi, r15;
        mov rdx, rbp;
        call audio_clock_report_install;
        jmp aclk_hn_out;

      aclk_hn_src:
        call audio_clock_row_source;
        jmp aclk_hn_out;
      aclk_hn_nom:
        call audio_clock_row_nominal;
        jmp aclk_hn_out;
      aclk_hn_cur:
        call audio_clock_row_current;
        jmp aclk_hn_out;
      aclk_hn_smp:
        call audio_clock_row_samples;
        jmp aclk_hn_out;

      aclk_hn_dbg:
        mov r11, r14;
        shr r11, 8;
        cmp r11, 0;
        jne aclk_hn_res;
        mov r10, r12;
        and r10, 0x400;
        cmp r10, 0;
        je  aclk_hn_denied;
        xor rax, rax;
        jmp aclk_hn_out;

      aclk_hn_res:
        mov rax, 0xFFFFFEDE;             // TAIL_BAD_ARG
        jmp aclk_hn_out;
      aclk_hn_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;
        jmp aclk_hn_out;
      aclk_hn_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;

      aclk_hn_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
