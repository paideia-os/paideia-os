    }

  pub let usb_urb_timeout_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R34.M3-004 (#1179): timeout_ms. ARITY ONE. Labels prefixed urb_tos_.",
