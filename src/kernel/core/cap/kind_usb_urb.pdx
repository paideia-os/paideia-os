        mov r12, rax;
        cmp r12, 0xFF;
        je  urb_los_bad;
        mov rdi, r12;
        call usb_urb_row_len;
        jmp urb_los_out;
      urb_los_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      urb_los_out:
        pop r14; pop r13; pop r12;
        ret
