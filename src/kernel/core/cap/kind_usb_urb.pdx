// src/kernel/core/cap/kind_usb_urb.pdx — R34.M3-004 (#1179)
//
// KIND_USB_URB = 0x168, derived over KIND_IPC_ENDPOINT (5).
//
// The authority to hold ONE OUTSTANDING USB Request Block — its
// inherited urb_key (a fresh identity supplied by the transfer
// submitter), its direction (IN/OUT), its buffer_len (0..65535
// bytes), and its timeout_ms (0..60000, capped at one minute).
//
// =============================================================================
// §0  WHY THIS KIND EXISTS
// =============================================================================
//
// A URB (USB Request Block) is one queued transfer awaiting
// completion. usb_transfer_channel.submit_urb (R34.M3-004 #1179)
// hands the caller back a URB HANDLE; that handle IS this kind. A
// subsequent cancel_urb / poll_status names the URB by capability,
// not by a caller-supplied id, so a caller cannot poll an URB it
// did not submit.
//
// =============================================================================
// §1  DERIVATION OVER KIND_IPC_ENDPOINT
// =============================================================================
//
// The gate demands `kind == KIND_IPC_ENDPOINT (5)` carrying
// `RIGHT_MINT`. Same empty-kind-half as KIND_FW_SESSION / KIND_HID_
// EVENT / KIND_SENSOR_CHANNEL / KIND_USB_ENDPOINT: every endpoint
// in the system is KIND_IPC_ENDPOINT, so the mint additionally
// requires:
//
//   (a) urb_key non-zero and unique among live rows (NO_KEY / IN_USE)
//   (b) direction in [0, 1] (BAD_DIR)
//   (c) buffer_len <= 65535 (BAD_LEN)
//   (d) timeout_ms <= 60000 (BAD_TIMEOUT)
//   (e) rights subset of R_USB_URB_ALL (BAD_RIGHTS)
//
// =============================================================================
// §2  LEAF OF THE URB LATTICE
// =============================================================================
//
// R_USB_URB_MINT (0x200) IS DELIBERATELY ABSENT from R_USB_URB_ALL:
// nothing derives from a URB cap. A URB is a completion handle, not
// a mint parent. Same discipline KIND_USB_ENDPOINT / KIND_HID_EVENT
// applied for the same reason.
//
// =============================================================================
// §3  FAILURE TAXONOMY 0xFFFFFB60..0xFFFFFB6F
// =============================================================================
//
// R34.M3 softarch chose 0xFFFFFB60..6F, NOT the 0xFFFFFB80..8F the
// task's original suggestion had, because 0xFFFFFB8x collides with
// composite_bind.pdx's live band. Verified disjoint by grep of
// src/kernel/** and tests/kernel/** at R34.M3-004 open.

module KindUsbUrb = structure {

  pub let KIND_USB_URB         : u64 = 0x168
  pub let USB_URB_PARENT_KIND  : u64 = 5        // = KIND_IPC_ENDPOINT

  // §1 bounds.
  pub let USB_URB_DIR_MIN     : u64 = 0
  pub let USB_URB_DIR_MAX     : u64 = 1
  pub let USB_URB_LEN_MAX     : u64 = 65535
  pub let USB_URB_TIMEOUT_MAX : u64 = 60000

  pub let USB_URB_DIR_OUT : u64 = 0
  pub let USB_URB_DIR_IN  : u64 = 1

  // Rights. Leaf: RIGHT_MINT NOT in the mask.
  pub let R_USB_URB_READ    : u64 = 0x001
  pub let R_USB_URB_INVOKE  : u64 = 0x008
  pub let R_USB_URB_REVOKE  : u64 = 0x010
  pub let R_USB_URB_OBSERVE : u64 = 0x400
  pub let R_USB_URB_ALL     : u64 = 0x419

  // Ops:
  pub let URB_OP_QUERY_KEY     : u64 = 0
  pub let URB_OP_QUERY_DIR     : u64 = 1
  pub let URB_OP_QUERY_LEN     : u64 = 2
  pub let URB_OP_QUERY_TIMEOUT : u64 = 3
  pub let URB_OP_QUERY_PARENT  : u64 = 4
  pub let URB_OP_DEBUG_PRINT   : u64 = 5
  pub let URB_OP_MAX           : u64 = 5

  // Failure taxonomy — 0xFFFFFB60..0xFFFFFB6F.
  pub let URB_OK                 : u64 = 0
  pub let URB_TAIL_ENOSPC        : u64 = 0xFFFFFB6F
  pub let URB_TAIL_BAD_ARG       : u64 = 0xFFFFFB6E
  pub let URB_MINT_BAD_PARENT    : u64 = 0xFFFFFB6D
  pub let URB_MINT_BAD_RIGHTS    : u64 = 0xFFFFFB6C
  pub let URB_MINT_BAD_DIR       : u64 = 0xFFFFFB6B
  pub let URB_MINT_BAD_LEN       : u64 = 0xFFFFFB6A
  pub let URB_MINT_BAD_TIMEOUT   : u64 = 0xFFFFFB69
  pub let URB_MINT_NO_KEY        : u64 = 0xFFFFFB68
  pub let URB_MINT_ENOSPC        : u64 = 0xFFFFFB67
  pub let URB_MINT_IN_USE        : u64 = 0xFFFFFB66
  pub let URB_BAD_SLOT           : u64 = 0xFFFFFB65
  pub let URB_WRONG_KIND         : u64 = 0xFFFFFB64
  pub let URB_REVOKE_ALREADY     : u64 = 0xFFFFFB63

  pub let URB_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let URB_ROW_NONE   : u64 = 0xFF

  // 16 rows, 32-byte stride.
  //   [+0]  header (in_use[63:56] | parent_slot[15:8])
  //   [+8]  urb_key
  //   [+16] body: direction[7:0] | buffer_len[23:8] | timeout_ms[39:24]
  //   [+24] reserved
  pub let URB_MAX       : u64 = 16
  pub let URB_ROW_BYTES : u64 = 32

  pub let mut _usb_urb_table : [u64; 64] = uninit @align(64)
  pub let mut _usb_urb_stats : [u64; 4]  = uninit @align(64)

  pub let URB_ST_MINTS   : u64 = 0
  pub let URB_ST_REVOKES : u64 = 1
  pub let URB_ST_IN_USE  : u64 = 2
  pub let URB_ST_ENOSPC  : u64 = 3

  pub let urb_dbg_msg : [u8; 9] = "URB ROW\n\0"

  // ==========================================================================
  // Table reset.
  // ==========================================================================

  pub let usb_urb_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M3-004 (#1179): clear the URB row table and its counters. Labels prefixed urb_rs_.",
      block: {
        lea r10, [rip + _usb_urb_table];
        xor rax, rax;
        xor rcx, rcx;
      urb_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 64;
        jb  urb_rs_rows;

        lea r10, [rip + _usb_urb_stats];
        xor rcx, rcx;
      urb_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  urb_rs_stats;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let usb_urb_dir_valid : (u64) -> u64 !{} @{} =
    fn (d: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M3-004 (#1179): 1 iff d <= 1. Labels prefixed urb_dv_.",
      block: {
        cmp rdi, 1;
        ja  urb_dv_no;
        mov rax, 1;
        ret;
      urb_dv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let usb_urb_len_valid : (u64) -> u64 !{} @{} =
    fn (l: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M3-004 (#1179): 1 iff l <= 65535. Labels prefixed urb_lv_.",
      block: {
        cmp rdi, 65535;
        ja  urb_lv_no;
        mov rax, 1;
        ret;
      urb_lv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let usb_urb_timeout_valid : (u64) -> u64 !{} @{} =
    fn (t: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M3-004 (#1179): 1 iff t <= 60000. Labels prefixed urb_tv_.",
      block: {
        cmp rdi, 60000;
        ja  urb_tv_no;
        mov rax, 1;
        ret;
      urb_tv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let usb_urb_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M3-004 (#1179): subset test against R_USB_URB_ALL. Labels prefixed urb_rv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x419;
        and rax, r10;
        cmp rax, rdi;
        jne urb_rv_no;
        mov rax, 1;
        ret;
      urb_rv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Counters.
  // ==========================================================================

  pub let usb_urb_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M3-004 (#1179): counter bump. Labels prefixed urb_nt_.",
      block: {
        cmp rdi, 4;
        jae urb_nt_out;
        lea r10, [rip + _usb_urb_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      urb_nt_out:
        ret
      }
    } @no_frame

  pub let usb_urb_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M3-004 (#1179): counter read. Labels prefixed urb_st_.",
      block: {
        cmp rdi, 4;
        jae urb_st_zero;
        lea r10, [rip + _usb_urb_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      urb_st_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Parent gate: KIND_IPC_ENDPOINT + RIGHT_MINT.
  // ==========================================================================

  pub let usb_urb_check_parent : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R34.M3-004 (#1179): parent must be live KIND_IPC_ENDPOINT (5) with RIGHT_MINT. Labels prefixed urb_cp_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae urb_cp_no;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 5;
        jne urb_cp_no;

        mov r10, [rax + 8];
        mov r11, 0x200;
        and r10, r11;
        cmp r10, 0;
        je  urb_cp_no;

        mov rax, 1;
        ret;
      urb_cp_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Header pack.
  // ==========================================================================

  pub let usb_urb_hdr_pack : (u64) -> u64 !{} @{} =
    fn (parent_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M3-004 (#1179): (parent_slot << 8). Labels prefixed urb_hp_.",
      block: {
        mov r10, 256;
        cmp rdi, r10;
        jae urb_hp_bad;
        mov rax, rdi;
        shl rax, 8;
        ret;
      urb_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  pub let usb_urb_body_pack : (u64, u64, u64) -> u64 !{} @{} =
    fn (direction: u64) (buffer_len: u64) (timeout_ms: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R34.M3-004 (#1179): pack dir[7:0] | len[23:8] | timeout[39:24]. Refuses out-of-range. Labels prefixed urb_bp_.",
      block: {
        cmp rdi, 1;
        ja  urb_bp_bad;
        cmp rsi, 65535;
        ja  urb_bp_bad;
        cmp rdx, 60000;
        ja  urb_bp_bad;

        mov rax, rdi;
        and rax, 0xFF;
        mov r10, rsi;
        and r10, 0xFFFF;
        shl r10, 8;
        or  rax, r10;
        mov r10, rdx;
        and r10, 0xFFFF;
        shl r10, 24;
        or  rax, r10;
        ret;
      urb_bp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  // ==========================================================================
  // Tail alloc/valid/free.
  // ==========================================================================

  pub let usb_urb_tail_alloc : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (urb_key: u64) (body_packed: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M3-004 (#1179): claim one URB row. THE ONE WRITER of _usb_urb_table. Labels prefixed urb_ta_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;

        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne urb_ta_bad;

        cmp r13, 0;
        je  urb_ta_bad;

        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp r14, r10;
        je  urb_ta_bad;

        xor rbx, rbx;
      urb_ta_scan:
        cmp rbx, 16;
        jae urb_ta_enospc;

        lea r10, [rip + _usb_urb_table];
        mov r11, rbx;
        shl r11, 5;
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  urb_ta_claim;

        add rbx, 1;
        jmp urb_ta_scan;

      urb_ta_claim:
        mov rax, r12;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r13;
        mov [r10 + 16], r14;
        xor rax, rax;
        mov [r10 + 24], rax;
        mov rax, rbx;
        jmp urb_ta_out;

      urb_ta_enospc:
        mov rax, 0xFFFFFB6F;
        jmp urb_ta_out;
      urb_ta_bad:
        mov rax, 0xFFFFFB6E;

      urb_ta_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let usb_urb_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M3-004 (#1179): 1 iff row_id < MAX and in_use. Labels prefixed urb_tvr_.",
      block: {
        cmp rdi, 16;
        jae urb_tvr_no;
        lea r10, [rip + _usb_urb_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  urb_tvr_no;
        mov rax, 1;
        ret;
      urb_tvr_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let usb_urb_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M3-004 (#1179): scrub one row. Labels prefixed urb_tf_.",
      block: {
        cmp rdi, 16;
        jae urb_tf_out;
        lea r10, [rip + _usb_urb_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
      urb_tf_out:
        ret
      }
    } @no_frame

  // ==========================================================================
  // Row accessors.
  // ==========================================================================

  pub let usb_urb_row_key : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M3-004 (#1179): urb_key. Labels prefixed urb_rk_.",
      block: {
        push r12; push r13; push r14;
        mov r12, rdi;
        call usb_urb_tail_valid;
        cmp rax, 0;
        je  urb_rk_bad;
        lea r10, [rip + _usb_urb_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 8];
        jmp urb_rk_out;
      urb_rk_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      urb_rk_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  pub let usb_urb_row_dir : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M3-004 (#1179): direction. Labels prefixed urb_rd_.",
      block: {
        push r12; push r13; push r14;
        mov r12, rdi;
        call usb_urb_tail_valid;
        cmp rax, 0;
        je  urb_rd_bad;
        lea r10, [rip + _usb_urb_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        and rax, 0xFF;
        jmp urb_rd_out;
      urb_rd_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      urb_rd_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  pub let usb_urb_row_len : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M3-004 (#1179): buffer_len. Labels prefixed urb_rl_.",
      block: {
        push r12; push r13; push r14;
        mov r12, rdi;
        call usb_urb_tail_valid;
        cmp rax, 0;
        je  urb_rl_bad;
        lea r10, [rip + _usb_urb_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 8;
        and rax, 0xFFFF;
        jmp urb_rl_out;
      urb_rl_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      urb_rl_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  pub let usb_urb_row_timeout : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M3-004 (#1179): timeout_ms. Labels prefixed urb_rt_.",
      block: {
        push r12; push r13; push r14;
        mov r12, rdi;
        call usb_urb_tail_valid;
        cmp rax, 0;
        je  urb_rt_bad;
        lea r10, [rip + _usb_urb_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 24;
        and rax, 0xFFFF;
        jmp urb_rt_out;
      urb_rt_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      urb_rt_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  pub let usb_urb_row_parent : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M3-004 (#1179): parent slot. Labels prefixed urb_rp_.",
      block: {
        push r12; push r13; push r14;
        mov r12, rdi;
        call usb_urb_tail_valid;
        cmp rax, 0;
        je  urb_rp_bad;
        lea r10, [rip + _usb_urb_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 8;
        and rax, 0xFF;
        jmp urb_rp_out;
      urb_rp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      urb_rp_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  // ==========================================================================
  // Lookups.
  // ==========================================================================

  pub let usb_urb_find_by_key : (u64) -> u64 !{mem} @{} =
    fn (urb_key: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R34.M3-004 (#1179): live row holding this urb_key, or ROW_NONE. Labels prefixed urb_fk_.",
      block: {
        cmp rdi, 0;
        je  urb_fk_none;
        xor rcx, rcx;
      urb_fk_scan:
        cmp rcx, 16;
        jae urb_fk_none;
        lea r10, [rip + _usb_urb_table];
        mov r11, rcx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  urb_fk_next;
        mov rax, [r10 + 8];
        cmp rax, rdi;
        je  urb_fk_hit;
      urb_fk_next:
        add rcx, 1;
        jmp urb_fk_scan;
      urb_fk_hit:
        mov rax, rcx;
        ret;
      urb_fk_none:
        mov rax, 0xFF;
        ret
      }
    } @no_frame

  pub let usb_urb_row_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R34.M3-004 (#1179): slot -> row_id, gated on live KIND_USB_URB. Labels prefixed urb_ros_.",
      block: {
        push r12; push r13; push r14;

        mov r11, 256;
        cmp rdi, r11;
        jae urb_ros_none;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x168;
        cmp r10, r11;
        jne urb_ros_none;

        mov r12, [rax + 16];
        mov r10, 0xFFFF;
        and r12, r10;

        mov rdi, r12;
        call usb_urb_tail_valid;
        cmp rax, 0;
        je  urb_ros_none;

        mov rax, r12;
        jmp urb_ros_out;

      urb_ros_none:
        mov rax, 0xFF;
      urb_ros_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  pub let usb_urb_key_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R34.M3-004 (#1179): urb_key. ARITY ONE. Labels prefixed urb_kos_.",
      block: {
        push r12; push r13; push r14;
        call usb_urb_row_of_slot;
        mov r12, rax;
        cmp r12, 0xFF;
        je  urb_kos_bad;
        mov rdi, r12;
        call usb_urb_row_key;
        jmp urb_kos_out;
      urb_kos_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      urb_kos_out:
        pop r14; pop r13; pop r12;
        ret
      }
    }

  pub let usb_urb_dir_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R34.M3-004 (#1179): direction. ARITY ONE. Labels prefixed urb_dos_.",
      block: {
        push r12; push r13; push r14;
        call usb_urb_row_of_slot;
        mov r12, rax;
        cmp r12, 0xFF;
        je  urb_dos_bad;
        mov rdi, r12;
        call usb_urb_row_dir;
        jmp urb_dos_out;
      urb_dos_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      urb_dos_out:
        pop r14; pop r13; pop r12;
        ret
