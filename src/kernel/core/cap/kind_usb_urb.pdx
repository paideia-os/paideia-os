  // ==========================================================================
  // Mint. Six args (slot, parent_slot, rights, urb_key, packed_body,
  // reserved-zero). packed_body = dir[7:0] | len[23:8] | timeout[39:24].
  // The sixth arg is currently reserved (must be zero) so that when R34.M4
  // extends the row with e.g. a completion_ptr it does not resize the ABI.
  // ==========================================================================

  pub let usb_urb_cap_mint_inner : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (urb_key: u64) (packed_body: u64) (reserved: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R34.M3-004 (#1179): mint KIND_USB_URB over KIND_IPC_ENDPOINT. Six args (slot, parent, rights, urb_key, packed_body, reserved). Sequence: slot<256; check_parent; rights_valid; unpack dir/len/timeout; validate each; urb_key non-zero (NO_KEY); uniqueness (IN_USE); reserved must be zero (else BAD_ARG); hdr_pack; body_pack; tail_alloc; cap_mint_write. Labels prefixed urb_mi_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov rbx, rdi;                    // slot
        mov r12, rsi;                    // parent_slot
        mov r13, rdx;                    // rights
        mov r14, rcx;                    // urb_key
        mov r15, r8;                     // packed_body
        mov rbp, r9;                     // reserved

        cmp rbp, 0;
        jne urb_mi_bad_arg;

        mov r10, 256;
        cmp rbx, r10;
        jae urb_mi_bad_slot;

        mov rdi, r12;
        call usb_urb_check_parent;
        cmp rax, 0;
        je  urb_mi_bad_parent;

        mov rdi, r13;
        call usb_urb_rights_valid;
        cmp rax, 0;
        je  urb_mi_bad_rights;

        mov rdi, r15;
        and rdi, 0xFF;                   // dir
        call usb_urb_dir_valid;
        cmp rax, 0;
        je  urb_mi_bad_dir;

        mov rdi, r15;
        shr rdi, 8;
        and rdi, 0xFFFF;                 // len
        call usb_urb_len_valid;
        cmp rax, 0;
        je  urb_mi_bad_len;

        mov rdi, r15;
        shr rdi, 24;
        and rdi, 0xFFFF;                 // timeout
        call usb_urb_timeout_valid;
        cmp rax, 0;
        je  urb_mi_bad_timeout;

        cmp r14, 0;
        je  urb_mi_no_key;

        mov rdi, r14;
        call usb_urb_find_by_key;
        cmp rax, 0xFF;
        jne urb_mi_in_use;

        mov rdi, r15;
        and rdi, 0xFF;
        mov rsi, r15;
        shr rsi, 8;
        and rsi, 0xFFFF;
        mov rdx, r15;
        shr rdx, 24;
        and rdx, 0xFFFF;
        call usb_urb_body_pack;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  urb_mi_bad_dir;
        push rax;
        sub rsp, 8;

        mov rdi, r12;
        call usb_urb_hdr_pack;
        add rsp, 8;
        pop r10;                         // body
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  urb_mi_bad_parent;

        mov rdi, rax;                    // hdr
        mov rsi, r14;                    // urb_key
        mov rdx, r10;                    // body
        call usb_urb_tail_alloc;

        mov r10, 0xFFFFFB6F;
        cmp rax, r10;
        je  urb_mi_enospc;
        mov r10, 0xFFFFFB6E;
        cmp rax, r10;
        je  urb_mi_bad_dir;

        mov r15, rax;                    // row_id
        mov r11, rbx;
        shl r11, 16;
        or  r15, r11;

        mov rdi, rbx;
        mov rsi, 0x168;
        mov rdx, r13;
        mov rcx, r15;
        call cap_mint_write;

        mov rdi, 0;
        call usb_urb_note;

        xor rax, rax;
        jmp urb_mi_out;

      urb_mi_bad_slot:
        mov rax, 0xFFFFFB65;
        jmp urb_mi_out;
      urb_mi_bad_arg:
        mov rax, 0xFFFFFB6E;
        jmp urb_mi_out;
      urb_mi_bad_parent:
        mov rax, 0xFFFFFB6D;
        jmp urb_mi_out;
      urb_mi_bad_rights:
        mov rax, 0xFFFFFB6C;
        jmp urb_mi_out;
      urb_mi_bad_dir:
        mov rax, 0xFFFFFB6B;
        jmp urb_mi_out;
      urb_mi_bad_len:
        mov rax, 0xFFFFFB6A;
        jmp urb_mi_out;
      urb_mi_bad_timeout:
        mov rax, 0xFFFFFB69;
        jmp urb_mi_out;
      urb_mi_no_key:
        mov rax, 0xFFFFFB68;
        jmp urb_mi_out;
      urb_mi_in_use:
        mov rdi, 2;
        call usb_urb_note;
        mov rax, 0xFFFFFB66;
        jmp urb_mi_out;
      urb_mi_enospc:
        mov rdi, 3;
        call usb_urb_note;
        mov rax, 0xFFFFFB67;

      urb_mi_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let usb_urb_cap_mint : (u64, u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (urb_key: u64) (packed_body: u64) (reserved: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R34.M3-004 (#1179): audited mint.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;
        mov r13, rsi;

        call usb_urb_cap_mint_inner;
        mov r14, rax;

        mov rdi, 1;
        mov rsi, 0x168;
        mov rdx, r12;
        mov rcx, r13;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Revoke.
  // ==========================================================================

  pub let usb_urb_cap_revoke_inner : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R34.M3-004 (#1179): revoke a KIND_USB_URB. Labels prefixed urb_rvk_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;

        mov r10, 256;
        cmp r12, r10;
        jae urb_rvk_bad_slot;

        mov rax, cap_table;
        mov r8, r12;
        shl r8, 3;
        mov r9, r12;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov rbx, rax;

        mov r10, [rbx + 0];
        cmp r10, 0;
        je  urb_rvk_already;

        mov r11, 0x168;
        cmp r10, r11;
        jne urb_rvk_wrong_kind;

        mov r13, [rbx + 16];
        mov r10, 0xFFFF;
        and r13, r10;

        mov rdi, r13;
        call usb_urb_tail_valid;
        cmp rax, 0;
        je  urb_rvk_clear;

        mov rdi, r13;
        call usb_urb_tail_free;

      urb_rvk_clear:
        mov rdi, r12;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        mov rdi, 1;
        call usb_urb_note;

        xor rax, rax;
        jmp urb_rvk_out;

      urb_rvk_bad_slot:
        mov rax, 0xFFFFFB65;
        jmp urb_rvk_out;
      urb_rvk_wrong_kind:
        mov rax, 0xFFFFFB64;
        jmp urb_rvk_out;
      urb_rvk_already:
        mov rax, 0xFFFFFB63;

      urb_rvk_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let usb_urb_cap_revoke : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R34.M3-004 (#1179): audited revoke.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;

        call usb_urb_cap_revoke_inner;
        mov r14, rax;

        mov rdi, 2;
        mov rsi, 0x168;
        mov rdx, r12;
        mov rcx, r12;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Dispatch.
  // ==========================================================================

  pub let cap_handler_usb_urb : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R34.M3-004 (#1179): KIND_USB_URB dispatch handler. Queries INVOKE; DEBUG OBSERVE. Arity ONE; op_arg[63:8] REFUSED. Labels prefixed urb_hn_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov r12, rdi;
        mov r13, rsi;
        mov r10, 0xFFFF;
        and r13, r10;
        mov r14, rdx;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_usb_urb_msg];
        call klog_s1;

        mov r10, r14;
        and r10, 0xFF;
        mov rbp, r10;
        mov r11, r14;
        shr r11, 8;
        cmp r11, 0;
        jne urb_hn_res;

        cmp rbp, 5;
        ja  urb_hn_unsup;

        cmp rbp, 5;
        je  urb_hn_dbg;

        mov r10, r12;
        and r10, 0x008;
        cmp r10, 0;
        je  urb_hn_denied;

        mov rdi, r13;
        cmp rbp, 0;
        je  urb_hn_key;
        cmp rbp, 1;
        je  urb_hn_dir;
        cmp rbp, 2;
        je  urb_hn_len;
        cmp rbp, 3;
        je  urb_hn_to;
        call usb_urb_row_parent;
        jmp urb_hn_out;

      urb_hn_key:
        call usb_urb_row_key;
        jmp urb_hn_out;
      urb_hn_dir:
        call usb_urb_row_dir;
        jmp urb_hn_out;
      urb_hn_len:
        call usb_urb_row_len;
        jmp urb_hn_out;
      urb_hn_to:
        call usb_urb_row_timeout;
        jmp urb_hn_out;

      urb_hn_dbg:
        mov r10, r12;
        and r10, 0x400;
        cmp r10, 0;
        je  urb_hn_denied;
        xor rax, rax;
        jmp urb_hn_out;

      urb_hn_res:
        mov rax, 0xFFFFFB6E;
        jmp urb_hn_out;
      urb_hn_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;
        jmp urb_hn_out;
      urb_hn_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;

      urb_hn_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
