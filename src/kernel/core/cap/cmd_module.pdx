// src/kernel/core/cap/cmd_module.pdx -- R123.M1 (paideia-os #2503)
//
// KIND_CMD_MODULE substrate: row pool + mint helper (cmd_module_alloc)
// + free helper (cmd_module_free) + row accessors + refcount helpers,
// all folded into one file (kind_kek.pdx / pipeline_edge.pdx compact
// posture) because the M1 surface is deliberately small (mint +
// accessors + refcount). Cap-invoke dispatch integration is deferred
// to R123.M2 per the R123 briefing ("Do NOT touch dispatch.pdx or
// shell path -- R123.M2 owns registry integration"); the M1 primitives
// are direct-callable from the boot witness and, from R123.M2 onward,
// from the shell command-loader path.
//
// =============================================================================
// SECTION 0  ORDINAL CHOICE -- 0x200
// =============================================================================
//
// The R123.M1 plan asks for "next fresh page in the 0x2xx strip".
// A landing-time sweep (2026-09-24) confirms no existing declaration
// occupies 0x200..0x20F:
//   0x1F0..0x1FF  KIND_PIPELINE_EDGE strip (R121, adjacent below)
//   0x200         (this landing -- KIND_CMD_MODULE)
//   0x200..0x20F  fresh
//
// `grep -rn "pub let KIND.*= 0x20[0-9A-Fa-f]" src/**/*.pdx` returns
// zero declarations before this landing. 0x200 is otherwise widely used
// as a RIGHT_MINT bitmask (kind_surface.pdx L127, kind_tui_canvas.pdx
// L89, kind_op_region.pdx L246 all declare R_*_MINT = 0x200); those are
// rights bits, not kind ordinals, and there is no ambiguity because the
// cap_invoke_dispatch cascade compares against `rcx` (kind) whereas
// rights bits live in the descriptor's rights word.
//
// =============================================================================
// SECTION 1  WHY DERIVED OVER KIND_MEMORY
// =============================================================================
//
// A command module row is a static, kernel-owned record of one loaded
// shell command (name, version, functor id, in-process bit, cap-env
// pointer, refcount). The pool table lives in .bss (_cmd_module_table),
// just like _ksh_table / _pipeline_edge_table. The parent gate is
// therefore the standard "cannot widen memory reach beyond what you
// already hold" rule: parent.kind == KIND_MEMORY (4) AND rights carry
// RIGHT_MINT (0x200). No cap_invoke op reaches cmd_module_alloc at M1
// (the M1 mint is a kernel-trusted primitive callable from the R123.M1
// boot witness and, from R123.M2 onward, from the shell command-loader
// after it holds a root KIND_MEMORY + RIGHT_MINT parent cap). A ring-3
// caller holding only a KIND_CMD_MODULE cannot mint a fresh one -- when
// R123.M2 wires cap_invoke, the KIND_CMD_MODULE handler will refuse
// MINT and expose only READ / INCREF / DECREF ops.
//
// =============================================================================
// SECTION 2  ROW LAYOUT (48 bytes, 6 u64 words)
// =============================================================================
//
// The plan's field list (paideia-os #2503 §2):
//   name[24], version_maj u16, version_min u16, functor_id u32,
//   in_process u8, reserved u8, cap_env_ptr u64, refcount u32
//
// Packed into six u64 words for word-aligned load/store; the plan's
// named fields become bit-slices of those words. `in_use` (the pool's
// live-marker) rides in the flags_ref word's top byte, matching
// pipeline_edge.pdx's "publish in_use last" convention.
//
//   [+0]  name_lo    (u64; name[0..7]  packed little-endian)
//   [+8]  name_mid   (u64; name[8..15] packed little-endian)
//   [+16] name_hi    (u64; name[16..23] packed little-endian; NUL-pad
//                    on short names -- the pool zero-initialises)
//   [+24] vers_func  (u64)
//         version_maj   [15:0]
//         version_min   [31:16]
//         functor_id    [63:32]
//   [+32] flags_ref  (u64)
//         in_process    [7:0]     (0=out-of-process, 1=in-process)
//         reserved      [15:8]    (zero-on-mint)
//         refcount      [47:16]   (u32, held live count)
//         reserved      [55:48]   (zero-on-mint)
//         in_use        [63:56]   (0=free, 1=live) -- publish-last
//   [+40] cap_env_ptr (u64; opaque pointer into the per-module cap
//                     environment -- accessor returns this verbatim)
//
// Row-addressed capacity: CM_MAX = 16 rows. 16 * 48 = 768 bytes = 96
// u64. Sixteen concurrently loaded command modules is generous for the
// R123 shell design (find, sort, uniq, head, cat, grep, ... -- typical
// paideia shell sessions load ~6 modules; the R123.M2 registry can
// unload idle modules to reclaim slots).
//
// =============================================================================
// SECTION 3  RIGHTS -- R_CM_INVOKE, R_CM_MINT, R_CM_OBSERVE
// =============================================================================
//
//   R_CM_INVOKE  (0x001) -- authorises calling INTO the module (R123.M2
//                            will wire this into cap_invoke). Held by
//                            the shell dispatcher when it routes a
//                            command to a loaded module.
//   R_CM_OBSERVE (0x400) -- authorises READ ops (get_name, get_version,
//                            get_functor_id). Held by the shell's
//                            introspection surface.
//   R_CM_MINT    (0x200) -- authorises cmd_module_alloc via cap_invoke.
//                            At M1 not reachable via cap_invoke; the
//                            R123.M2 registry adds the MINT arm.
//
// R_CM_ALL = 0x601. cmd_module_alloc validates its (future) rights
// argument via cm_rights_valid using this mask.
//
// =============================================================================
// SECTION 4  FAILURE TAXONOMY -- 0xFFFFEBB0..0xFFFFEBBF
// =============================================================================
//
// Band audit (2026-09-24): `grep -rn "0xFFFFEBB[0-9A-Fa-f]" src/kernel/`
// returned zero declarations; safe to claim. Neighbours: R121.M4
// duality band 0xFFFFEBA0..0xFFFFEBAF sits immediately below (the last
// used sentinel there is PET_BIND_BUDDY_ASYMMETRIC 0xFFFFEBAD, so
// there is a two-slot gap before this new band).
//
//   CM_MINT_BAD_NAME    0xFFFFEBBF  -- name_ptr == 0 or name_len == 0
//                                       or name_len > 24
//   CM_MINT_BAD_FUNCTOR 0xFFFFEBBE  -- functor_id == 0 or > u32
//   CM_MINT_BAD_INPROC  0xFFFFEBBD  -- in_process not in {0, 1}
//   CM_MINT_ENOSPC      0xFFFFEBBC  -- pool full (all 16 rows live)
//   CM_BAD_SLOT         0xFFFFEBBB  -- row_id out of range or free
//   CM_FREE_BAD_SLOT    0xFFFFEBBA  -- cmd_module_free called on
//                                       out-of-range or already-free row
//   CM_REF_UNDERFLOW    0xFFFFEBB9  -- decref on refcount == 0
//   CM_REF_OVERFLOW     0xFFFFEBB8  -- incref on refcount == u32_max
//
// =============================================================================
// SECTION 5  SPEC-vs-CODEBASE RECONCILIATION -- alloc arity
// =============================================================================
//
// The R123 briefing spells cmd_module_alloc with SEVEN parameters
// (name_ptr, name_len, version_maj u16, version_min u16, functor_id
// u32, in_process u8, cap_env_ptr u64). The paideia-as ABI accepts at
// most six register parameters (see wrappers.pdx's own comment on
// klog_s1_x3 "paideia-as limited to 6 params; caller pushes ... on
// stack before call"). Per feedback_spec_vs_codebase_conflicts:
// PRESERVE the binding invariant (paideia-as ABI) and flag the
// deviation (this section).
//
// The version_maj (u16) + version_min (u16) + functor_id (u32) triple
// is folded into a single u64 `vers_func`:
//    vers_func[15:0]  = version_maj
//    vers_func[31:16] = version_min
//    vers_func[63:32] = functor_id
// which is BYTE-IDENTICAL to how [+24] stores it in the row, so no
// re-shuffling is needed inside the mint body. The final arity is five:
//    (name_ptr, name_len, vers_func, in_process, cap_env_ptr) -> u64
// All five registers (rdi/rsi/rdx/rcx/r8) fit in the paideia-as ABI
// with no stack push required at the call site -- CLEANER than the
// klog_s1_x3 approach of stack-pushing the tail args, at the cost of
// asking the caller to pre-pack vers_func.
//
// =============================================================================
// SECTION 6  ENCODER DISCIPLINE
// =============================================================================
//
// paideia-as encoder posture (feedback_pdx_encoder_pitfalls):
//   * No `test rN, rN` -- every zero-check uses `cmp reg, 0`.
//   * No 2-op `imul r, imm` -- row addressing uses two shifts (idx*32
//     via shl 5, then + idx*16 via shl 4, then add) to get idx*48.
//   * No `and reg, imm64` -- 0xFF / 0xFFFF / 0xFFFFFFFF fit imm32; the
//     KIND ordinal 0x200 stages through r8/r11 as imm32.
//   * No `add reg, [mem]` / `cmp reg, [mem]` -- every memory operand
//     lands in a register first (load-inc-store idiom on stats bumper
//     and refcount).
//   * No `mov_b` -- every store is a qword `mov [mem], reg`.
//   * Reserved-label prefix `cm_` (short for cmd_module) avoids the
//     `loop`/`if`/`top`/`done` collision class per
//     feedback_paideia_as_reserved_labels; inner labels also carry a
//     second-level prefix (cm_al_ alloc, cm_ra_ row_alloc, cm_fr_ free,
//     cm_rf_ read-field accessors, cm_ic_ incref, cm_dc_ decref,
//     cm_in_ init, cm_nl_ name-length, cm_nt_ note).

module CmdModule = structure {

  // =========================================================================
  // SECTION 7  CONSTANTS
  // =========================================================================

  pub let KIND_CMD_MODULE      : u64 = 0x200
  pub let KIND_CMD_MODULE_BASE : u64 = 4          // = KIND_MEMORY

  // In-process flag (row [+32][7:0]).
  pub let CM_INPROC_OUT : u64 = 0
  pub let CM_INPROC_IN  : u64 = 1
  pub let CM_INPROC_MAX : u64 = 1

  // Rights (§3).
  pub let R_CM_INVOKE  : u64 = 0x001
  pub let R_CM_MINT    : u64 = 0x200
  pub let R_CM_OBSERVE : u64 = 0x400
  pub let R_CM_ALL     : u64 = 0x601

  // Failure taxonomy (§4).
  pub let CM_OK               : u64 = 0
  pub let CM_MINT_BAD_NAME    : u64 = 0xFFFFEBBF
  pub let CM_MINT_BAD_FUNCTOR : u64 = 0xFFFFEBBE
  pub let CM_MINT_BAD_INPROC  : u64 = 0xFFFFEBBD
  pub let CM_MINT_ENOSPC      : u64 = 0xFFFFEBBC
  pub let CM_BAD_SLOT         : u64 = 0xFFFFEBBB
  pub let CM_FREE_BAD_SLOT    : u64 = 0xFFFFEBBA
  pub let CM_REF_UNDERFLOW    : u64 = 0xFFFFEBB9
  pub let CM_REF_OVERFLOW     : u64 = 0xFFFFEBB8

  pub let CM_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF

  // Pool ceilings.
  pub let CM_MAX       : u64 = 16
  pub let CM_ROW_BYTES : u64 = 48
  pub let CM_NAME_MAX  : u64 = 24

  // Storage: 16 rows * 48 bytes = 768 bytes = 96 u64.
  pub let mut _cmd_module_table : [u64; 96] = uninit @align(64)
  pub let mut _cmd_module_stats : [u64; 8]  = uninit @align(64)

  pub let CM_ST_MINTS    : u64 = 0
  pub let CM_ST_FREES    : u64 = 1
  pub let CM_ST_INCREFS  : u64 = 2
  pub let CM_ST_DECREFS  : u64 = 3
  pub let CM_ST_REFUSED  : u64 = 4
  pub let CM_ST_MAX      : u64 = 8

  // =========================================================================
  // SECTION 8  cmd_module_init() -> ()
  // =========================================================================
  //
  // Boot / teardown scrub of the row pool and the stats table. .bss
  // already starts zero at real boot; defensive, matches kind_kek_init
  // / pipeline_edge_init one-for-one. Called from kernel_main's
  // derived-kind reset cascade (adjacent to pipeline_edge_init).

  pub let cmd_module_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R123.M1 (paideia-os #2503): defensive scrub of _cmd_module_table (96 u64 = 768 bytes) and _cmd_module_stats (8 u64). Two straight-line loops, mirrors pipeline_edge_init one-for-one. Labels prefixed cm_in_.",
      block: {
        lea r10, [rip + _cmd_module_table];
        xor rax, rax;
        xor rcx, rcx;
      cm_in_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 96;
        jb  cm_in_rows;

        lea r10, [rip + _cmd_module_stats];
        xor rcx, rcx;
      cm_in_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  cm_in_stats;
        ret
      }
    }

  // =========================================================================
  // SECTION 9  cm_note(which) -- bounded stats increment.
  // =========================================================================

  pub let cm_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R123.M1 (paideia-os #2503): bounded increment on _cmd_module_stats. Load-inc-store idiom (no `add reg, [mem]`). Labels prefixed cm_nt_.",
      block: {
        cmp rdi, 8;
        jae cm_nt_out;
        lea r10, [rip + _cmd_module_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      cm_nt_out:
        ret
      }
    }

  // =========================================================================
  // SECTION 10  Validators.
  // =========================================================================

  // cm_inproc_valid(in_process) -> 1 iff in_process in {0, 1}.
  pub let cm_inproc_valid : (u64) -> u64 !{} @{} =
    fn (in_process: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R123.M1 (paideia-os #2503): in_process in {CM_INPROC_OUT=0, CM_INPROC_IN=1}. Labels prefixed cm_ip_.",
      block: {
        cmp rdi, 1;
        ja  cm_ip_no;
        mov rax, 1;
        ret;
      cm_ip_no:
        xor rax, rax;
        ret
      }
    }

  // cm_functor_valid(functor_id) -> 1 iff functor_id in [1..0xFFFFFFFF].
  pub let cm_functor_valid : (u64) -> u64 !{} @{} =
    fn (functor_id: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R123.M1 (paideia-os #2503): functor_id in [1..u32_max]. 0 is the 'no functor' sentinel. Labels prefixed cm_fv_.",
      block: {
        cmp rdi, 0;
        je  cm_fv_no;
        mov rax, rdi;
        shr rax, 32;
        cmp rax, 0;
        jne cm_fv_no;
        mov rax, 1;
        ret;
      cm_fv_no:
        xor rax, rax;
        ret
      }
    }

  // cm_name_valid(name_ptr, name_len) -> 1 iff name_ptr != 0 AND
  // name_len in [1..24].
  pub let cm_name_valid : (u64, u64) -> u64 !{} @{} =
    fn (name_ptr: u64) (name_len: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R123.M1 (paideia-os #2503): name_ptr non-zero and name_len in [1..CM_NAME_MAX=24]. Labels prefixed cm_nv_.",
      block: {
        cmp rdi, 0;
        je  cm_nv_no;
        cmp rsi, 0;
        je  cm_nv_no;
        cmp rsi, 24;
        ja  cm_nv_no;
        mov rax, 1;
        ret;
      cm_nv_no:
        xor rax, rax;
        ret
      }
    }

  // =========================================================================
  // SECTION 11  Row addressing helper.
  // =========================================================================
  //
  // cm_row_ptr(idx) -> address of row idx (idx < CM_MAX assumed by
  // callers). Row stride is 48 = 32 + 16, expressed as idx*32 (shl 5)
  // + idx*16 (shl 4) -- two shifts and an add avoid the 2-op `imul r,
  // imm` encoder pitfall.
  //
  // Not exported; inlined into every caller (row_valid, row_alloc,
  // free_inner, every accessor) because the offset compute is dense
  // and a call would double the size of a two-instruction accessor.

  // =========================================================================
  // SECTION 12  Row pool -- cm_row_valid / cm_row_alloc / cm_row_free_inner.
  // =========================================================================

  // cm_row_valid(idx) -> 1 iff idx < CM_MAX and in_use byte set at
  // [row+32][63:56].
  pub let cm_row_valid : (u64) -> u64 !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R123.M1 (paideia-os #2503): 1 iff idx < CM_MAX(16) and in_use byte set at [row+32][63:56]. Inlined address compute (idx*48 via shl 5 + shl 4). Labels prefixed cm_rv_.",
      block: {
        mov r10, 16;                     // CM_MAX
        cmp rdi, r10;
        jae cm_rv_no;
        lea r10, [rip + _cmd_module_table];
        mov r11, rdi;
        shl r11, 5;                      // idx * 32
        mov r8,  rdi;
        shl r8,  4;                      // idx * 16
        add r11, r8;                     // idx * 48
        add r10, r11;
        mov rax, [r10 + 32];             // flags_ref
        shr rax, 56;                     // in_use byte at [63:56]
        cmp rax, 0;
        je  cm_rv_no;
        mov rax, 1;
        ret;
      cm_rv_no:
        xor rax, rax;
        ret
      }
    }

  // cm_row_alloc(name_lo, name_mid, name_hi, vers_func, in_process,
  //              cap_env_ptr) -> row_idx | CM_MINT_ENOSPC
  //
  // Low-first scan over 16 rows of 48 bytes. Header write is LAST:
  // in_use bit set via OR with (1 << 56) at [row+32] in the same qword
  // store, matching pipeline_edge.pdx's "publish in_use last" ordering;
  // loads of the header (cm_row_valid, allocator scan) see either the
  // completed row or a scrubbed row, never a torn one.
  //
  // Six params fits the paideia-as ABI; caller pre-packs the three
  // name qwords (cmd_module_alloc does this by walking name_ptr).
  pub let cm_row_alloc : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (name_lo: u64) (name_mid: u64) (name_hi: u64)
       (vers_func: u64) (in_process: u64) (cap_env_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R123.M1 (paideia-os #2503): claim one KIND_CMD_MODULE row. Low-first scan (r15=idx cursor) over 16 rows of 48 bytes. On claim: (1) write name_lo/mid/hi verbatim to [row+0/+8/+16]; (2) write vers_func verbatim to [row+24]; (3) build flags_ref = (in_use=1 << 56) | (refcount=0 << 16) | (in_process & 0xFF) and write to [row+32]; (4) write cap_env_ptr to [row+40]. Publish is header-last: [row+32] carries the in_use bit and is written LAST so torn reads see either the completed row or a scrubbed row, never a mid-copy state. Register plan: five callee-save pushes (rbx=name_lo, r12=name_mid, r13=name_hi, r14=vers_func, r15=idx cursor); in_process and cap_env_ptr stay in caller-save rcx/r8 and are re-materialised at claim time from rcx=arg4/r8=arg5 (no nested calls between arg capture and claim). Labels prefixed cm_ra_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                    // name_lo
        mov r12, rsi;                    // name_mid
        mov r13, rdx;                    // name_hi
        mov r14, rcx;                    // vers_func
        // r8 = in_process, r9 = cap_env_ptr (kept caller-save; scan
        // has no nested calls that would clobber them).

        xor r15, r15;                    // idx = 0
      cm_ra_scan:
        mov r10, 16;                     // CM_MAX
        cmp r15, r10;
        jae cm_ra_enospc;

        lea r10, [rip + _cmd_module_table];
        mov r11, r15;
        shl r11, 5;                      // idx * 32
        mov rax, r15;
        shl rax, 4;                      // idx * 16
        add r11, rax;                    // idx * 48
        add r10, r11;

        // Check header at [+32] in_use byte.
        mov rax, [r10 + 32];
        shr rax, 56;
        cmp rax, 0;
        je  cm_ra_claim;

        add r15, 1;
        jmp cm_ra_scan;

      cm_ra_claim:
        // [+0/+8/+16] name_lo / name_mid / name_hi (verbatim).
        mov [r10 + 0],  rbx;
        mov [r10 + 8],  r12;
        mov [r10 + 16], r13;

        // [+24] vers_func (verbatim).
        mov [r10 + 24], r14;

        // [+40] cap_env_ptr (r9, in from arg5).
        mov [r10 + 40], r9;

        // [+32] flags_ref = (in_use=1 << 56) | (in_process & 0xFF).
        // refcount [47:16] starts at 0.
        mov rax, r8;                     // in_process (arg4)
        mov r11, 0xFF;
        and rax, r11;                    // in_process byte at [7:0]
        mov rcx, 1;
        shl rcx, 56;                     // in_use bit at [63:56]
        or  rax, rcx;
        mov [r10 + 32], rax;             // publish in_use LAST

        mov rax, r15;                    // return row_idx
        jmp cm_ra_out;

      cm_ra_enospc:
        mov rax, 0xFFFFEBBC;             // CM_MINT_ENOSPC

      cm_ra_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // cm_row_free_inner(idx) -> (). Scrub all six u64 words. Not
  // bounds-checked -- callers guarantee idx < CM_MAX. Split from
  // cmd_module_free below so the scrub can be reused in future
  // rollback arms without double-bumping CM_ST_FREES.
  pub let cm_row_free_inner : (u64) -> () !{mem} @{} =
    fn (idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R123.M1 (paideia-os #2503): scrub one row (six u64 words). No bounds check by contract. Labels prefixed cm_fi_.",
      block: {
        lea r10, [rip + _cmd_module_table];
        mov r11, rdi;
        shl r11, 5;                      // idx * 32
        mov rax, rdi;
        shl rax, 4;                      // idx * 16
        add r11, rax;                    // idx * 48
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        mov [r10 + 40], rax;
        mov [r10 + 32], rax;             // in_use cleared LAST
        ret
      }
    }

  // =========================================================================
  // SECTION 13  cmd_module_alloc(name_ptr, name_len, vers_func,
  //                              in_process, cap_env_ptr)
  //             -> row_idx | CM_MINT_BAD_* | CM_MINT_ENOSPC
  //
  // The M1 mint helper. Not reachable via cap_invoke at M1; called
  // from the boot witness (r123_cmd_module.pdx) and, from R123.M2, the
  // shell command-loader after it holds a KIND_MEMORY parent cap with
  // RIGHT_MINT.
  //
  // Gate order:
  //   (1) cm_name_valid(name_ptr, name_len)  -- ptr != 0 AND 1..24
  //   (2) cm_functor_valid(functor_id)       -- functor_id in [1..u32]
  //       (functor_id = vers_func[63:32])
  //   (3) cm_inproc_valid(in_process)        -- in_process in {0, 1}
  //   (4) Byte-walk name_ptr into 3 u64 words (up to 24 bytes,
  //       zero-padded), then cm_row_alloc(name_lo, name_mid, name_hi,
  //       vers_func, in_process, cap_env_ptr).
  //
  // On success bumps CM_ST_MINTS; refusal funnel bumps CM_ST_REFUSED.
  // No fingerprint from this leaf -- the boot witness emits the R123
  // acceptance fingerprint after reading name/functor_id/in_process
  // back through the accessors, matching pipeline_edge_alloc's own
  // in-mint emit vs. the M5-followup witness's post-alloc emit split
  // (this M1 landing takes the LATTER shape because the accessors are
  // the load-bearing acceptance surface, not the mint alone).
  // =========================================================================

  pub let cmd_module_alloc : (u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (name_ptr: u64) (name_len: u64) (vers_func: u64)
       (in_process: u64) (cap_env_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R123.M1 (paideia-os #2503): mint one KIND_CMD_MODULE row. Gate order: (1) cm_name_valid(name_ptr, name_len); (2) cm_functor_valid(vers_func[63:32]); (3) cm_inproc_valid(in_process); (4) byte-walk name_ptr into three u64 words (up to 24 bytes, zero-padded on short names) and cm_row_alloc(...). Register plan: seven callee-save pushes (rbx=name_ptr, r12=name_len, r13=vers_func, r14=in_process, r15=cap_env_ptr, plus a 48-byte scratch for the packed name in the local frame). Entry rsp%16==8; five pushes (40) leave %16==0; the sub rsp,32 name-scratch adds 32 more (%16 stays 0), sufficient SysV alignment for every nested call (cm_name_valid / cm_functor_valid / cm_inproc_valid / cm_row_alloc / cm_note). No stack pushes across the cm_row_alloc call (it takes 6 register args, matching paideia-as ABI ceiling exactly). No fingerprint emitted from here -- the boot witness (r123_cmd_module.pdx) emits the R123 acceptance fingerprint after read-back. Refusal funnel bumps CM_ST_REFUSED. Labels prefixed cm_al_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        sub  rsp, 32;                    // scratch: name_lo/mid/hi + 8 pad

        mov rbx, rdi;                    // name_ptr
        mov r12, rsi;                    // name_len
        mov r13, rdx;                    // vers_func
        mov r14, rcx;                    // in_process
        mov r15, r8;                     // cap_env_ptr

        // (1) name validity.
        mov rdi, rbx;
        mov rsi, r12;
        call cm_name_valid;
        cmp rax, 0;
        je  cm_al_bad_name;

        // (2) functor validity (from vers_func[63:32]).
        mov rdi, r13;
        shr rdi, 32;
        call cm_functor_valid;
        cmp rax, 0;
        je  cm_al_bad_functor;

        // (3) in_process validity.
        mov rdi, r14;
        call cm_inproc_valid;
        cmp rax, 0;
        je  cm_al_bad_inproc;

        // (4) Byte-walk name_ptr into three u64 scratch slots on the
        // local frame ([rsp+0]=name_lo, [rsp+8]=name_mid,
        // [rsp+16]=name_hi). Zero the scratch first, then copy up to
        // name_len bytes (bounded to 24 by the validity gate).
        xor rax, rax;
        mov [rsp + 0],  rax;
        mov [rsp + 8],  rax;
        mov [rsp + 16], rax;

        xor rcx, rcx;                    // i = 0
      cm_al_name_loop:
        cmp rcx, r12;                    // i < name_len?
        jae cm_al_name_done;
        xor r10, r10;                    // clear before mov_b (encoder
                                         //   does not zero-extend on
                                         //   its own; see pipe_backend
                                         //   .pdx §57 comment)
        mov_b r10, [rbx + rcx*1];        // byte = name[i]; explicit *1
                                         //   SIB per superblock.pdx
                                         //   §271 encoder-friction note
        mov_b [rsp + rcx*1], r10;        // scratch[i] = byte
        add rcx, 1;
        jmp cm_al_name_loop;

      cm_al_name_done:
        // Load packed name qwords into the argument registers, then
        // call cm_row_alloc(name_lo, name_mid, name_hi, vers_func,
        // in_process, cap_env_ptr).
        mov rdi, [rsp + 0];              // name_lo
        mov rsi, [rsp + 8];              // name_mid
        mov rdx, [rsp + 16];             // name_hi
        mov rcx, r13;                    // vers_func
        mov r8,  r14;                    // in_process
        mov r9,  r15;                    // cap_env_ptr
        call cm_row_alloc;

        // Distinguish success (rax < CM_MAX = 16) from ENOSPC
        // (rax == 0xFFFFEBBC).
        mov r10, 16;
        cmp rax, r10;
        jae cm_al_enospc;

        // Success: bump CM_ST_MINTS.
        push rax;
        mov rdi, 0;                      // CM_ST_MINTS
        call cm_note;
        pop rax;
        jmp cm_al_out;

      cm_al_enospc:
        // rax already holds CM_MINT_ENOSPC.
        jmp cm_al_refused;
      cm_al_bad_name:
        mov rax, 0xFFFFEBBF;             // CM_MINT_BAD_NAME
        jmp cm_al_refused;
      cm_al_bad_functor:
        mov rax, 0xFFFFEBBE;             // CM_MINT_BAD_FUNCTOR
        jmp cm_al_refused;
      cm_al_bad_inproc:
        mov rax, 0xFFFFEBBD;             // CM_MINT_BAD_INPROC

      cm_al_refused:
        push rax;
        mov rdi, 4;                      // CM_ST_REFUSED
        call cm_note;
        pop rax;

      cm_al_out:
        add rsp, 32;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // =========================================================================
  // SECTION 14  cmd_module_free(row_idx) -> 0 | CM_FREE_BAD_SLOT
  //
  // Scrubs the row + bumps CM_ST_FREES. Refuses out-of-range indices
  // and already-free rows (the double-free case) with CM_FREE_BAD_SLOT.
  // Does NOT consult refcount -- the shell command-loader is
  // responsible for its own reference discipline via cmd_module_incref
  // / cmd_module_decref before it calls free.
  // =========================================================================

  pub let cmd_module_free : (u64) -> u64 !{mem} @{} =
    fn (row_idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R123.M1 (paideia-os #2503): free one KIND_CMD_MODULE row. Gate: (1) row_idx < CM_MAX; (2) row in_use marker set. On success: cm_row_free_inner + cm_note(CM_ST_FREES). Refusal: CM_FREE_BAD_SLOT. Single callee-save push (rbx = row_idx cache across cm_row_valid / cm_row_free_inner / cm_note nested calls). Labels prefixed cm_fr_.",
      block: {
        cmp rdi, 16;                     // CM_MAX
        jae cm_fr_bad_leaf;

        push rbx;
        mov rbx, rdi;

        mov rdi, rbx;
        call cm_row_valid;
        cmp rax, 0;
        je  cm_fr_bad_pop;

        mov rdi, rbx;
        call cm_row_free_inner;

        mov rdi, 1;                      // CM_ST_FREES
        call cm_note;

        xor rax, rax;                    // CM_OK
        pop rbx;
        ret;

      cm_fr_bad_pop:
        pop rbx;
      cm_fr_bad_leaf:
        mov rax, 0xFFFFEBBA;             // CM_FREE_BAD_SLOT
        ret
      }
    }

  // =========================================================================
  // SECTION 15  Accessors -- each returns CM_DECODE_BAD on invalid row.
  // =========================================================================

  // cmd_module_get_name_ptr(row_idx) -> u64
  //
  // Returns a pointer to the row's name[0..23] slot (i.e., the row
  // base address). The name lives INLINE in the row -- there is no
  // separate name buffer -- so a caller reads at most 24 bytes from
  // the returned pointer (or up to the first NUL). This is the
  // rationale for exposing a pointer rather than copying the name:
  // command-module lookup is on the hot path and a copy per lookup
  // would be wasteful.
  pub let cmd_module_get_name_ptr : (u64) -> u64 !{mem} @{} =
    fn (row_idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R123.M1 (paideia-os #2503): pointer to row's inline name[0..23] (row base) or CM_DECODE_BAD. Single callee-save push (r12 = row_idx cache across cm_row_valid). Labels prefixed cm_gn_.",
      block: {
        push r12;
        mov r12, rdi;
        call cm_row_valid;
        cmp rax, 0;
        je  cm_gn_bad;
        lea rax, [rip + _cmd_module_table];
        mov r11, r12;
        shl r11, 5;
        mov r10, r12;
        shl r10, 4;
        add r11, r10;
        add rax, r11;                    // rax = row base ptr
        jmp cm_gn_out;
      cm_gn_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;     // CM_DECODE_BAD
      cm_gn_out:
        pop r12;
        ret
      }
    }

  // cmd_module_get_name_len(row_idx) -> u32
  //
  // Scans name[0..23] for the first NUL byte, returns the byte offset
  // as a u64 zero-extended (u32 in low 32 bits). If no NUL is found,
  // returns 24 (CM_NAME_MAX -- name filled every slot). On invalid
  // row, returns CM_DECODE_BAD.
  pub let cmd_module_get_name_len : (u64) -> u64 !{mem} @{} =
    fn (row_idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R123.M1 (paideia-os #2503): first-NUL scan over row's inline name[0..23]; returns u32 offset in low 32 (u64 zero-extended). Full-slot names return 24. Labels prefixed cm_nl_.",
      block: {
        push r12;
        mov r12, rdi;
        call cm_row_valid;
        cmp rax, 0;
        je  cm_nl_bad;
        lea r10, [rip + _cmd_module_table];
        mov r11, r12;
        shl r11, 5;
        mov r8, r12;
        shl r8, 4;
        add r11, r8;
        add r10, r11;                    // r10 = row base
        xor rcx, rcx;                    // i = 0
      cm_nl_scan:
        cmp rcx, 24;
        jae cm_nl_full;
        xor rax, rax;                    // pre-xor (mov_b does not
                                         //   zero-extend)
        mov_b rax, [r10 + rcx*1];        // byte = name[i]; explicit *1
                                         //   SIB
        cmp rax, 0;
        je  cm_nl_found;
        add rcx, 1;
        jmp cm_nl_scan;
      cm_nl_found:
        mov rax, rcx;                    // length = i
        jmp cm_nl_out;
      cm_nl_full:
        mov rax, 24;                     // CM_NAME_MAX
        jmp cm_nl_out;
      cm_nl_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;     // CM_DECODE_BAD
      cm_nl_out:
        pop r12;
        ret
      }
    }

  // cmd_module_get_functor_id(row_idx) -> u32
  pub let cmd_module_get_functor_id : (u64) -> u64 !{mem} @{} =
    fn (row_idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R123.M1 (paideia-os #2503): functor_id (vers_func u64 [63:32] at [row+24]) zero-extended into u64. Labels prefixed cm_gf_.",
      block: {
        push r12;
        mov r12, rdi;
        call cm_row_valid;
        cmp rax, 0;
        je  cm_gf_bad;
        lea r10, [rip + _cmd_module_table];
        mov r11, r12;
        shl r11, 5;
        mov r8, r12;
        shl r8, 4;
        add r11, r8;
        add r10, r11;
        mov rax, [r10 + 24];
        shr rax, 32;                     // functor_id = vers_func[63:32]
        jmp cm_gf_out;
      cm_gf_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      cm_gf_out:
        pop r12;
        ret
      }
    }

  // cmd_module_get_version_maj(row_idx) -> u16
  pub let cmd_module_get_version_maj : (u64) -> u64 !{mem} @{} =
    fn (row_idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R123.M1 (paideia-os #2503): version_maj (vers_func [15:0] at [row+24]) zero-extended. Labels prefixed cm_gm_.",
      block: {
        push r12;
        mov r12, rdi;
        call cm_row_valid;
        cmp rax, 0;
        je  cm_gm_bad;
        lea r10, [rip + _cmd_module_table];
        mov r11, r12;
        shl r11, 5;
        mov r8, r12;
        shl r8, 4;
        add r11, r8;
        add r10, r11;
        mov rax, [r10 + 24];
        mov r10, 0xFFFF;
        and rax, r10;
        jmp cm_gm_out;
      cm_gm_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      cm_gm_out:
        pop r12;
        ret
      }
    }

  // cmd_module_get_version_min(row_idx) -> u16
  pub let cmd_module_get_version_min : (u64) -> u64 !{mem} @{} =
    fn (row_idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R123.M1 (paideia-os #2503): version_min (vers_func [31:16] at [row+24]) zero-extended. Labels prefixed cm_gv_.",
      block: {
        push r12;
        mov r12, rdi;
        call cm_row_valid;
        cmp rax, 0;
        je  cm_gv_bad;
        lea r10, [rip + _cmd_module_table];
        mov r11, r12;
        shl r11, 5;
        mov r8, r12;
        shl r8, 4;
        add r11, r8;
        add r10, r11;
        mov rax, [r10 + 24];
        shr rax, 16;
        mov r10, 0xFFFF;
        and rax, r10;
        jmp cm_gv_out;
      cm_gv_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      cm_gv_out:
        pop r12;
        ret
      }
    }

  // cmd_module_is_in_process(row_idx) -> u8 (0 or 1)
  pub let cmd_module_is_in_process : (u64) -> u64 !{mem} @{} =
    fn (row_idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R123.M1 (paideia-os #2503): in_process (flags_ref [7:0] at [row+32]) zero-extended into u64. Labels prefixed cm_ii_.",
      block: {
        push r12;
        mov r12, rdi;
        call cm_row_valid;
        cmp rax, 0;
        je  cm_ii_bad;
        lea r10, [rip + _cmd_module_table];
        mov r11, r12;
        shl r11, 5;
        mov r8, r12;
        shl r8, 4;
        add r11, r8;
        add r10, r11;
        mov rax, [r10 + 32];
        mov r10, 0xFF;
        and rax, r10;
        jmp cm_ii_out;
      cm_ii_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      cm_ii_out:
        pop r12;
        ret
      }
    }

  // cmd_module_get_cap_env(row_idx) -> u64
  pub let cmd_module_get_cap_env : (u64) -> u64 !{mem} @{} =
    fn (row_idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R123.M1 (paideia-os #2503): cap_env_ptr (u64 at [row+40]) verbatim. Labels prefixed cm_ge_.",
      block: {
        push r12;
        mov r12, rdi;
        call cm_row_valid;
        cmp rax, 0;
        je  cm_ge_bad;
        lea r10, [rip + _cmd_module_table];
        mov r11, r12;
        shl r11, 5;
        mov r8, r12;
        shl r8, 4;
        add r11, r8;
        add r10, r11;
        mov rax, [r10 + 40];
