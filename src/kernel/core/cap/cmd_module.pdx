    }

  // =========================================================================
  // SECTION 16  Refcount helpers -- cmd_module_incref / cmd_module_decref.
  //
  // Both operate on flags_ref [47:16] (u32 refcount). incref refuses
  // saturation at u32_max (CM_REF_OVERFLOW); decref refuses underflow
  // at zero (CM_REF_UNDERFLOW). Both return the NEW refcount value on
  // success (zero-extended into u64), or the failure sentinel.
  //
  // Load-modify-store idiom over [row+32]; the read/write pair is not
  // atomic (paideia-os is single-CPU boot; SMP-safe incref/decref is
  // an R123.M6+ concern), matching pipeline_edge's own non-atomic
  // stats bumper.
  // =========================================================================

  pub let cmd_module_incref : (u64) -> u64 !{mem} @{} =
    fn (row_idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R123.M1 (paideia-os #2503): bump refcount at [row+32][47:16] by 1; return new count zero-extended. Refuses saturation at u32_max with CM_REF_OVERFLOW. Load-modify-store, non-atomic. Bumps CM_ST_INCREFS on success. Labels prefixed cm_ic_.",
      block: {
        cmp rdi, 16;                     // CM_MAX
        jae cm_ic_bad_leaf;

        push rbx;
        mov rbx, rdi;

        mov rdi, rbx;
        call cm_row_valid;
        cmp rax, 0;
        je  cm_ic_bad_pop;

        lea r10, [rip + _cmd_module_table];
        mov r11, rbx;
        shl r11, 5;
        mov r8, rbx;
        shl r8, 4;
        add r11, r8;
        add r10, r11;                    // r10 = row base

        mov rcx, [r10 + 32];             // flags_ref
        // Extract refcount = flags_ref[47:16].
        mov rax, rcx;
        shr rax, 16;
        mov r11, 0xFFFFFFFF;
        and rax, r11;                    // refcount

        // Saturation check.
        cmp rax, r11;                    // rax == 0xFFFFFFFF?
        je  cm_ic_overflow_pop;

        add rax, 1;                      // new refcount

        // Clear old refcount slot [47:16] in flags_ref: mask out the
        // 32-bit window via ~(0xFFFFFFFF << 16). Encoded as two
        // shifts + not to avoid `and imm64`.
        push rax;                        // stash new refcount
        mov  r11, 0xFFFFFFFF;
        shl  r11, 16;                    // r11 = mask window
        not  r11;                        // r11 = ~mask
        and  rcx, r11;                   // clear old refcount
        pop  rax;                        // rax = new refcount

        // Insert new refcount at [47:16].
        push rax;                        // stash again for return
        shl rax, 16;
        or  rcx, rax;
        mov [r10 + 32], rcx;

        mov rdi, 2;                      // CM_ST_INCREFS
        call cm_note;

        pop rax;                         // return new refcount
        pop rbx;
        ret;

      cm_ic_overflow_pop:
        pop rbx;
        mov rax, 0xFFFFEBB8;             // CM_REF_OVERFLOW
        ret;

      cm_ic_bad_pop:
        pop rbx;
      cm_ic_bad_leaf:
        mov rax, 0xFFFFEBBB;             // CM_BAD_SLOT
        ret
      }
    }

  pub let cmd_module_decref : (u64) -> u64 !{mem} @{} =
    fn (row_idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R123.M1 (paideia-os #2503): decrement refcount at [row+32][47:16] by 1; return new count zero-extended. Refuses underflow at zero with CM_REF_UNDERFLOW. Load-modify-store, non-atomic. Bumps CM_ST_DECREFS on success. Labels prefixed cm_dc_.",
      block: {
        cmp rdi, 16;                     // CM_MAX
        jae cm_dc_bad_leaf;

        push rbx;
        mov rbx, rdi;

        mov rdi, rbx;
        call cm_row_valid;
        cmp rax, 0;
        je  cm_dc_bad_pop;

        lea r10, [rip + _cmd_module_table];
        mov r11, rbx;
        shl r11, 5;
        mov r8, rbx;
        shl r8, 4;
        add r11, r8;
        add r10, r11;                    // r10 = row base

        mov rcx, [r10 + 32];             // flags_ref
        mov rax, rcx;
        shr rax, 16;
        mov r11, 0xFFFFFFFF;
        and rax, r11;                    // refcount

        cmp rax, 0;
        je  cm_dc_underflow_pop;

        sub rax, 1;                      // new refcount

        push rax;
        mov  r11, 0xFFFFFFFF;
        shl  r11, 16;
        not  r11;
        and  rcx, r11;
        pop  rax;

        push rax;
        shl rax, 16;
        or  rcx, rax;
        mov [r10 + 32], rcx;

        mov rdi, 3;                      // CM_ST_DECREFS
        call cm_note;

        pop rax;
        pop rbx;
        ret;

      cm_dc_underflow_pop:
        pop rbx;
        mov rax, 0xFFFFEBB9;             // CM_REF_UNDERFLOW
        ret;

      cm_dc_bad_pop:
        pop rbx;
      cm_dc_bad_leaf:
        mov rax, 0xFFFFEBBB;             // CM_BAD_SLOT
        ret
      }
    }
}
