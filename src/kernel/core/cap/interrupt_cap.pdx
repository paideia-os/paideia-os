// src/kernel/core/cap/interrupt_cap.pdx — R24-M5-002 / #904
// KIND_INTERRUPT_CAP + KIND_NOTIFICATION_CAP derived capability descriptors
//
// Design context
// --------------
// R24.M3 wired per-CPU NVMe IO (SQ,CQ) pairs to per-CPU MSI-X vectors
// via vector_alloc_for_cpu (core/ipi/vectors.pdx). R24.M5 completes the
// story: the userspace NVMe driver must receive its IRQ as a normal
// notification, not as a magic ring-0 hook. Two composed capabilities
// carry that authority:
//
//   KIND_INTERRUPT_CAP  — right to bind an MSI-X vector on a given CPU,
//                         and to acknowledge (EOI) the resulting IRQ.
//                         The kernel's ISR path (r24-m5-001 / #903
//                         nvme_irq_handler_qid) walks the CQ and posts
//                         a signal into the paired notification.
//
//   KIND_NOTIFICATION_CAP — right to send/receive on a per-cap
//                         notification badge. The IRQ handler holds
//                         SEND; the driver task holds RECV.
//
// Both mint gates are structural stubs (mint gate + descriptor write
// deferred) matching the scaffolding pattern established by AcpiCap
// (R20.M4 / #819) and DeviceCap (R22.M3 / #858). The real slab_alloc +
// descriptor write is gated on cap_revoke gaining a real body — see
// src/kernel/core/cap/revoke.pdx §R12-m5-001 and the AcpiCap module
// header §Fixture posture.
//
// KIND base assignment
// --------------------
// The base-kind enum (cap/kind.pdx §Kind) is closed at 16 slots. Unlike
// KIND_ACPI / KIND_PCI_DEV which had to ride KIND_PAGE (no matching
// base slot existed), KIND_INTERRUPT (base 9) and KIND_NOTIFICATION
// (base 12) already occupy the enum. These caps therefore ride their
// natural base slots:
//
//   KIND_INTERRUPT_CAP_BASE  = 9   (KIND_INTERRUPT)
//   KIND_NOTIFICATION_CAP_BASE = 12 (KIND_NOTIFICATION)
//
// Distinct derived-tag values sit above the 4-bit LAM tag range so
// their auditability at the descriptor tail is preserved:
//
//   KIND_INTERRUPT_CAP    = 0x40  (distinct from 0x15/0x20/0x30)
//   KIND_NOTIFICATION_CAP = 0x41
//
// Rights discipline
// -----------------
// KIND_INTERRUPT_CAP has two refinement rights. R_INT_RECEIVE grants
// binding + IRQ delivery via the paired notification. R_INT_ACKNOWLEDGE
// grants EOI + mask/unmask control. The kernel's mint gate for the
// NVMe driver hands out (R_INT_RECEIVE | R_INT_ACKNOWLEDGE) as a single
// derived cap — real hardware drivers need both to run.
//
//   R_INT_RECEIVE      (bit 0)  — bind + receive-via-notification
//   R_INT_ACKNOWLEDGE  (bit 1)  — EOI + mask/unmask
//
// KIND_NOTIFICATION_CAP mirrors seL4-style notification-badge semantics:
//
//   R_NOTIFY_SEND      (bit 0)  — post-signal (kernel-only in practice)
//   R_NOTIFY_RECV      (bit 1)  — wait / poll (driver task)
//
// Descriptor payload layout (16 bytes, KIND_INTERRUPT_CAP)
// --------------------------------------------------------
//
//   +0    u8  vector             — x86 IDT vector 0x60..0xEF
//   +1    u8  cpu_idx            — dense logical CPU index
//   +2    u16 _pad0
//   +4    u32 target_task_pid    — receiving task (KIND_PROCESS pid)
//   +8    u32 rights             — subset of R_INT_ALL
//   +12   u32 _pad1
//
// Descriptor payload layout (16 bytes, KIND_NOTIFICATION_CAP)
// -----------------------------------------------------------
//
//   +0    u32 target_task_pid    — receiving task
//   +4    u32 rights             — subset of R_NOTIFY_ALL
//   +8    u64 _reserved          — future notif-id / badge cache
//
// Fixture posture at R24.M5
// -------------------------
// The mint gates return *_MINT_OK for legitimate inputs and appropriate
// *_MINT_BAD_* codes for malformed ones. No slab_alloc, no descriptor
// write, no ISR-to-notification bridge. The bridge (r24-m5-001 request
// table + wake path) lands as its own dormant symbol; the mint gates
// prove the type-system + rights lattice compile cleanly.
//
// paideia-as encoder-gap posture (v0.22.x)
// ----------------------------------------
// Pure arithmetic + branch. No memory access, no calls except to the
// paired rights_valid helpers. Reserved-label discipline: labels
// prefixed `int_cap_` and `notif_cap_`.

module InterruptCap = structure {

  // ============================================================================
  // Kind tags — KIND_INTERRUPT_CAP
  // ============================================================================

  pub let KIND_INTERRUPT_CAP_BASE : u64 = 9      // = KIND_INTERRUPT (base slot)
  pub let KIND_INTERRUPT_CAP      : u64 = 0x40   // derived tag (distinct from 0x15/0x20/0x30)
  pub let KIND_INTERRUPT_CAP_TAG  : u64 = 0x40

  // ============================================================================
  // Kind tags — KIND_NOTIFICATION_CAP
  // ============================================================================

  pub let KIND_NOTIFICATION_CAP_BASE : u64 = 12  // = KIND_NOTIFICATION (base slot)
  pub let KIND_NOTIFICATION_CAP      : u64 = 0x41
  pub let KIND_NOTIFICATION_CAP_TAG  : u64 = 0x41

  // ============================================================================
  // Rights — KIND_INTERRUPT_CAP
  // ============================================================================

  pub let R_INT_RECEIVE     : u64 = 0x01
  pub let R_INT_ACKNOWLEDGE : u64 = 0x02
  pub let R_INT_ALL         : u64 = 0x03   // 0x01 | 0x02

  // ============================================================================
  // Rights — KIND_NOTIFICATION_CAP
  // ============================================================================

  pub let R_NOTIFY_SEND     : u64 = 0x01
  pub let R_NOTIFY_RECV     : u64 = 0x02
  pub let R_NOTIFY_ALL      : u64 = 0x03   // 0x01 | 0x02

  // ============================================================================
  // Mint return codes — KIND_INTERRUPT_CAP
  // ============================================================================

  pub let INT_CAP_MINT_OK           : u64 = 0
  pub let INT_CAP_MINT_BAD_RIGHTS   : u64 = 0xFFFFFFFF
  pub let INT_CAP_MINT_BAD_VECTOR   : u64 = 0xFFFFFFFE
  pub let INT_CAP_MINT_BAD_CPU      : u64 = 0xFFFFFFFD

  // ============================================================================
  // Mint return codes — KIND_NOTIFICATION_CAP
  // ============================================================================

  pub let NOTIF_CAP_MINT_OK         : u64 = 0
  pub let NOTIF_CAP_MINT_BAD_RIGHTS : u64 = 0xFFFFFFFF
  pub let NOTIF_CAP_MINT_BAD_TASK   : u64 = 0xFFFFFFFE

  // ============================================================================
  // Vector-range bounds (mirror ipi/vectors.pdx VECTOR_LO / VECTOR_HI)
  // ============================================================================
  //
  // vector_alloc_for_cpu returns IDT vectors 0x60..0xEF; VECTOR_INVALID
  // is 0xFF. The mint gate rejects vectors outside [0x60, 0xEF] so a
  // caller cannot mint an interrupt cap for a NMI / spurious / IPI slot.

  pub let INT_CAP_VECTOR_LO : u64 = 0x60
  pub let INT_CAP_VECTOR_HI : u64 = 0xEF

  // ============================================================================
  // CPU-index bound (mirror VECTOR_POOL_MAX_CPUS in ipi/vectors.pdx)
  // ============================================================================

  pub let INT_CAP_CPU_MAX   : u64 = 8       // conservative ceiling; matches NVME_IO_MAX_QUEUES

  // ============================================================================
  // int_rights_valid(rights) -> u64
  // ============================================================================
  //
  // Returns 1 iff (rights & R_INT_ALL) == rights; else 0.
  // Same shape as AcpiCap.rights_valid / DeviceCap.rights_valid.

  pub let int_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R24-M5-002 (#904) KIND_INTERRUPT_CAP rights-subset validator. Returns 1 iff (rights & R_INT_ALL) == rights; else 0. R_INT_ALL = 0x03 (bits 0..1). Same encoder posture as AcpiCap.rights_valid — unsafe block per paideia-as #913 (pure-fn if-else T0532). Leaf; no callee-save.",
      block: {
        mov rax, rdi;
        mov r10, 0x3;
        and rax, r10;
        cmp rax, rdi;
        jne int_cap_rights_no;
        mov rax, 1;
        ret;
        int_cap_rights_no:
          mov rax, 0;
          ret
      }
    }

  // ============================================================================
  // notif_rights_valid(rights) -> u64
  // ============================================================================
  //
  // Returns 1 iff (rights & R_NOTIFY_ALL) == rights; else 0.

  pub let notif_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R24-M5-002 (#904) KIND_NOTIFICATION_CAP rights-subset validator. Returns 1 iff (rights & R_NOTIFY_ALL) == rights; else 0. R_NOTIFY_ALL = 0x03. Same encoder posture as int_rights_valid. Leaf; no callee-save.",
      block: {
        mov rax, rdi;
        mov r10, 0x3;
        and rax, r10;
        cmp rax, rdi;
        jne notif_cap_rights_no;
        mov rax, 1;
        ret;
        notif_cap_rights_no:
          mov rax, 0;
          ret
      }
    }

  // ============================================================================
  // interrupt_cap_mint(vector, cpu_idx, target_pid, rights) -> u64
  // ============================================================================
  //
  // Gate-only mint per the AcpiCap / DeviceCap pattern. Real slab_alloc
  // + cap_mint_write wire-up deferred until cap_revoke has a real body
  // (see cap/revoke.pdx §R12-m5-001) so the revoke-then-clean-detach
  // acceptance criterion from #904 can round-trip.
  //
  // SysV:
  //   rdi = vector (u8 semantics; validated against [INT_CAP_VECTOR_LO..HI])
  //   rsi = cpu_idx (u8 semantics; validated against INT_CAP_CPU_MAX)
  //   rdx = target_task_pid (u32 semantics; 0 rejected as "no receiver")
  //   rcx = rights (u32 semantics; must be subset of R_INT_ALL)
  //
  // Returns rax = INT_CAP_MINT_OK on success, or INT_CAP_MINT_BAD_*.
  //
  // Return codes:
  //   INT_CAP_MINT_OK           = 0
  //   INT_CAP_MINT_BAD_VECTOR   = 0xFFFFFFFE   (vector outside [0x60, 0xEF])
  //   INT_CAP_MINT_BAD_CPU      = 0xFFFFFFFD   (cpu_idx >= INT_CAP_CPU_MAX)
  //   INT_CAP_MINT_BAD_RIGHTS   = 0xFFFFFFFF   (rights outside R_INT_ALL)

  pub let interrupt_cap_mint : (u64, u64, u64, u64) -> u64 !{} @{} =
    fn (vector: u64, cpu_idx: u64, target_pid: u64, rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R24-M5-002 (#904) KIND_INTERRUPT_CAP mint gate. Sequence: vector range check, cpu_idx range check, rights_valid. On any failure return the corresponding INT_CAP_MINT_BAD_*. Real slab_alloc + cap_mint_write wire-up deferred until cap_revoke has a real body (see cap/revoke.pdx §R12-m5-001) so that the #904 revoke-→-clean-detach acceptance fixture can round-trip. Preserves rcx (rights) across the int_rights_valid call by shuffling it into rdi. Leaf w.r.t. this file (no external calls beyond int_rights_valid). Written as unsafe block per paideia-as #913 (pure-fn if-else T0532).",
      block: {
        // Vector range check: 0x60 <= vector <= 0xEF.
        cmp rdi, 0x60;
        jb  int_cap_mint_bad_vec;
        cmp rdi, 0xEF;
        ja  int_cap_mint_bad_vec;

        // cpu_idx bound: cpu_idx < INT_CAP_CPU_MAX (8).
        cmp rsi, 8;
        jae int_cap_mint_bad_cpu;

        // target_pid must be non-zero (0 = "no receiver" sentinel).
        cmp rdx, 0;
        je  int_cap_mint_bad_cpu;

        // int_rights_valid expects rights in rdi.
        mov rdi, rcx;
        call int_rights_valid;
        cmp rax, 0;
        je  int_cap_mint_bad_rights;

        // OK path — return INT_CAP_MINT_OK. Real descriptor write
        // deferred (see module header §Fixture posture).
        mov rax, 0;
        ret;

        int_cap_mint_bad_vec:
          mov rax, 0xFFFFFFFE;
          ret;
        int_cap_mint_bad_cpu:
          mov rax, 0xFFFFFFFD;
          ret;
        int_cap_mint_bad_rights:
          mov rax, 0xFFFFFFFF;
          ret
      }
    }

  // ============================================================================
  // notification_cap_mint(target_pid, rights) -> u64
  // ============================================================================
  //
  // Gate-only mint for a per-task notification-badge capability.
  // Two rights are legal: R_NOTIFY_SEND (kernel/ISR posts) and
  // R_NOTIFY_RECV (userspace waits/polls). A driver task typically
  // holds RECV; the kernel-side interrupt handler holds SEND on the
  // paired badge.
  //
  // SysV:
  //   rdi = target_task_pid (u32 semantics; 0 rejected)
  //   rsi = rights (u32 semantics; subset of R_NOTIFY_ALL)
  //
  // Returns rax = NOTIF_CAP_MINT_OK on success, or NOTIF_CAP_MINT_BAD_*.

  pub let notification_cap_mint : (u64, u64) -> u64 !{} @{} =
    fn (target_pid: u64, rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R24-M5-002 (#904) KIND_NOTIFICATION_CAP mint gate. Sequence: target_pid != 0, then notif_rights_valid(rights). On any failure return the corresponding NOTIF_CAP_MINT_BAD_*. Real slab_alloc + cap_mint_write wire-up deferred until cap_revoke has a real body (see cap/revoke.pdx §R12-m5-001). Same structural posture as interrupt_cap_mint. Preserves rsi (rights) across the notif_rights_valid call by shuffling it into rdi. Written as unsafe block per paideia-as #913.",
      block: {
        // Zero target_pid gate.
        cmp rdi, 0;
        je  notif_cap_mint_bad_task;

        // notif_rights_valid expects rights in rdi.
        mov rdi, rsi;
        call notif_rights_valid;
        cmp rax, 0;
        je  notif_cap_mint_bad_rights;

        // OK path — return NOTIF_CAP_MINT_OK (0). Real descriptor write
        // deferred (see module header §Fixture posture).
        mov rax, 0;
        ret;

        notif_cap_mint_bad_task:
          mov rax, 0xFFFFFFFE;
          ret;
        notif_cap_mint_bad_rights:
          mov rax, 0xFFFFFFFF;
          ret
      }
    }
}
