// src/kernel/core/cap/mount_replay_digest.pdx -- R51.M8-003 (#1677)
//
// UNMOUNT + REMOUNT + WAL REPLAY -- SNAPSHOT DIGEST PRIMITIVE (SUBSTRATE STUB).
//
// Design authority: design/hardware/nvme-ahci-tail-milestones.md
// (commit 2d6ab82) §2.M8 #1677; substrate anchor §7.M8-003; softarch
// companion §4.3.
//
// =============================================================================
// §0  WHAT THIS MODULE IS AND WHAT IT IS DELIBERATELY NOT
// =============================================================================
//
// The design's own dependency graph (§8.2 "R52 gates in M8-001 and
// M8-003") states plainly: "M8-003 depends on R52.M5-003
// (`journal_replay.pdx` on-disk walker). If R52.M5-003 slips, M8-003
// stays open pending its close; the M8 fingerprint set is incomplete
// until then." At this commit (2026-08-23):
//
//   - R52.M5-003 has NOT landed. `src/kernel/core/fs/pdxfs/
//     journal_replay.pdx` in this tree is still the R42.M2-003
//     (#1386) scaffold: an in-memory (BSS) classification walker over
//     the WAL ring's already-resident records. It does not read a
//     single byte off a block device -- design/filesystem/volume-fs-
//     substrate.md:432 names the exact pending work: "R52.M5-003
//     Rewrite journal_replay.pdx to walk on-disk JBNL blocks (replaces
//     BSS scaffold)".
//   - R52.M5-005 (mount syscall backend, `MOUNT_BACKEND_PDXFS_BLOCK`)
//     has ALSO not landed, so there is no real mount/unmount round
//     trip through KIND_BLKDEV in this tree yet either -- only
//     R51.M8-001 (#1675, blkdev_cap_request.pdx) and R51.M8-002
//     (#1676, this file's sibling bdev_barrier.pdx) exist on the R51
//     side of that wire.
//
// Consequence: design's exact 8-step sequence (mount V; snapshot
// D_pre; write 32 records + JOP_COMMIT; unmount with a final FLUSH;
// remount; on-disk WAL replay; snapshot D_post; assert D_pre ==
// D_post) is NOT witnessable today. Worse than a missing accessor --
// the invariant's very DEFINITION depends on checkpoint/truncation
// semantics R52.M5-003's real walker owns (a successful replay is
// expected to retire the journal back to a baseline so D_post's WAL-
// head component returns to where D_pre found it; the R42 scaffold
// classifies records but never advances or truncates anything, so
// "replay" in today's substrate can only ever GROW visible WAL state,
// never restore it). Fabricating a full round-trip witness against
// that scaffold would prove a false invariant, not a real one.
//
// What THIS FILE lands instead -- the substrate half that does not
// depend on either gated dependency:
//
//   (1) The design-named failure code (§3 below).
//   (2) `mrd_digest_compute()` -- a digest fold over every mount/
//       journal counter reachable in TODAY's substrate (WAL head +
//       append/fsync counts, the R42 journal-fence commit count, the
//       R42 replay scaffold's last-applied/last-discarded counts, and
//       this M8's own barrier-ring head). This is explicitly NOT the
//       design's "superblock + itable + WAL head + data-region hash"
//       digest -- superblock_read.pdx requires a real mounted volume
//       (R52.M5-005, absent), and neither an itable accessor nor a
//       data-region hash algorithm exists yet. `mrd_digest_compute`
//       is the load-bearing PLACEHOLDER a future widening (once
//       R52.M5-003/M5-005 land) replaces field-for-field without
//       changing this file's comparator or failure code.
//   (3) `mrd_assert_equal(d_pre, d_post)` -- the comparator the real
//       M8-003 witness will call verbatim once step (2)'s digest is
//       widened to the full definition.
//
// The witness in tests/kernel/fs/mount_replay_digest_synth.pdx proves
// (a) the comparator actually discriminates (positive + negative
// probe, mirroring bdev_barrier.pdx's own Stage-A negative-probe
// precedent) and (b) `mrd_digest_compute` is idempotent when called
// twice back-to-back with no intervening state change -- a real,
// buildable prerequisite for the eventual D_pre==D_post invariant,
// and nothing more. It does NOT claim a mount, an unmount, a remount,
// or a replay happened; its fingerprint says so explicitly (STUB).
//
// Re-stamping path: when R52.M5-003 (on-disk walker) and R52.M5-005
// (mount backend) both land, a follow-up widens
// `mrd_digest_compute` to fold in `sb_read`'s validated fields, an
// itable accessor, and a real data-region hash, and replaces the
// stub witness's Stage 2 with the design's literal 8-step sequence
// against `tests/r51/remount-replay.golden`. This file's failure code
// and comparator do not change shape when that happens.
//
// =============================================================================
// §1  DIGEST FOLD -- NOT CRYPTOGRAPHIC, ORDER-SENSITIVE, ZERO-CAPABILITY
// =============================================================================
//
// `mrd_digest_compute` takes no capability and touches no cap_table
// row: every input is a zero-argument, capability-free accessor
// (`wal_head`, `wal_append_count`, `wal_fsync_count`,
// `jfn_commit_count`, `jrp_last_applied`, `jrp_last_discarded`,
// `bbar_head`) already landed by R42.M2 (#1384-#1386) and R51.M8-002
// (#1676). Each is folded via rotate-left-1 (emulated with shift +
// or, per this codebase's no-`rol` posture -- see fs/pdxfs_lite/
// inode.pdx's `inode_checksum` for the precedent this file mirrors)
// followed by XOR, so the fold is order-sensitive (swapping two
// inputs changes the result) without needing a multiply.
//
// =============================================================================
// §2  ONE WRITER OF NOTHING -- THIS MODULE OWNS NO STATE
// =============================================================================
//
// Unlike wal.pdx/journal_fence.pdx/journal_replay.pdx/bdev_barrier.pdx,
// this module declares no `.bss` state of its own. Both functions are
// pure: `mrd_digest_compute` only reads other modules' already-owned
// state via their public accessors; `mrd_assert_equal` only compares
// its two arguments. There is nothing here for a second writer to
// race.
//
// =============================================================================
// §3  FAILURE TAXONOMY -- CLAIMS 0xFFFFECE4 FROM THE MOUNTW BAND
// =============================================================================
//
// MOUNTW band is 0xFFFFECE0..0xFFFFECEF (design §7 file-layout table:
// "MOUNTW (mount/journal/remount/hot-remove witnesses), M8-001..M8-
// 003, M8-005"). Already claimed: 0xFFFFECE0/E1/E2/E7/E8 by R51.M8-001
// (#1675, blkdev_cap_request.pdx); 0xFFFFECE3/E5/E6/E9 by R51.M8-002
// (#1676, bdev_barrier.pdx). This file claims exactly the one slot
// the design doc names for M8-003:
//
//   MOUNTW_REMOUNT_DIGEST_MISMATCH = 0xFFFFECE4   design-named
//                                     (§2.M8 #1677): mrd_assert_equal
//                                     finds d_pre != d_post.
//
// 0xFFFFECEA..EF remain free within this band for a future M8 issue.
//
// Reserved-label discipline (`loop`/`if` etc. are keywords): every
// label in this file is prefixed `mrd_`.
//
// =============================================================================
// paideia-as encoder-gap posture (v0.22.x)
// =============================================================================
//
//   G4: the one sentinel-valued return (MOUNTW_REMOUNT_DIGEST_MISMATCH,
//       bit 31 set) is materialised via `mov rax, <imm64>` (the proven
//       B8+rd-iw-style full-width form every other sentinel-returning
//       leaf in this tree uses, e.g. bdev_barrier.pdx's bbjw_violation)
//       -- never as a `cmp`/`jcc` immediate operand, so no imm32 sign-
//       extension risk exists here in the first place.
//   No `rol`/`ror`: rotate-left-1 is emulated via `shr`+`shl`+`or`,
//       matching fs/pdxfs_lite/inode.pdx's `inode_checksum` and
//       apic/vector_pool.pdx's documented avoidance of `rol`.
//   No `imul`: the fold uses only xor/shl/shr/or, no multiply at all.

module MountReplayDigest = structure {

  pub let MOUNTW_REMOUNT_DIGEST_MISMATCH : u64 = 0xFFFFECE4

  // ==========================================================================
  // mrd_digest_compute() -> u64
  //
  // Folds seven zero-argument, capability-free accessors (wal_head,
  // wal_append_count, wal_fsync_count, jfn_commit_count,
  // jrp_last_applied, jrp_last_discarded, bbar_head) into one u64.
  // First value seeds the accumulator directly; every subsequent value
  // rotates the running accumulator left by 1 (shift+or, no `rol`)
  // before XOR-ing the new value in, so the fold is sensitive to which
  // accessor contributed which value.
  //
  // One callee-save push (rbx, the running accumulator) leaves
  // rsp%16==0 for each of the seven nested calls (entry rsp%16==8,
  // 1*8=8 -> 16, %16==0 -- no pad needed, matching bdev_barrier.pdx's
  // own bdev_barrier_flush single-push shape).
  // ==========================================================================
  pub let mrd_digest_compute : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R51.M8-003 (#1677) substrate stub: fold seven capability-free accessors into one u64. One callee-save push (rbx) leaves rsp%16==0 per this function's own header note. First call seeds rbx directly (mov rbx, rax); each subsequent call rotates rbx left by 1 via r9 = rbx >> 63 (shr), rbx <<= 1 (shl), rbx |= r9 (or), then XORs the new accessor's rax in. r9 is caller-save scratch, reloaded fresh after every call so it never needs to survive a call itself. Final fold value moved to rax before the single pop+ret. Labels: none (straight-line, no branches). No capability, no cap_table touch.",
      block: {
        push rbx;

        call wal_head;
        mov rbx, rax;

        call wal_append_count;
        mov r9, rbx;
        shr r9, 63;
        shl rbx, 1;
        or  rbx, r9;
        xor rbx, rax;

        call wal_fsync_count;
        mov r9, rbx;
        shr r9, 63;
        shl rbx, 1;
        or  rbx, r9;
        xor rbx, rax;

        call jfn_commit_count;
        mov r9, rbx;
        shr r9, 63;
        shl rbx, 1;
        or  rbx, r9;
        xor rbx, rax;

        call jrp_last_applied;
        mov r9, rbx;
        shr r9, 63;
        shl rbx, 1;
        or  rbx, r9;
        xor rbx, rax;

        call jrp_last_discarded;
        mov r9, rbx;
        shr r9, 63;
        shl rbx, 1;
        or  rbx, r9;
        xor rbx, rax;

        call bbar_head;
        mov r9, rbx;
        shr r9, 63;
        shl rbx, 1;
        or  rbx, r9;
        xor rbx, rax;

        mov rax, rbx;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // mrd_assert_equal(d_pre, d_post) -> u64
  //
  // 0 iff d_pre == d_post; else MOUNTW_REMOUNT_DIGEST_MISMATCH. Pure
  // reg-reg comparison -- no immediate operand to a cmp/jcc anywhere,
  // so no G4 staging is needed here; the sentinel return is a plain
  // `mov rax, imm64` (proven full-width form, see file header).
  // ==========================================================================
  pub let mrd_assert_equal : (u64, u64) -> u64 !{} @{} =
    fn (d_pre: u64) (d_post: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R51.M8-003 (#1677) substrate stub: cmp rdi, rsi; je mrd_ae_ok; mov rax, 0xFFFFECE4 (MOUNTW_REMOUNT_DIGEST_MISMATCH); ret. mrd_ae_ok: xor rax, rax; ret. Leaf, no callee-save needed. Labels prefixed mrd_ae_.",
      block: {
        cmp rdi, rsi;
        je  mrd_ae_ok;
        mov rax, 0xFFFFECE4;
        ret;
      mrd_ae_ok:
        xor rax, rax;
        ret
      }
    }
}
