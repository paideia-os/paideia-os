// src/kernel/core/cap/cap_handler_blkdev.pdx -- R51.M3-003 (#1647).
//
// R51.M6-002 (#1664) ADDENDUM: the AHCI READ_LBA/WRITE_LBA branch
// (`hblk_do_rw_ahci`, wired by R51.M5-006/#1662's family-byte demux
// below) dispatched to a hard-coded `0xEEEE` stub of
// `ahci_io_submit_rw` at M5-006 close.  #1664 replaces that stub with
// a real implementation in the new drivers/ahci/io_submit.pdx (design/
// hardware/nvme-ahci-tail-milestones.md §2.M6 #1664) -- the stub
// definition is removed from kind_ahci_port.pdx and `hblk_do_rw_ahci`
// now maps the real AHCIIO_* failure band (0xFFFFECA2..0xFFFFECA9,
// io_submit.pdx SECTION 3) verbatim instead of the single `0xEEEE`
// placeholder check.  WRITE_LBA (opcode 1) still reaches the same
// call; `ahci_io_submit_rw` itself refuses opcode==1 with
// `AHCIIO_SUBMIT_WRITE_UNIMPL` (deferred to #1665) -- no separate
// WRITE stub is needed in this file.
//
// R51.M6-004 (#1666) ADDENDUM: `hblk_op_flush` now splits on family
// (design/hardware/nvme-ahci-tail-milestones.md §2.M6 #1666) --
// family==2 (AHCI) dispatches to the new drivers/ahci/reliability.pdx
// `ahci_flush(port_row_id)` (FLUSH_CACHE_EXT, 0xEA) instead of falling
// through to the NVMe-only `nvme_io_submit_flush` path this branch
// used unconditionally before. `hblk_op_features_ahci` also changes:
// instead of returning 0 unconditionally, it now packs
// BDEV_FEATURE_FLUSH_SUPPORTED (bit 0, unconditional on AHCI) and
// BDEV_FEATURE_WRITE_CACHE_PRESENT (bit 3, from the port row's new
// `ahci_port_row_write_cache_present` accessor, kind_ahci_port.pdx).
// RESIDUAL GAP (flagged to softarch/debugger review, carried forward
// from #1651's own precedent for the NVMe side): `ahci_port_
// blk_rights_valid` (kind_ahci_port.pdx, R51.M5-006/#1662) still
// enforces a 0x07 rights subset for the KIND_BLKDEV half of the
// dual-kind mint, so no AHCI-family KIND_BLKDEV cap can carry
// R_BLK_FLUSH (0x08) today -- the rights check at the top of
// `hblk_op_flush` denies every AHCI-family FLUSH request before
// `hblk_op_flush_ahci` is ever reached. R51.M7-002/#1670 ("Rights
// extension R_BLK_FLUSH + R_BLK_TRIM") is the design-scoped future
// milestone that widens that gate; #1666's own scope (design §2.M6
// #1666) does not touch it.
//
// R51.M6-005 (#1667) ADDENDUM: `hblk_op_trim` now splits on family
// (design/hardware/nvme-ahci-tail-milestones.md §2.M6 #1667), mirroring
// #1666's own FLUSH split above -- family==2 (AHCI) dispatches to the
// new `hblk_op_trim_ahci` branch, which calls
// drivers/ahci/reliability.pdx's `ahci_trim(port_row_id,
// lba_range_iova, range_count)` (DATA SET MANAGEMENT, 0x06, TRIM bit,
// DRAT-gated) instead of falling through to the NVMe-only
// `nvme_io_submit_trim` path this branch used unconditionally before.
// SAME RESIDUAL GAP as FLUSH above: `ahci_port_blk_rights_valid`
// still enforces a 0x07 rights subset, so no AHCI-family KIND_BLKDEV
// cap can carry R_BLK_TRIM (0x10) today either -- the rights check at
// the top of `hblk_op_trim` denies every AHCI-family TRIM request
// before `hblk_op_trim_ahci` is ever reached. R51.M7-002/#1670 widens
// that gate for both bits at once; #1667's own scope (design §2.M6
// #1667) does not touch it -- landed now, exactly as #1666 argued for
// FLUSH, so #1670 only has to touch the mint-gate subset check, not
// invent the TRIM dispatch path too.
//
// KIND_BLKDEV (0x42, R24) BDEV_OP_* dispatcher.  design/hardware/
// nvme-io-queues.md §3.5 names this handler "cap_handler_blkdev" and
// puts it in a file called kind_blkdev_dispatch.pdx; the issuing task
// for #1647 explicitly names the file cap_handler_blkdev.pdx instead --
// followed here verbatim (a resolved naming gap between the design doc
// and the issue instructions; the FUNCTION name and dispatch shape are
// otherwise identical to the design).
//
// KIND_BLKDEV rides the R24 blkdev_cap.pdx base slot (KIND_PAGE=4,
// derived tag 0x42).  A cap of this kind is reached three ways at R51:
//   - the legacy R24 mint-gate-only path (blkdev_cap.pdx), never
//     stamped into a live descriptor at R24 (deferred to #1015);
//   - the R51.M2 dual-kind mint (kind_nvme_namespace.pdx
//     nvme_ns_dual_kind_mint) -- the SAME `_nvme_namespace_table` row
//     reachable through both a KIND_NVME_NAMESPACE (0x199) descriptor
//     and a KIND_BLKDEV (0x42) descriptor, both carrying target_ptr =
//     row_id, family byte ([23:16]) = 0 (LEGACY_NVME) or left as
//     whatever the M2 mint stamped (reads as family 0 under the demux
//     below -- see design §4.5's backward-compatibility note);
//   - the R51.M5-006 dual-kind mint (kind_ahci_port.pdx
//     ahci_port_dual_kind_mint) -- the SAME `_ahci_port_table` row
//     reachable through both a KIND_AHCI_PORT (0x19B) descriptor and
//     a KIND_BLKDEV (0x42) descriptor, target_ptr = row_id with
//     family byte ([23:16]) = 2 (AHCI).
// target_ptr[15:0] is read here as a row_id into WHICHEVER table the
// family byte (target_ptr[23:16]) names -- see the family-byte demux
// below (R51.M5-006, #1662, design §5).
//
// Op-arg encoding (design §3.5).  `op_arg` (rdx) packs:
//   bits [7:0]    op_code       (BDEV_OP_*, 0..6)
//   bits [11:8]   reserved      -- MUST be 0, else BDEV_ERR_BAD_ARG
//   bits [63:12]  page_number   -- descriptor-page physical/IOVA
//                                  address (page-aligned) for the
//                                  READ_LBA / WRITE_LBA arg spill
//
// Family-byte demux (R51.M5-006, #1662, design §5).  target_ptr packs:
//   bits [15:0]   row_id        (unchanged from R51.M2/M3)
//   bits [23:16]  family        0 = LEGACY_NVME, 1 = NVME, 2 = AHCI
//   bits [63:24]  reserved      -- MUST be 0, else BDEV_ERR_BAD_FAMILY
// family in {0,1} routes to the pre-existing NVMe branch (row_id names
// a `_nvme_namespace_table` row); family == 2 routes to the AHCI
// branch (row_id names a `_ahci_port_table` row, kind_ahci_port.pdx).
// A family value > 2, or any reserved bit [63:24] set, is refused with
// BDEV_ERR_BAD_FAMILY before any op dispatch runs.
//
// Descriptor page (only consulted by READ_LBA / WRITE_LBA):
//   +0    lba        (u64)
//   +8    nblocks    (u64)
//   +16   dma_iova   (u64)   caller-programmed DMA-domain IOVA
//   +24   status_out (u64)   written back with nvme_io_submit_rw's
//                            raw return value (bytes-transferred on
//                            OK, or one of its error sentinels)
//
// Op table (design §3.5, extended at R51.M4-001 #1651 and R51.M4-002
// #1652 -- see design/hardware/nvme-oncs-reliability.md §4.1):
//   BDEV_OP_QUERY_GEOM     = 0   R_BLK_READ | R_BLK_ADMIN (both)
//   BDEV_OP_QUERY_FAMILY   = 1   any non-zero rights
//   BDEV_OP_QUERY_FEATURES = 2   any non-zero rights; ONCS-driven bitmap
//                                (R51.M4-001, #1651 -- see hblk_op_features)
//   BDEV_OP_READ_LBA       = 3   R_BLK_READ            (#1647, this file)
//   BDEV_OP_WRITE_LBA      = 4   R_BLK_WRITE           (shared path;
//                                                        #1648 witness)
//   BDEV_OP_FLUSH          = 5   R_BLK_FLUSH -> nvme_io_submit_flush
//                                (family in {0,1}, R51.M4-001, #1651)
//                                or ahci_flush (family==2, R51.M6-004,
//                                #1666, drivers/ahci/reliability.pdx)
//   BDEV_OP_TRIM           = 6   R_BLK_TRIM -> nvme_io_submit_trim
//                                (family in {0,1}, R51.M4-002, #1652,
//                                 this file + companion nvme_reliability.pdx)
//                                or ahci_trim (family==2, R51.M6-005,
//                                #1667, drivers/ahci/reliability.pdx)
//   anything else                              -> BDEV_ERR_BAD_ARG
//
// Design-doc gaps resolved in this commit:
//   - §3.5 does not give BDEV_ERR_* numeric values.  This file claims
//     a fresh disjoint band 0xFFFFEC60..0xFFFFEC6F (one slot past
//     R51.M3's NVMEIO_* band 0xFFFFEC50..0xFFFFEC5F declared in
//     nvme_io_queues.pdx) so no debugger failure-code lookup ambiguity
//     arises between the two new R51.M3 files.  Rights-check denial
//     reuses the shared INVOKE_DENIED sentinel (0xFFFFFFFFFFFFFFFD,
//     cap/invoke.pdx) matching cap_handler_nvme_controller's own
//     precedent for a rights-check failure.
//   - R51.M4-001 (#1651): op 5 (FLUSH) now requires R_BLK_FLUSH (0x08,
//     blkdev_cap.pdx, widened alongside R_BLK_ALL -> 0x1F this same
//     commit) and dispatches into nvme_reliability.pdx's
//     nvme_io_submit_flush after resolving ctrl_row_id via
//     nvme_ns_row_parent (same forwarder chain hblk_do_rw already uses).
//   - R51.M4-002 (#1652): op 6 (TRIM) now requires R_BLK_TRIM (0x10,
//     blkdev_cap.pdx) and dispatches into nvme_reliability.pdx's
//     nvme_io_submit_trim after resolving ctrl_row_id via
//     nvme_ns_row_parent (same forwarder chain the FLUSH/READ/WRITE
//     branches already use).  range_count/dsm_desc_iova/flags are read
//     directly from the descriptor page (+0/+8/+16, design §4.3)
//     rather than staged in a register across the nvme_ns_row_parent
//     call -- the descriptor page address (r14) is callee-save and
//     survives that call untouched, so the three fields are simply
//     re-read from memory immediately before the nvme_io_submit_trim
//     call rather than spilled anywhere else.  Design §4.1's
//     namespace-mint-side gate (kind_nvme_namespace.pdx's own
//     R_BLK_ALL_TAG = 0x07) is untouched per the design doc's explicit
//     "0 lines" call for that file (§1 file-touch table) -- flagged as
//     a residual gap in the commit report: a dual-kind KIND_BLKDEV cap
//     minted through nvme_ns_dual_kind_mint cannot yet request
//     R_BLK_FLUSH/R_BLK_TRIM, since that mint gate's own subset check
//     still rejects bits outside 0x07.
//   - R51.M6-004 (#1666): op 5 (FLUSH) now splits on family (r15).
//     family==2 (AHCI) dispatches to hblk_op_flush_ahci ->
//     drivers/ahci/reliability.pdx's ahci_flush(port_row_id)
//     (FLUSH_CACHE_EXT, 0xEA) -- a single-arg call (ahci_flush
//     resolves its own parent controller internally), unlike the
//     NVMe branch's two-arg nvme_io_submit_flush(ctrl_row_id,
//     ns_row_id). family in {0,1} keeps the pre-existing NVMe path
//     unchanged. QUERY_FEATURES' AHCI branch (hblk_op_features_ahci)
//     similarly changes from an unconditional 0 to a real bitmap:
//     bit0 (FLUSH_SUPPORTED) unconditional, bit3 (WRITE_CACHE_PRESENT)
//     from the port row's new ahci_port_row_write_cache_present
//     accessor (kind_ahci_port.pdx). The AHCI dual-kind mint gate
//     (ahci_port_blk_rights_valid) is left untouched by this commit --
//     same residual-gap posture as the NVMe-side bullet immediately
//     above, deferred to R51.M7-002/#1670 (see this file's own header
//     addendum for the full note).
//   - R51.M6-005 (#1667): op 6 (TRIM) now also splits on family (r15),
//     mirroring the FLUSH split immediately above. family==2 (AHCI)
//     dispatches to hblk_op_trim_ahci -> drivers/ahci/reliability.pdx's
//     ahci_trim(port_row_id, lba_range_iova, range_count) (DATA SET
//     MANAGEMENT, 0x06, TRIM bit, DRAT-gated) -- a three-arg call
//     (ahci_trim resolves its own parent controller internally, like
//     ahci_flush); lba_range_iova and range_count are read from the
//     descriptor page's +8/+0 slots (the same dsm_desc_iova/range_count
//     fields the NVMe branch already reads -- design's op-arg encoding
//     is family-agnostic). family in {0,1} keeps the pre-existing NVMe
//     path unchanged. Same residual-gap posture as FLUSH: the AHCI
//     dual-kind mint gate still refuses R_BLK_TRIM to an AHCI-family
//     cap, deferred to R51.M7-002/#1670.
//   - §3.3's "bytes = raw status" / "bytes = 0xEEEE" / "bytes = 0xE001"
//     / "bytes = 0xE002" phrasing (nvme-io-queues.md, resolved in that
//     file's own header) means nvme_io_submit_rw's return value is
//     overloaded between "byte count" (success) and a small handful of
//     named sentinels (failure).  This handler forwards that raw value
//     into the descriptor page's status_out field unconditionally, and
//     maps its OWN return value to 0 (success) unless the raw value
//     exactly matches one of the known sentinels, in which case it
//     forwards the sentinel verbatim as this handler's return too.
//
// =============================================================================
// paideia-as encoder-gap posture (v0.22.x)
// =============================================================================
//
//   G1: sized loads via xor <reg>,<reg>; mov_b for the qid/state-style
//       sub-8-byte fields are not needed in this file (every SQE/CQE
//       byte access lives in nvme_io_queues.pdx); all loads/stores here
//       are plain 64-bit words.
//   G4: full-register compares throughout; every sentinel comparison
//       against a value with bit 63/31 set is staged through
//       `mov r10, <imm>; cmp reg, r10` rather than `cmp reg, <imm>`
//       directly (imm32 operands to cmp sign-extend; a bare `cmp rax,
//       0xFFFFEC5X` would compare against 0xFFFFFFFFFFFFEC5X instead).
//
// Reserved-label discipline (`loop`/`if` etc. are keywords): every
// label in this file is prefixed `hblk_`.

module CapHandlerBlkdev = structure {

  pub let BDEV_OP_QUERY_GEOM     : u64 = 0
  pub let BDEV_OP_QUERY_FAMILY   : u64 = 1
  pub let BDEV_OP_QUERY_FEATURES : u64 = 2
  pub let BDEV_OP_READ_LBA       : u64 = 3
  pub let BDEV_OP_WRITE_LBA      : u64 = 4
  pub let BDEV_OP_FLUSH          : u64 = 5
  pub let BDEV_OP_TRIM           : u64 = 6

  pub let BDEV_ERR_OK           : u64 = 0
  pub let BDEV_ERR_BAD_ARG      : u64 = 0xFFFFEC60
  pub let BDEV_ERR_UNSUPPORTED  : u64 = 0xFFFFEC61
  pub let BDEV_ERR_BAD_ROW      : u64 = 0xFFFFEC62
  // R51.M5-006 (#1662): family byte (target_ptr[23:16], design §4.5)
  // out of range ({0,1,2}) OR reserved bits target_ptr[63:24] set.
  pub let BDEV_ERR_BAD_FAMILY   : u64 = 0xFFFFEC63

  // R51.M4-001 (#1651) BDEV_OP_QUERY_FEATURES bit-field extension
  // (design §4.5) -- bits 0/1/2 are ONCS-derived, bits 3/4 unconditional
  // at M4 (see hblk_op_features).
  pub let BDEV_FEATURE_FLUSH_SUPPORTED         : u64 = 0x1
  pub let BDEV_FEATURE_TRIM_SUPPORTED          : u64 = 0x2
  pub let BDEV_FEATURE_WRITE_ZEROES_SUPPORTED  : u64 = 0x4
  pub let BDEV_FEATURE_WRITE_CACHE_PRESENT     : u64 = 0x8
  pub let BDEV_FEATURE_SMART_AVAILABLE         : u64 = 0x10

  // ==========================================================================
  // cap_handler_blkdev(rights, target_ptr, op_arg) -> u64
  //
  // design/hardware/nvme-io-queues.md §3.5.  SysV: rdi=rights,
  // rsi=target_ptr, rdx=op_arg (the cap_invoke_dispatch handler ABI).
  // ==========================================================================
  pub let cap_handler_blkdev : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R51.M3-003 (#1647) + R51.M4-001 (#1651) + R51.M5-006 (#1662) + R51.M6-004 (#1666): KIND_BLKDEV BDEV_OP_* dispatcher. Six callee-save pushes (rbx=rights, rbp=row_id masked to [15:0], r12=op_arg then ctrl_row_id, r13=op_code then reused per-branch, r14=desc_page_addr then reused per-branch, r15=family byte) + sub rsp,8 pad leave rsp%16==0 (entry rsp%16==8 -> 8+48=56 -> sub rsp,8 -> 64, %16==0). Family-byte demux (design §5): target_ptr[23:16] extracted into r15 and validated (family in {0,1,2}; target_ptr[63:24] must be 0) BEFORE any op dispatch, refusing BDEV_ERR_BAD_FAMILY otherwise. Reserved bits op_arg[11:8] checked before dispatch; desc_page_addr = op_arg & ~0xFFF computed unconditionally (only consumed by READ_LBA/WRITE_LBA/FLUSH) via the two-step mov-then-and idiom (AND does not accept a full imm64 operand). QUERY_GEOM requires (rights & (R_BLK_READ|R_BLK_ADMIN)) == that mask, then splits on r15: family==2 (AHCI) calls ahci_port_row_sector_size/_block_count against _ahci_port_table; family in {0,1} calls the pre-existing nvme_ns_row_lba_size/_block_count path unchanged. QUERY_FAMILY returns r15 directly (no row access needed) -- a one-line simplification over the prior nvme_ns_row_family(rbp) call, valid for every family since r15 already IS the validated family byte. QUERY_FEATURES requires rights != 0; family==2 (AHCI, R51.M6-004/#1666) calls ahci_port_row_write_cache_present(rbp), maps its DECODE_BAD to BDEV_ERR_BAD_ROW, packs bit3 (WRITE_CACHE_PRESENT) from that call's 0|1 result shifted left 3 and ORs in bit0 (FLUSH_SUPPORTED) unconditionally (FLUSH_CACHE_EXT is ATA/ACS-2 mandatory -- no per-port register to gate it on); family in {0,1} resolves ctrl_row_id via nvme_ns_row_parent and packs the ONCS-driven bitmap exactly as before. READ_LBA requires R_BLK_READ; WRITE_LBA requires R_BLK_WRITE; TRIM (op 6) requires R_BLK_TRIM (0x10) and now splits on r15 (R51.M6-005/#1667, mirroring the FLUSH split): family==2 (AHCI) jumps to hblk_op_trim_ahci, which reads range_count/dsm_desc_iova from the descriptor page (+0/+8, r14 still holds desc_page_addr) and calls drivers/ahci/reliability.pdx's ahci_trim(rbp, dsm_desc_iova, range_count) (three-arg -- ahci_trim resolves its own parent controller internally, like ahci_flush), writes the raw return to status_out (+24), and maps AHCIREL_TRIM_UNSUP (0xFFFFECB2) / AHCIREL_TRIM_BAD_RANGES (0xFFFFECB3) / AHCIREL_TRIM_TIMEOUT (0xFFFFECB4) / AHCIIO_SUBMIT_TFD_ERR (0xFFFFECA4) / AHCIIO_SUBMIT_NO_SLOT (0xFFFFECA2) / AHCIIO_PORT_NOT_READY (0xFFFFECA6) / AHCIIO_SUBMIT_BAD_ROW (0xFFFFECA9) through verbatim (staged mov-then-cmp per G4), else BDEV_ERR_OK; family in {0,1} keeps the pre-existing nvme_ns_row_parent + nvme_io_submit_trim path unchanged (landed at R51.M4-002/#1652). Same residual-gap posture as FLUSH applies here too: ahci_port_dual_kind_mint's own blk_rights gate (ahci_port_blk_rights_valid, subset of 0x07) still refuses to grant an AHCI-family KIND_BLKDEV cap R_BLK_TRIM today, so the rights check just above already denies every AHCI-family TRIM request before this split is ever reached -- landed now (per #1666's own precedent) so R51.M7-002/#1670 only has to touch the mint-gate subset check. FLUSH (op 5) now splits on r15 (R51.M6-004/#1666) AFTER the same R_BLK_FLUSH rights check (that check still denies every AHCI-family request today per the same blk_rights-gate residual-gap note, deferred to R51.M7-002/#1670 -- landed now so the family-dispatch shape does not have to change again when that gate widens): family==2 (AHCI) jumps to hblk_op_flush_ahci, which calls drivers/ahci/reliability.pdx's ahci_flush(rbp) (single-arg -- ahci_flush resolves its own parent controller internally, unlike the two-arg NVMe call), writes the raw return to status_out (+24), and maps AHCIREL_FLUSH_TIMEOUT (0xFFFFECB0) / AHCIREL_FLUSH_TFD_ERR (0xFFFFECB1) / AHCIIO_SUBMIT_NO_SLOT (0xFFFFECA2) / AHCIIO_PORT_NOT_READY (0xFFFFECA6) / AHCIIO_SUBMIT_BAD_ROW (0xFFFFECA9) through verbatim (staged mov-then-cmp per G4), else BDEV_ERR_OK; family in {0,1} resolves ctrl_row_id via nvme_ns_row_parent and dispatches unchanged to nvme_reliability.pdx's nvme_io_submit_flush, mapping the known NVMEREL_*/NVMEIO_*/BDEV_ERR_BAD_ROW sentinels through verbatim, else BDEV_ERR_OK. READ_LBA and WRITE_LBA funnel into the shared hblk_do_rw block (opcode stashed in r13 before the jmp), which itself splits on r15: family==2 (AHCI) resolves ctrl_row_id via ahci_port_row_parent and dispatches to drivers/ahci/io_submit.pdx's ahci_io_submit_rw (R51.M6-002, #1664 -- replaces the #1662-era 0xEEEE stub), mapping its AHCIIO_* failure band (0xFFFFECA2..0xFFFFECA9) verbatim through the same staged mov-then-cmp idiom, else BDEV_ERR_OK; family in {0,1} keeps the pre-existing nvme_ns_row_parent + nvme_io_submit_rw path unchanged. Every DECODE_BAD (0xFFFFFFFFFFFFFFFF) row-accessor return maps to BDEV_ERR_BAD_ROW regardless of family. Labels prefixed hblk_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;
        sub rsp, 8;

        mov rbx, rdi;                    // rights
        mov rbp, rsi;
        mov r10, 0xFFFF;
        and rbp, r10;                    // row_id (target_ptr[15:0])
        mov r12, rdx;                    // op_arg

        // R51.M5-006 (#1662): family-byte demux (design §5.2).
        // Extract + validate target_ptr[23:16] BEFORE any op
        // dispatch; family must be in {0,1,2} and reserved bits
        // target_ptr[63:24] must be zero.
        mov r15, rsi;
        shr r15, 16;
        and r15, 0xFF;                   // family
        cmp r15, 2;
        ja  hblk_bad_family;
        mov rax, rsi;
        shr rax, 24;
        cmp rax, 0;
        jne hblk_bad_family;

        mov r13, r12;
        and r13, 0xFF;                   // op_code

        mov r10, r12;
        shr r10, 8;
        and r10, 0xF;                    // reserved bits [11:8]
        cmp r10, 0;
        jne hblk_bad_arg;

        mov r14, r12;
        mov r10, 0xFFFFFFFFFFFFF000;
        and r14, r10;                    // desc_page_addr (page-aligned)

        cmp r13, 0;
        je  hblk_op_geom;
        cmp r13, 1;
        je  hblk_op_family;
        cmp r13, 2;
        je  hblk_op_features;
        cmp r13, 3;
        je  hblk_op_read;
        cmp r13, 4;
        je  hblk_op_write;
        cmp r13, 5;
        je  hblk_op_flush;
        cmp r13, 6;
        je  hblk_op_trim;
        jmp hblk_bad_arg;

      hblk_op_geom:
        mov r10, rbx;
        and r10, 0x5;                    // R_BLK_READ | R_BLK_ADMIN
        mov r11, 0x5;
        cmp r10, r11;
        jne hblk_denied;

        cmp r15, 2;                      // family == AHCI?
        je  hblk_op_geom_ahci;

        mov rdi, rbp;
        call nvme_ns_row_lba_size;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  hblk_bad_row;
        mov r12, rax;                    // lba_size (r12 callee-save; op_arg no longer needed)

        mov rdi, rbp;
        call nvme_ns_row_block_count;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  hblk_bad_row;

        mov r10, 0xFFFFFFFF;
        and rax, r10;                    // block_count[31:0]
        mov rcx, r12;
        shl rcx, 32;
        or  rax, rcx;                    // (lba_size << 32) | block_count[31:0]
        jmp hblk_out;

      hblk_op_geom_ahci:
        mov rdi, rbp;
        call ahci_port_row_sector_size;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  hblk_bad_row;
        mov r12, rax;                    // sector_size (r12 callee-save)

        mov rdi, rbp;
        call ahci_port_row_block_count;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  hblk_bad_row;

        mov r10, 0xFFFFFFFF;
        and rax, r10;                    // block_count[31:0]
        mov rcx, r12;
        shl rcx, 32;
        or  rax, rcx;                    // (sector_size << 32) | block_count[31:0]
        jmp hblk_out;

      hblk_op_family:
        cmp rbx, 0;
        je  hblk_denied;
        mov rax, r15;                    // family byte (no row access needed)
        jmp hblk_out;

      hblk_op_features:
        cmp rbx, 0;
        je  hblk_denied;

        cmp r15, 2;                      // family == AHCI?
        je  hblk_op_features_ahci;

        mov rdi, rbp;                    // ns_row
        call nvme_ns_row_parent;         // -> ctrl_row_id
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  hblk_bad_row;
        mov r13, rax;                    // ctrl_row_id (r13 reused; op_code no longer needed)

        mov rdi, r13;
        call nvme_ctrl_row_oncs;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  hblk_bad_row;
        mov r14, rax;                    // oncs (r14 reused; desc_page_addr no longer needed)

        mov rax, r14;
        and rax, 0x1;                    // ONCS[0] -> bit0 FLUSH_SUPPORTED

        mov r10, r14;
        shr r10, 2;
        and r10, 0x1;
        shl r10, 1;                      // ONCS[2] -> bit1 TRIM_SUPPORTED
        or  rax, r10;

        mov r10, r14;
        shr r10, 3;
        and r10, 0x1;
        shl r10, 2;                      // ONCS[3] -> bit2 WRITE_ZEROES_SUPPORTED
        or  rax, r10;

        mov r10, 0x8;                    // bit3 WRITE_CACHE_PRESENT (unconditional at M4)
        or  rax, r10;
        mov r10, 0x10;                   // bit4 SMART_AVAILABLE (unconditional at M4)
        or  rax, r10;
        jmp hblk_out;

      hblk_op_features_ahci:
        // R51.M5-006 (#1662) + R51.M6-004 (#1666): AHCI ports have no
        // ONCS-equivalent register to read; BDEV_FEATURE_FLUSH_SUPPORTED
        // (bit 0) is unconditional on AHCI (FLUSH_CACHE_EXT is
        // ATA/ACS-2 mandatory -- design §2.M6 #1666);
        // BDEV_FEATURE_WRITE_CACHE_PRESENT (bit 3) is read from the
        // port row via ahci_port_row_write_cache_present
        // (kind_ahci_port.pdx, defaults to 1 -- IDENTIFY word-82 bit-5
        // is not yet stashed anywhere). TRIM/WRITE_ZEROES bits (1/2)
        // stay clear until #1667+ lands DRAT parsing.
        mov rdi, rbp;                    // port_row
        call ahci_port_row_write_cache_present;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  hblk_bad_row;
        shl rax, 3;                      // -> bit3 WRITE_CACHE_PRESENT
        mov r10, 0x1;                    // bit0 FLUSH_SUPPORTED, unconditional
        or  rax, r10;
        jmp hblk_out;

      hblk_op_read:
        mov r10, rbx;
        and r10, 0x1;                    // R_BLK_READ
        cmp r10, 0x1;
        jne hblk_denied;
        mov r13, 2;                      // opcode = NVME_SYNC_OPC_READ (reuse r13)
        jmp hblk_do_rw;

      hblk_op_write:
        mov r10, rbx;
        and r10, 0x2;                    // R_BLK_WRITE
        cmp r10, 0x2;
        jne hblk_denied;
        mov r13, 1;                      // opcode = NVME_SYNC_OPC_WRITE (reuse r13)
        jmp hblk_do_rw;

      hblk_op_flush:
        mov r10, rbx;
        and r10, 0x8;                    // R_BLK_FLUSH
        cmp r10, 0x8;
        jne hblk_denied;

        // R51.M6-004 (#1666): family split. NOTE (residual gap, see
        // drivers/ahci/reliability.pdx SECTION 2): ahci_port_dual_
        // kind_mint's own blk_rights gate (ahci_port_blk_rights_valid,
        // subset of 0x07) still refuses to grant R_BLK_FLUSH to an
        // AHCI-family KIND_BLKDEV cap, so the rights check just above
        // already denies every AHCI-family FLUSH request before this
        // split is ever reached -- R51.M7-002/#1670 is the scoped
        // future milestone that widens that gate. This branch is
        // landed now so #1670 only has to touch the mint-gate check.
        cmp r15, 2;                      // family == AHCI?
        je  hblk_op_flush_ahci;

        mov rdi, rbp;                    // ns_row
        call nvme_ns_row_parent;         // -> ctrl_row_id
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  hblk_bad_row;
        mov r13, rax;                    // ctrl_row_id (r13 reused; op_code no longer needed)

        mov rdi, r13;                    // ctrl_row_id
        mov rsi, rbp;                    // ns_row
        call nvme_io_submit_flush;

        mov [r14 + 24], rax;             // status_out (r14 still holds desc_page_addr)

        mov r10, rax;
        mov r11, 0xFFFFEC70;             // NVMEREL_FLUSH_UNSUP
        cmp r10, r11;
        je  hblk_flush_is_err;
        mov r11, 0xFFFFEC62;             // BDEV_ERR_BAD_ROW
        cmp r10, r11;
        je  hblk_flush_is_err;
        mov r11, 0xFFFFEC58;             // NVMEIO_PICK_NONE
        cmp r10, r11;
        je  hblk_flush_is_err;
        mov r11, 0xFFFFEC56;             // NVMEIO_SUBMIT_TIMEOUT
        cmp r10, r11;
        je  hblk_flush_is_err;
        mov r11, 0xFFFFEC57;             // NVMEIO_SUBMIT_CQE_ERR
        cmp r10, r11;
        je  hblk_flush_is_err;

        xor rax, rax;                    // BDEV_ERR_OK
        jmp hblk_out;

      hblk_flush_is_err:
        mov rax, r10;                    // forward the NVMEREL_*/NVMEIO_*/BDEV_ERR_BAD_ROW verbatim
        jmp hblk_out;

      hblk_op_flush_ahci:
        // R51.M6-004 (#1666): dispatch to drivers/ahci/reliability.pdx's
        // ahci_flush(port_row_id) (FLUSH_CACHE_EXT, 0xEA). Unlike the
        // READ/WRITE branches, no ctrl_row_id resolution happens here
        // -- ahci_flush resolves its own parent controller (for
        // abar_pa) internally, matching the design's single-arg
        // ahci_flush(port_row_id) signature.
        mov rdi, rbp;                    // port_row
        call ahci_flush;

        mov [r14 + 24], rax;             // status_out

        mov r10, rax;
        mov r11, 0xFFFFECB0;             // AHCIREL_FLUSH_TIMEOUT (reliability.pdx)
        cmp r10, r11;
        je  hblk_flush_ahci_is_err;
        mov r11, 0xFFFFECB1;             // AHCIREL_FLUSH_TFD_ERR (reliability.pdx)
        cmp r10, r11;
        je  hblk_flush_ahci_is_err;
        mov r11, 0xFFFFECA2;             // AHCIIO_SUBMIT_NO_SLOT (io_submit.pdx)
        cmp r10, r11;
        je  hblk_flush_ahci_is_err;
        mov r11, 0xFFFFECA6;             // AHCIIO_PORT_NOT_READY (io_submit.pdx)
        cmp r10, r11;
        je  hblk_flush_ahci_is_err;
        mov r11, 0xFFFFECA9;             // AHCIIO_SUBMIT_BAD_ROW (io_submit.pdx)
        cmp r10, r11;
        je  hblk_flush_ahci_is_err;

        xor rax, rax;                    // BDEV_ERR_OK
        jmp hblk_out;

      hblk_flush_ahci_is_err:
        mov rax, r10;                    // forward the AHCIREL_*/AHCIIO_* verbatim
        jmp hblk_out;

      hblk_op_trim:
        mov r10, rbx;
        and r10, 0x10;                   // R_BLK_TRIM
        cmp r10, 0x10;
        jne hblk_denied;

        // R51.M6-005 (#1667): family split, mirroring hblk_op_flush's
        // own split above. NOTE (residual gap, see
        // drivers/ahci/reliability.pdx / this file's header addendum):
        // ahci_port_dual_kind_mint's own blk_rights gate (subset of
        // 0x07) still refuses to grant R_BLK_TRIM to an AHCI-family
        // KIND_BLKDEV cap, so the rights check just above already
        // denies every AHCI-family TRIM request before this split is
        // ever reached -- R51.M7-002/#1670 widens that gate.
        cmp r15, 2;                      // family == AHCI?
        je  hblk_op_trim_ahci;

        mov rdi, rbp;                    // ns_row
        call nvme_ns_row_parent;         // -> ctrl_row_id
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  hblk_bad_row;
        mov r13, rax;                    // ctrl_row_id (r13 reused; op_code no longer needed)

        mov rdi, r13;                    // ctrl_row_id
        mov rsi, rbp;                    // ns_row
        mov rdx, [r14 + 0];              // range_count (desc page, still held in r14)
        mov rcx, [r14 + 8];              // dsm_desc_iova
        mov r8,  [r14 + 16];             // flags
        call nvme_io_submit_trim;

        mov [r14 + 24], rax;             // status_out

        mov r10, rax;
        mov r11, 0xFFFFEC71;             // NVMEREL_TRIM_UNSUP
        cmp r10, r11;
        je  hblk_trim_is_err;
        mov r11, 0xFFFFEC72;             // NVMEREL_TRIM_BAD_RANGES
        cmp r10, r11;
        je  hblk_trim_is_err;
        mov r11, 0xFFFFEC73;             // NVMEREL_TRIM_BAD_FLAGS
        cmp r10, r11;
        je  hblk_trim_is_err;
        mov r11, 0xFFFFEC74;             // NVMEREL_TRIM_BAD_IOVA
        cmp r10, r11;
        je  hblk_trim_is_err;
        mov r11, 0xFFFFEC62;             // BDEV_ERR_BAD_ROW
        cmp r10, r11;
        je  hblk_trim_is_err;
        mov r11, 0xFFFFEC58;             // NVMEIO_PICK_NONE
        cmp r10, r11;
        je  hblk_trim_is_err;
        mov r11, 0xFFFFEC56;             // NVMEIO_SUBMIT_TIMEOUT
        cmp r10, r11;
        je  hblk_trim_is_err;
        mov r11, 0xFFFFEC57;             // NVMEIO_SUBMIT_CQE_ERR
        cmp r10, r11;
        je  hblk_trim_is_err;

        xor rax, rax;                    // BDEV_ERR_OK
        jmp hblk_out;

      hblk_trim_is_err:
        mov rax, r10;                    // forward the NVMEREL_*/NVMEIO_*/BDEV_ERR_BAD_ROW verbatim
        jmp hblk_out;

      hblk_op_trim_ahci:
        // R51.M6-005 (#1667): dispatch to drivers/ahci/reliability.pdx's
        // ahci_trim(port_row_id, lba_range_iova, range_count) (DATA SET
        // MANAGEMENT, 0x06, TRIM bit, DRAT-gated). Unlike the NVMe
        // branch, no ctrl_row_id resolution happens here -- ahci_trim
        // resolves its own parent controller (for abar_pa) internally,
        // matching ahci_flush's own single-call-site posture. r14
        // still holds desc_page_addr (op_code no longer needed).
        mov rdi, rbp;                    // port_row
        mov rsi, [r14 + 8];              // dsm_desc_iova (lba_range_iova)
        mov rdx, [r14 + 0];              // range_count
        call ahci_trim;

        mov [r14 + 24], rax;             // status_out

        mov r10, rax;
        mov r11, 0xFFFFECB2;             // AHCIREL_TRIM_UNSUP (reliability.pdx)
        cmp r10, r11;
        je  hblk_trim_ahci_is_err;
        mov r11, 0xFFFFECB3;             // AHCIREL_TRIM_BAD_RANGES (reliability.pdx)
        cmp r10, r11;
        je  hblk_trim_ahci_is_err;
        mov r11, 0xFFFFECB4;             // AHCIREL_TRIM_TIMEOUT (reliability.pdx)
        cmp r10, r11;
        je  hblk_trim_ahci_is_err;
        mov r11, 0xFFFFECA4;             // AHCIIO_SUBMIT_TFD_ERR (io_submit.pdx, reused)
        cmp r10, r11;
        je  hblk_trim_ahci_is_err;
        mov r11, 0xFFFFECA2;             // AHCIIO_SUBMIT_NO_SLOT (io_submit.pdx)
        cmp r10, r11;
        je  hblk_trim_ahci_is_err;
        mov r11, 0xFFFFECA6;             // AHCIIO_PORT_NOT_READY (io_submit.pdx)
        cmp r10, r11;
        je  hblk_trim_ahci_is_err;
        mov r11, 0xFFFFECA9;             // AHCIIO_SUBMIT_BAD_ROW (io_submit.pdx)
        cmp r10, r11;
        je  hblk_trim_ahci_is_err;

        xor rax, rax;                    // BDEV_ERR_OK
        jmp hblk_out;

      hblk_trim_ahci_is_err:
        mov rax, r10;                    // forward the AHCIREL_*/AHCIIO_* verbatim
        jmp hblk_out;

      hblk_do_rw:
        // r13 = opcode (1 or 2), rbp = row_id, r14 = desc_page_addr,
        // r15 = family -- all callee-save, all survive the nested
        // calls below.
        cmp r15, 2;                      // family == AHCI?
        je  hblk_do_rw_ahci;

        mov rdi, rbp;
        call nvme_ns_row_parent;         // -> ctrl_row_id
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  hblk_bad_row;
        mov r12, rax;                    // ctrl_row_id (r12 callee-save)

        mov rax, [r14 + 0];              // lba
        mov r11, [r14 + 8];              // nblocks

        mov rdi, r12;                    // ctrl_row_id
        mov rsi, rbp;                    // ns_row
        mov rdx, r13;                    // opcode
        mov rcx, rax;                    // lba
        mov r8,  r11;                    // nblocks
        mov r9,  [r14 + 16];             // dma_iova
        call nvme_io_submit_rw;

        mov [r14 + 24], rax;             // status_out

        mov r10, rax;
        mov r11, 0xFFFFEC54;             // NVMEIO_STATE_BAD
        cmp r10, r11;
        je  hblk_rw_is_err;
        mov r11, 0xFFFFEC55;             // NVMEIO_SUBMIT_ENOROOM
        cmp r10, r11;
        je  hblk_rw_is_err;
        mov r11, 0xFFFFEC56;             // NVMEIO_SUBMIT_TIMEOUT
        cmp r10, r11;
        je  hblk_rw_is_err;
        mov r11, 0xFFFFEC57;             // NVMEIO_SUBMIT_CQE_ERR
        cmp r10, r11;
        je  hblk_rw_is_err;
        mov r11, 0xFFFFEC58;             // NVMEIO_PICK_NONE
        cmp r10, r11;
        je  hblk_rw_is_err;
        cmp r10, 0xE001;                 // out-of-range LBA (fits imm32, no sign flip)
        je  hblk_rw_is_err;
        cmp r10, 0xE002;                 // MDTS-exceeded transfer
        je  hblk_rw_is_err;
        cmp r10, 0xEEEE;                 // bad opcode (defensive; dispatch above
        je  hblk_rw_is_err;              // already guarantees opcode in {1,2})

        xor rax, rax;                    // BDEV_ERR_OK
        jmp hblk_out;

      hblk_do_rw_ahci:
        // R51.M5-006 (#1662) + R51.M6-002 (#1664): AHCI branch. port
        // row_id (rbp) resolves its parent controller via
        // ahci_port_row_parent (kind_ahci_port.pdx), then dispatches
        // to the real ahci_io_submit_rw (drivers/ahci/io_submit.pdx,
        // #1664 -- replaces the #1662-era 0xEEEE stub).
        mov rdi, rbp;                    // port_row
        call ahci_port_row_parent;       // -> ctrl_row_id
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  hblk_bad_row;
        mov r12, rax;                    // ctrl_row_id (r12 callee-save)

        mov rax, [r14 + 0];              // lba
        mov r11, [r14 + 8];              // nblocks

        mov rdi, r12;                    // ctrl_row_id
        mov rsi, rbp;                    // port_row
        mov rdx, r13;                    // opcode
        mov rcx, rax;                    // lba
        mov r8,  r11;                    // nblocks
        mov r9,  [r14 + 16];             // dma_iova
        call ahci_io_submit_rw;

        mov [r14 + 24], rax;             // status_out

        // R51.M6-002 (#1664): map the AHCIIO_* failure band
        // (drivers/ahci/io_submit.pdx SECTION 3, 0xFFFFECA2..A9)
        // verbatim; anything else is a byte count -> BDEV_ERR_OK.
        mov r10, rax;
        mov r11, 0xFFFFECA2;             // AHCIIO_SUBMIT_NO_SLOT
        cmp r10, r11;
        je  hblk_rw_is_err;
        mov r11, 0xFFFFECA3;             // AHCIIO_SUBMIT_TIMEOUT
        cmp r10, r11;
        je  hblk_rw_is_err;
        mov r11, 0xFFFFECA4;             // AHCIIO_SUBMIT_TFD_ERR
        cmp r10, r11;
        je  hblk_rw_is_err;
        mov r11, 0xFFFFECA5;             // AHCIIO_SUBMIT_PRDT_OVERFLOW
        cmp r10, r11;
        je  hblk_rw_is_err;
        mov r11, 0xFFFFECA6;             // AHCIIO_PORT_NOT_READY
        cmp r10, r11;
        je  hblk_rw_is_err;
        mov r11, 0xFFFFECA7;             // AHCIIO_SUBMIT_BAD_OPCODE
        cmp r10, r11;
        je  hblk_rw_is_err;
        mov r11, 0xFFFFECA8;             // AHCIIO_SUBMIT_WRITE_UNIMPL
        cmp r10, r11;
        je  hblk_rw_is_err;
        mov r11, 0xFFFFECA9;             // AHCIIO_SUBMIT_BAD_ROW
        cmp r10, r11;
        je  hblk_rw_is_err;

        xor rax, rax;                    // BDEV_ERR_OK
        jmp hblk_out;

      hblk_rw_is_err:
        mov rax, r10;                    // forward the NVMEIO_*/sentinel verbatim
        jmp hblk_out;

      hblk_bad_arg:
        mov rax, 0xFFFFEC60;             // BDEV_ERR_BAD_ARG
        jmp hblk_out;

      hblk_bad_row:
        mov rax, 0xFFFFEC62;             // BDEV_ERR_BAD_ROW
        jmp hblk_out;

      hblk_bad_family:
        mov rax, 0xFFFFEC63;             // BDEV_ERR_BAD_FAMILY
        jmp hblk_out;

      hblk_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;     // INVOKE_DENIED (cap/invoke.pdx)

      hblk_out:
        add rsp, 8;
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
