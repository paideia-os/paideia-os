  // ==========================================================================
  // backlight_find_by_key(bl_key) -> row_id | BACKLIGHT_ROW_NONE
  // ==========================================================================

  pub let backlight_find_by_key : (u64) -> u64 !{mem} @{} =
    fn (bl_key: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M5-001 (#1106): the live row holding this device key, or BACKLIGHT_ROW_NONE (0xFF). Linear scan over 4 rows. THE UNIQUENESS TEST §2's second gate needs: two live backlight capabilities over one panel means two compositors with two independent cached levels writing one control surface, and the one that writes last decides. Refuses to match a bl_key of 0 at all, so a fabricated parent cannot collide with, or be found by, the sentinel backlight_parent_key returns for a bad slot. Sentinel is 0xFF because row 0 is a legitimate answer. Leaf. Labels prefixed bl_fk_.",
      block: {
        cmp rdi, 0;
        je  bl_fk_none;
        xor rcx, rcx;
      bl_fk_scan:
        cmp rcx, 4;                      // BACKLIGHT_MAX
        jae bl_fk_none;
        lea r10, [rip + _backlight_table];
        mov r11, rcx;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  bl_fk_next;
        mov rax, [r10 + 8];
        cmp rax, rdi;
        je  bl_fk_hit;
      bl_fk_next:
        add rcx, 1;
        jmp bl_fk_scan;
      bl_fk_hit:
        mov rax, rcx;
        ret;
      bl_fk_none:
        mov rax, 0xFF;                   // BACKLIGHT_ROW_NONE
        ret
      }
    } @no_frame

  // ==========================================================================
  // backlight_row_of_slot(slot) -> row_id | BACKLIGHT_ROW_NONE
  //
  // THE ONE ROUTE FROM A CAPABILITY SLOT TO A ROW. ARITY ONE.
  // ==========================================================================

  pub let backlight_row_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R31.M5-001 (#1106): slot -> row_id, gated on the descriptor being a live KIND_BACKLIGHT. THE ONLY ROUTE IN THE KERNEL FROM ANYTHING TO A BACKLIGHT ROW, and ARITY ONE so the row a caller reaches is the row its capability names. Every function below that touches a brightness_max or a cached level goes through it. Returns BACKLIGHT_ROW_NONE for an out-of-range slot, a null descriptor, a descriptor of any other kind, or a target_ptr naming a dead row. Pure read. Labels prefixed bl_ros_.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r11, 256;
        cmp rdi, r11;
        jae bl_ros_none;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x15a;                  // KIND_BACKLIGHT
        cmp r10, r11;
        jne bl_ros_none;

        mov r12, [rax + 16];
        mov r10, 0xFFFF;
        and r12, r10;                    // row_id

        mov rdi, r12;
        call backlight_tail_valid;
        cmp rax, 0;
        je  bl_ros_none;

        mov rax, r12;
        jmp bl_ros_out;

      bl_ros_none:
        mov rax, 0xFF;                   // BACKLIGHT_ROW_NONE
      bl_ros_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Slot-arity-one resolvers. ARITY ONE, pinned by tools/build.sh.
  // ==========================================================================

  pub let backlight_max_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R31.M5-001 (#1106): brightness_max of the backlight this capability names. ARITY ONE, PINNED BY tools/build.sh. A second parameter -- any second parameter -- is how a caller-supplied ceiling would reach the row: `max_of_slot(slot, default_max)` reads as a convenience and is a way to widen a panel's advertised range; neither is expressible against a one-argument signature. Labels prefixed bl_mos_.",
      block: {
        push r12;
        push r13;
        push r14;
        call backlight_row_of_slot;
        mov r12, rax;
        cmp r12, 0xFF;
        je  bl_mos_bad;
        mov rdi, r12;
        call backlight_row_max;
        jmp bl_mos_out;
      bl_mos_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      bl_mos_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

