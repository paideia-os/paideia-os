  pub let backlight_backend_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R31.M5-001 (#1106): backend ordinal, or BACKLIGHT_DECODE_BAD. ARITY ONE. Labels prefixed bl_bos_.",
      block: {
        push r12;
