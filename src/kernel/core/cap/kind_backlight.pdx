// src/kernel/core/cap/kind_backlight.pdx — R31.M5-001 (#1106)
//
// KIND_BACKLIGHT = 0x15a, derived over KIND_DEVICE (10).
//
// The authority to hold one backlight controller's static identity
// (index, backend, [brightness_min .. brightness_max]) and to be told
// what its most recently reported brightness was.
//
// =============================================================================
// §0  UNITS: BRIGHTNESS IS A DIMENSIONLESS ORDINAL IN [brightness_min,
//     brightness_max]
// =============================================================================
//
// ACPI 6.5 §B.6 permits a backlight to advertise its levels in whatever
// device-local convention its controller likes: an ACPI _BCL table lists
// integers whose meaning is percent (0..100), or per-mille (0..1000), or
// a raw duty cycle (0..255 for an 8-bit PWM, 0..0xFFFF for a 16-bit
// panel), or a DisplayPort AUX 8-bit register (0..255). THIS KIND STORES
// THE ORDINAL. There is no conversion in the module at all --
// comparisons, storage and the report installer are all in ORDINAL, so
// the per-device meaning is preserved verbatim.
//
// The one silent failure this class of controller is prone to is a
// SCALE SUBSTITUTION: a PWM whose range is 0..255 read as a 0..100
// panel would render an 80%-lit screen as fully saturated because 80 is
// less than 255, and vice versa a 0..100 panel read as 0..255 renders
// the maximum brightness as one-tenth of what it should be. The kernel
// cannot know which convention any panel uses -- it is namespace, and
// ring 0 may not read namespace -- so THE ORDINAL IS STORED AS-IS AND
// NEVER INTERPRETED. §4 states what this kind does not do and why the
// interpretation stays in ring 3.
//
// =============================================================================
// §1  STATIC IDENTITY IS AT MINT, DYNAMIC STATE IS INSTALLED
// =============================================================================
//
// Same discipline as `kind_cooling_device.pdx` §1 and `kind_battery.pdx`
// §1. `index`, `backend`, `brightness_min` and `brightness_max` are ROW
// IDENTITY -- they name the physical controller and its unchanging
// control surface -- and are refused to a mint that supplies implausible
// values. The dynamic field (current_brightness, report count) starts at
// BACKLIGHT_LEVEL_NONE and is updated by `backlight_report_install`,
// REACHABLE ONLY THROUGH THE ROUTED ASSESSMENT: capability in, one
// ordinal in, no other parameter.
//
// WHAT `state_max` IS TO A COOLING DEVICE, `brightness_max` IS TO A
// BACKLIGHT. It is set once by the mint and there is no primitive
// anywhere that changes it. A brightness_max that could be raised by a
// caller would let a panel appear to accept levels the firmware never
// advertised (silently blinding an operator on a controller whose
// electronics cannot survive PWM values past a certain duty cycle); a
// brightness_max that could be lowered would let the panel's usable top
// intensity become unreachable.
//
// =============================================================================
// §2  DERIVATION OVER KIND_DEVICE — THE SIXTH TIME THE KIND HALF PROVES
//     NOTHING
// =============================================================================
//
// The gate demands `kind == KIND_DEVICE (10)` carrying `RIGHT_MINT`. As
// with KIND_THERMAL_ZONE, KIND_BATTERY and KIND_COOLING_DEVICE, that
// half discriminates NOTHING on its own: every PCI function in the
// machine is a KIND_DEVICE, and "this device is a backlight" is a
// firmware-namespace fact this ring may not read
// (design/acpi/no-aml-in-kernel.md). The kernel enforces exactly what
// it can:
//
//   * The inherited device key must be NON-ZERO
//     (`BACKLIGHT_MINT_NO_DEVICE`).
//   * NO OTHER LIVE ROW MAY HOLD THAT KEY
//     (`BACKLIGHT_MINT_BL_IN_USE`). One backlight, one capability -- two
//     capabilities for one panel means two compositors writing one
//     control surface, and the one that writes last decides.
//   * The static identity is plausible: index < BACKLIGHT_INDEX_MAX,
//     backend in the small enumeration in §5, brightness_max >
//     brightness_min, brightness_max <= BACKLIGHT_LEVEL_UPPER.
//
// The discrimination this gate does not perform is performed by the
// ring-3 supervisor (the compositor) that walked the namespace, and the
// capability is the record of ITS decision.
//
// =============================================================================
// §3  A GARBAGE BRIGHTNESS REPORT IS DANGEROUS IN BOTH DIRECTIONS
// =============================================================================
//
// A brightness report comes through the compositor, which is the ONE
// holder per issue #1106's "held by compositor only" invariant.
//
//   * A level above brightness_max that is silently CLAMPED hides a bug
//     from the operator and pins the panel at its top intensity
//     regardless of what the report meant to say -- the display works
//     but a compositor computing a fade-out spends its whole ramp at
//     100%.
//   * A level below brightness_min that is silently CLAMPED hides the
//     opposite bug -- the panel drops to its floor level (typically
//     unlit for a PWM, or the minimum readable level for a DPAUX
//     controller) regardless of what the sender intended, and an
//     operator working in a dark room is faced with a black display.
//
// So `backlight_level_valid` refuses anything outside
// `[brightness_min, brightness_max]` INCLUSIVE with
// `BACKLIGHT_IMPLAUSIBLE_LEVEL`, and the report installer counts the
// refusal. NOTHING IS CLAMPED anywhere in this path.
//
// UNLIKE THERMAL_ZONE THERE IS NO TWO-READING CONFIRMATION. A backlight
// report only updates the row's cached view of a level the actuator
// will see again in the next frame.
//
// =============================================================================
// §4  WHAT THIS KIND DOES NOT DO
// =============================================================================
//
//   * NOTHING DRIVES A PANEL. `backlight_report_install` returns
//     BACKLIGHT_OK for any legal level; there is no MMIO or port I/O
//     path in this kind at all. Which level renders as which intensity,
//     and how that level is written to the PWM/DPAUX/ACPI backend, is
//     namespace-level and hardware-level knowledge held by the ring-3
//     compositor that mints the capability.
//   * NOTHING SETS A BRIGHTNESS FROM A THERMAL LEVEL OR A LID EVENT.
//     Those associations are policy, and policy is ring 3's -- see
//     kind_cooling_device.pdx §4 for the analogous refusal on the
//     cooling side.
//   * NOTHING INTERPRETS THE ORDINAL. §0.
//
// =============================================================================
// §5  ENUMERATIONS: BACKEND
// =============================================================================
//
//   0 UNKNOWN     firmware advertised no PWM/DPAUX/ACPI signature the
//                 compositor could translate
//   1 PWM         a pulse-width modulated backlight (LPSS/PWM controller)
//   2 DPAUX       DisplayPort AUX-channel brightness control (eDP panel)
//   3 ACPI        ACPI-mediated _BCM/_BQC methods (older laptops)
//
// The kind stores the ordinal after the compositor's parse. Refused
// rather than mapped to UNKNOWN so 'the firmware advertised something
// we do not understand' and 'the firmware advertised nothing' are
// different facts.
//
// =============================================================================
// §6  NO PORT I/O, NO AML, NO FIRMWARE NAMES
// =============================================================================
//
// This module contains no `in`/`out` and no firmware-bytecode
// identifier. `tools/lint-no-kernel-aml.sh` refuses any kernel
// identifier matching `\baml`, `\bdsdt`, `\bssdt`, `\bacpica`, `\_SB_`
// or `\_SB.`. KIND_BACKLIGHT, backlight_* and _backlight_table match
// none of the six; the `_BCM`/`_BQC`/`_BCL` names above are in comments
// only.
//
// =============================================================================

module KindBacklight = structure {

  // ==========================================================================
  // The tag, and the parent kind.
  // ==========================================================================

  pub let KIND_BACKLIGHT        : u64 = 0x15a  // derived-kind tag (346)
  pub let BACKLIGHT_PARENT_KIND : u64 = 10     // = KIND_DEVICE

  // ==========================================================================
  // §0 / §1 bounds.
  // ==========================================================================

  pub let BACKLIGHT_INDEX_MAX   : u64 = 8       // 0..7 (one panel per display port)
  pub let BACKLIGHT_LEVEL_UPPER : u64 = 65535   // 16-bit PWM covers every panel

  // ==========================================================================
  // §5 backend enumeration.
  // ==========================================================================

  pub let BACKLIGHT_BACKEND_UNKNOWN : u64 = 0
  pub let BACKLIGHT_BACKEND_PWM     : u64 = 1
  pub let BACKLIGHT_BACKEND_DPAUX   : u64 = 2
  pub let BACKLIGHT_BACKEND_ACPI    : u64 = 3
  pub let BACKLIGHT_BACKEND_MAX     : u64 = 3

  // ==========================================================================
  // Rights.
  //
  // R_BACKLIGHT_READ and R_BACKLIGHT_REPORT are the two halves that
  // matter. A monitor needs READ forever; the compositor that pushes
  // brightness reports needs REPORT as well. RIGHT_MINT (0x200) is
  // OUTSIDE the mask: this kind is a leaf. Nothing in the tree derives
  // from a backlight capability.
  // ==========================================================================

  pub let R_BACKLIGHT_READ    : u64 = 0x001
  pub let R_BACKLIGHT_REPORT  : u64 = 0x002
  pub let R_BACKLIGHT_INVOKE  : u64 = 0x008
  pub let R_BACKLIGHT_REVOKE  : u64 = 0x010
  pub let R_BACKLIGHT_OBSERVE : u64 = 0x400
  pub let R_BACKLIGHT_ALL     : u64 = 0x41B

  // ==========================================================================
  // Ops (op_arg[7:0]) and the right each requires.
  //
  //   0 QUERY_INDEX      INVOKE   the row's own backlight index
  //   1 QUERY_BACKEND    INVOKE   backend ordinal (PWM/DPAUX/ACPI/UNKNOWN)
  //   2 QUERY_MIN        INVOKE   brightness_min
  //   3 QUERY_MAX        INVOKE   brightness_max
  //   4 QUERY_CURRENT    READ     last reported level, 0xFFFF if none
  //   5 QUERY_REPORTS    INVOKE   report count, lifetime
  //   6 QUERY_PARENT     INVOKE   the parent KIND_DEVICE slot
  //   7 DEBUG_PRINT      OBSERVE  canonical row dump
  //   8 REPORT           REPORT   push {current_brightness}
  //
  // REPORT packs one value in op_arg:
  //   op_arg[7:0]   = op = 8
  //   op_arg[23:8]  = current_brightness (16 bits)
  //   op_arg[63:24] = reserved, MUST be zero
  //
  // The reserved field is REFUSED with BACKLIGHT_TAIL_BAD_ARG rather
  // than masked, for the reason kind_cooling_device's REPORT reserved
  // is: forty free bits on an op that reaches the row's cached
  // brightness is where a second value would be smuggled.
  // ==========================================================================

  pub let BACKLIGHT_OP_QUERY_INDEX   : u64 = 0
  pub let BACKLIGHT_OP_QUERY_BACKEND : u64 = 1
  pub let BACKLIGHT_OP_QUERY_MIN     : u64 = 2
  pub let BACKLIGHT_OP_QUERY_MAX     : u64 = 3
  pub let BACKLIGHT_OP_QUERY_CURRENT : u64 = 4
  pub let BACKLIGHT_OP_QUERY_REPORTS : u64 = 5
  pub let BACKLIGHT_OP_QUERY_PARENT  : u64 = 6
  pub let BACKLIGHT_OP_DEBUG_PRINT   : u64 = 7
  pub let BACKLIGHT_OP_REPORT        : u64 = 8
  pub let BACKLIGHT_OP_MAX           : u64 = 8

  // ==========================================================================
  // Failure taxonomy — 0xFFFFFE70..0xFFFFFE7F.
  //
  // Sixteen-wide, disjoint from KIND_COOLING_DEVICE (0xFFFFFE50..5F),
  // KIND_BATTERY (0xFFFFFE40..4F), KIND_THERMAL_ZONE (0xFFFFFE30..3F),
  // owner (0xFFFFFE2B..2F), thermal policy (0xFFFFFE20..2A),
  // KIND_FW_SESSION (0xFFFFFE10..1F) and battery_monitor
  // (0xFFFFFE60..6F). Disjointness is what lets a u64 threaded up
  // through the mint, the row allocator and the dispatch handler still
  // name the gate that refused it.
  // ==========================================================================

  pub let BACKLIGHT_OK                : u64 = 0
  pub let BACKLIGHT_TAIL_ENOSPC       : u64 = 0xFFFFFE7F
  pub let BACKLIGHT_TAIL_BAD_ARG      : u64 = 0xFFFFFE7E
  pub let BACKLIGHT_MINT_BAD_PARENT   : u64 = 0xFFFFFE7D
  pub let BACKLIGHT_MINT_BAD_RIGHTS   : u64 = 0xFFFFFE7C
  pub let BACKLIGHT_MINT_BAD_INDEX    : u64 = 0xFFFFFE7B
  pub let BACKLIGHT_MINT_BAD_BACKEND  : u64 = 0xFFFFFE7A
  pub let BACKLIGHT_MINT_BAD_RANGE    : u64 = 0xFFFFFE79
  pub let BACKLIGHT_MINT_NO_DEVICE    : u64 = 0xFFFFFE78
  pub let BACKLIGHT_MINT_ENOSPC       : u64 = 0xFFFFFE77
  pub let BACKLIGHT_MINT_BL_IN_USE    : u64 = 0xFFFFFE76
  pub let BACKLIGHT_BAD_SLOT          : u64 = 0xFFFFFE75
  pub let BACKLIGHT_WRONG_KIND        : u64 = 0xFFFFFE74
  pub let BACKLIGHT_REVOKE_ALREADY    : u64 = 0xFFFFFE73
  pub let BACKLIGHT_IMPLAUSIBLE_LEVEL : u64 = 0xFFFFFE72

  // The decoders' contract for a dead or out-of-range row.
  pub let BACKLIGHT_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF

  // `backlight_find_by_key`'s "no row holds this key". 0xFF rather than
  // 0, because row 0 is a legitimate answer.
  pub let BACKLIGHT_ROW_NONE : u64 = 0xFF

  // "No brightness has been reported yet." 0xFFFF sits below the row's
  // LEVEL_UPPER of 65535 by one, but any legitimate reading is refused
  // by backlight_level_valid unless brightness_max >= the reading. A
  // compositor that mints with brightness_max = 65535 CAN legitimately
  // report 0xFFFF, in which case the sentinel is ambiguous with the
  // reading. The dispatch handler's QUERY_CURRENT documents this and
  // callers that need to distinguish must query REPORTS as well: a
  // reports count of zero disambiguates 'never reported' from 'reported
  // 0xFFFF'.
  pub let BACKLIGHT_LEVEL_NONE : u64 = 0xFFFF

  // ==========================================================================
  // Table sizing and row layout.
  //
  // FOUR ROWS, sized by BACKLIGHTS A MACHINE HAS. A T14 G4 declares
  // exactly one (the eDP panel); a docked workstation has one internal
  // panel and up to three external monitors whose brightness the OS may
  // or may not be permitted to control. Four covers the workstation.
  //
  // Sixty-four bytes per row so the index is a `shl 6`; paideia-as has
  // no `mul`.
  //
  //   [+0]  header word
  //           bits [7:0]   reserved, must be zero
  //           bits [15:8]  parent_slot  cap_table slot of the parent
  //                                     KIND_DEVICE at mint; audit and
  //                                     query only
  //           bits [55:16] reserved, must be zero
  //           bits [63:56] in_use       allocator flag
  //   [+8]  bl_key           INHERITED from the parent descriptor's
  //                          target_ptr. Non-zero. The uniqueness key.
  //   [+16] index            0..BACKLIGHT_INDEX_MAX-1
  //   [+24] backend          0..BACKLIGHT_BACKEND_MAX
  //   [+32] brightness_min   the lower endpoint of the valid range
  //   [+40] brightness_max   > brightness_min, <= BACKLIGHT_LEVEL_UPPER
  //   [+48] current_brightness  last reported level, or LEVEL_NONE
  //   [+56] state word
  //           bits [31:0]  reserved, must be zero
  //           bits [63:32] reports     lifetime install count
  //
  // `tools/build.sh` asserts by `objdump -r` that no object other than
  // `core/cap/kind_backlight.o` relocates against `_backlight_table`.
  // The table is the only place in the kernel where a backlight
  // brightness_max lives, and a second writer could raise it with no
  // capability involved and no refusal recorded.
  // ==========================================================================

  pub let BACKLIGHT_MAX       : u64 = 4
  pub let BACKLIGHT_ROW_BYTES : u64 = 64

  pub let mut _backlight_table : [u64; 32] = uninit @align(64)

  // Counters. Deliberately NOT in the row: they survive a revoke, so
  // "this panel keeps returning nonsense" is evidence about a
  // controller and outlives any one capability over it.
  //
  //   +0  reports         reports that installed successfully
  //   +8  impl_level      reports refused for level out of [min, max]
  pub let mut _backlight_stats : [u64; 8] = uninit @align(64)

  pub let BACKLIGHT_ST_REPORTS    : u64 = 0
  pub let BACKLIGHT_ST_IMPL_LEVEL : u64 = 1
  pub let BACKLIGHT_ST_MAX        : u64 = 8

  // Local klog keys and tags.
  pub let bl_dbg_msg : [u8; 15] = "BACKLIGHT ROW\n\0"
  pub let bl_k_row   : [u8; 4]  = "row\0"
  pub let bl_k_idx   : [u8; 4]  = "idx\0"
  pub let bl_k_bkd   : [u8; 5]  = "bknd\0"
  pub let bl_k_min   : [u8; 4]  = "min\0"
  pub let bl_k_max   : [u8; 4]  = "max\0"
  pub let bl_k_cur   : [u8; 4]  = "cur\0"

  // ==========================================================================
  // backlight_table_reset() -> ()
  // ==========================================================================

  pub let backlight_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M5-001 (#1106): clear every row and every counter. Boot and teardown only. Two separate store runs rather than one over the sum, mirroring cooling/battery/thermal table_reset: the two arrays have different lengths and one loop over their total would encode their adjacency in .bss as a fact the code depends on. Bounded by immediate compares, 32 and 8 iterations. Leaf. Labels prefixed bl_rs_ per reserved-label discipline.",
      block: {
        lea r10, [rip + _backlight_table];
        xor rax, rax;
        xor rcx, rcx;
      bl_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  bl_rs_rows;

        lea r10, [rip + _backlight_stats];
        xor rcx, rcx;
      bl_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  bl_rs_stats;
        ret
      }
    } @no_frame

  // ==========================================================================
  // backlight_backend_valid(b) -> 1 | 0
  // ==========================================================================

  pub let backlight_backend_valid : (u64) -> u64 !{} @{} =
    fn (b: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R31.M5-001 (#1106): 1 iff b in [0, BACKLIGHT_BACKEND_MAX]. §5's small closed set. A backend outside the enumeration would not just render as a nonsense number in a debug dump; a future consumer that used backend to select a driver strategy would apply a controller path it never had. Refused rather than mapped to UNKNOWN because 'the firmware advertised something we do not understand' and 'the firmware advertised nothing' are different facts. Pure leaf. Labels prefixed bl_bv_ per reserved-label discipline.",
      block: {
        mov r10, 3;                      // BACKLIGHT_BACKEND_MAX
        cmp rdi, r10;
        ja  bl_bv_no;
        mov rax, 1;
        ret;
      bl_bv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // backlight_note(which) -> ()
  // backlight_stat(which) -> count
  // ==========================================================================

  pub let backlight_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M5-001 (#1106): increment one counter; silent no-op on out-of-range. Same shape as cooling_note / battery_note / thermal_zone_note: every caller inside this module passes a constant, and the bound is here so the array cannot be walked past if that ever stops being true. Leaf. Labels prefixed bl_nt_ per reserved-label discipline.",
      block: {
        cmp rdi, 8;                      // BACKLIGHT_ST_MAX
        jae bl_nt_out;
        lea r10, [rip + _backlight_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      bl_nt_out:
        ret
      }
    } @no_frame

  pub let backlight_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M5-001 (#1106): bounds-checked read of one counter; out of range returns 0. This is what makes a lying controller DIAGNOSABLE: a panel whose reports are refused by §3's bounds looks, from every other vantage point, exactly like a panel whose compositor never sent a report. The impl_level counter is the only place the difference is visible. Leaf. Labels prefixed bl_st_ per reserved-label discipline.",
      block: {
        cmp rdi, 8;                      // BACKLIGHT_ST_MAX
        jae bl_st_zero;
        lea r10, [rip + _backlight_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      bl_st_zero:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // backlight_rights_valid(rights) -> 1 | 0
  // ==========================================================================

  pub let backlight_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R31.M5-001 (#1106): 1 iff (rights & R_BACKLIGHT_ALL) == rights. R_BACKLIGHT_ALL = 0x41B (READ|REPORT|INVOKE|REVOKE|OBSERVE). A subset test, and RIGHT_MINT (0x200) is OUTSIDE the mask: this kind is a leaf of the lattice, and a MINT bit no gate reads is authority that later acquires a meaning nobody audited. The subset shape (not equality) lets a monitor hold R_BACKLIGHT_READ alone while the compositor holds READ|REPORT. Pure leaf. Labels prefixed bl_rv_ per reserved-label discipline.",
      block: {
        mov rax, rdi;
        mov r10, 0x41B;                  // R_BACKLIGHT_ALL
        and rax, r10;
        cmp rax, rdi;
        jne bl_rv_no;
        mov rax, 1;
        ret;
      bl_rv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  // ==========================================================================
  // backlight_check_parent_device(parent_slot) -> 1 | 0
  //
  // §2. The first half of the derivation gate. Discriminates NOTHING on
  // its own; the second half is in backlight_cap_mint_inner.
  // ==========================================================================

  pub let backlight_check_parent_device : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R31.M5-001 (#1106): the first half of the KIND_BACKLIGHT derivation gate. Bounds-check parent_slot < 256; load the descriptor at cap_table + parent_slot*24 (stride 24 per cap/mint.pdx); require kind == KIND_DEVICE (10) AND (rights & RIGHT_MINT 0x200) != 0. THIS HALF DISCRIMINATES NOTHING and the mint does not treat it as though it did -- every PCI function in the machine is a KIND_DEVICE, which is #1075's lesson stated for the sixth time in this file family. 'This device is a backlight controller' is a firmware-namespace fact this ring may not read (design/acpi/no-aml-in-kernel.md), so the second half is what the kernel CAN enforce (non-zero inherited key, one panel per key, plausible index / backend / range). Pure read. Labels prefixed bl_cpd_ per reserved-label discipline.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae bl_cpd_no;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 10;                     // KIND_DEVICE
        jne bl_cpd_no;

        mov r10, [rax + 8];
        mov r11, 0x200;                  // RIGHT_MINT
        and r10, r11;
        cmp r10, 0;
        je  bl_cpd_no;

        mov rax, 1;
        ret;

      bl_cpd_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // backlight_parent_key(parent_slot) -> bl_key | 0
  // ==========================================================================

  pub let backlight_parent_key : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R31.M5-001 (#1106): read the parent KIND_DEVICE descriptor's target_ptr, which for a device capability is its identity key. THE ONLY SOURCE OF A BACKLIGHT CAPABILITY'S IDENTITY: the mint has no device argument, so the panel whose static identity a row holds is the part its parent capability names and no other. A mint that took the key as an argument would let a holder attach one panel's brightness range to a different panel -- and every report thereafter would be confidently wrong about which display the compositor's fade was acting on. Same shape as cooling_parent_key / battery_parent_key. Returns 0 for a bad slot or a non-KIND_DEVICE descriptor, and backlight_cap_mint_inner refuses 0 with BACKLIGHT_MINT_NO_DEVICE. Pure read. Labels prefixed bl_pk_ per reserved-label discipline.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae bl_pk_no;

        mov rax, cap_table;
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 10;                     // KIND_DEVICE
        jne bl_pk_no;

        mov rax, [rax + 16];             // target_ptr = device identity key
        ret;

      bl_pk_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // backlight_hdr_pack(parent_slot) -> hdr | BACKLIGHT_DECODE_BAD
  // ==========================================================================

  pub let backlight_hdr_pack : (u64) -> u64 !{} @{} =
    fn (parent_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R31.M5-001 (#1106): canonical header-word encoder. Validates parent_slot < 256 then packs (parent_slot << 8), leaving bits [7:0], [55:16] and [63:56] clear. Bits [63:56] are the allocator's in_use flag and MUST leave this function zero, which is the whole reason the encoder exists rather than a shift at the call site: a header arriving with in_use pre-set hands back a row the free scan skips forever, and on this kind the leaked row holds a brightness_max, so the next legitimate mint of that panel is refused BL_IN_USE by a ghost that is still the only record of the panel's range. Pure leaf. Labels prefixed bl_hp_ per reserved-label discipline.",
      block: {
        mov r10, 256;
        cmp rdi, r10;
        jae bl_hp_bad;

        mov rax, rdi;
        shl rax, 8;
        ret;

      bl_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    } @no_frame

  pub let backlight_hdr_parent : (u64) -> u64 !{} @{} =
    fn (hdr: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R31.M5-001 (#1106): parent_slot from header bits [15:8]. Named accessor rather than a shift at each call site, so a future header field cannot silently change what a caller reads. Pure leaf.",
      block: { mov rax, rdi; shr rax, 8; and rax, 0xFF; ret }
    } @no_frame

  // ==========================================================================
  // backlight_tail_alloc(hdr, bl_key, index, backend, bmin, bmax)
  //   -> row_id | BACKLIGHT_TAIL_*
  //
  // THE ONLY FUNCTION IN THE KERNEL THAT WRITES A BACKLIGHT BRIGHTNESS_MAX.
  // ==========================================================================

  pub let backlight_tail_alloc : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (bl_key: u64) (index: u64) (backend: u64) (bmin: u64) (bmax: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M5-001 (#1106): claim one row. THE ONLY FUNCTION IN THE KERNEL THAT WRITES A BACKLIGHT BRIGHTNESS_MAX, which is why tools/build.sh confines relocations against _backlight_table to this object. Gates, in order: hdr bits [63:56] non-zero -> TAIL_BAD_ARG (the allocator's in_use flag); hdr reserved bits [7:0] or [55:16] non-zero -> TAIL_BAD_ARG; bl_key == 0 -> TAIL_BAD_ARG (0 is backlight_parent_key's refusal value); index >= BACKLIGHT_INDEX_MAX -> TAIL_BAD_ARG; backend > BACKLIGHT_BACKEND_MAX -> TAIL_BAD_ARG; bmax > BACKLIGHT_LEVEL_UPPER OR bmax <= bmin -> TAIL_BAD_ARG. THE RANGE CHECK IS HERE AS WELL AS IN THE MINT, deliberately: the mint's version produces the specific code an installer needs (MINT_BAD_RANGE), while this makes it impossible for ANY future second caller of the allocator to create a row without it. A row with brightness_max <= brightness_min would be a panel whose only legal level is unreachable. Low-first scan over 4 rows of 64 bytes, free iff byte 7 of [row+0] is zero. Claim writes all eight words, so a reused row cannot inherit the previous panel's cached level or report count. Six pushes leave rsp%16 == 0 at every nested call site (there are none in this leaf). Labels prefixed bl_ta_ per reserved-label discipline.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov r12, rdi;                    // hdr
        mov r13, rsi;                    // bl_key
        mov r14, rdx;                    // index
        mov r15, rcx;                    // backend
        mov rbp, r8;                     // bmin
        // bmax stays in r9

        // hdr in_use pre-set?
        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne bl_ta_bad;

        // hdr reserved [7:0]?
        mov rax, r12;
        and rax, 0xFF;
        cmp rax, 0;
        jne bl_ta_bad;

        // hdr reserved [55:16]?
        mov rax, r12;
        shr rax, 16;
        mov r10, 0xFFFFFFFFFF;           // 40 bits: [55:16]
        and rax, r10;
        cmp rax, 0;
        jne bl_ta_bad;

        cmp r13, 0;
        je  bl_ta_bad;

        mov r10, 8;                      // BACKLIGHT_INDEX_MAX
        cmp r14, r10;
        jae bl_ta_bad;

        mov r10, 3;                      // BACKLIGHT_BACKEND_MAX
        cmp r15, r10;
        ja  bl_ta_bad;

        mov r10, 65535;                  // BACKLIGHT_LEVEL_UPPER
        cmp r9, r10;
        ja  bl_ta_bad;
        cmp r9, rbp;
        jbe bl_ta_bad;                   // bmax <= bmin refused

        // Low-first free scan.
        xor rbx, rbx;                    // row_id
      bl_ta_scan:
        cmp rbx, 4;                      // BACKLIGHT_MAX
        jae bl_ta_enospc;

        lea r10, [rip + _backlight_table];
        mov r11, rbx;
        shl r11, 6;                      // row * 64
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  bl_ta_claim;

        add rbx, 1;
        jmp bl_ta_scan;

      bl_ta_claim:
        mov rax, r12;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;                    // in_use = 1
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r13;             // bl_key
        mov [r10 + 16], r14;             // index
        mov [r10 + 24], r15;             // backend
        mov [r10 + 32], rbp;             // brightness_min
        mov [r10 + 40], r9;              // brightness_max
        mov rax, 0xFFFF;                 // BACKLIGHT_LEVEL_NONE
        mov [r10 + 48], rax;             // current_brightness
        xor rax, rax;
        mov [r10 + 56], rax;             // state word
        mov rax, rbx;
        jmp bl_ta_out;

      bl_ta_enospc:
        mov rax, 0xFFFFFE7F;             // BACKLIGHT_TAIL_ENOSPC
        jmp bl_ta_out;
      bl_ta_bad:
        mov rax, 0xFFFFFE7E;             // BACKLIGHT_TAIL_BAD_ARG

      bl_ta_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let backlight_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M5-001 (#1106): 1 iff row_id < BACKLIGHT_MAX and the row's in_use byte is set. Every decoder gates on this so that a freed row answers BACKLIGHT_DECODE_BAD rather than the zeroes it was scrubbed to. On this kind that matters for brightness_max: a scrubbed row renders as a panel with zero range, which every legitimate level ordinal is outside. Leaf. Labels prefixed bl_tv_ per reserved-label discipline.",
      block: {
        cmp rdi, 4;                      // BACKLIGHT_MAX
        jae bl_tv_no;
        lea r10, [rip + _backlight_table];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  bl_tv_no;
        mov rax, 1;
        ret;
      bl_tv_no:
        xor rax, rax;
        ret
      }
    } @no_frame

  pub let backlight_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M5-001 (#1106): scrub one row to zero, which clears in_use and returns it to the free scan. ALL EIGHT WORDS, including the cached level and lifetime report count: a revoke is the point at which somebody has decided this backlight's history no longer applies, and a row that kept its cached level across a re-mint would report a panel as sitting at a brightness on the strength of a report about a capability that no longer exists. Scrubbing the KEY is what makes the panel re-mintable. No-op on an out-of-range row. Leaf. Labels prefixed bl_tf_ per reserved-label discipline.",
      block: {
        cmp rdi, 4;                      // BACKLIGHT_MAX
        jae bl_tf_out;
        lea r10, [rip + _backlight_table];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        mov [r10 + 32], rax;
        mov [r10 + 40], rax;
        mov [r10 + 48], rax;
        mov [r10 + 56], rax;
      bl_tf_out:
        ret
      }
    } @no_frame

  // ==========================================================================
  // Row accessors. Every one returns BACKLIGHT_DECODE_BAD for a dead row.
  // ==========================================================================

  pub let backlight_row_hdr : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R31.M5-001 (#1106): raw header word of a live row, or BACKLIGHT_DECODE_BAD. Labels prefixed bl_rh_.",
      block: {
        push r12;
        push r13;
        push r14;
        mov r12, rdi;
        call backlight_tail_valid;
        cmp rax, 0;
        je  bl_rh_bad;
        lea r10, [rip + _backlight_table];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        jmp bl_rh_out;
      bl_rh_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      bl_rh_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

