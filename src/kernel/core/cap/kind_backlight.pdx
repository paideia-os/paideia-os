  // ==========================================================================
  // backlight_report_install(slot, brightness) -> BACKLIGHT_OK | ...
  //
  // §3. THE ONE PUSH-STATE PRIMITIVE. ONE VALUE, PLAUSIBILITY AGAINST
  //     THE ROW'S OWN RANGE.
  // ==========================================================================

  pub let backlight_report_install : (u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) (brightness: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R31.M5-001 (#1106): install one brightness report of the panel this capability names. TWO ARGUMENTS AND NO MORE: a capability, and the one value §5's row layout has a dynamic field for. A third argument would be a caller-supplied brightness_max or index reaching the row, and both are set-once at mint by §1. Gates, in order: (1) the slot must name a live KIND_BACKLIGHT -> BACKLIGHT_BAD_SLOT / BACKLIGHT_WRONG_KIND via backlight_row_of_slot, reusing the checks every other path uses rather than restating them. (2) brightness OUTSIDE [brightness_min, brightness_max] -> IMPLAUSIBLE_LEVEL, counted, AND NOTHING IN THE ROW IS TOUCHED. NOT CLAMPED: a level above brightness_max is refused and the top level is not silently substituted for it, because clamping would bless the garbage and hide the compositor bug. (3) install: write current_brightness; increment the state-word report count in place and BACKLIGHT_ST_REPORTS overall. NOTHING DRIVES A PANEL: this is §4's design decision, stated once in the file header. Six pushes leave rsp%16 == 0 at every nested call. Labels prefixed bl_rpi_ (report-install) -- distinct from backlight_row_index's bl_ri_ (row-index): both abbreviate to \"ri\" and a shared prefix here previously aliased the two functions' bl_ri_out labels to one address, corrupting the stack on any call into backlight_row_index (issue #1610 follow-up: same defect pattern as cooling_report_install, fixed here by the same rename).",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov r12, rsi;                    // brightness

        call backlight_row_of_slot;
        mov rbx, rax;
        cmp rbx, 0xFF;                   // BACKLIGHT_ROW_NONE
        je  bl_rpi_bad_slot;

        // Load brightness_min, brightness_max from the row for the range test.
        lea r10, [rip + _backlight_table];
        mov r11, rbx;
        shl r11, 6;
        add r10, r11;

        mov r13, [r10 + 32];             // brightness_min
        mov r14, [r10 + 40];             // brightness_max

        cmp r12, r13;
        jb  bl_rpi_impl_level;
        cmp r12, r14;
        ja  bl_rpi_impl_level;

        // Install.
        mov [r10 + 48], r12;             // current_brightness

        // state word: reports in bits [63:32]; low 32 stay reserved-zero.
        mov rax, [r10 + 56];
        mov r11, rax;
        shr r11, 32;
        add r11, 1;
        mov r15, 0xFFFFFFFF;             // low-32 mask
        and rax, r15;
        shl r11, 32;
        or  rax, r11;
        mov [r10 + 56], rax;

        // Global counter.
        mov rdi, 0;                      // BACKLIGHT_ST_REPORTS
        call backlight_note;

      bl_rpi_ok:
        xor rax, rax;                    // BACKLIGHT_OK
        jmp bl_rpi_out;

      bl_rpi_bad_slot:
        mov rax, 0xFFFFFE75;
        jmp bl_rpi_out;
      bl_rpi_impl_level:
        mov rdi, 1;                      // BACKLIGHT_ST_IMPL_LEVEL
        call backlight_note;
        mov rax, 0xFFFFFE72;             // BACKLIGHT_IMPLAUSIBLE_LEVEL

      bl_rpi_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // backlight_cap_mint_inner(slot, parent_slot, rights, index, backend, range)
  //
  // `range` packs bmin | (bmax << 32) to fit SysV six-register limit.
  // ==========================================================================

  pub let backlight_cap_mint_inner : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (index: u64) (backend: u64) (range: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R31.M5-001 (#1106): mint a KIND_BACKLIGHT over a KIND_DEVICE. `range` packs brightness_min in bits [31:0] and brightness_max in bits [63:32] -- a compact encoding that stays within the SysV six-register limit and, more importantly, keeps the two endpoints indivisible on the control path. Gates, in order: (1) slot < 256 -> BACKLIGHT_BAD_SLOT. (2) backlight_check_parent_device -> BACKLIGHT_MINT_BAD_PARENT (the half that discriminates NOTHING, §2). (3) backlight_rights_valid -> BACKLIGHT_MINT_BAD_RIGHTS. (4) index < BACKLIGHT_INDEX_MAX -> BACKLIGHT_MINT_BAD_INDEX. (5) backend in enum -> BACKLIGHT_MINT_BAD_BACKEND. (6) bmax > BACKLIGHT_LEVEL_UPPER OR bmax <= bmin -> BACKLIGHT_MINT_BAD_RANGE. A degenerate range (bmax == bmin) is refused: it would name a panel with exactly one legal level, which is a control surface with no expressible control. (7) INHERIT the identity: backlight_parent_key(parent_slot); 0 -> BACKLIGHT_MINT_NO_DEVICE. (8) UNIQUENESS: backlight_find_by_key must answer BACKLIGHT_ROW_NONE -> BACKLIGHT_MINT_BL_IN_USE. Two capabilities over one panel means two compositors writing one control surface. (9) hdr_pack(parent_slot) then tail_alloc -> BACKLIGHT_MINT_ENOSPC on exhaustion. (10) cap_mint_write(slot, KIND_BACKLIGHT, rights, row_id | (slot << 16)) -- the only descriptor writer, on both the mint and the revoke path per #1579. Six pushes leave rsp%16 == 0 at every nested call. Labels prefixed bl_mi_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov rbx, rdi;                    // slot
        mov r12, rsi;                    // parent_slot
        mov r13, rdx;                    // rights
        mov r14, rcx;                    // index
        mov r15, r8;                     // backend
        mov rbp, r9;                     // range = bmin | (bmax << 32)

        mov r10, 256;
        cmp rbx, r10;
        jae bl_mi_bad_slot;

        mov rdi, r12;
        call backlight_check_parent_device;
        cmp rax, 0;
        je  bl_mi_bad_parent;

        mov rdi, r13;
        call backlight_rights_valid;
        cmp rax, 0;
        je  bl_mi_bad_rights;

        mov r10, 8;                      // BACKLIGHT_INDEX_MAX
        cmp r14, r10;
        jae bl_mi_bad_index;

        mov rdi, r15;
        call backlight_backend_valid;
        cmp rax, 0;
        je  bl_mi_bad_backend;

        // Unpack range.
        mov r10, rbp;
        mov r11, 0xFFFFFFFF;
        and r10, r11;                    // bmin
        mov r11, rbp;
        shr r11, 32;                     // bmax

        // bmax bounds.
        mov rax, 65535;                  // BACKLIGHT_LEVEL_UPPER
        cmp r11, rax;
        ja  bl_mi_bad_range;
        cmp r11, r10;
        jbe bl_mi_bad_range;             // bmax <= bmin

        // Stash the unpacked endpoints across nested calls.
        push r10;                        // bmin
        push r11;                        // bmax

        mov rdi, r12;
        call backlight_parent_key;
        cmp rax, 0;
        je  bl_mi_no_device_pop2;

        // Stash the key.
        mov r10, rax;
        push r10;
        sub rsp, 8;                      // keep rsp%16 == 0
        mov rdi, r10;
        call backlight_find_by_key;
        add rsp, 8;
        pop r10;                         // r10 = bl_key
        cmp rax, 0xFF;                   // BACKLIGHT_ROW_NONE
        jne bl_mi_in_use_pop2;

        // hdr_pack + tail_alloc.
        push r10;
        sub rsp, 8;
        mov rdi, r12;
        call backlight_hdr_pack;
        add rsp, 8;
        pop r10;
        mov r11, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r11;
        je  bl_mi_bad_parent_pop2;

        // Retrieve bmin/bmax from the earlier pushes.
        // Stack layout at this point: [rsp] = bmax, [rsp+8] = bmin.
        mov r9, [rsp + 0];               // bmax
        mov r8, [rsp + 8];               // bmin

        mov rdi, rax;                    // hdr
        mov rsi, r10;                    // bl_key
        mov rdx, r14;                    // index
        mov rcx, r15;                    // backend
        // r8 = bmin (already)
        // r9 = bmax (already)
        call backlight_tail_alloc;

        // Pop the two range slots.
        add rsp, 16;

        mov r10, 0xFFFFFE7F;             // BACKLIGHT_TAIL_ENOSPC
        cmp rax, r10;
        je  bl_mi_enospc;
        mov r10, 0xFFFFFE7E;             // BACKLIGHT_TAIL_BAD_ARG
        cmp rax, r10;
        je  bl_mi_bad_range;

        // target_ptr = row_id | (slot << 16).
        mov r14, rax;                    // row_id
        mov r11, rbx;
        shl r11, 16;
        or  r14, r11;

        mov rdi, rbx;
        mov rsi, 0x15a;                  // KIND_BACKLIGHT
        mov rdx, r13;                    // rights
        mov rcx, r14;
        call cap_mint_write;

        xor rax, rax;                    // BACKLIGHT_OK
        jmp bl_mi_out;

      bl_mi_no_device_pop2:
        add rsp, 16;
        jmp bl_mi_no_device;
      bl_mi_in_use_pop2:
        add rsp, 16;
        jmp bl_mi_in_use;
      bl_mi_bad_parent_pop2:
        add rsp, 16;
        jmp bl_mi_bad_parent;

      bl_mi_bad_slot:
        mov rax, 0xFFFFFE75;
        jmp bl_mi_out;
      bl_mi_bad_parent:
        mov rax, 0xFFFFFE7D;
        jmp bl_mi_out;
      bl_mi_bad_rights:
        mov rax, 0xFFFFFE7C;
        jmp bl_mi_out;
      bl_mi_bad_index:
        mov rax, 0xFFFFFE7B;
        jmp bl_mi_out;
      bl_mi_bad_backend:
        mov rax, 0xFFFFFE7A;
        jmp bl_mi_out;
      bl_mi_bad_range:
        mov rax, 0xFFFFFE79;
        jmp bl_mi_out;
      bl_mi_no_device:
        mov rax, 0xFFFFFE78;
        jmp bl_mi_out;
      bl_mi_enospc:
        mov rax, 0xFFFFFE77;
        jmp bl_mi_out;
      bl_mi_in_use:
        mov rax, 0xFFFFFE76;

      bl_mi_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let backlight_cap_mint : (u64, u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (index: u64) (backend: u64) (range: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R31.M5-001 (#1106): audited mint. Same shape as cooling_cap_mint. Putting emission in the wrapper means a second mint path cannot exist without being audited. `range` packs (brightness_min, brightness_max) as it does for the inner mint. Four pushes leave rsp%16 == 0 at both nested calls. Reserved labels: none.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // subject slot
        mov r13, rsi;                    // principal (parent slot)

        call backlight_cap_mint_inner;
        mov r14, rax;

        mov rdi, 1;                      // DRV_AUDIT_EV_MINT
        mov rsi, 0x15a;                  // KIND_BACKLIGHT
        mov rdx, r12;
        mov rcx, r13;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // backlight_cap_revoke_inner(slot) -> BACKLIGHT_OK | ...
  // ==========================================================================

  pub let backlight_cap_revoke_inner : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R31.M5-001 (#1106): revoke a KIND_BACKLIGHT. (1) slot < 256 -> BACKLIGHT_BAD_SLOT. (2) kind == 0 -> BACKLIGHT_REVOKE_ALREADY, idempotent and distinct so a caller can tell 'nothing to do' from 'done'. (3) kind != 0x15a -> BACKLIGHT_WRONG_KIND, which is what stops a backlight revoke from freeing another kind's row through a coincidentally-shaped target_ptr and is what makes it safe for the owner-column sweep to call this blindly. (4) row_id from target_ptr[15:0]; if live, backlight_tail_free scrubs it, which is what makes the panel RE-MINTABLE. (5) clear the descriptor through cap_mint_write(slot, 0, 0, 0) rather than three raw stores, per #1579. NOTHING DRIVES A PANEL. Revoking authority over an actuator leaves the actuator exactly as it was; that is deliberate. Five pushes leave rsp%16 == 0 at every nested call. Labels prefixed bl_rvk_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // slot

        mov r10, 256;
        cmp r12, r10;
        jae bl_rvk_bad_slot;

        mov rax, cap_table;
        mov r8, r12;
        shl r8, 3;
        mov r9, r12;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov rbx, rax;                    // descriptor base

        mov r10, [rbx + 0];
        cmp r10, 0;
        je  bl_rvk_already;

        mov r11, 0x15a;                  // KIND_BACKLIGHT
        cmp r10, r11;
        jne bl_rvk_wrong_kind;

        mov r13, [rbx + 16];
        mov r10, 0xFFFF;
        and r13, r10;                    // row_id

        mov rdi, r13;
        call backlight_tail_valid;
        cmp rax, 0;
        je  bl_rvk_clear;

        mov rdi, r13;
        call backlight_tail_free;

      bl_rvk_clear:
        mov rdi, r12;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        xor rax, rax;                    // BACKLIGHT_OK
        jmp bl_rvk_out;

      bl_rvk_bad_slot:
        mov rax, 0xFFFFFE75;
        jmp bl_rvk_out;
      bl_rvk_wrong_kind:
        mov rax, 0xFFFFFE74;
        jmp bl_rvk_out;
      bl_rvk_already:
        mov rax, 0xFFFFFE73;

      bl_rvk_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let backlight_cap_revoke : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R31.M5-001 (#1106): audited revoke. THE SYMBOL THE OWNER-COLUMN SWEEP CALLS, so a process death leaves the same audit trail a deliberate teardown would. NO cascade: nothing in this tree derives from a backlight capability. Three pushes leave rsp%16 == 0 at both nested calls. Reserved labels: none.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;

        call backlight_cap_revoke_inner;
        mov r14, rax;

        mov rdi, 2;                      // DRV_AUDIT_EV_REVOKE
        mov rsi, 0x15a;                  // KIND_BACKLIGHT
        mov rdx, r12;
        mov rcx, r12;
        mov r8,  r14;
        call drv_audit_emit;

        mov rax, r14;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // backlight_debug_print(row_id) -> BACKLIGHT_OK | BACKLIGHT_TAIL_BAD_ARG
  // ==========================================================================

  pub let backlight_debug_print : (u64) -> u64 !{mem, sysreg} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "R31.M5-001 (#1106): canonical printer for one backlight row. Refuses a dead or out-of-range row with BACKLIGHT_TAIL_BAD_ARG rather than printing zeroes: a freed row renders as {idx 0, backend 0, min 0, max 0, cur 0}, which is a plausible-looking panel with no expressible control -- the most misleading five values this module could emit. Six KV lines. r12 holds row_id across the calls; three pushes leave rsp%16 == 0 at every nested call. Labels prefixed bl_dp_.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;

        call backlight_tail_valid;
        cmp rax, 0;
        je  bl_dp_bad;

        mov rdi, 3;                      // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + bl_dbg_msg];
        lea rcx, [rip + bl_k_row];
        mov r8, r12;
        call klog_s1_x1;

        mov rdi, r12;
        call backlight_row_index;
        mov r13, rax;
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + bl_dbg_msg];
        lea rcx, [rip + bl_k_idx];
        mov r8, r13;
        call klog_s1_d1;

        mov rdi, r12;
        call backlight_row_backend;
        mov r13, rax;
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + bl_dbg_msg];
        lea rcx, [rip + bl_k_bkd];
        mov r8, r13;
        call klog_s1_d1;

        mov rdi, r12;
        call backlight_row_min;
        mov r13, rax;
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + bl_dbg_msg];
        lea rcx, [rip + bl_k_min];
        mov r8, r13;
        call klog_s1_d1;

        mov rdi, r12;
        call backlight_row_max;
        mov r13, rax;
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + bl_dbg_msg];
        lea rcx, [rip + bl_k_max];
        mov r8, r13;
        call klog_s1_d1;

        mov rdi, r12;
        call backlight_row_current;
        mov r13, rax;
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + bl_dbg_msg];
        lea rcx, [rip + bl_k_cur];
        mov r8, r13;
        call klog_s1_d1;

        xor rax, rax;                    // BACKLIGHT_OK
        jmp bl_dp_out;

      bl_dp_bad:
        mov rax, 0xFFFFFE7E;             // BACKLIGHT_TAIL_BAD_ARG

      bl_dp_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // cap_handler_backlight(rights, target_ptr, op_arg)
  // ==========================================================================

  pub let cap_handler_backlight : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R31.M5-001 (#1106): KIND_BACKLIGHT dispatch handler. Emits cap_backlight_msg on entry. row_id = target_ptr[15:0] and slot = target_ptr[31:16], both from the DESCRIPTOR (which only cap_mint_write writes); op = op_arg[7:0]. RIGHTS PER OP: QUERY_CURRENT requires R_BACKLIGHT_READ; QUERY_INDEX / QUERY_BACKEND / QUERY_MIN / QUERY_MAX / QUERY_REPORTS / QUERY_PARENT require R_BACKLIGHT_INVOKE; DEBUG_PRINT requires R_BACKLIGHT_OBSERVE; REPORT requires R_BACKLIGHT_REPORT. THE OP THAT IS ABSENT is a brightness_max setter: nothing in this handler can raise or lower a static field, and R_BACKLIGHT_MINT is consequently a right this handler never reads. OPS 0..7 TAKE NO OPERAND. OP 8 (REPORT) takes one operand field packed per §REPORT (current_brightness [23:8], reserved [63:24] MUST be zero -> BACKLIGHT_TAIL_BAD_ARG). Refused rather than masked, for the reason kind_cooling_device REPORT's reserved field is. Unknown op -> INVOKE_UNSUPPORTED; rights failure -> INVOKE_DENIED. Every query returns BACKLIGHT_DECODE_BAD for a dead row and never a plausible zero, because 0 is a legitimate index, a legitimate reports count and a legitimate backend (UNKNOWN). r12=rights, r13=row_id, rbx=slot, r14=op, r15=current_brightness; six pushes leave rsp%16 == 0 at every nested call. Labels prefixed bl_h_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov r12, rdi;                    // rights
        mov r13, rsi;
        mov r10, 0xFFFF;
        and r13, r10;                    // row_id = target_ptr[15:0]
        mov rbx, rsi;
        shr rbx, 16;
        and rbx, 0xFF;                   // slot   = target_ptr[31:16]
        mov r14, rdx;                    // op_arg, whole

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_backlight_msg];
        call klog_s1;

        // Decode op and REPORT operand.
        mov r10, r14;
        and r10, 0xFF;                   // op
        mov rax, r14;
        shr rax, 8;
        mov r11, 0xFFFF;
        and rax, r11;                    // current_brightness, 16 bits
        mov r15, rax;
        // Reserved field: op_arg[63:24].
        mov r11, r14;
        shr r11, 24;
        mov r14, r10;                    // r14 = op from here on

        cmp r14, 8;                      // BACKLIGHT_OP_MAX
        ja  bl_h_unsup;

        cmp r14, 8;                      // BACKLIGHT_OP_REPORT
        je  bl_h_report_gate;

        cmp r14, 7;                      // BACKLIGHT_OP_DEBUG_PRINT
        je  bl_h_dbg;

        // Ops 0..6: no operand.
        cmp r14, 4;                      // QUERY_CURRENT
        je  bl_h_read_gate;

        // QUERY_INDEX / QUERY_BACKEND / QUERY_MIN / QUERY_MAX /
        // QUERY_REPORTS / QUERY_PARENT: INVOKE.
        mov r10, r12;
        and r10, 0x008;                  // R_BACKLIGHT_INVOKE
        cmp r10, 0;
        je  bl_h_denied;

        mov rdi, r13;
        cmp r14, 0;
        je  bl_h_idx;
        cmp r14, 1;
        je  bl_h_bkd;
        cmp r14, 2;
        je  bl_h_min;
        cmp r14, 3;
        je  bl_h_max;
        cmp r14, 5;
        je  bl_h_rep;
        call backlight_row_parent;
        jmp bl_h_out;

      bl_h_read_gate:
        mov r10, r12;
        and r10, 0x001;                  // R_BACKLIGHT_READ
        cmp r10, 0;
        je  bl_h_denied;

        mov rdi, r13;
        call backlight_row_current;
        jmp bl_h_out;

      bl_h_report_gate:
        // The reserved field is REFUSED, not masked.
        cmp r11, 0;
        jne bl_h_res;

        mov r10, r12;
        and r10, 0x002;                  // R_BACKLIGHT_REPORT
        cmp r10, 0;
        je  bl_h_denied;

        mov rdi, rbx;                    // slot
        mov rsi, r15;                    // current_brightness
        call backlight_report_install;
        jmp bl_h_out;

      bl_h_idx:
        call backlight_row_index;
        jmp bl_h_out;
      bl_h_bkd:
        call backlight_row_backend;
        jmp bl_h_out;
      bl_h_min:
        call backlight_row_min;
        jmp bl_h_out;
      bl_h_max:
        call backlight_row_max;
        jmp bl_h_out;
      bl_h_rep:
        call backlight_row_reports;
        jmp bl_h_out;

      bl_h_dbg:
        mov r10, r12;
        and r10, 0x400;                  // R_BACKLIGHT_OBSERVE
        cmp r10, 0;
        je  bl_h_denied;
        mov rdi, r13;
        call backlight_debug_print;
        jmp bl_h_out;

      bl_h_res:
        mov rax, 0xFFFFFE7E;             // BACKLIGHT_TAIL_BAD_ARG
        jmp bl_h_out;
      bl_h_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;     // INVOKE_DENIED
        jmp bl_h_out;
      bl_h_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;     // INVOKE_UNSUPPORTED

      bl_h_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
