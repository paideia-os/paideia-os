// src/kernel/core/cap/kind_bt_adapter.pdx — R39.M1-002 (#1324)
//
// KIND_BT_ADAPTER = 0x182, derived over KIND_DEVICE (10).
//
// The authority to hold one Bluetooth adapter's static identity
// (adapter_key, the KIND_DEVICE slot the adapter was probed on, the
// controller_vendor read from PCI config, an interface_num identifying
// which CNVi-shared interface this adapter is bound to, an FSM state
// ordinal, and the negotiated hci_version per BT Core §7).  Opens the
// R39.M1 substrate on which the R39.M3..M6 GATT / pairing / A2DP /
// HFP / HID / LE Audio witnesses already registered depend.
//
// =============================================================================
// §0  WHY THIS KIND EXISTS
// =============================================================================
//
// R38 brought up the AX211 WiFi PHY as a driver-private substrate over
// the Intel CNVi (Connectivity iVector) bus.  On AX211 the same silicon
// exposes a Bluetooth adapter through the SAME CNVi PHY: HCI traffic and
// 802.11 traffic share the physical channel.  R39.M1 introduces a
// CAPABILITY over that adapter identity so a ring-3 supervisor
// (btmgr / hci_dumper / le_scanner) can name ONE adapter without
// touching MMIO at all.
//
// The kind half of the derivation gate discriminates NOTHING on its
// own -- every PCI function is a KIND_DEVICE -- so the mint additionally
// requires:
//
//   (a) adapter_key non-zero and unique among live rows (NO_KEY / IN_USE)
//   (b) device_slot names a live KIND_DEVICE (BAD_DEVICE)
//   (c) controller_vendor in (0, 0xFFFF] (BAD_VENDOR)
//   (d) interface_num <= KBA_IFACE_MAX (BAD_IFACE)
//   (e) state == KBA_STATE_RESET at mint (BAD_STATE)
//   (f) hci_version in {KBA_HCI_4_0..KBA_HCI_5_4} (BAD_HCI_VERSION)
//   (g) rights subset of R_KBA_ALL (R_MINT ABSENT from the mask)
//
// =============================================================================
// §1  ROW LAYOUT -- 32 BYTES EXACTLY
// =============================================================================
//
//   [+0]  header:  in_use[63:56] | parent_slot[15:8]
//   [+8]  adapter_key (u64)
//   [+16] body1:   device_slot[31:0] | controller_vendor[47:32]
//                | interface_num[55:48] | state[63:56]
//   [+24] body2:   hci_version[7:0] | reserved[63:8]
//
// state is the ONE mutable field: kba_row_transition (called only by
// the adapter FSM path and the revoke helper) is the sole mutator.
// Every other identity field is FROZEN at mint.
//
// =============================================================================
// §2  FAILURE TAXONOMY 0xFFFFF140..0xFFFFF14F
// =============================================================================
//
// Sixteen-wide, verified disjoint at repo-grep time from every other
// kind/driver band (adjacent used band above: semterm types
// 0xFFFFF150..5F; adjacent free band below: bt_hci_channel cap
// 0xFFFFF130..3F).

module KindBtAdapter = structure {

  pub let KIND_BT_ADAPTER    : u64 = 0x182
  pub let KBA_PARENT_KIND    : u64 = 10           // = KIND_DEVICE

  // FSM state ordinals (adapter lifecycle).
  pub let KBA_STATE_RESET    : u64 = 0
  pub let KBA_STATE_INIT     : u64 = 1
  pub let KBA_STATE_RUNNING  : u64 = 2
  pub let KBA_STATE_ERROR    : u64 = 3
  pub let KBA_STATE_MAX      : u64 = 3

  // HCI version ordinals per BT Core Assigned Numbers.
  pub let KBA_HCI_4_0 : u64 = 6
  pub let KBA_HCI_4_1 : u64 = 7
  pub let KBA_HCI_4_2 : u64 = 8
  pub let KBA_HCI_5_0 : u64 = 9
  pub let KBA_HCI_5_1 : u64 = 10
  pub let KBA_HCI_5_2 : u64 = 11
  pub let KBA_HCI_5_3 : u64 = 12
  pub let KBA_HCI_5_4 : u64 = 13
  pub let KBA_HCI_VER_MIN : u64 = 6
  pub let KBA_HCI_VER_MAX : u64 = 13

  // Interface index bound (CNVi + at most one legacy USB-BT).
  pub let KBA_IFACE_MAX : u64 = 3

  // Rights.  R_MINT (0x200) NOT in the mask.
  pub let R_KBA_READ    : u64 = 0x001
  pub let R_KBA_INVOKE  : u64 = 0x008
  pub let R_KBA_REVOKE  : u64 = 0x010
  pub let R_KBA_OBSERVE : u64 = 0x400
  pub let R_KBA_ALL     : u64 = 0x419

  // Ops.  Every op takes NO OPERAND -- op_arg[63:8] REFUSED.
  pub let KBA_OP_QUERY_KEY      : u64 = 0
  pub let KBA_OP_QUERY_DEVICE   : u64 = 1
  pub let KBA_OP_QUERY_VENDOR   : u64 = 2
  pub let KBA_OP_QUERY_IFACE    : u64 = 3
  pub let KBA_OP_QUERY_STATE    : u64 = 4
  pub let KBA_OP_QUERY_HCI_VER  : u64 = 5
  pub let KBA_OP_DEBUG_PRINT    : u64 = 6
  pub let KBA_OP_MAX            : u64 = 6

  // Failure taxonomy -- 0xFFFFF140..0xFFFFF14F.
  pub let KBA_OK                 : u64 = 0
  pub let KBA_TAIL_ENOSPC        : u64 = 0xFFFFF14F
  pub let KBA_TAIL_BAD_ARG       : u64 = 0xFFFFF14E
  pub let KBA_MINT_BAD_PARENT    : u64 = 0xFFFFF14D
  pub let KBA_MINT_BAD_RIGHTS    : u64 = 0xFFFFF14C
  pub let KBA_MINT_BAD_DEVICE    : u64 = 0xFFFFF14B
  pub let KBA_MINT_BAD_VENDOR    : u64 = 0xFFFFF14A
  pub let KBA_MINT_BAD_IFACE     : u64 = 0xFFFFF149
  pub let KBA_MINT_BAD_STATE     : u64 = 0xFFFFF148
  pub let KBA_MINT_BAD_HCI_VER   : u64 = 0xFFFFF147
  pub let KBA_MINT_NO_KEY        : u64 = 0xFFFFF146
  pub let KBA_MINT_ENOSPC        : u64 = 0xFFFFF145
  pub let KBA_MINT_IN_USE        : u64 = 0xFFFFF144
  pub let KBA_BAD_SLOT           : u64 = 0xFFFFF143
  pub let KBA_WRONG_KIND         : u64 = 0xFFFFF142
  pub let KBA_REVOKE_ALREADY     : u64 = 0xFFFFF141
  pub let KBA_BAD_TRANSITION     : u64 = 0xFFFFF140

  pub let KBA_DECODE_BAD : u64 = 0xFFFFFFFFFFFFFFFF
  pub let KBA_ROW_NONE   : u64 = 0xFF

  pub let KBA_MAX       : u64 = 8
  pub let KBA_ROW_BYTES : u64 = 32

  pub let mut _bt_adapter_table : [u64; 32] = uninit @align(64)
  pub let mut _bt_adapter_stats : [u64; 4]  = uninit @align(64)

  pub let KBA_ST_MINTS       : u64 = 0
  pub let KBA_ST_REVOKES     : u64 = 1
  pub let KBA_ST_TRANSITIONS : u64 = 2
  pub let KBA_ST_REFUSED     : u64 = 3

  pub let kba_dbg_msg : [u8; 16] = "BT ADAPTER ROW\0\0"

  // ==========================================================================
  // Table reset.
  // ==========================================================================

  pub let bt_adapter_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M1-002 (#1324): clear KIND_BT_ADAPTER row table + counters. Boot and teardown only. Labels prefixed kba_rs_.",
      block: {
        lea r10, [rip + _bt_adapter_table];
        xor rax, rax;
        xor rcx, rcx;
      kba_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 32;
        jb  kba_rs_rows;

        lea r10, [rip + _bt_adapter_stats];
        xor rcx, rcx;
      kba_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  kba_rs_stats;
        ret
      }
    }

  // ==========================================================================
  // Validators.
  // ==========================================================================

  pub let kba_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M1-002 (#1324): subset test against R_KBA_ALL = 0x419. R_MINT (0x200) OUTSIDE the mask. Labels prefixed kba_rv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x419;
        and rax, r10;
        cmp rax, rdi;
        jne kba_rv_no;
        mov rax, 1;
        ret;
      kba_rv_no:
        xor rax, rax;
        ret
      }
    }

  pub let kba_state_valid : (u64) -> u64 !{} @{} =
    fn (s: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M1-002 (#1324): 1 iff s <= STATE_MAX (3). Labels prefixed kba_sv_.",
      block: {
        cmp rdi, 3;
        ja  kba_sv_no;
        mov rax, 1;
        ret;
      kba_sv_no:
        xor rax, rax;
        ret
      }
    }

  pub let kba_hci_ver_valid : (u64) -> u64 !{} @{} =
    fn (v: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M1-002 (#1324): 1 iff v in [6, 13] (BT 4.0 through 5.4). Labels prefixed kba_hv_.",
      block: {
        cmp rdi, 6;
        jb  kba_hv_no;
        cmp rdi, 13;
        ja  kba_hv_no;
        mov rax, 1;
        ret;
      kba_hv_no:
        xor rax, rax;
        ret
      }
    }

  pub let kba_iface_valid : (u64) -> u64 !{} @{} =
    fn (i: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M1-002 (#1324): 1 iff i <= KBA_IFACE_MAX (3). Labels prefixed kba_iv_.",
      block: {
        cmp rdi, 3;
        ja  kba_iv_no;
        mov rax, 1;
        ret;
      kba_iv_no:
        xor rax, rax;
        ret
      }
    }

  pub let kba_vendor_valid : (u64) -> u64 !{} @{} =
    fn (v: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M1-002 (#1324): 1 iff v non-zero and fits 16 bits. Labels prefixed kba_vv_.",
      block: {
        cmp rdi, 0;
        je  kba_vv_no;
        mov r10, 0xFFFF;
        cmp rdi, r10;
        ja  kba_vv_no;
        mov rax, 1;
        ret;
      kba_vv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Counters.
  // ==========================================================================

  pub let kba_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M1-002 (#1324): counter bump. Labels prefixed kba_nt_.",
      block: {
        cmp rdi, 4;
        jae kba_nt_out;
        lea r10, [rip + _bt_adapter_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      kba_nt_out:
        ret
      }
    }

  pub let kba_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M1-002 (#1324): counter read. Labels prefixed kba_stt_.",
      block: {
        cmp rdi, 4;
        jae kba_stt_zero;
        lea r10, [rip + _bt_adapter_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      kba_stt_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Parent gate: live KIND_DEVICE (10) with RIGHT_MINT.
  // ==========================================================================

  pub let kba_check_parent : (u64) -> u64 !{mem} @{cap} =
    fn (parent_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R39.M1-002 (#1324): parent must be live KIND_DEVICE (10) with RIGHT_MINT. Labels prefixed kba_cp_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae kba_cp_no;

        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 10;
        jne kba_cp_no;

        mov r10, [rax + 8];
        mov r11, 0x200;
        and r10, r11;
        cmp r10, 0;
        je  kba_cp_no;

        mov rax, 1;
        ret;
      kba_cp_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Device gate: live KIND_DEVICE (10) at device_slot.
  // ==========================================================================

  pub let kba_check_device : (u64) -> u64 !{mem} @{cap} =
    fn (device_slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R39.M1-002 (#1324): device_slot must name a live KIND_DEVICE. Labels prefixed kba_cd_.",
      block: {
        mov r11, 256;
        cmp rdi, r11;
        jae kba_cd_no;

        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        cmp r10, 10;
        jne kba_cd_no;

        mov rax, 1;
        ret;
      kba_cd_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // Header + body packers.
  // ==========================================================================

  pub let kba_hdr_pack : (u64) -> u64 !{} @{} =
    fn (parent_slot: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M1-002 (#1324): (parent_slot << 8). Labels prefixed kba_hp_.",
      block: {
        mov r10, 256;
        cmp rdi, r10;
        jae kba_hp_bad;
        mov rax, rdi;
        shl rax, 8;
        ret;
      kba_hp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let kba_body1_pack : (u64, u64, u64, u64) -> u64 !{} @{} =
    fn (device_slot: u64) (vendor: u64) (iface: u64) (state: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M1-002 (#1324): pack device_slot[31:0] | vendor[47:32] | iface[55:48] | state[63:56]. Labels prefixed kba_b1_.",
      block: {
        mov r10, 0xFFFFFFFF;
        cmp rdi, r10;
        ja  kba_b1_bad;
        mov r10, 0xFFFF;
        cmp rsi, r10;
        ja  kba_b1_bad;
        cmp rdx, 3;
        ja  kba_b1_bad;
        cmp rcx, 3;
        ja  kba_b1_bad;

        mov rax, rdi;
        and rax, 0xFFFFFFFF;
        mov r10, rsi;
        and r10, 0xFFFF;
        shl r10, 32;
        or  rax, r10;
        mov r10, rdx;
        and r10, 0xFF;
        shl r10, 48;
        or  rax, r10;
        mov r10, rcx;
        and r10, 0xFF;
        shl r10, 56;
        or  rax, r10;
        ret;
      kba_b1_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  pub let kba_body2_pack : (u64) -> u64 !{} @{} =
    fn (hci_version: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "R39.M1-002 (#1324): pack hci_version[7:0] | reserved[63:8]=0. Labels prefixed kba_b2_.",
      block: {
        cmp rdi, 13;
        ja  kba_b2_bad;
        mov rax, rdi;
        and rax, 0xFF;
        ret;
      kba_b2_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
        ret
      }
    }

  // ==========================================================================
  // Tail alloc / valid / free -- THE ONE WRITER of _bt_adapter_table.
  // ==========================================================================

  pub let kba_tail_alloc : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (hdr: u64) (adapter_key: u64) (body1: u64) (body2: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M1-002 (#1324): claim one BT ADAPTER row. THE ONE WRITER. Labels prefixed kba_ta_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;
        mov r13, rsi;
        mov r14, rdx;
        mov r15, rcx;

        mov rax, r12;
        shr rax, 56;
        cmp rax, 0;
        jne kba_ta_bad;

        cmp r13, 0;
        je  kba_ta_bad;

        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp r14, r10;
        je  kba_ta_bad;
        cmp r15, r10;
        je  kba_ta_bad;

        xor rbx, rbx;
      kba_ta_scan:
        cmp rbx, 8;
        jae kba_ta_enospc;

        lea r10, [rip + _bt_adapter_table];
        mov r11, rbx;
        shl r11, 5;
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  kba_ta_claim;

        add rbx, 1;
        jmp kba_ta_scan;

      kba_ta_claim:
        mov rax, r12;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  r13;
        mov [r10 + 16], r14;
        mov [r10 + 24], r15;
        mov rax, rbx;
        jmp kba_ta_out;

      kba_ta_enospc:
        mov rax, 0xFFFFF14F;
        jmp kba_ta_out;
      kba_ta_bad:
        mov rax, 0xFFFFF14E;

      kba_ta_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let kba_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M1-002 (#1324): 1 iff row_id<MAX and in_use. Labels prefixed kba_tvr_.",
      block: {
        cmp rdi, 8;
        jae kba_tvr_no;
        lea r10, [rip + _bt_adapter_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  kba_tvr_no;
        mov rax, 1;
        ret;
      kba_tvr_no:
        xor rax, rax;
        ret
      }
    }

  pub let kba_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M1-002 (#1324): scrub one row. Labels prefixed kba_tf_.",
      block: {
        cmp rdi, 8;
        jae kba_tf_out;
        lea r10, [rip + _bt_adapter_table];
        mov r11, rdi;
        shl r11, 5;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
      kba_tf_out:
        ret
      }
    }

  // ==========================================================================
  // Row accessors.
  // ==========================================================================

  pub let kba_row_key : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M1-002 (#1324): adapter_key. Labels prefixed kba_rk_.",
      block: {
        push r12;
        mov r12, rdi;
        call kba_tail_valid;
        cmp rax, 0;
        je  kba_rk_bad;
        lea r10, [rip + _bt_adapter_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 8];
        jmp kba_rk_out;
      kba_rk_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      kba_rk_out:
        pop r12;
        ret
      }
    }

  pub let kba_row_device : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M1-002 (#1324): device_slot (body1[31:0]). Labels prefixed kba_rd_.",
      block: {
        push r12;
        mov r12, rdi;
        call kba_tail_valid;
        cmp rax, 0;
        je  kba_rd_bad;
        lea r10, [rip + _bt_adapter_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        and rax, 0xFFFFFFFF;
        jmp kba_rd_out;
      kba_rd_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      kba_rd_out:
        pop r12;
        ret
      }
    }

  pub let kba_row_vendor : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M1-002 (#1324): controller_vendor (body1[47:32]). Labels prefixed kba_rv_.",
      block: {
        push r12;
        mov r12, rdi;
        call kba_tail_valid;
        cmp rax, 0;
        je  kba_rv_bad;
        lea r10, [rip + _bt_adapter_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 32;
        and rax, 0xFFFF;
        jmp kba_rv_out;
      kba_rv_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      kba_rv_out:
        pop r12;
        ret
      }
    }

  pub let kba_row_iface : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M1-002 (#1324): interface_num (body1[55:48]). Labels prefixed kba_ri_.",
      block: {
        push r12;
        mov r12, rdi;
        call kba_tail_valid;
        cmp rax, 0;
        je  kba_ri_bad;
        lea r10, [rip + _bt_adapter_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 48;
        and rax, 0xFF;
        jmp kba_ri_out;
      kba_ri_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      kba_ri_out:
        pop r12;
        ret
      }
    }

  pub let kba_row_state : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M1-002 (#1324): state (body1[63:56]). Labels prefixed kba_rst_.",
      block: {
        push r12;
        mov r12, rdi;
        call kba_tail_valid;
        cmp rax, 0;
        je  kba_rst_bad;
        lea r10, [rip + _bt_adapter_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 56;
        and rax, 0xFF;
        jmp kba_rst_out;
      kba_rst_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      kba_rst_out:
        pop r12;
        ret
      }
    }

  pub let kba_row_hci_ver : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M1-002 (#1324): hci_version (body2[7:0]). Labels prefixed kba_rh_.",
      block: {
        push r12;
        mov r12, rdi;
        call kba_tail_valid;
        cmp rax, 0;
        je  kba_rh_bad;
        lea r10, [rip + _bt_adapter_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 24];
        and rax, 0xFF;
        jmp kba_rh_out;
      kba_rh_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      kba_rh_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // kba_row_transition(row_id, new_state) — the ONE MUTATOR of state.
  // Legal edges: RESET -> INIT, INIT -> RUNNING, RUNNING -> ERROR,
  // ERROR -> RESET, any state -> RESET (tear-down).
  // ==========================================================================

  pub let kba_row_transition : (u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64) (new_state: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M1-002 (#1324): mutate state field on one row. Legal FSM edges enumerated. Labels prefixed kba_rt_.",
      block: {
        push r12;
        push r13;

        mov r12, rdi;
        mov r13, rsi;

        mov rdi, r12;
        call kba_tail_valid;
        cmp rax, 0;
        je  kba_rt_bad;

        mov rdi, r13;
        call kba_state_valid;
        cmp rax, 0;
        je  kba_rt_bad;

        lea r10, [rip + _bt_adapter_table];
        mov r11, r12;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 16];
        shr rax, 56;
        and rax, 0xFF;

        // Any state -> RESET (0) is legal.
        cmp r13, 0;
        je  kba_rt_apply;
        // RESET (0) -> INIT (1)
        cmp rax, 0;
        je  kba_rt_from0;
        // INIT (1) -> RUNNING (2)
        cmp rax, 1;
        je  kba_rt_from1;
        // RUNNING (2) -> ERROR (3)
        cmp rax, 2;
        je  kba_rt_from2;
        jmp kba_rt_bad;

      kba_rt_from0:
        cmp r13, 1;
        je  kba_rt_apply;
        jmp kba_rt_bad;
      kba_rt_from1:
        cmp r13, 2;
        je  kba_rt_apply;
        jmp kba_rt_bad;
      kba_rt_from2:
        cmp r13, 3;
        je  kba_rt_apply;
        jmp kba_rt_bad;

      kba_rt_apply:
        mov rax, [r10 + 16];
        mov r11, 0xFF;
        shl r11, 56;
        not r11;
        and rax, r11;
        mov r11, r13;
        and r11, 0xFF;
        shl r11, 56;
        or  rax, r11;
        mov [r10 + 16], rax;

        mov rdi, 2;
        call kba_note;
        xor rax, rax;
        jmp kba_rt_out;

      kba_rt_bad:
        mov rax, 0xFFFFF140;

      kba_rt_out:
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Lookups.
  // ==========================================================================

  pub let kba_find_by_key : (u64) -> u64 !{mem} @{} =
    fn (adapter_key: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R39.M1-002 (#1324): live row holding adapter_key, or ROW_NONE. Refuses to match 0. Labels prefixed kba_fk_.",
      block: {
        cmp rdi, 0;
        je  kba_fk_none;
        xor rcx, rcx;
      kba_fk_scan:
        cmp rcx, 8;
        jae kba_fk_none;
        lea r10, [rip + _bt_adapter_table];
        mov r11, rcx;
        shl r11, 5;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  kba_fk_next;
        mov rax, [r10 + 8];
        cmp rax, rdi;
        je  kba_fk_hit;
      kba_fk_next:
        add rcx, 1;
        jmp kba_fk_scan;
      kba_fk_hit:
        mov rax, rcx;
        ret;
      kba_fk_none:
        mov rax, 0xFF;
        ret
      }
    }

  pub let kba_row_of_slot : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R39.M1-002 (#1324): slot -> row_id, gated on live KIND_BT_ADAPTER. Labels prefixed kba_ros_.",
      block: {
        push r12;

        mov r11, 256;
        cmp rdi, r11;
        jae kba_ros_none;

        lea rax, [rip + cap_table];
        mov r8, rdi;
        shl r8, 3;
        mov r9, rdi;
        shl r9, 4;
        add r8, r9;
        add rax, r8;

        mov r10, [rax + 0];
        mov r11, 0x182;
        cmp r10, r11;
        jne kba_ros_none;

        mov r12, [rax + 16];
        mov r10, 0xFFFF;
        and r12, r10;

        mov rdi, r12;
        call kba_tail_valid;
        cmp rax, 0;
        je  kba_ros_none;

        mov rax, r12;
        jmp kba_ros_out;

      kba_ros_none:
        mov rax, 0xFF;
      kba_ros_out:
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // Mint.  Five args -- device_slot / vendor / iface / state / hci_ver
  // packed in packed_cfg to fit the ABI:
  //
  //   packed_cfg encoding:
  //     [15:0]   device_slot
  //     [31:16]  controller_vendor
  //     [39:32]  interface_num
  //     [47:40]  state (must be 0 = RESET at mint)
  //     [55:48]  hci_version
  //     [63:56]  reserved (must be zero)
  // ==========================================================================

  pub let bt_adapter_cap_mint_inner : (u64, u64, u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) (parent_slot: u64) (rights: u64) (adapter_key: u64) (packed_cfg: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R39.M1-002 (#1324): mint KIND_BT_ADAPTER over KIND_DEVICE. Sequence: slot<256; check_parent; rights_valid; unpack; check_device; vendor_valid; iface_valid; state==RESET; hci_ver_valid; adapter_key non-zero (NO_KEY); uniqueness (IN_USE); pack; tail_alloc; cap_mint_write. Labels prefixed kba_mi_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;

        mov rbx, rdi;                    // slot
        mov r12, rsi;                    // parent_slot
        mov r13, rdx;                    // rights
        mov r14, rcx;                    // adapter_key
        mov rbp, r8;                     // packed_cfg

        mov r10, 256;
        cmp rbx, r10;
        jae kba_mi_bad_slot;

        mov rdi, r12;
        call kba_check_parent;
        cmp rax, 0;
        je  kba_mi_bad_parent;

        mov rdi, r13;
        call kba_rights_valid;
        cmp rax, 0;
        je  kba_mi_bad_rights;

        // Reserved [63:56] must be zero.
        mov r10, rbp;
        shr r10, 56;
        cmp r10, 0;
        jne kba_mi_bad_arg;

        // device_slot check
        mov r10, rbp;
        and r10, 0xFFFF;
        mov r15, r10;                    // device_slot -> r15
        mov rdi, r15;
        call kba_check_device;
        cmp rax, 0;
        je  kba_mi_bad_device;

        // vendor_valid
        mov r10, rbp;
        shr r10, 16;
        and r10, 0xFFFF;
        mov rdi, r10;
        call kba_vendor_valid;
        cmp rax, 0;
        je  kba_mi_bad_vendor;

        // iface_valid
        mov r10, rbp;
        shr r10, 32;
        and r10, 0xFF;
        mov rdi, r10;
        call kba_iface_valid;
        cmp rax, 0;
        je  kba_mi_bad_iface;

        // state must be 0 at mint (RESET).
        mov r10, rbp;
        shr r10, 40;
        and r10, 0xFF;
        cmp r10, 0;
        jne kba_mi_bad_state;

        // hci_ver_valid
        mov r10, rbp;
        shr r10, 48;
        and r10, 0xFF;
        mov rdi, r10;
        call kba_hci_ver_valid;
        cmp rax, 0;
        je  kba_mi_bad_hci_ver;

        cmp r14, 0;
        je  kba_mi_no_key;

        mov rdi, r14;
        call kba_find_by_key;
        cmp rax, 0xFF;
        jne kba_mi_in_use;

        // Pack body1 (device_slot, vendor, iface, state=0).
        mov rdi, r15;
        mov rsi, rbp;
        shr rsi, 16;
        and rsi, 0xFFFF;
        mov rdx, rbp;
        shr rdx, 32;
        and rdx, 0xFF;
        mov rcx, 0;                      // state = RESET
        call kba_body1_pack;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  kba_mi_bad_state;
        mov r15, rax;                    // body1 -> r15

        // Pack body2 (hci_version).
        mov rdi, rbp;
        shr rdi, 48;
        and rdi, 0xFF;
        call kba_body2_pack;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  kba_mi_bad_hci_ver;
        push rax;                        // body2 on stack
        push r15;                        // body1 also on stack

        // Header.
        mov rdi, r12;
        call kba_hdr_pack;
        pop r15;                         // body1
        pop rbp;                         // body2
        mov r10, 0xFFFFFFFFFFFFFFFF;
        cmp rax, r10;
        je  kba_mi_bad_parent;

        // tail_alloc(hdr, adapter_key, body1, body2).
        mov rdi, rax;
        mov rsi, r14;
        mov rdx, r15;
        mov rcx, rbp;
        call kba_tail_alloc;

        mov r10, 0xFFFFF14F;
        cmp rax, r10;
        je  kba_mi_enospc;
        mov r10, 0xFFFFF14E;
        cmp rax, r10;
        je  kba_mi_bad_arg;

        mov r15, rax;                    // row_id
        mov r11, rbx;
        shl r11, 16;
        or  r15, r11;

        mov rdi, rbx;
        mov rsi, 0x182;
        mov rdx, r13;
        mov rcx, r15;
        call cap_mint_write;

        mov rdi, 0;
        call kba_note;

        xor rax, rax;
        jmp kba_mi_out;

      kba_mi_bad_slot:
        mov rax, 0xFFFFF143;
        jmp kba_mi_out;
      kba_mi_bad_parent:
        mov rax, 0xFFFFF14D;
        jmp kba_mi_out;
      kba_mi_bad_rights:
        mov rax, 0xFFFFF14C;
        jmp kba_mi_out;
      kba_mi_bad_device:
        mov rax, 0xFFFFF14B;
        jmp kba_mi_out;
      kba_mi_bad_vendor:
        mov rax, 0xFFFFF14A;
        jmp kba_mi_out;
      kba_mi_bad_iface:
        mov rax, 0xFFFFF149;
        jmp kba_mi_out;
      kba_mi_bad_state:
        mov rax, 0xFFFFF148;
        jmp kba_mi_out;
      kba_mi_bad_hci_ver:
        mov rax, 0xFFFFF147;
        jmp kba_mi_out;
      kba_mi_no_key:
        mov rax, 0xFFFFF146;
        jmp kba_mi_out;
      kba_mi_in_use:
        mov rdi, 3;
        call kba_note;
        mov rax, 0xFFFFF144;
        jmp kba_mi_out;
      kba_mi_enospc:
        mov rdi, 3;
        call kba_note;
        mov rax, 0xFFFFF145;
        jmp kba_mi_out;
      kba_mi_bad_arg:
        mov rax, 0xFFFFF14E;

      kba_mi_out:
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Revoke.
  // ==========================================================================

  pub let bt_adapter_cap_revoke_inner : (u64) -> u64 !{mem} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "R39.M1-002 (#1324): revoke KIND_BT_ADAPTER. Labels prefixed kba_rvk_.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov r12, rdi;

        mov r10, 256;
        cmp r12, r10;
        jae kba_rvk_bad_slot;

        lea rax, [rip + cap_table];
        mov r8, r12;
        shl r8, 3;
        mov r9, r12;
        shl r9, 4;
        add r8, r9;
        add rax, r8;
        mov rbx, rax;

        mov r10, [rbx + 0];
        cmp r10, 0;
        je  kba_rvk_already;

        mov r11, 0x182;
        cmp r10, r11;
        jne kba_rvk_wrong_kind;

        mov r13, [rbx + 16];
        mov r10, 0xFFFF;
        and r13, r10;

        mov rdi, r13;
        call kba_tail_valid;
        cmp rax, 0;
        je  kba_rvk_clear;

        mov rdi, r13;
        call kba_tail_free;

      kba_rvk_clear:
        mov rdi, r12;
        xor rsi, rsi;
        xor rdx, rdx;
        xor rcx, rcx;
        call cap_mint_write;

        mov rdi, 1;
        call kba_note;

        xor rax, rax;
        jmp kba_rvk_out;

      kba_rvk_bad_slot:
        mov rax, 0xFFFFF143;
        jmp kba_rvk_out;
      kba_rvk_wrong_kind:
        mov rax, 0xFFFFF142;
        jmp kba_rvk_out;
      kba_rvk_already:
        mov rax, 0xFFFFF141;

      kba_rvk_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // Dispatch handler.  Queries only.
  // ==========================================================================

  pub let cap_handler_bt_adapter : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rights: u64) (target_ptr: u64) (op_arg: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R39.M1-002 (#1324): KIND_BT_ADAPTER dispatch. Query ops require INVOKE; DEBUG_PRINT requires OBSERVE. All ops arity ONE -- op_arg[63:8] REFUSED. Labels prefixed kba_hn_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push rbp;

        mov r12, rdi;
        mov r13, rsi;
        mov r10, 0xFFFF;
        and r13, r10;
        mov r14, rdx;

        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + cap_bt_adapter_msg];
        call klog_s1;

        mov r10, r14;
        and r10, 0xFF;
        mov rbp, r10;
        mov r11, r14;
        shr r11, 8;
        cmp r11, 0;
        jne kba_hn_res;

        cmp rbp, 6;
        ja  kba_hn_unsup;

        cmp rbp, 6;
        je  kba_hn_dbg;

        // Ops 0..5: INVOKE.
        mov r10, r12;
        and r10, 0x008;
        cmp r10, 0;
        je  kba_hn_denied;

        mov rdi, r13;
        cmp rbp, 0;
        je  kba_hn_key;
        cmp rbp, 1;
        je  kba_hn_dev;
        cmp rbp, 2;
        je  kba_hn_ven;
        cmp rbp, 3;
        je  kba_hn_ifc;
        cmp rbp, 4;
        je  kba_hn_st;
        call kba_row_hci_ver;
        jmp kba_hn_out;

      kba_hn_key:
        call kba_row_key;
        jmp kba_hn_out;
      kba_hn_dev:
        call kba_row_device;
        jmp kba_hn_out;
      kba_hn_ven:
        call kba_row_vendor;
        jmp kba_hn_out;
      kba_hn_ifc:
        call kba_row_iface;
        jmp kba_hn_out;
      kba_hn_st:
        call kba_row_state;
        jmp kba_hn_out;

      kba_hn_dbg:
        mov r10, r12;
        and r10, 0x400;
        cmp r10, 0;
        je  kba_hn_denied;
        xor rax, rax;
        jmp kba_hn_out;

      kba_hn_res:
        mov rax, 0xFFFFF14E;
        jmp kba_hn_out;
      kba_hn_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;
        jmp kba_hn_out;
      kba_hn_unsup:
        mov rax, 0xFFFFFFFFFFFFFFFC;

      kba_hn_out:
        pop rbp;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
