// src/kernel/core/cap/kind_surface.pdx -- R113.M1-001 (paideia-os #2381)
//
// KIND_SURFACE = 0x1B8 kernel-side substrate (row pool + mint + destroy).
// Design authority: design/graphics/r113-m1-substrate.md (FROZEN 2026-09-08,
// commit 1988e50).  Wave 12 attempted this landing three times and rolled
// back for four independent collisions (kind-id, row layout, failure band,
// fingerprint allowlist gap).  The freeze doc §§1-8 nails the identity,
// row layout, rights, accessors, failure band, pool substrate, bridge
// policy and fingerprint tags so this retry cannot re-hit any of them.
//
// -----------------------------------------------------------------------------
// SIBLING FILE (paideia-os #2423 reconciliation, 2026-09-08)
// -----------------------------------------------------------------------------
//
// This file is the KERNEL-SIDE substrate.  The USER-SIDE vocabulary
// authority lives at src/user/compositor/surface_kind.pdx (Wave-0
// Batch-6 landing, paideia-os #2246).  Both files are live and
// authoritative on disjoint concerns:
//
//   User-side  (src/user/compositor/surface_kind.pdx):
//     * KIND_SURFACE = 0x1B8 identity (line 102 -- THE canonical
//       declaration; this file's KIND_SURFACE_ID mirrors that value).
//     * R_SURFACE_* rights bitmask (canonical; this file re-declares
//       the same literals).
//     * SURFACE_OP_* op numbering (canonical; the dispatcher below
//       branches on those numbers).
//     * User-side mint-facing failure band 0xFFFFEEF1..0xFFFFEEFA
//       (raised by user-side mint validators, disjoint from this
//       file's kernel-side band 0xFFFFE110..0xFFFFE11F).
//
//   Kernel-side (this file):
//     * _surface_table row pool (16 rows x 64 bytes, LAM generation).
//     * surface_row_* accessor family (§4 of the design doc).
//     * surface_mint / surface_destroy asm bodies.
//     * R_SURFACE_KGATE_* dispatcher aliases.
//     * Kernel-side substrate failure band 0xFFFFE110..0xFFFFE11F.
//     * Five R113.M1 fingerprint tags (SURFACE MINT/DESTROY/COMMIT/
//       FMT BIND/PRESENT OK).
//
// paideia-as has no cross-boundary import mechanism today, so the
// identity + rights literals are declared in both files with cross-
// reference comments naming the sibling; a build-time grep-based
// verify-kind-parity.sh check is the design-doc follow-up
// (design/graphics/r113-m1-substrate.md §7 + §7.1).  Any edit to
// KIND_SURFACE_ID or the R_SURFACE_* values in this file MUST land
// in lockstep with the sibling declarations at
// src/user/compositor/surface_kind.pdx:102 and :131-140.  #2423 was
// filed to reconcile the two after Wave-12 collapse attempts; the
// design doc §7.1 is the frozen single-source-of-truth resolution.
//
// SCOPE OF THIS LANDING (per issue #2381 + doc §9 milestone graph):
//   * The KIND_SURFACE = 0x1B8 identity is REUSED from the pre-existing
//     user-side declaration at src/user/compositor/surface_kind.pdx:102.
//     Per doc §7 there is no cross-boundary import mechanism in
//     paideia-as today, so we declare the literal 0x1B8 with a comment
//     naming the user-side authority.  A grep-based verify-kind-parity
//     check is design/graphics/r113-m1-substrate.md §7's follow-up.
//   * Rights bitmask REUSED from surface_kind.pdx §Section 3, NOT the
//     stale osarch briefing that shipped with the issue.  Per doc §3
//     the briefing's rights values collide with three landed user-side
//     kinds that already gate on the pre-existing values; the invariant
//     wins.
//   * Row layout matches doc §2 byte-for-byte (offsets 0/8/16/24/32/40/
//     48/56, packed encodings named there).
//   * Failure band 0xFFFFE110..0xFFFFE11F verified free by the 1528-code
//     tree-wide sweep documented in doc §5.1.
//   * All five R113.M1 fingerprint tags (mint / destroy / commit /
//     fmt bind / present) land here as byte arrays; the mint + destroy
//     emitters are wired below.  The three "not yet wired" emitters
//     (commit for M1-002 #2382, fmt bind for M1-004 #2384, present for
//     M1-005 #2385) live here as data-only tags with allowlist entries
//     in tools/verify-fingerprint-coverage.sh naming their landing PRs.
//   * Row accessors match doc §4 signatures verbatim (no argument order
//     drift, no return-shape deviation).
//
// ENCODER PITFALLS (per feedback_pdx_encoder_pitfalls v0.36+):
//   * No `test rN, rN` -- every zero-check uses `cmp rN, 0` + `je/jne`.
//   * No 2-op `imul r, imm` -- row-offset math uses `shl r, 6` for *64.
//   * No `and reg, imm64` -- 48/56-bit masks are loaded into a scratch
//     register via `mov r64, imm64` first, then the and takes two regs.
//     The 32-bit mask 0xFFFFFFFF is safe as `and reg, 0xFFFFFFFF` per
//     the tui_canvas/kind_gpu_bo precedent (paideia-as encodes it via
//     a form that does NOT sign-extend for that value).
//   * No `cmp reg, [mem]` -- every mem compare loads to a scratch first.
//   * No literal-scaled `[reg + N*8]` -- displacement form `[reg + 8N]`
//     used throughout.  Register-scaled `[reg + rcx * 8]` (with 8 in
//     the SIB-legal {1,2,4,8} set) is used in the stats bumpers as the
//     kek/tui precedent already establishes.
//
// LABEL PREFIX: `s` prefixes on the substrate leaves and `sm_` / `sd_`
// on the mint / destroy bodies.  All prefixes avoid the paideia-as
// reserved-keyword set per feedback_paideia_as_reserved_labels
// (`loop`, `if`, `let`, `while`, `for`, `match`, `pub`, `mod`, `use`,
// `fn`, `struct`, `enum`, `impl`, `trait`, `type`, `where`, `move`,
// `mut`, `ref`).

module KindSurface = structure {

  // ==========================================================================
  // Identity (doc §1).  Declared as a literal here; the sole authority
  // for KIND_SURFACE = 0x1B8 is src/user/compositor/surface_kind.pdx:102
  // (frozen G7.M2-001, #2246).  See doc §7 for the bridge policy
  // rationale (kernel + user-side both declare the literal with cross-
  // reference comments; a build-time grep gate is the parity check).
  // ==========================================================================

  pub let KIND_SURFACE_ID       : u64 = 0x1B8       // authority: user surface_kind.pdx:102
  pub let KIND_SURFACE_BASE     : u64 = 5           // = KIND_IPC_ENDPOINT

  // ==========================================================================
  // Rights bitmask (doc §3).  REUSED VERBATIM from the pre-existing
  // user-side declarations at src/user/compositor/surface_kind.pdx:131-140.
  // The R113 osarch briefing proposed a different bitmask (see doc §3.1
  // conflict table) which is REJECTED: adopting it would collide with
  // three landed user-side kinds (window_kind, damage_kind, subsurface_
  // sync) that already gate on the pre-existing values.  Per doc §7
  // both sides declare the same literal values as the identity.
  // ==========================================================================

  pub let R_SURFACE_READ            : u64 = 0x001
  pub let R_SURFACE_INVOKE          : u64 = 0x008
  pub let R_SURFACE_REVOKE          : u64 = 0x010
  pub let R_SURFACE_QUERY_GEOMETRY  : u64 = 0x020
  pub let R_SURFACE_ATTACH_BUFFER   : u64 = 0x040
  pub let R_SURFACE_COMMIT          : u64 = 0x080
  pub let R_SURFACE_DAMAGE          : u64 = 0x100
  pub let R_SURFACE_MINT            : u64 = 0x200
  pub let R_SURFACE_OBSERVE         : u64 = 0x400
  pub let R_SURFACE_ALL             : u64 = 0x7F9

  // ==========================================================================
  // Coarse-grain kernel dispatcher gate aliases (doc §3.2).  The R113
  // kernel-side dispatcher expects a 5-way access gate (query, commit,
  // damage, attach, destroy).  These aliases synthesize that gate from
  // the pre-existing rights bits so M1-001..M1-005 dispatchers can gate
  // on a named alias rather than on briefing-named literals.
  // ==========================================================================

  pub let R_SURFACE_KGATE_QUERY   : u64 = 0x021     // READ | QUERY_GEOMETRY
  pub let R_SURFACE_KGATE_COMMIT  : u64 = 0x080     // = R_SURFACE_COMMIT
  pub let R_SURFACE_KGATE_DAMAGE  : u64 = 0x100     // = R_SURFACE_DAMAGE
  pub let R_SURFACE_KGATE_ATTACH  : u64 = 0x040     // = R_SURFACE_ATTACH_BUFFER
  pub let R_SURFACE_KGATE_DESTROY : u64 = 0x010     // = R_SURFACE_REVOKE

  // ==========================================================================
  // Row layout offsets (doc §2 -- FROZEN byte-for-byte).
  //
  //   +0   hdr     in_use[63:56] | generation[55:0]  (56-bit LAM ABA)
  //   +8   ident   surface_id (u64; monotonic, unique)
  //   +16  owner   owner_task_id (u64)
  //   +24  dims    wh_packed = w[63:32] | h[31:0]
  //   +32  format  format_fourcc[31:0] | flags[63:32]
  //   +40  state   state[63:48] | next_serial[47:0]
  //   +48  damage  dx[15:0] | dy[31:16] | dw[47:32] | dh[63:48]
  //   +56  buffers pending_bo[31:0] | current_bo[63:32]
  //
  // Wave 12's M1-002 SC_OFF_* offsets are DISCARDED (doc §2.1); any
  // R113 sibling that consumes this substrate reads via the SRF_OFF_*
  // constants below and the typed accessors in §4.
  // ==========================================================================

  pub let SRF_OFF_HDR         : u64 = 0
  pub let SRF_OFF_SURFACE_ID  : u64 = 8
  pub let SRF_OFF_OWNER       : u64 = 16
  pub let SRF_OFF_WH          : u64 = 24
  pub let SRF_OFF_FORMAT      : u64 = 32
  pub let SRF_OFF_STATE_SER   : u64 = 40
  pub let SRF_OFF_DAMAGE      : u64 = 48
  pub let SRF_OFF_BUFFERS     : u64 = 56

  pub let SURFACE_ROW_BYTES   : u64 = 64
  pub let SURFACE_ROW_WORDS   : u64 = 8

  // ==========================================================================
  // Failure taxonomy (doc §5 -- FROZEN, verified free by 1528-code sweep
  // recorded at doc §5.1).  0xFFFFE111 and 0xFFFFE112 are reserved for
  // M2 additions per the doc.
  // ==========================================================================

  pub let SURFACE_OK                    : u64 = 0
  pub let SURFACE_TAIL_ENOSPC           : u64 = 0xFFFFE11F
  pub let SURFACE_TAIL_BAD_ARG          : u64 = 0xFFFFE11E
  pub let SURFACE_MINT_BAD_OWNER        : u64 = 0xFFFFE11D
  pub let SURFACE_MINT_BAD_DIMS         : u64 = 0xFFFFE11C
  pub let SURFACE_MINT_BAD_FORMAT       : u64 = 0xFFFFE11B
  pub let SURFACE_MINT_BAD_FLAGS        : u64 = 0xFFFFE11A
  pub let SURFACE_MINT_BAD_RIGHTS       : u64 = 0xFFFFE119
  pub let SURFACE_ATTACH_BAD_BO         : u64 = 0xFFFFE118
  pub let SURFACE_COMMIT_STALE_SERIAL   : u64 = 0xFFFFE117
  pub let SURFACE_SWAP_NO_PENDING       : u64 = 0xFFFFE116
  pub let SURFACE_STATE_DESTROYED       : u64 = 0xFFFFE115
  pub let SURFACE_DESTROY_ALREADY       : u64 = 0xFFFFE114
  pub let SURFACE_GEN_MISMATCH          : u64 = 0xFFFFE113
  pub let SURFACE_BAD_SLOT              : u64 = 0xFFFFE110
  pub let SURFACE_DECODE_BAD            : u64 = 0xFFFFFFFFFFFFFFFF

  // ==========================================================================
  // Pool substrate (doc §6).  16 rows * 64 bytes = 1 KiB, one page-
  // aligned allocation, matches the working-set posture of
  // _color_profile_table (16 x 32 = 512 B) and _window_table (32 x 32
  // = 1 KiB).  Sized deliberately small for M1; R113.M2 window-manager
  // work will bump SURFACE_ROW_MAX (single-constant edit) after M1 lands.
  // ==========================================================================

  pub let SURFACE_ROW_MAX     : u64 = 16

  pub let mut _surface_table   : [u64; 128] = uninit @align(64)  // 16 * 8
  pub let mut _surface_stats   : [u64; 4]   = uninit @align(64)
  pub let mut _surface_next_id : u64        = uninit @align(8)

  pub let SURFACE_ST_MINTS    : u64 = 0
  pub let SURFACE_ST_DESTROYS : u64 = 1
  pub let SURFACE_ST_REFUSED  : u64 = 2
  pub let SURFACE_ST_COMMITS  : u64 = 3
  pub let SURFACE_ST_MAX      : u64 = 4

  // ==========================================================================
  // Fingerprint tags (doc §8 -- FROZEN).  All five land in THIS PR per
  // doc §8's Wave-12-lesson mandate: SURFACE COMMIT OK was the
  // fingerprint-allowlist gap that ate one of the Wave-12 rollbacks.
  // Landing all five together (mint + destroy emit here; commit / fmt
  // bind / present tags land as data with allowlist entries pointing at
  // M1-002 / M1-004 / M1-005 as the emitter-wiring landings) prevents
  // that gap from re-opening.  Byte counts verified by hand:
  //
  //   "surface mint ok [legacy: SURFACE MINT OK]\0"        = 42 bytes
  //   "surface destroy ok [legacy: SURFACE DESTROY OK]\0"  = 48 bytes
  //   "surface commit ok [legacy: SURFACE COMMIT OK]\0"    = 46 bytes
  //   "surface fmt bind ok [legacy: SURFACE FMT BIND OK]\0"= 50 bytes
  //   "surface present ok [legacy: SURFACE PRESENT OK]\0"  = 48 bytes
  // ==========================================================================

  pub let surface_mint_ok_msg    : [u8; 42] = "surface mint ok [legacy: SURFACE MINT OK]\0"
  pub let surface_destroy_ok_msg : [u8; 48] = "surface destroy ok [legacy: SURFACE DESTROY OK]\0"
  pub let surface_commit_ok_msg  : [u8; 46] = "surface commit ok [legacy: SURFACE COMMIT OK]\0"
  pub let surface_fmt_bind_ok_msg: [u8; 50] = "surface fmt bind ok [legacy: SURFACE FMT BIND OK]\0"
  pub let surface_present_ok_msg : [u8; 48] = "surface present ok [legacy: SURFACE PRESENT OK]\0"

  // Key name for klog_s1_x1 KV emission ("sid" = surface id).
  pub let surface_k_sid : [u8; 4] = "sid\0"

  // ==========================================================================
  // Stats bumpers.  Four straight-line load-inc-store leaves in the
  // kek_note / tui_stats_bump_* style.  THE ONLY WRITERS of
  // _surface_stats -- callers in cap_handler_surface (M1-001 follow-on)
  // and the M1-002 commit-txn body reach these via named leaves rather
  // than a bare index-dispatched note helper, mirroring the tui_canvas
  // narrow-writer discipline (§Stats bookkeeping in kind_tui_canvas.pdx).
  // ==========================================================================

  pub let surface_stats_bump_mints : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M1-001 (#2381): bump _surface_stats[SURFACE_ST_MINTS=0]. Load-inc-store, no `add reg, [mem]`. Called from surface_mint success tail only.",
      block: {
        lea r10, [rip + _surface_stats];
        mov rax, [r10 + 0];
        add rax, 1;
        mov [r10 + 0], rax;
        ret
      }
    }

  pub let surface_stats_bump_destroys : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M1-001 (#2381): bump _surface_stats[SURFACE_ST_DESTROYS=1]. Load-inc-store, no `add reg, [mem]`. Called from surface_destroy success tail only.",
      block: {
        lea r10, [rip + _surface_stats];
        mov rax, [r10 + 8];
        add rax, 1;
        mov [r10 + 8], rax;
        ret
      }
    }

  pub let surface_stats_bump_refused : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M1-001 (#2381): bump _surface_stats[SURFACE_ST_REFUSED=2]. Load-inc-store, no `add reg, [mem]`. Called from surface_mint's shared refusal funnel, mirroring tui_stats_bump_refused's narrow scope (mint failures only, not destroy or dispatch).",
      block: {
        lea r10, [rip + _surface_stats];
        mov rax, [r10 + 16];
        add rax, 1;
        mov [r10 + 16], rax;
        ret
      }
    }

  pub let surface_stats_bump_commits : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M1-001 (#2381): bump _surface_stats[SURFACE_ST_COMMITS=3]. Load-inc-store, no `add reg, [mem]`. Distinct from tui_stats_bump_presents by design: commits are pending->current promotions (surface-scope), not physical scanout events. Consumers are R113.M1-002 (surface commit) and R113.M1-005 (present-fence).",
      block: {
        lea r10, [rip + _surface_stats];
        mov rax, [r10 + 24];
        add rax, 1;
        mov [r10 + 24], rax;
        ret
      }
    }

  // ==========================================================================
  // Boot init (kind_surface_init).  Zeroes the pool + stats + monotonic
  // id counter.  .bss is already zero at real boot; this is defensive
  // and gives a future chaos-restart witness a clean re-scrub point,
  // matching kind_tui_canvas_init / kind_volume_snapshot_init /
  // kind_kek_init in shape.  Three straight-line loops (row pool /
  // stats / id counter).
  // ==========================================================================

  pub let kind_surface_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M1-001 (#2381): zero _surface_table (128 u64 words = 1 KiB), _surface_stats (4 u64), _surface_next_id (1 u64). Defensive boot-time re-scrub, mirrors kind_kek_init one-for-one. Labels prefixed sinit_.",
      block: {
        lea r10, [rip + _surface_table];
        xor rax, rax;
        xor rcx, rcx;
      sinit_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 128;
        jb  sinit_rows;

        lea r10, [rip + _surface_stats];
        xor rcx, rcx;
      sinit_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 4;
        jb  sinit_stats;

        lea r10, [rip + _surface_next_id];
        mov [r10 + 0], rax;
        ret
      }
    }

  // ==========================================================================
  // Row accessors (doc §4 -- FROZEN ABI).  Every accessor takes a slot
  // (row index, NOT a cap_table slot); return-shape sentinels use
  // SURFACE_BAD_SLOT = 0xFFFFE110.  Labels prefixed with a two-letter
  // family + underscore (srv_ / sra_ / srsg_ / srss_ / etc.).
  // ==========================================================================

  // surface_row_valid(slot) -> 1 iff slot < SURFACE_ROW_MAX and the
  // row's in_use byte (top byte of hdr) is nonzero.
  pub let surface_row_valid : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M1-001 (#2381): 1 iff slot < SURFACE_ROW_MAX(16) and in_use set. Inlined address compute (slot*64 via shl 6) rather than a nested call, keeping this a pure leaf. Labels prefixed srv_.",
      block: {
        mov r10, [rip + SURFACE_ROW_MAX];
        cmp rdi, r10;
        jae srv_no;
        lea r10, [rip + _surface_table];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  srv_no;
        mov rax, 1;
        ret;
      srv_no:
        xor rax, rax;
        ret
      }
    }

  // surface_row_addr(slot) -> &_surface_table[slot*64] iff live; 0 otherwise.
  pub let surface_row_addr : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M1-001 (#2381): row base pointer post-liveness. Returns 0 on invalid slot (out-of-range OR in_use==0). Exported for M1-002's commit-txn body which performs an atomic multi-field update no typed getter can express (doc §4 note). Labels prefixed sra_.",
      block: {
        mov r10, [rip + SURFACE_ROW_MAX];
        cmp rdi, r10;
        jae sra_no;
        lea r10, [rip + _surface_table];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  sra_no;
        mov rax, r10;
        ret;
      sra_no:
        xor rax, rax;
        ret
      }
    }

  // surface_row_serial_get(slot) -> next_serial (low 48 bits) | SURFACE_BAD_SLOT.
  pub let surface_row_serial_get : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M1-001 (#2381): return row+40 low 48 bits. Mask 0x0000FFFFFFFFFFFF loaded via movabs (no `and reg, imm64`). Labels prefixed srsg_.",
      block: {
        mov r10, [rip + SURFACE_ROW_MAX];
        cmp rdi, r10;
        jae srsg_bad;
        lea r10, [rip + _surface_table];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  srsg_bad;
        mov rax, [r10 + 40];
        mov r11, 0x0000FFFFFFFFFFFF;
        and rax, r11;
        ret;
      srsg_bad:
        mov rax, 0xFFFFE110;
        ret
      }
    }

  // surface_row_serial_set(slot, serial) -> 0 | SURFACE_BAD_SLOT.
  // Writes low-48 preserving state high-16.
  pub let surface_row_serial_set : (u64, u64) -> u64 !{mem} @{} =
    fn (slot: u64) (serial: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M1-001 (#2381): write next_serial low-48 preserving state high-16. Two imm64 masks (0xFFFF000000000000 for state-preserve, 0x0000FFFFFFFFFFFF for serial-clip) loaded via movabs. Labels prefixed srss_.",
      block: {
        mov r10, [rip + SURFACE_ROW_MAX];
        cmp rdi, r10;
        jae srss_bad;
        lea r10, [rip + _surface_table];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  srss_bad;
        mov rax, [r10 + 40];
        mov r11, 0xFFFF000000000000;
        and rax, r11;
        mov r11, 0x0000FFFFFFFFFFFF;
        mov r8, rsi;
        and r8, r11;
        or  rax, r8;
        mov [r10 + 40], rax;
        xor rax, rax;
        ret;
      srss_bad:
        mov rax, 0xFFFFE110;
        ret
      }
    }

  // surface_row_pending_get(slot) -> pending_bo (low 32 of +56).
  // Returns 0 iff unset OR slot is invalid (0 is the sentinel for
  // "no pending buffer" in the design, so we do not disambiguate --
  // callers gate on surface_row_valid first when the distinction matters).
  pub let surface_row_pending_get : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M1-001 (#2381): read pending_bo (low 32 of row+56). 32-bit mask 0xFFFFFFFF safe as immediate per tui_canvas / kind_gpu_bo precedent. Labels prefixed srpg_.",
      block: {
        mov r10, [rip + SURFACE_ROW_MAX];
        cmp rdi, r10;
        jae srpg_zero;
        lea r10, [rip + _surface_table];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  srpg_zero;
        mov rax, [r10 + 56];
        and rax, 0xFFFFFFFF;
        ret;
      srpg_zero:
        xor rax, rax;
        ret
      }
    }

  // surface_row_pending_set(slot, bo) -> 0 | SURFACE_BAD_SLOT.
  // Writes low-32 of +56 preserving high-32 (current_bo). Rejects bo >= 2^32.
  pub let surface_row_pending_set : (u64, u64) -> u64 !{mem} @{} =
    fn (slot: u64) (bo: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M1-001 (#2381): write pending_bo (low 32 of row+56) preserving current_bo (high 32). Rejects bo >= 2^32 (out-of-range for the u32 field). Doc §4 pending_set contract. Labels prefixed srps_.",
      block: {
        mov r10, [rip + SURFACE_ROW_MAX];
        cmp rdi, r10;
        jae srps_bad;
        lea r10, [rip + _surface_table];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  srps_bad;
        mov rax, rsi;
        shr rax, 32;
        cmp rax, 0;
        jne srps_bad;
        mov rax, [r10 + 56];
        mov r11, 0xFFFFFFFF00000000;
        and rax, r11;
        mov r8, rsi;
        and r8, 0xFFFFFFFF;
        or  rax, r8;
        mov [r10 + 56], rax;
        xor rax, rax;
        ret;
      srps_bad:
        mov rax, 0xFFFFE110;
        ret
      }
    }

  // surface_row_current_get(slot) -> current_bo (high 32 of +56).
  pub let surface_row_current_get : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M1-001 (#2381): read current_bo (high 32 of row+56). shr 32 extracts high half. Labels prefixed srcg_.",
      block: {
        mov r10, [rip + SURFACE_ROW_MAX];
        cmp rdi, r10;
        jae srcg_zero;
        lea r10, [rip + _surface_table];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  srcg_zero;
        mov rax, [r10 + 56];
        shr rax, 32;
        ret;
      srcg_zero:
        xor rax, rax;
        ret
      }
    }

  // surface_row_current_set(slot, bo) -> 0 | SURFACE_BAD_SLOT.
  // Writes high-32 of +56 preserving low-32 (pending_bo). Rejects bo >= 2^32.
  pub let surface_row_current_set : (u64, u64) -> u64 !{mem} @{} =
    fn (slot: u64) (bo: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M1-001 (#2381): write current_bo (high 32 of row+56) preserving pending_bo (low 32). Rejects bo >= 2^32. Labels prefixed srcs_.",
      block: {
        mov r10, [rip + SURFACE_ROW_MAX];
        cmp rdi, r10;
        jae srcs_bad;
        lea r10, [rip + _surface_table];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  srcs_bad;
        mov rax, rsi;
        shr rax, 32;
        cmp rax, 0;
        jne srcs_bad;
        mov rax, [r10 + 56];
        and rax, 0xFFFFFFFF;
        mov r8, rsi;
        and r8, 0xFFFFFFFF;
        shl r8, 32;
        or  rax, r8;
        mov [r10 + 56], rax;
        xor rax, rax;
        ret;
      srcs_bad:
        mov rax, 0xFFFFE110;
        ret
      }
    }

  // surface_row_swap(slot) -> new_next_serial (post-bump) | SURFACE_BAD_SLOT.
  // Atomic swap: current <- pending, pending <- 0, bump next_serial.
  // Frame-flip primitive M1-002 commit-txn body and M1-005 present-fence
  // handler both call.
  pub let surface_row_swap : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M1-001 (#2381): current<-pending, pending<-0, bump next_serial. Returns post-bump next_serial (low 48) or SURFACE_BAD_SLOT. 48-bit mask via movabs. Labels prefixed srsw_.",
      block: {
        mov r10, [rip + SURFACE_ROW_MAX];
        cmp rdi, r10;
        jae srsw_bad;
        lea r10, [rip + _surface_table];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  srsw_bad;

        // Read pending from low 32 of +56, promote to high 32, zero low.
        mov rax, [r10 + 56];
        and rax, 0xFFFFFFFF;                 // rax = pending_bo
        shl rax, 32;                         // rax = pending << 32  (new current)
        mov [r10 + 56], rax;                 // write current in high, pending=0 in low

        // Bump next_serial preserving state high-16.
        mov rax, [r10 + 40];
        mov r11, 0xFFFF000000000000;
        mov r8, rax;
        and r8, r11;                         // r8 = state<<48
        mov r11, 0x0000FFFFFFFFFFFF;
        and rax, r11;                        // rax = next_serial low 48
        add rax, 1;
        and rax, r11;                        // clip to 48 bits
        mov r9, rax;                         // r9 = new_next_serial (return value)
        or  rax, r8;                         // reassemble state | serial
        mov [r10 + 40], rax;                 // write back

        mov rax, r9;                         // return new_next_serial
        ret;
      srsw_bad:
        mov rax, 0xFFFFE110;
        ret
      }
    }

  // surface_row_dims_get(slot) -> wh_packed (raw u64). Callers unpack.
  pub let surface_row_dims_get : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M1-001 (#2381): raw wh_packed load from row+24. Labels prefixed srdg_.",
      block: {
        mov r10, [rip + SURFACE_ROW_MAX];
        cmp rdi, r10;
        jae srdg_zero;
        lea r10, [rip + _surface_table];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  srdg_zero;
        mov rax, [r10 + 24];
        ret;
      srdg_zero:
        xor rax, rax;
        ret
      }
    }

  // surface_row_format_get(slot) -> format_fourcc | (flags<<32).
  pub let surface_row_format_get : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M1-001 (#2381): raw format+flags load from row+32. Labels prefixed srfg_.",
      block: {
        mov r10, [rip + SURFACE_ROW_MAX];
        cmp rdi, r10;
        jae srfg_zero;
        lea r10, [rip + _surface_table];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  srfg_zero;
        mov rax, [r10 + 32];
        ret;
      srfg_zero:
        xor rax, rax;
        ret
      }
    }

  // surface_row_format_set(slot, fourcc, flags) -> 0 | SURFACE_BAD_SLOT.
  // M1-004 first-attach: writes format_fourcc[31:0] | flags[63:32] as
  // one u64 store.  M1-004 also refuses second attach with a different
  // fourcc via SURFACE_MINT_BAD_FORMAT (that check lives on the M1-004
  // caller side; this leaf is a pure writer).
  pub let surface_row_format_set : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (slot: u64) (fourcc: u64) (flags: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M1-001 (#2381): write format+flags packed at row+32. Doc §4 signature (three-arg). Labels prefixed srfs_.",
      block: {
        mov r10, [rip + SURFACE_ROW_MAX];
        cmp rdi, r10;
        jae srfs_bad;
        lea r10, [rip + _surface_table];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  srfs_bad;
        mov rax, rsi;
        and rax, 0xFFFFFFFF;                 // fourcc low 32
        mov r8, rdx;
        and r8, 0xFFFFFFFF;                  // flags low 32
        shl r8, 32;                          // flags high half
        or  rax, r8;
        mov [r10 + 32], rax;
        xor rax, rax;
        ret;
      srfs_bad:
        mov rax, 0xFFFFE110;
        ret
      }
    }

  // surface_row_damage_get(slot) -> raw damage word.
  pub let surface_row_damage_get : (u64) -> u64 !{mem} @{} =
    fn (slot: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M1-001 (#2381): raw damage-bbox load from row+48. Labels prefixed srdmg_.",
      block: {
        mov r10, [rip + SURFACE_ROW_MAX];
        cmp rdi, r10;
        jae srdmg_zero;
        lea r10, [rip + _surface_table];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  srdmg_zero;
        mov rax, [r10 + 48];
        ret;
      srdmg_zero:
        xor rax, rax;
        ret
      }
    }

  // surface_row_damage_or(slot, rect) -> 0 | SURFACE_BAD_SLOT.
  // Bitwise-or accumulator per the accessor's own name (_or); M1-003
  // (damage compression, #2383) may layer a proper bbox-union body on
  // top of this leaf if the coarser semantic proves insufficient for
  // the OP_DAMAGE_ADD path.  For M1-001 the union semantic collapses
  // to `[+48] |= rect`, which preserves the zero-init "no damage" state
  // (0 | rect == rect) and lets M1-002 / M1-003 link against a real
  // symbol immediately.
  pub let surface_row_damage_or : (u64, u64) -> u64 !{mem} @{} =
    fn (slot: u64) (rect: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "R113.M1-001 (#2381): [+48] |= rect. Bitwise-or accumulator per accessor name; M1-003 damage compression (#2383) refines to true bbox union if needed. Labels prefixed srdo_.",
      block: {
        mov r10, [rip + SURFACE_ROW_MAX];
        cmp rdi, r10;
        jae srdo_bad;
        lea r10, [rip + _surface_table];
        mov r11, rdi;
        shl r11, 6;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  srdo_bad;
        mov rax, [r10 + 48];
        or  rax, rsi;
        mov [r10 + 48], rax;
        xor rax, rax;
        ret;
      srdo_bad:
        mov rax, 0xFFFFE110;
        ret
      }
    }

  // ==========================================================================
  // surface_mint(owner_task, w, h, format) -> row_id | error.
  //
  // Gate order (doc §5's failure taxonomy in the emit sequence):
  //   (1) owner_task != 0        -> else SURFACE_MINT_BAD_OWNER
  //   (2) w != 0 && h != 0       -> else SURFACE_MINT_BAD_DIMS
  //   (3) format != 0            -> else SURFACE_MINT_BAD_FORMAT
  //                                  (M1-001 accepts any nonzero fourcc;
  //                                   M1-004 #2384 refines against a
  //                                   real DRM_FOURCC subset table)
  //   (4) low-first free-slot scan over SURFACE_ROW_MAX(16) rows
  //                                -> else SURFACE_TAIL_ENOSPC
  //   (5) LAM header: bump low-56 generation, OR in 1<<56 in_use marker
  //   (6) stamp id (pre-incremented monotonic counter, first id = 1),
  //       owner, wh_packed, format+flags(0), state+serial(0,0),
  //       damage(0), buffers(0)
  //   (7) bump _surface_stats[SURFACE_ST_MINTS]
  //   (8) emit SURFACE MINT OK fingerprint via klog_s1_x1(sid=row_id)
  //   (9) return row_id
  //
  // Rights checks (SURFACE_MINT_BAD_RIGHTS = 0xFFFFE119) live on the
  // dispatcher side (cap_handler_surface, a follow-on landing this PR
  // does not scope); the code is emitted here as a constant so both
  // sides speak the same taxonomy.  Same for SURFACE_MINT_BAD_FLAGS
  // (0xFFFFE11A) -- M1 mint takes no flags argument so the code is a
  // reservation for M1-004 first-attach's flag negotiation.
  //
  // Register plan: rbx=slot (later row_id, live across klog call so it
  // must be callee-save), r12=owner, r13=w, r14=h, r15=format.  Five
  // callee-save pushes = 40 bytes; entry rsp%16==8 -> post-pushes
  // rsp%16 = (8+40)%16 = 0, safe for every nested call without
  // additional alignment padding.  klog_s1_x1 preserves rbx/r12-r15/rbp
  // per the iommu/domain_switch.pdx precedent tui_canvas cites.
  // ==========================================================================

  pub let surface_mint : (u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (owner_task: u64) (w: u64) (h: u64) (format: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R113.M1-001 (#2381): mint KIND_SURFACE. Gate order per doc §5: (1) owner!=0 else BAD_OWNER; (2) w!=0 && h!=0 else BAD_DIMS; (3) format!=0 else BAD_FORMAT (M1-004 refines fourcc set); (4) low-first scan else TAIL_ENOSPC; (5) LAM header bump; (6) row stamp per doc §2 layout; (7) stats.mints++; (8) klog SURFACE MINT OK sid=<row_id>. Five callee-save pushes (rbx/r12-r15) leave rsp%16==0 for every nested call. klog_s1_x1 preserves callee-saves per iommu/domain_switch.pdx precedent. Refusal funnel bumps stats.refused matching tui_canvas discipline. Labels prefixed sm_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                        // owner_task
        mov r13, rsi;                        // w
        mov r14, rdx;                        // h
        mov r15, rcx;                        // format

        // Gate 1: owner_task != 0
        cmp r12, 0;
        je  sm_bad_owner;

        // Gate 2: w != 0 && h != 0
        cmp r13, 0;
        je  sm_bad_dims;
        cmp r14, 0;
        je  sm_bad_dims;

        // Gate 3: format != 0 (M1-004 refines against real fourcc set)
        cmp r15, 0;
        je  sm_bad_format;

        // Gate 4: low-first scan over 16 rows for in_use == 0
        xor rcx, rcx;                        // idx = 0
      sm_scan:
        mov r10, [rip + SURFACE_ROW_MAX];
        cmp rcx, r10;
        jae sm_enospc;

        lea r10, [rip + _surface_table];
        mov r11, rcx;
        shl r11, 6;                          // idx * 64
        add r10, r11;

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  sm_claim;

        add rcx, 1;
        jmp sm_scan;

      sm_claim:
        // rcx = free slot idx; r10 = row base pointer.
        mov rbx, rcx;                        // save row_id in callee-save

        // (5) LAM: hdr = ((old_gen + 1) & 0x00FFFFFFFFFFFFFF) | (1<<56)
        mov r11, [r10 + 0];
        mov r9, 0x00FFFFFFFFFFFFFF;
        and r11, r9;                         // r11 = old low-56 gen
        add r11, 1;
        and r11, r9;                         // clip to 56 bits
        mov r8, 1;
        shl r8, 56;                          // r8 = 1<<56 (in_use marker)
        or  r11, r8;
        mov [r10 + 0], r11;                  // write new hdr

        // (6) Row stamp per doc §2.
        //   +8  surface_id: pre-increment _surface_next_id (first id = 1)
        lea r8, [rip + _surface_next_id];
        mov rax, [r8 + 0];
        add rax, 1;
        mov [r8 + 0], rax;
        mov [r10 + 8], rax;                  // surface_id

        //   +16 owner_task_id
        mov [r10 + 16], r12;

        //   +24 wh_packed = (w<<32) | h
        mov rax, r13;
        and rax, 0xFFFFFFFF;
        shl rax, 32;
        mov r11, r14;
        mov r11d, r11d;                      // zero-extend clears bits 32-63; r11 dest for and,imm32 collides with encoder scratch per U1615
        or  rax, r11;
        mov [r10 + 24], rax;

        //   +32 format+flags = fourcc | (flags<<32); flags = 0 at mint
        mov rax, r15;
        and rax, 0xFFFFFFFF;
        mov [r10 + 32], rax;

        //   +40 state+serial = 0 (state=0, next_serial=0; first swap will
        //       bump to 1 and return 1)
        xor rax, rax;
        mov [r10 + 40], rax;

        //   +48 damage = 0
        mov [r10 + 48], rax;

        //   +56 buffers = 0 (both pending and current unset)
        mov [r10 + 56], rax;

        // (7) stats.mints++
        call surface_stats_bump_mints;

        // (8) klog_s1_x1(LEVEL_INFO=3, SUBSYS_CAP_, surface_mint_ok_msg,
        //                surface_k_sid, sid=row_id)
        mov rdi, 3;
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + surface_mint_ok_msg];
        lea rcx, [rip + surface_k_sid];
        mov r8, rbx;                         // row_id survives as sid
        call klog_s1_x1;

        mov rax, rbx;                        // return row_id
        jmp sm_out;

      sm_bad_owner:
        mov rax, 0xFFFFE11D;
        jmp sm_refused;
      sm_bad_dims:
        mov rax, 0xFFFFE11C;
        jmp sm_refused;
      sm_bad_format:
        mov rax, 0xFFFFE11B;
        jmp sm_refused;
      sm_enospc:
        mov rax, 0xFFFFE11F;

      sm_refused:
        // Shared refusal funnel: bump stats.refused, preserving the
        // sentinel across the call (bumper clobbers rax as scratch).
        push rax;
        call surface_stats_bump_refused;
        pop rax;

      sm_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // surface_destroy(slot) -> 0 | SURFACE_BAD_SLOT | SURFACE_DESTROY_ALREADY.
  //
  // Doc §6: "On destroy: increment generation (so a stale handle to the
  // same slot is now-invalid), then clear the in_use marker byte."  Emits
  // SURFACE DESTROY OK fingerprint on success (with the pre-destroy sid
  // read out of row+8 before the header write scrubs in_use).
  //
  // Register plan: r12=slot (survives across every nested call), r13=sid
  // (read before header rewrite, passed to klog).  Two callee-save
  // pushes + sub rsp,8 = 24 bytes; entry rsp%16==8 -> (8+24)%16 = 0.
  // ==========================================================================

  pub let surface_destroy : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (slot: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R113.M1-001 (#2381): destroy KIND_SURFACE row. slot >= SURFACE_ROW_MAX(16) -> SURFACE_BAD_SLOT; row not in_use -> SURFACE_DESTROY_ALREADY; else bump generation + clear in_use byte + stats.destroys++ + klog SURFACE DESTROY OK sid=<row+8>. Reads sid BEFORE the header rewrite (in_use scrub is header-only and does not touch +8, but ordering it first keeps the emission independent of any future header layout change). Two callee-save pushes (r12/r13) + sub rsp,8 align rsp to 16 for every nested call. klog_s1_x1 preserves callee-saves. Labels prefixed sd_.",
      block: {
        push r12;
        push r13;
        sub rsp, 8;

        mov r12, rdi;                        // slot

        mov r10, [rip + SURFACE_ROW_MAX];
        cmp r12, r10;
        jae sd_bad_slot;

        lea r10, [rip + _surface_table];
        mov r11, r12;
        shl r11, 6;
        add r10, r11;                        // r10 = row base

        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  sd_already;

        // Read sid before touching the row (doc §6 says generation
        // increment does not disturb other fields, but ordering the
        // read first keeps emission independent of any later revision).
        mov r13, [r10 + 8];

        // Bump generation and clear in_use in one write: the masked
        // low-56 gen is (old_low56 + 1) & 0x00FFFFFFFFFFFFFF; the top
        // byte lands as zero because we do not OR in the marker.
        mov r11, [r10 + 0];
        mov r9, 0x00FFFFFFFFFFFFFF;
        and r11, r9;
        add r11, 1;
        and r11, r9;
        mov [r10 + 0], r11;                  // in_use now 0; gen bumped

        call surface_stats_bump_destroys;

        mov rdi, 3;                          // LEVEL_INFO
        lea rsi, [rip + SUBSYS_CAP_];
        lea rdx, [rip + surface_destroy_ok_msg];
        lea rcx, [rip + surface_k_sid];
        mov r8, r13;                         // sid = pre-destroy surface_id
        call klog_s1_x1;

        xor rax, rax;
        jmp sd_out;

      sd_bad_slot:
        mov rax, 0xFFFFE110;
        jmp sd_out;
      sd_already:
        mov rax, 0xFFFFE114;

      sd_out:
        add rsp, 8;
        pop r13;
        pop r12;
        ret
      }
    }
}
