// src/kernel/core/cap/kind_pty.pdx -- Wave iota (ι-01, paideia-os pdxterm
// real-body wave)
//
// KIND_PTY = 0x1E7. A KERNEL-NATIVE capability naming one pseudo-terminal
// pair: a bidirectional byte-relay session between a "master" endpoint
// (held by a terminal emulator such as pdxterm) and a "slave" endpoint
// (attached to a shell's stdin/stdout/stderr after fork+execve). This is
// the substrate ι-02's sys_openpty/sys_grantpt/sys_unlockpt and ι-03/ι-04's
// pdxterm-side pty_wire / pty_resize consume.
//
// KIND-ID CHOICE. 0x1E7 is the first unclaimed ordinal above every other
// `pub let ... : u64 = 0x...` allocation found in a tree-wide grep at
// landing time (highest prior: KIND_A11Y_NODE = 0x1E6, kind_a11y_node.pdx).
// Not 0x1D0 -- that ordinal is already KIND_INPUT_SERVER
// (src/user/input_server/main.pdx), part of the user-side compositor's
// 0x1D0..0x1DF derived-kind band.
//
// DERIVATION. Declared conceptually derived over KIND_IPC_ENDPOINT (5) --
// a pty pair is, in shape, a private bidirectional byte channel between
// two holders -- but NO parent-slot gate is enforced at mint time: unlike
// KIND_TTY (which requires an addressable KIND_IPC_ENDPOINT parent because
// it is a client's view of a server-owned sink), a pty pair has no
// pre-existing server to derive authority from. `pty_cap_mint` is called
// directly by the trusted `sys_openpty` syscall body, never through the
// 2-register cap_invoke ABI -- the same no-parent-gate posture
// sys_volume_mint.pdx's own mint body takes for KIND_VOLUME.
//
// SUBSTRATE SHAPE (real, not stubbed).
//   * A fixed 32-row pool (PTY_ROW_MAX), each row holding
//     {master_fd, slave_fd, session_leader_pid, winsize} plus four
//     monotonic ring cursors (see SECTION 1).
//   * Two 8 KiB byte rings (_pty_ring_m2s, _pty_ring_s2m), 256 bytes per
//     row per direction, addressed by row_id -- real byte storage, not a
//     placeholder. m2s carries bytes written by the master (keystrokes
//     the terminal emulator sends toward the shell's stdin); s2m carries
//     bytes written by the slave (the shell's stdout/stderr, read back by
//     the terminal emulator). `pty_ring_push` / `pty_ring_pop` are the
//     SPSC enqueue/dequeue primitives, byte-for-byte the same idiom as
//     core/uart/rx_ring.pdx's `uart_rx_enqueue` / `uart_rx_dequeue`,
//     generalised with a `row_id * PTY_RING_BYTES` base offset so one
//     pair of backing arrays serves all 32 rows.
//   * `sys_read` / `sys_write` (see their own files' "PTY fd" phase) test
//     the fd_table entry's bit 15 (PTY_FD_TAG) and, when set, route
//     through `pty_ring_pop` / `pty_ring_push` instead of vfs_read /
//     vfs_write -- see `pty_fd_entry_is_pty` / `pty_fd_entry_row` /
//     `pty_fd_entry_side` below for the shared decode helpers.
//
// OPS (cap_invoke-reachable, cap_handler_pty.pdx). Per the wave brief:
// MINT, QUERY, SET_DIMS. MINT is the direct-call-only `pty_cap_mint`
// (mirrors kind_a11y_node.pdx's mint/query split: a mint that allocates a
// brand-new row does not fit the 2-register cap_invoke ABI cleanly, so it
// is a plain function call from sys_openpty_body). QUERY and SET_DIMS are
// the cap_invoke-reachable ops on an ALREADY-minted pty cap, alongside
// three small QUERY variants (master_fd / slave_fd / session_pid) and one
// SET op (session_pid) this landing adds beyond the literal three-op ask
// because a session_leader_pid field that can never be populated after
// mint (the shell's pid is not known until after `fork()`, which happens
// AFTER sys_openpty returns) would be dead storage -- see cap_handler_pty.
// pdx's own header for the full op table.
//
// SIGWINCH-SHAPED NOTIFICATION (ι-04 substrate). This kernel has no
// generic per-task pending-signal mask yet (sys_kill.pdx's own header:
// only SIGSTOP/SIGCONT exist, hard-wired into the task state machine).
// `pty_winch_notify(pid)` is therefore a narrow, HONEST proxy: it bumps a
// per-pid pending-resize counter in `_pty_winch_pending[MAX_PIDS]`
// (mirrors sys_kill.pdx's own MAX_PIDS=64 pid-table bound) rather than
// delivering a real SIGWINCH. `pty_winch_pending_take(pid)` is the
// read-and-clear consumer a future real signal-dispatch loop wires up --
// shipped now, per this tree's convention of landing substrate + an
// explicit deferred-wiring note (see kind_tty.pdx's VTIME timer, kind_
// screencast.pdx's frame emit, both same posture).
//
// FAILURE TAXONOMY -- 0xFFFFE310..0xFFFFE31F. Verified free by a
// tree-wide grep for `0xFFFFE31` at landing time (empty match before this
// file).
//
// ENCODER PITFALLS (per feedback_pdx_encoder_pitfalls v0.36+):
//   * No `test rN, rN` -- every zero-check is `cmp rN, 0` + `je/jne`.
//   * No 2-op `imul r, imm` -- row-offset math uses `shl r, 6` (*64) plus
//     a second `shl`+`add` for the *96 stride (96 = 64 + 32), matching
//     kind_tty.pdx's *48 idiom rather than kind_a11y_node.pdx's 3-op
//     `imul r, r, 48` (both forms are legal; shl+add avoids imul
//     entirely).
//   * No `and reg, imm64` -- every mask here (0xFF, 0x1F, 0x8000, 0xFFFF,
//     0xFFFFFFFF) fits imm32 with bit 31 clear, so plain `and reg, imm32`
//     is used throughout; the one 64-bit sentinel comparison (DECODE_BAD
//     / MINT failure, 0xFFFFFFFFFFFFFFFF) is staged via `mov r10, imm64`
//     then `cmp reg, r10`, never `and`.
//   * No `cmp reg, [mem]` -- every mem compare loads to a scratch first.
//   * No literal-scaled `[reg + N*8]` -- register-scaled `[reg + rcx*8]`
//     (SIB-legal scale) is used only in the reset loop, matching kind_
//     tty.pdx's `tty_table_reset` / kind_screencast.pdx's scrub idiom.
//   * Reserved-keyword labels avoided (loop/if/let/while/for/match/pub/
//     mod/use/fn/struct/enum/impl/trait/type/where/move/mut/ref). Every
//     label in this file is prefixed `pty_`.
//   * Module name matches file basename: `KindPty` for `kind_pty.pdx`.

module KindPty = structure {

  // ==========================================================================
  // SECTION 0 -- IDENTITY + RIGHTS
  // ==========================================================================

  pub let KIND_PTY      : u64 = 0x1E7
  pub let KIND_PTY_BASE : u64 = 5          // = KIND_IPC_ENDPOINT (conceptual only; no parent gate)

  // Rights (bit assignments local to this kind; no cross-kind meaning).
  pub let R_PTY_QUERY       : u64 = 0x008   // read dims / master_fd / slave_fd / session_pid
  pub let R_PTY_SET_DIMS    : u64 = 0x010   // TIOCSWINSZ-analog resize
  pub let R_PTY_SET_SESSION : u64 = 0x020   // register the post-fork session leader pid
  pub let R_PTY_MINT        : u64 = 0x200   // parity bit; MINT is direct-call-only, never
                                             // reachable via cap_invoke, so this right is
                                             // documented but never tested by this file.
  pub let R_PTY_ALL         : u64 = 0x238   // 0x008 | 0x010 | 0x020 | 0x200

  // Rights granted to a freshly minted master cap. R_PTY_MINT is
  // deliberately withheld -- minting is a one-shot kernel-internal act
  // performed by sys_openpty_body, not a delegable capability right on
  // the cap this landing hands back to userspace.
  pub let PTY_INITIAL_RIGHTS : u64 = 0x038  // R_PTY_QUERY | R_PTY_SET_DIMS | R_PTY_SET_SESSION

  // ==========================================================================
  // SECTION 1 -- ROW LAYOUT (96 bytes, twelve u64 words)
  // ==========================================================================
  //
  //   [+0]  hdr             in_use[63:56] | reserved[55:0]
  //   [+8]  master_fd       (u64; fd number in the OPENING task's fd_table,
  //                          or 0xFFFFFFFFFFFFFFFF before sys_openpty wires it)
  //   [+16] slave_fd        (u64; same convention as master_fd)
  //   [+24] session_leader_pid (u64; 0 == unset until a post-fork
  //                          OP_PTY_SET_SESSION_PID call registers the
  //                          forked shell's pid)
  //   [+32] winsize         (u64; rows in bits [63:32], cols in bits [31:0])
  //   [+40] m2s_head        (monotonic byte counter, master->slave ring)
  //   [+48] m2s_tail
  //   [+56] s2m_head        (monotonic byte counter, slave->master ring)
  //   [+64] s2m_tail
  //   [+72] reserved0
  //   [+80] reserved1
  //   [+88] reserved2

  pub let PTY_OFF_HDR          : u64 = 0
  pub let PTY_OFF_MASTER_FD    : u64 = 8
  pub let PTY_OFF_SLAVE_FD     : u64 = 16
  pub let PTY_OFF_SESSION_PID  : u64 = 24
  pub let PTY_OFF_WINSIZE      : u64 = 32
  pub let PTY_OFF_M2S_HEAD     : u64 = 40
  pub let PTY_OFF_M2S_TAIL     : u64 = 48
  pub let PTY_OFF_S2M_HEAD     : u64 = 56
  pub let PTY_OFF_S2M_TAIL     : u64 = 64

  pub let PTY_ROW_MAX   : u64 = 32
  pub let PTY_ROW_BYTES : u64 = 96
  pub let PTY_ROW_WORDS : u64 = 12
  // 32 rows * 96 bytes = 3072 bytes = 384 u64.
  pub let mut _pty_table : [u64; 384] = uninit @align(64)
  pub let mut _pty_stats : [u64; 8]   = uninit @align(64)

  pub let PTY_ST_MINTS    : u64 = 0
  pub let PTY_ST_REVOKES  : u64 = 1
  pub let PTY_ST_QUERIES  : u64 = 2
  pub let PTY_ST_REFUSED  : u64 = 3
  pub let PTY_ST_SET_DIMS : u64 = 4
  pub let PTY_ST_MAX      : u64 = 8

  // ==========================================================================
  // SECTION 2 -- BYTE RINGS (SPSC, per row, per direction)
  // ==========================================================================

  pub let PTY_RING_BYTES : u64 = 256
  pub let PTY_RING_MASK  : u64 = 0xFF
  pub let PTY_DIR_M2S    : u64 = 0    // master write -> slave read
  pub let PTY_DIR_S2M    : u64 = 1    // slave write -> master read

  pub let PTY_RING_OK    : u64 = 0
  pub let PTY_RING_FULL  : u64 = 1
  pub let PTY_RING_EMPTY : u64 = 0xFFFF

  // 32 rows * 256 bytes = 8192 bytes per direction.
  pub let mut _pty_ring_m2s : [u8; 8192] = uninit @align(64)
  pub let mut _pty_ring_s2m : [u8; 8192] = uninit @align(64)

  // ==========================================================================
  // SECTION 3 -- FAILURE TAXONOMY -- 0xFFFFE310..0xFFFFE31F
  // ==========================================================================

  pub let PTY_OK               : u64 = 0
  pub let PTY_TAIL_ENOSPC      : u64 = 0xFFFFE31F
  pub let PTY_MINT_ENOSPC_SLOT : u64 = 0xFFFFE31E
  pub let PTY_MINT_BAD_ROWS    : u64 = 0xFFFFE31D
  pub let PTY_MINT_BAD_COLS    : u64 = 0xFFFFE31C
  pub let PTY_UNSUP_OP         : u64 = 0xFFFFE31B
  pub let PTY_BAD_DIMS         : u64 = 0xFFFFE31A

  pub let PTY_DECODE_BAD  : u64 = 0xFFFFFFFFFFFFFFFF
  pub let PTY_MINT_FAILED : u64 = 0xFFFFFFFFFFFFFFFF
  pub let INVOKE_DENIED   : u64 = 0xFFFFFFFFFFFFFFFD

  pub let PTY_ROWS_MAX : u64 = 4096
  pub let PTY_COLS_MAX : u64 = 4096

  // fd_table PTY tag (see sys_openpty.pdx / sys_read.pdx / sys_write.pdx
  // "PTY fd" phase headers for the full contract). vnode_idx never
  // exceeds VNODE_MAX-1 = 255 (fs/vnode_pool.pdx), so bit 15 is always
  // clear on a real vfs-backed fd_table entry -- safe to reuse as a tag.
  pub let PTY_FD_TAG        : u64 = 0x8000
  pub let PTY_FD_ROW_MASK   : u64 = 0x1F     // row_id in [0, 32)
  pub let PTY_FD_SIDE_BIT   : u64 = 0x20     // 0 = master, 1 = slave
  pub let PTY_SIDE_MASTER   : u64 = 0
  pub let PTY_SIDE_SLAVE    : u64 = 1

  pub let MAX_PIDS : u64 = 64                // matches sys_kill.pdx's _pid_table bound
  pub let mut _pty_winch_pending : [u64; 64] = uninit @align(64)

  // ==========================================================================
  // pty_table_reset() -> () -- boot/teardown only.
  // ==========================================================================
  pub let pty_table_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave iota (ι-01): clear the row table, both rings, the stats block, and the winch-pending table. Four independent zero loops (row table 384 words, two 8192-byte rings, 8-word stats, 64-word winch table) rather than one loop over a computed total -- matches kind_tty.pdx's tty_table_reset posture of not encoding cross-array adjacency as a fact the code depends on. Byte rings are zeroed via a u64-strided loop (8192/8 = 1024 iterations) since the ring's live content is bounded by its head/tail counters, not by a NUL terminator -- zeroing is defensive, not load-bearing (a fresh row's head==tail==0 already makes the ring logically empty). Labels prefixed pty_rs_.",
      block: {
        lea r10, [rip + _pty_table];
        xor rax, rax;
        xor rcx, rcx;
      pty_rs_rows:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 384;
        jb  pty_rs_rows;

        lea r10, [rip + _pty_ring_m2s];
        xor rcx, rcx;
      pty_rs_m2s:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 1024;
        jb  pty_rs_m2s;

        lea r10, [rip + _pty_ring_s2m];
        xor rcx, rcx;
      pty_rs_s2m:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 1024;
        jb  pty_rs_s2m;

        lea r10, [rip + _pty_stats];
        xor rcx, rcx;
      pty_rs_stats:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  pty_rs_stats;

        lea r10, [rip + _pty_winch_pending];
        xor rcx, rcx;
      pty_rs_winch:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 64;
        jb  pty_rs_winch;
        ret
      }
    }

  pub let pty_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave iota (ι-01): bounded increment; out-of-range no-op. Byte-identical shape to kind_tty.pdx's tty_note. Labels prefixed pty_nt_.",
      block: {
        cmp rdi, 8;
        jae pty_nt_out;
        lea r10, [rip + _pty_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      pty_nt_out:
        ret
      }
    }

  pub let pty_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave iota (ι-01): bounded read; out-of-range returns 0. Labels prefixed pty_st_.",
      block: {
        cmp rdi, 8;
        jae pty_st_zero;
        lea r10, [rip + _pty_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      pty_st_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // SECTION 4 -- BOUNDS VALIDATORS
  // ==========================================================================

  pub let pty_rights_valid : (u64) -> u64 !{} @{} =
    fn (rights: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave iota (ι-01): subset test against R_PTY_ALL = 0x238. Labels prefixed pty_rv_.",
      block: {
        mov rax, rdi;
        mov r10, 0x238;
        and rax, r10;
        cmp rax, rdi;
        jne pty_rv_no;
        mov rax, 1;
        ret;
      pty_rv_no:
        xor rax, rax;
        ret
      }
    }

  pub let pty_rows_valid : (u64) -> u64 !{} @{} =
    fn (rows: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave iota (ι-01): 1 iff rows in [1, PTY_ROWS_MAX = 4096]. Byte-identical shape to kind_tty.pdx's tty_rows_valid. Labels prefixed pty_rowv_.",
      block: {
        cmp rdi, 1;
        jb  pty_rowv_no;
        mov r10, 4096;
        cmp rdi, r10;
        ja  pty_rowv_no;
        mov rax, 1;
        ret;
      pty_rowv_no:
        xor rax, rax;
        ret
      }
    }

  pub let pty_cols_valid : (u64) -> u64 !{} @{} =
    fn (cols: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave iota (ι-01): 1 iff cols in [1, PTY_COLS_MAX = 4096]. Labels prefixed pty_colv_.",
      block: {
        cmp rdi, 1;
        jb  pty_colv_no;
        mov r10, 4096;
        cmp rdi, r10;
        ja  pty_colv_no;
        mov rax, 1;
        ret;
      pty_colv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // SECTION 5 -- ROW POOL (claim / valid / free)
  // ==========================================================================

  pub let pty_hdr_pack : () -> u64 !{} @{} =
    fn () -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave iota (ι-01): canonical header encoder, mirrors kind_tty.pdx's tty_hdr_pack. Returns 0; pty_tail_alloc stamps the in_use flag under the same write that claims the row. Labels prefixed pty_hp_.",
      block: {
        xor rax, rax;
        ret
      }
    }

  // pty_tail_alloc(hdr) -> row_id | PTY_TAIL_ENOSPC.
  //
  // Claims the first free row (in_use bit clear) and zeroes every field
  // in it (master_fd/slave_fd/session_leader_pid/winsize/ring cursors all
  // start at 0, EXCEPT master_fd and slave_fd which are set to
  // PTY_DECODE_BAD -- "not yet wired" -- since fd 0 is a valid fd number
  // and cannot double as an unset sentinel).
  pub let pty_tail_alloc : (u64) -> u64 !{mem} @{} =
    fn (hdr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave iota (ι-01): claim one PTY row. THE ONLY WRITER of _pty_table. Low-first scan over 32 rows of 96 bytes; row base = row*64 + row*32 (shl 6 + shl 5, avoiding both imul and a non-power-of-two single shl). On claim: store hdr with in_use bit set at +0; store PTY_DECODE_BAD (sentinel 'unset') at +8/+16 (master_fd/slave_fd); zero +24..+88 (session_leader_pid, winsize, all four ring cursors, reserved words). Four callee-save pushes (rbx=hdr, r12=row cursor, r13=row base addr, r14=sentinel) leave rsp%16==0 for no nested calls (this is a leaf). Labels prefixed pty_ta_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;

        mov rbx, rdi;                    // hdr

        xor r12, r12;                    // row cursor
      pty_ta_scan:
        cmp r12, 32;
        jae pty_ta_enospc;

        lea r13, [rip + _pty_table];
        mov r10, r12;
        shl r10, 6;                      // row * 64
        mov r11, r12;
        shl r11, 5;                      // row * 32
        add r10, r11;                    // row * 96
        add r13, r10;

        mov rax, [r13 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  pty_ta_claim;

        add r12, 1;
        jmp pty_ta_scan;

      pty_ta_claim:
        mov rax, rbx;
        mov r11, 1;
        shl r11, 56;
        or  rax, r11;
        mov [r13 + 0], rax;              // hdr | in_use

        mov r14, 0xFFFFFFFFFFFFFFFF;     // PTY_DECODE_BAD sentinel
        mov [r13 + 8],  r14;             // master_fd = unset
        mov [r13 + 16], r14;             // slave_fd  = unset

        xor rax, rax;
        mov [r13 + 24], rax;             // session_leader_pid = 0
        mov [r13 + 32], rax;             // winsize = 0
        mov [r13 + 40], rax;             // m2s_head = 0
        mov [r13 + 48], rax;             // m2s_tail = 0
        mov [r13 + 56], rax;             // s2m_head = 0
        mov [r13 + 64], rax;             // s2m_tail = 0
        mov [r13 + 72], rax;
        mov [r13 + 80], rax;
        mov [r13 + 88], rax;

        mov rax, r12;                    // return row_id
        jmp pty_ta_out;

      pty_ta_enospc:
        mov rax, 0xFFFFE31F;             // PTY_TAIL_ENOSPC

      pty_ta_out:
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let pty_tail_valid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave iota (ι-01): 1 iff row_id < PTY_ROW_MAX and in_use byte set. Labels prefixed pty_tv_.",
      block: {
        cmp rdi, 32;
        jae pty_tv_no;
        lea r10, [rip + _pty_table];
        mov r11, rdi;
        shl r11, 6;
        mov rax, rdi;
        shl rax, 5;
        add r11, rax;
        add r10, r11;
        mov rax, [r10 + 0];
        shr rax, 56;
        cmp rax, 0;
        je  pty_tv_no;
        mov rax, 1;
        ret;
      pty_tv_no:
        xor rax, rax;
        ret
      }
    }

  pub let pty_tail_free : (u64) -> () !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave iota (ι-01): scrub row (all twelve words). Labels prefixed pty_tf_.",
      block: {
        cmp rdi, 32;
        jae pty_tf_out;
        lea r10, [rip + _pty_table];
        mov r11, rdi;
        shl r11, 6;
        mov rax, rdi;
        shl rax, 5;
        add r11, rax;
        add r10, r11;
        xor rax, rax;
        mov [r10 + 0],  rax;
        mov [r10 + 8],  rax;
        mov [r10 + 16], rax;
        mov [r10 + 24], rax;
        mov [r10 + 32], rax;
        mov [r10 + 40], rax;
        mov [r10 + 48], rax;
        mov [r10 + 56], rax;
        mov [r10 + 64], rax;
        mov [r10 + 72], rax;
        mov [r10 + 80], rax;
        mov [r10 + 88], rax;
      pty_tf_out:
        ret
      }
    }

  // ==========================================================================
  // SECTION 6 -- ROW ACCESSORS
  // ==========================================================================

  pub let pty_row_master_fd : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave iota (ι-01): master_fd at +8, or PTY_DECODE_BAD. Mirrors kind_tty.pdx's tty_row_id shape. Labels prefixed pty_rmf_.",
      block: {
        push r12;
        mov r12, rdi;
        call pty_tail_valid;
        cmp rax, 0;
        je  pty_rmf_bad;
        lea r10, [rip + _pty_table];
        mov r11, r12;
        shl r11, 6;
        mov rax, r12;
        shl rax, 5;
        add r11, rax;
        add r10, r11;
        mov rax, [r10 + 8];
        jmp pty_rmf_out;
      pty_rmf_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      pty_rmf_out:
        pop r12;
        ret
      }
    }

  pub let pty_row_slave_fd : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave iota (ι-01): slave_fd at +16, or PTY_DECODE_BAD. Labels prefixed pty_rsf_.",
      block: {
        push r12;
        mov r12, rdi;
        call pty_tail_valid;
        cmp rax, 0;
        je  pty_rsf_bad;
        lea r10, [rip + _pty_table];
        mov r11, r12;
        shl r11, 6;
        mov rax, r12;
        shl rax, 5;
        add r11, rax;
        add r10, r11;
        mov rax, [r10 + 16];
        jmp pty_rsf_out;
      pty_rsf_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      pty_rsf_out:
        pop r12;
        ret
      }
    }

  pub let pty_row_session_pid : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave iota (ι-01): session_leader_pid at +24, or PTY_DECODE_BAD. Labels prefixed pty_rsp_.",
      block: {
        push r12;
        mov r12, rdi;
        call pty_tail_valid;
        cmp rax, 0;
        je  pty_rsp_bad;
        lea r10, [rip + _pty_table];
        mov r11, r12;
        shl r11, 6;
        mov rax, r12;
        shl rax, 5;
        add r11, rax;
        add r10, r11;
        mov rax, [r10 + 24];
        jmp pty_rsp_out;
      pty_rsp_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      pty_rsp_out:
        pop r12;
        ret
      }
    }

  pub let pty_row_winsize : (u64) -> u64 !{mem} @{} =
    fn (row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave iota (ι-01): packed winsize (rows in bits [63:32], cols in bits [31:0]) at +32, or PTY_DECODE_BAD. Labels prefixed pty_rws_.",
      block: {
        push r12;
        mov r12, rdi;
        call pty_tail_valid;
        cmp rax, 0;
        je  pty_rws_bad;
        lea r10, [rip + _pty_table];
        mov r11, r12;
        shl r11, 6;
        mov rax, r12;
        shl rax, 5;
        add r11, rax;
        add r10, r11;
        mov rax, [r10 + 32];
        jmp pty_rws_out;
      pty_rws_bad:
        mov rax, 0xFFFFFFFFFFFFFFFF;
      pty_rws_out:
        pop r12;
        ret
      }
    }

  // pty_row_set_fds(row_id, master_fd, slave_fd) -> ()
  // Internal writer: called ONLY by sys_openpty_body immediately after
  // fd_alloc succeeds for both sides. No-op on a dead row.
  pub let pty_row_set_fds : (u64, u64, u64) -> () !{mem} @{} =
    fn (row_id: u64) (master_fd: u64) (slave_fd: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave iota (ι-01): overwrites master_fd (+8) and slave_fd (+16). Three callee-save pushes (r12=row_id, r13=master_fd, r14=slave_fd) leave rsp%16==0 for the nested pty_tail_valid call (entry rsp%16==8, 3 pushes -> 8+24=32, %16==0). No-op on a dead row. Labels prefixed pty_rsf2_.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;                    // row_id
        mov r13, rsi;                    // master_fd
        mov r14, rdx;                    // slave_fd

        mov rdi, r12;
        call pty_tail_valid;
        cmp rax, 0;
        je  pty_rsf2_out;

        lea r10, [rip + _pty_table];
        mov r11, r12;
        shl r11, 6;
        mov rax, r12;
        shl rax, 5;
        add r11, rax;
        add r10, r11;
        mov [r10 + 8],  r13;
        mov [r10 + 16], r14;

      pty_rsf2_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // pty_row_set_winsize(row_id, rows, cols) -> ()
  // Raw setter -- callers (pty_cap_mint, cap_handler_pty's SET_DIMS arm)
  // are responsible for bounds-validating rows/cols first via
  // pty_rows_valid / pty_cols_valid. No-op on a dead row.
  pub let pty_row_set_winsize : (u64, u64, u64) -> () !{mem} @{} =
    fn (row_id: u64) (rows: u64) (cols: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave iota (ι-01): packs rows into bits [63:32] and cols into bits [31:0] and overwrites winsize (+32). Three callee-save pushes (r12=row_id, r13=rows, r14=cols) leave rsp%16==0 for the nested pty_tail_valid call. `shl r13, 32; or r13, r14` composes the packed word -- cols is masked to 32 bits first (`and r14, 0xFFFFFFFF`) so a caller-supplied cols value at or above PTY_COLS_MAX (already refused upstream, but defended here too) cannot bleed into the rows half. No-op on a dead row. Labels prefixed pty_rsw_.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;                    // row_id
        mov r13, rsi;                    // rows
        mov r14, rdx;                    // cols

        mov rdi, r12;
        call pty_tail_valid;
        cmp rax, 0;
        je  pty_rsw_out;

        mov r10, 0xFFFFFFFF;
        and r14, r10;                    // cols low 32
        shl r13, 32;                     // rows -> high 32
        or  r13, r14;                    // packed winsize

        lea r10, [rip + _pty_table];
        mov r11, r12;
        shl r11, 6;
        mov rax, r12;
        shl rax, 5;
        add r11, rax;
        add r10, r11;
        mov [r10 + 32], r13;

      pty_rsw_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // pty_row_set_session_pid(row_id, pid) -> ()
  pub let pty_row_set_session_pid : (u64, u64) -> () !{mem} @{} =
    fn (row_id: u64) (pid: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave iota (ι-01): overwrites session_leader_pid (+24). Two callee-save pushes (r12=row_id, r13=pid) plus sub rsp,8 land the nested pty_tail_valid call at rsp%16==0 (entry rsp%16==8, 2 pushes -> 8+16=24, sub 8 -> 32, %16==0). No-op on a dead row. Labels prefixed pty_rssp_.",
      block: {
        push r12;
        push r13;
        sub rsp, 8;

        mov r12, rdi;                    // row_id
        mov r13, rsi;                    // pid

        mov rdi, r12;
        call pty_tail_valid;
        cmp rax, 0;
        je  pty_rssp_out;

        lea r10, [rip + _pty_table];
        mov r11, r12;
        shl r11, 6;
        mov rax, r12;
        shl rax, 5;
        add r11, rax;
        add r10, r11;
        mov [r10 + 24], r13;

      pty_rssp_out:
        add rsp, 8;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // SECTION 7 -- MINT (direct-call-only; not reachable via cap_invoke)
  // ==========================================================================
  //
  // pty_cap_mint(rows, cols) -> (row_id | (cap_slot << 8)) or
  //                             PTY_MINT_FAILED (0xFFFFFFFFFFFFFFFF).
  //
  // Called ONLY by sys_openpty_body. No parent-slot gate (see file
  // header). Gate order: (1) rows_valid; (2) cols_valid; (3) tail_alloc;
  // (4) row_set_winsize; (5) free-slot scan of cap_table for kind == 0
  // (mirrors kind_a11y_node.pdx's anode_m_scan idiom exactly); (6)
  // cap_mint_write(slot, KIND_PTY, PTY_INITIAL_RIGHTS, row_id).
  pub let pty_cap_mint : (u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (rows: u64) (cols: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "Wave iota (ι-01): mint KIND_PTY (0x1E7). Six-push callee-save prologue (rbx=rows, r12=cols, r13=row_id once allocated, r14=free-slot cursor, r15/rbp spare for symmetry with this tree's other six-push mints) -- entry rsp%16==8, 6 pushes -> rsp%16==8 again, +8-byte pad -> 0 for every nested call. Gate order: (1) pty_rows_valid -> PTY_MINT_FAILED on failure (no row allocated yet, nothing to free). (2) pty_cols_valid -> PTY_MINT_FAILED. (3) pty_tail_alloc(hdr=0) -> row_id or PTY_TAIL_ENOSPC, folded to PTY_MINT_FAILED. (4) pty_row_set_winsize(row_id, rows, cols). (5) free-slot scan of cap_table for kind==0, byte-identical addressing to kind_a11y_node.pdx's anode_m_scan (slot*8 + slot*16 = slot*24) -> on exhaustion, pty_tail_free(row_id) before returning PTY_MINT_FAILED so a slot-exhaustion refusal never leaks a live row with no reachable cap. (6) cap_mint_write(slot, KIND_PTY, PTY_INITIAL_RIGHTS=0x038, row_id). (7) pty_note(PTY_ST_MINTS); pack return = row_id | (slot << 8) (row_id in bits [7:0], slot in bits [15:8] -- both comfortably below their 32/256 ceilings, no truncation risk). sys_openpty_body detects failure by comparing the full return against the all-ones sentinel (a real packed value can never equal it: slot <= 255 and row_id <= 31 bound the packed result to 0xFFFF at most). Effects {mem,sysreg}: mem for every row/table/cap_table write; sysreg is defensive parity with every other audited mint in this directory. Capabilities {cap}: substrate mint for a capability kind. Labels prefixed pty_m_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;
        sub rsp, 8;

        mov rbx, rdi;                    // rows
        mov r12, rsi;                    // cols

        mov rdi, rbx;
        call pty_rows_valid;
        cmp rax, 0;
        je  pty_m_failed;

        mov rdi, r12;
        call pty_cols_valid;
        cmp rax, 0;
        je  pty_m_failed;

        xor rdi, rdi;                    // hdr = 0
        call pty_tail_alloc;
        mov r10, 0xFFFFE31F;             // PTY_TAIL_ENOSPC
        cmp rax, r10;
        je  pty_m_failed;

        mov r13, rax;                    // r13 = row_id

        mov rdi, r13;
        mov rsi, rbx;                    // rows
        mov rdx, r12;                    // cols
        call pty_row_set_winsize;

        // Free-slot scan of cap_table for kind == 0.
        xor r14, r14;
      pty_m_scan:
        mov r10, 256;
        cmp r14, r10;
        jae pty_m_enospc_slot;
        lea rax, [rip + cap_table];
        mov r10, r14;
        shl r10, 3;
        mov r11, r14;
        shl r11, 4;
        add r10, r11;
        add rax, r10;
        mov rcx, [rax + 0];
        cmp rcx, 0;
        je  pty_m_slot_ok;
        add r14, 1;
        jmp pty_m_scan;
      pty_m_slot_ok:

        mov rdi, r14;                    // slot
        mov rsi, 0x1E7;                  // KIND_PTY
        mov rdx, 0x038;                  // PTY_INITIAL_RIGHTS
        mov rcx, r13;                    // target = row_id
        call cap_mint_write;

        mov rdi, 0;                      // PTY_ST_MINTS
        call pty_note;

        mov rax, r13;                    // row_id
        mov r10, r14;
        shl r10, 8;                      // slot << 8
        or  rax, r10;
        jmp pty_m_out;

      pty_m_enospc_slot:
        mov rdi, r13;
        call pty_tail_free;
        mov rdi, 3;                      // PTY_ST_REFUSED
        call pty_note;
        mov rax, 0xFFFFFFFFFFFFFFFF;     // PTY_MINT_FAILED
        jmp pty_m_out;

      pty_m_failed:
        mov rdi, 3;                      // PTY_ST_REFUSED
        call pty_note;
        mov rax, 0xFFFFFFFFFFFFFFFF;     // PTY_MINT_FAILED

      pty_m_out:
        add rsp, 8;
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // SECTION 8 -- BYTE RINGS (SPSC push/pop, per row + direction)
  // ==========================================================================

  // pty_ring_push(row_id, dir, byte) -> PTY_RING_OK (0) | PTY_RING_FULL (1)
  pub let pty_ring_push : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64) (dir: u64) (byte: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave iota (ι-01): appends one byte to the row's direction ring. Generalises core/uart/rx_ring.pdx's uart_rx_enqueue with a `row_id * PTY_RING_BYTES` base offset and a direction-selected backing array + head/tail cursor pair stored IN the row (+40/+48 for m2s, +56/+64 for s2m) rather than a dedicated global counter pair. Full iff (head - tail) >= 256. On success: byte stored at ring_base[row_id*256 + (head & 0xFF)] via `mov_b`; head cursor (in the row) incremented. Four callee-save pushes (r12=row_id, r13=dir, r14=byte, r15=row base addr) leave rsp%16==0 for no nested call (leaf; row-base address math is inline, matching pty_row_* accessors' shape but without calling pty_tail_valid -- callers of this hot path (sys_read/sys_write's PTY phase) already validated the fd's row via pty_fd_entry_row against a live fd_table entry, so re-validating tail_valid here would be a redundant load on every byte). dir selects both the backing array (_pty_ring_m2s vs _pty_ring_s2m) and the row's head/tail offset pair (+40/+48 vs +56/+64) via a branch, not arithmetic, since the two arrays are not adjacent in a way that admits a clean `base + dir*N` fold. Labels prefixed pty_rp_.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rdi;                    // row_id
        mov r13, rsi;                    // dir
        mov r14, rdx;                    // byte

        // Row base address (row_id * 96).
        lea r15, [rip + _pty_table];
        mov r10, r12;
        shl r10, 6;
        mov rax, r12;
        shl rax, 5;
        add r10, rax;
        add r15, r10;                    // r15 = &row

        cmp r13, 0;                      // PTY_DIR_M2S
        je  pty_rp_m2s;

        // s2m: head at row+56, tail at row+64.
        mov rcx, [r15 + 56];
        mov rdx, [r15 + 64];
        mov r8, rcx;
        sub r8, rdx;
        cmp r8, 256;
        jae pty_rp_full;
        lea r9, [rip + _pty_ring_s2m];
        jmp pty_rp_store;

      pty_rp_m2s:
        mov rcx, [r15 + 40];
        mov rdx, [r15 + 48];
        mov r8, rcx;
        sub r8, rdx;
        cmp r8, 256;
        jae pty_rp_full;
        lea r9, [rip + _pty_ring_m2s];

      pty_rp_store:
        // r9 = ring base; r12 = row_id; rcx = head counter.
        mov r10, r12;
        shl r10, 8;                      // row_id * 256
        add r9, r10;
        mov r11, rcx;
        and r11, 0xFF;                   // slot within this row's 256 bytes
        add r9, r11;
        mov rax, r14;
        mov_b [r9 + 0], rax;

        add rcx, 1;                      // advance head
        cmp r13, 0;
        je  pty_rp_store_m2s;
        mov [r15 + 56], rcx;
        jmp pty_rp_ok;
      pty_rp_store_m2s:
        mov [r15 + 40], rcx;

      pty_rp_ok:
        xor rax, rax;                    // PTY_RING_OK
        jmp pty_rp_out;

      pty_rp_full:
        mov rax, 1;                      // PTY_RING_FULL

      pty_rp_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // pty_ring_pop(row_id, dir) -> byte (0..255) | PTY_RING_EMPTY (0xFFFF)
  pub let pty_ring_pop : (u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64) (dir: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave iota (ι-01): pops the oldest byte from the row's direction ring. Mirrors pty_ring_push's structure (row-base math, dir-selected array + cursor pair) and core/uart/rx_ring.pdx's uart_rx_dequeue's empty check / zero-extending load. Three callee-save pushes (r12=row_id, r13=dir, r14=row base addr) leave rsp%16==0 for no nested call (leaf). Labels prefixed pty_rpop_.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;                    // row_id
        mov r13, rsi;                    // dir

        lea r14, [rip + _pty_table];
        mov r10, r12;
        shl r10, 6;
        mov rax, r12;
        shl rax, 5;
        add r10, rax;
        add r14, r10;                    // r14 = &row

        cmp r13, 0;
        je  pty_rpop_m2s;

        // s2m: head at row+56, tail at row+64.
        mov rcx, [r14 + 56];
        mov rdx, [r14 + 64];
        cmp rcx, rdx;
        je  pty_rpop_empty;
        lea r9, [rip + _pty_ring_s2m];
        jmp pty_rpop_load;

      pty_rpop_m2s:
        mov rcx, [r14 + 40];
        mov rdx, [r14 + 48];
        cmp rcx, rdx;
        je  pty_rpop_empty;
        lea r9, [rip + _pty_ring_m2s];

      pty_rpop_load:
        // r9 = ring base; r12 = row_id; rdx = tail counter.
        mov r10, r12;
        shl r10, 8;
        add r9, r10;
        mov r11, rdx;
        and r11, 0xFF;
        add r9, r11;
        xor rax, rax;
        mov_b rax, [r9 + 0];

        add rdx, 1;                      // advance tail
        cmp r13, 0;
        je  pty_rpop_store_m2s;
        mov [r14 + 64], rdx;
        jmp pty_rpop_out;
      pty_rpop_store_m2s:
        mov [r14 + 48], rdx;
        jmp pty_rpop_out;

      pty_rpop_empty:
        mov rax, 0xFFFF;                 // PTY_RING_EMPTY

      pty_rpop_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // SECTION 9 -- fd_table PTY-tag decode helpers (shared with sys_read /
  // sys_write / sys_openpty).
  // ==========================================================================

  pub let pty_fd_entry_is_pty : (u64) -> u64 !{} @{} =
    fn (entry: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave iota (ι-01): 1 iff bit 15 (PTY_FD_TAG) is set. Labels prefixed pty_fip_.",
      block: {
        mov rax, rdi;
        and rax, 0x8000;
        cmp rax, 0;
        je  pty_fip_no;
        mov rax, 1;
        ret;
      pty_fip_no:
        xor rax, rax;
        ret
      }
    }

  pub let pty_fd_entry_row : (u64) -> u64 !{} @{} =
    fn (entry: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave iota (ι-01): row_id = entry bits [4:0]. No validity gate -- caller (sys_read/sys_write) has already confirmed entry via fd_get returning nonzero and pty_fd_entry_is_pty. Labels prefixed pty_fer_.",
      block: {
        mov rax, rdi;
        and rax, 0x1F;
        ret
      }
    }

  pub let pty_fd_entry_side : (u64) -> u64 !{} @{} =
    fn (entry: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "Wave iota (ι-01): side = entry bit 5 (0 = master, 1 = slave). Labels prefixed pty_fes_.",
      block: {
        mov rax, rdi;
        shr rax, 5;
        and rax, 1;
        ret
      }
    }

  // ==========================================================================
  // SECTION 10 -- SIGWINCH-shaped notification (substrate only; see file
  // header "SIGWINCH-SHAPED NOTIFICATION").
  // ==========================================================================

  pub let pty_winch_notify : (u64) -> () !{mem} @{} =
    fn (pid: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave iota (ι-01): bumps _pty_winch_pending[pid] if pid is in [1, MAX_PIDS). pid == 0 (unset session_leader_pid) is a silent no-op -- OP_PTY_SET_DIMS calls this unconditionally after resizing, and a pty with no registered session leader yet must not fault or write out of bounds. Labels prefixed pty_wn_.",
      block: {
        cmp rdi, 0;
        je  pty_wn_out;
        cmp rdi, 64;
        jae pty_wn_out;
        lea r10, [rip + _pty_winch_pending];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      pty_wn_out:
        ret
      }
    }

  // pty_winch_pending_take(pid) -> count (and clears it to 0).
  // Read-and-clear consumer for a future real signal-dispatch loop; not
  // yet called by anything in this landing (see file header).
  pub let pty_winch_pending_take : (u64) -> u64 !{mem} @{} =
    fn (pid: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "Wave iota (ι-01): returns _pty_winch_pending[pid] and zeroes it. Out-of-range pid returns 0 without touching memory. Labels prefixed pty_wpt_.",
      block: {
        cmp rdi, 0;
        je  pty_wpt_zero;
        cmp rdi, 64;
        jae pty_wpt_zero;
        lea r10, [rip + _pty_winch_pending];
        mov rax, [r10 + rdi * 8];
        mov r11, 0;
        mov [r10 + rdi * 8], r11;
        ret;
      pty_wpt_zero:
        xor rax, rax;
        ret
      }
    }
}
