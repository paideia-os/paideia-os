// src/kernel/core/cap/handlers/cap_handler_seat.pdx -- COMP-IMPL-04
// (paideia-os compositor-impl-backtrack wave, design/kernel/
// compositor-impl-backtrack.md)
//
// KIND_SEAT (0x1BF) cap-op dispatcher.  Design authority:
// src/kernel/core/cap/kind_seat.pdx (R113.M5-025, #2405), whose own
// header states the gap this file closes verbatim: "Policy ... lives
// in the follow-on seat-manager / display-manager landings that call
// seat_create + seat_bind_kbd + seat_bind_ptr through the cap
// dispatcher's KIND_SEAT arm (not yet landed)."  The row pool + four
// substrate leaves (seat_create / seat_destroy / seat_bind_kbd /
// seat_bind_ptr) have been real since #2405; this file is the
// cap_invoke-reachable wiring, mirroring cap_handler_surface.pdx's
// role for KIND_SURFACE one-for-one.
//
// KIND-ID NOTE.  This is the KERNEL-side KIND_SEAT = 0x1BF, distinct
// by design from the USER-side Wayland-vocabulary KIND_SEAT = 0x1D6
// (src/user/input_server/seat_kind.pdx) -- see kind_seat.pdx's own
// "KERNEL vs. USER KIND_SEAT NAMING" section. This handler dispatches
// ONLY the kernel substrate; it does not touch or reference 0x1D6.
//
// ABI: cap_handler_seat(op, arg0, arg1, arg2) -> u64:
//   op   (rdi) : op ordinal, one of OP_SEAT_* below.
//   arg0 (rsi) : rights bitmask, the caller's R_SEAT_* bitmap as
//                unpacked from cap_table[slot].rights by the
//                cap_invoke_dispatch shim.
//   arg1 (rdx) : row-scoped ops (BIND_KBD / BIND_PTR / DESTROY) read
//                this as seat_id (== cap_table[slot].target_ptr, the
//                seat row the invoking cap names); MINT ignores it
//                (a mint-authority cap has no target row yet).
//   arg2 (rcx) : op-specific payload -- surface_slot for BIND_KBD /
//                BIND_PTR (see PAYLOAD ENCODING below); unused for
//                DESTROY; session_slot for MINT.
//
// The cap_invoke_dispatch shim (cap/invoke.pdx call_kind_seat) adapts
// the tree's standard 3-arg dispatch ABI (rdi=rights, rsi=target_ptr,
// rdx=op_arg) to this 4-arg signature by unpacking op_arg into
// (op, payload) -- see call_kind_seat's own header for the packed
// bit layout (op ordinal in bits [7:0], payload in bits [63:8]).
//
// PAYLOAD ENCODING (BIND_KBD / BIND_PTR).  seat_bind_kbd / seat_bind_
// ptr accept the real 64-bit sentinel SEAT_FOCUS_NONE (all-ones) to
// mean "clear this binding" (kind_seat.pdx §12/§13).  The 56-bit
// payload field cannot carry all 64 one-bits, so the all-ones 56-bit
// payload (0x00FFFFFFFFFFFFFF) is reserved as the clear-binding
// marker and expanded back to the true 64-bit SEAT_FOCUS_NONE before
// calling the substrate leaf.  Any other payload value is passed
// through verbatim as surface_slot (values in this tree's live range,
// 0..SURFACE_ROW_MAX-1, are far below 2^56 so no legitimate slot
// collides with the marker).
//
// OP ORDINAL TABLE (frozen for this dispatcher landing):
//   OP_SEAT_BIND_KBD = 0  -> seat_bind_kbd(seat_id, surface_slot)
//   OP_SEAT_BIND_PTR = 1  -> seat_bind_ptr(seat_id, surface_slot)
//   OP_SEAT_DESTROY  = 2  -> seat_destroy(seat_id)
//   OP_SEAT_MINT     = 3  -> seat_create(session_slot, name_ptr=0)
//                            (generic cap_invoke path always mints an
//                            unnamed seat; a named seat requires a
//                            direct kernel-side seat_create call, out
//                            of scope for this wiring landing.)
//
// RIGHTS GATE.  Each op checks its own primitive R_SEAT_* bit against
// arg0 (rights); no KGATE_* alias exists for KIND_SEAT (kind_seat.pdx
// declares only primitive bits) so this dispatcher gates directly on
// R_SEAT_BIND_KBD (0x008) / R_SEAT_BIND_PTR (0x010) / R_SEAT_DESTROY
// (0x020) / R_SEAT_MINT (0x200).
//
// FAILURE SURFACE.
//   * Unknown op ordinal   -> SEAT_UNSUP_OP  (0xFFFFE2E7)
//   * Rights check miss    -> INVOKE_DENIED  (0xFFFFFFFFFFFFFFFD)
//   * Every other refusal (bad seat slot, bad surface, ENOSPC, bad
//     session) is returned VERBATIM by the substrate leaves per
//     kind_seat.pdx's own failure taxonomy (0xFFFFE2E0..0xFFFFE2EF).
//
// STATS.  This handler bumps nothing itself; every substrate leaf
// bumps its own counter (creates / destroys / bind_kbd / bind_ptr /
// refused) per kind_seat.pdx's narrow-writer discipline. Matches
// cap_handler_surface.pdx's identical non-bump dispatcher posture.
//
// REGISTER PLAN.  Three callee-save pushes (rbx=op, r12=rights,
// r13=arg1/seat_id) leave every nested call at rsp%16==0: entry
// rsp%16==8, +24 pushes -> (8+24)%16==0. arg2 (payload) stays in rcx
// from entry to its first use (no intervening call before any branch
// consumes it), so it needs no callee-save slot.
//
// ENCODER PITFALLS (per feedback_pdx_encoder_pitfalls v0.36+).
//   * No `test rN, rN` -- rights checks use `and reg, imm32; cmp reg,
//     0; je ...`. Every R_SEAT_* mask fits imm32 with bit 31 clear.
//   * No 2-op `imul r, imm` -- not used here.
//   * No `and reg, imm64` -- the one imm64 (the SEAT_FOCUS_NONE
//     56-bit marker / true sentinel) is staged via `mov r64, imm64`
//     then a register-register `cmp`, never `and`.
//   * No `cmp reg, [mem]` -- no memory dereferences in this file.
//   * No literal-scaled `[reg + N*8]`.
//
// LABEL PREFIX.  Every label prefixed `sth_` (seat handler), avoiding
// the paideia-as reserved-keyword set.

module CapHandlerSeat = structure {

  // ==========================================================================
  // Op ordinals (frozen for this dispatcher landing).
  // ==========================================================================

  pub let OP_SEAT_BIND_KBD : u64 = 0
  pub let OP_SEAT_BIND_PTR : u64 = 1
  pub let OP_SEAT_DESTROY  : u64 = 2
  pub let OP_SEAT_MINT     : u64 = 3

  // ==========================================================================
  // cap_handler_seat(op, arg0, arg1, arg2) -> u64
  //
  // See file header for the ABI, op table, rights gating, and failure
  // taxonomy.
  // ==========================================================================

  pub let cap_handler_seat : (u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (op: u64) (arg0: u64) (arg1: u64) (arg2: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "COMP-IMPL-04 (compositor-impl-backtrack wave): KIND_SEAT (0x1BF) cap-op dispatcher, wiring kind_seat.pdx's (#2405) previously-undispatched substrate (seat_create/destroy/bind_kbd/bind_ptr) into cap_invoke_dispatch, per that file's own header note naming this exact gap. Four-way op branch on rdi after saving op/rights/arg1 into callee-save regs (rcx/arg2 stays live from entry since no call intervenes before its first use). Each op gates its own primitive R_SEAT_* bit against arg0 before calling the corresponding substrate leaf. BIND_KBD/BIND_PTR expand the reserved 56-bit all-ones payload marker (0x00FFFFFFFFFFFFFF) back to the true 64-bit SEAT_FOCUS_NONE sentinel before the call, since the packed op_arg payload field (call_kind_seat, invoke.pdx) cannot carry a full 64-bit all-ones value alongside the 8-bit op ordinal. MINT always passes name_ptr=0 (unnamed seat) -- a named seat requires a direct kernel-side seat_create call, out of scope for this wiring landing. Effects/capabilities are the union of every substrate leaf reachable here: seat_create declares {mem,sysreg}/{cap} (sysreg for its klog fingerprint path); seat_destroy/seat_bind_kbd/seat_bind_ptr declare {mem}/{cap} -- the union widens to {mem,sysreg}/{cap}. Refusal arms: unknown op -> SEAT_UNSUP_OP (0xFFFFE2E7); rights check miss -> INVOKE_DENIED (0xFFFFFFFFFFFFFFFD). Neither bumps kind_seat.pdx's own stats.refused counter -- that bump is scoped to substrate-leaf refusals only, matching cap_handler_surface.pdx's identical dispatcher-side non-bump discipline. Three callee-save pushes (rbx=op, r12=rights, r13=arg1): entry rsp%16==8, +24 bytes -> rsp%16==0 for every nested call. Every substrate leaf preserves rbx/r12/r13 per SysV. Labels prefixed sth_ (seat handler), avoiding the paideia-as reserved-keyword set.",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                    // op
        mov r12, rsi;                    // arg0 = rights
        mov r13, rdx;                    // arg1 = seat_id (row ops) / unused (MINT)
        // rcx (arg2 = payload) stays live from entry; no call yet.

        cmp rbx, 0;
        je  sth_op_bind_kbd;
        cmp rbx, 1;
        je  sth_op_bind_ptr;
        cmp rbx, 2;
        je  sth_op_destroy;
        cmp rbx, 3;
        je  sth_op_mint;
        jmp sth_bad_arg;

        // ---------------------------------------------------------------
        // OP_SEAT_BIND_KBD -- R_SEAT_BIND_KBD (0x008).
        // ---------------------------------------------------------------
      sth_op_bind_kbd:
        mov r10, r12;
        and r10, 0x008;
        cmp r10, 0;
        je  sth_denied;
        mov rax, rcx;                    // payload
        mov r9, 0x00FFFFFFFFFFFFFF;      // reserved clear-binding marker
        cmp rax, r9;
        jne sth_bk_use_payload;
        mov rax, 0xFFFFFFFFFFFFFFFF;     // expand to true SEAT_FOCUS_NONE
      sth_bk_use_payload:
        mov rdi, r13;                    // seat_id
        mov rsi, rax;                    // surface_slot
        call seat_bind_kbd;
        jmp sth_out;

        // ---------------------------------------------------------------
        // OP_SEAT_BIND_PTR -- R_SEAT_BIND_PTR (0x010).
        // ---------------------------------------------------------------
      sth_op_bind_ptr:
        mov r10, r12;
        and r10, 0x010;
        cmp r10, 0;
        je  sth_denied;
        mov rax, rcx;                    // payload
        mov r9, 0x00FFFFFFFFFFFFFF;      // reserved clear-binding marker
        cmp rax, r9;
        jne sth_bp_use_payload;
        mov rax, 0xFFFFFFFFFFFFFFFF;     // expand to true SEAT_FOCUS_NONE
      sth_bp_use_payload:
        mov rdi, r13;                    // seat_id
        mov rsi, rax;                    // surface_slot
        call seat_bind_ptr;
        jmp sth_out;

        // ---------------------------------------------------------------
        // OP_SEAT_DESTROY -- R_SEAT_DESTROY (0x020).
        // ---------------------------------------------------------------
      sth_op_destroy:
        mov r10, r12;
        and r10, 0x020;
        cmp r10, 0;
        je  sth_denied;
        mov rdi, r13;                    // seat_id
        call seat_destroy;
        jmp sth_out;

        // ---------------------------------------------------------------
        // OP_SEAT_MINT -- R_SEAT_MINT (0x200). arg2 = session_slot;
        // name_ptr forced to 0 (unnamed seat) at this landing.
        // ---------------------------------------------------------------
      sth_op_mint:
        mov r10, r12;
        and r10, 0x200;
        cmp r10, 0;
        je  sth_denied;
        mov rdi, rcx;                    // session_slot
        xor rsi, rsi;                    // name_ptr = 0
        call seat_create;
        jmp sth_out;

        // ---------------------------------------------------------------
        // Failure arms.
        //   sth_bad_arg -> SEAT_UNSUP_OP  (0xFFFFE2E7)
        //   sth_denied  -> INVOKE_DENIED  (0xFFFFFFFFFFFFFFFD)
        // ---------------------------------------------------------------
      sth_bad_arg:
        mov rax, 0xFFFFE2E7;             // SEAT_UNSUP_OP
        jmp sth_out;
      sth_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;     // INVOKE_DENIED

      sth_out:
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
