// src/kernel/core/cap/handlers/cap_handler_pty.pdx -- Wave iota (ι-01,
// paideia-os pdxterm real-body wave)
//
// KIND_PTY (0x1E7) cap-op dispatcher. Design authority: src/kernel/core/
// cap/kind_pty.pdx. MINT is direct-call-only (pty_cap_mint, invoked by
// sys_openpty_body) and is NOT one of the ops this file dispatches --
// mirrors cap_handler_a11y_node's mint/query split (kind_a11y_node.pdx),
// generalised from cap_handler_seat.pdx's own (op, arg0, arg1, arg2) ABI
// shape.
//
// ABI: cap_handler_pty(op, arg0, arg1, arg2) -> u64:
//   op   (rdi) : op ordinal, one of OP_PTY_* below.
//   arg0 (rsi) : rights bitmask, the caller's R_PTY_* bitmap as unpacked
//                from cap_table[slot].rights by cap_invoke_dispatch.
//   arg1 (rdx) : row_id (== cap_table[slot].target_ptr, the pty row the
//                invoking cap names).
//   arg2 (rcx) : op-specific payload -- unused for the four QUERY ops;
//                packed (cols[15:0] | rows[31:16]) for SET_DIMS; a raw
//                pid for SET_SESSION_PID.
//
// The cap_invoke_dispatch shim (cap/invoke.pdx call_kind_pty) adapts the
// tree's standard 3-arg dispatch ABI (rdi=rights, rsi=target_ptr,
// rdx=op_arg) to this 4-arg signature by unpacking op_arg into
// (op, payload) exactly as call_kind_seat does for KIND_SEAT: op ordinal
// in bits [7:0], payload in bits [63:8] (56 bits).
//
// OP ORDINAL TABLE (frozen for this dispatcher landing). The wave brief
// names three ops (MINT, QUERY, SET_DIMS); MINT is the direct-call-only
// pty_cap_mint (not here). QUERY is OP_PTY_QUERY_DIMS below; this landing
// adds four more (MASTER_FD / SLAVE_FD / SESSION_PID queries, plus
// SET_SESSION_PID) because a session_leader_pid field that can never be
// populated after mint would be dead storage -- see kind_pty.pdx's file
// header "OPS" section for the full rationale.
//
//   OP_PTY_QUERY_DIMS        = 0  -> pty_row_winsize(row_id)
//   OP_PTY_SET_DIMS          = 1  -> payload: cols in bits [15:0], rows in
//                                    bits [31:16], bits [55:32] MUST be 0
//                                    (refused otherwise). Calls pty_row_
//                                    set_winsize then pty_winch_notify on
//                                    the row's session_leader_pid (a no-op
//                                    if unset).
//   OP_PTY_QUERY_MASTER_FD   = 2  -> pty_row_master_fd(row_id)
//   OP_PTY_QUERY_SLAVE_FD    = 3  -> pty_row_slave_fd(row_id)
//   OP_PTY_QUERY_SESSION_PID = 4  -> pty_row_session_pid(row_id)
//   OP_PTY_SET_SESSION_PID   = 5  -> payload = pid (bits [55:0] max, well
//                                    above any real pid). pty_row_set_
//                                    session_pid(row_id, pid).
//
// RIGHTS GATE. QUERY ops (0, 2, 3, 4) need R_PTY_QUERY (0x008);
// SET_DIMS needs R_PTY_SET_DIMS (0x010); SET_SESSION_PID needs
// R_PTY_SET_SESSION (0x020).
//
// FAILURE SURFACE.
//   * Unknown op ordinal   -> PTY_UNSUP_OP  (0xFFFFE31B)
//   * Rights check miss    -> INVOKE_DENIED (0xFFFFFFFFFFFFFFFD)
//   * SET_DIMS reserved-bit violation or out-of-range rows/cols ->
//     PTY_BAD_DIMS (0xFFFFE31A)
//   * A dead row_id: every substrate accessor already returns
//     PTY_DECODE_BAD (0xFFFFFFFFFFFFFFFF) on a dead row, forwarded
//     verbatim by the QUERY arms; the two SET arms are silent no-ops on
//     a dead row (matching kind_tty.pdx's row-setter posture) and still
//     return 0 in that case -- a resize/session-set against a revoked
//     pty is not distinguishable from success at this landing, same
//     posture as tty_row_mode_set's callers.
//
// STATS. QUERY ops bump PTY_ST_QUERIES; SET_DIMS bumps PTY_ST_SET_DIMS.
// SET_SESSION_PID bumps nothing (session registration is a one-shot
// bookkeeping act, not a per-invocation metric worth counting).
//
// REGISTER PLAN. Five callee-save pushes (rbx=op, r12=rights, r13=row_id,
// r14/r15=scratch for SET_DIMS's unpacked rows/cols, which must survive
// two nested validity calls plus the set_winsize call) -- an ODD push
// count, so exactly like cap_handler_seat.pdx's three-push (also odd)
// prologue, entry rsp%16==8 flips to rsp%16==0 after the five pushes,
// correct for every nested call in every arm. arg2 (payload) stays in
// rcx from entry to its first use in every arm except SET_DIMS (which
// copies it out before any call), so it needs no callee-save slot
// elsewhere. r14/r15 are unused (but still saved/restored) outside the
// SET_DIMS arm -- two extra push/pop pairs versus cap_handler_seat.pdx's
// three-push plan, traded for not having to stage rows/cols through
// memory across three nested calls.
//
// ENCODER PITFALLS (per feedback_pdx_encoder_pitfalls v0.36+).
//   * No `test rN, rN` -- rights checks use `and reg, imm32; cmp reg, 0;
//     je ...`. Every R_PTY_* mask fits imm32 with bit 31 clear.
//   * No 2-op `imul r, imm`.
//   * No `and reg, imm64` -- every mask here (0xFF, 0xFFFF, 0x8000000,
//     0xFFFFFF00000000) fits imm32... the payload's reserved-bits test
//     is staged instead as a shift + compare-to-zero (`shr rcx, 24;
//     cmp rcx, 0`), never a direct 64-bit AND.
//   * No `cmp reg, [mem]` -- no memory dereferences in this file.
//   * No literal-scaled `[reg + N*8]`.
//
// LABEL PREFIX. Every label prefixed `pth_` (pty handler), avoiding the
// paideia-as reserved-keyword set.

module CapHandlerPty = structure {

  pub let OP_PTY_QUERY_DIMS        : u64 = 0
  pub let OP_PTY_SET_DIMS          : u64 = 1
  pub let OP_PTY_QUERY_MASTER_FD   : u64 = 2
  pub let OP_PTY_QUERY_SLAVE_FD    : u64 = 3
  pub let OP_PTY_QUERY_SESSION_PID : u64 = 4
  pub let OP_PTY_SET_SESSION_PID   : u64 = 5

  // ==========================================================================
  // cap_handler_pty(op, arg0, arg1, arg2) -> u64
  //
  // See file header for the ABI, op table, rights gating, and failure
  // taxonomy.
  // ==========================================================================

  pub let cap_handler_pty : (u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (op: u64) (arg0: u64) (arg1: u64) (arg2: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "Wave iota (ι-01): KIND_PTY (0x1E7) cap-op dispatcher, wiring kind_pty.pdx's substrate into cap_invoke_dispatch. Six-way op branch on rdi after saving op/rights/row_id into callee-save regs (rcx/arg2 stays live from entry since no call intervenes before its first use in any arm). Each op gates its own primitive R_PTY_* bit against arg0 before calling the corresponding substrate leaf. SET_DIMS unpacks arg2 as cols=bits[15:0], rows=bits[31:16] into r14/r15, and refuses (PTY_BAD_DIMS) if either bits[55:32] are nonzero (reserved) or pty_rows_valid/pty_cols_valid rejects the unpacked values; on success it calls pty_row_set_winsize then reads pty_row_session_pid(row_id) and forwards it to pty_winch_notify (a no-op for pid==0, i.e. no session registered yet). Effects/capabilities are the union of every substrate leaf reachable here (all of kind_pty.pdx's row accessors/setters declare {mem}/{}; pty_winch_notify declares {mem}/{}) widened to {mem,sysreg}/{cap} matching cap_handler_seat.pdx's identical dispatcher-side posture (sysreg is defensive parity, cap because this dispatcher itself is the cap_invoke-reachable surface for a capability kind). Refusal arms: unknown op -> PTY_UNSUP_OP (0xFFFFE31B); rights check miss -> INVOKE_DENIED (0xFFFFFFFFFFFFFFFD); SET_DIMS shape/range violation -> PTY_BAD_DIMS (0xFFFFE31A). Five callee-save pushes (rbx=op, r12=rights, r13=row_id, r14/r15=SET_DIMS scratch) -- odd count, entry rsp%16==8 flips to rsp%16==0 for every nested call. Labels prefixed pth_ (pty handler), avoiding the paideia-as reserved-keyword set.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                    // op
        mov r12, rsi;                    // arg0 = rights
        mov r13, rdx;                    // arg1 = row_id
        // rcx (arg2 = payload) stays live from entry; no call yet.

        cmp rbx, 0;
        je  pth_op_query_dims;
        cmp rbx, 1;
        je  pth_op_set_dims;
        cmp rbx, 2;
        je  pth_op_query_master_fd;
        cmp rbx, 3;
        je  pth_op_query_slave_fd;
        cmp rbx, 4;
        je  pth_op_query_session_pid;
        cmp rbx, 5;
        je  pth_op_set_session_pid;
        jmp pth_bad_op;

        // ---------------------------------------------------------------
        // OP_PTY_QUERY_DIMS -- R_PTY_QUERY (0x008).
        // ---------------------------------------------------------------
      pth_op_query_dims:
        mov r10, r12;
        and r10, 0x008;
        cmp r10, 0;
        je  pth_denied;
        mov rdi, r13;
        call pty_row_winsize;
        jmp pth_count_query;

        // ---------------------------------------------------------------
        // OP_PTY_QUERY_MASTER_FD -- R_PTY_QUERY (0x008).
        // ---------------------------------------------------------------
      pth_op_query_master_fd:
        mov r10, r12;
        and r10, 0x008;
        cmp r10, 0;
        je  pth_denied;
        mov rdi, r13;
        call pty_row_master_fd;
        jmp pth_count_query;

        // ---------------------------------------------------------------
        // OP_PTY_QUERY_SLAVE_FD -- R_PTY_QUERY (0x008).
        // ---------------------------------------------------------------
      pth_op_query_slave_fd:
        mov r10, r12;
        and r10, 0x008;
        cmp r10, 0;
        je  pth_denied;
        mov rdi, r13;
        call pty_row_slave_fd;
        jmp pth_count_query;

        // ---------------------------------------------------------------
        // OP_PTY_QUERY_SESSION_PID -- R_PTY_QUERY (0x008).
        // ---------------------------------------------------------------
      pth_op_query_session_pid:
        mov r10, r12;
        and r10, 0x008;
        cmp r10, 0;
        je  pth_denied;
        mov rdi, r13;
        call pty_row_session_pid;
        jmp pth_count_query;

        // ---------------------------------------------------------------
        // OP_PTY_SET_DIMS -- R_PTY_SET_DIMS (0x010). arg2 = cols[15:0] |
        // rows[31:16]; bits [55:32] must be 0.
        // ---------------------------------------------------------------
      pth_op_set_dims:
        mov r10, r12;
        and r10, 0x010;
        cmp r10, 0;
        je  pth_denied;

        mov r11, rcx;
        shr r11, 32;
        cmp r11, 0;
        jne pth_bad_dims;

        mov rax, rcx;
        and rax, 0xFFFF;                 // cols
        mov r14, rax;
        mov rax, rcx;
        shr rax, 16;
        and rax, 0xFFFF;                 // rows
        mov r15, rax;

        mov rdi, r15;                    // rows
        call pty_rows_valid;
        cmp rax, 0;
        je  pth_bad_dims;
        mov rdi, r14;                    // cols
        call pty_cols_valid;
        cmp rax, 0;
        je  pth_bad_dims;

        mov rdi, r13;                    // row_id
        mov rsi, r15;                    // rows
        mov rdx, r14;                    // cols
        call pty_row_set_winsize;

        mov rdi, r13;
        call pty_row_session_pid;
        mov r10, 0xFFFFFFFFFFFFFFFF;     // PTY_DECODE_BAD
        cmp rax, r10;
        je  pth_set_dims_no_session;
        mov rdi, rax;                    // session_leader_pid
        call pty_winch_notify;
      pth_set_dims_no_session:

        mov rdi, 4;                      // PTY_ST_SET_DIMS
        call pty_note;
        xor rax, rax;
        jmp pth_out;

        // ---------------------------------------------------------------
        // OP_PTY_SET_SESSION_PID -- R_PTY_SET_SESSION (0x020).
        // ---------------------------------------------------------------
      pth_op_set_session_pid:
        mov r10, r12;
        and r10, 0x020;
        cmp r10, 0;
        je  pth_denied;
        mov rdi, r13;                    // row_id
        mov rsi, rcx;                    // pid
        call pty_row_set_session_pid;
        xor rax, rax;
        jmp pth_out;

        // ---------------------------------------------------------------
        // Shared QUERY tail: bump PTY_ST_QUERIES (2) and forward rax.
        // ---------------------------------------------------------------
      pth_count_query:
        push rax;
        mov rdi, 2;                      // PTY_ST_QUERIES
        call pty_note;
        pop rax;
        jmp pth_out;

        // ---------------------------------------------------------------
        // Failure arms.
        //   pth_bad_op   -> PTY_UNSUP_OP  (0xFFFFE31B)
        //   pth_denied   -> INVOKE_DENIED (0xFFFFFFFFFFFFFFFD)
        //   pth_bad_dims -> PTY_BAD_DIMS  (0xFFFFE31A)
        // ---------------------------------------------------------------
      pth_bad_op:
        mov rax, 0xFFFFE31B;             // PTY_UNSUP_OP
        jmp pth_out;
      pth_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;     // INVOKE_DENIED
        jmp pth_out;
      pth_bad_dims:
        mov rax, 0xFFFFE31A;             // PTY_BAD_DIMS

      pth_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
