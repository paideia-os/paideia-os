// src/kernel/core/cap/handlers/cap_handler_framebuffer.pdx --
// COMP-IMPL-03 (paideia-os compositor-impl-backtrack wave, design/
// kernel/compositor-impl-backtrack.md)
//
// KIND_FRAMEBUFFER (0x1AF) cap-op dispatcher -- QUERY family only.
// Design authority: src/kernel/core/cap/kind_framebuffer.pdx
// (R101.M3-001), whose own file header states the plan verbatim:
// "one QUERY op (query pixel geometry) at this landing; the cap_
// invoke dispatch for FLIP + REVOKE arrives at R105 with the syscall
// surface." FLIP + REVOKE landed at R105 as DEDICATED syscalls
// (sys_page_flip / sys_page_flip_wait, design/user/syscall-table.md
// rows 111/112) rather than through cap_invoke -- but the QUERY half
// of that R101 plan was never wired into cap_invoke_dispatch at all.
// This file is that wiring, mirroring cap_handler_surface.pdx's role
// for KIND_SURFACE and cap_handler_seat.pdx's role for KIND_SEAT.
//
// SCOPE. The row substrate (fb_row_width / fb_row_height / fb_row_
// stride / fb_row_pixel_format / fb_row_lfb_va) already carries the
// real boot-time LFB descriptor -- populated at boot by kind_
// framebuffer_mint_simple (called from the R105 sys_framebuffer_
// create path, which itself derives lfb_pa/lfb_va from the platform's
// real MMIO-mapped LFB, not a fixed placeholder). This dispatcher adds
// NO new geometry data; it is pure plumbing from cap_invoke's 2-arg
// syscall ABI to those five existing accessors. fb_row_pixel_format is
// a new accessor (this landing) backing FB_OP_QUERY_FORMAT, which had
// named an op ordinal since R101.M3-001 without ever getting a reader
// -- see kind_framebuffer.pdx's own comment at that leaf.
//
// A caller wanting the full {lfb_ptr, pitch, width, height} descriptor
// the compositor needs for scanout issues four cap_invoke calls (one
// per field) against the same fb_slot -- FB_OP_QUERY_VA for lfb_ptr,
// FB_OP_QUERY_STRIDE for pitch, FB_OP_QUERY_WIDTH / _HEIGHT for the
// remaining two. A single-call packed-struct return is not possible
// through the frozen 2-arg sys_cap_invoke(slot, op_arg) -> u64 ABI
// (one u64 result register cannot carry four fields); this is the
// same per-field QUERY shape KIND_SURFACE's OP_SURFACE_QUERY already
// uses (kind_surface.pdx §4 / cap_handler_surface.pdx sh_op_query).
//
// ABI: cap_handler_framebuffer(op, arg0, arg1) -> u64:
//   op   (rdi) : op ordinal == FB_OP_QUERY_* (kind_framebuffer.pdx),
//                0=WIDTH, 1=HEIGHT, 2=STRIDE, 3=FORMAT, 4=VA. Doubles
//                as the field selector directly -- there is only one
//                op family (QUERY) at this landing, so no separate
//                selector argument is needed (unlike cap_handler_
//                surface.pdx's two-level op+field scheme).
//   arg0 (rsi) : rights bitmask (cap_table[slot].rights).
//   arg1 (rdx) : fb_slot (== cap_table[slot].target_ptr, the KIND_
//                FRAMEBUFFER row this cap names).
//
// The cap_invoke_dispatch shim (cap/invoke.pdx call_kind_framebuffer)
// adapts the tree's standard 3-arg dispatch ABI (rdi=rights,
// rsi=target_ptr, rdx=op_arg) to this 3-arg signature by treating
// op_arg AS the op ordinal directly (no packing needed -- QUERY takes
// no payload beyond the field selector already carried in op_arg
// itself), same posture cap_handler_surface.pdx describes for its own
// non-MINT ops.
//
// RIGHTS GATE. Every QUERY sub-op (including FORMAT/WIDTH/HEIGHT/
// STRIDE) is gated on R_FB_MAP (0x001) -- kind_framebuffer.pdx §2
// names R_FB_MAP as "authority to obtain ... via QUERY op" without
// scoping that to the VA field alone, and there is no finer-grained
// KGATE_* alias declared for this kind (unlike KIND_SURFACE). A
// caller without R_FB_MAP cannot read ANY framebuffer geometry
// through this handler, matching the substrate's stated intent.
//
// FAILURE SURFACE.
//   * Rights check miss     -> INVOKE_DENIED   (0xFFFFFFFFFFFFFFFD)
//   * Unknown op ordinal    -> FB_TAIL_BAD_ARG (0xFFFFEB49)
//   * Bad / not-in-use slot -> FB_DECODE_BAD   (0xFFFFFFFFFFFFFFFF),
//                              forwarded VERBATIM: each fb_row_*
//                              accessor performs its own fb_row_valid
//                              gate and already returns this all-ones
//                              sentinel on an invalid row (per their
//                              own justifications). This handler does
//                              not translate it -- callers read the
//                              raw FB_DECODE_BAD code, same posture as
//                              cap_handler_surface.pdx's "does NOT
//                              translate substrate sentinels" rule.
//
// STATS. This handler bumps nothing -- kind_framebuffer.pdx's own
// _fb_stats counters (MINTS/FLUSHES/REFUSED) are scoped to the mint /
// flush paths, not QUERY reads, so there is nothing for a QUERY
// dispatcher to bump. Matches cap_handler_surface.pdx's QUERY arm
// (also a non-bumping pure read fan-out).
//
// REGISTER PLAN. ONE callee-save push (rbx=fb_slot) leaves every
// nested call at rsp%16==0: entry rsp%16==8, +8 -> rsp%16==0. op and
// rights are both consumed before the sole nested call on any path
// (the rights check and the op-ordinal branch), so they stay in
// caller-saved scratch (r10/r11) rather than needing their own
// callee-save slots.
//
// ENCODER PITFALLS (per feedback_pdx_encoder_pitfalls v0.36+).
//   * No `test rN, rN` -- rights check uses `and reg, imm32; cmp reg,
//     0; je ...`. R_FB_MAP (0x001) fits imm32 with bit 31 clear.
//   * No 2-op `imul r, imm` -- not used here.
//   * No `and reg, imm64` -- no imm64 masks in this file.
//   * No `cmp reg, [mem]` -- no memory dereferences (all row access
//     goes through the fb_row_* accessors).
//   * No literal-scaled `[reg + N*8]`.
//
// LABEL PREFIX. Every label prefixed `fbh_` (framebuffer handler),
// avoiding the paideia-as reserved-keyword set.

module CapHandlerFramebuffer = structure {

  // ==========================================================================
  // cap_handler_framebuffer(op, arg0, arg1) -> u64
  //
  // op doubles as the FB_OP_QUERY_* field selector (kind_
  // framebuffer.pdx). See file header for the ABI and failure
  // taxonomy.
  // ==========================================================================

  pub let cap_handler_framebuffer : (u64, u64, u64) -> u64 !{mem} @{cap} =
    fn (op: u64) (arg0: u64) (arg1: u64) -> unsafe {
      effects: {mem}, capabilities: {cap},
      justification: "COMP-IMPL-03 (compositor-impl-backtrack wave): KIND_FRAMEBUFFER (0x1AF) cap-op dispatcher, wiring kind_framebuffer.pdx's (R101.M3-001) previously-undispatched QUERY family (fb_row_width/height/stride/pixel_format/lfb_va) into cap_invoke_dispatch, per that file's own header ('one QUERY op ... at this landing; ... FLIP + REVOKE arrives at R105') -- FLIP/REVOKE landed as dedicated R105 syscalls but QUERY's cap_invoke wiring never landed. Rights gate (R_FB_MAP, 0x001) checked once against arg0 before the op branch (scratch r10, no call precedes it), since kind_framebuffer.pdx declares R_FB_MAP as the QUERY-op authority with no finer per-field alias. Five-way op branch on arg0-derived scratch r11 (== FB_OP_QUERY_WIDTH..VA) fans out to the matching fb_row_* accessor with fb_slot (rbx) as its sole argument; each accessor performs its own fb_row_valid gate and returns FB_DECODE_BAD (0xFFFFFFFFFFFFFFFF) verbatim on an invalid slot -- this dispatcher does not translate that sentinel, matching cap_handler_surface.pdx's identical no-translation rule. Effects {mem} (every accessor is a pure row read); capabilities {cap} (this handler is a cap_invoke arm). Refusal arms: rights miss -> INVOKE_DENIED (0xFFFFFFFFFFFFFFFD); unknown op -> FB_TAIL_BAD_ARG (0xFFFFEB49). ONE callee-save push (rbx=fb_slot) leaves the sole nested call on any path at rsp%16==0 (entry rsp%16==8, +8 -> 0); op and rights are consumed before that call from caller-saved r10/r11, needing no callee-save slot of their own. Labels prefixed fbh_ (framebuffer handler), avoiding the paideia-as reserved-keyword set.",
      block: {
        push rbx;

        mov rbx, rdx;                    // fb_slot (survives to the sole call)
        mov r11, rdi;                    // op (== FB_OP_QUERY_* field selector)

        mov r10, rsi;
        and r10, 0x001;                  // R_FB_MAP
        cmp r10, 0;
        je  fbh_denied;

        cmp r11, 0;
        je  fbh_q_width;
        cmp r11, 1;
        je  fbh_q_height;
        cmp r11, 2;
        je  fbh_q_stride;
        cmp r11, 3;
        je  fbh_q_format;
        cmp r11, 4;
        je  fbh_q_va;
        jmp fbh_bad_arg;

      fbh_q_width:
        mov rdi, rbx;
        call fb_row_width;
        jmp fbh_out;
      fbh_q_height:
        mov rdi, rbx;
        call fb_row_height;
        jmp fbh_out;
      fbh_q_stride:
        mov rdi, rbx;
        call fb_row_stride;
        jmp fbh_out;
      fbh_q_format:
        mov rdi, rbx;
        call fb_row_pixel_format;
        jmp fbh_out;
      fbh_q_va:
        mov rdi, rbx;
        call fb_row_lfb_va;
        jmp fbh_out;

      fbh_bad_arg:
        mov rax, 0xFFFFEB49;             // FB_TAIL_BAD_ARG
        jmp fbh_out;
      fbh_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;     // INVOKE_DENIED

      fbh_out:
        pop rbx;
        ret
      }
    }
}
