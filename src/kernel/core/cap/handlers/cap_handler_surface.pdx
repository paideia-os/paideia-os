// src/kernel/core/cap/handlers/cap_handler_surface.pdx -- R113.M1-001b (paideia-os #2424)
//
// KIND_SURFACE (0x1B8) cap-op dispatcher.  Design authority:
// design/graphics/r113-m1-substrate.md §3.2 (KGATE_* aliases) + §9
// (M1 milestone graph deliverable list).  The row pool + mint + destroy
// + row_* accessors landed at R113.M1-001 (kind_surface.pdx, #2381);
// this file is the cap_invoke-reachable handler that fans op ordinals
// out to those accessors under the KGATE_* rights bitmap.
//
// SCOPE OF THIS LANDING (R113.M1-001b, dispatcher wire):
//   * Wires the six-op surface handler into cap_invoke_dispatch as
//     the 0x1B8 arm (see cap/invoke.pdx call_kind_surface landing pad
//     added alongside this file).  Mirrors the KIND_TUI_CANVAS
//     (0x1A6) landing pad one-for-one at the dispatch-cascade level.
//   * Every op branches on the KGATE_* alias declared by the
//     substrate (kind_surface.pdx §3.2), NOT on the primitive rights
//     bits.  Query -> KGATE_QUERY (0x021 = READ | QUERY_GEOMETRY);
//     commit -> KGATE_COMMIT (0x080 = R_SURFACE_COMMIT); damage ->
//     KGATE_DAMAGE (0x100); attach -> KGATE_ATTACH (0x040); destroy
//     -> KGATE_DESTROY (0x010).  Mint is gated on R_SURFACE_MINT
//     (0x200) directly (mint has no KGATE alias per doc §3.2 -- it
//     is the primitive right on its own).
//   * Every op body calls one of the substrate leaves published by
//     kind_surface.pdx §4/§Section mint/destroy: surface_mint,
//     surface_destroy, or one of the surface_row_* accessors.  The
//     dispatcher itself performs no field decoding beyond op / rights
//     / arg unpacking.
//   * The mint / destroy fingerprint emitters live INSIDE
//     surface_mint / surface_destroy (kind_surface.pdx lines 883/978),
//     not here -- this file dispatches TO those bodies but does not
//     itself klog anything.  That matches the tui_canvas discipline
//     (cap_handler_tui_canvas.pdx emits only DEBUG_PRINT, not the
//     mint fingerprint which lives inside kind_tui_canvas_mint_body).
//
// ABI (this landing).  The task-directed signature is
// (op, arg0, arg1, arg2, arg3) -> u64:
//
//   op    (rdi) : op ordinal, one of OP_SURFACE_* below.
//   arg0  (rsi) : rights bitmask, the caller's full R_SURFACE_*
//                 bitmap as unpacked from cap_table[slot].rights by
//                 the cap_invoke_dispatch shim.  Op-specific KGATE_*
//                 checks are AND-mask tests against this word.
//   arg1  (rdx) : row slot for row-scoped ops (QUERY, COMMIT, DAMAGE,
//                 ATTACH, DESTROY); owner_task_id for MINT.
//   arg2  (rcx) : op-specific first datum -- field selector for
//                 QUERY; caller-observed serial for COMMIT; rect
//                 (packed) for DAMAGE; bo_slot for ATTACH; unused
//                 for DESTROY; w (u64 low 32) for MINT.
//   arg3  (r8)  : op-specific second datum -- unused for QUERY /
//                 COMMIT / DAMAGE / ATTACH / DESTROY; for MINT
//                 packs h (low 32) | (format << 32).
//
// The cap_invoke_dispatch shim (cap/invoke.pdx call_kind_surface)
// adapts the tree's standard 3-arg dispatch ABI (rdi=rights,
// rsi=target_ptr, rdx=op_arg) to this 5-arg signature.  At M1-001b
// the shim treats op_arg as the op ordinal directly and passes
// zero for arg2 / arg3; a follow-on landing (R113.M1-002) refines
// op_arg into a packed encoding (or pointer to an argument block)
// that carries the extra MINT / COMMIT / DAMAGE / ATTACH data.
// Until then a MINT invocation through cap_invoke_dispatch will
// pass zero w/h/format and correctly refuse with the substrate's
// own SURFACE_MINT_BAD_DIMS / _FORMAT sentinels; direct callers
// (a boot witness or a follow-on user-space bridge) that invoke
// cap_handler_surface with a fully populated 5-arg frame reach
// the real substrate leaves without further ceremony.  This is the
// exact posture the fingerprint allowlist reason strings promise
// ("handler wired M1-001b; emitter (mint/destroy) lands via first
// user-space surface_mint call").
//
// OP ORDINAL TABLE (frozen for this dispatcher; the doc §9 M1-004 /
// M1-005 handlers extend the set, not this landing):
//
//   OP_SURFACE_QUERY   = 0   -> surface_row_{dims,format,damage,
//                                pending,current,serial}_get
//                                depending on arg2 field selector
//   OP_SURFACE_COMMIT  = 1   -> surface_row_swap(slot)
//   OP_SURFACE_DAMAGE  = 2   -> surface_row_damage_or(slot, rect)
//   OP_SURFACE_ATTACH  = 3   -> surface_row_pending_set(slot, bo)
//   OP_SURFACE_DESTROY = 4   -> surface_destroy(slot)
//   OP_SURFACE_MINT    = 5   -> surface_mint(owner, w, h, format)
//
// FAILURE SURFACE.
//   * Unknown op ordinal      -> SURFACE_TAIL_BAD_ARG   (0xFFFFE11E)
//   * KGATE / MINT right miss -> INVOKE_DENIED          (0xFFFFFFFFFFFFFFFD)
//   * Unknown QUERY field     -> SURFACE_TAIL_BAD_ARG   (0xFFFFE11E)
//   * Every other refusal (bad slot, no pending, stale serial, etc.)
//     is returned VERBATIM by the substrate leaves (surface_row_swap,
//     surface_destroy, etc.) per doc §5's failure taxonomy.  This
//     handler does NOT translate substrate sentinels -- callers read
//     the raw SURFACE_* code and match against the substrate's own
//     export.
//
// STATS.  This handler does not bump _surface_stats itself.  Mint /
// destroy bodies bump their own MINTS / DESTROYS / REFUSED counters
// per the substrate's narrow-writer discipline (kind_surface.pdx
// surface_stats_bump_* justifications).  Rights-denied ops do NOT
// bump REFUSED here, matching cap_handler_tui_canvas.pdx's identical
// non-bump discipline for dispatcher-side denial arms (tuih_bad_slot
// / tuih_bad_rights) -- REFUSED is scoped to MINT refusals only.
//
// REGISTER PLAN.  Five callee-save pushes (rbx=op, r12=rights,
// r13=arg1, r14=arg2, r15=arg3) leave every nested call at
// rsp%16==0: entry rsp%16==8, +40 pushes -> (8+40)%16 == 0.  Every
// substrate leaf reached from here (surface_mint / surface_destroy /
// every surface_row_*) preserves callee-saves per the tree-wide
// SysV convention, so rbx / r12-r15 stay live across each call.
//
// ENCODER PITFALLS (per feedback_pdx_encoder_pitfalls v0.36+).
//   * No `test rN, rN` -- rights checks use `and reg, imm32; cmp reg,
//     0; je ...`.  Every KGATE_* mask (0x010..0x200) fits in 32 bits
//     with bit 31 clear, so the `and reg, imm32` form does not
//     sign-extend and no `mov r,imm64` staging is needed.
//   * No 2-op `imul r, imm` -- not used here.
//   * No `and reg, imm64` -- every mask is under 32 bits.
//   * No `cmp reg, [mem]` -- op / field cmp uses `cmp reg, imm`.
//   * No literal-scaled `[reg + N*8]` -- no memory dereferences at
//     all in this file.
//
// LABEL PREFIX.  Every label prefixed `sh_` (surface handler),
// avoiding the paideia-as reserved-keyword set per
// feedback_paideia_as_reserved_labels.

module CapHandlerSurface = structure {

  // ==========================================================================
  // Op ordinals (frozen for this dispatcher landing).  Emitted as
  // data-only pub lets so callers -- a boot witness, or the M1-002
  // op_arg-refinement landing -- can name the same symbols we branch
  // on here.
  // ==========================================================================

  pub let OP_SURFACE_QUERY   : u64 = 0
  pub let OP_SURFACE_COMMIT  : u64 = 1
  pub let OP_SURFACE_DAMAGE  : u64 = 2
  pub let OP_SURFACE_ATTACH  : u64 = 3
  pub let OP_SURFACE_DESTROY : u64 = 4
  pub let OP_SURFACE_MINT    : u64 = 5

  // Field selectors for OP_SURFACE_QUERY (arg2).  Chosen to line up
  // with the surface_row_* accessor family in kind_surface.pdx §4.
  pub let SURFACE_QF_DIMS    : u64 = 0
  pub let SURFACE_QF_FORMAT  : u64 = 1
  pub let SURFACE_QF_DAMAGE  : u64 = 2
  pub let SURFACE_QF_PENDING : u64 = 3
  pub let SURFACE_QF_CURRENT : u64 = 4
  pub let SURFACE_QF_SERIAL  : u64 = 5

  // ==========================================================================
  // cap_handler_surface(op, arg0, arg1, arg2, arg3) -> u64
  //
  // See file header for the ABI, op table, rights gating (KGATE_*
  // aliases from kind_surface.pdx §3.2), and failure taxonomy.
  // ==========================================================================

  pub let cap_handler_surface : (u64, u64, u64, u64, u64) -> u64 !{mem, sysreg} @{cap} =
    fn (op: u64) (arg0: u64) (arg1: u64) (arg2: u64) (arg3: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "R113.M1-001b (paideia-os #2424): KIND_SURFACE (0x1B8) cap-op dispatcher.  Six-way op branch on rdi (op ordinal) after saving rights/args into callee-save regs; every op branches on the substrate-declared KGATE_* alias (kind_surface.pdx §3.2) before calling the corresponding surface_mint/destroy/row_* leaf.  Effects/capabilities are the union of every substrate leaf reachable here: surface_mint/destroy declare {mem,sysreg}/{cap}; every surface_row_* accessor declares {mem}/{} -- the union widens to {mem,sysreg}/{cap} to cover the mint/destroy klog path.  Refusal arms: unknown op or unknown QUERY field selector -> SURFACE_TAIL_BAD_ARG (0xFFFFE11E, kind_surface.pdx §5); KGATE_* or R_SURFACE_MINT check miss -> INVOKE_DENIED (0xFFFFFFFFFFFFFFFD, invoke.pdx).  Neither refusal bumps _surface_stats.REFUSED -- that counter is scoped to MINT-body refusals only, matching cap_handler_tui_canvas.pdx's identical discipline for its own tuih_bad_slot/tuih_bad_rights arms (see tui_stats_bump_refused justification in kind_tui_canvas.pdx).  Five callee-save pushes (rbx=op, r12=rights, r13=arg1, r14=arg2, r15=arg3): entry rsp%16==8, +40 bytes -> rsp%16==0 for every nested call.  Every substrate leaf preserves rbx/r12-r15 per SysV.  Labels prefixed sh_ (surface handler), avoiding the paideia-as reserved-keyword set.  Op ordinals + QUERY field selectors declared as data-only pub lets above so the M1-002 op_arg-refinement landing and any boot witness name the same constants this dispatcher branches on.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                    // op
        mov r12, rsi;                    // arg0 = rights
        mov r13, rdx;                    // arg1 = slot | owner_task
        mov r14, rcx;                    // arg2 = op-specific #1
        mov r15, r8;                     // arg3 = op-specific #2

        // Op dispatch (small-imm cmps only; no test rN,rN).
        cmp rbx, 0;
        je  sh_op_query;
        cmp rbx, 1;
        je  sh_op_commit;
        cmp rbx, 2;
        je  sh_op_damage;
        cmp rbx, 3;
        je  sh_op_attach;
        cmp rbx, 4;
        je  sh_op_destroy;
        cmp rbx, 5;
        je  sh_op_mint;
        jmp sh_bad_arg;

        // ---------------------------------------------------------------
        // OP_SURFACE_QUERY -- KGATE_QUERY (0x021 = READ | QUERY_GEOMETRY).
        // arg2 selects which surface_row_*_get accessor to invoke.
        // Unknown selector -> SURFACE_TAIL_BAD_ARG.
        // ---------------------------------------------------------------
      sh_op_query:
        mov r10, r12;
        and r10, 0x021;                  // R_SURFACE_KGATE_QUERY
        cmp r10, 0;
        je  sh_denied;
        mov rdi, r13;                    // slot
        cmp r14, 0;
        je  sh_q_dims;
        cmp r14, 1;
        je  sh_q_format;
        cmp r14, 2;
        je  sh_q_damage;
        cmp r14, 3;
        je  sh_q_pending;
        cmp r14, 4;
        je  sh_q_current;
        cmp r14, 5;
        je  sh_q_serial;
        jmp sh_bad_arg;
      sh_q_dims:
        call surface_row_dims_get;
        jmp sh_out;
      sh_q_format:
        call surface_row_format_get;
        jmp sh_out;
      sh_q_damage:
        call surface_row_damage_get;
        jmp sh_out;
      sh_q_pending:
        call surface_row_pending_get;
        jmp sh_out;
      sh_q_current:
        call surface_row_current_get;
        jmp sh_out;
      sh_q_serial:
        call surface_row_serial_get;
        jmp sh_out;

        // ---------------------------------------------------------------
        // OP_SURFACE_COMMIT -- KGATE_COMMIT (0x080).  R113.M1-002
        // (#2382): route through surface_commit (surface_commit_ops.pdx)
        // rather than the raw surface_row_swap accessor so pending-
        // validity gating (SURFACE_SWAP_NO_PENDING), _surface_stats.
        // commits bookkeeping, and the SURFACE COMMIT OK fingerprint
        // fire on every dispatched commit.  Returns post-bump next_
        // serial (low 48) or SURFACE_BAD_SLOT / SURFACE_SWAP_NO_PENDING.
        // arg2 (caller-observed serial) is reserved for a future stale-
        // serial gate; this landing does not consume it.
        // ---------------------------------------------------------------
      sh_op_commit:
        mov r10, r12;
        and r10, 0x080;                  // R_SURFACE_KGATE_COMMIT
        cmp r10, 0;
        je  sh_denied;
        mov rdi, r13;                    // slot
        call surface_commit;             // R113.M1-002 (#2382)
        jmp sh_out;

        // ---------------------------------------------------------------
        // OP_SURFACE_DAMAGE -- KGATE_DAMAGE (0x100).
        // surface_row_damage_or(slot, rect) unions arg2 (packed
        // rect: dx[15:0]|dy[31:16]|dw[47:32]|dh[63:48]) into the
        // row's pending damage bbox.  Returns 0 or SURFACE_BAD_SLOT.
        // ---------------------------------------------------------------
      sh_op_damage:
        mov r10, r12;
        and r10, 0x100;                  // R_SURFACE_KGATE_DAMAGE
        cmp r10, 0;
        je  sh_denied;
        mov rdi, r13;                    // slot
        mov rsi, r14;                    // rect
        call surface_row_damage_or;
        jmp sh_out;

        // ---------------------------------------------------------------
        // OP_SURFACE_ATTACH -- KGATE_ATTACH (0x040).  R113.M1-002
        // (#2382): route through surface_attach_buffer (surface_commit_
        // ops.pdx) rather than the raw surface_row_pending_set accessor
        // so bo_slot validity is checked via kgb_tail_valid (kind_gpu_
        // bo.pdx L488) before the u32 lands in row+56.  Without this
        // gate any u64 < 2^32 was silently accepted as pending_bo,
        // deferred until scanout dereferenced a phantom bo.
        //
        // arg3 (x_off/y_off pack) is passed through but not stored --
        // doc §2 row layout has no per-surface origin field (see
        // surface_attach_buffer's own header).  The dispatcher's
        // arg-pack convention leaves this at zero for M1 callers; the
        // op body ignores it either way.
        // ---------------------------------------------------------------
      sh_op_attach:
        mov r10, r12;
        and r10, 0x040;                  // R_SURFACE_KGATE_ATTACH
        cmp r10, 0;
        je  sh_denied;
        mov rdi, r13;                    // slot
        mov rsi, r14;                    // bo
        xor rdx, rdx;                    // x_off = 0 (M1 non-goal)
        xor rcx, rcx;                    // y_off = 0 (M1 non-goal)
        call surface_attach_buffer;      // R113.M1-002 (#2382)
        jmp sh_out;

        // ---------------------------------------------------------------
        // OP_SURFACE_DESTROY -- KGATE_DESTROY (0x010).
        // surface_destroy bumps generation + clears in_use +
        // bumps DESTROYS + emits SURFACE DESTROY OK.  Returns 0 |
        // SURFACE_BAD_SLOT | SURFACE_DESTROY_ALREADY per doc §5.
        // ---------------------------------------------------------------
      sh_op_destroy:
        mov r10, r12;
        and r10, 0x010;                  // R_SURFACE_KGATE_DESTROY
        cmp r10, 0;
        je  sh_denied;
        mov rdi, r13;                    // slot
        call surface_destroy;
        jmp sh_out;

        // ---------------------------------------------------------------
        // OP_SURFACE_MINT -- R_SURFACE_MINT (0x200).  Mint has no
        // KGATE alias in kind_surface.pdx §3.2 (it is the primitive
        // right on its own; the aliases exist only for the 5-way
        // access gate, of which mint is deliberately NOT a member --
        // mint is holder-scoped, not row-scoped).
        //
        // Arg pack (see file header): arg1=owner_task, arg2=w (low
        // 32 used), arg3=h (low 32) | format (high 32).  Unpack into
        // the surface_mint(owner, w, h, format) SysV signature.
        // ---------------------------------------------------------------
      sh_op_mint:
        mov r10, r12;
        and r10, 0x200;                  // R_SURFACE_MINT
        cmp r10, 0;
        je  sh_denied;
        mov rdi, r13;                    // owner_task
        mov rsi, r14;                    // w
        mov rax, r15;
        and rax, 0xFFFFFFFF;             // h = arg3 low 32
        mov rdx, rax;
        mov rax, r15;
        shr rax, 32;                     // format = arg3 high 32
        mov rcx, rax;
        call surface_mint;
        jmp sh_out;

        // ---------------------------------------------------------------
        // Failure arms.
        //   sh_bad_arg  -> SURFACE_TAIL_BAD_ARG   (0xFFFFE11E)
        //   sh_denied   -> INVOKE_DENIED          (0xFFFFFFFFFFFFFFFD)
        // Neither bumps _surface_stats.REFUSED (see file header).
        // ---------------------------------------------------------------
      sh_bad_arg:
        mov rax, 0xFFFFE11E;             // SURFACE_TAIL_BAD_ARG
        jmp sh_out;
      sh_denied:
        mov rax, 0xFFFFFFFFFFFFFFFD;     // INVOKE_DENIED

      sh_out:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
